{"__lastUpdated": "2026-09-04T05:08:15.772Z", "__OculusDBType": "Application", "group": 0, "binaryType": 1, "hmd": 8, "__sn": "OculusDB-Official", "blocked": false, "appName": "Virtual Duck Hunt", "baseline_offer": {"status": "", "status_enum": -1, "end_time": 0, "id": "1908112806504867", "show_timer": false, "price": {"offset_amount": "399", "offset_amount_numerical": 399, "currency": "EUR", "formatted": "\u20ac3.99"}, "promo_benefit": null, "strikethrough_price": null, "__typename": "AppStoreOffer", "typename_enum": 8}, "priceFormatted": "\u20ac3.99", "priceOffsetNumerical": 399, "priceLimboDetected": false, "appHasDiscount": false, "discountEndTime": "0001-01-01T00:00:00", "appHasTrial": false, "appCanBeBought": true, "currency": "EUR", "canonicalName": "bifipee-games-virtual-duck-hunt-android6d0f-uepoux", "current_gift_offer": {"status": "", "status_enum": -1, "end_time": 0, "id": "1908112806504867", "show_timer": false, "price": {"offset_amount": "399", "offset_amount_numerical": 399, "currency": "EUR", "formatted": "\u20ac3.99"}, "promo_benefit": null, "strikethrough_price": null, "__typename": "AppStoreOffer", "typename_enum": 8}, "current_offer": {"status": "", "status_enum": -1, "end_time": 0, "id": "1908112806504867", "show_timer": false, "price": {"offset_amount": "399", "offset_amount_numerical": 399, "currency": "EUR", "formatted": "\u20ac3.99"}, "promo_benefit": null, "strikethrough_price": null, "__typename": "AppStoreOffer", "typename_enum": 8}, "current_trial_offer": null, "displayName": "Virtual Duck Hunt", "display_name": "Virtual Duck Hunt", "display_long_description": "A modern VR tribute to a legendary classic\n\nVirtual Duck Hunt brings the iconic arcade duck shooting experience into virtual reality, fully reimagined for Meta Quest. Step into an immersive world where fast-paced action, precision shooting, and playful humor meet modern VR design.\n\nGrab your rifle, track ducks in true 3D space, and test your reflexes through increasingly challenging rounds. Easy to pick up, hard to master \u2014 the game is built for quick sessions, addictive gameplay, and competitive high scores.\n\nKey Features\n\n\ud83e\udd86 Arcade-Style VR Shooting\nA faithful yet modern take on classic duck hunting. Aim naturally, shoot with precision, and react quickly as ducks cross your field of view.\n\n\ud83c\udfaf Skill-Based Gameplay\nReflexes, timing, and accuracy are key. Increasing speed and evolving patterns keep every round fresh and challenging.\n\n\ud83c\udf0d Fully Immersive VR\nDesigned specifically for Meta Quest, with smooth performance and clean visuals that keep you focused on the action.\n\n\ud83c\udfc6 Global Leaderboards\nCompete against players worldwide and climb the rankings. Every shot counts.\n\n\ud83c\udfb5 Dynamic Soundtrack\nInspired by classic arcade shooters, with a modern twist and a few surprises along the way.\n\n\ud83d\udc36 Your Unpredictable Companion\nThe dog is no longer just a spectator\u2026\nHe reacts, helps, and sometimes surprises you in ways you won\u2019t expect.\nA little old, a little wild \u2014 but potentially your best ally.\n\nNo real hunting. Just pure arcade fun.\n\nJump in and play.\n\n", "display_long_description_unprocessed": "A modern VR tribute to a legendary classic\n\nVirtual Duck Hunt brings the iconic arcade duck shooting experience into virtual reality, fully reimagined for Meta Quest. Step into an immersive world where fast-paced action, precision shooting, and playful humor meet modern VR design.\n\nGrab your rifle, track ducks in true 3D space, and test your reflexes through increasingly challenging rounds. Easy to pick up, hard to master \u2014 the game is built for quick sessions, addictive gameplay, and competitive high scores.\n\nKey Features\n\n\ud83e\udd86 Arcade-Style VR Shooting\nA faithful yet modern take on classic duck hunting. Aim naturally, shoot with precision, and react quickly as ducks cross your field of view.\n\n\ud83c\udfaf Skill-Based Gameplay\nReflexes, timing, and accuracy are key. Increasing speed and evolving patterns keep every round fresh and challenging.\n\n\ud83c\udf0d Fully Immersive VR\nDesigned specifically for Meta Quest, with smooth performance and clean visuals that keep you focused on the action.\n\n\ud83c\udfc6 Global Leaderboards\nCompete against players worldwide and climb the rankings. Every shot counts.\n\n\ud83c\udfb5 Dynamic Soundtrack\nInspired by classic arcade shooters, with a modern twist and a few surprises along the way.\n\n\ud83d\udc36 Your Unpredictable Companion\nThe dog is no longer just a spectator\u2026\nHe reacts, helps, and sometimes surprises you in ways you won\u2019t expect.\nA little old, a little wild \u2014 but potentially your best ally.\n\nNo real hunting. Just pure arcade fun.\n\nJump in and play.\n\n", "genre_names": ["Shooter", "Arcade", "Action"], "has_in_app_ads": false, "id": "6258640254239612", "is_approved": false, "is_concept": false, "is_enterprise_enabled": false, "organization": {"id": "", "is_authorized_for_quest": false, "application_groupings": {"count": 0, "nodes": [], "__typename": "", "typename_enum": 0}}, "platform": "", "publisher_name": "Bifimmersive Games", "required_space_adjusted": 2188866304, "requiredSpaceAdjustedFormatted": "2.04 GB", "total_installed_space": 1155189959, "totalInstalledSpaceFormatted": "1.08 GB", "quality_rating_aggregate": 0, "img": "", "packageName": "com.Bifimmersive.ImmersiveDuckHunter", "imageLink": "/cdn/images/6258640254239612", "release_channels": {"count": 3, "nodes": [{"latest_supported_binary": {"binary_application": null, "id": "", "version": "", "platform": "", "package_name": null, "targeted_devices": [], "min_android_sdk_version": null, "max_android_sdk_version": null, "target_android_sdk_version": null, "targeted_devices_enum": [], "file_name": "", "uri": "", "change_log": null, "changeLog": null, "richChangeLog": "", "firewall_exceptions_required": false, "is_2d_mode_supported": false, "launch_file": "
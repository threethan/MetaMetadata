nefit": null, "strikethrough_price": {"offset_amount": "1199", "offset_amount_numerical": 1199, "currency": "EUR", "formatted": "\u20ac11.99"}}, "displayName": "StashXR", "display_name": "StashXR", "display_long_description": "Browse, search, and stream your Stash library right from your headset.\n\nStashXR connects to your self-hosted Stash server and puts your entire media collection at your fingertips in a sleek, immersive interface.\nFilter by tags, performers, studios and more. Sort however you like. Find exactly what you're looking for in seconds.\nWatch your media in flat-screen mode, flat 3D, or fully immersive VR/XR with multiple fisheye FOVs. \nPlay up to four videos at once with MultiView, or keep one running in Picture-in-Picture while you browse.\n\nFeatures:\n- Full search, filter, and sort across your Stash library, with support for all Stash filters\n- Scene Wall and Image Wall - Browse endlessly through your scenes and images\n- Flat-screen, flat 3D (SBS/OU) and immersive VR/XR playback modes, with 180\u00b0, 190\u00b0, 200\u00b0 and 220\u00b0 fisheye FOVs\n- MultiView - Play up to four videos at once\n- Picture-in-Picture - Keep videos playing while browsing your library\n- Hand Tracking support allowing for seamless controls\n- Customizable input bindings\n- Funscript Support\n- Clean, fast interface designed for headset navigation\n- Transcoding support for easy playback\n- Private - your library stays on your server", "display_long_description_unprocessed": "Browse, search, and stream your Stash library right from your headset.\n\nStashXR connects to your self-hosted Stash server and puts your entire media collection at your fingertips in a sleek, immersive interface.\nFilter by tags, performers, studios and more. Sort however you like. Find exactly what you're looking for in seconds.\nWatch your media in flat-screen mode, flat 3D, or fully immersive VR/XR with multiple fisheye FOVs. \nPlay up to four videos at once with MultiView, or keep one running in Picture-in-Picture while you browse.\n\nFeatures:\n- Full search, filter, and sort across your Stash library, with support for all Stash filters\n- Scene Wall and Image Wall - Browse endlessly through your scenes and images\n- Flat-screen, flat 3D (SBS/OU) and immersive VR/XR playback modes, with 180\u00b0, 190\u00b0, 200\u00b0 and 220\u00b0 fisheye FOVs\n- MultiView - Play up to four videos at once\n- Picture-in-Picture - Keep videos playing while browsing your library\n- Hand Tracking support allowing for seamless controls\n- Customizable input bindings\n- Funscript Support\n- Clean, fast interface designed for headset navigation\n- Transcoding support for easy playback\n- Private - your library stays on your server", "genre_names": ["Media"], "has_in_app_ads": false, "id": "27145614515041229", "is_approved": false, "is_concept": false, "is_enterprise_enabled": false, "organization": {"id": "", "is_authorized_for_quest": false, "application_groupings": {"count": 0, "nodes": [], "__typename": "", "typename_enum": 0}}, "platform": "", "publisher_name": "StashXR", "required_space_adjusted": 107147198, "requiredSpaceAdjustedFormatted": "102.18 MB", "total_installed_space": 154846063, "totalInstalledSpaceFormatted": "147.67 MB", "quality_rating_aggregate": 0, "img": "", "packageName": "com.StashXR.StashXR", "imageLink": "/cdn/images/27145614515041229", "release_channels": {"count": 2, "nodes": [{"latest_supported_binary": {"binary_application": null, "id": "", "version": "", "platform": "", "package_name": null, "targeted_devices": [], "min_android_sdk_version": null, "max_android_sdk_version": null, "target_android_sdk_version": null, "targeted_devices_enum": [], "file_name": "", "uri": "", "change_log": null, "changeLog": null, "richChangeLog": "", "firewall_exceptions_required": false, "is_2d_mode_supported": false, "launch_file": "", "launch_file_2d": null, "launch_parameters": "", "launch_parameters_2d": null, "Platform": "", "release_notes_plain_text": 
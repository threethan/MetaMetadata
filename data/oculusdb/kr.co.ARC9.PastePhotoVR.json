benefit": null, "strikethrough_price": {"offset_amount": "399", "offset_amount_numerical": 399, "currency": "EUR", "formatted": "\u20ac3.99"}}, "displayName": "Paste Photo VR", "display_name": "Paste Photo VR", "display_long_description": "Turn your room into a personal spatial media workspace. Arrange your favorite content in VR or mixed reality, save the layout, and return to it anytime.\n\n**Place More Than Photos**\n- Open JPG, PNG, GIF, MP4, PDF, GLB, VRM, VRMA, web, and NDI content.\n- Transfer files from a phone or PC over the same Wi-Fi, or scan QR codes to open and save media.\n\n**Bring Your Devices Into VR**\n- Mirror and control Android phones and PCs with companion apps.\n- Use hand tracking or Touch controllers for taps, drags, scrolling, keyboard input, and right-click.\n- Open multiple remote screens and save their device assignments and positions.\n\n**Create and Watch in 3D**\n- Browse video thumbnails and seek to any point in playback.\n- Play compatible side-by-side and top-and-bottom MP4 videos with automatic stereo detection.\n- Record stereoscopic MP4 memories with 3D CAM on supported Quest headsets.\n\n**Animate Your Avatars**\n- Load VRM avatars, capture body motion, play VRMA animations, and edit poses, timing, and synchronized WAV audio.\n\nNDI input, passthrough image capture, and NDI output are available on compatible devices. Core media placement works offline; network features require compatible devices or services on the same local network.\n\n*Paste Photo VR is in Early Access.*", "display_long_description_unprocessed": "Turn your room into a personal spatial media workspace. Arrange your favorite content in VR or mixed reality, save the layout, and return to it anytime.\n\n**Place More Than Photos**\n- Open JPG, PNG, GIF, MP4, PDF, GLB, VRM, VRMA, web, and NDI content.\n- Transfer files from a phone or PC over the same Wi-Fi, or scan QR codes to open and save media.\n\n**Bring Your Devices Into VR**\n- Mirror and control Android phones and PCs with companion apps.\n- Use hand tracking or Touch controllers for taps, drags, scrolling, keyboard input, and right-click.\n- Open multiple remote screens and save their device assignments and positions.\n\n**Create and Watch in 3D**\n- Browse video thumbnails and seek to any point in playback.\n- Play compatible side-by-side and top-and-bottom MP4 videos with automatic stereo detection.\n- Record stereoscopic MP4 memories with 3D CAM on supported Quest headsets.\n\n**Animate Your Avatars**\n- Load VRM avatars, capture body motion, play VRMA animations, and edit poses, timing, and synchronized WAV audio.\n\nNDI input, passthrough image capture, and NDI output are available on compatible devices. Core media placement works offline; network features require compatible devices or services on the same local network.\n\n*Paste Photo VR is in Early Access.*", "genre_names": ["Media", "Utilities", "Productivity"], "has_in_app_ads": false, "id": "8767138216715369", "is_approved": false, "is_concept": false, "is_enterprise_enabled": false, "organization": {"id": "", "is_authorized_for_quest": false, "application_groupings": {"count": 0, "nodes": [], "__typename": "", "typename_enum": 0}}, "platform": "", "publisher_name": "woojoung", "required_space_adjusted": 345524208, "requiredSpaceAdjustedFormatted": "329.52 MB", "total_installed_space": 317903237, "totalInstalledSpaceFormatted": "303.18 MB", "quality_rating_aggregate": 0, "img": "", "packageName": "kr.co.ARC9.PastePhotoVR", "imageLink": "/cdn/images/8767138216715369", "release_channels": {"count": 2, "nodes": [{"latest_supported_binary": {"binary_application": null, "id": "", "version": "", "platform": "", "package_name": null, "targeted_devices": [], "min_android_sdk_version": null, "max_android_sdk_version": null, "target_android_sdk_version": null, "targeted_devices_enum": [], "file_name": "", "uri": "", "change_log": null, "changeLog": null, "richChangeLog": "", "firewall_exceptions_required": false, "i
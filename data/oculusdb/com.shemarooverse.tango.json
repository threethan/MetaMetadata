{"__lastUpdated": "2026-09-03T23:59:59.216Z", "__OculusDBType": "Application", "group": 0, "binaryType": 1, "hmd": 1, "__sn": "OculusDB-Official", "blocked": false, "appName": "Tango Charlie", "baseline_offer": null, "priceFormatted": "0.-01", "priceOffsetNumerical": -1, "priceLimboDetected": false, "appHasDiscount": false, "discountEndTime": "0001-01-01T00:00:00", "appHasTrial": false, "appCanBeBought": false, "currency": "", "canonicalName": "shemarooverse-digital-limited-tango-charlie-android6d0f-o-ytiz", "current_gift_offer": null, "current_offer": null, "current_trial_offer": null, "displayName": "Tango Charlie", "display_name": "Tango Charlie", "display_long_description": "Inspired by the Bollywood film Tango Charlie, this single-player VR experience immerses you in the life of an Indian Army sepoy on a mission deep in the jungles of Manipur.\nBegin with a rigorous training session\u2014mastering firearms, grenades, and survival skills like crawling under barbed wire\u2014to prepare for the battles ahead. Dropped off by truck into hostile territory, your first task is to reach the base camp while avoiding hidden traps and enemy ambushes.\nFrom there, the mission escalates: rescue kidnapped soldiers, infiltrate insurgent camps, and destroy their bomb-making factory. But the fight doesn\u2019t end there\u2014the insurgent leader is on the run, and your final challenge is to capture him, dead or alive, before he crosses the border.\nWith immersive combat mechanics, realistic environments, and a gripping storyline, Tango Charlie tests your courage, skill, and determination. Victory is yours only if you stop the leader\u2019s escape. Fail, and the mission\u2014and the nation\u2014are lost.\n", "display_long_description_unprocessed": "Inspired by the Bollywood film Tango Charlie, this single-player VR experience immerses you in the life of an Indian Army sepoy on a mission deep in the jungles of Manipur.\nBegin with a rigorous training session\u2014mastering firearms, grenades, and survival skills like crawling under barbed wire\u2014to prepare for the battles ahead. Dropped off by truck into hostile territory, your first task is to reach the base camp while avoiding hidden traps and enemy ambushes.\nFrom there, the mission escalates: rescue kidnapped soldiers, infiltrate insurgent camps, and destroy their bomb-making factory. But the fight doesn\u2019t end there\u2014the insurgent leader is on the run, and your final challenge is to capture him, dead or alive, before he crosses the border.\nWith immersive combat mechanics, realistic environments, and a gripping storyline, Tango Charlie tests your courage, skill, and determination. Victory is yours only if you stop the leader\u2019s escape. Fail, and the mission\u2014and the nation\u2014are lost.\n", "genre_names": ["Shooter", "Action"], "has_in_app_ads": false, "id": "24713277871682853", "is_approved": false, "is_concept": false, "is_enterprise_enabled": false, "organization": {"id": "", "is_authorized_for_quest": false, "application_groupings": {"count": 0, "nodes": [], "__typename": "", "typename_enum": 0}}, "platform": "", "publisher_name": "ShemarooVerse Digital Limited", "required_space_adjusted": -1, "requiredSpaceAdjustedFormatted": "-1 Bytes", "total_installed_space": -1, "totalInstalledSpaceFormatted": "-1 Bytes", "quality_rating_aggregate": 0, "img": "", "packageName": "com.shemarooverse.tango", "imageLink": "/cdn/images/24713277871682853", "release_channels": {"count": 3, "nodes": [{"latest_supported_binary": {"binary_application": null, "id": "", "version": "", "platform": "", "package_name": null, "targeted_devices": [], "min_android_sdk_version": null, "max_android_sdk_version": null, "target_android_sdk_version": null, "targeted_devices_enum": [], "file_name": "", "uri": "", "change_log": null, "changeLog": null, "richChangeLog": "", "firewall_exceptions_required": false, "is_2d_mode_supported": false, "launch_file": "", "launch_file_2d": null, "launch_paramete
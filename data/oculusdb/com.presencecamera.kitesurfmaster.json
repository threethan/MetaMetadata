{"__lastUpdated": "2026-09-04T00:38:42.161Z", "__OculusDBType": "Application", "group": 0, "binaryType": 1, "hmd": 2, "__sn": "OculusDB-Official", "blocked": false, "appName": "Kitesurf Master", "baseline_offer": {"status": "", "status_enum": -1, "end_time": 0, "id": "1230589899234815", "show_timer": false, "price": {"offset_amount": "399", "offset_amount_numerical": 399, "currency": "EUR", "formatted": "\u20ac3.99"}, "promo_benefit": null, "strikethrough_price": null, "__typename": "AppStoreOffer", "typename_enum": 8}, "priceFormatted": "\u20ac3.99", "priceOffsetNumerical": 399, "priceLimboDetected": false, "appHasDiscount": false, "discountEndTime": "0001-01-01T00:00:00", "appHasTrial": false, "appCanBeBought": true, "currency": "EUR", "canonicalName": "presence-camera-kitesurf-master-android6d0f-zpjvzr", "current_gift_offer": {"status": "", "status_enum": -1, "end_time": 0, "id": "1230589899234815", "show_timer": false, "price": {"offset_amount": "399", "offset_amount_numerical": 399, "currency": "EUR", "formatted": "\u20ac3.99"}, "promo_benefit": null, "strikethrough_price": null, "__typename": "AppStoreOffer", "typename_enum": 8}, "current_offer": {"status": "", "status_enum": -1, "end_time": 0, "id": "1230589899234815", "show_timer": false, "price": {"offset_amount": "399", "offset_amount_numerical": 399, "currency": "EUR", "formatted": "\u20ac3.99"}, "promo_benefit": null, "strikethrough_price": null, "__typename": "AppStoreOffer", "typename_enum": 8}, "current_trial_offer": null, "displayName": "Kitesurf Master", "display_name": "Kitesurf Master", "display_long_description": "Master the kite before hitting the water in this realistic kite control simulator.\nTrain in a visually rich tropical beach environment designed to feel natural and inviting, and experience the physics of kite control using hand tracking\u2014no controllers required\u2014in a safe and immersive space.\nThere are no missions, no tutorials, no levels, no scores\u2014just the experience of flying the kite.\nKite control is uniquely suited for VR, as it can be simulated one-to-one.You hold and move a virtual control bar just like in real kitesurfing, with the kite responding directly to your input.\nIt is also simply fun. Most people will never have the chance to handle a real trainer kite. In virtual reality, anyone can safely enjoy the feeling of flying a kite.\nNo previous kiteboarding experience is required.\nIf you are a seasoned kiter let friends and family experience kite control for the first time and show them how the wind window works in a simple and intuitive way.\nKitesurf Master is an independent project that aims to grow to include training modes, guided exercises, expanded locations, and optional game features. Please support this project.\nFor now, it is pure kite control in a world that feels real.\n Simple, realistic, and fun.\n", "display_long_description_unprocessed": "Master the kite before hitting the water in this realistic kite control simulator.\nTrain in a visually rich tropical beach environment designed to feel natural and inviting, and experience the physics of kite control using hand tracking\u2014no controllers required\u2014in a safe and immersive space.\nThere are no missions, no tutorials, no levels, no scores\u2014just the experience of flying the kite.\nKite control is uniquely suited for VR, as it can be simulated one-to-one.You hold and move a virtual control bar just like in real kitesurfing, with the kite responding directly to your input.\nIt is also simply fun. Most people will never have the chance to handle a real trainer kite. In virtual reality, anyone can safely enjoy the feeling of flying a kite.\nNo previous kiteboarding experience is required.\nIf you are a seasoned kiter let friends and family experience kite control for the first time and show them how the wind window works in a simple and intuitive way.\nKitesurf Master is an independent project that aims to grow to include training modes, guided exercises, expanded locations, and optional game features. Please support this project.\nFor now, it is pure kite control in a world that feels real.\n Simple, realistic, and fun.\n", "genre_names": ["Sports training", "Learning"], "has_in_app_ads": false, "id": "25756381377287799", "is_approved": false, "is_concept": false, "is_enterprise_enabled": false, "organization": {"id": "", "is_authorized_for_quest": false, "application_groupings": {"count": 0, "nodes": [], "__typename": "", "typename_enum": 0}}, "platform": "", "publisher_name": "Presence Camera", "required_space_adjusted": 432159754, "requiredSpaceAdjustedFormatted": "412.14 MB", "total_installed_space": 348702945, "totalInstalledSpaceFormatted": "332.55 MB", "quality_rating_aggregate": 0, "img": "", "packageName": "com.presencecamera.kitesurfmaster", "imageLink": "/cdn/images/25756381377287799", "release_channels": {"count": 3, "nodes": [{"latest_supported_binary": {"binary_application": null, "id": "", "version": "", "platform": "", "package_name": null, "targeted_devices": [], "min_android_sdk_version": null, "max_android_sdk_version": null, "target_android_sdk_version": null, "targeted_devices_enum": [], "file_name": "", "uri": "", "change_log": null, "changeLog": null, "richChangeLog": "", "firewall_exceptions_required": false, "is_2d_mode_supported": false, "launch_file": "", "launch_file_2d": null, "launch_parameters": "", "launch_parameters_2d": null, "Platform": "", "release_notes_plain_text": "", "required_space": "0", "required_space_numerical": 0, "total_installed_space": "0", "total_installed_space_numerical": 0, "required_space_adjusted": "0", "required_space_adjusted_numerical": 0, "size": "0", "size_numerical": 0, "supported_hmd_platforms": [], "supported_hmd_platforms_enum": [], "permissions": [], "__isAppBinary": "", "debug_syymbols": {"count": 0, "edges": [], "page_info": {"end_cursor": null, "start_cursor": null, "has_next_page": false}, "__typename": "", "typename_enum": 0}, "__isAppBin
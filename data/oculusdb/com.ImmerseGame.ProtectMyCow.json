{"__lastUpdated": "2026-08-12T23:41:59.649Z", "__OculusDBType": "Application", "group": 0, "binaryType": 1, "hmd": 1, "__sn": "OculusDB-Official", "blocked": false, "appName": "Protect My Cow", "baseline_offer": null, "priceFormatted": "0.-01", "priceOffsetNumerical": -1, "priceLimboDetected": false, "appHasDiscount": false, "discountEndTime": "0001-01-01T00:00:00", "appHasTrial": true, "appCanBeBought": false, "currency": "", "canonicalName": "immerse-game-protect-my-cow-android6d0f-qwzwry", "current_gift_offer": null, "current_offer": null, "current_trial_offer": {"descriptions": ["You can download a trial version of this app to try it for 15 minutes for free.", "You won\u2019t be charged anything when this free trial ends. You can\u2019t make in-app purchases or use add-on content during this free trial, but you\u2019ll keep any achievements you earn."], "trial_start_time": 0, "trial_end_time": 0, "id": "2232320980833723", "show_timer": false, "price": {"offset_amount": "0", "offset_amount_numerical": 0, "currency": "EUR", "formatted": "\u20ac0.00"}, "promo_benefit": null, "strikethrough_price": null}, "displayName": "Protect My Cow", "display_name": "Protect My Cow", "display_long_description": "They want your cow. You're not letting that happen.\n\nProtect My Cow is an arcade roguelite developed for virtual reality (VR) and mixed reality (MR). You pilot a ship that moves freely across an island, shooting down enemies to stop an alien invasion. Your one and only mission: protect your cows from being abducted.\n\nInspired by games like Vampire Survivors, each match becomes a growing battle against endless waves of enemies. With simple, accessible, and addictive mechanics, the game offers a fast-paced, intense, and fun experience, perfect for quick sessions or extended play.\n\n\u2714\ufe0f Single-player\n\u2714\ufe0f Intuitive controls with free movement in VR/MR\n\u2714\ufe0f High replayability with increasing difficulty\n\u2714\ufe0f Fun and charming visual style\n\u2714\ufe0f 6 Ships with different skills to choose\n\u2714\ufe0f Perfect for fans of Vampire Survivors, Brotato, and other bullet-heaven games\n\nGet ready to laugh, sweat, and protect what\u2019s yours because no one messes with your cow.", "display_long_description_unprocessed": "They want your cow. You're not letting that happen.\n\nProtect My Cow is an arcade roguelite developed for virtual reality (VR) and mixed reality (MR). You pilot a ship that moves freely across an island, shooting down enemies to stop an alien invasion. Your one and only mission: protect your cows from being abducted.\n\nInspired by games like Vampire Survivors, each match becomes a growing battle against endless waves of enemies. With simple, accessible, and addictive mechanics, the game offers a fast-paced, intense, and fun experience, perfect for quick sessions or extended play.\n\n\u2714\ufe0f Single-player\n\u2714\ufe0f Intuitive controls with free movement in VR/MR\n\u2714\ufe0f High replayability with increasing difficulty\n\u2714\ufe0f Fun and charming visual style\n\u2714\ufe0f 6 Ships with different skills to choose\n\u2714\ufe0f Perfect for fans of Vampire Survivors, Brotato, and other bullet-heaven games\n\nGet ready to laugh, sweat, and protect what\u2019s yours because no one messes with your cow.", "genre_names": ["Shooter", "Arcade", "Action", "Survival"], "has_in_app_ads": false, "id": "24179091841675932", "is_approved": false, "is_concept": false, "is_enterprise_enabled": false, "organization": {"id": "", "is_authorized_for_quest": false, "application_groupings": {"count": 0, "nodes": [], "__typename": "", "typename_enum": 0}}, "platform": "", "publisher_name": "Immerse Game", "required_space_adjusted": -1, "requiredSpaceAdjustedFormatted": "-1 Bytes", "total_installed_space": -1, "totalInstalledSpaceFormatted": "-1 Bytes", "quality_rating_aggregate": 0, "img": "", "packageName": "com.ImmerseGame.ProtectMyCow", "imageLink": "/cdn/images/24179091841675932", "release
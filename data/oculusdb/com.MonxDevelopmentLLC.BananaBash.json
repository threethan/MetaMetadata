{"__lastUpdated": "2026-09-03T20:05:31.96Z", "__OculusDBType": "Application", "group": 0, "binaryType": 1, "hmd": 2, "__sn": "OculusDB-Official", "blocked": false, "appName": "Banana Bash\u2122", "baseline_offer": null, "priceFormatted": "0.-01", "priceOffsetNumerical": -1, "priceLimboDetected": false, "appHasDiscount": false, "discountEndTime": "0001-01-01T00:00:00", "appHasTrial": false, "appCanBeBought": false, "currency": "", "canonicalName": "jj12333-banana-bash-android6d0f-gy9n5g", "current_gift_offer": null, "current_offer": null, "current_trial_offer": null, "displayName": "Banana Bash\u2122", "display_name": "Banana Bash\u2122", "display_long_description": "Banana Bash \u2013 The Ultimate VR Tag Adventure!\nGet ready for an exhilarating VR experience like no other! Banana Bash is a fast-paced multiplayer game where agility, strategy, and skill determine who comes out on top. Using intuitive physics-based movement, you\u2019ll climb, swing, and bounce your way through thrilling environments in a game of tag like you\u2019ve never seen before.\n\nExplore the World of Banana Bash\n\ud83c\udf32 The Forest \u2013 An underground world full of tall, climbable trees, hidden tunnels, and strategic spots for both escaping and ambushing your opponents. Use your surroundings to gain the upper hand as you leap from tree to tree, dodging those chasing you.\n\n\ud83c\udfe0 The Lobby \u2013 The heart of the game, where players gather before matches, check leaderboards, and interact. Customize your settings, chat with friends, and prepare for your next big chase.\n\n\ud83d\udecd\ufe0f The Shop \u2013 Want to stand out? The in-game shop lets you customize your character with a variety of hats, cosmetics, and accessories. Whether you want to look cool, goofy, or downright mysterious, there\u2019s something for everyone!\n\nTHIS GAME IS BETTER ON: Meta quest 3, and Meta quest 3s headsets\n", "display_long_description_unprocessed": "Banana Bash \u2013 The Ultimate VR Tag Adventure!\nGet ready for an exhilarating VR experience like no other! Banana Bash is a fast-paced multiplayer game where agility, strategy, and skill determine who comes out on top. Using intuitive physics-based movement, you\u2019ll climb, swing, and bounce your way through thrilling environments in a game of tag like you\u2019ve never seen before.\n\nExplore the World of Banana Bash\n\ud83c\udf32 The Forest \u2013 An underground world full of tall, climbable trees, hidden tunnels, and strategic spots for both escaping and ambushing your opponents. Use your surroundings to gain the upper hand as you leap from tree to tree, dodging those chasing you.\n\n\ud83c\udfe0 The Lobby \u2013 The heart of the game, where players gather before matches, check leaderboards, and interact. Customize your settings, chat with friends, and prepare for your next big chase.\n\n\ud83d\udecd\ufe0f The Shop \u2013 Want to stand out? The in-game shop lets you customize your character with a variety of hats, cosmetics, and accessories. Whether you want to look cool, goofy, or downright mysterious, there\u2019s something for everyone!\n\nTHIS GAME IS BETTER ON: Meta quest 3, and Meta quest 3s headsets\n", "genre_names": ["Platformer", "Action", "Hangout", "Adventure"], "has_in_app_ads": false, "id": "28871275552517905", "is_approved": false, "is_concept": false, "is_enterprise_enabled": false, "organization": {"id": "", "is_authorized_for_quest": false, "application_groupings": {"count": 0, "nodes": [], "__typename": "", "typename_enum": 0}}, "platform": "", "publisher_name": "Monx Development LLC", "required_space_adjusted": 186515038, "requiredSpaceAdjustedFormatted": "177.87 MB", "total_installed_space": 177205414, "totalInstalledSpaceFormatted": "169 MB", "quality_rating_aggregate": 0, "img": "", "packageName": "com.MonxDevelopmentLLC.BananaBash", "imageLink": "/cdn/images/28871275552517905", "release_channels": {"count": 2, "nodes": [{"latest_supported_binary": {"binary_application": null, "
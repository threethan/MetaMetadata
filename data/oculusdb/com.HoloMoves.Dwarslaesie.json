{"__lastUpdated": "2026-06-15T13:27:28.184Z", "__OculusDBType": "Application", "group": 0, "binaryType": 1, "hmd": 2, "__sn": "OculusDB-Official", "blocked": false, "appName": "Spinal Cord Injury Education", "baseline_offer": {"status": "", "status_enum": -1, "end_time": 0, "id": "1298872798596589", "show_timer": false, "price": {"offset_amount": "0", "offset_amount_numerical": 0, "currency": "EUR", "formatted": "\u20ac0.00"}, "promo_benefit": null, "strikethrough_price": null, "__typename": "AppStoreOffer", "typename_enum": 8}, "priceFormatted": "\u20ac0.00", "priceOffsetNumerical": 0, "priceLimboDetected": false, "appHasDiscount": false, "discountEndTime": "0001-01-01T00:00:00", "appHasTrial": false, "appCanBeBought": true, "currency": "EUR", "canonicalName": "holomoves-spinal-cord-injury-education-android6d0f-3kru8y", "current_gift_offer": null, "current_offer": {"status": "", "status_enum": -1, "end_time": 0, "id": "1298872798596589", "show_timer": false, "price": {"offset_amount": "0", "offset_amount_numerical": 0, "currency": "EUR", "formatted": "\u20ac0.00"}, "promo_benefit": null, "strikethrough_price": null, "__typename": "AppStoreOffer", "typename_enum": 8}, "current_trial_offer": null, "displayName": "Spinal Cord Injury Education", "display_name": "Spinal Cord Injury Education", "display_long_description": "This mixed reality education app helps patients with a spinal cord injury better understand their condition during and after rehabilitation. By using the immersive power of 3D, it transforms complex medical information into clear, interactive explanations. Patients can explore the nervous system, see how a spinal cord injury disrupts communication between brain and body, and understand its effects on daily life.\n\n**The app covers essential topics such as:**\n\n- What a spinal cord injury is and how it develops.\n\n- How the nervous system works and changes after injury.\n\n- Bladder and bowel function and strategies for managing them.\n\n- Neuropathic pain and available treatment options.\n\n- Sexuality and intimacy after spinal cord injury.\n\nThe project was co-created with De Hoogstraat Rehabilitation, rehabilitation physicians, and patients themselves. Their combined expertise and lived experiences ensure that the content is accurate, relevant, and sensitive to real needs.\n\n**(!) This application is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "display_long_description_unprocessed": "This mixed reality education app helps patients with a spinal cord injury better understand their condition during and after rehabilitation. By using the immersive power of 3D, it transforms complex medical information into clear, interactive explanations. Patients can explore the nervous system, see how a spinal cord injury disrupts communication between brain and body, and understand its effects on daily life.\n\n**The app covers essential topics such as:**\n\n- What a spinal cord injury is and how it develops.\n\n- How the nervous system works and changes after injury.\n\n- Bladder and bowel function and strategies for managing them.\n\n- Neuropathic pain and available treatment options.\n\n- Sexuality and intimacy after spinal cord injury.\n\nThe project was co-created with De Hoogstraat Rehabilitation, rehabilitation physicians, and patients themselves. Their combined expertise and lived experiences ensure that the content is accurate, relevant, and sensitive to real needs.\n\n**(!) This application is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "genre_names": ["Learning", "Medical"], "has_in_app_ads": false, "id": "24640823835547503", "is_approved": false, "is_con
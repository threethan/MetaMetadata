{"__lastUpdated": "2026-07-15T01:00:27.474Z", "__OculusDBType": "Application", "group": 0, "binaryType": 1, "hmd": 2, "__sn": "OculusDB-Official", "blocked": false, "appName": "\uc6a9\uc874\uc0b0\uc18c \uce21\uc815 \uc2e4\ud5d8", "baseline_offer": {"status": "", "status_enum": -1, "end_time": 0, "id": "1287211203283547", "show_timer": false, "price": {"offset_amount": "0", "offset_amount_numerical": 0, "currency": "EUR", "formatted": "\u20ac0.00"}, "promo_benefit": null, "strikethrough_price": null, "__typename": "AppStoreOffer", "typename_enum": 8}, "priceFormatted": "\u20ac0.00", "priceOffsetNumerical": 0, "priceLimboDetected": false, "appHasDiscount": false, "discountEndTime": "0001-01-01T00:00:00", "appHasTrial": false, "appCanBeBought": true, "currency": "EUR", "canonicalName": "knou-android6d0f-hmttnn", "current_gift_offer": null, "current_offer": {"status": "", "status_enum": -1, "end_time": 0, "id": "1287211203283547", "show_timer": false, "price": {"offset_amount": "0", "offset_amount_numerical": 0, "currency": "EUR", "formatted": "\u20ac0.00"}, "promo_benefit": null, "strikethrough_price": null, "__typename": "AppStoreOffer", "typename_enum": 8}, "current_trial_offer": null, "displayName": "\uc6a9\uc874\uc0b0\uc18c \uce21\uc815 \uc2e4\ud5d8", "display_name": "\uc6a9\uc874\uc0b0\uc18c \uce21\uc815 \uc2e4\ud5d8", "display_long_description": "\ubcf8 \ucf58\ud150\uce20\ub294 \uc719\ud074\ub7ec \ubcc0\ubc95\uc744 \uae30\ubc18\uc73c\ub85c \uc218\uc911 \uc6a9\uc874\uc0b0\uc18c(Dissolved Oxygen, DO)\ub97c \uc815\ub7c9\uc801\uc73c\ub85c \ubd84\uc11d\ud558\ub294 \uac00\uc0c1\uc2e4\ud5d8 \ucf58\ud150\uce20\uc785\ub2c8\ub2e4. \ud559\uc2b5\uc790\ub294 \uc2e4\uc81c \uc2e4\ud5d8 \uc808\ucc28\uc640 \ub3d9\uc77c\ud55c \ub2e8\uacc4 \uad6c\uc870\ub97c \ub530\ub77c\uac00\uba70 \uc2dc\ub8cc \ucc44\ucde8, \uc2dc\uc57d \ucca8\uac00, \uc0b0\uc18c \uace0\uc815 \ubc18\uc751, \uce68\uc804 \uc0dd\uc131 \ubc0f \uc6a9\ud574 \uacfc\uc815, \uc801\uc815 \uc218\ud589, \uc885\ub9d0\uc810 \ud310\uc815\uae4c\uc9c0 \uc804 \uacfc\uc815\uc744 \uccb4\uacc4\uc801\uc73c\ub85c \uacbd\ud5d8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac01 \ub2e8\uacc4\ub294 \ub2e8\uc21c\ud55c \uc870\uc791 \uc218\ud589\uc774 \uc544\ub2c8\ub77c \ud654\ud559 \ubc18\uc751\uc758 \uc6d0\ub9ac\uc640 \uc2e4\ud5d8 \ubaa9\uc801\uc744 \uc774\ud574\ud558\ub3c4\ub85d \uad6c\uc131\ub418\uc5b4 \uc788\uc5b4, \uc2e4\ud5d8 \uacfc\uc815\uacfc \uc774\ub860 \ud559\uc2b5\uc774 \ub3d9\uc2dc\uc5d0 \uc774\ub8e8\uc5b4\uc9d1\ub2c8\ub2e4.  \n\n\ud2b9\ud788 \uc0b0\uc18c \uace0\uc815 \ubc18\uc751\uc5d0\uc11c \uc0dd\uc131\ub418\ub294 \uce68\uc804\uc758 \uc758\ubbf8\uc640 \ud669\uc0b0 \ucca8\uac00 \ud6c4 \uc6a9\ud574 \uacfc\uc815, \uadf8\ub9ac\uace0 \uc694\uc624\ub4dc \uc0dd\uc131\uacfc \ud658\uc6d0 \uc801\uc815\uc758 \uba54\ucee4\ub2c8\uc998\uc744 \uc2dc\uac01\uc801\uc73c\ub85c \ud655\uc778\ud560 \uc218 \uc788\uc5b4 \ud559\uc2b5\uc790\uc758 \uac1c\ub150 \uc774\ud574\ub97c \uac15\ud654\ud569\ub2c8\ub2e4. \uc801\uc815 \ub2e8\uacc4\uc5d0\uc11c\ub294 \ubdf0\ub81b \uc0ac\uc6a9 \ubc29\ubc95, \ub208\uae08 \ud310\ub3c5, \uc885\ub9d0\uc810 \uc0c9 \ubcc0\ud654 \ud310\ub2e8 \ub4f1 \uc815\ubc00\ud55c \uc870\uc791 \uc694\uc18c\uac00 \uacb0\uacfc\uac12\uc5d0 \uc9c1\uc811 \ubc18\uc601\ub418\ub3c4\ub85d \uc124\uacc4\ub418\uc5b4, \uc2e4\ud5d8 \uc815\ud655\ub3c4\uc640 \uce21\uc815 \uc2e0\ub8b0\ub3c4\uc758 \uc911\uc694\uc131\uc744 \uc790\uc5f0\uc2a4\ub7fd\uac8c \ud559\uc2b5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\ub610\ud55c \ubc18\ubcf5 \uc2e4\ud5d8 \uae30\ub2a5\uc744 \ud1b5\ud574 \ub3d9\uc77c \uc870\uac74\uc5d0\uc11c\uc758 \uce21\uc815\uac12 \ube44\uad50, \ud3c9\uade0\uac12 \ub3c4\ucd9c, \uc624\ucc28 \uc6d0\uc778 \ubd84\uc11d\uc744 \uc218\ud589\ud560 \uc218 \uc788\uc73c\uba70, \uc2e4\ud5d8 \uc870\uac74 \ubcc0\ud654\uc5d0 \ub530\ub978 \uacb0\uacfc \ucc28\uc774\ub97c \ud655\uc778\ud558\uc5ec \ub370\uc774\ud130 \ud574\uc11d \ub2a5\ub825\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub97c \ud1b5\ud574 \ud559\uc2b5\uc790\ub294 \ub2e8\uc21c\ud55c \uacb0\uacfc \ud655\uc778\uc744 \ub118\uc5b4 \uacfc\ud559\uc801 \uadfc\uac70\uc5d0 \uae30\ubc18\ud55c \ubd84\uc11d\uc801 \uc0ac\uace0\ub97c \uae30\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\ubcf8 \ucf58\ud150\uce20\ub294 \uc2e4\uc81c \uc624\ud504\ub77c\uc778 \uc2e4\ud5d8 \uc218\ud589 \uc804 \uac1c\ub150 \uc815\ub9bd \ub2e8\uacc4\uc5d0\uc11c \ud65c\uc6a9\ud560 \uc218 \uc788\uc73c\uba70, \uc2e4\ud5d8 \uc7a5\ube44 \uc0ac\uc6a9 \uc804 \uc808\ucc28 \uc219\ub2ec \ubc0f \uc548\uc804 \uad50\uc721\uc6a9 \uc790\ub8cc\ub85c\ub3c4 \uc801\ud569\ud569\ub2c8\ub2e4. \ub610\ud55c \uc815\ub7c9 \ubd84\uc11d \uc2e4\ud5d8\uc758 \ubc18\ubcf5 \ud6c8\ub828\uc774 \ud544\uc694\ud55c \uad50\uc721 \ud658\uacbd\uc5d0\uc11c \ubcf4\uc870 \ud559\uc2b5 \ub3c4\uad6c\ub85c \ud65c\uc6a9\ud560 \uc218 \uc788\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4.\n", "display_long_description_unprocessed": "\ubcf8 \ucf58\ud150\uce20\ub294 \uc719\ud074\ub7ec \ubcc0\ubc95\uc744 \uae30\ubc18\uc73c\ub85c \uc218\uc911 \uc6a9\uc874\uc0b0\uc18c(Dissolved Oxygen, DO)\ub97c \uc815\ub7c9\uc801\uc73c\ub85c \ubd84\uc11d\ud558\ub294 \uac00\uc0c1\uc2e4\ud5d8 \ucf58\ud150\uce20\uc785\ub2c8\ub2e4. \ud559\uc2b5\uc790\ub294 \uc2e4\uc81c \uc2e4\ud5d8 \uc808\ucc28\uc640 \ub3d9\uc77c\ud55c \ub2e8\uacc4 \uad6c\uc870\ub97c \ub530\ub77c\uac00\uba70 \uc2dc\ub8cc \ucc44\ucde8, \uc2dc\uc57d \ucca8\uac00, \uc0b0\uc18c \uace0\uc815 \ubc18\uc751, \uce68\uc804 \uc0dd\uc131 \ubc0f \uc6a9\ud574 \uacfc\uc815, \uc801\uc815 \uc218\ud589, \uc885\ub9d0\uc810 \ud310\uc815\uae4c\uc9c0 \uc804 \uacfc\uc815\uc744 \uccb4\uacc4\uc801\uc73c\ub85c \uacbd\ud5d8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac01 \ub2e8\uacc4\ub294 \ub2e8\uc21c\ud55c \uc870\uc791 \uc218\ud589\uc774 \uc544\ub2c8\ub77c \ud654\ud559 \ubc18\uc751\uc758 \uc6d0\ub9ac\uc640 \uc2e4\ud5d8 \ubaa9\uc801\uc744 \uc774\ud574\ud558\ub3c4\ub85d \uad6c\uc131\ub418\uc5b4 \uc788\uc5b4, \uc2e4\ud5d8 \uacfc\uc815\uacfc \uc774\ub860 \ud559\uc2b5\uc774 \u
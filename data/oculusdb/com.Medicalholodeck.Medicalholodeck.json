{"__lastUpdated": "2026-09-04T04:54:58.308Z", "__OculusDBType": "Application", "group": 0, "binaryType": 1, "hmd": 2, "__sn": "OculusDB-Official", "blocked": false, "appName": "MEDICALHOLODECK. ANATOMY, IMAGING, AI", "baseline_offer": {"status": "", "status_enum": -1, "end_time": 0, "id": "1551246655544709", "show_timer": false, "price": {"offset_amount": "0", "offset_amount_numerical": 0, "currency": "EUR", "formatted": "\u20ac0.00"}, "promo_benefit": null, "strikethrough_price": null, "__typename": "AppStoreOffer", "typename_enum": 8}, "priceFormatted": "\u20ac0.00", "priceOffsetNumerical": 0, "priceLimboDetected": false, "appHasDiscount": false, "discountEndTime": "0001-01-01T00:00:00", "appHasTrial": false, "appCanBeBought": true, "currency": "EUR", "canonicalName": "medicalholodeck-medicalholodeck-android6d0f", "current_gift_offer": null, "current_offer": {"status": "", "status_enum": -1, "end_time": 0, "id": "1551246655544709", "show_timer": false, "price": {"offset_amount": "0", "offset_amount_numerical": 0, "currency": "EUR", "formatted": "\u20ac0.00"}, "promo_benefit": null, "strikethrough_price": null, "__typename": "AppStoreOffer", "typename_enum": 8}, "current_trial_offer": null, "displayName": "MEDICALHOLODECK. ANATOMY, IMAGING, AI", "display_name": "MEDICALHOLODECK. ANATOMY, IMAGING, AI", "display_long_description": "**The human body is not flat. Yet medical imaging and anatomy are still primarily interpreted in two dimensions, creating a gap between data and understanding.**\n\nWork with medical imaging, anatomy atlases, AI segmentation, and digital twins across VR, 3D displays, and 2D systems.\n\nFree access for students. Send your proof of enrollment to info@medicalholodeck.com\n\n# Highlights\n- Interactive 3D medical imaging from CT, MRI, and DICOM\n- 3D anatomy atlases and virtual dissection\n- Real-time collaboration across devices and locations\n- Spatial recording for teaching and review\n- AI segmentation and patient-specific digital twins (PC-VR)\n- One system for VR, 3D displays, 2D screens, and iOS\n\n# Apps\n- Medical Imaging \u2013 interactive 3D imaging and case review\n- Dissection Master \u2013 virtual cadaver dissection\n- Anatomy Master \u2013 3D anatomy atlas with 2,000+ structures\n- RecordXR \u2013 record and replay spatial sessions\n- Spatial OS \u2013 shared spatial environment across devices (PC-VR tethered)\n- Medicalholodeck AI \u2013 automatic segmentation in seconds (PC-VR tethered for best performance)\n\n# Use cases\nUsed for anatomy education, simulation, interdisciplinary case discussions, tumor boards, patient communication, and immersive training with real medical data in interactive 3D.\n\n# Important notice\nMedicalholodeck is not a certified medical device and is intended for education, communication, training, and research purposes only.", "display_long_description_unprocessed": "**The human body is not flat. Yet medical imaging and anatomy are still primarily interpreted in two dimensions, creating a gap between data and understanding.**\n\nWork with medical imaging, anatomy atlases, AI segmentation, and digital twins across VR, 3D displays, and 2D systems.\n\nFree access for students. Send your proof of enrollment to info@medicalholodeck.com\n\n# Highlights\n- Interactive 3D medical imaging from CT, MRI, and DICOM\n- 3D anatomy atlases and virtual dissection\n- Real-time collaboration across devices and locations\n- Spatial recording for teaching and review\n- AI segmentation and patient-specific digital twins (PC-VR)\n- One system for VR, 3D displays, 2D screens, and iOS\n\n# Apps\n- Medical Imaging \u2013 interactive 3D imaging and case review\n- Dissection Master \u2013 virtual cadaver dissection\n- Anatomy Master \u2013 3D anatomy atlas with 2,000+ structures\n- RecordXR \u2013 record and replay spatial sessions\n- Spatial OS \u2013 shared spatial environment across devices (PC-VR tethered)\n- Medicalholodeck AI \u2013 automatic segmentation in seconds (PC-VR tethered for best performance)\n\n# Use cases\nUsed for anatomy education, simulation, interdisciplinary case discussions, tumor boards, patient communication, and immersive training with real medical data in interactive 3D.\n\n# Important notice\nMedicalholodeck is not a certified medical device and is intended for education, communication, training, and research purposes only.", "genre_names": ["Learning", "Medical"], "has_in_app_ads": false, "id": "3916133298437928", "is_approved": false, "is_concept": false, "is_enterprise_enabled": false, "organization": {"id": "", "is_authorized_for_quest": false, "application_groupings": {"count": 0, "nodes": [], "__typename": "", "typename_enum": 0}}, "platform": "", "publisher_name": "MEDICALHOLODECK\u00ae AG.", "required_space_adjusted": 351153668, "requiredSpaceAdjustedFormatted": "334.89 MB", "total_installed_space": 334010479, "totalInstalledSpaceFormatted": "318.54 MB", "quality_rating_aggregate": 0, "img": "", "packageName": "com.Medicalholodeck.Medicalholodeck", "imageLink": "/cdn/images/3916133298437928", "release_channels": {"count": 3, "nodes": [{"latest_supported_binary": {"binary_application": null, "id": "", "version": "", "platform": "", "package_name": null, "targeted_devices": [], "min_android_sdk_version": null, "max_android_sdk_version": null, "target_android_sdk_version": null, "targeted_devices_enum": [], "file_name": "", "uri": "", "change_log": null, "changeLog": null, "richChangeLog": "", "firewall_exceptions_required": false, "is_2d_mode_supported": false, "launch_file": "", "launch_file_2d": null, "launch_parameters": "", "launch_parameters_2d": null, "Platform": "", "release_notes_plain_text": "", "required_space": "0", "required_space_numerical": 0, "total_installed_space": "0", "total_installed_space_numerical": 0, "required_space_adjusted": "0", "required_space_adjusted_numerical": 0, "size": "0", "size_numerical": 0, "supported_hmd_platforms": [], "supported_hmd_platforms_enum": [], "permissions": [], 
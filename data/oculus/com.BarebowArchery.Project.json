xgvlssbm5ithFjvN9sDPNo3hnHfB4Ggpjr8hQL1CJ_rk34M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRdya0LKdnxVszUoqx-IXsWcXGe5nqhvwr1i1hqShH1vQ&oe=6B0C56EE"}, {"file_name": "HighresScreenshot00003.png", "id": "1627645404284521", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_1627645407617854_8388378307105579668_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDChLE-tCz8Q7kNvwFK9VDc&_nc_oc=Adr8EJ-S3_3kuQt5L1cgmT8sqxvYYNomCCe5f5GqgyLBgNfD6W-BtpPvdaqvCxUgvJ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRA2TDFrbmm5UBVKw2QNbWLZ1V4ond7AkmSNs8p3uwR9w&oe=6B0C769B"}, {"file_name": "HighresScreenshot00000.png", "id": "1396433787487957", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003276_1396433790821290_425870319526233919_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CBm2bfq-7MQ7kNvwEK77E_&_nc_oc=Adq5FNzuiWIRbxzztQI9x_wPOvp8Kjmn6sh3gp9YRb6Kpwn12_EyMf_RZ5ryhh3GlXU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQcUS9irMVS1ZhfNvFQVcKlZ5MDrhjr6rtTZcgQa1Nm1A&oe=6B0C6D41"}, {"file_name": "HighresScreenshot00002.png", "id": "3205530833022120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982584_3205530836355453_6629944535013068616_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSXs3yxSphYQ7kNvwFBa5hG&_nc_oc=AdqPtznSk5P_9mkBAPde93pk9B0XaJwE_-SD9xfVgxhi2UEG2Fq3uIjwA_XXK90VjDU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRyWIn2o83v76SInjxHkFO-jEfDXgMgI5jhXkmFODH7xA&oe=6B0C5A37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "maxresdefault.png", "id": "718315142701423", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974837_718315146034756_249526440641492702_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RL9i5WKLzAwQ7kNvwEAfK2Y&_nc_oc=AdqNmtz5rD7HN2A-w1zmPnV2QL4byIlLB2bDdwZSYHGACPK5gnuRyNp_8GQDh2eeBd0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ1vKOLF6RBoZ3B8bbUlnNz5JazI-lOl3P_Fs-_JYAiUw&oe=6B0C53AE"}, "display_name": "Backyard Archery VR", "keywords": [], "long_description": "Now Featuring Mixed Reality, Scan your room and play in it. Setup targets in your living room or bedroom or preferred play space.  \n\nMaster the technique of String-Walking. Draw to your anchor point, aim off the arrow tip, and let loose some arrows in the most realistic Archery simulation video game you have ever experienced.\n\nMaster the art of Barebow Archery, no sights, no stabilizer, no clicker, and no markings on the bow to help you aim.\n\nOculus Leaderboards support, Aim for the high score on global leaderboards and against your friends. And face off in Battle Arenas against other Archers in intense player vs. player action.\n\nFull room-scale recommended.\n", "short_description": "Backyard Archery's updated to utilize Unreal Engine 5 and optimized for 90fps gaming and Mixed Reality. Backyard Archery aims to bring home the genuine Archery experience of Barebow Archery. Visit the Archery Range, various Battle Arenas, Hunting with Friends, and More. Experience realistically simulated bow and arrow physics and impact sounds from the Archery Range. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.backyardarcherygame.com/Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "MISSING GAME STUDIO, ltd.", "support_website_url": null, "website_url": "https://www.backyardarcherygame.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "3744040075834813"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SHOOTER", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
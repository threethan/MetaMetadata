04284521", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974472_1627645407617854_8388378307105579668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMYGScVBZscQ7kNvwGMIrdo&_nc_oc=AdpBYeDdGASC03WLKRLdwzSxzLySTfuq6G8SQgUhqIeAS6EoU9CPZcPzEXf4KwKe8TI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hBfJNfj1DYZgLiKBzhtLbSDtQpl7ygh6ilDIzmfLtfg&oe=6A2D70DB"}, {"file_name": "HighresScreenshot00000.png", "id": "1396433787487957", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003276_1396433790821290_425870319526233919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biBHQdOJQIMQ7kNvwG3nglt&_nc_oc=AdozSfoY3x9ITZ36XX2CTmsS-E80E4AffadLiwKmYaUv76BZnb8X27f-E88_22zs06w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TZrTY4kuuKUKVpHoNdZC8lQFDZOJ5WbY_E5mCOJ3gKA&oe=6A2D6781"}, {"file_name": "HighresScreenshot00002.png", "id": "3205530833022120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982584_3205530836355453_6629944535013068616_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RF-oZIY5Yf0Q7kNvwGCtNuc&_nc_oc=AdqSlyyXAMC6zJ9e6PpyIDaJwlT9BhfwN_NDs6qjYgk_CK5TrJ4_NPloIBiV9tyQOVY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Oh6Aau_PDgQRzWstZSvzQ9DEPvMp62CGpzLwoc8lz6w&oe=6A2D5477"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "maxresdefault.png", "id": "718315142701423", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974837_718315146034756_249526440641492702_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbvGisyHp8MQ7kNvwFWr8h3&_nc_oc=AdoNJNvnMAV80tr4zFVjUH8O2igP3VaHSu8KLlx4FRPuo3SShZKnmjF9jiu1_yac7nM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rYNZlMAQ77T8lYvXeQQUeofALYvwsiEIRq6-h5cSqcA&oe=6A2D4DEE"}, "display_name": "Backyard Archery VR", "keywords": [], "long_description": "Now Featuring Mixed Reality, Scan your room and play in it. Setup targets in your living room or bedroom or preferred play space.  \n\nMaster the technique of String-Walking. Draw to your anchor point, aim off the arrow tip, and let loose some arrows in the most realistic Archery simulation video game you have ever experienced.\n\nMaster the art of Barebow Archery, no sights, no stabilizer, no clicker, and no markings on the bow to help you aim.\n\nOculus Leaderboards support, Aim for the high score on global leaderboards and against your friends. And face off in Battle Arenas against other Archers in intense player vs. player action.\n\nFull room-scale recommended.\n", "short_description": "Backyard Archery's updated to utilize Unreal Engine 5 and optimized for 90fps gaming and Mixed Reality. Backyard Archery aims to bring home the genuine Archery experience of Barebow Archery. Visit the Archery Range, various Battle Arenas, Hunting with Friends, and More. Experience realistically simulated bow and arrow physics and impact sounds from the Archery Range. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.backyardarcherygame.com/Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "MISSING GAME STUDIO, ltd.", "support_website_url": null, "website_url": "https://www.backyardarcherygame.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "3744040075834813"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SHOOTER", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "851272365542
MpctOaoJenVV0f2zusZYkgz7XhnncekuSmnyUTi_FhCK5vs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSK-cKOaeiiTT3ObTg_OLv-jThTnrDjtY3rwUv-JJOXg&oe=6B01CAEE"}, {"file_name": "HighresScreenshot00003.png", "id": "1627645404284521", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_1627645407617854_8388378307105579668_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oV8HCZA-5c4Q7kNvwH8x7Ph&_nc_oc=AdqJr2mZxzAULghM6-QAukNls8tx5sqwT-wQbz-OtE0URoSXXP1hnvomN7kmCrjg6uo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEJ-BE9PTgtkOm5CoA1bTrPYiEcKQV7M9lNOquuDzD8Q&oe=6B01EA9B"}, {"file_name": "HighresScreenshot00000.png", "id": "1396433787487957", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003276_1396433790821290_425870319526233919_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDEGqgo7zfkQ7kNvwHmPPsK&_nc_oc=AdoD6ZIaAvZ15SzpbDAgXiIVSpYQlU_SA8I4anNITi_fFCtNw5f4T3CX-tfXiSTJsFY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnddmQksA16xxvHKjlO8jUSsAGaBsDpEtzQmctfMSsLw&oe=6B01E141"}, {"file_name": "HighresScreenshot00002.png", "id": "3205530833022120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982584_3205530836355453_6629944535013068616_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrF17aCRBhwQ7kNvwE2Pwou&_nc_oc=AdpAEQwiXHcV5VowNgMRcOElNVrPYLFWz5UTjXSnkxpkKW3sePeTVT2JkQewhOsduSo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSezjAsFWecAHon4jphgZGnlX7ZHJidb29oteH3jbDswQ&oe=6B01CE37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "maxresdefault.png", "id": "718315142701423", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974837_718315146034756_249526440641492702_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whCFvfs-jaoQ7kNvwHNIJZx&_nc_oc=AdoQXFSkblOpxvxgP9QMTz32SotskYCb4UK8wWP6OkrM095zJobO4cM_NVWo6T9kdsQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoWjHl3NnpN74Jme6NjSppYUX5fs8LUg99J--6Sn_ARw&oe=6B01C7AE"}, "display_name": "Backyard Archery VR", "keywords": [], "long_description": "Now Featuring Mixed Reality, Scan your room and play in it. Setup targets in your living room or bedroom or preferred play space.  \n\nMaster the technique of String-Walking. Draw to your anchor point, aim off the arrow tip, and let loose some arrows in the most realistic Archery simulation video game you have ever experienced.\n\nMaster the art of Barebow Archery, no sights, no stabilizer, no clicker, and no markings on the bow to help you aim.\n\nOculus Leaderboards support, Aim for the high score on global leaderboards and against your friends. And face off in Battle Arenas against other Archers in intense player vs. player action.\n\nFull room-scale recommended.\n", "short_description": "Backyard Archery's updated to utilize Unreal Engine 5 and optimized for 90fps gaming and Mixed Reality. Backyard Archery aims to bring home the genuine Archery experience of Barebow Archery. Visit the Archery Range, various Battle Arenas, Hunting with Friends, and More. Experience realistically simulated bow and arrow physics and impact sounds from the Archery Range. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.backyardarcherygame.com/Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "MISSING GAME STUDIO, ltd.", "support_website_url": null, "website_url": "https://www.backyardarcherygame.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "3744040075834813"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SHOOTER", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
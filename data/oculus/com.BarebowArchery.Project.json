Y36vYa7ndt3g05Dz82UlQ71idaZ3kY4jpqNJ2eqkzH_DgLg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQMJYtwxIaM98zmr_ORAIiPHU6RYeVUQnYS5cujvDmCbQ&oe=6B0DA86E"}, {"file_name": "HighresScreenshot00003.png", "id": "1627645404284521", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974472_1627645407617854_8388378307105579668_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBdaYGJ3DpwQ7kNvwEHE3OV&_nc_oc=AdpeHdZ4_SjhYkNq9F28fTZyDQwL6-jbHz3o8Eb-nxdFVxHlCvYeeRozDM8hB-cGPbk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTXegLMV03qGoQ7FGd-W06_08JDGW4C7S3NTVhgAEbU2w&oe=6B0DC81B"}, {"file_name": "HighresScreenshot00000.png", "id": "1396433787487957", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003276_1396433790821290_425870319526233919_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CBm2bfq-7MQ7kNvwHHLNH5&_nc_oc=AdrStvofwl44ABVbOOOvcrePKWBYK_itPZaufYF_lY5pYXaM20sSXoMVdW1RKY75FXg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRnhZbgqAVT1iCt1VCaCAVEkwjnUskbgKj2wB-c3fY-yA&oe=6B0DBEC1"}, {"file_name": "HighresScreenshot00002.png", "id": "3205530833022120", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982584_3205530836355453_6629944535013068616_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cH9f8VxGX4Q7kNvwF65QRW&_nc_oc=Adodrjuolg_pkWu115C-cqsNSFwVZ7z_i9jEorrqPUAHBKV0MJQ7UMvVXK5oJHw91Bk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRGjRUrhmXOxKXHHwfqpCFHvsCz5RBfX6KENtcQoAvzfg&oe=6B0DABB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "maxresdefault.png", "id": "718315142701423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974837_718315146034756_249526440641492702_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RL9i5WKLzAwQ7kNvwF9s1XQ&_nc_oc=AdpKYfBV7h2Im9URSfZzHT0KqqlZ8Z53jHk-4GioWisfUruua0J0ZTtKrsYkFHR4b9I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRDItnA9C51D5ayNfzwBKuXQXKYhEwcEv-6uhm1JWkwGg&oe=6B0DA52E"}, "display_name": "Backyard Archery VR", "keywords": [], "long_description": "Now Featuring Mixed Reality, Scan your room and play in it. Setup targets in your living room or bedroom or preferred play space.  \n\nMaster the technique of String-Walking. Draw to your anchor point, aim off the arrow tip, and let loose some arrows in the most realistic Archery simulation video game you have ever experienced.\n\nMaster the art of Barebow Archery, no sights, no stabilizer, no clicker, and no markings on the bow to help you aim.\n\nOculus Leaderboards support, Aim for the high score on global leaderboards and against your friends. And face off in Battle Arenas against other Archers in intense player vs. player action.\n\nFull room-scale recommended.\n", "short_description": "Backyard Archery's updated to utilize Unreal Engine 5 and optimized for 90fps gaming and Mixed Reality. Backyard Archery aims to bring home the genuine Archery experience of Barebow Archery. Visit the Archery Range, various Battle Arenas, Hunting with Friends, and More. Experience realistically simulated bow and arrow physics and impact sounds from the Archery Range. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.backyardarcherygame.com/Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "MISSING GAME STUDIO, ltd.", "support_website_url": null, "website_url": "https://www.backyardarcherygame.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "3744040075834813"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SHOOTER", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
04284521", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974472_1627645407617854_8388378307105579668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sgyhJe_U04Q7kNvwFhepqj&_nc_oc=Adr0bzpeOpz06KmUQrgNQhsK5o6v1XgeEzWy5mc3x7veU77QhTuz53AAbi-fgLFlP_c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDp5MEaL08HwshGFlNZAn7qF13-GLVRXkzBh3gCTwdFw&oe=6A89819B"}, {"file_name": "HighresScreenshot00000.png", "id": "1396433787487957", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003276_1396433790821290_425870319526233919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seSckmjNtO0Q7kNvwE1V8MW&_nc_oc=AdoP-R70xp0P17VMgdyXchUC_WRgfgvgDqTVDqle6-oFu0gPFLI93lwjrwinOvtsPxM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1BLgWr7oklEolBZClKnIKau-zBAocGmssrsjgrj2QoA&oe=6A897841"}, {"file_name": "HighresScreenshot00002.png", "id": "3205530833022120", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982584_3205530836355453_6629944535013068616_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyboZuQtLOcQ7kNvwGN1PFH&_nc_oc=AdqxQltWgyLWPO90kB30WL7bCYX4j6EK88TaHkaPhilD2pWQLNsmVZuYpwVFMLHR-Tw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETvex7R6kA1uAElRBnse80mWTojbi1nnsN2HMx3XB9dQ&oe=6A899D77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "maxresdefault.png", "id": "718315142701423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974837_718315146034756_249526440641492702_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SA7oZN7sDBEQ7kNvwG9KDZD&_nc_oc=Adqx4UOjOxFGK_vc97tEUziajIULYV_9clBl7pUidq5rBtANcmoeT7lN-vUEm3KAYX0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZWLhyQi3O_uxmxk7jh6wtan9Q50uUvfQUe_Qr-I-14Q&oe=6A8996EE"}, "display_name": "Backyard Archery VR", "keywords": [], "long_description": "Now Featuring Mixed Reality, Scan your room and play in it. Setup targets in your living room or bedroom or preferred play space.  \n\nMaster the technique of String-Walking. Draw to your anchor point, aim off the arrow tip, and let loose some arrows in the most realistic Archery simulation video game you have ever experienced.\n\nMaster the art of Barebow Archery, no sights, no stabilizer, no clicker, and no markings on the bow to help you aim.\n\nOculus Leaderboards support, Aim for the high score on global leaderboards and against your friends. And face off in Battle Arenas against other Archers in intense player vs. player action.\n\nFull room-scale recommended.\n", "short_description": "Backyard Archery's updated to utilize Unreal Engine 5 and optimized for 90fps gaming and Mixed Reality. Backyard Archery aims to bring home the genuine Archery experience of Barebow Archery. Visit the Archery Range, various Battle Arenas, Hunting with Friends, and More. Experience realistically simulated bow and arrow physics and impact sounds from the Archery Range. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.backyardarcherygame.com/Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "MISSING GAME STUDIO, ltd.", "support_website_url": null, "website_url": "https://www.backyardarcherygame.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "3744040075834813"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SHOOTER", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "851272365542
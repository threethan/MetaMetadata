cdn.com&_nc_ss=8&oh=00_AfzlgLMwgJKVJAvDq5Sd0b2h1FQdCKp1KXq52CE9TkZRMw&oe=69B1642E"}, {"file_name": "38974530_368015358000109_5953050749149236664_n.png", "id": "295435822637661", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984460_295435825970994_8147832672161080215_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTFQEpPx-xkQ7kNvwF4MFOU&_nc_oc=Adnee2_V55M41bSnPBHbQ1Y3CYK3VEMzIvYCVJClk20nQn2oCY8QyB-PIveB4GmuYDM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8yF0W2KWmKAkGRhGNV2DrQX_Hifgwc7Ayj9B31y93wQ&oe=69B162CD"}, {"file_name": "38974628_994656027967568_909255715926215613_n.png", "id": "655358132565606", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031515_655358135898939_4595290142564664609_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjqFK4zMePsQ7kNvwFtVPev&_nc_oc=Adn4RTi7YBCXS1fZWNhYPAIcjVcrK3uTnbJGI6qqFF5OUTSrIxleiwjO_zR4Ovuao1M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-qi7h28lvjbuzxAZcjFhfCCe4xJUeIPCch26CCUELnA&oe=69B16A96"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Backyard Archery VR", "keywords": [], "long_description": "Backyard Archery's built from the ground up for the Oculus Quest family of headsets. Built using the Unreal Engine and optimized for 90fps gaming.\n\nMaster the technique of String-Walking. Draw to your anchor point, aim off the arrow tip, and let loose some arrows in the most realistic Archery simulation video game you have ever experienced.\n\nMaster the art of Barebow Archery, no sights, no stabilizer, no clicker, and no markings on the bow to help you aim.\n\nOculus Leaderboards support, Aim for the high score on global leaderboards and against your friends. And face off in Battle Arenas against other Archers in intense player vs. player action.\n\nFull room-scale recommended.\n", "short_description": "Backyard Archery aims to bring home the genuine Archery experience of Barebow Archery. Visit the Archery Range, various Battle Arenas, Hunting with Friends, and More. Experience realistically simulated bow and arrow physics and impact sound fx from the Archery Range. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.backyardarcherygame.com/Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "MISSING GAME STUDIO, ltd.", "support_website_url": null, "website_url": "https://www.backyardarcherygame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "3744040075834813"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SHOOTER", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1876375705905278"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "971016943573868"}]}, "baseline_offer": {"id": "971016943573868"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1653019140, "status": "PUBLISHED", "id": "971016943573868"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8454776351218162", "version": "1.0"}, "id": "4790236134391675", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5276470422382120", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary",
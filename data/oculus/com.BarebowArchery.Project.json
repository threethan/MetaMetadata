W3Kx2u4Fo7s5dy2v2TvxQcJKfAmnBWijKwENvPNv0oMZ15U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeHQnze2xd3gvdQFKkq6ZfUMVd4J07V7gTSehuP2QCmg&oe=6B09B3EE"}, {"file_name": "HighresScreenshot00003.png", "id": "1627645404284521", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974472_1627645407617854_8388378307105579668_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDChLE-tCz8Q7kNvwEFPxzw&_nc_oc=AdpIMQyNIEZVzI5uFRE2gAdkfiti-zdsy1PF1GTnxtxiFcvsGJFaZ9Xch_zGO_CBnxg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9ALd9ji-EnQtDkYWrPXKIa-fGa6yvgojX9rrux5MLig&oe=6B099B5B"}, {"file_name": "HighresScreenshot00000.png", "id": "1396433787487957", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003276_1396433790821290_425870319526233919_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGfGYfYgEVoQ7kNvwHO0Lyf&_nc_oc=AdpZI55mHgM8Foti2_Azt9j6E3fpWBXxIh7Z_QravGAh-5NnXfOIQD7aLAXfX2zs8rk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdzydbnRB_IQ7scF9BRyTjTCmLhNTWZc8GGBr5Rvy0bw&oe=6B09CA41"}, {"file_name": "HighresScreenshot00002.png", "id": "3205530833022120", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982584_3205530836355453_6629944535013068616_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSXs3yxSphYQ7kNvwHOy5wQ&_nc_oc=AdoYA53cyWun8mJ1kQLb2-6rcaDUGLQMh5K_ehE2_AMEJr4Vu9KYaiN4KYxJUOqgrlE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8wnuF5Rb-ainN5iPDVNLaKOm_iVygBQLyZ3NfrUA32A&oe=6B09B737"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "maxresdefault.png", "id": "718315142701423", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974837_718315146034756_249526440641492702_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byrpCSTkFaYQ7kNvwGK8Q8E&_nc_oc=AdrnOOo-2h0Rd3-lUxvXBh1rKourKMhtgKKKSc3iRJLYL_gPwhq4ImBZczwleE-F9uY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsEfC66cvVSpZtQxtWlMLcwuMchXeBCKgBemWOt_EpiQ&oe=6B09B0AE"}, "display_name": "Backyard Archery VR", "keywords": [], "long_description": "Now Featuring Mixed Reality, Scan your room and play in it. Setup targets in your living room or bedroom or preferred play space.  \n\nMaster the technique of String-Walking. Draw to your anchor point, aim off the arrow tip, and let loose some arrows in the most realistic Archery simulation video game you have ever experienced.\n\nMaster the art of Barebow Archery, no sights, no stabilizer, no clicker, and no markings on the bow to help you aim.\n\nOculus Leaderboards support, Aim for the high score on global leaderboards and against your friends. And face off in Battle Arenas against other Archers in intense player vs. player action.\n\nFull room-scale recommended.\n", "short_description": "Backyard Archery's updated to utilize Unreal Engine 5 and optimized for 90fps gaming and Mixed Reality. Backyard Archery aims to bring home the genuine Archery experience of Barebow Archery. Visit the Archery Range, various Battle Arenas, Hunting with Friends, and More. Experience realistically simulated bow and arrow physics and impact sounds from the Archery Range. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.backyardarcherygame.com/Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "MISSING GAME STUDIO, ltd.", "support_website_url": null, "website_url": "https://www.backyardarcherygame.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "3744040075834813"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SHOOTER", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
AT4EmRizzfkzF5ZjJT2jSAkza2RhJmrD9XiY3yfwt2luh1o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGy07lQPrcfVM6mNjsBxDBlAJRxEP5PIfyc_oz3jDezA&oe=6B05BF6E"}, {"file_name": "HighresScreenshot00003.png", "id": "1627645404284521", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_1627645407617854_8388378307105579668_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_gDIFK2WyMQ7kNvwHFQ6GJ&_nc_oc=Adq0Eg4VsbqehBiwBaLxtfPO1Op762LVdkX1C5fv6yBA12rKulRxnJ45YoZGkNmDgYE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSISg4_-Knva4EpAWXF9wZ51zjbjU75TzSezo5G0BXQGA&oe=6B05A6DB"}, {"file_name": "HighresScreenshot00000.png", "id": "1396433787487957", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003276_1396433790821290_425870319526233919_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPSpWqoGBXkQ7kNvwFp9I7t&_nc_oc=Adq9oLU9zBwVGJ53mNFX1GLZIRNkk_9KJ8U3mIWicRoH6xh74zgh5u-ki2A2wzh3qXI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTEcOvF83QbtvUObZhqhasHKs3owgAXHX9usr39GCEpQ&oe=6B05D5C1"}, {"file_name": "HighresScreenshot00002.png", "id": "3205530833022120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982584_3205530836355453_6629944535013068616_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MrpfIVwJRsQ7kNvwEe0K3_&_nc_oc=AdrkGOWY_jvya2S1jIwn0-xVaxZ653iYuCUhSOcIlqDu5RLNEgHh9XjQQqDSlJ154ac&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThLSDXdMOol7vjcMtgxrH11VYEy8ggczodDfLxAY44Gw&oe=6B05C2B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "maxresdefault.png", "id": "718315142701423", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974837_718315146034756_249526440641492702_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKgyTOa6cNkQ7kNvwFhmfJ0&_nc_oc=AdpWlRNHsIipbaSiGOVkhv-aQ1_n6q7ReZB880qCFxQdhcfPjM0nLrTaF3nrcu4Kl5E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyTqVqabB6PEpSI6DaDSBMyyZyVpeqpFfUE5FhIMNPyQ&oe=6B05BC2E"}, "display_name": "Backyard Archery VR", "keywords": [], "long_description": "Now Featuring Mixed Reality, Scan your room and play in it. Setup targets in your living room or bedroom or preferred play space.  \n\nMaster the technique of String-Walking. Draw to your anchor point, aim off the arrow tip, and let loose some arrows in the most realistic Archery simulation video game you have ever experienced.\n\nMaster the art of Barebow Archery, no sights, no stabilizer, no clicker, and no markings on the bow to help you aim.\n\nOculus Leaderboards support, Aim for the high score on global leaderboards and against your friends. And face off in Battle Arenas against other Archers in intense player vs. player action.\n\nFull room-scale recommended.\n", "short_description": "Backyard Archery's updated to utilize Unreal Engine 5 and optimized for 90fps gaming and Mixed Reality. Backyard Archery aims to bring home the genuine Archery experience of Barebow Archery. Visit the Archery Range, various Battle Arenas, Hunting with Friends, and More. Experience realistically simulated bow and arrow physics and impact sounds from the Archery Range. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.backyardarcherygame.com/Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "MISSING GAME STUDIO, ltd.", "support_website_url": null, "website_url": "https://www.backyardarcherygame.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "3744040075834813"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SHOOTER", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
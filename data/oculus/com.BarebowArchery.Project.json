n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSxOSzWfRnQQ7kNvwFLlFEG&_nc_oc=AdmCOoaxWHrcBocaS3LTdz5l05bkx2eFxKHCrqOoyyzkI-0C1l0_RLogM3xjeMPgC5U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvgLaCOmR5l39Ln_qaVxV5yKfLz0vd9WUUzK5Zsnf2C5w&oe=69A6BF9B"}, {"file_name": "HighresScreenshot00000.png", "id": "1396433787487957", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003276_1396433790821290_425870319526233919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvNcmX-UngMQ7kNvwHX8_C6&_nc_oc=AdkTiAd1Pjk7DFvglrHlneSBbQobMg1p4fdRnQ2Zvy9bp6kjCK3QCeLT0HxljogyK-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftoZDlp7gaNZepPpOWhTo9tTc_cGvfevLB2PmzZI_Ceuw&oe=69A6EE81"}, {"file_name": "HighresScreenshot00002.png", "id": "3205530833022120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982584_3205530836355453_6629944535013068616_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHjlU84Jdr0Q7kNvwGUqVTs&_nc_oc=AdkQo0n1fQ4-FjCMMYLhxvLIfYZf738c7qeyUQ4XmxofSLuX0dwzrySrOUkJGPUbsSM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvtw7vs9uAN8LQuwbUWYato5ZuCCmcvY7ErlwxzjRwg4A&oe=69A6DB77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "maxresdefault.png", "id": "718315142701423", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974837_718315146034756_249526440641492702_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Lk9aq05KjIQ7kNvwFX00Cp&_nc_oc=AdlQnDGertwb5b7rRpebKFuH7anB6yXw3BpFfe598CMDfEU1w8UzLlINxKknCUt1ZPY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsRKVSNnpxNbtwu7H8u8V05qxLUz3HzzQ3ZS97NL2c9wQ&oe=69A6D4EE"}, "display_name": "Backyard Archery VR", "keywords": [], "long_description": "Now Featuring Mixed Reality, Scan your room and play in it. Setup targets in your living room or bedroom or preferred play space.  \n\nMaster the technique of String-Walking. Draw to your anchor point, aim off the arrow tip, and let loose some arrows in the most realistic Archery simulation video game you have ever experienced.\n\nMaster the art of Barebow Archery, no sights, no stabilizer, no clicker, and no markings on the bow to help you aim.\n\nOculus Leaderboards support, Aim for the high score on global leaderboards and against your friends. And face off in Battle Arenas against other Archers in intense player vs. player action.\n\nFull room-scale recommended.\n", "short_description": "Backyard Archery's updated to utilize Unreal Engine 5 and optimized for 90fps gaming and Mixed Reality. Backyard Archery aims to bring home the genuine Archery experience of Barebow Archery. Visit the Archery Range, various Battle Arenas, Hunting with Friends, and More. Experience realistically simulated bow and arrow physics and impact sounds from the Archery Range. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.backyardarcherygame.com/Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "MISSING GAME STUDIO, ltd.", "support_website_url": null, "website_url": "https://www.backyardarcherygame.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "3744040075834813"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SHOOTER", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "8512723655423431"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031501_510147210321740_7725089502350248157_n.png?s
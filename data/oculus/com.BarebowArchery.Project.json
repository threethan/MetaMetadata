04284521", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974472_1627645407617854_8388378307105579668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fZRwLCNbKQQ7kNvwGBCl1h&_nc_oc=Adrsg_mlnh4GMYG6Kd8GehPTekrn063-oV8iy9GhnZP2Y9wFqG_cmIIsk5F5XBOUd6o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNs7R2S5VCB1XU4DVmn24gL4UUHPm6h4NC-HcUJR1IeqA&oe=6AE35FDB"}, {"file_name": "HighresScreenshot00000.png", "id": "1396433787487957", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003276_1396433790821290_425870319526233919_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHfJCcVZdEwQ7kNvwE1SdvF&_nc_oc=Adq-rWfUGELZ7XV5QkZ-rRvwFY-O3C1rgIrzzVNLlhaoCJyXQi9tdwL5oNwGR8CBMm4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6ZUoOFBmLfpCe9UVb8asnljS8iC5sQyccP0PcQyIq7A&oe=6AE35681"}, {"file_name": "HighresScreenshot00002.png", "id": "3205530833022120", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982584_3205530836355453_6629944535013068616_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpAVSQSDz3wQ7kNvwG1FptB&_nc_oc=AdrDVRhtoAEdX9GxPj6n73y7-_FAOrLCpa22m4MGVL9YljvvmeGJPVZV8aYaPzMJ020&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgvul2w0Cf9s6l1BzimHncDSBWS73J06x--FGxCNGenA&oe=6AE34377"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "maxresdefault.png", "id": "718315142701423", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974837_718315146034756_249526440641492702_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O51GHkFFZi4Q7kNvwH6mWck&_nc_oc=Adoi7HWH-QOJA84j_C1osDNiyvg55R-ZM1SL_lbaHDHG4_iSZd5T1p_OTsddFGTcvUs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJtPljWMNv3fORx5S0HW7cfRgyxBMSbnQ5LmHZrr83tQ&oe=6AE33CEE"}, "display_name": "Backyard Archery VR", "keywords": [], "long_description": "Now Featuring Mixed Reality, Scan your room and play in it. Setup targets in your living room or bedroom or preferred play space.  \n\nMaster the technique of String-Walking. Draw to your anchor point, aim off the arrow tip, and let loose some arrows in the most realistic Archery simulation video game you have ever experienced.\n\nMaster the art of Barebow Archery, no sights, no stabilizer, no clicker, and no markings on the bow to help you aim.\n\nOculus Leaderboards support, Aim for the high score on global leaderboards and against your friends. And face off in Battle Arenas against other Archers in intense player vs. player action.\n\nFull room-scale recommended.\n", "short_description": "Backyard Archery's updated to utilize Unreal Engine 5 and optimized for 90fps gaming and Mixed Reality. Backyard Archery aims to bring home the genuine Archery experience of Barebow Archery. Visit the Archery Range, various Battle Arenas, Hunting with Friends, and More. Experience realistically simulated bow and arrow physics and impact sounds from the Archery Range. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.backyardarcherygame.com/Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "MISSING GAME STUDIO, ltd.", "support_website_url": null, "website_url": "https://www.backyardarcherygame.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "3744040075834813"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SHOOTER", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "851272365542
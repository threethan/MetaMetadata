2UK2&_nc_oc=AdpHa3kU357nUNvg30K1EDnB2cvS3z2wDu4mVYEfOgyXiBEuU5Qzea-frVokdyWdX1E&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwNlHGm2Jllvaa9PmEqNp_8L7pWSU-6SdxcdPFBSNHrQ&oe=6A85A5AE"}, {"file_name": "38974530_368015358000109_5953050749149236664_n.png", "id": "295435822637661", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38984460_295435825970994_8147832672161080215_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Ir8htNuXpIQ7kNvwHMz9Fl&_nc_oc=Adr8QHqjZlxnfZXtdG2Y71uYA7Tfd8a4TfT8TseRyICi05CRG0KSZU6D7XBHoaqiWQo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoNqDX0T5tjFLch7LQWV97ukcyi_5kN1bx9HmCLlL_4w&oe=6A85A44D"}, {"file_name": "38974628_994656027967568_909255715926215613_n.png", "id": "655358132565606", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031515_655358135898939_4595290142564664609_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-Nx4mlf4EIQ7kNvwES53Vk&_nc_oc=AdpwwTw6FgrbNbyWuA6VOcOs5U4VK4wozCWMEYr-EKWnliPHzuYwQzDRF1cZcEFYvj4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzjhIhgcDUbzhoNOq6i_74bskAUy-hwQthu9MZWft_Lg&oe=6A85AC16"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Backyard Archery VR", "keywords": [], "long_description": "Backyard Archery's built from the ground up for the Oculus Quest family of headsets. Built using the Unreal Engine and optimized for 90fps gaming.\n\nMaster the technique of String-Walking. Draw to your anchor point, aim off the arrow tip, and let loose some arrows in the most realistic Archery simulation video game you have ever experienced.\n\nMaster the art of Barebow Archery, no sights, no stabilizer, no clicker, and no markings on the bow to help you aim.\n\nOculus Leaderboards support, Aim for the high score on global leaderboards and against your friends. And face off in Battle Arenas against other Archers in intense player vs. player action.\n\nFull room-scale recommended.\n", "short_description": "Backyard Archery aims to bring home the genuine Archery experience of Barebow Archery. Visit the Archery Range, various Battle Arenas, Hunting with Friends, and More. Experience realistically simulated bow and arrow physics and impact sound fx from the Archery Range. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.backyardarcherygame.com/Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "MISSING GAME STUDIO, ltd.", "support_website_url": null, "website_url": "https://www.backyardarcherygame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "3744040075834813"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SHOOTER", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1876375705905278"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "971016943573868"}]}, "baseline_offer": {"id": "971016943573868"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1653019140, "status": "PUBLISHED", "id": "971016943573868"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8454776351218162", "version": "1.0"}, "id": "4790236134391675", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": 
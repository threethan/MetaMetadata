xsfxEDildBqCOLP8VaO6svx8BFBSw27Eh_oYVPl7dhvk0c2N-DM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgoH3KqYLQOcWMyggY6HnOHMXAMUZHlRd2cBbogiqMlg&oe=6AAFE4EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_3_1440p.png", "id": "3481180315361545", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86621367_3481180318694878_1648315878700712828_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oP7ZmwnpQOcQ7kNvwGKvlmM&_nc_oc=Ado__ZUkG_M8h85CAJzwhmA2EGyblHQm3a8qZ3g4UExVcykZamRrr0b9dNj4OQdPXUQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgUgwOcPO6mXTBVLrEzUHeCIEoAeR_BCdQ1SR34dCiFA&oe=6AB001C4"}, "display_name": "Stencil VR", "keywords": [], "long_description": "Unleash your creativity with Stencil VR, transform any image into a stencil you can trace onto real-world surfaces! Stencil VR makes it easy and fun to bring your artistic vision to life with no previous artistic skills required!\n\n# Key Features:\n- **Personalized Stencils:** Upload any image you'd like to stencilvr.com and then select it in the app to convert it into a stencil that you can project onto walls, canvases, or any surface.\n- **Adjustable Transparency:** Fine-tune the opacity of your stencil to suit your needs, ensuring you can see both the stencil and your drawing surface clearly.\n- **Precise Alignment:** Position your stencil by grabbing it and placing it where you like, then finely adjust the position, scale, and rotation using the control panel, so it fits perfectly on your desired surface.\n\n# How It Works:\n- **Upload Your Image:** Go to stencilvr.com, create a simple account, and upload any image you'd like to use as a stencil.\n- **Load Your Image:** Use the in app menu to sign in and easily select your loaded stencil or other publicly shared stencils.\n- **Place Your Stencil:** Use a controller and the in game control panel to place your stencil onto your desired surface.\n- **Trace and Create:** Follow the stencil to trace the image accurately onto the surface.\n\n# Download Stencil VR today and start bringing your digital designs into the real world with ease!", "short_description": "Unleash your creativity with Stencil VR, transform any image into a stencil you can trace onto real-world surfaces! Stencil VR makes it easy and fun to bring your artistic vision to life with no previous artistic skills required!"}]}, "developer_name": "Stencil VR", "developer_privacy_policy_url": "https://www.stencilvr.com/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Stencil VR", "support_website_url": null, "website_url": "https://www.stencilvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7776932605744549"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1495482722338292"}, {"status": "PUBLISHED", "id": "2992036421127730"}, {"status": "PUBLISHED", "id": "1581989523564632"}, {"status": "PUBLISHED", "id": "1652016459174167"}, {"status": "PUBLISHED", "id": "945461531405630"}, {"status": "PUBLISHED", "id": "935949562345865"}, {"status": "PUBLISHED", "id": "830912159766263"}, {"status": "PUBLISHED", "id": "1087084466685591"}, {"status": "PUBLISHED", "id": "1312863666607872"}, {"status": "PUBLISHED", "id": "432018899950327"}, {"status": "PUBLISHED", "id": "832392985747643"}, {"status": "PUBLISHED", "id": "1007726687556519"}]}, "baseline_o
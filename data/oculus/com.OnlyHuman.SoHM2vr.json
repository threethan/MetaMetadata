f&oh=00_Af8xUoo2cSVQYcVfVPTmdqK6l2JWSZNdx5qk7mDHOLkyKA&oe=6A46859B"}, {"file_name": "Screenshot7.png", "id": "111247911052042", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974493_111247914385375_3275648255043241126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gYZRLkgmOkQ7kNvwEU_bLV&_nc_oc=AdogY0IhfDEUbEI6KWsZ34b-471J1PJpahMzAMl2TJine4CL-KgdhkV6gSUF4vdZNrg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TigRO0YBNNbFFwJ4z_0TCPvbhdm7hvCJdjLEVfVX0Vg&oe=6A465A98"}, {"file_name": "Screenshot9.png", "id": "1058443408015562", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974753_1058443411348895_1631510142665547702_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nX_qpyO041EQ7kNvwHfhwAt&_nc_oc=AdqxhjysfChjZ8bfX7VHWfoohao4AprdUuFwHjwx_h5v8zuublXy2sdHc3_5ftYYYfQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_czkaJ-MBNtqirV7i-2wnWDOSZch3UoX1jwV9zdBwstw&oe=6A465CC6"}, {"file_name": "Screenshot10.png", "id": "1206986639750759", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974767_1206986643084092_8108874457345208060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brveoBIQY4AQ7kNvwGP3opC&_nc_oc=AdrfOO_g4S7daluDmf0aGe_ffyNQAHcXbdS_vfG9IOZTlr8T6WDf6_icnqZTAfhYkpI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-W8Df_1emCAIYiYzDBLeLc8AH7ghl1FMedLAelbNTkjg&oe=6A466D09"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret of Harrow Manor 2", "keywords": [], "long_description": "You have just escaped the horrifying laboratory where the experiments began, now your only way out lies through the town of Harrow Manor. \nThis time around, the monsters are more deadly, but luckily the townspeople had been fearing such an event might happen and have left many more weapons behind to fight them.\n\nFeatures:\n-Explore an entire undead infested town, complete with a church, hospital, and prison!\n-Play alone or co-op with a friend!\n-7 new weapons t
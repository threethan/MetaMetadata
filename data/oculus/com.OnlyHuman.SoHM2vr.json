_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCfBIr-qz44Q7kNvwF-mt6p&_nc_oc=AdpkTpD-M3m3XTZWoDs3gXkmNcWp1AO8nlnHM7sswtA3TTHsCDbyc7jpnW0yICuk8cQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROGWPlsFNqCGqSnymEjuHhVC9WvaZtwI8m8vQLpYdC5A&oe=6B045D9B"}, {"file_name": "Screenshot7.png", "id": "111247911052042", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_111247914385375_3275648255043241126_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhqbW-Wc8a0Q7kNvwG1YDIl&_nc_oc=AdpgxfbAVDdMgmzydMmqEgvTaxeS9f9uK1JWWT_87VGtoFlMm7zdVQB_nZ3E7Ky8pIo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRa6Hj-DjrNS1KxTC3XkOxHqJ4c6GlrosfrbLJ64-pLIg&oe=6B046AD8"}, {"file_name": "Screenshot9.png", "id": "1058443408015562", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974753_1058443411348895_1631510142665547702_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mEfddC6jocQ7kNvwHgsFYk&_nc_oc=AdodGPnldzd3x-s46Nne17IUTrJSUNWqQ2jjQbPlTJv7vadkOMYeReCrmRo7LMKuPKE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK5OYxTSBPIa3iGh-Ix6Xf60aPtSX5Xc-tqZfwpeukeQ&oe=6B046D06"}, {"file_name": "Screenshot10.png", "id": "1206986639750759", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974767_1206986643084092_8108874457345208060_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxyXwhb3SPgQ7kNvwGCEg3w&_nc_oc=AdriKrQyXcoz1sUJ5QmC98Aq2ix06mX-3n9aoEnL1Y1Blvg6nBecLlX2sHfGU6E57g4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2NrZA4YN10TS1SCzWr_HS2S8rOa5XSovgOG5nglfv7A&oe=6B047D49"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret of Harrow Manor 2", "keywords": [], "long_description": "You have just escaped the horrifying laboratory where the experiments began, now your only way out lies through the town of Harrow Manor. \nThis time around, the monsters are more deadly, but luckily the townspeople had been fearing such an event might happen and have left many more weapons behind to fight them.\n\nFeatures:\n-Explore an entire undead infested town, complete with a church, hospital, and prison!\n-Play alone or co-op with a friend!\n-7 new weapons to wield against the new undead, including flamethrowers, grenade launchers, and katanas!", "short_description": "Return to the town of Harrow Manor, this time the monsters are much more deadly. The keys and weapons are well hidden, see if you can make it out alive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.onlyhumanstudios.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Only Human Studios", "support_website_url": "https://www.onlyhumanstudios.net/", "website_url": "https://www.onlyhumanstudios.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "313298567415244"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75367596_154170716619375_76032338918422839_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRjMmL6sgeoQ7kNvwG3sSdB&_nc_oc=AdoHfwls7MWF1E7ZTbvJ4Zk_wyffx3qjPhCT7inq1KOZ_L6X8G0ihbC6DlYMamnr8-c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_A
f&oh=00_AQIUvjJHqDe7caNSlYqqZf3eM9F9tzB2zjZauLg7tGJCUQ&oe=6AA4201B"}, {"file_name": "Screenshot7.png", "id": "111247911052042", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974493_111247914385375_3275648255043241126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qE8QVGbku6oQ7kNvwGTjIy8&_nc_oc=Ado5GZam7HBwpn-EBtHzivMTTirWFm3w6Vd_3OSjYJeulHfUj7De4_US1DIE8Bc4ncE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjGwnPG-a1R7sY64aVRfYTaEq8zfG5O92qkOn3sy4rLg&oe=6AA3F518"}, {"file_name": "Screenshot9.png", "id": "1058443408015562", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974753_1058443411348895_1631510142665547702_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjOLLptXwFAQ7kNvwH_9to1&_nc_oc=AdoBHI_jOonPRQfBHoTzfx8fqysTTGKOKgLfPXrxzgK69mGkmmb_YBvSbiEJJ3JtaxQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_7ach-tT_qdbIeP7Mw55-P8htr6FFRN1MB4gUpptHow&oe=6AA3F746"}, {"file_name": "Screenshot10.png", "id": "1206986639750759", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974767_1206986643084092_8108874457345208060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PD36lx3rchEQ7kNvwGiw9Kt&_nc_oc=Adr8FHLQlCg0tnIF4xKE0hh5K38y2eiJHGtHASDIJFhP3TNXsanHXOV68ttHhhvZaZw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSKU6i7CsWenDAuGsL2i6z_Zz8qZ1JjmgsXC6ISk82uA&oe=6AA40789"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret of Harrow Manor 2", "keywords": [], "long_description": "You have just escaped the horrifying laboratory where the experiments began, now your only way out lies through the town of Harrow Manor. \nThis time around, the monsters are more deadly, but luckily the townspeople had been fearing such an event might happen and have left many more weapons behind to fight them.\n\nFeatures:\n-Explore an entire undead infested town, complete with a church, hospital, and prison!\n-Play alone or co-op with a friend!\n-7 new weapons t
uluscdn.com&_nc_ss=7f20f&oh=00_AQF7biArsPQafliaeivRxCzcN43Z5jvl7-3__b_mVPvvsw&oe=6A8D65C9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret of Harrow Manor 2", "keywords": [], "long_description": "You have just escaped the horrifying laboratory where the experiments began, now your only way out lies through the town of Harrow Manor. \nThis time around, the monsters are more deadly, but luckily the townspeople had been fearing such an event might happen and have left many more weapons behind to fight them.\n\nFeatures:\n-Explore an entire undead infested town, complete with a church, hospital, and prison!\n-Play alone or co-op with a friend!\n-7 new weapons to wield against the new undead, including flamethrowers, grenade launchers, and katanas!", "short_description": "Return to the town of Harrow Manor, this time the monsters are much more deadly. The keys and weapons are well hidden, see if you can make it out alive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.onlyhumanstudios.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Only Human Studios", "support_website_url": "https://www.onlyhumanstudios.net/", "website_url": "https://www.onlyhumanstudios.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "313298567415244"}}]}, "scheduled_offer
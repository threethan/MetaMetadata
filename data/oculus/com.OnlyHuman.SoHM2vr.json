052042", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_111247914385375_3275648255043241126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SQ_j_hNwOEQ7kNvwEuaL1L&_nc_oc=AdlNYk9_QM-odvVf0EAiNgJGJBkbnlGgqYZaS9oRQU8wlmqAW3HUV9-YWLxBhcELA04&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsUfBqef0_HsfxTKRaf0ORaFM33V3Q9aLuQGGoG7C5Cog&oe=69A2E098"}, {"file_name": "Screenshot9.png", "id": "1058443408015562", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974753_1058443411348895_1631510142665547702_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NToACLeXzp8Q7kNvwHz-mGc&_nc_oc=AdmftMXrdeuFfM96O08TLHBuIVEKZH4_ukwc1Xw1qEd9A65uEfipRlP-No2fR306ROQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvVDW7SSLhggaCrlHAPvE5DUwYOevtWkCQzjYZzMSajuA&oe=69A2E2C6"}, {"file_name": "Screenshot10.png", "id": "1206986639750759", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974767_1206986643084092_8108874457345208060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XagJ44Zwou8Q7kNvwGwPijj&_nc_oc=Adlso-6zNYD_LySqp3FLpEW4oRSTHSVJJh9MKAi6eE5MXrVUcSP-oC6cOZh2QD99FkM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu9zvdgbNSWBHEaRMKHf9bneThZdJRIfL2VRyxOw21YMA&oe=69A2F309"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret of Harrow Manor 2", "keywords": [], "long_description": "You have just escaped the horrifying laboratory where the experiments began, now your only way out lies through the town of Harrow Manor. \nThis time around, the monsters are more deadly, but luckily the townspeople had been fearing such an event might happen and have left many more weapons behind to fight them.\n\nFeatures:\n-Explore an entire undead infested town, complete with a church, hospital, and prison!\n-Play alone or co-op with a friend!\n-7 new weapons to wield against the new undead, including flamethrowers, grenade launchers, and katanas!", "short_description": "Return to the town of Harrow Manor, this time the monsters are much more deadly. The keys and weapons are well hidden, see if you can make it out alive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.onlyhumanstudios.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Only Human Studios", "support_website_url": "https://www.onlyhumanstudios.net/", "website_url": "https://www.onlyhumanstudios.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "313298567415244"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75367596_154170716619375_76032338918422839_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8neUrMEHe8Q7kNvwEMqcRY&_nc_oc=AdlHHa7v4TmmIXPzzOfw672IQsazUq9OoiflzhTE6CyM2BJYRRydtH9sP84FmE9tDAk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv6wwVuv7RAdQVVpAlb52CebfdWWGJRbqxVqmfrnSoHMw&oe=69A2CE2B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Secret of Harrow Manor 2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1625849867, "lastRevision": {"nodes": [{"id": "1204533529990589", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_m
s, grenade launchers, and katanas!", "short_description": "Return to the town of Harrow Manor, this time the monsters are much more deadly. The keys and weapons are well hidden, see if you can make it out alive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.onlyhumanstudios.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Only Human Studios", "support_website_url": "https://www.onlyhumanstudios.net/", "website_url": "https://www.onlyhumanstudios.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "313298567415244"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75367596_154170716619375_76032338918422839_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1PY1LRKbg0Q7kNvwFiaXHY&_nc_oc=Adk5dlT17k0bZg-gKC817JtjIPfsh2THUgBGfs-8J_62DQrVPq0pkWkaTf1SeaQ4-NY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3_u56bGL_yzsYpQfD8FPpG5ioTA6zj6Kht-4JjTfIdA&oe=69BE7DAB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Secret of Harrow Manor 2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1625849867, "lastRevi
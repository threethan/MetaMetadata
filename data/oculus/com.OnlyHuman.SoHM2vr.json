052042", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974493_111247914385375_3275648255043241126_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SQ_j_hNwOEQ7kNvwHhntm1&_nc_oc=AdnPzEcAg_Gg9iyQDTawlmydhj530XEDOrv8_Qd6RqHqVWwt8nWc7pTY7p8M1iIZxdM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuCMrPnI4nCXUOxMRfsz3DYTOxqKSFkaQe-LJ0JSkaf6A&oe=69A58398"}, {"file_name": "Screenshot9.png", "id": "1058443408015562", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974753_1058443411348895_1631510142665547702_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NToACLeXzp8Q7kNvwGuDozg&_nc_oc=Adk5mpRLMUcR1G3ITKiEZKeURxiygtE7iLv8DitMjRemJuECXJIMqRyIoAH1Szsej4Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afutvagj4UXmvDZeUC-u0WgQir2O1uU-tq6_SeIxUBzAdg&oe=69A585C6"}, {"file_name": "Screenshot10.png", "id": "1206986639750759", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974767_1206986643084092_8108874457345208060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XagJ44Zwou8Q7kNvwHeDpkM&_nc_oc=Adkx9c0XTtx4N3xYGnb0_Okry1JcNkGfIoQ8c7bxWxouR7bppjLsLZFe9Xk_j_2g5ds&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu2VMoVpq2gSwdW3N2IHQd3uJN2yHEeA_hUB8uw3j7vzQ&oe=69A59609"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret of Harrow Manor 2", "keywords": [], "long_description": "You have just escaped the horrifying laboratory where the experiments began, now your only way out lies through the town of Harrow Manor. \nThis time around, the monsters are more deadly, but luckily the townspeople had been fearing such an event might happen and have left many more weapons behind to fight them.\n\nFeatures:\n-Explore an entire undead infested town, complete with a church, hospital, and prison!\n-Play alone or co-op with a friend!\n-7 new weapons to wield against the new undead, including flamethrowers, grenade launchers, and katanas!", "short_description": "Return to the town of Harrow Manor, this time the monsters are much more deadly. The keys and weapons are well hidden, see if you can make it out alive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.onlyhumanstudios.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Only Human Studios", "support_website_url": "https://www.onlyhumanstudios.net/", "website_url": "https://www.onlyhumanstudios.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "313298567415244"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75367596_154170716619375_76032338918422839_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWKIVycxp6IQ7kNvwEkZutz&_nc_oc=AdnIWUAOPnUwpNtt-rxVo8n9t--a9QeAJUx1D7_UiNImyYrJKjDtQ7pBmM_2Hx_NjoM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs1cCmatheUOrldk1gUAwoTERKAQNgmzMol8C2ZxLrf8g&oe=69A5712B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Secret of Harrow Manor 2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1625849867, "lastRevision": {"nodes": [{"id": "1204533529990589", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_m
_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABmKKqDZcQ8Q7kNvwEWpzbQ&_nc_oc=AdpKBVIWoSNL7-pRj6xRGHfYj9XIrk6U3RVDnJSq857967bi0nkOuXqmFOK5W1C6acs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQULdWVS2-wiwIIRPyddzBQGdgu6z4X9Sz72IUg-UUkyg&oe=6B08521B"}, {"file_name": "Screenshot7.png", "id": "111247911052042", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974493_111247914385375_3275648255043241126_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKvRxU6M2MgQ7kNvwGeJLir&_nc_oc=Ado5pnGIbYeyhndDk24aWHPiaZ1snfvcesTUuJ61GJZQY0PwBdQXupEpQS9tQ7sCDhQ&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0R__rrTdXgkh1pd1a6qdLLz4F1LfCHyWGBOKZKbhvHQ&oe=6B085F58"}, {"file_name": "Screenshot9.png", "id": "1058443408015562", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974753_1058443411348895_1631510142665547702_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkQHXvALzRAQ7kNvwHWJFfo&_nc_oc=AdrR4OnDVOoF2Vl2BgdOcBhtHMzRlPZm2o2IzmffcSjw1JnYIKRPtM-nQ99wDjNc0FE&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVTunur80B1yw0G63cv5BoNLyxiIqg60N-BFiVTL2VVg&oe=6B086186"}, {"file_name": "Screenshot10.png", "id": "1206986639750759", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974767_1206986643084092_8108874457345208060_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdAZqVwg_78Q7kNvwHAHiXm&_nc_oc=Adpq1VTi-ZOd82T7ezX1Mzk1-CUwNljkcTCnlT3Pc4t9e9XwTlqKqNTMMedh2WGxAIs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7Rx5HuSkam5F8NVRxWuIiX_tPJj073rBftC2NnjIYKg&oe=6B0871C9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret of Harrow Manor 2", "keywords": [], "long_description": "You have just escaped the horrifying laboratory where the experiments began, now your only way out lies through the town of Harrow Manor. \nThis time around, the monsters are more deadly, but luckily the townspeople had been fearing such an event might happen and have left many more weapons behind to fight them.\n\nFeatures:\n-Explore an entire undead infested town, complete with a church, hospital, and prison!\n-Play alone or co-op with a friend!\n-7 new weapons to wield against the new undead, including flamethrowers, grenade launchers, and katanas!", "short_description": "Return to the town of Harrow Manor, this time the monsters are much more deadly. The keys and weapons are well hidden, see if you can make it out alive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.onlyhumanstudios.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Only Human Studios", "support_website_url": "https://www.onlyhumanstudios.net/", "website_url": "https://www.onlyhumanstudios.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "313298567415244"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75367596_154170716619375_76032338918422839_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3eqnKwZhIwQ7kNvwFhGS3L&_nc_oc=Adok4MiwsdrvurAs-epPxWaOBGKYxkS8KbnKuFu1I5U50xkTsu8ZL4hh8NgpUlGwwlM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_A
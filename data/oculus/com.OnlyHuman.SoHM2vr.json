_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMKe-ahFhiwQ7kNvwGojvo7&_nc_oc=AdqzkYxwVwFO8jKLXlMzZ6BUFfylTj3_09EkdiRDzUKT55mGe42Lrma4sW3x6yr6ha4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUV7t9a_EVka2aLS8fmBx8qLNeiGk9lpxofaCiSQl3fA&oe=6AFB231B"}, {"file_name": "Screenshot7.png", "id": "111247911052042", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974493_111247914385375_3275648255043241126_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zUKUWeKjZYQ7kNvwEmSHpg&_nc_oc=AdqSMOG-GeLZE6NiW5Hhi0NDMgbqEqtZwkAFrKEJsrNGR9m_OQQAxZwLBXY8bOkVRaA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSz5MpjhSuk8EkK_iE0VEMLye8HiAGby0dRz8Htqo6ffg&oe=6AFB3058"}, {"file_name": "Screenshot9.png", "id": "1058443408015562", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974753_1058443411348895_1631510142665547702_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgZPVxP6QskQ7kNvwEdj25R&_nc_oc=AdpZjFfwJIY_6-dAvsQSFlLEl_dFzwl0vjME6nEqUYZqRVxpvvTrONBEoKK3ypvEudk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNfXnKm3RnPX2cXw5ytJeYnh2S6UnZoe72J42BSTkeAQ&oe=6AFB3286"}, {"file_name": "Screenshot10.png", "id": "1206986639750759", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974767_1206986643084092_8108874457345208060_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1cPamosFzoQ7kNvwGQ70N4&_nc_oc=AdqsUB3qP2qMHSUryaDho7aBrC2y212aZwsEfdms_rOzM3dujB1w0ncWy7AE_zdNgi4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStY4IBUI2niwNyMK96xKJqEqV2NpTQEwNlRwNcCa7yuQ&oe=6AFB42C9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret of Harrow Manor 2", "keywords": [], "long_description": "You have just escaped the horrifying laboratory where the experiments began, now your only way out lies through the town of Harrow Manor. \nThis time around, the monsters are more deadly, but luckily the townspeople had been fearing such an event might happen and have left many more weapons behind to fight them.\n\nFeatures:\n-Explore an entire undead infested town, complete with a church, hospital, and prison!\n-Play alone or co-op with a friend!\n-7 new weapons to wield against the new undead, including flamethrowers, grenade launchers, and katanas!", "short_description": "Return to the town of Harrow Manor, this time the monsters are much more deadly. The keys and weapons are well hidden, see if you can make it out alive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.onlyhumanstudios.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Only Human Studios", "support_website_url": "https://www.onlyhumanstudios.net/", "website_url": "https://www.onlyhumanstudios.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "313298567415244"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75367596_154170716619375_76032338918422839_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWGX3avIzKsQ7kNvwG8iIAg&_nc_oc=AdqkRPVcDBlP2hi0u8XngDcB9MoTPUZmOgUAcudL2eeXiYfEApn70NFN7GsNCORddLQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_A
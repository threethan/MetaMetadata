c_sid=6e7a0a&_nc_ohc=DlNOFGWjrsQQ7kNvwHgUbwV&_nc_oc=AdpAFO4VUF4KQPDWlW3hHik4L_UZ3mn78fVu-O1kdhwTLf4QiJGd2Nzx9aGBMnwzqsg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6Tx-o4sacSR3F5pi5GaBcvpVJc_v2jXx7Fo4rrz_oIg&oe=6A635E36"}, "display_name": "Slap Fighting Champion", "keywords": ["VRSlapFighting", "SlapFightingGame", "ArcadeFighting", "PowerFighting", "ChampionFighter"], "long_description": "Step into the arena and unleash pure power in Slap Fighting Champion, a VR experience built around strength, endurance, and satisfying slap combat.\n\nGo head-to-head with opponents in one-on-one slap battles where raw power and resilience decide the winner. Deliver strong slaps, withstand incoming hits, and push your limits as the intensity increases with each match.\n\nThe gameplay is fast, accessible, and easy to understand, making it perfect for quick sessions and competitive fun. As you progress, opponents become tougher, demanding greater strength and focus to stay standing and claim victory.\n\nWith impactful VR controls, exaggerated physics, and an energetic atmosphere, Slap Fighting Champion offers a lighthearted yet intense fighting experience designed purely for fun.\n\nStep forward, raise your hand, and prove you have what it takes to become the champion.", "short_description": "A fun and intense VR slap fighting game focused on power, endurance, and becoming the ultimate champion."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "website_url": "https://atakanerdeger.github.io/gametriclabs/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "extern
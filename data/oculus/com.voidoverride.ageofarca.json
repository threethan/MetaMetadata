mOr3oKGDXgsSi4P6yhqi-9tH16_JJV6UglA&oe=6B084304"}, {"file_name": "spatialized background 512x512.png", "id": "2421092168699136", "image_type": "APP_IMG_ICON_BACKGROUND_512", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823259_2421092185365801_7321153711097157647_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZl7ztKKH24Q7kNvwGS-Ruh&_nc_oc=Ado3qp-BjnTQHLXY0y0r4fLL_TYpk3QUXKgeVATy_6scj_sZMkCPw-RCvjfs96DZkwY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTh-9Nf0Mn_i0ORSxCNuLOszlQE4ICX2h-WaLt-NLpwcQ&oe=6B084DB0"}, {"file_name": "LOGO_ARCA.png", "id": "2247354066126387", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491825575_2247354072793053_6713634639198982203_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5l08EqC8s_IQ7kNvwGM4XGq&_nc_oc=AdprZuLdbqYJ3K82pIVUIw1jbRJ0bLk766_BELr5wllxiU5woiME_pOItb8qYP-pKGE&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5UHS3zLzvYgxQKEDB2Ec9wtEO4fbMtSsnFfYTaOL26g&oe=6B0860B9"}, {"file_name": "layered_icon_composited.png", "id": "2162919437931631", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827646_2162919441264964_1747925209727975117_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zC6RW71rxqQQ7kNvwEsNFxJ&_nc_oc=AdpjJwHxzfkLkZ7RiBd-FEbMrIji-DGu2trrbkzF7AURIF_4rLaFVWhmM9FIS6X2C7Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNK0bSB6ANwiQGk-3fzNBbB4FMvvfwgpYcpjDyormPUA&oe=6B086799"}, {"file_name": "meta_portrait_v5.png", "id": "1752913359120278", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824322_1752913365786944_3191574284280036842_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yf-4Tt4Df2cQ7kNvwGGgLRs&_nc_oc=Adol4Azn4re-DHuCyuPmI4I5YFMMUpJai5etMCdYKCGdN2d6zpehGBDrEBfTsd_3z30&_nc_zt=3&
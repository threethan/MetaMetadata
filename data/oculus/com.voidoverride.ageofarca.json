17", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827585_4630712857240516_3365674810732670314_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIyx0deV0oQQ7kNvwFwuHrp&_nc_oc=AdpqQE32bv4wZmxqVW-FwRXBmzDwhr8uR-LmFq-hoV9XA00Vx8wfBExizmEVEyn96DM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxj_iJCejS0Nt76e0SxnbrKUxXOLV__bpoFI3Y1AchcA&oe=6B086560"}, {"file_name": "HF-01.png", "id": "28774862492180339", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491824700_28774862505513671_338779665304414101_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRLm0PzCAswQ7kNvwGN3ZhK&_nc_oc=AdpPCp3jItRKQcDToRrKQNbqO06BCOoYpVAO1dG8wiuk6XVxOguHJ7MJ4cklRceqWqU&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH7NzIvlQdf8Gm6b6972xFX0WxlZE1uXX3wlr-oo6jKA&oe=6B085F97"}, {"file_name": "HF-04.png", "id": "1996111641107005", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823296_1996111644440338_235991439932204406_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxngVj6uEWkQ7kNvwFe27vN&_nc_oc=Adpibh2_4ze0cEfHCa6N9WY3_jXqzptce_2N0e071DIOyD6aDXC-or3Jn-F0gAz1RUQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjnVj9Ylt3WzC1zUz4PxQjjscM81WdMNv3_E3knJHKjA&oe=6B085B4D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Age of Arca", "keywords": ["Shooter", "SciFi", "Alien", "Physics", "Horde"], "long_description": "**Age of Arca** is a fast, aggressive, large-scale VR sci-fi horde shooter that drops you into the heart of a planetary war. Every mission is its own battle, and no two runs play out the same.\n\nThe desert planet ARIDUM-VII has been overrun by the Aberrants, a hostile alien swarm pouring out of nests across the planet. From Raptors and explosive Flies to Titans, the giant GIGA and a Flying Boss, the swarm comes in every shape and size. Your fellow soldiers are already down there, fighting to take it back. They need you on the front line.\n\nSoldier squads push forward at your side, tanks pound the enemy swarm, and convoys roll over stunned enemies. Overhead, bombers flatten the ground ahead and orbital mining rigs crash down from the sky. But watch where you step, friendly fire is on.\n\nGear up with an energy rifle, a plasma sidearm, a charged sniper and more, then run one or dual-wield two. Every mission earns Vitrex you can spend to upgrade your arsenal with more damage, more capacity, better charged shots. \n\nEvery mission is one moment in a much bigger war. \n\nFight through 9 campaign missions, 6 bonus missions, Endurance missions and Elite Missions. \n\nThe war is only getting bigger!\n\nNobody ever took a planet from behind cover. \nDrop in and take it.\n", "short_description": "A fast, large-scale VR sci-fi horde shooter. An alien swarm has overrun the planet. Drop into the warzone, tear through the swarm with a dual-wielded arsenal, and take the planet back one mission at a time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://voidoverride.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Neem Interactive", "support_website_url": "https://discord.gg/peHNQtUn", "website_url": "https://ageofarca.voidoverride.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "fr", "nl", "ja", "it", "de", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SC
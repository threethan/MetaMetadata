cb=1-7&_nc_sid=6e7a0a&_nc_ohc=leuRMiCxh38Q7kNvwGTouG4&_nc_oc=AdqXvFogdjanl_v_4zZLR3mWehZSytVhHdNhOBktFX184C2_3zyevE4GtS8wUBKyc28&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6OFI470K40lz7TzNPPPLvHWX8nJAGnaCB8t8xjmniRA&oe=6B0872CC"}, {"file_name": "2.png", "id": "1123032843648156", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/613094043_1123032846981489_972279864554481359_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sF7pI9eKr6YQ7kNvwES2Faf&_nc_oc=Adq1DZKno2DgCPhMcrj8fXxFVpaall2STFuhC2yXBoMqtNHIDfETRkgmwI2oH-4Lu4k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzxSjpdO1Oj8plhLgkYrdVyzCWwtmqCiPSpc18mOn6Qg&oe=6B0866A4"}, {"file_name": "3.png", "id": "2816530648743111", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499313063_2816530652076444_1043769000578312940_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUIlVbhrAA0Q7kNvwEm1505&_nc_oc=AdpqmbasPCvVldfsIYGwarH7XPg-984ZvjwwurTqE5fc09CDHvzORJjzDjZHFuLz83U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0ON1sAaQT-UKusz_43Ckg-bCE7FnjGheua59ZLZDk3g&oe=6B08611D"}, {"file_name": "5.png", "id": "1671836961090201", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/791586454_1671836964423534_6504397604733033171_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WVWrkL8oC4Q7kNvwE-UUqi&_nc_oc=AdqnaSw86ZsMnfBNBdwoDkaI63xZxT40duvomQiwXifnSQszPiPlXE57SwQEab65G_U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWmWcTUAOv8ffKOHiczY6I9OKE3Ge98EsyzeKN5k9d6w&oe=6B0866AC"}, {"file_name": "4.png", "id": "2578074486045956", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499308026_2578074489379289_1852041835618231880_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fK4wsJAWgwQ7kNvwGkO0V2&_nc_oc=AdqTT2q50zyt200O4LaxWbBOO8MweODM3TbCh09vaPzNsKxEjJBgOa8f4Kgan0lNq8A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJN5BR3OCVP9ID8O1YUik8bfyvMZt5KPbfqflsMfHIfA&oe=6B08479F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta_landscape_v4.png", "id": "2328118774650983", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/604370996_2328118777984316_4257552974818926486_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVzOtZWmvBUQ7kNvwHC3m8S&_nc_oc=AdqRx9BPumHw85nK5vz5FUZMJqXeT7XYNT3e5phcOJ6AX7Pv_eFQ8PDT7pN7exoVcV8&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYyGuuTFdK7w_ZK2WkQbN_pN6jpnlfgVr-TCIZhytNbQ&oe=6B0846C0"}, "display_name": "Age of Arca", "keywords": ["Shooter", "SciFi", "Alien", "Physics", "Horde"], "long_description": "**Age of Arca** is a fast, aggressive, large-scale VR sci-fi horde shooter that drops you into the heart of a planetary war. Every mission is its own battle, and no two runs play out the same.\n\nThe desert planet **ARIDUM-VII** has been overrun by the **Aberrants**, a hostile alien swarm pouring out of nests across the planet. \n\n{2265410834355015}\n\nFrom **fast, leaping hunters** and **exploding flyers** to **hulking brutes** and **colossal giants**, the swarm of **Aberrants** comes in every shape and size. Your fellow soldiers are already down there, fighting to take it back. **They need you** on the front line.\n\n{29587448444174980}\n\n**Soldier squads push** forward at your side, tanks pound the swarm, and convoys roll over stunned enemies. Overhead, bombers flatten the ground ahead and orbital mining rigs crash down from the sky.\n\n{946572428246710}\n\n**Gear up** with an energy rifle, a plasma sidearm and the **VINDEX-VII sniper**,  get up close with the **MANUS-II plasma gauntlets**. Every mission earns **Vitrax** you can spend to upgrade your arsenal with more damage, more capacity, charged sniper shots and a stronger gauntlet shockwave.\n\n{1688231432904530}\n\n**Every mission is one moment in a much bigger war.**\n \nFight through **9 campaign missions, 7 bonus missions, 3 Endurance missions and Elite Missions**. \n \n**The war is only getting bigger!**\n\n**Nobody ever took a planet from behind cover.**\n\n{1102331299271977}\n\n**Drop in and take it.**", "short_description": "A fast, large-scale VR sci-fi horde shooter. An alien swarm has overrun the planet. Drop into the warzone, tear through the swarm with a dual-wielded arsenal, and take the planet back one mission at a time."}, {"images": {"nodes": []}, "id": "29003595895998855", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Age of Arca", "keywords": ["Shooter", "ScienceFiction", "Alien", "Physik", "Horde"], "long_description": "**Age of Arca** ist ein rasanter, gro\u00df angelegter VR-Sci-Fi-Horde-Shooter mitten in einem planetaren Krieg. Jede Mission ist eine eigene Schlacht, kein Durchlauf gleicht dem anderen.\n\nDer W\u00fcstenplanet **ARIDUM-VII** ist von den **Anomalien** \u00fcberrannt \u2013 einem feindlichen Alien-Schwarm, der aus Nestern hervorbricht.\n\n{981647991268503}\n\nVon **Sprungj\u00e4gern** und **explosiven Flugeinheiten** bis zu **massigen Bestien** und **Kolossen**: Die **Anomalien** kommen in allen Formen. Deine Kameraden k\u00e4mpfen bereits um den Planeten. **Sie brauchen dich** an der Front.\n\n{1696547605479920}\n\n**Soldatentrupps** r\u00fccken mit dir vor, Panzer bek\u00e4mpfen den Schwarm und Konvois \u00fcberrollen bet\u00e4ubte Feinde. Bomber ebnen den Weg, w\u00e4hrend orbitale Abbauanlagen vom Himmel st\u00fcrzen.\n\n{2937102559985843}\n\n**R\u00fcste dich aus** mit Energiegewehr, Plasma-Pistole und **VINDEX-VII-Pr\u00e4zisionsgewehr**. Im Nahkampf setzt du die **MANUS-II-Plasmahandschuhe** ein. Verdiene **Vitrax** und verbessere Schaden, Kapazit\u00e4t, aufgeladene Sch\u00fcsse und die Schockwelle deiner Handschuhe.\n\n{1769491397933378}\n\n**Jede Mission ist lediglich ein Moment in einem viel gr\u00f6\u00dferen Konflikt.**\nK\u00e4mpfe dich durch **neun Kampagnenmissionen, sieben Bonusmissionen, drei Durchhalte-Missionen sowie Elite-Missionen**.\n\n**Der Krieg wird nur noch gr\u00f6\u00dfer!**\n\n**Niemand hat je aus der Deckung heraus einen Planeten erobert.**\n\n{967661806101507}\n\n**St\u00fcrz dich ins Get\u00fcmmel und hol ihn dir.**", "short_description": "Ein rasanter, umfangreicher VR-Science-Fiction-Shooter. Ein au\u00dferirdischer Schwarm hat den Planeten \u00fcberrannt. Lande in der Gefechtszone, bahne dir mit deinem beidh\u00e4ndigen Arsenal eine Schneise durch den Schwarm und erobere den Planeten zur\u00fcck \u2013 Mission f\u00fcr Mission."}, {"images": {"nodes": []}, "id": "3526231684228901", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Age of Arca", "keywords": ["\u30b7\u30e5\u30fc\u30bf\u30fc", "SF", "\u30a8\u30a4\u30ea\u30a2\u30f3", "\u7269\u7406\u6f14\u7b97", "\u5927\u7fa4"], "long_description": "\u300c**Age of Arca**\u300d\u306f\u3001\u60d1\u661f\u898f\u6a21\u306e\u6226\u4e89\u306e\u6e26\u4e2d\u3078\u3068\u98db\u3073\u8fbc\u307f\u3001\u62bc\u3057\u5bc4\u305b\u308b\u6575\u306e\u5927\u7fa4\u3092\u8e74\u6563\u3089\u3059\u30cf\u30a4\u30b9\u30d4\u30fc\u30c9\u304b\u3064\u653b\u6483\u7684\u306a\u5927\u898f\u6a21VR SF\u30b7\u30e5\u30fc\u30bf\u30fc\u3060\u3002\u3059\u3079\u3066\u306e\u30df\u30c3\u30b7\u30e7\u30f3\u304c\u72ec\u7acb\u3057\u305f\u6226\u5834\u3068\u306a\u3063\u3066\u304a\u308a\u3001\u4e8c\u5ea6\u3068\u540c\u3058\u5c55\u958b\u306f\u8a2a\u308c\u306a\u3044\u3002\n\n\u7802\u6f20\u306e\u60d1\u661f\u300c**\u30a2\u30ea\u30c9\u30a5\u30e0VII**\u300d\u306f\u3001\u60d1\u661f\u5404\u5730\u306e\u5de3\u304b\u3089\u6e67\u304d\u51fa\u3059\u6575\u5bfe\u7684\u306a\u7570\u661f\u751f\u7269\u306e\u5927\u7fa4\u300c**\u7570\u5e38\u4f53**\u300d\u306b\u5236\u5727\u3055\u308c\u3066\u3057\u307e\u3063\u305f\u3002\n\n{2357060601782633}\n\n**\u7d20\u65e9\u304f\u8df3\u3073\u304b\u304b\u308b\u6355\u98df\u8005**\u3084**\u7206\u767a\u3059\u308b\u98db\u884c\u7a2e**\u3001**\u5de8\u4f53\u306e\u602a\u7269**\u3084**\u8d85\u5de8\u5927\u306a\u500b\u4f53**\u3001\u3055\u3089\u306b**\u7570\u5e38\u4f53**\u306e\u7fa4\u308c\u304c\u5927\u5c0f\u3055\u307e\u3056\u307e\u306a\u59ff\u3067\u8972\u3044\u304b\u304b\u3063\u3066\u304f\u308b\u3002\u4ef2\u9593\u306e\u5175\u58eb\u305f\u3061\u306f\u3059\u3067\u306b\u5730\u4e0a\u3067\u6226\u3044\u3001\u60d1\u661f\u306e\u596a\u9084\u3092\u76ee\u6307\u3057\u3066\u3044\u308b\u304c\u3001\u524d\u7dda\u3067\u306f**\u3042\u306a\u305f\u306e\u529b\u304c\u5fc5\u8981**\u306a\u306e\u3060\u3002\n\n{1452812629613039}\n\n**\u5473\u65b9\u306e\u5206\u968a\u3068\u5171\u306b\u9032\u8ecd**\u3059\u308c\u3070\u3001\u6226\u8eca\u304c\u6575\u306e\u7fa4\u308c\u306b\u7832\u6483\u3092\u6d74\u3073\u305b\u3001\u8f38\u9001\u8eca\u4e21\u304c\u602f\u3093\u3060\u6575\u3092\u6b21\u3005\u3068\u8e0f\u307f\u6f70\u3057\u3066\u3044\u304f\u3002\u982d\u4e0a\u3067\u306f\u7206\u6483\u6a5f\u304c\u524d\u65b9\u306e\u6575\u9663\u3092\u66f4\u5730\u3078\u3068\u5909\u3048\u3001\u8ecc\u9053\u4e0a\u304b\u3089\u5de8\u5927\u306a\u63a1\u6398\u30ea\u30b0\u304c\u8f5f\u97f3\u3068\u3068\u3082\u306b\u964d\u4e0b\u3059\u308b\u3002\n\n{1434524062185261}\n\n\u30a8\u30cd\u30eb\u30ae\u30fc\u30e9\u30a4\u30d5\u30eb\u3001\u30d7\u30e9\u30ba\u30de\u30b5\u30a4\u30c9\u30a2\u30fc\u30e0\u3001**VINDEX-VII\u30b9\u30ca\u30a4\u30d1\u30fc**\u3067**\u6b66\u88c5**\u3057\u3001\u63a5\u8fd1\u6226\u3067\u306f**MANUS-II\u30d7\u30e9\u30ba\u30de\u30ac\u30f3\u30c8\u30ec\u30c3\u30c8**\u3092\u53e9\u304d\u8fbc\u3082\u3046\u3002\u30df\u30c3\u30b7\u30e7\u30f3\u3054\u3068\u306b\u7372\u5f97\u3067\u304d\u308b**\u30f4\u30a3\u30c8\u30e9\u30af\u30b9**\u3092\u4f7f\u3048\u3070\u3001\u30c0\u30e1\u30fc\u30b8\u3084\u5bb9\u91cf\u306e\u5897\u52a0\u3001\u30b9\u30ca\u30a4\u30d1\u30fc\u306e\u30c1\u30e3\u30fc\u30b8\u30b7\u30e7\u30c3\u30c8\u3001\u30ac\u30f3\u30c8\u30ec\u30c3\u30c8\u306e\u885d\u6483\u6ce2\u306e\u5f37\u5316\u306a\u3069\u3001\u6b66\u5668\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u53ef\u80fd\u3060\u3002\n\n{1869841040838998}\n\n**\u3069\u306e\u30df\u30c3\u30b7\u30e7\u30f3\u3082\u3001\u306f\u308b\u304b\u306b\u5927\u304d\u306a\u6226\u4e89\u306e\u4e00\u5834\u9762\u306b\u3059\u304e\u306a\u3044\u3002**\n\n**9\u3064\u306e\u30ad\u30e3\u30f3\u30da\u30fc\u30f3\u30df\u30c3\u30b7\u30e7\u30f3\u30017\u3064\u306e\u30dc\u30fc\u30ca\u30b9\u30df\u30c3\u30b7\u30e7\u30f3\u30013\u3064\u306e\u8010\u4e45\u30df\u30c3\u30b7\u30e7\u30f3\u3001\u305d\u3057\u3066\u30a8\u30ea\u30fc\u30c8\u30df\u30c3\u30b7\u30e7\u30f3**\u3092\u6226\u3044\u629c\u3053\u3046\u3002\n\n**\u6226\u3044\u306e\u898f\u6a21\u306f\u3001\u3055\u3089\u306b\u62e1\u5927\u3057\u3066\u3044\u304f\uff01**\n\n**\u7269\u9670\u306b\u96a0\u308c\u305f\u307e\u307e\u3067\u3001\u60d1\u661f\u3092\u596a\u3044\u8fd4\u305b\u305f\u8005\u306f\u3044\u306a\u3044\u3002**\n\n{3040742186305241}\n\n**\u3055\u3042\u964d\u4e0b\u3057\u3066\u3001\u60d1\u661f\u3092\u596a\u3044\u8fd4\u305d\u3046\u3002**", "short_description": "\u8feb\u308a\u304f\u308b\u5927\u7fa4\u306b\u7acb\u3061\u5411\u304b\u3048\uff01\u300cAge of Arca\u300d\u306f\u3001\u30b9\u30d4\u30fc\u30c9\u611f\u3042\u3075\u308c\u308b\u5927\u898f\u6a21VR SF\u30b7\u30e5\u30fc\u30bf\u30fc\u3060\u3002\u7570\u661f\u751f\u7269\u306e\u7fa4\u308c\u306b\u60d1\u661f\u304c\u5236\u5727\u3055\u308c\u305f\u3002\u6226\u5834\u306b\u964d\u308a\u7acb\u3061\u3001\u4e21\u624b\u306b\u69cb\u3048\u305f\u6b66\u5668\u3067\u7fa4\u308c\u3092\u5207\u308a\u88c2\u304d\u3001\u30df\u30c3\u30b7\u30e7\u30f3\u3092\u4e00\u3064\u305a\u3064\u30af\u30ea\u30a2\u3057\u3066\u60d1\u661f\u3092\u596a\u9084\u3057\u3088\u3046\u3002"}, {"images": {"nodes": []}, "id": "2243391409550632", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Age of Arca", "keywords": ["Tir", "ScienceFiction", "Alien", "Physique", "Horde"], "long_description": "**Age of Arca** est un jeu de tir VR de science-fiction effr\u00e9n\u00e9, \u00e0 grande \u00e9chelle, face \u00e0 des hordes aliens. Chaque mission est une bataille unique et chaque partie diff\u00e9rente.\n\nLa plan\u00e8te d\u00e9sertique **ARIDUM-VII** est envahie par les **aberrations**, des aliens hostiles surgissant de leurs nids.\n\n{1843859406916974}\n\nDes **chasseurs rapides et bondissants**, des **ennemis volants explosifs**, des **brutes imposantes** et des **g\u00e9ants colossaux** : les **aberrations** ont mille visages. Vos camarades luttent d\u00e9j\u00e0 pour reprendre la plan\u00e8te. **Ils ont besoin de vous** au front.\n\n{1174107441847778}\n\n**Des escouades progressent** \u00e0 vos c\u00f4t\u00e9s, des chars pilonnent l'essaim et des convois \u00e9crasent les ennemis \u00e9tourdis. Des bombardiers rasent le terrain et des plateformes mini\u00e8res orbitales tombent du ciel.\n\n{2139901363334325}\n\n**\u00c9quipez-vous** d'un fusil \u00e9nerg\u00e9tique, d'une arme de poing \u00e0 plasma et du **fusil de pr\u00e9cision VINDEX-VII**, ou combattez de pr\u00e8s avec les **gantelets de plasma MANUS-II**. Chaque mission rapporte du **Vitrax** pour am\u00e9liorer les d\u00e9g\u00e2ts, la capacit\u00e9, les tirs charg\u00e9s et l'onde de choc.\n\n{3548887521955314}\n\n**Chaque mission s'inscrit dans une guerre bien plus vaste.**\n\nParticipez \u00e0 **9 missions de campagne, 7 missions bonus, 3 d'endurance et des missions d'\u00e9lite**.\n\n**La guerre ne fait que s'intensifier !**\n\n**Et personne n'a jamais conquis une plan\u00e8te en restant \u00e0 couvert.**\n\n{1938319850908617}\n\n**D\u00e9ployez-vous et prenez-en le contr\u00f4le.**", "short_description": "Dans ce jeu de tir effr\u00e9n\u00e9 en VR \u00e0 grande \u00e9chelle et de science-fiction, vous faites face \u00e0 un essaim d'aliens qui a envahi la plan\u00e8te. D\u00e9ployez-vous sur le champ de bataille, balayez des hordes avec une arme dans chaque main et reprenez le contr\u00f4le de cet astre, mission apr\u00e8s mission."}, {"images": {"nodes": []}, "id": "1874872403681562", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Age of Arca", "keywords": ["Shooter", "CienciaFicci\u00f3n", "Alien\u00edgena", "F\u00edsica", "Horda"], "long_description": "**Age of Arca** es un shooter r\u00e1pido y agresivo de ciencia ficci\u00f3n de hordas en RV a gran escala que te pone en el centro de una guerra planetaria. Cada misi\u00f3n es su propia batalla, y no hay dos partidas iguales.\n\nLos **Aberrantes**, un enjambre alien\u00edgena hostil que brota de nidos a lo largo del planeta, invadi\u00f3 el planeta des\u00e9rtico **ARIDUM-VII**.\n\n{1178803181490222}\n\nEntre **cazadores \u00e1giles que saltan**, **voladores explosivos**, **bestias enormes** y **gigantes colosales**, los **Aberrantes** adoptan muchas formas. Tus compa\u00f1eros ya luchan por recuperar el planeta. **Te necesitan** en el frente.\n\n{3000738370290501}\n\n**Los escuadrones de soldados** avanzan a tu lado, los tanques combaten al enjambre y los convoyes arrollan enemigos aturdidos. Arriba, los bombarderos arrasan el terreno y caen plataformas mineras orbitales.\n\n{1475221737904626}\n\n**Equ\u00edpate** con un rifle de energ\u00eda, un arma de plasma y el **francotirador VINDEX-VII**, o combate de cerca con los **guanteletes de plasma MANUS-II**. Gana **Vitrax** en cada misi\u00f3n para mejorar da\u00f1o, capacidad, disparos cargados y la onda de choque de tus guanteletes.\n\n{1149786434366836}\n\n**Cada misi\u00f3n es un momento en una guerra mucho m\u00e1s grande.**\nPelea en **9 misiones de campa\u00f1a, 7 misiones de bonificaci\u00f3n, 3 misiones de resistencia y misiones \u00e9lite**.\n\n**\u00a1La guerra solo sigue ampli\u00e1ndose!**\n\n**Nadie nunca se hizo de un planeta desde un escondite.**\n\n{1223777073428731}\n\n**Llega y t\u00f3malo.**", "short_description": "Un shooter r\u00e1pido de ciencia ficci\u00f3n de hordas en RV a gran escala. Un enjambre alien\u00edgena invadi\u00f3 el planeta. Llega a la zona de guerra, atraviesa el enjambre con un arsenal a dos manos y recupera el planeta, una misi\u00f3n a la vez."}, {"images": {"nodes": []}, "id": "1586714063495946", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u5927\u7fa4", "keywords": ["\uc288\ud130", "SF", "\uc678\uacc4\uc0dd\uba85\uccb4", "\ubb3c\ub9ac", "\ud638\ub4dc"], "long_description": "**Age of Arca**\ub294 \ud589\uc131 \uc804\uc7c1\uc758 \ud55c\ubcf5\ud310\uc5d0 \ub6f0\uc5b4\ub4e4\uc5b4 \uc801\ub4e4\uacfc \uc2f8\uc6b0\ub294 \ube60\ub978 \ud15c\ud3ec\uc758 \ub300\uaddc\ubaa8 VR SF \ud638\ub4dc \uc288\ud130 \uac8c\uc784\uc785\ub2c8\ub2e4. \ubaa8\ub4e0 \uc784\ubb34\uac00 \ud558\ub098\uc758 \uc804\ud22c\uc774\uba70 \ud50c\ub808\uc774\uc5b4\ub294 \ub9e4\ubc88 \ub2e4\ub978 \ud50c\ub808\uc774\ub97c \uacbd\ud5d8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uc0ac\ub9c9 \ud589\uc131 **ARIDUM-VII**\uc740 \ud589\uc131 \uacf3\uacf3\uc758 \uc801 \uc18c\uad74\uc5d0\uc11c \uc3df\uc544\uc838 \ub098\uc628 \uc678\uacc4 \uc0dd\uba85\uccb4 \ubb34\ub9ac\uc778 **\uc774\ud615\uccb4**\uc5d0\uac8c \uc810\ub839\ub2f9\ud588\uc2b5\ub2c8\ub2e4.\n\n{1137356539100927}\n\n**\ub0a0\ub835\ud558\uac8c \ub3c4\uc57d\ud558\ub294 \ud5cc\ud130**, **\ud3ed\ubc1c\ud558\ub294 \ube44\ud589\ubb3c\uccb4**\ubd80\ud130 **\uc721\uc911\ud55c \uad34\ubb3c**, **\uac70\ub300\ud55c \uac70\uc778\ub4e4**\uc5d0 \uc774\ub974\uae30\uae4c\uc9c0 **\uc774\ud615\uccb4 \ubb34\ub9ac**\ub294 \uc628\uac16 \ud615\ud0dc\uc640 \ud06c\uae30\ub85c \ucd9c\ud604\ud569\ub2c8\ub2e4. \uc804\uc6b0\ub4e4\uc740 \uc774\ubbf8 \uadf8\uacf3\uc5d0\uc11c \ud589\uc131\uc744 \ub418\ucc3e\uae30 \uc704\ud574 \uc804\ud22c \uc911\uc785\ub2c8\ub2e4. \ucd5c\uc804\uc120\uc5d0\ub294 **\ub2f9\uc2e0\uc774 \ud544\uc694\ud569\ub2c8\ub2e4**.\n\n{2282155062565137}\n\n**\ub9ce\uc740 \ubd84\ub300**\uac00 \ubc14\ub85c \uc606\uc5d0\uc11c \uc804\uc9c4\ud558\uba70 \ud0f1\ud06c\ub294 \uc801 \ubb34\ub9ac\ub97c \ub9f9\uacf5\uaca9\ud558\uace0, \uc218\uc1a1\ub300\ub294 \uae30\uc808\ud55c \uc801\ub4e4\uc744 \uc9d3\ubc1f\uace0 \uc9c0\ub098\uac11\ub2c8\ub2e4. \uc0c1\uacf5\uc5d0\uc11c\ub294 \uc218\ub9ce\uc740 \ud3ed\uaca9\uae30\uac00 \uc804\ubc29\uc758 \uc9c0\uba74\uc744 \ucd08\ud1a0\ud654\ud558\uba70, \uc21c\ud658 \uc911\uc778 \ucc44\uad74 \uc124\ube44\uac00 \uc9c0\uc0c1\uc73c\ub85c \uace4\ub450\ubc15\uc9c8\uce69\ub2c8\ub2e4.\n\n{1172149055496931}\n\n\uc5d0\ub108\uc9c0 \uc18c\ucd1d, \ud50c\ub77c\uc2a4\ub9c8 \ubcf4\uc870 \ud654\uae30, \uadf8\ub9ac\uace0 **VINDEX-VII \uc2a4\ub098\uc774\ud37c**\ub85c **\ubb34\uc7a5**\ud558\uc2ed\uc2dc\uc624. \uadfc\uc811\uc804\uc5d0\uc11c\ub294 **MANUS-II \ud50c\ub77c\uc2a4\ub9c8 \uac74\ud2c0\ub9bf**\uc744 \uc0ac\uc6a9\ud574\ubcf4\uc2ed\uc2dc\uc624. \uc784\ubb34\ub97c \uc644\uc218\ud560 \ub54c\ub9c8\ub2e4 **Vitrax**\ub97c \ud68d\ub4dd\ud560 \uc218 \uc788\uc73c\uba70, \uc774\ub97c \uc0ac\uc6a9\ud574 \uacf5\uaca9\ub825 \uc99d\uac00, \ud0c4\uc57d \uc6a9\ub7c9 \uc99d\uac00, \uc2a4\ub098\uc774\ud37c \uc0ac\uaca9 \ucda9\uc804, \uac74\ud2c0\ub9bf \ucda9\uaca9\ud30c \uac15\ud654 \ub4f1\uc758 \ubb34\uae30 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc801\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n{1156636747302416}\n\n**\ubaa8\ub4e0 \uc784\ubb34\uac00 \uac70\ub300\ud55c \uc804\ud22c\uc758 \ud55c \uc21c\uac04\uc785\ub2c8\ub2e4.**\n\n**9\uac1c\uc758 \ucea0\ud398\uc778, 7\uac1c\uc758 \ubcf4\ub108\uc2a4, 3\uac1c\uc758 \uc9c0\uad6c\ub825 \uc784\ubb34\uc640 \uc815\uc608 \uc784\ubb34**\ub97c \uc644\uc218\ud558\uc2ed\uc2dc\uc624.\n\n**\uc804\uc7c1\uc740 \uc810\uc810 \ub354 \ud655\ub300\ub420 \ubfd0\uc785\ub2c8\ub2e4!**\n\n**\uc5c4\ud3d0\ubb3c \ub4a4\uc5d0 \uc228\uc5b4 \uc788\uc5b4\uc11c\ub294 \ud589\uc131\uc744 \ub418\ucc3e\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.**\n\n{2229987187901464}\n\n**\uc804\uc7a5\uc5d0 \ub6f0\uc5b4\ub4e4\uc5b4 \ud589\uc131\uc744 \ucc28\uc9c0\ud558\uc2ed\uc2dc\uc624.**", "short_description": "\ube60\ub978 \ud15c\ud3ec\uc758 \ub300\uaddc\ubaa8 VR SF \ud638\ub4dc \uc288\ud130 \uac8c\uc784\uc785\ub2c8\ub2e4. \uc678\uacc4 \uc0dd\uba85\uccb4 \ubb34\ub9ac\uac00 \ud589\uc131\uc744 \uc644\uc804\ud788 \uc7a5\uc545\ud588\uc2b5\ub2c8\ub2e4. \uc804\uc7a5\uc5d0 \ub6f0\uc5b4\ub4e4\uc5b4 \uc591\uc190 \ubb34\uae30\ub85c \uc801\ub4e4\uc744 \uc4f8\uc5b4\ubc84\ub9ac\uace0, \uc784\ubb34\ub97c \ud558\ub098\uc529 \uc644\uc218\ud558\uba70 \ud589\uc131\uc744 \ub418\ucc3e\uc73c\uc2ed\uc2dc\uc624."}]}, "developer_name": "Void Override", "developer_privacy_policy_url": "https://voidoverride.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Neem Interactive", "support_website_url": "https://discord.gg/peHNQtUn", "website_url": "https://ageofarca.voidoverride.dev/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ja", "de", "es", "ko", "nl", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1535549206289870"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823746_3021625794852388_38930816063386091_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsUHqY6-S-EQ7kNvwFW65MD&_nc_oc=Adq6-FSSIotNvtCCoEW1PLG5S8k7AjZs1Areguwbp9PKfQUbcwCVu2oJN9kVZGdwCuY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiqMJm_e1EzdrR70o9lMwXdZUy7ySqzBQf9WApfhUzVQ&oe=6B084304"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": fa
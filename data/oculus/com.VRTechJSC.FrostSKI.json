5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPguMtuFeOcQ7kNvwFmQeCc&_nc_oc=AdoZAS_bcVUan7Q0y0qnm7qrMPjOh7Nm_HDSowUWe9h1Xqs7V65Bq_OxTyZoIwHA9QI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBwCTWkE3ugD49yDnd62FuJ4RNSyxp2ckyv9zqP6-tgA&oe=6AA5426A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41agQCzt1J0Q7kNvwElbWe6&_nc_oc=AdpH0t6mLXnpiTEBgFwh_1QoWagYYDjsPZpK4Zc3M94T3uWBcfa_VlkbRi70OpcLCSY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHvC8wCne0UabU6Ec0mAuGh8xA8G34mGhClKiVZeAV7Q&oe=6AA563F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbZcV9Ea6u4Q7kNvwE-Tp1s&_nc_oc=Adrtl50DNDv2Apn4EsKSWwhs9nSq0F4veZNMWjU9grffdigudyiUs7VFQUbbXKI03Po&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpoU9AFUqaHWInEPPyHqP6mNiTP4ZKdSXOAupkIa0eCQ&oe=6AA552B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAXCzehf3ToQ7kNvwFgyIot&_nc_oc=AdpbtVEsXC9VbQ55pOBP6GpOGGqFVaXFSekn_JGDPEdpMDjOvSrkMMqrF6ELWA8tOuM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpMvHkHgI1aIROh0SJZ5UXjnCZKO8lQeFDig3_vSJt_g&oe=6AA5703B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HylhiTpnHkQ7kNvwEcc5lR&_nc_oc=Adr6-eXQ8PXdgF02wws6dN-xwsqjRT19OG-dn8xz8zr1Lh8viRLRkJKPQEEh_TlvPAo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuEDLf67-7vsRH2z_HhOqu46RuUz7eu30mPgAX7MmBaw&oe=6AA5596E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
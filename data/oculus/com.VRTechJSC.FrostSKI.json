mf&_nc_oc=Adp7XAXZ2wwDlTkJLnUlgVLNO0YKhPZxA1epAohpOFvHyh4aFMLTd3GHhlagVwCPtRE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2vFd0weoqvIiL1SPlqVQl9h6zGDFrKWxuo-4LE1vjqQ&oe=6A5B6E6A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNOdNUIPKYAQ7kNvwGU82kt&_nc_oc=AdoTVewY69X6jTaKzNzp8239UOfR_gXGqPSwLROVfJ53ks9bfx5HahJni3rRnNzoFB4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCU8g7X114W39Tbd7Z0DuK7AAv4owFmotkqK3SwVDT1ZQ&oe=6A5B8FF1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_i6KdADiDEQ7kNvwHUXqFV&_nc_oc=AdpVRZ6rBRSo8pi4Vf2Ux9s9mX-C7BYFcb7Arn1smVkNARVey2EXvT80rVBbWblM4CA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANmPwzeNorYLEGjRmqGn6RbguA8PIuMQVShjQjGH1Big&oe=6A5B7EB6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdD5yb-PcxYQ7kNvwF26OU1&_nc_oc=Adqcpkmn3P_wqMkkmdz18rEJf8a2wg8275TASG5l_P5iAW-uD2A-mO1G5nUbHpN4nCo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsXOQPW4pwF2QIrXD4frOdVOV-cRlSuOx64UwGE3SQAA&oe=6A5B63FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfSmG6_7powQ7kNvwHiUjCg&_nc_oc=Ado7tP2U738k75wfN-1D3seQ0lldsd6-Agt7tHLv8fuA5Z3sWMabXXfb2PMU0DIfrHQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjqrfKftlZG0QGK8olMm_nvsGaFMYNI5GB2ZBLa1ongg&oe=6A5B856E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
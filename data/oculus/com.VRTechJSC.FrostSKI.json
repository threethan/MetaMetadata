tSO&_nc_oc=Adqw4nul4TtoCpUzEvPznz84AsiCztwackGns-hCaF8f-eoenRYxNZ6U1NIbKtIFrno&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbvWVioKSo-9u-OagyGdmx21LyylyOciF3dJcgvtsJrw&oe=6AA14DEA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noG6wDZgGNwQ7kNvwEoDQb4&_nc_oc=Adrskk_Zm03IaMLol9BLcM4RvqcGV-4W-YMYzDbfhAfzoIM0kCbRlTvi_EPoKrLLAgg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8xHbzl3ckDwEgBO_yskPLrZKNvPMXSRw6M7y9768sGA&oe=6AA16F71"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jRSytq429sQ7kNvwGDwcY5&_nc_oc=AdpLDeBMPI0QzcWFjLHDHhIZ17mbAc30_QlQlputNWq3G08-kDXiKcI2itMN5q7Z6GE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfabrBgOdZiPHfRllkM2tHFIbVmKoJvwiR3TILJpnYhw&oe=6AA15E36"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQ8kKoBF3PgQ7kNvwGOcr15&_nc_oc=Adr2rcZ22sfQddaO4MR6ygGFnPNVG7wtoJvVJoAfa8k25Yyv5Ws_edoXKh33aQMvgho&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIs_Icij46Xd2c9GGT8dR_z5-6onyj3tnwEbVe1mvA9yA&oe=6AA17BBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afcgOCoGPTMQ7kNvwEncOBc&_nc_oc=Adov3TAohLP6i6xSKa7C6iBoAkpWvuruAGdxzutcRugB3ejsLXlM7HRBrbKX3IZ2sZI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLb4x-1BZDxf0of8W3tlI0QPtHLaSKXszNzYRoQhCGiTQ&oe=6AA164EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_
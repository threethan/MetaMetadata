5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPguMtuFeOcQ7kNvwHRe8ll&_nc_oc=AdrTBNmeuUZGjvTxAcLD2g1uGW1tZD_8xzwVXZj4TdYXybghbwVE5IX7YVdFjCSvDEA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtg-Jzozj0XBiEgGluvD8TdQjPLvpMUGNeLduhHIgmsg&oe=6AA693EA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGOD_Q0RiscQ7kNvwHBluxY&_nc_oc=Adp2XDK37Dot5H8vbFt3Po_sg-iuevbKq5KebBFU8SPh9qNFeciWOg1ubDJWR1RdNyc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLausuWeDoK0IYszvOj9I1pRxOAiUewBO8GuqyPpYVAoQ&oe=6AA6B571"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbZcV9Ea6u4Q7kNvwEC5LVC&_nc_oc=AdrWUf4195fMqeakBXAJnM2v3AJDmID2nDW3ndJByzbvd4zLxTL_E-aPGTBXfioBlVw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtqBpf_u0IT7UHMs0pRP2Zwu8Y4YJXtFiejGeVmAV85w&oe=6AA6A436"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlH3q4ukKQAQ7kNvwHsJGQ7&_nc_oc=AdrlxjOghe0BLuGk6YBi9wZKAuJ9tZcLOs25zn6jDyndXFcrLCpf1OBWrcbj_OsNlxo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVogq_KfW7xbRhfMCK6BaEHUa0mES5EEXjx6mCwfn-0g&oe=6AA6C1BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HylhiTpnHkQ7kNvwHp5hfi&_nc_oc=Adq00wsW683rqgZLfKuyr0rSw-yLDJWoMuxON2dtwX4Z_Vyjsl1rvMYWbroGbRz7ffg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKY7rfPJiLBL8xMYeUZeTIUi02bABgasLrQhOtFJI1tpA&oe=6AA6AAEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
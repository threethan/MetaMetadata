Yng&_nc_oc=Adoa-GyaR4k2d23AeFmRTVGKpOBpKehDM5fdKE4f4o9yWdIhsx1unYTp1a6sSQV05J4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_4Aw_VMQCRKesSqj0KCDpNA5ILWjIGOCB_xerox8ACQ&oe=6A9C402A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reTWnGR-YuUQ7kNvwFjIDkO&_nc_oc=AdpQ0zZU0cO6wQISNxTrRcjnckd8ztWbdpywKucu0OH8KeD7Ia6_FqVHGDm9gbArWZs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnUNFykMd2sBytiK5GVFDQ44fBf3mez-toZaIVMhLvwA&oe=6A9C2971"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwA-BjuedUkQ7kNvwFHlHaA&_nc_oc=Adr0VgETrjwGihU5fYc61aUr5hn04UIexqzBQCY7yFfWkzoICNWNrJv80oGxWBdhqW0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL26h-mu_fMhnmN9g8WZQkjxJQ3L_CkF990Fg6M7RvROw&oe=6A9C1836"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q28W3mActXEQ7kNvwH7fmWE&_nc_oc=AdoK20nq1AhklFrM-MBPr8-VJmxaKv-S6eBlYmBxRyvMFa41luSnk0lXTpx-BtLAJCM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKcm4Z7jCdZJZXAmEnE-yhozwzYvW75VMPRtpSV8GgSw&oe=6A9C35BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwfvzhFY-V8Q7kNvwHK4uWN&_nc_oc=Adp0bBnQP-t0YfhVP3SZ6Aojx4NI_jGii49RCgbqwo8-m5mWpYgLBd3GHV8GnSt8PKM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSboUM70xRALbmK5rY31LBO849fVGpc6ZFcEqJzIkYtw&oe=6A9C1EEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_
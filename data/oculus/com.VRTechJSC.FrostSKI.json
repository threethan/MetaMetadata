O4&_nc_oc=AdoE5qR_WOUw6bWqAGjUEogI1AoC0jio2egtOqhPr51uPxnaliCaCIzihJDJfMZxWHo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RymFfRfWNOUSObXTQdwa7dnZ-fovnGlfW7YOsAeDQaw&oe=6A1AD4EA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFAxQR-QWt4Q7kNvwG631dh&_nc_oc=Adq9F16P5_-D_GaX8sKh4GQMfCgUTt1YLsU3NZqypy2R7uLhSqk12Ozqry__D20XJRU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43vUjyJq4FNb6ZcMGbV113GOky2GHymX7jqniYrxEBHQ&oe=6A1AF671"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pODgJTIgSWQQ7kNvwFj2KM2&_nc_oc=AdrtXRukx0Xpq-kqyFKofOx-lMIF0QLU5q4H62vzNw71kOd-xf0dpPlszN-47_m2xQU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70cUVZ3BuNwKlTWfbkQZh9bPceMZ9ej16SQE2JVMGE1g&oe=6A1AE536"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opHFbfilzIMQ7kNvwEfpUWT&_nc_oc=Adqqqz5Oxos5taZ47pP1Hli3KVoJevbN0Urvev03a2jBYcE567QNmEVbO1rFhRbtKGk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ff7AYrsjsUEi7phE8I_HVXsMqnjVFtgqJXTi2bdCLDw&oe=6A1B02BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ha0odXzH24Q7kNvwHkirzg&_nc_oc=AdqnmQrECJV4kXktZvXgUV_EuB-GbrWgAVHzkB6D4IdrnQD7vmIj4a-4tqHu5Dax2sU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yqVDQW1JuQ6-A_ya1Pt6mylFLkiBSZQ4klZHUYXbYJw&oe=6A1AEBEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPguMtuFeOcQ7kNvwEbCbep&_nc_oc=AdpkEnvqwGz0YE98hYKj0ceYhraml04n7pEjCr7AH5JPlOokO8w2vdnE9lW80NsYJGs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAfxuHt7_Bu4TolF-Xr9TLu_nbJqb6LKiVyjkmVIWrEg&oe=6AA7E56A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGOD_Q0RiscQ7kNvwFzVaIk&_nc_oc=AdrzXVw_lM2B0bzvq9cNLq3DRU4yRhzihH8ftETtToJkz8oo7hjhg9w_0oSJOiuhyjs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICvfVE5tpZUYolPSGWzzHqX9qNZp1OKZ08KOI0M1juaw&oe=6AA806F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzESi7HNkS0Q7kNvwGEGogP&_nc_oc=AdpQGUgMFYnwn1nrSbfrgvkn-NIoZ6nNp9Q4Qc38Z8XWglagyT6ZauJPStZ-rKUvy9M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyqw6UcMgBI-umQr2c92GLFcZOa6gEsQD8BbEeHz2Ajw&oe=6AA7F5B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlH3q4ukKQAQ7kNvwG0Cp33&_nc_oc=Adpml41L3kBjmMG1rARLi-Ekps5jX_1pmREelUYoFQyXzXLXUe_IOJEHr7B94AFQSuM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJspsnOqtQY6L54e_Zi5rSXnPVZ-uW6F_Vp4mAHUkMYcQ&oe=6AA8133B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HylhiTpnHkQ7kNvwH4J5lU&_nc_oc=AdpDX1VfU3RuMSliGHrUdBJwXpNphEeN2kguN5FzQDg2aHZNR3rfkwFjy5AmAkQ_auk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJq9ncs-QAZqeHSmzqXdEAVm7waSJtNpJWdS3NGnxGL4w&oe=6AA7FC6E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
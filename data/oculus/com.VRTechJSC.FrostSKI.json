5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srLrtv1idt8Q7kNvwGDqAUF&_nc_oc=AdrB2wf_cPEP5d7GHg4RuXR8QW7sK7tN13yewTE_PKRkAinZKJ3rwTGs6nf0Wq6LqcI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCAQ2C4YxU9ZlCsVyT6D1iEYu2oVhFgknGHrhUF5rKLw&oe=6AB7B76A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lZe-4qqfSgQ7kNvwGxDce7&_nc_oc=AdorWfaUqGlDJ-Xn6UekWN109znBsIgVSHlCjnk6QClUM4cDW0MyVx8Yoo6nFrLmXSM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnw6C0QrIlHCkHoUPRDs-Sa3qSqg4qo2LqfyRRpY2SZA&oe=6AB7D8F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iY_x5QBsi2gQ7kNvwEL_5S-&_nc_oc=AdrES3K1xoJuICZiPumq78nlofXXByMiJGIQBpubLrwT4BZiMYtxNDDopZas3RWAdl8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiWksAADijK0O24oey4oOXDNNKo4ep3v3Jdz4e9ams6g&oe=6AB7C7B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7U_KLceaw3QQ7kNvwHFoFDv&_nc_oc=AdqcozqM5e68r-XE_w4QZzsVX2NsGLWOsv8Aq4swOqFjAMDCidC_pSbE6wQaJ2fGOYc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKjuaNdV4gFfJUCpatWYaGncVqxdQVikWl1zrQkd0GzA&oe=6AB7E53B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m086QsZ2ORkQ7kNvwHDgpSj&_nc_oc=AdqHV27Mi-Dg7TcM9yQiQO5ged2T4CnOAhiKfK5N3M_oDuvR9k3lKQItLH8NZDeFncY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDZ4pcWbat8NQ36AUyh-z659IqOzF7gK5UAL97Oufp0g&oe=6AB7CE6E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
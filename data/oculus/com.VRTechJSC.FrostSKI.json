5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vDQZXQ_DBgQ7kNvwEvn7tm&_nc_oc=AdpmNoxo3Cu74e6fCcrjrl-f7D0-AeBq9ld6Ti4vV7kPf9XcOMRGMYAipIXOFKL00cA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI16yNk31QWHVbUynn5ii3JG8J5cvv0IFdoo1YC6qFyJQ&oe=6ABD35AA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMUFVx7bMLUQ7kNvwFr8j7i&_nc_oc=AdrKuyfGjCz9nz-z7skiZLlBdwgJoWP-fwOKZqcCXbQmNL5_I7Ebz1w5b770LlLL3I0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSeGKRem20me7NVNrgThe2cX7Z5NvZ4TVjgSWGDyvXvA&oe=6ABD1EF1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YVm5aum7yEQ7kNvwFIB_IE&_nc_oc=AdqnIjZRqRHBBC1W1Pe1hG8dfWarXHVtY9tXrIw2zdxuau-hM1JG3OoUbdrkSAhCcaQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3krD9pQo6xijn_wlDbzs83DNGcY-xIH6LHELNI0C6Ag&oe=6ABD0DB6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5m-1iOm8GIQ7kNvwECXzvE&_nc_oc=AdozhpPNjIYAxrkef_tsHwwUFNM-amCweBX9tXkRiPDoSAlUJdt6eqPBMn1sCImHPo4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvOTjSellM_X_LnVRHAAD_sP3IMzcQGckZwP-TMR8GTA&oe=6ABD2B3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEppLVEvFdsQ7kNvwFuo9ge&_nc_oc=AdrVEBD6e_vsCctXmLq1DjtK5cllV978G5FsMysSeSGteJWwBZlTTP1-bxdecAGB2mY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIviV9p40-2ip0QEmWyyKUH5paQgcP-sUN9mMZojE5Ag&oe=6ABD146E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
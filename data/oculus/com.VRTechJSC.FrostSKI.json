5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuxeREjmftkQ7kNvwFCMFDl&_nc_oc=Adp-0GceNHK9-ev27DWCs7PxAbZrLScvMM8tJbyUQVZTg-imzjZP0WfCfsWroqx3Z3M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3q0U59yPT6iHlD3EoO2m6YOhBbOwN-n21DLsAuShjvA&oe=6AC27BAA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8K2ftKEoAEQ7kNvwGjgQfo&_nc_oc=AdrC6YVTjXONvgnIBBq-0Nfo94lVHPSKif_mhjtzQ0yf2tMg4vXEgzQtsrWMtl3h67Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOenkYCNVAcE-8ipBiCP9GrkbD-8y-3fwc50U1C8BeoRw&oe=6AC264F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ml0GiFaMB3cQ7kNvwFkyTuL&_nc_oc=AdqD-RWwbq2pKv53xmYNGh4SXs-IxQzw03Ck0MAIQ4D6-99FJBeP6q2MvzXjbTK8L9A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbLJ89Fqb1hOY3q_R_xd_UnH3YOlmnnNRBLflya0NLZg&oe=6AC253B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHXScAXhgBAQ7kNvwGTayrM&_nc_oc=Adq16xxY4dsHxhuaGAPirSnF6ujt-R0wY1bIqzVpbGh6NQgZlVkfp3ho3X_-PkLGjOU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9PXl2YAL6Lt98GzmIY8aOEIbtJSomSUz380QN4f_Epw&oe=6AC2713B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sX1UrnoWmtIQ7kNvwH721nA&_nc_oc=AdoiFHO2zaxWCi50HqJTSujcCLApCOjxT0Z0Q8nmnOoDLsQeuT8yjwSqKslGOgevyLI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIYVGcjM_Ydug9B_m6wX4UizbfRGqjSamwbxPwWF76Uw&oe=6AC25A6E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
pFIg&_nc_oc=AdraRUzmFbgtrUpj_l3BThVUMlXKiwaIhfnKN-KLNvOKOAmFbhKHcpS4Qnzf-c33Jac&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XyhkhTPS98kczxezq46sPah0fFiLCjsWgMO1XYFVrrA&oe=6A468EAA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wySYMLlY_wwQ7kNvwE-sFmD&_nc_oc=Adon-Vknw8yWpWnYZvuQ0dZ5I36ofvxnokcFRu-crIIPuST8YDTD1NhtXC2ZkuG7tYM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YyR6isXaZg-TvowTfhzpSqZ42rn5o5qV0R8JtBlsR8A&oe=6A4677F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nupTbfYG2ZYQ7kNvwGKiClF&_nc_oc=Adp9eph8oF2B2jCVLyViCd35ICEVriEqCtF0YSVUpfelkAD8XQKCnfCu1HQByS4CuiQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tH12o28nHgYOGzAiiTs-mWDvgxQaNYjio2ZEAw0XUow&oe=6A4666B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZnmxRAwYs0Q7kNvwFWziKz&_nc_oc=Adr1SrNav0qtu4aTx0ZBEGkXo9wF1yUZqqyChM6Tvf1aWOMNvh3rA973SCM4vMeuWNk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97pxP682NNP8eHJ9I5V767dTsT8s6lyvzdaZ9EJ0yhGQ&oe=6A46843B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJVDIahIpnkQ7kNvwEAlEAX&_nc_oc=AdrQhVqDZqMfE8QryHAnM8FN-NJA8L1GYzUL-dYVZz8__P8ijhv2LTyzEyzeXMqTYUc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QHeyjnlnzxVVLNn5-zPWMglZEXnFvlOaIxYkrEEa9kA&oe=6A466D6E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_a
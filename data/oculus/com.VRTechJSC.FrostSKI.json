fN&_nc_oc=AdqJTejv3UjTA58awSy2rFcdPyemHHFTiWaaRJccb87NI55d4l16o2cODLRJT1k-PWU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvMXdsFC5QSFKkDH-GB9Z106BHQYOx4npZylwI-_cEZw&oe=6A902A6A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQCIWEHOSLkQ7kNvwFsihSH&_nc_oc=Adrskxa_JMptVTC0-SbkGgMxoywgbiZ6Yx6r1ntUggWMjQKz5TF5VGAbVABciLwDX-w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbuFVJLwvt_Yd4jGjs5U4pvl2yBkX596zTe1l3qqmYFw&oe=6A9013B1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6m7WChjwr-4Q7kNvwFPDo0V&_nc_oc=AdqOH2DeUQ4U4OmUzT4mHUUbHBXKnJEy1PVUkGxS3-O86BvA9FyAUo2pL_ieCdqsjOA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwzKB2aaGSoBbYipkZ96-XyJI6AeRV8pTISmNY7zEKDQ&oe=6A903AB6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAwLlU35PicQ7kNvwHZKeQO&_nc_oc=AdoQ35Qy1_j2ZcHK2S-rDmQXEHacupurnC9uG5Qco2QSK6Tizj55XX1T3iv2t2YFJuU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4EQlghJJcHgZJ_-2l16V6IEwKVmFl7C7sMub-yvVaPQ&oe=6A901FFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Pk3LFl6QZMQ7kNvwE2JwIh&_nc_oc=AdrvQEWxfqzoX4cMpxDMJzPX5P9gw6ccLnCTwtVEc2hof7SvY69h-dCOZzLbHmq-se0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGc4PO38GLzB1lUWBGb3myMz8Y9xlS8DCTRUM6HuyRj6A&oe=6A90092E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
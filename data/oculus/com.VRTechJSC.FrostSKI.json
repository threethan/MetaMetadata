ql&_nc_oc=AdqaQv_GQw9aTDF5M9V23aGpzEUVcxBmyYSyd-yOr7OzTF0aEjRWKxs6uZhO7LlEuuQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vYVLvipSJBLnkiJ-kl4sAfLTcrIYTW-o8d0Vk8cYR5Q&oe=6A1048EA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SavJ9cdQJSYQ7kNvwG4LXZB&_nc_oc=AdptwwghQVb6mvcw1rIZxEAmAchHIsJjd3OlnjXI1U-0-kJDI8Qjcm2cb6aQxdyYIb4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DKXKuLSy8dlM0bNLASuYJ6_pr7Bn0uptqg3t-w0UPtw&oe=6A106A71"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01JwADYN4VoQ7kNvwEAvmoc&_nc_oc=AdpNn-RP1kN-sdfpprOG7W6yCDtTtgfiCeuNh7BHA_DBZOLe5wQvQejxq_qNQSrIjgA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73-Ff8p1XFgOo24TG5423o5g46TyVsL8DiWjjXFeyn0g&oe=6A105936"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFUfAq6yfZ4Q7kNvwGCnHII&_nc_oc=AdriEiaNXAbSf-rhOdZIb1_isZSaMDBhd_rkQMFWnKRJXqAtErAkwspZapMxtauigfI&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RJdi4wDQjN0j3g0paRF4-faVtyKdwEtvOXsC4rshiOg&oe=6A1076BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mHEo6SkRlIQ7kNvwE5mn0C&_nc_oc=Adqt8mmi1PwS1weR3UJSneQFMLvhkNbfQb9wniUyhfgPdKRFb9Y8apfWjyLHDscEeZI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hHlQxuS81EFYwfYQWdQKzoHgZjIn0GEXWwvYRBIHV6g&oe=6A105FEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
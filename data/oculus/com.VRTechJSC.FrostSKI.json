w2&_nc_oc=AdpeuKEGOAGWFZ-WKqpsHdBMIrTUcoVzOpN8G21hZDiIRUeke_lOB81CF8x1jDkNjoU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3WNQ7Ka-GGVNXx9PpzYzn6zn6b4-VAp-CzZXuRU3XH8g&oe=69F73C6A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJz2pADy4JMQ7kNvwH7i063&_nc_oc=AdpSFGE1_T43Dkth26YgnIBaj6cgcS4jjY84AYfO4suPxEor5u9enxH4IAtTiTlvxZY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3wgVURFQdwOOHJRB8q64EJO5dXBHN4QN_xkCYpV2s1fQ&oe=69F75DF1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfjDLt3PMMIQ7kNvwH3jNAU&_nc_oc=AdqnR7ziG3ARsmkWqElzbFovcxI4dN1f3CEbEb9RXuyt2DBvVkopaaOmL6nGw6w2VxA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2imI1x3VWa1SS5y7fXhMV6gYggBrOHSrJEuB3Bmowltg&oe=69F74CB6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tD35E7234oYQ7kNvwFFNMJ5&_nc_oc=AdoSi5nMs4ScwQuNU22Ry78FqL0iQqDw9Xfiz2CqZdr-ipuUcwINTgytczPHTykXF7Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2uJTGCmm-DteOfM-fcsVZ73bpkuTzCONJnqVoen67aHw&oe=69F76A3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDVjupLRGBgQ7kNvwGXY04p&_nc_oc=AdpQzIbBwejffAwX_T5quOtoS9w1Tg3NMmhcZWqq-y6UtlYSbumu4XEqXwYz77zzCWE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3tSP2niG5GsT3mNgSeSX1oMr6UY6JCeUjxX8o5iOzmsw&oe=69F7536E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
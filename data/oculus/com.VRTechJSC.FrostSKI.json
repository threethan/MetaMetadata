_Y&_nc_oc=AdphigYwu_YUrXncWD5If3aaPXN6SL5zMwd9zm5pDo7kp_mJrN9GVNj2CcnOdwu_2ro&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-l5og9TrvVUYmJ36zl1W9sm7BkZNAYF2ytKKaK50o0A&oe=69E8BBEA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyQ91vlWj3MQ7kNvwEvad5V&_nc_oc=Adqa5ibm04AbDRybXwjUTFe-NCh75NmE8uZzlrckVMNrQFM9su0WNiZyUawBcu5RZbk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1d18faHgcMMRDsoL3YY0TqwbAqqUXbGXdt5WA3qJbwIA&oe=69E8DD71"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3SXF803SeoQ7kNvwGZClMh&_nc_oc=AdoOsqDEjpOURWjS-LyutXnWQPP6qTtaTRqS2AAQmaapR5Aj1LOiOTFdCY7T6cOBeVg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PCpKK80mHR8AV_IpoFJf7bkRYThzUJgrZulkItQMHbg&oe=69E8CC36"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=91W1UgiuHlgQ7kNvwE-cnoW&_nc_oc=AdoymxaSKzikZVjzXkNRVfG80Q6AX2RhqgayEa8pfGly9_9UmL_cHyyPucky9v5tvlU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Zft2cEd1sD1-LcVYlhZDW9OfajG4Zo94cMV3SPKWmeA&oe=69E8B17B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GwiGKolTAgQ7kNvwFfjwWc&_nc_oc=AdrA-76dW-ZfXJ_ckRne6yQat44hFQZ2GvDfWsX_6Jb5mjixAGNMKn5b3IOTk9HF-ss&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2R2SyXdRmYUUnnOAxekkHNqdswsZADyt7w5ybFp7xTOQ&oe=69E8D2EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
45369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WX1YSfZYpOcQ7kNvwHgvk4N&_nc_oc=Adm3B35WTwx_py_5QVffawPgQpJNGlnhunWtkLzmFwcldhQygxbXkZofwwpLyVS7e9c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuXe6ZA0-Dw9Yb0G5D5CoefpXXQ0Zpb2YtG2BMrVxDMNg&oe=69A5A0F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7WBLl8BRgQQ7kNvwHqV0c-&_nc_oc=AdnkJWymlBkpLbDzeYQlH1dODHDJ52jDW3UAXMQJUs8ADVTm5vAMi25gy6V7-8G5zGc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsA_-HjiKEqQ9aVpV5LUtk8YZFgnC6abeBArZ8BjV2Sbw&oe=69A58FB6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Qp11LU48cgQ7kNvwEWOEsg&_nc_oc=AdmofAonxNWrxDTRO2RmubxExTQZJo5xrmy423vdnx2UmfK1i_lcnO_XftD_eoNCrDg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftszHCX3ghBN9Tbk6wHYRHbN30bBHfOpm10oHj58-6nCQ&oe=69A574FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjKL4jU7sZ4Q7kNvwGTS-EY&_nc_oc=Adkh6GSabSDMFQnQqBu_LvqMnkWNoX-RVjH0PZqc1Dcvj_4cN4HLFtSWcSO6n4edKkM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu1hq8h3ps-W1kNmRHlV_yF1wyMoR6Vo8pmz6jf4xJlnQ&oe=69A5966E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2539147
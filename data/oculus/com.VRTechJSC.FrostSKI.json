e-&_nc_oc=AdoTT53ZpA0RErH5hr-2pnzWEoOS_lVnml_gxoeezQSePScjrNcNelurg5Oi_k4B0rM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AXxKJuMhlaifrQwc39ruwVCljJCQv1xS-3xToKcvGWw&oe=69D7986A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubbpmd5hdnQQ7kNvwFG3Zmk&_nc_oc=AdpZBjMBpQxr0TsukBM0lpUQ4lOq8CD_pufHmJCSDbShtgiJuTjwXp_4wqTZ_iRUyOQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FArwY4VDLAyhbcAo39dTvkk_wkeJ5Z83JvZHb30JOXQ&oe=69D7B9F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIaRuBP_nUsQ7kNvwGaZBnT&_nc_oc=AdoK_YtRcCRp-3wEG3q404_resP6W719tkCwgnJ33Z80Qleq4x0G9fsLk81y9lOvyDQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0W-PFRr2KP11RDN9NEe-gCCjBwjb90gLZDCT95BfDYmA&oe=69D7A8B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dS58fVLhOO0Q7kNvwFZll51&_nc_oc=Adp0TxU4OjwozrpU1eJe9StkU-UB2dHa0RDfga1PhVqujscxa0uGWHXglf_xijAY6e0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vrERfCL4zjJNWZClQKTkmIySkkWCtliC6QYcZyjWmGA&oe=69D78DFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBYOB00opBgQ7kNvwHNIt_Q&_nc_oc=Adq5lF4eCg5ojAyKWV5-s2M6oVqAUBugh-WnDw9PFRjOYUU-jZzoXs6Cd7VLmK2ndDs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af080hGY8a0qQ2ZiHxMIkI_NrimikpTXboPqCKd5fOE5Nw&oe=69D7AF6E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
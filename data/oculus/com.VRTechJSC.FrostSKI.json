-T&_nc_oc=AdqgySIRnQgyl2-uWgNlAQUjxtzyA7evx6DZ8-0SXyAm3aD2pMnV7TE-iCBtAwuxNs8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHm6XJsuLUY9nuJ1h_fWJeaWFevxeLkscple95UOP2iYg&oe=6A82FB6A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZbeLLh9s4UQ7kNvwFQyD62&_nc_oc=Adr5c0xQvHM57zQ0qQY-dUYNwEVRCQkpbuciD87VzacFpW_x_luAFzo__htvA0QTLxQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXVgEyJhnP5yXPS_u8kVa_fwfx8JKU67FGLRbMHVq8Rw&oe=6A82E4B1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-Wfx8A5jxAQ7kNvwEhQyo7&_nc_oc=AdogSOelwG0QpnIj1HRUTjwpDXyU-kIgJb93RqQ2RTVidd4oGyAR4l_7oviB-xcJr6M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6CEmi_tJFf3wh0pEnK0tIH2adjqmwXg2PN8nE6cyJ8A&oe=6A830BB6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Je7UIHsb5IkQ7kNvwGZw51z&_nc_oc=AdocQeC2uwyA18H5O2geCLKdLlgjF54L0Jj9gXjUQP34s2agajFCC7ZXEVVecFJockk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8slquaSxyXvkhsEaYfG8ksPpAHRGSvFRlbDadPKsSLg&oe=6A82F0FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxLORHgSWfkQ7kNvwEk_faO&_nc_oc=AdqgeZs3koRNnbgcGr5dwg4Rc6jN7sqv5NT_cx0rV5H263T_MWwVVLpjokPr3N5MLAM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2HSeAizdUzkTI7AnX4zBIbjJsK447rdufkFAUfQY_Sw&oe=6A83126E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
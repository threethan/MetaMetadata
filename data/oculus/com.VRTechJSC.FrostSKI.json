5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vDQZXQ_DBgQ7kNvwF3TlsV&_nc_oc=AdonhQkt9Z8bAvNzVXVMHKpHfuNq5AxS-vzRbtrLtaU4W7qIJJfBRpsiFsIpBoxQ9Y0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZOh7Kw3l9u8a6rxy8PiSWCTD59gCl3BAak9XWaztH-g&oe=6ABFD8AA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcHHmyCLzr0Q7kNvwFoOENI&_nc_oc=AdpyP28p51MLf7p0tpSj19n8DE4Ia4i8v2EEhriJFYQOMyW2uqY0PWRkj1AItxi2aqI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6_3xb7FLygQ_7kIlC9bfVT1-PvCeogfQCzvQE8Dy3uw&oe=6ABFC1F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ml0GiFaMB3cQ7kNvwFjbC6H&_nc_oc=AdrakAOMyKAjTqFGUZeMLil4jRCCjlILf9SNVlmJYS7u3cfpnRS-n6noVeteVcVHcbc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvsV3RoHQ-wqrht8NcTd2bL6LGujBytbWC-iArSGNUkA&oe=6ABFB0B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3jIHAt4VK0Q7kNvwH-PONt&_nc_oc=AdojhxfRf9XSDamzRGScaTdCqqZ_GpQLtcfo9MRDO0UvEVqpehAD8lMw3fIRnuv2svw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDQYO7SYlaWegWHmuxdnqVLDYsnqrLo0XjkivTa64ktg&oe=6ABFCE3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEppLVEvFdsQ7kNvwHdxcGd&_nc_oc=AdpQA4kZNDJGq_HX5B5h4GvJZVCXR3ic2K2jVZJVj6QAqY9fowSj1rIE4lDtmg6RO7s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxL0DFy8CP81y98UV_fPHorsDOj0MhpImDWjQDSkazwg&oe=6ABFB76E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
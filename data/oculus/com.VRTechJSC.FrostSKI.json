_u&_nc_oc=AdpL0AkD9e8qTphPMJ0yP3v0ramBM4lHHNZDxz3Bv7YJJvzpTKA547Opp7C2mD5xceg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1naGmsb85t9bI_PdCQV17EUO5BOhs229X4rs0XxuLN3w&oe=69D4F56A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubbpmd5hdnQQ7kNvwEgI2Wi&_nc_oc=Adro65QUBG6Uyt9r6y_h9Tu0FQMOgiA0H25-6eOmgbEE-fdw30ZazM-rWw3pYtfNzeM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1__KcQPT13kf5PEXS3h3uS-1L4KY6Nbbae0Srw0kvlzQ&oe=69D516F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MR1iqm3mxwwQ7kNvwGB8nlH&_nc_oc=AdqnlBAwL0qTvLXFRRSSUfoYGV-RkkiDzJYSNFm-JLDiFREEkmDNi1GzFtt0qwhQIrg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FSPQ2uk5t6sfvb6xA_XDmp32pfvzZyhqRrm8UhPZnqA&oe=69D505B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dS58fVLhOO0Q7kNvwF0i7OZ&_nc_oc=AdoNzRIM3QlyzpHdqblzTSkTMf7y7wR8h78gyo13rEkriiZ6B0wyyxIsUkaRtQ7uIMA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-MY8XQUEkquMGZHJK-P8LCyyR0CDR-WnAJilD-bPF8Q&oe=69D4EAFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wtt1ZapnvmoQ7kNvwF2Q0tp&_nc_oc=AdprFelnCaBOEiST4w0l7L0zuiZTi-BB6i7-0TY7gHeH0Yu1wrKzBE4w-TyNObF-MFA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14B5HvshUImpGtq1-jgS18wnuEVOnicRxIl3TRyYgC3Q&oe=69D50C6E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
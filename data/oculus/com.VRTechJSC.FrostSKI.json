_x&_nc_oc=AdolBKYb87_yPj97YtCOY78-H-5-2JW6tdIWHGxno0YTHuuaBHTTzdzZX9hHN2Z9QIg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qPkwYDbDdQA5eMqZpLnPbGarCDvKuAK_VYo9YrZl9UQ&oe=69E76A6A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFB8v55xavYQ7kNvwEHdee3&_nc_oc=AdpRYB8U_4_VJizlImN6ImWeHn1FO0VlC1ckQcMpYUHbDbOrclclWGXGzy81DqB3XUc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PVre95iSJF8SxOXZv2p94zqd8UhYe7Jxo0XZ9uFMKvA&oe=69E78BF1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3SXF803SeoQ7kNvwF7UbUr&_nc_oc=Adr9bBWpB67I8UAmAg09s3w8l7Y8vLpWIeeNICTwiIP8zBaPtsM8tycDZb2CXcOpBao&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ASHWXdkrtvOTpdOfFl3799obhYzzrskf4knA4tfVziQ&oe=69E77AB6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_bbn0Rs4NsQ7kNvwHg2F-N&_nc_oc=AdrbJc4ZXJikqNSTZnoF1PRFA70IAH0kC8XfaIK0wXZgBsMkl5c3E_vhSQ32jjH32Zs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HmOec0UoPhzP9-PilFXtnnsFQSD2x8zPCHQseB2G_VQ&oe=69E75FFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GwiGKolTAgQ7kNvwEAM4yp&_nc_oc=Adp-141rte-KyQIhs-0iRsMsbVgMkH7VybesCRSnXSmPCtPEDc5OzyBamIJZTeTB2yc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1R-JQtqM2dGzDc_k8d98keqbAXslW1J9C3TwyzwGbqMA&oe=69E7816E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
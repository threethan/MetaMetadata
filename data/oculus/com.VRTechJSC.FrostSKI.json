5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vDQZXQ_DBgQ7kNvwGKezyx&_nc_oc=Adp1h2k_S6DSHa6xqmpvI9U4ot1If9iP1I5YpMTBmi5XUPWFv4QBE01mvKNMcsUGUZQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOxwhLFLokS1MFWY6H_KZVIieEEyoiEXBrWYBxG7kLGQ&oe=6ABE872A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcHHmyCLzr0Q7kNvwFGhWjH&_nc_oc=AdqQyTswsgqC1GqNneyH4sCrIuXORYlzoM8HW1HGdbJ38hHnbe1Y0TOpq9_ATyuPC6U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKj2-0TMpoV7YddVClRTDRxUPOsW6nP-vrv1ha5xSJ5Qw&oe=6ABE7071"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YVm5aum7yEQ7kNvwE6vIwB&_nc_oc=AdqJGnNYJMYHGFzksCtyIQEq81iuit7l_WQEb7ivP-yUvtRKFWaUG-znCHMDM9SZ7kw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUPXGsJoZLXTYXjBg8x9G1Td5yMijA4-0zcMT9OSf3VQ&oe=6ABE5F36"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3jIHAt4VK0Q7kNvwF21vpT&_nc_oc=AdogKG7CjrE0R_aoJiWky14byUIWjUhIiNnYGP53wR4iMXmkZ9MQq4Ie8nugnM4QpuQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6okamkiEFT8hfAuaZfcAxjP9__rZh8AFnaF87H08lCw&oe=6ABE7CBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEppLVEvFdsQ7kNvwGzLqeK&_nc_oc=AdrU1UMY8ve87vb3UCCjjc1MxzA6hrUqVQ20ho_d_IzyNcYjCFrZc6l9TnMryhWrPG4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHv4FEjJJGNFJFFcm_4p25L4_fPWod3e5tu8vrcv2zDg&oe=6ABE65EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
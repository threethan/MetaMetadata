NLfJ&_nc_oc=AdoYNMexicdD2sap9NnUeXV_d_sqpNaoM7fkZ39ohcMpYfbVY-ADm_BWH4uhqDDwkkw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJ5kFg22B2MRrqFSAelN8_mTAN0_6fkj84MVhywZQGng&oe=6A7DB56A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbFz8e0DRvwQ7kNvwF_2gim&_nc_oc=Ado2XeXKaQvDgCNit4tDLJV0AeWfg8hVDpiAO_aVRjvA-dhAGUls1lju6Tq9-IVRL28&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIQccxQymePIvGCctqT4cARyCuVk-MSiST-FN-_DM3ng&oe=6A7D9EB1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMsNZgbsUhUQ7kNvwHzLZ31&_nc_oc=Adqm_TL3_cDGRlBroHNsr5nAYgGt5I_mp94AePJ0cf899mUoZJT4iRnHgwFtARVoZ3k&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmkxljSNOUisJxrl1W2VIR1u6OW4HRV7bgSh_6tjFdDw&oe=6A7DC5B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVnQ610qm14Q7kNvwEcLcgL&_nc_oc=AdrXSlfEHqbdSSlCqxfA1yy8shLEOYVPXAEvzE5w2dpPloVhfWWgU2T2JwpeVv1sah4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLqobANRICSEHi7S0SBQB545Dv89yiSvCjEH84Z_WOrg&oe=6A7DAAFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apAUZGFKB9YQ7kNvwHwDV8u&_nc_oc=Adpol55t0m4tnUwYhDgfWje5PRsmIs4zDJkxWGB97KHHIq3a9XN5N3jes9ESMxCybCw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3tfjlVxI4et4qEI5OrYtHoMNJ3yFNG7NfNnIxrAAWLg&oe=6A7DCC6E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_a
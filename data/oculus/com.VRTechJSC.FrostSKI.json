5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Y8NAnI-PNMQ7kNvwHmvSk-&_nc_oc=AdqC6WYhTpmhKl3B94-znStfH8pJcaTZ4Y3Ee6Kg19SjmKl7zC3MggqLoBnmKFXUZOo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoNHunl1hpizlam9gofwhEQe_0tFeUIfgRxaW0kwcnmA&oe=6AAA886A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0TXWRn6FFkQ7kNvwENxRj0&_nc_oc=Adpq5slbpbSB3NeTBq2cyJWtWrEVNb68rRfjk1Ip-GOTh8XUyUwx4c5rD_hhn95vhwU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMIvxwLnJZL8qkkdPRjW8vJ1kefbKCikniGkgH3c2DBQ&oe=6AAAA9F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzESi7HNkS0Q7kNvwFJqoKq&_nc_oc=AdoBQ2kRAvb6KH34Hq7WYiKyUSt-pzQFmhlvfnUX3TwZ5UWsQSekU7KKGdswtTKwhoE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaL6W4XtLx5T_dGOnObBajfwr0L4RudRKgvB3pFYDs_A&oe=6AAA98B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxtWM0UHAO4Q7kNvwEUjmXX&_nc_oc=AdoE7i0HabfgDSDI_b27TZGfHtPidtwh5hNBWfguEfl0WcYXtdOoeG4XE5Pq1T7_Ptc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuhIym1WyR5tEdX_uYe9MhzETbkSjZvF9wG0V1Kf4p3g&oe=6AAAB63B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCAPr02hCosQ7kNvwH7nf4e&_nc_oc=AdqbzxaKRBe8T52hbuNCYBDtvr7qYf9X086-2uakfE21ycRInX5H_Yoq-S-Icwyklt0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIa-sdPAs1GWHjyFNChIhRoz4V-rTJpRD3iv__1n0ejRg&oe=6AAA9F6E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
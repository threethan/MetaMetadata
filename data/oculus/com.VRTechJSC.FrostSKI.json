5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=959psIoVyhwQ7kNvwHzWorA&_nc_oc=AdqusUTLC2xTZWxVWtBY4JI10X5nzJsOjKM8vS2b_SZdRG1JeI1Bk62MmWje0N0PdFo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzYAPni0UB8xJLqRpdzXIQj5f7RQlsEw-_unMOHXUV3A&oe=6AC7C1AA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwUCtCztM70Q7kNvwGKWi6Q&_nc_oc=AdpK38iZqgUNEFTsgW8lKkSQ0WvzJwgBRLawv6B7w6OCWuZSGbaffeubaRZBXLoyAZc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrnuVEPVMlYYxQ9yqczuC0HaTEaYC0EDScJdTCjPKiVQ&oe=6AC7AAF1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmR4U9gZnPQQ7kNvwHpkvE_&_nc_oc=Ado1ZiblzDxkYq_G1238kGT_sOsFqol6hoeg6tQTfx3wy6p78b2n3rKlSmsHTh7EmVY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuICrv0_cvb-QTDDGASyfs1HnlQFc2G4wYhx_dTY4kQA&oe=6AC799B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QL2trG7kxBYQ7kNvwFscSqC&_nc_oc=AdryIJ3G_ElvHBncClkWXdS6b3K4ey4Bh3h86Uhp1I1GIsGn3X_w9lbxsoQGSr6d8wY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeNqNukn0JkLejIAUkPNkioahvlnkVtmtZ7dHod6dSTg&oe=6AC7B73B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vb_8UPS91cQ7kNvwFOeNWD&_nc_oc=AdoZ-vNPDqKE-xWyXoAd4b75PudPGkuOgpmDWaOadABkJC2_G12ViEtPt0rGRSz5_Q0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNh6JJ_BgjBUv8J4OdHXF-jtJIJ5uZXEuCKGSE74NCm2A&oe=6AC7A06E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
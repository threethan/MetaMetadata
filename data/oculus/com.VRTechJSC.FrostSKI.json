x9&_nc_oc=AdpdZw09wkCNhLTGUD2wCG6UNlmYuz41LQ9CXfn56abYjB8ViE6xiJ1V8hHXGwpCN2c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gCGTmqXPNe0G9nLyGQvRHcM30IVGZhKYkUxJZxmsVjQ&oe=69E2246A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yooaWz4yjsMQ7kNvwH6Iomh&_nc_oc=Ado9DY-NpwMh0mUVlhxlivSbLxftZ9vr-2ykCCZ38zJhYep9rrFsMJb4TuXia35nbg8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZJFl0j-eP3gJCPDGm5vNTUDBDKROxjGRmVzjbje0Oyw&oe=69E245F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXQiHHIVSDkQ7kNvwGGBVVM&_nc_oc=AdpKdtqLasfW92f8dDxgllTQovQHljeEar_6QfZXk87VBESW13qMyzLLTw1MSqtsOy4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ig7WRmL37ORSYdTKJDzUtdL7MOvILbG75gAjlD179tA&oe=69E234B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqMdZE8LKvwQ7kNvwFXvKIA&_nc_oc=AdqpATrUSdnyCw3ULTLd6LoYxZCqEJD79pFHqJSwD2C8nyiK4qaltS974uPzVaSHtlI&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Zjjm8WJNkmxrdkvISNjLsUj88IgoNZAUFYXzv1Q97TA&oe=69E2523B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVbxmX6dWZYQ7kNvwGTM-jK&_nc_oc=AdrOLFK-OagyujmbXy_Zc3zQ0tgDdfX-Tk3g-ZkjMChgcmc0YeyxUtHFtoUC29crTCE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1v1uvrJ1fdXWFH9ySBJnq4ISgio9fjOsS6BavzvIDVyg&oe=69E23B6E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
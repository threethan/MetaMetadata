5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUUXxmvo6dIQ7kNvwGIxdAs&_nc_oc=AdoUpxUKEHW48SRlfJF3L8_V4v0cjy4h5bf0g6z85v-gJ5bn407eZizTctQ72KDdaC8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQ_H4Pz4gz6FZIfr1s95VxWcPQG00vLduPdCeZ-uJuTA&oe=6AC9132A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwUCtCztM70Q7kNvwEt4cMS&_nc_oc=Adqn1eYt2GKoQeZMi6iFooWPMP5eLZwSUWdbeNUiH8FIbhCDYqeT1XotF9ZAA8pdWcI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMq53f-4-WRQHqfLtkxHbymVPnO4lNARLxpPlgqK9REw&oe=6AC8FC71"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmR4U9gZnPQQ7kNvwEWWmZe&_nc_oc=AdoZ10j4mWoixUHysmrqZxouRBMTBd9N5wzKGJZVfJ2zpnJ--GU_BStMos9oO1RAfH8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUQrm2SSAhONVgpKhdzFcePon6XPtpdEYNUaWxmZDwNg&oe=6AC8EB36"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QL2trG7kxBYQ7kNvwGvdW8b&_nc_oc=AdqawaZYmUOszMzYK-rll9aEf2BX89ZD76Iq-OsoqOV6Vj1AITHNjGlv5mRRDAqcsDQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5J7958EwoBWiMU_c9GfxvXBY6SOxD-Uei0wcsQpgA-w&oe=6AC908BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKeUmiTScNYQ7kNvwHi00MH&_nc_oc=AdoUrOsx8yrq_Z1ZDBT2ucrl1chi_M3UEzQayZpuj5l7ymQD7JuMjZY-JuFW4ENeZdg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqkrdii2xCamD2cNb-OiCzBPpvo-Is1OrRzS2gT9yiVg&oe=6AC8F1EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
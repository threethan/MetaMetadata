ad&_nc_oc=AdohJZXKb__YbsXRPTTy0-EepL8WqHOwzxHW84y3719toHvhQGF_kWAgCWsJ2g37bxk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3nnwinu7YzyrnZxgu-8Id5WwlkgQjh_cNBKchIfoSDA&oe=6A771DEA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aH1MYk5YE8YQ7kNvwEiXAmO&_nc_oc=AdphQyad5eRxZffynrFtNPTv09Cxq5fiHKi-6cbJFHowwxACQnw12NYeNwZwPGoMFeo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEDJfLIaBs4s5apzggycC2n9iixm_d-VDurvMw1B7YZA&oe=6A773F71"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MY6Ipj3_9w8Q7kNvwGt4Z9y&_nc_oc=AdqC9Ajjoz3bBh7ERTBIfMzaXqKlFXc4FEJOq5NUvsjMScbhPL-gtkfC1w7bEszz-T4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVKiy8zwQC1Mk_oxgXPQb_P9S2jCLBAKTDhXbNfC6_Lw&oe=6A772E36"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CzKmV38M-oQ7kNvwGh8zyZ&_nc_oc=AdpeggDUabitaTzVxb-R5QNVC1LwbUvmaZP5Pq0YaFCIJIQCdu-0D7F6EbkJ9qP5PxY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8Va5ukSzwWxaaquJB_dEP_wpSL5J4xDkctCRVaNr_yg&oe=6A77137B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vPo1z7ParMQ7kNvwFFJ8MW&_nc_oc=AdpiYUM5rZYwiqn4M0QemveAGxjiD0JLw9UikHPzbHH3nYOq8M9Exzwv88XMYJbIJiY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnmIwHR4-7UM34IQFjDLLvOlO-qdQGdaDMwRFnMFJPOg&oe=6A7734EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
tJ&_nc_oc=AdpBqCl5kRUsYCjxvOQ3C54uWpIiHCThKCMO-rLTgYg3M5OBoIwTYrsRGV9W_Zuij8I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3g9-161GxTuavEof1cduDUjbik14bKms_NFYTwtYaYkg&oe=69E618EA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFB8v55xavYQ7kNvwF3PcCn&_nc_oc=AdoyRb6F8Dj-iA0fWp-HR1rcspX_wG1rzP2tsJEziSMAr-HINoqyfvykHOlOKG9qZQo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jD_4KYuqvStLzyMnOJ1zoWaweMkXxQvz1hqYOMb0FZQ&oe=69E63A71"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3SXF803SeoQ7kNvwGnihzp&_nc_oc=AdoW8a1skpbgrHP2-wch-RxTdbL1Al-i5IFAB_YbjC-nEC6jU2VJ8Poxo8u_tMNtp0k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MPqJVHrX2tgRrqwGEzWH-tsUZD0xuhQhmMZctjiQksg&oe=69E62936"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_bbn0Rs4NsQ7kNvwHQBtPA&_nc_oc=AdpDiGOCnW8Te7lSmaQ7zqFgLpu6eOU8I_yXaKY9OFKm6I8cFRAFa47zESHqAxatGAI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3X7pmyEZoYTJFhZm4JTlWJ5wW1WSCu_6Xx3jwZo4eU0w&oe=69E646BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkqAmHkExrgQ7kNvwEFdhQu&_nc_oc=Ado-0OdLMEXpSKdW9Yj4BtYBD5G6Dqmlushr-ftc-qh3Ci6wkNa6SBUfU_PvqnQ5zhs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3y4WhjRJpU5pf6gD03dV7ZEw4ZoQB5Yfavo2j61elgfQ&oe=69E62FEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
4a&_nc_oc=AdqqvlDnoIIiMNHGtcnjzL9tTqm81Ro4hY6AC9xWzU2062FTP0oSc7g5MQq7Pq07SVs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHWPKEwKn9kXWv7nNA3DotCxe62Wy-lBl9PYv8_M_Bbw&oe=6A71D7EA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvxZMbbRO8AQ7kNvwGVG3wt&_nc_oc=AdoS0dttKwuSEnge9e4DtyQf3p7mjJJbacLA0d-5vM1PDsDxpMSHy53HAHUSzrm6jes&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQ4kSnhCsfBP50gD4YLKyNFhASKdlGy9Pge9Jhe9f6Zg&oe=6A71F971"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4N7HIoabmOcQ7kNvwGUef0p&_nc_oc=AdpO-wVH7xsW6yhg6-LpAISMERSyjQbuLkIsdahAoOCUJcxW0niXrGzNIoy4TTS3Qr4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEe9k4Nz-wJ_Bv68eRQXF8KDs9TRW7F_skhATGVm-rA5A&oe=6A71E836"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcsCfbBYpdgQ7kNvwF6Sv26&_nc_oc=AdqdIzC6BkgclCQsv3G_lSIkT900FO0Nws6Ezf6iB56RkFoYLMwdMwLYI1YWj60XdAo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9sBS_8heGZIkw3SP9anu3xdOD_QI-C37eu6dJeVfGOQ&oe=6A7205BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hpn37rCx14kQ7kNvwHmxiTD&_nc_oc=AdpLbKnvveUWJhJ8frO985AdIWV1GxkIRNiW-Jpp9ar6BfNSGpgZ723mcf0MsBarOTg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3OtwSP0IB2UwiVl2aPNq7wvYb6SYlgTjz2k0_vwzQ4A&oe=6A71EEEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
_l&_nc_oc=AdpJhiOhtG6DaKOgZ-2TqNnU-e5neOnOSNgCelC4pikNekNm7ZhPQXDKmN62T-GFUEE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hBTMN3yVmahf0SHtgzwO0h0E3yrDiE0hhQCRthMF31g&oe=69DCDE6A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmMGHwpaK2kQ7kNvwEFsM7t&_nc_oc=AdozCwkT97nXKiI_Sq82hxH68HzwyK_5dO6MrIVhR0-qF9oJjCuV-FLOyPKsDUr6vyk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3brnUW-BPLxdgTBcO5ZMpruwcvIVxKpeuQom3r06Xtwg&oe=69DCFFF1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GeNRoljL8kQ7kNvwEb5xg-&_nc_oc=AdqFqRMA2EeS9tb8e7w9TGHTmPnB9o8zklWCSoJT5CPQ7KJxa9hoOPb658pYuA1u6E8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eEzY9FyRUOHWUn4aj58jN86Wp-xQQc01uzpt5OSbDFg&oe=69DCEEB6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNM5KC3XzDUQ7kNvwHue0_i&_nc_oc=AdqfFRagt9vPyKrPeULCUGzUP5lAIsJrQaQ7nhvG5F1zV2AOaaITt-5QfNIyNcfp9G4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZOsLH84mRjw6dFAGLif2M4IkMS8iG4X1kLSVGOrcMNQ&oe=69DCD3FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CehwbuTfptgQ7kNvwFzJax7&_nc_oc=AdrP1lIW8X2GuoGta84sRFoFHPhuO7Qc-WGzzTxh0EMCOCcWEmERo4zMNDBp2_pMZM8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uCGcl9x_bQKM8xXHIQj_OmFdQnoK__P_2gbj64Khbqw&oe=69DCF56E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
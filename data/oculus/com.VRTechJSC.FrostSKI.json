y7&_nc_oc=AdrC82yHSOKmfItRckYgDXD9vqjTKMBzptjNZPCcBtHEKf6GZg2R5KiAo9Jr7EPkFGM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96pDpEarwfmZAXQhW3PRJcN7qrAdCOU52IXbQdkXyBgQ&oe=6A3419AA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0XKNDafFHQQ7kNvwFWBNSq&_nc_oc=AdqinQTM1LPDxV2FBdkQ8sLEmPJ_6as3_kM5xeCBJWx5VGHgIhBNZ5BDHA1XOc7LfPE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UYxq4YLrDiNnkUnLcSysxHyMrA8_9-PY4Q0OysFWmjQ&oe=6A3402F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dNws9eJQp4Q7kNvwGuwZH1&_nc_oc=AdoOExVCaWgsQy25IYxnzq4AYLxXgd3VH2kYbEko-xytEgDwcAqyLduf4Go2QSXdLJU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rGoAadhhPFRr37RtPlLK2YVNQh1F18eDIw38SGzeCtw&oe=6A33F1B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SJz7li13MUQ7kNvwG-jRZn&_nc_oc=AdoDpgv6rXtJMk7dz3AsvjhlBfLBWLDDYJY3V0S-XJRfcEZ1lxsRsk2GtJimVWYxgDc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89QY5iq6i6iUp1yUfcOF4ZB-KUO1FhLo2ylAXrguZDIQ&oe=6A340F3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idbwqvv7q8YQ7kNvwFcXVCJ&_nc_oc=AdpmngoPwuYfohGtRA2Zd_4Mq4FSB45ensBiW2HWJbJkPrvSyansEZbgxGLYZCxJvU4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8K5ARpAxsvpU8bQZPVB4slt8EnCgCdEWtmUTzzEJ759g&oe=6A33F86E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
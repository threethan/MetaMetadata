5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=959psIoVyhwQ7kNvwHdnMq0&_nc_oc=Ado7Y2XUVFxlrpItHWseAIkG9z_3hlX4ZbLUK4Go26kDpWk1cf8sX6xDGpDmnOZTJLc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJ-682YIROdRyIODeA2mqyv0xLsxN1CGMT749r9vqZ3w&oe=6AC6702A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwUCtCztM70Q7kNvwHlEuFt&_nc_oc=AdpDFyNUdBdeUl5amoS4xx2_jdsS-01sXthafqaotAjZa6jjwI3BjJB9XckBUCa8S4U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRPJ_E_iNCULNe8ll53Y-wn2EwAuPDglumdlHQfZuPOg&oe=6AC65971"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_-gIRqCBoIQ7kNvwE1BGDh&_nc_oc=AdovdzA6IgKb0xs-fUHr-oBZ3CmyFkYZG1mQoD-yZlEMpZB0weMMyFNKrDOoaIPbnlY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOljgZ1cfAa_tniEfLgwBaHLD5TKgklteXBP2dbzk6wHw&oe=6AC64836"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QL2trG7kxBYQ7kNvwHCt40l&_nc_oc=AdpnndHS95JQaIaCYrfc7h1U4k_BxNMpS18Z0j_bfIqMZ-yHcdeIX70hGw-wVTF-CcM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMncd6omeB7aCwRa9aUS7bId73IzENrxKlfUpNoPL3f2Q&oe=6AC665BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vb_8UPS91cQ7kNvwF5slsn&_nc_oc=Ado4PCnyKfcHeOt3uSMt9MdpJP6uGWMsqcv4ZDGBEe0Kizd9xdUpwxm19r2-D10dTRE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_E72YcLRFwD5otVJ8kv6VWHYkU-589Ndzz2CzHTUIYA&oe=6AC64EEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
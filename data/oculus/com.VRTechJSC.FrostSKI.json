5E&_nc_oc=Adrcs1Sstw2KzogQcrL-Rvscf3dzO8mI04P1U1Og7pLPDOJcDjMJK2ukg6aCpb5nEJs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FXh1p17BHZ5vPEgiLq7wKAdkPJX0m4BE5irIjw5512A&oe=6A3BCA6A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZBmi3F07gYQ7kNvwER-Z7g&_nc_oc=AdpXbFYdgrYbj9iQfWo8-wD-au0EJNUo24pqTtj1-dp3kDZB0sm9cMBuHWmpesGROkg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99z5da13OGZDqtR3F7LRfbUp5ic80rh2wFuXur6LQ32w&oe=6A3BEBF1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJZwYxj03YkQ7kNvwEg_XVa&_nc_oc=AdpYMgphlZbYfODYffuWuFskhJyRP0y_tQwTfDkZHNObiU2wHEP_h93zC5PHoVmfiuo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_d935zvjDsXJv6tKWmK_r6UEqADAjGxZ_s3VbxOezfEQ&oe=6A3BDAB6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBVmk6BqgdoQ7kNvwFCX3le&_nc_oc=AdqC_P4nd7qCF7rQ9puQ_hMOJH8D7jfDN2ihKdKNbBwzXkaMZjB4wulAIr1J9zyaY2Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_q5VdvYjvRqfRaupWghGhyl5y8KYTMUZHrfDagv46m7A&oe=6A3BF83B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fe_TwU0dbXUQ7kNvwEfYW3I&_nc_oc=Adp6bDcWVUG3BknJ1Xoe9nd76vMJ-_a1sAsliWV0S2iRH1PzC_85yf-o4ikof5r7dAU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LoK085Ao_ImjeeMCWRJDT_f9BSOS35_dVFnFNtBVNaw&oe=6A3BE16E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
uS&_nc_oc=Adpwb6wTTtCkskSvNZ77Dy-t7e7vagAU-I_9mSmknwINRcZpBF0W2qQPyvPaplkcO5s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvF55l7h1scEp0u3tDCulX1LfmsQhsdvOl9hw3OI-wyQ&oe=6A8C35EA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9d3rf21fwkQ7kNvwFSAIxj&_nc_oc=AdoQCs_MvsZM2_FXh8pZku4_eK2sJ8m-j-PrHlMJQUBmPNnTc-EZQrQGyo9aBN0WZhc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdVk0himAkqbpOvUHEYmloY3aaLZ4iHBG-lj9blLqQ-g&oe=6A8C1F31"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IP2UaZxfuQoQ7kNvwHkG4nR&_nc_oc=AdrPEiE2RPi_CKxdUIH3BMHosP9Q-L7Y5tEk3qgqDa4NJLS-SEi7Yf-GyifxnDpH_5g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnapHBnqobSQb3i3vE89LTv0NMVnyvDXKbA_UE_9x7eg&oe=6A8C4636"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6Uo-24k9mAQ7kNvwGFng1I&_nc_oc=AdpvHLEzThfdeaktkw0wa9-U3A3qFuNT2VJ9r-0hLuqBn5p395MAWS2KVnx_qnwoAOU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHs4wV17oxStttUDIbqpRQis13EcHAIXo54CE8t4o5ZtQ&oe=6A8C2B7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0tFdTu0z9YQ7kNvwH6daSl&_nc_oc=Adro5onyY06pCBGM86HOVS6Nc7IguMMnBD-XlM0fuEd0QisyYO_RFB3ToIu_Uk0-3Bg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGx25M4ZO_e7kgWoCnjV1CldlQB-NCNvkffxLWJgRo6sA&oe=6A8C14AE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
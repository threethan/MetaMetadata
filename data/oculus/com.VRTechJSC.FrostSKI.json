CQ&_nc_oc=AdqVCT2_DRuDFLCzWuHbcgjeKfmYbv-KEkexMy0xsG-pIAHH9t2RhJENPnHo42K-Jjw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VcsauDD9COBXUYuEW_mllvMgEceThEDcu0ty35_83VQ&oe=6A1EC96A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYaGNM3fQKUQ7kNvwGTua2e&_nc_oc=AdoRoy8RvUvTOzg8_WUROK2bqRTPdiaRkZLNjRuNWBZEsS3CorxtC_agR0rMoEdoAcM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43c1xZr5iXhKzKOOQYjl-fUkqDm4wGKOhxr6Zrx7PnNQ&oe=6A1EEAF1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_zvhLK6Z3kQ7kNvwGLa3MR&_nc_oc=AdodCUgVR_F91w-dobCzuGEDjM1i9dJzg9zRwI_IHDfTm7jdNzhGpHcqHn0GpotrzFw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WSZSEVj8W5mgi8MDKXRrHLDI31ULN5nkbVqVNXM9JUQ&oe=6A1ED9B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUaU3Oeg75oQ7kNvwG9Y4-Y&_nc_oc=Ado9Ffu-fGGcjzKpHhPefxmq0KXIT_siY3xTiVHYh4tNCq5ipSX1GWQ49YHcR1W_vLo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42H5JFaoq9aMdYo5BM95E-7Z5Ymfj7MjDZaNc-6WS9rg&oe=6A1EF73B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAtVot8Ny9EQ7kNvwH3YyEn&_nc_oc=Adq019qza13zcE-OIzuFCTSWgLhVe9YFf_kBf0YNaRUzR99oLkXt6oCXpBG6IdT0HIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xncm8SHTKwmNPCIjzeO3bpQNTWPSae0l9VrGMmuI-AQ&oe=6A1EE06E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
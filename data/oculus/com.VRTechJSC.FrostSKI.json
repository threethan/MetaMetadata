Qp&_nc_oc=Adp4Q4LS1OVixCrq0l1NKKdtAOwHlNY0BGSIHY_Gitz-139Zwc_kaw6nqf7dJLJyyDo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Dw67Q95gjvi0rMyFtb224tgrj8-Ampb2-SRwvAGCNVg&oe=6A2E9B6A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdrxY9Fp-4IQ7kNvwENSIfY&_nc_oc=AdrOplZKzoUMi_PBjS7zJlTGBFb7UDjYk_TjTtCPNkGivlsxnUeMXC0VJeuVmZGR3VY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HQV4HZdizQyI1MYSF58VHYr9zVktjyWMwMFhZsKEjZA&oe=6A2EBCF1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTDVkLwDHloQ7kNvwFoxJDx&_nc_oc=AdppvlrvAREbUZ-C-PzYIpPP0Bs6YPnwQayZ6RYODR1FXRdZAehbbzQYnskpJf2dbHc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fr7KlIJ1rqm5VK54FZkjcmFpROwtN1k63nGzce3MbmA&oe=6A2EABB6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DkZv4kVDLd0Q7kNvwGGGQfl&_nc_oc=AdpP0-9ziMdooObDbw0XtIOFYBUChfOnCsZAgfKH7I83xKJGMY-9Q8yriUPUnfSIW14&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OU7ZoxWQ-lUpLALb-OXkKOLLUIAzgteLhG_VrQSnnzA&oe=6A2EC93B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbZQh3NC8F8Q7kNvwEIuFPI&_nc_oc=AdrkaZR4qd5U6Vh5nO6HSV2as2fBdX_qEzwgA9kD27jZW-tDrdja--JsjecBK58hca8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kSemme8zdPJgsKgS724esBlzoauqAP-xDQjy9tH8l2w&oe=6A2EB26E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
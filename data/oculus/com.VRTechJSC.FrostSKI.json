kNvwFzM2lg&_nc_oc=Adqa-1MLdMWQ8_5S45FB2VfB_FBFpcSHHhN47CzqRtMWwhFc59v4DowbsLFmKKVEDjU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqqAZT2QzGG3cTl2tyEZiu1k8tORYRhlkouSUPHedkOg&oe=6A859E6A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZbeLLh9s4UQ7kNvwEh2DWS&_nc_oc=Adql2fL7ztPxk9qqWBuPGuh4DXejV06IkphbbpauPejHtqJC3YERTm81lf18ZZ0s6AA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhEPrDvZBE6afSpXNJ2Dmmg5YLxLNu0Efri2A4hTfCBg&oe=6A8587B1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUGZxIiH7EsQ7kNvwG9dJkE&_nc_oc=AdpIiLjzcq6Bw3Q7vufSq2HhjOFB4WMs53ULEvpxORuov5U2WZXexz6_DxKmAiDDrok&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHax3ICvMMtSlfyLQZEatU-RtW0tV6PmANGajvYVkBmcg&oe=6A85AEB6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Je7UIHsb5IkQ7kNvwH00yx6&_nc_oc=AdouHtVc5IvK2M2kL1xRKOd7043PZVj4WKz-EQwB-v2VjN64-bmXRwzbqjVureMA8Kc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5i9uDgGr9zdVdDoHwfhkqGLZb4r0EWaTRXGavk65v1Q&oe=6A8593FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxLORHgSWfkQ7kNvwFnu9i2&_nc_oc=Adru8k1-_zNPyKyrTTeU_oibYjL0LJVYOVkqwDdRZL-K4v0J5SVAwYBcaUk472jUeh8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDZyEsxZri-4qmfntSqKk1oxXvI9E79MiJ2C6bciAw9w&oe=6A857D2E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "ha
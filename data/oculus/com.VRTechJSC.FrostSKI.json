5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnzF5HORaywQ7kNvwFANxs8&_nc_oc=AdoIS8q9LOrIi3JrZ5F8xnPVopsb3u_AO_UPw3VyRX6eoNYXYqy5RAqNyugUWyxCx3A&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqpP5KVGFxiY0UO9qIeIhfIeHa1PnYAL8oJsrkUO6bxQ&oe=6AF9DAAA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EgNyv7LoMgQ7kNvwFVfRi5&_nc_oc=AdqWS7IBNlJ7ufVukKkg8h-FX4CaE5jYpokpKFWtrw0FCXfdJVG-YyofrEFgtAQ71sI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWGPk_YxdnS4Q7eYpK-b5GlMbDtkTWUzLkN3O3_6dcvQ&oe=6AF9C3F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bD1A2VL4B3cQ7kNvwF8sXtB&_nc_oc=AdqvUiK_VHKY5KrgrZRCrSp5XeRC1ztPTr0zZAljHjiUHEtoa15pB6yreTJn7TjOS2M&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtuc9H_yUJidO7i_DRgJpUGC2ycxVrtHmPqxJLJaV-BA&oe=6AF9EAF6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJBpdXIA18kQ7kNvwHMTEEb&_nc_oc=Adp94OY8BMkWSLysyfI0MSY8dNlkmfSyaXKq-T0VTMayWRj7_NU8ilvMa7KDFnmutxg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU5WSgtMwx7UnscKC813UzMDfhdJgJn-vpGsQsmNmuZA&oe=6AF9D03B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3OcNEVqij0Q7kNvwGm0L07&_nc_oc=AdosGnIp1xK4azuPX6XeXYgwzOzv_6XHQQvGPzE7f-94A1VHvfdtRhP80KtHGHKwA40&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShnJBjlly5wo72MEEkMi49JNXvZNf8S_6kFs0GUQjqUQ&oe=6AF9B96E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
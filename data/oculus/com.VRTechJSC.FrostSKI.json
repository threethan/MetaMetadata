T1&_nc_oc=AdrTDeQLmYSuC7A8VXL8P1pZ_k_7uF2RIYL3A1_7mLjAf3WPq4JtCo979Pi12V84nNo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQ0mde85mNAW13KRe1fqDYIBjo_QKJoC8EC-PjM8P0Xw&oe=6A5A1CEA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReaKhqkBBbIQ7kNvwEMBGxj&_nc_oc=AdqWUmWMUKcVy9-knjKE83gDxgoyaO2XxdbsmKPTX3-gTbOva5Z9VdFmIMkDOh0-seM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpxgmMCv_RnJlrFQOXcSDsctLQ_mrY3dpiNSH3J7KmzQ&oe=6A5A3E71"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_i6KdADiDEQ7kNvwHulmIp&_nc_oc=Adr2DZ2WDKPBnciNzfPuZqDhBrfO2opswWexfCy4yHs7N1SR3VTJI9h4Zc3nZjHKHZE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuXGV2tF6JyJvN4lC9E1GJXDCSJ-3w-QkjfEsNRNKICA&oe=6A5A2D36"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gABenVx_iwAQ7kNvwG8S_rV&_nc_oc=AdqZSzApoiFfTGD6uf_ndVtUY02FyKy-6bMYrobRbkNWA9XDg-lK2JJ4FuY9v7uUws4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-iuxXN0g-5XZrFMLanr_zYRvWyy-zB0CMFnOsUtrF_A&oe=6A5A127B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfSmG6_7powQ7kNvwERPQPS&_nc_oc=AdpxkPNwU-U4fuByABew8D_KMI9CwemQVVWqNGR_hy7z_Cy6_Tg7yd5LlGra00ADXjw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAs39DHQ2L47jOepq-NVRW3zRz8UneFVISWTETCN8Rh1A&oe=6A5A33EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
t_&_nc_oc=Adqcsv7glwKyY9pnzbfCLe1fTMJJkwrKU7CUIj5NM_NwwObGHA8D8ORu3SO6oOq2QUw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC00Q5C-_u9w3M2A66ZI3itrfbQ9BsQb2UoYia2-8j2jA&oe=6A6DE36A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzI0XoEamfsQ7kNvwFCLU1X&_nc_oc=AdoxoR01xC6Hih0IQ2Qj9uNN6bhadUWKtmRwmlxyyqm_FAPVztX8XYp0A6L6zb8-p0k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCm3JQX_O4Ytf7dSYHWX4YAcm0PzWlpx5WddvDagmhdBA&oe=6A6E04F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AND6KlFr7IQ7kNvwG7yIHX&_nc_oc=AdpFnc9Vf9bp1BZDc8Zf5Tt-c_M8b9B6toCj9OEyhJoG9X6h56SmutQ7gcmAYBrKtLo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpufCNs8jNe4DJVjJSfea3C-nic0QvK6CbwuyfQs-MdQ&oe=6A6DF3B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yYUS7ZUz4IQ7kNvwHye8VC&_nc_oc=Ado92cqc-l6-cjp5d9v05g5l0lgCuso9oiGSNgJvJb4Edom9iy8rF-rHbEZwmTKta0w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7LKFz0f0vHRtjYvctq_vlp56If_FH4PItkXboKG2UbA&oe=6A6DD8FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mr3bGJ29Y8IQ7kNvwGbne8M&_nc_oc=AdrJp1xGqnJdVzC_XMDK7AwOKc_FSRnLrSUUKtteVQuzd-7kyguXdUnK3WG4BqDfQ-U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4_i1kHbplZvyH926oHzFKBeEDoHEMnybUQle0IYavnw&oe=6A6DFA6E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
xl&_nc_oc=AdrVfnkmsjPcgpxkY2d5u6XICE4O7R8D34oYg6zk92fxE4j-S-eSGyRitDIUIdVX6h8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBObbsg6pXLEQYSAyciMdIZT5KFbxOMz6PmJkMWObbVQ&oe=6A63576A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZV1WD0WMlq0Q7kNvwElnCNO&_nc_oc=Ado5sktHYJOf2Ezf_D_LbeadvRZATtR00B4oaXvTKgpsYIQE1azmQrjuUncggmdgUx8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCp4T9AoJk4Vv6Y2C1Q7sW5lLwsB-fT9hqECxGdm9RfIw&oe=6A6378F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFLeJHZ9O_UQ7kNvwGJYGim&_nc_oc=AdpTxqodjnR1Y8t1eBOLGiBhn7QVmpa6F4U2IPVjeke-Wo5JwZBjsPAz3BxKPo8X3Jc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1r0wQEypnmWGC8zEBvu2KBrkAIEZT1U9NLsS2oZ7Guw&oe=6A6367B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ugK7flrai8Q7kNvwF5faV4&_nc_oc=AdoC4RTXXg3ImjlYCzlCid7VtVgVq7zpr7-lWKxBwn360LIOV2cPQb5QZkAfKdgxaIc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAn8hda1LbsNiFqVWGf2A_hX-T7rHy1B5kHoGjOXopxA&oe=6A63853B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnmLKbyr6PUQ7kNvwHlP9zH&_nc_oc=Adqp-7BGN_TV9lBryW1t_Rphyn7xQIM3EffIq2faWx-BO6mLi0kgIJ1Z8PCJYpVEZ_Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKfxszLtIh0jM4600NOZsIMH-p4rkZToGVvr3ZDPdCEw&oe=6A636E6E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
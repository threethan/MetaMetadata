106045282529", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1EUH-Nlul0Q7kNvwGWEhzt&_nc_oc=AdrdglD1rwk1t9q-vlxQGQGo-34RnwLDUxcPWqyjbvm9zqQkpekWgu6QQGoNnYB4E0o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzmGN5E8pb-x12_71-V85uzcEBXyVjR17j_L9LW3K3NZA&oe=69C7AFB1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSP687iIAC4Q7kNvwFrk-Ee&_nc_oc=AdqAxsDE9X2cZqB-fqn0_KY2a-8QGdUEv8uZ4AUBA9hcXcEaJ2VHoxsw8YyV7L3s7F4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfykCQE8IxUF83N2ymLROe42AlvJkjfnNI6vwzaMJPC9pg&oe=69C7D6B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_PE-AQlnZIQ7kNvwEkl4wg&_nc_oc=Adr95ghnLXMfJaQJPvDJKjI3PvXSB5EQncC1A4YDIC5XdAsVurarcfZ5vCmd9MO-vhw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnLF8lENEd3zkitg6LsniaSfM9onFMtQBbvmsLUPXasw&oe=69C7BBFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgVWZVtW0zEQ7kNvwHQOq5U&_nc_oc=Adr9IfPrXWExpEnZ_DAonKJi60h-NEjbfBXX2lYoyoerQ5w4Y8_eRQzfoVh29FT9QSA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyxCqsXRswp4lFxAWx9gx08hsXTl85ay3L-x_4l5X3fjA&oe=69C7DD6E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"]
5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8dO_LrVedwQ7kNvwE0PeWr&_nc_oc=AdozgOFVUmnUIUdDpw8B9rvthRSxSYzWxHSlVaZqMB8B4KROaY5fNTcqXBpOJJYMmdI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpYXOxDqYVsxdpx8MMWgLneJEcQi_o9ouC2_36TrjWZw&oe=6AB006AA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3ZIVgUSjFoQ7kNvwHIH4rN&_nc_oc=Adq5ofR-2iMO9VCp6sH8rLxqdwGf-mHz68taF4EzwhgrFg7A0lF333h65VhpmEPVGjs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2ZrohsLkkvAXe5C4y2QbfsYKH602_-fErJX-FMXwOQA&oe=6AAFEFF1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aGhPw1vXcsQ7kNvwHfzdRU&_nc_oc=AdoIdxOvUaAClFDoaM-sGo9XAH9f3ECKfEkb-HRbMTbyImRVSVUTIVbHgcLy2MOlAiE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxi169-08-dloGmR39dSol7g0Ao_y1qjL4OQtiUpMzgg&oe=6AAFDEB6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsshMC1IjYIQ7kNvwHOvDnD&_nc_oc=AdoA8HV_8EEHwCTAOv9bD3AwPCoSe4EBqWUSVnKqLCgNv-52aMv3YOYCL_qMoK84BL4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzRZcf7RhQat_mL4c8nNV8YjEbo5LYiDiIAlz8Rc4mpQ&oe=6AAFFC3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1BKaNBWth4Q7kNvwGEmRA-&_nc_oc=AdreOaFWNtJr3_XWBuZy-vD0pXWZDN1_XcZ89KHVPA45K0gta5iEXE85JrILh_xhZFY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWdBH1QMQIEYSg8T3neVetB-BvkPoMdEzRb8u3MmJ2Wg&oe=6AAFE56E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
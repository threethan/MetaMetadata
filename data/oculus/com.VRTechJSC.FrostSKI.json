5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7T6UFMhhPGMQ7kNvwEchLda&_nc_oc=AdoUIBcXpZdnhcBV1UIIXzn1nu1f0K2K_z4pEg3qVg-66PJFlHtNFaAvIMwEsfqmn8c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCmCXNHxFdm3dWoot398-J5lMAulIQirmCUKQNVVv2qA&oe=6AE338EA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpDKXWMpAaEQ7kNvwGpa9BH&_nc_oc=Adrp5axd8A1RDYSQS5Sk5SzblrgK98E-8BDAw6Xvj5H1yxeo2_Tw5zl5RS2HhjSqSdE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOr28ezdnn9d2ru4WZrFfAz1KFSlsTQxsTqPxNuS5kDqw&oe=6AE35A71"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttGPP_jy4bEQ7kNvwExXP6E&_nc_oc=AdoSj9jMPS2bTtDSdqZeJXM1IFesDJdmKuw1TK2HXMrZ6BlnYCsUfYVoAXLhPCfdM8Y&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_WI5la2DOheubZONqJ1LUVRGm6AVWY23lfpN3tt9MmQ&oe=6AE34936"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvyXoXd5X7YQ7kNvwG78fBy&_nc_oc=Ado12evr7Jc8XuAZxmNGvroj4bhQ-adpmVMEK6SBOGSf4vKcWH1bKZvAeYZ2KJTqRZg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPw_Mzo4PytchT0YdNqa0vVv20AmuGtVdQOapsZrdMJTg&oe=6AE366BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gmg_4y9IL6UQ7kNvwFCuNOp&_nc_oc=AdpnqNEdseHysL7amK7KhAN3vF3-6irz4bvs7tDibamERFVFIbMa8_rDYJOvzcOc4ME&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0Ekt5GN-o8kms4__GEJgXVPFCM0x8ArasRfshv1Hh7w&oe=6AE34FEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
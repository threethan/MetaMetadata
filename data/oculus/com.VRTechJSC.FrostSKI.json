45369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzxSB_etuvEQ7kNvwHDgHUc&_nc_oc=Adk4s2IeBMB0R9w7wHPwRLT5wdsFV5osVtdsRAo2Kv6IQYnDJQ8VTaC64W6ZOmYs_ko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftLiOQlItqzzglOatN1egcLvUQz_Ff2o1sA-juztSRolg&oe=69A05AF1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Y6Blc7y8EMQ7kNvwEazPOl&_nc_oc=Adls-kwEbg1_95Tr3PXpPJdAJjvNf0Hdmecplrap0rJ8BGhTof2GcaVqlY0If6mcMm8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftZ3DPFcKuBLhoTqw6f7FvhFZb_Khaqb38C3UhxXBM-9w&oe=69A049B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1BGjA02mvsQ7kNvwGluvDF&_nc_oc=Adk-FkIwtJVvMBqKBiqtp29vGpAIGTSqtR4ftg7KwUzizyz9IfMAkVddbXsyH5X_gX4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsxjDm4p-HhhTLTj4-vSnEc5Vsa7n81j3N8HTSNQol5oA&oe=69A02EFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbnwE39vhR4Q7kNvwGD0RzW&_nc_oc=Adna-8BxmQ4WcaLvSnwOE9Am2KdlcC8TwOBvV18NrHArv1zM3HUtNTd_v4ph23LKJFo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfugJsPYQGTmHa8FWOejV8SrYLAPbamFBcufOkn9j8HBmg&oe=69A0506E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2539147
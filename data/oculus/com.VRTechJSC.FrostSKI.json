5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVIlXmWfyiAQ7kNvwFS_XZB&_nc_oc=Ado-4VSpl8fQ5qjfL5u-Uk_FhCkDgrFN0h2eCaxUiWObImg_-enGaFvh0Kp6780O9VA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2FVcH0ksowWzz_DI6e0QrLq620JVTa6qfKzZgHbb83g&oe=6AA29F6A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41agQCzt1J0Q7kNvwHAnWfT&_nc_oc=AdojmqtRHE63lFd_1LrrffgfzZOuP6DjtPk6M4nPEeJ7vtuaK8ouZqU0KJhXN8nTnIs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkqgm6_volXgVFYn8JrMt3ctOMi8iwXvKqDQ5llfjOTQ&oe=6AA2C0F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jRSytq429sQ7kNvwF5gb5P&_nc_oc=AdqKzXwsyHU1qc-XTL97g4ElvXGWNn-SWahd3Sb14vvur8D9hYVced6j0HtHKysq5Bg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcvkClrIi6OgxXJ8hEulL_-BNG1wUcqUwiWkQzNHUwBQ&oe=6AA2AFB6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAXCzehf3ToQ7kNvwGUB5lX&_nc_oc=AdrrQ7yaf7yQVaspPv6t-MLHSx9IcJX-zvRB9NN6xWyORPnimPI9aybchFkEflfvCbk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0NAOThZnoon4QTxumJTTtW7JoUWYMQsEr5RqJmKTsPQ&oe=6AA2CD3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afcgOCoGPTMQ7kNvwHLSryb&_nc_oc=Adq0LeJ3n76-SSH7rskhy4aPau0qbUX3swQ_nRoitXgwGK3GVdpbDtQVpEiCjEtz7lA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqOnEKW9BbRslW6yo3KCFO2NpwAmNUbew5m40Gsm6UNQ&oe=6AA2B66E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
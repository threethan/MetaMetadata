El&_nc_oc=AdrN-hhkgCGBtU1jDdTvPZXYkwb7ZptL4tKDpuEnn8N6KMG_jwsCkqEGYJV-SJwsSXA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22hzJU1UKPm-MYJ3uUOmcidxDG11sM4QNpiq_sxUOjEA&oe=69E4C76A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFB8v55xavYQ7kNvwG54tsP&_nc_oc=AdrIo18CjnIF6xDcRpgVz3BRW4eVNZz4PLPn387j151Fa2TeS5OYPiFW9W9iruvQcXw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Cu6trSOPGjfv1VLmLB_oXutJYDD637yAeC1TB69wI8w&oe=69E4E8F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXQiHHIVSDkQ7kNvwEJxdHA&_nc_oc=Adrmtl2R2Ha2gbJMBsbeUkT0WDDs_epR0vZxcWOkV7V1i1wNIyp_pfFzUhzio6GF4gY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15UyGltT0L912mEUdvMYRYH_pUvf-Oe7jDC-JO-SGbOQ&oe=69E4D7B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_bbn0Rs4NsQ7kNvwERV8hK&_nc_oc=Ado9k3MZ0OvFEBpxwrLU7CGsIQcp0Lmf93YqwnRNZhjPkPD2k0OOJepVsISaXsDk3X8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xEOVFTGl8UwMk2wKUQsAluknPSP6PjL8ByMuM2KEbQQ&oe=69E4BCFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkqAmHkExrgQ7kNvwHf6Kkl&_nc_oc=AdrFgtwny7rZt3o0PpXLfw3iRhdRRrhbSXHoYDQhf8rppuY4nLIeDE5HoZReeie-VV8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EV1y5pr6lqc2fD0Zinj5R8CQilb26X_UwrUPQWvMTVw&oe=69E4DE6E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
3L&_nc_oc=AdrrAfr0pXRtgfwVDjXElmrYifKI7akq6G2T1S6Q_v8WtoNMvGBF2gtfIVHnliYV31o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hVA-6r1iDSTZqskiQpxFaQ02navRC2aXptMT5dUmRPQ&oe=6A21A4AA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULmDnOHfxxYQ7kNvwEv3kVS&_nc_oc=AdpvoS4Di4djQmJgxSKjkczQLmI__-WEJlRktYmU3BHpiPCK93Z9Qz3rvFQKh50b_mg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dDWaJNP9MG6Nr834UBUjxPrnEKlx1Fjua1s6_wKtLkA&oe=6A218DF1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pb8b2rGxXIQ7kNvwHA3Cjs&_nc_oc=AdptJU6KkZU_szm3u4W7s8uN7AUQU0lPrYt9k_m8PCBb-Pwz8R7aOhNLe9xoIL1K9Dw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4uOqgIwKuajLD4tGbSXQn01GAIK6pKf8vfGdJlwtpmQ&oe=6A217CB6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQ0pBlxn-wgQ7kNvwEPRBcQ&_nc_oc=Adr-WntHTrAUHg14CGBhmo6kbYVjCa3Jwtx3IEH6wb8x5bdiD9AcOm90Qdl-iTauVEQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nOIUgYCyk2jpAqZKzc7yshAhp7myopkGuRVZ-SFfLEA&oe=6A219A3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAtVot8Ny9EQ7kNvwHs4xNh&_nc_oc=AdqAxrr1yuavyjZPQA5GSSSBSG1dMp1fqNu-ydooacNNSXtQui_SJihNotZBp82Gmgk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-35pgvpVGyQcfB5vd71QD-1H4XMxk0QC06E-OH37wLGg&oe=6A21836E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
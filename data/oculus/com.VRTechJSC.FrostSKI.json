5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Q3ytUl6NpMQ7kNvwF28LRi&_nc_oc=AdrIdpr2gJdT1tXvTDOb1Usb23vGcCkfEgwSreURNx-oET8q-IZXb2NI2O95xelXMRc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5pXe-ihvmQGTy9N-p8Bj29f7GLSOiZe5HH8UjHdd4zA&oe=6AF0A02A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOEAp5hmemsQ7kNvwFjzYkg&_nc_oc=Adp6_DvKDomFxEL5hQlmL7VeNRZZYTrrn_QC2h4c2uZ7Iqng4qkS-3AHytv-Th-Tfpw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0W0UEXOm6yZERQ4EeW61a47hfkhWt6eUD-cW_2uEtfA&oe=6AF08971"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzMGXWsBct8Q7kNvwHac_e4&_nc_oc=AdrG8QEZs9GZ8e92q3wZmibJx4wj1C93d8ZILcm0vvUY1mkuwgmIp8_X-NOIYyuR43M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfw_jnm8__w4wZkIDiy_18zRsMo0Sxh-ETyyyCQ9TJtQ&oe=6AF0B076"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05ZouJkoDjgQ7kNvwHjM39g&_nc_oc=AdqKMcdcRVrdwDY-jw6hvniQEwyPGYtXwvSv38jlWmgDHiAAlKFnXOrWF4S_IrBuKyY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtu5bloBnCA1R4ERzssAukVVKZCAGrLoDhxr-uFdLstA&oe=6AF095BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nu1-fpbtIksQ7kNvwHcJTYN&_nc_oc=AdpnBVHKfJUNiPLbdrEB_VJmqcKGQektgqcMXo3pFe8LpTfiQDx1YHW9VC6jWPoY0jo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnFCECQD07Cx12aNVqMmf-4rfPccxlNox2M3SltZaD2A&oe=6AF07EEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
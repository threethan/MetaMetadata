1a&_nc_oc=Adqsqn1ouE6I32-XoK5wsQtFH49ovUrolag8PloOCeSr13kh8YmyrnV0_HazK2JBuDc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af16ds6vvVXPDHCsKmpIsxNiDUuTNvN9Hujb6FjN_rQfeA&oe=69F5EAEA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJz2pADy4JMQ7kNvwHu8Ga3&_nc_oc=Adq-fgdRul9ywj5Y6pmjBUMjxlU3bERrqf5nmMxW1EAUkqcc6k-0lHgYa_qJK2Sse4k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0skzWRTup5pLav4H_GVW-cIVE_CrQElOHG_3YmfG-NeQ&oe=69F60C71"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfjDLt3PMMIQ7kNvwELreC9&_nc_oc=AdqvwTuGReBQq34ZKmORGjKrAOD3kyKZcK9DIKt2KahX7JVx2fqXs1KCZ-0vppXTyes&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1SbT20PdEB8bBpiwLwHSgZBC7o87-a4u59phwdPj3Lvg&oe=69F5FB36"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tD35E7234oYQ7kNvwGbGYu-&_nc_oc=Adr-HYsuwU4lP4acRi06lxVJTMPhMdSVs7Pi6hMzcHk1X2LG6S8m1TG-Q5-hwnLuYiA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1glV6FUcmxqhPOK9g8lSMOhmBHX6gL9AOLs58BaCssng&oe=69F618BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=womX0p2Re6MQ7kNvwEbSfcj&_nc_oc=AdpU81oi4Y4iXyFn3vIGquoaFoYwBTyyriQaOI4hmAFVoic6aCjjHCdGTX2f39QO7h4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0IuTJhZpYo1_ay0LuKdOCm_swcHK6GGril6JGpVaf94A&oe=69F601EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
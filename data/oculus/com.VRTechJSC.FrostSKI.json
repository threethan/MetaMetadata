5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxZdgiZRBx0Q7kNvwENMH-x&_nc_oc=Adpfl7hQudZQtMcx4myI64ayVCjUkSG7gk8uA6G0SiGU-PRfmuxS56l2ZxKHZiNGbYE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSULN_MSqMuxKAb8CLUYNmJ7vIVoa9MrdS6XiwinPhUUA&oe=6AECABAA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_6vfHAG1PYQ7kNvwEqFT1O&_nc_oc=AdoHX4TwO_NDvWh3Yvip1wzsq_IuA4KkKn8vFNQefGetG-UZnd0GJy2B_vMOGdGV2CY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRQN-wsNRwvhJ2ztXf1Ed1EDFh6M3DNDcZXbKgypY0WQ&oe=6AEC94F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqMYn1592R8Q7kNvwE2z8f5&_nc_oc=Adp70tEt_hB3v2hiOIp0zH2ZwFk58NsB2dl_UHxfeTyPTU8RJOkp4VfBA6e1oMSnN-g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDo3MtA9ywX3tG7P1b2NDghT0dHkqs67VSLaEdSEyRVg&oe=6AEC83B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJrXdOcXQPwQ7kNvwEleIwV&_nc_oc=Adpn73oG0mztNphP9UBVSPQpHCxXkmkBstiSG3JXB_qkC_h0Tl5EYfP37VN3lnID1pA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvWW6-MdYEWtHG5i3nanX1lRgjYU7HS7qIzvAognS21w&oe=6AECA13B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RV8tZFD63ysQ7kNvwHsIhK_&_nc_oc=AdqwBwDZHTvhszKatyWHyfntPipsbZ_pnpNmeU0DuMDb9SumqlfBu4_PFvheN-xBvyU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8Glj3xJSc5GPuG0yW-lwsxceV5fOxVVZcgb471gXMZw&oe=6AEC8A6E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
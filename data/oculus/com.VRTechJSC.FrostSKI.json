5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxZdgiZRBx0Q7kNvwGEEWO3&_nc_oc=AdpocMssFaiR7HfSHPeUK-Unt8ux072u_7_30UI3IC_F874YONdmlDBHS8AcTgL1FwM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS39mOU6xgJqzVxggeTUCjM60ixBz59khUbnGoXKvnyKw&oe=6AEF4EAA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOEAp5hmemsQ7kNvwG8Ok87&_nc_oc=AdrB8hZPdaChDvTd_S28S2Pjdax6gRV4v4vMbJsMZ1slJK7v6me27mwb-8Bv7X_cqpY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7y7tgjnbg_unUpFYCULZ6E864jcsh3v3_HWWj6TQs6g&oe=6AEF37F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzMGXWsBct8Q7kNvwFw2Xga&_nc_oc=AdqLi_C_s0SNvFA_z-5L2h4QMnIVHN_YxC1mBP22dytjaf-l1gVn2Q5UAf53elaw-ok&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2S9hmIs8CE-QLmkBaramJAHpd-j-uBOhPzisFs9MFYQ&oe=6AEF5EF6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05ZouJkoDjgQ7kNvwECBo0R&_nc_oc=Adp_uLGxSNJCK5N4NEn8Lh6-Kb6c5uo3TgP4Xs6f2k6U3nY5s-wSNrIlVa9k7CKm5wA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_lQxVzxvO_DU_Yn4hv0R4Ysnx5TO_Ls-5xYa1SGuWVQ&oe=6AEF443B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RV8tZFD63ysQ7kNvwGjgoXt&_nc_oc=Adp5t58ddUWVU33q0iccrwf3kSBppRmRsSzMsWn6LdmPbthtyepQrCrcujvI-FbcQ4E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSernDZqdr76dVC5o8pHM8QqHh5pPSIu4MEdX0taZmQw&oe=6AEF65AE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
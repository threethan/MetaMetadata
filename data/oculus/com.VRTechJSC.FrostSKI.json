5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ka0I36nbevAQ7kNvwHuFOBO&_nc_oc=AdreDRIPPuhSZW8FFDjaEf2E8Kiv6sFsp0zczQ2QVMibN0RKadvi5FVspSwI3MpYnG8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6cGXN15TR1OBUMBmvyejGpvcfoExkpvio_uGR_fD03A&oe=6ACFAAAA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yonizur_EjYQ7kNvwELrG-K&_nc_oc=AdrdnNO0GNPunMns3RvhvjHxtbx-XlkRTzo1FJGKWY4OMYKw04Qv5hXZe4UU343E7j0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWjKBjLadj6DFtGc6cnWqVRoIQG70Y2O-pfA73E2zk6A&oe=6ACF93F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5J8n68ziNAQ7kNvwGsp-CS&_nc_oc=Adp6997W_Rj_dNQau6TS4_AQYduKrzRNi7v_lBaOQlPKBC-76nJbqV2A-_8LSEs8thk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOX5vA7e5TIVkAnUjq-6UAXbgi1zLI-TNAAGIJotmFQXg&oe=6ACF82B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yA_LjkxzNgsQ7kNvwEtwXyh&_nc_oc=AdqYLTwFVxFvjFmV0vEVkgedJz4xMhtTdGdD7a7hlSx6fy6qxIHyqVgoVSq52FrySDg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCh-vnfBliJ-IiuzPE_ia6QzoiDJjQ-jroQrfXU2OnZw&oe=6ACFA03B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1osE2T8n3poQ7kNvwGKc94j&_nc_oc=AdoiRQtODMqFR1okTlQP2x2x8TD2gcT7gcor-5bU7kXpG6xk5j2IkvdtYXQH8iFwTik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIz3yz-YE7kkXXQV0lJ7p6lnT2tmRxF1I8ccgCsInWaA&oe=6ACF896E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
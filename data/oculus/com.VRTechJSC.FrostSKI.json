e1&_nc_oc=AdrmueLssqSaC0IUFF562Y8L3z5IsYmm0JNkE7ac1ImAKQEZao6lN8VVgXSJ8bH6dAA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECiBNxTFuI8EzZ0Oi0a4mD3O7LElRgkU5aehMTFa9GOQ&oe=6A81A9EA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyMuzwJ613gQ7kNvwG-Ir9i&_nc_oc=AdqBtHQX_mivNHhhQ83wogqNrL18vT3v16iHxRm3Rxklwo9j1IraCBwuBpbs9ietVZs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2V0ghOsXRP3NjMnvp5XiuvCelaQRicH_nnG-T7bJoLg&oe=6A819331"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-Wfx8A5jxAQ7kNvwEvjD5o&_nc_oc=AdopgDKWBL6COcXXwgFodvOxHVZ5M3g25BMJdIIbVU9B0co_JounwfsMWDaMoVARM0k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrsI-4NC91CXSssynq0SDjUqp_H-EKGWupQGql0gg6Cw&oe=6A81BA36"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPWspJt0GAQQ7kNvwEIEqIo&_nc_oc=Ado1bMKJxvT9a7buojoQq2H_5KiLMP_lvpWANvRSqhG07TKXYmQu6SxO7-PmIhTyYwc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSRCalvLldtFh_r-SXBbKM-oX0npwKCae-Mk42i5ah8Q&oe=6A819F7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49II6SO-f_oQ7kNvwFQuwvl&_nc_oc=AdoAGRmUZEziAHnk-eQgbg2vOSlo-lPkkPlL5-kWJ7D01BihGLDFAglyMSxcsSE6hT0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEMypowuf7WKKKwt2o4yolLzmCQo3-gGI7woPIZb_sFQ&oe=6A81C0EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
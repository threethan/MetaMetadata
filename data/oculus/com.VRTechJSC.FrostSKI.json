Qv&_nc_oc=Adq3XoNW8iClNDuW2SG6fm64JzXn5NQSam7EI5rc2SjPqgLQWnLqKoSXr0DfbozJIvg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkCaX4v_5N87hnPwg7_EVIXFHIgnuDV-AZZKfVnszIcw&oe=6A917BEA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQCIWEHOSLkQ7kNvwFKdNsT&_nc_oc=Ado11Y_GUU6O6ZkBJKEbL6tpfzvtn8qYZBVbDrTGZHHiKAC0_L2WRexJspThsM4gUmQ&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvFwkjigdPdPkgZihVrAgaI6t0RfQmb3-U33qKOIkLvw&oe=6A916531"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6m7WChjwr-4Q7kNvwEnfGh1&_nc_oc=Adp55weehutxeWeTr31bl_lg8X8QYEZ58S7h3S2203OGmQXS7C54Vtj4xU_aD98xoJI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGShn2vx3_Yc99JbzGC2qwhiU3VHpPgF0_ldoDuCsJK5Q&oe=6A918C36"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAwLlU35PicQ7kNvwFseCFj&_nc_oc=AdpPt-wLGpWGQ_vbFD9420OGDnHTELzO1_kHD_nIb52HhufTJtSwn9CCAhhXDoaaSU4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrbEsqTxECjtq6SJSwofAYqXCM4Xn49OoxZSpl50dOxg&oe=6A91717B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Pk3LFl6QZMQ7kNvwFKHYI7&_nc_oc=AdpyIpCofi2WNcsX0i5xvyT7rjseX-3JKv-0bMeIfY9pN-kqqgTuioPfzQfDbJfVmjk&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_9yjIllV51aTfbBz2ltN9pj5_2xmVArgMwxnMHc13eA&oe=6A915AAE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
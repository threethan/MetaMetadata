Bw&_nc_oc=AdoEaIgCAgl_ItbPDyoqDbNoBjtT7QwwAwHPB6cdYKcCuwjOVcVGI8XSpqC8IVgAVQ8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nHohBIs22XgoWJ4lHwymVorZhH4ai6svQq7ZSv26JZQ&oe=6A1C5EAA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYaGNM3fQKUQ7kNvwGrJpvY&_nc_oc=Ado99rvjxd3XhyeSzSzkaoXDALvOcf2rtGxKQ2huiKMZAXUxK4O2C4jEOmlmdPjiHBc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60oIr7z_VXe6QqGumGTqdHjaiM7MNp0YiL-jGIBZXuMA&oe=6A1C47F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pODgJTIgSWQQ7kNvwHPz0Kg&_nc_oc=AdoQXXVqTd-zvrWhbxanP48WCWZ6nF9OXsu9NmhZn5Hd9U9fSZoxvc1fcALKuitm4dQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tFX-s7z-tFszAG3iJ_11YEWBFA_JribcFwvUSjVP5EA&oe=6A1C36B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUaU3Oeg75oQ7kNvwF4-Gpg&_nc_oc=Adq8hB8hEnnyIXZyIafU4BofBaJRBRcy2Uva5Bh2F5JYkQ9qKrTIA4DQEWrexJC35ss&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gpYsAAVhnPvmrbrEkhuj4LMB8MIozW7ymnkqdSCUJ_g&oe=6A1C543B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ha0odXzH24Q7kNvwGxv4Qv&_nc_oc=AdppytEvNtEF7840ncHW8tVzs71JLkGF8prWh2x8U9xz57FKIe9kN3BaydJ8XZNsDRA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gvCMp-n573vTA2iYEEbLVaLnPYVOdWfa0349HBSFjbw&oe=6A1C3D6E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
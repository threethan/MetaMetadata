v9&_nc_oc=Adp1p5mY0ZXC0BBEWYTyRHAHbhuCDqCC6Mzrvk303HdPpZF2SkSLjj9kMePoHrZDzKg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrnsDK2LxIHdt2M1r5f8BjUZUCOimaMIONj3dvyAK-Sw&oe=6A5233EA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=laeXcQS4LNAQ7kNvwH1-69R&_nc_oc=AdrgjBR7gMfMUYgCmbu30rEdJusHxgYAXmGFhxsAbAzWW0SvagaCFf46z71WRZtc_hw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJQkJngfcO1EvSXdv6iRG_0dgFVgkPrScVLNhai6JSSw&oe=6A525571"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkWasoFusVYQ7kNvwG7ev5f&_nc_oc=AdrhZZY6H_NyonYihLO0lTkqxQ7WSJANRO6p_4XFmu84ufomGRqibJTfpQMvEGxCIns&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCS-A9awz01PZBgyN8vBUo-14oWI6AWEfkbHfUfg74cCw&oe=6A524436"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4s-o2bL04sQ7kNvwHYdpGi&_nc_oc=Ado-khajpNC_E20dKKNr92sn_OmgG3-Dm8c3Z_OsYHyKRixHXPxn6gJWPEtFkrEHeYc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuP1O4FF3-HmMm6PTye6y96quCSZ6jCNdKddnXD-NNiA&oe=6A5261BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zu4IWcrYl6YQ7kNvwHjwnIG&_nc_oc=AdquR8IOQbD1KwR5lttliWc2bFc7VsmJpFBG-M1UWTekh9pEkMPsipkhe0z8meiHKDY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDg1-pN7DPBPl4lcun2FbiQi3Rv4muGhlCAz4A70s_dog&oe=6A524AEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
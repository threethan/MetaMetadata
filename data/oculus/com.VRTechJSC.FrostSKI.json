ay&_nc_oc=AdpNpFvY0jVQkTvVQpK2emz0s5cIlNj3QcyzWYY3Q71a8JvNBVoewSvHwX-2xmo5k5Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1yilQxjJV93-BSo6GP1JH8FF0i5Acjsg-8aqU666jrAQ&oe=69F88DEA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zclQTrVx8CYQ7kNvwEHGobw&_nc_oc=AdryYW3Pnij1pTpvaplaB7tq2pT-LT5JdQRY9o2QqGlVQqmYmliBC3AbRNLUo2z_TCM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af18wi_TuMzV4uKvsf3EzqR5aC1vB2EpjaArSY47ItBazA&oe=69F8AF71"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfjDLt3PMMIQ7kNvwGQiWBQ&_nc_oc=AdrhEGPpM9iO4PfE_Pjf1CTwIZzA2NXuMGSFVcOpjjDliK_yYbHb5yHmc0yaIOR-DAo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1B_tNxZTMOaQQuznbbCOYylNf_lrN-reni1jFtyU6euw&oe=69F89E36"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=me6DW-PBLBgQ7kNvwF8bBhC&_nc_oc=AdqBpDwxeUgr_YOXtmsq8jeY0SmqZqw5K3fu42w8GsK0lcPieSs58w-nyirHGa4xGy0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af329iTTWW2XBB1rWFJlLj3smJ95fBZL8HlyQXtFHEpOow&oe=69F8BBBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDVjupLRGBgQ7kNvwEqjytY&_nc_oc=AdqfC3QHde-OY0ys5vTkDfsBj2wGgawraz9aKUuKE6Q5HOGXAvK67uA_EP2gUiqDf9I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3oFXH-2FwNVP7oqLY05wed541mCDEz-anJrYiCkgPutA&oe=69F8A4EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
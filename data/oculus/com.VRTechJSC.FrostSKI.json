ZX&_nc_oc=Adp_vFEAzJvvOZ3d11x53_MW4QBqmCJQpv6Cr3QbomxsbfkgEwYtIJQaUqArSpRY-Zo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hdruBTCD2dBwIWCDv9KIdQ8SldfpnF3AzhapvaFXJqg&oe=69E0D2EA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yooaWz4yjsMQ7kNvwH-GcT8&_nc_oc=Adr_8NIyMN6gKQpgZqr5qaRah1960lkN7miiBkT1whRj9jT9peUFs9SVGbjMkOYsy_A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DVVJiQ1ghq5IAAQ5KgTkQKNnXNbukYmtkBJbKUjJbnQ&oe=69E0F471"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gF2WUpSoBz0Q7kNvwHpmUD9&_nc_oc=AdpTvTBmJEhJLwuUrQJGw9xOI1Rw5ayD2TA3Svu4jemkaEWFUCtWrHMBw0q-vp39BcA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af285v0R_7eWPpbMC5Jp6FLZ5C9JK-QlWsvbNbcE8q5Nww&oe=69E0E336"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqMdZE8LKvwQ7kNvwFWYY0g&_nc_oc=Adr0lew50kFvq3xFQAq1uWQheX-qBe0s2UCMiB39foboXAlu9Bw0frck-MSXiQ3eFYE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VTCA5rYtV6mjqk8wchJeZ7V9_yMNaUOoudzd1Gm94Ig&oe=69E0C87B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVbxmX6dWZYQ7kNvwGeI8uY&_nc_oc=AdqGngATy35x-n4XxHkJ6P69wzI5F5XM4E7_caT6CEsZPbIemfKmWZA4m1SVPUAmnK8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wsMZX1CCEakPpwc89keEFcXQ_dthKDXESJacDjib5vA&oe=69E0E9EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
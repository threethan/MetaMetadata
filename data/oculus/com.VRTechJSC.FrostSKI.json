48&_nc_oc=AdqLFEEl2AQzH_quiExnsBbRsz9J6VykuvG_c3ZG-69EgFfgHCxEJ-QV0SiIGwmnxzQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGT0T4-RdaygF9H_Sx15oEpOzR0JdJ6tsHyVyAvfF5IAw&oe=6A97326A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHNPCYraaRsQ7kNvwFnlT0R&_nc_oc=AdreJcQ0qCKdOPuVibA87mKLLxBxAeOmS_abY-92-OfybeFNs9u5f4KDJOHeWo3GxNk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEGpRGfCL05SIxGsYokOSwRXScKNrg1xVGsZsRdESowA&oe=6A971BB1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGP6fzGnQoEQ7kNvwHw9ZxZ&_nc_oc=Adp7tftKPHrV292LuaexZPKdHUrbqXYMQT6CF13moUZ-1WqBq2nGBF9Uif7q1zMakYY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMIYfysdVzqHeL1u2_Hx4oXfKojCW-dYV15ISvgIqNNA&oe=6A9742B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MftUMJKpTgYQ7kNvwGRy4eY&_nc_oc=Adp9fN6ANnW0mSQoRQlyzyyar-0ojakOkeIpxFn7Xnt6XdrdiMXhqnZof51dVdnrgY4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6aDpdBylkAlkvAi9H4wuCsw8xvXh7jO77Ure1T3Wyew&oe=6A9727FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kw42EAjO-N0Q7kNvwHOVdb2&_nc_oc=AdoLq5zKot14Gu9j-sgENHcw6hp8AgaREUAEog7HrTmU0s_EJnYA8uatoPeyspxGXg0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUG3rO98nZkIDaXnUaS_4SZ-S3vZGCKan3BpfP7JPNBA&oe=6A97496E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
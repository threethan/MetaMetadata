g_&_nc_oc=Ado0GaPJi-x8mEsF18wXRvU9qs2qZvPuFOTfkzE4uijVxspGOmQBS2J2Pse7N8DZCpc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7d3UEpYQAe4LjEm3hBUoX0Z1mQMPBXn5k--SY75CLCWQ&oe=6A0B02EA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaYeQ1ryONgQ7kNvwHtR4dK&_nc_oc=AdqG0ZzX57RGVxWkZj8TN7snxKhZ5nJb6fWd-fbZzbZVjhvFdZOdSFZgkahD63NeXUA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45bJSqmlZZZGgM35ojIpQMAuvV40rQq3oYDkHwJ5a42A&oe=6A0B2471"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOr70jQXaFAQ7kNvwGxuFiH&_nc_oc=AdoFyvIBUoXR5d4w5KMBJ8vj8sMaje1Ypd0Qmlhrf8C38r5Wtm-HHQmJ6synfD27ty4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45H9HwdUbLOynK66kos2tT4JTenpSZ4_kLwuau8ufyfg&oe=6A0B1336"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhCImniJVl0Q7kNvwF5Pz0f&_nc_oc=AdrUtshQhZLtWxVP022ibQgC42Mk0XObEkXq5znMcmglnFN6321pMpBDLb0bT6eTPnM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GT-GTJnjL3y8nNrpLsTxd-W3fDn8j9d2GODixiRGtew&oe=6A0B30BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LApokPGo1zYQ7kNvwE6_X3p&_nc_oc=AdrRydjPPX3sQvsk1QX9O8NR8DliLBVw9Y1D7sxFm5sXoa5J1DMPfe5LBoshFdzl6yk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HQBS-RppWUlwnR5u6SAivv20Wu8qcviwsj8bPJp3tIw&oe=6A0B19EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
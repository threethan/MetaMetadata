5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcD1xfjjL-wQ7kNvwFYAtis&_nc_oc=AdoEoU1JFRW_OKK9Nni3XnV6tqCfwYYLdly2iY5aMRq0R_AFmHZEGwzF_w3kYtbIK94&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXur1TLvEe8wE2Z84CBvyOyVrN_qIs1SVWM2Ud_RBl1A&oe=6ADCD9AA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RA8J-XO0hzoQ7kNvwFydbXj&_nc_oc=AdpH5TNb3sbqNjMlYDQBqjO8ZXgh8ow5sGJ3eI81WOMCTCvWFqh2y4fkdhlBpYbfvDQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjOlmavc3W_GGFt3hLjmm3Dmebw4_0ZTkJkul33HuaNQ&oe=6ADCC2F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fXEBx4_THkQ7kNvwHmSVZY&_nc_oc=AdrUX6ddF8AQDCrqmx6eorpOSHU2-lk_gIl2tBMzJhX4KQ8HgwXj8YmXuyxaWGV64Jw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqvvvUnzDPluHiwrveyTBiUiwqe1-5w0hE03aus60pTQ&oe=6ADCB1B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXCllVdcbE8Q7kNvwHDv6jZ&_nc_oc=Adp4oCS8b14bx2bgwpy-r4Fajln27Kq-tKSyNsAO8_-x0pIfYGIQVE4wm-Da8rk5qsE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrfSjg9xbNOo5mJ5MsZc0jmT4h7BEGv_SxLpABHNYGsw&oe=6ADCCF3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDEyxrsH2iMQ7kNvwHF3qqF&_nc_oc=Adp-3ISrZKjrsfPUrzFMuDiuiV7Eb2O7b8E91pw3uzVn7_Lxnr8cBv-3weGT5UJOMAU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6q74nBUm0vSowtC33Dj9v1Fq3wvJGW9yMCsRt3QNEEA&oe=6ADCB86E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
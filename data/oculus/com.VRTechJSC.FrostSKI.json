zK&_nc_oc=Adp7FowdkApKWuOjzZz3zkhNubseo7FPz8FliJwSMv4lDgD3NY1qsD0uNsvRqyqzjr4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ngCIs3AX7YkMBlnHhbq1juU5WCV7KwPybvbzTpawBog&oe=6A01C86A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MaqF2Ydz4YQ7kNvwHZFLas&_nc_oc=Adp_u5aFl0fWEgb7AgnxeWOOdMinvX_nqowX_6DqHkEv1tjRK32ky3rzwQYKUTdzXNk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KMdPAC6nOggYu0QFq7onA4V4jpURXp2aQoJDdBNWBTA&oe=6A01E9F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbVAdIb0TOAQ7kNvwG3i2Z_&_nc_oc=AdqxyE577pPn5kf58yO1FNhSvpe2q2IRgejt7fVHXeNrhVRkJvohFaNAR1KttOvp3AQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IWaealff5FIys-rjdZdf-UhotYfXJKDIIS50_YIgNrA&oe=6A01D8B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOybV5gR9gkQ7kNvwGupWdy&_nc_oc=AdrkNlmpdvb-6V2k6AyCOeGZ5z6XO9rizpC1QZvToIEQ4XpdA-xRfVnFWJsZiFSBrY0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HMGusNitp2P9dzuxCHNyaITYKghj7olfPzuVBQXL5Hg&oe=6A01F63B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5GlObygb2kQ7kNvwF2lqo3&_nc_oc=AdpAgB0UxhZQ4Y_YlNzTUEq_zKxz01t8rppPHxPXer-fpUyT9vScNcF5zYsQ-1hSLuc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lP8-S6twMr-qcTyuPUXurN6_KD1mQRFrpfi7dYSNHJQ&oe=6A01DF6E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
yB&_nc_oc=AdoQjZxgSx8ZRcj2zml9fmyVsapuIIzapAXVugGX1CxAyX3nHoramBLopCsQrH7CkL4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKM6jgG1XEMr5Kh2OyL83LDWRo32FH_nCuHEipmPeKQxQ&oe=6A984BAA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHNPCYraaRsQ7kNvwHhyj6d&_nc_oc=AdrO80nK9vcBfIxPRUluiD_kLxLqqZQ32-rTPEynYSrhV1qcZWQSL1GsSHCkcc44eV0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuFCDVGrpoOkZT2V2lpK7U4hi93z0ZVspjLKWe3dhLYg&oe=6A9834F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=900clMGrfogQ7kNvwFycp6V&_nc_oc=AdqRVP9N1x9wsc3z3I5Cic_dVrPVPg0x3dXxtGzxAqhlqP87E1rj28Cc6Saa4G9eWvg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbizmlgD2hYkeQyNpdu2eCxaErby3jt7pryFDH3ow5nQ&oe=6A985BF6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MftUMJKpTgYQ7kNvwFlinUf&_nc_oc=AdoayEGax550qJrrIDH2k7hzi2h-yKLxa90qbq2jPFJ7fubM0QyBF3qRAhr4tfNNrVE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSWgN7GUGnQeqO9d93Y9AWcN_NNPuuGbiByH0LrjiPoA&oe=6A98413B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kw42EAjO-N0Q7kNvwHBMV4B&_nc_oc=AdoK1oN5_Ds1N24Scst_g52eY8r4IXh_N46jAT2KIjgLWYy6fCcxqV16KsO9Zn2bL0A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxnBpQDae6w3xri_1x7aiKTcC-RzZz3K0DConE4ZBprA&oe=6A9862AE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
kNvwHMVuKT&_nc_oc=AdpFLfkUFF7dN5jALuD3TcJBv_OXi1UAkNr5ZYP8ROF9utxYOixb8C0VUpRhlDFuo9U&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUMZoA3dFS-Xf6bwmAXnAiMTxcV5RpHKiwJQkiD4uOZg&oe=6A8ED8EA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQCIWEHOSLkQ7kNvwH7h44W&_nc_oc=AdqGiMo8q1WzDCiVPovjW_58qTM51NBwNEtiJ0S7ruc9CTnNuxzrlDKgYcjgnf0Lv1U&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGteLesJ5h-gyJaUXUX2aFLl_QhJvpSYZphekBv0Cu9Sg&oe=6A8EC231"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IP2UaZxfuQoQ7kNvwFovfE0&_nc_oc=AdoVV10sZTIBSBqUsXK9359aA2dE1os2HzWwMlULQonUWWxvInUEVbwYMKmlU0eL1ME&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGH3HyA8dnfqb0KipflotcCB6kWGXVgcFHShivC9-DHow&oe=6A8EE936"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAwLlU35PicQ7kNvwGDrWfP&_nc_oc=AdrPkWFdt2U7iftR9haTsF75L36pCc0wYJOn9BhZFg5IxtMAEx_7de1qxRI406UWd9Y&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-g6Qt7i263qLteVmC9cwoqve1RwkR9vjXbU17buLBCw&oe=6A8ECE7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Pk3LFl6QZMQ7kNvwHHk2D6&_nc_oc=Adp3SeJfqC54FLpzTsqjdeCwDzugNJKeZ1lZjqnU_kLSTUei9TJWR2wDqewlLMxXbnU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwMqMiN4ieTdxsx-NTh5P9YYU9jZkJq6KnqlS6hQbo-w&oe=6A8EEFEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "ha
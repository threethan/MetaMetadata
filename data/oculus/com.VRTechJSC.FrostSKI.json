u4&_nc_oc=Adrk_ftnWLlM5e1uVspkeq4t3HzKlsyJMnNf2fQ5AfTJjEtvoc0NwbNCn4OVCt9kcbg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37Ws1AO0Gc-KoCv6V2wUWHeInsu3uE8jr6gg8575YkDw&oe=69EB5EEA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyQ91vlWj3MQ7kNvwGwQu0r&_nc_oc=AdooC4qpU8S4n6yir9VPmbbi2t8snuyh9-h7BwZ1FSUPd5gh3V55cpmlL7bDo6tBORE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IsM2EiKSjaLBYYu7zYqeIB3_rkYXWGp8o965Z4pMATw&oe=69EB8071"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-BMawO9PuYQ7kNvwFEwoHP&_nc_oc=AdqBw5NEg8oT-t15I2YUeKZcrGV6nYpVpul0LRzHtf_ZOesCQsVolNVrIv4EFTXyYIo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38nDAsgq9IEB-JgmHtH1haqWzrJCqblJlJPziytT2xVw&oe=69EB6F36"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=91W1UgiuHlgQ7kNvwGhTSM-&_nc_oc=AdqPQ_hNTLvE3dPCoOlVMAush4Qb-TBxJSpYYGDqjP7RBIUHBPtjgCCsJapEh_eMdhk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3l-9i2rTYt9mXznFuUGIajeYmtTYCkqrIs4MApUDatHA&oe=69EB8CBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXpmJukeWMsQ7kNvwG-nb-C&_nc_oc=AdrhKsrHoGyFy81Ontz0QLeNdtyq-NXe5d9EsJ93y3bj4QBs2qjhCfweHujVGbyuW0g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BHAIu2PFHxIPhuC9nOpJIkW0PIyf8toIh26bw1mljcg&oe=69EB75EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
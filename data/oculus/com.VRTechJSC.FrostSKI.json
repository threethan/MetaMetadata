Zs&_nc_oc=Adr64rA2XLx2_G3ogNO2IpDVhTub0bCPGCcd6FgkSGBgDpxifTUxft9u-1dsEAznRzY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26DfM5vyxjy2qb-f1yGe_bQ0DZBzf7yiC_sax0xVHozQ&oe=69DA3B6A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5dDbHU5-XIQ7kNvwFkDcfH&_nc_oc=Ado1ZhiytfTbTM_gqJnbf2Q_dPYbc5iXnOPH7GuI-TR8hoGm2NaNr61oLohJpCG4Fmk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PnEyqJvLwFArNZe0q7qk73LW3EAuG7SKC5p_CDi1gtQ&oe=69DA5CF1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GeNRoljL8kQ7kNvwFfkklv&_nc_oc=AdooqQpbDCLINZtr16PCazTQwPGDZRXF_lAyLEDPWIWpVmPix-gipS8PKCl1U7RUR0c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZM390Z5H-_Ef97mL-BIgPmdIPAxdq9RJmSpgutM_uWQ&oe=69DA4BB6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iOFactCzN4Q7kNvwGzOnOn&_nc_oc=AdrSWxplbWscLp4BSYfKq_b5ZwnSm_lghoAGrATMrUwV_h7ejkEXOQTrm93Qr9rd5cI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3S1KEmEQIx1b7AP5149GARbwqa42Zttb77l14QOtpYPg&oe=69DA30FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBYOB00opBgQ7kNvwHalQEO&_nc_oc=Adrs-f4i6eGVcAhB8uuRmNPIYQN58m0wE9au5lwlLkS425GLAINq8fea5Nn2xedpVEw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Xj0lkQ77PErIMHlhI8OCL06TkFMbdcyFdisLi1hC0Xw&oe=69DA526E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
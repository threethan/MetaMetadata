0m&_nc_oc=AdokcDrUaMnmq6jIrlgiKsfzy8Zs9PLWKoZPGrP6snOJTSQTX-zJV1ITYHMPXagn5T0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OvcUsQSWWkaW6-95I5zSwQ1cy2Pf-DjeUXYQaJM-m7w&oe=6A08982A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaYeQ1ryONgQ7kNvwFt2Vw9&_nc_oc=AdrlrPVHMN0JOparhNzauLAtNPlRqpMhiKSLgPQ8ZaC-F8RyRA9pXaNos_N3RZEONXU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58Q7Jkjs3dRayegcTGd4qVWKQrDYHKcoHJhW5sCHk2xw&oe=6A088171"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64g4zAASKMMQ7kNvwE28RAq&_nc_oc=AdrHHFG-Ha3M7hhyhVMQCwxlyq3JGQOWYwM2Ni4eTYAEUc9uPjlLDDTHJfmZqZk44CA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Su9H_rOSy1Wa1sgVcMULcJHgoaMLY-EkA72NHQzWq6g&oe=6A087036"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhCImniJVl0Q7kNvwH4x21F&_nc_oc=Adp5eocXHkyk3HN97V8BcHkIjC1uYSp1tyHHSfawA2pzXjZ6r5cWuU_2I8OM61PoBSk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4n6XnLYj5pi3AaVRdkvr_anR_UiWSwUD9wa_YNjMWxcQ&oe=6A088DBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nu8IjqzmjgIQ7kNvwHxjEh2&_nc_oc=AdqCWtR_mRnDft49FtQDR4h0MW44yObqVCtiyWRLaKsQI-u1fygaXQixwlcgKTaAYoU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4v8AMXhNsTJKm5rKdtHmE8xKZRnth6GKQHLy-Xg3noyg&oe=6A0876EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
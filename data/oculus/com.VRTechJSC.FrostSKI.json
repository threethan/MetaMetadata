5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srLrtv1idt8Q7kNvwH6euie&_nc_oc=Ado7ynGy8wQpZnsxLgZodSYJlwcDuAEDfHClqzanqjbTirOVgPpSe-E35v57tevYsOQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKn5xZUlaDQt5pS9S8luUBnSqI2CYc0yMT19WsziOIWiw&oe=6AB69E2A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lZe-4qqfSgQ7kNvwGi1gQI&_nc_oc=Adrd66mTPDxIMe-p4QGHJXiEzC3YfDDsNh0uKhgtzcOAVdBMqIlUicnjy1MNyTk95Kk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLj-7K8GWzH-7Xv0AuBc2bALiBa1HhZ47O-wdtxXhgUwg&oe=6AB68771"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8a6BjGqinAQ7kNvwE-arhX&_nc_oc=AdrWnVwxNuf-bNXyKCPqlq9nItBgN4Ue9N9CCDQ1kK91aTslMWLFGSv020g2MUx9eOc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuKBoJowrRJb4lqOBXb3_5FQU94nzteAhfNNFre-HgPw&oe=6AB67636"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7U_KLceaw3QQ7kNvwHHOWo5&_nc_oc=AdrDSjVWFi61nqTraKPP0tZsqP0oWbWEQwxJSDXnS8kDNm3CvVRRxjuMHOmyFABQvNs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmJIBNe7r6XTymfWM_3sSrpWSiV23Szc05LQ5oqx1-4g&oe=6AB693BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m086QsZ2ORkQ7kNvwEgs4aE&_nc_oc=Adp_Dsic--gm1JJPbxCkmtlZEeErduqFnwEUpD1101AVtVNpsr4_cp8ODx_rYIBDCTU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH-EOSwydIe_a5UPkNK3cXq_5R8VYa1USOpo78WFvRPg&oe=6AB67CEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
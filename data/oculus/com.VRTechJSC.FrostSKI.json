eG&_nc_oc=AdoVng8jnkYmUDIN2q1B7dad0oNyfmAdXumLu0Ws5liIkxP60ClS8O6VqVdL7lKfZXY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkBI25NkxYAwLaYhkSDGg9AFd4_1WZg7Q3dCcPVRzMzA&oe=6A999D2A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHNPCYraaRsQ7kNvwEi_p8p&_nc_oc=AdpDY1O9MLs6Ml1ShThq86ZEvn0tQ_GWfjN9E18ukzQaqfoiLhOrUnaMQl3cmuFu9cU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-kdKkkArPSVWJjB6VXKU_xuWMYHs_ilTWtf_rBcc47w&oe=6A998671"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=900clMGrfogQ7kNvwF9rLon&_nc_oc=AdpcGs4wxori0bcujOlvbyA4YVL2YUYWq1F6iYE1ItjOc4-71It0TK3MLRFj_b7gTiw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJNQFl9e2-lB8uafK50_pMnh78CBeR548TMh64FVBJuQ&oe=6A997536"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MftUMJKpTgYQ7kNvwGIEiUQ&_nc_oc=AdrErlLPBsfnKMWIeqJfemIXaj3nWMzGgssYXjwPokQq0CY5GMYB0PecgOuAPsx-Buk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJA-G5rlctWn1F-eIYVwOSiPS19m1SlNW-v9h4VwfGi0A&oe=6A9992BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwfvzhFY-V8Q7kNvwGMYmpt&_nc_oc=AdpnhBFxgLF_83g2W6OFMfvzxVuv7YCcVSn1pI8xbaiidxg1VW8wuruRxlDrDoYZbV0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHRzEsqiDOOmpvOd1V-jeFlpdptL46eU1wC605LhPKzg&oe=6A997BEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
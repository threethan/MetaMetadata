5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sy4CZ_yAcuQQ7kNvwGzF1Y7&_nc_oc=Ado0RsreL9lfe8L5hp-3XxG2A0Os93lUZCgRSFYqYxCjIF8Yt1SaaJQCxB7iJgGjEqg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdx_kOlf68RiB-O8ELtGrUSP0IxusrX7d0uRl7Vrhwww&oe=6AF5E62A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKcud4WXfT8Q7kNvwGAEjh3&_nc_oc=AdqU_xsaYmW7SypPVaNmSULF3qs-DexPmsrO1PiRZZbH6m3d4bCcA-y9IlRsgGSi54I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQsX99SZlUn_gkrNrkcaRMzqx76Za_hSiDvkU5P1MArg&oe=6AF5CF71"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvC5HhiNsc8Q7kNvwEMEKKv&_nc_oc=AdqSoHmsX4VXbfy1Uv-f89PYBPeH5mjmZmDRBbqXKBy9-ukZ-UmDqYukTP8MYpYxCwA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbD7HtTzd0t2VKNIRa8x6ReeJoZSFeqtnegb7qWuj6zg&oe=6AF5BE36"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoHsxKGCk5UQ7kNvwF4wmkN&_nc_oc=AdognC-v193jQA7oSKnfqQ1UuGJGdt_DicAoT5Pedww7BYkID16tNol55_SNkesmYK4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjSRUqmjxbOp7Ke9HFsIhD4O_kziSf1XH6BWBzVz3l0w&oe=6AF5DBBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYPYeHH-MIYQ7kNvwHz8wjk&_nc_oc=Adpxw2jfk_15nrWMs5Imybz1qoMxyQJJAIdlP7SabJRiIuX7efZfrJUxyMaBZ7B5lik&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIbwLGf18RvpWwjWBUVloG1CiPQq3o24qLm-8doru-uA&oe=6AF5C4EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
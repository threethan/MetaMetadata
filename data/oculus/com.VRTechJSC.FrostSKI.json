5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Q3ytUl6NpMQ7kNvwEE0Aqe&_nc_oc=Adrs7-SxCtYTQTfsAbQJSV1dnnQCAaFKVeUM3DqKnBrMqaoNVcnawH2LxigB5Noxd4s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHrGtxwdqthlA6hwC6Oc63FTroQ92YpCtaQNxEAT9gdA&oe=6AF1F1AA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVV8vXhK1rAQ7kNvwH41Qfg&_nc_oc=Adr8v4ik9Ul-G6JEGkYm-wguBR77o2E3g1gdvNBqZVbMBlyfGnIEZgW8dE1UIFKUrcE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4jWomCLtDCFd-eikeacxfS9QNVthBDH1IaaWbS_JuGw&oe=6AF1DAF1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzMGXWsBct8Q7kNvwFVsMGJ&_nc_oc=AdrZU3JLarb8qsbRARqsurHTZIKKUAGuWqZRusN0qLndrfGsh6Xpi0SzRJIzyydPTnA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7E8PtmChCaKUEH56nH2F6MeSwB_l9Ds8V3Z9C5xie2Q&oe=6AF201F6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95ZuskSx8pUQ7kNvwG6c_71&_nc_oc=AdosiKtEayV5nBNxtZDunMiCMLiFRtrsLBftSNQvLDqdsF_cacAnGMYyWGhfK2xZaKQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRO0MwMRfdpC8xUAHi45mrHQ_gNlRrDqErQlnCTCwC6JQ&oe=6AF1E73B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nu1-fpbtIksQ7kNvwGk_3hT&_nc_oc=AdosCVc512rvWWPvINNnQGOAxGyXfXgY0_tcHWdlLFAFo_u2IJNpQHxJTUvLt_I8UyU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3TEFUuzewR2hqCUojKSNvYBV9zPCS59ZiKBfvnTklEw&oe=6AF208AE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
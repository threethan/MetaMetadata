Lr&_nc_oc=AdqBnoNJEMCRnKxGgR5NqdMSRUn6sE9fdVO5DowALigWEXVvuzFyzBo2p0v2DF54UJM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGafTU_Kg7PsrHDd2pU9PPiILXxILRStjBxOgRiX0ysGw&oe=6A79C0EA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aH1MYk5YE8YQ7kNvwF6baSz&_nc_oc=Ado_bQ7ayreuqMmgxDvQA2NVSm2WATMWY1JOsQPb8O_9CKI8F7oD8_P7IsJLRnYlxoQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9C7Lh99VgnLanxF7Txe_BRm6fpkRcwZB0yslnKdNLKQ&oe=6A79E271"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4vfSnrjNJ8Q7kNvwHIEoNS&_nc_oc=AdrDMAXM2HMoZ37R8OBmN01Q773ngtkfoZsyzql-r_xOTUt-EG1-oProUsCzXyllpwQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtpRT-vuqFlkevVswxIeeQOtn4G2thp24JP5grRkviSg&oe=6A79D136"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CzKmV38M-oQ7kNvwGBR7Af&_nc_oc=Adr8Jcy1bVNiBov8xOIfzUUeizbZcg5Ny8MAB7Xn1vKWVvFKrGYgCHR-Q0g6RN01dKM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDD3RzTGluR87XjCRjeWqZH8Rb3Wrl2Rj3ueDivBkXMQ&oe=6A79B67B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apAUZGFKB9YQ7kNvwHfBKSp&_nc_oc=Adq7V0C35DFaqs366mp8375tRCL_qHr_SUEaM2PRMyDgg2wSIbx9IZsQQXgJy6rREgc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoP0AcH1yl4mdConD5uhru4mnqqdfBu0xqWYvDXsWfCg&oe=6A79D7EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
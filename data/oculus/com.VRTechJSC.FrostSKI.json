Ry&_nc_oc=AdoHukFHdPgGPz9aU-fBz13iLFg8clbu5PMB8H3o0Ce5cV7gUL2A6NAgBBFJITwANhY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1K4oRfXMn-6797V0NWKv01dvITbmh3ivTCQKgBPfxSQ&oe=6A64A8EA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZV1WD0WMlq0Q7kNvwGUAikU&_nc_oc=AdquAXF69JJfrC3J-w8GLx_GUQ4NN77rG2nOdMugYeLRZRGH8N1x_HHqr-OOZpd0HY8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVWQhx7I6xQW2mAXy0ee1ieDpKt6YO8XAbs77-7JFinw&oe=6A64CA71"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4bLGOMA7NMQ7kNvwHqMWyI&_nc_oc=AdqoW0e1b9N7KTbxfT0bN6R2UFUrbGqbP2AzyecH5q2Mvdi9k3Ml0OwAq6g8lGBMJM8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHxHC41ixaza5A6uud_6Yqg4MFIuk5SVnRG75_xLmbWg&oe=6A64B936"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ugK7flrai8Q7kNvwEfXg8j&_nc_oc=AdpCzF_viAwKrjP1HN-umqg-6ccwH1sUB6j5siLvSSTmdwfq26GkESyFKiIkNhV2nKU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5A6-YAMctZMFUAjzQOmb8z7n-9oeB40UKu_6PXBRdUw&oe=6A649E7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnmLKbyr6PUQ7kNvwHzdX9l&_nc_oc=AdpXW_YFMmBNNHniHf3gPvvz3-9WXc6rkjUS_-fQ728mAAYL0udO81F_6UILj8qdyPA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOhWEV6gYLhlkXapocLLi380tZMzDYSFWhoYms1zUPzA&oe=6A64BFEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
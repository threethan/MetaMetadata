x-&_nc_oc=AdolKioxew9wGUJNxFWtEuOCdN9WaowJRvphR5xyFkSb3_7mo06lnuyLB_xD9tnmjEE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0D8mfAB83nXbb1Xwyd8gYJzUzQnAvawEUQUawfLtlUgA&oe=69F4996A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJz2pADy4JMQ7kNvwGe7j19&_nc_oc=AdrFCfpFSWZOBR8G15RxbLgbQysrD14lXR0na6SGvQDInKvxiMeaj2njHhIk4nJt2pQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2AGU_IS-KR_vmrodzgmxxyIPo1Hu4ceEyP_ZsoDe8-nA&oe=69F4BAF1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXT2fG5WWRIQ7kNvwHscJRF&_nc_oc=AdqEoUrwz4Psq_fw6ppz9eHTgJPxHcJKwSaKZRWmSX8cOtqTI18Irk0Yr0WkdmCnjQE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1rR7Syujb6euZi3uaF_Qp9HQfHkXbkNYlUCapoXcjiWg&oe=69F4A9B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tD35E7234oYQ7kNvwHeOunR&_nc_oc=AdqoYDd_HKmkXBw6W2L-GwR1YY3WDpff3BaJixcrbJPtE_liCFaunB5hZSwA569QZsE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0fEo7UBW7p1O2aOcCg3mSI6VBXQChw-01EStgOVyA-ww&oe=69F4C73B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=womX0p2Re6MQ7kNvwEmW2wS&_nc_oc=AdpoXIOhKBgWjE_yc3cJixIX1Z1HJjTCh2P_CM4bxzlAfX_FfN8TO8k-fWkdJLuow08&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af30XZ04Lml7uxKn2Nu08p7QjTfjesgvQHNkqKNxKG2nxQ&oe=69F4B06E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
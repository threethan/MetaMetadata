5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxZdgiZRBx0Q7kNvwEuXb_I&_nc_oc=AdoSmsAvHPO_RAp7RI3WcVcvz5WRVJHEt7-vHbRTBjMF4VOwZoyZ3ZJHZJIv_a5FIBU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWpay9CKjyBPCZwPY5l1Mm5v39lGri-XvhwOfqC7Gtbw&oe=6AEDFD2A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOEAp5hmemsQ7kNvwHXY_Z3&_nc_oc=AdoYgBBKFcuaKxmB4K6D7F93hpYl2V29rd8Vsu3pCSqSnIj8Cv3D5DChd54Lsa_3n5Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi_R948lCUKzQcXic3frJzqDj_Kqn6OzyxOnGF6ptYVg&oe=6AEDE671"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqMYn1592R8Q7kNvwHG2Gvr&_nc_oc=AdrUDBe-cOqEC5PYfRA7VuimhbdODt_h0cWADph2PRYHK1JRcjOa-AOZX4sJOYURyak&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNW9R9XF2QeEFquerWZjk1WQkyAF-GGSczl1WauYqXTA&oe=6AEDD536"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05ZouJkoDjgQ7kNvwHE8Bqq&_nc_oc=Adp5y7ICKddjHMoabhgLmL8Sfww15l17m8jdTpRFjG9sKWVbTq2KhFTwo-7ZY8tRbIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFKgAcqQYeOAffjG_DEQfU5CuEJEN1fv72mW8kvEKCkg&oe=6AEDF2BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RV8tZFD63ysQ7kNvwFBwWg3&_nc_oc=AdqO8yBBF_bFU4sDyLuWV1z_G0JlI4XVSmYB6fij5qBIHFW7kzpEKjNCI-av2I4vN4I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLS5EGf99_7z5twU2j4KyBdk3D95uMeZZF2NZNYhQQTw&oe=6AEDDBEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
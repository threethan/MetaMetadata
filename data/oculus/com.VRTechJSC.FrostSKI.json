fb&_nc_oc=Adp2DBTdxiFGYRXV9oisXup0xQADipNfHXkNAYBNV6s6uAbBy54ygnoeKFy8aBWhGJI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7ZTRaXiz_9Wa5vQo6y2Du35aoYX6xT0uIftgZXGnxMA&oe=6A69EEEA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=st871f2t3UMQ7kNvwHGMkY3&_nc_oc=AdrRXcf5DLW7BRQ1zPkQ6NqUI6JATYrY15YQ6FSTRwAzsfqhWXWieBGr0YPfb4d730w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMWf95MzHatWjoWqqe4dHKorBsis18M5KuIM_eVKVOpw&oe=6A6A1071"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYESkdQJMyUQ7kNvwEzQI0p&_nc_oc=Adp3_8v6AK5YQ1Sg8QfA5CcluqSZKIx5VFaGPEJNSrr3XUxikN7cKxBSkanlNaT33kI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSsVd5ZoTDO17_BqCwFrWtlkcqlpAKGuYAz98shVKmYw&oe=6A69FF36"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1rGNyT-34kQ7kNvwFpn4wS&_nc_oc=AdruK2GTvreT_vg-wse74OqJrogV-CVgyUGa5MAw-ncX94Gwv23XsfWKSNME_HYPNXc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhpE4udOm28IWWTtSJq55SO7yfmyS4ZLanViSRgnb8fg&oe=6A69E47B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qjbOimizn8Q7kNvwE66pTA&_nc_oc=AdrxtTBo4b6XGX-e1g_7vDtxTmsQkIjEqNt4Wh0l1sHlrbGJYv67fzPfs0gXeHrqmtY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbpJWblpk0L1Xmqw2xn3r55iqVcpRTZmNM3S5jcq_otw&oe=6A6A05EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
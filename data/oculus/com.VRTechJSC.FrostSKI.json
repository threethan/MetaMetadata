5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnzF5HORaywQ7kNvwH7Bl7G&_nc_oc=Adp4q7_KGF6-Jaq_EYzdFd2d14EnelB9jGPHXPZowc5Q-dFTz2s0kfe8QS1n_ArAl3Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ8gCTlidzjDRAEjX_xmgywPw2rHJuwXNqe-W2JIotuA&oe=6AF8892A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKcud4WXfT8Q7kNvwEdwWNy&_nc_oc=AdpDaW-H55Jr2wts-QGmgdGwQ7DwzIle7NRkX1lVW0KBygY6Hho3NrxKEy7vGUelSD8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfmF62uaKf-q8pecDN6mELzrY0TEjoWL3Fb9KSJccqKQ&oe=6AF8AAB1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bD1A2VL4B3cQ7kNvwFdMg2v&_nc_oc=Adok8VC3_MoJi4SxoMCwtrOxy-fhIf-njI9Ygv9cyygNH4sgHNVYH22BE2KL4LFSZxE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5peW7FMiYV_TF6VVWnxeQdfj8gw7o1LTpU2BmjYYMGg&oe=6AF89976"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoHsxKGCk5UQ7kNvwHpwrXE&_nc_oc=Adoyo1PXQ7XPBx-wkbTOPEUN-lCH3iFt0vI9mNbYy3OTmcb20mQ7eSCTDWo9JVDkepI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTP6-KOSH_hDOP2GprNzPdxNWRsaArVhqbfYTwlRzCHKg&oe=6AF87EBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3OcNEVqij0Q7kNvwH0qsZ_&_nc_oc=AdpfZdo5gaJKjUxv2sYmwW_APv0G9YKNJMu2JuyQZ0VDmExTBEzblU3XJta5wqD3Q4I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDF_ll6ZSGTbZ7-HwrX6_8-jy7FaKbG82n0lsuW8wXzQ&oe=6AF8A02E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
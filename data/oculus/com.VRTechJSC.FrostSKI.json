5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGsSG3A9xhcQ7kNvwEM9zoM&_nc_oc=AdpFFUopP0jJUqS7UR9GvCUbBsas89o8R-HJAMIsxwCfcCD14GPnx110VrVCUJPTK1o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-jhmOrY0zqUvhN9-b-wGL_8mchDWz89alFegD1Uis9Q&oe=6AEA08AA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_6vfHAG1PYQ7kNvwEetpGo&_nc_oc=Ado5EdvRWtA359TofoLHINxIRhQoYA7h88zlZFYhHoWGBDcPFFuWcl5cKblc7TM6kJM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuOXaJXdBZWdbm04weobyehtaMcFzOQ5QLro2WnTh-Kg&oe=6AE9F1F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQoCA8omoaIQ7kNvwG8B0K1&_nc_oc=AdrY8v-y5u4FAW8LFjCyjA9gnH0_kooJEkrZ-OslurFDp4L3gnFF60-Vws3B8q_3gqE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5la2W6lE3BGk-YbBnxTVBbO7n6_GvwT7TKSXQ1tkxcw&oe=6AE9E0B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJrXdOcXQPwQ7kNvwHZfWnj&_nc_oc=Adp_uaUnSOUz0oiSYfq7HSJKE9hoO15jrhLJ7vs3CynBKJOGKM5ZB6G-ArszuXEMqsU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ45sSi0oNtMAVC6tMxjG0PrB_qcRaJyH87FMv4aTbf2w&oe=6AE9FE3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csk8ar3-l7wQ7kNvwHLMl1a&_nc_oc=AdouJPHSdZnPxy1eMX5SCYLcdGpgdxFCsvmar-ofOsL6YIHFU92hjEzePRJiKIDYXRQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQe7yhs950FuzNCUYrUid39MevAKzCHLcpQrzlYE7H96A&oe=6AE9E76E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
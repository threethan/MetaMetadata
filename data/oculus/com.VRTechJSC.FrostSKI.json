pK58&_nc_oc=AdpOmlslyraRkdd2GmeAc4fHYyGcxJR2xCAbMfXT1JjTq-yNitRpAYeb6FuLQMwkjxU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gai_ZP9oX2qDKhyeIOESboxzGrh9u_5O0Baryew5drw&oe=6A395FAA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LMTUURkAroQ7kNvwErMWcW&_nc_oc=AdpzJD51tU33n68dpdGYJRVY0pvhLBm6McmUTqt1V0N_V_fzEJBtEfRNKjNBzttMwNY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GnsUX-n70ZXwAElxjHf868MnsWemIWs_YE23_Y3TYWQ&oe=6A3948F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJZwYxj03YkQ7kNvwEDiN0q&_nc_oc=AdpfCsb9X66t8GI5a-JONBFRq2mnEAcISHnpkJuhLNow4a5L2_WeLNjR-2vSKRrtOmc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TnXeckIhR7oKs3owS2lCqeg7gouVrb9c5xiIGdnPgEA&oe=6A3937B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufmJBizKUwEQ7kNvwHFHQ1v&_nc_oc=AdooO-5v0XQRwKbXeysgjDXZ5lg67JQpd9N10BiPpVVDj9dVsftdyHXrK7hcBWdAKh4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7ZdzipQTEq6zV0aus7OB20ojgy_t6-OAuCzb3pJTzwA&oe=6A39553B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRD87DYs5SkQ7kNvwEO5Dcc&_nc_oc=Adr6ic2dy6Ic9NaNeeZNpnEr0ZyOQAfbo4Y0mlc1gWCCFq185gjqr5GYrNoUtAmOu6c&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AT9tsgzs2rtkWfG8tm_gyFKsa9sXvhGiZYqMAOQDzOA&oe=6A393E6E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_a
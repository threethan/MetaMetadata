Byi&_nc_oc=AdoKiQGObMCdOYeGZ2rSeLOUTrG8mJo3MzcVlJuyppx0VQ0OAbiXhdyRcz2CuQ6faN0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKl5afNDQERVFeaLvEKN9j1ZVmUqh0qEe8OPASYTCnszw&oe=6A9D596A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reTWnGR-YuUQ7kNvwFoYmoI&_nc_oc=AdqVHhu7SazW_qCqyI_2LLjlnOEqF5P19HTBh-vNlZe8vh2-AR8pNIo7KhLBdFWC7zA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW856cc34hDRO7G9HHPQ6dMTTn10n-s5AHo_A4T_Cs8Q&oe=6A9D7AF1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwA-BjuedUkQ7kNvwGEWS4y&_nc_oc=Adqo5Sv9-flRQWbdqRnhgy0l_2YLHDoQVrdvlvkdAGpClxfImJH6QElXFA2aoFN-lvA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0JJQzSPBVi-DbYCD6P1TaM6TDQ01x7r-MieC_b0PCHA&oe=6A9D69B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q28W3mActXEQ7kNvwHZ67P-&_nc_oc=AdoNTAhPM1dU-h6xvCr6-BMneKmUsLPUCS6AEABeW9dn7VXRGS7dHA-TBg5ESBHFgqo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEjOoCkPO31w1WYbIHWOLqBQoNpARQaJzFXmt6k0hYdQ&oe=6A9D873B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1MxnI7a4QQQ7kNvwGPTlzk&_nc_oc=Adp7MY-4h_ZDmFIoCSL1vW1fHx4X5iMe69I1cQzNAFl191_VHsvoFj3WhMPb0uIZs08&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4Xn2ft1WEAWJFO9oAE2B4AO2lLzSPUqpf3CxRm-VSNg&oe=6A9D706E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_
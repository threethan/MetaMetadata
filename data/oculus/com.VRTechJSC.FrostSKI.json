vh&_nc_oc=AdqbuqC1kP8OGhJigYznaqZzA0-kpxJpaV4aNKzu4YxfW5ePsXY_w_Nca6WNrYO3x5A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4A_hP8VcFn_pZS1toUPqy_yHnrjtyJwq7IA0W3BUeGwg&oe=6A1D77EA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYaGNM3fQKUQ7kNvwHymBvY&_nc_oc=Ado6nHhuAqPJhy6Oc3rttGOalDXOeoKGlrZTV5nAUTU8ypWQuMRaXg2iTmSvB-W3sb8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xWzdmseTq3dnqDHwidc6fZmEULDVvb8XxTZW_JgH0pw&oe=6A1D9971"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_zvhLK6Z3kQ7kNvwGM_4BL&_nc_oc=Ado2kZ62egmX5s8cD2GEwR3KfjNZMCbkpZCfYDuR7qoiDs5xhrf-UHCpBbg7y8RDfdY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62w0uchYmHaRBxl4ViYD1sNugLd5osrmOLz9OSbJTkpw&oe=6A1D8836"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUaU3Oeg75oQ7kNvwG4QqGB&_nc_oc=Adq75P8aSeYGH_wQqtf7YY9jLYYkCjCJYY-yZ0iXX7hKElrFopWX8OpjOkRXFEWsH0U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45xdYBZ8BLl4U_ztvS7Po1x_S90zptcz2Tr8bBBbPHxA&oe=6A1DA5BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ha0odXzH24Q7kNvwFnJyov&_nc_oc=AdoHywJii9nE7pKpBB-N50-bC5THBLs5Jb1iVpH1MuB9rztetTVGPVI5fMQM9R9lvWI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af735MQLROXEkEhWCxYH1D8FG9LdITk0rECvoxN7f1_1Ow&oe=6A1D8EEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
PV&_nc_oc=AdoMwV8fTouxq_uIyZE1-S6hY_X1G1oybVuFcNEDwU_nyGT9HHpxmK0yYeEPsCIprHI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoEAUYY_uw5_XvdHT8ZsMt12Kd8uM-AzcBLulqQcK3NQ&oe=6A8AE46A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9d3rf21fwkQ7kNvwH1LyFl&_nc_oc=AdoKanrrxkuSFXeFoQjIoI0rltLjTwSh42RwPupqY6Xft0HscCHHNR-rF4n-Ok36nik&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHycg8xuN1hULauPyrlK_sKIN4ZjA3SdcOWyp4kN_J_1g&oe=6A8ACDB1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUjljYte-ZsQ7kNvwEqSIV9&_nc_oc=AdoE80_e3DeqQy-w-hoSgkbIdsnOAcYyMDYVssXUpirQ2JeRCtn-KtfoArNs8JAt0hE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXffItDc6LrPzoJiCpcQlwrQxvFqIAwKtAM1LumLOECQ&oe=6A8AF4B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6Uo-24k9mAQ7kNvwEfq8oN&_nc_oc=Adq-lodWLnGc_-MU6z08Bcz3dn7c1LIFv9qDmpt6Zm4smqTAsAiXOp3OFilamz-vjWU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJX5O2EyIbXD77e4qWO1K4RaQbdOm-BnFq6SBkQIiX1g&oe=6A8AD9FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0tFdTu0z9YQ7kNvwGTjVsy&_nc_oc=AdpKAtgu9LherHC6RM7rZCouwkrz1p7pfIzkQbRWmrU9H6RKuj0AwUxbQHtOKjAzG3s&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHO9UfP4JR2Ct9l0BQ95DRbkxyiHxJYPoQRtHqy-9h9sg&oe=6A8AC32E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
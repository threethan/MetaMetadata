Ht&_nc_oc=AdoksvU4eVWMzp0uEwLWrRsEtsE9QXzLIuQhOYx8yL4PSNlFT52UE-CQ3y6TM9OK42o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhE7waemYyJhPdbrbzrN7ikgyR1jQmIrzEAJw6SfoQOg&oe=6A4CEDEA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6QvJmUHk8gQ7kNvwHGaakZ&_nc_oc=AdrJ_BMKQcOr_KnkhiJoWpTL5AXdmB8-WDmgRzUQaJJHUNXMP3kDDGdA4sVg3zMgKL0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCijjd_iIlMXWa4vtrNXWWzqjgyYyy8EepJmA77SSKSYA&oe=6A4D0F71"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lnf8_-t5RNgQ7kNvwHD1K9Y&_nc_oc=Adrx5J7tWeFk2Hc3kjDO4MkZUfGH733SObyXLhRO2maRlGCdk_f4Ye5tPed83rOFhRA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByScYUw3ei6bLuxHVOah9Rb-BRXLrr-JfaxMBG2blPAg&oe=6A4CFE36"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EiHub3eO_XIQ7kNvwGNafFX&_nc_oc=Adq0d6pyNHhF0eeqiQiQT3oflNaCUBLAFwaS5QL-Mw99KKuam3dVM6DBF508ZpY6eSc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBI-2qKphYQhVxfvPYVSbFlThV81pfROon4AZnHlhgVgg&oe=6A4D1BBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzCFV0WtLXsQ7kNvwEfKguF&_nc_oc=AdqZDT4_KHeD5LmRTFdj80Jv3m6cOoCPa0_OD39hB3lzI3In49czay9uIXgfi9tcOxI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfLwVo5qL2YZIh4ImUyJ27dY0tI5JIUMcQ3NvUQAd2NA&oe=6A4D04EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
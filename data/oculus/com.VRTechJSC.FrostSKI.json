45369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uas94ulfyEQ7kNvwEj-cl5&_nc_oc=Admloo-O85VHUJcjdByK-dQPuCbwgQSogFw9Ba89bzk7RWmVZPYjIHv_UQBXE5WP-Do&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv3vxfYV9fLwnBR8UptIlqyqVdCFUe6VFOO0goh0vzyVw&oe=6999C371"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxbRL9mA_04Q7kNvwFoyKWr&_nc_oc=AdnrSmCIOb30nehF3UdUT-TD1pT883Jlhgo7fJToOUdymk3TPt-08s0U2zq7uBm9u_I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs9tYsHbN3f8eLV_bXo1B656RUuQ1aVZbTKyrI8SAEoAg&oe=6999B236"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgBku7ZD9dsQ7kNvwEawGS2&_nc_oc=Adm2HIK_1Au6GwnvKMCPHb7GnDw9aHB3JAey0_TjHaXXqoFpgmEzdw-9Wa9ACVz3Dxw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvyDl7VB4phpTCZ3LgmglYCnJ8TRBZ2YoANhz36VVHJXQ&oe=6999977B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFc97hR1H58Q7kNvwG79Ils&_nc_oc=AdkBHDmWpsLarRkx3Zs8CMj4p6tg-Ys1Ko8zaZ12TQ20PXWo2n8LoMZbXLF0ijiJZ4U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvgLvwTDfkkZNTmUlrEnhnjb-ztulj3bpJfk8GV5v0Txg&oe=6999B8EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2539147
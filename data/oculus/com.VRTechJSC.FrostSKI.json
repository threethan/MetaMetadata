CP&_nc_oc=AdqNi9w9Mo3FfDUrvw2hC23x3dB-1wfCBgkA_CBqyzMEcpDEgwagQds0yRRtDxTKLQc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiOFkO59efblloTeUL9BlLsrpGMZXLaFbdpWadArRD8Q&oe=6A95E0EA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrhvvkOsjBMQ7kNvwH6oBQJ&_nc_oc=Adq4zn7xPRKxuD1PyVa17SN6sQ7O9RKWz-sYgQdZIxnTbiqdf-G7cbHMkxf94_JkD5w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsD1ukeusNIZa3mbY3HEdYcsmm-G7HewhXmpgJPAuoug&oe=6A95CA31"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGP6fzGnQoEQ7kNvwF-u2Km&_nc_oc=AdrTVo7qFwXVtcU5ICs_k_jZQUjG5WjeC2yGJz1sc-05iIgaW0IeKt4hnr2SmtCqNyI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1JwT_mWrMDYL4dQtJKt5_bJ2ff98IbSf1XTsRQVQ8Sg&oe=6A95B8F6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnGfrVLijnMQ7kNvwF5Nbl4&_nc_oc=Ado1mvZhJNo-VPplQq3ArzuuUHAKi3cWqIk9j5uQwgZd6KwEnYFirWFGNn59ckrNIIw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5UzZA1kjs9MTz5_MdQNTjdBy7U0qp2wOXEjPSQ4N5Qw&oe=6A95D67B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kw42EAjO-N0Q7kNvwFJzPav&_nc_oc=AdrzRiF-k-_KKrnNodogKxPf6HSvXhZzPPW7cryNMSPTEJyrI51ItNXcgD-hYdIwBe8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHegXgqZTVF1xZPzbWAmRXsndnGmZp5PZPAtCuvfadA0w&oe=6A95BFAE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
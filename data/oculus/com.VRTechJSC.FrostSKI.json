HU&_nc_oc=Adok5UjY5M_D7ApQmYFXKbgwGQZ7Bp2RutmV7LSs-ZRFhavN1NOnZqNxe8AGc7fw6OY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ANnjixI2Wwnnb7Omg77Gv1w8HbmGx7v7G_pl3MQyGDg&oe=6A380E2A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LMTUURkAroQ7kNvwE176Pl&_nc_oc=AdqsZmKkPXC6RfefFnoCMCBG9Riae9y_WZXSBM8aG2jgljCelIzeYKDGLkKyNU2TT6w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_97wMwDWcF1Ajgwcgdxt5qsiSkK1hCpGTEhnbJ_kGksg&oe=6A37F771"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcGp23zvTJwQ7kNvwEHqGec&_nc_oc=AdqKMmwJ-1sQMgCdTXw1EnnJ2HoUp8VLvoOTmH-ddjcXwVvbyj4e0z0VESEEH3Cjpr0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OB11nHRnnjoHnCBvceb6SWHehil8iZC0PTVm0ZiZReg&oe=6A37E636"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufmJBizKUwEQ7kNvwHgL0p-&_nc_oc=AdpRi9aRR5gybW76m5h6-DtrFxPEKkqyFNnP-XHvKI-q-F4XOnwtIWDdyxfz8FFUGPs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NcgZVnmJZ8Vnn2kiyiPKyszbed-Kyk45Ql9Uu4Q9hsw&oe=6A3803BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRD87DYs5SkQ7kNvwFeIO0F&_nc_oc=AdptEbrpCY0ly782s72o4YfhLVJdWlZcfpWSH-JhVyObvdnV5UkEDT_N6IdGNDTcodc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xwOa_x-YUus1lrJHb2EZFDsVot7yw7UVOlLaMYBdozQ&oe=6A37ECEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
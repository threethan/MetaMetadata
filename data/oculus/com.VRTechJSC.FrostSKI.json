04&_nc_oc=AdoaTEnxLytLVdkBb9xy9ktsI14ca91Ilpzpvyb4t28AoQUV0s-o2NZUso5ph_eHj0Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJ9kqrkntAiWDUGxHEVoI8io4vB6w8_cwYwwqj9xKaUQ&oe=6A844CEA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZbeLLh9s4UQ7kNvwE-Cv1j&_nc_oc=AdqasLqdbmFBSHukWAJj05xSHLxGlFOygl0LKsYnQEy8Ib9CVeVdo75IO88fdd0zoyo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNj2tJl4cxcsZtfbTT_JN82WrJrMY4Iig27COJ5fGwnQ&oe=6A843631"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUGZxIiH7EsQ7kNvwFd3qK1&_nc_oc=AdrKrXx9SvJ1iyLKd-Ldtnnu_9VTZrU67fSqYchHBIs-LlxwXFwcNZuVlvlBJ5oyM94&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFADPwkTyEmyHwnChCHGKefQaINu3xEj0ALoNFNANA0Fw&oe=6A845D36"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Je7UIHsb5IkQ7kNvwEiF_IL&_nc_oc=AdrQqZD8hL04xjd9ojyd5T0hB5fbDQqutUGq_pyHK8m8HydRHGRnqTOQu7X4NaiJTBs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEA1ocwC1r2lzd3YFIMBn_-2zoD21J_I3d2fsOnM60zJg&oe=6A84427B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxLORHgSWfkQ7kNvwGC-Q-3&_nc_oc=AdogbC9_2qWtOAn9iYoutwiU1J5HcQYGdHKnMgJZ0L1GkHVSuNL8mI6CsmECkyDjUD8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1VS7zQUPpTbUpMUF3UFnj_izUCzg8MgKgS9x9gFilEw&oe=6A8463EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
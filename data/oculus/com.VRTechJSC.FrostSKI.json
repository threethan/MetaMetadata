q4&_nc_oc=Adp93WiORTvOAMxW-QYmuA6DI_6laLhM_MBjoipOQ-v_Ud3Om4iLDgZ4fTSJETfIqhs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-2V02GZnQuYDrRBbDE2uToHFNHz76aRmmacCicTeA7g&oe=6A75CC6A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adHgRHYieAwQ7kNvwHV68I-&_nc_oc=AdqD9zm3tQF3PYt82w-s7ArcvkCDoD5speiIv-86ghol6D9fbA59qCMcqFEPJNbDKFo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNRZ67rWGl7tLT8AXajXL-LK-C0Cnp_e8crp9RZOSHXw&oe=6A75EDF1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MY6Ipj3_9w8Q7kNvwFBvANg&_nc_oc=Adob6oeLflnf_NUitD2AKCzCPg4VlM6mau7O_R9PPxYkc-avlKsHR2m7c79Es45XpDo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGzICGfxUWvTKYiWGMujUa7rCxPhcnkBdog-2lz4Llfg&oe=6A75DCB6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hq4HZjr0l6YQ7kNvwGGbKc-&_nc_oc=AdoqDZY_NMSxQIP5OwcEZ-WUu5kI4JyrBB8I2WcRd6BSRXvfsS4NJwc4VXSoHaCurdM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFI6jwN9uVzF53SJAdk6IpNQ_ZpcRm0lp-_lMj3qdDoQw&oe=6A75FA3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vPo1z7ParMQ7kNvwHY29Vc&_nc_oc=Adr-lhrLKlzKjzvAamv2Z8bkLAuDWmGpXIYl8-Lhr974FNiXo0MoeWKYShzP56xeK1A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTlP2-W-8P3vkGvZ96X6q7bpZzlWAnFY2B4rFPJJignA&oe=6A75E36E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6tquHHlC5oQ7kNvwEtZeLK&_nc_oc=AdoTqOx0yFZFNf4Dyag3R_n5I_avW91fHHCaxqsEycKS1LdRPxxPziUJl86ndZMOs7c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9DYVW8WL5VWz3Q-Eu9cFy8DCtYewi5VKUHc42litPcg&oe=6AB2716A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOQq1CY1r0wQ7kNvwHimefX&_nc_oc=AdpxPKZIzEC1ufMvLNXwJTpwnr0FoLlb8-5tT2Rkl_fWoly9TRmxcvL6rgkPWwT0IT8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNl3GrU2o2XzvP7to0WFMwZ9M1uLO0zeWj1E9YCZjMVA&oe=6AB292F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aGhPw1vXcsQ7kNvwH5bbkY&_nc_oc=AdpBbcdevad0ypYw76gJqj0fwzR0a5PC6ddU1tN8eEsl5lThpt2uO_b2AWZlm-Efbg8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCrjEFrRS976NerB8FT6cbtZlEBcQia7hgBRu6_mAk8Q&oe=6AB281B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZFA6rb6gYwQ7kNvwF_8ifZ&_nc_oc=AdpXMSL99GNXH1sMcxn7HueHH5LTNdVRffKD7vL_IaQue2Xwo6eskL4p0zYO_aq0WCE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSx4WHtmbNNqu9azX-1LoLqjEa9ZQFMSYQODY6rtPprw&oe=6AB29F3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pw7oQm0qIfYQ7kNvwHrt7Oc&_nc_oc=AdpWYaqkZBp-b-Geosqpn0TpSCbQ5o-ItCGcVXy3UxxMily0sPa8D8zjZ1Qzcygn_Hw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJghO4qYX7wdyyQC1hsqZZ_2DSGB5Z2flPDlnrYm7SBdg&oe=6AB2886E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
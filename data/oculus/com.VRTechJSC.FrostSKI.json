GR&_nc_oc=AdpPgfQEPjNMal_VgtC57KltHN2Fy-WIrLFWNsIhVNRq2fBKKmTB3JQk_UBtrE3YUD8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RrQkLMJTQ6huL74FqXwSLZKZWeGWthQWl7-6wCevb6Q&oe=69DE2FEA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmMGHwpaK2kQ7kNvwHx-QyB&_nc_oc=AdrXDkMZxElxGh7TVjFtS3WygWD4aXyWbO3q691dOBcrbhZdGLaxzSsYGY3oFnYawKc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0r54pTjaSuVm-qg4L_EzaL_A5Zn8I7wxGWxlIfHmDumA&oe=69DE5171"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gF2WUpSoBz0Q7kNvwHwlh9j&_nc_oc=AdpwGuc24EBivz-X6mUrVBOI8OfwLh0NmfP15bLT-aCBHpVlAh1B_lkAyWdn7AHchz8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lYmyoYM_2yKKe1jgCjCxQ8Rp5iRtRhpUY9Z0RaARvwA&oe=69DE4036"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNM5KC3XzDUQ7kNvwEcAwl8&_nc_oc=Adr-N09Dn1389qpBTdDVKi85ESu8-xSBfHeqHoNZrhKyluAJq-PM0af3ceLDDlD80GA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iPvWtgWsddZvdTLJfhYyv6hlegwGzt4h6ZIKD9L986Q&oe=69DE257B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CehwbuTfptgQ7kNvwFh8aW0&_nc_oc=Adqe29rv9q4a02g4p5N8nyaDGT4Fa-OVSpph2OP8oti60mCUZt25pCmBh-uzMCJeMI4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uZChkjiXlsk7luasiZoTE1WFhvzK7eDsxEqNTN9xkRQ&oe=69DE46EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
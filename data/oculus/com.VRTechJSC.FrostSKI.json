_M&_nc_oc=AdoVAIfh-5YWq5B9qY-sGses8mSGNOGL4ls1vZqN1nSk7oImaEo9gXWobGQy6_X_DCo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XVhWfCDxM-TvX5dHs2q9sUuZ8oB0TSeRrb37LeWAU4Q&oe=69D646EA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubbpmd5hdnQQ7kNvwHBrKXT&_nc_oc=Ado7f4YG2FvygcjIqah3SwLhIuShcfpRdKi8Eex57eeojld7usPdxw49u6wGBX4x5OA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yCC6ety1RTjRJ_zhsndP36OiaZe28op9_ktaERjsxLA&oe=69D63031"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIaRuBP_nUsQ7kNvwFqtRSS&_nc_oc=AdrL7rQTsksKzo2z7_EtrCkox_hWAJl_GSago6GuhfMiyAkh6zVE4AEqHwjDgGloOWo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yf2jYkspt-fcx2ThJ07YlioE-73n_eXNpheTvQxKCig&oe=69D65736"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dS58fVLhOO0Q7kNvwG34VGZ&_nc_oc=AdqbLRTMOIJXJHvC22K9ICRhFULei8rcXMGV65Md6y-Q5AkXmLdsZmpjD66I7dRKjA4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qszOok8_zGV2-55K1kI-WJZ1sEZznzrAUxgCRZRL1dw&oe=69D63C7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wtt1ZapnvmoQ7kNvwGj02Nv&_nc_oc=AdoAzoWpfF7B6dFtO-eH8ixCC_NqVPDiQX0aHY8ERV4wwbVNgLWgSZI9pblG02LOClE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KNLNuzNuwqm303OV2_hz95dURnsYv0D2pVY_wiZXEzg&oe=69D65DEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
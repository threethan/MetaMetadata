88&_nc_oc=AdrZtinAdpdSikTGK18ZFrJNPhK85mW0PiSLMn_RSIGjyapITMYAiF-V9aKSUcFVYrw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEB8zW5KYkUqPZDu5D7jq-751LP4qCtOk1QJxICHQ96xQ&oe=6A7C63EA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbFz8e0DRvwQ7kNvwH_IfUg&_nc_oc=AdoXVJdGd2mADH6Ma3qZD0QK3OwPoXxcXV6DT_Z9NbSes_eccsUSvWaCOIlk2rmg3DY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWkVFZjZ7dJPItAvyFdwVJssLw3RKZrE6hRLIWdPvfAA&oe=6A7C4D31"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMsNZgbsUhUQ7kNvwGQ4Xkm&_nc_oc=Adqtc4aOWL9CVQRC49nm9h-RI7_iK836E0YkEI_W3_blUJNe1TKHJCslHUmkv9lJeCw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzEd7JhvJxmkdcZJfO7R2B4l40wOiyGfJhSBGZ21-G8A&oe=6A7C7436"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVnQ610qm14Q7kNvwGA-Mu4&_nc_oc=AdqdfcnXBNKonYjME_3Q6_iV1ZX40Rnoy7uq-VxwW9LFCaKvNr1VlJSfU9BB-QktWhE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkCdK-pdOPN6X6KYcAYZUodCamS6qiTR-164L9fmHwqw&oe=6A7C597B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apAUZGFKB9YQ7kNvwEDmJm5&_nc_oc=AdqSCBSNxSRhQGZlOSF-DqAwH7q9SVH_pj9vGM5gcIfguo1PwtDkhojuDJF40BT8AVs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcTva87noogKHVZ-C1cx7U3umrFFsQ0NpDU25M6xb-OA&oe=6A7C7AEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
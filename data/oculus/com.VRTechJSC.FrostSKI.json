JcR&_nc_oc=Adob07wCZaZ7J-irr3V0k0te1ZDXP0-Qk9FNN9838g8aseYt3hxK_I-9RYQP5o1Iw9w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKz4fMvl7cOy5QOuaZIvw16CzxLsihnn1piRNemzA0xPQ&oe=6A9EE32A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noG6wDZgGNwQ7kNvwF-7sd2&_nc_oc=AdqYMYkc4cQvfWXN9AaBUYthaAeSmEknfldetXeW6PtYEyBIyNRV_yqDRrGrkGVb5JQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYK3aFkExI7CMdtJ9qI4v4SY-WsvrELSPcBpOHRMb-Dg&oe=6A9ECC71"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwA-BjuedUkQ7kNvwE4UTQx&_nc_oc=AdpCDLbakFhDwf6t07BGLXEH-_lcDqtXb51DKQa-6zL5MfOXTdKrcMX5p3F-4KAp7DA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMp-tQx4IYhuAO9m5glmFp-NPCJTnp5E5koFmZx8PypA&oe=6A9EBB36"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQ8kKoBF3PgQ7kNvwGt1X4I&_nc_oc=Adp_5wTPt3U_VcMRVVXREejIFcHyhr3QIRIad2fPKj9lAESwoFJHpgIkqPJ49pakogk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIE90KlBm7FqCrPwbrcH0bMXlJPMaRCbsNwbmHL5WqHEg&oe=6A9ED8BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1MxnI7a4QQQ7kNvwFfhVpS&_nc_oc=AdrshHHXVcZOdbJMZ8BGXbr7PB51rdGvwhqimN11GGa7t--_bwghLczn_l18f-F51yE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILvJcpMwarIYLTgGId3VMj_3ZK3GE41dlUQYbSSXFeyw&oe=6A9EC1EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_
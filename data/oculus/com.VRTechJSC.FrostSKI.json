bq&_nc_oc=AdpdcTHB2qIB6_QOn7kxi4ENZLpUxrfLSx6I1tTaPe5nE4v7xfLvYdm6d2zcT-MiFGY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4d7rpJ-yi0nkWmVOnk6U_AILRiKJLCyG-V97MuVAyIQ&oe=6A53856A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkUyUcp3WpEQ7kNvwFROaF4&_nc_oc=AdoAZ-3rSHzaAWFB3xoo7-BwMtKbeJRsB7fP4VBX_swRbdxnsnJLbtNWvYeeyhmCB50&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSPeN9pNWHOsq11F-dK5puPkGbJjap5oeX9dtQPGnnJg&oe=6A53A6F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkWasoFusVYQ7kNvwHRoD-O&_nc_oc=Adq8jjaVRl69qMqTMGI-2pH9QS0EAbq78ilMqE5IccXxrmmqPWBbwe-A4pbb9h_eRiU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAD5bOOYI22FU3w2gdsgXISnKHK1BZ8cxG-_wZePZ4lyA&oe=6A5395B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SykFm-TpAgcQ7kNvwGW8F1h&_nc_oc=AdqVPTjTfr34VVL1iB49vU_PqW6-a2bvYq36JKpUPI79TSYD-87BhU2Da6S0th9kJ1c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaxGl4444s3CY9EtrnIgp100CJSlhEEI0imu-SVCm_0w&oe=6A537AFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zu4IWcrYl6YQ7kNvwGUKA_N&_nc_oc=AdrRyCi6s6ATvBpfXvEoYGZdylD6SMSb3dtzrmpBfEJUURX8VRXhMo5WxIQ2caUJ8RA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB78upl440jAJo4J9qBUX2kBrjL_04T5jFfw3w-UO5KRg&oe=6A539C6E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
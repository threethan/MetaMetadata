5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7T6UFMhhPGMQ7kNvwGIgrX8&_nc_oc=AdqYff1C0fn9EZG67mROyJ5OLym2ZpTm8vzBfDhBWomh9jxdA2G5J7GjUYX4xWY8bOI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCxGwPAcx5n6eH5MCyBNiheaeymy26YqCVkr3ZOfNa_Q&oe=6AE21FAA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpDKXWMpAaEQ7kNvwGY3ZfK&_nc_oc=AdpT2jWXlhVaJ426iBaqwJAmWI91dtg17J3f62R6Zg0qbKOZlSN2HaVo_hh2Dy3vL7s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzGV-ANDa5Pth5rtmIoiTnHX9mticMRfDl3GYpACu8eQ&oe=6AE208F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLbKkxoocJIQ7kNvwF1TNRu&_nc_oc=AdrKbbf4f1IFDTZS7E46U6S_oTyMdVYrrOYR_5l0sU0AGZhhnyLplIojosu3VvKCisQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNY1IAUcf2l4nAJXUDhsS1QHh75Ibs5VVsb3-s1VBaVHQ&oe=6AE1F7B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvyXoXd5X7YQ7kNvwHbYlms&_nc_oc=AdqgjO29N9_zndOZdORbg_x8h3M0LENUV86cFFU6SlqXgr2uAmrC60ciqDZchq4l6Bk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMb80Aeq5WLNjFwbzjreSflUZmm7yPAjWYvn416_eWg5Q&oe=6AE2153B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gmg_4y9IL6UQ7kNvwFrv8Fx&_nc_oc=AdrieRThB-mGob2dxlk6WuDEeYbElhC-9ahC9qkjDLWGbT8NiZq4NBbkaLAadJ5Gp3I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfze6GrnnGmneMusKRHOQKXzgRAGW49YDYck_7Q-LNpg&oe=6AE1FE6E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
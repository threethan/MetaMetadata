z9&_nc_oc=Adqye3PhgHALfg0jP5NIin2C-v_fnFfw3t8QO9Dqw_WhgVGuvvfwRHwJtzrOVN-9CUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWeYXRVAJaskFHzbVhwaEbgADW3cn5PAKT4UOdMAEqrg&oe=6A7F06EA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyMuzwJ613gQ7kNvwEdVUNY&_nc_oc=AdoL6_Pzj_-EM_YWxXJyk2zqDh8kG4qW8O22Oj8NvCnZe9LLvL2KNx5ima9favimZfk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQsNS_75YO0hzkTJZ2vWRnoFLxoK5spbbMnM1yo3_WwA&oe=6A7F2871"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMsNZgbsUhUQ7kNvwHiqbwJ&_nc_oc=AdoG3DPF1fHEqAAvAaWASUati59HzHj2tILB_WW7gQfBvs6sMvNdtHMM3ZKvyKSPtBE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSud6SVKFcpQ_TfCFoYudNa-jiziHAdVs0qHCx2YaX0g&oe=6A7F1736"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPWspJt0GAQQ7kNvwGwmLJR&_nc_oc=Adq1mSDLPq9MPLytFCo-EXRgbPUTQqig6-cGImr_uAA2uaxi-u5WdTbilLDR6aGwrWo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6R8cmN7Aqk2Y-1z5R1hV-07_cD-prsIk2qSTSBlbcyA&oe=6A7EFC7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49II6SO-f_oQ7kNvwFuv2tf&_nc_oc=Adqb7iUxhDQaT1wHOoxWsCwXlsiem57S5n4sM2dFDyZcQAwm0Im-ER5j1v0VKFH9WTw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHE42wZFufzR0omOVjLTnIVf0Ccd_7WRaI0k7-kMXAMlg&oe=6A7F1DEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
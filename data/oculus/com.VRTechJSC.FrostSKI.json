Fv&_nc_oc=Adqq2yWL2GE-u-tR4Sz3GvbOBUx2d3tn-1hlI_mUvxf_94tufwg3vwr1NKcY7avAlIg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGMRj7yx8HY2lDpsRMpH8Vmnk4D7z6YbGP7Wm9d0KkEg&oe=6A56286A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkUyUcp3WpEQ7kNvwE7AQ_y&_nc_oc=Adq5z9ZE2HG3ZyDhRE91Fba-s7SJdpoar5IQk4b6p3B99-8SH8VPtiUbD4tH9GrqB24&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWTMCjJCCUSCPDGe9sNLB0wdb3xy5dttPXj0NEjmxyCw&oe=6A5649F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4eON8aLBvQQ7kNvwFQMkoR&_nc_oc=Adr3vYcfhSgb41hiHCnyYwyGfVRfJ9UiwFKqmMjtzLXSQGNNDewhq19cl-n-37sfhc0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxyboz7h8-08TiMqv54l321JdA8mb47O3LriJQq5KMOw&oe=6A5638B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SykFm-TpAgcQ7kNvwFrzq9a&_nc_oc=Adonwpo5VLMXSsfyxHZ4kdBxUD6pWE5yAWivP3PzecQrkvg2GqocoLdnBLFBvlPmy4U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEZEPqFnsvGhKrAMHaChCzMcNnWTOyxg2MNK2EHcdGhg&oe=6A56563B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YY0mjm_B8bkQ7kNvwGI9oq0&_nc_oc=Adp36W5OV_wuTMRZ2r_mTd1xdhq8Pz9Zqulw9nNKAQDfAC2HDUZFVlPlOLk_T_BZ94s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3JVgt8Q6XQI9wfRzOKHaJaO3tBLIxBLdfnKctscgUhw&oe=6A563F6E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
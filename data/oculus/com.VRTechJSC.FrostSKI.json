Ue&_nc_oc=AdoLgWKgX7qir_hkFh1ghKGJ7336ktDz7vo5ad45z1zGOnWE0tpxfefStyuBRZ62dtA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmupFzKTiHm0Mz6yqWetkOHvusik-zYu1dvgpBaqL5-Q&oe=6A941EEA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrhvvkOsjBMQ7kNvwHQbGhe&_nc_oc=Ado5WK1w5KRAn-slVBlOw9mom5CUQeREvGm00JIgukv003Z_yQEb10Ek6igCNrk2ZzQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTc974ALnzqW3AcO50xJIsq9zShGGts4lGxHs8UJ2QAQ&oe=6A940831"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGP6fzGnQoEQ7kNvwGq--Md&_nc_oc=AdrkWInOMvBonA4db9AgAf4kn5JzlAQskTn_u5lXWOGnrtVOmR0e19HEkzLw_7eo5zg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCgvI8bVwpDnkaZrA5bsVKerC_GzIswS01H7-cdQVVuA&oe=6A942F36"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnGfrVLijnMQ7kNvwEphmRD&_nc_oc=AdoqQ9fXTnZCizRNWZqUKVYv1BbrI52HaQE1Qa3Sl0LUZ6UsgXtzOb8Gu5Pd4MzQhEE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUk7nHMnbG91m3wk4sI6u9SQwKzbj9MVBmfxK3C55jxA&oe=6A94147B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAsQPcVW7DkQ7kNvwFfmbVs&_nc_oc=AdrjhtDMQ6kRP2ZzCUjzq5XOxH9dfmU7kdBA12woAhzh1ATaqMsfbgN5kVoArr-1WGE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKQsNqIBNoVAl31pYVNbWq8YtxLI3SeLM3FHEdby7G-g&oe=6A93FDAE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
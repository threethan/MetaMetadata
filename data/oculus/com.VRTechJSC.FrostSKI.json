4.5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Y8NAnI-PNMQ7kNvwHr9b2r&_nc_oc=AdqM5hHehLCxGtYm5Lt2seYG3jD3vspIt6xiWm-db1tu81882U8Q4ekX8iFPfu-Cze4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIp9Ho0GAkjQb_bR1FOdCA175EcNwhKoYeDiYyNYoGvaw&oe=6AA936EA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGOD_Q0RiscQ7kNvwG-c84B&_nc_oc=Ado5BH-13KwSAxT-IuMtCTrSneOjXbQfPKus205UEXCCp9Srm_-QBZNpANqk0L252DQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIx4X-Kx66iOxK7WfT4-L1E09AnJZPwYQ5Cka_MfByeng&oe=6AA95871"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzESi7HNkS0Q7kNvwENJwFN&_nc_oc=Adq6M-JhV4FsAx3RYvqNcJIUPxiLle3sCh0gg9djs4IfFzI5wCQ88maol7GiSYarW80&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0mpauEGATN5XerVa4fhy5rWvgMjwM-WIWiAMZ-3Qskg&oe=6AA94736"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlH3q4ukKQAQ7kNvwF4VL35&_nc_oc=Adqh3CQQLuUAZletkHQIRjZhaHloRzzOyvNKFgksz863X0yTUdB8agfGbcQU59SkjUw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVm51dw1DmuqIhm_YosQfyNU1AoP7p5Xsa-ftVwwpTWw&oe=6AA964BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCAPr02hCosQ7kNvwFRjbVH&_nc_oc=AdrRj-rbjGAQYe96niDARk1LHC9SNqSv0-3N8HJWw7W2XFWeK1Wb_NLky9vidE9rRX4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJw1qbOIzhKzJFaop8ufMJUWE6YgrDUCK2VgmuX9zvVFA&oe=6AA94DEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [
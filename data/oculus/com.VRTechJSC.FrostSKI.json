tqDn&_nc_oc=Adrr2ERoDqIhaxwwLrmSD2dZ7I-ParYAlxMuq84X1sLtUtK3YyYoQLDRJMoTznd3dzA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6L2S-_YlKuH-5webF8FuDb_X-3ZkBcg9hBuT2M6GBuQg&oe=6A119A6A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SavJ9cdQJSYQ7kNvwHAREhQ&_nc_oc=AdrFtx2QoXOGcX884UjWASbahgkAEF3vO925TSecSOQRx8P3UDjrlyzd0D4sh0t9g38&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UpoG1v6Ecaiw0qgC7eGhyDhTcISYbCvS2pc-hGvKr0w&oe=6A11BBF1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5az5DsAw4uIQ7kNvwGVDPM5&_nc_oc=AdpOYGRk6CTdR9L-K8vnmMoLgHz45cPxZcSojbrPzPlLV9nqWzK3GIhWKt_8RLuLwSY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jFyGS0iJXTQmhJFL1Aj-Z5znlN2YPDS4k6UfOQi0Aew&oe=6A11AAB6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFUfAq6yfZ4Q7kNvwG7l_O7&_nc_oc=AdqLQxpJzHTfdhtR7dYLe1LyPySyaY3t_KBbrwZpQmjbdsVgIlFJ9bq7ANANeqUpQNw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jdiJvNxW1DRg875Votqn0hIxpK_1vD7yi9j4IY78ACg&oe=6A11C83B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mHEo6SkRlIQ7kNvwG66LxD&_nc_oc=AdoxRPsRD0be4k1DwrN50LZGYlfXX6yuJ3jFSuBxiXftoc4LyYjKghpOVUTG1CMIOtc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af638r0Ca3lQEmcyWH-UX4QM_-O64-lBtCkTF1Pa2iUNDg&oe=6A11B16E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_a
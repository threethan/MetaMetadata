fw&_nc_oc=Adok1QgBXnJ4-COB-WmN5QfMEnICKboIVx17fkFt48pPe78sA8yX5Ytyf2Gyb8_6Hgg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2K0N7XLxW3XW3QB4l21GAE7dE1DCkgfoPh7FEJOwzvg&oe=6A511AAA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=laeXcQS4LNAQ7kNvwFltSkS&_nc_oc=AdqTFD_QC7Ct1tavIgsI-38rEMoFO_glSDsjtbK8WP1to6rZsMU2luTyn7S4CjHoClA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoNEJ3CYu1JdRagp9vNOQP7reRGuRLIlxhiKVuwxgjDQ&oe=6A5103F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkWasoFusVYQ7kNvwESkp7B&_nc_oc=AdoKyL807v3qo7qaxEjZvEU_RMcL4Bd_ko2G6gap54aLN9jCKsoS0VuiyVZoYewXTUs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAS3hrNprY4yy7JX6ORrbeSaDmZLw0Zv0kDWjJsNeQxtg&oe=6A50F2B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4s-o2bL04sQ7kNvwGjtG27&_nc_oc=Adp8qnluP25Sb39Lz2CdpHZjRujvuzhVuM85JQNc4HCN1wGx5Oqam2ZdJl_E1DFpjgk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9ko7B1JfK8Sw2RQE5PB-2ZVFk2b6hHMpIkVp12lY4Hg&oe=6A51103B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hb075wybvbEQ7kNvwEAxVg0&_nc_oc=Adpi4WfwriWFMwVlGOypJqCAbKWYPUhCBpYpNGZBx7G3QU53vKiwwleEmcz3hebtJ-w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJQQKRe67-oVC0zxQREv-MHj1YXHCaox5HEvNbULy3qw&oe=6A50F96E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Q3ytUl6NpMQ7kNvwGq3xDf&_nc_oc=AdoDV_PKrMthJa0EUH_zTX6JOCYHrMUIOIadZ6RP7faAwZkuFK7KAPXO5LgyUq4x21A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQe4UbfjcpQNXRsDOfKMsfdU7T_8R5AIOhxmNv1pPp0pw&oe=6AF3432A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVV8vXhK1rAQ7kNvwFbQZTk&_nc_oc=AdqRe24ujJMAPKko1SZIxQrFcVU-YHw40Hs-Y3TcJf6-MGwkpWHuVTUqgOl2gSg6q14&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_aHj6DqKU3jWdifWHJXJR-mjbbUddiJNK230QWCcj7A&oe=6AF32C71"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvC5HhiNsc8Q7kNvwH_chbz&_nc_oc=AdoSzozsG84QRkY0Qd1tGxvDY_i0YESfOmF3Sa-leRv5KspTwDKFS8jEoFt9JHF5cUw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMIf5bZrFVZCnrfgzHk2aDRm3XqtFO5KA1YjwA_R4Gew&oe=6AF35376"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95ZuskSx8pUQ7kNvwHLE4LW&_nc_oc=Ado004dJYmZxnWzhvrw37yjRPzCnveHXJIkhT15ruPh5PFEOXQbnCTkuuRoUvEl6euc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUGvDqnWvPZ5SnlmTPCuDERYQpWYMB9HxEkVdJKmDIoA&oe=6AF338BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nu1-fpbtIksQ7kNvwG_zrJp&_nc_oc=AdoSDw4WjAdWY98bgqQnGLYOqYMZuXmO1FJcykISHZWGWY3-UeR84UCc-RGXuim_Dlo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSGm7-mw-sEFYbxLnk5-0z5JK6Qs_wKJhHb7mPrD61iQ&oe=6AF35A2E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
-Q&_nc_oc=AdqmUvW4RErKZ79hO4_B_OLhCQxinDTSGuSLUQZhFXakXKJ1dN9nXksvl2qVxt9-NCA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nJWVIhMaIIOtZ1PD-ZngmiJ8NQr1R-bqlKxNOZd95vw&oe=6A3AB12A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LMTUURkAroQ7kNvwEDd-8n&_nc_oc=AdpH4N9KiwBjM08acQOTFJWIHYrSeHOSmrLRG1sHlJXIFIC6BBZZJJGnxTkM3huQ-FQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-im0vNu75bhwCOvs8CUqabTevJHCjO5Y7Q0eeYpJfEow&oe=6A3A9A71"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJZwYxj03YkQ7kNvwEkbLQN&_nc_oc=AdpQG-Yknr9gb564Avlic7cDl7m4H0SalI1hr2GGltMPBEAzkB4RnOcQcUskB35cw_k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6J63izb63_6B9u1UTyr9u-D9SYs_niTVxvJnmQ72Pyw&oe=6A3A8936"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufmJBizKUwEQ7kNvwEWPfKF&_nc_oc=Adp7ULBiwsfA9P-Xrdco2lapKj0orRGicnHd4CGCxpi0qvXHQDoJK47K27OKGmBXZHI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nh9WrmiPv-FcBKYMQxnfUURGtNGkWMqzO2y_urjC2Cw&oe=6A3AA6BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fe_TwU0dbXUQ7kNvwGY7CNl&_nc_oc=AdpAvcNAWiOFA04RcgDUJkof48tUqgcMWc06K5XnZ7B3DFF8dG6FdY0_wuSAql-CH-I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TgiITK_FZWnZE3907NCeMHCdL0DY26N85nENubIXEig&oe=6A3A8FEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
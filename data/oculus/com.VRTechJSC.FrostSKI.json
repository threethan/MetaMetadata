5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pI040VbYywQ7kNvwEJ-9V6&_nc_oc=AdrV5cHTL0iKmS1NvBf93y_tTX5sj3NJ2jq69VMaMtIm8tJcnxZNDfNEqofEFhi81GU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPglpG7zHVDbUWI90WOsVU_AlNchXSXB5B-kI94y2CTWA&oe=6AE6142A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvE5ZXJ-jHgQ7kNvwE6f7Te&_nc_oc=AdqpGTPcMOzJWpHZgEVxBj-LQb073t3J4M98DoADnRC8touX7sPwk-J21BhL3lcDUkA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-LVusjSsEHh2dcn2zWMB3-qI_TYrk0Xrn7LM4MvINdg&oe=6AE5FD71"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttGPP_jy4bEQ7kNvwHm5Xts&_nc_oc=AdpBpNLYLfNDeBhTomznME509UEp2CDtwpYBmDX9HhgHsCqY7vpRUYi4XDnjuchYlBs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1OBsNaOymdrZlGcykUaZ5ueRvOnzNGotI3ym9hIN95g&oe=6AE5EC36"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKW52Q8_p_cQ7kNvwHcuOAu&_nc_oc=Adp0id6ZEE6JdiONps1Wer1_M-f6p1orvf6n2J1OodGat1xJRKvEmxifexctXqyqZcI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5CDCau63NLSi9zoMA0Ot19zfeP3AWWk3n7iHzaiQd8A&oe=6AE609BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9SI6RZjwskQ7kNvwHO2YkW&_nc_oc=AdrOy_Vehe7FmTX9SuXsOfHYr-yGlm8DIToLb9HzEvjKMOr3v0FxLpNWuMQnUs9GNl4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMB7pyuZM6DeGZoaoyy5ZhTXmQWUeSZuw7HRjXN2nhpow&oe=6AE5F2EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
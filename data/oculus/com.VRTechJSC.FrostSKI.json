content-atl3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygqrd-t6110Q7kNvwFOl6cw&_nc_oc=Adkc572OXuvIJhvvxTrFmdj5OfwC3Q559kfHzZyDLGirXIQqjvTCPntUoQBbo0zVOuA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afywii1jvkh2dgQC062SwPyl3bJCkuxF2DydYKmtoZtZMA&oe=69BA80B1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZcAKbzg_poQ7kNvwErAB4O&_nc_oc=Adk3SP1jSw6CiLj7fHu8mhxHEpnOa9sXs0Y8aaV5gerXaOZoq8dLx7Sf95Qor8BVcY4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzfN0cFHEj0ANmcJJnVY-UUM6lzQKCnQjgOP8PsO50q8w&oe=69BAA7B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqEaNn0LZPoQ7kNvwHp75nu&_nc_oc=AdnCYVwNl1KOu1Qto4enwPypwzmiabFLTgOYaxXSe-W9y_YFpmpilXby4Nl5qgUdfII&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGXRnYBFNqAGOKBXHU9OwpoZv2XQ4pirfOxM79vMhYdQ&oe=69BA8CFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLkP7DUsTIEQ7kNvwFvZL89&_nc_oc=AdkkDTMIM3WBR_xvEeIM3G5AYjD7574DwfnEspRbz8j4jgOiYYNAcNXAeE578CYu53c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw0LBrFJLtS3sB1fTDLUCikDr2DtGO83av20hGPm_LB7A&oe=69BAAE6E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STAN
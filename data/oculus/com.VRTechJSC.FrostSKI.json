7_&_nc_oc=AdozsrP65dCxvelpW43CRaKg34yf1bqILSpleTdL2Y4ewrcvI9dJClzVrL9exIW3BlE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bJO7kqdHgOS1Rj9c1R4EULlVnO2LfVEkcdG-gkIMTaw&oe=6A3FBEEA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DE9S8ySaSIQ7kNvwFgakfg&_nc_oc=AdpiJ3KAKETk9wQkeuTWozB4vVz1wj3Q1L-2n_-4n62pR2E9-wn38zFNCHGpjd2fDUc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1SFWxw7-BDx6woBXys3sgKE66HR-bgmyGhfbU_PEq9Q&oe=6A3FE071"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqMUhG6PotIQ7kNvwF25SM1&_nc_oc=AdqUuOQrGPc95BTxQxCZgiuHzh09LiwqlKX7ystXftub-RV54T5Vm0erKFe89OP4-Zk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZC5vP9v71U37tWdUalsTU6i2Ok1FttMYf_aCJtD4sjw&oe=6A3FCF36"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nV_Pb_7bUcUQ7kNvwFyF7l8&_nc_oc=Adqg78-aE3xxizIDN61RuSqgpOxAH5__g89li72x6DlsWjTcbQQ0xOFf6CMC2A23JBg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6fhx_KJUDjbif5Ujn3-yh50Ie74mmbxYc1kzTl3D4dA&oe=6A3FECBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVa4pQy3BpQQ7kNvwFzdDTk&_nc_oc=AdqGG4s75mBaG8MxlhXLkS8oETQlgexXiRc0bQN6EVcx_ZKDf1RGMKnoTagfMxMXiVk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LAfVPRohUjhJsy_C-VJQzt1qdxPmLByWL53RYcdhF4A&oe=6A3FD5EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
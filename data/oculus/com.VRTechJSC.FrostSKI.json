wq&_nc_oc=AdplzZE4pCb0rv8Cmnm0_H_ust4zP0DiU_kSVPM5mSzkuVSzzTIm2NNqd4XDTYUQUaQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-yRa-k4f6J7p7sOV1nkfRBFRlyImEPwSfSDBhidpuyQ&oe=6A0C546A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSwHt7N3euwQ7kNvwFnwzBl&_nc_oc=AdpirorUVhKsOD52GOOf8c7pw3yMj_P6iWODlo6SEw60sxI6nCMJuL-hOJo7eHyf-sE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6d-ZLrZ2xo7TxGILLPBpbTfb9cKWEP20cBrAEBVmoTWw&oe=6A0C75F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOr70jQXaFAQ7kNvwHqjZfU&_nc_oc=AdrBiFOiJxHkm0YfZ2QPb61YYZOT71uRjFQlSjS0Fy7vhGhiKD1WyD5Ubowl0APeKD8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PjukyAj1LtRc83YeTWeL39R-9UcQg0JokMNFGBfAJ7w&oe=6A0C64B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWF1r1wifN4Q7kNvwGX-Hym&_nc_oc=Adqm9So_8A_ZZ6qwyhJ6rnMWKGE-I8Uz_n5vMxSnMPyz_Ah8Ek2UjUoy6jvb08XHLto&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zyLGinwAcdjTohAyNWbvCv79kFj_gaQGERAPRC8x75A&oe=6A0C823B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LApokPGo1zYQ7kNvwH2gE00&_nc_oc=AdrWIC0Jb9_-45izWzOMbP2OBUihHX44Om5PRquIYE4gcmep3-WTXS3erFF82OTXCic&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YKCYr2BWbE6A2P9PNblqjMcdq_2-DzCqvFkPhSiq6KQ&oe=6A0C6B6E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
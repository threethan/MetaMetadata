mC&_nc_oc=AdqefAL-r9xuDOBEkezLUejKIHsebZQCs72ESccEGTzfRVGUitxXmZhjziVVuV8rtxw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hfI4wVsyFRQnFrnEmgIuhsTjY5k6OeZF9upuE8BWkKA&oe=6A0076EA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MaqF2Ydz4YQ7kNvwHL9QMA&_nc_oc=AdpWKwlkXTksv9NTXxjUZ_75R0-HDO422uxPcnzw-eVlE4V8avFnQviyhu5CfIiA-LM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iRKrDfMMP1zL8aSxpvOfwErHD-vAU1e_YWQBGGKSNMA&oe=6A009871"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8M-nQC_1tcgQ7kNvwFwLr13&_nc_oc=Adqiu96n6mkKfTFiTzZlG5CZvSK_avZyaPnXfJyh0uLbae-0Ypr71uwMi9rSVsnKRYA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6j8gSKqRfZi-du4AVVXvRi-PA5YBogFUrnqy2-7SWdmg&oe=6A008736"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOybV5gR9gkQ7kNvwHfU0wm&_nc_oc=Adq-oaEo9qy8gIwU8uXGtN4zJc5LN1pgBCbl1w_YacdZbjTmBVkvMC5ryJ3Z4oYxV_Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61yx6Amgy5xscSQPeYrxkcouO5dqLZYNg0kiwhDwOyWg&oe=6A00A4BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5GlObygb2kQ7kNvwHpIcr_&_nc_oc=AdqI8kUngu47ATyUPG9RL_q_fcKiMqmBH7Qod2D98NuVmjXNgEfSjy5dfTAEcyDr_yU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BayOlP5m3tQrzikP7r_R2ntDmvVj37a-MnvpiQmMaIQ&oe=6A008DEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
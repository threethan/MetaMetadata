xl&_nc_oc=AdqAcHJ7c1nl8GgHrFbnRb5n5zgWq5TXSp-vBFG8fbdUit9NIZMrLXsDnulFCR-bHNM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCr10JLMNFpAu5aA2jMiWCRbVvgLGWksOSk2_dIFEM6nQ&oe=6A5CBFEA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNOdNUIPKYAQ7kNvwEITYTL&_nc_oc=AdqahWefenxTMvxydxQrO5J8Y6eGFvlFswlwmc66xSH9MsFd4EkqpfHbg5XW7GZj9WM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxh9amCQOUUZpY-WtZXI_i4YBpDVGZgvEk1Z_smgFGWg&oe=6A5CE171"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zn7gRNQSGgoQ7kNvwF0gqEb&_nc_oc=Ado6x1fGetUL3EJ8va4AGamjzxiZGjGpiGG1m9dhmWAUW7d1QK_N5u9agDMpNDeC-Dw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQXDtqZQG8gnMHHkneVGcDG6f7hwfz_TCe21o2AVHjIw&oe=6A5CD036"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdD5yb-PcxYQ7kNvwHYPOJm&_nc_oc=Adq5WQtwL_G1mW4uKCmO9G_dCED1BNuwvZJk0ugW2P-OObfeImptN4mdva-cxyHdz4I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC61Fy7ob9qFzHfCDlibdfXoJjI9w7CzEcbUmtduEUc0g&oe=6A5CB57B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfSmG6_7powQ7kNvwFdp4H6&_nc_oc=Adrr47zDQkWLqUNJ-tsZF02d1iy4EkQRo6GOwmwujZ8GWzrkw2ylhoYS-VGB5lOQScg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZienXLIfRQDXDpNMXjgqTzxLF8k3bIH2YD43jAolMQw&oe=6A5CD6EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
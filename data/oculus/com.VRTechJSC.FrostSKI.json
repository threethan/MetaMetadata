ka&_nc_oc=Adrvm1CFfUvBhCy3LPdXHonwIVoFxh7KJCjG1k_b9PNkaUuGIACwtjf14QzbyFpHlIQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFqOv1KweIFHAiZkzOY3QlxdqGtzYVjdK-P_7vuZqr_A&oe=6A54D6EA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkUyUcp3WpEQ7kNvwFjXH2j&_nc_oc=AdrmIbdUhV2yzaHw6QgatFJAJdf7Q4r6HKmlm3vxH6hC_KTlDZ-HosMKuMlvlgfrdG8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDh9XAmvTMbqy_TgxXcoKsekbM0qx-rcB6C5Kdp_H5j1w&oe=6A54F871"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4eON8aLBvQQ7kNvwHTyhvJ&_nc_oc=Adrjum_xjlrVTKEmRcThBK1vhmmEa-ePZRgncHJGxoiPe4mEHHfS6vPwdYII6OFreTM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwfPEk6G_U5MvMXenBEeAuTXJZ0CqjFEpmaUka1lJC4g&oe=6A54E736"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SykFm-TpAgcQ7kNvwHh35L5&_nc_oc=Adrecdj6WFRmTQGf0C_bqYhSNH5DI1pu3SXyI28oWspIIBusUuBpMUqw_HMqTLCC8nE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdZPNzguvzeW_ATq45J5rv5vxjydxu-nyXCTS91fkI_A&oe=6A5504BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zu4IWcrYl6YQ7kNvwHvqiMH&_nc_oc=Adr4gFCjhA4S71CSzjVZ1Il_8Z3NfBPVADEU5XJtMWWEWwWLp_TtCMtMRogcQZd9VQM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB12OzWUxkCx-Ovjyi_3A_BVUQgDKhEDgIMDS67GwWY7g&oe=6A54EDEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
mW&_nc_oc=AdoYGHtAoyMWrFGnGLjtsJFIpPARhBmWvliy8CqYQ5fIJKjGBX6-J5sdYuVUJdQrlEw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3IbxIoA_IgZW3E26Y6Xsk3akozcd3ElSwqGez00sVszw&oe=69D3A3EA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzBYWktUpOMQ7kNvwEkv_zw&_nc_oc=AdpwHoZ6tcsm1qNoAD-0qwGt2AlSlLJ-wTMY7tK1HYH2x4wdMqzlaK2jW1Fvs-SHDyo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nFti2gUtnOHx61jfCQndignC7EMsOKBsz30wbzRfN0A&oe=69D3C571"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MR1iqm3mxwwQ7kNvwFcesEP&_nc_oc=Ado0KsDdvQhf-kH8gxEVwBAd0CpSh2ccSLYcXNfEVEz5PIIvtnRqGoaq_y4ZRrAzTL4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uuRH3hRdypLyARDL6CNzcCDqRMOkmINu0LWsZJQwRSw&oe=69D3B436"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czOU5y2lnnkQ7kNvwHPFafT&_nc_oc=AdpVvxqc6rmYMard9pjGtU6_XIiaGYVA6MX9SmyBh-s5V-nRbySKR7fmP9MLnOh69zw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3egD0kfcrENLqnpGsPlU0r1PZ1a1tuSrIbVpr1DSSRaw&oe=69D3997B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wtt1ZapnvmoQ7kNvwHkXz0K&_nc_oc=Adq0b5WG1XZEW4Yd_XBzbPi7HBvpIh7tDUOE4ep-zGK-lORKJiUFmf207RO-9IgkYcA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af144SVQXWrg51fi9QqGMTmmUf1UIs9BB4Rd8cZJTbAFsQ&oe=69D3BAEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
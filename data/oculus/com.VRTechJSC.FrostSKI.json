ix&_nc_oc=AdrbIa5cfsgjq_jHtS-6TCuYasafMwvqc9bK-mZKLeH1GVT9UHQBivEPXZVQbgAglGU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHLVMKYlHasZBThWwpYfxYWPv3FKRn1n7-bDjZRS2MaQ&oe=6A6C91EA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzI0XoEamfsQ7kNvwHqorYj&_nc_oc=AdrMosTpb0abR4dYQ6ScGYkoEYnQcTuoh_JfgqgDwRJf711S7BrKKyifVFwMrLFMytY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCH3EnpO_WoAKGtL5shrHf98lrVr7ATCFwyOEadAVloCQ&oe=6A6CB371"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AND6KlFr7IQ7kNvwH3bD0r&_nc_oc=AdrPXCSfLV6z6mz0wRHH4ns2w5ZtBHSvpJEckg38miqXR5tjxp9bugNzw9AE-W2JXbo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1Mx4j2O84vJXPDkeBTShaeHr-EGbow3ZmFzwqls1JZw&oe=6A6CA236"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yYUS7ZUz4IQ7kNvwGxcu1X&_nc_oc=AdruS2-MFJ5j05wl161RF-0ywagSSUGwYftccWmFkirR2wmHt4N-0ah2vHW4b_Dt-38&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJx7xoxvTE6nyHtLcWVtKy9QsbiYibh19ZLNjFEq_MaQ&oe=6A6CBFBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qjbOimizn8Q7kNvwEbmcMa&_nc_oc=AdrneXWvTEEbMlN2dgS9ue8wuHTCc8K-2Pzs76TBWmHmzsqCcldG7qGdB07xm5koesQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9eR-347HTRwMAfA653c6Wy-9BGELxGRXT2O0jQA5Y8g&oe=6A6CA8EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
sW&_nc_oc=AdrRyc3JhPwZl7QNGryajcuTjgWL__bpjtkjCJuli2ngqI9eTFsylgstHT1hQZ8i63E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzOS_ag_cQgS4kXBBKdF9-VGa3Dr1FVILVe16S0MsjNA&oe=6A73296A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adHgRHYieAwQ7kNvwE3kgfO&_nc_oc=AdrEMzeH4wtvDtovENIijLWEPzRcugNEuA5_nxaVlenvDcRk2spO8AH3hKUMpvMQa2U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQ8iRXHsGXMjf66rOEwtW4IqarONeBCJN_KnuePOcHjw&oe=6A734AF1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4N7HIoabmOcQ7kNvwGagYe5&_nc_oc=Adpis_GWjQTF7-UFh7jaXQyw2_isQzl8-s4xkomx1hRGCiP2vH0fazEmoWdeobbnQcA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFw9MgILEYDRuQltPI5pR3RQ1p1VC0fvm8mohzFnFm6TA&oe=6A7339B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hq4HZjr0l6YQ7kNvwHrwsay&_nc_oc=Adp52rflG2XuKMBlsAQeGR2XFcQkLmrih2o_G1U5EdeAu1bHOJWvoKgkHijxwgkPU38&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFcGzjH2CocaaATZdh0_0bvf3lvmvUgxGTECbgnj5h8Q&oe=6A731EFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hpn37rCx14kQ7kNvwFVyVPl&_nc_oc=Ado0amiizxtoVfrBLMXZozJy4MAmPRf-OnqCoqqF9dDBlTGyRm0hO9Cnxb4J5Xy2At4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFY9GvmafsKOTjxSkL_KdvwUaEbifThzD5whjhNSaM3CA&oe=6A73406E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
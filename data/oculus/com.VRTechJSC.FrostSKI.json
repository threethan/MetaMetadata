TP&_nc_oc=Adr8Rzp3RuBa2BDwy3Xsxn11v9LSLdx199-xiFrZRsuJ6FqO7A2_etU-cBXQfUlKZaQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KoA0_5_a9F_4rqZ7KXWXUCb7Yd0B-P5U3HyOBx2xj3w&oe=6A47E02A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AavolLJADfQQ7kNvwHm-owW&_nc_oc=AdoK0WPXiyuvPsvtuFF0D5NjS-e0lylJZUocl-9ojT59m74A_rPnJp496mfLVzVd-yw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nP7GT2cEV0VZZli1kMMJsaX6wTbBNpOP7cv1nsebRfw&oe=6A47C971"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nupTbfYG2ZYQ7kNvwGkQU6u&_nc_oc=Adr0CX_KjUbEi3U7EgQuZo4GcBYZxm8gc0HX2GAK9IcB38628x-q6BVA7VliP6Lu100&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8x34mBefEs7W4Q_USw1Y3qScszWqsx6qBlZ0xeK-X90Q&oe=6A47B836"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9rtMSifP24Q7kNvwFViNhy&_nc_oc=AdpCjw-nN6-MN0H7v0IGORQkxFBoEF3BNCDXqem_EpHWqXWXHsegbKi_aNTanLfNXTw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__1aozc-fyAsHb1uGE8ooToLLndSoHL3cFb3dIK90nUA&oe=6A47D5BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJVDIahIpnkQ7kNvwHx7HP9&_nc_oc=AdoVeLVnysOei1IR7fik6S5Ojf00mURA2Bc2QoWOQfYI749iG4_qSxTNgEGA52A36OY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D-cEGB8EP2qTG4Nowzein3nC9cc1lie3oHmIjeWRFKA&oe=6A47BEEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
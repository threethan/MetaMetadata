tj&_nc_oc=Adr0Xc5nM8J3IyhZzQZH3w3KQO5OX9s_2jkq40LlpyheJaOB-6W7ikuxkug5Tb2z9Mo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvo5X0y-rnMIiHHtQNi7ZBzpKFusUlbAb-VUixil2pyA&oe=6A4B9C6A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6QvJmUHk8gQ7kNvwGIETwy&_nc_oc=AdqtXjIXcnobUIHdSHkR0Gl2Q9WcxCQlt7cQP5D8q4zAX47h2QV6913a4aZZk0REifk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5ePDwWVotX77MLhHxudKXCWz9YmPawDUBz8Bo8zplCQ&oe=6A4BBDF1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKDtN_DmExEQ7kNvwHdJZMr&_nc_oc=Ado6M7Yy0Sr--t78IEE2Cl88o5eGalx-Y8YXRKRR8mOJcNNDPL1NrGpCVmfz58CwhJc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZPGtxM9lq-u1GJ9dYnvM9sYvcn-IUBcVAUmJQHQU3EQ&oe=6A4BACB6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EiHub3eO_XIQ7kNvwHLnoVK&_nc_oc=AdoWyee7bk1IR6cNRMDJoH3l47tQySJPpXmJutQJQ0T_FCfYbmh7rLm9lkYI5za7ljY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBM8aWVN6OpY0dC3syAZwLzsCLlZsbuHswUL41J71HxLQ&oe=6A4BCA3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzCFV0WtLXsQ7kNvwG-rukS&_nc_oc=AdrQ8QbX41WWU4zpipfo1YyAMLzJnMcJHhblNUolArE610WPtaFlNfE6bwWW3K3BS74&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGGr31r45TdnZxvuJ5DVbLms2l0f_4pRE_0GmSMjskkw&oe=6A4BB36E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
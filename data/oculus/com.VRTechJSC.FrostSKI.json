5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUUXxmvo6dIQ7kNvwGizOMN&_nc_oc=AdovJ3kAsRneoPsd7qEAdRQYIvOeXzWTZIeMq97gdb2k5G_k-q_TgWFjY7qxOAaW9gA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOO5lAXjxwvDjJlKSoD6gZVyKurJYa4QG8pvWYOJ8zTmA&oe=6ACA64AA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skNrW95hwm4Q7kNvwHCW6eO&_nc_oc=AdrY1XKOcrb8UWGgqtuSo216sslQhoKpgYIzJ52EGk3_QC0YmLhD82Zor1QgvndPOas&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOM4ANk3Sr6QEM6zgtdHglbhhp8wFXjpGwNLMUmRpGZ8A&oe=6ACA4DF1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmR4U9gZnPQQ7kNvwE6L6In&_nc_oc=AdpDeacouLtSCTxF9lS_ItCOgP4NmuemoyKiVC29-La8qzvb4iQrMFpSOrhxeNgUR2U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDIoPuOodKSGAPMdmbmpXoAdVFMWAVDE_V9ZDLNd56Mg&oe=6ACA74F6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHxeAJ4h6VwQ7kNvwHuZWBd&_nc_oc=AdoeiJnWja4UAtEBhm2DdmnqZrEY6bpJGNLoLF07lvSK0HcZiRQTAMMWeufTtoJQilw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmlxvBNA5aYSD9wKsurkxjTCzsujlQvCl9RqgrwGj74g&oe=6ACA5A3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKeUmiTScNYQ7kNvwEr-Sl8&_nc_oc=Adq0HTLgasZrGsqIM5ab2Xb0FGDHx2gFCvbhQBEkeNWlbl7WnM9gO9RYQSl29BGY93s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWNdZd1TSdwovGU9O1CFp83d7EUjhWsNr0-jQx5eaNHw&oe=6ACA436E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
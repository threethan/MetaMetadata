5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pI040VbYywQ7kNvwEbrdZC&_nc_oc=AdpVzskJoM6JP8lYJWdqgzf6tJcj2pLZ3mvn8sxlwRC1Dkdw81mkovl9itlEAJpZeuE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5a6I0oZrgBJ5rWF1bs-rifT2vRD_L9ssKnijhOpnYbQ&oe=6AE765AA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvE5ZXJ-jHgQ7kNvwHr5q2_&_nc_oc=AdqFq4H-QU1YsZH-rpBrlX0BqQ4rf_LE-tqoHskvwiiGFGpWzWnz1B1GBHHYWOzIx4I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSg98820yikdO16uSjHf5OZd3laue5MDLcS-_j2xOTSCQ&oe=6AE74EF1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQoCA8omoaIQ7kNvwFKjVMr&_nc_oc=AdqjAKBflYftDkDCR8kZjizvzw9wO5d9B8J8ne5UMGVRMXjTZMlK5j7C0sQ091lxwXQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNrdiu1CpanwxF0KJGY0UVIFrjFsOO4-fUMz8ZTCNskQ&oe=6AE73DB6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKW52Q8_p_cQ7kNvwHA-xSR&_nc_oc=AdpUENGwSdawR5M2xZol7yq0yPnzHQvuT0l6alF0gplsUVMTEix3vVHeCLU6PP3MrRU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRk74jTJmg3TwpZ-S1EkZPKBPJ5jRpKBX1I1JzQJ9c09g&oe=6AE75B3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9SI6RZjwskQ7kNvwFCkw5U&_nc_oc=AdpdnTmgzQ2LqzC4wLeSbTYS1h1CvvLgSGEn8AsVNzqwZsPKoFlIVCQr_Ob5TwV_39w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcMaFdlqRowA3txmMyrsAl1DDIGre2JCVa7Gz0fhDZJQ&oe=6AE7446E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
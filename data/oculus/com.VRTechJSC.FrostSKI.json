qb&_nc_oc=Adqfi2-s1onJ44MN75C55BNLhFqgqyZ_c7QcRM4T4pbmwVLXsXavG12wyM5IkDtux8g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DnDpH621b6zMbmfZnT2c34XqLv9z2xO5TSUrJRzZPzw&oe=69ECB06A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P419L6d7hNQQ7kNvwH-MoKF&_nc_oc=Adr2JPwqG5HscwtzNK4vk8-VT_Ox21TVmgV7-PzC7RHz0qm88C1pG2kGmkK_tgw9f5Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vnDp_WIyRuuHQJPWyhXjv-mxjffXizWpH5Da598BDIQ&oe=69ECD1F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-BMawO9PuYQ7kNvwGZ7DuP&_nc_oc=AdoQZT7JDoJDxc_YwL2wahqvWp2Gr4qvBeoOYqWToyu2tW0WjADkmcR2_WM5DZjkwcA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pNQm0Eq2iI7cPuJsCQkGsNwzmGkDmxA2bZ70Qeghf1A&oe=69ECC0B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nrih-gaeVE8Q7kNvwFzRyrv&_nc_oc=AdqUhv8xjRg4V-H8GWuYlusQlEmeXn_JA4chkAVtid4hHg-n65XPe8HMtxeK5hNvNko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pe86sUUm-4dzBpqZ9HuHZOh0-m9_HlD-IKNEIWDoAaw&oe=69ECA5FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXpmJukeWMsQ7kNvwEBJRel&_nc_oc=AdrBlfQinqK6VJUnCBIT4G06FMOtOAWJCxA-zBXUENCWgg-TrvCpuH6Ax_sn7Gl0kec&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2a5CCwJy1fb6EnrUV26ApmYkJuJr3AX9wFJ9Szc-9HRQ&oe=69ECC76E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
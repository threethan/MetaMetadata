OD&_nc_oc=AdqH-JzPkQ7En93j92_GcJSDwvuXJmC1mFUC-FFSNSgUei1VK-Do082yboayVpzze-4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlC0ik9jkxe2phOhcaefa4lMpWZL7YgJ6XYobL3YD8og&oe=6A65FA6A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZV1WD0WMlq0Q7kNvwHmoqeZ&_nc_oc=AdqUs6d0pkZyk1yN8mnhBoc5bVlTgOeWoM77ZjlDFt7p6-H0HYJHNJqOPYJuD2GpPOk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAL_97a1FzA-_G4ZqAbjMWkE7JLPf7k4D49pQP-e1m4Bw&oe=6A661BF1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4bLGOMA7NMQ7kNvwGvLi1u&_nc_oc=Adr9oFm7RzGrHA8MDRr9IfXY9K1hBavMp5x-gq5gOH2i8Qnbi1NMT_oS6ccMkxjOTgQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCCiFYkHwOdwEj6dwVdLoQxjB0K6Y1YiO8TONLMXV23g&oe=6A660AB6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ugK7flrai8Q7kNvwF88z4C&_nc_oc=AdqU459R85qN2pp70GmEd40HkXt4iRKfpbHx9fzy-tcDK5FvPDhstUgLWX5hoMn0X3Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBP21tNz_7kkVccFH1vjdqdX2oxysJKGwOowK_P1hNhSg&oe=6A66283B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCpbi1mHzqMQ7kNvwGi3k0q&_nc_oc=AdquO5PVUvLriGzFJFVmZa2WM271w216czag4ITGUBK2vm0TbKOKsJArqLhBHZBbcbM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgstanmRytV_7UWfs6D43yHJ-KJWA6ZT9AOuJyldVRJA&oe=6A66116E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
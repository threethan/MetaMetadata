EM&_nc_oc=AdruIzJopfKLKvr3gTrAS1RX90aEgn_wEEpTv1EUWynCzbRuxU5qn0fjKF20g5uYT-Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ofLFRwdp9z3nwzY9RiGQ7vSD_kbJf_1GP58e0V2vEgg&oe=6A3D542A"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZBmi3F07gYQ7kNvwHZ23Or&_nc_oc=AdqFNfWLIHvfClf-vw0CNm8U7bwt9C8rYMNpblx7EU57FN-0XcphjjFZCrwLW4iJncY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BUd9-l7-Es1t2KFmzGVv0wv1tajE_mn-cCOvnZzZX-Q&oe=6A3D3D71"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqMUhG6PotIQ7kNvwEruacl&_nc_oc=AdqmSxS9F8sLP1WEN9EeInyJC1uu6VbJdDcwJw-w4hVocaRCoXrLzFo7Wb_5RFd9FEE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80O1NpzHPiis5vrVrJ2-QIkV_yg_uIj7_i4GylYB3BRA&oe=6A3D2C36"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBVmk6BqgdoQ7kNvwGiHLAj&_nc_oc=AdpGLnoURTZZJhked61zJSTXm7baQ3QmliG_O9JWp-j-0wC1RXlKY0TyzxJGhhjPreE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iAhh-2yxSChlLxpuEreiICgMPxjET8wjaK1wwrRELeg&oe=6A3D49BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fe_TwU0dbXUQ7kNvwFws_IL&_nc_oc=AdrDy_0bEptA3j069BJsGZDiUljvF3-DY12gYonT9j3x_bNIW-J4fwZ_fOhlSj5O0DU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86UZTrl7F_nG-6VSl7svGdftEe_GQfSTwm9SAlhI_gVg&oe=6A3D32EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
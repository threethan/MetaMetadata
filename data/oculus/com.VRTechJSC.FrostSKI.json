3C&_nc_oc=Adp8E0zzLm2kQOp7tWJDP2jPqD1iVZR9MOz8P3ARM2GX5JE04X4gWRmpH53kfWnG6kE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83TjyJTwJhiHfJi7FK9G_Lww8SYGxlDAUkIszvyAYHYw&oe=6A2C30AA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdrxY9Fp-4IQ7kNvwGLJy4X&_nc_oc=AdrhZ8CGdA4acYrwYvyzboZHhqaxmhh9NfwmPD-nZhHeGB975oF-d6edfEtIMUl8bUg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lDkdT7aG9c797ATrOK1POFKqDFXcc0H1syt4XWF_HdQ&oe=6A2C19F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUSrrsas5mMQ7kNvwH_XBos&_nc_oc=Ado-sZNAy3KhFs0E5_98blIppgvx_mGzlPCKr74wW6ZIpuTHBuyM4GEJeXUU03mw5Uk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--7BQ4-fLWDA7KGyg5FG_VLsCGaF5ipsZMmgyyrjwokQ&oe=6A2C08B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DkZv4kVDLd0Q7kNvwHpjRyN&_nc_oc=Adqo9jn_rzMEWhcrSSbQYEEYyncRUWsNabN-Fq-lgHEoDxjN3tjijdWeSFOAO-Pd_vM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cPKnwE1dNLOJvAe-fl65MPNRTNALGb8rSDtqqMFKzow&oe=6A2C263B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJ3behNWiSkQ7kNvwGJod7I&_nc_oc=Adq0FgLSGzZQ8zwhZmvsTejgeEqlNipeJsrBVAppqqE6Q4ubKbEBvl65nstEu5g2nY8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_T0apn2xWMg1fIyqX1CuI15ACcHXXYdZPNgewdpD4g5g&oe=6A2C0F6E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
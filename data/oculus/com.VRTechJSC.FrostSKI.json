5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ka0I36nbevAQ7kNvwHuNqc3&_nc_oc=AdpNLoed8S9AtY3gVhREXA04XcZ7sJhi94BD-GLaTvVC0ZHR4juJV_HRJTGTbLcD5Og&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgwE5itq2H_1KELclod2CIhmVZzDxeald78o-dI9d-jw&oe=6ACD07AA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skNrW95hwm4Q7kNvwFJ--aT&_nc_oc=AdrkMeLNYUc38rPgSAYLwGFMEOQ_jYz587rBAN1YRzzdFJmqL3cVROw3ozPUucLbdi0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6wt0X28p_a3uRTwgV79dCahi-x9l5br4FzJfNuFV6qg&oe=6ACCF0F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jfjmq1wEN6oQ7kNvwEf-Vtt&_nc_oc=AdrGFcmXNgHlGGrGkcbjHytJDqpZbYBfKA2ofQEf2zfhTeY69H0_q2Yujq0DLKmvksE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-JUdl2wyPpgd-yaS8cE23p9aveBoXFLeIszwXZ9CkYg&oe=6ACD17F6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHxeAJ4h6VwQ7kNvwGq0C26&_nc_oc=AdpZvGesHBZS3NoDhjUMGqLNCJUKfiIIWAqoIbWKNWg07Fi7KyPaPBiTilZyUwkiUVw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONiGWzKG8NFL071nCbaIbJGVGpTSiO53u7xfc1CDc9ew&oe=6ACCFD3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1osE2T8n3poQ7kNvwHZ_zc9&_nc_oc=Adq7n2OqdZJZXQsyoOd7b1zXkAWvHZW-rwM_VInpLbuZJQvc0b-LOKtfllZd9yUGvms&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNe_hydUrYlPwzhTLN2LJgt0m3JKidhtpNTc9T_mLMhEQ&oe=6ACCE66E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
content-ams2-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxSxk5ZSQcMQ7kNvwG2sVa1&_nc_oc=AdmwtE4v5UObVPEwy8YeXyek6XWjCzzr6NhagISoCnwRclDvQodFQE00VN5PpSNlo1s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxyliu6t-7wmBrbiSaw2DO1bdxu9UsOPJpSbP98fEaL4A&oe=69AD89F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXI2I2g-FOMQ7kNvwFWUpbp&_nc_oc=AdknkP2B5NKYvsF3QOrOfJi3bHLq9QDJ8GAcOZk8MK1YxpM0NybJoxtYoFhLBANjwlI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw46dp1xj1jfNSDsKcaHEx8gL2Dbx2XLyXA59IoO3vSwA&oe=69AD78B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6andwyqaVUQ7kNvwG6jyI2&_nc_oc=AdnV6vXODilK9dOvlBCOAazJVvzSVCf-k5_m0Awh-MUVBebBdOJGi3HGpRceDCcjimc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy31O2m7Nij5SHAJiV6c9nHhA-eESu2ZfkV85vDhqL4_w&oe=69AD5DFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtc7yRACmt8Q7kNvwGnd1my&_nc_oc=AdlZvtygYHcowEpNT3CdRtg7CHG52mWnteSa3O6W_o5ak5ZR5z2lI7AcxUSdG9LVUC0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMHorwl6sWWhACBV9ZZzLzRrv7M2CQi5AVuxCLw21YHQ&oe=69AD7F6E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STAN
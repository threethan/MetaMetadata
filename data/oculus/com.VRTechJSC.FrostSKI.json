2K&_nc_oc=AdqbUB9tC1YkjDJ_Bm8AqNl5EUY3xaMgUXjrCUkLo4at5eNM0h4_zHJrkqegym-tHko&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iMOBLPZB3TErfyQ5G1DPNF9ztSh9NDY1olg1VKWLwCw&oe=6A3176AA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvDOIubALG8Q7kNvwEh3-tW&_nc_oc=AdpBefQQiig8iaiRLRZ4i5wOEO_OGC8q2oPNLBJMsbm5-g1pGe9YZrEjYgmyHSnq6Ng&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8anh65_LcUBBz7sqtiBeb_vS6iijwf7z-lXkIGJxSm0A&oe=6A315FF1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dNws9eJQp4Q7kNvwGysls3&_nc_oc=AdpzJv2Nc7cDT-cEILCGJY1rdCkexfUyPal9iWkC-U6ibmuQy2_RCWgv_ibNM9oMexA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9E1-k3kGc56x-aOf0s_vRxK6o8_h1Ip3UURUIlkWQ5Bg&oe=6A314EB6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqtfOCR_HQgQ7kNvwFOwKT5&_nc_oc=AdodJchdea_7rqOWVvAk9k1q3gMCbeANSXqbOmYkq2HlOtCMNcSe86yN_2vppbbRs50&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ju5qGarYX-oXml_Fl4e5NLH1ZBFBHuoNXZ1pxOYwjEw&oe=6A316C3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbZQh3NC8F8Q7kNvwGnkgXq&_nc_oc=Adrg8XyqGNIzwKOj24IfMUOYUNb_nJyVKUHxwDY_S-r7mLAIKE_G8HkFy9le4UPShoU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RIzgPBDKhYClyW71QmOvb-uv-5XgPzas-R58roEM6ag&oe=6A31556E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
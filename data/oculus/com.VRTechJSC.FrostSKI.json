5771-25/473392182_1152768040188650_7724865013258121159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ri08Cvzgyp0Q7kNvwGomWrC&_nc_oc=AdoJLkRaKuuZzLp0tswoo1o2CpK58SCP7h7vOfjNbrKlGhaXxj_FPVAoT2yQ7qpLc6Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiTF__CThTWW-Wx8RngujPT5_1kGDYqy176V6tPOATnQ&oe=6AD24DAA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_071ctQVFYQ7kNvwEOoKvt&_nc_oc=Adozfec-8mgQrXYGzKquRZYF1ujoxSZADJqYQb4dqJce_KDfKTRg3tMN-BiEy9G1fDQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNN4g9ftCP3G5v2yT68zg6PsjBlXLvZTF-mo3A739_aw&oe=6AD236F1"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5J8n68ziNAQ7kNvwEuxJL_&_nc_oc=Adoby8C485m-1vDI6UjFRU2poshkt5imRVMjhTdI0QK-xGSgPwuoe8EkPBFaT40srXw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGk8EpbDQ9RN2I5ieyssg2EnapSfGF5zpTpx8J3zwuyg&oe=6AD225B6"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCLWSsIgJZUQ7kNvwG8xxJW&_nc_oc=AdpVfCw5THHtwcnJ9UAgLJ4eb4SoM8bnj4xFm7Qa4cA8s-a7hDutl_MsA10UUc22cbM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYT1hdsv8VtSaJIYtz0CEIPHM1M0NQONHLy6IYwLhrRA&oe=6AD2433B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K64ZE8wfiToQ7kNvwFMSzyy&_nc_oc=AdpQhA5-fm-LauePTpTmxmklvr8ijXGXZlvtbFAY4jdVAFaz3vddm7q1bwzEe6cAEVs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvwxZrRdzGmgd9_2ZqlNRHpDksixHRzHWpKz9iLS8idA&oe=6AD22C6E"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
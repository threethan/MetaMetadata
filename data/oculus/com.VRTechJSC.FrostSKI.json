Bx&_nc_oc=AdoUqxiAH0pklAXHHkQ0K3VH4EgdOel5MopRRNiuLfjKwDdbA2jYqE2-O8n9nKWd_JM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-kXZu-QH6P4e84gnH-_eBrgL39VipoT3nJcojR1-mQg&oe=6A1831EA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFAxQR-QWt4Q7kNvwH7og3r&_nc_oc=AdrT37UoTZEn1ZEwnod2aLqf9HyvXEQncTndJuJw1eyHHlPYBV7mGTWi5KSl-9_I3RE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59RmFqJ5jDc3js-aJZUg5vOtvJ-bxR00rXOkSUadT5pQ&oe=6A185371"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hLS_DvsmMgQ7kNvwEPSzHb&_nc_oc=AdoHcZqyXbcsbG3VwcD6LNN7eutGXslwmzdS-MFM6q7n5IJ6erFJqKhAq1yPGNJtO1o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43_vZdUGC4F6JJnkksEWHFy-zA53UK9jwITynYbpuz8g&oe=6A184236"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opHFbfilzIMQ7kNvwFoKYHD&_nc_oc=Adr4jfYT6m0rX1Ww7g4rGUyPe_W-TT6Gq1ZuhyfMCGCi4_hTZonBdYHqkfV5_nPEvuo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4C389nDYBT4bR0C9G6P3Q0V5uCZaY63_hGWXjqPnPNPw&oe=6A185FBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_hsd8XtnoMQ7kNvwG70D-p&_nc_oc=AdrMQegQGr1C0KAn68g_E6BOjEgyJg8OUTuyq2OA1OxqoYPjHIDi_Em3H8AyDopmCBo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qnjapevOQgaoAAjTeLsvA5W_KM237iFQJ7ACzO_o3mA&oe=6A1848EE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
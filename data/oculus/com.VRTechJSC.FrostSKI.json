ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2mLDBcg6jixzJPnkaS7nC66BPbxVdjp9rr80kIdQxIHw&oe=69F0A4EA"}, {"file_name": "Screenshots_3.png", "id": "1196106045282529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393372_1196106048615862_5345369781975012719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVirbLJFhowQ7kNvwGfcJka&_nc_oc=AdpxqIX-boF5TVhlGuxnDKixoiH7o957BYcUcC89Ibb9NYmZtfKbbK1AYpz7pWc9YmI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1dlSXU1XjTGjhpoYnDdkujXA2AgaUYK6wY5wypDXJXCw&oe=69F0C671"}, {"file_name": "Screenshots_4.png", "id": "990073876552054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_990073879885387_6652878965225301963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XS3ME0oxZkkQ7kNvwH2LjsY&_nc_oc=AdolrM3PcwGYcAtCCNOVKUZdUIDCyj31cDsagKlDNsfMjD9em4a-RjOiCJfpGF276LA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2BNpNmpZJ8IfVUexGyL5cZpDh0RaN1pf6urwoPCjn2LA&oe=69F0B536"}, {"file_name": "Screenshots_5.png", "id": "4072253439762942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_4072253443096275_8860889808233715396_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_TbtAVSQb5wQ7kNvwHVa2CX&_nc_oc=AdrcsIWkyrFV01nT5WOeaH4aqHgOgvVtIfo5gOdw6dLbbDfDv5chxaZyQDPvOZQx05w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0QMBZcEnwiagXB8Qa9WyxksL4NuoS1IA-GmtuCf_BOvg&oe=69F0D2BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1850756372421918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393538_1850756375755251_4283448513947577854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYK4Zk2I5S4Q7kNvwEl5AOO&_nc_oc=AdqUzziE4baaFGkRx1LdDgUVd8pArUKKYpbk7gqN8Bpw4cRtoCQNf5QIOg2F24RtSIY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2YlrD6j8rBd4PIMjrz9k2UXFenQhf1lMwtJWccOlqXpg&oe=69F0BBEE"}, "display_name": "Frost SKI", "keywords": ["sport", "snow", "skiing"], "long_description": "Frost SKI is a virtual reality skiing game that delivers fast, responsive downhill action across beautifully crafted snow-covered mountain environments. The game features intuitive motion-based controls that allow players to steer, balance, and react naturally while racing at high speed.\nAs you descend increasingly challenging slopes, you must avoid obstacles, navigate sharp turns, and maintain control on icy terrain. Each run is designed to test reflexes and timing while remaining comfortable and accessible for extended play sessions. Smooth physics and thoughtful movement design help create a sense of speed without sacrificing player comfort.\nFrost SKI offers multiple downhill routes with varied layouts, encouraging replayability and skill progression. The game provides an engaging and approachable experience for players of all skill levels.\nStep onto the slopes and experience the thrill of downhill skiing in virtual reality.", "short_description": "Frost SKI is a fast-paced skiing game that puts you on snowy mountain slopes filled with obstacles and sharp turns. Use intuitive controls to carve through ice, maintain balance, and react quickly as speed increases. With immersive environments and smooth physics, Frost SKI delivers an exciting and accessible downhill skiing experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
6A6DF3F3"}, {"file_name": "com.HoloMoves.CogniGame-20260318-131449 (1).png", "id": "1287349476822095", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819859_1287349480155428_5903431997900391896_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trPv3hS_uO4Q7kNvwGWhJwt&_nc_oc=AdqdiquTvb1FDxagC-nWMyx0liaNyO4YVfCv105K3V8_Qq6c4uYUUkJxWgW6jaxKUIw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKRu-RrK6z0fw7uQOFIRh_N0b2z18t4VqctgoM5djbpA&oe=6A6DF597"}, {"file_name": "com.HoloMoves.CogniGame-20260318-122030 (1).png", "id": "955329100310357", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819323_955329110310356_4384366471324692091_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpeHbCTjlEEQ7kNvwEMWaxE&_nc_oc=Adrd-fTLq-9DHPhz1QrbS0S2pkbLAdv0hWV04iEFms_wIgdjUCGxjGLLqaUIXm8NBlk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_eaIwKAOJA5jX-_diOQnEzAo6_3H8v23O15pJMb7MXg&oe=6A6DF2DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HoloMoves: Planet Puzzle", "keywords": [], "long_description": "PlanetPuzzle is a mixed reality exergame designed to encourage movement and cognitive activity in a playful and accessible environment. In a visual universe with different planets, players are invited to move around physically through space while completing simple cognitive tasks.\nThe game includes three levels featuring spelling tasks, math exercises, and matching challenges. It combines movement in space with mental engagement, which can help increase involvement and motivation during exercise sessions.\nPlanetPuzzle was developed in collaboration with healthcare professionals and is intended for use in guided exercise or care settings, such as under the supervision of a therapist or caregiver. The experience can be adapted to different ability levels and play spaces, allowing users to participate at a suitable pace. This includes players who use a wheelchair or walking aid.\nPlanetPuzzle is not intended as a replacement for medical treatment or professional advice, but can be used as a supportive tool within a broader care or exercise program.\n", "short_description": "PlanetPuzzle is a mixed reality exergame that playfully encourages older adults to stay active while engaging in cognitive activities. In a colorful universe, players move around between planets while completing accessible cognitive challenges such as math, spelling, and matching. Designed for use in guided care and exercise settings."}, {"images": {"nodes": []}, "id": "1445609396593974", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HoloMoves: Planet Puzzle", "keywords": [], "long_description": "PlanetPuzzle is een mixed reality exergame die is ontworpen om beweging en cognitieve activiteit te stimuleren in een speelse en toegankelijke omgeving. In een visueel universum met verschillende planeten worden spelers uitgenodigd om zich fysiek te verplaatsen terwijl ze eenvoudige cognitieve taken uitvoeren.\nDe game bevat drie levels die bestaan uit spellingstaken, rekensommen en matching-opdrachten. De game combineert beweging in de ruimte met mentale uitdagingen. Deze combinatie kan bijdragen aan meer betrokkenheid en motivatie tijdens oefenmomenten.\nPlanetPuzzle is ontwikkeld in samenwerking met zorgprofessionals en is bedoeld voor gebruik binnen begeleide oefen- of zorgcontexten, zoals onder toezicht van een therapeut of zorgverlener. De ervaring kan worden aangepast aan verschillende niveaus en speelruimtes, zodat gebruikers op een passend tempo kunnen deelnemen. Denk hierbij aan rolstoelafhankelijke spelers of spelers die gebruik maken van een loophulpmiddel.\nPlanetPuzzle is niet bedoeld als vervanging van medische behandeling of professioneel advies, maar kan worden ingezet als ondersteunend hulpmiddel binnen een breder zorg- of beweegprogramma.\n", "short_description": "PlanetPuzzle is een mixed reality beweeggame die ouderen spelenderwijs stimuleert tot bewegen door een ruimte en cognitieve activiteiten. In een kleurrijk universum bewegen de spelers tussen planeten terwijl ze passende cognitieve uitdagingen uitvoeren, zoals rekenen, spelling en matching. Ontworpen voor gebruik binnen begeleide zorg- en oefensituaties."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves", "support_website_url": null, "website_url": "https://holomoves.nl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26151597691192046"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2024655838458943"}, {"status": "PUBLISHED", "id": "1467616021810063"}]}, "baseline_offer": {"id": "2024655838458943"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775650380, "status": "PUBLISHED", "id": "2024655838458943"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26445057688512710", "version": "1.0.1"}, "id": "970153665533946", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26
bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VObevM0pH2sQ7kNvwGZxcQQ&_nc_oc=Adrlnf3kthuL2vFMslTB1f7Nj1A2Ri0y34ef6LELS7fPMIm4LMjNNTPYAm5pVmDr7j8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQHjnd6-ZtmxvsYZTyXrJzV6GwRZpOmLduvqYd1d5BF7g&oe=6B0C7DC9"}, {"file_name": "imageScreen2.png", "id": "26799993236349090", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299928_26799993249682422_1591935917636255989_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEZDhDputqIQ7kNvwEjnnUz&_nc_oc=AdolWkiuNJcxmNnDCdyypJgsu0P1L36JNv65NJvO9db5XqCQVx20OWvjBjLkE4B_geo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT2wxODKy708GhJjvcg3hiwn2Lg6VOcEQ_tPsgl55uJvA&oe=6B0C6EB7"}, {"file_name": "imageScreen3.png", "id": "1005283858530470", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620965_1005283861863803_6260799381788532221_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYjrgH0URBwQ7kNvwEp0yQE&_nc_oc=Adq0xCiz8BjjuHcWmhLQnWeW_KvEId0B5fbzymF6OH9gVkWkaIBj2VJYrjUZwaKZMdI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSgkRbl5Ju5gpUa_k9viwEjE06-rxuXTNE-xsAld0A6LA&oe=6B0C773F"}, {"file_name": "imageScreen1.png", "id": "1528076779012251", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_1528076782345584_6597272146523077497_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZMb1asbexYQ7kNvwF5dK3I&_nc_oc=Adqa-8o1mBI09NmQusIrMqWYWTsqYFEWzxuptpA5WbD5NM1HHmyGix1VMKs5Zox6st0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRwfbx6ppKLElKVvsxoT6C4QHjO9HLAFBoZ5EkeFyqBWA&oe=6B0C5520"}, {"file_name": "imageScreen4.png", "id": "1757437058717724", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1757437062051057_91945186351780630_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bm_HrgcciAYQ7kNvwEGmxfe&_nc_oc=AdracA6spnFMNC7a0snqWuJTYsqbXXQ0Xe-trWmGSBWvaQcBfoU5GEnDNwVrI8wLua0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQoWuQ8pv8ybjkVw--hPjRU03mv_H6PorV3L-tqx_KLig&oe=6B0C60B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gun Point", "keywords": ["VRArcadeShooter", "CasualVRGame", "PrecisionShooting", "GunPoint", "ShootingGame"], "long_description": "Gun Point\n\nStep into a vibrant, high-energy world where your reflexes are put to the ultimate test! Gun Point is the definitive VR balloon-popping arcade experience, built from the ground up to deliver pure, satisfying, physics-based fun. Whether you are looking for a casual, relaxing escape or a heart-pounding challenge to top the leaderboards, grab your virtual gear and get ready to pop!\nThe sky is filling up fast, and only your precision, speed, and quick thinking can stop the chaos. How long can you survive the pop-pocalypse?\nKey Features\nSatisfying Physics-Based Gameplay: Feel the tactile rush of popping balloons in fully immersive 360-degree environments. Every pop delivers a crisp, rewarding burst of color and sound optimized for VR haptics.\nAn Arsenal of Fun: Don't just settle for standard darts. Unlock and master a variety of unique tools and weapons\u2014from high-velocity sling-shots and precision bows to rapid-fire blasters and wacky power-ups that trigger massive chain reactions.\nDynamic Chaos & Special Balloons: It\u2019s not just about standard rubber! Keep your eyes peeled for explosive bomb balloons, time-slowing freeze balloons, and elusive bonus targets. But watch out\u2014hazard balloons are mixed into the crowd to punish reckless shooting!\n", "short_description": "The ultimate satisfying VR arcade experience! Relax or race against the clock as you pop colorful balloons in beautiful, 360-degree environments. Perfect for quick gaming sessions, high-score chasing, and players of all ages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTOc7yvC5
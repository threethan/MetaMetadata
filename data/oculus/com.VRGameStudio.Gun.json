bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWMpIW4FOiIQ7kNvwGoSOn3&_nc_oc=AdpjEpyjQC-vgZ_Zof6mXY7sb_c-C-JbzlbUNpx5IucOuiL3ASjpUvTv6P-CX-OMGlY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQMHq0axvB-rBSp9iqkRl_keDWXiQNSOFBhjQALXhrKWQ&oe=6B0DCF49"}, {"file_name": "imageScreen2.png", "id": "26799993236349090", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299928_26799993249682422_1591935917636255989_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEZDhDputqIQ7kNvwHoM2Wt&_nc_oc=Adr1j6iW3WZjOkcWrSpH3cAdYj_3-nV4E5cwBtTJ9Sdff0jRiHOZfHVkyDan7vdtbFc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRBp-puw3Kp-pBvE1zew923_Wpl8bpTVmZcM3egBCESzA&oe=6B0DC037"}, {"file_name": "imageScreen3.png", "id": "1005283858530470", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620965_1005283861863803_6260799381788532221_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYjrgH0URBwQ7kNvwEBTuD2&_nc_oc=AdqK6sC6wmAgPxJJpcZQFmRPQ4GoR-w5iKnuQTlQcglfG12VwpGH6_9f-j_fN7oW7Bs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT3uq8f0e7QQBPsxz6FYQOUP3sBKk6nadKpBm-MFfDIIA&oe=6B0DC8BF"}, {"file_name": "imageScreen1.png", "id": "1528076779012251", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_1528076782345584_6597272146523077497_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZMb1asbexYQ7kNvwGHABb3&_nc_oc=AdpGv2hMdS6zGxIlARKuEOcw-TmyRzQx3EvDDa8L9_rDnyJ9GHadJJPervr6_Rn4kZY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS9wYl0z7hU9j90bM2kK4EJgkZ4-hHKoSsabb8kqZGqxw&oe=6B0DA6A0"}, {"file_name": "imageScreen4.png", "id": "1757437058717724", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_1757437062051057_91945186351780630_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bm_HrgcciAYQ7kNvwEkNbak&_nc_oc=AdoE_gX0hzxOTuopH-0ETjapwmDQYBEEt9-viTWtufPGbmIPf7SD7Y4OfR7flqXu6ZE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQBKobGhUpxV0X1JWtsqvJz5BywGti6JoZv8QqNHkmJrg&oe=6B0DB230"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gun Point", "keywords": ["VRArcadeShooter", "CasualVRGame", "PrecisionShooting", "GunPoint", "ShootingGame"], "long_description": "Gun Point\n\nStep into a vibrant, high-energy world where your reflexes are put to the ultimate test! Gun Point is the definitive VR balloon-popping arcade experience, built from the ground up to deliver pure, satisfying, physics-based fun. Whether you are looking for a casual, relaxing escape or a heart-pounding challenge to top the leaderboards, grab your virtual gear and get ready to pop!\nThe sky is filling up fast, and only your precision, speed, and quick thinking can stop the chaos. How long can you survive the pop-pocalypse?\nKey Features\nSatisfying Physics-Based Gameplay: Feel the tactile rush of popping balloons in fully immersive 360-degree environments. Every pop delivers a crisp, rewarding burst of color and sound optimized for VR haptics.\nAn Arsenal of Fun: Don't just settle for standard darts. Unlock and master a variety of unique tools and weapons\u2014from high-velocity sling-shots and precision bows to rapid-fire blasters and wacky power-ups that trigger massive chain reactions.\nDynamic Chaos & Special Balloons: It\u2019s not just about standard rubber! Keep your eyes peeled for explosive bomb balloons, time-slowing freeze balloons, and elusive bonus targets. But watch out\u2014hazard balloons are mixed into the crowd to punish reckless shooting!\n", "short_description": "The ultimate satisfying VR arcade experience! Relax or race against the clock as you pop colorful balloons in beautiful, 360-degree environments. Perfect for quick gaming sessions, high-score chasing, and players of all ages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTOc7yvC5
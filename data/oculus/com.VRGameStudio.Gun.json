5989_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRlfdqbZJwQQ7kNvwHkNhyB&_nc_oc=AdpiKIGPxbYjonW8pK8PPVKFs0EMC9yRRhAtAo3d8R5QeHZkaCgSknYjiieGJS1GK0s&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMeXrFdlC7sKpq4iKp0bkofob6gR22w1FcajGMj9uHqg&oe=6A9405B7"}, {"file_name": "imageScreen3.png", "id": "1005283858530470", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499620965_1005283861863803_6260799381788532221_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0ReDFNYpz0Q7kNvwEGeIAD&_nc_oc=AdrVRcsmhz6LCsdEn1WfgViyyNlu5_SWjAZRJ_N9810frPs1ejcLSF4_6Er5494RUPQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVxZisS0mdcyfmFF8vamceTT9ikWsPJwPgmMb1jm-3rA&oe=6A940E3F"}, {"file_name": "imageScreen1.png", "id": "1528076779012251", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619808_1528076782345584_6597272146523077497_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KGI8dsN6jYQ7kNvwFuGXaW&_nc_oc=Adq7E5Zx2GQIv9uSQVWmWW5quTnQsw_HzqSw9eTw_ep5XedlomxJPo0ghDHbvkdlDTs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSv3nOE7aLWK04S78LkmGCR0akaevd3IvKO7sIqUVoYA&oe=6A942460"}, {"file_name": "imageScreen4.png", "id": "1757437058717724", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499619677_1757437062051057_91945186351780630_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0RCBFM2cE8Q7kNvwFRrsd6&_nc_oc=AdreuWLmtFj5E32DONmBRq025K1Rzj_SfiBmL1iz3mjc2_XWn1Tel9xk74WfP3Y14LI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHk0d9MPr854Ch8-KJcPjJfwtHFWjcrieHcaai-PgZ3Og&oe=6A942FF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gun Point", "keywords": ["VRArcadeShooter", "CasualVRGame", "PrecisionShooting", "GunPoint", "ShootingGame"], "long_description": "Gun Point\n\nStep into a vibrant, high-energy world where your reflexes are put to the ultimate test! Gun Point is the definitive VR balloon-popping arcade experience, built from the ground up to deliver pure, satisfying, physics-based fun. Whether you are looking for a casual, relaxing escape or a heart-pounding challenge to top the leaderboards, grab your virtual gear and get ready to pop!\nThe sky is filling up fast, and only your precision, speed, and quick thinking can stop the chaos. How long can you survive the pop-pocalypse?\nKey Features\nSatisfying Physics-Based Gameplay: Feel the tactile rush of popping balloons in fully immersive 360-degree environments. Every pop delivers a crisp, rewarding burst of color and sound optimized for VR haptics.\nAn Arsenal of Fun: Don't just settle for standard darts. Unlock and master a variety of unique tools and weapons\u2014from high-velocity sling-shots and precision bows to rapid-fire blasters and wacky power-ups that trigger massive chain reactions.\nDynamic Chaos & Special Balloons: It\u2019s not just about standard rubber! Keep your eyes peeled for explosive bomb balloons, time-slowing freeze balloons, and elusive bonus targets. But watch out\u2014hazard balloons are mixed into the crowd to punish reckless shooting!\n", "short_description": "The ultimate satisfying VR arcade experience! Relax or race against the clock as you pop colorful balloons in beautiful, 360-degree environments. Perfect for quick gaming sessions, high-score chasing, and players of all ages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTOc7yvC5LtKWzqtA6FJhmvBoHbKk6JwrDP-xt63bKz4hawOkw9si4p9rEbb07OpAMeW8qYUeDwjgys/pub", "developer_terms_of_service_url": null, "publisher_name": "VR GameStudio", "support_website_url": null, "website_url": "https://vrgamestudio.mobirisesite.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
5ClHVipCfRbE-Zo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROUkbvimxbvH4wyE1rJIUBTVXhVgYrqcBQlvio1BMKHw&oe=6AFB2209"}, {"file_name": "imageScreen2.png", "id": "26799993236349090", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499299928_26799993249682422_1591935917636255989_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RT_kkHsA6O0Q7kNvwHLthcW&_nc_oc=AdoyhbOrosuGOS09oV0KzL8XEN9xrwCLC3shKOzmh3eojUazqpg7wvQO-GbPYZ8H6bE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKAm8N4UR1bFJaNEtpoLejJ7DzXxTwA7J72Elux7M1iw&oe=6AFB4B37"}, {"file_name": "imageScreen3.png", "id": "1005283858530470", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620965_1005283861863803_6260799381788532221_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASaxbebHH5IQ7kNvwG8ZID_&_nc_oc=AdpFjBb7_Hk23ceoWTNBV1AXNVhQ6cjB1xp0KKknjE8LSLKGnITD5vboobaSUrpM1dA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbegT7qvM3VROXT9fXiBcza--zY_j-Wyh4YZfFssgt-w&oe=6AFB1B7F"}, {"file_name": "imageScreen1.png", "id": "1528076779012251", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619808_1528076782345584_6597272146523077497_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOBT3dZpG_kQ7kNvwGCJ48l&_nc_oc=Adoet2mulpOjQRMwI1HeM-VmbcM8DknLf7_BBI4U9lOQP3i3VbqbZo6rLXeyt0vfens&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHZIzQ5wsnCuLHsaB0yiLzF72eS5wJddhiX-MJoiisDQ&oe=6AFB31A0"}, {"file_name": "imageScreen4.png", "id": "1757437058717724", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619677_1757437062051057_91945186351780630_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1uk2XlXg68Q7kNvwEDeQc-&_nc_oc=Adrj6_vRQGk9L6Hi2X6Xbw3ebInCLQ2kV6KgPkRZOjKXTEnAisXaOslpw-JpA7JoMUc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPHyFznzZbPK-o9-Ex8u5eXbhmRTYuRL98SHEbHQ7lig&oe=6AFB3D30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gun Point", "keywords": ["VRArcadeShooter", "CasualVRGame", "PrecisionShooting", "GunPoint", "ShootingGame"], "long_description": "Gun Point\n\nStep into a vibrant, high-energy world where your reflexes are put to the ultimate test! Gun Point is the definitive VR balloon-popping arcade experience, built from the ground up to deliver pure, satisfying, physics-based fun. Whether you are looking for a casual, relaxing escape or a heart-pounding challenge to top the leaderboards, grab your virtual gear and get ready to pop!\nThe sky is filling up fast, and only your precision, speed, and quick thinking can stop the chaos. How long can you survive the pop-pocalypse?\nKey Features\nSatisfying Physics-Based Gameplay: Feel the tactile rush of popping balloons in fully immersive 360-degree environments. Every pop delivers a crisp, rewarding burst of color and sound optimized for VR haptics.\nAn Arsenal of Fun: Don't just settle for standard darts. Unlock and master a variety of unique tools and weapons\u2014from high-velocity sling-shots and precision bows to rapid-fire blasters and wacky power-ups that trigger massive chain reactions.\nDynamic Chaos & Special Balloons: It\u2019s not just about standard rubber! Keep your eyes peeled for explosive bomb balloons, time-slowing freeze balloons, and elusive bonus targets. But watch out\u2014hazard balloons are mixed into the crowd to punish reckless shooting!\n", "short_description": "The ultimate satisfying VR arcade experience! Relax or race against the clock as you pop colorful balloons in beautiful, 360-degree environments. Perfect for quick gaming sessions, high-score chasing, and players of all ages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTOc7yvC5LtKWzqtA6FJhmvBoHbKk6JwrDP-xt63bKz4hawOkw9si4p9rEbb07OpAMeW8qYUeDwjgys/pub", "developer_terms_of_service_url": null, "publish
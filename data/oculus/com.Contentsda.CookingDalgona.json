yrolysis", "science", "contentsda"], "long_description": "1. Place the sugar in a ladle and place it on the gas stove.\n2. Turn up the heat and stir the sugar with chopsticks.\n3. Dip the tip of the chopsticks into the soda and stir the soda into the dalgona.\n4. Pour the finished dalgona onto a plate and press down.\n5. Take a mold and break the dalgona with a hammer in the shape of a dalgona.", "short_description": "Understand and learn about the interesting scientific phenomena behind the cooking process of making dalgona in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9512823328773790"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974891_952378780074572_3506988048425322897_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Efw1KLo4ctoQ7kNvwEgnrvP&_nc_oc=Adm5sy2bzRkEEJ5pNH7yvXnUyCWgc56ERe-PXuceDCRojiY6yAdfrKBoen8W46q6LmI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzftmflnVeXJqzZ2q1vQCAsFlsUU5n4B9TS7-9FWk0heg&o
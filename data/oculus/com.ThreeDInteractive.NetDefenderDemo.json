371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f20U8RRhOnAQ7kNvwGXLmSp&_nc_oc=AdpGo6OZMWSWmsjFhu5PhIKPiJtSIC31yHOUvuksZ19fNIVGFZV9N-Q7Eh285Zvm_UM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCM8QO9PphPVh7Bzc8F7QXy1NIt8Gb0fAaCoGIduhWV_Q&oe=6A4F8DA4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75agb9NfL9kQ7kNvwEMxs4s&_nc_oc=AdqaZwKDOqDwmWgMzeZ-LS-Cm_DVXslLY5-yAfB-u4wS5Ui78biWPMD5Dg3VdptaOpk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbJWLOmoJe4d8FHKmDICSMlUzG6-j3kp6mI_yMKsybPQ&oe=6A4FC328"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGC5v4sb8VUQ7kNvwEbah5M&_nc_oc=AdofjStLzwpUX_5-rdTfPUt9yZoc77tGSSuAYQBoAOg9YS_Drt5gU0rOVJRi7WxPgQE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDehwKK06907DnfUuUBohWS12T-_8XAlkOR-AD-IF2tA&oe=6A4F8F38"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykMFI7Wtt1cQ7kNvwGsPujT&_nc_oc=AdqX6Q92meUs4gfPwP8TuZUcxTcjqJ5l0T2KBFmf6aqfBqxLJuaZGqLfSo-wvKNXWHo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZhtAc9LCHK2m8vl5Z6w-INDKHWirzti6Dw21CC1XUjw&oe=6A4F9499"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TtVsoWbXFwQ7kNvwGRGJu9&_nc_oc=AdoeNfGJt_JUyyLY13hfpUSuyz9XLQGP_Dy-p2BeL5-Zl4RqUIioDmJx9n_PSPpu2d0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTN6GqcvqI1MsZaRPYXA7Qcf1u_RZcCB42VyCWck8Ylg&oe=6A4FB5F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
DZNIJ181zUNIAIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af285HO55doFggtcp-Vk4JA7BldCw_H0-ZLR6kze7YJxVg&oe=69F0A338"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbaL5ZIHS9gQ7kNvwEnLiqT&_nc_oc=AdpZWIC8sG6Ew-FOYKQBOaIz6zUSZqjDBaIArBrz4Tg2lmNyBoEm3zuV-Db9BHjRKoM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af16mdzQoMb0EHlOLuaOIrEnx4kwPO_TKSQKdv7_IqrE5A&oe=69F0A899"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChHymK33aPkQ7kNvwHFEjmr&_nc_oc=AdrHx1HD0zYp522J8iC8thvCBjHNsdVZzlAimafuBI6tWpvfRcVUYbL401FpEgYRHVE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3_qkRumlgm1DI6wIyC321P8LBiH-G6M-EhELwMweARUw&oe=69F0C9F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "
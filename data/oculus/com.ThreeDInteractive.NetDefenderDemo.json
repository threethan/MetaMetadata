371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnjlNENSAJ0Q7kNvwHsF_rW&_nc_oc=AdrziMT-tWbJsBqgr8DPRsgw0AdMvYGnRGclafN7F8bvwXwM-Ibsg__zs8T1lDkJrIE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hUrjHFTVqdA1kWXPE1XfQ2O7RZEL3ldm7NCIbrDjLCA&oe=6A1EFE64"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXsHM_DuizIQ7kNvwF4DY_B&_nc_oc=Ado5PxftABdTx679oQCDcm498PqGxOwai_zlE15XExl3kyhuXTaL1jWAojqWjS-9lxI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Z4NzOmW82mYfljGgd0IpQNQlSZxgbbMbesgD9q-LXIA&oe=6A1EFBA8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgD9k01lEYoQ7kNvwE5xL1H&_nc_oc=AdpiZYkQm6LxNER2eX4NhAsa0pdVs-57zsKzt9CXU-a-TlvgH7I8NplkAs92TOeJVBs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kf5rilr3nBtzfCU-If3Iqg-HR7TuWkFVzyZNfAVPC8w&oe=6A1EFFF8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZBkRRifyAQQ7kNvwEiq5s4&_nc_oc=Adreii-1_juukfHwYsdvYu_vkktZgFm1NHdErb0IiTUhhHBH2psYyMQ5Yap3GM0wPvY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af402D_dCcctNaLdQiXwKWP0Sk5kcBdATlbGo4L2Z8kWQg&oe=6A1ECD19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oiv0XSlZnWMQ7kNvwED6E2d&_nc_oc=AdoSsiKnmWZloJvlubF74NP1x96jSjgjnA3YWgFM5axoAWcPz2ZNGPdeLlFGx--AA2c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6w9wfGsjKbwVmRX4c2UDg8ZDQ67zgWKj7onhHp1_ZLWg&oe=6A1EEE75"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
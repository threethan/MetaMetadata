371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsTpo-gE95AQ7kNvwE2fWHL&_nc_oc=AdoCnpN3qX64maNMFAJgzclwE5jdCVZOagtsKbPUL6DOZqRg9XHv4H2NpRry5F_6bOI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2PN7_7ooLCS09rGwQSeNdsD6cZdDHYWOtyv1m253E8uQ&oe=69F73924"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cED-gYuf7vkQ7kNvwEQf_tm&_nc_oc=AdpO9hS5idzL5z9VFWG4mP5_qg57jT_YBsaY4eCSC_rBbplicspsfVlUMvKdCBHN8bE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0JlOF7Pkov1m7W-IHdvkj8VFb1PXHShgQHphocLWEcYg&oe=69F73668"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUDIa1RR2vEQ7kNvwHZsbWe&_nc_oc=Adrr3kommHP3WRmMo3C5LzMxY3715hoxd0_KYW7DQ61ALMYXZx4WrJ_2IuopEGwGI1s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ke5YIdD9lff30mXLJgwt6fuKnzRL3del3D4kHZe71Jw&oe=69F73AB8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECVZgBAPogYQ7kNvwG94n1Y&_nc_oc=AdoYdZOldrIbSc5LU87TQ6SFhofuYrckwUO-UM1sTagpdnSThI7OtP0kFEpgh5a1U0w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1N9_w-SvNTgv6z8kGmzf_f-MVvRJAWomYEJ6HDAcphqA&oe=69F74019"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNKtkIk-6OAQ7kNvwENGDfD&_nc_oc=AdqjrFeqscyvKl9_3AmMKHkMpqtrUNs7klSHmZRAmTeN6EJ3QBXyOUFSnNINXOIDQG8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af17Fqh4ZvIXCFSJ67xhlRUVTVvkfs0Z-c-oNA6MPfHgeA&oe=69F76175"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
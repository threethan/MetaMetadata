371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTen21wdU6oQ7kNvwGd7bFj&_nc_oc=Adpv-EdSXN2zxjjZZsjssv7FMMHQTJeF3VEi46t8LNQogqHvvJBYGv9X9O42gPFT8G0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MZjTFcEKpwUn8mn7nDXqJvSWKB96wJrO0Hkr0-HZVfg&oe=6A43E864"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bT1rae766HUQ7kNvwGIUXTK&_nc_oc=AdqsvQzZcQvUDmPXRZR4Pu1ihXzqZE61MV6eAay0qggj7iaIR5Jkp9ADB6GzXoufMSU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cMtzpnknpw5uNt9Ex3PBni0nzofKuhrO17n1v5H5SWg&oe=6A43E5A8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hAgU6l2lt4Q7kNvwFVgUdC&_nc_oc=AdpeEsbhNPNNKXETJq2oouVWAx7TYXGVTfFqxYRsyZnd3-P3Fpcs670jM5TgjhS2cSA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sqxVzNWMw68elMbjKrWOAXyp4zBBezt3RBYr3scnyRA&oe=6A43E9F8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAPelcBuAfMQ7kNvwFiHQzo&_nc_oc=AdrahuU_P4EKNv1SzbxAdsD5M-RVwmDynRWXcHPXtUgWKRSpjk3mD4ohk0_q8dGoulY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XJ9kiTMj2AIAC20YuT3Iku-Yv5LYhNMzEiFuzF1ghKQ&oe=6A43B719"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOU8y3mmZoMQ7kNvwF4q-H6&_nc_oc=AdosVmJF4s3N-2iBiOMinSiou9QmQhsqOLDBoyCJcukhzvZuzvZne__kjv77C-A8cXg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qyBHLmNlgGFNwR97dig-lWNb4maOKRC1JZsD3ERsW2g&oe=6A43D875"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
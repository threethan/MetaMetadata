ir5F2iW9Xern4MM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv_9Tx4APWuUCGWL9932ceJNaNzV1jqdNxMFkwo2N1hjw&oe=699EE638"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPEbACk2GiEQ7kNvwG52zRM&_nc_oc=Adkyi9VoVyj9X37KdU8YUb9VDt4VwOM14n4AsxxakpY35jfUWAuTB-Ti125nw6uveFo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuOEIFLRE8n2Lf8TFN3YcFOQuDbYdfhonC2IT-MQTVbSg&oe=699EEB99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aViJ74Jo9RoQ7kNvwGWa-w3&_nc_oc=Adkjpe-mXHseiqcZGO5PsJtaF4YqNzbOgEvuLWI9HQDDv-EcWmO2Cw6w2GxGTOG7uzw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftKJKEkKQVLpsM2AKAlilEmVahEX6JgXf87Q1MzZybnig&oe=699ED4B5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "
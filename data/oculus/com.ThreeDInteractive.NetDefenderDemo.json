371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmVrupnEyyIQ7kNvwFyN58o&_nc_oc=AdrA-fPTB7x5MlO-o4Q-AcE-TsUwlbLs_5QbK_D5-cw6JP8ZDvf_KGLOXg5KLNznwdQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7f0U31jdLhWWQYCMWTH5RdBGc87o9k_FVOU0Y0B_u7Q&oe=6A732624"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UO_kd2kENq8Q7kNvwG7qibY&_nc_oc=AdoA99f1dlq0L7FIRJ3FyH7u6U2PK8u3hdHqxhWOY-kLanQsdg2QdZMl3co2O2PAcko&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQ8FkQNXRiYEx6FQEpHpEuLOMV_5h3stb-WNg6ksQOdw&oe=6A732368"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dfe26N2F7TkQ7kNvwGWkp4R&_nc_oc=AdqY_x5HTocA1qnFIRYmzsqnpF9a_EVzdIh1T7rs11EEgzpl-ex9qmLAlmsxtfsq7s8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2E6ezGxQmyeEm332y-_edDKYMjcBhsJHvCZM4l1y8LQ&oe=6A7327B8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JvAGM1LExEQ7kNvwEjWvqC&_nc_oc=Adp2jgu_oWvWm_SIs3tHDwuZLjakfmPjLFq0pZObO5WejfuKJIU4wRfLmFYk0NEfLXw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYzomsAjl1FwgTf3LJpXG8Cm2EyW-BYZ-Eqv4tp6b87g&oe=6A732D19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVQ_qWgu65UQ7kNvwGYc1Fo&_nc_oc=Adq1X2dcmBnnopgIEWF--5g3BrBf-kzE4OEvEfgS0caTdP_xcuX2LoQMUS_qQybaWsI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEazbkU4Mk3KknI7GHlbxbkpLt3nrVNQOU2UYhBBDyYFQ&oe=6A734E75"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
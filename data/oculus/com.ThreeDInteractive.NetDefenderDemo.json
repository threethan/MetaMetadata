371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7lnZicPqvkQ7kNvwGb9JAC&_nc_oc=AdrIWmCUGP8eSTAq3nD6Rhnio0x9gbdZCyyEPAfY_8qE8XO6nucMzNMOAQbihNq_NPM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBP9PameTEj4Cq6S4L07xl99k-lpsDpxFuqpC0gpCxHuw&oe=6A4BD164"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qL4z6Fon0QQ7kNvwHIqJ71&_nc_oc=AdpLphDZWxwl1_D3bV8eRPYPNzm8A5yvCVGkQS2OYAYebzl59DSBloZQT1qvE5RvRuo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRSFfDbVqoMcbhhdSjXbTihO1Gq6KF9-y7FyCTSGBiPw&oe=6A4BCEA8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCxMX20X6HIQ7kNvwHpgcQ2&_nc_oc=AdryKsqduassS4Dx6oLrLzEQAQVQu-KXPiD3vujM-W4TzEYvjntU81p8BJPqL7_l6j8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCj37DQWkxCWtUvgi_wcZ_CIXwrrIY7k1kxJOBNhuc-kA&oe=6A4B9AB8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLtLNt_gcuoQ7kNvwHkohEO&_nc_oc=Ado_2c1lTI-z5afzQi41chwq4kyMhHA_iYptsm0JV3LoT_nIfUYdZ00xtMPGWhynNi8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCMVfJYfJqLDvjCNcubu_4Nsv-5WwFZSIJzcQIM3kRBw&oe=6A4BA019"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02pwVA1qNskQ7kNvwEo9_zJ&_nc_oc=AdqUGbKZYCFkUP1Tu3PIPM5l8tICqVFxSVD_BguuROHFfn12e6VR87fAiBKyaiM3cjI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvQrx68AJ4RQEYMRnRUey2YKDLuqdqWjFERISxKKZolg&oe=6A4BC175"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
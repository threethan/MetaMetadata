371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2h7Os8FnyoQ7kNvwGgw1xS&_nc_oc=Adrhrqq84JCEcazufv83fTX2t3kiz6Unw3AETJdF-bsDdZphiAmIQt4DV_CYaMzL4hs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTBBP2PPDFZcdaq93M4yaN1kg5zN4fd_cTXQrTCR7p0w&oe=6AC7BE64"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGqny-fsMWIQ7kNvwHOeD83&_nc_oc=Adrj3MR3NY-bnfsI5o_cYSSW0K5JHmuns7VQGSICDTelNPA_t3bTKg0hCHUuKPz4FGk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNp6JbIgNTB4E009-a8UxELRc0kUHbxTteq401KVVA5ZA&oe=6AC7BBA8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzXln2s_LoQQ7kNvwESikLS&_nc_oc=AdoxGKCUDtXPZemWDDCCuBho9n6lyzvAxhmK-MrpSc9Q2FDkgDO8VY52YwQkbfyaRIY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVrq8QNxEWdfdryJR54rW_A7a_7KZ8V7SnTPGCwIGobA&oe=6AC7BFF8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqRp2Lk1eE4Q7kNvwHlt_xO&_nc_oc=Ado7mM-ovXql6H63ynn6wDfwLyxmZ7cggJ5dARd3RypsooICkW7S1USzsjsIw6Jj1Fs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsY9nGCuNaIb-AQ6HPClCnpOkGurAGIGKahuS-Of_9yw&oe=6AC7C559"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kBS-subnt4Q7kNvwE8nY5t&_nc_oc=Adq-fRHlzljBfFShJysIfaeyjfMNd-5SK1ZPAx_QQTV4DK5lhIgQFI-nCRv1w1km8aM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUVdW5HpAKw7m9Lsj7qof-457ptT9DyyuVWhogQOS2xw&oe=6AC7AE75"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
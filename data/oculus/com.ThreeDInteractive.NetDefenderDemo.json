371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EoUArJE8J8Q7kNvwFrrWEs&_nc_oc=AdoEb9HKGIj7iI7FjpyNC3wyYVHawgRnr0ZfZ0FENiRQoYtU2DZHHnbfERaGW3O7J2o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3lsEzxVrj01Ezy3CN0p1JOWmgLfgZvMYDrRWXBGoFrg&oe=69CFAC24"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqbAi2f8vK4Q7kNvwFUa8KB&_nc_oc=AdqfivPs2bu32uzzpEosFShWsK34RouHfTqFnjH6Gns9N6zHjAUKMpEnH0_lEMIpqSA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfydllIEhJQok46sxEfjWjZrV-xts0n0KAyOD43GmawZ9A&oe=69CFA968"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Wqq4t7_e4UQ7kNvwFnKP1b&_nc_oc=AdoOos2qYfBJdPyNYSqqMA-N8CBR7_vmgbdHXwyrVEfn_FfdN02Dc8JlWVnftyZBgOk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1rI3AwxX8gnItTYsieSVupI-Nc5TXP2kE0hhps_60Iw&oe=69CFADB8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ff5N-DPJQkMQ7kNvwGzfhKl&_nc_oc=AdoEixQxi9t7nnIl7it3sj0i-xO7pk1Szs6p3_h8sZRQuZcyiOv1VZCyWVmP0j_Pr7w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxcBhl9hinMUe8HGL4PbIscFjbXWtRqZewZ2dpzRp55mA&oe=69CFB319"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68I7KBHlVv0Q7kNvwHFVYHy&_nc_oc=AdoeJdiNiCU65qvWcbDJleccWDRyEDUV3abE0P3lRKOo8-t6_usEGW0tA1dpgZS7DjI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHZmI5J8RZLoDmiuAO7UfAXMNGpe5yNfa1MAgt1NyEHQ&oe=69CFD475"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
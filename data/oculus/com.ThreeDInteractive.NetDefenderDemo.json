371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WY2IO-6_8JMQ7kNvwFwoXlZ&_nc_oc=AdpparpqQKfX9mc0v-f28fLdAoDu-iFhTT_brjjb52mIXgYqKVD4rXQJfel4tqrjdWo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF76gsFtrU3VdZF0CQBNPvtjdnuvIdvYCDjFMg8lRdjFw&oe=6A8AE124"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yKGXW4mdmcQ7kNvwFMPxtF&_nc_oc=Adq90TC8sTiaW1UoIxvo86A09ueHd0JM2CPwSQNeyfGI1JSr3JnizXSfydLs3F6IiKs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiQFxEHIktUjMFN2zj-xXzXNKabTV8pgC7m2Zcp60A4w&oe=6A8ADE68"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZjJQ20SiZsQ7kNvwGLzhT1&_nc_oc=AdqpzB-ZrDJ6OQdXqI8xPb0mlcM09jcQvTR_Q93W1lD4H4EyrtWIqqwwsBcAca2cTWY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHv12NSeEoJP1mQJK_iAJxSvYpOVGe-ClnmXTkhUiWE-w&oe=6A8AE2B8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQy2xc2mYX4Q7kNvwGVyo5o&_nc_oc=Adrt2z3tVhVreAqkArMtIwtanLLoAlVA80Rb-awqrQ7FM1jm-H_EbDyqpeSDtsJZdNQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8Og-KlwhWiRFAuKtU4QXhE--oPtHQqR34OERksl0PbQ&oe=6A8AE819"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVMVp7A6UxUQ7kNvwGQDFl4&_nc_oc=Adq_pIQakv88Nml5Ugrm3CR3v8nddFafdwWmVbITPttds7qAWL43Dw0X1GYYOBYmRoQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVIcyPm3icvUJpkXhQR_kEtEpkoOsV4NFbvhBacvACSA&oe=6A8AD135"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfLXeNDqVeIQ7kNvwG0X7g6&_nc_oc=AdrZ5J-IKGCzVyuioJ4gqZyl6Yq4Lv2g5k130RAugyZyOOPM4KmoYANDsMnf9Suwby8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65SekqpYngGd0oSdyzhujNnRnXd59eMpwWvUJt5L_AtA&oe=69FC7F24"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiIjkCU0wzsQ7kNvwFGqouJ&_nc_oc=Adr3bnHWn-Vxg7IhGtIOUN4dhbjlQFJQAPSXA4bZAubb813X8vp2a6X-wBw37kxAkHQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63X0Q_-uUYFuieGbkn26G2K7zy241JSpL7spvCj-0BbQ&oe=69FC7C68"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOKQ_FCuG8QQ7kNvwH7LgkT&_nc_oc=AdpyI69reuCasHd4rLD_Ri2KU3SWCTye5SmE5W6xIrCkamQ_u5sTIN2HjWmSQPSI3Eo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dCNnwhR8Dn7xLwhcHEB5Bf49uWFoVAzOuS3kfYGwang&oe=69FC80B8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nxdckbfmmb0Q7kNvwGxQf3b&_nc_oc=AdqfClwWkGmV83JNQsK7ZlpQMyGIIDXio1du6juW8NFOJ8sLgzKkiUqI5QRkcioWbXU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7M0s-Wyzl-zZAXzV8jMPpQqeke7YHs-9NpGPSO0CQVrQ&oe=69FC8619"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83IHeU6KRwIQ7kNvwFc75km&_nc_oc=AdqAzQAo78fQzg37DdzEVFPmddBR-WeYQ70m4kOl8uMJitGD1SC7MPi-5r_HNtvbsZQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zMK_O9fttDqbfLf6FlD_zfQdFWzXICX-un4apSHbf8Q&oe=69FCA775"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
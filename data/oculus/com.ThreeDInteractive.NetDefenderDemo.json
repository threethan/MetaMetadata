371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTen21wdU6oQ7kNvwF0D2aI&_nc_oc=Adrlu5hdRf43t_JwNmh8MNiNiUB9G-b6zlhpYobuuVV86qhR1plh9C0-XwwGCGkmxEc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wVyVuVCrlohOgiBxsnobqelQS6GxOOZb_H8NzyU157A&oe=6A414564"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bT1rae766HUQ7kNvwFl7N0E&_nc_oc=AdqqrFJj9Cpo9EOo2dzOgfmrXGYwR5AePmV2UnlTysgK0z0aI39Md58HjKlWLbxAYd8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Jd_DdgDkVMZjcf50ZGkVRCYYAndluDok4TT95GuL_tA&oe=6A4142A8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hAgU6l2lt4Q7kNvwGRlF49&_nc_oc=Adoh7lPOp284aIWMxIZVrfeVk8GlyasmCT6Wy5tzl6LP1mVDeSzBJ3-Q9XKFsbrsthE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9CbEMuBeP3ESZiUiNbvLdzAj8TC6letGof1EpnNexMQ&oe=6A410EB8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAPelcBuAfMQ7kNvwGGaBSH&_nc_oc=Adrils6QDfE6S9raKpRmHmZf5hQjOOnHpmnobHpAhlqnZEeW8nMzu3zewCzJvho4dQs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af893G5zXPnIOzjKwh99iTlK-3h9jdNGvm1QxmtjB4o3nQ&oe=6A411419"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RK_JUgW9VCMQ7kNvwF68ScP&_nc_oc=AdpL2Emdqwpqf5pP5w-TKOXaXLv7h9-DtAx_89fogTHtirw0t5Aa6SgHfDtJgIbmzw0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7dxUW5ZQ61xo_5InAKmWJm-Er6nf0k8dAxa14NE_YOg&oe=6A413575"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
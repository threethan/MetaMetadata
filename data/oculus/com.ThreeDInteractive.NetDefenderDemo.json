rKbhMeG8_PGghNk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afub1JWwmIQ2Pvk1difhWr5s4Q3NEYr719LN9nGsjt4EQw&oe=6999A038"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vhqSK8yc8QQ7kNvwFg9FyT&_nc_oc=Adl19M5nxI7_T9nbwKJQtaHKTFBj4rFcHRCaMU0z0WVRTpqVi_t7JSV6JedDStlhEWY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuDqH0Q26A_vTEmWn1d5LvYeNOwgQ7plvJu5OPYKuL2Jg&oe=6999A599"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XS73zrNFUDwQ7kNvwG_lz0f&_nc_oc=Adny80oZUOrIq_9Bet_PolbSquxd-FnQ5k3UNL5lmVm07jYrQJX-aAW2PVl36fTWHKU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftkyRIeeuwYMxtnt2Mb-8FwCr522Ex3d8ZPIopxW5o_OQ&oe=69998EB5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yFZU7vHIJwQ7kNvwGHGLfl&_nc_oc=AdpCZARCTe5IynrHLuA3Uk7dqQOvsTN8d5lgzGz9YpCWM-P_I26NkG8CEqUPlgo7fjI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6k41Ck8iGWl4_G01LksKAOE-BJBv3gjhaC3vBXm7JfA&oe=6ADE27E4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=91TpfnMqZLYQ7kNvwHFMPJW&_nc_oc=AdrRZEpKXgPpQgjmm3qG0Q44qk2YdHBrIf_6t7AZgU11oWcZpmfJxJE4i1PxJ2HQXbU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKff17SxnYyMGOpEw-NQx2DqmT5MWt11vQ2SFRw1XEsQ&oe=6ADE2528"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LzjukfquWEQ7kNvwFf9e7q&_nc_oc=AdrbnIgBum7krmO3WPpTN-e-OlinPTGuObKfHGr1WTK5MqjDt35peY7Qqdcfue5uAPs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPr-GyTMqk7J-e_g73E91LfU4YEwtVuNjYo49GjagGVOw&oe=6ADDF138"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bno0QM_6TcYQ7kNvwEbXtbD&_nc_oc=AdoFJZmzMh10VWZIYpzp6zsO32J2tLxU4BRrRhSrHORTxi52bb9Sg8fN6FmYnhBb5H4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAx6pXVPK7cbx_2TMZ4Or7q_HxvVH6DFfR-dcSRhogUA&oe=6ADDF699"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aCgtM2UGGEQ7kNvwHkXvJb&_nc_oc=AdpAWZiYQbcqbrCjuo2uD7Y-oPVXuDRpr7RdObdDnPL1Y0qwlJVc9y3EN5f5Sh90wG4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpjfcYcBgF2D9h5T9SU35Kq7cNCpffD0kVG3N2uvxZrA&oe=6ADE17F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsTpo-gE95AQ7kNvwENY8YW&_nc_oc=AdoWnSeni4THpnztTRS0fba_LJHD_iZ-yQv5SCH58a_gWxY-JHKOdh4ST_mot_7AnqI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0eANzimhDjZ3u6W9qJ6TTDH95YcsbvSVk5am02qTW3OQ&oe=69F5E7A4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cED-gYuf7vkQ7kNvwFNdmXw&_nc_oc=Adq3n22YBQ2ZPYwbxtuM96PVV4U3EC922UwXPiLbsNdLIQODgJTFhP8ZZgwEZjaTZPo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1iLUr8wNnqStAwIfuZnY_jrrg6ewk6G-C1Adg-1kMMAA&oe=69F61D28"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUDIa1RR2vEQ7kNvwG-hEuG&_nc_oc=AdrDSypdiT0wga3ltCeuU6mIYVGd9dBfuhzfvzOXGPs_HBJzWFIC4BKxjdiDEPMVWow&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0X1GcEB8zbSyRaYOyMnOPuJmrh1gPQUspStkB7JnOV2g&oe=69F5E938"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECVZgBAPogYQ7kNvwFVxCiQ&_nc_oc=AdoCKQ-cDvKhOMJdPd5s9n_J4KC_Gbx1oAjDSlG2kWBs0TLx9-5mgOesWAxLL3wWfac&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0CI9oDGPcK6fKGxvDXq8W-J9uix5bWH2nMuDVvuwfhRg&oe=69F5EE99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdEzh8c12r0Q7kNvwEsbBM4&_nc_oc=Adozfs1yZjA6_-3f5UW4_vqsKEIX1miBz5CwM5NAQR3Ed-zKcm2W-Xuu6QQVLJtoZXM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1FntYkG5SW12leU_KkCNn5qiG0MpufKruujBvVi3k6GQ&oe=69F60FF5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
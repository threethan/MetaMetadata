371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnjlNENSAJ0Q7kNvwFjyFII&_nc_oc=Adq58uTfcdzVfnNQ6Iue0_M9h3c5z43pPHr-PYsbhadgQBUBRosfCutMotqWpBFYsxc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dQKBlzsHU26Pw0QFkO3OeimFcJdR6E0jB6D1oWz0v9g&oe=6A1DACE4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXsHM_DuizIQ7kNvwEKrPBK&_nc_oc=AdoJvHXpf4Gd3Z8jwKgJEZnXhpmjD3_aio7TeDNAo9aoAqESbbGeejvjtM5_KCCvOzc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mqQYxJCX37Czh-tOelmU13PYu6nfaX4BxnpiFKdQqUg&oe=6A1DAA28"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgD9k01lEYoQ7kNvwHDZyQi&_nc_oc=AdrDDA596RyMGQ6tcdISjYXqVG2Gb74b3DrnVZZIku_UG51TeS4fE_aObKxV4zm_P6I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZPxtwBDznzchR7qDm0vxqekd-7Dt31mUJSL_hOjKsRg&oe=6A1DAE78"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZBkRRifyAQQ7kNvwFlAFec&_nc_oc=AdqA9rM01N4GDfahl7n1eRb1inkcRSd47wEZGT9GqBjD-S9sQXnZcAhjMvYu5pxPKwo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6l9wzrDFXOBLdxwr_Shs-x0e8KLGQF-kIo2VDQhD1fFQ&oe=6A1D7B99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_Iu-c-ZQ2IQ7kNvwHyAkHY&_nc_oc=AdoMw6wXVOT1pkHK50jZCcH_rjKhTI_sSuDiJt9cWa2HlS_0TSlD4F8RS_NO_WAngyk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cyGD6NeBTyyx5C7NNFIDsodOBzZ7vMHPzLbfBrPf9tA&oe=6A1D9CF5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
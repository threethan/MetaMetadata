371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqDlcldIs1YQ7kNvwES6cgp&_nc_oc=AdoKDJnTOJ8kHnC9JGO8UuF5PyFYZ4ZPYZvYiEPDoxXJsgwgMrBVkBFQOnJ5roukh_Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qKPcaJeF1tn54gpYwNpdiuEP4tW5LbaaMbjDbISvQYw&oe=6A4501A4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bzuW8DME2UQ7kNvwFQo8Hb&_nc_oc=Adrh9MJeL0XoK9IYjPxbHZ3Rj81-sClHWGk6-Kx2waPo811txIdrcUgH2ES5nG1CxFU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MdNxBsz1hDFw6lg2az9B9jUsQhwpHrg5IWbRAzRowCw&oe=6A453728"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lPXScutVsEQ7kNvwGgfX-9&_nc_oc=AdpxBNctu21rR4wtcrJ-g7uZiIjMaZ709TRpysciZ_eqEgjDOKMG4yXG_n2IyPoWFJc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NREoVHngXn5iGC6lOqI0Uw7DNR7qgiESnlNtWTXAnDg&oe=6A450338"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwVpz0tR8EEQ7kNvwEFUTzl&_nc_oc=AdpKss6bat1pUFZoNnhdXNys8mHBbybEv4mVphPkOPY355wruKVz2oovYcJdrXTCAMg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9azZKAh-6NVgprrusHamPhMoS7HJcME5OPCNzrp43dww&oe=6A450899"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOU8y3mmZoMQ7kNvwEmOVpL&_nc_oc=AdqsYZhM_kO1vwn0Q6EvRqNHupPAOhy45aEzF0YGVTcgBhqBB9KaUschUgoPjE9SNPU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ab3KiOegObhiVWroKBtGpDddxNOK6dKpWdf8jIpT1Vw&oe=6A4529F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
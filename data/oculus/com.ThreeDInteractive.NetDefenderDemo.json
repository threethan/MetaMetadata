371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WY2IO-6_8JMQ7kNvwFJIpMI&_nc_oc=AdqdzCPJFubo96h07B6K4pbQTcdcLO2rSjAEKvrt4P2BGm-1zRUQQix0zrA0qNu9FII&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHM8f05BG4o9Q8ob0OOJClAnZ6MVeZBK3kJrHHkY6SHRw&oe=6A898FA4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yKGXW4mdmcQ7kNvwEcjetL&_nc_oc=Adp-Wh2w0EdUEm_JNem3vAYYodrdZV19nGX8-63AOM_AePInDG35hFSrV1qyylLfMBA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgjPCf1kHqjhiQqjvj5rLSAj3Nf5pjQ5fJ0f7Ixr35HA&oe=6A898CE8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZjJQ20SiZsQ7kNvwHJZswJ&_nc_oc=Adolmwb_AuJGQKa3_neHpcdqVfa7hh7rAUEsW4rWajLK7tKznaEJmrFMUkQuyFx0e8c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHF773h75qfov1Hi2GNvCh_WTupp1OlytdMq1kdrrEq0g&oe=6A899138"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQy2xc2mYX4Q7kNvwHxmTyO&_nc_oc=Adp0CHQx6sWTmVTcz2b-OTH3uID_-Et1WX_DYOekM7YyiAZEG2QKnSpmtC6XBPHiDd0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoOnNOy1id-reH-UgpWcCmyDpkbqiXSOviEohv0XXosQ&oe=6A899699"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVMVp7A6UxUQ7kNvwHidsQ_&_nc_oc=AdokVAmvhooD1q2oHvfzZk96-OBJbBbRJxNEWVbsdt0ISs1-E0qqKBBcjjFj4--FREk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGojV8Kpj5NJaEdiMCI3o_5Z1vVIOc3xQDaw8gSsRud8g&oe=6A897FB5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ui967YbUMVAQ7kNvwFJlFsK&_nc_oc=AdpSZ9ouQivEc2gWG0EhCm4MqpP7NwLMSOX9wTIwa2lrt7qhhNXw8Y6FHkIaqqHVVe8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIS1lMJjEILR0FlS9vIwE14Zm1e0_NiidiZXTHFxiYcA&oe=6A8449A4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKy0T-CwNrgQ7kNvwGZhO1x&_nc_oc=Adqgb7vEf-65XoIn0BebuHRoCldOE__061pa068_7JuNM4WGFLayXr-cyEtf9651irM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFf_5QWGW1wTIA8jkGd-w0aTMpKEXJIBHGdR7ZtgwrUtA&oe=6A8446E8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6V1xuX2d5W8Q7kNvwF-riwp&_nc_oc=AdrHbK2IjUGKWN-k-iFuEw0YAsu4YMunTbdPWKs2-g7NLNOks4PJdeMwqKO-nluO4co&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7watGrp_HkhnRZ-NN5dQU3E6ykpUkHV5Hd5QMfHyZpQ&oe=6A844B38"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r98YkFVMkdwQ7kNvwEMNLzK&_nc_oc=Adr3DaKlpfY3a6dUr6y2x3owHAKYiK_KrtKQOhBlz2E1VuM1Vl5R3nYuid2QwBWCPuc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQRudJkmmkqK2Zpq41-Y8u2PQVOHdwtGY4IxFRPrF9Kw&oe=6A845099"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95KtyW01DhAQ7kNvwFDWGK4&_nc_oc=Adqp5nlvhopCzf82ybQBv5JgzfU9ppcu0xALDgzS3wJ8Wien4GbB_iKdAaM7niws7Gc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvWGWiMgzabG-qPortIs65PYkE69gAYRym08GkK_3vjQ&oe=6A8439B5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlqd2fj4EKcQ7kNvwFF93ZA&_nc_oc=AdpiM_WNzQ8i14zZrZDjFBoxHkNncx5GgEM_0L2XbQ9-8gJu8d3wDcQf_H-3ygZBnok&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPX0Eo_SwZ8fa10im2L3lsNr7dcOIxcPjmeaTjhZ-4yXA&oe=6AD39BE4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJmCKNpP8nkQ7kNvwFtzfH-&_nc_oc=AdrmAP8C30LABqkLq6l9KkPF3pm_V9Ib_vAWPaGesLoFSsxYf3eux_9IFIm2-7dK4gQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrrH3iyJbZpwWL8kR1NsspSQI4rMheL7OpSXXLBr6ojg&oe=6AD39928"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlN53CqC2D8Q7kNvwFJWyd-&_nc_oc=Adqz8cosdvgTq6qtNaDK8G15FIhnYPYj3nYoN4U6bobFtzsnJaNS1q0IyYR0J-w8lJI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3iuu8tjV8PbCaUCBi9eDUfawfTQ1Ce6b1wTsOCZLuFA&oe=6AD39D78"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mV82db78CEQ7kNvwH0_yai&_nc_oc=Ado29-dDndzYZ6Vq6_nV5YiMLOKgCknMAl4wG9azQgwG5RL--LhwahRLUw4657zOtd4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPm1Czflp0RzKrgRrhmhM5IYB9ZSVp6sEolheh3pLd9Tg&oe=6AD3A2D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEfwvA_-McIQ7kNvwGe253C&_nc_oc=Ado6nmJXQn5hQo2YcJM_wAbg-C_DXh7iSt_5y-YtvfckxCb706ezFkZ3sipccZJ4pP8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJP7lppR0ok34zurjf603UWCELzBoLaa_dt--nDzIdfQ&oe=6AD38BF5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NX13bgICWUgQ7kNvwEMKn2o&_nc_oc=Adr15NUcBmWl-AOlgBqmBoRTps2uvcHYmmM435odlsYYIb7KwUy9V-hcKJNS1-ne3Ro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PMZrJab_zuvrL_B9Qioy3j1ze6hjGG2OBK82JlB3TcQ&oe=69ECAD24"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Es-J6SwF8vcQ7kNvwGI7-7k&_nc_oc=AdpxdNtMsKlTioS4EBqpq4s5wTCf5_GnRgHiJ0rqOXCJr_Y5D9VjBe2fwjbhSSso9rQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nVN4THyJdIyjbui-nnwu0_hamGNFMT4KRE9y7HCSbrQ&oe=69ECAA68"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHmHrVV6auwQ7kNvwFo09-r&_nc_oc=AdqZ3gJwvwyqKatGCq74jMNAigsoGaBDyls4y_GFJZBu1LoF7e2d9vGqS5Z7b91LheI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RDAxcNZsf4s8KRQ-NsNzXJHjX1SbACVMRbrAFCy-DGw&oe=69ECAEB8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAUO4cdgkkYQ7kNvwE2OGyw&_nc_oc=AdoY7b7sFRFrvQAWVJCJoA8WN2IY9HC4aPHVjT2kvmZummVF_92-wJYgVz9hsUnjXyM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TMZN9Pv25_UG831-pagfsJwVcd9wzvB7pBwaAKXMyew&oe=69ECB419"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esnO5iVsr5gQ7kNvwGt0U75&_nc_oc=Adrjyw8EOVNhUpS-qEsRMBfcJfsgiwZ3OdCRhOvR_QkUfo36yihG0pnKvI1MPPvu1wQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Z8khP4G7Z0Nb7RpQ6QeP_ASrY3Al1QDLVKcxlL6L7HQ&oe=69ECD575"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
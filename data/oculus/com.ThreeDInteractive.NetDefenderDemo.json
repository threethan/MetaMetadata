371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdyeo-0_7owQ7kNvwGRZkkU&_nc_oc=AdrtwgOvBN5GdestcGew49ikiHInMTiD2kkHWy3YDSVG2V85FR-zepBgoSB-FBuelrE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqUfXVyLuPciOhSUzN8fGvStbNvE_NFPinGwxQOtHXew&oe=6AEB56E4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zKzPVFoGD0Q7kNvwE7OEhw&_nc_oc=AdoWoStFFPQGB2XA1NiIdzwxHFL-0WHOgfo6MrOxtFfwfNB8sitc5EtBSPlwkx9IDVk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL07JUCcwJ4ONwrOxv0et6xqOIK09-3lPQXdCrvoGLFQ&oe=6AEB5428"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LRlb-n0dLQQ7kNvwHRl55T&_nc_oc=AdpwMOZVH5iWH-1bsPcQ22lDvvJcOsEh1kyyeF2tzR0-FZcF7yUWbzanGzyDHyczQ3A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMc9pRkFN0AUZgM-O4_VB7EnxzmqN_7gsaWaGh_LXb2A&oe=6AEB5878"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=um_IPQTeGXoQ7kNvwHEJwoO&_nc_oc=AdrEii83qGLTNqFwhxr_XT-e6dvPspebreIilHb1dQKIFpJYd8u2NzmCBnEWIoQ1I20&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr8lj-06nW5cfbb6JEr8qeQa6sRTQdy9hLlEGIpbdevA&oe=6AEB5DD9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7SMN3_BEnQQ7kNvwFsOXIp&_nc_oc=AdoK061eFltTGMywIVfceYP-PQxiH-31qBNWny3OD_Sg8pQdZlCA76E-0v2OGg0_tLs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhxrwrXT2Mrn1RMomq23v2ou0s5fItdXR0bOD9MiwA8Q&oe=6AEB46F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
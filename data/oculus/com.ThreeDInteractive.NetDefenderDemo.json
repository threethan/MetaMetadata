371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uypPexS0Uv4Q7kNvwEIdWNe&_nc_oc=Adp0EuuWd8QLPCV2wF8CA0xOMhXvQoCOffaVg9TtfymeYyTXks-Gut46YhwDTy5jSy4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58-D7okiJMQXxuWXMFmEBRsPuDZbBDJq5bPudfWwp9qw&oe=6A0073A4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4187pyVajrgQ7kNvwGhLl-I&_nc_oc=AdoPz-ih8R8lfj087FFrKWjgoJ_m53ltPzAijMD44FPxwolTokWOjcExEGDVkSwhDms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5I04RJbUvCApNVCo1GJcJSahKO0OdanPpfwEuHmtxV7Q&oe=6A0070E8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59e27ldVt6oQ7kNvwGZdTW4&_nc_oc=AdopNvC90sTYl5WIVzySGTIgTbpIpJg5TZu5ZRre9RZiKzYBvyGBkhpMux1C84Fh_bk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NkBhq2NiwwZ0nrwQkovPt7m7wx2LpEJ7o9t1R9BGBOA&oe=6A007538"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ULNdisvDTwQ7kNvwEyQvvE&_nc_oc=AdqCNnWXSv4-LpchPF3gY5-7SSLDDtDG_eXjAhUA5fY-XmOOtHAgI4Bi5rF9nyl4TX0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Uo_fhE6d8exQlSCaMMiksnardPLhd30KQVJ24N5UNsA&oe=6A007A99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I142BA47bLkQ7kNvwF4l-8v&_nc_oc=AdpCjNp2LwACfkfczxfV55Cb3BtcDvBVdo_oMQTknidFEuT4RAt8ooi03BlWjR4Nlos&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UFPguDXSX8a1gaa1iHm7uqiioenmVm4m7owRvhr7tzw&oe=6A009BF5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
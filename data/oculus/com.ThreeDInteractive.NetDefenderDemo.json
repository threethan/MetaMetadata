371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrzRgq5OYIAQ7kNvwHqz3aq&_nc_oc=AdpEiGcw7QnEWLcAov00PgsoHLlB7eWsg9aF13kHT_Na5Zd_dnxaqHGPWS0_U9mDu-U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JGB0b7KfSndnXDVJuwESqg12Zq6JoVkDGosO4YIHUIg&oe=6A26E764"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31YUOsZQQUYQ7kNvwEP5ADk&_nc_oc=AdrTZ1tfq7XnB5UofCdQBXddtdHNJ4VVCnZWwGGP4gMlnTVSKI0c_iWZQCRE4XHW6Qk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9q0c5GUJzm2SJLi29exQbi-meacyD-Lmrgw7wNiCQ4CQ&oe=6A26E4A8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A23I7Pe766MQ7kNvwFd_0yz&_nc_oc=AdoReu2nyIeuThUppDcNFnF9jjHsEZTf1dqxGwX5A5TFeaqM2GZRjPJ-5IZgSpf8lBw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WyI4nove-S2IQEUqLHD8kIod685VH0_CLn5VRJ7WfAw&oe=6A26E8F8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtVYqZgtuisQ7kNvwGqTOWH&_nc_oc=AdpRHD6VMAwBpIU77LlJik8jJv286U46NIV74O-MZ7OBbSpoPmcQLNqiUEdvOphzbdc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QlayXrxeKKKISL4hxHqgfVF2bxUzGggKOfmkTNtLUVQ&oe=6A26EE59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eic4X3MauLMQ7kNvwFtUja2&_nc_oc=Adp6dT0gTSiHg0bMOR5dhMyIQjE8kxnoA6DwcgZuIx3Tr0mc9SrUE0KLNnypTb_pyKk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eO7B4fbuTikVWwpHtQOEKhyUSMSjf9znzfhSu9TrbRA&oe=6A26D775"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
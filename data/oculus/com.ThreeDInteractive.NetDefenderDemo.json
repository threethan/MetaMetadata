15371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMhlmEF9O7AQ7kNvwHxJYdr&_nc_oc=AdrjpPiJcdN8EOZUb4zFsgQImiqqhy4FTkrJ5YtC-6OFcT3boj_lOA9GV1knx5JAK7k&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JssLfnbiMnF08OVWjhnob74zroi6EFG2kjGUGW4WQqQ&oe=6A22F2E4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGTkamXMSM8Q7kNvwHtIytI&_nc_oc=AdqyfgYO66StOaojhisV7EfMBYWZzhvlKwlDK-ENQ0uRlE0UWqwrFHciJkPMWwN5C2Y&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LbkHWGPE8j2EWzb6rA6_EnaaESKtTYHWT6u9mwHiuEg&oe=6A22F028"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eH6uCssWV4Q7kNvwFLEPN_&_nc_oc=AdreWZI76qdJAiWHTAKLJUKRvIoK6rEHKwLTY9TQ2SUFXMbWE9f26Hsg0K1ReT90o3w&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YjgkH3W3cvhvZwz0DtjqO9Y1R3tVyOpl6BQ2OOMug_g&oe=6A22F478"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1H6r5ZGrCAQ7kNvwFBU99c&_nc_oc=Adog1-8i0L4UVugaus-eO9iAlVuFu9qaQT3GFomSLiaLnlkAqqfQV3Lh0JM0x6Yc36U&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K5sdRZCSntsKv86dVBqJroooB5dnPNUXHo0yFFTtu-A&oe=6A22F9D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vHMFUTAlC8Q7kNvwEgfG9r&_nc_oc=AdqKZr9ZLQeDmXHdRbYoVy-sxzZlLntadqbfpOiFSL0K6FCzboUMI3FLe_eLbcbqCoU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EdZYM8wfWIZgywkQhC5JjicwTcGx2uh2Mo3aUcwTYlg&oe=6A22E2F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVWy5Z7fqVcQ7kNvwE0dEG6&_nc_oc=AdqxsypetLD8SYT70F0odaXfwUm3qhyBeowAuZN06cQD2GZ_w5PC-lCXpwTP2J-Cz2k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkS8--SjP4ZTpq9mtAHKY0JnIWEp4B--F9fOdFd9IRFQ&oe=6AB154E4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSxR5_Mr_9EQ7kNvwHuXaS7&_nc_oc=AdoeUxhX2cGtAS3bWzhcduP81OV87odsQEC0yUVVei9yp_jSuIp_1c4mbnvMREq_T2s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2lMNmYmU1TpdvCcQTPK00G9PcA2jwl1KLq3fJwQ94nA&oe=6AB15228"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWquCSCxCcUQ7kNvwEcZdC7&_nc_oc=Adoj9uAk3m_hOq8mg0aguIStthohPGBrREsLLOBp3kW9P3Yd4Jyr8WW7fbRr2XRzFls&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNKaGOew1vWDA5iJzzb5VwqGcb77SAUAXiELtZzTXWgA&oe=6AB15678"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfppgrpdG08Q7kNvwGHXmG-&_nc_oc=AdpSzgUybPbIYa3xH2piGVTiV-NwpHvnuSzvEu1KZIH8GHps9QJpdfpEn8JrE4hBfMQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzyXDKtOR3c4AVB_AlH1cGgLNGTRERt45d0ixA9cZ09Q&oe=6AB12399"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLylQQwRO7wQ7kNvwHb3PAh&_nc_oc=Adp09_fzwFDYTJvXZJl9Ngar9CyeWSyB6nAxFEDFxSF2haxL-sVi8OmOF0ms1beJSEE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcdAVNyOInYli8aKPnV1ar45Ku_D3LVIXgv-YTaQ6UIQ&oe=6AB144F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
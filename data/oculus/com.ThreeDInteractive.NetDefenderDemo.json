15371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtFbV0FUxbQQ7kNvwEJu0Gy&_nc_oc=AdrmAtj12CMXwdpBc1KraKRA4S0Wb1UOlGqnFp0mnQBlXk8GIr1cfne3PC-XwY0jyFY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JZL4mWrlSsU0FM0pD6fizHGO6GCZux-aLErmj0_1NXQ&oe=6A36B964"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrzRDAuWZNcQ7kNvwHyGgJq&_nc_oc=AdrUoEQKB06DPIo9V9RVbl2VDvqKIbmGc-izDY7e_sJLHMPhG75k_Rfmt-ZyO9HnRFs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_O9AQYH9WwQBa0fIv3JL3q-nErab0XfxeMdOEVagrMhA&oe=6A36B6A8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPc_Q--wsNYQ7kNvwHkMmgj&_nc_oc=AdpvK1s--tSpmmK3TuHbHx8YCGKXY1_0Vvg4mxCibyKMQGyZVObwkm_gmTEih2-NtfA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HJHb9nsQU1_AkA_NO8DMGtRVvo45WNcvFjgHOMwJiDQ&oe=6A36BAF8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCtK2G6PJUsQ7kNvwH9Xzcg&_nc_oc=AdqEutOnWtB6-h-1OZqNqzz62l3oNnT3uQlv6uR2tqMJBv2JXa4r554yt2ED1swo24k&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6E-HbsPM3nC4TJZHS0v_juAgLbCENAqoy-OA4kMQg6g&oe=6A36C059"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3B7SFr5PI-8Q7kNvwGRf-Ou&_nc_oc=AdoeffHsCX8ao6WZ-lbSdeOgh_OVok4R0P1Y6N9pI5FJnCbPfY4MYArCpBVsHvb6co0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sYygYWWjX-wo2c7I-cZ-Wcj0yo48DWWsSXvb_Cws5rA&oe=6A36A975"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yGx3EpdGU8Q7kNvwGpEPR0&_nc_oc=AdpHuOP14YE7DBhJ5MMScz4nOnkOLof3fK34b4jJCjHI6JxuQI416StBg3cSHSrzfW4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bUNo0CM3rn6TTZPJ1Y4Dv1hFfSUZ2u9exJsFYw16YgA&oe=69D4F224"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xm320pCVrGEQ7kNvwHzqUTE&_nc_oc=AdrHYUfl1xHn_gEWcJTqRTWxe_xN0xiSJz1hw_5vhrDBO4g4c800Z8cm27jpG6GcVkA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0h2H1hnSyGxKv9dRKT3zhesfnOPizuWVu0CuOrbJRK-A&oe=69D4EF68"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Br8of_57B10Q7kNvwE9giUQ&_nc_oc=Adq_xohxIq201ldoHss40kEiawo73iBgeEj4MyD5-HCouY_mogI27JpzgiQlbgu8wUw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VhJlHwnWfi008blHS_BafWN6Zx83by1QzALdJi5mX8w&oe=69D4F3B8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jg8-ELsDrcQ7kNvwGePpUS&_nc_oc=AdpOeSE5LR_Ek2V_UTXIceuEh-OPTClrGrkfEcFunbPxdqMWdp9KY41eWJUnMP4oe_M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MHNP-y0KRmnmAsxRTxuuwOCAc7CXsJAx-n1eKgglTWA&oe=69D4F919"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlby8-0PZrEQ7kNvwEBLWYl&_nc_oc=AdpC6rlL2bYcD9llazcXei3ffZyy2hRy9gi8lpmlU2carqjQUbVosHlQyzH8Us6nHrE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1y1MBkZ4hpT4rUoYjtTGTLnjStsGChyfSADxvK7Po6fg&oe=69D51A75"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
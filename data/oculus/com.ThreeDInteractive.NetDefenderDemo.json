371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLxcKu1aWTQQ7kNvwGaS__h&_nc_oc=Adq_RgTOZlPeH74UHjJn0b1wqn6_A-UsG9yNvdj2t4PgdcZfoEj12manehoma7vA6UY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBix2LD1VsAk6dBt1TN7URvKLKouyb1TFGqBQ_gr96p7w&oe=6A6DE024"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cndkzf0qBKEQ7kNvwEU8e_G&_nc_oc=AdrJnZs1ZP3896_6-8p7WE_FkS8OkS8b6-BjI2wdMfvl9EwrG2ZnLLIJEAFyElfLoME&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYFtjxKpIxW3BsqfHmMNyxHWl6S6i6z-3Wi1FIX2ZnNA&oe=6A6DDD68"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58JumYx7R7IQ7kNvwGZIXs6&_nc_oc=AdrbAhvKS6t94rEuPfRyRa0T-n9TnbZYBUk4bD-2OrG0tlnwhkYXL2tKyEbQ9WkWKMQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4630_fl4HbV6fpMlA7jfZH4Ypfi0qMQgn9TYN33xvkQ&oe=6A6DE1B8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZgfwbNphAgQ7kNvwGsAtd8&_nc_oc=Adryn804KBK_BZhgM2zL0PyD7Kq4U6S0hZf4fD9wIRxg-NCsz_HDuUpLvZk2dPPh0Ro&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAP22gD9whcC5dvrFvRmwowVu_jGGUp5THpBQtS5j_TCw&oe=6A6DE719"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVTElt4iYcIQ7kNvwHSi7Jr&_nc_oc=AdqmFZQxTlkc6DhcjzBx1pO6x5iptdn1MjsW6481L0a6uiQIMhW8qwKzR8hjmV184ls&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8u9p8RH5vz5f6OGCJFYA8RWpxzQN35uN6Vx9Q7zwF7Q&oe=6A6E0875"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
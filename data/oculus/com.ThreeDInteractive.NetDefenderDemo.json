371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5c_8crBxW9sQ7kNvwEf4UQE&_nc_oc=Adoi4Gtnxzuz7KiJGRHHRhR65YvHR-9xwBSvpvkBrRqlAbh-tn06zMPAyHIAXRY-bJo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14Js9Pq7bM5_e9-Npq9Dah3uPHka0zdRkO3wpOu0vrjA&oe=69DCDB24"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUvnfVT20x8Q7kNvwHQc5uZ&_nc_oc=AdoiQei4f4RwKR_JsyS--Omh9enblz5hMEAhMI51nzazhpLC_SJuvC-th3D2QdyX_Qc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0z7Qpidc8FGdhgB4y7Cv2JzIM-Em0Ds-0WES32f9A0iA&oe=69DCD868"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJ7jA766EggQ7kNvwHupw_8&_nc_oc=AdpiCZ4JjDwnjMipXFJiDAfg04U8dfYMr6zrM4kWanvCtbYvv-Yc5p2rJuyuPImGhqk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af221R3JfO8zAOdZXDDp4vnzIDVIVn71Qnn8sX92YtLk1A&oe=69DCDCB8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEs9MTpaY9sQ7kNvwFWPL5c&_nc_oc=AdrXCG3YOquLyY0x8z4yxDJc-rT3rVq91o-6-EUwIrCf9GMlQeQF6JdsKRheDdhSXHU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25CeSQX-2_Id7QRmOv3pl-XHLQhdYO15w2BUoeW03taw&oe=69DCE219"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fR2mVoHKptYQ7kNvwEwpq1W&_nc_oc=AdpR1YzMEyn_sKKvnBDsgQni_gfG84lFi8YOrvHyb3v3E_FzNzvZ1LCBJ2Eaf7CfEec&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hWVplL6Hi_mbfA7wgbb60roUiHWbyGPFHnVnE_EXdDg&oe=69DD0375"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
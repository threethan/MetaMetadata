371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOrBMlqslWgQ7kNvwESBUP3&_nc_oc=AdrCzeUU7krFpTqJw3P4FWLG_fP4VtZKEH0NocYwXsxi9DTrbSizVOZfIraQrf_yVjc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4i5W3RTMseYI2wQ6KKFLaiLvRHkNRnwHVn19s5i9hJA&oe=6A786C24"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLzOlqxyQXIQ7kNvwHHbsea&_nc_oc=Ado-iSN79BkjUJnDZ9kL1-DDlj2wCsp2Mk0epHnyV_mA-QUEwf9ul6JmmmlELZGl8O8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxerAw6dCDOFsktz-LhcrvswJi7LaaVfg_SyNcqksLSw&oe=6A786968"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5T-xIIEjvxwQ7kNvwG4ysJY&_nc_oc=AdpU3_Cb4uDfbm8K6FniSIbYcMn73YetJWRa8NIzmNsbH7o5-NWaLAhEsmeENL6VnEA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaBXb8hzNWxSCsHk1PDlnEVpl81yLBJPG_fRUc0uIhYw&oe=6A786DB8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=des1XB8WPwIQ7kNvwEH5tm9&_nc_oc=Adrb_i4lo9Hg-vjFAF5DNRUwoN0WS4AbcWLW0S2q2TntSdg7QS9TjposXz-AlKNdR_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZyg31_Sld5XUC53fbu7qmXOgpjkAns63Y_J0ZkQB1xQ&oe=6A787319"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kgz9NxsiHiIQ7kNvwGPR8_l&_nc_oc=AdrDf4JRH8zI-s5nNQWl5kXbWjkqnpQgVG3QSPpFtpy0K3c8nxLjAzp0BgaPOIj4r4o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZvmLGawu1x-UaAUH44UaWZJAAKPbsYn9QXQojDRIwPg&oe=6A789475"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
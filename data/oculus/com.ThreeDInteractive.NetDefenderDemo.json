371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djVZz4LyQU0Q7kNvwHUFZdx&_nc_oc=Adp8Osr1JY-DCEAWnTXsblSYzYCVjMk2ctdSchXQepbBtcmFqRQTI5W8YgmpvnIceZk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3MY4kjLK_2zUuCHIEjXS6DXKcfl05YVF4JfAwFATyyQ&oe=6A771AA4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_InmpvTi2asQ7kNvwGCPyiu&_nc_oc=Adr5bzZAxfuXxp5TkNBcn1zwpVUMsVsbzTGbJ3vkZS2ifxZlrBgLv4Y7FvLBnFWE6PM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH42Yqc9KkRfU1CMflMIvA6vq0c7JoJJv93flAW0tw8Jw&oe=6A7717E8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xoFP9_eZssQ7kNvwHDn_aM&_nc_oc=Adpo3qyORPUUVHbM4FdvwpLCAS5R3YaC0ubOFli_HTlyyw5vE8ngeB4RmAWQp09OAVQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNGHtGLfPIFVOMV8hQFzaUPDviTsvHLtibrgpKPfAz3A&oe=6A771C38"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A48IZv_PfYcQ7kNvwGxgUgr&_nc_oc=AdoLxhrQnBVKD6Po0KGOgm-K6_wDzlkPflkmvN35y1Jt9IwYkw7DzYhdgddUPp7ae2M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENdCATuf9kcpFl7L_tulrGRkwzdQGJO9xwhab_EFX-oQ&oe=6A772199"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kgz9NxsiHiIQ7kNvwGoe08T&_nc_oc=AdoXCtjvPdLvz5k7fpMHvn-cmX7_C8-Ho3qa2SFXynubds-n0vv-1RAS79cRev41RlM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmvZEGA4aFlpZB5b3sTiVn29y3mFRgnuvQqasWwxYmTw&oe=6A7742F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSWC0yn_VDYQ7kNvwHPmDj4&_nc_oc=AdrXshNGz55CXCpwSvq5la-roDAjFI5_l9VzNIntQqTODmw5IuOjESADDgRRTekNs10&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yXcJZ86jFxKzNhR6VoiM9qFVse2ks38tTpYaTJBuIdg&oe=69DF7E24"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kscjErdrJ7UQ7kNvwE54fwj&_nc_oc=AdppZ8kMmQcBGfFerJy5_0Epl4YaL0VTskk3IdPFWNNEQfwLcVTRfYMt6biunPPYseo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WmlX887MlN70FVpkflz0oBlzg_VSnt37HgvETO61c4w&oe=69DF7B68"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ai-47l8bmywQ7kNvwFahXtn&_nc_oc=AdojomM1zfznLbtIn32Sn1An5NKYq30Vpc_DCFPP9G8aXXk9mzzVojP6upBWZy7tTBc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wfdSREn2DwT_QSjKV__Lneb3F5etaP6ex7Bd0I1du8g&oe=69DF7FB8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnzBkXFZmS8Q7kNvwEVYhYO&_nc_oc=AdrhjGIW8Qhh1knGYjfihjdH3i3oxC35mf_yxJQ7yfAjPgVi-vigbkulqQIQrsVTV24&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af379akcVn7QdDBQ7JrTlRhF5uKCUf7gurLLImPUKcRbpA&oe=69DF8519"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fF7p3CJg5_cQ7kNvwGCOP_A&_nc_oc=Adp4Wk0X08ITJ5UVOV1EDji4u90DnZrLetJXONe7gt4_sA89_qp4XHcB3NKpBVyxX1A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MS18fQpCkkUhI6PTysQgJxATCqLPh_a2JGgtlkjhEEw&oe=69DF6E35"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L16tebUBq_4Q7kNvwE-Jf0p&_nc_oc=AdrMVnz02-_BNA2zWqU1Dj4P-BYL6neI8PljwICysx2XX6GoYCi9HDd7ltuv9IIYMqM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af940wSCz952dhdJpBpP4nlgW-4TaCod0lR_w7K-Vj2dUQ&oe=6A2C2D64"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iA37RM0x6EQ7kNvwHqi1Ke&_nc_oc=AdojFTl4fNXiSUW8pkFdWIiyqJigzd0QBX35xG66uyKJc1Q1vbh8m231XxGlQbiSU9g&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gCGOhYQqfCZQOmvpIa7lWCmrGDPtsgc1UeKPOF3ar4g&oe=6A2C2AA8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pX7SDle7PCcQ7kNvwESYGKW&_nc_oc=AdofhJdlAf2u0FOIWxbhLOEUDDUdE3YWsmgFSj6vSKAO9WLvdWoF964nL1nUQ5PDknk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cQrxr9vC7aXfbIcn-Cyk1aW-ci0klhycqybUAtk4gXA&oe=6A2C2EF8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4FQXQNBxNsQ7kNvwFbMoeE&_nc_oc=AdpQ04MopjNv_JoRKh6T0vhRQQIXTXen8fqCefwFh8yBl-xoAaXQQDpDqxNxlc_HJ8k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fYtAFjmjlN-KT0MwleC6ugCvvgDhEWx-PtUaTYtX8oQ&oe=6A2C3459"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtyIbCc4y9oQ7kNvwFEVbt3&_nc_oc=Ado44KhrXOegUJaAiB_LqCXc--TNM7WQ8VvtABFQgdNPVUrKCcnJem1tRGOiFYMP3-c&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KAZXVPKHYyHNfqwRqEFxxoqeoz-jbVaWhbFGKyfx_3g&oe=6A2C1D75"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
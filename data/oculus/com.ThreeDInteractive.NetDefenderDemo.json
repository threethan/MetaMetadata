371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_-VWQOS0qoQ7kNvwHaC_x5&_nc_oc=Adrfa0TCEnc4f0b_pWuoAoKNa4xiAUXpTaOgoJ3KAXkxx7dhhaKXhYpV3XP0e5R9AYI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCW_UXG-kFkxl3bAV5Igv6yx2-C7kHY-SIFSMGHXKxZQ&oe=6AF1EE64"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_9rwDDVm1UQ7kNvwGg7iWk&_nc_oc=Adp2HGQovbxwBT8FIKHHOjLDBQTIXSWLBhF7jphWRQW39fsyqDQmtH2I5vMra-mlRkU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLyK0zcdB6HQXHOFUyC4ZTH6jtk0Lw9weT7d5rsnboLQ&oe=6AF1EBA8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qjm-1CDnnyQQ7kNvwFo-BAq&_nc_oc=AdpQSSnn6WsVcEm58vKK1_0gxnzd3XAE1tfdUW_6CS_wlK6aU4q6Ij6p924_3llA9RU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHa1563f6hONylqjm4cnuAVPetZ1VpcDzjLvwFR6rAQA&oe=6AF1EFF8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qyx5Zp3-RoQ7kNvwFsw5FA&_nc_oc=AdqrxBbUk38PHNjxfrtK3A3tj4qlI0YAIFtd3vlt3Bpq61BP6dkWj5d7_mWP13Bl8cg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRphMzqBthZ_l7K2GN65HG8FOhlJUGd5r_E2hrm6sQOA&oe=6AF1F559"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a86vcrdY_5EQ7kNvwHVaw7A&_nc_oc=AdqlFvWXcq7pP0u15pTWlf6eItdcOsrqNn5G6uES9bpx6P4-wAuY-4l5A7oIN98DNPE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnP3oYkRURg1mjWywWsyppNx0_YtH40zl0pcBy0ZOKcw&oe=6AF1DE75"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
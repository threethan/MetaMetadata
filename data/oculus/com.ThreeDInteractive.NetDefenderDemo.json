jQ&oe=6A19B5A8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otDnWC4ExVgQ7kNvwE5Il--&_nc_oc=AdoyHQw-NdYiqN0Q8tRlxUeSDWcdghzUHXZHI7Qj8oH_e6NdQdKAHXLyhgZlwQxT5tw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QNmQVn9D5UKptyzK3-iEm1gdE4K6_m7Xr3i8A4RxHZw&oe=6A19B9F8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jR1jYkOgzsQ7kNvwGavL8V&_nc_oc=AdqH3JzJcX5CZINB5oOvID7wZYw5KGFb3V7vAByXzODzdYUBd3PUIBRq9gTR1KQtFAQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VoE7dnFqUmtmYM8WNlO8XysqgcUM_T26KCT9-5Bt8ug&oe=6A19BF59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TY-eh3u94k0Q7kNvwG64qr8&_nc_oc=Adqhsy10Rdh4VWrmlHxpo7X2YDZYEKx6Wb-uQizmQqN0G0SmkWPGKOAOM-IwLJd_PGE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uITUPPgEdCzVD3pTMbXy_m6ZT2X43XPU2qoJLqDAG0Q&oe=6A19A875"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "550679720579565"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "513885774120174"}]}, "baseline_offer": {"id": "513885774120174"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1683654844, "status": "PUBLISHED", "id": "513885774120174"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9121715974569110", "version": "0.1"}, "id": "1683655178736723", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-rQS7TYrQsQ7kNvwH45X3S&_nc_oc=Adq2QekACBsrYUoUT3g7HvC4cT6ihO2iaA0YH1W6hrocuUEJ4eVnmWmdxMBJnwEK6PY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dFX5ttPJ1djvHk28qnq90StcwfluUz37F5qgylPhtdg&oe=69E615A4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-pjih-NhzoQ7kNvwGepfbx&_nc_oc=AdrWniP9b16IyMN76Yeqa3Q7HUigjz2ENmn7o6cTvEphsJq7zG7hYVJy8TjpOX6bNg8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ouFvBnHdgyYG7gDJ3cdSVl2WSfFKy1FUpW1v1U-psvw&oe=69E64B28"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yt8S-QIRGUQ7kNvwEeJRS2&_nc_oc=AdoX0NTSe47AUQ-RC8CwIK8iKLnawPNFJX7hnmXpLbszFZubFZPIcray2yjYh9aLNH8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vISdZSusL4x9Q9mUQxWAvvLbix0EyDbTiauL1XpTRiw&oe=69E61738"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TKQ7EFTEh8Q7kNvwFXJSYV&_nc_oc=Adq4Ld02LoMvXa4aa0m1LrWs_W2pAZwYzu-TsDcdY6JTTvMyKgXfQwEM0obMpDg-Vik&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UT_hSY0c5s7YTOGTiRVbnjdMUHNxJJIxouw9SlZANsA&oe=69E61C99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WfHfV1GlakQ7kNvwECh3qI&_nc_oc=AdpoZPIzZ4JeaVabRrZJqa3JQC00-g0yzo4FYl2epNxpYNEHPcNPWOZrEPi7NXTxK88&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2O_VRR2E85O9gdQc5ZCavjthKGH2wRyaASCexLaafaqA&oe=69E63DF5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXeHNhbogbsQ7kNvwFKlMd8&_nc_oc=AdricZTTW0MoNO713ipoGNjh9rc_eoL3d-6i2yIAPF3_RaYzJcfrRG0H9BPvAEfg114&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8UYffuX9nVamkvfVmmXjsMbbVJPWcncgxSYzH3lol-A&oe=6AD24A64"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJmCKNpP8nkQ7kNvwFcXpPn&_nc_oc=AdpGypiRYTO6a6SVK7IJtJ0Mcr0rbGRGyBE-XcOEECAjzLWLBgjcGIpvg5EaM1zw7uA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgO6Aa-s6cPPz8sw9VZpjEjiAm2zBQgWNUs3vEj4pmkQ&oe=6AD247A8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5Cseks_r3wQ7kNvwHaMIJj&_nc_oc=AdrhQOQ4gWpopRUhz35wciX0LRl88lc701yJZfDvTfKSWHrecneomjC5eYMXtNsk9WU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwC2n22bkr77BLUL1mWZTrp8RFjweZTXAiw3noqWedWA&oe=6AD24BF8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqfS3oSV_9gQ7kNvwG0c7rn&_nc_oc=AdoqWa6L7D2p0zG0P8wc98xkLJJ5mM5HbZsNHE9gRP0U0beP_ws-htw-RtVWlPP0AM0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyYaivqn0UfFRHtXxRnjeOu1Vqg3F8BQ3TDDW9bVj0zw&oe=6AD25159"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEfwvA_-McIQ7kNvwFGVnjX&_nc_oc=AdqXVrlKTWLyUlSTOXVm_jevYNBbuaSqDKs-BDUTXWD6bWKki9vMsaiszqEUs16ByRg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO--npn9AoB0RN3Pe3a4Xbe8UujdaQ9WRWPXr3tJfiXIg&oe=6AD23A75"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
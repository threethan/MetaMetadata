371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zr6wd8ocLGcQ7kNvwHwm5TG&_nc_oc=Adqei76dhxVS6WUW1N29TD-iAPczxbzkts6SzIvtzZ7c009Ls09IguGzuNpqaMuEKHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaFBPrGODCj8YsPMji6QURBBh2H13qPDYcvD6it3ABog&oe=6AE76264"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TR-L5ExG7roQ7kNvwGZvINL&_nc_oc=AdpoxPx0t588kWO7wf50HPv_mrYEC62RojMjZMR2RbFe4r4P_BTs2yk_qBMcTGpfC3c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-M1ngrvtNYCFs_loJACsoO_I1GsfbcHFqt04umeaBMw&oe=6AE75FA8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8dNg_rz6XQQ7kNvwGDv3kV&_nc_oc=Adq1IcD2LI8bfT0S7tdXdiE8CLU9cl5QMnm1_zz89yqo2b5V9JD0-mneEffwNXqedAw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJfualFQqmguiXdHTi6un5OPbYNNx6HiIA2d4bTmIphw&oe=6AE763F8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9KXERzzu58Q7kNvwFeWwrC&_nc_oc=Adr5UAd4ZGXydD_iS-Aud2aUhKvJ4xorZS4iFMR_SO5Ohu_hUnVykeqTkojIuUjgTt4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4QMVLrAP4bPK5U656kWNdyV39qzCZUkAb-bfquANPMg&oe=6AE76959"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1oQfEF2KtJIQ7kNvwHvlREr&_nc_oc=Adpah0EbRI3qwmShbQZ0ALCmyt9ouGZxB5-Z1nAtAIesF1LiliYazaRozgqJ0gryse8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBBMcQRKKs8cgpM-2G6_M05um8NxeKuImd7GaSQxjncQ&oe=6AE75275"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
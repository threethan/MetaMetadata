371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7MasPpY9ZQQ7kNvwFPjCSD&_nc_oc=Adran4hgsC0TGsDPAH3ArvMjJfW_Cu8dumLupNUxznzzrafsiEDdxMnpyFVczP0TBCg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwX8oAw-hGxEFoXPEvFQk_Pc8eNzq4m1ZHtihd0Ooye4w&oe=69C52024"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQ6X2kraUTIQ7kNvwGIIp2j&_nc_oc=AdpGZgeMYnNvB107bxrJjIftaMnWCuwBLNEtFXRHpnekh3U7wMZF3GwmoplJRqlQtPc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwr6jGTkCynF9iOZHe89P7RYpJ6RpztusQkfp745ilZRw&oe=69C51D68"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KaSvAQE6FcQ7kNvwFtw9cX&_nc_oc=AdpuvTMA2ZpBG13ZXBmJsF-YJz5Cg5_7d5KekBiTLzlKAZfa0qMbXShq7JnxbZKz3gk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwyarWcGcSNJG1aEc2MiFOXDMzKC3_vVboZ5Wz2o7XB2A&oe=69C521B8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxswh-6kWJsQ7kNvwFPmiRW&_nc_oc=AdpXUh3R9vquywy2YIkVchk3tMu6ZGMUOaYs-qYFd4Wf3ijODB0gkoDSoOwd6ICf2_M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyOGzME1__mZAS6_PLIM_DAPFZltcefuekeRxD684jeUQ&oe=69C52719"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUYRIeXuGwIQ7kNvwGegRfE&_nc_oc=Adq8b1Ryr0iyEKXpnMdAVL4072o2QuaTTncMYxWbFkXaWr7xN06vh48vzVXnN77x8CA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwfui-pv4xDOCpxWh-W0jyaaQ9Cv9HF4J7bKSN5n6CBhQ&oe=69C54875"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
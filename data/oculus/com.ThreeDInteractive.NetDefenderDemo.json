371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L16tebUBq_4Q7kNvwHdXRlq&_nc_oc=AdrQC115uSs26iDONRECLVZNkODarjRvkTBrl4CXvAnQsTzhtKz7s7b1tDjpexp7erU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3qHWhf74rY_7xB6JNM2SoYZRy5khas6Q5nH6X3Y3DwA&oe=6A2ADBE4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iA37RM0x6EQ7kNvwHboHt3&_nc_oc=AdpS5pcYl0lBJipF9Uwo2e_caktpt7OtM_6mtJyyhMpngOce9kYHNIXAJTzcH_Zl5DI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9plQxddsoI-iil_iuRXWXw2j45uMf_T1xKpIpe98Zflw&oe=6A2AD928"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pX7SDle7PCcQ7kNvwGxvb7m&_nc_oc=AdqBIxI_UCQVWYbN-f0WC2iW54RclSg0_WtWsHl7aKiDyG3uD9GfxIZB4c4miY8665U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84Hs-cMBPrNv0B7FxGtDJF8KODGbAmsopRS159Ag1p9g&oe=6A2ADD78"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4FQXQNBxNsQ7kNvwEDdgxg&_nc_oc=AdrdhKe0mt89wPG5wfRbDFGTYoOFRZJCdJYnr73CcA7a91kw6BgSCy_dCR2UeM_O4xU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QAdkebudzlPJpNleKzJx7L6eHGTyI97G8V-OICZn82g&oe=6A2AE2D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtyIbCc4y9oQ7kNvwHOCp0C&_nc_oc=AdpisSeQZoM-VnH3PwDTc_e1TPc89Y_GtergGsf0M0z6LQPbceAaaeUG5iMluXMVfIU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8w-4wdO8-GmQl3l56vhWCGf-QFBxJHSoNYt07RG01uWg&oe=6A2ACBF5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
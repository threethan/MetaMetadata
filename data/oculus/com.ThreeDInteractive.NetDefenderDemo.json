371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DeywId_hLhoQ7kNvwEMeR32&_nc_oc=Adpq3gBVzsBeUFh6xR0vN8I6G_QsJyOwHSjbyUqunQes5UI1tVWKdNfflt-ECd0vwQ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmvzP_i-HCq8MgJk1VzCxJLFeABlLcMXbwoVVffZXWDQ&oe=6A5F5FA4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Srgy7N8JysAQ7kNvwE-cedm&_nc_oc=AdqPzEkk5EujxVs7oYLbwSaBrHsC7HrugU7Xs7rivvBpSJLErkrJKvpikK4YCgtc0mQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPQ0vdhqXgx6m8nqhLxfXPpUFuFmNcrMS84VMoXK5Pvw&oe=6A5F5CE8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8asFqCBbEAQ7kNvwHc5gb1&_nc_oc=AdoiFpHVu-eomDFNGZO2cnv4mDN2ku7Ta0qkTlzFzw3_gT2tZMj3RwM5vkWogY8yI4U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwt51xpZw6qC76MVLTqVnHrVaEdXnI2clhnT7qSur85A&oe=6A5F6138"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1Qo-RNWtN4Q7kNvwG3BWd2&_nc_oc=Adr0lpD7rVxIR3Rs5KQ3M6zAhVQgw2gLY25q_bDHvSqHjpaA2KtQ-tD9sOs3luBvvnk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzlz2QXTV9KtIwcSUJ39EsQm8gxbpZSwJQqdWh1OjiJw&oe=6A5F6699"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOMmFNohMvgQ7kNvwHXfJxO&_nc_oc=Adpz1HZzl66KS55iPLkx4hF-twU2ixIOIJaio78dqOlCpQfiZ1Suv2rvpE0LaFM57Wo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByxpImHU2DwXbieM_e6E56Negg62KX5j9H9BDJm1WGpA&oe=6A5F87F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
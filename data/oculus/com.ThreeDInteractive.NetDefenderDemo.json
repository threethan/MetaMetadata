371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=192mHSWVTH4Q7kNvwGhBOmQ&_nc_oc=AdomEcjQBcG_Y4OD7UtvIfz2vfG0pKnhjUYTL-v3E6XCSO8TBTjkAQKolCj9uUYw8eo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2R2DX33dp1tAJyyeQZo05IVcu2w5a1_icrD0bQg2DZww&oe=69E4C424"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPuLmrZw0ksQ7kNvwHtrZjY&_nc_oc=Adq6RvceynmBKdiIofwTh1gZjRWADWYmbPfjgN2K-7m7iC72iio1oOSwEApDYTcftqw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WIByNO0E4hN-XZfsgx2TppeFqivJgeBVe9KzUSHXVcw&oe=69E4C168"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imOXzl19_OsQ7kNvwFNH5Sj&_nc_oc=Ado8v519NEWoGK2sN57KLHVXayIf-ZnxJ9N8f7-qmscqH0fBRpslqsgIaE75drKAFtc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XvW_uAKmip5w9K7apRys1LWUsZLNSf_LxrOYo5JCd-A&oe=69E4C5B8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSyKlTwuUf0Q7kNvwGL7fFQ&_nc_oc=AdqLsIo2QBvGPjoEPbXBSXNP6aurZ2WM9zcRH9lPLJ0C_gwNTvZgJRCLtKpiohRZYng&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0anZTAKj8kJlK5WGtfVnFPmweJSqte1bEz1jApmsibOA&oe=69E4CB19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WfHfV1GlakQ7kNvwE1rplj&_nc_oc=AdoRNvOZfS0AU33ToA6DByopmv6M1eQO-Xp5DKKjEZiImbKJalYSFJfzhPDfxTaELOM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ijh6fwF2ngG9vQ5nnypbaYSD4-UxDJw9XJE4vAcHnRw&oe=69E4EC75"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPNvt8WoKcYQ7kNvwGZPQoY&_nc_oc=AdqOlx0GL3AVMbKWmOy11ldRrpM8Aaz227krEwCaS50962-mjLTJ3ASNW6lVXUElDc0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2o1Yriw8_3gRjM5-gvke3XmT4HcpG_9wWHoVtPUYiU7Q&oe=69F49624"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CylL3ZtAHIQQ7kNvwES8f_y&_nc_oc=AdrEdjGFUljU1t6qFVfXglgMKvgxL1EfWfa3FIF-PKNedJFu9TcyBJUp3ITuX81mrPM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ijYZxE4zDFFomMUtcE3J5z-l3rNKyrQdZksY9-0HHtA&oe=69F49368"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDLk-oC0a4sQ7kNvwH58RRo&_nc_oc=AdoFh2DsgnmoMrWMBCClRPrnfGvuaINxFDls5VTD_-a_Z5KJsa7mu1lpD-dr7A2-QNU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2fHX4RfLBLTZ8kmf8s6zLpAjZCRxzWApXIvObcdrDhDg&oe=69F497B8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOkeEkF43YUQ7kNvwEQEW6t&_nc_oc=AdoZt-JLVtl9uIA76cLvEGBGx4mdJblixQrzn7eJITgMizQ0Hw1uGZkBoc-D3KTBjvU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2OOLMbWxBXkcwDssMZd4DOROdT31s-sFS0Q5jROwuvtA&oe=69F49D19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdEzh8c12r0Q7kNvwGBKv8Z&_nc_oc=AdoAzvwhFvhj7uEGwXIDoHVKAj0XARpr8KQZSbSvtuHbw3c7HarSfrrnfda1qVHPhKA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1_fC3siKjh79Twrx-PHd5XpnyPb6QGIz30JmO6jbj6_g&oe=69F4BE75"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
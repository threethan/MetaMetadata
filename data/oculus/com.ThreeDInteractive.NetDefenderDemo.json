371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdazh68NmKcQ7kNvwHB_uiX&_nc_oc=Adp-fK85NFwniHkBHfqvXovc6_ODZhvYx-Ew_a6nREj9naMWjPqJF8-kGiduHOedOIQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMh1Y6I4SyNH-BUn196uFZ6BYp7eL35INgsGsAZgjZyYg&oe=6AE4BF64"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Te1hgXlZDfwQ7kNvwGTB9o5&_nc_oc=AdqXKG3b1b1gG21GCjo0GDSaaeyM-Q3DCLhA6LPcXGpsWMrniHx9pJkBiL2i5PY7fbw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdrBn_aYnz4XrUdZPa06TrTw377O84p0eKQgfixfj8Zw&oe=6AE4BCA8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rA1AyVFuYxcQ7kNvwGmSv7n&_nc_oc=AdpRqHB0OiGXpvVblrL08hdArNX0SJeqTjXyeDfvEFjH2kbIGq0O8a5jSMok_7e8Gpw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTcYTROkyFnzKF-cwzviNb3BEFbbmcMx5GZHYaW1ZnbQ&oe=6AE4C0F8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLqNjOiiZo4Q7kNvwHJdK5R&_nc_oc=AdpXNWa6AhT5fxogvySIY4KsoNI9d34saflVLuAecsln_5XQMQikXFwnKSPQ_7fKbVk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSNyWcqTTtEBsQju5zM50AjB_ULBPhqBLps7j40v0Z1g&oe=6AE48E19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1oQfEF2KtJIQ7kNvwFmw0hU&_nc_oc=AdoN5CLJ7taPMqDZrUUGRZ8gO2Fi5PztgDzOo7fw-X-IZ0UKroK3RfHIdVUVwWxemag&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-uMCefzByJDQ_AW4qsG6WuHr1XCVLlpIWFZEBNLBqkw&oe=6AE4AF75"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
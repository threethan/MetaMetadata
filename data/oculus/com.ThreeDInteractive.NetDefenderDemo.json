371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bE9l--61RMQ7kNvwHK4PNS&_nc_oc=AdqXuDzmI6tmNjOan1uQdKjRhHpQaF-9k2MJph-tZ9z-nrlqBj7XCEeg4U6ePiXFHbo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHA-2cCZnnQdLp8PKMC0m6wlu_pwhhmT2fMohUncFdneA&oe=6A7F03A4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOFej-neWOUQ7kNvwExpGUZ&_nc_oc=AdrerHRmkhnalxOkSJlG5yy78dgcwOV6qyrxxLsnhFPD7gMPz9zn2jVtcFEP6uccnGc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEueo5sLsbrjLIgFJSLJFlCEACqhojrTGyOJe4j1veVkw&oe=6A7F00E8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7NgplcMCvwQ7kNvwEPtb1H&_nc_oc=AdrzdMH-7XvYeurKWj_AVC-bx03uCAcbsqChdm1eegecstwHF6ptTZEw6F-rD3XZjLI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHn62RQ6CT6qQtVhG8rdKj63kerJN6u48pQgSsDflgJaQ&oe=6A7F0538"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mn7YR6mtWEsQ7kNvwHYf6Vx&_nc_oc=AdqFI2TyTsdhR8b6pUmYP2eU0FvesNZ2APBr-axysp6cOsD-iDWCTKnlX7tzvWHiE34&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6hSOWY8H8jX6Lu88D8J2yEkMQD5dzRmf_M6I-eUAxcw&oe=6A7F0A99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YC0LOzpBDxQQ7kNvwHypjL8&_nc_oc=Adq3aDXihL9VefEhyftIiGkYDeFHu9sgEyAZ8aRbpDbvIAhIVuNmK5OnsTWgNvDvOi8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJEKNJ_o-l8lzzS0gbX2Ngygg-qhN8WMbM1I0NzqbABQ&oe=6A7F2BF5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
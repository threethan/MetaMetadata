371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNejqQOwJD8Q7kNvwEH7z4z&_nc_oc=AdqmrQKX5RyN43MVO6UMksjRNAwdEn2Cx9Zvrcka_jJ51P1IYYyb58794ljSnNj77m8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qLsFj4ygEsZLXiLAXfQcYYrumm8yG3nn538BP4J4ZBA&oe=6A147264"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lg3L04secg0Q7kNvwGqwLQl&_nc_oc=AdowRxsdTk1ZapTtMhRCK3mbhrSd6g5waWsBtgMAUCEOYWKyrYK7s29KFrvPEKZW9XI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-oyIjs1fLCvmLn1jwcgD_Cu9SQWPXky1kI2BRMqZK2w&oe=6A146FA8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBmBmO3SdZAQ7kNvwFwoJtd&_nc_oc=Adojr-2JbCytAaaHUN4Ln_dEk2DfEKRBIZ_1E-o2N0AEXk4XmOWH0aaMT-a95UymzoQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GFWX7YPA-Cn3JoYvx2bv6tmNS697XpbhwLJgKXdY_fw&oe=6A1473F8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggEuIAuBEv0Q7kNvwHulfyD&_nc_oc=AdpwpUieiP6609XRI3-h96AgSRNcwzZzpObfIv7T3kmtbRXk6sY0ikWVC_oTU9vcxnY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7X8XUQvmWXq9PUGXq1guxP49zPx5JgRZTY7fInqxXQXg&oe=6A147959"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C06AMRkUlzIQ7kNvwHjQg7P&_nc_oc=AdqmlMPZmAaZa6JYgc4FGrGyKP5CMkyrhjdHakM92wiwfZQp9hVGxMmvEt35O72yktY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jO6v0XQBppNW3m4-UBljGHplP2t1eySxkLt0Td8gxvQ&oe=6A146275"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
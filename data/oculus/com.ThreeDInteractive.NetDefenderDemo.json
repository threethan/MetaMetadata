371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvcLDUQXom4Q7kNvwH6xJ2p&_nc_oc=AdpgA26Ygj4eiN9mxGVOBEayVIDpscHATSXPumEHY0DTWBJ1e5ACD8Pn5jvBQXetJ8k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkXpTK3t4pudZp7gX5mo6XrVYnHPvPB94-SOR4XXgkkA&oe=6AA14AA4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uhsQX0THKcQ7kNvwGlHCed&_nc_oc=AdoxCH2Kg5-L5knEOB1rNCNHnH-CHRZ3-vxXH6c7OJ4C6iqfDZyN5Y2-rGYb4Kgv6U0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbpViUdvwL0AJ0JisrgJXiMTbCKOC-x11P8L4BUF8XWQ&oe=6AA18028"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BS6sEEYKwNQQ7kNvwHrGadz&_nc_oc=AdpJJ4aw-5KtMoZ0zqxUXluZU9K6TE2O9xWz2q-l61EPSYOjuK8hZ4M_Bacu9DN3710&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsjEx-pA1C32C3TQ-Z414sXJWjwE1stTMpYcXzpWknbw&oe=6AA14C38"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YFiKeWcqZwQ7kNvwG5_imu&_nc_oc=AdqHwBoN97jktwsr1XBM0BndSq4vfcS-3QK67ISWCuNTKhbpEBoAkCBmKLcaJcmWzqQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1OwGNRquJSmo1kwcdCQPzqFwzo6RaBFzSJ6XFuG7LEg&oe=6AA15199"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FI_DPT_a-EQ7kNvwFK0Pcd&_nc_oc=AdosgWZ7zN6oxn1_8Kt8mGgfjixr4nAqS9yqy3koaWlZVQ4HKvaSCERakldYLLdd8q0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaqjtl3Uy3UUwefeXR6dSWD63_Q6IYg6O0qIDeANZKjw&oe=6AA172F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
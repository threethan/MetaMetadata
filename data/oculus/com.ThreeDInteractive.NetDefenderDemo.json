EgrN85Q-swm9n6J5oOolY6X-lcSI8seLmg5g5WHoH1OoZo0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsmgQQeckw1JwHg-U7JB-3nfW8gmTOig_CDMcyz72mUww&oe=699AF024"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DA_CweyHK0wQ7kNvwFfiRFg&_nc_oc=AdnYZBQ8I7CrMsAzL3Bcui1LK8huM1wapb_MRUuZT4RSB30Sf27XFUg1fkB-GeTEErc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuhobCfaaRgbSMawoVcWjqX6vK3FBQ_U_NXLAxE8LgRPQ&oe=699AED68"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WnZT_m542gQ7kNvwHJeoSE&_nc_oc=Adn8jQlXcAsvT_UAVX4H7ADlOZlbOAM1SQSIPeIrOKczhxA1tRxpqqkbgluS_8HNzco&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsQfZWkdHiGOaaMmWKwx7G-7gw2cBCc2Fq503lJ59hqiA&oe=699AF1B8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zc7bsr6_ip0Q7kNvwE1O8fZ&_nc_oc=Adkpsve6OdvR7n6ITMNduX5rR-LOWFr72iGe7vap_4mnN1giqld1NTxKm-U6D9ykbPs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsXG7PvEOPFqmj4XR25bP8LHHzXIYwSkMUYv5uIam9JoA&oe=699AF719"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XS73zrNFUDwQ7kNvwGPS_8i&_nc_oc=AdliZlb_ylk5zBYe25iqB9GWkJyP7GZ5fSkd1p541Rf8LQOuyOCIOsMsIzjaEDcLulg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvUCwLUuuJvBRUHbhie0T5rHc2pnkwwtWnKBLzu6kTAaQ&oe=699AE035"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "550679720579565"}, "review_messages": []}]}, "cover_square_image": {"uri": "htt
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2h7Os8FnyoQ7kNvwH1jSDt&_nc_oc=AdrWLZHs6sQoT2PvzEne3DBUdML99JJ5bvVabCDvfFrk3_XwEG7xVU9OudviYouuIRc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRvU8czeYyJYOCyoj9rygfMiOI3U_oUWYjJK9iwvOlWA&oe=6AC90FE4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGqny-fsMWIQ7kNvwG0-zdV&_nc_oc=Adq2aJTtcX-_ghMTg8lNc8VigdMQmWP38-K02HYvUKXyy2HG8MtfIh2VIg3FNAGGSec&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaF8FgAas0C_4NiJ3Bv1VT9TvEmqgL-deRxqFDR2HZUw&oe=6AC90D28"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzXln2s_LoQQ7kNvwERohtl&_nc_oc=Adpyqe0953jxmTmDdE_-s-xHN0WVOJbHdSqN9aUmtrDmjXtR9FL1xnBIEP5rKXZDoRA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0U3rDowI8T4s_5WICnAqg9PnfVenk4FA0NAq4Xy39sg&oe=6AC91178"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqRp2Lk1eE4Q7kNvwHMULC8&_nc_oc=Adr_V9LdpP1eQc8nebFbPzq4hfieM8scNFrSwDxfynQYwg5xcJzAWWfe9XDsr-ZwLq0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhnU7-nHnBO_FC3-08q0cVf3H8gmoh2nkk49Y_O0HFtQ&oe=6AC916D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltPdBL3ic4IQ7kNvwGAo4sj&_nc_oc=AdoUWkYZiD_EBcTvQUec6JFdCBTrxJU0zJ5J8NlMnyirrLVwINlKzGIISJeOODJs1OQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN67_BE_g_B2X_eGw-iT79Uh3jal4jYuO6FQyol40fGQg&oe=6AC8FFF5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
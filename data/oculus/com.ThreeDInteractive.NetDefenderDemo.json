371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GY84G65-6kQ7kNvwHO76oZ&_nc_oc=Adr9phWEDR2up2_mzsTROOJggIta2iFnT0x4XFSzNvICSTjFq-mXTngUn0mkUaTh3Gs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NEetpBwp5bBWfKdn-QvlqJ7s2dlNkqnCPGcby3r069g&oe=6A0AFFA4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzVad6fD1EAQ7kNvwFKHbBF&_nc_oc=AdoARrLWJftPXSb4z6VjJ6aL6zxaSaogSKMYK8uXV0vlXx5TCPt7mNbxOZGkobMGdtU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7x648Tovc56DIvOawM0s9XVS8G1_H4g3gf9KHOMUdeXQ&oe=6A0B3528"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugj5WvwLfVMQ7kNvwEOgaIK&_nc_oc=AdrM5ps7sbACHNKPsAIjF-ARw37nuCOfSKV4TCD4mxp7_2hB2SU9zwjskmb6fgV92n4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RTsZxJKbH1KKURRo7sg2va5YIByjHt7nh-HG09tuYkQ&oe=6A0B0138"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CpWGhBG_qv4Q7kNvwHS6PPf&_nc_oc=AdoP-ewRyCYrxzowEfdhiXM5XVU5GvGNoSKi-9rCv2ZugGPTiAq8vYOuYUt45hikImc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70o94WZki9ryLDraBIFpvRktrwkHsdeHA39JkW7jRcpA&oe=6A0B0699"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wK4S6cS6B3cQ7kNvwGpQsSD&_nc_oc=AdqDoNZ5y2TwP9cQuC0_JjCpv3SE5ycj2PcEECf7emu7yD6qPOMb9mDX6D2xNDATAYY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZKvZagqPyblTUiqGnKZ0HPFpeYUzUwEVNjNX5eoIKlg&oe=6A0B27F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
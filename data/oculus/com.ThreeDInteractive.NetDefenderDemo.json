371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-rQS7TYrQsQ7kNvwGMdwEF&_nc_oc=Adqh-r6vdfqab_byR3t9Ydzvp-DXbbXOn7jBnKDAWLzdQ4pwaNN9dfKn9mqiDhV4AM0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DVh7I-tm-A7niacYgL3PlnJMWDKLm7MW675W8HGL6Fw&oe=69E76724"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-pjih-NhzoQ7kNvwGu-J5z&_nc_oc=AdqaVW8N4BadZRDiiVR01FVX2fEHhyf-2bmAiqfhJvy3wFOo_Lr7b5UcEfTiAGdcq2Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SboxwLkZaCiWG0IRzXAPQ-2HSegMLITTflaJPErr7Tw&oe=69E76468"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yt8S-QIRGUQ7kNvwHkf0YK&_nc_oc=Adp816NCFVyVj3oYW7HPclQv5PEI9CsRNd7Z7-9-uGyhDurBa4IGVZ8RgztfkbxE3R4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27k1Nry6EJ3Mr2cGI3zHDN9olwUJw6lqW_jpiKw6jVew&oe=69E768B8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TKQ7EFTEh8Q7kNvwEkGBYK&_nc_oc=AdqOtnp4zh4DeefNvLiIcDRn4i-mfYyE4pKdOfXzJg-9shkfSmwlfA0qzCRrCWxk6yc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tGfUgP0rZeP18dzEQoe6y4352BPGLBlnnbMMRAymNYg&oe=69E76E19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cqqk_xqWISUQ7kNvwFZWRiA&_nc_oc=Adq3ulOGKfPvbgl8JH5cUFj2JnUjVhqplsR1SivMnSkP2ORv0h9yljkH6_MP_IAs2qo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3AHzMQ1nyfIFTOyOvkXyDq-oVYZI80LWEzDB_gB-GnWw&oe=69E78F75"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
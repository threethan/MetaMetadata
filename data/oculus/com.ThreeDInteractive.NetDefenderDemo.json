371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLxcKu1aWTQQ7kNvwEKgajg&_nc_oc=Adp3sS6d8wDNZEMcY7rhKKpvzrKvQgLYS6DKWy9bMoZJ-FujmCvLAxsZMdm3cEH6tTQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgK5Cz_A_rmvUzumIvellVddX1DlqeBRJY2XdSx_YYig&oe=6A6F31A4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cndkzf0qBKEQ7kNvwFn9XeR&_nc_oc=AdrWBrUpbZ4y-kfOoOV4l-4MJbevf39mPWvT_58cPE79vRq0KtiehvYPOO_GY3N5s-s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfU1gRHDCTEUYwL92lnF4Q-20h4RfcjD3hnTfHVy1u6Q&oe=6A6F2EE8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58JumYx7R7IQ7kNvwFQo_3g&_nc_oc=AdpEX8ykqnAp8Y7hFYvZGZ21fBIEhTycUX0Fn7qbwHrN-r9HcKEdaKvdgOd7S_pNzx0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiXyn8pWZJoEK2XREUPLWckdOQtR89E4um2Ix18xJXww&oe=6A6F3338"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZgfwbNphAgQ7kNvwG4mBwW&_nc_oc=AdpfGbPR9NLMDtXsS-z6IFVcHQ3z3W9Oxx4QpDRMZQ8o7HzDX8MoeeSmlxrO23RYnqY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARhdhXCKMsGlgNV9nCsdsBjMbOEoJlAYL7AV4bQkXFcg&oe=6A6F3899"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVTElt4iYcIQ7kNvwENdExl&_nc_oc=Adrrn5LNdyIdg7cAWwXCDiu86gvYw1MpxcBPatkoYgtf7KDLuoi3tO6N-BgprLkUMbA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfWC9TShsU8LqBgUNJU8AxXDV7-6D708f2KFD8_E9fNQ&oe=6A6F59F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
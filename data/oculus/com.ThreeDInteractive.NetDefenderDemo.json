371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iydZHQMlk_0Q7kNvwFtybJh&_nc_oc=AdrCO89Sdl_c7dOqlZZ6rXp7P610VssZebj2tOa6BZdjtKYtHACX_7t5BOoHJkK_mxM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlvf9PecVrP2ybdHDGFOzZziyn41XJfh1CyEuLa9klYg&oe=6AA81A64"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Zgx4bSnjbcQ7kNvwHFIPKG&_nc_oc=Adp14tPWLzttZWe1afCy3SRU8CxixZzQjZo-4zklVnSTtjcorXeEE0mLwnu0VePF_t4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQRrvUC5cqC_D3bNe2pvPrvSgdsfTBAv9Tc9f7zn8UIA&oe=6AA817A8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmdJK2g_7-UQ7kNvwE4sd7p&_nc_oc=AdpP3RaKomMPWMBBZxsmIUcU9YDPcQ8b8bsfXz5kIHV2nenYYpuMwcS7q-bk4RUuWSE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWyQm7QTb15Tm9gK1MKbzLU_g2yMpseQdwzZJOqQT4mw&oe=6AA7E3B8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOIwWBacmx8Q7kNvwEu1y4g&_nc_oc=AdrXQ8Q290XSr2v3wUnmUKfbbWQCidpeRhFa-ggS1ubuRY0_1pvvGEZ0qpA4-Fh9Dpw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8KdlPvSD2ZX6KmazRrwtIESJu5G6RbxWPsL1sWWljXA&oe=6AA7E919"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5lcw92RgsAQ7kNvwHND-6v&_nc_oc=Adq4HVY2BysrYNv6R2_F45atQ6PNPobybfsmZhXUm-m9hqGQE4tpGcCCvx7dBWpUZ2E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrM0vVwjdr7k6jYndGVE7PG4cD-BEpndxTdF3wKpGY4A&oe=6AA80A75"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
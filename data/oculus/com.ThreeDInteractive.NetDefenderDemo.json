371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBuRf23saDIQ7kNvwGWzCnz&_nc_oc=AdrHowJ3w4E6ANhZeCjfBL14ZS2MYLktu_UIvqdyoHbQ8zhG8iGnSiJw2wis8Kko8vk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6LbKwXhgmqeF7sgLIKG-CZy7V4jnxJ3gRDRZZEGnvRA&oe=6AE0CAE4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFf-iwFaY9QQ7kNvwH4iXKs&_nc_oc=Adr4E1qqzC8-NTMr-0vORPHZ1v7kfwC52ufrfF3CGoeaV8tJzYprXLRiR-zXtmripME&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfOS91xwVlmd2cEHSa85un592yC4IbEUclYSg_5igURg&oe=6AE0C828"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lwaYppYOZAQ7kNvwHFWbEe&_nc_oc=AdpSaesrXo0O6obCEQ7ft-ED8A_VDZ-n-z2sNhBosFT4dT6FzlrAPhrCv8ebDvrlgrQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN86blI6YbmvFh2tBiJTjed8EF3tetEBqGrKzwqcQ743g&oe=6AE09438"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwGKy_hs1yEQ7kNvwEGR_i-&_nc_oc=AdraURuogmuCv9BZT48ac2DSkhXlVf9pGTPl-vsd6dYrdptFk7-Ji7lhXRDJ_nEhV8c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzBSEEVqaEJx4SmJmihSKaLmjZvwbjkUA5LXNtB-t84g&oe=6AE09999"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nHaUS62vX4Q7kNvwGLjQQE&_nc_oc=Adq2BDhN7EpMhf3q4BDugHY8QhvOpFPjTvv4s94gSv73drZV7awYeEhQpVLvpmCN7pU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN175qSe1YHHRZewFrWF3-n4FJjPivaLxRCUavM7ls-AQ&oe=6AE0BAF5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
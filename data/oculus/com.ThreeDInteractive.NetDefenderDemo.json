371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqXIbgVIeh0Q7kNvwGVqh9B&_nc_oc=Adq5Fn-07EHvtNaepKOrf_ujlG849Ajex13C1S1Z9gFbXtDcgn_23EYn4MJ_BgFvGmo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HNmGcD8wvOzPbO2SarMXGUTq_q38DwnZxQ5nZ3_cz5g&oe=6A1866E4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvZQZQHakW8Q7kNvwG2IrLP&_nc_oc=AdqKDROZe1P5rf8n68X6o2pH-BRiqcljPr_OEMVobCtn94tNplwIUPXoCnrPFfHc-O4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LwDByQ8w9jLATQF4bykv85HjY7wNsAGz2eHbadNRbjQ&oe=6A186428"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhpXiXa9DVUQ7kNvwGFI_s2&_nc_oc=AdpabtGx0RFYGW3zBBmiYPJwxdqeXTqbEEeH05ryIwI9ScYyO6Q4u4RQdVco3HUCIQE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57J0dnsQudQX7kk48L_5vHNWbnYTl7w1t2FQjQNlsN3A&oe=6A183038"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aydLZmljX8sQ7kNvwGWTPFX&_nc_oc=AdpP7iaui6xiikonUxHK_UmdWmni0GjeXl7lSfNfDkqzi6LfE1ZKo0Sj1xr7EJRyhc8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RVysybBZ9DE6coDTJfxyyEwrWlHDHoDYgMHpz-M_m1Q&oe=6A183599"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TY-eh3u94k0Q7kNvwEGN5Md&_nc_oc=AdrYD-gpy-HZ_kqQX7lTlRPvExSkhFAgw7YUkVnvS6EoV4YdBdW5GDUvB92RRsii6ns&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44H7umRY0MphDurXoy2XMuAmEJFgGoe1aa-z-PrdLg0w&oe=6A1856F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
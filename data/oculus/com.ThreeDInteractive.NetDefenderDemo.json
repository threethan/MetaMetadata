371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXTaeYQatvYQ7kNvwEh4Buj&_nc_oc=Adpnchj6ZttIv3aUlfcm3oVz3pRpA8Xgwpzh6Kdej1E01_mskdvIfhr7iwr83fbclXo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83rII-goFxcAKmKZicRRMNlGTcsxPQsTvIBeoxqqk0EA&oe=6A3D50E4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTDMGNJF_nsQ7kNvwFptCbs&_nc_oc=AdqLkwTyPWXXZPuOSBztc1CLcQNZxJQysLVmt3bod-oDz8QoFxIu4W7iflWufrr4JE0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dYh4EfyCKKU4OAfwJzq8cpTbZLGe95LlwNaD8KpUDSA&oe=6A3D4E28"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXVEEZbbcecQ7kNvwFpsKay&_nc_oc=AdrJu1ekPdwWOytnTg1h3k5P0cyg-u8zYq6qX2Clbx9kRsnKXpqwyHjmi5rPOgzAL-c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SZYZQEUkzyuafDiTSMWJyHXSowodf8dauTo8e3RvbbA&oe=6A3D5278"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nHcyVDpATIQ7kNvwF-6Qnm&_nc_oc=Adq6VytGIg4z0VVS0l36zdU9yq_FSA3LITArXSjZlcNLMl1q7016_CA9xNZ1V6fltlI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cxJACBTPPF5SYpv8EC88krnWiNTzCE9drWVQxMoKJOA&oe=6A3D57D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuxWuhqEkxIQ7kNvwE25qii&_nc_oc=Adra3UmfboayREHnjZj0UP0w6K8XLD386JMhlnkBfDo-U4Hw2aVHtltrEnIodg5a5pY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cX7-isg0zF3pbDpPxu5LFal1Xzto4Jto4Zr899YWCtg&oe=6A3D40F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
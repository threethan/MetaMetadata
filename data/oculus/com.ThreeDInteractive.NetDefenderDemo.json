371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jG6qHpJBJw4Q7kNvwEg9nnX&_nc_oc=AdpVjYgv96I5-ak7GVdkPwSWWjrNbnI941S456uuVQcAKtA4Hty9h-7cpc_pAOWfmq8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQBYzmfFklSFDGODkPaayzOcuK1SUpCyFXvFxM8ZkTDg&oe=6A635424"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hs3ANaWNbl4Q7kNvwGa1JHt&_nc_oc=AdqyAvC2pxNxUi6hQl_74qX9jxhV3wCPsEL5wsUyKQ-843xJpP2Pad0xHoei24x5zQo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCW-SM-eo187ubetsl4nBRoAHNVcjTQXC7X9nPpXHQ_5g&oe=6A635168"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMUNSQrobNEQ7kNvwFv5Y7q&_nc_oc=Ado6SLv2gUbm3Lq5ooLXPcSiJsu_R8YtbUolmDDscFr9DRZpMs7QM7q30gVjFr8333g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBj5QLlbaMEUH6ogvxxgeMAT2ZFjEnIoek7LifW4pVSyQ&oe=6A6355B8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roZCunmHICMQ7kNvwEoX83Z&_nc_oc=AdoTaVY53Gn5ghtbUWeRPsYw8TSc2CCpotaK1K59hFGa5cPgZvCWVnU-5QJ912XtYkU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAn9MTJS1NklX0U9fZxkgx0D7ISmFSBXTJ9UYbQSiaMdA&oe=6A635B19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_Z6fWUSseEQ7kNvwE8EGwp&_nc_oc=AdrZbgwQZMyDJEQXoADesl9l754xBT8ntoVj2UBRtBHaNQtYLfPgmP5RPybO-UdWxE0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwjS79cL2VblGLsw9UjIbxEAhLCJvWnsK1QitD5d-pLw&oe=6A637C75"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_pox7XI3HYQ7kNvwEMQAEd&_nc_oc=AdqKQseuYcb1o1I3Gg_L-KEnP3aYsxeJMQVJ35Atb_dazYlTpI-9OgOh_LTXjOdR80M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DheECMF2jgDSCxDUaaadN8h7q1Iy5ww5rOT7DCR6WJw&oe=6A3AADE4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xeiYKSxNYsQ7kNvwG9DNWp&_nc_oc=AdoBuU9ZIiAPodu84Hf3yETnSOpsg7_nQW2pmhK1ixYMngQSlgoH_vsdca0c84jz48o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vwYC2eC5fYaMhii7XjoJ1R3yKCNmNgoCuJFNrQ3ae3w&oe=6A3AAB28"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkGUhQ-LXAIQ7kNvwFfwnLs&_nc_oc=Adq0syz6MyEyoyecxjVC-FAwK0EeCvBYi6_j3CclC9U92khGVEM-_-wrxdrBfiyMLBE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Lx7cID4MwydCV8G8VjkI7CyeNA8-ILwEYAzwRQm6kIg&oe=6A3AAF78"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kcdiHZznnoQ7kNvwHtFTBQ&_nc_oc=AdoxAV8LW3kokefov0nYjCYbT84XLyrrMn7OSMuY6TeQUYElevRnSddUIIgFLfjE9Wo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WdaDwMtErvflADOFomTGFEAqN72NjsPGYuGZHwT1KRg&oe=6A3AB4D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuxWuhqEkxIQ7kNvwE1qWd9&_nc_oc=AdqIab-aEb8mBix8eJW_PBWl1v9nlsDSZJ3UA0lj8mf9_3t9IRjD8BuLhhN6zMVz0kc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_X2hWxBw0P-PBWiLDE_BD7T40TvhJYH9uCFga9FRTKSA&oe=6A3A9DF5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
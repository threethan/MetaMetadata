371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdyeo-0_7owQ7kNvwGioxRV&_nc_oc=AdqywOBkMRx9jxlk6Y5HGkTFy8ZCuuxcRPGZa7_IXstbj0OhC9Ia30iYD8fYy-j0mYs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTH8SS2ZdcE0U2CCd_jzQ6RUUKzsIJhcpClmoxcO-3pBQ&oe=6AEDF9E4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3Yf-lxIY5YQ7kNvwGKkwcT&_nc_oc=Ado2G2mkzu6iSl8yByEb6vkgMi-KDJdjB6T99ePuo9b-YLTSjQmzrG7YtDqNNi7dHnE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7KerFYt4_tklVy5opHcuWhWHMrWQ9AuHdnlVrl0EGsQ&oe=6AEDF728"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LRlb-n0dLQQ7kNvwHlLpT_&_nc_oc=Adqcdwt5AVHEnaRl18BaZ3hDlNiplC8jzMli1_0L11zsUVSg0LtpRdJrMtmDXHxKRog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBvw2evZdY4_Yq1NChseCCd02aoBLs6Q9R7S1zw7QS2A&oe=6AEDFB78"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=um_IPQTeGXoQ7kNvwGEBIKp&_nc_oc=AdrBUSnXlRejRv_NPsAV2BEZo4jObP6lcIgAzesO9RCcXif1_i36m443xqQlkugXpmk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe0ePdQDCM0NmQiqR__O6AcNM78yvC_qIxjad-BbIKuw&oe=6AEE00D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cd7fusR7L8Q7kNvwGGYCtd&_nc_oc=AdptR1Ax0b9Wdj6cRy4AZFYU0UBkbe7l-2DoJNtZJUI6oTTUpmD-feBPwMENqwbe_MY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbh73DaOFq-csMz4ZwyREiyAqUfEPYSJtD4Hg3205jEA&oe=6AEDE9F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtFbV0FUxbQQ7kNvwEidEfJ&_nc_oc=AdpK6E7S_AsDy4W_hOjESSZkMx2qOa7oAI5anpXgVOpg8zHmNIWUD3HXiiF5zNOZt1s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kF36fQExPb2frQ8eSrd7Jhd4U-MMg6L0RsfYueak0dg&oe=6A380AE4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrzRDAuWZNcQ7kNvwH0-Y2e&_nc_oc=AdqVFLnxC58v-suX7QyrJ8sB9BFF6SEKS4i7LjLPi70wJSSsA2ZcIqoQMQtexUzrp_M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cJE84o2FUjy4_qQ4miEc-EcKDBR2f009AO3kYMvZNPg&oe=6A380828"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPc_Q--wsNYQ7kNvwF_OnGw&_nc_oc=Adqnf5brA-aqwMvzP36Xc1L9dA2NVYI9gQS1KghHikmXcsss9n5j3Wd7VOP1-511i2I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SEhuLIlaFoUOJ9n0pAz7C7mIz_rAx5cPsaJQxjwBNbA&oe=6A380C78"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCtK2G6PJUsQ7kNvwHwgn5S&_nc_oc=Adrnh3akll7UiECQygLDY5h27A7yBLCmX2E1EQNtxpbxGTBTn28rRcbw0_WcbTdQ5oE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ze81_KGP5Sqk_IZE9MbFPSkwuJpxq_niUdpvW6bFodw&oe=6A3811D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3B7SFr5PI-8Q7kNvwEIgRk_&_nc_oc=AdpWSi7zUfVs5omptwS30WS6Nue6roDAqJOShXuAbXIB4Qln8-bCAvyTJIwpZQOAqUk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VdjYbzt10LCET7fdKxMMrwvJVPZ0peXmYCruEtgjd_A&oe=6A37FAF5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
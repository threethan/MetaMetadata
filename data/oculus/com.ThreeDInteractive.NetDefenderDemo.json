371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgCP-clYdbAQ7kNvwHF202a&_nc_oc=AdrVertrRfEk9h4yVwuSJvkA0Ziwd31mjXjVkJM2d3HNp-0LFqPccrP8sSAHBhiFVag&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHR4DWIEQ6ADFb0N4tcCias4R9GMckaq9OFEn6PMZtow&oe=6A9999E4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBPC7Dwr8F4Q7kNvwGlUOzn&_nc_oc=AdqG9D1rmsYnu8x1u2Br7fqghE-c624_0V7081XCI8piCfZhFvsb-0q9WblLdh5eCcg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTSDLlhhMeHVW579HzzyzULmqpaY91kvk4BpH-XhjeJQ&oe=6A999728"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7VuDSyEjMoQ7kNvwFjGWrH&_nc_oc=AdqrY71OCsPjEnGpvJMH-dXIruMPvoCM1aM1PfBi2MBuaa5S1PuHEYTBZ2oZpnNCGk4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSnJmuITrH6T8v0VUthliJiJzGASiR-geAZX5IerwtOA&oe=6A999B78"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l42JApVKISUQ7kNvwGEyqkz&_nc_oc=Adr7wY2naSV74bd8hO2q2vs8Q1dkSn0cB8Zy4q3CrI7hG_vriCeOc_nnwLxPN4pVvKg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSwqjn-1bl7X-2OUgxDqy9_J0kkwi_G_TdfUbwaXKM8A&oe=6A99A0D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsHB22P7yh4Q7kNvwET6zRd&_nc_oc=Adq8JxO8Xk1s0ZHUtgM2Hrz-rzLmEepHfX6V4olscAxKMspMGUaFTozi7MZh3LgKU1g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2MTarkfNHVgRLk8hSwoJN-dPzlwOaHOtkMMnCrcZdlA&oe=6A9989F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
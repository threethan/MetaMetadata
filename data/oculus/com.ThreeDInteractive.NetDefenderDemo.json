371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yGx3EpdGU8Q7kNvwGx9yzk&_nc_oc=AdpP0sK8NoNQWtWpbAzrokwWQqjDlwSFc_m1pHkhlk42ONJzM9M1zL2RGwSszqtHges&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UlGu0VNQAhSlGFs2mbsC1hFwRuBLrV9TE4PYncYQuMg&oe=69D24F24"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xm320pCVrGEQ7kNvwFs3XqM&_nc_oc=AdqcdjGO_F83XR6UGh_JJj-fijq2Nfoi045EfA6rubiWJd1d11nEq46GiSnz-7weYFQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04FAkBBK2twL-FzOkvR3H-_go7xsk0_uT6jCXEV0xtgA&oe=69D24C68"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Br8of_57B10Q7kNvwHGJ_b4&_nc_oc=Ado11edTgjG4HajnQoNLEtH5AIKVZnDoARxWfPFH5qE8eoA3KXj473p7MWAlr9D8m2A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12nBFWmlzcL_EgTm4XMBkOgKeokndyRcxkYsK1QCytcA&oe=69D250B8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jg8-ELsDrcQ7kNvwERfKcQ&_nc_oc=AdqNDXee4E-s16JBbNwWhm6__fQ1f0OuEYuvh29ZjwG0pTcR0qRSE2XGQRqKkQy62P8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wzRojBH3TjzL_c4ypwbDWXMBIsZNxGjMkoYeHw15WbA&oe=69D25619"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68I7KBHlVv0Q7kNvwHSk5Ed&_nc_oc=AdrYs6GetBIqS18z0a8sASqGv-weTWNg93JMCzixZMpDe-1lPCgGTTQBxnvK25XYQlM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mRk7O7cYyYxweBI1lAWUlRx8TTvGAP4bIX6cwLWadrQ&oe=69D27775"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMhlmEF9O7AQ7kNvwFobQG-&_nc_oc=Adpw2HCQgu4emoAn_7-h8mWMHWeKeVPO5oAoQSTO9Bg242lSnYN7ZwKByCIIGyZqf_I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mEwgCtf2eqwazU1irngPdj2VvW6exao2h6c0aiEycXQ&oe=6A21A164"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGTkamXMSM8Q7kNvwFCSloZ&_nc_oc=AdpFOzYOQ-ueja27_dWxbsCspeGzrrZ4CxTSfDI4jrNqrmbLzTPFjPZAu9LNLoC5Uog&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-31ATR8xofA2-bUhmJXEEkE-K8mcJFdoT5wHH6UAj02g&oe=6A219EA8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eH6uCssWV4Q7kNvwF3AQaN&_nc_oc=AdrEYh2InWm25GO27djsdlXBdL4Gii4AoxaI7o-bkZDzRY96OaI_3EhlIALUc_ZAY7o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OxTgauxfSZyc__SSoqzMI4jSwl3EFN8VPYNDHlHwR6A&oe=6A21A2F8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1H6r5ZGrCAQ7kNvwGWUBeN&_nc_oc=Adp2hgD3Gu0vzWmK5--lIIKz9_7PqcwKu_uvpj7_fsDrXUYhRpHE-XPxFxX0PmPjYgs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZWMZWzKO4eIYwFOHB2x3sTFDuHlhzWxitcguXAkBHsQ&oe=6A217019"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oiv0XSlZnWMQ7kNvwGqK2yV&_nc_oc=AdpO1Z95lw68Pj0sicP7e90JXpJQUWad9d9Hla8JKaXL15DoiVrqPIsCA8pjYXYX5Kc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cAZS7yCg3P_HhAnxvkDIsUaH4CwpqUElcmdbZcI_W9Q&oe=6A219175"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
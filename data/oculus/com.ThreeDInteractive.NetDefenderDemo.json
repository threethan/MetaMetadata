371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_-VWQOS0qoQ7kNvwEppR-M&_nc_oc=AdrNcykGenbORLf76XSsDpkIEJgtJTF8MEPXTxRmLvYfrPUPzLvWLz06DPijk44qroM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG9xHLsloapuMQWH7jrLJMctLQBbVCHlGh5_DyxzdObg&oe=6AF49164"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_9rwDDVm1UQ7kNvwHozqBB&_nc_oc=AdoCNA47asJKSY0FdWjvaQVG25XB7z2xyEwWg25_neKzB-1aN1p3u_DPFdKtBTyEulM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTypVaGs8aL4EbiGvdEdHW-UKMENfgDYMUODrtSDfx9Ag&oe=6AF48EA8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tR2FVFILDDYQ7kNvwEznhlc&_nc_oc=Adqx-YOg6rhN_LrShe0s4vbT6dteCAt-GC4JqVtLq3J2_DMRys5iZSM4holT2BrNE_Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRr4Peoqh37bk2By-hRuX5Ca57tHJDQDwQmxAUucvX38g&oe=6AF492F8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6iNni-8a5YQ7kNvwGaVpGY&_nc_oc=AdpkmDsxeNDQ-QQNL2XPeKXdozTEg0PXlfRiikxqxgUTil8HsbiLmEZXvS2AOg6qotQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtxBJqkGnILZ9G0qjlotNmGA36Xy7713Y3msqhZKW5gw&oe=6AF49859"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYHrI4h1kQMQ7kNvwGmi8si&_nc_oc=AdqSMdd63nGMSv-QcoQ2SeJ6MmrMMPZUF-iXpM1rtkqLA22cAG0kDe7Bk3jP0sVvx1Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtr7pijklofgmSSfqY6P4coA0uQIRlm_kTksHj-rhjig&oe=6AF48175"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
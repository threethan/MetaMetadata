371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97X94yJd_4AQ7kNvwGlWEZS&_nc_oc=AdoHd-B3xdJy3pHk9kv2eYwr1WF_aDdjjVxOJb7E-t--PL834TUwalN2KzmXxGSs0Ew&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAGZ2Kf6RB5XnNUE0icdb2Pxh4k1oH25hEqKd1N1v3ZQ&oe=6A6B3D24"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHGi0YXwuskQ7kNvwE8y7uI&_nc_oc=Adr-xO-TC-a5zHHkx3gOimj6hjFRdJ3ETHFPMzMPbVxeINX0r-B9Tl-gBP1jkcUDHrM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZ32Gg5rP8036XHDidkk1YaGOvqjEsBQYDH0QrouwADA&oe=6A6B3A68"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1q6I1V7QCsQ7kNvwFrsDaR&_nc_oc=AdqBGPVom7OMPxqWP66v0yj42n_wQ5k77L6lm6uOYOWEpsDpG3YhbIypbC5MGg5mRTs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkNgqM0lxQlrtwJ-Fkijquh-p1fCYk_aFWHmzjsz8huQ&oe=6A6B3EB8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2pvkSnZxD4Q7kNvwFq4Iib&_nc_oc=AdrZAXNiuGNsH4nDM01VH-9IGqsL4ZTnkM57TFNCExOUFWH3-c0Yk-9kWdRCmrTgEsI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCS7U9VRefbes45Z128R8xy71cDzGNhZ22ciUz0YuJN-w&oe=6A6B4419"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrcSgPKTojYQ7kNvwF1Z6Dn&_nc_oc=Adp-eCE-eg2r8CuJZivn-HZom_Uu_BLsBit2o4F1CWFr1gaFhlb4yq9v8HthOS0Lzvs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChvWk98LBNLBZCvStLSa9R-sO_AAjNl9076AVBYXEAmQ&oe=6A6B6575"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
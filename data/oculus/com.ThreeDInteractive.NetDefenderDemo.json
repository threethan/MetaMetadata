371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbAh1E45VGoQ7kNvwGfvyo4&_nc_oc=AdpubfuAKZjbh-YYBEizJDWEn6YjC2VRcUW8zaoj95kbTlMV8MD4o8QE5YnR9P-SJFI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYpklRvl20_iE61cHPIKis5E6chCpzhV34ZV6s8PAd5A&oe=69C671A4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DspmXK0w7YoQ7kNvwEaEXQc&_nc_oc=AdpDmQ9ooaQcOadpGczRf1vDRt2rwZP-JY8pNXV_MmbHpoo3U9z8NUVQFdocvcJSZMA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzcIf1nNZklfC81vU0syATFkK9ikZvGpuOtGLqDZE4sgg&oe=69C66EE8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAvGNtiBCMIQ7kNvwGrAfUB&_nc_oc=AdrRLv9FlcsHFQU5zPCf9Jc-w1jtSYzq8YC0Xh7TOqNLdl_YKwFRSuqbBC8Plwqp6dU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGHJlOBnu20z3kFnqATdAfzb9oB3_f2NJtrNUSPF4EUg&oe=69C67338"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSsGR6baBqAQ7kNvwF3MJJJ&_nc_oc=Adrc_SOmnE7scor_U9ngxMzoud_IXl0P0NNHY41pz_7XFq2Vq7n0FT8nAO1IybR4Gws&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZdj6Y_ZLDZ5w9VQVhE5u0LH9KkeI_vNnCd6RQQfUSmw&oe=69C67899"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUYRIeXuGwIQ7kNvwHCA9M5&_nc_oc=Adr4M7Cuh5J_zPHTSQotwPC8nd8MTinFDJxBK-lkManoAX3brKwVFWNf-vqH6bHpN34&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzcxteEeU0kDF1hC14_jYtVJDywu0baNfbdL_Ll4lwrSA&oe=69C661B5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L16tebUBq_4Q7kNvwEmfwN9&_nc_oc=Adq84BU-BShDHfv85bTpISJfUUD-nNoj6xx21DDfaFCQBsTmt1nRrmySw-dr_q792vU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8-3GSUqCbIgcpaBrKQlkpJu_ki9CrLZsoQ455av1QhA&oe=6A298A64"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iA37RM0x6EQ7kNvwHg2E4Y&_nc_oc=AdrLg2iVbO0erXUCClfZPPyCpguyKZq1WKZxhsEs84R2PGafySj7C6JcmC6ot-bh8ZU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JQx0mnYnjTm81xdOhmaAiPwDagZWRVtSSo_9rfR4fFQ&oe=6A2987A8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pX7SDle7PCcQ7kNvwHEgJCA&_nc_oc=AdrOXuPW3I3KfUYNlDdTYW6ZNCYJhPyXCcZD1_ll2B4Q4uFkDzCekzoBBD3B_knuOUc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9G9YQaBPSaZ9IxQUez2i8yOw2YUg1k8mj-5GrajdNh6g&oe=6A2953B8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4FQXQNBxNsQ7kNvwEFtqV4&_nc_oc=Ado1bcIg2putnlLetXYWu53kmumDJMW7rGM9BHMhkU9zZ6aDFm0edWBYifx9I7AQe0s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TuDGufB7P72Ztry2iwRgPiq_e_Q_Y5LM9D-YVbDcJUQ&oe=6A295919"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eic4X3MauLMQ7kNvwGezdxD&_nc_oc=AdoHhl3488IK9ZItZtK-2dN21Wlkj7VoIC1nC-UQ6pY1ZW6pnLb-7Ua_9t27PtfX_wI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-63q2-obyRV0zXvqa4wtsomAtlAxEYHBN9QtWxEvGJBQ&oe=6A297A75"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
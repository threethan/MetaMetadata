15371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43b_gMXU1FUQ7kNvwGjOv2Q&_nc_oc=AdrSiKBo2_zlUFAWHwPHDB_fshoGwfWNnTRsZdyacTBaDJnidDWrTT_MbFdXI9CgBcE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKakDBJct3vvXjdPXaI2Sv21kNIeg-ihuWeZy0lgbJdTw&oe=6AA3EDA4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0QmdEh0-XMQ7kNvwHTaxEO&_nc_oc=AdpjT83xMN7QIW5E1jnrdlZxefX0a-zDRjUfvk1AAFBuQkSgoglFP7ssfYJJwElyezM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjeGr8iBPlFDWqwT3gEKtEW7mpEaNvwQeEBUQ6Ff8oMQ&oe=6AA42328"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40SFCeBHoEsQ7kNvwG3UdQ9&_nc_oc=AdpnaVCISze9LTehVvnJP382qq7oS4dYHQggcDZrqOZcXoaHRSw1WrDIIgoMoryup9E&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1pD1DzDnMNNQ4PY5SJfNYFdTwfbSAHGRiuVCGLn3WQw&oe=6AA3EF38"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulNbOLEiZzgQ7kNvwGWAHc_&_nc_oc=Adoq6pyPQOqyxhLhBIVjzHhejZ2uD5wiFrADFGQKV38Sr0yS6XKWiPjPgb_drY6ZU2g&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlxOXoRR3yi5SHHYGRxgQAQL11F1yHMpLUqZTh92nspQ&oe=6AA3F499"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FI_DPT_a-EQ7kNvwEVAbKc&_nc_oc=AdpgBK_IelW-OTQoSrZp28AcNfsUioOllaDNdQMsxM-ItER_Qm7kAksz94yJ2v135yE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCMgFRejtaj9fmokn7R4CUnckI5GrVp6NIOUpDLgl-0w&oe=6AA415F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["
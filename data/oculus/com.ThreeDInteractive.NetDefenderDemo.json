371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWULy-JlblMQ7kNvwGV1vDR&_nc_oc=AdqkFrn-LgNUoSzqHA9DyyHKR09SKVK2POWVAtlRGuwz_3dHF3jifpH-YAySPr-Oaj8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05XOgEuUNnt42rhHUlx8C7XymgJtNXhMwsVpC166Q6Xg&oe=69D643A4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MElEpCA16IgQ7kNvwEara-P&_nc_oc=AdqV-mqRcNpNYgKBUocoxaJkU51PqDvSpJje5Jxev-YPDgsttOj-wPCIy2URJOWmduY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02kS4oyc7rzm-KYWqATwSk2ixkCYLic9IRP-Jr-Au9mA&oe=69D640E8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myuHrzK1ayEQ7kNvwED9jb5&_nc_oc=Adrk3GgNLzrUzTPOKnDzzlwZbuZoHYb3TMBYqaPszT_9ApjsWk70xveSS1XemEf-8qE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1D8n2LEDstNTQmThgu9RRsJTKpVIWqJvti6xzJc0fJ6g&oe=69D64538"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeoVqrrn9E8Q7kNvwGO6MQY&_nc_oc=Adpqj_FKXUbx0glkgaOutGE83S53OjfDm54Ry6I3h5vnC0G1p1JTrslblrcKn4mt2sU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FifePgSneU1uU8jG5txe6o_XcrC2Zwsgn4DzGi8Yzsw&oe=69D64A99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlby8-0PZrEQ7kNvwEsbm1u&_nc_oc=Adp5FDpgn0PAJ-a5zx2irrgo8wn8yueY3Ix6jXsAWf0EAv7VW5Ro2FE5WFW3O-JT-Ds&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PBl-KUq9vcFSBjPtyzu04ZS3eJvsnaqwKucjHMJ4AeQ&oe=69D633B5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
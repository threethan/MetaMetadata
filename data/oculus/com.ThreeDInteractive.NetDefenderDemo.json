371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbAh1E45VGoQ7kNvwGDaM3j&_nc_oc=AdrRuXz7xsk6eo-tusbqpg0t_wmS_Kawtq8N5x3td3Pn86vAaOowmwTPaNDNI9syF38&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyijHmctTb3hhX4XhZEXSxoNac3UQnx8jlxwmq06z_Lqg&oe=69C7C324"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DspmXK0w7YoQ7kNvwGq5Cci&_nc_oc=AdrQSLS3t9KD8Ra3-P-XGaaVRdZpq7QXKkxANeLmL8Xb72Z3q06jU9ZAGHRjqTUbnbc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJJLhq6ksmUoEvb9sm_ks2H6diwSn6F4m5x8In1wm-5w&oe=69C7C068"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAvGNtiBCMIQ7kNvwG5dP0J&_nc_oc=AdppndlQlF8-Dj4RRAdyLwW_YjONGWVIQ52wJHs-0GxaseJi6O6MryUWjHdCMUj_gAc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxCXWLtGhAX0S2gK3W8wO-vPkMCQKsvlku83sHpp3IHCQ&oe=69C7C4B8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSsGR6baBqAQ7kNvwFG5m8E&_nc_oc=AdqKZ1D7bqEKU88nyylUvHJwsNDlzHi4MDIOXtkHsR2W2zBb827Gkk71JgplE10kSl8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwb7kmNvp9OndJZQG3pn6sdHvuB9xNVT27AA6ChThgLoA&oe=69C7CA19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwmMJ-wzpX4Q7kNvwEo-tyE&_nc_oc=AdrFbhWvMrrCmX8gIgr1TnHEke8OhyY-xGVCyGWlAL5inG9XFGPwsK7e4O0RtlR4Mkg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx6PINjLJgSZkKoM7pNABJg-N8pbUc1YNp8jDBvZ9fruA&oe=69C7B335"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
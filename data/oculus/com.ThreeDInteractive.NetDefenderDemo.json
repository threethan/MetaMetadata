371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSqxJKUCUxkQ7kNvwEzJL0o&_nc_oc=Adp75eQi-RVNJX1rJXzXml372dqBRBKO5XlhQoHV7Kb2Iq8uRSkzUFC0QNh8NZB6Ke0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImuXEZYJzCMOW6ToCcfWk6vYiIT_BzY0o5TZvyUusI8A&oe=6AB54964"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUdQiLw6mvsQ7kNvwEPOTCZ&_nc_oc=Ado_gGO1Qzc6kryKSIEpZ9DT3flJKBsyYyiva7c_rWuBXh9YFOu2S25LKzJjvqX4xRw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1JSLe9p48RiGequ3OC9klpaqXKzLvFspN3IGH3DvFoQ&oe=6AB546A8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UubghyykuPsQ7kNvwESIC3C&_nc_oc=AdpAxAZA9FqBlUvdY1stNBYoIiiBHIm7hGe3CZo0l6V7xfbDrma0H_0lIyMxAgXmSyU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKy75JIKg7PqHB4TJcll1L2J4-A_KyqJsTMevSm5U7_3A&oe=6AB54AF8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLqG8FbayuoQ7kNvwGqKrPv&_nc_oc=AdryKA5O52cSpkZrHoTgu5ujjMDyxgojOq_eP5A6tsfP10QASAvr5-uklthtHA1X7WA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNZdeRai6gkBVCP0bsHjCdQBTHPV9Y1K1Y_Wrh-hCO1w&oe=6AB51819"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzjREs8xFcIQ7kNvwFC-PX9&_nc_oc=AdobFXTR8cAxpKjRQ_vvEYdn48qSgHJeNeGak20Tu03QcvddDfhoWfLIIpnfa28_ohg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKsEwWOoIw5YvwqCHaDKw6jt_Fbo6U2uNgDsgFJ973FA&oe=6AB53975"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
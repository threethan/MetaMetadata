371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NX13bgICWUgQ7kNvwGmQ4sS&_nc_oc=AdqhY8IuhePfuzkYYYeJZG6uWCBU7Ff4xlfRFOoC20V3CyAEZXebIGFGz1wgPVZExGY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VqOqwjTYa5s_JdLG9aQDoWOznlhNxwhWDF5ignwyZTQ&oe=69EB5BA4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Es-J6SwF8vcQ7kNvwFGImuP&_nc_oc=Adr0X955ZFIiVgc1BMDiNx7cd2TmXuqmkB_wUnUvFsfNtV-qg3RGJ6jTYN1COtmp7HA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ko-o2iFGoumEYpxUNulqBDM4-I_MgR0j-tfqCrxr_Bw&oe=69EB58E8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHmHrVV6auwQ7kNvwFV0IUz&_nc_oc=AdrgoGdO3DNLrIgtybZ9fnypYTyHr8TMenjyMgmJYL9UvXqPw2OuR0wOwE6ve1dE1-8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HBG1vA3apssA8CH8Dq5k-8uNQtjWoy3TnetTscYwlHg&oe=69EB5D38"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAUO4cdgkkYQ7kNvwE2Ls73&_nc_oc=AdroazB34IyBglqewhQoAjndhn1z9uxqzty6ojOXbt8VLpSDxprBPWpnpnT6D1HfiHM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kT0AG3E8pLjgS2qDn1i_oT0pe-4NatAsVD2mox0EuMw&oe=69EB6299"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esnO5iVsr5gQ7kNvwHM05p7&_nc_oc=AdrodZ2hjTyFztr9uG9DO3VyLMskP3JKpq2HPNYN6E30g4I27xMMPFV9YsO4Ev04p4A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cwlMllVINAmeAZQdcMWqBmXxyyaSzEMNxNpL3uVfyoQ&oe=69EB83F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
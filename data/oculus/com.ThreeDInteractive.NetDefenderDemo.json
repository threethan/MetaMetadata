371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgCP-clYdbAQ7kNvwFXrRan&_nc_oc=AdqEoY2QpIwT7uobdJ6XCm88R4UR6h9M2MvD-wZt471rJuAMNj8GoUAjdIuyN7ONDBs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdzNYeOHjphnBHIgzEim9HgC0v1thFFCmK1BI3HU115g&oe=6A9AEB64"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBPC7Dwr8F4Q7kNvwFF8HN7&_nc_oc=AdqdrmiEk5JwaLm5c9mCHP4fj9OXTH0u1l2fMW_KNGpRZP7U5nlnSqCR8ySV9a_jI0g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEIQbEte1B7UF2KdOk-KZRdPIMJD16anPexdLmI2FddQ&oe=6A9AE8A8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7VuDSyEjMoQ7kNvwF2h4io&_nc_oc=Adod6DD6vz2XPZQqtE9lPX3aHJFwqCbHxVZ0UCwMiPDILNrO7nvX5ioEX2CPPY8YL_w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL41KXph5jM8AQH1NiYbuyIWyqYKEnHV2HxCjuEjPs7EQ&oe=6A9AECF8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l42JApVKISUQ7kNvwHgRzGD&_nc_oc=AdoHJhk79W9ozZx_7JzvVfHkxJLeqFRidQauAuMJZHKnFzrf9_S3eEZtYfNIr935AkE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLK1VE5VyeG_w8iW0xlR_DQLYxFXewjLjH5ccDMYJe2YQ&oe=6A9AF259"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsHB22P7yh4Q7kNvwEzB8eO&_nc_oc=AdoqnscyhwKv3fySw8HmsjF4xEtFRGM9Le1ceUOu29sQ3lXayz4ROWoKzHPLnCKrCv4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbpZv9e3SlvtJsb2Eg8PmOqzlA6knsriPTo3DVZr4tag&oe=6A9ADB75"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
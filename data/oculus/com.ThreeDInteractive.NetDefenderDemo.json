371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlIlEsCtF_EQ7kNvwGwtEd_&_nc_oc=Adry_oZbRniAN-YhTq9qpxQo3kozU54Z2KxZYycqZZavG0WQ0MeiXTv5T-FaUcC-bbI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOor7AIjorKmMvaUoh2N8TQSGalXQWNCLDr8DGimYOKxg&oe=6AC126E4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abUrT5Ls7hYQ7kNvwE1XLKe&_nc_oc=AdqXl06NNN49qhc-vx_Bpyj-WQacmhdVgb2yQpWH505Fo4NEJjZRbsvKmZLwORh_nDg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOX1dNRJ-YJUUPf3FXuYpPHGzwXzKEHX-EAvfPFSXIpnA&oe=6AC12428"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iV_gdqMflMQQ7kNvwES_bAz&_nc_oc=AdrtRDLYl4U4POZ95JIoT1VPnJNxU6v4mxNICg0TdDG6AyEP0HlpP_PMrLdaDvJYS1Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqZYGkiqtHrRwi0paHoaB-EZ23j-xGgDKp1DqfluVS1g&oe=6AC12878"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biU-N5zMO5MQ7kNvwEOLcKw&_nc_oc=Adokr7vETE2etQQoLcgXsZDwNItRqXIjbUPCc5diWsDzbZ4oBniCUSfLgRY49SP4Ib0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNheDxcBrHL7YND_2pzZK1IdazPKjtTEqjj8nZY68TbWQ&oe=6AC12DD9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-iScy1oiqQQ7kNvwERk9SW&_nc_oc=AdpbRs4j1aj1j72VeiULdZgXTRP7hRJ2zQU9Lag5zwUESLud2eLhJn3WipJtLMxH6Z8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8tsTBJGD-hitgJu0ZYE0wSs6-EgxDa78lKb4aL6dPLg&oe=6AC116F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
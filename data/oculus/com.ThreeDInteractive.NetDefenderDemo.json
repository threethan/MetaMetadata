371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4ENMBZBq6gQ7kNvwG59aTR&_nc_oc=AdpDzelDGgNL81yH3sZTIUPY_FwIa-T4AUiAtNbIHeywos60woY0R3vkDvUxQPuPp20&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69gwo3O56Chwwi097lJ9nsFXvtzxj-cOS2SF5MywtinQ&oe=6A01C524"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgcWPgMi7SEQ7kNvwHe_Zos&_nc_oc=AdoEdJJm3QgnLkxsDywytQIabnuBCTHgSt8yGYqEuEZKc2oX1-vsA1hT7Ah_TGjRS_I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FgJN_-XL-2tKOIQgpgvL6nMGLHe3ojJH9_Rrjs9R9pQ&oe=6A01C268"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmdzT0uuL84Q7kNvwGyqndK&_nc_oc=AdpNB_LRpWzGIg3UfblIEH2pcrMwlxMeSETPxcLfD-DQTTSH7uPWtwioQUn8cNswqgY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68dVHnSFqzB9Cyy50DtixVZ-T_q1Vm9OxZYhopJdPTPA&oe=6A01C6B8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PV9FtDPZS7UQ7kNvwEL9Rb6&_nc_oc=AdqBmlC3yWgxqCdEbCiNri1s9XxhsOyZcVUqTKWZMxtvToCPhn07UGOTO89v7ccSRBA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ivW2mgsAunJTG1sGEL4bbj73kzBc7d6TbV6zvxeDTuQ&oe=6A01CC19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I142BA47bLkQ7kNvwHn1Eu_&_nc_oc=Adr-DHuBQ2H03a-doxhQGjCnR8QA2EsR2FpDf8WXFQXObfGPvkEGFv3HSLhz04FAKPs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ykNtUHKY6ajfeMMzPHfrJCbDVL9kw0l_7bKsuYgYtSQ&oe=6A01ED75"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfLXeNDqVeIQ7kNvwFJKUd_&_nc_oc=Adqu3xd7zEo1ewByng62VNxHAPwLDUfih3IrbZKRwkTWasEfu4XfdKMSd72NJ2yUfSY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5o3FrEWp6de2zYa6yOTWT6mahd1NX1ctG1IvYA7UtYFg&oe=69FA1464"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiIjkCU0wzsQ7kNvwHXTRtu&_nc_oc=AdoYaopKYVLuJhkfeuIu4i1FnN4qSYi3Px0RKryVBQoTVoc8fCYphQg8sBrivpGUDKw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eKM65d_9HM4V76_RXDxIXTHhLTZMDLFYr8fnCrTQM5w&oe=69FA11A8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOKQ_FCuG8QQ7kNvwECS6uP&_nc_oc=AdoTq8oMQgdfKkwqpQL9lb1o71KP-_BKFlgrWVpZTzpEaboNjirEGBPxRAo2Aq3Sr34&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7t0GI7h487tuj53la-cHLUHUCoGcm4ARvT7LFI3TBh4Q&oe=69F9DDB8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nxdckbfmmb0Q7kNvwG3Vt7U&_nc_oc=AdrVCAmwIxnvz2Z5U-UYvH9jO_fdjXIxCvwdqQX4l_HU2_xM3gUtm3Cp-krmZHYp-JI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Fwao9SoogZNc-MbqIFCl-plT5lQ2zdsofe5qS_cuCBQ&oe=69F9E319"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNKtkIk-6OAQ7kNvwHo0T23&_nc_oc=AdowdLA5enOVFCX1LFdmMHicYrKyzF7XFL-BGT_s7lcxL1CL6AlL5ARNWDIrR7mWW38&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qAU_MQcKWEtr4FKKpA0RKQonSAG_2DV1ZzA_i75Ou5w&oe=69FA0475"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSWC0yn_VDYQ7kNvwFqgZjd&_nc_oc=Adqy91kWBWigh-spHTsB5hlJFBR8dRkTUxyESs8hXumHgVAPRBvmwlspyroe6z4j6Jo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-ZX_LWeelsgwAVep0PN_-JWA2t8kxufyTKAcdc83ETA&oe=69E0CFA4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kscjErdrJ7UQ7kNvwEFOBwM&_nc_oc=AdqzV0-bBYWiFg9sPVLGIY1gRsmucKrOER-xKkH-8KsSRNT4jLvFtQVJnHztk1NLywc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_iqiU7kzkw34G_WBzzceYiOzFYQglzDM1cOZaGON5TA&oe=69E0CCE8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ai-47l8bmywQ7kNvwHfiPIg&_nc_oc=AdpL5UEAhaQy1xM2i40QdI_rV7r0O_SW7S-MXPN-kB_ZNOo3AWHlXoF9C102kEDDHZg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3H_oErUDJvdSkmFuh1ddtfg8SEObrbOCEohhdY351fNA&oe=69E0D138"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnzBkXFZmS8Q7kNvwH8n1xW&_nc_oc=Adpj52XHp8eFXucH3-T7b2jfWEPi-e5R4rcylVthi-y4qfUn0HQ1n8B1aEc4a1h-jQw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2z4CRfE-R5lsP3btKdtmS1SH6X5gtHAsIgk9Mpwj89BQ&oe=69E0D699"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fF7p3CJg5_cQ7kNvwGRmLdd&_nc_oc=AdpFRI4R2HpHC4skwWMxtCdLJokBpd6TLYzqbYOqV9LW2B5Px0PmuqbSBLSHL4b_oHc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1X6R5gvOquGFYFSWzwy8qOCYy6qxaVYKqPonstFneKxA&oe=69E0F7F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
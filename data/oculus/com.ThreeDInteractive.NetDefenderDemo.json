371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOVUETcX5REQ7kNvwH_w6fW&_nc_oc=AdpfoUvOxT8tKJK5VSdQoB5aj_m-SMfYirYnncK9kLdJq80GGKvruT3Qh3QcwAM2GjI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGatxJU4jf42es283EdQ0srxtY-80BlL_7NfwKE1BK_jg&oe=6A9178A4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMi1d5ZMr60Q7kNvwE5OonG&_nc_oc=AdolSbEOd1YaMsPXBXGS0Or_YNdTEJZrMIK50ZE9wybs0eEMSBQDIRrQyYNijJpv6z8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXnMiuiSQ6QhtJFJ-xaPHZFhlMXO4NYcyXBzeR5beZ5g&oe=6A9175E8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eE99Tmfo6cAQ7kNvwHFHPOk&_nc_oc=Adp79c4AEFLNERLZM41TACf5I8gaFPV4wbgm4uszbiHE-JTDyxHt_tMwv-ukwMCXiDM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGn_jJ9pyN5hA2bBqp7N0-PudW7DxOqKrty4FErhTh4HA&oe=6A917A38"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xEiX9lKjBkQ7kNvwEfpLeu&_nc_oc=AdqVHJaoE_Z7AIzwCF9aaOlG-TPRJIYQ4-o0kx_snHlg8_3KWxRiRuoGEZmOZcsmkWg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG07636nYImmo02YbMTM_zCi_CBIqLdBzmMZZQDai1drA&oe=6A917F99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAyrmZEWw1YQ7kNvwEaEEOk&_nc_oc=AdoQ1vzwF2Lgp-RhINWUkpksQd60WjjsQhwgg-bbV8r-C2V-_-xussTLh1eOuylqN34&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOIshD0HwFX_IlPANCYx8aaB_j3joVALt4FbJUNqHJKA&oe=6A9168B5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
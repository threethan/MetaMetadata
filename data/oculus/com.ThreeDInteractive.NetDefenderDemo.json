15371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNejqQOwJD8Q7kNvwHFWzi-&_nc_oc=AdrOK0FLN4avgXQH7gUQHKfHDiJ_CAv5TNBYOfCTKi_1GmIDVYDvHVXLmc89mqq-Tms&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QMCwtf0FEc2gq37jsOHVyEBsRGlYKcUB-Nf_1Wrn4zg&oe=6A11CF64"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lg3L04secg0Q7kNvwGbxZUp&_nc_oc=AdrAy3ffbGUCmTV28DYgQqYVTHdu7w-KzDi8zVIaCYiF6vBcUb0nzUvOz6CMfEbAsDM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wrQUxHYWBopNngAaRpnOJEcqEUq0nYHmdHt7T6qUwhw&oe=6A11CCA8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBmBmO3SdZAQ7kNvwEsXhkk&_nc_oc=AdoadAIVWUHEGXKK4W8hek1SS_hzjFuAV4VAWNcPw_fxZzGO75EmqlasJz-0bHn2zZI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JOl9mvg09ugcYS2j2JSis8nduLEDZJj5Xs8YGEL025Q&oe=6A1198B8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggEuIAuBEv0Q7kNvwFzjC7V&_nc_oc=AdrR4vVZVc6NSEmsOqoDnpZ00mpbv28tMUls8gYSAbWco5U_f17NOJZgiO-IKOrds3c&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4V3K4Ugo_XAvjFOMY77sqvZr4qRA0oztV-7B_sn7e9MA&oe=6A119E19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsWp8M4M4JsQ7kNvwHhisAn&_nc_oc=AdoRhi53O0iHywSBg-l9fuX3cBB7uYcfwfQu3SWqFiDQWinAjOLTfn85TPaUTi2_A8w&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53Z9hCzlxuIQSFd-uo_GpfBTmpeEg2X9D5r_uGGdSSxg&oe=6A11BF75"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["
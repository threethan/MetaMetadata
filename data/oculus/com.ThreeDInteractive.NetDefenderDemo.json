371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqWR6n5GKLIQ7kNvwE3PRKy&_nc_oc=AdpbVwt2yWddXSTtPNQ7BcFyARRkR8bwNSuqtOvz5rHv-fXqzLkYOaVSKTKoAuODg8U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKM0MilqTugMEPWCRsWm-MUI8T2wjw7Kv5DaKe5lB29MA&oe=6ABBE0E4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuEnVTWT-z4Q7kNvwEV_XpI&_nc_oc=AdprfEE9aloUZK0RV5SYJ-li2RliPcFZcALI_xmMXxMhgtjlv7TcCw1LOo6T44NTbPU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJD67E-6ewHbhDP4ZVCHs1WES7oAlhVMagJgRseR1o1Jw&oe=6ABBDE28"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUkZJuj5lvgQ7kNvwEVZ_H1&_nc_oc=AdrGO61DPTpFxlAbU6Ym7Y2EKopjNMXZDJcakDpm6oyqa6wDrYaOY6O3yLc1G5gN9cI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_-buBYixrP1X4mpw95L4XmHKtVAmpoT5BmJobM1mSDQ&oe=6ABBE278"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HY1yqTtes3oQ7kNvwHHLDJA&_nc_oc=AdoUiqV2u4MKfxGU143wRvYmBPn9CUJaDW2o915IYje2ERlTwiuPiJ00WxhXOIIb9DU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1iaT7iAOcZB4zyM_z6Q33VPmCO_FioQ0gWldL-8nmBw&oe=6ABBAF99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t--wOFN-z1kQ7kNvwFJ9Qt4&_nc_oc=AdqWIgcXwJhJIGbkKfjVaUOE_Lc0OnJR4xrBEYbUnq9j0KijZhz81c2Krxh04yE-4ig&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWj04OJoCylA5iwtRVxjRin9b-rpr1zLe8a4MBh3sc3g&oe=6ABBD0F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
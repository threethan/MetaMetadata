371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uypPexS0Uv4Q7kNvwEmbWl4&_nc_oc=AdoOEvEKbpsJ-hhKfrjA9szMEHmDKrrohV8BwUpYssU2ygv9f_4dUTPepH9I8tgG9io&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ltWs1Xho_4eu8LP6lMjWM4BAJSIkPFwBqhnLda7p_xg&oe=69FDD0A4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4187pyVajrgQ7kNvwHXddQU&_nc_oc=AdpT78dSKFN_KApaOUj0EtQH0JuD5J7YTTxHDxQNPrGBSWTzQAKXzqbRGxFXPmpG4g8&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PJDtlOIDhHfsQDY53hnuqhkDtWKMAszgbwTYhnbmGzQ&oe=69FE0628"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59e27ldVt6oQ7kNvwHHv-t7&_nc_oc=Adqm6uUh2133ewTQ74vqBp2cO_HN-UGCCTurVCDsTX7Prr7t8F9dHUArwQ-eqSzuRRs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-cSy2ZEFXlydPbivRFmWtoJUfPYq6OxgeYJfFMi4Q8g&oe=69FDD238"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ULNdisvDTwQ7kNvwFvqr0r&_nc_oc=Adqi1PT83zbKyavlD4RZZeg9CM7QxgU3KRfv_qkbD7meBFN0bNgUHMsfhdyyb2F1WUw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Q1shGdnV-YNnE3riWfDBQ-qxE_UA12ilcyOLTh1DS6w&oe=69FDD799"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83IHeU6KRwIQ7kNvwF8RIjK&_nc_oc=Adqlq4CvIvZRrDFbH7jGgSo_7qJqlgVSYSLT4i_XResEnWO1UJ34JwUY7Eg0h4EZgVo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gQtng5_-OQd_GaeMjJFU48UEEvR20Ps9KvyYJDwtPhw&oe=69FDF8F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2h7Os8FnyoQ7kNvwGOq34a&_nc_oc=Ado4lhV42ZiN4g90hSnnYdWgbp2mLM1Z4bEXHQhj1GEOjkELqMALf-xlMAIoWToTCOc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMilsKOIKM2KKp7MK1tY_fR2uxkwkqMh0hVV_Gmv3L6sw&oe=6ACA6164"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ob372mXYVgcQ7kNvwFTssXw&_nc_oc=Adr5oHTMHaUrv2Bj1spLX8G415eOHXp7m4hPdGAlAr7XF7mn7Tr7ExdrAB8kk39qu3s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5LC7OtWbdOjSjqJveTzHTITAoLtrIUZEuFinWGSom4A&oe=6ACA5EA8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzXln2s_LoQQ7kNvwEtQLxU&_nc_oc=AdoZVbuZVN_nYiA3mZreVoIrhwnaMYNiFEbbqsYzvWMZw_ttTvJ9Xv7G1kKEjDKcxww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOisgZW0AHO5RNQVofHV2053Z4oaslXQ_Iw96lt__eiVg&oe=6ACA62F8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqRp2Lk1eE4Q7kNvwH35bwn&_nc_oc=Adp8pwfprzdCf93Fwcn5300-lPrpQ142hBIK-qjpQYq1_Gf_1OGEOlvCaQ3U3lQX5xo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeF8TTrp1UaoauI4lD5i_R_Mv9ZR7W7FTYe5ookatFsA&oe=6ACA6859"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltPdBL3ic4IQ7kNvwF9RzdQ&_nc_oc=Adp2JCEwulSM8ucZpODlusRgWRvU0vOj55J1CU9z9QJlvNCz8M8e26zadjBMzt1_IT0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5KW_QcXjvgrVOjiQVSJeXGQ0W6P6GAoF56mg43B1_5Q&oe=6ACA5175"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
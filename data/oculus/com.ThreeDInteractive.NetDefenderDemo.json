371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjUWomsBMhgQ7kNvwFyhCDz&_nc_oc=Adq1NxtvnP9YETdTApKyL1qkYkOc020q9eXiLh3wZul_aInTiLnzMA2IHF09Ao8BB9s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEHnsCDoutHYW0F74WlXEh1Qv8Xf1ZooJQzrwYKy2tpg&oe=6A54D3A4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmTh-Byf9gwQ7kNvwFikDW6&_nc_oc=Adrbenn9LCr9m0DFIXWRiS19AnnWi1J5UyD0Wne-Mk8lVJAhooeFn_Ib15ijXBdLg0o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzZiZgcHss_wjz5lLhYMJ0W3xLAMf63U3NaxwhQamzag&oe=6A550928"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BW8SLamyL4cQ7kNvwHH_k57&_nc_oc=AdoLAuejT-TB5p26Z_s1sfOS4-45y1Xn7t7D7K9J-6V8yNJrJF_HCMDboPNLudg9Y_4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8cYb6uTbXRxuuMxe0KrLoI3GeOliWmw6PXiDEs6G2Pg&oe=6A54D538"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkrwFGtGdpMQ7kNvwEvDmk0&_nc_oc=Adr-VOj6QhQjmMIRt6Y5o9UB1iCZB05XcjESZZx4nvyXQLYjPWrZ3bXEwZryiGuhzs8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwUDzdq5rNTd56uj2XhK0DDW4SJcKoXKWigwbjEGgJHQ&oe=6A54DA99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AopLyLFxejEQ7kNvwFCG_Zd&_nc_oc=AdpB7IfTwfE5WALOfKJDHO08e0gdPsr--OvdYKxYkrIAYwM52-VwUpcIU020_4CRQ8U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpVYIApt40pm0uHipohUtTSd2PbrPwFwkRbt_Ba8o__Q&oe=6A54FBF5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
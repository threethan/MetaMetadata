371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEsU8c9DH0wQ7kNvwFw5F_w&_nc_oc=AdqOdi9fu1H23tk-lt0-JOWMNof5LFFXcZVCyVl2Fyqay1s9ykpkLexkN9jDj7m5h_U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsWhUFP8Gk_LfSk-7NO0e-rUjKqSjX-OG_2UD09ihvvg&oe=6A5A19A4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqdLsz8U3m4Q7kNvwEBJ3I6&_nc_oc=AdpzZZNFX-njLFi9HY864-RdNquI756HCkXyBWiqiUfpBi-K3vC9uwlmVKu-ZRWLZ84&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFT0t2rTrQIAa1bmCHGrL1giaaxqTboqSndEPJyzDsGQ&oe=6A5A16E8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7cbw08jczAQ7kNvwGGHhEp&_nc_oc=Adpbo8qaUOZ6SJQUfvWTDDMa1C6lntRBb5TlmxFLa5aBJSK_8BPXvlsTYmat6ahlX5c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSmAbucfHdJYU1ho3CH6bP4A9uYKef1Sw8g7-RShQ6RQ&oe=6A5A1B38"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47r3IKTz_NsQ7kNvwEo_SkZ&_nc_oc=AdqqCVJH69Hb-2SdAzhbT9jetgF8iy-PTkiF7byIGhgE3QKS8ImA__DWNvLCWR_wu-Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIvQ_2DDcnZ38ykgckf60PVINxxCitvg1r0iqB971Q9w&oe=6A5A2099"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeT-HvN6lwkQ7kNvwGhUqM9&_nc_oc=AdoI4p7e-78tJosy6xtJ-op1QsnkqZzo4uFBuhGfN9Dgpy2sx_apFj5atd_SiSusgLM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV3_5HXqvvuE6nb7aiQlI_qEsUp3-i8jnn3GeD_LwJWw&oe=6A5A41F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
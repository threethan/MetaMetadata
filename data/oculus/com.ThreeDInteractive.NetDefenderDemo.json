371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PLw90Y4TzYQ7kNvwF1lLt3&_nc_oc=AdqWVRtxic4U2Awpb7F8v2H7JrxiwyIFKprnzSTbTGLuoT41tzvsu_FySIKfNAXdl8c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BdK_Z4UZim-OolKxtsGtF32eeb-aUmavNY6vEPcxAfQ&oe=6A05B9A4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3bNSZxbX0gQ7kNvwH8uDgC&_nc_oc=AdoLG9_El-B9MbaKMjy9gXxllA5QCUa8kSBm8qMDfaKUhgTe-pBJva0MHZJ-0rnQhg8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ulmBfBy2BCnCTOhrhLyHNvTPCVXzV4mDcfVcFile1uA&oe=6A05EF28"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LnEXN-Q4HkQ7kNvwG6SaLf&_nc_oc=Adq_k_FnlsAKy346uyD6RvXjI1_ROozfoiEJhjmoSh-QIDmDkQZ29-YntyDHyrGAyT4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af755aaKg65gbS4xfRl-hv3qnP1PZliOjcHZQWITjdPkZA&oe=6A05BB38"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6PCsRc0KVAQ7kNvwE-i0Ad&_nc_oc=AdrX8pS56OjczxstvB0CeWsm6pzY9yDon21x0KBY_79qZgeWJq7w016VPRw4QVVGcmo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-KeZTYtF2fblDPoztrUexFxQFON85IDMVsRWOvUa9Kg&oe=6A05C099"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vp-Fi7y83hEQ7kNvwFzMjAc&_nc_oc=AdqrkWKo-NB0WIDHHCOsNmsYogVkkMq34BGTTEU8tGlzFloFJByf2OMv0wrTvG6WqSA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hzmle5xatCkVGVFP0lbIIg6kAPofMCRNGbvhZD_jhtQ&oe=6A05E1F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
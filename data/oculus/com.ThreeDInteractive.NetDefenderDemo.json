371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHpzQAO47RQQ7kNvwElOFWC&_nc_oc=AdqawAuhdhiM6FXzOVbUYjHvg14z7tE8accOLONvcJ2f03FFR530c-FDGe43eHmpJdg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PFQaJ5gmknzXEb3s9u195qQl9bnQKPYaIAHfczN3EgA&oe=6A2D7EE4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjkzUIbemL4Q7kNvwG1XyHU&_nc_oc=AdoKVGi6Vq5N1LnwLch2JYnOstlFneXJtf0muewl0M7g6gVcvf8oe6DEIitLu5OIF_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pgEWV8VN-dg9P7oEa0ZpYrMTxYcg2en39YLCVLIagPA&oe=6A2D7C28"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgYPWm7ZQDkQ7kNvwFeW0yv&_nc_oc=AdqDFmBeJ6faxpS8Y7Iy-FsYWR9wmKeH4VVgA3qnEzVACbZC0DvcI8iS1tGZZ3Mm2qE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Kp_UG-Ka5QvxvpzUhUzcgbqXh9uDWDeoZh1CQ2aUinQ&oe=6A2D8078"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uK2SOvUhneUQ7kNvwGYjsSm&_nc_oc=AdptUcbM2gtHZ8bE5gyoa8NmjDr29Ao1mIZ2QzfsdbjueL0g_EfTtK1Vyge5Sjg-Inc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ykJF56k4mgxYx64sT_uhriPEP7xvqH4OMqjuLuERZjQ&oe=6A2D4D99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtyIbCc4y9oQ7kNvwHM8JCR&_nc_oc=Adoliw4Q5FpU-mbyYi6ezXf9WedcBMMR1DAAUwRUDWJCcvI9dQHVerVZO4iHyK3ND_I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TxrTX0BXch_4IjsDPQGeHgLDI_OIH3V9TFOlLYnxU4g&oe=6A2D6EF5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
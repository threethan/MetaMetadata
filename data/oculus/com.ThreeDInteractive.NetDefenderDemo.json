371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=192mHSWVTH4Q7kNvwGFSp1O&_nc_oc=Adom4j-tnDfuu6B6T0QK60jB0v4TKo8NG3szFlzOHzCBQFCokiQnTtUn-xYGUI65ijA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3a5643FA3rfJHCShlRzNpQ5apKCrMXY_eBuMFaIzdK1A&oe=69E372A4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPuLmrZw0ksQ7kNvwHxGIRg&_nc_oc=AdrIyeVqe0L6401H1sn6F0VkLP1K9WpgpBxn5MKW6AJ6CF5d-0eYG7AF3jT9cp_tWAU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EToTIgHP8q60QgumlBlAukaMe5Fh2NeGYJ3Vm2gPy4Q&oe=69E36FE8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imOXzl19_OsQ7kNvwFfyIyt&_nc_oc=AdqQHt3Ysip6AIS4TKzp9vv4uClrUVj7QbVCNf7Gr6V6ONfLAk5vtBkaiOW4TB0tV40&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af011k62R_EzAdk-PzpBqig9OaFaxsgStR4y9Q5QXw8mlQ&oe=69E37438"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSyKlTwuUf0Q7kNvwHK1T-A&_nc_oc=Adp0ePLOroADfo8m0HiqMPqmao0Ec3xBlOJfoxY4K2-gYKXVUvj06uz3J5yU_zEqcms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rdT4HMycXhox8g1kkBpzRO4zxHOmDQMHJ2RpGDIrONQ&oe=69E37999"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WfHfV1GlakQ7kNvwFsM130&_nc_oc=AdoTNv41_PqmeQzdwea2QTUVSOSjwEshtyEq6nY-dPTim7EygPA0i_c3HpkWxqh0sGE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af396luY5JDR-S67DnFx-NNPMLuhg050Yhb_s7bb83mw5A&oe=69E39AF5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
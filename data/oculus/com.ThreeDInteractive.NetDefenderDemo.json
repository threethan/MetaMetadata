371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ou6Z6Bwb5GoQ7kNvwH34MR-&_nc_oc=AdoUDAhM7QDLi5nCu-bKi4klN29XGH8Q4y07WUN19En6WANw45Ek_-zReWPmjvENtL0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCogdjyp92GK6I2BAgEvHgqa6qTwqFMDPVUXA_jP4Bzvw&oe=6A538224"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdhMALoSyxsQ7kNvwGUUIqY&_nc_oc=AdrGV9AH-YevllJeu9RdlDaCtR4yhYydFdaCKzZzCmVQrK8L5JiyIbnDaVCmmcYel5I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGBgqG1MQFabSqir1u2X2CXDZmeb1EWS3gLce7zLImRg&oe=6A537F68"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHrH4Jk0lH0Q7kNvwFg7a8g&_nc_oc=Adrfz24jQUP86CaHHcubgP3D8qPELr4vfcz2OrNRD5ggCwBYpYBkViwtn1Nbgr1Vmzo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7FziCzIkXuLM1Ez6Tft6YqmaHld6h6W6fWk98xggWZA&oe=6A5383B8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JnvI3rSTwgQ7kNvwFhiXKm&_nc_oc=Adobr3gJGLht2Uktn02Tx6TkyI9BRmj5WHfmIJIlipKyZlypGpSi4QP_Yor1u0-K_Rs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoXGuIp80z6Jiew0Br-owLslghrIyGSE8Vx4TgJLfxww&oe=6A538919"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AopLyLFxejEQ7kNvwG9qKVk&_nc_oc=AdoTuxY-9s6lvzgSBShQ8UzgJTsuHQj-Z2H8Cy8cTOG5C3LsbpntXKJrZC3BGb6t8ec&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSKFU6sqoMBc8rsxUiD3qopqBP2puGmbYTPZvhHl0krw&oe=6A53AA75"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXTaeYQatvYQ7kNvwG3QA9Z&_nc_oc=AdoV0S27xOmqaqOlwnzMpQNbVD15XtcTMuuSWWZJ-GQAnJ1VkGVHAY8h_HWKwDaNVF4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wzGjYDNcYNFvpZDpi_w3EeWoZNZll7y_4yB9tTlaF3Q&oe=6A3FF3E4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTDMGNJF_nsQ7kNvwHMtK14&_nc_oc=AdqlQsx6drI-376lyIEFc4DJQTyM3io79RaPibUqQNos-oOfnrm4T_PCv_r9N8Wm2rU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OAyMk_zrbZl7Xm3xfmSNfQF3smt1s6FhY2jOlDGYZAA&oe=6A3FF128"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXVEEZbbcecQ7kNvwFS8Gmf&_nc_oc=AdpQMxLz8_C1wbDqjGiRsDmBEJRKdfYxCWGoi8Rrug3MMJ-RBXRPk-dyMnh7ZGTvluI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lU1WbTrQQgvgBG91SuKjNxT4iMdTRRNlm-yYUeD13qg&oe=6A3FBD38"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nHcyVDpATIQ7kNvwGjwnmx&_nc_oc=AdrJ--7nP1thz9ZhiKPPL4v8ifvc3SyX235J5TJrNw5MEV_CIWKuYmYsPwkgENRPcoM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xbzxfG9ayHiE5o-lY3CYkegYs5PkMtQTlhYBSQd-GaA&oe=6A3FC299"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RK_JUgW9VCMQ7kNvwGCtG-7&_nc_oc=AdpwsJnCfNHMGcttxZHB3ud2wS7GMpcvjdKlY7kmgwU255gXC39G6OUJD50O9Oqiq18&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IvlOa-ZQ7uEhv4wRmdHkphazRbnWki9l3htP0FjQpnQ&oe=6A3FE3F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
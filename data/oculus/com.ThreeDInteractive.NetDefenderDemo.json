371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djVZz4LyQU0Q7kNvwFggT9p&_nc_oc=AdrbYqVZ88nUzpMwcvwmgK9r3T3KZOz71oX3VXAbIFgn10bFwORtodYTNbfjyt5MRRE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETqbHtq8VIjDeJDI3VBxxtiQXEoJRuWdM-Pruov4v7bQ&oe=6A7477A4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_InmpvTi2asQ7kNvwH_hN07&_nc_oc=Adp6FoRmFX62zJ6lgB41MHMKJQYolc3SNxQHwo27MwrepfnM2d7XLyGJcPUJpKqQQGI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzTRM84ErUi_TSu5I29zUoujveFZZRoLM6w7-I381bVw&oe=6A7474E8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xoFP9_eZssQ7kNvwEXVnHq&_nc_oc=AdroMUga1E7OvyvVfWZM42mYwNso7x1rT8UHmvAa4soUCEapdAzoYbcx5wQXgwavo5k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5Fg-eT6VrYRp5y-j1PMTfXGHTLzYmjxoUZDaKitnXbQ&oe=6A747938"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A48IZv_PfYcQ7kNvwEB_cTZ&_nc_oc=AdouYzn9uPSHsseisaiUjsnq6jKQoe1jp8ICwg4-EqT4fbAFoJGuNv5PrpoLm8f4LQQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-zlIKZXoEinNKdMT57VxEliKPdeP2YUGYZVA9b3uf6g&oe=6A747E99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVQ_qWgu65UQ7kNvwHXRaYs&_nc_oc=AdowSngHXwfskeaRjmv8aW789Iuz4tYnTzd7ySelqO92Pi3NqB_3UmzM6TjSyzNwSmo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGu1YzOiXHGNLsYbMU2CA8qFA7lKswaLkIjfIcFYKvgWQ&oe=6A749FF5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
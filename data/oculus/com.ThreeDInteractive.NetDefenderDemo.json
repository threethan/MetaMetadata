3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDLk-oC0a4sQ7kNvwHXnr_b&_nc_oc=AdqHwwepsMfMjiMR7Bl-Dy9SbBj8y29gx459mLut3f-4OgmajOTW1LKEcSGJGsAmiP0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3zEKbYUeCzkB8xaOUqcidjJrQD-OPBhEWfnOe_PyhctQ&oe=69F1F4B8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOkeEkF43YUQ7kNvwG59Szl&_nc_oc=AdoNrdXgNFn7ns2tiOlh-qm2wAbGG2LY7aOimPRkY4uhj10Hy9U-A0BnHpyUC1DCQ6s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0z-cOOtkqr8l8Mkt89Z2Re76Mo-gshqoUSdEshZPw80A&oe=69F1FA19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChHymK33aPkQ7kNvwEJWPnO&_nc_oc=Adpm-i4OinaqqDpEHRLgrXnLViqAIHUiTontn08ZaI2dJN4R4783puSXKzOMZIQjwes&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0PfCaezvmhC08nlibt-oOHMmRVtJSXJpL5e-T0zJDQ1w&oe=69F21B75"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "shor
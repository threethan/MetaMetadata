371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdazh68NmKcQ7kNvwGzWImr&_nc_oc=AdoBOPCng74s_snZOq5p15vMwO0_D9hflISpLr-v_8qUtLmjlhWxaj0Qdhq7yHHoPDw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMocEyw4U3EkW8KKSdGHX1KxeTNtz8jEZGtjbzDdSWuPg&oe=6AE610E4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Te1hgXlZDfwQ7kNvwFN66x2&_nc_oc=AdpbJzunTSds7vznUiWcBTfaLvfEbpDD3cl1jY69ONpaR9ZNxaR_Ze_E1kdEkvayTt0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPM3YO-6fFuYC-zyXK6CfCaLZ1eqwPse2Sfwy4qMUARdw&oe=6AE60E28"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rA1AyVFuYxcQ7kNvwGoHDc4&_nc_oc=Ado2PJKdweUcSAeWUq8L8-532U57slam7Kwq3OELkY6b7rYFliRpBQNH4mNc9wkV6-Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOygn8BR2fFfJJc1zQHFwo1Ri7472C0MlFh9kV0J48F4w&oe=6AE61278"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLqNjOiiZo4Q7kNvwFtyOCT&_nc_oc=AdrWXuMkHPX3f9OEoiKKSjVjphtz2DJj3_iSMm3vQrrPGbIKg1y59B8RjaxI7zPg088&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWxa0UFvTLEz-JgLltksZ0ucqpYzecDT-1HcjeTNdGjg&oe=6AE5DF99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1oQfEF2KtJIQ7kNvwEvHkmt&_nc_oc=AdqsBQDTpUvj9iJZJSekO0dh_etrAVE5jd4plWjQIzaA6vi7JlxfZGv00lsP_X4bV4c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPm2s0NCRdAdymTuLNNTVw27DZ8biK1WWMizrZaEsAi7w&oe=6AE600F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
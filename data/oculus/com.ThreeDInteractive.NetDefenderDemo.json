OlHU8Edp3f5bCOfpopgPIN8iYI0NEEaiCrjBU1LshALSUik&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft8bxKwJFKdhD5gXfvUJ2ivkALQbgChjLa48wi75D4zqg&oe=69A03624"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URkaiX-OjAYQ7kNvwFl985C&_nc_oc=Adk99dka5a_q_dW1Vqs6xAj4o4apl9j1Q3bK8TMWEvE58iIeQCaLhxfXEVQ11LdQcYM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs_qnaTQjwOGofwkpDzZgPYUUd2z-wOGMa2yqW948N1xw&oe=69A03368"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwkJblK4ewsQ7kNvwF3sBfh&_nc_oc=AdmQiyDL7t3Yzg-YY0quMlM2VhxX7SN1_hFeJn4CcnsEYrjcFbGrUzz3nbDNqgz03uc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afty8yRK9oeep7gIQX-67tF5w88dp6KZrWzNbXIFdvTjqw&oe=69A037B8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPEbACk2GiEQ7kNvwEokq5D&_nc_oc=Adl1GlRqdIlAHMx9YWTa-AUwNX-tX8bsfOe-ISJ9Lk5QwBlVj39kM5Uj48igy-3oj0U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsMSoDHmpgS-ctPRas17ETeHUXotz412JWIULhWGOLYiw&oe=69A03D19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGu6JlJD4DAQ7kNvwGJm-Yf&_nc_oc=AdlGhYTqj6tQxRiG6Eaa3Fb5yYnVrt5KfHBs3WveCYxIeut2JBuP_e0D38Yxi4FNPi8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsQbwBwzT_peiZ6eD1ozuLmUDQkr2pxHz1FdzFpqxQIhg&oe=69A02635"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "550679720579565"}, "review_messages": []}]}, "cover_square_image": {"uri": "htt
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNwn_38YHgcQ7kNvwFolZ8-&_nc_oc=AdoqRNBOPimfjaGg_L1FhDllRS1DRX2piv6whnW-_Z4MxC9E2JSnMhWE1uFyFxIutKU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGXupo8CrtdpHe9xrgG3TeHJmFmI1bdspDrMzlCYQKpA&oe=6AAD6064"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E55GcRqZ5zUQ7kNvwF61N8i&_nc_oc=AdoECOV9ZWnDXKQe55o7t3V8a2pM4HwWFpNEsHQCGR72Rz2EoZwkVti-7VF3fnYbf1o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbfd5gFOtiTW4dYAor7Zgn6Q54DvNzo-QO15h_ACDOWw&oe=6AAD5DA8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFh5-2232twQ7kNvwHRunb9&_nc_oc=Adr12Y_4NGDEyrNhCibxLF50Du9dFZFPAknMInk7AvWRrlUG1Smzw08SaJHSCgeZk40&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIM_y7weCwiQvGN_YyqSrglyatb2FFbAS1me7Oo4Cbm8A&oe=6AAD61F8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxiO8JpWblYQ7kNvwFCFY2c&_nc_oc=AdownPat_5tWXz8DL80o2RiV8PvEFXbYcC491S29tRhBms9--Bxrirj8K0l6h_4_rVw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEzFR9kr_nMF2-0EOGI_2tWR8PdQIxSCex8aE28t8mCg&oe=6AAD2F19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l09s8nDoROwQ7kNvwG_OtGM&_nc_oc=AdpqTOxEDRFGanjcQ4fSF9djAtIQ6uJDT-5VV3eD-y-NsOCoN_tPVD4dPLKsv_wW1hY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKe-0bHR9thsChEVH21UGPs2kmIWQIO2PEITOtQ7t1_Yg&oe=6AAD5075"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ou6Z6Bwb5GoQ7kNvwErIIFc&_nc_oc=AdpnkUuJ8qdDj6I-XL3xeWiGjnq7Xt42hOWdZDNAa-j1Ij7DpsIWW7fXcquOcIYm7Rk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAC5vVWEHjtX8VVsjkrwsLeQyTCJXBBUIWyw0xzir_iIQ&oe=6A511764"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdhMALoSyxsQ7kNvwGsiX_V&_nc_oc=Adp-jiD1na3AdShx5lcuGu502ouITOXlP8mnHV5NIC33g-g5R_Zc0uku2-q6gGrqojw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkCTXb6bvVVBbJBg-QqGS9dl3J-yf0WwawitTPMK5yDw&oe=6A5114A8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHrH4Jk0lH0Q7kNvwEg90y6&_nc_oc=AdpFQS1XpHDefRtMaVMcLvs_lQ8Ip7YJQkgwCshLqVJF7wZhTwhNHIe2fL1j3t-tvRI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsCZuR0S_r9QIy80Nnpk4eapRBJsL7EQ4AG6Yf_hiQHg&oe=6A50E0B8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JnvI3rSTwgQ7kNvwGJvn80&_nc_oc=AdqN5CKsJecFl99gJ5jlJRXxiFkTk0GvSyn__j-vo3Frni4Na1F9m76GzAAH6mcQ50w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClcrDjGB3egYg_v2ZufWfEfs39baBzNwwLbcXhe0en-A&oe=6A50E619"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TtVsoWbXFwQ7kNvwEIV6ty&_nc_oc=AdoX4wnKshEKcz5-pT2zDfv64vhhDrD7LBKup6jLHEwsa1RlYE6wiyff4X2T_6McUtc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKygpd5f2l8djlqfdHiMh0aVeVBgrJDQS7w4PTN4zrpQ&oe=6A510775"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
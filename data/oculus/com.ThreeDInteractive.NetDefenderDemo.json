15371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqDlcldIs1YQ7kNvwG9yDNQ&_nc_oc=AdppGJS704HoZ9TzG8pSlvhXtM-usg2txEG-s9aTOh65E4QhVv7AAN-yV7m1TAQts4s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CWNLoDEXBB3IqwVSKl1jOxly2uDAF_2pRjAZhZCMcWw&oe=6A468B64"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bzuW8DME2UQ7kNvwGMBlu_&_nc_oc=Adrc6wcpG5K7MfPjCX9-KKUmX0O9NsyxMwChMMUd9CVCwNpVI54vhSo9U57FL3-_1Qg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qUFQp6vkaypWoN_2uBt1xhysseP6LIshBxa0Z7on21Q&oe=6A4688A8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lPXScutVsEQ7kNvwExBD7Y&_nc_oc=AdoEN-Z6vC6-crHSCOH9pIEQIHBcisAo6KZ_Ed_SJodZUvb0wPAKjN1qqEAlUL9ZqFQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2lLWBjPmAId5Z7VUouK3ZtFt35QikwPcL7fxpX_j5cA&oe=6A468CF8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwVpz0tR8EEQ7kNvwHuT4Ft&_nc_oc=Adr78-M0zZvyWExKJfYcDoxjbD3L1uwCFIKbPWafPDGlnL-vc35V-0rYgLfa-74SySo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9phkfR6UpxacwjRRQlCW-Pn1-JgLGCMv--HHYVp4XwkA&oe=6A465A19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtkxZQCUj-UQ7kNvwG2cwK_&_nc_oc=Adr7gV_Ir0xn7-PE1iMFyBvWzLpO9eW1BKFrkj8rnp1O-NaDmomAezwEa1skhht3ObA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_H5-nV_psQV6MBm1EFRQ3hrUqjNd2FCQPmDKHMmI068g&oe=6A467B75"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["
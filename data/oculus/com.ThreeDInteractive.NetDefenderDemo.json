371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_-VWQOS0qoQ7kNvwGK90xx&_nc_oc=AdpczDz0d3D5ViWwpHm3gM2vU5g1fy4innpqY47ABOCoGiTe0Avj-Ru9_qP69RB70Y8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJoo5reIbUngijB41phrKMHdNVmH-fJVW_Pl4NxZU-bA&oe=6AF5E2E4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPDuW_cdFBYQ7kNvwHH0W6F&_nc_oc=AdpP3F7LrSSsG5KoJGxDlIP78bHYQ-K0c0D3yyPpRx8L2fvD4cn67vZO5cPS3cXQB4g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8J3nrLbNebsWx3vxX63wiHKFnMY-ULBevl-F7fArrrA&oe=6AF5E028"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tR2FVFILDDYQ7kNvwF8LBOk&_nc_oc=AdpnHki4qyWcitFoa6x25D5Tnb98EDLWaSnAyvzn5HyxMRrfDkiJjKSjSSWkHvoYRx8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWVzKza28xguFAmu9Rvag9rNZxoSjxCBNpy08EQiEdYA&oe=6AF5E478"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6iNni-8a5YQ7kNvwFUTauZ&_nc_oc=Ado1adLH6xPvjfB_NSV-krhe10DVuIxhpk3pjN3nKQS7P-D1BT2JtcpHsmIV4F8MlBI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRs3wDGohcZP9nIHO57C7lRWHjGlVTdzMJHUJ-JQ3j40g&oe=6AF5E9D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYHrI4h1kQMQ7kNvwGlZomt&_nc_oc=Adobux552uYBjvPINXB8dIRVUMlRJCvk9MXrtikoXSm-eJ-Un_hYXfxGlXbGSFLTfDc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPxlvS8YvGcc5s-S7R8SFQ2HIGVqy1wSuXT1gXKgUhCg&oe=6AF5D2F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOrBMlqslWgQ7kNvwHXXGTc&_nc_oc=AdphpkjgthuIJakavXYDz8-NF4HEgf0Vh4xdGl4jIFaeTXMp4iw_5T9c8KDygL0MoQI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGY5zGVrmySQle-OSqTUSLF4VgE68b6HUSLHd4nWmyGNw&oe=6A79BDA4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLzOlqxyQXIQ7kNvwEIXNQg&_nc_oc=AdoVgtZwY5wTS9GRta1WPYr0mvvt-y6J3B_CAM7SCJHKezQKL81Lct9YQtfoeNILrpM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXNAmabXYvu1X2-ylvH4pwaIZMzurMSTDEnN8Xt8ZoVA&oe=6A79BAE8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5T-xIIEjvxwQ7kNvwFp9K25&_nc_oc=Adr30fcxzdQ8zvTYntkMsDCqZ_6Hw4EVgcE-pNJ5WXiaa6gp8vRTAA-WUIP2rgvgEIs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpLqY_yHyoGOQwcex-YTCO4QRViiZAdaMtZNkC9Trs_w&oe=6A79BF38"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=des1XB8WPwIQ7kNvwFezpbm&_nc_oc=AdqGQhlQlmO7a6DFxxYZIs_dKo1G1OyEm_9Nngk5nfs1MCypwjsQXiLTSKlX6DbaVuQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF57hzhYOnY2sVCLAiPpelaYdqtQ_Xv5X7iMhehYNyhhw&oe=6A79C499"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sd-J3vjEkMoQ7kNvwHAOjPI&_nc_oc=AdpS_GDME-Vvs13AP_W2zKm6UxVq9TgaRRcuo1ObyiPaTjAzoBjdITg-yxP1oEacO48&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFx_3lE-NjJALjH2Bnkx8ipJrw30WT93UEZImWniKM7VA&oe=6A79E5F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
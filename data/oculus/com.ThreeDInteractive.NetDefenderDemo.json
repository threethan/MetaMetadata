371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97X94yJd_4AQ7kNvwFQjRmA&_nc_oc=AdponAQl57fPiz7Tp_IZ1dcB9U-hRIyT_b53WJ3wBJYpUn3bmjqkE4GisS3YEtt861s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0eEdYGwBqg51L8-0GPPe00WD9ho7du6RaIjss9nvOpg&oe=6A69EBA4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHGi0YXwuskQ7kNvwEB55bM&_nc_oc=AdrC-jEXke5tBmbftWJ7dy87qveUR3bW85OgoICH_MV7NcZ-hHX0e-XxfTLdtX3OX-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpD2WnJCezniWCJrOLVTBHvr2lUiyUVz8EvbJds8F36g&oe=6A69E8E8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1q6I1V7QCsQ7kNvwHnnLM1&_nc_oc=AdoC_fE6qFvI2HyvFkGerrUpAY5zIZHeuxX_Rz7k7xjlt7lbwQjusXPWeS3i4FM7TpE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqgTX5fQYYL11Cskn-grRZpJ7fVGJNANldi7qtLlwnag&oe=6A69ED38"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2pvkSnZxD4Q7kNvwHghW6L&_nc_oc=AdoET49Larv71APL6hO8pZGfhbuVSTy9-4WgXbm-Km1g1v1OSdxlRKe26Bs4DvjJruY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiUxJyuWokbf7PshFpVtXcBcVGohhva2dMX8jfsUIjhQ&oe=6A69F299"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrcSgPKTojYQ7kNvwFNqOfA&_nc_oc=AdoP4zzA7e3x4Tkp_jc5YvXWkgnfr9lEG3eFaHjk0YuD3q2cvRpmbdoPMwf6Q1R0cH8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCo8lkMicJNgNbRKA0EklE1F9KBGLFyoU4WVq26AesYKw&oe=6A6A13F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrzRgq5OYIAQ7kNvwF38Fbe&_nc_oc=Adq-GdYm7ARVj_aB2dw5BCTNySlGp-A6morGoQP8OWItwTUMvQgWT3Vpe-0JC0sNPiA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-u0EgF9g1mxIa03VQq5p_UR52_9ID1HHVyEA7ooAQVFA&oe=6A2595E4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31YUOsZQQUYQ7kNvwGNJmMV&_nc_oc=Adr7mareZ-4WcsjnebHJAqf3seaidiRexFgI0m2Ewg907_ooX8VzRR-88dMtaO8Npuc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sQVL5BsCdhRdmMRHEoX01XIYsQT30JRDxJx7-LY_r5A&oe=6A259328"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A23I7Pe766MQ7kNvwGZxHlb&_nc_oc=AdrVTZf-kc24ISc8nElkTY08lexYAm_o0gr1aK1AEtAsPNpFQMlpYXZei8y_pMFAsnE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rRpYf6yfTBEYs1EAJcRLYxM7WEIXO91nIPTVGyGQFBw&oe=6A259778"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtVYqZgtuisQ7kNvwE0a_2X&_nc_oc=AdoImDAonkuuyeGhK459K_MiSJhEloTENrqRkZ0EtB0RqpDI70adYem5zGdfg7zcQ_8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6ZhQ5WIh9Gz9y-yeyweE-L9FwdNhiJJPWvIKehnkB9A&oe=6A259CD9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vHMFUTAlC8Q7kNvwFOS7eY&_nc_oc=AdrBXvDmtvJDPKpoAzl3L72N1Ow8oYzORr6p3hNAm_VYDRjW1MX2Q-zRgSdWA43nies&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CXO1rQmZYFfiwO2KqD2UDIujdvKieSfP5dQy0DFR98A&oe=6A2585F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
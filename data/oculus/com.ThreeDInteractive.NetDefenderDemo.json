371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbAh1E45VGoQ7kNvwFnERfP&_nc_oc=Adppd4dcaZ61eHPbekdxkb87FpAQtywi4R7sMZFiTo_PJoOFwiRbWiVUY_cYJg7aNJc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxwGajZNzYv-gNEcK5H5BrpZWsfvtiln55BN6X2E3gDgA&oe=69C914A4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DspmXK0w7YoQ7kNvwHh4R98&_nc_oc=AdrkZ2vv74SHx0ypcPja9lRyx09fVu3KE0CFsOuLHkrRQV9VfMTBk2F80PM-2ClR3Rs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgDBVNRCqk-Qf7-v3ET3N4o4rz2HbZuqHMv7FbFVTi6g&oe=69C911E8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAvGNtiBCMIQ7kNvwFgoieE&_nc_oc=Adrj5IZeVK1EgmK7l27wuM5Xa-C24lSf4R1PkZOJ8lqW0CGphtG1fQk_ZJmzf3ALCK0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6yewfs3rMBr2-a-QDTbzhKSoHYCRSGVviFe7m3NoncA&oe=69C91638"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSsGR6baBqAQ7kNvwGhF7k1&_nc_oc=AdoyDve9_hVyyohK8UvAsovdSVc_PUVtA1jksSwZefGqjteZhMhrqpGypYFic6YI5-A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhO8nb1kjt45lhCsLMJ1eLWlKdo4knhgFR4emsR87_ng&oe=69C91B99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwmMJ-wzpX4Q7kNvwHXKrdw&_nc_oc=AdpKG9_uEFwzM0cs0doS8NFIceFPQuUt0ACDtq6_m78RQM7lTMHu6lenj-ZCForPXjk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxn_EH0r14yl8t088luOzzZWmdv_UZHqhzZqFh_pND1DA&oe=69C904B5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-rQS7TYrQsQ7kNvwE7B0jg&_nc_oc=AdpQB_h3EXJRam8Rr03Gw87LjkG3Ul5jvWbMZDacIQD9PiTZ8EjYZxoT7vqOw1b9VSM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OjgtqKhApfJ3ZHb7YVP9pN47go8OSiyX5e5D_7ho4ag&oe=69E8B8A4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-pjih-NhzoQ7kNvwEmhL2c&_nc_oc=AdqO8_VKUxuEgtgN-RVZFV4V8HaqSxwozKaaAwtRzggOLYPEep0gyXfs7vHbxxuVOPQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RoEsaRuk27V8CY3wFP6PDnz2VzzV8rx_whbmUYbVnXQ&oe=69E8B5E8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yt8S-QIRGUQ7kNvwGUbmaj&_nc_oc=AdpsVyotROQo3FQn0657H0Ij3596c7QU0A7JHDGQ-IYkyWiSeWl1g4jbPpAy5cDIscE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ij1vXuJGjb04FV2upQUatK_VgLgXw1FYt_KPwEYpu8A&oe=69E8BA38"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TKQ7EFTEh8Q7kNvwFYNScs&_nc_oc=Ado8aAwYYcz6t8asrvxolfmhVWggr2L2UXKikJT3HktzcQMg9ZmTVQKSzu34qPHrfKo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NCqUqpzdKwYev4mRHmKLXTMkpk9kYJoA9MQ4WCiTHdA&oe=69E8BF99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cqqk_xqWISUQ7kNvwHPd5NZ&_nc_oc=AdrkYlFmOB_OxuwFhcjs5CYhkpG1pVe2eoTInPTuTlFDJKtyB0vQpPKlB9jkuj6N0h8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ip8qhwh8ZL1cEBAEPA8Covpz-e8dycsJZHOyQQLKl_g&oe=69E8E0F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
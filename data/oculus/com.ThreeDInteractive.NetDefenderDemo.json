15371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iydZHQMlk_0Q7kNvwGIBx0P&_nc_oc=AdoC1M6dG2-CM-BqPHQlVeXRR0CYfhWa5cXPDpqg7blcmDG44NwFFlXyHuQwBuvl7dE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXtBoEOAgHa18M-AWaQhPQ61q9izg5pgBRb6fU7R1Big&oe=6AA96BE4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Zgx4bSnjbcQ7kNvwGVlGuZ&_nc_oc=AdrhNvL1phMalnnjhJHY01QaUIqE28OwoP_TDp19mDK6SY6YB3E0zUDXNUMQgP2f9i0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgApjWoHqV1TDEog88qvrBY-RtPK5FWUi70iILHsXxEQ&oe=6AA96928"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmdJK2g_7-UQ7kNvwGrbfBS&_nc_oc=AdqP5CQL8A9mqrCnHTm2XiRtEtzizdNEbuVZros0V10ewxnpAexhPXS35j_-EyP5Ozs&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9rvj9Zey2R8nvlBh854WBcrDQzEwzFUsSZsI9oLBcvw&oe=6AA93538"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOIwWBacmx8Q7kNvwHU98aC&_nc_oc=Adr8_MbmuHbn2bhzk8UssDp9c1B0bZyRzW5qO0DdNPbzcJDuuSp8HpJ98GETpXa62yg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKssMDGYIuxf4npUy4LXMKrXBDjg5XTrzNmjFS8oFrgQQ&oe=6AA93A99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufzPIxWuLRAQ7kNvwFtPJgg&_nc_oc=AdoHBbhzRC5DBs2DkJJprA_kJOCIpCLEt5Wo7PRfB_4bZ_N8a8sCp6Q0qDAT4rHVFRA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBisr5bf6qdtApKyQbYQVkvagMNIfSpgqRzCVIjmK4AA&oe=6AA95BF5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHpzQAO47RQQ7kNvwHhZUlL&_nc_oc=AdryiKay_j8ZxJKaGFTt9xWytQGTPI102b4dOmNac1t0wP9heHp1zxv6kvLOJMutnB4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-J4Z19LH5jGwyC4IXkihW9534iFNOjyjWd-ur3KxPFfA&oe=6A3021E4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjkzUIbemL4Q7kNvwFSXqQy&_nc_oc=AdrGctolzz8XjJ-vicixO5nz5YRXW68xTyPVWjpz85ssfYT-3wdC0puicaFFolH3mcs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dvFXBVYfBIVneuRmfTuqJ3idtL5MS9cJlJpWQesYgSg&oe=6A301F28"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgYPWm7ZQDkQ7kNvwEACcCn&_nc_oc=AdrkCabhpW-vpO6YdUwxSH32AiuU3t3qYfd2rcHC6HaX5aBjIkmH7sW9bPaSJheBUzA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6rVR7clpcPYbl2xH3HpWwjLQvj3X7vEBVy6uGFulawQ&oe=6A302378"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uK2SOvUhneUQ7kNvwHZv8OR&_nc_oc=AdoX0OmEMVx2Q3XDzzOEjDfpHEoafm4ESzzcy7UuRoltsZGgM17LH2kZOfXA_nARm7M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_e3YzRKcE8Qe4ZsmEu8ftSx8hSb1qgxNO7teCEEcuOHw&oe=6A3028D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbnaG1xHrrEQ7kNvwEOVGgP&_nc_oc=AdonT2znG9XImbRUg652sImKe-kXDHIc-KXpjTn5HccTTzTRHajzYANc0SvamYOTP50&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iAyYK75GHyPTTxFUBHkaJt6-BBixTWudT6TN8MalSLQ&oe=6A3011F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
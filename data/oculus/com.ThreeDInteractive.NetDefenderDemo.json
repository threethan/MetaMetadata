371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjUWomsBMhgQ7kNvwHIfIEn&_nc_oc=Adqq8kHNgafjpMyjL0AmXozwqysL5D-Nxm8Lnx2_ISixByOK4OeDBeuhkuLnnopK7Zo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA83VFejV4hbjbnSLuNne8baZ7oYeOhsNfvLhnzNA_OWQ&oe=6A5776A4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmTh-Byf9gwQ7kNvwHpsieA&_nc_oc=Adr6ZMIzD6m84qlMnKlqAX1v7E5MuuxSqaznDkHw2m-BDKrWNI245APuQJy08r0Cmc8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2T-Vd75-pQkSGMHcO_IgKI8L7npiLcTuG9FAmONCyVg&oe=6A5773E8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BW8SLamyL4cQ7kNvwEEWD0B&_nc_oc=Adp_KSPCOiiGzJN4yxOcuCwAgPD27I7zoKuTOaEA44oe3vATwQkm-gCQeNHV27MxMYs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5thJun3Q5jx2JOVwf7JFREGctsd7DgnCOnEnr8wGEGA&oe=6A577838"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkrwFGtGdpMQ7kNvwFz50Jl&_nc_oc=AdrCcp4ChxOenhrAhh49fz7vSb_yLmj1CmkX_C9aqRrIqBY2kmiWSWIJKRquEq8bO44&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsjDBRiVJ-7zepoNqO-Gcu2vFIw2oKwwRNUDAlTaXtqw&oe=6A577D99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skCc5Uv3uAcQ7kNvwHerCLC&_nc_oc=AdrCGoE5gQQTDC1bncKqP77Ii_UkD2rrGNxM78JzPuE5BbSmTA4FIeHIOBj-2HxTOh8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0P2YkcEUkBIcLWEkmU5Gzgb9Ew34C7dRCR2rwKaYLtg&oe=6A579EF5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
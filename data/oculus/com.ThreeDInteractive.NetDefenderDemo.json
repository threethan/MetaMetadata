371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EoUArJE8J8Q7kNvwEG1uwx&_nc_oc=Adots2IUoqMMkZHQK4I-IVMWLUsUzTIrW9Z6k7ytQi56xjOb3TOt68QSdfGE32jDBiI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-Fs7l9ItvX3Kt2i5Kk9T2OxZEvDXIfbZzW2dDLBYUxQ&oe=69D0FDA4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqbAi2f8vK4Q7kNvwEluECQ&_nc_oc=AdoI1f-1t27SR0iXXMEJ5LHMCcXf3VR5VNJto8L3gabn1iPmLVszO_1RaYsigBBw5Mg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwonXtRfatmzH6BvxoeJn7uEu0IiXvMjkKIkLRW_xccMg&oe=69D0FAE8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Wqq4t7_e4UQ7kNvwF36KGq&_nc_oc=AdrCFTJZ5pTFvAOQgj19bV7PMxod2DKfM4wNyu6ZlvN9elxtUzWYI2PquOp3bLf6HG4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIPQFbkpDfFct4Mq3uPIkdX1JsloTSNNYJRAZ-QVOAqQ&oe=69D0FF38"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ff5N-DPJQkMQ7kNvwEIrx0o&_nc_oc=AdrkiahVeoOLGpjoCD6aGSXP7-FSLcHRfzfrLAsIhrl7LZzknWBy5SZLDIDjhZex0Js&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw6pz3nmHUWW4zJHNfofxTqBiBc9yJ-KwQTEzVLCwmpLQ&oe=69D10499"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68I7KBHlVv0Q7kNvwGRUNXM&_nc_oc=AdrANxXw19H0BRmZ4Ehqtc95e10_JJZUZ0of4moHfQc0jwb1k53uIDl7fwfXbL4XGRs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTbNPt1zPyuC0TAangCszdM2tYisb4I2eZzR1XEhWsLw&oe=69D0EDB5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
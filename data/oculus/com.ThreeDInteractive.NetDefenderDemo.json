371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsTpo-gE95AQ7kNvwH6bmdL&_nc_oc=AdqBYgGeECLq3aPPTgRC3ghv2uXJSF5nJviSKlfGNhgMibQTP4yROiLoRZ310vhK3IQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0l9GkvXBfxdRWR5BnluX7iBSaMd9nLdyMTVdQuBVWTsw&oe=69F88AA4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cED-gYuf7vkQ7kNvwFEoxe7&_nc_oc=AdrRhr00Ab-Wztewf5gRCXB7Zo9UNXZU2X0fhH2W0XdLnPXlMQWdJppdHVSLmXlj2_Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2jbJoc5Bk1o-g1x61yhUY8xfswUhywrn39nwCnrSlB4A&oe=69F8C028"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUDIa1RR2vEQ7kNvwG6cGzg&_nc_oc=Adrw-midokgYOZhwwtTku2SAgf9p6z3Ic2Y1eGIetuHU_Ajx6YFyL5UynewxoXdQPn4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2WnASwHbO_Em2vk4FQs8s5QehMgQ5G7wpoDnFRBGohVg&oe=69F88C38"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECVZgBAPogYQ7kNvwHZ_zhQ&_nc_oc=AdqukmVLmzLVIOD1Y37L-cDKgWArulp9ZlsqRj-RvKgkupSjgrIPFUiNpEbKH_Sfk5U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0McfeyBbzEVKq_TMCA-ABOqlkhUl0_MKaKjzaxzksk0w&oe=69F89199"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNKtkIk-6OAQ7kNvwGH5ru5&_nc_oc=Adp8nHcrcOUdwUNuleawbIr3_HWlTGmY7SAuRrnGqVogoLwqdP2AmI_poBmXQIjLcBo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3BDUOdlI0l9NYrJiN8RQYzTjP7tLZqMV9RdFxuorfbQQ&oe=69F8B2F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
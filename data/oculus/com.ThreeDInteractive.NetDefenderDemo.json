371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EoUArJE8J8Q7kNvwHHqJu6&_nc_oc=AdrG9qLv7ywAP9Fe1x_P-UsD9awHX35bpuG7ATig8am9PCvE-Z9SL6wfTRKPjnCk3nI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx5-AFr3XehjatPYFuUrTI_Qcs3KzpuZufIvadTzGQtrQ&oe=69CE5AA4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqbAi2f8vK4Q7kNvwEkEsqE&_nc_oc=AdofXqbAzr5_5npfEMZCsUFGtlqfg8AxjpQH04hPOyZ5aduvcDXWh7nYDGvQ07PB0mw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyRGFZzEC27A3fK3o96gIWvh43PmusULiA7pB-9Yxmw7Q&oe=69CE57E8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Wqq4t7_e4UQ7kNvwHAYJEo&_nc_oc=Adq3wduGwdWnw-e4npTfTxK6xFpSSwGI5ZY1KeXBK_P2bnqZEHg4H1a5oFbJpkJsTFU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQcnnoupG2KwtIoUl3wvTtvMunfRvYWF23Lwd6MpdGPg&oe=69CE5C38"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ff5N-DPJQkMQ7kNvwE2D1Hm&_nc_oc=AdpPhW3pSyhOxSF_1-BEDlrr5pDMwnShEIYTcdm9MIXkihnNBCANY_LgwyyBhVoXg_8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzTy45k6Uk06GK9Hihr-tvSBE1ebwDebOryikGtP5MTaA&oe=69CE6199"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbmC7NJ-eHwQ7kNvwGWbSAL&_nc_oc=Adq1AYWHIYkkxWUuUSMntTeCXGrnTGtqcRLrWO3doPLm0gEz37TaleFI1yAsLO2SXQw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwgK2hkPvKQwyURXRp02PEXpJVBqsHZ4mGYwg4QITsqLQ&oe=69CE82F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
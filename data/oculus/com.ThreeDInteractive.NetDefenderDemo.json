371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gc-UFI1AKCAQ7kNvwEYobfz&_nc_oc=AdrCzBFMqnZwPhOjCdjLqxxHOwwJFwgR-UhhjsgmECzw9rhlUL8LK_xH3dL1_5R-SeA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0S8Yytv5tn-IZDcNdgxno-GnTBv9BnQXDjpEtl0cmQ3A&oe=69EF5024"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Duycdg7sJtEQ7kNvwFMjv1y&_nc_oc=AdoAzgk-0p5DFHe8SkwV7-tHBIJfHrEZ-FcRL2oPp1pNo-_OU4UWjm-c5m26E127Z_U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2jyRaH4JlrJsTCpWBozx4kS27JZjwCVn6sS7zXtcmq4Q&oe=69EF4D68"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haKuA8L7QMUQ7kNvwHC2zly&_nc_oc=AdrcDqL4ZRGhqS7xRH0zl907AU_VcvWzHb0tkX_DjZ_FsaZNnb1d_tNXV_AW3GvTBTw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1AT06sjuaJDiLJxijO1Amrlo7FrLTE3AT5kLX_fdEl4Q&oe=69EF51B8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbaL5ZIHS9gQ7kNvwHKg1bo&_nc_oc=Adptrl9SWUft0pt40jX6zouCv7lFDQvjFqIyjg0CiHsw-2mVNEw4-f-FfDS36VlKRYE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0PzNesFYLP0V64slwlgT_MUxVsVOsOBJ0h85KdR6Os4A&oe=69EF5719"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChHymK33aPkQ7kNvwG704ud&_nc_oc=AdqXvDwBqXRBOKkCrPX3JfrlVZHMiTkvX2KMxu4hDPewsSmTLKQEBACGyX3dHtZa07E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af37ic-ciGgf4LRD3A6vvs8iQr_C91oZzUyvv9yXdAaNXQ&oe=69EF7875"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
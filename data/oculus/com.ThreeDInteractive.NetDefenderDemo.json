371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tolFUveqENIQ7kNvwE3143w&_nc_oc=Ado5puh7v3riQtrlG2wrQXrEvxLpZHCE1Y9ZGJlENDkXfbz4tgCieKa6eZxsl8vrmQA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH1NrNCM0A5-NBzrnC1pgTaVMLhcpgW2l0RGLeEkAUCg&oe=6A64A5A4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUVLbMEJWIUQ7kNvwErU7PA&_nc_oc=AdrQo9WEfnuWiO1s0l5JMlW2yYBjct06C8exKh8J_huJYRH-FZ2dijM3lB4L5wyWbQM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZMrpmyfHTXDNA0IQwxaMZJRfTTWO9K_2vi47CpFvU4w&oe=6A64A2E8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_0NYc4CTLwQ7kNvwE2m0FW&_nc_oc=AdpVk7eujV09q7V15tiSJMN9SAQRQQZ3f3b1tJlt5VfqnLq8iMnz-Zxgh4cAJ7kFsVI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAb7GfkKFM3U2DDRmujDrWHk1mYl3KcNAPP9BWvXfJ95Q&oe=6A64A738"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qf1zyyH0dZoQ7kNvwFpT1hd&_nc_oc=Ado4vqUbItfEf7yhqOfySb3VJBbYVWcVK2JoMUF8q5ILpI-qds1IIqWDHI4TYcCV_fw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDL72HYkgZVQexA2GcwpvcAfZxvTSYiMXfr9FKLjQVyKQ&oe=6A64AC99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_Z6fWUSseEQ7kNvwFh_yIg&_nc_oc=Adp_ovd0RZtBOE5q5QYf6mIh80HpG_d5CM62W_M8-PBWRlC1J2xPg5lIjBrZr6l1K6M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUELLwaoOVFaC8dKKfXjctRlJkgTnmP18QJ8qopqKFhQ&oe=6A64CDF5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
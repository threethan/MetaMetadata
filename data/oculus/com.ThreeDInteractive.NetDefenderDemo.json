371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5c_8crBxW9sQ7kNvwExIEuH&_nc_oc=AdrSDQjUs8SdVKWUDGVtFJvA_0RiUmt3qzXZEGLFYF145F89PZBbZN3DvGhNXqpXywo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3d9a2T8rqnrHWHGTY9N0ElQtfCxfwbGPqqUaUeWWAqcQ&oe=69DB89A4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUvnfVT20x8Q7kNvwGcoThr&_nc_oc=AdrQHxzQVf2DFyEWAVaefxeQL2kaANEOD88eXz4QPSD4aChh6oGZvhqhWiIuKwdEQ9U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Awkad98bNyf2M9KTlvNR6T7sq9zdPSrk6URSz5U4nDg&oe=69DB86E8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJ7jA766EggQ7kNvwEmNs8r&_nc_oc=Adq-NMQgmJDWk952iJlQLlIJxbOhDsWAzFrOWDnlbJY21HHgdkEupB_1AxTPatkmkRI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ipx0G3ZIzexQKtEuDc2FBkp6YDP6bNe-dfPHiiON-gw&oe=69DB8B38"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEs9MTpaY9sQ7kNvwF9yuSb&_nc_oc=AdrxvdIxO-g-tw1LF98INeImFRkf_YjCkpj6AcO9lQQBBfk_VcKuYPT7unQryZr6ViU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LSx4J_Inpa0xsFQ8uhZTavvGadgYRMldXO3kiRcXqbQ&oe=69DB9099"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fR2mVoHKptYQ7kNvwG2zKGn&_nc_oc=AdpFl4JJcx0SITuyEY9GiE-xR1jeV_r7OU-uHSYWb2unFCj5SEAFkyT315GMPTQahaU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uV_wKFr7W5WFTp5Gr8zaVPPZZMv6pvf6hgG5YqbxxPQ&oe=69DBB1F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
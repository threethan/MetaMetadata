371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=192mHSWVTH4Q7kNvwF5FYAj&_nc_oc=Adpt44yLokZdhiP2hZWQotQT9yJnA3_0deVYPKbaj_yBjNOeBtrwZ3DzSQsaLprOLfc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KGP0Nz3JW_erFGPbq9i7W-d4cZpN_8ZEAsMYKBwAI5Q&oe=69E22124"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPuLmrZw0ksQ7kNvwFl0HkW&_nc_oc=AdpWYZIeu4aJj8CsVedYGtwj-7FbQvD5UkfASMhwNY3UDrgHKUkkCY_LVMAknNVjknw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3s2imWaF0P1NlUImMGfZ65cPnJW2CAeTbcSmznA1u6XQ&oe=69E21E68"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imOXzl19_OsQ7kNvwEtMl7T&_nc_oc=AdqexQ2wECRStnzQxXuNvoFv8tnBOiSIL3jtrKmadZzJ3kYHurrekNzDCZf5gC5gbpo&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2i4wvu3UBvE_q5yYKEGA7Ife7dxSFsoIJdGJmEA0MqUw&oe=69E222B8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSyKlTwuUf0Q7kNvwGnuRLU&_nc_oc=AdpXCJtYGPlDCex1WewCYp93kICSBb9nNS58CAHzB42AD8zoiYTwlQamsrx705iBsNk&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_5q7M-y_a91L5UfcuWbAEhyZ_ViSpsRZZ9zMWTNy8pg&oe=69E22819"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fF7p3CJg5_cQ7kNvwElXSGc&_nc_oc=Adrin9TuKxXou8xhEXIVlKr2zy7KxPe-0uy80J3W4Z--yt0LMuzsWf0D_VWDG5ohIW8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af050qM89L0M5QFq4KicUL_FK7zh32iBaheSIzYljhYRVQ&oe=69E24975"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmVrupnEyyIQ7kNvwGun0Wi&_nc_oc=AdonhzCAwJ-aYDxKT2tSJyIZ_hDxUqzOHO7VvrGJTv8Ppdek_LU9T07SjMNkqzLUy2I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHC3XEzJn3i7tRyINFuOtrQj_fpIBsH4cxpHKeQX8dYVw&oe=6A708324"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UO_kd2kENq8Q7kNvwHJP8sv&_nc_oc=Adq2u8KzBLXmGTrCj8ONkA5fRDmVCjZn7qfBOebWdbtAL0P5ruRBz-XpLlNPJhtbxFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHrjATVHFZdeDF1IVw8DPx2b_y1pVq8PqL1o3Kxsc6ng&oe=6A708068"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dfe26N2F7TkQ7kNvwFtkZfZ&_nc_oc=Adoiezn_Cu921mzoCOgRRP3dT7PM_7yaj3mlRMtXNilzHl2Qb_G90DHhmhy4ID1q2fc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFN8EZkxiUHAnmP4964AWEIx10fMRVwP7TpseOCJDiKtA&oe=6A7084B8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JvAGM1LExEQ7kNvwF3uMFR&_nc_oc=AdrUf2qHt3038AqiDEp177weIBpEqaRO74RFVwU3tW3gEZ532xm1WTHp9UTc4C5_rj8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEK2hRsnix9fSuNVt06egI9qnbrHe_9499HqsidnNWl4w&oe=6A708A19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVTElt4iYcIQ7kNvwGDkWnj&_nc_oc=Ado9Si_rBaS48kcgAxfUhVwTWq2Tuq7OpVk6YpxMgY67SmJ8RgmVt7JCMbOz8ousROw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmLsQCRZ4gINla5Mn01BaGOSzYRPx3WotlNgXjZFFHpQ&oe=6A707335"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
15371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNwn_38YHgcQ7kNvwHhk5mP&_nc_oc=Adqy7ol-2bcECu7sJfxjqmcttB8RUwf47TchK2wYbAD6AtA7QN2PDmb7Owmv_zsZo3w&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINy21xeov9B77l1mRZs2a62Ta5DO9kxkyJd5DK_bcTBg&oe=6AAEB1E4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E55GcRqZ5zUQ7kNvwEWqPu_&_nc_oc=AdquxvfrdzhUj9kOF-VKqLHlwJkPUDaBZ8kJ7w0Eb2lFSoxWzUYUf9PJ7_VX3i_qnwA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvo_1r0xO4UkVkSNT3puazdJsQ1qDnszHeR_jswviqWw&oe=6AAEAF28"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFh5-2232twQ7kNvwFe9Bqf&_nc_oc=Ado_ZDRtpRxc2bj8oD9AWDd3_wWIv4XTC3owQ2Vf4DQ9ADLAxG9IUx9mE273d8LGrzc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuOOezEvxKd1Q3SX10ggSmookIyEZ8-ch4E8tJOS5JjA&oe=6AAEB378"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxiO8JpWblYQ7kNvwEz-o_8&_nc_oc=Adqfs2CpEuljQmRdJzG5SU6ebRVbColLA3zkVlRZ06n2IwNfpARimBZUWT2O631WtXc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ07eU05OoCeAv-u6iEcLQ-5-TTquMtj6MHNeYPycTu2w&oe=6AAE8099"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l09s8nDoROwQ7kNvwHcFGi_&_nc_oc=AdpxOfdhgiyDfrvKH4sTuohNNiREph62bjSA52BFpy-iNE_7RGwhHe9HzQiLfhfjVGM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmmWWqMHG8-PqzwilgDoGF-dH6TlZIUBxTEQcLloEv5Q&oe=6AAEA1F5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["
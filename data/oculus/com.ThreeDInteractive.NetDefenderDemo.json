371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Qv7xwoPEhMQ7kNvwG4qxe9&_nc_oc=AdoEyaKMm75AsIR_r22jgafMp0ZEZMVZoRI6_nfPmN_2knuyhbL4_QVY1qpj8rHLgsA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTeohfVqrHVcm0B-xskcO-qWnLRAFsBCNwKq8rIBEd2w&oe=6A95DDA4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Ti_YocrangQ7kNvwH0fybq&_nc_oc=Ado0XRFRzfJTmglodOn-PdLeXV5sNS1mwH1kIVrtY4KuGO0Fw8QwmZLt749KtN0dCC4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIeKcNasHcCEJiwO15B_JsGq0FPnr_oJJGd2KbdMtnWA&oe=6A95DAE8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4AdW_pfCIYQ7kNvwGDRlhZ&_nc_oc=AdryZLNY9LeCAcEnraKUGfHejDqx6ac9EovZNXEEys2wqRkQId9S4nYmEhZF1LZK7ck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgP8DE4M7Vjm4UjyCgZ22Cbbn0v8ewY-P6NKHGbm-_Aw&oe=6A95DF38"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3n274OosuIQ7kNvwEy-XAk&_nc_oc=AdoVMEehN2VwnPscT3FDRL2_rKWP5WYV7jIhldHrc5qcYHjafqfiPmBJ6KVa_UFEB_o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSXnSoi43YlQdi5r23w_npnsUwG13rWgo2-cpncYIwQg&oe=6A95E499"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yy-8agU8hukQ7kNvwHvgR_U&_nc_oc=AdoX5xW5F4u1IuALzNAHDBETFYiEyAHtbpHtxMGarpEZxm7pLBm1AMcel1Bi8taJkQs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE59qRI-ZzR-wRDHo7CiA9M_x5voso2ISqD07ERWPFruA&oe=6A95CDB5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
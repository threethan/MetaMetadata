c_sid=6e7a0a&_nc_ohc=TA6LfCzzYtcQ7kNvwEoEQno&_nc_oc=AdntLZEo4CFSNWY8WuFO-w5K6d8bifi0hiDKJ3upeE6f147iUVcn11gK0VGtd4M6ERY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwcV1CS4mS5VOAwesA-BJ0DxRLbmBy95dzJTHGLzy0cYg&oe=69AC13A4"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aUdoeiNSt4Q7kNvwEYQmEq&_nc_oc=AdlVnDOjOTWvSx1i61isRJUo-U-nVhpZtpOcbOwsQqVUNOBmZ9NCkjAI-abY02cycBM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy751rth_-aIYSDMRFRApf6AJJY5T1825letrpA4dO3aQ&oe=69AC10E8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1S5CnBWTwz4Q7kNvwFUHYwN&_nc_oc=Adn30BGtNyqPO2IjxkrLioKJeOmjx0621J--R3m0iT5AsNz5VN_xzKlL4zrjcHQrZNE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxYCMDkz4d2xthCsG3MpKovPO0A0i2ELc6wTBtP4PI1_g&oe=69AC1538"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKra0vtWL04Q7kNvwHfgQ4r&_nc_oc=Adnc7mbzKYnDBhOXL_Xv1W96ISH-RTpmXgRy_T5thEiCoozlSgZrBWHjXkE4E656TrQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwlzMXFquawC7VxInEFaY7xfsxYJN6Sy25xQT1fsJNafg&oe=69AC1A99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkDWBvLLTLMQ7kNvwHaSbZ0&_nc_oc=Adm_cirtUuljenzuxSi4WKAnyE_fTdWmfOJ2D104j0dDEc_Bt4_4NUpEHIBoxSXV_p0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyDNKJB9BmSx8rrxxkR8IKamboKF0oBbaa7ayCD73XjVA&oe=69AC03B5"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_intera
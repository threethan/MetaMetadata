371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iydZHQMlk_0Q7kNvwFkuOGX&_nc_oc=AdpnWgvOM6QhtTUrwmUwVIv9NYmnLr7VS2riPU_-p2kc-2BgqOsWow8NRCt1rfI4IHg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAW4lGtOysCOcAuc_QgJBPBVOUbVLwfag6AX8aepj5iA&oe=6AAABD64"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Zgx4bSnjbcQ7kNvwE5_YAv&_nc_oc=AdqG9V6ur_Y-cUkSXfg6K31cp59J5Jg7J2qQ4LoB3FJUfzITshtjGcir_doxjrbVYm4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxe8Bn0zzMLBjyKFaiUcUiHPaISN7PCYUO4V7wPjNm7A&oe=6AAABAA8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmdJK2g_7-UQ7kNvwG3sN74&_nc_oc=AdoLI9Ifcnpy7TMiYR8-prO_TCuTTA9ib_nJ0JqwsgRUM4HvJ6dTFv1wfRQYe9icD90&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfE6EE9oPs97Ifsl3jk6560k2kbzimrguaZ64SPNp8Xg&oe=6AAA86B8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOIwWBacmx8Q7kNvwH6CE1f&_nc_oc=AdranDcRqq5UIZ2DR-w1JRlRtGmqaQ8MWXTzfZ_VLjTE3V4yZAllX1i9jhQMtnesnOY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6JJEghQcrhKucfZZe9j9prWkkZK9EYZNwkoYv62zvaA&oe=6AAA8C19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufzPIxWuLRAQ7kNvwFjdEsE&_nc_oc=Adrdv78m7Vcm3rKzFxL0l9Bpvf7bc8tTGaDzfe6Q5PMUygFjx7LehpyKApJa0blk26I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQODG_mxq8FqIG1Lnb70PFdYsP88Yn9YwqSbOY_TKmww&oe=6AAAAD75"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
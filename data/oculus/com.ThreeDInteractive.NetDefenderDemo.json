371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHJYg8SG8H8Q7kNvwFlYSKB&_nc_oc=Adq_WdrC-97vSFGzHLYjmdEdA3hkHvt9aDvy86zcvkAjKNCrPYpu3GqIKHa1ioXiQ6Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5u0ZaTNajgGPZKxOBbbXQFZxoK66kjNvCFnBeXX3ZDyQ&oe=6A0F2C64"}, {"file_name": "screen05.png", "id": "273606838535747", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982520_273606845202413_3747487335204756098_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuDvX0M9RMwQ7kNvwFSjxat&_nc_oc=AdqLYRnm9Iq3vOmHBEO37BymhJ7yTYEqToRA5E-yjIICr5jutUUI_cLDv6B2kKFTt98&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tm094bDSYqINlNMSrCM4emxExX5maZExYZdRnBY7Sew&oe=6A0F29A8"}, {"file_name": "screen04.png", "id": "1290315141560320", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982671_1290315144893653_8191286936635200178_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dN5q7_TPlD0Q7kNvwFwIWgn&_nc_oc=AdqRXfTuWRZQ27Jc1XrbVd3JENL33PLuvddJ2EtCRHnH4-exLWF8qkWJHSQnHx15JlQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pNRNzHIQ47-ZaW3DqzJ7ZNx5tifbc23c8zlHGUS6Jew&oe=6A0EF5B8"}, {"file_name": "screen03.png", "id": "235186542440136", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982602_235186552440135_4391174359956842933_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXi4LT6NMJYQ7kNvwG3Br6l&_nc_oc=AdrEhCzT1G8k46qrT-t5VnccC4NZuDu7iAxZKlgDxfEigLbYPCL-O-1u2MVeDbh_ftk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NF0yCKSqQcKgKnxDQkrNLPY4kSTiXmrlvN0mNQhsVQA&oe=6A0EFB19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "3449511735294389", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75303835_3449511738627722_5077755577529444772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsWp8M4M4JsQ7kNvwEur0tK&_nc_oc=Adrpiy_kgzfxLKU06RdI_dYIExNMdZA-WYhJ_8JlVIurQmfZEJp8yKN6alSRkuDtSDs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DVf-_3To5H2QH7xzAA0IEAuiDlgo_w0EkzQ5vebRFwg&oe=6A0F1C75"}, "display_name": "Net Defender Demo", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. This is only a demo version of the game, which gives you a taste of the gameplay and the graphics. The full version will have more modes. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
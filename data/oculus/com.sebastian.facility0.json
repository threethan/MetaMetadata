luscdn.com&_nc_ss=7f20f&oh=00_AQP6raQreiJA_ApNHJUfBZslUwtVhZYPW6XzpR_Y_6-w6w&oe=6ACE5488"}, {"file_name": "New Project (4).png", "id": "2146941276127147", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296209_2146941279460480_2133554448839776512_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYfx6Nnhug0Q7kNvwEAHBNg&_nc_oc=AdrLenDAyzoKmLamg_eHcK7MYFCn_cvCnCT0inYpoqHxl9oBOrRnwWj_EANvdz2cluU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUi05pDtQuvUGaGIznQxY8K8zmrMYF0pN0BdVmVFINyA&oe=6ACE656D"}, {"file_name": "rrrrrrr.png", "id": "1447145729879787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298248_1447145733213120_7484327941127114067_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ew1CK3vZgiUQ7kNvwE8v-tj&_nc_oc=AdomuCf1vOayqDG0yRhBcnTeDngKXNfscwMjDxPfP56Se3T_85zMICvfe1VuBGeXMlk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkAWNDxWZoYSLs00zyoFmsxKufpryF1nP_3H2sQi2FFA&oe=6ACE5C18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Facility 0", "keywords": ["Gorilla", "Tag", "Lethal", "Ape", "Free"], "long_description": "Facility 0 is a tense multiplayer horror experience inspired by the chaotic energy of Lethal Ape. Set within a mysterious, abandoned underground complex, players are sent into the facility with one goal: survive and make it out with whatever they can carry.\n\nExplore dark corridors, hidden rooms, and unpredictable environments filled with eerie sounds and constant danger. The facility is not empty. Unknown entities roam its halls, reacting to movement, sound, and player behavior. Every encounter can quickly turn into a fight for survival.\n\nPlay solo or with others as you scavenge for valuable resources, tools, and clues that hint at the true purpose of Facility 0. Cooperation can increase your chances of survival, but panic and poor communication can just as easily lead to disaster.\n\nEach run offers a different experience with changing layouts, dynamic threats, and emergent moments that keep players on edge. Whether you choose to move carefully or take risks for better rewards, every decision matters.\n\nFacility 0 focuses on atmosphere, unpredictability, and player-driven tension, creating a horror experience where no two runs feel the same and survival is never guaranteed.", "short_description": "Facility 0 is a tense multiplayer horror experience inspired by the chaotic energy of Lethal Ape. Explore a mysterious, abandoned complex filled with unpredictable threats and eerie encounters. Work together or go alone as you scavenge resources, avoid hostile entities, and uncover the secrets hidden deep within the facility. Every run is different, and survival is never guaranteed."}]}, "developer_name": "sbstn", "developer_privacy_policy_url": "https://sites.google.com/view/facility0/home", "developer_terms_of_service_url": "https://sites.google.com/view/facility0/home", "publisher_name": "Sebastian", "support_website_url": null, "website_url": "https://sites.google.com/view/facility0/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26058171253861529"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/646443466_853193664460734_299465941084353
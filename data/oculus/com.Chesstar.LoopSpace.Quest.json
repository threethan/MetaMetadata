25c6 Long-term play makes exercise no more boring and also achieve the goal of weight loss at the same time", "short_description": "LoopSpace is a VR music action game with a strong sense of rhythm, allowing players to deeply feel color dynamic effects and fierce percussion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chesstar.com/privacyen", "developer_terms_of_service_url": null, "publisher_name": "Chesstar Studios", "support_website_url": null, "website_url": "http://www.chesstar.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "364392501778145"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "472873047130500"}]}, "baseline_offer": {"id": "472873047130500"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1621266780, "status": "PUBLISHED", "id": "472873047130500"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3765102606931062", "version": "0.9.3"}, "id": "2838722739720098", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3761176703990319", "is_concept": false, "latest_released_binary": {"__typename": "Andr
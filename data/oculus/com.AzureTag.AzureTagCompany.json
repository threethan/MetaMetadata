file_name": "Screenshot3FIX.png", "id": "1880451963349807", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818900_1880451966683140_7079409921534762042_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3rHjFjbeacQ7kNvwGGG5lx&_nc_oc=AdrDIGgF8RXj6bwt_BJzTwU_clT92AcfS-SYm8CwxQ20FHVc0w0e3lVNdA8LXA66LK8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJpa9H7mDEGsAbnWleGyrc5-b0UVN2k8oq54X__Et-zg&oe=6AF3463C"}, {"file_name": "Screenshot4FIX.png", "id": "1139709051470401", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824522_1139709054803734_6321518441902280209_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGG_Nrmg69cQ7kNvwFhb-ML&_nc_oc=AdoVYb0VzMbOsUSOPUnbKdvQiB0hdlM-QdWRzkGy7dYEwW7DMMuPjEyDBMTRLLHBc78&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlDsldHhNaAQKjMNV5QoYJN8SRYzart2DbRqcFW1M7TA&oe=6AF3256C"}, {"file_name": "Screenshot5FIX.png", "id": "820917770490335", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821989_820917773823668_8027894609469365377_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNOVqKJdEegQ7kNvwEt5Tp6&_nc_oc=AdpzPdmpuGwNJYIBYGRd18Xs9qhz-bozyEofqrZv_88M9u6pu_yvN5tMi3GeTDESjm8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS05lHO-EQgAi4gMPuiVG_hcTlpbLrdUrbBsolqBTByZw&oe=6AF32F10"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Azure Tag", "keywords": ["tag", "fun", "fangame", "fan", "game"], "long_description": "Azure Tag is a community-made fan game based on the unique movement style of Gorilla Tag fan projects. It's not a copy \u2014 it\u2019s a fresh spin that builds on what fans already love, offering its own look, feel, and features.\n\nIn Azure Tag, you move without joysticks \u2014 using only your hands to run, jump, climb, and wall-bounce across vibrant, stylized maps. Whether you're chasing down other players in tag mode or mastering parkour challenges solo, the freedom of movement is at the heart of everything.\n\nWith a distinct visual style, original maps, and an active player community, Azure Tag adds its own flavor to the movement-based VR playground genre. It's made by fans, for fans \u2014 celebrating what makes Gorilla Tag-inspired games fun while taking bold steps in new directions.\n\nGet ready to jump in, tag fast, and move free in the world of Azure Tag.", "short_description": "Azure Tag is a fast-paced fan game inspired by Gorilla Tag fan games. Leap, climb, and tag your way through stylized environments with unique movement mechanics \u2014 no legs, just skill and speed!"}]}, "developer_name": "VivoVR", "developer_privacy_policy_url": "https://sites.google.com/view/azure-tag-privacy-policy?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "vivovr", "support_website_url": null, "website_url": "https://sites.google.com/view/azuretag?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24888368510816155"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820047_1527546275246704_3496806752691471313_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=899VGnV3excQ7kNvwHO-b7Y&_nc_oc=AdqcfCYEgqhBUWoEEShhfL2Mou5ZKAeXwFqXJHJ1oc5z1bkOqmz3wwsCbVjKDndPOFs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxBQ1oMpE
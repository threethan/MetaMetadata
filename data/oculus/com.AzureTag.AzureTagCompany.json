file_name": "Screenshot3FIX.png", "id": "1880451963349807", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818900_1880451966683140_7079409921534762042_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMSxc73inQkQ7kNvwGcUjPo&_nc_oc=Adp-Dh7K-BemItnAyveqhn5ldU4ye7-SQN1Ui1A3PbebYfsYKRcvkf7uZ9ZHzDdr2KY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbVH0eGCHQgkbdYKomQ4o-8s6Ybn3XkNCHfUVe7-ryhQ&oe=6A6B437C"}, {"file_name": "Screenshot4FIX.png", "id": "1139709051470401", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824522_1139709054803734_6321518441902280209_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRkUg9lKqicQ7kNvwERJPBD&_nc_oc=AdoPfvjDDoSrM_G2Ew8BpK_JrNkFH7uUSRn_r088g_O7oaswGH42j8zWu_B-DSgrfk8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0brr14oXeCB3nk30pyvlOUruuGEsF0U7AW5XI_yrYwg&oe=6A6B5AEC"}, {"file_name": "Screenshot5FIX.png", "id": "820917770490335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821989_820917773823668_8027894609469365377_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aC4m0RMHaMkQ7kNvwE4IAy4&_nc_oc=AdpBlnD88G7qflYVIiVhKFTD-eeFwm-7r8QGhOrtaBkyjLBDZu7aimZKaJVZ9JBhtsk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5plaqgd4H8gtxQfDd5z4NcwDizGU5wktXRNVi85VPrA&oe=6A6B6490"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Azure Tag", "keywords": ["tag", "fun", "fangame", "fan", "game"], "long_description": "Azure Tag is a community-made fan game based on the unique movement style of Gorilla Tag fan projects. It's not a copy \u2014 it\u2019s a fresh spin that builds on what fans already love, offering its own look, feel, and features.\n\nIn Azure Tag, you move without joysticks \u2014 using only your hands to run, jump, climb, and wall-bounce across vibrant, stylized maps. Whether you're chasing down other players in tag mode or mastering parkour challenges solo, the freedom of movement is at the heart of everything.\n\nWith a distinct visual style, original maps, and an active player community, Azure Tag adds its own flavor to the movement-based VR playground genre. It's made by fans, for fans \u2014 celebrating what makes Gorilla Tag-inspired games fun while taking bold steps in new directions.\n\nGet ready to jump in, tag fast, and move free in the world of Azure Tag.", "short_description": "Azure Tag is a fast-paced fan game inspired by Gorilla Tag fan games. Leap, climb, and tag your way through stylized environments with unique movement mechanics \u2014 no legs, just skill and speed!"}]}, "developer_name": "VivoVR", "developer_privacy_policy_url": "https://sites.google.com/view/azure-tag-privacy-policy?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "vivovr", "support_website_url": null, "website_url": "https://sites.google.com/view/azuretag?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24888368510816155"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820047_1527546275246704_3496806752691471313_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2t8bzNx4XcQ7kNvwFzHV6b&_nc_oc=AdpI9si2PrE7Cl0Pr88tnIHVFlednqBxj_U92KqeRLNZ5HFF9uWD7pZCU2XajLthtnM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYiytvi6I
file_name": "Screenshot3FIX.png", "id": "1880451963349807", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491818900_1880451966683140_7079409921534762042_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgHIHIDoCOkQ7kNvwGxC4EC&_nc_oc=AdoVQtH8-jVlcN7h7VGjuJlnlBIeBc7iCks2UDPe738N__9uWuiBBUN3foqlauBmE4c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxES6lTQYpIctfcbxNPR4-GqJrLQh2GLI0K7t3iw1AMxA&oe=69C3D4FC"}, {"file_name": "Screenshot4FIX.png", "id": "1139709051470401", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824522_1139709054803734_6321518441902280209_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBgI3IoayTMQ7kNvwF-H7NB&_nc_oc=AdoO8IkpEOQNDFo7sW0CKfNZODd9f75phMiVh7ui2PSiKnQiDeKSxU_Tzei39sSkTnM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzbno51x1xm2-RtUwyIja4mOOkoDGQE_4nIF_y-TxWHVA&oe=69C3EC6C"}, {"file_name": "Screenshot5FIX.png", "id": "820917770490335", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821989_820917773823668_8027894609469365377_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tazAVLN1FEQ7kNvwHAmAHl&_nc_oc=AdpcAApX4gZzarA52CK7bWujz0FQxIUvp7u4MgfgojL4glIcYxnTc79b8iKq0WFpzr4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOJnqJm1i1KtSWsOf-E0a7DWUkQATDQgHx9tc2xTjIag&oe=69C3BDD0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Azure Tag", "keywords": ["tag", "fun", "fangame", "fan", "game"], "long_description": "Azure Tag is a community-made fan game based on the unique movement style of Gorilla Tag fan projects. It's not a copy \u2014 it\u2019s a fresh spin that builds on what fans already love, offering its own look, feel, and features.\n\nIn Azure Tag, you move without joysticks \u2014 using only your hands to run, jump, climb, and wall-bounce across vibrant, stylized maps. Whether you're chasing down other players in tag mode or mastering parkour challenges solo, the freedom of movement is at the heart of everything.\n\nWith a distinct visual style, original maps, and an active player community, Azure Tag adds its own flavor to the movement-based VR playground genre. It's made by fans, for fans \u2014 celebrating what makes Gorilla Tag-inspired games fun while taking bold steps in new directions.\n\nGet ready to jump in, tag fast, and move free in the world of Azure Tag.", "short_description": "Azure Tag is a fast-paced fan game inspired by Gorilla Tag fan games. Leap, climb, and tag your way through stylized environments with unique movement mechanics \u2014 no legs, just skill and speed!"}]}, "developer_name": "VivoVR", "developer_privacy_policy_url": "https://sites.google.com/view/azure-tag-privacy-policy?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "vivovr", "support_website_url": null, "website_url": "https://sites.google.com/view/azuretag?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24888368510816155"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820047_1527546275246704_3496806752691471313_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riq6G-6Ku0cQ7kNvwFOQUVG&_nc_oc=AdpSnFsUAXMq_-Mk7Z9_069VR0EHDs8nDrUNstnqME57duflLl46JqAcqpEIZf3qcgw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0-k7t7z5
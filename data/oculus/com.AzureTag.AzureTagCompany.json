file_name": "Screenshot3FIX.png", "id": "1880451963349807", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818900_1880451966683140_7079409921534762042_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4gEi2Pj_l4Q7kNvwFsUksW&_nc_oc=AdrtH1zkTBgOkLHX4XUQlM3gB_Rn_WgHmnYxUqpmpjsPZCO4g_eHn4hRTi_XN9flX1o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoY2NH1sbw10JTlJZtUNyl-K4dXuncyRCquZhQVNV4Cw&oe=6A78727C"}, {"file_name": "Screenshot4FIX.png", "id": "1139709051470401", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824522_1139709054803734_6321518441902280209_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGh_C610WU0Q7kNvwHjAJkm&_nc_oc=AdqwYnnfe8-uUdU7WDU6NP7oL9i_UYh_Cnpg2guyGc5Wl54kDlUH3FePTVa314fdoIU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHV40883jmnjOrQbMgpuKtowoy4D0zdXNoeB43VDy5IRg&oe=6A7889EC"}, {"file_name": "Screenshot5FIX.png", "id": "820917770490335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821989_820917773823668_8027894609469365377_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76iR_BP8iewQ7kNvwERNKge&_nc_oc=AdqtWU8e2GFWZ5hLPJyOAVEU0Axjb4ORuULRlaFGAlFPyE6MiTkHMsfSBOlreJrAEPA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCidHfwH2yjwyOwbpLWc-wsx-QdQcM7QB-UHXBX9JOug&oe=6A789390"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Azure Tag", "keywords": ["tag", "fun", "fangame", "fan", "game"], "long_description": "Azure Tag is a community-made fan game based on the unique movement style of Gorilla Tag fan projects. It's not a copy \u2014 it\u2019s a fresh spin that builds on what fans already love, offering its own look, feel, and features.\n\nIn Azure Tag, you move without joysticks \u2014 using only your hands to run, jump, climb, and wall-bounce across vibrant, stylized maps. Whether you're chasing down other players in tag mode or mastering parkour challenges solo, the freedom of movement is at the heart of everything.\n\nWith a distinct visual style, original maps, and an active player community, Azure Tag adds its own flavor to the movement-based VR playground genre. It's made by fans, for fans \u2014 celebrating what makes Gorilla Tag-inspired games fun while taking bold steps in new directions.\n\nGet ready to jump in, tag fast, and move free in the world of Azure Tag.", "short_description": "Azure Tag is a fast-paced fan game inspired by Gorilla Tag fan games. Leap, climb, and tag your way through stylized environments with unique movement mechanics \u2014 no legs, just skill and speed!"}]}, "developer_name": "VivoVR", "developer_privacy_policy_url": "https://sites.google.com/view/azure-tag-privacy-policy?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "vivovr", "support_website_url": null, "website_url": "https://sites.google.com/view/azuretag?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24888368510816155"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820047_1527546275246704_3496806752691471313_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4_LdXbu_dAQ7kNvwFqLVyu&_nc_oc=AdoWNakrTO0ZYHSknNauTRCxABAIrcJ1Yx81r9Cz52m-bOZl1whJ5cdVJedLpHg1Dw8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5MfHMWDK
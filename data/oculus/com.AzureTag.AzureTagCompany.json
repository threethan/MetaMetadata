file_name": "Screenshot3FIX.png", "id": "1880451963349807", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491818900_1880451966683140_7079409921534762042_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OL6zbM-SaaIQ7kNvwG48Nk2&_nc_oc=AdqIuQEuBmm5MicdAHasnD_UopZb1ed5s65oz7jTol8Qs489FxoVibxwTuRHFL8LXXI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNmtikJbpqCgH1cc1BE0-G8E9oc1ROtwdiid7JjUL74Q&oe=6A6F37FC"}, {"file_name": "Screenshot4FIX.png", "id": "1139709051470401", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824522_1139709054803734_6321518441902280209_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WewL0PJEykQ7kNvwG1R6aE&_nc_oc=AdrekAsqb5E1Y8cJ4vucGmR26p7gLFDqEhUoZorDRCNZYS6v_X0Wj3hWYUoRhlXMLPo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6hhv-OkqOPifLwZNMMJ4DwQUPEnoawW7s4UGIoyx3LQ&oe=6A6F4F6C"}, {"file_name": "Screenshot5FIX.png", "id": "820917770490335", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821989_820917773823668_8027894609469365377_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sH1ysG9Qi78Q7kNvwEHE052&_nc_oc=AdosGgTb-GP60baeyLC35q1meJbJ8fqLqxqdt7hWnuv80Drue5SixnUNVYzjJlRU6p0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBv_T-GHPjeNcx2dxAiuKgvQ1hEQ08ESVscqsiq_zG0ig&oe=6A6F5910"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Azure Tag", "keywords": ["tag", "fun", "fangame", "fan", "game"], "long_description": "Azure Tag is a community-made fan game based on the unique movement style of Gorilla Tag fan projects. It's not a copy \u2014 it\u2019s a fresh spin that builds on what fans already love, offering its own look, feel, and features.\n\nIn Azure Tag, you move without joysticks \u2014 using only your hands to run, jump, climb, and wall-bounce across vibrant, stylized maps. Whether you're chasing down other players in tag mode or mastering parkour challenges solo, the freedom of movement is at the heart of everything.\n\nWith a distinct visual style, original maps, and an active player community, Azure Tag adds its own flavor to the movement-based VR playground genre. It's made by fans, for fans \u2014 celebrating what makes Gorilla Tag-inspired games fun while taking bold steps in new directions.\n\nGet ready to jump in, tag fast, and move free in the world of Azure Tag.", "short_description": "Azure Tag is a fast-paced fan game inspired by Gorilla Tag fan games. Leap, climb, and tag your way through stylized environments with unique movement mechanics \u2014 no legs, just skill and speed!"}]}, "developer_name": "VivoVR", "developer_privacy_policy_url": "https://sites.google.com/view/azure-tag-privacy-policy?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "vivovr", "support_website_url": null, "website_url": "https://sites.google.com/view/azuretag?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24888368510816155"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820047_1527546275246704_3496806752691471313_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkkJxWxW0WkQ7kNvwF6_jaU&_nc_oc=AdqzlclxkTHOIXHrccxhxzgD_piHTaKhZvwQijPcpKVAcjX-nj6pIuL3sDeaffoJLPE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-k5jkQGW
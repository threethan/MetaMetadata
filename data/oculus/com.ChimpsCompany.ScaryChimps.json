LvRAqkJ81KGjToA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx37xc6fk3E3pGBeQg9UOYwS75ifk7HM_MPDFPsoSNQnA&oe=69B41A65"}, {"file_name": "SampleScene_2025-05-06_22-13-19.png", "id": "3943963305933830", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820382_3943963309267163_1972347659078469706_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74iHSuBYbnEQ7kNvwHQkl7-&_nc_oc=Adny8Xg3kff7IfOQPFhGiWN40ksAJvRxIR8w-u1_DEA1jJFmJHWFLWQi5i7YHJ3iIBc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwE2moiNk5RYUeY0xxjMd56epvXkMKDt1aNiyCJ9ETP3Q&oe=69B3F90D"}, {"file_name": "SampleScene_2025-05-06_22-10-16.png", "id": "716995480839790", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824611_716995484173123_6345828396375208759_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8_RN3M9-ooQ7kNvwFjjFaJ&_nc_oc=AdlKklZffsXuF-hPattvFacEUgXKKT3Wy92FatOKeT0Ob279Qcoty0vRUm5UISBDRbY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz0FfVlLM34NOpxZzUIj-yQZ9XFkmLDGFKmWoZkPf7jXQ&oe=69B404DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ScaryChimpss", "keywords": [], "long_description": "What begins as a familiar game of tag quickly spirals into a nightmare. In this horror fan take on the beloved Gorilla Tag universe, players are thrown into a haunting and atmospheric world where the rules have changed\u2014and survival is the only goal.\n\nYou\u2019ll explore twisted, decaying maps inspired by the original Gorilla Tag environments, now overtaken by darkness, fog, and unsettling silence. Your only tools are your movement and your instincts. Climb, swing, and launch yourself through the environment to evade the unknown horrors that lurk in the shadows.\n\nBut beware\u2014something is always watching. Monsters with unpredictable behavior, jump scares that catch you off-guard, and subtle environmental storytelling combine to build a constant sense of dread. Whether playing solo or with friends, every session is different, and no place is truly safe.\n\nFeaturing:\n\nSpine-chilling environments with immersive audio and lighting\n\nTerrifying AI enemies that learn and react to player movement\n\nHidden lore scattered across the maps for those brave enough to uncover the truth\n\nMultiplayer support for shared scares and chaotic escapes\n\nClassic Gorilla Tag physics with a horror twist", "short_description": "Step into the shadows of the Gorilla Tag universe in this chilling horror fan game. Navigate eerie environments, survive terrifying encounters, and uncover dark secrets\u2014all while swinging and climbing like never before. Do you have what it takes to outrun the unknown?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/scarychimpsprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DatK3rmitVR", "support_website_url": null, "website_url": "https://docs.google.com/document/d/e/2PACX-1vTS6fJktyvm4bxR3Q-K0fExXOpaAy_arA0ViDVSiR3bl76QLFaxWY_X8emkKQ7H75ML-6K1-jJwPDQL/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9893216797461512"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBi
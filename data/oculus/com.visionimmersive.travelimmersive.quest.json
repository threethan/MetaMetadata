n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syRl84-DMZMQ7kNvwFUeTQ-&_nc_oc=AdrkzvDeE9NoyIqmLkC0M2LF78I4OfyzV2RK-3peJ81Wh06BVL4zrH1bi4ACXthS3jk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKXjG66gTGCQQEgqw9ahxevrRqNG6pJW-coAnQbcxs3A&oe=6ABD2E4E"}, {"file_name": "screenshot-05-immersive-menu-2560x1440.png", "id": "1054892303827586", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/673573223_1054892307160919_5231169591288031460_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWCzbyezlHgQ7kNvwFa9MQ1&_nc_oc=AdoitZO9D7Y-x8LzZJ_G3H1tHZ0VEfQi8-tNLfZo8_PsdAYmRnfYHEXGCaXnQOxEMA8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6TvYhcOff5BMlFPodoR_5gDgCsInpTA2y80_vat4YBw&oe=6ABD238F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Travel Immersive", "keywords": ["travel", "panorama", "landmarks", "360", "sightseeing"], "long_description": "**The world, in 8K, on your Quest.**\nTravel Immersive is a living library of real 360\u00b0 photography \u2014 not CGI, not generated scenery. Every scene is delivered in 8K HD. Look up, turn around, and stand inside places you may only know from a postcard.\n\n**670+ destinations. 75+ countries. Growing every week.**\nVisit landmarks, coastlines, mountains, and cultural sites across Asia, Europe, Africa, the Americas, and Oceania. We add **30+ new destinations every month**, so the catalog keeps expanding without you installing a new version of the app.\n\n**Built for actually going somewhere**\n\u2022 Browse Latest, Nature, and Culture \u2014 or filter by continent and country\n\u2022 Search, save favorites, and jump between linked viewpoints in the same area\n\u2022 Read on-the-spot scene notes and travel tips\n\u2022 Share and read reviews from other travelers\n\u2022 English and Simplified Chinese interface\n\n**Free to start**\nThe app is free to download. A selection of panoramas is open to everyone. Unlock the full, weekly-updated catalog with an optional membership: monthly, annual, or lifetime. Purchases use the Meta account already signed in on your headset; restore from Profile anytime.\n\n**Comfortable on Quest**\nSit or stand \u2014 there is no locomotion. Designed for Quest 2, Quest Pro, Quest 3, and Quest 3S. An internet connection is required to load the catalog and new weekly scenes.\n\nSome scene descriptions may be AI-assisted and are for reference only.", "short_description": "Travel the world in 8K HD. Explore 670+ real 360\u00b0 landmarks across 75+ countries \u2014 from iconic cities to remote landscapes \u2014 with 30+ new destinations added every month. Browse by continent, step inside a scene, and look around as if you are there. Download free, try featured panoramas, and unlock the full catalog with an optional membership."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionimmersive.com/privacypolicy", "developer_terms_of_service_url": "https://www.visionimmersive.com/termsofuse", "publisher_name": "Vision Immersive", "support_website_url": null, "website_url": "https://www.visionimmersive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1317039808149961"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/596068480_1054623987455913_7458688
nBTiQvUr0BsBmcD0PZsfT-k_9DYS0Zyp-Q&oe=6AF5E650"}, {"file_name": "screenshoot_15_02_2021_15_33_45.png", "id": "796963244254312", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031646_796963247587645_1236731329101608783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrIG8AIFyKIQ7kNvwHDEllO&_nc_oc=Adprj4-LjvKzM7CO0HWtu4Wq3UnPlo--9YDGPTbf723fcFXmDlUV3T2OkN2m5a0Qq3k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCgrLC6f7rOpRQGeVQVYSCFbpz_R14Nv_HlhNORxD0HQ&oe=6AF5D038"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logohandspell.png", "id": "463063551564717", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031581_463063554898050_8381540247439495048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mu9OlEwBEe8Q7kNvwFQXBUY&_nc_oc=AdoNwoCueEsyzqwoeNVac9nRiLP9CicSLQUFmHef-rnfbsR0ZnmpYRniEG0V1g0U6TI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUydzlAiKYs__WMSfgf3Z5AbGQDXGG-HJj9LUxXRS4AA&oe=6AF5E3D8"}, "display_name": "Hand Spell", "keywords": [], "long_description": "You have one chance to escape a mysterious prison.\nWill you survive to make it to the surface ?\n\nFEATURES\n\n- Cast different spells using your own hands\n- Random / Roguelike elements to keep gameplay fresh each session\n- 20+ original enemies, fully hand crafted & animated\n- Seated experience and no motion sickness\n\nCONTENT\n\n- The full game contains 3 differents biomes, with various different rooms.\n- The goal is to reach the final floor and defeat the final boss.\n- Each run length is between 15 - 40 minutes, however you won't be able to beat the game in one run considering the difficulty and the random elements\n- The game include permanent upgrades to boost your character and unlock a Hard Mode", "short_description": "Turn-Based RPG with roguelike elements.\nEngage in 1 vs 1 battles and cast spells with your own hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://handspell.com/priva
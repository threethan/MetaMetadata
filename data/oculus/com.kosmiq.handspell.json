a7GeOVxZIcgQ7kNvwG4QV4g&_nc_oc=AdrFb5vVaEERfEfd6H2f9HjFC4iRRAJu-NK3A57JNPcfK1qStWHYF-JWe36g-V6Y40Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3zNpJJ4l7Fn0-PgmamUZn1I2bo9cNUKIlCzCcWuI5ktQ&oe=69F0C3A5"}, {"file_name": "screenshoot_15_02_2021_15_31_18.png", "id": "233323345192173", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031424_233323348525506_3156933618024086469_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GldayAmNa0Q7kNvwGeL-hC&_nc_oc=AdoSpYPeyKr0xbuwImcwwQjeSQ0XKyr4vkU3vNQatgnN0BcWBNmfcOvL0UMb7PAsvJA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1AoWMSXDFFTD5PRSAZ_sgSDPo1jipqFtlTTFdfPrO94w&oe=69F0A510"}, {"file_name": "screenshoot_15_02_2021_15_33_45.png", "id": "796963244254312", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031646_796963247587645_1236731329101608783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duex7YuFFDYQ7kNvwECjO2P&_nc_oc=Ado8s88HUuM0Zapj0L-87m1-4mTSvlnlHWycD_dl8IseNR8fA6YrGxB6bW_SLvw0NaU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3VDL7OwLEeNKryYyIx3eKxtfq8TvZdPmjuUvo2PWCTaw&oe=69F0C738"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logohandspell.png", "id": "463063551564717", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031581_463063554898050_8381540247439495048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nskyr1WrYjYQ7kNvwHV9VbK&_nc_oc=Ado4UyDCp3qdDH4CfXP1U8EQ-6-HZv8CfEzTK4D70VK-SDZ3dl10G0wLYa7Jr6FT6fQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2lnLixFPfgTRl0JOvu9X2uBvRw7CT-4h-CXxQqrQ3Mhw&oe=69F0A298"}, "display_name": "Hand Spell", "keywords": [], "long_description": "You have one chance to escape a mysterious prison.\nWill you survive to make it to the surface ?\n\nFEATURES\n\n- Cast different spells using your own hands\n- Random / Roguelike elements to keep gameplay fresh each session\n- 20+ original enemies, fully hand crafted & animated\n- Seated experience and no motion sickness\n\nCONTENT\n\n- The full game contains 3 differents biomes, with various different rooms.\n- The goal is to reach the final floor and defeat the final boss.\n- Each run length is between 15 - 40 minutes, however you won't be able to beat the game in one run considering the difficulty and the random elements\n- The game include permanent upgrades to boost your character and unlock a Hard Mode", "short_description": "Turn-Based RPG with roguelike elements.\nEngage in 1 vs 1 battles and cast spells with your own hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://handspell.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "KOSMIQ", "support_website_url": "https://handspell.com/contact/", "website_url": "https://handspell.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5606466306035322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001723_292435928950857_474671855366408967_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwQjJASGzxUQ7kNvwFd1WMO&_nc_oc=AdrGnUIOIhYf-zW7MvQufW3-kkQXxAatR0NldsKpx16656BJHmKqeYA1mh9s_cuOd_Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af00jwwx-NxV-bhtGxHCwlTlWizJsLJVO98xlcSz7pi_nw&oe=69F0B994"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hand Spell", "platform": "ANDRO
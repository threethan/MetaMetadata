scdn.com/v/t64.5771-25/86610712_464620584753513_3767576710276366198_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2-KtKjHj_MQ7kNvwH1vhc0&_nc_oc=AdogY07ZsfE_GtqXMwfi90e5lCGi1Gc9hiYEOeSLgoA87uCttkHq1IWEmJiw_ov9p2U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ryK3aC0kzT8UUNJU0fIunGbttwPbnGXUnfi0V-UPT_w&oe=69F9FE25"}, {"file_name": "screenshoot_15_02_2021_15_31_18.png", "id": "233323345192173", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031424_233323348525506_3156933618024086469_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70L7gYGalLQQ7kNvwF9bhtx&_nc_oc=Adqs5_Z9EcTb7sFJbm_L7FwV5P1-jf2IazgR9G9YPDM62s6xtVwPBrUHmFyvgVEbWBw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iFLewr3nzuJFXQVEHKHjCABsP0mgCFMiXwKabf2Gc1Q&oe=69F9DF90"}, {"file_name": "screenshoot_15_02_2021_15_33_45.png", "id": "796963244254312", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031646_796963247587645_1236731329101608783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ekfvAoegZwQ7kNvwE4Lpq7&_nc_oc=Adov1d6MAoH5QQxPh7S_sxnKUIe5AcV36UqFi_P5Iy6qYeIhecvprn7iH9qn6kAYx9A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VFq1xCBlzb6-_lQfh_3az5_JEyXHQsWs8ULms5ApI5Q&oe=69FA01B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logohandspell.png", "id": "463063551564717", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031581_463063554898050_8381540247439495048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQWw9Xuu6FsQ7kNvwFXZOHA&_nc_oc=AdorVmVnT8buezFhjP9oqwJybQ5rtA2u-UrxQAQ61k4cnUEvxb6n7zFf4_xpLz4ncvQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5klRszGROz-Lw0SK5enL9bRQGRbQEtKxUjpTpuR5rMvQ&oe=69F9DD18"}, "display_name": "Hand Spell", "keywords": [], "long_description": "You have one chance to escape a mysterious prison.\nWill you survive to make it to the surface ?\n\nFEATURES\n\n- Cast different spells using your own hands\n- Random / Roguelike elements to keep gameplay fresh each session\n- 20+ original enemies, fully hand crafted & animated\n- Seated experience and no motion sickness\n\nCONTENT\n\n- The full game contains 3 differents biomes, with various different rooms.\n- The goal is to reach the final floor and defeat the final boss.\n- Each run length is between 15 - 40 minutes, however you won't be able to beat the game in one run considering the difficulty and the random elements\n- The game include permanent upgrades to boost your character and unlock a Hard Mode", "short_description": "Turn-Based RPG with roguelike elements.\nEngage in 1 vs 1 battles and cast spells with your own hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://handspell.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "KOSMIQ", "support_website_url": "https://handspell.com/contact/", "website_url": "https://handspell.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5606466306035322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001723_292435928950857_474671855366408967_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFg08CYOSC8Q7kNvwEu8Lq9&_nc_oc=AdpDAVw33XeA1j6obhbNN3yF7ETW2xBMFagEW62fIigeottZA-ICHuUZuSu13Kt2f1Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=0
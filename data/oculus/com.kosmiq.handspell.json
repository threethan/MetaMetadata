20584753513_3767576710276366198_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96I_GG1Bdj8Q7kNvwE08Va5&_nc_oc=AdnYdC9V49Po5uYXt3JujHVOWS5ZRFkdcP_Ypal2f1D-UfRfbsSq4JhyOOrMsITXHug&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxzXwlvOzjj1z2bPyGq0aFSWXN6Rsy-HCu49ml1gZwAIA&oe=69BC07A5"}, {"file_name": "screenshoot_15_02_2021_15_31_18.png", "id": "233323345192173", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031424_233323348525506_3156933618024086469_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5SgyfQae5UQ7kNvwE2GwTA&_nc_oc=Adl5BYc0LoAxibW_AlMtDNzPBDW3y9dsdJkrEc7TxjIRJNweKhfpsKiJD3YlMs985qM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwgR4bZS1fEIaBbb_k4KnXMohxkuQFu8ZatQ5-FntuIyw&oe=69BBE910"}, {"file_name": "screenshoot_15_02_2021_15_33_45.png", "id": "796963244254312", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031646_796963247587645_1236731329101608783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWTAnoUTkZ0Q7kNvwFeRrnf&_nc_oc=AdnJNziBQbS3VE6ENdMYLwMgDYMaRrte3Ua9cSj8iDtNtF2QpNrqHrJ2gzGEnnCaN5g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxkRBE_1OQN2Qr5Emdtd9P5SKzXoFhEPoOa_iAei5EBng&oe=69BC0B38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logohandspell.png", "id": "463063551564717", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031581_463063554898050_8381540247439495048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3cfsfM5NoIQ7kNvwEqQ4Nh&_nc_oc=Adn-OjZbjZlqN7QV3tOdu1jKi2eqrtAixeJt-Ghk9AC6vsZUi37OG3IxysMSbs7qfXI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyA-7EbB0qERNacDzQrdzPuEchCNL2iDYz2Q5iYfOplkQ&oe=69BBE698"}, "display_name": "Hand Spell", "keywords": [], "long_description": "You have one chance to escape a mysterious prison.\nWill you survive to make it to the surface ?\n\nFEATURES\n\n- Cast different spells using your own hands\n- Random / Roguelike elements to keep gameplay fresh each session\n- 20+ original enemies, fully hand crafted & animated\n- Seated experience and no motion sickness\n\nCONTENT\n\n- The full game contains 3 differents biomes, with various different rooms.\n- The goal is to reach the final floor and defeat the final boss.\n- Each run length is between 15 - 40 minutes, however you won't be able to beat the game in one run considering the difficulty and the random elements\n- The game include permanent upgrades to boost your character and unlock a Hard Mode", "short_description": "Turn-Based RPG with roguelike elements.\nEngage in 1 vs 1 battles and cast spells with your own hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://handspell.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "KOSMIQ", "support_website_url": "https://handspell.com/contact/", "website_url": "https://handspell.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5606466306035322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001723_292435928950857_474671855366408967_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsa652xfOXAQ7kNvwHqamPN&_nc_oc=AdnIWku9ahFZZtWTedBhv-SaO7NM3VGlZqMy37oVEjjObys8DF4mL36virY5NsAIlx0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxYBosv0_jz7DIL3ruFYB8RKKMA_OBn6xTQ-BWFxklDgQ&oe=69BB
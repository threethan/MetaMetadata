scdn.com/v/t64.5771-25/86610712_464620584753513_3767576710276366198_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmjDcf0KeNgQ7kNvwGLds_b&_nc_oc=AdqAzNjtp90jnIjGg-F2xARU9c2TkL0aI2UnuaHQqeLePXRZJge1GTE8O5JAi9GMQ8Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XwZLirGCknNlP2cOxv3Wuz_pPJPNw-tHJLnLx_RyQvw&oe=6A218B25"}, {"file_name": "screenshoot_15_02_2021_15_31_18.png", "id": "233323345192173", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031424_233323348525506_3156933618024086469_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5t8l2DJGbQQ7kNvwE8f-MF&_nc_oc=AdqkVQd_TcgFJJw11BiizOLbuhRYq1DmEvULqB4yUi86bRG0o1i3W3UrfvFac31LyZ8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GXL-3WeyHRXBS1z9eX1JJLX8JLDU2LcwGALQWckgRaw&oe=6A21A4D0"}, {"file_name": "screenshoot_15_02_2021_15_33_45.png", "id": "796963244254312", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031646_796963247587645_1236731329101608783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YM0TYWddRycQ7kNvwF5eF9Q&_nc_oc=AdrWdGARE7e_6Vtvv6PWnXGk8Kr5lPg_GKthHAQaBdMqS057Qykw39QSsHS0xM3fWMU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FY3i1Oax-P4XWH85XPCf4j21Pyx4zi7paUyTt9B-djA&oe=6A218EB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logohandspell.png", "id": "463063551564717", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031581_463063554898050_8381540247439495048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qj4o_55fONwQ7kNvwHYIeYH&_nc_oc=AdrsiEUx4XpTcK9wcFNnA-HNe0_8CPkDEMVo4nBIsXCaNYsfgJPsA-_doPU4ck2IlEs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4q8XmR-tC7SbFPaagE4yWM0olr_TBf4NMyaA_B66uHw&oe=6A21A258"}, "display_name": "Hand Spell", "keywords": [], "long_description": "You have one chance to escape a mysterious prison.\nWill you survive to make it to the surface ?\n\nFEATURES\n\n- Cast different spells using your own hands\n- Random / Roguelike elements to keep gameplay fresh each session\n- 20+ original enemies, fully hand crafted & animated\n- Seated experience and no motion sickness\n\nCONTENT\n\n- The full game contains 3 differents biomes, with various different rooms.\n- The goal is to reach the final floor and defeat the final boss.\n- Each run length is between 15 - 40 minutes, however you won't be able to beat the game in one run considering the difficulty and the random elements\n- The game include permanent upgrades to boost your character and unlock a Hard Mode", "short_description": "Turn-Based RPG with roguelike elements.\nEngage in 1 vs 1 battles and cast spells with your own hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://handspell.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "KOSMIQ", "support_website_url": "https://handspell.com/contact/", "website_url": "https://handspell.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5606466306035322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001723_292435928950857_474671855366408967_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYRHO39TDY0Q7kNvwFeLXuf&_nc_oc=Adq0r1aw1gVhKALB-Jc8iizBq_Pb9Yv7pktQg1unwvEB30xfsvMwcUyn5zI2JcUqAxA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=0
20584753513_3767576710276366198_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMZRnXombuwQ7kNvwEhxC2U&_nc_oc=AdnOCoF-XZY01_G1kTDIilX7jSAWaYUIkTkbegXJ_MrXchQseAzRPm5RjHUV8-Gat4w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxfzosxxzesG6yy-1pF49er6reFF6ipGOrD7Kgr6EpuIQ&oe=69BFFC25"}, {"file_name": "screenshoot_15_02_2021_15_31_18.png", "id": "233323345192173", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031424_233323348525506_3156933618024086469_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_RyFEuceg0Q7kNvwGWEMnk&_nc_oc=AdkrHaHh-Mp-fmc8JqIu6hZi_MO1-GkpZvESdNiBWd3AlFyAVYQynnx4SgqBTJVNAAk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1H8WDioP2-nM4ooqiKDSyVuVwD0O8HYVMd6YTPCPySw&oe=69BFDD90"}, {"file_name": "screenshoot_15_02_2021_15_33_45.png", "id": "796963244254312", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031646_796963247587645_1236731329101608783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdppQbj0HqsQ7kNvwElP34f&_nc_oc=AdnOIol11E-1rkad0qh95sbPFskx7GC1j1UVeQgMELcLT3RFYtlaQtrR34SIC9hLTb4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxKjWe_56J5_Yp9XwwfxNDY6AqXnk6SkFUH9JZKn0aJUQ&oe=69BFFFB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logohandspell.png", "id": "463063551564717", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031581_463063554898050_8381540247439495048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QS92JjUN3n8Q7kNvwEVJnMu&_nc_oc=AdmWXwk8nQ7fxzgZ3yDSrVK626ZYgzlu3Jljxki1bi-6T7aii-27AkhjaAp-P3j1g14&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyW07RmubH5zVBbl6QOoUsdCEYIeLK8SBLSbwdxqkGIGw&oe=69BFDB18"}, "display_name": "Hand Spell", "keywords": [], "long_description": "You have one chance to escape a mysterious prison.\nWill you survive to make it to the surface ?\n\nFEATURES\n\n- Cast different spells using your own hands\n- Random / Roguelike elements to keep gameplay fresh each session\n- 20+ original enemies, fully hand crafted & animated\n- Seated experience and no motion sickness\n\nCONTENT\n\n- The full game contains 3 differents biomes, with various different rooms.\n- The goal is to reach the final floor and defeat the final boss.\n- Each run length is between 15 - 40 minutes, however you won't be able to beat the game in one run considering the difficulty and the random elements\n- The game include permanent upgrades to boost your character and unlock a Hard Mode", "short_description": "Turn-Based RPG with roguelike elements.\nEngage in 1 vs 1 battles and cast spells with your own hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://handspell.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "KOSMIQ", "support_website_url": "https://handspell.com/contact/", "website_url": "https://handspell.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5606466306035322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001723_292435928950857_474671855366408967_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaiR22k9m0gQ7kNvwGglgYy&_nc_oc=AdlPqZRz4XqUTAJkaLxvJ2RhGVSZik96o9QYWiYR7j7OM1I_l6Kf6QH82v9q-m3f2iE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3n7bkFzTbto3_bpIsiiiYpXbHAccpB9lZ1Uqqax_RNQ&oe=69BF
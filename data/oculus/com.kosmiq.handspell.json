20584753513_3767576710276366198_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMZRnXombuwQ7kNvwGUyMST&_nc_oc=AdkpyThKE1ZJDZqA2kkRvuke6IRjQDVWYwRXlcZkCwey2vfVqTI1z1uN6oP5IF6fOCc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx-P6q9E8lCikDvD-X8r6CBv7ldxQqL1NV3PlQjNMeLKQ&oe=69BD5925"}, {"file_name": "screenshoot_15_02_2021_15_31_18.png", "id": "233323345192173", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031424_233323348525506_3156933618024086469_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5SgyfQae5UQ7kNvwFWKsRc&_nc_oc=AdlM9XdONSHdBA942w4MBfeqzwLtPM5MFt1qsoKM-XcwSGtw6XVycKTUMc5MlVbs6Mo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfymVu6knBs4yZXv315C3QBQ99BfUZ11bMJnh5HABWBSUw&oe=69BD3A90"}, {"file_name": "screenshoot_15_02_2021_15_33_45.png", "id": "796963244254312", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031646_796963247587645_1236731329101608783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdppQbj0HqsQ7kNvwHfN4uQ&_nc_oc=Adl0W0ousgcTJUwqu8xYYATNRsqNgJ5AUUazRx1-9VU-j24ToRDFC1qtclxU4quJfso&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5FTnZZ1oR3YygyAdlJxv0MZ1XJeoDQN27Dz3WZrC4sg&oe=69BD5CB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logohandspell.png", "id": "463063551564717", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031581_463063554898050_8381540247439495048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QS92JjUN3n8Q7kNvwE4tNil&_nc_oc=AdkaZ8dN1yJ3nqmlaDWbDfEsgcD2vGMwZ1qbVfSsCKihudlK5oN47CY6396bX8Ls5C0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy8BIcmPAME6AmA9uTMRsNaxccCEfR4-9a31kWNUvrnrQ&oe=69BD3818"}, "display_name": "Hand Spell", "keywords": [], "long_description": "You have one chance to escape a mysterious prison.\nWill you survive to make it to the surface ?\n\nFEATURES\n\n- Cast different spells using your own hands\n- Random / Roguelike elements to keep gameplay fresh each session\n- 20+ original enemies, fully hand crafted & animated\n- Seated experience and no motion sickness\n\nCONTENT\n\n- The full game contains 3 differents biomes, with various different rooms.\n- The goal is to reach the final floor and defeat the final boss.\n- Each run length is between 15 - 40 minutes, however you won't be able to beat the game in one run considering the difficulty and the random elements\n- The game include permanent upgrades to boost your character and unlock a Hard Mode", "short_description": "Turn-Based RPG with roguelike elements.\nEngage in 1 vs 1 battles and cast spells with your own hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://handspell.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "KOSMIQ", "support_website_url": "https://handspell.com/contact/", "website_url": "https://handspell.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5606466306035322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001723_292435928950857_474671855366408967_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsa652xfOXAQ7kNvwGoArS-&_nc_oc=AdnFv7d6EFpTLpzxq45ZMSOQi1qNwQmxA2IMEYNFFzUvmH5t2BCMi7Lj-hSK0yrdBRc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwS5kTWPQwfxWB_f3Fs6YB0Yp5b3cLZCXCtBuGQDk3zeQ&oe=69BD
20584753513_3767576710276366198_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6LqUKcSLUEQ7kNvwGVzguV&_nc_oc=AdkvesWp6tf7PbU2PL-APtBk4fmNnR63tLsjrHpwz6ir0q2bOWknPMsoAFiIyPf89eo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwEO-dLBew-x7-vw8xXm77BDON9Y1-au1NtCL7LxcmpvQ&oe=69AC35A5"}, {"file_name": "screenshoot_15_02_2021_15_31_18.png", "id": "233323345192173", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031424_233323348525506_3156933618024086469_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RW9GkEyAESEQ7kNvwGTo_KG&_nc_oc=Adl8UGT5T6NBXbPhpEWeGfA1hXwXWjfo6dZYS6NjV1mWa96JgB-BgBzGFFkr_6twto0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyAEFCKoKe1aXcC7GeRBCbI47i_zdspINBOgug4ENfdQw&oe=69AC1710"}, {"file_name": "screenshoot_15_02_2021_15_33_45.png", "id": "796963244254312", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031646_796963247587645_1236731329101608783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=comUZLCYbBAQ7kNvwHDDDYi&_nc_oc=AdkDP3OX-Urx00tg8_14wpf5SYppLe4PUr1ArWWQuzLxVYUNWgLWWKvJsgzgniw6-WU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxWx43JF7t0Pxn36E2h0c9Hz2FZG8cupRVsxJs6nXD_Cg&oe=69AC3938"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logohandspell.png", "id": "463063551564717", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031581_463063554898050_8381540247439495048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JlLwiAsvJpcQ7kNvwFaAr5q&_nc_oc=Adm8kjDb9EK5eLyAVMcBe-t7KIkfVR0I8gxfEXZJHypqIKQ-KAxbTJKANRAHAdneUas&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwwvCOiOslr4kljCv0fZHZqeJP7B9BVqz64tiv4dORfFg&oe=69AC1498"}, "display_name": "Hand Spell", "keywords": [], "long_description": "You have one chance to escape a mysterious prison.\nWill you survive to make it to the surface ?\n\nFEATURES\n\n- Cast different spells using your own hands\n- Random / Roguelike elements to keep gameplay fresh each session\n- 20+ original enemies, fully hand crafted & animated\n- Seated experience and no motion sickness\n\nCONTENT\n\n- The full game contains 3 differents biomes, with various different rooms.\n- The goal is to reach the final floor and defeat the final boss.\n- Each run length is between 15 - 40 minutes, however you won't be able to beat the game in one run considering the difficulty and the random elements\n- The game include permanent upgrades to boost your character and unlock a Hard Mode", "short_description": "Turn-Based RPG with roguelike elements.\nEngage in 1 vs 1 battles and cast spells with your own hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://handspell.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "KOSMIQ", "support_website_url": "https://handspell.com/contact/", "website_url": "https://handspell.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5606466306035322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001723_292435928950857_474671855366408967_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfVYsLdN_KkQ7kNvwExyTfA&_nc_oc=Admx3GkQqzOyyd0UvkY6dCXX4fttDsdt_fiVHa9WzR0t1Kox4U3tsETjZnBh2a2kShQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw0VQ1-rPkhhk44ooeLLotKY3gLXBWNffdxvOpDPAHf3w&oe=69AC
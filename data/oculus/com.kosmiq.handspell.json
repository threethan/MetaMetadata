5peEBzoImzsQ7kNvwEmSOW8&_nc_oc=Adn8D92_FoVBJyptcgPaEDV_qTjCJhAdiWO7LppoPE-LVzv5NLzRYZ1wGgvcacL4RD8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfustmxpgEOCLBkVE3uwhhXsq4HNdH8ovY8bkRI8Ml-lAA&oe=69A05825"}, {"file_name": "screenshoot_15_02_2021_15_31_18.png", "id": "233323345192173", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031424_233323348525506_3156933618024086469_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgqw-OzogDAQ7kNvwFtK0V_&_nc_oc=AdnB5O0nQcibgX6XVIs2zuRtqBFmeir4wUoaqaTOgHAWgGEu_gl5dVu9hTmx_Xc08PU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftGTaLa5VA_ZFMtnITzJOWCy8Gveo3ESmBagZTqITc8RQ&oe=69A03990"}, {"file_name": "screenshoot_15_02_2021_15_33_45.png", "id": "796963244254312", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031646_796963247587645_1236731329101608783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QhNRnhY6qEQ7kNvwHoego4&_nc_oc=AdmZq_HD8YxYfAB2p3fkJHqJsJ8tKHrEoSsF7-fN3VpQaL9fEOl5qhL9h9PSX-lEOBo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftB4qWT7NluYP885lzt7a8Yd8lMStLlULG9hFUFqJgB0g&oe=69A05BB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logohandspell.png", "id": "463063551564717", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031581_463063554898050_8381540247439495048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUb0RBmYEXoQ7kNvwE8ozc4&_nc_oc=AdnJYilLVl8TMqooK5TUvvJhUjPOgSlFCebyJ8VmVW2iLUqnkMHIiZHrPE3hAbJCM6w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftxYaXHDTXoaZa67gDkvlK7YkYFV6uZHk3QZQBDEHXarQ&oe=69A03718"}, "display_name": "Hand Spell", "keywords": [], "long_description": "You have one chance to escape a mysterious prison.\nWill you survive to make it to the surface ?\n\nFEATURES\n\n- Cast different spells using your own hands\n- Random / Roguelike elements to keep gameplay fresh each session\n- 20+ original enemies, fully hand crafted & animated\n- Seated experience and no motion sickness\n\nCONTENT\n\n- The full game contains 3 differents biomes, with various different rooms.\n- The goal is to reach the final floor and defeat the final boss.\n- Each run length is between 15 - 40 minutes, however you won't be able to beat the game in one run considering the difficulty and the random elements\n- The game include permanent upgrades to boost your character and unlock a Hard Mode", "short_description": "Turn-Based RPG with roguelike elements.\nEngage in 1 vs 1 battles and cast spells with your own hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://handspell.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "KOSMIQ", "support_website_url": "https://handspell.com/contact/", "website_url": "https://handspell.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5606466306035322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001723_292435928950857_474671855366408967_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3FUvb4NkSIQ7kNvwG5Xfdd&_nc_oc=Adn6pdOPjDC3zuV_pFRu_0XvgPkX4uFCYfn8IKYBhNIrjhguPiT4iIIQo5Vky-EbLKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftNofKw0qjJgFuF_ycKLoRaHD2edhrK2h-LxmutEMMnWQ&oe=69A04E14"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hand Spell", "platform": "ANDRO
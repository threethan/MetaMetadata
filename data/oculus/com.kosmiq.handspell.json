20584753513_3767576710276366198_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLSOYjZSGEQQ7kNvwHtE6Tw&_nc_oc=AdlTcNyvJPkUR7kfvsLXbLxEA0c5VrrimUoiTDlUl6VPd1JMdHyHjcivhRk8Fhq8ZDY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwbbmox7SM7uiz8OoSgeF27AcPb5hkDwwx9pbpVg-7qqQ&oe=69B2CD25"}, {"file_name": "screenshoot_15_02_2021_15_31_18.png", "id": "233323345192173", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031424_233323348525506_3156933618024086469_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3Ib2LOjLQoQ7kNvwG0mHOY&_nc_oc=AdmNZXoloZz91dqDydJRr7F_FUn2ZJ2DBXGZuo8V8TzlieiHCBWa0UyXwjR8LjZlTvM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNkeb-UzMw_9G3q8laiNyFzS7MElUOaiu7F5Q9LT5NbQ&oe=69B2AE90"}, {"file_name": "screenshoot_15_02_2021_15_33_45.png", "id": "796963244254312", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031646_796963247587645_1236731329101608783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGCsvUF-FhYQ7kNvwEmUmhO&_nc_oc=AdkehyuuSboUBuyvA3Jz2hehIGzSEfwsHKZxoqLxqBX3XftnOXF7wTO2ylMZ3i1_kHA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxQ1V8PkMFOvYQEMy5aSFNVtm1tmi5uCdHExLPoyFNTKw&oe=69B29878"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logohandspell.png", "id": "463063551564717", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031581_463063554898050_8381540247439495048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0MLOyUvFa4Q7kNvwES_KIC&_nc_oc=Adk-vshcAslC5lIDaUD5F0osuk1LwYkkuqkkDmQzgu3CWv_a09abFYq34fndUSs3XHI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0M9GngeNuTOodmKydr9mtDfLN8ke-wOeiNbFVfgKR_w&oe=69B2AC18"}, "display_name": "Hand Spell", "keywords": [], "long_description": "You have one chance to escape a mysterious prison.\nWill you survive to make it to the surface ?\n\nFEATURES\n\n- Cast different spells using your own hands\n- Random / Roguelike elements to keep gameplay fresh each session\n- 20+ original enemies, fully hand crafted & animated\n- Seated experience and no motion sickness\n\nCONTENT\n\n- The full game contains 3 differents biomes, with various different rooms.\n- The goal is to reach the final floor and defeat the final boss.\n- Each run length is between 15 - 40 minutes, however you won't be able to beat the game in one run considering the difficulty and the random elements\n- The game include permanent upgrades to boost your character and unlock a Hard Mode", "short_description": "Turn-Based RPG with roguelike elements.\nEngage in 1 vs 1 battles and cast spells with your own hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://handspell.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "KOSMIQ", "support_website_url": "https://handspell.com/contact/", "website_url": "https://handspell.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5606466306035322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001723_292435928950857_474671855366408967_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcKPDqFosvUQ7kNvwFOg898&_nc_oc=AdnYMQk7uoFa4XP0FkpBSD44vBi5LXd9ke8SawGIvAPb61Q0rcowvxgzQ6SAFrdynAY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxG3CLe29POemEc3TMBCnjMoRjR6v4A-ZycS9VXHNqwqw&oe=69B2
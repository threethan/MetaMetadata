scdn.com/v/t64.5771-25/86610712_464620584753513_3767576710276366198_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nncQfyovxOMQ7kNvwE9i3fr&_nc_oc=Ado6eW1O54ohOdmekM8tU5lFj3bhMi8QcxWTxVKnXpC8hPaDhrr2Q1Q-UGVZBB4UFeA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVyyPkjvkkftbjWRPv81FfpNbmU8jVk_b0ZcP3Ik55og&oe=6AEC9225"}, {"file_name": "screenshoot_15_02_2021_15_31_18.png", "id": "233323345192173", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031424_233323348525506_3156933618024086469_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vy2GXpzcQ9wQ7kNvwFvfyl2&_nc_oc=AdpljwWnpUo-4UH5gOXhWoDIDCYNwWXGoUTje2jfcXVKSBLdH9rXjc9Vyyrbtkn2wEk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuaA8gLk6KnfFtpH5C9I_f_FZgN1UygzGqkaj11n_QPA&oe=6AECABD0"}, {"file_name": "screenshoot_15_02_2021_15_33_45.png", "id": "796963244254312", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031646_796963247587645_1236731329101608783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1DBvb0F6EoQ7kNvwFfSMl_&_nc_oc=AdpO-eedboEQ_UIEIBUMS_17u8KzAzAqK1ec8QSKepxcKcrmUQKm5Y1Bd7jfR6kvJhk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdGxJgHVlU0YegyP9wTqyRjeuhvk26HehbkiMfln9KzQ&oe=6AEC95B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logohandspell.png", "id": "463063551564717", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031581_463063554898050_8381540247439495048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ls1WoPpCxWIQ7kNvwGP72m8&_nc_oc=AdqXuTtpWPRmthUK_FwEc-zlQjp36VQpgyyhIcKbhBPWCHdZVAOyA34PRGnAjbrRJEU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVvrflBnThN67CjC_Pom1NBWctdktlQpSej-704Hi1FA&oe=6AECA958"}, "display_name": "Hand Spell", "keywords": [], "long_description": "You have one chance to escape a mysterious prison.\nWill you survive to make it to the surface ?\n\nFEATURES\n\n- Cast different spells using your own hands\n- Random / Roguelike elements to keep gameplay fresh each session\n- 20+ original enemies, fully hand crafted & animated\n- Seated experience and no motion sickness\n\nCONTENT\n\n- The full game contains 3 differents biomes, with various different rooms.\n- The goal is to reach the final floor and defeat the final boss.\n- Each run length is between 15 - 40 minutes, however you won't be able to beat the game in one run considering the difficulty and the random elements\n- The game include permanent upgrades to boost your character and unlock a Hard Mode", "short_description": "Turn-Based RPG with roguelike elements.\nEngage in 1 vs 1 battles and cast spells with your own hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://handspell.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "KOSMIQ", "support_website_url": "https://handspell.com/contact/", "website_url": "https://handspell.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5606466306035322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001723_292435928950857_474671855366408967_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9QRZANtczAQ7kNvwGG2QhF&_nc_oc=Adopcw4GGLD5ZXrM2OLqQtbSgJtc5fjcA_U1QJ5KY43u69yjGH-s36M_GuZljsYmdg4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=0
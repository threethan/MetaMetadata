sq7TFligqlLNL0hzvDMwc1JEWC-IOmlvNA&oe=69E22490"}, {"file_name": "screenshoot_15_02_2021_15_33_45.png", "id": "796963244254312", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031646_796963247587645_1236731329101608783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-aiHaViRqwQ7kNvwEo5I-E&_nc_oc=Adq6IpKXRJNDClin06orEs-1s_2y7h_jQ_A9UKnZrvK9WsN9ArallICzmIxG7eQM8LM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZS_UUu6sb41n5wGIgL4QIaOwKxi-_nsYJT-6Pv7J8kw&oe=69E246B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logohandspell.png", "id": "463063551564717", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031581_463063554898050_8381540247439495048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDFN_AdWh5YQ7kNvwESWWBg&_nc_oc=AdrAxxZWfRB8PESNBIh_T4iUiXulQe14NvO_fA5_a_t0_OhgUIpXQCBoxPnGUkI4YMQ&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15aS0pNY-Q6zUW_Be0ZEGAU18AYm3mVx37nqY8Po8ZsA&oe=69E22218"}, "display_name": "Hand Spell", "keywords": [], "long_description": "You have one chance to escape a mysterious prison.\nWill you survive to make it to the surface ?\n\nFEATURES\n\n- Cast different spells using your own hands\n- Random / Roguelike elements to keep gameplay fresh each session\n- 20+ original enemies, fully hand crafted & animated\n- Seated experience and no motion sickness\n\nCONTENT\n\n- The full game contains 3 differents biomes, with various different rooms.\n- The goal is to reach the final floor and defeat the final boss.\n- Each run length is between 15 - 40 minutes, however you won't be able to beat the game in one run considering the difficulty and the random elements\n- The game include permanent upgrades to boost your character and unlock a Hard Mode", "short_description": "Turn-Based RPG with roguelike elements.\nEngage in 1 vs 1 battles and cast spells with your own hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://handspell.com/priva
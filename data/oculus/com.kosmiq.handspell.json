scdn.com/v/t64.5771-25/86610712_464620584753513_3767576710276366198_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPOmgnOpB-wQ7kNvwFwAZjG&_nc_oc=Ado2AXCkC4Xrm7H5F9KB3Ik0a7ScZjK7xz9weeMoGWk66-UwhXpLEVT0koQ0ni02X78&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yH-odG53Mc75L2NGgJHr0ydt1Ux1OgYmLmLpRQTMAGQ&oe=69DA5A25"}, {"file_name": "screenshoot_15_02_2021_15_31_18.png", "id": "233323345192173", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031424_233323348525506_3156933618024086469_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nsr6haWrHC0Q7kNvwF9cEa0&_nc_oc=Adraf8nUAwD2RRvvxIx5mpTXRC5fk6l_ssTRzYSogdq2octgzQ1CLW-TyGwo_4M7Q8s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HJTp6xPu3YsWXzCw5jBmp016onCaJYlONh49qG1WHUQ&oe=69DA3B90"}, {"file_name": "screenshoot_15_02_2021_15_33_45.png", "id": "796963244254312", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031646_796963247587645_1236731329101608783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNM3_zd3G0IQ7kNvwF1VY2x&_nc_oc=Adr9UAhQFiyBKiCyhbPQdD5YSuyqnLcXGTY_LEOBuBm6xoZABFtB5Ux4GY2f-3XhMbU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mph2U1bCmp6RmWphN71rDkJqRL4vsdDDgN-FCA8nb4g&oe=69DA5DB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logohandspell.png", "id": "463063551564717", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031581_463063554898050_8381540247439495048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_idQTEvFrfEQ7kNvwEpfDES&_nc_oc=AdoHLauJrl3AUenfDqomEyafQRysvGRs9ai_2KYXVV4QmxqMj4yT37YTl6LG294BheM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2M_rkyUNSel_mvYs2r5fi3SsDM8th0u2hWGe-x5Y001g&oe=69DA3918"}, "display_name": "Hand Spell", "keywords": [], "long_description": "You have one chance to escape a mysterious prison.\nWill you survive to make it to the surface ?\n\nFEATURES\n\n- Cast different spells using your own hands\n- Random / Roguelike elements to keep gameplay fresh each session\n- 20+ original enemies, fully hand crafted & animated\n- Seated experience and no motion sickness\n\nCONTENT\n\n- The full game contains 3 differents biomes, with various different rooms.\n- The goal is to reach the final floor and defeat the final boss.\n- Each run length is between 15 - 40 minutes, however you won't be able to beat the game in one run considering the difficulty and the random elements\n- The game include permanent upgrades to boost your character and unlock a Hard Mode", "short_description": "Turn-Based RPG with roguelike elements.\nEngage in 1 vs 1 battles and cast spells with your own hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://handspell.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "KOSMIQ", "support_website_url": "https://handspell.com/contact/", "website_url": "https://handspell.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5606466306035322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001723_292435928950857_474671855366408967_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24rNfBuIa1gQ7kNvwHKJnGL&_nc_oc=AdoQ8MitjhJL10wj19Vt9skgOFSkHWcjzK-AbaQwt4RPYVMUjRTVg8XpEbIJM19xPqI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=0
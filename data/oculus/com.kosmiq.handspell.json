dHhnd8QKZDsQ7kNvwGGKiF1&_nc_oc=Adk6ewOvZbC33w5zd-gYLbVbZbFiGLtNwID1UidMijK2z-7c8sdBq0cdXE1AFzdeUZw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftWQ8Q40_PJj-Ii1Fle22bpktNm93ke01x3WXRF2HVIQQ&oe=6999C0A5"}, {"file_name": "screenshoot_15_02_2021_15_31_18.png", "id": "233323345192173", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031424_233323348525506_3156933618024086469_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EA9jAcBH_wwQ7kNvwHbvmci&_nc_oc=AdnjH2Pa9cE6lATk0JAqFC4BKb18IJORq4fgbxtiQKf4Z0-12K-I3fPW5oYy-o-uXFU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsvYHzkVxd10q5AXwbGyP5VSfar2NxNJoSVcszX5gX6qQ&oe=6999A210"}, {"file_name": "screenshoot_15_02_2021_15_33_45.png", "id": "796963244254312", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031646_796963247587645_1236731329101608783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81a_rmboa60Q7kNvwE3_4jZ&_nc_oc=AdnaS6cO2zdIugfi7Vm5lxExxIYUg_ZuC-tlbvPbhE3G6_YDwjHdQs6uoCX1LK8cBe8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftqo6EUgIU1QcQdkG_q2szpY1QZ8NX6ADYIsg4DVWQiQw&oe=6999C438"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logohandspell.png", "id": "463063551564717", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031581_463063554898050_8381540247439495048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=se37y8yaL4QQ7kNvwHvQdvE&_nc_oc=AdnmAWEXsvETOdekxszX87h4M3SkUhTH2zXuav5uHTdyrGqP5SQGr5ZI6AduKqfVKqI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvSetPcgKOHIOvrj7dh_YoiQza_M-u7ulIanjlTb4UqGg&oe=69999F98"}, "display_name": "Hand Spell", "keywords": [], "long_description": "You have one chance to escape a mysterious prison.\nWill you survive to make it to the surface ?\n\nFEATURES\n\n- Cast different spells using your own hands\n- Random / Roguelike elements to keep gameplay fresh each session\n- 20+ original enemies, fully hand crafted & animated\n- Seated experience and no motion sickness\n\nCONTENT\n\n- The full game contains 3 differents biomes, with various different rooms.\n- The goal is to reach the final floor and defeat the final boss.\n- Each run length is between 15 - 40 minutes, however you won't be able to beat the game in one run considering the difficulty and the random elements\n- The game include permanent upgrades to boost your character and unlock a Hard Mode", "short_description": "Turn-Based RPG with roguelike elements.\nEngage in 1 vs 1 battles and cast spells with your own hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://handspell.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "KOSMIQ", "support_website_url": "https://handspell.com/contact/", "website_url": "https://handspell.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5606466306035322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001723_292435928950857_474671855366408967_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54h0xTLrNJ0Q7kNvwH6NLre&_nc_oc=Admd2vM5lLNkpjaJUzznTgA6txFbia20w2_fGXJws0d-ZLp-kIsK0IhKpU-Nl0GcFko&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvY0wSn84bFIs2jcbQdpQyx-YuMC3I20uiBa8B2YtdVNQ&oe=6999B694"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hand Spell", "platform": "ANDRO
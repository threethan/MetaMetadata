yxCcUwK0Db-U01J3NqswCzjX-X1h5W5kyI_JvofVEYn4RPfGTM_TgEI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfseYtvqlts5xGATwnhRRjaZbcGZSTayBQVBkUNHH2HdBw&oe=69A417F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logohandspell.png", "id": "463063551564717", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031581_463063554898050_8381540247439495048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qlvYUJC5xAQ7kNvwGbhOg3&_nc_oc=AdltIiA15hhmtvu6nwOk_srQgLVbvx_GVrc_wmGbRSwwHAEu2vRh585rFxWtQ_xvbs4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftwfRRaz6r5_lBhy8dtRNsH77rhH4foyh5skZAaL_LpHQ&oe=69A42B98"}, "display_name": "Hand Spell", "keywords": [], "long_description": "You have one chance to escape a mysterious prison.\nWill you survive to make it to the surface ?\n\nFEATURES\n\n- Cast different spells using your own hands\n- Random / Roguelike elements to keep gameplay fresh each session\n- 20+ original enemies, fully hand crafted & animated\n- Seated experience and no motion sickness\n\nCONTENT\n\n- The full game contains 3 differents biomes, with various different rooms.\n- The goal is to reach the final floor and defeat the final boss.\n- Each run length is between 15 - 40 minutes, however you won't be able to beat the game in one run considering the difficulty and the random elements\n- The game include permanent upgrades to boost your character and unlock a Hard Mode", "short_description": "Turn-Based RPG with roguelike elements.\nEngage in 1 vs 1 battles and cast spells with your own hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://handspell.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "KOSMIQ", "support_website_url": "https://handspell.com/contact/", "website_url": "https://handspell.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
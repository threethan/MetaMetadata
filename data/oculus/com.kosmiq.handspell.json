20f&oh=00_AQEbMDjExYckDyIqsNy4HIL8NZCjMAlgotzScapOgmrYbg&oe=6A8ED910"}, {"file_name": "screenshoot_15_02_2021_15_33_45.png", "id": "796963244254312", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031646_796963247587645_1236731329101608783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKwC2aR2NUkQ7kNvwHsD_Fk&_nc_oc=Adq4loIAkkcUFMSzn-58K9-jbGEHTDyuBif6gC2yGzrFJCL8jq7UuA6Nd0m6S37tCHo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPvdHMFa4laFjNp-D07vtc8OT8w2gVn34GPMc84Rs6LQ&oe=6A8EC2F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logohandspell.png", "id": "463063551564717", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031581_463063554898050_8381540247439495048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLwLhTliZrkQ7kNvwEd40wZ&_nc_oc=AdquuSdmtMothRtkdrqIJ-qgIQsELK6MGX18WUjtKhbJ6DMQl-PKfIBMPknHiPQhTaY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsXso_yjqKxCcGj6wXGUjvB3Jf8QUWzdL3DNFc4nXhRg&oe=6A8ED698"}, "display_name": "Hand Spell", "keywords": [], "long_description": "You have one chance to escape a mysterious prison.\nWill you survive to make it to the surface ?\n\nFEATURES\n\n- Cast different spells using your own hands\n- Random / Roguelike elements to keep gameplay fresh each session\n- 20+ original enemies, fully hand crafted & animated\n- Seated experience and no motion sickness\n\nCONTENT\n\n- The full game contains 3 differents biomes, with various different rooms.\n- The goal is to reach the final floor and defeat the final boss.\n- Each run length is between 15 - 40 minutes, however you won't be able to beat the game in one run considering the difficulty and the random elements\n- The game include permanent upgrades to boost your character and unlock a Hard Mode", "short_description": "Turn-Based RPG with roguelike elements.\nEngage in 1 vs 1 battles and cast spells with your own hands."}]}, "developer_name": null, "developer_privacy_policy_url": "h
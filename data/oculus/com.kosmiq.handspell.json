20584753513_3767576710276366198_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztV0oOqo8OkQ7kNvwElUDPv&_nc_oc=Adru2ALP_xd5S8tC7lgf0tBg9gduUlgc45ErNFohtANp77H5MGJH17u1ftSFU_PnZZU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUT-d4OlTXSGYuyDcBeGfwAiDAi84yly6vU0Rr53xT1g&oe=69C14DA5"}, {"file_name": "screenshoot_15_02_2021_15_31_18.png", "id": "233323345192173", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031424_233323348525506_3156933618024086469_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_RyFEuceg0Q7kNvwFp7Acv&_nc_oc=AdoVwb9YOmNmIC7EgT7i9AdUcP5-qbWXDyDjH9kp1-iTdIzJuRUbBi0sLZkqQIBHjD4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzIKQ0uwVnWfBB9VzXb9esN1xd9rz72Sy5tsEKaWr_L_g&oe=69C12F10"}, {"file_name": "screenshoot_15_02_2021_15_33_45.png", "id": "796963244254312", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031646_796963247587645_1236731329101608783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x18LArJ8T4kQ7kNvwGCVByJ&_nc_oc=Adom5WD6zbKAcEEMYJqKg8aJxDhqvfgi3XRexocjg4ijGpdi0G7MRM2MUyPKB_dGYpA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3_irmPlMInoxJ_J633TIg5maB0tNbaV1O-aRU4uyqNg&oe=69C15138"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logohandspell.png", "id": "463063551564717", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031581_463063554898050_8381540247439495048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gE08DEbgIQQ7kNvwG-7qzj&_nc_oc=AdoSP8PljgZ7RSjlnn4zDRECGnF8x1VC9DNH1u9UsYN8hTvjf4kpx6WujM_JgKGY_m0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzWZvEcDiZJJI34VpRCQJCV-UmSA9UqtoN0u7wnhZ_A6Q&oe=69C12C98"}, "display_name": "Hand Spell", "keywords": [], "long_description": "You have one chance to escape a mysterious prison.\nWill you survive to make it to the surface ?\n\nFEATURES\n\n- Cast different spells using your own hands\n- Random / Roguelike elements to keep gameplay fresh each session\n- 20+ original enemies, fully hand crafted & animated\n- Seated experience and no motion sickness\n\nCONTENT\n\n- The full game contains 3 differents biomes, with various different rooms.\n- The goal is to reach the final floor and defeat the final boss.\n- Each run length is between 15 - 40 minutes, however you won't be able to beat the game in one run considering the difficulty and the random elements\n- The game include permanent upgrades to boost your character and unlock a Hard Mode", "short_description": "Turn-Based RPG with roguelike elements.\nEngage in 1 vs 1 battles and cast spells with your own hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://handspell.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "KOSMIQ", "support_website_url": "https://handspell.com/contact/", "website_url": "https://handspell.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5606466306035322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001723_292435928950857_474671855366408967_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaiR22k9m0gQ7kNvwEp3z9u&_nc_oc=Adpc-sGABU_Np6lqQmPy4jsypULFoadkmHdU46hiBSHIY8f6yFJnBJ6IDJXa5k64zi8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzTvDI6IIimCLPejvqgohV46hE8Xs8WTEqQ-SRsv0Ng2Q&oe=69C1
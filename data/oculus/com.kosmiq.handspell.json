.oculuscdn.com/v/t64.5771-25/86610712_464620584753513_3767576710276366198_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghe0po-DBdoQ7kNvwFyeCay&_nc_oc=AdqkpbP9kxC8fslN-YuRSYuZ7DQf5t3z_TwZyuRTonb-0le-cTDr-j-cQ5NyHddDA-c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1gZDI3oEems2mlX8yzNWL06mHMvxpf1ZwTtgOBQblAg&oe=6AA955A5"}, {"file_name": "screenshoot_15_02_2021_15_31_18.png", "id": "233323345192173", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031424_233323348525506_3156933618024086469_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2f_xUmPOeEQ7kNvwGuxTpQ&_nc_oc=AdpkXRH53A2R4DqSa2xJ6ocXnZ6zcnORvbJhI5KUjyjjdDUBykodoE0Pj7b23Wvl2sk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGQOLoYD2J5GQOTX0BJQd9zPBvDi0sWP1XG9oSEyYGmg&oe=6AA93710"}, {"file_name": "screenshoot_15_02_2021_15_33_45.png", "id": "796963244254312", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031646_796963247587645_1236731329101608783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIxZh152BtIQ7kNvwFSDWxa&_nc_oc=AdpfpBLHBwn-J1idOApkFwD15lWDu5X2EhLr3jDI8vsrXvCs6wk0WYmpRRv24mKKgPY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJt5lrYkV4KakOvejHdLfTQpSTQlI3CoFlPXFU9eXrOcw&oe=6AA95938"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logohandspell.png", "id": "463063551564717", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031581_463063554898050_8381540247439495048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIugtOlwSREQ7kNvwEOsO6d&_nc_oc=AdpIJRrALaDmNvLIMM6xIsKQQmAQyn5Y_m-m4wdpZtaaSAcCD4wu-UWSAnVdgzYbh6s&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcAK2LwtdiBJC8OLtnWg1eBvKDCM-GUOHu67QrBPS8eg&oe=6AA96CD8"}, "display_name": "Hand Spell", "keywords": [], "long_description": "You have one chance to escape a mysterious prison.\nWill you survive to make it to the surface ?\n\nFEATURES\n\n- Cast different spells using your own hands\n- Random / Roguelike elements to keep gameplay fresh each session\n- 20+ original enemies, fully hand crafted & animated\n- Seated experience and no motion sickness\n\nCONTENT\n\n- The full game contains 3 differents biomes, with various different rooms.\n- The goal is to reach the final floor and defeat the final boss.\n- Each run length is between 15 - 40 minutes, however you won't be able to beat the game in one run considering the difficulty and the random elements\n- The game include permanent upgrades to boost your character and unlock a Hard Mode", "short_description": "Turn-Based RPG with roguelike elements.\nEngage in 1 vs 1 battles and cast spells with your own hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://handspell.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "KOSMIQ", "support_website_url": "https://handspell.com/contact/", "website_url": "https://handspell.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5606466306035322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001723_292435928950857_474671855366408967_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XB14vOuJA4gQ7kNvwFBOpEp&_nc_oc=Adqd9S41h0u9u68JLUlgaRm-9_4_yg1SyeoX1lo7tVXqKVB0IXAllPXkeypYhSS1f_I&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=
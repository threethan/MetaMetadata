.oculuscdn.com/v/t64.5771-25/86610712_464620584753513_3767576710276366198_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b08FiN28xWEQ7kNvwHRoEFI&_nc_oc=AdrpTJkZLlFz8DU9sR3s8meE0ZvaN_EzSuVaWkvsraa_SXHK7Nx_5J3Z024FsrUvZ4M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HLeslsIYkv0Y9b8AclvqAyHWPEhpDEeCYKXtbgikTnA&oe=6A394625"}, {"file_name": "screenshoot_15_02_2021_15_31_18.png", "id": "233323345192173", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031424_233323348525506_3156933618024086469_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FePL4NWVV20Q7kNvwHVQru5&_nc_oc=AdoKeogswkaSBR4J1S8Er2-k-0fkrrx6D8YeikYPfIhDVTE0YkYQewAe-MYdruNQijA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jXNYnn0XV_86IYbqH9eNf_FzYyrefljl3sy4qOpaU7g&oe=6A395FD0"}, {"file_name": "screenshoot_15_02_2021_15_33_45.png", "id": "796963244254312", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031646_796963247587645_1236731329101608783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4frJ-1AlOQQ7kNvwEfB3E1&_nc_oc=AdqekZhHg7SnM-qvKYogIp5nNKYuhHemmVFQJ1TR6yPTM271O2uZv8HsGItyWB23tMg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80Kr8c060iRlRKApew6cxruoBRFBhMZ6ppgaIaCqQH-g&oe=6A3949B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logohandspell.png", "id": "463063551564717", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031581_463063554898050_8381540247439495048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJK0CFljTqgQ7kNvwGsUlrm&_nc_oc=Adr0s9S6VCYry3gI9zPEBrhYtBvkhKmL9flJWkIBGmqGzFh3FkzutTJUbrpSAAiheFc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-p1B_vo5fspuWSpxCz655C7jFPRkPbhQvwMYq26DeeZg&oe=6A395D58"}, "display_name": "Hand Spell", "keywords": [], "long_description": "You have one chance to escape a mysterious prison.\nWill you survive to make it to the surface ?\n\nFEATURES\n\n- Cast different spells using your own hands\n- Random / Roguelike elements to keep gameplay fresh each session\n- 20+ original enemies, fully hand crafted & animated\n- Seated experience and no motion sickness\n\nCONTENT\n\n- The full game contains 3 differents biomes, with various different rooms.\n- The goal is to reach the final floor and defeat the final boss.\n- Each run length is between 15 - 40 minutes, however you won't be able to beat the game in one run considering the difficulty and the random elements\n- The game include permanent upgrades to boost your character and unlock a Hard Mode", "short_description": "Turn-Based RPG with roguelike elements.\nEngage in 1 vs 1 battles and cast spells with your own hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://handspell.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "KOSMIQ", "support_website_url": "https://handspell.com/contact/", "website_url": "https://handspell.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5606466306035322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001723_292435928950857_474671855366408967_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziQvLxM_AxAQ7kNvwHsVN89&_nc_oc=AdrgaQVzN7qkJgmHYHblPIeh9TMy6V2FenOOGdjkH5I_E8KeRb1IdhOV9pBlhXr2CMo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=
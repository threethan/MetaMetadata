uPTZccqd5MAQ7kNvwGyCNge&_nc_oc=AdlUYIbzvS8RH6Cn7HGtWYW4zkeOtfYLXAhvYpN85ZebKjhA1tYqJfxrQX1D2Os4JMg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuYhq_ew6l0SfJyFIvRCf59R0IvtKLTr-MF6wWUKmb5qQ&oe=69A44CA5"}, {"file_name": "screenshoot_15_02_2021_15_31_18.png", "id": "233323345192173", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031424_233323348525506_3156933618024086469_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07pfNCOKbLcQ7kNvwGmgEE-&_nc_oc=Admx_xvCujIJAvBkgtAWTV_lmFYCmcxfO-7fA36hdQCCeweHu7qs58HCaEL52K6sflU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvbohvnQqaJqXiFb-RmSZAAlviSlCicYPbhbR7WoE5Fcg&oe=69A42E10"}, {"file_name": "screenshoot_15_02_2021_15_33_45.png", "id": "796963244254312", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031646_796963247587645_1236731329101608783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHIZZzDCysUQ7kNvwFMhvZZ&_nc_oc=AdkOkWbd7OCVyxCcUwK0Db-U01J3NqswCzjX-X1h5W5kyI_JvofVEYn4RPfGTM_TgEI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfseYtvqlts5xGATwnhRRjaZbcGZSTayBQVBkUNHH2HdBw&oe=69A417F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logohandspell.png", "id": "463063551564717", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031581_463063554898050_8381540247439495048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qlvYUJC5xAQ7kNvwGbhOg3&_nc_oc=AdltIiA15hhmtvu6nwOk_srQgLVbvx_GVrc_wmGbRSwwHAEu2vRh585rFxWtQ_xvbs4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftwfRRaz6r5_lBhy8dtRNsH77rhH4foyh5skZAaL_LpHQ&oe=69A42B98"}, "display_name": "Hand Spell", "keywords": [], "long_description": "You have one chance to escape a mysterious prison.\nWill you survive to make it to the surface ?\n\nFEATURES\n\n- Cast different spells using your own hands\n- Random / Roguelike elements to keep gameplay fresh each session\n- 20+ original enemies, fully hand crafted & animated\n- Seated experience and no motion sickness\n\nCONTENT\n\n- The full game contains 3 differents biomes, with various different rooms.\n- The goal is to reach the final floor and defeat the final boss.\n- Each run length is between 15 - 40 minutes, however you won't be able to beat the game in one run considering the difficulty and the random elements\n- The game include permanent upgrades to boost your character and unlock a Hard Mode", "short_description": "Turn-Based RPG with roguelike elements.\nEngage in 1 vs 1 battles and cast spells with your own hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://handspell.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "KOSMIQ", "support_website_url": "https://handspell.com/contact/", "website_url": "https://handspell.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5606466306035322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001723_292435928950857_474671855366408967_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Msgk0naFkboQ7kNvwFI0x5p&_nc_oc=Adke9_Grv67rwobSbOQ-gNPqcpjW5lcv88nLkhzgAWM_SsOPaRK_cLqiRCxnQCy70b0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsHH0oUV1k6EO-KmfZzcGd38iyt_H8rc8wzZvs6l9h5Jg&oe=69A44294"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hand Spell", "platform": "ANDRO
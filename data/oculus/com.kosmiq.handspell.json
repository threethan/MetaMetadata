v4qg8Rol6zYQ7kNvwHEoCOX&_nc_oc=Adk6yf1Et0yZEPAatQN4NpiW5io9R6O7sZ5Uiohc7ifN79YlL7vxokSIRGlwC4bwOlA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsRnogp02GXtx46IYdHL18niyKIW4AqJfxPB98fyx3IAg&oe=69986F25"}, {"file_name": "screenshoot_15_02_2021_15_31_18.png", "id": "233323345192173", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031424_233323348525506_3156933618024086469_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EA9jAcBH_wwQ7kNvwFKIfXV&_nc_oc=Adm1vs_WSZ5dTvLBcwyXRU1CnDtuHYkHFaIL7rXUUZS-kbMlJhZZQyc7iRc2_4tJVY8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvDyUQhxfAikf5guyItujyWJTlmG3n4SQBb34gL-mXcOg&oe=69985090"}, {"file_name": "screenshoot_15_02_2021_15_33_45.png", "id": "796963244254312", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031646_796963247587645_1236731329101608783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jM_xCpjsd_gQ7kNvwFZuoNs&_nc_oc=AdlgbM66KN25HuI_WjCuviADFsadTQk-3tsWGv3jyTR40bhE-UMVNnYv_r0Wem6enIM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftSa-0ENq0Je72Hg78OZv5NFMXVdmMXaZ_sJkF2SSpnHg&oe=699872B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logohandspell.png", "id": "463063551564717", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031581_463063554898050_8381540247439495048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRy91hCurYQQ7kNvwF_g0jp&_nc_oc=AdllE2DaZmq6HUIeKYVLtx8HHxHBZQ_bQ9zcPqMZUYtCCignw3x6626ZNEQ-w0IngwE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsK6P1zAfd1h6KjT88BVFnplwkQb9a10ZAr-qikdrH19A&oe=69984E18"}, "display_name": "Hand Spell", "keywords": [], "long_description": "You have one chance to escape a mysterious prison.\nWill you survive to make it to the surface ?\n\nFEATURES\n\n- Cast different spells using your own hands\n- Random / Roguelike elements to keep gameplay fresh each session\n- 20+ original enemies, fully hand crafted & animated\n- Seated experience and no motion sickness\n\nCONTENT\n\n- The full game contains 3 differents biomes, with various different rooms.\n- The goal is to reach the final floor and defeat the final boss.\n- Each run length is between 15 - 40 minutes, however you won't be able to beat the game in one run considering the difficulty and the random elements\n- The game include permanent upgrades to boost your character and unlock a Hard Mode", "short_description": "Turn-Based RPG with roguelike elements.\nEngage in 1 vs 1 battles and cast spells with your own hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://handspell.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "KOSMIQ", "support_website_url": "https://handspell.com/contact/", "website_url": "https://handspell.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5606466306035322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001723_292435928950857_474671855366408967_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54h0xTLrNJ0Q7kNvwE02Xab&_nc_oc=Adk3WGT00p7nGoHkx66J9bsRKDkOMtx_E9dOoGQlZSdqmdQ0eIuLzm4TGrKHa9dV-KM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft55rcGvIjVxWjZtsj3RlYg0bNyY1L9xOF7EnXYTXsxwg&oe=69986514"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hand Spell", "platform": "ANDRO
25ARhNwM8XeSn7Yr0U_9Tno-fvgYUbLq3-Nsj9luHFNF4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaQdarhoqGRI7ApJiHla6Yqqyb9faRQ-hlpJy40X8HtA&oe=6AAFF5F4"}, {"file_name": "Vault2.png", "id": "1363310284985925", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_1363310291652591_3118977239776581211_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOCKJicpkhgQ7kNvwEh2JcQ&_nc_oc=Adr46hLWzny8Mof-dR5Sk2kFloaZ7EoZLmBp8xCVT7T7AiLKg1iS-LGE06aN47tVhEA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHglZNuG9j4Yfzz1ubprGb7pZUioSCb1YDzJ_uskQvDQ&oe=6AAFDA19"}, {"file_name": "Vault1.png", "id": "1517497582841919", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820496_1517497586175252_7357218622333853040_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wg2UxpZDTegQ7kNvwED1thq&_nc_oc=AdqvIvXf1RMqegwwOhii5wZ0iv-jZ1XveDHtI2zAZTBobX7FsyHS_9rEvdq1djytblY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIelGCbA5LywPxTRSSrWkJdWh0-8SpLbrkxVPjlCj_KsA&oe=6AAFD524"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CLAUSTROFF_2560x1440_32bit_ZEN1.png", "id": "892285682894960", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984442_892285686228293_2375063388490034268_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDj2o2Oj9kgQ7kNvwHu_wFI&_nc_oc=Adp5Zh-lSR9lPLFisd_3v6Po5V8nmQ3NCaP1Hq1Wai2nzJIUutPB11nszyh3bDPDSxo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhauqKg8gGc8S2lJDWwulnVEf53ouL-OZAZRLkS3j5zg&oe=6AAFD21F"}, "display_name": "ClaustrOFF: Overcome Your Fears", "keywords": ["Relaxation", "ClaustrOFF", "Meditation", "Puzzle", "Escape"], "long_description": "Step inside an immersive VR experience built around tight, enclosed spaces.\n\nClaustrOFF takes you into confined environments \u2014 elevators, airplanes, tunnels, underground areas, and settings such as MRI scanners \u2014 each one rendered in detail and explored entirely at your own pace.\n\nThe full version includes multiple environments, including a pyramid and an underground shelter, and realistic simulations of elevators, airplanes, and MRI scans.\n\nThrough interactive challenges and structured guidance, ClaustrOFF walks you through breathing exercises, focus tasks, and puzzles set inside each space. The progression system lets you move forward chapter by chapter, at your own speed. Nothing is timed and nothing is scored against you \u2014 every space is built to be explored and replayed.\n\nKey features:\n- Five chapters of content, with puzzles, exploration, and quiet meditation spaces\n- Multiple immersive environments, from open rooms to very tight ones\n- Guided breathing and calming exercises\n- An in-game companion who introduces every environment\n- Move forward entirely at your own pace\n\nWhether you are new to VR, looking for a calm and structured experience, or simply curious about a new kind of challenge, ClaustrOFF offers a meaningful and structured path forward.\n\nClaustrOFF is an entertainment and general wellness experience. It is not a medical device and does not diagnose, treat, or cure any medical condition.", "short_description": "ClaustrOFF is an immersive VR experience set in tight, enclosed spaces. The full version includes multiple environments such as a pyramid and an underground shelter, as well as realistic simulations of elevators, airplanes, and MRI scans. Guided by an in-game companion, you explore each space at your own pace, solve puzzles, and follow breathing exercises along the way."}]}, "developer_name": "GAMETHERAPY s.r.o. & Fono Labs s.r.o.", "developer_privacy_policy_url": "https://gametherapy.eu/privacy-policy", "developer_terms_of_service_url": "https://gametherapy.eu/terms-of-use", "publisher_name": "GAMETHERAPY s.r.o.", "support_website_url": "https://gametherapy.eu/contact-us", "website_url": "https://gametherapy.eu/claustroff", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": []
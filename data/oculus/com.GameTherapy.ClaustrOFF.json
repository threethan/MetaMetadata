t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1nvYC6n_BuzwuL3etAXq1FG-L8L4S7wa-EtagIgcOmg&oe=6A7B1D13"}, {"file_name": "5.png", "id": "450248584797327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003271_450248588130660_5311813874858617613_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_ie-CqHTiYQ7kNvwGYoehP&_nc_oc=AdqGNrRueNYtvowPdGidhg84EDCLLhNsb8KPILTVIOAvsgc8YNIf631VSC9dZTSgNeA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3m0h9Jtongzw0SiR6TR5ARoyDK3ziLQ4P_6LMmGvJnw&oe=6A7B2DF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CLAUSTROFF_2560x1440_32bit_ZEN1.png", "id": "892285682894960", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984442_892285686228293_2375063388490034268_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CS3pn0ZSR6gQ7kNvwGIylwu&_nc_oc=Ado4z7sAPUIGG-nT6cZwJL54EzmO3Jm6GRSw9XglodTjCVdUtNSVNdmQPd6gMJT16a0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHV4brmoUwtZdk9peJZMGvKmeeI_LXevVyBZCJflo8Whw&oe=6A7B161F"}, "display_name": "ClaustrOFF: Overcome Your Fears", "keywords": ["Anxiety", "Fear", "Healing", "Relaxation", "Simulation"], "long_description": "ClaustrOFF is a groundbreaking VR game that helps you face and manage fears in a safe, engaging way. Combining proven scientific methods with fun gameplay, it guides you step-by-step to reduce fear, build resilience, and master stress management.\n\nEmbark on an adventure through unique environments, like a mysterious pyramid, where you\u2019ll learn to stay calm, control your thoughts, and tackle fears of confined spaces. Whether you\u2019re a gamer seeking exciting VR experiences or someone wanting to boost confidence, ClaustrOFF is for you.\n\nWith breathing exercises, mental strategies, and immersive design, ClaustrOFF isn\u2019t just about overcoming anxiety \u2013 it\u2019s about improving your daily life. Face your fears, grow stronger, and discover a new way to feel in control! \n", "short_description": "Take a new approach to fear and anxiety with ClaustrOFF. Through fun and interactive challenges, you\u2019ll learn to manage your thoughts and emotions in a safe environment. Download the first part of our VR game and start building confidence and calm today. "}]}, "developer_name": "GAMETHERAPY s.r.o. & Fono Labs s.r.o.", "developer_privacy_policy_url": "https://gametherapy.eu/privacy-policy", "developer_terms_of_service_url": "https://gametherapy.eu/terms-of-use", "publisher_name": "GAMETHERAPY s.r.o.", "support_website_url": "https://gametherapy.eu/claustroff", "website_url": "https://gametherapy.eu/claustroff", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8701771193283915"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "2124250944974210"}, {"status": "PUBLISHED", "id": "907898595492325"}, {"status": "PUBLISHED", "id": "853142407750741"}, {"status": "PUBLISHED", "id": "935042785758318"}, {"status": "PUBLISHED", "id": "1581240833018089"}, {"status": "PUBLISHED", "id": "1182969597312129"}, {"status": "PUBLISHED", "id": "1228942988857244"}, {"status": "PUBLISHED", "id": "1171954547868634"}, {"status": "PUBLISHED", "id": "1006110118231257"}, {"status": "PUBLISHED", "id": "1462180588504152"}]}, "baseline_offer": {"id": "907898595492325"}, "is_approved": true, "firstOffe
dn.com/v/t64.5771-25/75340710_601338915529566_1502035695132145473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-eCIyfFOEIQ7kNvwHLf6zQ&_nc_oc=AdqwEBVeTJOGbLf4vM1cdga0UbH3rwA8dAhseL4tv4tFDF3ZaxVmx4t3VFSt2Q138nE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNTeJQKGEoLLkS7iWaATYwngpa7KI53pp5egzMGWhU_Q&oe=6A8ED1EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Livro_Quest_CoverArt_Landscape.png", "id": "575986887836537", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982569_575986891169870_9029303468985192594_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WzXPgxqC8eQQ7kNvwFJuMnm&_nc_oc=Adp2gr1I5rvSu0rs5J8Yn4X0HG_RaPtwi6a4qmYiXcqJ_D-5lVLainjLywA6DJdPRDI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6WGzvmfEsQS27Cnp-LrDy6hTHBURcc5FDARmPpiM2hw&oe=6A8ED8C1"}, "display_name": "Livro", "keywords": [], "long_description": "Livro is an XR reader app designed to bring the real-life physicality of interacting with books into the digital medium.\n\nImport your favorite novels, comic books, or manga and customize a digital replica that you can grab, manipulate, and flip through. \n\nRead in VR for maximum immersion or remain aware of your surroundings using pass-through. \n\n* The app currently supports pdf, cbz, and zip files.", "short_description": "Livro is an XR reader app designed to bring the real-life physicality of interacting with books into the digital medium.\n\nImport your favorite novels, comic books, or manga and customize a digital replica that you can grab, manipulate, and flip through. \n\nRead in VR for maximum immersion or remain aware of your surroundings using pass-through. \n\n* The app currently supports pdf, cbz, and zip files."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chronicbite.github.io/livro/privacy", "developer_terms_of_service_url": "https://chronicbite.github.io/livro/terms", "publisher_name": "ChronicBite", "support_website_url": null,
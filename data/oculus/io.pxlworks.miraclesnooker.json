}, {"file_name": "ss_3.png", "id": "1833973877725190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828583_1833973881058523_3682102317298841312_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlcckHf1w8oQ7kNvwHyPM5u&_nc_oc=AdoS-n5hGJwQ4eHpwmPd5vZM22MGm_jwAw-pXK_Ct2n1TiOhURFT-NKTRUh9W0bcyWg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrrZbWqQlSX3g71jxDj2EOXsn0Fr2vDJrGDSRF3uZHDw&oe=6AFDDCB1"}, {"file_name": "ss_4.png", "id": "1663674341783421", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_1663674345116754_6299406797254792153_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pU0gQ16Ag4Q7kNvwGd299O&_nc_oc=Adqz2RTtQwFchhyqOPcow4cNBV6TpNcpKwEj-mUt-09fexcBBaB8kHhyIn-Vj4vpLRI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrBQxglEiNCCMwKtemccBu-tPLQJcHOdEHirzFuuohQw&oe=6AFDACF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_16_9_v2.png", "id": "4188423008118818", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_4188423011452151_3172539498552545056_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZKxz9D4WSYQ7kNvwHWHkhd&_nc_oc=Adpeg_2DGahBhFZM1jSxSJIZ56ChCm9-McWap7nKJPom5yHNDY-xkM0NdZY1C0KYHfY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpJ4-U_cN3KbNgEu1pEL6yuLJlPWUBlrepd-16AuMaZg&oe=6AFDCCC3"}, "display_name": "MiRacle Snooker", "keywords": ["Snooker", "Pool", "Billiard", "Sport", "MR"], "long_description": "Turn your real-world space into your own snooker room with MiRacle Snooker!\n\nBuilt for Mixed Reality, MiRacle Snooker places a virtual snooker table directly into your real environment, combining the presence of physical play with the convenience of VR. Have enough space? Go for the full-size experience. Playing in a smaller room? Choose a smaller table and enjoy snooker without needing a dedicated snooker hall.\n\nWhether you want to practice, compete, or simply play with friends, MiRacle Snooker gives you multiple ways to enjoy the game.\n\n# PRACTICE\nPlay alone with complete freedom. Take your time, experiment with shots, work on your technique, or simply enjoy the table at your own pace.\n\n# PLAY AGAINST AI\nChallenge 9 AI opponents with different skill levels. Start with an easier opponent or test yourself against increasingly capable players.\n\n# ONLINE MULTIPLAYER\nCompete against players from around the world. \n\n# PRIVATE ROOMS\nWant to play with someone you know? Create a private room and enjoy a match with your friends.\n\nWith realistic snooker gameplay, flexible table sizes, online multiplayer, AI opponents, and the unique presence of Mixed Reality, MiRacle Snooker brings the snooker experience home \u2014 without needing the space for a real table.\n\nPlace your table. Pick up your cue. Start your break.\n\nWelcome to MiRacle Snooker.", "short_description": "Bring a snooker table into your own room with MiRacle Snooker! Experience realistic Mixed Reality snooker on a full-size or space-friendly table. Practice freely, challenge 9 AI opponents, compete in online matches, or play privately with friends."}]}, "developer_name": "Pixel Works Studios", "developer_privacy_policy_url": "https://www.pxlworks.io/miraclesnooker_pp", "developer_terms_of_service_url": null, "publisher_name": "Pixel Works Studios", "support_website_url": null, "website_url": "https://www.pxlworks.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
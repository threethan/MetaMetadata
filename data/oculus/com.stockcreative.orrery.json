a&_nc_ohc=HYKGzw80IukQ7kNvwHmE7FF&_nc_oc=Ado5kuX2M4ZjxtEgYnJR9F9X_2KPMEuS99CsRNph-_MWKtMvZkLf0hQ8ri6QtPrZBF0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0zD5Viw4tBxXBGxTX-KjxWyn6fBK2T4fC3hMzt-jK1A&oe=6AFB3024"}, {"file_name": "screenshot-1-alignment.png", "id": "1005930632535169", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491830904_1005930639201835_6987101909884018828_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYSKYi5-11YQ7kNvwGMmG67&_nc_oc=AdpTZSw3cZHC-9EWUhI8uDJZ9MRexdNgfaQM8eKKjn7tsYHQ3tElU5ddEIF2N-FAnWs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSx7rh87lAWxM2DocuMJ_jqC6AO_SrIVYrwK2HRAw-gjA&oe=6AFB43C6"}, {"file_name": "screenshot-4-moons.png", "id": "1648043520236033", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491831393_1648043523569366_1043769257316157600_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGLiHWoPaFMQ7kNvwGJbkMP&_nc_oc=Adr-7HYAFWdvrUzoQYSuF9UKfmiWRGY4fWE1qcwdJjRllwJZI9_PLk-7gK_8c5MqbdQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJ8Rm8zuDQ_KVloVT-4HVasQz1xJc7oDQcyuCle0WbXA&oe=6AFB2C92"}, {"file_name": "screenshot-5-spiral.png", "id": "1100777082812173", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491830904_1100777086145506_6071435689086224047_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsb_h1blLogQ7kNvwFxeXaY&_nc_oc=AdoWJ2YszdS8daVibO4_7AZNHj8FIMSSQHycQyo46vL0XNL8c86g1HQ1qgVkaHkzRWY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZiobEjvfsWREMQLS0oPd7Bdys_aRZs78VkKZofGQ66w&oe=6AFB3B97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "universal-basic.png", "id": "1152553820442784", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673759338_1152553823776117_6844216478563381854_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtyMeyZxER4Q7kNvwGsEq_F&_nc_oc=AdoIOF-crTieWCZTz7yEVRVkBQ_7iOI_ho4kY_4fAAWJY8KgO7U7rgiZzOJNwIqWpmU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6v5ix-7kBjrpe1PHoEUXHmnsj6T2l14wJEsCPr-sJ1g&oe=6AFB4A5C"}, "display_name": "Orrery", "keywords": ["Puzzle", "Space"], "long_description": "A solar system turns below you, drawn in pure white vector light. In your hand: a comet.\n\nThrow it, and the star pulls it in. Every planet tugs at it as it passes. Swing past a world and slingshot onward; thread a line through\nthree beacons with a single throw. Each of Orrery's 99 levels is a small puzzle of real gravity, and every one is proven solvable in\npar.\n\n  - 99 levels in nine chapters, each bringing a new idea: aligned beacons, swaying beacons, crowded moons, linked pairs, golden beacons\nthat only count after a chain, numbered sequences and more.\n- Real orbital physics: the star and every planet and moon pull on every comet, and planets move at their true orbital speeds.\n- Combos on the Fibonacci sequence. Chain slingshots and strikes in one flight and keep a streak going across throws to multiply your\nscore and earn comets back.\n- Rate yourself against par on every level, and chase three golden spirals on all 99.\n- Every size and distance in the game is built on the golden ratio, from the spacing of the orbits to the letters on the screen.\n- A sparse twelve-tone heartbeat score that\nquickens the longer you think.\n\nYou stand still and the system stays where it is, so it's comfortable to play seated or standing.", "short_description": " Throw comets through a living solar system. Bend them around planets, chain slingshots and strike every golden spiral in 99 hand-built puzzles of gravity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://atonalfugue-ecfggyfue0efbwhm.westus-01.azurewebsites.net/orrery/privacy", "developer_terms_of_service_url": null, "publisher_name": "Atonal Fugue", "support_website_url": null, "website_url": "https://atonalfugue-ecfggyfue0efbwhm
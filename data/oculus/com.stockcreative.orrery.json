a&_nc_ohc=frsCp-IuNzQQ7kNvwF5cghK&_nc_oc=Ado-0lQ2x0mnci_i4V0UMuDj91b3A4feUHZb4sq_2lHyLqmwd7UplN13-gmNgImhr3Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsVmGHgUIPVNTvCwcPwz_gCYxyWgs7UjI5jYvBHaVOSw&oe=6AFC81A4"}, {"file_name": "screenshot-1-alignment.png", "id": "1005930632535169", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830904_1005930639201835_6987101909884018828_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYSKYi5-11YQ7kNvwGcSauN&_nc_oc=Adq_EO_Tz8nR6m8QH4w0n0koILSPtWCfl6uk0HhuIECax56UgrCANMg67KpTjPnRPU4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXdrf_xOjDbAd8akKJep9wK_oD2GWGWIIWZaYameuFPA&oe=6AFC9546"}, {"file_name": "screenshot-4-moons.png", "id": "1648043520236033", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831393_1648043523569366_1043769257316157600_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGLiHWoPaFMQ7kNvwGWKyd6&_nc_oc=Adpml71kUjXql_ViWTp8x7JJ_DdA4r0aCnyUnrb2hEzoge6s5qYV8lZNwM5QFmLOuUo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkhXnyFPi8RDrVBFqkcerzFcflU4m2rQ3zno0IdDizdw&oe=6AFC7E12"}, {"file_name": "screenshot-5-spiral.png", "id": "1100777082812173", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830904_1100777086145506_6071435689086224047_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsb_h1blLogQ7kNvwGLLiGh&_nc_oc=AdoGFaIyWYQ8wyFZzYK47gOSUDziQIM7CjE-ZY2ppgCP0aa4VBwmRecGaSg6dw3Jljw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJZ1qXou60DgKlOODTjG6_3FpOGmskLOZSGJCjVw0zkA&oe=6AFC8D17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "universal-basic.png", "id": "1152553820442784", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673759338_1152553823776117_6844216478563381854_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rF-UHGEQgKoQ7kNvwGNhrNl&_nc_oc=Ado4G-AgCaCcXv_SVexB8FVIrflaSgh9jNc-6wxA7AZhiiEPyMtM6UiXeM9Yz5PKqqU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_8MnCDsxzOySm1vCldXbdvNf9bSGgmVXTf-0xtVbxlQ&oe=6AFC639C"}, "display_name": "Orrery", "keywords": ["Puzzle", "Space"], "long_description": "A solar system turns below you, drawn in pure white vector light. In your hand: a comet.\n\nThrow it, and the star pulls it in. Every planet tugs at it as it passes. Swing past a world and slingshot onward; thread a line through\nthree beacons with a single throw. Each of Orrery's 99 levels is a small puzzle of real gravity, and every one is proven solvable in\npar.\n\n  - 99 levels in nine chapters, each bringing a new idea: aligned beacons, swaying beacons, crowded moons, linked pairs, golden beacons\nthat only count after a chain, numbered sequences and more.\n- Real orbital physics: the star and every planet and moon pull on every comet, and planets move at their true orbital speeds.\n- Combos on the Fibonacci sequence. Chain slingshots and strikes in one flight and keep a streak going across throws to multiply your\nscore and earn comets back.\n- Rate yourself against par on every level, and chase three golden spirals on all 99.\n- Every size and distance in the game is built on the golden ratio, from the spacing of the orbits to the letters on the screen.\n- A sparse twelve-tone heartbeat score that\nquickens the longer you think.\n\nYou stand still and the system stays where it is, so it's comfortable to play seated or standing.", "short_description": " Throw comets through a living solar system. Bend them around planets, chain slingshots and strike every golden spiral in 99 hand-built puzzles of gravity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://atonalfugue-ecfggyfue0efbwhm.westus-01.azurewebsites.net/orrery/privacy", "developer_terms_of_service_url": null, "publisher_name": "Atonal Fugue", "support_website_url": null, "website_url": "https://atonalfugue-ecfggyfue0efbwhm
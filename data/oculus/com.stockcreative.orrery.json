Z365-MxY_sNvZBzPL_pZm-bwo0rBahB7ravu5w&oe=6AF9DEA4"}, {"file_name": "screenshot-1-alignment.png", "id": "1005930632535169", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830904_1005930639201835_6987101909884018828_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSvS0whi3dgQ7kNvwH8hchB&_nc_oc=Ado6TzD_qpuVCjcygTCckABCm8sBIQMO0U7FXyFWbVqttpG-Ec0C7ApBzeUlQpLtJMI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNxaV0IKhnvWF7OGsLpAxqgVjvVRWq244lV2Wmd-whog&oe=6AF9BA06"}, {"file_name": "screenshot-4-moons.png", "id": "1648043520236033", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491831393_1648043523569366_1043769257316157600_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFvVt0UMcqUQ7kNvwE8dP7E&_nc_oc=Adrbf1jv4kJlS2PW_zJ_ZGqPjSbeRpA4nhUuASsQPfs22JxR0GvyYzh91GDHk6vmURU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaUfz0Vf_qctwSKOm_WC6GAVbCbu-lYe1YlSt7k2Wj1w&oe=6AF9DB12"}, {"file_name": "screenshot-5-spiral.png", "id": "1100777082812173", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491830904_1100777086145506_6071435689086224047_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mzcXni9Yg4Q7kNvwGiSHPU&_nc_oc=AdrGUNsHe6HZJRd34hR4YUQPrSMUby8gywCg2ddPDG1arCuV1iAeD_57cn11UsIE4m0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMHTuSyFDQxLvuTn8M8tCZwxEWUAZrxK8foeAPkoFfOw&oe=6AF9EA17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "universal-basic.png", "id": "1152553820442784", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/673759338_1152553823776117_6844216478563381854_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtyMeyZxER4Q7kNvwHhCIvb&_nc_oc=Adrn4Nxv5ZTen9xgNzUmTynyXwnf13BltIp2bwu8wBQ4vJ5I_edhMsEUBQMygsqE1pQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4DXe79Zp-bjckNGDrQ5H1n0Bq2lQIRvAHeM_oVK_mvw&oe=6AF9C09C"}, "display_name": "Orrery", "keywords": ["Puzzle", "Space"], "long_description": "A solar system turns below you, drawn in pure white vector light. In your hand: a comet.\n\nThrow it, and the star pulls it in. Every planet tugs at it as it passes. Swing past a world and slingshot onward; thread a line through\nthree beacons with a single throw. Each of Orrery's 99 levels is a small puzzle of real gravity, and every one is proven solvable in\npar.\n\n  - 99 levels in nine chapters, each bringing a new idea: aligned beacons, swaying beacons, crowded moons, linked pairs, golden beacons\nthat only count after a chain, numbered sequences and more.\n- Real orbital physics: the star and every planet and moon pull on every comet, and planets move at their true orbital speeds.\n- Combos on the Fibonacci sequence. Chain slingshots and strikes in one flight and keep a streak going across throws to multiply your\nscore and earn comets back.\n- Rate yourself against par on every level, and chase three golden spirals on all 99.\n- Every size and distance in the game is built on the golden ratio, from the spacing of the orbits to the letters on the screen.\n- A sparse twelve-tone heartbeat score that\nquickens the longer you think.\n\nYou stand still and the system stays where it is, so it's comfortable to play seated or standing.", "short_description": " Throw comets through a living solar system. Bend them around planets, chain slingshots and strike every golden spiral in 99 hand-built puzzles of gravity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://atonalfugue-ecfggyfue0efbwhm.westus-01.azurewebsites.net/orrery/privacy", "developer_terms_of_service_url": null, "publisher_name": "Atonal Fugue", "support_website_url": null, "website_url": "https://atonalfugue-ecfggyfue0efbwhm.westus-01.azurewebsites.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "gen
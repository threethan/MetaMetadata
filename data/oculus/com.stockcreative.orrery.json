a&_nc_ohc=frsCp-IuNzQQ7kNvwFlI1bi&_nc_oc=Ado2hUdk_6VRG8LtCFtAo8WBeQe6Trbdqu5SSZR-FmJcbs1qFTZO-u0YMnUFqzX-bUc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK0wAqMvXEiAjEq1yLzqbfLUXKtJs4m-60ZHBFx2Ny8w&oe=6AFDD324"}, {"file_name": "screenshot-1-alignment.png", "id": "1005930632535169", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830904_1005930639201835_6987101909884018828_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYSKYi5-11YQ7kNvwE8Ahii&_nc_oc=AdpsmEHIoMOw8mkqlf2ahhpuYswkMamqp12JXXG_WHDYXykuWTg8w5HQv54pHMv5lI0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRj1jOV_w_vvtGaUB8Sr4Tcmtdwr5D0NK9hR_wanKa8iw&oe=6AFDAE86"}, {"file_name": "screenshot-4-moons.png", "id": "1648043520236033", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831393_1648043523569366_1043769257316157600_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGLiHWoPaFMQ7kNvwE8WWfj&_nc_oc=Adr6-1he-tJi56xM_0HrBlV3uBqzbcsWA--HigbEmLZcTi6XDcbE8DmJwERlmwJMnY0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQibfDVi0Gz2mrlvZVqr-vOlsR6U0aWLae1XEd4lx1nlA&oe=6AFDCF92"}, {"file_name": "screenshot-5-spiral.png", "id": "1100777082812173", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830904_1100777086145506_6071435689086224047_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsb_h1blLogQ7kNvwEADiDt&_nc_oc=AdryOFMLrpSM58tOedZjO5XRNKTYU4LZxiACEvA-6Ssjdg5HxebjKxhKeScFb1_aUug&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7qNL08pmrVAZS5k5OdO6cpYUUP_mHTI6Qj81BcYTfYA&oe=6AFDDE97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "universal-basic.png", "id": "1152553820442784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673759338_1152553823776117_6844216478563381854_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rF-UHGEQgKoQ7kNvwGosnYE&_nc_oc=AdpXldihKeVtzIYh72NR3wGX42iQ1rrykqFK7MAqZB7uW4u1jKWcKA-82sO1SXzhxwI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT4S_UVBa-rbLhvSmlsjlQplDLGADgIYTXNoNht0ahgw&oe=6AFDB51C"}, "display_name": "Orrery", "keywords": ["Puzzle", "Space"], "long_description": "A solar system turns below you, drawn in pure white vector light. In your hand: a comet.\n\nThrow it, and the star pulls it in. Every planet tugs at it as it passes. Swing past a world and slingshot onward; thread a line through\nthree beacons with a single throw. Each of Orrery's 99 levels is a small puzzle of real gravity, and every one is proven solvable in\npar.\n\n  - 99 levels in nine chapters, each bringing a new idea: aligned beacons, swaying beacons, crowded moons, linked pairs, golden beacons\nthat only count after a chain, numbered sequences and more.\n- Real orbital physics: the star and every planet and moon pull on every comet, and planets move at their true orbital speeds.\n- Combos on the Fibonacci sequence. Chain slingshots and strikes in one flight and keep a streak going across throws to multiply your\nscore and earn comets back.\n- Rate yourself against par on every level, and chase three golden spirals on all 99.\n- Every size and distance in the game is built on the golden ratio, from the spacing of the orbits to the letters on the screen.\n- A sparse twelve-tone heartbeat score that\nquickens the longer you think.\n\nYou stand still and the system stays where it is, so it's comfortable to play seated or standing.", "short_description": " Throw comets through a living solar system. Bend them around planets, chain slingshots and strike every golden spiral in 99 hand-built puzzles of gravity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://atonalfugue-ecfggyfue0efbwhm.westus-01.azurewebsites.net/orrery/privacy", "developer_terms_of_service_url": null, "publisher_name": "Atonal Fugue", "support_website_url": null, "website_url": "https://atonalfugue-ecfggyfue0efbwhm
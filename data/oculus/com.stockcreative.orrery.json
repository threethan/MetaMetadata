oons.png", "id": "1648043520236033", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831393_1648043523569366_1043769257316157600_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3PKGk6wbcUQ7kNvwH3NnXU&_nc_oc=AdroU9UotW011R1WL00kj8-R7qwZ36mcdikGxV_DL71_Z_bYF5R636fX35oCkpFvMX0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrOqa9sqcJAsrZOYsvowipo1PbuKFG-EX8kJWT6GxEeg&oe=6B070A12"}, {"file_name": "screenshot-5-spiral.png", "id": "1100777082812173", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830904_1100777086145506_6071435689086224047_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lhabrxNL94Q7kNvwHcgNl2&_nc_oc=AdpCRfI_N1giNq-Z4-j1VDv70U9p283TY39m8CJI6u9MCIf2DyYW_mqFg5HKBFyl0HM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeO2Ki-tONi9dx61Fsop_5su6ZWvybHyHzojW1BdldVw&oe=6B071917"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "universal-basic.png", "id": "1152553820442784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673759338_1152553823776117_6844216478563381854_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuGts-ar-10Q7kNvwEwXXEK&_nc_oc=Ado711LeiqaOQw5ulKCat0rcIZevPDV1gCmLUcQIpM19kvAeiUzSSZY4gvAzF2JGZps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpfbAPICnbRF2Hnm2YjdH1J0zKI-E1ceaS202UBZiarQ&oe=6B0727DC"}, "display_name": "Orrery", "keywords": ["Puzzle", "Space"], "long_description": "A solar system turns below you, drawn in pure white vector light. In your hand: a comet.\n\nThrow it, and the star pulls it in. Every planet tugs at it as it passes. Swing past a world and slingshot onward; thread a line through\nthree beacons with a single throw. Each of Orrery's 99 levels is a small puzzle of real gravity, and every one is proven solvable in\npar.\n\n  - 99 levels in nine chapters, each bringing a new idea: aligned beacons, swaying beacons, crowded moons, linked pairs, golden beacons\nthat only count after a chain, numbered sequences and more.\n- Real orbital physics: the star and every planet and moon pull on every comet, and planets move at their true orbital speeds.\n- Combos on the Fibonacci sequence. Chain slingshots and strikes in one flight and keep a streak going across throws to multiply your\nscore and earn comets back.\n- Rate yourself against par on every level, and chase three golden spirals on all 99.\n- Every size and distance in the game is built on the golden ratio, from the spacing of the orbits to the letters on the screen.\n- A sparse twelve-tone heartbeat score that\nquickens the longer you think.\n\nYou stand still and the system stays where it is, so it's comfortable to play seated or standing.", "short_description": " Throw comets through a living solar system. Bend them around planets, chain slingshots and strike every golden spiral in 99 hand-built puzzles of gravity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://atonalfugue-ecfggyfue0efbwhm.westus-01.azurewebsites.net/orrery/privacy", "developer_terms_of_service_url": null, "publisher_name": "Atonal Fugue", "support_website_url": null, "website_url": "https://atonalfugue-ecfggyfue0efbwhm.westus-01.azurewebsites.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1446125028574055"}}]}, "scheduled_
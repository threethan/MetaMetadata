a&_nc_ohc=nA97Nmtneq4Q7kNvwHPvtgU&_nc_oc=AdptwCjI3KC1fOU8RyjCFSu5pttwd0NEr-zNQzc2lbVCp97-t5gebfzd-lQaHCw4-hc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl4r7vrVokj4kfkhU9SOoGdAYCF25uOfQBeQJ70CQhsA&oe=6B046AA4"}, {"file_name": "screenshot-1-alignment.png", "id": "1005930632535169", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830904_1005930639201835_6987101909884018828_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10zbtt9Inl4Q7kNvwFQWvg3&_nc_oc=AdqXXRGF43Q4d7_5ULIDBQtp7KN9a1z16c-G2FBcXv8SFcTRhoJYkyV-1F48ERYAK6k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3SDY6gO4BRjYgHeMbL6t-Eg_JQx86AvTTA3P5I1bDkA&oe=6B047E46"}, {"file_name": "screenshot-4-moons.png", "id": "1648043520236033", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831393_1648043523569366_1043769257316157600_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjHUBfJ3OQgQ7kNvwH6Vr_G&_nc_oc=Adpc6uSX_7KnsPBCjJ05u2EkIIFvPLdOX-MXBUPdCmlWHZwJrFQoUHwtbfWVru8dx-8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9pjuGI7qWZKhvV5i7MkOm_djQW41addAmJOwzorrk1A&oe=6B046712"}, {"file_name": "screenshot-5-spiral.png", "id": "1100777082812173", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830904_1100777086145506_6071435689086224047_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6xVKRRCMNYQ7kNvwGpdr0L&_nc_oc=AdoY3QJifUd-KIyPKidUVT_bQHg7env1AhyranhDWTMZDtrKP5UUGSG54_7uMeNvorU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRr_Z19O199cR5Z24MomvUIoy_vQLx947aK0zUrmU8-IQ&oe=6B047617"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "universal-basic.png", "id": "1152553820442784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673759338_1152553823776117_6844216478563381854_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuGts-ar-10Q7kNvwGALW6f&_nc_oc=AdrwIeA2onnAzS5Jluuvr_aZrF5L1-7iIVHectigpR4M423ZOTeTctEhZks_3PuAsf0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjnRQltvDIEHDj3XEea7qw6E7ZBPqMMk2bkoEMwYbxMw&oe=6B0484DC"}, "display_name": "Orrery", "keywords": ["Puzzle", "Space"], "long_description": "A solar system turns below you, drawn in pure white vector light. In your hand: a comet.\n\nThrow it, and the star pulls it in. Every planet tugs at it as it passes. Swing past a world and slingshot onward; thread a line through\nthree beacons with a single throw. Each of Orrery's 99 levels is a small puzzle of real gravity, and every one is proven solvable in\npar.\n\n  - 99 levels in nine chapters, each bringing a new idea: aligned beacons, swaying beacons, crowded moons, linked pairs, golden beacons\nthat only count after a chain, numbered sequences and more.\n- Real orbital physics: the star and every planet and moon pull on every comet, and planets move at their true orbital speeds.\n- Combos on the Fibonacci sequence. Chain slingshots and strikes in one flight and keep a streak going across throws to multiply your\nscore and earn comets back.\n- Rate yourself against par on every level, and chase three golden spirals on all 99.\n- Every size and distance in the game is built on the golden ratio, from the spacing of the orbits to the letters on the screen.\n- A sparse twelve-tone heartbeat score that\nquickens the longer you think.\n\nYou stand still and the system stays where it is, so it's comfortable to play seated or standing.", "short_description": " Throw comets through a living solar system. Bend them around planets, chain slingshots and strike every golden spiral in 99 hand-built puzzles of gravity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://atonalfugue-ecfggyfue0efbwhm.westus-01.azurewebsites.net/orrery/privacy", "developer_terms_of_service_url": null, "publisher_name": "Atonal Fugue", "support_website_url": null, "website_url": "https://atonalfugue-ecfggyfue0efbwhm
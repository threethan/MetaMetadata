9100670732_107982010090540302_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35Np-0sGuxQQ7kNvwExOs7m&_nc_oc=Adnoo36Csk6dIvUfulBWf_o9b2UfK8RceAClAR6QsDMciENqvKEwdA8yTDyjEyR6xG4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftq-HbM7WOAoFbogFBG1PrxFVeOcPvBDaO7oPmfrryLwg&oe=69A2F4DF"}, {"file_name": "07.screenshot5.png", "id": "1519162608908510", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974677_1519162612241843_7878301806063683664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPTytaK6wNMQ7kNvwGPy17s&_nc_oc=Adnq2ORUdnV-gtb3G-8Kq1tVe_dKTcE8r2MW2yYzvZBOLnjMV_3zlVcWR9rDCCOhAXY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuJCdcr3UVZgFFc3A9QXwp9aACvUeN2Rga9DlMaI2Vxug&oe=69A2D38F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "09.cover_image.png", "id": "881426556537495", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75441573_881426559870828_6481680701268712536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezoWd5auCAAQ7kNvwE1tEyU&_nc_oc=AdlXuLf9VcGWFQg1RBQ7BlJM0oMLtw1bnlhidlMeIZX2shCTn8ZEx6Sl_fNgYLMBwsk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsTijpqbgH5zZ20yso0cWTPVq9lP52dwmguuGAt3tmx2Q&oe=69A2CBCF"}, "display_name": "Laboratory Safety Training", "keywords": [], "long_description": "\"Dive into the realm of realistic experiments through Virtual Reality (VR). Experience the excitement of conducting actual reactions in a risk-free digital laboratory. Mix substances, observe genuine changes, and engage with lifelike molecular structures\u2014all in an immersive 3D environment. Enhance your learning by interacting with accurate representations of laboratory equipment and substances, all while honing your scientific skills. Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other.", "short_description": "Explore the world of chemistry in an unprecedented way, where hands-on experimentation
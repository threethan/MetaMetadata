uluscdn.com/v/t64.5771-25/11162721_196010817566642_7926983209923903488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_Hf2l3wkFkQ7kNvwGqS0YI&_nc_oc=Adqzcu5xskzXvkBiG64axR8KVAGBVEnt0Vf6eeZ7QPVzEw7c2HSFZbtMMVqen_5OiTg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgMQNieS3rPQ66vHecg6igCjhbpz0aTbKpYrgwVF4SwQ&oe=69C5121B"}, {"file_name": "migrated_image.png", "id": "530644144255213", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162813_1881500155398518_4891445636739629056_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2yf7YIY9AgQ7kNvwHoKZtP&_nc_oc=Ado6Iew4JjfY8cKNg_o7C8g8grHdl-y9LvmqmxSyE-O7Bvk_pVp4_ZLA8h6ss_34Z8c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPAznh7nPHOUMyCan5yeuK6PIuGj6kYSO-E9yNh7h5fw&oe=69C541EF"}, {"file_name": "migrated_image.png", "id": "500650760568909", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12482153_279482502489255_475938494439489536_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9YgGzH7EBMQ7kNvwE-hSA9&_nc_oc=Adqt8czpH6SOxDikV3XEX436g90jv2SuolVq1US6m7SHgUX090kSGOretTL3Wqkvtbo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyfBitkEX1vQlj-abqJ2GJxGsLPQSCt1FqgxXpgq75C9g&oe=69C53D7E"}, {"file_name": "migrated_image.png", "id": "205154524067984", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162716_1822152104706235_5142970333321494528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-SnBHr5ystcQ7kNvwGKsb1C&_nc_oc=AdpK5be1uRuFlOV-RNuLnE2L3rwpIPh5FdU46g2A_vFYb4qVUdlR-lvoQiPKQbVfRGo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyDgaR0Xy-t3LyiLSCjVK_82eojvswghSViJrD7G_pbVw&oe=69C51948"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Radial-G: Infinity-X", "keywords": ["radial", "Endless", "runner", "arcade", "infinite"], "long_description": "\"Radial-G : Infinity-X\" pits you against the deadly invasion force attacking the Radial-G universe!\n\nOutrun the mechanical alien squid boss whilst dodging his drone minion army as they blast away your race tracks. Hit too many slow-downs and his laser will burn you to a crisp!\n\nTake advantage of pick-ups including magnet to suck up the surrounding orbs, shield to protect you and bombs to send that beastie back to where he came from!\n\nCollect the orbs to power-up your ship, aim for the speed boosts to gain an advantage and avoid the slowdown areas inching you closer to his clutches!\n\nIf you can make it far enough you will come face-to-face with the alien boss, send him to oblivion with your own missile attacks whilst avoiding his deadly arsenal. \n\nWith additional ships to unlock based upon your performance, there is reason to have just one more go...", "short_description": "\"Radial-G : Infinity-X\" pits you against the deadly invasion force attacking the Radial-G universe!\n\nRadial-G: Infinity-X is an endless runner with a difference - dodge obstacles, collect power-up's, avoid falling into the clutches of the alien long enough and you'll get your chance to blast the chasing boss into oblivion. \n\nUnlockable ships keep you coming back for one more go..."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.radial-g.com/", "developer_terms_of_service_url": "http://www.radial-g.com/", "publisher_name": "Tammeka ", "support_website_url": null, "website_url": "http://www.radial-g.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "318855630171291"}, "review_mes
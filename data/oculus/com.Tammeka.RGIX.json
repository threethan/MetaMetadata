uluscdn.com/v/t64.5771-25/11162721_196010817566642_7926983209923903488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVO1yM7aisAQ7kNvwH0Hx_b&_nc_oc=AdrmOGpLEw_dJM3QaSb9U_LgHmcFiwZRzAkRzmEUqKNnZIFtPKUs5jGSunwivX687tw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38xyjti5LasaiPr0FJd3Iq9YRMP9ndzY3nwrNRuv58nQ&oe=69D3929B"}, {"file_name": "migrated_image.png", "id": "530644144255213", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162813_1881500155398518_4891445636739629056_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_0lUpL5ZSwQ7kNvwElPozT&_nc_oc=Ado79hb-DTrrkV5Uq2VISp0HxpNkonR7KoJ8OX-IBetnttaAnmb11McANQXW9oQ_yS4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af310jqa-Ov5r443fg4WxlPiVnwUQOK3zdrmYS8R0XdvZA&oe=69D3C26F"}, {"file_name": "migrated_image.png", "id": "500650760568909", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12482153_279482502489255_475938494439489536_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AC5n1ZlJ0LYQ7kNvwEQilEO&_nc_oc=AdoxeWAbuKYaOxgioZMfIaqgH7PGH999cRfLCwPjFH3VbmRqzzKLusSthsadTTwoRr8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lBWvVz1qROJ8TKKPNQQf9lzQkU775blXu7yK9zs7vtQ&oe=69D3BDFE"}, {"file_name": "migrated_image.png", "id": "205154524067984", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162716_1822152104706235_5142970333321494528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5_iGiq7LCQQ7kNvwEa84gg&_nc_oc=AdpGb3Mb58ShYO10qPTjypE-rbFEZs2c9nVo6Vg6cjwnNDn0mP1atXYkcq4ms_YzsRw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EhIzk6n9yzdsta9DC61tf6ICj-7puOb2ze_8ohCja_w&oe=69D399C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Radial-G: Infinity-X", "keywords": ["radial", "Endless", "runner", "arcade", "infinite"], "long_description": "\"Radial-G : Infinity-X\" pits you against the deadly invasion force attacking the Radial-G universe!\n\nOutrun the mechanical alien squid boss whilst dodging his drone minion army as they blast away your race tracks. Hit too many slow-downs and his laser will burn you to a crisp!\n\nTake advantage of pick-ups including magnet to suck up the surrounding orbs, shield to protect you and bombs to send that beastie back to where he came from!\n\nCollect the orbs to power-up your ship, aim for the speed boosts to gain an advantage and avoid the slowdown areas inching you closer to his clutches!\n\nIf you can make it far enough you will come face-to-face with the alien boss, send him to oblivion with your own missile attacks whilst avoiding his deadly arsenal. \n\nWith additional ships to unlock based upon your performance, there is reason to have just one more go...", "short_description": "\"Radial-G : Infinity-X\" pits you against the deadly invasion force attacking the Radial-G universe!\n\nRadial-G: Infinity-X is an endless runner with a difference - dodge obstacles, collect power-up's, avoid falling into the clutches of the alien long enough and you'll get your chance to blast the chasing boss into oblivion. \n\nUnlockable ships keep you coming back for one more go..."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.radial-g.com/", "developer_terms_of_service_url": "http://www.radial-g.com/", "publisher_name": "Tammeka ", "support_website_url": null, "website_url": "http://www.radial-g.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "318855630171291"}, "review_mes
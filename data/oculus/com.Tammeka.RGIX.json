uluscdn.com/v/t64.5771-25/11162721_196010817566642_7926983209923903488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciPnweg-0n4Q7kNvwGpdVZv&_nc_oc=Ado3j1_yEKzGHpNRwtjBNsFj58sTOnMOJzk8ZlMeuqCA3cBN0D2ufqj1hv6k2312PZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtNqk3eFA3hheKzbYV1Sxi-CphUMNDN8m9ppNhRp9YMg&oe=6A64CFDB"}, {"file_name": "migrated_image.png", "id": "530644144255213", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162813_1881500155398518_4891445636739629056_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTl42WNeAuQQ7kNvwFPJhbX&_nc_oc=Adqpkk7JV5SFZKd4D03uhThgDbv02pt2EGkkvrcdgF5lmX_bKuY95zvmbAv6U2Hj6Ic&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2R1k2zA9srYX9nr1CltMSfBVChtKqT2mVXV5yiRDzWA&oe=6A64C76F"}, {"file_name": "migrated_image.png", "id": "500650760568909", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12482153_279482502489255_475938494439489536_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkfCN__vYFcQ7kNvwEirVR7&_nc_oc=AdpA3M28vJorw8D5rehYrexdbrcE8YS3z0oGLFBOpxgHYsvSR1rbxTTFXOBkb8AmGvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVeeAVU6_FTktCDlddmiD5huGKBI72wwQyCDI68e8nzw&oe=6A64C2FE"}, {"file_name": "migrated_image.png", "id": "205154524067984", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162716_1822152104706235_5142970333321494528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjNJEU34BBcQ7kNvwGVotP4&_nc_oc=Adp0KEaMNyY1f-HNhVwHOQdxkNLo5Y9gRp_lNJ55nRlVaHNJIZQ5tyZFDApPm4VwLeg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnbc3eFBb8T549-Oj6r8IpQIFZp6Noz6GJhB1_mRkTEg&oe=6A649EC8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Radial-G: Infinity-X", "keywords": ["radial", "Endless", "runner", "arcade", "infinite"], "long_description": "\"Radial-G : Infinity-X\" pits you against the deadly invasion force attacking the Radial-G universe!\n\nOutrun the mechanical alien squid boss whilst dodging his drone minion army as they blast away your race tracks. Hit too many slow-downs and his laser will burn you to a crisp!\n\nTake advantage of pick-ups including magnet to suck up the surrounding orbs, shield to protect you and bombs to send that beastie back to where he came from!\n\nCollect the orbs to power-up your ship, aim for the speed boosts to gain an advantage and avoid the slowdown areas inching you closer to his clutches!\n\nIf you can make it far enough you will come face-to-face with the alien boss, send him to oblivion with your own missile attacks whilst avoiding his deadly arsenal. \n\nWith additional ships to unlock based upon your performance, there is reason to have just one more go...", "short_description": "\"Radial-G : Infinity-X\" pits you against the deadly invasion force attacking the Radial-G universe!\n\nRadial-G: Infinity-X is an endless runner with a difference - dodge obstacles, collect power-up's, avoid falling into the clutches of the alien long enough and you'll get your chance to blast the chasing boss into oblivion. \n\nUnlockable ships keep you coming back for one more go..."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.radial-g.com/", "developer_terms_of_service_url": "http://www.radial-g.com/", "publisher_name": "Tammeka ", "support_website_url": null, "website_url": "http://www.radial-g.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "318855630171291"}, "review_mes
uluscdn.com/v/t64.5771-25/11162721_196010817566642_7926983209923903488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2hNIJFkSvAQ7kNvwFTLN-2&_nc_oc=Adr0S685kYQMF3fVH2Z0Oqo6OEI_Vmf62ragFB2iIRUMcWjM6_ceArXJABIfofHMAKw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsCrPS9JM_BqrQpCGFnMfO86Xg15J32XUCo0xJX-Lq0A&oe=6A998BDB"}, {"file_name": "migrated_image.png", "id": "530644144255213", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162813_1881500155398518_4891445636739629056_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtuFM_7dRoYQ7kNvwHzDbLU&_nc_oc=AdqYE0Q7tMJ_gjH6Wnc5OiQszRjdhGbF79b4YqAav4uFcH4IesodOddAThNmP5w12Lo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnN9F1qD7kYB4kPRSojuSE2DJhKVLXnBLuuPp-O3tdIA&oe=6A99836F"}, {"file_name": "migrated_image.png", "id": "500650760568909", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12482153_279482502489255_475938494439489536_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-A8W-iHK8zoQ7kNvwFUBHzL&_nc_oc=Ado52reax0mDks_inpbs8o_FcaU-j7sUOfKRnJAkIfh-k3gzl8_ktFJ3b5vFUe1VPew&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSCE6dPWE6eb7lypk2mjQJkALTFT-4nh-OwXk7LnzGCg&oe=6A997EFE"}, {"file_name": "migrated_image.png", "id": "205154524067984", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162716_1822152104706235_5142970333321494528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73-6nHVpuK0Q7kNvwGWeOK8&_nc_oc=Adpe4bmFtjhfHemK7qciRv1GIgbfDCLn8dMSBLHpH0UJD0HbtzcanU99yOfiMn0IQrE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3HVsX3p_hX9Z6Ow50WqIr6aZVAN3PWsJ95JEt0F_66g&oe=6A999308"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Radial-G: Infinity-X", "keywords": ["radial", "Endless", "runner", "arcade", "infinite"], "long_description": "\"Radial-G : Infinity-X\" pits you against the deadly invasion force attacking the Radial-G universe!\n\nOutrun the mechanical alien squid boss whilst dodging his drone minion army as they blast away your race tracks. Hit too many slow-downs and his laser will burn you to a crisp!\n\nTake advantage of pick-ups including magnet to suck up the surrounding orbs, shield to protect you and bombs to send that beastie back to where he came from!\n\nCollect the orbs to power-up your ship, aim for the speed boosts to gain an advantage and avoid the slowdown areas inching you closer to his clutches!\n\nIf you can make it far enough you will come face-to-face with the alien boss, send him to oblivion with your own missile attacks whilst avoiding his deadly arsenal. \n\nWith additional ships to unlock based upon your performance, there is reason to have just one more go...", "short_description": "\"Radial-G : Infinity-X\" pits you against the deadly invasion force attacking the Radial-G universe!\n\nRadial-G: Infinity-X is an endless runner with a difference - dodge obstacles, collect power-up's, avoid falling into the clutches of the alien long enough and you'll get your chance to blast the chasing boss into oblivion. \n\nUnlockable ships keep you coming back for one more go..."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.radial-g.com/", "developer_terms_of_service_url": "http://www.radial-g.com/", "publisher_name": "Tammeka ", "support_website_url": null, "website_url": "http://www.radial-g.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "318855630171291"}, "review_mes
uluscdn.com/v/t64.5771-25/11162721_196010817566642_7926983209923903488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nm6d-tvJGg4Q7kNvwGIBtIY&_nc_oc=Adqr6l2nZJhFryVmo7BSbVMoRuElij-I_3vtqREgcQ7sPRc-McJ3yCi5OuANj_SiC2Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Bys4ib5pHmIeCscBFkWj54DCgX5qiH8Qyy4NojoCWwQ&oe=69E7915B"}, {"file_name": "migrated_image.png", "id": "530644144255213", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162813_1881500155398518_4891445636739629056_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5_Xc_YDUggQ7kNvwFgHoLz&_nc_oc=AdrqSZYmYUYqkRex8i68M75MsElSHTfAdw7Y2Br78OFQM66oNDk95ij-4SC003zsQ7Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0F4tQ87u0JI6cI3OuMriIkJONrn3lX9NwRbYB_-eONsw&oe=69E788EF"}, {"file_name": "migrated_image.png", "id": "500650760568909", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12482153_279482502489255_475938494439489536_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-soYP-BUC4Q7kNvwH4OWJB&_nc_oc=AdqcePKgdxGfT5am5fOXZUHiR3Bim5btlUyzwGo1wf7UPUvMkF2je63BAO5zprilVt4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00YVRe0Gqfzo2VpkWzoPyzvEJAGcFDvvmA7OpK2Ig_Gw&oe=69E7847E"}, {"file_name": "migrated_image.png", "id": "205154524067984", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162716_1822152104706235_5142970333321494528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJOj89ecnJwQ7kNvwGAXGGP&_nc_oc=AdoZ5gHWq-VmzSPEmPkE4KX5KvIx0NcfN0kRXt1WKLWlwSwb_os29xpGekkeP629zDw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qm8rJ-O7lnDBq7c52jP059HsAq7SXoOMn47A9yxR16g&oe=69E76048"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Radial-G: Infinity-X", "keywords": ["radial", "Endless", "runner", "arcade", "infinite"], "long_description": "\"Radial-G : Infinity-X\" pits you against the deadly invasion force attacking the Radial-G universe!\n\nOutrun the mechanical alien squid boss whilst dodging his drone minion army as they blast away your race tracks. Hit too many slow-downs and his laser will burn you to a crisp!\n\nTake advantage of pick-ups including magnet to suck up the surrounding orbs, shield to protect you and bombs to send that beastie back to where he came from!\n\nCollect the orbs to power-up your ship, aim for the speed boosts to gain an advantage and avoid the slowdown areas inching you closer to his clutches!\n\nIf you can make it far enough you will come face-to-face with the alien boss, send him to oblivion with your own missile attacks whilst avoiding his deadly arsenal. \n\nWith additional ships to unlock based upon your performance, there is reason to have just one more go...", "short_description": "\"Radial-G : Infinity-X\" pits you against the deadly invasion force attacking the Radial-G universe!\n\nRadial-G: Infinity-X is an endless runner with a difference - dodge obstacles, collect power-up's, avoid falling into the clutches of the alien long enough and you'll get your chance to blast the chasing boss into oblivion. \n\nUnlockable ships keep you coming back for one more go..."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.radial-g.com/", "developer_terms_of_service_url": "http://www.radial-g.com/", "publisher_name": "Tammeka ", "support_website_url": null, "website_url": "http://www.radial-g.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "318855630171291"}, "review_mes
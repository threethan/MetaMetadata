ized entertainment and education company - transforming digital experiences. ", "short_description": "The world's most immersive education platform unleashes the power of 360 degree 3D video to take education to the next level. Learn from the world's leading masters of industry and the arts to transform the way you experience the world. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wondour.com/vrlu-privacy-policy", "developer_terms_of_service_url": "https://www.vrlu.com/terms", "publisher_name": "VRLU LLC", "support_website_url": null, "website_url": "https://www.vrlu.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko", "ja"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "966538014616188"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566698_188093877545065_2129930460929401648_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJvC_YYDhY0Q7kNvwGYygbs&_nc_oc=AdnZzJ4yF4RuFlz9GnVkkeP4I3pI4iThTbTo5RFXxpjMK6BIq_PmpI3Ii7IsxHvSD8o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvJtK9e8sH9N65RgiKXhDj7eMssB7qSdxPbTR_us2beFw&oe=69A6E5B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VRLU | Master Academy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"top
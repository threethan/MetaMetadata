788_2262864530571705_8720556103335708618_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIDxZt7JmV0Q7kNvwEsb5hJ&_nc_oc=AdpFWBoNpF3TXlcK-Am4BoU0jghuk0RrrgTaHlbCJNxqUiXIEUJfTtb_ObaQDipBIhg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FSGR9K-twpCVRvhXpnQkAiNXpB3KRPnhKMCpeEP1hHQ&oe=6A2C1FC4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLU | Master Academy", "keywords": [], "long_description": "Master Academy is like MasterClass but in VR. Take your personal development to the next level, and experience the world's masters like never before. \n\nIt's as though the instructors are sitting in the room next to you sharing intimately the ins and outs of their trade. Through 3D 360 degree video, unlock a personal experience previously reserved exclusively for the rich & famous. \n\nVRLU ('v-r-loo') is a globally recognized entertainment and education company - transforming digital experiences. ", "short_description": "The world's most immersive education platform unleashes the power of 360 degree 3D video to take education to the next level. Learn from the world's leading masters of industry and the arts to transform the way you experience the world. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wondour.com/vrlu-privacy-policy", "developer_terms_of_service_url": "https://www.vrlu.com/terms", "publisher_name": "VRLU LLC", "support_website_url": null, "website_url": "https://www.vrlu.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko", "ja"], "supported_input_devices": ["OCULU
.com&_nc_ss=7f20f&oh=00_AQQZ5GhxqB3KiW7dv6MMRrXgBBylaL7iFAoL1yjid0gx9A&oe=6B086C6D"}, {"file_name": "Screen5.png", "id": "6450071781774782", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031384_6450071798441447_5365994385546483154_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGx7spN5crYQ7kNvwHp9wqQ&_nc_oc=AdocW7gnUovZ1NVTaqCDWaJ81iZn-36W7eiJNXx08poe9fGE2BDjiJq_xKXD0asnh0Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFpeELW5X4FeVxIMO-DS0FOI7ILjPsbqGhbrR5SCDNbA&oe=6B086A8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_image.png", "id": "865196195190500", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38984441_865196198523833_6283990690662220915_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOlas0J-UT4Q7kNvwGz_IHa&_nc_oc=AdqKpqmprQPYCFSkcsVU8geSMDU6ScC29bEZYDBj8IMEHvLwpOy4D_snMo24L2X5TNU&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIZeW34GKZtCKKMlWoHL4R_Q_AXsqPZRnobYUAPtiA5A&oe=6B0873FC"}, "display_name": "Street Champ", "keywords": [], "long_description": "Experience virtual cross road challenge by trying to avoid collision with the cars.\n\nJust try to go as far as you can by crossing the streets. You think it\u2019s easy?\n\nPlay this challenging game alone or with friends to see who can get the highest score!\n\n\"It\u2019s fun, challenging and a great VR spin on a classic genre.\" VR Grid\n\n\"Not only is Street Champ VR worth the money, it is also the best VR frogger game I have played (and to be fair I have played 5 others). At times it is utterly terrifying and your heart will be going faster than some of the traffic does. Not all retro game work in VR, but frogger does and Street Champ VR is the very best example of it.\" The VR Shop\n", "short_description": "Experience virtual cross road challenge by trying to avoid collision with the cars.\n\nJust try to go as far as you can by crossing the streets. You think it\u2019s easy?\n\nPlay this challenging game alone or with friends to see who can get the highest score!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://streetchamp.pro/privacy.html", "developer_terms_of_service_url": "http://streetchamp.pro/terms.html", "publisher_name": "Zynk Software Srl", "support_website_url": null, "website_url": "http://streetchamp.pro/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "213621368343101"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39003283_974860443846349_5967417253585144853_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wBlFSNGl8AQ7kNvwGDGX8v&_nc_oc=AdqrXvkaOXyLlIS1k4nBg4T2SNoF0dlEYAEvm4ib9PgoSSiN7CPXi7QL3DTLHQvax4M&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRe7L5e-oN97iFYTIMZ_LOKszwo66ByXB-ib_BdmIhqxA&oe=6B083D70"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Street Champ", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1691614871, "lastRevision": {"nodes": [{"id": "5968652616567531", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata
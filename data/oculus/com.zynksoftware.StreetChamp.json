.com&_nc_ss=7f20f&oh=00_AQG5ovBX14LQVPa30ljKcbbvT9J7T74hQ87zRYjvkSZYaA&oe=6A8EE1C3"}, {"file_name": "migrated_image.png", "id": "628689154582773", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12482153_1318278088223870_389353787703164928_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkLree7nztAQ7kNvwFyZv2R&_nc_oc=AdoruvVpIxw0ZXWIUHXI0YR2DUbMCPtgZltUnOaL-zNYGX_Lq0piqgfA9C8d4ZgJPPI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsT1HtVfC1YefQYOs153hdq5tiBdBwyil8m-TZ_VT3HA&oe=6A8EC14D"}, {"file_name": "migrated_image.png", "id": "613413282847729", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12533809_651937108312933_6332745758294409216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjR3DIBJXqAQ7kNvwFrMbLw&_nc_oc=Adquu3sL5MT8vCjmz54g0gdYHbq4qj4KpB_0PoHWNYlga7plQxU4Xy_t9hczDcKzjtI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmSOdPzpUjW69enTdz1fPwFoU9zMHEJ3rOJlHlp1UWFA&oe=6A8EF8CD"}, {"file_name": "migrated_image.png", "id": "526076524953167", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12410455_220551441726666_4305288196901568512_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6tSOhfo3FkQ7kNvwHT0HpR&_nc_oc=AdoRZ2GRDHrddPtE_C0ztUg-O-GirF9NBsUwEGaipvhCohVmp8EaJnIvRmPEpkHazts&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZ1-sdjhvYGFW4f7SXIxSKKmo4kyQ6_MyuusGn1l8AXA&oe=6A8EF8E7"}, {"file_name": "migrated_image.png", "id": "147190949919243", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12533772_347981768913989_6876721022943363072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_96SMfVwmsQ7kNvwHL4oDe&_nc_oc=AdpLIg4fc9BP66jnwKGRPsLuLQ8OaAJJNh5m01rB9JBOvxxIkq08ThKDDe0ic4C42Wk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQED0GnqRisYf3KGismmqakR6TfrHppTbF-0ltczeKG8PQ&oe=6A8ECA13"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Street Champ", "keywords": ["cross", "car", "street", "road", "crossy"], "long_description": "Experience virtual cross road challenge by trying to avoid collision with the cars.\n\nJust try to go as far as you can by crossing the streets. You think it\u2019s easy?\n\nPlay this challenging game alone or with friends to see who can get the highest score!\n\nFeatures:\n- gamepad supported\n- global leaderboards\n- faster speed by keeping the the button pressed\n- great sounds\n\n\"Street Champ for Samsung Gear VR bring you the great VR 3D experience of crossing street game like never before. This game is better than I expect. It's fun really challenge and a good VR game for everyone in the family. Also good for a VR showcase. You will love it. \" POP 2Review\n\n\"Not only is Street Champ VR worth the money, it is also the best VR frogger game I have played (and to be fair I have played 5 others).  Not all retro game work in VR, but frogger does and Street Champ VR is the very best example of it.\" VR Shop UK ", "short_description": "Experience virtual cross road challenge by trying to avoid collision with the cars.\n\nJust try to go as far as you can by crossing the streets. You think it\u2019s easy?\n\nPlay this challenging game alone or with friends to see who can get the highest score!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://streetchamp.pro/terms.html", "developer_terms_of_service_url": "http://streetchamp.pro/terms.html", "publisher_name": "Zynk Software Srl", "support_website_url": null, "website_url": "http://streetchamp.pro/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SIMULATION", "RACING", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAM
uluscdn.com&oh=00_Af2KBTGCXhjcBQGGl6Qw5MJAqJPouX5W-7IgYBzXNmMCew&oe=69F0B44C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_image.png", "id": "865196195190500", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984441_865196198523833_6283990690662220915_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QoEfENat6zsQ7kNvwFs_Fcy&_nc_oc=AdqxCacZXK_mg8Zi3rgb6xqe50dTjoY0r8z2D9TsYoaakPvwUokIOrCk6INEC57V_vA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3J5oLsXzqfDCHWz7UxWjYg80Cx7ro5E8dL5BX5HkMc1Q&oe=69F0BDBC"}, "display_name": "Street Champ", "keywords": [], "long_description": "Experience virtual cross road challenge by trying to avoid collision with the cars.\n\nJust try to go as far as you can by crossing the streets. You think it\u2019s easy?\n\nPlay this challenging game alone or with friends to see who can get the highest score!\n\n\"It\u2019s fun, challenging and a great VR spin on a classic genre.\" VR Grid\n\n\"Not only is Street Champ VR worth the money, it is also the best VR frogger game I have played (and to be fair I have played 5 others). At times it is utterly terrifying and your heart will be going faster than some of the traffic does. Not all retro game work in VR, but frogger does and Street Champ VR is the very best example of it.\" The VR Shop\n", "short_description": "Experience virtual cross road challenge by trying to avoid collision with the cars.\n\nJust try to go as far as you can by crossing the streets. You think it\u2019s easy?\n\nPlay this challenging game alone or with friends to see who can get the highest score!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://streetchamp.pro/privacy.html", "developer_terms_of_service_url": "http://streetchamp.pro/terms.html", "publisher_name": "Zynk Software Srl", "support_website_url": null, "website_url": "http://streetchamp.pro/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326
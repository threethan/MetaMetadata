xFRUhjiruvTFbvTwAhDROjOrbYVVMr_GIx-6Io1L02yamCLFY1dpBrWUZp6BHp6E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9xapbt3OFROtWfMJALZiHBvEtiAeJHCkPV4JOJmwbNQ&oe=69AEC94C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_image.png", "id": "865196195190500", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984441_865196198523833_6283990690662220915_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4tcSAEdK78Q7kNvwGsDW63&_nc_oc=AdluBgOcpLl98N7cFmEji_XA4cHTF58-FL-ZX5AfFva8ht6T_x15W656X5-kQPh-Bsc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVx1lMIlVo4p7n4gVvyBEGOKHmMPZbNcG2k85Obp36yA&oe=69AED2BC"}, "display_name": "Street Champ", "keywords": [], "long_description": "Experience virtual cross road challenge by trying to avoid collision with the cars.\n\nJust try to go as far as you can by crossing the streets. You think it\u2019s easy?\n\nPlay this challenging game alone or with friends to see who can get the highest score!\n\n\"It\u2019s fun, challenging and a great VR spin on a classic genre.\" VR Grid\n\n\"Not only is Street Champ VR worth the money, it is also the best VR frogger game I have played (and to be fair I have played 5 others). At times it is utterly terrifying and your heart will be going faster than some of the traffic does. Not all retro game work in VR, but frogger does and Street Champ VR is the very best example of it.\" The VR Shop\n", "short_description": "Experience virtual cross road challenge by trying to avoid collision with the cars.\n\nJust try to go as far as you can by crossing the streets. You think it\u2019s easy?\n\nPlay this challenging game alone or with friends to see who can get the highest score!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://streetchamp.pro/privacy.html", "developer_terms_of_service_url": "http://streetchamp.pro/terms.html", "publisher_name": "Zynk Software Srl", "support_website_url": null, "website_url": "http://streetchamp.pro/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "213621368343101"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003283_974860443846349_5967417253585144853_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP1y9yJBTJ0Q7kNvwH0TXzE&_nc_oc=AdmwtY7QTLfIeFD-7RFsIG2gqnwIG0D_mITxx2NviTLVBYMKEm9eIvzh6dhK8Fzu2WA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVw2xj_JSfi1VZHbo4cpGLAkIMB9s5qQT_g2ekeO8FJg&oe=69AED470"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Street Champ", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1691614871, "lastRevision": {"nodes": [{"id": "5968652616567531", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "5968652596567533", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "251609395284204"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "landscape_image.png", "id": "977271016726196", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://s
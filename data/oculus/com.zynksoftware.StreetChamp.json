.com&_nc_ss=7f20f&oh=00_AQENeFNx61KOT2oVEIEt6I35jA-M9dnNrjLaamDfPswG9g&oe=6A85A743"}, {"file_name": "migrated_image.png", "id": "628689154582773", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12482153_1318278088223870_389353787703164928_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cKev_z4iGcQ7kNvwE9sADI&_nc_oc=Adqd-S3Xfzx3l7AMdQxNMX3C-azp2ZeZ5PJfp11eHPsjR0CxqknNvWB8-SoaEKnAZuc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHm-bWfcR3Dh01qqiHmMmgL9JKByvQc2Ev70poZIBaupQ&oe=6A8586CD"}, {"file_name": "migrated_image.png", "id": "613413282847729", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12533809_651937108312933_6332745758294409216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9--cCOzs1HAQ7kNvwG3sqPf&_nc_oc=Adqpqkdy_5E31oebPf2szXX57zZlauIzGcMtv1afr8xNmiYtouzZlcH8Ilp7tSuwdYI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG21svilWlH7zHoc_c5ULArN7EpTd4oViRWmk4vRqaBBA&oe=6A85860D"}, {"file_name": "migrated_image.png", "id": "526076524953167", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12410455_220551441726666_4305288196901568512_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gr1ywHIXt-4Q7kNvwF6CCJf&_nc_oc=AdrAzz4nRJDkyT0uljjUqe5THxH3zoKrGr4pxct6UgrfAptWBjxZcmuIfgf8NTtEOzo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn1f1ezpNCqWP-fWgeKp8LQw5Cm21QvrwzODHRrmCiEA&oe=6A858627"}, {"file_name": "migrated_image.png", "id": "147190949919243", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12533772_347981768913989_6876721022943363072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3gVPoVE0oYQ7kNvwGhgVEZ&_nc_oc=AdoDq7haik7HYYVlJwEAxRJG6-O-qBILwznBFsNhLDfZATMXIrZaqjUYevN-oNHKtO8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpGERK1QS3YFTO2Z-SjGCym5DwNOG4IA1mWQc614rRfA&oe=6A858F93"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Street Champ", "keywords": ["cross", "car", "street", "road", "crossy"], "long_description": "Experience virtual cross road challenge by trying to avoid collision with the cars.\n\nJust try to go as far as you can by crossing the streets. You think it\u2019s easy?\n\nPlay this challenging game alone or with friends to see who can get the highest score!\n\nFeatures:\n- gamepad supported\n- global leaderboards\n- faster speed by keeping the the button pressed\n- great sounds\n\n\"Street Champ for Samsung Gear VR bring you the great VR 3D experience of crossing street game like never before. This game is better than I expect. It's fun really challenge and a good VR game for everyone in the family. Also good for a VR showcase. You will love it. \" POP 2Review\n\n\"Not only is Street Champ VR worth the money, it is also the best VR frogger game I have played (and to be fair I have played 5 others).  Not all retro game work in VR, but frogger does and Street Champ VR is the very best example of it.\" VR Shop UK ", "short_description": "Experience virtual cross road challenge by trying to avoid collision with the cars.\n\nJust try to go as far as you can by crossing the streets. You think it\u2019s easy?\n\nPlay this challenging game alone or with friends to see who can get the highest score!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://streetchamp.pro/terms.html", "developer_terms_of_service_url": "http://streetchamp.pro/terms.html", "publisher_name": "Zynk Software Srl", "support_website_url": null, "website_url": "http://streetchamp.pro/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SIMULATION", "RACING", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAM
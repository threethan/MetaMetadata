.com&_nc_ss=7f20f&oh=00_AQRP78vRv2WRj9AhFoF4PbuR9efLf6mCZFKLkrcjwDGj9Q&oe=6AFB3D6D"}, {"file_name": "Screen5.png", "id": "6450071781774782", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031384_6450071798441447_5365994385546483154_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KntX8STDO7YQ7kNvwGEVY50&_nc_oc=AdruGLUnxYeWrToun8uYB2qXFLNIGzgSF0BeR3Kf6AOXXaXSptSkol6M_gv0NTzf2Gc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTuNzTia9sbQphqhSfG6aSIrroDqezfuKZFO9xkOkXhw&oe=6AFB3B8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_image.png", "id": "865196195190500", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984441_865196198523833_6283990690662220915_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQDtKu7-xh4Q7kNvwHMV6ix&_nc_oc=Adp41E5wNxU5GsPX5c162rU5RXFrGiFeD9dEHJnP-4FF8jrQjgWJAIDbTIby0QcoiEg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRidsaSbFu64XnYbFU52f5GNaoG9EqgBGROiY8uhHfnRA&oe=6AFB44FC"}, "display_name": "Street Champ", "keywords": [], "long_description": "Experience virtual cross road challenge by trying to avoid collision with the cars.\n\nJust try to go as far as you can by crossing the streets. You think it\u2019s easy?\n\nPlay this challenging game alone or with friends to see who can get the highest score!\n\n\"It\u2019s fun, challenging and a great VR spin on a classic genre.\" VR Grid\n\n\"Not only is Street Champ VR worth the money, it is also the best VR frogger game I have played (and to be fair I have played 5 others). At times it is utterly terrifying and your heart will be going faster than some of the traffic does. Not all retro game work in VR, but frogger does and Street Champ VR is the very best example of it.\" The VR Shop\n", "short_description": "Experience virtual cross road challenge by trying to avoid collision with the cars.\n\nJust try to go as far as you can by crossing the streets. You think it\u2019s easy?\n\nPlay this challenging game alone or with friends to see who can get the highest score!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://streetchamp.pro/privacy.html", "developer_terms_of_service_url": "http://streetchamp.pro/terms.html", "publisher_name": "Zynk Software Srl", "support_website_url": null, "website_url": "http://streetchamp.pro/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "213621368343101"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003283_974860443846349_5967417253585144853_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QE7XNbN89K4Q7kNvwG5GnfE&_nc_oc=AdooDmRSv3GdE8IyNmjYmFxHLkXBAQJtP2f3JMIg3-i-ItyIqMpH2VA_a-duRcRzBvw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnlUai6PG89UnV_3kbmSzIsMJr3F3NQiyVy1UXO2K18A&oe=6AFB46B0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Street Champ", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1691614871, "lastRevision": {"nodes": [{"id": "5968652616567531", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata
=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS3GoF1L-4ze8PXVdTFuRZYLM3pmM9zvmb-X1tpFabFYQ&oe=6B0C4FAE"}, {"file_name": "mm_screenhot_04.png", "id": "840303228035610", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982616_840303231368943_853227713155470461_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uuUXzCTZ10Q7kNvwHbD16w&_nc_oc=Adqd5PfYgZ96eUnaZ0td3LnPRKkR9l-agug7BdAEQ85Po9v7LGeQ-s5fWdnXI1O4Bac&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSNl2G92FHCd9DQolMscTKT5eyvVGqDJqlhnItRza0QZA&oe=6B0C5484"}, {"file_name": "mm_screenhot_05.png", "id": "539125219084537", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_539125222417870_1142660750653257977_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqCC-Mv6P9UQ7kNvwHLElM1&_nc_oc=AdqKpdhasVMuaLSwZL08_FgBagjJ11EtSc47cMMXBfsCUogJPlSEX9XhsP9xKzSDrWY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTw6FGDbjkxVbnB8ovqnXIYplgVSmekJ4PCywvAc7-4YA&oe=6B0C71E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1762955361126063", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031421_1762955364459396_4329917330756464481_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfOfJpy5nlQQ7kNvwGqOJmt&_nc_oc=AdryhJDgWroMs06u_XwnJUBIZc7kIts6Yrb1sdKvpR5sWZvBEsR1rA5YOYd0jABcGcY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTFfBbXupnNLRtbisY3m4EDu0bFYciZUgQTJz5W5rFNuw&oe=6B0C744A"}, "display_name": "MysticMarbles", "keywords": [], "long_description": "MysticMarbles is an exhilarating puzzle-action game that challenges players to stop a chain of marbles from reaching a mystical portal. As the marbles roll along a predefined path, players take control of a stone frog idol, capable of shooting marbles of various colors towards the advancing chain. The objective is to match and eliminate groups of three or more marbles of the same color, triggering chain reactions that clear the path. Quick thinking and precise shooting are essential to prevent the marbles from reaching the skull and completing each level.", "short_description": "MysticMarbles is a fast-paced puzzle-action game where players control a stone frog idol to shoot and match colorful marbles, preventing them from reaching a mystical skull structure at the end of the path."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deepbitlabs.io/mm_privacy.html", "developer_terms_of_service_url": "https://deepbitlabs.io/mm_tos.html", "publisher_name": "DEEPBIT LABS, LLC", "support_website_url": null, "website_url": "https://deepbitlabs.io/mm_index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9851772011592721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035308_576998321552330_7373546384231690686_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Tgi1D1NvckQ7kNvwErFyF1&_nc_oc=Adpm_xBvVknEpoxZ9uLl8t-1yU__YBVs_Pz5tqCKFrXzXZN7ILXps-ObJtJ8becr5MA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSMxanFVbYhY2advsKtIaM5Q6nJO_ntSpw_KDYP6O8jGg&oe=6B0C8152"}, "is_concept": false, "is_test": false, "i
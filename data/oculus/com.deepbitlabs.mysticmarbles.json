iRJMNBITxrn7adwNuHR37MLE-Z59FUHMkjoxpHQG8EuCJB7YBFX1Ga-bFM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39r2YLurkcPUG76q0DvqACfO_qUm7DehN4qTgBWSGorg&oe=69D3C628"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1762955361126063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031421_1762955364459396_4329917330756464481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRUWlOy6cgwQ7kNvwH7cuyA&_nc_oc=AdqAy-Ifh_yBBGn8FQRGABpI0IFYrRzJgKdb9G2Xa2W8FV-6jbjd6Al2nlTUAAdC7ak&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FaYL4Isu--49LV_Z0h76eeiWqvYeeFrfCE_F_tyByAw&oe=69D3C88A"}, "display_name": "MysticMarbles", "keywords": [], "long_description": "MysticMarbles is an exhilarating puzzle-action game that challenges players to stop a chain of marbles from reaching a mystical portal. As the marbles roll along a predefined path, players take control of a stone frog idol, capable of shooting marbles of various colors towards the advancing chain. The objective is to match and eliminate groups of three or more marbles of the same color, triggering chain reactions that clear the path. Quick thinking and precise shooting are essential to prevent the marbles from reaching the skull and completing each level.", "short_description": "MysticMarbles is a fast-paced puzzle-action game where players control a stone frog idol to shoot and match colorful marbles, preventing them from reaching a mystical skull structure at the end of the path."}]}, "developer_name": "Andre Smith", "developer_privacy_policy_url": "https://mysticmarbles.co/privacy.html", "developer_terms_of_service_url": "https://mysticmarbles.co/tos.html", "publisher_name": "DEEPBIT LABS, LLC", "support_website_url": null, "website_url": "https://mysticmarbles.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
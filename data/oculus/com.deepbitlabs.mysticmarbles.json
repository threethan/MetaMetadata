38982616_840303231368943_853227713155470461_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMlyBGK6IYgQ7kNvwEWb8jg&_nc_oc=AdoXFn_62Pez5aruFNg6q0O64SSmJaRjsdmMjTw_aD8zswWvylVanlFe2I2_i62auBQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQ6mSkGk6YcGDtG3yUEfKU9vLAClU3X--Bweivantd7A&oe=6ADF4944"}, {"file_name": "mm_screenhot_05.png", "id": "539125219084537", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221323_539125222417870_1142660750653257977_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgklSxS97VgQ7kNvwGWDklq&_nc_oc=AdrEFKU0gaTv5jbjzzlJHud9fYsvWE9T7fBYrF4m6gjbxyxuKC3ZDAxJhrMlldOh2NY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLb0aPwKRiFLfXBXQxYigHwD0chboeB-A4aF4ojMyLxg&oe=6ADF66A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1762955361126063", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031421_1762955364459396_4329917330756464481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrxlhzrxCkAQ7kNvwHSOVYC&_nc_oc=Adot9GCDJVYBRsXC3JAPnDZ61G3hyl1pQ_N0mPMBGNwLdeC_BjiHbKDZ7P1ijKfGE6U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPX6mCx0uDXKEdGwuKBFs4ndw9WsNcGUiU6M_6NU4oPg&oe=6ADF690A"}, "display_name": "MysticMarbles", "keywords": [], "long_description": "MysticMarbles is an exhilarating puzzle-action game that challenges players to stop a chain of marbles from reaching a mystical portal. As the marbles roll along a predefined path, players take control of a stone frog idol, capable of shooting marbles of various colors towards the advancing chain. The objective is to match and eliminate groups of three or more marbles of the same color, triggering chain reactions that clear the path. Quick thinking and precise shooting are essential to prevent the marbles from reaching the skull and completing each level.", "short_description": "MysticMarbles is a fast-paced puzzle-action game where players control a stone frog idol to shoot and match colorful marbles, preventing them from reaching a mystical skull structure at the end of the path."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deepbitlabs.io/mm_privacy.html", "developer_terms_of_service_url": "https://deepbitlabs.io/mm_tos.html", "publisher_name": "DEEPBIT LABS, LLC", "support_website_url": null, "website_url": "https://deepbitlabs.io/mm_index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9851772011592721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035308_576998321552330_7373546384231690686_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjArnA1eXCIQ7kNvwEizxI5&_nc_oc=AdrPIZL4sk7S6pqJk_qsR_R9ekPa_sgkPQu-b2lKChIu3o6NQP1u2npyZigPfpNDqZo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYao64fZGvQdLlNWF98sW7UI8Rd9z8cFOobmVrCOpzcg&oe=6ADF7612"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MysticMarbles", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}
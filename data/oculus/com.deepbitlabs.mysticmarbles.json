=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7hQkYD9jIQ8V6F6UVPZWlXdJ2X4zqrUWcMMLI60wTBw&oe=6AFB2C2E"}, {"file_name": "mm_screenhot_04.png", "id": "840303228035610", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982616_840303231368943_853227713155470461_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONLLbsJjTFoQ7kNvwE-2Wdb&_nc_oc=AdpEOxJpTim4bA0_weS2V9T-JqE7nlcd_c9ESSabo0MypMwup4irjfSFQPRQB9aLdy8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSpJDdOKmpqZRy13vxCFj4eD66Po4_1kFcuIwn-Wt5OA&oe=6AFB3104"}, {"file_name": "mm_screenhot_05.png", "id": "539125219084537", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75221323_539125222417870_1142660750653257977_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncScoPMtSAsQ7kNvwEEtW4y&_nc_oc=AdrVBy-Ju6bGjS_zi2z-S0hcOcb9U6jr5Ata61WzZLtoY2SKooZrQ_KHI6KMr3yD14E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRI70gGsVEyhuG14oIIW_GJ_4-uCYuk4_vFN4OLAr66qA&oe=6AFB1628"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1762955361126063", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031421_1762955364459396_4329917330756464481_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIWgjK7US_oQ7kNvwEoREfi&_nc_oc=Adpn6k7fms_R9cPyjZAJxcx_kfq_yVFJPkoQ7vteal2Yc4bxgUUTZ6YundFG7OCU2UU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQupoO_nQY3IXc0An7uIo-wnBw9DkjAEGRuCvEmN3K7Bw&oe=6AFB188A"}, "display_name": "MysticMarbles", "keywords": [], "long_description": "MysticMarbles is an exhilarating puzzle-action game that challenges players to stop a chain of marbles from reaching a mystical portal. As the marbles roll along a predefined path, players take control of a stone frog idol, capable of shooting marbles of various colors towards the advancing chain. The objective is to match and eliminate groups of three or more marbles of the same color, triggering chain reactions that clear the path. Quick thinking and precise shooting are essential to prevent the marbles from reaching the skull and completing each level.", "short_description": "MysticMarbles is a fast-paced puzzle-action game where players control a stone frog idol to shoot and match colorful marbles, preventing them from reaching a mystical skull structure at the end of the path."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deepbitlabs.io/mm_privacy.html", "developer_terms_of_service_url": "https://deepbitlabs.io/mm_tos.html", "publisher_name": "DEEPBIT LABS, LLC", "support_website_url": null, "website_url": "https://deepbitlabs.io/mm_index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9851772011592721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035308_576998321552330_7373546384231690686_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgGHEufp54UQ7kNvwEnCOAI&_nc_oc=AdoQN1ROWGS6mVyX-fsFZeyUkno6fkPb_cWqBkIXhGNves3zm_NjUK9WD8GRAW2lCSw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVaMcIzvYQpdjoquSsjbTXM7iWNwvfu5tzGA17puzRMA&oe=6AFB2592"}, "is_concept": false, "is_test": false, "i
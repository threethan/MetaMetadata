_nc_oc=AdkCmeDR1onXi10OpHi1ZqcfvjAnqm9ftcRlJSvjJZwF_mU4XbgPDZ-a13amSZHBp9U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afux_52yEbCKa06E1-ZEZY8zgH94Pc_SQU5FzFap_0NLew&oe=69985544"}, {"file_name": "mm_screenhot_05.png", "id": "539125219084537", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221323_539125222417870_1142660750653257977_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4mIQRJbV2AQ7kNvwFB7pSB&_nc_oc=AdmT3JWLrwcZa7zsiEPqq-2Tz6B61Pv6Laeic-mcFtzy5ZOA2t5UCzArsUJjUQqbH_M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afv2F-Q7RaRLH3g2TqWWormnhtibhWkrqJmmMFSCTB5PoQ&oe=699872A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1762955361126063", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031421_1762955364459396_4329917330756464481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wkqpY7KhMoQ7kNvwE0BSfF&_nc_oc=AdmVat4kExZLD0qRtBoUYnnEDi67tMuAMghNWg0NJvH9OhklXy0SK22zKnSuMDYQsxE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsHqFdx95fxPqjX6ATib_0wT6vPOZI7s2pf82-53rrIPA&oe=69983CCA"}, "display_name": "MysticMarbles", "keywords": [], "long_description": "MysticMarbles is an exhilarating puzzle-action game that challenges players to stop a chain of marbles from reaching a mystical portal. As the marbles roll along a predefined path, players take control of a stone frog idol, capable of shooting marbles of various colors towards the advancing chain. The objective is to match and eliminate groups of three or more marbles of the same color, triggering chain reactions that clear the path. Quick thinking and precise shooting are essential to prevent the marbles from reaching the skull and completing each level.", "short_description": "MysticMarbles is a fast-paced puzzle-action game where players control a stone frog idol to shoot and match colorful marbles, preventing them from reaching a mystical skull structure at the end of the path."}]}, "developer_n
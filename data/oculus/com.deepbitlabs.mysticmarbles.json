=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUEUHGGKG_87-FaRNLm2QRKQp4VCjaQi7gOESAry6dwA&oe=6B00722E"}, {"file_name": "mm_screenhot_04.png", "id": "840303228035610", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982616_840303231368943_853227713155470461_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flczX59E_TAQ7kNvwEy146r&_nc_oc=Adoxc1_D-JGFhZ_WMHFHY5ROEzrh0r23oLjx88og2Ps8sSys298mpyuy8S_QUlOcT7E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5GF2Oh2uwUeg5ZkGInKaXRBgzqcmFOLz_gFId8QUv0Q&oe=6B007704"}, {"file_name": "mm_screenhot_05.png", "id": "539125219084537", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_539125222417870_1142660750653257977_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kZb6cUUgh8Q7kNvwE8lQFn&_nc_oc=Adpf-glfZ-HIiL_e5JZKZm3MoCv33M4ExnosOAixLLQ52btO0Pre9ko9F7CkFwjZGhM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfRDajdVJ4GK3pmL9JUFy1pRe_mE7oobZQOt-Dr-56SA&oe=6B005C28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1762955361126063", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031421_1762955364459396_4329917330756464481_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qn8GRiIWU1AQ7kNvwEilQbh&_nc_oc=AdoeWKYqRR0Vc5MecosQTK5LIjG3-9ySFqeHmB2aKIutY9trj84G9EaHRC-PKtlRQG4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx8pWx6e9I_rbDwYU1QcgCr30SqO_td6ZxV6MgUv0RIQ&oe=6B005E8A"}, "display_name": "MysticMarbles", "keywords": [], "long_description": "MysticMarbles is an exhilarating puzzle-action game that challenges players to stop a chain of marbles from reaching a mystical portal. As the marbles roll along a predefined path, players take control of a stone frog idol, capable of shooting marbles of various colors towards the advancing chain. The objective is to match and eliminate groups of three or more marbles of the same color, triggering chain reactions that clear the path. Quick thinking and precise shooting are essential to prevent the marbles from reaching the skull and completing each level.", "short_description": "MysticMarbles is a fast-paced puzzle-action game where players control a stone frog idol to shoot and match colorful marbles, preventing them from reaching a mystical skull structure at the end of the path."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deepbitlabs.io/mm_privacy.html", "developer_terms_of_service_url": "https://deepbitlabs.io/mm_tos.html", "publisher_name": "DEEPBIT LABS, LLC", "support_website_url": null, "website_url": "https://deepbitlabs.io/mm_index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9851772011592721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035308_576998321552330_7373546384231690686_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZG4pdT_xfwQ7kNvwH1SoiH&_nc_oc=AdrTLm1wE0INKDkBP9hKmWwI0uk5BBbzLNydNEkPa8pbMXzWFOKXpNJxPzhVV1Wk14Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwd2bsaz8ybPoa6Jlgsh3DDPlY1oCyaeMUhCdfRWVZYg&oe=6B006B92"}, "is_concept": false, "is_test": false, "i
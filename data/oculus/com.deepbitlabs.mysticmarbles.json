_nc_oc=AdlcCrAiOEu4rktFVLjPJljtUTnzjs3jaSfLonYYx8qSoyTLRF7e_wBDpXdZxpCgAsk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsrCSK1i92uauID0d_9oC50s3hNTlWwnKL1Nc4s72WbFw&oe=69A432C4"}, {"file_name": "mm_screenhot_05.png", "id": "539125219084537", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221323_539125222417870_1142660750653257977_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrTdBNsTu6QQ7kNvwELWQb2&_nc_oc=AdlE4RIdLZtXRkrI_NFPC7JM_Vxw3mc5Gw0bwHFu-F1aYO3Muvs4IqAKUt8Od45ZdpE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsgcxALGsDpt6HRmG4H1EZgGZL0PC0wsYVt5qE_RjAB2w&oe=69A45028"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1762955361126063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031421_1762955364459396_4329917330756464481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUtehqbMf0YQ7kNvwGs5WiC&_nc_oc=Adlp2ubrjHtu1Q-LYcmVTtyjMdb8MEKrhxjtcdKijklOKWSjVCoXaeB86GNFo4oRkBY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvoAYLeugwplv_2YWLkY6Ux2HU66fFtfbXVD0k1nnaX9Q&oe=69A41A4A"}, "display_name": "MysticMarbles", "keywords": [], "long_description": "MysticMarbles is an exhilarating puzzle-action game that challenges players to stop a chain of marbles from reaching a mystical portal. As the marbles roll along a predefined path, players take control of a stone frog idol, capable of shooting marbles of various colors towards the advancing chain. The objective is to match and eliminate groups of three or more marbles of the same color, triggering chain reactions that clear the path. Quick thinking and precise shooting are essential to prevent the marbles from reaching the skull and completing each level.", "short_description": "MysticMarbles is a fast-paced puzzle-action game where players control a stone frog idol to shoot and match colorful marbles, preventing them from reaching a mystical skull structure at the end of the path."}]}, "developer_n
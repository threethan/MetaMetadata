=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7pfguKB31qPCcwK0Z0ONQ0sGzFR-vFhrS1GTvBtK9UQ&oe=6AFDCF2E"}, {"file_name": "mm_screenhot_04.png", "id": "840303228035610", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982616_840303231368943_853227713155470461_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flczX59E_TAQ7kNvwFBfKJZ&_nc_oc=AdoFOHAq-aWjv_oFwbl2hHQTopPBq0xSsFkyo9VJPQz0KNWq0lYsjcDMn6o1Vs7BxcY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT18wIb3jD0du5GS71KPX_r36h4JLlLgyv7R7QkmSqYag&oe=6AFDD404"}, {"file_name": "mm_screenhot_05.png", "id": "539125219084537", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_539125222417870_1142660750653257977_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUahGvgi87oQ7kNvwF0M4on&_nc_oc=Adq8rKH--zB3mkD3FxvaqTzLU1csUgInKU7HhTbb0usMAsLcwCijRQo0fBtr8Emgmww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2hXnL_LN6N5SAQfpQMPzGvhpFOHKtjMJv41apQk9H5g&oe=6AFDB928"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1762955361126063", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031421_1762955364459396_4329917330756464481_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIWgjK7US_oQ7kNvwEOrx-B&_nc_oc=Adrz2F7g1vxLn1iZeV-NH3BUZjnvMjj65C07mAJlGm_q7SzhFjWpWN3pz4RatVwqZes&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCFa1hWhjL808eBposgR5hZJBwaxYJut10AeX7Hwtgtg&oe=6AFDBB8A"}, "display_name": "MysticMarbles", "keywords": [], "long_description": "MysticMarbles is an exhilarating puzzle-action game that challenges players to stop a chain of marbles from reaching a mystical portal. As the marbles roll along a predefined path, players take control of a stone frog idol, capable of shooting marbles of various colors towards the advancing chain. The objective is to match and eliminate groups of three or more marbles of the same color, triggering chain reactions that clear the path. Quick thinking and precise shooting are essential to prevent the marbles from reaching the skull and completing each level.", "short_description": "MysticMarbles is a fast-paced puzzle-action game where players control a stone frog idol to shoot and match colorful marbles, preventing them from reaching a mystical skull structure at the end of the path."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deepbitlabs.io/mm_privacy.html", "developer_terms_of_service_url": "https://deepbitlabs.io/mm_tos.html", "publisher_name": "DEEPBIT LABS, LLC", "support_website_url": null, "website_url": "https://deepbitlabs.io/mm_index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9851772011592721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035308_576998321552330_7373546384231690686_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_SanEBZwD8Q7kNvwEO9xit&_nc_oc=AdpMWVHAznSbzF_4W_qYWeQCicHuPItnfDl6U8cspdRq-brIfGwoKmglwjd2uI4o2ss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqy0u_EVd1NjaDjcmX6gQxXtp1xLCuxezL2X1dIKfEJw&oe=6AFDC892"}, "is_concept": false, "is_test": false, "i
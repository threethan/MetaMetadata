scdn.com&_nc_ss=8&oh=00_AfzxkQKisVULSilJXeRQDd3iAlfwSvBj5JQG5K93VdLQFA&oe=69B92FE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1762955361126063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031421_1762955364459396_4329917330756464481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sm2WVUVBEjMQ7kNvwHDAv1B&_nc_oc=AdlR44nV3B74JU5dmcGSdqkg5ijqb-WCpbyJq4WYkjX0u5sFQfLmX22RUobKeIKxLvU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyz-DUziUUaDicI0QHFp509-kM1JQwe4niiitXQ7mrN9Q&oe=69B9324A"}, "display_name": "MysticMarbles", "keywords": [], "long_description": "MysticMarbles is an exhilarating puzzle-action game that challenges players to stop a chain of marbles from reaching a mystical portal. As the marbles roll along a predefined path, players take control of a stone frog idol, capable of shooting marbles of various colors towards the advancing chain. The objective is to match and eliminate groups of three or more marbles of the same color, triggering chain reactions that clear the path. Quick thinking and precise shooting are essential to prevent the marbles from reaching the skull and completing each level.", "short_description": "MysticMarbles is a fast-paced puzzle-action game where players control a stone frog idol to shoot and match colorful marbles, preventing them from reaching a mystical skull structure at the end of the path."}]}, "developer_name": "Andre Smith", "developer_privacy_policy_url": "https://mysticmarbles.co/privacy.html", "developer_terms_of_service_url": "https://mysticmarbles.co/tos.html", "publisher_name": "DEEPBIT LABS, LLC", "support_website_url": null, "website_url": "https://mysticmarbles.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subs
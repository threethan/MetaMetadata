ea before it overwhelms you.\n\nThis isn\u2019t just a cleaning simulator \u2014 it\u2019s a reflex-driven VR challenge designed for quick sessions, addictive gameplay, and satisfying progress.\n\n\ud83e\uddfc Fast-Paced Cleaning Action\n\n\u2022 Dash through messy environments\n\u2022 Clean different types of dirt and obstacles\n\u2022 Switch tools to handle every challenge\n\u2022 Beat AI competitors and top your best score\n\n\ud83c\udfc6 Challenge Your Skills\n\n\u2022 Increasing difficulty levels\n\u2022 Speed-based objectives\n\u2022 Smart reaction gameplay\n\u2022 Arcade-style progression", "short_description": "A fast-paced VR cleaning challenge where speed, skill, and smart tools clear every mess."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-games-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25457826303894959"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818860_867585519410751_5991349990135972923_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UktmXZOGYLgQ7kNvwHRJDCA&_nc_oc=Adohzd1V8SvGDG
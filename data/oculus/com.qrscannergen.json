2938344470_9092792989907051764_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKHkChva9bgQ7kNvwENiN-l&_nc_oc=AdqrMOWDEZ4zk6ZjTFAgfz_JVzYZLwTo3bW-P7jT8cYhqhG8Owu0UItMHNLNVmFTI9o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNEXxq6F00XDxrWRVtxGTihqvZQPEapbZM4kbTjz2FnQ&oe=6AFB2726"}, {"file_name": "2_generator.png", "id": "1659145368650134", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/593884526_1659145371983467_4179800279203265408_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSgt5Nu16QQQ7kNvwFO4Vtn&_nc_oc=AdrbidmqZ5b86vHTJWkYyb7iB7-1GPe0oqHKQ-uMOqL56bqRHIKwJdLaPKx-VaQ7Wmk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHKHdBh48Lvbn0jz-fAWKVbHDu3zwyqkHZTRvszGTYYQ&oe=6AFB3BCB"}, {"file_name": "3_settings.png", "id": "848149607908587", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827626_848149614575253_6387037975168958449_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkxGDKnnB4UQ7kNvwF1MFKJ&_nc_oc=Adrsce0SZmq-gn30Fa25oJS6MO3EstgdYDm3NX5LFKrWvV58aESy1aZRsPdO8Gf4Wyo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaqnDuX_5Nkgh3Aznq5REvoTffsgPrvdND82PHVhTZOw&oe=6AFB1A4B"}, {"file_name": "5_history.png", "id": "1320453440226463", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825481_1320453443559796_1272473460995749170_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DB3yGo76DxcQ7kNvwFvBAIJ&_nc_oc=AdrvbCDX315GIc6lSJTR1V6Gfu1qlCfskk7-9ZdQYptPFVcgNIgsXCAyVDqfXm9lo2w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDHyIfrw02S9lNSwDO76MVpwAMqs7Kq7N4muhVGNrW2g&oe=6AFB2420"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QR Scanner & Generator", "keywords": ["QRcode", "scanner", "mixedreality", "barcode", "passthrough"], "long_description": "\ud83d\udd33 QR Scanner & Generator turns your Meta Quest 3 / 3S into a fast, hands-free QR & barcode reader \u2014 and a full generator \u2014 inside a sleek holographic HUD.\n\n  \ud83d\udcf7 SCAN\n  \u25b8 Point at any QR or barcode \u2014 detected instantly through passthrough, no phone needed\n  \u25b8 One-tap smart actions: open links, join Wi-Fi, save contacts, dial, maps, calendar\n  \u25b8 Built-in offline safety check warns about phishing & suspicious links\n\n  \u2728 GENERATE\n  \u25b8 Create QR codes for links, Wi-Fi & text with the in-VR keyboard\n  \u25b8 Save them to your headset's Downloads folder\n\n  \ud83d\udccb ORGANIZE\n  \u25b8 Searchable history of everything you scan & generate \u2014 favorites, notes, re-actions\n  \u25b8 Export to PDF, CSV, JSON or TXT\n\n  \ud83e\uddca MADE FOR MIXED REALITY\n  \u25b8 Multi-panel holographic workspace you can grab & arrange\n  \u25b8 Comfortable & stationary \u2014 seated or standing\n  \u25b8 Runs on-device only: no ads, no accounts, no trackers\n\n  \ud83d\udcac Join our community on Discord: https://discord.gg/u76eFWjeV\n\n  \u26a0 Scanning uses Meta's Passthrough Camera API \u2014 requires Quest 3 or Quest 3S", "short_description": "Turn your Quest 3 or 3S into a powerful QR and barcode scanner \u2014 no phone needed. Just look at any code through passthrough and it's detected instantly, with smart actions to open links, join Wi-Fi, save contacts, dial numbers and more. A built-in generator lets you create your own QR codes for links, Wi-Fi and text, then save them to your headset. Every scan is checked for unsafe links, and your full history is kept, searchable and exportable \u2014 all in a sleek holographic interface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/qr-scanner-generator/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": "https://discord.gg/u76eFWjeV", "website_url": "https://f1tt0n.github.io/qr-scanner-generator/", "category": null, "comfort_rating"
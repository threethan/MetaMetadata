aSV5c8ZvjwHovO_cZRpgX8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrNdCfYtZjOESnkFAMfVH4o1YrjAK2mNLCh_Wg7fHxUw&oe=6AE36C26"}, {"file_name": "2_generator.png", "id": "1659145368650134", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/593884526_1659145371983467_4179800279203265408_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oE3lw_tvhsQ7kNvwFJZDqT&_nc_oc=AdqoZYlFhQHO_5dF7drHMgDDnz6CPWvB3Ih2yU1oXvYkeJtFA-us0nxbeQUMBNXNI8U&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdQAxTI4FTWYonfMS62-fYBiCgdEfxPshC3mOrGEh-YQ&oe=6AE3488B"}, {"file_name": "3_settings.png", "id": "848149607908587", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491827626_848149614575253_6387037975168958449_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zG-bIvx6fO8Q7kNvwGTf30c&_nc_oc=Adq3jx7b7HVLRD9c9vZUx252EKj57k2qHfUfOpzgGnzczjy1JSCRSyP8A19Sm9zfI18&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMn-NV9xp-CnlyPN-2Nw8AYhss5Um8LF03NDhRVGdZDlg&oe=6AE35F4B"}, {"file_name": "5_history.png", "id": "1320453440226463", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491825481_1320453443559796_1272473460995749170_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srDJ11HAGwAQ7kNvwEJsOLc&_nc_oc=AdoRpRf_E3Jd1j5aA0iRrWz9rYUbaatPXZ1RHxD7iHTLCHgcWC9QYLRxRxl20H8OHA8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPII4p62hnleCKJwdenf6OQGW_3AWS4ce8l7nInbzz63w&oe=6AE36920"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QR Scanner & Generator", "keywords": ["QRcode", "scanner", "mixedreality", "barcode", "passthrough"], "long_description": "\ud83d\udd33 QR Scanner & Generator turns your Meta Quest 3 / 3S into a fast, hands-free QR & barcode reader \u2014 and a full generator \u2014 inside a sleek holographic HUD.\n\n  \ud83d\udcf7 SCAN\n  \u25b8 Point at any QR or barcode \u2014 detected instantly through passthrough, no phone needed\n  \u25b8 One-tap smart actions: open links, join Wi-Fi, save contacts, dial, maps, calendar\n  \u25b8 Built-in offline safety check warns about phishing & suspicious links\n\n  \u2728 GENERATE\n  \u25b8 Create QR codes for links, Wi-Fi & text with the in-VR keyboard\n  \u25b8 Save them to your headset's Downloads folder\n\n  \ud83d\udccb ORGANIZE\n  \u25b8 Searchable history of everything you scan & generate \u2014 favorites, notes, re-actions\n  \u25b8 Export to PDF, CSV, JSON or TXT\n\n  \ud83e\uddca MADE FOR MIXED REALITY\n  \u25b8 Multi-panel holographic workspace you can grab & arrange\n  \u25b8 Comfortable & stationary \u2014 seated or standing\n  \u25b8 Runs on-device only: no ads, no accounts, no trackers\n\n  \ud83d\udcac Join our community on Discord: https://discord.gg/u76eFWjeV\n\n  \u26a0 Scanning uses Meta's Passthrough Camera API \u2014 requires Quest 3 or Quest 3S", "short_description": "Turn your Quest 3 or 3S into a powerful QR and barcode scanner \u2014 no phone needed. Just look at any code through passthrough and it's detected instantly, with smart actions to open links, join Wi-Fi, save contacts, dial numbers and more. A built-in generator lets you create your own QR codes for links, Wi-Fi and text, then save them to your headset. Every scan is checked for unsafe links, and your full history is kept, searchable and exportable \u2014 all in a sleek holographic interface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/qr-scanner-generator/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": "https://discord.gg/u76eFWjeV", "website_url": "https://f1tt0n.github.io/qr-scanner-generator/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1344141432120102"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823901_2159285101290706_1197454658056717209_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqIuOl73m58Q7kNvwHccwrJ&_nc_oc=AdouUYSj3535r28FkTaAWbLxQ6ZdALN3E8cdtYD8Usk5iBcsNSL3IiAwZMGPXa1muSc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxppjrMdYzyeN9P0xhw0wZBJVD6yRaKg__PcoueYVqcQ&oe=6AE36073"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "QR Scanner & Generator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}, {"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1780927680, "lastRevision": {"nodes": [{"id": "1118786404655607", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1118786381322276", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "993070460325321"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "hero_2560x1440.png", "id": "4776975259189544", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491827567_4776975262522877_3676730889435867627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GopCCMw6PJwQ7kNvwGgnKhm&_nc_oc=Adpxrz-JL_lwNXSfzvlYrlXjUQKSTK67OckVgQe
: "4_scan_result.png", "id": "1759832931677804", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824665_1759832938344470_9092792989907051764_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7I7w7H2k9EQ7kNvwFQY75z&_nc_oc=AdrjAZkxyH0X8RRdFUQ9IjGInEJvtMOUnh1nixUqF79XwGN9KeoZ7WqUjcFyUrRGU8w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRztQhDuUpzQpCruG-yemDWCVC0Kqu028MXlmjYX3ki4g&oe=6B031026"}, {"file_name": "2_generator.png", "id": "1659145368650134", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593884526_1659145371983467_4179800279203265408_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiC2fO1sqY8Q7kNvwHXHDCH&_nc_oc=Ado5gmwi6itTMjJMRymoXNev2blibq3N6hSxYzY-gy7MJ6dv9wda4U557d9z1MTac0Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5QVvLvCxTcXewtyULR2xzszrGq0bKM6HlPAFIuy0MHg&oe=6B0324CB"}, {"file_name": "3_settings.png", "id": "848149607908587", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827626_848149614575253_6387037975168958449_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=622djKPG3GIQ7kNvwH_IKvL&_nc_oc=AdrcVR77Ecc6VTkicV8bifGcLgEPcHEU2sM_ASF9de24KwbljBKW2DKVl9Axqi5iSJg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaFKNYs9tnLuhvU7e7SE3Nxo7iEnWoH7UTGQzJawe_Og&oe=6B03034B"}, {"file_name": "5_history.png", "id": "1320453440226463", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825481_1320453443559796_1272473460995749170_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTKoR7lSHQgQ7kNvwGqxJa_&_nc_oc=Adr-6k158uC7HLQam5R1T4iGDiu9nJ4hi5E4W-7YSGxKOFzGTXST4ltj-6E0yLj-F0I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6m-uPrd-blpKFQcYGkogBn9fwg05KmGy42W51PQstiw&oe=6B030D20"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QR Scanner & Generator", "keywords": ["QRcode", "scanner", "mixedreality", "barcode", "passthrough"], "long_description": "\ud83d\udd33 QR Scanner & Generator turns your Meta Quest 3 / 3S into a fast, hands-free QR & barcode reader \u2014 and a full generator \u2014 inside a sleek holographic HUD.\n\n  \ud83d\udcf7 SCAN\n  \u25b8 Point at any QR or barcode \u2014 detected instantly through passthrough, no phone needed\n  \u25b8 One-tap smart actions: open links, join Wi-Fi, save contacts, dial, maps, calendar\n  \u25b8 Built-in offline safety check warns about phishing & suspicious links\n\n  \u2728 GENERATE\n  \u25b8 Create QR codes for links, Wi-Fi & text with the in-VR keyboard\n  \u25b8 Save them to your headset's Downloads folder\n\n  \ud83d\udccb ORGANIZE\n  \u25b8 Searchable history of everything you scan & generate \u2014 favorites, notes, re-actions\n  \u25b8 Export to PDF, CSV, JSON or TXT\n\n  \ud83e\uddca MADE FOR MIXED REALITY\n  \u25b8 Multi-panel holographic workspace you can grab & arrange\n  \u25b8 Comfortable & stationary \u2014 seated or standing\n  \u25b8 Runs on-device only: no ads, no accounts, no trackers\n\n  \ud83d\udcac Join our community on Discord: https://discord.gg/u76eFWjeV\n\n  \u26a0 Scanning uses Meta's Passthrough Camera API \u2014 requires Quest 3 or Quest 3S", "short_description": "Turn your Quest 3 or 3S into a powerful QR and barcode scanner \u2014 no phone needed. Just look at any code through passthrough and it's detected instantly, with smart actions to open links, join Wi-Fi, save contacts, dial numbers and more. A built-in generator lets you create your own QR codes for links, Wi-Fi and text, then save them to your headset. Every scan is checked for unsafe links, and your full history is kept, searchable and exportable \u2014 all in a sleek holographic interface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/qr-scanner-generator/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": "https://discord.gg/u76eFWjeV", "website_url": "https://f1tt0n.github.io/qr-scanner-generator/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1344141432120102"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823901_2159285101290706_1197454658056717209_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwAv98IRtKgQ7kNvwElYLkt&_nc_oc=Adpzya6uKvBwPr8YbBLxC49U5wZQ9QjILr7vwo1SmkapItWU1wgzytQ4ZNbDH_wKKvQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDIQrlAVX67iqD_iDGkGlCbvCdgogtxII3lPt9qlojFw&oe=6B030473"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "QR Scanner & Generator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}, {"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1780927680, "lastRevision": {"nodes": [{"id": "1118786404655607", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1118786381322276", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "993070460325321"}, "
bUSgiwVRS73T7c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQfJTe46Sy5Z70c-uuy54Q1DI1J87fjR3PY9vGVgNAoQ&oe=6A4E65CB"}, {"file_name": "5_history.png", "id": "1320453440226463", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825481_1320453443559796_1272473460995749170_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qyX1tUO0qcQ7kNvwEHTJcB&_nc_oc=AdptkN2k6RL35xTNUW_Zqqo4U6YIgHO-1_uzbFmt_u-WdAWExFy-25U_vx5aYttEC2Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDwTK7n1RbgjhV7uQCHRzBXcKYCPKHwKlWz3TrfkS1dQ&oe=6A4E6FA0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QR Scanner & Generator", "keywords": ["QRcode", "scanner", "mixedreality", "barcode", "passthrough"], "long_description": "\ud83d\udd33 QR Scanner & Generator turns your Meta Quest 3 / 3S into a fast, hands-free QR & barcode reader \u2014 and a full generator \u2014 inside a sleek holographic HUD.\n\n  \ud83d\udcf7 SCAN\n  \u25b8 Point at any QR or barcode \u2014 detected instantly through passthrough, no phone needed\n  \u25b8 One-tap smart actions: open links, join Wi-Fi, save contacts, dial, maps, calendar\n  \u25b8 Built-in offline safety check warns about phishing & suspicious links\n\n  \u2728 GENERATE\n  \u25b8 Create QR codes for links, Wi-Fi & text with the in-VR keyboard\n  \u25b8 Save them to your headset's Downloads folder\n\n  \ud83d\udccb ORGANIZE\n  \u25b8 Searchable history of everything you scan & generate \u2014 favorites, notes, re-actions\n  \u25b8 Export to PDF, CSV, JSON or TXT\n\n  \ud83e\uddca MADE FOR MIXED REALITY\n  \u25b8 Multi-panel holographic workspace you can grab & arrange\n  \u25b8 Comfortable & stationary \u2014 seated or standing\n  \u25b8 Runs on-device only: no ads, no accounts, no trackers\n\n  \ud83d\udcac Join our community on Discord: https://discord.gg/u76eFWjeV\n\n  \u26a0 Scanning uses Meta's Passthrough Camera API \u2014 requires Quest 3 or Quest 3S", "short_description": "Turn your Quest 3 or 3S into a powerful QR and barcode scanner \u2014 no phone needed. Just look at any code through passthrough and it's detected instantly, with smart actions to open links, join Wi-Fi, save contacts, dial numbers and more. A built-in generator lets you create your own QR codes for links, Wi-Fi and text, then save them to your headset. Every scan is checked for unsafe links, and your full history is kept, searchable and exportable \u2014 all in a sleek holographic interface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/qr-scanner-generator/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": "https://discord.gg/u76eFWjeV", "website_url": "https://f1tt0n.github.io/qr-scanner-generator/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1159733400560907"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824328_1314021394031207_3030276926397194711_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WL1kKceSuiMQ7kNvwGxytr8&_nc_oc=Adomnas5jBBq_6b3kt-Xv-Pnd6L5NIWaTDRCo0aIlZ80l-Xj4eJ1_GP2nXFY99jdfnI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0pS5r1u18zngwt7XlLH1j1SB6b389XQWaoiOHBPiHcQ&oe=6A4E4789"}, "is_concept": false, "is
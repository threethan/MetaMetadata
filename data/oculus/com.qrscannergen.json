: "4_scan_result.png", "id": "1759832931677804", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824665_1759832938344470_9092792989907051764_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7caGoLlxclUQ7kNvwFqk5Pv&_nc_oc=AdrUsGvX3RP-SBtXQwz0rjMor2_sBeQy7d5eRO2gPYnHqAki1YmpaB81tCFiR8C4uHE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTdxIoZ2XMkMk9B6g03kRtUQVfNQksGNsT6yPrznQNgGQ&oe=6B0D9C26"}, {"file_name": "2_generator.png", "id": "1659145368650134", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593884526_1659145371983467_4179800279203265408_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6ivIGxlocUQ7kNvwGf2-fe&_nc_oc=Adqx4-0DDXgxRb0pKbpeDxWU5gvgpQKPSLb8bTjJbET5ucdX0JldEbOYRQW3dt8IBzk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQbzLSTq3Iy_FMyCY0PfojOzy1nqYfQb5H1zhIHSxzccA&oe=6B0DB0CB"}, {"file_name": "3_settings.png", "id": "848149607908587", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827626_848149614575253_6387037975168958449_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhTrW6jwqSAQ7kNvwH01hYx&_nc_oc=Adq1Uuc7XlNqGPDP8g6IrfBDyZjqLK4Ug7GdHfMlPD6shJPXjkswa4Caid13NHzw6Kk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRtYONc6L7nw-zXyBPAkEOSlG1TLc09xa_XhOqBIsefCg&oe=6B0DC78B"}, {"file_name": "5_history.png", "id": "1320453440226463", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825481_1320453443559796_1272473460995749170_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjJmgewjXAEQ7kNvwG5lz3p&_nc_oc=AdosTJulXySbflIKDQAc-GMkRnhuzKhirA8H46oz5wlITq6LqgqHcZXZHIPAtlSGvTM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR9FTRlFyztR1KfGsDooux6MVUJaUXzAc-pFy0JhXh4ZA&oe=6B0DD160"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QR Scanner & Generator", "keywords": ["QRcode", "scanner", "mixedreality", "barcode", "passthrough"], "long_description": "\ud83d\udd33 QR Scanner & Generator turns your Meta Quest 3 / 3S into a fast, hands-free QR & barcode reader \u2014 and a full generator \u2014 inside a sleek holographic HUD.\n\n  \ud83d\udcf7 SCAN\n  \u25b8 Point at any QR or barcode \u2014 detected instantly through passthrough, no phone needed\n  \u25b8 One-tap smart actions: open links, join Wi-Fi, save contacts, dial, maps, calendar\n  \u25b8 Built-in offline safety check warns about phishing & suspicious links\n\n  \u2728 GENERATE\n  \u25b8 Create QR codes for links, Wi-Fi & text with the in-VR keyboard\n  \u25b8 Save them to your headset's Downloads folder\n\n  \ud83d\udccb ORGANIZE\n  \u25b8 Searchable history of everything you scan & generate \u2014 favorites, notes, re-actions\n  \u25b8 Export to PDF, CSV, JSON or TXT\n\n  \ud83e\uddca MADE FOR MIXED REALITY\n  \u25b8 Multi-panel holographic workspace you can grab & arrange\n  \u25b8 Comfortable & stationary \u2014 seated or standing\n  \u25b8 Runs on-device only: no ads, no accounts, no trackers\n\n  \ud83d\udcac Join our community on Discord: https://discord.gg/u76eFWjeV\n\n  \u26a0 Scanning uses Meta's Passthrough Camera API \u2014 requires Quest 3 or Quest 3S", "short_description": "Turn your Quest 3 or 3S into a powerful QR and barcode scanner \u2014 no phone needed. Just look at any code through passthrough and it's detected instantly, with smart actions to open links, join Wi-Fi, save contacts, dial numbers and more. A built-in generator lets you create your own QR codes for links, Wi-Fi and text, then save them to your headset. Every scan is checked for unsafe links, and your full history is kept, searchable and exportable \u2014 all in a sleek holographic interface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/qr-scanner-generator/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": "https://discord.gg/u76eFWjeV", "website_url": "https://f1tt0n.github.io/qr-scanner-generator/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1344141432120102"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823901_2159285101290706_1197454658056717209_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8hzrCxmJOsQ7kNvwFaH5f0&_nc_oc=AdoYL70POvL4C4W-ddiMes7KmAkcye-dbYJSQJmCEqNcM0zcCeyJlWh4zzkydiZdpi4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTBZRXj3BMwt7a8GFRg3rChdv7TJeUPWz4DelMM_ORUvg&oe=6B0DC8B3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "QR Scanner & Generator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}, {"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1780927680, "lastRevision": {"nodes": [{"id": "1118786404655607", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1118786381322276", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "993070460325321"}, "
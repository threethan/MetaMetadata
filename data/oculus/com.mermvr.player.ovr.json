&_nc_ohc=leYEhEQ_nN0Q7kNvwGypyBU&_nc_oc=AdnZHEAGbXK3eQXNP1eRB_B7AoabhfXFzeWpJdwz9DZddiutQC1yGioDRlZhLwn-8Vg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXbXSjoRuFaW2mREOtDADMxx_FQwL4GU6lAAKsXatPrQ&oe=69B93E44"}, "display_name": "MermaidVR", "keywords": ["360video", "180video", "VRvideoplayer", "vrmovice", "vrvideo"], "long_description": "Major function\nFully functional VR web browser\n     It supports fluency browsing of various websites and video playing on-line. Browsers can be displayed on both VR environment and PC desktop simultaneously. You can watch all kinds of movie files during downloading and it also has File Transfer Protocol function. The latter allow users to continue the transmission from the place of breakage so it greatly promote work efficiency.\n    We create our own website: www.XXX.com.\nIt pools more VR video resource sites, which makes it much more easier for users to find their favorite videos.\n3D Cinema mode\n    The brand new3D Cinema mode, it makes you feel like you are in the huge theater of virtual reality and switch seat and watching angle smoothly.\n\nMore and more new function waitting for your try.", "short_description": "Mermaid VR is a free panoramic multimedia player and web browser, which provides you numerous film resources. It is compatible to multiple Operation System and full-format video playing. The professional software is very user-friendly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mermvr.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.mermvr.com/terms-service.html", "publisher_name": "MermaidVR.Inc", "support_website_url": null, "website_url": "https://www.mermvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MUSIC_VIDEO", "MOVIE", "UTILITY", "SIMULATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_co
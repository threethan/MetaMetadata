amic multimedia player and web browser, which provides you numerous film resources. It is compatible to multiple Operation System and full-format video playing. The professional software is very user-friendly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mermvr.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.mermvr.com/terms-service.html", "publisher_name": "MermaidVR.Inc", "support_website_url": null, "website_url": "https://www.mermvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MUSIC_VIDEO", "MOVIE", "UTILITY", "SIMULATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "ja", "ru"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "275696561178365"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1727373587342631", "version": "3.0.2"}, "id": "466121480450932", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1628782007201790", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1727373587342631"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "466121480450932"}]}, "change_log": "Hey, After a long 
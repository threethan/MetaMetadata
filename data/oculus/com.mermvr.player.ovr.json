/v/t64.5771-25/12482392_178439066096326_5444302077712924672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGSQx4B6o8YQ7kNvwFd-V2a&_nc_oc=AdrcOyuW-y-iqQUMty_ucaH1Cx_2zqa7xyTn7eOoMBaHt2bgRfcq-4EGNHRZ-hgWnhM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4e7hBlu9jMnjk5ivHp0-0Qi4wweDJjOyx1UCDJ0GtiQ&oe=6A984404"}, "display_name": "MermaidVR", "keywords": ["360video", "180video", "VRvideoplayer", "vrmovice", "vrvideo"], "long_description": "Major function\nFully functional VR web browser\n     It supports fluency browsing of various websites and video playing on-line. Browsers can be displayed on both VR environment and PC desktop simultaneously. You can watch all kinds of movie files during downloading and it also has File Transfer Protocol function. The latter allow users to continue the transmission from the place of breakage so it greatly promote work efficiency.\n    We create our own website: www.XXX.com.\nIt pools more VR video resource sites, which makes it much more easier for users to find their favorite videos.\n3D Cinema mode\n    The brand new3D Cinema mode, it makes you feel like you are in the huge theater of virtual reality and switch seat and watching angle smoothly.\n\nMore and more new function waitting for your try.", "short_description": "Mermaid VR is a free panoramic multimedia player and web browser, which provides you numerous film resources. It is compatible to multiple Operation System and full-format video playing. The professional software is very user-friendly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mermvr.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.mermvr.com/terms-service.html", "publisher_name": "MermaidVR.Inc", "support_website_url": null, "website_url": "https://www.mermvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres":
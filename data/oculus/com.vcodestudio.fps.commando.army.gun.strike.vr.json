culuscdn.com/v/t64.5771-25/491818852_1165745254936049_3849724550628930855_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QU95aapgy94Q7kNvwE3ThIN&_nc_oc=AdrRtcohEBfsLSd0lYLwvqgkxQB6yg46BVpJyZ31q97ucznm81mOOMsoQ6t0NvTcalc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8l2Sc4z5Li2gP4cwCrh8PJ-PIeiJGxArtAGPJyrGnyYA&oe=6A2AB7CB"}, {"file_name": "Screenshot_4.png", "id": "1368964708204907", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819854_1368964711538240_3734348506848429188_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N753iibaZYcQ7kNvwEV6LAy&_nc_oc=Adqa_dUubyJDo74cJsjvFFt1aZis66nlr-o3Tt7banCYWmFadzIRhfWDQrsmpr61Nls&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82yt6dysoIwiVoHmTTnP6CzLUuYyb9UK95WdLCAerXow&oe=6A2AD5C0"}, {"file_name": "Screenshot_5.png", "id": "2276131819565756", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820855_2276131822899089_3272038543067145225_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DV-44Vp2YSQQ7kNvwHagYet&_nc_oc=AdpBb0sCWT5vAHgNI09f8SCFgu-0Cl-hcaE0ud6BbYc_kPLrEk5BoO2ezZuVlfstYtY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8z0ihEVKMDFZaKPg8wYZrsiFusxTq4mAUr0WMSG80s0w&oe=6A2AC43F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FPS Commando : Army Gun Strike VR", "keywords": ["FPSVR", "VRShootingGame", "CommandoGame", "ArmyShooterVR", "GunStrikeVR"], "long_description": "Step into the boots of an elite commando in FPS Commando: Army Gun Strike VR! Immerse yourself in heart-pounding first-person combat where every mission tests your skills, reflexes, and strategy. Equip a wide arsenal of powerful weapons, from assault rifles to sniper rifles, and take on challenging enemy forces in realistic battlefields.\nExperience the thrill of VR as you navigate intense combat zones, complete daring missions, and dominate the battlefield with precision and speed. With stunning graphics, immersive sound effects, and smooth VR controls, every moment feels like real warfare.\nWhether you're storming enemy bases, rescuing hostages, or engaging in explosive firefights, FPS Commando: Army Gun Strike VR delivers endless action and adrenaline-fueled excitement. Are you ready to become the ultimate commando and lead your army to victory?", "short_description": "Experience intense VR combat as an elite commando in FPS Commando: Army Gun Strike!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/fps-com-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "VCode Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vcode-studio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25204012319195467"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1072915465559954"}, {"status": "PUBLISHED", "id": "1595947304988970"}, {"status": "PUBLISHED", "id": "912949441726018"}, {"status": "PUBLISHED", "id": "881139871461955"}, {"status": "PUBLISHED", "id": "742354492243398"}, {"status": "PUBLISHED", "id": "1350540606613594"}, {"status": "PUBLISHED", "id": "1148730060783682"}]}, "baseline_offer": {"id": "1148730060783682"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time
-2.oculuscdn.com&oh=00_AfuKGFIg888MqD-Hhvt0yrHq4SsyKNpoFy8LFf_Tgv1Ssg&oe=69A6D378"}, {"file_name": "Hero Cover_3000x900.png", "id": "745997868207934", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307315_745997871541267_2304887720336002317_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Fv4oExOqigQ7kNvwEyqBFg&_nc_oc=Adkoq2-VFuszVYmHSRw1IFHnzkjv-KZNy1HbJIoTw38jvA6Fyfa9nzmXRCFBnMOm5ZE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsoJMeKUjrPIHTEICKBeDqLJXQ5qHOaqmH_ZN_1p8Fi1w&oe=69A6CD51"}]}, "id": "1096193289359347", "locale": "en_US", "screenshots": [{"file_name": "CAPTURA_4.png", "id": "3185928944899499", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307311_3185928948232832_2389178967851108134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAvufc0b2N8Q7kNvwFCcbZK&_nc_oc=AdlR7N44VECdQOgRstTrhDYyNLjRZ0j6BQ9HRR0O93WoLPiZWPwA9vADonPo771b7tE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsmYi5D2cb98L8xqS3HXegRZYHqD3jPrr0_HMDIwGw9Fw&oe=69A6E705"}, {"file_name": "CAPTURA_11.png", "id": "1317859539708726", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823485_1317859543042059_4463709698109850280_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P68XvT54C_MQ7kNvwH5O7Yb&_nc_oc=Admq16eg8et2FZMsQdR41NNB5dpX56jHaHDhpK8HJOJQmYg9UQx5gFlMh8WYUAENCpk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfudCFQcS8AXFUbEeviEnJ7Sjt9m2q5xJIotTlN3a9_fcA&oe=69A6DBAA"}, {"file_name": "CAPTURA_1.png", "id": "682945178153695", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304162_682945181487028_6388406382975340335_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOr8oT_aik0Q7kNvwHuIPoq&_nc_oc=AdkyZLGuyIdjkKga-ZMnU-C9B1UCbTMLflT20OezlX1j7gi56DgoywSBDDm3jBZBFvc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft4bWeJ6RlvW31g17iSuHPoj08zpjLH4AgzU1WXmw5tFg&oe=69A6C71F"}, {"file_name": "CAPTURA_13.png", "id": "2525632361148451", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305050_2525632364481784_2730326887136169036_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtBmXWuQS4EQ7kNvwGOhq_B&_nc_oc=Admgi2d4wnMs9DacUhhoEs5C8pyhAs5HqUR3PtJA7of2nr7lD_9qNgSKCA3sLrhsa0s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftzOA5XYDZkSvBYffJSygca6bHQ57nsQAO_rahXoCYF-A&oe=69A6C9E6"}, {"file_name": "CAPTURA_15.png", "id": "2612639052414118", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308204_2612639055747451_5805302125671407090_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TanTppiYweYQ7kNvwFA1vZT&_nc_oc=Adlhiw3m6TonK6dTHLPWb3aWnh8DNOjcjHp7Fnaj-l8wxL8SXWWdo4zwXjjiWqyiA-w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv6OsqQ_ZOCtMZo-IbPjcJq1dZ4kHAmaHTQJC56CcLULw&oe=69A6C37F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Dise\u00f1o de portada_2560X1440.png", "id": "737911672548103", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818938_737911675881436_577908339672538660_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJx_5hS5rf0Q7kNvwENtlpP&_nc_oc=AdkLGPahQmi-PNFZbvaeFUhTvPTzVYZm17iy5C3-CCTVuiyvopA6-SQhe_FJgzp93-M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvC5A3ENTG9YcW6RnFexDX3uN2p1yu5QSz24rYW1-j67A&oe=69A6CF2A"}, "display_name": "Death Flags: Chapter I - Pre-Alpha Demo", "keywords": [], "long_description": "Death Flags: Chapter I is a VR on-rails shooter that blends frantic action with a cinematic narrative. Fight your way through chaotic environments and survive waves of cursed pirates, each with unique abilities that test your aim and reflexes. The scoring and combo system rewards precision and speed: chain perfect shots, multiply your score, and unlock power-ups that make every stage more intense and replayable.\n\nYour escape takes you across Fishbone Island, from coastal villages and burning bazaars to the imposing citadel of King Viktor. Each stage offers alternative routes and a replayable progression system with extra difficulties and challenges for players who want to push their limits.\n\nFace a cursed crew: gunslingers, swordsmen, kamikazes, and minigun-wielding brutes twisted by darkness. Every enemy has unique resistances and tactics, while epic bosses will test everything you\u2019ve learned.\n\nCombat evolves with special magazines (explosive, poisonous, piercing, freezing, and more) that transform the behavior of your pistols and let you adapt your playstyle each run. Add health, time, and power items to survive brutal waves, and unleash legendary power-ups like invincibility, double damage, or the devastating Pirate Fury mode. On top of that, VR customization lets you equip skins and cosmetic accessories for your hands, making every experience unique.\n\nDeath Flags is your gateway to a saga of action, fantasy, and betrayal in a cursed world.", "short_description": "A VR on-rails shooter filled with action, betrayal, and cursed pirates. Experience an epic pirate story on Fishbone Island and witness the first chapter of an unforgettable saga."}]}, "developer_name": null, "developer_privacy_policy_url": "https://disasterprojectgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Disaster Project Games", "support_website_url": null, "website_url": "http://www.disasterprojectgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "us
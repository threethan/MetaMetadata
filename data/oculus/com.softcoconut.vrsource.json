80_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yy5ApE3o-6AQ7kNvwH9S4bE&_nc_oc=AdqwKjw9526mn4uvsSU-cHDN0RTItwk8UnarsLIVXJRIxgC6e16cs-gDza_AjS5qBKM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKUfls_WYcMIaEVcNU6T0qzIKIw7ZwLhN5M-NAH33dxQ&oe=6AB545E2"}, {"file_name": "Sk\u00e6rmbillede 2025-04-06 170135.png", "id": "637606242411199", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391761_637606245744532_6301369794238179516_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FpSN4cVKGkQ7kNvwEr4d21&_nc_oc=Adp4S-9tecNYtbphcRu7Mm0et6xsD2BYr9Ck5UUieQoMnjt4fnuJlanm9JiwEXGF7B8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3Xa1Bab3HXaa7cv_tqCgrkHLIdKLIekgVWXivks64WA&oe=6AB5416E"}, {"file_name": "Sk\u00e6rmbillede 2025-04-06 170124.png", "id": "1333777307899644", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391800_1333777311232977_5281877435476930913_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJEk9iAz-vAQ7kNvwEgudMm&_nc_oc=Adps96vlMl80Qmmc6GViDW7yU0pTKoXe0dDGWwTsdLV7_3zpjMRuxUBwGIxa4r-ABI0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFDLr_ayrmUwDIQZvs6F0A-mHbRvjGDVr0873W_o3yJA&oe=6AB54888"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soft Coconut", "keywords": [], "long_description": "Welcome to Soft Coconut, the ultimate VR multiplayer game where you swing, climb, and monkey around in immersive environments inspired by the classic tag genre. Built for fast-paced fun, goofy physics, and vibrant community interaction, Soft Coconut offers a dynamic experience that\u2019s perfect for both casual players and competitive taggers alike.\n\nWhether you're navigating chaotic obstacle-filled maps, chilling in cozy hangout zones, or showing off your wildest cosmetics, Soft Coconut is your digital jungle gym. With tons of personality, fun hats, a growing collection of game modes, and uniquely crafted maps, the experience is constantly evolving.", "short_description": "Swing, climb, and tag your way through vibrant pixel-style maps in Soft Coconut! Customize your character, explore unique environments, and hang out with friends in this physics-based VR game. With cosmetic rooms, social hubs, and chaotic tree-filled arenas, there's always something to do \u2014 whether you're a chilled monkey or a hyper tagger!\n\n"}]}, "developer_name": "VR Source entertainment", "developer_privacy_policy_url": "https://sites.google.com/view/blue-policy/start", "developer_terms_of_service_url": null, "publisher_name": "bluestudio125@gmail.com", "support_website_url": null, "website_url": "https://dvrsourceentertainment.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9348978355229855"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "680439518005291"}]}, "baseline_offer": {"id": "680439518005291"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744032840, "status": "PUBLISHED", "id": "680439518005291"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9375977295863294", "version": "0.6.0"}, "id": "974242281500460", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__
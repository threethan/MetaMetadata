=6AA17FAD"}, {"file_name": "3.png", "id": "851861837144444", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75236135_851861840477777_9111374691807710977_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_eWyhwLVaAQ7kNvwH-qPqu&_nc_oc=Adqs77-Shj1KD7aOt9na0v6RisNw3F4rwKUyHQUtjmbJW5KKPDZ2jmkaQ48EKtFdY6s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0sqCzdPiqqSOyym_ccTAIJuKtzhfFVbJB0CjmjptQBQ&oe=6AA1493B"}, {"file_name": "6.png", "id": "896648841907512", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974900_896648845240845_657328067941061656_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ak9bGBXJmYgQ7kNvwGA3CFZ&_nc_oc=AdpDokjQBfkP-3YV5r0sEylYEdZ6J9O0wt922_6JPV3Lye1R9njdd4aFzF7KTqJrfMI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyYfnJTSZ05m2tWpHHDO4CvkAGqAdGPSEveWc6ARSUlg&oe=6AA15132"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Find N Seek - Hidden Objects Game", "keywords": ["CasualGame", "HiddenObjects", "FunGame", "ChallengingGame", "Puzzle"], "long_description": "Find N Seek offers an immersive hidden-object experience where players are tasked with finding various concealed items in a race against time. With multiple environments to explore, including a cozy living room, a busy kitchen, a relaxing bedroom, a tidy bathroom, a bustling office, and a stocked supermarket, each setting presents its own unique challenges and object placements.\n\nThe game tests your observation skills and quick thinking as you search through detailed scenes, picking out the cleverly hidden objects before time runs out. Each environment is designed to provide an engaging and interactive experience, with different levels of difficulty to keep players on their toes.\n\nWhether you\u2019re searching through kitchen cupboards or navigating a cluttered office desk, Find N Seek promises hours of fun and challenges for players. With time limits and increasing difficulty, the game becomes more thrilling as you progress, pushing your cognitive abilities to the limit.\n\nPerfect for fans of hidden-object games, Find N Seek offers an exciting and dynamic experience that\u2019s sure to entertain.", "short_description": "Find N Seek is an engaging hidden-object game where players must locate hidden items across multiple environments like the living room, kitchen, bedroom, bathroom, office, and supermarket. Race against the clock to find all the objects before time runs out! With varied scenes and challenging objects to discover, it\u2019s a fun test of observation and quick thinking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27209929071986454"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/43997716_405704652388478_8454695134920415304_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAp2Es56bAUQ7kNvwHhUws3&_nc_oc=Adpg1AHOfdOAfKURAY1aDKPv2ZoaK1RlkgwZDDNYto7Zd_VS-zRCUX6_GQcyKkCkZjU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLomrrdhx-WUpZkB1nDMSjN_oQCa0A7poZn51o6UOef0w
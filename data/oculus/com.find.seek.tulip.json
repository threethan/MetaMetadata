fQQ8IufMGbrHO6ITKC2Quzg&oe=69AC14EE"}, {"file_name": "4.png", "id": "1075722180600539", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974439_1075722190600538_5835354746088066217_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ma8RJB0UIHMQ7kNvwEZ4lZc&_nc_oc=AdluA-OfCHfJ9m9bzn7zv7XP9taNiqCErLcCdPf6tHIHOSP2p0lfPp8l4CA_WUA27SY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyrJj124dEsfdH1iX0bK0hadjRsdtVZlgFChboNvNu1hw&oe=69AC106D"}, {"file_name": "3.png", "id": "851861837144444", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75236135_851861840477777_9111374691807710977_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHAtK4ur2gsQ7kNvwH1qP6_&_nc_oc=AdlufuXjf-OuWQYJRw1qmwlInG5E-oRCd1nXvMlfFlQLnlnNztx0d9BVIw8H3MVUxvw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxq1H0Ygw77fIFAUxNQZGI8q8ZtJ5fM_8ePtrbMEAR-lQ&oe=69AC123B"}, {"file_name": "6.png", "id": "896648841907512", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974900_896648845240845_657328067941061656_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Apv-tVyN0yoQ7kNvwG-zhMp&_nc_oc=Adl4ZV8Nosa07TNNiErzkiPXRSnO-y-xCiMx-w2BcDNQyIpjkKKH-GRF2_UittI8Qtk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyRgzn6u5wvl6L_P7BAqAmmFY2-j4IdYP8wZvo9xXbSng&oe=69AC1A32"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Find N Seek - Hidden Objects Game", "keywords": ["CasualGame", "HiddenObjects", "FunGame", "ChallengingGame", "Puzzle"], "long_description": "Find N Seek offers an immersive hidden-object experience where players are tasked with finding various concealed items in a race against time. With multiple environments to explore, including a cozy living room, a busy kitchen, a relaxing bedroom, a tidy bathroom, a bustling office, and a stocked supermarket, each setting presents its own unique challenges and object placements.\n\nThe game tests your observation skills and quick thinking as you search through detailed scenes, picking out the cleverly hidden objects before time runs out. Each environment is designed to provide an engaging and interactive experience, with different levels of difficulty to keep players on their toes.\n\nWhether you\u2019re searching through kitchen cupboards or navigating a cluttered office desk, Find N Seek promises hours of fun and challenges for players. With time limits and increasing difficulty, the game becomes more thrilling as you progress, pushing your cognitive abilities to the limit.\n\nPerfect for fans of hidden-object games, Find N Seek offers an exciting and dynamic experience that\u2019s sure to entertain.", "short_description": "Find N Seek is an engaging hidden-object game where players must locate hidden items across multiple environments like the living room, kitchen, bedroom, bathroom, office, and supermarket. Race against the clock to find all the objects before time runs out! With varied scenes and challenging objects to discover, it\u2019s a fun test of observation and quick thinking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27209929071
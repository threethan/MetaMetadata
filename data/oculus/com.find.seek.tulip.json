0539", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974439_1075722190600538_5835354746088066217_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iun-Ag_4hjQQ7kNvwG6EuWL&_nc_oc=AdkzZHeQ_gV5Dm4Kqyg67gOs8oGDqlV0hvYXwgXpE-BWRL-QQ7j5wPjAhO7CkuoZSik&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvVbgJmrumLNmW0WAB57kMPoYjEJH1aDfBAmvkLcdldrg&oe=69999B6D"}, {"file_name": "3.png", "id": "851861837144444", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75236135_851861840477777_9111374691807710977_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zi7RMEEb3jEQ7kNvwEfj_eJ&_nc_oc=AdnPFcqY4Tr8fPbZfeuyXaW0uHuwpxbsj-2VowNie1PYN8CPkVds8lG4g8-KtrGhgBU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu0wjpSi8Ffuf-CxAUp0X9lv9B0P7Wr4WHUI29F0cTuFQ&oe=69999D3B"}, {"file_name": "6.png", "id": "896648841907512", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974900_896648845240845_657328067941061656_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pNCCVYaXwYQ7kNvwFaV8TH&_nc_oc=Adla7OKw86V50Fj0UhCMsHvSbJc38W8__RXDIZ0wAD42iW9OtYa1V-RGSzEmOHUTrEM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvjSawfUifzKMeQiVGiGuW1LJcCL71_xa0g1pE1ZAamAw&oe=6999A532"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Find N Seek - Hidden Objects Game", "keywords": ["CasualGame", "HiddenObjects", "FunGame", "ChallengingGame", "Puzzle"], "long_description": "Find N Seek offers an immersive hidden-object experience where players are tasked with finding various concealed items in a race against time. With multiple environments to explore, including a cozy living room, a busy kitchen, a relaxing bedroom, a tidy bathroom, a bustling office, and a stocked supermarket, each setting presents its own unique challenges and object placements.\n\nThe game tests your observation skills and quick thinking as you search through detailed scenes, picking out the cleverly hidden objects before time runs out. Each environment is designed to provide an engaging and interactive experience, with different levels of difficulty to keep players on their toes.\n\nWhether you\u2019re searching through kitchen cupboards or navigating a cluttered office desk, Find N Seek promises hours of fun and challenges for players. With time limits and increasing difficulty, the game becomes more thrilling as you progress, pushing your cognitive abilities to the limit.\n\nPerfect for fans of hidden-object games, Find N Seek offers an exciting and dynamic experience that\u2019s sure to entertain.", "short_description": "Find N Seek is an engaging hidden-object game where players must locate hidden items across multiple environments like the living room, kitchen, bedroom, bathroom, office, and supermarket. Race against the clock to find all the objects before time runs out! With varied scenes and challenging objects to discover, it\u2019s a fun test of observation and quick thinking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27209929071986454"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t
K3VCp2R3zvOrNPEECbgW4E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsX6YBGQSDuyJR7zo1C-l4B6oSZRktf-lpcxZYqktYYnw&oe=699DA48C"}, {"file_name": "6ff23d5a6a9446128407b75c327e5425.png", "id": "1088904199454076", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982534_1088904202787409_9014023357946438227_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fh5QBHo-CAQ7kNvwHU6euQ&_nc_oc=AdmWbxK_iUmVM7rqk4b6RDWypobaofZGZp0NSO4UkatVnHe9eXutHDIPU0-KAhNeNMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsOcg6n49R5t1YnuElWR9enhSCl4NuO84jHFIHDogowHA&oe=699DA352"}, {"file_name": "8cce00a586a14637bf35de5d93a5b1da 2.png", "id": "1319208896031972", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031629_1319208899365305_7959915167021840798_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AreSIhSkc9wQ7kNvwHSozOa&_nc_oc=Adm02GL6761YXXPf9uFPFfcJcpk6N2L0xXRoOb9ccnm1sZoaODdO01ZdT4jGkPK_jxA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftJgjpF5LyIaHSQszWLS4R38ACRfaTD6HJLjbManHqc7w&oe=699D962E"}, {"file_name": "8455b99ab30349b8b83c14d5cf62ee0d.png", "id": "909974784533740", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001658_909974787867073_8672488951019047855_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLT1m6eGLBMQ7kNvwERwTTn&_nc_oc=AdmOSMjRdalTGrL87xSP6q3nBf_anUtb6nnoqwvu-zorX-e6Lm4Yh-8U-x0NDNnwoWc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu35-kRCfOmGlaQqkFL91EQfEfVSHl-anqYIQOMXHmmEA&oe=699D87B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Charles VR", "keywords": [], "long_description": "Charles V|R is a virtual reality reconstruction of the coronation of Holy Roman Emperor Charles V in Bologna, Italy, in February of 1530. The details of his coronation reflect the social and political turmoil of the times. Charles V|R is a recreation of the sights and sounds of this religious and political ceremony using contemporaneous accounts, artwork, and music as source material. Complete with direct access to the scholarly and archival sources that informed our choices, Charles V|R offers enthusiasts of art, architecture, history, music, religion, and virtual reality as well as students and scholars of those disciplines a multi-modal window into an event of world-historical importance.", "short_description": "Reconstruction of HRE Charles V's 1530 Coronation Mass in Bologna."}]}, "developer_name": "Greenhouse Studios", "developer_privacy_policy_url": "https://greenhousestudios.uconn.edu/charles-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Greenhouse Studios", "support_website_url": "https://greenhousestudios.uconn.edu/contact-us", "website_url": "https://greenhousestudios.uconn.edu/charlesvr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28602575622666656"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031632_1894776477716456_2368005796672080765_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQXOVtkekq4Q7kNvwHiP9TV&_nc_oc=AdkJOsEJ53WslgLT-aYT-ooB6fMujibGOmCDe4a04a2CVrEVBYwgiMNlRU6-WvYaMYc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftSUVlBCPhe6mmHls4sRPWSubBfC7MjtJDnVTOtKzwniw&oe=699DAB76"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
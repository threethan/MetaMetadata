wEcUmh0&_nc_oc=AdnRGPIVsiGR4mgrel-Vxahr3FcvWPDRvPpATkGmh9nJtn7O2Ls3l4aCcuhCHme3_Pw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvPb_5XepvDAoE2FUwyPIjuooRG65v9-Wph027QOxk-gg&oe=699C3637"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Charles VR", "keywords": [], "long_description": "Charles V|R is a virtual reality reconstruction of the coronation of Holy Roman Emperor Charles V in Bologna, Italy, in February of 1530. The details of his coronation reflect the social and political turmoil of the times. Charles V|R is a recreation of the sights and sounds of this religious and political ceremony using contemporaneous accounts, artwork, and music as source material. Complete with direct access to the scholarly and archival sources that informed our choices, Charles V|R offers enthusiasts of art, architecture, history, music, religion, and virtual reality as well as students and scholars of those disciplines a multi-modal window into an event of world-historical importance.", "short_description": "Reconstruction of HRE Charles V's 1530 Coronation Mass in Bologna."}]}, "developer_name": "Greenhouse Studios", "developer_privacy_policy_url": "https://greenhousestudios.uconn.edu/charles-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Greenhouse Studios", "support_website_url": "https://greenhousestudios.uconn.edu/contact-us", "website_url": "https://greenhousestudios.uconn.edu/charlesvr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
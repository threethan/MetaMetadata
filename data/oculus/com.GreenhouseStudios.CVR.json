_Af0W7GSra_RGLRP28SrsLvZhV5KtfMnZxT4aDHz5-KTraQ&oe=69D7982E"}, {"file_name": "8455b99ab30349b8b83c14d5cf62ee0d.png", "id": "909974784533740", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001658_909974787867073_8672488951019047855_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kk-03A1HixcQ7kNvwH1XCfs&_nc_oc=AdpKj7XmHWqFJNFip9IDVZpYzfANVwdv3BYyUVob8kiXMPuufFKJ_pBr0kGC_fPuRic&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0THFGVJ0Nx_JhW_jY_TLpnfF9lZgJXMmO1KliVE61RXg&oe=69D789B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Charles VR", "keywords": [], "long_description": "Charles V|R is a virtual reality reconstruction of the coronation of Holy Roman Emperor Charles V in Bologna, Italy, in February of 1530. The details of his coronation reflect the social and political turmoil of the times. Charles V|R is a recreation of the sights and sounds of this religious and political ceremony using contemporaneous accounts, artwork, and music as source material. Complete with direct access to the scholarly and archival sources that informed our choices, Charles V|R offers enthusiasts of art, architecture, history, music, religion, and virtual reality as well as students and scholars of those disciplines a multi-modal window into an event of world-historical importance.", "short_description": "Reconstruction of HRE Charles V's 1530 Coronation Mass in Bologna."}]}, "developer_name": "Greenhouse Studios", "developer_privacy_policy_url": "https://greenhousestudios.uconn.edu/charles-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Greenhouse Studios", "support_website_url": "https://greenhousestudios.uconn.edu/contact-us", "website_url": "https://greenhousestudios.uconn.edu/charlesvr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"
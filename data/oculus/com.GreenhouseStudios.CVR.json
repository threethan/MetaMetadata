ZFtC4SpZjof3_vMbqasTLI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afv2qT1nrPrrlX4fSQmiAoIzyMU3XYTKGtfCSoaZ8QsgEA&oe=69985E8C"}, {"file_name": "6ff23d5a6a9446128407b75c327e5425.png", "id": "1088904199454076", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982534_1088904202787409_9014023357946438227_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bLp1lQSW9kQ7kNvwGndK3w&_nc_oc=AdnYLcbLdGMqh9rx0eHpuxGZNC6S1c-n7c8gas2tvOirU8MRemPHuwbSlm-KxKuGeiE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsXGZl_wANZaAUEpKwb7LbNYkicxy6HJaEH7DxTlj939A&oe=69985D52"}, {"file_name": "8cce00a586a14637bf35de5d93a5b1da 2.png", "id": "1319208896031972", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031629_1319208899365305_7959915167021840798_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipj-Q6bg1dsQ7kNvwG9VPVa&_nc_oc=Adm0eABJydEF7kATDDwEUNYtUQpzfSZMZBjUWK1pA8lFmXMPqXrvQlxeTHfvktJyXh8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuQb9PhMC_FQQhSzmlzAo_eo_ztkL5cN1aFDr38_8X26A&oe=6998502E"}, {"file_name": "8455b99ab30349b8b83c14d5cf62ee0d.png", "id": "909974784533740", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001658_909974787867073_8672488951019047855_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYg3mFUU1VsQ7kNvwFNUsuS&_nc_oc=AdlLw9vKY1Q4NGQ3IRtGq4hIPhH_e7oT7K3d8Xnij8a7-7SJjJXvQjKIIuqjvEKyhnA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuJvuGVYsXl48UYUbxsZLGxB9dCC-yYeq4TVIQCl77z5A&oe=699841B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Charles VR", "keywords": [], "long_description": "Charles V|R is a virtual reality reconstruction of the coronation of Holy Roman Emperor Charles V in Bologna, Italy, in February of 1530. The details of his coronation reflect the social and political turmoil of the times. Charles V|R is a recreation of the sights and sounds of this religious and political ceremony using contemporaneous accounts, artwork, and music as source material. Complete with direct access to the scholarly and archival sources that informed our choices, Charles V|R offers enthusiasts of art, architecture, history, music, religion, and virtual reality as well as students and scholars of those disciplines a multi-modal window into an event of world-historical importance.", "short_description": "Reconstruction of HRE Charles V's 1530 Coronation Mass in Bologna."}]}, "developer_name": "Greenhouse Studios", "developer_privacy_policy_url": "https://greenhousestudios.uconn.edu/charles-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Greenhouse Studios", "support_website_url": "https://greenhousestudios.uconn.edu/contact-us", "website_url": "https://greenhousestudios.uconn.edu/charlesvr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28602575622666656"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031632_1894776477716456_2368005796672080765_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFWQWEz3sTAQ7kNvwFiPwvi&_nc_oc=AdlydCNBB1CA4WUUjlhCxeXoagKDQXYSD6MvBQzX_FuUxJKQVo02dQs7-csSwhHsn4o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftVLiLhghOPD3IGnj-UXC2IVxddNGAUtQgddJV-KDzL5w&oe=69986576"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
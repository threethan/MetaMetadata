=1-7&_nc_sid=6e7a0a&_nc_ohc=hZFEuAuldwsQ7kNvwEUFsis&_nc_oc=AdqJWvgGtnnAtwX8rVVDhuZxEUBTFzLeOqeLyoD73JbmGzfv-A9nRKxp8jMBr9h59Rs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65LWFmLyGaIQ2o41XL8-CjqndZMf07ZLfriFiBM0iKFQ&oe=6A1D860C"}, {"file_name": "6ff23d5a6a9446128407b75c327e5425.png", "id": "1088904199454076", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982534_1088904202787409_9014023357946438227_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eO3iAsmZIJ4Q7kNvwHBH74p&_nc_oc=Ado34bX8etrk7AWIPV6WRBwlpz1VBmqkG31Unq0NF_3UYCVcsHaKaFOz2B6N6CeaCI8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tNEXypNtiex-0ZjY1IuBSShWq-QM0vLFq0dKHWrjMhA&oe=6A1D84D2"}, {"file_name": "8cce00a586a14637bf35de5d93a5b1da 2.png", "id": "1319208896031972", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_1319208899365305_7959915167021840798_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bo74gv6QTTMQ7kNvwH-Wix9&_nc_oc=Adqf53ZYlui-xAuiSlQtv767Ok4MAV4LvDHM-5KfCvGqrXXBmS3KvWvYKQVO5Kr8cLo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KLL7BDH8_qUF-cdn4X96LxmDWMPVtLVl91kWmPuEYZg&oe=6A1DAFEE"}, {"file_name": "8455b99ab30349b8b83c14d5cf62ee0d.png", "id": "909974784533740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001658_909974787867073_8672488951019047855_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dHkjb3bTOcQ7kNvwH4jlbc&_nc_oc=AdrRH0FECwLTd4nevIPznfA3eo2lPJ1gPbAnKsvGtBAYK28yI666ocZEpFCVNbHVOcE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GFKFAXFtRbfpKfEaMukvAghGA5NxjC0iCXNFrJkENKQ&oe=6A1DA177"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Charles VR", "keywords": [], "long_description": "Charles V|R is a virtual reality reconstruction of the coronation of Holy Roman Emperor Charles V in Bologna, Italy, in February of 1530. The details of his coronation reflect the social and political turmoil of the times. Charles V|R is a recreation of the sights and sounds of this religious and political ceremony using contemporaneous accounts, artwork, and music as source material. Complete with direct access to the scholarly and archival sources that informed our choices, Charles V|R offers enthusiasts of art, architecture, history, music, religion, and virtual reality as well as students and scholars of those disciplines a multi-modal window into an event of world-historical importance.", "short_description": "Reconstruction of HRE Charles V's 1530 Coronation Mass in Bologna."}]}, "developer_name": "Greenhouse Studios", "developer_privacy_policy_url": "https://greenhousestudios.uconn.edu/charles-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Greenhouse Studios", "support_website_url": "https://greenhousestudios.uconn.edu/contact-us", "website_url": "https://greenhousestudios.uconn.edu/charlesvr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28602575622666656"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031632_1894776477716456_2368005796672080765_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4ZzmbHZdIIQ7kNvwFLvqqC&_nc_oc=AdqsNu2vkGq-G1zMi8oIAq7yp0HZrED5jv8uD5-S23as_1QdwMWQBeebncZkPkiHwBI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn
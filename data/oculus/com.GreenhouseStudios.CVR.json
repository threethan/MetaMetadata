_Af4aCJ0DcyzDQNmeyUYpHei1NxZnp1-munsdeRDGMkF8aQ&oe=6A0076AE"}, {"file_name": "8455b99ab30349b8b83c14d5cf62ee0d.png", "id": "909974784533740", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001658_909974787867073_8672488951019047855_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvpaO5BxVDkQ7kNvwFWg9WJ&_nc_oc=AdrUC3hPD3EfesKYTiMuTI5PksOZ9XDFtdVQHFWimeUEPM9ZHD0oh4LFZ6N48PzUlV4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6g-RBG84TfIB1zyFNnD09Qpypn3spb4iVqtoPrw2HfRg&oe=6A00A077"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Charles VR", "keywords": [], "long_description": "Charles V|R is a virtual reality reconstruction of the coronation of Holy Roman Emperor Charles V in Bologna, Italy, in February of 1530. The details of his coronation reflect the social and political turmoil of the times. Charles V|R is a recreation of the sights and sounds of this religious and political ceremony using contemporaneous accounts, artwork, and music as source material. Complete with direct access to the scholarly and archival sources that informed our choices, Charles V|R offers enthusiasts of art, architecture, history, music, religion, and virtual reality as well as students and scholars of those disciplines a multi-modal window into an event of world-historical importance.", "short_description": "Reconstruction of HRE Charles V's 1530 Coronation Mass in Bologna."}]}, "developer_name": "Greenhouse Studios", "developer_privacy_policy_url": "https://greenhousestudios.uconn.edu/charles-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Greenhouse Studios", "support_website_url": "https://greenhousestudios.uconn.edu/contact-us", "website_url": "https://greenhousestudios.uconn.edu/charlesvr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"
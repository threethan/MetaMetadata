=1-7&_nc_sid=6e7a0a&_nc_ohc=eoJyLHayZ9wQ7kNvwH7dZhL&_nc_oc=AdqjzzW1hmEK6lkqbMVm7xSBReI-2qx-B8b0CKzY-I_Ukt6f-nmaRVvtzkuANWskQmo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXhkpmDXEIzf-KaqSpwgy8eXH93vZFo0v62e8Huv2Prw&oe=6A64B70C"}, {"file_name": "6ff23d5a6a9446128407b75c327e5425.png", "id": "1088904199454076", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982534_1088904202787409_9014023357946438227_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsXV8OgnuiUQ7kNvwE0L0iu&_nc_oc=AdrC2VboNfOUKz8_9O709tZccfY-jRRQTY07QGgcrt1vyv_ae0piNGc85ZmJMfZi1Ao&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXyLHLYC-41BxYXJyJmj56C23dppMm_t2M6dDDOj_Ehw&oe=6A64B5D2"}, {"file_name": "8cce00a586a14637bf35de5d93a5b1da 2.png", "id": "1319208896031972", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031629_1319208899365305_7959915167021840798_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=91nRfmAt4J8Q7kNvwGVdPWp&_nc_oc=AdqU_53onH1B2DnZ1oJZq2QuW8iLof1wpInQ4WFGiB1wKMSsL747hO51hwyJjArXy6k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBf0r4Mbq27BbifoI2FQrB7AXgT6vvr8Yd_E-UBsdRpiQ&oe=6A64A8AE"}, {"file_name": "8455b99ab30349b8b83c14d5cf62ee0d.png", "id": "909974784533740", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001658_909974787867073_8672488951019047855_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3zNFbF7BSMQ7kNvwE1fhak&_nc_oc=AdoocQAErPxjOMMRcmIhjSzKDjox2ImP20L9aMGK0jDTb1nKohpVU8v4lBD1vyQWYL0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqHaPAsOSH0cs7bs_HmrqWd9X_3CGwwScDSw5HQxKArw&oe=6A64D277"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Charles VR", "keywords": [], "long_description": "Charles V|R is a virtual reality reconstruction of the coronation of Holy Roman Emperor Charles V in Bologna, Italy, in February of 1530. The details of his coronation reflect the social and political turmoil of the times. Charles V|R is a recreation of the sights and sounds of this religious and political ceremony using contemporaneous accounts, artwork, and music as source material. Complete with direct access to the scholarly and archival sources that informed our choices, Charles V|R offers enthusiasts of art, architecture, history, music, religion, and virtual reality as well as students and scholars of those disciplines a multi-modal window into an event of world-historical importance.", "short_description": "Reconstruction of HRE Charles V's 1530 Coronation Mass in Bologna."}]}, "developer_name": "Greenhouse Studios", "developer_privacy_policy_url": "https://greenhousestudios.uconn.edu/charles-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Greenhouse Studios", "support_website_url": "https://greenhousestudios.uconn.edu/contact-us", "website_url": "https://greenhousestudios.uconn.edu/charlesvr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28602575622666656"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031632_1894776477716456_2368005796672080765_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5q7tUOWJ8p0Q7kNvwGv1_hd&_nc_oc=AdoGb0iMOzMlA5nHDEgrvIamC1cRyezh0dHLLNeB6BQg9Xljc7DhE6Ka0y_AkKGTkfw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn
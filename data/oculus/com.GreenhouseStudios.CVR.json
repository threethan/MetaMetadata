=1-7&_nc_sid=6e7a0a&_nc_ohc=TdYcK8QIDmcQ7kNvwHJSYDR&_nc_oc=AdqDSsS1EWHXpH81zVoUlXPbMcdESzegn1Lkd2bYCaknYEMz1X4JfX0QqUg5VSCGfrc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0zTz4pn_c1l838X5ywb29XZBr3sQNOc93xj75js3Xj2w&oe=69F4A78C"}, {"file_name": "6ff23d5a6a9446128407b75c327e5425.png", "id": "1088904199454076", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982534_1088904202787409_9014023357946438227_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgfkVv-c4HgQ7kNvwGMixHr&_nc_oc=Adoe-mzlRVRoj_ZoPNP0m6BbYwZqPMcyKiGA7SkGNa-_mvE7tdhEI16PcafPEAXwNkA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2LhMKZ97qcoDcnR3aZu7uXo4oRVFuhO4th0vpkuDBKgA&oe=69F4A652"}, {"file_name": "8cce00a586a14637bf35de5d93a5b1da 2.png", "id": "1319208896031972", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031629_1319208899365305_7959915167021840798_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSAtkK_8QW8Q7kNvwGThEMR&_nc_oc=AdpcDv6ojQUxaE4eiLnTDkVk7972x8TLWm16TU83CbHLxB40Dzk65GIV4FfU7Am7dUs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0IbR09LzF74DTTLGqsN-7RGiclW7kL8aNig-_whsP_fQ&oe=69F4992E"}, {"file_name": "8455b99ab30349b8b83c14d5cf62ee0d.png", "id": "909974784533740", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001658_909974787867073_8672488951019047855_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSkDleM11GAQ7kNvwFvIXGH&_nc_oc=AdozDREXlMigpSLyL2Q2snagP1nWHBU6TFUQAX1dd6iygccPgYFoOJEt2j2d4a-EsFE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3klJICsuxy-FJDMfL6VAg5d7MY7FsyiZII1sbJJUJ4_w&oe=69F4C2F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Charles VR", "keywords": [], "long_description": "Charles V|R is a virtual reality reconstruction of the coronation of Holy Roman Emperor Charles V in Bologna, Italy, in February of 1530. The details of his coronation reflect the social and political turmoil of the times. Charles V|R is a recreation of the sights and sounds of this religious and political ceremony using contemporaneous accounts, artwork, and music as source material. Complete with direct access to the scholarly and archival sources that informed our choices, Charles V|R offers enthusiasts of art, architecture, history, music, religion, and virtual reality as well as students and scholars of those disciplines a multi-modal window into an event of world-historical importance.", "short_description": "Reconstruction of HRE Charles V's 1530 Coronation Mass in Bologna."}]}, "developer_name": "Greenhouse Studios", "developer_privacy_policy_url": "https://greenhousestudios.uconn.edu/charles-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Greenhouse Studios", "support_website_url": "https://greenhousestudios.uconn.edu/contact-us", "website_url": "https://greenhousestudios.uconn.edu/charlesvr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28602575622666656"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031632_1894776477716456_2368005796672080765_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKPfhDORgfAQ7kNvwFr8-Ok&_nc_oc=AdpaYku2FPg_iKBsq055NJryx5iH3aSmmNQEK6dbIVRhCnrGC7wVyKnypeBc-pk_jDE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn
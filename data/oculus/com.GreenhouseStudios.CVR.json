=1-7&_nc_sid=6e7a0a&_nc_ohc=TdYcK8QIDmcQ7kNvwGJW-of&_nc_oc=AdroRJuwrdbV8olvYq29F6KWPnKkNGIZYAEtsW9xbYmKoHOmIU-1sT4InK6V2rq4A4U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0C6E536Pp771JYOP0LbaskR-IAxgDSgLaMgtkN1qCoWQ&oe=69F5F90C"}, {"file_name": "6ff23d5a6a9446128407b75c327e5425.png", "id": "1088904199454076", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982534_1088904202787409_9014023357946438227_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgfkVv-c4HgQ7kNvwFtcB04&_nc_oc=AdoFBCiIVdnbEzQc6mLb8LBpPpCz_0ZwwnLcSop2s6rJPw0iVjkht69eLgneeQ_sTvA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2YxHH2mS0n4RdSmd7ZO-TrmpBKF00Mb1449a-vn5MwGg&oe=69F5F7D2"}, {"file_name": "8cce00a586a14637bf35de5d93a5b1da 2.png", "id": "1319208896031972", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031629_1319208899365305_7959915167021840798_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSAtkK_8QW8Q7kNvwEFx1di&_nc_oc=AdobqZyM2JMktip4Qp82hQvnnOBCnOJnFsDsyAPibo-Ran2ktB2fYOHVqPKBTqknXDY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0mKXeTx7TbR1pCdQ-4o-BV63_LiZ1PSCgFwv0nYgC5Yg&oe=69F5EAAE"}, {"file_name": "8455b99ab30349b8b83c14d5cf62ee0d.png", "id": "909974784533740", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001658_909974787867073_8672488951019047855_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSkDleM11GAQ7kNvwEj8RgC&_nc_oc=AdpYktWjeD_n_ZY_vJiQbo9AYpuWSvsCLJqJnP6lp7oyWOWQYcC8SmMJufto50un1Oo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3KoN4J1gdPx3CLM8sOY4_gMmYfzsWIkCQ0n7cu2C-ssg&oe=69F61477"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Charles VR", "keywords": [], "long_description": "Charles V|R is a virtual reality reconstruction of the coronation of Holy Roman Emperor Charles V in Bologna, Italy, in February of 1530. The details of his coronation reflect the social and political turmoil of the times. Charles V|R is a recreation of the sights and sounds of this religious and political ceremony using contemporaneous accounts, artwork, and music as source material. Complete with direct access to the scholarly and archival sources that informed our choices, Charles V|R offers enthusiasts of art, architecture, history, music, religion, and virtual reality as well as students and scholars of those disciplines a multi-modal window into an event of world-historical importance.", "short_description": "Reconstruction of HRE Charles V's 1530 Coronation Mass in Bologna."}]}, "developer_name": "Greenhouse Studios", "developer_privacy_policy_url": "https://greenhousestudios.uconn.edu/charles-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Greenhouse Studios", "support_website_url": "https://greenhousestudios.uconn.edu/contact-us", "website_url": "https://greenhousestudios.uconn.edu/charlesvr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28602575622666656"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031632_1894776477716456_2368005796672080765_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jr8K8IjMmeoQ7kNvwFIEj4M&_nc_oc=AdpQq6w7sVwDRVvrij9m4a7ni9rMtMzu1JGPAyZSe5KDoSN9jYtrvP8UpPH7rsV9jTc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn
_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APwArlcbN1YQ7kNvwG1s1mC&_nc_oc=AdrWfDb2HMSzjmgpkJhXn_86r6k8O-FmbXRbKemTqHCg_W8H14hdfQZrkl37YNM6zL4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWGqUwnsk4JYkLdkbOqe_v_h5KLiT2ZjwOpXDbxG5PYmA&oe=6B0F1E24"}, {"file_name": "04-snow-kingdom.png", "id": "1454572336101066", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823746_1454572339434399_8719528324125485250_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnAELpTGJgUQ7kNvwH8RrE5&_nc_oc=Adr-E1sQ7Pce-9hw5qF9DnM1ouI3SZnoDuoA64BqRjTPdnxsxwsUOZWoz6eXGganUQ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXtNLs_f1429-HhA_pgcGI-jJ_sWlvBdwlZ0lGS85TRJg&oe=6B0F1BFF"}, {"file_name": "05-desert.png", "id": "1677426973901640", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1677426977234973_2906622747718436815_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOfN_CKeYFgQ7kNvwGKM8uu&_nc_oc=Adogf9Yr3it5eH4YIr6XEHUG8PQr4jBld0NuJ-gUerVSbddsU9MPbzhjg0pjkZsQucg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXziO9rXEdjnZlk52pmaDdKRsgTY7M4NcNSQzmt8pXbuw&oe=6B0F1A4E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BONKWARD VR", "keywords": ["archery", "roguelite", "fantasy", "horde", "survival"], "long_description": "Your tower. Your bow. A horde with zero chill.\n\nBONKWARD VR is a single-player archery horde game with retro fantasy vibes. Reach behind your shoulder, grab an arrow, draw the string and send it.\n\nBUILD A RIDICULOUS BOW\nFire? Explosions? Why not both! Stack powers, boost your disciplines and collect relics until your build gets properly unhinged. Let it cook.\n\nHOLD YOUR GROUND\nSkeletons, ogres and more up ahead . Shoot down incoming bombs, watch the roads and check your stairs. Those little guys are absolutely coming up. Survive three stages, face the area boss and slap the button when you're ready to bounce.\n\nCOME BACK STRONGER\nGot bonked? Bank your Silver, buy permanent upgrades and run it back. Spend Gold on chests mid-run, discover new gear and chase that \"okay, THIS is the build\" moment.\n\nFEATURES\n\u2022 8 unique bows.\n\u2022 6 maps.\n\u2022 17 disciplines to shape your build.\n\u2022 46 items to collect and stack.\n\u2022 6 area bosses with questionable names.\n\u2022 Permanent upgrades, rerolls and banishes\n\u2022 Physical VR archery, chunky enemies and colourful chaos.\n\u2022 A workout for your arm, or just get more headshots (skill issue?) \n\nOne more run. One more bonk.", "short_description": "Grab your bow, build ridiculous bows and hold your tower against a horde. Physical VR archery meets roguelite progression: stack weapon powers, collect relics and earn Silver for permanent unlocks. YOUR. ARM. WILL. HURT."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/8e088e07-fb27-4e87-83d2-42516437810f", "developer_terms_of_service_url": null, "publisher_name": "abdeck labs", "support_website_url": "https://abdeck-labs.just-birch-8563.chatgpt.site/#support", "website_url": "https://abdeck-labs.just-birch-8563.chatgpt.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1430752640125235"}}]}, "scheduled_offers": 
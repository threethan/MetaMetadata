t-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUFKyCxwBJ8knHzNRZTq7Xt1e5-7Rn8aQkMFxM1Y8U0mQ&oe=6B0F0929"}, {"file_name": "logo-transparent-2172x724.png", "id": "1129163069890834", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1129163073224167_6445676634052719214_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNmCFaYSMkgQ7kNvwG6o3QW&_nc_oc=Adq20fx6RbKPyJE3-jw-L5U_E6QGdSGMAKoQp7CVFCGyvmgFI1fVq2V7fYiri97wmQE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXl1g74xLHbhp72S_Y2TmlxqULd-cbk4AcQXgxQgqFvTw&oe=6B0EF14A"}]}, "id": "1735114931458744", "locale": "en_US", "screenshots": [{"file_name": "01-marshes-horde-chaos.png", "id": "1117719957800962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823351_1117719967800961_2516736107851354484_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UVgWHQJpMwQ7kNvwHENvqp&_nc_oc=Ado9_I2uhnSOIIqCAgd6rWbZd6AeN_bFN0SNAguZpQVw0MXlfArl0VlYYqYHR70LnZA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUWhyqG2dE3oRlgxKK2aVpHBdpYERuHcevymGBK3TnPvw&oe=6B0EFEC2"}, {"file_name": "02-graveyard-stair-defence.png", "id": "1189168233546045", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823276_1189168236879378_7505141632552321567_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTeEhkMNFToQ7kNvwEbOB1_&_nc_oc=AdpF_g8l1NdCgVPuLMEVRMV6dVOZjzZxLGafhFqt2G1mTWYx8IQ4MY3-P_FmQn7vt7c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUBeYzSg0vTha5RsPurbHdPKFrEKn6eGuUCuL6SeBTQyA&oe=6B0F04C7"}, {"file_name": "03-build-your-bow.png", "id": "1141388071587641", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819875_1141388074920974_5085176468225537691_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APwArlcbN1YQ7kNvwG1s1mC&_nc_oc=AdrWfDb2HMSzjmgpkJhXn_86r6k8O-FmbXRbKemTqHCg_W8H14hdfQZrkl37YNM6zL4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWGqUwnsk4JYkLdkbOqe_v_h5KLiT2ZjwOpXDbxG5PYmA&oe=6B0F1E24"}, {"file_name": "04-snow-kingdom.png", "id": "1454572336101066", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823746_1454572339434399_8719528324125485250_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnAELpTGJgUQ7kNvwH8RrE5&_nc_oc=Adr-E1sQ7Pce-9hw5qF9DnM1ouI3SZnoDuoA64BqRjTPdnxsxwsUOZWoz6eXGganUQ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXtNLs_f1429-HhA_pgcGI-jJ_sWlvBdwlZ0lGS85TRJg&oe=6B0F1BFF"}, {"file_name": "05-desert.png", "id": "1677426973901640", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1677426977234973_2906622747718436815_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOfN_CKeYFgQ7kNvwGKM8uu&_nc_oc=Adogf9Yr3it5eH4YIr6XEHUG8PQr4jBld0NuJ-gUerVSbddsU9MPbzhjg0pjkZsQucg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXziO9rXEdjnZlk52pmaDdKRsgTY7M4NcNSQzmt8pXbuw&oe=6B0F1A4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "2047940855879848", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908771295_2047940859213181_19564402619721347_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNFmppD7HzsQ7kNvwExgo-4&_nc_oc=AdqkrxEnjZUv7ulko-EkDNIrrBvWx5CSLY_r0T6qs-0ceCWGwsobVYJ_QmQLkGUmZFg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUFJU6LRKeNps4FEHTjqnm7YTlDKxUjqF5alO6Zt9JySg&oe=6B0F1B32"}, "display_name": "BONKWARD VR", "keywords": ["archery", "roguelite", "fantasy", "horde", "survival"], "long_description": "Your tower. Your bow. A horde with zero chill.\n\nBONKWARD VR is a single-player archery horde game with retro fantasy vibes. Reach behind your shoulder, grab an arrow, draw the string and send it. Then do it again. Faster.\n\n{1789208175682801}\n\n# BUILD A RIDICULOUS BOW\n\nFire? Explosions? Why not both! Stack powers, boost your disciplines and collect relics until your build gets properly unhinged. Let it cook.\n\n{2187746232098961}\n\n# HOLD YOUR GROUND\n\nSkeletons, ogres and more up ahead . Shoot down incoming bombs, watch the roads and check your stairs. Those little guys are absolutely coming up. Survive three stages, face the area boss and slap the button when you're ready to bounce.\n\n{940192259028867}\n\n# COME BACK STRONGER\n\nGot bonked? Bank your Silver, buy permanent upgrades and run it back. Spend Gold on chests mid-run, discover new gear and chase that \"okay, THIS is the build\" moment.\n\n{1122991777372044}\n\n# FEATURES\n\n- 8 unique bows.\n- 6 maps.\n- 17 disciplines to shape your build.\n- 46 items to collect and stack.\n- 6 area bosses with questionable names.\n- Permanent upgrades, rerolls and banishes\n- Physical VR archery, chunky enemies and colourful chaos.\n- A workout for your arm, or just get more headshots (skill issue?)\n\nOne more run. One more bonk.", "short_description": "Grab your bow, build ridiculous bows and hold your tower against a horde. Physical VR archery meets roguelite progression: stack weapon powers, collect relics and earn Silver for permanent unlocks. YOUR. ARM. WILL. HURT."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/8e088e07-fb27-4e87-83d2-42516437810f", "developer_terms_of_service_url": null, "publisher_name": "abdeck labs", "support_website_url": "https://abdeck-labs.just-birch-8563.chatgpt.site/#support", "website_url": "https://abdeck-labs.just-birch-8563.chatgpt.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_
c_ohc=TwU7-Wm-08EQ7kNvwHdKR3n&_nc_oc=AdqUY6LY6Y47EJfByIT1Fx5skGzy-sw6k71ajsE-HmC1kGmiivzgcY-Wz_rg7tir5Vk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94_BdEwTwZ_q4JDolDf0u1Aad9os4GKKnsSGOeMVR6iw&oe=6A3A88D1"}, {"file_name": "Screenshot_PROM_03.png", "id": "1321582105947794", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75330719_1321582109281127_8316466314243052429_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gkeefS4VLAQ7kNvwH4EH8c&_nc_oc=AdoMdHw2JRnNZuT6Vne4UW727axuOb9o0C1V9APc67DEA0VDe0mBuY89z9_NdaClufo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-x0Gg_Xbsg8-hpCR0uDo2TryHbAYGts4UrBy4-FNTLZg&oe=6A3A9752"}, {"file_name": "Screenshot_PROM_05.png", "id": "566003722702088", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001663_566003726035421_7616140672752707694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=761pNFBwnhIQ7kNvwFtdRHB&_nc_oc=Ado1OAsQ4ujHaoLqLIR7PAl6EkLX0rZZ7--XcZSRvKFhjityBqscP95QwniJDzc3dIo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81tu_DU6kyt_kvXxGg9ENweiR-_HozeJewPS4Y1r1etQ&oe=6A3A907C"}, {"file_name": "Screenshot_PROM_06.png", "id": "452369020964727", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982477_452369024298060_5229091061398823706_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32A3Ygwngs4Q7kNvwHyy3eO&_nc_oc=Adrny2tcJQtDyp650iN_vqwA-HjHyFydhE4vc0MsySvRXnuvldg_7V29M3gTtJiPH3w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eVL_XTqwCarJVYFINgYGxSUriIcgJApACZIToXh3lSg&oe=6A3A905F"}, {"file_name": "Screenshot_PROM_07.png", "id": "923086533271055", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221323_923086536604388_6213154324408753697_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJeYCybrvV0Q7kNvwGde4pN&_nc_oc=Adq337Nu1b550POTX8Eo91HehxYwB8jzrItsEw2A0-dE7O1j3xYdIkagOcnDg1cqlq8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xn90vtw4sWg6L_slq_-lqc4MB-ozs6U3RSV2p9_hAxg&oe=6A3A9028"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_PROM_05.png", "id": "918980756999209", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982596_918980760332542_7974005682672420107_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRc5IaFgj4UQ7kNvwEhA444&_nc_oc=AdoB4f9qyEkyWkfdlKyEloyNpKzonJZBcqZi9b52yXXsOxPV9N-6PvT3-LKHY0BFGl0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-p8ItOYB_Cttls_tvRuxRCA0MwiAQxMQ0YxPq-zAiPaw&oe=6A3A95D7"}, "display_name": "PROM Simulator (Shoulder Care)", "keywords": ["CNA", "nurse", "nursing", "Shoulder", "training"], "long_description": "In this VR Simulation, learners will master the essential skill of performing passive range of motion (PROM) exercises for a patient's shoulder, focusing on maintaining flexibility and preventing stiffness. \n\nWith multi-language support (English, Spanish, French, and Arabic), this simulator ensures inclusivity and accessibility for a global audience.  \n\nThe experience is enhanced by an AI companion, acting as a virtual mentor, to answer questions to reinforce learning.\n \n# Key Features: \n- Multi-Language Support: Tailored instructions and narrations in four major languages to cater to diverse learners. \n- AI Companion: An interactive assistant that responds to user queries, and provides clarifications to meet learning needs.(NOTE: Generative AI is still experimental)\n\n\n# Learning Objectives:\n- Remember the steps and protocols for performing PROM exercises.\n- Understand the importance of maintaining joint flexibility and preventing stiffness.\n- Apply the correct techniques to perform PROM exercises safely.\n- Analyze the patient's response to the exercises to ensure comfort.\n- Evaluate their own technique to ensure it adheres to best practices and safety standards.\n- Create a supportive and effective exercise environment for patients through proper PROM techniques.\n\nThis comprehensive approach ensures CNAs are well-
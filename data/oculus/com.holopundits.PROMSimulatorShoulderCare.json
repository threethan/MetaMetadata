-25/75330719_1321582109281127_8316466314243052429_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7PsRmNS8jQQ7kNvwHHn2qJ&_nc_oc=AdmwUQqq4s52MLaM2oWqJejKPMVWhLFOqYRy5ssIKQrMtA96hPLvwJWfBubxZZJNsS4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftgXCsv2B3mu7MYzp9bFivgyo0C8Pa_tZ4H78k1PL0eaQ&oe=69A6EF52"}, {"file_name": "Screenshot_PROM_05.png", "id": "566003722702088", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001663_566003726035421_7616140672752707694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9w0FpKla0UQ7kNvwE2kQMW&_nc_oc=AdkB_drRwWPOgNWRZUoKZBhH8XTpliWYq9cy9Kg00QzNXVtG9B886BMgEtc38jFWH7M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfusJ5IRv47cBGzOkiKqD_qwMFPCMnDZK2n3FoiHZjGOwQ&oe=69A6E87C"}, {"file_name": "Screenshot_PROM_06.png", "id": "452369020964727", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982477_452369024298060_5229091061398823706_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49RnSPFZ66UQ7kNvwHUvg8g&_nc_oc=AdlrspVhvOp_Mo4bpNtqq1Gw6Lc_5tINSRFUMs1VBmKsL1bjQaZkiC8JM1QMOrp2zjU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfscOuVFRH9L1UPqxPxkEE8D1A8L4vP1IjVzzNr7tTDOew&oe=69A6E85F"}, {"file_name": "Screenshot_PROM_07.png", "id": "923086533271055", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221323_923086536604388_6213154324408753697_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtqpW9hZEvQQ7kNvwEe0PC-&_nc_oc=AdliredRAhMFPsjqodVxz8hsEgWChd8mcRnG3uIjCBInBhHBmWN7RiidnUgpFBDNqp8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfucD0N3-9sHbc-0SEW_YmfFvXgvuMJkhAhHns_bBUj1yA&oe=69A6E828"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_PROM_05.png", "id": "918980756999209", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982596_918980760332542_7974005682672420107_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXTIimvv-p0Q7kNvwFGt-J8&_nc_oc=Adl0evIIrs7dKRVzrnI3AaDCNU0tMunGJDvIpjMigc2Udw4q6qL5epDEJZVpr6B7bQo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs0dRjO9vtpgepJam2zOzxWcK_3JSAm4QXXuXxbOk0PqA&oe=69A6EDD7"}, "display_name": "PROM Simulator (Shoulder Care)", "keywords": ["CNA", "nurse", "nursing", "Shoulder", "training"], "long_description": "In this VR Simulation, learners will master the essential skill of performing passive range of motion (PROM) exercises for a patient's shoulder, focusing on maintaining flexibility and preventing stiffness. \n\nWith multi-language support (English, Spanish, French, and Arabic), this simulator ensures inclusivity and accessibility for a global audience.  \n\nThe experience is enhanced by an AI companion, acting as a virtual mentor, to answer questions to reinforce learning.\n \n# Key Features: \n- Multi-Language Support: Tailored instructions and narrations in four major languages to cater to diverse learners. \n- AI Companion: An interactive assistant that responds to user queries, and provides clarifications to meet learning needs.(NOTE: Generative AI is still experimental)\n\n\n# Learning Objectives:\n- Remember the steps and protocols for performing PROM exercises.\n- Understand the importance of maintaining joint flexibility and preventing stiffness.\n- Apply the correct techniques to perform PROM exercises safely.\n- Analyze the patient's response to the exercises to ensure comfort.\n- Evaluate their own technique to ensure it adheres to best practices and safety standards.\n- Create a supportive and effective exercise environment for patients through proper PROM techniques.\n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with \nproper care efficiently and compassionately in real-world clinical settings", "short_description": "Learn to perform passive range of motion exercises for a patient's \nshoulder to maintain flexibility and joint health with AI guidance and multilingual support for better learning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-poli
eenshot_PROM_03.png", "id": "1321582105947794", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75330719_1321582109281127_8316466314243052429_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-v5WP7K7eoQ7kNvwEXr8dO&_nc_oc=AdrkSA8ZprKIX0k2EH7ezyYyjm7kzNW6HNtgQ5lDCUwuwm_boiEy5Sc2tRn-kbf7uTM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkHW0lIZJsQbONeLbugM87dCaWqXSmIderkkPVJwo98w&oe=6A6CB052"}, {"file_name": "Screenshot_PROM_05.png", "id": "566003722702088", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001663_566003726035421_7616140672752707694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKyBx5aYOM0Q7kNvwFNMS4f&_nc_oc=Adoap6NUB2VVj4Rz9fsnoTuoxj-Vkuxj2lFqsT8PXUv1L6sTXlgLidC-2fc7JQJQUqU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBC2w1wcQ_EyF190MNJUhm2vwNZGmdTJ9jn6FTUCXdv3g&oe=6A6CA97C"}, {"file_name": "Screenshot_PROM_06.png", "id": "452369020964727", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982477_452369024298060_5229091061398823706_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z50-JSRbKSQQ7kNvwHuQZ3a&_nc_oc=AdpWzKcId0-kw0CPF5J0TsfJoOw3OXaLj-K055ifyUClKYvF5EftEJwbvC02R5vW-cE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBq9RtcaH6MeR_NTkeavw_ZDVs7ny4H6UJ-QvH8n7x2UA&oe=6A6CA95F"}, {"file_name": "Screenshot_PROM_07.png", "id": "923086533271055", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221323_923086536604388_6213154324408753697_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mw-pr-k9hP0Q7kNvwEgBPjj&_nc_oc=AdpVWFxYJwf7yKp_kEbK10LzxgFyDY9Xc6uTpaxPdj44hjsVs_e-q8L2IYBxgo4QoLU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvaMRDdJiE7wYZFY2V7jNHQd9kNjy7AyH9kUELJtemcw&oe=6A6CA928"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_PROM_05.png", "id": "918980756999209", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982596_918980760332542_7974005682672420107_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ihki_RQQamYQ7kNvwHracDJ&_nc_oc=AdpTC_mfopGCeCZwWSKGuNAok6U6gHjl3zvfETxpSRp3H8K2RLqJnBvvP4A2brdVUNM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9xXtwtpaVger7sUOnKpn7RpNcSR_dNqSKTzJIH6ATgg&oe=6A6CAED7"}, "display_name": "PROM Simulator (Shoulder Care)", "keywords": ["CNA", "nurse", "nursing", "Shoulder", "training"], "long_description": "In this VR Simulation, learners will master the essential skill of performing passive range of motion (PROM) exercises for a patient's shoulder, focusing on maintaining flexibility and preventing stiffness. \n\nWith multi-language support (English, Spanish, French, and Arabic), this simulator ensures inclusivity and accessibility for a global audience.  \n\nThe experience is enhanced by an AI companion, acting as a virtual mentor, to answer questions to reinforce learning.\n \n# Key Features: \n- Multi-Language Support: Tailored instructions and narrations in four major languages to cater to diverse learners. \n- AI Companion: An interactive assistant that responds to user queries, and provides clarifications to meet learning needs.(NOTE: Generative AI is still experimental)\n\n\n# Learning Objectives:\n- Remember the steps and protocols for performing PROM exercises.\n- Understand the importance of maintaining joint flexibility and preventing stiffness.\n- Apply the correct techniques to perform PROM exercises safely.\n- Analyze the patient's response to the exercises to ensure comfort.\n- Evaluate their own technique to ensure it adheres to best practices and safety standards.\n- Create a supportive and effective exercise environment for patients through proper PROM techniques.\n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with \nproper care efficiently and compassionately in real-world clinical settings", "short_description": "Learn to perform passive range of motion exercises for a patient's \nshoulder to maintain flexibility and joint health with AI guidance and multilingual support for better learning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "fr", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9104768299585761"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036609_1037685398045483_9196891677518818713_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkInxaagqc8Q7kNvwHTFcLV&_nc_oc=AdpVq2IkNnuXokQy4s_NJCzNqQUK2-4Au9k1X95TxXiCQwJsG872DGIxFZff3sWvxHY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRDal_aZs5nW1qoS1NBnj7ZukPXjo3DdgZRpv7nGtYEQ&oe=6A6C9D55"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PROM Simulator (Shoulder Care)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medical", "id": "478089301798119"}, {"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1734095400, "lastRevision": {"nodes": 
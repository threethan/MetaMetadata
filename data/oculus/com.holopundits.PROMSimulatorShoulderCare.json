eenshot_PROM_03.png", "id": "1321582105947794", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75330719_1321582109281127_8316466314243052429_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2yYV2ttlNEQ7kNvwFriU_9&_nc_oc=AdqiPC0zNBN7LChaiBa4BiITIPbHsW2wYkC6iXbrH6M_KDPN1QlkdvhOhIfKNJXUN-4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fXn9TgSvajAL8Id5y8FgAiowOqcUFjPXOO4F8JMEv9A&oe=6A16FED2"}, {"file_name": "Screenshot_PROM_05.png", "id": "566003722702088", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001663_566003726035421_7616140672752707694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGHToT3xvOoQ7kNvwHD7hoD&_nc_oc=AdphkflOKK6C30OFQ_cJVB9Ckl20KkXFwmyBloOyhX_IPE-mTWLInVufZoMCwKEX1As&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LNgmNERp0AneBEkoSKFtfjeeXmKk5sT8bfqbsF5ZrZw&oe=6A16F7FC"}, {"file_name": "Screenshot_PROM_06.png", "id": "452369020964727", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982477_452369024298060_5229091061398823706_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7O2o9kv2uIYQ7kNvwFdCMms&_nc_oc=Adrkm0CbdbU5Lfzh_e4EoY9ZHgmH2eajz7-c7zpjw08N9K0fQS36XNVlz1iq8tiJabQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wYJS9xbu1DKr4W9dnvduQnonbc2f5wsN5j8Z4LO63oA&oe=6A16F7DF"}, {"file_name": "Screenshot_PROM_07.png", "id": "923086533271055", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75221323_923086536604388_6213154324408753697_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIYTfJPqiQsQ7kNvwGmtqt3&_nc_oc=AdriCZ96u0PNmxOACVIH5Dcn6jfIKOQGc0-tW7QbS_0Vu0yrD9D-GKPR9I5OH5upNIA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52Dox0wB1qNY60qsfCgHEIOdDvLBTBRMRRVyn5Ur2p9g&oe=6A16F7A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_PROM_05.png", "id": "918980756999209", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982596_918980760332542_7974005682672420107_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9P4w04V424Q7kNvwG7WUBC&_nc_oc=AdrnYitkNfEXxsP7Wie6kAgVmCdNytFFPj-Mhz-SxdTYTb453mQFQ690bO7XD5To2D4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PsaHyGPQPCGygwWOKSUw3xb1fEsqaeHkGJrh_4hv1JA&oe=6A16FD57"}, "display_name": "PROM Simulator (Shoulder Care)", "keywords": ["CNA", "nurse", "nursing", "Shoulder", "training"], "long_description": "In this VR Simulation, learners will master the essential skill of performing passive range of motion (PROM) exercises for a patient's shoulder, focusing on maintaining flexibility and preventing stiffness. \n\nWith multi-language support (English, Spanish, French, and Arabic), this simulator ensures inclusivity and accessibility for a global audience.  \n\nThe experience is enhanced by an AI companion, acting as a virtual mentor, to answer questions to reinforce learning.\n \n# Key Features: \n- Multi-Language Support: Tailored instructions and narrations in four major languages to cater to diverse learners. \n- AI Companion: An interactive assistant that responds to user queries, and provides clarifications to meet learning needs.(NOTE: Generative AI is still experimental)\n\n\n# Learning Objectives:\n- Remember the steps and protocols for performing PROM exercises.\n- Understand the importance of maintaining joint flexibility and preventing stiffness.\n- Apply the correct techniques to perform PROM exercises safely.\n- Analyze the patient's response to the exercises to ensure comfort.\n- Evaluate their own technique to ensure it adheres to best practices and safety standards.\n- Create a supportive and effective exercise environment for patients through proper PROM techniques.\n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with \nproper care efficiently and compassionately in real-world clinical settings", "short_description": "Learn to perform passive range of motion exercises for a patient's \nshoulder to maintain flexibility and joint health with AI guidance and multilingual support for better learning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "fr", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9104768299585761"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036609_1037685398045483_9196891677518818713_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8vZpmYhWB8Q7kNvwF_JOET&_nc_oc=AdolpYKGXRslHMKe-YoycVqEIuK5-dlBU0WMYxv2uoRFD6hcRMbWe3TT5e6QEiFNGL0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wYxIpH5aqt1acXOc72Ega8ti8JH-XUIXYcjZkpgYGiQ&oe=6A16EBD5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PROM Simulator (Shoulder Care)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medical", "id": "478089301798119"}, {"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1734095400, "lastRevision": {"nodes": 
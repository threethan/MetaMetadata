eenshot_PROM_03.png", "id": "1321582105947794", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75330719_1321582109281127_8316466314243052429_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYsOBQTRFBwQ7kNvwEiX814&_nc_oc=Adq0NQFVoCDZEq6RP4JRC-t31qlZXOhWlWPGmUKp7RDWe6PEj-HrcoUu-LH6rWD1H10&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCH4hDOvOD4qn8B9odyHez-6DVCqusT7ceRPjq_osQcQ&oe=6A788DD2"}, {"file_name": "Screenshot_PROM_05.png", "id": "566003722702088", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001663_566003726035421_7616140672752707694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdmkbBtMM0MQ7kNvwHBkreu&_nc_oc=AdrYbFGvEG9eNAyjADf8D3JM3irqeSdsvMxKZRoU0nsBssRkGnFOPyUoXNt7I-4t3_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHo-rZxCwBpMhESW3pzVaty3d_ERyvNEQH_1K7v3QwEAw&oe=6A7886FC"}, {"file_name": "Screenshot_PROM_06.png", "id": "452369020964727", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982477_452369024298060_5229091061398823706_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7A3ft0mvQsQ7kNvwFO6NMm&_nc_oc=Adpz7tmFXi_IVK27Yjl-oFWqJL3skhet2bkzrjobRsX9KeZVl30rbgtvpL9qMIfCWnQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5PRXNADtUQIg9aO1h0LKK_nSRk1F5oNiNPKx8vuD1QQ&oe=6A7886DF"}, {"file_name": "Screenshot_PROM_07.png", "id": "923086533271055", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221323_923086536604388_6213154324408753697_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxlNkC9bFg4Q7kNvwGO49Hs&_nc_oc=AdqmY7GkfIxsRy2bhkORWp8CMzvZspMnXIOp8o0GdFfUZhdNyrNAEZqFa8BpV-7QU8w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHttfMerSOgZnbWr40gmH26jFAdNH210bxrU5hOdir27A&oe=6A7886A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_PROM_05.png", "id": "918980756999209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982596_918980760332542_7974005682672420107_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7Opj9wSZd0Q7kNvwHyPL9w&_nc_oc=AdrA9snETG1r7ky1ANuBLtvDgY_NiLciiu1g6GX5iIRhMjWmhCovY57whH0uP4CU068&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrpKdykFxMkyuCOtU56s4D_wloKnz-CL7h2l3Tu7FCkA&oe=6A788C57"}, "display_name": "PROM Simulator (Shoulder Care)", "keywords": ["CNA", "nurse", "nursing", "Shoulder", "training"], "long_description": "In this VR Simulation, learners will master the essential skill of performing passive range of motion (PROM) exercises for a patient's shoulder, focusing on maintaining flexibility and preventing stiffness. \n\nWith multi-language support (English, Spanish, French, and Arabic), this simulator ensures inclusivity and accessibility for a global audience.  \n\nThe experience is enhanced by an AI companion, acting as a virtual mentor, to answer questions to reinforce learning.\n \n# Key Features: \n- Multi-Language Support: Tailored instructions and narrations in four major languages to cater to diverse learners. \n- AI Companion: An interactive assistant that responds to user queries, and provides clarifications to meet learning needs.(NOTE: Generative AI is still experimental)\n\n\n# Learning Objectives:\n- Remember the steps and protocols for performing PROM exercises.\n- Understand the importance of maintaining joint flexibility and preventing stiffness.\n- Apply the correct techniques to perform PROM exercises safely.\n- Analyze the patient's response to the exercises to ensure comfort.\n- Evaluate their own technique to ensure it adheres to best practices and safety standards.\n- Create a supportive and effective exercise environment for patients through proper PROM techniques.\n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with \nproper care efficiently and compassionately in real-world clinical settings", "short_description": "Learn to perform passive range of motion exercises for a patient's \nshoulder to maintain flexibility and joint health with AI guidance and multilingual support for better learning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "fr", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9104768299585761"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036609_1037685398045483_9196891677518818713_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbzONMRY7uYQ7kNvwHVdteN&_nc_oc=Adqj7b140Dtq5oUTukqgWl4hs841xe6Upk8eK430evRJzRSjipgpAAU-NncmPHEgOkI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFigbi-eEtkCLYelSQ2spZlXLsrgR8pq2sVEzZntcCsIw&oe=6A787AD5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PROM Simulator (Shoulder Care)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medical", "id": "478089301798119"}, {"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1734095400, "lastRevision": {"nodes": 
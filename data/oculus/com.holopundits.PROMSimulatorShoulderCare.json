1.oculuscdn.com/v/t64.5771-25/75330719_1321582109281127_8316466314243052429_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RquqlDI7lEQ7kNvwF-677j&_nc_oc=AdpaVcwG6kdGOF44mWcJSX09SgtZa7Byd4HxYUfVhlhR42XjQU0sELLubV8h7MXxtbE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af247kmke5TlBghIfzddyCnlUoinCIKUkE0vZXsWAGMcGQ&oe=69F214D2"}, {"file_name": "Screenshot_PROM_05.png", "id": "566003722702088", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001663_566003726035421_7616140672752707694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jPTFC_LGQUQ7kNvwE65udZ&_nc_oc=AdpjToFYaw16tlY42fK2zDb24lxU7tvRItMhtP-eW9FeqeC1_SW0NbNb3-_-3Vt6hH0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3-w6tOPiuvUOZL6IlKdhrR-_kiZkW4A9epuRU97w_0rw&oe=69F20DFC"}, {"file_name": "Screenshot_PROM_06.png", "id": "452369020964727", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982477_452369024298060_5229091061398823706_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BT0o1u_92CUQ7kNvwGJHDe1&_nc_oc=Adp4puG0mEzjnz_CeGhxaTKZ2AZT58Jrv1zX1g7qNsXQxlPbFtIAL8cQ7fxEKVKWjMw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1aGGQhMeoYoWM3VEBK8ubY1VkRI8J6TJUEYjg-6QvsGQ&oe=69F20DDF"}, {"file_name": "Screenshot_PROM_07.png", "id": "923086533271055", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75221323_923086536604388_6213154324408753697_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-8hvD8mrNEQ7kNvwG9n2Kp&_nc_oc=AdoXlzIrHr5JrHoFwwdW4eloouffUS3iaOG0JT2ym5nIXWk3tdJs6e9udSLcDkIPGuI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3qG3_bWTiDNEyo5K7noM7m21umCf8t3i-LFYbefQtxuA&oe=69F20DA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_PROM_05.png", "id": "918980756999209", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982596_918980760332542_7974005682672420107_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wd2lzFe87vUQ7kNvwGmbEAA&_nc_oc=AdpWYSCjNfOcNId9XaRJzXqZYlj4925tMk617EGPYPG5cOPKBIooA1nO708XRefW73Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2pKybIfurXmqWw43TzNcjTIPcCXeh7vKuEDR4SgfaWIA&oe=69F21357"}, "display_name": "PROM Simulator (Shoulder Care)", "keywords": ["CNA", "nurse", "nursing", "Shoulder", "training"], "long_description": "In this VR Simulation, learners will master the essential skill of performing passive range of motion (PROM) exercises for a patient's shoulder, focusing on maintaining flexibility and preventing stiffness. \n\nWith multi-language support (English, Spanish, French, and Arabic), this simulator ensures inclusivity and accessibility for a global audience.  \n\nThe experience is enhanced by an AI companion, acting as a virtual mentor, to answer questions to reinforce learning.\n \n# Key Features: \n- Multi-Language Support: Tailored instructions and narrations in four major languages to cater to diverse learners. \n- AI Companion: An interactive assistant that responds to user queries, and provides clarifications to meet learning needs.(NOTE: Generative AI is still experimental)\n\n\n# Learning Objectives:\n- Remember the steps and protocols for performing PROM exercises.\n- Understand the importance of maintaining joint flexibility and preventing stiffness.\n- Apply the correct techniques to perform PROM exercises safely.\n- Analyze the patient's response to the exercises to ensure comfort.\n- Evaluate their own technique to ensure it adheres to best practices and safety standards.\n- Create a supportive and effective exercise environment for patients through proper PROM techniques.\n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with \nproper care efficiently and compassionately in real-world clinical settings", "short_description": "Learn to perform passive range of motion exercises for a patient's \nshoulder to maintain flexibility and joint health with AI guidance and multilingual support for better learning."}]}, "developer_name": null, "developer_privacy_po
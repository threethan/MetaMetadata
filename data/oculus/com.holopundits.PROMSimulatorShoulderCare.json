-25/75330719_1321582109281127_8316466314243052429_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsW2jkZOO3IQ7kNvwEJjuwT&_nc_oc=AdkC4oJehMVfrCUPLNT_Ga05E_SVnVvlhw80BOSG-mCU-Nm1lJwamonnrKJUnhW3_4Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsxiG2jv9q4zX-VYl1vklqPRUq9ucJN6vrg9AkNuB_vDQ&oe=69A057D2"}, {"file_name": "Screenshot_PROM_05.png", "id": "566003722702088", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001663_566003726035421_7616140672752707694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKgNKug4SGMQ7kNvwEZkYTV&_nc_oc=AdlmmI3Q7HC9ZJdrH2N6iLHKiwct0k-1PecGMRP_r1vX8PwEGiwJy4--zHhrzWLNuSI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfspICUPckAtAbO2mxGlwm5Yvkg3HDHtroepGHo4yIRy6w&oe=69A050FC"}, {"file_name": "Screenshot_PROM_06.png", "id": "452369020964727", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982477_452369024298060_5229091061398823706_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2o4e7iXun88Q7kNvwGxU-qb&_nc_oc=AdlPa0jmRjRYFrk3lYhKflKKBsi-3G2dPCuqaa-_J7Wwx2fSVcpk22V2TnoqwXA-a-w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvThuY7lSVa2RnY21buZ7mYXxEchimxGMy-PfTic7DjxQ&oe=69A050DF"}, {"file_name": "Screenshot_PROM_07.png", "id": "923086533271055", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221323_923086536604388_6213154324408753697_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LS4Te-DHTr4Q7kNvwFBxbbV&_nc_oc=Adn4RuzIoH0K__8bSvWEQggn-oK5Emq1abh-fjux1sbZo30nJ-DNLHwpvb2BOrupdM8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsx2w4gPvr_zAo1VJd0fN45kOSpIIIzmHLYQybjZpW-0w&oe=69A050A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_PROM_05.png", "id": "918980756999209", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982596_918980760332542_7974005682672420107_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUC9E6GIbswQ7kNvwHlNfPU&_nc_oc=AdnGJ73W5B01TcPFi6A6HdOqCgRlJUabfKgnTSlNaX3O0DB0EHgAVnra71FqGTGIBI4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft1_3fnRcDeox6gf_PgtgoFsc_jG3PVlZAESErPRVHngQ&oe=69A05657"}, "display_name": "PROM Simulator (Shoulder Care)", "keywords": ["CNA", "nurse", "nursing", "Shoulder", "training"], "long_description": "In this VR Simulation, learners will master the essential skill of performing passive range of motion (PROM) exercises for a patient's shoulder, focusing on maintaining flexibility and preventing stiffness. \n\nWith multi-language support (English, Spanish, French, and Arabic), this simulator ensures inclusivity and accessibility for a global audience.  \n\nThe experience is enhanced by an AI companion, acting as a virtual mentor, to answer questions to reinforce learning.\n \n# Key Features: \n- Multi-Language Support: Tailored instructions and narrations in four major languages to cater to diverse learners. \n- AI Companion: An interactive assistant that responds to user queries, and provides clarifications to meet learning needs.(NOTE: Generative AI is still experimental)\n\n\n# Learning Objectives:\n- Remember the steps and protocols for performing PROM exercises.\n- Understand the importance of maintaining joint flexibility and preventing stiffness.\n- Apply the correct techniques to perform PROM exercises safely.\n- Analyze the patient's response to the exercises to ensure comfort.\n- Evaluate their own technique to ensure it adheres to best practices and safety standards.\n- Create a supportive and effective exercise environment for patients through proper PROM techniques.\n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with \nproper care efficiently and compassionately in real-world clinical settings", "short_description": "Learn to perform passive range of motion exercises for a patient's \nshoulder to maintain flexibility and joint health with AI guidance and multilingual support for better learning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-poli
_2127226978147621_2962501648663465178_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njZReePJ-iYQ7kNvwFxhe1l&_nc_oc=AdrEKYs-Sg5Iie3yB1sm713yV5mkxmUKKwI6bmro7FIUwQdv3touTnozR3llx6MaRwo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSReUeSpQ00cfTjPt4vKqr6XZPGpFIbXPcgLhqDM6e9Dg&oe=6AEF47CB"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQDoeu5ZO3oQ7kNvwGnoJXz&_nc_oc=AdqlBII-oRH7oEeHKlDyuQc9puqNYsk_QYHM1ZVNJTcqUg2ZBSZ-NYHxz7xXVwN0g9Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSzPK2hqzLrbZIotwKGd3ng6RB4ctnlW8sxJexnEJ3SQ&oe=6AEF6598"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IkU_ge8NT8gQ7kNvwH7Ok82&_nc_oc=AdrfpvaFLWaTusETsVyK1THmlP8CThXycOvuJ757lmdeI22A5tZDtLG0Nd808me56rk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-Pkwb9Nhv-z3gL-Mc-I9krJujkRTdphJU5wCA3wEODQ&oe=6AEF487B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3 (2).png", "id": "1426773262326683", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620532_1426773265660016_8851344842494668096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCfrxEjiZyYQ7kNvwEqjnbq&_nc_oc=Adpkfjv5QPfZYYxV7Bn0NGRUqbXk0f10bLCBiJ40ei_NmkZb6yy0yfFjhfbuQFMW1Q8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1H9g5_nk9i1-pammwKvpjuwFysYDUdXbymC03JhFlfA&oe=6AEF5B7B"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# NEW: Free Gallery Featuring Artworks from the Louvre! \ud83c\udfdb\ufe0f\u2728\nExplore 34 artworks from the Louvre's collection, including the Mona Lisa and three monumental paintings!                                                                  \n{1632678528350684}\n{1122455587044779}\n\n# See What High Resolution Reveals.\n**Standard vs. High Resolution**\n\n\ud83d\udea8The artwork images are unchanged; the visible difference comes from the app's rendering and display method.\ud83d\udea8\n\n                                                                                                                                 \n{1625477678949865}{3106206799732231}{1114783257894164}{1437177358316906}{1410607057657333}{1050197987985057}{950065198123808}\n*All comparison images shown above were captured directly in the app.\n\n\n# Experience World-Famous Art from Home! \ud83c\udfdb\ufe0f\u2728\n\nStep into elegant virtual galleries from home and enjoy works by 12 renowned painters. Move closer to appreciate brushstrokes, textures, and fine details, listen to audio commentary, and discover the history behind each work.\n\n# \ud83c\udfa8 Key Features\n\n**\ud83c\udfa7 Audio Commentary & Text Guides**: Learn about each work\u2019s context, history, and techniques through audio and clear text panels.\n\n**\ud83d\udcda Integrated Wikipedia**: Open related articles for artist biographies and deeper historical context.\n\n**\ud83d\udd0d Up-Close Viewing**: No crowds or velvet ropes. Take your time and view every painting from close range.\n\n**Please Note**\n\nThis is a test-stage release, not the final version. \ud83c\udfa8\u2728\n* Content and specifications may change.", "short_description": "Experience world-famous masterpieces in stunning high resolution from home! \ud83c\udfa8 Art Museum XR features works by 12 renowned painters in an immersive VR museum. Move closer to reveal brushstrokes, textures, and fine details, listen to audio commentary and read text guides, or explore each work further through seamless Wikipedia integration. Curate your own personal art journey in VR! \ud83c\udfdb\ufe0f  "}]}, "developer_name": null, "developer_privacy_policy_url": "ht
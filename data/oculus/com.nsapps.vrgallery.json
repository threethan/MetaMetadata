culuscdn.com/v/t64.5771-25/499620630_2127226978147621_2962501648663465178_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNcfD9oRYUkQ7kNvwH1Wewt&_nc_oc=Adr_OTNg0mZnliSXWmaIuOcAcxkKJXe0osqGn136N6jW2XtkcYjTHtAWIc_rlbsRm5c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1VtwsJXA8AzdW1Gs8_eDy3zj4eoKeEPeNXtySzq-ucQ&oe=6ABE804B"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XbsvzPsqqIQ7kNvwESbsSN&_nc_oc=AdqH3xKJCp_eAiRxcD23zQ4SN6pJii_p8ZtIco7DD922_z9gno5wscA7kH22HoS60ec&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISMM1S-sq3UKZZOaZP3xuU4wBXOD8jNCeWSyWIX1Yc2g&oe=6ABE65D8"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmlUya0iQiAQ7kNvwFYCmln&_nc_oc=AdpFenPh6_BJMfkftnrY50RNuNiNmeM2N9b7FEbaD0GtphCam9lGGhT-FazKZTP2EQc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLL94UEc4rs88mt10r_Vdh_s9KMsWU8jgkQeoguFRwx1A&oe=6ABE80FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "johannes_vermeer.png", "id": "28534720242819616", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620655_28534720262819614_6180938301831615639_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1rTqUl5jk4Q7kNvwFIcQIa&_nc_oc=AdpnYNv8vPLDu949IP09welOYhD0g7L4AlKlTT-bgc7ZbfKx2p-sypwdLyATaKJZGug&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAM4RHWzp8Ub4p33lZdaPF9bfQGXH1_x-GQ0IMFKiaGQ&oe=6ABE5BCC"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# See What High Resolution Reveals.\n**Standard vs. High Resolution**\n\n\ud83d\udea8The artwork images are unchanged; the visible difference comes from the app's rendering and display method.\ud83d\udea8\n\n                                                                                                                                 \n{1625477678949865}{3106206799732231}{1114783257894164}{1437177358316906}{1410607057657333}{1050197987985057}{950065198123808}\n*All comparison images shown above were captured directly in the app.\n\n\n# Experience World-Famous Art from Home! \ud83c\udfdb\ufe0f\u2728\n\nStep into elegant virtual galleries from home and enjoy works by 12 renowned painters. Move closer to appreciate brushstrokes, textures, and fine details, listen to audio commentary, and discover the history behind each work.\n\n# \ud83c\udfa8 Key Features\n\n**\ud83c\udfa7 Audio Commentary & Text Guides**: Learn about each work\u2019s context, history, and techniques through audio and clear text panels.\n\n**\ud83d\udcda Integrated Wikipedia**: Open related articles for artist biographies and deeper historical context.\n\n**\ud83d\udd0d Up-Close Viewing**: No crowds or velvet ropes. Take your time and view every painting from close range.\n\n**Please Note**\n\nThis is a test-stage release, not the final version. \ud83c\udfa8\u2728\n* Content and specifications may change.\n\n", "short_description": "Experience world-famous masterpieces in stunning high resolution from home! \ud83c\udfa8 Art Museum XR features works by 12 renowned painters in an immersive VR museum. Move closer to reveal brushstrokes, textures, and fine details, listen to audio commentary and read text guides, or explore each work further through seamless Wikipedia integration. Curate your own personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_F
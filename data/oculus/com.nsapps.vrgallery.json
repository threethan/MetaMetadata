culuscdn.com/v/t64.5771-25/499620630_2127226978147621_2962501648663465178_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxCuUcJ1urUQ7kNvwErEjSD&_nc_oc=AdrMIbnja7OAVo-ZAb9eIYSV2YJirAksU-9v3aznhw-tIW40_c4144wzfXhvGHQn8-0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpH8SGFqvNLPZBneXJFOqEcZI107fc0VaO3kjdTiY46g&oe=6ABA8BCB"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PH1WM8oioAQ7kNvwH2jFcg&_nc_oc=Adp6D1mzdl9Tv9P47P8GHut1MYhmwPEtpIVZYe8mmeXcwLhQwUPbaaDfhyI6ZlxoFTk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5J2n_-pJTlMGcyi3pCYVPiHUsbufRL2uICC04yvPRhA&oe=6ABA7158"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TvoVR6xh-AQ7kNvwFE-8Z1&_nc_oc=AdqI4hcz0UBcZWuxsfPa8gYqKitf-0-xws8PcSO4c_Ot50cqO5ZZqNkvE_0OMkDPiNc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzCFfeRHvVsfmZ27jKYTtgZtKhbsew4MW7Cmr3NDpZDQ&oe=6ABA8C7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "johannes_vermeer.png", "id": "28534720242819616", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620655_28534720262819614_6180938301831615639_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JCC222eKTQQ7kNvwEYedfg&_nc_oc=AdrSLwtPACdaWURRN0Dq361dbH-g8Z02VywIjPej8ItewuVflEKUuazkbLYBqnuUhkg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9uWQHuFMXvZLPTxswWnms0l2-Mgnxjq5ORRm_5pajTw&oe=6ABA674C"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# See What High Resolution Reveals.\n**Standard vs. High Resolution**\n\n\ud83d\udea8The artwork images are unchanged; the visible difference comes from the app's rendering and display method.\ud83d\udea8\n\n                                                                                                                                 \n{1625477678949865}{3106206799732231}{1114783257894164}{1437177358316906}{1410607057657333}{1050197987985057}{950065198123808}\n*All comparison images shown above were captured directly in the app.\n\n\n# Experience World-Famous Art from Home! \ud83c\udfdb\ufe0f\u2728\n\nStep into elegant virtual galleries from home and enjoy works by 12 renowned painters. Move closer to appreciate brushstrokes, textures, and fine details, listen to audio commentary, and discover the history behind each work.\n\n# \ud83c\udfa8 Key Features\n\n**\ud83c\udfa7 Audio Commentary & Text Guides**: Learn about each work\u2019s context, history, and techniques through audio and clear text panels.\n\n**\ud83d\udcda Integrated Wikipedia**: Open related articles for artist biographies and deeper historical context.\n\n**\ud83d\udd0d Up-Close Viewing**: No crowds or velvet ropes. Take your time and view every painting from close range.\n\n**Please Note**\n\nThis is a test-stage release, not the final version. \ud83c\udfa8\u2728\n* Content and specifications may change.\n\n", "short_description": "Experience world-famous masterpieces in stunning high resolution from home! \ud83c\udfa8 Art Museum XR features works by 12 renowned painters in an immersive VR museum. Move closer to reveal brushstrokes, textures, and fine details, listen to audio commentary and read text guides, or explore each work further through seamless Wikipedia integration. Curate your own personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_F
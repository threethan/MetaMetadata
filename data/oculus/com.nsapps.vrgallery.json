content-sin11-1.oculuscdn.com/v/t64.5771-25/499620630_2127226978147621_2962501648663465178_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTk_MLTKe4sQ7kNvwFM8WXu&_nc_oc=Adq8IXbP4pYEAnsKlWovQptyRfCywqhdo-x6Gt0IW-0JOdjNqrlIbfMmu9Tq_HV4Juc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8l-Ghadap3ozzSQ3qfj89Q4VeF1WJTSTyMSJSNkZ76Q&oe=6AA4224B"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dQvHZDgewQQ7kNvwF3oh2U&_nc_oc=AdoEU4N-lytyQCtGIC3VnWQLtetRjaASuFUFEy9wHdiH9rwpzzWCm_toONaLmv49Dkk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdbWCP-3y44NiMKr8mnt0TxDnUD1y_ys4Qopw2eQSbtA&oe=6AA407D8"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdlbl1X-XawQ7kNvwHcw5hP&_nc_oc=AdqYgj5W4RHDFBE1p3UjbWkjY0F9w9jU0OM7AwN-qDIbsRYjhT9p0YxhZ4igpfwuxos&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJF8FhRElNybk0G1iWQEJlrO0Wpdm0wM9bIbpa0kYVw8g&oe=6AA422FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "johannes_vermeer.png", "id": "28534720242819616", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499620655_28534720262819614_6180938301831615639_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOS2qrct3g0Q7kNvwEL6Feu&_nc_oc=AdpmJEwE_9XjVVwX8vbss_kXb5LDGhZzEcretxvWPB8z791Mo_2qXV4-vAZCb3FFoO0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKybzZsVNXk0yCmTHfPuDwvNwBU3pqVYcsmWhl_J7YYTA&oe=6AA3FDCC"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# See What High Resolution Reveals.\n**Standard vs. High Resolution**\n\u3000\n\ud83d\udea8The artwork images are unchanged; the visible difference comes from the app's rendering and display method.\ud83d\udea8\n\n                                                                                                                                  \n{1625477678949865}{3106206799732231}{1114783257894164}{1437177358316906}{1410607057657333}{1050197987985057}{950065198123808}\n*All comparison images shown above were captured directly in the app.\n\n# \ud83d\udea8 TEST RELEASE / FREE\nThis test version is currently free while we improve the experience. Try it and share your feedback!\n\n# Experience World-Famous Art from Home! \ud83c\udfdb\ufe0f\u2728\n\nStep into elegant virtual galleries from home and enjoy works by 12 renowned painters. Move closer to appreciate brushstrokes, textures, and fine details, listen to audio commentary, and discover the history behind each work.\n\n# \ud83c\udfa8 Key Features\n\n**\ud83c\udfa7 Audio Commentary & Text Guides**: Learn about each work\u2019s context, history, and techniques through audio and clear text panels.\n\n**\ud83d\udcda Integrated Wikipedia**: Open related articles for artist biographies and deeper historical context.\n\n**\ud83d\udd0d Up-Close Viewing**: No crowds or velvet ropes. Take your time and view every painting from close range.\n\n**Please Note**\n\nThis is a test-stage release, not the final version. \ud83c\udfa8\u2728\n* Content and specifications may change.\n* The app may become paid in the future. Timing is yet to be determined.\n\n", "short_description": "Experience world-famous masterpieces in stunning high resolution from home! \ud83c\udfa8 Art Museum XR features works by 12 renowned painters in an immersive VR museum. Move closer to reveal brushstrokes, textures, and fine details, listen to audio commentary and read text guides, or explore each work further through seamless Wikipedia integration. Curate your own personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://ne
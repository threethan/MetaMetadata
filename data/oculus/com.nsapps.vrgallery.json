dn.com/v/t64.5771-25/499623384_1489189209920301_5048502910611199436_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKqsPbTl3soQ7kNvwF2zrMi&_nc_oc=AdoiMo6djl9vgWWUXgtRsotYKC0xu8yASub3wjNSbB3AoIsEw0-_PsfjCDLM5WwKfOw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9POTHO5urlDNWuG6PNIDD6cV7cs2rcZbEUasvTA-sfQ&oe=6AAD5272"}, {"file_name": "2.png", "id": "4400923196831860", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619680_4400923200165193_4844128138414980723_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JW8BjIU04m0Q7kNvwFrXuFu&_nc_oc=Adpi4kbJDFBfMGvtIkfLpNbQNDgg8JJnAh5PMCVj6ZHj7DXsn4u1Z0hOhDocoZdq1IY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQccilDUzM_43saglJqNQt_xQpActUXI6Oa_P1mQzXNQ&oe=6AAD31EA"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LURoaVdWcGAQ7kNvwFd0bgV&_nc_oc=Ado7JNm_KmS1UHtefYEd9rQ9KKB2Fr5AcbivLNcraZql07R8rzGawzZaQpLpDEKVZu0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwnHMGv_ngq4rr7xlaFG9ZLno1acVju6TubakhUVRHMw&oe=6AAD5D7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "27637231985928222", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619078_27637232005928220_7399641891484516281_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49Fhsu3KD4MQ7kNvwGa--5b&_nc_oc=AdrxhbwldrexBST9ZdpUzMG9TBrm6hhCr58XIwbmyVB7ZsWaTmbvTLQhdZuf-kCMzTI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoTulxX6bcKmSZe08krUr9vMU6YMAMg1taVqDa-bzvxQ&oe=6AAD3E15"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# \ud83d\udea8 TEST RELEASE / FREE\n\n**This test version is currently free while we improve the experience.**  \n**Please give it a try and share your feedback with us!**\n\n# Transform Your Living Room into a World-Class Art Museum! \ud83c\udfdb\ufe0f\u2728\n\nEver wanted to stroll through iconic art galleries at your own pace?  \n\nArt Museum XR offers an immersive, educational, and relaxing way to experience history\u2019s greatest masterworks. Get up close, listen to fascinating stories, and discover the secrets behind every masterpiece!\n\n# \ud83c\udfa8 Key Features\n\n- **\ud83d\uddbc\ufe0f Immersive Museum Exploration:** Walk freely through elegantly designed virtual exhibition halls. Admire renowned paintings, sculptures, and historical artifacts up close in stunning detail.\n\n- **\ud83c\udfa7 Automatic Audio & Text Guides:** Simply approach any artwork to trigger insightful audio commentary and easy-to-read text panels. Learn the context, history, and artistic techniques effortlessly as you browse.\n\n- **\ud83d\udcda Instant Wikipedia Integration:** Hungry for more knowledge? Seamlessly access integrated Wikipedia articles directly within the app to uncover in-depth biographies, historical era details, and expert analysis.\n\n- **\ud83d\udd0d Unmatched Up-Close Inspection:** No velvet ropes, no crowds! Get closer to the canvas than ever before to observe every brushstroke, texture, and intricate detail in total peace.\n\n# Please Note\n\n**This is a test-stage release, not the final version. \ud83c\udfa8\u2728**\n\n- Content and specifications may change.\n- The app may become paid in the future. The timing is yet to be determined.", "short_description": "Step inside a world-class museum without leaving your home! \ud83c\udfa8 Art Museum XR  brings masterworks of art directly before your eyes. Walk up to paintings and sculptures to trigger automated audio guides and readable descriptions, or dive deeper with seamless Wikipedia integration. Admire intricate details and curate your personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/priv
culuscdn.com&_nc_ss=7f20f&oh=00_AQF67-hd_nxTFGc9qIUzN8KuQMsjIh0tG2e-ct_5Y-RQQQ&oe=6A86CE98"}, {"file_name": "5.png", "id": "1489189206586968", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499623384_1489189209920301_5048502910611199436_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_APxFIlwkzsQ7kNvwEXuqck&_nc_oc=Adr4GYUlbvJ5OZTj4ZvGsb7_KpPIa_RuBZGZzwG20LDTQ6CEKmhLtKYa410wbysqqQk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZtjtfZIIXbbohw542wZ6QpGb8-LWh0fUOWKHxcxBvgA&oe=6A86DEB2"}, {"file_name": "2.png", "id": "4400923196831860", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619680_4400923200165193_4844128138414980723_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYUObjZZ_OIQ7kNvwE3W-LV&_nc_oc=Adr--K7VRcjc_HMBPL6lP_kIJEE85Ag7BS5BbsEaNf-2xIrqe2vSANdgo2jXLpzWn8U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_JalpdLZS0X2ioBr3HOk3tinGaiFLIh6xAV_y-Dw-Yw&oe=6A86F66A"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UG3BVPz0yAkQ7kNvwEyiIBO&_nc_oc=AdonFYV9oA2491HMWqQTbVzcvG9itduNAxIDyovwIaLtU54-BccbkjJ95-zDPXYnpkc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHePpyQiJbI41HeaMMev6WXtrxBkxot6rTFxjU_rXCqXA&oe=6A86E9BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "27637231985928222", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619078_27637232005928220_7399641891484516281_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYabc0NjAYYQ7kNvwEckz9W&_nc_oc=AdoW9zNFw_FxL63vJ26C9mDq3Ut62xKV0wEQEh4CZuDgwbsqQHu-Bw8NMi0i_NGj_LM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNqFqsksYmxZZI-JQOmJ1WWefLifqtU7OMORQ3z0I2Lg&oe=6A870295"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# \ud83d\udea8 TEST RELEASE / FREE\n\n**This test version is currently free while we improve the experience.**  \n**Please give it a try and share your feedback with us!**\n\n# Transform Your Living Room into a World-Class Art Museum! \ud83c\udfdb\ufe0f\u2728\n\nEver wanted to stroll through iconic art galleries at your own pace?  \n\nArt Museum XR offers an immersive, educational, and relaxing way to experience history\u2019s greatest masterworks. Get up close, listen to fascinating stories, and discover the secrets behind every masterpiece!\n\n# \ud83c\udfa8 Key Features\n\n- **\ud83d\uddbc\ufe0f Immersive Museum Exploration:** Walk freely through elegantly designed virtual exhibition halls. Admire renowned paintings, sculptures, and historical artifacts up close in stunning detail.\n\n- **\ud83c\udfa7 Automatic Audio & Text Guides:** Simply approach any artwork to trigger insightful audio commentary and easy-to-read text panels. Learn the context, history, and artistic techniques effortlessly as you browse.\n\n- **\ud83d\udcda Instant Wikipedia Integration:** Hungry for more knowledge? Seamlessly access integrated Wikipedia articles directly within the app to uncover in-depth biographies, historical era details, and expert analysis.\n\n- **\ud83d\udd0d Unmatched Up-Close Inspection:** No velvet ropes, no crowds! Get closer to the canvas than ever before to observe every brushstroke, texture, and intricate detail in total peace.\n\n# Please Note\n\n**This is a test-stage release, not the final version. \ud83c\udfa8\u2728**\n\n- Content and specifications may change.\n- The app may become paid in the future. The timing is yet to be determined.", "short_description": "Step inside a world-class museum without leaving your home! \ud83c\udfa8 Art Museum XR  brings masterworks of art directly before your eyes. Walk up to paintings and sculptures to trigger automated audio guides and readable descriptions, or dive deeper with seamless Wikipedia integration. Admire intricate details and curate your personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "de"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28220385030886783"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619450_2518579178576764_8850005458091828216_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFPZY1ldD8YQ7kNvwGiG-tK&_nc_oc=Ado8bPvd4AoVIZfaHEuSberP90m3v4rWES43AJORjy2lbc35CRWY24bLYsnoVm0GNsQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXJ6LIjc6CgaaShMfuhFZJ7ZGLOHQ92D_6yt7uRsq6qQ&oe=6A86D96A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Art Museum XR: Masterpiece Tour", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1786578300, "lastRevision": {"nodes": [{"id": "28220385054220114", "release_type": "
culuscdn.com/v/t64.5771-25/499620630_2127226978147621_2962501648663465178_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWxp7JAerVUQ7kNvwFpAPgx&_nc_oc=AdouNyFpRPko3JHbkT8Agf6jmT_AuSnofZGF7xsDfasB8S-k7wO6xsD8cOps2GhF2AE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM73IOwi96dl_loVB1t7KhREr8iRzSDG6LvNZTTHhBhAA&oe=6ADCD2CB"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-42x8bLG2LwQ7kNvwFOGuil&_nc_oc=AdrU9KwyFjFRwPzyW64-w1lTAh5Ai3fAIO6WV0f1juedTQ_YvFIqAXfho1xxjmLXp6Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUquwY7yXMi7WC6D4kyjBpE-91vdHlKElOUEMgXHWLZw&oe=6ADCB858"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLn4-ztwTS8Q7kNvwFjTYj-&_nc_oc=AdprbMR80sdFnTpsazEGYeqG5ET_DtCnqO_9cfrwFQ51sWaaUNwT2nvPCn0mrhJZi-g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMELHNNmaB63kwryEOVvkSDCIEGxW9AlheDxEpL9HUoXA&oe=6ADCD37B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "johannes_vermeer.png", "id": "28534720242819616", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620655_28534720262819614_6180938301831615639_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-m-bZ5lG9v4Q7kNvwE5Jq1x&_nc_oc=Adpv-TsfrHUGP6STn2m5_vmCbcIlSch-cC5IiDpdyZJ0ie3WzYahYbjnti602fWesyw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqAqXqxAF8g9QaBTytu_WyQ5kgTM2uh0R3DCPkrQ3-Wg&oe=6ADCAE4C"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# See What High Resolution Reveals.\u3000\n**Standard vs. High Resolution**\n\n\ud83d\udea8The artwork images are unchanged; the visible difference comes from the app's rendering and display method.\ud83d\udea8\n\n                                                                                                                                 \n{1625477678949865}{3106206799732231}{1114783257894164}{1437177358316906}{1410607057657333}{1050197987985057}{950065198123808}\n*All comparison images shown above were captured directly in the app.\n\n\n# Experience World-Famous Art from Home! \ud83c\udfdb\ufe0f\u2728\n\nStep into elegant virtual galleries from home and enjoy works by 12 renowned painters. Move closer to appreciate brushstrokes, textures, and fine details, listen to audio commentary, and discover the history behind each work.\n\n# \ud83c\udfa8 Key Features\n\n**\ud83c\udfa7 Audio Commentary & Text Guides**: Learn about each work\u2019s context, history, and techniques through audio and clear text panels.\n\n**\ud83d\udcda Integrated Wikipedia**: Open related articles for artist biographies and deeper historical context.\n\n**\ud83d\udd0d Up-Close Viewing**: No crowds or velvet ropes. Take your time and view every painting from close range.\n\n**Please Note**\n\nThis is a test-stage release, not the final version. \ud83c\udfa8\u2728\n* Content and specifications may change.\n\n", "short_description": "Experience world-famous masterpieces in stunning high resolution from home! \ud83c\udfa8 Art Museum XR features works by 12 renowned painters in an immersive VR museum. Move closer to reveal brushstrokes, textures, and fine details, listen to audio commentary and read text guides, or explore each work further through seamless Wikipedia integration. Curate your own personal art journey in VR! \ud83c\udfdb\ufe0f  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFOR
23314_1677880923319814_876687770245928609_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWx7gwMt4dIQ7kNvwEpeu67&_nc_oc=Adp-U5c2wpI-T7uyXNBnsgwcU6qhQ1oRhSeU_bJfaiH_-yspuu76jHVJb_o6IfNQNWc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwdZ7F1vfxUDK6yfBn5G1yR0UkrNUK3_9o1MvlQnj8gQ&oe=6ACE402D"}, {"file_name": "ArtMuseumXR_Logo_White.png", "id": "1364528062455564", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619680_1364528069122230_5169608074860417394_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXEUGNMfgAAQ7kNvwENgmyb&_nc_oc=AdqAI5uLUOX0uFbqyalCOQaLjSJMUmOPD34k7FHW9SUGgq7_gQS8MxDUdirIhqdp98c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNm2Dzqsy4M_h3WmVlDMLQzxx3Ibt9Cq3kGzcobA6rKA&oe=6ACE53D7"}]}, "id": "1331787472500335", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1359131132413955", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619681_1359131139080621_1596761651909387728_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkVbkYh7BAcQ7kNvwF7wYPx&_nc_oc=AdpwKL8WLS4QFh9UI47LQX8uFgsLxHIt9qx47dl9GZHbwBKGli50kebNsuSVoc5-zII&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgD0dBnHMOiqJEG7Z0P8HRGBehN858sR_2y26tgXpXEw&oe=6ACE4C54"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s80V4R5XWHYQ7kNvwGOunoQ&_nc_oc=AdpFcPWBjlPPnqPUKNjUoEBtuRhD4rxKWD6z53qBJC9QKHXDMK2f5W7JU0Y23AWkh3k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuNWBMiO6UMFyJuwkmUng1Q3abX4DveF_yBMkN2Jl7Ww&oe=6ACE37D8"}, {"file_name": "5.png", "id": "1489189206586968", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623384_1489189209920301_5048502910611199436_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xd1WHmQWkjwQ7kNvwHKARYr&_nc_oc=Adp54n_A4Av4XsVFKwh5JNChPQSEyZCobsN6rsvfcyzo_yGB_2Y41vvBirihg8viSdg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrV8VswwY4nO9wYuLmnx6fm63IbuLcPD2w9nybcHLMdQ&oe=6ACE47F2"}, {"file_name": "2.png", "id": "4400923196831860", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619680_4400923200165193_4844128138414980723_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ymMxNuS5RcQ7kNvwEvTk5X&_nc_oc=AdpvyyewwCgtrkKadat7QORjqg6Hhb2NIHmLr9NxhBa-INAljtpTyFAsmffNpXD6oWc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvglTLZSnCfACU_DOgFmXKtnRd9llA5BLs9gBume9tMg&oe=6ACE5FAA"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SI_ZfHCnN1cQ7kNvwFb0WzX&_nc_oc=AdoVLf6YV01O197bE4N9IjU6FUiVrSM5l4Ejz39ofUHfOTSUaxdMdSBoRKwqcEbT6n0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgsv5y637_JZ6agxRX8m00xDNRjzt_8-pSZX0GQQt7Tw&oe=6ACE52FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "27637231985928222", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619078_27637232005928220_7399641891484516281_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIaq_YTm9ckQ7kNvwHM0S4j&_nc_oc=Adp9CCNauHOJptboUaTCO_HFD_BGsxtAbbIWiJi_72qL_34IFFxQCQhceoAdjvOrHf4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxlNw77TNdtwue-jhP2N4jNd_UjOwrO-qQOIgjb7gCuw&oe=6ACE6BD5"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# \ud83d\udea8 TEST RELEASE / FREE\n\n**This test version is currently free while we improve the experience.**  \n**Please give it a try and share your feedback with us!**\n\n# Transform Your Living Room into a World-Class Art Museum! \ud83c\udfdb\ufe0f\u2728\n\nEver wanted to stroll through iconic art galleries at your own pace?  \n\nArt Museum XR offers an immersive, educational, and relaxing way to experience history\u2019s greatest masterworks. Get up close, listen to fascinating stories, and discover the secrets behind every masterpiece!\n\n# \ud83c\udfa8 Key Features\n\n- **\ud83d\uddbc\ufe0f Immersive Museum Exploration:** Walk freely through elegantly designed virtual exhibition halls. Admire renowned paintings, sculptures, and historical artifacts up close in stunning detail.\n\n- **\ud83c\udfa7 Automatic Audio & Text Guides:** Simply approach any artwork to trigger insightful audio commentary and easy-to-read text panels. Learn the context, history, and artistic techniques effortlessly as you browse.\n\n- **\ud83d\udcda Instant Wikipedia Integration:** Hungry for more knowledge? Seamlessly access integrated Wikipedia articles directly within the app to uncover in-depth biographies, historical era details, and expert analysis.\n\n- **\ud83d\udd0d Unmatched Up-Close Inspection:** No velvet ropes, no crowds! Get closer to the canvas than ever before to observe every brushstroke, texture, and intricate detail in total peace.\n\n# Please Note\n\n**This is a test-stage release, not the final version. \ud83c\udfa8\u2728**\n\n- Content and specifications may change.\n- The app may become paid in the future. The timing is yet to be determined.", "short_description": "Step inside a world-class museum without leaving your home! \ud83c\udfa8 Art Museum XR  brings masterworks of art directly before your eyes. Walk up to paintings and sculptures to trigger automated audio guides and readable descriptions, or dive deeper with seamless Wikipedia integration. Admire intricate details and curate your personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "categor
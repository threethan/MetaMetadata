culuscdn.com/v/t64.5771-25/499620630_2127226978147621_2962501648663465178_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99MX5N62Y2wQ7kNvwGg-I7D&_nc_oc=Adqn22GnmB-9oMI3n7pB12DKI0C-oepSKC-PypN8BagdVDZ5Xb6T_1lsVj7AkRNh79U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRak5HiMyhY3IVjccRxlc0_PRj2-rWhTbTSz1W62RuEQ&oe=6AB7E8CB"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ycp6xIcwDOUQ7kNvwFI4_bI&_nc_oc=AdrQ3T7VgfU8JQ_u7Zz6X5RgmmBh80O3dFnjGjuwt42exhS7USnxaxKYRrZ4nevwCAQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvE1MZ67PI0Hs_06A-JBmsSC3fhJFVQ3K0cFITvHnGmg&oe=6AB7CE58"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5lJunmNuTQQ7kNvwEDSRIX&_nc_oc=AdrVNh6pwkCNSRkk6lOseJQS0fBAg0PxHAa_eb2HebpnXJnh0aTLs2Xj68Y-6bLAJMk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXYFx0rocDTfUoocpS-xjkF6_ZQjI4uCeS4adA7lCshQ&oe=6AB7E97B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "johannes_vermeer.png", "id": "28534720242819616", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620655_28534720262819614_6180938301831615639_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USNUdVq3DmMQ7kNvwFDvYAy&_nc_oc=AdoOezRdyQu-YG9hI60fHSOgIqBixtGoH6vWotL5tW7YI6Md7TCkSh7QtEK0hVkUCUE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoxqmTvG9Xk5ndfX8PgY_SCcAn130ve9sjmqXbtkxZbA&oe=6AB7C44C"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# See What High Resolution Reveals.\n**Standard vs. High Resolution**\n\n\ud83d\udea8The artwork images are unchanged; the visible difference comes from the app's rendering and display method.\ud83d\udea8\n\n                                                                                                                                  \n{1625477678949865}{3106206799732231}{1114783257894164}{1437177358316906}{1410607057657333}{1050197987985057}{950065198123808}\n*All comparison images shown above were captured directly in the app.\n\n\n# Experience World-Famous Art from Home! \ud83c\udfdb\ufe0f\u2728\n\nStep into elegant virtual galleries from home and enjoy works by 12 renowned painters. Move closer to appreciate brushstrokes, textures, and fine details, listen to audio commentary, and discover the history behind each work.\n\n# \ud83c\udfa8 Key Features\n\n**\ud83c\udfa7 Audio Commentary & Text Guides**: Learn about each work\u2019s context, history, and techniques through audio and clear text panels.\n\n**\ud83d\udcda Integrated Wikipedia**: Open related articles for artist biographies and deeper historical context.\n\n**\ud83d\udd0d Up-Close Viewing**: No crowds or velvet ropes. Take your time and view every painting from close range.\n\n**Please Note**\n\nThis is a test-stage release, not the final version. \ud83c\udfa8\u2728\n* Content and specifications may change.\n\n", "short_description": "Experience world-famous masterpieces in stunning high resolution from home! \ud83c\udfa8 Art Museum XR features works by 12 renowned painters in an immersive VR museum. Move closer to reveal brushstrokes, textures, and fine details, listen to audio commentary and read text guides, or explore each work further through seamless Wikipedia integration. Curate your own personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_
3314_1677880923319814_876687770245928609_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGqQmzJPlPUQ7kNvwHB4B7Y&_nc_oc=Adrz2jr15sSKG_J1aAbK_QDX4uELKh9MXD0Df0tQOZFApep04w5hQ7LigJWQo46AEk8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUd7rQ_Om2mmUKLrJp-V5-7ihYuMkG3azPQQhAKPkLqg&oe=6A986AED"}, {"file_name": "ArtMuseumXR_Logo_White.png", "id": "1364528062455564", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619680_1364528069122230_5169608074860417394_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wC8appbw0jwQ7kNvwFqf4vd&_nc_oc=Adqw_hcBKL1jEu_2akit5Pfyx0w8DfbWYW3unX4ts4Nv4A6CodX1iU5xzqH5swRmDmk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIii9SApoAXS-xQExyDazjTBu-UcF42w54J9GJTO-kovw&oe=6A984657"}]}, "id": "1331787472500335", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1359131132413955", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619681_1359131139080621_1596761651909387728_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P90XVfOIetMQ7kNvwEtGYVy&_nc_oc=Adrzb9fTrQdC2D1Bgnv3M_dAMtpfKuJLUJ88tl-WfRLFvJ-hDZJTEAISwlQnskOxiCk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIh_CPZ5LoW1Q3XZ_1m6dVNilhdrqo2XuNRPVwfy4gNzg&oe=6A983ED4"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPLlv8cxtJ4Q7kNvwH2jhtr&_nc_oc=Adqz0_tO9ZW-MqaPCVgtMOIGsM6jiZW8oYCwddYTTNhG2vHaHJqGbQvu6bJ2mpNPIxc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHOA9oNwtutuTOJblDLQY4LtMPyszDNggO_kIpNtHHzw&oe=6A986298"}, {"file_name": "5.png", "id": "1489189206586968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623384_1489189209920301_5048502910611199436_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eY-GNeRES9YQ7kNvwExLV_R&_nc_oc=AdqTag7bR6eHp7fCngFNhGPIGGPu9xEHI1IWkIy-sbwoy0quSVGEs_TJFWs4y2MDXnU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0Yzd2LhgMJ-_PTdV5Erh9oKRL46G24fqh-oEO78XdJA&oe=6A983A72"}, {"file_name": "2.png", "id": "4400923196831860", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_4400923200165193_4844128138414980723_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnXbjutWEsQQ7kNvwEO0yhz&_nc_oc=AdrRKcZAv4BQRYfoR0gFKiuWHuzPfycdceZ0235tzOHh3H-AGhWDtyOPgODaWunHQdo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKp0n4A_N2J085gL5QnkzMyL0msxaNlFo_v1OxWzu0ggg&oe=6A98522A"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiqcKZzKLoAQ7kNvwFrbC6R&_nc_oc=AdqYb5BpFBGHrah5vTQq7lJ6oZpF7M2Kfc9yXzxXSPr_FStdaNZeBpHIKB9wwuXhkcg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYNMrakahVuJ7MEfMYygLA9uI_cJG7hEwiI5pggqf8qw&oe=6A98457B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "27637231985928222", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619078_27637232005928220_7399641891484516281_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dh1DYXnoTvkQ7kNvwHuejfn&_nc_oc=AdpzgVgoHMEKCW9yxUm4g78rvkVMM5TVR2r90FyUao_AXwAro_BhJ-AerHu_F5B1VzM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEGNhAYMiiCByUP2PuBinTiEG8GTnsRc9i3imsKDNL2A&oe=6A985E55"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# \ud83d\udea8 TEST RELEASE / FREE\n\n**This test version is currently free while we improve the experience.**  \n**Please give it a try and share your feedback with us!**\n\n# Transform Your Living Room into a World-Class Art Museum! \ud83c\udfdb\ufe0f\u2728\n\nEver wanted to stroll through iconic art galleries at your own pace?  \n\nArt Museum XR offers an immersive, educational, and relaxing way to experience history\u2019s greatest masterworks. Get up close, listen to fascinating stories, and discover the secrets behind every masterpiece!\n\n# \ud83c\udfa8 Key Features\n\n- **\ud83d\uddbc\ufe0f Immersive Museum Exploration:** Walk freely through elegantly designed virtual exhibition halls. Admire renowned paintings, sculptures, and historical artifacts up close in stunning detail.\n\n- **\ud83c\udfa7 Automatic Audio & Text Guides:** Simply approach any artwork to trigger insightful audio commentary and easy-to-read text panels. Learn the context, history, and artistic techniques effortlessly as you browse.\n\n- **\ud83d\udcda Instant Wikipedia Integration:** Hungry for more knowledge? Seamlessly access integrated Wikipedia articles directly within the app to uncover in-depth biographies, historical era details, and expert analysis.\n\n- **\ud83d\udd0d Unmatched Up-Close Inspection:** No velvet ropes, no crowds! Get closer to the canvas than ever before to observe every brushstroke, texture, and intricate detail in total peace.\n\n# Please Note\n\n**This is a test-stage release, not the final version. \ud83c\udfa8\u2728**\n\n- Content and specifications may change.\n- The app may become paid in the future. The timing is yet to be determined.", "short_description": "Step inside a world-class museum without leaving your home! \ud83c\udfa8 Art Museum XR  brings masterworks of art directly before your eyes. Walk up to paintings and sculptures to trigger automated audio guides and readable descriptions, or dive deeper with seamless Wikipedia integration. Admire intricate details and curate your personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category
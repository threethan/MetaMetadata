uluscdn.com/v/t64.5771-25/499620630_2127226978147621_2962501648663465178_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XPAwE0GPzkQ7kNvwFSF6oq&_nc_oc=Adp6xg3C3fcxYUrfkJ-fZeoDPxqFsutD7_6_gJn8JgJTYIAory5QC0El61qsj7SHZmw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWagv87vRKCb3ZMrajeY9S6m_e4mCRhKHntQZD2OD7AQ&oe=6AAFFFCB"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YblIAxbekB8Q7kNvwGAWE3M&_nc_oc=AdrkiHiCXLQOUlp9lb2jBrL5jVWg68qYLcs7QHLaqbXDuT3UhqUYngv--6BumWtRJgw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVLMVVAHjyShpX0coMc1xpRHrpEaCyG_ZMYZqac9wNNw&oe=6AAFE558"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3eH1_SD7YTQQ7kNvwFFdfhT&_nc_oc=Adq4kwDabBJC5VGqIUUlzCYMNZ1zpBqP9OkiplR7EIYETpZhvDUOGpz3WAq3LjfdRnU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI97L8NTBBBArVtW1-cXw6LuHSaNoHj5FvUelP8kEL5kg&oe=6AB0007B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "johannes_vermeer.png", "id": "28534720242819616", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620655_28534720262819614_6180938301831615639_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Agg2Jce96u0Q7kNvwEOXlkr&_nc_oc=AdpGglIOEuRBMZo2btEQlAxVSPK9F358LrGXepOKPri8gQzPTo480NP2ijuObDuO060&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkG4I4NJROPOa4Hwg0Uo4a3babYLqtNGasZkfardHPvw&oe=6AAFDB4C"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# See What High Resolution Reveals.\n**Standard vs. High Resolution**\n\n\ud83d\udea8The artwork images are unchanged; the visible difference comes from the app's rendering and display method.\ud83d\udea8\n\n                                                                                                                                  \n{1625477678949865}{3106206799732231}{1114783257894164}{1437177358316906}{1410607057657333}{1050197987985057}{950065198123808}\n*All comparison images shown above were captured directly in the app.\n\n# \ud83d\udea8 TEST RELEASE / FREE\nThis test version is currently free while we improve the experience. Try it and share your feedback!\n\n# Experience World-Famous Art from Home! \ud83c\udfdb\ufe0f\u2728\n\nStep into elegant virtual galleries from home and enjoy works by 12 renowned painters. Move closer to appreciate brushstrokes, textures, and fine details, listen to audio commentary, and discover the history behind each work.\n\n# \ud83c\udfa8 Key Features\n\n**\ud83c\udfa7 Audio Commentary & Text Guides**: Learn about each work\u2019s context, history, and techniques through audio and clear text panels.\n\n**\ud83d\udcda Integrated Wikipedia**: Open related articles for artist biographies and deeper historical context.\n\n**\ud83d\udd0d Up-Close Viewing**: No crowds or velvet ropes. Take your time and view every painting from close range.\n\n**Please Note**\n\nThis is a test-stage release, not the final version. \ud83c\udfa8\u2728\n* Content and specifications may change.\n* The app may become paid in the future. Timing is yet to be determined.\n\n", "short_description": "Experience world-famous masterpieces in stunning high resolution from home! \ud83c\udfa8 Art Museum XR features works by 12 renowned painters in an immersive VR museum. Move closer to reveal brushstrokes, textures, and fine details, listen to audio commentary and read text guides, or explore each work further through seamless Wikipedia integration. Curate your own personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28879590281632918"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623185_1868617114128938_2808321356766073604_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QMyJD5cjYMQ7kNvwFpcr3I&_nc_oc=AdoWTlKYyrK-6OvbTnLakP03RHOQYoCLtR87jHPieRa2HkXjAzExXixZ_IBFaL5XKFw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTV809MosGp1ygYyfwCHqhTAzYlFSm-LaPfBRNSwNBYg&oe=6AAFF1A3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Art Museum XR: Masterpiece Tour", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1786578300, "lastRevision": {"nodes": [{"id": "28220385054220114", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "28220384957553457", "is_first_party": false, "enables_in_app_ads": false, "is_concept": f
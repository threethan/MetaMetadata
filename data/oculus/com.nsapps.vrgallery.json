=6AE36BD7"}]}, "id": "1331787472500335", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1359131132413955", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619681_1359131139080621_1596761651909387728_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2Ri3VpzXLYQ7kNvwFdeo1v&_nc_oc=AdpfXH5lsBnHS2b8qtpuTeiKoZP-AnsDVJafyP9dymQLKnmFj0Vx3WiWiTLTKG08vRg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQ6PGFG7BN2ZrjUdrH7LW9GH2H5Vhz570QxWZi3I7vlw&oe=6AE36454"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7ni02O9bPkQ7kNvwGeajjR&_nc_oc=AdqNDFCCpeWtsJ4Qd89-TiUAJ9q-y1NAm2safmEVO6FWb7FpkWfwJRZwz2PbUhF6NY4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuuqcWyha2ckTQnTrRZbJtggORoWau3ozOzuyIn34uYw&oe=6AE34FD8"}, {"file_name": "5.png", "id": "1489189206586968", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623384_1489189209920301_5048502910611199436_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cB0I5_Y5pBgQ7kNvwEHyAGg&_nc_oc=Adob-Dlhl6xd8CyezWDNhzD7CNwPnLbiGwg-kUYScrbIPzfzxRt6DRKLmoykcLZ6niQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPG9-FAP1pjeBUJC00OzL9rEfQ3oNC9hxd2X9xlsYH9hw&oe=6AE35FF2"}, {"file_name": "2.png", "id": "4400923196831860", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619680_4400923200165193_4844128138414980723_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1vNRpht-LwQ7kNvwFvuuQw&_nc_oc=AdoKuAYYYp88rTzqfSvZy_IH3U6tn1V3yAWRMdOPltBTUu0eDEvFRPKyDGHuVJN8XEA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLjdOhQtWOyez59vjNBfYDK1X0LmCZ6JkrWjBO6CPZag&oe=6AE33F6A"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o68z-t0e_rAQ7kNvwEAcGaX&_nc_oc=AdpVOJ3-BHnD2czaf1lVKl3Fn_-U3awFyOu2-7nmUAtkPPWX9IhePSUTiCk4BmkYpuU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrqmfKefQDj_G2Nq_0b1g9BJZfO8q11yJYuEDgCneg7w&oe=6AE36AFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "27637231985928222", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619078_27637232005928220_7399641891484516281_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbjJXvbQtYQQ7kNvwGs3hJ2&_nc_oc=AdpcZJeK07dKq8JAyxB62Q_CjZq6hOsBSi3Ph8G7voPSRZUNHASsQCMmk9UUqIGino4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkNIivmVz9NxX-bTmz9I908BsaCYy5Om7cVVYnPBXClg&oe=6AE34B95"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# \ud83d\udea8 TEST RELEASE / FREE\n\n**This test version is currently free while we improve the experience.**  \n**Please give it a try and share your feedback with us!**\n\n# Transform Your Living Room into a World-Class Art Museum! \ud83c\udfdb\ufe0f\u2728\n\nEver wanted to stroll through iconic art galleries at your own pace?  \n\nArt Museum XR offers an immersive, educational, and relaxing way to experience history\u2019s greatest masterworks. Get up close, listen to fascinating stories, and discover the secrets behind every masterpiece!\n\n# \ud83c\udfa8 Key Features\n\n- **\ud83d\uddbc\ufe0f Immersive Museum Exploration:** Walk freely through elegantly designed virtual exhibition halls. Admire renowned paintings, sculptures, and historical artifacts up close in stunning detail.\n\n- **\ud83c\udfa7 Automatic Audio & Text Guides:** Simply approach any artwork to trigger insightful audio commentary and easy-to-read text panels. Learn the context, history, and artistic techniques effortlessly as you browse.\n\n- **\ud83d\udcda Instant Wikipedia Integration:** Hungry for more knowledge? Seamlessly access integrated Wikipedia articles directly within the app to uncover in-depth biographies, historical era details, and expert analysis.\n\n- **\ud83d\udd0d Unmatched Up-Close Inspection:** No velvet ropes, no crowds! Get closer to the canvas than ever before to observe every brushstroke, texture, and intricate detail in total peace.\n\n# Please Note\n\n**This is a test-stage release, not the final version. \ud83c\udfa8\u2728**\n\n- Content and specifications may change.\n- The app may become paid in the future. The timing is yet to be determined.", "short_description": "Step inside a world-class museum without leaving your home! \ud83c\udfa8 Art Museum XR  brings masterworks of art directly before your eyes. Walk up to paintings and sculptures to trigger automated audio guides and readable descriptions, or dive deeper with seamless Wikipedia integration. Admire intricate details and curate your personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "de"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28220385030886783"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "
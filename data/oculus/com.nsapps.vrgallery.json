_1677880923319814_876687770245928609_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guOvi_f0ZzQQ7kNvwHzaJMI&_nc_oc=AdqsQQ-5T1e83Zc_6FamSpOhSi7ZuUWo_yN0ia9So6SwCxWvqGGhajK3eKmPEUtkxOg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2ebpyngSEMIOQ4E8nlZ1w_sdM8wVZkYvWjtYqE3FTow&oe=6AB7D6AD"}, {"file_name": "ArtMuseumXR_Logo_White.png", "id": "1364528062455564", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619680_1364528069122230_5169608074860417394_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dF4hXpl82I8Q7kNvwHdoXZJ&_nc_oc=AdqyYFNUH86IuWoaFHybmV6DID8Wh4p2D0c91dZ5RO8wrdyGgxMOYLuw21cIijO5O14&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbktcqzdET71O6E8VSvgfMpuNMVwIxbe5erEcOOH7_QQ&oe=6AB7EA57"}]}, "id": "1331787472500335", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1359131132413955", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619681_1359131139080621_1596761651909387728_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxobVanzQx0Q7kNvwEIMUVj&_nc_oc=AdoNBF1QiCS8LZhJ1oZoM80PXDcXUVXzjvBs4bl8H5a-3CBBUAl6zNa3u7g0uztkNh8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkKGAD-aQGP3GLcUYz_jyd2Oa9bvrGoODcwGPC7m7atw&oe=6AB7E2D4"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ycp6xIcwDOUQ7kNvwFI4_bI&_nc_oc=AdrQ3T7VgfU8JQ_u7Zz6X5RgmmBh80O3dFnjGjuwt42exhS7USnxaxKYRrZ4nevwCAQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvE1MZ67PI0Hs_06A-JBmsSC3fhJFVQ3K0cFITvHnGmg&oe=6AB7CE58"}, {"file_name": "5.png", "id": "1489189206586968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623384_1489189209920301_5048502910611199436_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFpg7PAbwb4Q7kNvwEqhQbO&_nc_oc=AdqhB_RLtsFmmPEWQRgGQczBREn4y47TYAbIJ5rGGLI6Ya8iw_GJf7of28MqI4jmY2U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSLb8Z5-sa8AozA5-i9Lnl_sDrS0-RT02RrSQyaqUJvw&oe=6AB7DE72"}, {"file_name": "2.png", "id": "4400923196831860", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_4400923200165193_4844128138414980723_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4ODsT3u4o8Q7kNvwEVv5o8&_nc_oc=AdqnkuyWN4yL02gwQfpCVEgBti8QDCyMyzjXL4f1Ss7HbRCMam9d2KwxhMxAAMnHl5w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0KoltyGjngeF0uG2buaObvU2cp3en0kWSJ6SaiYpnMQ&oe=6AB7BDEA"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5lJunmNuTQQ7kNvwEDSRIX&_nc_oc=AdrVNh6pwkCNSRkk6lOseJQS0fBAg0PxHAa_eb2HebpnXJnh0aTLs2Xj68Y-6bLAJMk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXYFx0rocDTfUoocpS-xjkF6_ZQjI4uCeS4adA7lCshQ&oe=6AB7E97B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "27637231985928222", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619078_27637232005928220_7399641891484516281_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mokb2DLmq74Q7kNvwF0Si_D&_nc_oc=AdqdUd4QBP-zZ0iC2X0FM6VkVrRFdDjnn3FDyB-1P_HzkYtYbdRKfDv94_0EalR8j_o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR0HAyrmXWn4Gh5U1GbgpXXh4hZXhLPCg6GQDyDKEthg&oe=6AB7CA15"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# \ud83d\udea8 TEST RELEASE / FREE\n\n**This test version is currently free while we improve the experience.**  \n**Please give it a try and share your feedback with us!**\n\n# Transform Your Living Room into a World-Class Art Museum! \ud83c\udfdb\ufe0f\u2728\n\nEver wanted to stroll through iconic art galleries at your own pace?  \n\nArt Museum XR offers an immersive, educational, and relaxing way to experience history\u2019s greatest masterworks. Get up close, listen to fascinating stories, and discover the secrets behind every masterpiece!\n\n# \ud83c\udfa8 Key Features\n\n- **\ud83d\uddbc\ufe0f Immersive Museum Exploration:** Walk freely through elegantly designed virtual exhibition halls. Admire renowned paintings, sculptures, and historical artifacts up close in stunning detail.\n\n- **\ud83c\udfa7 Automatic Audio & Text Guides:** Simply approach any artwork to trigger insightful audio commentary and easy-to-read text panels. Learn the context, history, and artistic techniques effortlessly as you browse.\n\n- **\ud83d\udcda Instant Wikipedia Integration:** Hungry for more knowledge? Seamlessly access integrated Wikipedia articles directly within the app to uncover in-depth biographies, historical era details, and expert analysis.\n\n- **\ud83d\udd0d Unmatched Up-Close Inspection:** No velvet ropes, no crowds! Get closer to the canvas than ever before to observe every brushstroke, texture, and intricate detail in total peace.\n\n# Please Note\n\n**This is a test-stage release, not the final version. \ud83c\udfa8\u2728**\n\n- Content and specifications may change.\n- The app may become paid in the future. The timing is yet to be determined.", "short_description": "Step inside a world-class museum without leaving your home! \ud83c\udfa8 Art Museum XR  brings masterworks of art directly before your eyes. Walk up to paintings and sculptures to trigger automated audio guides and readable descriptions, or dive deeper with seamless Wikipedia integration. Admire intricate details and curate your personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": n
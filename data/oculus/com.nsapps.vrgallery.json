_1677880923319814_876687770245928609_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guOvi_f0ZzQQ7kNvwF3sRaZ&_nc_oc=Adq0c4evOq4uieRT1jCPonD6UpXzW_9GEWhzq8UYzj-opCR3SnZhJOI57V4LGv8cVL8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6vuMhuCT4QUXCkZ0P0TV8WiG1Odgd4HWdcpbij4ACww&oe=6AB6852D"}, {"file_name": "ArtMuseumXR_Logo_White.png", "id": "1364528062455564", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619680_1364528069122230_5169608074860417394_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwardkpZE8gQ7kNvwE6Qsny&_nc_oc=AdouWYeb5p-hQY8PvuMGmX0Sp2aX-L_DtjcB-WQg0REYLJtVzJmL47Mu7nnSgzzSAAg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOC0PIUu6I3w3ymMIeP-Yy7hIvlPFfw1in154HPNOHKw&oe=6AB698D7"}]}, "id": "1331787472500335", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1359131132413955", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619681_1359131139080621_1596761651909387728_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39CUxv55uFEQ7kNvwFwiJNV&_nc_oc=AdoNZljHjc3ED34w8GXPzmix0QZ4Akvj3BtUVoblrq31Qqf5ZH2ZP45qytWfKKN8DW0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYgROR6RN9UvUCNBqCrAAlo8fggnJ5zeGjwe5qduSW1Q&oe=6AB69154"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ycp6xIcwDOUQ7kNvwEHMs3I&_nc_oc=AdoPlFiV4EGUN3oXTxJgUi4weqQo40_GU6sAiS4Cqhhg3TrzJ7fNwQn-iUh7wSBe88w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcJx6qu0WiO44_cJh3cgojVD8WY4LGDU5bpfQkptNzlA&oe=6AB67CD8"}, {"file_name": "5.png", "id": "1489189206586968", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623384_1489189209920301_5048502910611199436_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFpg7PAbwb4Q7kNvwGp7Edx&_nc_oc=Adrz9Zm-IpQXJvFQA4Fo8tfwrefHfPI-Z74H6Jl5ELNQJ87Bu1s5_IFrQyIDY11dF1c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEeQzm_g3FOm84BlILy_IG40KkTW0L9J-sn8nA4FcSGg&oe=6AB68CF2"}, {"file_name": "2.png", "id": "4400923196831860", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619680_4400923200165193_4844128138414980723_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93MHfjfxNygQ7kNvwF_VZq4&_nc_oc=AdrrgDlWa6orbYDOfR6yoqjSsnZwGiGDhGAFHv4YbUxZlTITjVgUgN_pDHC_onko1mc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg3MapTyBZrkAdtKbHn9AUQVeUg0h32cRZ9y96EO_6OA&oe=6AB66C6A"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5lJunmNuTQQ7kNvwFYuRlR&_nc_oc=AdoWvKfDI62tprVURerqXAWs_7JDALWTMAH-UHRMM1JeEGI4eyFLk6ve2PG1TbvrvY0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLP9daY0uvQ4a0nRbtQ6NjJqSBRUeAS497okjSJlQLiHA&oe=6AB697FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "27637231985928222", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619078_27637232005928220_7399641891484516281_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5puxkraQpeoQ7kNvwGDXvx8&_nc_oc=Adrzx98TzKk18D3qoROedCJuht8ZCCUCmTNetkqUY9gn2N88uFTHiZxt5ROGDfcm910&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKI9T0bducKCHHaMT19he1Wvk_9HK6dVqvQjgqN0tnVIg&oe=6AB67895"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# \ud83d\udea8 TEST RELEASE / FREE\n\n**This test version is currently free while we improve the experience.**  \n**Please give it a try and share your feedback with us!**\n\n# Transform Your Living Room into a World-Class Art Museum! \ud83c\udfdb\ufe0f\u2728\n\nEver wanted to stroll through iconic art galleries at your own pace?  \n\nArt Museum XR offers an immersive, educational, and relaxing way to experience history\u2019s greatest masterworks. Get up close, listen to fascinating stories, and discover the secrets behind every masterpiece!\n\n# \ud83c\udfa8 Key Features\n\n- **\ud83d\uddbc\ufe0f Immersive Museum Exploration:** Walk freely through elegantly designed virtual exhibition halls. Admire renowned paintings, sculptures, and historical artifacts up close in stunning detail.\n\n- **\ud83c\udfa7 Automatic Audio & Text Guides:** Simply approach any artwork to trigger insightful audio commentary and easy-to-read text panels. Learn the context, history, and artistic techniques effortlessly as you browse.\n\n- **\ud83d\udcda Instant Wikipedia Integration:** Hungry for more knowledge? Seamlessly access integrated Wikipedia articles directly within the app to uncover in-depth biographies, historical era details, and expert analysis.\n\n- **\ud83d\udd0d Unmatched Up-Close Inspection:** No velvet ropes, no crowds! Get closer to the canvas than ever before to observe every brushstroke, texture, and intricate detail in total peace.\n\n# Please Note\n\n**This is a test-stage release, not the final version. \ud83c\udfa8\u2728**\n\n- Content and specifications may change.\n- The app may become paid in the future. The timing is yet to be determined.", "short_description": "Step inside a world-class museum without leaving your home! \ud83c\udfa8 Art Museum XR  brings masterworks of art directly before your eyes. Walk up to paintings and sculptures to trigger automated audio guides and readable descriptions, or dive deeper with seamless Wikipedia integration. Admire intricate details and curate your personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": n
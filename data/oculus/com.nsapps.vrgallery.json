iYMbxoQ7kNvwF9pbw5&_nc_oc=AdopBZp3mxhXuhCMQy-SFlXwOtviiQRxASXUNlWb2P492KQyp0Y8ajsl8KYub7ZD2Y4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOxeThJ68WNfGwl_yLDRvUg89axAYpb0PsIQoEU4ewug&oe=6A9EDC4B"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=214Y8X4oWJ4Q7kNvwEqditI&_nc_oc=AdpvbO0K2q6RgCspdkTRs640Aiv1Zg9ykkgleKXrKQGrx1pAknPjLUyy5fqPqZHG1uY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtCwHwZ90_3EfabkUA-Y3IiLnuYZ07xvtpI6k2n3r0CA&oe=6A9EC1D8"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMy2HUPuqmYQ7kNvwFZNimb&_nc_oc=Adpv_mB0F7yiVLdAGJVW5ecGCrqe845RavuuxznyG5CHbmCbC8IyJqijLOP4RzKfDT4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKe8NRBwBMmKaRmOZQMN7L1Pj9T1XdIn5qCL1qcjxEqmw&oe=6A9EDCFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "johannes_vermeer.png", "id": "28534720242819616", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620655_28534720262819614_6180938301831615639_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKjzRTt9RycQ7kNvwHB6UX_&_nc_oc=AdoMN87mwxqUswZeVyt8uZ77jS-nECxvMsGqR_KJhDevGbIA0hnFLXm41NI_fSB3_ks&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtPcxq_CqFaHMDo5lInpkr8n-hzDMbsZqw7xVEF7bZzw&oe=6A9EB7CC"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# See What High Resolution Reveals.\n**Standard vs. High Resolution**\n\n\ud83d\udea8The artwork images are unchanged; the visible difference comes from the app's rendering and display method.\ud83d\udea8\n\n                                                                                                                                  \n{1625477678949865}{3106206799732231}{1114783257894164}{1437177358316906}{1410607057657333}{1050197987985057}{950065198123808}\n*All comparison images shown above were captured directly in the app.\n\n# \ud83d\udea8 TEST RELEASE / FREE\nThis test version is currently free while we improve the experience. Try it and share your feedback!\n\n# Experience World-Famous Art from Home! \ud83c\udfdb\ufe0f\u2728\n\nStep into elegant virtual galleries from home and enjoy works by 12 renowned painters. Move closer to appreciate brushstrokes, textures, and fine details, listen to audio commentary, and discover the history behind each work.\n\n# \ud83c\udfa8 Key Features\n\n**\ud83c\udfa7 Audio Commentary & Text Guides**: Learn about each work\u2019s context, history, and techniques through audio and clear text panels.\n\n**\ud83d\udcda Integrated Wikipedia**: Open related articles for artist biographies and deeper historical context.\n\n**\ud83d\udd0d Up-Close Viewing**: No crowds or velvet ropes. Take your time and view every painting from close range.\n\n**Please Note**\n\nThis is a test-stage release, not the final version. \ud83c\udfa8\u2728\n* Content and specifications may change.\n* The app may become paid in the future. Timing is yet to be determined.\n\n", "short_description": "Experience world-famous masterpieces in stunning high resolution from home! \ud83c\udfa8 Art Museum XR features works by 12 renowned painters in an immersive VR museum. Move closer to reveal brushstrokes, textures, and fine details, listen to audio commentary and read text guides, or explore each work further through seamless Wikipedia integration. Curate your own personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "h
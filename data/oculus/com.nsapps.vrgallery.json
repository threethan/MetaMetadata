3314_1677880923319814_876687770245928609_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZFHkcqaocUQ7kNvwHJWHFb&_nc_oc=AdoFRweA2HmWNvYFe8w-gE6Ki5aDNTsjcb5qh8ZdkcN58ouslnsM6l445niW4b4lJJE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIG8zcfWpQM5bD8g27N8CFG18piRVAi4MERDOjvE7lLgQ&oe=6A99842D"}, {"file_name": "ArtMuseumXR_Logo_White.png", "id": "1364528062455564", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619680_1364528069122230_5169608074860417394_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wC8appbw0jwQ7kNvwFVelD4&_nc_oc=AdrNQ5ht_qzHfELGgpSY65jOkez_LHY2KJsMLWCAPUAFOzJ2fbFly3BHplV8Y9Oo4pY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpGDUhb25hc1t_YREhvjZnLdzbUrT-HIg1fps_cvBUTQ&oe=6A9997D7"}]}, "id": "1331787472500335", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1359131132413955", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619681_1359131139080621_1596761651909387728_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P90XVfOIetMQ7kNvwFc3_F6&_nc_oc=Adp4gI3PRmOQ_ih6OcC9QW73CyabAYUTaLClNWVkDxQo63ewiTef1dJ2eK860MbNnu0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoeLprfYOPfEmKKK-S7OzkWKfHwhmjy5ij28qUuiPvxg&oe=6A999054"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGmzTyx4EOsQ7kNvwGXqcIz&_nc_oc=Ado0ATrh4aX9lLKg0FfUxbhNIkHAT_laqO1v-lLt6vXnq-ck2ieX50YFcYKHP8ScH6Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-7xhGmL2aSCcVNEZ3Qorf2wAlsRmbJ3wWrjcKCJfHyw&oe=6A997BD8"}, {"file_name": "5.png", "id": "1489189206586968", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623384_1489189209920301_5048502910611199436_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NRD0KtLPC8Q7kNvwHLl1wK&_nc_oc=AdrT3aVr0fhLzvoKaiX0BiMMf9YIXr9ogYF0cf_75I3V88TAmbHDe5wMRHF4t8iRRBU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLveMaCJLBbqIwqorzpSKCkaEyiEwBxIyAG2tl2MUY_XA&oe=6A998BF2"}, {"file_name": "2.png", "id": "4400923196831860", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619680_4400923200165193_4844128138414980723_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnXbjutWEsQQ7kNvwH_UYXM&_nc_oc=Adq3qr97YJI-9bk5bZhIcexYukY8_g4uCjx7IysMt3qW_J0kiP8jhxS9uhieFAaVi68&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6T5H1CguV7O9WgC6BtbBu0ba3O2FYuqIn_HihC3TALg&oe=6A996B6A"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiqcKZzKLoAQ7kNvwEsTS-d&_nc_oc=AdrSoQ36d6sSeaEbpCELtO-xfwjzXtW_dgBclyu6CFAWMh_-ya31-Ift5ZXGweVAwlU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSTLRZAsEHavxLe7WRoKbyJXT9piP0pmKPEVYt19_aJw&oe=6A9996FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "27637231985928222", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619078_27637232005928220_7399641891484516281_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dh1DYXnoTvkQ7kNvwGnUegH&_nc_oc=AdrV3K03-V0pThR_ZbKYzrMWy7qcctnn_m_0aTMwZ361Zbulq7f5FCmLynltC6NH5kU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKc25TXPikL6-Y9aGX9n-UiPDfwe9aYwN3gvZem5LXtbg&oe=6A997795"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# \ud83d\udea8 TEST RELEASE / FREE\n\n**This test version is currently free while we improve the experience.**  \n**Please give it a try and share your feedback with us!**\n\n# Transform Your Living Room into a World-Class Art Museum! \ud83c\udfdb\ufe0f\u2728\n\nEver wanted to stroll through iconic art galleries at your own pace?  \n\nArt Museum XR offers an immersive, educational, and relaxing way to experience history\u2019s greatest masterworks. Get up close, listen to fascinating stories, and discover the secrets behind every masterpiece!\n\n# \ud83c\udfa8 Key Features\n\n- **\ud83d\uddbc\ufe0f Immersive Museum Exploration:** Walk freely through elegantly designed virtual exhibition halls. Admire renowned paintings, sculptures, and historical artifacts up close in stunning detail.\n\n- **\ud83c\udfa7 Automatic Audio & Text Guides:** Simply approach any artwork to trigger insightful audio commentary and easy-to-read text panels. Learn the context, history, and artistic techniques effortlessly as you browse.\n\n- **\ud83d\udcda Instant Wikipedia Integration:** Hungry for more knowledge? Seamlessly access integrated Wikipedia articles directly within the app to uncover in-depth biographies, historical era details, and expert analysis.\n\n- **\ud83d\udd0d Unmatched Up-Close Inspection:** No velvet ropes, no crowds! Get closer to the canvas than ever before to observe every brushstroke, texture, and intricate detail in total peace.\n\n# Please Note\n\n**This is a test-stage release, not the final version. \ud83c\udfa8\u2728**\n\n- Content and specifications may change.\n- The app may become paid in the future. The timing is yet to be determined.", "short_description": "Step inside a world-class museum without leaving your home! \ud83c\udfa8 Art Museum XR  brings masterworks of art directly before your eyes. Walk up to paintings and sculptures to trigger automated audio guides and readable descriptions, or dive deeper with seamless Wikipedia integration. Admire intricate details and curate your personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category
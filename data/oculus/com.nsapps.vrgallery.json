9_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoObsbEDMEwQ7kNvwG2LjYR&_nc_oc=Ado-cmlTN7Y2305R-LXM7FVUPW4qLQJuL0N275a8sHzOKytRVrS08XThtJS4-ORhmmI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSVTyogwkPMHfF4S1XsgE2Z5l2aGSCcgRX8T1p7x0I4A&oe=6ADE122D"}, {"file_name": "ArtMuseumXR_Logo_White.png", "id": "1364528062455564", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619680_1364528069122230_5169608074860417394_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLnISDOF5UIQ7kNvwGZjfTx&_nc_oc=AdobFDO08rc90xSdNrBU0EvhPwpFAfX1nGdpLacveCPpXwMehhasPL0asDdzvppbhPs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWVHYXSpaaRBu-mKZ7AnBu2y5jjzMvncXOHbuakwpM0w&oe=6ADE25D7"}]}, "id": "1331787472500335", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1359131132413955", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619681_1359131139080621_1596761651909387728_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4vaU3T-OPYQ7kNvwHWbXvv&_nc_oc=Adr15zbWpq74C_B-j7iOtaprRV2l1pa6FeMNXbLyhTSCU3GqUlknR7eqEbNEp2mqkiA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLLZSKc0Z7soV8D20pVz57EZobHzJ2o6J14tO-pqlt6A&oe=6ADE1E54"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-42x8bLG2LwQ7kNvwFdYXDd&_nc_oc=AdoC06zfhHAAizQt19dGglcw36ePAYH0vNCFkQsULrCy6SX5-EmdmfPU91wFrmwoqdA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxrNNZBlsOQOGdrOzaRSnuoUM353JbEzr3-0N8orEFjg&oe=6ADE09D8"}, {"file_name": "5.png", "id": "1489189206586968", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623384_1489189209920301_5048502910611199436_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fG8dNePruAcQ7kNvwFE4fDy&_nc_oc=AdpE-n2c36d0e8oqZBDfcpJ9IJ5yf-gIOpqhTHtZLpntDOukDpjU_1Vq_1i5HqWsw_A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrjLWJrSV4bI0f8mBUBvZyVDCBnnadCdUAzz2bXTP8tw&oe=6ADE19F2"}, {"file_name": "2.png", "id": "4400923196831860", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619680_4400923200165193_4844128138414980723_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eM5A01IQxe0Q7kNvwEG18LB&_nc_oc=AdrKnQ9SzNBId0i-euRuSXqztOetyM24ya5HozJSj6f3diZ7sSxVCmhXUJpmOWcQr-8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNR1mzNYtH5W-T6ReprhlYXIoPukFwlmSrFFtTbdbhRTA&oe=6ADDF96A"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6DpM-L8meoQ7kNvwHMLmuB&_nc_oc=Adp-kQzm7ARJBl5GZBBJFZbA7lsewDodzNiWWPWlajcrrrGYLrgkT0iRp--JZxTwtiA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBoQMDYbn5i4H6Bi1i6z4S1GYuj8pPIIk8fEZ-STUSLA&oe=6ADE24FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "27637231985928222", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619078_27637232005928220_7399641891484516281_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UK7rEELR5QQ7kNvwHJPrAX&_nc_oc=Adouhm9MXL4baAaOAs8v6RkRB9VavWDD5Eer7xqZfKWE1sCUz50oclGkIjKCY4p-2oQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLCzT3AQ4GXfBY-ZKDtvcsD2jBzOuVruJPhP2QWsbzLg&oe=6ADE0595"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# \ud83d\udea8 TEST RELEASE / FREE\n\n**This test version is currently free while we improve the experience.**  \n**Please give it a try and share your feedback with us!**\n\n# Transform Your Living Room into a World-Class Art Museum! \ud83c\udfdb\ufe0f\u2728\n\nEver wanted to stroll through iconic art galleries at your own pace?  \n\nArt Museum XR offers an immersive, educational, and relaxing way to experience history\u2019s greatest masterworks. Get up close, listen to fascinating stories, and discover the secrets behind every masterpiece!\n\n# \ud83c\udfa8 Key Features\n\n- **\ud83d\uddbc\ufe0f Immersive Museum Exploration:** Walk freely through elegantly designed virtual exhibition halls. Admire renowned paintings, sculptures, and historical artifacts up close in stunning detail.\n\n- **\ud83c\udfa7 Automatic Audio & Text Guides:** Simply approach any artwork to trigger insightful audio commentary and easy-to-read text panels. Learn the context, history, and artistic techniques effortlessly as you browse.\n\n- **\ud83d\udcda Instant Wikipedia Integration:** Hungry for more knowledge? Seamlessly access integrated Wikipedia articles directly within the app to uncover in-depth biographies, historical era details, and expert analysis.\n\n- **\ud83d\udd0d Unmatched Up-Close Inspection:** No velvet ropes, no crowds! Get closer to the canvas than ever before to observe every brushstroke, texture, and intricate detail in total peace.\n\n# Please Note\n\n**This is a test-stage release, not the final version. \ud83c\udfa8\u2728**\n\n- Content and specifications may change.\n- The app may become paid in the future. The timing is yet to be determined.", "short_description": "Step inside a world-class museum without leaving your home! \ud83c\udfa8 Art Museum XR  brings masterworks of art directly before your eyes. Walk up to paintings and sculptures to trigger automated audio guides and readable descriptions, or dive deeper with seamless Wikipedia integration. Admire intricate details and curate your personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE
23314_1677880923319814_876687770245928609_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0FpaN1_jdoQ7kNvwGZdr_T&_nc_oc=Adoq-JpfpyBZPOK-YhIraC_AaHMrfRwyUTBPas29b0ixSopbqL2YYyBiX_vUBP-Ev8Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaL4n0Lef241wNScENzg-14iuZo2uNta1QN5Z3cNzm4w&oe=6AD234AD"}, {"file_name": "ArtMuseumXR_Logo_White.png", "id": "1364528062455564", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619680_1364528069122230_5169608074860417394_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktjm6E2Hf80Q7kNvwHM6SdY&_nc_oc=Adr1YoAZE8uDhzODwsj7gDx972wnXY9HQaVKEvyslhcxOj1PrLa8TvlVANn3pp9woA0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHMENEuvgmlQrk6D7IG6KmwlN8DwOzsJ7bkGv7FWaz4g&oe=6AD24857"}]}, "id": "1331787472500335", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1359131132413955", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619681_1359131139080621_1596761651909387728_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XnMAPz6zmDkQ7kNvwF9dJss&_nc_oc=AdqVk-ikAaiOr7BX_ErpMdz4yJmJ9-XNrDb0cS0kfzXxaLbIqCySvfnBuusF1bShJkI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIaAFBQkkcPRwu5e1Y8e0AHpz3SKQrEWInEbI9N4rl3A&oe=6AD240D4"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d99zhWH-gQMQ7kNvwF_VDxm&_nc_oc=Adq3mG_cVWc39oCtmquBhtn1LYNqnOTDNOy7EWkHtHS46WW3mlHm6k15sFK3tyk7ulw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpOuMapXplOXzK9ZzBO2j2kVppfulDF6ClM0fVYswXlw&oe=6AD22C58"}, {"file_name": "5.png", "id": "1489189206586968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623384_1489189209920301_5048502910611199436_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UybhRNvSjoUQ7kNvwH1wU6q&_nc_oc=AdouEEAU8Ub2vZ2-TYNuvr0VrZ_gZtVfHJBkfEj_QiYEh3fxYvQktrGCaoOyWsBwuyM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9qzNJHKKXoviXaPB27ZNnlv37VmShoqMpaCWvdKekMg&oe=6AD23C72"}, {"file_name": "2.png", "id": "4400923196831860", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_4400923200165193_4844128138414980723_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8C1cBhjuz98Q7kNvwGJ3e2L&_nc_oc=Ado6jzMevhlsRy4h2Qj50gIIIkyGVZAFPiZ6mefyZ9RAoLGWkvv6FCJrxC9s8HQGa6k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvjsvYZ1w6paEsBFmWlNG0F6YLM6DZMo5PE8IkCG7uzQ&oe=6AD2542A"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpLwg_LZIs8Q7kNvwHbrm3o&_nc_oc=Adr_slZmTcizLs4_Y-3xFBoRFbL2cQVpgPpix6fKOAB14eNTUDEZajUGFwlq_zIr2xk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQhThhdAoDiVBfrjhws8ld-d9_y7RQtIlTr5RGecx3AQ&oe=6AD2477B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "27637231985928222", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619078_27637232005928220_7399641891484516281_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9-byPRJ_iAQ7kNvwGUTR6G&_nc_oc=AdrvvuasmSgbBuS-uxvi9o7N7YJJKJ2SvO-bVpTsIs-nUxnwKxqCd5D65K8k2P_5qNw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORySw3APGnOC6iqQg70Rv1hpBuijqR-1SkmIX6fMYLWA&oe=6AD22815"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# \ud83d\udea8 TEST RELEASE / FREE\n\n**This test version is currently free while we improve the experience.**  \n**Please give it a try and share your feedback with us!**\n\n# Transform Your Living Room into a World-Class Art Museum! \ud83c\udfdb\ufe0f\u2728\n\nEver wanted to stroll through iconic art galleries at your own pace?  \n\nArt Museum XR offers an immersive, educational, and relaxing way to experience history\u2019s greatest masterworks. Get up close, listen to fascinating stories, and discover the secrets behind every masterpiece!\n\n# \ud83c\udfa8 Key Features\n\n- **\ud83d\uddbc\ufe0f Immersive Museum Exploration:** Walk freely through elegantly designed virtual exhibition halls. Admire renowned paintings, sculptures, and historical artifacts up close in stunning detail.\n\n- **\ud83c\udfa7 Automatic Audio & Text Guides:** Simply approach any artwork to trigger insightful audio commentary and easy-to-read text panels. Learn the context, history, and artistic techniques effortlessly as you browse.\n\n- **\ud83d\udcda Instant Wikipedia Integration:** Hungry for more knowledge? Seamlessly access integrated Wikipedia articles directly within the app to uncover in-depth biographies, historical era details, and expert analysis.\n\n- **\ud83d\udd0d Unmatched Up-Close Inspection:** No velvet ropes, no crowds! Get closer to the canvas than ever before to observe every brushstroke, texture, and intricate detail in total peace.\n\n# Please Note\n\n**This is a test-stage release, not the final version. \ud83c\udfa8\u2728**\n\n- Content and specifications may change.\n- The app may become paid in the future. The timing is yet to be determined.", "short_description": "Step inside a world-class museum without leaving your home! \ud83c\udfa8 Art Museum XR  brings masterworks of art directly before your eyes. Walk up to paintings and sculptures to trigger automated audio guides and readable descriptions, or dive deeper with seamless Wikipedia integration. Admire intricate details and curate your personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "categor
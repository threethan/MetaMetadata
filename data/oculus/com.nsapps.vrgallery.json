i": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619681_1359131139080621_1596761651909387728_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0qMsPx0OdoQ7kNvwH3RHv_&_nc_oc=Adq-gUo2e4FmtZe3vUjmjJ13rTG6r8N6RlmVvAH-Wk1VSTQswhiEGaijugUT1IS9cSQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ87-EDK-_ARsBOfjUqiVXjwyjKkQ-vPBwc8Xrqj-QQow&oe=6AA17954"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dQvHZDgewQQ7kNvwGdJkr3&_nc_oc=AdrZFXD-1mmf49OAp7kRAaPgGRNPXGTAlzxaKlMudYIQu_KowLOI32izrjD4Ex1M4Iw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHe3R1Xev9_VP2gY9f1c2NA6oU_wBS8z2mHjcHlvfJJA&oe=6AA164D8"}, {"file_name": "5.png", "id": "1489189206586968", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623384_1489189209920301_5048502910611199436_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_D-zOyzTiIQ7kNvwHLumi_&_nc_oc=Adrogr4qr5--YhH9dP2SKF-1DdEflqWLNs3Ya9XV8FmtcrR1Y9D49R9pOUHkiATCRCs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlyagB8fmS3AL5T1SJQ2GLRo43NPgnZHoyWrKCrP5jkg&oe=6AA174F2"}, {"file_name": "2.png", "id": "4400923196831860", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619680_4400923200165193_4844128138414980723_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4OWWTvG6u4Q7kNvwEFmHws&_nc_oc=AdqTc0ZPIg8eYtfGNH4Trtt8P1eXbgzABp6KI7kNJk92-vaouXcCD6OwUaN7knY4Vv8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInYUi2H0q0lhrtDUYBBvW6Uwfb2k9sXAMSgZy0FqJ_SQ&oe=6AA1546A"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMy2HUPuqmYQ7kNvwHUe_uX&_nc_oc=Adqmvtfo-NJX40-wJdYK61LeqXkJDeMTvwStneXp9Me5Xg9T__Z7Bw_--oT6yY8GK70&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmjsR97MWba-xGpnoALg3uLYDIzRXXbgWORDuvlJ5gRA&oe=6AA17FFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "27637231985928222", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619078_27637232005928220_7399641891484516281_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYxEVVqxel4Q7kNvwEeSqMb&_nc_oc=AdrW-HM9s5QCkv12zbOwNNHrns7Ax1c6Xz59wxWzwtM5ZRm7e9GyFlrsFkQYymOoJ6E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIS8DD6yTddQzvE15swrFin2mb2odxn639GfNdckS4xVA&oe=6AA16095"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# \ud83d\udea8 TEST RELEASE / FREE\n\n**This test version is currently free while we improve the experience.**  \n**Please give it a try and share your feedback with us!**\n\n# Transform Your Living Room into a World-Class Art Museum! \ud83c\udfdb\ufe0f\u2728\n\nEver wanted to stroll through iconic art galleries at your own pace?  \n\nArt Museum XR offers an immersive, educational, and relaxing way to experience history\u2019s greatest masterworks. Get up close, listen to fascinating stories, and discover the secrets behind every masterpiece!\n\n# \ud83c\udfa8 Key Features\n\n- **\ud83d\uddbc\ufe0f Immersive Museum Exploration:** Walk freely through elegantly designed virtual exhibition halls. Admire renowned paintings, sculptures, and historical artifacts up close in stunning detail.\n\n- **\ud83c\udfa7 Automatic Audio & Text Guides:** Simply approach any artwork to trigger insightful audio commentary and easy-to-read text panels. Learn the context, history, and artistic techniques effortlessly as you browse.\n\n- **\ud83d\udcda Instant Wikipedia Integration:** Hungry for more knowledge? Seamlessly access integrated Wikipedia articles directly within the app to uncover in-depth biographies, historical era details, and expert analysis.\n\n- **\ud83d\udd0d Unmatched Up-Close Inspection:** No velvet ropes, no crowds! Get closer to the canvas than ever before to observe every brushstroke, texture, and intricate detail in total peace.\n\n# Please Note\n\n**This is a test-stage release, not the final version. \ud83c\udfa8\u2728**\n\n- Content and specifications may change.\n- The app may become paid in the future. The timing is yet to be determined.", "short_description": "Step inside a world-class museum without leaving your home! \ud83c\udfa8 Art Museum XR  brings masterworks of art directly before your eyes. Walk up to paintings and sculptures to trigger automated audio guides and readable descriptions, or dive deeper with seamless Wikipedia integration. Admire intricate details and curate your personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "de"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28220385030886783"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2140853600110872"}]}, "baseline_offer": {"id": "2140853600110872"}, "is_approved": true, "firstOffer": {"nodes": [{"start_
I1bmPUQ7kNvwGCdDcZ&_nc_oc=AdpwyMF-BldLPCGvaMcl_z0UMG4ucU3SiZ8FIiHzHOsS3Go5pXXuoImlPIKHlu4wzJo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZPFRzabSDyUjvigY8XlVEs4yvnLgWiynVg5CPxI__Nw&oe=6A9AE7CB"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGmzTyx4EOsQ7kNvwEWWOyJ&_nc_oc=AdpsNouYWmFMD-dSaLteveDlCC57rs1jsYCw_FzCAVTN3IAvqiDcd_LDNu0RnRpk9r0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI77m3nOXBpB2rOFwm-4NdlqzKcTq-jHri7Ciiclx4F0g&oe=6A9ACD58"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Soo1m2cqocYQ7kNvwGQsww-&_nc_oc=AdqW5f4N924_8EuVfZAuE0szj1gqB4EIIJaz-DF_UzaEnduFQndA60ClNCjAAS4YS7c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHHJykPzBIA-dmfVGLcwxMc60eiscHPAjcR6yZiuiBcQ&oe=6A9AE87B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "johannes_vermeer.png", "id": "28534720242819616", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620655_28534720262819614_6180938301831615639_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvaJF-1pPiMQ7kNvwEQcYYY&_nc_oc=AdryHwzb2ZVgkkF6wXIDcbQ2VkcNOrcq8coaUEJqlY2NNuE2sDazcjO2-w0e6abwZq0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpb5ipb9oCFveWjY7PdFccuU_jfebE6-c9bVzO8lDW7Q&oe=6A9AC34C"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# See What High Resolution Reveals.\n**Standard vs. High Resolution**\n\n\ud83d\udea8The artwork images are unchanged; the visible difference comes from the app's rendering and display method.\ud83d\udea8\n\n                                                                                                                                  \n{1625477678949865}{3106206799732231}{1114783257894164}{1437177358316906}{1410607057657333}{1050197987985057}{950065198123808}\n*All comparison images shown above were captured directly in the app.\n\n# \ud83d\udea8 TEST RELEASE / FREE\nThis test version is currently free while we improve the experience. Try it and share your feedback!\n\n# Experience World-Famous Art from Home! \ud83c\udfdb\ufe0f\u2728\n\nStep into elegant virtual galleries from home and enjoy works by 12 renowned painters. Move closer to appreciate brushstrokes, textures, and fine details, listen to audio commentary, and discover the history behind each work.\n\n# \ud83c\udfa8 Key Features\n\n**\ud83c\udfa7 Audio Commentary & Text Guides**: Learn about each work\u2019s context, history, and techniques through audio and clear text panels.\n\n**\ud83d\udcda Integrated Wikipedia**: Open related articles for artist biographies and deeper historical context.\n\n**\ud83d\udd0d Up-Close Viewing**: No crowds or velvet ropes. Take your time and view every painting from close range.\n\n**Please Note**\n\nThis is a test-stage release, not the final version. \ud83c\udfa8\u2728\n* Content and specifications may change.\n* The app may become paid in the future. Timing is yet to be determined.\n\n", "short_description": "Experience world-famous masterpieces in stunning high resolution from home! \ud83c\udfa8 Art Museum XR features works by 12 renowned painters in an immersive VR museum. Move closer to reveal brushstrokes, textures, and fine details, listen to audio commentary and read text guides, or explore each work further through seamless Wikipedia integration. Curate your own personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "h
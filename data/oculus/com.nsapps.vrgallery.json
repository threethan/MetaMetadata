uluscdn.com/v/t64.5771-25/499623384_1489189209920301_5048502910611199436_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTb0Wsmfq34Q7kNvwHgC23_&_nc_oc=Adr-kdShZtNQa-O4D8wDYmktVM_adbw42-LSgrWRN4sruyFsbQ7ngReNDA1Jh-KHNSY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaxCLMbRzIWHuhay7n3Y8Sq4paYXZk6rL8FMYvXkXd6Q&oe=6AA56972"}, {"file_name": "2.png", "id": "4400923196831860", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619680_4400923200165193_4844128138414980723_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGnuraeCs5QQ7kNvwGPYu-T&_nc_oc=AdrZOnjeFw6703BttCjxoxXs4xUSvxAn7KqhjB1ey0FBwb6zux5cVas5goH-u10NbeA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnagh_PkZwe24HX6lOL5ARMVA7S_jox2gXfzl3_Bd7SQ&oe=6AA548EA"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdlbl1X-XawQ7kNvwE692L4&_nc_oc=AdquEGJ1ws4grF9uWjNE_l_YdYYk5htam8oF7zz0TYmITwu8kRI0n03OEtt_MgCdi5M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCKaA8rcypdCV0cPkZ9Ja2WPfTjnpqkS6623qDrWUS-Q&oe=6AA5747B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "27637231985928222", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619078_27637232005928220_7399641891484516281_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuKtYbrza0AQ7kNvwFiwWOv&_nc_oc=AdrnJtNkA_DYcxiXxHal_FqtIEgdVZTmiWAgU16h5hvMTvCRfzGMv-pN6qItDMg6u0w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBRPoXAPt9xmhiQLR-vZ9ib9QOM8XRG0mKTI4biREZRA&oe=6AA55515"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# \ud83d\udea8 TEST RELEASE / FREE\n\n**This test version is currently free while we improve the experience.**  \n**Please give it a try and share your feedback with us!**\n\n# Transform Your Living Room into a World-Class Art Museum! \ud83c\udfdb\ufe0f\u2728\n\nEver wanted to stroll through iconic art galleries at your own pace?  \n\nArt Museum XR offers an immersive, educational, and relaxing way to experience history\u2019s greatest masterworks. Get up close, listen to fascinating stories, and discover the secrets behind every masterpiece!\n\n# \ud83c\udfa8 Key Features\n\n- **\ud83d\uddbc\ufe0f Immersive Museum Exploration:** Walk freely through elegantly designed virtual exhibition halls. Admire renowned paintings, sculptures, and historical artifacts up close in stunning detail.\n\n- **\ud83c\udfa7 Automatic Audio & Text Guides:** Simply approach any artwork to trigger insightful audio commentary and easy-to-read text panels. Learn the context, history, and artistic techniques effortlessly as you browse.\n\n- **\ud83d\udcda Instant Wikipedia Integration:** Hungry for more knowledge? Seamlessly access integrated Wikipedia articles directly within the app to uncover in-depth biographies, historical era details, and expert analysis.\n\n- **\ud83d\udd0d Unmatched Up-Close Inspection:** No velvet ropes, no crowds! Get closer to the canvas than ever before to observe every brushstroke, texture, and intricate detail in total peace.\n\n# Please Note\n\n**This is a test-stage release, not the final version. \ud83c\udfa8\u2728**\n\n- Content and specifications may change.\n- The app may become paid in the future. The timing is yet to be determined.", "short_description": "Step inside a world-class museum without leaving your home! \ud83c\udfa8 Art Museum XR  brings masterworks of art directly before your eyes. Walk up to paintings and sculptures to trigger automated audio guides and readable descriptions, or dive deeper with seamless Wikipedia integration. Admire intricate details and curate your personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com
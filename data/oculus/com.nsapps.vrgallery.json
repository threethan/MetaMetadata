RrbFf4o-AXZ_3QcMyQPurNirE2e79tjnS7z9d7CBbVVinRqZt2Be8iYlo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLjdzMXQ3C69-YXXUNSVBqa95KFulviz_yoyMAXC19qw&oe=6A95DA0B"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPLlv8cxtJ4Q7kNvwE1RaYm&_nc_oc=Adq7jb6aRwVnrMYqcWGiLT0fzFYF5iov0giqnUsnNpU8mimxmq95imEwcswW5F3185M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUH56ZUIeqtPFJE0OsTwVcy8cw8Nh-FqMUv2_O36V2MQ&oe=6A95BF98"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiqcKZzKLoAQ7kNvwG9Xyo5&_nc_oc=AdoZIF5dGoCaGdJ9hN5VRdx0YyybnBXt6nuci9cJGSWLaMLepRmybt65OoA7mnziTHs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0_PKqmyzgXkHk_qALdL1DWHjI2P_9WJFpnW29J2iQPQ&oe=6A95DABB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "27637231985928222", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619078_27637232005928220_7399641891484516281_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDetegt7fVIQ7kNvwFLph25&_nc_oc=Adr37k_E36teyD4j253VWHwlm7nf0WqObP43Xp2hU5zGsNvAGPc0YmLx9LssM07RiI8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtcoZthJEBo90J3qZ-XaBjbF9gA_K24RZ_0_o3nuiOcQ&oe=6A95BB55"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# See What High Resolution Reveals.\n**Standard vs. High Resolution**\n                                                                                                                                  \n{1625477678949865}{3106206799732231}{1114783257894164}{1437177358316906}{1410607057657333}{1050197987985057}{950065198123808}\n* All comparison images shown above were captured directly in the app.\n\n# \ud83d\udea8 TEST RELEASE / FREE\nThis test version is currently free while we improve the experience. Try it and share your feedback!\n\n# Experience World-Famous Art in Stunning High Resolution! \ud83c\udfdb\ufe0f\u2728\n\nStep into elegant virtual galleries and enjoy paintings by 12 renowned painters from home. Move closer to reveal brushstrokes, textures, and fine details, listen to audio commentary, and discover the history behind each work.\n\n# \ud83c\udfa8 Key Features\n\n**\ud83d\uddbc\ufe0f High-Resolution Art**: Examine every painting with enhanced clarity, from full compositions to subtle brushwork and texture.\n\n**\ud83c\udfa7 Audio Commentary & Text Guides**: Learn about each work\u2019s context, history, and techniques through audio and clear text panels.\n\n**\ud83d\udcda Integrated Wikipedia**: Open related articles for artist biographies and deeper historical context.\n\n**\ud83d\udd0d Up-Close Viewing**: No crowds or velvet ropes. Take your time and view every painting from close range.\n\n**Please Note**\n\nThis is a test-stage release, not the final version. \ud83c\udfa8\u2728\n* Content and specifications may change.\n* The app may become paid in the future. Timing is yet to be determined.\n\n", "short_description": "Experience world-famous masterpieces in stunning high resolution from home! \ud83c\udfa8 Art Museum XR features works by 12 renowned painters in an immersive VR museum. Move closer to reveal brushstrokes, textures, and fine details, listen to audio commentary and read text guides, or explore each work further through seamless Wikipedia integration. Curate your own personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.
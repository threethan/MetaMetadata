=6AC66AD7"}]}, "id": "1331787472500335", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1359131132413955", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619681_1359131139080621_1596761651909387728_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pg-4Fq9_p2UQ7kNvwFSbyye&_nc_oc=Adqj0I3IcE_OoVL0FPaQ5cfUp0pjcRBooRM9DM6W56OXRB1xcdZDbp1CfA4vWTi_gYo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYekgxGVNu9AwjnBhY-DB0tyN6c9ISWdizzD2LxVw9zw&oe=6AC66354"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peo2np4iPuAQ7kNvwFX9SKV&_nc_oc=AdrBj46ZhUCwtRDYDQZ6T7MNzrSaNIPQ45MgOjs4a6ngkWQ0VVwK0TONjIn8Wdy_96Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgmIPdQK73T2neATYAHO1eHehR4QXJGHGd_ixZqHyUvw&oe=6AC64ED8"}, {"file_name": "5.png", "id": "1489189206586968", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623384_1489189209920301_5048502910611199436_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9vzf_XbQZMQ7kNvwHZHVzG&_nc_oc=AdqPks_2tEW8RJYt1pzmXnl9QCjkggD4kgrXG5nPl0Qzt5zjMuyunb8Lo_00aiXi63M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVw9bryYZ7Yr8TKcV-gM77B82lvY4PGKQnixSUvwjliw&oe=6AC65EF2"}, {"file_name": "2.png", "id": "4400923196831860", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619680_4400923200165193_4844128138414980723_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c54GauZvjOUQ7kNvwELxzg2&_nc_oc=AdqeEV2H-ltwQoT27dKKGDfWZGTXQuS6FvAf3UHFl-KapSWMZl0LiZHAb7Ls_ERnYX4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZiOD3TwVzL-smwxClurR8viuR3MX-E0ndsV-tCfO1Zg&oe=6AC676AA"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZaw1I7bT7sQ7kNvwGjMhvU&_nc_oc=AdpmlMcOWCs63FHm17cz4EF0uD6_8-jGE1iL0dYH7AaPaZ8TpCrAoj9tTBwkwEqxSGc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyXN54HUm4KORWvrc_y_8WJuw31zqQHbOgkZjf9uK7jQ&oe=6AC669FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "27637231985928222", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619078_27637232005928220_7399641891484516281_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s08OC8OOTkoQ7kNvwF2OI5k&_nc_oc=Adpkt_9EJ54IGUJKcuvlMr3rom2BfkKuc6M31JVFwTSxb5T3hXFaAxrTAAZ6tol9TYU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrkHVdioIWv6ztGWD6wsYr47zz137M_0RgbB6rc1srXw&oe=6AC64A95"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# \ud83d\udea8 TEST RELEASE / FREE\n\n**This test version is currently free while we improve the experience.**  \n**Please give it a try and share your feedback with us!**\n\n# Transform Your Living Room into a World-Class Art Museum! \ud83c\udfdb\ufe0f\u2728\n\nEver wanted to stroll through iconic art galleries at your own pace?  \n\nArt Museum XR offers an immersive, educational, and relaxing way to experience history\u2019s greatest masterworks. Get up close, listen to fascinating stories, and discover the secrets behind every masterpiece!\n\n# \ud83c\udfa8 Key Features\n\n- **\ud83d\uddbc\ufe0f Immersive Museum Exploration:** Walk freely through elegantly designed virtual exhibition halls. Admire renowned paintings, sculptures, and historical artifacts up close in stunning detail.\n\n- **\ud83c\udfa7 Automatic Audio & Text Guides:** Simply approach any artwork to trigger insightful audio commentary and easy-to-read text panels. Learn the context, history, and artistic techniques effortlessly as you browse.\n\n- **\ud83d\udcda Instant Wikipedia Integration:** Hungry for more knowledge? Seamlessly access integrated Wikipedia articles directly within the app to uncover in-depth biographies, historical era details, and expert analysis.\n\n- **\ud83d\udd0d Unmatched Up-Close Inspection:** No velvet ropes, no crowds! Get closer to the canvas than ever before to observe every brushstroke, texture, and intricate detail in total peace.\n\n# Please Note\n\n**This is a test-stage release, not the final version. \ud83c\udfa8\u2728**\n\n- Content and specifications may change.\n- The app may become paid in the future. The timing is yet to be determined.", "short_description": "Step inside a world-class museum without leaving your home! \ud83c\udfa8 Art Museum XR  brings masterworks of art directly before your eyes. Walk up to paintings and sculptures to trigger automated audio guides and readable descriptions, or dive deeper with seamless Wikipedia integration. Admire intricate details and curate your personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "de"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28220385030886783"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "
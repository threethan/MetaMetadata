23314_1677880923319814_876687770245928609_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGB1Rdf75aMQ7kNvwF2Qljk&_nc_oc=AdqTqC3LQbOaEGFQv8G-tL8B4IQr9iXC58sq3T06_U9qlEFTPCVuZZxnJ8uHzPTutTc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOC0QPl8GDGruf7CtwIKO9xQY_UAXhDMu6ABMMfPa0x9A&oe=6AC505AD"}, {"file_name": "ArtMuseumXR_Logo_White.png", "id": "1364528062455564", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619680_1364528069122230_5169608074860417394_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kX3jApQAojgQ7kNvwHlQABC&_nc_oc=AdobRpLioMbxpgwpUSTdVjXBep5h_ebY1HFtC3BjVDZJtxBNfWK6t6BE6PMyR1EzCuQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrpKrrl0pkxzHDtEBE4Nxf5e9rCU4k1cxUa5w46MausQ&oe=6AC51957"}]}, "id": "1331787472500335", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1359131132413955", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619681_1359131139080621_1596761651909387728_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pg-4Fq9_p2UQ7kNvwHI5Qzj&_nc_oc=Adr0wxcaD75cAGhmHBcHgdUADUcv713hqeJEHvZPDPxROSS0FwbM3rRGeUE4xaOb6Ow&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqtMm5QXUqP87u1F2_tLPzFd39picO-WcFW6BmuCSBVQ&oe=6AC511D4"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peo2np4iPuAQ7kNvwEP2wq6&_nc_oc=AdqolS1rxLYQc8VNsZ0jaKr9jYRi2FosiumW5cvJtx29AEYMeVEuhpWp2b0yZJppxWc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWGgVYmAjNTaRFfkibta9xUuris48g3CxbNKzSMkySzg&oe=6AC4FD58"}, {"file_name": "5.png", "id": "1489189206586968", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623384_1489189209920301_5048502910611199436_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9vzf_XbQZMQ7kNvwFDyV8I&_nc_oc=AdpsdgYf0LWJLsRBv8iJWnftdGu9RMIFiP9A4BC0PF7RDFF_TdTQSpe-mm0d34AsPXE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUx7syFfStMy-XJkH3idN_z26uU7FbsCPyCkj-cqqcCQ&oe=6AC50D72"}, {"file_name": "2.png", "id": "4400923196831860", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619680_4400923200165193_4844128138414980723_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c54GauZvjOUQ7kNvwE6O-mn&_nc_oc=AdqSntXVs4LIjf6CQDZVdEM9hENqX1SeKEsOB2G4IqomjbpNlRPztDxy0NuvFkKGsG8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPr1X7fc6BWwzB2326C_8cNJYPKDiKaFkL0uYTaHveAxg&oe=6AC5252A"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFHXcK75ajcQ7kNvwGFolqo&_nc_oc=AdquC4I04g0FKzKJ4TKRfQ5ybRP2JLONVWvl3ATzdSpazHomC7aojQY8jcACnPaTqAQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMibGnb4pYZUZR5Z66RplrqfVAHWl8J8k2Yea609mbvqA&oe=6AC5187B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "27637231985928222", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619078_27637232005928220_7399641891484516281_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s08OC8OOTkoQ7kNvwGC0jyC&_nc_oc=Adrvy5Aq9lh9-O54Y9KBk6wJnMi98Vfzk1pg1s0M8o1nfudEH7cLTQRIDXLAfynOV7I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNs3aGwISb3Qgq414_nDeWTv2o7TkUocuboHlT_VX4EXQ&oe=6AC4F915"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# \ud83d\udea8 TEST RELEASE / FREE\n\n**This test version is currently free while we improve the experience.**  \n**Please give it a try and share your feedback with us!**\n\n# Transform Your Living Room into a World-Class Art Museum! \ud83c\udfdb\ufe0f\u2728\n\nEver wanted to stroll through iconic art galleries at your own pace?  \n\nArt Museum XR offers an immersive, educational, and relaxing way to experience history\u2019s greatest masterworks. Get up close, listen to fascinating stories, and discover the secrets behind every masterpiece!\n\n# \ud83c\udfa8 Key Features\n\n- **\ud83d\uddbc\ufe0f Immersive Museum Exploration:** Walk freely through elegantly designed virtual exhibition halls. Admire renowned paintings, sculptures, and historical artifacts up close in stunning detail.\n\n- **\ud83c\udfa7 Automatic Audio & Text Guides:** Simply approach any artwork to trigger insightful audio commentary and easy-to-read text panels. Learn the context, history, and artistic techniques effortlessly as you browse.\n\n- **\ud83d\udcda Instant Wikipedia Integration:** Hungry for more knowledge? Seamlessly access integrated Wikipedia articles directly within the app to uncover in-depth biographies, historical era details, and expert analysis.\n\n- **\ud83d\udd0d Unmatched Up-Close Inspection:** No velvet ropes, no crowds! Get closer to the canvas than ever before to observe every brushstroke, texture, and intricate detail in total peace.\n\n# Please Note\n\n**This is a test-stage release, not the final version. \ud83c\udfa8\u2728**\n\n- Content and specifications may change.\n- The app may become paid in the future. The timing is yet to be determined.", "short_description": "Step inside a world-class museum without leaving your home! \ud83c\udfa8 Art Museum XR  brings masterworks of art directly before your eyes. Walk up to paintings and sculptures to trigger automated audio guides and readable descriptions, or dive deeper with seamless Wikipedia integration. Admire intricate details and curate your personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "categor
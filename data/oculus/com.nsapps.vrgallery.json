23314_1677880923319814_876687770245928609_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rb8D6iEz0R8Q7kNvwEHDBYr&_nc_oc=AdrUgafSeYtCdk9VbmsL24LgOll5225wdzukf8l0-iLLvdpO56wk9aYV3zUGEhj4x_g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZjo1as2ttyQ8vJrZrgrqMlFz4HHJ6lY4YpQAhSLFQ9w&oe=6AC262AD"}, {"file_name": "ArtMuseumXR_Logo_White.png", "id": "1364528062455564", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619680_1364528069122230_5169608074860417394_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hyVo-X5ZbIQ7kNvwF_5ERA&_nc_oc=Adp_kz0G-dNfqnsBIzXrRvlzy-2_HWAf2_7AIDAUCwJKYmNH-DRkxu_4dy0Lvv9BotE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuO31ODaUyfutknhGHY7B-h9t9XZ8m-lfnA9vU5sNm0Q&oe=6AC27657"}]}, "id": "1331787472500335", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1359131132413955", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619681_1359131139080621_1596761651909387728_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=974pSSAV9kgQ7kNvwG1sZmp&_nc_oc=Adqnm8HlaOiKfoLmq2pCxcx9tyXGmAak9Mje3cxlsO1mkN0M_D4vHJUc4pivKmPS0fU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgqoWN5BnJrgQtHtXZ4N9x1_1HR16UhCoh4MmlMzoaRQ&oe=6AC26ED4"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBFCElzzgMsQ7kNvwFWAncQ&_nc_oc=Adqx6J8_EDlbX2DmecicJQYRPmpy1jStOcnD_xYyAtu017cBhZ-cxXwU5iqBsTIYV6I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5vPVBeHs82bLIDZoROO8PGpBoASOz8-ZzKT2IppMyxA&oe=6AC25A58"}, {"file_name": "5.png", "id": "1489189206586968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623384_1489189209920301_5048502910611199436_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYEM7BqeljYQ7kNvwGn8_-Z&_nc_oc=AdoCk9WUEcBXGmZxbOdzkR-8BgqfBIsJ0gXWLrxzgQ4m5X13w41vVtFYhSjQoeKX0ao&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDnJBrDmSuZMyWjFQr4t7hCPGf8H4XPSVAA8PYZB3a2g&oe=6AC26A72"}, {"file_name": "2.png", "id": "4400923196831860", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_4400923200165193_4844128138414980723_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWCfnIK5vgQQ7kNvwG8u919&_nc_oc=AdrdRug3L6mHxMS08J6IFr0wc4lueBF4FvoTvI60j5aiOg-Vgv6IRrcMAR9HID3J0hs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1M_XHfNtJRStPrI9g1x73qOOLFXdB4AogACesFzZl0w&oe=6AC2822A"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFHXcK75ajcQ7kNvwFpGPa2&_nc_oc=AdoKE97eX3RwlY0bt8LAyHPN5LpteimfDA5pd-Ps0mCUX3pnIFWFXPi-ejoUPqv6GAs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMduIvHC2MjIMCHElW3a-IBwYfqj4pZsjmlEONgyw_82A&oe=6AC2757B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "27637231985928222", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619078_27637232005928220_7399641891484516281_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V51cWIETP6kQ7kNvwFhdrlj&_nc_oc=AdpETnd2ZnTnqHGKmQobzRjM9oXRwRtqgnYUe8cS9hCb2Wna4JTFmNAfoyaEiGSPM4w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuhLLBMyIPFisMCoX7I9NcRFNjvEvXMyCWmNtnD0o6XA&oe=6AC25615"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# \ud83d\udea8 TEST RELEASE / FREE\n\n**This test version is currently free while we improve the experience.**  \n**Please give it a try and share your feedback with us!**\n\n# Transform Your Living Room into a World-Class Art Museum! \ud83c\udfdb\ufe0f\u2728\n\nEver wanted to stroll through iconic art galleries at your own pace?  \n\nArt Museum XR offers an immersive, educational, and relaxing way to experience history\u2019s greatest masterworks. Get up close, listen to fascinating stories, and discover the secrets behind every masterpiece!\n\n# \ud83c\udfa8 Key Features\n\n- **\ud83d\uddbc\ufe0f Immersive Museum Exploration:** Walk freely through elegantly designed virtual exhibition halls. Admire renowned paintings, sculptures, and historical artifacts up close in stunning detail.\n\n- **\ud83c\udfa7 Automatic Audio & Text Guides:** Simply approach any artwork to trigger insightful audio commentary and easy-to-read text panels. Learn the context, history, and artistic techniques effortlessly as you browse.\n\n- **\ud83d\udcda Instant Wikipedia Integration:** Hungry for more knowledge? Seamlessly access integrated Wikipedia articles directly within the app to uncover in-depth biographies, historical era details, and expert analysis.\n\n- **\ud83d\udd0d Unmatched Up-Close Inspection:** No velvet ropes, no crowds! Get closer to the canvas than ever before to observe every brushstroke, texture, and intricate detail in total peace.\n\n# Please Note\n\n**This is a test-stage release, not the final version. \ud83c\udfa8\u2728**\n\n- Content and specifications may change.\n- The app may become paid in the future. The timing is yet to be determined.", "short_description": "Step inside a world-class museum without leaving your home! \ud83c\udfa8 Art Museum XR  brings masterworks of art directly before your eyes. Walk up to paintings and sculptures to trigger automated audio guides and readable descriptions, or dive deeper with seamless Wikipedia integration. Admire intricate details and curate your personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "categor
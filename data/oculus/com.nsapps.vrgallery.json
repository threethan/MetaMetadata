99620630_2127226978147621_2962501648663465178_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWxp7JAerVUQ7kNvwEBfbmn&_nc_oc=AdqcgmcVMGmk8penK6OqaH0goEeP_7kBDLSQcGVDWUovYy3cydx7W49MCAqOw5b6W6o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjZVCA0Ebq-rz7l_2vgXefI520oSq4Oqu1imZqEKdWzA&oe=6ADE244B"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-42x8bLG2LwQ7kNvwFdYXDd&_nc_oc=AdoC06zfhHAAizQt19dGglcw36ePAYH0vNCFkQsULrCy6SX5-EmdmfPU91wFrmwoqdA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxrNNZBlsOQOGdrOzaRSnuoUM353JbEzr3-0N8orEFjg&oe=6ADE09D8"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6DpM-L8meoQ7kNvwHMLmuB&_nc_oc=Adp-kQzm7ARJBl5GZBBJFZbA7lsewDodzNiWWPWlajcrrrGYLrgkT0iRp--JZxTwtiA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBoQMDYbn5i4H6Bi1i6z4S1GYuj8pPIIk8fEZ-STUSLA&oe=6ADE24FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3 (3).png", "id": "2300428320767315", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499627379_2300428324100648_1425843849556198748_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFWiVr9okgkQ7kNvwGyE80_&_nc_oc=Adow7N3IBVeMo9bb14shYD87e14PLzUqLjyHpm6GMe-tqh-BgClUNV2vov3WQJynHhY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGsWN6AaxB_vJO-qPqMirf4ejIe62SH8hz8x6Q7UC36A&oe=6ADE13EE"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# See What High Resolution Reveals.\u3000\n**Standard vs. High Resolution**\n\n\ud83d\udea8The artwork images are unchanged; the visible difference comes from the app's rendering and display method.\ud83d\udea8\n\n                                                                                                                                 \n{1625477678949865}{3106206799732231}{1114783257894164}{1437177358316906}{1410607057657333}{1050197987985057}{950065198123808}\n*All comparison images shown above were captured directly in the app.\n\n\n# Experience World-Famous Art from Home! \ud83c\udfdb\ufe0f\u2728\n\nStep into elegant virtual galleries from home and enjoy works by 12 renowned painters. Move closer to appreciate brushstrokes, textures, and fine details, listen to audio commentary, and discover the history behind each work.\n\n# \ud83c\udfa8 Key Features\n\n**\ud83c\udfa7 Audio Commentary & Text Guides**: Learn about each work\u2019s context, history, and techniques through audio and clear text panels.\n\n**\ud83d\udcda Integrated Wikipedia**: Open related articles for artist biographies and deeper historical context.\n\n**\ud83d\udd0d Up-Close Viewing**: No crowds or velvet ropes. Take your time and view every painting from close range.\n\n**Please Note**\n\nThis is a test-stage release, not the final version. \ud83c\udfa8\u2728\n* Content and specifications may change.\n\n", "short_description": "Experience world-famous masterpieces in stunning high resolution from home! \ud83c\udfa8 Art Museum XR features works by 12 renowned painters in an immersive VR museum. Move closer to reveal brushstrokes, textures, and fine details, listen to audio commentary and read text guides, or explore each work further through seamless Wikipedia integration. Curate your own personal art journey in VR! \ud83c\udfdb\ufe0f  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
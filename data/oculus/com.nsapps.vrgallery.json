_1677880923319814_876687770245928609_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGFny_dNuPgQ7kNvwEXfkFP&_nc_oc=Adoalja-KOhxvLrXfUFjqzpGSQoFs_NHDgWUvBjuZHSvF8JX10b3u5ZUfIeA79KU-JU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtNBhUmn_R6dla3hyBX7C5kKHeO0pIPOo2dg7v0WNi8Q&oe=6AB9282D"}, {"file_name": "ArtMuseumXR_Logo_White.png", "id": "1364528062455564", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619680_1364528069122230_5169608074860417394_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dF4hXpl82I8Q7kNvwE9MY6P&_nc_oc=AdqRPQhb5wKgD6F5mvqx70yh_gvLH8eofjziw8Ccdn1l7hLt0GW9SghUktrw7YiOA_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKFTnGNe51CyhrwKmnUb5_lfmvvp5V0h0V0ih8HqNZnQ&oe=6AB93BD7"}]}, "id": "1331787472500335", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1359131132413955", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619681_1359131139080621_1596761651909387728_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxobVanzQx0Q7kNvwF5idEC&_nc_oc=AdoHEssZwKs8LNQrUBj1sKz00Pg272Z-OjUqbiAgdRdXm8gOM3h4TYrufyA0FQjbmlc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXluhDt8hHfK6o0iZza3AklTGiaSTuRNfR-V-BO_e3_Q&oe=6AB93454"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PH1WM8oioAQ7kNvwEqqeZ7&_nc_oc=AdruC-mIhnnK4kstvNwqSKnTJfkUtawMHDkvv2t969jWQAbQ5QyVW7RcKq9CV9XQXug&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPFXmQ8D_Esp6e68U9fYdavrqVzFPRNlccno-CttThDg&oe=6AB91FD8"}, {"file_name": "5.png", "id": "1489189206586968", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623384_1489189209920301_5048502910611199436_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hk9n8uUH1A0Q7kNvwHqYDvb&_nc_oc=Adru3XJ0jg9Fd9lQooZhoIZ22SYggW1HckkASud015QOTNTZEkCLDfiAyVo8-PmntvE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIViwNC8wYMxkWbmfB-DuTpgCtw7zkwLkqbC8bYZORGPA&oe=6AB92FF2"}, {"file_name": "2.png", "id": "4400923196831860", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619680_4400923200165193_4844128138414980723_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4ODsT3u4o8Q7kNvwEt0_Xx&_nc_oc=AdoSaxhu65pU5lSgbfVvrw_jAiq1LocyHCwalYZHW5dQcfWyNdWNWNV7ClSIh4_O4xU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIeuImEQaNzZ8cBMiqCv3kpFqQeMlx75nrpnfeAliavw&oe=6AB90F6A"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5lJunmNuTQQ7kNvwHStMF_&_nc_oc=AdoTa0pSp22CFil_q29Lx6Jy1LrrjmhwBZYrpQxGNqYhvTZRubY03jlzmXKT6eNEjRU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcHnR-PsH6ufBKTMikk861SQzBJ7HlXADEkDqd1xX0sg&oe=6AB93AFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "27637231985928222", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619078_27637232005928220_7399641891484516281_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mokb2DLmq74Q7kNvwH7PYjU&_nc_oc=AdpNVCARabTKqrS8GydGCXBltexunPhw0H0eKG4HbyOG6_FiHkupxHNjhpd3NenTPwU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJamvPWecw_LgxEMM0OJkvVbkhH5SDKZ-hYTojj6aiBw&oe=6AB91B95"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# \ud83d\udea8 TEST RELEASE / FREE\n\n**This test version is currently free while we improve the experience.**  \n**Please give it a try and share your feedback with us!**\n\n# Transform Your Living Room into a World-Class Art Museum! \ud83c\udfdb\ufe0f\u2728\n\nEver wanted to stroll through iconic art galleries at your own pace?  \n\nArt Museum XR offers an immersive, educational, and relaxing way to experience history\u2019s greatest masterworks. Get up close, listen to fascinating stories, and discover the secrets behind every masterpiece!\n\n# \ud83c\udfa8 Key Features\n\n- **\ud83d\uddbc\ufe0f Immersive Museum Exploration:** Walk freely through elegantly designed virtual exhibition halls. Admire renowned paintings, sculptures, and historical artifacts up close in stunning detail.\n\n- **\ud83c\udfa7 Automatic Audio & Text Guides:** Simply approach any artwork to trigger insightful audio commentary and easy-to-read text panels. Learn the context, history, and artistic techniques effortlessly as you browse.\n\n- **\ud83d\udcda Instant Wikipedia Integration:** Hungry for more knowledge? Seamlessly access integrated Wikipedia articles directly within the app to uncover in-depth biographies, historical era details, and expert analysis.\n\n- **\ud83d\udd0d Unmatched Up-Close Inspection:** No velvet ropes, no crowds! Get closer to the canvas than ever before to observe every brushstroke, texture, and intricate detail in total peace.\n\n# Please Note\n\n**This is a test-stage release, not the final version. \ud83c\udfa8\u2728**\n\n- Content and specifications may change.\n- The app may become paid in the future. The timing is yet to be determined.", "short_description": "Step inside a world-class museum without leaving your home! \ud83c\udfa8 Art Museum XR  brings masterworks of art directly before your eyes. Walk up to paintings and sculptures to trigger automated audio guides and readable descriptions, or dive deeper with seamless Wikipedia integration. Admire intricate details and curate your personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": n
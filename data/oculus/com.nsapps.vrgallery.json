culuscdn.com/v/t64.5771-25/499620630_2127226978147621_2962501648663465178_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99MX5N62Y2wQ7kNvwGu9Zpf&_nc_oc=Adrm4jUk3gsbvTQzHzZRTT0M8mAAwrMpskD5TQxzRfLhheR7kpGvnhrlMP-FJJ2wc-4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwT5uLcMz9OfZIqp3J-Z1qkFu-XOTgrBVsRKU1d2WpKA&oe=6AB6974B"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ycp6xIcwDOUQ7kNvwEHMs3I&_nc_oc=AdoPlFiV4EGUN3oXTxJgUi4weqQo40_GU6sAiS4Cqhhg3TrzJ7fNwQn-iUh7wSBe88w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcJx6qu0WiO44_cJh3cgojVD8WY4LGDU5bpfQkptNzlA&oe=6AB67CD8"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5lJunmNuTQQ7kNvwFYuRlR&_nc_oc=AdoWvKfDI62tprVURerqXAWs_7JDALWTMAH-UHRMM1JeEGI4eyFLk6ve2PG1TbvrvY0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLP9daY0uvQ4a0nRbtQ6NjJqSBRUeAS497okjSJlQLiHA&oe=6AB697FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "johannes_vermeer.png", "id": "28534720242819616", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620655_28534720262819614_6180938301831615639_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USNUdVq3DmMQ7kNvwG0CAFF&_nc_oc=Adpd-E0PRQDY60VINvmmIhYsaeir5q6Grx_pbE-sNiNK7BaGk0ssnDf4TXWxO00o614&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_tbnMoQd1qm3SeppxeA1gM-x6GKePj4FgszoqA_rJHw&oe=6AB672CC"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# See What High Resolution Reveals.\n**Standard vs. High Resolution**\n\n\ud83d\udea8The artwork images are unchanged; the visible difference comes from the app's rendering and display method.\ud83d\udea8\n\n                                                                                                                                  \n{1625477678949865}{3106206799732231}{1114783257894164}{1437177358316906}{1410607057657333}{1050197987985057}{950065198123808}\n*All comparison images shown above were captured directly in the app.\n\n\n# Experience World-Famous Art from Home! \ud83c\udfdb\ufe0f\u2728\n\nStep into elegant virtual galleries from home and enjoy works by 12 renowned painters. Move closer to appreciate brushstrokes, textures, and fine details, listen to audio commentary, and discover the history behind each work.\n\n# \ud83c\udfa8 Key Features\n\n**\ud83c\udfa7 Audio Commentary & Text Guides**: Learn about each work\u2019s context, history, and techniques through audio and clear text panels.\n\n**\ud83d\udcda Integrated Wikipedia**: Open related articles for artist biographies and deeper historical context.\n\n**\ud83d\udd0d Up-Close Viewing**: No crowds or velvet ropes. Take your time and view every painting from close range.\n\n**Please Note**\n\nThis is a test-stage release, not the final version. \ud83c\udfa8\u2728\n* Content and specifications may change.\n\n", "short_description": "Experience world-famous masterpieces in stunning high resolution from home! \ud83c\udfa8 Art Museum XR features works by 12 renowned painters in an immersive VR museum. Move closer to reveal brushstrokes, textures, and fine details, listen to audio commentary and read text guides, or explore each work further through seamless Wikipedia integration. Curate your own personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_
iYMbxoQ7kNvwFtkLm-&_nc_oc=AdpFmMycFI7Jm9jdh86tyi2W_F-qqK9knQYfnumi_QqsBakYL7j-sMA0Y1u2QoOKGqE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6-SgrOVP52lKehLkDOU5YjN0wLFo3ebTlJZBs1Dqfxg&oe=6AA02DCB"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=214Y8X4oWJ4Q7kNvwENq72D&_nc_oc=AdrBBk76zXpnNYtii3DZsxL-xaoazpmV_NuReD8g-UFtq7jwYGT6mHmtQ7rizDLY_ag&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEmNBo6hrgMbnsMmG4vYBya_otq6zdVOlg8lvOON3Ajw&oe=6AA01358"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMy2HUPuqmYQ7kNvwGITgdz&_nc_oc=Adoi4JWOY0DWGmrJPyZQKjhVA7xxKJSYOK5P4BrfNj4pd9bse2QVWif3GUIcV5By9Ig&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCTgQzEQLTbf5HdWfIlTM3hiJWMkD4MBmW5bNt1ygBDw&oe=6AA02E7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "johannes_vermeer.png", "id": "28534720242819616", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620655_28534720262819614_6180938301831615639_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKjzRTt9RycQ7kNvwHWfMVR&_nc_oc=AdqcpKW79xzGDLENIM1i6E21pUwJboc2xObtRzVamRzdYn0c8Ua5ymTBqRlUGtQuunI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKe9AwyIQnicR8OXegpnXk99dR3J4FjtW6VzlAaAnjfdg&oe=6AA0094C"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# See What High Resolution Reveals.\n**Standard vs. High Resolution**\n\n\ud83d\udea8The artwork images are unchanged; the visible difference comes from the app's rendering and display method.\ud83d\udea8\n\n                                                                                                                                  \n{1625477678949865}{3106206799732231}{1114783257894164}{1437177358316906}{1410607057657333}{1050197987985057}{950065198123808}\n*All comparison images shown above were captured directly in the app.\n\n# \ud83d\udea8 TEST RELEASE / FREE\nThis test version is currently free while we improve the experience. Try it and share your feedback!\n\n# Experience World-Famous Art from Home! \ud83c\udfdb\ufe0f\u2728\n\nStep into elegant virtual galleries from home and enjoy works by 12 renowned painters. Move closer to appreciate brushstrokes, textures, and fine details, listen to audio commentary, and discover the history behind each work.\n\n# \ud83c\udfa8 Key Features\n\n**\ud83c\udfa7 Audio Commentary & Text Guides**: Learn about each work\u2019s context, history, and techniques through audio and clear text panels.\n\n**\ud83d\udcda Integrated Wikipedia**: Open related articles for artist biographies and deeper historical context.\n\n**\ud83d\udd0d Up-Close Viewing**: No crowds or velvet ropes. Take your time and view every painting from close range.\n\n**Please Note**\n\nThis is a test-stage release, not the final version. \ud83c\udfa8\u2728\n* Content and specifications may change.\n* The app may become paid in the future. Timing is yet to be determined.\n\n", "short_description": "Experience world-famous masterpieces in stunning high resolution from home! \ud83c\udfa8 Art Museum XR features works by 12 renowned painters in an immersive VR museum. Move closer to reveal brushstrokes, textures, and fine details, listen to audio commentary and read text guides, or explore each work further through seamless Wikipedia integration. Curate your own personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "h
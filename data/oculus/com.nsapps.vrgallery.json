9_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kycjWQIz7x0Q7kNvwFe0wVu&_nc_oc=Adp0VZl6d3PdibPyMKZZ0fFJxh5MOEfDM0_LWIUvLPS0JhJrWaJi3b1k8dwUnmP1wag&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCjCowDLiYE-mjIM5uSDBIlxREa8iUtbxYeK8AdlOUVw&oe=6AE0B52D"}, {"file_name": "ArtMuseumXR_Logo_White.png", "id": "1364528062455564", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619680_1364528069122230_5169608074860417394_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcNI3oXNw-8Q7kNvwGV_ao8&_nc_oc=AdpeCgbJ2TlmGcZevik-vmKhH8SdvhdU4AXaasnR_dAETFsW63OdPmBT3gnoLBrnIi0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9S_UQQCAfDHYMKJiULt4aH44wemmLvbZMDRS_Z1ygtA&oe=6AE0C8D7"}]}, "id": "1331787472500335", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1359131132413955", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619681_1359131139080621_1596761651909387728_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVcyOXWIRgAQ7kNvwHinKtP&_nc_oc=Ador9QOt5s-pzI1jWzdghZWntCp_gBmnjhrNHiuPrPFdAhyY3wCylsXrGhspLAwW1sQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMos77VdzGAorr7qmgtWsO6LByrY42QR1loqPSQzr-HiQ&oe=6AE0C154"}, {"file_name": "3.png", "id": "1058880546499133", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622285_1058880549832466_5102590840709602379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7ni02O9bPkQ7kNvwE9SRwc&_nc_oc=AdqzYOc5ha0QAlFzK-vui8qZgaOnGkED5ruDchiF03lcW-C4zdkvPz-sxPI84KPdayw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9uZsLzfZwjDOkIkCVPpELjS5CsX5cxUtDb2ED0iC2kw&oe=6AE0ACD8"}, {"file_name": "5.png", "id": "1489189206586968", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623384_1489189209920301_5048502910611199436_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cB0I5_Y5pBgQ7kNvwG8-MV8&_nc_oc=AdrurUDyAH-OavCTiLfG7sR_0xXgSUUOR_5m9RybUX4TpP059Pah3boFR9QJZcAyK8E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGYi5SHmHZQO6SkYA9TW6b4N4eimwukLyi6ZeRoBiJjQ&oe=6AE0BCF2"}, {"file_name": "2.png", "id": "4400923196831860", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619680_4400923200165193_4844128138414980723_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AKvebLPjUAQ7kNvwHUyV-f&_nc_oc=AdrP6GcwP3tSs_TotzDouO5a-1JWMEx69PPmoE5nL5TOiCxVO1VmVNfEjbFpBdaq8YE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvMHMRSPIlPV4xR0ZcWmjCl128zRHivESI52zf4TiDfg&oe=6AE09C6A"}, {"file_name": "4.png", "id": "1067594362294039", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622214_1067594365627372_6750385445688476649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6DpM-L8meoQ7kNvwHFcmDO&_nc_oc=AdpHK02muYFeGRWhX2cNUbY9OAxsntMYMU8SJrLaEx85T3Ju6Ph3K0ohbtSvwaQ-0uo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgwVIw9UudJ72-gX5yRhZBZQMThuXZ5M9jzzjgDX7UkQ&oe=6AE0C7FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "27637231985928222", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619078_27637232005928220_7399641891484516281_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VDbHfaEa5sQ7kNvwFVCol8&_nc_oc=Adosbhw567TKh-Ut3yUmhU-2ZuI7wVQP2STqKwIz7Tv7NeaLNjPEqjgbecFdwZ_82RI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdy0nMZfJb73vNp6V3jWmFojV9dUl3vyz-z95gi0dtrw&oe=6AE0A895"}, "display_name": "Art Museum XR: Masterpiece Tour", "keywords": ["Gallery", "Education", "Culture", "History", "Painting"], "long_description": "# \ud83d\udea8 TEST RELEASE / FREE\n\n**This test version is currently free while we improve the experience.**  \n**Please give it a try and share your feedback with us!**\n\n# Transform Your Living Room into a World-Class Art Museum! \ud83c\udfdb\ufe0f\u2728\n\nEver wanted to stroll through iconic art galleries at your own pace?  \n\nArt Museum XR offers an immersive, educational, and relaxing way to experience history\u2019s greatest masterworks. Get up close, listen to fascinating stories, and discover the secrets behind every masterpiece!\n\n# \ud83c\udfa8 Key Features\n\n- **\ud83d\uddbc\ufe0f Immersive Museum Exploration:** Walk freely through elegantly designed virtual exhibition halls. Admire renowned paintings, sculptures, and historical artifacts up close in stunning detail.\n\n- **\ud83c\udfa7 Automatic Audio & Text Guides:** Simply approach any artwork to trigger insightful audio commentary and easy-to-read text panels. Learn the context, history, and artistic techniques effortlessly as you browse.\n\n- **\ud83d\udcda Instant Wikipedia Integration:** Hungry for more knowledge? Seamlessly access integrated Wikipedia articles directly within the app to uncover in-depth biographies, historical era details, and expert analysis.\n\n- **\ud83d\udd0d Unmatched Up-Close Inspection:** No velvet ropes, no crowds! Get closer to the canvas than ever before to observe every brushstroke, texture, and intricate detail in total peace.\n\n# Please Note\n\n**This is a test-stage release, not the final version. \ud83c\udfa8\u2728**\n\n- Content and specifications may change.\n- The app may become paid in the future. The timing is yet to be determined.", "short_description": "Step inside a world-class museum without leaving your home! \ud83c\udfa8 Art Museum XR  brings masterworks of art directly before your eyes. Walk up to paintings and sculptures to trigger automated audio guides and readable descriptions, or dive deeper with seamless Wikipedia integration. Admire intricate details and curate your personal art journey in VR! \ud83c\udfdb\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE
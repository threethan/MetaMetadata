uscdn.com&_nc_ss=7f20f&oh=00_AQE5-2_7P0qUPvmHwWDRkrniBr9ETaNPTEodjXtWlWiIrA&oe=6A8EE2D2"}, {"file_name": "ss_06.png", "id": "2672249009773139", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618274_2672249013106472_503723496808851203_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vltD8mZiOD4Q7kNvwHAqD0P&_nc_oc=Adp7G2bVHAXpWTNU6XHwUiv08ccIvOcR4XMJCs8UmeZVm_q0caf2HL2Byhf-Rqk15P8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPeMfXaAMqXOlhop1JHuwUJxlQoPZfvBSLOx9afo3_iQ&oe=6A8ECDF3"}, {"file_name": "ss_07.png", "id": "715902498126293", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619096_715902501459626_871509229814198959_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6ipnRQl_xAQ7kNvwHjQ-NR&_nc_oc=AdpdZ0A4UKAxAUKKjRqZjOf6dftLIZfTKyNSOjr__rUVBPNM_5AsZvm3zpaux60DjME&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEy3uHzDfoTv9GezjnMADPaPgo4wPUqHR7csXlcf7-mTQ&oe=6A8EE006"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "INVISIBLE NEIGHBORS", "keywords": ["MetaQuest2", "MetaQuest3", "Shooting", "Game", "Alien"], "long_description": "\u3010About INVISIBLE NEIGHBORS\u3011\nThis is an original shooting game using AR technology played on Meta Quest3/2.\nAliens have already come to Earth and are lurking around us.\nThey are invisible to the naked eye, but by wearing \"Alien Visualization Goggles,\" they become visible to the human eye.\nOnce you recognize the aliens, use the \"Kikuchi-style ray guns\" in both hands to destroy only the bad aliens.\nThe game is over when your health reaches zero.\nIf you survive the time limit, the game is clear.\nThis content is available in both English and Japanese.\n", "short_description": "\u3010About INVISIBLE NEIGHBORS\u3011\nThis is an original shooting game using AR technology played on Meta Quest3/2."}]}, "developer_name": null, "developer_privacy_policy_url": "https://prodigy-inc.co.jp/en/privacypolicy__invisibleneighbors", "develop
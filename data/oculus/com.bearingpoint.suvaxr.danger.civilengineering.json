019824_9159080056006988636_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URNyKGiX1dAQ7kNvwHnoGbB&_nc_oc=AdpwYqUJ4gQh-uMHeDxtgojz0HT00owXpz4gTTzIWRutUA3ufeqcKPbVMpUOJcnF_5g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUS69KEtMQ2C5fZuxnfGtKeujScclRthPCCVui07g5NhQ&oe=6B10444E"}, {"file_name": "Sc02_01.png", "id": "748776800828019", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307303_748776804161352_7593932690210389463_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yreSUDu9XS0Q7kNvwGR0F8L&_nc_oc=AdrqGXzJOfloG2h_SlWKF-R0rqCWFsq1MGYinS9D0hFQVCpsJkhkdvdE1CHxMloCflM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXdJ_PpajFUXnTCwZb7q0YtOX6xXlwgBUMvcfL7Vc-uhA&oe=6B105347"}, {"file_name": "SC02_03.png", "id": "738725575206348", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824594_738725578539681_2428018081613450149_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZuOazY9H78Q7kNvwEpJfTT&_nc_oc=AdqOYDgokcTQIxnmW-QOWN06jeL7NfvthVv5AxIwpLarJB2bo85997wPD3M7E8BaGco&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWmDpWNUAwYz68fe98OSQ7kP_4zE0HdLj7ztLuO9Jhqvg&oe=6B1047FF"}, {"file_name": "sc03_01.png", "id": "3982474788746394", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312263_3982474792079727_6814245125667456949_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYyBGrRIt7AQ7kNvwHz-2X6&_nc_oc=Adq7AlOnc2z8g7gbhNAUScE1TF6WmJjrHRLJr7mTCDBAHElA3N9Gv88vqDiTWma1ywE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWT8PKetmu-1lBFp2PvojFaA9Fkpas1VxQ__g6RDU277A&oe=6B105C50"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Swiss Safety VR: Civil engineering", "keywords": ["Construction", "Accident", "Safety", "prevention", "tools"], "long_description": "Immerse yourself in a new dimension of occupational safety on construction sites with this advanced, highly immersive VR experience! Experience first-hand the challenges of everyday construction work and encounter realistic hazardous situations that can occur on construction sites at any time.\n\nYou will be confronted with critical moments in a detailed virtual environment - for example, when unsecured work areas or poorly visible sections unexpectedly become a threat. These scenarios impressively demonstrate how quickly carelessness can lead to life-threatening situations.\n\nWithout any real risk, you will experience the consequences of unsafe behavior and learn how important preventive measures and correct action are. This not only raises your awareness of hazards, but also gives you a deeper understanding of how to work safely on the construction site.\n\nOur VR experience is more than just a training course - it is your personal safety mission. Because safety is no accident. The revolution in safety-focused training starts here.", "short_description": "\u00dcbernehmen Sie die Rolle eines Bauarbeiters und erleben Sie Unfallsituationen auf der Baustelle. Erfassen Sie Risiken und lernen Sie aus fehlerhaften Handlungen. Die detailreiche VR-Umgebung erm\u00f6glicht es Ihnen, Unfallgefahren ohne Verletztungrisiko zu erleben. Die Revolution der sicherheitsorientierten Schulung startet hier."}, {"images": {"nodes": [{"file_name": "BU2Hero Cover.png", "id": "24163347096584508", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299808_24163347099917841_5560032026988951163_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6RMh0X6gfwQ7kNvwFnuC2I&_nc_oc=AdrwZxJ6namwDjUWRcY3xA8Vc_TtS6eTgghCQ_AzDKmP0ypRgOsml1FWcJrannj0Rl4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUvL0BT65OgR_NUM2JGAoyvxGXCXXU2jxKloJfiWN6vDw&oe=6B105B3F"}, {"file_name": "BU2Cover - Quadrat.png", "id": "2074532346362771", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculu
/scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304053_1399725311249582_4591125264507693000_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZttchPiOx0Q7kNvwFJzmBB&_nc_oc=AdpUrcIOrVJWzn2XnvV520ocWJ4vCd0DCYByPKiuE_o2rNK_1fQN8wSzVd2QqlD-OrY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXZmo-u_mTodi7Yox_88ZAti3z88TMJq4xRSsyzh7wGyw&oe=6B103F61"}, {"file_name": "sc01-01.png", "id": "9325584517544907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824012_9325584524211573_8423275175824134761_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1ONMcOecLIQ7kNvwEbEgcn&_nc_oc=AdqxpHOq1nDVgeBlq-Dkzr8zinoo6T0aQzULJthARReH7sUpHLqpVVUKKApgHqVluA8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVwPyoKrow2AERSPJsm4rdd2lW95da7Rb0SZ3-1k4LqIA&oe=6B103CF2"}, {"file_name": "SC02_03.png", "id": "713963538192767", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307444_713963541526100_2942619829394432397_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9u-VPvLmXkkQ7kNvwG833iL&_nc_oc=AdpIR3o2ojt4desrEtnhFtRWx7xQLHG0UnXl0J59kbANYcPyx_g4cceajX9im3ecsuY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWwNejE5bFSSJ5CioHtbRHapHG5eWaR4La8wd_pPs4zJw&oe=6B103CAD"}, {"file_name": "Sc02_01.png", "id": "1264195195327269", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824594_1264195198660602_6130293208705010251_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IV2heWhyxpQQ7kNvwHGeSfo&_nc_oc=AdodtGtBNhXA4HT9mmLGQhXrS-zKQ849THysMhTpybA1UdzJw6GRVn4IKekgBk0N3xQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUoHD5mlfON1JQUoIKXJDLiZCVL1QT6kMQCVsxfnwd_ew&oe=6B105227"}, {"file_name": "sc03_01.png", "id": "2010589296140601", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830887_2010589299473934_8014581600494745026_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mQHaGkdM20Q7kNvwHSupFK&_nc_oc=Adpc_ib7QjfNBTSmnQaRODbH5E_JAWJRQoTuwbOALnmvfUTSGsIVQ_WxVT3ni6apfXc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWyTtkNueSNgkoMjaZD-vo6Ci5yUM3qX7Mq5hcJxOzD9A&oe=6B1034FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Swiss Safety VR: Ingegneria civile", "keywords": ["Incidenti", "Sicurezza", "Prevenzione", "Strumenti", "cantiere"], "long_description": "Immergetevi in una nuova dimensione della sicurezza sul lavoro nei cantieri con questa esperienza VR avanzata e altamente immersiva! Vivete in prima persona le sfide del lavoro edile quotidiano e incontrate situazioni di pericolo realistiche che possono verificarsi nei cantieri in qualsiasi momento.\n\nIn un ambiente virtuale dettagliato, vi troverete di fronte a momenti critici, ad esempio quando aree di lavoro non protette o sezioni poco visibili diventano inaspettatamente una minaccia. Questi scenari dimostrano in modo impressionante quanto rapidamente una disattenzione possa portare a situazioni di pericolo per la vita.\n\nSenza alcun rischio reale, sperimenterete le conseguenze di un comportamento non sicuro e imparerete quanto siano importanti le misure preventive e le azioni corrette. Questo non solo aumenta la consapevolezza dei pericoli, ma sviluppa anche una comprensione pi\u00f9 profonda di come lavorare in sicurezza in cantiere.\n\nLa nostra esperienza VR \u00e8 pi\u00f9 di una semplice formazione: \u00e8 la vostra missione di sicurezza personale. Perch\u00e9 la sicurezza non \u00e8 un caso. La rivoluzione nella formazione orientata alla sicurezza inizia qui.", "short_description": "Assumete il ruolo di un operaio edile e sperimentate le situazioni di incidente in cantiere. Identificate i rischi e imparate dagli errori che commettete. L'ambiente virtuale, ricco di dettagli, consente di sperimentare i rischi di incidente senza rischiare di farsi male. La rivoluzione nella formazione sulla sicurezza inizia qui."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swiss-safety-vr.ch/_files/ugd/5661b7_b76ecd45a2924048b414f17240a090ca.pdf", "developer_terms_of_service_url": null, "publisher_name": "Suva", "support_website_url": null, "website_url": "http://www.swiss-safety-vr.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "it"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24107980395534009"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1012733577854434"}, {"status": "PUBLISHED", "id": "9766677423417691"}]}, "baseline_offer": {"id": "1012733577854434"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794999360, "status": "PUBLISHED", "id": "1012733577854434"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28635668016098535", "version": "2026.10.rc1"}, "id": "3924534434427224", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9818946544863966", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28635668016098535"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3924534434427224"}]}
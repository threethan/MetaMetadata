-25/38982636_1289623771723809_6121306999433261711_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zKRzWT0UVAQ7kNvwFg7Qvu&_nc_oc=AdrL76NtZFR8iNAwSk2rqoUBLjo20-KKadDQJFG5O8UQGshmh5Z4Z7EAUcVT0I8VJpM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIu1tuhKElfk1V0644YAglmQGiFGkkuINn7v6DvRSkGQ&oe=6A4E4A27"}, "display_name": "ACE", "keywords": [], "long_description": "Ace delivers an unmatched shooting experience for players of all ability levels. Hone your practical shooting skills, compete with friends in multiplayer, or blast robots from all angles. With a wide variety of handguns, optics, and game modes, Ace provides a fun challenge for everyone. Use the app with the stunningly realistic Ace Handset for an unparalleled experience. \n\nSHARPEN YOUR SKILLS\nDozens of practical shooting stages, drills for fundamentals, and instant feedback to help you improve. \n\nEXPERIENCE NEW THRILLS\nEngage drones in a 360 degree field of fire. Run and gun on the move. Defend your position with friends. Ace has a library of games offering hours of fun.\n\nCOMPETE IN MULTIPLAYER\nEarn a spot on the Drill Leaderboard. Win in-game currency from pop-up matches. Compete live with friends in multiplayer. \n\nSHOOT WITH REALISM\nBuilt by shooters, made for everyone.  Ace incorporates authentic ballistics and physics bringing realistic shooting to a platform anyone can enjoy.\n\nUPGRADE WITH THE ACE HANDSET \nShoot today with the Quest Controller. For a truly immersive experience use the Ace Handset.  Compatible with the Quest Controller, the Ace Handset provides the size, weight, trigger pull, and magazine release feel of a real handgun. \nGet your Ace Handset today at www.AceXR.com", "short_description": "Ace VR Shooting \u2013 Train. Game. Win. Sharpen your shooting skills and enjoy new thrills. Ace delivers an authentic and immersive shooting experience from your living room. Hone your practical shooting ability, compete with friends in multiplayer, or blast robots from all angles. With a wide variety of handguns, optics, and game modes, Ace provides endless play to shooters of all skill levels. \nUse the app with the stunningly realistic Ace Handset for an unparalleled experience. "}]}, "developer_name": "Ace", "developer_privacy_policy_url": "https://platform.acexr.com/privacy", "developer_terms_of_service_url": "https://platform.acexr.com/terms", "publisher_name": "Ace", "support_website_url": "https://www.acexr.com/contact", "website_url": "https://acexr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7092793510808218"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PENDING", "id": "1278948147565415"}, {"status": "PUBLISHED", "id": "309954121930023"}, {"status": "PUBLISHED", "id": "236637499399419"}]}, "baseline_offer": {"id": "309954121930023"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1278948147565415"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27807592318901701", "version": "0.17.2"}, "id": "1262405364432113", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7092793504141552", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27807592318901701"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1262405364432113"}]}, "change_log": "# What's New \u2013 v0.17.2\n\nSeason 5 is here. v0.17.2 kicks off the new season with the Independence Day Monthly Match, VR Ace 17 and Ace 19 Handsets, and the return of the Jack Carr Series \u2014 plus scoring, holster, and reliability improvements throughout the app.\n\n## What's New\n\n- **Season 5.** The boards have reset. Complete Daily Drills, Weekly Series, and the Monthly Match to climb the leaderboard and earn your Season 5 Rank. All stages are tuned based on Season 4 data. Don't worry: your guns, unlocks, progression, and account level are all preserved.\n- **Independence Day Monthly Match.** Celebrate 250 years of America with three new Defender stages in a Series: Radial Raid, Ported Vics, and Bunker Breach. Compete against the Ace Community and see how you stack up!\n- **Ace 17 & Ace 19.** The highly requested Ace 17 and Ace 19 VR Handsets are now available, complete with their own iron sights and accessories. Unlock them at the Workbench and start training.\n- **Three New Builds.** Community-voted stages Down The Hall, Every Corner, and Once Upon a Time in The Tropics are now live in Builds. Thanks to Laerkkan, Severe Bacne, and Capt. Pineapples for the great submissions!\n- **Jack Carr Series Returns.** The stages from The Fourth Option Virtual Shooting Competition are back as a regularly playable Series & Stages for Season 5.\n- **Holster Feel & Filters.** Holstering and unholstering now have audio and haptic feedback, and holster runs get their own leaderboard filters and icon.\n\n## What's Fixed\n\n- **Fairer DQ Rules.** Shooting from outside the shooting area now applies a per-shot penalty instead of a disqualification \u2014 DQs are reserved for pointing your gun behind you.\n- **Scoring Updates.** Clay discs on Symmetry are now bonus targets, with no penalty for missing them.\n- **Leaderboard Accuracy.** Live event Series leaderboards now show your series total instead of your last stage score.\n- **Filters That Stick.** Taking off your headset no longer clears your stage and leaderboard filters.\n- **More Breakable Glass.** Truck and car windows now shatter when hit across the stages that feature them.\n- **Tutorial Cleanup.** The Skills section now displays correctly, the TV no longer shows another account's information, and instructions no longer block the Community dashboard.\n- **Visual Polish.** Bullet impacts now wrap cleanly around target edges, 100K barrels no longer clip through the hut, and empty description tooltips are no longer shown.\n- **Playlists & Workbench Reliability.** Improved reliability when loading Playlists \u2014 and if you haven't created any yet, the app now points you to the mobile app. Newly added guns now register correctly at the Workbench.\n\nJump into Season 5 \u2014 run the Independence Day Monthly Match, shoot the new Builds stages, and unlock the Ace 17 or Ace 19 at the Workbench.", "created_date": 1783002350, "id": "27807592318901701", "version": "0.17.2", "version_code": 1552, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27807580782236188"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7092793504141552", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27807592318901701"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1783001087, "id": "27807401598920773", "version": "0.17.1", "version_code": 1551, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []
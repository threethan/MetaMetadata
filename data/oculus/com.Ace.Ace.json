-25/38982636_1289623771723809_6121306999433261711_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqcrFQEnZ8kQ7kNvwGduT1V&_nc_oc=AdpyM22tikvIBfLoTwbM6cBnAaU_atm5mnlwvKl-NMkCgyjMC-CEGJGgKvzxF3p9zdo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nWEDcJg3udYdSp8z9IQNpXzhpCNeZjKnfF_aWxXUx6A&oe=6A1ED427"}, "display_name": "ACE", "keywords": [], "long_description": "Ace delivers an unmatched shooting experience for players of all ability levels. Hone your practical shooting skills, compete with friends in multiplayer, or blast robots from all angles. With a wide variety of handguns, optics, and game modes, Ace provides a fun challenge for everyone. Use the app with the stunningly realistic Ace Handset for an unparalleled experience. \n\nSHARPEN YOUR SKILLS\nDozens of practical shooting stages, drills for fundamentals, and instant feedback to help you improve. \n\nEXPERIENCE NEW THRILLS\nEngage drones in a 360 degree field of fire. Run and gun on the move. Defend your position with friends. Ace has a library of games offering hours of fun.\n\nCOMPETE IN MULTIPLAYER\nEarn a spot on the Drill Leaderboard. Win in-game currency from pop-up matches. Compete live with friends in multiplayer. \n\nSHOOT WITH REALISM\nBuilt by shooters, made for everyone.  Ace incorporates authentic ballistics and physics bringing realistic shooting to a platform anyone can enjoy.\n\nUPGRADE WITH THE ACE HANDSET \nShoot today with the Quest Controller. For a truly immersive experience use the Ace Handset.  Compatible with the Quest Controller, the Ace Handset provides the size, weight, trigger pull, and magazine release feel of a real handgun. \nGet your Ace Handset today at www.AceXR.com", "short_description": "Ace VR Shooting \u2013 Train. Game. Win. Sharpen your shooting skills and enjoy new thrills. Ace delivers an authentic and immersive shooting experience from your living room. Hone your practical shooting ability, compete with friends in multiplayer, or blast robots from all angles. With a wide variety of handguns, optics, and game modes, Ace provides endless play to shooters of all skill levels. \nUse the app with the stunningly realistic Ace Handset for an unparalleled experience. "}]}, "developer_name": "Ace", "developer_privacy_policy_url": "https://platform.acexr.com/privacy", "developer_terms_of_service_url": "https://platform.acexr.com/terms", "publisher_name": "Ace", "support_website_url": "https://www.acexr.com/contact", "website_url": "https://acexr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7092793510808218"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PENDING", "id": "1278948147565415"}, {"status": "PUBLISHED", "id": "309954121930023"}, {"status": "PUBLISHED", "id": "236637499399419"}]}, "baseline_offer": {"id": "309954121930023"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1278948147565415"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27372035159124088", "version": "0.15.2"}, "id": "1262405364432113", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7092793504141552", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27372035159124088"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1262405364432113"}]}, "change_log": "# 0.15.2\n\nA big one. We've redesigned the in-app hub, made offline play reliable end to end, and added new community and enterprise content to the range.\n\n## What's New\n\n- **Redesigned hub.** The main TV is larger and easier to read, the social TV is angled for better visibility, and a new Community Builds panel showcases user-made stages with each creator's name displayed. Range selection has been moved to the main TV's home panel, and the toolbar has been reorganized to match.\n- **14-day offline window.** Up from 7 days. You can be away from the internet longer and still keep playing.\n- **Workbench at a glance.** Each category tab now shows how many items are available for your current gun, and categories that don't apply are grayed out.\n\n## What's Fixed\n\n- **Offline play.** Loadouts, score counts, XP, and session history are now preserved while you're offline and merge back to your profile when you come back online.\n- **Profile sync hitch.** Sign-in no longer hitches on long-tenured accounts; we tracked down the issue and silenced it at the source.\n- **Multiplayer.** Rapidly tapping the multiplayer toggle no longer leaves it in a stuck state. Joining an online friend from the Friends list now auto-enables multiplayer. Stage loading no longer races with multiplayer toggling.\n- **Drill performance.** Non-essential network traffic is now held back until after the drill ends, improving performance during your shooting.\n- **Stage fixes.** Drone 360 and Zombot 360 scoreboards have been repositioned for better visibility. \n\n---\n\n## In case you missed it\n\n### 0.14.17\n\n**Graphics Quality setting.** You can find it in the Advanced menu with three options:\n\n- **Performance:** Higher frame rate and better battery life.\n- **Balanced:** Recommended for most players. Good visuals without sacrificing performance.\n- **Quality:** Best visuals, but may reduce battery life and frame rate on some devices.\n\nSee you on the range!", "created_date": 1779980289, "id": "27372035159124088", "version": "0.15.2", "version_code": 1525, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27372023089125295"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7092793504141552", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27372035159124088"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1779822864, "id": "27346754621652142", "version": "0.15.1", "version_code": 1524, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27346739038320367"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7092793504141552", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27372035159124088"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1779311714, "id": "27282330188094586", "version": "0.15.0.3", "version_code": 1523, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27282322048095400"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applicatio
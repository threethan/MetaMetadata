-25/38982636_1289623771723809_6121306999433261711_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgyGctoHVDkQ7kNvwGQ3ztL&_nc_oc=AdqkA4yJOR6A3AWhqCTl0Y7tB1Hlp0dzlepV8-lCHtr3JlCrM1r0d0brNvUT3JgSaGI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xHqq7uqsX48VtQ2mj02p8IJfICOavwVQnjQW_glPdpw&oe=69DE3AA7"}, "display_name": "ACE", "keywords": [], "long_description": "Ace delivers an unmatched shooting experience for players of all ability levels. Hone your practical shooting skills, compete with friends in multiplayer, or blast robots from all angles. With a wide variety of handguns, optics, and game modes, Ace provides a fun challenge for everyone. Use the app with the stunningly realistic Ace Handset for an unparalleled experience. \n\nSHARPEN YOUR SKILLS\nDozens of practical shooting stages, drills for fundamentals, and instant feedback to help you improve. \n\nEXPERIENCE NEW THRILLS\nEngage drones in a 360 degree field of fire. Run and gun on the move. Defend your position with friends. Ace has a library of games offering hours of fun.\n\nCOMPETE IN MULTIPLAYER\nEarn a spot on the Drill Leaderboard. Win in-game currency from pop-up matches. Compete live with friends in multiplayer. \n\nSHOOT WITH REALISM\nBuilt by shooters, made for everyone.  Ace incorporates authentic ballistics and physics bringing realistic shooting to a platform anyone can enjoy.\n\nUPGRADE WITH THE ACE HANDSET \nShoot today with the Quest Controller. For a truly immersive experience use the Ace Handset.  Compatible with the Quest Controller, the Ace Handset provides the size, weight, trigger pull, and magazine release feel of a real handgun. \nGet your Ace Handset today at www.AceXR.com", "short_description": "Ace VR Shooting \u2013 Train. Game. Win. Sharpen your shooting skills and enjoy new thrills. Ace delivers an authentic and immersive shooting experience from your living room. Hone your practical shooting ability, compete with friends in multiplayer, or blast robots from all angles. With a wide variety of handguns, optics, and game modes, Ace provides endless play to shooters of all skill levels. \nUse the app with the stunningly realistic Ace Handset for an unparalleled experience. "}]}, "developer_name": "Ace", "developer_privacy_policy_url": "https://platform.acexr.com/privacy", "developer_terms_of_service_url": "https://platform.acexr.com/terms", "publisher_name": "Ace", "support_website_url": "https://www.acexr.com/contact", "website_url": "https://acexr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7092793510808218"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PENDING", "id": "1278948147565415"}, {"status": "PUBLISHED", "id": "309954121930023"}, {"status": "PUBLISHED", "id": "236637499399419"}]}, "baseline_offer": {"id": "309954121930023"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1278948147565415"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26805199285807681", "version": "0.13.1"}, "id": "1262405364432113", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7092793504141552", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26805199285807681"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1262405364432113"}]}, "change_log": "What's New - v0.13.1\n\nNew\n- Group posts now show group labels, matching the mobile experience\n- News feed updated with group labels on posts and improved scroll/layout\n- Display name field now available during registration\n- Unregistered players are now guided to activate their membership before registering\n\nFixed\n- Series leaderboard now correctly shows your best run, not your last run\n- Gun rack edits now save immediately. Your loadout stays where you put it\n- Official/ranked flags repositioned so they no longer occasionally block targets\n- Fixed series getting cut off after the first stage when on your last lead\n- Previous best score (hit factor, time, ace score) now shows correctly again on the post-run scoreboard\n- Scoreboard repositioned on \"Greatest Night of Our Lives\" stage\n- Friends and Groups panel now loads reliably for all players\n- Shots fired and currency changes no longer lost between sessions\n- Fixed expired token handling so sessions don't break unexpectedly\n- Fixed videos flashing on the 'Learn more about Ace' login screen\n- Keyboard now hides properly when selecting a stage\n\nThanks to everyone who reported issues. This update is better because of it. See you on the range", "created_date": 1775765925, "id": "26805199285807681", "version": "0.13.1", "version_code": 1448, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26805192449141698"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7092793504141552", "is_concept": false, "latest_released_bina
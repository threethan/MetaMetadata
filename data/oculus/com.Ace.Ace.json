om&_nc_ss=7f20f&oh=00_AQHiJky6Hbt3A0ydmVjzxpbc0yY2yFBVq1I6fkf0W5LYMQ&oe=6A8AC720"}, {"file_name": "5.scores.png", "id": "310220751651752", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75254876_310220754985085_1955283310779689445_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4e5S7pAbHsQ7kNvwHKebG9&_nc_oc=Ado7vPZwXYuz8M_rGW3hO4YOepn1GpYhSVl4c0RYurjG3-fr1lyhmiZQ_lSBx469WNE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEETg2Xe2ywNnEYz38u9G8BGJ-u9ZEUC_NQzmDttA8-0w&oe=6A8AECE2"}, {"file_name": "3.zeroing.png", "id": "872765980926429", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75222943_872765984259762_1969886039242953642_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhKdPHRipKsQ7kNvwEx_w4X&_nc_oc=Ado6EvFafJnJH0oYZBymOmZE2cYzXkuRXSALUfXw4NpyHqcV9yhfUVbfhUu9NcZuOYE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqn0Z3L71eC52efVOxH6vGz_-6VySP7EDJ_1YCHvyPbA&oe=6A8AF225"}, {"file_name": "4.drone.png", "id": "345634224674213", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57569423_345634228007546_1213455816099788607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5m8cb1-ybHEQ7kNvwGAlAd1&_nc_oc=AdoWYh2N1GzPaoh0BSEVo_64c_PBJyMuc7sIEuWK4gKrP4bpWW0PcAONJ9WXeikI6kU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6Fbo9Xn5SrnfisRNX_ifHSp37MJSA_Gi76h7NIzNyfQ&oe=6A8AD97E"}, {"file_name": "2.JW.png", "id": "263591123336768", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982638_263591126670101_4077072197935512495_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVQ6BriHxAoQ7kNvwFN4pBB&_nc_oc=AdoRDYD5BNZzc1h39Od9l0Cf-g2k0ABZpG7ZtniO_gl2sQt_ox3yGpKRTyMgnGv08Cc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7HT4vRo6aFJUATzp09O1tWNKRDPr3AZMJ9kwM22nTyQ&oe=6A8AC099"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapev22560x1440.png", "id": "1289623768390476", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982636_1289623771723809_6121306999433261711_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aMxBvV6obcQ7kNvwHdM7oA&_nc_oc=Adol3Mn5BwpFyqAZCGxArhHcaNAAo5FwZMPxsSkiXYIa-qySUp45-NnUITMhw--Fgb4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHL2aExppu4yxG-5cu4iemytNk6pyWjxfvjemZv4VZYzg&oe=6A8AEF27"}, "display_name": "ACE", "keywords": [], "long_description": "Ace delivers an unmatched shooting experience for players of all ability levels. Hone your practical shooting skills, compete with friends in multiplayer, or blast robots from all angles. With a wide variety of handguns, optics, and game modes, Ace provides a fun challenge for everyone. Use the app with the stunningly realistic Ace Handset for an unparalleled experience. \n\nSHARPEN YOUR SKILLS\nDozens of practical shooting stages, drills for fundamentals, and instant feedback to help you improve. \n\nEXPERIENCE NEW THRILLS\nEngage drones in a 360 degree field of fire. Run and gun on the move. Defend your position with friends. Ace has a library of games offering hours of fun.\n\nCOMPETE IN MULTIPLAYER\nEarn a spot on the Drill Leaderboard. Win in-game currency from pop-up matches. Compete live with friends in multiplayer. \n\nSHOOT WITH REALISM\nBuilt by shooters, made for everyone.  Ace incorporates authentic ballistics and physics bringing realistic shooting to a platform anyone can enjoy.\n\nUPGRADE WITH THE ACE HANDSET \nShoot today with the Quest Controller. For a truly immersive experience use the Ace Handset.  Compatible with the Quest Controller, the Ace Handset provides the size, weight, trigger pull, and magazine release feel of a real handgun. \nGet your Ace Handset today at www.AceXR.com", "short_description": "Ace VR Shooting \u2013 Train. Game. Win. Sharpen your shooting skills and enjoy new thrills. Ace delivers an authentic and immersive shooting experience from your living room. Hone your practical shooting ability, compete with friends in multiplayer, or blast robots from all angles. With a wide variety of handguns, optics, and game modes, Ace provides endless play to shooters of all skill levels. \nUse the app with the stunningly realistic Ace Handset for an unparalleled experience. "}]}, "developer_name": "Ace", "developer_privacy_policy_url": "https://platform.acexr.com/privacy", "developer_terms_of_service_url": "https://platform.acexr.com/terms", "publisher_name": "Ace", "support_website_url": "https://www.acexr.com/contact", "website_url": "https://acexr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7092793510808218"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PENDING", "id": "1278948147565415"}, {"status": "PUBLISHED", "id": "309954121930023"}, {"status": "PUBLISHED", "id": "236637499399419"}]}, "baseline_offer": {"id": "309954121930023"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1278948147565415"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28273921032268825", "version": "0.18.19"}, "id": "1262405364432113", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7092793504141552", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28273921032268825"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1787056635, "id": "28347560531571541", "version": "0.19.0", "version_code": 1588, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28347555891572005"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7092793504141552", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28273921032268825"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1262405364432113"}]}, "change_log": "What's New - 0.18.19\n\nClearer error messages in Duels, plus a round of scoring, audio, and profile fixes.\n\nDuels\n\n* Duels now tell you what went wrong when something fails, instead of failing quietly\n* Both score bars now fill at the same rate, so the animation no longer gives away the winner early\n* Scorecard sounds play correctly again\n\nChanges\n\n* Tutorials can now be opened directly from the Skills card\n* Hitting a target's frame now sounds different from hitting the steel target itself on Texas Stars, so it is easier to tell what you hit\n* The News panel has been removed from VR, and the Trends, Stats, and Progress views have been removed from Social TV, while we rework them\n* Adios: the briefing board has been moved so it is easier to read\n\nFixed\n\n* Putting your gun or head inside a barrel now counts against you the same way other cover does\n* Your Ace Score is displayed the same way everywhere, so the number you see is consistent between Mobile and VR\n* Re-shooting the same daily stage no longer counts more than once toward your stage variety\n* Season ranking now calculates correctly\n* On shared headsets, the app could load the previous player's profile. Sessions are now cleared properly between players\n* If your access to a profile is revoked while you are playing, you are now returned out of the session instead of being left in a broken state\n* Tracking loss", "created_date": 1786545953, "id": "28273921032268825", "version": "0.18.19", "version_code": 1587, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28273913668936228"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7092793504141552", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28273921032268825"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1786459036, "id": "28260673950260200", "version": "0.18.18", "version_code": 1585, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28260665676927694"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7092793504141552", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28273921032268825"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1262405364432113"}]}, "change_log": "Ace 0.18.17 \u2014 Now Live\n\nThe 0.18 update is here, and it's the biggest one yet. Duels bring head-to-head competition to Ace for the first time, and the whole app has had a pass on navigation, scoring, and performance.\n\nDuels\n\nChallenge your friend, on your own schedule.\n\n- New Duels section on the TV: active challenges, pending invites, full history, and results\n- A guided 3-step flow to create a challenge and pick your opponent\n- Post-match scorecards with celebration effects when you take the win\n- \"Your turn\" notifications on the main TV so you never lose track of an open duel\n\nMobile\n\nTake Your Duels Anywhere\n- Your duels don't stop when the headset comes off.\n- Start a duel from your phone, then step into VR to shoot it\n- Go deeper with advanced duel analytics, including a side by side look at how you and your opponent performed\n- Stay on top of active challenges, invites, and whose turn it is from anywhere\n\nNew\n\n- The Atlas Athena pistol, now available\n- Top-bar navigation for faster access to key areas\n- Tutorials now reachable directly from the Skills section\n- Player search matches display name, handle, and bio, so it's easier to find people to duel\n- Dry-fire feedback when you pull the trigger on an empty chamber\n- Visual feedback when a gun or controller loses tracking\n- Your head now takes a penalty for passing through obstacles, same as your gun\n\nPerformance & Feel\n\n- Refresh rate now adapts on its own, stepping down if frames start to slip. Changes never happen mid-drill.\n- More consistent shot registration: where your gun was pointed the moment you fired is tracked with tighter, steadier timing, including during long sessions\n- Reduced per-frame overhead for a smoother baseline framerate\n\nFixed\n\n- Multiple user-reported scoring issues. No score data was lost or invalidated.\n- A repeating sign-in failure loop that could occur after a session expired\n- Tutorial problems, including overlapping Maggie audio, teleport-zone artifacts, and stalling while waiting for optics to attach\n- Blacked-out briefing boards in drills\n- Descend Into Madness: targets can be shot without triggering incorrect penalties\n- A range of weapon, sight, projectile, and collision fixes across gameplay\n- App could fail to start under certain conditions during launch", "created_date": 1785882462, "id": "28177803418547254", "version": "0.18.17", "version_code": 1583, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28177799105214352"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7092793504141552", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28273921032268825"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1785877801, "id": "28177205058607090", "version": "0.18.16", "version_code": 1581, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28177199598607636"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
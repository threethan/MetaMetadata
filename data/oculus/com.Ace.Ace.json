c-tmxW3BXYA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH84Uj6cPgNyEHEZ0OL1xDG4je226lXOA-cY7DvDY2knw&oe=6A8ADC0F"}, {"file_name": "3drone.png", "id": "1409038223806801", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392025_1409038227140134_380375402771640345_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utFgt-9vDlsQ7kNvwFTjFem&_nc_oc=Ados39b9INj-6_AqaIw2PdovQvYZ099fHGVfmmr6Y0YSER18ZpkYDnFrdFAB4OZ-oEM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_UO2wjhHOQkT1HCLxyjI2Qe4vOQvbO9siSDOlthRFFQ&oe=6A8AF276"}, {"file_name": "4barricade.png", "id": "1770180343767897", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392000_1770180347101230_5498755038950581323_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaRh0i94KvIQ7kNvwEnUe0-&_nc_oc=AdocQ7FCG-_N8wtCO3sX8lGLruEPBHACAwnqIkkK_o7LUlqoF-7o2sjsPDQm2ni0yXg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8i75U55SO_IciVXqJgGhZyB5h5ZOZYd7mwg8jeUP26g&oe=6A8AF189"}, {"file_name": "5guns.png", "id": "2503003300032276", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391911_2503003303365609_7875407269161564587_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XsKCAKrYZjQQ7kNvwHcqqdB&_nc_oc=Ado09iY7nfDHEh1621BRf_VtILdGlRbP5bRlbpQ3nXpVVdfKwZe_QM8Y2Kq-AUiWjq8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGufYrf5IkrzjJQ3Xn54H4jnZ5jt0h4T9LINeoMfyRonw&oe=6A8ADB3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscapev3.2560x1440.png", "id": "967708825267429", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392097_967708828600762_3736230516399264872_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTFXPIAdD5UQ7kNvwHmOfw0&_nc_oc=AdqCXCkN36AB6bQ8MS14ECViHe0Z5Eu4MggNjn75tujrVQi3fBqV3pYl0CM9h2te0Hk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEu_gHCxPIXg7rxguGk0E6OhfpXAW__E_Z3IJgFfnvyMg&oe=6A8AEDF4"}, "display_name": "ACE", "keywords": [], "long_description": "ACE HANDSET AND SUBSCRIPTION REQUIRED\n\nUnlock your best with our revolutionary new simulator, Ace Virtual Shooting. Hone your skills. Build your confidence. Compete with friends. Or simply enjoy the thrill of shooting.\n\nPair this VR app with the stunningly realistic Ace Handset to take your experience to the next level. Compatible with the Quest 2 and 3/3S Controllers, the Ace Handset emulates the size, weight, and trigger pull of a real handgun. Get your Ace Handset and Subscription today at www.AceXR.com\n\nSHARPEN YOUR SKILLS\n\nTake limitless reps on 100+ practical shooting drills. Watch your skills improve with instant feedback. Chart your progress with detailed metrics on accuracy, precision, and speed.  New content added regularly keeps Ace fresh and enjoyable.\n\nEXPERIENCE NEW THRILLS\n\nEngage drones in a 360 degree field of fire. Run and gun on the move. Dodge around barricades and cars. Feel a rush of accomplishment as you achieve a new Rank. \n\nCOMPETE IN MULTIPLAYER\n\nEarn a spot on the live leaderboards. Win in-game currency to unlock new VR optics and handgun skins.  Join a Friend Group. Compete live in multiplayer and train with friends.\n\nSHOOT WITH REALISM\n\nBuilt by skilled shooters for all ability levels.  Ace simulates authentic ballistics to deliver a compelling sport shooting experience from the comfort of home. Intended for mature audiences. \n\nApp Privacy\n\nGet info about what data this app developer may request or have access to.", "short_description": "ACE HANDSET AND SUBSCRIPTION REQUIRED\n\nUnlock your best with our revolutionary new simulator, Ace Virtual Shooting. Hone your skills. Build your confidence. Compete with friends. Or simply enjoy the thrill of shooting.\n\nPair this VR app with the stunningly realistic Ace Handset to take your experience to the next level. Compatible with the Quest 2 and 3/3S, the Ace Handset emulates the size, weight, and trigger of a real handgun. Get your Ace Handset and Subscription today at www.AceXR.com"}]}, "developer_name": "Ace", "developer_privacy_policy_url": "https://platform.acexr.com/privacy", "developer_terms_of_service_url": "https://platform.acexr.com/terms", "publisher_name": "Ace", "support_website_url": "https://www.acexr.com/contact", "website_url": "https://acexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "8981643505256533"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391871_535196746192755_5989298295824620475_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RsS6kXDvfDUQ7kNvwEWuTc6&_nc_oc=AdqdrTybtUoRJhg_niR05YRdWEihPOetsHnNWiizx43nK6lcF_uIxyXIS-rEIp3vUmU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyIe_BbdjXTud75-u86dGpmjI-OTmx-lgNqmedmUpQ7w&oe=6A8ADD0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ACE", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1698796800, "lastRevision": {"nodes": [{"id": "7092793527474883", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7092793504141552", "is_first_party": false, "enables_in_
luscdn.com/v/t64.5771-25/38982636_1289623771723809_6121306999433261711_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sr3vlKcrZ5MQ7kNvwESzwCY&_nc_oc=AdppbS5IpvCmNPlxBz3_9lrgNRyTc8OWT62I9guwugIQVXZZPz382uUkFM46Kz-Xdu4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-m6JAbCcRzR9D2BMIbIGRfz2f1asEGjoPzcBoY_-fjMg&oe=6A466127"}, "display_name": "ACE", "keywords": [], "long_description": "Ace delivers an unmatched shooting experience for players of all ability levels. Hone your practical shooting skills, compete with friends in multiplayer, or blast robots from all angles. With a wide variety of handguns, optics, and game modes, Ace provides a fun challenge for everyone. Use the app with the stunningly realistic Ace Handset for an unparalleled experience. \n\nSHARPEN YOUR SKILLS\nDozens of practical shooting stages, drills for fundamentals, and instant feedback to help you improve. \n\nEXPERIENCE NEW THRILLS\nEngage drones in a 360 degree field of fire. Run and gun on the move. Defend your position with friends. Ace has a library of games offering hours of fun.\n\nCOMPETE IN MULTIPLAYER\nEarn a spot on the Drill Leaderboard. Win in-game currency from pop-up matches. Compete live with friends in multiplayer. \n\nSHOOT WITH REALISM\nBuilt by shooters, made for everyone.  Ace incorporates authentic ballistics and physics bringing realistic shooting to a platform anyone can enjoy.\n\nUPGRADE WITH THE ACE HANDSET \nShoot today with the Quest Controller. For a truly immersive experience use the Ace Handset.  Compatible with the Quest Controller, the Ace Handset provides the size, weight, trigger pull, and magazine release feel of a real handgun. \nGet your Ace Handset today at www.AceXR.com", "short_description": "Ace VR Shooting \u2013 Train. Game. Win. Sharpen your shooting skills and enjoy new thrills. Ace delivers an authentic and immersive shooting experience from your living room. Hone your practical shooting ability, compete with friends in multiplayer, or blast robots from all angles. With a wide variety of handguns, optics, and game modes, Ace provides endless play to shooters of all skill levels. \nUse the app with the stunningly realistic Ace Handset for an unparalleled experience. "}]}, "developer_name": "Ace", "developer_privacy_policy_url": "https://platform.acexr.com/privacy", "developer_terms_of_service_url": "https://platform.acexr.com/terms", "publisher_name": "Ace", "support_website_url": "https://www.acexr.com/contact", "website_url": "https://acexr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7092793510808218"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PENDING", "id": "1278948147565415"}, {"status": "PUBLISHED", "id": "309954121930023"}, {"status": "PUBLISHED", "id": "236637499399419"}]}, "baseline_offer": {"id": "309954121930023"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1278948147565415"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27631442423183359", "version": "0.16.5"}, "id": "1262405364432113", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7092793504141552", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27631442423183359"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1782501889, "id": "27740510638943203", "version": "0.16.5.2", "version_code": 1547, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27740500925610841"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7092793504141552", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27631442423183359"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1782231014, "id": "27705027275824873", "version": "0.16.5.1", "version_code": 1546, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27705010475826553"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7092793504141552", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27631442423183359"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1262405364432113"}]}, "change_log": "What's New - 0.16.5\n\n0.16.5 opens up new ways to train and explore, with Playlist creation, new Defender stages, holster-based scoring, and a round of polish across leaderboards, visuals, and stage behavior.\n\nWhat's New\n\n- Playlist is here. You can now build your own custom Series in the mobile app and shoot them in VR, giving you a much more personalized way to train how you want to shoot. In VR, Playlists live under the Builds section, where you can choose between Community Stages and the personal Playlists you created in the mobile app. Auto-generated playlist artwork also makes your content easier to spot and jump into.\n\n- Three new Defender stages. This release adds three new public tactical stages built around the new falling target behavior, bringing a fresh kind of challenge to the range.\n- Holster detection and scoring. Holstering is now a bigger part of training, with new detection and controls that let you practice with scoring filtered to holstering and fine-tune how the feature behaves in play.\n- 100K barrels. Shell progress visuals now go far beyond the old 10K buckets with new 100K barrels, giving your round count a much bigger and more satisfying presence as you keep training.\n- Season and progression polish. The home screen TV now reflects the active season, and Season 4 trophy support is in place.\n\nWhat's Fixed\n\n- Leaderboard reliability. Live event leaderboards now show the correct best attempt score, weekly reports appear correctly, and collapsing the leaderboard no longer makes it disappear.\n- Stage scoring and results. On The Edge now scores stacked targets correctly, and Zom360 no longer shows end-of-stage hit and miss stats where it shouldn\u2019t.\n- Stage interaction fixes. Alley Ambush shots now collide with the van correctly, and Police Cruiser glass behaves as expected.\n- Visual cleanup. Profile images and gun renders no longer appear upside down.\n- Rendering and performance cleanup. Bullet decals behave more predictably, drill scoreboards perform better, and scene rendering has been further optimized.\n\nBuild a Playlist in the mobile app, then head to Builds in VR to choose between Community Stages and your personal Playlists and try a few runs with holster-based scoring.", "created_date": 1781707472, "id": "27631442423183359", "version": "0.16.5", "version_code": 1545, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27631432089851059"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7092793504141552", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27631442423183359"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1781650945, "id": "27623336603993941", "version": "0.16.4", "version_code": 1544, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27623329113994690"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7092793504141552", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27631442423183359"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1781620705, "id": "27619030627757872", "version": "0.16.3", "version_code": 1543, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27619018454425756"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
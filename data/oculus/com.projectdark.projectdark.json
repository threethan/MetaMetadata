s://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392309_1001825091881808_7529226659564270319_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmO_rc3T1dgQ7kNvwGOmMNC&_nc_oc=Adri7HHR3W0a58gBPbkEX95XEhqqMvjXrcDZIVu4o5owblHymrG10JV-RJGiquuDZT0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wJRlynnQOono20Dsl-1OqfLhJOhVlfFM_dNJiQuvGzA&oe=6A466CB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "605365555830161", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392309_605365559163494_6243858717431586414_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dNuAzNwtyYQ7kNvwEjVWQP&_nc_oc=Adp5JbU_0DB4z6vHuj4AcjRfYtB4ju91F0yvbeYPaXc3NimbbnKLTsEkDyOmbPzr_UQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RMn8gjwpuqBChtWU1YohWRYusNaUeAX7-A67G4xD3DA&oe=6A468227"}, "display_name": "PROJECT DARK", "keywords": ["dark", "hard", "competetive", "fun", "relax"], "long_description": "Project Dark VR\n\nEnter a world where shadows are your greatest ally, and movement is your deadliest weapon. Project Dark VR is a high-speed, adrenaline-fueled virtual reality experience that redefines freedom of motion. Navigate a sprawling cyber-noir city with seamless parkour, wall-running, and a state-of-the-art grappling system that lets you soar between towering skyscrapers.\n\nIn this dystopian world, you are a rogue operative hunted by powerful factions. Use stealth to disappear into the darkness or engage in high-speed chases across neon-lit rooftops. Chain together fluid movement combos to outmaneuver enemies, hack security systems, and take down threats with lightning-fast precision. Every mission is a test of skill, speed, and strategy.\n\nThe city never sleeps. The danger never stops. Will you rise from the shadows or be consumed by them?", "short_description": "Project Dark VR\n\nStep into the shadows with Project Dark VR, an intense, fast-paced virtual reality experience where fluid movement is your greatest weapon. Traverse a cyber-noir city using seamless parkour, wall-running, and a high-tech grappling system. Engage in stealthy takedowns or high-speed chases as you uncover the mysteries lurking in the neon-lit underworld.\n\nMove like a ghost. Strike like a shadow. Welcome to Project Dark."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/project-dark-privacy-policy/b0f9eae0-32b4-43b9-bd2f-1117addc9bf3/privacy", "developer_terms_of_service_url": null, "publisher_name": "Dark", "support_website_url": null, "website_url": "https://sites.google.com/view/project-darkfaegfefefafwafwa?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "673385183287495"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9375881635813382"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391952_4107995706145569_3447655349983513289_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usbFeDB0YWYQ7kNvwF6UHVb&_nc_oc=AdpHgrRXAYBWwgyAimpRdVTQb_kMwvKr3syaJ2lk5ox0Edbyy_W05zxlowGV4d9wXdg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cO9wF5B8CyA7lXDI_1yS28OKuYgLyh-0WcDbKKG0IcQ&oe=6A46723D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PROJECT DARK", "platform": "ANDROID_6DOF", "context_category": {"context_category":
mtOjjSPSNXaPmO-Lualh0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF77-lKzItPOPRzIUAM6W4XGqfhvGPdqJuWORZHxjXgww&oe=6A7D9AFA"}, {"file_name": "bb01.png", "id": "1447438466232317", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473394123_1447438469565650_7623719739275182226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WEBZUlbfKUQ7kNvwFbtw4N&_nc_oc=AdoV3yLrE1yiKzaGW5BkiNdzsBJRPn2bY5LufLn9m14MGoaC___mKr_zhh9TPASHH_c&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhd2v89Yq-xuo7RGL1Swbfsq2iP5TwO8ytk1z9nTr-sA&oe=6A7DB0DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover01.png", "id": "1053900703428215", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473396251_1053900710094881_492633272722356443_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=636SUSVPEkAQ7kNvwGvRNxB&_nc_oc=AdrncsxCKdZhFoyN9NSxOL3BxvIaako8nni6uaKWeRIofFacjzfHZWzMO6TrQEeulpM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFxDmVlplc_hV10Ea0bH6aLkrqM1SA7_csrH8PmCD3KQ&oe=6A7DA790"}, "display_name": "Marble Mechanics", "keywords": ["marbles", "marble", "simulation", "sandbox", "physics"], "long_description": "Marble Mechanics is a captivating VR game that transports you into a world where you can create and simulate intricate marble runs. The game offers a variety of track elements - from funnels, loops, spirals, to splitters and turns, all of which can be effortlessly customized and aligned for a seamless marble journey. Grouping of track elements is a breeze, allowing for easy manipulation of large sections. Features like duplication, deletion, and saving of track groups to the Track Box enhance the user experience. With infinite undo/redo options and the ability to save, share, and re-simulate your favorite runs, Marble Mechanics offers endless possibilities for fun and creativity.\n\nWith four tutorials, five puzzles, over 30 achievements to unlock and four Leaderboards to climb, have fun exploring Marble Mechanics!", "short_description": "\u201cMarble Mechanics\u201d is a VR game that lets you build and simulate dynamic marble runs. With auto-aligning tracks, easy construction, and customization options like duplication, deletion, and grouping of tracks, it offers a user-friendly interface. The game features an infinite undo/redo option and allows saving and re-simulation of your favorite marble runs. Dive in for an immersive marble adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://entonosgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Entonos", "support_website_url": "https://entonosgames.com/", "website_url": "https://entonosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9315690148523265"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "24654590714145582"}, {"status": "PUBLISHED", "id": "1956843181736862"}, {"status": "PENDING", "id": "674816151870944"}]}, "baseline_offer": {"id": "1956843181736862"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1757955600, "status": "PUBLISHED", "id": "24654590714145582"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2413483887
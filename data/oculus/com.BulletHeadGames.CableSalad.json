e=69AD6D2C"}, "display_name": "Cable Salad", "keywords": [], "long_description": "There is a commotion in the server room-the wires are mixed up! Unravel the complex maze and determine which wire you need to turn on to send a message to your friends. The game helps to train observation, attention, and logical thinking. Suitable for the first acquaintance with VR.\nCable Salad is the winner in the 2020 Oculus Start Community Game Jam on the theme: \"Overcoming Separation and Fostering Connection\" in the category \"Most Fun to Play!\"\nMy development career started with this game, and now you can share my joy and play absolutely for free.\nPlease leave a comment about how you like the game and join our social network! Welcome!", "short_description": "There is a commotion in the server room-the wires are mixed up! Unravel the complex maze and determine which wire you need to turn on to send a message to your friends. The game helps to train observation, attention, and logical thinking. Suitable for the first acquaintance with VR.\n\nCable Salad is the winner in the 2020 Oculus Start Community Game Jam on the theme: \"Overcoming Separation and Fostering Connection\" in the category \"Most Fun to Play!\""}]}, "developer_name": null, "developer_privacy_policy_url": "http://bulletheadgames.com/PrivatePolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "BulletHead Games", "support_website_url": "http://bulletheadgames.com/", "website_url": "https://www.facebook.com/letsmakeagame", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
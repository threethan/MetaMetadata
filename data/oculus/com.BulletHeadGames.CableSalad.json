/t64.5771-25/75367594_290290383199341_6989328400945456480_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAmcKWkcJhgQ7kNvwGGa-Hb&_nc_oc=AdqMfKkp8htJTZIWtRNu2C0O_wDRRHpd1E_bvBLeZV_jkcbxwh9n9Wzd28ne9kusxm4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrQgE9KJZjRBM_L9H5UpWuKZinAzBnbJ5y2uQADUJsuA&oe=6AFC826C"}, "display_name": "Cable Salad", "keywords": [], "long_description": "There is a commotion in the server room-the wires are mixed up! Unravel the complex maze and determine which wire you need to turn on to send a message to your friends. The game helps to train observation, attention, and logical thinking. Suitable for the first acquaintance with VR.\nCable Salad is the winner in the 2020 Oculus Start Community Game Jam on the theme: \"Overcoming Separation and Fostering Connection\" in the category \"Most Fun to Play!\"\nMy development career started with this game, and now you can share my joy and play absolutely for free.\nPlease leave a comment about how you like the game and join our social network! Welcome!", "short_description": "There is a commotion in the server room-the wires are mixed up! Unravel the complex maze and determine which wire you need to turn on to send a message to your friends. The game helps to train observation, attention, and logical thinking. Suitable for the first acquaintance with VR.\n\nCable Salad is the winner in the 2020 Oculus Start Community Game Jam on the theme: \"Overcoming Separation and Fostering Connection\" in the category \"Most Fun to Play!\""}]}, "developer_name": null, "developer_privacy_policy_url": "http://bulletheadgames.com/PrivatePolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "BulletHead Games", "support_website_url": "http://bulletheadgames.com/", "website_url": "https://www.facebook.com/letsmakeagame", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
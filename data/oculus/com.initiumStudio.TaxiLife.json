ng?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h77Diw1C5r0Q7kNvwHx39v9&_nc_oc=AdrHIVTbFka4h25ccaMhuMa-oy2fvevb4U8VQ22WE7Cp3Os44yaafCQ2PC8luuO6qW4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4PLz9r-I4H638wXmuVYkZitf466YaMvUV1d7Al8pHzg&oe=6AE742D4"}, {"file_name": "1.png", "id": "407028541910849", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974473_407028545244182_812092683262753309_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9gtUEkrLyUQ7kNvwGcyOe2&_nc_oc=Adp2YHInLAfD4_3uDBEvHvryNEbh50T7fwzkuUqCSfbYHe4r7JqTdooF5Dj-PysvmPc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBqYHL1A6uJRtV25oGvWkeV-eRRZ81zIUlErdiFwm4Nw&oe=6AE74A3E"}, {"file_name": "4.png", "id": "1818902965237852", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982528_1818902968571185_3002774767158216087_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4beUvJLx5wQ7kNvwHUMgVe&_nc_oc=AdpnOhRoUd0n1zzTsy1m_5tTmPWcd3rA9uEiZWhOo3weO_vpH2YU_Ytfe4OYVOrPbOo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmmCzSAB1BhT8tyV6Gvrsr33dkFlVuAJ4PzVhY5gN3Qg&oe=6AE7703F"}, {"file_name": "2.png", "id": "1373088863412056", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031656_1373088866745389_7777598770118225789_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfLXqj3uUK0Q7kNvwF3FtcP&_nc_oc=AdrZJejo4xCuNAbRpDCivpg_HNKbw9r0XvyeGzhBKc7l10ftc8sdFHijsmstyhcu6fE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLy2foEJqbMcJJHiT377QJ1bHLTmobwbC0KkjxnqkMvw&oe=6AE7403A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1554888925347261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974764_1554888928680594_2237517088375475401_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-uGa7JMemUQ7kNvwEcbKRX&_nc_oc=Adrdn9CZAbUVcUHAEccpLT3gZG0KQCaFT-QeyNjT-eM9U2eNdD6oo3YPx-xYkAAVZjA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSg4awJebTfB62HyMCRTfcR19MKaUHmosnTXWGgq7q8lQ&oe=6AE75193"}, "display_name": "Taxi Life", "keywords": [], "long_description": "We offer an exciting opportunity for those who want to experience real taxi driving! Taxi Simulator is a detailed simulation game that encompasses every situation a real taxi driver may encounter in everyday life.\n\nIn our game, we've included everything from ordinary daily occurrences to emergency situations. Managing the city's complex traffic system, meeting customer demands, making timely deliveries, and perhaps even experiencing a bit of adventure are all part of the experience.\n\nThe diversity of customers and the variety of tasks provide a different experience each time. Sometimes you'll transport hurried businessmen, other times you'll pick up fun-seeking young people leaving a nightclub, or maybe you'll guide tourists. Each customer comes with a different story and request, increasing the game's replayability.\n\nThrough the tablet inside your taxi, you can instantly access the vehicle's information and easily manage it. You can check the map to determine the shortest route, track customer requests, and even customize your vehicle.\n\nFollow in the footsteps of a real taxi driver with realistic graphics, detailed vehicle controls, and dynamic weather conditions. Taxi Simulator allows you to experience the taxi driving profession down to the finest detail.\n\nTry Taxi Simulator today to feel like a part of the taxi driving world on the city streets!", "short_description": "Experience the thrill of real taxi driving in Taxi Life! Navigate through city streets, encounter diverse customers and tackle various tasks as you manage your taxi.With realistic graphics, dynamic weather and detailed vehicle controls, immerse yourself in the world of taxi driving like never before"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "\u0130N\u0130T\u
ng?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPXi4vTpeRsQ7kNvwEhv_Km&_nc_oc=AdqtoG-f-5Ui_dcHBOZW7PRuuUZKacZCeckDk5_jCdxsj1-1NJzipWfrMtIMHcCmwGU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxI3LZv42YyYlo7nifOdJFr9T67YrtbsxbE2Gm_w8KwQ&oe=6AF20714"}, {"file_name": "1.png", "id": "407028541910849", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974473_407028545244182_812092683262753309_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFBnmSFhmGcQ7kNvwECLjzM&_nc_oc=Adrf7G0BwaLJR_zcBBFgpDAuZbJxRFnT8Bi0Kd3PLl5BOKwddYqxM-e0e-PZ3b-51f0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuqO7nKIsjat0daUCezM-5JWTyQT2tYaUAliR_EL4aXQ&oe=6AF1D63E"}, {"file_name": "4.png", "id": "1818902965237852", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982528_1818902968571185_3002774767158216087_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9VEo3-lbFcQ7kNvwGEMh8o&_nc_oc=Ado5WZWouddAVRluw9HTEq-NwSDwHGhRRG-WftGe8bBMOtRL1f-aAsIwABFmIpEgyxo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQN3doJi4LwEZiH8SJaO0Tlud3lp6HMfmsVd5CIoxo8Jg&oe=6AF1FC3F"}, {"file_name": "2.png", "id": "1373088863412056", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031656_1373088866745389_7777598770118225789_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ix0BZ3Bj428Q7kNvwFoZCvW&_nc_oc=AdoMCfvV_BW4ljDH5RmtiYURgD8Vu29IpPtJ_SxoSRnTBehwv66vX7qDVxPOxrNg5hI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9dWhNuRC3CqIIPxVvqE_YAN0Lvz8CvTU2yPcdpZhHig&oe=6AF2047A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1554888925347261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974764_1554888928680594_2237517088375475401_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WFR-25sqhwQ7kNvwGiNR4U&_nc_oc=AdoWsK6EsCMWl2V4BGWIITFBT0SlD1XxXEpZ1tO-GVw9S7kqIPZKiMgbdL5GQk2tdXY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRTqFIl5kiHX0PbKuyvcpqNb4axwDsoTejaSOINj6qCA&oe=6AF1DD93"}, "display_name": "Taxi Life", "keywords": [], "long_description": "We offer an exciting opportunity for those who want to experience real taxi driving! Taxi Simulator is a detailed simulation game that encompasses every situation a real taxi driver may encounter in everyday life.\n\nIn our game, we've included everything from ordinary daily occurrences to emergency situations. Managing the city's complex traffic system, meeting customer demands, making timely deliveries, and perhaps even experiencing a bit of adventure are all part of the experience.\n\nThe diversity of customers and the variety of tasks provide a different experience each time. Sometimes you'll transport hurried businessmen, other times you'll pick up fun-seeking young people leaving a nightclub, or maybe you'll guide tourists. Each customer comes with a different story and request, increasing the game's replayability.\n\nThrough the tablet inside your taxi, you can instantly access the vehicle's information and easily manage it. You can check the map to determine the shortest route, track customer requests, and even customize your vehicle.\n\nFollow in the footsteps of a real taxi driver with realistic graphics, detailed vehicle controls, and dynamic weather conditions. Taxi Simulator allows you to experience the taxi driving profession down to the finest detail.\n\nTry Taxi Simulator today to feel like a part of the taxi driving world on the city streets!", "short_description": "Experience the thrill of real taxi driving in Taxi Life! Navigate through city streets, encounter diverse customers and tackle various tasks as you manage your taxi.With realistic graphics, dynamic weather and detailed vehicle controls, immerse yourself in the world of taxi driving like never before"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "\u0130N\u0130T\u
ng?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8a3WX1CPbx8Q7kNvwGFzd6B&_nc_oc=AdplC0SnmKq5gIsdrKVCFYZkBpWxVT_qYSzpNXshTe8nd6RArZJSZqcbFgD-fmNAp-Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSzbPkRyNkBk6b4HeyfzjglsHuMhAJBfSS110FzCILVQ&oe=6AEF6414"}, {"file_name": "1.png", "id": "407028541910849", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974473_407028545244182_812092683262753309_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMx2DGg7zSUQ7kNvwHWdAy1&_nc_oc=Adqm4NHs5eVkuHRkz6ghlT_rAMduTo6hOUslg-A2_mOFbJURlIBW4IECueRdQ8Ws-3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQN4U-0PxnVa7R1cFScvNkbYFYZ6TfplcsL9c5gLnYp5A&oe=6AEF333E"}, {"file_name": "4.png", "id": "1818902965237852", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982528_1818902968571185_3002774767158216087_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTNgPOH7NlMQ7kNvwGtanbT&_nc_oc=Adr2d2YPR5OlEf3GnU6GrY1habRozCV4Q6p8Lkrgs-zm2xdwvZMaN4ECs7XMu0E2TGs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGZ8yEpo5oyNxxW_rRjdWyX8LjRnu6YKcN0cu3lFF2RQ&oe=6AEF593F"}, {"file_name": "2.png", "id": "1373088863412056", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031656_1373088866745389_7777598770118225789_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qXwc2O1c7wQ7kNvwFxjQuC&_nc_oc=AdoPfyYQjFztENfsmWtxnY9JIft-oLtdvaFCO8KJNZ_QSw51H7_Jepk4nEvm-P24q7I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpvJ4I32haE2UfZ8MBon24uT9nTkONbahwCvWEJppv3w&oe=6AEF617A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1554888925347261", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974764_1554888928680594_2237517088375475401_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdVqq5qXE-MQ7kNvwEsFQwG&_nc_oc=AdqWaolKgzyqi6ihNEAsz_vR08oCNe5ZQxZouq5wcB4X_j2r6S9a9lZXjH7jQ5JXlbs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYKkyZBl3r0m0tX_eWPLI1ULwtPq2Xp_eGKeW4trV5Gw&oe=6AEF3A93"}, "display_name": "Taxi Life", "keywords": [], "long_description": "We offer an exciting opportunity for those who want to experience real taxi driving! Taxi Simulator is a detailed simulation game that encompasses every situation a real taxi driver may encounter in everyday life.\n\nIn our game, we've included everything from ordinary daily occurrences to emergency situations. Managing the city's complex traffic system, meeting customer demands, making timely deliveries, and perhaps even experiencing a bit of adventure are all part of the experience.\n\nThe diversity of customers and the variety of tasks provide a different experience each time. Sometimes you'll transport hurried businessmen, other times you'll pick up fun-seeking young people leaving a nightclub, or maybe you'll guide tourists. Each customer comes with a different story and request, increasing the game's replayability.\n\nThrough the tablet inside your taxi, you can instantly access the vehicle's information and easily manage it. You can check the map to determine the shortest route, track customer requests, and even customize your vehicle.\n\nFollow in the footsteps of a real taxi driver with realistic graphics, detailed vehicle controls, and dynamic weather conditions. Taxi Simulator allows you to experience the taxi driving profession down to the finest detail.\n\nTry Taxi Simulator today to feel like a part of the taxi driving world on the city streets!", "short_description": "Experience the thrill of real taxi driving in Taxi Life! Navigate through city streets, encounter diverse customers and tackle various tasks as you manage your taxi.With realistic graphics, dynamic weather and detailed vehicle controls, immerse yourself in the world of taxi driving like never before"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "\u0130N\u0130T\u
ng?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPXi4vTpeRsQ7kNvwHmKmTp&_nc_oc=AdpsudszEjRJ3PbN4aN7KMurPis5S7Ymq4p6itDmSC2bHAIHlg758EsHBXoEkdQ71qg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdvOJFufLzIHJecBNgHJo9-DCpjBBaJtoUU-U3fHPkzA&oe=6AF0B594"}, {"file_name": "1.png", "id": "407028541910849", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974473_407028545244182_812092683262753309_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMx2DGg7zSUQ7kNvwHKQXCT&_nc_oc=AdqLGC_iG3nW_veYLbxnhdX7pSfxIA7zLN1wb7v3Ia-Z-zmS9Onwq1MIsgiV-ZJE7iI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSs6CKxdsSGxzFAjEe0PFlOSfxAPcAbUa-BsLWDDU3Txg&oe=6AF084BE"}, {"file_name": "4.png", "id": "1818902965237852", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982528_1818902968571185_3002774767158216087_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9VEo3-lbFcQ7kNvwFn3oiD&_nc_oc=AdpSec7NnAaAsmLWkPPuVGCyNR_x4Uzc-bm02V8fm44Ifh-Uuuo-WYCEY2uI2OgAdZU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ1g-wmkkFHs0JxahZuB_sxQNV0iUT4Bxwq73Rc8RhQg&oe=6AF0AABF"}, {"file_name": "2.png", "id": "1373088863412056", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031656_1373088866745389_7777598770118225789_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qXwc2O1c7wQ7kNvwECWDuy&_nc_oc=AdrSF5tb1KHONi2EsDAHY4fonn0uPhkRnpttjYzzjhoSaDTuuiWqOeikbQ-dUDJZ_Gk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7D4RtInjEUBiwKiJN5jqViF_vP590SuhRTf2Z52jAuA&oe=6AF0B2FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1554888925347261", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974764_1554888928680594_2237517088375475401_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdVqq5qXE-MQ7kNvwEc3k1f&_nc_oc=Adohmpn518P7vv_R0SgFeuRNwMfdMp7xPHPFriE5rX9sOijigay7Loln3hmSy4bOGLI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcFjrHhojgTjZu5XrWQ2AqMf7IeoK6rX4ZMmffScIJVw&oe=6AF08C13"}, "display_name": "Taxi Life", "keywords": [], "long_description": "We offer an exciting opportunity for those who want to experience real taxi driving! Taxi Simulator is a detailed simulation game that encompasses every situation a real taxi driver may encounter in everyday life.\n\nIn our game, we've included everything from ordinary daily occurrences to emergency situations. Managing the city's complex traffic system, meeting customer demands, making timely deliveries, and perhaps even experiencing a bit of adventure are all part of the experience.\n\nThe diversity of customers and the variety of tasks provide a different experience each time. Sometimes you'll transport hurried businessmen, other times you'll pick up fun-seeking young people leaving a nightclub, or maybe you'll guide tourists. Each customer comes with a different story and request, increasing the game's replayability.\n\nThrough the tablet inside your taxi, you can instantly access the vehicle's information and easily manage it. You can check the map to determine the shortest route, track customer requests, and even customize your vehicle.\n\nFollow in the footsteps of a real taxi driver with realistic graphics, detailed vehicle controls, and dynamic weather conditions. Taxi Simulator allows you to experience the taxi driving profession down to the finest detail.\n\nTry Taxi Simulator today to feel like a part of the taxi driving world on the city streets!", "short_description": "Experience the thrill of real taxi driving in Taxi Life! Navigate through city streets, encounter diverse customers and tackle various tasks as you manage your taxi.With realistic graphics, dynamic weather and detailed vehicle controls, immerse yourself in the world of taxi driving like never before"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "\u0130N\u0130T\u
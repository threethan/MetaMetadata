9B6ADA8"}, {"file_name": "flyme-scr9.png", "id": "219213801236808", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210389_219213804570141_15078107561811113_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qZOcQSMccAQ7kNvwFLzBmM&_nc_oc=AdlNyVIrqp3TnwV2OqSQYT4pZTCHbmljI7j2IF-sbiNdrTPXi4xe8CDlUf7Fd_R3pXc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxfl38DMJy_7LynMVcAy6Q6gjmuHgXuTGXoFXtYsmFxog&oe=69B692E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "flyme-cover.png", "id": "1104026810810996", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035443_1104026814144329_8413158493168465819_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FEBE-QuY98Q7kNvwEqGDLC&_nc_oc=AdlB40zcRj7-fAC02AzGG1fz4KfFaOOXTy7XzOQ-97eb1d9yV0Ql3fraZGzmSv04rLA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZDOUZTb5av8Gn7jZ9hnA0W3cNxW1bgbNWsYn14Zcl6A&oe=69B6A2B8"}, "display_name": "FlyMe: Dance of Jupiter", "keywords": [], "long_description": "FlyMe: Dance of Jupiter\n\nWelcome to \"FlyMe: Dance of Jupiter\"! This is a simple yet engaging mixed reality game where you'll experience the exhilaration of remotely controlling an aircraft to shoot Jupiter in the real world, while also enjoying the unique experience of interacting with Jupiter using your hands. Let's explore this fantastical world together!\n\nGameplay:\nIn \"FlyMe: Dance of Jupiter,\" you'll use a remote controller to guide the aircraft and shoot at the virtual Jupiter suspended in the air. If your aircraft flies too far, simply tap lightly, and it will quickly return to your hand, ensuring you maintain control at all times. Additionally, when Jupiter is shot too far, you can pull it back, making the game more fluid.\n\nHand Interaction:\nApart from controlling the aircraft, the most special aspect is that you can interact with the virtual Jupiter. Once you set down the remote controller, your hands can interact with Jupiter. You can touch, grab, and flick Jupiter with your hands, feeling the real-world physics reactions. Moreover, you can change Jupiter's size through gestures or pull it closer.\n\nConclusion:\n\"FlyMe: Dance of Jupiter\" is a simple yet enjoyable game that allows you to experience the fun of flying and shooting in a relaxed atmosphere while also experiencing the wonderful interaction between your hands and Jupiter.", "short_description": "FlyMe: Dance of Jupiter is an exciting mixed reality game where you control an aircraft to shoot at Jupiter, Experience the thrill of flying and shooting while interacting with Jupiter using your hands. With simple controls, easily maneuver your aircraft and enjoy the immersive gameplay. Engage in real-world physics reactions by touching, grabbing, and resizing Jupiter. Dive into this fantastical world, where endless entertainment awaits as you challenge Jupiter and so"}]}, "developer_name": "Zen Chang", "developer_privacy_policy_url": "http://www.zenchang.com/2024/03/fly-me-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "RealityBlend Creations", "support_website_url": null, "website_url": "http://www.zenchang.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24932943083018255"}}]}, "scheduled_offers": {"count": 27, "nodes": [{"status": "PUBLISHED", "id": "1918388268751928"}, {"status": "PUBLISHED", "id
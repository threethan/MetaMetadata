6iU9p-ziJrKIHm0fbheblk88O84&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-m-hZoUBYp7sCt5-SH7OyQ2Jq5UjZ2JO-Ao40GiDZMg&oe=6AFC7712"}, {"file_name": "flyme-scr8.png", "id": "1599578797470605", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/227853641_1599578800803938_4583359421369511434_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsAFqG446JwQ7kNvwFPIi5T&_nc_oc=Ado0vwIQgmmKH8yYrb0DjqPYcCJtlkUvDCXW-ocqovCZIfrq4xB8Hkv2HKdVMi6k7TQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3rObtV-oVANyzSsLQWKMbdsx81TBYVBnttMZinqzEtg&oe=6AFC8868"}, {"file_name": "flyme-scr9.png", "id": "219213801236808", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210389_219213804570141_15078107561811113_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZQ81rRCFWwQ7kNvwGh6Q64&_nc_oc=AdpO5XQ0jRgBBsJR2-fCxKubeB6ydvQ-d2tjIfDLvA8lIXb2phUu8LQ5f4hEcdHYa1g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpVsAKWhPN1L5LpxkpRwYNUut3ZwMVH_vm7_JGAxPZeg&oe=6AFC6DA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "flyme-cover.png", "id": "1104026810810996", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39035443_1104026814144329_8413158493168465819_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qc1Oe7HvG_wQ7kNvwEsvmct&_nc_oc=Adrru_NT2Lumj4mmcJxorc4locRwv0vrkHqrrWGQ2i-2e3T657xmlsKx_Fwn2oWMOos&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSC2tk-MMRd3M-ggxmZypKj99EEGurtssjjFSk0ZMfQ2A&oe=6AFC7D78"}, "display_name": "FlyMe: Dance of Jupiter", "keywords": [], "long_description": "FlyMe: Dance of Jupiter\n\nWelcome to \"FlyMe: Dance of Jupiter\"! This is a simple yet engaging mixed reality game where you'll experience the exhilaration of remotely controlling an aircraft to shoot Jupiter in the real world, while also enjoying the unique experience of interacting with Jupiter using your hands. Let's explore this fantastical world together!\n\nGameplay:\nIn \"FlyMe: Dance of Jupiter,\" you'll use a remote controller to guide the aircraft and shoot at the virtual Jupiter suspended in the air. If your aircraft flies too far, simply tap lightly, and it will quickly return to your hand, ensuring you maintain control at all times. Additionally, when Jupiter is shot too far, you can pull it back, making the game more fluid.\n\nHand Interaction:\nApart from controlling the aircraft, the most special aspect is that you can interact with the virtual Jupiter. Once you set down the remote controller, your hands can interact with Jupiter. You can touch, grab, and flick Jupiter with your hands, feeling the real-world physics reactions. Moreover, you can change Jupiter's size through gestures or pull it closer.\n\nConclusion:\n\"FlyMe: Dance of Jupiter\" is a simple yet enjoyable game that allows you to experience the fun of flying and shooting in a relaxed atmosphere while also experiencing the wonderful interaction between your hands and Jupiter.", "short_description": "FlyMe: Dance of Jupiter is an exciting mixed reality game where you control an aircraft to shoot at Jupiter, Experience the thrill of flying and shooting while interacting with Jupiter using your hands. With simple controls, easily maneuver your aircraft and enjoy the immersive gameplay. Engage in real-world physics reactions by touching, grabbing, and resizing Jupiter. Dive into this fantastical world, where endless entertainment awaits as you challenge Jupiter and so"}]}, "developer_name": "Zen Chang", "developer_privacy_policy_url": "http://www.zenchang.com/2024/03/fly-me-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "RealityBlend Creations", "support_website_url": null, "website_url": "http://www.zenchang.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topi
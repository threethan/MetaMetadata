3090724_n.png", "id": "1417836692785757", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819356_1417836696119090_8460890610165987373_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nT52eEYOrP4Q7kNvwFiS-X-&_nc_oc=AdpOCf0Ur8fma6oSMmJvR_jfM6K0DUJc32oL6YJ2fn9EWc2RrbmI7l2wuMXqjsxtsUo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOhnayrovLrc2gT0SNoFp9XS9XTDHOhgYoLVHkp59npQ&oe=6AFDB5B5"}, {"file_name": "75462205_894927259483646_3889990169543090724_n.png", "id": "607188695086754", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828050_607188698420087_6362627004909059469_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRvu5obmVFsQ7kNvwHJfeCH&_nc_oc=AdoQqIOxx2WzNSxUo0T365eJeY794L28Incsc9QYtRannU8wbf7h4pbW6KdrawLO7v4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKfYe22lIXEhD3XOLz2cbDrW5CDRuhXsvs9A5K9RIxeQ&oe=6AFDAF13"}, {"file_name": "468736550_504312469326249_7327633570441018351_n.png", "id": "1075721351217513", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820137_1075721354550846_2238539632397513690_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJ0RD9aIWJAQ7kNvwHbXzsX&_nc_oc=AdpkDEAY363dksmId7fSO36KonkHzUBtkzkO9oivN30OFoRfgllYju-npu92F5fF9sk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFgWztchQmRnc1kkIf5mtealho8tFEdH7Yw500zyEn9Q&oe=6AFDBD05"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Worlds ", "keywords": [], "long_description": "Jump into games, sports, music and more through your headset, smartphone or laptop. Even if you're far apart, it's fun and easy to feel like you're really together with friends in your own world.\n\nStart a crazy battle in Super Rumble, then jump to see some of your favourite artists in concert. Laugh non-stop from the front row at Soapstone Comedy. Never-before-seen worlds and live events launch all the time. Compete in quests. Own leaderboards. Earn rewards. The more you discover, the easier it is to learn skills, meet friends along the way and find new ways of having fun. Talk, hang and move from world to world in a group.\n\nGet rewarded for being yourself and so much more in worlds where every part of you is welcome.\n\nWorlds includes supervision for parent-managed account users aged 10-12 years old (age may vary by region) and optional supervision features for 13-17 year olds (age may vary by region). It is currently available on Meta Quest, mobile and desktop. You can also manage and set up your profile from the Meta Horizon mobile app. Everyone in Worlds must abide by our Code of Conduct for Virtual Experiences.", "short_description": "Explore lots of crazy, fun, unique worlds and live events with your friends in Meta Horizon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meta.com/legal/quest/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Facebook", "support_website_url": null, "website_url": "https://www.meta.com/quest/", "category": "INTERNAL", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_GB", "en_US", "zh_CN", "zh_HK", "zh_TW", "cs", "da", "nl", "fi", "fr", "de", "el", "it", "ja", "ko", "nb", "pl", "pt", "pt_BR", "ro", "ru", "es_MX", "es", "sv", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9994355373994147"}}]}, "scheduled_offers": {"count": 1, "
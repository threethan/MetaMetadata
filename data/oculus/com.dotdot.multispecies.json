337197950_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UH1DWxTfYS8Q7kNvwGfNkDn&_nc_oc=AdqHUen-E5rwKNzxl6uedmokcPgne7nzj420GVmfRKaSm2bhOubhRzaypu88NnORpxE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EGu_MMUVjss-OSWStgrjs9mQCgFBIPVFinD3UPyGx5A&oe=6A22E672"}, {"file_name": "HumanPerspective.png", "id": "1015328340642768", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391878_1015328343976101_6921068176268767536_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qUrHRL6QHcQ7kNvwHSNfB6&_nc_oc=AdqWLgRTHeZHf0bkcmQWIYIb53ptU00OPUaTGRliTjDaa4YYsiCvT6-9XiuK4GthFFo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-m-ucIKre_fBfxSpmD8hkocw-qBZkY-AGaxMv8nwRaCQ&oe=6A22D947"}, {"file_name": "OneHealthMatrix.png", "id": "3052918244861419", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392314_3052918248194752_3244924214663061257_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfLTujR-6J0Q7kNvwGB2e6p&_nc_oc=AdpJz9gF1NiCe3ygzr69rrlIRklgI39Nh0tXQ4webQfMXlAzr2M3z871FLLQ0_t50Jw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pqBocbmXIjsZU90rM5yt_HHF4e8kTo4lAqJGDKmpkeA&oe=6A2301B4"}, {"file_name": "PlantingRobotPerspective.png", "id": "642920798296171", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391978_642920801629504_9176832776808441649_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZqfSOfhL4IQ7kNvwHwMTmi&_nc_oc=AdqZ1cTWmXCllDMa7jd4yu-lTTxYcEID3o9Vi5tnHjvGgOr-1NNgKF6CHEeCVOMqzFI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DmcCmAsdu5jPV9jrnnBfqaADDaWtP3nBlPZKyD6Tbow&oe=6A22DE89"}, {"file_name": "AppleTreePerspective.png", "id": "985829762908962", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393438_985829766242295_3021989480068041884_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQWcKI84XTsQ7kNvwHEhcBn&_nc_oc=AdqdbYPSabAosljGh0C8SoDOp-njX92myMlNa8vyrJy8Bzig5n_sF7g1yfx4ePdMiLw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Uy7K6kSVIJbXC8XOcgOc6vjHBC0P6Ml363epq1-90Lw&oe=6A22EC3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MuMu-Video-Still.png", "id": "1515734759792517", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491821849_1515734763125850_7576914635659249125_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qZ-JVt7KwAQ7kNvwHz5ts5&_nc_oc=AdocMVJBlmVbsrQUoxJDdAXur7r0ijbFtZ2oJ9hhcR0rcLg-d_6vSqXe2jcAbDkheB0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nYL0w2IkwmqEdDnE3efKg4S1ou6XhB-oZdnQZ-YAgTQ&oe=6A22F048"}, "display_name": "MuMu: Worlds of Connections", "keywords": ["Multispecies", "Networks", "Science", "Systems", "Farm"], "long_description": "Embark on an extraordinary adventure in MuMu: Worlds of Connections! In the MuMu (the multispecies multiplex), something's gone awry on the farm lab, and your mission, if you dare to accept it, is to maintain the delicate balance of this unique ecosystem while growing an abundant supply of apples for your community. In this mind-bending game, you'll seamlessly switch between the perspectives of a human scientist, an inquisitive prairie dog, a wise apple tree, and an ambitious planting robot. Shrink or grow to experience the world from their eyes, gaining profound insights into different intelligences. As you navigate this immersive journey, you're not just playing a game \u2013 you're honing your skills as a systems thinker, decoding the secrets of planetary health and climate futures. MuMu invites you to see the world through diverse lenses, offering an unparalleled opportunity to become a mastermind of system dynamics.", "short_description": "Something is amiss in the MuMu, the multispecies multiplex...If you\u2019re up for it, your mission is keeping the farm lab system shipshape and cultivating a bounty of apples to share with your community. You can shift between multiple perspectives to navigate the Farm Lab. You will experience MuMu through the eyes of other intelligences. When we start seeing the world through different lenses, we aren\u2019t just playing a game \u2013 we're becoming mastermind systems thinkers, cracking the code of planetary"}]}, "developer_name": "University of Nebraska-Lincoln", "developer_privacy_policy_url": "https://edgeworks.unl.edu/sites/unl.edu.hixson-lied.carson-center.edgeworks/files/media/file/MuMu%20Worlds%20of%20Connections%20Privacy%20Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "University of Nebraska-Lincoln", "support_website_url": null, "website_url": "https://go.unl.edu/wocsepa", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9373228106113628"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1080825240615195"}]}, "baseline_offer": {"id": "1080825240615195"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1761336180, "status": "PUBLISHED", "id": "1080825240615195"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23964121283264402", "version": "2.7"}, "id": "955569426676480", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Applicati
7197950_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYOuxQTmAkAQ7kNvwH_an5A&_nc_oc=Adr8oPb-XfNQ8RDKV419Ne2qL3WXc7hAi4vzt0Q1uYx_DIf1rQbH2HTI_3MfPb6QUXs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPyKAFq4EgnlgTxdJRACr90HAzjzDOdVRK2UXAEHTR6w&oe=6AB93172"}, {"file_name": "HumanPerspective.png", "id": "1015328340642768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391878_1015328343976101_6921068176268767536_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtN7MbnLVTYQ7kNvwGDb0EC&_nc_oc=Ado2vmv82oEP7UeSNeHlxX4PYA2PX89yqU4It7PeNsdoK5MiayNFar2eKsjWEhS2bxM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1hlLY-5yplUKcaXFpvswzc9q5XXtId_isMTBSncwFaw&oe=6AB92447"}, {"file_name": "OneHealthMatrix.png", "id": "3052918244861419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392314_3052918248194752_3244924214663061257_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iGd8AlA2HAQ7kNvwGTX95g&_nc_oc=AdrzARJz7bW36-yUIFEiteCDPJL6EJbUvLsSlm-i3GvlSZvBYezmOimeqLXtF9xYuQI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWK5Cxk2ZZK3HlWRBzD7zyZjrn9XikknYeKxyN73rCCw&oe=6AB91474"}, {"file_name": "PlantingRobotPerspective.png", "id": "642920798296171", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_642920801629504_9176832776808441649_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qj9Ap6xw--4Q7kNvwEXYvVK&_nc_oc=AdriaodQV2INk5cjJtfprlq0cHNSF0EVHoEl7BUiEp8wztaYMK1UFYf-i70-QzufMzI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLP89kMZsR6JiLFM7_ecn65h021EmIHUcSMXTX8DBMnpw&oe=6AB92989"}, {"file_name": "AppleTreePerspective.png", "id": "985829762908962", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393438_985829766242295_3021989480068041884_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kMPaRBwqn8Q7kNvwGl_QcI&_nc_oc=Adq4yjLudQj1UYJCpEVWJD4sZxqx6cR_PE3FNEeXj9spZ-PztdRTyyF2lCPFMVVKn5Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2UfvQHXbe-S1ynmPGNDml5Pum_4UZOZ3WDOHAmgkNnw&oe=6AB9373F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MuMu-Video-Still.png", "id": "1515734759792517", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821849_1515734763125850_7576914635659249125_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfJgm-hL0ssQ7kNvwFTrLTh&_nc_oc=AdqSbIk-Rg3yXM7IyuPiTL0mMpO7LsaqgihljULO5WXPfGheQH8OVnrNzyVfbbcCP5k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWTsnscHhRrOsUMmykllWT2e0E6C8XHzYGHmqAwnnR3Q&oe=6AB93B48"}, "display_name": "MuMu: Worlds of Connections", "keywords": ["Multispecies", "Networks", "Science", "Systems", "Farm"], "long_description": "Embark on an extraordinary adventure in MuMu: Worlds of Connections! In the MuMu (the multispecies multiplex), something's gone awry on the farm lab, and your mission, if you dare to accept it, is to maintain the delicate balance of this unique ecosystem while growing an abundant supply of apples for your community. In this mind-bending game, you'll seamlessly switch between the perspectives of a human scientist, an inquisitive prairie dog, a wise apple tree, and an ambitious planting robot. Shrink or grow to experience the world from their eyes, gaining profound insights into different intelligences. As you navigate this immersive journey, you're not just playing a game \u2013 you're honing your skills as a systems thinker, decoding the secrets of planetary health and climate futures. MuMu invites you to see the world through diverse lenses, offering an unparalleled opportunity to become a mastermind of system dynamics.", "short_description": "Something is amiss in the MuMu, the multispecies multiplex...If you\u2019re up for it, your mission is keeping the farm lab system shipshape and cultivating a bounty of apples to share with your community. You can shift between multiple perspectives to navigate the Farm Lab. You will experience MuMu through the eyes of other intelligences. When we start seeing the world through different lenses, we aren\u2019t just playing a game \u2013 we're becoming mastermind systems thinkers, cracking the code of planetary"}]}, "developer_name": "University of Nebraska-Lincoln", "developer_privacy_policy_url": "https://edgeworks.unl.edu/sites/unl.edu.hixson-lied.carson-center.edgeworks/files/media/file/MuMu%20Worlds%20of%20Connections%20Privacy%20Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "University of Nebraska-Lincoln", "support_website_url": null, "website_url": "https://go.unl.edu/wocsepa", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9373228106113628"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1080825240615195"}]}, "baseline_offer": {"id": "1080825240615195"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1761336180, "status": "PUBLISHED", "id": "1080825240615195"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23964121283264402", "version": "2.7"}, "id": "955569426676480", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id
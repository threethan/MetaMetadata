7197950_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7H6LjrPiLIQ7kNvwEz0W9M&_nc_oc=Adry_EsqJKU6v-89qtAvRwdN87KKkSQYalskwW3aGg24x0yirAkL-rHQdRokSF53nuM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOoa5G7PX9MmFUezvDa4xvp792ER2INr2TKSIh8Mk5Fw&oe=6A901AB2"}, {"file_name": "HumanPerspective.png", "id": "1015328340642768", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391878_1015328343976101_6921068176268767536_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WrVTnAGCmEQ7kNvwGb-PTu&_nc_oc=Adr63I3xuRXtFDKOBewzv7FRtbMOpaQeJwcWnu9Xs1Hh83YhdeneVZNpQCRCcilRoaA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8vT16QB2RqL4-PS4wwUggQ-kwRu4vdTa8EbuA74K6rw&oe=6A900D87"}, {"file_name": "OneHealthMatrix.png", "id": "3052918244861419", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392314_3052918248194752_3244924214663061257_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwo7jfoXa6wQ7kNvwHezPYE&_nc_oc=Adp20z43dbkVJdWtSzUGzgK2ByfzzW396UTLTeU4RkyBpDLzzkAlo-4b1gTKheGQS1E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCx_5L0FbbF5n7Dy6VoSRNWB3A4B3p5ANAH-9nX8hzRg&oe=6A9035F4"}, {"file_name": "PlantingRobotPerspective.png", "id": "642920798296171", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391978_642920801629504_9176832776808441649_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z153ZGcB_g4Q7kNvwHIk1vK&_nc_oc=AdrCaLaLeVp4-WQ-zaMfnJ0RhU0lNexfWFdLMC8GYggxWTB5ZuDU1c3l9PR9CBLBuDE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwsGmwTOCpZsGdVWuRzq2JbvpaYxmUNNpnBDoDox7-MA&oe=6A9012C9"}, {"file_name": "AppleTreePerspective.png", "id": "985829762908962", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393438_985829766242295_3021989480068041884_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuMkUTVxxpwQ7kNvwGUHhPq&_nc_oc=AdqyrzwKW8iLZNfYh2PSGBknIvgMgPhpysNs9NDVzA4UhG2S2tv0rTXf6je8aNNZtH4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUVGziCDnMjpOj-ygqCk6IDQ4Xh-JQt2_ZxtLfEweMAw&oe=6A90207F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MuMu-Video-Still.png", "id": "1515734759792517", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821849_1515734763125850_7576914635659249125_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ReDXureBL0Q7kNvwFzittE&_nc_oc=AdrRERzgj5c5bsz2beT_A0VuZLlWi8iHh512L0YVdJrrbLfHcyunQcSnc4qbihhnTe8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGf-sshRJe_zOwXdFsjUb02GfSnZCYrr4TKpskFzZvqg&oe=6A902488"}, "display_name": "MuMu: Worlds of Connections", "keywords": ["Multispecies", "Networks", "Science", "Systems", "Farm"], "long_description": "Embark on an extraordinary adventure in MuMu: Worlds of Connections! In the MuMu (the multispecies multiplex), something's gone awry on the farm lab, and your mission, if you dare to accept it, is to maintain the delicate balance of this unique ecosystem while growing an abundant supply of apples for your community. In this mind-bending game, you'll seamlessly switch between the perspectives of a human scientist, an inquisitive prairie dog, a wise apple tree, and an ambitious planting robot. Shrink or grow to experience the world from their eyes, gaining profound insights into different intelligences. As you navigate this immersive journey, you're not just playing a game \u2013 you're honing your skills as a systems thinker, decoding the secrets of planetary health and climate futures. MuMu invites you to see the world through diverse lenses, offering an unparalleled opportunity to become a mastermind of system dynamics.", "short_description": "Something is amiss in the MuMu, the multispecies multiplex...If you\u2019re up for it, your mission is keeping the farm lab system shipshape and cultivating a bounty of apples to share with your community. You can shift between multiple perspectives to navigate the Farm Lab. You will experience MuMu through the eyes of other intelligences. When we start seeing the world through different lenses, we aren\u2019t just playing a game \u2013 we're becoming mastermind systems thinkers, cracking the code of planetary"}]}, "developer_name": "University of Nebraska-Lincoln", "developer_privacy_policy_url": "https://edgeworks.unl.edu/sites/unl.edu.hixson-lied.carson-center.edgeworks/files/media/file/MuMu%20Worlds%20of%20Connections%20Privacy%20Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "University of Nebraska-Lincoln", "support_website_url": null, "website_url": "https://go.unl.edu/wocsepa", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9373228106113628"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1080825240615195"}]}, "baseline_offer": {"id": "1080825240615195"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1761336180, "status": "PUBLISHED", "id": "1080825240615195"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23964121283264402", "version": "2.7"}, "id": "955569426676480", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id
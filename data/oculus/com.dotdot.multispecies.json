7197950_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94yMmz8iXU8Q7kNvwFgRFCo&_nc_oc=AdoC65PcRqx0Ke22Xl5uC5YG8kj8zrIVyMM09b8HsrJVtyby7n2n9gz4t1W0Y4SWTas&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1o6QSBEldhD1ErLM92_qVWoY2zkGxNXeuXQmBkXeKrpg&oe=69F764F2"}, {"file_name": "HumanPerspective.png", "id": "1015328340642768", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391878_1015328343976101_6921068176268767536_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtgBudJ-jSsQ7kNvwGQq685&_nc_oc=AdoMl2hZOJ7_mD1qAQF_iji1UirkurYPNWQtJB7_tEvVDI6w935TnQgwJbJcDPjgxkA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Xzpc8t-LzoI92BdFR35W4GxUultAFcDCt1sM4BSldGQ&oe=69F757C7"}, {"file_name": "OneHealthMatrix.png", "id": "3052918244861419", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392314_3052918248194752_3244924214663061257_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivB4A3VyefoQ7kNvwHlfK5i&_nc_oc=AdoM8QPTvLLAk9gm7mkd9VGNj8RJYfZfsjzTCCzdDdqvt_lOFJcg-JqNW8hAzZyvkGA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1VDrz6PLbH94zXDtno8vtGYyivervgWvhTF0IQFQ35kQ&oe=69F747F4"}, {"file_name": "PlantingRobotPerspective.png", "id": "642920798296171", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_642920801629504_9176832776808441649_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKv0Kt1F6nQQ7kNvwEl2joS&_nc_oc=AdoWDWnhRmZk_b5tioBx-G4t6e2q79KIHVZuM29TpfDwa8wq0ZX98CM4KKb3Vg2FQGw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af064JRJ2VsMNxjEvQS5-rIzOsB-2o0cD6Bg6QDrP3yEZQ&oe=69F75D09"}, {"file_name": "AppleTreePerspective.png", "id": "985829762908962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393438_985829766242295_3021989480068041884_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSLdnti3eggQ7kNvwE4l7Pn&_nc_oc=AdrJc6OsRQVwRRMlY5BfuySWuJEx45JIQc8u35v3aSA4DkKIbCbLSc8mye46ygOI2Wc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1bKLO6-g3l7gc9rbhK5uZlQ0GSLbLgK_Xk3LCNP3oHiQ&oe=69F76ABF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MuMu-Video-Still.png", "id": "1515734759792517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821849_1515734763125850_7576914635659249125_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GROnx2glhx4Q7kNvwHJUGd_&_nc_oc=Adok38rNE8VgwB4xwc07uhzI7Cv0FGKvSPYQGaVtI4kvc39hNRAXk50O69qnW7V1W7E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af02gbbpZArRX2UGJV4IEWsbkbFBWtrXzufnYWW32arDXg&oe=69F73688"}, "display_name": "MuMu: Worlds of Connections", "keywords": ["Multispecies", "Networks", "Science", "Systems", "Farm"], "long_description": "Embark on an extraordinary adventure in MuMu: Worlds of Connections! In the MuMu (the multispecies multiplex), something's gone awry on the farm lab, and your mission, if you dare to accept it, is to maintain the delicate balance of this unique ecosystem while growing an abundant supply of apples for your community. In this mind-bending game, you'll seamlessly switch between the perspectives of a human scientist, an inquisitive prairie dog, a wise apple tree, and an ambitious planting robot. Shrink or grow to experience the world from their eyes, gaining profound insights into different intelligences. As you navigate this immersive journey, you're not just playing a game \u2013 you're honing your skills as a systems thinker, decoding the secrets of planetary health and climate futures. MuMu invites you to see the world through diverse lenses, offering an unparalleled opportunity to become a mastermind of system dynamics.", "short_description": "Something is amiss in the MuMu, the multispecies multiplex...If you\u2019re up for it, your mission is keeping the farm lab system shipshape and cultivating a bounty of apples to share with your community. You can shift between multiple perspectives to navigate the Farm Lab. You will experience MuMu through the eyes of other intelligences. When we start seeing the world through different lenses, we aren\u2019t just playing a game \u2013 we're becoming mastermind systems thinkers, cracking the code of planetary"}]}, "developer_name": "University of Nebraska-Lincoln", "developer_privacy_policy_url": "https://edgeworks.unl.edu/sites/unl.edu.hixson-lied.carson-center.edgeworks/files/media/file/MuMu%20Worlds%20of%20Connections%20Privacy%20Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "University of Nebraska-Lincoln", "support_website_url": null, "website_url": "https://go.unl.edu/wocsepa", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9373228106113628"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1080825240615195"}]}, "baseline_offer": {"id": "1080825240615195"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1761336180, "status": "PUBLISHED", "id": "1080825240615195"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23964121283264402", "version": "2.7"}, "id": "955569426676480", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id
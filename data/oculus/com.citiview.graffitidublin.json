569_1577572084143914_4536430381564864393_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTkkxO-ptZYQ7kNvwG0zuoW&_nc_oc=Adr7gB-iUIS5XSdsg51D-QNATnJzuMVroQ-yRoVF8pi54UE713kfv-J8t2q9HaFlnNo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhAaOzIgaecYc6fnQOehVDzOQy6-bYK9FT9g2F6u9Erg&oe=6AFDBAF2"}, {"file_name": "screenshot_2.png", "id": "1069199972557554", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596149727_1069199975890887_2623754535446193391_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJ9d5dLUuBwQ7kNvwEAYpts&_nc_oc=Adr9fj_dq8AXtVVj_t2taRu_c0JVE36iWLfrJpnKIJLEtlsWFdeRsC0uuusgGe-Myog&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJ_3rQDU0rhX534MFtTV4WG6s5xnL8y489ZHqpdxnMUQ&oe=6AFDC9E7"}, {"file_name": "screenshot_4.png", "id": "1877798259858238", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831393_1877798263191571_44824919329680529_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zq2_rnunii4Q7kNvwHU05DW&_nc_oc=AdpkpqVGbADxwhtpOBr440M8S_9hcEQpDX-jPm3QNEutvzHBhyJ4jDrzjdpV5l2xj5s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzrYWhqvqeqwUxCOXuHSLLaIhewszwraMvESyy8hb5PQ&oe=6AFDE231"}, {"file_name": "screenshot_3.png", "id": "1078282008450549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673658581_1078282011783882_7786951436899184955_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dgQZvRM7YgQ7kNvwHgwKuo&_nc_oc=AdosESuDck7lSuHXb3_zRK8OaRhCoEc1C8yGq1bMnOzXSp2ktG0Yzu-k_cuScP_DFxs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoYpIjhFxD4f9kp7C8QILk985XojR2tJJBLUpq1czu5w&oe=6AFDDDB0"}, {"file_name": "screenshot_5.png", "id": "4384344975210595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831299_4384344978543928_8544229218356215460_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqmn20M4Jk0Q7kNvwFqmmKl&_nc_oc=AdpTU53Av-eimEKkUSpA51tBYh22npDav7ioQwZ3TAaqoye2Bhq4dXxqc1q_KT1YLfs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaOhqRbDPbuRUzYxEvSoXDtufjy4S3qMrcFjGFmyicZg&oe=6AFDBADE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1790135242030002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604385997_1790135245363335_6515360136783895757_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GSjSEHV-GkQ7kNvwES10aj&_nc_oc=AdrWz3P4X2cKw3LqyA9OdzNMzUnCSahbHgUIXCU7fy4Yz63xxrG2Vc5aQXN_ZXV5CsY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRzfkPJNoTNK_3vqNLm0t_Dh-KV-q9jUq9m1CBsnASWQ&oe=6AFDD0A9"}, "display_name": "Graffiti Dublin", "keywords": ["graffiti", "dublin", "painting", "art", "sandbox"], "long_description": "Graffiti Dublin takes your spray cans to the walls every writer in Dublin knows.\n\nFOUR DUBLIN PLACES\n- THE TIVOLI: the Liberties car park whose walls are the city's hall of fame, in a bright spell between showers with a rainbow over the roofs and the cathedral spire behind.\n- DOCKLANDS: North Wall Quay at night. The old stone dock store with its bricked-up arches, the harp bridge lit white over the Liffey, a tall ship at the quay and the red crane on its plinth.\n- GEORGIAN MEWS: a cobbled lane behind a Georgian square at golden hour. Brick garden walls, old coach houses and, at the end of the lane, the red, green, blue and yellow doors.\n- SEA BATHS: the derelict sea baths at sunset. The white pavilion, the changing cubicles and the granite bastion, with the bay, the pier lighthouse and the striped chimneys on the horizon.\n\nTHE CITY IS ALIVE\nPeople stroll the quays, chat in the lane and stop to look at your work. Buses, cars, a river cruiser, swans, sailboats and the ferry keep Dublin moving around you.\n\nPAINT IT\nEight CITIVIEW spray cans, skinny, medium and fat caps, 32 stencils including A to Z, real mist and drips on 20 walls of Dublin red brick, granite and white render. Take a photo of your piece and switch places from the menu.", "short_description": "Spray paint the walls of Dublin. Bomb the hall of fame at the Tivoli under a rainbow, the old dock store arches on the Liffey at night by the harp bridge, the garden walls of a Georgian mews at golden hour and the derelict sea baths at sunset. Four real Dublin places, alive with people."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/graffitidublin/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/graffitidublin/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1380049821858220"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1385269058002963", "version": "1.0.1"}, "id": "1768206601050265", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "138004981185
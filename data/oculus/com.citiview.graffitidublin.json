NvwE9StMW&_nc_oc=AdorQUsrk_mlJcupagRJjKmcg_vsjuODXm2r4vzNKskFTTX5P0m6COd5AVQsgE6jUbs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTi6oY7sNLDGvSO5vZbJe9R-WIZfgv8Droi8kqUNJTxtw&oe=6B005DDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1790135242030002", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604385997_1790135245363335_6515360136783895757_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5fNGezrNUQQ7kNvwHxKgZc&_nc_oc=Adr8Pr9a4ssaNzQfXGnWIkps5UoofqsW1COJg1e-63g5_CSlFXBku4kAteJz-_ZV430&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoiZ7N-XPe90f5I1cIJVLbEtGchgHJhcUbCPb23xBmNg&oe=6B0073A9"}, "display_name": "Graffiti Dublin", "keywords": ["graffiti", "dublin", "painting", "art", "sandbox"], "long_description": "Graffiti Dublin takes your spray cans to the walls every writer in Dublin knows.\n\nFOUR DUBLIN PLACES\n- THE TIVOLI: the Liberties car park whose walls are the city's hall of fame, in a bright spell between showers with a rainbow over the roofs and the cathedral spire behind.\n- DOCKLANDS: North Wall Quay at night. The old stone dock store with its bricked-up arches, the harp bridge lit white over the Liffey, a tall ship at the quay and the red crane on its plinth.\n- GEORGIAN MEWS: a cobbled lane behind a Georgian square at golden hour. Brick garden walls, old coach houses and, at the end of the lane, the red, green, blue and yellow doors.\n- SEA BATHS: the derelict sea baths at sunset. The white pavilion, the changing cubicles and the granite bastion, with the bay, the pier lighthouse and the striped chimneys on the horizon.\n\nTHE CITY IS ALIVE\nPeople stroll the quays, chat in the lane and stop to look at your work. Buses, cars, a river cruiser, swans, sailboats and the ferry keep Dublin moving around you.\n\nPAINT IT\nEight CITIVIEW spray cans, skinny, medium and fat caps, 32 stencils including A to Z, real mist and drips on 20 walls of Dublin red brick, granite and white render. Take a photo of your piece and switch places from the menu.", "short_description": "Spray paint the walls of Dublin. Bomb the hall of fame at the Tivoli under a rainbow, the old dock store arches on the Liffey at night by the harp bridge, the garden walls of a Georgian mews at golden hour and the derelict sea baths at sunset. Four real Dublin places, alive with people."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/graffitidublin/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/graffitidublin/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1380049821858220"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1385269058002963", "version": "1.0.1"}, "id": "1768206601050265", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "138004981185
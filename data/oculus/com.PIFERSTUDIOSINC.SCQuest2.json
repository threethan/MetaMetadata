ooming presence confronts you.", "short_description": "An unknown force has pulled you to the Citadel's location and beckons you to enter. Unique traps and puzzles await you on every floor with a variety of obstacles intent on stopping you. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://shroudedcitadel.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pifer Studios INC", "support_website_url": "https://shroudedcitadel.com/support", "website_url": "https://shroudedcitadel.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2726595584152607"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5502682829760066", "version": "1.0.27"}, "id": "4709929289095551", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5342829222412095", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5502682829760066"}, "release_status": "RELEASED"}, "bina
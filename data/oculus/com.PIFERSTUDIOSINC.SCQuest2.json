GOJepK4kartHboFrdBSy05CA&oe=69AD6C4A"}, "display_name": "Shrouded Citadel", "keywords": [], "long_description": "An unknown force has pulled you to the Citadel's location and beckons you to enter. Unique traps and puzzles await you on every floor with a variety of obstacles intent on stopping you. While inside, you'll discover entities which will try to help you and others attempting to prevent your escape. Upon entering you'll find a plasma cannon that will give you access to puzzles and the means to defend yourself. It will pack a punch but you should choose your shots carefully, especially when a looming presence confronts you.", "short_description": "An unknown force has pulled you to the Citadel's location and beckons you to enter. Unique traps and puzzles await you on every floor with a variety of obstacles intent on stopping you. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://shroudedcitadel.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pifer Studios INC", "support_website_url": "https://shroudedcitadel.com/support", "website_url": "https://shroudedcitadel.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2726595584152607"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.c
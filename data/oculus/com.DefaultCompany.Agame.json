tures, each designed to unsettle you with their grotesque appearance and unpredictable hunting patterns.", "short_description": "In this VR horror tag game, you\u2019re hunted by terrifying monsters inside a nightmarish virtual world. Instead of being chased by another player, you\u2019re pursued by horrifying AI-controlled creatures that stalk you through a creepy facility."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vSoYuZ18jqY5-haKiJlg5QdtJ6a_G0IR9kG2szdQ2R8mLCw7iogS-AdHt6SrBBsTN8mL7YnZLCkfvFo/pub", "developer_terms_of_service_url": null, "publisher_name": "Mi3t", "support_website_url": null, "website_url": "https://docs.google.com/document/d/e/2PACX-1vSoYuZ18jqY5-haKiJlg5QdtJ6a_G0IR9kG2szdQ2R8mLCw7iogS-AdHt6SrBBsTN8mL7YnZLCkfvFo/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9954762801301840"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1186821766793828"}]}, "baseline_offer": {"id": "1186821766793828"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1751989800, "status": "PUBLISHED", "id": "1186821766793828"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "10062012913910161", "version": "0.2"}, "id": "1418415582690797", "channel_name": "LIVE"}]}, "is_for_oculus
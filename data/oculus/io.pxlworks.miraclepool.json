ri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830016_1217563043257311_627551563662513465_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svIBC8DShNkQ7kNvwHhRTP3&_nc_oc=AdpG3qdLbVd3p5ln45czyKCdwLTfgbnfW-uJgfWNCOw090V8h2gnyjp53Yvg8wNWFeQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaaCTKThNO5d8MA1WjoiBwrC5XH27PcYtdruio2orblg&oe=6ABA59E7"}, {"file_name": "screenshot_2560x1440_2.png", "id": "1414360939452348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974719_1414360949452347_6770228246441099459_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8uUQVVTzjUQ7kNvwG_SPAF&_nc_oc=AdqKcBjSVLVky_o0BCOHUUPaIklyBPPtYAl9d5eATbyiz3mGb4pyG_QJh2IqauHuYOU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILjLXitfx9dEHwQvPOBA60nAY4bMBnN2d3MUEkZdtilQ&oe=6ABA7FC3"}, {"file_name": "4new.png", "id": "2754049981470603", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296890_2754049984803936_4349542949881499411_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsymzzr7gx4Q7kNvwFEcYCc&_nc_oc=AdoKh2BMrBi_m88kx_Rg_S_j7WYcgr9tcK3tRFqTzjKMLJXxHbBoPzGrrV53TjTzZkc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImRiT-kguuWk9xTWTTQq1SGVi4C3nTND6mnNbXDHWO2A&oe=6ABA845A"}, {"file_name": "screenshot_2560x1440_5.png", "id": "744323157573568", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003251_744323160906901_5798487003663739391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJaA7bgMT40Q7kNvwFgp60Z&_nc_oc=Adphie3HzBv34JXus2dkTCAg5oTHBygCHnVNMs2BVOAYDhr4yK--6TDHtg5wm6PaFxE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbVDyIFkVK6IRltHDfoXC48xjnuy0k-Yzk8RVVPrLWdQ&oe=6ABA812C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560.png", "id": "1108118338355470", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_1108118341688803_1110359635809579517_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8CZnFK-oSMQ7kNvwEgwbrR&_nc_oc=AdpsGLlNzMrJ23aK51KwvCS7ltOKL4xHn9XM1WooxtCIH_RkkRcpr1xsIBoxTCyjZxI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQt8rAfTrUMFpFDmW7-tdfSEjPjAJu7wKV5CpRlOc9fg&oe=6ABA78EE"}, "display_name": "MiRacle Pool", "keywords": ["pool", "billiards", "snooker", "mixedreality", "sports"], "long_description": "# \ud83c\udfb1 VR's #1 Pool Simulator \ud83c\udfb1\n\nThe Premier Pool Simulator with the most realistic ball physics and easy cue stick handling, all made for mixed reality! Game Modes include: Single Player, Multiplayer, Private Matches, Mini Games, Daily Challenges and Practice Mode. Earn XP, rank up and unlock new table designs, balls, cues and more! Play in any size room you have, even sitting down!\n \n\u2795 **Real Ball Physics:** We spent 3+ years refining the most realistic billiards physics engine.\n\n{1124006418819324}\n\n\ud83c\udfaf **Easy Cue Stick Handling:** Learn fast with our intuitive aim, lock and shoot mechanic.\n\n{1001068208402916}\n\n\ud83d\udcf8 **Mixed Reality & Virtual Reality:** Pool is best played in MR. Confidently move through your real room to line up the perfect shot. If you prefer VR, we have that too!\n\n{1032858358985417}\n\n\ud83d\udcdc **Game Modes:**\n- Ranked Online Multiplayer (8-Ball, 9-Ball, Mini Snooker and British Rules)\n- Single Player Matches\n- Private Matches with Friends\n- Daily Challenges\n- Practice Mode\n- Mini Games with Leaderboards. Level up the fun in a series of challenges meant to test your skill.\n\n\ud83d\udcc8 Progression: Earn XP, rank up and unlock new table designs, balls, cues and more! Also improve your competitive rating with multiplayer matches.\n\n# Common Questions:\n\n**Tight on space?**\n\nNo problem - rotate/move the table with your joysticks. Even play MiRacle Pool lying in bed!\n\n**Don\u2019t I need to place my hand on the table?**\n\nNope! Just lock your aim and shoot. You won\u2019t believe how easy it is.\n\n**Is Meta Quest 2 compatible?**\n\nYes!", "short_description": "\ud83c\udfb1 VR's #1 Pool Simulator with the most realistic ball physics and easy cue stick handling, all made for mixed reality! Game Modes include: Single Player, Multiplayer, Private Matches, Mini Games, Daily Challenges and Practice Mode. Earn XP, rank up and unlock new table designs, balls, cues and more! Play in any size room you have!"}]}, "developer_name": "Pixel Works Studios", "developer_privacy_policy_url": "https://www.pxlworks.io/mrpt_pp", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": "https://miraclepoolvr.com/discord", "website_url": "https://www.pxlworks.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28045296911805937"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823901_1786710109018980_4521036857833350385_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxUpEH_-NBEQ7kNvwHBylcf&_nc_oc=Adoc5RwFQhYUXiYWGXXDgdT8ggLjHXQ56E3W0qMLOGuUVdOOybv0KJvW1YBkzlvJZSs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnZEylWwTvKVXdSRB6jOrJDMMeTlcF73dpZ7Zp4L7nbw&oe=6ABA6995"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MiRacle Pool", "platform": "ANDROID_6DOF", "context_category
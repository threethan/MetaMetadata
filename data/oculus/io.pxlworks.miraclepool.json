891_1122048159033571_2021025576069907951_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNNP2ct3818Q7kNvwEyoMOx&_nc_oc=AdqrUKPJp6Om11Z1Ss69orcd9gzHdCx8GZFlMJ-an9kiIBG-L15o9VJMw3Ld_Sv2WlA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WGCCNufvMmNir8ULb5tbaEVIRiUMsWP_0rfhm1iv2DQ&oe=6A107B6C"}, {"file_name": "screenshot_2560x1440_4.png", "id": "1807334429780077", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75556793_1807334433113410_2985186037007543996_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Px0HICgLhSgQ7kNvwFMArQU&_nc_oc=AdoWfRAkhafaOtvQAFTJ0nYXFmdQt-V2kf1k5Ij_wVhIsPKOGRQmWKbk3J12pfYLzlc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uVkwVXFQgWDr7akdEIaN8rJYeL7MJXel5gknlbEL8Eg&oe=6A10526E"}, {"file_name": "screenshot_2560x1440_5.png", "id": "744323157573568", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39003251_744323160906901_5798487003663739391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPdq69rLGO8Q7kNvwGWqKoP&_nc_oc=Adojgr20bbcWecq0Vkl9Xk1h4lY29jv0yZPaw1ZDlu9EIexM9Gcgf4L6QFmQ16b5PdI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dk188OeBaBNe_924TClUj-AWYz8vYqz6FsrH6x6KyYA&oe=6A106FAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_fullcolor_nowire (1).png", "id": "3252273601748845", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39036653_3252273605082178_8383279951084724634_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8aP6KR5LrMQ7kNvwGbN2e6&_nc_oc=Adqr4j-Dru8Iel0Qc767yjTkZ6QRNyuwUDQqtyhspTL85L_5kWys9DR9XD_kvU2ICmY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ojj7nAJgB2_RqrRbZQaLkbGR0BnXG1Fd-kZ0p0UN1VQ&oe=6A10491C"}, "display_name": "MiRacle Pool", "keywords": ["pool", "billiards", "snooker", "sport", "mixedreality"], "long_description": "# \ud83c\udfb1The Premier Pool Simulator\ud83c\udfb1\n\n\n \n\u2795**Real Ball Physics:** We spent 3+ years refining the most realistic billiards physics engine.\n\n{1124006418819324}\n\n\ud83c\udfaf**Easy Cue Stick Handling:** Learn fast with our intuitive aim, lock and shoot mechanic.\n\n{1001068208402916}\n\n\ud83d\udcf8**Mixed Reality:** Pool is best played in MR. Confidently move through your real room to line up the perfect shot.\n\n{994770628741624}\n\n\ud83d\udcdc **Game Modes:**\n- Ranked Online Multiplayer\n- Single Player Matches\n- Private Matches with Friends\n- Mini Games with Leaderboards\n- Daily Challenges\n- Practice Mode\n\n\ud83d\udcc8Progression: Earn XP, rank up and unlock new table designs, balls, cues and more! Also improve your competitive rating with multiplayer matches.\n\n# Common Questions:\n\n**Will the table fit in my small room?**\n\nA smaller table option is available! Also rotate and move the table easily. You can even play seated!\n\n**Don\u2019t I need to place my hand on the table?**\n\nNope! Just lock your aim and shoot. You won\u2019t believe how easy it is.\n\n\n**Is Quest 2 compatible?**\n\nYes!\n\n**Where can I join the MiRacle Pool Discord Community?** \n\nSee link in additional details\n\n**Will this improve my real world pool skills?**\n\nWe sure think so! Thanks to realistic physics for unlimited practice reps of learning angles, shot selection, strategy, etc.\n", "short_description": "\ud83c\udfb1The Premier Pool Simulator with the most realistic ball physics and easy cue stick handling, all made for mixed reality! Game Modes include: Single Player, Multiplayer, Private Matches, Mini Games, Daily Challenges and Practice Mode. Earn XP, rank up and unlock new table designs, balls, cues and more! Play in any size room you have (or even seated!)"}]}, "developer_name": "Pixel Works Studios", "developer_privacy_policy_url": "https://www.pxlworks.io/mrpt_pp", "developer_terms_of_service_url": null, "publisher_name": "Pixel Works Studios", "support_website_url": "https://miraclepoolvr.com/discord", "website_url": "https://www.pxlworks.io/", "category": null, "
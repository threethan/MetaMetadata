459_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eqh1uHUK9AIQ7kNvwGDx9hA&_nc_oc=AdpXDnHVmNi43BrQfKeT0Z9BbovRCK32svpny5r307XO-dPQ5uOQJLAkPPjgDTm6DW0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiKd1EiNfw7bA0aBS24g6sHqZJf-RMnWojVg2dsW8BmA&oe=6AFDBC43"}, {"file_name": "screenshot_2560x1440_3.png", "id": "1122048155700238", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974891_1122048159033571_2021025576069907951_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Shr257VN3H0Q7kNvwH_u2bk&_nc_oc=AdqZcvtHR4pD712oE3pgkhIAZmQzmloK_GPs_I5pU0KAjLzEIZjzd-9ZALDnzAKwLZ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0tzylk36JgQu7ohhoSm-xBtQTfR2vCs1ZOYD0fTeFhw&oe=6AFDC96C"}, {"file_name": "screenshot_2560x1440_4.png", "id": "1807334429780077", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556793_1807334433113410_2985186037007543996_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t12wc53Xp7cQ7kNvwGBqjMN&_nc_oc=Adp8J51uHZBefTlzi-W3F47yHb7b03RWSbqsdTzWTego4Fo_CiWGsRD8dnO4LZ5Xwd8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdmNBbTktoqc30e5Fvqy1SU8WflDkkD_A53BGXfEjGgw&oe=6AFDD8AE"}, {"file_name": "screenshot_2560x1440_5.png", "id": "744323157573568", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003251_744323160906901_5798487003663739391_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoLYIyuPIrEQ7kNvwFkDLMh&_nc_oc=AdpOrCT3Jt5wg6Z6-W4Dq8wFDDrZQ7cEoXqYRl24vsavF0i0G-o3lByDqzDsZwP9Hj4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT41fS0R2OZXp5rKZGvo-ThQIQ0b5soXnBHxD9bUBnwig&oe=6AFDBDAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_fullcolor_nowire (1).png", "id": "3252273601748845", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036653_3252273605082178_8383279951084724634_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUQMOxteNF4Q7kNvwFNiE6p&_nc_oc=AdpqtGrEfmsywLN0mEeU7qRctJgtanwTlpM5XSUJASgJEIzIh6dDiogccOWWHVIB524&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4-e2IzrA0Mb5I6FSenlE7rzUSFEbtdQ_gCK2hU5Kwiw&oe=6AFDCF5C"}, "display_name": "MiRacle Pool", "keywords": ["pool", "billiards", "snooker", "sport", "mixedreality"], "long_description": "# \ud83c\udfb1The Premier Pool Simulator\ud83c\udfb1\n\n\n \n\u2795**Real Ball Physics:** We spent 3+ years refining the most realistic billiards physics engine.\n\n{1124006418819324}\n\n\ud83c\udfaf**Easy Cue Stick Handling:** Learn fast with our intuitive aim, lock and shoot mechanic.\n\n{1001068208402916}\n\n\ud83d\udcf8**Mixed Reality:** Pool is best played in MR. Confidently move through your real room to line up the perfect shot.\n\n{994770628741624}\n\n\ud83d\udcdc **Game Modes:**\n- Ranked Online Multiplayer\n- Single Player Matches\n- Private Matches with Friends\n- Mini Games with Leaderboards\n- Daily Challenges\n- Practice Mode\n\n\ud83d\udcc8Progression: Earn XP, rank up and unlock new table designs, balls, cues and more! Also improve your competitive rating with multiplayer matches.\n\n# Common Questions:\n\n**Will the table fit in my small room?**\n\nA smaller table option is available! Also rotate and move the table easily. You can even play seated!\n\n**Don\u2019t I need to place my hand on the table?**\n\nNope! Just lock your aim and shoot. You won\u2019t believe how easy it is.\n\n\n**Is Quest 2 compatible?**\n\nYes!\n\n**Where can I join the MiRacle Pool Discord Community?** \n\nSee link in additional details\n\n**Will this improve my real world pool skills?**\n\nWe sure think so! Thanks to realistic physics for unlimited practice reps of learning angles, shot selection, strategy, etc.\n", "short_description": "\ud83c\udfb1The Premier Pool Simulator with the most realistic ball physics and easy cue stick handling, all made for mixed reality! Game Modes include: Single Player, Multiplayer, Private Matches, Mini Games, Daily Challenges and Practice Mode. Earn XP, rank up and unlock new table designs, balls, cues and more! Play in any size room you have (or even seated!)"}]}, "developer_name": "Pixel Works Studios", "developer_privacy_policy_url": "https://www.pxlworks.io/mrpt_pp", "developer_terms_of_service_url": null, "publisher_name": "Pixel Works Studios", "support_website_url": "https://miraclepoolvr.com/discord", "website_url": "https://www.pxlworks.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7659131797515748"}}]}, "scheduled_offers": {"count": 18, "nodes": [{"status": "PUBLISHED", "id": "1001541848920636"}, {"status": "PUBLISHED", "id": "1433149911479846"}, {"status": "PUBLISHED", "id": "2323293631814649"}, {"status": "PUBLISHED", "id": "1243989584475299"}, {"status": "PUBLISHED", "id": "1250719090276717"}, {"status": "PUBLISHED", "id": "1362845865589587"}, {"status": "PUBLISHED", "id": "1336033838319020"}, {"status": "PUBLISHED", "id": "849082697689363"}, {"status": "PUBLISHED", "id": "1102181758550868"}, {"status": "PUBLISHED", "id": "684668504022698"}, {"status": "PUBLISHED", "id": "617840161107094"}, {"status": "PUBLISHED", "id": "1254567405604591"}, {"status": "PUBLISHED", "id": "603058472277492"}, {"status": "PUBLISHED", "id": "806598918354315"}, {"status": "PUBLISHED", "i
891_1122048159033571_2021025576069907951_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqQRgnI_z6cQ7kNvwGZ2YpV&_nc_oc=AdqEPVt4sLso_-UMPyefWRlg3vQmj2GlvZV5L5KebwDhvQQ3uEixxdJ9Jkd64kNkHBA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HIwjcz3p0U1fHVyp5AUL-Y2DkksMEkjOibqhhQ4Vjig&oe=6A1C58EC"}, {"file_name": "screenshot_2560x1440_4.png", "id": "1807334429780077", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75556793_1807334433113410_2985186037007543996_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybTytLNQIaMQ7kNvwGPzUmV&_nc_oc=Adq0XkpFlDyzUabFtdrgTqrNoIfsJywnvFCGEEAadMIU6dOg8lCml5YpwqogrKDbMmU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xzZ07uZVSNHEmIfGkajNOuZXL3bjfxLPY4BX7dilnwA&oe=6A1C2FEE"}, {"file_name": "screenshot_2560x1440_5.png", "id": "744323157573568", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003251_744323160906901_5798487003663739391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6MUHxP2gnIQ7kNvwGLl4mP&_nc_oc=Adqlc6Tff4Osmy2WAlskrvTr7Kh5FxxYCjvBD8j0suVhhe0iB8tido6NB3U7UXTN7FA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5x1imBFvZ-scL2cylscZeSnbMn98A_USKWi5-xCw5U5g&oe=6A1C4D2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_fullcolor_nowire (1).png", "id": "3252273601748845", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036653_3252273605082178_8383279951084724634_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWEJ4JJBRP0Q7kNvwEr650v&_nc_oc=AdoomVChlhWngxTKr2XyiPVaCoEVGyOPgC8ds0c2RilW2rUlctDRJAIkYKv3bNqimvM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TtJ1XW2Kms4HD0gCMgjOSU6Vs49y7uXZSm1ElKw-45Q&oe=6A1C5EDC"}, "display_name": "MiRacle Pool", "keywords": ["pool", "billiards", "snooker", "sport", "mixedreality"], "long_description": "# \ud83c\udfb1The Premier Pool Simulator\ud83c\udfb1\n\n\n \n\u2795**Real Ball Physics:** We spent 3+ years refining the most realistic billiards physics engine.\n\n{1124006418819324}\n\n\ud83c\udfaf**Easy Cue Stick Handling:** Learn fast with our intuitive aim, lock and shoot mechanic.\n\n{1001068208402916}\n\n\ud83d\udcf8**Mixed Reality:** Pool is best played in MR. Confidently move through your real room to line up the perfect shot.\n\n{994770628741624}\n\n\ud83d\udcdc **Game Modes:**\n- Ranked Online Multiplayer\n- Single Player Matches\n- Private Matches with Friends\n- Mini Games with Leaderboards\n- Daily Challenges\n- Practice Mode\n\n\ud83d\udcc8Progression: Earn XP, rank up and unlock new table designs, balls, cues and more! Also improve your competitive rating with multiplayer matches.\n\n# Common Questions:\n\n**Will the table fit in my small room?**\n\nA smaller table option is available! Also rotate and move the table easily. You can even play seated!\n\n**Don\u2019t I need to place my hand on the table?**\n\nNope! Just lock your aim and shoot. You won\u2019t believe how easy it is.\n\n\n**Is Quest 2 compatible?**\n\nYes!\n\n**Where can I join the MiRacle Pool Discord Community?** \n\nSee link in additional details\n\n**Will this improve my real world pool skills?**\n\nWe sure think so! Thanks to realistic physics for unlimited practice reps of learning angles, shot selection, strategy, etc.\n", "short_description": "\ud83c\udfb1The Premier Pool Simulator with the most realistic ball physics and easy cue stick handling, all made for mixed reality! Game Modes include: Single Player, Multiplayer, Private Matches, Mini Games, Daily Challenges and Practice Mode. Earn XP, rank up and unlock new table designs, balls, cues and more! Play in any size room you have (or even seated!)"}]}, "developer_name": "Pixel Works Studios", "developer_privacy_policy_url": "https://www.pxlworks.io/mrpt_pp", "developer_terms_of_service_url": null, "publisher_name": "Pixel Works Studios", "support_website_url": "https://miraclepoolvr.com/discord", "website_url": "https://www.pxlworks.io/", "category": null, "
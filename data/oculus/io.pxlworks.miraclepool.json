459_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eqh1uHUK9AIQ7kNvwEFGuSQ&_nc_oc=AdpwDkGDoDAtCL3Wc4Bl3jySkjdVM-fp0NERlMIqTMVen9fHshT4_WyZz_vY1jeH7tQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9f5lGNZ5sgn3SRWWllJs9xog0xfHGPriIj7ZilkrIVA&oe=6AFC6AC3"}, {"file_name": "screenshot_2560x1440_3.png", "id": "1122048155700238", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974891_1122048159033571_2021025576069907951_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9OM7HnK1EIQ7kNvwG5t8em&_nc_oc=Adp4QnecGskd_hNsn1CfQwq7gghmtu_kAZJ90X72yuZ6Wg60BOavSSQg3jBVbvZCZKo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_Wdg06BJ-ruPEEdbPxWIc8A4G44nhn476aP8dHCmq0A&oe=6AFC77EC"}, {"file_name": "screenshot_2560x1440_4.png", "id": "1807334429780077", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75556793_1807334433113410_2985186037007543996_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWtMktPgtegQ7kNvwHByMqE&_nc_oc=AdqugJm8leXVr5v7AoxiRyX9K5fZkMmcWFR0i4T2DJYsABKnxa5TdZI-eGE_yl0CUhI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQu69q4AqIis6ByML806mjhqIIc7ZazWu_HRcoVMVHWJw&oe=6AFC872E"}, {"file_name": "screenshot_2560x1440_5.png", "id": "744323157573568", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003251_744323160906901_5798487003663739391_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoLYIyuPIrEQ7kNvwGqYnsN&_nc_oc=AdrI-ZDE8zUnuwIdt9-Nq9QTWfja1C7goAv_0Nmscp8QVHJf_l8AMHRffNRSoK_BKb8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiXjKqR3-1i5birPxsAK414V-rzvIFkcIO4SdywT78Tw&oe=6AFC6C2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_fullcolor_nowire (1).png", "id": "3252273601748845", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036653_3252273605082178_8383279951084724634_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUQMOxteNF4Q7kNvwHrNwwb&_nc_oc=AdpeoHc8LT2E-lFNYgLiMUSkdJ36MBGiCAOe9_82fbXWD2I5mpBOWwsZFC-OS2KD-Tg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfuRL8g5xxHYqCyM34xyHQfwHPG1zXFaCWMknLpDj1ag&oe=6AFC7DDC"}, "display_name": "MiRacle Pool", "keywords": ["pool", "billiards", "snooker", "sport", "mixedreality"], "long_description": "# \ud83c\udfb1The Premier Pool Simulator\ud83c\udfb1\n\n\n \n\u2795**Real Ball Physics:** We spent 3+ years refining the most realistic billiards physics engine.\n\n{1124006418819324}\n\n\ud83c\udfaf**Easy Cue Stick Handling:** Learn fast with our intuitive aim, lock and shoot mechanic.\n\n{1001068208402916}\n\n\ud83d\udcf8**Mixed Reality:** Pool is best played in MR. Confidently move through your real room to line up the perfect shot.\n\n{994770628741624}\n\n\ud83d\udcdc **Game Modes:**\n- Ranked Online Multiplayer\n- Single Player Matches\n- Private Matches with Friends\n- Mini Games with Leaderboards\n- Daily Challenges\n- Practice Mode\n\n\ud83d\udcc8Progression: Earn XP, rank up and unlock new table designs, balls, cues and more! Also improve your competitive rating with multiplayer matches.\n\n# Common Questions:\n\n**Will the table fit in my small room?**\n\nA smaller table option is available! Also rotate and move the table easily. You can even play seated!\n\n**Don\u2019t I need to place my hand on the table?**\n\nNope! Just lock your aim and shoot. You won\u2019t believe how easy it is.\n\n\n**Is Quest 2 compatible?**\n\nYes!\n\n**Where can I join the MiRacle Pool Discord Community?** \n\nSee link in additional details\n\n**Will this improve my real world pool skills?**\n\nWe sure think so! Thanks to realistic physics for unlimited practice reps of learning angles, shot selection, strategy, etc.\n", "short_description": "\ud83c\udfb1The Premier Pool Simulator with the most realistic ball physics and easy cue stick handling, all made for mixed reality! Game Modes include: Single Player, Multiplayer, Private Matches, Mini Games, Daily Challenges and Practice Mode. Earn XP, rank up and unlock new table designs, balls, cues and more! Play in any size room you have (or even seated!)"}]}, "developer_name": "Pixel Works Studios", "developer_privacy_policy_url": "https://www.pxlworks.io/mrpt_pp", "developer_terms_of_service_url": null, "publisher_name": "Pixel Works Studios", "support_website_url": "https://miraclepoolvr.com/discord", "website_url": "https://www.pxlworks.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7659131797515748"}}]}, "scheduled_offers": {"count": 18, "nodes": [{"status": "PUBLISHED", "id": "1001541848920636"}, {"status": "PUBLISHED", "id": "1433149911479846"}, {"status": "PUBLISHED", "id": "2323293631814649"}, {"status": "PUBLISHED", "id": "1243989584475299"}, {"status": "PUBLISHED", "id": "1250719090276717"}, {"status": "PUBLISHED", "id": "1362845865589587"}, {"status": "PUBLISHED", "id": "1336033838319020"}, {"status": "PUBLISHED", "id": "849082697689363"}, {"status": "PUBLISHED", "id": "1102181758550868"}, {"status": "PUBLISHED", "id": "684668504022698"}, {"status": "PUBLISHED", "id": "617840161107094"}, {"status": "PUBLISHED", "id": "1254567405604591"}, {"status": "PUBLISHED", "id": "603058472277492"}, {"status": "PUBLISHED", "id": "806598918354315"}, {"status": "PUBLISHED", "i
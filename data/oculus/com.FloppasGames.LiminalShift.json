ayer"], "long_description": "Build your base during the day to secure a safe haven, craft barricades, and prepare for the night. The main generator powers electric doors and lights if it fails, the rooms go dark and monsters become more dangerous. Restore it quickly or risk being hunted.\n\nFace relentless monsters that stalk you in the shadows. Plan your survival, manage resources, and react fast. Team up with friends or go solo the liminal world tests your speed, strategy, and nerve.\n\nCan you survive the shift, restore power, and maintain your base until dawn? Every night is a new challenge in LIMINAL SHIFT.", "short_description": "Build your base, restore the generator, and survive monsters in eerie liminal rooms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/liminal-shift-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Floppa", "support_website_url": null, "website_url": "https://sites.google.com/view/liminal-shift-vr/homepage", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25819339697691569"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1531043084838472"}]}, "baseline_offer": {"id": "1531043084838472"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1767992460, "status": "PUBLISHED", "id": "15310
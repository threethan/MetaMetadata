5/673536876_1065278283165434_590167477853309200_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJIe9REooJoQ7kNvwHm244M&_nc_oc=AdqxnVznPoPkK4oCi5tN_lEY8j0Q7UAsi_lLTp3q2KQN5ZvgqyOa7tPV2Ql6K8JbVwU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqjDDZzojrekgF1zwWVL3MdmqXQL86XDUzzO_ylYuerA&oe=6B01DC5E"}, {"file_name": "screenshot_3.png", "id": "938448908948793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831964_938448912282126_1144870614929717811_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rF-1CtteYpsQ7kNvwFM5BqR&_nc_oc=Adqldod-kJfuunQDplpEJH75IQUQXXrYpD_Em2bGvE3N4u9q-BeIML2l31U-c-RGbag&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlFi8200KRK_2PU_lXZlwG5w_pWaXjC-wQTykSvtqA1A&oe=6B01EE55"}, {"file_name": "screenshot_1.png", "id": "2314299189318970", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830576_2314299192652303_324732865612781773_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4dZMt_hIrYQ7kNvwESmT9f&_nc_oc=AdpP_QgWDsGJSYPpbWZ60zFrns1CvCNbLYVvZ9y-jFrrzfMs2AomYZ-YllX9P5AqQlU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9N9Qo7WoicCaxj8hRzqeqghyCp_NuWUyHq_7qEpxFmA&oe=6B01D94F"}, {"file_name": "screenshot_5.png", "id": "1117731450603672", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604360590_1117731457270338_2875880526488077563_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Od3A3xtf-UQQ7kNvwG5uD4S&_nc_oc=AdpkD8C1SAT_fiu-PfU65nCnbK2q-qYP-ULjetD43y3UR5MY9IDq7ZXbDI57vrBfa0Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdSTkHZOLxp2GWgsfhZ8oscq27TAIONVhS4UY4A7buHw&oe=6B01D2A3"}, {"file_name": "screenshot_4.png", "id": "1034755729599456", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/585806260_1034755736266122_5211169171173850516_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zm2bibH-fDkQ7kNvwE1ZsQh&_nc_oc=Adpc_qAkKqelm21XYQKtVggMiGu-BdFhpHgUHjteXFVUd24xgGyPurBukuZaDGw7A4U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQswUH9zVEb1Lx2V1M1nQ1TtJb2PAqouTJTCb-uTNMk7Q&oe=6B01D956"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "947382485113372", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831279_947382495113371_7956753002493402860_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHxKXCZBBh0Q7kNvwExZGoq&_nc_oc=AdoiEiEqPv_Q50vrNT_twSwOWC6903Lr-phCIVVubjCq89rRU_YW4fxlt92lsAIF0-A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1w2uLCIjTNOczvZ1s2WuzWsW5KbdYWeKtLTO4ZOPRJA&oe=6B01C2D7"}, "display_name": "Flight Simulator Calgary", "keywords": ["flight", "simulator", "calgary", "jet", "pilot"], "long_description": "Flight Simulator Calgary puts you in the captain's seat over the real Calgary.\n\nTHE REAL CALGARY\nReal satellite, elevation and map data: the Calgary Tower, the Saddledome, Stampede Park, the Peace Bridge, the Centre Street Bridge, Prince's Island, Canada Olympic Park, the Glenmore Reservoir and the Bow and Elbow rivers. The Rockies rise in the west: fly up the Bow valley past Canmore to Banff. Two airports: Calgary International and Springbank.\n\nA LIVING CITY\nCTrains on the Red and Blue lines, freight trains on the main line, thousands of cars, airliners in the sky, grain elevators and pump jacks on the prairie. At night the city lights up, with fireworks over Stampede Park.\n\nAIR TRAFFIC CONTROL\nA real-sounding radio: taxi and takeoff clearances, departure, traffic calls, the ILS and your landing clearance, with chatter between airliners.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar by the rivers, the Calgary Tower out of the doors. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter.\n\nMISSIONS AND FREE FLIGHT\nEleven missions: the downtown approach, Springbank, the Bow River run, through the skyline, a Rockies run to Banff, a fighter scramble, Stampede nights and a Calgary tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Calgary, built from real satellite and map data: the Calgary Tower, the Saddledome, Stampede Park, the Peace Bridge, Olympic Park's ski jumps and the Bow River, with the Rockies on the horizon all the way to Banff. Start in your own glass hangar, talk to live air traffic control, and take out private jets or a fighter. Fly solo or together online."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorcalgary/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatorcalgary/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1374595945736941"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1380449091818293", "version":
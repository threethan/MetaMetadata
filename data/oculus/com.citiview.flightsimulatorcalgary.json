bhYQ7kNvwHgqRR-&_nc_oc=AdqKAa3IXTeUcp5DVu77Gtv3gCPBI_R885QoDvxtEBvFQvtp-cNZePQNJroI8d8wjmE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQIvUqe7QhLMZZCcEa6LdGSfY38tWQ4qGIDOx4iPbLjpA&oe=6B0B13D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "947382485113372", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831279_947382495113371_7956753002493402860_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hS5rTdQO7s4Q7kNvwF9T-zn&_nc_oc=AdpTPjWd9CmNZh1NCa1-LZU2IzQzRBP65lFLal7staCZOEajYn8ivgKqShOF_5vIMq4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT37OHJbURmicqtLvaq6v6PD5O39BjzbVClgPi8tL7ahg&oe=6B0B3597"}, "display_name": "Flight Simulator Calgary", "keywords": ["flight", "simulator", "calgary", "jet", "pilot"], "long_description": "Flight Simulator Calgary puts you in the captain's seat over the real Calgary.\n\nTHE REAL CALGARY\nReal satellite, elevation and map data: the Calgary Tower, the Saddledome, Stampede Park, the Peace Bridge, the Centre Street Bridge, Prince's Island, Canada Olympic Park, the Glenmore Reservoir and the Bow and Elbow rivers. The Rockies rise in the west: fly up the Bow valley past Canmore to Banff. Two airports: Calgary International and Springbank.\n\nA LIVING CITY\nCTrains on the Red and Blue lines, freight trains on the main line, thousands of cars, airliners in the sky, grain elevators and pump jacks on the prairie. At night the city lights up, with fireworks over Stampede Park.\n\nAIR TRAFFIC CONTROL\nA real-sounding radio: taxi and takeoff clearances, departure, traffic calls, the ILS and your landing clearance, with chatter between airliners.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar by the rivers, the Calgary Tower out of the doors. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter.\n\nMISSIONS AND FREE FLIGHT\nEleven missions: the downtown approach, Springbank, the Bow River run, through the skyline, a Rockies run to Banff, a fighter scramble, Stampede nights and a Calgary tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Calgary, built from real satellite and map data: the Calgary Tower, the Saddledome, Stampede Park, the Peace Bridge, Olympic Park's ski jumps and the Bow River, with the Rockies on the horizon all the way to Banff. Start in your own glass hangar, talk to live air traffic control, and take out private jets or a fighter. Fly solo or together online."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorcalgary/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatorcalgary/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1374595945736941"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1380449091818293", "version":
uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824318_1672237611298541_5838502841791750650_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCqzA6XjcvAQ7kNvwETmzMo&_nc_oc=AdpD3lEH1_XiuhKhuDToxLOdr2Pg6I2Z7yZujw6CwAChppIqX6qqyP8Yf9J-NX_c6nM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUrH5_Eld5XWIv-CtllqqSekv7boktEpOMGjr3PIoB4Jg&oe=6B105E25"}, {"file_name": "02_monster_day.png", "id": "1816020742785151", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827585_1816020749451817_2006085637575104685_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kh9PRFM7AucQ7kNvwEZzlRk&_nc_oc=AdqUtYdyPspnaz7rsM0H2Q6pUkxvExNQUQ53Oe2NXKOUXw562Ac5BVwc_a46nNSwvos&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUwj9a9jO1ThlX1hrG9KxrLEKdE_7cKt1lUl7Uf1Eu4qQ&oe=6B10597C"}, {"file_name": "04_kart_battle.png", "id": "2399503717122657", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825546_2399503720455990_7757434004321989136_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YtBDuuGjFVUQ7kNvwEobIFM&_nc_oc=Adri0OM5L5KYlH1_IgLt7ylos4G4_ki8GLAZAymyhnGZu0DWUqLgJRnZxPKHN3Q5lr8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWhSV76sfGxtlEAWTx67_8S3rrFPm3CYAQ5PvemtYj9VQ&oe=6B105D06"}, {"file_name": "05_hideout_loot.png", "id": "1058449763875155", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823812_1058449767208488_6355665080976749055_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUVi-AmBWX4Q7kNvwGsN11a&_nc_oc=Adp9Unj0GuPuKeP4gSE24xzWEygAh8YoqbHUVeLSqCOJX8oK4P3vPOvnbhUKDAPHVIE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW5ti2obs-BPS3T-yBmkFoGM6j5ZFWysCVMSXERMM5J2w&oe=6B106A7B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I am Monkey Mayhem: School Edition", "keywords": ["monkey", "school", "classroom", "animal", "teacher"], "long_description": "Be the monkey. Wreck the school.\n\nYou\u2019re the wildest student in class, and you\u2019re a monkey. Climb, swing and sneak through a school full of things to grab, throw and break. Prank the teachers, dodge detention, and turn every classroom into total mayhem.\n\nPRANK EVERYONE\nWhoopee cushions, flying bananas, paint, water and more. Set up the perfect prank, then watch the teacher lose it.\n\nSWING, CLIMB AND ESCAPE\nUse your monkey arms to climb walls, swing from lights and escape before you get caught. Get caught and it\u2019s straight to detention!\n\nA SCHOOL FULL OF CHAOS\nClassrooms, hallways, the cafeteria and more. Every object is physics-based: pick it up, throw it, smash it.\n\nMISSIONS AND SECRETS\nComplete prank missions, find hidden secrets and unlock new areas, including your own secret hideout.\n\nBEAT THE MONSTERS\nTake on wild arena challenges and show who really runs this school.\n\nFEATURES\n\u2022 Play as a monkey with full-body VR movement\n\u2022 Physics sandbox where every object reacts\n\u2022 Funny teachers who react to every prank\n\u2022 Prank missions, secrets and unlockables\n\u2022 Classrooms, cafeteria, hideout and arenas\n\u2022 Single-player chaos, with no internet needed\n\nGrab a banana. Start the mayhem.", "short_description": "Be the monkey. Wreck the school. Prank teachers, cause classroom chaos, swing through the halls and escape detention in this physics sandbox of monkey mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type":
8", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499313107_2960498794292491_4208195664741794160_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Af-XWow6V6MQ7kNvwF8I37g&_nc_oc=AdqPAMT3_EYFbODVfFhfvoWvHftvydpJHDZ6RABT6YIKoVxCTnHD4RfN8IbJKKpp98I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNmNIOqdxn7_6PegHK14XZAQvnbSpNa66fT_Pbz1aSBQ&oe=6B09982E"}, {"file_name": "4.png", "id": "1049040897539799", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312454_1049040900873132_4812091704050267677_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFEj_OjlhiYQ7kNvwH6XiO0&_nc_oc=Adp85rnkZ_eF-pqg2zrl7yXmci3ZEQKuvLCmvS6VMPszJWmRaAL_E_uC5f-YLoXJR-k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSM2RVRdxb_vG_x4LOYQ1q1eB13aAj55TCigFFfD3jB7g&oe=6B09B96D"}, {"file_name": "5.png", "id": "1083367574074565", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310720_1083367577407898_4642005374553364022_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFajKABlqmEQ7kNvwEhxzDZ&_nc_oc=AdqUSXLGDKwmfJihXf1F4rqIrSlJfE6hYwri7G6QSTz6r_naVEq8GNA31Jj1DGG_XkU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKKeg6Y2Cl6-WxnNopXSIh0hyFhq0ZLHJOr-RYrY58XQ&oe=6B09B76F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baboon Chasers", "keywords": ["tag", "tagger", "taggers", "tagging", "taggings"], "long_description": "Baboon Chasers drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, monkeys, gorillas, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.", "short_description": "Welcome to Baboon Chasers! Make sure to download the game cause we have lot's of things for you and your friend's to do!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/baboonchasers/home", "developer_terms_of_service_url": null, "publisher_name": "Z3n", "support_website_url": null, "website_url": "https://sites.google.com/view/baboonchasers/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1156653134209077"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1204963599378030", "version": "9"}, "id": "1751565465972713", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1156653127542411", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1204963599378030"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "175156546
8", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499313107_2960498794292491_4208195664741794160_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7L7kMTkM6ZwQ7kNvwFB8_tg&_nc_oc=Adpu0f9vQBL66oo98a3wPBvENwJ4U83fu9HrHBMKlYDVIox_4R4Q8UcC3X9D31mctqk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSZ0891dIIE6r2ITIxlekLyjruCiJS0IOjCHA9ZgqSTA&oe=6AFF0C2E"}, {"file_name": "4.png", "id": "1049040897539799", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312454_1049040900873132_4812091704050267677_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7_HTFOxLJ0Q7kNvwGm36-_&_nc_oc=AdpjGOYwUjAIm6VhiLO3wKWIBBCM0mzgfECRpBUeSTZSZe5dLia5osOT6Ug_G1uKCcc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtVQ-ky1v7r885qzu1qCkFQnQivsmNo9ODrVNBHoQiXA&oe=6AFF2D6D"}, {"file_name": "5.png", "id": "1083367574074565", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310720_1083367577407898_4642005374553364022_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ux6nSQitCjUQ7kNvwGY4yt2&_nc_oc=AdrrITtzKFdhYlvEgmP8HefLoCNrRvBtA8PMccY_Nx83xCSBtahQW_iZdaa_HjP4i2I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2UgWKwSGmq6EKiFBni5r1GowLgZ-DITNeQAa1XkUwxw&oe=6AFF2B6F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baboon Chasers", "keywords": ["tag", "tagger", "taggers", "tagging", "taggings"], "long_description": "Baboon Chasers drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, monkeys, gorillas, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.", "short_description": "Welcome to Baboon Chasers! Make sure to download the game cause we have lot's of things for you and your friend's to do!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/baboonchasers/home", "developer_terms_of_service_url": null, "publisher_name": "Z3n", "support_website_url": null, "website_url": "https://sites.google.com/view/baboonchasers/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1156653134209077"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1204963599378030", "version": "9"}, "id": "1751565465972713", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1156653127542411", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1204963599378030"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "175156546
00754851184_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TBt1neuR4QQ7kNvwGlFlKE&_nc_oc=AdlN6H45kOMvTVUojz-hlNjdPo7yf21qBrEhQHYaMWDcmBA82GY6hvLc9mBpezglRU8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyzWlgL-dVzDwaXP-s_QXs9KNsmlEuk3EotpuNymyQAiw&oe=69AD5DAA"}, "display_name": "REFLEX UNIT 2", "keywords": [], "long_description": "The year is 2039 and the planet has recovered after the events of Reflex Unit 1. Life seems safe, until a new larger army of remote control drones suddenly attacks strategic cities around the globe. \u200b\n\nIt is up to you again to pilot a new batch of experimental hardware to fight back the invading forces and save the planet, and beyond...\n\n- 1 or 2 Player Campaign\n- 2 to 4 Player Versus and Survival modes\n- Cross Platform Multiplayer (iOS, Android, Oculus Platforms, Nintendo Switch)\n- Game Controller Compatible*\n\n*XBOX Game Controller Recommended", "short_description": "Take control of an advanced walking tank facing waves of challenging enemies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.robosarugames.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ROBOSARU GAMES", "support_website_url": "https://www.robosarugames.com/", "website_url": "https://www.robosarugames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH", "GAMEPAD_VIA_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interacti
01_325574217876642_8926442638236712960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcIJRTl39bYQ7kNvwFVoaMC&_nc_oc=AdnrmSx07sSUpRSyvgeVL9AwY7jPPNJ0BiMXM3ed5XeEbTvJOZ2wUMp2_RHzH_DDovs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQjS6R3tFzHjpN9YFcVHjrOkuwezFqR4-wF4cnwrnodg&oe=69B6B86C"}, {"file_name": "migrated_image.png", "id": "203876624265899", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162690_318859825210567_4629106843866628096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGVINJMo1sAQ7kNvwH6CQe-&_nc_oc=AdmSZ1fhOl4IpeH9hvy3Td6ZZ-tqsa5tJdv1rnffODQYfCdRGRNh4J8x8aAOaAxvbQo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2K1TkT7Zkhmhyj2Zrj1iSyD82sN15u_HM7f__6RFDOg&oe=69B69195"}, {"file_name": "migrated_image.png", "id": "3171466972898695", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162675_224662891379134_6592421203292454912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QA2eYYNXuwQ7kNvwEYQPnm&_nc_oc=AdkUBbQrxJOkEyJnt1ZBLppInluVgXsKHWmYWBwG6gIytiuFXXMVJv8YMF7WJx0rbCo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyzWjZOOnyCOblUk7UUuOcZmMWdQ97rjnIgxN5oWHbUYw&oe=69B690BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoorRooma.png", "id": "139347326635067", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162678_139347329968400_1670297392546578432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPELdfqzbmAQ7kNvwH7HEmL&_nc_oc=AdnyHbNnajxBhqGtEtJMZ_kAoAEYv67VRK9GGW8VlRIWmH0G1K9XLos6z5IenSiqOHk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLVNNbBELUahGC9QSr4_UhpQf-2xIPXgw8AKN3XR9dmQ&oe=69B6ADA8"}, "display_name": "MindFulVR", "keywords": ["Mindfulness", "Meditation", "Wellbeing", "Stress", "Anxiety"], "long_description": "Welcome to MindFulVR, your safe place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will assist you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being.\n\nDiscover a part of Mindfulness, known as the Body Scan (7 mins), which will assist you recognize feelings of \"dis-ease\" in your body, and using a simple affirmation, how you might accept these feelings.\n\nSerenity will guide you through a fingertip tapping practice, known as the Emotional Freedom Technique (10 mins), which combines ancient acupressure with modern psychology, and helps you affirm your emotions, as you tap around your energy points.\n\nIreland\u2019s ancient landscape has a long association with well-being and self-healing. MindFulVR includes a handpicked selection of these ancient Irish locations, as 360-degree immersive VR videos, for you to practice your Body Scan, all inside our MindFulVR app.", "short_description": "Welcome to MindFulVR, your place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will lead you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being. This will be your true and meaningful, mindful and soulful journey of acceptance."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mindmyths.eu/privacy-policy/", "developer_terms_of_service_url": "http://mindmyths.eu/terms-of-service/", "publisher_name": "MindMyths", "support_website_url": null, "website_url": "http://www.mindmyths.eu/the-app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "suppo
1.oculuscdn.com/v/t64.5771-25/11162722_1691017657866242_6527890522260897792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_zYrknZJ24Q7kNvwHsvMyP&_nc_oc=AdrDCAjs3CJVIzHMoOCxjOUoF8h1EKEiTOh5s00iIq6iSvdcXjiLnFNNzO3Kkf5-oWQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhegU4Y503CxzDPCXhIlAKDHY01-AQMhewbfmubXw4bQ&oe=6A6616C1"}, {"file_name": "migrated_image.png", "id": "550870692209943", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162701_325574217876642_8926442638236712960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxaiI3Wd_DQQ7kNvwFmqEMm&_nc_oc=AdrAH37wQnvZ8Hs6SNcpVJkGaEg8a47QBmg1x7SqX0St8pjy4kPONMMLuokEJL5aIsI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPSiwjfByL7T7RTJSF-9sGlSzvITrcIGZAYLMYpQhz_Q&oe=6A660FEC"}, {"file_name": "migrated_image.png", "id": "203876624265899", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162690_318859825210567_4629106843866628096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBWN8SJbyeYQ7kNvwGnB8N-&_nc_oc=AdrvL56I1vvBol3H7josx2E9xm679lfwDqzlrOoq4Go1VrD5niGYhvGn_Y1GKeRnLro&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZ3oDeojCvrSyI98iD-li8HtTK9MbxJtPv4HkOdlesOQ&oe=6A662155"}, {"file_name": "migrated_image.png", "id": "3171466972898695", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162675_224662891379134_6592421203292454912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGylUSWRLsoQ7kNvwEw3UC5&_nc_oc=AdqQnaxy1BAniYbo5zW0kpVALl5dHK9K9yqZNnHgHL2i7eFj1yfstNKUI_j7dvmUD3A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmIPDZRCv5BVs584HBcwKNo8betsFZ2v2k1j6KWbJ6iw&oe=6A66207D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoorRooma.png", "id": "139347326635067", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162678_139347329968400_1670297392546578432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWBZhuG1wEsQ7kNvwE6U8BB&_nc_oc=AdrzG8U0ln44zQ4Foo9ZwQdM1_QhaQzWw7GO5HxTCKDStlYK7j0WUyIL7mnqJvAuJgM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMD7LVbZBCSWGog448HMESdOjztf_lN0ffB4-cp-K-OA&oe=6A660528"}, "display_name": "MindFulVR", "keywords": ["Mindfulness", "Meditation", "Wellbeing", "Stress", "Anxiety"], "long_description": "Welcome to MindFulVR, your safe place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will assist you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being.\n\nDiscover a part of Mindfulness, known as the Body Scan (7 mins), which will assist you recognize feelings of \"dis-ease\" in your body, and using a simple affirmation, how you might accept these feelings.\n\nSerenity will guide you through a fingertip tapping practice, known as the Emotional Freedom Technique (10 mins), which combines ancient acupressure with modern psychology, and helps you affirm your emotions, as you tap around your energy points.\n\nIreland\u2019s ancient landscape has a long association with well-being and self-healing. MindFulVR includes a handpicked selection of these ancient Irish locations, as 360-degree immersive VR videos, for you to practice your Body Scan, all inside our MindFulVR app.", "short_description": "Welcome to MindFulVR, your place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will lead you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being. This will be your true and meaningful, mindful and soulful journey of acceptance."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mindmyths.eu/privacy-policy/", "developer_terms_of_service_url": "http://mindmyths.eu/terms-of-service/", "publisher_name": "MindMyths", "support_website_url": null, "website_url": "http://www.mindmyths.eu/the-app/", "category": "APPS", 
01_325574217876642_8926442638236712960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ARernj4GNgQ7kNvwHIpcNI&_nc_oc=AdniHfxnIA46dkuJ-k15MZoTIU7ym7vNF5yJQDpWQvoHQmslWBH8SE2N6XLIvyxz6Fc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzssdkvt25nQaWtXcjvQcOHUFsRiMqUjAytuFx2gZFnoQ&oe=69B4156C"}, {"file_name": "migrated_image.png", "id": "203876624265899", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162690_318859825210567_4629106843866628096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2hZtCi2rNIQ7kNvwF_G_W9&_nc_oc=AdmLdwU-HDzYyaywLerBooeRSadF-wviSrVLwAbBlPhAk4bWRGvN4mNtZhuNCSdKql8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwy-p_ilDz4TCYj2qVRuR1YsaS4FtIh5yE9jvRepPQNxQ&oe=69B3EE95"}, {"file_name": "migrated_image.png", "id": "3171466972898695", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162675_224662891379134_6592421203292454912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P43qj-8yq2MQ7kNvwEsa1FL&_nc_oc=AdmFHzaCo0KvuVw86EQtgAAgS0fq003cgRy9dmp3C-D8TjIyHKyA-6tgkJohr1L11JM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfymaOetEtjKTkimrI99wryBZHOg938p7v-eOwUpCHrt0g&oe=69B3EDBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoorRooma.png", "id": "139347326635067", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162678_139347329968400_1670297392546578432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKkS54fLPcMQ7kNvwH8n38p&_nc_oc=AdkThBG8Ld0fYQ-eDgLKVPGfg7ROED6U1R8dPcjPuNqUouA5yXFf7-yIGU4WXEY9M8g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxDnAssRANKb6-FbN4xPBXZkDpjEt6WxWULW6QeE5ubgw&oe=69B40AA8"}, "display_name": "MindFulVR", "keywords": ["Mindfulness", "Meditation", "Wellbeing", "Stress", "Anxiety"], "long_description": "Welcome to MindFulVR, your safe place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will assist you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being.\n\nDiscover a part of Mindfulness, known as the Body Scan (7 mins), which will assist you recognize feelings of \"dis-ease\" in your body, and using a simple affirmation, how you might accept these feelings.\n\nSerenity will guide you through a fingertip tapping practice, known as the Emotional Freedom Technique (10 mins), which combines ancient acupressure with modern psychology, and helps you affirm your emotions, as you tap around your energy points.\n\nIreland\u2019s ancient landscape has a long association with well-being and self-healing. MindFulVR includes a handpicked selection of these ancient Irish locations, as 360-degree immersive VR videos, for you to practice your Body Scan, all inside our MindFulVR app.", "short_description": "Welcome to MindFulVR, your place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will lead you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being. This will be your true and meaningful, mindful and soulful journey of acceptance."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mindmyths.eu/privacy-policy/", "developer_terms_of_service_url": "http://mindmyths.eu/terms-of-service/", "publisher_name": "MindMyths", "support_website_url": null, "website_url": "http://www.mindmyths.eu/the-app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "suppo
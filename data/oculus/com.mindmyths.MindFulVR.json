1.oculuscdn.com/v/t64.5771-25/11162722_1691017657866242_6527890522260897792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHhCP1owP5UQ7kNvwEJK3t6&_nc_oc=AdryogBlPnPVJtwt4vGI6Gdsiin3fp9gTh3oSv1v-WEvTW14_VJZ2-yWNms1b4CsGsc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsRJBCaZrEPyZQkwGmYKUdAvVOpd62r8HFf1ahNq3FpA&oe=6AD3BB81"}, {"file_name": "migrated_image.png", "id": "550870692209943", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162701_325574217876642_8926442638236712960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tc8-uSDdrtkQ7kNvwHQx9XX&_nc_oc=AdouKM8wqHC3Btcp5zB7NzvXAr8JoeIkjSZEFZVCynboVRwbvg_4FdvjvA2GL0yFgDY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsCg5qJzGAlacb3FCuQNnQSAxfHLC6xlXuvkG0-U1i2w&oe=6AD3B4AC"}, {"file_name": "migrated_image.png", "id": "203876624265899", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162690_318859825210567_4629106843866628096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-fmZVK-aJ4Q7kNvwG9oCQT&_nc_oc=AdqxpfPAXren2BExXpIYU8e-KjpsmZ3YDnaW5mvgWerqRWqOq5Y6MThjBaQv60CyOsk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP92CSxcNOGa0xxcKjafsVdx_m0dv2pdY3sApm-heAIUA&oe=6AD38DD5"}, {"file_name": "migrated_image.png", "id": "3171466972898695", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162675_224662891379134_6592421203292454912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LP3e3BMefaAQ7kNvwFiaUT5&_nc_oc=AdphKkPGYbMBRNZnS7ku-WD2KWsOV77dPGHL26rEKFjgHFj7XSrkgYd1joAj5J3uVCg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkiVieJLFemDvci8kX93vHmHXButHYIf3x3yYrEGEonA&oe=6AD38CFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoorRooma.png", "id": "139347326635067", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162678_139347329968400_1670297392546578432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gwjWedt4l8Q7kNvwEuPiKc&_nc_oc=AdqMPMg-Q3LkEaxBLTbDsbqmfBgomyi13K-ogFOakStkrLRuDhRyFIIg_98ZFDAyrMc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGDqMgICphcb2SXMm8eV9Vtpv6-QIHTpqdOAs63sGx5g&oe=6AD3A9E8"}, "display_name": "MindFulVR", "keywords": ["Mindfulness", "Meditation", "Wellbeing", "Stress", "Anxiety"], "long_description": "Welcome to MindFulVR, your safe place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will assist you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being.\n\nDiscover a part of Mindfulness, known as the Body Scan (7 mins), which will assist you recognize feelings of \"dis-ease\" in your body, and using a simple affirmation, how you might accept these feelings.\n\nSerenity will guide you through a fingertip tapping practice, known as the Emotional Freedom Technique (10 mins), which combines ancient acupressure with modern psychology, and helps you affirm your emotions, as you tap around your energy points.\n\nIreland\u2019s ancient landscape has a long association with well-being and self-healing. MindFulVR includes a handpicked selection of these ancient Irish locations, as 360-degree immersive VR videos, for you to practice your Body Scan, all inside our MindFulVR app.", "short_description": "Welcome to MindFulVR, your place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will lead you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being. This will be your true and meaningful, mindful and soulful journey of acceptance."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mindmyths.eu/privacy-policy/", "developer_terms_of_service_url": "http://mindmyths.eu/terms-of-service/", "publisher_name": "MindMyths", "support_website_url": null, "website_url": "http://www.mindmyths.eu/the-app/", "category": "APPS", 
in6-3.oculuscdn.com/v/t64.5771-25/11162722_1691017657866242_6527890522260897792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQekhYc8g88Q7kNvwGkRsRy&_nc_oc=Adq8z6l-FQq__2YEv5_ngrEpzaWfM4DK4Ds4dM_jvmoAi1v0VD5Zy1Bnuw6s6ko1XVg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqB0zvYegdHWmdcTSJLOhLvxl-05cnlBjGgSdylt7N5Q&oe=6AAE9941"}, {"file_name": "migrated_image.png", "id": "550870692209943", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162701_325574217876642_8926442638236712960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dB0cDm774UwQ7kNvwFpBkxd&_nc_oc=AdpCnPthBZbG-uCMF4ZPBe9Avfz0ew3NiepSN8JqV9L0P7W82SwWCXtYAhLD4Vd5j5k&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID090ZmX7gqVq2m6XHDTAWHkrZSky4b5J0LGk0bDzj-A&oe=6AAE926C"}, {"file_name": "migrated_image.png", "id": "203876624265899", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162690_318859825210567_4629106843866628096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DAcHmRKlgIQ7kNvwGyfuph&_nc_oc=AdodYZLV5LtYXU5iRShj6-P-kerrYwsn9ZoVKzX60Ai8gUqkqWFXXFpnfLCibQPavx4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4lRrzVKWcpH_9yQLw9Ee3g3oav4OGvSgD9txUUPZYEQ&oe=6AAEA3D5"}, {"file_name": "migrated_image.png", "id": "3171466972898695", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162675_224662891379134_6592421203292454912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j87rijMp8tgQ7kNvwF9ftkG&_nc_oc=AdpfbHhPBo-mvY8YlxgBxhKHnyznOWeRcS7VNSJjM957GP8NkIf1B-k0snXgGG1q7u0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCl7AuAqwaYVDQ01Ih-eZp4Y370rbrrXESPoN_PwahvA&oe=6AAEA2FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoorRooma.png", "id": "139347326635067", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162678_139347329968400_1670297392546578432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92DSHe6bPlEQ7kNvwFNUdho&_nc_oc=Adp3kol1Y58Tc4bUWMms7GbssgnZ2GiTEBXf-KMPHKehy_oo5RXpJvqMiYVOPZWl0jo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJj7gdeUKMVxSmarQjLYKgxv7YWADYDwhbF4z3bzBnw9Q&oe=6AAE87A8"}, "display_name": "MindFulVR", "keywords": ["Mindfulness", "Meditation", "Wellbeing", "Stress", "Anxiety"], "long_description": "Welcome to MindFulVR, your safe place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will assist you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being.\n\nDiscover a part of Mindfulness, known as the Body Scan (7 mins), which will assist you recognize feelings of \"dis-ease\" in your body, and using a simple affirmation, how you might accept these feelings.\n\nSerenity will guide you through a fingertip tapping practice, known as the Emotional Freedom Technique (10 mins), which combines ancient acupressure with modern psychology, and helps you affirm your emotions, as you tap around your energy points.\n\nIreland\u2019s ancient landscape has a long association with well-being and self-healing. MindFulVR includes a handpicked selection of these ancient Irish locations, as 360-degree immersive VR videos, for you to practice your Body Scan, all inside our MindFulVR app.", "short_description": "Welcome to MindFulVR, your place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will lead you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being. This will be your true and meaningful, mindful and soulful journey of acceptance."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mindmyths.eu/privacy-policy/", "developer_terms_of_service_url": "http://mindmyths.eu/terms-of-service/", "publisher_name": "MindMyths", "support_website_url": null, "website_url": "http://www.mindmyths.eu/the-app/", "category": "APP
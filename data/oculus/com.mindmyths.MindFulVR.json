in6-3.oculuscdn.com/v/t64.5771-25/11162722_1691017657866242_6527890522260897792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbqOeSOUMMYQ7kNvwHY8NSG&_nc_oc=AdpdLt7bSyQ5WcSVlqjpaUf8GxoRMMZE-4_TzfISZHyyJxT07IEsVfkiFlmDNl9Wa3U&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Fh-JqEzPtcSiR_QH-IQvW8oHxlAZTA_sggIFwa9LQpA&oe=6A11B6C1"}, {"file_name": "migrated_image.png", "id": "550870692209943", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162701_325574217876642_8926442638236712960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=263Pt8QM00EQ7kNvwEq2CNN&_nc_oc=AdqspuEUSN6tqQGvnhTEt6jFGwoNeoCJIXsej3hmrXPJIJKNxbijlAbzZIitrdNt8BE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BQEERDy7zUVH-TOu3xOxvfju-OCuxqFwpjwIwmpzUug&oe=6A11AFEC"}, {"file_name": "migrated_image.png", "id": "203876624265899", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162690_318859825210567_4629106843866628096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWan-eUwYjQQ7kNvwEnAJ_Z&_nc_oc=Adpd2x7VaWmg3sOGLHOR7W_cNub9WclagmEWZrSF9HkB7mHai8DLykwM4LDMzke-g7Q&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fzEMYOtpLrKUdirb8qfcrTez-6vt6mzZz7N5CsFBZug&oe=6A11C155"}, {"file_name": "migrated_image.png", "id": "3171466972898695", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162675_224662891379134_6592421203292454912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRqDndvtSlgQ7kNvwH48T7U&_nc_oc=AdoyBwhpk7gG7Xt1b0WBNayVqoC6cu-LgjNnj3NpHuhmQdnl6kI3BL4IQAbDYBlsvjk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4G8GtFhhCqiBE2tuAp6y-EII0P7Lwwq-pXjiztsPcq6w&oe=6A11C07D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoorRooma.png", "id": "139347326635067", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162678_139347329968400_1670297392546578432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQQzeXcVTuoQ7kNvwEoeyXj&_nc_oc=AdqeRR4pVCQOQeweJWQ_v4ThS-Et5bgJQpLa1U2OOyeTnbu-TXfgfa5vdJBtEJxhrXU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DwcPKM3PYm_0G7xJ9QgV0PMknql-wxJmYG5Rl3chn-A&oe=6A11A528"}, "display_name": "MindFulVR", "keywords": ["Mindfulness", "Meditation", "Wellbeing", "Stress", "Anxiety"], "long_description": "Welcome to MindFulVR, your safe place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will assist you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being.\n\nDiscover a part of Mindfulness, known as the Body Scan (7 mins), which will assist you recognize feelings of \"dis-ease\" in your body, and using a simple affirmation, how you might accept these feelings.\n\nSerenity will guide you through a fingertip tapping practice, known as the Emotional Freedom Technique (10 mins), which combines ancient acupressure with modern psychology, and helps you affirm your emotions, as you tap around your energy points.\n\nIreland\u2019s ancient landscape has a long association with well-being and self-healing. MindFulVR includes a handpicked selection of these ancient Irish locations, as 360-degree immersive VR videos, for you to practice your Body Scan, all inside our MindFulVR app.", "short_description": "Welcome to MindFulVR, your place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will lead you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being. This will be your true and meaningful, mindful and soulful journey of acceptance."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mindmyths.eu/privacy-policy/", "developer_terms_of_service_url": "http://mindmyths.eu/terms-of-service/", "publisher_name": "MindMyths", "support_website_url": null, "website_url": "http://www.mindmyths.eu/the-app/", "category": "APP
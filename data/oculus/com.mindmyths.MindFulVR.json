1.oculuscdn.com/v/t64.5771-25/11162722_1691017657866242_6527890522260897792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9VFIeFIV7MQ7kNvwEpMSWG&_nc_oc=Adqkb_ArRrdL-ZWpyFTKleC-XrOFdgKXMqL6zqfywxsC-Kr-qb29bkTIynlHl1dE8Jg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TW9Gl7B6S1zgVAW9Gf3714fGYJVYMU1SCDr5P9Ong8w&oe=69E4E3C1"}, {"file_name": "migrated_image.png", "id": "550870692209943", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_325574217876642_8926442638236712960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoJImzQ69swQ7kNvwGHRiBU&_nc_oc=Adr3a2mmaQy2BJGpeoGLweTz61F5FSyIssflsuXkT-uHs8xubf6Mv76mM2spd8msDSs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ztW16-AYHgDO8GV7YCo6V9UogVLFOKomcqjJx_bIWsQ&oe=69E4DCEC"}, {"file_name": "migrated_image.png", "id": "203876624265899", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162690_318859825210567_4629106843866628096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sphLWEt4fOsQ7kNvwFfEZPb&_nc_oc=AdoGESjE6Jh_EsjnWbElxoWG40wwUlL_NWb-leiVTl_Io7QaDMcJSS1sPUVQFaGXCiU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32pLe2UQMpm09GTTXbbNBEjJwz08qwHNIVxcEz8cFUqQ&oe=69E4B615"}, {"file_name": "migrated_image.png", "id": "3171466972898695", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162675_224662891379134_6592421203292454912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwknBu6eL3AQ7kNvwEjMM-B&_nc_oc=Adp2kiKmUVNiwwHqG_X1AM-wP-eeh8xEBiMNBk-TTBM0R5D1y_4HkZU113R2hkzemTY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XEAiKENdQEe88BwW4_ur1Aor0yqH-nw6e7HV2AE9eLQ&oe=69E4ED7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoorRooma.png", "id": "139347326635067", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162678_139347329968400_1670297392546578432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=suYApXuVXNoQ7kNvwEAgwzH&_nc_oc=AdrvH8infGkLweJm3-KJAvH2JSmJNVkPe9PopYkNq_4G4ruu9qs_umFcFPRyh_nWqUw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bjV450fN8Oy56O_VQj6Lz2Ri1hFpUZqRNuIciNDFRYQ&oe=69E4D228"}, "display_name": "MindFulVR", "keywords": ["Mindfulness", "Meditation", "Wellbeing", "Stress", "Anxiety"], "long_description": "Welcome to MindFulVR, your safe place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will assist you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being.\n\nDiscover a part of Mindfulness, known as the Body Scan (7 mins), which will assist you recognize feelings of \"dis-ease\" in your body, and using a simple affirmation, how you might accept these feelings.\n\nSerenity will guide you through a fingertip tapping practice, known as the Emotional Freedom Technique (10 mins), which combines ancient acupressure with modern psychology, and helps you affirm your emotions, as you tap around your energy points.\n\nIreland\u2019s ancient landscape has a long association with well-being and self-healing. MindFulVR includes a handpicked selection of these ancient Irish locations, as 360-degree immersive VR videos, for you to practice your Body Scan, all inside our MindFulVR app.", "short_description": "Welcome to MindFulVR, your place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will lead you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being. This will be your true and meaningful, mindful and soulful journey of acceptance."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mindmyths.eu/privacy-policy/", "developer_terms_of_service_url": "http://mindmyths.eu/terms-of-service/", "publisher_name": "MindMyths", "support_website_url": null, "website_url": "http://www.mindmyths.eu/the-app/", "category": "APPS", 
1.oculuscdn.com/v/t64.5771-25/11162722_1691017657866242_6527890522260897792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=El5ZqUV6v4IQ7kNvwF4nGMu&_nc_oc=AdrjElsPHDKQsO9OzPgDlAxuWQKmgJp2T5sBcZkuVahWzlSDNSvfddnuhr32vOux4po&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqfI5QRAszEpma6_ugF7v_keT4cVa1mShnqQMfxPkSIA&oe=6A7F2341"}, {"file_name": "migrated_image.png", "id": "550870692209943", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_325574217876642_8926442638236712960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeGDa83EWmMQ7kNvwHNEHEo&_nc_oc=AdoGgMLJ8bUjWeOLJjuMvhCqHCYGeeUx_NZD108oJSd-ix8ylrJ5-4rEHGSGaFZUoiY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF55Gob5n4Q00umrRANsA5Ejmb1g_o9BAu_iS-DnHObpQ&oe=6A7F1C6C"}, {"file_name": "migrated_image.png", "id": "203876624265899", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162690_318859825210567_4629106843866628096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjJGKstvtQYQ7kNvwFO1TSb&_nc_oc=AdqSwpcqHG0bBoQSBnm4K3eToo-v8bZS1409SDU3rT5alQlE7PSOI5qYkLWg-Mzy-Pk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXpDpN-yZh_EcxKhJmvwczMmcWau-a8YyoAEOg1FG8dg&oe=6A7EF595"}, {"file_name": "migrated_image.png", "id": "3171466972898695", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162675_224662891379134_6592421203292454912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_d2cNDi6BgQ7kNvwF_Z8vj&_nc_oc=Ado40g_ntnvsELlJhcKz0Oa7CfyQwIcLVNlJsTj2-dSaI7Z6soEbmB4a81_DEn9Zs1c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXH3nd3Bj6QGJaladRQvKPAZUXbPzGsmBhDq3hQzm4cA&oe=6A7EF4BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoorRooma.png", "id": "139347326635067", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162678_139347329968400_1670297392546578432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtEpSKYpVlEQ7kNvwG0OOYm&_nc_oc=AdqpoFLd1YULscoNsqKh_ckYNZnUQTF3WvKugxIcu3yYeceMJJa4sXbI-IOx037Abu8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoGcD9tO3hUw8gU6eTbOdOx7rnd4jmhF_ITzT0C3JxxQ&oe=6A7F11A8"}, "display_name": "MindFulVR", "keywords": ["Mindfulness", "Meditation", "Wellbeing", "Stress", "Anxiety"], "long_description": "Welcome to MindFulVR, your safe place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will assist you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being.\n\nDiscover a part of Mindfulness, known as the Body Scan (7 mins), which will assist you recognize feelings of \"dis-ease\" in your body, and using a simple affirmation, how you might accept these feelings.\n\nSerenity will guide you through a fingertip tapping practice, known as the Emotional Freedom Technique (10 mins), which combines ancient acupressure with modern psychology, and helps you affirm your emotions, as you tap around your energy points.\n\nIreland\u2019s ancient landscape has a long association with well-being and self-healing. MindFulVR includes a handpicked selection of these ancient Irish locations, as 360-degree immersive VR videos, for you to practice your Body Scan, all inside our MindFulVR app.", "short_description": "Welcome to MindFulVR, your place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will lead you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being. This will be your true and meaningful, mindful and soulful journey of acceptance."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mindmyths.eu/privacy-policy/", "developer_terms_of_service_url": "http://mindmyths.eu/terms-of-service/", "publisher_name": "MindMyths", "support_website_url": null, "website_url": "http://www.mindmyths.eu/the-app/", "category": "APPS", 
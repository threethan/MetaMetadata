1.oculuscdn.com/v/t64.5771-25/11162722_1691017657866242_6527890522260897792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXbPuSFx90QQ7kNvwFIDrq0&_nc_oc=AdqhhaJNUU8z97pTLSYdMeDY7b5P4VZm6ewsyTUm5CVMEO4re4l0VX0-m4iPKCY3_tI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEPnEhbAizeyqsUdi1tb5Jy8BV76pSOM8K41mpq0fcsA&oe=6A5E2DC1"}, {"file_name": "migrated_image.png", "id": "550870692209943", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_325574217876642_8926442638236712960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amccJXu5tOQQ7kNvwFmZp18&_nc_oc=Adp-6sT46y0rZBS_nyXZsJj6yc_Z_Dcb0Y4SSmWgjjL77Q8qvcklmoKHxNkNB7QfRqw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD12CKV2A1HaQxvlL4gTsbDr2jF9AI7ApHWezPBa8BExQ&oe=6A5E26EC"}, {"file_name": "migrated_image.png", "id": "203876624265899", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162690_318859825210567_4629106843866628096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeN0F1fETk4Q7kNvwGNmoTe&_nc_oc=AdruZCqjrNisrlylAYG2B1Qn1jP-CXrmP7EOcPdF-5cZ_876u4mRaAE2N8z-9kYc5Uc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYIKNItUfbQr4dZqODggtLG6L9hxzP2AOUPrbmK0GvLw&oe=6A5E3855"}, {"file_name": "migrated_image.png", "id": "3171466972898695", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162675_224662891379134_6592421203292454912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzL1K3mxyyoQ7kNvwHcPGmQ&_nc_oc=Adro0MGaauBlVrI42lfy7QUteXFMJe_Pn6CcJu3MJe3OrUsTmNC6IjaN7nZ4Mcxaj3U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA64Fsn8VAhROJNzeUNcumyTDle3J6-kmPLTqe-AtuQ-w&oe=6A5E377D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoorRooma.png", "id": "139347326635067", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162678_139347329968400_1670297392546578432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oT8ZwZL8N4Q7kNvwECzIcY&_nc_oc=AdpsuUSHFz3j5uS4QP0UIFxHeyHPQDWQ7YazyJjKzwIKjfyMspima3CovV52TOr7wVo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjQYfZb-qBfaTFZi37vb07f6y5p3eDE5asHqjIUPwY4Q&oe=6A5E1C28"}, "display_name": "MindFulVR", "keywords": ["Mindfulness", "Meditation", "Wellbeing", "Stress", "Anxiety"], "long_description": "Welcome to MindFulVR, your safe place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will assist you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being.\n\nDiscover a part of Mindfulness, known as the Body Scan (7 mins), which will assist you recognize feelings of \"dis-ease\" in your body, and using a simple affirmation, how you might accept these feelings.\n\nSerenity will guide you through a fingertip tapping practice, known as the Emotional Freedom Technique (10 mins), which combines ancient acupressure with modern psychology, and helps you affirm your emotions, as you tap around your energy points.\n\nIreland\u2019s ancient landscape has a long association with well-being and self-healing. MindFulVR includes a handpicked selection of these ancient Irish locations, as 360-degree immersive VR videos, for you to practice your Body Scan, all inside our MindFulVR app.", "short_description": "Welcome to MindFulVR, your place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will lead you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being. This will be your true and meaningful, mindful and soulful journey of acceptance."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mindmyths.eu/privacy-policy/", "developer_terms_of_service_url": "http://mindmyths.eu/terms-of-service/", "publisher_name": "MindMyths", "support_website_url": null, "website_url": "http://www.mindmyths.eu/the-app/", "category": "APPS", 
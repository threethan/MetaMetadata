1.oculuscdn.com/v/t64.5771-25/11162722_1691017657866242_6527890522260897792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPdRoSx-sa4Q7kNvwFyxZiW&_nc_oc=Adrogv5LcyJBgztCY_sgeS_f110WmBG7g2l8E6SLYQcgwRe6nGkj0vKWwaZ3MAlYQfs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoapnVwUPTAT4bYTeZSIWVnkp2l-_9spsepPix6dSYPg&oe=6A4D0A41"}, {"file_name": "migrated_image.png", "id": "550870692209943", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_325574217876642_8926442638236712960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oSUe--dnJkQ7kNvwEBrGRu&_nc_oc=Adqb-FD0_UDk_hAA7kcdbfep8OrCm5his2nlWULa3NbtJqVLHjO33sS6rHvQMz8pkGk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyhsmkGZOoLZFsTYKnRQ2jxQhgdGToDOLrnjFXpeINyA&oe=6A4D036C"}, {"file_name": "migrated_image.png", "id": "203876624265899", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162690_318859825210567_4629106843866628096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZwMsmuzNwUQ7kNvwFDemj2&_nc_oc=AdqorUb30ROsW1_kNbqbY2_YsKRSZaMIbYsY51yr2a-fPArgUYROMsU_x6cHBo28mss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-8OADudF9mvCvCBApAV0fWMn1bX2tKv7L5zlXvShXNA&oe=6A4D14D5"}, {"file_name": "migrated_image.png", "id": "3171466972898695", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162675_224662891379134_6592421203292454912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6nHb2kb6gsQ7kNvwHaL8yG&_nc_oc=AdogqitzbdiXlrXbWvbaNLzNdPvreat7SVKse_eyLX371wKMKk8VcyRhdA-O1ACOKnM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMNPVBHDKVHDy-7O0F2gAr8GoPxPG_iO74-IrI3hbQ6g&oe=6A4D13FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoorRooma.png", "id": "139347326635067", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162678_139347329968400_1670297392546578432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAwvhdVvIykQ7kNvwGDlNLp&_nc_oc=Adps2e_Iy7iaUNGXq5Ll5a6bwBbNILU6tODaGXcylxF1gKHYoRLk_vBh5ESeLUhOg6U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHl8Rm8e0uNQGZiwvQxpL9cfDq-66RYmE5D2FowkcRFw&oe=6A4CF8A8"}, "display_name": "MindFulVR", "keywords": ["Mindfulness", "Meditation", "Wellbeing", "Stress", "Anxiety"], "long_description": "Welcome to MindFulVR, your safe place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will assist you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being.\n\nDiscover a part of Mindfulness, known as the Body Scan (7 mins), which will assist you recognize feelings of \"dis-ease\" in your body, and using a simple affirmation, how you might accept these feelings.\n\nSerenity will guide you through a fingertip tapping practice, known as the Emotional Freedom Technique (10 mins), which combines ancient acupressure with modern psychology, and helps you affirm your emotions, as you tap around your energy points.\n\nIreland\u2019s ancient landscape has a long association with well-being and self-healing. MindFulVR includes a handpicked selection of these ancient Irish locations, as 360-degree immersive VR videos, for you to practice your Body Scan, all inside our MindFulVR app.", "short_description": "Welcome to MindFulVR, your place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will lead you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being. This will be your true and meaningful, mindful and soulful journey of acceptance."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mindmyths.eu/privacy-policy/", "developer_terms_of_service_url": "http://mindmyths.eu/terms-of-service/", "publisher_name": "MindMyths", "support_website_url": null, "website_url": "http://www.mindmyths.eu/the-app/", "category": "APPS", 
1.oculuscdn.com/v/t64.5771-25/11162722_1691017657866242_6527890522260897792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wQ_3vrOrpAQ7kNvwGMf7hh&_nc_oc=AdrpPaCHG8pyKzMWzhxpO1iyfYWHJI6sB0e314QWRljYcP857CUFa4qjPTvzfckMOeg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZLavolVX9QqL5cKVdkoI7ML8qvx-_rtVppPmtkaZoDg&oe=6A199FC1"}, {"file_name": "migrated_image.png", "id": "550870692209943", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162701_325574217876642_8926442638236712960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mlbiG0sFV0Q7kNvwFFjGDi&_nc_oc=Adr1YHd-JmVQv33SbOAR0e7Amcm908UXa-w0u4fmGIEaoWUPk3TOBzD81iLEiUKK6hI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73D9pQQB4fBcw-vXzEJ2A_MdfvqkOtk3dDphb1X9PelA&oe=6A1998EC"}, {"file_name": "migrated_image.png", "id": "203876624265899", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162690_318859825210567_4629106843866628096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsgCCfkId2UQ7kNvwGNWQ2E&_nc_oc=AdpGcL76VvU6jWZqThAmuoa7qpGGyaYM4KRI9PBnMF-XeF7N_6L0FvZ32js5iIZyRF0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7q2JdNazxY7J2UpBSZCpezp-AouJUB_b4gnCYQ_V0Tkw&oe=6A19AA55"}, {"file_name": "migrated_image.png", "id": "3171466972898695", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162675_224662891379134_6592421203292454912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVgMV8YrNI0Q7kNvwHB5Udg&_nc_oc=AdoIF9aMzN8vM9qNgQQL3R8WdeRRqilLq0rZ5OCxkDItQ_PFUufFIaXueiDsm-aP_Mg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62AWuIAZ5h4JYjTqxgEjJHnLgAM07xNOA8ijLDaqoGRg&oe=6A19A97D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoorRooma.png", "id": "139347326635067", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162678_139347329968400_1670297392546578432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZx3WY926yUQ7kNvwFY4VQ9&_nc_oc=Ado-LXRqvB3EiimerROOFkPV16hagO_o9E1WtdN5tDA1Pi2-cHVDovmA8IeQI0zgYF8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DGUFV1ydhaT7lfUAgeMygQd9hq-3Htn-qVUMMznOr2g&oe=6A198E28"}, "display_name": "MindFulVR", "keywords": ["Mindfulness", "Meditation", "Wellbeing", "Stress", "Anxiety"], "long_description": "Welcome to MindFulVR, your safe place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will assist you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being.\n\nDiscover a part of Mindfulness, known as the Body Scan (7 mins), which will assist you recognize feelings of \"dis-ease\" in your body, and using a simple affirmation, how you might accept these feelings.\n\nSerenity will guide you through a fingertip tapping practice, known as the Emotional Freedom Technique (10 mins), which combines ancient acupressure with modern psychology, and helps you affirm your emotions, as you tap around your energy points.\n\nIreland\u2019s ancient landscape has a long association with well-being and self-healing. MindFulVR includes a handpicked selection of these ancient Irish locations, as 360-degree immersive VR videos, for you to practice your Body Scan, all inside our MindFulVR app.", "short_description": "Welcome to MindFulVR, your place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will lead you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being. This will be your true and meaningful, mindful and soulful journey of acceptance."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mindmyths.eu/privacy-policy/", "developer_terms_of_service_url": "http://mindmyths.eu/terms-of-service/", "publisher_name": "MindMyths", "support_website_url": null, "website_url": "http://www.mindmyths.eu/the-app/", "category": "APPS", 
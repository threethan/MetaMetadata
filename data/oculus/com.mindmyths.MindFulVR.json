1.oculuscdn.com/v/t64.5771-25/11162722_1691017657866242_6527890522260897792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoMObo2gDZEQ7kNvwG6jPx2&_nc_oc=AdpdopFFxBHGff3MyawYgecnxQmovR9VsJbDiwAClPP6Klg51JGKD6wtHWQJ4ffFWsI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Zn8t8GfKS1VxQMm6eYXwafu4tMp3Do5p1D0C47V4Dgw&oe=6A087C41"}, {"file_name": "migrated_image.png", "id": "550870692209943", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_325574217876642_8926442638236712960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSgA_htRqFkQ7kNvwGmkQex&_nc_oc=Adrwo5jfvujf_Cl0mlIghKvzM94Ctuzh2oR3RvYJWd_UCu3aPp73gjIOhxF4Wv9HrQo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VHpQTsQaghsw7phcKTz--63-r7NEbm-mIDOCOHsA8KQ&oe=6A08756C"}, {"file_name": "migrated_image.png", "id": "203876624265899", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162690_318859825210567_4629106843866628096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-T0MgjqSdR8Q7kNvwEumw3m&_nc_oc=AdqvsjsH_AT6wrTSQ8eFdOJ9sxzR3RV9taydbkecWNLM9JpLeJX3alPpkqLX2vLuQFs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-WShpe1d47O-VRAETD-YK5J3OKSYCeVnRoCCm8uKJUg&oe=6A0886D5"}, {"file_name": "migrated_image.png", "id": "3171466972898695", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162675_224662891379134_6592421203292454912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIteHpp0aSIQ7kNvwHMgER3&_nc_oc=Adr0gfUHS2KfreGYt__xXkAxG20F5CVqf9QApJQ1_s3geJSSO7wgdAw3lSIdTNQOcro&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-pK486iLdlBQmMKJlIm6mgGHUz01vKY4ecCcd-ixKBA&oe=6A0885FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoorRooma.png", "id": "139347326635067", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162678_139347329968400_1670297392546578432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wb4qQ00ftHQQ7kNvwF6R3y3&_nc_oc=Adrz7rUDRN7Y-9FdmBzfdWwEq0wS_6NmL2bKBNygl_8QWCw1qGOlP67MAA5eZlj8yK0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78pcGMAyXwbg8G-DPfWM936IRc5AquU6gO-oMq5qBRbQ&oe=6A086AA8"}, "display_name": "MindFulVR", "keywords": ["Mindfulness", "Meditation", "Wellbeing", "Stress", "Anxiety"], "long_description": "Welcome to MindFulVR, your safe place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will assist you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being.\n\nDiscover a part of Mindfulness, known as the Body Scan (7 mins), which will assist you recognize feelings of \"dis-ease\" in your body, and using a simple affirmation, how you might accept these feelings.\n\nSerenity will guide you through a fingertip tapping practice, known as the Emotional Freedom Technique (10 mins), which combines ancient acupressure with modern psychology, and helps you affirm your emotions, as you tap around your energy points.\n\nIreland\u2019s ancient landscape has a long association with well-being and self-healing. MindFulVR includes a handpicked selection of these ancient Irish locations, as 360-degree immersive VR videos, for you to practice your Body Scan, all inside our MindFulVR app.", "short_description": "Welcome to MindFulVR, your place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will lead you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being. This will be your true and meaningful, mindful and soulful journey of acceptance."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mindmyths.eu/privacy-policy/", "developer_terms_of_service_url": "http://mindmyths.eu/terms-of-service/", "publisher_name": "MindMyths", "support_website_url": null, "website_url": "http://www.mindmyths.eu/the-app/", "category": "APPS", 
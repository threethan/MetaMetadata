1.oculuscdn.com/v/t64.5771-25/11162722_1691017657866242_6527890522260897792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMU5z9pkc1kQ7kNvwE_ZpPn&_nc_oc=AdpWHnp5damyUNLuqUJ1lOYEH0Shj_pw5wdkgPzoyJAoEb0aSKr9xbeVmXLrI5SGTfU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmPWAGNOBkpJq7CAYwqi-BUymcutETzAJ0F_y5lzMWOQ&oe=6A8C1A01"}, {"file_name": "migrated_image.png", "id": "550870692209943", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_325574217876642_8926442638236712960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWb1oW-EVl4Q7kNvwH_Yu1B&_nc_oc=AdriACEiDV4cJaQd7CycnXeVrq9OJ0FGGBCXxVQUnp1ai23TcyZIItsTfETEu4bEjyo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtpAENqU6wklNv_tvmemhQiao1dbMXB-mskasg5QStsA&oe=6A8C132C"}, {"file_name": "migrated_image.png", "id": "203876624265899", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162690_318859825210567_4629106843866628096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpbZa2kz9t4Q7kNvwHLS8cC&_nc_oc=AdoWHdVcNBdEUyzEvwVYsXytKhtt6VgbWQKvKWFQECK9q-PtFbpHdhud6cELQoCpiYg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESDJqJOBO93u8GjT21k0rSFLyjy32LGLsslZGqbiafrA&oe=6A8C2495"}, {"file_name": "migrated_image.png", "id": "3171466972898695", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162675_224662891379134_6592421203292454912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsoFNABSHWkQ7kNvwHp6icL&_nc_oc=AdoAcTA-76PblFKG3QuwTufG-3xpSKYcsliOuDhsTsR0q-Tz28HBLCyW3749ZF7d_f0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMEeBQXgSvr51lQjq4S-QzgOg_gHhKpt6e1EBX11g87g&oe=6A8C23BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoorRooma.png", "id": "139347326635067", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162678_139347329968400_1670297392546578432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=camgyHAhZJUQ7kNvwGZl_OJ&_nc_oc=AdpDCqcWO4jXWskmkTTZQy9xgPyNtIJzIcNAfpZiF-ph7QW8V2GALtQrduaMWvOlXKE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnBSGyZ0AdSiZP1Wo_uj_fJpyLz9icEXHjKn9LlSLuBQ&oe=6A8C40A8"}, "display_name": "MindFulVR", "keywords": ["Mindfulness", "Meditation", "Wellbeing", "Stress", "Anxiety"], "long_description": "Welcome to MindFulVR, your safe place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will assist you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being.\n\nDiscover a part of Mindfulness, known as the Body Scan (7 mins), which will assist you recognize feelings of \"dis-ease\" in your body, and using a simple affirmation, how you might accept these feelings.\n\nSerenity will guide you through a fingertip tapping practice, known as the Emotional Freedom Technique (10 mins), which combines ancient acupressure with modern psychology, and helps you affirm your emotions, as you tap around your energy points.\n\nIreland\u2019s ancient landscape has a long association with well-being and self-healing. MindFulVR includes a handpicked selection of these ancient Irish locations, as 360-degree immersive VR videos, for you to practice your Body Scan, all inside our MindFulVR app.", "short_description": "Welcome to MindFulVR, your place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will lead you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being. This will be your true and meaningful, mindful and soulful journey of acceptance."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mindmyths.eu/privacy-policy/", "developer_terms_of_service_url": "http://mindmyths.eu/terms-of-service/", "publisher_name": "MindMyths", "support_website_url": null, "website_url": "http://www.mindmyths.eu/the-app/", "category": "APPS", 
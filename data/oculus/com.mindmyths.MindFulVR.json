1.oculuscdn.com/v/t64.5771-25/11162722_1691017657866242_6527890522260897792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYiBQfymydgQ7kNvwExSwVF&_nc_oc=Adq1YXJtgiLoKY-zjef_QCHSLCHr2skW5AtbF8-dwxw_mSIojt4_74A0Tp0ZdefLtTY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26mktNKHmDobG5nTpcKUWhMsg33D2XJhmMobivwyYleQ&oe=69EE1E41"}, {"file_name": "migrated_image.png", "id": "550870692209943", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_325574217876642_8926442638236712960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zV3CjmhDbmoQ7kNvwGyHqvp&_nc_oc=Adqysk8HSc23JIMeOZnnBe66TnmuqMXqc8WI8xDIU7nOMPj_VhuF_h5LRdkyCdznV5A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TOlE3GpzOO_7FQKCOPBljvlsKQJkQs4J9FY_hlL_5XA&oe=69EE176C"}, {"file_name": "migrated_image.png", "id": "203876624265899", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162690_318859825210567_4629106843866628096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pW1uT0BOtPYQ7kNvwFrrMa8&_nc_oc=Adpoem6BE8vnmT9TTEBjsIpfdBvaNErJ-S0WfNLfEbObikEJ7aBiDvT_q6BiMb8KYG0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10Bz26eOOoHCiE4SRvWaTRcJiK6vDVL8fEPkhxGc4Phg&oe=69EE28D5"}, {"file_name": "migrated_image.png", "id": "3171466972898695", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162675_224662891379134_6592421203292454912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DO-aT9H7gogQ7kNvwEQ_L5w&_nc_oc=AdokQo3muNXm2tvr812Gr0FEOz6mxQi2pY5qLME7lm5tIwW1uV5LNAiipGLU9sCh0No&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17ZTzbLTAs9VQUvAxf3ztuvPvIYkE2cLuNUAO0aQnfiA&oe=69EE27FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoorRooma.png", "id": "139347326635067", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162678_139347329968400_1670297392546578432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPsNtnvtowcQ7kNvwH6UgKp&_nc_oc=AdrGTWGgqKUxpCdoAyudJdXzGy5di0VnBoVF12B7a4wRc10KgLUglpHICW_Ct2uxqMo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0I8B23GVVpRjt2yoS1XLYmCRhFD5ZkcR4fF2EQWspFIQ&oe=69EE0CA8"}, "display_name": "MindFulVR", "keywords": ["Mindfulness", "Meditation", "Wellbeing", "Stress", "Anxiety"], "long_description": "Welcome to MindFulVR, your safe place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will assist you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being.\n\nDiscover a part of Mindfulness, known as the Body Scan (7 mins), which will assist you recognize feelings of \"dis-ease\" in your body, and using a simple affirmation, how you might accept these feelings.\n\nSerenity will guide you through a fingertip tapping practice, known as the Emotional Freedom Technique (10 mins), which combines ancient acupressure with modern psychology, and helps you affirm your emotions, as you tap around your energy points.\n\nIreland\u2019s ancient landscape has a long association with well-being and self-healing. MindFulVR includes a handpicked selection of these ancient Irish locations, as 360-degree immersive VR videos, for you to practice your Body Scan, all inside our MindFulVR app.", "short_description": "Welcome to MindFulVR, your place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will lead you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being. This will be your true and meaningful, mindful and soulful journey of acceptance."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mindmyths.eu/privacy-policy/", "developer_terms_of_service_url": "http://mindmyths.eu/terms-of-service/", "publisher_name": "MindMyths", "support_website_url": null, "website_url": "http://www.mindmyths.eu/the-app/", "category": "APPS", 
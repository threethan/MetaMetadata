tent-iad3-2.oculuscdn.com&oh=00_Af3BPdLDLYrUfWWcNksPovMHS0yri91rRKI2QMxDAcDnzA&oe=69F0BA6C"}, {"file_name": "migrated_image.png", "id": "203876624265899", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162690_318859825210567_4629106843866628096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ct79cmOpVIQ7kNvwGmglpm&_nc_oc=AdqIGu75QYzVbD3gl2_JrJ2VcUBpZ3ff5_u2dWpbliTA8sYLwNbSCr3dKyznBLCg3fA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0wcS2tq-89dHE0okrf8Z04_zb5GRNSbGihYpLUMX6_6Q&oe=69F0CBD5"}, {"file_name": "migrated_image.png", "id": "3171466972898695", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162675_224662891379134_6592421203292454912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DO-aT9H7gogQ7kNvwFa2v9D&_nc_oc=Adpb8EENjNuLPDjX5fZAY5_JTan6pVP8kBojWenNdpOKhSpbLi59D9U9to-fy-AqBK8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2Yu-gbTyeDGw4IJO7lsgf15ANNqguAm_eTHxd_cHhJ1A&oe=69F0CAFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoorRooma.png", "id": "139347326635067", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162678_139347329968400_1670297392546578432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPsNtnvtowcQ7kNvwGPhJrF&_nc_oc=AdqaUqh7volqk2YKBvYZewgtspz8AULsDVhOORcvV4H9lMsFBP1fcq8SsYRPUEjKCAw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3D4-2cFUbsOUBoj9SiTmLXpFjurdV_KAUPZnHuTWrabg&oe=69F0AFA8"}, "display_name": "MindFulVR", "keywords": ["Mindfulness", "Meditation", "Wellbeing", "Stress", "Anxiety"], "long_description": "Welcome to MindFulVR, your safe place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will assist you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being.\n\nDiscover a part of Mindfulness, known as the Body Scan (7 mins), which will assist you recognize feelings of \"dis-ease\" in your body, and using a simple affirmation, how you might accept these feelings.\n\nSerenity will guide you through a fingertip tapping practice, known as the Emotional Freedom Technique (10 mins), which combines ancient acupressure with modern psychology, and helps you affirm your emotions, as you tap around your energy points.\n\nIreland\u2019s ancient landscape has a long association with well-being and self-healing. MindFulVR includes a handpicked selection of these ancient Irish locations, as 360-degree immersive VR videos, for you to practice your Body Scan, all inside our MindFulVR app.", "short_description": "Welcome to MindFulVR, your place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will lead you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being. This will be your true and meaningful, mindful and soulful journey of acceptance."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mindmyths.eu/privacy-policy/", "developer_terms_of_service_url": "http://mindmyths.eu/terms-of-service/", "publisher_name": "MindMyths", "support_website_url": null, "website_url": "http://www.mindmyths.eu/the-app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "487756789388554"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "328428267640971"}, {"status": "PUBLISHED", "id": "1465816666801195"}, {
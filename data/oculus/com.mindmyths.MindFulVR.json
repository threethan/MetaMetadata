1.oculuscdn.com/v/t64.5771-25/11162722_1691017657866242_6527890522260897792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5R8p1Z5fzaEQ7kNvwHwentK&_nc_oc=Adpli9UkzLn_9GEAIRs5XPw4gfzTdNhBkdh0vZYQ1zFRQ1azu1gLcIbjxddtXvzmPvw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTA_RmC5vPKRL_AE0GQdSnVkj2SR1hw3F4xs0hYDRn5A&oe=6A6B5CC1"}, {"file_name": "migrated_image.png", "id": "550870692209943", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_325574217876642_8926442638236712960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-173Ett7nrkQ7kNvwHioZPb&_nc_oc=AdpwkTwvHuBrVjYIZTm0hHN6_25fCQr2zaU_ld7ZlwQeGwQ0cfRrvIp3hJDLirVinn8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-LwWEzcS_l-8Le0bAU4P_-JplYkPWnjupUhdLSoIQVw&oe=6A6B55EC"}, {"file_name": "migrated_image.png", "id": "203876624265899", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162690_318859825210567_4629106843866628096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HzP3mKPalIQ7kNvwGAdG2R&_nc_oc=Adr0jPTS46kFW5POlJlmhCPNzdlAX0bSGx1ZJgmaWT1T9a7J3YrszHZZIBQwM6Hcb6A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNnzsNbFhzAyTd0cGTcinQOCBHazvRC3CXv-9fuE80Wg&oe=6A6B6755"}, {"file_name": "migrated_image.png", "id": "3171466972898695", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162675_224662891379134_6592421203292454912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71LyRmEBkXsQ7kNvwGhjqWW&_nc_oc=Adr70FUhn0Vz015USJZf_06q1njmcKF0a11hqPR8pAXRVpfa3WUlGOwzRfrVpk8e_1c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB94N4HdwnL2Xp_qzgredYefhDeggMex6p2TCcmX0VGsQ&oe=6A6B667D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoorRooma.png", "id": "139347326635067", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162678_139347329968400_1670297392546578432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-uSsbgUkMUQ7kNvwH4zxPY&_nc_oc=Adosv0npC6utnMb3z-O2Drv2JqCoEIekbhpYw0HjIRZG8d1kChcaBzKacVNd-lswBiE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKZN8Zw5mPOUUgL3iOlAGVZXo_1UGAh3XVmheU4nXlWQ&oe=6A6B4B28"}, "display_name": "MindFulVR", "keywords": ["Mindfulness", "Meditation", "Wellbeing", "Stress", "Anxiety"], "long_description": "Welcome to MindFulVR, your safe place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will assist you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being.\n\nDiscover a part of Mindfulness, known as the Body Scan (7 mins), which will assist you recognize feelings of \"dis-ease\" in your body, and using a simple affirmation, how you might accept these feelings.\n\nSerenity will guide you through a fingertip tapping practice, known as the Emotional Freedom Technique (10 mins), which combines ancient acupressure with modern psychology, and helps you affirm your emotions, as you tap around your energy points.\n\nIreland\u2019s ancient landscape has a long association with well-being and self-healing. MindFulVR includes a handpicked selection of these ancient Irish locations, as 360-degree immersive VR videos, for you to practice your Body Scan, all inside our MindFulVR app.", "short_description": "Welcome to MindFulVR, your place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will lead you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being. This will be your true and meaningful, mindful and soulful journey of acceptance."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mindmyths.eu/privacy-policy/", "developer_terms_of_service_url": "http://mindmyths.eu/terms-of-service/", "publisher_name": "MindMyths", "support_website_url": null, "website_url": "http://www.mindmyths.eu/the-app/", "category": "APPS", 
1.oculuscdn.com/v/t64.5771-25/11162722_1691017657866242_6527890522260897792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leU9jSDCGhwQ7kNvwGTF3cy&_nc_oc=AdqWcw4JE5uB_PUO5UCwvm30130VuX9v1R7PTd6MhaMzcQqF_cDERagjY7GdNZ7Kn4k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5auIm0WzPjU3uwifxOdZV9oVvrxPb2bmm_pL1qCfkXQ&oe=6AF9BEC1"}, {"file_name": "migrated_image.png", "id": "550870692209943", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162701_325574217876642_8926442638236712960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fDvVha3ijIQ7kNvwF5kb_P&_nc_oc=AdoxGw6nJIsXn3uY6FRgaIueVXxF7FbNIqBFOCwL0XZ3yzpEDYgpQ7ZW-QgD_2zD7CE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcikiTz21peQYIIA1Vlo3zi0DT-nFYSID0G22x8VO-zQ&oe=6AF9B7EC"}, {"file_name": "migrated_image.png", "id": "203876624265899", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162690_318859825210567_4629106843866628096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Seds52uR_gQ7kNvwGbe-Vn&_nc_oc=AdoyECmXWN5zNtRKxOVYsMfM9VRRzkaCl9nbSaUeTYRH8zi-N3LmrHR3jV6XuSpf5eo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDaSTac2HU7Q_StCvcCHU3GuL4IArE1IQfDpW4JKxANw&oe=6AF9C955"}, {"file_name": "migrated_image.png", "id": "3171466972898695", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162675_224662891379134_6592421203292454912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpONkv1A8SkQ7kNvwFjueL-&_nc_oc=AdpPxgy0ar7mBf0CiWSPhEXvcFyS7OSw2QSfDhc3pYkKp-A56t65o2OmUzjaBzanQUI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5hgm6mJCTUGKlWJV9rTxN_I3K2kf7yHPj4vJ91QP3ew&oe=6AF9C87D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoorRooma.png", "id": "139347326635067", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162678_139347329968400_1670297392546578432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f652kCq1QNMQ7kNvwGpWRXi&_nc_oc=AdqkC0jHhwWMMxxr_6Vux1Pkoov72RgUkM2I1WeldgfBy40qSPGeEpE85ojRMw5B9fM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrs1GHDCzJmSTn5pO5d__kH2B7auc9bQ8SKG2c3xYL4Q&oe=6AF9E568"}, "display_name": "MindFulVR", "keywords": ["Mindfulness", "Meditation", "Wellbeing", "Stress", "Anxiety"], "long_description": "Welcome to MindFulVR, your safe place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will assist you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being.\n\nDiscover a part of Mindfulness, known as the Body Scan (7 mins), which will assist you recognize feelings of \"dis-ease\" in your body, and using a simple affirmation, how you might accept these feelings.\n\nSerenity will guide you through a fingertip tapping practice, known as the Emotional Freedom Technique (10 mins), which combines ancient acupressure with modern psychology, and helps you affirm your emotions, as you tap around your energy points.\n\nIreland\u2019s ancient landscape has a long association with well-being and self-healing. MindFulVR includes a handpicked selection of these ancient Irish locations, as 360-degree immersive VR videos, for you to practice your Body Scan, all inside our MindFulVR app.", "short_description": "Welcome to MindFulVR, your place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will lead you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being. This will be your true and meaningful, mindful and soulful journey of acceptance."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mindmyths.eu/privacy-policy/", "developer_terms_of_service_url": "http://mindmyths.eu/terms-of-service/", "publisher_name": "MindMyths", "support_website_url": null, "website_url": "http://www.mindmyths.eu/the-app/", "category": "APPS", 
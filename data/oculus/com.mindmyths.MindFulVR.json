1.oculuscdn.com/v/t64.5771-25/11162722_1691017657866242_6527890522260897792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4eWk9phj3sQ7kNvwEoYPQl&_nc_oc=AdoeeeFyoTsxMoAyPBlvG6Md59it4fa0_axBRqxqufT2pHGLD8HdY197neIOAaf_o-A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00BFqvsBUgC9G-4vMBa_fDZ-0iAKkkDaUN4bj-200HFA&oe=69E63541"}, {"file_name": "migrated_image.png", "id": "550870692209943", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162701_325574217876642_8926442638236712960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDgtLeIro9wQ7kNvwGXkZIs&_nc_oc=AdrDyPHjiFgZfzMlEqEeMafaKfV2O6UqR8y-AddCR0U7-FDNsJlNlCIhM08Ko57Cu64&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Qqng3_eAc8Xmpy5DDAYKZlpr71iTITMmrvXeZLYvdMg&oe=69E62E6C"}, {"file_name": "migrated_image.png", "id": "203876624265899", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162690_318859825210567_4629106843866628096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sphLWEt4fOsQ7kNvwEf9Emj&_nc_oc=AdoRlYIcdpnxU0w8sXgPHSHoPo1oqy6h_jUUMnBfXn2iVEVj6C9nvXe183pr97pHtvM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cLOWfgTtglmOQDEnQlbfHUmi4CqwCAollhPUhIxckTw&oe=69E63FD5"}, {"file_name": "migrated_image.png", "id": "3171466972898695", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162675_224662891379134_6592421203292454912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsJqUp0k5JsQ7kNvwE3cJ4A&_nc_oc=AdrhP-t_6PmZgtFDKbpKU7kaBem9Ww8qxxL9kVoIZARuhv80-2JcMDYuRseehN1jwI8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tLlsPvPPsxcPIgeNNUxXHxgPQjh5TimYTLdBGn8-y-A&oe=69E63EFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoorRooma.png", "id": "139347326635067", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162678_139347329968400_1670297392546578432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9cmkwwlzd8Q7kNvwGqLGwZ&_nc_oc=Adp9x4tTmygBMgb5S0XKE1qNn1lEe39_dGh39nJXImdmhMTSLN0HL_iOFwwMkrCdcG4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ut4fl4EoELL2cJ2uysVpmjOYiGD8JUeiWKfzAirLs-w&oe=69E623A8"}, "display_name": "MindFulVR", "keywords": ["Mindfulness", "Meditation", "Wellbeing", "Stress", "Anxiety"], "long_description": "Welcome to MindFulVR, your safe place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will assist you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being.\n\nDiscover a part of Mindfulness, known as the Body Scan (7 mins), which will assist you recognize feelings of \"dis-ease\" in your body, and using a simple affirmation, how you might accept these feelings.\n\nSerenity will guide you through a fingertip tapping practice, known as the Emotional Freedom Technique (10 mins), which combines ancient acupressure with modern psychology, and helps you affirm your emotions, as you tap around your energy points.\n\nIreland\u2019s ancient landscape has a long association with well-being and self-healing. MindFulVR includes a handpicked selection of these ancient Irish locations, as 360-degree immersive VR videos, for you to practice your Body Scan, all inside our MindFulVR app.", "short_description": "Welcome to MindFulVR, your place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will lead you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being. This will be your true and meaningful, mindful and soulful journey of acceptance."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mindmyths.eu/privacy-policy/", "developer_terms_of_service_url": "http://mindmyths.eu/terms-of-service/", "publisher_name": "MindMyths", "support_website_url": null, "website_url": "http://www.mindmyths.eu/the-app/", "category": "APPS", 
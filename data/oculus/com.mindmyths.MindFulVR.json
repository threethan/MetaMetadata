1.oculuscdn.com/v/t64.5771-25/11162722_1691017657866242_6527890522260897792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ej1tgTmuZuYQ7kNvwFcfdzE&_nc_oc=AdpIvZrm77B020SnNSGdj14AyJUFV3FwI91bv9BZhdIEFb4hSY8SNElQp-nZ7Fxy9oc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rHNE7Z1uq6q1xqCLosfEgSu5CgturU21xLODcd0GT8A&oe=6A1D9441"}, {"file_name": "migrated_image.png", "id": "550870692209943", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162701_325574217876642_8926442638236712960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEeuWd-IRgMQ7kNvwFgsuz3&_nc_oc=Ado7TWPfEx_jL7BK3v3GxuvSswd4EGDnvInaGY91u4sX9STiZWF1FfiVjj2xe2AxxTo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DgVES5IAT8YpaiViVUCVnAPARYcOuVW_zZZwOwZ4fiw&oe=6A1D8D6C"}, {"file_name": "migrated_image.png", "id": "203876624265899", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162690_318859825210567_4629106843866628096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZ0pEYaWYTgQ7kNvwGbk6QR&_nc_oc=AdpNq2676CIkIK02m5DNyAbN5RaSOaelqSX25H741MJR2szLu-C3EjAtTb68592MtjM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-eALjYgzEVjbQwGBsdbx9GGQZs-QSKnuaFONTThTQvw&oe=6A1D9ED5"}, {"file_name": "migrated_image.png", "id": "3171466972898695", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162675_224662891379134_6592421203292454912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oa1c4BhWHAQ7kNvwF_jt-K&_nc_oc=AdqepE4LRTD6NjxsaO74t7ZGinH7INoZ6wRImFyoE7M4Qq2pU24ljAoc0iugjlHPdhY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47R92ksmfxYue6Bohx20h_--RtwrMoDe0hvOrfZiGZxA&oe=6A1D9DFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoorRooma.png", "id": "139347326635067", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162678_139347329968400_1670297392546578432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6DEeHI26poQ7kNvwGFDpnm&_nc_oc=AdoSODJzAHfQRMpO3BtGDf_-wrXIq9XvAZZjE3zE75jIcmYUm281LFtBPdlebEtugZs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69HgGkUBmWD3Dd1JaCHM-B7f5-V3jTplicnrR-Z3fh-g&oe=6A1D82A8"}, "display_name": "MindFulVR", "keywords": ["Mindfulness", "Meditation", "Wellbeing", "Stress", "Anxiety"], "long_description": "Welcome to MindFulVR, your safe place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will assist you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being.\n\nDiscover a part of Mindfulness, known as the Body Scan (7 mins), which will assist you recognize feelings of \"dis-ease\" in your body, and using a simple affirmation, how you might accept these feelings.\n\nSerenity will guide you through a fingertip tapping practice, known as the Emotional Freedom Technique (10 mins), which combines ancient acupressure with modern psychology, and helps you affirm your emotions, as you tap around your energy points.\n\nIreland\u2019s ancient landscape has a long association with well-being and self-healing. MindFulVR includes a handpicked selection of these ancient Irish locations, as 360-degree immersive VR videos, for you to practice your Body Scan, all inside our MindFulVR app.", "short_description": "Welcome to MindFulVR, your place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will lead you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being. This will be your true and meaningful, mindful and soulful journey of acceptance."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mindmyths.eu/privacy-policy/", "developer_terms_of_service_url": "http://mindmyths.eu/terms-of-service/", "publisher_name": "MindMyths", "support_website_url": null, "website_url": "http://www.mindmyths.eu/the-app/", "category": "APPS", 
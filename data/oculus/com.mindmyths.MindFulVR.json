1.oculuscdn.com/v/t64.5771-25/11162722_1691017657866242_6527890522260897792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sYssvNzdkEQ7kNvwGNe7uH&_nc_oc=AdqjRjLL-LYrylGIed26OnYtOdkuofn5EduADf6Nsf2O8iD7B85_yxaj8aeTI07I4SI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJXUzoMJgQYcxYNDm83-trHbs1GDXqfzxVv9C_G-1dlw&oe=6A60D0C1"}, {"file_name": "migrated_image.png", "id": "550870692209943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162701_325574217876642_8926442638236712960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsQ-DE9x1agQ7kNvwFNVC5a&_nc_oc=Adr-BkuLpBZxXOkmmQ7hDIuq8awB0DHKqTQe2O77dlBeU7TBIN7xGSUriYWn0BRHTc0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXAc8q8b4x7dbIg-iZQxAejy4Bi9z_bgDyrCLQI8l7VA&oe=6A60C9EC"}, {"file_name": "migrated_image.png", "id": "203876624265899", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162690_318859825210567_4629106843866628096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TgtIi9XJvkQ7kNvwFEVD-k&_nc_oc=AdpWa29krWGSEfFDzeZSzV3IHA6KwHsQtEuR2noAXoSByvS7J6X5MzKkzo_BKrp68hw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2oX4MQ0Z_CiVMD0I6GCGcVgx7t2ox9MKEOA-uHtKYqQ&oe=6A60A315"}, {"file_name": "migrated_image.png", "id": "3171466972898695", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162675_224662891379134_6592421203292454912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Xr9x_p9FlMQ7kNvwED9aMj&_nc_oc=Adpy2wVyjVJAo_Vv3m41WF9czx0G0de-MKKNkY0b_62dKGUyXFM5OInJrI-nck_G4-U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD992VpND73qpmbrkT_rrF4KJ6lolmNN1Zpv6mA6TddCA&oe=6A60DA7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoorRooma.png", "id": "139347326635067", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162678_139347329968400_1670297392546578432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ko6fkvISyvYQ7kNvwFkRsXI&_nc_oc=AdrAIlQM5LJrbTr8WQAZQ0jwIYj4FdKGY3AlFBTUVsSO6GdnQIu6-v8ZR-gFOeW9ENA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-6k9sxjMGRf9ErVMynLLI4h4_mjSJj2mDCpZh3A8uwg&oe=6A60BF28"}, "display_name": "MindFulVR", "keywords": ["Mindfulness", "Meditation", "Wellbeing", "Stress", "Anxiety"], "long_description": "Welcome to MindFulVR, your safe place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will assist you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being.\n\nDiscover a part of Mindfulness, known as the Body Scan (7 mins), which will assist you recognize feelings of \"dis-ease\" in your body, and using a simple affirmation, how you might accept these feelings.\n\nSerenity will guide you through a fingertip tapping practice, known as the Emotional Freedom Technique (10 mins), which combines ancient acupressure with modern psychology, and helps you affirm your emotions, as you tap around your energy points.\n\nIreland\u2019s ancient landscape has a long association with well-being and self-healing. MindFulVR includes a handpicked selection of these ancient Irish locations, as 360-degree immersive VR videos, for you to practice your Body Scan, all inside our MindFulVR app.", "short_description": "Welcome to MindFulVR, your place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will lead you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being. This will be your true and meaningful, mindful and soulful journey of acceptance."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mindmyths.eu/privacy-policy/", "developer_terms_of_service_url": "http://mindmyths.eu/terms-of-service/", "publisher_name": "MindMyths", "support_website_url": null, "website_url": "http://www.mindmyths.eu/the-app/", "category": "APPS", 
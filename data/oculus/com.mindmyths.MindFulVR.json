_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJwivAxuSVMQ7kNvwHCuahL&_nc_oc=AdrEGbHAwC09v3ajOc1-0FyNVswOF8wnZnNp2_SPPcFfu0c7qhJ3alg28qfseiyNAh0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af19sEjxWHeRxA1OSL5PnvPDVJdfw4-GBnrsDX111yYoSA&oe=69F20BEC"}, {"file_name": "migrated_image.png", "id": "203876624265899", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162690_318859825210567_4629106843866628096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ct79cmOpVIQ7kNvwEBER_8&_nc_oc=AdoyK3bPTMwJUOCO5r-rwW6XWYjncUGvYGAoGIQJWHtHP1FyemjP938t82g0nmohOso&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0glXLrodmEJ_k8fPRO8I5LvFv3IxsqWUgkNK28SSf_8w&oe=69F1E515"}, {"file_name": "migrated_image.png", "id": "3171466972898695", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162675_224662891379134_6592421203292454912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzRAe3Q5yhYQ7kNvwGjOB1W&_nc_oc=AdrLJHmThEa1m-EnlVhCnhwIuIza_2NvYWIP9VCioIbjn13RgvHDbXP3bFaQOEYtr-E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3gHtNCgqhCV6lxcrcYhzzNhNgB9MNRDrY4Y1CWJVq3eQ&oe=69F21C7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoorRooma.png", "id": "139347326635067", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162678_139347329968400_1670297392546578432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bh3mX9lDbsQQ7kNvwEAPo5W&_nc_oc=AdqCb1wv2Li6vM7wBHKvpL8nxdV4PWtKqW4fXMOzviz3nrAMf_hhLriE99YmXclnHxM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0nLAgiyHHmLIwSV1kzlXJHlhPSDZTdR5QjDYT6uUW-BA&oe=69F20128"}, "display_name": "MindFulVR", "keywords": ["Mindfulness", "Meditation", "Wellbeing", "Stress", "Anxiety"], "long_description": "Welcome to MindFulVR, your safe place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will assist you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being.\n\nDiscover a part of Mindfulness, known as the Body Scan (7 mins), which will assist you recognize feelings of \"dis-ease\" in your body, and using a simple affirmation, how you might accept these feelings.\n\nSerenity will guide you through a fingertip tapping practice, known as the Emotional Freedom Technique (10 mins), which combines ancient acupressure with modern psychology, and helps you affirm your emotions, as you tap around your energy points.\n\nIreland\u2019s ancient landscape has a long association with well-being and self-healing. MindFulVR includes a handpicked selection of these ancient Irish locations, as 360-degree immersive VR videos, for you to practice your Body Scan, all inside our MindFulVR app.", "short_description": "Welcome to MindFulVR, your place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will lead you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being. This will be your true and meaningful, mindful and soulful journey of acceptance."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mindmyths.eu/privacy-policy/", "developer_terms_of_service_url": "http://mindmyths.eu/terms-of-service/", "publisher_name": "MindMyths", "support_website_url": null, "website_url": "http://www.mindmyths.eu/the-app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_mode
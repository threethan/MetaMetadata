1.oculuscdn.com/v/t64.5771-25/11162722_1691017657866242_6527890522260897792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sYssvNzdkEQ7kNvwH_Cy7Z&_nc_oc=Adr1jsgB-yMP7qsk2G3ADId_kquLQ2U-InRpVoW_9634V9NNHZWd0Nj_ATme0bk1P_o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBAGFiqN7tVTeiHTfaORBILaL1izdiqmgU8LxJ649meA&oe=6A6373C1"}, {"file_name": "migrated_image.png", "id": "550870692209943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162701_325574217876642_8926442638236712960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsQ-DE9x1agQ7kNvwH8h-Zy&_nc_oc=AdoNRe4Zfp1X_EAk8-ef5nWfjF9AQmUg5yc4L7kW05OyDb5M1gHxXwowMnR14MT1FZ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoNm1uCcLCcMJpC3iVAMEYjXWeojCSSafqo6gE1qHKfA&oe=6A636CEC"}, {"file_name": "migrated_image.png", "id": "203876624265899", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162690_318859825210567_4629106843866628096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBWN8SJbyeYQ7kNvwG9F8HW&_nc_oc=Adq365vJNlY99HjCdh3Z3ZkwAb3JJqg2CWFBR8hT8D76qpivA0OTfK-NWM1Bc6Q-9t4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4HAtSr7NK4f9jwTCIlBlo5_PZPUelj85dwkNm0yCI5A&oe=6A637E55"}, {"file_name": "migrated_image.png", "id": "3171466972898695", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162675_224662891379134_6592421203292454912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Xr9x_p9FlMQ7kNvwHPuEHe&_nc_oc=Adr22py9rFs9j-bD8gqFYknbMOrK-Aq5RAvz5y_rg2D5O6YGQM9yVkDFZH-uR5J3vUY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnq1tcBvnohd5XPKANRfJhg5yoSZPQBki6lQU3fJ4j-w&oe=6A637D7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoorRooma.png", "id": "139347326635067", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162678_139347329968400_1670297392546578432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ko6fkvISyvYQ7kNvwFZrGZB&_nc_oc=Adr_6vSq0q2ZfBZhq2oYQZY4WVSdUIpKCw4pgGsCCQg9XM4Imj0gvM_pstqAszmrELk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGu3b0kNZqLsjhiAZhYnSLy9I0A59GwPIhae0GqSuP7g&oe=6A636228"}, "display_name": "MindFulVR", "keywords": ["Mindfulness", "Meditation", "Wellbeing", "Stress", "Anxiety"], "long_description": "Welcome to MindFulVR, your safe place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will assist you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being.\n\nDiscover a part of Mindfulness, known as the Body Scan (7 mins), which will assist you recognize feelings of \"dis-ease\" in your body, and using a simple affirmation, how you might accept these feelings.\n\nSerenity will guide you through a fingertip tapping practice, known as the Emotional Freedom Technique (10 mins), which combines ancient acupressure with modern psychology, and helps you affirm your emotions, as you tap around your energy points.\n\nIreland\u2019s ancient landscape has a long association with well-being and self-healing. MindFulVR includes a handpicked selection of these ancient Irish locations, as 360-degree immersive VR videos, for you to practice your Body Scan, all inside our MindFulVR app.", "short_description": "Welcome to MindFulVR, your place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will lead you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being. This will be your true and meaningful, mindful and soulful journey of acceptance."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mindmyths.eu/privacy-policy/", "developer_terms_of_service_url": "http://mindmyths.eu/terms-of-service/", "publisher_name": "MindMyths", "support_website_url": null, "website_url": "http://www.mindmyths.eu/the-app/", "category": "APPS", 
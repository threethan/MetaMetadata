1.oculuscdn.com/v/t64.5771-25/11162722_1691017657866242_6527890522260897792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leU9jSDCGhwQ7kNvwFULsi8&_nc_oc=AdqDhCZ4IGXouk_AYbs6v4w1_-Z4DyVchpYUQU_COp3f0rdANL-gPZl_nkkiCFTRt6o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKIsQVXH5iElmWGJx50s8cZD1eybNitQVzIVnU2waTwA&oe=6AF8A581"}, {"file_name": "migrated_image.png", "id": "550870692209943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162701_325574217876642_8926442638236712960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fDvVha3ijIQ7kNvwHjlu9u&_nc_oc=AdqH6beRsAXyUw1OHDxy3tWbcSEQxQyJW1_xlIqP7JsMSxjPFQ35LMOEdusX2CaOjGE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQWj0WeZ1l67NSWrSqrbpobpA107N-ZfN6J4uwitN08Q&oe=6AF89EAC"}, {"file_name": "migrated_image.png", "id": "203876624265899", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162690_318859825210567_4629106843866628096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JD7iMgVAVawQ7kNvwFESfLs&_nc_oc=AdpbkHq7DV5wzifRZfMFDtq_f9KFhZkOgrn7UzLp8xGR5uSFt5eP1wsqxIM4PK1Ac4Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5w7_QVBgv4KGFzHk-KGa0NMhX7UlHbJML_5nBYyJ-FA&oe=6AF877D5"}, {"file_name": "migrated_image.png", "id": "3171466972898695", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162675_224662891379134_6592421203292454912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpONkv1A8SkQ7kNvwEIq2IB&_nc_oc=AdrCKRby38VE5fG0MpokT_kuGV5cjzYDTfprSYz9h4ejdi85GIF50PMhZ7v_KTc3bc8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLi6MtuTHTQI9lChr8Kvkky_Vv3wKVk5tK4PYYEIo_iA&oe=6AF876FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoorRooma.png", "id": "139347326635067", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162678_139347329968400_1670297392546578432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f652kCq1QNMQ7kNvwFP9LoC&_nc_oc=AdqivpiQeNYLUQxdslNgIMKnhztcJENni7liU24rWN1PGNTWjFcDwtvq784Xu1mhsrg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvyi0ucC_11U8WqVZ2ti_Nn71YVKkPSk7c-tGxZZNjQw&oe=6AF893E8"}, "display_name": "MindFulVR", "keywords": ["Mindfulness", "Meditation", "Wellbeing", "Stress", "Anxiety"], "long_description": "Welcome to MindFulVR, your safe place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will assist you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being.\n\nDiscover a part of Mindfulness, known as the Body Scan (7 mins), which will assist you recognize feelings of \"dis-ease\" in your body, and using a simple affirmation, how you might accept these feelings.\n\nSerenity will guide you through a fingertip tapping practice, known as the Emotional Freedom Technique (10 mins), which combines ancient acupressure with modern psychology, and helps you affirm your emotions, as you tap around your energy points.\n\nIreland\u2019s ancient landscape has a long association with well-being and self-healing. MindFulVR includes a handpicked selection of these ancient Irish locations, as 360-degree immersive VR videos, for you to practice your Body Scan, all inside our MindFulVR app.", "short_description": "Welcome to MindFulVR, your place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will lead you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being. This will be your true and meaningful, mindful and soulful journey of acceptance."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mindmyths.eu/privacy-policy/", "developer_terms_of_service_url": "http://mindmyths.eu/terms-of-service/", "publisher_name": "MindMyths", "support_website_url": null, "website_url": "http://www.mindmyths.eu/the-app/", "category": "APPS", 
1.oculuscdn.com/v/t64.5771-25/11162722_1691017657866242_6527890522260897792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHaGSMy4l8EQ7kNvwHvAX4Z&_nc_oc=AdoVL6FlGd5lBe-FmzvvvdLrihZZmtnBDD9ovTJAjTVrceithRGdcXMVkNM9qY1_jLk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTByzGhfUjw2b2EnzqYlyM-y4LNTYhrYKBUqfYJBPtjQ&oe=6A79DD41"}, {"file_name": "migrated_image.png", "id": "550870692209943", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_325574217876642_8926442638236712960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19g2zLEFw0YQ7kNvwEeB4c7&_nc_oc=AdowdlYQEfd-EZfuGe18-5RNQdG62gVM33zV930LsO9OZCRHF1zy37RxzeVlxhyez_g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExZn6Sjgit4bBo1F0wPQ-vpyhIEtTT8Jie1ixYvMHHFw&oe=6A79D66C"}, {"file_name": "migrated_image.png", "id": "203876624265899", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162690_318859825210567_4629106843866628096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7ru1BzvhqUQ7kNvwGQWVum&_nc_oc=AdqP3ci4Q1rACRZKN51puF3Jh2Verug-XLZdcpTNVavl5zNzDIR2cn3_-gJTWv3eC7Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQXtpr1sa5XUyEr-HqJXEy0bGrBSNP1o8wCHl_wBYBzQ&oe=6A79AF95"}, {"file_name": "migrated_image.png", "id": "3171466972898695", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162675_224662891379134_6592421203292454912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0wTDV5MgigQ7kNvwGoIBaX&_nc_oc=AdoxrxbvGzG6S_Y_jsRH6G0b9YOdsEnsywvmjAR4NyB0CvQUbppKjfs1HEYpm03gFNo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEWSYVZgKaRqbLhUqdNATtuczyJBHXhW6YfBmW1md3qA&oe=6A79E6FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoorRooma.png", "id": "139347326635067", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162678_139347329968400_1670297392546578432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zY4hmt_fNk4Q7kNvwHcPeLJ&_nc_oc=AdopyXY-obUXXI5i89ZtevvEgF6CGvP2uhVTAmFeBgY0jD6FdwNr4fFVqmNZsCybN_w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjU1Uf01kpFwYXNhUYHWfd9lEgF0tI9eBki7UhIFQYUw&oe=6A79CBA8"}, "display_name": "MindFulVR", "keywords": ["Mindfulness", "Meditation", "Wellbeing", "Stress", "Anxiety"], "long_description": "Welcome to MindFulVR, your safe place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will assist you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being.\n\nDiscover a part of Mindfulness, known as the Body Scan (7 mins), which will assist you recognize feelings of \"dis-ease\" in your body, and using a simple affirmation, how you might accept these feelings.\n\nSerenity will guide you through a fingertip tapping practice, known as the Emotional Freedom Technique (10 mins), which combines ancient acupressure with modern psychology, and helps you affirm your emotions, as you tap around your energy points.\n\nIreland\u2019s ancient landscape has a long association with well-being and self-healing. MindFulVR includes a handpicked selection of these ancient Irish locations, as 360-degree immersive VR videos, for you to practice your Body Scan, all inside our MindFulVR app.", "short_description": "Welcome to MindFulVR, your place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will lead you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being. This will be your true and meaningful, mindful and soulful journey of acceptance."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mindmyths.eu/privacy-policy/", "developer_terms_of_service_url": "http://mindmyths.eu/terms-of-service/", "publisher_name": "MindMyths", "support_website_url": null, "website_url": "http://www.mindmyths.eu/the-app/", "category": "APPS", 
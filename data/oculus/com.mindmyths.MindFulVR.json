1.oculuscdn.com/v/t64.5771-25/11162722_1691017657866242_6527890522260897792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-m-f9f5sK-IQ7kNvwGcxzUB&_nc_oc=AdryDL1HKusMuTGjY2Xioip_6dt00XBA3KpbCBlZYyTjznOMTN2IBpLHHePA0HP0tJo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xI0hnMCHmi2GwEEYJ155SyORiNtvECsdLEHSjVJMbhA&oe=69E0EF41"}, {"file_name": "migrated_image.png", "id": "550870692209943", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162701_325574217876642_8926442638236712960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JW39aT7Jfj8Q7kNvwHny4jM&_nc_oc=AdrONYkUCBXPRpX26jxDU6qhj-BOqKKWy1tUsQ7Zp1OaN8CKCFwbCS9y8s61_uWaBQ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BFJq-cIMhJjnhF47MEqhVOxSSg7K8jQb0vfR-ozK_aQ&oe=69E0E86C"}, {"file_name": "migrated_image.png", "id": "203876624265899", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162690_318859825210567_4629106843866628096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjEHRWORPhUQ7kNvwHRcbUi&_nc_oc=AdplYVIh96AgE_eK6_vr1TuCcawDeCV9goJJCUaZ7J8qymeBNpc4G2DWxwcRKqh_Rt8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hyF6YR195zubxe-kdudA-YC2ZOrxjvJjY8jaka2xhFw&oe=69E0F9D5"}, {"file_name": "migrated_image.png", "id": "3171466972898695", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162675_224662891379134_6592421203292454912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMDYAQuWrxkQ7kNvwETiX4K&_nc_oc=AdoLGl-G8KTfjhRZ8L1yb2IV1uJNTPBzrnnhAIeUF0-youQ76f6hX8elmKppSKQYHAU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ry20lihnXTeF7eVi7ChaY4lOB_gp98KpybeDC94P77Q&oe=69E0F8FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoorRooma.png", "id": "139347326635067", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162678_139347329968400_1670297392546578432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljCAfTpgLp8Q7kNvwFz4bsm&_nc_oc=Adpg6QgIdoDREBVMDSGaMiPlbQw6IcLme1xB6gqR4oRjFROqZNETX6rlavM-W9joiEM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TQ6DpynmSNws1jM3XjUPCXgXcqhjoQwr422cFxJyYZw&oe=69E0DDA8"}, "display_name": "MindFulVR", "keywords": ["Mindfulness", "Meditation", "Wellbeing", "Stress", "Anxiety"], "long_description": "Welcome to MindFulVR, your safe place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will assist you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being.\n\nDiscover a part of Mindfulness, known as the Body Scan (7 mins), which will assist you recognize feelings of \"dis-ease\" in your body, and using a simple affirmation, how you might accept these feelings.\n\nSerenity will guide you through a fingertip tapping practice, known as the Emotional Freedom Technique (10 mins), which combines ancient acupressure with modern psychology, and helps you affirm your emotions, as you tap around your energy points.\n\nIreland\u2019s ancient landscape has a long association with well-being and self-healing. MindFulVR includes a handpicked selection of these ancient Irish locations, as 360-degree immersive VR videos, for you to practice your Body Scan, all inside our MindFulVR app.", "short_description": "Welcome to MindFulVR, your place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will lead you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being. This will be your true and meaningful, mindful and soulful journey of acceptance."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mindmyths.eu/privacy-policy/", "developer_terms_of_service_url": "http://mindmyths.eu/terms-of-service/", "publisher_name": "MindMyths", "support_website_url": null, "website_url": "http://www.mindmyths.eu/the-app/", "category": "APPS", 
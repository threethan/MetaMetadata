1.oculuscdn.com/v/t64.5771-25/11162722_1691017657866242_6527890522260897792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHhCcgmmsyQQ7kNvwEFnYs2&_nc_oc=AdpyNxpX6jkLaSd7rMfjky0YqQMy5tliL5h-4rhh7XAuEemUQFX-PF6MPsIURaIMQ0I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6TA3fGoufPjPMdMZ0fTrtWt79uEOerjq0hJuSulFz8Q&oe=6AE5F841"}, {"file_name": "migrated_image.png", "id": "550870692209943", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_325574217876642_8926442638236712960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ud13usaIICIQ7kNvwHEYEvx&_nc_oc=Adq47XBJqdTXthljA-DaEkCMNfZFQ_bwiS5kpjdtsBKrFdjjKjgtlpxIwBhV1MlTD_c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeuKcBEX8ZNmiDgyWzYeg1GvT94YifBqxkvi68M-wNkQ&oe=6AE5F16C"}, {"file_name": "migrated_image.png", "id": "203876624265899", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162690_318859825210567_4629106843866628096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1q5gJ2KYlxIQ7kNvwFTOONd&_nc_oc=AdrLgSjMQB9o18gGuUWYP3uWYzxi5-sbe1rGiqFq-7hFxAWX9mGXy57JyGQ6jxi7tcs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzLyegPyj3Jv_zIMG-n_aQpPjken3RUYyjlojE9u7EuQ&oe=6AE602D5"}, {"file_name": "migrated_image.png", "id": "3171466972898695", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162675_224662891379134_6592421203292454912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjsWdniukLoQ7kNvwF47BTL&_nc_oc=AdpTf2BIPvQAR-NO-2OYq3rtFVYKWn--tiUuRGHG-msQ0mfB11ePFE2v8Dh5vdqN9Vc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWNfRQjvhxI5Q5HbRMvWikuzfembuDdLjV2ylu24n7rA&oe=6AE601FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoorRooma.png", "id": "139347326635067", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162678_139347329968400_1670297392546578432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yXKX_kgEJYQ7kNvwG5iqwi&_nc_oc=AdoVhbIA_5zdTMzs2rwoFoAQPc-rHU3Yr1nMPg6YkNSqdUTZmpw1H7SyXahi2vqy5hs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCmT-T87HQWFcHX0Ox6WpIGwnRUovuDB0xIH2Lod581w&oe=6AE5E6A8"}, "display_name": "MindFulVR", "keywords": ["Mindfulness", "Meditation", "Wellbeing", "Stress", "Anxiety"], "long_description": "Welcome to MindFulVR, your safe place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will assist you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being.\n\nDiscover a part of Mindfulness, known as the Body Scan (7 mins), which will assist you recognize feelings of \"dis-ease\" in your body, and using a simple affirmation, how you might accept these feelings.\n\nSerenity will guide you through a fingertip tapping practice, known as the Emotional Freedom Technique (10 mins), which combines ancient acupressure with modern psychology, and helps you affirm your emotions, as you tap around your energy points.\n\nIreland\u2019s ancient landscape has a long association with well-being and self-healing. MindFulVR includes a handpicked selection of these ancient Irish locations, as 360-degree immersive VR videos, for you to practice your Body Scan, all inside our MindFulVR app.", "short_description": "Welcome to MindFulVR, your place to ease your journey into Mindfulness meditation. \n\nSerenity, your meditation guide, will lead you on a conscious journey and empower you to move from a place of \"dis-ease\" within your mind and body, to a state of conscious ease and well-being. This will be your true and meaningful, mindful and soulful journey of acceptance."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mindmyths.eu/privacy-policy/", "developer_terms_of_service_url": "http://mindmyths.eu/terms-of-service/", "publisher_name": "MindMyths", "support_website_url": null, "website_url": "http://www.mindmyths.eu/the-app/", "category": "APPS", 
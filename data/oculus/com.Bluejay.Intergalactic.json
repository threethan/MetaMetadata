Ikcz3bF5MWQFY6YtyHTxTV4-2LD_esv1UD1vZLhH8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzftRYkd4k2jDvXS72rh4n47sIOQCsNbYuCcZBoAU-M0g&oe=69B6918E"}, {"file_name": "Screennew3.png", "id": "197039756363956", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035449_197039759697289_4085650435012425346_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVrvDlsxAx8Q7kNvwGponzD&_nc_oc=Adlk5bJCVt2X_6u5oujcAb4aGbr-FHqQZ7A_9dVVCAD9NILOlji14dfCppcfKbWML04&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdABql1wLPB6kE8sLkltHiKo5ortdjh0v1QJ2OxowIug&oe=69B6AD62"}, {"file_name": "screennew4.png", "id": "1470016790520652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974726_1470016793853985_6573565894800513279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=445h5y_uoJIQ7kNvwEVi0oY&_nc_oc=AdmZKfeXvCMCJh9U6lagTCwVe8xiNcyX7rby_8wfUlvl6mqPT9QHO8rPn8muIv1N77Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxrqgPKtLqDYOVI1lyIiODEsNYJDW_OzscjUv9BivLqnQ&oe=69B69CD4"}, {"file_name": "Screennew5.png", "id": "944939546569794", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974584_944939549903127_4671920987627351563_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5r9aSul3UbIQ7kNvwGFFfRQ&_nc_oc=Adk6md4NDeb_vz1q1WNdBlWpYSxeRH0RY61cWyMnzKX8V4sPr0uPsUIAbFfL3vOR48w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwgfhmjukm3mLCaTlKzZCTq_3J85hvwU1BhTWL4DD-G5A&oe=69B6A2F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrollTrailer.png", "id": "962767298346981", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974924_962767301680314_1107704438361654547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ko-d5-grqyUQ7kNvwFhGB1C&_nc_oc=AdkMhZOrErFVJdwOXPzuOMuOBuWsy2PLiDCOmn897Q8ECdBlmqGMqqjFFIQ5TRDg55U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBNoJMBxdCk2Ep793fAibV0RvmQWddn1Kd-kFdV-ATGQ&oe=69B6B4A1"}, "display_name": "Intergalactic", "keywords": [], "long_description": "Intergalactic:\n\n\nIntergalactic is a VR game centered in the setting of space.\n\nYou can explore a range of levels with big enemy ships,\n\nblack holes, asteroid fields, and more! You fly through space\n\nin a ship with a fully interactable, working futuristic HUD.\n\nFly through the levels and destroy randomly spawning ships, minibosses, and asteroids. \n\n\nDefeating these ships will sometimes spawn gears that you can\n\ncollect and use at the shop in the main menu to upgrade and improve your ship.\n\nThere is also a 5 mission campaign where you raid a huge enemy \n\nship and destroy it. The game comes with many QOL features \n\nsuch as a standing mode and setting to make the game more\n\ncomfortable for players who may experience VR sickness.\n\n\nYou can install the game on Quest 2 through SideQuest or other means\n", "short_description": "Destroy Asteroids and Ships, Explore Space!"}]}, "developer_name": "Nathaniel Skalabrin", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e37a87b5-8c6e-4cab-a95b-2fba11805434", "developer_terms_of_service_url": null, "publisher_name": "Bluejay Studios", "support_website_url": null, "website_url": "https://nskalabrin.wixsite.com/bluejay-studios", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1054840459026040"}, "review_messages": []
-YDuSKDf1adMutGQd3nK6z_iBlq1ATNclnRgvwA1_CiLE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmXMdnYn7rMBaE29GbQuUz1YtfCUM1_Y8wXWcE3Crp1g&oe=69AAB40E"}, {"file_name": "Screennew3.png", "id": "197039756363956", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035449_197039759697289_4085650435012425346_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnfhlOjFbN8Q7kNvwHUVRl4&_nc_oc=AdmTXVnSz4Xx8JZUvRnWwGwA3wH45hY2YVe-x8QHObsCdIdT76fD_mgZc6mCbNJi2wE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfwjVzUcaX-9mmgUXfgXvccNRMo4tkxBIbTRq3mZ-kU0VA&oe=69AACFE2"}, {"file_name": "screennew4.png", "id": "1470016790520652", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974726_1470016793853985_6573565894800513279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4um54xb3ZwQ7kNvwH12Fva&_nc_oc=AdlQf6CxpehojjDdr7M-rWvSs0D-Uzfjk2O7blVNXPQP-yUp34dLL5PtnhOEc2wl2UY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfxCGT0uggvygbufMvSpJUQGObdqY0e7w-NNH7Zo56QITA&oe=69AABF54"}, {"file_name": "Screennew5.png", "id": "944939546569794", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974584_944939549903127_4671920987627351563_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSsyaClHUKcQ7kNvwFWe4s6&_nc_oc=Adkl86g82e2UHKHu_20jusZI2TuQNp8Ynyg69-nOaYt9lk1fEldv_P3XmTzLdJXzNmY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfykCNrmDpe0PC94PMDBQtDdgwCcKcu5w615TSuSbettsw&oe=69AAC573"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrollTrailer.png", "id": "962767298346981", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974924_962767301680314_1107704438361654547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXiUo4ZR5_YQ7kNvwEdi2wN&_nc_oc=AdnHPRRLIdipelWRdd7-41BbqEeipU4Zyb161UGfDungj2uc232cO0wW6ryccNrwEgg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfwTxiuyA_nUPJjAiQf6KSA04_xaAGvMLsag4ZQRAsTbrg&oe=69AAD721"}, "display_name": "Intergalactic", "keywords": [], "long_description": "Intergalactic:\n\n\nIntergalactic is a VR game centered in the setting of space.\n\nYou can explore a range of levels with big enemy ships,\n\nblack holes, asteroid fields, and more! You fly through space\n\nin a ship with a fully interactable, working futuristic HUD.\n\nFly through the levels and destroy randomly spawning ships, minibosses, and asteroids. \n\n\nDefeating these ships will sometimes spawn gears that you can\n\ncollect and use at the shop in the main menu to upgrade and improve your ship.\n\nThere is also a 5 mission campaign where you raid a huge enemy \n\nship and destroy it. The game comes with many QOL features \n\nsuch as a standing mode and setting to make the game more\n\ncomfortable for players who may experience VR sickness.\n\n\nYou can install the game on Quest 2 through SideQuest or other means\n", "short_description": "Destroy Asteroids and Ships, Explore Space!"}]}, "developer_name": "Nathaniel Skalabrin", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e37a87b5-8c6e-4cab-a95b-2fba11805434", "developer_terms_of_service_url": null, "publisher_name": "Bluejay Studios", "support_website_url": null, "website_url": "https://nskalabrin.wixsite.com/bluejay-studios", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1054840459026040"}, "review_message
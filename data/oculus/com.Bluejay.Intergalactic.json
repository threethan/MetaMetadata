VQUhTS1Jqsae7WOVw7Vos3psT5jhQtBnmLu_98mlE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu9va-fRxQXB3--M5D8nXy_cQaflySzTMkcMp1q_imylw&oe=69A8110E"}, {"file_name": "Screennew3.png", "id": "197039756363956", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035449_197039759697289_4085650435012425346_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_W0GOYtnJLIQ7kNvwG6hYX2&_nc_oc=Admb2cGrpEno7wnKt1wDCMWQYR1iGBcqspesWFmR_e_YkZZk7eMX65uljWqDqRCIj5A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuarX6cmXzDfQfaL_Q6hN8tzYLFQTo-55F_up96YT89-w&oe=69A82CE2"}, {"file_name": "screennew4.png", "id": "1470016790520652", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974726_1470016793853985_6573565894800513279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4um54xb3ZwQ7kNvwFZctk1&_nc_oc=Adk3kWaIry9r41ya5OIQ8YvqulaVX77ZcK48Uog6QLlx1NNvIY5P9UNBrq8-zfmajkA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuztyzuruJTq6uD-xD7i1H28F-bXxXuRCu4eUOmGq0EgA&oe=69A81C54"}, {"file_name": "Screennew5.png", "id": "944939546569794", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974584_944939549903127_4671920987627351563_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGvA5rWcv_QQ7kNvwG6VJKV&_nc_oc=AdlSIX4p2K9i3vg7Duk7SYPte8zsljMgT-ss5W8lB-SxsYgAz0Yl90MHfcTfAv0rZ_Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvYu7b04Gopt9hljPEJ42htqcEu6yJCieyTzUzHFkpFiQ&oe=69A82273"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrollTrailer.png", "id": "962767298346981", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974924_962767301680314_1107704438361654547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXiUo4ZR5_YQ7kNvwGa8aeE&_nc_oc=AdltUViT-06vyaBDuup8pOt8iRjNtx6mKqWFF_y_vIP8VN3J1yzUxU_V0lRIXO3d-IQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs5u1J2avakd0M5mubjadjF1GHLMaq21cXX5Com8InGVg&oe=69A83421"}, "display_name": "Intergalactic", "keywords": [], "long_description": "Intergalactic:\n\n\nIntergalactic is a VR game centered in the setting of space.\n\nYou can explore a range of levels with big enemy ships,\n\nblack holes, asteroid fields, and more! You fly through space\n\nin a ship with a fully interactable, working futuristic HUD.\n\nFly through the levels and destroy randomly spawning ships, minibosses, and asteroids. \n\n\nDefeating these ships will sometimes spawn gears that you can\n\ncollect and use at the shop in the main menu to upgrade and improve your ship.\n\nThere is also a 5 mission campaign where you raid a huge enemy \n\nship and destroy it. The game comes with many QOL features \n\nsuch as a standing mode and setting to make the game more\n\ncomfortable for players who may experience VR sickness.\n\n\nYou can install the game on Quest 2 through SideQuest or other means\n", "short_description": "Destroy Asteroids and Ships, Explore Space!"}]}, "developer_name": "Nathaniel Skalabrin", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e37a87b5-8c6e-4cab-a95b-2fba11805434", "developer_terms_of_service_url": null, "publisher_name": "Bluejay Studios", "support_website_url": null, "website_url": "https://nskalabrin.wixsite.com/bluejay-studios", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1054840459026040"}, "review_messages": []
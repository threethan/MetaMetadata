q8Scb2fqaeKomMZfBKTkjNTXbKClQ1hylSULdrJ5A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyInmhDDi8jHnAEDRw-VSSm6mBsm7A3L82lJ1RQspz4Hg&oe=69BE7A8E"}, {"file_name": "Screennew3.png", "id": "197039756363956", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035449_197039759697289_4085650435012425346_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHH1DpobA7QQ7kNvwEbJlnJ&_nc_oc=Adkf2WW89qFGnzMa2sbGROaDaO3RN7iNO7iP_Vg_jhKFhkZ6YdE3_ywgOzPJEFodVPw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJs1cmTBaZCNzbqb2bbxf5Szq2XUFKcqjoIsFFncO66Q&oe=69BE9662"}, {"file_name": "screennew4.png", "id": "1470016790520652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974726_1470016793853985_6573565894800513279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2OKg2IRc6cQ7kNvwFKSx6P&_nc_oc=AdmFvCyGGDyVbYwXchw3eQrOiuCos6YqtTBNmBiIZvBmxZAaV0p0FPaOnVdgBnKaR-I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzpZcmNvTYhbcwN41f6mXb93KteD57b2tJS8uQnnxDPdw&oe=69BE85D4"}, {"file_name": "Screennew5.png", "id": "944939546569794", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974584_944939549903127_4671920987627351563_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrcoJyfsd5kQ7kNvwHQV-R4&_nc_oc=Adknn9cPahIjqgIMSj2taZ6yXFqzhZBNlHEK_BeHnCyh3kvA4ScK0Z12CYn0mU1vGhg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDC7SpKj70d9GyUh5GJ1kD_b-yT6BDlXA24KgdJvHikQ&oe=69BE8BF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrollTrailer.png", "id": "962767298346981", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974924_962767301680314_1107704438361654547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J83fyDvZTFkQ7kNvwHgLeIK&_nc_oc=AdlUGk0lX9vmFms099El4QMMGlCRHkSDDUWR4hgAewIeXXGlQElpS10q5rDGAm81Jqo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwiPchELEhPE575lRR_JwtJLjJxPNt2-P_v12bYQM7QJw&oe=69BE9DA1"}, "display_name": "Intergalactic", "keywords": [], "long_description": "Intergalactic:\n\n\nIntergalactic is a VR game centered in the setting of space.\n\nYou can explore a range of levels with big enemy ships,\n\nblack holes, asteroid fields, and more! You fly through space\n\nin a ship with a fully interactable, working futuristic HUD.\n\nFly through the levels and destroy randomly spawning ships, minibosses, and asteroids. \n\n\nDefeating these ships will sometimes spawn gears that you can\n\ncollect and use at the shop in the main menu to upgrade and improve your ship.\n\nThere is also a 5 mission campaign where you raid a huge enemy \n\nship and destroy it. The game comes with many QOL features \n\nsuch as a standing mode and setting to make the game more\n\ncomfortable for players who may experience VR sickness.\n\n\nYou can install the game on Quest 2 through SideQuest or other means\n", "short_description": "Destroy Asteroids and Ships, Explore Space!"}]}, "developer_name": "Nathaniel Skalabrin", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e37a87b5-8c6e-4cab-a95b-2fba11805434", "developer_terms_of_service_url": null, "publisher_name": "Bluejay Studios", "support_website_url": null, "website_url": "https://nskalabrin.wixsite.com/bluejay-studios", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1054840459026040"}, "review_messages": []
mLcIAJab2a8aju0hlE8YUWh9iEqZOp-dJW0lHTHCA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz7lEZNknxS-NOkmgHvqOHjO4HQmzTrvWRp-l9f-fbn_g&oe=69B7E30E"}, {"file_name": "Screennew3.png", "id": "197039756363956", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035449_197039759697289_4085650435012425346_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVrvDlsxAx8Q7kNvwEFTgVF&_nc_oc=Adn8JhrX27TlB05JTOJNjTzAuNfkolax1sdu2uPWbRL1Nq0aHWu6kDuclba8YL9ntr4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxGcej1mTLKQRVHMBTRGTgonYL_bYo6dNZ5UUwvimVkNw&oe=69B7FEE2"}, {"file_name": "screennew4.png", "id": "1470016790520652", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974726_1470016793853985_6573565894800513279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlbigDHHZZ4Q7kNvwFRDHIO&_nc_oc=Adn5Pac3uzuDq_8MzwMsIDZ3Nfol2Klwi3ni15tWNazCpqcbjJDWgQheHpf4qz1ijM0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyUfnvA2zhGX4ReQtkSZz3EyljyV5LSly3O4JAJEmxyHw&oe=69B7EE54"}, {"file_name": "Screennew5.png", "id": "944939546569794", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974584_944939549903127_4671920987627351563_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5r9aSul3UbIQ7kNvwHaLqJa&_nc_oc=Adnw4IAs-WqAdhChEhMAwDbsD2PeQ57xUXm0gxXZwIuge57gUek7B_Vge2tOa0v-BmA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwlJWbTvl9SHNoZJkK3jZQyrKSYK_cSu8Ckk31Di0qOAQ&oe=69B7F473"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrollTrailer.png", "id": "962767298346981", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974924_962767301680314_1107704438361654547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssw-v6iF3CMQ7kNvwG2sA1v&_nc_oc=AdnHFd3qfJ05wRFYolKFYEK66DywBOAJs5brUzFODXmJmnS3EqPYq2ie9LlGiuzTJdE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz9s89vsnKUQQ5r5qfvRc0KI6xmMStkdEvBNjcxideI4Q&oe=69B80621"}, "display_name": "Intergalactic", "keywords": [], "long_description": "Intergalactic:\n\n\nIntergalactic is a VR game centered in the setting of space.\n\nYou can explore a range of levels with big enemy ships,\n\nblack holes, asteroid fields, and more! You fly through space\n\nin a ship with a fully interactable, working futuristic HUD.\n\nFly through the levels and destroy randomly spawning ships, minibosses, and asteroids. \n\n\nDefeating these ships will sometimes spawn gears that you can\n\ncollect and use at the shop in the main menu to upgrade and improve your ship.\n\nThere is also a 5 mission campaign where you raid a huge enemy \n\nship and destroy it. The game comes with many QOL features \n\nsuch as a standing mode and setting to make the game more\n\ncomfortable for players who may experience VR sickness.\n\n\nYou can install the game on Quest 2 through SideQuest or other means\n", "short_description": "Destroy Asteroids and Ships, Explore Space!"}]}, "developer_name": "Nathaniel Skalabrin", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e37a87b5-8c6e-4cab-a95b-2fba11805434", "developer_terms_of_service_url": null, "publisher_name": "Bluejay Studios", "support_website_url": null, "website_url": "https://nskalabrin.wixsite.com/bluejay-studios", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1054840459026040"}, "review_messages": []
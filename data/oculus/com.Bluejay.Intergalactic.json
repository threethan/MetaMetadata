, "id": "1309088496352496", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54823267_1309088499685829_1502654632429521677_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4OsNKuyN_4Q7kNvwHlM35w&_nc_oc=AdrFF-6_azGZEMxQ18heKFpXCMJGE_P43mzBPyxFLbqVJbCvlczReJK4OSImhvjnisQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7i7CoPXVjJlUf0jjTLomr-9qbFIamceAY4ZsNR4w89w&oe=6B0060CE"}, {"file_name": "Screennew3.png", "id": "197039756363956", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035449_197039759697289_4085650435012425346_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUg65YvRmYgQ7kNvwEhZj8G&_nc_oc=Adq80HTuKZFX5BN1BorossA-DXaMR8G71m6tB_r2hk6H37F1Dd6qcxrOeVdgKaHLUT0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9_Hl0HJfo1s9-_Ax2NG8aRJmnLf7FcPg7Qpm7yhieig&oe=6B007CA2"}, {"file_name": "screennew4.png", "id": "1470016790520652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974726_1470016793853985_6573565894800513279_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5lPishm0ugQ7kNvwGXNyzM&_nc_oc=AdrlIm916EQHy4HvBwm0ilxSmRnWBSmUSnpRNGYtaWHifUCirmA6X5mDH4MCS9IfWRM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3riiIeBDBAeMz9Y85IuAfNycrbfkwLLZZQJRlLbFj6A&oe=6B006C14"}, {"file_name": "Screennew5.png", "id": "944939546569794", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974584_944939549903127_4671920987627351563_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29nsQo5XR3EQ7kNvwH22RQO&_nc_oc=AdqIOq5edJome3GjRFdJw4Q1Lz7eV-ZUVowNz0vBC9pTqljhC58S2oOgFQZZcwMZZqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRONHLrvqfpcL4kSsHCDuo7-ypGsyr7d02Rt4QCE5bJKw&oe=6B007233"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrollTrailer.png", "id": "962767298346981", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974924_962767301680314_1107704438361654547_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJHUJoVoqucQ7kNvwHT8eZv&_nc_oc=AdqtyviN93CI9--SSYhmErn0iw-HBwypkd_Ad_XYFa_10M2IvUa05FUnZ9_WKmr-I1I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm7n4NTLT-jN9eGOa4TOwQ7Xcf7-A9vniiTfMWn8_TSg&oe=6B0083E1"}, "display_name": "Intergalactic", "keywords": [], "long_description": "Intergalactic:\n\n\nIntergalactic is a VR game centered in the setting of space.\n\nYou can explore a range of levels with big enemy ships,\n\nblack holes, asteroid fields, and more! You fly through space\n\nin a ship with a fully interactable, working futuristic HUD.\n\nFly through the levels and destroy randomly spawning ships, minibosses, and asteroids. \n\n\nDefeating these ships will sometimes spawn gears that you can\n\ncollect and use at the shop in the main menu to upgrade and improve your ship.\n\nThere is also a 5 mission campaign where you raid a huge enemy \n\nship and destroy it. The game comes with many QOL features \n\nsuch as a standing mode and setting to make the game more\n\ncomfortable for players who may experience VR sickness.\n\n\nYou can install the game on Quest 2 through SideQuest or other means\n", "short_description": "Destroy Asteroids and Ships, Explore Space!"}]}, "developer_name": "Nathaniel Skalabrin", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e37a87b5-8c6e-4cab-a95b-2fba11805434", "developer_terms_of_service_url": null, "publisher_name": "Bluejay Studios", "support_website_url": null, "website_url": "https://nskalabrin.wixsite.com/bluejay-studios", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
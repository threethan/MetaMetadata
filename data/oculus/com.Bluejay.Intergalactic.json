2.oculuscdn.com&oh=00_AfvLNwKrwsPxjr4ajrDoO3yV8d9juQDjCEN0O9mHh6nvDA&oe=69A41C8E"}, {"file_name": "Screennew3.png", "id": "197039756363956", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035449_197039759697289_4085650435012425346_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7X-zewiwz8Q7kNvwF-a7W0&_nc_oc=Admo2RbJIKcTd3fXJBjMKL2fEjL4qt6mYz2PgyOSh8hsART4rJgxGOB9tr_YEnfxMGA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvKG8X7bACyrmIyLelhxR5s6jgsW4i_ijl4HcqTUV7TiA&oe=69A43862"}, {"file_name": "screennew4.png", "id": "1470016790520652", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974726_1470016793853985_6573565894800513279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIZM0c7DUQUQ7kNvwFVhlKg&_nc_oc=Adma1gr9fDeq3L5zu_lHgAxRjydUPbPrQjsPLy4Cy_QeDxjKCXIpzAFYqz8tZBEmxaE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvs4qYkQvPiIYSH6JJNbG2B33aEignCAZ5CgXN9kOJIyw&oe=69A427D4"}, {"file_name": "Screennew5.png", "id": "944939546569794", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974584_944939549903127_4671920987627351563_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRoAW4wBq80Q7kNvwHCEFTc&_nc_oc=Adl8bfDo8AlOCeD4TMTBT5TA0TE64rEE_HYquZo9e8xJvzFvoyWThQ6_B7W1dSKoxXw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfssmvG-mdDuFoKf9JChx3xtITH2WhleLti5ESj_zO63Uw&oe=69A42DF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrollTrailer.png", "id": "962767298346981", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974924_962767301680314_1107704438361654547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9lO6S8UikIQ7kNvwHW18rH&_nc_oc=AdnZbkjiM9frAd9fwlhJKEn3fj-un2ab-yB-2T4X2wVtaYzS0WJftZl9j5SPyqhFHzc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs4weA5FVaOUfH3yagMaQ00Gy-hogCiqumVtezJ7cRnhg&oe=69A43FA1"}, "display_name": "Intergalactic", "keywords": [], "long_description": "Intergalactic:\n\n\nIntergalactic is a VR game centered in the setting of space.\n\nYou can explore a range of levels with big enemy ships,\n\nblack holes, asteroid fields, and more! You fly through space\n\nin a ship with a fully interactable, working futuristic HUD.\n\nFly through the levels and destroy randomly spawning ships, minibosses, and asteroids. \n\n\nDefeating these ships will sometimes spawn gears that you can\n\ncollect and use at the shop in the main menu to upgrade and improve your ship.\n\nThere is also a 5 mission campaign where you raid a huge enemy \n\nship and destroy it. The game comes with many QOL features \n\nsuch as a standing mode and setting to make the game more\n\ncomfortable for players who may experience VR sickness.\n\n\nYou can install the game on Quest 2 through SideQuest or other means\n", "short_description": "Destroy Asteroids and Ships, Explore Space!"}]}, "developer_name": "Nathaniel Skalabrin", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e37a87b5-8c6e-4cab-a95b-2fba11805434", "developer_terms_of_service_url": null, "publisher_name": "Bluejay Studios", "support_website_url": null, "website_url": "https://nskalabrin.wixsite.com/bluejay-studios", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1054840459026040"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003270_314499927635519_3013
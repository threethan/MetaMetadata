_PsI6yQz0F1T23r5kDI3Q_aw6xImQ4JlB0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3LnD7PzkK8MeuihMR4Hvjztg0cxNOxFTtNd-fmZLO3dA&oe=69F1E50E"}, {"file_name": "Screennew3.png", "id": "197039756363956", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035449_197039759697289_4085650435012425346_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mq8iOh30inkQ7kNvwGVkgvU&_nc_oc=AdpAyVh216cyh5_vGvV1FvUNDmRHEkfBneC4lK0WoRFlGL5jjGTuWF5cIemIVWxfRvk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3gZOB7wI1ZijXQy8SZptf80fBDZ8slvpf7gV04IfPHfQ&oe=69F200E2"}, {"file_name": "screennew4.png", "id": "1470016790520652", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974726_1470016793853985_6573565894800513279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ia41ubvGwFkQ7kNvwFSMXOf&_nc_oc=AdrfpSOs47hmsdMyG7shiLMnLAqlYVE_Yzi6f_oVUY5JpwzFRv0xJNiF_SOjp_Gn5rA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af08E3J_-TqUQ7jwiRm1zeiFMs1tLVGso8eWQSF9-uQLig&oe=69F1F054"}, {"file_name": "Screennew5.png", "id": "944939546569794", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974584_944939549903127_4671920987627351563_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CjGEvNQ7gEQ7kNvwEofEXq&_nc_oc=AdocmZGGBgUkWCy8QoQLxWHET1DhZCZm1C8zYr5aS-WLVb_6OQArykxhU80aLNo0bwk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2ly01I_bza8_cp9IpQKicdWvk-7t5f_pyXHsNXdFtMcQ&oe=69F1F673"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrollTrailer.png", "id": "962767298346981", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974924_962767301680314_1107704438361654547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWJAHgrgOTAQ7kNvwHbyRQT&_nc_oc=AdqWbJjTnY-npJY5FjYe1sKkynQn40xDqdtmpP3wlGROC6ZctU4qBJSn9VVprvrmeI8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3KaGsCINIZ_gYDuiGhK4Od3VMo3D1Wci_sFZuf3uRm4A&oe=69F20821"}, "display_name": "Intergalactic", "keywords": [], "long_description": "Intergalactic:\n\n\nIntergalactic is a VR game centered in the setting of space.\n\nYou can explore a range of levels with big enemy ships,\n\nblack holes, asteroid fields, and more! You fly through space\n\nin a ship with a fully interactable, working futuristic HUD.\n\nFly through the levels and destroy randomly spawning ships, minibosses, and asteroids. \n\n\nDefeating these ships will sometimes spawn gears that you can\n\ncollect and use at the shop in the main menu to upgrade and improve your ship.\n\nThere is also a 5 mission campaign where you raid a huge enemy \n\nship and destroy it. The game comes with many QOL features \n\nsuch as a standing mode and setting to make the game more\n\ncomfortable for players who may experience VR sickness.\n\n\nYou can install the game on Quest 2 through SideQuest or other means\n", "short_description": "Destroy Asteroids and Ships, Explore Space!"}]}, "developer_name": "Nathaniel Skalabrin", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e37a87b5-8c6e-4cab-a95b-2fba11805434", "developer_terms_of_service_url": null, "publisher_name": "Bluejay Studios", "support_website_url": null, "website_url": "https://nskalabrin.wixsite.com/bluejay-studios", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1054840459026040"}, "review_messages": []}]}, "cover_s
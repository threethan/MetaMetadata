mp&_nc_oc=AdrEGs-aoohCpJWPbOPdRHa_zaXDY_6Uf2rqURNAzbqz5Gp8JBkxBQJ6_n9ERczS2bI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jd2fT6oO9Nbyt70_PRU3Ruz4oUUCqCBcmRijjmW_5lA&oe=6A36AB4E"}, {"file_name": "Screennew3.png", "id": "197039756363956", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035449_197039759697289_4085650435012425346_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtKDzWxN81kQ7kNvwH99rXf&_nc_oc=Adr2C92xYrf6vle-BYu6dMq0QB9Ug-lIY9fSKOoy6RX1yP1-YcqWSW1ZlkiGGaGW1xM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HDT8vGoHDoq7jlk22criZbYA_8vzr5faCaV41_wTN3A&oe=6A368EE2"}, {"file_name": "screennew4.png", "id": "1470016790520652", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974726_1470016793853985_6573565894800513279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1aXbEnqgp0Q7kNvwH7i2br&_nc_oc=AdrIZ3s6WdBvHee5PzJszbofuy5_cltGd-1d1kTp1B0vPbraIQCWnIi-67RpiCsFog0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88TjO7ly4Zaw4jctoP82rfHNSrSey2F-USrFNkROGGTg&oe=6A36B694"}, {"file_name": "Screennew5.png", "id": "944939546569794", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974584_944939549903127_4671920987627351563_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zk6ATObu3sIQ7kNvwGNrVw1&_nc_oc=Adr5vrfil9z9RrUJ03EcM1bddin6IyrWf8i0sU8dasA4DPDbngSvY7W1WKiOf1Lbzls&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mMiuiIhHpQuIoAkpSDPHLLMxe1FI6rF-UN-uN7KnmHg&oe=6A36BCB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrollTrailer.png", "id": "962767298346981", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974924_962767301680314_1107704438361654547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tjhvzrw4c4sQ7kNvwGPfOvP&_nc_oc=AdrFr4Ewwi5eRbR718xgfASffcICYztzSVdMFkzl03tnbkfJa-SZc0eA_sJsb4rmKME&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fFwnNS-0H826gsWT5_xsgze5GmhHeuWrkikLz-lwthw&oe=6A369621"}, "display_name": "Intergalactic", "keywords": [], "long_description": "Intergalactic:\n\n\nIntergalactic is a VR game centered in the setting of space.\n\nYou can explore a range of levels with big enemy ships,\n\nblack holes, asteroid fields, and more! You fly through space\n\nin a ship with a fully interactable, working futuristic HUD.\n\nFly through the levels and destroy randomly spawning ships, minibosses, and asteroids. \n\n\nDefeating these ships will sometimes spawn gears that you can\n\ncollect and use at the shop in the main menu to upgrade and improve your ship.\n\nThere is also a 5 mission campaign where you raid a huge enemy \n\nship and destroy it. The game comes with many QOL features \n\nsuch as a standing mode and setting to make the game more\n\ncomfortable for players who may experience VR sickness.\n\n\nYou can install the game on Quest 2 through SideQuest or other means\n", "short_description": "Destroy Asteroids and Ships, Explore Space!"}]}, "developer_name": "Nathaniel Skalabrin", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e37a87b5-8c6e-4cab-a95b-2fba11805434", "developer_terms_of_service_url": null, "publisher_name": "Bluejay Studios", "support_website_url": null, "website_url": "https://nskalabrin.wixsite.com/bluejay-studios", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
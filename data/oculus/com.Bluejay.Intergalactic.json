such as a standing mode and setting to make the game more\n\ncomfortable for players who may experience VR sickness.\n\n\nYou can install the game on Quest 2 through SideQuest or other means\n", "short_description": "Destroy Asteroids and Ships, Explore Space!"}]}, "developer_name": "Nathaniel Skalabrin", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e37a87b5-8c6e-4cab-a95b-2fba11805434", "developer_terms_of_service_url": null, "publisher_name": "Bluejay Studios", "support_website_url": null, "website_url": "https://nskalabrin.wixsite.com/bluejay-studios", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1054840459026040"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "972953617375800"}]}, "baseline_offer": {"id": "972953617375800"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1693412532, "status": "PUBLISHED", "id": "972953617375800"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7122276844457808", "version": "1.0.8"}, "id": "838495854535019", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "68690
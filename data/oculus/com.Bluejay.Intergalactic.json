, "id": "1309088496352496", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/54823267_1309088499685829_1502654632429521677_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nDk93vIBHYQ7kNvwFZWeQT&_nc_oc=AdqB5KBOnJ5FZMN9UN1baQ-vv_0ukOGo53lrdIzdgw4HgMmVtNS4Fj25qMbztBXQUlw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlVCKF6Q2lxk7_0O-cpZr6JdwOAPkI83IuCBosmNyGpA&oe=6B099B4E"}, {"file_name": "Screennew3.png", "id": "197039756363956", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035449_197039759697289_4085650435012425346_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DeeWG3AOFwUQ7kNvwGxgBhx&_nc_oc=AdqHEVaYBVzwsnqDbu_BiycgCBpp_Btw7GU18jSVAA1G82Nq1fwPOQsMvafrAC0uEpo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQutTqsZ4XR7uNiZIagnSN13Dba7Ez7ZNGqX7YA5WhfNQ&oe=6B09B722"}, {"file_name": "screennew4.png", "id": "1470016790520652", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974726_1470016793853985_6573565894800513279_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwYu4HieNqIQ7kNvwHKBlSs&_nc_oc=AdpTrn2IAdFROU0iR6SCZeorBLxxd0EP6UVDcO3PCpDcc-4W1SH-bxnv5Zt62XW2It0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS67tyEQZAl7oaYrvYjbt7TTGbn1m4Yb8BToc6B18hyXQ&oe=6B09A694"}, {"file_name": "Screennew5.png", "id": "944939546569794", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974584_944939549903127_4671920987627351563_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D709UCTo0YoQ7kNvwExq4mr&_nc_oc=AdpUWUBbrV7o-aOhK_osyCwPaVbyqkboIVtbs2tS1M03XAl4NtmMDIM61pYF3FP1WR4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc2wbWKg-DnebjFRV-K22NjzQPk4H2WUI47h4AI4HhWg&oe=6B09ACB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrollTrailer.png", "id": "962767298346981", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974924_962767301680314_1107704438361654547_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-ZSJq7FA6wQ7kNvwGYgG6L&_nc_oc=AdpCQyoF9UkwLeYOIr50EyzNL4csIBam1WjjzhGyiVTgRB_R7HMjEUW1Te4tVvvDsic&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTM6yOGxXQ0SzYevhEoyjOtVfHg4R65XFJy4rGq4sTTUw&oe=6B09BE61"}, "display_name": "Intergalactic", "keywords": [], "long_description": "Intergalactic:\n\n\nIntergalactic is a VR game centered in the setting of space.\n\nYou can explore a range of levels with big enemy ships,\n\nblack holes, asteroid fields, and more! You fly through space\n\nin a ship with a fully interactable, working futuristic HUD.\n\nFly through the levels and destroy randomly spawning ships, minibosses, and asteroids. \n\n\nDefeating these ships will sometimes spawn gears that you can\n\ncollect and use at the shop in the main menu to upgrade and improve your ship.\n\nThere is also a 5 mission campaign where you raid a huge enemy \n\nship and destroy it. The game comes with many QOL features \n\nsuch as a standing mode and setting to make the game more\n\ncomfortable for players who may experience VR sickness.\n\n\nYou can install the game on Quest 2 through SideQuest or other means\n", "short_description": "Destroy Asteroids and Ships, Explore Space!"}]}, "developer_name": "Nathaniel Skalabrin", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e37a87b5-8c6e-4cab-a95b-2fba11805434", "developer_terms_of_service_url": null, "publisher_name": "Bluejay Studios", "support_website_url": null, "website_url": "https://nskalabrin.wixsite.com/bluejay-studios", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
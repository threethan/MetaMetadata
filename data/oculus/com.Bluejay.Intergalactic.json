1.oculuscdn.com&oh=00_AftM4Y1InrP4pFFFmDM2JdH78OB4nQRK6s2wLPdx4juWvQ&oe=69A0280E"}, {"file_name": "Screennew3.png", "id": "197039756363956", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035449_197039759697289_4085650435012425346_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CA7NXqelb3IQ7kNvwEub2gb&_nc_oc=Adle-aKvn78N_9QQ6HbfaR-f6wac5qmuxVo26kkMuP8-wYqzu_13utJp-9rzfCXNfgg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsMVhMchS2LCbFOT812isRuuASqEW7LgNced8ncPWXc1A&oe=69A043E2"}, {"file_name": "screennew4.png", "id": "1470016790520652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974726_1470016793853985_6573565894800513279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ajWNd6NIOAQ7kNvwFMAjqI&_nc_oc=Admoecmg-woFYOqIiuoaOWZnZP7Gejweb1hsfuFLxEtk7HDQGqq9lOTaOsDTrlqX9Ac&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftT-5fjsIXQjWACY6NHJXwCvNpH0cKxWVacSFzDicgtpg&oe=69A03354"}, {"file_name": "Screennew5.png", "id": "944939546569794", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974584_944939549903127_4671920987627351563_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fQQzkMBOkcQ7kNvwFnCsgJ&_nc_oc=AdnR4bhRsD_T5T-HfLPb189oKxRaPBeV8eXFa8TDferhYb_HtjoGUb6L8p8Ce19d9yM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvujYAe_-i38S9tNv-8PnXtWii7hKGABE3sNJPrRY2EGQ&oe=69A03973"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrollTrailer.png", "id": "962767298346981", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974924_962767301680314_1107704438361654547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dgli5u8H1D4Q7kNvwHICpSi&_nc_oc=AdnnokNqZ_dWDqQqiEQVQ37OeIYaqER4aN6JtIeEoerJBG2k9735C8GLAAvGqxtb-FY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuYVkHz5pzHmN2l-iT7R9Y5c-_ZXY-z8grNuJxlIxFecw&oe=69A04B21"}, "display_name": "Intergalactic", "keywords": [], "long_description": "Intergalactic:\n\n\nIntergalactic is a VR game centered in the setting of space.\n\nYou can explore a range of levels with big enemy ships,\n\nblack holes, asteroid fields, and more! You fly through space\n\nin a ship with a fully interactable, working futuristic HUD.\n\nFly through the levels and destroy randomly spawning ships, minibosses, and asteroids. \n\n\nDefeating these ships will sometimes spawn gears that you can\n\ncollect and use at the shop in the main menu to upgrade and improve your ship.\n\nThere is also a 5 mission campaign where you raid a huge enemy \n\nship and destroy it. The game comes with many QOL features \n\nsuch as a standing mode and setting to make the game more\n\ncomfortable for players who may experience VR sickness.\n\n\nYou can install the game on Quest 2 through SideQuest or other means\n", "short_description": "Destroy Asteroids and Ships, Explore Space!"}]}, "developer_name": "Nathaniel Skalabrin", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e37a87b5-8c6e-4cab-a95b-2fba11805434", "developer_terms_of_service_url": null, "publisher_name": "Bluejay Studios", "support_website_url": null, "website_url": "https://nskalabrin.wixsite.com/bluejay-studios", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1054840459026040"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003270_314499927635519_3013
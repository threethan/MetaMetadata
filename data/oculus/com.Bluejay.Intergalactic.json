jsPivM295hrPiLO-WnvgcxGi8bQPw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1v-EoBSu3ykBCPmxH8OWRt6hYAys5-kTF65eGftUNZow&oe=69F09ED4"}, {"file_name": "Screennew5.png", "id": "944939546569794", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974584_944939549903127_4671920987627351563_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvBKQ61FsnQQ7kNvwENgqZt&_nc_oc=Adp5pUo-mY1D751IFp2zXvphj0Q7nB8vIcyiCbv8hsU5EcEdV05mD0mBsNsvJNuYJrQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0QZSv91XiRo_JNQJ9p1A3o6CuEPKSQIP_uWozVNoZvqw&oe=69F0A4F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrollTrailer.png", "id": "962767298346981", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974924_962767301680314_1107704438361654547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWJAHgrgOTAQ7kNvwE0BtMy&_nc_oc=AdoN8OgY2Z-q34PWcUSzE9oVZKt30hD7z2hjXDLwVI7ldu44RGIsEJaYVxWbKrb9q7c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0m8aKXhm9sFnLlX5R3bsFeO55fOnOBB-6PliHEx__BJg&oe=69F0B6A1"}, "display_name": "Intergalactic", "keywords": [], "long_description": "Intergalactic:\n\n\nIntergalactic is a VR game centered in the setting of space.\n\nYou can explore a range of levels with big enemy ships,\n\nblack holes, asteroid fields, and more! You fly through space\n\nin a ship with a fully interactable, working futuristic HUD.\n\nFly through the levels and destroy randomly spawning ships, minibosses, and asteroids. \n\n\nDefeating these ships will sometimes spawn gears that you can\n\ncollect and use at the shop in the main menu to upgrade and improve your ship.\n\nThere is also a 5 mission campaign where you raid a huge enemy \n\nship and destroy it. The game comes with many QOL features \n\nsuch as a standing mode and setting to make the game more\n\ncomfortable for players who may experience VR sickness.\n\n\nYou can install the game on Quest 2 through SideQuest or other means\n", "short_description": "Destroy Asteroids and Ships, Explore Space!"}]}, "developer_name": "Nathaniel Skalabrin", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e37a87b5-8c6e-4cab-a95b-2fba11805434", "developer_terms_of_service_url": null, "publisher_name": "Bluejay Studios", "support_website_url": null, "website_url": "https://nskalabrin.wixsite.com/bluejay-studios", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1054840459026040"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "972953617375800"}]}, "baseline_offer": {"id": "972953617375800"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1693412532, "status": "PUBLISHED", "id": "972953617375800"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7122276844457808", "version": "1.0.8"}, "id": "838495854535019", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6869019263116902", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7122276844457808"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "838495854535019"}]}, "
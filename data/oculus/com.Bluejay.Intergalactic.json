1.oculuscdn.com&oh=00_AfsX8S2-idnIx-m_VPEZwlNtLMkoZYqPz3D61uzNFMZLfw&oe=69A6BF8E"}, {"file_name": "Screennew3.png", "id": "197039756363956", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035449_197039759697289_4085650435012425346_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_W0GOYtnJLIQ7kNvwEOSLEd&_nc_oc=AdlbR_0nHfUCMmx1DjdKO3dvQ3k9exOEzJpkKKI7eoEexksU-SBqajR7zfcEKbEcogM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft91vvQskfFtV_Uq1C9ZStnCTIsmjbCdX8Lovu3AFHwCg&oe=69A6DB62"}, {"file_name": "screennew4.png", "id": "1470016790520652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974726_1470016793853985_6573565894800513279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIZM0c7DUQUQ7kNvwGRM2aj&_nc_oc=Adn8PUseQJuJwhCeu_Cy7g89R2TOq_nrPUpjCwMlbn7JZ6vxbzA643UWw0u-ThoIYUw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvo41nWS2N7JGQ3mQV9oseQnHYVr8a6pPRAWUF4HL6xeQ&oe=69A6CAD4"}, {"file_name": "Screennew5.png", "id": "944939546569794", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974584_944939549903127_4671920987627351563_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGvA5rWcv_QQ7kNvwENUOJC&_nc_oc=AdmxBQN9ejUmmi79-n43WCQb2NisVg2oJTGbPJj3yrBtiBU53vKHK87p4FwqOxbMd68&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftVKMrT9kItRsGocN2sTeWSXrht7WB46JdqfKOBikIpEA&oe=69A6D0F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrollTrailer.png", "id": "962767298346981", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974924_962767301680314_1107704438361654547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9lO6S8UikIQ7kNvwFlBcYu&_nc_oc=AdlGnwVMMe53wjjIY--mRI4FGoqYVwXrHZ9D4opImTdCRFEc3KmwGzCsL2i_fc0js4E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu339aCDTl_pZy2oln1MCNGZr4er03KAPpncywOy0taPQ&oe=69A6E2A1"}, "display_name": "Intergalactic", "keywords": [], "long_description": "Intergalactic:\n\n\nIntergalactic is a VR game centered in the setting of space.\n\nYou can explore a range of levels with big enemy ships,\n\nblack holes, asteroid fields, and more! You fly through space\n\nin a ship with a fully interactable, working futuristic HUD.\n\nFly through the levels and destroy randomly spawning ships, minibosses, and asteroids. \n\n\nDefeating these ships will sometimes spawn gears that you can\n\ncollect and use at the shop in the main menu to upgrade and improve your ship.\n\nThere is also a 5 mission campaign where you raid a huge enemy \n\nship and destroy it. The game comes with many QOL features \n\nsuch as a standing mode and setting to make the game more\n\ncomfortable for players who may experience VR sickness.\n\n\nYou can install the game on Quest 2 through SideQuest or other means\n", "short_description": "Destroy Asteroids and Ships, Explore Space!"}]}, "developer_name": "Nathaniel Skalabrin", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e37a87b5-8c6e-4cab-a95b-2fba11805434", "developer_terms_of_service_url": null, "publisher_name": "Bluejay Studios", "support_website_url": null, "website_url": "https://nskalabrin.wixsite.com/bluejay-studios", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1054840459026040"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003270_314499927635519_3013
6LIaqN9ktgp1tXBl57ELwmOUgMKEzT4fzmxLuvmwo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqSMEM7CJKzWz0I59E_VgXJ5_H-S8J9ixSIJNwtP4pXQ&oe=69AD570E"}, {"file_name": "Screennew3.png", "id": "197039756363956", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035449_197039759697289_4085650435012425346_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DU-VyKzK_yAQ7kNvwHkuPAr&_nc_oc=AdkHBrItP1Hh6fMNxhd6kPEmXnJ-2P_0phhQ-aY7WbMtL6dmr9KvXoUiw2ksBdQanlE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhhejgGF_cns17ZPq0cweO1zKgeTTRaXJdZXkQyMUFWA&oe=69AD72E2"}, {"file_name": "screennew4.png", "id": "1470016790520652", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974726_1470016793853985_6573565894800513279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTjSZuJ_1-AQ7kNvwG1OT7s&_nc_oc=AdlCy7BL5phr5Anhfw8WUvNI_SwXnzQhr0TDf-Pbs51YaplI_J1oPfCxlXGUNJCmkKM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwyhCEiMIE-GF11gTpa5jUygzfJKPq7i0rqZo6XYB0y5A&oe=69AD6254"}, {"file_name": "Screennew5.png", "id": "944939546569794", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974584_944939549903127_4671920987627351563_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSsyaClHUKcQ7kNvwFvAReu&_nc_oc=Adk__vbQq6guTGXIhJpNVmU2Vnh-jgpk8Kzv6GziAuXr4yfffTBiuUregqV3YCiiUig&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXROd1Ii3_L3pf1bU_ebfvZTs0SHmvBcclsCpVZAsdcQ&oe=69AD6873"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrollTrailer.png", "id": "962767298346981", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974924_962767301680314_1107704438361654547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCrwhLctqykQ7kNvwHMD4wF&_nc_oc=Adm-oifPypm99KzOGULYlyRalB_9Dy7MyveqkaLv5OKEPgimMP87Ic4jP2y71U1dzkM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwbop0BRX4qAQUlRITPTtQ0H2e7hDuMYu3iiPj4Z9g0Sg&oe=69AD7A21"}, "display_name": "Intergalactic", "keywords": [], "long_description": "Intergalactic:\n\n\nIntergalactic is a VR game centered in the setting of space.\n\nYou can explore a range of levels with big enemy ships,\n\nblack holes, asteroid fields, and more! You fly through space\n\nin a ship with a fully interactable, working futuristic HUD.\n\nFly through the levels and destroy randomly spawning ships, minibosses, and asteroids. \n\n\nDefeating these ships will sometimes spawn gears that you can\n\ncollect and use at the shop in the main menu to upgrade and improve your ship.\n\nThere is also a 5 mission campaign where you raid a huge enemy \n\nship and destroy it. The game comes with many QOL features \n\nsuch as a standing mode and setting to make the game more\n\ncomfortable for players who may experience VR sickness.\n\n\nYou can install the game on Quest 2 through SideQuest or other means\n", "short_description": "Destroy Asteroids and Ships, Explore Space!"}]}, "developer_name": "Nathaniel Skalabrin", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e37a87b5-8c6e-4cab-a95b-2fba11805434", "developer_terms_of_service_url": null, "publisher_name": "Bluejay Studios", "support_website_url": null, "website_url": "https://nskalabrin.wixsite.com/bluejay-studios", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1054840459026040"}, "review_messages": []
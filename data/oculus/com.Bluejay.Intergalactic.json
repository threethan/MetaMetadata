, "id": "1309088496352496", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54823267_1309088499685829_1502654632429521677_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4OsNKuyN_4Q7kNvwGmDb35&_nc_oc=AdqObSoYpyNEzGVqLmGd1_kO871q7JWWXYuojtz4ZccojM0THc-n9tfNdvgJyp99xss&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEaTwtnGc9yFLCVQGbGyNZ7oTOIzL8WiYpTtdVwRb8cA&oe=6B0303CE"}, {"file_name": "Screennew3.png", "id": "197039756363956", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035449_197039759697289_4085650435012425346_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07mWk6wLDZ0Q7kNvwF43_FO&_nc_oc=AdqzbaeNo5thUwTnuWkI_5mYf3arGKbnmgW-yX2eTW5xXZJz1dSQ_sE7LmaZ9VLRUcc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAdyddyalNH6ipsqX0gdBo3DGCz09pNU_fumPjcv_BvA&oe=6B031FA2"}, {"file_name": "screennew4.png", "id": "1470016790520652", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974726_1470016793853985_6573565894800513279_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5lPishm0ugQ7kNvwGsZyVM&_nc_oc=Adp_JqjVyuJwKMJuyxzQKc-6KKrdOM1CIHfeO_IKRZFZjZE-9oHyLlo8bc51lMXbLlM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEWNqlSen_MrpkOfTNgXfqa2S7chv2l2oJMerNNrIKCQ&oe=6B030F14"}, {"file_name": "Screennew5.png", "id": "944939546569794", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974584_944939549903127_4671920987627351563_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfRGoLSzDJcQ7kNvwEIf7C7&_nc_oc=AdpUrZ1MTVpvq9vRIzbXebbGQPbDradU1q8L2wWW9yyLz77Gd5aTLczEkR12L1JUoc4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJRW8SSHJi36819DN1pALFYlnqjLoVKHGWkod0fF3NjA&oe=6B031533"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrollTrailer.png", "id": "962767298346981", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974924_962767301680314_1107704438361654547_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJHUJoVoqucQ7kNvwH9TJ4K&_nc_oc=AdpqRs8DJmZTezBfLpowO29KcLhlovIik-aZkxiZjx6KqEv4SQEv6xIoEE4QszwA5-o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkZoISEkXZb3Al7SXCMggZA9sSwYD9emULrnxKWfO0Ig&oe=6B0326E1"}, "display_name": "Intergalactic", "keywords": [], "long_description": "Intergalactic:\n\n\nIntergalactic is a VR game centered in the setting of space.\n\nYou can explore a range of levels with big enemy ships,\n\nblack holes, asteroid fields, and more! You fly through space\n\nin a ship with a fully interactable, working futuristic HUD.\n\nFly through the levels and destroy randomly spawning ships, minibosses, and asteroids. \n\n\nDefeating these ships will sometimes spawn gears that you can\n\ncollect and use at the shop in the main menu to upgrade and improve your ship.\n\nThere is also a 5 mission campaign where you raid a huge enemy \n\nship and destroy it. The game comes with many QOL features \n\nsuch as a standing mode and setting to make the game more\n\ncomfortable for players who may experience VR sickness.\n\n\nYou can install the game on Quest 2 through SideQuest or other means\n", "short_description": "Destroy Asteroids and Ships, Explore Space!"}]}, "developer_name": "Nathaniel Skalabrin", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e37a87b5-8c6e-4cab-a95b-2fba11805434", "developer_terms_of_service_url": null, "publisher_name": "Bluejay Studios", "support_website_url": null, "website_url": "https://nskalabrin.wixsite.com/bluejay-studios", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
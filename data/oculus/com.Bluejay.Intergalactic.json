ZO&_nc_oc=Adpsb0FD6fanWb0fzTnuTdjxYTzd9zCmo0S0BbYBzJ6mPMnUsMkeAqUC5Wk9ZEvS3sI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINJyeJD1rFwebwcgoMagKBGgoCydXggQHaM6rbLUPC9A&oe=6AA417CE"}, {"file_name": "Screennew3.png", "id": "197039756363956", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035449_197039759697289_4085650435012425346_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9LEgJHCIPIQ7kNvwFjRWxT&_nc_oc=AdpyEfYmx-fa9cRJG2TI-uWcJz1C1F0EiRWNZ7LzT_qTaN5H6b_UkFcpf73nGxrIF70&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWk58exivOaEl4mNbEL5-d4hOMv-ZTidFraWQfoQPyeQ&oe=6AA3FB62"}, {"file_name": "screennew4.png", "id": "1470016790520652", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974726_1470016793853985_6573565894800513279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBYK6mPPLz0Q7kNvwGGx3js&_nc_oc=Adpj5fpzfcSoQvbP5_mpjDUJhKtpp0QGscupLlHhrOezPKiy_QAiglBZ3DHHuEKY_-M&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDyUicFpg9tDKzcjX18E-xNpBfr5OHw9SqndX5MKUwQw&oe=6AA42314"}, {"file_name": "Screennew5.png", "id": "944939546569794", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974584_944939549903127_4671920987627351563_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q14MfKHZdAAQ7kNvwHmVVKm&_nc_oc=AdoIGTDR0Z8vVznJVkvgtIwp3v2trHq_Qwa9c1TdQo-6U6luqm5LOKffh1djT0echiE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6u9heoSXGk3hSBRT2li0S72QKHyOht3W5EVu9hgY8lA&oe=6AA3F0F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrollTrailer.png", "id": "962767298346981", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974924_962767301680314_1107704438361654547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_b3vGk7t_sQ7kNvwF_RHeP&_nc_oc=AdotAGUbqIXCYFuEZxqgzw7QfW2q9-7KyqW2Z3_TbQ6VWOLnoov8LjILu1sYdKr7Cyw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtn4YOky_LVyu9Re5Lglm61elqBw7uq-dqoJXKQiYBFQ&oe=6AA402A1"}, "display_name": "Intergalactic", "keywords": [], "long_description": "Intergalactic:\n\n\nIntergalactic is a VR game centered in the setting of space.\n\nYou can explore a range of levels with big enemy ships,\n\nblack holes, asteroid fields, and more! You fly through space\n\nin a ship with a fully interactable, working futuristic HUD.\n\nFly through the levels and destroy randomly spawning ships, minibosses, and asteroids. \n\n\nDefeating these ships will sometimes spawn gears that you can\n\ncollect and use at the shop in the main menu to upgrade and improve your ship.\n\nThere is also a 5 mission campaign where you raid a huge enemy \n\nship and destroy it. The game comes with many QOL features \n\nsuch as a standing mode and setting to make the game more\n\ncomfortable for players who may experience VR sickness.\n\n\nYou can install the game on Quest 2 through SideQuest or other means\n", "short_description": "Destroy Asteroids and Ships, Explore Space!"}]}, "developer_name": "Nathaniel Skalabrin", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e37a87b5-8c6e-4cab-a95b-2fba11805434", "developer_terms_of_service_url": null, "publisher_name": "Bluejay Studios", "support_website_url": null, "website_url": "https://nskalabrin.wixsite.com/bluejay-studios", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
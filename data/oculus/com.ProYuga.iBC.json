ntent-iad3-2.oculuscdn.com/v/t64.5771-25/38982441_564625528759033_3472788579845730796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILt6YpxSNC0Q7kNvwHnDxCh&_nc_oc=AdlaP2tYk-oOoIClm3vBJqzWaanw8IMNlxIGBxNU56LOPDXctonXQU0S6sY0WcCI1Lg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuwNlJ_dMcI_GRgDP9Ar2l2q3HuuHjEN3KtlCsnoC3U3Q&oe=69A6DE19"}, {"file_name": "HomeScreen.png", "id": "836652667643899", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974897_836652670977232_7652191435006771155_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B79affD7jjEQ7kNvwES_5LW&_nc_oc=AdljtWJAGmd7uDStgrFeLKKXHOtuentb3ndklvMosgYRFQz8HU6UUavH3AGaJRg-QHU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfshHQCE-KY3wojoFl_1omlNBDiJ7dS3bXPMv1sB4J6j7w&oe=69A6CC90"}, {"file_name": "PracticeNets.png", "id": "1050662512268641", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75240099_1050662515601974_6020790145128572887_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTKGYNTnZXYQ7kNvwEVmfR5&_nc_oc=AdnpgM-a5dN-WFm7zaoEWw62edK4SF0woiMb1KwUpz_IiS3_fGFwdUuvbQeq8Y105GA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvyydVK8iEDLthWEeZFzNJZynFTcbg9jh0td8k0s0cIsQ&oe=69A6C091"}, {"file_name": "CampaignMode.png", "id": "621412579727793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75572758_621412583061126_6110164533952850496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgITjnlTNS8Q7kNvwG2Vr6c&_nc_oc=AdnkTjpSpqpquPIyNd-Ycx-u4Kdwa0BaCORAVDUr73Vhp-ABwDAsHF2t3bHEhL0x70E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsbiEtjTg4B21LzahDSETH2HG9SjvdVCGHNN9DrqIF-dg&oe=69A6D7DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "iBC_Oculus Assets_Cover Landscape - 2560x1440_v3.png", "id": "1198775474454980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610708_1198775477788313_4016531523126774863_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQwXkWBUWpwQ7kNvwGjKm91&_nc_oc=AdmjItmYscO3iZ41rDb1bkx4MEL8lvYV3jQlTWfWymVmzSIUtqt1_HcfWnP5CJIqCXU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsqaRj1Ji9tIXcifiFvbBuOXfSHxx9VY_wUfkj4p1p7Kg&oe=69A6EA23"}, "display_name": "iB Cricket", "keywords": ["Cricket", "VRCricket", "iBCricket", "VRBatting", "MetaverseCricket"], "long_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. \n\nTill date, over 500+ million balls have been played by people from 40+ countries, including both cricketing & non-cricketing nations. 98% of them said that iB Cricket is amazing! iB Cricket has also received appreciation from 100+ world-class Cricketers.\n- Numerous Bowling Options: Right arm, left arm; Fast, medium pace, off spin, leg spin & more.\n- Intelligent fielding based on built-in AI\n- Multiple Stadiums\n- PvP:  Bowl to your friends & challenge them in a one-on-one match. \n- Leagues & Tournaments\n- Multiple Cricket Formats: 20, 50, unlimited overs \n- Coaching Module \n- VR Bowling\n- Campaign Mode\n- CO-OP\n- Practice Nets\n- Fun MR Mode Games.\n\nHone your skills, compete in global tournaments & become a vSport star.", "short_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. Thousands of people from all over the world including non-cricketing nations have enjoyed playing iB Cricket. Hone your skills, compete in global tournaments & become a vSport star."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ib.cricket/game-privacy-policy/", "developer_terms_of_service_url": "https://ib.cricket/EULA/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_websi
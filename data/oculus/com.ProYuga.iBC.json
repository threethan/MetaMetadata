5-3.oculuscdn.com/v/t64.5771-25/38982441_564625528759033_3472788579845730796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILt6YpxSNC0Q7kNvwEnUY8F&_nc_oc=AdkP0PwHjNsiMLyzVZt19KwtYYb_PVn9IuUIs6pt369gz-IfIn_14uOfLvi9jr0Db5M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsmSNOIEEXSc8evtKYDuH_9wu-TH2xmsP59YiiTlG3gfA&oe=69A43B19"}, {"file_name": "HomeScreen.png", "id": "836652667643899", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974897_836652670977232_7652191435006771155_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlEhbfS-tNkQ7kNvwHSBSYw&_nc_oc=Adm7zdBKekRwBiG32SKMisBkIDD5evJRaCoY-jECeg3oV7K_e1ISeEgkJms9FqE1u8c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afun9iC05KYJcpzIts0gC6uWhCoU22QpZObSHzdiKVDSuQ&oe=69A42990"}, {"file_name": "PracticeNets.png", "id": "1050662512268641", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75240099_1050662515601974_6020790145128572887_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTKGYNTnZXYQ7kNvwHt8O6W&_nc_oc=AdmUXvZj32vlmMFBTtw1Knf7uhNCiV0xgmUT6h62IqiwtXZZ-P2a_1EuF3K9mEQQmCI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft1UqLwWcwFc7EU1225FWnMiJFW3Od1GeW1bv0lGj5OLA&oe=69A41D91"}, {"file_name": "CampaignMode.png", "id": "621412579727793", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75572758_621412583061126_6110164533952850496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBRflVjhjiUQ7kNvwHS8YUx&_nc_oc=Admcs1KZsJzgXGz1VcS6pmdvte7XNLo1I8r8yXeTLn86K0xHab_GVOIwi39Cq3QF7aM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvHfva7Z8TS_Wvzs8hNnkrVLp0raW8RE12n_O-5dC8uSw&oe=69A434DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "iBC_Oculus Assets_Cover Landscape - 2560x1440_v3.png", "id": "1198775474454980", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610708_1198775477788313_4016531523126774863_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXsM5p13Zz4Q7kNvwE_-M-U&_nc_oc=AdmLFUpNp6XsFLXSbJj3Nx1FnbsWCly3XHBBysDaRgsmmR3C7LX2PfxUhQQ8M5p_fKc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu2kB6Cz7nxSunlNttJwyfEvaizRuXCaGOXE0FSRtmAQw&oe=69A44723"}, "display_name": "iB Cricket", "keywords": ["Cricket", "VRCricket", "iBCricket", "VRBatting", "MetaverseCricket"], "long_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. \n\nTill date, over 500+ million balls have been played by people from 40+ countries, including both cricketing & non-cricketing nations. 98% of them said that iB Cricket is amazing! iB Cricket has also received appreciation from 100+ world-class Cricketers.\n- Numerous Bowling Options: Right arm, left arm; Fast, medium pace, off spin, leg spin & more.\n- Intelligent fielding based on built-in AI\n- Multiple Stadiums\n- PvP:  Bowl to your friends & challenge them in a one-on-one match. \n- Leagues & Tournaments\n- Multiple Cricket Formats: 20, 50, unlimited overs \n- Coaching Module \n- VR Bowling\n- Campaign Mode\n- CO-OP\n- Practice Nets\n- Fun MR Mode Games.\n\nHone your skills, compete in global tournaments & become a vSport star.", "short_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. Thousands of people from all over the world including non-cricketing nations have enjoyed playing iB Cricket. Hone your skills, compete in global tournaments & become a vSport star."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ib.cricket/game-privacy-policy/", "developer_terms_of_service_url": "https://ib.cricket/EULA/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": 
71-25/38974632_958500381511297_5538403479995970043_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmoVTR8CTE4Q7kNvwEX8GRA&_nc_oc=AdnoeUyr6Dgw0ANUotUp16_LRGiKMVghYfwopDNXaSlu5AmLipoVNSak7bSM40x5vSI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsQf51S-Zk4IfIRTp-IXlXbza2q-nD171EqtfjOFVnSTA&oe=69A41ABB"}, {"file_name": "BowlerProfile_In_Ground.png", "id": "684396066209758", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974570_684396069543091_7910715207076112134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gL8goy4w9-QQ7kNvwGLIN4j&_nc_oc=AdltjzxIzx6Oq4i1w3owOpDH3L3s-MS0TdhTYV8sc4m6JyC6mYxRblg041gOiOiF6So&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvkI-xGPYKgl_-awjy5XkbCU_vebUuwTDRzQuoDR1Zg5w&oe=69A429A0"}, {"file_name": "On_Hit_With_Bat_And_Fielding_In_Progress.png", "id": "541739497565882", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974808_541739500899215_6587236729130995403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gzV3-vMf6IQ7kNvwGsD_0-&_nc_oc=Adm56_wLnEEjLyaO_b-qmIX_nRqeO7i2-wbuOJeCHdWIRdnhu5GP505wH0fc7syXs4g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvcxPYeX_v5jbjKGZmwgg7Z0RRZDFpiHnlhaqSv6Qy_oA&oe=69A418A1"}, {"file_name": "On_Hitting_Four.png", "id": "3217682331845030", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974459_3217682335178363_237033845748482834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QR3VCavY3sQ7kNvwGGXqH0&_nc_oc=AdnJAvWA7-CPO5YIHDdHNdKolVL9j0w51umBndCxee5lwdEsSVQbWbA4XQnK_VV1d0s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsaeciKescYN4m30fCygU7OHZ0wQZvfvys0CxdseJrEPw&oe=69A42E92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Pic.png", "id": "287605153391285", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974522_287605156724618_5466474971579159763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnbiolZlvzEQ7kNvwHCFrZj&_nc_oc=Adm33iyHvzaAF7_rQNs8gLQ2mswx6hcB7CEOVpUCcHR2ALs5_KM1rmfvwuKtAqHwAIo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afve4qwDKnjXcS0Hr40jRGoPz_o1S-5H_X8qke2x5VRHwQ&oe=69A41C1B"}, "display_name": "iB Cricket", "keywords": ["Cricket", "VRCricket", "iBCricket", "BestCricket", "Sport"], "long_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. \n\nTill date, over 60 million balls have been played by people from 40+ countries, including both cricketing & non-cricketing nations. 98% of them said that iB Cricket is amazing! iB Cricket has also received appreciation from 100+ world-class Cricketers.\n- Numerous Bowling Options: Right arm, left arm; Fast, medium pace, off spin, leg spin & more.\n- Intelligent fielding based on built-in AI\n- Multiple Stadiums\n- PvP:  Bowl to your friends & challenge them in a one-on-one match. \n- Leagues & Tournaments\n- Multiple Cricket Formats: 20, 50, unlimited overs \n- Coaching Module \n\nHone your skills, compete in global tournaments & become a vSport star.", "short_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. Thousands of people from all over the world including non-cricketing nations have enjoyed playing iB Cricket. Hone your skills, compete in global tournaments & become a vSport star."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ib.cricket/privacy-policy/", "developer_terms_of_service_url": "https://ib.cricket/EULA/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": "https://bit.ly/iBCricket_Support", "website_url": "https://ib.cricket/", "category": "GAMES", "comfort_rating"
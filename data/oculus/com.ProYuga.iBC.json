4-1.oculuscdn.com/v/t64.5771-25/38982441_564625528759033_3472788579845730796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yorqezqv2FcQ7kNvwFoDugr&_nc_oc=AdncCerCiQ6mkST5Yu6uLwWHxxXChNzZnXL-fMg0jeaNSZz6GSrURIdo3Iv45EMTCOU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afv6EzJz5OSAIixh-ilHUSt6ZzIMOQbKRewOxgDvu3srvg&oe=69A19819"}, {"file_name": "HomeScreen.png", "id": "836652667643899", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974897_836652670977232_7652191435006771155_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlEhbfS-tNkQ7kNvwENzLDN&_nc_oc=AdnFmFkDxNqy-HoRhb-ioy2MmhACJc6NIwpRiZfp4Xzpl81UMab_cDZD7usETgmaZAk&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afs7gbKfwLx5nqfcGnMeHK9fk1nHGl2f2BYG2H1CNWYICg&oe=69A18690"}, {"file_name": "PracticeNets.png", "id": "1050662512268641", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75240099_1050662515601974_6020790145128572887_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWDxU_bwH4gQ7kNvwGfTTLm&_nc_oc=AdlbepQ70HeKaU9IhRFx_Wz36U_Mip_QzwfY8UxsDTYp1xn94V0jc14fcZOMsUTImKE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvwIPN7bsiC1lisVm2GR8ZcJPmTlQoSWCPqiQOIhy3tAA&oe=69A17A91"}, {"file_name": "CampaignMode.png", "id": "621412579727793", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75572758_621412583061126_6110164533952850496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBRflVjhjiUQ7kNvwFJS1rM&_nc_oc=AdmSJpQumhhRyGxq_ohHqKxs52sij1qwlHXM6qswlmk-4BvN46BCNdx8acB3BkEZqaI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftB-9JCKWW56c8pjSENg2d26p7_ldGvRplVrIFi5sIxsg&oe=69A191DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "iBC_Oculus Assets_Cover Landscape - 2560x1440_v3.png", "id": "1198775474454980", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/86610708_1198775477788313_4016531523126774863_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXsM5p13Zz4Q7kNvwGk02L3&_nc_oc=AdnpGdXnffTULTcdhq_fWjmB3YsYTrtyFfTiGEBzF87DnKTgVz7HihmI4SM1WnH-bww&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afsyg_owxuyK73QcgwXGTj66FHvnVwA1ZNlUOoNGV3lY4w&oe=69A1A423"}, "display_name": "iB Cricket", "keywords": ["Cricket", "VRCricket", "iBCricket", "VRBatting", "MetaverseCricket"], "long_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. \n\nTill date, over 500+ million balls have been played by people from 40+ countries, including both cricketing & non-cricketing nations. 98% of them said that iB Cricket is amazing! iB Cricket has also received appreciation from 100+ world-class Cricketers.\n- Numerous Bowling Options: Right arm, left arm; Fast, medium pace, off spin, leg spin & more.\n- Intelligent fielding based on built-in AI\n- Multiple Stadiums\n- PvP:  Bowl to your friends & challenge them in a one-on-one match. \n- Leagues & Tournaments\n- Multiple Cricket Formats: 20, 50, unlimited overs \n- Coaching Module \n- VR Bowling\n- Campaign Mode\n- CO-OP\n- Practice Nets\n- Fun MR Mode Games.\n\nHone your skills, compete in global tournaments & become a vSport star.", "short_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. Thousands of people from all over the world including non-cricketing nations have enjoyed playing iB Cricket. Hone your skills, compete in global tournaments & become a vSport star."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ib.cricket/game-privacy-policy/", "developer_terms_of_service_url": "https://ib.cricket/EULA/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": 
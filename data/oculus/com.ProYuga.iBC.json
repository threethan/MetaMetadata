71-25/38974632_958500381511297_5538403479995970043_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LInhJqsPfNoQ7kNvwE3ely7&_nc_oc=AdkMzRGMMdWmUNLhl-5TAWUqHfkpLuzp6iPhRIdk-VcOf-Y7uxeeLuSpRhKUmNNd1cI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsOf7OSfpgfy5jfD5vOLfr-o_rBuPhtCM8zXniZpaBRBA&oe=699AE03B"}, {"file_name": "BowlerProfile_In_Ground.png", "id": "684396066209758", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974570_684396069543091_7910715207076112134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCLgt9XPmlcQ7kNvwEN3S19&_nc_oc=AdkNHAPcG9nIuM4OkVBdpNdvCsHtuLLC53pss1xvI0BbxIJsYhx9zYhnhWvOqgpEC1Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvXaNxDlLAJrZcvfVgUJY7Yj28-LUIS2oL2odt_WxHylA&oe=699AEF20"}, {"file_name": "On_Hit_With_Bat_And_Fielding_In_Progress.png", "id": "541739497565882", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974808_541739500899215_6587236729130995403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0tFbFMr_F4Q7kNvwFVDyIa&_nc_oc=AdkIz4CCF9cFVODSComLA6_drJI011TctGg1LZk9MwEvMYbIrC_sam13yuE7WnSNeD4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuupLbzmgZ808ayVAw5BZuk923dyEkfy9TOiJk0kSBSVg&oe=699ADE21"}, {"file_name": "On_Hitting_Four.png", "id": "3217682331845030", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974459_3217682335178363_237033845748482834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkW96_TsZx4Q7kNvwFrFUZu&_nc_oc=Adlc3mnAa-1gVQs9rBbtgr07MtEA5eo8GSRDG-uWIa5bs86lAwqjyQeQdbEuUSa6aqw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsPzEhvtnhvxjA4OU9sL7CCSmTOnKhcLXRQ8ndaSrtoQg&oe=699AF412"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Pic.png", "id": "287605153391285", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974522_287605156724618_5466474971579159763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvW3PR446CIQ7kNvwG-Cw9V&_nc_oc=Adlf_MV2XX8k8BVyjZPmnkHchpuYMhWmjk3sBCOJIBb7JIfx4hPCgu3YtWP10Nhc890&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsPBPXKnb9DE91KhKoirBtWLkA1V5DkLQ79m-gLVPBYIw&oe=699AE19B"}, "display_name": "iB Cricket", "keywords": ["Cricket", "VRCricket", "iBCricket", "BestCricket", "Sport"], "long_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. \n\nTill date, over 60 million balls have been played by people from 40+ countries, including both cricketing & non-cricketing nations. 98% of them said that iB Cricket is amazing! iB Cricket has also received appreciation from 100+ world-class Cricketers.\n- Numerous Bowling Options: Right arm, left arm; Fast, medium pace, off spin, leg spin & more.\n- Intelligent fielding based on built-in AI\n- Multiple Stadiums\n- PvP:  Bowl to your friends & challenge them in a one-on-one match. \n- Leagues & Tournaments\n- Multiple Cricket Formats: 20, 50, unlimited overs \n- Coaching Module \n\nHone your skills, compete in global tournaments & become a vSport star.", "short_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. Thousands of people from all over the world including non-cricketing nations have enjoyed playing iB Cricket. Hone your skills, compete in global tournaments & become a vSport star."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ib.cricket/privacy-policy/", "developer_terms_of_service_url": "https://ib.cricket/EULA/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": "https://bit.ly/iBCricket_Support", "website_url": "https://ib.cricket/", "category": "GAMES", "comfort_rating"
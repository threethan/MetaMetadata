5-3.oculuscdn.com/v/t64.5771-25/38982441_564625528759033_3472788579845730796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pelbpfqLeQ0Q7kNvwEjnhdm&_nc_oc=AdkvFefp_JfGKQ6CwR_F4X9r5QH_APvYFvn_p1sWDl7zF_qodzKmfKSg1_FwpU9ttRw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsx64_bXf9tWPItYxDLesTn6n03kdI7v0J4Eg0F25vwTg&oe=699C5219"}, {"file_name": "HomeScreen.png", "id": "836652667643899", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974897_836652670977232_7652191435006771155_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFSimyJFgpQQ7kNvwFvLSpC&_nc_oc=AdkihRhGDOaFetur3KV_Lx2P9ST8_KNLvDr45URxc0eRRqI2FiapUHWcv938i2dzt_o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftIJcVUZ2daQHwwiRcMW804rpkcV6Aak2mLWkopXWgwUQ&oe=699C4090"}, {"file_name": "PracticeNets.png", "id": "1050662512268641", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75240099_1050662515601974_6020790145128572887_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2XxkQFpHf0Q7kNvwFzC5S9&_nc_oc=AdlzIIY-voIGnTeTzSq98r4z3hDCLr37r85YIj0LdmEZ3a93PoFC4rQZ58uFBACzzjE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvrlgAcv8Kef_RPYAwaLS0ObKkbZvzcBrkdUhCwJn-12Q&oe=699C3491"}, {"file_name": "CampaignMode.png", "id": "621412579727793", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75572758_621412583061126_6110164533952850496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haMXF6myUwcQ7kNvwEVoF1Z&_nc_oc=Adl7lEbMeK76wPC7fvZypP0BwMYNYY3BzIkaI3OFKmU2D3bFSOPycdi-GzfPnYvKjQQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuLyDXAqGs7pii_Lkts5XazCh_hdyysIWCGb25CyYGkmg&oe=699C4BDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "iBC_Oculus Assets_Cover Landscape - 2560x1440_v3.png", "id": "1198775474454980", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610708_1198775477788313_4016531523126774863_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40M8gxBWatsQ7kNvwEpZZLy&_nc_oc=AdmkmlK_lRpWNB90PMvnz3qh99KdePUYRh-50i3MQNWHko-PvyxzlIrE4rf4zpaevdY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftyia_2xCXFJXxTQEmD3S0J3bPAd0T_USoaxpsWSG-mRw&oe=699C5E23"}, "display_name": "iB Cricket", "keywords": ["Cricket", "VRCricket", "iBCricket", "VRBatting", "MetaverseCricket"], "long_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. \n\nTill date, over 500+ million balls have been played by people from 40+ countries, including both cricketing & non-cricketing nations. 98% of them said that iB Cricket is amazing! iB Cricket has also received appreciation from 100+ world-class Cricketers.\n- Numerous Bowling Options: Right arm, left arm; Fast, medium pace, off spin, leg spin & more.\n- Intelligent fielding based on built-in AI\n- Multiple Stadiums\n- PvP:  Bowl to your friends & challenge them in a one-on-one match. \n- Leagues & Tournaments\n- Multiple Cricket Formats: 20, 50, unlimited overs \n- Coaching Module \n- VR Bowling\n- Campaign Mode\n- CO-OP\n- Practice Nets\n- Fun MR Mode Games.\n\nHone your skills, compete in global tournaments & become a vSport star.", "short_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. Thousands of people from all over the world including non-cricketing nations have enjoyed playing iB Cricket. Hone your skills, compete in global tournaments & become a vSport star."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ib.cricket/game-privacy-policy/", "developer_terms_of_service_url": "https://ib.cricket/EULA/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": 
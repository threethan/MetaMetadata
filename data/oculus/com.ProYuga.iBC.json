hebZZIGMw&oe=69B3F772"}, {"file_name": "Replay.png", "id": "564625525425700", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982441_564625528759033_3472788579845730796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06K2zvzUPKIQ7kNvwF3uA8s&_nc_oc=AdmhtJdTtix2lk5wUqE8xVTRWeC6ET_jEBp0qqyF0fl6BaI2ygHEulEhLrtw3CpGkvo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyaUb_h11qRcrn8qF_yoPAuHBL4SAjVh58wDcJUbxsn-A&oe=69B40D19"}, {"file_name": "HomeScreen.png", "id": "836652667643899", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974897_836652670977232_7652191435006771155_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsiB99dAK1IQ7kNvwHY67l1&_nc_oc=AdmCE4YbOdEMUN57ofHkLaVmcMiTnQE87yrVIhQuh00oYZRpRhOfQRkTWxJerUtyJIE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyV24xYBSGDQNDUa3VC_b6giwYCp5uRzLKqncD5SX2eHg&oe=69B3FB90"}, {"file_name": "PracticeNets.png", "id": "1050662512268641", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75240099_1050662515601974_6020790145128572887_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XThIUYTkO6MQ7kNvwF9LBv5&_nc_oc=AdlLUonIUOGvlW6Ooj__EAbfKzA0fccvq3nlJTw8nK3uwQquF6rvN-GVcy6G2yWCsRM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwpSGZixdaJhfH2IJK7FyoFbxwJyRiyBTTk2hTat0DsRA&oe=69B3EF91"}, {"file_name": "CampaignMode.png", "id": "621412579727793", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75572758_621412583061126_6110164533952850496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGOCBY6Rw_oQ7kNvwFepZKn&_nc_oc=AdnbEEbbCKCQPsYSPSPfRzTeHWVEif1bqhmSZdrGexi6PkitGwhUFvhcTFBQ36gn8bg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzI6jsGcDlK00VhHafX7032zd1PsWox0TlrEMECLNQJBQ&oe=69B406DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "iBC_Oculus Assets_Cover Landscape - 2560x1440_v3.png", "id": "1198775474454980", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610708_1198775477788313_4016531523126774863_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqlrcSkPi9AQ7kNvwHae0oD&_nc_oc=Adm1RlLh8LiQMybobZXaSPVa_DMabmObc9Wk4I43MzCiV3qTJLlEnjGxtgAF00aNrW4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzcWoo5lTizEF315536ugrDBI87lPft8uyZCiq8q9aa8Q&oe=69B41923"}, "display_name": "iB Cricket", "keywords": ["Cricket", "VRCricket", "iBCricket", "VRBatting", "MetaverseCricket"], "long_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. \n\nTill date, over 500+ million balls have been played by people from 40+ countries, including both cricketing & non-cricketing nations. 98% of them said that iB Cricket is amazing! iB Cricket has also received appreciation from 100+ world-class Cricketers.\n- Numerous Bowling Options: Right arm, left arm; Fast, medium pace, off spin, leg spin & more.\n- Intelligent fielding based on built-in AI\n- Multiple Stadiums\n- PvP:  Bowl to your friends & challenge them in a one-on-one match. \n- Leagues & Tournaments\n- Multiple Cricket Formats: 20, 50, unlimited overs \n- Coaching Module \n- VR Bowling\n- Campaign Mode\n- CO-OP\n- Practice Nets\n- Fun MR Mode Games.\n\nHone your skills, compete in global tournaments & become a vSport star.", "short_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. Thousands of people from all over the world including non-cricketing nations have enjoyed playing iB Cricket. Hone your skills, compete in global tournaments & become a vSport star."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ib.cricket/game-privacy-pol
5/38974632_958500381511297_5538403479995970043_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvNDWV_JZHYQ7kNvwE-BuZ1&_nc_oc=AdkkoAsvmmiS7leUn24l2CJI6QGCOOq1bdSEEP6TWUInUq9ZnT5Vowrt-khajeXL7XE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuDrvEyBcL2dGFQOxgLvISWdV7fq1JiV2KUR7kpwLlDmQ&oe=699ED4BB"}, {"file_name": "BowlerProfile_In_Ground.png", "id": "684396066209758", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974570_684396069543091_7910715207076112134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4f5VURG0uwQ7kNvwG2qHED&_nc_oc=AdmUIQb4y1zXy-Jwv17F1eaQbdd-6-1g2hCA5g3_AKF_e8RdWiILNNNL2_OMInS_alM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft-14CL5nOiIEmoroStKjh18jFawNpDt2ndkqOCqF55Xg&oe=699EE3A0"}, {"file_name": "On_Hit_With_Bat_And_Fielding_In_Progress.png", "id": "541739497565882", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974808_541739500899215_6587236729130995403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqwLMYpdsFIQ7kNvwF61fhV&_nc_oc=AdnbndbRVcMKEjzxEQJJhgN7T_EDtFZ3hTSn_fzKOimPGFG7WRX9Gt225O0QkVzZZFg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftX5tBB7AA2xZX7u9cmh-PRMRp9qK871O3-BCR1R3uDGQ&oe=699ED2A1"}, {"file_name": "On_Hitting_Four.png", "id": "3217682331845030", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974459_3217682335178363_237033845748482834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgwSdBIqClcQ7kNvwGaJR80&_nc_oc=AdnNXM50w1U_ICVX_DxiKeupmTh36KQnkiKnypg8lX6DIsuz9bkVIPRYxQtfnL_PnEc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv2RedEvEh9vKydbQRm_Gmykb6xwaAdTjxnbLYP17UEbg&oe=699EE892"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Pic.png", "id": "287605153391285", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974522_287605156724618_5466474971579159763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cblACLwVzzwQ7kNvwGVuTQv&_nc_oc=AdlfUDwY9yf_pYKMhIkOeZCjmvaCdZiueOcuwMRnNDhbvo3RJY0VPE0Zn9cZgSx5fag&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfshtmXW3p9Vqc2B0e0b97SGnvzOp4-pfP3eVLBKP-3Uiw&oe=699ED61B"}, "display_name": "iB Cricket", "keywords": ["Cricket", "VRCricket", "iBCricket", "BestCricket", "Sport"], "long_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. \n\nTill date, over 60 million balls have been played by people from 40+ countries, including both cricketing & non-cricketing nations. 98% of them said that iB Cricket is amazing! iB Cricket has also received appreciation from 100+ world-class Cricketers.\n- Numerous Bowling Options: Right arm, left arm; Fast, medium pace, off spin, leg spin & more.\n- Intelligent fielding based on built-in AI\n- Multiple Stadiums\n- PvP:  Bowl to your friends & challenge them in a one-on-one match. \n- Leagues & Tournaments\n- Multiple Cricket Formats: 20, 50, unlimited overs \n- Coaching Module \n\nHone your skills, compete in global tournaments & become a vSport star.", "short_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. Thousands of people from all over the world including non-cricketing nations have enjoyed playing iB Cricket. Hone your skills, compete in global tournaments & become a vSport star."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ib.cricket/privacy-policy/", "developer_terms_of_service_url": "https://ib.cricket/EULA/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": "https://bit.ly/iBCricket_Support", "website_url": "https://ib.cricket/", "category": "GAMES", "comfort_rating": "C
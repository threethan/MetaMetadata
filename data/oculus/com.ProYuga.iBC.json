/v/t64.5771-25/38974632_958500381511297_5538403479995970043_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmoVTR8CTE4Q7kNvwHj3l5j&_nc_oc=Adl7mgLfNkirsE0iI-CB55oTwlrFaboSlNAi8fztuhgqVfjdVVPxiLz0DafvwtXFxoE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuwa_0DoQkyEHfRdd_pj2cnG4_t7ZujqHecmKUAF2ciDg&oe=69A6BDBB"}, {"file_name": "BowlerProfile_In_Ground.png", "id": "684396066209758", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974570_684396069543091_7910715207076112134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gL8goy4w9-QQ7kNvwHnYUOs&_nc_oc=Adm6U6xUD3krNrecopCr_Sv4o6zcdhEpmlyug6v-QqR0GSJThHA-qvujuFwcJVp_9fs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu_GvCe_VOhL813LHoe8nJylbOB0eimYWowe4pGLDf9yQ&oe=69A6CCA0"}, {"file_name": "On_Hit_With_Bat_And_Fielding_In_Progress.png", "id": "541739497565882", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974808_541739500899215_6587236729130995403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGd3gQMRn1UQ7kNvwHbkxfx&_nc_oc=AdlGWGev2xshy_cidlrPppNEx923vvEtWfGJj3gYn92esC5UUk3SPpw2-iz9QgE_vTQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsMEx05NGPN9FIuNQa8so1IISXHRghTVE-4k1gthYU6ag&oe=69A6F3E1"}, {"file_name": "On_Hitting_Four.png", "id": "3217682331845030", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974459_3217682335178363_237033845748482834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGjTaBQBBFkQ7kNvwEMzXc6&_nc_oc=AdlEEJtoy946DHi7HsYJ_248hq6ATBuWoPwZrzEcoyDW0qdy8jUtQs39PCZLTIKK2Mo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftADGeqpZzE00WGUCHez04WYU9eRlMKARQaZB6w_PCG_w&oe=69A6D192"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Pic.png", "id": "287605153391285", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974522_287605156724618_5466474971579159763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnbiolZlvzEQ7kNvwHdEZQf&_nc_oc=AdnhD0PCvh1gG-UcdrVcZM57auQ8n6eaxdY6OkUGATpE4j6iigdpL8GNHnwWVo1f0M4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuv-v0uT6zN3npWd1yeV8U5FEFxw3awixOiw9nwtLCdVg&oe=69A6BF1B"}, "display_name": "iB Cricket", "keywords": ["Cricket", "VRCricket", "iBCricket", "BestCricket", "Sport"], "long_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. \n\nTill date, over 60 million balls have been played by people from 40+ countries, including both cricketing & non-cricketing nations. 98% of them said that iB Cricket is amazing! iB Cricket has also received appreciation from 100+ world-class Cricketers.\n- Numerous Bowling Options: Right arm, left arm; Fast, medium pace, off spin, leg spin & more.\n- Intelligent fielding based on built-in AI\n- Multiple Stadiums\n- PvP:  Bowl to your friends & challenge them in a one-on-one match. \n- Leagues & Tournaments\n- Multiple Cricket Formats: 20, 50, unlimited overs \n- Coaching Module \n\nHone your skills, compete in global tournaments & become a vSport star.", "short_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. Thousands of people from all over the world including non-cricketing nations have enjoyed playing iB Cricket. Hone your skills, compete in global tournaments & become a vSport star."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ib.cricket/privacy-policy/", "developer_terms_of_service_url": "https://ib.cricket/EULA/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": "https://bit.ly/iBCricket_Support", "website_url": "https://ib.cricket/", "category": "GAMES", "comfor
71-25/38974632_958500381511297_5538403479995970043_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pR1PJrHRLRwQ7kNvwEOM-F2&_nc_oc=AdmAOD4ilyxOm-MK7Ii1nFsT0FHUwpMOokvq_7Z0meSQVPe-kP09H3XUw3X2woUZa_0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuMWjbS7qd5SYX7eJIVx4_RzlIBpj4RgwsTbmQk4ZGDWA&oe=69A2C93B"}, {"file_name": "BowlerProfile_In_Ground.png", "id": "684396066209758", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974570_684396069543091_7910715207076112134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wwg_7FjHT8QQ7kNvwHKBbU1&_nc_oc=AdlKvzUPz23gcdR2W3SdKB29c4MaybUUVSPpger3XOSu830zS8QvkY-QsfS49ZdDm5c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv8whBCItrBG3NluNi3LUuLiy11GrpqPUzCsR2ovsCL6A&oe=69A2D820"}, {"file_name": "On_Hit_With_Bat_And_Fielding_In_Progress.png", "id": "541739497565882", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974808_541739500899215_6587236729130995403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gzV3-vMf6IQ7kNvwEGP7pu&_nc_oc=AdmatJfVbKi0ZxNO9JtGGxoBskul2qxwlHxOGfConKKv5rILtGhIL9qkEEGiAlPeSUU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftnDrqmWLMlXzwj12JRsGLJu0nXyDODjMPlIvw2NwbPOQ&oe=69A2C721"}, {"file_name": "On_Hitting_Four.png", "id": "3217682331845030", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974459_3217682335178363_237033845748482834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QR3VCavY3sQ7kNvwEChajD&_nc_oc=AdlnOyorZjUtbs2FylxHqOHp3gxBRWEqc5foh-On6UPMh5xi_cVKKRTRifGrQSRjNhA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfulVxVApoMF2kuu2EAFKQ1CAdlldvgSNNjAHisiuzjPEQ&oe=69A2DD12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Pic.png", "id": "287605153391285", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974522_287605156724618_5466474971579159763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUPa6wgTm4YQ7kNvwFVR7xF&_nc_oc=Adl5hmCTJ1TXA-eK2uh8qvsdHi2ad_-n7jR-Pq6NqgWL2L_YQ3tkrsC5CZz8YriIsEk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu2VlZVlJnL_zPY9CC8aQiANpd1y7BBpTSrK4zkpZvOaw&oe=69A2CA9B"}, "display_name": "iB Cricket", "keywords": ["Cricket", "VRCricket", "iBCricket", "BestCricket", "Sport"], "long_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. \n\nTill date, over 60 million balls have been played by people from 40+ countries, including both cricketing & non-cricketing nations. 98% of them said that iB Cricket is amazing! iB Cricket has also received appreciation from 100+ world-class Cricketers.\n- Numerous Bowling Options: Right arm, left arm; Fast, medium pace, off spin, leg spin & more.\n- Intelligent fielding based on built-in AI\n- Multiple Stadiums\n- PvP:  Bowl to your friends & challenge them in a one-on-one match. \n- Leagues & Tournaments\n- Multiple Cricket Formats: 20, 50, unlimited overs \n- Coaching Module \n\nHone your skills, compete in global tournaments & become a vSport star.", "short_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. Thousands of people from all over the world including non-cricketing nations have enjoyed playing iB Cricket. Hone your skills, compete in global tournaments & become a vSport star."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ib.cricket/privacy-policy/", "developer_terms_of_service_url": "https://ib.cricket/EULA/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": "https://bit.ly/iBCricket_Support", "website_url": "https://ib.cricket/", "category": "GAMES", "comfort_rating"
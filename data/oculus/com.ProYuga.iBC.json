71-25/38974632_958500381511297_5538403479995970043_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvNDWV_JZHYQ7kNvwGTji-C&_nc_oc=AdkaAZtln42sa71xnBZzyno-bZFWk66FDq-0XrmUH6fK7iCRCwDiXEos7CNMvWBbWTk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsRE5-tkUfQyz8c3ediWZjtOM_BsBjZFOdO7VlMV2s_ew&oe=699D833B"}, {"file_name": "BowlerProfile_In_Ground.png", "id": "684396066209758", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974570_684396069543091_7910715207076112134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4f5VURG0uwQ7kNvwHsGyAX&_nc_oc=Adlia-3Ed-hMD1coASMy8hLPDt0LeTYt4q8nNdqSRvF8TTcc8s6dBTo7SpUSkJioCwg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfurAvWNLS3AyaNp19T6cN9COGgZ0-yuyx_dllnKqwC1Yw&oe=699D9220"}, {"file_name": "On_Hit_With_Bat_And_Fielding_In_Progress.png", "id": "541739497565882", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974808_541739500899215_6587236729130995403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqwLMYpdsFIQ7kNvwE4BTwC&_nc_oc=AdmQUkif64kQZIDbUdf_fuX5LQILEHfejmVBpjImL-uD4qg3LqqECB0c-csEM4sIeHY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afua12-0_lTtP3_s5eQg0xLVFVT1WuJqHRPv73ZPps6BLQ&oe=699D8121"}, {"file_name": "On_Hitting_Four.png", "id": "3217682331845030", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974459_3217682335178363_237033845748482834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgwSdBIqClcQ7kNvwFtW04G&_nc_oc=AdlNDNXRnsm2NECUo_4BlwLBNhE0atv9yd1HYCsY-SJm9qcVaHRADuyVoXgz2cI6PR4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsX1Vj44QSQ-hye3ZurwFff8HnuIWZ19voplRIdvKYvUw&oe=699D9712"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Pic.png", "id": "287605153391285", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974522_287605156724618_5466474971579159763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cblACLwVzzwQ7kNvwFEj2Pr&_nc_oc=Admoa2aymAqIZ8istViLUVHOBjkQQKXbZnAv1ILq1QLLQATQTY9b9kQ3qPvK5jqzgNw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsmObAXDzgWlO8eNyDr9DKegvOgRV_urx0ACxE6RKuAbw&oe=699D849B"}, "display_name": "iB Cricket", "keywords": ["Cricket", "VRCricket", "iBCricket", "BestCricket", "Sport"], "long_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. \n\nTill date, over 60 million balls have been played by people from 40+ countries, including both cricketing & non-cricketing nations. 98% of them said that iB Cricket is amazing! iB Cricket has also received appreciation from 100+ world-class Cricketers.\n- Numerous Bowling Options: Right arm, left arm; Fast, medium pace, off spin, leg spin & more.\n- Intelligent fielding based on built-in AI\n- Multiple Stadiums\n- PvP:  Bowl to your friends & challenge them in a one-on-one match. \n- Leagues & Tournaments\n- Multiple Cricket Formats: 20, 50, unlimited overs \n- Coaching Module \n\nHone your skills, compete in global tournaments & become a vSport star.", "short_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. Thousands of people from all over the world including non-cricketing nations have enjoyed playing iB Cricket. Hone your skills, compete in global tournaments & become a vSport star."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ib.cricket/privacy-policy/", "developer_terms_of_service_url": "https://ib.cricket/EULA/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": "https://bit.ly/iBCricket_Support", "website_url": "https://ib.cricket/", "category": "GAMES", "comfort_rating"
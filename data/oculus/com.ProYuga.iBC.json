3-1.oculuscdn.com/v/t64.5771-25/38982441_564625528759033_3472788579845730796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILt6YpxSNC0Q7kNvwGsxnZh&_nc_oc=AdmlPhoX6Q7q5hJ4L_70FYYrDn6XvdXtwyUBS2rru_aPJF2tPgCkBBbwf7JBGyDTMtc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftPoAM-wNVYsbwvy5btwdCyZvDjvSNF7owHiFXvXnrrXQ&oe=69A58C99"}, {"file_name": "HomeScreen.png", "id": "836652667643899", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974897_836652670977232_7652191435006771155_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B79affD7jjEQ7kNvwHueb32&_nc_oc=Adku7f_Wgx7LO24yunAMaCPfET-7zhN6obVBou-CfYg1Op3PxH2SrIj4U4hQl89QXgI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsDFOCb_W8_e8WLJJoJbJey4pP81eaS1-y82xJf4Gswdg&oe=69A57B10"}, {"file_name": "PracticeNets.png", "id": "1050662512268641", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75240099_1050662515601974_6020790145128572887_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTKGYNTnZXYQ7kNvwF87FlP&_nc_oc=Adnm7evMycXIGMJrpZzxYfH02UZ5o3zkdocz-5prmK062C2nPQvT2pjPa2gffd7nmrk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuWyOpTEd8QOO2wWBrSDkZVbeomtOdEuguoDlmZXVVIvQ&oe=69A56F11"}, {"file_name": "CampaignMode.png", "id": "621412579727793", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75572758_621412583061126_6110164533952850496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgITjnlTNS8Q7kNvwHugnCU&_nc_oc=AdnF5hnXU14uBBxUBG_XWFDc-ydPu8sJk-RhPXRXmP-HJgmnj6ZS2pG5YVETup80hQI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuYgJImFP3e75RJD0521eEZbQmyTTHLjWRG8LSvbnXkmA&oe=69A5865F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "iBC_Oculus Assets_Cover Landscape - 2560x1440_v3.png", "id": "1198775474454980", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610708_1198775477788313_4016531523126774863_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQwXkWBUWpwQ7kNvwGntXoL&_nc_oc=AdnJBds4dHp2lEbO0ZLM1uLN0IEMLILcOINXevQ9-ERDm7DqageTcX-qOH9aqhfDfWE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvpXZuJ2gemaudF6JuLX4PrFIFuj3puhC06SQQgpQcn7w&oe=69A598A3"}, "display_name": "iB Cricket", "keywords": ["Cricket", "VRCricket", "iBCricket", "VRBatting", "MetaverseCricket"], "long_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. \n\nTill date, over 500+ million balls have been played by people from 40+ countries, including both cricketing & non-cricketing nations. 98% of them said that iB Cricket is amazing! iB Cricket has also received appreciation from 100+ world-class Cricketers.\n- Numerous Bowling Options: Right arm, left arm; Fast, medium pace, off spin, leg spin & more.\n- Intelligent fielding based on built-in AI\n- Multiple Stadiums\n- PvP:  Bowl to your friends & challenge them in a one-on-one match. \n- Leagues & Tournaments\n- Multiple Cricket Formats: 20, 50, unlimited overs \n- Coaching Module \n- VR Bowling\n- Campaign Mode\n- CO-OP\n- Practice Nets\n- Fun MR Mode Games.\n\nHone your skills, compete in global tournaments & become a vSport star.", "short_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. Thousands of people from all over the world including non-cricketing nations have enjoyed playing iB Cricket. Hone your skills, compete in global tournaments & become a vSport star."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ib.cricket/game-privacy-policy/", "developer_terms_of_service_url": "https://ib.cricket/EULA/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": 
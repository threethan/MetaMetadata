3-2.oculuscdn.com/v/t64.5771-25/38982441_564625528759033_3472788579845730796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pelbpfqLeQ0Q7kNvwHdyPp9&_nc_oc=AdmJrqQ6v7rRLr2dq02vjumJH_kA_RG32LD4cdHHeFd3mwUrLw7K4goiejjzG3UVrKs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvFQGoiM5OtEsB3WJ1ZzkgvzG1JuLeRyOwIdKbGtoEiqw&oe=699DA399"}, {"file_name": "HomeScreen.png", "id": "836652667643899", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974897_836652670977232_7652191435006771155_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6qu-gf463sQ7kNvwGsxVmw&_nc_oc=AdkuYeTJC52eLpFAYfop9E8941zECF8LvK4rRd6ZaS37dJFpZNn2j6F1MDJkqJDZlnA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuUKQV0tFFGHyqNaFVvK_qarUHIdIld0kwIRpQI-fButw&oe=699D9210"}, {"file_name": "PracticeNets.png", "id": "1050662512268641", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75240099_1050662515601974_6020790145128572887_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2XxkQFpHf0Q7kNvwGYo9g2&_nc_oc=AdnbsX1S5isGrIZW8rmEERTgBlIeLf-dV9DzKFM5118Qrx4H_uegRWRDO62PMYgfvOw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft7QEST61PUencBNi2ZqQK0WdqlzvYCgixDBIjehi0S9w&oe=699D8611"}, {"file_name": "CampaignMode.png", "id": "621412579727793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75572758_621412583061126_6110164533952850496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANTXSE_1tYMQ7kNvwGCmiJ5&_nc_oc=AdmvGcMC2YF_oexwWTTKHdc4tIfoZ0J9CuihU-Jdkbe6itu-fsqT4ymme1qfwt8F1Ac&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftjG8RLedOT_tlteSptv9b2McMxsiAjDqxVbdZSRRQVDg&oe=699D9D5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "iBC_Oculus Assets_Cover Landscape - 2560x1440_v3.png", "id": "1198775474454980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610708_1198775477788313_4016531523126774863_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgmx5CMyGh8Q7kNvwE6_8NK&_nc_oc=Adl4o8o5uJRvTVk4zgjVt3AcZ30wECIAhlAkx3fHW_ruBdUXoZE50WgHfy44slD1VNU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuGoo7QJuv-DmR1i55vojSUsZhBoWs8pe_0JMRxnAh4sw&oe=699DAFA3"}, "display_name": "iB Cricket", "keywords": ["Cricket", "VRCricket", "iBCricket", "VRBatting", "MetaverseCricket"], "long_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. \n\nTill date, over 500+ million balls have been played by people from 40+ countries, including both cricketing & non-cricketing nations. 98% of them said that iB Cricket is amazing! iB Cricket has also received appreciation from 100+ world-class Cricketers.\n- Numerous Bowling Options: Right arm, left arm; Fast, medium pace, off spin, leg spin & more.\n- Intelligent fielding based on built-in AI\n- Multiple Stadiums\n- PvP:  Bowl to your friends & challenge them in a one-on-one match. \n- Leagues & Tournaments\n- Multiple Cricket Formats: 20, 50, unlimited overs \n- Coaching Module \n- VR Bowling\n- Campaign Mode\n- CO-OP\n- Practice Nets\n- Fun MR Mode Games.\n\nHone your skills, compete in global tournaments & become a vSport star.", "short_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. Thousands of people from all over the world including non-cricketing nations have enjoyed playing iB Cricket. Hone your skills, compete in global tournaments & become a vSport star."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ib.cricket/game-privacy-policy/", "developer_terms_of_service_url": "https://ib.cricket/EULA/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": 
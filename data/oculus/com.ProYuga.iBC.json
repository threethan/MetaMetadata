71-25/38974632_958500381511297_5538403479995970043_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvNDWV_JZHYQ7kNvwG5TzCJ&_nc_oc=Adm7AiNsXmPnayrMwJm8dLQVMsZquUs-2aC2CuqINobWyr_HpTjfmGT8FnXP04m32do&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvsCjh3GNrklzktU1WMntxnQav5EEF_7u-OLPYmc47QoQ&oe=699C31BB"}, {"file_name": "BowlerProfile_In_Ground.png", "id": "684396066209758", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974570_684396069543091_7910715207076112134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4f5VURG0uwQ7kNvwFxcZxA&_nc_oc=AdlrIMA9NzQ77piNjWpQm9fZFn34MGjWOnbsW0VDO7VqAMJH2Gwi3m7XLaSlvkh_GNI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu9g2iM_L2WrhfbrlyCgT7ej9JDYxjOT-QkpXbQhqo62g&oe=699C40A0"}, {"file_name": "On_Hit_With_Bat_And_Fielding_In_Progress.png", "id": "541739497565882", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974808_541739500899215_6587236729130995403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0tFbFMr_F4Q7kNvwEU0w3k&_nc_oc=Adl0mMeaZbirzSbTBIL0BnrVrzVt16KbspMABR2HyTfEdf3bLn95j3-y8V8ejh0Zx8s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsU1KrenqBEDcE9dAkxPv_sRonokU9KugyOae_qmweseA&oe=699C2FA1"}, {"file_name": "On_Hitting_Four.png", "id": "3217682331845030", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974459_3217682335178363_237033845748482834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkW96_TsZx4Q7kNvwHitoJC&_nc_oc=AdmhQNfnjK9OqYmUQGDgugruMlDD8Xa3j_3ZSoAlPqUfSqhjCI9NAFz9kUhwwtlkZno&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftpXuplGC3Z9kH6n4cNBbaTo7AiBG7b1CYvYPMB8v986w&oe=699C4592"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Pic.png", "id": "287605153391285", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974522_287605156724618_5466474971579159763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cblACLwVzzwQ7kNvwHOkCVr&_nc_oc=AdmlsKAIeWwEMVABbGRp5V_6aeCDJ5M89ZJPfIgNd7_wELYpeJ1qoeLgpnrXXYecutg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv5C_ey1ykHpjfq5arFFAsqmmthVqhh7pzCwTZlKyi6rw&oe=699C331B"}, "display_name": "iB Cricket", "keywords": ["Cricket", "VRCricket", "iBCricket", "BestCricket", "Sport"], "long_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. \n\nTill date, over 60 million balls have been played by people from 40+ countries, including both cricketing & non-cricketing nations. 98% of them said that iB Cricket is amazing! iB Cricket has also received appreciation from 100+ world-class Cricketers.\n- Numerous Bowling Options: Right arm, left arm; Fast, medium pace, off spin, leg spin & more.\n- Intelligent fielding based on built-in AI\n- Multiple Stadiums\n- PvP:  Bowl to your friends & challenge them in a one-on-one match. \n- Leagues & Tournaments\n- Multiple Cricket Formats: 20, 50, unlimited overs \n- Coaching Module \n\nHone your skills, compete in global tournaments & become a vSport star.", "short_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. Thousands of people from all over the world including non-cricketing nations have enjoyed playing iB Cricket. Hone your skills, compete in global tournaments & become a vSport star."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ib.cricket/privacy-policy/", "developer_terms_of_service_url": "https://ib.cricket/EULA/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": "https://bit.ly/iBCricket_Support", "website_url": "https://ib.cricket/", "category": "GAMES", "comfort_rating"
3-2.oculuscdn.com/v/t64.5771-25/38982441_564625528759033_3472788579845730796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yorqezqv2FcQ7kNvwGUpSJ4&_nc_oc=AdmKwap68zVlTSVv6YYXz-msv7i8F9zbTIVKGM6dKBZ7ZhCJRhe1pNh3NDnupQysK0k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvbPavS2Q0HTJ4JGMTfIc-8LOX1G_wLdNIOBYgTMXFs2A&oe=69A2E999"}, {"file_name": "HomeScreen.png", "id": "836652667643899", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974897_836652670977232_7652191435006771155_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlEhbfS-tNkQ7kNvwFUFQrm&_nc_oc=AdmmxAzcAuOQW8UXiYK2kjrkHJPbgwPXIRnAbl3tLHG2sbgtnfleVND9CXgBMY5_VdE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu24eZOX-4wIBrVgLM0j-C_IbJj5MeSVXBXCHjnLZBYOw&oe=69A2D810"}, {"file_name": "PracticeNets.png", "id": "1050662512268641", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75240099_1050662515601974_6020790145128572887_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWDxU_bwH4gQ7kNvwFI3Giv&_nc_oc=AdlM2KFx-Zh1gpoRqvBX0bCZhMOtQUTtEjYrkb3QQB3z9-gOwcobpaIMlc7n0nsv4WA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvWHSOYpRX1v1Xb0MDyMnci22ppyQ9obY1krJxvmUu6nw&oe=69A2CC11"}, {"file_name": "CampaignMode.png", "id": "621412579727793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75572758_621412583061126_6110164533952850496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBRflVjhjiUQ7kNvwEl2Aig&_nc_oc=Adn5qygdOdrI2St4wvzbq3yx10e2HvhzwO5sd1guKBSictIOFQ-fnkuRtavdGEUpqzI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvKdtKKIFRqVg9ClQqtuJejF3j_95TZROAl0Vs5vSvhpQ&oe=69A2E35F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "iBC_Oculus Assets_Cover Landscape - 2560x1440_v3.png", "id": "1198775474454980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610708_1198775477788313_4016531523126774863_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXsM5p13Zz4Q7kNvwE5o0LN&_nc_oc=AdkLePMge5MvPd50RvudH9DnGUUUHldcA8EvKcYEDWEukNmdn_kAd8Vewz5hCFulApE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuZq_81wMb7I_ykkfpvN4EsQIvizMVg5a8Kz40usm8YWQ&oe=69A2F5A3"}, "display_name": "iB Cricket", "keywords": ["Cricket", "VRCricket", "iBCricket", "VRBatting", "MetaverseCricket"], "long_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. \n\nTill date, over 500+ million balls have been played by people from 40+ countries, including both cricketing & non-cricketing nations. 98% of them said that iB Cricket is amazing! iB Cricket has also received appreciation from 100+ world-class Cricketers.\n- Numerous Bowling Options: Right arm, left arm; Fast, medium pace, off spin, leg spin & more.\n- Intelligent fielding based on built-in AI\n- Multiple Stadiums\n- PvP:  Bowl to your friends & challenge them in a one-on-one match. \n- Leagues & Tournaments\n- Multiple Cricket Formats: 20, 50, unlimited overs \n- Coaching Module \n- VR Bowling\n- Campaign Mode\n- CO-OP\n- Practice Nets\n- Fun MR Mode Games.\n\nHone your skills, compete in global tournaments & become a vSport star.", "short_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. Thousands of people from all over the world including non-cricketing nations have enjoyed playing iB Cricket. Hone your skills, compete in global tournaments & become a vSport star."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ib.cricket/game-privacy-policy/", "developer_terms_of_service_url": "https://ib.cricket/EULA/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": 
71-25/38974632_958500381511297_5538403479995970043_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pR1PJrHRLRwQ7kNvwEdLNVz&_nc_oc=AdmB3i5AxdxH5EOWmhNWGh0Ri1SiJMa0S3Ujnbk3vQSTAAEH0ZTEIgOzTiT6kFn2pvU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afusj1pcqSzXoy-6AsNmI423698-cGgTgkEK6z1gxDXlGQ&oe=69A177BB"}, {"file_name": "BowlerProfile_In_Ground.png", "id": "684396066209758", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974570_684396069543091_7910715207076112134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wwg_7FjHT8QQ7kNvwHHjrY0&_nc_oc=Adnq_08qSYRxIWY7EAuTaJS_2L6NT0TSjAoPCqTzzwj0BiP9-HzbLAxTDnGLhWoF3rU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afs6YNzn5jS19Qwu_3YK_e0beaMpZpvzT3xVtxVg1qLxKQ&oe=69A186A0"}, {"file_name": "On_Hit_With_Bat_And_Fielding_In_Progress.png", "id": "541739497565882", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974808_541739500899215_6587236729130995403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gzV3-vMf6IQ7kNvwHW8Ahy&_nc_oc=Admbw4ahL7wYEP17GnFhBZPCQBSbNdAVZoKPqI98C0gN4wYHQgmCUTYygszgvcxymxU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuUyXiwfrwkLMTs0pXy_uGQjmq1j2Bd-0375Db5iP924Q&oe=69A175A1"}, {"file_name": "On_Hitting_Four.png", "id": "3217682331845030", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974459_3217682335178363_237033845748482834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QR3VCavY3sQ7kNvwFMC8l5&_nc_oc=Adm9SXR8C7sl7QmwIUVkgiSu2WFdxKjR9rnP4CcCV6mhS77UIoV6sdh_hVRPhwwroHM&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afts-uESsQrxML-_4GGt9ueHpbY2gzd3Ek2Ljv5VUQOo3A&oe=69A18B92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Pic.png", "id": "287605153391285", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974522_287605156724618_5466474971579159763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUPa6wgTm4YQ7kNvwH92m93&_nc_oc=AdkiUm57EgHLTPTXcjtFG5Q3NA6cWurlXKaX7tv9owsGaqSKkKPzlZfkfzBQWG9PyJc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftYGh0GKFAFgy25dQDTPedsh2-rgoTvAJJfhTOKoTromQ&oe=69A1791B"}, "display_name": "iB Cricket", "keywords": ["Cricket", "VRCricket", "iBCricket", "BestCricket", "Sport"], "long_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. \n\nTill date, over 60 million balls have been played by people from 40+ countries, including both cricketing & non-cricketing nations. 98% of them said that iB Cricket is amazing! iB Cricket has also received appreciation from 100+ world-class Cricketers.\n- Numerous Bowling Options: Right arm, left arm; Fast, medium pace, off spin, leg spin & more.\n- Intelligent fielding based on built-in AI\n- Multiple Stadiums\n- PvP:  Bowl to your friends & challenge them in a one-on-one match. \n- Leagues & Tournaments\n- Multiple Cricket Formats: 20, 50, unlimited overs \n- Coaching Module \n\nHone your skills, compete in global tournaments & become a vSport star.", "short_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. Thousands of people from all over the world including non-cricketing nations have enjoyed playing iB Cricket. Hone your skills, compete in global tournaments & become a vSport star."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ib.cricket/privacy-policy/", "developer_terms_of_service_url": "https://ib.cricket/EULA/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": "https://bit.ly/iBCricket_Support", "website_url": "https://ib.cricket/", "category": "GAMES", "comfort_rating"
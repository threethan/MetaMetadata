71-25/38974632_958500381511297_5538403479995970043_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmoVTR8CTE4Q7kNvwFYPSpE&_nc_oc=AdmLMkXGCAYygmUVgKLZYafOg7YnpGVMdoLq7WtEKfR7engjB9itK_R5IdqR8RZJIxU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afv94HxPNbIYT34oCrkQR-MUc-SP2cEvGV4iXXVqti3XDg&oe=69A56C3B"}, {"file_name": "BowlerProfile_In_Ground.png", "id": "684396066209758", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974570_684396069543091_7910715207076112134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gL8goy4w9-QQ7kNvwEepDbK&_nc_oc=AdmAUJ6MVKy0nmr86Lc7KnUgqOKsGvV_SAC7pOXaAj8Eb_PLPR8ifiZ7xJ8OEJg82Lw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuIH9qJQjTznDqGsuXACKMMVGHJCZvAU00IdSTSQ87P8A&oe=69A57B20"}, {"file_name": "On_Hit_With_Bat_And_Fielding_In_Progress.png", "id": "541739497565882", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974808_541739500899215_6587236729130995403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGd3gQMRn1UQ7kNvwH7M_rl&_nc_oc=AdmywcJbIxnQBJxmbtlrLA3qEC8pJ4pfi1aBGbBlFiNSDnHHzLsi5rJsQgozs7ppLnM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvPC3eWM4iCdAKiVFM8MvQEMO_kUy5dBTZHZCL54VbHqQ&oe=69A56A21"}, {"file_name": "On_Hitting_Four.png", "id": "3217682331845030", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974459_3217682335178363_237033845748482834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGjTaBQBBFkQ7kNvwGEqGGO&_nc_oc=Adl2K3rZKHy2wxCTKuK9F3Wtb3tE7xHNN1hudaaWVvxk5fvZujiVl-M05Y3bPKBIFjs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvRUVk4u7Q7B1HyLvtC7JAp0Ogg-PW4LqtxXTazPHYoTw&oe=69A58012"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Pic.png", "id": "287605153391285", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974522_287605156724618_5466474971579159763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnbiolZlvzEQ7kNvwH5DP8_&_nc_oc=AdmBhGLlkqMcsiTXdtGlgRswmeKy188b3eHF6ih62pevjc45JUJk-ZDm_zBfw790CMY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftLPEEd8BMuxp5ISCDUAxoXQ0dhDrEb778CgMYaJTIFtQ&oe=69A56D9B"}, "display_name": "iB Cricket", "keywords": ["Cricket", "VRCricket", "iBCricket", "BestCricket", "Sport"], "long_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. \n\nTill date, over 60 million balls have been played by people from 40+ countries, including both cricketing & non-cricketing nations. 98% of them said that iB Cricket is amazing! iB Cricket has also received appreciation from 100+ world-class Cricketers.\n- Numerous Bowling Options: Right arm, left arm; Fast, medium pace, off spin, leg spin & more.\n- Intelligent fielding based on built-in AI\n- Multiple Stadiums\n- PvP:  Bowl to your friends & challenge them in a one-on-one match. \n- Leagues & Tournaments\n- Multiple Cricket Formats: 20, 50, unlimited overs \n- Coaching Module \n\nHone your skills, compete in global tournaments & become a vSport star.", "short_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. Thousands of people from all over the world including non-cricketing nations have enjoyed playing iB Cricket. Hone your skills, compete in global tournaments & become a vSport star."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ib.cricket/privacy-policy/", "developer_terms_of_service_url": "https://ib.cricket/EULA/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": "https://bit.ly/iBCricket_Support", "website_url": "https://ib.cricket/", "category": "GAMES", "comfort_rating"
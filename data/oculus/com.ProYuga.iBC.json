1.oculuscdn.com/v/t64.5771-25/38982441_564625528759033_3472788579845730796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pelbpfqLeQ0Q7kNvwEn9N3A&_nc_oc=AdmyzhzM9oyypih6m1GLZ8ntkX6aI2TARzZNpw6M--r0bBPHtOlIHOUqvL4-oJsPh9Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuyRUsTuWC55y6_FeeI4sWJ-XcjfMM1mJ3ch_EBdClXLA&oe=699EF519"}, {"file_name": "HomeScreen.png", "id": "836652667643899", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974897_836652670977232_7652191435006771155_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6qu-gf463sQ7kNvwGBeeNu&_nc_oc=AdmRnZze_onHIrtz0D0rL0oXXJAdNreOKkEIyOrQSQjLBaVvM139w9w33PZtB0Kases&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvNbg8KABOoAiXOpmpn_7Ju7JRY89g5gdv5CyHqwT-gig&oe=699EE390"}, {"file_name": "PracticeNets.png", "id": "1050662512268641", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75240099_1050662515601974_6020790145128572887_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2XxkQFpHf0Q7kNvwESyxDf&_nc_oc=Adl-u1fG8N_EOesJSdBRD-XiVK5QeI-ZcaKwaUakxLWaqqexI-zyIyiEvfsAgAWnG50&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuQuELXuZ-xgOGT-gikogknk8FjOp-8ZyzeVmCvM8ymUA&oe=699ED791"}, {"file_name": "CampaignMode.png", "id": "621412579727793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75572758_621412583061126_6110164533952850496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANTXSE_1tYMQ7kNvwEbaiYJ&_nc_oc=AdmcTdqvla0-Bnlo1hO6P8qB4a2MOhNzw9jqE4N3DhcfxyCpzmD9dTiwKCAXKlEn6s8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv3Fu80oHt1pQBnJ2bH-22bFVH2VWtSOnDNEsSCCQMT1g&oe=699EEEDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "iBC_Oculus Assets_Cover Landscape - 2560x1440_v3.png", "id": "1198775474454980", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610708_1198775477788313_4016531523126774863_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgmx5CMyGh8Q7kNvwGeGGPe&_nc_oc=AdlZsx69jGibKcD_ewuc5s8OpyPqudvJaSOsq_88KOc07bKkt6vX-Lv9Krz8-7fxYkI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsZgHFMDeLs366mV4PyPNgjmEMjUFcIf1K4tP4Z-6_YbA&oe=699F0123"}, "display_name": "iB Cricket", "keywords": ["Cricket", "VRCricket", "iBCricket", "VRBatting", "MetaverseCricket"], "long_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. \n\nTill date, over 500+ million balls have been played by people from 40+ countries, including both cricketing & non-cricketing nations. 98% of them said that iB Cricket is amazing! iB Cricket has also received appreciation from 100+ world-class Cricketers.\n- Numerous Bowling Options: Right arm, left arm; Fast, medium pace, off spin, leg spin & more.\n- Intelligent fielding based on built-in AI\n- Multiple Stadiums\n- PvP:  Bowl to your friends & challenge them in a one-on-one match. \n- Leagues & Tournaments\n- Multiple Cricket Formats: 20, 50, unlimited overs \n- Coaching Module \n- VR Bowling\n- Campaign Mode\n- CO-OP\n- Practice Nets\n- Fun MR Mode Games.\n\nHone your skills, compete in global tournaments & become a vSport star.", "short_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. Thousands of people from all over the world including non-cricketing nations have enjoyed playing iB Cricket. Hone your skills, compete in global tournaments & become a vSport star."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ib.cricket/game-privacy-policy/", "developer_terms_of_service_url": "https://ib.cricket/EULA/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": "h
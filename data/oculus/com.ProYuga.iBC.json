3-2.oculuscdn.com/v/t64.5771-25/38982441_564625528759033_3472788579845730796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yorqezqv2FcQ7kNvwH-a0WI&_nc_oc=Adnmh7WpbpKLXd2lD09oDyqeVMViydrW_1i1ApKZLVY52gyOIaV9waH6DZ9vktpLmtc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfugE-wIV-OPZvJwiLpTdfKaaqx5wXAdgMNxUjmDoA9S0w&oe=69A04699"}, {"file_name": "HomeScreen.png", "id": "836652667643899", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974897_836652670977232_7652191435006771155_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6qu-gf463sQ7kNvwGNmDAi&_nc_oc=AdkVfALaRliM9NR-MrMOg9GzjgreHx3UW0DopZ2Ji_panKWmPSdgWxG-tLvqAdC_YY4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftjGu_mnWtF0Xd-4CkLR_aRku8x0b-0FJxR1nSPD8x-Qw&oe=69A03510"}, {"file_name": "PracticeNets.png", "id": "1050662512268641", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75240099_1050662515601974_6020790145128572887_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWDxU_bwH4gQ7kNvwEqVAey&_nc_oc=Adk71HPW6XagoGYyQpG3MnbMpvlTlvojdyfVg3QtlkZISq1-e-NskDCFJ2PDVfyKUkY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv46gZyqzg57rNwtfzCGZJKtp90qxq3Rwby7OYUmY8UPg&oe=69A02911"}, {"file_name": "CampaignMode.png", "id": "621412579727793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75572758_621412583061126_6110164533952850496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANTXSE_1tYMQ7kNvwEHZnvy&_nc_oc=AdkmW59coRjwY5dpSfGmO_QlagR3f44Q6zcnAIXWUem0qO9Mg_p16uSd38CIJBSAgvk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftE6zMV_5YBRPxP7sugRCj2nlhHxcztD1f6-WpHB_preQ&oe=69A0405F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "iBC_Oculus Assets_Cover Landscape - 2560x1440_v3.png", "id": "1198775474454980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610708_1198775477788313_4016531523126774863_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgmx5CMyGh8Q7kNvwGErzmL&_nc_oc=Adn7TdMVmHwBSr_UATLULLYTx4SvbNtljYIN78LCAei2lBv0sKz6Z3om1BPfDz8hkZU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsUA-pSBt3f-AmWJ0Ih8WCT0tpO-aJdR-suedJESpPQ5A&oe=69A052A3"}, "display_name": "iB Cricket", "keywords": ["Cricket", "VRCricket", "iBCricket", "VRBatting", "MetaverseCricket"], "long_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. \n\nTill date, over 500+ million balls have been played by people from 40+ countries, including both cricketing & non-cricketing nations. 98% of them said that iB Cricket is amazing! iB Cricket has also received appreciation from 100+ world-class Cricketers.\n- Numerous Bowling Options: Right arm, left arm; Fast, medium pace, off spin, leg spin & more.\n- Intelligent fielding based on built-in AI\n- Multiple Stadiums\n- PvP:  Bowl to your friends & challenge them in a one-on-one match. \n- Leagues & Tournaments\n- Multiple Cricket Formats: 20, 50, unlimited overs \n- Coaching Module \n- VR Bowling\n- Campaign Mode\n- CO-OP\n- Practice Nets\n- Fun MR Mode Games.\n\nHone your skills, compete in global tournaments & become a vSport star.", "short_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. Thousands of people from all over the world including non-cricketing nations have enjoyed playing iB Cricket. Hone your skills, compete in global tournaments & become a vSport star."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ib.cricket/game-privacy-policy/", "developer_terms_of_service_url": "https://ib.cricket/EULA/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": 
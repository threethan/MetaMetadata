5-3.oculuscdn.com/v/t64.5771-25/38982441_564625528759033_3472788579845730796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Wd7bn_SEd8Q7kNvwE4tGmh&_nc_oc=AdmVZJY1p-aVHUbhrK63Pki9q4xPVyh3BFrNXr4kvAdZB7zEodaiNUcxjWaZIjfWVwA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsxOhbtGOJhgzW9DNvU5J812gJJ4mFLHyRXNJreoFCD6A&oe=699B0099"}, {"file_name": "HomeScreen.png", "id": "836652667643899", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974897_836652670977232_7652191435006771155_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFSimyJFgpQQ7kNvwEULpOn&_nc_oc=AdlPQvPei7x8j3fYBswSruTfUnDNC9r4W5YKAU2bS39kbGomm-31H1F8avS_obCxyzg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv98BpleeS26JDiNhu8-zQemL4rQFp_NC1g_JanUU4LxA&oe=699AEF10"}, {"file_name": "PracticeNets.png", "id": "1050662512268641", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75240099_1050662515601974_6020790145128572887_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HFMPG6rkhIQ7kNvwFnvQ_i&_nc_oc=Adkybv7TbxOm0AECEQi90Ku6O3a8q_O83ybvybVgbQQF0svbM-YYl73y_kOgI7kzfn0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftI_zD5KyXloqWAjoUP0c6ptN1rkk0A4tMnnznMQ0QJHg&oe=699AE311"}, {"file_name": "CampaignMode.png", "id": "621412579727793", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75572758_621412583061126_6110164533952850496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haMXF6myUwcQ7kNvwH6Raug&_nc_oc=AdnmmFSD0QkPQWq5KbKXQ-ZrD8dGc46Ommptm3H187G8DHaFPin1Ig_nz-aIXDb23hY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftxNEvUS9U5d2HVIL2HPvQLzaqr7Yt7Lt0iuvrY6STqYQ&oe=699AFA5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "iBC_Oculus Assets_Cover Landscape - 2560x1440_v3.png", "id": "1198775474454980", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610708_1198775477788313_4016531523126774863_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40M8gxBWatsQ7kNvwH1gdcd&_nc_oc=AdkRVMgqJKjyZ2XyKgT1fO7s6PUyk7bBaxg_6yo65YKq6OmzsimyZ_E37DPD-9qjzeQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft2jnkjJc1B9srQcFF0xsO_7ET_gVd3dZGdbVTDb9Dw-A&oe=699B0CA3"}, "display_name": "iB Cricket", "keywords": ["Cricket", "VRCricket", "iBCricket", "VRBatting", "MetaverseCricket"], "long_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. \n\nTill date, over 500+ million balls have been played by people from 40+ countries, including both cricketing & non-cricketing nations. 98% of them said that iB Cricket is amazing! iB Cricket has also received appreciation from 100+ world-class Cricketers.\n- Numerous Bowling Options: Right arm, left arm; Fast, medium pace, off spin, leg spin & more.\n- Intelligent fielding based on built-in AI\n- Multiple Stadiums\n- PvP:  Bowl to your friends & challenge them in a one-on-one match. \n- Leagues & Tournaments\n- Multiple Cricket Formats: 20, 50, unlimited overs \n- Coaching Module \n- VR Bowling\n- Campaign Mode\n- CO-OP\n- Practice Nets\n- Fun MR Mode Games.\n\nHone your skills, compete in global tournaments & become a vSport star.", "short_description": "A sport with 2.5 billion fans across the world is now in VR as iB Cricket (vSport). Step into immersive world-class stadiums with thousands cheering for you and hit the ball out of the park. Our realistic physics makes it intuitive to learn the sport within 10 mins. Thousands of people from all over the world including non-cricketing nations have enjoyed playing iB Cricket. Hone your skills, compete in global tournaments & become a vSport star."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ib.cricket/game-privacy-policy/", "developer_terms_of_service_url": "https://ib.cricket/EULA/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": 
474DD"}, {"file_name": "2.png", "id": "1057494206629839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_1057494219963171_953316972965822014_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNS6Ocbvd_UQ7kNvwEucbX8&_nc_oc=AdrAEij495ybNs9xHR9CwCsOeCbcO_j9QDl0IAGTFlO5AjdJ4P2t90Rfrkq5Q5UbTTc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBwNijdMmdn-gwGCSIrKOfa-9Qn5BFHPXWqsbZPLdkAw&oe=6AF483B1"}, {"file_name": "1.png", "id": "1619887159526999", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_1619887162860332_2027094024128951513_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mivQu94j4wcQ7kNvwEifTd4&_nc_oc=Adqx-XZBZ9OFxTxbb6mf8Y9swPmQ9GsTAle0AvVYdme7MH7WTYOzOXw41ZZGxIlw1dI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiUjmGmotZRpa4jvRWZEFKWdkU7LxQQhIchxB9qlPOMA&oe=6AF48C8F"}, {"file_name": "3.png", "id": "1067899262318652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_1067899268985318_4361342870241448930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDVwMSuwF2kQ7kNvwE2-Lbg&_nc_oc=AdoSkjMSq3jormdNaC6tgtkjCzsOHJbXmw59nucHQZP557C5bE1a8jpO0AyIe747GNc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMczdAUsfExxlgLif_2Gm_XNnLeHUOEgT-zgRjvj4pSA&oe=6AF494E0"}, {"file_name": "5.png", "id": "1028734833490295", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823905_1028734836823628_4228889131096765258_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYHYaJsb3y8Q7kNvwEb1MMA&_nc_oc=Adog-FMkwwdEOq_vCaI5XnfdXsz7JwuZtl24Nr14m0jYDMeQ05cV9tFOt4RaC1uFy7Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQognntLovPiKLXOpg5sVMugVZ8ZH4I-9Y5_vYjb1zhNQ&oe=6AF49F64"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ApexX Racing ChampionShip By Winter Art", "keywords": ["car", "racing", "driving", "simulator"], "long_description": "# ApexX Racing Championship\n\n**ApexX Racing Championship by Winter Art** brings high-speed racing action to VR. Get behind the wheel, master challenging tracks, and push your driving skills to the limit as you compete for championship glory.\n\n\ud83c\udfce\ufe0f **5 Exciting Racing Tracks**\nRace across 5 unique tracks, each designed to challenge your speed, control, and racing skills. Learn every corner, find the perfect racing line, and fight for the best times.\n\n\ud83c\udfc1 **High-Speed VR Racing**\nFeel the excitement of being behind the wheel with an immersive VR racing experience. Accelerate, brake, steer, and take on every corner as you chase victory.\n\n\ud83d\ude97 **Live Showroom**\nExplore the new **Live Showroom**, where you can get up close with the cars and experience them in an immersive VR environment.\n\n\ud83d\udd25 **Compete for Championship Glory**\nEvery race is a chance to improve your skills, master the tracks, and become the ultimate ApexX Racing Champion.\n\n### Coming With the Launch\n\n\u2022 5 challenging racing tracks\n\u2022 Live Showroom experience\n\u2022 Immersive VR driving\n\u2022 High-speed racing action\n\u2022 Multiple cars and racing experiences\n\u2022 Competitive championship gameplay\n\u2022 Designed for Meta Quest VR\n\n**Pre-order ApexX Racing Championship today and get ready to hit the track!**\n\n**ApexX Racing Championship \u2014 Race Fast. Master the Track. Become Champion.**\n\n*Features and content may be updated or expanded after launch.*\n", "short_description": "Get ready for high-speed VR racing in **ApexX Racing Championship by Winter Art**! Experience intense races, explore 5 challenging tracks, and check out the new Live Showroom. Pre-order now and get ready to race!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/winterart/home/privacy", "developer_terms_of_service_url": null, "publisher_name": "Winter Art", "support_website_url": null, "website_url": "https://sites.google.com/view/winterart/home", "category": null, "comfort_rating"
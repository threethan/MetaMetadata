3235D"}, {"file_name": "2.png", "id": "1057494206629839", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823746_1057494219963171_953316972965822014_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNS6Ocbvd_UQ7kNvwEmXjed&_nc_oc=AdoA6zl0Xwj_j9f1CI1Tnv1QxIJeZx1DNgwm-AjUS9Piaqhsezwhvz4v08tDFK5Kwn0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRv7MmFnKXsUTc4zlLxcAFa573YtojT766IB62e8MnMSQ&oe=6AF33231"}, {"file_name": "1.png", "id": "1619887159526999", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823351_1619887162860332_2027094024128951513_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZJSci6GuQ4Q7kNvwEEpUqJ&_nc_oc=AdqmTYoEQ69ZMdZkfdFUgkV0i0jESELKlkLjDAublt5ZSg1foWYRCw2_E7MGDLplxtk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdCmTaoMOvDcQT5XCJQW3xHGKPz7MSzb9tFaO11iJB1Q&oe=6AF33B0F"}, {"file_name": "3.png", "id": "1067899262318652", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823812_1067899268985318_4361342870241448930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDVwMSuwF2kQ7kNvwH43jek&_nc_oc=Adp3KRrt-Vq-rmmoyqY6cERFsrRJ2PFXMT1PFAPi_629ERS3M-x18Y1byJrDIBh_oZA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCy3aY6H3KNZSR1DDfGcaN3nadMgcCdR7yuWqGjGjQwA&oe=6AF34360"}, {"file_name": "5.png", "id": "1028734833490295", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823905_1028734836823628_4228889131096765258_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eiqaxMI_ReYQ7kNvwH8C6HL&_nc_oc=AdqSj2EI_iLdRTsvZPYM2XyKqaRZdloTwHXHMFrhehusHZJdzMDr1nVY_exbCQgUI4Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS81Po6Odb9PiwFnKVsSOunj5ZpIZsJFrsgeArUQfSocg&oe=6AF34DE4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ApexX Racing ChampionShip By Winter Art", "keywords": ["car", "racing", "driving", "simulator"], "long_description": "# ApexX Racing Championship\n\n**ApexX Racing Championship by Winter Art** brings high-speed racing action to VR. Get behind the wheel, master challenging tracks, and push your driving skills to the limit as you compete for championship glory.\n\n\ud83c\udfce\ufe0f **5 Exciting Racing Tracks**\nRace across 5 unique tracks, each designed to challenge your speed, control, and racing skills. Learn every corner, find the perfect racing line, and fight for the best times.\n\n\ud83c\udfc1 **High-Speed VR Racing**\nFeel the excitement of being behind the wheel with an immersive VR racing experience. Accelerate, brake, steer, and take on every corner as you chase victory.\n\n\ud83d\ude97 **Live Showroom**\nExplore the new **Live Showroom**, where you can get up close with the cars and experience them in an immersive VR environment.\n\n\ud83d\udd25 **Compete for Championship Glory**\nEvery race is a chance to improve your skills, master the tracks, and become the ultimate ApexX Racing Champion.\n\n### Coming With the Launch\n\n\u2022 5 challenging racing tracks\n\u2022 Live Showroom experience\n\u2022 Immersive VR driving\n\u2022 High-speed racing action\n\u2022 Multiple cars and racing experiences\n\u2022 Competitive championship gameplay\n\u2022 Designed for Meta Quest VR\n\n**Pre-order ApexX Racing Championship today and get ready to hit the track!**\n\n**ApexX Racing Championship \u2014 Race Fast. Master the Track. Become Champion.**\n\n*Features and content may be updated or expanded after launch.*\n", "short_description": "Get ready for high-speed VR racing in **ApexX Racing Championship by Winter Art**! Experience intense races, explore 5 challenging tracks, and check out the new Live Showroom. Pre-order now and get ready to race!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/winterart/home/privacy", "developer_terms_of_service_url": null, "publisher_name": "Winter Art", "support_website_url": null, "website_url": "https://sites.google.com/view/winterart/home", "category": null, "comfort_rating"
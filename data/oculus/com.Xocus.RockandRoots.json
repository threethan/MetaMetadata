4.5771-25/39031487_2116282382063449_8395369994981984256_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9_MfGE09tMQ7kNvwHTfUxi&_nc_oc=AdqN0SQn-fkYvzjBN9xIXl5McD2GPkmqgdqWMclEfiLmuYkBYaFZ495ewFRRvzcXUaQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XNGSAQjr9YDfspBEl8w7AqsoRGCWcJhEqmSRPbzDPMw&oe=69FF3EEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Video.png", "id": "407103308512439", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974727_407103311845772_2944327996619935054_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZySqMCrH3ioQ7kNvwEZBK9l&_nc_oc=AdrrBpBcLif8F3sBRph7RVxA_-CASH5a87HJUgbTEARdTeIVvV5owKYWDtFzR16zVY8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UQ8x5m4fIeNhoNAPDjbl2Ug-QM2i3O5mdgi6pKuJpvg&oe=69FF3471"}, "display_name": "Rock and Roots", "keywords": [], "long_description": "On a warm summer night, when the stars twinkle like fireflies and the rustling leaves whisper secrets in the deep woods, a captivating fairy tale weaves itself like magic around the flickering flames of a campfire. \nGuided by instinct and your own strategic acumen, you wield the power to dictate the ebb and flow of battle. Each encounter becomes a tactical dance, an intricate interplay of forces where you strategically choose and deploy your allies \u2013 the Springs \u2013 to conquer trials and adversaries that bar your path. The secret lies in the cards that adorn your left hand, each bearing the essence of a specific Spring. As you deftly select and unveil these cards, you set in motion a symphony of magic and nature, your chosen allies springing to life to face the challenges that await.", "short_description": "Rock and Roots is a captivating story-driven VR journey where you wield the power to dictate the ebb and flow of battle. Summon your enigmatic guardians of the woods with a magical hand to face the challenges. Conjure spells, dive into the magic world and reclaim your rightful place on the throne!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9601514043195293"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031566_864245355385717_4552908289292537895_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wT9xisMVT4oQ7kNvwF4f06d&_nc_oc=AdrN5E1SydXCKg25cVy-u14dDRkwb9zme9wmr6gPgqChmijSPxfEhP2XvRiDa_WQyRo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AWZ9YxBdx81W_UcDQSKXahlJl8SAdG92zC1pfQIza4Q&oe=69FF2528"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rock and Roots", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Role Playing", "id": "821934236779161"}], "release_date": 1710417600, "lastRevision": {"nodes": [{"id": "7754651627881553", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7754651591214890", "is_first_party": fal
5&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQRUjEpxftkQ7kNvwFT1tem&_nc_oc=AdpCGNkmYtGTwYaJM7BH1BKufrZHdhMI1FwVcyPNOhv8yhdgCANVZxgoLF2yovmPPUs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFV8Zr-VsHCKnG6_JpZTm8p--Jfgl-B9rs2eidnmw2OQ&oe=6AFDBB33"}, {"file_name": "444.png", "id": "1449460036505593", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821674_1449460039838926_7160788812436908629_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2OHSX7Dj6sQ7kNvwHmUVUC&_nc_oc=Adr6ckVp_crAxsoUukNbf_2LykdZ9LVfZxFbHXHWmWksrN_eVTpHQ6H9urDSJAGGJQI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpQzA-CHxQP6y8a_hl-ypFgA9Aam-rxZDwKP4kPWNf5Q&oe=6AFDE20E"}, {"file_name": "555.png", "id": "989659930692392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823940_989659934025725_693759326408063211_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8BI2Go1QjsQ7kNvwHvjnxD&_nc_oc=Adr3HiMhrWUW7i2nROEwO3sBe3nfkh2qEaTE0Rg0u2VT495XHYgZ8Xz9X9WDqpiS0CQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjrkT4T9Jx3E8F3fKuc9JX4we4h9zos3stCH3Ng8VezQ&oe=6AFDCD48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "1272617951558008", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823901_1272617954891341_1049535197867943487_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pPYVdii4t4Q7kNvwHOQSNp&_nc_oc=AdpqPv58J-DNpH8Pi5-KfccmMstNNwim5XUJtZ7P6qikpfVFZZORx6uZRtwe1WwUUoI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzBvBPv3gCnYtvXTDsTopgaCUXctsjdlqjWPcz4SKhxQ&oe=6AFDC865"}, "display_name": "Dungeon Warrior VR: Sword & Bow Figthing", "keywords": ["blade", "demon", "warrior", "Eternity", "Illusions"], "long_description": "# Unleash Your Inner Warrior: Battle Through Reality-Warping Combat in the Dungeon Warrior\n\n**Sword & Shield Combat: Survival in the Dungeon Warrior**\n\nEngage in intense VR combat as you defend yourself against relentless enemies in the dungeon\u2019s tight corridors. Block incoming attacks and strike back with deadly force against undead warriors and skeletal foes. In this twisted labyrinth, your blade is the only defense against the darkness that surrounds you.\n{1341725561157337}\n\n**Unveiling the Beast: Reality Distorted in the Dungeon Warrior**\n\nWatch as a stone statue morphs into a massive, winged creature, only for the environment to shift in an instant. This defines Dungeon Warrior, where every moment is a mind-bending challenge.\n{2203589766843362}\n\n**Unlocking Dark Secrets: The Storeroom of the Dungeon Warrior**\n\nUncover dark secrets in the Dungeon Warrior as you find a mysterious key and unlock a heavy wooden door. Step into a room filled with glowing magic and eerie surprises, where danger lurks beyond every corner.\n{1480815883529218}", "short_description": "Enter the Dungeon Warrior, an action VR game where you play as a trapped warrior fighting to escape a labyrinth controlled by a villain who distorts reality. Battle through hordes of undead enemies, from weak swarm minions to powerful brutes. Each step is unpredictable, as perception warps and shifts around you. Survive the twisted dungeon, defeat terrifying foes, and break free from the mind-bending trap!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null
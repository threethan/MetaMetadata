9619159_1243377581337078_4353280120282089917_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pm35JD8JIdsQ7kNvwFKn9cq&_nc_oc=AdpIp7mdIk_MLjGL29sltbw78ZzY_TOGtwnkrtdwKwGmlN8izegQaRLCdfBPI44ujdA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvn4BMsKSpoeKheEwDyVlocp5eUX7H88bAqODLdEN1wQ&oe=6A9ACFC9"}, {"file_name": "555.png", "id": "2129338271190213", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618277_2129338274523546_489815994589119840_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrDX3msdqqEQ7kNvwHk0qK7&_nc_oc=Adrx6jzm3AOKUds5M0vJN57tDlbvaEU0SPvJZt36jZVBo47CCoH5Vc9D8ABYqEqzpzc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzSSOQmSPJheC9HLK7zJjONpZDYt_RskLJhgMyC5VwIA&oe=6A9ACFC7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dungeon of Illusions", "keywords": [], "long_description": "# Unleash Your Inner Warrior: Battle Through Reality-Warping Combat in the Dungeon of Illusions\n\n**Sword & Shield Combat: Survival in the Dungeon of Illusions**\n\nEngage in intense VR combat as you defend yourself against relentless enemies in the dungeon\u2019s tight corridors. This clip highlights the skillful sword-and-shield action required to survive. Block incoming attacks and strike back with deadly counterattacks against masked warriors and skeletal foes. In this twisted labyrinth, your blade is the only defense against the darkness that surrounds you.\n{1341725561157337}\n\n**Unveiling the Beast: Reality Distorted in the Dungeon of Illusions**\n\nWatch as a stone statue morphs into a massive, winged creature, only for the environment to shift in an instant. This GIF captures the eerie transformation that defines Dungeon of Illusions, where every moment is a mind-bending challenge.\n{2203589766843362}\n\n**Unlocking Dark Secrets: The Storeroom of the Dungeon of Illusions**\n\nUncover dark secrets in the Dungeon of Illusions as you find a mysterious key and unlock a heavy wooden door. Step into a room filled with glowing magic and eerie surprises, where danger lurks beyond every corner.\n{1480815883529218}", "short_description": "Enter the Dungeon of Illusions, a VR action game where you play as a trapped warrior fighting to escape a labyrinth controlled by a villain who distorts reality. Battle through hordes of illusion-based enemies, from weak swarm minions to powerful brutes. Each step is unpredictable, as perception warps and shifts around you. Survive the twisted dungeon, defeat terrifying foes, and break free from the mind-bending trap!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_AU", "en_US", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26636048832704003"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1259569829643461"}]}, "baseline_offer": {"id": "1259569829643461"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778070660, "status": "PUBLISHED", "id": "1259569829643461"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, 
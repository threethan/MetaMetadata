ad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZzijnFaSVMQgjwbu92sV2n-bJiz_z-95ml_2Y7Jve9A&oe=6B06F2E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape cover 2560x1440 2.png", "id": "5282213171906625", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75230047_5282213178573291_7390480977509893284_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvop1IoVWu8Q7kNvwGTSj39&_nc_oc=AdoW_9_WWKIbc_pSHezX45LJjTq1VvO570E7QFWV4Zz_5HhDs9R8J09i00SiCAoDyi8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-fDpsKhIZ2OFijOztv9wpdm5kkPRBO1ndBTh5Uv7QFQ&oe=6B071465"}, "display_name": "Bridge Engineer", "keywords": [], "long_description": "Tackle Bridge Engineering problems like never before!\n\nYou are an Engineer tasked with building Bridges for different types of vehicles from an SUV to a large Truck!\n\nYou are faced with several different scenarios and environments that you would need to solve with 1 common goal among them all... to get the car across the other side!\n\nDRIVABLE VEHICLES\n13 Different drivable vehicles!\nDrive the vehicles yourself behind the wheel in the driver seat or in 3rd Person View!\n\nLEVELS\nTackle 21 levels with 3 level difficulties and 4 special levels.\n\nITEMS\nTake advantage of 30+ items in your tool to make your idea into a Virtual Reality solution and build your ideal Bridge!\n\nAre you ready to earn your \"BRIDGINEER\" Title?", "short_description": "Tackle Bridge Engineering problems like never before!\n\nYou are an Engineer tasked with building Bridges for different types of vehicles from an SUV to a large Truck!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.projectartiliris.com/bridge-engineer/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Project Artiliris", "support_website_url": null, "website_url": "http://www.projectartiliris.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "con
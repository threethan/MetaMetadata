ea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIwdA3iHhu5spM2urmM52Rebu8Eq_Mum3MaxEuGCpUPQ&oe=6AFC66E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape cover 2560x1440 2.png", "id": "5282213171906625", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75230047_5282213178573291_7390480977509893284_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvSsPIkb2j4Q7kNvwFz_ueA&_nc_oc=AdoN4xmaLEdZPGB3UQm03VFgu4Sun5Nhl0-A1hokXGxOoaWnV-a4zIwA-sgl1V9PqW4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThHjZzpBuIMdgLD8pwJ0Ow1tsft8sKeinC0oCvD5RA9g&oe=6AFC8865"}, "display_name": "Bridge Engineer", "keywords": [], "long_description": "Tackle Bridge Engineering problems like never before!\n\nYou are an Engineer tasked with building Bridges for different types of vehicles from an SUV to a large Truck!\n\nYou are faced with several different scenarios and environments that you would need to solve with 1 common goal among them all... to get the car across the other side!\n\nDRIVABLE VEHICLES\n13 Different drivable vehicles!\nDrive the vehicles yourself behind the wheel in the driver seat or in 3rd Person View!\n\nLEVELS\nTackle 21 levels with 3 level difficulties and 4 special levels.\n\nITEMS\nTake advantage of 30+ items in your tool to make your idea into a Virtual Reality solution and build your ideal Bridge!\n\nAre you ready to earn your \"BRIDGINEER\" Title?", "short_description": "Tackle Bridge Engineering problems like never before!\n\nYou are an Engineer tasked with building Bridges for different types of vehicles from an SUV to a large Truck!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.projectartiliris.com/bridge-engineer/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Project Artiliris", "support_website_url": null, "website_url": "http://www.projectartiliris.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "con
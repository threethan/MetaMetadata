=1-7&_nc_sid=6e7a0a&_nc_ohc=ermq6OgoZlcQ7kNvwHFGsTC&_nc_oc=Adn0xGlLrjjTxN2_0a0W0g2aJ34aq13B0R0klgHVdm3jhOCrTXUNzhL0y8CWE-h6aBU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5hTv5ESi_MXHi9e-Qr3s4R1qwFFy1gzzjs00BUnqxgQ&oe=69AAD025"}, "display_name": "Bridge Engineer", "keywords": [], "long_description": "Tackle Bridge Engineering problems like never before!\n\nYou are an Engineer tasked with building Bridges for different types of vehicles from an SUV to a large Truck!\n\nYou are faced with several different scenarios and environments that you would need to solve with 1 common goal among them all... to get the car across the other side!\n\nDRIVABLE VEHICLES\n13 Different drivable vehicles!\nDrive the vehicles yourself behind the wheel in the driver seat or in 3rd Person View!\n\nLEVELS\nTackle 21 levels with 3 level difficulties and 4 special levels.\n\nITEMS\nTake advantage of 30+ items in your tool to make your idea into a Virtual Reality solution and build your ideal Bridge!\n\nAre you ready to earn your \"BRIDGINEER\" Title?", "short_description": "Tackle Bridge Engineering problems like never before!\n\nYou are an Engineer tasked with building Bridges for different types of vehicles from an SUV to a large Truck!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.projectartiliris.com/bridge-engineer/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Project Artiliris", "support_website_url": null, "website_url": "http://www.projectartiliris.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null
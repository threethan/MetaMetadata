96", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821719_1281333440680829_3834042529400575196_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2PawJGj7TkQ7kNvwH5meLc&_nc_oc=Adol02F8F3D3zogGC1D9y3wIsR0qweBLv3FPwlO3WK_8YN9DQ1U87LISGIQFIuFsgK4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDwSvFRdU3b8ez3haS_MRXQsfyF941ITdLOPLnL3MBog&oe=6A7338D3"}, {"file_name": "3.png", "id": "889867943602841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825470_889867946936174_4198226107227066338_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmmAA8e9f8gQ7kNvwHTXiUy&_nc_oc=AdpOuKeFipR5l1g04whZ8lp_KWxgVTcVTdUbF4x-NKDL1wqj2qb8iBoccaOsTwtQVSA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMPrjP1GX5RbwwyO_me2sLCIna3ctLVvbyNtVbHRGwtg&oe=6A732202"}, {"file_name": "4.png", "id": "1382646699881961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820887_1382646703215294_1236403228488482603_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTC1S_oPxM8Q7kNvwGknlyu&_nc_oc=AdptOK8bnUgHg_GDcRSil-rIuQXBP0R3gPUPL2t2X6XjQkDqEk6SWkqPlr1J8QVauz8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVUrzclD6yoAN4MKNYhvwIW6PAV3ETIKBwe8qGbYUi0Q&oe=6A732C05"}, {"file_name": "5.png", "id": "1150714390565037", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822307_1150714397231703_6965840896846762554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVjuSYIfKaEQ7kNvwG_Pqik&_nc_oc=Adpr8tvUC5xv7wvoNQS58DTlx_mkr8Y36qzzkJtDrlOW6Ve0ROqsZkbucsOoY0IMEgM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHw4tQ6ICFAvMpv_KdnAqod6-fT-Ys9bLpBO8D34KLVQg&oe=6A73202F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launch_screen.png", "id": "837865448956026", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818860_837865452289359_7464072310727294045_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uG0dmqf35MQ7kNvwG8Csqj&_nc_oc=AdoGjwU_I1XgEfhyg_voXzcUEbtO2k8pCo2Sxof8CNuMRh3_uP8OppvKTxzgx4p0vtg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEPaOVpVUzfVjNvzxnXwZcwQG563Luhtde7xJQJ1NDWQ&oe=6A73231A"}, "display_name": "Bullet Fury -  Sci-Fi Shooting game", "keywords": ["shooting", "puzzle", "cubes", "gun", "shot"], "long_description": "**Prepare for an adrenaline-fueled challenge where success depends on rapid adaptation**\n\nArm yourself with Pistols, Swords, or Punches and step into the arena to face rushing waves of numbered and lettered cubes.\n\nThe objective changes every round \u2014 only hitting the specified targets will keep you alive.\n\nYou get three lives: waste one on a bad hit or take one from an enemy cube, and your high-score run ends instantly.\n\nProve your mastery by completing intense challenges and claiming the top score!", "short_description": "Will you rely on the ranged power of your Pistols, the sweeping speed of a Sword, or the primal satisfaction of your Punches?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24373974065611646"}, "review_messages": []}]}, "cover_
96", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821719_1281333440680829_3834042529400575196_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmWLCEtesB8Q7kNvwEgwpXp&_nc_oc=Adoi95RVS8ds5JwdHu59mk8Z2kVEFGUJjsuUmpjrf_osreJU8AAJO3G0DfVh0kdPcbA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkRdP-_qiNdAOdgCYAp7mIJol7cKliRnruuY3L_edS9w&oe=6A5F7253"}, {"file_name": "3.png", "id": "889867943602841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825470_889867946936174_4198226107227066338_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwtUDK1yHp8Q7kNvwHoOFna&_nc_oc=Adr_navbnloPVyrY9lFdaB4GXZViTibNvyNzaFAzfWqGBn-towPQq2mMtA5nhFhFLSM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7jSGEqA_sWhlDQ1EyvH_QCOC_IW5kcH6RbsGhMoRNXg&oe=6A5F5B82"}, {"file_name": "4.png", "id": "1382646699881961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820887_1382646703215294_1236403228488482603_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMiuX9e_GlcQ7kNvwFO2Y-f&_nc_oc=AdqXo7dvg6uHOrKa50oTL_8cgu6cXCUM6tOrBWkIHDfO9qY3dmHVVGMExCFdcUxK3vE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAF9xu2o1TRdcuTOr5Q3zubQr2UMwtM0RmZD2Q5JG_3qg&oe=6A5F6585"}, {"file_name": "5.png", "id": "1150714390565037", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822307_1150714397231703_6965840896846762554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49ASv-1nlI8Q7kNvwHvBr-h&_nc_oc=AdoefZi0_9uX01mf_Xg9N04k6xlG61asbOPk8p4ySkwRdOr8MByK72Dtsha_sb1rVSk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-8ZRJ_CNs00WsM_EJLEO_0jHHOKyNKrfoPMmVwrKrPA&oe=6A5F59AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launch_screen.png", "id": "837865448956026", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818860_837865452289359_7464072310727294045_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Gblbu7ZDvsQ7kNvwEPeTQf&_nc_oc=AdqtKVQwOs2GcHzfAc2xAIlV8ye4BK61a2e7prnHri8oaeViY3Z5ZLrJvm-JJlbnJRM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCILsNeHPc1p_d9J8jzKsOU-tqMEgFsO_9ulcpoXMB-eA&oe=6A5F5C9A"}, "display_name": "Bullet Fury -  Sci-Fi Shooting game", "keywords": ["shooting", "puzzle", "cubes", "gun", "shot"], "long_description": "**Prepare for an adrenaline-fueled challenge where success depends on rapid adaptation**\n\nArm yourself with Pistols, Swords, or Punches and step into the arena to face rushing waves of numbered and lettered cubes.\n\nThe objective changes every round \u2014 only hitting the specified targets will keep you alive.\n\nYou get three lives: waste one on a bad hit or take one from an enemy cube, and your high-score run ends instantly.\n\nProve your mastery by completing intense challenges and claiming the top score!", "short_description": "Will you rely on the ranged power of your Pistols, the sweeping speed of a Sword, or the primal satisfaction of your Punches?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24373974065611646"}, "review_messages": []}]}, "cover_
96", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821719_1281333440680829_3834042529400575196_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kspclDIOEOUQ7kNvwHg8eH9&_nc_oc=Adqk-nTivlTB5kg9lbfeZZibMCJyrctps5c04-QRfS5GuuL67MkV4AWWSV86vlPFjPw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63TAEXzk4VbeCABuBGY7y5DozI8lksqfo2gGfA6v4Vxg&oe=6A144CD3"}, {"file_name": "3.png", "id": "889867943602841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825470_889867946936174_4198226107227066338_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuMt5E4khckQ7kNvwFHWdBm&_nc_oc=AdrYSqvdOoh37z9LVkQQRpirt74OE8EwFCxLob0fs95QuBypYYBo2KS7snnoCV0W7ck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SjROhWVsuWplU2kcbTu-FT6xKuj0FXWQBH_E-wytA6w&oe=6A146E42"}, {"file_name": "4.png", "id": "1382646699881961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820887_1382646703215294_1236403228488482603_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q84y4RjAnjIQ7kNvwGdDKSB&_nc_oc=Adr3lnlp2c8LK4RYoptUi9AvmkNpv6an_5R4H_UhtCvctMW3nOlAIpfX3qwQygb0cIo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UHgohjUaIX7YPz2zsz-auNJtkHUe9cd_rxIoDFH8bXQ&oe=6A144005"}, {"file_name": "5.png", "id": "1150714390565037", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822307_1150714397231703_6965840896846762554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3nE6SqXR5EQ7kNvwH2UdPb&_nc_oc=AdqmDra6V1y7BFbXoJEALeWOBW8Vk9LGv5raN7K4r_qJEhWkY91i-YEIBhfCMSmesBc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tuZVwKVKHs7rzN-CiPTUt3S7FoO4jbHqHdK1QNdPmDA&oe=6A146C6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launch_screen.png", "id": "837865448956026", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818860_837865452289359_7464072310727294045_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85A3TLh0pzoQ7kNvwFonr8D&_nc_oc=AdrkpFJFOgyxaN9jjJTbE_lahQliABdYK9Ap4DI79GX3re93aNRGyb68QdBf6DG-gxc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6S_MSfvfW4_mHCgTSsZnK7XtZTpsPtC1Wra6wXROBEQQ&oe=6A146F5A"}, "display_name": "Bullet Fury -  Sci-Fi Shooting game", "keywords": ["shooting", "puzzle", "cubes", "gun", "shot"], "long_description": "**Prepare for an adrenaline-fueled challenge where success depends on rapid adaptation**\n\nArm yourself with Pistols, Swords, or Punches and step into the arena to face rushing waves of numbered and lettered cubes.\n\nThe objective changes every round \u2014 only hitting the specified targets will keep you alive.\n\nYou get three lives: waste one on a bad hit or take one from an enemy cube, and your high-score run ends instantly.\n\nProve your mastery by completing intense challenges and claiming the top score!", "short_description": "Will you rely on the ranged power of your Pistols, the sweeping speed of a Sword, or the primal satisfaction of your Punches?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24373974065611646"}, "review_messages": []}]}, "cover_
": "launch_screen.png", "id": "837865448956026", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818860_837865452289359_7464072310727294045_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AU9-r-yteyYQ7kNvwEAZTzx&_nc_oc=AdpubzFZgmJy_5mEMXHWN-1jTARajmSQzX5mp24G75_hQ1EwYp8hpMBH8RGrB0-f_0U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-7GzjWwCFD30OuQlPjfmGVMtMYMjKazAj4RvwIe4IJw&oe=6AFDC8DA"}, "display_name": "Bullet Fury -  Sci-Fi Shooting game", "keywords": ["shooting", "puzzle", "cubes", "gun", "shot"], "long_description": "**Prepare for an adrenaline-fueled challenge where success depends on rapid adaptation**\n\nArm yourself with Pistols, Swords, or Punches and step into the arena to face rushing waves of numbered and lettered cubes.\n\nThe objective changes every round \u2014 only hitting the specified targets will keep you alive.\n\nYou get three lives: waste one on a bad hit or take one from an enemy cube, and your high-score run ends instantly.\n\nProve your mastery by completing intense challenges and claiming the top score!", "short_description": "Will you rely on the ranged power of your Pistols, the sweeping speed of a Sword, or the primal satisfaction of your Punches?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "re
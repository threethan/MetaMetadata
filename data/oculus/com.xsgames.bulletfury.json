96", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821719_1281333440680829_3834042529400575196_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUUwIc21mVQQ7kNvwFqCXfL&_nc_oc=AdrbsNX3NWKo21Wu2HXDQAzPrh00N0PXJ6VHQrVZgXAGDhKBVNtjZUdCm7mOyR0XsIA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jr1Jt4W0xW1GdlcjieMUnpdzQLBIRAbzsS2XsC6ouqg&oe=69FDE353"}, {"file_name": "3.png", "id": "889867943602841", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825470_889867946936174_4198226107227066338_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0sBCy9jingQ7kNvwFDIKOA&_nc_oc=Adqf7waemKM2x7Jr7OQFMw9_tTXp0jlNp8v05PMCxLIkvB2so6POEZcBVkX_joW4vdg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78KZYqKhcu3KNvixZHpkgrv3CHrQPz89p-whHH1MAr9g&oe=69FE04C2"}, {"file_name": "4.png", "id": "1382646699881961", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820887_1382646703215294_1236403228488482603_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6B4t5Q6u3D0Q7kNvwHiQyxr&_nc_oc=AdrvpJ3CthIoQUoBUDIhIaB2l3KDomej2eHt2HDAADQXYOuSgJxf5_oD2peSzf33Jew&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uOWb_LztxOS6ZZK_mh9skFjVY_mXnghDUPCMutj5xww&oe=69FDD685"}, {"file_name": "5.png", "id": "1150714390565037", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822307_1150714397231703_6965840896846762554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfS6jCrSrwQQ7kNvwHBi-GF&_nc_oc=AdrGSA3CkcpOrMYNMvqbfFVx4eUOiijfm6qjgLzsN1LldfarpyaCi5-HwXyqtbMHzpY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ua5ZVVGsh8igqfqVhdoSD6ZmA6mJ2BQ1tYmhw7859UA&oe=69FE02EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launch_screen.png", "id": "837865448956026", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491818860_837865452289359_7464072310727294045_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttPJosDHVf8Q7kNvwEhxO0H&_nc_oc=AdplJhJKfnOeehykAC-SCgMBq3-QfgZv6aVMCS02K2OrixfBv29EKw1-Blpv_vJuVQ8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6C_oi2j1wd3mxZojYyC0_KHqyBgsBQXnHOH2xva6po7g&oe=69FE05DA"}, "display_name": "Bullet Fury -  Sci-Fi Shooting game", "keywords": ["shooting", "puzzle", "cubes", "gun", "shot"], "long_description": "**Prepare for an adrenaline-fueled challenge where success depends on rapid adaptation**\n\nArm yourself with Pistols, Swords, or Punches and step into the arena to face rushing waves of numbered and lettered cubes.\n\nThe objective changes every round \u2014 only hitting the specified targets will keep you alive.\n\nYou get three lives: waste one on a bad hit or take one from an enemy cube, and your high-score run ends instantly.\n\nProve your mastery by completing intense challenges and claiming the top score!", "short_description": "Will you rely on the ranged power of your Pistols, the sweeping speed of a Sword, or the primal satisfaction of your Punches?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24373974065611646"}, "review_messages": []}]}, "cover_
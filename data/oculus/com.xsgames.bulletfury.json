eKiE7UfUd3YhpjM4zdf89WPYavWFM4zd1gZVsMPvIQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGI9MURtdB5SBtddoNcCk9J8Z5Fh9N39Or-bi-XjmG92w&oe=6A70801A"}, "display_name": "Bullet Fury -  Sci-Fi Shooting game", "keywords": ["shooting", "puzzle", "cubes", "gun", "shot"], "long_description": "**Prepare for an adrenaline-fueled challenge where success depends on rapid adaptation**\n\nArm yourself with Pistols, Swords, or Punches and step into the arena to face rushing waves of numbered and lettered cubes.\n\nThe objective changes every round \u2014 only hitting the specified targets will keep you alive.\n\nYou get three lives: waste one on a bad hit or take one from an enemy cube, and your high-score run ends instantly.\n\nProve your mastery by completing intense challenges and claiming the top score!", "short_description": "Will you rely on the ranged power of your Pistols, the sweeping speed of a Sword, or the primal satisfaction of your Punches?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24373974065611646"}, "review_messages": []}]}, "cover_
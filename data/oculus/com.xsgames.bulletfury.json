96", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821719_1281333440680829_3834042529400575196_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2z1eV5IaW0Q7kNvwE9tuXD&_nc_oc=AdocCj0RE_wKYOeHTcb4-3D0fYZ7-G2AbG9SOV9KcuYZFeHYzihJ1AFIXBFFc9ZZjBg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ-s4gq_6HW8-Ir6DLFbIq1LKfaThGlpf_Il4WNbqgrA&oe=6AB7C6D3"}, {"file_name": "3.png", "id": "889867943602841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825470_889867946936174_4198226107227066338_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLvdqaZ3f_0Q7kNvwHPXiei&_nc_oc=AdqakKDryoHGAsbsWAlycAHKJ4LxmmRZ4IZrp_Xt0upMSdIT_ZBgxtgkLrAD4QymLuY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2WuFM0eOYfsgL-vjvPUFaTT2JGiVQ4paEoMrJk_cfTw&oe=6AB7E842"}, {"file_name": "4.png", "id": "1382646699881961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820887_1382646703215294_1236403228488482603_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcUEWcSFGrkQ7kNvwERomUa&_nc_oc=Adoa0wOu1CxY1R_0k2j22TsX2q6-d4-Fy0CokMHyyJz8RBsN9K_rbLLbpm1ry-JjPH4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzpCve0gMmQqYSFx2OuR1CFIxzIXCvJ8iiMso51wiVaw&oe=6AB7BA05"}, {"file_name": "5.png", "id": "1150714390565037", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822307_1150714397231703_6965840896846762554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEMgPulvFDkQ7kNvwEkDiQs&_nc_oc=AdrdqxmAJx60LpR9hMS39iMCw1TosDacSb9Vrmul54MZ9l1u57DzJ7_BYnF52s5SCLI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0OiAUCPXOUzxx6EtWA9CFtK-v3TxHVdHPh_NV7bwI2g&oe=6AB7E66F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launch_screen.png", "id": "837865448956026", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_837865452289359_7464072310727294045_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5JKkPf7FsoQ7kNvwH7LC4R&_nc_oc=Adq7ktG_JsTYQmZXM6LXjvvKZYYK3seB17zZgb95868E8jtHU-oh7QT2L904JB2pBXQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLw9EtFpm-07B7OAvmq1cQ9tnjws5aairfCyjwoJsJZEw&oe=6AB7E95A"}, "display_name": "Bullet Fury -  Sci-Fi Shooting game", "keywords": ["shooting", "puzzle", "cubes", "gun", "shot"], "long_description": "**Prepare for an adrenaline-fueled challenge where success depends on rapid adaptation**\n\nArm yourself with Pistols, Swords, or Punches and step into the arena to face rushing waves of numbered and lettered cubes.\n\nThe objective changes every round \u2014 only hitting the specified targets will keep you alive.\n\nYou get three lives: waste one on a bad hit or take one from an enemy cube, and your high-score run ends instantly.\n\nProve your mastery by completing intense challenges and claiming the top score!", "short_description": "Will you rely on the ranged power of your Pistols, the sweeping speed of a Sword, or the primal satisfaction of your Punches?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24373974065611646"}, "review_messages": []}]}, "cover_
96", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821719_1281333440680829_3834042529400575196_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpHFpidguOIQ7kNvwGOa7Q-&_nc_oc=AdprIoWtu6R3nqETCB4PLh6e__uzfxMNu-nP-JE8QzrBGHbGQVQn8G5QZw1xnBogLSQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT60QiZXbosqVyUaEmV6lpbQReGUVjkcKD2PJF3vDgGAg&oe=6AECBB13"}, {"file_name": "3.png", "id": "889867943602841", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825470_889867946936174_4198226107227066338_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeVFc28dGPwQ7kNvwF7gum9&_nc_oc=AdqPMqjqenRkMoEqRSvGvEN8EsTW_felcQxgbDNpIqSl02yZA6Ey9lPMZBTOzJUhehk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAFJDboq8gTVBSdFE4_9NKJPE-Kz6kc4MaRLQd8no1gg&oe=6AECA442"}, {"file_name": "4.png", "id": "1382646699881961", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820887_1382646703215294_1236403228488482603_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gFfDizZTHAQ7kNvwELNF3Y&_nc_oc=AdqAeEakZOrxKp241EQDJ-7hr7cu8Ul4vUP6_sT_048okBt4IZ5Y4rAM6ZIzV582P3M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQ2kMCj6ylESztVMm-n0ymd0Rs-5ptiT8-Dn8muW4l1A&oe=6AECAE45"}, {"file_name": "5.png", "id": "1150714390565037", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822307_1150714397231703_6965840896846762554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2o2_XhP1MYQ7kNvwHnZMjT&_nc_oc=AdoNSFY-h1wl9RMJdhSAcTnwV4vgKQA2LL-gd3BEXUDTtJTRE4z8Pe-ecsHMXXkJUck&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQVJ0qYDKOo9XFIP6PmAO5et8x77gKb5r7vL-maZa3TA&oe=6AECA26F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launch_screen.png", "id": "837865448956026", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491818860_837865452289359_7464072310727294045_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oe_l0FIoJZAQ7kNvwFPpmjR&_nc_oc=Adr186OFb2DrVFf6dJEZnMQ5edNbSZYHVXlKhwxZhXTXF24YA_VPu_aLE_hsd_T07DA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfkTQ3SFS4BReoMQqKP2aFYrhuEI8a3Lebx1EDui0mRw&oe=6AECA55A"}, "display_name": "Bullet Fury -  Sci-Fi Shooting game", "keywords": ["shooting", "puzzle", "cubes", "gun", "shot"], "long_description": "**Prepare for an adrenaline-fueled challenge where success depends on rapid adaptation**\n\nArm yourself with Pistols, Swords, or Punches and step into the arena to face rushing waves of numbered and lettered cubes.\n\nThe objective changes every round \u2014 only hitting the specified targets will keep you alive.\n\nYou get three lives: waste one on a bad hit or take one from an enemy cube, and your high-score run ends instantly.\n\nProve your mastery by completing intense challenges and claiming the top score!", "short_description": "Will you rely on the ranged power of your Pistols, the sweeping speed of a Sword, or the primal satisfaction of your Punches?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24373974065611646"}, "review_messages": []}]}, "cover_
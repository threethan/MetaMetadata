-7&_nc_sid=6e7a0a&_nc_ohc=G_4pN0UdA-0Q7kNvwGWmJEo&_nc_oc=AdlShChiUNa4ieI77_Ei3E-Shce9azLLqw71o8e97Sr1aG8xKisgnP6yUNAyktZZfxo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftzmsY6N64_qZqX8q9bqF4lahNCzKIdmT_YzLrQ5X77Iw&oe=69A98FAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ShuttleMaze_Main_16_9.jpg.png", "id": "617246719592534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031634_617246722925867_7532184089991194285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAhJGVMtfM4Q7kNvwGmz5JL&_nc_oc=AdmiCwuOm586RtjRqsk2SLkoI9CP2J4NKbG32swJIrJpo2hxFr13rnydabahht3MAYc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsK6bSg-gxoryGcB5H5I3-aMEHrbkCjI5KWYtw-qrZZRg&oe=69A9946B"}, "display_name": "Shuttle Maze", "keywords": [], "long_description": "Shuttle Maze introduces a new challenging VR gameplay in which you control Glow's spaceship - \"The Minotaur\", in 3rd person perspective, in all 6 directions.\n\nShuttle Maze is created by gamers who wish to create a comfortable VR game which emphasizes game balance and mechanics. \nInspired by classic 2D platformer games which focus on player's timing and precision, Shuttle Maze requires you to master your skills in controlling Glow's spaceship, its bombs and its projectiles.\n\n- 6 CAMPAIGN levels\n- 10 RACE levels\n~180 minutes\n\n------\n\"Easily one of the best experiences i've had on the quest. Everything is so well put together from the music to the colors..\" - 5/5 Mike Peters\n\n\"..There are a lot of great things about this game, the music, the mechanics, the graphics, but what really stood out for me was the level design..\" - 5/5 elhnad\n------", "short_description": "ARCADE | ACTION | PUZZLE | 3RD PERSON PERSPECTIVE\n\nIt is 2062. Glow is trapped by a crazy AI gone wild.\nTo help her, you're going to fly her through story-driven MAZES,\nto upgrade WEAPONS and master new capabilities ,\nto blast re-programmed enemy-bots and to solve thrilling PUZZLES.\n\nCarefully picked minimal and clear RETRO graphics, combined with various classic beats, will make sure you're COMFORTABLE while keeping you focused on gameplay and get you on your toes... And perhaps on your knees??"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ayayugames.com/privacypolicy", "developer_terms_of_service_url": "https://www.ayayugames.com/termsofservice", "publisher_name": "Ayayu Games", "support_website_url": "https://www.ayayugames.com/shuttlemaze", "website_url": "https://www.ayayugames.com/shuttlemaze", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "241955174781002"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "9140058572737908"}, {"status": "PUBLISHED", "id": "651797814041368"}, {"status": "PUBLISHED", "id": "998016578862070"}, {"status": "PENDING", "id": "1761503301279118"}, {"status": "PUBLISHED", "id": "1169483666918132"}, {"status": "PUBLISHED", "id": "5152661908185778"}, {"status": "PUBLISHED", "id": "1261936070971890"}]}, "baseline_offer": {"id": "5152661908185778"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742148000, "status": "PUBLISHED", "id": "9140058572737908"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "bina
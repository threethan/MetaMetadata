NDmsl8DNfHmIlMvwKby_NxaYgDnRJYO3izuU0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRubATJHo5WbXBsOki-GXAcdAkaGCVyZ0pd4fQz0NdDBQ&oe=6AF358A5"}, {"file_name": "Frame 39.png", "id": "1027437402531046", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393264_1027437405864379_964659673718568473_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMfJo6bcBdMQ7kNvwGC2dbn&_nc_oc=AdrXHwCIB7p6eC1nFYlsweC2cEwna9EBTE5AQWPm0OYzR5ytzPMJGh-4_TotuYRGNrQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQy3c6MTXY4Jv-1ujPBpDoluoZSdU_YKABawr7YZeYDdQ&oe=6AF32EFD"}, {"file_name": "Frame 42.png", "id": "998963342149910", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391810_998963345483243_4082460668804059461_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5WAGT9kxr8Q7kNvwGG3WBE&_nc_oc=AdrJZPB3gzrEQWMzKHwYf-3T8Srak13TzQhFl3WxXDCPmCM_wdbpR6xp0E6FlNdT0vY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQ3YiaCjQZLnonBmmz5jnq_DsCDtbfHpdiez3IB4bpMA&oe=6AF353C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 99.png", "id": "1129848996269480", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823812_1129848999602813_7503868299148137612_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AL5dIJmSGqgQ7kNvwHLmmkw&_nc_oc=Adp6XmRv9vSXyK59F9rqeJUqp29PiFTpAAMw93gzuyAA3CH3sMyssqgUHZ1HPCV2ErA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThoyL1qOn3BdAgow_IUPbSMazQXVRNUIg9LakO2V5SYQ&oe=6AF33666"}, "display_name": "Viral Descent: Together", "keywords": ["coop", "funny", "party", "horror", "multiplayer"], "long_description": "\u2b50 **LET'S GO VIRAL**\n\nGo viral to the death! Viral Descent is a co-op horror game where you record hilariously creepy clips and try to go viral.\u200e\u200e\u200e\u200e\u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e \u200e  \n{1367134564290374}\n\n\u2622\ufe0f **DESCENT INTO THE DANGER**\n\nLead your squad across radiation zones. Face mutated monsters. Most importantly, make every recording count.\n\n{996525242369132}\n\n\ud83d\udd77\ufe0f **BEWARE OF THE MONSTERS**\n\nCount on your friends to save your life from terrifying monsters \u2014 all while capturing the perfect viral video.\n\n{2012676175884632}\n\n\ud83c\udfa5 **VIEW IS THE MOST IMPORTANT**\n\nIf death is inevitable, make sure you get it on camera. Otherwise, it\u2019s all for nothing.\n\n\n{501755109410443}", "short_description": "Dare to capture the unimaginable in this hilariously terrifying co-op experience! Team up with friends to film spooky shenanigans in haunted locales, then upload your scares to ViralTube. Going solo? Strongly discouraged."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liminagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Limina Games", "support_website_url": "https://liminagames.com/discord", "website_url": "https://liminagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "28708330842108862"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823296_1818158659314863_18
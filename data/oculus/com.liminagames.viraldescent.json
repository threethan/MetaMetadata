7kNvwEcdne6&_nc_oc=AdlRiYko0WmLi8uOBoTuwislTnL89gFQ6-U46jcd3QDiFlf3ovsG7JmgaGeiYEMTGec&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afuvx20wC7yz6kFGxvuPGzremfxcIOYmow2RC8CMRHOLQA&oe=69A41B0A"}, {"file_name": "Frame 39.png", "id": "1027437402531046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393264_1027437405864379_964659673718568473_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjjYSPF2UdkQ7kNvwEiXsFp&_nc_oc=AdmzhB4haTR_lUKMScqY96IW4C0QWyZRrc0G67m4N3dTrROLri_r6dch_jX_8anX-qE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs-esJ0Wc3iSwLnJDQXQESNyglb-CKmdEoUtmEPu4lSTA&oe=69A419BD"}, {"file_name": "Frame 41.png", "id": "1396751298366008", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391769_1396751301699341_592008253617462062_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A85ZVjLVKdcQ7kNvwGuV5SG&_nc_oc=AdlOOZoCwdRHopbSpJCtGNGzsNb2RhlogvN6SrwI30Tv3YTqb9Mo3VC249ZK07_ZOjU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfttyvSQIii2533nlDlBb4fzA2I3Zq9P9p0LJoqQ7SJNKA&oe=69A446FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1669731347254613", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391739_1669731350587946_4534248517444844151_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bd-jnElixTUQ7kNvwGf2rW8&_nc_oc=AdncHxtmTIZc2rEF2EhRqNVB5BjLD6qTvo7cv-O70tbCAA8OGQRFr0kh60wPWvydgic&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft-TdaRNMrg9SoFg0t---qtrHU73jtvUa-YdHq8OzEKmQ&oe=69A42109"}, "display_name": "Viral Descent", "keywords": ["online", "coop", "funny", "party", "horror"], "long_description": "\u2b50 **LET'S GO VIRAL**\n\nGo viral to the death! Viral Descent is a co-op horror game where you record hilariously creepy clips and try to go viral.\u200e\u200e\u200e\u200e\u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e \u200e  \n{1367134564290374}\n\n\u2622\ufe0f **DESCENT INTO THE DANGER**\n\nLead your squad across radiation zones. Face mutated monsters. Most importantly, make every recording count.\n\n{996525242369132}\n\n\ud83d\udd77\ufe0f **DESCENT INTO THE DANGER**\n\nCount on your friends to save your life from terrifying monsters \u2014 all while capturing the perfect viral video.\n\n{2012676175884632}\n\n\ud83c\udfa5 **VIEW IS THE MOST IMPORTANT**\n\nIf death is inevitable, make sure you get it on camera. Otherwise, it\u2019s all for nothing.\n\n\n{501755109410443}", "short_description": "Dare to capture the unimaginable in this hilariously terrifying co-op experience! Team up with friends to film spooky shenanigans in haunted locales, then upload your scares to ViralTube. Going solo? Strongly discouraged."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liminagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Limina Games", "support_website_url": null, "website_url": "https://liminagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "9276518935716676"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "3388781327938121"}, {"status": "PUBLISHED", "id": "4248398385433512"}, {"status": "PUBLISHED", "id": "1426592212195646
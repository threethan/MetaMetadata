37405864379_964659673718568473_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7IcTRQH4_YQ7kNvwETvsqy&_nc_oc=Adr_WF0ku_mW2kVBcC3EQl3FdPakaoMZ4gjVVRxQTQD7T0TDB7tkEUzqB8uIQwnrvCo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AU21VLJMkoW1Re2KP2438pSxcn1QKbJQgWaaWvPSVhg&oe=69D38FBD"}, {"file_name": "Frame 42.png", "id": "998963342149910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391810_998963345483243_4082460668804059461_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y36sHFhRT1AQ7kNvwHrHoI7&_nc_oc=Adrezf4JhS4BKcRJ6e6jCVwQWTdOHqEiKjAxd5aHmWNldfQ5WUWwOe4aC69NVF7IumE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tAobx4ZQs5PknDJvKP1dXbgYHTTbrDiLyvnUbVryvjw&oe=69D3B487"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 133 (1).png", "id": "1450801886560519", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823746_1450801889893852_9128302668770611706_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTwZznmlh2sQ7kNvwEpP1Lo&_nc_oc=Ado_ig0lajCCeM1PEZl7X7-1tsN08blhjZuZFmkRe9PkAlVjSsz_kBk8jUBtKd2vrgE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UOL2KtmDEgMO0txJSCk9ApF8MVHjroztDQf9pAMNncg&oe=69D3C5C6"}, "display_name": "Viral Descent: Together", "keywords": ["coop", "funny", "party", "horror", "multiplayer"], "long_description": "\u2b50 **LET'S GO VIRAL**\n\nGo viral to the death! Viral Descent is a co-op horror game where you record hilariously creepy clips and try to go viral.\u200e\u200e\u200e\u200e\u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e \u200e  \n{1367134564290374}\n\n\u2622\ufe0f **DESCENT INTO THE DANGER**\n\nLead your squad across radiation zones. Face mutated monsters. Most importantly, make every recording count.\n\n{996525242369132}\n\n\ud83d\udd77\ufe0f **BEWARE OF THE MONSTERS**\n\nCount on your friends to save your life from terrifying monsters \u2014 all while capturing the perfect viral video.\n\n{2012676175884632}\n\n\ud83c\udfa5 **VIEW IS THE MOST IMPORTANT**\n\nIf death is inevitable, make sure you get it on camera. Otherwise, it\u2019s all for nothing.\n\n\n{501755109410443}", "short_description": "Dare to capture the unimaginable in this hilariously terrifying co-op experience! Team up with friends to film spooky shenanigans in haunted locales, then upload your scares to ViralTube. Going solo? Strongly discouraged."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liminagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Limina Games", "support_website_url": "https://liminagames.com/discord", "website_url": "https://liminagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25745784558363520"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822307_1983025419290036_4106645197434090483_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0-hY-IhHJUQ7kNvwE6uoiO&_nc_oc=Adr9_MdfRBjzKtF1dfAnC8EI2JuMB16L-NApfsm_N310ZdaDuEdtigoys0UOqMf0ra4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qXNhWByqm5O1qJX-88ZCci0XDcnsDBpoZRwG
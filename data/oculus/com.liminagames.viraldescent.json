27437405864379_964659673718568473_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElmutNmltLMQ7kNvwE95Zza&_nc_oc=AdoFY9E2KF6-VQb0JymLZ1en7_OCbqV5WIvqQsLXfWhy7qGpwrbbLSgB83SEfZLEtCM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_hfd_bjLuxPC75r-hoQ6VhcPsNn7_p3fs1ax9nTOXJg&oe=6A37F9FD"}, {"file_name": "Frame 42.png", "id": "998963342149910", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391810_998963345483243_4082460668804059461_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvyzakH1iIQQ7kNvwHB9K-t&_nc_oc=AdozAJ47xGXt0nVXKXWiWCBkzxyjXSCynKIhk_K6FfZtWtckJJRGX56_BQoudrnnQmc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jNLAN8iF5km9oKGqW4Ev0JC30HF87OdJKLn2HIrfczQ&oe=6A37E687"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1442.png", "id": "27586332837623797", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827585_27586332844290463_7382517788913992324_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yPoN39KJiAQ7kNvwGM_LYX&_nc_oc=AdrfMRouw0P24ttBrRbYGAR-ORDCgSiUYcAKGRs2jV32mRy7bfQpXYXgSXLRsaHaxhM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GyMdEdkKr1Lg7j8QDOw1_JE-tz4jLkoDAttdIiIq2mQ&oe=6A380E34"}, "display_name": "Viral Descent: Together", "keywords": ["coop", "funny", "party", "horror", "multiplayer"], "long_description": "\u2b50 **LET'S GO VIRAL**\n\nGo viral to the death! Viral Descent is a co-op horror game where you record hilariously creepy clips and try to go viral.\u200e\u200e\u200e\u200e\u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e \u200e  \n{1367134564290374}\n\n\u2622\ufe0f **DESCENT INTO THE DANGER**\n\nLead your squad across radiation zones. Face mutated monsters. Most importantly, make every recording count.\n\n{996525242369132}\n\n\ud83d\udd77\ufe0f **BEWARE OF THE MONSTERS**\n\nCount on your friends to save your life from terrifying monsters \u2014 all while capturing the perfect viral video.\n\n{2012676175884632}\n\n\ud83c\udfa5 **VIEW IS THE MOST IMPORTANT**\n\nIf death is inevitable, make sure you get it on camera. Otherwise, it\u2019s all for nothing.\n\n\n{501755109410443}", "short_description": "Dare to capture the unimaginable in this hilariously terrifying co-op experience! Team up with friends to film spooky shenanigans in haunted locales, then upload your scares to ViralTube. Going solo? Strongly discouraged."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liminagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Limina Games", "support_website_url": "https://liminagames.com/discord", "website_url": "https://liminagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26488614770747158"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821725_1263226512682582_7977189108977044796_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRQD7J7aHMIQ7kNvwELQ30j&_nc_oc=AdqltI0PzveVWhcjWoGPR3QgeoVHsgbepxCaZfOgNvL1_KNRhLyY9B7lB9zh8BssrF0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TswuPLjU1dwr5PvjXlTTmUg05nEH0U9DP
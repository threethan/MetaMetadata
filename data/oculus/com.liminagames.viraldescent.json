le_name": "Frame 39.png", "id": "1027437402531046", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393264_1027437405864379_964659673718568473_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VWOmOM6lmMQ7kNvwFNGuRX&_nc_oc=AdpWJcg1xSJ_wRNlgYStw3r1Ls1CdcBfap-MSM4WVLMvDNq3sScNaVNCK-SKNm989Ug&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAj0kmr5S1SX6jnqp70zMFF_BkSUUFBDCWenwz9RQEaDQ&oe=6A5CE3FD"}, {"file_name": "Frame 42.png", "id": "998963342149910", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391810_998963345483243_4082460668804059461_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7aG8RmnmRgQ7kNvwFkTXXd&_nc_oc=AdoGoYLDlAuMS9ilxfHmUvZoBNi3C2s02TArTV-PpOzHR48ol7HqI13-8IpQSOX-fQQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCo4lFao7cxAIxyPum1nbh4EpDvOahq_slcl_rZAcb0_w&oe=6A5CD087"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1442.png", "id": "27586332837623797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827585_27586332844290463_7382517788913992324_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbqwijeCR2sQ7kNvwGAJ73B&_nc_oc=Adorcz1--5vNLCyE2RCtdO-x0SfBKN-kJz23DQv2YrNHLfR8eckxg_-EA9xUmC6U9kA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8YyL4Qbe9jzeXzxN3UW5vEJ85eBW1ULiiLR9kQrEmPQ&oe=6A5CBFF4"}, "display_name": "Viral Descent: Together", "keywords": ["coop", "funny", "party", "horror", "multiplayer"], "long_description": "\u2b50 **LET'S GO VIRAL**\n\nGo viral to the death! Viral Descent is a co-op horror game where you record hilariously creepy clips and try to go viral.\u200e\u200e\u200e\u200e\u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e \u200e  \n{1367134564290374}\n\n\u2622\ufe0f **DESCENT INTO THE DANGER**\n\nLead your squad across radiation zones. Face mutated monsters. Most importantly, make every recording count.\n\n{996525242369132}\n\n\ud83d\udd77\ufe0f **BEWARE OF THE MONSTERS**\n\nCount on your friends to save your life from terrifying monsters \u2014 all while capturing the perfect viral video.\n\n{2012676175884632}\n\n\ud83c\udfa5 **VIEW IS THE MOST IMPORTANT**\n\nIf death is inevitable, make sure you get it on camera. Otherwise, it\u2019s all for nothing.\n\n\n{501755109410443}", "short_description": "Dare to capture the unimaginable in this hilariously terrifying co-op experience! Team up with friends to film spooky shenanigans in haunted locales, then upload your scares to ViralTube. Going solo? Strongly discouraged."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liminagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Limina Games", "support_website_url": "https://liminagames.com/discord", "website_url": "https://liminagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26488614770747158"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821725_1263226512682582_7977189108977044796_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BbgEJeES7EQ7kNvwE2oS_O&_nc_oc=Adqa0uDVC74s1jzUV_y1outXIQk9MfF0SCvm9PUbk2xnG
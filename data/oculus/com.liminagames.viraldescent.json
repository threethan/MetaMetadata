Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__REAVfxuZl1Krz2OUe58BM5sGPUtyb9UE6b4aClkJCg&oe=6A466707"}, {"file_name": "Frame 38.png", "id": "2128569810932773", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473393188_2128569817599439_109533599574882647_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ceoXFBa-WwQ7kNvwGzfgY1&_nc_oc=Adovqgju61EwSr3oeygYBtVQ3k8O_WYKV7jglBWvYyvdyFwteOW5hLCixioiQlbtXUg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3tus7dGaoxBaMjgqk1ADQ5WWYM6GNvLnNcB9qc7jHtg&oe=6A467BCA"}, {"file_name": "Frame 39.png", "id": "1027437402531046", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393264_1027437405864379_964659673718568473_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGWiyZRuP1EQ7kNvwGmVnK8&_nc_oc=AdqlNMJTlhqYzDGVN4OFrRXiBwhITg4LYgdnRXMjCASolTVYGNC10Vs0QSCkvxuEens&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uZUK7Q8C9hbXpdmDSxJj4mdRNcNwVIMw3b48SDKipmQ&oe=6A467A7D"}, {"file_name": "Frame 41.png", "id": "1396751298366008", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391769_1396751301699341_592008253617462062_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8-LBU5Gu-YQ7kNvwEnLSKm&_nc_oc=Adr7CU48bwfGcxBqzPpiwFM6EcHCkIiQSasrorYNMqOeLqFzWIfEjsn1pORsxNGt804&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yVYjLAvs5OtAk7LXRw6FlF8zSOvP1WTvJrlKXPR0lgw&oe=6A466F7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1669731347254613", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391739_1669731350587946_4534248517444844151_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPc1-wh3qwkQ7kNvwEd10ch&_nc_oc=AdoT-HsdwoaKjtLOKPZoXtsw16VAdSb-BDqd6l6C8ZNfya8SrHSKwhEmsj_wca6vA_w&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PXuX5xW91oxu-izKjsMRJ8Z9SxAGHX2oqI4Q9T917nw&oe=6A4681C9"}, "display_name": "Viral Descent", "keywords": ["online", "coop", "funny", "party", "horror"], "long_description": "\u2b50 **LET'S GO VIRAL**\n\nGo viral to the death! Viral Descent is a co-op horror game where you record hilariously creepy clips and try to go viral.\u200e\u200e\u200e\u200e\u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e \u200e  \n{1367134564290374}\n\n\u2622\ufe0f **DESCENT INTO THE DANGER**\n\nLead your squad across radiation zones. Face mutated monsters. Most importantly, make every recording count.\n\n{996525242369132}\n\n\ud83d\udd77\ufe0f **DESCENT INTO THE DANGER**\n\nCount on your friends to save your life from terrifying monsters \u2014 all while capturing the perfect viral video.\n\n{2012676175884632}\n\n\ud83c\udfa5 **VIEW IS THE MOST IMPORTANT**\n\nIf death is inevitable, make sure you get it on camera. Otherwise, it\u2019s all for nothing.\n\n\n{501755109410443}", "short_description": "Dare to capture the unimaginable in this hilariously terrifying co-op experience! Team up with friends to film spooky shenanigans in haunted locales, then upload your scares to ViralTube. Going solo? Strongly discouraged."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liminagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Limina Games", "support_website_url": null, "website_url": "https://liminagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
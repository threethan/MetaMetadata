17FD"}, {"file_name": "Frame 41.png", "id": "1396751298366008", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391769_1396751301699341_592008253617462062_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YG-E1Ke14jMQ7kNvwHHJhRh&_nc_oc=Adr3hj6Bu3VlwYMvh64o7jXwAl1nIbOstobZn0w04kJ1SPZQVYWt6u0BygwBfLO40mc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXw091QLNR_WIZUGD7XtlgeTutajqffW-0mD4-JLUL7A&oe=6AFB453F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1669731347254613", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391739_1669731350587946_4534248517444844151_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-kmeMKxHXYQ7kNvwENxnxr&_nc_oc=Adr0xL8Ol4MBCfYCpCITl9crh-s30H4H_cIZuqI2ff0OsbPn68c10yP4yktaIYhcYFM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSltUfyg3MuzfS8ObNR4qGCuJOe383AtV2b7WXN-qmrWw&oe=6AFB1F49"}, "display_name": "Viral Descent", "keywords": ["online", "coop", "funny", "party", "horror"], "long_description": "\u2b50 **LET'S GO VIRAL**\n\nGo viral to the death! Viral Descent is a co-op horror game where you record hilariously creepy clips and try to go viral.\u200e\u200e\u200e\u200e\u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e \u200e  \n{1367134564290374}\n\n\u2622\ufe0f **DESCENT INTO THE DANGER**\n\nLead your squad across radiation zones. Face mutated monsters. Most importantly, make every recording count.\n\n{996525242369132}\n\n\ud83d\udd77\ufe0f **DESCENT INTO THE DANGER**\n\nCount on your friends to save your life from terrifying monsters \u2014 all while capturing the perfect viral video.\n\n{2012676175884632}\n\n\ud83c\udfa5 **VIEW IS THE MOST IMPORTANT**\n\nIf death is inevitable, make sure you get it on camera. Otherwise, it\u2019s all for nothing.\n\n\n{501755109410443}", "short_description": "Dare to capture the unimaginable in this hilariously terrifying co-op experience! Team up with friends to film spooky shenanigans in haunted locales, then upload your scares to ViralTube. Going solo? Strongly discouraged."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liminagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Limina Games", "support_website_url": null, "website_url": "https://liminagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "9276518935716676"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "2191191311434638"}, {"status": "PUBLISHED", "id": "1417009840335561"}, {"status": "PUBLISHED", "id": "1018037687662111"}, {"status": "PUBLISHED", "id": "2403581693492210"}, {"status": "PUBLISHED", "id": "1271778010959671"}, {"status": "PUBLISHED", "id": "3388781327938121"}, {"status": "PUBLISHED", "id": "4248398385433512"}, {"status": "PUBLISHED", "id": "1426592212195646"}, {"status": "PUBLISHED", "id": "1791816345038967"}, {"status": "PUBLISHED", "id": "1835724224015235"}, {"status": "PUBLISHED", "id": "1498035101580095"}, {"status": "PUBLISHED", "id": "1080177557350008"}, {"status": "PUBLISHED", "id": "1129583152251641"}]}, "baseline_offer": {"id
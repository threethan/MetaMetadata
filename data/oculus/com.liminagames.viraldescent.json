GaTQ22eDtGw74zUIJ0cxx_9EjEKZVILBteg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuflDC4I3LY2C1uqSm3Mj0XvJAtR-wWsV7NtbgW1r_OhA&oe=6998747D"}, {"file_name": "Frame 42.png", "id": "998963342149910", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391810_998963345483243_4082460668804059461_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_tsvHcTeDAQ7kNvwEWiSuT&_nc_oc=AdlmTylBSilzU2CwlhYBmDe13r8gM_Pmd4opShc2OeYWyqD63cSvCJfTCzmVuR1K6Gs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsuiNMOWV4alZHDlFraBMbSEWivTvopHrlHqpYEWqvSFw&oe=69986107"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 133 (1).png", "id": "1450801886560519", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823746_1450801889893852_9128302668770611706_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2caXA4CUBxYQ7kNvwEf1h5q&_nc_oc=AdmqRLPNAJUNZMb9PnYaV3TS-dg_PHcLKU63IEbxWmxeiQOLz99i-vLFvbl93JejkHw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afuw5JDVE79zEWW1ok4q6a-yueonYKwPCXFk_wl0E6wTOA&oe=69987246"}, "display_name": "Viral Descent: Together", "keywords": ["coop", "funny", "party", "horror", "multiplayer"], "long_description": "\u2b50 **LET'S GO VIRAL**\n\nGo viral to the death! Viral Descent is a co-op horror game where you record hilariously creepy clips and try to go viral.\u200e\u200e\u200e\u200e\u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e \u200e  \n{1367134564290374}\n\n\u2622\ufe0f **DESCENT INTO THE DANGER**\n\nLead your squad across radiation zones. Face mutated monsters. Most importantly, make every recording count.\n\n{996525242369132}\n\n\ud83d\udd77\ufe0f **BEWARE OF THE MONSTERS**\n\nCount on your friends to save your life from terrifying monsters \u2014 all while capturing the perfect viral video.\n\n{2012676175884632}\n\n\ud83c\udfa5 **VIEW IS THE MOST IMPORTANT**\n\nIf death is inevitable, make sure you get it on camera. Otherwise, it\u2019s all for nothing.\n\n\n{501755109410443}", "short_description": "Dare to capture the unimaginable in this hilariously terrifying co-op experience! Team up with friends to film spooky shenanigans in haunted locales, then upload your scares to ViralTube. Going solo? Strongly discouraged."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liminagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Limina Games", "support_website_url": "https://liminagames.com/discord", "website_url": "https://liminagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25745784558363520"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825481_879758118258305_7232753498210748284_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2JK9Qye-dcQ7kNvwEz7S-f&_nc_oc=AdmJC5HW6rdpzBrvsrsCiJLNUgi-xw4fPyDg5uU8Bj89FnpEwmzwDv-nQAKd4dYMQPI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfukYcsaRIMdJlC0JTmiId0DbcFfSbc712pLCEP74Rykeg&oe=69984DAA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Viral Descent: Together", "platform": "ANDROID_6DOF", "context_category": {"context_ca
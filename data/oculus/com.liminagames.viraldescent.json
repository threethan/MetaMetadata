E&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-d37Z8pTDZCaQID3TBcEj-j78nHrlMEOLiTOmDTYEW2g&oe=6A369507"}, {"file_name": "Frame 38.png", "id": "2128569810932773", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473393188_2128569817599439_109533599574882647_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBQvEIJ0lKwQ7kNvwGgqVeN&_nc_oc=AdohLEMIIMLTtCIwQs5fQfSHva70htJM30d-3DF-zhc4Zq8TFZKLv3OmN001h5tUy_s&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9C10hCA6vFAwRzIvWWQtgSTHtb2sWbfiGdT2xRKAyHIA&oe=6A36A9CA"}, {"file_name": "Frame 39.png", "id": "1027437402531046", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393264_1027437405864379_964659673718568473_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElmutNmltLMQ7kNvwE3CKfI&_nc_oc=AdrF1SiTNh0_LLZ_TwoCXYJ_fRnhdpY_9Ecxbm_zVVwJWOT3jCOd0d0ti7kPf9vUUcs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-deQ-4Gf-D_R_X669s5dh7kOAnsG3bZM_oaUtRweD5CA&oe=6A36A87D"}, {"file_name": "Frame 41.png", "id": "1396751298366008", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391769_1396751301699341_592008253617462062_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKiZEHYh--AQ7kNvwFEqZVS&_nc_oc=Ado7LotL1OFVEfUSwWF2lqFaVwdo9SwQvHr20ZT9uqwk9ZAZm96XRgI_plsSUkTjewc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ixA8-azgVAXiUJAc-J6Iein4JZd2A3AA_qI8U80mI5g&oe=6A369D7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1669731347254613", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391739_1669731350587946_4534248517444844151_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acBYLntSohAQ7kNvwFl70Pk&_nc_oc=AdqHe-zSe48hvgttBLjpo-Q6DPHNXaAL03kfZOn-UQ5ftTL79_vwLJCHSq4oD_qMsnQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8K8VK7EkjuiyonYdP6IZYykyslo_3Wwu_mi8iLplapfQ&oe=6A36AFC9"}, "display_name": "Viral Descent", "keywords": ["online", "coop", "funny", "party", "horror"], "long_description": "\u2b50 **LET'S GO VIRAL**\n\nGo viral to the death! Viral Descent is a co-op horror game where you record hilariously creepy clips and try to go viral.\u200e\u200e\u200e\u200e\u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e \u200e  \n{1367134564290374}\n\n\u2622\ufe0f **DESCENT INTO THE DANGER**\n\nLead your squad across radiation zones. Face mutated monsters. Most importantly, make every recording count.\n\n{996525242369132}\n\n\ud83d\udd77\ufe0f **DESCENT INTO THE DANGER**\n\nCount on your friends to save your life from terrifying monsters \u2014 all while capturing the perfect viral video.\n\n{2012676175884632}\n\n\ud83c\udfa5 **VIEW IS THE MOST IMPORTANT**\n\nIf death is inevitable, make sure you get it on camera. Otherwise, it\u2019s all for nothing.\n\n\n{501755109410443}", "short_description": "Dare to capture the unimaginable in this hilariously terrifying co-op experience! Team up with friends to film spooky shenanigans in haunted locales, then upload your scares to ViralTube. Going solo? Strongly discouraged."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liminagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Limina Games", "support_website_url": null, "website_url": "https://liminagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
27437405864379_964659673718568473_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZ45q8VaKWAQ7kNvwHOW2f2&_nc_oc=AdpXsetAtQxlhXaA97QJ-EYNgQgSkU_3OEF1c2hnX1rs0UxbXtjynpbPfUQ3jfD4xdo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XzOW3LmkR6xW3oofOhQvsOeG-a_a2CWfbAqtPC3CqLg&oe=6A2D6DFD"}, {"file_name": "Frame 42.png", "id": "998963342149910", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391810_998963345483243_4082460668804059461_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_GML2BWif8Q7kNvwGgsbnb&_nc_oc=Ado1jIlOnY9eH3i43s1swDwRs-szTEklEN-1i3raUUBk2WtzSz03OePONn5crMPqT4E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8X99G3c-4fFkeOiD1RGevpMJfAfl37ElSstQBAJsZiMQ&oe=6A2D5A87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1442.png", "id": "27586332837623797", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827585_27586332844290463_7382517788913992324_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tOe6nH4us4Q7kNvwFQ0oIo&_nc_oc=AdrfgAMyBbuLsNUyDBEm76scyyrmrQaZRl9evmToRIb3iiG6voct0Ym_3YMlAY71HUA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-d3DjHNp8rro4xG6Z9a9EVz1HNCng0FkGhfaX9Ynkcqg&oe=6A2D49F4"}, "display_name": "Viral Descent: Together", "keywords": ["coop", "funny", "party", "horror", "multiplayer"], "long_description": "\u2b50 **LET'S GO VIRAL**\n\nGo viral to the death! Viral Descent is a co-op horror game where you record hilariously creepy clips and try to go viral.\u200e\u200e\u200e\u200e\u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e  \u200e \u200e \u200e \u200e \u200e  \n{1367134564290374}\n\n\u2622\ufe0f **DESCENT INTO THE DANGER**\n\nLead your squad across radiation zones. Face mutated monsters. Most importantly, make every recording count.\n\n{996525242369132}\n\n\ud83d\udd77\ufe0f **BEWARE OF THE MONSTERS**\n\nCount on your friends to save your life from terrifying monsters \u2014 all while capturing the perfect viral video.\n\n{2012676175884632}\n\n\ud83c\udfa5 **VIEW IS THE MOST IMPORTANT**\n\nIf death is inevitable, make sure you get it on camera. Otherwise, it\u2019s all for nothing.\n\n\n{501755109410443}", "short_description": "Dare to capture the unimaginable in this hilariously terrifying co-op experience! Team up with friends to film spooky shenanigans in haunted locales, then upload your scares to ViralTube. Going solo? Strongly discouraged."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liminagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Limina Games", "support_website_url": "https://liminagames.com/discord", "website_url": "https://liminagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26488614770747158"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821725_1263226512682582_7977189108977044796_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CD5xUYXdZaQQ7kNvwHNDLg1&_nc_oc=AdqPZCCsV5A5_01D4iapuARKL6x-Mi9N2l6Y4UV09M3CcRm66CUhscHn0VZPKjYYJX4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NlF58pcUK-Zoa2-G9A0xOYpdGhHB4iQEG
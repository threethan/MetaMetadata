uluscdn.com/v/t64.5771-25/491820855_2192539717953426_367871095607900855_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCkc6xr0JkgQ7kNvwEuFkHI&_nc_oc=AdqYf0Qg6zZq3s6llSYWrEWvApKPBhaOcs6QG8L3V_SqS9rM_piq5yE3tZZqoWgiUIk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7Kpuz6JLGBbzoOzmnDMJ_HJ-DPDvwN0A5BnB5Wx6tVQ&oe=6A6DFA87"}, {"file_name": "Detail Images position 3_ 1920x 1080 anglais.png", "id": "971696542242840", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827611_971696548909506_4297247803299691892_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjSPSSYqC58Q7kNvwFnaOs3&_nc_oc=Adox2NQ6ZQHuPrN9WXK2DX5IgqVrZ3mVgpJ6e6xclNSqd-gn0nohNTgJWuBNtXBAW2I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJ848lBpB2a3uc3Wn7xlSXUaNsIWQqwQzjyhsqjN16wA&oe=6A6DFCF0"}, {"file_name": "Detail Images position 4_ 1920x 1080.png", "id": "821771434315733", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821796_821771437649066_3103385003174832691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SaxCQo0Emk4Q7kNvwFC8ZFD&_nc_oc=AdqB89p1R-lHpBGppaJfM1Sd25hfh6mm855o-7FkcaFx59WrKWS0jpPCQan3WVYklg4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzQY0eIrqY4JAdkg94SyDtoGbvgeus0JKdHQmMKU-BPA&oe=6A6DF72B"}, {"file_name": "Detail Images position 5_ 1920x 1080.png", "id": "2051381585789682", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827960_2051381589123015_3945287371549723109_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1oaDtK3aP0Q7kNvwHKT--q&_nc_oc=AdpB0lUP8sUVj8RQQZnUxnvS3Td9mXnnteCk40wsIhpme7cJiUmb5hNj0PtPkS5b1Sk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCz40uh29Vx8gXO6glQ3yQlNCNrU2JCrpl5r8WitQRBiQ&oe=6A6DDE8E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "JUMPR VR", "keywords": ["360", "video", "player", "event", "live"], "long_description": "JUMPR VR is a next-generation immersive entertainment platform designed for virtual reality.\n\nExperience live events and exclusive VR content like never before. With JUMPR VR, you can watch fights, concerts, sports events and premium shows in stunning 360\u00b0 immersive video, placing you right in the front row.\n\nKey Features\n\u2022 Immersive 360\u00b0 VR video experience\n\u2022 Live and on-demand premium events\n\u2022 Front-row perspective for fights, concerts and sports\n\u2022 High-quality VR streaming\n\u2022 Private viewing rooms and special experiences\n\nFeel the atmosphere.\n\nInstead of watching events on a flat screen, JUMPR VR places you inside the experience. Look around, feel the crowd, and enjoy events from the best seat in the arena.\n\nExclusive VR Content\n\nJUMPR VR collaborates with creators and event organizers to deliver unique immersive experiences only available in VR.\n\nNext-generation VR entertainment starts here.", "short_description": "Experience immersive live events and premium content in 360\u00b0. Watch fights, concerts, and exclusive shows as if you were there."}, {"images": {"nodes": [{"file_name": "image.png", "id": "2316548015421047", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819982_2316548018754380_6775850117213413084_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QEDeVqvAhoQ7kNvwEveE5Z&_nc_oc=Ado9yztVwrPSe8e0mJiJqRmW5tNQUGzwndssJGKytB1QkSW76ipZLxNDUZicU71US-Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQyy4J2r6w8Ot-ecKfAjFRbYy_3x3MIb8pV5hzlyfOyw&oe=6A6DD504"}, {"file_name": "image.png", "id": "1529647115462760", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823930_1529647122129426_202993470949384732_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwBFoo02RvMQ7kNvwGsfTBm&_nc_oc=Adpt_yp7JmZBv1irmRlxu_4UQMOUn6to_3oyRk1qZ3rbeTfEokL7-b4m_Brtsa1dp3c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyiNU7fq2vJTiUzfTsXPWyhRwjNAcEJTjDZKUq4zxXnQ&oe=6A6DE93F
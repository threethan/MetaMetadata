0736"}, {"file_name": "Detail Images position 2_ 1920x 1080 anglais.png", "id": "1287383316849486", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507819003_1287383320182819_4566032410477173632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xGVChHmHWIQ7kNvwEB8KOM&_nc_oc=AdoOM6_f_PGIwPq794qhbRvqQhdY7c53zbtk2fq0dsdjYcLLoTO41mGxGFX3tGWprCs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClL_TZcL2h__-Sr5OxlvKds6KAZ-KRrVyBY4JWaqg-Fw&oe=6A6DDD6E"}, {"file_name": "Detail Images position 3_ 1920x 1080 anglais.png", "id": "2145329379596218", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818860_2145329382929551_8052420496378210794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxlZBrQ7HocQ7kNvwFHm2r-&_nc_oc=AdpXNu7ICPzhEBmUEpbdNQzTooCjSZ6VV4I0-B3r0n_LWj8OuesGI6glT3iCmP-RFWA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADbWX-Kvrl_F6fjEDRPMq4Jgw9HcE3VxNPTw5rj5TE0g&oe=6A6DE93B"}, {"file_name": "Detail Images position 4_ 1920x 1080.png", "id": "1289734253335241", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820923_1289734256668574_1072105189314118603_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Do1SLF93mYQ7kNvwGPat5a&_nc_oc=Adq1qVPOAn1lDTTrudMy-ctWQzP-f9_fIHjydyZmKooOwH28oUE6sou8OCLdcrXneD4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCb8894RmBiIP6KSp_m55Vovcbr58lpVavlElIZaNMF7Q&oe=6A6DFD90"}, {"file_name": "Detail Images position 5_ 1920x 1080.png", "id": "1488700266313825", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823279_1488700279647157_4950448716228897112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnRrQ0CAox4Q7kNvwGmS3nM&_nc_oc=Ado3JBffA4lnwelFVrHWuwHrDArRRzsYqRZ1_zWVBbsm9PQgn_K9EhwbWHyoLKl1e8U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCfl5BBb3ObKExYSQEAEPYi-oxjKPQXM3tPTOSBdXzOw&oe=6A6DFDB8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "JUMPR VR", "keywords": ["360", "player", "live", "\u00e9v\u00e9nement", "video"], "long_description": "JUMPR VR est une plateforme de divertissement immersive de nouvelle g\u00e9n\u00e9ration con\u00e7ue pour la r\u00e9alit\u00e9 virtuelle.\n\nVivez des \u00e9v\u00e9nements en direct et du contenu VR exclusif comme jamais auparavant. Avec JUMPR, vous pouvez regarder des combats, des concerts, des \u00e9v\u00e9nements sportifs et des \u00e9missions premium dans une vid\u00e9o immersive \u00e0 360 \u00b0 \u00e9poustouflante, vous pla\u00e7ant au premier rang.\n\nCaract\u00e9ristiques cl\u00e9s\n\n\u2022 Exp\u00e9rience vid\u00e9o immersive 360 \u00b0 VR\n\u2022 \u00c9v\u00e9nements premium en direct et \u00e0 la demande\n\u2022 Perspective de premi\u00e8re ligne pour les combats, les concerts et les sports\n\u2022 Streaming VR de haute qualit\u00e9 optimis\u00e9 pour les casques PICO\n\u2022 Salles d'observation priv\u00e9es et exp\u00e9riences sp\u00e9ciales\n\nSentez l'atmosph\u00e8re.\n\nAu lieu de regarder les \u00e9v\u00e9nements sur un \u00e9cran plat, JUMPR vous place dans l'exp\u00e9rience. Regardez autour de vous, ressentez la foule et profitez des \u00e9v\u00e9nements depuis le meilleur si\u00e8ge de l'ar\u00e8ne.\n\nContenu VR exclusif\n\nJUMPR collabore avec les cr\u00e9ateurs et les organisateurs d'\u00e9v\u00e9nements pour offrir des exp\u00e9riences immersives uniques uniquement disponibles en VR.\n\nLe divertissement VR de nouvelle g\u00e9n\u00e9ration commence ici.", "short_description": "Vivez des concerts et des \u00e9v\u00e9nements sportifs comme si vous y \u00e9tiez gr\u00e2ce \u00e0 la r\u00e9alit\u00e9 virtuelle."}]}, "developer_name": null, "developer_privacy_policy_url": "https://evisel-tv.fr/accueil/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "EVISEL", "support_website_url": null, "website_url": "https://evisel-tv.fr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "36269221
rds": ["Monkey", "Brain", "Game", "Remeber", "Puzzle"], "long_description": "Fancy a fun challenge to your memory and dexterity? Then we have just the right thing for you: MonkeyBrain - the exciting game that keeps your mind busy!\n\nDive into the exciting world of MonkeyBrain, where you can put your memory, reaction time and manual dexterity to the test! You will really make your gray cells glow!\nSee your success on the leaderboard\nWho will be the real master of bananas?\nEntertaining graphics and sound effects \n\nWhat are you waiting for? Let's have fun together and make your brain cells dance! \n", "short_description": " You will really make your gray cells glow!\nRemember where the numbers are and turn the discs in the correct order."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eah-vr.com/Privacy-Policy/", "developer_terms_of_service_url": null, "publisher_name": "Andreas Hoffmann", "support_website_url": "https://eah-vr.com/Contact/", "website_url": "https://eah-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9126101174087793"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86627647_1789856948482873_2687378385281056774_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a
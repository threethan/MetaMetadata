D_Iv1vuQ3HTyI7BgHLxMIJMpGrbj52R-k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54466cF6JEyq7lzc8fwfH35k6nj0yBbxzCa7nvpcWtpQ&oe=6A072541"}, {"file_name": "migrated_image.png", "id": "137665414348463", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162754_254543168403006_3160993262957756416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNpqBfSPLcIQ7kNvwGL75BP&_nc_oc=AdpqdpHd04WcFTFDlDCTyoh147l1OR0HzG40aKM2Wz_OaYpHfqfBxMgV_BaJKiEDuI0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xVjWMEinV-bpPfKTTxjcFINPEibRuFXrsaQrJIeSceg&oe=6A073ADC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "04.png", "id": "158033141458463", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162701_158033144791796_2858992031949127680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxDCj_fPbJsQ7kNvwG0rWes&_nc_oc=Adr_UHktvTIJL2ks0UxRSFyUaGCaHr_Maq51j2NnM17U6bg1RZ4Xz8kLo-p1laCKI-A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7At2brZobFoxBa7bxZ_e8kHKLWFWD7OPI5-BNUvo3i8w&oe=6A07411A"}, "display_name": "Blade Runner 2049: Memory Lab", "keywords": ["Bladerunner", "Blade", "Runner", "Memory", "Lab"], "long_description": "In this single-player adventure from the world of Blade Runner 2049, you've been transported to the Wallace Corporation's Memory Lab where an eager Joi-Tech model hologram is ready to scan your mind to reveal the circumstances behind your latest retirement.\nYou'll travel from the memory lab and into strange and thrilling recreations of the future, complete with fully volumetric characters and interactive elements. Within each scene you'll use futuristic tools to uncover clues to reveal and evidence to hide. Featuring Oculus Touch support and a sprawling, 360\u00ba world, Memory Lab brings the Blade Runner universe to you like never before.", "short_description": "After a frantic Replicant pursuit ends in violence, the LAPD sends you to the Wallace Corporation\u2019s Memory Lab for incident analysis. With the help of an holographic AI, you\u2019ll explore your memories of the event and interact with volumetric reconstructions to uncover a thrilling conspiracy."}]}, "developer_name": "Magnopus", "developer_privacy_policy_url": "http://www.alconent.com/aig/privacy", "developer_terms_of_service_url": "http://www.alconent.com/aig/tos", "publisher_name": "Alcon", "support_website_url": null, "website_url": "http://alconent.com/aig/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EXPLORATION", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "335898968436056"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1679782865447957", "version": "0.1.6628"}, "id": "234401500424475", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1666153080144269", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1679782865447957"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "234401500424475"}]}, "change_log": "* Fixes a freeze that happened on some handsets during a Technician monologue.\n* Fixes an 
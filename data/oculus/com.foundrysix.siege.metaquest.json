zeN&_nc_oc=AdoT2j0AqmB14zAHq7VfnFXP51CEJNGm-_wEZWgh9DthmD3gOMNC3-shpuhNWukL11E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20SXtqylfJVoTV8wPlJtWlj3d_sPIWPoii48WYs_skXg&oe=69DA52F5"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fWKbt6UYYUQ7kNvwHSD1WR&_nc_oc=AdpMPAhy24d8p0jBV6V9dlTH0mgbDpGB6yDcWzKuNufuCfiyJS0UHsXh4gQlVOESkB8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nZ7xLdAIig_fOInOYmkqUDOI1lER5tjjZrJxTRVC8ug&oe=69DA4D4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-Jg8CYNRFsQ7kNvwFtlQDF&_nc_oc=AdqwuP7Vz6dK9Kne2oVsN85H2D-qw9-e6u8x1-wS0uv3CLCpH_45zeOIGEZPU8aE2ag&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tM5PodUpK_2RhxKsokGrJ74zKw3fSOr40nLhtJoJM2Q&oe=69DA5EBB"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
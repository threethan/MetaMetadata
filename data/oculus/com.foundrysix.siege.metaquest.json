YFS&_nc_oc=AdqRVKPBXH1v-UlMz9fGWyyFm5HywRrHKgsTtO0aFiVVB2Oz8n8uvAk7St7I5y7wDpo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96UXCwUmcZ-E0nG95C10hcw5MxqDKunY3T7h7Vbjg-4g&oe=6A3FD675"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNNKBL-TxQQQ7kNvwFQfLDz&_nc_oc=Adp8WVIwRd-IC7qbJQfggX3CKEyENXtLLDhihAerItqzouGsHLIOKsNh_BlpIDUNz0I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RzN9n5bel67hGQCn9v5I79_zdSy-nPUdPwtAx48-VvQ&oe=6A3FD0CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwhBwJvnB3oQ7kNvwHm5Iyc&_nc_oc=AdrhmrhQFHV1X-tQeldfoMxjCXExoSOSDtHeCFEG4qEFR0fr7q5GKlFbELTUdej_UBA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af866tzW1mrP-7CXFZ4aGkQd5fZKN9zZkoQLR3ZjY5qOoQ&oe=6A3FE23B"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
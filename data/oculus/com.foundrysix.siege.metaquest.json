5uQ&_nc_oc=AdpIFMPyny9qKYeAvwlscXIFTlg3qTAUR7EtKBEdkVP9IOpxlHkfM7B4Fi04D9VAmFQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9W50H8myyiObKngKzeavgd1prfzD7u8wauWpMx6MSIvQ&oe=6A47BF75"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4cUBF05ikwQ7kNvwHgovic&_nc_oc=Adop3KJuE5xEhl8u9grChVNrZw3O2kPTDn51cu9wbyl5K53zburZzyLRiEBXd6sEZ4w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4LxsuvO6iod4k8lbvc-tUQ-XajP4JiVSUQ20g4zyoFQ&oe=6A47B9CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rbyg7gDD3xcQ7kNvwFdOtbu&_nc_oc=Adp665Qn2aO1mgLyLUjE4Y4cNYgDX3vC7IiGYyMC8w0ZE-UeDqxbzZImKEU60l6GleA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PBavDtx1ZuPVBABBvAaQDd3Im9zeUNmWp8Ne4P7Qr8g&oe=6A47CB3B"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
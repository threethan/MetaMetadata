Jxb&_nc_oc=AdoY8JefcwnTSM4XXR_wQTzD8dsUy4jh3MTg5i98qocdTDKof3z4C30aJAJGrpvTgIw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNlJc7UpEz2ykb4pfGnYE1YtWITZj9Sc9UHbDuGHBV0A&oe=69C297F5"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZ5DokgJ5LsQ7kNvwHqtBzR&_nc_oc=AdplObgBwzxMfSGS3vtBVKdeOEo07ZYAzqra6wjInqLX9qYbwdd0K8HtGGZFF1CLVQY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwpGyCE_D_ZyaN2QOT6Oj7ipJLIxWjH7Zr-cX-m_j4ZEQ&oe=69C2924E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AhTxPRv92UQ7kNvwGLzH0W&_nc_oc=AdrU4eK9TJWZoRhsqaBF7XP83xPPKWbIfAUe6vx3kfooRrX1i_t2J0gv8s46WTP8Qko&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyEE3sB6A2I2NJUFMVc5NbJMVdxj2ZP7D3gqEJ0af2kUQ&oe=69C26B7B"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
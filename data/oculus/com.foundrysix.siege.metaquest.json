CLE&_nc_oc=AdrBhx9RctQtlsPw6VRcMyaELcV-3OVrpNLsdmdrbxqN_3-KPZFloaQ_Zn0gdlsesKs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TKGHJtmvr5kAsm3B0JtCkCDto6M4VBDhAVWHVHMgznQ&oe=6A033175"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLKj5hfkDDQQ7kNvwGRM0HT&_nc_oc=Adq33fMLhlkjkjSsuhixYY4TJOwUH7Bbrw1BSLXqg7MqcoEJTkF0e96XdKtxgBwhJ2U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49UUI1eSqWPSWLLu1_nL9NMBzVlU_hMd8P-GwRg7hNwg&oe=6A032BCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDQqGzx2JgYQ7kNvwG9IUZq&_nc_oc=AdoMkfIuW4jCZS1qJUBiwfPr1yhEoVmvwtRO-E7iq4o6n9q44WB75XgUpbsPEfKwQ0M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6B8oJL5PuxWfLRYmcQi9-AAuIK4mNMPcBLq150ldKf_g&oe=6A033D3B"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
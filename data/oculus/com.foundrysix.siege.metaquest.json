41n&_nc_oc=AdpYgfYHLiHWECjX6knjQI0jNK5d8Qdm_9f9WSlP8Hy5yoxKfm3R7JwdoTaw82qGduA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvpx9pZ6Ca14uiRh6n5Qzt5Lu_nDeISUTQT_E0NwLp_A&oe=6A636EF5"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5Y3c3C8n4YQ7kNvwEq5ERW&_nc_oc=AdojmgO_1e36wrCEZP4BSucTs5iv-k32589969pRBxbU9tmtgidExvJrXijwho4htNE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3M4Jj3EwpeX8Ve1kgblbeowPWjGcwa0mnJoyX-73MXg&oe=6A63694E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TU46m8x3BAQQ7kNvwHnWeiJ&_nc_oc=AdrXO38xlrYltpx7LpgB0DVmFtgcTsyydMbkVfSKu-8nnc57hBj1iE0GtVxQ1AMFmfc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7R8-oS08TgMHdgAp37Jqv5rE2yNOdtkcbKAPz-oq0LA&oe=6A637ABB"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
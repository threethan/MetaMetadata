rDm&_nc_oc=AdoN_2qbvJadH1M54RG4YM8z6O1FxNbM_ryfhSAjE83dRkJODGrn4-A6LzRFlt8zs7I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeT6kgj3VfTr0qeNy1p-2_YsbrcQ7xBf52xEEoRLI4Xw&oe=6A71EF75"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zaYJwWf78YQ7kNvwGRHYQn&_nc_oc=Adp0fHb27uTbpqHxPhBw2jfFB-fgZaCwIGDnS99O7UmUqD_qyjmqwQta7G_KXL8LGkE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAyBxmGtZwf2tehpDiGagtZIVXyj1jutUFN5WY2BeGaQ&oe=6A71E9CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6C9wd98ds_cQ7kNvwGpHsjA&_nc_oc=AdrTTeOp-eDX4WkgW8AfuqFUdB2whKrwspipJw5YC5ViBIKzIKVRP8aMjB3-wRN79UM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEB5aVg5qjyycNGBVDaAtwN9M6WzsnSO-pxFRdxoNMC1g&oe=6A71FB3B"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
236583_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEHIHu1-HvoQ7kNvwHStHF_&_nc_oc=Adk_v6WshorFZG3r_D0ks2_TGSD3ny3p2mxbhoKtLfJjasqptDVWgzeumXgRtH0qle0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu_Yb6T57yqXXAo0VUCmEYqGzua80XwnJl4Yegza1nxvg&oe=6999B6AA"}, {"file_name": "Untitled-7.png", "id": "1748996415685632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_1748996419018965_2226293223821724103_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rnxRBqQv24Q7kNvwGGlmWf&_nc_oc=Adm8Ci0nExW9Pg9VArC5Yg_Cje4meJIS1gvdrv3VEyiTEjA9mE3JbFKc4VCowdDlG-w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfulkDGlELRJg2ITM6GkGIhbxT0IreL7hFkVCZ9dI6R3sA&oe=6999B7E2"}, {"file_name": "33.png", "id": "546193274962509", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974889_546193278295842_6633306432277569071_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzTuHpXp8L4Q7kNvwF_hBNb&_nc_oc=Adnrge3A4ZJOl_SD_y91kqJraRNz6r1Zl0fLoznDyZZGIVGXp7VBiVQBhuzwa37-pVg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfscfYoGe0-Eu9lg3OB5mpCKPyaokFmG1oEpfVacpXE5_g&oe=6999B330"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape1216.png", "id": "899002852436987", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75505552_899002855770320_957531041732301822_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPUhUoAljU0Q7kNvwGdsufz&_nc_oc=Adk8pY1d4qO6rMvZLOnrDcWsa7Nu1zqpkjO0RXZf6FDxbv0TzRtFbXkBisQr9aX83A0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv3k2EMF97Gn2-QiuHieOwFVkF9u6zyPq4yA404C3F8lA&oe=69999F8C"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "4/27/25 Update: 3 New Stages, 20 New Monsters, and more coming soon!  \n\nDefend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 15 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourself with an upgradable slingshot and adaptive defenses to survive epic battles and an ever-intensifying siege across 100 challenging days!  *First 15 days available now in Early Access with more weapons and monsters coming soon!*"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.100daysiege.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Foundry Six", "support_website_url": null, "website_url": "https://www.100daysiege.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29318856931091720"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75292490_1623186072410045_7564913805997461673_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFBr_dY7gT8Q7kNvwHLZZy3&_nc_oc=AdngSYBdrwzrxjriEKDE6ovXZ02m1E0aS1Fj
Qnn&_nc_oc=AdqZFgOfaL8ufJ2oV2V47nre7t92cNOiVwjN3QLpr-Zyn7NeJm3GzH9_tDbVu2jki48&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Z-SjYk1BhcLfmCcBHLhacR6siNtjM1l3EFCLfUldp8Q&oe=69E23BF5"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2hH8TDMckwQ7kNvwHpu3xK&_nc_oc=Adq1E98pHwiwcHaSXwQEqanmkbF8YhDNEOrt3hz8tNKweet-1Y7-xxSSMURotYMGjzc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QVoQLA09ZKgSO1t17hZDTlPASBXgBd8fi-eIDe81YGw&oe=69E2364E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2HpyJWNX58Q7kNvwEtjh71&_nc_oc=AdrH1wrttIsPXqjQAeS6bvHg5_XEZed7TLjh6_y_Uh-SA39b2IrQhnBtP3VPweOBoWY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Rz9uCa-rloQaxbsDbP38CQD33M7eR1LvhmwdjUv2Evg&oe=69E247BB"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
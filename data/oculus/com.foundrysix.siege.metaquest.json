NMG&_nc_oc=AdpBzm5m8ATkg_xsxI97Nbi75CIeMcIf8qm3jqFx4CboKjUE9O_CocxRkMpKbm_ht5U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnKuWCGz4x_dfKGPbMEW31CZeyREhuQYMCqyHPNgzeVw&oe=6A4A6275"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQ11AmRhPsUQ7kNvwGB7Wfb&_nc_oc=AdobHxESARM7DLu2MMxk4UFEcyZ0YNZmtLsV17jKFmkzk4sX7G47RwlDEh9TC3tINCc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfQ81L9oGuQ3O0d3nPVSxQ3LyELk-tT20aUhADbtPg3Q&oe=6A4A5CCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rbyg7gDD3xcQ7kNvwG00W76&_nc_oc=Adru8vrTlTTm2NFDIvcxIoCs2DyzhNtVhxHPYnT5XPmhJnXPWhjsGjvdwUorlguN8M4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMXLhJJhf7HY2GcI5BUM_3OopYiMUKZDMRo4EWWNTVwA&oe=6A4A6E3B"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
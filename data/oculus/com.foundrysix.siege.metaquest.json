q9m&_nc_oc=Adq_26tOsoyJmipGkX0UtSWrvBZKQSArwpXwa8vYQD1wtXvA6ejhang8JM28tcQnrhI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKw-1KfaSNIvy42_w5D1vNaRgTP0pWL6h7lLiSB8DEgg&oe=6A676375"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pg6Sj9K8_JgQ7kNvwF5B3ss&_nc_oc=Adqj7z-Kfj7haVDqq_t9CMty0LA6MCXidi3-M25lFMRVsu6_GSTIL8DSA6EXNsWhE_g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBw3xzLEVIJp2IYzx6qgFUWEz6AW2WEpk4345q9XtH6UQ&oe=6A675DCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mydwmetIJkMQ7kNvwGYHONO&_nc_oc=AdraXhgEajlFhte32yZ--GKHiD6H3gW9hRfxhL_nJvb_rFcar7mUrs1Kp_FXpb8-6yg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBx808G-mXuQHJSVVTVcjAkKfrS161mSEiOy2aL8YM7wQ&oe=6A676F3B"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
90f&_nc_oc=AdoqZe4pay2BnT6gYGAL1TvkWiH36ACDKQWOfGLIfgLM8RSXDCmWhFmq6IuSB3B9Ct8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qHDZ4-kOZ479lZT-3GOoSQW4jeAnvpOU4GN0I6MI65A&oe=6A3155F5"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAeFFyo-raoQ7kNvwHHXnhr&_nc_oc=AdpL-WS0eooTprYmEZEUKYnDuGebpnK640479Y3nule2FdUqB1Y_cX6OWSiGkt7yOqw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-07pDt4IpY308H3eF9zKCtD7JY3knAlLui_oUUjfTGTg&oe=6A31504E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seiGdtVNsOMQ7kNvwEuBr24&_nc_oc=AdqYiS9vZjDYsiHcTCDNi-FxX5MioSdh6QMKtC8wbySoW-goE-QMtlZFMOqnu2icQ4E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eDuHmxXJ8us9e4C1dk1nEf0UvEqeO7TLN0wU-JIqmEA&oe=6A3161BB"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
k9z&_nc_oc=AdrhQpqs1JWgjm7s1k6SbG2vKGu0Emc9lSMNJB_X5lDfe2EVcmDvHE824DNgb5bTyh0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ST6Ze2jkVyIkSaE4wPTvpm2MEqzb2Z4qMNcbiPLoi9w&oe=6A0482F5"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLKj5hfkDDQQ7kNvwGkkC-K&_nc_oc=AdrrCfhc3XFos5EAtGT8Il96Ybum79MNhac_wF9zKkbTWL-qFyQ1e1f0OSNJjrwGhDE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZBWuSSd4plz_rk028qN2w8kGcCxlfQOBUCOzz3fjbHw&oe=6A047D4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=293tOmf82AIQ7kNvwEPdP3m&_nc_oc=AdqSm_Qz7RTk4W65KcfgW8RZ5d1N2itiPQ6UGm-X_3WlrCxreZPCfFzcRcl1AgU1VRk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Pibo86wi_-ZZC0Xd80QyfPDxS8n90mbCRrtcsAZoD2g&oe=6A048EBB"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
bb2&_nc_oc=Ado_pWynMXVEC4f5aIVveY4OZoGAY0L27-sKy-wIpZy6hro3WNKKjvAxwHOhSwz3TEg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3a0dcPI7bZlSgPsjMHwx2Ju3i160R5vFtwkhOTHNtw4Q&oe=69EE1975"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOeY51En_NAQ7kNvwGI34uI&_nc_oc=Adrn4LYZt_a4wddE20qEnP2Pf8yb_iw4oHS1bERPmMiL3Pm8oy2tDoX39EHcJh6UyV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UqaQVldB1OQ68J_BRF85QntpTcxHgtaS7W3VjPm3GUQ&oe=69EE13CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yHYGNoiV44Q7kNvwEtBGdg&_nc_oc=AdpQl7QFkehqlEegylykQMdnIfEufsfisF7hKHgEYcPMbwi48WuEnBpDRcgSlaVV4Lc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PwiWGv2moL-aKPjNo2jIFnLTJkcZr5UMbuMRnkIKrGQ&oe=69EE253B"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
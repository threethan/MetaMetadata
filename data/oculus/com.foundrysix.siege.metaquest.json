ib8&_nc_oc=Adq-kJDQypiT2xRDJaukq_BgyEJHix1tPZ7xOWOEXXAF0AoHQheQZDoQeQdFjnPHe-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xK0cRS1FGlOSKVWSaaNFLr5o-c3uNWHgHNXG8AvRB6Q&oe=6A008E75"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gixc90AOaocQ7kNvwF59Nrb&_nc_oc=AdodozGF99vOThLkpeJxoDQ-_Kmzry_7A3BCBryXyQ0X6PnZhOx9PRnlsAMJtoc7YGs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OY8f2DoRMzKMQ0BGmbq_VTkLOHm7rLVvTZ_u4r7ZATA&oe=6A0088CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDQqGzx2JgYQ7kNvwG1mMlG&_nc_oc=AdoxAWiwfXfOhOhxorSovq5QG5mJiTn2FOroNezXmYoi5WC11qW55R8ClcBYcvaSiTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_Cr0CM3nPLrcKvjPfr38ApAnv7Sz1E6RY3GRSG0INxQ&oe=6A009A3B"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
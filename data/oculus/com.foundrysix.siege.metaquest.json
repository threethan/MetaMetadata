OK5&_nc_oc=Adqj3ltaxl8U9u_Hoce-ZIQsxV74NiZxwniyZIjJqSM9X3Kn_H4w9xc_BXPXayib9L4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zV1St7DJhSnxW_wlTwWNSJOqLo2Wp7_9zhhPR504WAQ&oe=69E63075"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0ncHpS_rSwQ7kNvwF5CmBv&_nc_oc=Ado2izru89wdbkE3PztGHPoomCYcRRhA6mhDuvekAySUXGm_vNzURkeXB5QeLUBaJh0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08B9hmHsK7EF4zHdAoaMQRL9-3d2IHW4DxV_V5JiOXag&oe=69E62ACE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdV1WGeKFLkQ7kNvwFLuLzN&_nc_oc=AdqT2D1aJFgmBzyOZrZzXKEU_tUy2PDSwOUdEl4eSbhebYJ_KTlXR5eKEDC8K4Ov5zk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0s6X3bgbP3Rqozm0loBpQwQ14wP1B5nfj5Mozk3O6vTg&oe=69E63C3B"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
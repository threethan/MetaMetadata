EfM&_nc_oc=AdpmQNB3s9T1NORvvFGOUju6utbUOoG4g5e1AGMz3H2NAiJhAugJB38_a9Saamj5dL8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gPe1bfcAWK_yQAf-fL5ysF4fHOPXbmLKC5x8KeRgUwA&oe=69FB4875"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7vjeUO2FQMQ7kNvwEK4SXM&_nc_oc=AdoK_LdmNF_DUa2Hey21Y1CsV3tnTGUchCmGXtg5pXiR9IYr9aHBc2ZYu6GSy0bkDiQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RvEXNnZQYp5-WJBoa49iKjE_TQAVf1aYrZEbyD0iapA&oe=69FB42CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nimMOYSQ3voQ7kNvwFZSpPC&_nc_oc=AdqkTJyRjxtMzET_DNzkkV_X-c8SP-vZhyFn4ereKnTHfPhR4KN5Prj9Ef4lw1Mmknk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wV4J7t4UHdSVaS3Ku1ScJhKmwxHYXZfMnEn_1dRVKvw&oe=69FB543B"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
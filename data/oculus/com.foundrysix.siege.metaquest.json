lLc&_nc_oc=Adr8CcyhQzmMW1gJTiQ9b8x7gjBwxHI0cHu3CukcLla7-QIKQwZO5AFOoIYwBrb3_L8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ed2afiZz4cb2grjoGajUX-cVYA_gEoSU7bvCZJrKUEw&oe=69DCF5F5"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fWKbt6UYYUQ7kNvwFfLODh&_nc_oc=AdqVlhPmCnZqZLMGAjSfsoVW8iLEskf92u70uAKRYye63myMYq4WsAMSgfca3HDmGG8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2So8YqZTkRQjzmZaXvOU9TkEV6L_h7JD9URWtOYcRdAg&oe=69DCF04E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTria-xsUXgQ7kNvwEAUCGn&_nc_oc=AdrpqOXZRSrk69MB9Rrlh1J89wLnnnCEpS4KDOSLrqQKSzuj0QCr3eBHmVQbNMypBKE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lC1Df6dQDij8AEV2aL_Xx0Db4Z3LVB6HfAcVtfD1LYA&oe=69DD01BB"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
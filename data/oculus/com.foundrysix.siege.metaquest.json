hee&_nc_oc=AdqMVm9DWwn2eCsYRo9lw2408qzqL45-PnAy-m9dxNHn92JRBnypfE2vWGeivT4R7yg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af806dRLaQwcJehA_1Ff0-jx9HxZGlwVrhj0ZM10w3mToA&oe=6A4127F5"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avSb6BJVuvoQ7kNvwE03_gO&_nc_oc=Adpdmjn4Xf-TkauX8uc5bizZiga6HMUCLI3utd1uwlTeBLTkOyBzS0WZWFIxX-byBJI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_j1z0O_3vEgu-CNHCW6pIZ5sXYV3E9Ouowm6wP0tzOlw&oe=6A41224E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwhBwJvnB3oQ7kNvwERqzuW&_nc_oc=AdoUJxFC8EIjcZWXOFBbZvHM2GUjUQg7ls4vhTpopSh13VcyffKPs2W4X3NQYuGmRSE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rYTa7jQl7yKSv5XbrS1gv-ag5fZIGf7rmVkz-0a2LCA&oe=6A4133BB"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
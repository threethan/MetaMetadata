ZHt&_nc_oc=AdoP1LSRoDh6Wrf30enNN6CzH871JZnbqKnz1fBziZ6JNBG6n3u8hDl_1BkWrvR08mg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3tG_wUZq1cq3_HhVAU-HQ6P-ek4sgriYUqGxzKFbb7pg&oe=69F35F75"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jzgx3B_FbZMQ7kNvwFNesfm&_nc_oc=AdrlMEavN67hvSsDZSxupdwDOAeMRAH5zBbN6PtY5rqraC7GL3lPTKwMaeVgs7dQaCM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0geNO2f_PwZC8PHDWeFlPqZNiD0MKvrccKUXqJJaLf3A&oe=69F359CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrXiTbFbcYwQ7kNvwHIcB2k&_nc_oc=Ado4CX4P0QvyqaQTABdA_W8E1X-OKZ2oOBGwBow3F_yV6c10DXqc9eiKHWujlzShDWs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1KU0jw8w73BPkltU7olZxfWBkxFl2J1N0KQP6BToI14w&oe=69F36B3B"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
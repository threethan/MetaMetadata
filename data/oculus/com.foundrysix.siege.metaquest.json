aQC&_nc_oc=Adp_GjUsjuy-1sZ_zFyRqth54wYTKcYlC7H-oG1PjGJvd5B78nWbwjyDxLExgHBgDzA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1elYVtsA0_e983tyAwYPMl2mBPZiMauSRYuOI3ENOcnw&oe=69E4DEF5"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2hH8TDMckwQ7kNvwFtRwtI&_nc_oc=AdqrC0hVCdDUkfo-wqmuOnl4qgxbgtcQy_SaCTtFlHshAU9xYsUaQxQ05-gvh5WFsT8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2grkrpOX1GGattuVCnxyd0N6VzaF16rLgTkBv1VmMp5A&oe=69E4D94E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdV1WGeKFLkQ7kNvwFq1nF5&_nc_oc=Adq2yTghEnvECxGIVMXWTJBnO-3RYqD-B0APnLxHX2rLPXzNEuZxgrMD5k-AksVpnjA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RIPolgfqNdznIS1ZK0Bv2qNvPrkihcQj_Q_aGN0ANRQ&oe=69E4EABB"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
rJ9&_nc_oc=AdqfNVuPyQ-aF58OXbQJ4oRPWiXQ8K-mQQsPB0vT-2d462w4DeFZzuK0ZLqGcrd1Mgg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZrcd5j5E42aMDe0KR_wyUnjK_VULoOplSVXaSAk4YuQ&oe=69CE7575"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGDOcsXXcasQ7kNvwGX9WCY&_nc_oc=Adql_97YR5xNpzPfh8LUPHK-vuLNrIvv9xrRLweVu1B5IVsuFloQauMxA1Xp3m2CDK8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwv8KegHJHcHZxLaFOQqevSGjdgdALMaOG6RyN_zra2oA&oe=69CE6FCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nh-wJr6TLtoQ7kNvwEUzahV&_nc_oc=AdrztXFn2Rs6sYIfS0k5GdZWwIlsmzu-qxgSdJ_5nbyWbUJOYYge6O31KE_gPnSe5yI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwyihz4Pd6ewJOFYNcbJAphaNxqE4Kpm5cAPpfOYZBEXQ&oe=69CE813B"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
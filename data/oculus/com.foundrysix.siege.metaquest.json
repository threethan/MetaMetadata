RHk&_nc_oc=AdrFdZOeHCGAuto042hDVlsjNZuJGxI34Kj2yIuqRK3XgzWHYXHpAXMerBrxBsUi9O4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_DK_WNbwz2vV811T3yrGK8-xOywfufoDtdLMa_O6H_w&oe=6A8820B5"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBSJO0eWQxAQ7kNvwFQKIFG&_nc_oc=AdrY2PIyhaNTdi5hdPjq0-nZnI8R2n1ekhTD92eMB8UVg4VJ6V1DEhWWO4Z76eE5-rI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj2TO-xhIHpwvKYH4Ut9nuFD7RuZQNlfbd78ZKZYANVg&oe=6A88534E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rd1HB28fRr8Q7kNvwGsYmlv&_nc_oc=Adq3K67HKdS0xYsqBZs1v7X3sBcDk1O0YvAnbJV8yAtef21RTuLUZ03Ff1KAHIOIBG0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAwyP4Bs3GPFzn1XOwCKjnpxItFFl4mTz2WtE0lANqsw&oe=6A882C7B"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
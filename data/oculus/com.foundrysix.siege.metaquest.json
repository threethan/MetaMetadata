666105366386741", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820470_666105369720074_5905926154882236583_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9iGgpj_IlkQ7kNvwE3TBq5&_nc_oc=Adp_Eb-rP2q1XgRCyEaHjguWNP8GY8hmUvhFTanAHYIk0PMLLIoxY9dughVMKojgLy8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdB8BXwGEmOGsssIcV3bG8wuAaQTZzA_ytvK_UUaNRDA&oe=6A578EAA"}, {"file_name": "Untitled-7.png", "id": "1748996415685632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_1748996419018965_2226293223821724103_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gpphgCD8hUQ7kNvwGXd3Ja&_nc_oc=AdpjZdxUnn49Nsz1C5DgoVuLkVUskj12-zku2RPBCKKG6bRErjA51sO4ghxuqcZIByA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA39nKIBz_WjBx084QnsG6SjQLV1kVidoMq3GDfvxYhVg&oe=6A578FE2"}, {"file_name": "33.png", "id": "546193274962509", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974889_546193278295842_6633306432277569071_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soDZwLghKEEQ7kNvwFsMUn2&_nc_oc=AdpqoBUWR2q3N5myDV3zQslp5qRFiTITfhJvQoHKZNNh8Q_EreQEmFcbOW7ElCQFtoU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIHu9xJ3AXrSyGMaRKuj1oisCM_IOA4TBZEPrDG9U4gQ&oe=6A578B30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape1216.png", "id": "899002852436987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75505552_899002855770320_957531041732301822_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzANHh4GbosQ7kNvwFkDSF_&_nc_oc=Ados1BAfzSMMDH-4jLtC6l6smB_K0Evk5-b686EcFlTlVNSB-hqgiCbAvN205jLLAqA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfUziMq7iAq8HlBn6OxZifkNLk0UXizNVGl7x8pfZMAg&oe=6A57778C"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "4/27/25 Update: 3 New Stages, 20 New Monsters, and more coming soon!  \n\nDefend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 15 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourself with an upgradable slingshot and adaptive defenses to survive epic battles and an ever-intensifying siege across 100 challenging days!  *First 15 days available now in Early Access with more weapons and monsters coming soon!*"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.100daysiege.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Foundry Six", "support_website_url": null, "website_url": "https://www.100daysiege.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29318856931091720"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75292490_16231
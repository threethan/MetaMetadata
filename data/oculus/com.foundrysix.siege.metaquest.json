FtO&_nc_oc=AdojAmOWzkBR4czpM8sgXMCGaRFhHw5bKQLDl9pABibNAwVvWbFGiC7YFMCOEo1Ic-E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fJZCkJyniWQOK3w0gmL50r1hxq-PTJXyDtEmJ1J15nw&oe=6A37ED75"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vnaNWWLLtkQ7kNvwEdd9qJ&_nc_oc=Adq6RrIY5cI1_jfCriNxWjG6Fvp0uW8yX_adkXWBtupJ00YVg6hnnyv78lk2tUnREjU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XRa4YVOroMA_hRt0ib_9wwRTmED_TGLKwBLxwFqofgA&oe=6A37E7CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2Fdmft3qR0Q7kNvwGTiryg&_nc_oc=AdqXNw6cw0AKIRv1v6IEXAUm00gw_DZzgLRWygDBXCYJMspchXE1Wv7enKbWumWnRfI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--nnt4UCpAbzK50BBNCzSQZ52ocI2Y-kBLSARYduBuJQ&oe=6A37F93B"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
jSv&_nc_oc=AdosiFUSqfkvKrN3yMPkDwmJtviEhyaY0OgF9zQXGO41VVFY-_WGA4UeZCf2xM762Zo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzERFEIEgs2L2VdOCYYi2aCaeFKfeU6y9p5iJeUOIxh_Q&oe=69C53AF5"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZ5DokgJ5LsQ7kNvwGNXeFu&_nc_oc=AdoTC_SUVUj5fehMnhFVI45tZeIfwTNQUc24eY8aDo3PBLt2TbpymOd4Mb-fgamwY_A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgJCsfYhvNvK-RnIRiTPopyKjQ0V2vUrw7jPbs-i545A&oe=69C5354E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9K_sJ3KRupgQ7kNvwGONNyc&_nc_oc=AdqMkCeRaekPRz8nfv9FNuErfrIQBXaIW2o-R5cPIsvq1D0AvTPbWA1bxP5-gnlFGCs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBGnpyngcJryu1yr_o_4vG-2w72bmvb7BgJwSvJAGPmA&oe=69C546BB"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
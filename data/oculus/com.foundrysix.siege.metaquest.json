yv2&_nc_oc=AdrdHvBu2lc0Xz0bn9I3u11t_NgNM6QUryp1s-vqVebFGyhKTygVEoIAjCzVk4fejXE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzvEo-wDo8Sunql4oPwD1ajKJUjCWNn7V8Tn306gsoewg&oe=69C68C75"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyTu5YdLRwQQ7kNvwGUCX96&_nc_oc=Adrr1ulVHmivSwPYFXw42klRwKMiqlL2iyedHuQ88aFkO32r1XuPDxoCywDAsBLm4b8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwnJhWp0Zy6BnHBmYllBKlZQENSZh_mZ8B8uq_h-Nz73w&oe=69C686CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9K_sJ3KRupgQ7kNvwHDOelc&_nc_oc=AdpXtfjUHjqydTTsoskp4Gp2ClTL7UY1A8tI_Hg1W4g5jLgCOvjSbylJ9w8WtxfQjtY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxqZ9F-RMKjcQQKoBQvfLNIG85sf4iJr1VUbhbEHgukkQ&oe=69C6983B"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
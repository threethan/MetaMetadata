QXC&_nc_oc=AdoYg6ngybff37ueZUSmy2d6aCvZo4iSMcEGZaAzurLKPWMSJM-dcWwmfMhVQfcvoAk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1nLoX51-ivcriwirLnuts1A9cxBD17X6CipiRY8r2aKQ&oe=69F753F5"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIvjXR9eL1QQ7kNvwF6kq1R&_nc_oc=Adq987yyRKwd5i_senGc7eLH5qF2S7prpWtaSm4-aiL6O_CfPjFfoQNb4se3_s1CLPM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0CoJzWGvopRnNG2L-GmKBbMrGRBPHtSaKHtilMMZuGxg&oe=69F74E4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwyngeNYc9IQ7kNvwGU2Xnp&_nc_oc=AdoMAHh3IGjp5tbERqltRs-SOGXnCylTKXtvqQfqD44wESf8c932vdvRNTnWw1zPaO4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af33pkjroK1v3yyhMIC5PC9JK302l14zqk_XASuhmgHV-g&oe=69F75FBB"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
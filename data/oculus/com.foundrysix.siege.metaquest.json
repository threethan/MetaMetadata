Ojy&_nc_oc=AdrE2LCNXxqg94Fax2ozFnitAuX4RZkP1pXCwI8T2pbOpfcQmLQEtl1XHP6DI9d2-G4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsf6p8cgql2J4sCS9JEA-s2c9pclBfwMoz0kKJ6tmLCg&oe=6A897235"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBSJO0eWQxAQ7kNvwGX6_ku&_nc_oc=AdrRYZVFNqZL7WKqCVSzVWrHsqNBZS8MxlOO_LTMZ8DG1rKgT5UlwChNhJd1tGKBNFI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOOjodlGN-t5OHKnPUhhcGiNuoomkKFYT6U-CrR8C9jQ&oe=6A89A4CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rd1HB28fRr8Q7kNvwHK_Qod&_nc_oc=AdpH320Nch051TGvaoQkW3jNy8vh39Qw5WUWZU3_S7QAys67uOfq1Po_unviULzVg90&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzWJpryAFJZhWSVDfIqABMXavU9-RlspyFvZeb_PR20Q&oe=6A897DFB"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
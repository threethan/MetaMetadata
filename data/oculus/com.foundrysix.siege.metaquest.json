PO5&_nc_oc=AdpTHABFfPEHuxHKbHJB45d5r_7qlMVSyOx2dNqoMfg1-EFXzN-QtqcPmhhwjAa3wxI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7vbFb8-AJqrtWICxDsxT2YJMYk3Qn_fuSf2SOReWN7g&oe=69C3E975"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZ5DokgJ5LsQ7kNvwFdBNr6&_nc_oc=AdpzjbHYJTH5vYfD_27cGQgvIBvtGmFy0P1bjY76-lwIB3tss7b8PDATS1XgFxnMGmg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxNug-3aLb7xKSWE-qUVIhZzL_zbCOwHbo0lZTbYCyIAg&oe=69C3E3CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AhTxPRv92UQ7kNvwFXF1Bk&_nc_oc=AdpKSOecSWcJPu58hzJq7or9TLXwyfcq0qJgp9w4Hn8UOo3aIjkVxpCMx9iMtQV3VBU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzaVZoGUO5Tc5rsLr9T3Z9p8tvLVuGNst4pyPElY7FLig&oe=69C3BCFB"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
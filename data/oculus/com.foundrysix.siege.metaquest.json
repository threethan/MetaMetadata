gXi&_nc_oc=AdripgHa3WCgt5-3AujZ5cDWhzLgIR77GHwwz-1RofNHmK2Klmx5TBDJleWG-ajVIzM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-437Nxs1CXhZH_A_aMmCOVmQsMqx7nRIA4BcxaBt1xA&oe=6A7340F5"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zaYJwWf78YQ7kNvwHQ0ZZ0&_nc_oc=AdqcQpCtf9fYWrE8RIdEY39h-zXEhGVFtOFow7ExMD-0DSiNTtGP7GtJEZYo-08r_uo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaYyM5U2lIEIwM3lHyaoVHW0ta81BbXeLPs9Y-3ZtjIA&oe=6A733B4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2459u2TCmasQ7kNvwGDnt_X&_nc_oc=AdqLwbfTcaF8efT4-GpI_v95xZj7dDv1PruiqCq3kHn0DbtbpUHF5HofOxZV5iMUSFU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlCswJ7rV35Vvyef9nSbI5TpzC2FkL000816uWhUtogw&oe=6A734CBB"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
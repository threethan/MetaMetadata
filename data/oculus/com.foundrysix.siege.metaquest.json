666105366386741", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820470_666105369720074_5905926154882236583_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XgNZsy0n5MQ7kNvwFAeDg0&_nc_oc=AdpOzHKUEffj8_ycoAPfp2iWJH9KoiUIHm61tGnTcIBEsqZS7Cs02ojVgaGxFNdzRuc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwzYcbxwZxz29QX0iCfm5zr5HtzsKW_SgaASVgNycXKkQ&oe=69C7DB2A"}, {"file_name": "Untitled-7.png", "id": "1748996415685632", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391967_1748996419018965_2226293223821724103_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShNZ0MLUjN8Q7kNvwHxg0is&_nc_oc=Adq2jcDKn6tAVcMviuZsEVHNRiVRjwJ_N-BFsCsOMhx_KmuccvDGpIrnWa8IN2c1FOs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyzjFU0MMS2zJZgI-cDc0GU3H_pRIEJPlXWSJuurxg9gw&oe=69C7DC62"}, {"file_name": "33.png", "id": "546193274962509", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974889_546193278295842_6633306432277569071_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KixNtD5GcMQ7kNvwGRn8Vh&_nc_oc=AdqRvL_NmUGoZonQBVRvvydYqRWDXZ7aLd0gDeOLksyL1jvJWQINpLVQsYLTmyRPvHU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhgzeOphcDUAxyxQ5pssqEilOFsY1k4rXiKy4rx2qMpw&oe=69C7D7B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape1216.png", "id": "899002852436987", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75505552_899002855770320_957531041732301822_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40lJlRyotCMQ7kNvwFW4m4L&_nc_oc=AdrbkNhMevtWFq9IySxzda9z1RdtzNHc5BDnx9fEaUWyKgdoTC5hopCLh34VuJf1Fnw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzfm0Y6p71JafOm2Y75T8Ml-nqFNtvRKa0c6PkD2GzbYQ&oe=69C7C40C"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "4/27/25 Update: 3 New Stages, 20 New Monsters, and more coming soon!  \n\nDefend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 15 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourself with an upgradable slingshot and adaptive defenses to survive epic battles and an ever-intensifying siege across 100 challenging days!  *First 15 days available now in Early Access with more weapons and monsters coming soon!*"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.100daysiege.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Foundry Six", "support_website_url": null, "website_url": "https://www.100daysiege.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29318856931091720"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75292490_16231
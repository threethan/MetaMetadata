_aQ&_nc_oc=AdqAOTDm-klpV8aFvhlYffWPeANSXGNHltUbyVFW6y_GUPmhM2D71nTNq2sTcBVaZw8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKYDpv_0Yl3XusnaNb2qjPsmjsxtrnukMmgKWJBLwUSw&oe=6A58E2F5"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAGENYhUNeAQ7kNvwGtrr9q&_nc_oc=Adrmmm53UGNbFvojyTS65HJjDn3cLoemygSaAeATo3s2vS9_npsfx_UX8SVLaT0C2Vg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDADibj2_7a4iIsfOMvxYYwIJAXdrbORpDoVnPbzUVr0g&oe=6A58DD4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4Q81WIufCsQ7kNvwHrLcKG&_nc_oc=AdpntV6fS568b3xVPoUO1_GQUzw5mjqQLTMXDm2otMFpTtMd8LQrCHDaap_T2bzwYAo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHm2ZTbAioBCXM7LP6D1NOTs9_Wane0X-AFIrC_IAbAQ&oe=6A58EEBB"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
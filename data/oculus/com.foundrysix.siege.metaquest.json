ltQ&_nc_oc=AdrznaZlVanOb-xf_YFITMF112qztloZ7TVkjGKyvX2vZquxsqpYWFSK6lessm6yBlY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KVH8jxG65p6Z99LOhiZgBus2dGvgjvjup5LE4RpF_gw&oe=6A087775"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFkix_VOa_AQ7kNvwESGfej&_nc_oc=AdoRGTvHKAvWpd0UDaPi4COUZL43KhGXlTfPq_K8phAIqO1CN0QAbCBPb-0rUTJNjc0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7r308IDzhz9T84CuhlJG-9p4hcgWfFDJ-KXI1CrvL0XA&oe=6A0871CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1MJrdmmTgAQ7kNvwH6wayd&_nc_oc=Ado5jKW5lKAAyWLab1JpBAJYM465eLWskDNDlftLIQXozen63F9nq7PXPDS7jf3jSbc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Cnj5p_Is0bD-6IvGKYNhLOq7sExPhqBS6tZiXUAdSpg&oe=6A08833B"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
_0i&_nc_oc=AdoPYrMdhiO0wXliBr3OETZCcAueRAWa0SmcKtiVQi_0axa04E4VzJGDQ57l4vTd1Yk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpOc8PgHD2dBhoLnzjWgx7_Fk7UP5sUkwGehrflL0JQA&oe=6A9EC275"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1W_xNcEzyXEQ7kNvwEZN_Xq&_nc_oc=Adp1_ozzBpOsYPvKhSfg3NyjtnE5eFNMVDaX-1ESQumSCHMeWjNoztd1iIM0vB4xMmU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIalUAQNtnVU2JAsLPqvzR9jBKT1LukiHNQGISZemdl0Q&oe=6A9EBCCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6AuDIZOZYUQ7kNvwGZx64o&_nc_oc=Ado45jX0pnkZcjnLU8_PB4w2PmjOVWof-O_XRfiy9JgG-Q9wqo2Rgxj1TQTII-vhmv8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKq6y1NmTEjCvp0U_9sGn5Me4dpyCsmevf3tpmOMmNzdw&oe=6A9ECE3B"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourself with an upgradable slingshot and adaptive defenses to survive epic battles and an ever-intensifying siege across 100 challenging days!  *First 6 days available now in Early Access with more weapons and monsters coming soon!*"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.100daysiege.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Foundry Six", "support_website_url": null, "website_url": "https://www.100daysiege.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27301584149485685"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1049613000812141"}, {"status": "PUBLISHED", "id": "1761687818185357"}, {"status": "PUBLISHED", "id": "1038429018209077"}, {"status": "PUBLISHED", "id": "3947388442165067"}, {"status": "PUBLISHED", "id": "931837372258631"}, {"status": "PUBLISHED", "id": "9048965315163793"}, {"status": "PUBLISHED", "id": "505302735863848"}]}, "baseline_offer": {"id": "505302735863848"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1049613000812141"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29307063978937682", "version": "0.1.3"}, "id": "1483097465612779", "channel_name": "LIVE"}]}, "is_for_oculus_keys_onl
lJK&_nc_oc=AdoT6Ha2PN12M6ztyPCgzUFeIuK7HLyGWnqXbsTpWdgsg7OWClRozdGGb8wNcTZ-vVQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLAPxc1dUZWzuLWOb2snG31jiJNPW8PoUOHLqhVFKM9Q&oe=6A6611F5"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pg6Sj9K8_JgQ7kNvwFpcJit&_nc_oc=Adrn8i37emi-6lMLSf-iT6b7P1TOccndrRuqJ-cIuBqG66UF9fAMVOtGFtxwrb_lb_0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvbo7MEVDGeHHeGWWFObOEXUlbkF3ngcHREGEF54Dt9Q&oe=6A660C4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TU46m8x3BAQQ7kNvwGDxNQW&_nc_oc=Adq2dmiH_-WRgFDkc-7QHXIcq-fMiZrRKCy_rMPiI9wRG-mZDe66wWDukBN0ZbcgoZY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMbVyHGvwIAahpVCwkXmt3uywwPpc-uV7Sk2QV8YKP1w&oe=6A661DBB"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
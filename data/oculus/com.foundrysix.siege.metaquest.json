236583_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUmmD1lYWssQ7kNvwF6_m4E&_nc_oc=AdlCOaVqFw3-U93ZNXNYBBcPKkhOoxxX9Qn7QN0imjUIQaaag2ggWXZsWQcFZy3h3So&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuiULyC75s_NBG6vCAyCQSiKp_hIQCmoFE5qMlGec5s8w&oe=69A5942A"}, {"file_name": "Untitled-7.png", "id": "1748996415685632", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391967_1748996419018965_2226293223821724103_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9ILFxa494wQ7kNvwFjwtdN&_nc_oc=AdkSZjhUjuzMADxkEpX-hADewzLI5GW7TA7fN4wMzMd-7v_DGSf68Ik0_Zpj_r0tNOk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afujowob8laiMtOX-kVfGGaJmt_wm0-44cz38rNTnO36Iw&oe=69A59562"}, {"file_name": "33.png", "id": "546193274962509", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974889_546193278295842_6633306432277569071_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tylu-Ant_b4Q7kNvwEhuykg&_nc_oc=AdkMJWtm26oVXFRk4aebXMAE591C6Zvmm055ImOHehR3RxVsNyDeuzHSP-m5akeGDhU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfueYm55kvhhsig0z3tb_PgMV16uUPWEVIUY6dfEAgg6Tg&oe=69A590B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape1216.png", "id": "899002852436987", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75505552_899002855770320_957531041732301822_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crjIVtDE5x4Q7kNvwGnm0o8&_nc_oc=AdnPBTcNP-gT86gNcNLKMGkDAQi3LBG2TRvZPZV4GzhTJbkADs-G8BgAKkkjSNsQBBA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftuRr13yQCE-M1RbmvJ_sWzv8fCwZSKtmI7mw0v4Q8CPQ&oe=69A57D0C"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "4/27/25 Update: 3 New Stages, 20 New Monsters, and more coming soon!  \n\nDefend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 15 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourself with an upgradable slingshot and adaptive defenses to survive epic battles and an ever-intensifying siege across 100 challenging days!  *First 15 days available now in Early Access with more weapons and monsters coming soon!*"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.100daysiege.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Foundry Six", "support_website_url": null, "website_url": "https://www.100daysiege.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29318856931091720"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75292490_1623186072410045_7564913805997461673_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrjDEWl9kSQQ7kNvwGp2oVc&_nc_oc=Adl-J72K3zHyFVJ0QbyaZqS36qP4fspKVq6c
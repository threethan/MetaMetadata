oGd&_nc_oc=Adpp1R7ubPOydjU5LP2WskZqYRlna27vkNJWgtTfLUE_e4kjw7Rijp5IXuc2SAQsAvw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9iycpDwwfHWxcsK_pxz7fvG3dWT93EcrXIYEFk09j0Q&oe=6A3D3375"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNNKBL-TxQQQ7kNvwE8R-d4&_nc_oc=AdordVUTH2xRPs6Z3UdS6ReUfKp_RW4WIaAP3x6ZgledA5xoufZvCKj-cV7ugOvKJKE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9G6gLeqG-rNB77FBGo_BUz0Dh6Wjew11Y2o-tyJHhUeQ&oe=6A3D2DCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykD5JYci7ugQ7kNvwFnAFtc&_nc_oc=AdpVXNXGDqgMFgQITrMKw3EnaaUuUnxbdkKNRlxXC4XHPzB5ZQmMCfJ8jlrYz32wd-Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9d8kODaB89oLg3LCdlCpHpf3p3KzsotXuwSFDfPOaIQQ&oe=6A3D3F3B"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
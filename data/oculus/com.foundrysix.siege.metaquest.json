0x0&_nc_oc=AdrWCtRpOuE2m9gBFhSNJeFwXLOQKU9rmjvOHMFSSnZ3XfVGJ1PA-ReDxOwCj3KGiac&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyV4qtM5EJPQNkqj6Cb6e3g3iHKZb9n2_SAIXiVv3kpLA&oe=69C7DDF5"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyTu5YdLRwQQ7kNvwEsPy9i&_nc_oc=AdpK0iTfJOUe8lDDx9qFG7FI_mtYISzjlsPdEfGvTvkDrTpWx-FOcPd6lacyi_fohTg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHTY14eCQerKo9zaUhW7JiflIOR687Cq29Z-xbxnkIig&oe=69C7D84E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9K_sJ3KRupgQ7kNvwGXUVzC&_nc_oc=AdpTAq3MF5nM7C-2uBVEt4wubm0DWiQZ97CH52-YvO1KzjDaRZk4tGge_SIYPaQsI9Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzI9BbLp-mE9i2uCCbpReeLz-13LZE2WQuBzlLlvoSp1w&oe=69C7B17B"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
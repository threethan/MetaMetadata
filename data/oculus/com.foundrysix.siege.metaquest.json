666105366386741", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491820470_666105369720074_5905926154882236583_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ez8NrTMiSe0Q7kNvwGPZPpP&_nc_oc=AdoDOb8o8K0nIx6BS_UnH-sdpsoZ8vhKOPEqD6bfKvBnx83wkdav4GF2aCzyNy-xc8o&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSCfGSVYJ84AwFqp0O-_yvchbAfqVMFC0Vc6yUQKy_iQ&oe=6A93FB6A"}, {"file_name": "Untitled-7.png", "id": "1748996415685632", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391967_1748996419018965_2226293223821724103_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiCm-M_Um0AQ7kNvwFmJ89A&_nc_oc=Adqf3oi20M9nxQ88310Fi7Vc9CzH3z_gtzAb6GP70YEXSCFPccAq3AogW3ISxE6L_JE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8Hkbo4EVugN76gomlstztYdTCKFRkXmrEN_oJRCvoWQ&oe=6A93FCA2"}, {"file_name": "33.png", "id": "546193274962509", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974889_546193278295842_6633306432277569071_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6n_o3GPYNwQ7kNvwFGorCF&_nc_oc=AdrDCycWxbcTb071936cwXTjj-GBwWFjT2jkbGMZrZ9MIoDJ8YZWLmJyzzbakgRxTOc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6TS0Ry56-1iM1Btg45RG9nuxmCZ6bQFe5t_XGE5udnw&oe=6A943030"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape1216.png", "id": "899002852436987", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75505552_899002855770320_957531041732301822_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnjFsMzJAqcQ7kNvwEZjn1M&_nc_oc=AdpAArcltTEq2QV66RFm-r0hVP3GHH3W0Ok8BM7qJQLECEO5qyNZ3Zpuqxv2HUyGNtY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEMfpQLFnnlRuaM1RMBcqltUH25LeVHZrhChmFZMOytw&oe=6A941C8C"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "4/27/25 Update: 3 New Stages, 20 New Monsters, and more coming soon!  \n\nDefend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 15 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourself with an upgradable slingshot and adaptive defenses to survive epic battles and an ever-intensifying siege across 100 challenging days!  *First 15 days available now in Early Access with more weapons and monsters coming soon!*"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.100daysiege.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Foundry Six", "support_website_url": null, "website_url": "https://www.100daysiege.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29318856931091720"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75292490_16231
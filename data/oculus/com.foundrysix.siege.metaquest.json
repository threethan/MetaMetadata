YpL&_nc_oc=AdokvJDy2ysrLNAub354JoNBgKtKVWaEl0cifr1vLn0hsW-kps1HwcbhZSYoZKhQYZU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtGYwljbWI6VmZWcmrjAo6BZn42cfPlEberCTI1Kd9KA&oe=6A64C075"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pg6Sj9K8_JgQ7kNvwELz4-n&_nc_oc=Adqw0iNluOC_h5_5JI_rvtqFt6sycgYO7n7ISe2BIL1AZ9GYF_1mbB2dppBWlXwnH0Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCebkVR6SUIxvwTbTYj4be6_xRz_6mKW5XXGrFlJbZUXA&oe=6A64BACE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TU46m8x3BAQQ7kNvwFsNIji&_nc_oc=AdrFDWKPxDjB8XoSt-XssEPFtBB-ZO1UNG5Qb698657jVy9Pgdx69GxEz0t5plFIuiA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbiSynMgWVV58SRqEgWFIPGhrMrHxrKYz3zUkFnDbkUQ&oe=6A64CC3B"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
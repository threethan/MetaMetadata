tKh&_nc_oc=AdrWrTLwqha0SrxuYS0pBsoawBGnMRCw2PIMAkykObeHHGPZi9UqNIjO_VJ7CeQxsOc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkizn733A3xCkU8paclA_6XjlRB2XjFSGSfML2x1dLgw&oe=6A563FF5"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMBkDB6uewkQ7kNvwEJWzUO&_nc_oc=AdpQeD3C5n52J7Slq0L6v0Qde2Q4iQx8wPqCaP5RHV7mDd8OLsJXDl-OjrVOJ4_nPTQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIJKBlKgvIbXf1AvsuRw6BZRi1oDWz0HbqtODZ9r4gVQ&oe=6A563A4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQXSKDJctNcQ7kNvwHqsXzN&_nc_oc=AdqVMdcDr-Nb0ULoWBphFeCAERSB5g53D8rigN43yk7guT08ztsY9YDCdGQRLo9zolQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDc1c-4hzmpARA0ZC6SDvpjg9AVjcFpbZK9yheIU_fUoQ&oe=6A564BBB"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
dWj&_nc_oc=Adp_M39yjVazlEbYZyiD3GDHahIvHKxXUBbyFcLkFBG1TPZ-ry4-ouhpE5Nr56C4jlA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kifPStv25uFROAnIwH7xb8nuxvpZlEZwUwx3rv3s4uA&oe=6A106075"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXUCfRj6NRQQ7kNvwFMMvum&_nc_oc=AdqJiiIQKFwyPaL8JMUdwG_jn_MDihp8VpT_q_lDOH-9cI0XI0xPitDAnH8jwM-HFA8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sr1c575jp7MiZ9rToP5wT6F2t6SEmCCB4G5wP8OFnmQ&oe=6A105ACE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7zUz2SRUdYQ7kNvwFEFYIo&_nc_oc=AdoC51Itu-QMm3r7mFc_jGr2wjIFYLXHaAqJbFLm5h35bWJXdauGYZGlCV0ugFtswAg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jeupoOhTRGpZNDqCgFoRChS7Hn_AiUPfPNRXYQZbGvA&oe=6A106C3B"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
236583_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NVV3dgZ7BIQ7kNvwGCfAZt&_nc_oc=Adm5WHAxIYJ_R3NwZGF-dVM1xbRe3deel04p6iG-wDgkfDm_rAKjuJylh-ueOW2iuTg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvT4nAj891tPQYH_QI7zaWQGxW2drFLxqYO_7OMswc1IQ&oe=699EFCAA"}, {"file_name": "Untitled-7.png", "id": "1748996415685632", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391967_1748996419018965_2226293223821724103_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vcfGdfTjEMQ7kNvwFLBAAu&_nc_oc=Adn1bt8bXgVKEb-P1Oy7UmVVU5bFuvxeBZSRLJ4pa0KlvkpTvWGhpIvbjkry9nn1hAE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuezRhHoJLGupiEO4ygOW2ASeXDtYWCoJXkARcI5_ereA&oe=699EFDE2"}, {"file_name": "33.png", "id": "546193274962509", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974889_546193278295842_6633306432277569071_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xURy09PY9MQ7kNvwEr16iE&_nc_oc=AdnC69s0byf4CextmibTKw2BrIPfAvkaHF0eb_tuligLAiK0aKwheuUmpUgyANoZvaQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvEPgQ2A9EClet4MRK_meS9KB6Wsh9UH9W386Bc3yFnGw&oe=699EF930"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape1216.png", "id": "899002852436987", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75505552_899002855770320_957531041732301822_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2DinRU5PkAQ7kNvwGM8x1x&_nc_oc=AdkswL-vnUooLiccsrmKERbWWk_fkcgeg-PYdaqYAJufCuzIZzZK81oUo4KeWvn_Q5Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvc1TkNSIIvJG-FSOWIAVuo_m2hFLuHmHOYYCEg28gOzw&oe=699EE58C"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "4/27/25 Update: 3 New Stages, 20 New Monsters, and more coming soon!  \n\nDefend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 15 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourself with an upgradable slingshot and adaptive defenses to survive epic battles and an ever-intensifying siege across 100 challenging days!  *First 15 days available now in Early Access with more weapons and monsters coming soon!*"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.100daysiege.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Foundry Six", "support_website_url": null, "website_url": "https://www.100daysiege.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29318856931091720"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75292490_1623186072410045_7564913805997461673_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lH3uNiLV9dwQ7kNvwE8QcIj&_nc_oc=AdkEvxT1NaPnY80FF2zYYC0sv4W8ILvh_ajx
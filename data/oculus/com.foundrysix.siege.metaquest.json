xf2&_nc_oc=Ado2NVWN0Zj7gH3vX5YJtI1uXs3wdE0ookVcxy3-hNsshfqcK777JVk3Ucnvf-6aN6E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qmf58C_V0UFhMIHWWSWJ4IdLdahEToMO_tCSMk7bc7g&oe=69D50CF5"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uq39boU9OIcQ7kNvwGFjJBR&_nc_oc=AdoJBybNnEcyMlr1h5msEGHYaokdJUWxD_R88KSP81sA6dWMf09YUZxBTNjSXLxztIo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tNLIHwyoABV1DujB6-kEy1KJuTRUuIUmqS5iTUuV10g&oe=69D5074E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBTxstNb7jAQ7kNvwEAm_Yj&_nc_oc=AdqgKFGxMi-1S9Y7l9tFOhGIXM27s-u-BbPhel0j2NM5KULH2CsLbzBrNxJFcbUzdio&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EfCQXSQ0-6_4J8k3Rp-VJppBPazMftJx9nGjkfocjsA&oe=69D518BB"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
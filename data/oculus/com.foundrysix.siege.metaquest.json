236583_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqzFZpSyBe0Q7kNvwGFXFEZ&_nc_oc=AdlaFYDZn5eTW7tk14gSU01wU_e_dYw3-T3KwJgCJjPOwr9KT7ggBucf2U2iz0uyJNE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft_7gF1cVzg8M9_D7B3FQocKqjyAWtKVB-FNBA7Dw9ehw&oe=699DAB2A"}, {"file_name": "Untitled-7.png", "id": "1748996415685632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_1748996419018965_2226293223821724103_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vcfGdfTjEMQ7kNvwGbLoTQ&_nc_oc=Adk5c5cNitM328-6_h0F3kdnKTxmTdv8bT8hZlvCbhF5facmjly0wnT9o-JSbozqdQ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftR0H6OcbK9M4WjXhGfIRtI0fsJroM00HS8HnEfmol7Aw&oe=699DAC62"}, {"file_name": "33.png", "id": "546193274962509", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974889_546193278295842_6633306432277569071_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJmo0STETK8Q7kNvwGEs-xT&_nc_oc=Adkatm8HyAnD8I8dozw8MZmxsXQeXsl0aXWVxayZOz9-tqT3zZrMbiYxlx2xtzQ5Y7A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsmv4wB3eidkaZHp78jPDsLkv0wAjxqqKDRhXwdHrRHdA&oe=699DA7B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape1216.png", "id": "899002852436987", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75505552_899002855770320_957531041732301822_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlZ6xEWnq1AQ7kNvwHD7H5j&_nc_oc=AdkI2KCu8zkSDv_v70xE-tlPNUIssdr5jOqZHbnLA4VnJYUT5BJPmbNNJlO9nC6OxMo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfstO-nQDkhZeACDDI6Z8oJqIN1VFagTcbsa65oHBybtCQ&oe=699D940C"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "4/27/25 Update: 3 New Stages, 20 New Monsters, and more coming soon!  \n\nDefend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 15 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourself with an upgradable slingshot and adaptive defenses to survive epic battles and an ever-intensifying siege across 100 challenging days!  *First 15 days available now in Early Access with more weapons and monsters coming soon!*"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.100daysiege.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Foundry Six", "support_website_url": null, "website_url": "https://www.100daysiege.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29318856931091720"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75292490_1623186072410045_7564913805997461673_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lH3uNiLV9dwQ7kNvwHZrxdu&_nc_oc=Admfw7R7rZ4qJSV6rpr3r-6do8Qk5Xkzbo3A
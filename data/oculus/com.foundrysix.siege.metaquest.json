IpH&_nc_oc=AdqN7MfVWJSuagruhCrcYxvv5D9tM2GWmWvbNyjxW6kNoAxOABotYntoZk77P4b4vJM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YUIoa0eTrLzCJOVuSBToocrAFYT_pkggKKO8nPe-1SA&oe=6A2C0FF5"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y58agCjWFH8Q7kNvwFiCJdp&_nc_oc=AdrimbaHW_z4N2J__aCkm0-9J9hVGtSB0jXnRMaGBc1LqmKOla2YW_jOCYiPLiIfsUU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yHmXnTILr_p52r8UEpuf7OsZcWjAQVvpIzh33hOT6OA&oe=6A2C0A4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maeChooQqpgQ7kNvwHVzAVR&_nc_oc=AdqIH-IJioh2CS2_Ohs5jBkr4S9RA8u2gror3YHcN4tEsuloRWgHdK5O4pDVnH1mZFA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9x_rQBLZyOHMjCIIOmSpcLw_Jcam2CT29f1ZGxwLd16A&oe=6A2C1BBB"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
-fk&_nc_oc=AdqMX8uHxKK4RYjtGmV8Fem3wJ49PWKNREVq4dMAz-CgpmYgPijCs1OTt-j2EGwbpeA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAz9t7KNnrEFMoxabLSoLIXb3UOGh9jWBFUyFQiG0VIOw&oe=6A4FA875"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJZI_DA6CSoQ7kNvwHxz-yf&_nc_oc=AdqRH-gt9kfULrG3y-wciX1IrT84UXZbTghpRo688EHfiHrc8AvG6lMycNYL_G8cZRY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4A184ksfXRwHBxy-ymcIa3gtEhKwYDb_vvKhDmt9ovA&oe=6A4FA2CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvUvd3B8fSYQ7kNvwGO_6yX&_nc_oc=AdqSkATyPnBwUmvzOtsVP8krC3YJEbR_w9ctM8fj_nzNDgLw-RRGEUrjh4ZRtc259oA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbUYLGcVE0Ocaazo7ZoVSxmE4MvYnv1koz_N0Ol1y0OA&oe=6A4FB43B"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
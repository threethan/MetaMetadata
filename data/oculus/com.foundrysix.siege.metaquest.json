oI7&_nc_oc=AdqfM8LRnz5vUeew-_DtgwMxHz6jjfmYkRcWy1AJpnYdSaowVGYg43WeLRjE5a-KeS4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTP8BKgS_V7i1dWIGuHJqs8tdh-YTverY_48TfC7dbww&oe=6A5F7A75"}, {"file_name": "Image 3.png", "id": "911901053726043", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IA3HJD5iaR8Q7kNvwFZUG2c&_nc_oc=Ado6gkKY3CPstjJ3ocgjiU_I_1Otpdu1vsYmgU7SFKTtmltFCMWrNY1_Fjtl3MhMpU4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8Q-O4jH3Und9JnHSV6a27EggYuW5hVq2LIaz_Tg0zkA&oe=6A5F74CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TymnMAmhPcYQ7kNvwFTjf8F&_nc_oc=AdrV8Qwp_JU896aymRK3Zmoq6MEjF0r9ReAsBmOmwToDlcSVcnsjsoK77SpjlaUYRqQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcnA6v1dNe6wY6Ilngk7mKvXv8HIUaD1o-dXpVoZjLeg&oe=6A5F863B"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourse
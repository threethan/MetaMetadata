488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZmpQW0MUgIQ7kNvwFQe9dj&_nc_oc=Adk9pKQ7goM9ypjQn6RYIx0Z2cKE2T8aVpVrMP7JVV5XqprFpVo5XLRyzpnRP_0wqog&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv8azete3AEne6hpjapeYMbpjDG8iA41DR36YUEOKuqQQ&oe=699B054E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_x8ORJkE9wQ7kNvwFv9ljJ&_nc_oc=AdllRzhKJfeKG_sLtBfDkL_vNDJ3IZ9bsQ9tzcv4IaZsGhOn2NZiezWFCBgzwq_sBNE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv1VVglIJYOKmFN8bq-XJynHkUdEvTqIXJfEdPj2SBuaw&oe=699ADE7B"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourself with an upgradable slingshot and adaptive defenses to survive epic battles and an ever-intensifying siege across 100 challenging days!  *First 6 days available now in Early Access with more weapons and monsters coming soon!*"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.100daysiege.com/privacy-policy", "developer_terms
488_911901057059376_8659750520587435708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mudmGBb9bqoQ7kNvwHZ61lI&_nc_oc=AdkXx64DE4YgAdbaRpZ1S7JPbYaLF1gFe_f8zK9JOlZjV4KW7SE3qngJB7sxNFeH3xY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvcrDT2blEaoPgTIn4q9HxtbSFAqqn7b8tSpR8P5MF9Hw&oe=6998624E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "early access.png", "id": "1039091161561870", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001675_1039091164895203_7746641080650510066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRhy4lPLP7IQ7kNvwGS-D2_&_nc_oc=AdkR71O-igYzT616nkv5bS7ii809IVW22qpEy0euNfLVh2sDTwIpcopL3FIayWfADkw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftoginMguaMmoRbedqz6DccX4tZDxM8ok2uTPUP7h5qlw&oe=69983B7B"}, "display_name": "100 Day Siege", "keywords": ["rpg", "rogue", "survival", "slingshot", "castle"], "long_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Face relentless waves of skeletons, archers, siege towers, cavalry, and more in epic battles. Armed with a powerful slingshot that gains new ammo types as you destroy enemy siege towers, you\u2019ll confront hundreds of enemies while upgrading your defenses. Conquer progressively harder \"Days\" as each wave introduces new foes and challenges. Step into an immersive VR experience where every level brings intense action and strategic RPG elements. Can you survive the 100 Day Siege?  *First 6 days available now in Early Access with more coming soon!*", "short_description": "Defend your castle in a medieval fantasy world against the largest horde in VR! Arm yourself with an upgradable slingshot and adaptive defenses to survive epic battles and an ever-intensifying siege across 100 challenging days!  *First 6 days available now in Early Access with more weapons and monsters coming soon!*"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.100daysiege.com/privacy-policy", "developer_terms
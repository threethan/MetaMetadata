_938312054810998_3213846101322458097_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QG4PkcuXqAQ7kNvwGxPpgD&_nc_oc=AdkOOhmpanCCPvqPyoJOBwZ4jYqp74Fj10qsnmSJ09S8BavrYB1OXHLJjmHmAp_H2Pk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftdGSY069S4T3FPfeW2lM7iInHbIDqZ42eM7rrHi3tFDA&oe=69A44610"}, {"file_name": "screenshot5.png", "id": "923007509783966", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001708_923007513117299_5988355365997720724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLVtualndOoQ7kNvwGS3zw-&_nc_oc=Adk06xT2rYMSbpDBrqYHaA9dGBaRNlGHDxMULH7Byoz4YPMGaRtXoHY0WnkUg8A8Foo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftGZMxP36LbjQMFRgOKDxMXL0WT4EelO5pRHOcnshvHQQ&oe=69A44F04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SL_Lite_Dragon_TemplateLandscape.png", "id": "1068219784629180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86616643_1068219787962513_5401291042371764239_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q09tUOeQDTUQ7kNvwESM0m1&_nc_oc=AdmBf9CS37fFzRLRvKjmztAW874AqjjKMPgMsWSRIHVri9GCsgTCchsOvAjwwEqkcrc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsy2QST7AcgK3Cqt5B-Oe2I4PxtxdNjyIcKBu0O-sJuew&oe=69A4289A"}, "display_name": "Shapelab Lite", "keywords": ["modeling", "sculpting", "3dmodeling", "3dsculpting", "vrsculpting"], "long_description": "Shapelab Lite brings the essential features of the acclaimed Shapelab PCVR app to standalone VR at a more accessible price, carefully adapted for devices with lower processing power. Launched in early access, Shapelab Lite allows us to refine and enhance the app with community feedback for optimal standalone VR performance.\n\nDesigned for immersive 3D sculpting, Shapelab offers an intuitive interface to freely shape ideas in 3D space with enhanced control. From basic forms to complex designs, Shapelab enables you to create detailed props, characters, and digital concepts for applications, games, and virtual worlds. VR sculpting creates a unique level of engagement, offering faster workflows and greater precision.\n\nBuilt on a polygon mesh foundation, Shapelab Lite also includes dynamic topology, enabling on-the-fly adjustments of detail by tessellating or decimating polygons, adding flexibility where detail is needed. On standalone devices, users may notice performance limitations, with framerate drops around 1.5 million polygons. To maintain performance, reduce polygon counts with low-resolution brushes or decimate the model using the Mesh Density tab.", "short_description": "Shapelab Lite brings the core capabilities of the highly-rated Shapelab PCVR to standalone VR, offering a streamlined feature set at an accessible price. Currently in early access, Shapelab Lite allows for continuous improvements to further optimize it for standalone VR and everyday use. Ideal for 3D modeling, sculpting, and painting, Shapelab Lite provides a fun, relaxing experience with dynamic topology for on-the-fly detail control, making it a flexible and easy-to-use 3D modeling tool."}]}, "developer_name": null, "developer_privacy_policy_url": "https://shapelabvr.com/service-privacy-policy", "developer_terms_of_service_url": "https://shapelabvr.com/end-user-license-agreement/", "publisher_name": "Leopoly Kft", "support_website_url": "https://leopoly.atlassian.net/servicedesk/customer/portals", "website_url": "https://shapelabvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SC
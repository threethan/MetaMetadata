6_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBtyh6qHt50Q7kNvwEIonc_&_nc_oc=AdrJo24k4BcemfZ0E9TEdr5Jte1bkn-jycRwdxARNTE6aBwY2zsMQ8pEyQ8NOGgxv04&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBLx21hZMgL7nrvtrUMnP9fSjA0oWaC_PmloTWb-VzMg&oe=6AFB4A1F"}, {"file_name": "screenshot4.png", "id": "938312051477665", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974733_938312054810998_3213846101322458097_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2dBU3JHQ4wQ7kNvwF5QQwA&_nc_oc=AdpTLRJAPIPt7w_Z0db9N2p7LfJGJRN93W91gET0wI5LhSiXcNZZVF8PPuY11-ST1xs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkcXgFveaKkKOxd55zlrrK5F-ilsWHSyoZKKlrui_D_w&oe=6AFB4450"}, {"file_name": "screenshot5.png", "id": "923007509783966", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001708_923007513117299_5988355365997720724_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFv5wBfAj98Q7kNvwHwVBLz&_nc_oc=AdpQps4SrAx2k3CjtDJFXe8bUaXaIZYe5hyz8zcomyWQ7WYRqr-KpPv7xYPC7A5ae6s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7nODUSoGUkCZ1LQb0cJninyarXJ59Zc2LSg6JuX5HOQ&oe=6AFB4D44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SL_Lite_Dragon_TemplateLandscape.png", "id": "1068219784629180", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86616643_1068219787962513_5401291042371764239_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjJQhltJVw4Q7kNvwHJP8HQ&_nc_oc=AdqzwuN0GIjhBrwT6rTOs9sX5i-Bp73oKxJ2ak4JLh1VIOJniLGKdW6YvapyA2lKQAY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIm6ypb3uueuSvZeaDCr4Dd6NFzNee8R6k3AHJx8XZQQ&oe=6AFB26DA"}, "display_name": "Shapelab Lite", "keywords": ["modeling", "sculpting", "3dmodeling", "3dsculpting", "vrsculpting"], "long_description": "Shapelab Lite brings the essential features of the acclaimed Shapelab PCVR app to standalone VR at a more accessible price, carefully adapted for devices with lower processing power. Launched in early access, Shapelab Lite allows us to refine and enhance the app with community feedback for optimal standalone VR performance.\n\nDesigned for immersive 3D sculpting, Shapelab offers an intuitive interface to freely shape ideas in 3D space with enhanced control. From basic forms to complex designs, Shapelab enables you to create detailed props, characters, and digital concepts for applications, games, and virtual worlds. VR sculpting creates a unique level of engagement, offering faster workflows and greater precision.\n\nBuilt on a polygon mesh foundation, Shapelab Lite also includes dynamic topology, enabling on-the-fly adjustments of detail by tessellating or decimating polygons, adding flexibility where detail is needed. On standalone devices, users may notice performance limitations, with framerate drops around 1.5 million polygons. To maintain performance, reduce polygon counts with low-resolution brushes or decimate the model using the Mesh Density tab.", "short_description": "Shapelab Lite brings the core capabilities of the highly-rated Shapelab PCVR to standalone VR, offering a streamlined feature set at an accessible price. Currently in early access, Shapelab Lite allows for continuous improvements to further optimize it for standalone VR and everyday use. Ideal for 3D modeling, sculpting, and painting, Shapelab Lite provides a fun, relaxing experience with dynamic topology for on-the-fly detail control, making it a flexible and easy-to-use 3D modeling tool."}]}, "developer_name": null, "developer_privacy_policy_url": "https://shapelabvr.com/service-privacy-policy", "developer_terms_of_service_url": "https://shapelabvr.com/end-user-license-agreement/", "publisher_name": "Leopoly Kft", "support_website_url": "https://leopoly.atlassian.net/servicedesk/customer/portals", "website_url": "https://shapelabvr.com/", "category": null, "comfort_rating": "COMFOR
_938312054810998_3213846101322458097_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXmaX3xoyh4Q7kNvwHJK6E9&_nc_oc=AdkT2OVJ41OfiYRZPVHGR2yuMmrVaSouyf7sXvAxWaCpSAvTjyYLwE2RbVBGU2_9WzQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsnkOuoRu3FG6bzqZOb81vzQ5SFYY5fNPORZvLjCEBFmQ&oe=69986890"}, {"file_name": "screenshot5.png", "id": "923007509783966", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001708_923007513117299_5988355365997720724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e35RiNR0Uh8Q7kNvwHy2vvI&_nc_oc=AdlaoI2HxXr-c5yBM9tOCm0XJPrgRCynJXJTNMWCpeGTT8VxGITk-ACGQsxc8cC45nI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftGqWlIOnKccd4o5hk9UgHk6fZamE9gVz0iLpdtT14H0A&oe=69987184"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SL_Lite_Dragon_TemplateLandscape.png", "id": "1068219784629180", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86616643_1068219787962513_5401291042371764239_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEpzIXq7AmsQ7kNvwFjBA00&_nc_oc=AdkQHSOtLMdypxfsPdn06KWwezW10ksBXs2c3NE5U00TThY0-2EKsfXHoF8eFycA_As&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvQGbLHnsja7GnaqytWhrrvJhW2ZUf-ze9OH3a_m-TWfw&oe=69984B1A"}, "display_name": "Shapelab Lite", "keywords": ["modeling", "sculpting", "3dmodeling", "3dsculpting", "vrsculpting"], "long_description": "Shapelab Lite brings the essential features of the acclaimed Shapelab PCVR app to standalone VR at a more accessible price, carefully adapted for devices with lower processing power. Launched in early access, Shapelab Lite allows us to refine and enhance the app with community feedback for optimal standalone VR performance.\n\nDesigned for immersive 3D sculpting, Shapelab offers an intuitive interface to freely shape ideas in 3D space with enhanced control. From basic forms to complex designs, Shapelab enables you to create detailed props, characters, and digital concepts for applications, games, and virtual worlds. VR sculpting creates a unique level of engagement, offering faster workflows and greater precision.\n\nBuilt on a polygon mesh foundation, Shapelab Lite also includes dynamic topology, enabling on-the-fly adjustments of detail by tessellating or decimating polygons, adding flexibility where detail is needed. On standalone devices, users may notice performance limitations, with framerate drops around 1.5 million polygons. To maintain performance, reduce polygon counts with low-resolution brushes or decimate the model using the Mesh Density tab.", "short_description": "Shapelab Lite brings the core capabilities of the highly-rated Shapelab PCVR to standalone VR, offering a streamlined feature set at an accessible price. Currently in early access, Shapelab Lite allows for continuous improvements to further optimize it for standalone VR and everyday use. Ideal for 3D modeling, sculpting, and painting, Shapelab Lite provides a fun, relaxing experience with dynamic topology for on-the-fly detail control, making it a flexible and easy-to-use 3D modeling tool."}]}, "developer_name": null, "developer_privacy_policy_url": "https://shapelabvr.com/service-privacy-policy", "developer_terms_of_service_url": "https://shapelabvr.com/end-user-license-agreement/", "publisher_name": "Leopoly Kft", "support_website_url": "https://leopoly.atlassian.net/servicedesk/customer/portals", "website_url": "https://shapelabvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SC
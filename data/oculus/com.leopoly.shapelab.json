6_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JuT-johV5EQ7kNvwHsDdOC&_nc_oc=AdoELIgsV1vzEN6c9WB71xDs5nHZBp_fp7C9y-bkzoDYiy5w6ZpyJ90EC7vx1KgKJSY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXKBr118ZvLGCmibCf1OdaPbhjzXMg-bZzKrGo_OTFK_Q&oe=6B0F109F"}, {"file_name": "screenshot4.png", "id": "938312051477665", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974733_938312054810998_3213846101322458097_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oqpbAthpNAQ7kNvwGOBMnL&_nc_oc=AdoIrx0BYwKofXYT44JEiYj7u_0v9UFZU-QTzj1V1D55tNCL4a8fH4qNoVieJ3g3UfY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV8y7TTDMjGqVvqAJJtme0TdRDwiqtxL4vlsink9V71jw&oe=6B0F0AD0"}, {"file_name": "screenshot5.png", "id": "923007509783966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001708_923007513117299_5988355365997720724_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1ROnRh7gZYQ7kNvwGZsSwL&_nc_oc=AdqiZ3dd8vIc_18Ic7vwKwpSb6E53funrOsegy5fwp-6IJuAJFj0_9_RMB94TrZzy9A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVoAgDJbr3rqDgn9mBvCk8b9oyCQsVswxfr3RR5u706GA&oe=6B0F13C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SL_Lite_Dragon_TemplateLandscape.png", "id": "1068219784629180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86616643_1068219787962513_5401291042371764239_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpU3DGFbkZUQ7kNvwG-m9eP&_nc_oc=AdrggICJYku_N7EY1vdNkL5Qwmqp89n4TJAcgQiLzYVB8tbVwCVA-bz9tf5t-DE0TxY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXSnHpMEYKzKPCWNQEXB1ZtliHlMTwlVDEh8hARBJn_CA&oe=6B0EED5A"}, "display_name": "Shapelab Lite", "keywords": ["modeling", "sculpting", "3dmodeling", "3dsculpting", "vrsculpting"], "long_description": "Shapelab Lite brings the essential features of the acclaimed Shapelab PCVR app to standalone VR at a more accessible price, carefully adapted for devices with lower processing power. Launched in early access, Shapelab Lite allows us to refine and enhance the app with community feedback for optimal standalone VR performance.\n\nDesigned for immersive 3D sculpting, Shapelab offers an intuitive interface to freely shape ideas in 3D space with enhanced control. From basic forms to complex designs, Shapelab enables you to create detailed props, characters, and digital concepts for applications, games, and virtual worlds. VR sculpting creates a unique level of engagement, offering faster workflows and greater precision.\n\nBuilt on a polygon mesh foundation, Shapelab Lite also includes dynamic topology, enabling on-the-fly adjustments of detail by tessellating or decimating polygons, adding flexibility where detail is needed. On standalone devices, users may notice performance limitations, with framerate drops around 1.5 million polygons. To maintain performance, reduce polygon counts with low-resolution brushes or decimate the model using the Mesh Density tab.", "short_description": "Shapelab Lite brings the core capabilities of the highly-rated Shapelab PCVR to standalone VR, offering a streamlined feature set at an accessible price. Currently in early access, Shapelab Lite allows for continuous improvements to further optimize it for standalone VR and everyday use. Ideal for 3D modeling, sculpting, and painting, Shapelab Lite provides a fun, relaxing experience with dynamic topology for on-the-fly detail control, making it a flexible and easy-to-use 3D modeling tool."}]}, "developer_name": null, "developer_privacy_policy_url": "https://shapelabvr.com/service-privacy-policy", "developer_terms_of_service_url": "https://shapelabvr.com/end-user-license-agreement/", "publisher_name": "Leopoly Kft", "support_website_url": "https://leopoly.atlassian.net/servicedesk/customer/portals", "website_url": "https://shapelabvr.com/", "category": null, "comfort_rating": "COMFOR
6_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0h5VNhRGsMMQ7kNvwHG6qwP&_nc_oc=Adp_cZir43zZb4YrT0SRb7KuuyRtmFB3vnjP_O_xbtfg2MLIqszOY0k1XDo_yQGC00A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT7xN-jwp60IfCxiNPvdJ80YfYun4W2HJKwtp5bd3nsUA&oe=6B0C6D9F"}, {"file_name": "screenshot4.png", "id": "938312051477665", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974733_938312054810998_3213846101322458097_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HjKpOaQFMAQ7kNvwFfiVgH&_nc_oc=Adr6cY0TXO8vUzKe-J_b1DfLLcPSIqUnafKcgvP0DHXSKF43No1s93tTldcEYeYa6T0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS9XJIROTe0MAZOc3lOTSx5bSb0M37De8rqiGGbM7wNSA&oe=6B0C67D0"}, {"file_name": "screenshot5.png", "id": "923007509783966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001708_923007513117299_5988355365997720724_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czK_pRcj1poQ7kNvwFzgUaV&_nc_oc=Adq-aSNwpLFUPj-q3mq8a5H7w1Y1YS9PALXM4k0HyWsbWkmbbBrHP2CC81T_Ri8OdYI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRM1ZBIkDjSFT27-DAKeSzrp4UWq4VaxTTp0INXcvbXVQ&oe=6B0C70C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SL_Lite_Dragon_TemplateLandscape.png", "id": "1068219784629180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86616643_1068219787962513_5401291042371764239_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9LH8NgOgHcQ7kNvwEz1L9N&_nc_oc=Adqb_XAocqm2wy19CU42GDf_o-q-l7u0LKB1Js8CJI71uj7-Dm1ZsGWXs7uA2bfjmJ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR3VGvzMHwyIG_9pkJLd2elUhhX4WIPeLAPPARibnF7rQ&oe=6B0C829A"}, "display_name": "Shapelab Lite", "keywords": ["modeling", "sculpting", "3dmodeling", "3dsculpting", "vrsculpting"], "long_description": "Shapelab Lite brings the essential features of the acclaimed Shapelab PCVR app to standalone VR at a more accessible price, carefully adapted for devices with lower processing power. Launched in early access, Shapelab Lite allows us to refine and enhance the app with community feedback for optimal standalone VR performance.\n\nDesigned for immersive 3D sculpting, Shapelab offers an intuitive interface to freely shape ideas in 3D space with enhanced control. From basic forms to complex designs, Shapelab enables you to create detailed props, characters, and digital concepts for applications, games, and virtual worlds. VR sculpting creates a unique level of engagement, offering faster workflows and greater precision.\n\nBuilt on a polygon mesh foundation, Shapelab Lite also includes dynamic topology, enabling on-the-fly adjustments of detail by tessellating or decimating polygons, adding flexibility where detail is needed. On standalone devices, users may notice performance limitations, with framerate drops around 1.5 million polygons. To maintain performance, reduce polygon counts with low-resolution brushes or decimate the model using the Mesh Density tab.", "short_description": "Shapelab Lite brings the core capabilities of the highly-rated Shapelab PCVR to standalone VR, offering a streamlined feature set at an accessible price. Currently in early access, Shapelab Lite allows for continuous improvements to further optimize it for standalone VR and everyday use. Ideal for 3D modeling, sculpting, and painting, Shapelab Lite provides a fun, relaxing experience with dynamic topology for on-the-fly detail control, making it a flexible and easy-to-use 3D modeling tool."}]}, "developer_name": null, "developer_privacy_policy_url": "https://shapelabvr.com/service-privacy-policy", "developer_terms_of_service_url": "https://shapelabvr.com/end-user-license-agreement/", "publisher_name": "Leopoly Kft", "support_website_url": "https://leopoly.atlassian.net/servicedesk/customer/portals", "website_url": "https://shapelabvr.com/", "category": null, "comfort_rating": "COMFOR
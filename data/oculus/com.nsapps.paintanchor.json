scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593822060_2298967794208781_7128076610570990781_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZbl-n3r4XQQ7kNvwEo8N4f&_nc_oc=AdoGUayDpzfV4tVBjFc_YK-8DvKW6WWqa8LKNFkpx6-OzEiABPXmraoQGvJ_PD7SGZI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJdkXJXKUl3zsJigDGypwviX9-w9v7nwPhkCqy9-y7eg&oe=6AB3E436"}, {"file_name": "24.png", "id": "1388050162773843", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622162_1388050166107176_1157207597212349617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02fm3_9XX0IQ7kNvwFasVsj&_nc_oc=Adp7BJExYWxba6opi3pK14tPVGymPKjZuu6Q3nd-9yPwfYK9oJ-zbneXkOVGXz1BCyQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6phsXcm3IV03uIXJuFsUh6Ca3N-nusJWrz6XhvU27_Q&oe=6AB3E877"}, {"file_name": "28.png", "id": "2616619662116316", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628108_2616619665449649_657785327434569522_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DtqqnQZXB8Q7kNvwGZnWY9&_nc_oc=AdrRKnQEz4HiOKS15QRKYI9r747Zks-wBtjLpmSlaHXlmarkVOWwMi-8xduCiksfN4s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW1WstfkN6s8D2gWa38E68EYedoWOAY9ksRbVcSJE9_A&oe=6AB3D2E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1635296868116344", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628447_1635296871449677_9138587970399405325_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZwuyt6J3mcQ7kNvwHw0L3f&_nc_oc=AdoRZ9JhQ3Ea0GeGjtL42pcQsQb9eXeuesEcOHFzKy6O24H2YmC6QyWCpZAQBVSlK_M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHslxshPYy0AWWDBl8LMb9P48ZP1vUOjUy8kB_vU7ooQ&oe=6AB3ED4B"}, "display_name": "Wall Trace: Mural Drawing Projector", "keywords": ["Painting", "Stencil", "Sketching", "Art", "Creative"], "long_description": "# \ud83d\udea7 Wall Trace is currently in active development!\nWe\u2019re working to make the Mixed Reality wall-drawing experience even more enjoyable and inspiring. Your support, ideas, and feedback help us shape the future of Wall Trace. Please share your comments, impressions, and features you would love to see\u2014we\u2019re looking forward to hearing from you! \ud83c\udfa8\u2728\n\n**Transform Your Room into an Art Studio! \ud83d\udd8c\ufe0f\u2728**\n\nEver wanted to create beautiful wall art with ease? Wall Trace uses Mixed Reality to project images directly onto your physical walls. Simply trace the glowing lines, focus on your strokes, and watch your artwork come to life! \n\n**\ud83c\udfa8 Key Features**\n- **\ud83e\udd7d MR Wall Canvas:** Pin virtual reference images seamlessly onto your real-world walls and adjust the scale to your liking. \n- **\u270f\ufe0f Trace & Enjoy:** Follow the guide lines to trace over a variety of beautiful designs and patterns at your own pace. \n- **\ud83c\udf0c Relaxing Creative Flow:** Focus entirely on your drawing in a calming environment, blending your real room with digital art tools.    \n", "short_description": "Turn your real wall into a canvas! \ud83c\udfa8 Wall Trace: Mural Drawing Projector lets you project reference images onto your physical walls in Mixed Reality. Trace over various designs and enjoy creating stunning art right in your room! \ud83d\udd8c\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "su
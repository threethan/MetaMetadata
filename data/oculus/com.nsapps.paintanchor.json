content-ord5-2.oculuscdn.com/v/t64.5771-25/593822060_2298967794208781_7128076610570990781_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6nlfUhtRCMQ7kNvwGA1Z3c&_nc_oc=AdpqW3fLkyH56JbZNAbt_meUcaQLrC2ViICZBLAMMiDckV4EQtQOZlzvazuwNwiHHes&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1gdzMueSqOYvuplU-Hrw4iCp5XFtKm0DRWB_QprENgQ&oe=6ABBCD36"}, {"file_name": "24.png", "id": "1388050162773843", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622162_1388050166107176_1157207597212349617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axsOjBwRB4YQ7kNvwF1Cw7V&_nc_oc=AdoXRctHJOEB4hHiT6F1DDZafvuEXCYQZWWjrtMlk3ZgOLzMDxy_xhf1Qc8Pw6XsPW0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKq9ZPQ9Elgvs_fj2Kq-Kv1WNWQNxTwJXXSLjljjk9Iuw&oe=6ABBD177"}, {"file_name": "28.png", "id": "2616619662116316", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628108_2616619665449649_657785327434569522_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtPJ2j0zHzcQ7kNvwEw7onz&_nc_oc=Ado0q0Er5w4yHLfeLP7QWNUUWCs3c8pJt3SIVGIhrM1RtOD0AnsD-vVzDhQxMlQdoNM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQI_3QDzGiRtBoHm5v2K0DE4kgszM6ExY0D4o9Tuz9lg&oe=6ABBBBE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1635296868116344", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628447_1635296871449677_9138587970399405325_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KpX2p6MpHQQ7kNvwHuzUMD&_nc_oc=AdoNp4q5pfGGgPXYZvtGhBseyWNhPv5DLGaWryqcexJRP3BSyLR_E1boJgL9Y1909vA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVNvQYhnNIxEbNC521CFwBHdRBYRDoXO1ZZYE1L5T4fg&oe=6ABBD64B"}, "display_name": "Wall Trace: Mural Drawing Projector", "keywords": ["Painting", "Stencil", "Sketching", "Art", "Creative"], "long_description": "# \ud83d\udea7 Wall Trace is currently in active development!\nWe\u2019re working to make the Mixed Reality wall-drawing experience even more enjoyable and inspiring. Your support, ideas, and feedback help us shape the future of Wall Trace. Please share your comments, impressions, and features you would love to see\u2014we\u2019re looking forward to hearing from you! \ud83c\udfa8\u2728\n\u3000\n**Transform Your Room into an Art Studio! \ud83d\udd8c\ufe0f\u2728**\n\nEver wanted to create beautiful wall art with ease? Wall Trace uses Mixed Reality to project images directly onto your physical walls. Simply trace the glowing lines, focus on your strokes, and watch your artwork come to life! \n\n**\ud83c\udfa8 Key Features**\n- **\ud83e\udd7d MR Wall Canvas:** Pin virtual reference images seamlessly onto your real-world walls and adjust the scale to your liking. \n- **\u270f\ufe0f Trace & Enjoy:** Follow the guide lines to trace over a variety of beautiful designs and patterns at your own pace. \n- **\ud83c\udf0c Relaxing Creative Flow:** Focus entirely on your drawing in a calming environment, blending your real room with digital art tools.    \n", "short_description": "Turn your real wall into a canvas! \ud83c\udfa8 Wall Trace: Mural Drawing Projector lets you project reference images onto your physical walls in Mixed Reality. Trace over various designs and enjoy creating stunning art right in your room! \ud83d\udd8c\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
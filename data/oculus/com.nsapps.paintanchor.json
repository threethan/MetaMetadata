ame": "02.png", "id": "1600401174906908", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499628067_1600401178240241_1850322589347392803_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxZ4B7iTR8AQ7kNvwH0im5E&_nc_oc=Adqgs_hww_scLhD5wGefSX8Ar7Kqxh6gCoAAau9Svkxw4AuEiSoRZokpTJ21c6ksrIU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTOx5wlm-Za7sz6823sjetwuVBTXUNt9WLXpWb72JYLjA&oe=6B0B276A"}, {"file_name": "03.png", "id": "891215564074632", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499628447_891215567407965_3299238203841675936_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9doGUVYd5WAQ7kNvwHYj-VQ&_nc_oc=Adr7TrRU17FhQXPxkHTZGYJFvoP9-j5F4vxBGGv9i5Nro1gySjBF5tit3q_1LNxJvbg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQYjSy466YSAgi-kCCkZqpaZnWDHeOx0BOxDILT4U5EXA&oe=6B0B3B1F"}, {"file_name": "04.png", "id": "788283601046419", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623131_788283604379752_997724566401550897_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnD7KLINwu0Q7kNvwFwgQt6&_nc_oc=Adq7FPjhbi3Ah0Czl9Esb9QBWkXTLimnNb3I_QUGXg3I_THgwshGgbJ25XLQLTmhaDE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTum9UDRiNdDCWWGx-U0WHc_AOSllGPIy4NH-HzIzy7MQ&oe=6B0B3F6D"}, {"file_name": "05.png", "id": "1973436143324185", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620316_1973436149990851_5937739237646169097_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhd4B7j7sNwQ7kNvwEmOaV2&_nc_oc=AdrLf1MZTBOHwgU2hh8SP2aEFlmDIwQGJRRg-omwCGCu-03ldrQkpJc4PlKbKxKYFY4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSpSKZjEUo0KA5bTQAeYaNnYTZn2yd9x29ayxEFObbXRA&oe=6B0B3BB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u3010\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u3011MR\u30b9\u30c8\u30a2\u30a2\u30bb\u30c3\u30c8\u4f5c\u6210\u306e\u30b3\u30d4\u30fc\u306e\u30b3\u30d4\u30fc.png", "id": "1458346082854244", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499624656_1458346086187577_8358725005480562757_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPv3-a-hFtAQ7kNvwFbOsUN&_nc_oc=Adq_CF2xDD7z3PcfLsGh-v4DxtIRmiZ7FjilCiIrcfmi7c0zjF1Ml7FvOI5aJsm93fo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSsvuqHU2NE6V_10RgBef_X0b_fH894oVW8Pay71JhJDg&oe=6B0B3280"}, "display_name": "Wall Trace: Mural Drawing Projector", "keywords": ["Painting", "Stencil", "Sketching", "Art", "Creative"], "long_description": "**\ud83d\udea7 Wall Trace is currently in active development!** \n\u3000\nWe\u2019re working to make the Mixed Reality wall-drawing experience even more enjoyable and inspiring. Your support, ideas, and feedback help us shape the future of Wall Trace. Please share your comments, impressions, and features you would love to see\u2014we\u2019re looking forward to hearing from you! \ud83c\udfa8\u2728\u3000\n\n{2714364962299140}\n\n\n**Transform Your Room into an Art Studio!** \ud83d\udd8c\ufe0f\u2728\n\nEver wanted to create beautiful wall art with ease? Wall Trace uses Mixed Reality to project images directly onto your physical walls. Simply trace the glowing lines, focus on your strokes, and watch your artwork come to life!\n\n**With hand-tracking controls, there\u2019s no need to keep picking up controllers while you draw. **Operate Wall Trace with your hands, adjust your reference, and get back to creating.\n\n### \u30fb**CHOOSE YOUR IMAGE**\n\nStart with one of the included designs or choose an image stored on your Quest.\n\n### \u30fb**PLACE IT ON YOUR WALL**\n\nPosition, resize, and rotate your reference until it fits your space\u2014all with hand-tracking controls.\n\n{2140991046785521}\n\n\n### \u30fb**TRACING EASIER**\n\nAdjust the opacity while you work. and change the line color for clearer outlines.\n\n{952064974471446}\n\n### \u30fb**DRAW IT FOR REAL**\n\nPick up your pencil, marker, or brush and trace the reference directly onto the physical surface.\n\n{1456983309667160}\n\n### \u30fb**KEEP YOUR PLACE**\n\nSave your placement and return to your project later without starting over.\n\nFrom a small sketch to your next mural, Wall Trace gives you a simple way to move a design from screen to surface.", "short_description": "Turn your real wall into a canvas! \ud83c\udfa8 Wall Trace: Mural Drawing Projector lets you project reference images onto your physical walls in Mixed Reality. Trace over various designs and enjoy creating stunning art right in your room! \ud83d\udd8c\ufe0f  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29821700144088589"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623185_1074443605426057_4029009546366025302_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsGBMTYmJ5kQ7kNvwFpf2t2&_nc_oc=Ado8hvvyU_XqYti4iu7NU2fXlPsCu83n28Zi8Il0ju0Iy-3Y6cgi9gNmiKtvtJCYKvI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00
content-ord5-1.oculuscdn.com/v/t64.5771-25/499628447_891215567407965_3299238203841675936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcQeQPAy8CwQ7kNvwG8HkvC&_nc_oc=AdqSK0SWG_SDhrhWixybkzfqU5J_jydOqX4_SwtfVrWbJ_weQEMGJqU4MiQtXI2IFf4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODZ5vn1Hx7Noi1jJuo5h7pyxBsvVzu1zBygoYG3hK53g&oe=6ACBBADF"}, {"file_name": "04.png", "id": "788283601046419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623131_788283604379752_997724566401550897_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pbhu6MejmtMQ7kNvwGsxqV-&_nc_oc=Adppv8BZuIIIXumOrA5R8lLn8QNyjbV7CLnkwRFtJ8YLf7To8h7-tALTFY0P5B7Hgpk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvGwGdr1Xe_nYrim3-vzpPq_Iu7ZX5tjueG4IlWx5GJg&oe=6ACBBF2D"}, {"file_name": "05.png", "id": "1973436143324185", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620316_1973436149990851_5937739237646169097_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQpkGXU36hMQ7kNvwGrdxMb&_nc_oc=Adpj-kEBi6Ryy8FjFB_4B6TNrNzxk-tXDHBqHftOp_Vib0cxyDIKux3ah66JWa_IlKI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPClbAHROy2vVE5LsCFzKV9MjjuWAI2yXTcPfo4P4pBbg&oe=6ACBBB76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1635296868116344", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628447_1635296871449677_9138587970399405325_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RN9yKojzuZ0Q7kNvwGarWT8&_nc_oc=AdqqNtLsAL0VtmUvo_KVj4BmMDr1a_c_rBgyGt5KNn6nGGPoncVx-r5bVWRQBZHdUk0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGhq0wN9Ma2f0F7E99IwwkfWAj8JehpZ4xZlEBr8_BOg&oe=6ACBA84B"}, "display_name": "Wall Trace: Mural Drawing Projector", "keywords": ["Painting", "Stencil", "Sketching", "Art", "Creative"], "long_description": "**\ud83d\udea7 Wall Trace is currently in active development!**\n\nWe\u2019re working to make the Mixed Reality wall-drawing experience even more enjoyable and inspiring. Your support, ideas, and feedback help us shape the future of Wall Trace. Please share your comments, impressions, and features you would love to see\u2014we\u2019re looking forward to hearing from you! \ud83c\udfa8\u2728\n\n{2714364962299140}\n\n\n**Transform Your Room into an Art Studio!** \ud83d\udd8c\ufe0f\u2728\n\nEver wanted to create beautiful wall art with ease? Wall Trace uses Mixed Reality to project images directly onto your physical walls. Simply trace the glowing lines, focus on your strokes, and watch your artwork come to life!\n\n\n### \u30fb**CHOOSE YOUR IMAGE**\n\nStart with one of the included designs or choose an image stored on your Quest.\n\n\n### \u30fb**PLACE IT ON YOUR WALL**\n\nPosition, resize, and rotate your reference until it fits your space.\n\n{1437750721800966}\n\n\n### \u30fb**TRACING EASIER**\n\nAdjust the opacity while you work. For supported images, simplify the reference by removing the background and changing the line color for clearer outlines.\n\n{1094995996648985}\n\n\n### \u30fb**DRAW IT FOR REAL**\n\nPick up your pencil, marker, or brush and trace the reference directly onto the physical surface.\n\n{1456983309667160}\n\n\n### \u30fb**KEEP YOUR PLACE**\n\nSave your placement and return to your project later without starting over.\n\nThe image is displayed through your Quest headset\u2014the artwork is created by you, on the real wall.\n\nFrom a small sketch to your next mural, Wall Trace gives you a simple way to move a design from screen to surface.", "short_description": "Turn your real wall into a canvas! \ud83c\udfa8 Wall Trace: Mural Drawing Projector lets you project reference images onto your physical walls in Mixed Reality. Trace over various designs and enjoy creating stunning art right in your room! \ud83d\udd8c\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc
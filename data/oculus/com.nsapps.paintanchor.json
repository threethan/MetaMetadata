=6e7a0a&_nc_ohc=4_rL8TQR-nEQ7kNvwHeQFFM&_nc_oc=Ado6j7q66zSYQb0SmadGTKV8Wnh_ZyPn-svF7ExFMWd0q3J_HK7KiRbUmbfmnvx53vs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrRIQkWMce03IkYe5fERD3u_d6zj__KpfUNjGPC5R-wQ&oe=6AF87A2A"}, {"file_name": "03.png", "id": "891215564074632", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628447_891215567407965_3299238203841675936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMNqsOD9D88Q7kNvwH7Gdhr&_nc_oc=AdotJrIqGzAheuNEjwM1RG5Q1QBMc06qL7ykWYuAsEZWp7_bz58dtP_IGOI-yT4rn84&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQVYKP2hobvRSdwSIMQJL-VzhxuYwV111mtZQc67VOPg&oe=6AF88DDF"}, {"file_name": "04.png", "id": "788283601046419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623131_788283604379752_997724566401550897_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWMQAeMO0h0Q7kNvwG4w49I&_nc_oc=AdrfGo9rtgnpruIkhijEaBcfu2nX6L2DL-79lY8ssL1CcGwOLqqfvyxOzQymp9nsU5I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR15o1Vk1qvVmAGeXPhzblZOTuvFZulkC6k_Zfb192png&oe=6AF8922D"}, {"file_name": "05.png", "id": "1973436143324185", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620316_1973436149990851_5937739237646169097_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ii35HgLd95MQ7kNvwF3XO39&_nc_oc=Adrkgan1ISizD8tCiY8valDO9QCswEqIz7Kbi0oHvX1BpD3KOo0s1rVhMT4q2rGdc9Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR25zgba6bIQUq7ejoEGx2IsmsiX1vB7GBwKBDnr8r4sA&oe=6AF88E76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u3010\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u3011MR\u30b9\u30c8\u30a2\u30a2\u30bb\u30c3\u30c8\u4f5c\u6210\u306e\u30b3\u30d4\u30fc\u306e\u30b3\u30d4\u30fc.png", "id": "1458346082854244", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624656_1458346086187577_8358725005480562757_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5keiE3UX5oQ7kNvwFvfUL7&_nc_oc=AdrPe0TEWkCfv6GgUmQg_2hENo14_Kx5RSHNwe5ZKqmJ4jXPh9Hi2IqI2d_rvk2zco0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPmC0BnRyijy6E02IExin3ZuPu06jciZ8v2tXsIe3B7g&oe=6AF88540"}, "display_name": "Wall Trace: Mural Drawing Projector", "keywords": ["Painting", "Stencil", "Sketching", "Art", "Creative"], "long_description": "**\ud83d\udea7 Wall Trace is currently in active development!** \n\u3000\nWe\u2019re working to make the Mixed Reality wall-drawing experience even more enjoyable and inspiring. Your support, ideas, and feedback help us shape the future of Wall Trace. Please share your comments, impressions, and features you would love to see\u2014we\u2019re looking forward to hearing from you! \ud83c\udfa8\u2728\u3000\n\n{2714364962299140}\n\n\n**Transform Your Room into an Art Studio!** \ud83d\udd8c\ufe0f\u2728\n\nEver wanted to create beautiful wall art with ease? Wall Trace uses Mixed Reality to project images directly onto your physical walls. Simply trace the glowing lines, focus on your strokes, and watch your artwork come to life!\n\n\n### \u30fb**CHOOSE YOUR IMAGE**\n\nStart with one of the included designs or choose an image stored on your Quest.\n\n### \u30fb**PLACE IT ON YOUR WALL**\n\nPosition, resize, and rotate your reference until it fits your space.\n\n{1437750721800966}\n\n\n### \u30fb**TRACING EASIER**\n\nAdjust the opacity while you work. For supported images, simplify the reference by removing the background and changing the line color for clearer outlines.\n\n{1094995996648985}\n\n\n### \u30fb**DRAW IT FOR REAL**\n\nPick up your pencil, marker, or brush and trace the reference directly onto the physical surface.\n\n{1456983309667160}\n\n\n### \u30fb**KEEP YOUR PLACE**\n\nSave your placement and return to your project later without starting over.\n\nThe image is displayed through your Quest headset\u2014the artwork is created by you, on the real wall.\n\nFrom a small sketch to your next mural, Wall Trace gives you a simple way to move a design from screen to surface.", "short_description": "Turn your real wall into a canvas! \ud83c\udfa8 Wall Trace: Mural Drawing Projector lets you project reference images onto your physical walls in Mixed Reality. Trace over various designs and enjoy creating stunning art right in your room! \ud83d\udd8c\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29575578822034057"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623185_1074443605426057_4029009546366025302_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQ_lca5qrGoQ7kNvwGO0r82&_nc_oc=AdqQwMY3s2cUZdCd0g0lpQ0bh2zOHwRGacfYqcjx9VeZtFf2DxIYRFbB0onkJciGi_g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlXNi4eQnMKIQptDJ9t_J687lcFjcrKyeSTa9v3-9RlQ&oe=6AF8A6B1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Wall Trace: Mural Drawing Projector", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_d
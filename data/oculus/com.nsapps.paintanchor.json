ame": "02.png", "id": "1600401174906908", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499628067_1600401178240241_1850322589347392803_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzecIscgw5YQ7kNvwFkoTg7&_nc_oc=AdrrSBx76mLi6DzPRf75m7Hg3uHuWnQUkcb9mDHVCfYTi5jSbK0CPLqjU-RtEiqfJFU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5d3tvPnePy59SQjIzQNl16Wp9mV0bkmeYoK35_eFleA&oe=6AFB1D2A"}, {"file_name": "03.png", "id": "891215564074632", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499628447_891215567407965_3299238203841675936_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8y7q7ldZi08Q7kNvwEFQXb8&_nc_oc=AdrCVpEdKY9dDzmGPIV57gjSk3bUR0NqJPSeFpqvWUMuHMLB-WoEeHU1ZGupztS-ntI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQypeLldby-PWDEn2HYSYmuwUHn2jeO7M7btU23yOdXwQ&oe=6AFB30DF"}, {"file_name": "04.png", "id": "788283601046419", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623131_788283604379752_997724566401550897_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWMQAeMO0h0Q7kNvwG01HR1&_nc_oc=AdqKdXUdqsU3skqgesDHY3fD93No574FnJnss_uyMTm6OOv2utlFhIL1hW1xgmDGZHA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUYaWB4gfBmW_NInwmUOmNFsSva8SGIfHsa0yJSRgaXw&oe=6AFB352D"}, {"file_name": "05.png", "id": "1973436143324185", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620316_1973436149990851_5937739237646169097_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtrS31RAT_EQ7kNvwGCQtUS&_nc_oc=AdqXFxjvm6bvWssI4MjuRVHIegcthJx_n_zGOqwXacUvvrE8kw9tQMecC_5ACfr7c0c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvCy7YIdbbSx3WzeYSy-1eINQHd840SYhKzjoje_2Onw&oe=6AFB3176"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u3010\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u3011MR\u30b9\u30c8\u30a2\u30a2\u30bb\u30c3\u30c8\u4f5c\u6210\u306e\u30b3\u30d4\u30fc\u306e\u30b3\u30d4\u30fc.png", "id": "1458346082854244", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499624656_1458346086187577_8358725005480562757_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbvbLfndiwsQ7kNvwF8qLC4&_nc_oc=AdreFKEkL0OYrhoT-CCuJgUY-SvnNc-dERykXO7viO0YHiWciBcMgWRbAqGw_qF9C34&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSYcuad6Ri8xFX4MmOACwcKBPs8ByQ9P6YCZCOuDgw5w&oe=6AFB2840"}, "display_name": "Wall Trace: Mural Drawing Projector", "keywords": ["Painting", "Stencil", "Sketching", "Art", "Creative"], "long_description": "**\ud83d\udea7 Wall Trace is currently in active development!** \n\u3000\nWe\u2019re working to make the Mixed Reality wall-drawing experience even more enjoyable and inspiring. Your support, ideas, and feedback help us shape the future of Wall Trace. Please share your comments, impressions, and features you would love to see\u2014we\u2019re looking forward to hearing from you! \ud83c\udfa8\u2728\u3000\n\n{2714364962299140}\n\n\n**Transform Your Room into an Art Studio!** \ud83d\udd8c\ufe0f\u2728\n\nEver wanted to create beautiful wall art with ease? Wall Trace uses Mixed Reality to project images directly onto your physical walls. Simply trace the glowing lines, focus on your strokes, and watch your artwork come to life!\n\n\n### \u30fb**CHOOSE YOUR IMAGE**\n\nStart with one of the included designs or choose an image stored on your Quest.\n\n### \u30fb**PLACE IT ON YOUR WALL**\n\nPosition, resize, and rotate your reference until it fits your space.\n\n{1437750721800966}\n\n\n### \u30fb**TRACING EASIER**\n\nAdjust the opacity while you work. For supported images, simplify the reference by removing the background and changing the line color for clearer outlines.\n\n{1094995996648985}\n\n\n### \u30fb**DRAW IT FOR REAL**\n\nPick up your pencil, marker, or brush and trace the reference directly onto the physical surface.\n\n{1456983309667160}\n\n\n### \u30fb**KEEP YOUR PLACE**\n\nSave your placement and return to your project later without starting over.\n\nThe image is displayed through your Quest headset\u2014the artwork is created by you, on the real wall.\n\nFrom a small sketch to your next mural, Wall Trace gives you a simple way to move a design from screen to surface.", "short_description": "Turn your real wall into a canvas! \ud83c\udfa8 Wall Trace: Mural Drawing Projector lets you project reference images onto your physical walls in Mixed Reality. Trace over various designs and enjoy creating stunning art right in your room! \ud83d\udd8c\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29575578822034057"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623185_1074443605426057_4029009546366025302_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQ_lca5qrGoQ7kNvwGEfdRR&_nc_oc=Adq03X3EBFcxrA7Ip70ZKFLbEP0uHksynH7S9cwccv5fnNcOMaLF20KLgCbG_ZJiMoE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHU3WGqfiGYXLO21TlqHUpZXa2heQH5-GslS
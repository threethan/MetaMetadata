scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593822060_2298967794208781_7128076610570990781_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwjiYv35BvwQ7kNvwHYxdk1&_nc_oc=AdpnzBtZM_6UnHbVALHdFUvSWd8mRL3hC3XemPgqcBKs7YmWoa1xT1n_qAFHUxAmTFc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8c1CoW4LI1bOIpEPQpDIvC5dF0xlIzuht0ALtn4GBHQ&oe=6AB68736"}, {"file_name": "24.png", "id": "1388050162773843", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622162_1388050166107176_1157207597212349617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0sAKbs2EfAQ7kNvwH0fzQw&_nc_oc=AdpjCvy0dxPCYL_nfdwqXLAazWaB0Qa7pAbA-fRXQYF2LbwgtJVdKha0qjIpnOEPJvM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJl_w-zvNMz2TDDvgEmmErKnW1h6mV8RdHA9r38mlxCJA&oe=6AB68B77"}, {"file_name": "28.png", "id": "2616619662116316", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628108_2616619665449649_657785327434569522_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DtqqnQZXB8Q7kNvwFDthol&_nc_oc=AdpECu7lWnAAfHXLA9RoxVYAQWkav1FvgcqzNgj-hVTM6q4P2qp_KBSFYznCopkyX_E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAWU3Ib2_V_0P8kQXNQD2TXQKrVBZN52SlUbU6JxmUBQ&oe=6AB675E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1635296868116344", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628447_1635296871449677_9138587970399405325_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZwuyt6J3mcQ7kNvwFjp4b2&_nc_oc=AdqHG1R_jtayFQ0ODnK3Eqt4Hcyag1S8A6t9doCxnqNIbJOMpX7mnIAGhS9loMqZDXI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVB28DLcIHejrYZZisovwcW-hrFL-75wh1grgrZXgJ9A&oe=6AB6904B"}, "display_name": "Wall Trace: Mural Drawing Projector", "keywords": ["Painting", "Stencil", "Sketching", "Art", "Creative"], "long_description": "# \ud83d\udea7 Wall Trace is currently in active development!\nWe\u2019re working to make the Mixed Reality wall-drawing experience even more enjoyable and inspiring. Your support, ideas, and feedback help us shape the future of Wall Trace. Please share your comments, impressions, and features you would love to see\u2014we\u2019re looking forward to hearing from you! \ud83c\udfa8\u2728\n\n**Transform Your Room into an Art Studio! \ud83d\udd8c\ufe0f\u2728**\n\nEver wanted to create beautiful wall art with ease? Wall Trace uses Mixed Reality to project images directly onto your physical walls. Simply trace the glowing lines, focus on your strokes, and watch your artwork come to life! \n\n**\ud83c\udfa8 Key Features**\n- **\ud83e\udd7d MR Wall Canvas:** Pin virtual reference images seamlessly onto your real-world walls and adjust the scale to your liking. \n- **\u270f\ufe0f Trace & Enjoy:** Follow the guide lines to trace over a variety of beautiful designs and patterns at your own pace. \n- **\ud83c\udf0c Relaxing Creative Flow:** Focus entirely on your drawing in a calming environment, blending your real room with digital art tools.    \n", "short_description": "Turn your real wall into a canvas! \ud83c\udfa8 Wall Trace: Mural Drawing Projector lets you project reference images onto your physical walls in Mixed Reality. Trace over various designs and enjoy creating stunning art right in your room! \ud83d\udd8c\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "su
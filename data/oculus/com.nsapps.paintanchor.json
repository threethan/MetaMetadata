ame": "02.png", "id": "1600401174906908", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628067_1600401178240241_1850322589347392803_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xG2xoT7250sQ7kNvwEB_P5Q&_nc_oc=AdqobE4xzgvUMwkca8a9uSf3rNA9797u4F-Jp_OqTLw6nBUs4YBCWtEWtAz-L8kmv5Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYzyVfmdrZK2G9SdabenlMRdcVl-14HdQTeDqX_3GBpg&oe=6B01ECEA"}, {"file_name": "03.png", "id": "891215564074632", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628447_891215567407965_3299238203841675936_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyCza2sL20MQ7kNvwGlmAk6&_nc_oc=AdqBUUGbEmf0MKV3G2xETioNk0dxKKQsZR-E__NfXmN7znwnlhnW32JsDIbZxibtDwE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT97B_E4EaiPCojAUfxrDEGMfmyAMGpCIGgpudKlpFZDQ&oe=6B01C85F"}, {"file_name": "04.png", "id": "788283601046419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623131_788283604379752_997724566401550897_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_BdDKWbPc4Q7kNvwE58nDE&_nc_oc=AdpA4AxwGCCTHv6JvfUVO83GZ4XlI11xPw_TelbHjN6MIky69N86r0gVAouADnvzVR4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfOCLp88t6T5IWFNKbP-zAhVBjVyMHWx74OzuYOh2-jQ&oe=6B01CCAD"}, {"file_name": "05.png", "id": "1973436143324185", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620316_1973436149990851_5937739237646169097_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VC8cI_W3YEMQ7kNvwHFen3n&_nc_oc=AdprIUa12IhOWHrWVs2fVzzFUOC-A6YNbUFh_IPhJnd1RfMvClds7k6JI6a6LgkXXdw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKtFX0gKSMkDpocSd6tXVaEAB_-oLBH0j-m5TXeSoeaw&oe=6B01C8F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u3010\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u3011MR\u30b9\u30c8\u30a2\u30a2\u30bb\u30c3\u30c8\u4f5c\u6210\u306e\u30b3\u30d4\u30fc\u306e\u30b3\u30d4\u30fc.png", "id": "1458346082854244", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624656_1458346086187577_8358725005480562757_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmPd1JPTQOcQ7kNvwGMP-y9&_nc_oc=AdqRFGPWlrpAy31cZoGZYmvJqlkF3uP0E6OKqWS0Hu4yAEWAG357L29j0anxJL-ZLpk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAz2YY-c5sH0NkPozf0vpUGS27NAsH-j_SJfDhfUfclA&oe=6B01BFC0"}, "display_name": "Wall Trace: Mural Drawing Projector", "keywords": ["Painting", "Stencil", "Sketching", "Art", "Creative"], "long_description": "**\ud83d\udea7 Wall Trace is currently in active development!** \n\u3000\nWe\u2019re working to make the Mixed Reality wall-drawing experience even more enjoyable and inspiring. Your support, ideas, and feedback help us shape the future of Wall Trace. Please share your comments, impressions, and features you would love to see\u2014we\u2019re looking forward to hearing from you! \ud83c\udfa8\u2728\u3000\n\n{2714364962299140}\n\n\n**Transform Your Room into an Art Studio!** \ud83d\udd8c\ufe0f\u2728\n\nEver wanted to create beautiful wall art with ease? Wall Trace uses Mixed Reality to project images directly onto your physical walls. Simply trace the glowing lines, focus on your strokes, and watch your artwork come to life!\n\n\n### \u30fb**CHOOSE YOUR IMAGE**\n\nStart with one of the included designs or choose an image stored on your Quest.\n\n### \u30fb**PLACE IT ON YOUR WALL**\n\nPosition, resize, and rotate your reference until it fits your space.\n\n{1437750721800966}\n\n\n### \u30fb**TRACING EASIER**\n\nAdjust the opacity while you work. For supported images, simplify the reference by removing the background and changing the line color for clearer outlines.\n\n{1094995996648985}\n\n\n### \u30fb**DRAW IT FOR REAL**\n\nPick up your pencil, marker, or brush and trace the reference directly onto the physical surface.\n\n{1456983309667160}\n\n\n### \u30fb**KEEP YOUR PLACE**\n\nSave your placement and return to your project later without starting over.\n\nThe image is displayed through your Quest headset\u2014the artwork is created by you, on the real wall.\n\nFrom a small sketch to your next mural, Wall Trace gives you a simple way to move a design from screen to surface.", "short_description": "Turn your real wall into a canvas! \ud83c\udfa8 Wall Trace: Mural Drawing Projector lets you project reference images onto your physical walls in Mixed Reality. Trace over various designs and enjoy creating stunning art right in your room! \ud83d\udd8c\ufe0f  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29748917101366894"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623185_1074443605426057_4029009546366025302_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrzI4rBqK0gQ7kNvwHbmcKN&_nc_oc=AdoRKcPruiG9GV6fLUy7gxS95M-rj9eKlBeHnoeBxOWowxJzLqSc8rXnI0yevkRIpzI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjTabl4VMQQy9oZX3CXl2YMZ60uUuEzAEK1
AFF0DF7"}, {"file_name": "28.png", "id": "2616619662116316", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499628108_2616619665449649_657785327434569522_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yQAT5RMSuUQ7kNvwGZKYi1&_nc_oc=AdqjrzlBBhhJM39jk8SLv2LbFKKvecdj1-8oOIEpGeFKwdswPulsZO4u6jDpVauXx6Q&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB01wh9mdBqBRg_xtpEJooGM1FR5GzSvcLYXmkqt5ElQ&oe=6AFF30A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1635296868116344", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628447_1635296871449677_9138587970399405325_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Q7ChJxxfgIQ7kNvwHt8t-h&_nc_oc=AdraQxHPItMlMuEcOlRSE20iL9mqbqwdz0cjnynBM2kZXzS8Ma5bHIFDjy78F28JKco&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBhWL-RIsU3TOi05Blz3Fa1FMm6zgcmoaFkpn-p8OBdA&oe=6AFF12CB"}, "display_name": "Wall Trace: Mural Drawing Projector", "keywords": ["Painting", "Stencil", "Sketching", "Art", "Creative"], "long_description": "# Transform Your Room into an Art Studio! \ud83d\udd8c\ufe0f\u2728 \nEver wanted to create beautiful wall art with ease? Wall Trace uses Mixed Reality to project images directly onto your physical walls. Simply trace the glowing lines, focus on your strokes, and watch your artwork come to life! \n\n# \ud83c\udfa8 Key Features\n**\ud83e\udd7d MR Wall Canvas**: Pin virtual reference images seamlessly onto your real-world walls and adjust the scale to your liking. \n**\u270f\ufe0f Trace & Enjoy**: Follow the guide lines to trace over a variety of beautiful designs and patterns at your own pace. \n**\ud83c\udf0c Relaxing Creative Flow**: Focus entirely on your drawing in a calming environment, blending your real room with digital art tools.\n", "short_description": "Turn your real wall into a canvas! \ud83c\udfa8 Wall Trace: Mural Drawing Projector lets you project reference images onto your physical walls in Mixed Reality. Trace over various designs and enjoy creating stunning art right in your room! \ud83d\udd8c\ufe0f "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28386229654302319"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1957611005195287"}]}, "baseline_offer": {"id": "1957611005195287"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1788745860, "status": "PUBLISHED", "id": "1957611005195287"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29745251475066790", "version": "0.2.1"}, "id": "4510783972540090", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28386229590968992", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29745251475066790"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "
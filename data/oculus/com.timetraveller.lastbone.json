1.png", "id": "1322532666538054", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618254_1322532669871387_172422868932543158_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJ70kx5DicoQ7kNvwGZcea8&_nc_oc=AdqlzSNRDySfAV8MDg_kQQJBVOZpaRhUkARhEAAzxzT_jgPr7lwYga2iy731GsdYxSE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NDMuUB6qBMyegimtTA5Ards62r9U41TdxcdJ100cmuQ&oe=6A0C6EB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "894865453425295", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618103_894865456758628_3509422472554633974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQh2QMJv0iQQ7kNvwEhYlb8&_nc_oc=AdpBbwjF1TYBv2sKHGRNQbPQFYFgRILN1VS0syGoutFc2n4UfEQljAIoJB2E3cloRa8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SRVpGs7aJaOhqSWPGCCif_O58eXsFP8nclWCAkMGmfg&oe=6A0C6A6E"}, "display_name": "Last Bone", "keywords": ["skeleton", "PVP", "PartyGame", "Combat", "Battle"], "long_description": "Welcome to **Last Bone**! Last Bone is a wild multiplayer brawler where silly skeletons run, jump, crash, and bonk each other with ridiculous weapons. Dodge attacks, chase your friends, pull pranks, and survive the chaos \u2014 in Free-for-All, anything can happen, and only the last bone standing wins.\n{1278461714242369}\n\ud83d\udc49Join our Discord: **discord.gg/lastbone**\n\n# Why You\u2019ll Love This Update\n\n\ud83d\udd25 **Arm Factory-Forge Your Own Weapons**\n\nA brand-new forging furnace lets players craft weapons and experiment with different gear before jumping into battle.\n{1256546356544882}\n\ud83d\udca5 **Brawl Mode Gets Wilder**\n\nNew gameplay mechanics and random events keep every fight unpredictable and chaotic.\n{1671513294030340}\n\ud83e\uddb4 **Rip Off Your Enemy\u2019s Arm**\n\nYou can now tear off other players\u2019 arms mid-fight and turn them into weapons.\n{4198812953782028}\n\ud83d\udce6 **Storage Crates**\n\nA new warehouse system lets you store and retrieve items between matches.\n{803503076148856}\n\u2728 **More Ways to Play**\n\nNew skin bundles and a friends system make it easier to customize your skeleton and jump into matches with friends.\n\nThe arena is growing, the fights are getting crazier, \n\nand the chaos is just getting started.", "short_description": "Last Bone is a chaotic multiplayer VR brawler where skeletons with attitude clash in unpredictable arena fights \u2014 crack open blind boxes, forge absurd weapons, and dive into wild brawls full of new tricks, chaos, and ridiculous moments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lastbonevr.com/PrivacyAgreement.html", "developer_terms_of_service_url": "https://www.lastbone.com/terms-of-service", "publisher_name": "TIME TRAVELLER LTD", "support_website_url": "https://discord.gg/lastbone", "website_url": "https://www.lastbone.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "644354873106712"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27154208607513806"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618432_1248519330174944_3951908234298369790_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMgZOrTEdSkQ7kNvwGYXhpU&_nc_oc=Adr1I0FHe9
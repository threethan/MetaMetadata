o_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u97622560 1440.png", "id": "811734504936274", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820586_811734508269607_705023948312638139_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=em4mTbDNtwoQ7kNvwH00TP1&_nc_oc=Adovj-xwD5U5scwRsFY7F3Kj8Tph8531y2tqfS5ZriLMZ-2g0h8ZFAMgiOst6q83_5Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iwxZ8rpWcm56Jx4pz33ibO8OjOlRVF6kNPfoMvt5c3w&oe=6A26EDE2"}, "display_name": "Last Bone", "keywords": ["skeleton", "PVP", "PartyGame", "Combat", "Battle"], "long_description": "Last Bone is a chaotic multiplayer VR brawler where skeletons with attitude clash for glory in a surreal arena.\n\nCrack open blind boxes, arm yourself with ridiculous weapons \u2014 from hammers to rocket-powered chickens \u2014 and dive into fast, unpredictable fights fueled by dark humor and style. Every round is a gamble, every swing a joke that might just hit too hard.\n\nBuilt for players who crave absurd combat, quick laughs, and social chaos, Last Bone turns survival into entertainment \u2014 because in this pit, even losing should feel hilarious.\n\nSomething is brewing beneath the bone pit. Weapons are waiting, the crowd is restless, and only the bold will make history. Join early, shape the madness \n\u2014 discord.gg/lastbone.", "short_description": "Last Bone is a chaotic multiplayer VR brawler where skeletons with attitude clash for glory in a surreal arena \u2014 crack open blind boxes, grab absurd weapons, and dive into hilarious, unpredictable fights where even losing feels fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lastbonevr.com/PrivacyAgreement.html", "developer_terms_of_service_url": null, "publisher_name": "TIME TRAVELLER LTD", "support_website_url": "https://discord.gg/lastbone", "website_url": "https://www.lastbonevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "contex
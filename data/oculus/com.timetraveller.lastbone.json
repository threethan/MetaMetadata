c_sid=6e7a0a&_nc_ohc=zaCVrny1S_IQ7kNvwFjHyBg&_nc_oc=AdrNOJGzIA7dVBZ0fgRmyDiZcXpft1HuV6NdMNmHeVv_9Xo4idrWFbCLxpbSFChHZPs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVNAA8SPhGc825LtXModhaByMRJFd8MDNAxNwoaj0ymyw&oe=6B0EF6CA"}, {"file_name": "1.png", "id": "2405474076531184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299772_2405474079864517_4931484386533207592_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xH3T4Md0HHsQ7kNvwEAiU-_&_nc_oc=AdrxvRoufNxbd69q7_ElaHgRtLAXB340tzrJbYu6tB2OyyFUM4uJFsRKFpAWGNYOygc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU9N5XG5iN7MeTN2OxXoce4ST7Ztrir9WSzFwZ0l-Tckw&oe=6B0EF4B3"}, {"file_name": "3.png", "id": "2153780418737155", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673522158_2153780422070488_3663965655294874456_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DaosrrY35UQ7kNvwGHZsfT&_nc_oc=Adr-Ik4hGEC8AzOPw1nxGC67rrhf6AfHO6Tnkwfna3qUEAgSVEHmg-qaScns3ed2AW0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXgoWhJtOvbLtb2R2uWncsbaedGrsMmgt7kvc-ghFaHKQ&oe=6B0EF8A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1695240588410591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298248_1695240591743924_2685983735895366308_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L40wBt4kLpgQ7kNvwFOLFku&_nc_oc=AdoTd3YCccOWrjFQ1DjkE433GlyRqxIj5mPtvKr2ewPHmQx47H7HTzmpwexdg-TuduQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXzFAww6ZLq-WJeupQOVVNKGnaaNywdvVZ-asc0_J5lCg&oe=6B0EF0B8"}, "display_name": "Last Bone", "keywords": ["skeleton", "PartyGame", "Combat", "Battle", "PVP"], "long_description": "# \ud83d\udc49Join Discord: discord.gg/lastbone\n\nWelcome to Last Bone \u2014 a chaotic multiplayer VR brawler where silly skeletons fight, explore a bigger world, and survive long enough to become the last bone standing\u2620\ufe0f\n{1374775024515875}\n\n\n\ud83d\udc15 MEET STRANGE CREATURES\n\nThe wild is full of strange life. Some creatures can become companions and help carry what you find. Others may not be so friendly. Raise your animal companions, explore together, and watch out for dark skeleton creatures hiding beyond the next corner.\n\n{883831594116547}\n\n\ud83d\udca5 CHAOTIC BRAWLS, NO RULES\n\nJump into fast-paced multiplayer fights full of random events, shifting situations, and complete nonsense. Dodge attacks, turn the fight around, or survive long enough to become the last bone standing.\n\n{1656525545625719}\n\ud83e\uddb4 USE ANYTHING AS A WEAPON\n\nRip off your own arm (or try stealing someone else\u2019s) as a weapon. Experiment in the Arm Factory to forge new gear and create increasingly ridiculous ways to fight.\n\n{1303090108578742}\n\n\ud83c\udf0f A BIGGER WORLD TO GET LOST IN\n\nThe bones are no longer stuck in small arenas. Explore forests, caves, ruins, giant skeleton remains, and hidden corners packed with loot, discoveries, and places worth getting distracted in.\n\nMORE BONES. MORE CHAOS. MORE STORIES TO TELL.", "short_description": "Welcome to Last Bone \u2014 a chaotic multiplayer VR adventure where skeletons explore dangerous wildlands, team up with animal companions, battle cursed creatures, steal epic loot, and survive insane adventures with friends.\u2620\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lastbonevr.com/PrivacyAgreement.html", "developer_terms_of_service_url": "https://www.lastbone.com/terms-of-service", "publisher_name": "TIME TRAVELLER LTD", "support_website_url": "https://discord.gg/lastbone", "website_url": "https://www.lastbone.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "102377078
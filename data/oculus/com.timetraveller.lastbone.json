c_sid=6e7a0a&_nc_ohc=JMcBiH10en0Q7kNvwHdG0dJ&_nc_oc=AdoiVhCh-2EUTElkho7AcV6_cCC_QNVAEIPPvLfWdet91L7XL_iTo8BR3JXdbnyzY8o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQh19Teaxa2xA80SE-TS2iqS-gcXiJaLjMi8UiIfdDEgw&oe=6AFDD34A"}, {"file_name": "1.png", "id": "2405474076531184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299772_2405474079864517_4931484386533207592_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1WZ2YysL0EQ7kNvwHEhMOW&_nc_oc=AdrqPQJdfuFM1UDfkpy5COtrkltvZiaKTh40miGR03vdB6NFiQXnb7slf-_MSc3hSNs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2q1LyNbTLqb6MxubyL2YZOGbYE0fcw5ClGpuRSYw5gA&oe=6AFDD133"}, {"file_name": "3.png", "id": "2153780418737155", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673522158_2153780422070488_3663965655294874456_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQtsRKxkOugQ7kNvwHmQBuo&_nc_oc=AdpK8zR7ql9xfpRJoejbqSVfIeVB24C0z9QP-oa1u5EdCm0o0SW6MW92D2IhWGrcdFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ_MwoG-IWDGurl8mOahBjv-AKWKO_oFR2Uu0iN-dhjw&oe=6AFDD527"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1695240588410591", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298248_1695240591743924_2685983735895366308_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1c6kCHDbqMQ7kNvwHqhrRg&_nc_oc=AdrF_n_klt3ItsOqG6Sw8_ZfLcM5vhx1ZxxAJM3SN3HJlwNMkHUuQZUmYh01YRpkvko&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRJV8PyWP8a1XRhbW8kXek8Cv2zQ7baE93wxvQJuJXRg&oe=6AFDCD38"}, "display_name": "Last Bone", "keywords": ["skeleton", "PartyGame", "Combat", "Battle", "PVP"], "long_description": "# \ud83d\udc49Join Discord: discord.gg/lastbone\n\nWelcome to Last Bone \u2014 a chaotic multiplayer VR brawler where silly skeletons fight, explore a bigger world, and survive long enough to become the last bone standing\u2620\ufe0f\n{1374775024515875}\n\n\n\ud83d\udc15 MEET STRANGE CREATURES\n\nThe wild is full of strange life. Some creatures can become companions and help carry what you find. Others may not be so friendly. Raise your animal companions, explore together, and watch out for dark skeleton creatures hiding beyond the next corner.\n\n{883831594116547}\n\n\ud83d\udca5 CHAOTIC BRAWLS, NO RULES\n\nJump into fast-paced multiplayer fights full of random events, shifting situations, and complete nonsense. Dodge attacks, turn the fight around, or survive long enough to become the last bone standing.\n\n{1656525545625719}\n\ud83e\uddb4 USE ANYTHING AS A WEAPON\n\nRip off your own arm (or try stealing someone else\u2019s) as a weapon. Experiment in the Arm Factory to forge new gear and create increasingly ridiculous ways to fight.\n\n{1303090108578742}\n\n\ud83c\udf0f A BIGGER WORLD TO GET LOST IN\n\nThe bones are no longer stuck in small arenas. Explore forests, caves, ruins, giant skeleton remains, and hidden corners packed with loot, discoveries, and places worth getting distracted in.\n\nMORE BONES. MORE CHAOS. MORE STORIES TO TELL.", "short_description": "Welcome to Last Bone \u2014 a chaotic multiplayer VR adventure where skeletons explore dangerous wildlands, team up with animal companions, battle cursed creatures, steal epic loot, and survive insane adventures with friends.\u2620\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lastbonevr.com/PrivacyAgreement.html", "developer_terms_of_service_url": "https://www.lastbone.com/terms-of-service", "publisher_name": "TIME TRAVELLER LTD", "support_website_url": "https://discord.gg/lastbone", "website_url": "https://www.lastbone.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "102377078
c_sid=6e7a0a&_nc_ohc=A64D2bBWjn0Q7kNvwEPPxqN&_nc_oc=AdqMDeJiM8Y0CijYQcLsad9OaG_qUfWkB-zCxisMNMFQUrmXTYLc6NkvqFhjJu8jQWI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxBlWnjoLby4CSf4azXd6iqrBgWoIDWekdKslTxlPhfg&oe=6AFC81CA"}, {"file_name": "1.png", "id": "2405474076531184", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299772_2405474079864517_4931484386533207592_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1WZ2YysL0EQ7kNvwFjUBtN&_nc_oc=AdoOp5UMVzkYT6I_doXIIQuJLbFs1KitA9sc-1UJtSysd-HLENw-iNDKE_1vd3eJT1s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ5XhyZKVdLGp7IYH6wipZIjvBKW63WYeApF9x_ucpwQ&oe=6AFC7FB3"}, {"file_name": "3.png", "id": "2153780418737155", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/673522158_2153780422070488_3663965655294874456_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQtsRKxkOugQ7kNvwHcxuIG&_nc_oc=Adphhdph9tMjSCfs7KuDZI2AtNWAguP_ySWro9Zj-B-UjDsO4b8DOrSWhNuNwk1lZKg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaH9q2FZLDwqCx-_Xx5_xYjBUXHKvZyF056fHfxiFNJA&oe=6AFC83A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1695240588410591", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298248_1695240591743924_2685983735895366308_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1c6kCHDbqMQ7kNvwEz8xG5&_nc_oc=Adpk_4rxIy51_hrBlxFjZMhTvmH7hc-hKaaozrOkezzq2PCPe6_l-OCpqDQi7xL6x7I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH-XgsniTPn7OrGiyF_AnhgwJ_pMPqciMosHWBR8o-Iw&oe=6AFC7BB8"}, "display_name": "Last Bone", "keywords": ["skeleton", "PartyGame", "Combat", "Battle", "PVP"], "long_description": "# \ud83d\udc49Join Discord: discord.gg/lastbone\n\nWelcome to Last Bone \u2014 a chaotic multiplayer VR brawler where silly skeletons fight, explore a bigger world, and survive long enough to become the last bone standing\u2620\ufe0f\n{1374775024515875}\n\n\n\ud83d\udc15 MEET STRANGE CREATURES\n\nThe wild is full of strange life. Some creatures can become companions and help carry what you find. Others may not be so friendly. Raise your animal companions, explore together, and watch out for dark skeleton creatures hiding beyond the next corner.\n\n{883831594116547}\n\n\ud83d\udca5 CHAOTIC BRAWLS, NO RULES\n\nJump into fast-paced multiplayer fights full of random events, shifting situations, and complete nonsense. Dodge attacks, turn the fight around, or survive long enough to become the last bone standing.\n\n{1656525545625719}\n\ud83e\uddb4 USE ANYTHING AS A WEAPON\n\nRip off your own arm (or try stealing someone else\u2019s) as a weapon. Experiment in the Arm Factory to forge new gear and create increasingly ridiculous ways to fight.\n\n{1303090108578742}\n\n\ud83c\udf0f A BIGGER WORLD TO GET LOST IN\n\nThe bones are no longer stuck in small arenas. Explore forests, caves, ruins, giant skeleton remains, and hidden corners packed with loot, discoveries, and places worth getting distracted in.\n\nMORE BONES. MORE CHAOS. MORE STORIES TO TELL.", "short_description": "Welcome to Last Bone \u2014 a chaotic multiplayer VR adventure where skeletons explore dangerous wildlands, team up with animal companions, battle cursed creatures, steal epic loot, and survive insane adventures with friends.\u2620\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lastbonevr.com/PrivacyAgreement.html", "developer_terms_of_service_url": "https://www.lastbone.com/terms-of-service", "publisher_name": "TIME TRAVELLER LTD", "support_website_url": "https://discord.gg/lastbone", "website_url": "https://www.lastbone.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "102377078
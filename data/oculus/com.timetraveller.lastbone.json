93562566490", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623443_1618493565899823_1835490250523825628_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2gG8pWB9W4Q7kNvwGD9PQl&_nc_oc=Adpz46hYA832h6Npjw2X9_Pn46Az3T9DX8onZIMcudYQJwkRd2AYgshdfSjI-GV9gFQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59kuyLr_sj_lZOtUr_ovbEv5Uz5rB10gJEisqEP2km5g&oe=6A184601"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "kv 2560 1440.png", "id": "3351989254978401", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604302364_3351989258311734_7120831318693124149_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXUJB04qqkMQ7kNvwHsS74x&_nc_oc=Adoy8PIYYgnxdoXaibPwR46tT5w5RmLxgk9VAvGAh7V2qtfmLzAg4gcT67L873jpmcQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6G-bNGfZjAFFJAp53XNHEWeUGxsLHFeBMG8YTDrJxnmQ&oe=6A185CC2"}, "display_name": "Last Bone", "keywords": ["skeleton", "PartyGame", "Combat", "Battle", "PVE"], "long_description": "Welcome to Last Bone \u2014 a chaotic multiplayer VR adventure where skeletons explore dangerous wildlands, team up with animal companions, battle cursed creatures, steal epic loot, and survive insane adventures with friends.\u2620\ufe0f\n\n# NO MORE SMALL ARENA. BONES GO OUTSIDE NOW.\n{4485926878401368}\n\n\ud83d\udc49Join Discord: discord.gg/lastbone\n\n\n\ud83d\udc15 **FIND ANIMAL COMPANIONS**\n\nAdventure with companion creatures that help carry loot, dig up hidden resources, explore dangerous areas, and fight alongside you in the wild.\n\n{883831594116547}\n\u2694\ufe0f **FIGHT DARK SKELETON CREATURES**\n\nYour enemies are no longer just other players. Black cursed skeleton creatures now roam the wild, including dangerous elite enemies that can overwhelm unprepared explorers.\n\n{1648588226374458}\n\ud83c\udf0f **EXPLORE THE WILD & SEARCH FOR LOOT**\n\nThe bones have reached a massive outdoor world filled with forests, caves, ruins, giant skeleton remains, hidden loot, and dangerous discoveries. Break crates, search for valuable collectibles, and bring resources back to camp for rewards and progression.\n\n\ud83d\udd25 **GET STRONGER GEAR**\n\nBring resources back to camp and use the Arm Factory to unlock stronger weapons, better equipment, and more powerful adventure setups.\n\n\u2620\ufe0f **BIGGER WORLD. BIGGER ADVENTURES.**\n\nLast Bone now combines PvP chaos, PvE combat, exploration, creature companions, collection, and co-op survival in one expanding world.", "short_description": "Welcome to Last Bone \u2014 a chaotic multiplayer VR adventure where skeletons explore dangerous wildlands, team up with animal companions, battle cursed creatures, steal epic loot, and survive insane adventures with friends.\u2620\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lastbonevr.com/PrivacyAgreement.html", "developer_terms_of_service_url": "https://www.lastbone.com/terms-of-service", "publisher_name": "TIME TRAVELLER LTD", "support_website_url": "https://discord.gg/lastbone", "website_url": "https://www.lastbone.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27885905594344100"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculu
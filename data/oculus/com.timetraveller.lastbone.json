4574426855572442_394401583629351850_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydxTQgTEt0wQ7kNvwF9tzYM&_nc_oc=AdpRPMi2A2xD2-FSqZwgbzvibiYW2lEsgbJOcgqmerNaxylpcV_u_OFyDiuW9r10Q-0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_t6PRwAF609Hipl26za-z2oV8kyIxfDdZ1L1pDxsmwg&oe=6ADCAE10"}, {"file_name": "5.png", "id": "1379091857068421", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618252_1379091863735087_4308076427470575634_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pr6LACDJaN4Q7kNvwEi_T7j&_nc_oc=AdqgGzZ--RY8m7ZQuEkjoYvx3McEU4fWRTjyTUf5YlrOAcH-EY9MBwVyV1XFXdzmIpE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDpuUbfHWk197uK0BRwVcFCC6l90VWcxvgLvvoMbIayQ&oe=6ADCB388"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u97622560 1440.png", "id": "811734504936274", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820586_811734508269607_705023948312638139_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNQWic7UuPgQ7kNvwG9Y5ly&_nc_oc=Adqo2xOYA7J7xD3HmJqyEZk88UwVtrPDUP4nbBDsURc6fUyvXUylhYKRsTRxvDbMNx0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1IuhxuwtwuCB0HKh8YmzVF5vSE4mmHlm-UEwOqcPzug&oe=6ADCA4A2"}, "display_name": "Last Bone", "keywords": ["skeleton", "PVP", "PartyGame", "Combat", "Battle"], "long_description": "Last Bone is a chaotic multiplayer VR brawler where skeletons with attitude clash for glory in a surreal arena.\n\nCrack open blind boxes, arm yourself with ridiculous weapons \u2014 from hammers to rocket-powered chickens \u2014 and dive into fast, unpredictable fights fueled by dark humor and style. Every round is a gamble, every swing a joke that might just hit too hard.\n\nBuilt for players who crave absurd combat, quick laughs, and social chaos, Last Bone turns survival into entertainment \u2014 because in this pit, even losing should feel hilarious.\n\nSomething is brewing beneath the bone pit. Weapons are waiting, the crowd is restless, and only the bold will make history. Join early, shape the madness \n\u2014 discord.gg/lastbone.", "short_description": "Last Bone is a chaotic multiplayer VR brawler where skeletons with attitude clash for glory in a surreal arena \u2014 crack open blind boxes, grab absurd weapons, and dive into hilarious, unpredictable fights where even losing feels fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lastbonevr.com/PrivacyAgreement.html", "developer_terms_of_service_url": null, "publisher_name": "TIME TRAVELLER LTD", "support_website_url": "https://discord.gg/lastbone", "website_url": "https://www.lastbonevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25415738294694188"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "780769821679191"}]}, "baseline_offer": {"id": "780769821679191"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1766080800, "status": "PUBLISHED", "id": "780769821679191"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28356145580653430", "version": "0.59.0.79"}, "id": "788866680506248", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isA
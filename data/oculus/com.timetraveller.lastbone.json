ion": "Last Bone is a chaotic multiplayer VR brawler where skeletons with attitude clash for glory in a surreal arena.\n\nCrack open blind boxes, arm yourself with ridiculous weapons \u2014 from hammers to rocket-powered chickens \u2014 and dive into fast, unpredictable fights fueled by dark humor and style. Every round is a gamble, every swing a joke that might just hit too hard.\n\nBuilt for players who crave absurd combat, quick laughs, and social chaos, Last Bone turns survival into entertainment \u2014 because in this pit, even losing should feel hilarious.\n\nSomething is brewing beneath the bone pit. Weapons are waiting, the crowd is restless, and only the bold will make history. Join early, shape the madness \n\u2014 discord.gg/lastbone.", "short_description": "Last Bone is a chaotic multiplayer VR brawler where skeletons with attitude clash for glory in a surreal arena \u2014 crack open blind boxes, grab absurd weapons, and dive into hilarious, unpredictable fights where even losing feels fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lastbonevr.com/PrivacyAgreement.html", "developer_terms_of_service_url": null, "publisher_name": "TIME TRAVELLER LTD", "support_website_url": "https://discord.gg/lastbone", "website_url": "https://www.lastbonevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_
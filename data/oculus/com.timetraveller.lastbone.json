1857068421", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618252_1379091863735087_4308076427470575634_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCRAscI_JccQ7kNvwESwSEZ&_nc_oc=AdpjkgTaqEEiD4JU0oJrI00URT53E_FaqT7zJpGtdBgOsC1YGqXJYMJ2lYxvnxMRcGI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QZi42zivD7lYWtJ77jA0PQarsZeF_5kjgp0iEWPGgeQ&oe=6A184408"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u97622560 1440.png", "id": "811734504936274", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820586_811734508269607_705023948312638139_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=af9okeQOyuYQ7kNvwEpYnoH&_nc_oc=AdoWqucpO0rle_mAZ6RWFNzEk5Tv2FCU1Z5UUTSMl6bH_3mrQbtTrAa58xLAVzZit40&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af788J6iot1VtGN0-IZl8mDuUY6w-72CdJg4oGOLn6OqXw&oe=6A183522"}, "display_name": "Last Bone", "keywords": ["skeleton", "PVP", "PartyGame", "Combat", "Battle"], "long_description": "Last Bone is a chaotic multiplayer VR brawler where skeletons with attitude clash for glory in a surreal arena.\n\nCrack open blind boxes, arm yourself with ridiculous weapons \u2014 from hammers to rocket-powered chickens \u2014 and dive into fast, unpredictable fights fueled by dark humor and style. Every round is a gamble, every swing a joke that might just hit too hard.\n\nBuilt for players who crave absurd combat, quick laughs, and social chaos, Last Bone turns survival into entertainment \u2014 because in this pit, even losing should feel hilarious.\n\nSomething is brewing beneath the bone pit. Weapons are waiting, the crowd is restless, and only the bold will make history. Join early, shape the madness \n\u2014 discord.gg/lastbone.", "short_description": "Last Bone is a chaotic multiplayer VR brawler where skeletons with attitude clash for glory in a surreal arena \u2014 crack open blind boxes, grab absurd weapons, and dive into hilarious, unpredictable fights where even losing feels fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lastbonevr.com/PrivacyAgreement.html", "developer_terms_of_service_url": null, "publisher_name": "TIME TRAVELLER LTD", "support_website_url": "https://discord.gg/lastbone", "website_url": "https://www.lastbonevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25415738294694188"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "780769821679191"}]}, "baseline_offer": {"id": "780769821679191"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1766080800, "status": "PUBLISHED", "id": "780769821679191"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27929047770029882", "version": "0.50.0.70"}, "id": "788866680506248", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25415738261360858", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27929047770029882"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "788866680506248"}]}, "change_log
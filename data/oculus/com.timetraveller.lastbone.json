c_sid=6e7a0a&_nc_ohc=laduq6nipuUQ7kNvwGnWvw7&_nc_oc=Adq9M6iW0pwfMgzf9V0BqQByQNYK5z3WhiaWrYmzeaQ29BtBoIUFnJBJtdSqfIBRQVg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAAUSa8TnNewwbVC4gW9lWa---RLIyN2ECq6PMUEl_VA&oe=6B09B0CA"}, {"file_name": "1.png", "id": "2405474076531184", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299772_2405474079864517_4931484386533207592_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nDJyzlyl1wQ7kNvwEN6Z-v&_nc_oc=AdoA0poupG-g8bnaO4eFoi16-HkvsMSRd5fQrrLbP4U9mEri6bWm-UCPgVYno3LErEI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1snDh3DVxQB6iPjw3G37HDUVQXY9rIO3tvhYdMmPR6g&oe=6B09AEB3"}, {"file_name": "3.png", "id": "2153780418737155", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/673522158_2153780422070488_3663965655294874456_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3wVUV8Zc7MQ7kNvwEm9vqF&_nc_oc=Adr_NXy_ZkIQh3aMijGP7p4qcSmuPcvInNISJNGgUJesC-PlttL3GpiJSFq6Q3T5R20&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH7mOj1d3jwUXbX3mXcgyXCGVI63OMifh0I3ySsing0g&oe=6B09B2A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1695240588410591", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298248_1695240591743924_2685983735895366308_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nV9_IYAhOhwQ7kNvwH6XXE6&_nc_oc=AdqcC9Oa3RxUCStAH2Ok36M_8nLcWQ8moq1kMsOWWdn0x5IdX0uKfqorhvhE9JdRFD4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFByDV-7gqW3i6MPcS4_i1jEVy8I7PxFVWHmlX1FB-zQ&oe=6B09AAB8"}, "display_name": "Last Bone", "keywords": ["skeleton", "PartyGame", "Combat", "Battle", "PVP"], "long_description": "# \ud83d\udc49Join Discord: discord.gg/lastbone\n\nWelcome to Last Bone \u2014 a chaotic multiplayer VR brawler where silly skeletons fight, explore a bigger world, and survive long enough to become the last bone standing\u2620\ufe0f\n{1374775024515875}\n\n\n\ud83d\udc15 MEET STRANGE CREATURES\n\nThe wild is full of strange life. Some creatures can become companions and help carry what you find. Others may not be so friendly. Raise your animal companions, explore together, and watch out for dark skeleton creatures hiding beyond the next corner.\n\n{883831594116547}\n\n\ud83d\udca5 CHAOTIC BRAWLS, NO RULES\n\nJump into fast-paced multiplayer fights full of random events, shifting situations, and complete nonsense. Dodge attacks, turn the fight around, or survive long enough to become the last bone standing.\n\n{1656525545625719}\n\ud83e\uddb4 USE ANYTHING AS A WEAPON\n\nRip off your own arm (or try stealing someone else\u2019s) as a weapon. Experiment in the Arm Factory to forge new gear and create increasingly ridiculous ways to fight.\n\n{1303090108578742}\n\n\ud83c\udf0f A BIGGER WORLD TO GET LOST IN\n\nThe bones are no longer stuck in small arenas. Explore forests, caves, ruins, giant skeleton remains, and hidden corners packed with loot, discoveries, and places worth getting distracted in.\n\nMORE BONES. MORE CHAOS. MORE STORIES TO TELL.", "short_description": "Welcome to Last Bone \u2014 a chaotic multiplayer VR adventure where skeletons explore dangerous wildlands, team up with animal companions, battle cursed creatures, steal epic loot, and survive insane adventures with friends.\u2620\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lastbonevr.com/PrivacyAgreement.html", "developer_terms_of_service_url": "https://www.lastbone.com/terms-of-service", "publisher_name": "TIME TRAVELLER LTD", "support_website_url": "https://discord.gg/lastbone", "website_url": "https://www.lastbone.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "102377078
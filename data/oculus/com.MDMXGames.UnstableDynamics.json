5/491819859_844303445308845_6616443227862014527_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6O1GMbVR4kIQ7kNvwFm9aSY&_nc_oc=AdoxbNF1oU6NbJGlqrywQHaQzZK-6fLkVaugOp5g2wbJD-acgjVtHOMsk-pr18EV1PQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfVVJxCkRbez0is0E6f3hfl-4yzxYwAAluD_UVMZODug&oe=6A9ED24D"}, {"file_name": "vlcsnap-2026-02-28-17h45m31s929.png", "id": "2766657360393111", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820141_2766657363726444_3872117974057320645_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4qKpASbkvsQ7kNvwEtwrZX&_nc_oc=Adp0rO2xu92q4fG2rU6Q1QPz4k78U-3re3PGdagK3nM5-d1FHMng78lypK5_dWX86iE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMYd0ORwKYFgzyE2tuBugv1q-VgiEDkE7GgejOXS6IbQ&oe=6A9EAFEB"}, {"file_name": "4-d41493c1.png", "id": "923590223488562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818885_923590226821895_5754057162106346575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3-0yLkDixcQ7kNvwFBW6Wp&_nc_oc=AdroTqtqZG8WYdFLNx1YoweWwg338BgQNasBAZEKvWI7oSLtejA2EO1err6pdPcwD-o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMloX3cojzWzqeO04YVVnq2Q6QzXIyMXa4TL3YXvvHUg&oe=6A9EC3F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Unstable_trailer_thumbnail_KEYART_2560x1440.png", "id": "1687743545835099", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312454_1687743549168432_1680906289046014958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-skihnZWCygQ7kNvwETsCxo&_nc_oc=Adq4OzFKrNND6YjiBcy9ZblTiXs2DKp9NnSDaiK9rHclWlPTMKpdRkfos0FOtAPrEMQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCsVjTavLJY0lTVuOCFFeU5ObCEbUCj9Nt939SVx5VyA&oe=6A9ED1DF"}, "display_name": "Unstable Dynamics: Robot Destruction", "keywords": ["Physics", "Sandbox", "Fighting", "Robot", "Destruction"], "long_description": "**Some robots are built to survive anything. This one just has to survive you.**\n\nWelcome to MDMX Labs, where the world's most advanced (and suspiciously wobbly) humanoid - Unit EDISON - is yours to take apart, with 25+ weapons across a stack of arenas. We call it \"Percussive Maintenance.\" Every dent is cash; cash funds bigger weapons; bigger weapons make bigger dents.\n\n\n**FEEL EVERY IMPACT**\n\n{1324919725861896}\nActive Ragdoll physics means Edison reacts to every hit, flailing to keep balance in hilarious ways. Feel the *crunch* as a well-thrown chair sends it stumbling.\n\n**WITNESS REAL-TIME DESTRUCTION**\n\n{1727026741974636}\nDents, scratches, and oil leaks spread across the chassis as you fight. No two beatdowns ever look the same.\n\n**GAME FEATURES**\n\n- **CASH IN on Chaos:** every dent adds to the repair bill. Damage = profit, so chase the biggest score.\n- **UNLOCK 25+ weapons & gadgets** across 9 R&D tiers, from a humble mop to gravity guns and one very illegal minigun.\n- **CLIMB from Janitor to the Board of Directors**, unlocking surreal arenas from the lab to the Moon.\n\n- **SURVIVE Endless Mode:** infinite robots, infinite chaos.\n\n{1392388432945003}\n\n**EARLY ACCESS**\n\nJump in now and help shape the future of robot destruction. More bots, arenas, and wilder tools are coming, and your feedback steers the ship.\n\n{3158654234523713}\n\n\ud83d\udc49 **Join our Discord:** https://discord.gg/ScUYumVFKN\n\nLet's create some chaos together!", "short_description": "Some robots are built to survive anything. This one just has to survive you. Take Unit EDISON apart with 25+ weapons across a stack of arenas - every dent is cash, and the more it breaks, the more you earn. Welcome to MDMX Labs: endless, physics-based chaos where damage equals profit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdmxgames.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "MDMX Games", "support_website_url": null, "website_url": "https://www.mdmxgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfo
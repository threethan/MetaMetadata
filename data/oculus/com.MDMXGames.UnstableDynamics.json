ent-lga3-1.oculuscdn.com/v/t64.5771-25/491823790_1218234557006814_4146735336299967896_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zh7lOQ9iKtIQ7kNvwGANTfe&_nc_oc=AdogHsfi0OmP5Ymx3DpWkbgc78PFVfCxTg2qt6tgrhn-YqR2VvAYnMPUNomqUHZ3U4w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTf2hsfYOD_BgpvpBWmq8QVOcLtvTDWoxm1jZz8LBSJXA&oe=6AE8B7CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Unstable Dynamics", "keywords": ["Physics", "Sandbox", "Fighting", "Robot", "Destruction"], "long_description": "**Welcome to the Labs, the future of... Quality Assurance.**\n\nForget boring bug reports. In Unstable Dynamics, your job is to test the limits of the world's most advanced (and suspiciously wobbly) humanoid robot, Unit EDISON. We call it \"Percussive Maintenance\".\n\n**FEEL EVERY IMPACT**\n\nPowered by advanced Active Ragdoll physics, Edison reacts to every hit, trying to maintain balance in hilarious, unpredictable ways. Feel the satisfaction as a well-thrown chair connects perfectly, sending the bot stumbling.\n\n**GAME FEATURES:**\n- **MASTER Advanced VR Physics:** Interact with everything in the lab. Grab, throw, smash. If you can see it, you can use it as a weapon.\n\n- **WITNESS Real-Time Destruction:** Watch dents, scratches, and oil leaks appear dynamically on Edison's pristine chassis as you fight.\n\n- **DRIVE the Chaos Economy:** Every dent adds dollars to the repair bill. Rack up the highest score by causing maximum financial damage!\n\n- **UNLOCK a Tester's Arsenal:** Find and master over 20 weapons and tools, from a trusty baseball bat to experimental gravity devices.\n\n\n**STATUS: EARLY ACCESS**\n\nUnstable Dynamics is currently in Early Access. Join us now to help shape the future of robot destruction! We have plans for more bot models, new testing arenas, and even wilder tools. Your feedback is crucial, **join our Discord to get involved!**", "short_description": "Your job: Stress test a multi-billion dollar robot until it breaks. Earn cash, research new weapons, and climb the R&D ranks. Enter MDMX Labs for endless, physics-based chaos where damage equals profit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdmxgames.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "MDMX Games", "support_website_url": null, "website_url": "https://www.mdmxgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26454273160832467"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "27910486028601945"}, {"status": "PUBLISHED", "id": "1522257995494464"}, {"status": "PUBLISHED", "id": "1688063232266209"}, {"status": "PUBLISHED", "id": "1763410057797046"}]}, "baseline_offer": {"id": "1522257995494464"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "27910486028601945"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28851035944489498", "version": "0.039"}, "id": "1819673618698925", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applica
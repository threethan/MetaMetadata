6IbQ&oe=6A9EAFEB"}, {"file_name": "vlcsnap-2026-02-28-17h37m29s096.png", "id": "1278980744104358", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491829165_1278980747437691_2056458455083321263_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7fphj-FcckQ7kNvwHxCOY9&_nc_oc=AdqQEBqMfc1I9PiT8gdAu5JQ03gRyL_q2XjLIwAdJGoCBtxDRbDO-jC5BIxVJ5Ro-ec&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzqX91kVp_a5hTMsICHC77mCt27SqOuuJ9O_zCPQXWaA&oe=6A9EB112"}, {"file_name": "vlcsnap-2026-02-28-17h40m52s990.png", "id": "844303441975512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819859_844303445308845_6616443227862014527_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6O1GMbVR4kIQ7kNvwFm9aSY&_nc_oc=AdoxbNF1oU6NbJGlqrywQHaQzZK-6fLkVaugOp5g2wbJD-acgjVtHOMsk-pr18EV1PQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfVVJxCkRbez0is0E6f3hfl-4yzxYwAAluD_UVMZODug&oe=6A9ED24D"}, {"file_name": "4-d41493c1.png", "id": "923590223488562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818885_923590226821895_5754057162106346575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3-0yLkDixcQ7kNvwFBW6Wp&_nc_oc=AdroTqtqZG8WYdFLNx1YoweWwg338BgQNasBAZEKvWI7oSLtejA2EO1err6pdPcwD-o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMloX3cojzWzqeO04YVVnq2Q6QzXIyMXa4TL3YXvvHUg&oe=6A9EC3F2"}, {"file_name": "vlcsnap-2026-02-28-17h35m34s375.png", "id": "1218234553673481", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_1218234557006814_4146735336299967896_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZl1TiMbKysQ7kNvwGGrPLo&_nc_oc=AdqG7GvI-rw4xrfaq0sxNjdGmBLHNNqN_sjzUaV2MBq5BDEIMbkyES9MH0pudmLdbJY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKq06o7_VjViIXWGcud_dX7klqNrorQq4yH-SyoZq7z0A&oe=6A9EE3CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Unstable Dynamics", "keywords": ["Physics", "Sandbox", "Fighting", "Robot", "Destruction"], "long_description": "**Welcome to the Labs, the future of... Quality Assurance.**\n\nForget boring bug reports. In Unstable Dynamics, your job is to test the limits of the world's most advanced (and suspiciously wobbly) humanoid robot, Unit EDISON. We call it \"Percussive Maintenance\".\n\n**FEEL EVERY IMPACT**\n\nPowered by advanced Active Ragdoll physics, Edison reacts to every hit, trying to maintain balance in hilarious, unpredictable ways. Feel the satisfaction as a well-thrown chair connects perfectly, sending the bot stumbling.\n\n**GAME FEATURES:**\n- **MASTER Advanced VR Physics:** Interact with everything in the lab. Grab, throw, smash. If you can see it, you can use it as a weapon.\n\n- **WITNESS Real-Time Destruction:** Watch dents, scratches, and oil leaks appear dynamically on Edison's pristine chassis as you fight.\n\n- **DRIVE the Chaos Economy:** Every dent adds dollars to the repair bill. Rack up the highest score by causing maximum financial damage!\n\n- **UNLOCK a Tester's Arsenal:** Find and master over 20 weapons and tools, from a trusty baseball bat to experimental gravity devices.\n\n\n**STATUS: EARLY ACCESS**\n\nUnstable Dynamics is currently in Early Access. Join us now to help shape the future of robot destruction! We have plans for more bot models, new testing arenas, and even wilder tools. Your feedback is crucial, **join our Discord to get involved!**", "short_description": "Your job: Stress test a multi-billion dollar robot until it breaks. Earn cash, research new weapons, and climb the R&D ranks. Enter MDMX Labs for endless, physics-based chaos where damage equals profit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdmxgames.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "MDMX Games", "support_website_url": null, "website_url": "https://www.mdmxgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534
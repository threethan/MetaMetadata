.png", "id": "1486285950015023", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673573223_1486285953348356_3448976701334597793_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3NkAMLEzHMQ7kNvwG_oLel&_nc_oc=AdpIFWbSFqwYGInH4TCY5mR-FiJ6vDtIRbNBRsLeQTmmk43OYWSLhoEH_Ig-HkGUr-g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCeOLb0OfBzeCYp3sK5Vqenh8ucdDNd2r519V47PGzXA&oe=6AEDF9AC"}, {"file_name": "ikona_1a.png", "id": "1471130888058537", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820428_1471130891391870_484651133097133001_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ua3HLHWosdkQ7kNvwH2zXUP&_nc_oc=AdrTd1WN2ktlqaaVCO5efR3wFBLGF8zXBZlBTe4H5HRbT4OSm8nh7BP8ABgpHFHzGHQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHpFwcT3p6HMC5h14h5kOUDp0-_I-sfTt9f5Epzas7GQ&oe=6AEDD9F8"}]}, "id": "1440094114974823", "locale": "en_US", "screenshots": [{"file_name": "vlcsnap-2026-02-28-17h35m34s375.png", "id": "1218234553673481", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_1218234557006814_4146735336299967896_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2taD3xtg-kYQ7kNvwEU4EPk&_nc_oc=AdqmMpEP4_JGz8MFBD0ODrG3c85a0eNJXU1oWbuBfA8plJLMQlGl7heiLVbCSsbIZtE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpViYQZbK1XcwGskUt7dIjXylq3mLcCe49aQ1FEKn5VQ&oe=6AEDFDCB"}, {"file_name": "vlcsnap-2026-02-28-17h37m29s096.png", "id": "1278980744104358", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491829165_1278980747437691_2056458455083321263_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iac3VKQM_2cQ7kNvwEZ1fvc&_nc_oc=AdoerzYfCeMlYVOWWDKg0ZHxQK7Hs1qImG2ADYpK_ebf_d1mPs3RcnhYilzASzInCN0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRua_H4-lD5HJOklLOoOt6OgZBMiZj2zdb9ABjo6TyPeQ&oe=6AEE0352"}, {"file_name": "vlcsnap-2026-02-28-17h40m52s990.png", "id": "844303441975512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819859_844303445308845_6616443227862014527_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wx8_7kl2mCwQ7kNvwEAvj40&_nc_oc=AdoE58z7FoXBeIElxGMga3OnlpOry91842Ivn16XNPNnhGOTX2ZoOD5Mndn5tZQ1WGo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRx7vfV201OfQ0MhXyJk4-fmcD7mlrumZe0FUkWk5incA&oe=6AEDEC4D"}, {"file_name": "vlcsnap-2026-02-28-17h45m31s929.png", "id": "2766657360393111", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820141_2766657363726444_3872117974057320645_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eY7ymcLyPRQQ7kNvwGG2n7Z&_nc_oc=Adr5qQi_frLljo3kuAN3-gWPHRwoS_OdQz-r2dunYoEN9GFcRQc0K5LSF6nXeHgnw_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjiB-2yOPfmPaGiX8_nrAyjXedrC0ETQwBOjRpU49NBQ&oe=6AEE022B"}, {"file_name": "4-d41493c1.png", "id": "923590223488562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818885_923590226821895_5754057162106346575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0RzzWl31VAQQ7kNvwFqFjeW&_nc_oc=AdoJ84cCzgAVMiEOW7ySH391keUKoUnXAMbAgEm8jAw5r6nIVRdIEOa60meowJqjFsg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCPzoezcG-YBZBSN4_nXEUyjzip7M_V8SbBfKexfTOmw&oe=6AEDDDF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Unstable_trailer_thumbnail_KEYART_2560x1440.png", "id": "1687743545835099", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312454_1687743549168432_1680906289046014958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPVIFM1-8lgQ7kNvwGLzuZD&_nc_oc=AdohiYAQXnWdtBf7dUmx-wdYWIqpaf0kNF8P5sy676Z00ZlqwDo0sk0UxdRsbhkW7Vs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLwBqJJl3BEel616oXpyIJHLeCWAavLkTX0MNYKfoOOA&oe=6AEDEBDF"}, "display_name": "Unstable Dynamics: Robot Destruction", "keywords": ["Physics", "Sandbox", "Fighting", "Robot", "Destruction"], "long_description": "**Smash, shoot and ragdoll humanoid robots in a VR physics sandbox. Some robots are built to survive anything. These ones just have to survive you.**\n\nWelcome to MDMX Labs, where the world's most advanced (and suspiciously wobbly) robots are yours to take apart with 25+ weapons. Every dent is cash; cash funds bigger weapons; bigger weapons make bigger dents.\n\n**NEW: ED-WARD + UP TO 3 ROBOTS AT ONCE**\n\nEd-Ward has sixteen armor plates to tear off and pays triple per dent. Sandbox now fits up to three robots in one room.\n\n**FEEL EVERY IMPACT**\n\n{1324919725861896}\nActive ragdoll physics: every robot flails to keep its balance. Throw a chair, swing a bat, land a punch.\n\n**WITNESS REAL-TIME DESTRUCTION**\n\n{1727026741974636}\nDents, scratches and oil leaks spread across the chassis as you fight.\n\n**GAME FEATURES**\n\n- **RAGE ROOM SANDBOX:** everything unlocked from the first second.\n- **25+ weapons** across 9 R&D tiers, from a mop to one very illegal minigun.\n- **ARENAS** from the lab to the Backrooms, a jump park, a boxing ring and the Moon.\n- **CAREER:** climb from Janitor to the Board of Directors.\n- **ENDLESS MODE:** infinite robots, infinite chaos.\n\n{1392388432945003}\n\n**EARLY ACCESS**\n\nMore robots, arenas and wilder tools are coming, and your feedback steers the ship.\n\n{3158654234523713}\n\n\ud83d\udc49 **Join our Discord:** https://discord.gg/ScUYumVFKN", "short_description": "Some robots are built to survive anything. This one just has to survive you. Take Unit EDISON apart with 25+ weapons across a stack of arenas - every dent is cash, and the more it breaks, the more you earn. Welcome to MDMX Labs: endless, physics-based chaos where damage equals profit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdmxgames.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "MDMX Games", "support_website_url": null, "website_url": "https://www.mdmxgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326
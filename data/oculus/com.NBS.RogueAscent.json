9036668_323636767091551_1691607134324429990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUrConp2zKoQ7kNvwEnpAy9&_nc_oc=Adqd4XV-Vip0tQkuMv6EbHwa3S5KUQu2ph32M-GefG16A0I2OQ01w8_bn_LQWImR2ew&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ibfvsDBFALBdNTTYX7tUzDPBhy3TzyGvNrCrHYt9Rjw&oe=6A11CFAE"}, {"file_name": "rass2.png", "id": "898919459110498", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39035332_898919462443831_6995111049763187755_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7j8_lVCxAMQ7kNvwEU29_n&_nc_oc=Adpr2XgDj2X9wxbFafuPm3ODRK2oyZh-9CxKAQ6Db5egGZhhIolgh7AM6YZnIa_1XXM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ntqseExP9dPA9JKy29KQaRz2bjXAeBzCjCAICaE7l4A&oe=6A11C5F2"}, {"file_name": "Screenshot_Bridge_01.png", "id": "1031201894811272", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75520121_1031201898144605_7374826040376756589_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HBrRNMdgmgQ7kNvwGCdRnW&_nc_oc=AdqGfuMyEsHrz_TrjCAMAgbCk5MKKiYhG8PBH2ZRAYBDq6nVqr0Cef5EiiLcbTjlnSg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4H3Tinjukm7Uz0xD5LhBYCQV_Cs3ykTtFfhZQhIhjUOw&oe=6A11A063"}, {"file_name": "Screenshot_Rogue_01.png", "id": "24178243448488031", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75334061_24178243461821363_8444984069212333615_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x69gLY3f_10Q7kNvwEynpZ8&_nc_oc=AdoymBEVrln1Jy1zaVia6bG5oGj6_VLrkF5V8q_YsI5YzMOeSeCtromrLVDyG5FrIqA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XdU3qX9J2Abt6gXTWpmXaIGzE0xwhQrQ6gGgtWLwrgg&oe=6A11D064"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ranewcover1.png", "id": "3809332442613286", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035327_3809332445946619_2929006835365873947_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YHxghEck3YQ7kNvwGoEZX6&_nc_oc=Adp3TK1RwQpgq6wENT0P3eAkBcqy3BbKkLJFD2xwZgDt3r_WUT3fsbg78Wmsjlo0J_U&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70ECSaBmenvfMh96ywX5XR7jfK2gy4Uj9cF-VR_dGpnA&oe=6A11BF3C"}, "display_name": "Rogue Ascent VR", "keywords": ["handtracking", "survival", "action", "shooter", "roguelike"], "long_description": "#                                                                                                                                                                                                      \n{902179625398953}\n\nThe power is in your hands\u2026 literally!\n\nRogue Ascent VR is a roguelike shooter **specially developed for Meta Quest hand-tracking technology.**\n\n=-=-=-=-=-=-=\n\n**Hands-On Action:** Attack & move with just a few quick motions! Intuitive motion controls allow you to blast your way through hostile forces without ever lifting a controller.\n\n{9586424071386176}\n\n# Controls:\n- \ud83d\udc49Shoot with finger guns!\n- \ud83d\udc4aBlock by making fists!\n- \ud83e\udef3Teleport by holding your hand out!\n- \ud83d\udd90\ufe0fOpen & close your palm to use abilities!\n- \ud83e\udd0fPinch your fingers to interact with kiosks & UI!\n\n**Loot & Shoot** Discover & combine different weapons, attachments, & gadgets to create the ultimate arsenal. Harness abilities, perks, & powerups to outmaneuver your foes.\n\n{2008919219549019}\n\n**Ever-Changing Challenges:** In true roguelike fashion, procedurally generated levels, enemy spawns, bosses, & items make every run a unique experience.\n\n{1766433484142541}\n\n**Sandbox Mode:** Flex your creativity & create unique runs using the Sandbox, which contains weapon modding stations, quick-play scenarios, NPC customization, & more.\n", "short_description": "\ud83d\udc49Save the World with Finger Guns!\ud83d\udc49\n\nThe power in your hands\u2026literally!\n\nRogue Ascent VR is a roguelike shooter specially developed for Meta Quest hand-tracking technology.\n\nHands-On Action: Attack and move with just a few quick motions! Intuitive motion controls allow you to blast your way through hostile forces without ever lifting a controller."}]}, "developer_name": "Nooner Bear Studio LLC", "developer_privacy_policy_url": "https://www.clique.games/privacy-policy/", "developer_terms_of_service_url": "https://www.clique.games/termsofuse", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.rogueascent.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "fr", "da", "it", "ko", "ja", "de"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27633050152963968"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75195911_925860942383610_3366191453423522746_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzYGsRfUYC8Q7kNvwH9mhOt&_nc_oc=AdojhIVIQtL3DtSFkJMuo5BDZGfabv13CDlsGD5USMPAGW62ihQluGeg1xtdo72UG3A&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OlkFY6fX3gRiZDHvURvwpE8tITNqnxFnYbtIDdkzsaQ&oe=6A11A869"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rogue Ascent VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topi
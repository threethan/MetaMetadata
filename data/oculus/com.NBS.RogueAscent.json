3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBs3rpch86ieb3UUmlvqzUC8IUK82Y2ZdKfn9QB5li8iQ&oe=6A53AA3C"}, "display_name": "Rogue Ascent VR", "keywords": ["handtracking", "survival", "action", "shooter", "roguelike"], "long_description": "#                                                                                                                                                                                                      \n{902179625398953}\n\nThe power is in your hands\u2026 literally!\n\nRogue Ascent VR is a roguelike shooter **specially developed for Meta Quest hand-tracking technology.**\n\n=-=-=-=-=-=-=\n\n**Hands-On Action:** Attack & move with just a few quick motions! Intuitive motion controls allow you to blast your way through hostile forces without ever lifting a controller.\n\n{9586424071386176}\n\n# Controls:\n- \ud83d\udc49Shoot with finger guns!\n- \ud83d\udc4aBlock by making fists!\n- \ud83e\udef3Teleport by holding your hand out!\n- \ud83d\udd90\ufe0fOpen & close your palm to use abilities!\n- \ud83e\udd0fPinch your fingers to interact with kiosks & UI!\n\n**Loot & Shoot** Discover & combine different weapons, attachments, & gadgets to create the ultimate arsenal. Harness abilities, perks, & powerups to outmaneuver your foes.\n\n{2008919219549019}\n\n**Ever-Changing Challenges:** In true roguelike fashion, procedurally generated levels, enemy spawns, bosses, & items make every run a unique experience.\n\n{1766433484142541}\n\n**Sandbox Mode:** Flex your creativity & create unique runs using the Sandbox, which contains weapon modding stations, quick-play scenarios, NPC customization, & more.\n", "short_description": "\ud83d\udc49Save the World with Finger Guns!\ud83d\udc49\n\nThe power in your hands\u2026literally!\n\nRogue Ascent VR is a roguelike shooter specially developed for Meta Quest hand-tracking technology.\n\nHands-On Action: Attack and move with just a few quick motions! Intuitive motion controls allow you to blast your way through hostile forces without ever lifting a controller."}]}, "developer_name": "Nooner Bear Studio LLC", "developer_privacy_policy_url": "https://www.clique.games/privacy-policy/", "developer_terms_of_service_url": "https://www.clique.games/termsofuse", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.rogueascent.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "fr", "da", "it", "ko", "ja", "de"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27633050152963968"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75195911_925860942383610_3366191453423522746_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HX1Z3eXSWewQ7kNvwFpGqej&_nc_oc=AdpYiNSDdPQv9qzrokdEiYtGEDgru1WCVJ9hVYocIZi1J6szgbQHKgc8XwEAYguPw9s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA47_LrRoKwwoQ7KSjCOKAjHu6f2LqQRnFkliVP-adwfw&oe=6A539369"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rogue Ascent VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id":
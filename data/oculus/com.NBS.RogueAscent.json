51_1691607134324429990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUrConp2zKoQ7kNvwHAEAUm&_nc_oc=AdoLFuS6N0LAjgB-3GIl__ORhRS0ZYPGOnjEjeHuWhvBnwhNAPgMHVdeI6GQ4V8GVQM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kmoEyH7bmyOCLUZbCtK0Vr_E0Lq5FxIA9FcFvtdxFkg&oe=6A0EF46E"}, {"file_name": "rass2.png", "id": "898919459110498", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035332_898919462443831_6995111049763187755_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8edvjECXu0Q7kNvwEtewNm&_nc_oc=AdoqCfk__UTZMwiut0lF8_c6pOkCjGIupm1AD3FImkYDGf2EU8sqBnJD3beMb3zVUBI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7d5ShkmEf9-CGNm_oqZeKQ1L8pjovBwXPbLzc8rW92GQ&oe=6A0F22F2"}, {"file_name": "Screenshot_Bridge_01.png", "id": "1031201894811272", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75520121_1031201898144605_7374826040376756589_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HBrRNMdgmgQ7kNvwFMbtv3&_nc_oc=AdoNuHOwDKsPNRc1BTi7kvHf3LMgNzfg3fbThT9TfS8dvaVy_cceEZR0FWn4wEZYiJA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Pa9M2S_Fufysk0TiJId9jLEYjM_M4q8zQo1QIbhoiIg&oe=6A0EFD63"}, {"file_name": "Screenshot_Rogue_01.png", "id": "24178243448488031", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75334061_24178243461821363_8444984069212333615_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYwhW-GSiRcQ7kNvwE0aTnb&_nc_oc=AdpaKcNJOvrIFOa8Goqsuryh4GdVG4xh-Yz9o5fmfsQVDHASU9ANTzbFSfr7YHk28to&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RwNwQPpsfP0sIpR6yGqo3m4vaHRBKe9_3EV3_vqctvA&oe=6A0EF524"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ranewcover1.png", "id": "3809332442613286", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035327_3809332445946619_2929006835365873947_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YHxghEck3YQ7kNvwFTmeD8&_nc_oc=AdpzkyWUKj-cgbolstU2Gv5cmcQOPOEuOx25Xfck58Vi9uwl7Z62t9sDHA1LivS1aHw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YUwDCsuIsQBSXM2YoyVqwoCPFyitxibUJUF4fR1wbzQ&oe=6A0F1C3C"}, "display_name": "Rogue Ascent VR", "keywords": ["handtracking", "survival", "action", "shooter", "roguelike"], "long_description": "#                                                                                                                                                                                                      \n{902179625398953}\n\nThe power is in your hands\u2026 literally!\n\nRogue Ascent VR is a roguelike shooter **specially developed for Meta Quest hand-tracking technology.**\n\n=-=-=-=-=-=-=\n\n**Hands-On Action:** Attack & move with just a few quick motions! Intuitive motion controls allow you to blast your way through hostile forces without ever lifting a controller.\n\n{9586424071386176}\n\n# Controls:\n- \ud83d\udc49Shoot with finger guns!\n- \ud83d\udc4aBlock by making fists!\n- \ud83e\udef3Teleport by holding your hand out!\n- \ud83d\udd90\ufe0fOpen & close your palm to use abilities!\n- \ud83e\udd0fPinch your fingers to interact with kiosks & UI!\n\n**Loot & Shoot** Discover & combine different weapons, attachments, & gadgets to create the ultimate arsenal. Harness abilities, perks, & powerups to outmaneuver your foes.\n\n{2008919219549019}\n\n**Ever-Changing Challenges:** In true roguelike fashion, procedurally generated levels, enemy spawns, bosses, & items make every run a unique experience.\n\n{1766433484142541}\n\n**Sandbox Mode:** Flex your creativity & create unique runs using the Sandbox, which contains weapon modding stations, quick-play scenarios, NPC customization, & more.\n", "short_description": "\ud83d\udc49Save the World with Finger Guns!\ud83d\udc49\n\nThe power in your hands\u2026literally!\n\nRogue Ascent VR is a roguelike shooter specially developed for Meta Quest hand-tracking technology.\n\nHands-On Action: Attack and move with just a few quick motions! Intuitive motion controls allow you to blast your way through hostile forces without ever lifting a controller."}]}, "developer_name": "Nooner Bear Studio LLC", "developer_privacy_policy_url": "https://www.clique.games/privacy-policy/", "developer_terms_of_service_url": "https://www.clique.games/termsofuse", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.rogueascent.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "fr", "da", "it", "ko", "ja", "de"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27633050152963968"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75195911_925860942383610_3366191453423522746_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zqt2px9JYBIQ7kNvwFpr2qs&_nc_oc=AdrCC2yYRmYnIgSaE8-xyhpP2dmUIRfxpQyQJ_Mk5j8YEqMdOeqV_kZL40FqA3guNxk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JyVuF0AGhrY_SkYL5haY0On_Rl1T6uk0FzT1cQzf_2A&oe=6A0F0569"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rogue Ascent VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id":
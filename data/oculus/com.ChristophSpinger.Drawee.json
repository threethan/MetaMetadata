8&oh=00_AfxdWRZFs-Lg86zrrgfvG03_WOGMMyUxExFkfdSkn0k_jw&oe=69BAB3E1"}, {"file_name": "Screenshot4Drawee.png", "id": "1474644673767352", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820382_1474644677100685_6299369456080799575_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8Ycn3rfdDEQ7kNvwGMF_ka&_nc_oc=AdldRanfimXbyX7AMDIj6pl7oLSfUpV1DUboXEwSIZirEJHQ0g6CnM0asmt6yF_6Vb0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxbx9U6BSl0FpETGQETUMSzXQY1um3fItB7_SQ3jNH49g&oe=69BA8F49"}, {"file_name": "Screenshot8Drawee.png", "id": "807644472265170", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820523_807644475598503_5035153927987790493_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_GiP2s6tLoQ7kNvwHt0scv&_nc_oc=Adl1HSDGNib3StQzwCd1BRwG5q-sgoTsI7Xn9nMWczMoqMPaDS0MvP7otmFrfXjENhE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwN6MfknIt752aZBtClo2UMTAw3qhyapk1kML7xPoNRnw&oe=69BAA5D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "781925581315466", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818885_781925587982132_3820792127821152661_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TimncmMP-sQ7kNvwFqQcfH&_nc_oc=AdmuarKoBnujBX-B4An-4yeMTtIibzHPXVzQRsz6PXBTw2JYhnrXcU3al3UCNs7HLeo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz7UfOBZxKwinrzFOw3Svh8xH6ucTpx17WXHZ0Apv-X8Q&oe=69BAB4A3"}, "display_name": "Drawee", "keywords": ["Art", "Design", "Draw", "Painting", "MixedReality"], "long_description": "Drawee is a mixed reality drawing app for Meta Quest 3 where your real world becomes your only color palette. Every stroke is created by sampling the environment around you. There are no artificial colors and no presets. Everything you create comes directly from reality.\n\nPaint in true spatial MR with 3D tools, live video brushes, and export options that are ready for 3D printing.\n\nPaint with Reality:\nSample colors and textures from your surroundings using the Meta Quest 3 Camera API. Every brush uses real world input.\n\nMore than 16 dynamic brush styles:\nSoft strokes, voxel brushes, sphere brushes, freeform boxes, light brushes and many more. Every brush can be used as a picture brush or a live video brush.\n\nStraight line and freeform drawing:\nCreate clean shapes, structures, or organic strokes in full 3D space.\n\n3D creation modes:\nVoxel mode, sphere mode and freeform box mode let you build volumetric shapes inside your room.\n\nVideo and picture brushes:\nUse live videos or captured textures from your environment as the material for your strokes.\n\nGLB and STL export:\nExport your creations for sharing, archiving or direct 3D printing.\n\nSpatial canvas controls:\nMove, rotate and scale your artwork freely in your environment.\n\nSave and load slots:\nStore up to three creations and continue painting any time.\n\nController support:\nOptimized for controllers to give you full freedom of movement and precise MR painting using real world sampling.", "short_description": "Drawee is a mixed-reality drawing app for Meta Quest 3 where your real world becomes the color palette. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://ararcadegame.com/data-privacyprivacy-policy-drawee-meta-quest-app/", "developer_terms_of_service_url": null, "publisher_name": "Christoph Spinger", "support_website_url": null, "website_url": "https://xrchris.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
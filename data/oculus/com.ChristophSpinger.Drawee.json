ent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLC8MO_hDAb0H4B4safJEX12g-ociyuYPeTAbJzhbRbKw&oe=6ABE6B61"}, {"file_name": "Screenshot4Drawee.png", "id": "1474644673767352", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820382_1474644677100685_6299369456080799575_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SaVHLxaZ5nwQ7kNvwG5Ch5S&_nc_oc=AdqPb04MgvX6FOocdw6E9t1TZXcem49Nh8ZA9TP2-ZaLR5KIdIztvxoJA2HsbTQvM0c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjSK-p3d1SuFjZ_6L_XHZjM-Tx0-VWvY4-h6WojAYFyg&oe=6ABE7F09"}, {"file_name": "Screenshot8Drawee.png", "id": "807644472265170", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820523_807644475598503_5035153927987790493_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6aL0fEKFUoQ7kNvwEpHTCA&_nc_oc=AdpMU_K8GpCifnz-lqYFnRrYz-Xp7hMZRSwxwJ0E1MaN9o97lh0g7azPzk-7ta1_Ic0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgQfapjJmxV7ZgIx6poS8ACRkhDnvOhCjMoB2gMdUpRA&oe=6ABE5D59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "781925581315466", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818885_781925587982132_3820792127821152661_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ad54YE84H8wQ7kNvwErFmWv&_nc_oc=AdpUKzXmzoZitkOyfuGzJuNevaHBtVcVKXj-8EUAw8-oYccTaHVQqQIqMJf42aaLufk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2QBBxvBmfNeXyvOdQjZcdFlekz0lxdb2E2sXakjTGng&oe=6ABE6C23"}, "display_name": "Drawee", "keywords": ["Art", "Design", "Draw", "Painting", "MixedReality"], "long_description": "Drawee is a mixed reality drawing app for Meta Quest 3 where your real world becomes your only color palette. Every stroke is created by sampling the environment around you. There are no artificial colors and no presets. Everything you create comes directly from reality.\n\nPaint in true spatial MR with 3D tools, live video brushes, and export options that are ready for 3D printing.\n\nPaint with Reality:\nSample colors and textures from your surroundings using the Meta Quest 3 Camera API. Every brush uses real world input.\n\nMore than 16 dynamic brush styles:\nSoft strokes, voxel brushes, sphere brushes, freeform boxes, light brushes and many more. Every brush can be used as a picture brush or a live video brush.\n\nStraight line and freeform drawing:\nCreate clean shapes, structures, or organic strokes in full 3D space.\n\n3D creation modes:\nVoxel mode, sphere mode and freeform box mode let you build volumetric shapes inside your room.\n\nVideo and picture brushes:\nUse live videos or captured textures from your environment as the material for your strokes.\n\nGLB and STL export:\nExport your creations for sharing, archiving or direct 3D printing.\n\nSpatial canvas controls:\nMove, rotate and scale your artwork freely in your environment.\n\nSave and load slots:\nStore up to three creations and continue painting any time.\n\nController support:\nOptimized for controllers to give you full freedom of movement and precise MR painting using real world sampling.", "short_description": "Drawee is a mixed-reality drawing app for Meta Quest 3 where your real world becomes the color palette. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://ararcadegame.com/data-privacyprivacy-policy-drawee-meta-quest-app/", "developer_terms_of_service_url": null, "publisher_name": "Christoph Spinger", "support_website_url": null, "website_url": "https://xrchris.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
c\u043d\u043e\u0439 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0438 \u043f\u0440\u044f\u043c\u044b\u0445 \u0442\u0440\u0430\u043d\u0441\u043b\u044f\u0446\u0438\u0439 \u0441 \u043e\u0431\u0437\u043e\u0440\u043e\u043c 360. \u0421\u043c\u043e\u0442\u0440\u0438\u0442\u0435 \u0438\u0445 \u0441\u043e \u0437\u0432\u0443\u043a\u043e\u043c, \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u043f\u043e\u0433\u0440\u0443\u0436\u0430\u044f\u0441\u044c \u0432 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435. \u041a\u0440\u0430\u0441\u0438\u0432\u044b\u0435 \u043f\u0430\u043d\u043e\u0440\u0430\u043c\u044b \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0443\u0442 \u0432\u0430\u0441 \u0432 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043c\u0438\u0440 \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0439 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438. - \u041f\u0440\u043e\u0441\u043c\u043e\u0442\u0440 \u043a\u0440\u0430\u0441\u0438\u0432\u044b\u0445 \u0438 \u043e\u0431\u044a\u0435\u043c\u043d\u044b\u0445 \u0432\u0438\u0434\u0435\u043e\u0440\u043e\u043b\u0438\u043a\u043e\u0432 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438; - \u041f\u0440\u043e\u0441\u043c\u043e\u0442\u0440 \u043f\u0440\u044f\u043c\u044b\u0445 \u0442\u0440\u0430\u043d\u0441\u043b\u044f\u0446\u0438\u0439 \u0441 \u043e\u0431\u0437\u043e\u0440\u043e\u043c 360 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u043c\u0435\u0440\u043e\u043f\u0440\u0438\u044f\u0442\u0438\u0439 \u2014 \u043e\u0442 \u0441\u043f\u043e\u0440\u0442\u0430 \u0434\u043e \u043c\u0443\u0437\u044b\u043a\u0430\u043b\u044c\u043d\u044b\u0445 \u043a\u043e\u043d\u0446\u0435\u0440\u0442\u043e\u0432; - \u0414\u0435\u043b\u0438\u0442\u044c\u0441\u044f \u0441 \u0434\u0440\u0443\u0437\u044c\u044f\u043c\u0438 \u043f\u043e\u043d\u0440\u0430\u0432\u0438\u0432\u0448\u0438\u043c\u0438\u0441\u044f \u0432\u0438\u0434\u0435\u043e\u0440\u043e\u043b\u0438
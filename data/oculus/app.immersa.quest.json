ideo channel, Immersa delivers the highest-quality viewing experience on Meta Quest.", "short_description": "Watch and share immersive 180\u00b0 & 360\u00b0 video in native quality. Send beautiful branded links that open instantly on Meta Quest"}]}, "developer_name": "Immersa Inc", "developer_privacy_policy_url": "https://immersa.app/privacy-policy", "developer_terms_of_service_url": "https://immersa.app/terms-of-use", "publisher_name": "Be-Dev", "support_website_url": null, "website_url": "https://immersa.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1400940739768032"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824700_1889171235404646_3325487266430430355_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbQOJJXREwoQ7kNvwHiV6hv&_nc_oc=AdoAepNcKvFXPlkIaZ50Ug0zLZsOv5P5ZJf56DS3B-LxpIUctE9PHds5nSCC9vkxNLI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfbBH25K9CzalHEXGbGac5IRn0haNWLazyIKL__rONPw&oe=6AE33E1E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Immersa", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1791718500, "lastRevision": {"nodes"
 clients or collaborators\n\u2022 Upload and manage immersive content with a simple CMS\n\u2022 Create a premium viewing experience without building a custom app\n\u2022 Control branding, access, and presentation\n\nImmersa is designed for filmmakers, immersive studios, and spatial creators who care deeply about presentation, viewing quality, and seamless sharing.\n\nWhether you\u2019re showcasing immersive films, sharing client previews, or building a premium spatial video channel, Immersa delivers the highest-quality viewing experience on Meta Quest.", "short_description": "Watch and share immersive 180\u00b0 & 360\u00b0 video in native quality. Send beautiful branded links that open instantly on Meta Quest"}]}, "developer_name": "Immersa Inc", "developer_privacy_policy_url": "https://immersa.app/privacy-policy", "developer_terms_of_service_url": "https://immersa.app/terms-of-use", "publisher_name": "Be-Dev", "support_website_url": null, "website_url": "https://immersa.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1400940739768032"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "972316849248798"}]}, "baseline_offer": {"id": "972316849248798"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791718500, "status": "PUBLISHED", "id": "972316849248798"}]}, "liveChannel": {"nodes": [{"lates
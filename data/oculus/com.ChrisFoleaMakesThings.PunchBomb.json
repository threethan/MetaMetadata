b=1-7&_nc_sid=6e7a0a&_nc_ohc=F3ELCJvtbT8Q7kNvwF5Um1-&_nc_oc=AdmgjcPpAqjr0vypo2gkpm1C3jYAcmSgoJ-vIfLnbBAaSgUArjCKDHXKjBZLazMe2Vc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsCGid_DZYk35uSVQLfD9XOYwKyhGzIYRgKEQ7xzwGawA&oe=699C44EE"}, {"file_name": "ChallengeMode_Image_02.png", "id": "1188201992987967", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499295509_1188201996321300_2111120103698102006_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6W5qL1O0y74Q7kNvwGGigKb&_nc_oc=Adnv7QltDdrqLMbqZCrV-oLMbdt3JG5m9o7Xv6OKnr5_JOVEQT9PyUOI0qWrtzu7zF4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftOQ1zkik4Xpnc5KdLtINtR_ro0agR2B7u32KyD4y_c9A&oe=699C394A"}, {"file_name": "Cosmetics_Image_02.png", "id": "1737987487068873", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295801_1737987493735539_1039395962667216685_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RCQtX6RQUwQ7kNvwH_aXAI&_nc_oc=AdkQa62NatxUpl7TqUZVMNSzk0G3Pm3cjrRmlcH6qrIRiHKXcJVhkXdiVa3Rm-cFztk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs8BycVzZJc9wcta1soDuVo2QtmjXb7sPOkNvK8oUPpeg&oe=699C60AB"}, {"file_name": "DodgeLasers_02.png", "id": "3637904013182167", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294007_3637904023182166_4032639804070807573_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vg8ITyhJsVUQ7kNvwEB_USQ&_nc_oc=AdnzalbwNisVOltslUxDE1-KZbsev21zu3HyUqJ7utfl9WbvJvldrFwOUgfPI7-6unQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afslm4SolAQy3s-8kde8D-T9mmMPltZ1szj5Q6n0HYnWQg&oe=699C4DB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_New.png", "id": "898823102474350", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299808_898823109141016_4587002048357409884_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRh0e9K527UQ7kNvwFPd4vN&_nc_oc=AdnczJPH41W5D4Xetgy4q5UtgfIwwNTyslhVR6OJntT71_gbUI8uYAdspcNgt6tzxZo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvtL4qZZANqpyn7fyJ4YfMT76eXKVRLd-0RPuyM8OwtSg&oe=699C4D78"}, "display_name": "Punch Bomb", "keywords": ["Punch", "Arcade", "Bomb", "Game", "Challenge"], "long_description": "# Punch Bomb\nis a fast-paced 360\u00b0 action arcade game where you punch bombs away before they explode.\n\nBuilt for those who love a challenge.\n\nClimb the global leaderboards across 3 punchable game modes!\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Classic Mode\nSurvive as long as you can! Punch a variety of bombs away from you before they explode, dodge dangerous laser obstacles, hit targets, and rack up huge combos.\n{4009259875886708}\n\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Blitz Mode\n\nRace against the clock to get a high score within the time limit! Bombs no longer explode, and targets extend your time. \n{1063827595628759}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Challenge Mode\nComplete a fun collection of challenges that put your speed and accuracy to the test!\n{1207719874395696}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Unique Cosmetics\nUnlock unique cosmetics by **playing the game** and mastering its challenges. Each cosmetic has its own visual flair!\n\n\n\n\n{1198946195348915}", "short_description": "Punch bombs away from you before they explode while racking up combos, dodging dangerous laser obstacles, and hitting targets! Compete in global leaderboards across 3 punchable game modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://punchbomb.com/punchbombTOS.html", "developer_terms_of_service_url": "https://punchbomb.com/punchbombTOS.html", "publisher_name": "Chris Folea Makes Things",
b=1-7&_nc_sid=6e7a0a&_nc_ohc=F3ELCJvtbT8Q7kNvwFEMKc_&_nc_oc=AdnuvC-09VHGSJAK488LjKFC1pjqLpXunt8wnb-aY6ne0h3XVph-yfk8uf8dOzQv2Ok&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvPdtwMIlgw03MTCODlYVdTLi3huawuqiKxboJu2Z1z8A&oe=699D966E"}, {"file_name": "ChallengeMode_Image_02.png", "id": "1188201992987967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295509_1188201996321300_2111120103698102006_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6W5qL1O0y74Q7kNvwEiibqT&_nc_oc=AdnbaOtFtN9ryHNUXQE3Iqz1okXnvKKUvgWPGTLa-EV7SzcOzPvRMmNjUeMaukz8meI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvYakLyorZyJG26ujdpnP-4WNJquNYIJCG1YLke7vdowg&oe=699D8ACA"}, {"file_name": "Cosmetics_Image_02.png", "id": "1737987487068873", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295801_1737987493735539_1039395962667216685_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bV322c0VEVwQ7kNvwGMCAtk&_nc_oc=AdlbYsX6h8PLUVmEbNZ81uQoAgDth25wNiLeq7DLOt2LEH0-9DSenx6k_MmCrEBqVyM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftUOPAQRJRDCQY77dg7zIsAF06u2lf8giU2y3kNF6d4Rg&oe=699DB22B"}, {"file_name": "DodgeLasers_02.png", "id": "3637904013182167", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499294007_3637904023182166_4032639804070807573_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vg8ITyhJsVUQ7kNvwH_lglc&_nc_oc=AdmVRPaqew8AhZhIHBYnsxiapXAfVe5XYB3IPBEYLR1Doag3Kg3HdItZLoGUY0Bs4PE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvqZzYZ0Bqv9OMwn7th0S95uv6iRwuVa9i06E_mpkeBLw&oe=699D9F31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_New.png", "id": "898823102474350", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299808_898823109141016_4587002048357409884_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRh0e9K527UQ7kNvwGKtX5P&_nc_oc=AdmqmADWoMHtu1pD2O8DIz65B4ENIUHW4RjIu-TykOvRs8DFMWJaAabUxvfLMusZ_30&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftNCpo3PJ5PNrhTL8sYAT0rfe_Z8kLKLgOBj9hydg_tdw&oe=699D9EF8"}, "display_name": "Punch Bomb", "keywords": ["Punch", "Arcade", "Bomb", "Game", "Challenge"], "long_description": "# Punch Bomb\nis a fast-paced 360\u00b0 action arcade game where you punch bombs away before they explode.\n\nBuilt for those who love a challenge.\n\nClimb the global leaderboards across 3 punchable game modes!\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Classic Mode\nSurvive as long as you can! Punch a variety of bombs away from you before they explode, dodge dangerous laser obstacles, hit targets, and rack up huge combos.\n{4009259875886708}\n\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Blitz Mode\n\nRace against the clock to get a high score within the time limit! Bombs no longer explode, and targets extend your time. \n{1063827595628759}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Challenge Mode\nComplete a fun collection of challenges that put your speed and accuracy to the test!\n{1207719874395696}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Unique Cosmetics\nUnlock unique cosmetics by **playing the game** and mastering its challenges. Each cosmetic has its own visual flair!\n\n\n\n\n{1198946195348915}", "short_description": "Punch bombs away from you before they explode while racking up combos, dodging dangerous laser obstacles, and hitting targets! Compete in global leaderboards across 3 punchable game modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://punchbomb.com/punchbombTOS.html", "developer_terms_of_service_url": "https://punchbomb.com/punchbombTOS.html", "publisher_name": "Chris Folea Makes Things",
b=1-7&_nc_sid=6e7a0a&_nc_ohc=cpB5ymTDLEgQ7kNvwEabg2n&_nc_oc=AdnYlJYfrcylhzSZLQCKRYKx9HIS89nLmoMVeVBbNzBlVwKxNyW_DOYGonhQ9ZPlU9w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvROdcnGi-LVDJYzSkEEdL1yo9qG17eS_PEgOH1DZDb_w&oe=69A57F6E"}, {"file_name": "ChallengeMode_Image_02.png", "id": "1188201992987967", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499295509_1188201996321300_2111120103698102006_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpFBeIhwPgcQ7kNvwGb7pA3&_nc_oc=AdnKu7TCBBODrnDRDx7_53sQT0yLlNDgevE9AFWbS0KDcLuFtuH2tyTI2cqnagLhsOs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftyX4d-u37oHvso3rdKH0GlNvK-aR9TcJUh1LB_owyulw&oe=69A573CA"}, {"file_name": "Cosmetics_Image_02.png", "id": "1737987487068873", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499295801_1737987493735539_1039395962667216685_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkM4tgE1t5EQ7kNvwFbEjO4&_nc_oc=AdkCuILID9qmwN5PQALbB-uXFNRcsV10TBlsxuuoqg1xab-oo1P_aX2t6HKNy_1Y8wo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs5Y0wFXSM6J1RuisH0G4C6mnqBASlQq7ZQYUy-5FuXZQ&oe=69A59B2B"}, {"file_name": "DodgeLasers_02.png", "id": "3637904013182167", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499294007_3637904023182166_4032639804070807573_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bk2nS_9yzcQ7kNvwEb91li&_nc_oc=Adkaf1rfD1fss1WoUoXqO15mg9sVc7lq588ulAmVERzZ91YWwFnjd1PsA9aoOy028u8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs81x2onMR6iIuWWUyB2TuKj7MqMk0g9x3-ncOHMfk6gQ&oe=69A58831"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_New.png", "id": "898823102474350", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499299808_898823109141016_4587002048357409884_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pgfLlQ7PLMQ7kNvwFIQr5q&_nc_oc=Adl7lJC1jOPAPbmbXqUqAF2e2Mz9N9-ygppen6HyZqFLWS9Xbc6mrWRZTpjMRqh8-Hs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfssQt01BU00oQLccZQqMWt9Hq3J7i73OmuA0RYCRGovKw&oe=69A587F8"}, "display_name": "Punch Bomb", "keywords": ["Punch", "Arcade", "Bomb", "Game", "Challenge"], "long_description": "# Punch Bomb\nis a fast-paced 360\u00b0 action arcade game where you punch bombs away before they explode.\n\nBuilt for those who love a challenge.\n\nClimb the global leaderboards across 3 punchable game modes!\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Classic Mode\nSurvive as long as you can! Punch a variety of bombs away from you before they explode, dodge dangerous laser obstacles, hit targets, and rack up huge combos.\n{4009259875886708}\n\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Blitz Mode\n\nRace against the clock to get a high score within the time limit! Bombs no longer explode, and targets extend your time. \n{1063827595628759}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Challenge Mode\nComplete a fun collection of challenges that put your speed and accuracy to the test!\n{1207719874395696}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Unique Cosmetics\nUnlock unique cosmetics by **playing the game** and mastering its challenges. Each cosmetic has its own visual flair!\n\n\n\n\n{1198946195348915}", "short_description": "Punch bombs away from you before they explode while racking up combos, dodging dangerous laser obstacles, and hitting targets! Compete in global leaderboards across 3 punchable game modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://punchbomb.com/punchbombTOS.html", "developer_terms_of_service_url": "https://punchbomb.com/punchbombTOS.html", "publisher_name": "Chris Folea Makes Things",
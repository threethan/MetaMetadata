9312373_1363239738226092_2106854729412937022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2ISmiqXknwQ7kNvwEtH2aD&_nc_oc=AdqY2wpfwnuO3GG__aSHHd7JijsI3NLYDfCHaYykRVeaUmNfKnQhURiwEbfzgalCSzA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3cuEoxxN9YzqDFMaoj21Bfp6DeFM1HdoeQfuNKBjMcQA&oe=69F1F66E"}, {"file_name": "ChallengeMode_Image_02.png", "id": "1188201992987967", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499295509_1188201996321300_2111120103698102006_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBpGa0Nu6CsQ7kNvwHxmpFQ&_nc_oc=AdrPYzUTkEmkmAlAqSrDo0fm0TVGRR5g9KdSGopV662tcvjxWWI8YTaiYR0l8OZcbH8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2mjRXwUczCBc_ovyfKQDkxrzvBFJVDGeNHinBS2SL8aQ&oe=69F1EACA"}, {"file_name": "Cosmetics_Image_02.png", "id": "1737987487068873", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499295801_1737987493735539_1039395962667216685_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uPndXt9z7cQ7kNvwGJvjo4&_nc_oc=AdqtNftBXW3QWgiig0A25YRP-r4Ss1yn78v9T3tVsZwIG6OjhgiN8nv7ajCGs-8KlJc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1WWkbR-b7OzIy5Je1ibdzR8gC1cgL3SQbpeykRfJGzow&oe=69F2122B"}, {"file_name": "DodgeLasers_02.png", "id": "3637904013182167", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499294007_3637904023182166_4032639804070807573_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbiB779MvTYQ7kNvwFlGsCa&_nc_oc=AdrLPbMlJx4qy3l1JAC7kTL8Ysip8XVpbhNhBgjD8SJh9Vryl44cqAnH_D-ttgGznzA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af16BY1XbCeJTUeE75SeREmLJrMa4fEVU-RQmFxGGkiizQ&oe=69F1FF31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_New.png", "id": "898823102474350", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499299808_898823109141016_4587002048357409884_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAfzhILgYWoQ7kNvwEJQEQh&_nc_oc=AdqFfjENaIPlTXPJuVC85v0mZb_RNiwXZ3G2YkYeTniFLBy_iIigNGKQhKJbU6Z8QK0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0K3jh_UxwNHQC-5xRgrVOSOuE9PoIHwKvPDPrJa5rdJA&oe=69F1FEF8"}, "display_name": "Punch Bomb", "keywords": ["Punch", "Arcade", "Bomb", "Game", "Challenge"], "long_description": "# Punch Bomb\nis a fast-paced 360\u00b0 action arcade game where you punch bombs away before they explode.\n\nBuilt for those who love a challenge.\n\nClimb the global leaderboards across 3 punchable game modes!\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Classic Mode\nSurvive as long as you can! Punch a variety of bombs away from you before they explode, dodge dangerous laser obstacles, hit targets, and rack up huge combos.\n{4009259875886708}\n\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Blitz Mode\n\nRace against the clock to get a high score within the time limit! Bombs no longer explode, and targets extend your time. \n{1063827595628759}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Challenge Mode\nComplete a fun collection of challenges that put your speed and accuracy to the test!\n{1207719874395696}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Unique Cosmetics\nUnlock unique cosmetics by **playing the game** and mastering its challenges. Each cosmetic has its own visual flair!\n\n\n\n\n{1198946195348915}", "short_description": "Punch bombs away from you before they explode while racking up combos, dodging dangerous laser obstacles, and hitting targets! Compete in global leaderboards across 3 punchable game modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://punchbomb.com/punchbombTOS.html", "developer_terms_of_service_url": "https://p
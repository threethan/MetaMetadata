nN3KAZFVvciUmOtcjCTIa7bXj1ohZqs0e_riAQ&oe=6B0EFB71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_New.png", "id": "898823102474350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299808_898823109141016_4587002048357409884_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOKvFIwgR3wQ7kNvwGcG9NP&_nc_oc=AdqxrhIedCrxbJx0UzF7zwdDxfDajDJ-s60H3i7sDzLfyjIwEXLeVzSwMzJd3NKGJ0A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVh3aIfofn-1HO7lHw6cFiLnwMgY6NxLxvuGWTW_B67Ig&oe=6B0EFB38"}, "display_name": "Punch Bomb", "keywords": ["Punch", "Arcade", "Bomb", "Game", "Challenge"], "long_description": "# Punch Bomb\nis a fast-paced 360\u00b0 action arcade game where you punch bombs away before they explode.\n\nBuilt for those who love a challenge.\n\nClimb the global leaderboards across 3 punchable game modes!\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Classic Mode\nSurvive as long as you can! Punch a variety of bombs away from you before they explode, dodge dangerous laser obstacles, hit targets, and rack up huge combos.\n{4009259875886708}\n\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Blitz Mode\n\nRace against the clock to get a high score within the time limit! Bombs no longer explode, and targets extend your time. \n{1063827595628759}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Challenge Mode\nComplete a fun collection of challenges that put your speed and accuracy to the test!\n{1207719874395696}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Unique Cosmetics\nUnlock unique cosmetics by **playing the game** and mastering its challenges. Each cosmetic has its own visual flair!\n\n\n\n\n{1198946195348915}", "short_description": "Punch bombs away from you before they explode while racking up combos, dodging dangerous laser obstacles, and hitting targets! Compete in global leaderboards across 3 punchable game modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://punchbomb.com/punchbombTOS.html", "developer_terms_of_service_url": "https://punchbomb.com/punchbombTOS.html", "publisher_name": "Chris Folea Makes Things", "support_website_url": null, "website_url": "https://www.punchbomb.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34420387680881886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295542_1182209947085134_6619392719475728272_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CEIhcG9X1YQ7kNvwG3rJdg&_nc_oc=Adp5H_bYNvdDVKz6mFAMDiaxUwk4crB2nb83kOmM26sWLYrMPRR6haZgaW3rtsXQ7S8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVZuBsN7DtM9CcCidRReHX1cDT_KweUrcuJYeK5bPwPsA&oe=6B0F03D1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Punch Bomb", "platform": "ANDROID_6DOF", "context_category": {"context_categor
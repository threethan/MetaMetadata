b=1-7&_nc_sid=6e7a0a&_nc_ohc=O48g5JTgbV8Q7kNvwG9IaL4&_nc_oc=AdkQyHBnnaefqzKZMZFd1QTLa1lNK2F19l1RBTTSAkz2q7YcIkeZwDWXx_dGyVqZ8do&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsypXbfJmvmS8wU7AYgFN19XNezx4xkDSqqsBjgS5-qOg&oe=69A0396E"}, {"file_name": "ChallengeMode_Image_02.png", "id": "1188201992987967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295509_1188201996321300_2111120103698102006_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSvSlWw_9qUQ7kNvwGAR5Yu&_nc_oc=AdmXBFH7iIyOTP3nK05L0cFsgf1Jr1fTvXhShpktlhJwV3MtrnqjLoBuJpXmlzddHyg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftvpDwliK5n0To-IIzCp8ydaDT7mI4YKMsPGMQ9O7QQKA&oe=69A02DCA"}, {"file_name": "Cosmetics_Image_02.png", "id": "1737987487068873", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295801_1737987493735539_1039395962667216685_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bV322c0VEVwQ7kNvwFhDjVq&_nc_oc=AdkslRbdr90CBNHudjnbiF083Acptan_PAGGYg-MRfmFlppJKDhgfSWH5MoujAHCtA4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuJr2ORJJtk5z-mKq7RF3Twl624qwEfrPq8VMWpOR9vtQ&oe=69A0552B"}, {"file_name": "DodgeLasers_02.png", "id": "3637904013182167", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499294007_3637904023182166_4032639804070807573_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uXdUyHFVE4Q7kNvwHV6w-Y&_nc_oc=Adl9k2VwNF6yhMhltc-bTR7qJD-uHxMubXyZZQ9fg9oQJgBAkgps0AQYW0q-mekK21Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsb6k-Zr2EJnWpbz3KY_5y-BDzhiS3QiaU9FQhINHk4Ew&oe=69A04231"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_New.png", "id": "898823102474350", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299808_898823109141016_4587002048357409884_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tlOQiGJaDgQ7kNvwHE2Uef&_nc_oc=AdkhudquUlaOnNdg7Oe6xAL7SO_QBMqobum5XnJfc-n7iOP2r3Yk0pAgS0iHvrn3LfU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsR7dcyDMbANdVqRiz2OIMV6UYsKkvfqFeWLaTqGRUAeA&oe=69A041F8"}, "display_name": "Punch Bomb", "keywords": ["Punch", "Arcade", "Bomb", "Game", "Challenge"], "long_description": "# Punch Bomb\nis a fast-paced 360\u00b0 action arcade game where you punch bombs away before they explode.\n\nBuilt for those who love a challenge.\n\nClimb the global leaderboards across 3 punchable game modes!\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Classic Mode\nSurvive as long as you can! Punch a variety of bombs away from you before they explode, dodge dangerous laser obstacles, hit targets, and rack up huge combos.\n{4009259875886708}\n\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Blitz Mode\n\nRace against the clock to get a high score within the time limit! Bombs no longer explode, and targets extend your time. \n{1063827595628759}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Challenge Mode\nComplete a fun collection of challenges that put your speed and accuracy to the test!\n{1207719874395696}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Unique Cosmetics\nUnlock unique cosmetics by **playing the game** and mastering its challenges. Each cosmetic has its own visual flair!\n\n\n\n\n{1198946195348915}", "short_description": "Punch bombs away from you before they explode while racking up combos, dodging dangerous laser obstacles, and hitting targets! Compete in global leaderboards across 3 punchable game modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://punchbomb.com/punchbombTOS.html", "developer_terms_of_service_url": "https://punchbomb.com/punchbombTOS.html", "publisher_name": "Chris Folea Makes Things",
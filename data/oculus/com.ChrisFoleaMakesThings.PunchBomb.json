tps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312373_1363239738226092_2106854729412937022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZJyFha2b5EQ7kNvwEHzp8F&_nc_oc=AdrTPdedy-8JafK15AujZCy8vP4WuShwiMINzkpezK-GQpKYbisgA75_KNhMjxK4k5o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDo-SEYbpLmvg9IJNWVle5nT8SOW2L2zK9dogmL7czvJQ&oe=6A4CEDEE"}, {"file_name": "ChallengeMode_Image_02.png", "id": "1188201992987967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499295509_1188201996321300_2111120103698102006_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0IYo1ab1JMQ7kNvwFM6MPO&_nc_oc=AdpuFHZydBV7OCrCXLOUlblJ8PRr7ZLaNjNi7Sxq9IZ8ybl2s63d8_ZJMBV0afItKKk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLC5Tz_N9wQjA0Nmg88hT2NWkSmYmk23M1ZFYacaueOA&oe=6A4D1A8A"}, {"file_name": "Cosmetics_Image_02.png", "id": "1737987487068873", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295801_1737987493735539_1039395962667216685_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcmw2uClLjQQ7kNvwEN6wcJ&_nc_oc=AdoWoLZCC3FNXa630TO6SAhhZnh6YjhBVAY-w7h_dqD3oVVS5DVniGKHoNNiOYjhgso&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2_hT5ORx5E0SAOK1ak4yYehwRJKCycY3sRrQyv73G4g&oe=6A4D09AB"}, {"file_name": "DodgeLasers_02.png", "id": "3637904013182167", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499294007_3637904023182166_4032639804070807573_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bytjTirO4sQ7kNvwHPiLsw&_nc_oc=AdqQGU5FaZV-8MUmRXlzgCUWiZjpJAD_dlWYK4zWjWMsTAH7gNY8Yts-_x2lj2vJo3I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyH8J-utf8WHhhVyVlAs4L2veBkSPpDphXosDQn1rFUw&oe=6A4CF6B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_New.png", "id": "898823102474350", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299808_898823109141016_4587002048357409884_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGAvFltCM80Q7kNvwEff2M5&_nc_oc=AdqnCVq-jnkrmJ98GHOPd_El4VFK9E_GA1dJQMyy5kIosddvTKQXgdMelzxFP2U92AA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPxmMANlMabM-jeSW52EWSA5hLmOWpXCyUpDp2UCDVWQ&oe=6A4CF678"}, "display_name": "Punch Bomb", "keywords": ["Punch", "Arcade", "Bomb", "Game", "Challenge"], "long_description": "# Punch Bomb\nis a fast-paced 360\u00b0 action arcade game where you punch bombs away before they explode.\n\nBuilt for those who love a challenge.\n\nClimb the global leaderboards across 3 punchable game modes!\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Classic Mode\nSurvive as long as you can! Punch a variety of bombs away from you before they explode, dodge dangerous laser obstacles, hit targets, and rack up huge combos.\n{4009259875886708}\n\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Blitz Mode\n\nRace against the clock to get a high score within the time limit! Bombs no longer explode, and targets extend your time. \n{1063827595628759}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Challenge Mode\nComplete a fun collection of challenges that put your speed and accuracy to the test!\n{1207719874395696}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Unique Cosmetics\nUnlock unique cosmetics by **playing the game** and mastering its challenges. Each cosmetic has its own visual flair!\n\n\n\n\n{1198946195348915}", "short_description": "Punch bombs away from you before they explode while racking up combos, dodging dangerous laser obstacles, and hitting targets! Compete in global leaderboards across 3 punchable game modes!"}]}, "developer_name": null, "developer_priv
b=1-7&_nc_sid=6e7a0a&_nc_ohc=F3ELCJvtbT8Q7kNvwExm8Ys&_nc_oc=AdkcHk1H6YYwugRXXy5udobXxgZKnhNDRWFj2IVCaK4nzoO88qWdEGJJw8xqMN3F3xY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuRAlzpTIUS9-7qNn4o-nNh6j0_11ElwIyaSoiXBe5fDA&oe=699EE7EE"}, {"file_name": "ChallengeMode_Image_02.png", "id": "1188201992987967", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499295509_1188201996321300_2111120103698102006_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6W5qL1O0y74Q7kNvwFrN8w-&_nc_oc=Adl7oZHwLFXbcQuDaZh0ccM9T6drnEwJ7aW7RwZpzIZeEy6RkaQaBV4elWU4_moeSxE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftJ9egDe18Lx4AIcl8yMPbhKer2648NIHw8db_dTP6oKA&oe=699EDC4A"}, {"file_name": "Cosmetics_Image_02.png", "id": "1737987487068873", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499295801_1737987493735539_1039395962667216685_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bV322c0VEVwQ7kNvwF5tFXK&_nc_oc=AdmZ1VBJ9-i0kbWu_ydyCRUGA7oQ6xazbYyBizLE2hJdZEuUoxu0JocmSw213ybnc-4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvWoIYd9dOkP6yZmntsLEqRqAGq-FF7pQq3GORDE2yISA&oe=699F03AB"}, {"file_name": "DodgeLasers_02.png", "id": "3637904013182167", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499294007_3637904023182166_4032639804070807573_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uXdUyHFVE4Q7kNvwENcxsH&_nc_oc=AdkjqdsAjkUtkYouuQkvirglm5Tg9mTWdyBIh5DHumCko-h5BmxHp15zA6YNn9rmNGs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuxdHHDA5dXfyyQXcmofal0NfkibH83KRdQ-GGSLLJkpQ&oe=699EF0B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_New.png", "id": "898823102474350", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499299808_898823109141016_4587002048357409884_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRh0e9K527UQ7kNvwGwi0Di&_nc_oc=AdkzHy-Lrr8YT8eYxAv2Qvl5A42mFxZk6KTFkw1L6c2hpNEB-Qz4mJwg9JdAFzGeBxs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvDy9k4UJYokgu3UvNacXnWte6hfrgTcUwhCqatArQZmw&oe=699EF078"}, "display_name": "Punch Bomb", "keywords": ["Punch", "Arcade", "Bomb", "Game", "Challenge"], "long_description": "# Punch Bomb\nis a fast-paced 360\u00b0 action arcade game where you punch bombs away before they explode.\n\nBuilt for those who love a challenge.\n\nClimb the global leaderboards across 3 punchable game modes!\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Classic Mode\nSurvive as long as you can! Punch a variety of bombs away from you before they explode, dodge dangerous laser obstacles, hit targets, and rack up huge combos.\n{4009259875886708}\n\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Blitz Mode\n\nRace against the clock to get a high score within the time limit! Bombs no longer explode, and targets extend your time. \n{1063827595628759}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Challenge Mode\nComplete a fun collection of challenges that put your speed and accuracy to the test!\n{1207719874395696}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Unique Cosmetics\nUnlock unique cosmetics by **playing the game** and mastering its challenges. Each cosmetic has its own visual flair!\n\n\n\n\n{1198946195348915}", "short_description": "Punch bombs away from you before they explode while racking up combos, dodging dangerous laser obstacles, and hitting targets! Compete in global leaderboards across 3 punchable game modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://punchbomb.com/punchbombTOS.html", "developer_terms_of_service_url": "https://punchbomb.com/punchbombTOS.html", "publisher_name": "Chris Folea Makes Things",
b=1-7&_nc_sid=6e7a0a&_nc_ohc=YDilgQo1b-UQ7kNvwGqftUo&_nc_oc=Adn5ahouhCeA_2o0pbDmZwoAd4EBX3J88FyN_zIos4MmHiwazBMsx623X3vORMGn9-s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftKEBzIWNsDKDSFQ-dv5RUWGa_WY5jFXxw8En91mUTD7Q&oe=699AF36E"}, {"file_name": "ChallengeMode_Image_02.png", "id": "1188201992987967", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499295509_1188201996321300_2111120103698102006_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tD6rI4ZA2ZcQ7kNvwHxxC28&_nc_oc=Admnpt294Kh3NKwZFAXIVtsYZU-0iGwhr7cFToDVzZDaZGyneCr4MyGQNZzVFNi5lLE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuBN4iJVz0ulRRo7g316itu-IPJeL-BVSx-5CsVVQDjvw&oe=699AE7CA"}, {"file_name": "Cosmetics_Image_02.png", "id": "1737987487068873", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295801_1737987493735539_1039395962667216685_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RCQtX6RQUwQ7kNvwEuKw-b&_nc_oc=AdmSeQ7kBZUJ6QhzYLNGdC0pNKDkqDFCTaD6CVB4olMDSArIicnz12rvIOb3-77KGJY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu96s8S1Pry1hXxAX_cbd-ljBYCn4WGHR7hsVbKU1YuZw&oe=699B0F2B"}, {"file_name": "DodgeLasers_02.png", "id": "3637904013182167", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294007_3637904023182166_4032639804070807573_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vg8ITyhJsVUQ7kNvwHpolcf&_nc_oc=Adm89MTEY24KBL6K6BhZfyjHVaN6621VNviMWZK0RV6kaDrM2tUgayXQdaK2Yq48NK0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs9NogaEd2vuFn7I_tVLZQI5AN1lDQIbx3vA6Aewlw0Rw&oe=699AFC31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_New.png", "id": "898823102474350", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299808_898823109141016_4587002048357409884_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWtNG2uzgi0Q7kNvwGWQhuR&_nc_oc=AdlJqFMRom90wziPHKgIt75qNfv15HTsiZgX-Tkr8vHS4kGTGQNPqQBY9BUmy5xqG-0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftnIptr-pSrqF-mTEAaEZhqBoqO1RwNcUtAqtPgcWsaoQ&oe=699AFBF8"}, "display_name": "Punch Bomb", "keywords": ["Punch", "Arcade", "Bomb", "Game", "Challenge"], "long_description": "# Punch Bomb\nis a fast-paced 360\u00b0 action arcade game where you punch bombs away before they explode.\n\nBuilt for those who love a challenge.\n\nClimb the global leaderboards across 3 punchable game modes!\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Classic Mode\nSurvive as long as you can! Punch a variety of bombs away from you before they explode, dodge dangerous laser obstacles, hit targets, and rack up huge combos.\n{4009259875886708}\n\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Blitz Mode\n\nRace against the clock to get a high score within the time limit! Bombs no longer explode, and targets extend your time. \n{1063827595628759}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Challenge Mode\nComplete a fun collection of challenges that put your speed and accuracy to the test!\n{1207719874395696}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Unique Cosmetics\nUnlock unique cosmetics by **playing the game** and mastering its challenges. Each cosmetic has its own visual flair!\n\n\n\n\n{1198946195348915}", "short_description": "Punch bombs away from you before they explode while racking up combos, dodging dangerous laser obstacles, and hitting targets! Compete in global leaderboards across 3 punchable game modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://punchbomb.com/punchbombTOS.html", "developer_terms_of_service_url": "https://punchbomb.com/punchbombTOS.html", "publisher_name": "Chris Folea Makes Things",
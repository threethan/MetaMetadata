tps://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312373_1363239738226092_2106854729412937022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZXPUkuKq1UQ7kNvwFfs_u5&_nc_oc=AdpzSOaCpYyvRUdH-WOy6qsoYIrkbOuXOkSXLAK1DcCszU_yfa4TY9BmNR0tK_5PwVA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNS3shfV9EVV-Y3pKnOE3iDISVQH0v3BcGg57-uodq-qA&oe=6AC9132E"}, {"file_name": "ChallengeMode_Image_02.png", "id": "1188201992987967", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499295509_1188201996321300_2111120103698102006_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDyMgJLo3gIQ7kNvwFoNts5&_nc_oc=AdrkNkUqb6MGzHxvOU3V5ILy-IzqQWFk93IsPziBD2lOWWd93r6_wGm7iRlGHvTy2nk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNd_DmmLREfZidIFsk510FpjevDkewa_VP27oHqXdQqkA&oe=6AC9078A"}, {"file_name": "Cosmetics_Image_02.png", "id": "1737987487068873", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499295801_1737987493735539_1039395962667216685_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UG-vPs7XPXQQ7kNvwFmmk4a&_nc_oc=AdpAR5r5pNipjDzp31iqxThKtPscjLrtGVNzZZ9jfWcNPQ01wgEOi-mjWbGFunCSjtg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaOPQjPTDM4hjp5xdToj3vCc3n0QYeEJ3a76bExaoxiQ&oe=6AC8F6AB"}, {"file_name": "DodgeLasers_02.png", "id": "3637904013182167", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499294007_3637904023182166_4032639804070807573_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bg7OVt7Tc1sQ7kNvwHto-v7&_nc_oc=AdpSMgp-yTiKr9nuaJyHqdYfySwQYnkSh9_bbHYss-Ythw98Zakv4AbBoOePRIZT0Sg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPX25G686LP6-jk2cOP96Cu_i0eC125X0CAO4QvdtZ2OA&oe=6AC91BF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_New.png", "id": "898823102474350", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499299808_898823109141016_4587002048357409884_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oqt9l3ys6isQ7kNvwFeV-fM&_nc_oc=AdpV9EN5HbT74E7EsNNxcOfqSR3tYQl77Xu7zJ6bByqUQgYOphCY9_w4cxg1xbnWXP0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9KWKZEd3pyB6R_HpndBXp2NssBjgGoZFY9R_XrhqObA&oe=6AC91BB8"}, "display_name": "Punch Bomb", "keywords": ["Punch", "Arcade", "Bomb", "Game", "Challenge"], "long_description": "# Punch Bomb\nis a fast-paced 360\u00b0 action arcade game where you punch bombs away before they explode.\n\nBuilt for those who love a challenge.\n\nClimb the global leaderboards across 3 punchable game modes!\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Classic Mode\nSurvive as long as you can! Punch a variety of bombs away from you before they explode, dodge dangerous laser obstacles, hit targets, and rack up huge combos.\n{4009259875886708}\n\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Blitz Mode\n\nRace against the clock to get a high score within the time limit! Bombs no longer explode, and targets extend your time. \n{1063827595628759}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Challenge Mode\nComplete a fun collection of challenges that put your speed and accuracy to the test!\n{1207719874395696}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Unique Cosmetics\nUnlock unique cosmetics by **playing the game** and mastering its challenges. Each cosmetic has its own visual flair!\n\n\n\n\n{1198946195348915}", "short_description": "Punch bombs away from you before they explode while racking up combos, dodging dangerous laser obstacles, and hitting targets! Compete in global leaderboards across 3 punchable game modes!"}]}, "developer_name": null, "developer_priv
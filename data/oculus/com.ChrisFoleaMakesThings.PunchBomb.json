rt_Landscape.png", "id": "542244651638196", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391915_542244661638195_5749420793157065849_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQSoAazq5S4Q7kNvwGkMnR-&_nc_oc=Ado7fQdDgq0nluVFGua3tvx1b3tDmzpcHzL1C-DLGbMzV-isOM14TNsK-GS55TIPoGE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1EA-nPKIsTRE5miuivsIvJsCxTe6PWpoYqu_KC4KbkwA&oe=69F2114A"}]}, "id": "1515573162539419", "locale": "en_US", "screenshots": [{"file_name": "PunchThings_Image.png", "id": "971145128544312", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391878_971145131877645_487518279152836256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNxD5psK_IAQ7kNvwGjQWLL&_nc_oc=Adrg7xCUDF1qIBMGK6-1HYkIVbwLEUtkK9jH4mZKlMLqzwNbgp_-ECGewvGuAJ58Xko&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Li6ZJfuL5xmRgPTfOaHxAWKeJJvdSmpAVyx-xSH--PA&oe=69F1ED34"}, {"file_name": "DodgeLasers_Image.png", "id": "1003195685344154", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499347493_1003195688677487_5272959380177948610_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yaX1nZbYU0Q7kNvwHTPFfs&_nc_oc=AdqJ6lsdJTrUNZuNlp74MlSHSfyIvlTRvpBFWaqGVG-FtHjCfAXH7KfSeXmvfmrfQ64&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2bcsG0rbhdF3t1z7FmkBFvgrfF9EgvDdEqhRriMdgAhA&oe=69F1FF1C"}, {"file_name": "GlobalLeaderboards_Image.png", "id": "556916340796636", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618051_556916344129969_4630520520253278561_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiiUnHaj0S0Q7kNvwGT90x_&_nc_oc=Adqj1LDdQk8PTMUhQw3u-_UmsRTm9xKfqJjQs-W-2Z_38TELhXo4Mtp5c4yZqJqelKQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0oaARVi-5avtuI65Tkfzppx45JYseE39so_XlHnQaP2w&oe=69F20860"}, {"file_name": "ChallengeMode_Image.png", "id": "1238200904331680", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499301526_1238200907665013_4439728854047711627_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U1nmRLqoAEQ7kNvwHvbCPP&_nc_oc=AdpLiLj6oOlBB9xzEB2uG-sWiOxR9DUJm1r9gpXbgttihvqDgrwPTnwXmN9at1D4Qf0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2oiSdssgkfTNw9BRKinZK_DvNh8RBJmLM5mKLquY7WSg&oe=69F1FE2B"}, {"file_name": "Cosmetics_Image.png", "id": "1366120307973125", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300977_1366120311306458_2475007633126940757_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEGwNGhkOl0Q7kNvwHQiXFh&_nc_oc=Adr_Xn-KrPvwS1MNMQ-7G-gerVDVoNF3J8OX8r91aFL8hUbrcN2Ae0Lq22Hv-9wowz4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af278LgOWrkwbxieKXbeRrrUQe5pQJ1oegnraO1aZDfi5Q&oe=69F1F5FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Punch Bomb", "keywords": ["Punch", "Arcade", "Bomb", "Game", "Challenge"], "long_description": "# Do you like to punch things?!\nPunch Bomb is an intense action arcade game where you punch things designed from the ground up for those who like a challenge!\n\nThis game **IS NOT EASY**\n\nClimb the global leaderboards in 3 punchable game modes!\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n# Classic Mode\n\n\n\nSurvive for as long as you can while punching a variety of bombs away from you before they explode, racking up huge combos, hitting targets, and dodging dangerous laser obstacles!\n{4009259875886708}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n\n# Blitz Mode\n\nRegular bombs no longer explode in this mode, and targets extend your time. Go ballistic to try to get as high of a score as possible within the time limit!\n{1063827595628759}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n\n# Challenge Mode\nComplete a fun collection of small challenges that put your speed and accuracy to the test!\n{1207719874395696}\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Unique Cosmetics\nUnlock a variety of unique cosmetics by **PLAYING THE GAME** if you're up for a good challenge! Each with their own unique particle effect!\n\n\n\n\n{1198946195348915}", "short_description": "Do you like to punch things?! Punching bombs away from you before they explode while dodging dangerous laser obstacles and hitting targets! Compete in global leaderboards across 3 punchable game modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://punchbomb.com/punchbombTOS.html", "developer_terms_of_service_url": "https://punchbomb.com/punchbombTOS.html", "publisher_name": "Chris Folea Makes Things", "support_website_url": null, "website_url": "https://www.punchbomb.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24451753894412031"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1263459085875821"}, {"status": "PUBLISHED", "id": "1859348674942653"}, {"status": "PUBLISHED", "id": "1426708209093551"}, {"status": "PUBLISHED", "id": "697113676597347"}]}, "baseline_offer": {"id": "697113676597347"}, "is_approved": true, "firstOffer": {"nodes": [{
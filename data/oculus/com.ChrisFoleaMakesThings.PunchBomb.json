tps://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312373_1363239738226092_2106854729412937022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lQSU1b34AwQ7kNvwEjuHwU&_nc_oc=Adoub1zAVPLuJVRvE_8X5azF5NWGAhyqtwkPqqGA6Zhdl11YArvU2a1zvG3M4B6y8TA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kZHxSBMujnuGOXpJ74w8bPjLIUV5RpojOJWpZJ5fgXw&oe=69F9DF6E"}, {"file_name": "ChallengeMode_Image_02.png", "id": "1188201992987967", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499295509_1188201996321300_2111120103698102006_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKk9G83UbosQ7kNvwHY7PnI&_nc_oc=AdrTxx4aqGhlF3f6BVPgT9Lx-MyArnlWQODP2CtzMjoi47T7982TAvFhf4ZYLEjxxGQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60tJV6Zg0XT1V4zTkijtobxOXC5IZttTF0Ybe3HDrmBw&oe=69FA0C0A"}, {"file_name": "Cosmetics_Image_02.png", "id": "1737987487068873", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295801_1737987493735539_1039395962667216685_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYDc8f6O4-wQ7kNvwHmZrKK&_nc_oc=Adrc21sZkNFoTKu2Px1w8ueqPlheoMLv0jOZ9isKInPbfgkcIi5GWXXsKczOduqmnl0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fh_9FHsB6sRhkIxez66H4C0f6PEcKdSjh33eBuEtu_w&oe=69F9FB2B"}, {"file_name": "DodgeLasers_02.png", "id": "3637904013182167", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294007_3637904023182166_4032639804070807573_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goC7seC7Q1wQ7kNvwE1Szoy&_nc_oc=Adr4Pf9PqFHUjnivR6M3_Bx3WUNDND-YpbR_pVvLszesYr3Cqgo7dCvcuCa29mmcImY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5h660jOd5aV67QSx3GS9oBqxrd598Comt6itSahBn9WQ&oe=69F9E831"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_New.png", "id": "898823102474350", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299808_898823109141016_4587002048357409884_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aawovVAeY9wQ7kNvwHqn0kn&_nc_oc=AdqUaDmqXa25y1rL1x-tNuOxBLuU9dC1dbaAKSfi87eMlSTh2kmvEz7bDOvU6fS43QE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xbme9pvGFslXUw18jFcXEH-LMwPbqzQ5yxSvOSoHSCQ&oe=69F9E7F8"}, "display_name": "Punch Bomb", "keywords": ["Punch", "Arcade", "Bomb", "Game", "Challenge"], "long_description": "# Punch Bomb\nis a fast-paced 360\u00b0 action arcade game where you punch bombs away before they explode.\n\nBuilt for those who love a challenge.\n\nClimb the global leaderboards across 3 punchable game modes!\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Classic Mode\nSurvive as long as you can! Punch a variety of bombs away from you before they explode, dodge dangerous laser obstacles, hit targets, and rack up huge combos.\n{4009259875886708}\n\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Blitz Mode\n\nRace against the clock to get a high score within the time limit! Bombs no longer explode, and targets extend your time. \n{1063827595628759}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Challenge Mode\nComplete a fun collection of challenges that put your speed and accuracy to the test!\n{1207719874395696}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Unique Cosmetics\nUnlock unique cosmetics by **playing the game** and mastering its challenges. Each cosmetic has its own visual flair!\n\n\n\n\n{1198946195348915}", "short_description": "Punch bombs away from you before they explode while racking up combos, dodging dangerous laser obstacles, and hitting targets! Compete in global leaderboards across 3 punchable game modes!"}]}, "developer_name": null, "developer_priv
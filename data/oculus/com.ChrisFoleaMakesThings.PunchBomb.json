tps://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312373_1363239738226092_2106854729412937022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_OauPid5wgQ7kNvwEIUlSn&_nc_oc=AdrkCfxgaioWBwrP9aWd8tpdUP25N0ngIxD7-hfhhp2uXLHt7CGlr5r_fSqxXEYRL2k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOw9Upv1txXrmkM9KVk5ij2YcxWrydhzb42wgMHo7O5bw&oe=6ACE592E"}, {"file_name": "ChallengeMode_Image_02.png", "id": "1188201992987967", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295509_1188201996321300_2111120103698102006_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FaxG-WMpGcIQ7kNvwHY16jW&_nc_oc=AdqzM3UtUMEz6EeYi64-tbHzw647i-IzpT3mttR7SdJkgCu6b7_-RvKzNbgnLAMCkL0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOV9HgDzq02G8UNNhEavoSQYHefjUDbE2aHC0IgmvPDdQ&oe=6ACE4D8A"}, {"file_name": "Cosmetics_Image_02.png", "id": "1737987487068873", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295801_1737987493735539_1039395962667216685_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moZnNIlF1FoQ7kNvwFXvQCQ&_nc_oc=AdpVAQ3rWGJRYXL9Dkr9SUkM7z6r5H7YX-fBMpjImkkq1XBlcbFR23o2bj-Y38k-1oo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsuUhQBuST49TrTSFL_K6an-5Bc0-4DySgqk9rqZmn5A&oe=6ACE3CAB"}, {"file_name": "DodgeLasers_02.png", "id": "3637904013182167", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294007_3637904023182166_4032639804070807573_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FBzmE7IcqwQ7kNvwFHlzoX&_nc_oc=Ado4JROogD6FjbAL2xv-3e-Uzj2RRazRysOHs0pkqoSc3h_ZUlUojhgZfDBwG6Q8zD4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-lS2awk-igs65EA3bO-kfWdGK0yaGCwbQgQTdqZpAyQ&oe=6ACE61F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_New.png", "id": "898823102474350", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299808_898823109141016_4587002048357409884_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQ0d09gEPQgQ7kNvwEqVm6c&_nc_oc=AdoaYeUkEzInyJmVSgetC15HUgkHoBxlcMEzsLElJ4lNF1nU831mWLqSJBEu5pWQqI0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4peJUPs9vxb2tUw4la7zV0n3u35zw6EI4K22JvOEY7A&oe=6ACE61B8"}, "display_name": "Punch Bomb", "keywords": ["Punch", "Arcade", "Bomb", "Game", "Challenge"], "long_description": "# Punch Bomb\nis a fast-paced 360\u00b0 action arcade game where you punch bombs away before they explode.\n\nBuilt for those who love a challenge.\n\nClimb the global leaderboards across 3 punchable game modes!\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Classic Mode\nSurvive as long as you can! Punch a variety of bombs away from you before they explode, dodge dangerous laser obstacles, hit targets, and rack up huge combos.\n{4009259875886708}\n\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Blitz Mode\n\nRace against the clock to get a high score within the time limit! Bombs no longer explode, and targets extend your time. \n{1063827595628759}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Challenge Mode\nComplete a fun collection of challenges that put your speed and accuracy to the test!\n{1207719874395696}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Unique Cosmetics\nUnlock unique cosmetics by **playing the game** and mastering its challenges. Each cosmetic has its own visual flair!\n\n\n\n\n{1198946195348915}", "short_description": "Punch bombs away from you before they explode while racking up combos, dodging dangerous laser obstacles, and hitting targets! Compete in global leaderboards across 3 punchable game modes!"}]}, "developer_name": null, "developer_priv
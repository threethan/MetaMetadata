tps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312373_1363239738226092_2106854729412937022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVpnS0O5-AMQ7kNvwH9IchN&_nc_oc=AdquIGXpxDmhDaE6H-FU2KcryfayQSzUhAcf8nFzn7WqkKTPOFHTU0hFGBqmCkDotoc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXAPuWuFNmaC-IHUAz3gSKHy7gdgdIn9IRMzeVDxMscg&oe=6A5E116E"}, {"file_name": "ChallengeMode_Image_02.png", "id": "1188201992987967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499295509_1188201996321300_2111120103698102006_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3sm8QB21C0Q7kNvwEerhVv&_nc_oc=Ado9hsO50Irt3tearKEOhgth5OBrQZnIJ9BSUiO_HIkZqIPmoNS1pcPqBlXxicUjSP4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMJwV1dXxaaqq75eVrzdjp-cIpz6mxpyCGLUEr-POnYQ&oe=6A5E05CA"}, {"file_name": "Cosmetics_Image_02.png", "id": "1737987487068873", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295801_1737987493735539_1039395962667216685_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpkWjJCexCUQ7kNvwHBDoQE&_nc_oc=AdrZFbKBhOqQqY8-Ew8IWuFhi6ZsbxLChG5wCITI4IeD39LqMR-b7BMIR11vfLvOQR4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCxEmp0GoKwtcSHtI5wTBwAgT4h1J3br7saEObOjEQoA&oe=6A5E2D2B"}, {"file_name": "DodgeLasers_02.png", "id": "3637904013182167", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499294007_3637904023182166_4032639804070807573_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNu5JeMUsvkQ7kNvwFPL8Km&_nc_oc=AdrGkmh1jZAGLriISak_PIFdiAEegHnjaDgkFa-eb85rxZMGTbB3z9SLa02_-X6uauk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAksEeFcO-gX7ReMAjki_6a01Jweqdbex_qPqwv8CbMqQ&oe=6A5E1A31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_New.png", "id": "898823102474350", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299808_898823109141016_4587002048357409884_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ySyRLVgmboQ7kNvwH2DIzC&_nc_oc=Adr6slRVCHMXkJcZ0ZxgsayrziyEciit7tNpCJXzMunjbLjquM_mW3gOaK7yhJqwtVg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-QxIgw1HUJ4k1ZLC9icrjPo8HbHPenQscOTg3NRazXg&oe=6A5E19F8"}, "display_name": "Punch Bomb", "keywords": ["Punch", "Arcade", "Bomb", "Game", "Challenge"], "long_description": "# Punch Bomb\nis a fast-paced 360\u00b0 action arcade game where you punch bombs away before they explode.\n\nBuilt for those who love a challenge.\n\nClimb the global leaderboards across 3 punchable game modes!\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Classic Mode\nSurvive as long as you can! Punch a variety of bombs away from you before they explode, dodge dangerous laser obstacles, hit targets, and rack up huge combos.\n{4009259875886708}\n\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Blitz Mode\n\nRace against the clock to get a high score within the time limit! Bombs no longer explode, and targets extend your time. \n{1063827595628759}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Challenge Mode\nComplete a fun collection of challenges that put your speed and accuracy to the test!\n{1207719874395696}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Unique Cosmetics\nUnlock unique cosmetics by **playing the game** and mastering its challenges. Each cosmetic has its own visual flair!\n\n\n\n\n{1198946195348915}", "short_description": "Punch bombs away from you before they explode while racking up combos, dodging dangerous laser obstacles, and hitting targets! Compete in global leaderboards across 3 punchable game modes!"}]}, "developer_name": null, "developer_priv
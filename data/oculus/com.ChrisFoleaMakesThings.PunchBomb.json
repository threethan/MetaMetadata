tps://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312373_1363239738226092_2106854729412937022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5TOXwRPWjcQ7kNvwFZYSA5&_nc_oc=AdpQCWD2XmAoTqeTDsQBMgaj5uUS_9eoOtTgkI2Zt5hLAYU0ICEZST_1NZtHRy2Yh9s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAC00q60MkydVWsU-FDDR0M3CaBUeYGAaiq0YDXeYusKQ&oe=6A63576E"}, {"file_name": "ChallengeMode_Image_02.png", "id": "1188201992987967", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499295509_1188201996321300_2111120103698102006_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpXT4VX5_CwQ7kNvwGl-RCU&_nc_oc=AdqSxq6_tz-E36KsvbCQICL1E-pe6UhA3bAf_da1v0_MpO6-Ejg1fdcM40stuPuSpQI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUrlE5YKpZz53lab-7MsdB5BsXW1_LJVnf2vy-Szrbpw&oe=6A63840A"}, {"file_name": "Cosmetics_Image_02.png", "id": "1737987487068873", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295801_1737987493735539_1039395962667216685_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WiXGGEm06sQQ7kNvwHscz9f&_nc_oc=AdqZ9ot2TMCiVMTLQwMKSj0TGLbH8pGLK4CAN8BQtH23Ys6E303IN3GbSdi4tE_p25M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6EulNDUrebzJGrdQHjfTkQbDJIIs6FvVrEZwPFuKHmA&oe=6A63732B"}, {"file_name": "DodgeLasers_02.png", "id": "3637904013182167", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294007_3637904023182166_4032639804070807573_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogdjzHBCDHsQ7kNvwHdea8B&_nc_oc=AdoTudqFsOY1FiAf4y7i82dOfDh3Zt3cDCJPnm1GjxgpNTuZYuf5aeJREF9VtW7UzuQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5iJhXB-ocRlds2GVNUvvS6CtD5mawpRQcP9LOdxp5eA&oe=6A636031"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_New.png", "id": "898823102474350", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299808_898823109141016_4587002048357409884_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCu64bfG9_IQ7kNvwGpoNza&_nc_oc=AdrtmmulmJIAWMrZePyxDR9Lfh9K-MRGKJr3wMrkqch9xXAD-hIzgFP2XWA_rOtMJKQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAnrj6rlz2x_xtcy6POqMM-PxAVTPlreIb-u8k0qOmiA&oe=6A635FF8"}, "display_name": "Punch Bomb", "keywords": ["Punch", "Arcade", "Bomb", "Game", "Challenge"], "long_description": "# Punch Bomb\nis a fast-paced 360\u00b0 action arcade game where you punch bombs away before they explode.\n\nBuilt for those who love a challenge.\n\nClimb the global leaderboards across 3 punchable game modes!\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Classic Mode\nSurvive as long as you can! Punch a variety of bombs away from you before they explode, dodge dangerous laser obstacles, hit targets, and rack up huge combos.\n{4009259875886708}\n\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Blitz Mode\n\nRace against the clock to get a high score within the time limit! Bombs no longer explode, and targets extend your time. \n{1063827595628759}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Challenge Mode\nComplete a fun collection of challenges that put your speed and accuracy to the test!\n{1207719874395696}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Unique Cosmetics\nUnlock unique cosmetics by **playing the game** and mastering its challenges. Each cosmetic has its own visual flair!\n\n\n\n\n{1198946195348915}", "short_description": "Punch bombs away from you before they explode while racking up combos, dodging dangerous laser obstacles, and hitting targets! Compete in global leaderboards across 3 punchable game modes!"}]}, "developer_name": null, "developer_priv
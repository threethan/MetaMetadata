tps://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312373_1363239738226092_2106854729412937022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q64lrTT4_vQQ7kNvwGWU_Cu&_nc_oc=AdrjG26yReIqjroraS-rEpskqugvvNXBn-Qjpi4apjJ356UfgXXwWQKrHKU408nR0ds&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAVdOUN7ACeRBm3CgJyELXARj7N5gKuDIpMHXyxEsglA&oe=6AA14DEE"}, {"file_name": "ChallengeMode_Image_02.png", "id": "1188201992987967", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499295509_1188201996321300_2111120103698102006_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5h_YlDG5sKIQ7kNvwGjvqXQ&_nc_oc=AdqfT1NCrQO_eEZZ8PSGM6i7ao0FJNmSfCsgyIt-depXkeKPFqApYan4oqlMSAnVikQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuR9awDlSlh2WjE5aS5Ut-xSJ4F5_LDVAbx0PIS6WPTQ&oe=6AA17A8A"}, {"file_name": "Cosmetics_Image_02.png", "id": "1737987487068873", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499295801_1737987493735539_1039395962667216685_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mruy_vV3IPcQ7kNvwGs2aFV&_nc_oc=AdrrGWwue_NsEQASN4uI8ezGOhOTFXWzTccPEW25WF_adwvIqtXfeUjqSZbka-aPit8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRHU7gWpjj2C2S21IcmsITyZfiCUOmiv9nGpmwEM2h3A&oe=6AA169AB"}, {"file_name": "DodgeLasers_02.png", "id": "3637904013182167", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499294007_3637904023182166_4032639804070807573_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNgnhHcw_VAQ7kNvwHJy9i-&_nc_oc=AdqEUdLtW12klDxvBYak1TProdInDrv1RV_x7rcdXFlmYrub9wLdHcCozC_khrxI3sk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2Iwm0mbkcXDSiavD-g3i9gI56kVMioeTVC_SReBE0mQ&oe=6AA156B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_New.png", "id": "898823102474350", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499299808_898823109141016_4587002048357409884_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QY8wvwXOM5MQ7kNvwEveHkJ&_nc_oc=AdpMbhziqbMrvR22lgDcNniP5zvQj_vUbJcTyRrh-Ssjx-bWtQ9V66dF07OW0KxZrnY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-IxXK1X4OH5UUQvUAPy7sgmZwZnqdDe-I1aNGAjeG8g&oe=6AA15678"}, "display_name": "Punch Bomb", "keywords": ["Punch", "Arcade", "Bomb", "Game", "Challenge"], "long_description": "# Punch Bomb\nis a fast-paced 360\u00b0 action arcade game where you punch bombs away before they explode.\n\nBuilt for those who love a challenge.\n\nClimb the global leaderboards across 3 punchable game modes!\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Classic Mode\nSurvive as long as you can! Punch a variety of bombs away from you before they explode, dodge dangerous laser obstacles, hit targets, and rack up huge combos.\n{4009259875886708}\n\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Blitz Mode\n\nRace against the clock to get a high score within the time limit! Bombs no longer explode, and targets extend your time. \n{1063827595628759}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Challenge Mode\nComplete a fun collection of challenges that put your speed and accuracy to the test!\n{1207719874395696}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Unique Cosmetics\nUnlock unique cosmetics by **playing the game** and mastering its challenges. Each cosmetic has its own visual flair!\n\n\n\n\n{1198946195348915}", "short_description": "Punch bombs away from you before they explode while racking up combos, dodging dangerous laser obstacles, and hitting targets! Compete in global leaderboards across 3 punchable game modes!"}]}, "developer_name": null, "developer_priv
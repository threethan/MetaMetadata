b=1-7&_nc_sid=6e7a0a&_nc_ohc=YDilgQo1b-UQ7kNvwEW8rQS&_nc_oc=AdnpKN0xBfUjUEc8WuYBOnZsr439yrk1Fp8sysoJgEc8812MlCO5TUpwVuCzNXUfv5c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfudQdpHSZQqGoz4B7mscCxId1q2MkXjtEsF9mUINnP33Q&oe=6999A1EE"}, {"file_name": "ChallengeMode_Image_02.png", "id": "1188201992987967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295509_1188201996321300_2111120103698102006_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tD6rI4ZA2ZcQ7kNvwEGWWRw&_nc_oc=Adm417Arq_Pck5XTy7Enx4Ixa70-DslrpJ4vF9_YTlJILAjioZNvzK_L0D5Fe0_aKpI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuvBK4zgGKmmCuA7HXUIatStmGrV5tCJZJNxBMMO3Ybjg&oe=6999964A"}, {"file_name": "Cosmetics_Image_02.png", "id": "1737987487068873", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295801_1737987493735539_1039395962667216685_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RCQtX6RQUwQ7kNvwHA3PlR&_nc_oc=AdmS62DVbNaJQrlLS7PAbTd_ZQa_oP7rcaQL8WmrUZ-26T9JX6wy0cgNc4BomTkfXgI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsNo66K-a5zVAJJPOuzI76OYSoxY7KIzMhgQ1AaUZ1FPA&oe=6999BDAB"}, {"file_name": "DodgeLasers_02.png", "id": "3637904013182167", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499294007_3637904023182166_4032639804070807573_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGqEJSv42CAQ7kNvwHC-oEz&_nc_oc=AdnNZLm4p0Q4Yl4KRMx0Awm2xDSQMvX0UniTEDmJn3_janyr50wyALOzM3HtVHHMKBo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsVriKAY_xD9_mH09tNBm6k9mvsLFMgZITNTvkmCUrOBA&oe=6999AAB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_New.png", "id": "898823102474350", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299808_898823109141016_4587002048357409884_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWtNG2uzgi0Q7kNvwGG4Dez&_nc_oc=Adl8wkLuG9RxgwIEsV72vNosoGd4m6oo8opQokVMlc3T5zRro-wtZwSYBrd4yDfjXTM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftbCpI1UvYGe2Qr9QpHtaJOBGOH9xFRC3cZmnAHgK-6Hg&oe=6999AA78"}, "display_name": "Punch Bomb", "keywords": ["Punch", "Arcade", "Bomb", "Game", "Challenge"], "long_description": "# Punch Bomb\nis a fast-paced 360\u00b0 action arcade game where you punch bombs away before they explode.\n\nBuilt for those who love a challenge.\n\nClimb the global leaderboards across 3 punchable game modes!\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Classic Mode\nSurvive as long as you can! Punch a variety of bombs away from you before they explode, dodge dangerous laser obstacles, hit targets, and rack up huge combos.\n{4009259875886708}\n\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Blitz Mode\n\nRace against the clock to get a high score within the time limit! Bombs no longer explode, and targets extend your time. \n{1063827595628759}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Challenge Mode\nComplete a fun collection of challenges that put your speed and accuracy to the test!\n{1207719874395696}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Unique Cosmetics\nUnlock unique cosmetics by **playing the game** and mastering its challenges. Each cosmetic has its own visual flair!\n\n\n\n\n{1198946195348915}", "short_description": "Punch bombs away from you before they explode while racking up combos, dodging dangerous laser obstacles, and hitting targets! Compete in global leaderboards across 3 punchable game modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://punchbomb.com/punchbombTOS.html", "developer_terms_of_service_url": "https://punchbomb.com/punchbombTOS.html", "publisher_name": "Chris Folea Makes Things",
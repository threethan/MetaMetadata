ketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8CombQLBa0Q7kNvwEi_sww&_nc_oc=AdrR4aETufnr0YXoHBQ_WdyqjhfB8Zmq1oVAPFGSQ-jysScEzi1I5hoELy4DMxptCsM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpyCKCVMcqs60s11AOxELUdy4n7WufNj5qpJDyXrI_YA&oe=6B0863DC"}, {"file_name": "GlobalLeaderboards_Image.png", "id": "556916340796636", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618051_556916344129969_4630520520253278561_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1UMsp3-dkIQ7kNvwFRVEDy&_nc_oc=Adp-LyY4Y3md8RDlpAdqg75Iadmq86MsrOkMMaaLo5hj6JLpaBqsgWUwCM2Mcl2a3mg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQunLB58vNhPWlSmCcUwIrhQq8yxN0ZUjxNJetACiGOJQ&oe=6B086D20"}, {"file_name": "ChallengeMode_Image.png", "id": "1238200904331680", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499301526_1238200907665013_4439728854047711627_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cbhntIF4kEQ7kNvwExIV18&_nc_oc=AdqY1gqeo3i06-07J6GVfr4kNdPH1m5IRkpkTHwf7YDULpknnZJqkeK8MSK3SZ4ZpNo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjTu_Q8YfCMLlWf96ZgSxBfq1q_z-W_1tYasYq5T7PFA&oe=6B0862EB"}, {"file_name": "Cosmetics_Image.png", "id": "1366120307973125", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499300977_1366120311306458_2475007633126940757_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1EYMSb0lZAQ7kNvwHIWGiz&_nc_oc=AdoTzc39KA_FGMlX5TCm7z19qRfJyTZ2Da8MlRhELkdtm0Md8KQZShmextGXpfkHVTw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0WHLi5iwrx0TU4a4ohBsbRkVL2G8-Ilo7a0RgU2oaWQ&oe=6B085ABB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Punch Bomb", "keywords": ["Punch", "Arcade", "Bomb", "Game", "Challenge"], "long_description": "# Do you like to punch things?!\nPunch Bomb is an intense action arcade game where you punch things designed from the ground up for those who like a challenge!\n\nThis game **IS NOT EASY**\n\nClimb the global leaderboards in 3 punchable game modes!\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n# Classic Mode\n\n\n\nSurvive for as long as you can while punching a variety of bombs away from you before they explode, racking up huge combos, hitting targets, and dodging dangerous laser obstacles!\n{4009259875886708}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n\n# Blitz Mode\n\nRegular bombs no longer explode in this mode, and targets extend your time. Go ballistic to try to get as high of a score as possible within the time limit!\n{1063827595628759}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n\n# Challenge Mode\nComplete a fun collection of small challenges that put your speed and accuracy to the test!\n{1207719874395696}\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Unique Cosmetics\nUnlock a variety of unique cosmetics by **PLAYING THE GAME** if you're up for a good challenge! Each with their own unique particle effect!\n\n\n\n\n{1198946195348915}", "short_description": "Do you like to punch things?! Punching bombs away from you before they explode while dodging dangerous laser obstacles and hitting targets! Compete in global leaderboards across 3 punchable game modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://punchbomb.com/punchbombTOS.html", "developer_terms_of_service_url": "https://punchbomb.com/punchbombTOS.html", "publisher_name": "Chris Folea Makes Things", "support_website_url": null, "website_url": "https://www.punchbomb.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": 
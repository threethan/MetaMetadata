b=1-7&_nc_sid=6e7a0a&_nc_ohc=O48g5JTgbV8Q7kNvwE-VGG5&_nc_oc=AdmRx8F4pwmXD4NWI7SBBALclX8EHjuxzCQR9pYdt6kH63L6lkGzbyIJCrFA-bumoJw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftUGeqwGKbx9do6bLbboLPATzOkJMjIbfjzbj9V5itJ_g&oe=69A18AEE"}, {"file_name": "ChallengeMode_Image_02.png", "id": "1188201992987967", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499295509_1188201996321300_2111120103698102006_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSvSlWw_9qUQ7kNvwHHGQMW&_nc_oc=AdlAGqw1qxsFJWsIFX5H1z1dh3CbWq8iCpMu3VBIgOkHoaqy7bE_29LlNp0btMyvW54&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuVaxC2GlnyveORoZCY5ZJKQ6wjIVeHn8PWlr3oGFIrVQ&oe=69A17F4A"}, {"file_name": "Cosmetics_Image_02.png", "id": "1737987487068873", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499295801_1737987493735539_1039395962667216685_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnoc8fWw01MQ7kNvwEGuEcc&_nc_oc=Adk32GSf1DNkAxZqlDqKli25jqB4VzfN1jcxE3MSHFqQ4ITGIWZAvVJS7t4zw3a2k-w&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftGv2ZiiBxUmsmcoLxMlKknpVtpcS5fnFgqBvbH1oAlNw&oe=69A1A6AB"}, {"file_name": "DodgeLasers_02.png", "id": "3637904013182167", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499294007_3637904023182166_4032639804070807573_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uXdUyHFVE4Q7kNvwGBwnO3&_nc_oc=AdmlI2EKxNQQbWUr34pxnkMDDXeCI_oIA0Uarxo_04NVRyzlYMT85o9UO8hncHYtSHc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afv5ipkl61RUOp3aKMaxfBnxnKFSqdfPNRkfVG7zJ91S6w&oe=69A193B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_New.png", "id": "898823102474350", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/499299808_898823109141016_4587002048357409884_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tlOQiGJaDgQ7kNvwF1xJel&_nc_oc=AdmSIcc0N970NIKflh1EgPxJTuVSoYtNjfVGSX12CJ2FyI6jni0Wx4ELzIsU1BLnMKs&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afu67cmJYDMRRixdw8BE44c0TRZ8Wk0Uh0JB-zfSuE1pJA&oe=69A19378"}, "display_name": "Punch Bomb", "keywords": ["Punch", "Arcade", "Bomb", "Game", "Challenge"], "long_description": "# Punch Bomb\nis a fast-paced 360\u00b0 action arcade game where you punch bombs away before they explode.\n\nBuilt for those who love a challenge.\n\nClimb the global leaderboards across 3 punchable game modes!\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Classic Mode\nSurvive as long as you can! Punch a variety of bombs away from you before they explode, dodge dangerous laser obstacles, hit targets, and rack up huge combos.\n{4009259875886708}\n\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Blitz Mode\n\nRace against the clock to get a high score within the time limit! Bombs no longer explode, and targets extend your time. \n{1063827595628759}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Challenge Mode\nComplete a fun collection of challenges that put your speed and accuracy to the test!\n{1207719874395696}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Unique Cosmetics\nUnlock unique cosmetics by **playing the game** and mastering its challenges. Each cosmetic has its own visual flair!\n\n\n\n\n{1198946195348915}", "short_description": "Punch bombs away from you before they explode while racking up combos, dodging dangerous laser obstacles, and hitting targets! Compete in global leaderboards across 3 punchable game modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://punchbomb.com/punchbombTOS.html", "developer_terms_of_service_url": "https://punchbomb.com/punchbombTOS.html", "publisher_name": "Chris Folea Makes Things",
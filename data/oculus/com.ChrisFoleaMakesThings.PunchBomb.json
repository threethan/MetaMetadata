PKfDhkDC8-F8sZyoyLbp2vDVw&oe=6A89A4E0"}, {"file_name": "ChallengeMode_Image.png", "id": "1238200904331680", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301526_1238200907665013_4439728854047711627_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZR2fd_aOyakQ7kNvwH5tib5&_nc_oc=AdpO71H4KHfT8NCyeA0YhqnF1WUQkjoODO2-yPX6Ni-Wnajgr113WbjG24bfoo-_5ps&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0RJMrTkqjDGNs9DxRFsr6t0jmqog6hZLJ2go3af1wBw&oe=6A899AAB"}, {"file_name": "Cosmetics_Image.png", "id": "1366120307973125", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300977_1366120311306458_2475007633126940757_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zio8h1xIOzcQ7kNvwGr1wYQ&_nc_oc=Adp8DOPYKX0iV1r9Tx4y1dxr0kGaMC4NhNW02vq5yYSL6aQI3EkMdVaELBs29z3EWxs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpSuewWjD9f4_KVl2Dw5RTaYHnkEUTZqMP2xBX8VTZrg&oe=6A89927B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Punch Bomb", "keywords": ["Punch", "Arcade", "Bomb", "Game", "Challenge"], "long_description": "# Do you like to punch things?!\nPunch Bomb is an intense action arcade game where you punch things designed from the ground up for those who like a challenge!\n\nThis game **IS NOT EASY**\n\nClimb the global leaderboards in 3 punchable game modes!\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n# Classic Mode\n\n\n\nSurvive for as long as you can while punching a variety of bombs away from you before they explode, racking up huge combos, hitting targets, and dodging dangerous laser obstacles!\n{4009259875886708}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n\n# Blitz Mode\n\nRegular bombs no longer explode in this mode, and targets extend your time. Go ballistic to try to get as high of a score as possible within the time limit!\n{1063827595628759}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n\n# Challenge Mode\nComplete a fun collection of small challenges that put your speed and accuracy to the test!\n{1207719874395696}\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Unique Cosmetics\nUnlock a variety of unique cosmetics by **PLAYING THE GAME** if you're up for a good challenge! Each with their own unique particle effect!\n\n\n\n\n{1198946195348915}", "short_description": "Do you like to punch things?! Punching bombs away from you before they explode while dodging dangerous laser obstacles and hitting targets! Compete in global leaderboards across 3 punchable game modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://punchbomb.com/punchbombTOS.html", "developer_terms_of_service_url": "https://punchbomb.com/punchbombTOS.html", "publisher_name": "Chris Folea Makes Things", "support_website_url": null, "website_url": "https://www.punchbomb.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24451753894412031"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1375238687923571"}, {"status": "PUBLISHED", "
b=1-7&_nc_sid=6e7a0a&_nc_ohc=cpB5ymTDLEgQ7kNvwFQ8BaM&_nc_oc=AdlPvKqLKsuKoV8wprWP51sqZaQWjRtNJTjmKOC2WWXYl4kB5q7QmWzMVMwSdHfhMrI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsKMy88DUm65OziTQbee4Tjyu8GnoL6H5WUPvxPKrCCVA&oe=69A6D0EE"}, {"file_name": "ChallengeMode_Image_02.png", "id": "1188201992987967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295509_1188201996321300_2111120103698102006_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpFBeIhwPgcQ7kNvwHCaNIg&_nc_oc=AdlT67fWJ74oDFGTff782mNC1se5kHv8QmEyO9YShhoiO8hy8tCiaAGoyRyz6g5ui9E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftdxmWbFK9Y_pw7Lfk655sviglUxnJQo5wPdSJxMUC1mg&oe=69A6C54A"}, {"file_name": "Cosmetics_Image_02.png", "id": "1737987487068873", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295801_1737987493735539_1039395962667216685_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkM4tgE1t5EQ7kNvwHDdaSM&_nc_oc=AdkrQ4X_g_NStD-4r4Z0At32ZC-U7HjXZom-d_yn-8fYG733-mwfx9wokqbGggrATCY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvWXJWGm2M_JRiDWh3bx_MMcCGzNApBPOKNPUzm01RpSw&oe=69A6ECAB"}, {"file_name": "DodgeLasers_02.png", "id": "3637904013182167", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499294007_3637904023182166_4032639804070807573_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYuHTa2LIHwQ7kNvwHQ0iq9&_nc_oc=Adnpi-aizKWFKhyy0Q2ujqrUeGPXow5foTo82omSP-crgdzQUAk4_EQr5shBp51ITLs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvuj6Tqk5Cd0Av2CNR1pjk-q5MtY7DUsXMJFWRuW3zGwQ&oe=69A6D9B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_New.png", "id": "898823102474350", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299808_898823109141016_4587002048357409884_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pgfLlQ7PLMQ7kNvwGfJwiq&_nc_oc=AdnJg4c6894HSyEShs613H1hBAFmTLattDr-n1CQzm_KU8QXeTscrm0KcN01Ai9PBzw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvSUc613taTdlwy5E4vGx7CmhJse56O1m44cXFFpsv7Fw&oe=69A6D978"}, "display_name": "Punch Bomb", "keywords": ["Punch", "Arcade", "Bomb", "Game", "Challenge"], "long_description": "# Punch Bomb\nis a fast-paced 360\u00b0 action arcade game where you punch bombs away before they explode.\n\nBuilt for those who love a challenge.\n\nClimb the global leaderboards across 3 punchable game modes!\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Classic Mode\nSurvive as long as you can! Punch a variety of bombs away from you before they explode, dodge dangerous laser obstacles, hit targets, and rack up huge combos.\n{4009259875886708}\n\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Blitz Mode\n\nRace against the clock to get a high score within the time limit! Bombs no longer explode, and targets extend your time. \n{1063827595628759}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Challenge Mode\nComplete a fun collection of challenges that put your speed and accuracy to the test!\n{1207719874395696}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Unique Cosmetics\nUnlock unique cosmetics by **playing the game** and mastering its challenges. Each cosmetic has its own visual flair!\n\n\n\n\n{1198946195348915}", "short_description": "Punch bombs away from you before they explode while racking up combos, dodging dangerous laser obstacles, and hitting targets! Compete in global leaderboards across 3 punchable game modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://punchbomb.com/punchbombTOS.html", "developer_terms_of_service_url": "https://punchbomb.com/punchbombTOS.html", "publisher_name": "Chris Folea Makes Things",
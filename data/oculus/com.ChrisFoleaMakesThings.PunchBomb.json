tps://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499312373_1363239738226092_2106854729412937022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcB7WYlhHQYQ7kNvwEaQJo5&_nc_oc=Adol4TuIsBJZ9UUDWZ4zBl37ywxX8AlVg35geocJ8V0kS_pv3YRZtJJFR-XQ5E5m5N0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9saLVLewSfwUCDLeNMZZ1umj9X4oFvMb7JPtiHU3PYsA&oe=6A2C30AE"}, {"file_name": "ChallengeMode_Image_02.png", "id": "1188201992987967", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499295509_1188201996321300_2111120103698102006_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CkcXejOcRAQ7kNvwGwpamf&_nc_oc=Adp84j8GOQbiN5tDf2w3XEn3Pd6umFt_IFSHSlpU6Jz9mymkATm1s920hah4_m-7wJ0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0RYk_pTOlZnPogoLCbyH5nmF6HKfXMWZYaLIeGls5rw&oe=6A2C250A"}, {"file_name": "Cosmetics_Image_02.png", "id": "1737987487068873", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499295801_1737987493735539_1039395962667216685_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uww0-TX541QQ7kNvwELDlWF&_nc_oc=Adp7MWwumvJTIHvbm3fvM2KswTFe__obzQI1v2nBKQdriBL2UtH3FtJz230nJ3SJsqs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Yw1QAMZlfSfEK8FKln28tzZcntAfA7jmk4t6NpuJ3vg&oe=6A2C142B"}, {"file_name": "DodgeLasers_02.png", "id": "3637904013182167", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499294007_3637904023182166_4032639804070807573_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOg92rjiUvMQ7kNvwFYgOaI&_nc_oc=AdrRRPx5hTLy1_t9UrAkox2-F_BCPBfcmuIaTHrsDnAYCe3Opf5Ccv66IE-VIvdf4vE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8akMIFTyDA1VBzcHX9CVEHTzQVBtg8hD9soSO8LnGmRg&oe=6A2C0131"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_New.png", "id": "898823102474350", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499299808_898823109141016_4587002048357409884_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XgQdb26B-EQ7kNvwH3j8ra&_nc_oc=Adq9No3vJTbpCnli4d6CLzUwMScd2qoVxrJbZqytcq0JsKYyTY60mMrGg9i6B-NRqu8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99o6OWwiNwzGNFVCO7MYlvS2EcbEjyKeTOLHX4FXFhwg&oe=6A2C00F8"}, "display_name": "Punch Bomb", "keywords": ["Punch", "Arcade", "Bomb", "Game", "Challenge"], "long_description": "# Punch Bomb\nis a fast-paced 360\u00b0 action arcade game where you punch bombs away before they explode.\n\nBuilt for those who love a challenge.\n\nClimb the global leaderboards across 3 punchable game modes!\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Classic Mode\nSurvive as long as you can! Punch a variety of bombs away from you before they explode, dodge dangerous laser obstacles, hit targets, and rack up huge combos.\n{4009259875886708}\n\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Blitz Mode\n\nRace against the clock to get a high score within the time limit! Bombs no longer explode, and targets extend your time. \n{1063827595628759}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Challenge Mode\nComplete a fun collection of challenges that put your speed and accuracy to the test!\n{1207719874395696}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Unique Cosmetics\nUnlock unique cosmetics by **playing the game** and mastering its challenges. Each cosmetic has its own visual flair!\n\n\n\n\n{1198946195348915}", "short_description": "Punch bombs away from you before they explode while racking up combos, dodging dangerous laser obstacles, and hitting targets! Compete in global leaderboards across 3 punchable game modes!"}]}, "developer_name": null, "developer_priv
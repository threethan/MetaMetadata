tps://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312373_1363239738226092_2106854729412937022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6UPF5AfXSoQ7kNvwEmteL2&_nc_oc=AdpsFdPlrUfGM9YMc0xFKbvSDqau8KHzQI8ElOk1zkMhydlrOOpPK7iWyn4uwAl1pWs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlLQ7zuune2Y5DsOG3jA_MD70AhfL2lYNj2cyjr3WxEg&oe=6AC51EAE"}, {"file_name": "ChallengeMode_Image_02.png", "id": "1188201992987967", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499295509_1188201996321300_2111120103698102006_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0Nj_x9bP9YQ7kNvwHkbZuy&_nc_oc=AdqD6n5j-MSXxym9E2ueCx7gPHHwL7nQUaJroxdR_xAOwVSs33uQBTmTnb0bd4nps7k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-79kRWnUd1N6K2lao9C-Htie9g4cPRbgEuZDpInOPCg&oe=6AC5130A"}, {"file_name": "Cosmetics_Image_02.png", "id": "1737987487068873", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499295801_1737987493735539_1039395962667216685_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbPPYgilzksQ7kNvwEUl6hB&_nc_oc=AdoIAJkDE7sR-vq9sjuEJRNvihxKOLpOss4N9-O5MSNN8MlX7RKxH-Zp44617TsmO64&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsECL4tTq1ao2SZYDnB387oo1Wj7setwEQFR_AdiyDzg&oe=6AC5022B"}, {"file_name": "DodgeLasers_02.png", "id": "3637904013182167", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499294007_3637904023182166_4032639804070807573_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eRHPrtoIcEQ7kNvwF6MOh_&_nc_oc=Adr6tAt1YsLyb1aQ4i2EVuZGRtCl6_KQ59Gj_69u5rfTqxnSnvKRrS9EGas6tbaM3dU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKwUnLHMM3J8bJQaQXM_DqCdY_DUJqJonQYUJ2EF_UnQ&oe=6AC52771"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_New.png", "id": "898823102474350", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499299808_898823109141016_4587002048357409884_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTI37U4cC7IQ7kNvwFZ2XyU&_nc_oc=AdrSjYc96jDkYU0e2StECxBrkgpBq44Mk327maCxOs5pNsWgZXN_S6Dy5KL-dWNCJcM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMe6I8TJE4I3uovM_fJO8jg8dUwRXAWMEyBv3hPhWgYBw&oe=6AC52738"}, "display_name": "Punch Bomb", "keywords": ["Punch", "Arcade", "Bomb", "Game", "Challenge"], "long_description": "# Punch Bomb\nis a fast-paced 360\u00b0 action arcade game where you punch bombs away before they explode.\n\nBuilt for those who love a challenge.\n\nClimb the global leaderboards across 3 punchable game modes!\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Classic Mode\nSurvive as long as you can! Punch a variety of bombs away from you before they explode, dodge dangerous laser obstacles, hit targets, and rack up huge combos.\n{4009259875886708}\n\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Blitz Mode\n\nRace against the clock to get a high score within the time limit! Bombs no longer explode, and targets extend your time. \n{1063827595628759}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Challenge Mode\nComplete a fun collection of challenges that put your speed and accuracy to the test!\n{1207719874395696}\n\n\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\ud83d\udca5\ud83d\udc4a\n\n# Unique Cosmetics\nUnlock unique cosmetics by **playing the game** and mastering its challenges. Each cosmetic has its own visual flair!\n\n\n\n\n{1198946195348915}", "short_description": "Punch bombs away from you before they explode while racking up combos, dodging dangerous laser obstacles, and hitting targets! Compete in global leaderboards across 3 punchable game modes!"}]}, "developer_name": null, "developer_priv
06964386_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfCyr11iyA4Q7kNvwGYVywd&_nc_oc=AdpxCSV52stQ0Dv44rvTIVi_qWoUXrfi0Xt1w88_9atzJmd6h13aoF8AdC8pPtU5uSg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKaXi-eY92nQGybqrH5zvkYwAi3u1JVyv_Mxbm69hp8g&oe=6AE9FA19"}, {"file_name": "05-finished-wall.png", "id": "3441427072723858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595133382_3441427076057191_4353587002216102064_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JhUurqVxNIQ7kNvwFLnDQO&_nc_oc=AdpP-C8cFZT5dR93Bh5t_H5jBDrFr_Rx6AH7k8tPXdymhpBBfKmATjelqoM0vphFyN0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZDzVIAIWd71SLAOJc90D_KF_mGhgP3dbDSXr0e5Ypjg&oe=6AEA1233"}, {"file_name": "04-detail-work.png", "id": "1856386479130586", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596061819_1856386482463919_1103491723561611075_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnZMTHt31sgQ7kNvwHSf7R0&_nc_oc=Adp01nyX3o_lrz-3iuoenWc8jmm6vPgsEgOJcpiLZ0n_HSH3kU3elKuqUiBu5HqzZ_g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZ7tElfvDTM5Z3zwurvproXNwX1jw2DxwmnK9KdB-kew&oe=6AEA0495"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "05-finished-wall.png", "id": "4765565170341147", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595129854_4765565173674480_6506511448185405962_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2mcBKjiV0EQ7kNvwE9Ffud&_nc_oc=AdqKaIUeju52P521NuTPw-l7hYq6wVOJ0E9F_Xuijjhe41V_pbvN06ZJJUEPVBe6geA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-by8nRUH4pHJCSW2IFXYblH-frBksk2bp4A_kLYQnXA&oe=6AEA08F0"}, "display_name": "Chroma Wall MR", "keywords": ["graffiti", "painting", "art", "multiplayer"], "long_description": "## Your room. Your wall. Your style.\n\nChroma Wall MR brings graffiti into your physical space. Keep your surroundings in view while you turn a real wall into a canvas for virtual paint.\n\n## Find your flow\n\nChoose from 16 colours, switch between Skinny, Standard, and Fat caps, and explore three paint finishes. Adjust your distance and trigger pressure to shape each stroke\u2014from tight outlines to broad fills, soft overspray, and running drips.\n\nYour paint rack sits on your off-hand controller, keeping colour and tools within reach. Street-art-inspired menus float in the room around you.\n\n## Make it yours\n\nPaint solo without a server or internet connection. Use a compatible room scan or mark a wall manually, then build your piece layer by layer. Undo recent strokes, save your walls, and export artwork as transparent PNGs.\n\n## Paint with your crew\n\nJoin an optional local-network session and work on a shared wall. See the other painters\u2019 spray cans as your pieces develop together.\n\nShared painting requires a separate Chroma server running on a computer, a reachable local network, and wall alignment on each headset.\n\nGrab your controllers. Make your mark.", "short_description": "Turn your room into a graffiti studio. Spray virtual paint onto real walls, switch caps, mix colors, and build your own style in mixed reality. Paint solo offline, save your pieces, or join a shared wall with friends on a local network."}]}, "developer_name": "Kris Pilcher", "developer_privacy_policy_url": "https://chromawall-mr.vercel.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "Kris Pilcher", "support_website_url": null, "website_url": "https://chromawall-mr.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
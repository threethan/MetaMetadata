06964386_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwpc-cdyiUMQ7kNvwGEE2Ec&_nc_oc=AdrH7d9b4k3RnR2A1JwdFopbU31vY1tFg8ujPu2_SfF8Px1hhDbCbNCFi11v0xjHdnc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUpn80vCjPTR3liAYdhJCMuLmzZImqXLBnC-FZzLidQQ&oe=6AE75719"}, {"file_name": "05-finished-wall.png", "id": "3441427072723858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595133382_3441427076057191_4353587002216102064_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GAfPGoWwGoQ7kNvwFb0IAQ&_nc_oc=AdqY_6BK-7QeyYEoEV0WuT9pBBg9e1yVwh9uFWID-bXdScU1pz9sMR8pj18HfebXrmk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq2YmGO2fGuyQbP3nwheU6KRxCNIp7ULe5h6ggoNSodw&oe=6AE76F33"}, {"file_name": "04-detail-work.png", "id": "1856386479130586", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596061819_1856386482463919_1103491723561611075_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WldiA-CAS4Q7kNvwFoS84o&_nc_oc=AdpUoSq3f24kbD_hywTTIchxUZ7s-4xSxB6EM8RbdAt1IrVDwQJrrtcpBJSHDqxB158&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9lbLR3WYaduQJ9JNjlhCYaMSGvzQ567_FCGIFFQn5MQ&oe=6AE76195"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "05-finished-wall.png", "id": "4765565170341147", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595129854_4765565173674480_6506511448185405962_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uM4WjOcd0zIQ7kNvwE0XrxE&_nc_oc=Adr1ohs4wYjtf_XTx3zqG_v7orM7FhPgXu3jyhZyKi5TuW2Teoo-scPZcaIAHSwURQw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxC4ABci6d8_xouB-350U6gsEfLbGRcQYQGkGfouL3ng&oe=6AE765F0"}, "display_name": "Chroma Wall MR", "keywords": ["graffiti", "painting", "art", "multiplayer"], "long_description": "## Your room. Your wall. Your style.\n\nChroma Wall MR brings graffiti into your physical space. Keep your surroundings in view while you turn a real wall into a canvas for virtual paint.\n\n## Find your flow\n\nChoose from 16 colours, switch between Skinny, Standard, and Fat caps, and explore three paint finishes. Adjust your distance and trigger pressure to shape each stroke\u2014from tight outlines to broad fills, soft overspray, and running drips.\n\nYour paint rack sits on your off-hand controller, keeping colour and tools within reach. Street-art-inspired menus float in the room around you.\n\n## Make it yours\n\nPaint solo without a server or internet connection. Use a compatible room scan or mark a wall manually, then build your piece layer by layer. Undo recent strokes, save your walls, and export artwork as transparent PNGs.\n\n## Paint with your crew\n\nJoin an optional local-network session and work on a shared wall. See the other painters\u2019 spray cans as your pieces develop together.\n\nShared painting requires a separate Chroma server running on a computer, a reachable local network, and wall alignment on each headset.\n\nGrab your controllers. Make your mark.", "short_description": "Turn your room into a graffiti studio. Spray virtual paint onto real walls, switch caps, mix colors, and build your own style in mixed reality. Paint solo offline, save your pieces, or join a shared wall with friends on a local network."}]}, "developer_name": "Kris Pilcher", "developer_privacy_policy_url": "https://chromawall-mr.vercel.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "Kris Pilcher", "support_website_url": null, "website_url": "https://chromawall-mr.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
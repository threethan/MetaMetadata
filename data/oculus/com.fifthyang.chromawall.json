png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfCyr11iyA4Q7kNvwE9Ay9n&_nc_oc=AdpD8_h-a6e2r2uTZavgRXua8H7Nz8wT63Fx00gvL_E7dM6JhbFVjDgtBp2yEITtNGY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRJTY4Izn_g7WIrJ3w9TSReXJiZsFcaDWmxc0YSxhnyg&oe=6AEC9D19"}, {"file_name": "05-finished-wall.png", "id": "3441427072723858", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/595133382_3441427076057191_4353587002216102064_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jvMznKSmEQQ7kNvwHGurp9&_nc_oc=AdrQzWSEWS7-_DJZPBigCvet_TeZ8ir6FeCSBrrjN3xquesjH7PiPPUqZmLiim9hdH4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQltVHUIXnS9Ot-vl8kai1LeQWfuqIBrvCugQHhcF4Jqg&oe=6AECB533"}, {"file_name": "04-detail-work.png", "id": "1856386479130586", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/596061819_1856386482463919_1103491723561611075_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6Yk1RjOUX4Q7kNvwF3KJv7&_nc_oc=AdqB6sDtvK8vbJOYyV9GR3JmT6X8CWeus-g4yRXP1hg3Mq4A2qFkehcb_n1eBP9m5Cc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThZYJCMP6Na3qqTcy0-8dnxwpKOJaE3rlMl27qmxTq0w&oe=6AECA795"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "05-finished-wall.png", "id": "4765565170341147", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/595129854_4765565173674480_6506511448185405962_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PQLPC7qqw4Q7kNvwHsmUaI&_nc_oc=AdriWepgD84c342l1HG88uEuvqwEMJ6yovkc5zh6ycaC6SM-k1lL31igSG8CdJ3oJUU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkVC9dpS5r7mlHHjPkFuM5r_IPZ1ry7cO0iA2IY-R-1w&oe=6AECABF0"}, "display_name": "Chroma Wall MR", "keywords": ["graffiti", "painting", "art", "multiplayer"], "long_description": "## Your room. Your wall. Your style.\n\nChroma Wall MR brings graffiti into your physical space. Keep your surroundings in view while you turn a real wall into a canvas for virtual paint.\n\n## Find your flow\n\nChoose from 16 colours, switch between Skinny, Standard, and Fat caps, and explore three paint finishes. Adjust your distance and trigger pressure to shape each stroke\u2014from tight outlines to broad fills, soft overspray, and running drips.\n\nYour paint rack sits on your off-hand controller, keeping colour and tools within reach. Street-art-inspired menus float in the room around you.\n\n## Make it yours\n\nPaint solo without a server or internet connection. Use a compatible room scan or mark a wall manually, then build your piece layer by layer. Undo recent strokes, save your walls, and export artwork as transparent PNGs.\n\n## Paint with your crew\n\nJoin an optional local-network session and work on a shared wall. See the other painters\u2019 spray cans as your pieces develop together.\n\nShared painting requires a separate Chroma server running on a computer, a reachable local network, and wall alignment on each headset.\n\nGrab your controllers. Make your mark.", "short_description": "Turn your room into a graffiti studio. Spray virtual paint onto real walls, switch caps, mix colors, and build your own style in mixed reality. Paint solo offline, save your pieces, or join a shared wall with friends on a local network."}]}, "developer_name": "Kris Pilcher", "developer_privacy_policy_url": "https://chromawall-mr.vercel.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "Kris Pilcher", "support_website_url": null, "website_url": "https://chromawall-mr.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_language
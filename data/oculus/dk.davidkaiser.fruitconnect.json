-VT-roztrO433u1Edd8qQMbi7AHGDdrqW1dD2ZG6XIw&oe=6ADCB8EE"}, {"file_name": "cover-portrait-blur-60.png", "id": "746779958520929", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499308204_746779961854262_3072555736807179467_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyzQATsQuIIQ7kNvwHxp4Ng&_nc_oc=Ado6ZmY483OW8Ki1EmcXzJBdE_mieknK1Ul5grOuL0x6pZ11HyYRaltwDXvAu0hjgjo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgiHzp6ywMQqV4Nyjj1Dc7uwtbKb3a809padUOLjLpYw&oe=6ADCA975"}]}, "id": "1695542564931703", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "1490368335885536", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499296119_1490368339218869_6864463726382071704_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Xju-uckLSsQ7kNvwF1ysGM&_nc_oc=AdqIIcbiGMkUPIRgF-hP-ObhFYrGv9EvAYpWyyrcz8snyXfWrULpuacCs6DhCP3OONQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtV3meyMnq3KVX6_pJIgB9B95sLjVgqSVD4WQ7goqeHw&oe=6ADCABDF"}, {"file_name": "1a.png", "id": "2026598141398274", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499304952_2026598144731607_6823801470209106974_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXophF6GAJAQ7kNvwEECl09&_nc_oc=Adp0IpyHV0qeXi9nInW12YQNYk_vu7EjR2y_rTepAMj2gB1k0wEkgpvlf_QLMh1zTbA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTIDzF4rkpBV98NLfLgLRO3EaiLdn6LRukuomCaKKnKA&oe=6ADCAB4C"}, {"file_name": "4.png", "id": "2613669335694878", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499313110_2613669339028211_2836038882116236044_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0p7uhx_fV0Q7kNvwEPoVls&_nc_oc=AdpvJ3gVHWy_eYX4hg1S4g4Ntum4bwl4WqFYiBzoQywMScpscdzf_C1zlHHpsrZ-uiw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOu2pNljijJndw_yD4y3cmSirG50COpiSWGo7jvx0-6yQ&oe=6ADCCD61"}, {"file_name": "5.png", "id": "26708331965518085", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308050_26708331968851418_858257112352208017_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8Uklu63MFsQ7kNvwFBjHrE&_nc_oc=AdoH9Cizrdo8nf5zvqY5Y_OaMYqFmF0-YHZLLY5XS0fDt6vwkWJyozCNEd1iDfFyzBc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_tCz7c0bO7fiuo2plbrXnuJUth5peLo55y-PT9_uX0w&oe=6ADCB0FA"}, {"file_name": "2a.png", "id": "2226121364889550", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307470_2226121368222883_1551488538571217484_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhQSnInvPGcQ7kNvwEDuKeS&_nc_oc=AdpLc1BX01DH0w-8OgiapujoMdvx0X8JZAfz6NmWq24cFpz1sowir-T93bN67Lx1xkU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHPgdBGS7vdxlcpIG_zbh4hkE5G2bIHuKqe3eO-wsZrQ&oe=6ADCC127"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1238404628113706", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618274_1238404631447039_8589256968880698305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZ5qsZlu8wAQ7kNvwGNz9C4&_nc_oc=Adrrj8Dsg8yL7BbCkzUfz68M81xoiAPcDRX1ZquNjikk65UqU-5TBbItlQBmvs6Ehrg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGZktDYb2AkFk2jC_NYb485xQRi55aVZYoQaWUNSLLzA&oe=6ADCA751"}, "display_name": "FruitConnect", "keywords": ["desktop", "remote", "monitor", "mac", "productivity"], "long_description": "FruitConnect turns your Meta Quest into a wireless Mac display with audio. See your Mac desktop as a floating 2D panel in Quest Home and hear it through your headset \u2014 no need to take off your Quest.\n\nHOW IT WORKS\nInstall the Mac and Quest apps and pair once with a 6-digit code or QR scan. FruitConnect connects automatically:\n- Same Wi-Fi or USB-tethered \u2014 direct peer-to-peer, works fully offline\n- Anywhere with internet \u2014 encrypted Remote Access\nScreen and audio stream via WebRTC with hardware H.265 video and AAC audio for low latency.\n\nCONTROL YOUR MAC IN VR\nClick with Quest controllers like a mouse. Type with the Quest virtual keyboard or the floating QWERTY panel. Browse, code, watch videos, manage files \u2014 without removing your headset.\n\nKEY FEATURES\n- Wireless or USB-tethered streaming\n- Works offline \u2014 no internet needed for local Wi-Fi or USB streaming\n- Mac audio in your Quest headphones\n- Remote Access from anywhere with internet\n- Pop-out displays \u2014 extend with floating panels\n- Save multiple Macs and switch easily\n- Hardware H.265 video at 60fps\n- Zero-knowledge pairing (QR or 6-digit code)\n- End-to-end encrypted (DTLS-SRTP)\n- Floating QWERTY panel for fast typing\n\nPRIVACY\nAll streaming is peer-to-peer and end-to-end encrypted. The Remote Access rendezvous server sees only opaque ciphertext \u2014 never your screen, audio, keystrokes, or files.\n\nFREE vs PRO\n- Free: 15-minute sessions\n- Pro: unlimited sessions, $7.99/mo or $64.99/yr (save 32%) via Meta Store\n\nREQUIREMENT", "short_description": "Stream your Mac display + audio to Meta Quest as a floating 2D panel \u2014 at home over Wi-Fi or anywhere via Remote Access. Control with Quest controllers and the virtual keyboard. End-to-end encrypted H.265 video + AAC audio. Remote access requires an internet connection."}]}, "developer_name": null, "developer_privacy_policy_url": "https://davidkaiser.dk/fruitconnect/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DavidKaiser", "support_website_url": null, "website_url": "https://davidkaiser.dk/fruitconnect", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}, {"id": "1055187466124150"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics
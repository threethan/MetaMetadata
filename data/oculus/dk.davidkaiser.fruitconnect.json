m/v/t64.5771-25/499308050_26708331968851418_858257112352208017_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPmTF_7dGp8Q7kNvwEPWLm1&_nc_oc=AdqSHC4KZed539hAg6qayjRo4q5C8L6ShVKBgsHfGbfU6HTURXCpYh8qqetODlmKu0Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPnIbD61UL2uWHQD4emGctHj814y0qc8j_a6oFgofJnw&oe=6AE3487A"}, {"file_name": "2a.png", "id": "2226121364889550", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307470_2226121368222883_1551488538571217484_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GJ8uY6WWOQQ7kNvwGZ-ClG&_nc_oc=Adptkbwmybq8QOBxc21TB8vq1gG58SgQa3P_0ADhpg4G9rCAr5vGheR4jsjn2PdpTzU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPch5c6gsbKeZtTVkrIva_0nNezMQZH5S-DVO84hfORBw&oe=6AE358A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1238404628113706", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618274_1238404631447039_8589256968880698305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-yKlU1EqtgQ7kNvwEfmBPp&_nc_oc=Adpv4Dylu3FXScEdYlorPSrAbQL19NQ5NrG1iEHjfU1YidJwR0iXrd8zt15GsrsEgjU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbiZohiKJaJvngkz2FfdoVX9S-3WBqq1wurKGMbkwZSA&oe=6AE33ED1"}, "display_name": "FruitConnect", "keywords": ["desktop", "remote", "monitor", "mac", "productivity"], "long_description": "FruitConnect turns your Meta Quest into a wireless Mac display with audio. See your Mac desktop as a floating 2D panel in Quest Home and hear it through your headset \u2014 no need to take off your Quest.\n\nHOW IT WORKS\nInstall the Mac and Quest apps and pair once with a 6-digit code or QR scan. FruitConnect connects automatically:\n- Same Wi-Fi or USB-tethered \u2014 direct peer-to-peer, works fully offline\n- Anywhere with internet \u2014 encrypted Remote Access\nScreen and audio stream via WebRTC with hardware H.265 video and AAC audio for low latency.\n\nCONTROL YOUR MAC IN VR\nClick with Quest controllers like a mouse. Type with the Quest virtual keyboard or the floating QWERTY panel. Browse, code, watch videos, manage files \u2014 without removing your headset.\n\nKEY FEATURES\n- Wireless or USB-tethered streaming\n- Works offline \u2014 no internet needed for local Wi-Fi or USB streaming\n- Mac audio in your Quest headphones\n- Remote Access from anywhere with internet\n- Pop-out displays \u2014 extend with floating panels\n- Save multiple Macs and switch easily\n- Hardware H.265 video at 60fps\n- Zero-knowledge pairing (QR or 6-digit code)\n- End-to-end encrypted (DTLS-SRTP)\n- Floating QWERTY panel for fast typing\n\nPRIVACY\nAll streaming is peer-to-peer and end-to-end encrypted. The Remote Access rendezvous server sees only opaque ciphertext \u2014 never your screen, audio, keystrokes, or files.\n\nFREE vs PRO\n- Free: 15-minute sessions\n- Pro: unlimited sessions, $7.99/mo or $64.99/yr (save 32%) via Meta Store\n\nREQUIREMENT", "short_description": "Stream your Mac display + audio to Meta Quest as a floating 2D panel \u2014 at home over Wi-Fi or anywhere via Remote Access. Control with Quest controllers and the virtual keyboard. End-to-end encrypted H.265 video + AAC audio. Remote access requires an internet connection."}]}, "developer_name": null, "developer_privacy_policy_url": "https://davidkaiser.dk/fruitconnect/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DavidKaiser", "support_website_url": null, "website_url": "https://davidkaiser.dk/fruitconnect", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}, {"id": "1055187466124150"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics
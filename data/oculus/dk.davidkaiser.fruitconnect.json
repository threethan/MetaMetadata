ss=7f20f&oh=00_AQK2luMId_zgTgP_dw5kAqgRtW5VBstw4N2wAqgOIoJQpQ&oe=6AA6B3A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1238404628113706", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618274_1238404631447039_8589256968880698305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AC08Y5yiCuwQ7kNvwG2fqxB&_nc_oc=Adp1V-siW7we6Z2hM6UjFMPsS1_9QGkEUfh98KAoafshOTFcNWklbfN7b8NmR0_S1xk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpWCR8h_03KVyXj4KcrwVFqJ7I5CIHJtTWpfQEc4kP-w&oe=6AA699D1"}, "display_name": "FruitConnect: Mac Remote Desktop", "keywords": ["monitor", "screen", "virtual", "macbook", "mirroring"], "long_description": "FruitConnect turns your Meta Quest into a wireless Mac display with audio. See your Mac desktop as a floating 2D panel in Quest Home and hear it through your headset \u2014 no need to take off your Quest.\n\nREQUIREMENT\nYou need a Mac. Install the free companion app from davidkaiser.dk/fruitconnect \u2014 this streams from a Mac, it is not a standalone desktop.\n\nTWO MACS AT ONCE\nConnect your home Mac and your work Mac in parallel and keep both on screen \u2014 not just switching between them.\n\nWITH FRIENDS (CO-OP)\nInvite friends into your session with voice chat. Watch together, or hand control to a guest. Their voice can even feed Zoom or Teams on your Mac as a microphone (optional driver). You stay host \u2014 give or take control, mute, or remove anyone.\n\nHOW IT WORKS\nPair once with a 6-digit code or QR scan, then it connects automatically:\n- Same Wi-Fi or USB \u2014 direct peer-to-peer, works fully offline\n- Anywhere with internet \u2014 encrypted Remote Access\nClick with Quest controllers like a mouse, or type on the floating keyboard.\n\nKEY FEATURES\n- Pop-out displays \u2014 extend with floating panels\n- Mac audio in your Quest headphones\n- Hardware H.265 video at 60fps\n- Zero-knowledge pairing, end-to-end encrypted\n\nPRIVACY\nStreaming is peer-to-peer and end-to-end encrypted. The rendezvous server sees only opaque ciphertext \u2014 never your screen, audio, keystrokes, or files.\n\nFREE vs PRO\n- Free: 30 minutes per day\n- Pro: unlimited use, $7.99/mo or $64.99/yr (save 32%) via Meta Store", "short_description": "Wireless remote desktop for your Mac \u2014 stream your Mac's screen + audio to Quest as a floating panel. Works over Wi-Fi, USB or anywhere via Remote Access. Control your Mac with Quest controllers, trackpad-style input and the virtual keyboard. End-to-end encrypted H.265 + AAC."}]}, "developer_name": null, "developer_privacy_policy_url": "https://davidkaiser.dk/fruitconnect/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DavidKaiser", "support_website_url": null, "website_url": "https://davidkaiser.dk/fruitconnect", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}, {"id": "1055187466124150"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "28377248558547549"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618440_3115615325305740_2596943228625883648_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CYkFoywCAIQ7kNvwEd8iWf&_nc_oc=AdozD7-ZeZWpl5EMzfZDDSM0mHJmEpWsq6Z49wo_hHFi3FtAG8kHi0bfolxj
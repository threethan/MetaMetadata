uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304952_2026598144731607_6823801470209106974_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgwJPyq0PwYQ7kNvwEOwNb0&_nc_oc=AdrvW4GHjS5CZn13wQ-b-44wSUlnoN19SDUsFkMHkkBs8x4UcG5xcerDp-VLrsadHwU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMoOABbhW8gL84vqMERRgAkTvG8nBbzC3SogLLVecDQg&oe=6A83054C"}, {"file_name": "4.png", "id": "2613669335694878", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313110_2613669339028211_2836038882116236044_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99aXlSeeq0AQ7kNvwHWLATU&_nc_oc=Adpc3bSbA4OQnf80VW_jC0v7g3Vl38I7OayPciSqbhn3ysw6pCACMF4ML1MeK2cL3zY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFru275QNLfpNwTjjlf2xPEY22uA53kLG6FMy72CpPALg&oe=6A82EF21"}, {"file_name": "5.png", "id": "26708331965518085", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308050_26708331968851418_858257112352208017_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2FB83Pm8LsQ7kNvwGq6xl9&_nc_oc=AdrIevGdCCXHVGADvu0Yqrvf6IOLh9s7jXJm4-nED2tdWOVaaub8Ze57ndEVUPzm9Us&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkVa19ZbXdOt38GJ6shcIXo5H9Q3QeBl6sCclYPQaMWw&oe=6A830AFA"}, {"file_name": "2a.png", "id": "2226121364889550", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307470_2226121368222883_1551488538571217484_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hplxMSgi_0oQ7kNvwGD7Zw9&_nc_oc=AdrNqXoDvKe3adrD5rFmUdSnbzdHW_I9JqUMoNB3nzlajbW0inF8v3_8ZGNTgAPo9e8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmfS6rpl63XJxfAhzqcaN0Zcx5hphot2RmwuE0nBMHeg&oe=6A82E2E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1238404628113706", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618274_1238404631447039_8589256968880698305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNw0fUzjZCcQ7kNvwHetqUJ&_nc_oc=Adpyg6Q1euv5hE5s_0dqZ_kn9F2ok9T29E9gzEtr8iyeszNDxMk9hJFLiyEYFdbRXR8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAWJ1ax9VV9wLaV9_3F8Rb9MJnDoaub-ZKFNyssJF3Lg&oe=6A830151"}, "display_name": "FruitConnect: Mac Remote Desktop", "keywords": ["monitor", "screen", "virtual", "macbook", "mirroring"], "long_description": "FruitConnect turns your Meta Quest into a wireless Mac display with audio. See your Mac desktop as a floating 2D panel in Quest Home and hear it through your headset \u2014 no need to take off your Quest.\n\nHOW IT WORKS\nInstall the Mac and Quest apps and pair once with a 6-digit code or QR scan. FruitConnect connects automatically:\n- Same Wi-Fi or USB-tethered \u2014 direct peer-to-peer, works fully offline\n- Anywhere with internet \u2014 encrypted Remote Access\nScreen and audio stream via WebRTC with hardware H.265 video and AAC audio for low latency.\n\nCONTROL YOUR MAC IN VR\nClick with Quest controllers like a mouse. Type with the Quest virtual keyboard or the floating QWERTY panel. Browse, code, watch videos, manage files \u2014 without removing your headset.\n\nKEY FEATURES\n- Wireless or USB-tethered streaming\n- Works offline \u2014 no internet needed for local Wi-Fi or USB streaming\n- Mac audio in your Quest headphones\n- Remote Access from anywhere with internet\n- Pop-out displays \u2014 extend with floating panels\n- Save multiple Macs and switch easily\n- Hardware H.265 video at 60fps\n- Zero-knowledge pairing (QR or 6-digit code)\n- End-to-end encrypted (DTLS-SRTP)\n- Floating QWERTY panel for fast typing\n\nPRIVACY\nAll streaming is peer-to-peer and end-to-end encrypted. The Remote Access rendezvous server sees only opaque ciphertext \u2014 never your screen, audio, keystrokes, or files.\n\nFREE vs PRO\n- Free: 15-minute sessions\n- Pro: unlimited sessions, $7.99/mo or $64.99/yr (save 32%) via Meta Store\n\nREQUIREMENT", "short_description": "Wireless remote desktop for your Mac \u2014 stream your Mac's screen + audio to Quest as a floating panel. Works over Wi-Fi, USB or anywhere via Remote Access. Control your Mac with Quest controllers, trackpad-style input and the virtual keyboard. End-to-end encrypted H.265 + AAC."}]}, "developer_name": null, "developer_privacy_policy_url": "https://davidkaiser.dk/fruitconnect/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DavidKaiser", "support_website_url": null, "website_url": "https://davidkaiser.dk/fruitconnect", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}, {"id": "1055187466124150"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "28107319255540482"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618440_3115615325305740_2596943228625883648_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKCF84C_GiEQ7kNvwFHw0e5&_nc_oc=AdpYh0lA9pvWHEhh4BKk--rjw2u80sfDYNah_b429dD46YXjST1CDBUYQN0VXp1lG-w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQT6E5elaWQyGG5XeLOLNDaP2Df0fBtA_PLFibM9AI6Q&oe=6A82FEBE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "FruitConnect: Mac Remote Desktop", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": 
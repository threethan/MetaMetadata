ucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNo4kYs2ctsQ7kNvwHoXb0J&_nc_oc=AdqDo6Fz2kxRmfntA4cBc9HiWO-G1ztensucEAJGtXmeKgOBAqDe1eWZnLSzSTqyiso&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2y_i50rGkLNAr9clXLttLYJaBY4voga5Ac2HnPN2ukA&oe=6AFC881F"}, {"file_name": "1a.png", "id": "2026598141398274", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304952_2026598144731607_6823801470209106974_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQeihY7QBN8Q7kNvwEsX5sM&_nc_oc=AdpnxAtfdNJ_NjGPEhbK_pS4U91Hkplxs-eFOFGPG6L1qywhO14kxGjXJ22bZmz1HZs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKnJV96kCCpw7DKYRy3GNWe2Wo65HtjYbuRo1zGt53ag&oe=6AFC878C"}, {"file_name": "4.png", "id": "2613669335694878", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499313110_2613669339028211_2836038882116236044_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExRi9w3rE0wQ7kNvwH2nIxU&_nc_oc=Adq8cfHWX3AQ6h-AVgl0OGZNfes991GaAXJPUU52OoppDCZ3YAl7wtTyVAqimjviTUM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1j2aDNjdAC1EYiMJN-FLGGIGUcZi5Yf1ISXrAtHbgrg&oe=6AFC7161"}, {"file_name": "5.png", "id": "26708331965518085", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308050_26708331968851418_858257112352208017_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MgQkWXmi2vUQ7kNvwFg9E-6&_nc_oc=Ado12r-kR6kH7WXw3Mv_xbyo1OPEOOjPdt5ZWE06-oJ8RJ9tepEN0Ct-g8UuNzb9Pnk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2LjYLrdiLoGZXluTpwc_SU7kEJAr-j4PzFOcNWKASgA&oe=6AFC8D3A"}, {"file_name": "2a.png", "id": "2226121364889550", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307470_2226121368222883_1551488538571217484_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0a112-suYsQ7kNvwHPuSOX&_nc_oc=Adqc2XxoWoGfTuJ0T5R0LkxhYhuGPkMYgXml3SBTkUKkeHJyU_lfmLvLBmQrGx1wlMM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-7R7YPkVJMx5TVqjRVFBVCkeg1qon4qJzgFJ40z5PCw&oe=6AFC6527"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1238404628113706", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618274_1238404631447039_8589256968880698305_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjPdDLbCmpsQ7kNvwGXTA1j&_nc_oc=AdrF5YtOqyQyks0i0V-K6qfYQnW83Dw8dnxGw9xFrc5zwxLqoGNp50zyNiTG8VF5FY0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNRADk3UZV42keVU2w7h7-LpnaRlNgRHVNjYVzC2qLeg&oe=6AFC8391"}, "display_name": "FruitConnect", "keywords": ["desktop", "remote", "monitor", "mac", "productivity"], "long_description": "FruitConnect turns your Meta Quest into a wireless Mac display with audio. See your Mac desktop as a floating 2D panel in Quest Home and hear it through your headset \u2014 no need to take off your Quest.\n\nHOW IT WORKS\nInstall the Mac and Quest apps and pair once with a 6-digit code or QR scan. FruitConnect connects automatically:\n- Same Wi-Fi or USB-tethered \u2014 direct peer-to-peer, works fully offline\n- Anywhere with internet \u2014 encrypted Remote Access\nScreen and audio stream via WebRTC with hardware H.265 video and AAC audio for low latency.\n\nCONTROL YOUR MAC IN VR\nClick with Quest controllers like a mouse. Type with the Quest virtual keyboard or the floating QWERTY panel. Browse, code, watch videos, manage files \u2014 without removing your headset.\n\nKEY FEATURES\n- Wireless or USB-tethered streaming\n- Works offline \u2014 no internet needed for local Wi-Fi or USB streaming\n- Mac audio in your Quest headphones\n- Remote Access from anywhere with internet\n- Pop-out displays \u2014 extend with floating panels\n- Save multiple Macs and switch easily\n- Hardware H.265 video at 60fps\n- Zero-knowledge pairing (QR or 6-digit code)\n- End-to-end encrypted (DTLS-SRTP)\n- Floating QWERTY panel for fast typing\n\nPRIVACY\nAll streaming is peer-to-peer and end-to-end encrypted. The Remote Access rendezvous server sees only opaque ciphertext \u2014 never your screen, audio, keystrokes, or files.\n\nFREE vs PRO\n- Free: 15-minute sessions\n- Pro: unlimited sessions, $7.99/mo or $64.99/yr (save 32%) via Meta Store\n\nREQUIREMENT", "short_description": "Stream your Mac display + audio to Meta Quest as a floating 2D panel \u2014 at home over Wi-Fi or anywhere via Remote Access. Control with Quest controllers and the virtual keyboard. End-to-end encrypted H.265 video + AAC audio. Remote access requires an internet connection."}]}, "developer_name": null, "developer_privacy_policy_url": "https://davidkaiser.dk/fruitconnect/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DavidKaiser", "support_website_url": null, "website_url": "https://davidkaiser.dk/fruitconnect", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}, {"id": "1055187466124150"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "27783531967919214"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "962061046314091"}]}, "baseline_offer": {"id": "962061046314091"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782462120, "status": "PUBLISHED", "id": "962061046314091"}]}, "liveChanne
71-25/499313110_2613669339028211_2836038882116236044_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znNR2bCRNNQQ7kNvwEsr7ru&_nc_oc=Adq2c_HrRmOb-OML3N8_4iuoRR7CE-x9gMG5J5koQgUWlkKkRPP2YeiRLJ-1rdhlOL0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjeCUGXO_BYiSyqU1MGK4bYGPClyZ0VgvJNx6rg2YIEg&oe=6AA6BFE1"}, {"file_name": "5.png", "id": "26708331965518085", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308050_26708331968851418_858257112352208017_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFmUS1Y9-dgQ7kNvwF-lhOa&_nc_oc=Adqbo9T0YxWm8uOMBQjGd2-XZz-uSlCohBb6O3Sp3itN6JWnLR7r-zEZhSbtxEfK1kQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_pwtj0qFuCf08fEBgLXzT8qx4zVltpDIXdRKeibb8tw&oe=6AA6A37A"}, {"file_name": "2a.png", "id": "2226121364889550", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307470_2226121368222883_1551488538571217484_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ROmif6EDrcQ7kNvwFQNsCE&_nc_oc=AdotvQxCdiZk192VOW0ht4yKq_E6czx0CpWsBO6i7FcBS3FoWAJ8u4Lf22OHvHsAJMk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2luMId_zgTgP_dw5kAqgRtW5VBstw4N2wAqgOIoJQpQ&oe=6AA6B3A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1238404628113706", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618274_1238404631447039_8589256968880698305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AC08Y5yiCuwQ7kNvwG2fqxB&_nc_oc=Adp1V-siW7we6Z2hM6UjFMPsS1_9QGkEUfh98KAoafshOTFcNWklbfN7b8NmR0_S1xk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpWCR8h_03KVyXj4KcrwVFqJ7I5CIHJtTWpfQEc4kP-w&oe=6AA699D1"}, "display_name": "FruitConnect", "keywords": ["desktop", "remote", "monitor", "mac", "productivity"], "long_description": "FruitConnect turns your Meta Quest into a wireless Mac display with audio. See your Mac desktop as a floating 2D panel in Quest Home and hear it through your headset \u2014 no need to take off your Quest.\n\nHOW IT WORKS\nInstall the Mac and Quest apps and pair once with a 6-digit code or QR scan. FruitConnect connects automatically:\n- Same Wi-Fi or USB-tethered \u2014 direct peer-to-peer, works fully offline\n- Anywhere with internet \u2014 encrypted Remote Access\nScreen and audio stream via WebRTC with hardware H.265 video and AAC audio for low latency.\n\nCONTROL YOUR MAC IN VR\nClick with Quest controllers like a mouse. Type with the Quest virtual keyboard or the floating QWERTY panel. Browse, code, watch videos, manage files \u2014 without removing your headset.\n\nKEY FEATURES\n- Wireless or USB-tethered streaming\n- Works offline \u2014 no internet needed for local Wi-Fi or USB streaming\n- Mac audio in your Quest headphones\n- Remote Access from anywhere with internet\n- Pop-out displays \u2014 extend with floating panels\n- Save multiple Macs and switch easily\n- Hardware H.265 video at 60fps\n- Zero-knowledge pairing (QR or 6-digit code)\n- End-to-end encrypted (DTLS-SRTP)\n- Floating QWERTY panel for fast typing\n\nPRIVACY\nAll streaming is peer-to-peer and end-to-end encrypted. The Remote Access rendezvous server sees only opaque ciphertext \u2014 never your screen, audio, keystrokes, or files.\n\nFREE vs PRO\n- Free: 15-minute sessions\n- Pro: unlimited sessions, $7.99/mo or $64.99/yr (save 32%) via Meta Store\n\nREQUIREMENT", "short_description": "Stream your Mac display + audio to Meta Quest as a floating 2D panel \u2014 at home over Wi-Fi or anywhere via Remote Access. Control with Quest controllers and the virtual keyboard. End-to-end encrypted H.265 video + AAC audio. Remote access requires an internet connection."}]}, "developer_name": null, "developer_privacy_policy_url": "https://davidkaiser.dk/fruitconnect/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DavidKaiser", "support_website_url": null, "website_url": "https://davidkaiser.dk/fruitconnect", "category": null, "comfort_rating": "COMFORTA
ess&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlIXLobadi8Q7kNvwE5bGaF&_nc_oc=AdpyJevRJ0i5sc_ezdxl7QTVWTvxEp4k2MOk7ogGfYYN37hbjyIaG7Vm_T44iulcRN4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6t1hnv16BYmw1XaD1GChEa6c7_irHieX6-skRWfCR5Q&oe=6AFC80A9"}, {"file_name": "6ab5d265392e4811bd6ccd0fdaaccb16.png", "id": "1421576459394879", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312310_1421576462728212_6865862003272022064_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEQqaRBh1OQQ7kNvwGnails&_nc_oc=AdqfYHsBNtO5DNIubAum3EP_F5d45I-SDU1-RAnYT_uPgZZ2ZABltP5PbEkrZGPZNkk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1Iytq4Y4z5tQSvxx0zYXJda3BPCKylvnP8Nxbivckzg&oe=6AFC955B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1423346865899744", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673819499_1423346869233077_3346121826630069203_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOA1cVHK2dkQ7kNvwGiWurR&_nc_oc=Adr7cH7LYO_ofXOgMCh-YN3w6axC7O9F9AJKrnait5SN9kx-cESV2uv_c5fgosHtvAU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8Kx_RgK0sFb2wB7mGgX-td-_D6VevTy7Kt_wVC_EjGg&oe=6AFC8282"}, "display_name": "FruitConnect: Mac Remote Desktop", "keywords": ["monitor", "screen", "virtual", "macbook", "mirroring"], "long_description": "FruitConnect turns your Mac into a wireless display for Meta Quest.\n\nTWO WAYS TO WORK\n\u2022 Panel: your Mac's screen floats in Quest Home next to your other apps.\n\u2022 Full VR: step into a virtual room \u2014 a boat at sea, a cinema, an island or a terrace \u2014 with your Mac's screen in front of you. Walk with the left thumbstick, turn with the right. You can try it without a Mac from the first screen.\n\nHOW IT WORKS\nInstall the free FruitConnect app on your Mac, scan the QR code with your Quest, and you're connected \u2014 over Wi-Fi, a USB-C cable, or from anywhere with Remote Access. The stream is peer-to-peer and end-to-end encrypted (H.265 video and AAC audio at up to 60 fps).\n\nCONTROL YOUR MAC\nUse your controllers as a mouse, switch to trackpad mode, type with the Quest keyboard including Mac shortcuts, and scroll. Pop single Mac windows out as their own panels.\n\nOPTIONAL VOICE ASSISTANT (COMING SOON)\nTalk to your Mac from the headset with a FruitConnect AI subscription. It asks before it looks at your screen or acts on your Mac, and it is only shown once you have a plan.\n\nFREE AND PRO\nFree: 30 minutes of streaming per day. Pro: unlimited.\n\nREQUIREMENTS\nA Mac with Apple silicon and macOS 14 or later, on the same network or with Remote Access.", "short_description": "Wireless remote desktop for your Mac \u2014 use your Mac as a floating panel in Quest Home, or step into Full VR and work in a quiet virtual room. Works over Wi-Fi, USB or anywhere via Remote Access. Control your Mac with Quest controllers, trackpad-style input and the virtual keyboard. End-to-end encrypted H.265 + AAC. Requires a Mac with Apple silicon and macOS 14 or later."}]}, "developer_name": null, "developer_privacy_policy_url": "https://davidkaiser.dk/fruitconnect/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DavidKaiser", "support_website_url": null, "website_url": "https://davidkaiser.dk/fruitconnect", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}, {"id": "1055187466124150"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_
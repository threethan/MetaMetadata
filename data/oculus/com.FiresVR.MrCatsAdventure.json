inate monsters and then solve the puzzle. Enjoy your heartbeat and achievement, my friend! The incredible pictures combined with VR device will provide you a extraordinary visual experience. This game world is filled with strange creatures, varied adventures and surprise. Are you ready? Finally, we have developed this game in our spare time, hoping to make you feel interesting.", "short_description": "This game world is filled with strange creatures, varied adventures and surprise. Are you ready?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.firesvr.com/privacy.html", "developer_terms_of_service_url": "http://www.firesvr.com/provision.html", "publisher_name": "FiresVR", "support_website_url": null, "website_url": "http://www.firesvr.com/adventure.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "ADVENTURE", "CASUAL", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1517151162002166"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139323_1053942378024310_247715176_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqhMBImPO54Q7kNvwHfhfXU&_nc_oc=Ado2_-62EX5vHmKHdYF6WriE7B3_oqtGNLSEYlCBjIHOZVvxblXS_IPjh-h5zJlb1f8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3j3N3qNeYL3dzpp2MKuymMFYKVt76zWF-h5NFI6pceA&oe=6AF8AB03"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mr Cat\u2019s Adventure", "pla
: "JULAYMBA_2560.png", "id": "558040069837826", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974577_558040073171159_1614532357176034182_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haW3zMjl108Q7kNvwE6KJ0u&_nc_oc=AdpbA1SbiZn6kom_IBx6-NUD9aaaZYiCKdXcX3R0Af4Y1Wu4oOGroJ67sY35Abq6maA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NKR2BNBoTBNyRn2XMnYb8li6BXfZ9bv_meIk1agdQDw&oe=6A412377"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JULAYMBA_2560.png", "id": "300865062869950", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982510_300865066203283_5437610587998085564_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTH7XVt-oY0Q7kNvwGdR3rz&_nc_oc=Adr4dmMEcd8X2oX60geuFKmnoKw4xvl9jpK-0O1b6frckoiqX5UpGx9BjzAaoSkR4oc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ilSgvjwWZtO2E6IDRQXhUdxrlE0rqiwnobSe3dYR8VQ&oe=6A413676"}, "display_name": "Julaymba", "keywords": [], "long_description": "Julaymba, meaning 'Daintree,' in Kuku Yalanji language is a mixed reality experience that takes viewers on a journey through the oldest rainforest on earth, the Daintree in Tropical North Queensland. Julaymba transcends traditional storytelling. This immersive experience is a follow-up to our critically acclaimed and award-winning ecosphere production and allows audiences to embark on a transformative Mixed Reality journey through the rainforest. Julaymba takes viewers into a world of cultural renewal, education, and Earth stewardship. It introduces pioneering storytelling methods and immersive media formats.\nJulaymba was created in close partnership with the Eastern Kuku Yalanji Traditional Owners and the Jabalbina Aboriginal Corporation. Our commitment is to authentically represent their stories.", "short_description": "Julaymba, meaning 'Daintree,' in Kuku Yalanji language is a mixed reality experience that takes viewers on a journey through the oldest rainforest on earth, the Daintree in Tropical North Queensland. Julaymba was created in partnership with the EKY people, and the Jabalbina Aboriginal Corporation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.phoria.com.au/documents/privacy-policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "PHORIA", "support_website_url": null, "website_url": "https://www.phoria.com.au/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6638097092910858"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1892978431288107"}, {"status": "PUBLISHED", "id": "969470748661994"}, {"status": "PUBLISHED", "id": "1606089816944773"}, {"status": "PUBLISHED", "id": "1883078098835869"}, {"status": "PUBLISHED", "id": "1475351003865119"}]}, "baseline_offer": {"id": "1892978431288107"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1762491000, "status": "PUBLISHED", "id": "1892978431288107"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7832340400153182", "version": "1.2.8"}, "id": "591918496339984", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6638097
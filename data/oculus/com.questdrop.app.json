: null, "video_trailer_thumbnail": null, "display_name": "QuestDrop", "keywords": [], "long_description": "QuestDrop moves your personal videos and files between your phone, your PC and your Meta Quest, without cloud uploads or accounts.\n\nHOW IT WORKS\n- Install the free QuestDrop companion app on your Android phone (or the PC tool), open QuestDrop on your Quest, and pair once.\n- Pick videos on the phone and press Send. They land in your Quest's Movies folder, with live progress and time left.\n- Start watching before the copy finishes.\n\nON YOUR QUEST\n- See every video already on the headset, with free space.\n- Play, copy back to the phone or PC, or delete to free space.\n- Works with your favourite video player.\n\nPRIVATE BY DESIGN\nFiles travel directly between your own devices on your local network or USB cable. Nothing is uploaded to any server and no account is needed.\n\nNote: QuestDrop transfers files you already own. It does not provide or download any movies or other content.", "short_description": "Send your own videos from your phone or PC to your Quest in a tap, over Wi-Fi or cable. See what's on your Quest, play it, copy it back, or free up space, all from one simple panel."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ky37194-gif.github.io/questdrop/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Kuldeep Jatav", "support_website_url": "https://ky37194-gif.github.io/questdrop/", "website_url": "https://ky37194-gif.github.io/questdrop/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": n
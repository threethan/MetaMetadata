.com&_nc_ss=8&oh=00_Afzm46xuu14wZlO1UEK8MNyb0ZFRmyeZMKyBYXdQ4qc2_w&oe=69B965E5"}, {"file_name": "screenshot4.png", "id": "362898849498689", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974535_362898852832022_8522236402830681562_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKDzz74CkZEQ7kNvwE8kpqN&_nc_oc=Adk_GLBB5qHsGN9FDZpfD-x--pjU5itY3tx5jePYrlZbH_uS2d9Ug6V4DsogDK32OTM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwv1cZUWXmXQvIlGFLK29pUPrFIZq5lu0qhg5Jpoj8UlQ&oe=69B92F24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "heroart (1).png", "id": "255464397022691", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568668_255464400356024_7599096233503142883_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idHHGfSE1OIQ7kNvwEmErEC&_nc_oc=Adl-pd7yB4qKv1GfB83USVEnbDsld_4e2uXypWIF77tjuH9R4Jdb2wH0HcgvouuCST8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzOAkigYJg_5-S9mlQfZD-5sefimrL_zZ3NYqBKaxIV4A&oe=69B96591"}, "display_name": "Baboon", "keywords": [], "long_description": "Intuitive Movement Mechanics:\n\nAt the core of \"Baboon\" are the intuitive movement mechanics, taking inspiration from \"Gorilla Tag\" and enhancing them to create a diverse and dynamic gameplay experience.\n\nSprinting: Channel your inner baboon as you sprint through the jungle at breakneck speeds, leaving your opponents in the dust. The sensation of speed is exhilarating, and you'll feel like a true jungle sprinter.\n\nLeaping and Climbing: Baboons are known for their agility, and in \"Baboon,\" you can leap incredible distances and climb up trees and cliffs with ease. The game's physics system ensures that every jump and climb feels responsive and realistic.", "short_description": "Welcome to \"Baboon,\" an exhilarating game where you become a nimble baboon, inspired by the electrifying movements of gorillas. In this high-octane multiplayer adventure, you'll swing through trees, leap between platforms, and race your friends in a lush, immersive jungle environment. \"Baboon\" brings the thrill of \"Gorilla Tag\" to new heights, with intuitive, heart-pounding movement mechanics that put you in the heart of the action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/baboonery/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "pepega", "support_website_url": null, "website_url": "https://sites.google.com/view/baboonery/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6920537374634219"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7698662260155056", "version": "0.37"}, "id": "3258943624410228", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6881528258535131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7698662260155056"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3258943624410228"}]}, "change_log": null, "created_date": 1714677813, "id": "7
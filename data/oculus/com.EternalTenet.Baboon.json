Y4DemGywPi0Bq3lHahZ5h8Mftco&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvrLYeAsBrWd5v30KiRkj0tD_YNOP4M1xTUiJnZbuV8nQ&oe=69A19C87"}, {"file_name": "screenshot3.png", "id": "832874298306778", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39036649_832874301640111_6431438389637417765_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlRtoPPm6VgQ7kNvwE1KIlS&_nc_oc=AdkN9IBnXZITYGY1C9hccegzX_zEVYkmsgOOJH7P-ueNoPyNvNDg9ve8XVMUyqD6qfQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aft_T7vfS1f-do6vEzbCzYgQ6iUS3xB3Psxh4pKreXGrvQ&oe=69A1AAE5"}, {"file_name": "screenshot4.png", "id": "362898849498689", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974535_362898852832022_8522236402830681562_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uPAiWzO7toQ7kNvwHYopmF&_nc_oc=AdmuGM8I_Q3y3R7liT9E8iUBfDbtielw9MZ4khFVsDyRBJ1is0kx0ImCZ39i4CJxV54&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsjY2Uyf5Im7ZwTqqTzu_Bh6q-QfZH9hvhKDjAN2H74fg&oe=69A1AC64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "heroart (1).png", "id": "255464397022691", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/57568668_255464400356024_7599096233503142883_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWhPQRz73fcQ7kNvwHt81FO&_nc_oc=AdkHf66CzOuv0WE1BILDs-B6VxUEETmiPi75xT7hH1wMGTLYth8r-IPkwWm3K-53k_c&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuQYciLqW6rWnV0RnUksxaXsziO0BJjwYONehgjHetWdg&oe=69A1AA91"}, "display_name": "Baboon", "keywords": [], "long_description": "Discord: https://discord.gg/bm2cv74hrW \n\n\nIntuitive Movement Mechanics:\nAt the core of \"Baboon\" are the intuitive movement mechanics, taking inspiration from \"Gorilla Tag\" and enhancing them to create a diverse and dynamic gameplay experience.\n\nSprinting: Channel your inner baboon as you sprint through the jungle at breakneck speeds, leaving your opponents in the dust. The sensation of speed is exhilarating, and you'll feel like a true jungle sprinter.\n\nLeaping and Climbing: Baboons are known for their agility, and in \"Baboon,\" you can leap incredible distances and climb up trees and cliffs with ease. The game's physics system ensures that every jump and climb feels responsive and realistic", "short_description": "Welcome to \"Baboon,\" an exhilarating game where you become a nimble baboon, inspired by the electrifying movements of gorillas. In this high-octane multiplayer adventure, you'll swing through trees, leap between platforms, and race your friends in a lush, immersive jungle environment. \"Baboon\" brings the thrill of \"Gorilla Tag\" to new heights, with intuitive, heart-pounding movement mechanics that put you in the heart of the action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/baboonery/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "pepega", "support_website_url": null, "website_url": "https://sites.google.com/view/baboonery/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7094365053918116"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39001703_296110469936318_6886108619206940017_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIJyST1_BucQ7kNvwH99UK4&_nc_oc=AdkfV_WPb94BXNXmefDAWEWKB7nU6KDTgbos2GRbD4bC1r9Bj1Ut75jS26cGrIhm6Yo&_nc_zt=3&
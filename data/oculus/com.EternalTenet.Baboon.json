dn.com/v/t64.5771-25/75222943_1214442206610689_8110931047485643820_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4uBJWMtuHgQ7kNvwFhI1PC&_nc_oc=AdrRMbkUGZd07oELpAK31ynt9qlT86ylvSLHTN7bAPDjNsYly0z9aP4F3khvGjbqjU0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-aWSCPwUhdvVyGevSbzfTtRTdRrHvGvEz7WRwT_ROZw&oe=6AFDE0C7"}, {"file_name": "screenshot3.png", "id": "832874298306778", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036649_832874301640111_6431438389637417765_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvDje9tSjk4Q7kNvwESxsY8&_nc_oc=Adr0mR0n7PFoXNwWaHvaSq8HOchVLV8L-9w0FbnVy0HoKMjl7Y5IlZmaFqo3OFoCu3o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHUqUfzYhsOjCAFPAqTiN8ufGuCGJ2jJkHyQQFPpTsUw&oe=6AFDB6E5"}, {"file_name": "screenshot4.png", "id": "362898849498689", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974535_362898852832022_8522236402830681562_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3AuzprLQvIQ7kNvwFyYawQ&_nc_oc=AdqrXZ5s-IHrHXrNRqOhWIf84OMpfMfaoAl3mOLZNwqMHRCJajYiBF3Zw6JH2tQxGm4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQORnUxht-3q9wlHDKgDYKjlLT6Mf3GG-tk9kQKsP8RPw&oe=6AFDB864"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "heroart (1).png", "id": "255464397022691", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568668_255464400356024_7599096233503142883_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9nFCgzDzJYQ7kNvwFTiK3N&_nc_oc=AdrpSCt4NjzsRQe23FSgGuJV02FpbHMLYZewvwgzfjmMMbzDIWq7C0jlH67dcC5pXa4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnstCBdFcNCl4NeDCN3T69Y0AXUTl58-SYJsyNKaEqRQ&oe=6AFDB691"}, "display_name": "Baboon", "keywords": [], "long_description": "Intuitive Movement Mechanics:\n\nAt the core of \"Baboon\" are the intuitive movement mechanics, taking inspiration from \"Gorilla Tag\" and enhancing them to create a diverse and dynamic gameplay experience.\n\nSprinting: Channel your inner baboon as you sprint through the jungle at breakneck speeds, leaving your opponents in the dust. The sensation of speed is exhilarating, and you'll feel like a true jungle sprinter.\n\nLeaping and Climbing: Baboons are known for their agility, and in \"Baboon,\" you can leap incredible distances and climb up trees and cliffs with ease. The game's physics system ensures that every jump and climb feels responsive and realistic.", "short_description": "Welcome to \"Baboon,\" an exhilarating game where you become a nimble baboon, inspired by the electrifying movements of gorillas. In this high-octane multiplayer adventure, you'll swing through trees, leap between platforms, and race your friends in a lush, immersive jungle environment. \"Baboon\" brings the thrill of \"Gorilla Tag\" to new heights, with intuitive, heart-pounding movement mechanics that put you in the heart of the action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/baboonery/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "pepega", "support_website_url": null, "website_url": "https://sites.google.com/view/baboonery/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6920537374634219"}}]}, "scheduled_offers": {"count"
ng?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6IdsAE9xbQQ7kNvwEu8QKo&_nc_oc=AdoTqqtJ6WsMeivvzLmCGnv6-C420QNMLvIQYgsrnaWHEaSdnXsQd51jca3bGc7XiHM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtLMhFgyjS4JiZg0_TO5fcQ-lT6NC_zat9FmebFsocPA&oe=6A806A07"}, {"file_name": "screenshot3.png", "id": "832874298306778", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036649_832874301640111_6431438389637417765_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66KIi8wN05AQ7kNvwFHD-lg&_nc_oc=AdpZqsHnrD3cQKbIJjkMxADc2Lap4BpBSy5HTu5_txGVSllrfKWgmKT5kBgV-MmxntY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwePNeIXFVpXLWoGd0zQqplfalde-Hf7ie-0Ls4Ti3vA&oe=6A804025"}, {"file_name": "screenshot4.png", "id": "362898849498689", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974535_362898852832022_8522236402830681562_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RbqyZJaglOEQ7kNvwF7EN9m&_nc_oc=AdqfGO5YmazTA_ArDddJAqIw6N-miSkLacJZqGs8t1F1iysc7w62nGtstB3S7RXl3vI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3QNWO6iWaOaariyvAeJC5iXYeG9CDEpfxJ85828oDAQ&oe=6A8041A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "heroart (1).png", "id": "255464397022691", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57568668_255464400356024_7599096233503142883_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQYaebuP6QUQ7kNvwENymAy&_nc_oc=AdpYW18nmlRFuePkEA_mI-XST6GqTAudHApdeT_VND-3AKDQUxNHgT7wWnqTfx08WWk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjP4YbY93304_N-TYSWvdC_WrVudlBEZthTxc147uqNw&oe=6A803FD1"}, "display_name": "Baboon", "keywords": [], "long_description": "Discord: https://discord.gg/bm2cv74hrW \n\n\nIntuitive Movement Mechanics:\nAt the core of \"Baboon\" are the intuitive movement mechanics, taking inspiration from \"Gorilla Tag\" and enhancing them to create a diverse and dynamic gameplay experience.\n\nSprinting: Channel your inner baboon as you sprint through the jungle at breakneck speeds, leaving your opponents in the dust. The sensation of speed is exhilarating, and you'll feel like a true jungle sprinter.\n\nLeaping and Climbing: Baboons are known for their agility, and in \"Baboon,\" you can leap incredible distances and climb up trees and cliffs with ease. The game's physics system ensures that every jump and climb feels responsive and realistic", "short_description": "Welcome to \"Baboon,\" an exhilarating game where you become a nimble baboon, inspired by the electrifying movements of gorillas. In this high-octane multiplayer adventure, you'll swing through trees, leap between platforms, and race your friends in a lush, immersive jungle environment. \"Baboon\" brings the thrill of \"Gorilla Tag\" to new heights, with intuitive, heart-pounding movement mechanics that put you in the heart of the action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/baboonery/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "pepega", "support_website_url": null, "website_url": "https://sites.google.com/view/baboonery/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7094365053918116"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001703_296110469936318_6886108619206940017_n.png?stp
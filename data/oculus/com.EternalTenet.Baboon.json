RFnuUbcBAD_XFpQvfAQ4qkf_YBQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu46BvVXF--lO37RKyJHMp0AEPD0Fojt1SsFCw8hm-ZhQ&oe=69A59107"}, {"file_name": "screenshot3.png", "id": "832874298306778", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036649_832874301640111_6431438389637417765_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZqId3q7RUgQ7kNvwEPKBpD&_nc_oc=AdlWRYJETI-C1m-FC_RN_wnB63iPnv-aM9htl6Z9Pqv1UkIHaIKYlZu6i9m7uOkcY_M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuI3T7IDJb41G6xrIhJqaFBsMSkTSXVIE4R8zk53F78YQ&oe=69A59F65"}, {"file_name": "screenshot4.png", "id": "362898849498689", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974535_362898852832022_8522236402830681562_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpc-QtYXyjMQ7kNvwEKVetQ&_nc_oc=AdlKtdmzditPTXMFnItsPCbaQPJcilH1JOuuy7ZGwcMQb65FHw7HtWGlvGK82eKSDDk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvK32I6_t6ygQJPo0yWmThJUxIJxk7m4PjVWN6w7mHQBA&oe=69A5A0E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "heroart (1).png", "id": "255464397022691", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57568668_255464400356024_7599096233503142883_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GR2U4SwieM4Q7kNvwG2wEZ3&_nc_oc=AdlB8wboP_PEA6STGy2PcEBOMJEcBJ9BV9t6NiYUYzloH3qHHq-ecvG5bVDv7qMm9Rs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftOLLdVovzO1QtRBgbJHWXwgKnmbxr5GK1Qy0cU_z1fsg&oe=69A59F11"}, "display_name": "Baboon", "keywords": [], "long_description": "Discord: https://discord.gg/bm2cv74hrW \n\n\nIntuitive Movement Mechanics:\nAt the core of \"Baboon\" are the intuitive movement mechanics, taking inspiration from \"Gorilla Tag\" and enhancing them to create a diverse and dynamic gameplay experience.\n\nSprinting: Channel your inner baboon as you sprint through the jungle at breakneck speeds, leaving your opponents in the dust. The sensation of speed is exhilarating, and you'll feel like a true jungle sprinter.\n\nLeaping and Climbing: Baboons are known for their agility, and in \"Baboon,\" you can leap incredible distances and climb up trees and cliffs with ease. The game's physics system ensures that every jump and climb feels responsive and realistic", "short_description": "Welcome to \"Baboon,\" an exhilarating game where you become a nimble baboon, inspired by the electrifying movements of gorillas. In this high-octane multiplayer adventure, you'll swing through trees, leap between platforms, and race your friends in a lush, immersive jungle environment. \"Baboon\" brings the thrill of \"Gorilla Tag\" to new heights, with intuitive, heart-pounding movement mechanics that put you in the heart of the action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/baboonery/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "pepega", "support_website_url": null, "website_url": "https://sites.google.com/view/baboonery/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7094365053918116"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001703_296110469936318_6886108619206940017_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ae7e4SOUvZ0Q7kNvwFodg9E&_nc_oc=AdnXFZ6SY45gUxjT7BJQtbTzTVcIfY2F_cGeuV7UCd7UT_pbJj9P4Aat7judSXLH5rY&_nc_zt=3&
ng?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIL4e8HJ9TUQ7kNvwFdZInU&_nc_oc=Adou5dQ1rUu4JRJp7bsqoXtnKiEy9usPOAMAMADPGal9Z4uP94LHZLfYvsqrc8Sl8TM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7frv1sPLEi-84Tt4DHLIo1b7UUCCQY08H7KtUr-1ptrQ&oe=6A1C3807"}, {"file_name": "screenshot3.png", "id": "832874298306778", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036649_832874301640111_6431438389637417765_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ziJW8y4sY4Q7kNvwETXNNs&_nc_oc=AdplNolF06U2GEv63S2XJCl3gagdiglVgm5F_UAWidvbSY0slplETs1PIS_1ev0R1iY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iaWz-7AvOHlwqzmA6rj4U6XMHUGh1yMhgk6OErNPejg&oe=6A1C4665"}, {"file_name": "screenshot4.png", "id": "362898849498689", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974535_362898852832022_8522236402830681562_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOkyPMJpCH8Q7kNvwFm93q6&_nc_oc=AdoSTuV3NxwSkeGZCFR5ShqNfrAOgnaPWk_-jtLmMjrJ95qVFX144gWVmZ9gzi8Pb54&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6R8m7eUkm0Ke7H7ZWTSUT10YX6ifAkJk5jaLznxZuXFg&oe=6A1C47E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "heroart (1).png", "id": "255464397022691", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/57568668_255464400356024_7599096233503142883_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrZcs9HZOtcQ7kNvwGDqkKJ&_nc_oc=AdrufZuhGsL1MaChC8kEKnkucSVknbOXMJAIPsG0RobAKNbM7CKykHuzYSrbVt_q3rE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OdRD6p1v0aZj1Q3Gjy6CL49frU9tkLJcKybYYfd9_Jw&oe=6A1C4611"}, "display_name": "Baboon", "keywords": [], "long_description": "Discord: https://discord.gg/bm2cv74hrW \n\n\nIntuitive Movement Mechanics:\nAt the core of \"Baboon\" are the intuitive movement mechanics, taking inspiration from \"Gorilla Tag\" and enhancing them to create a diverse and dynamic gameplay experience.\n\nSprinting: Channel your inner baboon as you sprint through the jungle at breakneck speeds, leaving your opponents in the dust. The sensation of speed is exhilarating, and you'll feel like a true jungle sprinter.\n\nLeaping and Climbing: Baboons are known for their agility, and in \"Baboon,\" you can leap incredible distances and climb up trees and cliffs with ease. The game's physics system ensures that every jump and climb feels responsive and realistic", "short_description": "Welcome to \"Baboon,\" an exhilarating game where you become a nimble baboon, inspired by the electrifying movements of gorillas. In this high-octane multiplayer adventure, you'll swing through trees, leap between platforms, and race your friends in a lush, immersive jungle environment. \"Baboon\" brings the thrill of \"Gorilla Tag\" to new heights, with intuitive, heart-pounding movement mechanics that put you in the heart of the action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/baboonery/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "pepega", "support_website_url": null, "website_url": "https://sites.google.com/view/baboonery/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7094365053918116"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39001703_296110469936318_6886108619206940017_n.png?stp
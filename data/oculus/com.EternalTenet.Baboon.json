dn.com/v/t64.5771-25/75222943_1214442206610689_8110931047485643820_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3M8assMVmQQ7kNvwHsGZs4&_nc_oc=AdorPbA5ne9fYTjWweXYpVswVSpeUm_bKCq4DL0vjpUG5a5IgoX6MaH-oF25LPnAkyY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReH4RNB3W3ExWbvrx5AG6vCAndUm_2oMcag5n_o_R0Vg&oe=6B09BE47"}, {"file_name": "screenshot3.png", "id": "832874298306778", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036649_832874301640111_6431438389637417765_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnaMoXCUgzgQ7kNvwG06ZWF&_nc_oc=AdqP3kTy8p8vNGcpq_vSln9Ube1IrLYOJ9K94PTeTFLVpRg6__rX2lmmazHeFoVPmFE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_TG4aDNf6pA5FUzYCKSTilS0KhxV2VkBXynRv4so3BQ&oe=6B09CCA5"}, {"file_name": "screenshot4.png", "id": "362898849498689", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974535_362898852832022_8522236402830681562_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRCg-Lj4XhAQ7kNvwEOP0He&_nc_oc=Adr6LSTWJyBXztJGuHt7MLYdw7d9Tiebl7yekgQj9GQjvGIduaJsq9O9G1cD0PXeO_w&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHZ7JuOqLRqNh2mflhG9GqVeOsC8-88bCMKt4fasbBtQ&oe=6B09CE24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "heroart (1).png", "id": "255464397022691", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57568668_255464400356024_7599096233503142883_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOz1HBvVeusQ7kNvwEBmvBz&_nc_oc=AdodFIxMf6akFf-CbwoY1G5HveI9D2HpS88UBztG9ksoeiPRKqMsczhOuQBO3-sOX6Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjlyjZrq-ALr4s1fziYlGiUgqz69E2iwdj6UulvMfzjg&oe=6B09CC51"}, "display_name": "Baboon", "keywords": [], "long_description": "Intuitive Movement Mechanics:\n\nAt the core of \"Baboon\" are the intuitive movement mechanics, taking inspiration from \"Gorilla Tag\" and enhancing them to create a diverse and dynamic gameplay experience.\n\nSprinting: Channel your inner baboon as you sprint through the jungle at breakneck speeds, leaving your opponents in the dust. The sensation of speed is exhilarating, and you'll feel like a true jungle sprinter.\n\nLeaping and Climbing: Baboons are known for their agility, and in \"Baboon,\" you can leap incredible distances and climb up trees and cliffs with ease. The game's physics system ensures that every jump and climb feels responsive and realistic.", "short_description": "Welcome to \"Baboon,\" an exhilarating game where you become a nimble baboon, inspired by the electrifying movements of gorillas. In this high-octane multiplayer adventure, you'll swing through trees, leap between platforms, and race your friends in a lush, immersive jungle environment. \"Baboon\" brings the thrill of \"Gorilla Tag\" to new heights, with intuitive, heart-pounding movement mechanics that put you in the heart of the action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/baboonery/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "pepega", "support_website_url": null, "website_url": "https://sites.google.com/view/baboonery/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6920537374634219"}}]}, "scheduled_offers": {"count"
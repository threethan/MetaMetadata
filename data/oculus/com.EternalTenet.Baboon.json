ng?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFHjplGFIDoQ7kNvwENlq_5&_nc_oc=Adrh3W0HTbNMu8XlCsZ97yhS9nehU3sUicgCIY6Ve0wBc6bEBN-vUaapWzZBZOrNaV4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJj3rTdZiRwi4D-BGW42YJiGOkeToqOOLNZLghI0DfVLw&oe=6AB3D487"}, {"file_name": "screenshot3.png", "id": "832874298306778", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036649_832874301640111_6431438389637417765_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JsaETRqVf4Q7kNvwHhG6pp&_nc_oc=AdpWjVwQtMDGnxb-bbyo_u0XPsiSwXcMGxaSyMK4J-F_-_WwpGHwlt2j9huH22rvJqo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtK0y0P2Duy1KAJCvFERANUMSIvPSdxAKwJO8a225H4w&oe=6AB3E2E5"}, {"file_name": "screenshot4.png", "id": "362898849498689", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974535_362898852832022_8522236402830681562_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZTrRCysv2wQ7kNvwFO7572&_nc_oc=AdrEp15i7T5IEJEAaswvul_Mxk17IROvXEXFs5beMnrxLbXXaSq-xmOc_TISmD7EVs0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI--0oLhMMND2E9-BJ87sbgoVXjOcNB0q4FQCUZy3ih4g&oe=6AB3E464"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "heroart (1).png", "id": "255464397022691", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568668_255464400356024_7599096233503142883_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5HNjtlu1UYQ7kNvwFrLP8G&_nc_oc=AdpvbpxrWifK3D_rEveDyBySvj7IFSTVg6DWtrQCayO3nrZ1W_RslJANCaNCZsUy5cU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIyRee8g-D4gDhdy6AVYhd5VlApsmBdqWup8NnWRKgTw&oe=6AB3E291"}, "display_name": "Baboon", "keywords": [], "long_description": "Discord: https://discord.gg/bm2cv74hrW \n\n\nIntuitive Movement Mechanics:\nAt the core of \"Baboon\" are the intuitive movement mechanics, taking inspiration from \"Gorilla Tag\" and enhancing them to create a diverse and dynamic gameplay experience.\n\nSprinting: Channel your inner baboon as you sprint through the jungle at breakneck speeds, leaving your opponents in the dust. The sensation of speed is exhilarating, and you'll feel like a true jungle sprinter.\n\nLeaping and Climbing: Baboons are known for their agility, and in \"Baboon,\" you can leap incredible distances and climb up trees and cliffs with ease. The game's physics system ensures that every jump and climb feels responsive and realistic", "short_description": "Welcome to \"Baboon,\" an exhilarating game where you become a nimble baboon, inspired by the electrifying movements of gorillas. In this high-octane multiplayer adventure, you'll swing through trees, leap between platforms, and race your friends in a lush, immersive jungle environment. \"Baboon\" brings the thrill of \"Gorilla Tag\" to new heights, with intuitive, heart-pounding movement mechanics that put you in the heart of the action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/baboonery/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "pepega", "support_website_url": null, "website_url": "https://sites.google.com/view/baboonery/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7094365053918116"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001703_296110469936318_6886108619206940017_n.png?stp
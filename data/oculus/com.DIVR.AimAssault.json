h=00_AQI8L63p4ad-70VddOHg_5CrMYYN7AZ6p2q28TZHjkxRBQ&oe=6ABA680F"}, {"file_name": "AimAssaultScreenshot_3.png", "id": "1627356021267192", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618270_1627356024600525_1433245194245086334_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTf5ZkhpbIwQ7kNvwHkxKSo&_nc_oc=AdoOxrknIdOOiZTT0yAPl_VuFJnZ3M3C96SsEKaq3sJ6nZYpxo9ZS-JIO7fsjQHs76E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6cPBzYJh2oYbWdA8l6u0ukreccuZU09ayXYgmLz2ftA&oe=6ABA8649"}, {"file_name": "AimAssaultScreenshot_1.png", "id": "627477853704733", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619635_627477857038066_8388865204167129173_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlRqt7xspNQQ7kNvwEfsGBB&_nc_oc=AdqBzRoIm0Q1STYtGNXCx_wHHJYpgqTsp4vzlto_aeAk488hlxbqq9-eWcTKyDV7dl4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2hLDH9WJ4tR-_BwdZRv5B5UM_ib_ZNQl5ruQR0O9mwQ&oe=6ABA6550"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverVideo.png", "id": "742188441529341", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622140_742188444862674_7941753439231328819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jLXsjjTqMUQ7kNvwHGiJPI&_nc_oc=AdotpD7DHprZD3g3P-Yvm0f1lmFDuU77vzk8pcl4vAKA3GqLAGzZKXU9MFJUa9embO0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzX5xxpXiOmaMXcyoRck0p6k1cs3zYq6ryz3IIYCCejA&oe=6ABA6540"}, "display_name": "Aim Assault", "keywords": ["shooter", "action", "railshooter", "arcade", "retro"], "long_description": "Aim Assault brings good old arcade rail-shooter into the world of virtual reality. Relive the excitement of old-school arcade games now in VR. Try out various gunplay styles - single gun, dual wielding, with or without a crosshair. Race against the clock and try to beat your personal score or compete in the global leaderboards. Fight different types of enemies in intense situations and everchanging rich environments. Dodge barrages of bullets, kill the bad guys and save the world. \n\n{3949976691979489}\n\nWe are excited to give you the opportunity to play the first levels of our game for free. Immerse yourself in the action-packed VR rail shooter, full of shooting, dodging bullets, and fighting villains. The game is currently in development and will be released at the end of 2025. \n\n{1255452129586802}\n\n\"VR gave us a rare opportunity to recreate the arcade shooters we all loved as kids in a new way. Because of VR, we have new tools to immerse players even more into a game full of action.\" - Jakub Kucera (Game Director)\n\n{24410473498565871}\n\nDiscord\nWe regularly announce new locations, enemy types, bosses, and game mechanics on our Discord. Share your thoughts on the demo with us.\n\nWelcome to the world of Aim Assault!\n\n\n", "short_description": "Aim Assault brings classic arcade shooters into the world of virtual reality. Dodge a storm of bullets, take down hordes of enemies, and save the world in this action rail-shooter game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1MY3bRXd0pXVUyxJ45dbVp6nz232SSenm3r_S0XbLrCI/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "DIVR Labs", "support_website_url": null, "website_url": "https://www.divrlabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "su
1-25/499619136_1755984612464334_5485499222678035634_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDGxXFwBZJ0Q7kNvwGFLRR-&_nc_oc=AdrL_hMG20r3_M4p9xFrtYUJ1FZUEnPfLfJvnsanySYLfQ-XFMHc_QUS1fBc42nUVtQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRhSTnuGCGrK25855mdPXbztPoP9y2NcUenRQXtoVgCjw&oe=6B0C5D4F"}, {"file_name": "AimAssaultScreenshot_3.png", "id": "1627356021267192", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618270_1627356024600525_1433245194245086334_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJK6pO_T0eAQ7kNvwGeADFG&_nc_oc=Ado7abNLoIcC6iXiSvdP2TnGHa-IbAcV0RZjqqEDl0v8Q39nGg_xl-N7uU_2ZfEExVk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTteEdt5r_xY97h9UWBhQN4bCbxBcwcIid48oitZzwuwg&oe=6B0C7B89"}, {"file_name": "AimAssaultScreenshot_1.png", "id": "627477853704733", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619635_627477857038066_8388865204167129173_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RF6L0QY-d2wQ7kNvwHgFvvy&_nc_oc=AdrqAZt81DEvXy-_tzq5TtgA1DpkxgVdiVp_MfadjSnXwqozMdX5uIcBYtLeAtsC_F8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRaKIn0lyYOL6nRMkNPtdltHJDOyb2f2kJPzof1e-dwEQ&oe=6B0C5A90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverVideo.png", "id": "742188441529341", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622140_742188444862674_7941753439231328819_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdAaemLIbVYQ7kNvwFfi5in&_nc_oc=AdpllnKVlB-5QhtCmIZbYVKn5ATGZoOOBilDYdu9y2lOP9u3AtD0YlGOMLvh0_KhMLM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQs6TRlY7rFMMyK2Uxk5RxNK6GhGLu-8Xb8tML_JOWMzw&oe=6B0C5A80"}, "display_name": "Aim Assault", "keywords": ["shooter", "action", "railshooter", "arcade", "retro"], "long_description": "Aim Assault brings good old arcade rail-shooter into the world of virtual reality. Relive the excitement of old-school arcade games now in VR. Try out various gunplay styles - single gun, dual wielding, with or without a crosshair. Race against the clock and try to beat your personal score or compete in the global leaderboards. Fight different types of enemies in intense situations and everchanging rich environments. Dodge barrages of bullets, kill the bad guys and save the world. \n\n{3949976691979489}\n\nWe are excited to give you the opportunity to play the first levels of our game for free. Immerse yourself in the action-packed VR rail shooter, full of shooting, dodging bullets, and fighting villains. The game is currently in development and will be released at the end of 2025. \n\n{1255452129586802}\n\n\"VR gave us a rare opportunity to recreate the arcade shooters we all loved as kids in a new way. Because of VR, we have new tools to immerse players even more into a game full of action.\" - Jakub Kucera (Game Director)\n\n{24410473498565871}\n\nDiscord\nWe regularly announce new locations, enemy types, bosses, and game mechanics on our Discord. Share your thoughts on the demo with us.\n\nWelcome to the world of Aim Assault!\n\n\n", "short_description": "Aim Assault brings classic arcade shooters into the world of virtual reality. Dodge a storm of bullets, take down hordes of enemies, and save the world in this action rail-shooter game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1MY3bRXd0pXVUyxJ45dbVp6nz232SSenm3r_S0XbLrCI/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "DIVR Labs", "support_website_url": null, "website_url": "https://www.divrlabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": 
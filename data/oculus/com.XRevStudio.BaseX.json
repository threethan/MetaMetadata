nt-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPw1rCqWbySIUIVn659VYNotOn78e-eZLDWZMYPtV3Ig&oe=6AB7D20F"}, {"file_name": "4-challenge-mode.png", "id": "1535131734762005", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_1535131738095338_7813622852163005885_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_BEUwlSeAAQ7kNvwGL0aOp&_nc_oc=Adr5OhyD-3-EEqSTdHROdVBpLP_SAP2kqgC_0Bi02IcT6OhybsBv_DVNiWKZgmJctWo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQQmP-RaOSxWLFnVkMwO22X0mCp3tmRRxnkTIjXcZSyg&oe=6AB7E9AC"}, {"file_name": "5-arcade-mode.png", "id": "4518532328391634", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310667_4518532331724967_3433011684059666908_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIAkeN1YLnYQ7kNvwETcuq-&_nc_oc=Adr4ftvNaoAg4QoXtE8MbQn8h2Z5iRboed9yxPNI9Wd5GMfwURLnP6pnIvMcGapEfa0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKf0jWYfRAV9pu_Ypfdxc60Q-uWtqKdyFn7yfqdqzdiDw&oe=6AB7D757"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baseball X", "keywords": ["batting", "homerun", "pitching", "derby", "fitness"], "long_description": "Step up to the plate in **Baseball X** - a VR baseball simulator for Meta Quest that turns your room into your own batting practice stadium.\n\nDial in every pitch: location, speed, swing and spin. Face fastballs and breaking balls, then watch your home runs fly with realistic bat physics that make every hit feel natural.\n\n**FEATURES**\n\n- Batting practice, your way: full control of pitch location, speed and spin\n- Realistic physics: natural swings, true ball flight and satisfying contact\n- Swing analysis: track your hitting stats and replay your best hits in 3D\n- Challenges and events: put your batting to the test\n- For all skill levels: from first-timers to players sharpening their timing\n\nWhether you are training to improve your batting, chasing home run records, or just want an active VR sports workout, Baseball X delivers pick-up-and-play fun with the depth to keep you swinging.\n\nGrab your bat. Start the pitching machine. Play ball!", "short_description": "Baseball X is a VR baseball simulator for Meta Quest. Take batting practice with full control of pitch location, speed and spin, hit home runs with realistic physics, analyze your swing, and take on challenges and events. From casual fun to serious hitting training - an active VR sports experience for all skill levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrevstudiopk.blogspot.com/2023/08/xrev-studio.html", "developer_terms_of_service_url": null, "publisher_name": "Xrev Studio", "support_website_url": null, "website_url": "https://xrevstudiopk.blogspot.com/2023/08/xrev-studio.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "37297392693238554"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391990_979811207329731_688126897918142336_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgG7x1_Ux2MQ7kNvwHp4Jmm&_nc_oc=Adpv4BIPj79Rq71uijUYERA46JfmlUyBeBWeuOVmGg4M7t68w8uMHMWecdrFNmnPafI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOHpEdoJBvQsbt8wIyicr-JPcX6pO9HepmYxJLVnJTsA&oe=6AB7BD61"}, "is_concept": false, "is_test": false, "is_trial_offer_
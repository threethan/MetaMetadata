e": "000004.png", "id": "2489169471248702", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003270_2489169474582035_1206711399331240332_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBj2rV9aMt0Q7kNvwHJOX0F&_nc_oc=Adr_4teVjV2vI8t8LPV3wS88xa53ZlRDh6k26aVEOXJaq1EGXfN5v4kYUBySSYJAL_0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEX78gapuwfS7jPcPUeG8zRfhtT2_HzQI_aEKPdb-eKpA&oe=6A772046"}, {"file_name": "000003.png", "id": "999754197692350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982458_999754201025683_8126311599875702919_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvkU9mfsZ5UQ7kNvwGRwWiG&_nc_oc=AdoU2tA0R6bqsEN3VgXpIt1OMKFzxFpMby0JGbC4BPkPMc6QAbDHCGzH111QCUlQm2k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWvxFRdIsjAIohZ_4CN_Tln9ABFYVGn87qdIy9bEDZhw&oe=6A771A0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1111.png", "id": "642215117835898", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031523_642215121169231_1253359253477954172_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPN_fy5fU7QQ7kNvwGeTd4N&_nc_oc=AdqW49VxkN4PZDdrHKNNyPNnnYQxliOMQJ4B9Mh8mv9IdC14QcQ45A8j0shpVrBTb80&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-T85lRSCcX2PRK8nVD4GA7EXxKHdNHUvn_FlxkB45KA&oe=6A771853"}, "display_name": "Block_Hunter", "keywords": [], "long_description": "\"Block Hunter is a music rhythm game that combines party game, online competitions, and maybe rogue lite genes,and one more thing...\"\n\"Give me the mic,mic-check,1,2,3...\n Okay,listen up,folks:\nAs everyone knows,the BLOCK Galaxy is the motherlode of Block storage in the Cosmos. But it's also a hot zone for the Block Pirates who love causing chaos and looting.\nThat's why we got a bunch of Block Hunter volunteers going to take down those infamous Block pirates. The pirate cargo ships are filled with piles of loot and powerful weapons, Although each hunt is both dangerous and thrilling, the rich reward and glorious leaderboard make everyone want to take their chance for themselves, um... I mean,of course\uff0cAll for the glory of the BLOCK Galaxy. \n\n- Endless hunting experience \uff08you'd stick it out\uff09\n- Groovy beats\uff08More and more updates in the future\uff09\n- Mystery perks \uff08You deserve it\uff09\n- Ranking competition\uff08Not vanity\uff09\n- Local multi-user login \uff08compete your family or Friends\uff09", "short_description": "Block Hunter is a music rhythm game that combines party game, online and local competitions, and maybe rogue-lite genes.hope you guys enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.737.com/protocol/30379-2.html", "developer_terms_of_service_url": null, "publisher_name": "FEIYU TECHNOLOGY HONGKONG LIMITED ", "support_website_url": null, "website_url": "https://www.holo-goose.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1700921480735423"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24082683604699699"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974900_251018940894412_2822056221580308406_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSo_tPKNio8Q7kNvwEg6VuF&_nc_oc=AdoWhcZaQrul6nw1KQ01BXQ6G4cPWlIaZnT3SWwGJ_0LWhrk9FhIKWQEu1YojS4RaPE&_nc_zt=3&_nc
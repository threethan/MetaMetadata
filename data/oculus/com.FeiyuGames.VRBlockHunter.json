&oh=00_AQGw1csxDq_nvtOYvGGVpehKl2bbdy1bwFSJ1B13Xc0n1Q&oe=6A75CEC6"}, {"file_name": "000003.png", "id": "999754197692350", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982458_999754201025683_8126311599875702919_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvkU9mfsZ5UQ7kNvwFgWz7v&_nc_oc=AdpFRwAH-_I8phY3e3fheCX_hNYohtU99DvAumtRZ257ejCiXrgzPtfQCnYdjwI7FKE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERayHU-ST9Vj1d3083fbMCMDcS4ySAC0L52wZcyqM3oQ&oe=6A75C88A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1111.png", "id": "642215117835898", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031523_642215121169231_1253359253477954172_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPN_fy5fU7QQ7kNvwEj3jpz&_nc_oc=AdoZSN5wVvDEJPiU4rEboRY6DsFBcEJZCAOA3FQnWwU6bBn8jeLnmDf_sFEVYjvxp3o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErlJLrxYyy-c9Psk126T28a3Zy-BZJAhRgCDEcyhK0dQ&oe=6A75C6D3"}, "display_name": "Block Hunter", "keywords": [], "long_description": "\"Block Hunter is a music rhythm game that combines party game, online competitions, and maybe rogue lite genes,and one more thing...\"\n\"Give me the mic,mic-check,1,2,3...\n Okay,listen up,folks:\nAs everyone knows,the BLOCK Galaxy is the motherlode of Block storage in the Cosmos. But it's also a hot zone for the Block Pirates who love causing chaos and looting.\nThat's why we got a bunch of Block Hunter volunteers going to take down those infamous Block pirates. The pirate cargo ships are filled with piles of loot and powerful weapons, Although each hunt is both dangerous and thrilling, the rich reward and glorious leaderboard make everyone want to take their chance for themselves, um... I mean,of course\uff0cAll for the glory of the BLOCK Galaxy. \n\n- Endless hunting experience \uff08you'd stick it out\uff09\n- Groovy beats\uff08More and more updates in the future\uff09\n- Mystery perks \uff08You deserve it\uff09\n- Ranking competition\uff08Not vanity\uff09", "short_description": "Block Hunter is a music rhythm game that combines party game, online and local competitions, and maybe rogue-lite genes.hope you guys enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.737.com/protocol/30379-2.html", "developer_terms_of_service_url": null, "publisher_name": "FEIYU TECHNOLOGY HONGKONG LIMITED ", "support_website_url": null, "website_url": "https://bh.feiyu.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1700921480735423"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6846581458736515"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7359656527429003", "version": "1.01"}, "id": "3692732034292229", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6367516176643048", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7359656527429003"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3692732034292229"}]}, "ch
5824513242114_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWmqk-FmE0EQ7kNvwFBQ2QV&_nc_oc=AdncUYzFjy9DF2HVWGjK43y_XCrBZUrMtA5O69ZkKmWFYHRcZcC7xbLhOeRe3NYk4EA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuQ4sB6edZ7soenAZWS1VWIcUygO7DVWDpkMtB5VdLwAg&oe=69A028A4"}, {"file_name": "38974676_1428676664176341_4960148504246094156_n.png", "id": "592093888989797", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982533_592093892323130_8273476912356709667_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVl-KZRXr2IQ7kNvwHB5vuT&_nc_oc=Adl81Xg_Wjq56_SnBZOZ9Q9niRpvdhuwcKbKpIUzwwnaBthtw39isLIwQQy2Iy664rI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvluKRK82Upn3BnZNlsXjoUJc_oAS0gxTHD2K_-5dBclQ&oe=69A04667"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape_demo.png", "id": "536963448217674", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003279_536963451551007_4221574022262297554_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oLpCj_vRvAQ7kNvwFLHpww&_nc_oc=AdkjvHNglsPJw-gpPjNYucxn2kXf1jGnS1GGMx8loHZOXnqAzevNB6McT3F-z1lH8XI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftjXFT6xPfcgPd_xnVgJl7Job2TQbsR0j8AtRQi0oomzQ&oe=69A04102"}, "display_name": "Wolf and Pigs Demo", "keywords": [], "long_description": "Full Wolf and Pigs game : https://www.oculus.com/experiences/quest/5601617199878444/\n\nOnce upon a time, the notorious Pig Brothers gang invaded the New World, blasting and disfiguring nature to build their secret base.\n\nPortrayed as evil by the media \u2013 who have been bought and paid by the Pig Brothers \u2013 the Wolf is the last defense between Nature and the brothers\u2019 greed.\n\nWith no one to stop them, the Pig Brothers are laying waste to everything in their path, raking in the cash. Everyone thinks that Wolf is dead, but there\u2019s a sliver of hope. It turns out that Wolf has upgraded his body with high-end prosthetic arms loaded with all sorts of weaponry, including shotguns and bombs!\n\nNature has its defender at last. Will the Pig Brothers pay the ultimate price?", "short_description": "Wolf & Pigs: Out for Vengeance is a fresh take on the classic fable \u201cThe Three Little Pigs.\u201d When the notorious Pig Brothers Gang invades the New World to build their compound, an unlikely protector vows to put an end to the Pigs greedy, nature-destroying ways!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "372885338300171"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1413069539173272"}]}, "baseline_offer": {"id": "1413069539173272"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1658852580, "status": "PUBLISHED", "id": "1413069539173272"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5454769841248602", "version": ".6"}, "id": "1931766873684929", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary"
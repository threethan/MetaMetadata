Controls.png", "id": "1995572084412378", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596061819_1995572087745711_7710403400178747346_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7dwvrLsYtAQ7kNvwHiv6y2&_nc_oc=AdoQKuRuaMUJzkZIxQFFjA-u2I4ejckU4jLJYh5miRGpZ-gI7zsm_6_VUKX5sJ3xBCI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNrdY9lFCwtlMIzIIMEq-vhzShSc6-2FVbZIjDyr1xNw&oe=6AEF400C"}, {"file_name": "Position.png", "id": "1511003830835760", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596068480_1511003834169093_5348767387874534395_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1eZbLKvEcAQ7kNvwG0owfO&_nc_oc=AdokBO3c1ESkY0qnfglqFOJSByu7ft-ds3QEnjkIT2qiuFgxITcVbRqOrdalJ0JwG4E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8Dpn4eAtGSuYoQMzuq0CgT4AvBm-28ifx9_itPd1Flg&oe=6AEF6372"}, {"file_name": "Playback.png", "id": "1783733295999881", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604347072_1783733299333214_4524592481569097329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmVLBoSEJ2YQ7kNvwHqLMUm&_nc_oc=Adrig4OfNaT5R8l0XcSwbbXzdlfOdBBWBk2xxw0StsTQIK16ZyjRKy_XfxBdF1mFzpo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEjIYqpvksMdU5Hqx9SvNoK2ZHaiQr0_4bNxL_yMW_rQ&oe=6AEF5F12"}, {"file_name": "Picture.png", "id": "2267150527411686", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673645340_2267150530745019_693345360082059666_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Fribf_0V24Q7kNvwFRbc4o&_nc_oc=AdrrddlJeeM7R2TWc1weTVN5QfWkP-o5_k3J6xoy4Zrcw5Monh2epYiT33MfXdeGny4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi3xHKmrKSpnqEy7Crtwryoq8EwnWzgVFJRzQpZvnR4g&oe=6AEF4C7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vistalyra", "keywords": ["VR180", "passthrough", "video", "3D", "VR360"], "long_description": "Watch your videos from a seat, a sofa or lying back. Vistalyra is a VR video player for local files and supported direct media streams. Buy once: every feature is included, with no ads or subscription.\n\nPlay 2D movies, 3D side-by-side and over-under videos, VR180, VR360 and equidistant fisheye. Choose flat or curved cinema, full or half stereo, swap eyes or watch one eye in 2D. Filename tags and stereo metadata help select the format automatically. Set the aspect ratio to Auto, 16:9, 21:9 or 4:3. 3D depth requires a stereo video.\n\nHold grip to turn the picture and twist your wrist to straighten a tilted horizon. Use the joystick to seek and zoom; grip plus joystick adjusts flat-screen distance. Let the screen follow your head, recenter with a button, or grab the controls and place them where they suit you. Compact controls stay visible while in use and fade when idle.\n\nSearch and sort your library, save favourites, hide thumbnails and resume where you left off. Choose audio and subtitle tracks, load SRT/WebVTT subtitles, adjust speed and volume, save bookmarks, repeat a video or an A\u2013B segment, and set a sleep timer.\n\nCompatible tagged SBS fisheye-alpha videos automatically use their background mask for passthrough. Green/blue detection and manual green, blue, black or gray keys give you more control.\n\nBring your own videos. Playback depends on your files and headset. DRM, disc images, MVC, MV-HEVC, proprietary lens calibration and SMB/DLNA are unsupported.", "short_description": "A VR video player that fits the way you watch. Play 2D movies, 3D, VR180 and VR360 videos. Position the picture with your controller, straighten tilt, zoom with the joystick and enjoy controls that fade when idle. Subtitles, bookmarks and compatible alpha-video passthrough are included. One purchase, every feature."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raheelswati.github.io/vistalyra-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Extrude Studio", "support_website_url": "https://raheelswati.github.io/vistalyra.html", "website_url": "https://raheelswati.github.io/vistalyra.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055925317266891"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1829188368503128"}, {"status": "PUBLISHED", "id": "1799120718032813"}]}, "baseline_offer": {"id": "1799120718032813"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793473200, "status": "PUBLISHED", "id": "1829188368503128"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1075325415326881", "version": "1.2.1"}, "id": "1237605561895886", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1055925300600226", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1075325415326881"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1237605561895886"}]}, "change_log": "Reliability update: software notices and browser permission prompts remain inside the VR panel, preserving the browser page. Closing the app stops new scene work. Includes the compact interface, automatic local formats and compatible VR browser controls.", "created_date": 1792733044, "id": "1075325415326881", "version": "1.2.1", "version_code": 88, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1055925300600226", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1075325415326881"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1237605561895886"}]}, "change_log": "Reliability update: software notices and browser permission prompts remain inside the VR panel. Closing the app stops new scene work from being scheduled. Includes the compact interface, automatic local video formats and compatible VR browser controls.", "created_date": 1792731488, "id": "1075310575328365", "version": "1.2.1", "version_code": 87, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1055925300600226", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1075325415326881"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1237605561895886"}]}, "change_log": "Compact controls with Video view, improved local VR and stereo format detection, browser VR180/360 controls, controller seeking and recovery, a visual first-run guide, themes and cinema screen tilt. All manual viewing options remain available. Local file deletion requires confirmation. Website playback depends on the provider; immersive WebXR and DRM bypass are not supported.", "created_date": 1792695454, "id": "1074970218695734", "version": "1.2.0", "version_code": 86, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1055925300600226", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1075325415326881"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1237605561895886"}]}, "change_log": "Browser address-bar search now submits with the standard keyboard Enter, Go, Search or Done action. Includes the browser and playback improvements from 1.1.0.", "created_date": 1792351664, "id": "1071328009059955", "version": "1.1.1", "version_code": 84, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1055925300600226", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1075325415326881"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1237605561895886"}]}, "change_log": "Improved browser search and typing: search Google or enter a website, use webpage text fields, and return safely to the library. Cinema browsing keeps pages aligned while rotating the room. Curved screens have easier thumbstick distance adjustment, a wider size range and saved settings. Added pointer feedback, authenticated read-only WebDAV with Cancel and Retry, saved picture corrections and subtitle reliability improvements.", "created_date": 1792236315, "id": "1070037935855629", "version": "1.1.0", "version_code": 83, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
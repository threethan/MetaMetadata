.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJyTYwK0Qcah7qRUsGw3l4Tzv-ApxsOfixV0skC9SepA&oe=6AF9D1F2"}, {"file_name": "cover-square.png", "id": "1616972276786227", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830904_1616972280119560_6062489186450129507_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-CHJISi3yoQ7kNvwEU5n26&_nc_oc=AdoaPRmTD-D6oIYHimwejmVs6ZZYmjU-PtsuyahAHkCmJ8het1P77InZAerlpjyY_Ik&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMxmb_xzJKWelL4bMj1OR-7pGe9vncYLjkanxbVZIURA&oe=6AF9C19C"}]}, "id": "1525844036037749", "locale": "en_US", "screenshots": [{"file_name": "01-cinema.png", "id": "1145056714747652", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830822_1145056718080985_5519517145572171750_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qaB8GH6eGUQ7kNvwEOuJrS&_nc_oc=AdrYFw1f36YfpIPneFOXImkXGIrcGrbt5XP_QAbickD7XHTOG1zzUaL5wPOqnChTTCE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQklPPq0E_UbVvDCm6SdvPXeeIEtc2EnD1PfyRTVw0OkQ&oe=6AF9C0D8"}, {"file_name": "03-browser-vr180.png", "id": "1158114206873302", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491830822_1158114210206635_9151647984747596680_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7V4-8MIfpYQ7kNvwGerCPJ&_nc_oc=AdrJ0M5-q8BYs5Z8Csd1zwluOSDsu0-PXfPd-zx-e5MlY11CU2kgjn4FHfiCH2zZ0rw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLu53zwaTHxUqe5yjV1ihRZIdiSICmuTS24joJ_nSLSw&oe=6AF9ED95"}, {"file_name": "04-video-view.png", "id": "1095796036655114", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/789212960_1095796039988447_1306473678239381483_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7CEhUgOZIQQ7kNvwFwFs7h&_nc_oc=AdrZ31tMdx6B4ounD2ZNkq2RBlHvLAEBNplVeIAQ-Hh5k2egk7W9_V9VVkCcAt4WsZs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSflO9SWJNR1LkQWlaOcxS2D6mEiK5-wxB7UDAskgbSoQ&oe=6AF9D797"}, {"file_name": "05-browser-vr360.png", "id": "2663294627419731", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830822_2663294630753064_5353842829572621924_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-SWmrDdXIoQ7kNvwFn8H2-&_nc_oc=AdouUB7HBQcNE1PMWQ-HMruP7J_tX9e5sGbKAl2KjSooKQ4F7X5HrmJUpPhlnRiDml0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTf5RaHWz0ahP7TOYat15W14oOnGDNRcCv9uHrEAtrbwg&oe=6AF9BD97"}, {"file_name": "05-alpha-options.png", "id": "1520356430140744", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491825345_1520356433474077_4805466640865044655_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mp597pKs1kQ7kNvwHTQvnX&_nc_oc=AdqTdVWoFLn9RTTZE5fIlKBVYXrW7_OMTQlmwSxzcx2TriSxX2ODhmDKDIcVCHHhFbE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQF6F59HNAYN1XpjDq0dOfaY8EgzVmEodyBsoAVYvn9iw&oe=6AF9D20A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest-store-trailer-thumbnail.png", "id": "1114629077791119", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491830441_1114629081124452_4364447799683608141_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8CFyIdfe9YQ7kNvwGRvjE0&_nc_oc=AdpNhnL6woyEEJdWMGksRP0U3ifyLGbL4Uv_HXyKEcXw6aTfoBQxfnzDK8RYjM9EIX8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDlv7DigYA9U1-op307FfIrcl-6zPvpWOdOTxB2wSE5Q&oe=6AF9C250"}, "display_name": "Vistalyra: VR Video Player", "keywords": ["VR180", "passthrough", "3D", "VR360", "browser"], "long_description": "Your videos. Your cinema. Your VR browser.\n\nPlay local 2D, full/half SBS or over-under 3D, VR180/360 and equidistant fisheye. Auto format hints, manual modes, eye swap, one-eye viewing and saved per-video settings.\n\nBROWSE & WATCH\nSearch or enter HTTPS addresses. Native keyboard editing, Backspace and Search/Go/Done/Enter in supported forms. Scroll with either thumbstick. Compatible web video: flat, curved, VR180/360, Dome and Fisheye 180/190/200/220 with stereo layouts. Seek by timeline/buttons/stick when supported. Page / next videos returns to the site; B/Y restores controls.\n\nYOUR SPACE\nNormal viewport, Theater, Lounge or Beach; room-screen attachment or floating view. Flat/Curved screens, size, distance, zoom, tilt, rotation, recenter, head lock and seat/height controls. Passthrough, packed alpha and chroma keys with edge/spill controls.\n\nYOUR COLLECTION\nLocal files, direct streams and authenticated read-only WebDAV with Cancel/Retry. Search/sort, favorites, hide/restore, confirmed deletion, resume, bookmarks and queue.\n\nFINE CONTROL\nAudio/subtitle tracks, SRT/WebVTT and subtitle styling. Speed, volume boost, frame stepping, repeat/A-B loop and sleep timer. Themes, widgets, click sounds, ambience, room activities, hands and movie cadence. Offline sample and visual guide.\n\nBuy once; no ads or subscription. Bring lawful media. Website and media compatibility varies; third-party content is not included.", "short_description": "A personal Quest cinema and built-in VR browser for your own 2D, 3D and VR180/360 videos. Browse, search, play compatible web video in VR and keep compact controls nearby. Auto format detection, full manual options, floating/reclining screens, passthrough/alpha, WebDAV, subtitles and bookmarks. Choose your room, seat and theme, with optional ambience, room activities, hand visibility and movie cadence. Start with an offline sample and visual guide. One purchase; no ads or subscription."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raheelswati.github.io/vistalyra-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Extrude Studio", "support_website_url": "https://raheelswati.github.io/vistalyra.html", "website_url": "https://raheelswati.github.io/vistalyra.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_s
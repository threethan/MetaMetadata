_ss=7f20f&oh=00_AQPrEbWdUfM4gAy5-0G2e0qAvmVBxh0szldLq8gPthw7Lw&oe=6ADF7A7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vistalyra", "keywords": ["VR180", "passthrough", "video", "3D", "VR360"], "long_description": "Watch your videos from a seat, a sofa or lying back. Vistalyra is a VR video player for local files and supported direct media streams. Buy once: every feature is included, with no ads or subscription.\n\nPlay 2D movies, 3D side-by-side and over-under videos, VR180, VR360 and equidistant fisheye. Choose flat or curved cinema, full or half stereo, swap eyes or watch one eye in 2D. Filename tags and stereo metadata help select the format automatically. Set the aspect ratio to Auto, 16:9, 21:9 or 4:3. 3D depth requires a stereo video.\n\nHold grip to turn the picture and twist your wrist to straighten a tilted horizon. Use the joystick to seek and zoom; grip plus joystick adjusts flat-screen distance. Let the screen follow your head, recenter with a button, or grab the controls and place them where they suit you. Compact controls stay visible while in use and fade when idle.\n\nSearch and sort your library, save favourites, hide thumbnails and resume where you left off. Choose audio and subtitle tracks, load SRT/WebVTT subtitles, adjust speed and volume, save bookmarks, repeat a video or an A\u2013B segment, and set a sleep timer.\n\nCompatible tagged SBS fisheye-alpha videos automatically use their background mask for passthrough. Green/blue detection and manual green, blue, black or gray keys give you more control.\n\nBring your own videos. Playback depends on your files and headset. DRM, disc images, MVC, MV-HEVC, proprietary lens calibration and SMB/DLNA are unsupported.", "short_description": "A VR video player that fits the way you watch. Play 2D movies, 3D, VR180 and VR360 videos. Position the picture with your controller, straighten tilt, zoom with the joystick and enjoy controls that fade when idle. Subtitles, bookmarks and compatible alpha-video passthrough are included. One purchase, every feature."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raheelswati.github.io/vistalyra-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Extrude Studio", "support_website_url": "https://raheelswati.github.io/vistalyra.html", "website_url": "https://raheelswati.github.io/vistalyra.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055925317266891"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1829188368503128"}, {"status": "PUBLISHED", "id": "1799120718032813"}]}, "baseline_offer": {"id": "1799120718032813"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793473200, "status": "PUBLISHED", "id": "1829188368503128"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1070037935855629", "version": "1.1.0"}, "id": "1237605561895886", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1055925300600226", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1070037935855629"}, "release_status": "RELEASED"}, "binary_release_
/491830904_1616972280119560_6062489186450129507_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMF1RPqtDdwQ7kNvwELDtG5&_nc_oc=Adqb-bxOIPbKZeLbMyVUQ_zFZtOEpefOmtfO-sgbqkOAfjTvsNc6oZrF_DsJoIDncNE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzB6p-uYjx9cr03Iz7WOfj7y92-MMCJcQsFCINa8HrCA&oe=6AD2349C"}]}, "id": "1620033152992022", "locale": "en_US", "screenshots": [{"file_name": "Audio.png", "id": "1635157581735781", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/753032404_1635157585069114_6746883378330263169_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8t48A_e0tAQQ7kNvwHXIk-1&_nc_oc=AdqDwOFelh_K98zbuwaXv2aVyFaLNxr1iFxSA2cRTD4-247O_wxSCTvrQ7g1IAqt4fg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2hwDyhuqRMQoDwnr0TgXjJ29S8X9wlf1-b7E9P_7TMQ&oe=6AD25CB7"}, {"file_name": "Controls.png", "id": "1995572084412378", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596061819_1995572087745711_7710403400178747346_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKvk99d7MfsQ7kNvwGnUww9&_nc_oc=AdofZvtKB1qsoYPj65aalFbxlmzCpR5uWU7RQSoroxf6uxiEO5-EUB2_-BoK5a3HPvU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNG3jwaFjOznIg9QVgqDVYp6jeL37qNgLLvVm_j9H5KHA&oe=6AD23F0C"}, {"file_name": "Position.png", "id": "1511003830835760", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596068480_1511003834169093_5348767387874534395_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1NKjfNhiqEQ7kNvwEpHFo4&_nc_oc=Adoyk37bQlyk-a3TIUCLWXm-LOc22FNDQxW4qp2xs5jCwyntCySHbuVDjtMyjNc-pY0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCwpCE8e3ZtscJXn1knL4cZLjQw1ua1JnnDA-mWz0t8g&oe=6AD22A32"}, {"file_name": "Playback.png", "id": "1783733295999881", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604347072_1783733299333214_4524592481569097329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuZWyuqyr5YQ7kNvwHS0cvm&_nc_oc=AdpScyhxmr4LZ5uNahwwmsIga3bXVAg1KHE-UZ30C-EWN7JXy-I0f-YNv0aRbOhssuI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMva4NsVEWcFY9qenmpCcB2Qjzc_owS_Lir2nGLGDIv_Q&oe=6AD225D2"}, {"file_name": "Picture.png", "id": "2267150527411686", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673645340_2267150530745019_693345360082059666_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7w9K_Uib15kQ7kNvwFb4YCk&_nc_oc=AdqDn-WQg2Te1lj5lgGgVlLFo_Y3oschaDYPQ7A2lfcwGjhZ0VfpVlDNJF8aaQg9mjI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbxITLViJyeLHHzdnpzrZViz9IHwRlESawHQhw1EMszw&oe=6AD24B7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vistalyra", "keywords": ["VR180", "passthrough", "video", "3D", "VR360"], "long_description": "Watch your videos from a seat, a sofa or lying back. Vistalyra is a VR video player for local files and supported direct media streams. Buy once: every feature is included, with no ads or subscription.\n\nPlay 2D movies, 3D side-by-side and over-under videos, VR180, VR360 and equidistant fisheye. Choose flat or curved cinema, full or half stereo, swap eyes or watch one eye in 2D. Filename tags and stereo metadata help select the format automatically. Set the aspect ratio to Auto, 16:9, 21:9 or 4:3. 3D depth requires a stereo video.\n\nHold grip to turn the picture and twist your wrist to straighten a tilted horizon. Use the joystick to seek and zoom; grip plus joystick adjusts flat-screen distance. Let the screen follow your head, recenter with a button, or grab the controls and place them where they suit you. Compact controls stay visible while in use and fade when idle.\n\nSearch and sort your library, save favourites, hide thumbnails and resume where you left off. Choose audio and subtitle tracks, load SRT/WebVTT subtitles, adjust speed and volume, save bookmarks, repeat a video or an A\u2013B segment, and set a sleep timer.\n\nCompatible tagged SBS fisheye-alpha videos automatically use their background mask for passthrough. Green/blue detection and manual green, blue, black or gray keys give you more control.\n\nBring your own videos. Playback depends on your files and headset. DRM, disc images, MVC, MV-HEVC, proprietary lens calibration and SMB/DLNA are unsupported.", "short_description": "A VR video player that fits the way you watch. Play 2D movies, 3D, VR180 and VR360 videos. Position the picture with your controller, straighten tilt, zoom with the joystick and enjoy controls that fade when idle. Subtitles, bookmarks and compatible alpha-video passthrough are included. One purchase, every feature."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raheelswati.github.io/vistalyra-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Extrude Studio", "support_website_url": "https://raheelswati.github.io/vistalyra.html", "website_url": "https://raheelswati.github.io/vistalyra.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055925317266891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830904_1616972280119560_6062489186450129507_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMF1RPqtDdwQ7kNvwELDtG5&_nc_oc=Adqb-bxOIPbKZeLbMyVUQ_zFZtOEpefOmtfO-sgbqkOAfjTvsNc6oZrF_DsJoIDncNE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5be6GDzPiNF-bXu0IFiCG
25", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624656_1577427650736258_4561463332439598231_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Yq3iBhCVgYQ7kNvwGhNCyT&_nc_oc=AdpOvZjnHDvt_OtLqilqyNaegrIeFTQXv9rjl8OMbU0bvZ9QrmpgfnBOEclyobZcOkk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAr6poXOqmMVudgHg9suRyerGg49TmVyyqWw85WVFIEg&oe=6ADF6360"}, {"file_name": "Controls-borderless.png", "id": "1647557036954327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622202_1647557040287660_3418211439441697831_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJQlR0bxzs4Q7kNvwEqAlyN&_nc_oc=Adp9_KrhTyfWKqUvb5-YcKPR3jqBmkcsmfCwLw7IMYvVQIqf6bogFnqWg5dgopV3L7o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAY3VFDtf2UO3I4-nzywA_S-aXKuUJIIh-pfsg_l9FoA&oe=6ADF42B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest-store-trailer-thumbnail.png", "id": "1114629077791119", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830441_1114629081124452_4364447799683608141_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kd7gtc8iqzoQ7kNvwECSQAy&_nc_oc=AdqXMK0vq6GD9bpKhfudTjYYs-5xEioLM5twB07J0NSkiQ-LAwwxSFPM7PeTN7FyRgY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFojS17BkxUtYErBkd_lZ2U1_NWZK7nURBrpGeLQyKdw&oe=6ADF6450"}, "display_name": "Vistalyra", "keywords": ["VR180", "passthrough", "video", "3D", "VR360"], "long_description": "Watch your own videos in VR. Buy once, with no ads or subscription.\n\nPlay 2D, SBS/over-under stereo 3D, VR180, VR360 and equidistant fisheye. Choose flat or Curved cinema, full/half stereo, swap eyes or watch one eye in 2D. 3D depth requires stereo media.\n\nChoose theater/lounge seats or free picture placement in dark space/passthrough. Position and level the view with grip. Seek with the stick; move Curved screens nearer/farther with up/down. Adjust screen size, save per-video settings and aim with pointer dots. Controls fade when idle.\n\nBrowse websites in a persistent window or on the cinema screen. Search Google or enter a website address, type in webpage fields with the standard keyboard, and use nearby playback and library-return controls. Room rotation keeps the page aligned. Website/service support varies; third-party accounts or subscriptions are separate.\n\nBrowse authenticated read-only HTTP/HTTPS WebDAV folders, with Cancel and Retry. Search/sort your library, save favourites, resume positions and bookmarks. Select audio/subtitle tracks, attach SRT/WebVTT, correct picture width/height, adjust speed/volume, repeat a segment or set a sleep timer. Compatible packed-alpha videos and manual color keys support background removal.\n\nBring your own media. Resolution/frame rate depend on file and headset. DRM services, disc images, MVC, MV-HEVC, proprietary lens calibration and SMB/DLNA are unsupported.", "short_description": "Watch your own 2D, 3D and VR180/360 videos in VR. Adjust flat or Curved screens, browse websites with Google search and standard-keyboard typing, and open authenticated read-only WebDAV folders. Subtitles, saved picture settings, bookmarks and compatible alpha-video passthrough are included. Buy once, with no ads or subscription."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raheelswati.github.io/vistalyra-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Extrude Studio", "support_website_url": "https://raheelswati.github.io/vistalyra.html", "website_url": "https://raheelswati.github.io/vistalyra.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommen
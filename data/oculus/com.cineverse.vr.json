 {"nodes": [{"channel_name": "LIVE", "id": "1237605561895886"}]}, "change_log": "\"Improved high-resolution video playback by limiting competing background decoding and thumbnail work. Better MP4 compatibility, clearer Quit controls, larger library and browser views, screen fitting and lighter room interactions. Quest 2 playback, seeking and library controls checked; other devices and long thermal sessions still need validation.\"", "created_date": 1791792008, "id": "1065166359676120", "version": "1.0.1", "version_code": 44, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1055925300600226", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1070037935855629"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1791719073, "id": "1064366193089470", "version": "1.0.1", "version_code": 41, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1055925300600226", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1070037935855629"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1237605561895886"}]}, "change_log": "\"1.0.1: Improved theater and lounge seating, physical seat selection, cinema screen fit, projection menus, zoom controls and UI clarity. Added optional hand visibility, website browsing and network playback opti
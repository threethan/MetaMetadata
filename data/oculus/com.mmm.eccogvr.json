 browser. To attach audio and thumbnail files to video content, insure their names match the video file disregarding the extension, and place them in the same folder.", "short_description": "Man Made Music is a VR spherical video player allowing users to load and play their own 360 videos with ease from the sdcard."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.manmademusic.com/", "developer_terms_of_service_url": "http://www.manmademusic.com/", "publisher_name": "Man Made Music Inc", "support_website_url": null, "website_url": "http://www.manmademusic.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["UTILITY", "NARRATIVE", "PRODUCTIVITY", "MOVIE", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1348740522237145"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1327652177283286"}]}, "baseline_offer": {"id": "1327652177283286"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1496250000, "status": "PUBLISHED", "id": "1327652177283286"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1339669309421022", "version": "0.5"}, "id": "1223578774404922", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1232027913518496", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "i
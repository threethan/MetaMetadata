Pa7pJdhX-InU5OjIK-F41WXrPAKH7OKJebk7LAoghVA&oe=6A008F55"}, {"file_name": "Screen3.png", "id": "764179388347028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75520134_764179391680361_836927880708408671_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFnMK8rU09sQ7kNvwHmvuLk&_nc_oc=AdpGXSKBXCdw3WsFGkffSX5bMt0SMF6bplzQTLjl0HqkTgxtgeDlWxuLNnSHSDR8EMk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qVoVfr_JpRmttTw9iSWqB_eYkxSRkaOEwOR8thqiFGQ&oe=6A008EFC"}, {"file_name": "Screen4.png", "id": "783888029443659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75367594_783888032776992_2460747146712332551_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6IdXmwEMJ0Q7kNvwEC3ylf&_nc_oc=Adr_H6c4alZB1mX-FMqD1dYiyJiY4kNmsbBVPFS0ceCUEuKIc44lOjATPsZECDFyr3Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4roy5r47g4JcFCyKlgKS6l2XHUSthQxJ9WMooyeq1Tgw&oe=6A0085CF"}, {"file_name": "Screen5.png", "id": "739627660821037", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86659800_739627664154370_9042240874013208312_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fa4cTdCcamQQ7kNvwF4uNxv&_nc_oc=Adr6t1RiDQMQZzveUy8Eoknp57QkorLtvDgvcdPMOVkQqb2jABJaJRJJMaWFtZ8nXn0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FFXdtkXkt0-wBa1pUuh3BLrmZVDP2X_N-ZUpTtf61TA&oe=6A007B73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Querformat.png", "id": "2268441033310093", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75392879_2268441039976759_1469796674550560470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aa-B0Dera5UQ7kNvwF9YhGK&_nc_oc=AdpGxd1KkdJ2HYRoyRQaxg1PiT_wNZ8I_hKDba5UxwvO9wXIOmc53XVjM9CvWTRBe74&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6s8JqYPtwd4DAPdfFv4uH_39cMkv5E4k05yUoFH9K29Q&oe=6A0077B6"}, "display_name": "Snowboard Funpark", "keywords": [], "long_description": "Riding a snowborad in virtual reality is fun, but doing tricks on ramps, rails and curbs is addicting.\n\nWith our physics-based approach, we managed to create an experience that every snowboarder will instantly feel familiar with. \nThe board can be oriented by swinging the arms to gain momentum.\nThe orientation of the hands determine the angle relative to the hill, that is used to decide if the board follows a direction or not. \nJust like a real snowboard.\n\nWhen approaching a rail or curb the snowboarder will keep his spinning momentum due to the low friction on the rails or curbs material, the same is true for air-time, what allows you to do spins on rails, curbs or in air-time.\n\nGameplay\n\u2022 Level System (only one level at the moment)\n\u2022 Score System\n\u2022 To-Do-List for each map\n\u2022 Map - \"Mount Pee Pee\"\n\n\u2022 [up coming] Map - \"Ski-Hall\"\n\u2022 [up coming] Map - \"Woods\"\n\u2022 [up coming] Freestyle-Mode\n\u2022 [up coming] Recording & Filming\n\u2022 [up coming] Freestyle-Mode\n\u2022 [up coming] Board Editor", "short_description": "Snowboard Funpark is a virtual reality snowboard experience. Do slides, grinds, spins and more in \"Snowboard Funpark\"."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/snowboardfunpark-privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "YueWorks", "support_website_url": null, "website_url": "https://yue-beifong.jimdosite.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_trackin
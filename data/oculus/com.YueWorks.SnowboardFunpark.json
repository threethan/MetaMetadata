OI_a6kV3f1FVG4plpxQ9wXoCxhv8vCmXIpCPcpuPctw&oe=6AEC8BD5"}, {"file_name": "Screen3.png", "id": "764179388347028", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75520134_764179391680361_836927880708408671_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUCWX9zVhekQ7kNvwH2Qb-B&_nc_oc=AdqqihVneWk7KT1NtxRHQMjZUZiqOu8-L-Q4ljZBdMZzKua7HJhU-hOfm6BTbZF9-Bc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzAr7y8273OP7o5RapHsGLIpgwtDvBz7gGaYdNPQVLYg&oe=6AEC8B7C"}, {"file_name": "Screen4.png", "id": "783888029443659", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75367594_783888032776992_2460747146712332551_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23My0k2oRpcQ7kNvwFGe3hc&_nc_oc=AdoTPBMT1X4AZvMn8vuucy-A-FqrXY-z4JJRx-1E3DF9x_wkQaeoDm1pQFuBMVDASSk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAcIdbxOFJTx5Ize0SJILkc8aHMG2VjtY709MVC8qI_Q&oe=6AECBA8F"}, {"file_name": "Screen5.png", "id": "739627660821037", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86659800_739627664154370_9042240874013208312_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8nK_hZUcnsQ7kNvwHAy8AK&_nc_oc=AdovpGCG8viGWeHs25t_jJPR5MB7kspE5S_c32zq4eCEdzTiIPwBDyRxVY4P4KOdSR8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0JV2POl7lMXFGYnHq6zT9cs_7aAQRz2DQH4iNRvzj9w&oe=6AECB033"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Querformat.png", "id": "2268441033310093", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75392879_2268441039976759_1469796674550560470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGwTxS-sEFYQ7kNvwGgPsXr&_nc_oc=Adp67CWo7ahwlv2A2bXtKNsGGxh2siXDSFhgCBhJKsgFDW-PfyapvyCoj93h13GubLU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRc3ZJ3aLab-J5F0CpoZ0CobI_YpebVa-8UM6d407LYBw&oe=6AECAC76"}, "display_name": "Snowboard Funpark", "keywords": [], "long_description": "Riding a snowborad in virtual reality is fun, but doing tricks on ramps, rails and curbs is addicting.\n\nWith our physics-based approach, we managed to create an experience that every snowboarder will instantly feel familiar with. \nThe board can be oriented by swinging the arms to gain momentum.\nThe orientation of the hands determine the angle relative to the hill, that is used to decide if the board follows a direction or not. \nJust like a real snowboard.\n\nWhen approaching a rail or curb the snowboarder will keep his spinning momentum due to the low friction on the rails or curbs material, the same is true for air-time, what allows you to do spins on rails, curbs or in air-time.\n\nGameplay\n\u2022 Level System (only one level at the moment)\n\u2022 Score System\n\u2022 To-Do-List for each map\n\u2022 Map - \"Mount Pee Pee\"\n\n\u2022 [up coming] Map - \"Ski-Hall\"\n\u2022 [up coming] Map - \"Woods\"\n\u2022 [up coming] Freestyle-Mode\n\u2022 [up coming] Recording & Filming\n\u2022 [up coming] Freestyle-Mode\n\u2022 [up coming] Board Editor", "short_description": "Snowboard Funpark is a virtual reality snowboard experience. Do slides, grinds, spins and more in \"Snowboard Funpark\"."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/snowboardfunpark-privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "YueWorks", "support_website_url": null, "website_url": "https://yue-beifong.jimdosite.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_trackin
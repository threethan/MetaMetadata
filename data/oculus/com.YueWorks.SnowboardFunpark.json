f9EaHAJ0XpEUNPS_aJi0a_MuaPhioWpdDeEnNLBIQWQ&oe=6AAD43D5"}, {"file_name": "Screen3.png", "id": "764179388347028", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75520134_764179391680361_836927880708408671_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2SZ5V8NvT4Q7kNvwHP0GSK&_nc_oc=AdpflT3H2ikKEezoPeSMOo0KkMtGRC2_JyBuWoc2vjFkxULGlOvpoaTneJicT4hZ350&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLM2Lo6JxolvKe4ikc40pQjyWtXxsT6rlY2bne27eCc8A&oe=6AAD437C"}, {"file_name": "Screen4.png", "id": "783888029443659", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75367594_783888032776992_2460747146712332551_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfOxLTv71rAQ7kNvwHngDJl&_nc_oc=Adrj_eRaBBEfZs5z3Yy_WpGtY4aKid6NRhwf9j5cjW5eo7UVBuJY3RJa_iFw0qYyAVk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxrfxqDXCajt9oQDF5_UCUrmITOSg_adF68EMcoIz-cg&oe=6AAD3A4F"}, {"file_name": "Screen5.png", "id": "739627660821037", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86659800_739627664154370_9042240874013208312_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLVA51fN07MQ7kNvwFNRjgS&_nc_oc=Adp37ydBGavcc3Tneko5yFW-lR_zaRHeJu1SWZJ_Dotu6Rd00oitWdDwUrVXumClSls&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEotvap3x3lPau6s-_etBe7RxPbZH25P_7dITc4tmZbg&oe=6AAD2FF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Querformat.png", "id": "2268441033310093", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75392879_2268441039976759_1469796674550560470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyeilMsKlpIQ7kNvwEcUPfd&_nc_oc=AdoWUXchZY_6WWrgpaOQvfSMtm6XFMQqj5GctzvCFnSHv56VQau_YM2GBFPUjgXP0ZA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgUgtmlrS1x77yU4mJmxt5-R05fJAJkSSQE7kZoby6gQ&oe=6AAD2C36"}, "display_name": "Snowboard Funpark", "keywords": [], "long_description": "Riding a snowborad in virtual reality is fun, but doing tricks on ramps, rails and curbs is addicting.\n\nWith our physics-based approach, we managed to create an experience that every snowboarder will instantly feel familiar with. \nThe board can be oriented by swinging the arms to gain momentum.\nThe orientation of the hands determine the angle relative to the hill, that is used to decide if the board follows a direction or not. \nJust like a real snowboard.\n\nWhen approaching a rail or curb the snowboarder will keep his spinning momentum due to the low friction on the rails or curbs material, the same is true for air-time, what allows you to do spins on rails, curbs or in air-time.\n\nGameplay\n\u2022 Level System (only one level at the moment)\n\u2022 Score System\n\u2022 To-Do-List for each map\n\u2022 Map - \"Mount Pee Pee\"\n\n\u2022 [up coming] Map - \"Ski-Hall\"\n\u2022 [up coming] Map - \"Woods\"\n\u2022 [up coming] Freestyle-Mode\n\u2022 [up coming] Recording & Filming\n\u2022 [up coming] Freestyle-Mode\n\u2022 [up coming] Board Editor", "short_description": "Snowboard Funpark is a virtual reality snowboard experience. Do slides, grinds, spins and more in \"Snowboard Funpark\"."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/snowboardfunpark-privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "YueWorks", "support_website_url": null, "website_url": "https://yue-beifong.jimdosite.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_trackin
c_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvw7v1HMonIIiioNLTJDeZI5hktSjjN-7GPpDAA81EW6A&oe=69A6C865"}, {"file_name": "Screen2.png", "id": "3790640827828489", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003282_3790640831161822_8129658188914418857_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LIUhKgbzQgQ7kNvwEnuQcH&_nc_oc=AdlBbLlhACSMP-K6YaKTtMPx1PisnbHEy0EUNwJD3LTkbQb5wjIGic_ddBiOJctrTF8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftjXpYGc4CmPQrA0BTmgnoCfIVOb4DjLwuQp0hkIuHlsA&oe=69A6E955"}, {"file_name": "Screen3.png", "id": "764179388347028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75520134_764179391680361_836927880708408671_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQwOP5vZry0Q7kNvwH9TSK1&_nc_oc=AdlqIm0DWyhzRIaZMlYDYJg2kv51TyrQd4a78MUWasNJ9Z1qbR0BEaHqheGrL2HG49A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvy5ryy-OU3JZzHv24882jTJmxSYJYJ5qV4O5ldlbxgBQ&oe=69A6E8FC"}, {"file_name": "Screen4.png", "id": "783888029443659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75367594_783888032776992_2460747146712332551_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xJE1aVpBBYQ7kNvwHXbN-Z&_nc_oc=AdlzjJdUhkjRLbWYKcykzvIaq5Sb0Swb39e-NeihSpKI8p4npnN3SM_bkqz67CC55Z8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftDShUK9V-wkYd4TnpD8OiNpBfa8BtFeqa8X8J3uUeWNg&oe=69A6DFCF"}, {"file_name": "Screen5.png", "id": "739627660821037", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86659800_739627664154370_9042240874013208312_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBZYWT5P-hIQ7kNvwGNgAqH&_nc_oc=AdkWQ5Kducc7FFgYmGt3FVPT5Le18_8dyEAnvuR-1zgHRTQrvKtWZnvb5vhNqD5APUc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftHyEaKXH0baqlQ6ClfoW6pdt2MHtrWCKv42q7DnYS4hg&oe=69A6D573"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Querformat.png", "id": "2268441033310093", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392879_2268441039976759_1469796674550560470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y10DkNZ23k4Q7kNvwEl50qA&_nc_oc=AdluU-4TUgNGxVB4XrsyJKBKmhE8MsgUm84KVu0-iQsoMmnwrfgo-EaRmSAa6tqZJBs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfviPESnNPAW38soAWEqGXS-ZJ_dpAuy2KBZKLmV1uGTpQ&oe=69A6D1B6"}, "display_name": "Snowboard Funpark", "keywords": [], "long_description": "Riding a snowborad in virtual reality is fun, but doing tricks on ramps, rails and curbs is addicting.\n\nWith our physics-based approach, we managed to create an experience that every snowboarder will instantly feel familiar with. \nThe board can be oriented by swinging the arms to gain momentum.\nThe orientation of the hands determine the angle relative to the hill, that is used to decide if the board follows a direction or not. \nJust like a real snowboard.\n\nWhen approaching a rail or curb the snowboarder will keep his spinning momentum due to the low friction on the rails or curbs material, the same is true for air-time, what allows you to do spins on rails, curbs or in air-time.\n\nGameplay\n\u2022 Level System (only one level at the moment)\n\u2022 Score System\n\u2022 To-Do-List for each map\n\u2022 Map - \"Mount Pee Pee\"\n\u2022 Map - \"Ski-Hall\"\n\u2022 Map - \"City Spot\"\n\u2022 Freestyle-Mode\n\u2022 Recording and Reviewing\n\u2022 Board Editor\n\n\u2022 [upcoming] Mini Challenges", "short_description": "Snowboard Funpark is a virtual reality snowboard experience. Do slides, grinds, spins and more in \"Snowboard Funpark\"."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/snowboardfunpark-privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "YueWorks", "support_website_url": null, "website_url": "https://yue-beifong.jimdosite.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscriptio
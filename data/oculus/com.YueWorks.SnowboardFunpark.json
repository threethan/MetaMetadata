c_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftwjfEvunLk6dRxTF2nmRA8VnGb8L6BDJylfmYOU_3utg&oe=699D8DE5"}, {"file_name": "Screen2.png", "id": "3790640827828489", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003282_3790640831161822_8129658188914418857_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNSze8Hkvv4Q7kNvwG07qLg&_nc_oc=Adm6fOulaQ9LD_s6SAfcQxHlM2cPL8Tv0Yj9jrwl4sHCWBrWWXaBF3LvZuAI9NkdIXo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afti5Ya7-WFWeKgDU6LL4GIT1TFIToPg-vOR4E0Ot79gbg&oe=699DAED5"}, {"file_name": "Screen3.png", "id": "764179388347028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75520134_764179391680361_836927880708408671_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJbJ9Y0ObVcQ7kNvwE3Yw8J&_nc_oc=AdnSuqHHHc-w7yJKb5DV9I0yoyPGOAjBeyobB25qEHQAKxpDts_uvhy1gzU8LBqd5Oc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftYr4VIiEjbD3EM-akD9WeC9gsrAcJkWyAmSR2f9EP5UA&oe=699DAE7C"}, {"file_name": "Screen4.png", "id": "783888029443659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75367594_783888032776992_2460747146712332551_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Psytreim2PsQ7kNvwGyNFFx&_nc_oc=AdlYAbDVd_rsDvW5_qEuqVp2skCks2hGX_miFcI4gX_SDyJaCd3sYdaJcvDY5vGXFqs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfviksQ2ht73qAM0ze1rFzHKpKBQ_HHjd4mbXoexTXCINw&oe=699DA54F"}, {"file_name": "Screen5.png", "id": "739627660821037", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86659800_739627664154370_9042240874013208312_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUg3MwgTWIMQ7kNvwGfdxyN&_nc_oc=AdkgUD15uvHMf7Q8b1KftNNKflEkgH-bQH80goJzWAP63nGePF6eo8lp0G_VCSPBNzA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvrybK5ZjXz_eZuws9kIn56ULm6dsuRccQPKb279_7nbw&oe=699D9AF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Querformat.png", "id": "2268441033310093", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392879_2268441039976759_1469796674550560470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FNDwHVQGJsQ7kNvwHcC1SN&_nc_oc=Adllq_1WZNpIfgacgDEMhjPhJVbvqvKuuINNTWh1br0fPH7EWuk3b2J35-5LDwBvQQw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu73tB0oLN0kNfa6yfc-DVlB3_g_E3rr9seZK1EGiLIpA&oe=699D9736"}, "display_name": "Snowboard Funpark", "keywords": [], "long_description": "Riding a snowborad in virtual reality is fun, but doing tricks on ramps, rails and curbs is addicting.\n\nWith our physics-based approach, we managed to create an experience that every snowboarder will instantly feel familiar with. \nThe board can be oriented by swinging the arms to gain momentum.\nThe orientation of the hands determine the angle relative to the hill, that is used to decide if the board follows a direction or not. \nJust like a real snowboard.\n\nWhen approaching a rail or curb the snowboarder will keep his spinning momentum due to the low friction on the rails or curbs material, the same is true for air-time, what allows you to do spins on rails, curbs or in air-time.\n\nGameplay\n\u2022 Level System (only one level at the moment)\n\u2022 Score System\n\u2022 To-Do-List for each map\n\u2022 Map - \"Mount Pee Pee\"\n\u2022 Map - \"Ski-Hall\"\n\u2022 Map - \"City Spot\"\n\u2022 Freestyle-Mode\n\u2022 Recording and Reviewing\n\u2022 Board Editor\n\n\u2022 [upcoming] Mini Challenges", "short_description": "Snowboard Funpark is a virtual reality snowboard experience. Do slides, grinds, spins and more in \"Snowboard Funpark\"."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/snowboardfunpark-privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "YueWorks", "support_website_url": null, "website_url": "https://yue-beifong.jimdosite.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscriptio
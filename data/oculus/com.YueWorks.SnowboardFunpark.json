hcOCGxAjr8SgoEqehrGIkP0EJt4HhNgDv8dW3SieB9A&oe=6A203355"}, {"file_name": "Screen3.png", "id": "764179388347028", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75520134_764179391680361_836927880708408671_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DsKnW7ypSoQ7kNvwFQb2f3&_nc_oc=Adr86J3eCv12loSgYf2102yEYyNat2sxm-ogZMnYTJIaH--g7FnOdI2GHSXnt1gsz8I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_rhcDsp1ubnQPtDt2oXXwqvPNpPIX8Ogkwcb9ROV1dw&oe=6A2032FC"}, {"file_name": "Screen4.png", "id": "783888029443659", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75367594_783888032776992_2460747146712332551_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbXpRq07BlYQ7kNvwGbeS4k&_nc_oc=AdpSQjdIk68i0UQQZrZS1JcTeBQ60cv_BAhIJ3oJta3b4ntx8d7gDFc8kk3vuqGuMyQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53Ee89bm_g1_p2w88YqNYp_4Fn5XEPuPf0kEbACshBXA&oe=6A2029CF"}, {"file_name": "Screen5.png", "id": "739627660821037", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86659800_739627664154370_9042240874013208312_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ts5HmFtaGwQ7kNvwEzuxJu&_nc_oc=Ado2VxAQHHtrgrWs9fQa8A7SGf7GplpYiAx47dMEa-_WdpFIo4ebPdrcUEJ_WW08t_0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jvPahlHbj-kSB-8vSui4GWTZ6NzHQDcwMOj0lneINGA&oe=6A201F73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Querformat.png", "id": "2268441033310093", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75392879_2268441039976759_1469796674550560470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69e5JXLL7NYQ7kNvwHib2H-&_nc_oc=AdrqZSJk31xtu2X_lIS-p3_Klmo61YSXeNN9DQoB97066fkh2K8QnKlFR0vd0SECkg0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X88Tq8GfgK17QXUbXKIixcPPIaeavHgbtYWyhbtWWZw&oe=6A201BB6"}, "display_name": "Snowboard Funpark", "keywords": [], "long_description": "Riding a snowborad in virtual reality is fun, but doing tricks on ramps, rails and curbs is addicting.\n\nWith our physics-based approach, we managed to create an experience that every snowboarder will instantly feel familiar with. \nThe board can be oriented by swinging the arms to gain momentum.\nThe orientation of the hands determine the angle relative to the hill, that is used to decide if the board follows a direction or not. \nJust like a real snowboard.\n\nWhen approaching a rail or curb the snowboarder will keep his spinning momentum due to the low friction on the rails or curbs material, the same is true for air-time, what allows you to do spins on rails, curbs or in air-time.\n\nGameplay\n\u2022 Level System (only one level at the moment)\n\u2022 Score System\n\u2022 To-Do-List for each map\n\u2022 Map - \"Mount Pee Pee\"\n\n\u2022 [up coming] Map - \"Ski-Hall\"\n\u2022 [up coming] Map - \"Woods\"\n\u2022 [up coming] Freestyle-Mode\n\u2022 [up coming] Recording & Filming\n\u2022 [up coming] Freestyle-Mode\n\u2022 [up coming] Board Editor", "short_description": "Snowboard Funpark is a virtual reality snowboard experience. Do slides, grinds, spins and more in \"Snowboard Funpark\"."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/snowboardfunpark-privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "YueWorks", "support_website_url": null, "website_url": "https://yue-beifong.jimdosite.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_trackin
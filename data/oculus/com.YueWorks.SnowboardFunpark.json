0f&oh=00_AQLQ_3zDD2ZXby2s3I-4mWQi4YpZScgiwBIFbqysBt08aA&oe=6AA94F55"}, {"file_name": "Screen3.png", "id": "764179388347028", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75520134_764179391680361_836927880708408671_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7ZlMIOmEmgQ7kNvwHp4xte&_nc_oc=AdoiS2aZ5i0s7IpNA5tCpusq65vLyjpTzOl4MHOgLNd7P6_TM7H8cTjygv7Ow7VPbzg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4jOJD-dmkoRTrz-odQ9rP4JvpSiiMqGfhkprbIvZ64w&oe=6AA94EFC"}, {"file_name": "Screen4.png", "id": "783888029443659", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75367594_783888032776992_2460747146712332551_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZbCnIVMzE4Q7kNvwFFoGUa&_nc_oc=AdpHJT3q-pJtmJMtLEr8ke54MIWPPgXGPJP3u9d_PU0qIRbiyj-4Gn11L-lwxqc15E8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKm1-uwTCWDAIE3hZvmaUFZx9cqqUepZnCrZoml8VqYw&oe=6AA945CF"}, {"file_name": "Screen5.png", "id": "739627660821037", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/86659800_739627664154370_9042240874013208312_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vl9UUTXRVuEQ7kNvwGvbbDB&_nc_oc=AdoQKzVYzI3HolJp8JThQsfzymuCGeLSEwymPCN_PqPOKXRceAn163czXRvfU2_PYcE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkPasfyt92PlOK3P0l3sz_8Baoz0wGQSxo7adZJHtdhw&oe=6AA93B73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Querformat.png", "id": "2268441033310093", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75392879_2268441039976759_1469796674550560470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NBYWnX8xB4Q7kNvwHmQLve&_nc_oc=AdqHdYMNwjSAZ5iGKOQ6EYOHHFL0-94wkI5RzAIM1pz58j1l8L350jxDvSzhiwvZW70&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3Js72An32GvRkN5nqzs_xA5Ey0F8oCgtKVu1TEzKF2g&oe=6AA937B6"}, "display_name": "Snowboard Funpark", "keywords": [], "long_description": "Riding a snowborad in virtual reality is fun, but doing tricks on ramps, rails and curbs is addicting.\n\nWith our physics-based approach, we managed to create an experience that every snowboarder will instantly feel familiar with. \nThe board can be oriented by swinging the arms to gain momentum.\nThe orientation of the hands determine the angle relative to the hill, that is used to decide if the board follows a direction or not. \nJust like a real snowboard.\n\nWhen approaching a rail or curb the snowboarder will keep his spinning momentum due to the low friction on the rails or curbs material, the same is true for air-time, what allows you to do spins on rails, curbs or in air-time.\n\nGameplay\n\u2022 Level System (only one level at the moment)\n\u2022 Score System\n\u2022 To-Do-List for each map\n\u2022 Map - \"Mount Pee Pee\"\n\n\u2022 [up coming] Map - \"Ski-Hall\"\n\u2022 [up coming] Map - \"Woods\"\n\u2022 [up coming] Freestyle-Mode\n\u2022 [up coming] Recording & Filming\n\u2022 [up coming] Freestyle-Mode\n\u2022 [up coming] Board Editor", "short_description": "Snowboard Funpark is a virtual reality snowboard experience. Do slides, grinds, spins and more in \"Snowboard Funpark\"."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/snowboardfunpark-privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "YueWorks", "support_website_url": null, "website_url": "https://yue-beifong.jimdosite.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "s
c_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftq4DigDpKShXgm6Ok-FwuO3vdVYHTE3EqVYPJWZy2QnQ&oe=699EDF65"}, {"file_name": "Screen2.png", "id": "3790640827828489", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003282_3790640831161822_8129658188914418857_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNSze8Hkvv4Q7kNvwHcjRdi&_nc_oc=Adn2Ncty_kQvDade7cAMZ5ng8IzopYs00tZkyII4DnrXaat0pXylHmFdi36X0RlRR0Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvPBNsEOuvqlah_FPZCz5CKBcWZTartRwyLLb4m0IEc7Q&oe=699F0055"}, {"file_name": "Screen3.png", "id": "764179388347028", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75520134_764179391680361_836927880708408671_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJbJ9Y0ObVcQ7kNvwHXDCft&_nc_oc=AdmSlfWYacIg7TYYv-i9tD6dUSsrRgtS0TN8Us2G4kr9H3O3V3ibO2Gb1E8NHRbvnEw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsjoxvat4VyNsg3ReNBXZo2Uuol1Dj2vc6LV0IiEngTcQ&oe=699EFFFC"}, {"file_name": "Screen4.png", "id": "783888029443659", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75367594_783888032776992_2460747146712332551_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Psytreim2PsQ7kNvwFV_2zg&_nc_oc=Admw3avzjj-p9-dsohVUegPOZ5PkftTl9iRFiNWs-t0UmKqkA0i5KT5f-Gk10ZZFsYw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftBB7yjdhrFk1mKTJP2muI1x33DRsioOWIOvsWVAG2zlg&oe=699EF6CF"}, {"file_name": "Screen5.png", "id": "739627660821037", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86659800_739627664154370_9042240874013208312_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUg3MwgTWIMQ7kNvwGOXRvb&_nc_oc=AdmBXUF9byNJjDqKRx9sFz2nTMuRCrnMaYSxO34KzYAHPmcEwtKLfby6NFcrcjHB3Yw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftyOB8GrlA5XAWvmfyCqgU0mo5mtiGSjDEgPwImSEGQxQ&oe=699EEC73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Querformat.png", "id": "2268441033310093", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75392879_2268441039976759_1469796674550560470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FNDwHVQGJsQ7kNvwGZIpjr&_nc_oc=AdlsMxKF0lSM9y3qbQV_sbIDUIPbvBN5mGebFX4Wy2ZCcTg4Rs0PxE5r-7vOCdReGjY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvQPRtCIpuWGFCXzIdTEIWqctAa5nsMpfJWY0vk_L6uDw&oe=699EE8B6"}, "display_name": "Snowboard Funpark", "keywords": [], "long_description": "Riding a snowborad in virtual reality is fun, but doing tricks on ramps, rails and curbs is addicting.\n\nWith our physics-based approach, we managed to create an experience that every snowboarder will instantly feel familiar with. \nThe board can be oriented by swinging the arms to gain momentum.\nThe orientation of the hands determine the angle relative to the hill, that is used to decide if the board follows a direction or not. \nJust like a real snowboard.\n\nWhen approaching a rail or curb the snowboarder will keep his spinning momentum due to the low friction on the rails or curbs material, the same is true for air-time, what allows you to do spins on rails, curbs or in air-time.\n\nGameplay\n\u2022 Level System (only one level at the moment)\n\u2022 Score System\n\u2022 To-Do-List for each map\n\u2022 Map - \"Mount Pee Pee\"\n\u2022 Map - \"Ski-Hall\"\n\u2022 Map - \"City Spot\"\n\u2022 Freestyle-Mode\n\u2022 Recording and Reviewing\n\u2022 Board Editor\n\n\u2022 [upcoming] Mini Challenges", "short_description": "Snowboard Funpark is a virtual reality snowboard experience. Do slides, grinds, spins and more in \"Snowboard Funpark\"."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/snowboardfunpark-privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "YueWorks", "support_website_url": null, "website_url": "https://yue-beifong.jimdosite.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscriptio
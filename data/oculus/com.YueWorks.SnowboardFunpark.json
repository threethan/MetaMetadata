iRiCJsI5hh7VIEmf7wvbV8SjbXV_F71yibmLqbNCAoA&oe=69D26AD5"}, {"file_name": "Screen3.png", "id": "764179388347028", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75520134_764179391680361_836927880708408671_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pc1OWkc1igQ7kNvwG5al6x&_nc_oc=AdpjZvbBdETrOnnWZHC8LUOpHQl5KX1ZRKAGYZQOR4m5gOpoRxa1YzyBqfc-nTEfdM4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3n9Hjl81xqhgbzOe8vM0cxHGknYy2zSp7I86PTlQTepg&oe=69D26A7C"}, {"file_name": "Screen4.png", "id": "783888029443659", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75367594_783888032776992_2460747146712332551_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqLo37ezujoQ7kNvwGLxtMv&_nc_oc=AdpMBpVX2U1UnS1I_H7w1h7XHn0o8nqRyZhRBCAdRhvD9yrAC8V6cv-RQ2RdAm3hSeY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LuGHGnHYJf9A8ihfA3rXvYSuiSNtXqmv0IzJVsmwMLg&oe=69D2614F"}, {"file_name": "Screen5.png", "id": "739627660821037", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86659800_739627664154370_9042240874013208312_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDMJxcETtDYQ7kNvwEFnoIc&_nc_oc=AdrkTBEwm-eOEd_3A0of5LaVlhqMZ-wwceDOhzSwsrCIXyU36hIt5oJidSzNNS8r2Qo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1p4zfJvgxrpQNqlf80L4qDoE_vIM8BNAr_0d98Iy6LXA&oe=69D256F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Querformat.png", "id": "2268441033310093", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75392879_2268441039976759_1469796674550560470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykTpQUeBSn0Q7kNvwG0HD54&_nc_oc=AdqZvU7NZMSyqCySvA49bstuTOBsB45Gc--C5eUERr5T7Bi_d7yrFtlrnQiJysf_CmY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zJppsNTag-0afhtnOT-P_C46vT9RE24ZpOVLwBTStHg&oe=69D25336"}, "display_name": "Snowboard Funpark", "keywords": [], "long_description": "Riding a snowborad in virtual reality is fun, but doing tricks on ramps, rails and curbs is addicting.\n\nWith our physics-based approach, we managed to create an experience that every snowboarder will instantly feel familiar with. \nThe board can be oriented by swinging the arms to gain momentum.\nThe orientation of the hands determine the angle relative to the hill, that is used to decide if the board follows a direction or not. \nJust like a real snowboard.\n\nWhen approaching a rail or curb the snowboarder will keep his spinning momentum due to the low friction on the rails or curbs material, the same is true for air-time, what allows you to do spins on rails, curbs or in air-time.\n\nGameplay\n\u2022 Level System (only one level at the moment)\n\u2022 Score System\n\u2022 To-Do-List for each map\n\u2022 Map - \"Mount Pee Pee\"\n\n\u2022 [up coming] Map - \"Ski-Hall\"\n\u2022 [up coming] Map - \"Woods\"\n\u2022 [up coming] Freestyle-Mode\n\u2022 [up coming] Recording & Filming\n\u2022 [up coming] Freestyle-Mode\n\u2022 [up coming] Board Editor", "short_description": "Snowboard Funpark is a virtual reality snowboard experience. Do slides, grinds, spins and more in \"Snowboard Funpark\"."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/snowboardfunpark-privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "YueWorks", "support_website_url": null, "website_url": "https://yue-beifong.jimdosite.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_trackin
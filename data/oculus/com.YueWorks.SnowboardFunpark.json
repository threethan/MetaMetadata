0f&oh=00_AQKGOxRy1nuziuJVnuN6pmPjfTwT2Qpx-XNRSG-RpacO-Q&oe=6AAE9555"}, {"file_name": "Screen3.png", "id": "764179388347028", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75520134_764179391680361_836927880708408671_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2SZ5V8NvT4Q7kNvwGB-o4z&_nc_oc=AdoBRe-0QWv-JWvYkJjOKvl0Z7yE9bQYAi0xB2JJPbhag_EWDSdjjo3QhQqV5t948zQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInTZFNrgMaFQsUjIVM9O_MKng4bqWYnO6T5sYfZ_SreA&oe=6AAE94FC"}, {"file_name": "Screen4.png", "id": "783888029443659", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75367594_783888032776992_2460747146712332551_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfOxLTv71rAQ7kNvwFPG7jo&_nc_oc=AdolCqwh-DsDRTb9sSwE86QFFs9_Gj_Z2fRXOcPBR3BCL4vz_Eo8c8tvdMBC0h1iVTE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLV40bwoiDnx0Mc6VLqoqH32GpbxhIie9Bp5Y_P8RT8OA&oe=6AAE8BCF"}, {"file_name": "Screen5.png", "id": "739627660821037", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/86659800_739627664154370_9042240874013208312_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLVA51fN07MQ7kNvwFbNZx3&_nc_oc=AdpFUEhvVxDF6NImCuB1tSDSOoT1Lm6HnwpidMJ8zw8fKRrvMf91FK4O4PPBiEVhWiU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6tAG29ZEbznAeOLaEhy7H5Kc4fJBxir2O4-i5EUe5bQ&oe=6AAE8173"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Querformat.png", "id": "2268441033310093", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75392879_2268441039976759_1469796674550560470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyeilMsKlpIQ7kNvwEz4HQo&_nc_oc=AdrLgdPYQmI5sVt9SDaDU1xU83miP9WLi84UPzoFOcM9vXmAfqRb8N2Qkucml31-snY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEhZ0Rmc0tPM5xhGKd3XxwgYg4dtWtCVvoAhhwm4CqdA&oe=6AAE7DB6"}, "display_name": "Snowboard Funpark", "keywords": [], "long_description": "Riding a snowborad in virtual reality is fun, but doing tricks on ramps, rails and curbs is addicting.\n\nWith our physics-based approach, we managed to create an experience that every snowboarder will instantly feel familiar with. \nThe board can be oriented by swinging the arms to gain momentum.\nThe orientation of the hands determine the angle relative to the hill, that is used to decide if the board follows a direction or not. \nJust like a real snowboard.\n\nWhen approaching a rail or curb the snowboarder will keep his spinning momentum due to the low friction on the rails or curbs material, the same is true for air-time, what allows you to do spins on rails, curbs or in air-time.\n\nGameplay\n\u2022 Level System (only one level at the moment)\n\u2022 Score System\n\u2022 To-Do-List for each map\n\u2022 Map - \"Mount Pee Pee\"\n\n\u2022 [up coming] Map - \"Ski-Hall\"\n\u2022 [up coming] Map - \"Woods\"\n\u2022 [up coming] Freestyle-Mode\n\u2022 [up coming] Recording & Filming\n\u2022 [up coming] Freestyle-Mode\n\u2022 [up coming] Board Editor", "short_description": "Snowboard Funpark is a virtual reality snowboard experience. Do slides, grinds, spins and more in \"Snowboard Funpark\"."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/snowboardfunpark-privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "YueWorks", "support_website_url": null, "website_url": "https://yue-beifong.jimdosite.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "s
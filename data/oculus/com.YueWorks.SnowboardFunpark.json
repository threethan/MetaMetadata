0f&oh=00_Af-lcOQ_gnxpKM7ZwEDbYPkc_8B_pco8I7aLvU-1Lnq0YA&oe=6A22D655"}, {"file_name": "Screen3.png", "id": "764179388347028", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75520134_764179391680361_836927880708408671_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p412_hiw-acQ7kNvwFvLoJr&_nc_oc=AdoyFse9YvCy-xO8oys5WMRLsdE4I-NP6p1ba96JF8UbyapfbK3OAJjclPlnW6Fd-dY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8coT0qMedX7o7AF5dMMNB1Zxo7ipD1knMGl57V-Ro-uA&oe=6A22D5FC"}, {"file_name": "Screen4.png", "id": "783888029443659", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75367594_783888032776992_2460747146712332551_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAEvijebntsQ7kNvwG8bhSL&_nc_oc=AdqHgX70_LRtP_-Mz2zGw4gH6bKcT90aJXI-YOHiM-U6_b2sVCibZGCaxB5ncikmeiQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8k2fyf14Ygd6N44CdgKFZ48jQKzx1Az4Eqe68s5tG-4g&oe=6A23050F"}, {"file_name": "Screen5.png", "id": "739627660821037", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/86659800_739627664154370_9042240874013208312_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPuRV4X6G8sQ7kNvwFI4HFI&_nc_oc=AdqpbLX6HbqM0CfszD3rrFNS-IV8CWrpLflv6Ss_UgE1t_2o_C3s10n2Rk1USb8DcAw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95uJuinYVIcXQt3s0CwPtFRcI_De_sGntVuFyyp9szSw&oe=6A22FAB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Querformat.png", "id": "2268441033310093", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75392879_2268441039976759_1469796674550560470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3E39uvr0OgMQ7kNvwFj-6cO&_nc_oc=AdrI91X86J4lh4mwttbhfi05ZB0fcIN8O4XAasEq0GKnIMe_tl03bfV6wFIXnlp1Fik&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XPx3mc8bBwUse6Yz0837ViVicneHBy9EMArIuEeFjqg&oe=6A22F6F6"}, "display_name": "Snowboard Funpark", "keywords": [], "long_description": "Riding a snowborad in virtual reality is fun, but doing tricks on ramps, rails and curbs is addicting.\n\nWith our physics-based approach, we managed to create an experience that every snowboarder will instantly feel familiar with. \nThe board can be oriented by swinging the arms to gain momentum.\nThe orientation of the hands determine the angle relative to the hill, that is used to decide if the board follows a direction or not. \nJust like a real snowboard.\n\nWhen approaching a rail or curb the snowboarder will keep his spinning momentum due to the low friction on the rails or curbs material, the same is true for air-time, what allows you to do spins on rails, curbs or in air-time.\n\nGameplay\n\u2022 Level System (only one level at the moment)\n\u2022 Score System\n\u2022 To-Do-List for each map\n\u2022 Map - \"Mount Pee Pee\"\n\n\u2022 [up coming] Map - \"Ski-Hall\"\n\u2022 [up coming] Map - \"Woods\"\n\u2022 [up coming] Freestyle-Mode\n\u2022 [up coming] Recording & Filming\n\u2022 [up coming] Freestyle-Mode\n\u2022 [up coming] Board Editor", "short_description": "Snowboard Funpark is a virtual reality snowboard experience. Do slides, grinds, spins and more in \"Snowboard Funpark\"."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/snowboardfunpark-privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "YueWorks", "support_website_url": null, "website_url": "https://yue-beifong.jimdosite.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "s
JsETuF28gKhXeyX_FFc2caH6vbmPWCBDK_aMPZ0DC7g&oe=69E0EB55"}, {"file_name": "Screen3.png", "id": "764179388347028", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75520134_764179391680361_836927880708408671_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdZrle2kP1MQ7kNvwEd5RAd&_nc_oc=AdrejTmqLdvG0qp_rZQZD7xJo55ncRNYst6j_ppu9SEjzXcvO6Wr9CTfek28mUAC-yA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-wquE0wT2tkRzBBBd4xOBuUjNOpM8A606PSy368jFng&oe=69E0EAFC"}, {"file_name": "Screen4.png", "id": "783888029443659", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75367594_783888032776992_2460747146712332551_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=At6NpqZKMQ8Q7kNvwF8xqPz&_nc_oc=Adrj9TQyHfkF72rYD0jPBKz7DoM0gVbLR-vn-aCHOwvMeco8ebx3fXnMr591BxCgqNI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XRFwL0nk3k6uy_9YDkoqMjsmjIjFHv4EngRm2DbIDMQ&oe=69E0E1CF"}, {"file_name": "Screen5.png", "id": "739627660821037", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86659800_739627664154370_9042240874013208312_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6y71hL2BQYQ7kNvwGNrpTj&_nc_oc=AdoEULjILDJPTpEUv95JUDtbBRAdLM6F0lY7s3NBkPscnpfnts0_6ZcBkXxOtGeXhms&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lo4McCvlLLp6xD5wMXtG4wWx93_mwWkO2HDHfrrYEeA&oe=69E0D773"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Querformat.png", "id": "2268441033310093", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75392879_2268441039976759_1469796674550560470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YH5GrPhc4OEQ7kNvwGbNB8n&_nc_oc=Adpxn_XJ5llKL39TugxxPNsjdTMoHOjvS_6bJNZAd0orrHpg9xOunQWAU7rnGFG_lMo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kbaET8g-D9c6cnZBz3sBS1bc1oXlZxHIQ2B_1my8qMA&oe=69E0D3B6"}, "display_name": "Snowboard Funpark", "keywords": [], "long_description": "Riding a snowborad in virtual reality is fun, but doing tricks on ramps, rails and curbs is addicting.\n\nWith our physics-based approach, we managed to create an experience that every snowboarder will instantly feel familiar with. \nThe board can be oriented by swinging the arms to gain momentum.\nThe orientation of the hands determine the angle relative to the hill, that is used to decide if the board follows a direction or not. \nJust like a real snowboard.\n\nWhen approaching a rail or curb the snowboarder will keep his spinning momentum due to the low friction on the rails or curbs material, the same is true for air-time, what allows you to do spins on rails, curbs or in air-time.\n\nGameplay\n\u2022 Level System (only one level at the moment)\n\u2022 Score System\n\u2022 To-Do-List for each map\n\u2022 Map - \"Mount Pee Pee\"\n\n\u2022 [up coming] Map - \"Ski-Hall\"\n\u2022 [up coming] Map - \"Woods\"\n\u2022 [up coming] Freestyle-Mode\n\u2022 [up coming] Recording & Filming\n\u2022 [up coming] Freestyle-Mode\n\u2022 [up coming] Board Editor", "short_description": "Snowboard Funpark is a virtual reality snowboard experience. Do slides, grinds, spins and more in \"Snowboard Funpark\"."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/snowboardfunpark-privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "YueWorks", "support_website_url": null, "website_url": "https://yue-beifong.jimdosite.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_trackin
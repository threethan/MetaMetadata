_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5ShMk9PQrcQ7kNvwEhfWHX&_nc_oc=AdoQ11VOHTw94EKnSvgOpmGS1kLDH5cGu1iJ8Fv_WNZB3jFHzMnmMNF5XngF0IswZss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af195gRve-FiO2OySW_ofy2FKAihtdP-7167a28gOcT7Hw&oe=69F0A753"}, {"file_name": "ScreenshotsV3_DesertPink1.png", "id": "1646002506214380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982672_1646002509547713_6117429377105806925_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIEBD3TttOsQ7kNvwFRDbZd&_nc_oc=AdqsG9eMSP-bj49mHcMkFAdHGQvJN70jBlOa7tGoiHEPvMwlXU9N1n092NXqmNT2W8g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af24v6RUEZnWisNINSuCFgCsph3grbQQaosL7kFtv8Cm8g&oe=69F0C8F9"}, {"file_name": "ScreenshotsV3_Dandelion.png", "id": "313995351710333", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75647714_313995358376999_2531305836380872267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z31Bn6sz5RsQ7kNvwHGidCG&_nc_oc=Adr9esuJHNHzsGiLxkAg-_-XLoiMrTW9BqFiUBavDTVHWnV-Qae2uQF4JBz577RJlvw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3L3kVSIlO-_oqSTRxdKFi2K340cr5zJi9FnE1nEpJwTQ&oe=69F0C160"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YourHavenTrailerPreview.png", "id": "943549000507743", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982689_943549003841076_3117382408937186301_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-SCrcFa8F4Q7kNvwHWZ3ZQ&_nc_oc=AdryXrFm7ksHDGKwLsZzaW75lu8ySgrM9rfhCrew2HHTroe0kHO6nYNLdfEyMk8lBuY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af05jiFjoTzpfcFdi-vob6hzU_8HMAA38Q_OrN6Oaspf8Q&oe=69F0CEF3"}, "display_name": "YourHaven", "keywords": ["meditation", "breathwork", "relax", "sleep", "mindfulness"], "long_description": "\u2b50 **Unity for Humanity 2024 winners** \u2b50\n\nFor gamers, athletes, curious people and everyone else, YourHaven guides are here to help!\nEnjoy over 60 different sessions, ranging from stress relief to achieve your peak performance, all through a wide choice of narrators and experiences.\n\n# \ud83d\udc47\ud83d\udc47\ud83d\udc47 See it for yourself \ud83d\udc47\ud83d\udc47\ud83d\udc47\n\n\ud83c\udf34Access YourHaven's personalised sessions **from real world-leading wellness experts** and engage in guided interactions in serene environments.\n{1402247260478311}\n\n\n\n\ud83c\udfb4 Discover yourself through unique **mixed reality** experiences.\n{495913342947455}\n\n\n\ud83c\udf0c Dive into spaces that help to **calm your mind, body and spirit** within minutes. \n\"Like Netflix for the soul.\"\n{481957577606471}\n\n\n\n\n\ud83d\udc9c Immerse yourself. **Find your haven**. \ud83d\udc9c", "short_description": "Immersive meditation, mental health, wellness and peak performance experiences with expert guides from around the world. Immerse yourself. Find your haven.\ud83d\udc9c"}]}, "developer_name": "Haven Studios Limited", "developer_privacy_policy_url": "https://sedate-stone-edc.notion.site/Privacy-Policy-YourHaven-d793524d8d8b4e31a1b9ca92fd56679a", "developer_terms_of_service_url": null, "publisher_name": "Haven Studios Limited", "support_website_url": null, "website_url": "https://sedate-stone-edc.notion.site/YourHaven-18a0db89e66780d5b2f5c0bc7d34a0ee", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9079237712168442"}, "review_messages": []}]}, "cover_square_image": {"uri":
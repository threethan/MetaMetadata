&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2P0Q2hpE3Bc8PQCLg1TXnpk6CKdkDBVXvtNNz3uhEAw&oe=6AE4B25E"}, {"file_name": "HavenScreenshot2560x1440_5.png", "id": "305871972312376", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_305871975645709_1790819242854130707_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWYnnJpF9BUQ7kNvwGsXEze&_nc_oc=Ado-afNKtfejNFs0aXAKD7n86Bks-2oyUxcyss58DDzsZMbLNQvKMN1g0Oh9Ix90Ekc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpULrSF2yO0ySP3qa5ZFnuDBYLNpS3U9RCCLCvRob_lQ&oe=6AE4B7CC"}, {"file_name": "HavenScreenshot2560x1440_3.png", "id": "1464449451004182", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035312_1464449454337515_1207527297464923082_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EikvcmSOHdMQ7kNvwHNDYlc&_nc_oc=AdoOm35qPpVnTnvVWyOzvTf65iHykcN7-d0UhmacF8IyPEiivhWO_b0B2NWaEdeeSeg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhlGcIX_jqN4zOFf84vS7YbdLEVtKw5LdwJ5XRpgaY7Q&oe=6AE4A297"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImageV2.png", "id": "739256951427040", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974753_739256954760373_2282654141167225765_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1XfUBfVYwAQ7kNvwGlBdoR&_nc_oc=AdoWbHuBwJ6HcPQDGZUqlyfl6Xdr24rMBKc0Q8p_7qV7YFUN6xbft44FT3EVcBfBmvY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYrIY43mDeip_6B1qrDkO7SDQk1TwLd-m2sxYVC7vm4w&oe=6AE4C0A6"}, "display_name": "Haven", "keywords": [], "long_description": "1 in 4 people worldwide is struggling with a diagnosable mental health condition, and most aren't getting support. We are changing that. Haven is a revolutionary mental health and wellness platform that offers meditation, breathwork, and support from experts all over the world. We provide users with personalized, science-backed interactive content using XR technology to help change thought pathways and connect us better with our bodies. We also allow our users and experts to track their journey and measure personal growth with data-driven insights. Whether you want to manage stress or anxiety, feel better about yourself, or work on your confidence and performance, Haven is your space.", "short_description": "Immersive meditation, mental health, wellness and peak performance experiences with expert guides from around the world. Immerse yourself. Find your Haven."}]}, "developer_name": "Haven Studios", "developer_privacy_policy_url": "https://www.havenvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.havenvr.com/terms-conditions", "publisher_name": "Haven Studios", "support_website_url": null, "website_url": "https://www.havenvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "500370592263390"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7801914849900741", "version": "1.3.2"}, "id": "1215195539107448", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5878653762226869", "is_concept": false, "latest_released_b
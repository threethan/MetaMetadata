_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXkk0g5vsMAQ7kNvwFWlcqh&_nc_oc=Adk3a0A2cgHjDpS1-xFg2hR-ur8w48xt8Z0vUN74i07JIbRqBGjFefO8UAmTPT9xjIE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvRneLtqpQ_RNUYr77UNti9oji3UwSdvdvNH6OePdenqA&oe=699AF5D3"}, {"file_name": "ScreenshotsV3_DesertPink1.png", "id": "1646002506214380", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982672_1646002509547713_6117429377105806925_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hOFQZOPJ2sQ7kNvwGrp0u5&_nc_oc=Adm1g3DQ7_Z73NBHt06jGRNIGEymbDnRhIoq5OQ7MO6zKAsF7W7QWIVWSGgjRWC3pv8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuLyKsECIjr1awsiG5QllP9bX_-nkUmjJtBz4uRE7w7tA&oe=699ADF39"}, {"file_name": "ScreenshotsV3_Dandelion.png", "id": "313995351710333", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75647714_313995358376999_2531305836380872267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=don-Sj_WNWMQ7kNvwFvbLD1&_nc_oc=AdnEqmdJ5aQdvEnb2fwHG7JWx_4wDR95jbP1s6jsWmXPOMGG3Ir57mDMz8g8A0PPlSM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfswDqVj-u3sosVUQxlCVnb-XYG59xclqirtGdxnaiksWg&oe=699B0FE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YourHavenTrailerPreview.png", "id": "943549000507743", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982689_943549003841076_3117382408937186301_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExQR_3slYGYQ7kNvwGXWFv6&_nc_oc=AdlWUYIlN_bEZFo4ps74h2JgkIetQ3vnBoLcwra_c-tpn5DnLey2oEVn7H0P-i9nne0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afug2F5Qumk70ep6YWAON8BQxOdQfdZdvR2YvDUcSOT_5Q&oe=699AE533"}, "display_name": "YourHaven", "keywords": ["meditation", "breathwork", "relax", "sleep", "mindfulness"], "long_description": "\u2b50 **Unity for Humanity 2024 winners** \u2b50\n\nFor gamers, athletes, curious people and everyone else, YourHaven guides are here to help!\nEnjoy over 60 different sessions, ranging from stress relief to achieve your peak performance, all through a wide choice of narrators and experiences.\n\n# \ud83d\udc47\ud83d\udc47\ud83d\udc47 See it for yourself \ud83d\udc47\ud83d\udc47\ud83d\udc47\n\n\ud83c\udf34Access YourHaven's personalised sessions **from real world-leading wellness experts** and engage in guided interactions in serene environments.\n{1402247260478311}\n\n\n\n\ud83c\udfb4 Discover yourself through unique **mixed reality** experiences.\n{495913342947455}\n\n\n\ud83c\udf0c Dive into spaces that help to **calm your mind, body and spirit** within minutes. \n\"Like Netflix for the soul.\"\n{481957577606471}\n\n\n\n\n\ud83d\udc9c Immerse yourself. **Find your haven**. \ud83d\udc9c", "short_description": "Immersive meditation, mental health, wellness and peak performance experiences with expert guides from around the world. Immerse yourself. Find your haven.\ud83d\udc9c"}]}, "developer_name": "Haven Studios Limited", "developer_privacy_policy_url": "https://sedate-stone-edc.notion.site/Privacy-Policy-YourHaven-d793524d8d8b4e31a1b9ca92fd56679a", "developer_terms_of_service_url": null, "publisher_name": "Haven Studios Limited", "support_website_url": null, "website_url": "https://sedate-stone-edc.notion.site/YourHaven-18a0db89e66780d5b2f5c0bc7d34a0ee", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9079237712168442"}, "review_messages": []}]}, "cover_square_image": {"uri":
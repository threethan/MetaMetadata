_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSm2lGp9yaoQ7kNvwGxZBEI&_nc_oc=Adm-g2REX1drELNRfIanqS12BGiObm-d2gCc9w1zxBUatGAaz6_A6RXuvpftOy2BlcU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvG8d3W3zk7SNBk2SYHfO9uxM-6tpKgV0qY45I_7e-sHA&oe=69A581D3"}, {"file_name": "ScreenshotsV3_DesertPink1.png", "id": "1646002506214380", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982672_1646002509547713_6117429377105806925_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8X35EBFtekQ7kNvwHXndK8&_nc_oc=Adl_pEl9kSGgtXnF8G87_BicyafsQTEIezoCTcgo4ypklU6KZk8n73LlBWTlfx8dWJ4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvN8Gw0PVD_eExrEN7-QJFc4imy_U8jLFvmXql_U7hq4g&oe=69A56B39"}, {"file_name": "ScreenshotsV3_Dandelion.png", "id": "313995351710333", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75647714_313995358376999_2531305836380872267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQKCGxzvJRMQ7kNvwHD80N4&_nc_oc=AdmMZST4Sd3UKHgSm7Da9GN2GHTeFNTBKOjAfkIDBLx6HjMimUon_bmRV7uvpssASAc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu84dz0Zsyc8uweGSKX_ZUfRLnMLbOv4PQq2FtTQUn9Ww&oe=69A59BE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YourHavenTrailerPreview.png", "id": "943549000507743", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982689_943549003841076_3117382408937186301_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ig6REztatiMQ7kNvwH1SKVx&_nc_oc=AdnSMM7fJ_YxD4KoESBfYOABZfJMd_-DwQZzX6PEWYTQXONCryai7rIO_QEat_R0chY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs2HPfrxDKXieIB7g5Iyk-nzmUIw0L6FJ-WnSp7y1xFtw&oe=69A57133"}, "display_name": "YourHaven", "keywords": ["meditation", "breathwork", "relax", "sleep", "mindfulness"], "long_description": "\u2b50 **Unity for Humanity 2024 winners** \u2b50\n\nFor gamers, athletes, curious people and everyone else, YourHaven guides are here to help!\nEnjoy over 60 different sessions, ranging from stress relief to achieve your peak performance, all through a wide choice of narrators and experiences.\n\n# \ud83d\udc47\ud83d\udc47\ud83d\udc47 See it for yourself \ud83d\udc47\ud83d\udc47\ud83d\udc47\n\n\ud83c\udf34Access YourHaven's personalised sessions **from real world-leading wellness experts** and engage in guided interactions in serene environments.\n{1402247260478311}\n\n\n\n\ud83c\udfb4 Discover yourself through unique **mixed reality** experiences.\n{495913342947455}\n\n\n\ud83c\udf0c Dive into spaces that help to **calm your mind, body and spirit** within minutes. \n\"Like Netflix for the soul.\"\n{481957577606471}\n\n\n\n\n\ud83d\udc9c Immerse yourself. **Find your haven**. \ud83d\udc9c", "short_description": "Immersive meditation, mental health, wellness and peak performance experiences with expert guides from around the world. Immerse yourself. Find your haven.\ud83d\udc9c"}]}, "developer_name": "Haven Studios Limited", "developer_privacy_policy_url": "https://sedate-stone-edc.notion.site/Privacy-Policy-YourHaven-d793524d8d8b4e31a1b9ca92fd56679a", "developer_terms_of_service_url": null, "publisher_name": "Haven Studios Limited", "support_website_url": null, "website_url": "https://sedate-stone-edc.notion.site/YourHaven-18a0db89e66780d5b2f5c0bc7d34a0ee", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9079237712168442"}, "review_messages": []}]}, "cover_square_image": {"uri":
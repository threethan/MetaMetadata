_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pe5H87uVJmYQ7kNvwE0kecx&_nc_oc=AdmM_hi5sv1izTQZH0C08bY5mHiStklBB00CW6SMYnkybLpDsXuiS40-wKIiGF86Fhc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuCR3BLEemngNl_sUo79n9sgTD3DrmzVFNE-F0if_qAfQ&oe=699D98D3"}, {"file_name": "ScreenshotsV3_DesertPink1.png", "id": "1646002506214380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982672_1646002509547713_6117429377105806925_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXrCTHfnC1EQ7kNvwES0kDD&_nc_oc=AdlgawtMli_nB4Gf4g7EZYDxG4QQggzsueS7p8eHT8OetQ-k0aPT0feyaLP5mgOiXbo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftD-tI0hsGzcr76PJZkMDiCk-QAue9oJekA5uKYma2NAg&oe=699D8239"}, {"file_name": "ScreenshotsV3_Dandelion.png", "id": "313995351710333", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75647714_313995358376999_2531305836380872267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41wV0aXjWs8Q7kNvwEDi3U3&_nc_oc=Adn7LPLe7kPVtcQR3vFF94DmcQSQj2ys3LDMW6UXJptoGIkYcwBt1el-1sfNIR1wHu4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuSuvUkeF8dqEW9TiZKE0fv2qc-kVqjFbMEoqXfR_nH_w&oe=699DB2E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YourHavenTrailerPreview.png", "id": "943549000507743", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982689_943549003841076_3117382408937186301_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-B3HS0-D9oQ7kNvwEsQbWN&_nc_oc=Adl919gYvlLAwAdb7pfqbhIx8hkpogDGCSwm06V17GISijH3AMpufblIlclL9B2dVBI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv8rEEflgZgEPGKc1lpvbJNX02xMqS71M2LUzmWWEXBRg&oe=699D8833"}, "display_name": "YourHaven", "keywords": ["meditation", "breathwork", "relax", "sleep", "mindfulness"], "long_description": "\u2b50 **Unity for Humanity 2024 winners** \u2b50\n\nFor gamers, athletes, curious people and everyone else, YourHaven guides are here to help!\nEnjoy over 60 different sessions, ranging from stress relief to achieve your peak performance, all through a wide choice of narrators and experiences.\n\n# \ud83d\udc47\ud83d\udc47\ud83d\udc47 See it for yourself \ud83d\udc47\ud83d\udc47\ud83d\udc47\n\n\ud83c\udf34Access YourHaven's personalised sessions **from real world-leading wellness experts** and engage in guided interactions in serene environments.\n{1402247260478311}\n\n\n\n\ud83c\udfb4 Discover yourself through unique **mixed reality** experiences.\n{495913342947455}\n\n\n\ud83c\udf0c Dive into spaces that help to **calm your mind, body and spirit** within minutes. \n\"Like Netflix for the soul.\"\n{481957577606471}\n\n\n\n\n\ud83d\udc9c Immerse yourself. **Find your haven**. \ud83d\udc9c", "short_description": "Immersive meditation, mental health, wellness and peak performance experiences with expert guides from around the world. Immerse yourself. Find your haven.\ud83d\udc9c"}]}, "developer_name": "Haven Studios Limited", "developer_privacy_policy_url": "https://sedate-stone-edc.notion.site/Privacy-Policy-YourHaven-d793524d8d8b4e31a1b9ca92fd56679a", "developer_terms_of_service_url": null, "publisher_name": "Haven Studios Limited", "support_website_url": null, "website_url": "https://sedate-stone-edc.notion.site/YourHaven-18a0db89e66780d5b2f5c0bc7d34a0ee", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9079237712168442"}, "review_messages": []}]}, "cover_square_image": {"uri":
66716126120", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/75500283_431566722792786_102719348151939548_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4R506X6N78Q7kNvwGHvYIF&_nc_oc=AdogzJpglInx2xmZ4aK0gI5ZD4kFQipLeJGUr5O9EsdTahvqjdWPGKQTNXFRAY790fY&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdJ13HWI6MGKdRq0KTnHIJs8g3SLGRdw39jsAv2d0KhQ&oe=6A917E53"}, {"file_name": "ScreenshotsV3_DesertPink1.png", "id": "1646002506214380", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982672_1646002509547713_6117429377105806925_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwfScQnXTzYQ7kNvwHto76s&_nc_oc=AdpCFXohisOrPMQO_2dOlgX2wnkCue156GtoQsiIEUp5oFsNhfiH9_fn_2n4JD3geoE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRbJIHDjA9N5172xqJ1qXBXnGc8p3pV6EUy_otd4-S0w&oe=6A9167B9"}, {"file_name": "ScreenshotsV3_Dandelion.png", "id": "313995351710333", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75647714_313995358376999_2531305836380872267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdptfCfdaGIQ7kNvwGIpBSU&_nc_oc=Adq-StBfBkBJww12J1NO79yn1OJhdHXKJQ9RRK0ErFyT3wZxG3L9FseWCfwNrwgP-5U&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVWDEzqxf1VEnDz_2BAY3SdAeIgMBpTCimYN9DfU9uVA&oe=6A916020"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YourHavenTrailerPreview.png", "id": "943549000507743", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982689_943549003841076_3117382408937186301_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOCNCiUvx5gQ7kNvwH99uUo&_nc_oc=AdrCsiuevtzbPuMZ-7L4p_lEMIJmRMu6uYscNsxtdSOkp635AL-8M7trrtjePVENpsU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvbDf5Ng_TjhGljkSW4XXPGq9CendhxGarguQLFHoUVg&oe=6A916DB3"}, "display_name": "YourHaven", "keywords": ["meditation", "breathwork", "relax", "sleep", "mindfulness"], "long_description": "\u2b50 **Unity for Humanity 2024 winners** \u2b50\n\nFor gamers, athletes, curious people and everyone else, YourHaven guides are here to help!\nEnjoy over 60 different sessions, ranging from stress relief to achieve your peak performance, all through a wide choice of narrators and experiences.\n\n# \ud83d\udc47\ud83d\udc47\ud83d\udc47 See it for yourself \ud83d\udc47\ud83d\udc47\ud83d\udc47\n\n\ud83c\udf34Access YourHaven's personalised sessions **from real world-leading wellness experts** and engage in guided interactions in serene environments.\n{1402247260478311}\n\n\n\n\ud83c\udfb4 Discover yourself through unique **mixed reality** experiences.\n{495913342947455}\n\n\n\ud83c\udf0c Dive into spaces that help to **calm your mind, body and spirit** within minutes. \n\"Like Netflix for the soul.\"\n{481957577606471}\n\n\n\n\n\ud83d\udc9c Immerse yourself. **Find your haven**. \ud83d\udc9c", "short_description": "Immersive meditation, mental health, wellness and peak performance experiences with expert guides from around the world. Immerse yourself. Find your haven.\ud83d\udc9c"}]}, "developer_name": "Haven Studios Limited", "developer_privacy_policy_url": "https://sedate-stone-edc.notion.site/Privacy-Policy-YourHaven-d793524d8d8b4e31a1b9ca92fd56679a", "developer_terms_of_service_url": null, "publisher_name": "Haven Studios Limited", "support_website_url": null, "website_url": "https://sedate-stone-edc.notion.site/YourHaven-18a0db89e66780d5b2f5c0bc7d34a0ee", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "RO
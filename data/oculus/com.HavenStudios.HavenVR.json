66716126120", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75500283_431566722792786_102719348151939548_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAUBgFmwuVMQ7kNvwE7Uz8Q&_nc_oc=AdpInCkOSWHn6TGHNOccZugOcYYtR61JgoHJXecjt98QdotrsXOfaVKVux2ARdvjpwU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNroF7laV58l6ZOp7E4bZVtXWi0NPr3s0XUyppjfwxvwg&oe=6AE33B53"}, {"file_name": "ScreenshotsV3_DesertPink1.png", "id": "1646002506214380", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982672_1646002509547713_6117429377105806925_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oluITU8EikIQ7kNvwHVmRe7&_nc_oc=AdrQ3XhUUGYtti-72EXXl8EzIz0fHq6VfMnArZvOGosk0B_TTDFWmMq-EDQhNeMFOI0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhZ30RPyCxAcfCS3H8Ex8h4CYDbZssIzlWL6cUB18Qkw&oe=6AE35CF9"}, {"file_name": "ScreenshotsV3_Dandelion.png", "id": "313995351710333", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75647714_313995358376999_2531305836380872267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lU118V0JrcIQ7kNvwG0W9sW&_nc_oc=AdqfQ9JPbjUjDkTLjkaEXj59PIPlfNMvuD5l9QnzBdiIThn1jJj7X4oZoFu9dNRB2KI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOK6nVjv14MGUMcebJVPioFyHrhE5zj1i0TbtP_9N1ISQ&oe=6AE35560"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YourHavenTrailerPreview.png", "id": "943549000507743", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982689_943549003841076_3117382408937186301_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlpSQt5t1EwQ7kNvwFK52Er&_nc_oc=Adrb-SbT71ArHR62aYsBSstSQ9pphpbcq8xggq1frU9QQGLrMY3wkfl3KWrelfiAyr4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPveEAy0NQFyzs8t-Uyl71S0m_G3rOo0GznBEcl2Ki5jw&oe=6AE362F3"}, "display_name": "YourHaven", "keywords": ["meditation", "breathwork", "relax", "sleep", "mindfulness"], "long_description": "\u2b50 **Unity for Humanity 2024 winners** \u2b50\n\nFor gamers, athletes, curious people and everyone else, YourHaven guides are here to help!\nEnjoy over 60 different sessions, ranging from stress relief to achieve your peak performance, all through a wide choice of narrators and experiences.\n\n# \ud83d\udc47\ud83d\udc47\ud83d\udc47 See it for yourself \ud83d\udc47\ud83d\udc47\ud83d\udc47\n\n\ud83c\udf34Access YourHaven's personalised sessions **from real world-leading wellness experts** and engage in guided interactions in serene environments.\n{1402247260478311}\n\n\n\n\ud83c\udfb4 Discover yourself through unique **mixed reality** experiences.\n{495913342947455}\n\n\n\ud83c\udf0c Dive into spaces that help to **calm your mind, body and spirit** within minutes. \n\"Like Netflix for the soul.\"\n{481957577606471}\n\n\n\n\n\ud83d\udc9c Immerse yourself. **Find your haven**. \ud83d\udc9c", "short_description": "Immersive meditation, mental health, wellness and peak performance experiences with expert guides from around the world. Immerse yourself. Find your haven.\ud83d\udc9c"}]}, "developer_name": "Haven Studios Limited", "developer_privacy_policy_url": "https://sedate-stone-edc.notion.site/Privacy-Policy-YourHaven-d793524d8d8b4e31a1b9ca92fd56679a", "developer_terms_of_service_url": null, "publisher_name": "Haven Studios Limited", "support_website_url": null, "website_url": "https://sedate-stone-edc.notion.site/YourHaven-18a0db89e66780d5b2f5c0bc7d34a0ee", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "RO
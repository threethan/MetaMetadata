2701_540794480240507_4555975033147187205_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qri-wPg1hA4Q7kNvwFgllom&_nc_oc=AdoGKgp_SVyGBY6yHskyoaNlJfnO6b3p-R6o2TfkoigRDq3NYDE9dfhuT6wHImoz4WE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLGLGtV0zA6tyUqFdbWDQS0OjSbRtNKOqUJcsXD9Q2Dw&oe=6B03118A"}, "display_name": "Pirates on Deck VR", "keywords": [], "long_description": "Get on board and sail the seven seas. Enemy pirates and dangerous monsters are all over your ship!\n\nDon\u2019t let anyone stand in your way. Shoot with your pistols or battle with your cutlass. Master the cannons with your commands and crush enemy ships.\n\nShoot treasure chests to unlock new weapons or discover other surprises to assist you on your way to victory.\n\nPirates on Deck VR is an arcade wave shooter for all ages, featuring local leaderboards and progressive difficulty. ", "short_description": "Get on board and travel the seven seas. Enemy pirates and dangerous monsters are all over your ship! Don\u2019t let anyone stand in your way. Shoot with your guns or battle with your cutlass. Master the cannons with your commands and crush enemy ships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.boltvirtual.gr/piratesondeck-privacy", "developer_terms_of_service_url": null, "publisher_name": "Bolt Virtual Services and Productions", "support_website_url": null, "website_url": "https://www.boltvirtual.gr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["
c=Y-kHx-M_aQwQ7kNvwF81iyz&_nc_oc=Ados8J2eIiN8TdfLSFOSBJ-rqo7xz1zQ9YRQ1Iqb5Y9KKUZF97wTy_OkgCqAwtsbOA0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EaCxGACiri0sFZJd5YHEs-Lm610_gth9xIsmv_aRwrg&oe=6A369F59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube_Thumbnail_02_2560x1440.png", "id": "1276171510600059", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491824618_1276171513933392_2305027942702563454_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmNDasKpBn4Q7kNvwGTTfZA&_nc_oc=AdppVp399hdMEpC4kw2t8OXs9ZFtJfnkKnpuMxH8KB_v4zzJoC_WEUo-TnDpZgxu0KI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KMfAS3_gfZS5_KqD3YE7Xkbn4FOFxxdhFGpnFR681vA&oe=6A36C385"}, "display_name": "Data Rot", "keywords": ["horror", "retro", "scary", "dungeon", "exploration"], "long_description": "DATA ROT is an ominous Virtual Reality horror experience!\n\nYou are the last line of defense. An insidious Daemon is taking control of your system. \n\nFind the 8 scattered Data Fragments to eliminate the Daemon before it corrupts the mainframe.\n\nExplore the corrupted remains of a once-thriving system.\n\nAs the corruption spreads and the Daemon takes control, the world devolves around you.\n\nSurvive at all costs! Don't let the Daemon catch you!\n\nOverview:\n\n- 20-45 minute playthrough\n- Intuitive, addictive gameplay\n- Dynamic AI Opponent that hunts  the player\n- Roomscale or Seated experience\n- Retro-futuristic ASCII style", "short_description": "Collect scattered Data Fragments while avoiding an insidious entity that is corrupting your system. Simple gameplay. Dynamic AI opponent. 20-45 min playthrough. Roomscale or Seated. A chilling, stylized VR horror game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://nekomatagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nekomata Games LLC", "support_website_url": null, "website_url": "https://nekomatagames.com/
h=00_AftLGuw78g3Lvx3OXz9d8szI_Xul5TnST4qtE4d75RfhIQ&oe=69A2F759"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube_Thumbnail_02_2560x1440.png", "id": "1276171510600059", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824618_1276171513933392_2305027942702563454_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHDj9PSjEwwQ7kNvwFpnNPg&_nc_oc=AdkQPN_d0HVQEgjUg0tYVcvgRdcRJn6bS4hpbrKl6CIrCMw3uCEAopUTYQ5wOnbyFD4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuQ7VOMHLPdqjgCMHcu6AIOjuUr9ssJKr9Zezz6G-xDww&oe=69A2E345"}, "display_name": "Data Rot", "keywords": ["horror", "retro", "scary", "dungeon", "exploration"], "long_description": "DATA ROT is an ominous Virtual Reality horror experience!\n\nYou are the last line of defense. An insidious Daemon is taking control of your system. \n\nFind the 8 scattered Data Fragments to eliminate the Daemon before it corrupts the mainframe.\n\nExplore the corrupted remains of a once-thriving system.\n\nAs the corruption spreads and the Daemon takes control, the world devolves around you.\n\nSurvive at all costs! Don't let the Daemon catch you!\n\nOverview:\n\n- 20-45 minute playthrough\n- Intuitive, addictive gameplay\n- Dynamic AI Opponent that hunts  the player\n- Roomscale or Seated experience\n- Retro-futuristic ASCII style", "short_description": "Collect scattered Data Fragments while avoiding an insidious entity that is corrupting your system. Simple gameplay. Dynamic AI opponent. 20-45 min playthrough. Roomscale or Seated. A chilling, stylized VR horror game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://nekomatagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nekomata Games LLC", "support_website_url": null, "website_url": "https://nekomatagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics
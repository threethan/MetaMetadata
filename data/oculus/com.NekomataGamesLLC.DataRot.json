1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBkldPedv-HZ-WIpe14SEXR0idf5Bnbkk5OyD3c1UUpA&oe=6A4A65D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube_Thumbnail_02_2560x1440.png", "id": "1276171510600059", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824618_1276171513933392_2305027942702563454_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NP7a0YbLB3wQ7kNvwFYHFol&_nc_oc=AdpH12fjeZurZccrzzQuvtQ_X2wEYjwcgG0HqVvH-zLBlA2mqoP9nxk8bmnWW8mZmBw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYQa0QLX1OJ4tIk46iJnUO4tr9IvlmRMnu8Lb1nKl-Gg&oe=6A4A51C5"}, "display_name": "Data Rot", "keywords": ["horror", "retro", "scary", "dungeon", "exploration"], "long_description": "DATA ROT is an ominous Virtual Reality horror experience!\n\nYou are the last line of defense. An insidious Daemon is taking control of your system. \n\nFind the 8 scattered Data Fragments to eliminate the Daemon before it corrupts the mainframe.\n\nExplore the corrupted remains of a once-thriving system.\n\nAs the corruption spreads and the Daemon takes control, the world devolves around you.\n\nSurvive at all costs! Don't let the Daemon catch you!\n\nOverview:\n\n- 20-45 minute playthrough\n- Intuitive, addictive gameplay\n- Dynamic AI Opponent that hunts  the player\n- Roomscale or Seated experience\n- Retro-futuristic ASCII style", "short_description": "Collect scattered Data Fragments while avoiding an insidious entity that is corrupting your system. Simple gameplay. Dynamic AI opponent. 20-45 min playthrough. Roomscale or Seated. A chilling, stylized VR horror game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://nekomatagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nekomata Games LLC", "support_website_url": null, "website_url": "https://nekomatagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "c
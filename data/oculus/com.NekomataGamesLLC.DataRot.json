D0VuKySLSi1U2VI41Y-6Q91YI0HhPeRQ7cA&oe=6AFB1F90"}, {"file_name": "DataRot_Screenshots_Quest_03.png", "id": "3622500744722665", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824618_3622500751389331_5976371214588306608_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BT1VcOmGrqIQ7kNvwHCRpkk&_nc_oc=AdpW5o-wm1pESa2bGGtyeOYrg7o5SK_xVM1nTDHn9jC5kQk6-ke2DfcwHLrcIV-HJUo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzMFgImdH6Xkn4BpesUFFGZ06ATSVH94-Ip6nYecd7Aw&oe=6AFB4719"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YouTube_Thumbnail_02_2560x1440.png", "id": "1276171510600059", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824618_1276171513933392_2305027942702563454_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdzmaPQdC8IQ7kNvwHx1wTH&_nc_oc=AdoL4cpgdcYAzuyeDRmCSmEZAfT3YpFyI4nsv2zYaJL8Ds047aXzpFXrelQhBds779g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT98oq4X_O-1e049lVzHTyI0eftimXxYyMD0Rxvvg_Eaw&oe=6AFB3305"}, "display_name": "Data Rot", "keywords": ["horror", "retro", "scary", "dungeon", "exploration"], "long_description": "DATA ROT is an ominous Virtual Reality horror experience!\n\nYou are the last line of defense. An insidious Daemon is taking control of your system. \n\nFind the 8 scattered Data Fragments to eliminate the Daemon before it corrupts the mainframe.\n\nExplore the corrupted remains of a once-thriving system.\n\nAs the corruption spreads and the Daemon takes control, the world devolves around you.\n\nSurvive at all costs! Don't let the Daemon catch you!\n\nOverview:\n\n- 20-45 minute playthrough\n- Intuitive, addictive gameplay\n- Dynamic AI Opponent that hunts  the player\n- Roomscale or Seated experience\n- Retro-futuristic ASCII style", "short_description": "Collect scattered Data Fragments while avoiding an insidious entity that is corrupting your system. Simple gameplay. Dynamic AI opponent. 20-45 min playthrough. Roomscale or Seated. A chilling, stylized VR horror game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://nekomatagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nekomata Games LLC", "support_website_url": null, "website_url": "https://nekomatagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23952009027798208"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499331272_9678293395629817_8942357333682418535_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4UX-V1pyssQ7kNvwHrBRA0&_nc_oc=AdpDdDTEzPOj6WC0Ft_p-GER4CBT2s1MvR8C20ZewI40Xwhs5qI9UtCgc5zfn3fsZQE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqtDZRC5o5xr9G4LFlLP5CrhELZqDTH5PWXAUGvwCifw&oe=6AFB4253"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Data Rot", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1749816000, "lastRevision": {"nodes": [{"id"
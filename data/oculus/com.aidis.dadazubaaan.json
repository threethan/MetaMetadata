-7&_nc_sid=6e7a0a&_nc_ohc=fLW444GbKucQ7kNvwG_r7Ae&_nc_oc=AdlxxGF8DA4fOUe25jwMf127Gu8gkS-N4hYPzymAYIGSIqYa_BgJSYIXG4OCvKqTJLw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu0nQN3ZRhLhAkWAJsih--8kVLX471C9VS8-R7EB7OJbg&oe=69A2E9F6"}, {"file_name": "4_Image Sequence_003_7650.png", "id": "1928196147921708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617834_1928196151255041_156936990506898640_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAf7Vsps5HcQ7kNvwEglxW1&_nc_oc=AdmKSZ4L9wZNhrjxUQD0gxVqOAYw1O8i5WQ30T5u1tDrJJYtlHcBKgJeJfOXk0Eo8-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs24sWqAnLITttU41mc_i0sHpk01E-b2YVpLvFfZ_BcVQ&oe=69A2E258"}, {"file_name": "5_Image Sequence_003_8213.png", "id": "1355545359063790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623571_1355545362397123_8347217772719337435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xm_gUahL1M8Q7kNvwHBBNRC&_nc_oc=AdmzhnOw1uWgol8421_XJ7R7bXHh_rjtghrdKIg9us7nEGKlNltSSoUlN9VnCBT2jwQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs_JBh8zzI0maNitl6gWinkDhUBeA8aHtwCW8PA72v8NQ&oe=69A2D072"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DAZ_PV\u30b5\u30e0\u30cd_250514.png", "id": "1385315602748624", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391926_1385315606081957_5473307483014484988_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZB6IAE3vOAQQ7kNvwEnWvu6&_nc_oc=Adm46oQ25sMd7VjbhzTC3EKk9W7LEzlOUYPIjSp1u6RvufXvKi9Oc1tO0c6E3B_dPjw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuaa-KkzRG8LqX6IuFlyY7Kueth2B1AiKzVqq-5S63DIg&oe=69A2D698"}, "display_name": "Dada Zubaaan: The 360\u00b0 Puzzle Game", "keywords": ["puzzle", "casual", "logic", "handtracking", "connect"], "long_description": "# Move the Panels, Make Paths, and Master Dada Zubaaan!\nIn this electrifying VR slide puzzle game, you arrange mix-and-match panels into a juiced-up pathway from start to finish! As the circuits grow longer and longer, your score will surge\u2014just watch out for the time limit! Think you can slide together the perfect route and claim a spot at the top of the global leaderboard?\n\nWhy You'll Be Hooked:\n\nSATISFYING CONNECTIONS: There's nothing like the rush of seeing your planned pathway za-za-zap into place. Sometimes the most unexpected, winding route leads to the biggest score!\n\nIMMERSIVE EXPERIENCE: Feel the beat intensify as your pathway grows longer. Watch as snap-crackling light and sound effects sync up, and the world around you transforms. It's a feast for your senses that will keep your adrenaline pumping!\n\nMAXIMUM PLAYABILITY: With super simple one-handed, one-button controls, Dada Zubaaan is incredibly easy to pick up and play. Whether you're a seasoned gamer or new to VR, you'll be laying down circuits and chasing high scores in no time.\n\nZa-za-zap your way to the next level with the ultimate play: Dada Zubaaan!", "short_description": "Move the Panels, Make Paths, and Master Dada Zubaaan!\n\nIn this electrifying VR slide puzzle game, you arrange mix-and-match panels into a juiced-up pathway from start to finish! As the circuits grow longer and longer, your score will surge\u2014just watch out for the time limit! Think you can slide together the perfect route and claim a spot at the top of the global leaderboard?\n\nZa-za-zap your way to the next level with the ultimate play: Dada Zubaaan!"}, {"images": {"nodes": []}, "id": "1410665760247815", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dada Zubaaan: The 360\u00b0 Puzzle Game", "keywords": ["\u30d1\u30ba\u30eb", "\u30ab\u30b8\u30e5\u30a2\u30eb", "\u30ed\u30b8\u30c3\u30af", "\u30cf\u30f3\u30c9\u30c8\u30e9\u30c3\u30ad\u30f3\u30b0", "\u30b3\u30cd\u30af\u30c8"], "long_description": "# \u30e9\u30a4\u30f3\u3092\u3064\u306a\u3052\uff01\u3000\u8ab0\u3088\u308a\u3082\u9577\u304f\uff01\u3000\u8ab0\u3088\u308a\u3082\u65e9\u304f\uff01\n\nVR\u30b2\u30fc\u30e0\u300eD
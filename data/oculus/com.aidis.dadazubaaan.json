.oculuscdn.com/v/t64.5771-25/499617814_1668699347102835_3873176974035814440_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maBg-3Uh_RgQ7kNvwHjsUa5&_nc_oc=AdoFL9ctv06NjdqE8FKI6ySrLXITJtMlfjWEaDxqoxOXLfIx0FK5_YnwI2uvfxKMq48&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzgMLLyb1_C_e8gsbfqXuvm-TXWw0aKYwUuuco3sAnSQA&oe=69C13C76"}, {"file_name": "4_Image Sequence_003_7650.png", "id": "1928196147921708", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617834_1928196151255041_156936990506898640_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PtXk-YQ_2EQ7kNvwE9u2Io&_nc_oc=AdrtxLNJFFZE15klrlv9ZOskLMyO4kjlzcFdhOjRYIxxnyJcoje0OgxjDHfQmtx-56Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzkAJhLWnrVF4I7Mq0lntAIT_kJOilRRAjQccL_u85xcg&oe=69C134D8"}, {"file_name": "5_Image Sequence_003_8213.png", "id": "1355545359063790", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499623571_1355545362397123_8347217772719337435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLMJnkrAXyoQ7kNvwHevi6i&_nc_oc=Ado11raGoLf7IP3fj3RTzx5ek7FbXTSB3JtvXz8GOB6moACpiZwRmxi-XHWSf51O1Io&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwjZZwSkjE-ojpQ8mh4hAWMFUVbkGNHhBJvW0JGjP739Q&oe=69C122F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DAZ_PV\u30b5\u30e0\u30cd_250514.png", "id": "1385315602748624", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391926_1385315606081957_5473307483014484988_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVUGI54CPLUQ7kNvwGryh0z&_nc_oc=Adom803g3hJH55mwh69oNMKUUXXC4M7ZusM6OoIUJ-w1FgHiYUhwSYLzfQ9u1BRz0ck&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyD9aH_pgwYATlrQAa1gr_D8AtMqydFcbVenGAoXrfxyQ&oe=69C12918"}, "display_name": "Dada Zubaaan: The 360\u00b0 Puzzle Game", "keywords": ["puzzle", "casual", "logic", "handtracking", "connect"], "long_description": "# Move the Panels, Make Paths, and Master Dada Zubaaan!\nIn this electrifying VR slide puzzle game, you arrange mix-and-match panels into a juiced-up pathway from start to finish! As the circuits grow longer and longer, your score will surge\u2014just watch out for the time limit! Think you can slide together the perfect route and claim a spot at the top of the global leaderboard?\n\nWhy You'll Be Hooked:\n\nSATISFYING CONNECTIONS: There's nothing like the rush of seeing your planned pathway za-za-zap into place. Sometimes the most unexpected, winding route leads to the biggest score!\n\nIMMERSIVE EXPERIENCE: Feel the beat intensify as your pathway grows longer. Watch as snap-crackling light and sound effects sync up, and the world around you transforms. It's a feast for your senses that will keep your adrenaline pumping!\n\nMAXIMUM PLAYABILITY: With super simple one-handed, one-button controls, Dada Zubaaan is incredibly easy to pick up and play. Whether you're a seasoned gamer or new to VR, you'll be laying down circuits and chasing high scores in no time.\n\nZa-za-zap your way to the next level with the ultimate play: Dada Zubaaan!", "short_description": "Move the Panels, Make Paths, and Master Dada Zubaaan!\n\nIn this electrifying VR slide puzzle game, you arrange mix-and-match panels into a juiced-up pathway from start to finish! As the circuits grow longer and longer, your score will surge\u2014just watch out for the time limit! Think you can slide together the perfect route and claim a spot at the top of the global leaderboard?\n\nZa-za-zap your way to the next level with the ultimate play: Dada Zubaaan!"}, {"images": {"nodes": []}, "id": "1410665760247815", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dada Zubaaan: The 360\u00b0 Puzzle Game", "keywords": ["\u30d1\u30ba\u30eb", "\u30ab\u30b8\u30e5\u30a2\u30eb", "\u30ed\u30b8\u30c3\u30af", "\u30cf\u30f3\u30c9\u30c8\u30e9\u30c3\u30ad\u30f3\u30b0", "\u30b3\u30cd\u30af\u30c8"], "long_description": "# \u30e9\u30a4\u30f3\u3092\u3064\u306a\u30
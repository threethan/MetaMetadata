-7&_nc_sid=6e7a0a&_nc_ohc=RhcbgnIyiskQ7kNvwERZcz7&_nc_oc=AdliB1Il6-0E6hhngpa79jBgdiyGSyZ5yz2Rfi5tu526iuc8QgIcSp6_3Za5EdaiMXk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftgS7ubscz-ny-xB8P1qW-84Jjyc9A8G-JPeIMFxNITaw&oe=69985DF6"}, {"file_name": "4_Image Sequence_003_7650.png", "id": "1928196147921708", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617834_1928196151255041_156936990506898640_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arSomaOPNZMQ7kNvwH2wkFG&_nc_oc=AdkEgv7kyFlvyoJdCTQ1WP5aiEDvhgHc6cbwV7Ad9Jo2-Go48vNtB712-PVmS3aKXpI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsX3nGtvQNtoPhtWxNwy8e3oCRJnsl8n9y9zMt2fXdXwA&oe=69985658"}, {"file_name": "5_Image Sequence_003_8213.png", "id": "1355545359063790", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623571_1355545362397123_8347217772719337435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYh9EMMcw3QQ7kNvwGUlv2T&_nc_oc=Adn1ik8gKdpQHjtC6tWr_cRpVCqZbEPGLBiuA9BjWozCEeIQOi2PtCWg1JalSglcKdk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft-ECVuuRSUvc3IMq2-ms2s1e1_c0_J8OyxBO0t-7uNQg&oe=69984472"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DAZ_PV\u30b5\u30e0\u30cd_250514.png", "id": "1385315602748624", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391926_1385315606081957_5473307483014484988_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zw9DNSMla-0Q7kNvwFplBiV&_nc_oc=AdksKTx1PAe_h_o6FqPfxgmItxL1kTJMMfeIQMFUALpVNowoPZcB2BsZNvCY9e1KSnw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftvOjMeTzK0T2eBn8W0WNxtqxmtqtMXKGLnGzrRzB52aw&oe=69984A98"}, "display_name": "Dada Zubaaan: The 360\u00b0 Puzzle Game", "keywords": ["puzzle", "casual", "logic", "handtracking", "connect"], "long_description": "# Move the Panels, Make Paths, and Master Dada Zubaaan!\nIn this electrifying VR slide puzzle game, you arrange mix-and-match panels into a juiced-up pathway from start to finish! As the circuits grow longer and longer, your score will surge\u2014just watch out for the time limit! Think you can slide together the perfect route and claim a spot at the top of the global leaderboard?\n\nWhy You'll Be Hooked:\n\nSATISFYING CONNECTIONS: There's nothing like the rush of seeing your planned pathway za-za-zap into place. Sometimes the most unexpected, winding route leads to the biggest score!\n\nIMMERSIVE EXPERIENCE: Feel the beat intensify as your pathway grows longer. Watch as snap-crackling light and sound effects sync up, and the world around you transforms. It's a feast for your senses that will keep your adrenaline pumping!\n\nMAXIMUM PLAYABILITY: With super simple one-handed, one-button controls, Dada Zubaaan is incredibly easy to pick up and play. Whether you're a seasoned gamer or new to VR, you'll be laying down circuits and chasing high scores in no time.\n\nZa-za-zap your way to the next level with the ultimate play: Dada Zubaaan!", "short_description": "Move the Panels, Make Paths, and Master Dada Zubaaan!\n\nIn this electrifying VR slide puzzle game, you arrange mix-and-match panels into a juiced-up pathway from start to finish! As the circuits grow longer and longer, your score will surge\u2014just watch out for the time limit! Think you can slide together the perfect route and claim a spot at the top of the global leaderboard?\n\nZa-za-zap your way to the next level with the ultimate play: Dada Zubaaan!"}, {"images": {"nodes": []}, "id": "1410665760247815", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dada Zubaaan: The 360\u00b0 Puzzle Game", "keywords": ["\u30d1\u30ba\u30eb", "\u30ab\u30b8\u30e5\u30a2\u30eb", "\u30ed\u30b8\u30c3\u30af", "\u30cf\u30f3\u30c9\u30c8\u30e9\u30c3\u30ad\u30f3\u30b0", "\u30b3\u30cd\u30af\u30c8"], "long_description": "# \u30e9\u30a4\u30f3\u3092\u3064\u306a\u3052\uff01\u3000\u8ab0\u3088\u308a\u3082\u9577\u304f\uff01\u3000\u8ab0\u3088\u308a\u3082\u65e9\u304f\uff01\n\nVR\u30b2\u30fc\u30e0\u300eD
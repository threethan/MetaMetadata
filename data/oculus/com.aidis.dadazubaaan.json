-7&_nc_sid=6e7a0a&_nc_ohc=RhcbgnIyiskQ7kNvwHaqCul&_nc_oc=AdkQT-EBZOIiHR09quPElirRhB_CLTiwot-SzN5y8Pghyk35mTmkEaST9rLg_3oHSFM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuKn6fNflJwuxSQfrQPvj2nH_n-Yt5MQ2_GjzszSoWaYg&oe=6999AF76"}, {"file_name": "4_Image Sequence_003_7650.png", "id": "1928196147921708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617834_1928196151255041_156936990506898640_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arSomaOPNZMQ7kNvwHnZ35m&_nc_oc=Adm_4q4hpx2nOl1uk-987e_CEsBi5nCPiJtFlLRQUlfvwUvI8K3wglfmvEgbEnhGjgE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvRhRLLrR_lB_XFVPHdYEfmp5RWlGivHSEjNlmRrLPayg&oe=6999A7D8"}, {"file_name": "5_Image Sequence_003_8213.png", "id": "1355545359063790", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623571_1355545362397123_8347217772719337435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_IL9Y-Qh8AQ7kNvwGWhZ7V&_nc_oc=AdkDAx8rKpTIEjT0MNuQa0t4tnrbSSCiyo52mPDJE0jHRcSAafmUDz96BOIU7l6nw2A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftmcJH3Q01pS0XdEuhmeFKVstSCrF-EtjTZxTB32-rUrA&oe=699995F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DAZ_PV\u30b5\u30e0\u30cd_250514.png", "id": "1385315602748624", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391926_1385315606081957_5473307483014484988_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zw9DNSMla-0Q7kNvwFkW8ja&_nc_oc=AdkcHCv6oYnlwYdJeqi3Kk01NfcBvjt9CJsx9IRG8r4Kley86BcUQj-dvooFhXy7EY0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuU851nWzWCnPy-PgS6mMPGrDqfGKGKSTkC37EojQ4NvQ&oe=69999C18"}, "display_name": "Dada Zubaaan: The 360\u00b0 Puzzle Game", "keywords": ["puzzle", "casual", "logic", "handtracking", "connect"], "long_description": "# Move the Panels, Make Paths, and Master Dada Zubaaan!\nIn this electrifying VR slide puzzle game, you arrange mix-and-match panels into a juiced-up pathway from start to finish! As the circuits grow longer and longer, your score will surge\u2014just watch out for the time limit! Think you can slide together the perfect route and claim a spot at the top of the global leaderboard?\n\nWhy You'll Be Hooked:\n\nSATISFYING CONNECTIONS: There's nothing like the rush of seeing your planned pathway za-za-zap into place. Sometimes the most unexpected, winding route leads to the biggest score!\n\nIMMERSIVE EXPERIENCE: Feel the beat intensify as your pathway grows longer. Watch as snap-crackling light and sound effects sync up, and the world around you transforms. It's a feast for your senses that will keep your adrenaline pumping!\n\nMAXIMUM PLAYABILITY: With super simple one-handed, one-button controls, Dada Zubaaan is incredibly easy to pick up and play. Whether you're a seasoned gamer or new to VR, you'll be laying down circuits and chasing high scores in no time.\n\nZa-za-zap your way to the next level with the ultimate play: Dada Zubaaan!", "short_description": "Move the Panels, Make Paths, and Master Dada Zubaaan!\n\nIn this electrifying VR slide puzzle game, you arrange mix-and-match panels into a juiced-up pathway from start to finish! As the circuits grow longer and longer, your score will surge\u2014just watch out for the time limit! Think you can slide together the perfect route and claim a spot at the top of the global leaderboard?\n\nZa-za-zap your way to the next level with the ultimate play: Dada Zubaaan!"}, {"images": {"nodes": []}, "id": "1410665760247815", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dada Zubaaan: The 360\u00b0 Puzzle Game", "keywords": ["\u30d1\u30ba\u30eb", "\u30ab\u30b8\u30e5\u30a2\u30eb", "\u30ed\u30b8\u30c3\u30af", "\u30cf\u30f3\u30c9\u30c8\u30e9\u30c3\u30ad\u30f3\u30b0", "\u30b3\u30cd\u30af\u30c8"], "long_description": "# \u30e9\u30a4\u30f3\u3092\u3064\u306a\u3052\uff01\u3000\u8ab0\u3088\u308a\u3082\u9577\u304f\uff01\u3000\u8ab0\u3088\u308a\u3082\u65e9\u304f\uff01\n\nVR\u30b2\u30fc\u30e0\u300eD
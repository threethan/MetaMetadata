300137257462_6202415824327586391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9b6bn6WfD0Q7kNvwEXjLku&_nc_oc=AdqGYw57JLFRAG4o-MZqDi02H3A5z0PQNPWwlicMnAs1tZLxdUR04L_Hgw2qvwSyQbc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXw0gA8_6lmpIFijIsQ8LOjk7SiIR-SriQv14XDlJSyg&oe=6ACA514F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Truco Mineiro VR", "keywords": [], "long_description": "Take a seat at the Truco Mineiro VR table for a Brazilian card game played in two teams of two.\n\nPlay solo with three bots or join an online table with up to four players. Bots can fill empty seats, and optional voice chat lets you talk with the players at your table.\n\nPlay seated in virtual or mixed reality using controllers or hand tracking. Adjust the table height, the size and height of your hand cards, and the scoreboard size to suit your setup. Background music has its own volume control.\n\nEnjoy our house variant of Truco Mineiro, with fixed high cards (manilhas) and raises of 3, 6, 9 and 12 points. There is no real-money wagering.\n\nIMPORTANT: The interface and recorded character voices are available only in Brazilian Portuguese. An internet connection is required for all modes, including solo play. The app accesses a hosted WebXR game.", "short_description": "Play Brazilian Truco seated in VR or mixed reality, solo with bots or at a four-seat online table. Optional voice chat. Brazilian Portuguese interface and game voices. Internet required, including solo play."}, {"images": {"nodes": []}, "id": "1546273586780899", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Truco Mineiro VR", "keywords": [], "long_description": "Take a seat at the Truco Mineiro VR table for a Brazilian card game played in two teams of two.\n\nPlay solo with three bots or join an online table with up to four players. Bots can fill empty seats, and optional voice chat lets you talk with the players at your table.\n\nPlay seated in virtual or mixed reality using controllers or hand tracking. Adjust the table height, the size and height of your hand cards, and the scoreboard size to suit your setup. Background music has its own volume control.\n\nEnjoy our house variant of Truco Mineiro, with fixed high cards (manilhas) and raises of 3, 6, 9 and 12 points. There is no real-money wagering.\n\nIMPORTANT: The interface and recorded character voices are available only in Brazilian Portuguese. An internet connection is required for all modes, including solo play. The app accesses a hosted WebXR game.", "short_description": "Play Brazilian Truco seated in VR or mixed reality, solo with bots or at a four-seat online table. Optional voice chat. Brazilian Portuguese interface and game voices. Internet required, including solo play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trucovr.codex.app.br/privacidade", "developer_terms_of_service_url": null, "publisher_name": "Daniel Lima da Silva", "support_website_url": "https://trucovr.codex.app.br/suporte", "website_url": "https://trucovr.codex.app.br/sobre", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1404291742756447"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1385707127083749"}]}, "baseline_offer": {"id": "1385707127083749"}, "is_appr
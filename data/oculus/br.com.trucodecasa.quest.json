718149881_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2sy31ZDo6gQ7kNvwGtnwwD&_nc_oc=AdoiS1LEm1EaXENxNi1VZL23UcFKkhxIcBQrfduwEVTeDG4jnHB46PGr_eb-3vtfYkk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUpptRwav6f4iuvqOzg2zDDwE8bii0bdZtIAeMulF9nA&oe=6ACA62DF"}, {"file_name": "01-comandos-truco-2560x1440.png", "id": "1805025547349084", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831299_1805025550682417_470135348598191882_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7I0fvdAg-8Q7kNvwGSJ0tm&_nc_oc=Adrce0sy4LF5a0w2MUH08DPxI2hMGy7wRtvEAQ-mBmt5eTxbBWZcF-v71wGF1RPfWOs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOM_QVTqKxA9cYHD36WqbHjlaENBmu3GLSWzBcpdy-sEA&oe=6ACA773C"}, {"file_name": "05-nova-mao-2560x1440.png", "id": "1068632179423220", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831393_1068632182756553_5429157538835437800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbAsnkyqlDAQ7kNvwFTfAcF&_nc_oc=AdooHaSsHe_hxGOVITbGa68181ntsNzkq3YbtoP3h2BRihchjW4Qo7hGJHvizDqCJQU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJtpgM26-KzFD9qRwqx9Ao0NmbP1yVXBjAT2QMzw2efw&oe=6ACA7279"}, {"file_name": "02-placar-e-duplas-2560x1440.png", "id": "822385690934004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831393_822385694267337_7140323866959399756_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZ548lsHtaIQ7kNvwGoEmfj&_nc_oc=AdoVIaSX6MzGnk_31T-sMWnNQKl6Ql73Dc3T8cSVYB41RRyZBKvr3amVziQAIleClaM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPya7ndVdQ7ssWUKgOxtJvSoYVbZRzAtUBPSJyoxdOpLg&oe=6ACA53B5"}, {"file_name": "04-dois-de-paus-2560x1440.png", "id": "1383300133924129", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595129854_1383300137257462_6202415824327586391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9b6bn6WfD0Q7kNvwEXjLku&_nc_oc=AdqGYw57JLFRAG4o-MZqDi02H3A5z0PQNPWwlicMnAs1tZLxdUR04L_Hgw2qvwSyQbc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXw0gA8_6lmpIFijIsQ8LOjk7SiIR-SriQv14XDlJSyg&oe=6ACA514F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Truco Mineiro VR", "keywords": [], "long_description": "Take a seat at the Truco Mineiro VR table for a Brazilian card game played in two teams of two.\n\nPlay solo with three bots or join an online table with up to four players. Bots can fill empty seats, and optional voice chat lets you talk with the players at your table.\n\nPlay seated in virtual or mixed reality using controllers or hand tracking. Adjust the table height, the size and height of your hand cards, and the scoreboard size to suit your setup. Background music has its own volume control.\n\nEnjoy our house variant of Truco Mineiro, with fixed high cards (manilhas) and raises of 3, 6, 9 and 12 points. There is no real-money wagering.\n\nIMPORTANT: The interface and recorded character voices are available only in Brazilian Portuguese. An internet connection is required for all modes, including solo play. The app accesses a hosted WebXR game.", "short_description": "Play Brazilian Truco seated in VR or mixed reality, solo with bots or at a four-seat online table. Optional voice chat. Brazilian Portuguese interface and game voices. Internet required, including solo play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trucovr.codex.app.br/privacidade", "developer_terms_of_service_url": null, "publisher_name": "Daniel Lima da Silva", "support_website_url": "https://trucovr.codex.app.br/suporte", "website_url": "https://trucovr.codex.app.br/sobre", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_grap
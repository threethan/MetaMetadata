a&_nc_ohc=ajnjS_ijedsQ7kNvwFCdB6t&_nc_oc=Adq7ZCFhQwyjJcSjUVZb2bgHCNIl48QTCcJVd9L67T-_bQeYdr4PyOx4chb_Qrv9F_8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwG40Se8-cpA3R71jgp_x7MB9XHabTm608DLdAWqJ-PlQ&oe=69CA64FE"}, {"file_name": "com.tristanjohn.VFLakkurnaCove-20251231-214406.jpg.png", "id": "845492991799672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818849_845492995133005_9082985627936215780_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-RlT-lk9sAQ7kNvwEeJRVb&_nc_oc=AdpgSudQP8dwfP5yXpWXJ-_1S-xz8U1KiRCnVWlv-Hfp23IeF1-hqPuOVgKJbVoGD9w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzH_noMYXLKCDNf11GC5MY_gH1uEXI6QTzlsgJrMNdHtw&oe=69CA6138"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VFLakkurnaCove-TCover.png", "id": "1551118296611777", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821696_1551118299945110_1043606847527734575_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hc7DNnFD8JsQ7kNvwHnFHyE&_nc_oc=Adr0t74mU4qS0JLurKZEO6xfybOTnl30XNTb_LmImtOJRrzQgipeamUtcH-aJSsKwV4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyC7h4Aa7E5vkHo5uKedzS6a3WU6GGDwHPvkXj5IeTKmQ&oe=69CA7FDD"}, "display_name": "VirtuaFOIL: Lakkurna Cove", "keywords": [], "long_description": "VirtuaFOIL: Lakkurna Cove is a flat-water hydro-foiling/foil-boarding experience that places you in the heart of the enchanting \"Lakkurna Cove\". Fictionally known for its epic sunsets and perfect, crystalline waters, Lakkurna is also home to a reclusive fishing community said to keep guard over the Cove's more magical spots.  Impress the locals and gain access to every area within this 500-meter cove. \nWhether you're playing in auto-acceleration mode to carve out and explore the cove or in \"physical mode\" to burn off today's caloric surplus, you'll always have a set-up that matches your needs.\nAdditionally, VirtuaFoil: Lakkurna Cove also features a stellar soundtrack and an adjustable time-of-day function that locks-in the tone.\nDon't forget to send postcards!", "short_description": "Hop on your hydrofoil, set-up your ride-style and carve the waters of the legendary Lakkurna Cove!"}]}, "developer_name": "Tristan John", "developer_privacy_policy_url": "https://tristan-john.com/Privacy/VFLakkurnaCove/index.html", "developer_terms_of_service_url": null, "publisher_name": "Tristan John", "support_website_url": null, "website_url": "https://www.tristan-john.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25461535416803375"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821674_919200920455288_8724079002837412665_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBZLUOjHm8UQ7kNvwHnAdWG&_nc_oc=AdoqY9Ia_FXcGPyJlHqhM8eOsUABApVXO_IRNg9h4Z498NfOI5fVOqG8zTZEuJp8DuY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQvz9lLog4OeW2fwcinwY5c2cg8ZxI-PTx803QAbor6w&oe=69CA6767"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VirtuaFOIL: Lakkurna Cove", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simul
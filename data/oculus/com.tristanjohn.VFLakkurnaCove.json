/scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823790_865251396508897_3040146289862764066_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QT3-VWH6_ZkQ7kNvwGywzqu&_nc_oc=AdrahksmW_qRzhNJ4R0Bpfw0mH77K_P4y4tBM8YMzw1VSIORQhr_FP0XePno1_QpXio&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmwttlQ0811lNTk7wbWHVvmVGlg1yKwAe84PMby245QQ&oe=6A882028"}, {"file_name": "com.tristanjohn.VFLakkurnaCove-20251231-213301.jpg.png", "id": "1649660476019566", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822327_1649660479352899_6306840888716759392_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwSV6-Sm7qAQ7kNvwGMTMm6&_nc_oc=AdqmJDAlyAiifUGaGKeMkDaqqyPhOJ3SYO03klXDOKZa3RqmHWKlGSY3yqArSOsmB38&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-QFNeOOYKsDj0e1hJ3Z5WQLd64hN4Ih149FdGLDYxxQ&oe=6A883CFE"}, {"file_name": "com.tristanjohn.VFLakkurnaCove-20251231-214406.jpg.png", "id": "845492991799672", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491818849_845492995133005_9082985627936215780_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGEKwu6o_AcQ7kNvwH3wTzb&_nc_oc=AdrF5R2CK4_e-M_o8y-bkVFbMhao2Cfalkm6HnMbtLunN3YsHTjQZAZr-6JxZv_M6eQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgtIHYIx_VFCYiLNXftDbiXDDn1iLquaiwKn1VyFJC5g&oe=6A883938"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VFLakkurnaCove-TCover.png", "id": "1551118296611777", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491821696_1551118299945110_1043606847527734575_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=isfXc3p8Kx8Q7kNvwFBTsYH&_nc_oc=AdpErLw07RFeNvryL5KhnUy2v0Rf5CIGp5a8WNrHyWcfBDSM_5tcgNV6jnZZih19UAU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEB0ILqT5YG8WF4Bok7wxXQdvk5RMPHVePWG0_3yl5lnA&oe=6A881F9D"}, "display_name": "VirtuaFOIL: Lakkurna Cove", "keywords": [], "long_description": "VirtuaFOIL: Lakkurna Cove is a flat-water hydro-foiling/foil-boarding experience that places you in the heart of the enchanting \"Lakkurna Cove\". Fictionally known for its epic sunsets and perfect, crystalline waters, Lakkurna is also home to a reclusive fishing community said to keep guard over the Cove's more magical spots.  Impress the locals and gain access to every area within this 500-meter cove. \nWhether you're playing in auto-acceleration mode to carve out and explore the cove or in \"physical mode\" to burn off today's caloric surplus, you'll always have a set-up that matches your needs.\nAdditionally, VirtuaFoil: Lakkurna Cove also features a stellar soundtrack and an adjustable time-of-day function that locks-in the tone.\nDon't forget to send postcards!", "short_description": "Hop on your hydrofoil, set-up your ride-style and carve the waters of the legendary Lakkurna Cove!"}]}, "developer_name": "Tristan John", "developer_privacy_policy_url": "https://tristan-john.com/Privacy/VFLakkurnaCove/index.html", "developer_terms_of_service_url": null, "publisher_name": "Tristan John", "support_website_url": null, "website_url": "https://www.tristan-john.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25461535416803375"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1641051483804690"}, {"status": "PUBLISHED", "id": "1258304303024333"}]}, "ba
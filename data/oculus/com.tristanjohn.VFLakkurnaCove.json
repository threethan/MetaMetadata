dn.com/v/t64.5771-25/491823790_865251396508897_3040146289862764066_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vKq_5ugLJ4Q7kNvwEiPyyg&_nc_oc=AdoJahbQWqU2mMPsrFMmFknTSgEKH0euun20fzKvYx-K1Mlyr7_Jjd_rrQJO2SoOBNc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzJm9Gie0GErdyrz6oUyAFRDixYqT7n4RGV782s406T6Q&oe=69C3E8E8"}, {"file_name": "com.tristanjohn.VFLakkurnaCove-20251231-213301.jpg.png", "id": "1649660476019566", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822327_1649660479352899_6306840888716759392_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qx7beoIOkVMQ7kNvwFswa7g&_nc_oc=Adr8w4GfZANFzPDAiE_-feN8gqpCYAg9Cax3vNrc6NITByKY3LwGQtYn1UwpWUKzjXM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxk6aAP2CkCFua-_VMVcq7DW0hfmLZSuVO5suqnuyl5Rg&oe=69C3CD7E"}, {"file_name": "com.tristanjohn.VFLakkurnaCove-20251231-214406.jpg.png", "id": "845492991799672", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491818849_845492995133005_9082985627936215780_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bt-wUsFdpmkQ7kNvwFGkSns&_nc_oc=AdptpertVrOFDkNYbHNkiotNLVMpSMZxoPme4TwCtorogeuwRQ1P01WhB5vmGPpSk4g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8OziBjgGwt0ai5xqLn0VrKtvCW1hS_L9VYWYX87ivnw&oe=69C3C9B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VFLakkurnaCove-TCover.png", "id": "1551118296611777", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821696_1551118299945110_1043606847527734575_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Axa7nbcfp9IQ7kNvwERO6Mo&_nc_oc=AdqzF_ACDZMFagsmsAuyMmw85FHbbToC6Et561LZocCYcwxhtlkDrkogm2oWkRVJejE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyq7EgwUc8l59XwXQVg3CEZNrWvYJ09KaCc8FL2ZGLM-A&oe=69C3E85D"}, "display_name": "VirtuaFOIL: Lakkurna Cove", "keywords": [], "long_description": "VirtuaFOIL: Lakkurna Cove is a flat-water hydro-foiling/foil-boarding experience that places you in the heart of the enchanting \"Lakkurna Cove\". Fictionally known for its epic sunsets and perfect, crystalline waters, Lakkurna is also home to a reclusive fishing community said to keep guard over the Cove's more magical spots.  Impress the locals and gain access to every area within this 500-meter cove. \nWhether you're playing in auto-acceleration mode to carve out and explore the cove or in \"physical mode\" to burn off today's caloric surplus, you'll always have a set-up that matches your needs.\nAdditionally, VirtuaFoil: Lakkurna Cove also features a stellar soundtrack and an adjustable time-of-day function that locks-in the tone.\nDon't forget to send postcards!", "short_description": "Hop on your hydrofoil, set-up your ride-style and carve the waters of the legendary Lakkurna Cove!"}]}, "developer_name": "Tristan John", "developer_privacy_policy_url": "https://tristan-john.com/Privacy/VFLakkurnaCove/index.html", "developer_terms_of_service_url": null, "publisher_name": "Tristan John", "support_website_url": null, "website_url": "https://www.tristan-john.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25461535416803375"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1258304303024333"}]}, "baseline_offer": {"id": "1258304303024333"}, "is_approved": true, "firstOffer
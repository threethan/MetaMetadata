a&_nc_ohc=oXh1_nurnWIQ7kNvwHH-_X6&_nc_oc=Adr2JKpBwxJOrNJDCAZzA6Z-um-6ncw490O9eqwmkfY0luSEHiwk0YMJboU-AQa_Vqw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCWDANdxCLGgkOZC0uqSftdLIPVqUNtFnZc3PWPD9ppg&oe=69CFAAFE"}, {"file_name": "com.tristanjohn.VFLakkurnaCove-20251231-214406.jpg.png", "id": "845492991799672", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491818849_845492995133005_9082985627936215780_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFeQvIPpT_8Q7kNvwHhdXFT&_nc_oc=Adptiiyg33dplGN8_jcl7wmuJiPYh_daaG1K6oPbsvOT35WNjYVxrmWi5Z_vR2KoZ9o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwG2XPPtyluNwM9uV0Smm78Vy72AoM_NXgue5klEkJckA&oe=69CFA738"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VFLakkurnaCove-TCover.png", "id": "1551118296611777", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821696_1551118299945110_1043606847527734575_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcU5S-UZNVAQ7kNvwHCLNZK&_nc_oc=Adq1sGJJ1ma2ThV84MtU5Uo3VXKMVsgbvyGuKg37VJz3pDWWdZMyajeYi8pF5gTlgz8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfycTS8x63jIgqklaoDwMhz5hApqgHQ-94P4ECiH_zm6Jw&oe=69CFC5DD"}, "display_name": "VirtuaFOIL: Lakkurna Cove", "keywords": [], "long_description": "VirtuaFOIL: Lakkurna Cove is a flat-water hydro-foiling/foil-boarding experience that places you in the heart of the enchanting \"Lakkurna Cove\". Fictionally known for its epic sunsets and perfect, crystalline waters, Lakkurna is also home to a reclusive fishing community said to keep guard over the Cove's more magical spots.  Impress the locals and gain access to every area within this 500-meter cove. \nWhether you're playing in auto-acceleration mode to carve out and explore the cove or in \"physical mode\" to burn off today's caloric surplus, you'll always have a set-up that matches your needs.\nAdditionally, VirtuaFoil: Lakkurna Cove also features a stellar soundtrack and an adjustable time-of-day function that locks-in the tone.\nDon't forget to send postcards!", "short_description": "Hop on your hydrofoil, set-up your ride-style and carve the waters of the legendary Lakkurna Cove!"}]}, "developer_name": "Tristan John", "developer_privacy_policy_url": "https://tristan-john.com/Privacy/VFLakkurnaCove/index.html", "developer_terms_of_service_url": null, "publisher_name": "Tristan John", "support_website_url": null, "website_url": "https://www.tristan-john.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25461535416803375"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821674_919200920455288_8724079002837412665_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrUcqgje_7YQ7kNvwElhDgo&_nc_oc=Adp-05RJLR-b4vc5qqDOYiw9IStjSSgEvD9wn8-hTvjtKU4RE66Gha3MpFC69EouIT8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwEzcXynlNWAeysuTAWXotW1q88_akfkMgLYBeEqCdfyg&oe=69CFAD67"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VirtuaFOIL: Lakkurna Cove", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simul
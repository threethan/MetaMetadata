uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499310817_907916809022530_5233820162095046252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STtuLoyxrDIQ7kNvwHm4B9u&_nc_oc=Adr1iMl9EorJ71DYhN5QHJ4MN8zDVxzv1922IB8um8E5EhuBkBAFpC_xGilVErabQlg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGO5m3V7gU1KR-PoPQK1ot07PLo_-c8cmEJASCK49RUAA&oe=6A916376"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1440916811138217", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499310720_1440916814471550_7981136356965931799_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8LOje8zQpwQ7kNvwH5cBC1&_nc_oc=Ado0YWjCRslvg1szefdgmSIYP_JulyugdW-yztJB-cLHGENzucl4LYmL2tmcU7k9Bj4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyXTDfSNFTs10x5HBt7NkvqlJCTTnpTXdyI-bhkUcrjw&oe=6A9184B5"}, "display_name": "Escape From Asylum", "keywords": ["Escape", "Survival", "Puzzle", "VR", "Horror"], "long_description": "Trapped in the Dark. No Weapons. Only Your Wits.\n\nYou awaken inside the freezing, pitch-black corridors of an abandoned mental facility with zero memory of your identity. In Escape from Asylum, brute force will not save you\u2014your survival relies entirely on observation, logic, and keeping your composure under intense psychological VR horror.\n\nStep into a gripping survival puzzle adventure built from the ground up to test your deduction skills in room-scale Virtual Reality.\n\nCORE FEATURES:\n\nAtmospheric Survival Thriller: Experience dynamic lighting, ambient silence, and oppressive sound design that build real psychological tension\u2014no cheap jump scares.\n\nEnvironmental Investigation: Meticulously search physical patient records, decipher cryptic wall scribbles, and inspect forgotten reports to unlock hidden secrets.\n\nComplex Logic & Code-Breaking: Crack security doors, open safe locks, and solve intricate mechanical puzzles by discovering passwords scattered across dark sectors.\n\nUnravel a Dark Mystery: Piece together the asylum's sinister history while uncovering the lost fragments of your character's forgotten past.\n\nOptimized for Quest: Features natural motion-controller interactions, fluid locomotion options, and room-scale gameplay designed to maximize immersion.\n\nCan you maintain your sanity in the darkness and find a way out, or will the asylum claim you?", "short_description": "Escape from Asylum is an atmospheric VR horror puzzle game for Meta Quest. Trapped in a dark, abandoned asylum with amnesia, you have no weapons\u2014only your wits. Explore eerie corridors, search files for hidden clues, crack cryptic passwords, and piece together your identity to survive this psychological escape room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/solorage/home", "developer_terms_of_service_url": null, "publisher_name": "SoloRage", "support_website_url": null, "website_url": "https://sites.google.com/view/solorage", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "1196335763565320"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499313074_1316834770648946_3452828050418523648_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHKxMyES8bEQ7kNvwFm3_P9&_nc_oc=AdrtPCnFz7FkjMe62_IbrjJw90AMmdY8uOfBRzq
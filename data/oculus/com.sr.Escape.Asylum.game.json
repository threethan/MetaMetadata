99_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8LOje8zQpwQ7kNvwH5cBC1&_nc_oc=Ado0YWjCRslvg1szefdgmSIYP_JulyugdW-yztJB-cLHGENzucl4LYmL2tmcU7k9Bj4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyXTDfSNFTs10x5HBt7NkvqlJCTTnpTXdyI-bhkUcrjw&oe=6A9184B5"}, "display_name": "Escape From Asylum", "keywords": ["escape", "puzzle", "dark", "Asylum", "horror"], "long_description": "Step into the chilling world of Escape from Asylum, a VR survival puzzle adventure designed to test your memory, courage, and determination. You awaken inside a forgotten asylum, stripped of your identity, surrounded by shadows, and haunted by silence. The only way out is through exploration, deduction, and sheer willpower. Every corridor hides secrets, every locked door demands a password, and every clue brings you closer to freedom \u2014 or deeper into the asylum\u2019s mysteries.\n\nKey Features\nImmersive VR Exploration: Designed specifically for Meta Quest, the asylum environment surrounds you with atmospheric detail \u2014 flickering lights, echoing footsteps, and unsettling silence.\n\nPuzzle\u2011Driven Progression: Unlock doors by finding and decoding passwords hidden in walls, reports, and environmental clues.\n\nEnvironmental Storytelling: Patient records, staff reports, and cryptic notes reveal fragments of the asylum\u2019s history and your own forgotten past.\n\nMemory & Identity: The central mystery revolves around who you are and why you are trapped. Each clue brings you closer to the truth.\n\nAtmospheric Horror: No jump scares \u2014 instead, tension builds through sound design, lighting, and the oppressive environment.\n\nOptimized Performance: Smooth gameplay, realistic physics, and dynamic lighting ensure immersion without compromise.\n\nReplay Value: Multiple paths, hidden clues, and alternative interpretations of the asylum\u2019s story encourage replay and deeper exploration.", "short_description": "Escape from Asylum is a VR survival puzzle experience where exploration and deduction are your only tools. Navigate eerie corridors, uncover hidden clues, and piece together fragments of your identity while fighting the urge to panic in the darkness.\n\nGameplay Highlights:\nExplore a fully immersive asylum environment in VR.\nSearch walls, documents, and reports for hidden clues.\nSolve puzzles and unlock doors by discovering passwords.\nPiece together your lost identity through storytelling"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/solorage/home", "developer_terms_of_service_url": null, "publisher_name": "SoloRage", "support_website_url": null, "website_url": "https://sites.google.com/view/solorage", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "1125162937349270"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1018974567567288"}, {"status": "PUBLISHED", "id": "1641069517619462"}, {"status": "PUBLISHED", "id": "898690889181280"}]}, "baseline_offer": {"id": "898690889181280"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "1018974567567288"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1184257611439802", "version": "1.1.7"}, "id": "1681739866359734", "channel_name": "LIVE"}]}, "i
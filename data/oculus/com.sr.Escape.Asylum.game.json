WS0g0OYQ7kNvwHcXgv0&_nc_oc=Adrwq5jmhwQg6t-xD39lcQKPMhfBZQH4OKl638CFoGeNE8f_ROikgRytwIOmK5eAe-c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7poMmWILkNg_y2yi-4Lp70gzqO33LqewGveQfN9hnMA&oe=6ABBB4B5"}, "display_name": "Escape From Asylum", "keywords": ["escape", "puzzle", "dark", "Asylum", "horror"], "long_description": "Step into the chilling world of Escape from Asylum, a VR survival puzzle adventure designed to test your memory, courage, and determination. You awaken inside a forgotten asylum, stripped of your identity, surrounded by shadows, and haunted by silence. The only way out is through exploration, deduction, and sheer willpower. Every corridor hides secrets, every locked door demands a password, and every clue brings you closer to freedom \u2014 or deeper into the asylum\u2019s mysteries.\n\nKey Features\nImmersive VR Exploration: Designed specifically for Meta Quest, the asylum environment surrounds you with atmospheric detail \u2014 flickering lights, echoing footsteps, and unsettling silence.\n\nPuzzle\u2011Driven Progression: Unlock doors by finding and decoding passwords hidden in walls, reports, and environmental clues.\n\nEnvironmental Storytelling: Patient records, staff reports, and cryptic notes reveal fragments of the asylum\u2019s history and your own forgotten past.\n\nMemory & Identity: The central mystery revolves around who you are and why you are trapped. Each clue brings you closer to the truth.\n\nAtmospheric Horror: No jump scares \u2014 instead, tension builds through sound design, lighting, and the oppressive environment.\n\nOptimized Performance: Smooth gameplay, realistic physics, and dynamic lighting ensure immersion without compromise.\n\nReplay Value: Multiple paths, hidden clues, and alternative interpretations of the asylum\u2019s story encourage replay and deeper exploration.", "short_description": "Escape from Asylum is a VR survival puzzle experience where exploration and deduction are your only tools. Navigate eerie corridors, uncover hidden clues, and piece together fragments of your identity while fighting the urge to panic in the darkness.\n\nGameplay Highlights:\nExplore a fully immersive asylum environment in VR.\nSearch walls, documents, and reports for hidden clues.\nSolve puzzles and unlock doors by discovering passwords.\nPiece together your lost identity through storytelling"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/solorage/home", "developer_terms_of_service_url": null, "publisher_name": "SoloRage", "support_website_url": null, "website_url": "https://sites.google.com/view/solorage", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "1125162937349270"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1261741090358120", "version": "1.2.1"}, "id": "1681739866359734", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1125162930682604", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "126174109
701317_1357713027080032279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mga0qkry74sQ7kNvwE12f-k&_nc_oc=AdqN_7Mbpb-IzJeeY4yXXq3YDmgt5RQR8LYKnyxuWHlEI2uaNbv90iBAnVKYd10ZyXg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzPbGV000Dxuok9iWB39mNo2_Yh9O8nUj8PpINxWWkMQ&oe=6AF4913B"}, {"file_name": "ss2.png", "id": "2647291915752877", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307303_2647291919086210_1380669856098353053_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEn0fAtGXYcQ7kNvwH8ZeH4&_nc_oc=Adpspp7k0LYQPkxcNRfSmVZvd-lDlRG7gfxaUBRvDP4gPDZF1-AogHyDCiMnauIEwL0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFW6z_aSFfJtotxxjd_7l0gNzSl9bzSsgRULrFz4XikA&oe=6AF49AE3"}, {"file_name": "ss5.png", "id": "1664854721917999", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499292329_1664854725251332_4173828494447019898_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gxX_zz5un4Q7kNvwENmPyM&_nc_oc=AdpFWtc2tpaKB5Jaqs3inwgUu89Pu-ygtElNa9lC1Ym6cjkU3xS8yWRDULpyj9rc7ng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTP6_huOzXb9IcaFsQXXmuAyVGKcGu7sB9L4VAVqcmrqg&oe=6AF49753"}, {"file_name": "ss4.png", "id": "1121777240271190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299051_1121777243604523_5922379411983292259_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLOV8eKLxTkQ7kNvwHuR5Vq&_nc_oc=AdqB8JqIL76QBPXsmTftr3xFtUPW_5tgNW7ngD3Oi_iIju-yHAaVbDCiHJoZXE1IqPU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTFK_pi0vnB_sWexVMXU9wB36pxEsV5Udr5typOJsMRQ&oe=6AF486AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Knuckleheads", "keywords": ["ragdoll", "physicsbrawler", "fighting", "multiplayer", "partygame"], "long_description": "Knuckleheads is a silly physics brawler for VR. You fight with your own two arms, and so does everyone else.\n\nPunch people. Grab people. Climb on people. Pick up a crate and throw it at people. When someone gets knocked out they go limp, so you can carry them around and toss them wherever you like.\n\nEvery punch, grab and faceplant is physics, so fights get messy fast.\n\n**Features**\n\n- Real VR punching. Swing harder, hit harder.\n- Damage builds up until someone drops, and headshots hit twice as hard.\n- Put your hands up to block, until your guard breaks.\n- Grab and swing crates, planks and crowbars.\n- Climb up other players and hang on until your grip gives out.\n- Carry and throw knocked-out players.\n- Online multiplayer with friends.", "short_description": "Knuckleheads is a silly VR brawler with floppy physics bodies and clumsy fistfights. Punch, grab, climb and throw your friends around online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://loosetooth.games/knuckleheads/privacy", "developer_terms_of_service_url": "https://loosetooth.games/knuckleheads/terms", "publisher_name": "Loosetooth Games", "support_website_url": null, "website_url": "https://loosetooth.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "1700921480735423"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1279889041882035"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2314714309370982"}, {"status": "PUBLISHED", "id": "1630526455524546"}]}, "baseline_offer": {"id": "1630526455524546"}, "is_approved": true, "firstOffer": {"n
701317_1357713027080032279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUg23gpmOBoQ7kNvwGiZWrM&_nc_oc=Adp6IYR-2jye2web2weCra2dSsmJcLhZ_FB4vFqLT2piWLZ7E8H9Ra21TW78jtIVMo0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_Ik8PZKvFX-wkLL5OFsDBwWGevSn3_g3WGuBEf4vHBA&oe=6AE21C3B"}, {"file_name": "ss2.png", "id": "2647291915752877", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307303_2647291919086210_1380669856098353053_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Py2zQ79MuMgQ7kNvwE6dug_&_nc_oc=AdqJELwo0WGaqJi2ZWY5O_U2fmvDp4I-4ArpGtaRkXlIGCxRdF0jpOzfDr-93WkGCq4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMclqazk_t0wJMnzgzvLs_6-Cljrt4mFTfuFuIpcrOpg&oe=6AE1EDA3"}, {"file_name": "ss5.png", "id": "1664854721917999", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499292329_1664854725251332_4173828494447019898_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnQduPKJJjsQ7kNvwEN1LWP&_nc_oc=Ado4eFmhra2crjS44Mx96e4P5pqSwXmeCkTGn-eb4kld52l06PwnfednrmPhG_0aZdI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyX5c2BOKpuxwECGCx62D5ShXvbZvDpF676IBj9fKphQ&oe=6AE1EA13"}, {"file_name": "ss4.png", "id": "1121777240271190", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299051_1121777243604523_5922379411983292259_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxlP1M073rsQ7kNvwFhfAYG&_nc_oc=AdqVtTe28P0g1Gkj0Exft3oB3uj65Mz61bWhlLFid5lsgHrnwhl6nHanBm6zuWezG3g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxlVVih38zif-1CnmB8aCLgoNBOJ2BoSaT3YW14qeZsQ&oe=6AE211AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Knuckleheads", "keywords": ["ragdoll", "physicsbrawler", "fighting", "multiplayer", "partygame"], "long_description": "Knuckleheads is a silly physics brawler for VR. You fight with your own two arms, and so does everyone else.\n\nPunch people. Grab people. Climb on people. Pick up a crate and throw it at people. When someone gets knocked out they go limp, so you can carry them around and toss them wherever you like.\n\nEvery punch, grab and faceplant is physics, so fights get messy fast.\n\n**Features**\n\n- Real VR punching. Swing harder, hit harder.\n- Damage builds up until someone drops, and headshots hit twice as hard.\n- Put your hands up to block, until your guard breaks.\n- Grab and swing crates, planks and crowbars.\n- Climb up other players and hang on until your grip gives out.\n- Carry and throw knocked-out players.\n- Online multiplayer with friends.", "short_description": "Knuckleheads is a silly VR brawler with floppy physics bodies and clumsy fistfights. Punch, grab, climb and throw your friends around online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://loosetooth.games/knuckleheads/privacy", "developer_terms_of_service_url": "https://loosetooth.games/knuckleheads/terms", "publisher_name": "Loosetooth Games", "support_website_url": null, "website_url": "https://loosetooth.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "1700921480735423"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1279889041882035"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1630526455524546"}]}, "baseline_offer": {"id": "1630526455524546"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792177260, "status": "PUBLI
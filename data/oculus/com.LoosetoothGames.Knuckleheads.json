701317_1357713027080032279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PztrpEASlh0Q7kNvwG2i_dN&_nc_oc=Ado-u49bW-UE94BpC28SzgJKGKasuPueREL-OEhxr9HLEvTNVjxl295Qfx28a6nmXOQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1oOHZSQICOcDf6_YzNBeGB7NwMbI5FtaZH5KA60tPNg&oe=6ADE27BB"}, {"file_name": "ss2.png", "id": "2647291915752877", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307303_2647291919086210_1380669856098353053_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwRYQ0lT6BoQ7kNvwHQwFwI&_nc_oc=AdooRv6cSO9jirtNMr3m3Mz-ugVbS5GzEOFkNmDapnYl3vN86BbyMhLG-8JMh7EwPrI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuSDFVfB9oIQmtgjkP9yoQMgDcEQI_NXndeROTVMDWQg&oe=6ADDF923"}, {"file_name": "ss5.png", "id": "1664854721917999", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499292329_1664854725251332_4173828494447019898_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kShPT8ZrlGkQ7kNvwH3Z7qU&_nc_oc=AdpmxH9YldDme48AvWOZnHkWRHWjTZb5fW-S3Wt2cyBYrlz2-lLbqZePbF2veZ-XHaw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNg51hr6UK_g35BivDXlgpyzKHYDk2yLhDHDc6I8yYmgA&oe=6ADDF593"}, {"file_name": "ss4.png", "id": "1121777240271190", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499299051_1121777243604523_5922379411983292259_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWRybBg2ojMQ7kNvwHMCSMa&_nc_oc=AdpWgZXEh98vXaRiD0a3NL9Q3DMCsi_yDKkLSbtqCVEFGjDqpik5wzL5aDle9NGbyGU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5yeh7EtcGhJpCkGJoT7_BwPKSBlhKj42RdjX0dtRn0A&oe=6ADE1D2E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Knuckleheads", "keywords": ["ragdoll", "physicsbrawler", "fighting", "multiplayer", "partygame"], "long_description": "Knuckleheads is a silly physics brawler for VR. You fight with your own two arms, and so does everyone else.\n\nPunch people. Grab people. Climb on people. Pick up a crate and throw it at people. When someone gets knocked out they go limp, so you can carry them around and toss them wherever you like.\n\nEvery punch, grab and faceplant is physics, so fights get messy fast.\n\n**Features**\n\n- Real VR punching. Swing harder, hit harder.\n- Damage builds up until someone drops, and headshots hit twice as hard.\n- Put your hands up to block, until your guard breaks.\n- Grab and swing crates, planks and crowbars.\n- Climb up other players and hang on until your grip gives out.\n- Carry and throw knocked-out players.\n- Online multiplayer with friends.", "short_description": "Knuckleheads is a silly VR brawler with floppy physics bodies and clumsy fistfights. Punch, grab, climb and throw your friends around online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://loosetooth.games/knuckleheads/privacy", "developer_terms_of_service_url": "https://loosetooth.games/knuckleheads/terms", "publisher_name": "Loosetooth Games", "support_website_url": null, "website_url": "https://loosetooth.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "1700921480735423"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1279889041882035"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1630526455524546"}]}, "baseline_offer": {"id": "1630526455524546"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792177260, "status": "PUBLI
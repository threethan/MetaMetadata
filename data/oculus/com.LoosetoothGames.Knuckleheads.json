701317_1357713027080032279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bueIhfX7j58Q7kNvwHJnWWB&_nc_oc=AdrvJzr-8eo4H8fDRQsyU-WoGi-HtGdLHt1WyAFcDUPV4d3z8iyIZOrwKpDmc060vHQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYctwsoIELtq76quZ1O51aKwQxd9j6LoPX6rCSd5UsUw&oe=6AF7343B"}, {"file_name": "ss2.png", "id": "2647291915752877", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307303_2647291919086210_1380669856098353053_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFn-6nVuklAQ7kNvwEVvETq&_nc_oc=Adr-Oo6eeeQF91tUS7X4_I6yxzXFLxW5suNhp4zoKkFtEmk8QykLa4cIrrdxqKh03yU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-FaXUBAqmkVL7tgwLIWflR20oLu6_BUQVEXDPTsXgrQ&oe=6AF73DE3"}, {"file_name": "ss5.png", "id": "1664854721917999", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499292329_1664854725251332_4173828494447019898_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45Gn5RLTpKMQ7kNvwFzleGa&_nc_oc=AdoI_UBxuIV-2XY4q4a7EzrQbHqif-jRFjhkMBqTM9USRUH0k8809eK4NNgaEyq09Hg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8RsE6kirSfrCF2SwlOaLFsBZcDIGMR0EnTlaggAsk1g&oe=6AF73A53"}, {"file_name": "ss4.png", "id": "1121777240271190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299051_1121777243604523_5922379411983292259_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92Z-r649nFcQ7kNvwFOWVtu&_nc_oc=AdqfGbZuFQNkBxoZEIqZ7aGmN6Md0NtLz_gq8ZawLQ_IUf3s51NtHZuZ46zDEfcpbs8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcdBx3AQpBWYMMrNgNtaxs8hsNZ7lN7o52ZehB_qVGug&oe=6AF729AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Knuckleheads", "keywords": ["ragdoll", "physicsbrawler", "fighting", "multiplayer", "partygame"], "long_description": "Knuckleheads is a silly physics brawler for VR. You fight with your own two arms, and so does everyone else.\n\nPunch people. Grab people. Climb on people. Pick up a crate and throw it at people. When someone gets knocked out they go limp, so you can carry them around and toss them wherever you like.\n\nEvery punch, grab and faceplant is physics, so fights get messy fast.\n\n**Features**\n\n- Real VR punching. Swing harder, hit harder.\n- Damage builds up until someone drops, and headshots hit twice as hard.\n- Put your hands up to block, until your guard breaks.\n- Grab and swing crates, planks and crowbars.\n- Climb up other players and hang on until your grip gives out.\n- Carry and throw knocked-out players.\n- Online multiplayer with friends.", "short_description": "Knuckleheads is a silly VR brawler with floppy physics bodies and clumsy fistfights. Punch, grab, climb and throw your friends around online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://loosetooth.games/knuckleheads/privacy", "developer_terms_of_service_url": "https://loosetooth.games/knuckleheads/terms", "publisher_name": "Loosetooth Games", "support_website_url": null, "website_url": "https://loosetooth.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "1700921480735423"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1279889041882035"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2314714309370982"}, {"status": "PUBLISHED", "id": "1630526455524546"}]}, "baseline_offer": {"id": "1630526455524546"}, "is_approved": true, "firstOffer": {"n
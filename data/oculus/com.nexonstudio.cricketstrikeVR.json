: null, "display_name": "Cricket Strike", "keywords": ["cricket", "realcricket", "ibcricket", "t20blast", "ipl"], "long_description": "\ud83c\udfae A Complete & Authentic Cricket Experience\n\nStep into Cricket Strike, a true-to-life VR cricket game built for fans who love realism, strategy, and match intensity. From pressure chases to legendary tournaments, every match feels competitive and authentic.\n\n\ud83d\udd79\ufe0f Game Modes\n\nChase Mode \u2013 Target-based run chases\nSuper Over \u2013 High-intensity tie-breaks\nDaily Challenges \u2013 Skill-based batting & bowling goals\nTraining Mode \u2013 Practice shots, timing, and match situations\n\n\ud83c\udf0d International Tournaments\n\nODI World Cup \u2013 2011, 2015, 2019, 2023\nT20 World Cup \u2013 2012, 2014, 2016, 2021, 2022, 2024, 2026\nU19 World Cup \u2013 2024\nWorld Championship of Legends (WCL) \u2013 2024, 2025\nAsia Cup (2024,2025)\nChampions Trophy (2017,2025)\n\ud83c\udfcfDomestic Leagues:\nIPL (2019\u20132025), BBL (2023), PPL (2024\u20132025), BPL (2024\u20132025), SPL (2024), T20 Blast (2023), WIPL (2024)\n\n\ud83c\udf0d Quick Match Mode\n\nChoose from 24 international teams, including India, Australia, England, Pakistan, South Africa, New Zealand, Sri Lanka, West Indies, Bangladesh, Afghanistan, and more.\n\n\ud83c\udfdf\ufe0f Stadiums & Match Conditions\n\nIconic stadiums inspired by Abu Dhabi, London, and Delhi, with dynamic morning, afternoon, evening, and night match conditions affecting lighting, pitch, and atmosphere.\n\n\ud83e\udde0 Advanced Gameplay Systems\n\nAI-based intelligent fielding\nAuthentic batting & bowling mechanics\nHindi & English commentary", "short_description": "Experience authentic cricket gameplay with multiple modes including Chase Mode, Super Over, Challenges, and full tournaments like 50 Over World Cup, 20 Over World Cup, and U19 World Cup. Play top domestic leagues such as IPL, BBL, PPL, BSL, SPL, T20 Blast, and WIPL. Featuring realistic stadiums, dynamic match conditions, AI-based fielding, Hindi & English commentary, Hawk-Eye, and Wagon Wheel analysis."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cricketstrike.nexonstudio.in/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "NEXON GAME STUDIO PRIVATE LIMITED", "support_website_url": null, "website_url": "https://nexonstudio.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25197416896589688"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1289725599569078"}, {"status": "PUBLISHED", "id": "1294635102629988"}, {"status": "PUBLISHED", "id": "1252263519822730"}]}, "baseline_offer": {"id": "1252263519822730"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1289725599569078"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26710414315289931", "version": "1.1"}, "id": "858132840103355", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25197416869923024", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26710414315289931"}, "release_status": "R
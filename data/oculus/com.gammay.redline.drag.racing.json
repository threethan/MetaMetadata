oe=6AFDD28A"}, {"file_name": "3.png", "id": "1475684470912135", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673652249_1475684474245468_4352173682472447612_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxxN3hRPFikQ7kNvwFZ_N_N&_nc_oc=AdqdNaVDOPPMkFtTMX31YKfB4hOnHTs6xEXnnPG0_j_z0ICTiqpJz-uKdS9QN1zh3fw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTh7C7v5vn_GC35xB5MNp_8nDgrYbcfIx26qNrKtuPYUg&oe=6AFDB883"}, {"file_name": "2.png", "id": "1061344323074321", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313063_1061344326407654_7350437569246365648_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHyTemlaEa0Q7kNvwEl3ar0&_nc_oc=AdrEJvmhi9xr6o3MCh91pN__CuB31Eo06SlBOKN7QV1mmoUNueGcxvANMzequiZbzvs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRR1bKQXa07v_Ii928uhLC5t1zovcXcwkkW7aeeZZ4yg&oe=6AFDC0F5"}, {"file_name": "6.png", "id": "1525467878580505", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499311585_1525467881913838_329010078967995254_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNBMsVbAkH0Q7kNvwGGFW6z&_nc_oc=AdpbkEXyfYAUUMmH5GEoIA2tJ745wA5NT3iWCTcUcgowTQEhCuVB9F0ULGf1IfLMKVw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwDS9VgzWpP6hgXHld9w84jaPrQpOD_Nsw96x8-laQ_A&oe=6AFDB7BA"}, {"file_name": "1.png", "id": "1349855407125891", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499313072_1349855410459224_5655082562578744311_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpzssWp0V0YQ7kNvwGMVQkV&_nc_oc=AdpG-azTRm8gMvqN1UDeRRzRV6_Jwf2rVTJs2pjoUZzhD0lAYOUllv9L17ksA1Y7XYY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhSUjCEA-bfmI72sG-iaNOlW6aXbNUvCTqZHJRFKuomg&oe=6AFDB803"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Redline Rivals VR: Drag Racing", "keywords": ["Drag", "Racing", "Nitro", "Shift", "Speed"], "long_description": "Feel the redline. Master the shift. Dominate the strip. This is Redline Rivals VR drag racing.\nGrip the wheel, feel the engine roar, and master the one skill that separates champions from the rest: the perfect shift. Timing is everything \u2014 nail every manual gear change at the redline to launch off the line, trigger explosive speed boosts, and leave your rivals in the dust.\nThis isn't auto-shifting. Every gear is yours to command. Read the rev, feel the moment, shift with precision \u2014 one mistake and the race is lost.\n\n# BUILD YOUR DREAM GARAGE\nDrive 12+ legendary machines \u2014 from classic American muscle and vintage racing icons to modern hyper cars and exotic supercars. Every car looks, sounds, and handles distinctly.\n\n# UPGRADE & TUNE\nBuild the ultimate drag machine. Upgrade your engine, turbo, transmission, nitro, and weight to boost Speed, Acceleration, Power, Nitro, and Mass \u2014 fine-tune every stat for the perfect launch.\n\n# NITRO BOOST\nDeploy nitro at the perfect moment for a game-changing burst of raw horsepower down the strip.\n\n# RACE RUTHLESS RIVALS\nBattle relentless AI opponents in high-stakes single-player drag races. Stay ahead, hit every shift, and prove you own the strip.\n\n# STUNNING ENVIRONMENTS\nRace across a variety of immersive, detailed VR tracks built for pure speed and adrenaline.\nStraight-line racing means minimal motion \u2014 comfortable for every VR player.\nFeel the horsepower. Master the shift. Become a drag racing legend.\nReal drag racing. Real adrenaline. Redline Rivals VR.", "short_description": "Welcome to Redline Rivals VR \u2014 master the perfect shift in immersive VR drag racing. Time every manual gear change to launch off the line, unleash nitro boosts, and leave your rivals in the dust. Upgrade and tune 12+ legendary cars \u2014 from classic muscle to modern hyper cars and supercars. Feel raw horsepower, precise shifting, and pure speed across stunning environments. Battle relentless opponents in high-stakes single-player races. Real drag racing, real adrenaline \u2014 own every strip."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gammayinteractive/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Gammay Interactive", "support_website_url": null, "website_url": "https://sites.google.com/view/gammayinteractive/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_HK", "zh_CN", "fr", "ru", "de", "es_AR", "es_CL", "es_CO", "es_MX", "es", "es_VE", "pt_BR", "pt", "ja", "it", "ko", "tr", "es_PE", "es_PR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1223900924143824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_4543177666005306_653745185015595607_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_my5jrGgkAQ7kNvwHfoqbn&_nc_oc=AdpA6HHJpG02Z6yBE9PQnlfbgYWJsqDc4fzG7jWxQaMJFBuqkwPoAJUy6D-HoT7DDBc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyu5ET8b1MnKY3F5V3ATYrLw8nrQKZUWCeW50fv4qJcw&oe=6AFDCF9C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Redline Rivals VR: Drag Racing", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "274
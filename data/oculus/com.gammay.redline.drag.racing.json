n_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IeHvu8htyIYQ7kNvwGqNs_1&_nc_oc=Adqf9Zj6C8Xyf4w6_tTuykXiPKe7AqqVR7bv5Fg2vde4X1bJHDChN9xyDyjmrwxOGfg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTLNJlDHjfW_cKuv-k1kOuKMJ1frpkjxXJ-4gfiW9zeQ&oe=6AFDCB14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Redline Rivals VR: Drag Racing", "keywords": ["Drag", "Racing", "Nitro", "Shift", "Speed"], "long_description": "Feel the redline. Master the shift. Dominate the strip. This is Redline Rivals VR drag racing.\nGrip the wheel, feel the engine roar, and master the one skill that separates champions from the rest: the perfect shift. Timing is everything \u2014 nail every manual gear change at the redline to launch off the line, trigger explosive speed boosts, and leave your rivals in the dust.\nThis isn't auto-shifting. Every gear is yours to command. Read the rev, feel the moment, shift with precision \u2014 one mistake and the race is lost.\n\n# BUILD YOUR DREAM GARAGE\nDrive 12+ legendary machines \u2014 from classic American muscle and vintage racing icons to modern hyper cars and exotic supercars. Every car looks, sounds, and handles distinctly.\n\n# UPGRADE & TUNE\nBuild the ultimate drag machine. Upgrade your engine, turbo, transmission, nitro, and weight to boost Speed, Acceleration, Power, Nitro, and Mass \u2014 fine-tune every stat for the perfect launch.\n\n# NITRO BOOST\nDeploy nitro at the perfect moment for a game-changing burst of raw horsepower down the strip.\n\n# RACE RUTHLESS RIVALS\nBattle relentless AI opponents in high-stakes single-player drag races. Stay ahead, hit every shift, and prove you own the strip.\n\n# STUNNING ENVIRONMENTS\nRace across a variety of immersive, detailed VR tracks built for pure speed and adrenaline.\nStraight-line racing means minimal motion \u2014 comfortable for every VR player.\nFeel the horsepower. Master the shift. Become a drag racing legend.\nReal drag racing. Real adrenaline. Redline Rivals VR.", "short_description": "Welcome to Redline Rivals VR \u2014 master the perfect shift in immersive VR drag racing. Time every manual gear change to launch off the line, unleash nitro boosts, and leave your rivals in the dust. Upgrade and tune 12+ legendary cars \u2014 from classic muscle to modern hyper cars and supercars. Feel raw horsepower, precise shifting, and pure speed across stunning environments. Battle relentless opponents in high-stakes single-player races. Real drag racing, real adrenaline \u2014 own every strip."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gammayinteractive/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Gammay Interactive", "support_website_url": null, "website_url": "https://sites.google.com/view/gammayinteractive/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_HK", "zh_CN", "fr", "ru", "de", "es_AR", "es_CL", "es_CO", "es_MX", "es", "es_VE", "pt_BR", "pt", "ja", "it", "ko", "tr", "es_PE", "es_PR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1199830063217577"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1101205799456856"}, {"status": "PUBLISHED", "id": "2565216663937171"}, {"status": "PUBLISHED", "id": "2309782606517660"}, {"status": "PUBLISHED", "id": "1025770996712473"}]}, "baseline_offer": {"id": "1025770996712473"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1101205799456856"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1216703758196874", "version": "1.0.1"}, "id": "1580205243547117", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1199830056550911", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1216703758196874"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1580205243547117"}]}, "change_log": "Welcome to the first release of Redline Rivals VR: Drag Racing.\r\n\r\nThis launch build introduces a realistic VR drag racing experience built around manual gear shifting, perfect RPM timing, rival races, nitro boosts, and car performance upgrades.\r\n\r\nWhat\u2019s Included\r\n- First official release build for Meta Quest\r\n- Realistic VR drag racing gameplay\r\n- Manual gear shifting with perfect shift timing\r\n- Speed boost rewards for accurate RPM-based shifts\r\n- Rival opponent races\r\n- Nitro system for high-speed acceleration\r\n- Multiple cars with different visual styles\r\n- Car upgrade system including speed, acceleration, handling, braking, and weight improvements\r\n- Multiple racing environments and drag strips\r\n- Immersive cockpit driving view\r\n- Race progress UI for player and opponent\r\n- Improved vehicle handling and driving feel\r\n- Optimized visuals and performance for VR gameplay\r\n- General stability improvements and bug fixes", "created_date": 1784400285, "id": "1216703758196874", "version": "1.0.1", "version_code": 1, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
nGl1wGYrOKt4p35LANTzUM8Wa43X3rK9spt0HSFRk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhORIHIEQRawM57sb2XKGWtklap91kBe72NXUzcE1Bzw&oe=6ADCD308"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer  cover image2560_1440.png", "id": "326825726444436", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974873_326825729777769_5030860008611286716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AG3cN5mG-ZwQ7kNvwGMZIGn&_nc_oc=AdqIobUCy7hGObY7oc95YcI8ZhkbdzJfNfA1uPjRW75SrJVKn-BZ2TNHhlInHqO__G4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_oQyoSJW5FIetpdMPgcL8H6PZXgAiFETY02nn9JjwEg&oe=6ADCC76A"}, "display_name": "4XVR Video Player", "keywords": [], "long_description": "4XVR video player is a local vr video player that plays 3D movies and VR videos with 4x clarity. It is the only VR video player that supports MVC 3D decoding.\n\t\n\t\nFeatures include:\n\t\n- Exclusive video display technology: When watching movies and VR videos, you can enjoy 4x clarity.\n\t\n- The only VR video player that supports MVC 3D decoding; MVC 3D in these file formats can be played smoothly: ISO, SSIF, mkv, m2ts, ts, mts, etc.\n\t\n- Read and play videos on a USB flash drive (FAT32 / exFAT / NTFS support)\n\n- Network playback support: DLNA, SMB 1.0/2.0/3.0, FTP, SFTP, WebDAV, WebDAVS;  Network module optimization, let you say goodbye to the network congestion.\n\n- Intelligent and accurate recognition of projection types (flat, 180\u00b0 , 360\u00b0 ), stereoscopic modes (2D, FSBS 3D, HSBS 3D, FOU 3D, HOU 3D)\n\t\n- Smooth and powerful UI\n\t\n- Immersive, realistic theatres", "short_description": "4XVR video player is a local vr video player that plays 3D movies and VR videos with 4x clarity. It is the only VR video player that supports MVC 3D decoding."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.4xvr.net/nd.jsp?id=29#_np=182_0", "developer_terms_of_service_url": null, "publisher_name": 
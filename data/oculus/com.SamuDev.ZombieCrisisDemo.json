1whGtShgjon1ZO5L6IrM2DjNtMhyRpA1uYgus&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAKbpEvxHPJfx7hsOtKzI3VqQa0dTUAWxjyEs5F_NhJw&oe=6A6CBB22"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Crisis Demo", "keywords": [], "long_description": "Zombie Crisis DEMO is a fast-paced action experience designed to test your reflexes and keep your adrenaline high.\n\nThis is a demo version of the game, created to let you jump straight into the action and have fun without pressure.\nYou have infinite lives, so there\u2019s no fear of starting over \u2014 feel free to experiment, improve your skills, and take down as many zombies as you can.\n\nBut don\u2019t lower your guard.\n\nZombies can appear suddenly from hidden corners of the hospital, emerging when you least expect them. Stay alert, react fast, and be ready to defend yourself at all times.\n\nHow long can you survive\u2026 and how many zombies can you stop?", "short_description": "Challenge your reflexes and your heart in this thrilling DEMO of Zombie Crisis. Face different types of zombies as they relentlessly hunt for fresh meat!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://samudev.ezyro.com/zombie-crisis-demo-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Samu Dev", "support_website_url": null, "website_url": "https://samudev.ezyro.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes":
cdn.com&_nc_ss=8&oh=00_AfwNrM6hSgCy5-w2Hr35ST92cPmwAIp-R6pbs5evm4uO7w&oe=69BBDFF8"}, {"file_name": "screen5.png", "id": "872577935312416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823431_872577938645749_4762707642373560299_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHxy7SgPzFsQ7kNvwFT-rng&_nc_oc=AdknCD7JJ-nG3syMdTvx4yEvNUY_-xslaWPpTxFWFznEa0V2-smFjatBpfcbSaPD9js&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxwajn4NxdIsyhTe-SH0wxDySspCT9dznzezGlY7gs3kA&oe=69BBD9E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Crisis Demo", "keywords": [], "long_description": "Zombie Crisis DEMO is a fast-paced action experience designed to test your reflexes and keep your adrenaline high.\n\nThis is a demo version of the game, created to let you jump straight into the action and have fun without pressure.\nYou have infinite lives, so there\u2019s no fear of starting over \u2014 feel free to experiment, improve your skills, and take down as many zombies as you can.\n\nBut don\u2019t lower your guard.\n\nZombies can appear suddenly from hidden corners of the hospital, emerging when you least expect them. Stay alert, react fast, and be ready to defend yourself at all times.\n\nHow long can you survive\u2026 and how many zombies can you stop?", "short_description": "Challenge your reflexes and your heart in this thrilling DEMO of Zombie Crisis. Face different types of zombies as they relentlessly hunt for fresh meat!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://samudev.ezyro.com/zombie-crisis-demo-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Samu Dev", "support_website_url": null, "website_url": "https://samudev.ezyro.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}
731588869_1384111175339592020_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKuTf6KwGtIQ7kNvwEa_nJj&_nc_oc=Adora6cOODlRM-ZslImFt3-9QBwChJ59lnGPHYK_hxObxKs7eZinazoA2EcbOcNWaGA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0MMT7bF7PW83cEJlDkUOQF39PJVUpNDhOQaapwvlyKDg&oe=69F0CF20"}, {"file_name": "3.png", "id": "827712802006795", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035448_827712808673461_4578942403921936018_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYyOAdtFtHsQ7kNvwEa6p5R&_nc_oc=AdpYjdPj4vGU2laMN7zVofr5S0tpZq271YMWgUQSOuoBzR-xdq9oeDUTbiVyPyqWG28&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0kqJMMB-hg3EaRg5p8EWLd4Sxxjn-fuVpdHfpiiZWajA&oe=69F09DBA"}, {"file_name": "4.png", "id": "1945146272350783", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031628_1945146275684116_3826679853630214683_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3zGw6oxUC0Q7kNvwEUZjpl&_nc_oc=AdrCk-t36PX37xL6flAHgN49HspEOTQcRfWS_3R0IN_HPZVdnJm4xhZ2NeNji7b6hd0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0VN6NjgggUu2MPcpKkR6X3EOGUVdHlix8_XKm0qDMBVA&oe=69F09A78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "897295084973730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75435289_897295088307063_5635641879931495254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q56SAni0QH0Q7kNvwEt6bjA&_nc_oc=AdpWOl2brJqgy2qYmbBIac7SAKjvc8xdrGFE0Gj6jA34Gbbs9yk5abhekE9Mt9ESuR0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0z0daOqiDuxqcxkyfbAbvO_0UJmnZcxrRsIYOWVBx-0A&oe=69F0AD67"}, "display_name": "Crack Shot: Farm Frenzy Showdown", "keywords": ["Arcade", "clasic", "retro", "shooting", "animals"], "long_description": "Dang those varmints! Your peaceful farm is under siege, and it\u2019s up to you to defend your livestock from these pesky intruders. Armed with a trusty pump-action shotgun, you\u2019ll stand your ground on your porch and protect your territory.\n\nInspired by classic light gun games of the '80s, \"Crack Shot\" brings nostalgic shooting gallery fun to VR. As varmints and livestock pop up across your land, you have just 5 seconds to identify and eliminate the threats. Remember, don't shoot the livestock\u2014they're your pride and joy!\n\nHow quick is your draw? Sharpen your reflexes and prove your skills in this thrilling VR shooter.", "short_description": "Dang those varmints! Your peaceful farm is under siege, and it\u2019s up to you to defend your livestock from these pesky intruders. Armed with a trusty pump-action shotgun, you\u2019ll stand your ground on your porch and protect your territory."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/crackshot", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8233365460059491"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65228545_483210314458425_9128222324799437762_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPxPtdCiPAYQ7kNvwGp5k30&_nc_oc=AdosxkL_en3-CLBuUMbSQQ1gSoS_HOl2TZuf0_sdrIpdGKkEkVWwHwexo-D_op0
Q7kNvwF-lbI4&_nc_oc=AdqLQmSmxMmamgbL8W9-sm_rGKtLCkH141TaYob9U8ceQduwd53ZUXmnMm3h7d2_7mw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4W7T492Cgz-onid-8NIFlQc-2KBQb52c1k6knb4MpE5w&oe=6A05EDFA"}, {"file_name": "4.png", "id": "1945146272350783", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031628_1945146275684116_3826679853630214683_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_X4yft-osuIQ7kNvwGlOgqs&_nc_oc=AdrE5XHypi8DTjkBcBelRodnaFQa6J_hG5nCm5ckMEn_snHEpfNlLD1AiB1Gh5zceSA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xKP5F6cKklM1otnvUoy9YD8NXYFMXQu9nAyGRXYse0Q&oe=6A05EAB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "897295084973730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75435289_897295088307063_5635641879931495254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPNPGq6S2GcQ7kNvwHF6DVm&_nc_oc=Adqy9Y6AZ1YC2oyg1JMm6XBXH9d67pICLT0ZyzRK_r0a1BgrA4KMDK_w-TlWH-cdqlc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nDkQBDeRAUpyIK3sUQFCIjpWYER-xihzueH4pgbyrmQ&oe=6A05C567"}, "display_name": "Crack Shot", "keywords": [], "long_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to clear 'em out.\n\nCrack Shot is a shooting gallery like the old light gun games of the 80's.  It's everything classic console kids loved!\n\nYou are a farmer armed with a pump action shot gun.  Standing on your porch, overlooking your land, varmints will pop-up along with livestock.  You have 5 seconds to identify the varmints and \"Git 'Em!\"\n\nDon't shoot the livestock.  They are your pride and joy.  \n\nHow quick is your draw?", "short_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to cl
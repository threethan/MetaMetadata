g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhqEvuKkdmRpGlOw76BD8t7OWSGhTlPe1tcXSJ0ZK_Jg&oe=69AABE3A"}, {"file_name": "4.png", "id": "1945146272350783", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031628_1945146275684116_3826679853630214683_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N01PZcc5l6YQ7kNvwFKo6xI&_nc_oc=AdkH5gtXWfBkZAWNGIsYuzkAsbss4Wi2jks0BtQb0nKwErAb1IblBbpNOnc3lXyMksE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afyt4F0eHg5aZLsS51POdSoBJx9BmTyEXmyWUE1T2QNfZA&oe=69AABAF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "897295084973730", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75435289_897295088307063_5635641879931495254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_ojcGY-QG4Q7kNvwFsMMKf&_nc_oc=Adm7feEvy9b23GoxKWgyN9eUVHvyWYbo5_Q2WD8exneZdB0-0ja6SnbXhwCakAXD6IQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-SSguqeuOjnAeeZrKRrVNz20QQqU8W0jk8lucvFxemg&oe=69AACDE7"}, "display_name": "Crack Shot", "keywords": [], "long_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to clear 'em out.\n\nCrack Shot is a shooting gallery like the old light gun games of the 80's.  It's everything classic console kids loved!\n\nYou are a farmer armed with a pump action shot gun.  Standing on your porch, overlooking your land, varmints will pop-up along with livestock.  You have 5 seconds to identify the varmints and \"Git 'Em!\"\n\nDon't shoot the livestock.  They are your pride and joy.  \n\nHow quick is your draw?", "short_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to clear 'em out."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://j
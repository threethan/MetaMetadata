dxYGmdXf8ymHdPvFtFLOciUmdTkzYg&oe=69F1EF3A"}, {"file_name": "4.png", "id": "1945146272350783", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031628_1945146275684116_3826679853630214683_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3zGw6oxUC0Q7kNvwGi8ht-&_nc_oc=Adqq3gd5S-HSPQrjHuhQAbYl-RUaygbh2iypKtTdxMYgwrsFloLql3rUPBHgMZO7j4I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2AGQTUM-ni8iuSQsDGx6zXhGuZsS1pfhSCMEqa98ocVg&oe=69F1EBF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "897295084973730", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75435289_897295088307063_5635641879931495254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q56SAni0QH0Q7kNvwF19Orq&_nc_oc=Adoe_JXUFUrXryH-EtqQvg0NYrOCGeBGphjGj1GiEyyA_VmgXDpE6wu3dhP7NkNJ1M8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3QZNKlYoJCtkcm_gMNxXMuxGsPgiLlfEQ_mKUhB9EIwg&oe=69F1FEE7"}, "display_name": "Crack Shot", "keywords": [], "long_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to clear 'em out.\n\nCrack Shot is a shooting gallery like the old light gun games of the 80's.  It's everything classic console kids loved!\n\nYou are a farmer armed with a pump action shot gun.  Standing on your porch, overlooking your land, varmints will pop-up along with livestock.  You have 5 seconds to identify the varmints and \"Git 'Em!\"\n\nDon't shoot the livestock.  They are your pride and joy.  \n\nHow quick is your draw?", "short_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to clear 'em out."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/crackshot", "developer_terms_of_serv
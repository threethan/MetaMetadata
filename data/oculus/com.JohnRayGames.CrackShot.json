_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwhMxyM28AIEAz3ssgSX4aHtwqY3fUFVDOkcrJALKZQZA&oe=69BFD63A"}, {"file_name": "4.png", "id": "1945146272350783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031628_1945146275684116_3826679853630214683_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Kp0mWuwEskQ7kNvwFNlIUv&_nc_oc=AdnqYKPSmNunoefks1oTo09VdnJ8JEsSFT3sEAEPvtisb1tvfVcLMVlWuk11hXayZDY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzP0DHtUIHivbWPCzZoFegSqv4Icul7pxAVkQ5TtI6dNA&oe=69BFD2F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "897295084973730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75435289_897295088307063_5635641879931495254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiChdk9PVNAQ7kNvwH4dlhm&_nc_oc=Adlk8iRLiUNBRb08tWj6ljr0CgesKFWZIaLbNJXM3RABzCAGroY3FhDAsl055rG-Ock&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyfrcsmGotVGY3DuNcushruceXTO7IbYkHK3RSQfszybw&oe=69BFE5E7"}, "display_name": "Crack Shot", "keywords": [], "long_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to clear 'em out.\n\nCrack Shot is a shooting gallery like the old light gun games of the 80's.  It's everything classic console kids loved!\n\nYou are a farmer armed with a pump action shot gun.  Standing on your porch, overlooking your land, varmints will pop-up along with livestock.  You have 5 seconds to identify the varmints and \"Git 'Em!\"\n\nDon't shoot the livestock.  They are your pride and joy.  \n\nHow quick is your draw?", "short_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to clear 'em out."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixs
Q7kNvwG1PrEM&_nc_oc=AdqxhsdSL1AbNn37D36fE6gR0UooPab9SyNzgR_Y-3wJkHptSdbljJwKUcyNxyrTAMs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiIZiOb6ecjW2uLeEfc7_KrZHnfw06FN6BglQbzep1zA&oe=6AA8167A"}, {"file_name": "4.png", "id": "1945146272350783", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031628_1945146275684116_3826679853630214683_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCiWWPqUTa0Q7kNvwE7uoNY&_nc_oc=AdpbralTXgWvRHtSO8Xcw6qbZvkdPhLqwc32mLG2y57zv_qYuqEqaTpO0pKC4HwFr7Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMJSJT5dFtjTqp4MZhFobHK_lb4DOhh8wZzSnZLfk3dA&oe=6AA81338"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "897295084973730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75435289_897295088307063_5635641879931495254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GhIfAXd_18Q7kNvwHjc6zR&_nc_oc=AdoYvbdvW27CzQKr9FckUqcV75fLOYUvT3i_n_FixBpivAOkuJ-jcb1P2nxCVG43FJs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxZb0gYrQqxd8n34UN0w1nf1NNHAKe5RqLKdN2Z1d8WQ&oe=6AA7EDE7"}, "display_name": "Crack Shot", "keywords": [], "long_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to clear 'em out.\n\nCrack Shot is a shooting gallery like the old light gun games of the 80's.  It's everything classic console kids loved!\n\nYou are a farmer armed with a pump action shot gun.  Standing on your porch, overlooking your land, varmints will pop-up along with livestock.  You have 5 seconds to identify the varmints and \"Git 'Em!\"\n\nDon't shoot the livestock.  They are your pride and joy.  \n\nHow quick is your draw?", "short_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to clear 'em out."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/crackshot", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1521242021630843"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1166983702267814"}, {"status": "PUBLISHED", "id": "3722507621381995"}, {"status": "PUBLISHED", "id": "1931483380929513"}, {"status": "PUBLISHED", "id": "2980886092080758"}, {"status": "PUBLISHED", "id": "1286902675759919"}, {"status": "PUBLISHED", "id": "1148341500346012"}, {"status": "PUBLISHED", "id": "362342766906329"}, {"status": "PUBLISHED", "id": "498681352866558"}, {"status": "PUBLISHED", "id": "3726585140922734"}, {"status": "PUBLISHED", "id": "5599270776834822"}]}, "baseline_offer": {"id": "3726585140922734"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768845600, "status": "PUBLISHED", "id": "1166983702267814"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5675479432514786", "version": "1"}, "id": "1444108556080480", "channel_name": "LIVE"}]}, "is_for_oculus_ke
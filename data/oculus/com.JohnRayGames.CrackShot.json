_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXvjK-LnnRmeH9ePo4_7gZ3JW_zMnJw9BsCeLVI_EiRQ&oe=69AEB2BA"}, {"file_name": "4.png", "id": "1945146272350783", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031628_1945146275684116_3826679853630214683_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiiR3KBAUo0Q7kNvwFXw22A&_nc_oc=Admhbf-T40LmW22EuXBnBkGCrdRC7HApKNX0S6igdUsjSacKF7vciphQGz74Vj7fKbI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6tAVxlCRh5SbclyKuYj8OrWSyo_7YzeHPAmRaHB4RwQ&oe=69AEAF78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "897295084973730", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75435289_897295088307063_5635641879931495254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilol3qwcH64Q7kNvwHP1D_i&_nc_oc=Adk6gColBpbN96Z_5tBLuc11DAbWZLiWg-1NsjEtNbI2XpU1t-4hPeL59e4Rn0AXtSQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3QaDAhDcOpKiKTTr7FotwBJH72A4dutMB3ZDuEbpdPw&oe=69AEC267"}, "display_name": "Crack Shot", "keywords": [], "long_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to clear 'em out.\n\nCrack Shot is a shooting gallery like the old light gun games of the 80's.  It's everything classic console kids loved!\n\nYou are a farmer armed with a pump action shot gun.  Standing on your porch, overlooking your land, varmints will pop-up along with livestock.  You have 5 seconds to identify the varmints and \"Git 'Em!\"\n\nDon't shoot the livestock.  They are your pride and joy.  \n\nHow quick is your draw?", "short_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to clear 'em out."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixs
Q7kNvwHpZSz6&_nc_oc=AdqRQFnPlePkOo0n_kcBf_ZRc3r1P-Zq35NQOXhvCZLoeAkmLJgYfSm2UONgRME6DPY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRSjyEe6ykWIrhE2W-P4TH-UEuP55J-KBVUfef_uaoqQ&oe=6ABFD17A"}, {"file_name": "4.png", "id": "1945146272350783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031628_1945146275684116_3826679853630214683_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-i5LAUCPyoQ7kNvwEYI1qi&_nc_oc=AdrdhMk9-WJ8udk7MmciUAzr4zQ8C1d58pxxCmHpO1TFTN9CZo1LZ5nQ-hw7ZIF5FG4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPx1JMwmqMntQRoRHCPW8h9dbAnQf_XXn2Rq-fXZrhXw&oe=6ABFCE38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "897295084973730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75435289_897295088307063_5635641879931495254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNrh4eyTxIwQ7kNvwFmm9vO&_nc_oc=AdpvIZ2lcXD1gE8FW3lE205vO-hsyxklQIvDp1ffO1_pj7nstyiuWt4yizv03tcKdQc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDMQkYQ4SQ5ISbc342nTmtFw5kT1ow-pMgUFJi-gOS1w&oe=6ABFA8E7"}, "display_name": "Crack Shot", "keywords": [], "long_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to clear 'em out.\n\nCrack Shot is a shooting gallery like the old light gun games of the 80's.  It's everything classic console kids loved!\n\nYou are a farmer armed with a pump action shot gun.  Standing on your porch, overlooking your land, varmints will pop-up along with livestock.  You have 5 seconds to identify the varmints and \"Git 'Em!\"\n\nDon't shoot the livestock.  They are your pride and joy.  \n\nHow quick is your draw?", "short_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to cl
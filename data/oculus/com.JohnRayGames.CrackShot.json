F"}, {"file_name": "5.png", "id": "2887068728255536", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974812_2887068731588869_1384111175339592020_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hm4dlin1D1kQ7kNvwFDPi3q&_nc_oc=AdpS6D2ujzTbpRwGOJAV4Sx3ue2futPqM3qKSooHCmTVJ3rFHqTCK6xAWFxBL9JMLUk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-SW1jUtwwK25PtaA5s9A8rfUx3ofk9OtxNMta26pMLA&oe=6A5A4720"}, {"file_name": "3.png", "id": "827712802006795", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035448_827712808673461_4578942403921936018_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JkiAcna__IQ7kNvwF0elgH&_nc_oc=Adp0ATaHU6EGeTGxPqKdtxfqz2Ayr6NZY7P6YKJySJ_cuDOJfR9rCSwYCVtaVMKq6Jg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjtaW5z-muxMmkV8h_usPSUeMCp6-TmwgN_mmBPvu4uw&oe=6A5A15BA"}, {"file_name": "4.png", "id": "1945146272350783", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031628_1945146275684116_3826679853630214683_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OBNLmDMc2UQ7kNvwFNcy9C&_nc_oc=Adp1Z4XVeQhJTtocfHClj0FXM4UR1J1CfP8psjnz8NdOnbqHDSfmBl904Nioju74HPY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPD9VvD34Y4S41tiy2TVwAWA9pkDoML7D-2tTNkgZQhg&oe=6A5A4AB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "897295084973730", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75435289_897295088307063_5635641879931495254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fexojs-mye0Q7kNvwEB2wl2&_nc_oc=AdpkArDSWocdp_qDsfeWaFAJGQwGhhOq_J_hmG9lNvOUJWkLfbCgUixWKftyXEy03bU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZDwEQ4l7cuMgpGbKklgXwCJZFtmtryeo9WWJ_YV9QJA&oe=6A5A2567"}, "display_name": "Crack Shot: Farm Frenzy Showdown", "keywords": ["Arcade", "clasic", "retro", "shooting", "animals"], "long_description": "Dang those varmints! Your peaceful farm is under siege, and it\u2019s up to you to defend your livestock from these pesky intruders. Armed with a trusty pump-action shotgun, you\u2019ll stand your ground on your porch and protect your territory.\n\nInspired by classic light gun games of the '80s, \"Crack Shot\" brings nostalgic shooting gallery fun to VR. As varmints and livestock pop up across your land, you have just 5 seconds to identify and eliminate the threats. Remember, don't shoot the livestock\u2014they're your pride and joy!\n\nHow quick is your draw? Sharpen your reflexes and prove your skills in this thrilling VR shooter.", "short_description": "Dang those varmints! Your peaceful farm is under siege, and it\u2019s up to you to defend your livestock from these pesky intruders. Armed with a trusty pump-action shotgun, you\u2019ll stand your ground on your porch and protect your territory."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/crackshot", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8233365460059491"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/65228545_483210314458425_91
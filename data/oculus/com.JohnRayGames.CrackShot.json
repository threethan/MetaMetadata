_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxMuemcVl9VtK6GZ0Ei7MmJtg8UaQKe8bIdgI6ytOCb5A&oe=69BBE1BA"}, {"file_name": "4.png", "id": "1945146272350783", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031628_1945146275684116_3826679853630214683_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSAgR5Wu5HQQ7kNvwH3TccR&_nc_oc=AdlVivj__Gf3qupgM2VSo1XVKnh-kGyQnFH9YNa2G9JSgr-xRddzafE-PSyKNRrjsmk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx4E2YIAnCKut14MAFOON6QYiwdBp-liu18aDcLkciQfA&oe=69BBDE78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "897295084973730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75435289_897295088307063_5635641879931495254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBUrKqXOfL4Q7kNvwEA3FYl&_nc_oc=AdkMJ7MMVfGhQN124zZvv72i_u4MctvG9xwOIa89sNpF71oWkFhHgHK0nQKAaQqnFRI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzbTC-2_nFf1QzUy1jTviHbmzdkjNzVKhcE2Uu6xH2e2g&oe=69BBF167"}, "display_name": "Crack Shot", "keywords": [], "long_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to clear 'em out.\n\nCrack Shot is a shooting gallery like the old light gun games of the 80's.  It's everything classic console kids loved!\n\nYou are a farmer armed with a pump action shot gun.  Standing on your porch, overlooking your land, varmints will pop-up along with livestock.  You have 5 seconds to identify the varmints and \"Git 'Em!\"\n\nDon't shoot the livestock.  They are your pride and joy.  \n\nHow quick is your draw?", "short_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to clear 'em out."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixs
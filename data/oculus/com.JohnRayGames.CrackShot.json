_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw-qZxAgW-hvdXp_5A219WW0TLMECa2WEnKyAZvWjpSTw&oe=69B93EBA"}, {"file_name": "4.png", "id": "1945146272350783", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031628_1945146275684116_3826679853630214683_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSAgR5Wu5HQQ7kNvwE5aOwI&_nc_oc=Adl1bOB8wCp2186hjtEj2ST4EknK_-RiP0MyMV32BzEBPrxCCKq_hC3OEKde6UHUmng&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzHMcozQx-dnaEGJ_-LgMSYV2G8F1-vLi-v3u_9mL-e_A&oe=69B93B78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "897295084973730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75435289_897295088307063_5635641879931495254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBUrKqXOfL4Q7kNvwFsi-oi&_nc_oc=Adlk3ogfLhcxkL4a9N9E3wxnxTuQtkNlVh5_4s2HkLNF4rlS8s7pAxFZj5jV90u8gRM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzbGLJqRubTOqqsy1k1DbYiiIN4_DzjQg1qw6jIYKWIhg&oe=69B94E67"}, "display_name": "Crack Shot", "keywords": [], "long_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to clear 'em out.\n\nCrack Shot is a shooting gallery like the old light gun games of the 80's.  It's everything classic console kids loved!\n\nYou are a farmer armed with a pump action shot gun.  Standing on your porch, overlooking your land, varmints will pop-up along with livestock.  You have 5 seconds to identify the varmints and \"Git 'Em!\"\n\nDon't shoot the livestock.  They are your pride and joy.  \n\nHow quick is your draw?", "short_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to clear 'em out."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixs
F"}, {"file_name": "5.png", "id": "2887068728255536", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974812_2887068731588869_1384111175339592020_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-ZA42abN7kQ7kNvwHaAeg-&_nc_oc=AdrFD35bVTtjcIbhIsWOOeP9qLyZTf01nk2z0SaeVIegW-ioikXxM-qdbSH1TIz3xW8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASMa7RWLXfv6RlQYVvkJQ4qEj99y-kp4_7LHOelijM-w&oe=6A4A7520"}, {"file_name": "3.png", "id": "827712802006795", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035448_827712808673461_4578942403921936018_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86RlgWkCVJMQ7kNvwG3kki4&_nc_oc=AdrgxU8H_4qCD8E1dqSLCTEzpg4YsGRfZv7pd1iG3x3gQzSz-rmu9GwMBuzWUjAIlrQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJY8IywX-G3FSA4QbyriN7C-OyeGqMaK-rIdJ9W7qKtg&oe=6A4A7BFA"}, {"file_name": "4.png", "id": "1945146272350783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031628_1945146275684116_3826679853630214683_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GoWEQxtJ0IQ7kNvwFwEcog&_nc_oc=AdoP_FZblmXH4gBZ7ZUOtqlxGrznO5xB3KWAIFKP4F7ky0dDCobQqPvAjCT5u_gbnlM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzx0rTtNijSl-T72vQG9XMCNGFppD_QA4UANLY5VlvJQ&oe=6A4A78B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "897295084973730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75435289_897295088307063_5635641879931495254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geTSzr4qG84Q7kNvwEpR0Qf&_nc_oc=AdraCXbopjtNdmhtKnTLnyP9st7UuV7z0KqU-EwaRtIWXZnHot_UrMQ6XgIDpast6rY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBB03jfJFrZsnsq7OzMkSsyyATynbI_Rp85pyRFOAQBMw&oe=6A4A5367"}, "display_name": "Crack Shot: Farm Frenzy Showdown", "keywords": ["Arcade", "clasic", "retro", "shooting", "animals"], "long_description": "Dang those varmints! Your peaceful farm is under siege, and it\u2019s up to you to defend your livestock from these pesky intruders. Armed with a trusty pump-action shotgun, you\u2019ll stand your ground on your porch and protect your territory.\n\nInspired by classic light gun games of the '80s, \"Crack Shot\" brings nostalgic shooting gallery fun to VR. As varmints and livestock pop up across your land, you have just 5 seconds to identify and eliminate the threats. Remember, don't shoot the livestock\u2014they're your pride and joy!\n\nHow quick is your draw? Sharpen your reflexes and prove your skills in this thrilling VR shooter.", "short_description": "Dang those varmints! Your peaceful farm is under siege, and it\u2019s up to you to defend your livestock from these pesky intruders. Armed with a trusty pump-action shotgun, you\u2019ll stand your ground on your porch and protect your territory."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/crackshot", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8233365460059491"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/65228545_483210314458425_91
Q7kNvwE86nAK&_nc_oc=AdrI5OQ3Rve4fPG8nBtA1nbhpLAQ2YozpIQ7Sz6d_JSeNaOqRZPwYj23zS_cGRuH_PA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALN08TDLNpP_Qp_aIFO9Utw0q-VyR5S0bysX1Xhgdd6w&oe=6A537E3A"}, {"file_name": "4.png", "id": "1945146272350783", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031628_1945146275684116_3826679853630214683_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTLIlQv6_cYQ7kNvwEWRF8Z&_nc_oc=AdqMCBXWl0s7FuEWbq0RqRBJqCN-v-d_kzG-jj3Pn_GEu7pu0ICZhdjHBszywBeM7ak&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCO2fg6Mr4Kp0Xm_SGRzCSRbcBnw7z7FDvVuU8mTkWCmg&oe=6A53B338"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "897295084973730", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75435289_897295088307063_5635641879931495254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GiQJWc2wzOgQ7kNvwF0UmXH&_nc_oc=Ado7X38SafYrZlzgw5Miag7xp9lJcZkVdFxpuNBgX3WXjMYtuDbSa0gyBcIhfmfhc2Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfpvqm7Pnl3KcDYOoOXVqN6UJD8ssWQEenrG91uGnRCg&oe=6A538DE7"}, "display_name": "Crack Shot", "keywords": [], "long_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to clear 'em out.\n\nCrack Shot is a shooting gallery like the old light gun games of the 80's.  It's everything classic console kids loved!\n\nYou are a farmer armed with a pump action shot gun.  Standing on your porch, overlooking your land, varmints will pop-up along with livestock.  You have 5 seconds to identify the varmints and \"Git 'Em!\"\n\nDon't shoot the livestock.  They are your pride and joy.  \n\nHow quick is your draw?", "short_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to cl
731588869_1384111175339592020_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUjvIPtkEksQ7kNvwFh_oW3&_nc_oc=AdnkGCrHoJIZzYnajp6g7Uo-fu3dxHGL7EiPK8lltAdtThNRiB0YUXK53ciB-_mbP38&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv4urx0nSppqH-7cOh_iXE9gFrm4laW9o4NnnMHqR57jQ&oe=699D8860"}, {"file_name": "3.png", "id": "827712802006795", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035448_827712808673461_4578942403921936018_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hbtq9N_qFLYQ7kNvwEfUkdV&_nc_oc=Adl6njdubmrYpYf7hC4aQmwS88b9PJ2m-dkRybYviN2UGdkVTnniGrydTlsHYTneUz8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuAF3DglYMm8cQupH2zs1Nb7VVHDqHP0R0H1uPR2FLHCA&oe=699D8F3A"}, {"file_name": "4.png", "id": "1945146272350783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031628_1945146275684116_3826679853630214683_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v295f5uSUr8Q7kNvwFC2m1x&_nc_oc=Adlt8K0FsUCoBphtRC-oAV4hACL5IQAWuee7mJxx_PG2oEB9Vs-pcqbuVKeS6u6R_Lc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvtY8gEg-Lq8-ZFU28coKCRTU7-boXeerqT1wy6hi3dAQ&oe=699D8BF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "897295084973730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75435289_897295088307063_5635641879931495254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KWQmNGtkrgQ7kNvwHEjJQn&_nc_oc=Adnu2_wJDtSmHBQBr_2C8ZZnryc3L1GOMJQkbMOkO8JW8nxdHjqcm2kHdoc33TOW5pk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft-xDWBA6SY1_SlUXBq6Rk1F-cAvxCs8fQhRLKCprMk_g&oe=699D9EE7"}, "display_name": "Crack Shot: Farm Frenzy Showdown", "keywords": ["Arcade", "clasic", "retro", "shooting", "animals"], "long_description": "Dang those varmints! Your peaceful farm is under siege, and it\u2019s up to you to defend your livestock from these pesky intruders. Armed with a trusty pump-action shotgun, you\u2019ll stand your ground on your porch and protect your territory.\n\nInspired by classic light gun games of the '80s, \"Crack Shot\" brings nostalgic shooting gallery fun to VR. As varmints and livestock pop up across your land, you have just 5 seconds to identify and eliminate the threats. Remember, don't shoot the livestock\u2014they're your pride and joy!\n\nHow quick is your draw? Sharpen your reflexes and prove your skills in this thrilling VR shooter.", "short_description": "Dang those varmints! Your peaceful farm is under siege, and it\u2019s up to you to defend your livestock from these pesky intruders. Armed with a trusty pump-action shotgun, you\u2019ll stand your ground on your porch and protect your territory."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/crackshot", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8233365460059491"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/65228545_483210314458425_9128222324799437762_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zz1v78oDY4kQ7kNvwH0qeTq&_nc_oc=AdkJvgd4VKZ_yqBKVaeD0B1uRXEJEo_seFdJhEElI-mhnbEUkUVip6qtpDiwt1G
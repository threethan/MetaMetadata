Q7kNvwHcPClY&_nc_oc=Adr085aRF8Ty0j_x_c3vS9RR6whvPPtQyg_xos7qmVPLt5lBuoHsa1GGEthU_KW4Zeo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Gp3wtdiF12-LI4FRw9ATsKV56xRxi2SH0LrbcAuODFQ&oe=6A3806FA"}, {"file_name": "4.png", "id": "1945146272350783", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031628_1945146275684116_3826679853630214683_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VAD9WZBVVxIQ7kNvwEeLtz0&_nc_oc=Ado-YEcQPVk1T8wWPI3pIkehWkoVLhDg3prsyEh497mVIwmkznGv7h6Am0L6GJzEByE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VLh_QrLPnzj7ib2hUy32NCYMg6qHctGtyoGb1z_kmbw&oe=6A3803B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "897295084973730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75435289_897295088307063_5635641879931495254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCaDxCweNfQQ7kNvwFH7XmR&_nc_oc=AdqVXnHEPDtXnw--MjSe4-uOmAZsXuuHicqmnXvaTYyw3A3gVf2hcJP6EUUPL0BbNaM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8G75Ze4qILhbgrzx2EtCVrl2-AwfK5xKhjLrangrtvgw&oe=6A37DE67"}, "display_name": "Crack Shot", "keywords": [], "long_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to clear 'em out.\n\nCrack Shot is a shooting gallery like the old light gun games of the 80's.  It's everything classic console kids loved!\n\nYou are a farmer armed with a pump action shot gun.  Standing on your porch, overlooking your land, varmints will pop-up along with livestock.  You have 5 seconds to identify the varmints and \"Git 'Em!\"\n\nDon't shoot the livestock.  They are your pride and joy.  \n\nHow quick is your draw?", "short_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to cl
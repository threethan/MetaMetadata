_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz23amVrZYfXwMqOAAOrs1Esg8CSHOKw0LOqIeWYW2UPw&oe=69B54A3A"}, {"file_name": "4.png", "id": "1945146272350783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031628_1945146275684116_3826679853630214683_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eakNGrP1cn4Q7kNvwFPZZQ4&_nc_oc=AdkK15VDmsD0AXgQRARgCkRm5f1y5GpVG-WcsXoyhr1bF9eGApkCzlqKPiQvY8vB_MM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyAN4M9dgSpWJhS1SBdQ9U5QW0thpNC-1FilYcSi96mPA&oe=69B546F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "897295084973730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75435289_897295088307063_5635641879931495254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2FiZ_t2GgUQ7kNvwEjz-GD&_nc_oc=Adm_gK8-zUMurmUFjkAxHzeBitoRtEfrAZsAXl2yRWYWxgzXmMNoN0Halmi0W1YxoMU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyGz7StMP181NPBe_kYDU4WNDxSXaExdzJuyROq0eqsfg&oe=69B559E7"}, "display_name": "Crack Shot", "keywords": [], "long_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to clear 'em out.\n\nCrack Shot is a shooting gallery like the old light gun games of the 80's.  It's everything classic console kids loved!\n\nYou are a farmer armed with a pump action shot gun.  Standing on your porch, overlooking your land, varmints will pop-up along with livestock.  You have 5 seconds to identify the varmints and \"Git 'Em!\"\n\nDon't shoot the livestock.  They are your pride and joy.  \n\nHow quick is your draw?", "short_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to clear 'em out."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixs
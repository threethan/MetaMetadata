_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFCy34u7YAec0rztFt94aHFdXsE4gu_4_zWIKu36wfNA&oe=69B69BBA"}, {"file_name": "4.png", "id": "1945146272350783", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031628_1945146275684116_3826679853630214683_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eakNGrP1cn4Q7kNvwGlkZAm&_nc_oc=AdnFwOoI1nXhHnRv827ycn4a3ZPs8PJIDslcNJhumNRhWBVJRZUtL-ctQ-jA4CG2mHI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz361r85MBJe2ivAoZaWbgKFlhNBfxvD0Yn__bC7wi_zg&oe=69B69878"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "897295084973730", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75435289_897295088307063_5635641879931495254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2FiZ_t2GgUQ7kNvwHqdTP5&_nc_oc=Adm1M9eOp8Xw2a49MtnIY-AKCHi6K5_Q-gjDD0gFPMRnFs8Cvw9putDy59yugV6sPek&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4M2t6lI-fycuiyojuLyzguHFTOQIqtyIMQ8e4aYxXlA&oe=69B6AB67"}, "display_name": "Crack Shot", "keywords": [], "long_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to clear 'em out.\n\nCrack Shot is a shooting gallery like the old light gun games of the 80's.  It's everything classic console kids loved!\n\nYou are a farmer armed with a pump action shot gun.  Standing on your porch, overlooking your land, varmints will pop-up along with livestock.  You have 5 seconds to identify the varmints and \"Git 'Em!\"\n\nDon't shoot the livestock.  They are your pride and joy.  \n\nHow quick is your draw?", "short_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to clear 'em out."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixs
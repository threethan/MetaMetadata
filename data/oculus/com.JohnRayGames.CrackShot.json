Q7kNvwF-bvKW&_nc_oc=AdqWR6-fRRaTQ6o9iQnbxOJ_gKC2ehAmJgUwlvQkcqj2tl2TxXvzBv27Jp4iu11qov0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-S-YYgHk-aKOEUvvqqpgwugaLWZu8Ujzvpsmk6PMwow&oe=6A04643A"}, {"file_name": "4.png", "id": "1945146272350783", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031628_1945146275684116_3826679853630214683_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_X4yft-osuIQ7kNvwGnsGmT&_nc_oc=AdoPCP5r62U6wUIryauDuFLHK9-QjMCu2iymxLyD3gK6c40yJqSv07mZ2bLNS0-biq4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dyZWHiGzHwVAnaaHoKH6XtQzlac1_aWef9z2H8zBRNw&oe=6A049938"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "897295084973730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75435289_897295088307063_5635641879931495254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPNPGq6S2GcQ7kNvwGwg_Ed&_nc_oc=AdoItRbc21qSF-A0EodoO2Sbab8tCtliZ-ALYfPrAgZEcSoYf2bR2nji8BPQg1ZXqz4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rnsWMbBQuZXhd8dAJSiCYBdD1khZHic261SnBK3zxYQ&oe=6A0473E7"}, "display_name": "Crack Shot", "keywords": [], "long_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to clear 'em out.\n\nCrack Shot is a shooting gallery like the old light gun games of the 80's.  It's everything classic console kids loved!\n\nYou are a farmer armed with a pump action shot gun.  Standing on your porch, overlooking your land, varmints will pop-up along with livestock.  You have 5 seconds to identify the varmints and \"Git 'Em!\"\n\nDon't shoot the livestock.  They are your pride and joy.  \n\nHow quick is your draw?", "short_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to cl
ear 'em out."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/crackshot", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1521242021630843"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1166983702267814"}, {"status": "PUBLISHED", "id": "3722507621381995"}, {"status": "PUBLISHED", "id": "1931483380929513"}, {"status": "PUBLISHED", "id": "2980886092080758"}, {"status": "PUBLISHED", "id": "1286902675759919"}, {"status": "PUBLISHED", "id": "1148341500346012"}, {"status": "PUBLISHED", "id": "362342766906329"}, {"status": "PUBLISHED", "id": "498681352866558"}, {"status": "PUBLISHED", "id": "3726585140922734"}, {"status": "PUBLISHED", "id": "5599270776834822"}]}, "baseline_offer": {"id": "3726585140922734"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768845600, "status": "PUBLISHED", "id": "1166983702267814"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5675479432514786", "version": "1"}, "id": "1444108556080480", "channel_name": "LIVE"}]}, "is_for_oculus_ke
731588869_1384111175339592020_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvaFzWpqeCwQ7kNvwGipYZz&_nc_oc=Adn0Z38gsKYr1a_q2npylvUlUt1zkbbd_LBI5HfM_Vn1gzDd-izJB-4geJ398Sg3kpU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs50FoogWQZiBBKwa0ZVhKUZ5FfmDGX7vqJeNLAu47KBg&oe=699AE560"}, {"file_name": "3.png", "id": "827712802006795", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035448_827712808673461_4578942403921936018_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utIy9VGEOKsQ7kNvwGjs613&_nc_oc=AdneybXUcUd8PTIa9zbTKe1YxTmQ9lHMVojsv1JW24hcyVH5331AaII14nNph8W10Y0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvDqhwM9BnYBxygjzd33n3gnD0QaM5WWZWR9ORicaRafw&oe=699AEC3A"}, {"file_name": "4.png", "id": "1945146272350783", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031628_1945146275684116_3826679853630214683_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2Ug1VNvTY8Q7kNvwELiOTZ&_nc_oc=AdlTip1WffmUqwZbVlLj5tOHIiy5zTtn4Z6qNA5GwqwE0DguCN1ZUlLSsfv9Y0z05b8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuIjGjh4DW98xjOgla7-_FXM4rgJucYan7l9K0iMpdC4w&oe=699AE8F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "897295084973730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75435289_897295088307063_5635641879931495254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ibTheNq47cQ7kNvwEiJ4Cq&_nc_oc=AdlQ_G9NH4FaljcpiM_R539xiOJQP2bjNN-5UqlKVchHvpEg2OhKx9H5dcaKN0ReJE0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuQSwkIBFyu-Ro4t-YbjwVxDka0XIJftsSyHbbnC1lo6g&oe=699AFBE7"}, "display_name": "Crack Shot: Farm Frenzy Showdown", "keywords": ["Arcade", "clasic", "retro", "shooting", "animals"], "long_description": "Dang those varmints! Your peaceful farm is under siege, and it\u2019s up to you to defend your livestock from these pesky intruders. Armed with a trusty pump-action shotgun, you\u2019ll stand your ground on your porch and protect your territory.\n\nInspired by classic light gun games of the '80s, \"Crack Shot\" brings nostalgic shooting gallery fun to VR. As varmints and livestock pop up across your land, you have just 5 seconds to identify and eliminate the threats. Remember, don't shoot the livestock\u2014they're your pride and joy!\n\nHow quick is your draw? Sharpen your reflexes and prove your skills in this thrilling VR shooter.", "short_description": "Dang those varmints! Your peaceful farm is under siege, and it\u2019s up to you to defend your livestock from these pesky intruders. Armed with a trusty pump-action shotgun, you\u2019ll stand your ground on your porch and protect your territory."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/crackshot", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8233365460059491"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65228545_483210314458425_9128222324799437762_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6YnDzXMbFoQ7kNvwE5ioNf&_nc_oc=Adk0M5cPE3y9mX-OJxiy-v4cRu5HQy3MFXxpHXcLKAHpruYi-9BABSWnQ6yHf-w
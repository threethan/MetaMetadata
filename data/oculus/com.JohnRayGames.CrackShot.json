Q7kNvwGjQh3a&_nc_oc=Adq719uJq5pwy35Peek-wGfc8OIsdvSfKoZuxNHDS0wWaUfUtdATd5gyhOTYcLx9qG4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHj2gEDdchm-WMW2JSYPgH1w0cJu8CRkNNBAk4c-j49ng&oe=6A972B3A"}, {"file_name": "4.png", "id": "1945146272350783", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031628_1945146275684116_3826679853630214683_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4D6YLHo_-oQQ7kNvwGYEdgX&_nc_oc=AdrEobuot8Zv9FU_O3ZMjYYw-hASJe4n2iYrWZKaBoOm_KYNjNwXTE9WmW2foz_2t40&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHu8gTQ5oQUnpEY7WKVW6HihnBf9sp1GOgxc3_f4gk9oQ&oe=6A9727F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "897295084973730", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75435289_897295088307063_5635641879931495254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-Jr6W992XQQ7kNvwFZbdhf&_nc_oc=Adoc_SNV84eGrgtx9hI-ViAKgr9KJ__5eQsurPOWIgCn8sZdskkTcHZvhsqAEMhnyQI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIblOTdDAO8YfDUUmT8ZEblAG3Xgq9Uiv-_SW46CkAiA&oe=6A973AE7"}, "display_name": "Crack Shot", "keywords": [], "long_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to clear 'em out.\n\nCrack Shot is a shooting gallery like the old light gun games of the 80's.  It's everything classic console kids loved!\n\nYou are a farmer armed with a pump action shot gun.  Standing on your porch, overlooking your land, varmints will pop-up along with livestock.  You have 5 seconds to identify the varmints and \"Git 'Em!\"\n\nDon't shoot the livestock.  They are your pride and joy.  \n\nHow quick is your draw?", "short_description": "Dang these varmints!  Your farm has some unwanted visitors and you must get rid of them before they eat your livestock.  Armed with your pump action shotgun, its time to cl
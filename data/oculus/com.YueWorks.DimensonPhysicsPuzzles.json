439122722499_6772626927287724886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guATmzv0EXYQ7kNvwF_7HID&_nc_oc=AdlQpsS08T413fmCdxgGXS6dsu6vxxt7OnbCYjh297-X8NVPU0SI36Q2wAVnrEWaoJk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwVpgDx_Sj54KkYIil530XJg-r_47lHaHlmD1rucmmFhQ&oe=69BBFBAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Querformat.png", "id": "1489237244807957", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974593_1489237248141290_8202735750981102479_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8U4cuqhAqIAQ7kNvwE5kjI2&_nc_oc=Adk1aIOb4LZ2v8j2sVwvoPFnpDJIN1fV-Mc4pI3hmURBWn5gKSiIgWafAoqwO5-0Uvs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz6cCiKrIcsyh82nh0OHzwhhtYDlGtQFp-StMUrtuhZ6w&oe=69BBD55E"}, "display_name": "Dimension Physics Puzzles", "keywords": [], "long_description": "Solve physics-puzzles by using nothing but your hands. This application is creating a physics simulation of your hands, that you can use to interact with the environment.\n\nThe goal is to solve these puzzles in the shortest time possible. How to achieve that is entirly up on you. You have tools like portals, bombs and lighters that you can use.\n\nAt the moment it has 1 puzzle pack with 5 puzzles.", "short_description": "Dimension Physics Puzzles is a physics based hand-tracking portal puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dimensionphysicspuzzles", "developer_terms_of_service_url": null, "publisher_name": "YueWorks", "support_website_url": null, "website_url": "https://yue-beifong.jimdosite.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "
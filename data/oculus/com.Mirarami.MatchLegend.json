HuaeWCJug&oe=6A8440EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover art 2560 1440.png", "id": "741053928480402", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298291_741053931813735_6054288331757493193_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JZXUkoqqW4Q7kNvwGNtsMo&_nc_oc=AdoSm4ZbheGEAzs4buwVaLXkFIWoWR8qnW9wQapjQI9yjvp1TvUr5hj6pvi_HskTgnc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqBl_eL3mz0Y4nIkSaTb0HaSmVAyo1roSlgnL80PntDQ&oe=6A8459B9"}, "display_name": "Match Legends", "keywords": [], "long_description": "Match Legends is a vibrant VR memory-matching adventure for Meta Quest 2/3/Pro. Flip cards in a 4x4 grid, racing against a dynamic timer that tightens across 32 levels (60s \u2192 30s). Six panels per level include special pairs for bonus rewards. Earn points (1\u20139 per match, up to 82 for perfect panels) and jewels via streaks (3/5/7 pairs) or high scores (50+).\n\nSpend jewels on power-ups: Timer+ (+10s), Cannon (clear panel), Sneak Peek (reveal cards), or Instant Match (auto-pair). Convert 100 jewels to gems for tougher levels.\n\nDive into whimsical worlds with stunning skyboxes, lively animations, and exciting audio (spatial effects for matches, warnings at 10s). Retry panels 3 times or skip with jewels.\n\nAfter completing levels, Free Play unlocks for replay, while Continue saves progress. Compete for high scores and perfect panels in this family-friendly, all-ages puzzle game\u2014simple to learn, challenging to master!", "short_description": "Match Legends is a vibrant VR memory-matching adventure for Meta Quest 2/3/Pro. Flip cards in a whimsical 4x4 grid, racing the dynamic clock to find pairs. Earn jewels via streaks and perfect scores to unlock power-ups like Timer Freeze and Cannon Boost. Explore stunning skyboxes, lively animations, and immersive audio in Mirarami\u2019s enchanting worlds. With intuitive controls and engaging gameplay, it\u2019s perfect for casual and expert puzzlers alike\u2014family-friendly fun for all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://miraramigames.wixsite.com/mirarami/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mirarami", "support_website_url": null, "website_url": "https://miraramigames.wixsite.com/mirarami", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23989220407363497"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1525444875206818"}, {"status": "PUBLISHED", "id": "1417821652805544"}]}, "baseline_offer": {"id": "1525444875206818"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768240980, "status": "PUBLISHED", "id": "1525444875206818"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27222620524023453", "version": "1.0.3"}, "id": "1071440597740143", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23882151214737084", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27222620524023453"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": 
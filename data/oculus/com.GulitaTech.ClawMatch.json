e7a0a&_nc_ohc=BQEuHeUoX24Q7kNvwGTA2bq&_nc_oc=Ado5h3UWRTTUaf_HuE2GSmKs-SBzL1hMTFU88ETQ7BcjOUo3nZc5GwlWL6jvoO_rIYs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCgZOPLRrOLa5lLFIQ53TgTBic89odndjVvw46OuZ6ZQ&oe=6AAD44A9"}, {"file_name": "secreenshopt4.png", "id": "1142124994049014", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393450_1142124997382347_1053989313703959917_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R721_7ZkDQwQ7kNvwGjtwmd&_nc_oc=Adq-G21veyoUJ9jTlz_qoa2IHSRjIwdSrEC2VQeWeOVSGQwvTOQcTgyHWkZ5fJjGr6E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJ1B9uI2Pun6isDXeI6ZmDK5rUT2LJ3LqTOzbiJBLxVQ&oe=6AAD5391"}, {"file_name": "secreenshopt6.png", "id": "633131099170368", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391932_633131102503701_7992954763248169413_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-ICf_bbYsEQ7kNvwEhNe2Y&_nc_oc=AdrYGEf35-R3q60n8jxF7FmBd4OPt6LsXGeDyw3JnObhCEJqMK6r1-lpDMuI4ekpQj0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeXT1CVVWn7E6lfVXekW5SF8Lc3RSmzE5C7MpKqz-y1A&oe=6AAD592E"}, {"file_name": "secreenshopt3.png", "id": "1872246483522769", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819961_1872246486856102_6494395123104062285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlshcFgWczcQ7kNvwHYKs0A&_nc_oc=AdptrlZ7wLHLSs_dn3SHL6o1PWCgFywJhoTOo4PPAWrI_Ot4AteMJ712eE4hQOV2b68&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJPI2e28RjvuXEZEuf3LQbg4EB3efh2vQRDgJZgiXHlw&oe=6AAD3C90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ClawMatchTralier_2560x1440-\u5c01\u9762.png", "id": "1864746831044218", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393444_1864746837710884_6542806525797600865_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpiSg5Y6f4UQ7kNvwHazEzt&_nc_oc=AdoorS8pKJ4nTd8RiV8TOHyURMIlIFUdsyvoKXNOnaJoCF8Fyu-MrYj55vechD6QBLE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmuVQFL9WU9KEvmciDuFFu6WP2U933FxT6leLHBkFVUw&oe=6AAD3C1D"}, "display_name": "Claw Match", "keywords": ["ClawMachine", "Simulator", "3Match", "Claw", "Arcade"], "long_description": "Claw Match combines the authentic claw machine experience with match-3 gameplay, taking you into a creative world of claw machines. In this game, you\u2019ll operate the claw machine with precision while using match-3 mechanics to tackle tasks, offering a fresh strategy and exciting gameplay!\n\nGame Features:\n\n\t1.\tClaw Machine Simulator: Operate the claw machine, and feel every movement of the claw.\n{1834277427325409}\n\t2.\tUnique Match-3 Experience: Combine claw machine gameplay with match-3 elements for a new elimination challenge.\n{665481632537449}\n\t3.\tFun Creative Levels: Each level is uniquely designed to enhance the claw machine fun, providing a rich gaming experience.\n{2166243717166315}\n\t4.\tHundreds of Fun Objects: From cute plush toys to creative items, see how many interesting objects you can grab.\n{579768198411871}\n\t5.\tRealistic Physical Feedback: With a precise physics engine and controller vibrations, experience every detail of the claw machine action.\n\nCreative Levels:\n\n\t\u2022\tDolls: Grab various adorable animal plush toys and unlock more.\n\t\u2022\tYammy Sushi: Feel like you\u2019re in a conveyor belt sushi restaurant. Grab your favorite sushi.\n\t\u2022\tFruit World: Grab delicious fruits and complete match-3 tasks in a vibrant fruit world.\n\t\u2022\tMini Cars: Grab moving mini cars on a racetrack.\n\t\u2022\tCasino: Grab lucky coins in a casino-themed claw machine.\n\t\u2022\tAnimals vs Zombies: Protect your animal friends by fending off zombies while grabbing toys and solving match-3 puzzles.\n", "short_description": "Claw Match combines the authentic claw machine experience with match-3 gameplay, transporting you into a creative world of claw machines. In this game, you not only need to operate the claw machine with precision, but also use match-3 mechanics to continuously challenge tasks, offering a fresh strategy and exciting gameplay !\n"}]}, "developer_name": "Gulita Studio", "developer_privacy_policy_url": "https://www.gulita.net/ClawMatch/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Gulita Stuido", "support_website_url": null, "website_url": "https://www.gulita.net/ClawMatch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10027870497244116"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824616_538764389036824_4659786280909073379_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNIEHgKMY2kQ7kNvwGCYhCe&_nc_oc=Adq-2M634GZEglq9Pi7AS2wgxPVzrK8BDsABFLgxhzJNnD61aeoEIl8w64XN5MSAXOY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiD5ZP382LqLhB5_nP9raV9sAQQVYeWrrSr5JMLNbCIA&oe=6AAD4839"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Claw Match", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "releas
e7a0a&_nc_ohc=RCMAt3l6gI4Q7kNvwF_cbHB&_nc_oc=Ado_uQOvVmqkTS2D2ArU0ClVtnepHXeJU6QDGpptj-_CkeZfvmLOpmdzckz4J6xnAP8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jelfjoDnJ-VAlO0S1CC86XIdnD62zrLnKRqS0dZg9Cw&oe=69E23DA9"}, {"file_name": "secreenshopt4.png", "id": "1142124994049014", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473393450_1142124997382347_1053989313703959917_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVIE1mmkAHAQ7kNvwFrdGji&_nc_oc=AdrEIDAg1dq9QXlbyGBFT-Zs6oTofdBsyGsGQCLh9RsNJVb6VINy-iVqAJT61VsFffE&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36BPbKndiuiWHo-dtWI6DE0UGGSVAwQjPtkqLgDsQAQg&oe=69E24C91"}, {"file_name": "secreenshopt6.png", "id": "633131099170368", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473391932_633131102503701_7992954763248169413_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k20_Fow_N64Q7kNvwHFTklV&_nc_oc=AdodiBmpeZjJJ0TjeVBcv9aYjsNxHhbYG1Eo_Q5d6cWcfw8wdpULzSx9-YOSrZ6KFRY&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2j0Y9BeVFtrEqN2rwCAl4BQ_VGlPk56ATLHDiNlPWOcQ&oe=69E219EE"}, {"file_name": "secreenshopt3.png", "id": "1872246483522769", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491819961_1872246486856102_6494395123104062285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeO-LwuHWSoQ7kNvwF6JtGt&_nc_oc=AdpJsSJRNQ0kMFmiJnaLXfooGlxRdBET8nMMr1jsVxDwa5VY4Ye-UGs0dDqGdHJOU7o&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af275gziRP8onrkewVjmdDT65QCakT7trmJ02lZId3bO5w&oe=69E23590"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ClawMatchTralier_2560x1440-\u5c01\u9762.png", "id": "1864746831044218", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393444_1864746837710884_6542806525797600865_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=or0V9hbHCtMQ7kNvwE01Zzn&_nc_oc=AdoW9JyvUhZdgd4GlNcsiY25tNp7K4PCvqGMaXU8R7gu34yNguOIHljJpZWM60oiJzA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JK7-My-lEs41iZYJEdc8zPeiZwgtYd77gHkmxUWsCyw&oe=69E2351D"}, "display_name": "Claw Match", "keywords": ["ClawMachine", "Simulator", "3Match", "Claw", "Arcade"], "long_description": "Claw Match combines the authentic claw machine experience with match-3 gameplay, taking you into a creative world of claw machines. In this game, you\u2019ll operate the claw machine with precision while using match-3 mechanics to tackle tasks, offering a fresh strategy and exciting gameplay!\n\nGame Features:\n\n\t1.\tClaw Machine Simulator: Operate the claw machine, and feel every movement of the claw.\n{1834277427325409}\n\t2.\tUnique Match-3 Experience: Combine claw machine gameplay with match-3 elements for a new elimination challenge.\n{665481632537449}\n\t3.\tFun Creative Levels: Each level is uniquely designed to enhance the claw machine fun, providing a rich gaming experience.\n{2166243717166315}\n\t4.\tHundreds of Fun Objects: From cute plush toys to creative items, see how many interesting objects you can grab.\n{579768198411871}\n\t5.\tRealistic Physical Feedback: With a precise physics engine and controller vibrations, experience every detail of the claw machine action.\n\nCreative Levels:\n\n\t\u2022\tDolls: Grab various adorable animal plush toys and unlock more.\n\t\u2022\tYammy Sushi: Feel like you\u2019re in a conveyor belt sushi restaurant. Grab your favorite sushi.\n\t\u2022\tFruit World: Grab delicious fruits and complete match-3 tasks in a vibrant fruit world.\n\t\u2022\tMini Cars: Grab moving mini cars on a racetrack.\n\t\u2022\tCasino: Grab lucky coins in a casino-themed claw machine.\n\t\u2022\tAnimals vs Zombies: Protect your animal friends by fending off zombies while grabbing toys and solving match-3 puzzles.\n", "short_description": "Claw Match combines the authentic claw machine experience with match-3 gameplay, transporting you into a creative world of claw machines. In this game, you not only need to operate the claw machine with precision, but also use match-3 mechanics to continuously challenge tasks, offering a fresh strategy and exciting gameplay !\n"}]}, "developer_name": "Gulita Studio", "developer_privacy_policy_url": "https://www.gulita.net/ClawMatch/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Gulita Stuido", "support_website_url": null, "website_url": "https://www.gulita.net/ClawMatch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10027870497244116"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491824616_538764389036824_4659786280909073379_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_oLAAxgeUEQ7kNvwHnonFL&_nc_oc=AdqcAo3urjEzVWx0P11Fqv_Zu5l6cH-6xaIv4QYDR1oCH4dk661UfYlanVnSzi3xTds&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OTpQeQWko1LKnwdjDab95njCsSY-eE5fJU3j6fJoI-A&oe=69E24139"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Claw Match", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "releas
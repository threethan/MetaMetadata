3444_9607070015983373_6225641983139563788_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1imvMiWAP8MQ7kNvwHE8mMV&_nc_oc=AdrBAqbvHeeDX-4uansZFC6giVLDlwVKmYOHNwHL04yTDn0jmtmBvcSf3hQC3Kdaawg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDzjW8Lcodo15tdsaAH68oStg74XQwz-nqbnc2VquHug&oe=6A69FCBE"}, {"file_name": "secreenshopt2.png", "id": "1854521975368671", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1854521978702004_8380765414074328213_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pN8gHe1wmSoQ7kNvwHra6en&_nc_oc=AdpHOack9CBCFzX7tCFvf5HbHGNsGoPvNczyortHjE5HLLCmN2PlrhNsao97VzyzYcA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxiaqbpXE3yq7b6YKXDLSyYRrxNVXZXEGRmcqRLqXPsA&oe=6A6A0829"}, {"file_name": "secreenshopt4.png", "id": "1142124994049014", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393450_1142124997382347_1053989313703959917_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ux4C3VKq9wYQ7kNvwHcSHiw&_nc_oc=AdrnGb3Id47DCaCrGzE6yzEdIzPPKCF19mM23mazFCaXGJ0zjWKW0WjFhdNdyo2TpUY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWvA_Iv-eMlAsL5jRUB3y4dZNJ2Q4dCEtaHe-bB2WHwA&oe=6A69DED1"}, {"file_name": "secreenshopt6.png", "id": "633131099170368", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391932_633131102503701_7992954763248169413_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwaHMUCpE00Q7kNvwFOBbRF&_nc_oc=AdrwOQJ-vNNIpjKOg1raaKfE5y2N4iEWnlyNTOvyC7ITUO4RsX0fUMBlMgEPPd4E1ms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyWx_GYNpG_gB57dIXk76zAg72UiSw3N19t9J2wa_qig&oe=6A69E46E"}, {"file_name": "secreenshopt5.png", "id": "899734022083190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392309_899734025416523_7639174057275116205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqvWnOqySVAQ7kNvwHe49Cn&_nc_oc=AdpeRpGw0T97Vgv0RmlPL8C4JG-4B70AXmOGMG4_Hpikgdjj6yRcsyMmLS_aTKGXcww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsdweObbMenSWCQIpdK7xWXDzPbugZwssI3Q9MY2lrAw&oe=6A6A0ABB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ClawMatchTralier_2560x1440-\u5c01\u9762.png", "id": "1864746831044218", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393444_1864746837710884_6542806525797600865_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIehd-f1hIIQ7kNvwHbgihm&_nc_oc=Adp3WJX9BqkVeW2a4jr5e8LfNJhw_Ccff7XGCVpZZYu0SZ85kGDwt4qIWoyAX_6gXas&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyGLKbndZV3ci6xMkKZFlPCuoSzRpeR8hLvqmH4UIUSg&oe=6A69FF9D"}, "display_name": "Claw Match", "keywords": ["ClawMachine", "Simulator", "3Match", "Puzzle", "ClawMachineSimulator"], "long_description": "Claw Match combines the authentic claw machine experience with match-3 gameplay, taking you into a creative world of claw machines. In this game, you\u2019ll operate the claw machine with precision while using match-3 mechanics to tackle tasks, offering a fresh strategy and exciting gameplay!\n\nGame Features:\n\t1.\tClaw Machine Simulator: Operate the claw machine, and feel every movement of the claw.\n\t2.\tUnique Match-3 Experience: Combine claw machine gameplay with match-3 elements for a new elimination challenge.\n\t3.\tFun Creative Levels: Each level is uniquely designed to enhance the claw machine fun, providing a rich gaming experience.\n\t4.\tHundreds of Fun Objects: From cute plush toys to creative items, see how many interesting objects you can grab.\n\t5.\tRealistic Physical Feedback: With a precise physics engine and controller vibrations, experience every detail of the claw machine action.\n\nCreative Levels:\n\t\u2022\tDolls: Grab various adorable animal plush toys and unlock more.\n\t\u2022\tYammy Sushi: Feel like you\u2019re in a conveyor belt sushi restaurant. Grab your favorite sushi.\n\t\u2022\tFruit World: Grab delicious fruits and complete match-3 tasks in a vibrant fruit world.\n\t\u2022\tMini Cars: Grab moving mini cars on a racetrack.\n\t\u2022\tCasino: Grab lucky coins in a casino-themed claw machine.\n\t\u2022\tAnimals vs Zombies: Protect your animal friends by fending off zombies while grabbing toys and solving match-3 puzzles.", "short_description": "Claw Match combines the authentic claw machine experience with match-3 gameplay, transporting you into a creative world of claw machines. In this game, you not only need to operate the claw machine with precision, but also use match-3 mechanics to continuously challenge tasks, offering a fresh strategy and exciting gameplay!\n"}]}, "developer_name": "Gulita Studio", "developer_privacy_policy_url": "https://www.gulita.net/ClawMatch/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Gulita Stuido", "support_website_url": null, "website_url": "https://www.gulita.net/ClawMatch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9730649656966203"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "2565608753894185"}, {"status": "PUBLISHED", "id": "2420684895120791"}, {"status": "PUBLISHED", "id": "968934882452453"}, {"status": "PUBLISHED", "id": "1442860897189779"}, {"status": "PUBLISHED", "id": "25813471324978746"}, {"status": "PUBLISHED", "id": "2288849171589422"}, {"status": "PUBLISHED", "id": "260676969
7kNvwE4giC4&_nc_oc=AdnGSin__V-QdfGzBv5n1ZBQAHOiX2hdeyE7Iub0JdwHqemf3qLpfnrhFdqUX_c6Ysk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afz_vfQOgr1Rr2_4BWwM_7BiJTu19EWDXn-npOC-jT5gIA&oe=69AADEA9"}, {"file_name": "secreenshopt4.png", "id": "1142124994049014", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473393450_1142124997382347_1053989313703959917_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjE7AIxas-kQ7kNvwGXE-X8&_nc_oc=AdlLRurTlRv3evwKm66Lc5-oJZC2YAcjha0tEleYhxEKSS7rx1k51AV9WCYPZHYhg5E&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwnxamGxgYUg5kjQ0-H43AX7MXqv1DPct9htF04MSgb5g&oe=69AAB551"}, {"file_name": "secreenshopt6.png", "id": "633131099170368", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391932_633131102503701_7992954763248169413_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kr7ozV4rvlwQ7kNvwErlT4d&_nc_oc=AdlFdpryasoFjgSHwZ39o-J7253kLL4vJP8QrSlTzSeEgpTnTYluimX-EdqEZyb31zI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfwKy81w_QPGXCRuSCEC_c4_JtlDRQbyeiyCxwAJcW0BbQ&oe=69AABAEE"}, {"file_name": "secreenshopt3.png", "id": "1872246483522769", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491819961_1872246486856102_6494395123104062285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JX8XwxU2CR4Q7kNvwEDTyCQ&_nc_oc=AdnWV-aF5UTqerrxZWlvC4zipB2nQ--bkC94ZY6Q7JjLW-B3JFsMgO6fWehHk6UrSfc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afxnwa8Tdt6OXRIQ9k-CIp7goc7Uv4EKL7g-wZHCeMWtMQ&oe=69AAD690"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ClawMatchTralier_2560x1440-\u5c01\u9762.png", "id": "1864746831044218", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393444_1864746837710884_6542806525797600865_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rY0M3WitnRIQ7kNvwGx16ND&_nc_oc=AdkXM7SaayB5RW_wYvQ8jf_BcN66bFtAgj7NfQiE3yUxPvZ5tX81ao4mIA4Dqmwm6jw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfyMgfp0dm1Gl5nfUKct8VGmvZDyFeMKXznQID5mTMVCUA&oe=69AAD61D"}, "display_name": "Claw Match", "keywords": ["ClawMachine", "Simulator", "3Match", "Claw", "Arcade"], "long_description": "Claw Match combines the authentic claw machine experience with match-3 gameplay, taking you into a creative world of claw machines. In this game, you\u2019ll operate the claw machine with precision while using match-3 mechanics to tackle tasks, offering a fresh strategy and exciting gameplay!\n\nGame Features:\n\n\t1.\tClaw Machine Simulator: Operate the claw machine, and feel every movement of the claw.\n{1834277427325409}\n\t2.\tUnique Match-3 Experience: Combine claw machine gameplay with match-3 elements for a new elimination challenge.\n{665481632537449}\n\t3.\tFun Creative Levels: Each level is uniquely designed to enhance the claw machine fun, providing a rich gaming experience.\n{2166243717166315}\n\t4.\tHundreds of Fun Objects: From cute plush toys to creative items, see how many interesting objects you can grab.\n{579768198411871}\n\t5.\tRealistic Physical Feedback: With a precise physics engine and controller vibrations, experience every detail of the claw machine action.\n\nCreative Levels:\n\n\t\u2022\tDolls: Grab various adorable animal plush toys and unlock more.\n\t\u2022\tYammy Sushi: Feel like you\u2019re in a conveyor belt sushi restaurant. Grab your favorite sushi.\n\t\u2022\tFruit World: Grab delicious fruits and complete match-3 tasks in a vibrant fruit world.\n\t\u2022\tMini Cars: Grab moving mini cars on a racetrack.\n\t\u2022\tCasino: Grab lucky coins in a casino-themed claw machine.\n\t\u2022\tAnimals vs Zombies: Protect your animal friends by fending off zombies while grabbing toys and solving match-3 puzzles.\n", "short_description": "Claw Match combines the authentic claw machine experience with match-3 gameplay, transporting you into a creative world of claw machines. In this game, you not only need to operate the claw machine with precision, but also use match-3 mechanics to continuously challenge tasks, offering a fresh strategy and exciting gameplay !\n"}]}, "developer_name": "Gulita Studio", "developer_privacy_policy_url": "https://www.gulita.net/ClawMatch/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Gulita Stuido", "support_website_url": null, "website_url": "https://www.gulita.net/ClawMatch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10027870497244116"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824616_538764389036824_4659786280909073379_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCusg9XmO6EQ7kNvwF9xz5f&_nc_oc=AdlaPnBg0bdfDe7cwDQFyazjnsbEt68E5TFCYT0kYc8QB9c_2eUSTEuXOiVKMkmeVnU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afw0INNYLlu0-LViglDFsUVzdgz41Aft8GQZgTuOWSdW5w&oe=69AAE239"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Claw Match", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1742858280, "lastRevision": {"nod
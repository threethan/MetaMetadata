3444_9607070015983373_6225641983139563788_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9sAAg4sfbMQ7kNvwFGutaR&_nc_oc=AdqG7QFCgFwNgy3lfqsK1ALBE6n20lxVAMzQrG20d2M2l09Gn5pNWEzMIJQjfkaMJAw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpltHlYcUEriMRvMZlm8dq4xHfOKAOtuEOEVpHb_487w&oe=6AF7457E"}, {"file_name": "secreenshopt2.png", "id": "1854521975368671", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392309_1854521978702004_8380765414074328213_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_vHBsOPI0YQ7kNvwHxqpFc&_nc_oc=Adp-ZVdDl6O5jY5TPMMzTlpIC6FhHY5tRYESzBuEl5rzQEo5yDiaEz-XM-nHlRWp28k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXq5kas8g5ackXyK_sTmi2UQbLswpbd2ElvhMpu4SOlA&oe=6AF718A9"}, {"file_name": "secreenshopt4.png", "id": "1142124994049014", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393450_1142124997382347_1053989313703959917_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4i1Xsn99QYcQ7kNvwGHsOKz&_nc_oc=AdrAIZDF8EWieuyoVLluRnfAt8-ad5cy-VilmKwKbt_sgcuZh56Gm9cY_UmXN7xuKmU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQU1AUXGIav47BMAOMTzyi0AA0GbFBKBUOP37ghsrJYwg&oe=6AF72791"}, {"file_name": "secreenshopt6.png", "id": "633131099170368", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391932_633131102503701_7992954763248169413_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M39EFrQjYUQQ7kNvwHHkRss&_nc_oc=Adr7l7v8sSPJlpZuO3wz8JMp_fTRjdX22fynbAF5auUCFCv_SKwO082sIdBdyz5eeVI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzoVCzxeB7tDKTR9Ei3JLypXp0QBRM0pUciaze-j8yng&oe=6AF72D2E"}, {"file_name": "secreenshopt5.png", "id": "899734022083190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392309_899734025416523_7639174057275116205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIlxZrkPKHMQ7kNvwGetfsZ&_nc_oc=AdqZHIMgJgzf-IxkmWF7n_qSkjFS2bBYZNAfZFR0apZtgQQiYJXQtfcwxFwEOnScKcU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTER8VsYSZl_mXx2Hiv8HFJN9wnMFiboXvG7mt84-3ffg&oe=6AF71B3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ClawMatchTralier_2560x1440-\u5c01\u9762.png", "id": "1864746831044218", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393444_1864746837710884_6542806525797600865_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vx7Fk6vdYq4Q7kNvwEGBFx0&_nc_oc=Adpn-kMfrZQm8bMBw_GYaTdBzJKNXtP3EqDfIiRUTRu_YUSFiL6oMQfw0qjOZ3eu8XQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0pThYbUOb3bvi1fJCLiRyY_47TCaBX-B8ARFnLfhpAQ&oe=6AF7485D"}, "display_name": "Claw Match", "keywords": ["ClawMachine", "Simulator", "3Match", "Puzzle", "ClawMachineSimulator"], "long_description": "Claw Match combines the authentic claw machine experience with match-3 gameplay, taking you into a creative world of claw machines. In this game, you\u2019ll operate the claw machine with precision while using match-3 mechanics to tackle tasks, offering a fresh strategy and exciting gameplay!\n\nGame Features:\n\t1.\tClaw Machine Simulator: Operate the claw machine, and feel every movement of the claw.\n\t2.\tUnique Match-3 Experience: Combine claw machine gameplay with match-3 elements for a new elimination challenge.\n\t3.\tFun Creative Levels: Each level is uniquely designed to enhance the claw machine fun, providing a rich gaming experience.\n\t4.\tHundreds of Fun Objects: From cute plush toys to creative items, see how many interesting objects you can grab.\n\t5.\tRealistic Physical Feedback: With a precise physics engine and controller vibrations, experience every detail of the claw machine action.\n\nCreative Levels:\n\t\u2022\tDolls: Grab various adorable animal plush toys and unlock more.\n\t\u2022\tYammy Sushi: Feel like you\u2019re in a conveyor belt sushi restaurant. Grab your favorite sushi.\n\t\u2022\tFruit World: Grab delicious fruits and complete match-3 tasks in a vibrant fruit world.\n\t\u2022\tMini Cars: Grab moving mini cars on a racetrack.\n\t\u2022\tCasino: Grab lucky coins in a casino-themed claw machine.\n\t\u2022\tAnimals vs Zombies: Protect your animal friends by fending off zombies while grabbing toys and solving match-3 puzzles.", "short_description": "Claw Match combines the authentic claw machine experience with match-3 gameplay, transporting you into a creative world of claw machines. In this game, you not only need to operate the claw machine with precision, but also use match-3 mechanics to continuously challenge tasks, offering a fresh strategy and exciting gameplay!\n"}]}, "developer_name": "Gulita Studio", "developer_privacy_policy_url": "https://www.gulita.net/ClawMatch/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Gulita Stuido", "support_website_url": null, "website_url": "https://www.gulita.net/ClawMatch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9730649656966203"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "2534650423701621"}, {"status": "PUBLISHED", "id": "2565608753894185"}, {"status": "PUBLISHED", "id": "2420684895120791"}, {"status": "PUBLISHED", "id": "968934882452453"}, {"status": "PUBLISHED", "id": "1442860897189779"}, {"status": "PUBLISHED", "id": "25813471324978746"}, {"status": "PUBLISHED", "id": "228884917
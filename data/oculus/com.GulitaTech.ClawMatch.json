3444_9607070015983373_6225641983139563788_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THELSoo9Pn8Q7kNvwFvjyjI&_nc_oc=AdpwD4Mg_BlPb5UBUofChPOoqqZM9x8WkrGGgFdU-lik4KOuWztGy-rWT-vOtO5YqSg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47ILLWk8WED0LPbwvD3AAfLD5-yuMUgtytdVxUsWneTQ&oe=6A159CBE"}, {"file_name": "secreenshopt2.png", "id": "1854521975368671", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392309_1854521978702004_8380765414074328213_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlrTPm1mlfYQ7kNvwEVXkd7&_nc_oc=Adqjq5K1P2wfs_TAPklopEJJZKiLrN0MGBd5JtCezm8Q9-Yp5raXseYr519wYCkl0uQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62DIwdpPE-SDZ6X6NAgUcq7yNrZMWpy0QhNaNQG1AiRw&oe=6A15A829"}, {"file_name": "secreenshopt4.png", "id": "1142124994049014", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393450_1142124997382347_1053989313703959917_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORWzltNSKR0Q7kNvwG6aH-T&_nc_oc=AdoMiZbaURIQW5o0Ic8n5ZOv65mok-Qtt5aDP9zPyUCX2HhYJLs5eQGGEqbQ88q_AHo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xPyLKJKk2ntVr2EiTWLcB7P7VkO50OQmJBKJAex1y4A&oe=6A15B711"}, {"file_name": "secreenshopt6.png", "id": "633131099170368", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391932_633131102503701_7992954763248169413_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AaqW-toipQQ7kNvwERJVOy&_nc_oc=AdqrrJXERNxTKYT8xnRipEhERgYA5jhJ9bWSBN7wux3U9BVsJBkzJ-TEowVodsCIvRA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KwQIjlSt87I_hjYa7K1dN5wxiITh57Sfcqf5AK22UXQ&oe=6A15BCAE"}, {"file_name": "secreenshopt5.png", "id": "899734022083190", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392309_899734025416523_7639174057275116205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sP74kC7tz6cQ7kNvwHsgZGJ&_nc_oc=Adpzh9ch1NMoQsNDm-_fu9-9G-FtKPTz12P0KW9Y5Hbt4N3ozkLICvK9QJwe5uPSbAs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5b87PkZwwVkxHfiEKcSjZrQNR_gcVCuevhhBlgNu2mdA&oe=6A15AABB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ClawMatchTralier_2560x1440-\u5c01\u9762.png", "id": "1864746831044218", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393444_1864746837710884_6542806525797600865_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_34w-kskraQQ7kNvwGlaDVh&_nc_oc=Adr2SiJ7jQ6jjPZttDiiGJUVk5eV2EABnmzcB_RkMVCp3H9OJnHp3nn7Apf5tBY7NEw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hPGnpvzaCZeQxyJ5SeAEPrEuQNEXeiewVmjXdFuv1sQ&oe=6A159F9D"}, "display_name": "Claw Match", "keywords": ["ClawMachine", "Simulator", "3Match", "Puzzle", "ClawMachineSimulator"], "long_description": "Claw Match combines the authentic claw machine experience with match-3 gameplay, taking you into a creative world of claw machines. In this game, you\u2019ll operate the claw machine with precision while using match-3 mechanics to tackle tasks, offering a fresh strategy and exciting gameplay!\n\nGame Features:\n\t1.\tClaw Machine Simulator: Operate the claw machine, and feel every movement of the claw.\n\t2.\tUnique Match-3 Experience: Combine claw machine gameplay with match-3 elements for a new elimination challenge.\n\t3.\tFun Creative Levels: Each level is uniquely designed to enhance the claw machine fun, providing a rich gaming experience.\n\t4.\tHundreds of Fun Objects: From cute plush toys to creative items, see how many interesting objects you can grab.\n\t5.\tRealistic Physical Feedback: With a precise physics engine and controller vibrations, experience every detail of the claw machine action.\n\nCreative Levels:\n\t\u2022\tDolls: Grab various adorable animal plush toys and unlock more.\n\t\u2022\tYammy Sushi: Feel like you\u2019re in a conveyor belt sushi restaurant. Grab your favorite sushi.\n\t\u2022\tFruit World: Grab delicious fruits and complete match-3 tasks in a vibrant fruit world.\n\t\u2022\tMini Cars: Grab moving mini cars on a racetrack.\n\t\u2022\tCasino: Grab lucky coins in a casino-themed claw machine.\n\t\u2022\tAnimals vs Zombies: Protect your animal friends by fending off zombies while grabbing toys and solving match-3 puzzles.", "short_description": "Claw Match combines the authentic claw machine experience with match-3 gameplay, transporting you into a creative world of claw machines. In this game, you not only need to operate the claw machine with precision, but also use match-3 mechanics to continuously challenge tasks, offering a fresh strategy and exciting gameplay!\n"}]}, "developer_name": "Gulita Studio", "developer_privacy_policy_url": "https://www.gulita.net/ClawMatch/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Gulita Stuido", "support_website_url": null, "website_url": "https://www.gulita.net/ClawMatch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9730649656966203"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "968934882452453"}, {"status": "PUBLISHED", "id": "1442860897189779"}, {"status": "PUBLISHED", "id": "25813471324978746"}, {"status": "PUBLISHED", "id": "2288849171589422"}, {"status": "PUBLISHED", "id": "26067696982820660"}, {"status": "PUBLISHED", "id": "1986197815480652"}, {"status": "PUBLISHED", "id": "14649594
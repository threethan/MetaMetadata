_sid=6e7a0a&_nc_ohc=ks-Okus54NEQ7kNvwFhxyTL&_nc_oc=Adqjq7iPznei3F8x8XiYGE9drRZQXUI2qfJ84_vP36_nm5SRYOd5wEdjeK34kYo-Ckw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ic04DPlPLKt-xu8HP-j1kRYgbzHDEKZnFyrLOMcQHDw&oe=6A466FA9"}, {"file_name": "secreenshopt4.png", "id": "1142124994049014", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473393450_1142124997382347_1053989313703959917_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibF3_F6lYdEQ7kNvwG1Ssnc&_nc_oc=AdoNtzmko360s6Uwjb9HU_B2JbJpBWhVU3sXuzIRnR4dwdY6dLE1uwdtje50_T9_wJw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JfHBp7vDto073kNH-ulPWq_SIOQdNxw5W-zBG0Bxttg&oe=6A467E91"}, {"file_name": "secreenshopt6.png", "id": "633131099170368", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391932_633131102503701_7992954763248169413_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prN1QOl_oAkQ7kNvwGngx2u&_nc_oc=AdqNJouMkJDC_vgzpDbI6moRMjwtzMDpUGTnllqA5tdwJS4hr8rH4Mma7KRKqlyXhIg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3qH3p9KZnE8K5mTUy1WbZoCb-3AIpqeZ5j4QrJMpoFQ&oe=6A46842E"}, {"file_name": "secreenshopt3.png", "id": "1872246483522769", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491819961_1872246486856102_6494395123104062285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ew-Vm_aqc4Q7kNvwHgjVWH&_nc_oc=AdqVWtTDYOssJTHZhAcSTvbX1Ts07Q2TRhL_5x8pF4tPMP5Y86NqcdA1OraHd9zQ9P0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZB-TzbwXJhronAWsMqNF-NYGH3xZfAdRkbUAreysk_A&oe=6A466790"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ClawMatchTralier_2560x1440-\u5c01\u9762.png", "id": "1864746831044218", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393444_1864746837710884_6542806525797600865_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jv_9v-ooGvkQ7kNvwEuBAZd&_nc_oc=Adp_D_cwHvN5DnOlSKcoT8q3ss83rvLDpjw4k54TNzuqCw6m-zXyAypAl2JKB-tP-AA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lgpEEV9TFFluARDA8TwWUkRpYmHQOJ1ggq26Qmd8A1Q&oe=6A46671D"}, "display_name": "Claw Match", "keywords": ["ClawMachine", "Simulator", "3Match", "Claw", "Arcade"], "long_description": "Claw Match combines the authentic claw machine experience with match-3 gameplay, taking you into a creative world of claw machines. In this game, you\u2019ll operate the claw machine with precision while using match-3 mechanics to tackle tasks, offering a fresh strategy and exciting gameplay!\n\nGame Features:\n\n\t1.\tClaw Machine Simulator: Operate the claw machine, and feel every movement of the claw.\n{1834277427325409}\n\t2.\tUnique Match-3 Experience: Combine claw machine gameplay with match-3 elements for a new elimination challenge.\n{665481632537449}\n\t3.\tFun Creative Levels: Each level is uniquely designed to enhance the claw machine fun, providing a rich gaming experience.\n{2166243717166315}\n\t4.\tHundreds of Fun Objects: From cute plush toys to creative items, see how many interesting objects you can grab.\n{579768198411871}\n\t5.\tRealistic Physical Feedback: With a precise physics engine and controller vibrations, experience every detail of the claw machine action.\n\nCreative Levels:\n\n\t\u2022\tDolls: Grab various adorable animal plush toys and unlock more.\n\t\u2022\tYammy Sushi: Feel like you\u2019re in a conveyor belt sushi restaurant. Grab your favorite sushi.\n\t\u2022\tFruit World: Grab delicious fruits and complete match-3 tasks in a vibrant fruit world.\n\t\u2022\tMini Cars: Grab moving mini cars on a racetrack.\n\t\u2022\tCasino: Grab lucky coins in a casino-themed claw machine.\n\t\u2022\tAnimals vs Zombies: Protect your animal friends by fending off zombies while grabbing toys and solving match-3 puzzles.\n", "short_description": "Claw Match combines the authentic claw machine experience with match-3 gameplay, transporting you into a creative world of claw machines. In this game, you not only need to operate the claw machine with precision, but also use match-3 mechanics to continuously challenge tasks, offering a fresh strategy and exciting gameplay !\n"}]}, "developer_name": "Gulita Studio", "developer_privacy_policy_url": "https://www.gulita.net/ClawMatch/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Gulita Stuido", "support_website_url": null, "website_url": "https://www.gulita.net/ClawMatch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10027870497244116"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824616_538764389036824_4659786280909073379_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEdF2Z61OJMQ7kNvwF9baW_&_nc_oc=Adr1CleG_Ix6ps2PUjS8lMlMBq4ZvbTbID_w_35PlMWzi_Zkm8r8NnD6Z_Xc592CoHc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2v8c_-UwpyXfCwXHm_YjUvMCFqbR4kLzevZeqe3ZlVw&oe=6A467339"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Claw Match", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Puzzle", "id": "3779783902724
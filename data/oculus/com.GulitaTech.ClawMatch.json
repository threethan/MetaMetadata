3444_9607070015983373_6225641983139563788_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAp7ISeM52UQ7kNvwGlamS3&_nc_oc=Adp09mu4fpCuuFrfZWIbgDh6WuoIC2qOsQoPSNAKP4XrwYxrOt82XuZ_d3wgPhhfbPI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afze41IPPPkRS4l4ws-z0cCwQq5JLjXHLmcEckuISGi5HA&oe=69C28E3E"}, {"file_name": "secreenshopt2.png", "id": "1854521975368671", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392309_1854521978702004_8380765414074328213_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1Z6C22LSlsQ7kNvwH-90YW&_nc_oc=Adq9QDz-ZyFFV_D05J5TRZ9vY0eBsR8GCyDRgXm7IvWk3DCvGFtbyLSerSPtBshfM74&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwsiA00vVCMlTZt5g2FINppQoCCvMZbq74S6KWq5gWYTQ&oe=69C299A9"}, {"file_name": "secreenshopt4.png", "id": "1142124994049014", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393450_1142124997382347_1053989313703959917_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKuYu4d33L4Q7kNvwG4-HWG&_nc_oc=AdoEETkat5WNpgBvCy-ANVUdQy4Zr-vijmXNPh6e1By4RNLgIUPI0ZVhAhh_5S8zDtc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyDwIiXdSz9-vYnPTgbSvvlviDR58Ry23LULd0_ApCCcw&oe=69C27051"}, {"file_name": "secreenshopt6.png", "id": "633131099170368", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391932_633131102503701_7992954763248169413_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouqirXlbsK8Q7kNvwEGvPEP&_nc_oc=Adqd8xNFNM-1zjh1XahpDjPmav8lP4VHPXVkml5wCIkpusqn8dDTqSUIAfCN-uLrqJY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxhCWJKj92CYzjyUC9lz6QMhNxBbiD2SmuH2NmsgAroow&oe=69C275EE"}, {"file_name": "secreenshopt5.png", "id": "899734022083190", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392309_899734025416523_7639174057275116205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4v9pHLPIMQQ7kNvwEhR8ZW&_nc_oc=Adp7Tt4lgwMC30OMdscdt_4MYcBA9q3lDjr6lSTS8N5QFQmDdApzzgqy6DLkbsYQ4xo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8KD9sqk-8d977yTqvvwqr6Gyyyrg1hCW1oDyDdv9Y4g&oe=69C29C3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ClawMatchTralier_2560x1440-\u5c01\u9762.png", "id": "1864746831044218", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393444_1864746837710884_6542806525797600865_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGw_VAqHtW8Q7kNvwEVvrXc&_nc_oc=Ado2hP2_pJPIliqxvh7-_Sf7Q2rwjWkZWE8G__3Qkju0z6-N-8eGokwZTFYVPa0OjIY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKfoJtNXPyxpt3qvdXeFycqU2GqjWJLvxZ9frVQ0NAiA&oe=69C2911D"}, "display_name": "Claw Match", "keywords": ["ClawMachine", "Simulator", "3Match", "Puzzle", "ClawMachineSimulator"], "long_description": "Claw Match combines the authentic claw machine experience with match-3 gameplay, taking you into a creative world of claw machines. In this game, you\u2019ll operate the claw machine with precision while using match-3 mechanics to tackle tasks, offering a fresh strategy and exciting gameplay!\n\nGame Features:\n\t1.\tClaw Machine Simulator: Operate the claw machine, and feel every movement of the claw.\n\t2.\tUnique Match-3 Experience: Combine claw machine gameplay with match-3 elements for a new elimination challenge.\n\t3.\tFun Creative Levels: Each level is uniquely designed to enhance the claw machine fun, providing a rich gaming experience.\n\t4.\tHundreds of Fun Objects: From cute plush toys to creative items, see how many interesting objects you can grab.\n\t5.\tRealistic Physical Feedback: With a precise physics engine and controller vibrations, experience every detail of the claw machine action.\n\nCreative Levels:\n\t\u2022\tDolls: Grab various adorable animal plush toys and unlock more.\n\t\u2022\tYammy Sushi: Feel like you\u2019re in a conveyor belt sushi restaurant. Grab your favorite sushi.\n\t\u2022\tFruit World: Grab delicious fruits and complete match-3 tasks in a vibrant fruit world.\n\t\u2022\tMini Cars: Grab moving mini cars on a racetrack.\n\t\u2022\tCasino: Grab lucky coins in a casino-themed claw machine.\n\t\u2022\tAnimals vs Zombies: Protect your animal friends by fending off zombies while grabbing toys and solving match-3 puzzles.", "short_description": "Claw Match combines the authentic claw machine experience with match-3 gameplay, transporting you into a creative world of claw machines. In this game, you not only need to operate the claw machine with precision, but also use match-3 mechanics to continuously challenge tasks, offering a fresh strategy and exciting gameplay!\n"}]}, "developer_name": "Gulita Studio", "developer_privacy_policy_url": "https://www.gulita.net/ClawMatch/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Gulita Stuido", "support_website_url": null, "website_url": "https://www.gulita.net/ClawMatch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9730649656966203"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1442860897189779"}, {"status": "PUBLISHED", "id": "25813471324978746"}, {"status": "PUBLISHED", "id": "2288849171589422"}, {"status": "PUBLISHED", "id": "26067696982820660"}, {"status": "PUBLISHED", "id": "1986197815480652"}, {"status": "PUBLISHED", "id": "1464959401295452"}, {"status": "PUBLISHED", "id": "1209921
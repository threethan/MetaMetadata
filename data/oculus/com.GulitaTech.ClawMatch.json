_F-7Z0Ys&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu57kQbdpMfQp9uL3-LAHx8VOoBNanXKx9BHX3StTSuRg&oe=699DAFA9"}, {"file_name": "secreenshopt4.png", "id": "1142124994049014", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393450_1142124997382347_1053989313703959917_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AoYgZIZ1DSMQ7kNvwGG-h_A&_nc_oc=AdnNsCUdVheTh7KvChbPI4GTBuyuurN8cBRxsVPss11VRpSEap92m5TOFBcSI-cEX8w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsK8hbYe5aJAVwPfQLZkGRap5YZp0sD9Z9C5UfbO8uanw&oe=699D8651"}, {"file_name": "secreenshopt6.png", "id": "633131099170368", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391932_633131102503701_7992954763248169413_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOPZIK1wPb4Q7kNvwFFLVU_&_nc_oc=AdnnAvOzCPqZGT5SQUIhBTL6nWsd5KN4x-q4KuC6pSPTGg-dG8z_M2ahfDK-YlnNVP4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft6qPue5Ks9bmc6CnWAIrSW-G0G-P7QkrJH17qZmMINSQ&oe=699D8BEE"}, {"file_name": "secreenshopt3.png", "id": "1872246483522769", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819961_1872246486856102_6494395123104062285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uu5ibO6rLAUQ7kNvwEIQhBH&_nc_oc=Adk2UT55j1AffyLFwTiTSVJQs6YvxI_FpVg2hQ5rqiHR9N-9_lODux9ZMCHSihastfY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftIPFbqm77Rdj1VTanps9WbKwFs3ns5WFsqM0qB9P1TJQ&oe=699DA790"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ClawMatchTralier_2560x1440-\u5c01\u9762.png", "id": "1864746831044218", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393444_1864746837710884_6542806525797600865_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ciSIrJtD4sQ7kNvwFhkPdl&_nc_oc=Adn8jk9VYgvvwseRlwE0Uy4Qx-I3N7bvKmv5pNvQ9E37QkfTn6sTC3YifOIb-yUYiUY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsPCo6NsOnczqwOibpvDpbFgCD5Q3Ma0DqUVMeKkg1GOQ&oe=699DA71D"}, "display_name": "Claw Match", "keywords": ["ClawMachine", "Simulator", "3Match", "Claw", "Arcade"], "long_description": "Claw Match combines the authentic claw machine experience with match-3 gameplay, taking you into a creative world of claw machines. In this game, you\u2019ll operate the claw machine with precision while using match-3 mechanics to tackle tasks, offering a fresh strategy and exciting gameplay!\n\nGame Features:\n\n\t1.\tClaw Machine Simulator: Operate the claw machine, and feel every movement of the claw.\n{1834277427325409}\n\t2.\tUnique Match-3 Experience: Combine claw machine gameplay with match-3 elements for a new elimination challenge.\n{665481632537449}\n\t3.\tFun Creative Levels: Each level is uniquely designed to enhance the claw machine fun, providing a rich gaming experience.\n{2166243717166315}\n\t4.\tHundreds of Fun Objects: From cute plush toys to creative items, see how many interesting objects you can grab.\n{579768198411871}\n\t5.\tRealistic Physical Feedback: With a precise physics engine and controller vibrations, experience every detail of the claw machine action.\n\nCreative Levels:\n\n\t\u2022\tDolls: Grab various adorable animal plush toys and unlock more.\n\t\u2022\tYammy Sushi: Feel like you\u2019re in a conveyor belt sushi restaurant. Grab your favorite sushi.\n\t\u2022\tFruit World: Grab delicious fruits and complete match-3 tasks in a vibrant fruit world.\n\t\u2022\tMini Cars: Grab moving mini cars on a racetrack.\n\t\u2022\tCasino: Grab lucky coins in a casino-themed claw machine.\n\t\u2022\tAnimals vs Zombies: Protect your animal friends by fending off zombies while grabbing toys and solving match-3 puzzles.\n", "short_description": "Claw Match combines the authentic claw machine experience with match-3 gameplay, transporting you into a creative world of claw machines. In this game, you not only need to operate the claw machine with precision, but also use match-3 mechanics to continuously challenge tasks, offering a fresh strategy and exciting gameplay !\n"}]}, "developer_name": "Gulita Studio", "d
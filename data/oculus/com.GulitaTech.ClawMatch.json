3444_9607070015983373_6225641983139563788_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9R82ISEy-n0Q7kNvwG5BCD0&_nc_oc=Ado3qgstQb9MeSgg-4jRWw0nXKNh3JFovjyZJ5VYf8uGOzGwlMwOASK-P04aiXYYZK4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aZNSgbLde10KdX9-7M5sriugLtXSPE_7LRlrA_Me5BA&oe=6A2C063E"}, {"file_name": "secreenshopt2.png", "id": "1854521975368671", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392309_1854521978702004_8380765414074328213_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JJxtn1hfTkQ7kNvwFkDYX_&_nc_oc=AdoDwliU-7Vf66V4q4V-QPs4ducylvc8HbvHzNFSNzkboVu1csonIw9AGZzfokcgPZw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_gV6nMoY5S4NWzvmQbCHv7j_v3S3RDZz5er0WvQG7tA&oe=6A2C11A9"}, {"file_name": "secreenshopt4.png", "id": "1142124994049014", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473393450_1142124997382347_1053989313703959917_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUNkPGrrFNIQ7kNvwGpg-xw&_nc_oc=AdoegFh0P6aK2pGNm9Cfm-oshZ794a2EOge3uXvGmznTm826j4NFHvhGyM-IuoxdDng&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QBnKIwr66wYsxqUIAqWp4-CxUnMNlhD_3wepYMlWF9A&oe=6A2C2091"}, {"file_name": "secreenshopt6.png", "id": "633131099170368", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391932_633131102503701_7992954763248169413_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWvD3YXTOGkQ7kNvwHTSclo&_nc_oc=AdqrXCvHlYqgaTwVpGpRUMGZ-kRrRJskswPsrvnsdLXOW1XsSQ0futjfDDudQ247PUg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_D8wexRZwuW09SGKlQkk9HMbiICQGslGUDx8lFJEmXDA&oe=6A2C262E"}, {"file_name": "secreenshopt5.png", "id": "899734022083190", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392309_899734025416523_7639174057275116205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbX2auTs5PsQ7kNvwHM-g5H&_nc_oc=Adp9bq5Jbo4M3y9I-lAEEWSlDTUdRUWziJ9jTIVa9tAnTopTdrg0MPYCqbmez2BmRoQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KXiadyXDirpZSZgE9v9sk4ij554WPZSea7iHwIR2Q-Q&oe=6A2C143B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ClawMatchTralier_2560x1440-\u5c01\u9762.png", "id": "1864746831044218", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393444_1864746837710884_6542806525797600865_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XfXJ7x-0m8Q7kNvwF8EmWz&_nc_oc=AdqihjoMx7Jt35Sgeot55QmWzcUbJ1vdANy1gE22frsNFVvedoi8ueFezztHSzHz4jQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8y4dvzJtjzBTfivTCqx-yYwiyH3IjJkFub3m2EpAK_Pw&oe=6A2C091D"}, "display_name": "Claw Match", "keywords": ["ClawMachine", "Simulator", "3Match", "Puzzle", "ClawMachineSimulator"], "long_description": "Claw Match combines the authentic claw machine experience with match-3 gameplay, taking you into a creative world of claw machines. In this game, you\u2019ll operate the claw machine with precision while using match-3 mechanics to tackle tasks, offering a fresh strategy and exciting gameplay!\n\nGame Features:\n\t1.\tClaw Machine Simulator: Operate the claw machine, and feel every movement of the claw.\n\t2.\tUnique Match-3 Experience: Combine claw machine gameplay with match-3 elements for a new elimination challenge.\n\t3.\tFun Creative Levels: Each level is uniquely designed to enhance the claw machine fun, providing a rich gaming experience.\n\t4.\tHundreds of Fun Objects: From cute plush toys to creative items, see how many interesting objects you can grab.\n\t5.\tRealistic Physical Feedback: With a precise physics engine and controller vibrations, experience every detail of the claw machine action.\n\nCreative Levels:\n\t\u2022\tDolls: Grab various adorable animal plush toys and unlock more.\n\t\u2022\tYammy Sushi: Feel like you\u2019re in a conveyor belt sushi restaurant. Grab your favorite sushi.\n\t\u2022\tFruit World: Grab delicious fruits and complete match-3 tasks in a vibrant fruit world.\n\t\u2022\tMini Cars: Grab moving mini cars on a racetrack.\n\t\u2022\tCasino: Grab lucky coins in a casino-themed claw machine.\n\t\u2022\tAnimals vs Zombies: Protect your animal friends by fending off zombies while grabbing toys and solving match-3 puzzles.", "short_description": "Claw Match combines the authentic claw machine experience with match-3 gameplay, transporting you into a creative world of claw machines. In this game, you not only need to operate the claw machine with precision, but also use match-3 mechanics to continuously challenge tasks, offering a fresh strategy and exciting gameplay!\n"}]}, "developer_name": "Gulita Studio", "developer_privacy_policy_url": "https://www.gulita.net/ClawMatch/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Gulita Stuido", "support_website_url": null, "website_url": "https://www.gulita.net/ClawMatch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9730649656966203"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "968934882452453"}, {"status": "PUBLISHED", "id": "1442860897189779"}, {"status": "PUBLISHED", "id": "25813471324978746"}, {"status": "PUBLISHED", "id": "2288849171589422"}, {"status": "PUBLISHED", "id": "26067696982820660"}, {"status": "PUBLISHED", "id": "1986197815480652"}, {"status": "PUBLISHED", "id": "14649594
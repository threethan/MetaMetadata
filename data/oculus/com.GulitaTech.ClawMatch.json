3444_9607070015983373_6225641983139563788_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6zgZFBKWoAQ7kNvwGv48tq&_nc_oc=AdrWJWjAnAnOX_lj9-E7IdVL-XZGB-Zj5414TMLYmGlaNxY11S304rI-Z8SmG0Reclk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuwMqvSPbAnjsIgbkDNYJv_K8YVqjSHYeXTLXu6e_CoA&oe=6A884F3E"}, {"file_name": "secreenshopt2.png", "id": "1854521975368671", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392309_1854521978702004_8380765414074328213_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkE86vQn1sQQ7kNvwFY1FDh&_nc_oc=AdpRuIQt_QFxmrkjJ-2MqB4bLUJM6yJwUoA6ME2Eqz5-_bqbD9rRQhIiZI32u1dwYd0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWy3qu5xCRbGxe03mf1Xc43_VDAJhK8u1HlG4oTDmwGw&oe=6A882269"}, {"file_name": "secreenshopt4.png", "id": "1142124994049014", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473393450_1142124997382347_1053989313703959917_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BDYNOj9nYoQ7kNvwFYdmJS&_nc_oc=AdoUsQtnIhyKhUpIf81_FKGzVhD4hxJ-VRNoq1emqReY5eSPFKw4eyXTaw2xrZaMoMI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaYJEALC8UNTcrFtl9AX1PtFqcn3tg4fuV8rB2ohnDdQ&oe=6A883151"}, {"file_name": "secreenshopt6.png", "id": "633131099170368", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391932_633131102503701_7992954763248169413_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uq2vhyE_UjoQ7kNvwHI0R-I&_nc_oc=Adp9bqfcT5qphSSdKob50MrJ5W7inwDfyB6Iw7Ii4Pe4Pn6sxNTVCiD6UwWrMlYtM_Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuZ0NshvOhjN_Qgq5iptGdN8O2WMSBuILp9ooZLTJj0Q&oe=6A8836EE"}, {"file_name": "secreenshopt5.png", "id": "899734022083190", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392309_899734025416523_7639174057275116205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTfIYq4wUvUQ7kNvwGEAEZW&_nc_oc=AdqmS0oHnag9JviJ4mXl2qouG62ckhFgJz2zq6t5f9rZDysLRdFKZ9s1LEpOCScncSM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkmV6bP-VqtA8LuVF6fNmtbnu_IKK1DX5r1CLUntozuw&oe=6A8824FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ClawMatchTralier_2560x1440-\u5c01\u9762.png", "id": "1864746831044218", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393444_1864746837710884_6542806525797600865_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9EPC9FAYBbkQ7kNvwFc-BlR&_nc_oc=AdoC929WwzXgkQNBAMGsdSwuTgv_Rx9h918uQx-zgjaA1FQt4pWA9x3eKJuC6YDYfT8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9bFg5nrI02PoYERIfh1DMuYlfYGxvn0B7tR8eBqyRsg&oe=6A88521D"}, "display_name": "Claw Match", "keywords": ["ClawMachine", "Simulator", "3Match", "Puzzle", "ClawMachineSimulator"], "long_description": "Claw Match combines the authentic claw machine experience with match-3 gameplay, taking you into a creative world of claw machines. In this game, you\u2019ll operate the claw machine with precision while using match-3 mechanics to tackle tasks, offering a fresh strategy and exciting gameplay!\n\nGame Features:\n\t1.\tClaw Machine Simulator: Operate the claw machine, and feel every movement of the claw.\n\t2.\tUnique Match-3 Experience: Combine claw machine gameplay with match-3 elements for a new elimination challenge.\n\t3.\tFun Creative Levels: Each level is uniquely designed to enhance the claw machine fun, providing a rich gaming experience.\n\t4.\tHundreds of Fun Objects: From cute plush toys to creative items, see how many interesting objects you can grab.\n\t5.\tRealistic Physical Feedback: With a precise physics engine and controller vibrations, experience every detail of the claw machine action.\n\nCreative Levels:\n\t\u2022\tDolls: Grab various adorable animal plush toys and unlock more.\n\t\u2022\tYammy Sushi: Feel like you\u2019re in a conveyor belt sushi restaurant. Grab your favorite sushi.\n\t\u2022\tFruit World: Grab delicious fruits and complete match-3 tasks in a vibrant fruit world.\n\t\u2022\tMini Cars: Grab moving mini cars on a racetrack.\n\t\u2022\tCasino: Grab lucky coins in a casino-themed claw machine.\n\t\u2022\tAnimals vs Zombies: Protect your animal friends by fending off zombies while grabbing toys and solving match-3 puzzles.", "short_description": "Claw Match combines the authentic claw machine experience with match-3 gameplay, transporting you into a creative world of claw machines. In this game, you not only need to operate the claw machine with precision, but also use match-3 mechanics to continuously challenge tasks, offering a fresh strategy and exciting gameplay!\n"}]}, "developer_name": "Gulita Studio", "developer_privacy_policy_url": "https://www.gulita.net/ClawMatch/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Gulita Stuido", "support_website_url": null, "website_url": "https://www.gulita.net/ClawMatch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9730649656966203"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "2565608753894185"}, {"status": "PUBLISHED", "id": "2420684895120791"}, {"status": "PUBLISHED", "id": "968934882452453"}, {"status": "PUBLISHED", "id": "1442860897189779"}, {"status": "PUBLISHED", "id": "25813471324978746"}, {"status": "PUBLISHED", "id": "2288849171589422"}, {"status": "PUBLISHED", "id": "260676969
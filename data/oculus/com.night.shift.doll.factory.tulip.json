HzO7RI8agC4BhhQe38&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SfQLTE68yRCv1yjXZlTR5TH1acQjKaYcQopTNFuWO0g&oe=6A2172AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Night Shift: VR Doll Factory", "keywords": ["DollFactory", "horrorgames", "haunteddoll", "hauntedfactory", "jumpscares"], "long_description": "You are the night shift quality control inspector inside an old doll manufacturing plant.\n\nYour job is simple: inspect the dolls, approve production, and finish your shift.\n\nBut something isn\u2019t right.\n\nDolls appear where you didn\u2019t leave them.\nMachinery activates on its own.\nFootsteps echo through empty corridors.\n\nIn this immersive VR horror role-playing experience, you must complete your shift while a series of disturbing events unfold around you. The factory feels alive \u2014 and it\u2019s watching.\n\nExplore dark assembly lines, storage rooms filled with rejected dolls, and silent inspection stations as tension builds hour by hour.\n\nFeatures:\n\nFirst-person VR horror experience\n\nStory-driven night shift role play\n\nAtmospheric doll factory setting\n\n360\u00b0 spatial audio immersion\n\nDesigned for Meta Quest\n\nCan you finish your shift\u2026 or become part of the factory?", "short_description": "Work the night shift in a haunted doll factory. Explore, survive, and endure a terrifying VR horror role-playing experience."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-games-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "h
": "1228847445984791", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822327_1228847452651457_3035719420603906662_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXtdFSXz_YgQ7kNvwEz9_R5&_nc_oc=AdrtmNvydIGNA55QdBCUih74lz7PqIrLMmlndGCc2ERKEVrsTepLvpw42IYI9uwMH-c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzwzb6LrHSa7ETz5rcS25B8sDHflW6ohXXIDvKsBDGMdQ&oe=69C7D17A"}, {"file_name": "3.png", "id": "1593286535294515", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491820141_1593286538627848_1943756907788894491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmW0ALcVGhAQ7kNvwE_A1Dl&_nc_oc=AdoRjLIJZAEWMCYkaCuR4B7_Lyo_BOjiQRdh_C8_j5PaGFUc2pUoKPfds6kAInXisuI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwgDxaWQ-71PdFPm64VbzMgm_wOAWEZIvf3z4FOlpr8uA&oe=69C7B5C9"}, {"file_name": "2.png", "id": "2301181420390947", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491818860_2301181423724280_19240416030980663_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAQKGHE-bBsQ7kNvwFEtCCd&_nc_oc=AdpUQdQe31cBtDPbNFz8KL2WuR-6BIndTS5VaIHIrnwSqknlOkK74yxhNiSK32wkelQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJovSlZ2bhD6t2gL2CeOj0ahrA4_URQJtckGnfWyzqdw&oe=69C7CCAE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Night Shift: VR Doll Factory", "keywords": ["DollFactory", "horrorgames", "haunteddoll", "hauntedfactory", "jumpscares"], "long_description": "You are the night shift quality control inspector inside an old doll manufacturing plant.\n\nYour job is simple: inspect the dolls, approve production, and finish your shift.\n\nBut something isn\u2019t right.\n\nDolls appear where you didn\u2019t leave them.\nMachinery activates on its own.\nFootsteps echo through empty corridors.\n\nIn this immersive VR horror role-playing experience, you must complete your shift while a series of disturbing events unfold around you. The factory feels alive \u2014 and it\u2019s watching.\n\nExplore dark assembly lines, storage rooms filled with rejected dolls, and silent inspection stations as tension builds hour by hour.\n\nFeatures:\n\nFirst-person VR horror experience\n\nStory-driven night shift role play\n\nAtmospheric doll factory setting\n\n360\u00b0 spatial audio immersion\n\nDesigned for Meta Quest\n\nCan you finish your shift\u2026 or become part of the factory?", "short_description": "Work the night shift in a haunted doll factory. Explore, survive, and endure a terrifying VR horror role-playing experience."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-games-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25314584831549943"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823351_849687841425325_5084537461986957557_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BegfNsNKGscQ7kNvwGRtRZW&_nc_oc=Ado9cEG76mF33GR9OO91CPkgyuUPgis_ewYIjpJp6Z1qD0LzfzbEIp4rM0ISI4u1tFs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3Kkidq5F9hd9gwgvpOXCl46kvCosuxpd2BxXcnaoDLQ&oe=69C7DBC4"}, "is_concept"
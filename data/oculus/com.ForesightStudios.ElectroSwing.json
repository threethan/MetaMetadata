gZcl-Sy4DXFhcTcfg&oe=69A596B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ES_CoverArt_Landscape_2560x1440.png", "id": "1197691440807802", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974444_1197691444141135_5463456547020767106_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAcr2DBzrGMQ7kNvwFrkB5B&_nc_oc=Admm5wnxbKvytPg291hG0Su_h3oR70G1ijUGbUKH2xBLSnWKWwBUuWlyZCcRZ4_XplI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvaWkcuZYr8rl3xLLSjFQgGpTZoB73kZNldDcLuiVxfKg&oe=69A58FE6"}, "display_name": "Electro Swing", "keywords": [], "long_description": "Electro Swing is all about swinging around obstacles while listening to great music. The goal is to reach the end before the time runs out, and without touching anything! If you're successful you will unlock the ability to discover countless randomly generated worlds. Once you find one you love, you can share the seed with your friends so they can try it too. So put on your dancing shoes and get ready for some Electro Swing!", "short_description": "Electro Swing is all about swinging around obstacles while listening to great music. The goal is to reach the end before the time runs out, and without touching anything! If you're successful you will unlock the ability to discover countless randomly generated worlds. Once you find one you love, you can share the seed with your friends so they can try it too. So put on your dancing shoes and get ready for some Electro Swing!"}]}, "developer_name": "Foresight Studios", "developer_privacy_policy_url": "https://electroswingvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foresight Studios LLC", "support_website_url": "https://electroswingvr.com/electroswing-visual-evidence/", "website_url": "https://electroswingvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890
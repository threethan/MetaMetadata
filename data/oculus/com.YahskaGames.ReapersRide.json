1473837960240601", "locale": "en_US", "screenshots": [{"file_name": "Neon sign (3).png", "id": "551246060850317", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974891_551246064183650_9093418766068755336_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vlglkx57N2wQ7kNvwFX7zCB&_nc_oc=AdrO59bMxO9U6CP7QJqdjim98-062UrJ2jBOeD1xiH7BuKGjjHExJT6r1ZChRvqNYdY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKt5pAHXan73GAda2VUdFkSMoiivIuJr0UM2tr6EHC9IQ&oe=6AAFE32F"}, {"file_name": "Neon sign (4).png", "id": "1112548833035867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031519_1112548836369200_5249921365248892347_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stg5B2ox9-IQ7kNvwEpuTmz&_nc_oc=Adq3E_iJ7gE3ur5AmpYfPE_3jty2Fc8rmWY1Eq1sv3dUhHLxa_5w23gETpLCWTjnpsM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_IDpODk90De8tXlujkXMnxhCKKtjdY_vE6NFkxhbaKQ&oe=6AAFD068"}, {"file_name": "Neon sign (5).png", "id": "437948162409222", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982621_437948165742555_6822964733496865097_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mpEGqVMzG48Q7kNvwEbOniM&_nc_oc=AdpYIzOdfFa22-92-mgM_6GncYtcoJWuskPbYMILzOy9878068D7J72AoBJ5EN2ut0c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjJS-vTpbaGyKc8fiIi2H9fzBKB3EPuBfIVBqs0wexuA&oe=6AAFE60A"}, {"file_name": "Neon sign (6).png", "id": "908699901396656", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404379_908699908063322_4519236368963469234_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZWzo8Bc9MYQ7kNvwG92z2I&_nc_oc=Adp-DzZFMNo6FkwVr2c0VFJ0CThBZc3jtNLWlUDT6AaJR5S3bGYF44rSIOGC-31B3DE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaxSJAwCH0pPFlASdF_RRxMvlCgOEOLQ1n-bguwvdvEA&oe=6AAFE973"}, {"file_name": "Neon sign (7).png", "id": "1622832895306210", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031656_1622832898639543_3934041203060442529_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRg1tS0GOAsQ7kNvwHSsgpl&_nc_oc=AdoC1anowgVdt0kXiPc6yGRnuLQh6eiAVTyzFJg_m-aMbb-d_1he22C-Z-dqTTNNmbk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFqEO9KynpAe1_cbSWICN-lBhku9_py5gr4vo213pySQ&oe=6AAFDF10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Neon sign (2).png", "id": "568703178901316", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974771_568703182234649_3727822265601933526_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjgtOgLxP1QQ7kNvwF6Xaxw&_nc_oc=AdqyeZjYnWVJjVpiscJ8eh46njBSrlGgAkxgBMd1-oJEXJrXthpPwcXqas2mxLu0kC8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEzIUKHT0zHlXwgh_ih-2xG69DRXt14MwnLaqUkR1g8A&oe=6AAFD5C4"}, "display_name": "Reaper's Ride", "keywords": ["motorcycle", "shooting", "Bike", "Gang"], "long_description": "In Reaper\u2019s Ride, you step into the world of an outlaw who\u2019s ready to bring his life of crime to a close in a blaze of glory. Haunted by his past and determined to make a difference, he embarks on one final ride, armed and relentless, to take down the vicious gangs that once considered him one of their own.\n\nFeel the immersive power of VR as you mount an iron-clad beast of a motorcycle, gripping the handlebars to steer through treacherous terrain and deadly ambushes. As you weave between showdowns and high-speed chases, draw your twin pistols to take out wave after wave of ruthless enemies. Precision, speed, and grit are your only allies as you push through.\n\nWith every mile conquered and every gang member taken down, you inch closer to redemption. Reaper\u2019s Ride is a fast-paced, gritty VR shooter that demands skill, courage, and a thirst for justice in a world where the only way out is through.", "short_description": "In Reaper\u2019s Ride, you are the outlaw who\u2019s had enough. On one final, high-speed journey, you\u2019re set to bring down the brutal gangs that once called you their own. Take control of your roaring bike, gripping the handlebars as you tear through hostile landscapes, guns blazing in both hands. With the wind at your back and vengeance in your heart, it\u2019s you against the outlaws in a fight to the finish. One last ride. One final reckoning. This is Reaper\u2019s Ride.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Akshay-Alex/ReapersRidePrivacyPolicy/blob/main/PrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "YahskaGames", "support_website_url": null, "website_url": "https://akshayalex.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8759468784170461"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "3951423425134987"}, {"status": "PUBLISHED", "id": "919829996269918"}]}, "baseline_offer": {"id": "3951423425134987"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736497980, "status": "PUBLISHED", "id": "3951423425134987"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8943455202438484", "version": "0.1.0"}, "id": "2052617221838813", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "Andr
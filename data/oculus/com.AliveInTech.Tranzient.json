dn.com&_nc_ss=7f20f&oh=00_Af2wgQpA_dCCSpRQrIlZ_e7eQ7Sl5pxk_oe4hk_8TbhfRQ&oe=69F362F9"}, {"file_name": "VideoWall_1.18.1.png", "id": "961945845417678", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974845_961945852084344_6533138472087779742_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEFInzyeUfoQ7kNvwGLTdXW&_nc_oc=AdqnbY_HoDSYT088xT3tfrI1zedXZbvB3UTccxpuj7R17e7cx106X9DfmbRFexzyVfI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2MhI1i2IIxmc1QWi6wi6UbSC8FRPnq4VD3UUcAcOwldQ&oe=69F374E5"}, {"file_name": "stepseq2_1.22.2.png", "id": "250093507859189", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982503_250093511192522_4388969349790307505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JI3wmZudhBgQ7kNvwFkire7&_nc_oc=AdrSlEImjvTBWNoQO2thnFc-0TJAaLP6G3_8yOE_KvT1DR2CzcS9-7fG4SH1dv3hAAU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af01iOb-vjd7s8gFWD08eKJXidPvtDNQdOORuPIsiM3hrQ&oe=69F36848"}, {"file_name": "Session_1.23.1.png", "id": "795767698985101", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001732_795767702318434_262560137887527662_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTSq8upyZuQQ7kNvwHnP0c9&_nc_oc=AdpM7Rr807SZIeyQ65nXGyM2yXhJoaVMur2ikUrTlYPV4CvM-pX0RQYVQbOOHatE6BI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1cPAv9VMLkL-NGwXg23C3gvlH5Kkcv3yia26oNypsLBw&oe=69F3467A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tranzfirstframe.png", "id": "381471740929152", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036702_381471744262485_3617820370637424030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDJ0KpjnnfMQ7kNvwGLoBNn&_nc_oc=AdoAF6QRw0KcPU5b81kB3vUSFC9Z4WSg2CWYv9anIwL6du0-EKOV2eyd_UV-Wj4ObJs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3nzk_h5IEVod-xGooWaJ6i7WkCyIFBqt2QR62ZvTwINA&oe=69F3618E"}, "display_name": "Tranzient", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Full support for hand tracking and mixed reality/passthrough \n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.\n\n\nIn the full version you get:\n- Built in 1.5 Gb library of loops and sounds\n- Use any number of synths (up to what the system can handle)\n- Use your own video and loops/samples\n- Export mixes of your performance\n- Lots more built in videos, VFX, Avatars and worlds.", "short_description": "The full version of Tranzient!\n\nMake beats in VR. Full live looping music production and sequencing environment in VR including visuals. \n\nThis is not a rhythm game.\n\nWho made the beats? You did!\n\nIn the full version you get:\n- Built in 1.5 Gb library of loops and sounds\n- Use any number of synths (up to what the system can handle)\n- Use your own video and loops/samples\n- Export mixes of your performance\n- Lots more built in videos, VFX, Avatars and worlds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website
dn.com&_nc_ss=7f20f&oh=00_Af0iN5k2gcz8JesHFaaye2dJr8pE0MwkYjOqQr-HrNQ3dA&oe=69F605F9"}, {"file_name": "VideoWall_1.18.1.png", "id": "961945845417678", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974845_961945852084344_6533138472087779742_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRf7goMnL44Q7kNvwGgstde&_nc_oc=Adrlgzzf3uiLGI72UTK7ARP9CThHV52Rn3K5oRiDnvsu6YncHZI0jN6nCLLXhYjEP9w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1JxDbsG-l0P2gcRP0z0NVEMv3g19l1IjOx3YyrHtnt2A&oe=69F617E5"}, {"file_name": "stepseq2_1.22.2.png", "id": "250093507859189", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982503_250093511192522_4388969349790307505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BRhLSM5xiUQ7kNvwHoHs4N&_nc_oc=AdofAPdFYP0W4p1WsMggLSVId83k_aHYxrVrbzrG5-9abaEpHmRVrBjXl6989Yd5OEo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3wSAJIKxNu-JO0b8v2JitA18onCFMySfS55u1lioijrA&oe=69F60B48"}, {"file_name": "Session_1.23.1.png", "id": "795767698985101", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001732_795767702318434_262560137887527662_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTSq8upyZuQQ7kNvwHBEM08&_nc_oc=Adqf2dZM2TmVldxaHryNsZcCslR2295vQilYinD9aAulOFpqNQV3kns4o7vNjRis-WY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2X0DQ1oC55XDiwCoESENtnTLxiK-XibnBGOzaGF0EHJQ&oe=69F5E97A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tranzfirstframe.png", "id": "381471740929152", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036702_381471744262485_3617820370637424030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDJ0KpjnnfMQ7kNvwHbf2bR&_nc_oc=Adr4hvugfnphTkesHaCQ2XLANS9dJjPylikoa61-H3jdrwCOonSBRJxD0Hf1nbliMco&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1i6E1VH2L4KTH07j5GWZWeRJuurfX1-anoD7ndgtLHZQ&oe=69F6048E"}, "display_name": "Tranzient", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Full support for hand tracking and mixed reality/passthrough \n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.\n\n\nIn the full version you get:\n- Built in 1.5 Gb library of loops and sounds\n- Use any number of synths (up to what the system can handle)\n- Use your own video and loops/samples\n- Export mixes of your performance\n- Lots more built in videos, VFX, Avatars and worlds.", "short_description": "The full version of Tranzient!\n\nMake beats in VR. Full live looping music production and sequencing environment in VR including visuals. \n\nThis is not a rhythm game.\n\nWho made the beats? You did!\n\nIn the full version you get:\n- Built in 1.5 Gb library of loops and sounds\n- Use any number of synths (up to what the system can handle)\n- Use your own video and loops/samples\n- Export mixes of your performance\n- Lots more built in videos, VFX, Avatars and worlds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website
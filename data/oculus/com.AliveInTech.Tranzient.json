a&_nc_ohc=fIJfIMGgMwoQ7kNvwFlxKnF&_nc_oc=AdoutXv_h_u-ipCeGxZYt44k1-NCBHz5i5-VuK3OE8LnW2RAxHcm4z5lxVZxsSo6dig&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ28KD2AobQVGk_aymq1KU1JtIYTNMz25nv6gJhmcHCg&oe=6B05D339"}, {"file_name": "VideoWall_1.18.1.png", "id": "961945845417678", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974845_961945852084344_6533138472087779742_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNMlnkWf8jcQ7kNvwEbPLYJ&_nc_oc=AdqLpTcyCeY3_PqE5LH54TtwAHRmDWjvnoaMg2m6tF626T94ZS9BX3oftQRgl4Hxiio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT24zLezX4DhIraxVoC4jtDfZr1k65DD9-7nNYzw0O7lg&oe=6B05ACE5"}, {"file_name": "stepseq2_1.22.2.png", "id": "250093507859189", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982503_250093511192522_4388969349790307505_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m64ls03WT_cQ7kNvwENQqUK&_nc_oc=AdpQmbkj07zzRZVtljjdSkxAtETo9GCwlLSBNRbjZCefAuDI-Sx-JTNPLAde9buMoUQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSRye_OwRIlNHfQLmKF9poDum-uyChSjnenifd8AAYbg&oe=6B05D888"}, {"file_name": "Session_1.23.1.png", "id": "795767698985101", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_795767702318434_262560137887527662_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhBGvM4sizYQ7kNvwHNT3j-&_nc_oc=AdrClOz5ew5somMwDWKOtWYe1IQ5C5Xa-0L9mdtKpcouZzt6In-iqTWmWJS6C3wQfRY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSHe1m3SVqiJ1cQPSbCt_y96IxDJ7zgmKVNN8obLDL2Q&oe=6B05B6BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tranzfirstframe.png", "id": "381471740929152", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036702_381471744262485_3617820370637424030_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdZOwqhk26UQ7kNvwFcK5Mr&_nc_oc=Adq3dw_x--LP2jFSuj07PbwOhTMImr4tWO8-BayGT9p2XgzI6PPhHomDoWRAM8SCoM8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCxC_0c2SGCWJhOI50GPpGiw6AHlVzRRcXcVSDHXwHlQ&oe=6B05D1CE"}, "display_name": "Tranzient", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Full support for hand tracking and mixed reality/passthrough \n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.\n\n\nIn the full version you get:\n- Built in 1.5 Gb library of loops and sounds\n- Use any number of synths (up to what the system can handle)\n- Use your own video and loops/samples\n- Export mixes of your performance\n- Lots more built in videos, VFX, Avatars and worlds.", "short_description": "The full version of Tranzient!\n\nMake beats in VR. Full live looping music production and sequencing environment in VR including visuals. \n\nThis is not a rhythm game.\n\nWho made the beats? You did!\n\nIn the full version you get:\n- Built in 1.5 Gb library of loops and sounds\n- Use any number of synths (up to what the system can handle)\n- Use your own video and loops/samples\n- Export mixes of your performance\n- Lots more built in videos, VFX, Avatars and worlds."}]}, "developer_name": null, "dev
5771-25/57570305_1065224481178029_8720371277841218127_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OygZRCxot0Q7kNvwEYZYCj&_nc_oc=AdqQNWlDpGqjqZSmkHHtptZbisbMQR2Mw5ouaDuMCJnBtxHu1fiKy9A1wVBbjIfqtNk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JbUwMg9N4bfxUYPLjV5u4DBt3O2nbO7gvAIaCPRvLHA&oe=6A1C550A"}, {"file_name": "stepseq2_1.22.2.png", "id": "250093507859189", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982503_250093511192522_4388969349790307505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ic8Ppjxi5AQ7kNvwE7ieNE&_nc_oc=Adrg_Gd9MAUKNhmH3Q2YwF-ln7LZGCEokiK-ukXDkvDHMTMin8ACIXeVyzf003eZFNE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eP3fVbfwB6WANemyq2EIdVLBgvDt3to-VwFIeIOhprA&oe=6A1C46C8"}, {"file_name": "Session_1.23.1.png", "id": "795767698985101", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001732_795767702318434_262560137887527662_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9nSm-mlXA4Q7kNvwE4T-fz&_nc_oc=AdqRIQsmKjacXxfjrYuQAgS5DULH_DvmcClfjf-Pg6EtfhOM9p6WGtJKAjF9TfGozQk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6paUcS4R2W9G8AljDoTTBTQLbqZVzF8nbLgSThu_ZMWg&oe=6A1C5D3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewHeroSnowOculusVideoThumb.png", "id": "356731030443805", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982724_356731033777138_5182502195578425480_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDKKBW59FtkQ7kNvwEqOjrt&_nc_oc=AdqbH9vyRk1zLJNbP4b0d6zYOFgQq5313-9Vyd9qz-WuvYKfcCKYvMe5dLmjgl7pPsU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sUYwEFqMCVEiT2l1v_43uGOI_vq4Srlb3VfiVWKT9lA&oe=6A1C59C6"}, "display_name": "Tranzient", "keywords": ["Music", "DJ", "Beats", "Concert", "DAW"], "long_description": "#Create Music Like Never Before in VR/MR\n\nStep into a revolutionary music-making experience in virtual and mixed reality.\n\n- **Seamless Immersion**: Full hand-tracking support and mixed reality passthrough bring your studio to life.\n- **Perfect Loops, Effortlessly**: Sync loops from a rich content library automatically time-stretched and pitch-shifted to match your song.\n- **Sing & Perform**: Record vocals with motion-captured avatar playback\u2014your virtual self, center stage.\n- **Be You**: Rock your custom Ready Player Me avatar.\n- **Beat It**: Explore a dynamic set of drum kits and one-shots.\n- **Mix Masterfully**: Use Decks to craft flawless transitions and seamless mixes.\n- **Sound Sculpting**: Apply pro-grade audio FX (reverb, chorus, and more) to individual clips or entire scenes.\n- **Automation Magic**: Loop-record automation for FX and synth parameters with precision.\n- **3D Control**: Assign and tweak FX and synth settings in a fully spatial environment.\n- **Visual Vibes**: Sync looping videos to the beat for a multisensory experience.\n- **Step It Up**: Trigger anything in your world with a step sequencer\u2014loop instruments, drum kits, and edit steps with swing quantization.\n- **Synth Powerhouse**: Built-in Analog and Wavetable synths with over 250 inspiring sounds.\n- **Binaural Bliss**: Craft immersive spatial mixes based on clip positioning.\n- **Capture the Moment**: Record In-game camera to showcase your creativity.\n- \"\"Your Gear, Your Way\"\": Plug in your USB MIDI keyboard or controller for ultimate control.", "short_description": "The full version of Tranzient!\n\nCreate Music Like Never Before in VR/MR\n\nStep into a revolutionary music-making experience in virtual and mixed reality.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://discord.com/invite/mg6ZJHx", "website_url": "https://aliveintech.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_ta
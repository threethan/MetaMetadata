a&_nc_ohc=Es701uKGTKYQ7kNvwFrHvA8&_nc_oc=AdpUksiLAUOEAMFqHjeEve9B-mg2Z6L0QKz4U8LphKkpWZxijhrdILM-wayLg3W5IM8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTrvkoBa9gbGbjr008bXfZvx5urnXdMARvj6pmod_MMgg&oe=6B0C6AB9"}, {"file_name": "VideoWall_1.18.1.png", "id": "961945845417678", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974845_961945852084344_6533138472087779742_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Edcm7zoq_M4Q7kNvwH74Pfd&_nc_oc=Ado4Tvffg3u9fe508DrhSrvbqv9TiX9U4NT9Ax_KeIcNjUDv6nsj4d07CJg_2I6szUY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSmkD0kVrcDVxkIH16Dmxb21yul2FVjwa-V_Yu5IfTXtA&oe=6B0C7CA5"}, {"file_name": "stepseq2_1.22.2.png", "id": "250093507859189", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982503_250093511192522_4388969349790307505_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TtG4EVH174Q7kNvwEwkw0q&_nc_oc=AdrK5BLcJ2x-rHtTl4MVCXeXAiM4wn13xvVD2rsp2tSapQ3Az4zj-cIWtvXAmfdVBUA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRCXPSBwVpp_0q9zZJrao6G3GRmeNb7X8w89IlqNL46FA&oe=6B0C7008"}, {"file_name": "Session_1.23.1.png", "id": "795767698985101", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_795767702318434_262560137887527662_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dEOqT80GeAQ7kNvwEJ9kL7&_nc_oc=AdpOZLDYqrDfiF5RYrDXZo-9Njv-msGCHl6Ig33G6935G4tHEVZQRwtHktAlYc4ZPxg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSy382LnK2ls_CNVH0JkMZRrja9g9Y4utE7qgJ6Wj0cpQ&oe=6B0C4E3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tranzfirstframe.png", "id": "381471740929152", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036702_381471744262485_3617820370637424030_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znsN2jrU_J4Q7kNvwHPI2xB&_nc_oc=AdrH6SszO21V_HGQtIETR6O6zyhNTaf4E_0JRuZjrCPfp-Qd188VVj4CM2HomFpHg7g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTnEI6nuBWt8FonLizK2tJEUFP2IubYLY-IQxhQUZ5dRA&oe=6B0C694E"}, "display_name": "Tranzient", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Full support for hand tracking and mixed reality/passthrough \n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.\n\n\nIn the full version you get:\n- Built in 1.5 Gb library of loops and sounds\n- Use any number of synths (up to what the system can handle)\n- Use your own video and loops/samples\n- Export mixes of your performance\n- Lots more built in videos, VFX, Avatars and worlds.", "short_description": "The full version of Tranzient!\n\nMake beats in VR. Full live looping music production and sequencing environment in VR including visuals. \n\nThis is not a rhythm game.\n\nWho made the beats? You did!\n\nIn the full version you get:\n- Built in 1.5 Gb library of loops and sounds\n- Use any number of synths (up to what the system can handle)\n- Use your own video and loops/samples\n- Export mixes of your performance\n- Lots more built in videos, VFX, Avatars and worlds."}]}, "developer_name": null, "dev
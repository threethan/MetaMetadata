5771-25/57570305_1065224481178029_8720371277841218127_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbTlCdsgu-sQ7kNvwF7QQOR&_nc_oc=AdrGmTkl4DmzyFKUaXU_JGza_1nztWY6w4cDugYqL9JRfpccXNMtATeFI5weT8Y6KBE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nt8cu7OX9iguwtGzLyRtLy0eLwenu_n6MZwn1gi42OQ&oe=6A2D788A"}, {"file_name": "stepseq2_1.22.2.png", "id": "250093507859189", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982503_250093511192522_4388969349790307505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XA4q661CPAMQ7kNvwHipEaz&_nc_oc=AdpWZDi1VQWKq5OJZg_vnh28Ii_spW9PZNnNyY5Ftwcmex8hfs7wZgP-Aaha8FZhras&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XR3fpRpA-y43Hf9pyK4Ikhccp_VZ2PQyiSf6M5PY31g&oe=6A2D6A48"}, {"file_name": "Session_1.23.1.png", "id": "795767698985101", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001732_795767702318434_262560137887527662_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WqjtiJqZhIQ7kNvwHRuNfj&_nc_oc=AdqbwmB0tsE_eeAhDtVA83q1jM1z6iMbE7Wh94yGfR--KqEumrF0w2FpaDHSJLlpTJg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qUqo5TI52GFw0yTkepL16aYOL10JEauQ7keagFSKc-A&oe=6A2D487A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewHeroSnowOculusVideoThumb.png", "id": "356731030443805", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982724_356731033777138_5182502195578425480_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhcRg6qjINUQ7kNvwF5nqgF&_nc_oc=AdoGQk9i7txgYt6JVFCJrfXghFpNWpybxTt9vUn2FmrWiJBlvLFZIJEqKVCe7kfP33Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JRP_VOt3fxrdgpXcXPhl1JCA_EsD5PfaX9gcQ8X-VhA&oe=6A2D7D46"}, "display_name": "Tranzient", "keywords": ["Music", "DJ", "Beats", "Concert", "DAW"], "long_description": "#Create Music Like Never Before in VR/MR\n\nStep into a revolutionary music-making experience in virtual and mixed reality.\n\n- **Seamless Immersion**: Full hand-tracking support and mixed reality passthrough bring your studio to life.\n- **Perfect Loops, Effortlessly**: Sync loops from a rich content library automatically time-stretched and pitch-shifted to match your song.\n- **Sing & Perform**: Record vocals with motion-captured avatar playback\u2014your virtual self, center stage.\n- **Be You**: Rock your custom Ready Player Me avatar.\n- **Beat It**: Explore a dynamic set of drum kits and one-shots.\n- **Mix Masterfully**: Use Decks to craft flawless transitions and seamless mixes.\n- **Sound Sculpting**: Apply pro-grade audio FX (reverb, chorus, and more) to individual clips or entire scenes.\n- **Automation Magic**: Loop-record automation for FX and synth parameters with precision.\n- **3D Control**: Assign and tweak FX and synth settings in a fully spatial environment.\n- **Visual Vibes**: Sync looping videos to the beat for a multisensory experience.\n- **Step It Up**: Trigger anything in your world with a step sequencer\u2014loop instruments, drum kits, and edit steps with swing quantization.\n- **Synth Powerhouse**: Built-in Analog and Wavetable synths with over 250 inspiring sounds.\n- **Binaural Bliss**: Craft immersive spatial mixes based on clip positioning.\n- **Capture the Moment**: Record In-game camera to showcase your creativity.\n- \"\"Your Gear, Your Way\"\": Plug in your USB MIDI keyboard or controller for ultimate control.", "short_description": "The full version of Tranzient!\n\nCreate Music Like Never Before in VR/MR\n\nStep into a revolutionary music-making experience in virtual and mixed reality.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://discord.com/invite/mg6ZJHx", "website_url": "https://aliveintech.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_ta
_nc_ohc=3N_Wyrk_4xAQ7kNvwHnxMB5&_nc_oc=Adqmd9aA9YHNs7xtXCA-SdDFnoQSMxMYszlyJAlz5Xe7Kn-dXymvzEZ0bIb3f6hNJgk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MXVBi30DePys5-g5ABLDDFvD8GpB6u0d7RuPCsTWf2A&oe=6A467179"}, {"file_name": "VideoWall_1.18.1.png", "id": "961945845417678", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974845_961945852084344_6533138472087779742_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHiEKSwJ9ZQQ7kNvwGYeU9f&_nc_oc=Adrr2kPOuPUwR5UkvZXC-Vd5ZlFR62exy5yfwxG_hiyOZ7eut5mbsetlvxf0UcdAa3I&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FacH8chtgTgAbx0ZHK6K3qQk3QZwnHeoq2R110L56Pg&oe=6A468365"}, {"file_name": "stepseq2_1.22.2.png", "id": "250093507859189", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982503_250093511192522_4388969349790307505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIFfmm583GcQ7kNvwElHqZS&_nc_oc=AdqD1dgstLXcVasBuzHUky3HpFUQFmPtf7JkQ137Q-IFgGWonk1YREOtf5L389UuvGk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I8ywsP4oOmTl9z1R0tXW79Vofmv_-DUlk3KSpSH4lGg&oe=6A4676C8"}, {"file_name": "Session_1.23.1.png", "id": "795767698985101", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39001732_795767702318434_262560137887527662_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pi1gUdAzQj0Q7kNvwEM354D&_nc_oc=AdqRwn9k90VtDa0YLgyh2EN3bUFXgkLylA3FC-7MBq09OemRSeTvtzPJNAmGI8-UgkQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af934JReTStsdqUadD62hoWf7P_doykP82j-3yOUA-B34g&oe=6A468D3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tranzfirstframe.png", "id": "381471740929152", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39036702_381471744262485_3617820370637424030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INaNeQTNkVQQ7kNvwEiY7Gn&_nc_oc=AdqeBR_33Ux55EeAOT7c0r6jZFTq3gZUz4OdKlSloHbUWIqP9-E4lqou7_bOVKIaiX4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8F7f99fH0d7xeq0pRljDfoEbhR2FAtIjXf7Ds5hQ2uJA&oe=6A46700E"}, "display_name": "Tranzient", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Full support for hand tracking and mixed reality/passthrough \n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.\n\n\nIn the full version you get:\n- Built in 1.5 Gb library of loops and sounds\n- Use any number of synths (up to what the system can handle)\n- Use your own video and loops/samples\n- Export mixes of your performance\n- Lots more built in videos, VFX, Avatars and worlds.", "short_description": "The full version of Tranzient!\n\nMake beats in VR. Full live looping music production and sequencing environment in VR including visuals. \n\nThis is not a rhythm game.\n\nWho made the beats? You did!\n\nIn the full version you get:\n- Built in 1.5 Gb library of loops and sounds\n- Use any number of synths (up to what the system can handle)\n- Use your own video and loops/samples\n- Export mixes of your performance\n- Lots more built in videos, VFX, Avatars and worlds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_
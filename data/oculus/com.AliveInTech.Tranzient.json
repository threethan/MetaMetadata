_sid=6e7a0a&_nc_ohc=Jhw8YyMxGLEQ7kNvwHV_6mT&_nc_oc=AdrkEqnXI7JGzc0QEDXw84DPmGsUOkNCTsUdUQ1N72i-JRW_MSsCMZ1QS3MFQlNE_Qs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIirBQM91F364icS_LMaTYEjAc5vHwezwYQ1_lrunjJwQ&oe=6AAFEEC8"}, {"file_name": "Session_1.23.1.png", "id": "795767698985101", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001732_795767702318434_262560137887527662_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bC9oe0D1K6IQ7kNvwGdvEpn&_nc_oc=AdqYOyUlxzXQ0SOyNDKTKIn83tz5X-Fe0Yc3PfZS-Gg1G1T7HWHMQxFmhBg6ofjaVZU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpgRzg2qNAF1Z1iD6YMrcjsWCJ_LGMEt_sErrk4tgFpw&oe=6AB0053A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewHeroSnowOculusVideoThumb.png", "id": "356731030443805", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982724_356731033777138_5182502195578425480_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aks436CaKIAQ7kNvwGNGZA_&_nc_oc=AdqUx298OiUcmLdyXxS8CJnb-auifhLg0ZU-ImpAc1nqRybc4l3HqiksjbdmyqTX34Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkZcIBe-yScSml0RuzJ686yzw_ySqzFVYNQbwbVE5USg&oe=6AB001C6"}, "display_name": "Tranzient", "keywords": ["Music", "DJ", "Beats", "Concert", "DAW"], "long_description": "#Create Music Like Never Before in VR/MR\n\nStep into a revolutionary music-making experience in virtual and mixed reality.\n\n- **Seamless Immersion**: Full hand-tracking support and mixed reality passthrough bring your studio to life.\n- **Perfect Loops, Effortlessly**: Sync loops from a rich content library automatically time-stretched and pitch-shifted to match your song.\n- **Sing & Perform**: Record vocals with motion-captured avatar playback\u2014your virtual self, center stage.\n- **Be You**: Rock your custom Ready Player Me avatar.\n- **Beat It**: Explore a dynamic set of drum kits and one-shots.\n- **Mix Masterfully**: Use Decks to craft flawless transitions and seamless mixes.\n- **Sound Sculpting**: Apply pro-grade audio FX (reverb, chorus, and more) to individual clips or entire scenes.\n- **Automation Magic**: Loop-record automation for FX and synth parameters with precision.\n- **3D Control**: Assign and tweak FX and synth settings in a fully spatial environment.\n- **Visual Vibes**: Sync looping videos to the beat for a multisensory experience.\n- **Step It Up**: Trigger anything in your world with a step sequencer\u2014loop instruments, drum kits, and edit steps with swing quantization.\n- **Synth Powerhouse**: Built-in Analog and Wavetable synths with over 250 inspiring sounds.\n- **Binaural Bliss**: Craft immersive spatial mixes based on clip positioning.\n- **Capture the Moment**: Record In-game camera to showcase your creativity.\n- \"\"Your Gear, Your Way\"\": Plug in your USB MIDI keyboard or controller for ultimate control.", "short_description": "The full version of Tranzient!\n\nCreate Music Like Never Before in VR/MR\n\nStep into a revolutionary music-making experience in virtual and mixed reality.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://discord.com/invite/mg6ZJHx", "website_url": "https://aliveintech.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": 
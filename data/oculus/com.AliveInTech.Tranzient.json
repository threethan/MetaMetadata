6AFB228A"}, {"file_name": "stepseq2_1.22.2.png", "id": "250093507859189", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982503_250093511192522_4388969349790307505_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LajvQMNf34Q7kNvwH-rFJJ&_nc_oc=AdoTBeVlCtDJE4f3YY2PmZPB0smV6avqpO7lR4scbrEgKDsn8_HyYdK91pJfCPVfO00&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaK7V_NbhQztNXto_SHwTtD4nJWpxlT_iPAG0Cws99Bw&oe=6AFB4C88"}, {"file_name": "Session_1.23.1.png", "id": "795767698985101", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001732_795767702318434_262560137887527662_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTkiWD6eHFwQ7kNvwH3XAf2&_nc_oc=AdqywKrKTD92MZ_orDoSFOkECLyCFlk_Qw9VrSAoyIiH1duJOyUyBmp5weaabRKUsWw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBuWfz1OoSn0PViobrjp3AOHk7hU_M8Uqen3UoExTnKg&oe=6AFB2ABA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewHeroSnowOculusVideoThumb.png", "id": "356731030443805", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982724_356731033777138_5182502195578425480_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XS-Xp_yJLOMQ7kNvwEKuuLY&_nc_oc=AdpIHKolg5wgr2ZapwKIjcUas1QZxhl-us4oPpL7aPCyK29LuLkLxHRjTYBaNVq2IEc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQt8-CHjSFjXpGzAANOU0OI8dD1zYa_qQcqhmI6EKh7bA&oe=6AFB2746"}, "display_name": "Tranzient", "keywords": ["Music", "DJ", "Beats", "Concert", "DAW"], "long_description": "#Create Music Like Never Before in VR/MR\n\nStep into a revolutionary music-making experience in virtual and mixed reality.\n\n- **Seamless Immersion**: Full hand-tracking support and mixed reality passthrough bring your studio to life.\n- **Perfect Loops, Effortlessly**: Sync loops from a rich content library automatically time-stretched and pitch-shifted to match your song.\n- **Sing & Perform**: Record vocals with motion-captured avatar playback\u2014your virtual self, center stage.\n- **Be You**: Rock your custom Ready Player Me avatar.\n- **Beat It**: Explore a dynamic set of drum kits and one-shots.\n- **Mix Masterfully**: Use Decks to craft flawless transitions and seamless mixes.\n- **Sound Sculpting**: Apply pro-grade audio FX (reverb, chorus, and more) to individual clips or entire scenes.\n- **Automation Magic**: Loop-record automation for FX and synth parameters with precision.\n- **3D Control**: Assign and tweak FX and synth settings in a fully spatial environment.\n- **Visual Vibes**: Sync looping videos to the beat for a multisensory experience.\n- **Step It Up**: Trigger anything in your world with a step sequencer\u2014loop instruments, drum kits, and edit steps with swing quantization.\n- **Synth Powerhouse**: Built-in Analog and Wavetable synths with over 250 inspiring sounds.\n- **Binaural Bliss**: Craft immersive spatial mixes based on clip positioning.\n- **Capture the Moment**: Record In-game camera to showcase your creativity.\n- \"\"Your Gear, Your Way\"\": Plug in your USB MIDI keyboard or controller for ultimate control.", "short_description": "The full version of Tranzient!\n\nCreate Music Like Never Before in VR/MR\n\nStep into a revolutionary music-making experience in virtual and mixed reality.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://discord.com/invite/mg6ZJHx", "website_url": "https://aliveintech.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
7kNvwFHJyxv&_nc_oc=AdqtbOA80R7zsd9OgifNnYW3wfwKr4jiEJNVBm88SCmM0JF3s2A_ILhtCl3yxjeCANo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DJJQz4vL_uD0Xayq_P8nC7oQb7FA2CoxSL1gO5C4lYg&oe=6A3BE579"}, {"file_name": "VideoWall_1.18.1.png", "id": "961945845417678", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974845_961945852084344_6533138472087779742_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70ZyzmAGVCwQ7kNvwGuml87&_nc_oc=AdpcJFPp8PUvnBAsjFSu2O3RqIEqGY7M8l3YpR3c1Xd3gce7Zl5iV01aJ4AxuGomyuU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CfFfXAIp6_rpROY-SDNAFlPsnA698pOoi3CSRrnt3aQ&oe=6A3BF765"}, {"file_name": "stepseq2_1.22.2.png", "id": "250093507859189", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982503_250093511192522_4388969349790307505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwY6XgppC1YQ7kNvwFoA-Ty&_nc_oc=Adov1xN4mJulV8twrWvGaBDHMODYvsPOEV80vpMoZkK5NBHHHWPZFqyT0yprEIbKdlI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8p9XqQvJ57WW3uP8d-9f9H_fNBSelrhPkwQZoQXWIHGg&oe=6A3BEAC8"}, {"file_name": "Session_1.23.1.png", "id": "795767698985101", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001732_795767702318434_262560137887527662_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JZs2s2TlHcQ7kNvwF7cjuw&_nc_oc=AdqDiYDWzTGErDtuZuAMmTKdJ2MrYCkyKjWOpfqS0_8su_GpuFh7CgoH3_Vsc_avXF0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YT7mJfv-Tjzw5UPbeoq8ZWVPC05HcmnznkHSjsR5E-w&oe=6A3C013A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tranzfirstframe.png", "id": "381471740929152", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036702_381471744262485_3617820370637424030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xoET13Zh5IQ7kNvwF4r1Ds&_nc_oc=AdqZv_mk8zZJpHvOqQIhVGZL5eTaxSqiyA8NkS1Gc3FQEiS4aXO_huEV1zQFk5uBAgc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cYTjRRe-a7ZnaUA6eTZZDg0iTQ-SN8wdrvVstkN-EZQ&oe=6A3BE40E"}, "display_name": "Tranzient", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Full support for hand tracking and mixed reality/passthrough \n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.\n\n\nIn the full version you get:\n- Built in 1.5 Gb library of loops and sounds\n- Use any number of synths (up to what the system can handle)\n- Use your own video and loops/samples\n- Export mixes of your performance\n- Lots more built in videos, VFX, Avatars and worlds.", "short_description": "The full version of Tranzient!\n\nMake beats in VR. Full live looping music production and sequencing environment in VR including visuals. \n\nThis is not a rhythm game.\n\nWho made the beats? You did!\n\nIn the full version you get:\n- Built in 1.5 Gb library of loops and sounds\n- Use any number of synths (up to what the system can handle)\n- Use your own video and loops/samples\n- Export mixes of your performance\n- Lots more built in videos, VFX, Avatars and worlds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "560243919508532"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "1588531733278170"}, {"status": "PUBLISHED", "id": "963514182892605"}, {"status": "PUBLISHED", "id": "1364569582004945"}, {"status": "PUBLISHED", "id": "864654726111746"}, {"status": "PUBLISHED", "id": "1590157319016889"}, {"status": "PUBLISHED", "id": "825477826797024"}, {"status": "PUBLISHED", "id": "798476329292209"}, {"status": "PUBLISHED", "id": "759225986506523"}, {"status": "PUBLISHED", "id": "2036502970206714"}, {"status": "PUBLISHED", "id": "1675980083111864"}, {"status": "PUBLISHED", "id": "620930694162777"}, {"status": "PUBLISHED", "id": "1777815079619774"}, {"status": "PUBLISHED", "id": "1155415962669543"}, {"status": "PUBLISHED", "id": "1610313416552538"}, {"status": "PUBLISHED", "id": "1073484997334524"}, {"status": "PUBLISHED", "id": "678098907723648"}]}, "baseline_offer": {"id": "1675980083111864"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1588531733278170"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "A
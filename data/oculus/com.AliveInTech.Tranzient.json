dbSTkK3FRlIRDnGBNphrMhWlU15HilOhdHbA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1QLsRN40Js25nxc_cyMKqsOJJvwso1f26C8Ri7x6CjhA&oe=69F1ECCA"}, {"file_name": "stepseq2_1.22.2.png", "id": "250093507859189", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982503_250093511192522_4388969349790307505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JI3wmZudhBgQ7kNvwGauurD&_nc_oc=Ado93vZMeUX1PCowIP_0qGwWsLibV1KLqQzAVCeHnF4nVBu44nJYAdXg5gnemZtqjlw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af33SBIkZaSZSKmVoN9wSlUOK28J8Fqfu1TXjrI1zhpGKw&oe=69F216C8"}, {"file_name": "Session_1.23.1.png", "id": "795767698985101", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001732_795767702318434_262560137887527662_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJzrxqBpwgAQ7kNvwF2DLdt&_nc_oc=AdqezHu8cLOytWV89Fb-vGUl_GQ2FqxCU6NenbWoksmnLpx30X-kz2iKIAOXI5saj9c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af17DpsT_ZuWtb4e0CUhtPG7N1pDITxNCLaImTGnMdnalw&oe=69F1F4FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewHeroSnowOculusVideoThumb.png", "id": "356731030443805", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982724_356731033777138_5182502195578425480_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1G-Qv8OrTwwQ7kNvwEu_vyy&_nc_oc=AdqUuYBU9g80oA79ksoaFTK2wV793pJjC1ESia-RwPSxs6mLgAcNWhEazCTqCruAWIE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1g4ENdlUJ8YSL93VTaOhNI-JEYY9YWNEIqfQXK1jcyoQ&oe=69F1F186"}, "display_name": "Tranzient", "keywords": ["Music", "DJ", "Beats", "Concert", "DAW"], "long_description": "#Create Music Like Never Before in VR/MR\n\nStep into a revolutionary music-making experience in virtual and mixed reality.\n\n- **Seamless Immersion**: Full hand-tracking support and mixed reality passthrough bring your studio to life.\n- **Perfect Loops, Effortlessly**: Sync loops from a rich content library automatically time-stretched and pitch-shifted to match your song.\n- **Sing & Perform**: Record vocals with motion-captured avatar playback\u2014your virtual self, center stage.\n- **Be You**: Rock your custom Ready Player Me avatar.\n- **Beat It**: Explore a dynamic set of drum kits and one-shots.\n- **Mix Masterfully**: Use Decks to craft flawless transitions and seamless mixes.\n- **Sound Sculpting**: Apply pro-grade audio FX (reverb, chorus, and more) to individual clips or entire scenes.\n- **Automation Magic**: Loop-record automation for FX and synth parameters with precision.\n- **3D Control**: Assign and tweak FX and synth settings in a fully spatial environment.\n- **Visual Vibes**: Sync looping videos to the beat for a multisensory experience.\n- **Step It Up**: Trigger anything in your world with a step sequencer\u2014loop instruments, drum kits, and edit steps with swing quantization.\n- **Synth Powerhouse**: Built-in Analog and Wavetable synths with over 250 inspiring sounds.\n- **Binaural Bliss**: Craft immersive spatial mixes based on clip positioning.\n- **Capture the Moment**: Record In-game camera to showcase your creativity.\n- \"\"Your Gear, Your Way\"\": Plug in your USB MIDI keyboard or controller for ultimate control.", "short_description": "The full version of Tranzient!\n\nCreate Music Like Never Before in VR/MR\n\nStep into a revolutionary music-making experience in virtual and mixed reality.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://discord.com/invite/mg6ZJHx", "website_url": "https://aliveintech.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "N
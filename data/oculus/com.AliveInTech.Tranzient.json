_nc_ohc=992yXw3ZxmUQ7kNvwGGirQ2&_nc_oc=AdpHuhDnoSR2wz362e4_oP5r6nesKyZlb4qZybZLdWaNLXR3KZeUOGPeW9576A5Z7m4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9V-rvJyehExMArF9SXdCqZOy-2lhK0lwFo24V1FdaLzw&oe=6A369F79"}, {"file_name": "VideoWall_1.18.1.png", "id": "961945845417678", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974845_961945852084344_6533138472087779742_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmwjJKXms-UQ7kNvwFVzit0&_nc_oc=Adp80obZT2tP0qYrOX9W_eFiJs6odBfpR3WUp726EfFe3DLOqxu4mU8Bu2-tv84YRZI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YRSBu2tREXeeBwcYh7uap3o7eILQgI6T-djFxiBuGKw&oe=6A36B165"}, {"file_name": "stepseq2_1.22.2.png", "id": "250093507859189", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982503_250093511192522_4388969349790307505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIbpxsxmKBcQ7kNvwEKsVJC&_nc_oc=AdrgC_FCLP3EkPxuMhCWAWVYjQ-xp1gju-jPvutWCO0x5_qtfS4uJkMeMqAUHRGivW4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9M0dTNZ7FEsZ3O-_Rdf11uI18V7z3CsSq3n-t_hNVO5Q&oe=6A36A4C8"}, {"file_name": "Session_1.23.1.png", "id": "795767698985101", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39001732_795767702318434_262560137887527662_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vm-D2QFUs6wQ7kNvwHxxyN-&_nc_oc=Adp7elF05IwQg0DECsrfcCWfHjoeUaq57JBq-0zzNHDOqPNAb1NZ-ugHH8gs7y4CI8c&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ahvajVo5fIHhC6r059Gq6N6t1IJY0celqpLc_VyNmyA&oe=6A36BB3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tranzfirstframe.png", "id": "381471740929152", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39036702_381471744262485_3617820370637424030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLYH13YGjC4Q7kNvwGUfzdn&_nc_oc=Adr8VLm9GTuRtCrGqu1CwfaH5POPDEe5EJgqSHLjQVo8sTCU0VOQKGe_vcg-V0H91TQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84xWuvJ4Qg5DBeh6ffn033kBBWdxiPKWw_OqmbxW8y5w&oe=6A369E0E"}, "display_name": "Tranzient", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Full support for hand tracking and mixed reality/passthrough \n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.\n\n\nIn the full version you get:\n- Built in 1.5 Gb library of loops and sounds\n- Use any number of synths (up to what the system can handle)\n- Use your own video and loops/samples\n- Export mixes of your performance\n- Lots more built in videos, VFX, Avatars and worlds.", "short_description": "The full version of Tranzient!\n\nMake beats in VR. Full live looping music production and sequencing environment in VR including visuals. \n\nThis is not a rhythm game.\n\nWho made the beats? You did!\n\nIn the full version you get:\n- Built in 1.5 Gb library of loops and sounds\n- Use any number of synths (up to what the system can handle)\n- Use your own video and loops/samples\n- Export mixes of your performance\n- Lots more built in videos, VFX, Avatars and worlds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_
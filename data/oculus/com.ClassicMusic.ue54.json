 "2560x1440E.png", "id": "995959166049209", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_995959169382542_8187481680762451692_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxZy8nuaiREQ7kNvwGYnUuX&_nc_oc=Adm9mtWOn88fK83kN7qLLVEhf12BBGHVLJ6ngf2GvVL_Oe58Ef-h7JWC7GF0RglEqg8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzUkQUjkL6kY-xPC4J6RmNUoz71MKJp83eY2izUD6M8OQ&oe=69B54B57"}, {"file_name": "2560x1440B.png", "id": "1110625254415472", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393325_1110625257748805_3784220982656755756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4qpjvf95lUQ7kNvwGTx8Jx&_nc_oc=AdmBzQn1Ko6vadA3mTWErf_z_iQaIYWMQwbY0TQuhHwBy8cRzKkU9-Ipu63Eakkr4nQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_KbMXUOicGJsVSJ1Aj-_-7BWXfiLp2b_Bfwu6vZ82Lw&oe=69B53F4A"}, {"file_name": "2560x1440F.png", "id": "669201935897344", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392000_669201939230677_4439538892134420676_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFDeDFWci1UQ7kNvwFizY5S&_nc_oc=Adm4iSz2tTBdLONMu5S28DQKSnRfkDiuuxcOI5t2JD4QxyBU7mR248x5LsJuvvq54qQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz0_3H4NjgN4G3MXNfYz7su6ZOUjxJtOkIXH2UhGuYtSA&oe=69B5574E"}, {"file_name": "2560x1440C.png", "id": "711723874656969", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393887_711723877990302_6845402994642399668_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJ5TXmSV4KgQ7kNvwEoUc1Z&_nc_oc=AdlcO4U293pH2u4yKFXoibOcpK8uOx6foJg0-ud4I9SLotCUv3BFHNXV7slPL4p24Sc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afynqcz-hrpLS2ZUC8KBPGS8iDLTs0Vg3Z251cavlR7TQg&oe=69B5683B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "599383266500580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821784_599383273167246_7004495289843688357_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aa7H2d7CfnoQ7kNvwEsG1-F&_nc_oc=Admnu1xwleBlwtSEkrDPi1trYLeGQ59V1_1ReImoltwXjeNTu_Y4cwc1HoIYDLVbCTw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afym4FIJ-CD_6yf7K6DINHnjuf6cAmaPAYeQxmydkL2owQ&oe=69B5550E"}, "display_name": "Classic Music VR - Summer", "keywords": ["experience", "new", "ClassicMusic", "music"], "long_description": "\"Summer\" is an emotional and sensory journey in virtual reality, inspired by Antonio Vivaldi\u2019s celebrated masterpiece. Immerse yourself in stunning natural landscapes as the vibrant notes of the summer season come alive around you.\nThroughout the experience, you\u2019ll be able to interact with paintings that appear along the way, collecting and discovering works inspired by the greatest Italian masters. Every sound and visual detail is designed to draw you deep into the music, letting you experience Vivaldi like never before.\nA poetic and immersive experience, perfect for lovers of music, art, and virtual reality.\n", "short_description": "An immersive VR experience set to the notes of Vivaldi\u2019s Summer, among breathtaking natural landscapes and interactive paintings inspired by Italian masters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrschoolitalia.it/privacy-policy-app-vr/", "developer_terms_of_service_url": null, "publisher_name": "UE5", "support_website_url": null, "website_url": "https://www.vrschoolitalia.it/altri-progetti/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
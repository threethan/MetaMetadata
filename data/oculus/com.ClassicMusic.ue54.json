 "2560x1440E.png", "id": "995959166049209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_995959169382542_8187481680762451692_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=225AkjzEoE8Q7kNvwEdyYrl&_nc_oc=AdnLQ671xPmqwMau2_KMClXntqYCEJeIU-C7CnrXlPXvl4hQhyW_2uupn9aAYhVH0IE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8XF2E7aaJmEhkcw3AxXyg_QL7qHi7VJkCy-nPhDZxiw&oe=69BE85D7"}, {"file_name": "2560x1440B.png", "id": "1110625254415472", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393325_1110625257748805_3784220982656755756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLF7C1OpdLgQ7kNvwGPrEm_&_nc_oc=AdloB-yOVq5seFPannWhUL9sC_UVXH8h5lQvjyNZjYAbMK567rUGxoSl28900YgBam0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNI0DxRfm0XCKSqQ-UQYuDW4dok2prkGBt2Rj9KR1wtA&oe=69BE79CA"}, {"file_name": "2560x1440F.png", "id": "669201935897344", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392000_669201939230677_4439538892134420676_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xK3ntUC-nv0Q7kNvwGMHPCe&_nc_oc=AdlCKinsTZjnudM-dB__J5ZP4a20lGGoQ3qs8f3del5cn7oRMPzP6YAUQ4MXzkpK83Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8HtQxmM2Xy4fuu22f5GwhWWPNZH6N_tJwfOVlVVK9DA&oe=69BE91CE"}, {"file_name": "2560x1440C.png", "id": "711723874656969", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393887_711723877990302_6845402994642399668_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kP-6c5W_RzkQ7kNvwEPDF_o&_nc_oc=Adkbp4GcfNFvbIHweH4135zLAu079O52qmlVQV8-f6yaw5d3Kh0_CrT8Se3BYRjrDU0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQwrzw4Vc-YaC5V45u5Q7HP6pIo8YFnwP0InS1FmJ-_g&oe=69BEA2BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "599383266500580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821784_599383273167246_7004495289843688357_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1BA24IaLE0Q7kNvwGrURYm&_nc_oc=Adk7Z2EKiDyDk8lnhFjUymCLXoJYT2ReFetYb7z5dBgjRcnllAOojRodA9LchnhXWuU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0KpNIUSpYCZ6ln7SyeMy_Cn3Z2EPfyleJ4HKOdE9Wrg&oe=69BE8F8E"}, "display_name": "Classic Music VR - Summer", "keywords": ["experience", "new", "ClassicMusic", "music"], "long_description": "\"Summer\" is an emotional and sensory journey in virtual reality, inspired by Antonio Vivaldi\u2019s celebrated masterpiece. Immerse yourself in stunning natural landscapes as the vibrant notes of the summer season come alive around you.\nThroughout the experience, you\u2019ll be able to interact with paintings that appear along the way, collecting and discovering works inspired by the greatest Italian masters. Every sound and visual detail is designed to draw you deep into the music, letting you experience Vivaldi like never before.\nA poetic and immersive experience, perfect for lovers of music, art, and virtual reality.\n", "short_description": "An immersive VR experience set to the notes of Vivaldi\u2019s Summer, among breathtaking natural landscapes and interactive paintings inspired by Italian masters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrschoolitalia.it/privacy-policy-app-vr/", "developer_terms_of_service_url": null, "publisher_name": "UE5", "support_website_url": null, "website_url": "https://www.vrschoolitalia.it/altri-progetti/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
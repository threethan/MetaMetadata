 "2560x1440E.png", "id": "995959166049209", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393507_995959169382542_8187481680762451692_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GB9H9VB6wuYQ7kNvwGUg8an&_nc_oc=Adlz1EC8n8S_4Vjpz-kPxxeCcjD-jwnzPIPulBgzJp2hulAro7LlHY4TIAG4I_qvc0s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGYQdPxgQVFrj9iYsq0uQiuNiTxQKzq4tIDASGkqPwsw&oe=69B00557"}, {"file_name": "2560x1440B.png", "id": "1110625254415472", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393325_1110625257748805_3784220982656755756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEXskooEZ5IQ7kNvwFyUlEJ&_nc_oc=AdlDJXO_5BCEoJLjZefYBnVMaLaEQDK73sl78aHX6FVAKwSCEoUNCsAtP_9HevfT6Co&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4id_GIaQpROlVK0pTqXICj4mcSvOuXKGl7Pc7PNhDhQ&oe=69AFF94A"}, {"file_name": "2560x1440F.png", "id": "669201935897344", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392000_669201939230677_4439538892134420676_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMj6meDg2lEQ7kNvwG3cCoP&_nc_oc=AdmeWBHbZ6qD4tYYIRaF7yDKmeVpBoJvZ31htI3cLfH-JR8coLd_hhr0_51tDWnV2DA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzBTkT-XDhuX_OfJwjp5obRWD56Ru1XOdubie4EoEJqSA&oe=69B0114E"}, {"file_name": "2560x1440C.png", "id": "711723874656969", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393887_711723877990302_6845402994642399668_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BP6YQtujloQQ7kNvwFifQ_x&_nc_oc=Adni1aVnWlD8J6XOpU9woE_sV-8KDo-uT4MERN2SjpRg6UINzHybRGko1gpj8U-Zqrw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGTbI_IYrWoc9UiXzNXVOyJZCaHT4VnG1fFZ4Dj06sOw&oe=69B0223B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "599383266500580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821784_599383273167246_7004495289843688357_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1zKiqlKceEQ7kNvwHMsC4m&_nc_oc=Adn-9mL6N-oHiPTWjL6EtuYAxgrovJfgf6FWA88BPq4kwogw3Jt1VgyXM-QADpVixDk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwwhrhS_oa7ZqDvhs1Jz4Z9vIY1UM-G9s9_4ZEAMBRvUA&oe=69B00F0E"}, "display_name": "Classic Music VR - Summer", "keywords": ["experience", "new", "ClassicMusic", "music"], "long_description": "\"Summer\" is an emotional and sensory journey in virtual reality, inspired by Antonio Vivaldi\u2019s celebrated masterpiece. Immerse yourself in stunning natural landscapes as the vibrant notes of the summer season come alive around you.\nThroughout the experience, you\u2019ll be able to interact with paintings that appear along the way, collecting and discovering works inspired by the greatest Italian masters. Every sound and visual detail is designed to draw you deep into the music, letting you experience Vivaldi like never before.\nA poetic and immersive experience, perfect for lovers of music, art, and virtual reality.\n", "short_description": "An immersive VR experience set to the notes of Vivaldi\u2019s Summer, among breathtaking natural landscapes and interactive paintings inspired by Italian masters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrschoolitalia.it/privacy-policy-app-vr/", "developer_terms_of_service_url": null, "publisher_name": "UE5", "support_website_url": null, "website_url": "https://www.vrschoolitalia.it/altri-progetti/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
2-1.oculuscdn.com/v/t64.5771-25/473393507_995959169382542_8187481680762451692_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s--tzgoVDboQ7kNvwHP4AqE&_nc_oc=AdmqhODELT1UQPsfyhmqyrsPpZXAJitoFKvYWhwHDlVwK-5RZtffcISQmY8jSBjgueM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv4WBOAnmMXAZ1Zer-Z8XgQTvk1zGYt5LWTFOU2Qf3qEQ&oe=699EE1D7"}, {"file_name": "2560x1440B.png", "id": "1110625254415472", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393325_1110625257748805_3784220982656755756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zOxeIQdrJ4Q7kNvwGl9u5e&_nc_oc=Adl1Utkb-jkWevrLIYibh1UIzkJ1AqM_GApsirSRgnF90V3ijp5RDL6z7ZU3CYmsYt4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftevxruLEJUEDhhYzy-ckJSJYVA-JtamCEEiCiVHy3UDw&oe=699ED5CA"}, {"file_name": "2560x1440F.png", "id": "669201935897344", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392000_669201939230677_4439538892134420676_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RzDd5uvSPDkQ7kNvwEZifcv&_nc_oc=AdmwW8L-whEILG23hswAk7IKRYG8PyYRiu-b2DZuGjSALSYYHqYJaoDJPyYQX6p6aJo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftlDEs14x1deSYj5oAVtpoks-UKpGaTI6Tk96V2myYYeg&oe=699EEDCE"}, {"file_name": "2560x1440C.png", "id": "711723874656969", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393887_711723877990302_6845402994642399668_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgIoQEWiDNAQ7kNvwHmjaZr&_nc_oc=AdliLm5iY-7O95W6nP5KinWJrQJ91k3Uqpx7wpTt4hIerNADixhYlUcz6ZrewFK9xh0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsIs4ktbxC5TtKT2tN_XUTzU_R565Xq2EeP8awrZFGxmw&oe=699EFEBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "599383266500580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821784_599383273167246_7004495289843688357_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbhuGzyHQAUQ7kNvwHvhUq5&_nc_oc=Adkk8tUPWWOUte28pNIescUjUb2VyD5NBpY3ht6JUBSM36N4wWhFvzwzmZhJH1ozzbc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsRhMETKQKJ7xM2-wLcUzl0T1OzBk547L5rIBbYatD8ag&oe=699EEB8E"}, "display_name": "Classic Music VR - Summer", "keywords": ["experience", "new", "ClassicMusic", "music"], "long_description": "\"Summer\" is an emotional and sensory journey in virtual reality, inspired by Antonio Vivaldi\u2019s celebrated masterpiece. Immerse yourself in stunning natural landscapes as the vibrant notes of the summer season come alive around you.\nThroughout the experience, you\u2019ll be able to interact with paintings that appear along the way, collecting and discovering works inspired by the greatest Italian masters. Every sound and visual detail is designed to draw you deep into the music, letting you experience Vivaldi like never before.\nA poetic and immersive experience, perfect for lovers of music, art, and virtual reality.\n", "short_description": "An immersive VR experience set to the notes of Vivaldi\u2019s Summer, among breathtaking natural landscapes and interactive paintings inspired by Italian masters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrschoolitalia.it/privacy-policy-app-vr/", "developer_terms_of_service_url": null, "publisher_name": "UE5", "support_website_url": null, "website_url": "https://www.vrschoolitalia.it/altri-progetti/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "100980
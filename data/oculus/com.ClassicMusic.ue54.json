 "2560x1440E.png", "id": "995959166049209", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_995959169382542_8187481680762451692_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMKo0f72QNEQ7kNvwF7FO_j&_nc_oc=AdkHnEjZuRiCCmw5bZAdxCVoeUi2Tp_P4fq1Us4gURn7uZ3HpsqQWI1BZVbLV0Yx5YE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz6BuRgkgu6Y0FEgbRCEJvj-pBxSvtJ9BIAaejAafWO0g&oe=69B3F9D7"}, {"file_name": "2560x1440B.png", "id": "1110625254415472", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393325_1110625257748805_3784220982656755756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4qpjvf95lUQ7kNvwFtvcLc&_nc_oc=AdlhsPCJPGn-HzkZfYJ_wcRBrWX5FX74FnUmBAb_TImsiCkle8eXh0G_i7JRz30QCAE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyO468hS1qLAYsjLzhqkd2xd9vDrclZQyB5dr0ZID1z0A&oe=69B3EDCA"}, {"file_name": "2560x1440F.png", "id": "669201935897344", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392000_669201939230677_4439538892134420676_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHmmVzzcC-MQ7kNvwF-E-uo&_nc_oc=AdllXt_-pRdE0JkOKT_z39ojyjUM0JoZXXOULz10uxqevsyXZKZkIWxqp_wcGMbdVCo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyQl517LBXy-isNu4PPwEFI4Ld4Zh6kN71C_i2DLVAUsQ&oe=69B405CE"}, {"file_name": "2560x1440C.png", "id": "711723874656969", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393887_711723877990302_6845402994642399668_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJ5TXmSV4KgQ7kNvwGBIpAY&_nc_oc=AdmqcB-Zi5Bwc7OiuIkGRPnkX79UeBjd9657ChLQAdptjBVq0G-kJrPoSGVmxbAIJM4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfygKW6aHgWgsp380TT3vB7KZAG5ExmWE6Myqv6oN1vTqg&oe=69B416BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "599383266500580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821784_599383273167246_7004495289843688357_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aa7H2d7CfnoQ7kNvwH-r5CO&_nc_oc=Adl9ZSaQRAJI9L42fZyyiy7xC5g7m8gxXUtEZI5ploBosXjeo-EWGyQsJkdntzOfrt0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzXmu_HInWIXZ2pJQksE0M6RxTFJiicCK8-Z7_k8tSf7Q&oe=69B4038E"}, "display_name": "Classic Music VR - Summer", "keywords": ["experience", "new", "ClassicMusic", "music"], "long_description": "\"Summer\" is an emotional and sensory journey in virtual reality, inspired by Antonio Vivaldi\u2019s celebrated masterpiece. Immerse yourself in stunning natural landscapes as the vibrant notes of the summer season come alive around you.\nThroughout the experience, you\u2019ll be able to interact with paintings that appear along the way, collecting and discovering works inspired by the greatest Italian masters. Every sound and visual detail is designed to draw you deep into the music, letting you experience Vivaldi like never before.\nA poetic and immersive experience, perfect for lovers of music, art, and virtual reality.\n", "short_description": "An immersive VR experience set to the notes of Vivaldi\u2019s Summer, among breathtaking natural landscapes and interactive paintings inspired by Italian masters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrschoolitalia.it/privacy-policy-app-vr/", "developer_terms_of_service_url": null, "publisher_name": "UE5", "support_website_url": null, "website_url": "https://www.vrschoolitalia.it/altri-progetti/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
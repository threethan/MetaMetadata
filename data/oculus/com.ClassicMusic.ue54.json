 "2560x1440E.png", "id": "995959166049209", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393507_995959169382542_8187481680762451692_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2Z65kdUIawQ7kNvwHpTv8L&_nc_oc=Adn0MHjqhpkW_1hOyW8isjF8yoXcTwqRTo7ZB-0EDzcqaepZHaawjiCFJKxPuz6YH50&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwmEXcbCbEj2w982ACrRiYx28nwGqmkcdfiWeIl6PtA1Q&oe=69BA9157"}, {"file_name": "2560x1440B.png", "id": "1110625254415472", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393325_1110625257748805_3784220982656755756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bodc2oY8ap8Q7kNvwFzhZqB&_nc_oc=AdkrlX_xXuQZBeh4AJy4bkTit-dK_NxYzia9uErh6OvXpjvHhQk8Xly66eoIu5GC5rM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxT887h0zI-eIO0ITitO5UvorNACEKHaUouS6ZTBgV1SA&oe=69BA854A"}, {"file_name": "2560x1440F.png", "id": "669201935897344", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392000_669201939230677_4439538892134420676_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HelT3Igq6e0Q7kNvwFrUB0M&_nc_oc=AdlwzH8t1_XjFyvLo0L1SQQmYzCq3NvqGdrFOkCfItYkspZ0fmCqEP3J2UTDoreipMQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzOGkgaeyLTtErjL2euQMTBe2PyPbKuho8HxXD5JOdclg&oe=69BA9D4E"}, {"file_name": "2560x1440C.png", "id": "711723874656969", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393887_711723877990302_6845402994642399668_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqaSBYkpmZwQ7kNvwHCTir0&_nc_oc=Adn8G7G0g6iQa73guNRRQu4ptKSV5deTch96Brmh67ujin0Hfsha6B1-IIP8xHmPjAA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwwypGLOzRPaflh7qlGNjLQqTo0j902apOZt_wOp17nJg&oe=69BAAE3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "599383266500580", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821784_599383273167246_7004495289843688357_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SE51vXbrEoQ7kNvwFD0yoL&_nc_oc=Admux9S_9gn62rvVBxK2zy4teu0Y7u2dUeh61HUqtaOiQgluHWThLzbqUYuNLlJwPeo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzWpghkoFX-A_zoSTm-Rj2mK6dHyumFwt6X15_CMBh70w&oe=69BA9B0E"}, "display_name": "Classic Music VR - Summer", "keywords": ["experience", "new", "ClassicMusic", "music"], "long_description": "\"Summer\" is an emotional and sensory journey in virtual reality, inspired by Antonio Vivaldi\u2019s celebrated masterpiece. Immerse yourself in stunning natural landscapes as the vibrant notes of the summer season come alive around you.\nThroughout the experience, you\u2019ll be able to interact with paintings that appear along the way, collecting and discovering works inspired by the greatest Italian masters. Every sound and visual detail is designed to draw you deep into the music, letting you experience Vivaldi like never before.\nA poetic and immersive experience, perfect for lovers of music, art, and virtual reality.\n", "short_description": "An immersive VR experience set to the notes of Vivaldi\u2019s Summer, among breathtaking natural landscapes and interactive paintings inspired by Italian masters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrschoolitalia.it/privacy-policy-app-vr/", "developer_terms_of_service_url": null, "publisher_name": "UE5", "support_website_url": null, "website_url": "https://www.vrschoolitalia.it/altri-progetti/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
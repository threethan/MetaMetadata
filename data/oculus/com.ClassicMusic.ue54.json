 "2560x1440E.png", "id": "995959166049209", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_995959169382542_8187481680762451692_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxZy8nuaiREQ7kNvwHFUgFN&_nc_oc=Adn9VmVmaBzp-iqe369aYfTKvbWzEUl074NcfiyX5nS_sGROiQb7Q4xGOg_9_OwW7jQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxRvr2fyw_xnHYN7XxSuYzB3t10hgHOoJeCOArwrLRv5g&oe=69B7EE57"}, {"file_name": "2560x1440B.png", "id": "1110625254415472", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393325_1110625257748805_3784220982656755756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bed2HMNDAPQQ7kNvwE2X5-b&_nc_oc=AdnGhDrkwsY9Zp9qnPEya3V1IZnDqCl1RqjlhEwdNw70thsGASVvGIwQ2Ttpni2z0RU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyWp23d1y5bf7ZvT6zmRdXz66QYaky1oB1S-OxUpkNR_A&oe=69B7E24A"}, {"file_name": "2560x1440F.png", "id": "669201935897344", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392000_669201939230677_4439538892134420676_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFDeDFWci1UQ7kNvwHzFA8m&_nc_oc=AdlkhG7jPlzmZa814Zb-Wqr097uD6jsxuRYQRaZAbyvLxtzTgnBtIlcPuoAsF3UlqMI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwSqyAFwvxyN8Q-fV53kOw9GJsNmJIM5s0H_0VRhD1ctg&oe=69B7FA4E"}, {"file_name": "2560x1440C.png", "id": "711723874656969", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393887_711723877990302_6845402994642399668_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqaSBYkpmZwQ7kNvwE800Q0&_nc_oc=AdkX_9y2BIDgyMnh6zpvv-6lcvLaAMiy-af9hgU_irQMXrZFyHKnQBpaUAxcQeB_YFE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy_DsSR4Ca4BV2tVE1HZUdVFMLXytfutzNSMTnbud0NGg&oe=69B80B3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "599383266500580", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821784_599383273167246_7004495289843688357_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGrWuVrO-1kQ7kNvwFP72KO&_nc_oc=AdnRHK6eRCd6qn9wqW0enBLGj2HG8d9Sg3ZrUs894yPUphHCVyl04c18z-uiLfWWxZw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz8er8k_2nEe5KD9MbsaOtccyQNgBkUVqyTWd6sbixm7w&oe=69B7F80E"}, "display_name": "Classic Music VR - Summer", "keywords": ["experience", "new", "ClassicMusic", "music"], "long_description": "\"Summer\" is an emotional and sensory journey in virtual reality, inspired by Antonio Vivaldi\u2019s celebrated masterpiece. Immerse yourself in stunning natural landscapes as the vibrant notes of the summer season come alive around you.\nThroughout the experience, you\u2019ll be able to interact with paintings that appear along the way, collecting and discovering works inspired by the greatest Italian masters. Every sound and visual detail is designed to draw you deep into the music, letting you experience Vivaldi like never before.\nA poetic and immersive experience, perfect for lovers of music, art, and virtual reality.\n", "short_description": "An immersive VR experience set to the notes of Vivaldi\u2019s Summer, among breathtaking natural landscapes and interactive paintings inspired by Italian masters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrschoolitalia.it/privacy-policy-app-vr/", "developer_terms_of_service_url": null, "publisher_name": "UE5", "support_website_url": null, "website_url": "https://www.vrschoolitalia.it/altri-progetti/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
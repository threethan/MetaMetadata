 "2560x1440E.png", "id": "995959166049209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_995959169382542_8187481680762451692_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxZy8nuaiREQ7kNvwG1Olm_&_nc_oc=AdnIr6Nc9O7SjzHmC-J99UE0z09artpnRjzSgFmkhAh_a498xMSVbFcKPfqFiUFWmQ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwratGmTNtpxzM7EfnZWyIg2XdHFpokxOMFrq0Qo3LzOg&oe=69B69CD7"}, {"file_name": "2560x1440B.png", "id": "1110625254415472", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393325_1110625257748805_3784220982656755756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bed2HMNDAPQQ7kNvwGEWnJR&_nc_oc=AdnY_tF-nPJNEQfwkfvMTOf46GbwMKRLVa-gJEB3Vo_ZG2XOG7sJ9742sfDQAx8sw9M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxucvSX-RichDVuQbmv0Et0y35epnB-m4AazjElKpOF8w&oe=69B690CA"}, {"file_name": "2560x1440F.png", "id": "669201935897344", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392000_669201939230677_4439538892134420676_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFDeDFWci1UQ7kNvwGRHQsC&_nc_oc=AdlUJUb3AWk3ZiNv_dWPbvq02orEYuZ4y6GJ6MOS63aZ8o_GTZowep_g-3iXGf9BJjQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxa9_jdC8VJuYxZIS_xUMQ0roSrE_qu4XCWvkfUgMXgjw&oe=69B6A8CE"}, {"file_name": "2560x1440C.png", "id": "711723874656969", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393887_711723877990302_6845402994642399668_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJ5TXmSV4KgQ7kNvwGf8Xm0&_nc_oc=AdmaOBbznWaVxdbXAGuLojlr4f3ORKUfBJH1tgh4h6M5zh3JmSil7LL2dOL9k8d2Do0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJRF11Qx4uqV8zRDRNgCo30QmDUWUnUHV18GXdaAZeFw&oe=69B6B9BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "599383266500580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821784_599383273167246_7004495289843688357_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGrWuVrO-1kQ7kNvwHU3Jyc&_nc_oc=Admk_wr_f7fl33o4Tz9FwCAJ0T6_oP8q_Xj3MZN2UW6fKXgJkboNwaYo0xu6kVx_wZw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxESQFb6mwut8CN9EZWB4PBSEQNyQbuqxo3_9LFhZ6Wyw&oe=69B6A68E"}, "display_name": "Classic Music VR - Summer", "keywords": ["experience", "new", "ClassicMusic", "music"], "long_description": "\"Summer\" is an emotional and sensory journey in virtual reality, inspired by Antonio Vivaldi\u2019s celebrated masterpiece. Immerse yourself in stunning natural landscapes as the vibrant notes of the summer season come alive around you.\nThroughout the experience, you\u2019ll be able to interact with paintings that appear along the way, collecting and discovering works inspired by the greatest Italian masters. Every sound and visual detail is designed to draw you deep into the music, letting you experience Vivaldi like never before.\nA poetic and immersive experience, perfect for lovers of music, art, and virtual reality.\n", "short_description": "An immersive VR experience set to the notes of Vivaldi\u2019s Summer, among breathtaking natural landscapes and interactive paintings inspired by Italian masters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrschoolitalia.it/privacy-policy-app-vr/", "developer_terms_of_service_url": null, "publisher_name": "UE5", "support_website_url": null, "website_url": "https://www.vrschoolitalia.it/altri-progetti/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
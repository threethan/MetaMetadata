 "2560x1440E.png", "id": "995959166049209", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_995959169382542_8187481680762451692_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7-klWqTYPcQ7kNvwHwKqbA&_nc_oc=Admcb6L4Ivu9He2oJ-w44wLJUhznI2p8kcfFZFJ2T_D3HVfb_Eh6y8CueNn5m6qW3P8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu0BIbKgvDZbelywldynKTQVekaLMtoBbBVZ0O_kELjzw&oe=69A96DD7"}, {"file_name": "2560x1440B.png", "id": "1110625254415472", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393325_1110625257748805_3784220982656755756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uPLo9-9Q1kQ7kNvwHNgSET&_nc_oc=AdkBqc_HJqsKe2zR3mmeUr66Y0oi3ao4jeLA0JJ0futbagqRrx5Y80oX3NeYoiXURPg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afvfz8owxpGJkNbX2xZYAO9o63YW4rzgKEr8FufBnk-PEw&oe=69A961CA"}, {"file_name": "2560x1440F.png", "id": "669201935897344", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392000_669201939230677_4439538892134420676_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEWR6CIYSFEQ7kNvwEdtJp_&_nc_oc=AdnPWfJ5CxVJOWd-JlrKbODWfzBPa5hn0355MzVXG9Bxsaqcnc01LBiq1hiye4U4nBA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsQ_G_XagzArpyRIHp-ccPTcxxDDjDV7Ls3HFzfDndBYw&oe=69A979CE"}, {"file_name": "2560x1440C.png", "id": "711723874656969", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393887_711723877990302_6845402994642399668_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nG7W5jt99lYQ7kNvwGBA_6U&_nc_oc=AdkzHtcwfxw1ucxiexj6mxhnl2fiW7gqG7S42rr1LVUcHJa_M_F1O52Y3wh8roKJw8U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuoINCNoqpNnfIXgHOVdFs4qXmUFKcFUU1JfKDXSk3VMg&oe=69A98ABB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "599383266500580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821784_599383273167246_7004495289843688357_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvzfwdFpfFUQ7kNvwEzqV2K&_nc_oc=AdlZMTlOXNdp_DxEYecSfZUBMhq4IF2laDaTiWy7xrimfus977MF68q582eiPMFi_Ig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsqipAWlCWRcuHl5JLG2kIQNMB82TI-6djTEWP1Xfq8Mw&oe=69A9778E"}, "display_name": "Classic Music VR - Summer", "keywords": ["experience", "new", "ClassicMusic", "music"], "long_description": "\"Summer\" is an emotional and sensory journey in virtual reality, inspired by Antonio Vivaldi\u2019s celebrated masterpiece. Immerse yourself in stunning natural landscapes as the vibrant notes of the summer season come alive around you.\nThroughout the experience, you\u2019ll be able to interact with paintings that appear along the way, collecting and discovering works inspired by the greatest Italian masters. Every sound and visual detail is designed to draw you deep into the music, letting you experience Vivaldi like never before.\nA poetic and immersive experience, perfect for lovers of music, art, and virtual reality.\n", "short_description": "An immersive VR experience set to the notes of Vivaldi\u2019s Summer, among breathtaking natural landscapes and interactive paintings inspired by Italian masters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrschoolitalia.it/privacy-policy-app-vr/", "developer_terms_of_service_url": null, "publisher_name": "UE5", "support_website_url": null, "website_url": "https://www.vrschoolitalia.it/altri-progetti/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
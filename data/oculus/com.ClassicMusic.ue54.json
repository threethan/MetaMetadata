 "2560x1440E.png", "id": "995959166049209", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_995959169382542_8187481680762451692_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7-klWqTYPcQ7kNvwHfg_8z&_nc_oc=Adk5S2ty4r7R_-00TqC4EkGgfsUP03eCr3APrwAS3L_vOPU0GJ5Fzf9sR66FMUlbQwM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfygD3Ygy9uW-F4aTkYWIfYwsdWnAVYfWrXhJTunSDgMOA&oe=69AC10D7"}, {"file_name": "2560x1440B.png", "id": "1110625254415472", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393325_1110625257748805_3784220982656755756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-bJlrP1Yy8Q7kNvwFPhcfC&_nc_oc=Adlht3JMwSHSRVa-Nv71Egv0jmwmVT5zUhvBYG9_xN49jGZWG2zdc5O92Qo2y4RgmWs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw8F6D67KA9qBzWV_AYnGtE-XUNgER9Qw8QM6sLmTYFgw&oe=69AC04CA"}, {"file_name": "2560x1440F.png", "id": "669201935897344", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392000_669201939230677_4439538892134420676_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEWR6CIYSFEQ7kNvwHouG9L&_nc_oc=Adkbuw7fazcohcAHFphI-i4jWc868vwnsnlh1uhRU1OLdsVXViUH891yagrkHYXGk-4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxYKc6BKvaR5ECHJJ1oiMMFl3eIgLYr9gMrIbpflT-vsw&oe=69AC1CCE"}, {"file_name": "2560x1440C.png", "id": "711723874656969", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393887_711723877990302_6845402994642399668_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jk9ngqfQTX8Q7kNvwGG9aNQ&_nc_oc=AdmSEovDcnOb8AOEM6GCCWMgTVhNQn9gZKfuVMzlarqXM8YSWnVNckjJTLlDiWHJG5Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzFvcRt9wKQEZ0NoSEx4UCPulDHVp2dHi4oJRJXmSt0Dw&oe=69AC2DBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "599383266500580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821784_599383273167246_7004495289843688357_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kVf-ANJw_EQ7kNvwEQAx0U&_nc_oc=AdmcDnX9NYhuRPwhLx6056PmIlqfcacy_RgJYNEv-7yPN8BdXk8HUsX01sThSfQ1F3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzUmVzljZKnzwg3Y4otpA7kGbTc9etO3mW44_oC_I-HOw&oe=69AC1A8E"}, "display_name": "Classic Music VR - Summer", "keywords": ["experience", "new", "ClassicMusic", "music"], "long_description": "\"Summer\" is an emotional and sensory journey in virtual reality, inspired by Antonio Vivaldi\u2019s celebrated masterpiece. Immerse yourself in stunning natural landscapes as the vibrant notes of the summer season come alive around you.\nThroughout the experience, you\u2019ll be able to interact with paintings that appear along the way, collecting and discovering works inspired by the greatest Italian masters. Every sound and visual detail is designed to draw you deep into the music, letting you experience Vivaldi like never before.\nA poetic and immersive experience, perfect for lovers of music, art, and virtual reality.\n", "short_description": "An immersive VR experience set to the notes of Vivaldi\u2019s Summer, among breathtaking natural landscapes and interactive paintings inspired by Italian masters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrschoolitalia.it/privacy-policy-app-vr/", "developer_terms_of_service_url": null, "publisher_name": "UE5", "support_website_url": null, "website_url": "https://www.vrschoolitalia.it/altri-progetti/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
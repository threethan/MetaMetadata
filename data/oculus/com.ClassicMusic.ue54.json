K8JXGpHaXxyZ081XIFpIOlzA1XfR5KuNxw8Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRHJ-zbWNELXZH4kT4byWeFWqCgUswKx95gWs4MnSTlQ&oe=6AAFF48A"}, {"file_name": "2560x1440F.png", "id": "669201935897344", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392000_669201939230677_4439538892134420676_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62I4lz7Gs8cQ7kNvwGjos7s&_nc_oc=Adqgv8n2WFtO2lZKV6JZyKs3fAwwmoQ3QQmtoykBM6jOeic2nWBwdoV5l0T9mFM-MFM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI922mN_pyFkXrxXhTMJxSHgNKt9mpSu861JnAhv6BsHQ&oe=6AAFD44E"}, {"file_name": "2560x1440C.png", "id": "711723874656969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393887_711723877990302_6845402994642399668_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0gBYwVUGMsQ7kNvwFCRSbT&_nc_oc=AdoIq0px6z9VyjriZirWZFqfNZBg4J-xOThAImal3O0INwCg7mXqIqNN14RLjwvbDBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8hMreFtC5rmfVQVShFMt-lpbzcPOTNkMMKJEuydBk9g&oe=6AAFE53B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "599383266500580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821784_599383273167246_7004495289843688357_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXt_bT4EvC4Q7kNvwHAidIc&_nc_oc=AdpQsQx22nK59CQfxlfMc0Zf7EOl6Nhr3GtoCQvMYnhB9rXrkTPsg_Oqv1TiESdO1fk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKs-3bIpG8zA0F8ITakLg29LHRCWdAtntRf691jFO7A5Q&oe=6AAFD20E"}, "display_name": "Classic Music VR - Summer", "keywords": ["experience", "new", "ClassicMusic", "music"], "long_description": "\"Summer\" is an emotional and sensory journey in virtual reality, inspired by Antonio Vivaldi\u2019s celebrated masterpiece. Immerse yourself in stunning natural landscapes as the vibrant notes of the summer season come alive around you.\nThroughout the experience, you\u2019ll be able to interact with paintings that appear along the way, collecting and discovering works inspired by the greatest Italian masters. Every sound and visual detail is designed to draw you deep into the music, letting you experience Vivaldi like never before.\nA poetic and immersive experience, perfect for lovers of music, art, and virtual reality.\n", "short_description": "An immersive VR experience set to the notes of Vivaldi\u2019s Summer, among breathtaking natural landscapes and interactive paintings inspired by Italian masters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrschoolitalia.it/privacy-policy-app-vr/", "developer_terms_of_service_url": null, "publisher_name": "UE5", "support_website_url": null, "website_url": "https://www.vrschoolitalia.it/altri-progetti/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10098018830228316"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1423007712037678"}]}, "baseline_offer": {"id": "1423007712037678"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1746114900, "status": "PUBLISHED", "id": "1423007712037678"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "10098875063476026", "version": "1.0"}, "id": "909542411300174", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"n
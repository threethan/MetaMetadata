com&_nc_ss=7f30f&oh=00_AQWCCY8SQKRXsJFIN8zuhESPQ_ilVp4fBxKFClWHx8lLLA&oe=6B105AFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "599383266500580", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821784_599383273167246_7004495289843688357_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAk-PzRYJMYQ7kNvwHWLN9z&_nc_oc=AdozI-cX7Lv_qyz40hhofnw0kpN-YSoGkuKWH-89GG3U6mswyvTmgY0oQiHqUaFdW9w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUV4SnAOnTJdYPvbvjT1GAMUS1Rernyg8EdNkvwb689dg&oe=6B1047CE"}, "display_name": "Classic Music VR - Summer", "keywords": ["experience", "new", "ClassicMusic", "music"], "long_description": "\"Summer\" is an emotional and sensory journey in virtual reality, inspired by Antonio Vivaldi\u2019s celebrated masterpiece. Immerse yourself in stunning natural landscapes as the vibrant notes of the summer season come alive around you.\nThroughout the experience, you\u2019ll be able to interact with paintings that appear along the way, collecting and discovering works inspired by the greatest Italian masters. Every sound and visual detail is designed to draw you deep into the music, letting you experience Vivaldi like never before.\nA poetic and immersive experience, perfect for lovers of music, art, and virtual reality.\n", "short_description": "An immersive VR experience set to the notes of Vivaldi\u2019s Summer, among breathtaking natural landscapes and interactive paintings inspired by Italian masters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrschoolitalia.it/privacy-policy-app-vr/", "developer_terms_of_service_url": null, "publisher_name": "UE5", "support_website_url": null, "website_url": "https://www.vrschoolitalia.it/altri-progetti/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id"
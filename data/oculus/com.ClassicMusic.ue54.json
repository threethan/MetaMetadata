-gEzv8PRe-gVCXFLTVI7ztDYKAUTRthfIuVE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfHU_KU4QyzoxhkEVIri9D5KvUzjqoF6WGQo9CUGs8cA&oe=6A9C2E0A"}, {"file_name": "2560x1440F.png", "id": "669201935897344", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392000_669201939230677_4439538892134420676_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vge25Yq46H4Q7kNvwFCgSrt&_nc_oc=AdoIRsnrg2eeyx1mBL6hfX8xd4TscIzyeYkOKCo9uRCPwvo_556bxqYQbUuDgdxz1S0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKd9rfLoWLF1DvP3T3wpTNUkmq_Y2wMHE90Zbu1h2CqZw&oe=6A9C0DCE"}, {"file_name": "2560x1440C.png", "id": "711723874656969", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393887_711723877990302_6845402994642399668_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_6atlgvsGEQ7kNvwECKUWr&_nc_oc=Adonepq1yuLoNdWKVm-2zgbjAFDrBDKiOx74qpZxfDxX61irKLNAO13NTEIOJfvpouM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYxRuF-NdeKbiS93ggEOk1faXD_k14W709ni_s9Dddlg&oe=6A9C1EBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "599383266500580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821784_599383273167246_7004495289843688357_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5T62CTsEDUQ7kNvwFmkGrT&_nc_oc=AdrQU126_07g6uG00e1cDPSiN2cPd88zKxpYS3aN8ZmUmJAWWCcZE_kqo0610FMTAGE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5m1AQYZ59iw8SQXNoWmqkEfpF7lvgACu3P_qO_o_H2w&oe=6A9C0B8E"}, "display_name": "Classic Music VR - Summer", "keywords": ["experience", "new", "ClassicMusic", "music"], "long_description": "\"Summer\" is an emotional and sensory journey in virtual reality, inspired by Antonio Vivaldi\u2019s celebrated masterpiece. Immerse yourself in stunning natural landscapes as the vibrant notes of the summer season come alive around you.\nThroughout the experience, you\u2019ll be able to interact with paintings that appear along the way, collecting and discovering works inspired by the greatest Italian masters. Every sound and visual detail is designed to draw you deep into the music, letting you experience Vivaldi like never before.\nA poetic and immersive experience, perfect for lovers of music, art, and virtual reality.\n", "short_description": "An immersive VR experience set to the notes of Vivaldi\u2019s Summer, among breathtaking natural landscapes and interactive paintings inspired by Italian masters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrschoolitalia.it/privacy-policy-app-vr/", "developer_terms_of_service_url": null, "publisher_name": "UE5", "support_website_url": null, "website_url": "https://www.vrschoolitalia.it/altri-progetti/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10098018830228316"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1423007712037678"}]}, "baseline_offer": {"id": "1423007712037678"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1746114900, "status": "PUBLISHED", "id": "1423007712037678"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "10098875063476026", "version": "1.0"}, "id": "909542411300174", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"n
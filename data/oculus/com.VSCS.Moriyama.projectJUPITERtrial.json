 portal.\n\nTrial version: This is a trial version.\nThis is a demo version, but the recorded aspects are new works that are not included in the main version. It can also be enjoyed by those who already have the full version of the game.\n\nFull version: This is a trial version of the full version.\nhttps://www.oculus.com/experiences/quest/5275940062439283\n", "short_description": "This is a free trial version of \"projectJUPITER_a\", a VR giant maze experience!\n\nCurrently, Japanese and English mode is available.\n\nClick here for the full version.\n\nhttps://www.oculus.com/experiences/quest/5275940062439283"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/roukanlien2/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VSC/S.Moriyama", "support_website_url": null, "website_url": "https://sites.google.com/view/roukanlien2", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "TRAVEL", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9693137220736559"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393759_1382261209627531_4171886782346341008_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZhV2kWCaOUQ7kNvwG8C_ze&_nc_oc=AdrTSKfQ58OqX84lKTe9bqf5Uuy0OgDKuDJb5Y-pwD1C1RziYurSQ3qqWn9jlzsqV34&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.co
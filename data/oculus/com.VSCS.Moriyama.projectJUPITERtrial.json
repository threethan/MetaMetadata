0_1362630428425825_9063498959351163276_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oyK-atihloQ7kNvwFe-blg&_nc_oc=Ado2angvxYTtgMJN47VnsxMd9pb6zZ1D9paiDI91ndUIJKPS-9_nFv9YbLfFm72opHE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQec2BURHY_-N2b3lsgniv35if3B4eufB93fBciCEFcUQ&oe=6AFB432E"}, "display_name": "projectJUPITER_t", "keywords": [], "long_description": "Story: In the\nFar in the distant future. Mankind decides to dispatch an Outer Space Diplomat prior to expanding into the outer solar system. Prior to this, special training is conducted in the former Jupiter region. For now, aim for the portal.\n\nTrial version: This is a trial version.\nThis is a demo version, but the recorded aspects are new works that are not included in the main version. It can also be enjoyed by those who already have the full version of the game.\n\nFull version: This is a trial version of the full version.\nhttps://www.oculus.com/experiences/quest/5275940062439283\n", "short_description": "This is a free trial version of \"projectJUPITER_a\", a VR giant maze experience!\n\nCurrently, Japanese and English mode is available.\n\nClick here for the full version.\n\nhttps://www.oculus.com/experiences/quest/5275940062439283"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/roukanlien2/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VSC/S.Moriyama", "support_website_url": null, "website_url": "https://sites.google.com/view/roukanlien2", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "TRAVEL", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_m
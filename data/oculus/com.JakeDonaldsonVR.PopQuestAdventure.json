ds.\n- Save the day.\n- And more!\n", "short_description": "The world is made of balloons and you can pop everything!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8ff0e532-6086-46c0-b244-31eb77715d06", "developer_terms_of_service_url": null, "publisher_name": "Jake Donaldson VR", "support_website_url": null, "website_url": "https://jakedonaldsonvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "796677618908736"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "974243943691271"}]}, "baseline_offer": {"id": "974243943691271"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1698970800, "status": "PUBLISHED", "id": "974243943691271"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6965816990105803", "version": "2.1.1"}, "id": "970780237478256", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6713198148701023", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6965816990105803"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "
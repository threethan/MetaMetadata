7"}, {"file_name": "PopQuestAdventure_Screenshot04.png", "id": "255853247269357", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031459_255853250602690_2611884744295869402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diGnd1neEHAQ7kNvwGx7xJ5&_nc_oc=AdoZoaODhu_pM0IbQukFQb-wuRbgC5rG6HJ0DdjBHgQbd61_XhwiEK0NUrUSW_kzVCU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEikp51XS6EoOGIEoRG3j9AzDOO9RB1eCFNj7IMnuXyZQ&oe=6A8C34AB"}, {"file_name": "PopQuestAdventure_Screenshot05.png", "id": "310187641489818", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974482_310187644823151_3816240313690484442_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcNrkPe8g6EQ7kNvwF3gBvy&_nc_oc=AdqjUobdmFdDc6ETGSsVTGYX5fs0eR71SjANBCN7k9jmrdAGQ74x0qQ4SlCZZ1aWsew&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHx7YHx-kEgQlGFyD03y1bNrw4XTBvKpwXfUj5V4wc7HQ&oe=6A8C19F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PopQuestAdventure_CoverArt.png", "id": "1241192666579469", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982716_1241192669912802_4189831524467082509_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUb7-Z8Z-RgQ7kNvwH1EvLh&_nc_oc=AdqCZqO-IlW6_8lyc9eOm4X-6BzDUXZh1vG_tH-vEScIYrvBK02QVrbHSXZIeR4MW2o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEioEuw936YYv4Pq2d9v1u2Yyi8xh9RUfwH2g-4pwvukw&oe=6A8C1490"}, "display_name": "Pop Quest Adventure", "keywords": [], "long_description": "In this FREE demo experience, embark on a quest through Balloon World as part of the 'Pop Squad', a team of balloon-popping heroes.\n\t\t\nIn Pop Quest Adventure, you can:\n- Pop trees.\n- Pop bees.\n- Pop characters mid-sentence.\n- Pop your way through a hedge maze.\n- Pop treasure chests.\n- Pop purple goop.\n- Pop yourself.\n- Experience state-of-the-art reinflation technology.\n- Glide across ravines with balloon-like weightlessness.\n- Befriend Sheryl the receptionist.\n- Pop evil overlords.\n- Save the day.\n- And more!\n", "short_description": "The world is made of balloons and you can pop everything!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8ff0e532-6086-46c0-b244-31eb77715d06", "developer_terms_of_service_url": null, "publisher_name": "Jake Donaldson VR", "support_website_url": null, "website_url": "https://jakedonaldsonvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "796677618908736"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "974243943691271"}]}, "baseline_offer": {"id": "974243943691271"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1698970800, "status": "PUBLISHED", "id": "974243943691271"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6965816990105803", "version": "2.1.1"}, "id": "970780237478256", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6713198148701023", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6965816990105803"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "
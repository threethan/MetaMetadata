sid=6e7a0a&_nc_ohc=N0rWZjOhxyEQ7kNvwFQxNnr&_nc_oc=AdpAFYk-5O4-CZbi152LxrFk1RXcTCOBTc_DbXCn74Pp4fmT0Mk1bhMLQG7rxri_sVw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6A1KhnbsVMjVqMrd4Co6yiI2o51-6RBTgd0zCuHkLvhw&oe=6A16F750"}, "display_name": "Pop Quest Adventure", "keywords": [], "long_description": "In this FREE demo experience, embark on a quest through Balloon World as part of the 'Pop Squad', a team of balloon-popping heroes.\n\t\t\nIn Pop Quest Adventure, you can:\n- Pop trees.\n- Pop bees.\n- Pop characters mid-sentence.\n- Pop your way through a hedge maze.\n- Pop treasure chests.\n- Pop purple goop.\n- Pop yourself.\n- Experience state-of-the-art reinflation technology.\n- Glide across ravines with balloon-like weightlessness.\n- Befriend Sheryl the receptionist.\n- Pop evil overlords.\n- Save the day.\n- And more!\n", "short_description": "The world is made of balloons and you can pop everything!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8ff0e532-6086-46c0-b244-31eb77715d06", "developer_terms_of_service_url": null, "publisher_name": "Jake Donaldson VR", "support_website_url": null, "website_url": "https://jakedonaldsonvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "796677618908736"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculu
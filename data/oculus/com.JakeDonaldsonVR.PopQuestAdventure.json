fyWGufr_PNsFcrqG-Pzv9ZtFnFgj9aXVY_g&oe=6AFF04B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PopQuestAdventure_CoverArt.png", "id": "1241192666579469", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982716_1241192669912802_4189831524467082509_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9yjyLMCHg4Q7kNvwEp4lRK&_nc_oc=AdrRGXxFdVwSYiVRoEUbNNsxngaYj9ELjO55LLq5d-aE4UjarIfV5NrWS4qzWklBXbQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRu618RorHl8cPByeqWM0jD3bSsa0j_9o2RNT5ClVC31Q&oe=6AFF3790"}, "display_name": "Pop Quest Adventure", "keywords": [], "long_description": "In this FREE demo experience, embark on a quest through Balloon World as part of the 'Pop Squad', a team of balloon-popping heroes.\n\t\t\nIn Pop Quest Adventure, you can:\n- Pop trees.\n- Pop bees.\n- Pop characters mid-sentence.\n- Pop your way through a hedge maze.\n- Pop treasure chests.\n- Pop purple goop.\n- Pop yourself.\n- Experience state-of-the-art reinflation technology.\n- Glide across ravines with balloon-like weightlessness.\n- Befriend Sheryl the receptionist.\n- Pop evil overlords.\n- Save the day.\n- And more!\n", "short_description": "The world is made of balloons and you can pop everything!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8ff0e532-6086-46c0-b244-31eb77715d06", "developer_terms_of_service_url": null, "publisher_name": "Jake Donaldson VR", "support_website_url": null, "website_url": "https://jakedonaldsonvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nul
.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9IcwG1PUoMfDB3rm4PYIHraqHf9QVOcH4G-2r4l3OVA&oe=6A4E5310"}, "display_name": "Cyberblade", "keywords": [], "long_description": "Robots used for military purposes have gone rogue and it's your job to stop them.\n\nGo in with your cybernetic blades, able to slice almost anything in half and face off against massive hordes of evil robot drones. Use slow motion, slice enemies, dodge bullets, do whatever it takes to come out on top.\n\nFeatures:\n- Upgrade and customize your weapon with different blades and materials.\n- Climatic fast-paced battles.\n- Ultra cool slo-mo action.\n- 3 massive arenas.\n- dozens of unique enemies.", "short_description": "You have two swords, use them well"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jeff8921.wixsite.com/website", "developer_terms_of_service_url": null, "publisher_name": "Desmond Lorenzini", "support_website_url": null, "website_url": "https://jeff8921.wixsite.com/website", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1589868444826510"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031344_132018783107356_2946953017922609741_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyCeRq6Oex0Q7kNvwFN7fgW&_nc_oc=AdpDqC3vLxmH--qzZ3LeeClyFy_IwHlkMMdMbbTFDfgn-6uIzvTU2iLApqO8cc1qdMo&_nc
4476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3I0YnKa2gYQ7kNvwFzUJbv&_nc_oc=AdrWLUqfwA4ZZSTpSntsdp1_HLueJh2Wyk1nR1u7n2E7vOvypiJwZlv4U3CnHnVNGwI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrZvU92xV12vDnlRUsJixT_34AFf9jGo2dfgjlLrgMUw&oe=6AEB304D"}, {"file_name": "Sliced-transformed.png", "id": "624897095800775", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982516_624897099134108_997873624282795454_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeWXji4Xc9gQ7kNvwFvs4G6&_nc_oc=AdomfHGt89RcVWWPQ7YEMSeusHkld6Kv3tms8jeFPGlx3J5SZhJL6wmwzjahjhn9RcY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkYgExZ6sgEWqdNkDqTkSwbGfYHEYkeLUhhaBw9UY0yg&oe=6AEB5F1F"}, {"file_name": "Missile.png", "id": "882304069501677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001724_882304072835010_7712348850919765936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxFZoUQLTO4Q7kNvwH29B0U&_nc_oc=Adpwu86znxU4SMHsZI5eDiCPkMQmOXC289EtQMnxyZQ3JyI4zZ_aBi8mNGymiAAXjZY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2JzPuZ9CAa_xWpPdej_JqQQFVONL3bg4zaTEyPaZFDA&oe=6AEB4E3C"}, {"file_name": "Horde2.png", "id": "174492188867191", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75458090_174492192200524_943943141787096518_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uv7e64qOOWwQ7kNvwH5xWb2&_nc_oc=AdqBMe3c_lNE2HSWEXl-bY0fwtaF56EdMZsdDA7KqNSHIN6D9wTCChjg6e9rdWUYbd4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBn8L3mpezsLtQ8dyXxlHh8j01xbEL4YsczOahYlrJYA&oe=6AEB45FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cyberblade Store Landscape.png", "id": "1395930487866035", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031515_1395930494532701_8665082625242115989_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAbfuPqlM0QQ7kNvwHfe0wy&_nc_oc=Adp2-OdFDZDFW6Jmq9ytFcYPNSEdhyDSPbbi2h31sndElRISuvmNL-9mcjMdZn4MeqU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8FYXg8wJkEbe4fKX2Wulx3veF9EO8A3EtRMTbQImixQ&oe=6AEB3590"}, "display_name": "Cyberblade", "keywords": [], "long_description": "Robots used for military purposes have gone rogue and it's your job to stop them.\n\nGo in with your cybernetic blades, able to slice almost anything in half and face off against massive hordes of evil robot drones. Use slow motion, slice enemies, dodge bullets, do whatever it takes to come out on top.\n\nFeatures:\n- Upgrade and customize your weapon with different blades and materials.\n- Climatic fast-paced battles.\n- Ultra cool slo-mo action.\n- 3 massive arenas.\n- dozens of unique enemies.", "short_description": "You have two swords, use them well"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jeff8921.wixsite.com/website", "developer_terms_of_service_url": null, "publisher_name": "Desmond Lorenzini", "support_website_url": null, "website_url": "https://jeff8921.wixsite.com/website", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1589868444826510"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031344_132018783107356_2946953017922609741_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vgx2tAwzSosQ7kNvwFv9OSl&_nc_oc=AdrocV4_tTFaWWsl8RIzDXShLSOGT9sC2b5faE50wzYGS8nCfewiM8asKHHniF5_PVs&_nc
4476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKZfe4qzRJsQ7kNvwGuei8t&_nc_oc=Adpp3hKynPRTR-oDdmg7KR1ireO7v_Att0bfnOFib1pBOlgjbniOzrkmg_RwkLpeDYU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADnBQ4gbiRdGxF6rdGnJLsPykl4oZqtu-vDJ2CwB8DAQ&oe=6A6608CD"}, {"file_name": "Sliced-transformed.png", "id": "624897095800775", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982516_624897099134108_997873624282795454_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wyEnA_RnmcQ7kNvwGLmGqu&_nc_oc=AdqYMpvHHxO63j3tvllHRG28Se30YblyiR_t0U1RN9E2M6gv1_8-dAMpyh3ErPzB678&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCh3Y7AlRf9_xMZqJWXrMhbrbdvf61RShiEBU73nGVGtw&oe=6A65FF5F"}, {"file_name": "Missile.png", "id": "882304069501677", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001724_882304072835010_7712348850919765936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ci6cTVlNoYQ7kNvwHBHO_o&_nc_oc=AdoEyDskJiUd5R71iefhhIDw9s22L-TIlDmpc51SMaoVl-muumyKb26P9i4qcM8wemU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoLf-3-vOiLKa2cTvLddroUJFMzHIF4Zk2i91ewP7ikA&oe=6A6626BC"}, {"file_name": "Horde2.png", "id": "174492188867191", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75458090_174492192200524_943943141787096518_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDCxk7CXHXUQ7kNvwHA_BfE&_nc_oc=Adrue0W7gRfcEaUN4t29DhJbbGJ1_oabU9yMlwuN_bFs375RbvhpIvuEob1gtjoyTJg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoA4W-_gAAhxa9OSOaBlU3EM2MHrfszIHVzqqTnmfv3Q&oe=6A661E7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cyberblade Store Landscape.png", "id": "1395930487866035", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031515_1395930494532701_8665082625242115989_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KmYu5Vx2NMQ7kNvwEI8E5Q&_nc_oc=AdrTf6c-nhf2GKo5J0JsozC31b9VDfBmkpzC19QbfJqEEilBYRpsbaaMGMcxTw2ANzM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2C7vhiPqoEeLC3YkJdLsdb5bHD9VAVdbBOLMSFvPDYw&oe=6A660E10"}, "display_name": "Cyberblade", "keywords": [], "long_description": "Robots used for military purposes have gone rogue and it's your job to stop them.\n\nGo in with your cybernetic blades, able to slice almost anything in half and face off against massive hordes of evil robot drones. Use slow motion, slice enemies, dodge bullets, do whatever it takes to come out on top.\n\nFeatures:\n- Upgrade and customize your weapon with different blades and materials.\n- Climatic fast-paced battles.\n- Ultra cool slo-mo action.\n- 3 massive arenas.\n- dozens of unique enemies.", "short_description": "You have two swords, use them well"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jeff8921.wixsite.com/website", "developer_terms_of_service_url": null, "publisher_name": "Desmond Lorenzini", "support_website_url": null, "website_url": "https://jeff8921.wixsite.com/website", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1589868444826510"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031344_132018783107356_2946953017922609741_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTcI013-wGEQ7kNvwHUOitO&_nc_oc=Adok3mbofAU2lMyyp-6DNJMNU4f3pqgJVhg_UwQ6evgNoAxnB6o_yf-IcRcvUbpHt0c&_nc
4476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gn3miepOvrYQ7kNvwGZ_gS0&_nc_oc=AdoD8o7Dh4x32GGyrgg9081JMEZcY1DmgAlZnwNyhtu2XfsVQu9kWm4yc-ErqTd-Zcw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzoKs0Nr6III57-0H1ykOrb7EERWpXNaCLMdxRBVgLYyg&oe=69CA77CD"}, {"file_name": "Sliced-transformed.png", "id": "624897095800775", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982516_624897099134108_997873624282795454_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdQsAtOaw1AQ7kNvwEkxgy2&_nc_oc=AdrTdmj0kmc5NlLv93ACdJkZt09xcu1vj8QpEq8N2SvUAN7w-0b8gobh-yYqfy0JDzg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_1_4laN98wEEm-xA40hG08eN_VTkaa_TO8ZZpF-CIcQ&oe=69CA6E5F"}, {"file_name": "Missile.png", "id": "882304069501677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001724_882304072835010_7712348850919765936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZSPqoLNDkoQ7kNvwHrVZis&_nc_oc=AdorvaFtFw2lUWDVgBp_vz6rBVKY1Y5_4NJrBXCsqhgfq51mE8HJSDkmaYAZgPGbM9E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJPCsiZaOs7-nmmlXk43E8AMcfG9j8wa6j3kqOj3GvXQ&oe=69CA5D7C"}, {"file_name": "Horde2.png", "id": "174492188867191", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75458090_174492192200524_943943141787096518_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gcrCFTHoFcQ7kNvwErogMJ&_nc_oc=Adrq3aH83gNMNs9jMrGM3wspdlyzGIzPAPr9_Tcqth_7DWFGYGY2lG-meORhjk6f5jA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyp5u-Da2SrEmHrJxKFxKkhprGKgvdyhG2k5Ehw2by5Ag&oe=69CA8D7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cyberblade Store Landscape.png", "id": "1395930487866035", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031515_1395930494532701_8665082625242115989_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qC2E8rzOsaQQ7kNvwEucUzs&_nc_oc=AdoVmXdXGnHdio5R8FsiKac7lvIfiUdgBW3XIVomdzZRKH_y9179BAl1EFnK83IIP70&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxqUNWv43FIW9PSpL8iyqV1mzBKRzwS1RtIrG_XxNMOQQ&oe=69CA7D10"}, "display_name": "Cyberblade", "keywords": [], "long_description": "Robots used for military purposes have gone rogue and it's your job to stop them.\n\nGo in with your cybernetic blades, able to slice almost anything in half and face off against massive hordes of evil robot drones. Use slow motion, slice enemies, dodge bullets, do whatever it takes to come out on top.\n\nFeatures:\n- Upgrade and customize your weapon with different blades and materials.\n- Climatic fast-paced battles.\n- Ultra cool slo-mo action.\n- 3 massive arenas.\n- dozens of unique enemies.", "short_description": "You have two swords, use them well"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jeff8921.wixsite.com/website", "developer_terms_of_service_url": null, "publisher_name": "Desmond Lorenzini", "support_website_url": null, "website_url": "https://jeff8921.wixsite.com/website", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1589868444826510"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031344_132018783107356_2946953017922609741_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vsf2N-ktXzQQ7kNvwHGLmBt&_nc_oc=AdoIlCRSqkyzy4C2FIMW2C5HiPIxJ2UTPqTr6ru2GR-oJYonVnOOUnNAHaS2qyHP-dI&_nc
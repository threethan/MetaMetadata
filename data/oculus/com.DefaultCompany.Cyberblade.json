4476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12f2yH8ChSAQ7kNvwHQkpWX&_nc_oc=Ado45Vt10R0uzshqw2rxW9Hk96M-nVs7uWG-nTQFEuQn1MZQf0FjtdIcGH5kEsX3DhE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uUXZdNW2Dh-eFEocYC6d6fISIZ0wMoIwXCRCFYz29ag&oe=69FDE24D"}, {"file_name": "Sliced-transformed.png", "id": "624897095800775", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982516_624897099134108_997873624282795454_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naBKlvbiQdUQ7kNvwFzKdg8&_nc_oc=Adr0aLq57IEegwlYYj4QUh1ldV0ODp-QGTVTdjdfwGQrhp38N4aew7Q-W8zAIx9yaYg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_H4_9FP29KrmVwLt-hJkTq_dTjyU8j6WznJw7U5HoHw&oe=69FDD8DF"}, {"file_name": "Missile.png", "id": "882304069501677", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001724_882304072835010_7712348850919765936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYXZEGFT7V8Q7kNvwH92UPP&_nc_oc=AdraXrouXKsmgTnykszP2aAu53js-SVVBZNf5xnM6wvoLUHaffbKQIcP5uDmApC3iVM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qBKVo22HtAYQAUGih_b9a02wt3uEXUJ1B3KrEVDUO3w&oe=69FE003C"}, {"file_name": "Horde2.png", "id": "174492188867191", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75458090_174492192200524_943943141787096518_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihmCcsVa34AQ7kNvwE_nlEH&_nc_oc=AdrDvIT2U6dhMmF8IV_4oGsmgpEvlYfUVpbQmIrqSb-ys9CjOAk6XDRo8-OiA2f2-_Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ya5nj9FTRteEWQrhV8QAOmC9gmzHWiyQzSGtFzQXv5Q&oe=69FDF7FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cyberblade Store Landscape.png", "id": "1395930487866035", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031515_1395930494532701_8665082625242115989_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtfRcJapukAQ7kNvwEK9iMa&_nc_oc=AdofaaYzGSX2ejtBUTvp60x7x3iB-0BNUUwfiEx56bEdDf13IEfCDD-B9H369O3iz0I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5S9SNh4xYcHTTPU4Q_DZyp48s2x8WZMmWxUUeQShnXXQ&oe=69FDE790"}, "display_name": "Cyberblade", "keywords": [], "long_description": "Robots used for military purposes have gone rogue and it's your job to stop them.\n\nGo in with your cybernetic blades, able to slice almost anything in half and face off against massive hordes of evil robot drones. Use slow motion, slice enemies, dodge bullets, do whatever it takes to come out on top.\n\nFeatures:\n- Upgrade and customize your weapon with different blades and materials.\n- Climatic fast-paced battles.\n- Ultra cool slo-mo action.\n- 3 massive arenas.\n- dozens of unique enemies.", "short_description": "You have two swords, use them well"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jeff8921.wixsite.com/website", "developer_terms_of_service_url": null, "publisher_name": "Desmond Lorenzini", "support_website_url": null, "website_url": "https://jeff8921.wixsite.com/website", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1589868444826510"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031344_132018783107356_2946953017922609741_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyzLzW16jLYQ7kNvwGCe_XJ&_nc_oc=AdrL6XVPgFapLjk8rsYR9xN676aXmL_h9-8uceOG9644ciNL7BRJHeZxsLULe77uuos&_nc
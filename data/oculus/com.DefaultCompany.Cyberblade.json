4476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3etTol9X78cQ7kNvwFBl-3p&_nc_oc=AdrLNaZdWBEl5E9YyACK7fj4zbJMcnxQ-wl3fSRgcf78eaEPpt7Ru4owq1oLOGcJwiM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rTI4aw4HgcqblEiZCOAa0G4e-yYplwq_cvtTm2cMviA&oe=69DCECCD"}, {"file_name": "Sliced-transformed.png", "id": "624897095800775", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982516_624897099134108_997873624282795454_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIesfvM7CcsQ7kNvwFdl4j4&_nc_oc=AdoAARGly1WjxHMwyuhIDRAHYRJHj5anFlraxA-n42ROg2Cu66rHfHkkuu713l223y8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0T3Aji2aGTzefLEQtm-Pf6DnEP3Okkc0pHKiAK_FpXDQ&oe=69DCE35F"}, {"file_name": "Missile.png", "id": "882304069501677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001724_882304072835010_7712348850919765936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1Z6NpCVd_AQ7kNvwEYz0qD&_nc_oc=AdqVHQijlxxikLGYQzvcuxysbQDzIP5a4YsDel7OKmGdeWxAZxR7jpwyX4FDfswwaBg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08-O9m_yX7NytEbikiJa6TKr1yvIv8VqW-ZnKsnMwoLg&oe=69DCD27C"}, {"file_name": "Horde2.png", "id": "174492188867191", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75458090_174492192200524_943943141787096518_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUNhevqF6AQQ7kNvwEb59jT&_nc_oc=AdpW7qPuWet_sM8AGPDHQSXicfHU-jno7OwZO_HpYb5yPKcFXNx7_UZ4tPkmv3Hz78w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UrL-zsp1gW4tQFlL4QOUUh_hGhPjy436aQABapjL7qw&oe=69DD027F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cyberblade Store Landscape.png", "id": "1395930487866035", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031515_1395930494532701_8665082625242115989_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6YEWuKKFFoQ7kNvwFSKwhl&_nc_oc=AdpnU9D64MAHcFOQyHoXrP9GeotOq_xlHdVMenio-kc2Z4oN6IJ9ibXE9sqO_LKELCw&_nc_zt=3&_nc_ht=scontent-ord5-2
4476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gS7Hm02MLcQ7kNvwFTTGkx&_nc_oc=AdoDd21Bd2nn1dvSa5lU6uk0Ci64ll4QJFHz80UwND79Z1fsf-2JV8zsL_URClY_6Nk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeCNjZaahKWRS3yLzhK0Z5WCZoiV_04ylX4SQ3-KhgOQ&oe=6AEE0B8D"}, {"file_name": "Sliced-transformed.png", "id": "624897095800775", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982516_624897099134108_997873624282795454_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aD8gPWL7U84Q7kNvwENCG7w&_nc_oc=AdpnxaYLHVOPESJ0p59p8t3IApx_jx6Mv343gAPkVXut4kuMP0CBRgy9UdWxCY9_OiM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVWdZz4a_ZK_SN0CeZ8RwhSWHke5T2vM-fFO9QCCdHvA&oe=6AEE021F"}, {"file_name": "Missile.png", "id": "882304069501677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001724_882304072835010_7712348850919765936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXxFMRO8D_0Q7kNvwFEBnCC&_nc_oc=AdpuASWuzmRlZDVRAniM3YAToVmBsCnZVGSn2xM6rCKU8GfCRJfQw7kG1KO-m0hxq8I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0Xxl-97e8Parmqx85ohDiVMSsm0GXLlwahrQyZZD92w&oe=6AEDF13C"}, {"file_name": "Horde2.png", "id": "174492188867191", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75458090_174492192200524_943943141787096518_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=secTrWId5VkQ7kNvwFDBGtv&_nc_oc=AdpMzAcdhqZVU20u7LfAcqFlMOR5boGnpobzxDxYlNTqlMtNNBF_yxTIV8gS6wnHve8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSY7zUahK4dHvSUb8u9CAoUXkx5ug2_5MlDppb2OVjwQ&oe=6AEDE8FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cyberblade Store Landscape.png", "id": "1395930487866035", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031515_1395930494532701_8665082625242115989_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAbfuPqlM0QQ7kNvwHtUFrV&_nc_oc=AdoWEBglGwO448s90j1ueUcHLV8xSWs6rSc7a7LYKWj1w3JJI7eu_VRmlmEpJ_GJiAA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSH0b9mrEskhMxB3DT5-6koEj0xIRjiy3dd_bUkyThI6Q&oe=6AEDD890"}, "display_name": "Cyberblade", "keywords": [], "long_description": "Robots used for military purposes have gone rogue and it's your job to stop them.\n\nGo in with your cybernetic blades, able to slice almost anything in half and face off against massive hordes of evil robot drones. Use slow motion, slice enemies, dodge bullets, do whatever it takes to come out on top.\n\nFeatures:\n- Upgrade and customize your weapon with different blades and materials.\n- Climatic fast-paced battles.\n- Ultra cool slo-mo action.\n- 3 massive arenas.\n- dozens of unique enemies.", "short_description": "You have two swords, use them well"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jeff8921.wixsite.com/website", "developer_terms_of_service_url": null, "publisher_name": "Desmond Lorenzini", "support_website_url": null, "website_url": "https://jeff8921.wixsite.com/website", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1589868444826510"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031344_132018783107356_2946953017922609741_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGbCrneXyV8Q7kNvwFTYdbh&_nc_oc=Adoy7keBsnOBpeF_0N9Pc9HKuNeJF7YsCRKc54TzDnRsw3ws8xdux77_O9baOfER38Y&_nc
4476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5HwrdPXIb8Q7kNvwH7BFxp&_nc_oc=AdqkP2A2lCa-wYghrqvEkfGu4AgREOvq_qV81RNPyrXFSj_BptLfxSkOh7Yoi8RZwSE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SwggC4gTXoW1N_Vhtp8Fh4JKLhBuv83-a92nFqLZQyg&oe=69E232CD"}, {"file_name": "Sliced-transformed.png", "id": "624897095800775", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982516_624897099134108_997873624282795454_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEtmB8ChFzIQ7kNvwHwZG3w&_nc_oc=AdpImJu8wb0zm6q9lwnd--MNou8X452Dq7dakFNJVInuOjPwGes7qWCYhiV7i30-Lm4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0asg0my-rjTNzwkB-s43u2SMYUw_zsb-8thPBjUT9bUA&oe=69E2295F"}, {"file_name": "Missile.png", "id": "882304069501677", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001724_882304072835010_7712348850919765936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpgiYrxL-rQQ7kNvwFSKZUS&_nc_oc=AdpBw4vCSnKEqICKhrhR_cC8eLPUmamqJXH3XGDqr6ua_B3_EuCw7N7ebx35rSjoS9k&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af345MbTn9TpuFIDDvmwPSW3gUCv6VAGntt7rYMd6sYDBQ&oe=69E250BC"}, {"file_name": "Horde2.png", "id": "174492188867191", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75458090_174492192200524_943943141787096518_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFRdlxUCBuoQ7kNvwEsu7yY&_nc_oc=AdrRdVcmWU_WqdBEhOhytuhrQw7tGyasbTfucF07-5P7vpIf_ss-JrPWrRTw9OKBL_8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wzDKJR26rajwnkJVci2dV27KNM13ApeAVUddfJ_ykrg&oe=69E2487F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cyberblade Store Landscape.png", "id": "1395930487866035", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031515_1395930494532701_8665082625242115989_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4T7uiNZTXjEQ7kNvwGvoznv&_nc_oc=Adoz4zFycfUPhyhIBARwe8-huC0ffFmbCENgN7B0FgIvOZP3fxPTO0gSKssQuy1ld1s&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31_H_RlhVGDWl3j9Ma4KV1P56mP9VtfWxNIV23rs8hyg&oe=69E23810"}, "display_name": "Cyberblade", "keywords": [], "long_description": "Robots used for military purposes have gone rogue and it's your job to stop them.\n\nGo in with your cybernetic blades, able to slice almost anything in half and face off against massive hordes of evil robot drones. Use slow motion, slice enemies, dodge bullets, do whatever it takes to come out on top.\n\nFeatures:\n- Upgrade and customize your weapon with different blades and materials.\n- Climatic fast-paced battles.\n- Ultra cool slo-mo action.\n- 3 massive arenas.\n- dozens of unique enemies.", "short_description": "You have two swords, use them well"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jeff8921.wixsite.com/website", "developer_terms_of_service_url": null, "publisher_name": "Desmond Lorenzini", "support_website_url": null, "website_url": "https://jeff8921.wixsite.com/website", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1589868444826510"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031344_132018783107356_2946953017922609741_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vPJs3IeTmYQ7kNvwHhtNcT&_nc_oc=AdqYiseeBorUzHWTSUvNRoqR4EdDGiGl1KPv5qXKxerMD5u__UVSD20TX0O6drejFIM&_nc
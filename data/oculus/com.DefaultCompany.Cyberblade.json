4476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TefAR_Wk1YkQ7kNvwEEQ6sn&_nc_oc=AdqjEVvSkdv7TE1oHlyqSsDG1OwAZp2wiAqHlt0x071XCS43h7SRlwFRNTwz3gaqx2w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tXm3s5O6VpOJrTc0eood73y3xGp3a9wYbHd3HADhbgw&oe=6A2D584D"}, {"file_name": "Sliced-transformed.png", "id": "624897095800775", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982516_624897099134108_997873624282795454_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBeChKdbCqAQ7kNvwGwZC2w&_nc_oc=AdrcvBh2S7697DZBeZ9LqxXm0Cw3ScI998D-HKPsvIeoajAnEdL51HJH3UUit6gyiwI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GCLoTd7NSDZk2XcQP3GjWEFTG1_sEiUVckPbPW3rKGQ&oe=6A2D4EDF"}, {"file_name": "Missile.png", "id": "882304069501677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001724_882304072835010_7712348850919765936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OspZFObPekMQ7kNvwFESQnn&_nc_oc=AdozWcKzTyph9H5pih4NN76f91ykq8wje-9Xm5b8E9EAbi5favf-4w1x0PtwktA48GE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ie6m_riFV74LqzsE3KpifDBeqYLrPmFQPGRH8rrhPjQ&oe=6A2D763C"}, {"file_name": "Horde2.png", "id": "174492188867191", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75458090_174492192200524_943943141787096518_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gODRI-RY_OYQ7kNvwFe8VKD&_nc_oc=Adqn0SjVOgV5hMdca4-JlbtkhmxmaHovUPWiXeGQbjb6alUGYuuOqa89DeyR2IIkXDk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1hYBckrAea7qPlMyXhrtlWXMxWyZpi2h8n9WWGSodPA&oe=6A2D6DFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cyberblade Store Landscape.png", "id": "1395930487866035", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031515_1395930494532701_8665082625242115989_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gWEAPACL68Q7kNvwHaB55n&_nc_oc=Adr9Y55YhibhWiPP2rmW2_QhkimPKmXZwlPANFmxG_tUlOLvkgDNUp3goithT9Kc8_U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-X4dwYCUMOB1kyqNyr3iYZ0f3t-JmnU677cxM14JMvA&oe=6A2D5D90"}, "display_name": "Cyberblade", "keywords": [], "long_description": "Robots used for military purposes have gone rogue and it's your job to stop them.\n\nGo in with your cybernetic blades, able to slice almost anything in half and face off against massive hordes of evil robot drones. Use slow motion, slice enemies, dodge bullets, do whatever it takes to come out on top.\n\nFeatures:\n- Upgrade and customize your weapon with different blades and materials.\n- Climatic fast-paced battles.\n- Ultra cool slo-mo action.\n- 3 massive arenas.\n- dozens of unique enemies.", "short_description": "You have two swords, use them well"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jeff8921.wixsite.com/website", "developer_terms_of_service_url": null, "publisher_name": "Desmond Lorenzini", "support_website_url": null, "website_url": "https://jeff8921.wixsite.com/website", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1589868444826510"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031344_132018783107356_2946953017922609741_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_pQx7fV4BkQ7kNvwHxjPsb&_nc_oc=Adqi2EyS9DMRY1cFgDbmtfBb57pjhoYUmqVRBpKQuTEMqWVMYmysVFZomSEeHgL1d3Q&_nc
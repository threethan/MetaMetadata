4476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WKaWoYUkjMQ7kNvwFy38Oc&_nc_oc=AdoJip1X7ba3Wf4mnl0WZljPe0pH7dgA1UMXg2w8XwIdCCyMqxdkWtQcrnw4GXphnS0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9yMVOy2u9YuC3pV4U4x9esT__dys4ftZllzlqjrXjCw&oe=6A6B4ECD"}, {"file_name": "Sliced-transformed.png", "id": "624897095800775", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982516_624897099134108_997873624282795454_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsYqQcBJUMIQ7kNvwEQ2tVR&_nc_oc=AdqqWgcyGPWtU-HvhHd6fAueTBlNO-HXeHx1qJSMTG_quGvEdvByd68oFPvRKJrxrlo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAplUSCuph_tTV3twNGrXmEKxJoF8-MVX0JBpqcExaNTQ&oe=6A6B455F"}, {"file_name": "Missile.png", "id": "882304069501677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001724_882304072835010_7712348850919765936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clcn9lpUvSIQ7kNvwH6y7i3&_nc_oc=Ado6xqDwhN0_MO4I4qOZfJHv1ilzqbWw6FuqPhiiSZo9K4OmMHC81x865i6V0pJWsr4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnECgiY58cWUvG0Qowr0_CIiS21nfLCmZfR07JszJ7Tg&oe=6A6B6CBC"}, {"file_name": "Horde2.png", "id": "174492188867191", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75458090_174492192200524_943943141787096518_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Uf4rFsxnJgQ7kNvwGErGM-&_nc_oc=AdoJvWj6G3e__KG5-AwVZj9Os-7ogr0Ev6Coi0C4lMsd5C1K37Bt7mQq6fsWZY79vg4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXjEX_Xch4f9YgHa_DllIWw9-qzBZ383ropxIyaHSTgQ&oe=6A6B647F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cyberblade Store Landscape.png", "id": "1395930487866035", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031515_1395930494532701_8665082625242115989_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9QvrS-6VIEQ7kNvwGpabm9&_nc_oc=Ado-fnUJUxfHypxyjqt9C1-XewB7KDr5-CEjP55YJHgBINkAxF_0l-ZHm6RZINBYJpU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBS1T6UbX5KvG9H6hdTs9oTTXxQhXZ7hpzF7h5iHGRgEg&oe=6A6B5410"}, "display_name": "Cyberblade", "keywords": [], "long_description": "Robots used for military purposes have gone rogue and it's your job to stop them.\n\nGo in with your cybernetic blades, able to slice almost anything in half and face off against massive hordes of evil robot drones. Use slow motion, slice enemies, dodge bullets, do whatever it takes to come out on top.\n\nFeatures:\n- Upgrade and customize your weapon with different blades and materials.\n- Climatic fast-paced battles.\n- Ultra cool slo-mo action.\n- 3 massive arenas.\n- dozens of unique enemies.", "short_description": "You have two swords, use them well"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jeff8921.wixsite.com/website", "developer_terms_of_service_url": null, "publisher_name": "Desmond Lorenzini", "support_website_url": null, "website_url": "https://jeff8921.wixsite.com/website", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1589868444826510"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031344_132018783107356_2946953017922609741_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ge4D-T8AnzkQ7kNvwGNpDir&_nc_oc=Adp3XAmx6k6PRP_NA0mjLEBHQmY-vFzOqYtY_zxE3yTaLFSCQHCdLSt7SKsZgXkm-io&_nc
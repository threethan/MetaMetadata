4476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNtfPCrBN8EQ7kNvwECEGZ2&_nc_oc=Adrrh1aWXRGuqZzrLOUgCK39jCraILTM1vdZSaFFMU9nsw8LvmycGsp1blfZ7Bj59GQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FTckOLDBBpWa6XJF2drzOT4zSwO7FsRRgFq8VdFNisg&oe=6A0DB44D"}, {"file_name": "Sliced-transformed.png", "id": "624897095800775", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982516_624897099134108_997873624282795454_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50QGzkEIr1gQ7kNvwFIrqzw&_nc_oc=AdoP0WTkLnwroUUg2pGVtWBgG80yPkSKhsJjC-UuLD8eMoWVJcfOl4lm2FfG2FKSNUE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Sa3CO_xbDwqRN0e-2q-VHvLdyoWMs3MGSYuhqxvlVEw&oe=6A0DAADF"}, {"file_name": "Missile.png", "id": "882304069501677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001724_882304072835010_7712348850919765936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zFarKoTJ2EQ7kNvwH9ktdc&_nc_oc=Ado5LOOcNbis6B0fOkAiXOfGZ5QrAPnns1nqMhaJMX_09PZPSwP_E20CWgEaxPYggcA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7l_wLN-vy2iYE8zafigFejyDAMcdzj2qhIuMQr5aKc1A&oe=6A0DD23C"}, {"file_name": "Horde2.png", "id": "174492188867191", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75458090_174492192200524_943943141787096518_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umNK5ZKruykQ7kNvwGB-Kdv&_nc_oc=AdrrGIx6l1ce75sseiWYu4EAOFudHlTniCn_hXtKK2pm59tRsPkg6-K2eudeokcUFOs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FbwjaJyPRbdTeWe3c5NEnSjy5dMv2wmOVaEPpKrpDuQ&oe=6A0DC9FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cyberblade Store Landscape.png", "id": "1395930487866035", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031515_1395930494532701_8665082625242115989_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxGzNZBRG6QQ7kNvwFXY8Cd&_nc_oc=Adr4y0PX45OShCKU59ck3s3cjRRVonQkzN_daza6k5rNuVTm7rOMOcoPEcs19BeLCxs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Wj5oD4yNLuypnh2ofm0ekW7bNMC5NafTsTY23Ek9v0Q&oe=6A0DB990"}, "display_name": "Cyberblade", "keywords": [], "long_description": "Robots used for military purposes have gone rogue and it's your job to stop them.\n\nGo in with your cybernetic blades, able to slice almost anything in half and face off against massive hordes of evil robot drones. Use slow motion, slice enemies, dodge bullets, do whatever it takes to come out on top.\n\nFeatures:\n- Upgrade and customize your weapon with different blades and materials.\n- Climatic fast-paced battles.\n- Ultra cool slo-mo action.\n- 3 massive arenas.\n- dozens of unique enemies.", "short_description": "You have two swords, use them well"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jeff8921.wixsite.com/website", "developer_terms_of_service_url": null, "publisher_name": "Desmond Lorenzini", "support_website_url": null, "website_url": "https://jeff8921.wixsite.com/website", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1589868444826510"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031344_132018783107356_2946953017922609741_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gE1mz9Xdrl8Q7kNvwFvL2Hk&_nc_oc=Adq4-toiF8aZ7RqofciT1ZRNHp3-XV32695x7K9cB3pxP5kzVD-kdJYknPhJXWBMYps&_nc
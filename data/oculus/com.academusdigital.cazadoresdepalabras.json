n.com&_nc_ss=7f30f&oh=00_AQTWhZ11dletrDQfsw3AdHjU-SOnKBsqbdV6Rv-ViubO7g&oe=6B0B2345"}, {"file_name": "ab0b8689-bdd3-49b8-a9af-ff8ee7e2ab5f.png", "id": "1629301825228264", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823802_1629301828561597_7943475945015739107_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uYI7gSsrxMQ7kNvwHE6d_J&_nc_oc=AdqEsOlJkl7yio3nqaUrXWcTXFG8iG0gSb5OWS4W8CHMjOgMdXki189yBV7zLKHRmPY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRAP08OcGfgo7mwBOKNaiAaIkqRgitD8u_u_HYP-IJ4lA&oe=6B0B1F7A"}, {"file_name": "7.png", "id": "3558552690974578", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/654867655_3558552694307911_4999883974959228705_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oruakA9egE4Q7kNvwH4MGzy&_nc_oc=AdrizFZQ3ETvW7mm4fiQ7Oj9CTvNmZ0lh6zhRphWz_-3p1YHcHitIftr1NQ3e2Syx04&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTHQeM7w4duD2wwx2CXEs0-qS3bSAAVo2cXSjw5ZqCWXg&oe=6B0B33B6"}, {"file_name": "6.png", "id": "1668618567960543", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499312231_1668618571293876_4628310966439453883_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7l2QbpAouUQ7kNvwH-wbxc&_nc_oc=AdohSYgg4nob70KwGE8K1TubhcGqxl6ScOpNtkSSikWWYlfHJkZyBO2t77GVObKHUhA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ1lDV0zQIXATyIqE3ZaLe6uM0fIPeb_vMxVMZlJ2EL-A&oe=6B0B379A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cazadores de palabras", "keywords": ["palabras", "lectura", "espa\u00f1ol", "educaci\u00f3n", "vocabulario"], "long_description": "\u00a1El Viejo Oeste te espera con un desaf\u00edo de palabras!\n\nCazadores de palabras es un juego educativo de realidad virtual en espa\u00f1ol. Recorre el escenario, observa las palabras y selecciona las que cumplen el objetivo de la partida. Presta atenci\u00f3n: tambi\u00e9n encontrar\u00e1s palabras trampa.\n\nComienza con un tutorial guiado con narraci\u00f3n para conocer la din\u00e1mica y practicar antes de jugar. Tambi\u00e9n puedes omitirlo y entrar directamente a la partida.\n\n\u2022 Practica el reconocimiento de palabras en espa\u00f1ol.\n\u2022 Explora un escenario ambientado en el Viejo Oeste.\n\u2022 Consigue estrellas y consulta tus resultados.\n\u2022 Reinicia la partida para volver a intentarlo.\n\u2022 Despl\u00e1zate y gira con los joysticks de los mandos.\n\nIncluye pausa y salida con confirmaci\u00f3n. La interfaz y la narraci\u00f3n est\u00e1n en espa\u00f1ol.\n", "short_description": "Explora un pueblo del Viejo Oeste y pon a prueba tu reconocimiento de palabras en espa\u00f1ol. Encuentra las palabras correctas, evita las trampas y consigue estrellas en una experiencia educativa de realidad virtual con tutorial narrado.\n"}, {"images": {"nodes": [{"file_name": "vertical.png", "id": "2576612222811754", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499296069_2576612226145087_5226927813653137986_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Msdx-N_d0yoQ7kNvwEwZqP5&_nc_oc=AdoRez4cvBXhypY8TlhfeoKT957OPlqq-Bbmqlg4OatgU6wmt0ICzqFOxu8g5M4CGdo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRbyPXsEYzpaev1BbcqdZZHtTA3uliA19DHmiFlINwbag&oe=6B0B2475"}, {"file_name": "Portada principal.png", "id": "1763368964902628", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307309_1763368968235961_3289402828568322746_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3R6P7Pl_TAQQ7kNvwG58g6w&_nc_oc=AdqkBp9doVxBstNMsl38EF4XRY84jGsA-1ku1pA4SxcCCqq52XkPXCyb3OUtQj2io4I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ8BiEP0279ZBS-3N0N9fN-GxXFsmjKEP4ZbOmWKzZsKA&oe=6B0B3483"}, {"file_name": "Horizontal.png", "id": "1334858198512779", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri
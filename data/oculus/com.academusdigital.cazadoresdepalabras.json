n.com&_nc_ss=7f20f&oh=00_AQTY60uQMusUKxYGJq1rJRvKvpObZdRQivvwkWb9XhEFbg&oe=6B045385"}, {"file_name": "ab0b8689-bdd3-49b8-a9af-ff8ee7e2ab5f.png", "id": "1629301825228264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_1629301828561597_7943475945015739107_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SBiAEgp4kgQ7kNvwEGcGA6&_nc_oc=AdoVMzFOU6_bEuzzVIxVGDIfNSLoEAK1MJQ0Fx1SHnF1tTBkSWsE1isT2iqfS5r0Pcc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJiZxS5JZvAU773xypwncdhTrAEP_5PHbjwnj6aPsQWA&oe=6B0487FA"}, {"file_name": "7.png", "id": "3558552690974578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/654867655_3558552694307911_4999883974959228705_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9BQ91I94-kQ7kNvwFPQb9b&_nc_oc=Adrb6w2bHiL3Rfhd9DiXpkTuGAOVPwoky53T-SGVcHW-kpttfDlv0XG0J7KP9zqBEEw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjfDLyrVT7hMxYsWC7adBvzDyysJGZmkL5reL0dWtvpQ&oe=6B0463F6"}, {"file_name": "6.png", "id": "1668618567960543", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312231_1668618571293876_4628310966439453883_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuSKVDCO6aYQ7kNvwG5jEau&_nc_oc=AdpZpD_qBS_N37XKVDS6Ymt8Z82Z4HgV2qs1V_R9kXdrJa4JxwUCG2sYa_iAqtKWudw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUT8DSlhcFjSUI2PdyR5colS6ahd2c8_uYKrrg8gIZNA&oe=6B0467DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cazadores de palabras", "keywords": ["palabras", "lectura", "espa\u00f1ol", "educaci\u00f3n", "vocabulario"], "long_description": "\u00a1El Viejo Oeste te espera con un desaf\u00edo de palabras!\n\nCazadores de palabras es un juego educativo de realidad virtual en espa\u00f1ol. Recorre el escenario, observa las palabras y selecciona las que cumplen el objetivo de la partida. Presta atenci\u00f3n: tambi\u00e9n encontrar\u00e1s palabras trampa.\n\nComienza con un tutorial guiado con narraci\u00f3n para conocer la din\u00e1mica y practicar antes de jugar. Tambi\u00e9n puedes omitirlo y entrar directamente a la partida.\n\n\u2022 Practica el reconocimiento de palabras en espa\u00f1ol.\n\u2022 Explora un escenario ambientado en el Viejo Oeste.\n\u2022 Consigue estrellas y consulta tus resultados.\n\u2022 Reinicia la partida para volver a intentarlo.\n\u2022 Despl\u00e1zate y gira con los joysticks de los mandos.\n\nIncluye pausa y salida con confirmaci\u00f3n. La interfaz y la narraci\u00f3n est\u00e1n en espa\u00f1ol.\n", "short_description": "Explora un pueblo del Viejo Oeste y pon a prueba tu reconocimiento de palabras en espa\u00f1ol. Encuentra las palabras correctas, evita las trampas y consigue estrellas en una experiencia educativa de realidad virtual con tutorial narrado.\n"}, {"images": {"nodes": [{"file_name": "vertical.png", "id": "2576612222811754", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296069_2576612226145087_5226927813653137986_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B28ioikwu6YQ7kNvwH-Sd-v&_nc_oc=AdroJsRwbHDysnPfRHeQz3VxdO_DYJ0t5GpONI-fOngWvKioe777D5KdVdD__U1cISc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQU_Ac1RZgQUGODHZcFqEe9jscJasA8uD9qFVCv-zezvA&oe=6B0454B5"}, {"file_name": "Portada principal.png", "id": "1763368964902628", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307309_1763368968235961_3289402828568322746_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xt5Dy3ZDKVUQ7kNvwHTIWv_&_nc_oc=Ado_bI4XjZk7ZpG6wRsTbXCeoJNqjfaqse2B_eAO64iJN2uAYmgYFLsCrShe4EkNiwM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTLuI8JfIZTTOGIJl_srmtZh_eIcmD6fg_wOuQXBVKhQ&oe=6B0464C3"}, {"file_name": "Horizontal.png", "id": "1334858198512779", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri
n.com&_nc_ss=7f20f&oh=00_AQTVcaZx_5Dn_Tq4GxO9Gx_FQxSEiCb4dgG2AItTOaS2Ng&oe=6B099985"}, {"file_name": "ab0b8689-bdd3-49b8-a9af-ff8ee7e2ab5f.png", "id": "1629301825228264", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_1629301828561597_7943475945015739107_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KH3S0SewJY0Q7kNvwHd4_Mz&_nc_oc=Adpa-05Rw6K3uf9m2J_UU2EjXPPCG4ADHA6ixojdTrQVVFiPJ8eWvb5IJah7eKvz99U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGTk7oUP1x9smjxnHDaQZaOE_CvWJWUzRIhskps9fG5w&oe=6B09CDFA"}, {"file_name": "7.png", "id": "3558552690974578", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/654867655_3558552694307911_4999883974959228705_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oruakA9egE4Q7kNvwGSm5QR&_nc_oc=AdpsltyKCpJtv49Erbe6zQR8Oi2vGnPKJMcwGRVQRv2K0-JNie0KUzE9NHeEQWoADnY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKDAInuckF2x4OE-RRovOq889NEgaaamRYyXh3hypa2A&oe=6B09A9F6"}, {"file_name": "6.png", "id": "1668618567960543", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499312231_1668618571293876_4628310966439453883_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7l2QbpAouUQ7kNvwHQE0zs&_nc_oc=AdqtfSeL3ceC7crccHxYWD8MIk0ZsJ53I8pRvb29OoYF5jU0G6KoKgdCkm6AUMA56BQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTug2S9mBR8teu8fjWIms5RyR8Zn4Znq6OyBpK-zm1VWg&oe=6B09ADDA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cazadores de palabras", "keywords": ["palabras", "lectura", "espa\u00f1ol", "educaci\u00f3n", "vocabulario"], "long_description": "\u00a1El Viejo Oeste te espera con un desaf\u00edo de palabras!\n\nCazadores de palabras es un juego educativo de realidad virtual en espa\u00f1ol. Recorre el escenario, observa las palabras y selecciona las que cumplen el objetivo de la partida. Presta atenci\u00f3n: tambi\u00e9n encontrar\u00e1s palabras trampa.\n\nComienza con un tutorial guiado con narraci\u00f3n para conocer la din\u00e1mica y practicar antes de jugar. Tambi\u00e9n puedes omitirlo y entrar directamente a la partida.\n\n\u2022 Practica el reconocimiento de palabras en espa\u00f1ol.\n\u2022 Explora un escenario ambientado en el Viejo Oeste.\n\u2022 Consigue estrellas y consulta tus resultados.\n\u2022 Reinicia la partida para volver a intentarlo.\n\u2022 Despl\u00e1zate y gira con los joysticks de los mandos.\n\nIncluye pausa y salida con confirmaci\u00f3n. La interfaz y la narraci\u00f3n est\u00e1n en espa\u00f1ol.\n", "short_description": "Explora un pueblo del Viejo Oeste y pon a prueba tu reconocimiento de palabras en espa\u00f1ol. Encuentra las palabras correctas, evita las trampas y consigue estrellas en una experiencia educativa de realidad virtual con tutorial narrado.\n"}, {"images": {"nodes": [{"file_name": "vertical.png", "id": "2576612222811754", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296069_2576612226145087_5226927813653137986_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5okxqvbX-MQ7kNvwEiKbM4&_nc_oc=AdpAWPahrA8PEtYLBZK4QcM6M9p1j2tIODnYCHSJXSPZQlvqG_4pqmMd6_71t5bVfYQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKJf2sFfnd8nHzuzcuvQX8KZcWbgR_FbNvPCxWbCthGQ&oe=6B099AB5"}, {"file_name": "Portada principal.png", "id": "1763368964902628", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307309_1763368968235961_3289402828568322746_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3R6P7Pl_TAQQ7kNvwGAGKKx&_nc_oc=AdptXYlkJSDCJbsKU4Gp9uObL1uhoUp2yOXssagctCEJsTumcufjkauA5ZMxVPOAu1o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAQK6wRIB7FFaq3aS4rI6H9cbPK31ElxX2QlLr5KHVwA&oe=6B09AAC3"}, {"file_name": "Horizontal.png", "id": "1334858198512779", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri
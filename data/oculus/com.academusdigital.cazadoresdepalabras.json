n.com&_nc_ss=7f30f&oh=00_AQTEDRhBaHvOClygPDOd5YWCxsjbWI4D93RmSk65_BVKTg&oe=6B0C74C5"}, {"file_name": "ab0b8689-bdd3-49b8-a9af-ff8ee7e2ab5f.png", "id": "1629301825228264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_1629301828561597_7943475945015739107_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uYI7gSsrxMQ7kNvwGHM82u&_nc_oc=AdrMKqvLEI4llJ1MOJsWAt8bJ2j9hlUd53ZoUuRB4fSd5e_P7l7kuAkJ70XTGEHG18M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQERVZ4uNS0k5x99eyWbe-PjG3rRcaP31waWvHSIpP6sA&oe=6B0C70FA"}, {"file_name": "7.png", "id": "3558552690974578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/654867655_3558552694307911_4999883974959228705_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMbrTwZ0FPIQ7kNvwF11-Qv&_nc_oc=AdqPNSks2DTEAzix8_PKpTWgTlC5gkphnPdg9y1rwaXs4HuOJJoA7QBTiGYAGCUgmNk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTx2nRnBcQV1EjSjwjU7Ulf4RKa8ZpTbqPg7_QHQ5ERyw&oe=6B0C4CF6"}, {"file_name": "6.png", "id": "1668618567960543", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312231_1668618571293876_4628310966439453883_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7l2QbpAouUQ7kNvwE45jUR&_nc_oc=Adp69cWeGL0XJkgTYCl9rst3NASVldk0YD_Nxj0xE_lcR1Jir8RmlVBW4H0LQBHSVGs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT6MVdRYHyce6DP6g9Klogy_fa21CSHBJMXFk0_gUyRcQ&oe=6B0C50DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cazadores de palabras", "keywords": ["palabras", "lectura", "espa\u00f1ol", "educaci\u00f3n", "vocabulario"], "long_description": "\u00a1El Viejo Oeste te espera con un desaf\u00edo de palabras!\n\nCazadores de palabras es un juego educativo de realidad virtual en espa\u00f1ol. Recorre el escenario, observa las palabras y selecciona las que cumplen el objetivo de la partida. Presta atenci\u00f3n: tambi\u00e9n encontrar\u00e1s palabras trampa.\n\nComienza con un tutorial guiado con narraci\u00f3n para conocer la din\u00e1mica y practicar antes de jugar. Tambi\u00e9n puedes omitirlo y entrar directamente a la partida.\n\n\u2022 Practica el reconocimiento de palabras en espa\u00f1ol.\n\u2022 Explora un escenario ambientado en el Viejo Oeste.\n\u2022 Consigue estrellas y consulta tus resultados.\n\u2022 Reinicia la partida para volver a intentarlo.\n\u2022 Despl\u00e1zate y gira con los joysticks de los mandos.\n\nIncluye pausa y salida con confirmaci\u00f3n. La interfaz y la narraci\u00f3n est\u00e1n en espa\u00f1ol.\n", "short_description": "Explora un pueblo del Viejo Oeste y pon a prueba tu reconocimiento de palabras en espa\u00f1ol. Encuentra las palabras correctas, evita las trampas y consigue estrellas en una experiencia educativa de realidad virtual con tutorial narrado.\n"}, {"images": {"nodes": [{"file_name": "vertical.png", "id": "2576612222811754", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296069_2576612226145087_5226927813653137986_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Msdx-N_d0yoQ7kNvwFi2ABM&_nc_oc=Adrqu8-0Ea-8yZdyPR56w-OYIk5EBt7jHr1_VIk1i0LlVRFyPdem1nTSsSBjItsEVyc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTY5SXDPn8v7VYIxp19kMwSyN7QAz5OxYLGwhm0_iltIQ&oe=6B0C75F5"}, {"file_name": "Portada principal.png", "id": "1763368964902628", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307309_1763368968235961_3289402828568322746_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RB9iWZzjT04Q7kNvwGtcpJA&_nc_oc=Adr1ZXbO-NYaggZLN91brV1BZE8WOoSut7G0bFhcrXj1ECntmH7w36ykpVfypdbE1K4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQfgOiAJUO7_cquzUnlllel7BHCaBEd5IMflYN1amVYXA&oe=6B0C4DC3"}, {"file_name": "Horizontal.png", "id": "1334858198512779", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri
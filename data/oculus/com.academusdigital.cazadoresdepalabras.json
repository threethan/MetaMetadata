n.com&_nc_ss=7f20f&oh=00_AQTINnW1yWJPLeG1boNv_tZWJm_CLZ-Z3koAqPDuKX8Asw&oe=6AFF0D85"}, {"file_name": "ab0b8689-bdd3-49b8-a9af-ff8ee7e2ab5f.png", "id": "1629301825228264", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_1629301828561597_7943475945015739107_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qj7lghAkTEYQ7kNvwETy2Ry&_nc_oc=AdrbyLen8fRI9-UVaqWxxWpf2Zwh9Z8nc5Mvr8xCoytgQkn7RLJp2U-3wrBBhSsLs_Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsAnAp1fyTKgyblnWcoXJyT2y_pkJijR26ANd9MDXSdA&oe=6AFF09BA"}, {"file_name": "7.png", "id": "3558552690974578", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/654867655_3558552694307911_4999883974959228705_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSMJ9nAD7o0Q7kNvwGzscGZ&_nc_oc=Adpp0FzyulSI_MfytTKBH4YhT4C0v_eNvg1WEGiydhqqhAKDzlkPHfQvf8gdnmuJbVc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSREta6zOsDBB8lwGkcrCylWpsOtqS6A7WPFhIWCxpTNQ&oe=6AFF1DF6"}, {"file_name": "6.png", "id": "1668618567960543", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499312231_1668618571293876_4628310966439453883_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOXdSPT4ylIQ7kNvwHPSjfa&_nc_oc=AdoJVREpcnboBl2qhrj8YdVsemJUh45n4_JRnzfitYiUfRL3jA9utCq1-sivOQKigII&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQit-BAN0eEUAZqjcQ49AJ6vgANoHqZ1yig9RWdiokgNg&oe=6AFF21DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cazadores de palabras", "keywords": ["palabras", "lectura", "espa\u00f1ol", "educaci\u00f3n", "vocabulario"], "long_description": "\u00a1El Viejo Oeste te espera con un desaf\u00edo de palabras!\n\nCazadores de palabras es un juego educativo de realidad virtual en espa\u00f1ol. Recorre el escenario, observa las palabras y selecciona las que cumplen el objetivo de la partida. Presta atenci\u00f3n: tambi\u00e9n encontrar\u00e1s palabras trampa.\n\nComienza con un tutorial guiado con narraci\u00f3n para conocer la din\u00e1mica y practicar antes de jugar. Tambi\u00e9n puedes omitirlo y entrar directamente a la partida.\n\n\u2022 Practica el reconocimiento de palabras en espa\u00f1ol.\n\u2022 Explora un escenario ambientado en el Viejo Oeste.\n\u2022 Consigue estrellas y consulta tus resultados.\n\u2022 Reinicia la partida para volver a intentarlo.\n\u2022 Despl\u00e1zate y gira con los joysticks de los mandos.\n\nIncluye pausa y salida con confirmaci\u00f3n. La interfaz y la narraci\u00f3n est\u00e1n en espa\u00f1ol.\n", "short_description": "Explora un pueblo del Viejo Oeste y pon a prueba tu reconocimiento de palabras en espa\u00f1ol. Encuentra las palabras correctas, evita las trampas y consigue estrellas en una experiencia educativa de realidad virtual con tutorial narrado.\n"}, {"images": {"nodes": [{"file_name": "vertical.png", "id": "2576612222811754", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296069_2576612226145087_5226927813653137986_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srrRyhdkHC8Q7kNvwFA3ySt&_nc_oc=Adr5XGwyl858V0P-oH4pEhHT_Qk162D0njlsNsKgRH7r65TYwqfeb05LpkqJUB7G9XI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYrvw4OhlSoCCmCt9HCXgnVXjn6jZXMs6jdUQS9Unbdg&oe=6AFF0EB5"}, {"file_name": "Portada principal.png", "id": "1763368964902628", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307309_1763368968235961_3289402828568322746_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8TJNR37OcUQ7kNvwFtyCKB&_nc_oc=AdoAO2TdxuvfbSRJMXGBr3SYt0lXnyOv34QqnvD5NQiDKfvef1L2eX2mYqzxDsIGOig&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ09Ng_9bilGPmiiQC8wkabqLbQkSqTZvow7mfCN5ieEA&oe=6AFF1EC3"}, {"file_name": "Horizontal.png", "id": "1334858198512779", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri
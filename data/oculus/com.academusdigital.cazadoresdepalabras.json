n.com&_nc_ss=7f20f&oh=00_AQT5XofpUigZbY0BjTIdh_pwJbXdT0-R2Zw-AgPmYBd0jQ&oe=6B005F05"}, {"file_name": "ab0b8689-bdd3-49b8-a9af-ff8ee7e2ab5f.png", "id": "1629301825228264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_1629301828561597_7943475945015739107_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qj7lghAkTEYQ7kNvwG6ZX7m&_nc_oc=Adro6AuRPH0DEAaUdjjA2u94YMV9YDkiUFZsD64mgRwhdeyMQtLOPG4kYACeEKjrrH4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQf5pkPr4VDqE8d2BgxrcvUn-j6d8V5N37nplg1GONY6Q&oe=6B005B3A"}, {"file_name": "7.png", "id": "3558552690974578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/654867655_3558552694307911_4999883974959228705_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDWcPZBt9V0Q7kNvwH--XYS&_nc_oc=Adqb6dSzH5MmlLFe0tqif5MvqI8aN49WW-G5xUvY3UmMj02ioTIOUUjFW21RsEtS7mQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDbTCJTisltpsPE55xmZqnLAtXKsjYlewSDp_Zh_Ng6w&oe=6B006F76"}, {"file_name": "6.png", "id": "1668618567960543", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312231_1668618571293876_4628310966439453883_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOXdSPT4ylIQ7kNvwF98pQP&_nc_oc=AdrEYzArMfs85vH7JzVu3YH23eFICR-ELmiYYPI65y64iIox0tPoUDMAOZZaFQVkSnQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHyNbXy43wIcGXAw7wgziHvi9_OMtSVRXdoeIPFEMR7Q&oe=6B00735A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cazadores de palabras", "keywords": ["palabras", "lectura", "espa\u00f1ol", "educaci\u00f3n", "vocabulario"], "long_description": "\u00a1El Viejo Oeste te espera con un desaf\u00edo de palabras!\n\nCazadores de palabras es un juego educativo de realidad virtual en espa\u00f1ol. Recorre el escenario, observa las palabras y selecciona las que cumplen el objetivo de la partida. Presta atenci\u00f3n: tambi\u00e9n encontrar\u00e1s palabras trampa.\n\nComienza con un tutorial guiado con narraci\u00f3n para conocer la din\u00e1mica y practicar antes de jugar. Tambi\u00e9n puedes omitirlo y entrar directamente a la partida.\n\n\u2022 Practica el reconocimiento de palabras en espa\u00f1ol.\n\u2022 Explora un escenario ambientado en el Viejo Oeste.\n\u2022 Consigue estrellas y consulta tus resultados.\n\u2022 Reinicia la partida para volver a intentarlo.\n\u2022 Despl\u00e1zate y gira con los joysticks de los mandos.\n\nIncluye pausa y salida con confirmaci\u00f3n. La interfaz y la narraci\u00f3n est\u00e1n en espa\u00f1ol.\n", "short_description": "Explora un pueblo del Viejo Oeste y pon a prueba tu reconocimiento de palabras en espa\u00f1ol. Encuentra las palabras correctas, evita las trampas y consigue estrellas en una experiencia educativa de realidad virtual con tutorial narrado.\n"}, {"images": {"nodes": [{"file_name": "vertical.png", "id": "2576612222811754", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296069_2576612226145087_5226927813653137986_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srrRyhdkHC8Q7kNvwFQc2O7&_nc_oc=Adpf7s7PzsSplyY0MsY6e4awNloKUGrV1LDsda4LES3hjhXCLUhQPTWBP58FVtG1Okc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTf-FlXfdfSIRAVVzvPbER-QCNBG3-sMEa3RRBzYjjwfg&oe=6B006035"}, {"file_name": "Portada principal.png", "id": "1763368964902628", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307309_1763368968235961_3289402828568322746_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUlhg3Axs20Q7kNvwEiItXw&_nc_oc=AdqzuzHgwj3bGMRVq_ASe5uo8SYe216bXRNzRzV0YbyEAVxSeJ_OwZlTJwoKg5xrwLg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEkJfNc-l2LkTDMcE4O8CTlYBBWGNruAxganGFVwx7wg&oe=6B007043"}, {"file_name": "Horizontal.png", "id": "1334858198512779", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri
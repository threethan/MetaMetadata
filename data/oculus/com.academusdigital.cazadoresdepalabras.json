n.com&_nc_ss=7f20f&oh=00_AQQyh_QfSqz_VEAS3wqjgPTBOUG3LjddECV6ORm-WQjwqA&oe=6AFC6A85"}, {"file_name": "ab0b8689-bdd3-49b8-a9af-ff8ee7e2ab5f.png", "id": "1629301825228264", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_1629301828561597_7943475945015739107_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yaPc_tJtqRkQ7kNvwHjuPVj&_nc_oc=AdqgTbCmdvo2-VJUlJHK2B-0la481jb7PAU0nuEzWQzlQaZXUm1bUp7C9Sxv8u0b_tc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyWE7XuX0zH38as-fSQ3yQBLqiZcG0LYQGZAZmonRYig&oe=6AFC66BA"}, {"file_name": "7.png", "id": "3558552690974578", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/654867655_3558552694307911_4999883974959228705_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSMJ9nAD7o0Q7kNvwGbduti&_nc_oc=AdrPJtHk9VpCvSvTjgs196o3m06hDYDbOwfbenezVGywbnxHYuc0EpadPUT6DFWhHpc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBGCpVnA6_E489f6OCZgR90TH3Y_ifwOEfYNutrBMxcw&oe=6AFC7AF6"}, {"file_name": "6.png", "id": "1668618567960543", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499312231_1668618571293876_4628310966439453883_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lifwGO7GNVIQ7kNvwE4gwd2&_nc_oc=AdoPkB-6wZxWuzz6qwRvHx9SXtAKsPJ8fWwH7hxuzN0GE0_MonakcBdZYWIugU_EOdg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQen5J91UZnevAwm0W30Od0qwQAcrDfkKKUgVqvMTOTZQ&oe=6AFC7EDA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cazadores de palabras", "keywords": ["palabras", "lectura", "espa\u00f1ol", "educaci\u00f3n", "vocabulario"], "long_description": "\u00a1El Viejo Oeste te espera con un desaf\u00edo de palabras!\n\nCazadores de palabras es un juego educativo de realidad virtual en espa\u00f1ol. Recorre el escenario, observa las palabras y selecciona las que cumplen el objetivo de la partida. Presta atenci\u00f3n: tambi\u00e9n encontrar\u00e1s palabras trampa.\n\nComienza con un tutorial guiado con narraci\u00f3n para conocer la din\u00e1mica y practicar antes de jugar. Tambi\u00e9n puedes omitirlo y entrar directamente a la partida.\n\n\u2022 Practica el reconocimiento de palabras en espa\u00f1ol.\n\u2022 Explora un escenario ambientado en el Viejo Oeste.\n\u2022 Consigue estrellas y consulta tus resultados.\n\u2022 Reinicia la partida para volver a intentarlo.\n\u2022 Despl\u00e1zate y gira con los joysticks de los mandos.\n\nIncluye pausa y salida con confirmaci\u00f3n. La interfaz y la narraci\u00f3n est\u00e1n en espa\u00f1ol.\n", "short_description": "Explora un pueblo del Viejo Oeste y pon a prueba tu reconocimiento de palabras en espa\u00f1ol. Encuentra las palabras correctas, evita las trampas y consigue estrellas en una experiencia educativa de realidad virtual con tutorial narrado.\n"}, {"images": {"nodes": [{"file_name": "vertical.png", "id": "2576612222811754", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296069_2576612226145087_5226927813653137986_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ll2db40m0ygQ7kNvwEU3hqN&_nc_oc=AdrFeR0OTEgi9VrWsRUEg4tS1F_MdMc74RF028OBy6nXS7DFezGzp2OhIpJnuS8gb2Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKTNhtRfpzWFCErtEqhsHpdYbasQxTQGpmUxVNO883jw&oe=6AFC6BB5"}, {"file_name": "Portada principal.png", "id": "1763368964902628", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307309_1763368968235961_3289402828568322746_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8TJNR37OcUQ7kNvwF4Gl0V&_nc_oc=Adp7xnblmMQBfrvuiJu5HuF-zRiROMGiI5grjDpzty93UBFuJ6zhh2o4nB_Id52CY2Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgZ9wWvPDLY6c9sR4UaRs8qevYivXGLlJoVVZjOaDHdg&oe=6AFC7BC3"}, {"file_name": "Horizontal.png", "id": "1334858198512779", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri
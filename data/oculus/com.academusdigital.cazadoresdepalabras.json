n.com&_nc_ss=7f20f&oh=00_AQRAB520yrhlDwJZWzKF5MYC-Duj6Py_73wa-uojE4xulg&oe=6B05A505"}, {"file_name": "ab0b8689-bdd3-49b8-a9af-ff8ee7e2ab5f.png", "id": "1629301825228264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_1629301828561597_7943475945015739107_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SBiAEgp4kgQ7kNvwHYQ04u&_nc_oc=Adq-v8zkvQW4f5CSNGHwjccdgOeEkDtWonTQNh1fNrNWONvDk9EP5v34bRJ1F_A8Iag&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiTQdMUxaYy7Pr-VNpnzp0xF8IX4E_HnZM7TpZ_Ippww&oe=6B05D97A"}, {"file_name": "7.png", "id": "3558552690974578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/654867655_3558552694307911_4999883974959228705_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9BQ91I94-kQ7kNvwHHv8RH&_nc_oc=AdriAyGIgawa9DPtIdyNvSz0d7L3N39eyxz8tLSFTrGhy6xOMF0iHsYxsT0xRHZDoyQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS48sIYaAMHTXA5gs4zS1yo9v1-fj6wFC9xXcztIshRbQ&oe=6B05B576"}, {"file_name": "6.png", "id": "1668618567960543", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312231_1668618571293876_4628310966439453883_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKGwgPlI7fMQ7kNvwFxXxmF&_nc_oc=AdrR52Gr05EH8KdR8zPtHX4ALfQwV-G7bNKTzaay6Igl2pwBXQvDl5QfVhKbWi6sijQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaKGpQ09TtcP5PJtyyX9aC4W1g8dLkVIWLBHul5U6Kdg&oe=6B05B95A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cazadores de palabras", "keywords": ["palabras", "lectura", "espa\u00f1ol", "educaci\u00f3n", "vocabulario"], "long_description": "\u00a1El Viejo Oeste te espera con un desaf\u00edo de palabras!\n\nCazadores de palabras es un juego educativo de realidad virtual en espa\u00f1ol. Recorre el escenario, observa las palabras y selecciona las que cumplen el objetivo de la partida. Presta atenci\u00f3n: tambi\u00e9n encontrar\u00e1s palabras trampa.\n\nComienza con un tutorial guiado con narraci\u00f3n para conocer la din\u00e1mica y practicar antes de jugar. Tambi\u00e9n puedes omitirlo y entrar directamente a la partida.\n\n\u2022 Practica el reconocimiento de palabras en espa\u00f1ol.\n\u2022 Explora un escenario ambientado en el Viejo Oeste.\n\u2022 Consigue estrellas y consulta tus resultados.\n\u2022 Reinicia la partida para volver a intentarlo.\n\u2022 Despl\u00e1zate y gira con los joysticks de los mandos.\n\nIncluye pausa y salida con confirmaci\u00f3n. La interfaz y la narraci\u00f3n est\u00e1n en espa\u00f1ol.\n", "short_description": "Explora un pueblo del Viejo Oeste y pon a prueba tu reconocimiento de palabras en espa\u00f1ol. Encuentra las palabras correctas, evita las trampas y consigue estrellas en una experiencia educativa de realidad virtual con tutorial narrado.\n"}, {"images": {"nodes": [{"file_name": "vertical.png", "id": "2576612222811754", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296069_2576612226145087_5226927813653137986_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B28ioikwu6YQ7kNvwFs4pL5&_nc_oc=AdoJYUIW-1Be8GmEqUT2ohVoljiRLOv6pOWx5oqnJe9eqlnY7_TPbH64sTjed_trAvY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpNKivSP-x5CTHH_J_mXyKX29mxtYztntC2Io8kFo3Uw&oe=6B05A635"}, {"file_name": "Portada principal.png", "id": "1763368964902628", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307309_1763368968235961_3289402828568322746_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xt5Dy3ZDKVUQ7kNvwFKYqHO&_nc_oc=AdrdR4e18UuTwtk_13pRVnmiiD00TA1nfoJ9AeVlaCR612I-GM2D-q5BKP7dBoGf0pA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-qi8f3jINoyLRfU04cdClacBkK0wW0KLtMLBQ3NYJUA&oe=6B05B643"}, {"file_name": "Horizontal.png", "id": "1334858198512779", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri
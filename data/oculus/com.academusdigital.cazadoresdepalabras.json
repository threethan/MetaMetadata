n.com&_nc_ss=7f20f&oh=00_AQRep7vEC-_KBkXEfUuFeW9qN3Dh3Rki4c-AeG7rtgiE-Q&oe=6AFB1905"}, {"file_name": "ab0b8689-bdd3-49b8-a9af-ff8ee7e2ab5f.png", "id": "1629301825228264", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823802_1629301828561597_7943475945015739107_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yaPc_tJtqRkQ7kNvwH4BRnM&_nc_oc=Adphk-YLIrwMO1XTin_Yc9Xp2EAX8TxAi7tV7HgcTUw_4Ax3Nwj5i2NThsS9BAyv_B4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRB5vk_ZciBNIP9Uh8MC2AxxOpMTSmEWgpsmWi7Ap3xEA&oe=6AFB4D7A"}, {"file_name": "7.png", "id": "3558552690974578", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/654867655_3558552694307911_4999883974959228705_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nl3joVWYv34Q7kNvwHvzFFt&_nc_oc=AdrNjOxp3C2YWXtqLcbMTSUJf9rB6AmKdXUfXSnKxFIfRTwLXUNHAmcOHPekJS8r7Hw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9VO-0n9Af86zpQTLzQforMEVuYDEfzOJt5kmp8p4cCg&oe=6AFB2976"}, {"file_name": "6.png", "id": "1668618567960543", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312231_1668618571293876_4628310966439453883_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lifwGO7GNVIQ7kNvwFvqSqK&_nc_oc=Adrr6bpRTSvE90TkRuNjSET4fZ96OKr6t2Ux58Z73ND-CkpEGOEzf_vVMR57v2F1dJo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjxLZ1tlD5fVluR-33-FSyKhCqhEk25RXv-20ZGp9WYA&oe=6AFB2D5A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cazadores de palabras", "keywords": ["palabras", "lectura", "espa\u00f1ol", "educaci\u00f3n", "vocabulario"], "long_description": "\u00a1El Viejo Oeste te espera con un desaf\u00edo de palabras!\n\nCazadores de palabras es un juego educativo de realidad virtual en espa\u00f1ol. Recorre el escenario, observa las palabras y selecciona las que cumplen el objetivo de la partida. Presta atenci\u00f3n: tambi\u00e9n encontrar\u00e1s palabras trampa.\n\nComienza con un tutorial guiado con narraci\u00f3n para conocer la din\u00e1mica y practicar antes de jugar. Tambi\u00e9n puedes omitirlo y entrar directamente a la partida.\n\n\u2022 Practica el reconocimiento de palabras en espa\u00f1ol.\n\u2022 Explora un escenario ambientado en el Viejo Oeste.\n\u2022 Consigue estrellas y consulta tus resultados.\n\u2022 Reinicia la partida para volver a intentarlo.\n\u2022 Despl\u00e1zate y gira con los joysticks de los mandos.\n\nIncluye pausa y salida con confirmaci\u00f3n. La interfaz y la narraci\u00f3n est\u00e1n en espa\u00f1ol.\n", "short_description": "Explora un pueblo del Viejo Oeste y pon a prueba tu reconocimiento de palabras en espa\u00f1ol. Encuentra las palabras correctas, evita las trampas y consigue estrellas en una experiencia educativa de realidad virtual con tutorial narrado.\n"}, {"images": {"nodes": [{"file_name": "vertical.png", "id": "2576612222811754", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499296069_2576612226145087_5226927813653137986_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ll2db40m0ygQ7kNvwH7Wd45&_nc_oc=AdrrpX6FsGOhI5Z7Dy8Kvy51wHhQLKdJcL8mgXxTlaluO0H7r24aK9rw30En4eglxSg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUSH5yBv1X-PsKT1JVXyedKUdmDN6UQ9XMHc1bKDFl9g&oe=6AFB1A35"}, {"file_name": "Portada principal.png", "id": "1763368964902628", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307309_1763368968235961_3289402828568322746_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1ipyyB3KnkQ7kNvwGg_v7p&_nc_oc=AdpLBIRGINnBc0i_6j2pAADXyNjuhZ0BGktJPRwn6lATI6bke_J0vS_XE-qDnNxLRnw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7L23O5TbINZwkD2lB7IwWrKDhd3UFkSOCP51X_XRQaA&oe=6AFB2A43"}, {"file_name": "Horizontal.png", "id": "1334858198512779", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri
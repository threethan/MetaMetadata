n.com&_nc_ss=7f30f&oh=00_AQWXzSO5VMVx50vguasXh1alvyCluOLMIOsxoZSXgsjoFA&oe=6B0F17C5"}, {"file_name": "ab0b8689-bdd3-49b8-a9af-ff8ee7e2ab5f.png", "id": "1629301825228264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_1629301828561597_7943475945015739107_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDnkmSERE7UQ7kNvwH4rwsj&_nc_oc=AdrsLVPjAGLKfi8uRV32L-rZ0U57mF6Sat8TL7YuhYpch9texGYP9SikQU1r9I5Gqyw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXzSV864t74m6idpZrfq5Qbjf1rVxdRzyiuk3N00HQG9g&oe=6B0F13FA"}, {"file_name": "7.png", "id": "3558552690974578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/654867655_3558552694307911_4999883974959228705_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMbrTwZ0FPIQ7kNvwGSVGcA&_nc_oc=AdroW2IJr30_nXFmKpirIBHm_CsvUunsg6EeKe4dwW43rqWkGoe7sZK2FsTJ0relTrk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV3FNiZIdrAWEYSphzHcLn3q063A8lTLd4lPGXBJbtXYQ&oe=6B0EEFF6"}, {"file_name": "6.png", "id": "1668618567960543", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312231_1668618571293876_4628310966439453883_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fFmhW_OkvQQ7kNvwHNfmYH&_nc_oc=AdpesN7OWMNoSw9diT4hcntZXaML6NnBktOlP7dqWvC7oPMHO4gZksu-wTiyogEAIwo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVs5bDw2kUDIPep2I_Wu4oeUGt0eltdnqBxecfflyOlcQ&oe=6B0EF3DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cazadores de palabras", "keywords": ["palabras", "lectura", "espa\u00f1ol", "educaci\u00f3n", "vocabulario"], "long_description": "\u00a1El Viejo Oeste te espera con un desaf\u00edo de palabras!\n\nCazadores de palabras es un juego educativo de realidad virtual en espa\u00f1ol. Recorre el escenario, observa las palabras y selecciona las que cumplen el objetivo de la partida. Presta atenci\u00f3n: tambi\u00e9n encontrar\u00e1s palabras trampa.\n\nComienza con un tutorial guiado con narraci\u00f3n para conocer la din\u00e1mica y practicar antes de jugar. Tambi\u00e9n puedes omitirlo y entrar directamente a la partida.\n\n\u2022 Practica el reconocimiento de palabras en espa\u00f1ol.\n\u2022 Explora un escenario ambientado en el Viejo Oeste.\n\u2022 Consigue estrellas y consulta tus resultados.\n\u2022 Reinicia la partida para volver a intentarlo.\n\u2022 Despl\u00e1zate y gira con los joysticks de los mandos.\n\nIncluye pausa y salida con confirmaci\u00f3n. La interfaz y la narraci\u00f3n est\u00e1n en espa\u00f1ol.\n", "short_description": "Explora un pueblo del Viejo Oeste y pon a prueba tu reconocimiento de palabras en espa\u00f1ol. Encuentra las palabras correctas, evita las trampas y consigue estrellas en una experiencia educativa de realidad virtual con tutorial narrado.\n"}, {"images": {"nodes": [{"file_name": "vertical.png", "id": "2576612222811754", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296069_2576612226145087_5226927813653137986_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EG6jxvgNdOIQ7kNvwFWgIBP&_nc_oc=AdpTI3drDydvnQu0c3_Yl1CS4WYAcUvSLEmrcqkIw-j1vPCH49YL6fHBXOrcI_ko_2w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVrjMxAUqa3I2kUvjM2I5IpxUyn_We82YEbuLBSS_vh2g&oe=6B0F18F5"}, {"file_name": "Portada principal.png", "id": "1763368964902628", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307309_1763368968235961_3289402828568322746_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RB9iWZzjT04Q7kNvwHIyoL1&_nc_oc=AdrKuf8E5jPqwRrC_4ZbRI-EOwX-lvyotvfG-qHprdi-szH61nAz4G5nXYHf8VoHDQk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWpLyhC0hYioRYYDlTN1dxsEw6PmtqySAm3IWqroQEBXA&oe=6B0EF0C3"}, {"file_name": "Horizontal.png", "id": "1334858198512779", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri
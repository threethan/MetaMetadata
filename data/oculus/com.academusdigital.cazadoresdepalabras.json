n.com&_nc_ss=7f20f&oh=00_AQQPINYvfUrqrBdzktdpTPBQa53jDIxql1r3WxugVgNvqA&oe=6B084805"}, {"file_name": "ab0b8689-bdd3-49b8-a9af-ff8ee7e2ab5f.png", "id": "1629301825228264", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823802_1629301828561597_7943475945015739107_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KH3S0SewJY0Q7kNvwG7V-ce&_nc_oc=AdpqcowZiCAG9WzeJoUrJMcedGHLjI43KhZxhwwnU-69e7jMe-oGAaKeCsGI1Bo_zZA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlMu6SFJauRWkZk2mbyHIjAnUSM6Kv_ZbvuYwVxCgTtg&oe=6B08443A"}, {"file_name": "7.png", "id": "3558552690974578", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/654867655_3558552694307911_4999883974959228705_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oruakA9egE4Q7kNvwEMxXUH&_nc_oc=Adpinb7sRYHz4_rSSJKsrWX4vZRS04N6T0MNsnfajkJJ3b0rDTybwmrt09j7C36WjQI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbkbZonbtzNqYuN06mBysQnE7Wx-Zc6ulmvHOj2ODoDQ&oe=6B085876"}, {"file_name": "6.png", "id": "1668618567960543", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499312231_1668618571293876_4628310966439453883_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKGwgPlI7fMQ7kNvwEQ1Kne&_nc_oc=AdoXBK7rjxb-7BkSh9AgLschr5J65MyfbLkfRdMkQzFQ9xqyYJKkcTGSQZGUJ-uNUf4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwVddsuA9etubzWi4-6fxDkW-UqUqQNEVDH5OaT2GITQ&oe=6B085C5A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cazadores de palabras", "keywords": ["palabras", "lectura", "espa\u00f1ol", "educaci\u00f3n", "vocabulario"], "long_description": "\u00a1El Viejo Oeste te espera con un desaf\u00edo de palabras!\n\nCazadores de palabras es un juego educativo de realidad virtual en espa\u00f1ol. Recorre el escenario, observa las palabras y selecciona las que cumplen el objetivo de la partida. Presta atenci\u00f3n: tambi\u00e9n encontrar\u00e1s palabras trampa.\n\nComienza con un tutorial guiado con narraci\u00f3n para conocer la din\u00e1mica y practicar antes de jugar. Tambi\u00e9n puedes omitirlo y entrar directamente a la partida.\n\n\u2022 Practica el reconocimiento de palabras en espa\u00f1ol.\n\u2022 Explora un escenario ambientado en el Viejo Oeste.\n\u2022 Consigue estrellas y consulta tus resultados.\n\u2022 Reinicia la partida para volver a intentarlo.\n\u2022 Despl\u00e1zate y gira con los joysticks de los mandos.\n\nIncluye pausa y salida con confirmaci\u00f3n. La interfaz y la narraci\u00f3n est\u00e1n en espa\u00f1ol.\n", "short_description": "Explora un pueblo del Viejo Oeste y pon a prueba tu reconocimiento de palabras en espa\u00f1ol. Encuentra las palabras correctas, evita las trampas y consigue estrellas en una experiencia educativa de realidad virtual con tutorial narrado.\n"}, {"images": {"nodes": [{"file_name": "vertical.png", "id": "2576612222811754", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499296069_2576612226145087_5226927813653137986_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5okxqvbX-MQ7kNvwGn5Yea&_nc_oc=AdoL1Ud9_UUsu4opXmojY3w1_M5qL6sAM5ttycebz8F7CV6bW80BCq9IoS5UNIpV6DA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzOpfPLwerxcfmjZdQG2s74zW2plmoc4025YRBktcaGg&oe=6B084935"}, {"file_name": "Portada principal.png", "id": "1763368964902628", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499307309_1763368968235961_3289402828568322746_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3R6P7Pl_TAQQ7kNvwES_sPR&_nc_oc=AdrBW0wWJQD8SqswDDz8cU5rfIkX-JiawPrtU6ilFm11A7LlY3OT7UBiRrJrPAX_3XI&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQqcSyd1qjWkENRCKtTkOArI3tmuKN6-jMTJij7UF4YA&oe=6B085943"}, {"file_name": "Horizontal.png", "id": "1334858198512779", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri
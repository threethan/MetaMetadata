n.com&_nc_ss=7f30f&oh=00_AQU9l8MkoOUC826xIJXIoUOj_HdIacV8qwbBTTgz94lleQ&oe=6B106945"}, {"file_name": "ab0b8689-bdd3-49b8-a9af-ff8ee7e2ab5f.png", "id": "1629301825228264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_1629301828561597_7943475945015739107_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDnkmSERE7UQ7kNvwHfdmzh&_nc_oc=AdrK1qGBWeguIhG_39O3F7rLP_vPqUdQMLzpBkD5YD81R0_fTmr1kcaWlS3tKU6IBLI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWBqpa5uGs4u8sLxTYl_XZdIUp8scTLTvFIAG3B9ZnM8g&oe=6B10657A"}, {"file_name": "7.png", "id": "3558552690974578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/654867655_3558552694307911_4999883974959228705_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCUoPkq-HcAQ7kNvwHTy35k&_nc_oc=AdrdnItIhk7hiKa3TJyAEcD83FBEC8C7Ns3pSIxFZroOPzFbVeKtpjzPVlBIt3CY0FY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXjhTAbhzpTLLwZlKfVPN4AqSWPguldJFBkMYSr9uon6Q&oe=6B104176"}, {"file_name": "6.png", "id": "1668618567960543", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312231_1668618571293876_4628310966439453883_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fFmhW_OkvQQ7kNvwGdfH18&_nc_oc=AdoUjsCcHiJ46VzPp5Mo09czzbm_SD3xx64-hWRDH7VS28XLV2H0Pfy5Pu3DP5vbtEY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXdJ-vfbAAsfDpN7m-nUyOlee-Bt5l-QxQ_0Zd_DreCjA&oe=6B10455A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cazadores de palabras", "keywords": ["palabras", "lectura", "espa\u00f1ol", "educaci\u00f3n", "vocabulario"], "long_description": "\u00a1El Viejo Oeste te espera con un desaf\u00edo de palabras!\n\nCazadores de palabras es un juego educativo de realidad virtual en espa\u00f1ol. Recorre el escenario, observa las palabras y selecciona las que cumplen el objetivo de la partida. Presta atenci\u00f3n: tambi\u00e9n encontrar\u00e1s palabras trampa.\n\nComienza con un tutorial guiado con narraci\u00f3n para conocer la din\u00e1mica y practicar antes de jugar. Tambi\u00e9n puedes omitirlo y entrar directamente a la partida.\n\n\u2022 Practica el reconocimiento de palabras en espa\u00f1ol.\n\u2022 Explora un escenario ambientado en el Viejo Oeste.\n\u2022 Consigue estrellas y consulta tus resultados.\n\u2022 Reinicia la partida para volver a intentarlo.\n\u2022 Despl\u00e1zate y gira con los joysticks de los mandos.\n\nIncluye pausa y salida con confirmaci\u00f3n. La interfaz y la narraci\u00f3n est\u00e1n en espa\u00f1ol.\n", "short_description": "Explora un pueblo del Viejo Oeste y pon a prueba tu reconocimiento de palabras en espa\u00f1ol. Encuentra las palabras correctas, evita las trampas y consigue estrellas en una experiencia educativa de realidad virtual con tutorial narrado.\n"}, {"images": {"nodes": [{"file_name": "vertical.png", "id": "2576612222811754", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296069_2576612226145087_5226927813653137986_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EG6jxvgNdOIQ7kNvwF8fFJW&_nc_oc=AdqnByCwnkPpe_LAr2SYtT1SVDF8mVCM95q5DMBensNYdqfzteJyfN_OL3CdUMVzRuE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUotEeWT2ehIqzKDxR9aBVsjzym0IeN9p4cvPouG_ouqA&oe=6B106A75"}, {"file_name": "Portada principal.png", "id": "1763368964902628", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307309_1763368968235961_3289402828568322746_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klzXsSudE6UQ7kNvwH5XMwt&_nc_oc=AdrqoSU8cBWaF7JRDqmkpM1c6li7WNKU7a1yNlvTrsnjc1zE4BzzHZd60OfF7_cPq-Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV7jBpM539neP4iE2jlnfyKHLDT5kNmB40jWSO1c6u7LA&oe=6B104243"}, {"file_name": "Horizontal.png", "id": "1334858198512779", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri
Nyne9I3YpFUp1yi8hohLUJrUhBUgqZQE6L5JhLr05Rw&oe=69A6BA97"}, {"file_name": "Bus_Screenshot_2560x1440_4.png", "id": "1947157639095801", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974613_1947157642429134_8027812979380993609_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZSIoVySDaoQ7kNvwFplBNx&_nc_oc=Adk02JbYSBwsvw6EJeTpVLuvXsfZXZo8LP9DMqSfG53TTM2-WwN6aF9X70sxj-rae3s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft-Y0l2JOToniMiqUgjvwhSw5kU2T6O_QK1jUjvipJSeQ&oe=69A6E109"}, {"file_name": "Bus_Screenshot_2560x1440_5.png", "id": "1131388668409609", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031584_1131388671742942_5300640119253179281_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0B00554GFhAQ7kNvwE2hOPV&_nc_oc=AdmWIj5p4Aq4x7lTyOmh8pmxRIW0zV4qXMCWUqhycGYv6rxLclT25jmemQnn3avpTCs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftBnC3ldeLpXykvO6NPhmkXKoJE2pQXIg9beOcBOxs_TQ&oe=69A6ECC7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Share the Road Bus", "keywords": ["Cycling", "Road", "Safety", "CyclingActionNetwork"], "long_description": "Staples VR has partnered with Cycling Action Network to develop a safe driving virtual reality simulator for bus drivers. The simulation shows drivers what it feels like to be incorrectly followed and passed by a large bus when on a bicycle. The experience is designed to change driver behavior. Spend the next 10 minutes exploring three ideas and behaviors that allow these people to share the road and get home safely. These will be ideas and behaviors that you have control over and can do the next time you are in a vehicle and see a person riding.", "short_description": "With the Share the Road Virtual Reality experience explore ideas and behaviors that allow bus drivers to share the road and get home safely through our VR cycle safety simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.staplesvr.com/privacy-policy", "developer_te
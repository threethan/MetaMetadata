: "Bus_Screenshot_2560x1440_5.png", "id": "1131388668409609", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031584_1131388671742942_5300640119253179281_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2jPAu_r0nAQ7kNvwElmrPu&_nc_oc=AdreyVRIMqZK9609rbRUUg8DCtzkbxZ3EPeJGmtg3O1SknPQlqZ2QOXi2Y-0Mex67D0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_3tgkB7zXDGhHjH8jzUGrjJgcREugw_Vh0xGbiyFYug&oe=6A53A147"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Share the Road Bus", "keywords": ["Cycling", "Road", "Safety", "CyclingActionNetwork"], "long_description": "Staples VR has partnered with Cycling Action Network to develop a safe driving virtual reality simulator for bus drivers. The simulation shows drivers what it feels like to be incorrectly followed and passed by a large bus when on a bicycle. The experience is designed to change driver behavior. Spend the next 10 minutes exploring three ideas and behaviors that allow these people to share the road and get home safely. These will be ideas and behaviors that you have control over and can do the next time you are in a vehicle and see a person riding.", "short_description": "With the Share the Road Virtual Reality experience explore ideas and behaviors that allow bus drivers to share the road and get home safely through our VR cycle safety simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.staplesvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "StaplesVR", "support_website_url": null, "website_url": "https://www.staplesvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_
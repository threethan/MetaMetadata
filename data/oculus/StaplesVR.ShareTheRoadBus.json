0Zz0G-cUCtUuJLalbP6ZoGmv4N-kbPuiqtWCGx2o0pQ&oe=69F0C6D7"}, {"file_name": "Bus_Screenshot_2560x1440_4.png", "id": "1947157639095801", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974613_1947157642429134_8027812979380993609_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qX_k3m0FsEQ7kNvwE9MyET&_nc_oc=Adrb-pYG-tSzu4xekI59NHOXHxh30QlHVDO05V9Ou4HPR2Dn7SG5Rg6nbP8fsBkLPSY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3dLSe-Mrssh4KbFj3IE7wfUtimhunQPg5-afVJ3BSAlw&oe=69F0B509"}, {"file_name": "Bus_Screenshot_2560x1440_5.png", "id": "1131388668409609", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031584_1131388671742942_5300640119253179281_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrLmuJwi45IQ7kNvwGxGnmk&_nc_oc=AdrEvdY7qaCCH569SK-7OoY821h-KUSzMRV6QViKVohwQkqfAMLylSv_4PklP1nZSmc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3CCVLIdoRyrzAYgvZjkkC94mAw7mLtMZz4YzbkfJUKKw&oe=69F0C0C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Share the Road Bus", "keywords": ["Cycling", "Road", "Safety", "CyclingActionNetwork"], "long_description": "Staples VR has partnered with Cycling Action Network to develop a safe driving virtual reality simulator for bus drivers. The simulation shows drivers what it feels like to be incorrectly followed and passed by a large bus when on a bicycle. The experience is designed to change driver behavior. Spend the next 10 minutes exploring three ideas and behaviors that allow these people to share the road and get home safely. These will be ideas and behaviors that you have control over and can do the next time you are in a vehicle and see a person riding.", "short_description": "With the Share the Road Virtual Reality experience explore ideas and behaviors that allow bus drivers to share the road and get home safely through our VR cycle safety simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.staplesvr.com/privacy-policy", "developer_te
rlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4L-21T6Q0kQ7kNvwHyf8Yz&_nc_oc=Adoppb29YWCUn5UBTWmxc1d32bHwhwQNBpBpMnA4GHCm4ZzZQWiv8Ky1s-mGZ-4NuRA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUlMKA0wkXUlx5QX3MHhOrivVJ0fACi4uhx7vow2m2ZQ&oe=6B01D3C9"}, {"file_name": "Bus_Screenshot_2560x1440_5.png", "id": "1131388668409609", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031584_1131388671742942_5300640119253179281_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncs4lktTTbsQ7kNvwECagSo&_nc_oc=AdruAcxhhh-v9rzoYma-3pHJZ7u4ooagsqH_jhlsl1NFaIFE7NKoOKNFUwgU9Bu4-pI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvXRvcGCEs4IKt0xydS7Zhw1nb4PaEQlg4pLcOdA7JTA&oe=6B01DF87"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Share the Road Bus", "keywords": ["Cycling", "Road", "Safety", "CyclingActionNetwork"], "long_description": "Staples VR has partnered with Cycling Action Network to develop a safe driving virtual reality simulator for bus drivers. The simulation shows drivers what it feels like to be incorrectly followed and passed by a large bus when on a bicycle. The experience is designed to change driver behavior. Spend the next 10 minutes exploring three ideas and behaviors that allow these people to share the road and get home safely. These will be ideas and behaviors that you have control over and can do the next time you are in a vehicle and see a person riding.", "short_description": "With the Share the Road Virtual Reality experience explore ideas and behaviors that allow bus drivers to share the road and get home safely through our VR cycle safety simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.staplesvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "StaplesVR", "support_website_url": null, "website_url": "https://www.staplesvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOM
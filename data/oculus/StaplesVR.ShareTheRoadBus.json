131388668409609", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031584_1131388671742942_5300640119253179281_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNKM04UQXO0Q7kNvwEU7D25&_nc_oc=AdljxsqAijT4ZwbywTrJdavMrrFVMZUvj2kACs02y8b-JTbyQFCUWqYNpwM14WqIQC0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzbGS6mdZSzQJzaj9y2mtgyH03XcUzuX4T-JOGs8h5yFQ&oe=69B81047"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Share the Road Bus", "keywords": ["Cycling", "Road", "Safety", "CyclingActionNetwork"], "long_description": "Staples VR has partnered with Cycling Action Network to develop a safe driving virtual reality simulator for bus drivers. The simulation shows drivers what it feels like to be incorrectly followed and passed by a large bus when on a bicycle. The experience is designed to change driver behavior. Spend the next 10 minutes exploring three ideas and behaviors that allow these people to share the road and get home safely. These will be ideas and behaviors that you have control over and can do the next time you are in a vehicle and see a person riding.", "short_description": "With the Share the Road Virtual Reality experience explore ideas and behaviors that allow bus drivers to share the road and get home safely through our VR cycle safety simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.staplesvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "StaplesVR", "support_website_url": null, "website_url": "https://www.staplesvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, 
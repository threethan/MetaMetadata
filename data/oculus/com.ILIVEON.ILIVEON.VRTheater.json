NNex0tuPax51ShrzzK-Su12-iZc1oE8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9c06K2BieREH3xc3TBelhiAits3fSHdHZdgnD4GIAeiw&oe=6A39328D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "home2570.png", "id": "2953159481503429", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974654_2953159484836762_6889363690762653286_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlVqR94r8BMQ7kNvwFAr0WM&_nc_oc=AdpXNAizcFVZ5dVCXOByPN_1Z823IO8Px1giaRr8PZetjTjgVYlXq8T2zt7g6WVnpVo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ia4cR6Qurr0qME0fmKLw_5paRE3-Rr_oscxtA8yQPTg&oe=6A393136"}, "display_name": "I-LIVE-ON.VR-Theater", "keywords": [], "long_description": "I-LIVE-ON.com has developed the FREE VR-Theater App, that allows you to watch your Digital Stories in Virtual Reality (VR) mode. \n\nJust load a Story (produced with I-LIVE-ON.Creator App, available from https://i-live-on.com/), pick your VR environment and then enjoy the show!\n\nI-LIVE-ON.com's StoryTeller System lets you create Stories using your own Content (including Pictures, Videos, Documents and Sound) from your Computer, and then makes it super easy for the Content to be assembled as a Multi-Media Presentation transformed into a VR environment through the VR-Theater App.\n\nUSE CASES:\n\na) A Grandparent, together with their Grandchild (or Son / Daughter), team up to create a Story using all their computer images, videos, documents & sound files to create an interesting Story that they can watch in their VR Headset (and also simultaneously stream to their TV set).\n\nb)  A Student needs to create a Multi-Media Presentation of an historical person - for a school homework assignment, and then uploads it into their VR Headset, and then streams it to a School TV set so that their fellow students can simultaneously watch the show.\n\nVisit https://i-live-on.com/ and download the Free Creator App (for Windows or MacOS) Version and create your own Stories in minutes, that you can watch using your Quest VR Headset together with the VR-Theater App, and then also share it with Family &amp; Friends.\n\n\u201cAnna's Art Journey\u201d Story is included as an example Story.", "short_description": "The VR-Theater App (by I-LIVE-ON.com) enables you to watch your Stories in Virtual Reality mode. Just load a Story, pick your VR environment and enjoy the show!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://i-live-on.com/pages/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "I-LIVE-ON CORPORATION", "support_website_url": null, "website_url": "https://i-live-on.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8850363358336688"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1986870088502483"}, {"status": "PUBLISHED", "id": "1337241037237412"}]}, "baseline_offer": {"id": "1986870088502483"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1737064080, "status": "PUBLISHED", "id": "1986870088502483"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9957931690913177", "version": "1.0.18"}, "id": "481286044887131", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary
_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSaTExFBK2eNhJEp3qEH-Uqg9BCsrlQZtOMe6jiZRLa8A&oe=6B0B1E2E"}, {"file_name": "MainScene_1080p_25.05.2025_11-13-04.png", "id": "1631204520930978", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499320125_1631204524264311_244173415180075748_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oQujCCBp-UQ7kNvwGG3nvV&_nc_oc=AdpzpEmu0w0R5cH_AyKyDE87cDIbwHz1r4nil_XaUJnEVRukBVU7d4DpmpFGt-S859Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQScaiHKgYtkIAaRX6w4nEYZ5PFvWiLEpkLZq7M9E4yBQw&oe=6B0B3D92"}, {"file_name": "MainScene_1080p_01.06.2025_10-03-21 (1).png", "id": "736704655372991", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307534_736704658706324_8362615255689829968_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bnaPSSSoagQ7kNvwHTmMJ_&_nc_oc=Adrww0rn4Eq1pEoVhMsg5GD3T5aMGUVAg7H8ER9aEPy-qZ90ZixdzQ_J4DeqaHBScTk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSOSFvTK9H5fcgCvzq-g1-uhKMaUqHbd4_kzgRlzG7T9A&oe=6B0B278F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scare & Banana's", "keywords": ["Scare", "Bananas", "funny", "horror", "Fangame"], "long_description": "Scare & Banana's is a thrilling and chaotic Gorilla Tag fan game where you're not just monkeying around \u2014 you're fighting to survive.\n\nTrapped deep inside a mysterious lab, a group of monkes desperately tries to escape. But something has gone horribly wrong\u2026 Some monkes have mutated into terrifying monsters, twisted by unknown experiments, and they\u2019re hunting down anything that moves \u2014 including you.\n\nUse your parkour skills, stay sharp, and stick with your group if you want a chance to survive the madness. Explore eerie environments, uncover secrets, and face off against your corrupted monke brothers in a heart-pounding battle for survival.\n\nWill you escape the lab\u2026 or become one of them?\nRun. Climb. Hide. SURVIVE.", "short_description": "Scare & Banana's is about these monke's that have been trapped in this lab and are trying to get out of here...\n\nBut... there is some crazy monke's that have turned into monster and try to kill you!\n\nSURVIVE!!!"}]}, "developer_name": "Golddudevr", "developer_privacy_policy_url": "https://sites.google.com/view/golddude/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gold", "support_website_url": null, "website_url": "https://sites.google.com/view/golddude/thing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9891839800893804"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1211434753613176"}]}, "baseline_offer": {"id": "1211434753613176"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749681360, "status": "PUBLISHED", "id": "1211434753613176"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "10039745349436581", "version": "0.7"}, "id": "705488885286310", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9777239462353839", 
_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YTunYXrLt4Q7kNvwGaYMFx&_nc_oc=AdkoN5uhIX0FudAsL5Q0f3VCKa5L3BZC0bLeiypHT7VPkcpy2KYp_IZj314srWS8G8o&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afx0lP-6rgVVsA9E3XOu5q6a0sPkzmqAFXQDKb7bRBgcog&oe=69AACC92"}, {"file_name": "MainScene_1080p_01.06.2025_10-03-21 (1).png", "id": "736704655372991", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499307534_736704658706324_8362615255689829968_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlnp4NV4Ev4Q7kNvwH--dR4&_nc_oc=AdmQXV0HUmgfq9H0-NNBe0O0rJoTh2DM5I4FWnHs25dYDZyQiNrcGjUmy5a2CnSKV18&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afwgy-Yqdbc8KyepA3zT1XzpQCkjtFr4WO5jmgs8ogl1hw&oe=69AAB68F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scare & Banana's", "keywords": ["Scare", "Bananas", "funny", "horror", "Fangame"], "long_description": "Scare & Banana's is a thrilling and chaotic Gorilla Tag fan game where you're not just monkeying around \u2014 you're fighting to survive.\n\nTrapped deep inside a mysterious lab, a group of monkes desperately tries to escape. But something has gone horribly wrong\u2026 Some monkes have mutated into terrifying monsters, twisted by unknown experiments, and they\u2019re hunting down anything that moves \u2014 including you.\n\nUse your parkour skills, stay sharp, and stick with your group if you want a chance to survive the madness. Explore eerie environments, uncover secrets, and face off against your corrupted monke brothers in a heart-pounding battle for survival.\n\nWill you escape the lab\u2026 or become one of them?\nRun. Climb. Hide. SURVIVE.", "short_description": "Scare & Banana's is about these monke's that have been trapped in this lab and are trying to get out of here...\n\nBut... there is some crazy monke's that have turned into monster and try to kill you!\n\nSURVIVE!!!"}]}, "developer_name": "Golddudevr", "developer_privacy_policy_url": "https://sites.google.com/vie
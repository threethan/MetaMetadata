4264311_244173415180075748_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HS9xaTHOTFIQ7kNvwHceu9_&_nc_oc=AdoNvgc474wjo9t-Prj47-_4r0lvv_7GnWaxRfYR1CU_sbbwQENa6lMP86TVeBeggfs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3erlugVHlyk7AcUDBEZkJbTc_YpHBV7Krcp6fINWTjMQ&oe=69D4FC92"}, {"file_name": "MainScene_1080p_01.06.2025_10-03-21 (1).png", "id": "736704655372991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307534_736704658706324_8362615255689829968_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNrSpADuGQ0Q7kNvwEhM3Zx&_nc_oc=AdrgIWcQDHZ74Dd6Mlh9q0Gik4wdcRR6Y3SOcmuBtGena_N0ArtYknrh-ldBpgFm4p8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VMOvvlzA8GS9LnaGVxieOWoXgSRL0OFFZ38UPo3mE5A&oe=69D4E68F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scare & Banana's", "keywords": ["Scare", "Bananas", "funny", "horror", "Fangame"], "long_description": "Scare & Banana's is a thrilling and chaotic Gorilla Tag fan game where you're not just monkeying around \u2014 you're fighting to survive.\n\nTrapped deep inside a mysterious lab, a group of monkes desperately tries to escape. But something has gone horribly wrong\u2026 Some monkes have mutated into terrifying monsters, twisted by unknown experiments, and they\u2019re hunting down anything that moves \u2014 including you.\n\nUse your parkour skills, stay sharp, and stick with your group if you want a chance to survive the madness. Explore eerie environments, uncover secrets, and face off against your corrupted monke brothers in a heart-pounding battle for survival.\n\nWill you escape the lab\u2026 or become one of them?\nRun. Climb. Hide. SURVIVE.", "short_description": "Scare & Banana's is about these monke's that have been trapped in this lab and are trying to get out of here...\n\nBut... there is some crazy monke's that have turned into monster and try to kill you!\n\nSURVIVE!!!"}]}, "developer_name": "Golddudevr", "developer_privacy_
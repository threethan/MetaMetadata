-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPnMEsLTyymfnkZq42DFO0A14eXBxUcbYivlXJhGgw9w&oe=6B05B620"}, {"file_name": "s5 (1).png", "id": "1759868134707971", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619113_1759868138041304_4866004428598843396_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2du8Zy2tvSAQ7kNvwFy1MDG&_nc_oc=Adqjrsj_JoknoICPneNgtP1EMioEDrvY9BxffsCp-3T0A80_xyISyj3wrcvwucUfMug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH3ugRxsJ2X1mmLSDDIHEuFeh7dUdpRUuk7GlNOB8V-A&oe=6B05B11F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982626_808149747903867_5100784820136452062_n.png", "id": "847150434810011", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618264_847150438143344_3135543925831588418_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7oHO9XOZ9cQ7kNvwHLZhAZ&_nc_oc=AdpSMq4T1vM-FJKtHxylIWT2pqiGpEFodpBVOVAmmxzR6jf74JjnRVbgI-Nrg3E45yo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHNKNHJ4bTODsdNHL7STnZQKrC1OM7KtV-ShUr5PLtrw&oe=6B05B5B8"}, "display_name": "Chimp Chase: PvP", "keywords": ["PVP", "Chimp", "Chase", "Adventure", "Battle"], "long_description": "Chimp Chase is a thrilling PVP game that redefines the excitement of the Gorilla Locomotion movement system. Immerse yourself in a one of a kind experience as you choose from an arsenal of primary and secondary weapons. Then, dive straight into the battle zone for intense online PVP battles with other players.\n\nComplete quests to earn ores, which you can then use to purchase a wide variety of stylish cosmetics, allowing you to pimp your chimp's appearance and express yourself on the battlefield.\n\nEnter the world of Chimp Chase and take part in awesome battles that combine skill, style, and fun to provide the best possible experience.", "short_description": "Welcome to Chimp Chase, enter into the endless warzone and endless opportunities!"}]}, "developer_na
-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTg7zB6rARfw6xtNnDnA32fPp7tmOZPFtEr_2hgCI8Qqg&oe=6B09AAA0"}, {"file_name": "s5 (1).png", "id": "1759868134707971", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619113_1759868138041304_4866004428598843396_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_2ioZ5MWxcQ7kNvwF6JEml&_nc_oc=AdpLmsGJLIg4cw7DvhfVUSFgWufCYFsCy-HTfc_dIstU6cQVdXiKV9uKCMbUxOGUb2Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBWrZHt8GcGKkyItfgI6bc8lC8jpSzE_OOIiex5OA_1Q&oe=6B09A59F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982626_808149747903867_5100784820136452062_n.png", "id": "847150434810011", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618264_847150438143344_3135543925831588418_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79s3u5daTbMQ7kNvwF9YFDB&_nc_oc=Adp3V4DFHAWSHcbMvuYVpfVteCgM7A8RhXW4hvt6n8XMan_LPzr5JXdeYsnX5GdhKIc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXzHrech4SXI1qw5Qeq9NlQVwWur4dtvEmSYcrh-jMKQ&oe=6B09AA38"}, "display_name": "Chimp Chase: PvP", "keywords": ["PVP", "Chimp", "Chase", "Adventure", "Battle"], "long_description": "Chimp Chase is a thrilling PVP game that redefines the excitement of the Gorilla Locomotion movement system. Immerse yourself in a one of a kind experience as you choose from an arsenal of primary and secondary weapons. Then, dive straight into the battle zone for intense online PVP battles with other players.\n\nComplete quests to earn ores, which you can then use to purchase a wide variety of stylish cosmetics, allowing you to pimp your chimp's appearance and express yourself on the battlefield.\n\nEnter the world of Chimp Chase and take part in awesome battles that combine skill, style, and fun to provide the best possible experience.", "short_description": "Welcome to Chimp Chase, enter into the endless warzone and endless opportunities!"}]}, "developer_na
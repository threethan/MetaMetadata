-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsUCYRnXND1a6vaQbxdE8y3KaT69gak6S9agj4FvkN3g&oe=6AFB2A20"}, {"file_name": "s5 (1).png", "id": "1759868134707971", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619113_1759868138041304_4866004428598843396_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXFfxHJl0cYQ7kNvwGuSatY&_nc_oc=AdqFCixntlmRau_i6OSXw5jJ6gQ5YNjpOhJNBP1VIDkeXqX1LMqC5kK9eXVjfsntRRo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRGmIhRr_MJP9WBM_npNklGxxIAeLIi8R9melhoShFXA&oe=6AFB251F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982626_808149747903867_5100784820136452062_n.png", "id": "847150434810011", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618264_847150438143344_3135543925831588418_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYYi80LkA6EQ7kNvwHVmOMF&_nc_oc=AdomG8l-Ub9-f5P7GoNeRkGYWEJrIkTWrtqHs6wv2boZ_n6vuffiZZPtB5WsTWYEaxI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK4ei1zqu0cT7NYLpuAFu48xQLGwUeVYfFzb3Cdw917Q&oe=6AFB29B8"}, "display_name": "Chimp Chase: PvP", "keywords": ["PVP", "Chimp", "Chase", "Adventure", "Battle"], "long_description": "Chimp Chase is a thrilling PVP game that redefines the excitement of the Gorilla Locomotion movement system. Immerse yourself in a one of a kind experience as you choose from an arsenal of primary and secondary weapons. Then, dive straight into the battle zone for intense online PVP battles with other players.\n\nComplete quests to earn ores, which you can then use to purchase a wide variety of stylish cosmetics, allowing you to pimp your chimp's appearance and express yourself on the battlefield.\n\nEnter the world of Chimp Chase and take part in awesome battles that combine skill, style, and fun to provide the best possible experience.", "short_description": "Welcome to Chimp Chase, enter into the endless warzone and endless opportunities!"}]}, "developer_na
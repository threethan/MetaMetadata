KU2bYvSxm1AyrMkZQlE_dBUTibsQBKEkNZyzYxHHPBFUjY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60Dh0Rf4oJndawrr1zkd9TyLRPmYAn1O_AEOHOC4U_6Q&oe=6A19B49F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982626_808149747903867_5100784820136452062_n.png", "id": "847150434810011", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618264_847150438143344_3135543925831588418_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZJwnAHOoo0Q7kNvwGb75m5&_nc_oc=AdoOvGJkzTxweluuoFoBddSM8R_nshkqoW_VQazsPA4nC6dMpyk9CRDmfsigshNy0fA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-df_obeaHMW_5L9q6e7o5a-5pKL9guDIHHYgw4GXUsg&oe=6A19B938"}, "display_name": "Chimp Chase: PvP", "keywords": ["PVP", "Chimp", "Chase", "Adventure", "Battle"], "long_description": "Chimp Chase is a thrilling PVP game that redefines the excitement of the Gorilla Locomotion movement system. Immerse yourself in a one of a kind experience as you choose from an arsenal of primary and secondary weapons. Then, dive straight into the battle zone for intense online PVP battles with other players.\n\nComplete quests to earn ores, which you can then use to purchase a wide variety of stylish cosmetics, allowing you to pimp your chimp's appearance and express yourself on the battlefield.\n\nEnter the world of Chimp Chase and take part in awesome battles that combine skill, style, and fun to provide the best possible experience.", "short_description": "Welcome to Chimp Chase, enter into the endless warzone and endless opportunities!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://businesschimpchase.wixsite.com/chimpchasepvp", "developer_terms_of_service_url": null, "publisher_name": "MrJ20", "support_website_url": null, "website_url": "https://businesschimpchase.wixsite.com/chimpchasepvp", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category":
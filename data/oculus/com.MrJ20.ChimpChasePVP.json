-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQCl2sa15SzVcjsz1PQNQ3aiQ14MejeWrpl9r6JedR7Cw&oe=6B0B3460"}, {"file_name": "s5 (1).png", "id": "1759868134707971", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619113_1759868138041304_4866004428598843396_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_2ioZ5MWxcQ7kNvwGH-pv0&_nc_oc=Adq0x1JwYxURD55xunkGwjNOftYfTsuUJ3JnhG65uBvx9i1y355YvBZvhB09V_GNNYg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSUxINiyAWiJu6UIOe84JEhpREV_ay3k3QtX60lWJzCBg&oe=6B0B2F5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982626_808149747903867_5100784820136452062_n.png", "id": "847150434810011", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618264_847150438143344_3135543925831588418_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeOtbzvVULMQ7kNvwE1sJMN&_nc_oc=Adr4xEZprn5O5FnLEg7IlUbNX3nN3G-yO9zXJTk54tz3912vweXuOxSKKDoMKZ1vSro&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTAhtwVHQ_7vwI5fy90G1C3i51BYlaWVZGAOy8LElKxAw&oe=6B0B33F8"}, "display_name": "Chimp Chase: PvP", "keywords": ["PVP", "Chimp", "Chase", "Adventure", "Battle"], "long_description": "Chimp Chase is a thrilling PVP game that redefines the excitement of the Gorilla Locomotion movement system. Immerse yourself in a one of a kind experience as you choose from an arsenal of primary and secondary weapons. Then, dive straight into the battle zone for intense online PVP battles with other players.\n\nComplete quests to earn ores, which you can then use to purchase a wide variety of stylish cosmetics, allowing you to pimp your chimp's appearance and express yourself on the battlefield.\n\nEnter the world of Chimp Chase and take part in awesome battles that combine skill, style, and fun to provide the best possible experience.", "short_description": "Welcome to Chimp Chase, enter into the endless warzone and endless opportunities!"}]}, "developer_na
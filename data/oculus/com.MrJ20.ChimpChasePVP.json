-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuODBjVzb4BSjDTYRJE918_pN4VoGX-JOIW0SN_T4DKg&oe=6B007020"}, {"file_name": "s5 (1).png", "id": "1759868134707971", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619113_1759868138041304_4866004428598843396_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKkROOI79o8Q7kNvwHc85KN&_nc_oc=Adr1abT9oHWRRAfmjy22XdG0mu5oy_HiwCKo3OsGcEfnq_CN2Br8XrqqHnFwzZufdkI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg4AIG9RSLbWiPivXwEBFdkfey9BtgLZ7pJb7jKhjp0A&oe=6B006B1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982626_808149747903867_5100784820136452062_n.png", "id": "847150434810011", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618264_847150438143344_3135543925831588418_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkwZ0AK2I18Q7kNvwF1-WVJ&_nc_oc=AdpDPHPi13q9owoklSVLhg7z-cMSeMdztfTCJMYm4Y4_yomA_UCm6iEVy_DHKQO7jbA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRflWpTb9R5c32KMrxTLOsDL3_ASLZwse4Bg396hero9Q&oe=6B006FB8"}, "display_name": "Chimp Chase: PvP", "keywords": ["PVP", "Chimp", "Chase", "Adventure", "Battle"], "long_description": "Chimp Chase is a thrilling PVP game that redefines the excitement of the Gorilla Locomotion movement system. Immerse yourself in a one of a kind experience as you choose from an arsenal of primary and secondary weapons. Then, dive straight into the battle zone for intense online PVP battles with other players.\n\nComplete quests to earn ores, which you can then use to purchase a wide variety of stylish cosmetics, allowing you to pimp your chimp's appearance and express yourself on the battlefield.\n\nEnter the world of Chimp Chase and take part in awesome battles that combine skill, style, and fun to provide the best possible experience.", "short_description": "Welcome to Chimp Chase, enter into the endless warzone and endless opportunities!"}]}, "developer_na
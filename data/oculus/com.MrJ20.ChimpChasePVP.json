-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTksustzAqxJuOY_-z2LimZGufF0ePR7QtU0dZzFtlpnQ&oe=6B01C1A0"}, {"file_name": "s5 (1).png", "id": "1759868134707971", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619113_1759868138041304_4866004428598843396_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o67gZOLE0IoQ7kNvwGOgGVt&_nc_oc=AdraX9AP9qZ1rJ5oItf8wbYaBCEQM0cKC5Gr4WNs8d04Go9c_3RoCq4DXiJdtXqMJKA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4XOgtJf5le_gx063zcKZzglnyc-oSOdplhMq-dA38rQ&oe=6B01BC9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982626_808149747903867_5100784820136452062_n.png", "id": "847150434810011", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618264_847150438143344_3135543925831588418_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkwZ0AK2I18Q7kNvwHUsXVI&_nc_oc=Adp7R9cgLJQ6TvjEBV1DH28R8BDR0NlhQ2M5tXsFDnldq3rwYWqGuod3c3us1_bRwvM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlPiHExQYQvGO3KIjyUGIq8IIbgSfxgmef0-V0B62TAw&oe=6B01C138"}, "display_name": "Chimp Chase: PvP", "keywords": ["PVP", "Chimp", "Chase", "Adventure", "Battle"], "long_description": "Chimp Chase is a thrilling PVP game that redefines the excitement of the Gorilla Locomotion movement system. Immerse yourself in a one of a kind experience as you choose from an arsenal of primary and secondary weapons. Then, dive straight into the battle zone for intense online PVP battles with other players.\n\nComplete quests to earn ores, which you can then use to purchase a wide variety of stylish cosmetics, allowing you to pimp your chimp's appearance and express yourself on the battlefield.\n\nEnter the world of Chimp Chase and take part in awesome battles that combine skill, style, and fun to provide the best possible experience.", "short_description": "Welcome to Chimp Chase, enter into the endless warzone and endless opportunities!"}]}, "developer_na
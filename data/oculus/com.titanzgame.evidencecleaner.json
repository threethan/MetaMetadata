0_888209370512178_2796559195675715682_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7CENP36ZPgQ7kNvwETw-h-&_nc_oc=AdrcWxliZ6r9BW3qs6p_LqCz0eS6GGN3758L6RCnNFtY40L1cTw5tP9hUsZucjdjgxA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQ-cBHwX-Co6Qzly7WngZ4nQrxLS9gXKTBVrPqYJ0yIA&oe=6A771EB6"}, {"file_name": "02.png", "id": "810117248782348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828008_810117252115681_1892713764293887939_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAw-hTdYBpsQ7kNvwHvAXhO&_nc_oc=AdqqqZSiqm4l7dmIp-RlCfHaVTSD5Sd1G_CJaLPZ_v2tMRlliN9biRe4DxcrAErKwYw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRQFbjVRnYntiNCN9FFJpUfASjhmQXzj4zz7lwq-yI2A&oe=6A773EAA"}, {"file_name": "2.png", "id": "1174378824558231", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823271_1174378827891564_6039918947362507738_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SN3WRY_68IQ7kNvwHgaaSK&_nc_oc=AdoB9k0m5od20nj5rlGk-XL9cZMECzLwYcYJ043PYF06kvF_6exjBqTX_Tepq60kyCs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOnsAphqA2U7GXifaow7MSBvJ70ZTHWhfXfwcHihUA5A&oe=6A772EE7"}, {"file_name": "3.png", "id": "1283105810297657", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828038_1283105813630990_4967299823778952867_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sB3bJgILMTsQ7kNvwEZqAbY&_nc_oc=Adp46zBDpkSBVmrei8DVyNal7N6iag-UqeyULioS9wPchiVL9DMHE0pogwwBFkbjlsw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWMUHkLVwcdKn5GGCnWpgKPAkvpHNMGIwrEBRFLMiu1g&oe=6A770E50"}, {"file_name": "4.png", "id": "4442633395970035", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824307_4442633412636700_587997238551523396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CKLxuEeoe8Q7kNvwGB7-ZQ&_nc_oc=AdqKRqYnf8CDtBHipahMnlPJHnAj1K4NKioijUNvF4YxNBNgGd9p1Q0cKj4-C_Hl7hY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExbZl7ya81IEyz-PyUhIv9Hy5arLAh8K5iNNCN55Yqug&oe=6A7725A0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Evidence Cleaner", "keywords": [], "long_description": " AFTERMATH CLEANER\n\nErase the evidence. Leave no trace.\nWhen deals go wrong, you\u2019re the one they call.\nStep into the role of a professional crime scene cleaner working for a powerful underground syndicate. Your job isn\u2019t to ask questions \u2014 it\u2019s to make problems disappear.\nScrub bloodstains from the floor. Bag weapons and shell casings. Wipe fingerprints before the police arrive. Drag bodies into vans under flickering neon lights. Destroy evidence in furnaces and dumpsters. And whatever you do\u2026 don\u2019t leave anything behind.\nIn this immersive VR experience built for Meta Quest, every job is hands-on, physical, and intense.\n\n\ud83e\uddf0 TRUE VR INTERACTION\n\nBuilt specifically for VR, every action is physical and immersive:\nGrab and bag weapons\nZip up body bags by hand\nDrag heavy loads across the floor\nScrub stains with realistic motion\nSeal trash bags and toss them into dumpsters\nBurn or dissolve evidence in disposal units\nUse UV scanners to reveal hidden blood and fingerprints\nNo buttons. No shortcuts. Just you and the mess.\n\n\ud83d\udea8 TIME IS NOT ON YOUR SIDE\n\nYou\u2019re not alone.\nPolice sirens grow closer. Neighbors get suspicious. Noise attracts attention. The longer you stay, the higher the risk.\nWork fast. Stay quiet. Finish the job.\n\nThey make the mess. You erase it.", "short_description": "Clean crime scenes for a powerful syndicate. Bag the evidence, erase the blood, and disappear before the cops arrive. No questions asked."}]}, "developer_name": null, "developer_privacy_policy_url": "https://titanzgamez.blogspot.com/2025/09/privacy-policy-for-titanz-games-last.html", "developer_terms_of_service_url": null, "publisher_name": "Titanz Game", "support_website_url": null, "website_url": "https://titanzgame.com/", "category": null, "comfor
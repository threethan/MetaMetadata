6O9-QX2BmM4Z-O52Ve7H20gr8HgykiQnf5rIMZoUbBjAqnU8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92Tt7qXzGOiH8BIF0-bJTEcEj_mmVQWdRk42jx_-sCyA&oe=6A4265DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image.png", "id": "1001648129080774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_1001648132414107_9064792936313083258_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Uq83HdszKMQ7kNvwEGrKtT&_nc_oc=AdpB-Ys5B8LYvDnrFREGO9UNF0UYJUwoS_QWiieGz9Yzp1HPvGAbitjNnrgX_Rs1wmw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SosS-_SEaSX0zPeWcpqQuW0aqY3Kov-0u1F8i5SzNdw&oe=6A426313"}, "display_name": "The Evidence Cleaner", "keywords": ["simulation", "interactive", "story", "roleplay", "crime"], "long_description": "\ud83e\ude78 AFTERMATH CLEANER\nBuilt for Meta Quest, every action is physical:\n\nDispose of the Dead: Zip body bags by hand, drag heavy loads, and chemically decompose remains.\n\nErase the Scene: Scrub bloodstains with realistic motion and bag shell casings.\n{1335199478710859}\n{871443158773744}\n\nReveal the Unseen: Wield a black-market UV scanner to expose microscopic blood spatter and wiped prints.\n\nDestroy Evidence: Burn or dissolve clues in disposal units.\nNo buttons. No shortcuts. Just you and the mess.\n\n\ud83d\udea8 TIME IS NOT ON YOUR SIDE\nSirens grow closer. Neighbors get suspicious. The longer you linger, the higher the risk. Work fast. Stay quiet. Find the killers.\n\nThey make the mess. You erase it.\n", "short_description": "Clean crime scenes for a powerful syndicate. Bag the evidence, erase the blood, and disappear before the cops arrive. No questions asked."}]}, "developer_name": null, "developer_privacy_policy_url": "https://titanzgamez.blogspot.com/2025/09/privacy-policy-for-titanz-games-last.html", "developer_terms_of_service_url": null, "publisher_name": "Titanz Game", "support_website_url": null, "website_url": "https://titanzgame.com/", "category": null,
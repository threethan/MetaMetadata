=1-7&_nc_sid=6e7a0a&_nc_ohc=52UcQ3P8TogQ7kNvwEtzJ5F&_nc_oc=AdrTbsO_J94R-KpDTU98AOAV402kalxg0VUKEu-VfaPpU7wYSCkkLUNoO900EqUVwBE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqufGAVCXVWOU5Atv1or_tNLFdvst_sAV6H8vbN9Ji8g&oe=6A8ADA2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image.png", "id": "1001648129080774", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619672_1001648132414107_9064792936313083258_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyvdpsF1M8MQ7kNvwHoMGXd&_nc_oc=AdpymWvLBc00Yowpz_mr_y2Zu0rea7oys_H2NcJI01F-N5hP5kaOtfmsQAJD-JK56iA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESPqjTdSS9UFSjO8EeUxCht-0NLOranWa1sXaGJ-Y2mA&oe=6A8AE593"}, "display_name": "The Evidence Cleaner", "keywords": ["simulation", "interactive", "story", "roleplay", "crime"], "long_description": "\ud83e\ude78 AFTERMATH CLEANER\nBuilt for Meta Quest, every action is physical:\n\nDispose of the Dead: Zip body bags by hand, drag heavy loads, and chemically decompose remains.\n\n\nErase the Scene: Scrub bloodstains with realistic motion and bag shell casings.\n{27851503227775729}\n\n{951827994558541}\n\nReveal the Unseen: Wield a black-market UV scanner to expose microscopic blood spatter and wiped prints.\n\nDestroy Evidence: Burn or dissolve clues in disposal units.\nNo buttons. No shortcuts. Just you and the mess.\n\n\ud83d\udea8 TIME IS NOT ON YOUR SIDE\nSirens grow closer. Neighbors get suspicious. The longer you linger, the higher the risk. Work fast. Stay quiet. Find the killers.\n\nThey make the mess. You erase it.\n\n\n", "short_description": "Clean crime scenes for a powerful syndicate. Bag the evidence, erase the blood, and disappear before the cops arrive. No questions asked."}]}, "developer_name": null, "developer_privacy_policy_url": "https://titanzgamez.blogspot.com/2025/09/privacy-policy-for-titanz-games-last.html", "developer_terms_of_service_url": null, "publisher_name": "Titanz Game", "
uluscdn.com&_nc_ss=7f20f&oh=00_Af8E3L0q3cfzGiQkUhzw5yttJOP3jAnZYHFqB56MVxOn-A&oe=6A466767"}, {"file_name": "3.png", "id": "1283105810297657", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491828038_1283105813630990_4967299823778952867_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0W2Ig1KH9kQ7kNvwFFPfmD&_nc_oc=AdqJHk6Ye9OX3CNUFr0qFY6-3h-ZSu7_Ld3Qez154trZvebjzsO6UEcmlmU_R7ie5gg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-s3sT01hUVK46rx5mrm2-pc5B3fjXpLtak5Y5d2OeOZw&oe=6A467F10"}, {"file_name": "4.png", "id": "4442633395970035", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491824307_4442633412636700_587997238551523396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZ-DE12kmBkQ7kNvwFPvmlD&_nc_oc=Adot6SkbA7lX8F498aY2xg_Vv_jT7xQaAF_gC_AzEiZg0coyeNbxfoU9Qc9FkazXBFk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qC7Inzkw60_N8cnfOUnLLrVt-K0qJL69zR7BWrLClZg&oe=6A465E20"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Evidence Cleaner", "keywords": [], "long_description": " AFTERMATH CLEANER\n\nErase the evidence. Leave no trace.\nWhen deals go wrong, you\u2019re the one they call.\nStep into the role of a professional crime scene cleaner working for a powerful underground syndicate. Your job isn\u2019t to ask questions \u2014 it\u2019s to make problems disappear.\nScrub bloodstains from the floor. Bag weapons and shell casings. Wipe fingerprints before the police arrive. Drag bodies into vans under flickering neon lights. Destroy evidence in furnaces and dumpsters. And whatever you do\u2026 don\u2019t leave anything behind.\nIn this immersive VR experience built for Meta Quest, every job is hands-on, physical, and intense.\n\n\ud83e\uddf0 TRUE VR INTERACTION\n\nBuilt specifically for VR, every action is physical and immersive:\nGrab and bag weapons\nZip up body bags by hand\nDrag heavy loads across the floor\nScrub stains with realistic motion\nSeal trash bags and toss them into dumpsters\nBurn or dissolve evidence in disposal units\nUse UV scanners to reveal hidden blood and fingerprints\nNo buttons. No shortcuts. Just you and the mess.\n\n\ud83d\udea8 TIME IS NOT ON YOUR SIDE\n\nYou\u2019re not alone.\nPolice sirens grow closer. Neighbors get suspicious. Noise attracts attention. The longer you stay, the higher the risk.\nWork fast. Stay quiet. Finish the job.\n\nThey make the mess. You erase it.", "short_description": "Clean crime scenes for a powerful syndicate. Bag the evidence, erase the blood, and disappear before the cops arrive. No questions asked."}]}, "developer_name": null, "developer_privacy_policy_url": "https://titanzgamez.blogspot.com/2025/09/privacy-policy-for-titanz-games-last.html", "developer_terms_of_service_url": null, "publisher_name": "Titanz Game", "support_website_url": null, "website_url": "https://titanzgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25745997141690265"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "2794685047575093"}, {"status": "PUBLISHED", "id": "4328110467468274"}, {"status": "PUBLISHED", "id": "1706664960491994"}, {"status": "PUBLISHED", "id": "991599853338054"}, {"status": "PUBLISHED", "id": "992730900177206"}, {"status": "PUBLISHED", "id": "833040083182430"}, {"status": "PUBLISHED", "id": "2117488455735838"}, {"status": "PUBLISHED"
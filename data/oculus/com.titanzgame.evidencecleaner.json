cdn.com/v/t64.5771-25/491828008_810117252115681_1892713764293887939_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9-OtieKKi8Q7kNvwEqGYkl&_nc_oc=Adr8VYOjj1TjV8Zd-N_DB24CzM_pIEjRx8qhU8zQSBt7GNtM8rwTkgkMuPZ9HumS02A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cOYj8pBIy6mSceRtojTqqY8SbyAzRN0GlgMJJEOK_pQ&oe=6A3FDFAA"}, {"file_name": "2.png", "id": "1174378824558231", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823271_1174378827891564_6039918947362507738_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KI245MjzMg0Q7kNvwGYb3XZ&_nc_oc=Adp8Rj6eMTNxtRwBvBgF0oMcm7AYlZ4Bac7Eh1dDnGxXIiueFgY-ZCt2RrlyAOB16F8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TZ80RNNDJ6nx62_k2fWTF0wDUE-qlXQTA2kBpt6ltVA&oe=6A3FCFE7"}, {"file_name": "3.png", "id": "1283105810297657", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828038_1283105813630990_4967299823778952867_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwQWYVgiSkwQ7kNvwGz-Xhp&_nc_oc=AdpDR5FBbqQ8d-IZn9w3WpGIzyLznYBc2p1w1_AhYqfOoFeIlI9V5ZJPCShqVKtJgiE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PW2ZX06cn8VbR99qQefj6uxaMMfPLuTC8NvWeA6t6eQ&oe=6A3FE790"}, {"file_name": "4.png", "id": "4442633395970035", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_4442633412636700_587997238551523396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdLV7g4vk0UQ7kNvwFdSzB-&_nc_oc=Ado5QLZ9ZKLj5Y9tKenOslfzIh2Ax-GKv720mfdqhf4L4Q7GgwmhuGK8AF5WDjsIe94&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--2qGgW7bxHGCh0L8KcGmDdVnkENs8TRESt6kEY0MMBg&oe=6A3FC6A0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Evidence Cleaner", "keywords": [], "long_description": " AFTERMATH CLEANER\n\nErase the evidence. Leave no trace.\nWhen deals go wrong, you\u2019re the one they call.\nStep into the role of a professional crime scene cleaner working for a powerful underground syndicate. Your job isn\u2019t to ask questions \u2014 it\u2019s to make problems disappear.\nScrub bloodstains from the floor. Bag weapons and shell casings. Wipe fingerprints before the police arrive. Drag bodies into vans under flickering neon lights. Destroy evidence in furnaces and dumpsters. And whatever you do\u2026 don\u2019t leave anything behind.\nIn this immersive VR experience built for Meta Quest, every job is hands-on, physical, and intense.\n\n\ud83e\uddf0 TRUE VR INTERACTION\n\nBuilt specifically for VR, every action is physical and immersive:\nGrab and bag weapons\nZip up body bags by hand\nDrag heavy loads across the floor\nScrub stains with realistic motion\nSeal trash bags and toss them into dumpsters\nBurn or dissolve evidence in disposal units\nUse UV scanners to reveal hidden blood and fingerprints\nNo buttons. No shortcuts. Just you and the mess.\n\n\ud83d\udea8 TIME IS NOT ON YOUR SIDE\n\nYou\u2019re not alone.\nPolice sirens grow closer. Neighbors get suspicious. Noise attracts attention. The longer you stay, the higher the risk.\nWork fast. Stay quiet. Finish the job.\n\nThey make the mess. You erase it.", "short_description": "Clean crime scenes for a powerful syndicate. Bag the evidence, erase the blood, and disappear before the cops arrive. No questions asked."}]}, "developer_name": null, "developer_privacy_policy_url": "https://titanzgamez.blogspot.com/2025/09/privacy-policy-for-titanz-games-last.html", "developer_terms_of_service_url": null, "publisher_name": "Titanz Game", "support_website_url": null, "website_url": "https://titanzgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommen
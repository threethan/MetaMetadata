.com&_nc_ss=7f20f&oh=00_AQJDd_W2nrEs-Z-v6a7vzvUJkig5WxCPJ4eJVGbSlBLnrA&oe=6A9ED8F8"}]}, "id": "2224792158364689", "locale": "en_US", "screenshots": [{"file_name": "VrCrimeScene_027.png", "id": "1033664792852418", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507823984_1033664796185751_9068788624970301193_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uBD55UZqP0Q7kNvwHw7Bg2&_nc_oc=AdpWDHPvRjYPXw2SvJC69-YEQbx7mF5vbyyQU1hz1-I7jJ7U-VJZ8H8i40eb-x5Dqrk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSaKXYCFRSsMqRjNF1fUf-aWoVs1o-FIr4mIA6zKGenQ&oe=6A9EAD93"}, {"file_name": "VrCrimeScene_031.png", "id": "1032430906315983", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507823854_1032430909649316_5156613054681507103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOLmciyIGrYQ7kNvwE53bbo&_nc_oc=AdpgUQ4-OoSxiC4lfDmiTHhLU9ySKGrzWr-RkTHJcmZh2bkYWS2TumUfMBuURQkRqPM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9gSP87qltTIpGwlmGxnEXCRGsymzVWTQDCJ_pVvO7eQ&oe=6A9EB255"}, {"file_name": "VrCrimeScene_036.png", "id": "1017106384287441", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310726_1017106387620774_5115334963898809119_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2L6U7StVkiUQ7kNvwH7g2-7&_nc_oc=Adrzh_d-hEkTd26fl6JQphA84FIBkIYjME5dkEJ-fDMbt70gOToD8N-dx61LAjKUSiY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5EDvMmadBEJ-b3Xsxgjylsc1EKvoaR4pTuNi7FTX23Q&oe=6A9EE046"}, {"file_name": "VrCrimeScene_033.png", "id": "4430808197144012", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311597_4430808200477345_1527824882406564660_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJOr839X5AUQ7kNvwEEvU5W&_nc_oc=Adrdjq_xcHsneS_FfjiH1SDyvEC_cMwAyPs7Du5YRan3ykke8t120-fANIQxE48-478&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLI3G-x0dPnkAOZpfG5cL46S9mOStc0XPa3FfK2yiHOhA&oe=6A9EAEFC"}, {"file_name": "VrCrimeScene_039.png", "id": "1346526007538235", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311582_1346526014204901_2858409479676968524_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9Kckm75JIQQ7kNvwHvDqJ0&_nc_oc=Adq8l305i4MSXM4YjwHFB7WPs30GNjNTZQfeeD_55lvp6q4EXRww5Q1cQM-xQ8LQh5E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi9_3MnRbBcsgNqPEOyIOtrKrI1NVnlaSpCBktQGBBDA&oe=6A9ED8EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image.png", "id": "1001648129080774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_1001648132414107_9064792936313083258_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USAOcc6dKWEQ7kNvwELsOmt&_nc_oc=AdprahOJ-HeOLI4Hrgxl1B9o5vzy4vL0kCzkxv67QUaQt1dxSR1lt3oXMO3jWlJhAaY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnaz8g0-hsxkt8lYJ1eqFOFCYG4GGklDydOfEpXm0Npg&oe=6A9EAC13"}, "display_name": "The Evidence Cleaner", "keywords": ["simulation", "interactive", "story", "roleplay", "crime"], "long_description": "Step into the criminal underworld in the definitive tactile VR crime scene cleaner simulator on Meta Quest. When the mob leaves behind a bloody aftermath, you are the specialist sent in to sanitize the room. Bag forensic evidence, scrub bloodstained surfaces, dispose of bodies, and erase every trace before sirens echo outside.\n\n{27851503227775729}\n{951827994558541}\n\nTACTILE VR CLEANUP & PHYSICS\n\nManual Disposal & Heavy Physics: Drag heavy corpses, zip body bags with your own hands, load incinerators, and chemically dissolve biological remains. Every object reacts with 1:1 physical weight\u2014no button shortcuts.\n\nForensic Tools & UV Scanners: Wield specialized UV blacklights, chemical sprays, and black-market detectors to uncover microscopic blood splatter, hidden shell casings, and wiped fingerprints across walls and floors.\n\nEvidence Destruction & Sanitization: Scrub bloodstains using realistic pressure and motion. Pack murder weapons, dissolve illicit contraband in acid baths, and sanitize entire crime scenes to pass strict police forensic sweeps.\n\nHigh-Stakes Countdown & Stealth Pressure: Sirens draw closer and suspicious neighbors linger outside. Manage your time, maintain stealth, and work under intense psychological pressure where one overlooked droplet means prison.\n\nComfort-Focused Gameplay: Designed from the ground up for seated, standing, or room-scale setups. Smooth, natural physical interactions provide deep immersion with zero motion sickness.\n\nThey make the mess. You erase the evidence.", "short_description": "Step into the underworld as the mob\u2019s cleanup specialist in this tense VR crime scene cleaner simulator! Scrub blood, bag forensic evidence, dispose of bodies, and sanitize grisly crime scenes before police arrive. Master tactile tools, UV blacklights, and stealth cleanup under pressure in a high-stakes, physics-driven simulation. Leave zero trace, collect your pay, and vanish."}]}, "developer_name": null, "developer_privacy_policy_url": "https://titanzgamez.blogspot.com/2025/09/privacy-policy-for-titanz-games-last.html", "developer_terms_of_service_url": null, "publisher_name": "Titanz Game", "support_website_url": null, "website_url": "https://titanzgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27817166627906629"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sconte
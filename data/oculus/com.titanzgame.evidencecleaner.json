71-25/499300910_888209370512178_2796559195675715682_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBfV-kP00QEQ7kNvwGwF9OA&_nc_oc=AdqG31xRWTleFZBdUHU2qx4pSODacAZPWB-RPKiiHgq07UZr-hTN56SrRHfDG59mTLU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZsIN0RxYQX2vZLUSNaNsrvZNWYO1wGxM_QSwKkISdfQ&oe=6A859F36"}, {"file_name": "02.png", "id": "810117248782348", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491828008_810117252115681_1892713764293887939_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8rFUnfdEyQQ7kNvwGGRraV&_nc_oc=AdpF3nF8JGaTIj3TLo1enIzpsu6ehiV6tVhGbD4_lPa5UPALuRWy8bR6HDdhVnZzA9Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXjZElffPQrN7zvWVEsd_T8UIcaLnOREjdkcwKOA_XaQ&oe=6A8586EA"}, {"file_name": "2.png", "id": "1174378824558231", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823271_1174378827891564_6039918947362507738_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2icROWJktEQ7kNvwEkpl2f&_nc_oc=AdreGIs_a-xDKiS3q5xYTa31hzUvS_LEZ3j2JMwwYTMPv23Uo66zsfVtC86lLr-ym3U&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhIZPAHP_7GAQkdQIjOvt2K1lzuW0yglMknHeevzfJ0w&oe=6A85AF67"}, {"file_name": "3.png", "id": "1283105810297657", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491828038_1283105813630990_4967299823778952867_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PZ-NKEptxQQ7kNvwHiDaCd&_nc_oc=Adr9vm3F9IflPdKyo4PGM0USSOxkvoYdeBf2WYTRd5Mblmr5XY6F7ii4ZdXYsNurmho&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbCMKyhU7Kcq-_B1lVHhrHbYRZZ5Kp5IJVdos31CvRRQ&oe=6A858ED0"}, {"file_name": "4.png", "id": "4442633395970035", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491824307_4442633412636700_587997238551523396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wl64X_Enkr8Q7kNvwHHDtI_&_nc_oc=AdpbRrYi0fIX2IkAjMBYYfpzJeCTjibFxh_-xekK7d1RkyYMTMV6_PncDid0iXZQfMw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKygbhHbVfRbdosoiePEuBhDYmraRpamOHTSJS30tthA&oe=6A85A620"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Evidence Cleaner", "keywords": [], "long_description": " AFTERMATH CLEANER\n\nErase the evidence. Leave no trace.\nWhen deals go wrong, you\u2019re the one they call.\nStep into the role of a professional crime scene cleaner working for a powerful underground syndicate. Your job isn\u2019t to ask questions \u2014 it\u2019s to make problems disappear.\nScrub bloodstains from the floor. Bag weapons and shell casings. Wipe fingerprints before the police arrive. Drag bodies into vans under flickering neon lights. Destroy evidence in furnaces and dumpsters. And whatever you do\u2026 don\u2019t leave anything behind.\nIn this immersive VR experience built for Meta Quest, every job is hands-on, physical, and intense.\n\n\ud83e\uddf0 TRUE VR INTERACTION\n\nBuilt specifically for VR, every action is physical and immersive:\nGrab and bag weapons\nZip up body bags by hand\nDrag heavy loads across the floor\nScrub stains with realistic motion\nSeal trash bags and toss them into dumpsters\nBurn or dissolve evidence in disposal units\nUse UV scanners to reveal hidden blood and fingerprints\nNo buttons. No shortcuts. Just you and the mess.\n\n\ud83d\udea8 TIME IS NOT ON YOUR SIDE\n\nYou\u2019re not alone.\nPolice sirens grow closer. Neighbors get suspicious. Noise attracts attention. The longer you stay, the higher the risk.\nWork fast. Stay quiet. Finish the job.\n\nThey make the mess. You erase it.", "short_description": "Clean crime scenes for a powerful syndicate. Bag the evidence, erase the blood, and disappear before the cops arrive. No questions asked."}]}, "developer_name": null, "developer_privacy_policy_url": "https://titanzgamez.blogspot.com/2025/09/privacy-policy-for-titanz-games-last.html", "developer_terms_of_service_url": null, "publisher_name": "Titanz Game", "support_website_url": null, "website_url": "https://titanzgame.com/", "cat
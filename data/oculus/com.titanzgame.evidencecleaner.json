0_888209370512178_2796559195675715682_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOPRN6PK4sAQ7kNvwHsvPAi&_nc_oc=Adqa_QATZiANKNCqFkoOTAIXjJPDCPmPo-Nw7or7aGD4Uk6ABxRRSapMy1zLLfy-4Y4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMDy2HO3Yie2jtCRzcI60OkK4QjyxYivmPzCv7OmfVbw&oe=6A747BB6"}, {"file_name": "02.png", "id": "810117248782348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828008_810117252115681_1892713764293887939_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAw-hTdYBpsQ7kNvwEYqIYx&_nc_oc=AdqSjuODQEYJUHprxQbOIPjE36boEPiGeaJ3AIWEdkbPml-aTk1G6PG5hzNAYK-9Hxs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKQemhpS4TiZklAwrfJ0zIxdP3tdju1_blDkXm2whltw&oe=6A749BAA"}, {"file_name": "2.png", "id": "1174378824558231", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823271_1174378827891564_6039918947362507738_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwghubQzezYQ7kNvwH3kvIE&_nc_oc=AdqpeZ1Pw2p-Vjmw5oYzSlRHhrqpwe8bV_uVl06o3MV-b_9frWXvQbgWV1vrmjqwLqc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEtnfjxcPpWvL4DJBD21hgYuX3WGcgXkb1iFhuvPBqpA&oe=6A748BE7"}, {"file_name": "3.png", "id": "1283105810297657", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828038_1283105813630990_4967299823778952867_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sB3bJgILMTsQ7kNvwH1huAS&_nc_oc=AdpK_mnlOWJ6VMLXAR8CRvnWn04x6Nx9KrYobBdxgNCK1SPzlKiq8s0pP6eIARQwWXc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErHZ3lGHZlnQe_NjdaGWj6zbCTzpVBN_BowlwIC6vz2w&oe=6A74A390"}, {"file_name": "4.png", "id": "4442633395970035", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824307_4442633412636700_587997238551523396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CKLxuEeoe8Q7kNvwH6GOqa&_nc_oc=Adqu9LMx4n2kLLL71AFUElzzWejZipxmbOg5SwYk4RzUNjJ7CSF6BAaWCa0G5MPly_g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHuxNHj3cO9BstbuZNjvwNDYDH2uZ7xtsehbJBq0oAMQ&oe=6A7482A0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Evidence Cleaner", "keywords": [], "long_description": " AFTERMATH CLEANER\n\nErase the evidence. Leave no trace.\nWhen deals go wrong, you\u2019re the one they call.\nStep into the role of a professional crime scene cleaner working for a powerful underground syndicate. Your job isn\u2019t to ask questions \u2014 it\u2019s to make problems disappear.\nScrub bloodstains from the floor. Bag weapons and shell casings. Wipe fingerprints before the police arrive. Drag bodies into vans under flickering neon lights. Destroy evidence in furnaces and dumpsters. And whatever you do\u2026 don\u2019t leave anything behind.\nIn this immersive VR experience built for Meta Quest, every job is hands-on, physical, and intense.\n\n\ud83e\uddf0 TRUE VR INTERACTION\n\nBuilt specifically for VR, every action is physical and immersive:\nGrab and bag weapons\nZip up body bags by hand\nDrag heavy loads across the floor\nScrub stains with realistic motion\nSeal trash bags and toss them into dumpsters\nBurn or dissolve evidence in disposal units\nUse UV scanners to reveal hidden blood and fingerprints\nNo buttons. No shortcuts. Just you and the mess.\n\n\ud83d\udea8 TIME IS NOT ON YOUR SIDE\n\nYou\u2019re not alone.\nPolice sirens grow closer. Neighbors get suspicious. Noise attracts attention. The longer you stay, the higher the risk.\nWork fast. Stay quiet. Finish the job.\n\nThey make the mess. You erase it.", "short_description": "Clean crime scenes for a powerful syndicate. Bag the evidence, erase the blood, and disappear before the cops arrive. No questions asked."}]}, "developer_name": null, "developer_privacy_policy_url": "https://titanzgamez.blogspot.com/2025/09/privacy-policy-for-titanz-games-last.html", "developer_terms_of_service_url": null, "publisher_name": "Titanz Game", "support_website_url": null, "website_url": "https://titanzgame.com/", "category": null, "comfor
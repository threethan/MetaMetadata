10_888209370512178_2796559195675715682_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBfV-kP00QEQ7kNvwFp2M4t&_nc_oc=AdqqucVY-YulGvEzDZSH1ZEofewmvuQRvnIXneT_VguiZ8S3hoRy0hnn7XMdPD1QtY8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH31bhwWTHDiu6j_urarS9Uern_nEWNqQUrstumkSq6Cg&oe=6A82FC36"}, {"file_name": "02.png", "id": "810117248782348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828008_810117252115681_1892713764293887939_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsl9LZ6HzyoQ7kNvwFi0NmP&_nc_oc=AdofpmYjUZuR1sqLjutDoMz4gpd7ApB2aCRFplS8nF_mb-c-9koDOuHk36a5-cAaemk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEweMCuSpwd2w3O9VRMlZkcUEdPeXhode_Onpnl4m76Vw&oe=6A82E3EA"}, {"file_name": "2.png", "id": "1174378824558231", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823271_1174378827891564_6039918947362507738_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2icROWJktEQ7kNvwEVKalt&_nc_oc=AdpjG-GKzBT5dBBky9IReu_EzPRaggqyiC87BI23vCJs354rpIoIdX1167J7vJz8jq8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqBPAqwez7FTczsY5LUgyssh5WBifT7Q2YJy4wBZTeZw&oe=6A830C67"}, {"file_name": "3.png", "id": "1283105810297657", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828038_1283105813630990_4967299823778952867_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBeLJNlM-YYQ7kNvwHy1zY0&_nc_oc=Adq1iOjT_d0a30nEXKbAw_0_jf54hD1hJVvf-oyHvX_R7Kh7cbLTdNic8uJaCPF2FD0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPMjqysfh3oVVo3aWdsLSUFGfqiWDizdUlFfSdognsvw&oe=6A82EBD0"}, {"file_name": "4.png", "id": "4442633395970035", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824307_4442633412636700_587997238551523396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpuUJdlDqP0Q7kNvwFhH-HY&_nc_oc=AdrvYyo2vb7yVKbj6AMuQyGruofc4-M1RN-08NkP18VuZMD63ZFnk43jpU9MO6ID8xQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHa17wmrc3yDxIIZDdKkEnF94geOHsJ-T7g7ufVt27a8A&oe=6A830320"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Evidence Cleaner", "keywords": [], "long_description": " AFTERMATH CLEANER\n\nErase the evidence. Leave no trace.\nWhen deals go wrong, you\u2019re the one they call.\nStep into the role of a professional crime scene cleaner working for a powerful underground syndicate. Your job isn\u2019t to ask questions \u2014 it\u2019s to make problems disappear.\nScrub bloodstains from the floor. Bag weapons and shell casings. Wipe fingerprints before the police arrive. Drag bodies into vans under flickering neon lights. Destroy evidence in furnaces and dumpsters. And whatever you do\u2026 don\u2019t leave anything behind.\nIn this immersive VR experience built for Meta Quest, every job is hands-on, physical, and intense.\n\n\ud83e\uddf0 TRUE VR INTERACTION\n\nBuilt specifically for VR, every action is physical and immersive:\nGrab and bag weapons\nZip up body bags by hand\nDrag heavy loads across the floor\nScrub stains with realistic motion\nSeal trash bags and toss them into dumpsters\nBurn or dissolve evidence in disposal units\nUse UV scanners to reveal hidden blood and fingerprints\nNo buttons. No shortcuts. Just you and the mess.\n\n\ud83d\udea8 TIME IS NOT ON YOUR SIDE\n\nYou\u2019re not alone.\nPolice sirens grow closer. Neighbors get suspicious. Noise attracts attention. The longer you stay, the higher the risk.\nWork fast. Stay quiet. Finish the job.\n\nThey make the mess. You erase it.", "short_description": "Clean crime scenes for a powerful syndicate. Bag the evidence, erase the blood, and disappear before the cops arrive. No questions asked."}]}, "developer_name": null, "developer_privacy_policy_url": "https://titanzgamez.blogspot.com/2025/09/privacy-policy-for-titanz-games-last.html", "developer_terms_of_service_url": null, "publisher_name": "Titanz Game", "support_website_url": null, "website_url": "https://titanzgame.com/", "category": null, "comfo
_OeYVw&oe=6AFDD157"}, {"file_name": "screenshot_2560x1440_2025-05-29_19-44-17.png", "id": "1211911700404682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499326419_1211911703738015_7370157915761056782_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpczDo_3awsQ7kNvwFRLlP4&_nc_oc=Ado1uG9V2s5Cn72XxMoq3ZSGe8tkS_FivdNm8iBzXUaSa9iBSOcsQN3MyI4N8xx03-E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRv33FpuRMaFmvw-50GsF79D-IpToyBALpz6z86e-LPvw&oe=6AFDE34E"}, {"file_name": "screenshot_2560x1440_2025-05-29_19-51-28.png", "id": "1374921520460917", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499324082_1374921523794250_8640015360685261510_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDptwIrqpnAQ7kNvwH8SoBI&_nc_oc=AdoNd-TqqPRJ7xD2zqh8KhUBj8lOBU1Tyb9LX3nuQapO3FP_3EA619j6dfE4FHqRiUM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmfQ_FyUhY6x8Et7tKEEqdHBLlGDt4wBadJ103bWMoxg&oe=6AFDC227"}, {"file_name": "screenshot_2560x1440_2025-05-29_19-49-54.png", "id": "711546661271962", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499328755_711546664605295_1086216232879754691_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8M3VJa8xOQYQ7kNvwFy3xoA&_nc_oc=Ado1EZ2azSjN5556u1PzvBaGoo-VPX1-P8VM_Lqh3usw7qRaYO06-5rNR_lyLDm_ZqI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDMv5wo3KnLnzpgCtCmrCWYnlLGMrufEF2g11sa02jhg&oe=6AFDE093"}, {"file_name": "screenshot_2560x1440_2025-05-29_19-48-10.png", "id": "677269761743744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499327103_677269765077077_9122765760059222165_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUsHgrmHL-kQ7kNvwGDv9wH&_nc_oc=Adqj8no94-yYkJ50qskaXcFc8GvQBfEpQDl1R7PtxkT68JWe2ENqo5wdrd_XCfzqAQg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0Y-itihyGYFkELWGmTVtwBTKWsrYKWFO3foIiCsNVgA&oe=6AFDB937"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Suburban Apes", "keywords": ["Suburban", "apes", "Apes"], "long_description": "You play as a nimble monkey granted the power of hand-based movement, thrown into the depths of a decaying, abandoned warehouse. The atmosphere is thick with tension\u2014rusted walls creak, shadows shift, and unspeakable horrors lurk around every corner. Each area hides new dangers, from stalking monsters to unpredictable traps that test your reflexes, awareness, and courage. Survival depends on your movement, wit, and a bit of luck as you explore the ruins and uncover the dark secrets buried within.\n\nBut amidst the chaos and fear, there\u2019s a beacon of joy\u2014the in-game shop. Here, the tone shifts from eerie to delightful. Use the Cardboard you've collected throughout your harrowing journey to unlock a wide variety of fun, colorful, and quirky cosmetics. From funky hats and silly glasses to vibrant outfits, you can transform your monkey into a walking bundle of personality and charm. Whether you're dodging monsters in a top hat or sprinting from danger in a banana suit, the shop is your happy escape from the horror. Customize your monkey, show off your style, and bring a bit of joy into the darkness.", "short_description": "You\u2019re a monkey with hand-based movement, trapped in a dark, abandoned warehouse crawling with terrifying monsters and deadly challenges. Survive the horrors, collect Cardboard, and escape to the cheerful in-game shop to unlock fun, vibrant cosmetics and customize your monkey in style!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/bd2b3882-5465-41c6-8bfa-b73f973d73ac", "developer_terms_of_service_url": null, "publisher_name": "Duckie Games Offical", "support_website_url": null, "website_url": "https://sites.google.com/view/suburban-apes/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "conte
EZpnUA&oe=6B0C51D7"}, {"file_name": "screenshot_2560x1440_2025-05-29_19-44-17.png", "id": "1211911700404682", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499326419_1211911703738015_7370157915761056782_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNwjPT7ywV0Q7kNvwHhzXon&_nc_oc=AdqL9s9t7RmYhWHfN4A7tqmOuYNqsUbNSUz-AyW23_kLLQQkrobcfibDHPzPDtK2xBc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSiMO0aeiRAcOsTgTay8Wie3Ll9hRn6-HNSmjsMEJyBIA&oe=6B0C63CE"}, {"file_name": "screenshot_2560x1440_2025-05-29_19-51-28.png", "id": "1374921520460917", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499324082_1374921523794250_8640015360685261510_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yOy_LaEvX8Q7kNvwEWIBvu&_nc_oc=Adpcm4C2k1LgCCcjjiScBQsuej6VmNdnPSOWxmop3cBUOGv0OgOv7dzM5SITsWYA1Us&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTEwm1Dc9vAu0e56aYvVE11Y1OenBevrKajIJxuukDEQg&oe=6B0C7AE7"}, {"file_name": "screenshot_2560x1440_2025-05-29_19-49-54.png", "id": "711546661271962", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499328755_711546664605295_1086216232879754691_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-j-_k75pgocQ7kNvwHjDRWW&_nc_oc=AdpWV2BjdVobE4gt-DqBxtXCBG2HxYRtSw6Sig3gGuh9xFEPlMC0mCrjMVJfMuvLyAQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS3eFzCJC94rgXTMFn61iIcH7rLwHCLZHbRYpsOhubDVA&oe=6B0C6113"}, {"file_name": "screenshot_2560x1440_2025-05-29_19-48-10.png", "id": "677269761743744", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499327103_677269765077077_9122765760059222165_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsB7dlfAIuMQ7kNvwEwa-xl&_nc_oc=AdrXa0ewMoc5hG2RWL6rHm0MNwQ46IMqx0escPECqs57_DIabuGmd00U_JR-Wlt2sfI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS5AP4kPJaGLoUPRuUO6xDu89bGX5Q2c0BI8ZgIy3zZhg&oe=6B0C71F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Suburban Apes", "keywords": ["Suburban", "apes", "Apes"], "long_description": "You play as a nimble monkey granted the power of hand-based movement, thrown into the depths of a decaying, abandoned warehouse. The atmosphere is thick with tension\u2014rusted walls creak, shadows shift, and unspeakable horrors lurk around every corner. Each area hides new dangers, from stalking monsters to unpredictable traps that test your reflexes, awareness, and courage. Survival depends on your movement, wit, and a bit of luck as you explore the ruins and uncover the dark secrets buried within.\n\nBut amidst the chaos and fear, there\u2019s a beacon of joy\u2014the in-game shop. Here, the tone shifts from eerie to delightful. Use the Cardboard you've collected throughout your harrowing journey to unlock a wide variety of fun, colorful, and quirky cosmetics. From funky hats and silly glasses to vibrant outfits, you can transform your monkey into a walking bundle of personality and charm. Whether you're dodging monsters in a top hat or sprinting from danger in a banana suit, the shop is your happy escape from the horror. Customize your monkey, show off your style, and bring a bit of joy into the darkness.", "short_description": "You\u2019re a monkey with hand-based movement, trapped in a dark, abandoned warehouse crawling with terrifying monsters and deadly challenges. Survive the horrors, collect Cardboard, and escape to the cheerful in-game shop to unlock fun, vibrant cosmetics and customize your monkey in style!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/bd2b3882-5465-41c6-8bfa-b73f973d73ac", "developer_terms_of_service_url": null, "publisher_name": "Duckie Games Offical", "support_website_url": null, "website_url": "https://sites.google.com/view/suburban-apes/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "conte
61056782_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43lQCIooLt0Q7kNvwGkz9ir&_nc_oc=AdpnIb9rovwH0y532JxIxJoBUK9ysFfixm0gS_wzq0NyCGqUHvwRyU24ZxGzB0Tknn8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5ydCZahRIeu6lpyZr5gbaNZvDeIIJoeDR5KAkT1MGew&oe=6A881D4E"}, {"file_name": "screenshot_2560x1440_2025-05-29_19-51-28.png", "id": "1374921520460917", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499324082_1374921523794250_8640015360685261510_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ez9d1xyyGIQ7kNvwHBWdVO&_nc_oc=AdqWX4reW48nvf1tm3cYdw3OYZIzuMcOOieiWwOUMjU-fxDpKZ_cWZvj_pGm10dbjmM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCV2w4m0JRkj5Qssdphntfbqqpx76-hDlkID8J3LYN_A&oe=6A883467"}, {"file_name": "screenshot_2560x1440_2025-05-29_19-49-54.png", "id": "711546661271962", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499328755_711546664605295_1086216232879754691_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fU6fg_Ub9UMQ7kNvwFUjvUA&_nc_oc=Adol1RzwubkfXKzyVQcJNK-4IH4N43uIkz0QHRAiWo9lKajaxB8KIXT_viAQzftqh-0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9pv50Jc9BxSszHgxwrMwscV6vbXkusxuZlg0pXS2U3Q&oe=6A8852D3"}, {"file_name": "screenshot_2560x1440_2025-05-29_19-48-10.png", "id": "677269761743744", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499327103_677269765077077_9122765760059222165_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFVu-77u78oQ7kNvwEp6BlG&_nc_oc=Adpmz6wqkTBNR1sotCHWbk3PwWQl8hXVeLzcN5JpYaedq5T0sSS-3AdoCQ1dxFHNi0U&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcEs1yEwHNnRm_jdigeNgReRiPSJSph3C24uEqWJHHBQ&oe=6A882B77"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Suburban Apes", "keywords": ["Suburban", "apes", "Apes"], "long_description": "You play as a nimble monkey granted the power of hand-based movement, thrown into the depths of a decaying, abandoned warehouse. The atmosphere is thick with tension\u2014rusted walls creak, shadows shift, and unspeakable horrors lurk around every corner. Each area hides new dangers, from stalking monsters to unpredictable traps that test your reflexes, awareness, and courage. Survival depends on your movement, wit, and a bit of luck as you explore the ruins and uncover the dark secrets buried within.\n\nBut amidst the chaos and fear, there\u2019s a beacon of joy\u2014the in-game shop. Here, the tone shifts from eerie to delightful. Use the Cardboard you've collected throughout your harrowing journey to unlock a wide variety of fun, colorful, and quirky cosmetics. From funky hats and silly glasses to vibrant outfits, you can transform your monkey into a walking bundle of personality and charm. Whether you're dodging monsters in a top hat or sprinting from danger in a banana suit, the shop is your happy escape from the horror. Customize your monkey, show off your style, and bring a bit of joy into the darkness.", "short_description": "You\u2019re a monkey with hand-based movement, trapped in a dark, abandoned warehouse crawling with terrifying monsters and deadly challenges. Survive the horrors, collect Cardboard, and escape to the cheerful in-game shop to unlock fun, vibrant cosmetics and customize your monkey in style!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/bd2b3882-5465-41c6-8bfa-b73f973d73ac", "developer_terms_of_service_url": null, "publisher_name": "Duckie Games Offical", "support_website_url": null, "website_url": "https://sites.google.com/view/suburban-apes/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEME
eL36103KNs0bkIalMeUs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWvm_tEWhnIes31E4eiZthrlI5l1JB12f8Mf7UiSflE9g&oe=6B0EF4D7"}, {"file_name": "screenshot_2560x1440_2025-05-29_19-44-17.png", "id": "1211911700404682", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499326419_1211911703738015_7370157915761056782_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfO2XQfczfkQ7kNvwGE5DOA&_nc_oc=AdplOw_AY8cmU8yvBNew4LOOA-YUJjTgGUrt6S78_R0AfynOeVLjIZOdHOmFrR_b8aA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXJZ7GL2jqTtiphGu8u4FIIPJkqpKer_1VVTLKKkEjHuw&oe=6B0F06CE"}, {"file_name": "screenshot_2560x1440_2025-05-29_19-51-28.png", "id": "1374921520460917", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499324082_1374921523794250_8640015360685261510_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yOy_LaEvX8Q7kNvwGs1n-6&_nc_oc=Adqjaoj54NjI50kJniE6WMiwiQCdSz4u-S8CS5MRXSL6jnsAvrp9ZoTSHUXBBBNVCOo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXhKDgV_2lvUTNSMmsbSgpcfm-M_8uDIcMPRhfpEQKvXw&oe=6B0F1DE7"}, {"file_name": "screenshot_2560x1440_2025-05-29_19-49-54.png", "id": "711546661271962", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499328755_711546664605295_1086216232879754691_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-j-_k75pgocQ7kNvwEIKn2Z&_nc_oc=AdpqSTim3rtO9g6kjcnOqZeL6bCUnyAYzJJT4WmAglAq_LiOihA7apO9tWpWbE2r4A4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXLvl048XUMSUlNJjG91VJEFFBCpoHBHqKUX-ecNt8T9Q&oe=6B0F0413"}, {"file_name": "screenshot_2560x1440_2025-05-29_19-48-10.png", "id": "677269761743744", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499327103_677269765077077_9122765760059222165_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsB7dlfAIuMQ7kNvwFL3HE1&_nc_oc=AdoORJB19-iD0Pw2F4jho3FAiFH5Az9kel1oS5gZm4IlKHOrgasrvitv1ayiAfsUnw8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXC4fGucObTJpWLBECygfQuKA9ruuSZgAp7fUEPqt22Qg&oe=6B0F14F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Suburban Apes", "keywords": ["Suburban", "apes", "Apes"], "long_description": "You play as a nimble monkey granted the power of hand-based movement, thrown into the depths of a decaying, abandoned warehouse. The atmosphere is thick with tension\u2014rusted walls creak, shadows shift, and unspeakable horrors lurk around every corner. Each area hides new dangers, from stalking monsters to unpredictable traps that test your reflexes, awareness, and courage. Survival depends on your movement, wit, and a bit of luck as you explore the ruins and uncover the dark secrets buried within.\n\nBut amidst the chaos and fear, there\u2019s a beacon of joy\u2014the in-game shop. Here, the tone shifts from eerie to delightful. Use the Cardboard you've collected throughout your harrowing journey to unlock a wide variety of fun, colorful, and quirky cosmetics. From funky hats and silly glasses to vibrant outfits, you can transform your monkey into a walking bundle of personality and charm. Whether you're dodging monsters in a top hat or sprinting from danger in a banana suit, the shop is your happy escape from the horror. Customize your monkey, show off your style, and bring a bit of joy into the darkness.", "short_description": "You\u2019re a monkey with hand-based movement, trapped in a dark, abandoned warehouse crawling with terrifying monsters and deadly challenges. Survive the horrors, collect Cardboard, and escape to the cheerful in-game shop to unlock fun, vibrant cosmetics and customize your monkey in style!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/bd2b3882-5465-41c6-8bfa-b73f973d73ac", "developer_terms_of_service_url": null, "publisher_name": "Duckie Games Offical", "support_website_url": null, "website_url": "https://si
51", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75429294_480603834407784_3206898464077532903_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_4LCpn6aUIQ7kNvwGcbWVk&_nc_oc=AdqZ-9QNUC6d-ArqvXg9rLqdFTRPOTl_HaideWwdNKfStBClZ41f0k7IeKVDlZgQHKk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShtsp-rv-77jQeiDV_N8Rs8yf5iXD6HR1tFnrkLOj-0A&oe=6B008216"}, {"file_name": "scPlay.png", "id": "1240189053857164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974474_1240189057190497_3799955361701678754_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATalioEx2JoQ7kNvwGGcLI6&_nc_oc=AdrpOEXBijLvZmHNh43pCb9eV_02NmP5nxk_ZxywPij9UZPhhpMp2ZUDubZKRocOHa4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRyFy0qZKGfyJP9w4iV4m3goR8u0qz7mVA1jU4xYTTHg&oe=6B00638B"}, {"file_name": "scPlay3.png", "id": "1506259210311462", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75312296_1506259213644795_2655806822820329749_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ng-XB2iTfr0Q7kNvwHQC3nX&_nc_oc=AdqKgHdOaelFze7b_IIuVFON8jksoVqOzp_pKPlfIR_EQeZMJG-L6VOUmSHA30GkAcE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVaenQ6ftnJe8Roos1qLuwcMaceJd64zECpJaGki7u6Q&oe=6B007C27"}, {"file_name": "scPlay2.png", "id": "2207621536241308", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031592_2207621539574641_9179296060724899124_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gwt_h7mCYJsQ7kNvwEushTb&_nc_oc=AdqpNyt2TVkxWTeDwR7e8Rk_43TwRmqcIJe9pWB45YX2kTejuBrApCRL8RaopGT0xSk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKSGc39_2td78BccorGEs8f09A0dyWA_k7fhKkLniAvw&oe=6B00721C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "447206038047211", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75356794_447206041380544_6211055712549725587_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOsJMWCxp3cQ7kNvwE8dcW-&_nc_oc=AdqaAZguPxJ2kVZlXeTe64bc51cpmwHWA8uBNQv4HyI4IEsABiYiJd_2j3SO6JeuPW4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ-OdAQOQu0gKT1eoZSGKoPfbrQy6j9LIJfb57OgnO-w&oe=6B006F23"}, "display_name": "LNG Front Deck Tour", "keywords": [], "long_description": "Step aboard the LNG Front Deck Tour and immerse yourself in the intricate world of liquefied natural gas (LNG) shipping.  Whether you are a maritime student, a professional in the LNG industry, or simply an enthusiast, this module offers a unique opportunity to explore and learn in a realistic virtual environment as highly detailed virtual representation of the front deck of an LNG ship, complete with accurate models of equipment and machinery used in real-life operations. It is an evolving educational module and will gradually improve with additional new features and interactive elements. Future updates will include: 1) Access additional areas of the ship for a more comprehensive exploration experience. 2) More interactive elements will be added, allowing users to perform a wider range of tasks and operations. 3) New educational content will be integrated to cover more complex aspects of LNG ship operations.", "short_description": "LNG Front Deck Tour is meticulously designed VR Module to provide an educational experience that familiarizes users with the setup of equipment and machinery on the front deck of an LNG ship. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vinceunity.wixsite.com/vince-s-3d-studio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VinceMeta Studio", "support_website_url": null, "website_url": "https://vinceunity.wixsite.com/vince-s-3d-studio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "5140877078687
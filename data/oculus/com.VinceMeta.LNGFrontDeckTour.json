51", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75429294_480603834407784_3206898464077532903_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynwvFilAnbYQ7kNvwHUgPOZ&_nc_oc=AdpbmCCC1l429eZmzaKXhVl1QVqhp8ITMyRzjETfdV_Id1ZS8fyJVXf4BI_yyufWbt0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDAVdeIRgRCurbCqNoTJZXDSkeymfE8lo_n19J_yH0vg&oe=6B086B16"}, {"file_name": "scPlay.png", "id": "1240189053857164", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974474_1240189057190497_3799955361701678754_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MA1WGx2Am9YQ7kNvwHBCKSn&_nc_oc=AdpNnQhUmJgPlz5rfLtRStIF67_Bxf5nbXrE6L_wp3kPwkfuSHpUFpveVbZNdFzHhqQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWkJ5qDDRccKNSbmqoAVRDXKz954noLtXO6Zv_InbWkQ&oe=6B084C8B"}, {"file_name": "scPlay3.png", "id": "1506259210311462", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75312296_1506259213644795_2655806822820329749_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwqB033vRSIQ7kNvwElsC-x&_nc_oc=AdpOgy2nEKT8tJ9eMzrPNmMSjCa5KfqdKd8x2L9ao6a9tlSHaHlfWAQK2bjg_VRNReo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR49qluGg2lI7GC1wWvVFhqgzpO2C7fOhVPZ3e0dqIEA&oe=6B086527"}, {"file_name": "scPlay2.png", "id": "2207621536241308", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39031592_2207621539574641_9179296060724899124_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wf79mHJ9viAQ7kNvwG-epJY&_nc_oc=AdomNfuCphYHN5z9DxpyWWrO6HgrbTquzNJFPDpi1a3r6bx0QvaHYQoYIadGn3kYqyQ&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSirTOFQTq35LBcasHhUacS6KJOs7oOJn4ymFsj76LGDQ&oe=6B085B1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "447206038047211", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75356794_447206041380544_6211055712549725587_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyyjN6oUau4Q7kNvwEuO2IL&_nc_oc=AdpWYz2qFjxGr9IZAJ8mF76Tx2FQF5xD8ObOM1Ev6AIfDUtXvft6NDKUhrQsE5t5oKE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT27_ZJ1I25myrnQ-Fkfs5XLOQ4-HWqdXY3wVQgx56Wsg&oe=6B085823"}, "display_name": "LNG Front Deck Tour", "keywords": [], "long_description": "Step aboard the LNG Front Deck Tour and immerse yourself in the intricate world of liquefied natural gas (LNG) shipping.  Whether you are a maritime student, a professional in the LNG industry, or simply an enthusiast, this module offers a unique opportunity to explore and learn in a realistic virtual environment as highly detailed virtual representation of the front deck of an LNG ship, complete with accurate models of equipment and machinery used in real-life operations. It is an evolving educational module and will gradually improve with additional new features and interactive elements. Future updates will include: 1) Access additional areas of the ship for a more comprehensive exploration experience. 2) More interactive elements will be added, allowing users to perform a wider range of tasks and operations. 3) New educational content will be integrated to cover more complex aspects of LNG ship operations.", "short_description": "LNG Front Deck Tour is meticulously designed VR Module to provide an educational experience that familiarizes users with the setup of equipment and machinery on the front deck of an LNG ship. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vinceunity.wixsite.com/vince-s-3d-studio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VinceMeta Studio", "support_website_url": null, "website_url": "https://vinceunity.wixsite.com/vince-s-3d-studio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "5140877078687
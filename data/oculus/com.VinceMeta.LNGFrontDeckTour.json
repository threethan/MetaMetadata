51", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75429294_480603834407784_3206898464077532903_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPPdWZmAEG4Q7kNvwEWbkL6&_nc_oc=AdoBxEa7Sa2qArIhm50YjrC-DVW8EthBgTZDkpvMEGcz4NDyYTRCKZ9fD3KjAVZUi-Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWe_Z3ShRFbJJGQqFcWHsjg_aLlBxBb2jPZbdlk2sZsUw&oe=6B105416"}, {"file_name": "scPlay.png", "id": "1240189053857164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974474_1240189057190497_3799955361701678754_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TD12osYLmnAQ7kNvwFg6QbA&_nc_oc=Ado2vrrLUOSrx8PTb9_UGNsRx4UQyhfCPiI_ki-TlubgJ3ySst7eKZK3VuD-R7KI_Ro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU319pUdwksVg9YqfgMv6nUOJcFxbH1gmvs-p_QroCuGA&oe=6B10358B"}, {"file_name": "scPlay3.png", "id": "1506259210311462", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75312296_1506259213644795_2655806822820329749_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSd6APOe8HIQ7kNvwFwkSdx&_nc_oc=AdpbxZGsl1a4JpGORubBTBOcsO9b9w4tmFH2X26Z645IWntOAlgyxwESbLYMTAHiwOo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXgvmRRs0xyfoPWiDA-6StynyRMr5bNVKvW2qf2y_Su9w&oe=6B104E27"}, {"file_name": "scPlay2.png", "id": "2207621536241308", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031592_2207621539574641_9179296060724899124_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CsX4xNKPuYQ7kNvwFE24nZ&_nc_oc=Ado-xOXaPekfvIZPeS-hV7nWiqxTVyffXxrznRy850jD0s27_vmjRrIVVwwYs-BcGzA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXI8q4kfog510i0aYX4up1prV5cq_BeV6rPSRxANq-qEA&oe=6B10441C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "447206038047211", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75356794_447206041380544_6211055712549725587_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYDoySsb51cQ7kNvwEUWIMR&_nc_oc=AdrRHI677XggZBnLZw6y5HbEMSUtktm1a9YpsG63aoO7F8CN5FJL6L6R53hdO6frb2k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWazrP2afZUGa6a0KgfkYQQjzSab75r18EJGlSZzO34aw&oe=6B104123"}, "display_name": "LNG Front Deck Tour", "keywords": [], "long_description": "Step aboard the LNG Front Deck Tour and immerse yourself in the intricate world of liquefied natural gas (LNG) shipping.  Whether you are a maritime student, a professional in the LNG industry, or simply an enthusiast, this module offers a unique opportunity to explore and learn in a realistic virtual environment as highly detailed virtual representation of the front deck of an LNG ship, complete with accurate models of equipment and machinery used in real-life operations. It is an evolving educational module and will gradually improve with additional new features and interactive elements. Future updates will include: 1) Access additional areas of the ship for a more comprehensive exploration experience. 2) More interactive elements will be added, allowing users to perform a wider range of tasks and operations. 3) New educational content will be integrated to cover more complex aspects of LNG ship operations.", "short_description": "LNG Front Deck Tour is meticulously designed VR Module to provide an educational experience that familiarizes users with the setup of equipment and machinery on the front deck of an LNG ship. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vinceunity.wixsite.com/vince-s-3d-studio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VinceMeta Studio", "support_website_url": null, "website_url": "https://vinceunity.wixsite.com/vince-s-3d-studio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "5140877078687
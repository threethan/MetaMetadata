51", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75429294_480603834407784_3206898464077532903_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXE2n3PyDJwQ7kNvwFJHApm&_nc_oc=AdrQalAkgw-MeQfew1ClhNScMQm1MgL0EX7cu4xjaIrlyi-iOny1bRRiQq_VoUB_hno&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR4BSp3gcLqO1G8xYsNcWXnCfOT_SlCoH9oDGzvGv_oQg&oe=6B0DB116"}, {"file_name": "scPlay.png", "id": "1240189053857164", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974474_1240189057190497_3799955361701678754_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TD12osYLmnAQ7kNvwGQ3nUN&_nc_oc=Adqqs5CcnQ5odQcWttZ8HSLA0rg2fDr2HROSbHw1Rxa0vvXnfDBzLU6cZr0NqdjVCQA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTDH4HuHcOV8yV6fVUvTGM9dpnIBj8OGVWgrCG1nopuOw&oe=6B0DCACB"}, {"file_name": "scPlay3.png", "id": "1506259210311462", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75312296_1506259213644795_2655806822820329749_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tc_Y_QDvKbMQ7kNvwHLtZ9F&_nc_oc=AdqWAiJktxAUW5hEJ4g4qbjTF_LEP100CiQfWiGXUNUTENf3Wgf2wiwRM1_imEnWZ4Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRVxT85S_P1rneNRBHRYLojGO7hhJMEEpr3GrzDqGcQsw&oe=6B0DAB27"}, {"file_name": "scPlay2.png", "id": "2207621536241308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031592_2207621539574641_9179296060724899124_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QzSFaVexR0Q7kNvwHrkmAe&_nc_oc=AdoD-mNNzjxicd9lBMGc8egBq4U51vryyApLIm5aBlE3W3I_H_WO6Cq84fyKtizz5Xw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSYAF8IIulmPUwy4ZcXCKn8MagMzBeVR72SJqxatjg1Cw&oe=6B0DA11C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "447206038047211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75356794_447206041380544_6211055712549725587_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcSNx5w38kMQ7kNvwEBX7xZ&_nc_oc=AdqtW5DiPN-z2tqc1zSdVdF8Zn56c2wJJkzzapdu51pZdWzYp6ASFIF9M10icjPbpiQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTWmpvGp3BEchP_i-6LYtNklhjaGErKQCkNjvGlzIdzGg&oe=6B0D9E23"}, "display_name": "LNG Front Deck Tour", "keywords": [], "long_description": "Step aboard the LNG Front Deck Tour and immerse yourself in the intricate world of liquefied natural gas (LNG) shipping.  Whether you are a maritime student, a professional in the LNG industry, or simply an enthusiast, this module offers a unique opportunity to explore and learn in a realistic virtual environment as highly detailed virtual representation of the front deck of an LNG ship, complete with accurate models of equipment and machinery used in real-life operations. It is an evolving educational module and will gradually improve with additional new features and interactive elements. Future updates will include: 1) Access additional areas of the ship for a more comprehensive exploration experience. 2) More interactive elements will be added, allowing users to perform a wider range of tasks and operations. 3) New educational content will be integrated to cover more complex aspects of LNG ship operations.", "short_description": "LNG Front Deck Tour is meticulously designed VR Module to provide an educational experience that familiarizes users with the setup of equipment and machinery on the front deck of an LNG ship. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vinceunity.wixsite.com/vince-s-3d-studio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VinceMeta Studio", "support_website_url": null, "website_url": "https://vinceunity.wixsite.com/vince-s-3d-studio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "5140877078687
cketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXE2n3PyDJwQ7kNvwG5nVz2&_nc_oc=AdrNmhC8LMa2bnh55RgpIAPTWcV4vkRwWXtnOzTxdqK1wem61FkNu4WEAelciJ9v2lc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV_lkHP0jpsM3fqHpE75h-p-R4ESGBSLbgNdlywwUZvyw&oe=6B0F0296"}, {"file_name": "scPlay.png", "id": "1240189053857164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974474_1240189057190497_3799955361701678754_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TD12osYLmnAQ7kNvwHW4jkA&_nc_oc=AdoC7z9PKdKZUj9tXzRmkif0xV_jFcWtspXyUGsNSM08MZqooIgdeRgCnU-ioxwa8UI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVA8ja8PyzUK3aWB0N6vsAnwlN3-4_t6GSz7FNyTgwH-A&oe=6B0F1C4B"}, {"file_name": "scPlay3.png", "id": "1506259210311462", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75312296_1506259213644795_2655806822820329749_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tc_Y_QDvKbMQ7kNvwFqgqCT&_nc_oc=AdoGTmRRrJSYKFS7P7APVLVwbync4ElcFnx2tmqBo19mhSsPtMPCzCjRkjlOO8boMcA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUFYpIBIU887W1YE2qKseNxDkF5tru0n3KZw2ubXXJYhQ&oe=6B0EFCA7"}, {"file_name": "scPlay2.png", "id": "2207621536241308", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031592_2207621539574641_9179296060724899124_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QzSFaVexR0Q7kNvwGsCJUU&_nc_oc=Adofoh8kms8hPApzLdpi68kHrpvh4zgll7F3cwmgILnFXU_tzqC6rXTpTMcj39fYVBk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUiZ-nLYqLp1GcACwEamQGv1ZdK-w02rtzydRX8Af1WHw&oe=6B0EF29C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "447206038047211", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75356794_447206041380544_6211055712549725587_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYDoySsb51cQ7kNvwGEoKcl&_nc_oc=AdoO8aiIghxtg6L05GHGKVY4AS3LOCAHISmdCrr_zf_RcQuysHh8W-yil_l0z3kBGkQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXHdAxJ4ZC2A3YEpGnIPXnyqhxrpx-mrbQ91ek6aX4Udg&oe=6B0EEFA3"}, "display_name": "LNG Front Deck Tour", "keywords": [], "long_description": "Step aboard the LNG Front Deck Tour and immerse yourself in the intricate world of liquefied natural gas (LNG) shipping.  Whether you are a maritime student, a professional in the LNG industry, or simply an enthusiast, this module offers a unique opportunity to explore and learn in a realistic virtual environment as highly detailed virtual representation of the front deck of an LNG ship, complete with accurate models of equipment and machinery used in real-life operations. It is an evolving educational module and will gradually improve with additional new features and interactive elements. Future updates will include: 1) Access additional areas of the ship for a more comprehensive exploration experience. 2) More interactive elements will be added, allowing users to perform a wider range of tasks and operations. 3) New educational content will be integrated to cover more complex aspects of LNG ship operations.", "short_description": "LNG Front Deck Tour is meticulously designed VR Module to provide an educational experience that familiarizes users with the setup of equipment and machinery on the front deck of an LNG ship. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vinceunity.wixsite.com/vince-s-3d-studio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VinceMeta Studio", "support_website_url": null, "website_url": "https://vinceunity.wixsite.com/vince-s-3d-studio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
51", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75429294_480603834407784_3206898464077532903_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehEIdJs1d1cQ7kNvwFMQbOY&_nc_oc=AdooaCM9k3tBsll9MEVgvwUivzcE4JA-ZkGwYjzNxx6I3Dg0ewTFLOt_Wrbmakiswa8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMHEPL7ogitt2zXzwYuR0-loxL4-PWNn7NzgSRwhOdaQ&oe=6B05C816"}, {"file_name": "scPlay.png", "id": "1240189053857164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974474_1240189057190497_3799955361701678754_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MA1WGx2Am9YQ7kNvwGcG8Py&_nc_oc=AdptofJY4Ks9_dQaNmbqD_iAql8EW6RLM0CioUJQhYHae7QY_Kt-0xZ9YHxB09cA1jM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4djEjzmujO-sYamIOuJGCIhq-9g4Hd02YW50PwIhkHw&oe=6B05A98B"}, {"file_name": "scPlay3.png", "id": "1506259210311462", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75312296_1506259213644795_2655806822820329749_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiYWJAEvdS0Q7kNvwEiywzf&_nc_oc=Adq7vtwwL9sEsAHRAZQGYHXwxIbIB7nDFtvIpx1IcpaTexS6zQkte2aiFzH-ESObZlM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHDmsr4sx1IoMnyj8v6AUdMjuthhTnatrGHz7h8Bxgrw&oe=6B05C227"}, {"file_name": "scPlay2.png", "id": "2207621536241308", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031592_2207621539574641_9179296060724899124_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgaeP8xX1GUQ7kNvwEroqik&_nc_oc=Adq_7T7eOEF4BJdAg_GAPaALFRFGzjK6W5IIVc_va4u4-xRYgW5ayBBvL2G-pUwC0vU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlk-NBw9q96HT65lMoZoOcjH-qcQWmy82EBY7KK6eeyw&oe=6B05B81C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "447206038047211", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75356794_447206041380544_6211055712549725587_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRe6Q5yYj98Q7kNvwHNBzdJ&_nc_oc=AdotGpKViHmYkuPtsC_OScJAzeBuT5Acq_ZGN044314v_PyQu_JbdfuIB7xnTRXUFdE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKkuaLp30-ehLEed438lCO5L4JfsIFL5amanM645tKmg&oe=6B05B523"}, "display_name": "LNG Front Deck Tour", "keywords": [], "long_description": "Step aboard the LNG Front Deck Tour and immerse yourself in the intricate world of liquefied natural gas (LNG) shipping.  Whether you are a maritime student, a professional in the LNG industry, or simply an enthusiast, this module offers a unique opportunity to explore and learn in a realistic virtual environment as highly detailed virtual representation of the front deck of an LNG ship, complete with accurate models of equipment and machinery used in real-life operations. It is an evolving educational module and will gradually improve with additional new features and interactive elements. Future updates will include: 1) Access additional areas of the ship for a more comprehensive exploration experience. 2) More interactive elements will be added, allowing users to perform a wider range of tasks and operations. 3) New educational content will be integrated to cover more complex aspects of LNG ship operations.", "short_description": "LNG Front Deck Tour is meticulously designed VR Module to provide an educational experience that familiarizes users with the setup of equipment and machinery on the front deck of an LNG ship. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vinceunity.wixsite.com/vince-s-3d-studio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VinceMeta Studio", "support_website_url": null, "website_url": "https://vinceunity.wixsite.com/vince-s-3d-studio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "5140877078687
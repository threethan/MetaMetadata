51", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75429294_480603834407784_3206898464077532903_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZreJuVL-D0Q7kNvwGKoYT_&_nc_oc=AdoFmOs0OrkTiD8QQhIHlMYuYeY3MGL-cKvdj4eEBFZLcCmyaiNfyhirJoAAAQAo9Us&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNM74YQvx-Pp_rXtPUGAeJa7oJVWttYyZ3H3paCPmXTA&oe=6AFC8D96"}, {"file_name": "scPlay.png", "id": "1240189053857164", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974474_1240189057190497_3799955361701678754_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WdfOriERiHIQ7kNvwGFDQdK&_nc_oc=AdpEwXdamUhUniy7ygWeFkjBFjPoaCa12_OPA7Vni3yfRitkyi2HeTZLUv3M1OLZtIU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcgiuoPAQzIwfRCEYg36oIZ60E6pYT1MsHIs4dyP-AgA&oe=6AFC6F0B"}, {"file_name": "scPlay3.png", "id": "1506259210311462", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75312296_1506259213644795_2655806822820329749_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uZjaX6_1KUQ7kNvwFO2rWV&_nc_oc=Adrnq3mRybbNSCOViWxlaTrT4cYWqY-MliLWb2xc796yjN5F0MJz7ZjxwbWNB6kou3c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgsHPyeep9ADoQECaIRcDS5QfcGSZBNI6Xoma8Lr_cWQ&oe=6AFC87A7"}, {"file_name": "scPlay2.png", "id": "2207621536241308", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031592_2207621539574641_9179296060724899124_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ju6NSvPa8rYQ7kNvwFbmNwH&_nc_oc=AdoM9fPsh8mOtFUffQ3gXbkfKMGodPcoWEjPZ5gtdjwil23N9TFb2IDEJhWZBdMbJUY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQ3t6C1uH-dFdhreP6KAIwRLH1z-BEFEdbMz1jncK_5Q&oe=6AFC7D9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "447206038047211", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75356794_447206041380544_6211055712549725587_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iv-REzVujm0Q7kNvwHvQaQz&_nc_oc=Adpbg6zlL9QuffbxYbP9NBk1kLHjM-aohDBeK3p3tEqNYApAr1XXVNZotjXWmlmU8_k&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTL1qTzeIER-ajQp54vxu5tsW7Z4ZVXZhsMvRon1vU4Rg&oe=6AFC7AA3"}, "display_name": "LNG Front Deck Tour", "keywords": [], "long_description": "Step aboard the LNG Front Deck Tour and immerse yourself in the intricate world of liquefied natural gas (LNG) shipping.  Whether you are a maritime student, a professional in the LNG industry, or simply an enthusiast, this module offers a unique opportunity to explore and learn in a realistic virtual environment as highly detailed virtual representation of the front deck of an LNG ship, complete with accurate models of equipment and machinery used in real-life operations. It is an evolving educational module and will gradually improve with additional new features and interactive elements. Future updates will include: 1) Access additional areas of the ship for a more comprehensive exploration experience. 2) More interactive elements will be added, allowing users to perform a wider range of tasks and operations. 3) New educational content will be integrated to cover more complex aspects of LNG ship operations.", "short_description": "LNG Front Deck Tour is meticulously designed VR Module to provide an educational experience that familiarizes users with the setup of equipment and machinery on the front deck of an LNG ship. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vinceunity.wixsite.com/vince-s-3d-studio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VinceMeta Studio", "support_website_url": null, "website_url": "https://vinceunity.wixsite.com/vince-s-3d-studio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "5140877078687
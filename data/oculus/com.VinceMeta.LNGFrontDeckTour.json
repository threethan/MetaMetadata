51", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75429294_480603834407784_3206898464077532903_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_4LCpn6aUIQ7kNvwFjePj3&_nc_oc=Ado1OKFh0XSadgFJX5wizOxoOaSie1L3cdGGx1rSpYSKfpywS2DUa3XqwdtQZLsytuE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2j0blcKuQh3mBqzzlUnZ1JcUXYwgkm-fD5bMZLyanKA&oe=6B032516"}, {"file_name": "scPlay.png", "id": "1240189053857164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974474_1240189057190497_3799955361701678754_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUZpRPFqbecQ7kNvwFHGwug&_nc_oc=AdpoZXYTgaRNhuttC01WQSGf3WIaXe6Q9VKhe5ynYaY3lS7-E_Vg45aalPQYOpY9UCI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQe1ryLHofBFnF20y8CD30HoneivbHj9mfKFcofh1hDrg&oe=6B03068B"}, {"file_name": "scPlay3.png", "id": "1506259210311462", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75312296_1506259213644795_2655806822820329749_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ng-XB2iTfr0Q7kNvwEc2m0l&_nc_oc=Adq-ce1RTUvu8jQPfUaEIIkJp2L9KslpWcXG8emqjDua4kkQkQmH_mxlwchTyUwAjjo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEs5cmFB8-dm1zuTwk-QNAWJtLPa2OSo5-KK0xRecYfg&oe=6B031F27"}, {"file_name": "scPlay2.png", "id": "2207621536241308", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031592_2207621539574641_9179296060724899124_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gwt_h7mCYJsQ7kNvwFfKrmd&_nc_oc=Adr4mNZidIL81peUmZ3uYpBnk4V4y9faGR3swOZTdMXshjvB-MCuEOjPppNxJER36gE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRpa0oTH5vvuIAiZT-ijRZuAAcC7eMNvX6eCULlcV1TA&oe=6B03151C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "447206038047211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75356794_447206041380544_6211055712549725587_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRe6Q5yYj98Q7kNvwFAvNF3&_nc_oc=AdobKPyl3cfxWSYFArB0wdvKR0gha6CVAMuw0xo-qXLy-ByCmVUrMNnyxnkKokKTmsA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6N4tdRsWeeh63oKiQZM_tmlXIAPiTdDuPbdiBL50jJg&oe=6B031223"}, "display_name": "LNG Front Deck Tour", "keywords": [], "long_description": "Step aboard the LNG Front Deck Tour and immerse yourself in the intricate world of liquefied natural gas (LNG) shipping.  Whether you are a maritime student, a professional in the LNG industry, or simply an enthusiast, this module offers a unique opportunity to explore and learn in a realistic virtual environment as highly detailed virtual representation of the front deck of an LNG ship, complete with accurate models of equipment and machinery used in real-life operations. It is an evolving educational module and will gradually improve with additional new features and interactive elements. Future updates will include: 1) Access additional areas of the ship for a more comprehensive exploration experience. 2) More interactive elements will be added, allowing users to perform a wider range of tasks and operations. 3) New educational content will be integrated to cover more complex aspects of LNG ship operations.", "short_description": "LNG Front Deck Tour is meticulously designed VR Module to provide an educational experience that familiarizes users with the setup of equipment and machinery on the front deck of an LNG ship. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vinceunity.wixsite.com/vince-s-3d-studio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VinceMeta Studio", "support_website_url": null, "website_url": "https://vinceunity.wixsite.com/vince-s-3d-studio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "5140877078687
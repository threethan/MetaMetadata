51", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75429294_480603834407784_3206898464077532903_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXE2n3PyDJwQ7kNvwFoZjgF&_nc_oc=Ado-ugDwdv3tOF6NRdLZth6EuHXawlA8lQLKIPIGgA21dyXOswk6kRvXzmoerNE9GzA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRpmJygbgQuEE_ZcGjQzOgqxHOecW1MezUnO1u15hTEUA&oe=6B0C5F96"}, {"file_name": "scPlay.png", "id": "1240189053857164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974474_1240189057190497_3799955361701678754_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcOnkh-Y2JIQ7kNvwHRyk7R&_nc_oc=AdqE6YbL4V1_xapkjFwXdfZ5jBCy1DLtZHBiBXkq6Ic1EcrQhwHL76gQHOnUDNmVylM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTUkfuXDgGq_uaOT0Np94ec778Z0E9NtrQgUbdoOGmFfQ&oe=6B0C794B"}, {"file_name": "scPlay3.png", "id": "1506259210311462", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75312296_1506259213644795_2655806822820329749_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tc_Y_QDvKbMQ7kNvwGOR9LK&_nc_oc=AdpgDWqWSGRJhQFo_2mYEEzZkmEldYlOdgtKNXX1Dg9bo3r2ULS6ma7kcswzhU7uXPA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSA8yb1UOUdp1yDTv1Ol3nz9C8AiaP9t5KzHXiwX4PooQ&oe=6B0C59A7"}, {"file_name": "scPlay2.png", "id": "2207621536241308", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031592_2207621539574641_9179296060724899124_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QzSFaVexR0Q7kNvwFNRnJb&_nc_oc=AdqDxgJ8sP3pPgOiT-RyGSFEmFmMAGhy_viG7AMC0HkRkNXrR9brkkk2KHNGNi-ogHg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRw9IXoGCiiRWAj4mF4yqhlnpNGptUNHVOmPIXilT5RZw&oe=6B0C4F9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "447206038047211", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75356794_447206041380544_6211055712549725587_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcSNx5w38kMQ7kNvwGHzp0R&_nc_oc=AdpkQlH0H04AeVKec96G4FuFu8G1DNfX_p-qdREMOi-bI_lVRTHJaWgRGejoVAJUOP8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRWHm_MDuouFF7eAQNtR2C50xxltLHr8RsWGS1E5GsCQg&oe=6B0C4CA3"}, "display_name": "LNG Front Deck Tour", "keywords": [], "long_description": "Step aboard the LNG Front Deck Tour and immerse yourself in the intricate world of liquefied natural gas (LNG) shipping.  Whether you are a maritime student, a professional in the LNG industry, or simply an enthusiast, this module offers a unique opportunity to explore and learn in a realistic virtual environment as highly detailed virtual representation of the front deck of an LNG ship, complete with accurate models of equipment and machinery used in real-life operations. It is an evolving educational module and will gradually improve with additional new features and interactive elements. Future updates will include: 1) Access additional areas of the ship for a more comprehensive exploration experience. 2) More interactive elements will be added, allowing users to perform a wider range of tasks and operations. 3) New educational content will be integrated to cover more complex aspects of LNG ship operations.", "short_description": "LNG Front Deck Tour is meticulously designed VR Module to provide an educational experience that familiarizes users with the setup of equipment and machinery on the front deck of an LNG ship. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vinceunity.wixsite.com/vince-s-3d-studio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VinceMeta Studio", "support_website_url": null, "website_url": "https://vinceunity.wixsite.com/vince-s-3d-studio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "5140877078687
yg3iKlSAcTTuPll5QxfOB1q_anVqJROTnaW9qhRJjCaLSNpt0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSF9T2-Cql5M_Zm6aXYxMGx58xwQAt5mqDtQglnRH7BQ&oe=6A996EE0"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbhURoT-NDUQ7kNvwE6gclo&_nc_oc=AdpujAv6iWcVBbRp77p8iD8bn3krUPpCg9pD1y30uIVEExTGNLxq33bULXqJLciaWlc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQL8Kbqo5Gi1qATBEea5BpvgZQ4wYdwfcomRV_JQNmVw&oe=6A9994C3"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7z4SQ3yksYsQ7kNvwG0dya1&_nc_oc=Adp6PIOXoJornbYWdmlRIaQhMhhrPEMVFPete2MPYWRcCokaheAscL7GsWwBWq73ML0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxE7iaMO-g7UZBWdugtuCF7QkMgOSpeR3xwJRkIhwLUQ&oe=6A9974C6"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mw5GE1HmmmkQ7kNvwEoikBQ&_nc_oc=AdoMypELKwUMLNSYpQMKQV9lStcmu6OEu8IVrpoJ0_weHg24IXEuTQM3cGIPlt52cWg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcDzIDFcWr6ptN0dxbcdDy9NeI0hB5qKQUMdiQlbdpnA&oe=6A9970AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJx0z3OTgOcQ7kNvwGGctGJ&_nc_oc=AdqFNRlEZYuODyf1w6q2ty8Djd2WjLpby-KtdiZjir_UIdasy2NCH_hMwQvmv98_5Ag&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNiWGDLJcCfBDxqZjP5L_0S83ZqL_VafAe67x_7QnUNQ&oe=6A999F73"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "supp
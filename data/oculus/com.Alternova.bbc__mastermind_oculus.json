aSvdZ01G3WZ5kPPp6X347K_DKMKNdhi37G1bo8Ztc8RaLUJKk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TSmhIx3MZ2PTl1Wu54lj1AMPPE48VEGV_3Aenh2Eatw&oe=69E37FE0"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVVWCF0_V2IQ7kNvwG-l6P7&_nc_oc=Adpn-0hRheGcElf-ZY3urVfTZLBJNyogNs3KAsEb2SI0Ej0Tjz9arFBq_YqG7L0drB0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Lifs6Hl96Qstsbc7pzRteBEfVYvso_-NGQdWWBiROOA&oe=69E36D83"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6IgPCPr9UUQ7kNvwGsWz9W&_nc_oc=AdpUsNGj_o2wHS0Qqr1CKnc2h7erS9E-63oZINW1xCs2Ojw97HEPNrq3Wnb_UQV0zbk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BKxQ0WPMKASGcu36s9OCrB00gS36opngrfQNYZvJwSQ&oe=69E385C6"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=to9Ba6bFi78Q7kNvwEXQcFU&_nc_oc=Adp4CNyw3arBwo4KI1YeO4kMikMFfCd_WqlsunqRYuQ3l4v7HQN-D9OUQmvRaTabbNg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QaYcmjQqg_Jn4ls5orbb0i6bLRXDP6KBRCOifJNbZAg&oe=69E381AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mk1Obm2RnxQQ7kNvwHNLceD&_nc_oc=AdohlY7uWu-Lsa2Ywoj79ceN7GCnL4TfItO5lDeEERtwe1tNX9MNwbMBkCuPmwhSwFo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xlQ-22jSkIhvHjYpci0RmaI3NOIbSITFQ8nIulaBX-Q&oe=69E37833"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "supp
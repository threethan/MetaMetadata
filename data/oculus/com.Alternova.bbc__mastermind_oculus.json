7", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820648_672558479040230_2121737053367225315_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-GdDsLpeh8Q7kNvwFuP5GB&_nc_oc=AdrTgwx0H26VlwiYAaT6DgPgiqEAhBwlW80-505GztbxJbgN-nsSNzLwPR26X9QDIVc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQfqUduKPJgJCcUBdKh4EPtDBtEu3l_4Uiwt7FWHXsmQ&oe=6AFB3620"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZG30x38kVdkQ7kNvwGgtd58&_nc_oc=Adr669JqjgInSeBfA7I7vUCun0VsGRNjFNTh9yXaC2O4f2ixkw8kVgj65DgKEXRdQ_E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCvDdLyLoW10WS8yRk7kXvWaEiy3A-JqpN0bNu7JXRAg&oe=6AFB23C3"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AeyNMVSCYZsQ7kNvwE0yKtw&_nc_oc=AdpI2JaMnMblkjq5mFbrZ3IJM4GqzamXCKrUuX5y9AfcVIs8xobjRTco3E00DwtKsyw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlJwaLFGXG6epnoWVMgAveaNgPHSqvm9HBhXJW2ZgdOg&oe=6AFB3C06"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Q07YeI61WIQ7kNvwEFRpDp&_nc_oc=AdpBgTaDCwRLpX68zwCbkrcYd4TtTBXRX4V1ZPkne2WgMrL3YhsR-rsQtZREJuAye-8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRupkU8Tl5_P7_hGlHLDbN-nylinnQWJgAPIa1sKh2eFw&oe=6AFB37ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9R8x0lxDHcEQ7kNvwF9-uSG&_nc_oc=AdoDo4Ain_JdCvv9b4R04Rz4exMWfos2j1ncDWY02TcgeEw-RvN6IZqTKhm6IXcUpGU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3FquMSW8cBZMM8Cjtp5zLoCs9_VwHGpbReBifmnjj5w&oe=6AFB2E73"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "support_website_url": null, "website_url": "https://www.mastermindtraining.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9596387467154417"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499304025_1225883172880859_6012924059810738950_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgEd6tubzUMQ7kNvwEquw5c&_nc_oc=Adoc1pb-t77poql4J-xPFjjt_Sa8-MiUI89AA9c_rjlty3lwcbKvZ9kplnoCQHia0FE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSR-vpgQN_jCqhxemLDKJZFpvV3G7S8P3dnWAqcg3WU8Q&oe=6AFB1BED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mastermind Cognitive Training", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1674104400, "lastRevision": {"nodes": [{"id": "5585815091545028", "release_type": "SCHEDULED", "admini
Yva96fv4d8fQVFnKn--ZuHDodgS_J-cGspDgVE4b1HMC63BuE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpnQPskH10l-f3AGB08d8bDuz5KJf0BPSm1YOcdLixeg&oe=6AD10620"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVMnVGbcSGgQ7kNvwFAcSx-&_nc_oc=AdosPBjJt7CVFPDHcsLoYbsVC9h3qbnIt-OcDdc8yGpkC6XXlHBzqRtN5ZQW5NeQ3cU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtLkfjDb5ppzWW8Oh3mX3iwpjmTiORdzwWyM4kUFmt0A&oe=6AD0F3C3"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvhfPrqOSzEQ7kNvwFirnEb&_nc_oc=Adpuw_j8k_TLpX1BsGI1sCkEHHxqHS78AC59yjmar2Y0WN0XpSwD169GmP-U9FxY6Ys&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXcY5b1YMaudZCeUkS0JPQq0bYwcOEOX16Qv0Gs8PFoA&oe=6AD0D3C6"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ABG4yeATRoQ7kNvwGEW6Em&_nc_oc=Adp7wiLLKBNv6tbSKzKfpaQn96tXNYumJ0rLyeN6R6TTnqpSAXq2D_dB-8iTm4z6vnc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4Kn9vdfCkXJdTgj3bk_k_hDYg2_F779WqFRu7YWO7_g&oe=6AD0CFAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvlV0V-z2n0Q7kNvwHcNYHX&_nc_oc=AdoHId2UPeUTvAX1MPk-DV2aOU2-kEp6YClBrJDbHsCq8sqxDO3nL3fwevP24Xq5EHY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO191FJDKGVBHtVSmh5c5vIayP6c-DCJ9TO3xC2HaWnxw&oe=6AD0FE73"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "supp
xvcZvLHB7gHk9HGbab5ih4aA-sT-BPnhuf9BgknGR301CIqjFk-goGc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPFtoGXw_XEg6vilctoHayrZi7kx41HF5SN-umqfSaoA&oe=6AA3FAE0"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiZMJO_vupEQ7kNvwE6z_Vi&_nc_oc=AdohHhyDCVK2hAPsHLOO4LXCpzamXhUseHBHfzZlyzWx1a0P-_8aQURgNMrRnUhVzF8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoacyA9YKFLWlIcffFW_UaEm3Wtd1EMuRsY3X5cfOoOg&oe=6AA420C3"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSYWRqm8P7UQ7kNvwHlueRq&_nc_oc=AdqMsOAxTzkTfXejydXR0Ab1J-0FRYnSiguvPCGGb6G3pfQqU5e-aZX3QlQIgX-9VMA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRBC2itoDgBBEVofDOVa1M8r3UE5JJyZ1iS6aVeXjs6A&oe=6AA400C6"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A19XJc5jAP0Q7kNvwEjQ-IP&_nc_oc=Ado1lj7MONZHx4O9RDURnz4sfqLTd8wPfP3E8gKcPnvtk-Ss4FCUwDvJ1dv4imiDxtc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4RhG3tTzfQcRoBfhgd1b5LRXIvGFWrq__ZAgISaRBww&oe=6AA3FCAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23VSjjqp14YQ7kNvwGYqsTs&_nc_oc=AdqHk6xlzbRp9LJ61ifOZEoI5ksWmoCibbSXWxS0aJOy982yah2PNuhkDPrdkfYPLAw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9qcnAul2_vY7IDozq3nFG2qX6UCML5XxiBtWAJ4Lp3A&oe=6AA3F333"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.
eVXb7fAn8VfgfwD3mzkARS0gxBsNta7ENfm-QgRtgU3rv7HQA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMA8vzeVEO9sotLc6JiBvKNO8HdilFKy2NWBVoLQ_lrVA&oe=6ADCAB60"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaCWBnTA7UQQ7kNvwGBpC7n&_nc_oc=AdrF5kqjyNe1t9DGd61Qg4DYzdpIGIfy08Cr_x1Si87wQt2ZdMhYQhzmdovZ8i0WmAI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYfB2UH1IDnhMt5jSTZVOEFmax1EQDCDL-wERsscEQDw&oe=6ADCD143"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggNs2hvGIeoQ7kNvwG0xwZx&_nc_oc=AdqdckvhC5SoLBGx87zWPNh1Jr5Vjzjw_Q0H17DOFhQdqbRnFWWDASypPZVDAvE_ipM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFXu0aeHRD4_923UrUSYrqqvTA4066Fz-VSDW7ORmVAQ&oe=6ADCB146"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmZ2h4VUXl4Q7kNvwHQKIzU&_nc_oc=Adqjb5aLUJJoXvdvbARENG7LoC7AlqNybd2sG03OmgUwl0jrCtJZ_iwtlAQX6SNO2vg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8sd58fT1pfeiANFA5FegEWz7G8ki4q827X-eM3bCoBg&oe=6ADCAD2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FBuU7GozNUQ7kNvwHRydWE&_nc_oc=Adp9-ZniQB9SlYlvNjGZQu-qVQFUTWZKAzZY-QlFw2iqVOiI7O2eSnCmCWarlm9gUio&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNe9xJoJQ4Q26xggsEEBNKgeSnPldQoizScx-8TS7cl_A&oe=6ADCA3B3"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "supp
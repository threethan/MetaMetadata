TBdqsjYLFlp2IFcPJKd01QUMo8GTKLqOKk-oNEAV6t3CflXQU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8OpfOgWx3FiLDJPuGD1lmEUAwvaLeUx3Ad2xFRFd2Mg&oe=6A2C0260"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVJ8oCUxtm4Q7kNvwH0C3Ma&_nc_oc=AdryVeF8JjBWt28Uj2K8m-A3dIACjKhrpkldxWof1f7daXdLIJviH69Daxp1FHS-fOg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0Lj0PL-Gs48sUcYGHsdj9GBB7pRLRep41wOrWnJmfWg&oe=6A2C2843"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYn4GlbQHqQQ7kNvwGyTv_E&_nc_oc=AdpxYGemP4zBCHnKiXmvWtcVonKzt_OX6q2M4Iq6t23ZbzgtU-iK6JQNbZyuoY1K6pE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AI-KLgqWEICFjOoBhdJNnr__kWM-UF1uF2soqzzkk5A&oe=6A2C0846"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3tySutXUaYQ7kNvwEDDfcO&_nc_oc=Adp3RHmwOr0haPM2smdJV2Ydz7FDUIPBl9yGYMWUtVX1OVv_iyLNqoAtHsWlG6P35V0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xUhxekUCjBhe4eciOwf34_rOpM6j2Hl6eqiPs9sOKoQ&oe=6A2C042D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dofh62HcILwQ7kNvwHGTLN4&_nc_oc=Ado0G9c3euh6dBgshqvGk50-TcDDcyBhJO3XKrkI-WYRIVqh1Oj-aUmqi9EsI1XWMPE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DeQMBlxcIGAYHUozd0IFLhkTEWXpVc4Hs3o0_VR-GNQ&oe=6A2C32F3"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "supp
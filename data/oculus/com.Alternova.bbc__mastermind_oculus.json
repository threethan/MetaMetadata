IH8wxkl5Yk1FZ3AZfxBYElhFSWGPicopbNj0-QuOlJR8yPC5Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTaqSn0v9cDttw105FAXu0ilLVUWkxezfdC41R7f8kCg&oe=6AECB5A0"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TrQ7598qJXgQ7kNvwGPN1Ki&_nc_oc=AdrpZ7hzmMvatB4jUDTDc4UozcZdy6dhzXbgs7MaKQ__AYzAbZCl2HBc8NTu_FqMn0A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMjy19qc-9VTXpSsgk1Km5QEiwfVDZaKgY22HMG4cduA&oe=6AECA343"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EBDqmmcPBcQ7kNvwFybK_E&_nc_oc=AdrgeckMzuIDkmq7ArBpPB_wuXSVu2p36K7sT_znqd3NP-wLJw2hBct9Zdxu8t_7_YA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9-GK9YnOwH0Ed_fK1qcRYXMXzAyXgHCfttB8N7HQTsA&oe=6AECBB86"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEDrmR3hLBIQ7kNvwE7bnVC&_nc_oc=AdpfMZTsXL1n2ATS71KEFQIUlmXnIjpiYtguthXXG7ERxEfdxAjqeUZZinOQfkEyH-w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwYoAcM4-fUuo8qJiMY6lHpGDLyH1t81l9Zu8qDbzq9Q&oe=6AECB76D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYWE7RXK7SYQ7kNvwHZG92T&_nc_oc=AdpnE9dzczmNZQUvNJuyu431sxqsWQk2KSc2gES2uaE4xGMTR2Z98TblO6Jvt3MxUac&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5ZwikIbsE6K_DZm5D4QRspAGeVIVjtOzcH8E2y6icBg&oe=6AECADF3"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "supp
gypMrBLe-X4Gv8_a0u6z1VvgzxtaRVYwB2fgTc-2FqeWMfCgbRN6T_4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsPemY4lf9-e5ARxh6qSeDTLJzFr7Xm5nAbmBsGhHFkA&oe=6AAE86E0"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEoLzsrK7iwQ7kNvwH1S2rE&_nc_oc=AdqEo9Zd-bBwqmlyZ7B5GtMgWJTZT_EUd63nZca0bPHXi5WoO80lR1f9M2HbH07-AU8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0xLwG9l6qJ60YaBf_Odxb3B-qmctbPkbb8Aae6VxEPg&oe=6AAEACC3"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=on8_lnXOE3AQ7kNvwEijwZ3&_nc_oc=AdpgffykbzokOEJpNbhMxE6gF0Id7Sh9Co3PPBfWuuqBrc2qSBZoP-IokBNMmAgF0vI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8hHakVXb04aYfaCP29DF1LKz5TrLP_bi5BQAppyckRg&oe=6AAE8CC6"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7_0ikIzZPUQ7kNvwGsrZft&_nc_oc=Adqv9RryNP1TQcv7SFlWhQ8FPbdI0K5E5RPM0bW3F0mYgRDzOgBR7jekwNo9XAK6jPg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbkKUv9dw4tUrn00L79hVno0IdaJ3D0waIICZge4MWYA&oe=6AAE88AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NZc575qqcYQ7kNvwFYEVE5&_nc_oc=Adp0TJNiLyEei0rNRxyjLZNn8h-P65yoT-JwwWSM4c9Oa0kOLmpdanI9ll_7dGYBcMQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3rGpbKgokyLZ9_ffan60Iy8bzfYCmzcc_6qqNqNasAA&oe=6AAE7F33"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.
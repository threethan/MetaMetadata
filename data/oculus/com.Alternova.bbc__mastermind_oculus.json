VDuMi6ZSCk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0B2MFvtiY7y2vbLGIFpyqn7Gll_rGCMaz2fOvAczsOBw&oe=69F20060"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHulVA7_IcIQ7kNvwG0ic2p&_nc_oc=AdqZKXyM6_sDrR_0C2OKo9U7SrQ0umTZVPfWNk1N5nJxuUbNiDyrNkeBca_pucEmwtY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3GbXA0-QTu4BjVnbsX24AgI3lHQ4iXHPw9XnAXoey5DQ&oe=69F1EE03"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAOBmhW_wTUQ7kNvwE7YfCw&_nc_oc=Ado_f4-pBD0zSM30sdCNedY_NgzWrziv9hcsfNeR5YeCqj-xWkaODi3L76PcGQJJmR8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2b9Bll_DlgfWdPORcGxIOLTOs2rElMxDENBIsxBVldpg&oe=69F20646"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMJVQ_7Yt-EQ7kNvwGpIKHr&_nc_oc=AdoDpU3A72FVFwgmdWwM4goZquteD7l8ctPxFSVKYe9FZaf3cFwOquySecXiPT9LxBY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0Mmat7umoicC9Vke8mtSsfsOyy_-IvXq04U6Ggz2FRiw&oe=69F2022D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhvI6-X-o1wQ7kNvwED-QXj&_nc_oc=AdoaVUSqKx-TKquPo_a_IQVK-uuXPq3MHu1KjTtVcnqPC28wlSvcgjyKYTCiEz3kLFE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1vSeJkpVa__T9_F_qgkAyPuLtqe67DB1g7UF8UZ6Zz_g&oe=69F1F8B3"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "support_website_url": null, "website_url": "https://www.mastermindtraining.com/", 
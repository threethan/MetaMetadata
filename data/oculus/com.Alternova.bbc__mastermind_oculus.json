C2SCb4E5oYPNujsrEFMWFunxHKdNmm5YjyR9IjiiOZc4xoN1E&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLxqFC3amI2ys4PsvvMM9TOoxzVdKpEc8cPsrykVPCXg&oe=6AD3A920"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1yfXW4IIuIQ7kNvwHGXF9t&_nc_oc=AdqNrgX3Ju-JzOmhsUSeoIvHfQZsDRPl6qhOqXdr9LbKWieJbnndOf90K0ko8Sw_tw4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkm4mY0o5EB3HFUqlp9OFuzACkNVdQkECoHCg6iUaQ3Q&oe=6AD396C3"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvhfPrqOSzEQ7kNvwFm_AQr&_nc_oc=AdpMVg8I5RrO1XZL-yAB_5--k4VD-GhUJy4Yz902W5sdEJbRSRy4QDc84cB2e5Fn6Mk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgCG8Amy-brHUQcHF2At0CJvfasNCKioy663CVlxnqqQ&oe=6AD3AF06"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCke5KJ5XqoQ7kNvwFxmTeI&_nc_oc=Adoa6lfkkGfZO87Vwh8WR_XdlR8AYwe_rQV3JNuRv-pr70MbV71AKxNCUu5PaWaRDVM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsUO4kKwFuXKcY_1rsAAMZQvWddsXYlnN9tljkIFORfg&oe=6AD3AAED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvlV0V-z2n0Q7kNvwHR5oFm&_nc_oc=AdqaruTYjh-RhsMhyCiTOV_4-DlBD2v_llH4Arz7_ULLFp93OzXPJrrVNXe5FAUBFis&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgm3h81aLg8ey0VMd4C7uIuvO8WM10LhwwNpa27fSI2Q&oe=6AD3A173"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "supp
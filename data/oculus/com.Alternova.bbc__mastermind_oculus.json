EYyqU7Ep4PVEymrR30iY3W_S7yeKsax7i3F68azkyW2z-_-_I&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0SgMmkdvR2zOmSzG7asmSIusyX67EO5DMRJHvcXPcIA&oe=6A563260"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-x4cREPWDIQ7kNvwH5x30t&_nc_oc=AdqPphrGRvrUfT_M8ZeK4PFy6xOIn0NJEasqHgtIb--Zs5I685W538IX6jBA-ThKzVo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZCn-kOyFw2-c4KtCgoN8ndKuSDtNjJu_332LSTN_YBw&oe=6A565843"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BRJouOi_vcQ7kNvwGgi9K7&_nc_oc=AdqFWntMU32-lKF-dNqQosnz68Md59cML2D9FaWNAamU_g29MYzGQPZNH0A7yWTNK-U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyI1tDh1zenkI9GN9tiDrsu07IRpHfVXqYimlrFwUn8g&oe=6A563846"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjGM5nx3XeQQ7kNvwEqcdfq&_nc_oc=AdrZ8uYayS61xoj7UhoQR2EwNOQ7Bjcyf9UH8PTgP2m-aSVDj1qflYgCLiO9hQHAfzk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXsaKeX01CcEXw9OOTT5lAaWz_vdkcCSKcusAw1NFz9A&oe=6A56342D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hc68sf4k_-EQ7kNvwGOosfl&_nc_oc=AdoIUaFuJ4XVSQwNoYM0aOFsbGsMAvW0OoJVJCN9-P9Dk0Yrw6aO-_9CiRU7kW7CjW4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAACYDDCiwx8-n_bTBAejXrIkM4lUTGKM_J-K-kIMLtew&oe=6A562AB3"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "supp
sotANuSWNwvJcbAaYMK0ZhIfL0AtKavssBZq-RohQvjToWj9I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wVMCM1D6arbgMMiWbunKW5LR_rHMJGC3rdHAkCveFxw&oe=6A0323E0"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l40JbsjQH08Q7kNvwGvA4DN&_nc_oc=AdqdmcWwod2SwM2QzI1PmN5Wapsh8WPUf_ucVG35b0VT0vnKGcH2gD8ONthyoXFiLWg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IpOJEqGrqwEGlQZ_2a46b1ruxXDJEzEmqhNF-aM1bNA&oe=6A031183"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9V8ufBV1GwQ7kNvwHhz51M&_nc_oc=Adof8NtGlL5AJEXwGIvHgXjOZ__IYwZtU9Ublw9D-A0w-x5e_1g8-1LOKdJV85BqgfQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af603vawElbp8ny79jiuAR80UuTCimtTmqIxQLGnYA32Ag&oe=6A0329C6"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xV3A6lH-ebAQ7kNvwHP98we&_nc_oc=AdrWHCsEgmwyjv9mWSukbfFXSHgFAuCvlT2e0oZ6jn1WgAtWJeGTVecMyoVtBPeRhgQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QNTaUzhLwarmSYWxWj17kXIy-3rYHA15Yg4lHjzpdFw&oe=6A0325AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QND8miaNUgQ7kNvwEYKFhO&_nc_oc=Adq9nRbQbuxKFkBHs9LDatFPZ7qZKDEh9ex9iMV8MrMqpffz8Mo2_U44HStHfJp_RwA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Mg8dr88-mbsYPOjdBXS4KG8keaCEE4CwMgKe8IB68zQ&oe=6A031C33"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "supp
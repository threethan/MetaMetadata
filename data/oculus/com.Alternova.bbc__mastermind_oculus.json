e3PrSXbJLlSb2YFe08Scwug2kq7-KSLr3W9hz_DUuK8ZbF2bU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xq2xDHZpl18JKfgALqw2tU8a6ewz75IHeYxc7WcQ1Jw&oe=69E8C5E0"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1Q1n-5RJZYQ7kNvwGvMFdv&_nc_oc=AdqC_uNjnxCOxgPlaTS-_frjRyMl3GyCiVY1rWmZGcHC-zq7BFayKEkNmuyGAlJCyx0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ksBj3tLnK1sl6m2BPpib_ut701yNWaAS36DqaCltY8Q&oe=69E8B383"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEqKcD8oev0Q7kNvwEUmbre&_nc_oc=AdqQzyfQYp-EsfkVHLzHHK1q6Xlny5Pm9Q1hyJHW3n1Z5hMqRqH9sy7uZXKm2KtWEC0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2X50MFd1lyNjZktnrYOYmqvrNR-_sKr_c18CnM2jM2ng&oe=69E8CBC6"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5i0Z2l-VV5wQ7kNvwHdxt-J&_nc_oc=AdoG9kcY2d2H2yDpUpxqxd6N_lOaV7cfiqhOxcRxHvK6esPO2t_Q41VZ9NQTWqQmyfU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26Stbxm97H_eduokYaTTi1dXkIut6JT8sQ_BIA9bNcVQ&oe=69E8C7AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3y1ObufZ5NMQ7kNvwHknXyE&_nc_oc=AdqiVwuLBFF6Gs0j4okK8tbR_ALKgUfYPeo-gkPpoiqPRbQvYOpQSpL8C0JmweWLuQA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Hn0Nyp8sZWvpgjrbv3U82MvTBQE_ZJ6vLsi_A-EWd2g&oe=69E8BE33"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "supp
7", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820648_672558479040230_2121737053367225315_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-GdDsLpeh8Q7kNvwEJjyO-&_nc_oc=Adr2irVuLgnCl45Y8XtigDGcuNTYPc1d9HPCo1PQCZOX8JMLcXI6m1pkR69rfXlnUBU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8_4hKXV2GcyUsy6vapmZ4BWYNl2feEjRmiUKwyS19iQ&oe=6AFDD920"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMtf7A0J37kQ7kNvwHnI_JI&_nc_oc=AdpaAwFPEZ53PHchiKWWlWcvUj8jwNHJbR1mgUA6cqi5SkBeeLHhveAnzTU8u5l1tQE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQe6XVr-Xxx4bcdGKIIF4TFec5kRBBRZWSrqabxqCn1zg&oe=6AFDC6C3"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYrjdfiCdOQQ7kNvwELHnWl&_nc_oc=Adon5dBA0v7YojEtx0gnR10p984lCiR-Kt5wC5Ii_K_36xsV96dE9dxNeDnAleIMrj0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNMKCk00nTIL-jO1LJKRz8jVrgCpDx6EMUfh8GJqEGYQ&oe=6AFDDF06"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Q07YeI61WIQ7kNvwHt0DQ3&_nc_oc=AdqoOJMmTQ5AIYmGH19jUNedd3IkHmZzSJsOl2XF8FGEOY7hOpe6dLCBSK_NBCoZIjY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBdt70tQ7ih_oXHbMQ-AZobEh-kEZj1V0Qm3SdrPNoAg&oe=6AFDDAED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oL-7Q-qu8FsQ7kNvwEFcOcn&_nc_oc=AdppLrDjIRJmTjp-6n2S5jL0xu3mDZ_eM3nArDnadn2qgIW-Zl0jiZ_at6v0MlzCk9k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW2J4bZCsK_qsCcgIiPU5jEq9J8Notp3__6U1phUQL-Q&oe=6AFDD173"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "support_website_url": null, "website_url": "https://www.mastermindtraining.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9596387467154417"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304025_1225883172880859_6012924059810738950_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzfeSq7lzf4Q7kNvwEPmTA-&_nc_oc=AdrzXGvM-9Y-v4JEodfVKDfTLsweMyHLM-5BQPOskpm_J_GB3_NJxEbliJhYGzo5YgM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUN6eudp25BOhDrnrolbuUpaN4zY5GwNpGWF98zuXSkg&oe=6AFDBEED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mastermind Cognitive Training", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1674104400, "lastRevision": {"nodes": [{"id": "5585815091545028", "release_type": "SCHEDULED", "admini
7", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820648_672558479040230_2121737053367225315_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLHR4b4PCEQQ7kNvwG5So5J&_nc_oc=Adqi11CvN9I_W6GyL_bFfj55vbjIihzFPJDxzGiuxoFSQUcmmF0D_5TsXf3AnmKV2pM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXpTo-cqTeD6ivZ1buJlhowE7WavBHZys-rZOq-WQIdFg&oe=6B0EFCA0"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MsW232jTisQ7kNvwHcPoFz&_nc_oc=Adr-yVpdBIlwshCGOzEpLMm8FUBZlKkbFPia6gr5pMNqDhLTWbXNXhI3-gToTElE76M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXqKsT4R9lIl7-83tBOL3Ejo6sBE9Cw7HQv6fsO4OTHcw&oe=6B0EEA43"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aFU0BfCqEEQ7kNvwHiDEbq&_nc_oc=AdpSZ_GNMywIvl_rzAqvWOjASOlGTAB2S_c5Ft-VwnAmCvBdUEu9-NcL3GqAN0Z0SeY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVRUBBEWCqTxMniygwYP9WD80tiHy3L9DCjR7sOwWm7hA&oe=6B0F0286"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SM7GFb9mRiIQ7kNvwHvyuaa&_nc_oc=AdrC6Drn-k2JZogS7cSMrYn2vmIngIPcj9zLP1tPZ4K_14S4L7kBy_kPxMzIgmqXQpo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVaMvUGuxsj77CFYa78rQgQZo3loRTNUDjkHYkxhpfsyA&oe=6B0EFE6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-c4yyeV1HywQ7kNvwHl1q53&_nc_oc=AdrXXqd8sFw8tjqQbEXBiCqF22EIklGIl9xShITH0Q7lox630IDRZUPJln_lDmyFdNg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVJC_HCmjICJYAVeQv_H303WHmntkXtn1mwwe490mJGsg&oe=6B0EF4F3"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "support_website_url": null, "website_url": "https://www.mastermindtraining.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9596387467154417"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304025_1225883172880859_6012924059810738950_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=euFAtOKw73YQ7kNvwE4MCSF&_nc_oc=AdpBvG9c-o7wURbuEUYYXtPTVvoWnuI1F_sFFljsRXyq3rCg9derqZtz-7gDmsVxI2s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV_xIQOzJNjR7U4QOhUwQGh-JTjPaG4V9Dzr1IhCwUe2w&oe=6B0F1AAD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mastermind Cognitive Training", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1674104400, "lastRevision": {"nodes": [{"id": "5585815091545028", "release_type": "SCHEDULED", "admini
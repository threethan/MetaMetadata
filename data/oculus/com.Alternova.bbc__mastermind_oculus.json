LsWpxfbojQsjW-Xzf4LBdEmJwrUXnYOe1-4-xhOTTwnBwg9CE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qkadqjylyLjhbBzu0AsxDh7AmkEm52nHVUlwFTxSukg&oe=6A1ADEE0"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HRR4tffCEQQ7kNvwF_Wyy1&_nc_oc=AdpiHnRbElDOKHsNHa6Zf5CBYSzWqETjOUKBFuVgKqCJaqofY1x4aF3H4SSd5v9yCe4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RDtCIgz8VwuH3rQkAYW4HoOXliWHjoVKsKAjKkgT_eA&oe=6A1B04C3"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGv1i4R_JK8Q7kNvwH98tFG&_nc_oc=AdoGoD-nogd01qBoLlvFV-L99gb0Noh0kdpcXt0Nqiqb85YM2G-ESiA_lrHL_j5kMGw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QMjgv9Jmd-BD1ZWnlgqXkv9j29-pxLFW_hcXndfTAZg&oe=6A1AE4C6"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yenpZ2stBUQ7kNvwHz-WM8&_nc_oc=AdoZu40PLCqJ1Owg1rtOKef_44UarH7WvDLqDW_tpAdazRMZHlXZt4VmfdPOBFcdMPg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4m4Ay2GCltV_N-XTJd1jYBLi3S6aEmhTG_CCyivjBrNg&oe=6A1AE0AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pC60bUe1YI0Q7kNvwFd79Yl&_nc_oc=AdqOwjOXTy-DjRDizQU1UVxesiptmryXPdzh0wCbmM_Ft-A-o3d1GEtaEylefpjmku8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oL5xnWuK4zc2lf594xwunqgA5TUED2Hmbg9gMw_5IQA&oe=6A1AD733"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "supp
fmA7u2gIWZ67515032HkhUZ5g-bNlN5xztb_6AKgMHzTpHo2c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVDBOWy7whG8NdbWBSAgOz2KHSESijqP-IfosO5sLjwg&oe=6A899CE0"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ha-M9H9M1RgQ7kNvwFVRrCh&_nc_oc=AdrlDR6PehEnHRKacqE1ERUxf4XSlJbVluzNw0yicQBQ__0o3hc5xemq2vxpRagkkMI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjvC1-OH-J6AAMAjMOChXflDtq3k3KZb-NcUY47iHC_w&oe=6A898A83"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=So4cZJTHrTIQ7kNvwGqy31D&_nc_oc=AdpvGF1E9UfHjUPP8CByrqAV9Q3ooHlrx9rJl2HkiYOarfnmUCyXdkBcoTGgi4I3rvI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEON2HP9OPBvCElQFsv_R6AWEJ0iJX-HgO00DO1r1b5UQ&oe=6A89A2C6"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cd0U7WJS0tcQ7kNvwF4UB9X&_nc_oc=AdpUqugzWio4FTh4plEXx_0NVY86uRFLRgIqh8gJRXOt-5zGoZW1GiQq8niINicjEEc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpn3Din8FxkRFtm0-mFipRGj80zVO459eN4MKhFWZ-YA&oe=6A899EAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72tiqGfVIWwQ7kNvwGyrpph&_nc_oc=Ado305HQPCjAf3eNpkQLNkJZfeyzlPRk4AOWThdaYeTMgeK4Cx1n390QtdDpPvZgA7o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUfjKq6BQ67qt-aaKDk0rzoNIfivYLCnXQDSmMyLaeEg&oe=6A899533"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "supp
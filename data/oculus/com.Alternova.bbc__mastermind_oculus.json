4H5XVhVZfOsQgvlcK9_nWsEWoKE71V1i_8L-eP8xpJZCp1IN0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0_u9MmDiR28FGE913vcfjz83hChzxb8GAeTJMFHW4yFg&oe=69F4A360"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOnnp_HPdqcQ7kNvwGz5FEf&_nc_oc=Ado53tKqt0Bnxp7iVCSCUJ15vCdbEE1m_N2crm_QkPqcomNe3FvdUHwk5DheNiL4j6A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0xUtp-Nl-GWwaof7HG23dhcBBnA4xcseSemqWl9f0xsw&oe=69F4C943"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcp5EfRz9ekQ7kNvwFRBXJl&_nc_oc=AdpRDPpwQnw_DP1fYg-wjBzrPguABSKJ66AKHZI0VKeWCgBBdX4zbXc1oAFF3DY5yMI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3efMd_nreMBR3b5iVPeiT2jFEW30yTT_wz7p6pCk9v1g&oe=69F4A946"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMJVQ_7Yt-EQ7kNvwFWgBEI&_nc_oc=AdrE0ADPkD8-_NX68h27oTTcxrZqgBn6mjjz0es1da3OEZkPRUOxN8vfLVmEWbStNw8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1HHx2tjD9EK72EHKvEyRYBVHII43kCyrB5ovJU5LyLYQ&oe=69F4A52D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XS8elkFx6U0Q7kNvwFzEm84&_nc_oc=AdpaRGTT05VHxuwEWEDLWpMogVrD7dutyOFmgGagedI1cQWjay0SkMC1h3SMaHSMxXs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1AfqO9NJHx018xDaOD-bslSFUIt1DBvBlAd5Zpmlg7UQ&oe=69F49BB3"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "supp
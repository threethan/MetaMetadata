zmHv1hRb89FgvPpTOtXVgSLhuK-Dc10pIeWYYkBNEp5IDaUFo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93sLKPtnuMfO_17idSJXRy6ePwJQ9e3JLclTCSsEwNgg&oe=6A3299E0"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kv_y0uTkHqAQ7kNvwHHXxDH&_nc_oc=AdpmzWhS-OU-UTNjVaiFXq96SBAvuU34QhmEoszFZgqn4dJJpnsA-SdrYWjVfwLjUxw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82AJqNBdwv8GzK7jjgvKWxQU0ZynM83BOQHSNed86SzA&oe=6A32BFC3"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mQh9fwFSrIQ7kNvwHok-Yc&_nc_oc=Adre4WK7JhbFDDU11ipkHfY5TvfJ5sC8llrUJPSDYz-dgVqiOdVUaw0OpPBeT6rr-gE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UFDYbecaVwlEIVGnM0IL8svXd3gkYGPZlQcD2t1BB5w&oe=6A329FC6"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzIc55oX3vwQ7kNvwEA3RXx&_nc_oc=AdpI-QQ8Dq_dfQVFLLzSmFiZjWgXuyU7NyTl2m-FH6n2R2v10tYmji_n5U_lF6X72cI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_P37D1wqlEBSEAt_YjzOfNypYm84mY3j5edWgt8QVwVQ&oe=6A329BAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXvXOswBYGkQ7kNvwEUv7Mk&_nc_oc=AdpBRQT_kFdb02nfRKq_tnZuMJ96V-siWbxGknexfOd-O0oDDJ8GWtQ-ymVHu5aRvac&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RksJ1NEscyS0Jv6vlH3FE72M1u9vRfVCXAWUqURcR5Q&oe=6A329233"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "supp
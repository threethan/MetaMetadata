yPkkMe4h6l2PpJhqFMascwP1cZz4P4OMNN_m3wiqmHogstrlKCYNGI0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DVcniNYKj80NIk2PgkzuArwKIk1dMxh3wwv5iOm_WgA&oe=6A11A460"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Rn9fSFit6wQ7kNvwEoigIQ&_nc_oc=AdrycRrk1m4hKO_qixipsfq3QHFkERDaAgbmA-2-AjxusRbbjiiT6ZJwIWSQPewxNSw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wu3LC4KmUgJhk3ZXOztVxdg-Ldj8-IBrCLyocsi6Gjw&oe=6A11CA43"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__8ui-MPDDkQ7kNvwElUlMY&_nc_oc=AdpdYJqGXXcY3YKlMXwdBadjPUHf2u0xTajxScCt7Q4tm8ZbPZ-YqlW-j2FpzAYe7Qo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SPCs8z0KmJ9S87zdLy4DTLVWv-nt1hPaBWDvMRUJ_Bg&oe=6A11AA46"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RK2UJdxuKx8Q7kNvwGuvAWX&_nc_oc=Ado_OnGUej6Q1PjcGeP6-4iTrVO8vkGiNAt_g2t8Mv5lsXricceTHxPBb6M4equ7-UI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_D-a5LszvHpDbzVwwGrYSB2puz8jxxyND0S56f3vOWw&oe=6A11A62D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iDqrKLj2iwQ7kNvwEHaRWM&_nc_oc=Adpu9ZPw1uxN9MGJgDfx-PQ4VB5COO5UWTx26XlKGUGP4M3GXoAcDRM0l68K2bZNXGw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tJpoh874_km9c-ZOBJg50dPxsTu9-BIAts4iI-ro90A&oe=6A119CB3"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.
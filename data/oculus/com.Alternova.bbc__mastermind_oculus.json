FtM0EgYcrcIB73C7Yp7LTxvTjtV_Enm6uxtQhi_bEvEtE4baU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5H85MOEo9r42xqsvwgcxnSpinI4UYX00DbENjCuRAUdg&oe=69FB3AE0"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XG7SYe23-CQQ7kNvwHXYYqS&_nc_oc=AdqvlQ79QzvTVvjEHJhcvs-5PqIQl8L4gGKhBaL6sSneE_OGJ--ZeBKBWLOd1m_0rBo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5o8USjLLL0Fj5aiLVfFaP726n4FdvfrpFs_XHu0lNWPg&oe=69FB2883"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RBEHa1qfG0Q7kNvwE00vqV&_nc_oc=AdrpV68B7aGIOSGfhwPe-EWAprrc8IWKTT4tUmSr3iG-ghKajQPtWcKFONZ_JkWAICA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fKQpEjayFpXc-NLzGV5iqXVZ6qDDqiUk6juwiv_0L8g&oe=69FB40C6"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GE4zBH0wPFAQ7kNvwGLIpXF&_nc_oc=Adp93P2aEdCVFx22m5v0HW8J0T5lBUW-WmJgkYdDgf-j9gOolsVyU4Hjl9A-j97R1g0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RtvYUDWj8COpU7EzttcHJE1VWeuwj6HH_19WsB7QZaw&oe=69FB3CAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8siX8g9QtCYQ7kNvwGFxeXA&_nc_oc=Adp_yVj2s3Z8kE2iuiXZnQa5atB3aXIRBz4tRnUzhnQk65R05LY_B0O6rQAblbxFaB0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4p9VvhWaosoeTUXBzNblwMi4iMth1p5kCKPStsjiLrYw&oe=69FB3333"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "supp
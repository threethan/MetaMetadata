3IDquPZ4HboWvo7qbE4y0oOIX-dYVYQEg_-ZJ_LtfjwccFJMY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cMi_CvcGDUskm43hRF-FC3CbYsNPpw86UyEuMg6uoJQ&oe=69E622E0"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDw9zRsDqj0Q7kNvwFJVoQe&_nc_oc=AdoLBetJKjUlQMmwRx4Wn5PIkkpaSYoFhzrLz87djJWrobbSqD2mXth2FIa_pIlwWOA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BDx7w8Ke8xlaf76kaSFvfkRQJM1PHimgWBzZQheRipQ&oe=69E648C3"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6IgPCPr9UUQ7kNvwF-vfHW&_nc_oc=AdqBh5cyBzRVHyRfGDc91U2OhgqCExtOXshyOKvPSinreh9LQ7uirDr6e1pwxscB3nM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ylbBsNw2cQhaCAhLOBoflctbDy0ghAZEGy5UuQZLDTA&oe=69E628C6"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5i0Z2l-VV5wQ7kNvwH2TbtI&_nc_oc=AdoO5oz2o0Bpa9CF0LLCaKzQEH737M_TXa-g-IvX2T_JX9_WAjmBtusrd7D1orQYeyY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VB1lJslVIgI979pK3ms3Ly8gbvtJRLBA1uHefKGhfdg&oe=69E624AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mk1Obm2RnxQQ7kNvwFhPork&_nc_oc=Adroqk936aep2i7IQpmfEBD1YTeu7jTf3-rJ6P0AsDqh35DNtY-9x1GAj_BPyfFHlN4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fMJFuH_K9O3Gc1b4VGaH_-Tri59kC4xNsf1A9Lik4-w&oe=69E61B33"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "supp
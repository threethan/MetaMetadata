t9axnC5CoD0EmPG3t43fPIOM4ZT2iIhkHGKzV1ojLw5Q&oe=6999ABE0"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuwVPlTKqlkQ7kNvwGnjEWd&_nc_oc=AdnIPc7uDNaizNcz6LFRU_JHvWC3URW6HbQYynSmOUVhAFICJ_hLirn51JzWZ_7FA5I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftDWrKWOFZaTXV1DG8GzK1Q-ywa_4W3BLMlRCeYGeoUVw&oe=69999983"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pX7eVYvOC-AQ7kNvwFH8sR3&_nc_oc=AdnR7tBF9_Ub7r_eVPmKVrqiw5U8EVK7aZTkOoEGJb1hBIAw22e_pJj5wm1IH5whT-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuv0NCyORHhIjbuuAAqKDpoVGuDxaYETVRnhijBnmCj4Q&oe=6999B1C6"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XoIEiuImDU8Q7kNvwGOyOr3&_nc_oc=AdmZp4FPYSt5-Z6GxkqwA4DFOkmEqUz601cjQO5DY-y2N9-j283A6uUL6KVaULHmuZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftmi8soNVopuGPBf6d_e1rOZd-TXfyaZVc7SwdXK-THQQ&oe=6999ADAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cz0fEYXXaPMQ7kNvwEd0DIh&_nc_oc=AdnEOUEVyeIfoQkXb8r-o4gdmZJFUigqMLMLOEwsLxdhfEkhvtlfz5srYeGSWhNN51U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuqZLIvVlJV6smVerRbZJmY2El-wL2IePqA--SN5hnHCQ&oe=6999A433"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "support_website_url": null, "website_url": "https://www.mastermindtraining.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_
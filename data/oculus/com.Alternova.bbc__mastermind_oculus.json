s-e6WJ23HaUTwmZ4EvOfOsOx3bE8kod8gIRsywh9SUdQ&oe=69A2E660"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vg2dwCKk40Q7kNvwH-DtNI&_nc_oc=AdmhiCjZNpbVD5paVCsrdG9vka6I_WJvBbGuURvavf2h68sQpQEC7d4a3ykzS9161hw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afutth3PJKuZIqaQYqTrr3ipOkH_ja8rUp1XE7A2xT_0oA&oe=69A2D403"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8rsi5aZIs8Q7kNvwHrNuDP&_nc_oc=AdlBCxMRfvXabCFChJJK2_4VBqRTd4TIqB7NxdynTWu322xE82b3e2jXiRqa5M2DUew&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsfI4XUtxEMgiUmimeW_iOYFOfELsJ77L-tubGsEuPMsg&oe=69A2EC46"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhGrqcRrRroQ7kNvwGKQh7P&_nc_oc=AdmMFtDHoUd7K8s37GUxgKk8_tqWwHNDjD2uTnumIqc5dmh-GYhavpBNHfkohR2Qo3I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu2vaz8H-f-XetBxUePjpPSKfNgAMWLdY8Aa_9UHs8h9A&oe=69A2E82D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBWX_qIOGpcQ7kNvwHJsqWC&_nc_oc=AdntwnfeRHH4YTUJD5sA_9Az9zqALj3VgdhIqQN6kSxxRcTKEbiI8M0nxghmSr4amQ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftay3o46lkC84PIj4_VnbypRG_hE95XQK_qXbh70xFihg&oe=69A2DEB3"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "support_website_url": null, "website_url": "https://www.mastermindtraining.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_
dAWleaBxinYZoJR8qnt2DLMBNNg1mgdIi7ZeMZNlYa2x_7g_Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7EK9SDdDxVgOdQvdcT0ZnfLoFsApMFIitCx5mlQu-eA&oe=6AC8E4E0"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNr6rjCSZlMQ7kNvwE9HTMG&_nc_oc=AdqLazN-MbgHsIhq30TBdJRdw-2d3arx5nn3srJD8eKUKuD9B1heOHgirnpTFBk_t1U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuIFqoUbAcA7SXrMKY0Vx4k3NjYy2mHSeit_O5T4kfyw&oe=6AC90AC3"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3ygV8civTwQ7kNvwERuyCR&_nc_oc=AdoE7i8eOfAZwFbjEtCYXME5q1_jH10HV09QgTqp6Wkbo7xX8_TsYBGnk5HpersNzr8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDy5Vj3mzqekSxxMqNWG_v-dXs4ZuREHqptcZjmT67Hw&oe=6AC8EAC6"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLzFU6NSWvcQ7kNvwF5l_4t&_nc_oc=Adr6yv3H-8kvM8pHNacU0Sn7HQOdAPjiSljkhxMCcLek6RrWpxp3NqHZszljqeLAb8o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNm0Dz-7F1ta8Krhv5Pey976mJc-SEILQaLduAFkyyfdQ&oe=6AC8E6AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGjZajxt3vwQ7kNvwHD5gq7&_nc_oc=AdrNnvZs-xOTf3JLvMMicFgukey2j_9A9CXtaeRTcc5vcY1GZtBu2EyMU20AI6nH7Rk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoKSqmoybkjqyY7pq9HoInGqvYg-pQuToflpvX6Z7Q2Q&oe=6AC91573"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "supp
s2FpKFhTfnGYAEYAPu2h_GSUxE7e7inZyFooFJ54VdDw&oe=699EF1E0"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkxnQECAgO4Q7kNvwEO3wwN&_nc_oc=AdlB883pf0eA0989DV4Lh-hIi5XjFUpBwTaQGh36zhg9fhJuK7u5YN9czvqEuhVvRCc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsAs3RhfCzinEph-wOAaqYSPzrIDCd9U2-4s7joATkhsQ&oe=699EDF83"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ZmkxxW-3mMQ7kNvwHfkrau&_nc_oc=AdmdNKibX-AAfUEVf3hbe8ZRs-icJodgadosv391yusle_CjMZItn1OD_aLj7YQFt4o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs9ZKuGm0O9nyzuntf0H727vsCWyJfrp0OaZuP8xx_lEA&oe=699EF7C6"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpDMXa40p2gQ7kNvwF-qz5p&_nc_oc=Adm1NaW-ccuu0sD8xzhA0FiJxU1jzh4hmL5nIXadJm_XMxRo0S8sAJ8yA-Idj3AkxLY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsrs2LUOUs1Oytrd0X1b4OdIBEkI7WMsu8k_cHCWOizUQ&oe=699EF3AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mtVQZ8IvUIQ7kNvwGz42lz&_nc_oc=AdlWJct0x7gq_wS5MaQrwEcBKNVz_lGa27IKi0VT6EMBdBxjPD1rFk14cf6sM_T4-QQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvvA-WncSEfoJhvCxEUD9Ct1ChbZHHqHJ2XYHUsGRNYSA&oe=699EEA33"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "support_website_url": null, "website_url": "https://www.mastermindtraining.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_
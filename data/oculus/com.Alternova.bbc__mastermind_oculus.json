qb24EID4nB2D37bNSvjz9-ntYrE_-6DuHYkaOk9i1Jiee3pU4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDB9IdIdy654JaZ-GWqSDBxQ7dRO7WvIXZk0cd6paqD7w&oe=6A64B2E0"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7sFXPoYkBMQ7kNvwGGeSyO&_nc_oc=AdpwX4-7H3TfcxGqMT_HvH0irLwrKX0WzPFcJtD9_MfF0a9slpF8vrgCuITVPj6L5A8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzkEWIZYQnNVUdcRDih6-TantQqvUPiL2yhtAaV0GjqQ&oe=6A64A083"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hn-cpDFKLqAQ7kNvwFA5oFc&_nc_oc=AdrpmtP0z5trExKjj0lSHUazeQ7ldVtc8JIdUG6AiEAVnTxKLqfRQtk0i2eEl6yqWjQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBm0MPTvpxWe-hwNiJXbGv7tYOveZupvB4kQnS1hYp5sg&oe=6A64B8C6"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yK6FmnWcAwUQ7kNvwGRkqwi&_nc_oc=AdqqA-5shRy2mSKUiK_dXbtb1Vne66yAz6qFnv46KNcJgeqkiOO_W_ZzedXJ8rJjXtw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDENyTQa7KslEETcrJ2NOG7cXFTr2W41UEX3G49HCWGhw&oe=6A64B4AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPDPbZf1lE0Q7kNvwFW6fPg&_nc_oc=AdqN1GDRJ4yvaOeKfhohUJN7Xr4_omtqMwXRfvtNDNaiCC5NX1tYjjE_yVgmUh4Asqw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCL_-GdToUTBn9l_pMFj8CVnopYpM_KkJKsLWkj20Yidw&oe=6A64AB33"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "supp
ztQ3IlMSgXArzNwmqWDiTzsckL-ijZkSvB1BJX8qtpfE4498o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hFB1uqe-C-onDm4UGM6PpbddCGhAfu-to0RUCMj81og&oe=6A450EE0"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3MEe9jI87kQ7kNvwFVzllo&_nc_oc=AdpsekPSQgmZemh1zJGlQn6VCoQx6zkOyb4K4e5FSSSHQU6yQydxDWej6OaxAD0992k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dKmbsuW2W1VPT9YbKgHQRdTvh5llFNnisfBN_Fmg49A&oe=6A4534C3"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47z0xwklKzYQ7kNvwFRrKXZ&_nc_oc=AdqGhYYh1bJTmF4RkoEWThDHMrg5CHZ2CHfbwBZKxxSaVkmKtPt0rTntUX9MZ5P5MEM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nDwLho78CKB6B5K81k8UCVtd6sdFkaIcdRPmZUPz-lQ&oe=6A4514C6"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d49Sp0INFQ4Q7kNvwERd9xr&_nc_oc=AdqphnZ4FLIVDYrdcT3ip8J10uY58MWZ_-9yuKqfe05bqr296DcNMy3kN9CyV_WcdCU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JUK05tyCr_HqK7cuvMgwV4l8GI9ZXW5T3bS4H-IdYUw&oe=6A4510AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYe0VsGbOVAQ7kNvwEtyr89&_nc_oc=AdqI-b-_uOLwN6rJj-Bd_NL7UHy30_7-6vsep5cty4yfBfrV0qB1sBDaenbooW5b8Lc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-P_yNp_75b2-DjPw3Pe7dWNcIIg5T2lM4LS8C6x8SOQ&oe=6A450733"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "supp
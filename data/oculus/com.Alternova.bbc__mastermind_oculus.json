vbuEr93EtQwMLDzGGDg-izCoZM5Yv2uwx4dAATlv3y-Q&oe=69A437E0"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vg2dwCKk40Q7kNvwGLOkq1&_nc_oc=AdlY6I_VdXz5Y5RsjnMDfj_TYcPG25OlBaINCNAeVmm3_8AoRAukPeWdR5h017rGvVM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuRJ5EokH94Qae7Zvrmni_c07nbtEJUqg3q0MVy3siXDw&oe=69A42583"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymqZGobS7P8Q7kNvwHGsEzD&_nc_oc=AdkEfvSVPnBTe2aoE4pIiBXcZRec5yBLV3lleaLkDyjzJarpUuAMqo4GUr1XEz8hkls&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afthk8zQ9539-Thtbmb1m2bYih3SEvDBHcBoVYK98bA3HQ&oe=69A43DC6"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhGrqcRrRroQ7kNvwFsnrIF&_nc_oc=Adl6ynS2iCb4J0HOW7IMhWvSKn0sEXDHPMzcUxvcje2NEYa41sK-MQYaYhkCqN6ML7Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft--36uzZgiNx82K4nh3H1SI3F3OmsDECqUULVaxmi0xA&oe=69A439AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEEFXdvPoxAQ7kNvwEMOZfu&_nc_oc=Admq4ojgZTOk653WkMfDUq8eRSiCEqySuzuccT-6VAovFKe3TiR4Zx__qnD3GVvu9jw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftBa82ynr3dZgpk44ywxtBaSnyMUILVP5FO5u4nKILTyg&oe=69A43033"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "support_website_url": null, "website_url": "https://www.mastermindtraining.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_
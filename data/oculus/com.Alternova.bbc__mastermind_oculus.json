vHvIiwoJi0f1Nwc7B1Fok8XkaxO_p4Bg6l9_pW8ll0eA&oe=69A6DAE0"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-QFuWW8zUMQ7kNvwGld1J5&_nc_oc=AdmOMH988Nz4PmLQ9I-WuJ1XH5zxy65ZWpYSRsLWfg1CHVxZA-gFiZGyovOstqj1urU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftjySwCQLsTKYxZ6ekrTqJtRXO2ZjktxxGAcR3xVOJO_A&oe=69A6C883"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymqZGobS7P8Q7kNvwE5-kwr&_nc_oc=AdlpPvlxKM_jfIABqtOdCLCziZuNSmKhBsu7qONF3yH5WCKgsyZciT2SCkg0fTY8Klc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft_eWTUnBm_svhSRyW2kRkczPG2-zMuj0Ud92zVxJCa8Q&oe=69A6E0C6"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1sraj4ahq0Q7kNvwHWhTbg&_nc_oc=Adk64Ho51fV-wxOtMBPBhzgzTeUuZBJ0cwBYv9fZrlgDZSNEvuF20EBX9SV3_BXJvbY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvoPRCvGHDyLOjisBpy0i1trQiqjP0nfoFSsOLjA9ZaQA&oe=69A6DCAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEEFXdvPoxAQ7kNvwHjGhrw&_nc_oc=Adnh69ODYiTzYqiN4UmAwuaTX7ydc0NGVt14SB0Cs8nR2M95DGuP0RfNn4gq5wLwRN4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvjerStijSqVSvlpEzL06dh2o3_y7w_Li0O1BHCGSHH5A&oe=69A6D333"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "support_website_url": null, "website_url": "https://www.mastermindtraining.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_
BH988wfrwJZGyXsadW622shmOhnZ01UAF2bk5zpGkr3xre3ew&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUVzz7EElq7yi2YWhPkaafjZ8SFQcz2-1v4l75Kx88kQ&oe=6AE1F160"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTBVTHDaw_0Q7kNvwEDWS4i&_nc_oc=AdoJhZV7kVkjuxuOgteiX3zmnwYstsQ7GCIR33Hdh_-KVkRg6kpXSjDaWxxeIXluiZU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlEaLmwYlYrC3PYnym_cAPpYGwi6RhyPTZtiiWuTMK-Q&oe=6AE21743"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLk66Vr4qakQ7kNvwEKHqnJ&_nc_oc=AdqPojfc4N46D4PlpEKe9XptE_K0Q8p1gAYUqM6CLviU9fsLuzusTWD_SkF5VbVDSWs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKlA5kzlEj-ucMl2DQ0Tm_jT3VB2Ax6jFCJaoPYE5_qw&oe=6AE1F746"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlsKvq0GxwIQ7kNvwHmpRIe&_nc_oc=AdpxkcNBw2sK0ANeBZ27AmR1ZU7Nkuo58XsdlwT5PFAcVZwXWzAYcUx-zze9aHNzwoc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCR7iF5gKeV516_ntWsOBhk-uSGp7Nwau7ZE4XGNLTgw&oe=6AE1F32D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nb4LmaoBxwUQ7kNvwHBaSx1&_nc_oc=Adr4C4tKKGH-KS-k6SH0-u_prFYEt5MGQ8NLG-gCl8paX4lrIu8Q-_cDWsfTDzqkcGg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6VVjDgiS6Ens2dwVZFXtdcge3WbXWYOCOBzxPXqK14Q&oe=6AE1E9B3"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "supp
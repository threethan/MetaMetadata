vBE3pFf--yueX-aVzhJh1NIAxdur5utvszZgOGmSnolw&oe=699AFD60"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuwVPlTKqlkQ7kNvwHKQqcR&_nc_oc=AdkQa6y9ZJxcMPujhOmAzNqBOOGlxfJ8Jrg9SHYVzckIYZiXKxeiIVtTRNU4UgnIAo0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftedaD9qoxD0Bn5h60mfzD1V-VilOc4aFPHbPpfC_3x7Q&oe=699AEB03"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pX7eVYvOC-AQ7kNvwGdAEly&_nc_oc=AdnqZN5HSeYGh2REqYpB5aGbgNL7KfUcirPGrwohppkyv-OiWWOrNUYIlLfZ4iN_D8g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftlvjrdKnjdAjD5Fa1NheVrZqXA_7g-kaRV6Vkoj4xjdw&oe=699B0346"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKqz2GVsfU0Q7kNvwGW7RJL&_nc_oc=AdnVUHQ1TRhwIKUnt9yacwNuQovIZ4Smk4oGopdVjDFp_pEY4YhIRijUhOFWp0XZ0OA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftSK2sWFR-A72XitfJUybBEcdMdAE-PpogU5xeLkvkaZQ&oe=699AFF2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cz0fEYXXaPMQ7kNvwGlXLH3&_nc_oc=AdnLuOPHnV9G4cJG-mtZID0hLVZX46XwEOGGzz9Lia2o1WT3zxrq5Cxto5DfvRKTuxQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs97IPLN8vu-0eBrFq6F8vNTs_9CnEVR__uwtfMYSZjlw&oe=699AF5B3"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "support_website_url": null, "website_url": "https://www.mastermindtraining.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_
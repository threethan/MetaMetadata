ME88a28MltNDqTzxJcxLRM49Moe5ScNS3ulMJ3b75tj2F24Zo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOygNNCCejcpn5ww4EcRRiciznRkMfpZtsn7dtOjAE_w&oe=6A81B3E0"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZ8nE_Ei6SYQ7kNvwFsHuwI&_nc_oc=AdrxB47YdgunTwVuupJjfWXHeYUaQI3X1r3MKK-HmAJcYVl0z-sKXrsqQ7z7sLAiKwg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1EcsDE1n7zl0rAFr16-4XyrK2PfhytRUL04t_kf17hw&oe=6A81A183"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYCLFY0QGikQ7kNvwGRVBLO&_nc_oc=Adp7m9O-Ym6GNkeN_gokL9_f5PPGAp27QY8zkhGwcI7g5K9AQk_w9SbWOO1jZYO6-WE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyGBM3OM4iWGG-KrDR323zQkTWghnWzVMHnyEAcXKbzA&oe=6A81B9C6"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chMwy_sUa-cQ7kNvwGQeXmV&_nc_oc=Adrih-hXf5SKM7NIFs-FwoCgaVI6dXGZd5fJB7n54PGvTsXyrsAmwIiFCnOpmQBiXUo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENB7A52f3RvR0fjlCdlz9oBhJDV0eJI6Fu87B76XCAxQ&oe=6A81B5AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pc7NS_sRyPMQ7kNvwH_cj_c&_nc_oc=AdpPWEoZxZtl67sPRynkR4aOpZ69LcqqgXJ7_ih5bQNeIB3dQ8b83zptN2LfI-ckFpk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9AIFJo9q9myFIYOZkHe4G3hDgGPIN5Ca5pj28ZgCq5g&oe=6A81AC33"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "supp
g1PWp6J-yMBA5EEeQduL5Oykd4I5HTofpYzBXq2XgfZpWef7wdftxiw3A&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5TpHPUA7-oN7OeZWmLDBkJFnuNbQ7joITHSRy7fZW2g&oe=6A8D9160"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxjXPq0Z4LkQ7kNvwE--41M&_nc_oc=Adol0-4rBnro41MR19qdT5wj65QGWdpH0uii8ihlREa2OUnJYBX3NdBvtiNv6xfqO-c&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmPpWYPT8iXTYHAhS1_R4KF53nMlGuknUXDDSTbjbCdw&oe=6A8D7F03"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVdvn9UhC2AQ7kNvwE72dNb&_nc_oc=AdqK_RZGcywc0EzTG4InAgg8sd7EErDewZe1KBEleXYP8qOSsKaixIbhb-UYf6j3VC0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEb8v29yceJU6t5C48M3pafMxU4HnVyEO6TPHMYm7M1Lw&oe=6A8D9746"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eVpFzSmBaQQ7kNvwGlCBDS&_nc_oc=Adq813EmELc2fy-xZfm4nvhRPCvoyjbeKT8ts6eaJMMOnUfxytQ5Fy4HGHuBrzGHW9E&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN7lGJ6k5j0kdbGsFzQKWxzP_-WujZSRB--Ws1u0pCrA&oe=6A8D932D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oY-04SOtLAsQ7kNvwEBQKE-&_nc_oc=Ado9kIn2eu6HMCbukHYsnrCExAfamoJzlccEav1tyOPD1gtEE6br74tP4nI2CSXG8PM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHldI6GxCQBbYQ9uwKRHSBEtGWqtqBvTtqfe75rXOgAwg&oe=6A8D89B3"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.
uWTGi2nDNC66cG2BqSIJO-AD2VGM5yLNinQHuw_x23ZIeiBYg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jHGSvsFIDLer1sk1ihM94hHSYZhGTdKzTKSgqq_NnDg&oe=6A426BE0"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHEFC-NGPYEQ7kNvwEEOihQ&_nc_oc=AdpR_cVZ8IbmYWfPUOT-uvKqdPxM9BUll8XdT9GL8URKGnFnYqC6jIjmtZp9V2Kcd2I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90IpJJddkvwBIVX1mNZqTX_hpSFE4EmB6pBpdCEyBXBw&oe=6A4291C3"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47z0xwklKzYQ7kNvwGDjZUd&_nc_oc=AdoMSxGXoHnnaOLEDZklccmvAljezeOx3RQIgIHE4uEi3V_hDnOhSSBrLdgAmp21r7M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7h2_y6f0ObMCRa6ZBESdqeN2Irn3XdEjbYS7-Zda65w&oe=6A4271C6"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDGGTi1e8CcQ7kNvwGcL8kw&_nc_oc=AdqbirR-Kps9NR0m1VJgG2B4o_l4tClP0cT2bl44OrJT3msgZiuRUlUkIlQCYqw6xYI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gDpyMy_TZi9Sb089XqkCBQm1kMfCZVKTEOdfCJp8mDw&oe=6A426DAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYe0VsGbOVAQ7kNvwFaasUa&_nc_oc=Adr2dC4lWktJysMOAt4o8kZFYbqPDHBW2TskgRgVtwOxW3He9atsn43rnEa0kCE3R2E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xBomMOO0m7RcIcqNWbnYQF31oo-cVZ0QaVqXrJpHpsw&oe=6A426433"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "supp
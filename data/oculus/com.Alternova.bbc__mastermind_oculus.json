yAPCw-uF9PU4l9yHBOugTTAf_HGzi2Q3RZ9wNv0wsxikifuqg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz6peWhKWL30Ble5r-hvLzyBrY__REjCPOQoQ5uZ28Dwg&oe=69C3DBE0"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9RSUqxmjhYQ7kNvwGW5QzU&_nc_oc=AdrB1K1d08Gq1tNmKGKGYiJnq-L1TthYSkg2SZsDmVswL14Gm6VY-gBG7iv22NWJv3U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKlYopk6k6_W40_iv95sK2HHmBoRV8K4EvMhWTvRI03Q&oe=69C3C983"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqB8W6NbGx8Q7kNvwFvb38L&_nc_oc=AdrpEe6Hqw6euSegZJc1hFAsFCN26HBuwPi3S87xg7HkCEzw50Ols1f91fgXeH2tvs4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwnqcigsp4gLwDTjVDZQhoyGO4wztaOo4m_jcg-flSNCQ&oe=69C3E1C6"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETRbnenVTXQQ7kNvwEaNiIW&_nc_oc=AdpCVtLzVIlNki2RNJaYP3rJvsp0GENkUCbRuGD0nRmVNB6Kz6un5ey1Irae5MKatrQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyAV_OLXfolqxer8oGk3uHK34lK7I9eWFAvUDxV9Bf7Nw&oe=69C3DDAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTC8HNlqs5sQ7kNvwHKl5dT&_nc_oc=AdqguJ1nIyWcz4-JSUeXt-Mp3rGR45tLBQpNMALscgm3bQdfoHcsWlPDJmN-CEcUkwQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqhJ4Iv50MKwl65qaxB7COf7MJD7pfbjEiMYU9LOVqjQ&oe=69C3D433"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "supp
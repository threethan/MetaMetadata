Fxhb6AXyWzy5ebwL4ibn138JC_4scn5pCem4U84PBdOB11es4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgrfZCjpCKS4YJfwpb_Q-nfYsgzBt93ZN8TCebWKOm9Q&oe=6A4E4960"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJVGc0Kf5vcQ7kNvwFZprLI&_nc_oc=AdpIFuVutJ78gH--gOwgqBTO4IuUJWe7azwcHFA2R3gqopGRR8-cCnN1IUpDf7LJB4k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXFiB7BewHm1e4YdcE9RJYdC1gGWTSs1dRSYoL6noCjg&oe=6A4E6F43"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BU-pxaZXLrIQ7kNvwHzUnJt&_nc_oc=AdrdCJ3GRO_v0jNRALFAFxYkE_MqhuMrtnHb1SWzEWoQ8CWIzChnjr2X8ZYgObyhTY4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUP17c4E7TEKLLFOx8fvuRIeV6bZGE5rXUwfWo03JqZw&oe=6A4E4F46"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AQGQhSZa1EQ7kNvwEfNY1Y&_nc_oc=AdoXgR1JDjG3ISwWWlSDq6DS7LNwRKCEzUHxh-zDHlb1tSB9ORjG9trD25V773OCsjs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAajIu4lQ32z44CBb8ifEx_lyQ3SkjVu-B5wmjHt8IGXA&oe=6A4E4B2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5-3cwhQHKkQ7kNvwEGiCdC&_nc_oc=AdoEWyg1o2Gd38Lqa8HklVeiixjZmCjxVaHoB72gqfUDkjRXICx5czYJp8AvDaPQA4k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMBS7a47FqCQEAAV7ccRHEOPkLqUG10hmWcoCu5rH4ew&oe=6A4E41B3"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "supp
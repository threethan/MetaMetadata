2CvXAHqYPFcRffDdqqXLa6QIdTM9B90vsKQtRzQLFS9LzFt8I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4c5vvgWjpjSATizqrI9W7sa0XZxt362a7qUw4K4yzCAw&oe=6A0F0160"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpDkzOTmpuEQ7kNvwFeBKeW&_nc_oc=AdqJObHLXvvZV1D7Kdwih2WpSwuBp-vHLEIONBIhE8ba28qbaES110Q8jXdcEIcEBRg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Kc24RU91O4qpbco_tALr7tPUNzXKoEFib4pkAeHGHbA&oe=6A0F2743"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__8ui-MPDDkQ7kNvwHZ9Lnw&_nc_oc=AdpcMmNGRt00LWslM4wGwuBniFayqFrV2OrkDlJleyTHKko3r1ucFCyYDn_m8QCVVGo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-lxf53grx7g2tj8bitnrsIOgkqaZoNFHNlJ4MaMHj_A&oe=6A0F0746"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3NnIruHf9sQ7kNvwFv7aQB&_nc_oc=Adqpf9s7nhbx7XC5vdfT0M2Q_De4qUtKSJthmHzJ0dH-Mph6FQ4lTRI7sZP9FDuYH6E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TI1mOHo9vKGGtV2fHwiiZ4P930NqaJfNEw9UyHqMLdg&oe=6A0F032D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iDqrKLj2iwQ7kNvwFd2pZc&_nc_oc=Adp1K_cKjNasBrSx-ypLE8Ypy95zntCw6ffjgICTfLDf09neqAzluokDwXzLakhPvRs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oR7jl8f0pzqw1a-qnJAplRqbUas6GqMpkFqG6Oh8o3A&oe=6A0EF9B3"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "supp
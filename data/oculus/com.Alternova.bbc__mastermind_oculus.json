r_hEtgAVOh3uM8KC7TqF30mYMlJdmEZW7-u8anb7fqPgMou-gy4oDIc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfxpmNR7l8-Wkh1M2jJYo3VOFV8ruINMkQG7i6mwtM_Q&oe=6A7DBF60"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2b5V_hFBywQ7kNvwH_gRo_&_nc_oc=Adpy2rRNxpjCnHc17RWH97_846e1EErSPZ8hEbeU0IIf5_ytASRAzr6CwI3kWaAXY28&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwcitK_ClY_AxvlVVXy5DZNidSi1UESIBRJvNvY4UQvw&oe=6A7DAD03"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9j34ZzsKqMQ7kNvwHKJW_Z&_nc_oc=Adqzgvkgdv6_8ABafhHZ1k6Ns1DFttcWCmgx3qyuBy0pdZtK9NVlfrUPeQxguaYqNMQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEy0JiJE8kSqBpR9BIfraKp3e_iSpvOjljfq-5Rbs0aVQ&oe=6A7DC546"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkEP2v4LVVIQ7kNvwGqrsuJ&_nc_oc=AdqDE9rsciva1aLEf87FGSsFieCm4tFgzKKPrmyqKTlLxi7RjIonwuZzfwgGZqPa1KE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGT3YLALCeIctXQVUVIewzSii3b22IylVSGTa5_3oEZiw&oe=6A7DC12D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmQC9-uozMwQ7kNvwHrAaTo&_nc_oc=Ado3y9KPO7DC592Hocf79jExeJaTCUGR9shioegqIU5DDAcHH_49XgEcKNT9Wq2ERSY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7U4JfdCMK7j_0Le-2DzTVIqLuWqo06Oq1lBxMz5hUrA&oe=6A7DB7B3"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.
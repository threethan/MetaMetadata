XHGAd2WNmvnbppAS6WAjmG3V4Z9nIo5MwcjneXvbjOmsj8_6E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArKj6yf8MfmaZH_q65rsnbJAnuK4BPEN5m_eye3LeBJQ&oe=6A6F3EE0"}, {"file_name": "MM-meta-screenshot_3.png", "id": "2182757538824781", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820486_2182757542158114_8507769175467192134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erRjSCbVXZoQ7kNvwH1KONB&_nc_oc=Ado67ALDlxbmfFZcr962XShMjJApq_V4jlQATnzLJGNH2FaVBpU-C-Q4n5_TcLuu43w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATctZFA9y4McaCybIboSxrOOtXn-FNcaF2yOyyanmopA&oe=6A6F2C83"}, {"file_name": "MM-meta-screenshot_6.png", "id": "684418807899875", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391926_684418811233208_1341331358024516391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7R9pG9IqvgQ7kNvwH_YIFI&_nc_oc=AdriUMJlI1MGYfKmPn6DmmPdj7xtMNoLCmHTaT-qg4N0-Qvr1BVbOm_7APcMtIt4RTU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvIaHCuifYN3OfUZvxB1kUuvcsbp1KMF0AqPdx2AnbpA&oe=6A6F44C6"}, {"file_name": "MM-meta-screenshot_7.png", "id": "1759471711670985", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393905_1759471715004318_4960508987304608132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylT-o-zOLaIQ7kNvwF1z-M0&_nc_oc=AdqEJXG6Lz2PEigf8Trt6nhxnuphjKWVUqJdaqNoy-nprxlPqZUFNsx9ToZ47V0JEb0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSt8V6x0WEJnkSxE_BYcQ3cODGc2WyE2hwFlKpj3j0qw&oe=6A6F40AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-04-22 at 7.32.52\u202fPM.png", "id": "1397396794728824", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824014_1397396801395490_3677741944163068351_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FO58QKVAXmUQ7kNvwFGFpWb&_nc_oc=Adr69HXUdvACH-CRv74nQZjPhpbVhEZrbho_k1SuJ1iCQIBF5pjoGI9iE0ICeCS2NWs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASXxhAUPL93ZqQGqz-mUB0yvhbzQH7yJm54vXepbCCgw&oe=6A6F3733"}, "display_name": "Mastermind Cognitive Training", "keywords": [], "long_description": "Elevate your Brain with Advanced Cognitive Training.\nMastermind offers a unique cognitive training program that targets essential skills to enhance your performance. Built with advanced technology, our program helps boost focus, reaction time, memory, and decision making. With each session, Mastermind sharpens your skills and helps you achieve your best through targeted brain training.\n \nCore Skills Developed with Mastermind:\nMemory & Recognition \u2013 Practice your brain\u2019s ability to store, retain, and retrieve information.\nDecision Making \u2013 Train to make split-second decisions in dynamic situations.\nRhythm & Timing \u2013 Improve your efficiency in movement and timing.\nResponse Inhibition \u2013 Gain control over impulsive reactions.\nVisual Processing \u2013 Improve your brain\u2019s ability to process visual information.\nEye Control & Strengthening \u2013 Strengthen your ability to control eye movement and focus.\nFocus and Attention \u2013 Learn to maintain focus over extended periods.\nAuditory Processing \u2013 Train your brain to recognize and interpret sound-based information.\nHand-Eye Coordination \u2013 Enhance how your hands and sight work together.\nMulti-Object Tracking \u2013 Track multiple objects in motion simultaneously.\nReaction Time \u2013 Reduce the time it takes to respond to stimuli.\n\nMastermind is a powerful, virtual reality-driven training program designed to help you achieve peak performance through scientifically-backed cognitive exercises.", "short_description": "MM Cognitive Training is a complete neuroscience and physical training program."}]}, "developer_name": "Mastermind Cognitive Training, Inc.", "developer_privacy_policy_url": "https://www.mastermindtraining.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mastermind Cognitive Training, Inc.", "supp
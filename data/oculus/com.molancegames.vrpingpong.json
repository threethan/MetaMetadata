3DCA"}, {"file_name": "4.png", "id": "697629853047582", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831382_697629856380915_194808886514999881_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fG7Y1lOyCXUQ7kNvwH0f72Z&_nc_oc=AdoQsp6CMzjtm-vjX7WY7FeVwkBlOVv0LsQD1_vJ8cZ8eUOnz95n06prn8WVAyCn3-M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6KzlUASg_rOE1E85wpLnUOH1I5sOVR0v_Nu1N8RkbHA&oe=6AD22E60"}, {"file_name": "5.png", "id": "1205275824613163", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827725_1205275827946496_6590254745310744650_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oy4wxjpEQpoQ7kNvwGW0nlx&_nc_oc=Adr3TLt6NcarGA2vWuU_qP8XkX-vEV0OiVW3Eu01eGmMrfHCendVWqMhZYch_MonFWw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNb9dJv4sW4OVD98qEihd2VI59NyDobYXk9iEFdqkUvbg&oe=6AD2551B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1240041094480676", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830007_1240041097814009_6984677165668359827_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRrUmO6u-e0Q7kNvwGcxJTc&_nc_oc=AdpiVvnoGvtsrb0RbjM3TmVxtE1OYUkjIkKPNOI55jLJhR4BrGKH4x7WqU6jab7rADo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOo6Mc3ogqTsBrY6xoEL6kBNFMvbJWsn1JzAkR4X6sDoQ&oe=6AD23995"}, "display_name": "Ping Pong", "keywords": ["Tabletennis", "pingpong", "table", "tennis"], "long_description": "Ping Pong is a simple yet atmospheric single-player table tennis game designed for immersive fun. Play across eight distinct maps, each with its own unique vibe, from cozy indoor rooms to unexpected outdoor Settings. While the game is small and focused, it offers a nice experience with satisfying sound design and a relaxing atmosphere that makes every session enjoyable. It's an easy-to-pick-up, engaging way to enjoy table tennis in VR.", "short_description": "Step into the action with Ping Pong, a fun single player table tennis
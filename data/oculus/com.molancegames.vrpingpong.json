f0JjTh6ln9z5NDGy3F3AAdDEVnc1fJ_XlMysAK6oYEkiQ&oe=69ECC960"}, {"file_name": "5.png", "id": "1205275824613163", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827725_1205275827946496_6590254745310744650_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45ws8E7ngV0Q7kNvwGvn4CV&_nc_oc=AdpqC1Zs0F3ZOWAu6Ymteeqz16xWpJsMCer776_dq1290kTo1Bqz0E0lg5687D_A2RU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RpupTNtme3xoO55yftDCpAsux837a80VWLujJUrj6jw&oe=69ECB7DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1240041094480676", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830007_1240041097814009_6984677165668359827_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxCEYjUEZowQ7kNvwEsswuo&_nc_oc=AdrcU05_NEU4OLTqemrpZL0bmFAERnyoRalule0rejaSzgDYpWgoFt1tq7YpXl8V1IA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0W_nxfjsSibyID-TpE9MJKM5zkXiZ4N7VRMt2j24FMtg&oe=69ECD495"}, "display_name": "Ping Pong", "keywords": ["Tabletennis", "pingpong", "table", "tennis"], "long_description": "Ping Pong is a simple yet atmospheric single-player table tennis game designed for immersive fun. Play across eight distinct maps, each with its own unique vibe, from cozy indoor rooms to unexpected outdoor Settings. While the game is small and focused, it offers a nice experience with satisfying sound design and a relaxing atmosphere that makes every session enjoyable. It's an easy-to-pick-up, engaging way to enjoy table tennis in VR.", "short_description": "Step into the action with Ping Pong, a fun single player table tennis experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags
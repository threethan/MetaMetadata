-player table tennis game designed for immersive fun. Play across eight distinct maps, each with its own unique vibe, from cozy indoor rooms to unexpected outdoor Settings. While the game is small and focused, it offers a nice experience with satisfying sound design and a relaxing atmosphere that makes every session enjoyable. It's an easy-to-pick-up, engaging way to enjoy table tennis in VR.", "short_description": "Step into the action with Ping Pong, a fun single player table tennis experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28817079451268975"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "1670809744592734"}, {"status": "PUBLISHED", "id": "1712895629790713"}, {"status": "PUBLISHED", "id": "1032070466314976"}, {"status": "PUBLISHED", "id": "1366370302016381"}, {"status": "PUBLISHED", "id": "2391147721393948"}, {"status": "PUBLISHED", "id": "1979735533424452"}, {"status": "PUBLISHED", "id": "1839963139971916"}, {"status": "PUBLISHED", "id": "874913525180409"}, {"status": "PUBLISHED", "id": "1820694825226334"}, {"sta
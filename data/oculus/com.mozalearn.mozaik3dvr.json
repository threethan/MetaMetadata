 history, technology, physics, mathematics, biology, chemistry, geography and visual arts will turn learning into an adventure.\n", "short_description": "Interactive 3D Animations that turn learning into an adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mozaweb.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Mozaik Education", "support_website_url": null, "website_url": "https://www.mozaweb.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25249204004717218"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974804_732701858275239_981166871501186348_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mC4zZxJhBUQ7kNvwEMTYZA&_nc_oc=AdpMnfSH9fgPTcxKV84KXp3h21JWugtv_ASW1wbb0Ub-lRRpsb-LHbVmsOaxguBA9no&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2BYxCd87pJV-pJX8UvHwiYcuTwmqPGrP65rE6DUQRomg&oe=69F20CFA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "mozaik3D", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1675670400, "lastRevision": {"nodes": [{"id": "5873611042703137", "release_type": "SCHEDULED", "ad
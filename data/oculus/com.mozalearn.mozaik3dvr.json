052810458_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThZ1K9XLHogQ7kNvwHWgYIT&_nc_oc=AdqgcEWzx3B76gOS3tjNmLoBLF9TGBVN2o-nltqsRyrG43IY9za98rGBMCoC7yhS2HQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfomAT8kvM9sIYgWZuL_HNZhsLsnJpiwuFRWOJZI2EyA&oe=6AF7293D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "mozaik3D", "keywords": [], "long_description": "Let\u2019s make learning fun!\n\nIf you liked our previous educational 3D applications, you will love this one!\nDownload the mozaik3D educational application to explore our educational 3D scenes on your VR device.\n\nPlease note that this educational application requires a continuous Internet connection.\n\nOur 3D scenes have been designed mainly for students. They provide a unique help for learning at home in a playful and enjoyable manner. The interactive educational scenes related to history, technology, physics, mathematics, biology, chemistry, geography and visual arts will turn learning into an adventure.\n", "short_description": "Interactive 3D Animations that turn learning into an adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mozaweb.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Mozaik Education", "support_website_url": null, "website_url": "https://www.mozaweb.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_intera
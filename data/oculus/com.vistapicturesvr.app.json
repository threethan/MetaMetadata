A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs_t4he4TPWxjAloGDsY1_c4Y3n4645Ak-PozuOiBUaw&oe=6AEB57AF"}, {"file_name": "3.png", "id": "1652871712929572", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823746_1652871719596238_1954979673295351500_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAyBZnNEW9gQ7kNvwHDXFJj&_nc_oc=AdopSocFtoeCw0zwTYxgAlBGkO2WpVl8TOk145vbe5DV3rk_pMCofs5tQWkLJzoq6-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmNCeNB4rcskI4wkUHyqOyuc5dp1JMDyHokkmIcZIXhg&oe=6AEB337A"}, {"file_name": "4.png", "id": "1590201829168621", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824322_1590201832501954_3910930143941112256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDhm75qoRuMQ7kNvwHgjTzZ&_nc_oc=Adpk4y9rd8pa48WB51FpAuSYckiQLusrhN_6f0CjVhFWmRkh61c9fOBpkpU556sHheU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTahfvycoTcQ65Yw6LA7AQkuXvmY87dc6Ruu2ctmaRXzg&oe=6AEB5F91"}, {"file_name": "5.png", "id": "1106120971767369", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823296_1106120975100702_8262311673365068041_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xr9kS7kqjgQ7kNvwEqHSEj&_nc_oc=Adrdc_D7jOpyjNbG5ZzwzpiAgVWo7QhLncdpvAzNbRFDZ4MexY6kFsN8fsG3W5WmJKQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTP_rorq0CuqponnngkHfEYvEhHpDM1rqvjLaSl_daYqg&oe=6AEB6245"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vista Pictures VR", "keywords": ["viewer", "model", "photos", "gallery", "HDRI"], "long_description": "Vista Pictures VR is a viewer built for the way you actually use a headset.\n\nSEE EVERYTHING YOU OWN\nPhotos, 3D models, 360 HDRI environments and material textures, all in one browser. Images in JPEG, PNG, WebP, HEIF and more. Models in GLB, glTF, STL, OBJ, PLY and 3MF. HDRI skies in Radiance and OpenEXR, up to 16K.\n\nTURN ANY PHOTO INTO 3D\nOpen a flat photo and see it in real stereo depth, with a slider for how far it stands out. The depth model runs on the headset itself \u2014 nothing is uploaded \u2014 and each result is kept, so the second look is instant. Your own photos, finally worth putting a headset on for.\n\nSTEP INSIDE\nOpen anything in a full immersive space. Stand inside a 360 sky, orbit a model at any scale, and see it lit by the environment around it. Key light, ambient, reflections and shadows on real sliders. Dress a model in glass, metal, marble or wood. Passthrough on an opacity slider, so your room shows through whatever you are viewing.\n\nBRING IN MORE\nSearch Poly Haven from inside the app and download skies, models and textures at the resolution you choose. Everything there is free and public domain.\n\nREACH YOUR FILES\nHeadset storage, USB drives, SMB and network shares, Dropbox, Google Drive and OneDrive. Thumbnails are cached in the background, so scrolling stays smooth even through folders of 8K skies.\n\nShips with sample images, so there is something to look at from the very first launch.\n\nQuestions or problems? Find us on Discord: https://discord.gg/Y8kVdFbKhX", "short_description": "Vista Pictures VR turns your Quest into a proper viewer for everything visual you own. View photos at full resolution, walk around 3D models, and stand inside 360 HDRI skies. Open files from headset storage, a network share or your cloud drive. Thumbnails load instantly and models appear the moment they are read. Light, grade and inspect anything in an immersive space, then search Poly Haven for free CC0 skies, models and textures without ever taking the headset off."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/vista/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": "https://discord.gg/aTz3Q5ykc", "website_url": "https://f1tt0n.github.io/vista/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1345626108638301"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824292_907545278617702_3222414157515944877_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqVegZX4uwwQ7kNvwHB8Hyn&_nc_oc=Adqy8L882OmsCrsssJYs7FAtUzAefakC-q1nck0XVMAuvht3zRmom-_XgGuxaxceZYM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3D3ssan-c1UeJNYcsS3lEuThiD86bWnop_YRK75mUrg&oe=6AEB390B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vista Pictures VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1788185580, "lastRevision": {"nodes": [{"id": "1174830709051176", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1174830685717845", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1738455794071499"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "vertical_1008x1440.png", "id": "1417268183834366", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823949_1417268187167699_8238215918
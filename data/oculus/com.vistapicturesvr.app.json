t=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT24sGhgusuodMmjG2viPqhdxq6JYs4F1m3m1OE9UIGdQ&oe=6B086CBA"}, {"file_name": "4.png", "id": "1590201829168621", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824322_1590201832501954_3910930143941112256_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmXiy0k3sfcQ7kNvwEd8psB&_nc_oc=AdqDRDunzbrLsAmQzZERQLNzcRcAsL8nnj65mslEMciBVevvwif1OtsHM05j3HVNUek&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8zb2AWU4Q3SBK1n_1vQjRV8hA_gHtTt-_hFO8QNeqVA&oe=6B086091"}, {"file_name": "5.png", "id": "1106120971767369", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823296_1106120975100702_8262311673365068041_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHcijGPvU6kQ7kNvwENe6HM&_nc_oc=Adq0yQjX7LOQiDkqIUsWGJ4ETJzvmD1MFFDm_o5GRWKKLZVTVZBjMILQMfkz0OHqWXk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIyB4FVktLxexGkjYDnPQ3oI0sNRxYI4LKdmmOQAlcVw&oe=6B086345"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vista Pictures VR", "keywords": ["viewer", "model", "photos", "gallery", "HDRI"], "long_description": "Vista Pictures VR is a viewer built for the way you actually use a headset.\n\nSEE EVERYTHING YOU OWN\nPhotos, 3D models, 360 HDRI environments and material textures, all in one browser. Images in JPEG, PNG, WebP, HEIF and more. Models in GLB, glTF, STL, OBJ, PLY and 3MF, including the files that come out of a slicer. HDRI skies in Radiance and OpenEXR, up to 16K.\n\nTURN ANY PHOTO INTO 3D\nOpen a flat photo and see it in real stereo depth, with a slider for how far it stands out. The depth model runs on the headset itself \u2014 nothing is uploaded \u2014 and each result is kept, so the second look is instant. Your own photos, finally worth putting a headset on for.\n\nSTEP INSIDE\nOpen anything in a full immersive space. Stand inside a 360 sky, orbit a model at any scale, and see it lit by the environment around it. Key light, ambient, reflections and shadows on real sliders. Nine colour grades. Dress a model in glass, metal, marble or wood. Passthrough on an opacity slider, so your room shows through whatever you are viewing.\n\nBRING IN MORE\nSearch Poly Haven from inside the app and download skies, models and textures at the resolution you choose. Everything there is free and public domain.\n\nREACH YOUR FILES\nHeadset storage, USB drives, SMB and network shares, Dropbox, Google Drive and OneDrive. Thumbnails are cached in the background, so scrolling stays smooth even through folders of 8K skies.\n\nShips with sample images, so there is something to look at from the very first launch.", "short_description": "Vista Pictures VR turns your Quest into a proper viewer for everything visual you own. View photos at full resolution, walk around 3D models, and stand inside 360 HDRI skies. Open files from headset storage, a network share or your cloud drive. Thumbnails load instantly and models appear the moment they are read. Light, grade and inspect anything in an immersive space, then search Poly Haven for free CC0 skies, models and textures without ever taking the headset off."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/vista/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": "https://discord.gg/aTz3Q5ykc", "website_url": "https://f1tt0n.github.io/vista/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1174830695717844"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2575451312912232"}]}, "baseline_offer": {"id": "2575451312912232"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1788185580, "status": "PUBLISHED", "id": "2575451312912232"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1412417545292490", "version": "1.1.0"}, "id": "1332458715172023", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1174830685717845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1412417545292490"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1332458715172023"}]}, "change_log": "New: Blender Bridge. Send scenes straight from Blender to the headset with the free add-on. Materials, lights, cameras, animation and the World sky come along.", "created_date": 1794959282, "id": "1412417545292490", "version": "1.1.0", "version_code": 12, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1174830685717845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1412417545292490"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1332458715172023"}]}, "change_log": "1.0.0 (11) \u2014 added hand tracking: fixed some major bugs", "created_date": 1788896691, "id": "1269050076295905", "version": "1.0.0", "version_code": 11, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1174830685717845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1412417545292490"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1788895885, "id": "1269033936297519", "version": "1.0.0", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1174830685717845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1412417545292490"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1332458715172023"}]}, "change_log": "1.0.0 (9) \u2014 fixes the unresponsive state (black screen when going back)\n\nAlso:\n- Poly Haven downloads default to 8K for skies and 2K for textures and models instead of 'Max'.\n- Storage permission is re-checked on resume\n- Bitmap and panorama ceilings are read from the device: Quest 2 (6 GB) gets 8K skies, 4096\n  pictures, 2048 textures; Quest 3 / 3S / Pro (8 GB) keep 16K, 8192, 4096.\n- Thumbnail cache is bounded with least-recently-used eviction; it previously grew without\n  limit on a large library.", "created_date": 1787631359, "id": "1245354065332173", "version": "1.0.0", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1174830685717845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1412417545292490"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1332458715172023"}]}, "change_log": "1.0.0 (6) \u2014 completes the fix for the ANRs reported on Textures and Images.\n\nThe crash panel named two causes, PatternNative.compileImpl and MatcherNative.matchesImpl.\nBoth are regular expressions on the main thread, and there were exactly two places doing that.\n\n1. The texture classifier compiled a regex for every token of every file name, on every batch\n   of scan results, on the main thread \u2014 and it runs for the Images and Textures categories\n   and for no others, which is why those two tabs were the ones that stopped responding. The\n   pattern is now compiled once, and it is tried last of three tests, so for most tokens no\n   matcher is created at all. The classification also moved off the main thread, and partial\n   scan results are delivered on a 400 ms clock instead of every 20 files, which removes work\n   that grew with the square of the library.\n\n2. The syntax highlighter built 76 Regex objects on every recomposition of the text editor \u2014\n   every keystroke, every scroll \u2014 and ran them all over the whole document. Patterns are now\n   compiled once and kept, and files over 128 KB are shown without colouring.\n\nAlso in this build:\n- Applying a texture or opening a picture no longer decodes at unbounded size. An 8K material\n  map is 268 MB decoded before GL takes its own copy; both are now bounded, and the pixel copy\n  handed to the renderer runs on a worker rather than the main thread.\n- Memory ceilings are read from the device: Quest 2 (6 GB) gets 8K skies, 4096 pictures and\n  2048 textures; Quest 3 / 3S / Pro (8 GB) keep 16K, 8192 and 4096. Nothing visible is lost \u2014\n  8K equirect already exceeds what these panels resolve.\n- The thumbnail cache is bounded with least-recently-used eviction; it previously grew without\n  limit on a large library.\n- Category scans skip Android/, stop when the user leaves the tab, and refuse a model too\n  large to read rather than dying without a message.\n- Uncaught exceptions are recorded to logcat and to a file, so a fault in the field can be\n  diagnosed rather than guessed at.", "created_date": 1787079843, "id": "1232889589911954", "version": "1.0.0", "version_code": 6, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
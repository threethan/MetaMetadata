arque_estrelas.png", "id": "1027116266423920", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620875_1027116269757253_5411885020667996430_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FT2CSsDsPOkQ7kNvwFmQSJz&_nc_oc=AdrvNJdt7Kw6497DzsgK_e8H8wXCHk1TFhWaH6k8NZTBUfDEVK-Kg4S9X8Ab1RqpQhw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqWLCasZiAJ_4ZHHGCCdYvYaR-RiCMGLh3vkme0aKS4Q&oe=6AB3E2EF"}, {"file_name": "screenshot_5_apartamento.png", "id": "2382296738929897", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619697_2382296742263230_3527980289177394613_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6P8Pru7wbwQ7kNvwGzWs6b&_nc_oc=AdoM1gFDfuncD1gjO6akUWzUx0QVABfSCZQQTaGVZjQQYkAVq-gCJjUUIOR9BZDuNM8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJn_J7Xcz24iyuXeynb6R2vrrhV8YePCz4eBO98vGaFdA&oe=6AB3CA58"}, {"file_name": "Gemini_Generated_Image_vyhgu0vyhgu0vyhg.png", "id": "2255073115304094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593922576_2255073118637427_285043050631066362_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDvKu_ij34QQ7kNvwEl1BGs&_nc_oc=AdrXmd1xoJbwmin0xuCtwmvu6AQwUisBuooyRfqt_ByJ5acWtnurEqli17uAQcC-aP4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIZuNQl3jiuZyrisSTgS1qdxK9KPPgAhVz0j6z-bNTNA&oe=6AB3CC5F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wheelchair Simulator", "keywords": ["wheelchair", "simulator", "mobility", "training", "accessibility"], "long_description": "This simulator provides a safe, immersive environment for practising\nelectric wheelchair driving.\n\nDriving an electric wheelchair takes motor coordination, spatial\nawareness, and quick reactions to obstacles \u2014 skills that need time and\nrepetition to build. Yet real-world training isn't always practical,\nrequiring large spaces, constant supervision, and a wheelchair that may\nnot be available. Built for rehabilitation contexts, this simulator\nremoves those barriers, letting users develop and refine their driving\nskills at their own pace, as many times as they need.\n\nFEATURES\n\n- 10 progressive training levels\n\n- Freestyle mode \u2014 Explore an open virtual city with no time limit. Roam\nthe streets to discover collectible stars scattered across the city.\n\n- Realistic wheelchair physics. Choose between front-wheel and rear-wheel steering.\n\n- Built-in gamification \u2014 Earn one to three stars per level based on your\nperformance, unlock levels as you progress.\n\n- Performance tracking \u2014 Each user has their own profile. Every run\nrecords the completion time, frontal and rear collisions, and lateral\nslips, with a full session history so progress can be reviewed over time.\n\nDeveloped in Unity 3D in partnership with a rehabilitation institution,\nthis project makes wheelchair driving training accessible to everyone who\nneeds it \u2014 one practice run at a time.", "short_description": "This simulator provides a safe, immersive environment for practising\nelectric wheelchair driving."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sergiolipe.github.io/Wheelchair_Simulator/", "developer_terms_of_service_url": null, "publisher_name": "S\u00e9rgio Gon\u00e7alves IPCA", "support_website_url": null, "website_url": "https://github.com/SergioLipe/Wheelchair_Simulator", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supp
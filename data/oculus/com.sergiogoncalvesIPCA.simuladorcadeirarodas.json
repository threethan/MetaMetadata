_ss=7f20f&oh=00_AQKkSAl05-96II8ZBR57R1kEMfw9dN6UgUtGtXaYiSSvgg&oe=6AB3E04D"}]}, "id": "1382664473705335", "locale": "pt_PT", "screenshots": [{"file_name": "screenshot_1_cidade_transito.png", "id": "26885849917783548", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620444_26885849921116881_5591695186752407071_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xXVwlIPsJEQ7kNvwFXYzMC&_nc_oc=AdpNxam9dq6zWASqTyVTNlkabRt08l24OhxRtCskXlTqM8QL3An-KgeMn9vl4j3mth4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJONY7ipwPw0O7PsYbNKur9mjGU2F9dMH6-Vq6tNwmIwQ&oe=6AB3D669"}, {"file_name": "screenshot_5_apartamento.png", "id": "1525860925848075", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604302364_1525860929181408_4183251734614500093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huhuJa6HHRQQ7kNvwHPRhVF&_nc_oc=Adri2_G6RbBJjJyq_xdD6IaAgyMiG8UqEDXnk0AH0xR6mYldTjw0zLtt68Tfo1F1Wjw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIutQh6VdPl4rWWFLgmkY4OjJ-ZH1aKwdqX7-RkJvZkZQ&oe=6AB3F6D5"}, {"file_name": "screenshot_4_interior_wc.png", "id": "2277482209724035", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620875_2277482213057368_3944574542808685624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-vJC1TfcBAQ7kNvwHvK1ni&_nc_oc=Ado425FPIpnUH-IMcZni45BadMJR_m94adq1tG7DM_Yy0yw7dwN7s0E7wZ5tyWeKIzY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJi-23yH1KGyDczze4fG_4H3-41_dwGtlPu-2FJ8MJtQ&oe=6AB3C236"}, {"file_name": "screenshot_3_parque_estrelas.png", "id": "989442763954277", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831569_989442767287610_751637419418906524_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuhEjkG7hf8Q7kNvwEfeTid&_nc_oc=AdpJCni1_JQM1KjLIhmTN_LtaU1JNzdb0ZQ_Coiz-TnCQKPKOn6gPunvfKzihgKJ8QQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlLDs7siOyR6rpnHo3QE9Cw_tdB_pJjJoaMlBp0PDHaA&oe=6AB3EE9D"}, {"file_name": "Gemini_Generated_Image_vyhgu0vyhgu0vyhg.png", "id": "1304382758026091", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314351_1304382761359424_3115643246595077544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_HCVYI30p8Q7kNvwGUXkOj&_nc_oc=AdqHrKtgJoM8snCRMJdk-v1b2jb1VdlDCFrWXYcfaEUMnk67ZWXYdsDWx1Vhy0WVEaI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvIJgyEGFaUJOetjavTpjrUVTr8La8zieMexFfU1X7XQ&oe=6AB3DDE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Simulador de Cadeira de Rodas", "keywords": ["mobilidade", "treino", "acessibilidade", "simulador", "CadeiraDeRodas"], "long_description": "Este simulador oferece um ambiente seguro e imersivo para praticar a\ncondu\u00e7\u00e3o de uma cadeira de rodas el\u00e9trica.\n\nConduzir uma cadeira de rodas el\u00e9trica exige coordena\u00e7\u00e3o motora, perce\u00e7\u00e3o\nespacial e rea\u00e7\u00f5es r\u00e1pidas a obst\u00e1culos \u2014 compet\u00eancias que precisam de\ntempo e repeti\u00e7\u00e3o para se desenvolverem. No entanto, o treino no mundo\nreal nem sempre \u00e9 pr\u00e1tico: exige espa\u00e7os amplos, supervis\u00e3o constante e\numa cadeira que pode n\u00e3o estar dispon\u00edvel. Concebido para contextos de\nreabilita\u00e7\u00e3o, este simulador remove essas barreiras, permitindo que cada\nutilizador desenvolva e aperfei\u00e7oe as suas compet\u00eancias ao seu pr\u00f3prio\nritmo, tantas vezes quantas precisar.\n\nCARACTER\u00cdSTICAS\n\n- 10 n\u00edveis de treino progressivos.\n- Modo livre \u2014 Explora uma cidade virtual aberta, sem limite de tempo.\nPercorre as ruas para descobrir estrelas colecion\u00e1veis espalhadas pela\ncidade.\n- F\u00edsica realista - Podes escolher entre dire\u00e7\u00e3o dianteira e traseira.\n- Gamifica\u00e7\u00e3o integrada \u2014 Ganha uma a tr\u00eas estrelas por n\u00edvel consoante o\nteu desempenho, desbloqueia n\u00edveis \u00e0 medida que progrides.\n- Acompanhamento de desempenho \u2014 Cada utilizador tem o seu pr\u00f3prio perfil.\nCada percurso regista o tempo de conclus\u00e3o, as colis\u00f5es frontais e\ntraseiras e os deslizes laterais, com um hist\u00f3rico completo de sess\u00f5es\npara acompanhar a evolu\u00e7\u00e3o ao longo do tempo.\n\nDesenvolvido em Unity 3D em parceria com uma institui\u00e7\u00e3o de reabilita\u00e7\u00e3o,\neste projeto torna o treino de condu\u00e7\u00e3o de cadeira de rodas acess\u00edvel a\ntodos os que dele precisam.\n", "short_description": "Este simulador oferece um ambiente seguro e imersivo para praticar a\ncondu\u00e7\u00e3o de uma cadeira de rodas el\u00e9trica."}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "4341550742726828", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507849536_4341550746060161_2756286828447256237_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_eYoVtedOUQ7kNvwFN8Zxr&_nc_oc=Ado76vS1jFz5lE6n4M-T7YIpWlLPSye5ldhuW4w6BkgVlkmpr1yLVVzqkfzhA824PF0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKgSbEYiq-CjXTeHac96E0fZ-J_TIDZS1iV_wzKjiSBw&oe=6AB3C2EE"}, {"file_name": "Hero Cover.png", "id": "2172494853538405", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825305_2172494860205071_7928613279375044794_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rks8OrCKeUQ7kNvwFNylhB&_nc_oc=Ado5HhJy4R2x_ar4k7HC1xT2x7hR5kZBMgs2yriumszpM4VMnEXpUzaaJp7QXypf__0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMw6PAqYp9RMSi9-0NReX5xxyeFm_koWI4CP3OlbFwrg&oe=6AB3CAFE"}, {"file_name": "icon.png", "id": "1776235200452438", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823812_1776235203785771_5730329444151793145_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56NhZ82pb3gQ7kNvwHJYWtn&_nc_oc=Adoau_J-CsBF2oMUjs7Y8hgD4XCZz0zxShe6NhSPCNmFHLjttP21533uUuPznwJlqr4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOyzh914NFFMhzRF
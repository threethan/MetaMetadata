20444_26885849921116881_5591695186752407071_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xXVwlIPsJEQ7kNvwFXYzMC&_nc_oc=AdpNxam9dq6zWASqTyVTNlkabRt08l24OhxRtCskXlTqM8QL3An-KgeMn9vl4j3mth4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJONY7ipwPw0O7PsYbNKur9mjGU2F9dMH6-Vq6tNwmIwQ&oe=6AB3D669"}, {"file_name": "screenshot_5_apartamento.png", "id": "1525860925848075", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604302364_1525860929181408_4183251734614500093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huhuJa6HHRQQ7kNvwHPRhVF&_nc_oc=Adri2_G6RbBJjJyq_xdD6IaAgyMiG8UqEDXnk0AH0xR6mYldTjw0zLtt68Tfo1F1Wjw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIutQh6VdPl4rWWFLgmkY4OjJ-ZH1aKwdqX7-RkJvZkZQ&oe=6AB3F6D5"}, {"file_name": "screenshot_4_interior_wc.png", "id": "2277482209724035", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620875_2277482213057368_3944574542808685624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-vJC1TfcBAQ7kNvwHvK1ni&_nc_oc=Ado425FPIpnUH-IMcZni45BadMJR_m94adq1tG7DM_Yy0yw7dwN7s0E7wZ5tyWeKIzY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJi-23yH1KGyDczze4fG_4H3-41_dwGtlPu-2FJ8MJtQ&oe=6AB3C236"}, {"file_name": "screenshot_3_parque_estrelas.png", "id": "989442763954277", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831569_989442767287610_751637419418906524_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuhEjkG7hf8Q7kNvwEfeTid&_nc_oc=AdpJCni1_JQM1KjLIhmTN_LtaU1JNzdb0ZQ_Coiz-TnCQKPKOn6gPunvfKzihgKJ8QQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlLDs7siOyR6rpnHo3QE9Cw_tdB_pJjJoaMlBp0PDHaA&oe=6AB3EE9D"}, {"file_name": "Gemini_Generated_Image_vyhgu0vyhgu0vyhg.png", "id": "1304382758026091", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314351_1304382761359424_3115643246595077544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_HCVYI30p8Q7kNvwGUXkOj&_nc_oc=AdqHrKtgJoM8snCRMJdk-v1b2jb1VdlDCFrWXYcfaEUMnk67ZWXYdsDWx1Vhy0WVEaI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvIJgyEGFaUJOetjavTpjrUVTr8La8zieMexFfU1X7XQ&oe=6AB3DDE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Simulador de Cadeira de Rodas", "keywords": ["mobilidade", "treino", "acessibilidade", "simulador", "CadeiraDeRodas"], "long_description": "Aprende a conduzir uma cadeira de rodas el\u00e9trica num ambiente seguro e imersivo. Pratica ao teu pr\u00f3prio ritmo, sem riscos e quantas vezes precisares.\n\nCARACTER\u00cdSTICAS\n\n10 n\u00edveis progressivos \u2014 Avan\u00e7a por desafios cada vez mais exigentes, do mais simples ao mais complexo.\nModo livre \u2014 Explora uma cidade virtual aberta, sem limite de tempo. Percorre as ruas e descobre estrelas colecion\u00e1veis espalhadas pela cidade.\nSistema de colis\u00f5es \u2014 Cada toque conta. O simulador deteta colis\u00f5es frontais e traseiras e deslizes laterais, ajudando-te a conduzir com mais precis\u00e3o e cuidado.\nAcompanhamento de desempenho \u2014 Cada utilizador tem o seu pr\u00f3prio perfil. Cada percurso regista o tempo, as colis\u00f5es e os deslizes, com um hist\u00f3rico completo de sess\u00f5es para acompanhares a tua evolu\u00e7\u00e3o.\nDire\u00e7\u00e3o configur\u00e1vel \u2014 Escolhe entre dire\u00e7\u00e3o dianteira e traseira.", "short_description": "Este simulador oferece um ambiente seguro e imersivo para praticar a\ncondu\u00e7\u00e3o de uma cadeira de rodas el\u00e9trica."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sergiolipe.github.io/Wheelchair_Simulator/", "developer_terms_of_service_url": null, "publisher_name": "S\u00e9rgio Gon\u00e7alves IPCA", "support_website_url": null, "website_url": "https://github.com/SergioLipe/Wheelchair_Simulator", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3315291881322
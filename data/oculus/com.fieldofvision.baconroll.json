ukrOOJVZ_rN0cqZy2N5dlubDfV6012yFQJFspo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHUKFIiuBd0ldFJkvE8Koqzi3gusMYpNz2bPAQb0WcBg&oe=69CA6DD0"}, {"file_name": "12410200_1072769176197373_3224455652478812160_n.png", "id": "751803505768309", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974684_751803509101642_4759040815345545759_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oYSVuA3GFYQ7kNvwECsnqL&_nc_oc=AdqfsvX_LfDEWkuQ6iXsKltzNCZIcj1R9WXtZovIVkg0Hhpe36E_e6JyN4FEHFHxnN0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxn7eZUgakAzcaaAsQWpG1zVr58Kkmyculqm5ANa13Vog&oe=69CA75E3"}, {"file_name": "11162732_379675985777869_7009587657311256576_n.png", "id": "2813264045554837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984476_2813264052221503_6203106677666323288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpfrcvEWolUQ7kNvwE4DFKE&_nc_oc=AdqBg43o5ePFCSYR42d2b7XyQR8i_zdVEkLAdfoMqgTtrtuHAHiYGHjf-2iZTBTCwlM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-8x1N4oIXOZL15oJarCaoW0bjfzCPG9bPmfpnFHm4Xw&oe=69CA8981"}, {"file_name": "screen5.png", "id": "431571644615495", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031363_431571647948828_6278636924673278426_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVPSZ5DSfXoQ7kNvwHv8ubd&_nc_oc=Adrecl6zl7PDuO9Co8caYUf1RY8Ya74YbI_K5vj4CD_yOFPNPInUmW-Xo3-K0Znh8Aw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0FK1xSsmovHM9ZF3BQswGVMPMB57GjMGJ4kbl_fa-0A&oe=69CA6F13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OCU_2560x1440.png", "id": "881202649331645", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974450_881202652664978_4044905578170516514_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTOxQyxKHfMQ7kNvwF206pe&_nc_oc=AdoA7HZVwXN37vzJgeo5WbIoBzxJO5-pxkIfF1Jax-phJ8hm_I-QuD2MP-8ne06lmnQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZcu6lEPYE7nIIz56_hgQQLIRFvoNN3pkdDeHDm1-eAA&oe=69CA8783"}, "display_name": "Bacon Roll", "keywords": [], "long_description": "Help Dot the pig roll away from the evil wolf chef, thus ruining his dinner plans. With the help of his father and his brother, you will guide Dot to his beloved Princess Rune.\n\n\u25cf  Discover crazy worlds\nThroughout the escape Dot will encounter various environments, from forests, snow mountains to sci-fi and even maybe a little trip to other worlds. Who knows. Maybe he's an astronaut pig. Maybe he's a super pig that can fly.\n\n\u25cf  Conquer your skills\nUnlock a variety of power ups to help Dot throughout his escape, as well as discover new outfits for him to wear that give him extra special bonuses when he wears them.\nRoll, Jump, shoot and dodge. That\u2019s the way the pig goes.\n\n\u25cf  Go shopping\nYou can upgrade your power ups in the game using the tomato currency. The more tomatoes you collect while you play, the more you can upgrade your power ups and unlock new outfits for Dot!\n\n\u25cf  Show off your dance moves\nYou have trotters instead of your hands! Isn't that a good enough reason to dance?", "short_description": "Help Dot the pig roll away from the evil wolf chef, thus ruining his dinner plans.\n\nThroughout the escape Dot will encounter various environments, from forests, snow mountains to sci-fi and even maybe a little trip to other worlds. Who knows. Maybe he's an astronaut pig. Maybe he's a super pig that can fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscrip
g94PNJ5avS_8Syrcyhvrx0Hrm0iKmQKxqbEy30&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nX94162N-_Hlhpd3bRj-58hesp4C6P5Z-6LfHTrtfEw&oe=69E37A50"}, {"file_name": "12410200_1072769176197373_3224455652478812160_n.png", "id": "751803505768309", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974684_751803509101642_4759040815345545759_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6f2CtzKg0QQ7kNvwH7mVjL&_nc_oc=AdphloMhgCl8CvLc5c7IUgo_SWUWDsh3v76naIED0aezyHkSKugmbCPngo9UQPbkU90&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iwFUwuhyswDl8e0oLGuz1KHs2HtgIfI3GtOQxslxEBA&oe=69E38263"}, {"file_name": "11162732_379675985777869_7009587657311256576_n.png", "id": "2813264045554837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984476_2813264052221503_6203106677666323288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPRe0Hn9HzcQ7kNvwFoqgAx&_nc_oc=AdofRGvwyFaKeMHdirku7ipx7rjsOCX10JymrJTpwvZlpgbBAoC97M5nEAxdrSTN4_8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NsgmsQoguMYzSITelhU1hyoNGOqGvGiPDC4Zk19cbAQ&oe=69E39601"}, {"file_name": "screen5.png", "id": "431571644615495", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031363_431571647948828_6278636924673278426_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2FsevLhATAQ7kNvwHWBQ0s&_nc_oc=AdqOxQyZKLrAgXqLlvt2BGHwYsSmXdHGR1Xq9pSUdc2cWhTd3u93PF74ouRvHEQ-7YI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xm_aT2Gh1VE6R-bNlbMqQdIMiOOn8uSrSUHsWBVrKkA&oe=69E37B93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OCU_2560x1440.png", "id": "881202649331645", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974450_881202652664978_4044905578170516514_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ds3CbESwrocQ7kNvwHVZz5g&_nc_oc=AdpWOLQ9cC_J8tUFRSiN9nos2Ep_osO7TlxM04iM-TRSc5Y28XslpQvUlGfF0UE6rEE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2znr917TAOnAvVwrFv89l3Gsv3myF_mvXfz1OSs2WpgA&oe=69E39403"}, "display_name": "Bacon Roll", "keywords": [], "long_description": "Help Dot the pig roll away from the evil wolf chef, thus ruining his dinner plans. With the help of his father and his brother, you will guide Dot to his beloved Princess Rune.\n\n\u25cf  Discover crazy worlds\nThroughout the escape Dot will encounter various environments, from forests, snow mountains to sci-fi and even maybe a little trip to other worlds. Who knows. Maybe he's an astronaut pig. Maybe he's a super pig that can fly.\n\n\u25cf  Conquer your skills\nUnlock a variety of power ups to help Dot throughout his escape, as well as discover new outfits for him to wear that give him extra special bonuses when he wears them.\nRoll, Jump, shoot and dodge. That\u2019s the way the pig goes.\n\n\u25cf  Go shopping\nYou can upgrade your power ups in the game using the tomato currency. The more tomatoes you collect while you play, the more you can upgrade your power ups and unlock new outfits for Dot!\n\n\u25cf  Show off your dance moves\nYou have trotters instead of your hands! Isn't that a good enough reason to dance?", "short_description": "Help Dot the pig roll away from the evil wolf chef, thus ruining his dinner plans.\n\nThroughout the escape Dot will encounter various environments, from forests, snow mountains to sci-fi and even maybe a little trip to other worlds. Who knows. Maybe he's an astronaut pig. Maybe he's a super pig that can fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscrip
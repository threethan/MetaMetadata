xj56zAIVhC7YqZurVaBGhlgSxllNjtnGlXdPjU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxLLUPT6oLbchg99DMRqB242KmDzn_Ro-_abMk1O6oTJw&oe=69C7CAD0"}, {"file_name": "12410200_1072769176197373_3224455652478812160_n.png", "id": "751803505768309", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974684_751803509101642_4759040815345545759_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZWoATZ5A_gQ7kNvwGgdauo&_nc_oc=AdqRlXPPYnWc7T9NDVuMq2Gdt8DEJBRJD6KAyyefXJxzT2XFWcP-0z81l2bujoCqLeo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyfjG6vtuZP4tXOsf9yOZOS8fY9PRLkjTtVmSQpdQr8fg&oe=69C7D2E3"}, {"file_name": "11162732_379675985777869_7009587657311256576_n.png", "id": "2813264045554837", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984476_2813264052221503_6203106677666323288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCKdwZbOWxAQ7kNvwFLEN0D&_nc_oc=Adpj899SVu6QwdmPkyE13aB7KrvxOmkPTfNmp5OY9NGrfmzc08ybKU1FjzwD3YHM8S4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIwDaNrmL05PDfXggHKAF8AedREQeH8vStorY_8L5cRg&oe=69C7E681"}, {"file_name": "screen5.png", "id": "431571644615495", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031363_431571647948828_6278636924673278426_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQNqxdxuSCkQ7kNvwGlmJKX&_nc_oc=AdoX074J8C7ZYCGe9UN6_rSD8xyHckDxg5fgo1KqPikweNc8w4Mvpx7Z2nZ3m-OPU5M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQNur39Gh7SDBRCKuD2CLxS9c1wqPPZetND-UIz82WXw&oe=69C7CC13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OCU_2560x1440.png", "id": "881202649331645", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974450_881202652664978_4044905578170516514_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTOxQyxKHfMQ7kNvwFmwhDC&_nc_oc=Adq8G22DUlvqm-c6R_VzO0QqSnKRXZh9HPmAez_VuBZEAWyVM8pDAqrdsvHJwZw2Quc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7VWS6Vj0aih1sgrnWSDy4GRGVQV5VxQFK5Kvr6EwGXg&oe=69C7E483"}, "display_name": "Bacon Roll", "keywords": [], "long_description": "Help Dot the pig roll away from the evil wolf chef, thus ruining his dinner plans. With the help of his father and his brother, you will guide Dot to his beloved Princess Rune.\n\n\u25cf  Discover crazy worlds\nThroughout the escape Dot will encounter various environments, from forests, snow mountains to sci-fi and even maybe a little trip to other worlds. Who knows. Maybe he's an astronaut pig. Maybe he's a super pig that can fly.\n\n\u25cf  Conquer your skills\nUnlock a variety of power ups to help Dot throughout his escape, as well as discover new outfits for him to wear that give him extra special bonuses when he wears them.\nRoll, Jump, shoot and dodge. That\u2019s the way the pig goes.\n\n\u25cf  Go shopping\nYou can upgrade your power ups in the game using the tomato currency. The more tomatoes you collect while you play, the more you can upgrade your power ups and unlock new outfits for Dot!\n\n\u25cf  Show off your dance moves\nYou have trotters instead of your hands! Isn't that a good enough reason to dance?", "short_description": "Help Dot the pig roll away from the evil wolf chef, thus ruining his dinner plans.\n\nThroughout the escape Dot will encounter various environments, from forests, snow mountains to sci-fi and even maybe a little trip to other worlds. Who knows. Maybe he's an astronaut pig. Maybe he's a super pig that can fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscrip
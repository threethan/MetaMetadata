D7jT5lQJK5kxGPD1-hsYJDygvY6kfUhCY3O2yQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5A7760P5w-AYAVj09_Xk1uhpof17nV0_UbL5yJB28Ofg&oe=69FB3550"}, {"file_name": "12410200_1072769176197373_3224455652478812160_n.png", "id": "751803505768309", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974684_751803509101642_4759040815345545759_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPU0QnTd8JsQ7kNvwFVLF7K&_nc_oc=AdrQjISkNMsXtYg73iYVCzC2WvNttltuzRrWsq4sV2Hbf71q9YkKbsJsl7QTve2DCtY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DdZuWDPCaVImihiDNVbE9CKlX2T8uJ0h0cv1lNhVVPA&oe=69FB3D63"}, {"file_name": "11162732_379675985777869_7009587657311256576_n.png", "id": "2813264045554837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984476_2813264052221503_6203106677666323288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uo4stoNCZVEQ7kNvwHLuyPd&_nc_oc=Adrk_k73JlEgm5fMBTZr8QKg8fILMYRKMitnxYt-3WYXJBAAoKpq2RUNIMzvEuFiNME&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wEuIqVwA71U7JngwxQE0BVMmaMOzNFERD4Pe3MJ_dOw&oe=69FB5101"}, {"file_name": "screen5.png", "id": "431571644615495", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031363_431571647948828_6278636924673278426_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rOTtICM2FoQ7kNvwGd89oY&_nc_oc=AdqogcCk7ncbaRzgTnBtfFb6URynUHClj_fPIKTj-Cyl6reDitbTwHsmNr9B2c6r5Zk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6w-suFMcg81LKeonRrkHNxcITCMMWfq_IKZmTgagXAfA&oe=69FB3693"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OCU_2560x1440.png", "id": "881202649331645", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974450_881202652664978_4044905578170516514_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrw_YlZbrMIQ7kNvwGCJRZv&_nc_oc=Adq5ER7EOai4dshdhfzVuOLtxtHVqt-5FwhpJyeFwoAso_0M1QkPKf4erocSFlRRMC8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sJQKRNf8xFqGDrnNC1wn7cJVFWXwQOBMEkFoLp9ZBlQ&oe=69FB4F03"}, "display_name": "Bacon Roll", "keywords": [], "long_description": "Help Dot the pig roll away from the evil wolf chef, thus ruining his dinner plans. With the help of his father and his brother, you will guide Dot to his beloved Princess Rune.\n\n\u25cf  Discover crazy worlds\nThroughout the escape Dot will encounter various environments, from forests, snow mountains to sci-fi and even maybe a little trip to other worlds. Who knows. Maybe he's an astronaut pig. Maybe he's a super pig that can fly.\n\n\u25cf  Conquer your skills\nUnlock a variety of power ups to help Dot throughout his escape, as well as discover new outfits for him to wear that give him extra special bonuses when he wears them.\nRoll, Jump, shoot and dodge. That\u2019s the way the pig goes.\n\n\u25cf  Go shopping\nYou can upgrade your power ups in the game using the tomato currency. The more tomatoes you collect while you play, the more you can upgrade your power ups and unlock new outfits for Dot!\n\n\u25cf  Show off your dance moves\nYou have trotters instead of your hands! Isn't that a good enough reason to dance?", "short_description": "Help Dot the pig roll away from the evil wolf chef, thus ruining his dinner plans.\n\nThroughout the escape Dot will encounter various environments, from forests, snow mountains to sci-fi and even maybe a little trip to other worlds. Who knows. Maybe he's an astronaut pig. Maybe he's a super pig that can fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscrip
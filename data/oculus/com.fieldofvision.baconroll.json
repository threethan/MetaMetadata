BsU4VUpyO_1A-dfltPs-40XUMRuW23k_CFziNU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ddaj51nWWLGklpQ51Q7ywGUUtnteiE70O3Ei-se6jaw&oe=69F9E3D0"}, {"file_name": "12410200_1072769176197373_3224455652478812160_n.png", "id": "751803505768309", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974684_751803509101642_4759040815345545759_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPU0QnTd8JsQ7kNvwEy_Tp6&_nc_oc=Adq_8x40A0sKdGb_HCnsdiTD7Gw3vjNiHwOfIsmmjR7Uj9rKEnXW7Oya116DoRZjONo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VYqXl77iFEPNfT1tA1zpiJosyrGRW66Le65Qt2wlynw&oe=69F9EBE3"}, {"file_name": "11162732_379675985777869_7009587657311256576_n.png", "id": "2813264045554837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984476_2813264052221503_6203106677666323288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uo4stoNCZVEQ7kNvwEFQ3qR&_nc_oc=Ado-seG47FdwiPgvatK4qqLr0HMqNDBGdC7LRqpriPO9d81wJjCv3Wle93A1-27pAFU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gDfF1Al_czYfhUl-kKb8p1mVPmbcN1Tu39HVl6Zotaw&oe=69F9FF81"}, {"file_name": "screen5.png", "id": "431571644615495", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031363_431571647948828_6278636924673278426_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rOTtICM2FoQ7kNvwGy0cB1&_nc_oc=AdrukSGcgUA2XK4GQGuvSTrh65wyCSaFyY8kioLa28yCd972UtGv87gqq3znWlb_dnM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-9ZAcaFFnwQ9jzEwYxoxmEaY_flyOPY5t24ucWpetXQ&oe=69F9E513"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OCU_2560x1440.png", "id": "881202649331645", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974450_881202652664978_4044905578170516514_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEXmoPx0cacQ7kNvwG_UXym&_nc_oc=AdqTfjcMuGSL_gZdH95zsnyPxy8lH7tNIUDuVjr0eEpcKOa5AxFKKMcnI2CwiMH0cRU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Q01cWp87zPlOEwgXwmEfxqNG7B7grBr6YrfNajdBfhA&oe=69F9FD83"}, "display_name": "Bacon Roll", "keywords": [], "long_description": "Help Dot the pig roll away from the evil wolf chef, thus ruining his dinner plans. With the help of his father and his brother, you will guide Dot to his beloved Princess Rune.\n\n\u25cf  Discover crazy worlds\nThroughout the escape Dot will encounter various environments, from forests, snow mountains to sci-fi and even maybe a little trip to other worlds. Who knows. Maybe he's an astronaut pig. Maybe he's a super pig that can fly.\n\n\u25cf  Conquer your skills\nUnlock a variety of power ups to help Dot throughout his escape, as well as discover new outfits for him to wear that give him extra special bonuses when he wears them.\nRoll, Jump, shoot and dodge. That\u2019s the way the pig goes.\n\n\u25cf  Go shopping\nYou can upgrade your power ups in the game using the tomato currency. The more tomatoes you collect while you play, the more you can upgrade your power ups and unlock new outfits for Dot!\n\n\u25cf  Show off your dance moves\nYou have trotters instead of your hands! Isn't that a good enough reason to dance?", "short_description": "Help Dot the pig roll away from the evil wolf chef, thus ruining his dinner plans.\n\nThroughout the escape Dot will encounter various environments, from forests, snow mountains to sci-fi and even maybe a little trip to other worlds. Who knows. Maybe he's an astronaut pig. Maybe he's a super pig that can fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscrip
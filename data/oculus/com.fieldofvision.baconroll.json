NJ1r1IkphwXieifeDkoCgjgQv8R1fmsSDpTpZc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx65KqlfMonD9s4Bplt-KZUNLv9ppTILUkjtZ9C4PCJMw&oe=69C284D0"}, {"file_name": "12410200_1072769176197373_3224455652478812160_n.png", "id": "751803505768309", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974684_751803509101642_4759040815345545759_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKp3kdDR8hYQ7kNvwGS4KdO&_nc_oc=AdqV22plWRZccv5JEPYIHYY-DKUjAsDMzAPHpIJtEvxz1516nSNTFLZmtJK966Uhbs0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxy6X83BJEpEwfko0saiWzXJ-dxXFqhfFCO3oBkRcqRdw&oe=69C28CE3"}, {"file_name": "11162732_379675985777869_7009587657311256576_n.png", "id": "2813264045554837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984476_2813264052221503_6203106677666323288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDgCfzK7Vz8Q7kNvwF_CUOa&_nc_oc=AdqsUlhoo3nudYWSL5p8kqOqNrEyGzbsGOpsuebwmwCwSVARiUj2j36d5U2YXPrW-LU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwlYV_UnCq9VzeQAwAJDX0602I5hO9F63R0Tc0j4vQeyg&oe=69C2A081"}, {"file_name": "screen5.png", "id": "431571644615495", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031363_431571647948828_6278636924673278426_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACBvUvxDcikQ7kNvwHhmTal&_nc_oc=AdqL5jeiBAZ1kOxwfcJBih_pYUYCTSnIo-4BqwjxTB1BQDARgQXIZAwS-AapocWOMpE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxEmgqFjU3aijH58G19r5R-fuP1V4L_hxK43MK-3GHTvw&oe=69C28613"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OCU_2560x1440.png", "id": "881202649331645", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974450_881202652664978_4044905578170516514_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbFqRlg7ancQ7kNvwGhFIPh&_nc_oc=AdqpNlQArBXY43L0kow2EuafTPKt8uk03TmRYSPK2n14R8z1tBv85WyxbCrl2ZwyczE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwcCt0QF00mAEYXTX7iThbBLLqYDOiXII0BeAJcAqZUAA&oe=69C29E83"}, "display_name": "Bacon Roll", "keywords": [], "long_description": "Help Dot the pig roll away from the evil wolf chef, thus ruining his dinner plans. With the help of his father and his brother, you will guide Dot to his beloved Princess Rune.\n\n\u25cf  Discover crazy worlds\nThroughout the escape Dot will encounter various environments, from forests, snow mountains to sci-fi and even maybe a little trip to other worlds. Who knows. Maybe he's an astronaut pig. Maybe he's a super pig that can fly.\n\n\u25cf  Conquer your skills\nUnlock a variety of power ups to help Dot throughout his escape, as well as discover new outfits for him to wear that give him extra special bonuses when he wears them.\nRoll, Jump, shoot and dodge. That\u2019s the way the pig goes.\n\n\u25cf  Go shopping\nYou can upgrade your power ups in the game using the tomato currency. The more tomatoes you collect while you play, the more you can upgrade your power ups and unlock new outfits for Dot!\n\n\u25cf  Show off your dance moves\nYou have trotters instead of your hands! Isn't that a good enough reason to dance?", "short_description": "Help Dot the pig roll away from the evil wolf chef, thus ruining his dinner plans.\n\nThroughout the escape Dot will encounter various environments, from forests, snow mountains to sci-fi and even maybe a little trip to other worlds. Who knows. Maybe he's an astronaut pig. Maybe he's a super pig that can fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscrip
tmWIpyamctYk0ttIHjmwXavhqIpipRM8mgPB1o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1khT0Pe8rRgR8c5ndZNF1fDwk0qnWctynSULK8VibbTQ&oe=69D3A850"}, {"file_name": "12410200_1072769176197373_3224455652478812160_n.png", "id": "751803505768309", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974684_751803509101642_4759040815345545759_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZfYsDwKATEQ7kNvwFD7kpZ&_nc_oc=AdoOkqazJIqbabr6erB-Nipwt25zfhB_M5Schf3BKOIQaHjhblYzMy9KAnggl1-tgOw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cxCK3zHZ0cQ134dfgihoqP4Pdxr_hhxaI9ISsAC0Ggw&oe=69D3B063"}, {"file_name": "11162732_379675985777869_7009587657311256576_n.png", "id": "2813264045554837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984476_2813264052221503_6203106677666323288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtl8aq9Hk7gQ7kNvwE-tTvL&_nc_oc=Adqe2YjTXZv_q7uZnpnLuDeNLSM-Tjr0jbnA2-O5gWAC7pXcCRvHmbp93sK9xWitfyo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zoLc2eu1fR-VCK9JBMdl-4-nGvx2NyBG16dybYzt_hw&oe=69D3C401"}, {"file_name": "screen5.png", "id": "431571644615495", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031363_431571647948828_6278636924673278426_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQ0nJaBQlGMQ7kNvwE6H5LG&_nc_oc=AdrshjPcM8JHCJL7p1mEyVhusSlmXLCfIg1mtaJW5TUmRDFKfMsjcPnlgAgz2nQ1U2M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3X7V3qn9Jep0lOiCoF-zhAjUpDNZXPLaghy0h-8IiYKQ&oe=69D3A993"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OCU_2560x1440.png", "id": "881202649331645", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974450_881202652664978_4044905578170516514_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNWWDgKP3IIQ7kNvwFOk1Lu&_nc_oc=AdoWVQG-dDdn07FFNP958xAtepQBE2FlM60nj9Dmhax5doXikwsWmKYtj3a-GvUIag4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pP2Eh8igFpQUToVZanEaRyPIftAmtXf5XwYtE9UsMkA&oe=69D3C203"}, "display_name": "Bacon Roll", "keywords": [], "long_description": "Help Dot the pig roll away from the evil wolf chef, thus ruining his dinner plans. With the help of his father and his brother, you will guide Dot to his beloved Princess Rune.\n\n\u25cf  Discover crazy worlds\nThroughout the escape Dot will encounter various environments, from forests, snow mountains to sci-fi and even maybe a little trip to other worlds. Who knows. Maybe he's an astronaut pig. Maybe he's a super pig that can fly.\n\n\u25cf  Conquer your skills\nUnlock a variety of power ups to help Dot throughout his escape, as well as discover new outfits for him to wear that give him extra special bonuses when he wears them.\nRoll, Jump, shoot and dodge. That\u2019s the way the pig goes.\n\n\u25cf  Go shopping\nYou can upgrade your power ups in the game using the tomato currency. The more tomatoes you collect while you play, the more you can upgrade your power ups and unlock new outfits for Dot!\n\n\u25cf  Show off your dance moves\nYou have trotters instead of your hands! Isn't that a good enough reason to dance?", "short_description": "Help Dot the pig roll away from the evil wolf chef, thus ruining his dinner plans.\n\nThroughout the escape Dot will encounter various environments, from forests, snow mountains to sci-fi and even maybe a little trip to other worlds. Who knows. Maybe he's an astronaut pig. Maybe he's a super pig that can fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscrip
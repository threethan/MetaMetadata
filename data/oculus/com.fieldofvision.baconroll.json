278426_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S63f9XtLyo8Q7kNvwH_rA8-&_nc_oc=Adrlf6EIHPpIfNexefa6k9BclxHArxTiaH9unUVPW94BADjlXCLcS2ImUBdF1yZg4nM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3fotPhMlaSMt9okaMssrhSQqd_Lr7HDMhFe3lp0xjlw&oe=6AFDD4D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OCU_2560x1440.png", "id": "881202649331645", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974450_881202652664978_4044905578170516514_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nojJ_zWZFEQ7kNvwFuEfwm&_nc_oc=AdoTfLDAn-ne_HvAsTXzOlF8rETjvOr_lIHLkjRhlkDH5wlGRpVJ2mvgL3M3fxYm53g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2qlmgdkhrmyD6C1sdbxDrsYVcsFD9dQasCg8u-bem9A&oe=6AFDB503"}, "display_name": "Bacon Roll", "keywords": [], "long_description": "Help Dot the pig roll away from the evil wolf chef, thus ruining his dinner plans. With the help of his father and his brother, you will guide Dot to his beloved Princess Rune.\n\n\u25cf  Discover crazy worlds\nThroughout the escape Dot will encounter various environments, from forests, snow mountains to sci-fi and even maybe a little trip to other worlds. Who knows. Maybe he's an astronaut pig. Maybe he's a super pig that can fly.\n\n\u25cf  Conquer your skills\nUnlock a variety of power ups to help Dot throughout his escape, as well as discover new outfits for him to wear that give him extra special bonuses when he wears them.\nRoll, Jump, shoot and dodge. That\u2019s the way the pig goes.\n\n\u25cf  Go shopping\nYou can upgrade your power ups in the game using the tomato currency. The more tomatoes you collect while you play, the more you can upgrade your power ups and unlock new outfits for Dot!\n\n\u25cf  Show off your dance moves\nYou have trotters instead of your hands! Isn't that a good enough reason to dance?", "short_description": "Help Dot the pig roll away from the evil wolf chef, thus ruining his dinner plans.\n\nThroughout the escape Dot will encounter various environments, from forests, snow mountains to sci-fi and even maybe a little trip to other worlds. Who knows. Maybe he's an astronaut pig. Maybe he's a super pig that can fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fieldof.vision/BaconRoll-PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://fieldof.vision/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "493921468827334"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "466439956082996"}, {"status": "CANCELLED", "id": "880540881616006"}, {"status": "PUBLISHED", "id": "1498926301207638"}, {"status": "PUBLISHED", "id": "1331990141191894"}, {"status": "PUBLISHED", "id": "1271005543898507"}, {"status": "PUBLISHED", "id": "425810796580734"}, {"status": "PUBLISHED", "id": "440493907050988"}]}, "baseline_offer": {"id": "466439956082996"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772839380, "status": "PUBLISHED", "id": "466439956082996"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5175628505860275", "version": "1.15.41"}, "id": "132750546761
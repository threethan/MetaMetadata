MbouP2iuBkd5pAikK26gshatQwrWyDb-8ncBPI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PmwUmGTVF4gz-v50ykEmqe3hxfoO83R7bUlhPCqoKUg&oe=69DE3450"}, {"file_name": "12410200_1072769176197373_3224455652478812160_n.png", "id": "751803505768309", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974684_751803509101642_4759040815345545759_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvwVtbbMF4sQ7kNvwGETa3_&_nc_oc=Adq47j8r7AOsmz3gT-5hxqix6dU19_CM544WmHXI8-ZC7pTJIE48Q-pPSUmEUbpX-WE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bvsbcF2AXZ4xbcw4a38jHEc2dOmD0pT6fkgtazylSPg&oe=69DE3C63"}, {"file_name": "11162732_379675985777869_7009587657311256576_n.png", "id": "2813264045554837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984476_2813264052221503_6203106677666323288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgcSYRoRuO4Q7kNvwGmtBVp&_nc_oc=AdpTJriWRZnsp1SXLlw4XGXBc5QzBA91xGcpaYjAmrVsApAFHPk3EjrOVqIw9SPm9Pw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qsJAtoMhkPSAW48k8I4wNWsI3V0gnCHjzOSqFvR1eDw&oe=69DE5001"}, {"file_name": "screen5.png", "id": "431571644615495", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031363_431571647948828_6278636924673278426_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tp1Axy3WN3cQ7kNvwGFr6We&_nc_oc=Adqn63HhjeGG3X9Y3AlLe-9UCUXo8bQcl_8iR3bhnmFBY7KQxr2muRRc7QIzTuN9hXg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XRWgOq9DpztEffTozdAL0Z1wghYgSY-jFYq03S4BStQ&oe=69DE3593"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OCU_2560x1440.png", "id": "881202649331645", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974450_881202652664978_4044905578170516514_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tB6M5caFPuEQ7kNvwHAcFh9&_nc_oc=AdoKmLgPJS0QdzO4ARb78j-tTDRNczrk1yEGsjjeYZOuRJIWRFwckhpTHDW--YSv90c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gR8WkFv5THgtVAzYDG9oo574T4tDnOJuG4lW4xldKAA&oe=69DE4E03"}, "display_name": "Bacon Roll", "keywords": [], "long_description": "Help Dot the pig roll away from the evil wolf chef, thus ruining his dinner plans. With the help of his father and his brother, you will guide Dot to his beloved Princess Rune.\n\n\u25cf  Discover crazy worlds\nThroughout the escape Dot will encounter various environments, from forests, snow mountains to sci-fi and even maybe a little trip to other worlds. Who knows. Maybe he's an astronaut pig. Maybe he's a super pig that can fly.\n\n\u25cf  Conquer your skills\nUnlock a variety of power ups to help Dot throughout his escape, as well as discover new outfits for him to wear that give him extra special bonuses when he wears them.\nRoll, Jump, shoot and dodge. That\u2019s the way the pig goes.\n\n\u25cf  Go shopping\nYou can upgrade your power ups in the game using the tomato currency. The more tomatoes you collect while you play, the more you can upgrade your power ups and unlock new outfits for Dot!\n\n\u25cf  Show off your dance moves\nYou have trotters instead of your hands! Isn't that a good enough reason to dance?", "short_description": "Help Dot the pig roll away from the evil wolf chef, thus ruining his dinner plans.\n\nThroughout the escape Dot will encounter various environments, from forests, snow mountains to sci-fi and even maybe a little trip to other worlds. Who knows. Maybe he's an astronaut pig. Maybe he's a super pig that can fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscrip
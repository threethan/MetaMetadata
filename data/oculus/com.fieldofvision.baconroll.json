ZDYZOETg0gokEzT5xQuYSFELMdvWJSeZz8AGS4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ePySz_elMsidVJhTEkh4U9TmHID--2wvuifWQ600gOA&oe=69DF85D0"}, {"file_name": "12410200_1072769176197373_3224455652478812160_n.png", "id": "751803505768309", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974684_751803509101642_4759040815345545759_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvwVtbbMF4sQ7kNvwGwZUNz&_nc_oc=Adpx0YkH0znhSj61-upJWs6skaH4G2XH_d5DOLN1Qs-z3tC4LVNi1_Iu9m3chG5eK_c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14-je9uvRFUTpJ233apVAs6BneMDy1rbGTdMcOSFgHTQ&oe=69DF8DE3"}, {"file_name": "11162732_379675985777869_7009587657311256576_n.png", "id": "2813264045554837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984476_2813264052221503_6203106677666323288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgcSYRoRuO4Q7kNvwHWg34u&_nc_oc=AdpyA43P2bv9xuOc_hCXOelm4rTtkEw6buN6BFHrm7JTtRR4ZRzAft1RNdpfx3vETRs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qDnE7yAVHKVE5i7O_GRKpKcz8wAvxY9vVw3kRCqmMdw&oe=69DFA181"}, {"file_name": "screen5.png", "id": "431571644615495", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031363_431571647948828_6278636924673278426_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tp1Axy3WN3cQ7kNvwGNSRZF&_nc_oc=AdqNV9PTOVMtmIk0zY7D4mWox6LSCLU7yWdCzgsLOqhzYpb13IGI8-1I58SQ2Dp9wu0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wkj6-Qhe6eLloQ0cXdkMHiJEecbXJTKVDN6apd7YDmg&oe=69DF8713"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OCU_2560x1440.png", "id": "881202649331645", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974450_881202652664978_4044905578170516514_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_p9yyh_w5YQ7kNvwH6wO0b&_nc_oc=AdpK1g3gmeKBDDSg80Slf9d-rs9yuuu5sK3Uzyf6emyR6iOOKUcHRGcVF9Z_gjUcMFI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11XgpDqC50YtK9tV673y4xnJMgqhzclJqIIINkL3_4Eg&oe=69DF9F83"}, "display_name": "Bacon Roll", "keywords": [], "long_description": "Help Dot the pig roll away from the evil wolf chef, thus ruining his dinner plans. With the help of his father and his brother, you will guide Dot to his beloved Princess Rune.\n\n\u25cf  Discover crazy worlds\nThroughout the escape Dot will encounter various environments, from forests, snow mountains to sci-fi and even maybe a little trip to other worlds. Who knows. Maybe he's an astronaut pig. Maybe he's a super pig that can fly.\n\n\u25cf  Conquer your skills\nUnlock a variety of power ups to help Dot throughout his escape, as well as discover new outfits for him to wear that give him extra special bonuses when he wears them.\nRoll, Jump, shoot and dodge. That\u2019s the way the pig goes.\n\n\u25cf  Go shopping\nYou can upgrade your power ups in the game using the tomato currency. The more tomatoes you collect while you play, the more you can upgrade your power ups and unlock new outfits for Dot!\n\n\u25cf  Show off your dance moves\nYou have trotters instead of your hands! Isn't that a good enough reason to dance?", "short_description": "Help Dot the pig roll away from the evil wolf chef, thus ruining his dinner plans.\n\nThroughout the escape Dot will encounter various environments, from forests, snow mountains to sci-fi and even maybe a little trip to other worlds. Who knows. Maybe he's an astronaut pig. Maybe he's a super pig that can fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscrip
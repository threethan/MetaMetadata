om/v/t64.5771-25/499310817_1619759216393363_6057215544287388128_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSvQ1G7Z8DoQ7kNvwFXOxU_&_nc_oc=AdoTVoH74ZFRAaKxbHA_ZlmzOsFTr__PnbW9FQmiilBSW_2zJjM_ajDHxFSmweMxDmg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0JrneP_C0pQtgqh2vNT69rkEt-IGqCMJ-xK8qhJMIuQ&oe=6AA816F8"}, {"file_name": "resized-2560x1440 (4).png", "id": "1057107506808875", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312338_1057107510142208_5330062234344279170_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuP1ztqTVvgQ7kNvwH7W4fn&_nc_oc=Adr-1KIdSVwL33bD0uRc43O74XN90Ozr4GIQ6h0aP0QJ213zT4xMQYLeZjfM2UMTCmg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqpKbHVcqPD0deD8aEbx8zdmGv0zZP77qbbxjd6k9E2Q&oe=6AA81389"}, {"file_name": "resized-2560x1440 (5).png", "id": "1108060805070613", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310817_1108060808403946_4176086764825500137_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32JZYhi-EHcQ7kNvwFLzLgL&_nc_oc=AdpnAK2HBfdErD7du7PEQDi_pkOxlixRee63JF1f5Kj_Ja9fWb58fP9bi9gLDWpN8U8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7PKdSlXyeITd17NJIavM3FL3DJ7rWz8maPsES6L5NNw&oe=6AA80CD5"}, {"file_name": "resized-2560x1440 (6).png", "id": "1744167456899706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507818746_1744167460233039_757840722541510115_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6howoTfjrQQ7kNvwEXbw_g&_nc_oc=AdrNoHXpKAcTsrM_I7nMj03Ub_B0smL9rbhsVgy5tC291ISALWIorKldvkO0iDcHXs4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLziaTtsZRktYPM_g8puPNRhQ4hMqKafDEbLgtkNvTaXA&oe=6AA81140"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brick Tag VR", "keywords": ["BrickTag", "BrickTagVR"], "long_description": "\ud83e\udda0 BUILT IN MODS \ud83e\udda0\nExplore the COOLEST mods that are easy to get. Rockets, Fly, No Clip, Speed Hacks, X Ray, Teleport, Laptop, and much more!\n\ud83d\udcf8 FREE CAMERA MOD: MOST ADVANCED CAMERA \ud83d\udcf8\nOur built-in camera mod lets you switch between first-person, third-person, and other exciting perspectives to enhance your gameplay experience.\n\ud83c\udfe0 GAME MODES\ud83c\udfe0\nHave fun and talk with other bricks in our casual mode or show your inner brick and jump into an infection lobby. More game modes soon to come..\n\u2757\ufe0f\u2757\ufe0fBIG UPDATES CONSTANTLY\u2757\ufe0f\u2757\ufe0f\nWe do our best to get out updates every week or every other week to best support our community. We built what the community wants!\n\ud83c\udfc0 SHOOT HOOPS LIKE NEVER BEFORE \ud83c\udfc0\nHit the basketball court for some epic trick shots. Whether you\u2019re a baller or just want hit some jumpers, the court is yours.\n\ud83d\udecd\ufe0f EXPLORE THE MALL AND GET COSMETICS \ud83d\udecd\ufe0f\nVisit our in-game mall and deck out your brick with an array of cosmetics. From funky outfits to stylish accessories, there\u2019s something for everyone.\n\ud83e\udd73 JOIN THE BRICK TAG NOW \ud83e\udd73\nReady to experience life as a brick? Join the Brick Tag now and embark on a tiny, yet massive adventure. Play for free and let the fun begin! Join our Discord to get support or find people to play with: https://discord.gg/ac2Hn6He9x", "short_description": "\ud83e\udda0 BUILT IN MODS \ud83e\udda0\nExplore the COOLEST mods that are easy to get. Rockets, Fly, No Clip, Speed Hacks, X Ray, Teleport, Laptop, and much more!\n\ud83d\udcf8 FREE CAMERA MOD: MOST ADVANCED CAMERA \ud83d\udcf8\nOur built-in camera mod lets you switch between first-person, third-person, and other exciting perspectives to enhance your gameplay experience."}]}, "developer_name": "Brick Games", "developer_privacy_policy_url": "https://docs.google.com/document/d/1uM8Kfi6gqO5YIO6C2GBAqjbkmwiGwA4AyWINRGbbErc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Brick Games", "support_website_url": "https://discord.gg/ac2Hn6He9x", "website_url": "https://docs.google.com/document/d/1BGRB3eaxoRmcgX7NowH3ZInGMJX1cpTZeGRaVzFMhzU/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1078161234716836"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310720_1789445775638295_4685202375850510304_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZiNobWtpf48Q7kNvwFRDwrR&_nc_oc=AdrfWhNYIBnIA_K6cBR6gB5USrVdT579D-Ic3rpIbqL_6EOAjaAwub1asqh8e_8pTqw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFjILkXctY3L8pd3Q-XdVYo3UXOldivOnq3-JjFVk5vA&oe=6AA808ED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Brick Tag VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1787090400, "lastRevision": {"nodes": [{"id": "1078161238050169", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1078161228050170", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform":
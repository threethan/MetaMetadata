reenshots": [{"file_name": "skeletal_1 2.00.01\u202fPM.png", "id": "1631324851301114", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622916_1631324854634447_3130740926953696865_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTQhGpkHO_UQ7kNvwFuLkoS&_nc_oc=AdqznbbaVorsoWkDJ4GmtAJFVWfeNi8ZRKeu3cCfvL4WcMBiMWsRWIWQrmyycBE-MhI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEgLglu182QuwBwWGJ12Q6-6wGfhCAwhN45Monlm5-rw&oe=6ACCF6CB"}, {"file_name": "explorer_4.png", "id": "2474219939747573", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619704_2474219943080906_4777003628783694544_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdSW9szxSgcQ7kNvwHtWct5&_nc_oc=AdrAWOWJC5dxHNnQ3akEuOc5p8CBO2toTqCpOX1qqeEjDOoPUKSRR2t_YLx3C0TxbyQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJfPsm8tJw37tSF-wrAvK3i65OXJXVHZW6V0u1ULLXpw&oe=6ACCF534"}, {"file_name": "sensory_5.png", "id": "27177467735195907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623345_27177467741862573_1901839675591698103_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmymZgtKA9cQ7kNvwFhKePB&_nc_oc=AdoQ1s2EmoGOdXGujWdsNfA5LL_Al_VD4llJyavdSgKsGeEiepluntatc30-yKvOnzQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0J9waGAO3Pg5MlM-PqP-nvaUEPTU8eYcdf6Didf35GA&oe=6ACCF3E3"}, {"file_name": "sensory_3.png", "id": "1007897302245067", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622276_1007897305578400_1675522056179938495_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-njixLrBVMQ7kNvwHNphTg&_nc_oc=AdrWdqiMl1qMpUxd_SYiS3QK9RlluljgFHz32gFgWPCleb2huwQ53jVeVbrnBjJOLQ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7gTrhSUxD7i-wFy8I3BTgLNuQvtrbbkHj73P05xfvpQ&oe=6ACCF8BA"}, {"file_name": "muscular_3.png", "id": "1436371965154460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499305396_1436371968487793_4026721636073237120_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aQzbKEDjLYQ7kNvwHTx_cC&_nc_oc=AdoHOqHePuYO0nla-WAFMU5GewjpLPOhOMhEo7mrop_N1TdeXVcDU9lEgsxyKiQwyg4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQKR0kCAYGbfAbpg8lwM21UFxvkbvg05dfHDyYWSfTKA&oe=6ACD0996"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "all_store_trailer_cover.png", "id": "1391220959730031", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304229_1391220966396697_369500971282944084_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJtsx9CcqH8Q7kNvwFKJR7n&_nc_oc=Adpz4TJQe2ysbjB6ORafPzzarRiLcdNs9cQjhKya5u0gc9nO9TeWZoB5bW6C6exHSZI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3bs0EE1oI9M_FFUKEtkeeym40Wj9fAmis5idfByc-xg&oe=6ACD0DBB"}, "display_name": "Anatomy Learning Labs: Complete Set", "keywords": ["anatomy", "biology", "learning", "science", "body"], "long_description": "Step into the Complete Set of the Anatomy Learning Labs series, where science meets wonder inside the human body in stunning 3D. Featuring anatomically accurate models developed by medical professionals and learning activities designed by professors, the Complete Set brings together the skeletal, muscular, cardiovascular, respiratory, digestive, neural and sensory labs into one package to show how these systems work together to support human life.\n\nThis app leverages the Quest's audio, visual, and hand-tracking capabilities to deliver truly multimodal and active learning experiences. Students learn by seeing anatomy in 3D, hearing explanations, interacting with structures using their own hands, and developing spatial reasoning skills through guided activities. All explanations are available at elementary, middle, and high school difficulty levels.\n\n\u2022  Operate a scanner to reveal how each body system aligns with surrounding anatomy and integrates with the rest of the human body.\n\n\u2022  Select any structure to hear Dr. Hana Sato, your virtual guide, identify it by name and explain its function.\n\n\u2022  Use your own hands to grab and inspect hundreds of anatomical structures across multiple body systems.\n\n\u2022  Step into Mini Mode to explore anatomy from the inside.\n\n\u2022  Assemble anatomical structures in guided 3D puzzles.\n\n\u2022  Test your knowledge through audio-guided quizzes.\n\n\u2022  Try fast-paced Knowledge Knockout challenges that develop anatomical identification skills under time pressure.", "short_description": "Explore the entire human body in VR with the Complete Set of Anatomy Learning Labs. Featuring anatomically accurate models developed by medical professionals and activities designed by professors, this collection includes the skeletal, muscular, cardiovascular, respiratory, digestive, neural, and sensory systems. Scan, explore, grab, assemble, and test your knowledge through immersive multimodal learning experiences available at elementary, middle, and high school difficulty levels.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.einsteinshorizon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Einstein's Horizon", "support_website_url": null, "website_url": "https://www.einsteinshorizon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1209076412289452"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLI
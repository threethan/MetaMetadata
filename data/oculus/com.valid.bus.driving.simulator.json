6A661640"}, {"file_name": "1.png", "id": "674988412247229", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825575_674988415580562_6215892587581197226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyduYeyVhZAQ7kNvwG8Ii4W&_nc_oc=Adpv0W9LrVPQa97wdb10XoKpZ5HBc7GNmVn8rQXqzfQlVqSGIRCq1ZPsOPois4mOuwo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhYYrln_SlYQkLorX6erXDPLKusNtVEz8qLx_mDXU5hg&oe=6A65FB5E"}, {"file_name": "2.png", "id": "1645176599806192", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819854_1645176603139525_130496934571662952_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YggLoSMXi-0Q7kNvwF1yU5s&_nc_oc=Adr55D7Y-tS5s6nsjBQM7-wFWYQi-4rA3Q5dXxgZx6Z8nAJk1lu6FZb08Wa5F04s08o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYxZ-kDqpt3jQldKLSdVH1IMdj6v8rW5ZxEROhAXBQ6g&oe=6A65F162"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BusX VR \u2013 City Bus Driving Simulator", "keywords": ["bus", "coach", "driving", "simulator", "busx"], "long_description": "BusX VR delivers a realistic and immersive city bus driving experience designed specifically for virtual reality.\n\nTake control of detailed buses, drive through active city roads, and stop at designated stations to pick up and drop off passengers. Enjoy smooth controls, comfortable movement, and a relaxing driving atmosphere perfect for both casual players and simulation fans.\n\nWith optimized performance for Meta Quest, BusX VR focuses on immersion, realism, and player comfort\u2014making it an ideal VR driving simulator.\n\nKey Features:\n- Immersive city bus driving in VR\n- Smooth and comfortable controls\n- Realistic road traffic and bus stops\n- Detailed bus interiors\n- Multiple buses to drive\n- Relaxing and simulation-focused gameplay", "short_description": "Step into the driver\u2019s seat in BusX VR and experience realistic city bus driving. Navigate busy roads, stop at stations, follow traffic rules, and enjoy smooth, comfortable gameplay built for Meta Quest. Drive the passengers to their destination with BusX VR games's smooth control. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/valid-games/privacy-policy/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Valid Games", "support_website_url": null, "website_url": "https://sites.google.com/view/valid-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25013175721717228"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1544552057032745"}, {"status": "PUBLISHED", "id": "1950124525703344"}, {"status": "PUBLISHED", "id": "24416353934728554"}, {"status": "PUBLISHED", "id": "1434495418147215"}, {"status": "PUBLISHED", "id": "894012020039229"}, {"status": "PUBLISHED", "id": "828178876756514"}]}, "baseline_offer": {"id": "828178876756514"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "1544552057032745"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25347196518315145", "version": "3.0.1"}, "id": "1387662903051714", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBi
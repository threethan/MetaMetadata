words": [], "long_description": "Boxed is your classic match 3 game taken to the virtual space. You enter in Boxed village and are quickly surrounded by rings of boxed that you must destroy in order to hit your targets and advance. Match 3 of the same color or eliminate massive amounts of boxes with special balls. Boxed will test your puzzle mind and your arm strength. Hop on in and get throwing", "short_description": "Boxed is a family friendly match 3 game. Every wonder what it would be in the full virtual world of your favorite mobile matching games? Enter the Matched Valley and go for your highest score!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://globeotter.com/ppolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Globe Otter", "support_website_url": null, "website_url": "http://globeotter.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "STRATEGY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4678660552246236"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974673_1905369259622055_5882675342186960298_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGrnp4sArNsQ7kNvwHIqDTo&_nc_oc=AdqoPLgcmHxNmW1rCRziDKa4GsxW8XreO-0Igys4T6AOQ68OJnt-t_dDeCjy1ocsOEI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEozT
AfzLvZsIuRnr6nY_QmHrWBoYJHsAVF2B_tJYfYKbYcpq9Q&oe=69C7DC5F"}, {"file_name": "pool 2560X1440.png", "id": "649637413678019", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001719_649637417011352_7716799542559723750_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MffckSQGVBgQ7kNvwGSyzfC&_nc_oc=AdrZDsnMp6RTH0ZFqI7G34mVKRU5LdF2RzwGQEV0I2w94uU8Ps_UrgpSAze919SSiK4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxhAuH11q0eDU5aXSS6IFNewWY3hE5lpP0XfnRCaNOjEQ&oe=69C7C44C"}, {"file_name": "Horror 2560X1440.png", "id": "862523438607465", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974513_862523441940798_5536174085458991433_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIz3EMB4DTUQ7kNvwEGFXwP&_nc_oc=AdoMPMZMKP5o-qd3j1K22rXovdalpJKNsf_h6PhfUPEZnTap9wJhNaChTz8nFZtYY7c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzvhhSVN8NGuh3zUkq15mADf3oBROSaFiMISUuFAduT4g&oe=69C7CC7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cool image of foncre 2560 X 1440.png", "id": "818592230286497", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974494_818592233619830_5672033116955897345_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txlo-EHVDF0Q7kNvwEz0UTm&_nc_oc=Adqu_Tbwr9itFchovsU4HthVplDkxNrbgB3JSPUV7yu59XxVe0eIkOop07T-lr2E1Js&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzamkgneQtBTUBnrCwoxXPG19DqIRFPh9WZeHhJy6j1_Q&oe=69C7D042"}, "display_name": "Foncre", "keywords": [], "long_description": "Foncre is an exciting virtual reality (VR) game that takes the popular and fast-paced gameplay of the original Fonkey runners and adapts it to immersive VR environments. This game offers an entirely new way to experience the thrill of chasing and escaping in a three-dimensional space using the Gorilla Tag locomotion system.", "short_description": "The gameplay in Foncre is centered around a thrilling game of Horror. Players are divided into two teams, typically with one team taking on the role of \"fonke's\" and the other team as \"runners.\" The objective for the horror ai's is to chase down and eliminate the fonke's, while the runners must evade capture by using their speed, agility, and various tactics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fonktag-com2.webnode.page/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "fonkey", "support_website_url": null, "website_url": "https://fonktag-com2.webnode.page/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9926480014147826"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031441_902904801183026_8750887350578880829_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZDv8qC8vgYQ7kNvwEveUYe&_nc_oc=AdqtiH-GlJem5gGHh9boCPGuAb_GYUxfxov5fbamGrzxTRjnymnrKGDMVQS3YznEWjU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8dR0VX6iP8BONtwWmS6tg2BfRtIkZBg18u6hsSStMSA&oe=69C7BAD4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Foncre", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1690926375, "lastRevision": {"nodes": [{"id": "6228872780575253", "release_type": "SCHEDULED", 
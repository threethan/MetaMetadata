Af5hJRsT0QwMq42143g6wK-9xKCylB8WQ0AEU1Z6Wk6u2Q&oe=69FB46DF"}, {"file_name": "pool 2560X1440.png", "id": "649637413678019", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001719_649637417011352_7716799542559723750_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbUXfYyBp_wQ7kNvwEBhATm&_nc_oc=AdrM64QG2RhayoREbL-u1h4wrUXy4xlSUqTrIlx0OuyWK3weT4zDmhY7sIyusP0wE9Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pqmqdX6LdwiYMmqoKIyLwRkTvamGdVvadYU-qIIulcg&oe=69FB2ECC"}, {"file_name": "Horror 2560X1440.png", "id": "862523438607465", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974513_862523441940798_5536174085458991433_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuf2MKezGkoQ7kNvwH4Sfhv&_nc_oc=Adp-4ObJUvEfJmJ1UCTz_AeKBp4qeAi4xa8LTFqiFONxFBVhTQHEGfKc04lH_FE0R0k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pFWZ-9dk7qkfAg1as7kKaIU8EadxSC_Z6PT7XNo6O7w&oe=69FB36FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cool image of foncre 2560 X 1440.png", "id": "818592230286497", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974494_818592233619830_5672033116955897345_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8D7TLvIXdoQ7kNvwHqwhaB&_nc_oc=Adp2wUv-PZz213BFDg4uMQS97GMsImTZadTN8xfimj066g-hPYLmgchOoTsg-JI8rm4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZU-w5FecsHEOVxRJA0rMDNYftux3NNz-Set6zKAXovw&oe=69FB3AC2"}, "display_name": "Foncre", "keywords": [], "long_description": "Foncre is an exciting virtual reality (VR) game that takes the popular and fast-paced gameplay of the original Fonkey runners and adapts it to immersive VR environments. This game offers an entirely new way to experience the thrill of chasing and escaping in a three-dimensional space using the Gorilla Tag locomotion system.", "short_description": "The gameplay in Foncre is centered around a thrilling game of Horror. Players are divided into two teams, typically with one team taking on the role of \"fonke's\" and the other team as \"runners.\" The objective for the horror ai's is to chase down and eliminate the fonke's, while the runners must evade capture by using their speed, agility, and various tactics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fonktag-com2.webnode.page/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "fonkey", "support_website_url": null, "website_url": "https://fonktag-com2.webnode.page/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9926480014147826"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031441_902904801183026_8750887350578880829_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTtvnZxlMC8Q7kNvwEWa95k&_nc_oc=Adq6jAUxcevH-AeTaACjH4NaMOnoItGQxiI8GO2Uw5BFKhmygDILnTROsdg1P-w6kaE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ir_3Wxt3vlxfHJyYFDxjb7NiCwHKb8qu3Hepdhg8n7w&oe=69FB5D94"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Foncre", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1690926375, "lastRevision": {"nodes": [{"id": "6228872780575253", "release_type": "SCHEDULED", 
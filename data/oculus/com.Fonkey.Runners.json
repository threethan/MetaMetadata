Af7MKZ_UKklRHouwdKZlExaAPR2xhTv43pFXEqaECQr6fg&oe=6A008CDF"}, {"file_name": "pool 2560X1440.png", "id": "649637413678019", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001719_649637417011352_7716799542559723750_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKoyh9WqfWIQ7kNvwGQSXUZ&_nc_oc=AdrxCHfJ4L8Inbsm36hDDJcu6Y_l4WJyzGJPx5HUa1uRqOXDJ5RsLJWfGRvOY_tKQpo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6O3MB8_vKRP4HaQHE9acx2rEG_Ct6KGVmXlygwpHOQ6g&oe=6A0074CC"}, {"file_name": "Horror 2560X1440.png", "id": "862523438607465", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974513_862523441940798_5536174085458991433_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGKuDDOkfXsQ7kNvwEpgRgb&_nc_oc=AdoVG3PoYiHGBGbyLJmwCOLy1zteGkeNwSbHVQAV85t22ATXoyJI2xMD3FylJ8ebmCs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wvcmA-oZdYY687gKv631tQoptrpy7-8uMGakIjE802g&oe=6A007CFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cool image of foncre 2560 X 1440.png", "id": "818592230286497", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974494_818592233619830_5672033116955897345_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFe2J6SPQd0Q7kNvwHHsWka&_nc_oc=AdpOoxNnk4fqCt1z1qSdY9l4m8PULhG0lv9ce_CGJDyttSXFloAXbhXDNMzGZqaXWpE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HpjclVFWDNhg4At53UqUakDZs-Ap2_paBCyqFBtAScw&oe=6A0080C2"}, "display_name": "Foncre", "keywords": [], "long_description": "Foncre is an exciting virtual reality (VR) game that takes the popular and fast-paced gameplay of the original Fonkey runners and adapts it to immersive VR environments. This game offers an entirely new way to experience the thrill of chasing and escaping in a three-dimensional space using the Gorilla Tag locomotion system.", "short_description": "The gameplay in Foncre is centered around a thrilling game of Horror. Players are divided into two teams, typically with one team taking on the role of \"fonke's\" and the other team as \"runners.\" The objective for the horror ai's is to chase down and eliminate the fonke's, while the runners must evade capture by using their speed, agility, and various tactics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fonktag-com2.webnode.page/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "fonkey", "support_website_url": null, "website_url": "https://fonktag-com2.webnode.page/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9926480014147826"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031441_902904801183026_8750887350578880829_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4Z90qOC6EUQ7kNvwHY_y-V&_nc_oc=AdoFecLThSt3COLAkmJgytf55kW5asJ7n44Dr7SsA30-49V4J6-V3ibNFSOL04r74ko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_f-Yz1RWSwoptNr0chPLXYVVogbA6knietIfQblzyhw&oe=6A00A394"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Foncre", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1690926375, "lastRevision": {"nodes": [{"id": "6228872780575253", "release_type": "SCHEDULED", 
AQBltINJJoTQR5MrIzFZH3PjDbemH29XC4FEVRdEszBk4g&oe=6A66105F"}, {"file_name": "pool 2560X1440.png", "id": "649637413678019", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001719_649637417011352_7716799542559723750_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3rEYnbqvYEQ7kNvwEPd5xI&_nc_oc=AdoXDIcXoHKN_6RJkLZpDDRq79_QJ7keVFnoou3qIKgcUrEAmDLGxQ9PzdoH2OfmPiA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLmS_i1Zcb-SPI1cMY6VcnFKBYdSKml64twoFKqf5H5g&oe=6A65F84C"}, {"file_name": "Horror 2560X1440.png", "id": "862523438607465", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974513_862523441940798_5536174085458991433_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5TrC4i81bsQ7kNvwGtlFjN&_nc_oc=AdrkQxLVxeixTN0XxriEvbj1LSHfRjBVNszEq-COWqbo4mxciq68PUHWfcB9GWijkP0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2w49W2l9wM0g0roQjbNEJ-InuXPwiX-JiE9a6P7WkeQ&oe=6A66007E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cool image of foncre 2560 X 1440.png", "id": "818592230286497", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974494_818592233619830_5672033116955897345_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHtH2reKRowQ7kNvwED6dQ8&_nc_oc=AdrSa7Qiu2ZzibCYuVpDUfLDNtdG5lsiJhu_y5SKT0D0P2mcWnxGvOIN3GXbr04loXM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSgYGXslekSlObuNb_s1aJ2jQXkjCOtiUenPolWCvI6A&oe=6A660442"}, "display_name": "Foncre", "keywords": [], "long_description": "Foncre is an exciting virtual reality (VR) game that takes the popular and fast-paced gameplay of the original Fonkey runners and adapts it to immersive VR environments. This game offers an entirely new way to experience the thrill of chasing and escaping in a three-dimensional space using the Gorilla Tag locomotion system.", "short_description": "The gameplay in Foncre is centered around a thrilling game of Horror. Players are divided into two teams, typically with one team taking on the role of \"fonke's\" and the other team as \"runners.\" The objective for the horror ai's is to chase down and eliminate the fonke's, while the runners must evade capture by using their speed, agility, and various tactics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fonktag-com2.webnode.page/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "fonkey", "support_website_url": null, "website_url": "https://fonktag-com2.webnode.page/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9926480014147826"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031441_902904801183026_8750887350578880829_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-tgyMu898k4Q7kNvwERyUkA&_nc_oc=Adrp-7R4V0dBXYFGalnPQJCrY_o7XC9doaAPf1Yx79jLeMbHEWfqeMl_47hdu7e9ziA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeT7KCeV15m8tx-VsQqGL9ZzGBRa5A5hEYE5VSWjrJAA&oe=6A662714"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Foncre", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1690926375, "lastRevision": {"nodes": [{"id": "6228872780575253", "release_type": "SCHEDULED", 
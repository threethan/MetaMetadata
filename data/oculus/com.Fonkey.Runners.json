m/v/t64.5771-25/491823812_27922684660701135_4273500550099674973_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wz3PR33dsWoQ7kNvwH4mrBP&_nc_oc=AdpXvlJK69B18W_Md66UgcXtjdxciurEhsH8d8FAZizXu4twie6b6x8x6PMSYgXtW5g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYfnPSrYlGwgX38xZSNj7cVGxwjzcnHXQ0zQ-UEdeSBQ&oe=6ACF8E2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cool image of foncre 2560 X 1440.png", "id": "818592230286497", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974494_818592233619830_5672033116955897345_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCVIPXyGX1wQ7kNvwHBcTMG&_nc_oc=AdoZmJz43C4yR5CrcJEz0hFYEQySFhXWFB03mJftAS4idM1Bh7Dtbechr8Li8IQ76kU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4laa_axE1yZz_jVBqGW0lk1WyNvanmUPhn0ZrLIdx_A&oe=6ACFB482"}, "display_name": "Fang", "keywords": ["Horror", "Backrooms", "Gorilla"], "long_description": "You were not supposed to be here, but yet here you are. \n\nAs you wander, something catches you. You are NOT alone. The emptiness, the silence. Something is deeply wrong. There seems to be yellow carpet repeating on the walls, it looks like it is repeating infinitely.\n\nIntroducing FANG, a gorilla tag locomotion style game that has the style of the backrooms. \n\n\ud83d\udc41 ENTITIES are always watching. Learn what they do, or find out the hard way.\n\n\ud83e\udd1d PLAY with friends, learn how to beat puzzles and levels. Trust each other, or don't.\n\n\ud83d\udd26 SEARCH for secret cosmetics, secret rooms and most importantly SUPPLIES. \n\n\ud83c\udfc3 STAY ON THE MOVE, Entities can be around every corner, Use your arms to create as much distance as possible.\n\n\ud83c\udfc6 EARN achievements, unlock secret achievements. Earn currency for doing specific tasks.\n\nThis game is not affiliated with another axiom or the official gorilla tag franchise in any way. This is simply fan made. \n\nNot all levels are from the backrooms some are originaly made.\n\nThere are jumpscares in the game, good luck on your adventure. You will need it.", "short_description": "You arrive in an unfamiliar world, you cannot remember what had happened. The only thing you can remember is you arriving here. Your objective is simple, find out where you are and how to escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fonktag-com2.webnode.page/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fang Team", "support_website_url": null, "website_url": "https://fonktag-com2.webnode.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27419865947715962"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824307_860891649717361_7620207413876591852_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBNrDiY3HzkQ7kNvwGQFoUk&_nc_oc=AdqT84sR2XtEXdXRYIpUsu74_GVIrg0w-l5luPCwfifUAyyHfeZO92DbSfcjVSi9Ie4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-4QDsCyDckXbDVEo9KiEON9yPjcKg3vySo5yBxZqJPQ&oe=6ACF864A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fang", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_
n.com/v/t64.5771-25/491823812_27922684660701135_4273500550099674973_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSIBwh4qNEMQ7kNvwFcGvgX&_nc_oc=AdrbZeSbjCJKXdQATHm_MIpmXMWKKynUM2r83bhsSX_9MGkGX15NCq6_D-o9-e3XGmw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKLy1rpSuwUtubVO7HXz81t0DxTt9lxNXM08TfFPc3xw&oe=6AA40CAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cool image of foncre 2560 X 1440.png", "id": "818592230286497", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974494_818592233619830_5672033116955897345_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2cRT4EYqbYQ7kNvwEqaN4p&_nc_oc=AdoYKEiQ8WI3-YErfyMXOmLK6I00XgOQYzC3aydfGv-XG-X2qCBC4d3lSFM3YIV5jsQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyZra4sr3RIuSfkJZWK6wn8aNQLlb2NMs1KpaX-jyamQ&oe=6AA3FAC2"}, "display_name": "Fang", "keywords": ["Horror", "Backrooms", "Gorilla"], "long_description": "You were not supposed to be here, but yet here you are. \n\nAs you wander, something catches you. You are NOT alone. The emptiness, the silence. Something is deeply wrong. There seems to be yellow carpet repeating on the walls, it looks like it is repeating infinitely.\n\nIntroducing FANG, a gorilla tag locomotion style game that has the style of the backrooms. \n\n\ud83d\udc41 ENTITIES are always watching. Learn what they do, or find out the hard way.\n\n\ud83e\udd1d PLAY with friends, learn how to beat puzzles and levels. Trust each other, or don't.\n\n\ud83d\udd26 SEARCH for secret cosmetics, secret rooms and most importantly SUPPLIES. \n\n\ud83c\udfc3 STAY ON THE MOVE, Entities can be around every corner, Use your arms to create as much distance as possible.\n\n\ud83c\udfc6 EARN achievements, unlock secret achievements. Earn currency for doing specific tasks.\n\nThis game is not affiliated with another axiom or the official gorilla tag franchise in any way. This is simply fan made. \n\nNot all levels are from the backrooms some are originaly made.\n\nThere are jumpscares in the game, good luck on your adventure. You will need it.", "short_description": "You arrive in an unfamiliar world, you cannot remember what had happened. The only thing you can remember is you arriving here. Your objective is simple, find out where you are and how to escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fonktag-com2.webnode.page/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fang Team", "support_website_url": null, "website_url": "https://fonktag-com2.webnode.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27419865947715962"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491824307_860891649717361_7620207413876591852_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybu_x21OTH4Q7kNvwEmRGeZ&_nc_oc=Adq9OiaFDM8aJwRnvZ5ZVqWGShYnoNHhNmrH_ernCgwPSueav9G3XBfZCTrFFKNjzz8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYpluTS77OMvJWoh5WXu_J3j05E-rtYem-TMDt-ZuSnA&oe=6AA404CA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fang", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"
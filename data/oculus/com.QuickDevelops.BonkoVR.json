6-1.oculuscdn.com&oh=00_Afu4qcJ7IUbtkmXgew_y4_EZmI6iTOxkJJMIrKtPBXMDNg&oe=69986730"}, {"file_name": "New Project (64).png", "id": "604390572711315", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298481_604390576044648_6098245063900181369_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9E9fKb0enkcQ7kNvwFyfNpm&_nc_oc=AdlJMd3eVLmg-97GYUOlI9PnCR9hm49_rkS4mm_f5kcrklXPfJEq9DaGYYCXR22nXSo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afv24yiBbIKA_Aa4EwOwtYOQcAQnqGGlhPIseSwuBQeZqQ&oe=6998709A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bonko", "keywords": [], "long_description": "Bonko VR is your ultimate playground for chaos, competition, and pure fun with friends.\nJump into a wild VR world packed with unpredictable PvP action, hilarious mini-games, and social spaces designed for goofing around or just hanging out. Whether you're launching into ridiculous battles, pulling off absurd stunts, or vibing in a chill environment, Bonko VR keeps the energy high and the laughs coming.\n\nFight, prank, explore, or relax it\u2019s your world, your rules.\nBonko VR blends over-the-top multiplayer madness with laid-back social experiences, all crafted for immersive virtual reality.\n\nSo grab your friends, pick your chaos, and get ready to get bonked.", "short_description": "Bonko VR: Dive into a wild, unpredictable world of chaos, comedy, and multiplayer mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bonkovr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Quick", "support_website_url": null, "website_url": "https://sites.google.com/view/bonkovr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_a
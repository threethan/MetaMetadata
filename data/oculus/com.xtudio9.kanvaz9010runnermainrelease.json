7469933095632_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jmcXPl_CvsQ7kNvwEzl9FD&_nc_oc=Ado-3GtL7IzfKcCrUF_DgBDNjvRoBoEYKGM6USdcrOj8q8kagiEKCq5a2Aqs_U8YtOc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Q9KQ5cxQ1Pj31Y8EDvdg00gTI6z119kEyNtCHlCac3w&oe=6A37E6B6"}, {"file_name": "SS.png", "id": "1564555551265286", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618499_1564555554598619_996377670969374711_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aod1n7iTpoEQ7kNvwE33TW-&_nc_oc=AdoLPkQ0YOCry1-ezQgaafH_4L3wEqmDnf5X5OhoP_SAYFP0VmFsVtlmu2WW7rq1vLA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ggo7EmackN-oseqjGA1kbx7j0fSp3kt5k7CjVskanqA&oe=6A37FD1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "499618274_848673230979001_6786566363694092658_n.png", "id": "1387756049700577", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617850_1387756053033910_7098971701916133364_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZx8OcIsJ1QQ7kNvwEICdci&_nc_oc=AdopGu5xaNhdgKoVTTvNHd-3bkQb98C57VMwOgADwHEjgoF_ZOzZa0uDm5HLmm-UZNA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tXcOpDPyeBjW9WJrlRTrIxA7QpIYefQEs1ZmJM5I0-w&oe=6A37DFAE"}, "display_name": "Impaso", "keywords": ["art", "drawing", "artist", "painting", "canvas"], "long_description": "Paint Anything. Get roasted.\n\n\nIn this VR Painting App, the world reacts to your art. NPCs analyze your paintings, leave comments, roast your work, and sometimes even offer to buy it.\n\nThis isn\u2019t just a painting tool \u2014 it\u2019s a creative sandbox with drama.\n\nPaint ugly art. \nGet reactions. \nEarn money. \nDiscover weird art styles. \nBuild your own gallery.\n\nMade for casual players. No painting skills needed \u2014 just paint anything and see if it sells.\n\nKey features:\n\n- 4 painting modes: E-Ink, Acrylic, Oil and Watercolor\n- Realistic Oil Simulation\n- 12 unique  art spaces to explore\n- 12 quirky NPCs with different art preferences\n- Story Mode: 4 story act with 8 unlockable scenes\n- Sandbox Mode for stress-free creativity\n- Paint-by-number sets\n- Commission-based Work", "short_description": "A VR painting game where the world reacts to your art. Paint anything, get feedback, earn money, build your gallery and discover weird art styles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://notasquare.notion.site/Privacy-Policy-2a1d2dcc8f95800aa256c4134e69da69", "developer_terms_of_service_url": null, "publisher_name": "V.A.Q", "support_website_url": null, "website_url": "https://notasquare.notion.site/Impaso-Official-Wiki-26ad2dcc8f95802788e6d7b6a513f4f7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26569719592632481"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618297_959013069986063_8533394052176988718_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JHamY24becQ7kNvwFu0ZQX&_nc_oc=AdqP2Jbx1RXokOunl48eOlsQ6YJCoLQF9sCpRYuPLqt3lR7_4UW-kb8uqCBG7mXExcA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LnWQCS4_aySb_jv8Dh7pP73OPayz_De4iY94wqpGbBA&oe=6A380E44"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Impaso", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "
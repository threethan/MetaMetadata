1-7&_nc_sid=6e7a0a&_nc_ohc=0U8-_gv7J8gQ7kNvwEXKsXs&_nc_oc=AdphTVy7x930EfFOm5tg7_warlse54TdHOAjlWLy98rqlRwa748WyMPxe2Mtj4iUPMk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwBbf5z9pjiGHjep5Z_w0_6tJgXw1UsP24r-Eiz4habg&oe=6A6207E9"}, {"file_name": "Screenshot-0.png", "id": "1284266250332661", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619680_1284266253665994_4338110377150172976_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LtVKkGtXLJIQ7kNvwGTjlGv&_nc_oc=AdoHkoA_Of88ZxCWqbPTa3qvnUVsP98vBLyYRVu4FVs-oKDhykotfzj83nDv2o7QZkQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCb49ovBwy8LxpJvqo9O_WlxEiTQPw-gwaPa7uWR-Ng2w&oe=6A6221F7"}, {"file_name": "SS.png", "id": "1564555551265286", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618499_1564555554598619_996377670969374711_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHtCzQ_mmVsQ7kNvwEuEWa-&_nc_oc=AdpcNVld4WmTeQjFVXJzerVMjcKLfMMLCk3xS3_atXb1tZzu-dNkcThanDtn7z8uQic&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqmezxti9C_FKV3zfxJfXGjSJUs1jf7L4VIGIevsKQaA&oe=6A622D1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "499618274_848673230979001_6786566363694092658_n.png", "id": "1387756049700577", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617850_1387756053033910_7098971701916133364_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6ETTQP1cSwQ7kNvwE_x5cm&_nc_oc=Adom3i9fP3nskFiQWbVGvuOS4ImFFpDmiLR_k7Omx_Q_VOI2q-8Xw-c1lqDRQon7Eo4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNQSPelCYazaf71qtuuDBTs8yAMSJYGIbq4lQqFP0OfQ&oe=6A620FAE"}, "display_name": "Impaso", "keywords": ["art", "drawing", "artist", "painting", "canvas"], "long_description": "Impaso is a sandbox Starving Artist Simulator VR Game, where you live the life of an artist\u2014paint, sell, build relationships, take commissions, and manifest your dream gallery.\n\nBeyond its realistic VR painting simulation, Impaso lets players experience the emotional journey of a struggling clockwerk artist\u2014from mockery, self-doubt, and depression to the comfort of wine and the joy of painting.\n\n\nWhat can you do in Impaso World?\n\nMake Art\n{2022076469188783}\n\nSell your Art to customers\n{26243793908547642}\n\nGet feedback/criticism by NPC\n{1479576583745257}\n\nPaint the environment\n{1571865967443852}\n\n12 environment to unlocks\n{733405433040741}\n\nCollect famous artworks\n{1900600790582959}\n\nLive your life as an Artist, from selling art in the Alley..\n{1955549118729505}\n\n.. to build your own dream gallery\n{1473366810839022}\n\nAnd.. more..\n- 4 painting modes: E-Ink, Acrylic, Oil and Watercolors\n- Realistic Oil Simulation\n- 12 funny NPC with different art preferences\n- Story Mode: 4 story act, with 2 different endings\n- Sandbox Mode: creative freedom, without financial stress \n- Paint-by-number sets\n- Commission Work\n\n\n\n\n\n{965459676127306}\n\n", "short_description": "Impaso is a sandbox Starving Artist Simulator VR Game, where you live the life of an artist - paint, sell, build relationships, take commissions, and manifest your dream gallery."}]}, "developer_name": "V.A.Q", "developer_privacy_policy_url": "https://notasquare.notion.site/Privacy-Policy-2a1d2dcc8f95800aa256c4134e69da69", "developer_terms_of_service_url": null, "publisher_name": "V.A.Q", "support_website_url": null, "website_url": "https://notasquare.notion.site/Impaso-Official-Wiki-26ad2dcc8f95802788e6d7b6a513f4f7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_i
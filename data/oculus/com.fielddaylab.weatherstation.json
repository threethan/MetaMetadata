&oe=69AD6F36"}, {"file_name": "WS_01.png", "id": "1978044952615166", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630199_1978044955948499_2334364805971795312_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ywtb2XeWZwQ7kNvwGhfOml&_nc_oc=AdkNX-HsLBXQazMsj8FARhKTEL7mjRtlOccXaM7p-f0-Uvtf5B3Ns76IXX_XzFoxne4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDgwaaja9SIXY74kS6VjQsoiavo6rfVOEdoUJA72ecaA&oe=69AD6F5F"}, {"file_name": "WS_05.png", "id": "498632252494609", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031319_498632255827942_6794795689564714062_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_O3qym-R_cQ7kNvwG-80fO&_nc_oc=AdnXm31WxdPXjG1dhe8MSYWahs5jxl5J_COn5mtD0e_Y811vkZgNDzIBks4A7kyCPTY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyyvlIX3FdZZ-5maqJAzDE_h5SB8k51XDI6hzWz7VtBmw&oe=69AD7FEB"}, {"file_name": "WS_07.png", "id": "424783607086418", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035448_424783610419751_2894153629193448176_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bDmmPhbtq0Q7kNvwHDtH_F&_nc_oc=AdnjvAIW6WZ5-szbMXeqA0pHccluwx-b2G1JejZ26Vdcna4Pz4auEAOsemyw_Z4XRpQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSPv0TCl4IKbRyBuuuSBDPbi-04VCxfZb6kbnG_kIQ5A&oe=69AD7417"}, {"file_name": "WS_03.png", "id": "976582357120521", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974771_976582360453854_2656227771931204459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnBzD6a8va0Q7kNvwF2XOEY&_nc_oc=Adnpt6Q740KNBw34QwwvmR-hOC37qxJGX1To6ak70Jhc-PviURz24jDabay3nTNavJ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEUeLWOUpKcT7BaZK2NGTKb8r45Ge4yuK3MGFU_dO4nA&oe=69AD82F2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On The Ice:  Weather Station", "keywords": [], "long_description": "On the Ice: Weather Station transports you to remote locations in Antarctica, where you are tasked with repairing a collection of weather stations. At each station, you\u2019ll identify the components that are in disrepair, fix them in your mobile repair workshop, and then reinstall them. You\u2019ll need to work quickly, though, to avoid getting stuck in a dangerous windstorm or left behind by your pilot. If you succeed, you\u2019ll help restore a network of weather stations that are linked via satellites and used by researchers to understand and predict weather and climate patterns in Antarctica. ", "short_description": "Battle extreme weather conditions in Antarctica while repairing a network of broken weather stations. This VR experience is based on the real world adventures of polar researchers who build and maintain weather stations in Antarctica in order to collect valuable meteorological data. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtualenvironments.discovery.wisc.edu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Field Day Lab", "support_website_url": null, "website_url": "https://fielddaylab.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9679186578779869"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462958_1535889357003586_3107226156014301884_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4B
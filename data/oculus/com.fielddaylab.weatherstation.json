scdn.com&_nc_ss=8&oh=00_AfwbeEXxmTJT5nQjyRLYKSf8SkhhqGVsSg02S8sR0BIP5A&oe=69B95197"}, {"file_name": "WS_03.png", "id": "976582357120521", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974771_976582360453854_2656227771931204459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqEtaFN-OwEQ7kNvwHaimL2&_nc_oc=Adm2mCFVV1hkRDcVygCiNlnjBPsez0insswjSGz6M44O7UG3aT6XQKQnUkTUMW6F2tM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwYNABDuzsfUP_GefrdQ8OQDwuq2gk_vWuYsvZtoxmghg&oe=69B96072"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On The Ice:  Weather Station", "keywords": [], "long_description": "On the Ice: Weather Station transports you to remote locations in Antarctica, where you are tasked with repairing a collection of weather stations. At each station, you\u2019ll identify the components that are in disrepair, fix them in your mobile repair workshop, and then reinstall them. You\u2019ll need to work quickly, though, to avoid getting stuck in a dangerous windstorm or left behind by your pilot. If you succeed, you\u2019ll help restore a network of weather stations that are linked via satellites and used by researchers to understand and predict weather and climate patterns in Antarctica. ", "short_description": "Battle extreme weather conditions in Antarctica while repairing a network of broken weather stations. This VR experience is based on the real world adventures of polar researchers who build and maintain weather stations in Antarctica in order to collect valuable meteorological data. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtualenvironments.discovery.wisc.edu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Field Day Lab", "support_website_url": null, "website_url": "https://fielddaylab.org/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "cont
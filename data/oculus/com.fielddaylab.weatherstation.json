qXuvEFXCTSTv7VO4j04p0yKW6cU6GyfgRiS61XMU8PCL4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5xD7uNe9KG57WaEtFLql3Sydu04924iSSsKrTAe3SXA&oe=6A75D336"}, {"file_name": "WS_01.png", "id": "1978044952615166", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75630199_1978044955948499_2334364805971795312_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKQuOuqapuEQ7kNvwEMHagz&_nc_oc=AdooI7tUe0oBL6f6uvdLYxCYQH1QRzSHzpOPjWjyreEQET82_eYG_NuDIm9I77AeQ9w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHmHispbDzsWfzYsu924drYnDfVDLwNZVAjVhsDGJ0WA&oe=6A75D35F"}, {"file_name": "WS_05.png", "id": "498632252494609", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031319_498632255827942_6794795689564714062_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDRoV2f48D8Q7kNvwENF-0n&_nc_oc=Ado5nQCIg46WQyoeh66xBy0JFaruD-8S1Yh2yJHJrJoprCz-YFbp-3l6s9PP4wPK2c8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIMuX1xKUeO7UIjeNZoCGtoYDEuKeyPkH-RGJSNEUMDA&oe=6A75E3EB"}, {"file_name": "WS_07.png", "id": "424783607086418", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035448_424783610419751_2894153629193448176_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MIkAda4EOsQ7kNvwHDFlZF&_nc_oc=AdqbzlHk3h8hOmXEbjEm-oIVtrrHi_0T791jpXbbYIXlZg72eG_9FARe_rsRXGGN_Pk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFh6ecTK-oaU1_y8c_J7tMHzXgRpjsuKdEjboJekwd5Vw&oe=6A75D817"}, {"file_name": "WS_03.png", "id": "976582357120521", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974771_976582360453854_2656227771931204459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsgEfhzN89oQ7kNvwFt-zKf&_nc_oc=AdrdP5oq2_E6Ezr9mDZu37RVrWgq_4WTrMVOksxwsJZn1KlBinJS-WYSgvJOZqUYKNE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUa3qNvcyY1nSueeFrUKkSYjk0z1JSBVzMlfPxr0YFaA&oe=6A75E6F2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On The Ice:  Weather Station", "keywords": [], "long_description": "On the Ice: Weather Station transports you to remote locations in Antarctica, where you are tasked with repairing a collection of weather stations. At each station, you\u2019ll identify the components that are in disrepair, fix them in your mobile repair workshop, and then reinstall them. You\u2019ll need to work quickly, though, to avoid getting stuck in a dangerous windstorm or left behind by your pilot. If you succeed, you\u2019ll help restore a network of weather stations that are linked via satellites and used by researchers to understand and predict weather and climate patterns in Antarctica. ", "short_description": "Battle extreme weather conditions in Antarctica while repairing a network of broken weather stations. This VR experience is based on the real world adventures of polar researchers who build and maintain weather stations in Antarctica in order to collect valuable meteorological data. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtualenvironments.discovery.wisc.edu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Field Day Lab", "support_website_url": null, "website_url": "https://fielddaylab.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9679186578779869"}, "review_messages": []}]}, "cover_square_image": {"uri"
ygi56f8qJU7FDoTfZDPMN_9Fuj5xVCJiin8xgpZH90ZWA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgzHFA2plI4LKgXlgcjaofrwIY84PyIoWaH7QVjqI1eg&oe=6A7B1936"}, {"file_name": "WS_01.png", "id": "1978044952615166", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75630199_1978044955948499_2334364805971795312_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBrb8KyfgCkQ7kNvwHcmZLg&_nc_oc=Adp78FCBLaEc6sG8kGrKQeXHE5XiHU1zkxJtGlEKDGITk-Z6_gy4VyG8dDA00ma96go&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwwnvzmvxVeMsn1dYGIQ1zps-DseQsxO4fEyjeREQWUg&oe=6A7B195F"}, {"file_name": "WS_05.png", "id": "498632252494609", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031319_498632255827942_6794795689564714062_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cC4uM8iwPqgQ7kNvwH5XK0T&_nc_oc=AdpYicVWzIF8xjyc9kBKXiguTmcd_kfgpzw3tvIe3YOnWQZiuC5MZCnLepKbmood3_w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEETAvIXYPIL5W9kGus7SpJKF7E0OeSRaQw4kXuKVqmJw&oe=6A7B29EB"}, {"file_name": "WS_07.png", "id": "424783607086418", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035448_424783610419751_2894153629193448176_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-v3b9w4jIcQ7kNvwGizDO9&_nc_oc=Adr4dKZD2r_iswLY0z6YQuTir3pJqL37HLdF6Q2lyCfugbq94WQ_1AEvwgh9XzhKD-c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfpa94Y5IF72Uj69OiPvSg2YLr1jIqPHaGwR6tbM2hBg&oe=6A7B1E17"}, {"file_name": "WS_03.png", "id": "976582357120521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974771_976582360453854_2656227771931204459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMxaDvbN194Q7kNvwG2aY32&_nc_oc=Adr1Efomr_bZoLltn1t2npTff4SAYppl2cc8yN6yDnsI_N7imoCjb8MJlTej8F8K2Ew&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6vmQJNpkqfFFRGGdDTpTyUtHWEzrUbSvXtL3EDOT3Aw&oe=6A7B2CF2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On The Ice:  Weather Station", "keywords": [], "long_description": "On the Ice: Weather Station transports you to remote locations in Antarctica, where you are tasked with repairing a collection of weather stations. At each station, you\u2019ll identify the components that are in disrepair, fix them in your mobile repair workshop, and then reinstall them. You\u2019ll need to work quickly, though, to avoid getting stuck in a dangerous windstorm or left behind by your pilot. If you succeed, you\u2019ll help restore a network of weather stations that are linked via satellites and used by researchers to understand and predict weather and climate patterns in Antarctica. ", "short_description": "Battle extreme weather conditions in Antarctica while repairing a network of broken weather stations. This VR experience is based on the real world adventures of polar researchers who build and maintain weather stations in Antarctica in order to collect valuable meteorological data. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtualenvironments.discovery.wisc.edu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Field Day Lab", "support_website_url": null, "website_url": "https://fielddaylab.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9679186578779869"}, "review_messages": []}]}, "cover_square_image": {"uri"
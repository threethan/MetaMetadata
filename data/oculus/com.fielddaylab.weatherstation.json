0N4w7UzIiNp1g8YLbp2-aQYNAt0ZUVILojaNJI5fhnYqc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3mfeBDtlXUNMgBN88VLuvttC8TIdGNK7Ldke60lEG6g&oe=6A830236"}, {"file_name": "WS_01.png", "id": "1978044952615166", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630199_1978044955948499_2334364805971795312_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOmDAxNXls0Q7kNvwHORcJx&_nc_oc=Adpq5cZGHoeGVep6SGmduMyNn8c0zNHtHG6qATfZdF09Ud6fQKwkA3yLBfSa1eTJl6w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBB1SIFBgH9QFeoemfmvKXsdZho-xcUNuxncSxnw_C1A&oe=6A83025F"}, {"file_name": "WS_05.png", "id": "498632252494609", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031319_498632255827942_6794795689564714062_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3VcCaS-h3MQ7kNvwFOYYeC&_nc_oc=AdrVe4glYdb2wsOY1DJfxiB0D-uxmM28mCJ80__Nykk6Q0ZlOqAXoCRqO6k6CuwBY54&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvb6_rB7eauDrl5HQWFokxnr1G2DDMImz0E77eghflNg&oe=6A8312EB"}, {"file_name": "WS_07.png", "id": "424783607086418", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035448_424783610419751_2894153629193448176_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUwR_Xrmu0gQ7kNvwEE2MI3&_nc_oc=AdoD-5mESDEMbT_xN3gdBU0lZW5RHSc2V5UtoSMbV8k2ctB8QL-bJoaE_-SB7fnqdaY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_HVeun42XRnb_B5mpqCrdjzO2NJSe_TMUG4iUkDMUEw&oe=6A830717"}, {"file_name": "WS_03.png", "id": "976582357120521", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974771_976582360453854_2656227771931204459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8l2fnbd5vMgQ7kNvwGBXLQr&_nc_oc=Adq2Jq-jG95FZ1IOB_rcFvpDEZz6RPPuxYKYR7SH8XODF_spfof89jcDGwvt9ShxInk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeWHs0_EHyk2jftF_yzJFsH_WJDzSxr_7SAeUN3CTHqw&oe=6A8315F2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On The Ice:  Weather Station", "keywords": [], "long_description": "On the Ice: Weather Station transports you to remote locations in Antarctica, where you are tasked with repairing a collection of weather stations. At each station, you\u2019ll identify the components that are in disrepair, fix them in your mobile repair workshop, and then reinstall them. You\u2019ll need to work quickly, though, to avoid getting stuck in a dangerous windstorm or left behind by your pilot. If you succeed, you\u2019ll help restore a network of weather stations that are linked via satellites and used by researchers to understand and predict weather and climate patterns in Antarctica. ", "short_description": "Battle extreme weather conditions in Antarctica while repairing a network of broken weather stations. This VR experience is based on the real world adventures of polar researchers who build and maintain weather stations in Antarctica in order to collect valuable meteorological data. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtualenvironments.discovery.wisc.edu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Field Day Lab", "support_website_url": null, "website_url": "https://fielddaylab.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9679186578779869"}, "review_messages": []}]}, "cover_square_image": {"uri"
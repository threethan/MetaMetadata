lWrUlEYDa0ro4RgFQ6SpP5YUispGMS6HhnqTfekeQbDtg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRwoXGMAIspD2dhAXPI20abq5Q2CdszkFNLq-VgJV7_A&oe=6A5F69B6"}, {"file_name": "WS_01.png", "id": "1978044952615166", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75630199_1978044955948499_2334364805971795312_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Awm3uxRiUJEQ7kNvwGqn293&_nc_oc=Ado3LKcV1vVZPKMxAMMvUjUef4Jxdqhwu0y9ftcyoVvb5Kq9Nu1POlnjbsCjXbhewkM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGY-6Td7m8KSyatduQNEyMRkgZR8YRy9WWCYDw7fL61w&oe=6A5F69DF"}, {"file_name": "WS_05.png", "id": "498632252494609", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031319_498632255827942_6794795689564714062_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_ugNtofH8sQ7kNvwGBsdMG&_nc_oc=AdpmMBkQLLs6KZGXjrl0TIdIQEeNnQZuoIhg5howwSXx-LjOGkHPuggkpewBETlj6EA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCU2CBXwo7CncqvzpPrUBQpYDeQhfGoPv6UphPC1sgvQQ&oe=6A5F7A6B"}, {"file_name": "WS_07.png", "id": "424783607086418", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035448_424783610419751_2894153629193448176_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXM4QLfMZ6AQ7kNvwHraIQC&_nc_oc=AdqPZVj2ONvcnuEKUqG2jQBBqzT9WY-rkoQJYPl3HFJCuAFrg7OTPdCqXIIk6vC4qE4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvxDMrHMb4fFOT0sThcHTW_E4ehBsv4GpGXurTN0dmpA&oe=6A5F6E97"}, {"file_name": "WS_03.png", "id": "976582357120521", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974771_976582360453854_2656227771931204459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixNYoiBQneMQ7kNvwEvQVJC&_nc_oc=AdpqCFRxSSw_IA_I15GfeqhxCgi-8DPpkrn4QpziBAt1aZb-dAyl_hNVRc-M8uOEtww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-3sbSimUjkqus_T6kZwtFRAQ-t5fAlLNxZQ-yhrX6jQ&oe=6A5F7D72"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On The Ice:  Weather Station", "keywords": [], "long_description": "On the Ice: Weather Station transports you to remote locations in Antarctica, where you are tasked with repairing a collection of weather stations. At each station, you\u2019ll identify the components that are in disrepair, fix them in your mobile repair workshop, and then reinstall them. You\u2019ll need to work quickly, though, to avoid getting stuck in a dangerous windstorm or left behind by your pilot. If you succeed, you\u2019ll help restore a network of weather stations that are linked via satellites and used by researchers to understand and predict weather and climate patterns in Antarctica. ", "short_description": "Battle extreme weather conditions in Antarctica while repairing a network of broken weather stations. This VR experience is based on the real world adventures of polar researchers who build and maintain weather stations in Antarctica in order to collect valuable meteorological data. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtualenvironments.discovery.wisc.edu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Field Day Lab", "support_website_url": null, "website_url": "https://fielddaylab.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9679186578779869"}, "review_messages": []}]}, "cover_square_image": {"uri"
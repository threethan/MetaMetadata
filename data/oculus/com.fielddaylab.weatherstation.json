607086418", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035448_424783610419751_2894153629193448176_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=209cMpMSXywQ7kNvwHdLCv-&_nc_oc=Adp3w_1b-OEz61f49E8kmAIo_-YMsVnhMGLEKYskzU1Zd6mVYRQ10mLQ3QDwjIuenvM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObz0uGZ3EWrDR5q-KS_v6SfRUMSZCi24BZ6YmDLCd7vQ&oe=6AC64397"}, {"file_name": "WS_03.png", "id": "976582357120521", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974771_976582360453854_2656227771931204459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uz8BiFYI3qsQ7kNvwGjdT3C&_nc_oc=AdqkaCqpWG107ws-Q_Lr05apooeEKwLxKRXuwcrhwFTd4n2hz5OI4xGcqm91j0d3x5s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGWmr13RT--gJ0sGZPjA1lcW99P_bw5QiKS7vlh_LR3w&oe=6AC65272"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On The Ice:  Weather Station", "keywords": [], "long_description": "On the Ice: Weather Station transports you to remote locations in Antarctica, where you are tasked with repairing a collection of weather stations. At each station, you\u2019ll identify the components that are in disrepair, fix them in your mobile repair workshop, and then reinstall them. You\u2019ll need to work quickly, though, to avoid getting stuck in a dangerous windstorm or left behind by your pilot. If you succeed, you\u2019ll help restore a network of weather stations that are linked via satellites and used by researchers to understand and predict weather and climate patterns in Antarctica. ", "short_description": "Battle extreme weather conditions in Antarctica while repairing a network of broken weather stations. This VR experience is based on the real world adventures of polar researchers who build and maintain weather stations in Antarctica in order to collect valuable meteorological data. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtuale
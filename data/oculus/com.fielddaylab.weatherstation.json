607086418", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035448_424783610419751_2894153629193448176_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bozi_XJHwDgQ7kNvwFm2qoW&_nc_oc=Adoa4YWLGGJ_38bLspVKtXmQ16pvMzGqYVdkEG3xcJjqAi42oFnIvgNuXlZ9cCtAYcA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5735g8rUCGxjRioK4qOjg58f7ojxm2SxTwm1QFlkgjw&oe=6AF9E657"}, {"file_name": "WS_03.png", "id": "976582357120521", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974771_976582360453854_2656227771931204459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGDKgFDXg5MQ7kNvwHSpfiL&_nc_oc=AdoI2obVsg05hyMS85GQHGlWV_GFp8Qc6n_AgsfKiiGc6BlS980t6kM3nWVx1wjxk68&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-7yP38zp5WR1NBySffSb7AvtDK4GQTlcSViUCuBLGxg&oe=6AF9BCF2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On The Ice:  Weather Station", "keywords": [], "long_description": "On the Ice: Weather Station transports you to remote locations in Antarctica, where you are tasked with repairing a collection of weather stations. At each station, you\u2019ll identify the components that are in disrepair, fix them in your mobile repair workshop, and then reinstall them. You\u2019ll need to work quickly, though, to avoid getting stuck in a dangerous windstorm or left behind by your pilot. If you succeed, you\u2019ll help restore a network of weather stations that are linked via satellites and used by researchers to understand and predict weather and climate patterns in Antarctica. ", "short_description": "Battle extreme weather conditions in Antarctica while repairing a network of broken weather stations. This VR experience is based on the real world adventures of polar researchers who build and maintain weather stations in Antarctica in order to collect valuable meteorological data. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtuale
1-25/39035448_424783610419751_2894153629193448176_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rn6POYN7A2gQ7kNvwHsHxIC&_nc_oc=Adpv4v1XulHeTlFcWUG6unOlkk8Yfs2ROL3eGmpnPiv7PnBg0MRGQ2vL-V8fAo1EokM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDdKsm8ZugnCmji2J0aSRKoZPHK_xmbrd4hr9S91kZXw&oe=6A8EE497"}, {"file_name": "WS_03.png", "id": "976582357120521", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974771_976582360453854_2656227771931204459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TG8uCBuExpsQ7kNvwHhaF1D&_nc_oc=Adqq6m1k-WqxB7dbYlXgS-jwejWLDt3K9IrEPGLm6eyMD2jTnWxGii8IhwcDEcV8-fo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOncOo4AAXa8FX21z0h0Ar_yVwsPrJK6CKai_c3Ia-8A&oe=6A8EF372"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On The Ice:  Weather Station", "keywords": [], "long_description": "On the Ice: Weather Station transports you to remote locations in Antarctica, where you are tasked with repairing a collection of weather stations. At each station, you\u2019ll identify the components that are in disrepair, fix them in your mobile repair workshop, and then reinstall them. You\u2019ll need to work quickly, though, to avoid getting stuck in a dangerous windstorm or left behind by your pilot. If you succeed, you\u2019ll help restore a network of weather stations that are linked via satellites and used by researchers to understand and predict weather and climate patterns in Antarctica. ", "short_description": "Battle extreme weather conditions in Antarctica while repairing a network of broken weather stations. This VR experience is based on the real world adventures of polar researchers who build and maintain weather stations in Antarctica in order to collect valuable meteorological data. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtualenvironments.discovery.wisc.edu/privacy-policy/", "developer_terms_o
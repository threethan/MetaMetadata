HjrgP5o-mCKVqOp8DStLDA2PheIdUPdD_TkF6f1upTNr0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlO20pAh9qZ5AUFHUMQQt9L6MXORaiimPTV7MQt8QKyA&oe=6A9AF576"}, {"file_name": "WS_01.png", "id": "1978044952615166", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75630199_1978044955948499_2334364805971795312_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oyrc4-YsU60Q7kNvwGiE3Cz&_nc_oc=Adri0sygsNDeAaD5yGJesA6MLjcgvRThmC0tbGzSOazhnJQoJFXLGaj5vJwRF9w0-ms&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6Om_BQL6WxCjLr9B-RTGpGdAYjYqrGbvoEGLUJ5ncQA&oe=6A9AF59F"}, {"file_name": "WS_05.png", "id": "498632252494609", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031319_498632255827942_6794795689564714062_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f72B88h7LrYQ7kNvwF-kep9&_nc_oc=AdrOBBYQ_sj78GYtJciATqaF8DVWWluzSRXefRAO5My4gO3_UD_19d8uPCaYqd7yQE0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcE9wd5ft7GLnBbLRZryVcds9TkGgHZLfsS7eaOH7VuQ&oe=6A9ACDEB"}, {"file_name": "WS_07.png", "id": "424783607086418", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035448_424783610419751_2894153629193448176_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OtU86f7PTUQ7kNvwFn9pTA&_nc_oc=AdqUdQxs-z46ypYk7S7BtX3XAeHAuPXMfTy4GuoxjnNogP9atWimmnkeaRDv3quRRhc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3lEK-8-ogXmsFRkV3cb7n79hUNLzg_Bkm7cr50-zMag&oe=6A9AC217"}, {"file_name": "WS_03.png", "id": "976582357120521", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974771_976582360453854_2656227771931204459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsmLdSQA19cQ7kNvwE_hY8U&_nc_oc=AdqaxFHLu_to51ILFQqx28JDjFJI0Ow4T9U8fWAfA_BPAoZlDPAvjLg1sGzObpXj9Vw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJFl4cyTku7UC4SnNxzSfuhU1ChGAVD2UfI1pvcPDIFg&oe=6A9AD0F2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On The Ice:  Weather Station", "keywords": [], "long_description": "On the Ice: Weather Station transports you to remote locations in Antarctica, where you are tasked with repairing a collection of weather stations. At each station, you\u2019ll identify the components that are in disrepair, fix them in your mobile repair workshop, and then reinstall them. You\u2019ll need to work quickly, though, to avoid getting stuck in a dangerous windstorm or left behind by your pilot. If you succeed, you\u2019ll help restore a network of weather stations that are linked via satellites and used by researchers to understand and predict weather and climate patterns in Antarctica. ", "short_description": "Battle extreme weather conditions in Antarctica while repairing a network of broken weather stations. This VR experience is based on the real world adventures of polar researchers who build and maintain weather stations in Antarctica in order to collect valuable meteorological data. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtualenvironments.discovery.wisc.edu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Field Day Lab", "support_website_url": null, "website_url": "https://fielddaylab.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9679186578779869"}, "review_messages": []}]}, "cover_square_image": {"uri"
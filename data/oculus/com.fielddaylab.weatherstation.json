alGD7WvlNu72iKR69p1gOXv9yPw_62mbxvOqLkllYBO0w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhqaQ1DcGRcuFdApT5l16tTtLM1gDGFYgwG0lA_r0Qkw&oe=6A805F36"}, {"file_name": "WS_01.png", "id": "1978044952615166", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75630199_1978044955948499_2334364805971795312_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOmDAxNXls0Q7kNvwFawOfZ&_nc_oc=AdoPWUcsKdaUeF8qVa9Di6gMoyxOyuR6_-DX-yJDwjXubGzXYx4VuiLVG2ArCjT-lU8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2ofiL2HzP8B8rcgfpRjsmHjOSL29TrfHX-1XnR88Kqg&oe=6A805F5F"}, {"file_name": "WS_05.png", "id": "498632252494609", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031319_498632255827942_6794795689564714062_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7fDFgCQItkQ7kNvwHn72QU&_nc_oc=AdpRlIYVHVYjpPmGGId8P3mOEYuU2pQDxN7b84vV7Ta11V3UndgWtbz2vrDpNlS2G5A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYVZI9b9aM15FgikKHVMEWikINbo6MzvYNv3qmRF0ZSQ&oe=6A806FEB"}, {"file_name": "WS_07.png", "id": "424783607086418", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035448_424783610419751_2894153629193448176_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FErVRWTzQvEQ7kNvwGuVf3B&_nc_oc=AdqF1P_9uIS0twbvl8fnLcilPdYIDUj-ryqN06NCAyHY4dqEdw9P31ETYOOW1dSPBzk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-q4dphRh-V1Tzsf3Xhk9LhTvpfGbgZjVhR0lXlnZSRg&oe=6A806417"}, {"file_name": "WS_03.png", "id": "976582357120521", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974771_976582360453854_2656227771931204459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QE3He70aXtIQ7kNvwEsITpW&_nc_oc=AdqQ3wKNv9G9klcyEw53NLJwfk4iT8DxdePe4Gs1Krd-Gy5i6Fr-WCB7EQqMShzLSQU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxu_oWOB_KmBVHIJwCb8vhlFHLgSaItU1d98rBPyxZrA&oe=6A803AB2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On The Ice:  Weather Station", "keywords": [], "long_description": "On the Ice: Weather Station transports you to remote locations in Antarctica, where you are tasked with repairing a collection of weather stations. At each station, you\u2019ll identify the components that are in disrepair, fix them in your mobile repair workshop, and then reinstall them. You\u2019ll need to work quickly, though, to avoid getting stuck in a dangerous windstorm or left behind by your pilot. If you succeed, you\u2019ll help restore a network of weather stations that are linked via satellites and used by researchers to understand and predict weather and climate patterns in Antarctica. ", "short_description": "Battle extreme weather conditions in Antarctica while repairing a network of broken weather stations. This VR experience is based on the real world adventures of polar researchers who build and maintain weather stations in Antarctica in order to collect valuable meteorological data. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtualenvironments.discovery.wisc.edu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Field Day Lab", "support_website_url": null, "website_url": "https://fielddaylab.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9679186578779869"}, "review_messages": []}]}, "cover_square_image": {"uri"
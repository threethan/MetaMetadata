_sid=6e7a0a&_nc_ohc=UcxwX1iyaLkQ7kNvwFhkfRT&_nc_oc=Adrkk9cmCXMTN7h_0i2aJkIEoIUJUAiHyS4vNz3s-3mvr7jmJ0W1YXUHvSmZY0RyzQw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFr6S3WxyxNDSVjETESjj8J1YmKLbm79DUIb_guQZLYg&oe=6B01DB2B"}, {"file_name": "WS_07.png", "id": "424783607086418", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035448_424783610419751_2894153629193448176_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2f36W6mU5oQ7kNvwEQSvbD&_nc_oc=AdqDF9i7vhpk8DhAlJCRFFVAB6v_6gx09jJuNc8mKyB2uo-vU9_U3B-rGPRlawclXkI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvGZ5MPQpBYUiqnYTmve-kmNHRJoVUkP8nuHSYk8xK-Q&oe=6B01CF57"}, {"file_name": "WS_03.png", "id": "976582357120521", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974771_976582360453854_2656227771931204459_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1GWHRu0PP0Q7kNvwH0wBqJ&_nc_oc=AdoSMU5ILWKeUfUQ_PBiV34CKxqE4AHS3wSw0e-thLgAKpeEGJ14zTA5j1eVsQaBMX4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzaoXne-F3a6Z0uHY2eOrInsN0RxBqPBqMkAYiLFNBeA&oe=6B01DE32"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On The Ice:  Weather Station", "keywords": [], "long_description": "On the Ice: Weather Station transports you to remote locations in Antarctica, where you are tasked with repairing a collection of weather stations. At each station, you\u2019ll identify the components that are in disrepair, fix them in your mobile repair workshop, and then reinstall them. You\u2019ll need to work quickly, though, to avoid getting stuck in a dangerous windstorm or left behind by your pilot. If you succeed, you\u2019ll help restore a network of weather stations that are linked via satellites and used by researchers to understand and predict weather and climate patterns in Antarctica. ", "short_description": "Battle extreme weather conditions in Antarctica while repairing a network of broken weather stations. This VR experience is based on the real world adventures of polar researchers who build and maintain weather stations in Antarctica in order to collect valuable meteorological data. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtualenvironments.discovery.wisc.edu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Field Day Lab", "support_website_url": null, "website_url": "https://fielddaylab.org/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8226401577391717"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1418006236919199"}, {"status": "PUBLISHED", "id": "273093235295119"}]}, "baseline_offer": {"id": "1418006236919199"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1788203040, "status": "PUBLISHED", "id": "1418006236919199"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27086615817610342", "version": "1.0.6"}, "id": "369074738906908", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7405617912803425", "is_concept": false, "latest_released_binary": {"__typename"
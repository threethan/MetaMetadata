607086418", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035448_424783610419751_2894153629193448176_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OtU86f7PTUQ7kNvwG9fdjQ&_nc_oc=AdrzZFWECOTpDBYVCEiYdtYRVgcTWQyhW89Ev2njYttqpoMxKKwrwmRd-5iK1AnouY4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBTUpi-oW7HL7pdhvvH0ed6htboKsU4EfhkfQiY1rMWw&oe=6A9C1397"}, {"file_name": "WS_03.png", "id": "976582357120521", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974771_976582360453854_2656227771931204459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsmLdSQA19cQ7kNvwEA3tR5&_nc_oc=Adr1FBNIJQnE1PN5PHQSa-XXjKgtbyMW1U5t2P25pF8PlD6F2waneNauyZDL7OG_ca4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdVuW41EwyDjEmT4dxUWB-vJKYzf7fNbgWvXikkS7Qiw&oe=6A9C2272"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On The Ice:  Weather Station", "keywords": [], "long_description": "On the Ice: Weather Station transports you to remote locations in Antarctica, where you are tasked with repairing a collection of weather stations. At each station, you\u2019ll identify the components that are in disrepair, fix them in your mobile repair workshop, and then reinstall them. You\u2019ll need to work quickly, though, to avoid getting stuck in a dangerous windstorm or left behind by your pilot. If you succeed, you\u2019ll help restore a network of weather stations that are linked via satellites and used by researchers to understand and predict weather and climate patterns in Antarctica. ", "short_description": "Battle extreme weather conditions in Antarctica while repairing a network of broken weather stations. This VR experience is based on the real world adventures of polar researchers who build and maintain weather stations in Antarctica in order to collect valuable meteorological data. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtuale
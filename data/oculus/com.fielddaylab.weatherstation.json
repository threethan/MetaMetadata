jC7Kty5PZ--IkNdaKJLsWeJhUzDR_dMLzQjoOtcPfz8kU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlYCOfYMAGBxSrTb6GGqZeuWhN4nfvVs9g3Z2r_DAcLw&oe=6A6DEA36"}, {"file_name": "WS_01.png", "id": "1978044952615166", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630199_1978044955948499_2334364805971795312_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzz5am-1ahIQ7kNvwH9hbhp&_nc_oc=AdrwPmEq3_z3zysrPZm28ti65rA5jD-v3RFFWI2br7RhVBLDMKuinGTL6t3jbPw7lhU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsPbQGUX6LhCRuuJ0yQoeedOHqq4Qy9Jza1BmvTpYsng&oe=6A6DEA5F"}, {"file_name": "WS_05.png", "id": "498632252494609", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031319_498632255827942_6794795689564714062_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0lU_qOb9_IQ7kNvwFN096r&_nc_oc=AdqVHyTlGV7mDJF0p8hc255z7m48R2CeUGbiLVP3HtyrIvquhvj0zvSdzC_ULd399WY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzP5eNO-7hd0dZqf1fSIahjDXRTTh6gJN7HWczUVZYsA&oe=6A6DFAEB"}, {"file_name": "WS_07.png", "id": "424783607086418", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035448_424783610419751_2894153629193448176_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdLBYSUdNb8Q7kNvwGurklU&_nc_oc=AdppL50u1LnntscylrInZbdq-Ll8nvgNERaMpif9jRlXpaqHNOocjiJ2MgrnrrKplpU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1qzxrJHY0iR9Ha9oT5CfW0NqOnpc7sDzkOFmE-y_F0A&oe=6A6DEF17"}, {"file_name": "WS_03.png", "id": "976582357120521", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974771_976582360453854_2656227771931204459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HL39TGqyRsQ7kNvwHayb1b&_nc_oc=AdoYkcbRTP54S_AvicHqdv8tzRV3aj1ed_3e1Nl-NHXC20T9pUQT68fUq2d79lu2Pj0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUajDNQhvsMc7IM26qYECe6DS-Q460C7lG21BofSYy9g&oe=6A6DFDF2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On The Ice:  Weather Station", "keywords": [], "long_description": "On the Ice: Weather Station transports you to remote locations in Antarctica, where you are tasked with repairing a collection of weather stations. At each station, you\u2019ll identify the components that are in disrepair, fix them in your mobile repair workshop, and then reinstall them. You\u2019ll need to work quickly, though, to avoid getting stuck in a dangerous windstorm or left behind by your pilot. If you succeed, you\u2019ll help restore a network of weather stations that are linked via satellites and used by researchers to understand and predict weather and climate patterns in Antarctica. ", "short_description": "Battle extreme weather conditions in Antarctica while repairing a network of broken weather stations. This VR experience is based on the real world adventures of polar researchers who build and maintain weather stations in Antarctica in order to collect valuable meteorological data. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtualenvironments.discovery.wisc.edu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Field Day Lab", "support_website_url": null, "website_url": "https://fielddaylab.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9679186578779869"}, "review_messages": []}]}, "cover_square_image": {"uri"
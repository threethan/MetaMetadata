QoEJilyp8FxDWRzii04CJFx5FjfVYoGqDKS21taD06OQU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6Hb0pxdIIOCTXrfDgnNxi7OgatjIAxlAhtDHBZVKsjw&oe=6A9425B6"}, {"file_name": "WS_01.png", "id": "1978044952615166", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75630199_1978044955948499_2334364805971795312_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1_I_jvykFoQ7kNvwHrZh92&_nc_oc=Adoz-hwPN36Ch1Wzj_-Yr26Rc_zrpbODNP8ZBXb0SWP9GMIoAH-6fxPRPToGpFGy56k&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSmV6mPHE6ZtzY7tbmb64G6AMI0ZfTWyNWtreAZsmnFA&oe=6A9425DF"}, {"file_name": "WS_05.png", "id": "498632252494609", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031319_498632255827942_6794795689564714062_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2jAehh-6N4Q7kNvwH44Gyb&_nc_oc=Adr5klUIL9xx6WoCRp-398yasZodjDf2UISrTkQeD87WXKw9X4JHd7HgBxVdbhMk2TY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzmdFAUEwgLdaO-M8UcIP8pPkJ_lAzZqyzFHU7bxb-EQ&oe=6A93FE2B"}, {"file_name": "WS_07.png", "id": "424783607086418", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39035448_424783610419751_2894153629193448176_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWEODxTGSuYQ7kNvwEftPpw&_nc_oc=AdqGswR0NKfehXIaDfOWnkCFv_nGiDUR_PwDUfN01FG2tbQ1gj2JLecLjz0IcjOmgSE&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpvSJf6p1PNspXw51-3f_TMS7yq18Andor9We79h8E4g&oe=6A942A97"}, {"file_name": "WS_03.png", "id": "976582357120521", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974771_976582360453854_2656227771931204459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBA9cLSaggUQ7kNvwEc-GwP&_nc_oc=Adp6N9OKMXR6Cfkxfa-djRxPkYdqBfl8w-VPbhzRW15pbJm9lOHCNP2jacaYz8vPiM8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFl5VKLQYCDMsoSXlufPfP5R1dV9HeLe3_sZmSF4yp76A&oe=6A940132"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On The Ice:  Weather Station", "keywords": [], "long_description": "On the Ice: Weather Station transports you to remote locations in Antarctica, where you are tasked with repairing a collection of weather stations. At each station, you\u2019ll identify the components that are in disrepair, fix them in your mobile repair workshop, and then reinstall them. You\u2019ll need to work quickly, though, to avoid getting stuck in a dangerous windstorm or left behind by your pilot. If you succeed, you\u2019ll help restore a network of weather stations that are linked via satellites and used by researchers to understand and predict weather and climate patterns in Antarctica. ", "short_description": "Battle extreme weather conditions in Antarctica while repairing a network of broken weather stations. This VR experience is based on the real world adventures of polar researchers who build and maintain weather stations in Antarctica in order to collect valuable meteorological data. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtualenvironments.discovery.wisc.edu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Field Day Lab", "support_website_url": null, "website_url": "https://fielddaylab.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9679186578779869"}, "review_messages": []}]}, "cover_square_image": {"uri"
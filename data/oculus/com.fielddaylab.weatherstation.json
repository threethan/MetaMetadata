607086418", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035448_424783610419751_2894153629193448176_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPM0iVl883MQ7kNvwE_MKr8&_nc_oc=AdpD8yWuj0l6RqgpQfNgYOPLxl6gqbeC3MYKQRmIb76yCLpMQpEblQdFy5-cVm7WYcI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLer1F2Cf8BR1j4-50RRJ0qGcCVdbyDbZSag3uM4IT_mA&oe=6AB67197"}, {"file_name": "WS_03.png", "id": "976582357120521", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974771_976582360453854_2656227771931204459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exu_gZ8FeLgQ7kNvwFvd9TH&_nc_oc=AdqNlzDVDcbZMmD85DkroaC4c8e8QXY8ZjM5U2EItHMdqO1pHYOsuMJpJqf8Kku7FHU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgQjnUotYobQibDw9regbKbnTTW4HVKfE8ZcdiOwQB4w&oe=6AB68072"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On The Ice:  Weather Station", "keywords": [], "long_description": "On the Ice: Weather Station transports you to remote locations in Antarctica, where you are tasked with repairing a collection of weather stations. At each station, you\u2019ll identify the components that are in disrepair, fix them in your mobile repair workshop, and then reinstall them. You\u2019ll need to work quickly, though, to avoid getting stuck in a dangerous windstorm or left behind by your pilot. If you succeed, you\u2019ll help restore a network of weather stations that are linked via satellites and used by researchers to understand and predict weather and climate patterns in Antarctica. ", "short_description": "Battle extreme weather conditions in Antarctica while repairing a network of broken weather stations. This VR experience is based on the real world adventures of polar researchers who build and maintain weather stations in Antarctica in order to collect valuable meteorological data. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtuale
yoDaHrCyvQg5fNZdR5aV96zqfcntC8vlZ0l6vKMo42mfuCygZCWO4A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1l4_DFlragC-eHSxl9HIHO2BMRfssZZQHmXfmhwg_Xaw&oe=69F35397"}, {"file_name": "WS_03.png", "id": "976582357120521", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974771_976582360453854_2656227771931204459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qq5KG5lnseMQ7kNvwFfEfrJ&_nc_oc=AdoIjFo8av1R6M7tgEisB2aDmy8TPfEf0txoilKYt7p6C4eI_78s_ZFHAYXet4v8Ro8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0HjmYy2w1O2mmPrHV2QSOVbLhT-XoYDGeO-2o33LBEJA&oe=69F36272"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On The Ice:  Weather Station", "keywords": [], "long_description": "On the Ice: Weather Station transports you to remote locations in Antarctica, where you are tasked with repairing a collection of weather stations. At each station, you\u2019ll identify the components that are in disrepair, fix them in your mobile repair workshop, and then reinstall them. You\u2019ll need to work quickly, though, to avoid getting stuck in a dangerous windstorm or left behind by your pilot. If you succeed, you\u2019ll help restore a network of weather stations that are linked via satellites and used by researchers to understand and predict weather and climate patterns in Antarctica. ", "short_description": "Battle extreme weather conditions in Antarctica while repairing a network of broken weather stations. This VR experience is based on the real world adventures of polar researchers who build and maintain weather stations in Antarctica in order to collect valuable meteorological data. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtualenvironments.discovery.wisc.edu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Field Day Lab", "support_website_url": null, "website_url": "https://fielddaylab.org/", "category": nu
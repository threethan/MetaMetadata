1-25/39035448_424783610419751_2894153629193448176_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUwR_Xrmu0gQ7kNvwGEmpWD&_nc_oc=Ado3dDZWb2UuLS6wdUVpzW2EaKe0Kk3gmW6OdX_mQ6DSfMUvxix_JZ3Dbc5Jm8fjf4c&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7SSYKzDIwplvzVOro0FL2qEL7RFNEguzi9kOl_Rn78w&oe=6A85AA17"}, {"file_name": "WS_03.png", "id": "976582357120521", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974771_976582360453854_2656227771931204459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8l2fnbd5vMgQ7kNvwE0C5MF&_nc_oc=AdrFXxC7RaZr8154einEwkz70cogr3360h7oF6zMeAOQxBkX5O8_HW2yYYhRCm0Zd6k&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQ9xQXjErN8lvs8Uw1j8i2uBsTsbwzhONMmGE0uFfCtg&oe=6A8580B2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On The Ice:  Weather Station", "keywords": [], "long_description": "On the Ice: Weather Station transports you to remote locations in Antarctica, where you are tasked with repairing a collection of weather stations. At each station, you\u2019ll identify the components that are in disrepair, fix them in your mobile repair workshop, and then reinstall them. You\u2019ll need to work quickly, though, to avoid getting stuck in a dangerous windstorm or left behind by your pilot. If you succeed, you\u2019ll help restore a network of weather stations that are linked via satellites and used by researchers to understand and predict weather and climate patterns in Antarctica. ", "short_description": "Battle extreme weather conditions in Antarctica while repairing a network of broken weather stations. This VR experience is based on the real world adventures of polar researchers who build and maintain weather stations in Antarctica in order to collect valuable meteorological data. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtualenvironments.discovery.wisc.edu/privacy-policy/", "developer_terms_o
s://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821782_1415147539682479_6622958573647008979_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQXTpUEjwP0Q7kNvwGABIjo&_nc_oc=Adqjni1MdJHwgE8xe-cH13LLX_xgy3m6tlNxSmPW8iCticVUoeouH9k9eGHXEytmQBE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3g6QmhxV2PcK4ILg9h9zJ_0J6OArFFFVY3FGH2pQf3iQ&oe=69EA2837"}, {"file_name": "sc2.png", "id": "954430867007537", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825052_954430870340870_7267421773246482124_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTkQ_blBpdwQ7kNvwEJK6XW&_nc_oc=Ado8MEmhWEAoSHJHNs4AVe5ibdsrtk8vnBSYkuUv1FUBY6cejnTehSg02MVCLIKVVTk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32t6SNlnGtspL_ZCltJ2ezemaSDykQlxfjqZUY2NsbTw&oe=69EA0644"}, {"file_name": "sc3.png", "id": "1549825626077823", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308349_1549825629411156_7894913663373359660_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxHGvPDPx1wQ7kNvwGWx9Ja&_nc_oc=AdpQhBLqGk7-lL3YlS_owFgC0dQ0jNVSi5kP5xEzmRVQHhd3gQyaka1J4JrggbUiJtU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tsNuLTHpk3_vtRmigW_jpQolte64SOqpXB4PvDTZJqg&oe=69EA0543"}, {"file_name": "sc4.png", "id": "2946120205589539", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825503_2946120212256205_7495408369397137781_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZATuJFnVClEQ7kNvwG5DGEL&_nc_oc=AdptqyCZ8Qs5z_YByZ8pkX8us9ANGTdQ5aWRMyeDs-GLa1hInz_R-3xJMuP5q7lcE0Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WiJVanUcnqRtyERgIRb4xuY3nqLgIBCH5f8iFxDZNcQ&oe=69EA1E0E"}, {"file_name": "sc5.png", "id": "945922577967827", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825497_945922601301158_6719311749866214280_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7Uoz97n5CEQ7kNvwEAWOWe&_nc_oc=AdrmDhej_7AhJAMshVtJjF6vTwRaZnipLhkoi-Z1KqAmIKb1Aahf7Q_BcMQWndjAUgM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Mf3Y1uMg30Bw5F64vStaOnPedoKp1it8Bl59V1GcqGA&oe=69EA05C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491830021_1261209479293062_3725137780706325634_n.png", "id": "1610622063595069", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821725_1610622070261735_244897193346104370_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8TgHp1scKgQ7kNvwG9V46f&_nc_oc=AdpGU9dK8Ujx46CI3gVDZM9iBSebOnrsnXRjNkfqqP8QaWiGdn2fhW15jv3wUMuf8BI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EbE6LLZt_0R_TeNxpuneKHx2xX28x4Bvfok47hlh-hw&oe=69EA184A"}, "display_name": "Boxing Football", "keywords": ["box", "boxing", "soccer", "football", "goalkeeper"], "long_description": "\ud83e\udd3e **The Ultimate VR Experience**\n\nFootball (soccer) gets rough. Boxing gets tactical.\n\nStep onto the pitch where scoring goals is just as important as throwing punches \u2014 because here, the fight for the ball is literal. It\u2019s football with gloves on. Play completely offline, master your skills, customize every detail, and lead your squad to victory.\n\nWhether you want competitive league action or arcade-style fun, Boxing Football delivers intense gameplay, full team management, and total control in virtual reality.\n\n---\n\n\ud83d\udd25 **Game Modes**\n\n- **Quick Match** \u2013 Jump straight into action by selecting home and visiting teams  \n- **League** \u2013 Compete across a season and win prestigious trophies  \n- **Tournament** \u2013 Face selected teams and fight for championship glory  \n- **Training** \u2013 Practice dribbling, shooting, movement, and goalkeeping at your own pace  \n- **Ball Smasher** \u2013 A fast, action-packed arcade mini-game  \n\n---\n\n\ud83c\udfae **Deep Gameplay & Customization**\n\n- Full **team and player management** - edit outfits, logos, team names, player names, body types, faces, and hairstyles  \n- Customize **all 50 teams** in the game \u2014 create dream matchups  \n- Extensive **gameplay settings** to tailor the experience your way  \n- Add **fun hats** and visual flair to players  \n- Activate **slow motion** for dramatic moments  \n- Dynamic **commentary**, explosive **fire balls**, and flashy **score effects**  \n\n---\n\n\ud83c\udf0d **Locations**\n\n- **Arena** \u2013 Classic indoor stadium atmosphere for major matches  \n- **City Court** \u2013 Outdoor games with optional rain effects  ", "short_description": "Football (soccer) gets rough. Boxing gets tactical.\nStep onto the pitch where scoring goals is just as important as throwing punches. Jump into quick matches, compete in leagues and tournaments, train your shooting and goalkeeping skills, or enjoy arcade-style action. Customize your players, manage all 50 teams, and experience dynamic gameplay with slow motion, commentary, fire balls, and score effects. Lead your team to victory and feel the thrill on the court."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/bf_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://boxingfootball.artisoft.pl/support.html", "website_url": "https://boxingfootball.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26110274271995751"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", 
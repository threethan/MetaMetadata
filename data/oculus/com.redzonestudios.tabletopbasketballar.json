nc_oc=Adr9BDUuTCorpz1hiV7l1eMbjlDzUr9EfZdc6aDFn8h5gnoIHFF2XaXlBihTJnvZlGM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHv3wySqxmeGzJgoq3B8A7GO-1a31Ae0sHmcFYsidqQNw&oe=6A95BF88"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hABSwNzIzb4Q7kNvwE9P1QR&_nc_oc=AdoLMUK996iy9FyfeOlzkWtB3DgbF3axMLBI57u0Zgwnh_mp805k5rBLl2Eqj4xcZ84&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMZJ69BQTFEasMjUImo4CHeJjNgBxJtuAVsHuTo38I8A&oe=6A95B0CA"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3DVo3BRRVQQ7kNvwFinSNr&_nc_oc=AdpGW-GRda_Xx80i-St4eJmWAxpoOBM8PuulzgqStF1D2iL4cGUmSammDZ7XWjMadj0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHv6zWdbbG_RfP6-swkyqWq1bPnSFBSYixCnh03ZidtUQ&oe=6A95B0D9"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmEjLQlSzxEQ7kNvwGxpYfE&_nc_oc=AdpKvgywRhpBmM_SbWzRvN8wQX0gM9kzrqx9J71Db14vorRyq-QMU-si29WMK4NAbi8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7aA-Xc58zo4HMW9_OkLCe-hw4LserEi3U-p0H2pX5Kw&oe=6A95C7C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoK-luJuPGwQ7kNvwHP1Q9U&_nc_oc=AdrjdOZ70-O4XJ3TjtqZ3gwafOrSeri_kKImHRsr5jM-UM7hWANdnbqx29_jhzYpaTM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEepLbPLTaR8gVT9DmqkMKHbbTbQ11FP4SPKN7bvSksWA&oe=6A95D55B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
nc_oc=AdrC8EfXQeYy6WJijaTNd17GXUAebYpXcr8l0WZNjJewaQXvwuCpx9rqGyrs9g7ohD8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOP1nt5WMEfHMNWYev3b4WWNDMXvNPeGRIfXjdJR3r8w&oe=6ACA4348"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58MjWLzj_NgQ7kNvwFrohuX&_nc_oc=AdonC4cRBxfTTuFyKPSKFbTfwb1XRAxZP_74r8lRwGBGcOFoJ9FpU9NGdsFsgA1b9NM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2Wa2D0AyxI8gZuhtDPZqDFOuPpnLemvJOgXmCwWym6Q&oe=6ACA6CCA"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xT3dx4rXCwQ7kNvwHP7feP&_nc_oc=Adpi2jeTJL9nqs2Gm0t__ZYhLZ6mYA8qr-nFJLM_P8O9RgXAvHJpeohHtUViZZos8PQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBeQ2yKGRcu0NI11D4lNvtmIol27ulQfa-HXFgafp48g&oe=6ACA6CD9"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RBKK4MQUXEQ7kNvwHWTWfR&_nc_oc=AdpnnLhVDmMSwHtOCLOxQX0ycaVviesi7GaJygy3vI8tkHEhTAp9ciFc0feyniBbcJI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfd1TqtGrhA8eraP54qiOaYQS1wJef07Ec_pskXYKc9w&oe=6ACA4B80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4Ppijsaa5AQ7kNvwFp-co3&_nc_oc=AdrVxu9W3xOfUEuizD27ZbNidaB2eeM5zxTjdv_Habh6nfJKuhdGhVMRlcw7H6pNGl8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7cz2zIpTUoCNfiTadwAge_2QHmIshVglLHSL4qJ_4iw&oe=6ACA591B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
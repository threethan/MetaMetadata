nc_oc=Adpk5ABtWAkUj7uZnBK2fVSSJeptNSuB3UsD5caXdjzwVmDSD6SM_lejeeyG6On4nLI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtiE2-XwC2IMHOmdoZ3ASqOISqPHuOQ4tEM9rHwaYrCg&oe=6AA55948"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0QyzaTDoO0Q7kNvwGlFoST&_nc_oc=AdrrW5kpqf7qrbdO0qiABfuGrSOm5EyPAkLHPXF0TwalyQE3CtXTAw4qFcj4S3ycDcE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAgvSftDMW9JkAARKnWchlhPfUNxiGAtCwkbERuNOWQw&oe=6AA54A8A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kc5E49L4dk8Q7kNvwGPjfTH&_nc_oc=AdpENDchdEgKjZMQjRPQC5X1ka54CF0WuOJNr5nGKVvVqpa5AyPTII8oJAFGtPPSswA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpQsyTA4hO69R49iRyQ4KXsZqjI020bJsiu1oEaAXY_A&oe=6AA54A99"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0K33wU1RMwQ7kNvwGiItNA&_nc_oc=Adqa7LKJFhk_IzJEgHxxROmp4c5wv8gjM7NixUArhVH62swa_MloZ1ZsBZcInoKOcgA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLopBleyPotjnGnhVO4YkDadHsgR96j8dvuMv6rIp_3Ig&oe=6AA56180"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3zGy49C0WoQ7kNvwHk3Cds&_nc_oc=AdpXOwHW3pLI7cF4SKY2LTVARlWcFw8EkHJ7aoA-2vZMc0Rllu59FxvjxKCxoTD7-ns&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIpFUR8HQjFzPgD-x5pyeYVWrt_s6_cgpQa4AXUrICVA&oe=6AA56F1B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
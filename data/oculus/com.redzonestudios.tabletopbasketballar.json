nc_oc=Adph1F_P56CdXrC1WHmj_yVGfv_X-chDwoFOC5ebUP4PR_q4outiEReikSkwrMwmbCI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtd3OlB4V5SQEDmyeDEKaVwT1uc0pwdRGX-nm8qPz-Mw&oe=6AE4A148"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cDQi4ZPcN0Q7kNvwGkKd0i&_nc_oc=AdphQY_2Koea0dPJIeue8k0fj4kPoPX2DcUUYSa8xa735PifLDjNNqLqtccEY-8Tf6Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1-6XfiFS8Ea14RDuYoRwYakv7P0CLcJs636lYORUurQ&oe=6AE4928A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHyzxZMkVtoQ7kNvwFvXeku&_nc_oc=AdoMb0WPIAjAqoDsdUGgIpACUpVl2Ic_26-0AFzpDGWgi5CPDYnEKGbnAKmBMXQtVOU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMn5rH7Xly9wNQLC6OyqtRkONATC_6GwsEhrSYC91oqyg&oe=6AE49299"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGszy_J_PuYQ7kNvwHS_89Y&_nc_oc=AdobWOMQckHuStcI0E572dnEsIiv6FagyRzqf2Yg-tSFrG6THNHD4S6fvxXj2wMUdnc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNE5AzdEzNKbX1u5islXyRn0Q6M5Cplhidcom69YuLi2A&oe=6AE4A980"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnW09JO3WXkQ7kNvwFg_lcL&_nc_oc=AdozzPo_wRszmDlKviyGb9TYLbbbxm7m9TCL0nKmMN-xgWKsiKKdHac_lMHMJSLmq8M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJpbL58Ly-cP-fFfEFL1HEKIzm69Uh9KiGsXpO5E9Law&oe=6AE4B71B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
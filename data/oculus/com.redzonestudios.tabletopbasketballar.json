nc_oc=AdokzViGDk-UmQafqs2LB88sVVL9Hy6gp1v88af0a4EUV474qNrZ2HMelWBzAcn9J5w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9ne6i_kmvgEPjiThDClcGlp-uQF24KObwAXRnEnWOfw&oe=6A7F1DC8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDIuYyj_wz0Q7kNvwF7k3yV&_nc_oc=Adp_DL9KdomtvmBcVGD_dTPe1tQPqnVhFYoIL7LhNzFmqM2CtUzyt1lL87hCV8aQay4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1_xyaIuxXo5Niw1KGCFLneWupl3kdb7XKL_0bdYfjpw&oe=6A7F0F0A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVhnEoJEju8Q7kNvwE_SIqa&_nc_oc=AdoGjcOxnDDq6L-Di-P02rrgYt-7ZaprzSI3CIoGyvMY0jn3E3zxYMbjlOwm3QouvcM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlDkyF3RTEBQ1aLZ0vn8XCVVzP-zk8NTJ1Z7ARODiHwQ&oe=6A7F0F19"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzZojwMvUGMQ7kNvwEk3Cz_&_nc_oc=AdrJOFk04Eni9VekIK_WQtqYzJBlvu_MxVxX23JhFl7RQbAagM4sp-0Qa-Ij7tgdQiU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGi6q56YEfShL5pST4ZrftSx_2zTKC9unhj0oMcJF5dHw&oe=6A7F2600"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLwicyHprckQ7kNvwGhdv8l&_nc_oc=Adq3hxpigL0tDeISuqrgfuQm6MxjLDXa_P1VhFXiYG6h0tL2Oug6cdN1hklLRnMcsjM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEE7E8GSRZhKcOGrnmgLlT_eBXFor1qNhiQS--YCY2AFg&oe=6A7EFB5B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
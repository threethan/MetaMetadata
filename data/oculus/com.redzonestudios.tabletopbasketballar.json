nc_oc=AdpytJ6P5pA-4w2hwahwKpFFS-5FQGYzuNgo11lYdL6Tp_RHqHqzQDUE6W3Iiyu0FjE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdXBK3Cu7vf3LeMYmAECS0-oBUxMNuMENsbyIFWzxdPA&oe=6A86CE88"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ChRbyef9HkQ7kNvwG_xTV5&_nc_oc=AdrLSBhRteEBGw31mij2dEe1SxBBWqBHeTTaGlDsylEYoASlLbK8HZhF1QVtflbDrts&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbG3xsih5Cdi__z4FQodFGESLRhaGEnsQya5e98FbsXA&oe=6A86F80A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAMfmRrErd4Q7kNvwHJQO9E&_nc_oc=AdpuRbYbGn33h6O1aSyLBr_l50a35oqWz6OYX0TKrxLYd7FfYhnNzMLq9yczyDbRyUI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnV4eDfRbvcv4v7epp0B_IOU7Uis5CaUpzFpmq1jsS4g&oe=6A86F819"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sqa2Nyxq4KgQ7kNvwHx_etG&_nc_oc=AdpMtRUwitcMlqt8DZbem3MOI4nJ2Nw7jYYEtpwN-GwIAVLB_mGQttZqFHSW7Bt8xvY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP9qalG-xa7HX_gQzSMiiNwna9mIdt24HekCCIXAQm6w&oe=6A86D6C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVz0k7wPNoUQ7kNvwHGf_Q6&_nc_oc=AdqeuYVY2AsWysMK8qxuNeP_VKP26bTZK9QW25UggU2VkvO9kJqV9uJfHVrwnfIq8MY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlyEZznn92NvjF1QTzP_A_dG0eUW2xCGlSkk4nwjuKYw&oe=6A86E45B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
nc_oc=Adp2hv4pHhHfGBgVAoD2xnQyd75Qx0rodxDFl41sFwexwKlv-JycnjQvmFrRtSXqMzA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ViiAXEc2sEghu12RJmJNXKc8QtBpu1JHyxdwOHUHjFA&oe=69E23B48"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdQaPxUmWj0Q7kNvwF9M7nr&_nc_oc=AdqFmmQT-m573BPeYNJUxYe6tpgmRQDRhWx9Zhnj7p-IsY8ayW1-JWbQ4AYRJcmltuc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0985u5i4QOpDtDXogsWmTdOni2aHIWKTK6he_RXlxmRw&oe=69E22C8A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NRURjn1kO70Q7kNvwH9ewfR&_nc_oc=AdpZiJTA1I5NutZ0l7gKmtM-YiIQyTas9w9XcYnOex7y4izrDa14ouGqW8jGZN1D-p4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qZKWCKKe1xxtNI4G_JZObqqcX33vaCO67hKqoJT0wHQ&oe=69E22C99"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFUOlQ3asacQ7kNvwE7oDdu&_nc_oc=AdpG2muU1KyhekTrXBbzq-D13OBnX3yguIpkfTQLWKP-jX0pi1O-j2Y5PRDJATISZ8U&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EflJ1av637tgTszC4lAI-7uA3kCN2e5KrAMLsHuK_kg&oe=69E24380"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5N5y-y-Ux8QQ7kNvwExLg1J&_nc_oc=AdpV3vSdz_4OjSFxIDu_B4jxQbdVOivR6bQYULiXmBNTYBh4sBEs8mikvjjYj1IdH-Q&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jfdVheTOVj7Svhvn7-GOz2Wa8QeyH_Qb6OtiEhPT1xQ&oe=69E2511B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
6HbGDq9Ksslek6Ns-mNfZqlRF9sM1Z2WCpXujEAps&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyymEjFBTK0SNAvPQ1MYUNXDY_UhCdof3Y0jkIzAXEt_g&oe=69B80B48"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjhwqh0q5fYQ7kNvwGXADqF&_nc_oc=AdliJu_af7dTj9TsFBQ3YuT5bxpf_8oeqHuo3mB5jXFhD4wTp6TxGpbgz4VbNxxU-lc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxX80Rnzp5b5HBEWhl_Tgl0goNgy70oXit9v8k4dPcA-g&oe=69B7FC8A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yckHPzypzNcQ7kNvwFTDlbU&_nc_oc=AdlBJIZXEAHxoL2NkwUn8UnOZAL-_xDdOBzk-A8Ss5pbS3KTemrXJCpnH8hwgzdRkQQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwaVlvXITX0NZKiLKB9WwgvkbU-r6xvelYNhb5eP8m8Sg&oe=69B7FC99"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oldzwaWD4w4Q7kNvwFXKQjb&_nc_oc=AdnNmkaXhJ48yS46SetFmyg_9HYHDoRBqwUMCK3s4ZaxcCoDkxk5RhtFV-WlbnS1wwo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyqWECXbB3CwPG0gs0hK7BS1Kub5vTVLLEfx88bVh65qQ&oe=69B81380"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_j6zw7MnzYQ7kNvwGrP9ef&_nc_oc=AdkPrMPtwLJN0M9xjxO3_gLiFRP9wLbVHYDkn91RNSXUvj1w4WKLG_YsSWWEqS2d4Wo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzxw2yK54AnP2H1Xm6UklmkfGxpqlEfPpPz5iIuFkajHA&oe=69B7E8DB"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "RedZone Studios LL
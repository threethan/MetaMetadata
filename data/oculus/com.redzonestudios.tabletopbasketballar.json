nc_oc=AdpXwHhsb5VYsEjqnPoueG4bW1z96C5UHifDskcjm78wW2Dy1k8K9UunL6RfPSIrFnM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1svHtT60dHUOrXJTC0gPbevUFRZtbut6bNQ9ooohbV9A&oe=69DE46C8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3KCZvreYUMQ7kNvwGiI6um&_nc_oc=AdoiU4WItyAKyhXPA77gH1lfFRENYTHnyc61PXId0CQNqZam_QdZdSlr4vdAZOK3k6I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af361Jy4kLWRDi_vYhSs5vu2hm49vKpt0mbYPPhBrMqQTg&oe=69DE380A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I76qPB4cBjYQ7kNvwE-tRih&_nc_oc=AdoX_AAmM35j78q2P3V4ROiuC9a02GXGL3aXhWmnoV8fN5jkjXMUCzTk58l6wPDboYg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0B6K8wxiZaHgw4QQ_PbGo4s3Xp-wcZFaVg2FSK4CSMZA&oe=69DE3819"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gM9tsg1oTvcQ7kNvwEp_c6W&_nc_oc=AdqBwlRCSvHMaK3mDosf7v7r5p3JxwaFICBV-rusupVXy-2oWslUp8D1iR6fPkgRXJY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zdT09hUvB5ufOB5wPUHgmMzdRNuyg2S5IYFs1dIG1dA&oe=69DE4F00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6O1vKJPFqecQ7kNvwG8Altx&_nc_oc=AdqLWO8fMsvqWJgUH6ej9__OpPWFx2x3dtob40WgMMqO90eLDOMtOHm1Q9RI0gbPLZ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2V4IRTHVoghTAXDQaAnybgpopgIqJmrkXD8aC0hIDiEA&oe=69DE245B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
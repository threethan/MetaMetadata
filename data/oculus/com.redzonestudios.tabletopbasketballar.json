nc_oc=AdrxwIbeBTehfl6bp3SnfUEe3N4C88WIfAyNB9my6GCoh9S_7Q9cTjTfBjEUbgxjP7U&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkKfA8sBbAH6GwxMc2VTnspQ7tIG2aNEzFCcnfRXxe0Q&oe=6A93FD88"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hABSwNzIzb4Q7kNvwFlJGrp&_nc_oc=AdquDNbKPukkOZjhe3B7d0ZNEgJOf9tuhVtWNibFK_4L-Uh-FeDiCXibYIVgRnTUBlA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOtGZDT3DGBFrQDG3KMdV1GdxFJEj2tLL7sFsGZn92Yw&oe=6A94270A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADC0IVAajngQ7kNvwFGDszJ&_nc_oc=AdrS0GA5FX3eIp8L_62Pjp527s4lZ-ZWJP5xGfoatu5XbrD0z5VL96B9QWnwa1V2JJc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWPMIV4z7lTz_SH9v3YpMdBYJEPoELk_8ugcJ52UpJyQ&oe=6A942719"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmEjLQlSzxEQ7kNvwEHftTe&_nc_oc=Adp6B8FI4lOURhxIti5rrDFJT6ozE_AKV8cKn2RYRuaEB5KSyLARi1ZiyoniHa9HtsE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSxhF1PUU2xrWdEL-4sYKaD83-48KFiNRgTwtgKpK5xg&oe=6A9405C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVBlvDdj31AQ7kNvwEINkEw&_nc_oc=Adq1Lgw6WT4Ih4WjJoEoCWu8aIFKl0364fZgA2NVcuJd2Q4ulFwHV_1oLE737oNJLXU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOkE5JxA0vN6SHYRHBPMIOV5y380yiWSUrxKycfK-Yow&oe=6A94135B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
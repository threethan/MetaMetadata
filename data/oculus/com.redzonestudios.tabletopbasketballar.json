1.oculuscdn.com&oh=00_AfvSzunTXf6rky8UpxfUefQZkV_dg7s-zuMrF3yLtXz8LA&oe=69A2F348"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjWazl4pPfMQ7kNvwFQHJ8v&_nc_oc=AdkJpQ4UMPK9eOvVxWKNWgd4oIgV7aMeJZIiX0RRoIMg1iomhBEQCHWgToTJWREl81s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftWIV9QxeN3_--Xk0_-x0KYQAai9l8ipsZhk_ULuA5OTQ&oe=69A2E48A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4EjHTIAl_8Q7kNvwEe8t5F&_nc_oc=Adki4Duwk5cc5a8C2IMKKWWdFJNhevykn5zNhFfQm9zGT2YpY12FFYvgY1X5Gw6oaRQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuxPxOAg2DyysterbL6qiVK1vt4nPnKFRAz-FARu2CPHw&oe=69A2E499"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUn4Chw52_IQ7kNvwGCEOOV&_nc_oc=AdnzCVB0B3mg3oevDjgDawdSnBqRwmgb_gwDk3co06Pwh8-5sCDHxs6qVr6MQaucLTY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvziDvDD18MrerXyIxXvYzlSU3vHhCpY0Jj5wIYPI4kdQ&oe=69A2FB80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjVsZyDucVkQ7kNvwEU1yKV&_nc_oc=Adk4KG1tgM4R1psKoyjTXprGstj4VmVvehUpaKKDDqpT02K4CXOX1TIakDog3fQZzo4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfumG3F1oRcDLxNmwVv5rpFtI08XeRQgrwkDPJrvY1pgBg&oe=69A2D0DB"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "RedZone Studios LLC", "support_website_url": null, "website_url": "https://www.redzonestudios.com/", "category": "GAMES", "comfort_rati
nc_oc=AdqtBuCfR5GHorS4mGqX0RJyod6ApkDrtSmKQIG5orMxyEDD7at3pMGWLkqRmI9Tabs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMYRXAG0q8AkF6hgCYEoBzBpunUYEEFAXWB58A2C8L0g&oe=6AAFE548"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38KeIj8hMe4Q7kNvwFtpLSY&_nc_oc=AdpDSe3wx-_ZATYmkhNs1kkapI0BRS39X5ggPbT0xXk7cXyapmo1Fs0pjv69UH_r9_U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlhdJHZeqOlgMTaq4ZX6egUXQwf1nfMrt3jYiG8QxD6w&oe=6AAFD68A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4kKETwnziYQ7kNvwEPc4rh&_nc_oc=Adp9p3rIu5-ssQ9WmQCk60fulKTr7afQ47wxSnnEIzq5oFKCBkw5Zdg8earYaY3Nz1E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMmOmEkCx9AHKvoxF6Ah-FonhknT6U8w_GNFMRYmBQNA&oe=6AAFD699"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-XDJrz3A6YQ7kNvwHAXkAC&_nc_oc=AdoBU0jsMujJc2W7haNlWxKXW8lPi5hzwr2Rw_wT-XP2UK7h8qDCFFyfuUn4hjdDtUU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbYfyl1Pw5Y5VDwfCfQgIIn27MqjhCMGgSGq1OHU8kzQ&oe=6AAFED80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSFBN6yDFvAQ7kNvwHFxKjd&_nc_oc=AdrsbwUdC4nO3WFhzkiJRRVpqG_-f-WSciP5ykXGm6_3TTa1XQ38cJ_2DUHqRk4SfX8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUIYEZ10pT4Zqtnr_QPplULlsG0QUunpmpW6eo4djv2g&oe=6AAFFB1B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
nc_oc=Adq3wa-sJzwxPtasVLceT8sYIPh8Osb8NH7R5KU18yvqNP4XGA9vln43JlDKnHuUpdc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zpiwMepdCbHvLJlUFXA8YhILt86TGDhSolUnLOLxCMw&oe=6A4278C8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30sxq-jJmU8Q7kNvwH2dNnr&_nc_oc=Adr5aYYeHSVVTo8OEL5I07PX8bQ8Bsnb7XCMZWxFmaQG_HyC5tVmVQXtoqtSrVwhfeI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SW-FN0m7mt4p6ia7WY46NlWJZNW6bFI3duJuha9olMQ&oe=6A426A0A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qT5o3YBfka4Q7kNvwHItEab&_nc_oc=AdqJEU7ka_qgmdTln310nP9qpXEzBnvUr809y-2XY3fQDPgSg9cNoYajEGrELKM9HKM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8imefsNKCLBxsJthIUKUNWqc-kMNBRJCZlrybsZZj3eA&oe=6A426A19"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSn_xdrJK4oQ7kNvwHUwiWq&_nc_oc=AdoqN2-VWHAL7Uk6qSbenRAMby2FZDNSl3cfliUBpE-GxnOKENd9ecX7kNRZRx8syAQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cBhcRQs1m6F8ug8CZ26JDnNcXVyuslWFXBOrx_xg2zQ&oe=6A428100"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeJ8ejhyTAsQ7kNvwEEf1g5&_nc_oc=AdoiGNkq1lZNm39n2g5UQP1111qjKXJ3x2-tPUqFFNfc6Xus_aW5tmaJqzlNGTdEMNU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NyuLppos8-jpRLGdPV9CVCqx9BTQHGBynivfPNtJp5A&oe=6A428E9B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
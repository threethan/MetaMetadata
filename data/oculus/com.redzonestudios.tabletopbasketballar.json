nc_oc=AdpQPQd_Bha-fW8hSkXNf70eH5k9IBM2Mf0Zyu_7ibGD3f7wnTsiGXLowRmTVhgA0lQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqpLGBGP2Gb5t4iqL2R-Ntw5BbdvUZU79ixR7-X_37vw&oe=6ADE09C8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-fNc8ab5KAQ7kNvwFjRMiI&_nc_oc=Adp43vF0n3TIAF6KygXkt6_kIG7EAxnHH8_FiUUuT4254YiHQAbVAZlOJ7Ro3cdO2DQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMShhLfsChdoAJ3gY4oKEm18p-EJIUWB6fKy0-1Oh_PMg&oe=6ADDFB0A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SaTS8vElmhAQ7kNvwEvoZ2t&_nc_oc=AdpF_xiCkmv8u3yg178OXQE2cboEB62T7bAEsf36P1xrBe_QvGT2j1sNwscyZ9fbqx8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1GOMPw2MUJI6Uje3Tl8B10iFKV9mynsVj1GtNZa04Gw&oe=6ADDFB19"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqwZNcpsVEYQ7kNvwFpFBFG&_nc_oc=AdoF84DtUD-hW6e1QOlVta4dv6sv0_7GDP_YsjJeF2NGIcQwsjKcuWYJsMZ6i16NA2s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgBwecowHAC5UdFcwOJ6ilv8TimQecdJHDOi0ZQhbcLw&oe=6ADE1200"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOU4csuN7XUQ7kNvwE5NMhg&_nc_oc=AdocosLiu3nYQVukQ1ZrGTpObM3UkIfYXghCv4_KZmNHG0Ax6SClJdOJ4FYY-BFOVWE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdq-4IxSsKfbdxSFUYVrNiS8n3v1fBfZhLXrzIzySFYw&oe=6ADE1F9B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
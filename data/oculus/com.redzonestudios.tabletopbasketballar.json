nc_oc=AdqOoQUT68M3jcc9R7_bFkbglSmG2uN99hqhsqdEnXUlLqUp7ODsXoEqs6GOzdo_OSU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-5TQdlgXx7dE4aIv6AElGxZ9DC0fHXYKqDlWEHVf1rA&oe=6A75E348"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5cxtGkVoU0Q7kNvwGOUnNo&_nc_oc=AdqcD1AduTbeMlycFKK45Gip0T3476QN-_Ac5ge_NkB07up7llU2mCz9H_u_vY56JXo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWCZ4Q_k_IQgAknzAWEYcuBT5QmJaZmgoEAeIZVM9S1w&oe=6A75D48A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjIOVkA4fKAQ7kNvwGzdJPB&_nc_oc=AdpXI0GZbKlmpnMM8XIJzjFIQ-2xtAZ_-SK-UzZrtzkkDTPfMyMVQS7fFRqdWAcjrFo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4nrLq1knYDlNECOdVVp3vN6PRoSC6wZ_0Mf9q4DeGNw&oe=6A75D499"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTfDiIXmuHcQ7kNvwGL3eBL&_nc_oc=AdodJzaRwsALLsEWkX7GA4XQy386vHzrPVVhQWrufSPhS1dXzq2Cfvl2TTxJ-yrcYyM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFd0TNZe_Dq9aN0fBYpth0IpkNmmBmXuPBqwmucPpPqQ&oe=6A75EB80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAFcrMzaG00Q7kNvwHB_E92&_nc_oc=Adoa5DqCikanPBxFto0wLdpBf5Vf1JelDW9G8b0JTyEpPLI8F0eynhF-EAgVugysUkE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOsnooTvrenCl5npwCoH80lvB00XuFRPxVDpqXMvfL_Q&oe=6A75F91B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
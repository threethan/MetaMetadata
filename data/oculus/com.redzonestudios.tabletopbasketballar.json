1.oculuscdn.com&oh=00_AfvFlQ074WkkKoql2Xi2IMYdolEvxkkxFmrLWpTt-hZCFw&oe=69986748"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnOmczrLZI4Q7kNvwEx5JQP&_nc_oc=AdkRWqupJucLDcWC7QyHqbOPWMmZnI3XwHZNw7iifeB5OAkVqCFzN4OgAsRonLNexWI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftEa-z8Vsc9v9iRqtIed9rVNgnuMEz15txrhkF4eJklpw&oe=6998588A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n99-tkFSI6oQ7kNvwF8fPdo&_nc_oc=Adk7dtj19eFC8452BhkHFsBmme41StqIsBXi-70-ti1OaXiM5uoX_6_Br5WVTrTZI0w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftQ1AsRRvLeqoayTLgmArojdFFsQIrpgml_cJLbuRuX3A&oe=69985899"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgJKkr9JWnkQ7kNvwGbUu91&_nc_oc=AdlOY8YEbhXkyax7bbjJrb0crLHXVn7WLVVU8ocuLoKscXkGHxXpX_2RIQuPPNk9_Z4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft18U-lJwiWBcLJQ61_1mV2og5RkbjjqYvdq_fZH1kDJQ&oe=69986F80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObpWv0Yc908Q7kNvwEmpu3f&_nc_oc=AdnkCNUjcOZB4YdoF3P6xNRF0dqT3eBv8SLOqSZm-pNO8_s81TBGvL7FPS_XqvoZUn4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvICOEwW1repGvx9wIKBkm84iPgB4kW_giXf8neKk88zw&oe=699844DB"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "RedZone Studios LLC", "support_website_url": null, "website_url": "https://www.redzonestudios.com/", "category": "GAMES", "comfort_rati
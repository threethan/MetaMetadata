nc_oc=AdrKxvRDxhN2DxWUkf0v9sgxVpDqhcuTZWMXxwY_9maYFaifoBbSR81ZwAvs8TSHmyM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6x-_mHSdvL4brkhoAt7ZGogPlBaTnFMzt4oHH7cSlhLg&oe=6A145448"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rMzYlz-UekQ7kNvwEIQ4Xs&_nc_oc=Adp5sewdD3MtZVNytFMue2G7F9lZ7n9mkEdGY2xLHvhTbQ_vkvVKfAdp_k5b0EczULQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sKBBY5ZyLeJv8_MfBZgu17FGnRPW9FBOnskQ34VfBCg&oe=6A14458A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VC3eYnxZrZAQ7kNvwHFAToO&_nc_oc=AdorH9Rpe8wFGBSYYZKkfE7DfdvMhqOG5Skn2uWPiu2OSCfLoAL0t00AeQB4KoK1QPE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yyHRrQDmXibqqtdtK7-U4HCiAzU9RgEoiFnegxNDRbw&oe=6A144599"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tvb5MnUD78oQ7kNvwGWiIt5&_nc_oc=AdrHQO08OGY936vt9nC879DaE6Y71J4wu3EmvpCIvrNIHWt37NZ_Pu8q2_PZq1huCFc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZY45xt0Wfy6omx7_NG54hWAwPwllLOOr0xd_vNBKq0A&oe=6A145C80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUtkHEpUBaUQ7kNvwFHL5Y_&_nc_oc=AdqatLkPmL1Z0VLhXkOaJt122788UlA0xGq8b8a52PI-IDLLjRoPsCMgdJF_lC5Jg1Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EWr64Kc3pNS23Qb6KyutDKfofsTTn6d5Zvqbnw7PD1Q&oe=6A146A1B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
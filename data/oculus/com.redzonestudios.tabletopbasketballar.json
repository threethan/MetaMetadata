nc_oc=AdrhJwhZv8KqhvQUxZD4fTrJOhA72xSJSWk1akmabgY8XEQABT75-spfnEkvAHyJrGs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQON2oHBNsvAAUtW4VQr4N1JMpG__0mUCXwzViT8PwuNtQ&oe=6AE34FC8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cDQi4ZPcN0Q7kNvwF86oeo&_nc_oc=AdoV5m9mVZaxO1gJ1l-AppOIG_rQoXyi864Ly0HJBrSJ6MGPw10lrnSTcUU3FcKmoSk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCeYpy5v_vfXBE2t0uvCkrfdjifEZet_o5FBoqfh3Lfg&oe=6AE3410A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N85hSagDtu0Q7kNvwF51iid&_nc_oc=AdqFHOGX2Xlk4ZQhzpVKNfOPVzZ6-XLY0nWgqOUOUVZi6YI-yhfXQ7sYV1VmP7kb_84&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5qbd5qaYcHlSR5J81kqNEmNwSzAKI4S1c6nbWhEjoog&oe=6AE34119"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGszy_J_PuYQ7kNvwHNn9_q&_nc_oc=Adqrw6gzCkhUGiMcX76oYhom90NHyMp4CpeaAq4UMPiEMai85FeI8zVLZhcCnxCrUyM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaNJlkAOfA75CS9yZ0SNjaQ58bfHRGUAngslGgqV5h-A&oe=6AE35800"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtt6n2mYC54Q7kNvwECkfXa&_nc_oc=AdobBtDtD0gggQmajnHHiYPVmYEqa21ceCeYnGOlbMxuZtR9LUTr04VfbfZrEYIgfxI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUA0LWF7D1hoAZ3bqLIHb7W-XKwBYSj0yF5jrbCvN-7g&oe=6AE3659B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
nc_oc=Adoj7Ygv5Ut_DPOmcZrrm9T4eFiv2LDJDFQxRMs6qvYfj1Nvtc-TIXCeaOPSoUH5MHk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzStPrhbajhw8yg00IYiilQX8DiuDeb7loB5QYVavGk8A&oe=69CFC648"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UneWcq4hAj4Q7kNvwEsE_VI&_nc_oc=AdrfZRY0D3vT9GDdvTtaebusIfRoI3_bPr37S5KSfPVrfXW8Tb_Q7cmdqethTV6yEFY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNNmM2FgKP6KuK3ln-t3EQLFzyRGU8AIKIh58MdRQVTA&oe=69CFB78A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lymNt3pD1xgQ7kNvwGmAlmd&_nc_oc=AdrKYJht54Dyy5RL2hniouv38kjruUNflCKCEpe6LSmtQEn6ugRAUC_bIXb2LOJ2VOU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCkEVMjFWEyRyUnuo_eWT3U1WnlgUPHc4JmqVAo3hKtQ&oe=69CFB799"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQyP9ChvJssQ7kNvwG3HRnB&_nc_oc=AdpTr-3pkb63bF9UXH_CHNl23iCvaFTavDgHZ8gv8hrQGcxw1rMh0XxBniuoKCddBk0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJq5DvmqrSmI-RJFhvyshxlhmFev2fW2nUb5CXLp7QwQ&oe=69CFCE80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buuKBtguCLoQ7kNvwEfEg-6&_nc_oc=Adqizk1u0nojhacetQUT6yy0EJMg_gWSVwvsor6tTxiwlQwaXnnBjECyyQTeFerZ7-s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZGvhgyELeBSiT-wIOb7JW3FHXAuotwi9I0jDYrCogfg&oe=69CFA3DB"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
nc_oc=AdqWbsyNgmGyHmGtMfEltZvfODra0YGah8pewhfIXQAx8RNCWyz6sQ5PEN1Ox8kS2yY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Bg6-dLWzUMGbXD_DE7YZ2nGeyDYKyBGholN6aDTl4eQ&oe=69EA2448"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rceGMMgP4CEQ7kNvwEQ5MIH&_nc_oc=AdqwcnGlkQe0xS8GG32Fqt4IGj5Q9FOzwN37rroDFGy8rnr8Sw2mwG_xsA0qdKuATOA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2H269AI2ByoUwMun1qALFGE0Gpsdb51V9zV75t-xnKoA&oe=69EA158A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUbruRd5cXIQ7kNvwEsqpQv&_nc_oc=AdosZlCdv7fk5cHXZiYsyb4Z7ZcQQL2BR7qMsj3ZmOSycALu4FF1R5-yODpTzoEOixc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3x79cYunf3gmMr7-T7dz81U_NEHLbrSbtP6MhRwsTsVg&oe=69EA1599"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXjDUj6SVsQQ7kNvwEDhhzW&_nc_oc=Adrm9L8W6epv-0YHDM7rrDpxMe-tZHlDq_PsUVLv_KqVdpvxtkfcSk2QjU_tA9wpj_Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2m9LroTk-f4DyRCP7R2BI2vIm4SDI8-HZpMsbuBRPhjg&oe=69EA2C80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnnFv0vDiWYQ7kNvwFBDFSs&_nc_oc=Adq9kXrsFDV2qe6Q28jGYFHb-S6Rxl216hiqcsUphMiAVfkDrR_l3w4sru4VfpetV0I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Y-wM0pZpIGBv3lNSA4yHLsh0sBFJIJEQXqskTbhgc6Q&oe=69EA3A1B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
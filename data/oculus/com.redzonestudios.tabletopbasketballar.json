nc_oc=AdpaeBpCmTEjVWMfoWxDFROrjkhxl6U1oNXRnoYbF1x5mGJZ-mvu6-OAK4kPK1dHkgs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlJ7q2oZu3h2WUjio1IDZ-qkc7kkBlFHqrS58MmaYKfQ&oe=6AB91FC8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nrsxk6IiQuUQ7kNvwFmwsRX&_nc_oc=Adof8ivJwr36YRHcQMw13T3OfYInuNKK0Oc-04E8oLfSYo1Psifh7Q-t_RTzUP3PhXs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPwhO_ScrmeQ1AveuOFIjcAindXRYi--IH0HI-g2HWjQ&oe=6AB9110A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ji5j6byW6UgQ7kNvwEhtAR7&_nc_oc=AdoxQKDdiZmvVl_hnY6Vzz5shdrHeZIzI_L7f-Yze29EBiimHW1mwgiD06of5cqsw74&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISKtpAoxmB7hwd24D_NZcKVXQBeHz3l9nn_l-5q1dx_g&oe=6AB91119"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sc71cIu2PTQQ7kNvwHHx__p&_nc_oc=Adr_fuBxfkCoPDINqkhE-0aTuwZaQN_yP5ojd7ipS_8AUDq6Fc0sh7YsxVJi08lM6P4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLW8-dTxR8oq_TJAX91Ifvk3tV7ADXfIEUpp4GtPcqgfw&oe=6AB92800"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKot05oPU-8Q7kNvwHAAVrx&_nc_oc=AdoLF-PyYYI5afXfDWYrkFqirClTYuBGKKCiUaV1UCHfCpJqRfDa1yKvtrTqia_v-50&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0JAJx3KMQu4GP2z4hIDmCt3lC0df1MlEhLZICR_yUnQ&oe=6AB9359B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
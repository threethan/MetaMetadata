nc_oc=AdodgWA7qNT11ksTaGJzMcaImMrnvoLY1lgiyTTKvQ8we79v71yCISW8F6XkzupmXyc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfuLd-F4qv7hArQ7Ybp2b6j8MUDUtvk1ex4YAe9-VmNg&oe=6A986288"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQsA2fGJaokQ7kNvwEa3j6A&_nc_oc=Adqr50M42X63bLCIJRyQaJ_V5SZfhanvtdR5Sj8ISuirlKhESD8mG9vngV565B8oR9Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLb4BUp4vYBckC-PMkRE9fanBdgVvsrQi32BiXp6ZVzCw&oe=6A9853CA"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3DVo3BRRVQQ7kNvwG5KCeG&_nc_oc=Adqv9Ks7HxTxBc09QLsOd7MJB-QV5SyDXpgh9gbW_qIFIxErnxY5tbqsGvJ3gRmfoUo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJd31HVdkdCnbGs-XaU57vFQFyNIn8DWaoPn3QPK18UGw&oe=6A9853D9"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNC4BwWroXUQ7kNvwH5iOuA&_nc_oc=AdrIeZGW0oZcpnjS9MS8_6vqdqWuV2JV-0RX_bGz5U837ZoyrzDlvD7QClQ2gghXmSI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1Lq7DMdohgstqzHLaNPNPEEfL5p61MH_g8f1QgTFx3g&oe=6A986AC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoK-luJuPGwQ7kNvwFWYwhH&_nc_oc=AdoZzjEsTaGKA8f-wxlQUaUKh9a-1cNm2He7U1IMqmWMLgZQM_EpPEadNXvPcmijjDQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnadgIQFQv9ghLFF4CchQKeMG2qcultsgXCM3ZAr3B2g&oe=6A98401B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
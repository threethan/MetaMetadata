nc_oc=AdrH8fCsDgH4cl27MVsS1TWkmPiCaCkrijNz79UmmEqUzxvVITAmsYxKghtgXQMysps&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxbkd29hSJ7scAgLrVH-KX_8D1rcqe33Wa01bKEBTVRQ&oe=6AA01348"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmaepmrGE9gQ7kNvwEJjDEP&_nc_oc=AdoXoQSjSlRsiYqvTcvnkMr4psgz49dk6mBww7OvMWWwrio9ugvoUyxOHdRMZ6SAkPE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILZJXIW4x3TgzW1qdgArlbSgB955AD2mjn4HFqohLeVQ&oe=6AA0048A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJgOPMNn4oEQ7kNvwHvxnc2&_nc_oc=AdoOPHWTRMHZediqWrQoOJevNXizvLVFxjTiGCVuO-UXPYo894k4gvl0YI1YV4-xzDw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEtpL9IgewqIzxqFRaSey0K25zlB5-8JTL4IWZdkK6hA&oe=6AA00499"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkThyodvB40Q7kNvwGmEv64&_nc_oc=Adqp94qGOk_912vkXG1hemLQx6d56wcSreE9HE5jHMJc7tq1mxI1WVZTQkQGG4k4u-I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBCp8kcvsEX4gFdZjwjT9as8LyyzAoYjG4Ql9KuVSyKA&oe=6AA01B80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JayChC9OLhQQ7kNvwGIy6BN&_nc_oc=Adp7jt8tec5B2iiMaPkM7W4C7RZLpVbz0qjUzOXPPAJoVh_4ZD-1inHEJP-SGvLmEQ0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLh2PR78A0X1otWNFzcNvmw4CVyx-6M4H8F-qtVukz2jA&oe=6AA0291B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
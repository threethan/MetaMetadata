nc_oc=Adop9s_Xc8ILtmduU-eXnH9KREDwNro532hzsKpNlvDQdJl1s1Y7xOuUMcBSZC4c-d4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDa0GxWKfHBRsQbAC1AZJhFqAVzM6DoQvmdE_iNzaTqA&oe=6A7491C8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5cxtGkVoU0Q7kNvwEzkbCA&_nc_oc=AdoJsbmy4MC2THS6mifG9Jql6MynlEkk7D5TqrKib8KrzXizKiyDrR_bTTDv5nEjRwg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOvH3ae19hG4wt0Ab4vni61iiFmQ3NDyu1q-nx0Jh19A&oe=6A74830A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4jzhMqSpzYQ7kNvwEcmEqu&_nc_oc=AdodTlQxnYf9wfozvEF_Rzd8REFbwoZD83TT4-aR_e_RgNQBeMeMMXqX0DDQLmy2mSM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIBWH7g32R6vrtC_RrdJXVSAqxsY_qbytZIK3-PRzk-Q&oe=6A748319"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTfDiIXmuHcQ7kNvwFAGEPT&_nc_oc=AdrE9HYhTKxqNLuPJ5Q0CqCkNUY3Kj5xy6htVk4W10rn18yF-eDpgRDYg9BCU2QM9TQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHORrN2M9hD-Ggh94vE9Z2qtErRTWNnhzS4qmT_gdVxyQ&oe=6A749A00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODfvFJK3P6QQ7kNvwErKNJi&_nc_oc=AdrCjkeRBxahk5WpTNUSgY7eC94rUZVMDNHQ1iyPXmnzliHZnk7ax9O2O8FdVwF6H6M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEF28RqH6qYDtOUfn9Qk9MnUyi92JSNePRPnu33W1iNLg&oe=6A74A79B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
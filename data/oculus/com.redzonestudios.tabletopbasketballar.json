nc_oc=AdpH75gQZw0h248uNwFS8jD5Eff7KwxtbeI7IIp7kRzdbAROgk0P_Q-ik1keBjgPSGM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdxWEtmwK-AcN1_TJ6kzzSGjwrYAXob2aKiMrFwhI67w&oe=6AAA9F48"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wd-2PDPEag0Q7kNvwEgdlDi&_nc_oc=AdooE8KlVcrzgRAf4saO_Pxi0Ujl019jl43UtkConjW0O6ngliX88hKkmjEglMsijUo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLevpMMlAwLu7e9plZuuKk0cF155yZCPqTSa1CPfiHIWg&oe=6AAA908A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fESlmrPmOsQ7kNvwE9b0ke&_nc_oc=Adpe4iddUHP9SHe8agXwBqmOGau3Q603EZ1J7fjMknNi_3kGrV_x_hpPD8_uNJZwf4o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcxzuD25W3akf4s0QDJ9wypDBJ71Vc9ev-PuSxrHY9nA&oe=6AAA9099"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSPpqSX-pKMQ7kNvwGubnmc&_nc_oc=AdoVLg5FqNsAFYYGGE3pjavvKdjfc-WFStblYVedjjMU1emqwAaBM74xQh9ROaD-ERY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdnJGzOAobZbIrtnsi5sLiLyALj51GfrnrmAa1rSMcaA&oe=6AAAA780"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AH7TH76CswQ7kNvwHvrX3O&_nc_oc=Adq3VVFlFnlbqG9BserdHDocXzS9OHzktnWjUBJb9IdMQy2QwOan24f5kFiIcnk2CE4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA9SY9_yRgmNYzL0RHjVZx0fEmPo5AbNH_k3HoBN_rZg&oe=6AAAB51B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
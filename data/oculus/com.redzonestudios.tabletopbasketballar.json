nc_oc=AdroE0yVSrSvhZniBY2zN7ZQVGQ1ffFA2yKRegi1q3px2jA_mqth1csHWchqte69X-8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdt7DnPhOsWRDkREmyGqYvC5O5edmz2J2mQHdikHOV2A&oe=6AAD4248"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wd-2PDPEag0Q7kNvwFgUhyg&_nc_oc=AdrUQGt9LwkBblMXp6DSrSXBlMqa8wT9FutYifvyAW3Xkm88HMGEnj_xSW5TWd4CBwg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeJN811RH7OUFmIOtBNmgvQrgcAQLlIWOTb7wFX5MIiw&oe=6AAD338A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4kKETwnziYQ7kNvwHUqmih&_nc_oc=AdrlIGm8pZcAAXRZXfbTNtM51toSWbIs5PWOsgikt0DJWAXDkRblMh7Ovx1BEvUSW_o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoWfbMwYsL2WQP31EIBhd6oK1hh3lPPo6fyNz_u4EZWw&oe=6AAD3399"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSPpqSX-pKMQ7kNvwGR3k1P&_nc_oc=AdqVoF_hvVLF_74JUf-ty75LLdLq_JR4LBh3vhgCuDFJYtdEI5BSvgMiiNpZDJfsEI4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcBNL-t4j6deuoWrgnMvJadVSFy1ZNWr3RWBfW64wsIQ&oe=6AAD4A80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSFBN6yDFvAQ7kNvwFR8ugV&_nc_oc=AdrZPR-WNKLYmkrpuULJsKeBiMmAxH_siG81I7X_yButpZE7BcliuW-8SbWwDfKr9KU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAjy8AFb6qtg-yazWq-Q29kLbWNHzMDWnpcTanapwTSg&oe=6AAD581B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
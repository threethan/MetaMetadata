nc_oc=Ado4iFOJ1qmwQp8eR58wO3L3g1j_XaYlDKRvXtsBBkE6dVOtK6Fbl_rx2FdYt4x7xIU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nNcomSS5fsxTgmZO_KOcbyr-r0oT_QvR8beMiv5G8-w&oe=6A008DC8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spl60nxVQJcQ7kNvwHxGKAx&_nc_oc=Adr7X_VsA5bSSV3vOdCMTYTi4NV_GxXJ-oJnbMnIMoqn1xi7_JS4hcStQWBbWkZUI5Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ldIYAzMFYn1_Rd0k9dz3spdVKYr9rCkyuqWflajklfQ&oe=6A007F0A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z89K0qRheEMQ7kNvwFK0qta&_nc_oc=Adoc5OWrOoAmUFz7P_n5yvdi_NtXnfp0rC2cbHEbo7L1a8C6TZrYgMiq101Iil3FHeg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4j1LnLScX7tWXbPRTyK7IAlm8Z7j1Me74WJx6dB431Qg&oe=6A007F19"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ii8zpxgh1NkQ7kNvwGnkz05&_nc_oc=AdomnzI-XfjhlykiQifiEBHzr_ZK0woftGZnPRaseUQ1VLXlWar8df-xNYR8yOc8mT8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7o6vRcoXuCxlM-lI-xyFlBHt3n3TM8eNwGFSjQErB3Sg&oe=6A009600"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54Svc2qme34Q7kNvwHCVZH8&_nc_oc=Adr-BPjbebhRXVHmHPjilbTCxVY8Os1YM88aTUrDC9rmEb7ANbAGXACy_x7CG081UhA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4es1I9xqBUMdEcOYOhuuDsPjomMa0HoEXDiCcy0xARoA&oe=6A00A39B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
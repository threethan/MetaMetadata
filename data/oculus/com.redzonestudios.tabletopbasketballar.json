o_suZqh_4S18DNrbEsmuWHbmKYEbEFjDXm51Xu_eE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwrS61jpCgwoEa0VkUmzbwp2UeskEiw2ROvfuVeEM-zKQ&oe=69B173C8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SI3oGvDgghQQ7kNvwGtrgMn&_nc_oc=AdmP6gc1h7GaGsiF3Ipt0oowr5TB9vbs1iiBHt2WnR3kKwoV9QjunZqox_s6nYHsPGs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxcBNdqMMM5E5_l3HnhK4ZaOdo9GObTYP1FIvQK6ECI-Q&oe=69B1650A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3IKiXaMbF4Q7kNvwH9LCTp&_nc_oc=Adlpgq_xqloHrog20Uifs76-EK4Q4UPuzw-x6nCoB-VqJBVlKWyrXmGq7bYLCczreIg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyzZSFT5YSU9BB83V36owpNjb0T1px4bSRWB2RO1SUztA&oe=69B16519"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eN0fnVtFCu4Q7kNvwE-FBHT&_nc_oc=AdlpMmD3w_PO_TUjfKmkrHIiBC1H8QZFtB4zcg5V6QFeCdW_GBqbd0f0aQrQadXWUTw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzohm1uBFb74i1YtBlHMkdQ4me9NX6hjczgo0FOARXbug&oe=69B17C00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFJUUNWIQWkQ7kNvwGvxcCa&_nc_oc=Adnc68NmaY0cTpRhGOae83TiGgCnOwGvcnKzURAEdThuL9dz2LfteOsH7RZxVvrZcFc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0pt15rpP-Mict4DVleEbuKVcj9B029K8mVgT56vnnIQ&oe=69B1515B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "RedZone Studios LL
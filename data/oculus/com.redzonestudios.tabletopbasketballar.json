nc_oc=AdpwXApnVOFksbYTyc9ADb-9OFpXjwR7D1Fqrx1rIgbTO4LqRNF5AqR_-V0D_-FN7Xw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0F_tE-IlB1y_uJHEqsVyqurSLqX4kcb_PKdt4PXRjZ9Q&oe=69F35EC8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcSehRbF6cMQ7kNvwFzv1Cv&_nc_oc=Adp7ptzFRnvQ2lC0HZ-joeDoy8gH5Jeq3PoKielI9qiX_6RKzMIGCO0QCyCZR4kh8VU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0fwuc-Go1gZancFEV0weQJyRt-aqOz6y1f6FcWno68yQ&oe=69F3500A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Vdmf8sOpK8Q7kNvwF0_tqn&_nc_oc=AdqVWTWnji0x45K-lb8bFOAG6femDpzCHcqorIfNbeFy0015wUE7ssr7qmj3tISrCSw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2hmni9lPt1ImdjF-B-X7TlnMmqY4wWIE2c5q4ZXdrOGQ&oe=69F35019"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDzCp6KlmawQ7kNvwGL9haJ&_nc_oc=Adoqmo-NR72rdkhvTl53Zea9AHZ7RS1IVCd_f5-3yVTe3H4QJULMbdKNdqsGB3STy7U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0EfrURDOvRO70r3TjUgrv5jW1bvzYYARXli8eT2vrrAQ&oe=69F36700"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_I36GMsLx0Q7kNvwGpf_eA&_nc_oc=AdpLxL13IJgJMEBA0zgRRpfsnNBL4DsAu1hGWJVq-rbmRe260MsczWrQCBGlIWYY4ic&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af12FWE2ykrHDnnQajyb52e1xzVSmzbE214yhjrwkR_HUA&oe=69F3749B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
nc_oc=AdoLJjrFkBhStxywLop6rB2Mks-fWKVE9ba1DZWBGNYwbBGTveZApH84Jf1bCOsvV8E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMid5i9Ofas3BUg5xkg-rPWFcDhe2_jUkqf37uelmdiQ&oe=6A81C0C8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDIuYyj_wz0Q7kNvwHeEDIt&_nc_oc=AdpTu_0BFKjKHt3izv7giM5V-rb8OOVnrKAYLoYmMqm_3QcS0akHuohgKMIWJw72yLI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkwdSZbFPQBAtHUZpRd32qSGV3GPHoOdREBRwLxHQK2w&oe=6A81B20A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aZrWTZylIEQ7kNvwHWGU8K&_nc_oc=AdqTNjnLMjnQ80OTGSJEW5z6hV_nDn7VRMhR03MWljsnHzf7qjsN2-uuaENI0dXiK_0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcwus7SY5n3nEBN-_9BuOAwig0e_VjTliBau49POdLcQ&oe=6A81B219"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzZojwMvUGMQ7kNvwFUb5uC&_nc_oc=Adqb1MGk5-x8I9Pvyd20Ow5IVAFzYmBTskniwVwNKCPmudkZ-ftKnmTh2h3mjR890nQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEQX8pqsyip0B8mTMzoJSW4FZwqBwe7lNbVcCuaA4SwA&oe=6A8190C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1XyvEgFwEwQ7kNvwHl-B7A&_nc_oc=AdoqRvwsxiwzmri5ysW5Nh0xpE1iNT2uKCODSgltwz8kabJ-virpsPfqHS4ptYJFPpk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEccgdymGdnsUXnagQvOCwbNiy-ACdDbMMYkif4C4MjGw&oe=6A819E5B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
nc_oc=Adp1qA4J5BY2y1kKr_CoGWnaEGUQlKNF66xgRZwe4SYBvXCLShSHz6_0qd00UoKnMOk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwt2RnEmE1UeDITmHwFA8rTkmzu6s6wKuyLJnphIdJHA&oe=6AB136C8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38KeIj8hMe4Q7kNvwHay3U5&_nc_oc=AdrDBthmuWobHu6-E-6rRCA7rFjNP71Hd_-r-LoRvkINd4K1SzugPu9Q69SQyoQcfa4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK06LsOhTSoaq9H5wkw_n8ff-jyFxaLmmLCWe6Q_WN-6g&oe=6AB1280A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKvoJqQMaisQ7kNvwFsRIDE&_nc_oc=AdoLXa6Fs8mOs1j-qx56_1p5l8HKgth8s2TPUlWC7--wPYXIQmL2BeYrP9ORaVUyqok&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4qLFpuujSXzHgjrTWoJwHSmy4jzl50F3wBeLf1TvUCg&oe=6AB12819"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-XDJrz3A6YQ7kNvwERBB-A&_nc_oc=Adp1gtuP73fFyeLsjBcmGkIM44r5DUcLMJucEweIjZZYkEZY_0Ua7lxtlhx82wjFWQQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3BA9kIQMMBZTNi2tX6rS9LxODiqiI5vkm1y1SgcCvcQ&oe=6AB13F00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAnwTNqf50EQ7kNvwE7L5l3&_nc_oc=AdoCZnHaM6C8JaB5U4FbhQaILp19SPPtTOxQOUATVkbgIyqxSW_bKdkU0GOu2LvG1BA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmNBzRF1G9csSqhJcbmsyug7XRnniKaNLLxqek5dKpoA&oe=6AB14C9B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
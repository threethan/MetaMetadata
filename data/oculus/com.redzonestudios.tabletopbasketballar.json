"https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974868_885479802728438_8711661268208378868_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJEKaUg_lDoQ7kNvwGqFXoC&_nc_oc=Adlx4Tz7Yqy7AQ-UDVsq0ra83SbWO1qNPQbe8NQ4xDkkS8np2i2HgNFMtSgVLzyH5HA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTZfRC1EJIXkg1I1NUfk3xXwwsH2AcAW4ch7u1sR8EmA&oe=69AD7F48"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ht3NRC0sjCsQ7kNvwEmnS9g&_nc_oc=AdlSTsAPXIVHCxMOGryUFzJYi4RCgnErQSti6geH8jFVfgBPO4o7PctZxjvmn-3YB0w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxUqZAi87Iqp_4ba45097lTcc3FHS5uqUlZ3Eh2bO3rYQ&oe=69AD708A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcui4PjiO0YQ7kNvwFnTa8M&_nc_oc=AdmjkoRQak6vHu3W3F-mloURfCsgqsk4ih4odhvE0j3Hwjk7urpVA7hnCDZvZC-GG7Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKz2T-TpQhHhui5VEgErwLk0yOGRZe2E4Gx_7Si0Hd2g&oe=69AD7099"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cdVWQx-QHQQ7kNvwGom98r&_nc_oc=Adl8ecj36NcezOmW05OC00ACWAvcpkl9Z8BGcbep_s_8ejR6U01EACyoebNyj_t2MIY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwgclQtzagby6iQt5CNNzyaWPAi80GhBCBzKJ2JUiHZ5w&oe=69AD8780"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6J7llEHkvsQ7kNvwGJADwM&_nc_oc=AdloyxoayaDZ4uS84J2fPaatz3dqlgvda-FLbZM-ydy884YIMG8Vpy5ERrp0jznxVQs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJhoWmhS6L2W1-cd2uuvb1S97Cp7xtEP0XM0TzFe1LBA&oe=69AD5CDB"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "RedZone Studios LLC", "support_website_url": null, "website_url": "https://www.redzonestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6843217239110481"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6839551806143691", "version": "1.0"}, "id": "924718515619775", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6038074406291439", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6839551806143691"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "924718515619775"}]}, "change_log": null, "created_date": 1699844657, "id": "6839551806143691", "version": "1.0", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_result
nc_oc=AdpbIAQD32XzX2kJ-mdfQhRgSIwDdgphW3I4kSsgZXuGhpQf-FLz8RP1HrWAMAhv5Vo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAK3qiqjQ7E9MlCRx9HhbJpfoy-CNzn9YsBXxQhjU4kA&oe=6AABF0C8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wd-2PDPEag0Q7kNvwEDyGWt&_nc_oc=AdoNoPmWjOk4DU6CXJZRf8tjmnoWpjxUwb9YQwrJH9h-Z2D3HpmEyuSm1NidMkQp8VQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeP8C5QyUb3lgrUQz8rra3ELSB4FHq0rqIMA0qVJzAUg&oe=6AABE20A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fESlmrPmOsQ7kNvwFKDCu2&_nc_oc=AdpdkO_H5EScsUG6dGfnx1svyte-rMwLz95H6Sonc-QU9wPxUhaPJnpqNE48uF-juK8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIANBQQ8dJTnUozp__JlxljDePRGhFj6um_n9cJ32U-Vg&oe=6AABE219"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSPpqSX-pKMQ7kNvwHA8DNe&_nc_oc=AdpLHi9gHp4jG4PnOfAen_oJKZ2hml81y_aV1LvenpqZMxeKOpUOvl3C3M3AGvXh8OU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIy6k24MtVDUnQv3AiV0vi1ANoZjazoqPqzq0UXtkFVCA&oe=6AABF900"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AH7TH76CswQ7kNvwG9qkgn&_nc_oc=Adq-qNs2EbbSLbykWTTszRacuKx61_xgTlFwsnCbmuCy8kuCkEm2OPbvq4Wdm0phfIQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcPZEOPKZVFHPltXrg4xmHEb4ZjdIkiYzDi7JqC6J0TQ&oe=6AAC069B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
nc_oc=AdorRndsgqhecO-KfEeiBuYgUYjJ7IA7euWFLtMnsa1xoPubKEtQWbBZqTrw51uen_Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6bf0raKpVD9LobaP7AZp5zCYcppsgd9RuDhmmsqt1yA&oe=6AA7FC48"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6Ln4MEbhYYQ7kNvwErIWq9&_nc_oc=Adp1j32mRgMEyDG032yDV7cF-XilePalp7evprIImTJ8LujsYKSnJFPXRtHR73dI9yk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI84TS9FNGD3lN61SENi0wATf77ghg2GqyM3H823rd-dA&oe=6AA7ED8A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kc5E49L4dk8Q7kNvwFXRCq8&_nc_oc=Adok-X5BWbFarrVaqbXgNN7kog6k-8XhCTuzSpmQKmx_8KsZ492l2lBnZxlCRNn56xM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJApWFTXolc7oadWE5sqjddcXVfq3Ms4j0c1fyynyPmUg&oe=6AA7ED99"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jk_wsrlkrEcQ7kNvwFlqqdO&_nc_oc=AdpNJ8oqtpwdgh-6xhVp1UX3EbIOCQWrLq4Z8-kUzWCx8gTuSkNdd9LzG35XcCpvwMk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFJopyyhs3Qo4-AIT-ZMGCRtgm3q9qoS1_DPT5ullhiQ&oe=6AA80480"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3zGy49C0WoQ7kNvwGV3kIA&_nc_oc=AdoQdKB9ljIGUmZ3zi_FjgXxzPVKkRHiBzcR-w3n0LtHolxjOP3MGgabQbfFiiqHvWA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUBL0J0mNe_fT71RaH0owOHH952IE7sZtr-HPyUs-jzg&oe=6AA8121B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
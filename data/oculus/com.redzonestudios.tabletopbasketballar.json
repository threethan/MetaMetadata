nc_oc=Adoo_htjm2wDS8ziul9V4yOWPnF06FoAKOEtYZIwKit5Kkk2PwBJibQjbBDteDBTwsg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWWYVVM-NfEAxtej5kzmSVz_EqsgKfTZfqrZpXgU8ScA&oe=6ACCE648"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58MjWLzj_NgQ7kNvwH_2Ekp&_nc_oc=AdqCZQFUts0pg28ajouPZICKCrdfW5Xx0L-j5cgeFVta-aMNwANZBJ6PurF1EPeqp5k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEIjgtAJ2AdSEWTrNok5xq90eAUu7rXFLzhW-0s2x5Tg&oe=6ACD0FCA"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKeBKtVuXfsQ7kNvwFZDc5X&_nc_oc=AdprkiQkRccOQ07BbGAgRXs-6Q9E6Gar42oVAw3Mh2Xe8_z2hInFbjat61HfGiRTzeA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbTY07agEEPypbpC2ukRsI0mIu0czR7QkZ4GtO16acTA&oe=6ACD0FD9"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RBKK4MQUXEQ7kNvwHttVAV&_nc_oc=AdooDQp56kDYRQHin0pT8EyvzWAnqSyo4ywfQ1SR_vlkF_CKNeCEYUH75mtEHAjp44M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNj1NTs6FZ9JQX3mK4WvgOzq1xgBpu4Jne6JrWXrtcZA&oe=6ACCEE80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqC4h4FYWj0Q7kNvwFkmg5V&_nc_oc=AdpzQB8_d-XGxqr7axUqgg0dLYgvKmGuI86UuJTkE6eSbL1TcJPZcZVtjA5KI1C3xeI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPH8YJU4wR3J8H8AV2YYffAu2AWKdaF9GQXhtt5Xgty8Q&oe=6ACCFC1B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
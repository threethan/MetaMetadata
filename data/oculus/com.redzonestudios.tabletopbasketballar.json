nc_oc=AdqiQRzXgN9O6hoXOAyOV4AEsnYXEQyGOTgL5PGsclVZYw17OrJknuCSrDn5lMTRpkM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRk7ZMzTkFXnuh1oBCO9X1OztUTSPbDR2dyKMBbsh7xHw&oe=6AF5C4C8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miUPzprXkNMQ7kNvwEuGHzu&_nc_oc=AdoMcsDJ90Qf35vG1m4YfZBQZoPoDUBokP5tkebyt0pGQwlcK2USI-qGR8tVYdrRJM8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgHmFDANYHLqgO_HFvN8WVNKCCj89Lq4ot-NzEOMuGCg&oe=6AF5EE4A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Gln8wC_V5MQ7kNvwHpIXeY&_nc_oc=AdrehjzVKuy4WdfAVh4i-3eBn8NxbAy7Cq_zty3HlkfC-eZG3GWbwkzRgKTLI-stlfs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7sL5bA-itv-lAJFjm4gTpHNz_ltl5QRKRfVevk22mAg&oe=6AF5EE59"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkdMBTM_TP8Q7kNvwE3o4Nq&_nc_oc=Ado739MBWob2JhvhtLJJJNS-Je_8B2v18qtN5Og7RA3ownX6yr1oCuZX65h3RjwDTy8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDqGsFR97PpJ3MBhZOAU_5dqTa2i_XY9cqtFbxHJwwyg&oe=6AF5CD00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvJx1BPDl4sQ7kNvwHxQwHQ&_nc_oc=AdpV4l6aYSb0DM2wcQojRtDVECj4sCUAlmpZvrWwES9ZVtT7pWP_tze9QdFSNy2egTY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnIhHbrdpVDnazjBr0JT9ka4dVmWFjhWIzLw8E7qmVYA&oe=6AF5DA9B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
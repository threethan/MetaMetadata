nc_oc=Adrp52ToLKTDPiRI_52lpg0TsHTjYIcm_9qi67wcFP8OuN7m-ebqYCViKK3JmCEs5OE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9R5j1FuNh1v5iDDrYJ3OPFubw8D_cI9JirgBT555LnSw&oe=6A3D32C8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8IXLWhDHlgQ7kNvwE7o8UO&_nc_oc=Adqop5N6PNl2TS9nwC8xYTWOxS4KGGTUiu5A8geGbpnd-J9cVGBXiKZdpzL-_sqfvTo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Hphm0Lfl1TD_FoTS_lDNe4Mhnwh9SrzY_MMq9m9Yl7A&oe=6A3D5C4A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6nmXR-ngS8Q7kNvwF0C-1m&_nc_oc=AdoQlT1XDOvzZcvt12NXcthjmDs5SWZx3KM4nwsm77a-9VVs80tKVjaHCSFj-YyE9M8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-22-rPNLxAzh3zYDNHbNQ7p83JnO_YMvpJZQHYakh_dw&oe=6A3D5C59"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cTrvc_WNVYQ7kNvwGBq64p&_nc_oc=AdpVJtt37RG92rTYL4n3GRINqhLaKypjhBKC4qSfdbGJjii6X9YdyPXbOb4Zb9lBHJM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0FjbJKfYEVImhCSZk-qJ7QNyDV_TCbDVhDrnCbYU_xQ&oe=6A3D3B00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOPh9r9dQNcQ7kNvwGC6XzI&_nc_oc=AdquG-2ASDeabl5njxHyD6lwvyP2pHus2CO3noiglEw4bn81883hGghr1Sllsb95lmM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_svDtbwcc4BK4OPuh5uyotv_0JYtg5bGtQlZxtNt2sdw&oe=6A3D489B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
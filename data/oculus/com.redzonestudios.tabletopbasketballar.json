nc_oc=AdoPIZE991zEKn44TkFys5LGe7QMt_0YR6QyfF3QXyxWucdaAEHJDrloXygr3ahfVvQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8H29NlwuTFZUK95_Cjd_akbUIdwUz3grHZVlzoAbStA&oe=6AEF6588"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvdkFst54aoQ7kNvwEr8yKw&_nc_oc=AdoDOIw1uxznDOi0K-W4sbuS0jqwBQ9hsYa8AB4u7MEEP2I9zMooXaZn6RNUkcL7hPs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4HgMpjwrgfBCt8MrgfIQXlT_CTAw_cWtvPss-9U54aA&oe=6AEF56CA"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoqoAUwb_CIQ7kNvwFivDan&_nc_oc=AdrWVpIfBrIapJY4MhjTOfkOZmR3REQQmc4DPVKaWVeXZ7-lybol-S9USlsIx5j17aE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcqXDZ2CaVRmu0FhT964cRZ6D0Nh0xrakXGlbcVw9Jzw&oe=6AEF56D9"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oubSx1FPejEQ7kNvwHRYe1P&_nc_oc=AdrEJjLwb3gJ03tsx_YsNo5LqxFl6I2bOZ1whqIr6reim3nLAJd1ZtsL70ijJQo6qLE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjSP06SwboDa_7omoG2VmDyg1YRfS9es6b_MHBdXdC5w&oe=6AEF3580"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pU2EtP30epQQ7kNvwE4eDGi&_nc_oc=AdoNoW0vcS6hCQbxxkzdbioTQjkGKDKFwG8zFgADLjcPD7N9GmO9_59JF33tkwPEYIs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-w2SjTDwe1hewmX639BvAZDMdQYXnhZoFlQHmn5SCcg&oe=6AEF431B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
"https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974868_885479802728438_8711661268208378868_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjTvX7DLrowQ7kNvwERzDA5&_nc_oc=AdlCcFwRDoGvBVKeq72HGT-AeMBApBlnC5DULYhfklPCkx5lYNkTu-71mYiXNZIQEuQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxthloOM8i-u1B94bO0mCsw8ws8AZZ4gjCs3SrA5cD-0Q&oe=69B95CC8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8OnqAzyoVsQ7kNvwGQiCbF&_nc_oc=AdkFdctKmmwOpLn4LmvAiGyRbIPe9WnwT2NI9hyQWZzuRIWpa3r3lcmwUWvNjTuIWC0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzN1_W5_2hksZFoB2wHenNU5sB2tFVLGwhXLbwWhetyyw&oe=69B94E0A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yckHPzypzNcQ7kNvwFGgXbQ&_nc_oc=AdlnwMWdPhTrXUQeDwnDjhaduADDz_ZRaTmGkZZNIq0xSUcusO2F9uwm2tGyvyC1VNo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxoLXiYFzcpU2Qh0ZKR_HbCZAjXoWhmIAnmtpax8LOEmQ&oe=69B94E19"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etXgGi5CJzYQ7kNvwF81HxP&_nc_oc=AdmySIvjx_iXWVRm66p2MrfLvzHYiQqYh1wGfM6P1UwpOwc_1Jm42IkmI1EeD_HA_Ws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afym0d88Ta5SJOBdiAXsZQ60JIRdYQ0VV3XuxUWPD0P6nw&oe=69B96500"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_j6zw7MnzYQ7kNvwGQOD7Q&_nc_oc=Adks_N05s8rePub9O5gZetq_Pj4_et0QT80bw99GOoQMsMkoYOwGbtxPYMq8gBr0cXM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy8IdW2vaBq0Jo-4UfjePXQ9id3oVMxvHsiQ1kZW_io1A&oe=69B93A5B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "RedZone Studios LLC", "support_website_url": null, "website_url": "https://www.redzonestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6843217239110481"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6839551806143691", "version": "1.0"}, "id": "924718515619775", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6038074406291439", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6839551806143691"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "924718515619775"}]}, "change_log": null, "created_date": 1699844657, "id": "6839551806143691", "version": "1.0", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_result
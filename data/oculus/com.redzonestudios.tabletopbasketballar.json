nc_oc=AdqdOcv19dq2UERzehpi6yn2oTtBD4intbymHf8hY6FFm2HRhN-UR4MzSo3wYARz9Gw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbXC73JzOI470mwDUNQln_WOv9MUVgbHGLjALbV83HYQ&oe=6AB67CC8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nrsxk6IiQuUQ7kNvwHmyrhr&_nc_oc=AdpxPwvjsw-2rggGr0a4qSbz8fOmwd9n7PQ8qKdIPl6i3SFGqlpVV-2gcCadGGRTD5U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBjxKcD_OLYqkv1fzt4ac_9hCbtPC7W9ZuZ6w_krjKHw&oe=6AB66E0A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RW0Rm6HOXEQ7kNvwHUH_AR&_nc_oc=AdozLnFPB6bjzq-WgMMWgjmGHYyOq1D0hAk-1UGqGkL9sV7IAR9aSLr7HPZXx0N4aMI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIWHLIpRTdgrXyzKujOuvlg4DQcVpOnumbEWjLjxofAQ&oe=6AB66E19"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sc71cIu2PTQQ7kNvwEZXDqk&_nc_oc=Adpt1ENHYxUSd_f3Hw8rikir1Kb7TFbIcYiZ79dqXnlBtAi5HndJcc3L1J0sTSYqP2U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCPYmtzgKmsFWfCV4fThIaREF2smz0CmhGy6ZfItjEiw&oe=6AB68500"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gJrL1odgUcQ7kNvwFNGSUp&_nc_oc=AdrZU1Y6lzIP5aBiCZWgCygSMzCQwTzaSNoGE5toCAByoP9LgxHKx4mbDRPY6uIhCz8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8jKMCcb79-zB8y0M0aQloWITclFITQpVZqgW13j0AWg&oe=6AB6929B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
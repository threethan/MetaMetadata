nc_oc=AdrU9Ot8mzVIHl_G9TvXLbciQCyLeCKCV_TQuE4XlI2jgug7s2kE7s3ZN6k_h-JSYT8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ItKfStkdGwjOE08HyMiRSGQTQFpeKcdeyoPS3jXvVHQ&oe=69E8D2C8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rceGMMgP4CEQ7kNvwGaTTJ1&_nc_oc=AdqdP0K-r4MKOCXv0SaYo48gempcggZ5btaZURCvxOM-ACXCPzZhjnw2IgCK4l36aBU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cpPWDVY14pCrLpoabn6Rvlu0giRFd1ma8RFr8_Q3UIQ&oe=69E8C40A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUbruRd5cXIQ7kNvwHeFbtR&_nc_oc=AdoAzt5MREFFRqs503P4yFInP4GQBk5U4YfhvmyYM_L5ifG-e-hSJYy4_sb4rwg6IFc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GAwF-S2PgePcD3IKFp6zuoOZFhGfu11dNuL-VZTQSVQ&oe=69E8C419"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXjDUj6SVsQQ7kNvwF36c7C&_nc_oc=AdraQ3a_uOOmrhGzfG6VyoIXUUvHW89liMdOuFQ7hrAbak0I8Euj4shEC8dllkJUcWM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RQzm_S8NXFhnKQTNCjgDO-uoJFtVS8UpAXT8qmAomlQ&oe=69E8DB00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnnFv0vDiWYQ7kNvwE7s6pV&_nc_oc=AdoYF7C1wovjvdYAf1ZJQjI2JgHSNB9fA-BgdVGuEtSjh3OaJlXEADRueHkr4jTRbEg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dhS2liL_Ghc8zWluV1PA-oPikYCkPia86xx58bB1WyA&oe=69E8B05B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
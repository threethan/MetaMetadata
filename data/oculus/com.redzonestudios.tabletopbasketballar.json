nc_oc=Adrmtanx7ezzjzvmOJfJXs7ZnNA88u3WCDV_LHDO688uBY-Sx2H1TWlfbbnobJ4Fc6E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aqGqutvAOVgf6cVTf7Yvx6uskHQitkhOJPWGuoy2nQQ&oe=69D3BAC8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BS1Jhv1n7bsQ7kNvwFOTlxl&_nc_oc=AdoN5dYfES0UAZmmcNGGBgSH8fOfO8kjk_xPyZusfpuG9URDbeNX6wzjwL0cJ1sf2io&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RB1fv39ds-1RvpA_mV9sIOK_wJBLPZgArb41S2MO4Jg&oe=69D3AC0A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZymXllXEPgQ7kNvwGEuerM&_nc_oc=Adrp7fGVtBys2gHi0duWnOU6r07v91WTJOoZ9-lUN4igyVRA6hysDKWvdzaf4zY40n0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KPFQ7dnCaOv2gKdrXsMfnFZjQ6A21Ja6mbVlxWfDIzA&oe=69D3AC19"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jud6MIa6BlEQ7kNvwHs8BK_&_nc_oc=AdpA5i253T5K0v_gGUGUpy9-GxP_aW4FdoUSpo6saHOoAj80U3FjitdO1LuVI8PMysE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rjR0QJ17EleLLu5dnO5wLN8JgVbBCk9ZVSORXGUCB1Q&oe=69D3C300"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sgJfsolsGUQ7kNvwEist5b&_nc_oc=AdolsoNIG332VszBVZmQ8cTMaldoj7dISvD6aQWtf9md2BWZtpUij_NUEgD3-OUfPgk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZAn7TsBP7aMULjbKO5lAqOcvUJmOr43CK1anw07J0AA&oe=69D3985B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
nc_oc=AdqZS4dTfsbTaSyRi5iguS7cjDLuEqDOTOVXarmn4jv-2FqjiDsyqO9sfrglBCf0kAI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHf5unNdtxE4N6h-XGXt8IvItW_3ecRq5PWpq1Yjm4lcg&oe=6A882008"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ChRbyef9HkQ7kNvwE-STOS&_nc_oc=Adrj7iiVyXirz33Qc9c0QT16u2bzMIgr0_sh4g8Bmm_W5RxBfLx-cQf2N57p9wzV6YE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHj1oDbISR-E1z7K8wDFyTpW_CglOMNp3E3HMi818jjRw&oe=6A88498A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAMfmRrErd4Q7kNvwHqQrOo&_nc_oc=AdoCJDkyYt_AarMQM0QxOLiYW65oWP1CMM0ECitGY8Y0DV4-bUkKyfG7psfhL093Cnw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGE5Dkkp1ox6Oe-LrOQIiSiPhwHUjPN89jQXV-JYARcww&oe=6A884999"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sqa2Nyxq4KgQ7kNvwHa-sHD&_nc_oc=AdrV5d2hxIGhwc0azgXt3gx-LFfQeFUPbY797bEImkmhvU3uIr1H73js9aU5iZcykhg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4lx5VXB1omjlSSejLbT_vB9r54U8aOhF7whNrKV7O_g&oe=6A882840"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVz0k7wPNoUQ7kNvwGg752-&_nc_oc=AdoZMznF14V9sKFNcXcZoy6TUaZ-he0YpyXUX8C_ZGTSKuqhbor86EBmg7duhuKr_LQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFDUx3qn8dS77ulMfXK86THcpJvo5qu4M1EsTjYpW1ug&oe=6A8835DB"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
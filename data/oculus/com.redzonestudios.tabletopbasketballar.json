nc_oc=Adr4QHCY0pJnovrBXI98EY1Ha2wZegwWPeagjMmkEbClbahOeuoEkOYPd4dAAeFy9YE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-X4gInkx0Xs1Idd84AyEqmfGHglIK2Flpzh72SwI_IQg&oe=6A3549C8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXKJscwBK_AQ7kNvwFEtFxw&_nc_oc=AdqpFlvHo9EXF7x1uLq_S0KIaigC27aFyyEP2Cf48IHiYK_Hyt137CoIOxMRvGFXohg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wpXQ93diPaBLFp15cPPx9o61siOTLzny8fNjpYvs0HQ&oe=6A35734A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohKVi3Xk5_UQ7kNvwFWFgY4&_nc_oc=AdpNkob4ZxTde1HHp9LHvSrWwlSTVUk-vrHHX-Hlka25pSO9_ZlJmd4Nroyb442MHII&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Y0mEzG_4Llvhl3QOBcWE0TFIUVHI9HIhmSuTcpXmMQA&oe=6A357359"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilGfhVBd6hwQ7kNvwEl6-nI&_nc_oc=AdoCG7MEjEBxolcTjITZgdGguDwztzxpFjXeUTRq_-Fs7vdkOlQEISuD4amz9Le0pTo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jiV7stcgpMqEICHvEa_SimeThUMRf0hQ3ZZkVzySExg&oe=6A355200"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zV5ZP9A3rQQ7kNvwFmwipD&_nc_oc=AdqHfJLVxG3nTeaCtEJiznxYs1Zcm1DPgNgusGEGFQj1fzpTlr1jvHeDK9zFRklChck&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VDGtBjl6YLEe4wE9H-d-C9vZ1FLX6MtOVKhY9ozvoOw&oe=6A355F9B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
nc_oc=AdqczPf9PuEDBZrGZeaQKAn4-MbBQC6zb78p2lVGVilhBqUVjRW7BbIQwYsv_UyWHAc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1hhZ9hg-KyQKEFdOxOKi8eT5euywq1KwCksO1lmHISmQ&oe=69EF6A48"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgjKbBOc-IcQ7kNvwE_Md2L&_nc_oc=Ado3KwyFz9oEB9PxcXPDrqykkIt08GlSr99LGOpxTzjOSZgSXGUm5T1Q9KT7RbWUXMw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Y1wT53I-gT6k_F-loNJKn1xAwoUF_l7iKEtLadsLvbQ&oe=69EF5B8A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8i5MrSYJqUQ7kNvwGoe3r2&_nc_oc=AdpV5w-0_UQpKHfAKgCgrR_nh1hPth0Rjt9du3ez5TMwHtj-rP3ZB6D-tDYjAiIsVAc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1bzkjug0X2r9TUhYB1_az-aBT5yCY1Kgigah8lVu0z0w&oe=69EF5B99"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrnVhOB3POMQ7kNvwHX0ajF&_nc_oc=AdrdVnrmfYLkdpG_j7kao-C_HSGwOiBXdbmXMvueZj8PfGL7qlFncLDNWLDoYoNrl0c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1aut4McJjbJyeJpDSUv8wVaKdFOlRu-6alYmOnnh2S5A&oe=69EF7280"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xa6fXrRH8LYQ7kNvwFjGfLA&_nc_oc=Adonexg7Nds6sDfHOMeQYhl_IiYsMhR5WlF_B6r3sh0jmZr1gqSBxTsDip-GbMFMbWA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1pe-u6JLcnc21jG6su0PTowWmibrGh88biYNhy-Mf9qg&oe=69EF801B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
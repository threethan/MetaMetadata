nc_oc=AdoPBxkLn1gxNGXo9kr_nJgd11iDlWAbmeR1bu0kb_pNV531GA3iAvAorgnelAIiF8Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzfPLkeHDR8yE8TIFt9m9RmEmPk7glg47Py0MWviXArRg&oe=69CD2348"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UneWcq4hAj4Q7kNvwGOoK9q&_nc_oc=AdqXOGxQqdh7j6_ehYDczZvlaRDfHNdcghutxSyTPbQBuePu1u9UXc9XZuNNqh9oRko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzNg8fCQYBf71_L2GLiFFdSV51Ahrs_FuMExD2QUW36sQ&oe=69CD148A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGc_nlU-oXUQ7kNvwHyxI7B&_nc_oc=AdqXGhqXKscwQahkXnRDBu6qdfKdHRcUNDlO6YXAXNNn-SqyIV7M6ddnba1QtDymps0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxsSrON8iQhKnlY1edH1E1aWRbrvLLZJ05tdYv9_B2Omw&oe=69CD1499"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQyP9ChvJssQ7kNvwHU53aq&_nc_oc=Adpw5imFJ7N_a2DwsNG08BXPl1Dmh4XvDAp9LqD9YIxNRKnwnyn-_h38ljazO7QWnuo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwm5JofBkyGF8N5nUiT9SNpgy32f4l5m6mjkxiSYzXgqQ&oe=69CD2B80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STVMLiQ5I08Q7kNvwGOZ5hH&_nc_oc=Adoax6TnLSIg3RT5Owgo3PsffXhhmIr7PuRaFKerqZQDsq24DLRDBJwbyrSZCEhDsi0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzLqgtkYqKcpr25Mw8aYVogPyNo2FpqzgVKmFs-WIqbvQ&oe=69CD00DB"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
nc_oc=AdqIVIKsBZtDAQ64o1ySYJBVVAy9rnIDZIVlH9rVLG6rkvnghqn32vXJWc1T_pjqQWk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Ga4-hzdzwuEfIagWNVDl4ec5pdKEL7tfLgSIj3NGHMA&oe=69D7AF48"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eepn2CdvZakQ7kNvwEd9Z9q&_nc_oc=Adrc2GwlCZFyb8EUuEp5V6Ckf6uSaGgJorCQXs92ukmTnsYrJhbbbfmZ_WEqN7XSuzo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NB_iqfkAp0gN27RGYB2BVcuryJtKsh4g-8-pzC0k5xQ&oe=69D7A08A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2TF-oOJszcQ7kNvwFMGcmC&_nc_oc=AdqkHL_E5_pb-CjOqvNJCKpR7N3sD6wcBOwscm4Y0sV-2Xg2h2SHkQaoFmtl4vPWh_4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PCzQ98vstIlKKQv32GjBMa9TLnunQ51FI6OANVgIFvA&oe=69D7A099"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_n_YFcAqa5QQ7kNvwE5qAVW&_nc_oc=AdpnXScSaBlHdjn_wru8ByMGYkAAniTH2LN0EmbGJhREVKdKZdBNEbK8QzpI0mhkSGc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ofgF6hSFnVh_c-4TvxjqSeGRy-_YoEnsfG0t4IIRt8g&oe=69D7B780"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JamnJcecfYQQ7kNvwHhwrF6&_nc_oc=AdrEjApH6RzMfDzWAb3MtglWTzisiiheOiJ_HZ6W7romdrdPD4I7zJ4tb4SV_b7fdCE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1upa2lTXy50-udt6a7QuC1VR43Kry3bn8IBpM75PWSEg&oe=69D78CDB"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
nc_oc=AdrAOj0-x4dSGkvaF31DA3QiteHA7gQCnxP9woRFDmapwKv_I3aPTTKEcX-6daJyJ68&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEwcfq-QuqZjZpXiYDlsn--mydyrvB28Fn6VSk2ANLzw&oe=6A50F948"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUfQEdphqAAQ7kNvwHLjh-j&_nc_oc=AdqoIk8vWev6zNnV7GVe7muOiVgiqmd8Mh7LSyjh1YM357hq3HkQg79h3-WJCvutD84&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnnvmRk-vPi2UWMNr_H0p1l81fCgorr3bkRGIuJZBOsw&oe=6A50EA8A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ad9Pg7acxzAQ7kNvwGb9PWf&_nc_oc=AdrbHVHiLDmUiqDuZ8m6r67pBVrrKxsGdbHL4EbAuUyKxCB5-7d4qrAeEJ5sMAN2lQ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIrp4c3Un696hwUv_jluo_0xHTi-sYbIPkFgJzIKvrGA&oe=6A50EA99"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOIvOegWVjAQ7kNvwGGwqqs&_nc_oc=AdpAL6NkeHDEbAj6riSoGim0WokHusQj1Ptvu9sm61Msr4wJuDARHo5efnW0XdMWLgU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhU50uQKLBq_eJ06rhiUWlSGTaZ-bEBxKIrWLUoiGw6w&oe=6A510180"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSxqZPM4BIsQ7kNvwHGA0Fy&_nc_oc=AdpESmLljC8WM6eAsXdWz5GWqaBJcJ2wy0Aj6_yaXKDw4CYxNdE2VmuGjZsq1qrffoo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJU_sSOCyrJ4eGVAHNkTHa-4MfhcEEUUI6E1_KY-JQmA&oe=6A510F1B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
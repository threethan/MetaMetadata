771-25/38974868_885479802728438_8711661268208378868_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-h4PoGUAvYQ7kNvwFBfp5K&_nc_oc=AdoVcSftXX8oOxNZAwHeRt5fFJPBSfP3O6VT7DaU_t8ai1Cm4MFcptt7aGgr9MLXNh4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3a6nBMX_hGD3PMWwxgHkIsqZhXQJcT5Ztu9JN_JyhpA&oe=6AF9B948"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBZ4Ntj6PbQQ7kNvwG5sJ2F&_nc_oc=AdrCxwjR-BdsBJbeRcXkIoagb0U_eO3oKXp-sX2dMs4WtAzRix9msaT9fMPqm7PUWZI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgej-cAq2itSVVhkJs4uZIQZAEiw5Ph5d8fJsYA0jGlA&oe=6AF9E2CA"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwQ0bmA2a60Q7kNvwH2FnNy&_nc_oc=AdpKXcig_0DrmyfWzivHK--Wsk0qBV3S-eVUyf1dcohNvRuVCcZrempDVAlxplwuj7k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLPttwEG7Qlfnle3DRHOvFpDaJ_SdY4tZx8QJ6L0NSDw&oe=6AF9E2D9"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBBtPHYZhWoQ7kNvwGBsuAW&_nc_oc=AdqV0Q0cEtMiMrZ7tCZr9VFT36LRy3RQ5HpA8TvA9UjbW1WluYC5CbwYKPRI4MJnkbo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREs76rxTyFb2gswE7e6fWqBksScbYqd94fAFA3j0nLCw&oe=6AF9C180"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0g8tnzPIhWUQ7kNvwER4Hmy&_nc_oc=Adr21TJ6iEGsdREUPdrSqXzSaNTNAbtm9pb6128mFD-XCHl3YJEfOsDTB3NvOJcmOhI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwBrKEUj-PhXUs6H-CDvno_OtLhKtzYuOZEQ1j31UIiQ&oe=6AF9CF1B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]
nc_oc=AdryRi1_oQIQZg2Tq17xXYUDQaxjN1vDpMtirKc4fiYcaJw1Gf3hFvbYibwSCMEpbHY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qaYO8rBBqU0V0mlsWKv15lOANKOq9vCUo019toWcdYA&oe=6A072548"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HV51BvzMKgUQ7kNvwGQPaeD&_nc_oc=AdpfUmQTc52GWdE8K4bPQ-dnkr8Fcsoykym6CAKwukhkWlSVWPlhC_7sRyRChxrbNmY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40oWvDTyXsN1V3UDdFBCaJanL0YmdsTP8ET4kKujKvUQ&oe=6A07168A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rspksvD6sv8Q7kNvwGfSbyr&_nc_oc=AdpGB_p-V45aUiRIJyTXXv5r5ixvNxmy46avnuLMraoykymQTPmdnBuOzltmC1aEqOA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7G4DD-5MmhP6dktQUxVNAExDfya7fKFYjyplEhSmZJjw&oe=6A071699"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJbmYUAKHvwQ7kNvwGIbX-7&_nc_oc=AdrkaLbpBGrbhMvplBsJwz-ytWC6BYguhuwjqfs9UKi0tMOfXKmKYskHiloykd1fj1I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X-iTOWKgxJt62YYcqh0L6ciC7UtbiEI4eA7azrPosKA&oe=6A072D80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGMplg1s_McQ7kNvwEVHa5t&_nc_oc=AdrM9TdEg7uV-gkRlxWv0erevBOjBRiP-GJGb2vwx8whFC3wSE8uOytqkokt0RUrsFc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EKYjp1okWlXxFgokxfE3CvesdUp47Mm9_fQG13fVV9A&oe=6A073B1B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
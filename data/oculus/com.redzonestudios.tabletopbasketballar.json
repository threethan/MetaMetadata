nc_oc=AdoBFn-bPGfAUmjIOb57wkuhaDL_GU4uzeRfExWEbHPwIJxqTQOCTA_DbDYRW4JU86g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEztSQCqJaVQfz3hTKa6QtCMmvEqSHlmy_eu8FnyXwhvg&oe=6A7734C8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-z80RVPG04Q7kNvwEi6lL0&_nc_oc=AdrBxOe-xarJaPXYY0Kiy86Q-HzYyFaeAXMlDfSGtOsMXOXeczrY3eHYJxvWQ_0_Tss&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhOKqz1_dghD4pxq4fcOEaHmM1iw_UWAow9O46Ze45lQ&oe=6A77260A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjIOVkA4fKAQ7kNvwGLat_e&_nc_oc=AdrpIvSI_13Bu6QpilKR9lPFqyx10v_cBOJWy8TjvHodCepCb06VFiHIIEQN3ckA3NI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEL0JktXC7VAJqsrwdreutu2qgK6SoIodrzFyELoFWoWQ&oe=6A772619"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsFEq9lhtTsQ7kNvwEe_RIC&_nc_oc=AdrhbMgjlN7DYw26vMJ2C4uqwIyRGek4NVrEYiCoYECLc8HciOXlXBzJB_728m_zi2U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNQmhIsFvdYLAPfdqci1lKZcEvXrvaVHKtQsaJ7Y-rqQ&oe=6A773D00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAFcrMzaG00Q7kNvwEowKX6&_nc_oc=Adq2dRwlHkQ7yZolu_OZEeK_e-Qy1fb5RhZGbIIj2JCujaBd5f_qwbYIOXwV43YuZVQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxXvJxpYAY-tkwR25zYQbDGI65N7chrkCKJkrrpx511w&oe=6A77125B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
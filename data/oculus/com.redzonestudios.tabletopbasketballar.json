4827_2467222335025785377_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OssmHRYlM70Q7kNvwGcAjQA&_nc_oc=AdqGFD82SHgfy0Eoaj_ByaI-ngDwcNg1KRfOzgYVadAhBH5ej7RWd1epSOFYo_HnCq0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUY9uRtB-L9HILrVT3uVCxssXBc4rXtd6paxSMdO-5Ww&oe=6B072196"}, {"file_name": "02_dunk_contest.png", "id": "4438452576471082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/737543484_4438452579804415_4036581323980903547_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBGfXc6H31QQ7kNvwGWZmfQ&_nc_oc=AdpXyOzcwCCQyP_uCp10wjKt3HwKrNgAHhLG2MVDMNjy_v6OtaAfNwccf_a0TEJEvgI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPpixzOfsV9ZsOnGY6BmmTyG78NJXSvvAOtgX6ATEFyg&oe=6B070EAD"}, {"file_name": "05_head_to_head_online.png", "id": "1107916812074513", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305071_1107916815407846_1407786425748949605_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=am3JdNRCLloQ7kNvwGaCyBb&_nc_oc=Adr1A8xVR5vLJ4_19Nm-2EAnNcO2WE6R9In5jkSYn2VnQJN5hIxhkLdxrSGloKWd9-4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQJU_uaRE4vGoUI33hx-cKt63G7KMKKsMTWRYEwIF2jg&oe=6B07204B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2330923250815083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_2330923254148416_6822919021501646119_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRnneH_ThkIQ7kNvwEiR05A&_nc_oc=AdrOpjeCjWX7EC91Xn2EI6Atvf2pB2u8iWRIkNH83q7cu5yg23m7Z_v7UyIzC8ZU6lo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS9l_8CZsy6dOBGSs8SkvRvjOASfDMMpEkiuD9zZIPuw&oe=6B0704CA"}, "display_name": "Tabletop Basketball", "keywords": ["Basketball", "Sports", "Tabletop", "AR", "Multiplayer"], "long_description": "**Basketball on your table**\n\nTabletop Basketball puts a full court on your coffee table, with players about two inches tall or as large as you want.  Play it in mixed reality on your own table or switch to a virtual living room.  Drag the court where you want it, turn it and size it to fit.\n\n{28449105551435844}\n**Your hands are the controller**\n\nPut the controllers down if you like. Pinch and drag with your left hand to move. Pinch with your right to shoot and let go at the top of the jump. Pinch your middle finger to pass, swipe for a crossover or a spin, flick up to block. Touch controllers work too.\n\n**Five ways to play**\n\n3 on 3 is the full game: full court, four quarters, fouls, free throws and a shot clock. The Slam Dunk Contest has ten kinds of dunk, set up off the dribble, as an alley-oop, a self-lob, off the glass or from the free throw line and five judges score each one. The 3 Point Contest is five racks around the arc and 60 seconds a round.  Make three in a row and you're on fire!  Then there's HORSE, and 1 on 1 to 21, make it take it, win by two.\n\n{1664442891657873}\n**Play the CPU, a friend or a stranger**\n\nEvery mode works against the CPU or head to head.  Play a friend with a room code online or in the same room, or find someone in Quick Match. Quick Match counts toward your online rank, from Bronze to Diamond and then Legend and you can talk to the other player with voice chat.\n\n{1758580961917744}", "short_description": "Tabletop Basketball brings the excitement of basketball to a whole new scale!  Step onto a miniature court where fast-paced action, skillful shooting and competitive gameplay come together in a fun, immersive basketball experience.\n\nMaster your shots, make incredible plays and experience the thrill of basketball from a unique tabletop perspective. \n\nSmall court. Big plays. Endless fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "RedZone Studios LLC", "suppo
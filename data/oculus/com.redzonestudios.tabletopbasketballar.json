Hlv&_nc_oc=Adp33Mdr3WpK0gF2JnBsbLcTGYDmAcbrIKIzb41z1QkweWQlFzZxJTljPl14Up_rgFw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrxPS_5eeQGPw23EUlD-P5WPQQ9mI8uxdJp_uKX7_jtQ&oe=6A8D6608"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGquDDocsZEQ7kNvwGg_24i&_nc_oc=AdoEQ__xSxW_WbqNdO8_MVLDUdWNC8Zyw0JxaLGqdKn-70hhVpjMxZV-YqfvQEcs28c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUlUvo2I6TsSEsY1K5vLIpBV8ua98zn8F4RBPmgGqmuQ&oe=6A8D8F8A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvq0Cq-HI2sQ7kNvwFUacb5&_nc_oc=AdqmRWkjNd_uc7kM-Bul-bzZbYaHZR_oLkLUxU6Ebv5K72WP5CRCKNZkNwoiwMrS_zI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMC5YKRZccbgyk3KOHhYFVaK1EuxEiITszxjN_i77GoQ&oe=6A8D8F99"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjehTSsHlFkQ7kNvwGsv3zm&_nc_oc=AdqN6xdilZFJk5eNDMzhsp9s_XgckKU8uhZOKIsxlJxR48sOIAMQ_Dvz_CShteUxsvU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh6FboawWseV91PVWPHOiQOhXyq4IyJlRu9NNkN2ePdw&oe=6A8D6E40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWZi68KLvvsQ7kNvwEhIoft&_nc_oc=Adr1RVWZYQNJMDU1r6AE7O8KYlbk1k5Bwdkj33wuroyirlh-iDEHoODn32FdqQ98a4M&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSpa6DzPSRUvDZBzEYl9OwePIWe8WCjhshTUKX-S-FfQ&oe=6A8D7BDB"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_term
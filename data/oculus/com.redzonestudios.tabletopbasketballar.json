nc_oc=AdrCJ4EAs0ZORzJEeKNHXzP4LGv7CKFA67jr4-nkkd_YG4uBSLS5ZmM_tmZK9hca1I4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPwU3B91_6xfE1oY4EVuhueNCaPQQIJ7yyaqBsp4_iqQ&oe=6ACE37C8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2YfXPxApNgQ7kNvwF29-MR&_nc_oc=AdphGW4JHHXeHlKtcWy3uu181GG-vIQJg94g0dVl3UcQgZEphzSKHciLgxvUP4f76Tc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbWgEIAm8deLhGzPHgTMY9LdDlFfZ-42XiMNNjyEjeog&oe=6ACE614A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKeBKtVuXfsQ7kNvwF-JwPH&_nc_oc=Adp7brrzHiAbVoq7jHHvU2rotliZWVBzbXs4FyewBE938JpX9LCTQ4nnYLcbHPYQS-M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9zL6sFrSrZT50vPOURJ_Go-gMYxRSa-Njrp0X7NEcBQ&oe=6ACE6159"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CANWeKBLFKMQ7kNvwFP0_zo&_nc_oc=AdpYqJjgdWKFicMJiw4pIRRkncp3deLP2ybyJPt-mCRu0rvf5S1PDAPlGBEYOlyj6H4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUDilEQbyMpCxwSZiKO7T4ZcLgOm4ulpEWPwSquazCuw&oe=6ACE4000"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqC4h4FYWj0Q7kNvwHkp9T0&_nc_oc=Adr5ZPSAt73RvmUeNVS2lo26bdoy3xpRyfBRIVZB6j9XU8PVLUUmrvuRCTTwxhvRoBM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPR-JwNnNWbPD8Smj0EIqkXQps2PPTVHdVm1bfXcHdYWg&oe=6ACE4D9B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
nc_oc=Adr-Yl8BD51nvJk_ZFSHLtUZOSh8eL3w7gw5jQ9n9z3UFd6US_yYG_DE15_iQGfl_FE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4hM5832yvAf6JqTnvuS8dbkZMmpMh65r-RrZ16ndEPw&oe=6ABD1448"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bieFNf3oZR8Q7kNvwFvPn2I&_nc_oc=Adp3AD1N3pRymNDxhDvhFtu_RSgw8A9LJ321I0wOB9MihCh7lkHa55l7eDAZqYUdzzQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKD6Klblk7uCTm9RHiRDNzFYsQp0o9dLmoA2CSNYkmDKw&oe=6ABD058A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qx_AvodAxNkQ7kNvwH-5aPE&_nc_oc=Ado6unTDhMfH6C6kwr78kTUjOLgD4sk3VRZmZ-n-LryiEhv7JYpM0cJtelP523gEBkw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaB6Pvq8hZbD8nyp9gdPMj1srnIjwyg5eomMTzgivmUQ&oe=6ABD0599"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bzr5MFeJ_0AQ7kNvwEO-ffo&_nc_oc=AdrJ_2I_LsgYkX8Ac0OIujvGCXIMw9uEQlDVRnuff_wgMyHKIVE6L0W59IAOlNHF02A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3sqA42iZlr-a4FqHJwkmxBi46n9poYbudYRd1oZWdmQ&oe=6ABD1C80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YclSHJiTHdMQ7kNvwEO729F&_nc_oc=Ado_WHrHBXprsUsjW7tito2wn3pHxPZnXxIVqXfY5M9i5o1Np6cZoOg0jYufMEzwYAI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8hw0yLgWm8Mi2tST9pk62ShdCIqoTRT-q4zb69mQSMA&oe=6ABD2A1B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
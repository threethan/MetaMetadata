nc_oc=AdqZgxPo-2s1t-u66MyFeJA5pHR2NI1GbVBCKJoDL72BcLwJOLMJPMes6j8n6APzK0U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pGG1BZBREsjbURpAy-BmO3wMBYp6A3EvF_KCoEEaCQw&oe=6A0330C8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spl60nxVQJcQ7kNvwHe9uXZ&_nc_oc=Adpezm-XvzcGG-OEIJCgzMrM_0v_NUFtm-MrJu5Fu7EjD590HDZlkZioG-ssZkG1Jko&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xZ39AkTQMN2ZLjA9aTlnUPGik1hGJp-uMc4MpwtNNCQ&oe=6A03220A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqhh5_MLy2EQ7kNvwH-4U3P&_nc_oc=AdqnizNYbgXG_tAMRy3trGhmqhVEiajaJIjm1UTxPejet-a1WjcvgsYgDcDWHgTswYM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66dloE2wYSFLGQTy-sTMMcqhUYSZoOrCmiE3UevLPsoQ&oe=6A032219"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ii8zpxgh1NkQ7kNvwFFbF5Y&_nc_oc=Adote39pXkFlBrnDq-mXEjGeTigSkq6VEPfdIGGJylgeRT8zHFqi2PJmb9Wrs61B0MM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af530Vs5jOYmfsJn1E7Wch_iT2vKB-p5bWAXbmZA6HBntQ&oe=6A033900"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHPTi3QSyNYQ7kNvwF0DFyl&_nc_oc=AdpwBRoG7yGxP8jLCvVu361la9Iq4xt7NuFfnclB1PDc0KZBObjtz_q7a1kyPMpDWT4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Sd3y6quPJxzDsN3qmkpDmIPrHTDg9zmFFxi5nPPXkgA&oe=6A03469B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
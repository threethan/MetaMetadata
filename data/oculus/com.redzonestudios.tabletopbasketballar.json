nc_oc=AdpUq9wJJuAe1vxe1ZFv2EH5J3Nx63zpzLm9NrP2LCIugdj_YqE9NijYXfsugKO1MZI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEf1BWNMo0ybBB6too5n0PtDKJWtPrf64ax2pWR4bMVA&oe=6AC7A048"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23dM4t9dCTEQ7kNvwGpdPtk&_nc_oc=Adp16rsyA3vvb2GrVMUlHa30ot7UvNnjivrIFUdhKhJf2TGD_LMoVJ1vBFmjrkotsvc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMknmxYdsBuslZ1ZFkUDVeMu_lwfkTNGZ0ry4OtKSCd8g&oe=6AC7C9CA"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9B6KGDB0YQUQ7kNvwGuak6k&_nc_oc=AdoPyoPC2d551Ie6PyN1GfKEgVRAquRaP_YT1O3O5CvkTMSLbaoU1aQnpwdiyxMBHMs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFCht78v7tR8LAb77eXYt5MgIGIrX8tvjudd64P3ubOA&oe=6AC7C9D9"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llM1O4l3fqkQ7kNvwED0Td-&_nc_oc=AdozasUgf5LFib8_5hMoXdwog3cB3FuihRTZWWOHk4vpB_yWwLyasEbFYKZx3qjF4yo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeS1v82WraHt5agDgIvSa2L1wk0floo4h46oq5owS1wQ&oe=6AC7A880"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20ylmk5nKHYQ7kNvwGowarp&_nc_oc=AdrzBGOvJ3XOTA8WmAzEfi0tA-8oGTrTpiE2qMTfbByEEGVF92-ziQGaAklnr-SegvQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnaGxxQvnDoYL-nAWvD65phqAP7t2XeUuuyNuY0bA7Pw&oe=6AC7B61B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
nc_oc=AdrHC0ABc4m453kyUHPTPwzZxvieDUO6oerkgN7aOwDTVqKrsyOSU-eZI4BKNzA1pIg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xS-G7UncF4e3Uti-20eIrmKAbBr5bYAiog_0Se-TK7g&oe=6A43CA48"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQbfBwR9s9sQ7kNvwFXrm89&_nc_oc=AdqC4vnL1CbrTHi9jzO-x-hRKr8FE0qTJFPAL_M3rHG-WanSCc95SmyPIbl9FWQRQuk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DD9lMw89CXz-jRePpDQsrw4nDh4SthKjw6XA546Z10Q&oe=6A43BB8A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qT5o3YBfka4Q7kNvwHvEfHK&_nc_oc=AdqY04NNp6wHeOwwkHoU0844Ged1kN8SyI86kTcw-0mihBVl3w2ze0hrfC4lOcNA2dM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PEt6WhILFkY0f5Q2-HQf3vfDzr_mHiRJH5AyszGLVaA&oe=6A43BB99"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zam8k0xVix8Q7kNvwH5zOw7&_nc_oc=Adrrq5qRufYiCgUmW5LTQmRnEh3nAyHaQHAIlaGsamYkcqoVLLDScnJI3vMcAm3QTWA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qaSFq2NQpwrntlkPF4pIcp2MuPHhu4K3nRQBDPDd-Lw&oe=6A43D280"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeJ8ejhyTAsQ7kNvwEhdt-p&_nc_oc=AdrMdMvNbdiWEexntOJY1lXMNVhrTRq3qL07YyTGuwAZlGEL07Ubhiti5vMNIZyMtcY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MIFlHFrVuQsFLsDXr0CvUF4NlIce9RYyOj1nYtE8R6g&oe=6A43E01B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
1.oculuscdn.com&oh=00_Af04l1cu5HuM4SKv9raCE_fQceQ9WgxCUuyfWxveMwVeug&oe=69F0BBC8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcSehRbF6cMQ7kNvwFQdOu1&_nc_oc=AdrN4psclvPB0OQSji-Fin6rQMDmw1zn8_0xtgHj6RndAGX0oWaLC9T1tD8U9dqMYgo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0y8OMVV8urkdhfu9bZf7rscPWudhUFkx37VSGseaTONw&oe=69F0AD0A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8i5MrSYJqUQ7kNvwEnHKWd&_nc_oc=AdphX-x1TJXv-gEZi4RXa8632J68UBpOaGLN4u6nt_REcP9Vxc_t50I1AVFw0m14DzM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3UKl8cYcLCk3e-GWyDzbEKoigOPw0hWIQlh1BIaS3ANg&oe=69F0AD19"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDzCp6KlmawQ7kNvwFusLLF&_nc_oc=AdosD45dwlrsyuBMai5F8jVYqk3a7vEG8Ol6gewntP9iwd-TfOHl7VmYujk359L9Xfg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0iSpvOKVaWD6tpsVmFxf14iuYTAjKopT8zPFkFHHmLNg&oe=69F0C400"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xa6fXrRH8LYQ7kNvwHPggut&_nc_oc=AdpvuZNAQBxC2IQcDnQ2m5fxjSKcTVUp5vTTEHFpZdFfxHhHsNXiqRScDAFfGEJVRe0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af37ZbiYx7BdJTBOveFppKASLUlloe2ZJcuESXLd3GskKw&oe=69F0D19B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "RedZone Studios LLC", "support_website_url": null, "website_url": "https://www.redzonestudios.com/", "category": "GAMES", "comfort_rati
3.oculuscdn.com&oh=00_AfsWVZvIFBG_AFHhMTxrJ4JJTINzS8lq9stGwN3fG-B1Lg&oe=699B0A48"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZ8dNyhxq0UQ7kNvwGoU36b&_nc_oc=AdlGzt-89qEB2ay6Gt7Khz4B_4IAUCTdMAAn53bRM6EEOg6KkBDSzG9RimVPnImkKl4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftCMmqEJJ8HdNb5RtKvEZ4BBjj4mJpNAaUQzxl1JlNFvQ&oe=699AFB8A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n99-tkFSI6oQ7kNvwGtGsTh&_nc_oc=Adm89OR4xKdhWJkCh2gP36PoQqbRK2bs49ZnF9rlfFheWzw_bY4MWCWYTETl9_xxSpQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv1WLhnBjRL8DnfR-iQ7iIky-xwNBwXPFqn9JlIi0IMzQ&oe=699AFB99"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zk6KoPIE2CIQ7kNvwHxHhGj&_nc_oc=AdnjeQZKy4ndeb8RzpDehMKfH8WNjO2Gf8ErBdAOHn6ofatT5XwSxxyXRkMEUtd-Sg8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsHaQP1f8fmO9-soezpAxv85okeayRMwaPOhtXc7yeK7g&oe=699B1280"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObpWv0Yc908Q7kNvwEX3uHr&_nc_oc=AdkZjV2TqAwklluQb_PyxIQZGuuBc3-P0mdVKAZRCFGPeRVm0vlhQpwtu_Dw2nj7Tx4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afus5roc6ZQ7prs9ITQyRSgW6mrRGiwuNAJcRs1r76XMTg&oe=699AE7DB"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "RedZone Studios LLC", "support_website_url": null, "website_url": "https://www.redzonestudios.com/", "category": "GAMES", "comfort_rati
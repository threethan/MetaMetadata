nc_oc=Adpo3_L7h6K-jaezW6gG9i9-I4yo5xJbXMGWclvj3IQl4cSXSV7W7xt-WGsNi1aUOlI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyEeO1Ck4eIWBG4_deITYgclyXiz5lP-OhaJ1dfjNGNQ&oe=6AA6AAC8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6Ln4MEbhYYQ7kNvwEpoyF3&_nc_oc=AdpEVvF3n9KVEPgXdqfjGhe0pXav2RiznrAtlYtVk9ePowRnABDLlyZSMfjaEd2kBC4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0INpv4SKKvPOA21kyAq4hJv-dRrCwNPCggLLrw0C6yQ&oe=6AA69C0A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kc5E49L4dk8Q7kNvwGw_fqM&_nc_oc=Adr2HH9zoAUuJ9qS11r6PDfqlrBqnfbevDi5-yRWN964P_On3keTTTPQAMvnN8euvs0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQIxuqGocEOVccxhxadwMnimZy0d9hvNupoYYpBU612Q&oe=6AA69C19"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jk_wsrlkrEcQ7kNvwGUSDLW&_nc_oc=AdqU_nUfn8hzBGE5ytfQBlARyGeYjsdSvT6Ju7FqACL06hQ5IUbQtAb2hTDAM4BCgUA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgJdE9wZholkSBTNDNxyb-gPhAyCtnT56xeRGHHwjjGQ&oe=6AA6B300"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3zGy49C0WoQ7kNvwFnkXl3&_nc_oc=AdoZ7dDBsk7YEgsQWPnaIRNDMfLIYxgc2pI6d54h1y7-g0t5skAdbetIGBi7GZW26kc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhFqwYK6cDdu8i-ka7Un3n8uRbQJR0-S9Xk_DdHytbTg&oe=6AA6C09B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
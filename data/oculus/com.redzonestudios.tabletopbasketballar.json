nc_oc=AdoCeoBn9aqhlXGxYLs06aHgI_sOYbzde5-kwiugxJJWv9UynCvEjrLimDzR4Pb6-rw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2-rarIx7XbJPtFikEXoDp4HR9Yf9DnsCYZmyuZhiRmQ&oe=6A9D7048"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SV7MnVB71XAQ7kNvwGTku-i&_nc_oc=AdqS5TLy-t5ua4plR49ujyeYz233oMdztTw1Q7Z6xL5V6b5Jy-836m3daML4hTAfYBI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzY5DdzkDoSpMd05gHJjuquUWnfe-wAIj6235t-FkRiw&oe=6A9D618A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJgOPMNn4oEQ7kNvwH-dQ1D&_nc_oc=AdqMfU1t5_4hMD51ZQp86QBrJql8mJo11MkBuyEa_MorVa4VHpiG5GK5fTvRzSog4tE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ7lvANd390jIsaA02FrBtak0aWiRMdSMgooGQBev4qg&oe=6A9D6199"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAnVuQPz3g4Q7kNvwE6g2kb&_nc_oc=Adqs4LwIrFykEJB-e-SxhCxD55MuKvPiKMs74qlC-EK8HM3h5txORfO7HUFmQyFZEG4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJr65z59ddh9U54a6IUNd5K5yfoZGx9U0HLNDAgYtSBKQ&oe=6A9D7880"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JayChC9OLhQQ7kNvwFPpzwK&_nc_oc=AdqBPxEkSa4REsn_Bd2OC_4nYfyePz3z7J-eTHw__Am96MftG1t_axI17wMNfsf1yc8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8muu_l36kg28TJ7FQ9zXExVGLGIeZDN_AmCqTfAjJCQ&oe=6A9D861B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
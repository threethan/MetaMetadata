h9w8R85EVNOinkp7vl-1QJndxSGIEit-WLNxpuy2k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz-t8kGxFbEHDKtGQ5nim9ko23cTH-RvThGRKcIcAO7Tg&oe=69C145C8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slUXSiQfcFgQ7kNvwEQZHq3&_nc_oc=Adqn3Spt6tcCua3V_DTYsnxe80xlI6cZdSUhKUhpnoJNutMsayyzFgCbSJDlZaWUdkk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIk4dfkurBuDq8UovQxcofcmQGl9O8Ypa4bmVSm6v-1Q&oe=69C1370A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J399CrJrQtMQ7kNvwHrxnHh&_nc_oc=AdrM5OfENIjXBpFrD4kR5Kq6eO-drOQ1ycb8CXeHajBkcSQA7MUzOUkEsXNHHFOaTNM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfySvmb32NuAsmCCsQj_JRuaDHoF8eOx4f8cm4STTt3LbQ&oe=69C13719"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaMLnwpU0GwQ7kNvwGql1O4&_nc_oc=AdqASiw8tFAmN9vebGaI_Im1RVq7gQ8Z7JeUfC94Ql50Ux7OF3VSaHW-lZVn3K4cNrA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzjyuzVKPEPZraprJCnN6KJFuyMsaZe5h8Tp0Y--VLwAg&oe=69C14E00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuccsAW8rZ0Q7kNvwFuhSTO&_nc_oc=AdpFasSP5Av4j0KtbqXJRCChM3D1EIE5tOu6Rt_fMP9EYx64l_ZL6JlZDTfGzh2IjCg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyfFhdYn_g46AqClpADmP7rFeafhL_76CrZjvpZWKmxzw&oe=69C1235B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "RedZone Studios LL
AQl&_nc_oc=AdqgMyg94QGIIulapuMl3M47Ktws-t3TsisQtVkjjSj6zLLyJkFMqUlPQdP2tnkesfo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF87oNWd7KiNVJKvGl96KpM_5SOlKEfWbhsH3UjgmM3jQ&oe=6A857D08"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NaRu9wcOXQQ7kNvwEZc4rs&_nc_oc=AdrIi8fxKHUwor05YUaGxYaiXTmVZD21d3_fxCxSibxugmT81qS5AZLgqcOsmuyLSx8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH14FIwDEayyxTuirBIyyAk44BAzD5xAkipRM5v7Kwv3Q&oe=6A85A68A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAMfmRrErd4Q7kNvwEvdB86&_nc_oc=Adro0Jj5pX7mhk9NK5ykcyUyxenV-mZGajV06he77Hy6kken9ZqeepOiqpFMQQ6Shkw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHD7N92UJrE4GnnOZZEbkxJvh5zA0dRyyn0qFYhOtAiRQ&oe=6A85A699"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-Hq1HIFPVkQ7kNvwGfyczA&_nc_oc=AdqE4_oyomI-v7kHPfHH8Cn84CljHoqai45bbU_CrGLj8qwR-GtTiWN9fE7e4jDZXe8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6bAkqgCatN188E2dWT6NhHFZ5rXDU1raokVVp8suHAg&oe=6A858540"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVz0k7wPNoUQ7kNvwEzbnyF&_nc_oc=Adqybnff-UkTa4Nwbmbu6OdLe3XVpoDe6TZwBKROpk4CI9U8xR_t888ne9IPE78gBFY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElDr0odIjjgpvxbolASXpYlp1mRP0KT0IN1EmGCE02VQ&oe=6A8592DB"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_term
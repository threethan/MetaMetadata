uv-5&_nc_oc=Adq5PIrn1H1VXt9KH0vi2cbiSVClmegF_ULsjxbnsntiGViZ4tjvMkRHxpqsvzlx934&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEU0gwsSxL-mDDsEEz4MCigoCLemqQV8rvvcLXie7VE3g&oe=6A7DCC48"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSrGFFDsAbsQ7kNvwEEL1KB&_nc_oc=Adq_-nwHsrCCxF6Mj51OL6cCF2MgQlRqq95uIv285GC4VDiXfifjHNAmllM0looaVGs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTOQXhoowalxLCAHSWpd5cuw2RYaEKQmtW9T3bZO3I8g&oe=6A7DBD8A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVhnEoJEju8Q7kNvwGGK1xg&_nc_oc=AdpVlWnc0VgqFAvi4MqItmlOY93oa73H_9T_UNp0GVfFJRsH5nqG2PRnvKCSPCt0dDI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHm0yrbps2z6VKfYHis35q0ZI-m7khv760-yuaRuMw4rg&oe=6A7DBD99"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6X8JfvTmBQQ7kNvwGXr2gQ&_nc_oc=Adqr_9xPBaVaZoGmRwe44uFteovKjLX6WUWvA8bSR-1tBeEIXINkLqrzmGODJJvns74&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6adu5wE1covfURCBBoqrERU9_hzW_WLvyMK09TpUXQQ&oe=6A7D9C40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLwicyHprckQ7kNvwGehbgc&_nc_oc=AdoRI1Vu0Set6SuhDV88kgEFKdPceRxJu_Su0Ncz69LKF5x3pyUNhFSI9PRky7crNsQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFAkl3dCVbhidolxk6-sHRq_vOVP-jtkMUzUq67AgvhQ&oe=6A7DA9DB"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_term
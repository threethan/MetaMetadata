nc_oc=AdpbO7TV3Gapt1W0f_haZEZClD1Ctk2XVprVlWLBs0ZumHW78FcRPiL2M1zI5FYpPh0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDD_mGytlrX4OmpzGWJ963wKqMaMWAU7n6PaN4OT86DYA&oe=6A4D04C8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQn7m36bploQ7kNvwHVuh2j&_nc_oc=AdqOUzGuHEl4SCuf0GaqiEK_ZRf5G72Dv4SbhP3_ZwG_wLjxy-wfyGJ0AD4QXz-rSa4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8GQzoUuoQ1Ja4wqdF2FekNFULKNpz_r5sN1QpjcQPpA&oe=6A4CF60A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2hBD_8IdPIQ7kNvwE8GJEl&_nc_oc=Adq7n3zuGelrJq1oSKvzG3tEmuigzFYHpE7k51HDoEmSPHLwTp2gW2bii6MMlrk1kCs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpgv5vXQe4HkCd53tZT-0IQN5Lp1IkHCdMWmeV6ByxLg&oe=6A4CF619"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTIP0DWQbyQQ7kNvwEYg7ES&_nc_oc=AdqFgDTPs-_N1C7tALRUWOr-trudNwNyBw8KJM9b55mC-rbuu5pAnxPMA_A64CZRkVk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZnno9wSP6SjPirMC70ipuyvKYcpN_sx4uLXWuaP_XLg&oe=6A4D0D00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35cjKhhmdOEQ7kNvwHPLBWw&_nc_oc=AdpG4z8u-tVo9QJvt6YBWTNs75pcOuuAMiUy6eRX3adkG4EJu7xcg-fXU61aEPcagyo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0guhsvgSaATx1qeDXLc4Lqrd5fTxgO8MKo0Q-v1hhYg&oe=6A4D1A9B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
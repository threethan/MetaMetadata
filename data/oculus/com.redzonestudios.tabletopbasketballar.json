nc_oc=AdovkYi3U6TMvURghFLM940Qh1OzSEkRGDRFrtm8PbNQb1zLzJ6Q0Ndr-RlQxZeZ18Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12kBW4nnvVOZA-bokNi267aimLPFOUl80O6uKCIeZhNQ&oe=69EB75C8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rceGMMgP4CEQ7kNvwGHmMQf&_nc_oc=AdproMCayy3-9S57Q0QRDM1XN0SW2UePhhkFpdTxVO4AfCKg60SeYJaXa0oV7uz2Z2s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38KzeqOaHrO0AbekZ55EkhGfmg0hyoBvP3BlJ3RbnGoQ&oe=69EB670A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NweEV47Za8kQ7kNvwGULyLW&_nc_oc=AdrTkuFY4KuapK8W2E5XZ581tWHvPiPJot8iCThc0SxcehG87Qq_T45K-3pByzibGKg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dCdPofM4e_vcyteWOUYe9jKolKkKtorr4ZQZgYXC3mQ&oe=69EB6719"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXjDUj6SVsQQ7kNvwHISbbG&_nc_oc=AdpCDeg4JKdtPw7Zr7Iimk9tfYaBeGEMGxCZ2v4OPMMcVk0bGNsojf5R0OF0RYEm0S8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kBKSLx0Q-vws0_SONSf-vU_TkfTxI5AZ6LYTmI_Gq1Q&oe=69EB7E00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BeoZn7dWqqwQ7kNvwHDbZoJ&_nc_oc=AdoYwp2tG4W-XFuSSJ9eXdc1eNgo7ZCkBNLW0Wh6-M3bX2100tqBvSsGCAeRID6g1mc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3D56pYNXXnhlrj5b0oO40P4y7gAHsaStsCc6Z4YU4gVA&oe=69EB8B9B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
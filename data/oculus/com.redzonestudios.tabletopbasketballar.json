nc_oc=AdpY-2YJHI_vYTnVvRte8-_nUgBIUx_b-B8Ufh7oVMHSEKvF0VKOEYglZZDa691lcDk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_bEPUx8If1jvJH6sjfKb4IL630Sg0HU18BNg8f8q4Nw&oe=6A897188"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ChRbyef9HkQ7kNvwEqDasa&_nc_oc=AdoNAEc0--uYijsj9FBuO4Bz3vVMZpz6FR2kBPFaUmM1c_PTyQpM7ped-leaoxZ6CTs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-195vC2p11q54DLMffBSvMDUGaRLEsYMeFH7Vhg9lNw&oe=6A899B0A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyFfLyfvukQQ7kNvwFq7MWM&_nc_oc=Adrb6oW1J9LF5Pi5vV7d0b1iAZw9oHnrSTW844cMEhxSyD3Kdi201QZTFPuYwQFiIbU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1fLhGNesyUyMWDQctoiFJUCzkplySlHLJ-1QbO6eGJg&oe=6A899B19"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sqa2Nyxq4KgQ7kNvwEZxXgp&_nc_oc=AdqU_CJjeIhsnVyQlGKjkx1f78vv204_QQHXxT_DurONAOTn0-COw8DtiLjdN6zQ-gc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrO1E8qj4OfM-iBxwB35Xj8ZeBs3EmbrU-6yF_9B5ePQ&oe=6A8979C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_otDn9L2gcQ7kNvwHjn3rQ&_nc_oc=Adryc63vHHdTDENa3tL8qPYLaP3iATKmXyQoK1I8PLp5mqE9KJSHANk4-ndNuChBTh8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_zyNtPxAx3pyhdeLl3zU4vYNmlkqPYws_2oRatH7ycg&oe=6A89875B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
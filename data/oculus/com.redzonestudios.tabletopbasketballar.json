nc_oc=Adpu9UP6MfCPFSmEMSPv3Ut6zX74QtnODkAkrB1quW3tZCD5b_YmpTprvhlJO8M6djA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhB4sFhTqd-axd9Bhf_oXc20ZItXvtrSM-cS0bypvQBA&oe=6A7C7AC8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSrGFFDsAbsQ7kNvwGJNEz9&_nc_oc=Adrbx3mZrfaTvIxnHyZirEAydT3T2P1kkmc5aWN4i3V7tZYYApsLigg13gTy550TbCc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVPI3Rjp2l6tz4-yIAJN5aEWLCiYP8Y0u33bhPX3tH2w&oe=6A7C6C0A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUx35cdXSdMQ7kNvwFuanZW&_nc_oc=AdrVhQqOjZB2meFOuHam6YQVfjP8xqo3FT4PExLYOuqzk3N2YsUClkY0UcXXCHhcxj8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-hltR3Ai2VktWCzxgdW9j1w3r3R4H3EbKlDR6q4VhFg&oe=6A7C6C19"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6X8JfvTmBQQ7kNvwEMnihq&_nc_oc=AdqTwxGRxVseuV-ztn2XclB_9vuGZJy4uOBZguMYRnRZPHctgKA8W-uj67mD890rabI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZYLsioRcvUvJ6EDI4CJBS4ebpV5_SjgdFkSHX1rK6mg&oe=6A7C4AC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKAFfV55GowQ7kNvwHRG405&_nc_oc=AdofPcEcbc1BBAGY6sLS4KbVCZWRrze6Z99K-J-n_47L1NS7ysKnfcIWfRYxvJjmcwM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdwGIgIk3mpXOjF-i2NfWrxKvLBOnQ9QTnod3HoJtHtA&oe=6A7C585B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
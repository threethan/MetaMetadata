nc_oc=Adpb-9XyVuTTRiICKnaEOTSygQjSvQRi8A7PInIuVOYFXC-8de1fWMCRK08ibCC_0a4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9Kegp3uxk0smZX4VpFPEsre9fACSK0mUAmxaTK2R13A&oe=6AF47348"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzLbVtNjycoQ7kNvwGRidrD&_nc_oc=AdrwqTHE49oVURvFK3nFuOpqeRzh41E1dpe3UVcZ_vigm70MGA8RiKsnvGcb4rc3xiA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTM92Od23YjN2LJJJJ9UZAiaJhczAEuaBkwfHs2FwpYgg&oe=6AF49CCA"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Gln8wC_V5MQ7kNvwHLDWAj&_nc_oc=Adrz1PG93yQ7n7TAQg3gg6pSdRFCGy0D3CxXJ46z3XhUTBnHxRuGbOSM8O3S7NoD4YI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiPwEfi7WBCDFDYsY0v8w7wpW3UH-4cBS6ESwiXSItPA&oe=6AF49CD9"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYEayUVyQV4Q7kNvwHHWKSu&_nc_oc=Adq9wWhvX0KuGkji7NNQOiF6SIC6TP4ZT0AyrVQD6F5Jnp5RB9gI55wzdlrnaW7zzmg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4raWwE0degfH1ktBDlT7RLItpmhFoWUoJK5hJat43WA&oe=6AF47B80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvJx1BPDl4sQ7kNvwEcGFhA&_nc_oc=AdrcxPuOBN1Sybw7qUoGUVxiyj7e_9Iww6qqGOGa3lQXbzv_z_sy8jpN5KagZOGLJtw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYsK7R88m1CHip3l3leLwtV8YBRsbOQD7KmS6GInsKXQ&oe=6AF4891B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
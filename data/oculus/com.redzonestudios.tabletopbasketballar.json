771-25/38974868_885479802728438_8711661268208378868_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAstkBByVWwQ7kNvwG3nG0-&_nc_oc=AdooaexMiSIdP7MOvaXR84EetctuJRuQdn8OAfZmV-wY6oSZcorEBF67iyXi2R-57AY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9QSA_0YW8MXnmSFrUz8nA93gRqJlOeOnTIptP1Cp2vg&oe=6AF8A008"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miUPzprXkNMQ7kNvwHNjC9Y&_nc_oc=AdrC6OlP2ZqVPnFmx1xYgWDBUC5Ud6E3Ifx1hOWXqKOE0UV4skW1zjiUfzvg9EbGovw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWa1BMmwyyCgUbMGv7qi-RZn8Brp_22SlC9UayJkrQhA&oe=6AF8914A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwQ0bmA2a60Q7kNvwFE4o1z&_nc_oc=AdpWDRLfKZqsbu2-HRs0rffTF5NpPYqwuqLTHgCVdvtmjSO_QGKVDGN5zadG2jFjOF8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzmz8ECd5m6Hq-kN1izkGiewjQwlWP7aU1kmoMXfBHqA&oe=6AF89159"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkdMBTM_TP8Q7kNvwF6BXs6&_nc_oc=AdoBJD5qDpPEkXeKeRqIEtJzJGI36vifYrcib5lGAMMo4K_lu5dDaG7EE_cZP4_7n4A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFlJyYDJqPgcs5dbspX4_mHPvLxcjbfama8TWr7Hrt4A&oe=6AF8A840"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0g8tnzPIhWUQ7kNvwHjO4nG&_nc_oc=AdpUuFaVekYIyV0Uc6GHP1zHNp5VfhX5RrJrFGO2g1ZXnOMiEQLY-ytopF3G--UOPRA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJ7L6-MbwTpSHyUb_Z8a4lKEsxAjijoUDKVeMPyuFQdA&oe=6AF87D9B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]
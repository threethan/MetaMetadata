nc_oc=AdodMMidbTFxxNl6HiBnce5gh_nMO_bJrER8lCxbjYPDCnjEAHM8OV3vtsMoW9iBYfM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6azMzLxyQS1AFIZPW_BROsNOlC-ujcA0S9AgFz1oRlhA&oe=6A01DF48"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spl60nxVQJcQ7kNvwFlCxur&_nc_oc=Adrds7CzYwrRp4hdhhBRE8b3sgXidC5mEOwaMwPQUptrWf5wyZA0OwtMqdFaoSRLAvc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4h56HOoUYwNDGOUNbOxgi-ouwTUYbnjVdVpyXBcKHLeg&oe=6A01D08A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z89K0qRheEMQ7kNvwGiRO_3&_nc_oc=Adqsp0PFvwe18OnnAtKGqDzf0d6g1xbIDoeXSV0R7NLpv-dQor4LIiVXH05Kmnu8JEA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RjVZWnP1l0_QtsgrUCx821qvJuymVl_bworZS52nqRw&oe=6A01D099"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ii8zpxgh1NkQ7kNvwEuVUnc&_nc_oc=AdrGrPx80tLfZorhdpzgSIHo35ikFOu3Bhv6JtBpoGR6xytPRG8-gIu0cahOUMTfs5E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5h6fyM_N4F7mPSErAy__01-xaFI_kJa1oqpLHCPHSPGg&oe=6A01E780"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54Svc2qme34Q7kNvwGrTacy&_nc_oc=AdoXdfXW_Ly8cI35Vdq7DakCUVC7PO3QRxlb_Ys1uhF1hjpp_2LTjVqi2l51Pqm-UaU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NgVaIza6bri58IxJfepIAlstWYeJKzXeuBCvxtNMttg&oe=6A01F51B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
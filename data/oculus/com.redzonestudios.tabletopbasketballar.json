1.oculuscdn.com&oh=00_Aft33Sp0XViixU93jp6CjtJ5ognzgu32HMhCIJEAZudN6g&oe=69A6E7C8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaa7Pixi3WIQ7kNvwEOTO-w&_nc_oc=AdnjRoOBiSUrpJU7Q_o-okb8xpNImaLNhtibKIevn7jnfa0VcKkWV2_tI0PG_7scb00&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsy2VEVUVw7kHl5_EEvjwL5dNz07vFTrJOt3NwU40g9gA&oe=69A6D90A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhGj8ZMpLgYQ7kNvwFCessi&_nc_oc=AdmT4DLqx5WQamB4JQazTsodehKUy8g-sfRjt2eukyvEty6obU5eIQOGwBKGAjjbnI8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv06DDJRRSrUvsvoYJ6ukcAxdGDCHhSi_ySdzKXToZx3w&oe=69A6D919"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQp7LT2RPrAQ7kNvwEpY-6A&_nc_oc=AdmrBEKlYOMLOxcS1Nfibzb1ULWQjF36rPIiEmF8oXg2L5waGd4lcAYFyUpJEdIhqpw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft99AzfLj8pid0jR9TlMu256ZR-KUAKVQrCfKmttCoqeQ&oe=69A6F000"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mTLXCcNlOEQ7kNvwGddYzZ&_nc_oc=AdlQT4PQVjRTUcn4jzYS9E5ciTPIIkPH90uiZeLGrFuAVbKsuE26JrJhAEyJYzeyXy0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvatRz17Q0s8P4miL5tDCF19rsgPXj24iLGBAvy32W17A&oe=69A6C55B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "RedZone Studios LLC", "support_website_url": null, "website_url": "https://www.redzonestudios.com/", "category": "GAMES", "comfort_rati
VYzVoPpTtBWW9a3Zp2Lpgjp1ySGIx5hGhH97NxbqY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwP_umeVuDKNIw6X4ibGhxZg0s4kZcuqHh83Kw8ceHuDA&oe=69B2C548"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SI3oGvDgghQQ7kNvwG21wL9&_nc_oc=AdkqHFBmoj37hoC7Fa9K6BpqSJ86eKBQ3dOLjzjW-0nZrzg_l-TbNmC37i6T3ibq4Eo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwsvuvsSw5UGFK3vjr21N8Xa0DZUVuxmQ8Ukxv8ZlbhBw&oe=69B2B68A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3IKiXaMbF4Q7kNvwFW1GK2&_nc_oc=AdnEH0opHft5ian-1LX9idGH6n6Ye9GUQbGdF6bS3Sa_a4sh1h41WHsEA3LsM5ElCW0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwBg_qbWDCJcfAoVYWtDpsyqiDxNhvshJyntEbYzj1mbQ&oe=69B2B699"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eN0fnVtFCu4Q7kNvwETXtH3&_nc_oc=AdnNuoCUmpCMH4068LCFZHqKhUinRMdYJBMoJBDDbKVIQNEmB6ujzdt7hhPWe5GxyWU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwglJEZuypd6LpwoCCBSzKdkIdIZeAFfAlE0iQ3XkSxgA&oe=69B2CD80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFJUUNWIQWkQ7kNvwEZHmri&_nc_oc=AdmBk9nQ9KfZ1YxrB8t3pE38yI2CY7MiW19TnvmUnrC-pF6XyjzFb3Kgr-ZYWS2MOEw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwblGbMh_nLLzNTMdf3We_w2eoHFPdKVYRzzXlcJl8dmw&oe=69B2A2DB"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "RedZone Studios LL
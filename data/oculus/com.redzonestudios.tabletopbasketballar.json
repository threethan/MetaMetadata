nc_oc=Adps1dbS2qS731_fZ1ZaYB8IY7Zstb1J03xpQQpgM8dldR4MIUyYxgLVwIAqTEkiY7w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4R2lBQS9PEhorKjYsuIaRSciXTU1P5PLWr4gu8lOwzg&oe=6AB3D9C8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2IT4jGCrwgQ7kNvwHjpQc7&_nc_oc=AdrmJhLE4yJ4jB7DuZ24Rgj4lloJDhG6HuspiuNEorwPpRXZo3h_ntUvu-auUC7PMjA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJFpXZimiLHe_o_vjclIxt3uvRqN3iXAUAIIf7qwLFCQ&oe=6AB3CB0A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKvoJqQMaisQ7kNvwFY2lEk&_nc_oc=Adrx5UP-lRsNhUWhxzgWldSTCGi3MxD39yLWP4leFKhRoKU8SranouOWt-AZHYkOTOw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIVa9hZPiO7i5SCvl0Fr-D-aWoGMFunZFhpOrlNCRGGw&oe=6AB3CB19"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXVDV6HTJakQ7kNvwHxXarS&_nc_oc=AdoZFlgFFA45S6Wfa-X6g6EYTqYoK8UJFKRWCGCc4y2UT737BH-4Ct5VuT5LZlXMMD4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJm_FKc0SRuW8e-SMEYEVaBMUQ10j3u3VYUNwl8PMPpaw&oe=6AB3E200"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAnwTNqf50EQ7kNvwHEahph&_nc_oc=AdrkzoorY8H_-iudcVQ1ArHiwCrs4UPtJhImSYijaspepm8FO0GLavmAcbQ6lzD9qcY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLj-R1_hBaxQMmqoX9OYOL4CLwEIJjZbzqHyFHo48Duow&oe=6AB3EF9B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
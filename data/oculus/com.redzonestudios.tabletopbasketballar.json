nc_oc=AdrH0o6-TNea93K6weFnWuPRN8AlhW1h_mezeOSBt3qrCZxdhPjb413dOJ3D_TNDeqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10yZ-XQLE_EZWvfZbLHKm1bb40a4OlPPqz5G8veBCFTg&oe=69D65DC8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eepn2CdvZakQ7kNvwGQOTTH&_nc_oc=Adqgq4CUIFfT1AmDx5RtilTCaf_1yzUyxUuTbvMv-9DQ19IxmUl3HgiftxDOCue3cto&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vIu5hSlj1F-I6bNWQaaVL4S2smZwOlwsewduWkHiK_g&oe=69D64F0A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZymXllXEPgQ7kNvwEQ3Vqh&_nc_oc=Adoj3kE9x_lfzBsywi8NwfA_AW5sxATl_M3kzyQgvV5W4h8hTbdgmZV4J-rJSEq22xU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36eHdMDwSQe-oAcfOAdwqhCGThUjWRdIqGSORKW1hpvw&oe=69D64F19"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_n_YFcAqa5QQ7kNvwH30R2z&_nc_oc=AdoMGsySF0Bu9Oh0sCpWkeNxnd-oPm3Hl3N5QorivoNVnRiD739u0-c9Oob7G-LgJ90&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2h0rckk_vRdlpw3oMEkc_5F5Vr0hgRNi7GeT7UJUDcEg&oe=69D66600"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sgJfsolsGUQ7kNvwHEPbol&_nc_oc=AdpsKkyXwG-I0OIkBBIRCIB_JlwfFPHH1eiEJdn-JeX24Kbyr7-NR5BiCvyw3mf55DM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IAcBOKKgBqI_aawC-rCb68CcmRC4JFZ33HQLYVZjfdA&oe=69D63B5B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
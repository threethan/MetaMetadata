nc_oc=Adpq2FD-g8ipYd1Z4JD5sxkIcS1E9GNxFQKSEcGpYssMuK-md8HxveT7Ao9DjRnesdE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1H8C5LJFOcpmjC6xSwOo8j6nrotA3ObiIrbz0oFwxahw&oe=69D50C48"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eepn2CdvZakQ7kNvwFjoMBG&_nc_oc=AdoEKxby5X4_NI6gul4kQoAo3gQLRBvuTVhXkSrO7kVNzElrG8fU3Hp287Ec9dPbJT0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mQlarsyWtnlQ4V3uovDhFSkAP82SdeW7afl5S_v-JKQ&oe=69D4FD8A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZymXllXEPgQ7kNvwHyo8lh&_nc_oc=Adqg_NpcRxA1jbMMlpFfKWCyUqCcS0h9u4gzF7D2L9Q93NaiqJ-WDFkfzSvGGE6qK04&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Es7EO3Rb77UnSRWz1HGMBIG_86CyChf4NIQxiG_w9lw&oe=69D4FD99"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_n_YFcAqa5QQ7kNvwGKzooa&_nc_oc=Adpu8A36posMuLUqKMayrRkvqbRrbphMu9ffDQjgcjJnaTbKNUIpb2_5ZgX5f2SPbIY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04uspzDQBl6oardQbsfCXF4ODOBNzvW154ciOL_ZuE-g&oe=69D51480"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sgJfsolsGUQ7kNvwEgPCbC&_nc_oc=Adp6VFOCi0-kNFoSfFPmp45DGfklCNHzi3jNIiH3MBKp1OLvdTMKGx0PRZ6BqYTAvuE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_HB3iprFy4yboKrKmB-oO5JchsRAr0Po5PJmv5Mqmrw&oe=69D4E9DB"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
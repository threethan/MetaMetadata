1.oculuscdn.com&oh=00_AfsbbQIX_v04Zkp8jKJdTZA0ajnILzx-g3xdrkQW5Uu2nQ&oe=699DAD48"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55RW9XEIdUsQ7kNvwGWSZJj&_nc_oc=AdmzaWeA2BLhGrfnI5MpVMJdgSQswDaVbQ2DxccelZtWs-9RQ89xfbo1bLLUxnxxetI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftEwlaSGvSFmgMbIrcWPs0E_Qo67v6Bg7DNU7an9NzHqg&oe=699D9E8A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvlZifHKRmwQ7kNvwExNt3Q&_nc_oc=AdldBByepsZ0BWhZebB6PbwRmeHm-ZePDXAn4O-E8W9bTz8_1N-p2AyTDWWIHN0dGXo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft2tbUdLvGtUpJ8x9Tj_ig4E64vBXQClEMVeocjpWiSqA&oe=699D9E99"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNviTeacTSgQ7kNvwE-FVSI&_nc_oc=AdlbLj7ABsBA1pw_jNQFk0aCbJb6Xej79s82T0jZPZqj1Ky8mQpFF45dLl1N7UAQcbw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftl1aezejnzALAm6FmccgR3Xc15TDoHEfmaU9HKZZ1NUA&oe=699DB580"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idE_Btb_3N8Q7kNvwG_e6zf&_nc_oc=Adm_bZwFD3-s2G308Wk3PVJh6XQBdgx2LJl-AS1DwJ9ypiR9GfiEqE98ZmycynR-VrI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftWxMxWXu9bid9DEL6YIdV_1dE3CQL01JgejZR_9Vweow&oe=699D8ADB"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "RedZone Studios LLC", "support_website_url": null, "website_url": "https://www.redzonestudios.com/", "category": "GAMES", "comfort_rati
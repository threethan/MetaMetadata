Qq4hvEbwMcOPkfFq3_0QTvmRlU8o2IQVnH43UE7rNOyQIW4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afxjh6o8-2vzJnJa1HA8RAeJ7F7bhU476PKwgF8hBw6xoQ&oe=69AADC48"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNMHXMfNQTEQ7kNvwHzMQEc&_nc_oc=AdkcdoHywMi_viY_6xbIJQYtspo5M2QrTBHB8uTIlbIa9-9yyAbMLEPB03XpZ2BcejE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfwleZHmnMAFovHula2oumPWFMgdV0lFZBqudn_KxZfReg&oe=69AACD8A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eyr6Pmpcug0Q7kNvwGCkBlp&_nc_oc=AdnHAHPnxrGyvpCOGVjwlInC5GbObzBp4iz_HTjiLOH22VpBGv3_-iQtX3mOOoEZuJE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-Eh0wjAbmA1UFVekQW1H6fc1ZuMBFk33MfptLK23KOw&oe=69AACD99"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBGQq_Su1p8Q7kNvwHVSCm1&_nc_oc=AdlDzizldkklbrpTJwEB8nG14zws2G5fakYPN556jroTj1NNemrXqN39KfxUSnnmTGM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afyi4U7zNTulniB_TiRs8XyN7IR_c29btSINTPPDkJBIdA&oe=69AAE480"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1Y2gLuiB6IQ7kNvwFn0OsJ&_nc_oc=AdkySM_lM7bQjZ-kW5WKuWxpO9FT0J21-Q-c3D1lppH1kgCVc7GY6OZLTi_HoPG41mc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwpFAZzkJai6Me0U5r25H6LvS7Q_yuusQk2cz5f9F-8OA&oe=69AAB9DB"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "RedZone 
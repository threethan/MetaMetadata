nc_oc=AdoN0_zW9LHjLxGi1M-7JyD87YNBj1Cigf2hXrb8AMVs9FWVNN3NvpVAe2HiObAzrFg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aoFhFuiAyYvtgVMitas3G_cRnhcUFxuL6Nfcv2ZkqeA&oe=6A0B19C8"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MGph6F94bgQ7kNvwHNw4hd&_nc_oc=AdrGGWHc9Gt3meXzWAyAMUVjAO1nvW4xKmKB7rjloBn8BRY5ooop41FiDvVZUL6mT88&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dMVCmS5sV3_I64hbgRSUOYbwcR09NMwdnn0hwlZfLig&oe=6A0B0B0A"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdkouVTacPoQ7kNvwGMwAst&_nc_oc=AdoCh8uvE9v9UwLi8qWpKHkshasgYUAIQdU2NUkXPKcU23uRjAOeP105T_z0Ey_ZxeY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oV7a51hXZMimPaNxWJ3tSOK1VJOA0Hi07qcgzhcitmw&oe=6A0B0B19"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sC1SYAqUIqEQ7kNvwGkhG9_&_nc_oc=Adra7zEtgxPHa52bG_2UjkjLj14Kt_IZO62UK1seBJnALuF1ebrsteQ7lQQf_R8ie5s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bqVoLUq_M9zywPHLgoRVz8BkLuTDAgITZiy4pSy9RZg&oe=6A0B2200"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8OQ0hx8NDsQ7kNvwFTKIMg&_nc_oc=AdpZdq0O0-NmJVEYM9wJ1siNx1ytKDrIH3oBION9v_Y_jxFCtNTNYfXklS--OIHo-iI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Uj3nLe_boahJbWD_QL6ATV0LzUy-tZMlgqivVqME8MA&oe=6A0B2F9B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
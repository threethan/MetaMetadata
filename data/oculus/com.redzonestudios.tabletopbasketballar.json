nc_oc=Adq1USVfDZfllAQ5AP7PO1LmLa8nX13bl69XMOP-ZUF5PsoScT4BYzrQryAXo7Fz6AY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwc8PGzLqfFJqhgmDYLVkjBzRLqSOs3tsYD538_7a4GQ&oe=6AE74448"}, {"file_name": "Screenshot2.png", "id": "708977614588076", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488375_708977617921409_1075715276216507772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEgrp5LmeekQ7kNvwF7KffF&_nc_oc=AdoaqSCb0n8CB4WLp4j8D-yOzwtjbbr28HraFEeWLZuP-NtN8UDpuSAM3rfEYfPQpD4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyUbndFS1Gkw_1Ae_iKb-HeTm8p6PPFai8V1ztsguKKQ&oe=6AE76DCA"}, {"file_name": "Screenshot4.png", "id": "1449100632372768", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031502_1449100635706101_8566828919912654030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHyzxZMkVtoQ7kNvwHx4YXQ&_nc_oc=AdpdtAstn6JSMfnRLF_SGExJgi4iZO_5HDIfg0SAq4IS9Z-4aay-Tha0A-zPS_7sjtE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJKT9NBJF8AT3CtqHqVpf_8-1JE1ZNmNcQuFNHNTSkrA&oe=6AE76DD9"}, {"file_name": "Screenshot5.png", "id": "1042094833579475", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974513_1042094836912808_4953768684373887112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2bFC62cjvsQ7kNvwFT5yu-&_nc_oc=AdoW5zNP7H9OFgjq4UzcNJIgzosrtN1_LuEDt3smPRFEydOm3qKuZz_LW4YRjAT9yKo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTuL_I0wgqmCBznA9vibbU04mfXv0TIPba21iwBSD-gw&oe=6AE74C80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "889483612519314", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974858_889483615852647_6939535896939341857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnW09JO3WXkQ7kNvwFdD7gR&_nc_oc=AdrWR8h0Sb1sNSe4IRYjWQVcqaX9kZgJJUJ-MkOYzN4Bugajc1FfxBZr0utXkTjZY88&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCih78-18GWkbGFLUvJ9FvdR6PlLMenPM1yqbdi2xp-A&oe=6AE75A1B"}, "display_name": "Tabletop Basketball AR", "keywords": [], "long_description": "\"Tabletop Basketball AR\" for Oculus Quest stands out as an avant-garde blend of traditional basketball gameplay and cutting-edge augmented reality (AR) technology. This game offers players an immersive experience that transforms any tabletop into a dynamic 3-on-3 basketball arena. It ingeniously combines the physical skill and strategy of basketball with the interactive capabilities of AR, providing a gaming experience like no other.\n\nFeatures:\n\n- Dynamic AR Gameplay: Turn any tabletop into a basketball court with immersive AR technology.\n- Multiplayer Viewing Experience: Join games within the same environment.\n- Intuitive Controls: Designed for Oculus Touch controllers, suitable for all skill levels.\n- Realistic Graphics and Sound: High-quality graphics and immersive sound effects enhance the experience.\n- Regular Updates: Continuous game improvements and new content based on player feedback.\n\t\nWhat sets this game apart is its remarkable use of AR technology. The game transforms any flat surface into a virtual basketball court, allowing players to move around and view the game from multiple angles. This feature not only adds a layer of realism to the gameplay but also brings an innovative twist to the traditional sports gaming genre.", "short_description": "\"Tabletop Basketball AR\" is an Oculus Quest game that merges the excitement of basketball with augmented reality. In this 3-on-3 basketball game, players experience a full-fledged basketball match, enjoying the thrill of the court from a unique, tabletop perspective. The game offers an immersive, interactive experience, combining the strategy and skill of basketball with the innovative technology of AR, perfect for both sports enthusiasts and gamers seeking a novel gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redzonestudios.com/privacy", "developer_terms_of_servi
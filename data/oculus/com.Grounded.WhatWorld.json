n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LoA1sjaAg4MQ7kNvwExzx_X&_nc_oc=Adp1yvAtLr1iLVduh1Yk7x55joNOblFY3U1frn6-Y-XupcV9KSFwm3iVupMZZCHtvuE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEePtlLPKtbYQOD6-7awS50ctZ65InuT8-Dou63q2JFIg&oe=6A8D7494"}, "display_name": "What World", "keywords": [], "long_description": "This is a prototype for a survival VR game. Its main purpose is to shine a new light on game mechanics within VR by focusing on player movement and dynamic 3D interactions. In this prototype, there is a tutorial world and an open world that is slowly being built. Explore the tutorial world to get an understanding of the game. Explore the open world to try the mechanics in a rough version of the world.", "short_description": "Explore the unknown world living within a crystal. Keep its nature at balance and reveal its history to understand why What World exists. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.groundedfilms.ca/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Grounded", "support_website_url": null, "website_url": "https://www.groundedfilms.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644930373485903"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974439_88928499168
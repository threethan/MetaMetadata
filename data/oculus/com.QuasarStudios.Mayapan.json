 awaits you!", "short_description": "Conquer the great pyramid of Mayapan by showing your point and shoot skills. Match colors and make use of special bonuses. Feeling good? Try the Survival chamber, at the pyramid's lower level. Resist as long as you can.. or taste the heated lava! Compete with other Oculus players in the general leaderboard! Be the best!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.quasarstudios.net/privacypolicy/vr-privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Quasar", "support_website_url": null, "website_url": "http://www.quasarstudios.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1122842795244492"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "2410381686112466"}, {"status": "PUBLISHED", "id": "949195754421049"}, {"status": "PUBLISHED", "id": "2368572163639704"}, {"status": "PUBLISHED", "id": "1674840776837374"}, {"status": "PUBLISHED", "id": "1593503111783788"}, {"status": "PUBLISHED", "id": "837202419000596"}, {"status": "PUBLISHED", "id": "24342698695385593"}, {"status": "PUBLISHED", "id": "9466350723462458"}, {"status": "PUBLISHED", "id": "1872464003567661"}, {"status": "PUBLISHED", "id": "1718029292375652"}, {"status": "PUBLISHED", "id": "1413450382659216"}, {"status": "PUBLISHED", "id": "504419
24-02b.png", "id": "676417186893400", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974497_676417190226733_6849220561716485553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5ljSypS4o4Q7kNvwFczc1J&_nc_oc=Adonh9XP5CNJSJWMncR7cT6Zi0Qw96ciJXDCuVD7A13vZxK1k9_OlxslQXy_n_drE4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yur5-yBsxAEQK-TPkiIiQ_JG8Hd6EyrpqVkTZAyuRKA&oe=6A0DC083"}, {"file_name": "2021-11-01-22-55-52.png", "id": "756305892011000", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_756305898677666_1215066555577615549_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AzXzfMXiE4Q7kNvwERvK8Q&_nc_oc=AdrF-bCs3hglxQiFRYjoe9Gy6Z-w6O0ACVN2LYMwAWKnh6FztDUKcR2JuMXo429iQQU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SjR9MLonweXAkaBj5GFqZ2E3s3oUJ2RfX6DwfWQc13g&oe=6A0DBDAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "315682543878932", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974721_315682547212265_227553438805391088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDlFI_zU25sQ7kNvwElQ-_i&_nc_oc=Adrf1EHKs_A02_KYfMKWZTh_M0xRAvk6pKmMR8ouyg6zabPmH-9txmv76R0sula2G9I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52C05ahTQM22SKsw6qy3xsk3rjlC8tetjLXakxxMCcjA&oe=6A0DBF96"}, "display_name": "Mayapan", "keywords": [], "long_description": "Conquer the great pyramid of Mayapan by showing your point and shoot skills. Use two crossbows and clear your way all over to the top. Match colors and make use of special bonuses. Beware, some bonues are good, others are not! Also, keep track of flying bonuses, those are the special ones.\n\nFeeling good? Try the Survival chamber, at the pyramid's lower level. Resist as long as you can.. or taste the heated lava! \n\nHave local scores for you and your friends. Also compete with other Oculus players in the general leaderboard! Be the best!\n\nMayapan awaits you!", "short_de
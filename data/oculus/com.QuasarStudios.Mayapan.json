24-02b.png", "id": "676417186893400", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974497_676417190226733_6849220561716485553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18-yT59HvoQQ7kNvwFDHwQ8&_nc_oc=AdqC9_feRY2o823_1ctCMEQnm9Ty9ZaY6csu3FzmVyFEPly0cWA7v2W1q7SKcQWtfEc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5ztvgdJaaMiS5bocU2tsx3Nptwbc5axJYLRZFPcbU-Q&oe=6AE35383"}, {"file_name": "2021-11-01-22-55-52.png", "id": "756305892011000", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974444_756305898677666_1215066555577615549_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8DNnCai5gwQ7kNvwF1VKkc&_nc_oc=AdoTgSXP_4P_A5nd3a8a94rlkVU3N4kwUtK4vkvEmeC0B2pKPiirbH8BjH8swoI8FNU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFB2ZQaqfM_zi_YxkvvmhwULpA9C3wGZR2aaNucpBEAw&oe=6AE350AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "315682543878932", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974721_315682547212265_227553438805391088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKOITdP4BgoQ7kNvwFJzT6T&_nc_oc=Adq6ZYY0J8ikK5S4mGUU76SChxUdOiMMlqwaUZ-wibuPdeJ4-z8YHERQoUdFFYY7BSs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPquKwdKwUxVeF-P5VcHlsqdmQJXk8piD2OZ-ySeFxJeA&oe=6AE35296"}, "display_name": "Mayapan", "keywords": [], "long_description": "Conquer the great pyramid of Mayapan by showing your point and shoot skills. Use two crossbows and clear your way all over to the top. Match colors and make use of special bonuses. Beware, some bonues are good, others are not! Also, keep track of flying bonuses, those are the special ones.\n\nFeeling good? Try the Survival chamber, at the pyramid's lower level. Resist as long as you can.. or taste the heated lava! \n\nHave local scores for you and your friends. Also compete with other Oculus players in the general leaderboard! Be the best!\n\nMayapan awaits you!", "short_de
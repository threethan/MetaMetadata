24-02b.png", "id": "676417186893400", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974497_676417190226733_6849220561716485553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xy6jrR9lOfoQ7kNvwF2RrOW&_nc_oc=Adrr5Vl14DQrFKi8InXs0spRPj2gfJ6UOXlc28PofpEerpuI961IEWTh8Jv6XEkjwag&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJYFIHFYHC9YeaLPhNH2FhMLa50MDM8yJvBDuYfZOlBQ&oe=6A5A3783"}, {"file_name": "2021-11-01-22-55-52.png", "id": "756305892011000", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974444_756305898677666_1215066555577615549_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hD08TnIhfMQ7kNvwGNW5CO&_nc_oc=Adpqya30mwElF_G8HLEVZ_CrctNAl25BbKzRXsGM3Sg5jBXfJpERNAdy8H4DIqplaMI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMrNeBsafzqxlB-lFJdcWFz2WMvI-eibBnly6rMI9K7Q&oe=6A5A34AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "315682543878932", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974721_315682547212265_227553438805391088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dc8b4HP-ghMQ7kNvwH9OPEG&_nc_oc=AdpREgbE6BPtW2gSmNsZkKKgqdyNKEL8RrlgjhwkNKHbyyacDA9UqDrJQkzBVzv_E1s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-CyiQxO4KUMEMES9X87AAnqUdsavR_DRpL-xtuT5Oig&oe=6A5A3696"}, "display_name": "Mayapan", "keywords": [], "long_description": "Conquer the great pyramid of Mayapan by showing your point and shoot skills. Use two crossbows and clear your way all over to the top. Match colors and make use of special bonuses. Beware, some bonues are good, others are not! Also, keep track of flying bonuses, those are the special ones.\n\nFeeling good? Try the Survival chamber, at the pyramid's lower level. Resist as long as you can.. or taste the heated lava! \n\nHave local scores for you and your friends. Also compete with other Oculus players in the general leaderboard! Be the best!\n\nMayapan awaits you!", "short_de
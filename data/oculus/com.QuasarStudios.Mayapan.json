24-02b.png", "id": "676417186893400", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_676417190226733_6849220561716485553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4dog4AxM2wQ7kNvwGnBNVc&_nc_oc=AdrjRRwF9WA6dQE0-62nWPV485SLx9myJzvSREIEXody8nZJSldKpIhgBg7oY-wdfo0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPfXvbUyZ829E-Eyi1BgIKH0eBGIS04CPpWHno2aG1XQ&oe=6A7B2D03"}, {"file_name": "2021-11-01-22-55-52.png", "id": "756305892011000", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974444_756305898677666_1215066555577615549_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40hUc7OMN9IQ7kNvwGt0y3l&_nc_oc=AdpuGhIn8dQKaDUICARuvNhahoRaB9Tmx_Fd2hUGPSh2ZR4YIXpUu5pT8SBz8bKaT3Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHT81HEODQh-0YPYxepaf7-gd4U9HlSbdj2BI5RSkaoKg&oe=6A7B2A2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "315682543878932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974721_315682547212265_227553438805391088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUNUsfLtbjgQ7kNvwGAZbLy&_nc_oc=Adp8GQ19KgaakK8yGJ_2DkfBwHbcuAFmO-cIG_TvV_-Obf9HnSJZy6GYYUXUDoqJ91Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeh9UjpnVWi-i7BFN3guSNGqSA_9MZ4HhQSw87DZE0AQ&oe=6A7B2C16"}, "display_name": "Mayapan", "keywords": [], "long_description": "Conquer the great pyramid of Mayapan by showing your point and shoot skills. Use two crossbows and clear your way all over to the top. Match colors and make use of special bonuses. Beware, some bonues are good, others are not! Also, keep track of flying bonuses, those are the special ones.\n\nFeeling good? Try the Survival chamber, at the pyramid's lower level. Resist as long as you can.. or taste the heated lava! \n\nHave local scores for you and your friends. Also compete with other Oculus players in the general leaderboard! Be the best!\n\nMayapan awaits you!", "short_de
24-02b.png", "id": "676417186893400", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_676417190226733_6849220561716485553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=niUCBbu_I8MQ7kNvwFVVb0J&_nc_oc=AdoksfXTCEOO9befb_Tx6mC_EYAFdtV4VakGIMoWlrGqEm3gyEqN8oRTTIwSiMWHwIg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQsp5BUX2deumTYz-zGoC5dm5uRYdcjdrr4JM6jptNMw&oe=6A50FD03"}, {"file_name": "2021-11-01-22-55-52.png", "id": "756305892011000", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974444_756305898677666_1215066555577615549_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jokknWNNVH4Q7kNvwEIRAOB&_nc_oc=Ado6C8ZStdgssBdQ0cHIBjVrjK8S0MdlC9bCXiQq6XX6xiGnmYYQoUGsO_kxAHxYYuI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDu59LrZdNqrr4HzrIdf6p2N12PG6vVBXj5HQzI0l2I8g&oe=6A50FA2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "315682543878932", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974721_315682547212265_227553438805391088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=st032PDe06IQ7kNvwGbtqNn&_nc_oc=AdoIx2dGGqF8CxFxWQ971bJoupaa-yxjmQnbe7dRj9P-mPmxuaiXM0HivqVqcIipuRE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCemCVc_jx2rkWoMyOIsIhiAhopsae4_7oeT9ke89PtVg&oe=6A50FC16"}, "display_name": "Mayapan", "keywords": [], "long_description": "Conquer the great pyramid of Mayapan by showing your point and shoot skills. Use two crossbows and clear your way all over to the top. Match colors and make use of special bonuses. Beware, some bonues are good, others are not! Also, keep track of flying bonuses, those are the special ones.\n\nFeeling good? Try the Survival chamber, at the pyramid's lower level. Resist as long as you can.. or taste the heated lava! \n\nHave local scores for you and your friends. Also compete with other Oculus players in the general leaderboard! Be the best!\n\nMayapan awaits you!", "short_de
e includes jumpscares.", "short_description": "You've been tasked with helping someone fix their vent system. what could go wrong? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://kiririncontact.wixsite.com/kiririn", "developer_terms_of_service_url": null, "publisher_name": "Kiririn", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCy8-N75jPeYWWiAZKwqP-3w", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "605850344765440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974480_854097302413174_6783255260563904646_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dw4UNr1QcAYQ7kNvwGaffE-&_nc_oc=AdkheGnPndoPmJHcZB2GWIoADAC0HOkOgN6Ij8fU0dVjXvDEozSd42pXEI6WbIMAX9U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIbDAqpH_fa9Q1cXy9tGH5TF5VZd9qcAJZlISMeMTS9A&oe=69B81516"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Crawlspace 2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1671091200, "lastRevision": {"nodes": [{"id": "8281672431857798", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"appli
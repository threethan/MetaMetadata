": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_795970904445734_3548694252540989664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWAOR7H1En0Q7kNvwGidMuX&_nc_oc=AdrMKndoNNAuHE70Xg4ql7j3C-Islpvmm7hTOeUiFcgY3OigHs18yzndNX5Ods3UlPs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVu32SisDM5WW6QzjmQBDW5rhAUu_N1DWJtp9OWPZ8AA&oe=6AF7259E"}, {"file_name": "Cowbot_and_Aliens_06_2560x1440.png", "id": "500574771028760", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035328_500574774362093_7455994007872970662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrR8UrsFf_YQ7kNvwG0BJ_L&_nc_oc=Adr6YQN6nRYipSEQV3SMaTktMIWBN5xiNph0nGwnplrR3xe-hBPf3Kp7s4tfs84yt9w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuViu1omdFJXFc7u8A5HXD_k8GIZIAxNh3dQy-1-rFiQ&oe=6AF7193A"}, {"file_name": "Cowbot_and_Aliens_11_2560x1440.png", "id": "1603300333394732", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982459_1603300336728065_203893513689332153_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiPwysZPcawQ7kNvwEqHxgQ&_nc_oc=Ado-dzP37_YcFXAfJRzdcq-0wG9gA3pZnA9mnHkOo7gXmbyc6YHiBeOJNRKugPeSsZ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTANZ7818HuVLJWdRb8epvNzn5KvBKg0fE7FJl5hm0HyQ&oe=6AF71444"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape3.png", "id": "1471938786617349", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75500282_1471938789950682_7191294715373641020_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lX3iCb4zUi8Q7kNvwFYRXFi&_nc_oc=AdoYy-VMr_pOsWhp6yXIOwskP_YFWQqzfPztkqKNOiuf9Ezc2EojZlytwPRqtSVzqns&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0EfhfOj--gt__8mYsiGznWZ15B4t9_3camB0OBIviZg&oe=6AF7478B"}, "display_name": "Cowbots and Aliens", "keywords": ["action", "shooter", "multiplayer", "casual", "adventure"], "long_description": "Cowbots and Aliens is a furious PvP Multiplayer VR brawl set in the Saloon-iverse! Free movement, laser precise gunplay, multiple competitive modes and a custom networked physics system that lets you use EVERYTHING as a weapon makes for an immensely satisfying VR ruckus!\n\n- Battle Online - Fight your friends in a variety of competitive multiplayer modes including Free For All, No Guns, Team Deathmatch and Gold Rush!\n- Single Player Bots - Battle against or along-side clever AI bots so you're never alone!\n- Interact with Everything - Grab whatever you can get your hands on, and use it in battle! \n- Hang Out - Hit the saloon to have a virtual drink with a fellow Cowbot, make art out of a stack of chairs or join a battle. No consequences in this social area.\n- Customize your Avatar - Unlock cool gear to outfit your Cowbot or Alien with hats, shirts, vests or facial hair!\n\nAre you ready for a zany cartoon brawl?!", "short_description": "Cowbots and Aliens is a furious PvP Multiplayer VR brawl set in the Saloon-iverse! Free movement, laser precise gunplay, multiple competitive modes and a custom networked physics system that lets you use EVERYTHING as a weapon makes for an immensely satisfying VR ruckus!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://chickenwaffle.com/cowbots-and-aliens-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Chicken Waffle", "support_website_url": null, "website_url": "https://chickenwaffle.com/cowbots-and-aliens/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["O
": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001732_795970904445734_3548694252540989664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idIRXTpQx7MQ7kNvwH6Y000&_nc_oc=Adqi9CGx12fD_ksgFA78ER3Ynsy-5-Ur-oGVoSPmLucPfUM8sIhzO0D49dFChVhh_jQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNC4fiVnUb5wgbahgVRv8yZybLhCb4jP7Riz1BowDPHMw&oe=6AC3BB1E"}, {"file_name": "Cowbot_and_Aliens_06_2560x1440.png", "id": "500574771028760", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035328_500574774362093_7455994007872970662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkU-moNdjE0Q7kNvwFvw2x3&_nc_oc=AdrVnYKLoeNoWpCJ3k8WBAIDHa2d4ysHvqM3vit8ID1uDUkKpQYRhQKl9uuuJi6lqYU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAfN1lb-8fuSwin--zQt-De7mUL6yPTHvxowATUjB5cA&oe=6AC3AEBA"}, {"file_name": "Cowbot_and_Aliens_11_2560x1440.png", "id": "1603300333394732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982459_1603300336728065_203893513689332153_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5uOgP3Og-cQ7kNvwGE59oQ&_nc_oc=AdqgOcagEN-3gNJRNNTUgcq2JHzYh7yyG9ccdjUaGlgAoVMSKqQnsWKovpi7e0XTQCc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7bA6WDr_jK8g64jD6y1vnvZ5A5AVlF3TLQx0DtuUWMQ&oe=6AC3A9C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape3.png", "id": "1471938786617349", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75500282_1471938789950682_7191294715373641020_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwESkWPMm6kQ7kNvwHaW2i5&_nc_oc=AdpZwqvYC1GOLk6gt6mJUhmGySZkmfY20eVM_r_Q4vrdFZo0kHIBrw0qjKlVwx0WnR0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqWHnqXc1l7QUOTKUTNkvnovtSUmrcoQqGFCef4vB0PQ&oe=6AC3A4CB"}, "display_name": "Cowbots and Aliens", "keywords": ["action", "shooter", "multiplayer", "casual", "adventure"], "long_description": "Cowbots and Aliens is a furious PvP Multiplayer VR brawl set in the Saloon-iverse! Free movement, laser precise gunplay, multiple competitive modes and a custom networked physics system that lets you use EVERYTHING as a weapon makes for an immensely satisfying VR ruckus!\n\n- Battle Online - Fight your friends in a variety of competitive multiplayer modes including Free For All, No Guns, Team Deathmatch and Gold Rush!\n- Single Player Bots - Battle against or along-side clever AI bots so you're never alone!\n- Interact with Everything - Grab whatever you can get your hands on, and use it in battle! \n- Hang Out - Hit the saloon to have a virtual drink with a fellow Cowbot, make art out of a stack of chairs or join a battle. No consequences in this social area.\n- Customize your Avatar - Unlock cool gear to outfit your Cowbot or Alien with hats, shirts, vests or facial hair!\n\nAre you ready for a zany cartoon brawl?!", "short_description": "Cowbots and Aliens is a furious PvP Multiplayer VR brawl set in the Saloon-iverse! Free movement, laser precise gunplay, multiple competitive modes and a custom networked physics system that lets you use EVERYTHING as a weapon makes for an immensely satisfying VR ruckus!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://chickenwaffle.com/cowbots-and-aliens-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Chicken Waffle", "support_website_url": null, "website_url": "https://chickenwaffle.com/cowbots-and-aliens/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["O
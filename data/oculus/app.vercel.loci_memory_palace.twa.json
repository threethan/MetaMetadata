5RqvqqPW2SOwBSgclZhOXnysI2G7miM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8oI577_CNtVOBt987uJq28MjywtdYF5D51pNVLqEsEw&oe=6AD0E237"}, {"file_name": "5-palace-object.png", "id": "1583252393507186", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620921_1583252396840519_4595318524807517663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7BlZQqfbMUQ7kNvwG0BAfc&_nc_oc=AdpseW6puD1465y8TqLbahTNYCkrlzZhKbEZkCPXaIcDcmqJbw1dBgv_NOSmtJmRr0w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWVWuEwk-U2h8VsD9OEMKwty8k8Qe7SIkx-nqX4_fTVw&oe=6AD0E353"}, {"file_name": "3-choose-difficulty.png", "id": "1583087140161997", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623601_1583087143495330_424706424343642607_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ht8zPp6kWKIQ7kNvwGVoKPh&_nc_oc=AdrqSoQGrdP7fLPCSi5T36AH8rtuQinFINxZVsifK-ZKVnx1wbq8Q50R1ELVlKNLu_Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCYS0yCmAoA4h40hhc96KtlJ_jkd_kT2phIYysmzyOHg&oe=6AD0EC52"}, {"file_name": "1-recall-question.png", "id": "1466064522217830", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619450_1466064525551163_33239047052141079_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXaZ5DtUoYMQ7kNvwGFrMFr&_nc_oc=AdpMSnWxpF8o-VFkbiILZyH8pmwGgagds-ltiCCMFzHknJgPeWYSsOWZ6eQ_guW-TUw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8MZzAbhHg_sI6Zfr0nvYj3t8-GYpuVhrnFz74V1EOzw&oe=6AD0D8BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LOCI \u2014 Memory Palace Trainer", "keywords": ["memory", "braintraining", "learning", "cognitivetraining", "memorygame"], "long_description": "LOCI turns the oldest memory technique in the world into a trainer you'll actually use.\n\nThe method of loci \u2014 the memory palace \u2014 is how memory champions memorise shuffled decks, long numbers and entire speeches. It works by binding what you want to remember to places you can walk through in your mind. It is over two thousand years old, and it is the best-evidenced memory technique there is. LOCI makes it spatial, which is how it was always meant to be practised.\n\nHOW A SESSION WORKS\n\nVivid objects appear at landmarks around your palace. Point at each one and lock it into place \u2014 the act of placing it is what makes it stick. After a short gap, LOCI asks where each object lived, and you point back to its spot. Score well enough and your palace grows: more objects to bind, less time to do it.\n\nCHOOSE YOUR PACE\n\nGentle gives you more time and fewer objects while you learn the technique. Standard is the default training loop. Sharp cuts your encoding time and stretches the gap before recall.\n\nWHY VR\n\nMemory palaces are built from space, and a flat screen throws that away. In a headset you turn your head, you feel where things are, you remember with your body \u2014 not just your eyes.\n\nNo account, nothing to buy, no data leaves your headset. Sessions run a few minutes.\n\nPut the headset on. Build your palace. Remember more.", "short_description": "Train your memory with the method of loci \u2014 the technique memory champions use. Bind vivid objects to landmarks around your palace, then recall where each one lived. Your palace grows as your recall improves."}]}, "developer_name": null, "developer_privacy_policy_url": "https://loci-memory-palace.vercel.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "B Interactive", "support_website_url": null, "website_url": "https://loci-memory-palace.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_me
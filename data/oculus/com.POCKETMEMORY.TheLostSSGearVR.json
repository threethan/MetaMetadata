FcR8Ii&_nc_oc=AdoUGmmqnnrG0LHnDnV805qNo2SqFkAkQ1v8I2JxoRCGTg2-frPzoNmIRwqxaosO98M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcbgmyrT3SWs_PcJGobcDxzOJoK6rV61t1tV07rK11vg&oe=6B046589"}, {"file_name": "migrated_image.png", "id": "1133039357040429", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162699_1453554234706375_6315181854609637376_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNVVLS4DGnUQ7kNvwHi4j4h&_nc_oc=AdprijEvImPfaYSSCl_4-P8Tc2b3Tm-ys2X0RCH5-ucu67gDTmZYw2Hjky2Az_cl3u8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNzPFQobnqPoDqmrPgB6rdlS4Sk7CrJ3AxlAmV7W76ww&oe=6B0484FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ub354\ub85c\uc2a4\ud2b8\uc815\uc2dd\ubc84\uc804 \ud64d\ubcf4_0225\ubc84\uc804_\uae30\uc5b4\ubc84\uc804.mp4_20170607_123439.465.png", "id": "1526323294098084", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162676_1526323297431417_3371615199273418752_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74c2qFrM5qoQ7kNvwGoBsBy&_nc_oc=AdrqMBLjtkXwaeLOQFMC1_Wr1pRV4n4qgIGZDFE9l1G7AYHhTIoagBuqW71BZiL3Xrs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSBRGfoPitGe_Fe0roSwmjnx-prx1SVFCS-TEIKDW3KA&oe=6B046CD7"}, "display_name": "THE LOST", "keywords": ["thelost", "vrgame", "crime", "detective", "pocketmemory"], "long_description": "\u25a3 \uac8c\uc784 \uc18c\uac1c\n\ub2f9\uc2e0\uc758 \uccab VR \ucd94\ub9ac\uac8c\uc784!\n\uc0ac\uac74 \ud604\uc7a5\uc758 \uc99d\uac70\ubb3c\ub9cc\uc73c\ub85c \ubc94\uc778\uc744 \ucd94\ub9ac\ud558\ub294 VR \ud06c\ub77c\uc784\uc52c!\n\ub1cc\uac00 \uc139\uc2dc\ud55c \ub2f9\uc2e0\uc744 \uc704\ud55c virtual reality Crime Scene Game, The Lost\n\ub2f9\uc2e0\uc774 \ubc14\ub85c \ucd94\ub9ac\uc758 \uc5ec\uc655?\n\n\ub354\ub85c\uc2a4\ud2b8\ub294 \uc720\uc800\uac00 \ud0d0\uc815\uc774 \ub418\uc5b4, \uc0b4\uc778 \uc0ac\uac74 \ud604\uc7a5\uc5d0\uc11c \uc99d\uac70\ubb3c\ub4e4\uc744 \ucc3e\uc544 \uc0b4\uc778 \ud2b8\ub9ad\uc744 \ud574\uacb0\ud558\uace0 \ubc94\uc778\uc744 \ucc3e\ub294 \uac00\uc0c1\ud604\uc2e4 \uac8c\uc784\uc785\ub2c8\ub2e4.\nVR \uae30\uc220\uc744 \ud1b5\ud574 \ud604\uc2e4\uac10 \uc788\ub294 \ubc94\uc8c4\ud604\uc7a5\uc744 \uc9c1\uc811 \ub3cc\uc544\ub2e4\ub2c8\uba74\uc11c \uc99d\uac70\ubb3c\uc744 \ubc1c\uacac\ud558\uc138\uc694.\n\uadf8\ub9ac\uace0 \ubc1c\uacac\ud55c \uc5ec\ub7ec \uc99d\uac70\ubb3c\ub4e4\uc5d0 \ub300\ud55c \uc815\ubcf4\ub97c \ubd84\uc11d\ud558\uc5ec \ubc94\uc778\uc744 \uac80\uac70\ud574\ubcf4\uc138\uc694.\n\uc544\uc9c1\ub3c4 \ube44\uba85\uc774 \ub4e4\ub9ac\ub294 \ub4ef\ud55c \ud604\uc2e4\uc801\uc778 \uc0ac\uac74 \ud604\uc7a5 \uc5b4\ub518\uac00\uc5d0\ub294 \uacb0\uc815\uc801\uc778 \uc99d\uac70\ubb3c\uc774 \uc874\uc7ac\ud558\uba70, \uadf8 \uc99d\uac70\ubb3c\ub85c \ubc94\ud589\uc758 \uc9c4\uc2e4\uc5d0 \ub2e4\uac00\uc124 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uc624\uc9c1 \ub2f9\uc2e0\ub9cc\uc774 \uc9c4\uc9dc \ubc94\uc778\uc744 \uc7a1\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4!\n\ub2f9\uc2e0\uc758 \uccab VR\ucd94\ub9ac\uac8c\uc784 [\ub354 \ub85c\uc2a4\ud2b8]\n\n\n\u25a3 \uac8c\uc784 \ud2b9\uc9d5\n\n\u25b7 \ucee8\ud2b8\ub864\ub7ec\uac00 \ud544\uc694 \uc5c6\ub294 VR \uac8c\uc784\n\n\ubcc4\ub3c4\uc758 \ucee8\ud2b8\ub864\ub7ec\ub294 \ud544\uc694\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\n\uba38\ub9ac\uc758 \uc6c0\uc9c1\uc784 \ub9cc\uc73c\ub85c \ubaa8\ub4e0 \uc870\uc791\uc744 \uc218\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\n\u25b7 \ud604\uc2e4\uac10 \ub118\uce58\ub294 \uadf8\ub798\ud53d\n\n\uc2e4\uc81c \uc0ac\uac74 \ud604\uc7a5\uc5d0 \uc9c4\uc785\ud55c \ub4ef\ud55c \uc0ac\uc2e4\uc801\uc778 \ubc30\uacbd\uc740 \ub354\uc6b1 \ucd94\ub9ac\uc5d0 \ubab0\uc785\ud560 \uc218 \uc788\ub3c4\ub85d \ub3c4\uc640\uc904 \uac83\uc785\ub2c8\ub2e4.\n\n\n\u25b7 \uc2dc\ub098\ub9ac\uc624\n\n\ubc1c\uc0dd\ud558\ub294 \uc0ac\uac74\ub4e4\uc5d0\ub294 \ubb34\uc5b8\uac00 \uc228\uaca8\uc838 \uc788\ub2e4?\n\ubc29\ub300\ud558\uace0 \ud0c4\ud0c4\ud55c \uad6c\uc131\uc758 \uac8c\uc784 \uc2a4\ud1a0\ub9ac!\n\uc2a4\ud14c\uc774\uc9c0\ub294 \ub9e4\ub2ec \uc5c5\ub370\uc774\ud2b8 \uc608\uc815\uc785\ub2c8\ub2e4.", "short_description": "The Lost :VR\ud06c\ub77c\uc784\uc52c. VR\uc744 \ud1b5\ud574 \uc99d\uac70\ubb3c\ub4e4\uc744 \ucd94\ub9ac\ud558\uc138\uc694\n\uac00\uc0c1\ud604\uc2e4 \uc18d\uc5d0\uc11c \uc9c4\uc9dc\ucc98\ub7fc \ub290\uaef4\uc9c0\ub294 \ubc94\uc8c4 \ud604\uc7a5!\n\uc99d\uac70\ubb3c\ub9cc\uc73c\ub85c \ubc94\uc778\uc744 \ucd94\uc801\ud558\uc138\uc694!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://pocket.dothome.co.kr/xe/wwPrivacyPolicy", "developer_terms_of_service_url": "http://pocket.dothome.co.kr/xe/TheLostpolicies", "publisher_name": "Pocket Memory", "support_website_url": null, "website_url": "http://pocketmemory.co.kr/xe/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "EXPLORATION", "ADVENTURE", "ARCADE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3121331614817483"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1953288791363348", "version": "1"}, "id": "637314263145364", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1949046181787609", "is_concep
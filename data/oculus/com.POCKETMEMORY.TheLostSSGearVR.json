HeC_kz5HeZvlsDK9XcZuYMSMt4RzM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs35PkgVR1qBMJvQVdTslJls8ZCzN_BuXlf70a9Lgu8gg&oe=699DACD5"}, {"file_name": "migrated_image.png", "id": "211743960177180", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162687_117093178808580_9207710172321939456_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpSeeCK-y-4Q7kNvwHb7Cxt&_nc_oc=Adl1KPYQ6fH5an7nD-A4ib4iAZGI1N8QkNxO2sywUWq5x1iWz9EdahAFHNUmmzFR5a0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvBcswRgxYGaCU4SSg3gmYHdyxvcNJ5GoPc8BVqUtXDTg&oe=699D9549"}, {"file_name": "migrated_image.png", "id": "811670542669116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162699_1453554234706375_6315181854609637376_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uI9luz09yocQ7kNvwFbZbFJ&_nc_oc=Adl2sdcdyt0UfcUNOU6HKHWRZTWhwPt5CnxXqP_w4cvUdDn3Op1hLBeDQZkZ-iRm4c4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsf5dMcSWZ-Vt4mPHvguZ3oce-uJdokW0zRQG0MncU4jg&oe=699DB4BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "THE LOST", "keywords": ["thelost", "vrgame", "crime", "detective", "pocketmemory"], "long_description": "\u25a3 \uac8c\uc784 \uc18c\uac1c\n\ub2f9\uc2e0\uc758 \uccab VR \ucd94\ub9ac\uac8c\uc784!\n\uc0ac\uac74 \ud604\uc7a5\uc758 \uc99d\uac70\ubb3c\ub9cc\uc73c\ub85c \ubc94\uc778\uc744 \ucd94\ub9ac\ud558\ub294 VR \ud06c\ub77c\uc784\uc52c!\n\ub1cc\uac00 \uc139\uc2dc\ud55c \ub2f9\uc2e0\uc744 \uc704\ud55c virtual reality Crime Scene Game, The Lost\n\ub2f9\uc2e0\uc774 \ubc14\ub85c \ucd94\ub9ac\uc758 \uc5ec\uc655?\n\n\ub354\ub85c\uc2a4\ud2b8\ub294 \uc720\uc800\uac00 \ud0d0\uc815\uc774 \ub418\uc5b4, \uc0b4\uc778 \uc0ac\uac74 \ud604\uc7a5\uc5d0\uc11c \uc99d\uac70\ubb3c\ub4e4\uc744 \ucc3e\uc544 \uc0b4\uc778 \ud2b8\ub9ad\uc744 \ud574\uacb0\ud558\uace0 \ubc94\uc778\uc744 \ucc3e\ub294 \uac00\uc0c1\ud604\uc2e4 \uac8c\uc784\uc785\ub2c8\ub2e4.\nVR \uae30\uc220\uc744 \ud1b5\ud574 \ud604\uc2e4\uac10 \uc788\ub294 \ubc94\uc8c4\ud604\uc7a5\uc744 \uc9c1\uc811 \ub3cc\uc544\ub2e4\ub2c8\uba74\uc11c \uc99d\uac70\ubb3c\uc744 \ubc1c\uacac\ud558\uc138\uc694.\n\uadf8\ub9ac\uace0 \ubc1c\uacac\ud55c \uc5ec\ub7ec \uc99d\uac70\ubb3c\ub4e4\uc5d0 \ub300\ud55c \uc815\ubcf4\ub97c \ubd84\uc11d\ud558\uc5ec \ubc94\uc778\uc744 \uac80\uac70\ud574\ubcf4\uc138\uc694.\n\uc544\uc9c1\ub3c4 \ube44\uba85\uc774 \ub4e4\ub9ac\ub294 \ub4ef\ud55c \ud604\uc2e4\uc801\uc778 \uc0ac\uac74 \ud604\uc7a5 \uc5b4\ub518\uac00\uc5d0\ub294 \uacb0\uc815\uc801\uc778 \uc99d\uac70\ubb3c\uc774 \uc874\uc7ac\ud558\uba70, \uadf8 \uc99d\uac70\ubb3c\ub85c \ubc94\ud589\uc758 \uc9c4\uc2e4\uc5d0 \ub2e4\uac00\uc124 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uc624\uc9c1 \ub2f9\uc2e0\ub9cc\uc774 \uc9c4\uc9dc \ubc94\uc778\uc744 \uc7a1\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4!\n\ub2f9\uc2e0\uc758 \uccab VR\ucd94\ub9ac\uac8c\uc784 [\ub354 \ub85c\uc2a4\ud2b8]\n\n\n\u25a3 \uac8c\uc784 \ud2b9\uc9d5\n\n\u25b7 \ucee8\ud2b8\ub864\ub7ec\uac00 \ud544\uc694 \uc5c6\ub294 VR \uac8c\uc784\n\n\ubcc4\ub3c4\uc758 \ucee8\ud2b8\ub864\ub7ec\ub294 \ud544\uc694\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\n\uba38\ub9ac\uc758 \uc6c0\uc9c1\uc784 \ub9cc\uc73c\ub85c \ubaa8\ub4e0 \uc870\uc791\uc744 \uc218\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\n\u25b7 \ud604\uc2e4\uac10 \ub118\uce58\ub294 \uadf8\ub798\ud53d\n\n\uc2e4\uc81c \uc0ac\uac74 \ud604\uc7a5\uc5d0 \uc9c4\uc785\ud55c \ub4ef\ud55c \uc0ac\uc2e4\uc801\uc778 \ubc30\uacbd\uc740 \ub354\uc6b1 \ucd94\ub9ac\uc5d0 \ubab0\uc785\ud560 \uc218 \uc788\ub3c4\ub85d \ub3c4\uc640\uc904 \uac83\uc785\ub2c8\ub2e4.\n\n\n\u25b7 \uc2dc\ub098\ub9ac\uc624\n\n\ubc1c\uc0dd\ud558\ub294 \uc0ac\uac74\ub4e4\uc5d0\ub294 \ubb34\uc5b8\uac00 \uc228\uaca8\uc838 \uc788\ub2e4?\n\ubc29\ub300\ud558\uace0 \ud0c4\ud0c4\ud55c \uad6c\uc131\uc758 \uac8c\uc784 \uc2a4\ud1a0\ub9ac!\n\uc2a4\ud14c\uc774\uc9c0\ub294 \ub9e4\ub2ec \uc5c5\ub370\uc774\ud2b8 \uc608\uc815\uc785\ub2c8\ub2e4.", "short_description": "The Lost :VR\ud06c\ub77c\uc784\uc52c. VR\uc744 \ud1b5\ud574 \uc99d\uac70\ubb3c\ub4e4\uc744 \ucd94\ub9ac\ud558\uc138\uc694\n\uac00\uc0c1\ud604\uc2e4 \uc18d\uc5d0\uc11c \uc9c4\uc9dc\ucc98\ub7fc \ub290\uaef4\uc9c0\ub294 \ubc94\uc8c4 \ud604\uc7a5!\n\uc99d\uac70\ubb3c\ub9cc\uc73c\ub85c \ubc94\uc778\uc744 \ucd94\uc801\ud558\uc138\uc694!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://pocket.dothome.co.kr/xe/wwPrivacyPolicy", "developer_terms_of_service_url": "http://pocket.dothome.co.kr/xe/TheLostpolicies", "publisher_name": "Pocket Memory", "support_website_url": null, "website_url": "http://pocketmemory.co.kr/xe/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "ARCADE", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7104261482948757"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162698_184660902063027_5194110521799868416_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGpGhaeaH_0Q7kNvwFm7XaL&_nc_oc=AdkOzO6pkHS77Qa52SFcBnaGqFOIA5qrIYNRA7rpaH5LMVJb-a9WaSkgH_q6M1RJwJI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsPwhHPeec9DoRC6O2qarwm5-GOY5dQA69vXd6nXSvISw&oe=699D9F94"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "THE LOST", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1497459600, "lastRevision": {"nodes": [{"id": "1335315253188663", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "19490
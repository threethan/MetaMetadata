ri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618251_904104315279605_6933979058777696366_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pi0d3iI5zYQ7kNvwGRtvoL&_nc_oc=AdqinW-aSYghw3Wkde5mbrnJGbJnYmgfJonCUZYwAXT5sYgqt0BCyWXcvy8DercGU40&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy_2dzSvWWLydIQzGxjyXR87Fq-mOdeUpL9mVbOwZEEtQ&oe=69C12B4C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape From The Zombie Granny House", "keywords": ["ZombieGranny", "EscapeHorrorGame", "HauntedHouseSurvival", "ScaryGrannyGame", "FirstPersonHorror"], "long_description": "Escape From The Zombie Granny House is an intense horror survival game that will test your courage and quick thinking. You find yourself trapped inside a creepy old mansion ruled by terrifying zombie grannies. Your mission is simple \u2014 survive, fight back, and escape before it\u2019s too late!\nArmed with limited weapons and resources, you must explore dark rooms, solve puzzles, and take down the attacking zombies that lurk around every corner. Each step could be your last as the zombie grannies hunt you relentlessly through the eerie corridors.\nStay quiet, stay alert, and use your skills to outsmart the undead. Will you make it out alive, or become their next victim? Find out in Escape From The Zombie Granny House \u2014 the ultimate fight for survival!", "short_description": "\"Escape From The Zombie Granny House\" \u2013 Battle scary zombie grannies, dodge their attacks, and escape the haunted house alive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/escape-zomby-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Horizon Hub", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonhubcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"
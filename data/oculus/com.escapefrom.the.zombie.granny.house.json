10&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MRvbeGSwXUQ7kNvwG_W6AN&_nc_oc=AdqTmECvoTPBe40UU7kH4NzLsHVnGfSWqRhXPg-VY2UBeUCHoHar8n4za0SOnMjKZBs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af30i_lgL1P6r0RDV-GxgIwLGFJ914r_LFGb4jE6RXAOvQ&oe=69F0CFDB"}, {"file_name": "2_2560x1440.png", "id": "904104311946272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618251_904104315279605_6933979058777696366_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7419mRrOWoQ7kNvwExBTHj&_nc_oc=AdqCZkOVOtIj0YfOFB8PXDmbWZ6K89wl2QFcfp6eCevEJJAjQjTgmFy8a9tCPKYo-iY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2fIB2ohEaW2pSwsMxgp1FicQqFhuaKvSXzmcY3YV5ULg&oe=69F0A14C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape From The Zombie Granny House", "keywords": ["ZombieGranny", "EscapeHorrorGame", "HauntedHouseSurvival", "ScaryGrannyGame", "FirstPersonHorror"], "long_description": "Escape From The Zombie Granny House is an intense horror survival game that will test your courage and quick thinking. You find yourself trapped inside a creepy old mansion ruled by terrifying zombie grannies. Your mission is simple \u2014 survive, fight back, and escape before it\u2019s too late!\nArmed with limited weapons and resources, you must explore dark rooms, solve puzzles, and take down the attacking zombies that lurk around every corner. Each step could be your last as the zombie grannies hunt you relentlessly through the eerie corridors.\nStay quiet, stay alert, and use your skills to outsmart the undead. Will you make it out alive, or become their next victim? Find out in Escape From The Zombie Granny House \u2014 the ultimate fight for survival!", "short_description": "\"Escape From The Zombie Granny House\" \u2013 Battle scary zombie grannies, dodge their attacks, and escape the haunted house alive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/escape-zomby-privacy-policy/home", "developer_terms_of_servi
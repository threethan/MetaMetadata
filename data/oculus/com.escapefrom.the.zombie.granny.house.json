? Find out in Escape From The Zombie Granny House \u2014 the ultimate fight for survival!", "short_description": "\"Escape From The Zombie Granny House\" \u2013 Battle scary zombie grannies, dodge their attacks, and escape the haunted house alive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/escape-zomby-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Horizon Hub", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonhubcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24908346865442237"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1438503454480502"}, {"status": "PUBLISHED", "id": "941639118291323"}, {"status": "PUBLISHED", "id": "863065419923041"}, {"status": "PUBLISHED", "id": "855858047202802"}, {"status": "PUBLISHED", "id": "1347496890144443"}]}, "baseline_offer": {"id": "1347496890144443"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "1438503454480502"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25025268597083396", "version": "1.5"}, "id": "1083843813640944", "channel_name": "LI
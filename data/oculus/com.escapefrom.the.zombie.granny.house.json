rZd4BYNIg-FVj1evJNgQ9Ap2qNUXR3dMoR1p3w&oe=69F0BAF8"}, {"file_name": "Screenshot_2.png", "id": "1311396800284015", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619174_1311396803617348_6863091031000431230_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqSibDZuwcwQ7kNvwHsTQ_3&_nc_oc=AdrLMCnsk-eFzwq4iKFAd-yytGj3wm7WEmyOLUadggLUohSXJUkfz0olX2k9TmMwIvQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af34klKFzc3Vr1-WOLTmJ2fRLqRU1WDgCTHPaxDL8xSdlQ&oe=69F0A391"}, {"file_name": "Screenshot_5.png", "id": "1126690806328074", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618499_1126690812994740_4815853723580568436_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8sOzGlEiFcQ7kNvwEbYV0v&_nc_oc=AdqdKPgxs27c8D8_XJJ-Xscm79TV6pLAZhtWXRn_licQTapeiwjqnHPdkqqPRhSR9KY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0aC5kUdiFQvMFblWNIS0IkqMLIVnETLQIT11U6ep8B2w&oe=69F0B8E4"}, {"file_name": "Screenshot_1.png", "id": "1595985794696757", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617775_1595985798030090_3022177743003017911_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dccAODBzbvAQ7kNvwEE890w&_nc_oc=AdqlB0KR0A5bo3UzZe5CgTi39tAPxIZOzmI1Wd2qimOFQCKOcxNbuu19HUQftdQkJSk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0hIMejXt-w0kQW2-F2FadhUan59t5Mi9OMd4pe_kVwXg&oe=69F0B72C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape From The Zombie Granny House", "keywords": ["ZombieGranny", "EscapeHorrorGame", "HauntedHouseSurvival", "ScaryGrannyGame", "FirstPersonHorror"], "long_description": "Escape From The Zombie Granny House is an intense horror survival game that will test your courage and quick thinking. You find yourself trapped inside a creepy old mansion ruled by terrifying zombie grannies. Your mission is simple \u2014 survive, fight back, and escape before it\u2019s too late!\nArmed with limited weapons and resources, you must explore dark rooms, solve puzzles, and take down the attacking zombies that lurk around every corner. Each step could be your last as the zombie grannies hunt you relentlessly through the eerie corridors.\nStay quiet, stay alert, and use your skills to outsmart the undead. Will you make it out alive, or become their next victim? Find out in Escape From The Zombie Granny House \u2014 the ultimate fight for survival!", "short_description": "\"Escape From The Zombie Granny House\" \u2013 Battle scary zombie grannies, dodge their attacks, and escape the haunted house alive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/escape-zomby-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Horizon Hub", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonhubcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24908346865442237"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1261409346061017"}, {"status": "PUBLISHED", "id": "2145975599545818"}, {"status": "PUBLISHED", "id": "1438503454480502"}, {"status": "PUBLISHED", "id": "941639118291323"}, {"status": "PUBLISHED", "id": "863065419923041"}, {"status": "PUBLISHED", "id": "855858047202802"}, {"status": "PUBLISHED", "id": "1347496890144443"}]}, "baseline_offer"
2847", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618499_867697029116180_1383184385338391559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rb24zPo-VKgQ7kNvwGs_Cql&_nc_oc=Ado1cpv0sbD_unntmCQKM1JuOXVQdOMQd81EMb0zvlybrXkqnd3kPO13LOhdt01pRbo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKyMhg1nPBlOqamH8CKpv-5XDPOjRtROIMkWv5Pz1yhw&oe=6A8D7A1B"}, {"file_name": "2_2560x1440.png", "id": "904104311946272", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618251_904104315279605_6933979058777696366_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4xAlBwXA9IQ7kNvwHutt1K&_nc_oc=AdqjNX986p6Bbzv1CAxfXNZwiRIBEjL9z3IAPQ7eAz9qPkYzRecIXu_iW0njA_1IpnM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1huDUQzTzDp3ZLfRmC45CCn-ZrDZuuS5e4CTeOWpUEg&oe=6A8D83CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape From The Zombie Granny House", "keywords": ["ZombieGranny", "EscapeHorrorGame", "HauntedHouseSurvival", "ScaryGrannyGame", "FirstPersonHorror"], "long_description": "Escape From The Zombie Granny House is an intense horror survival game that will test your courage and quick thinking. You find yourself trapped inside a creepy old mansion ruled by terrifying zombie grannies. Your mission is simple \u2014 survive, fight back, and escape before it\u2019s too late!\nArmed with limited weapons and resources, you must explore dark rooms, solve puzzles, and take down the attacking zombies that lurk around every corner. Each step could be your last as the zombie grannies hunt you relentlessly through the eerie corridors.\nStay quiet, stay alert, and use your skills to outsmart the undead. Will you make it out alive, or become their next victim? Find out in Escape From The Zombie Granny House \u2014 the ultimate fight for survival!", "short_description": "\"Escape From The Zombie Granny House\" \u2013 Battle scary zombie grannies, dodge their attacks, and escape the haunted house alive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/escape-zomby-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Horizon Hub", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonhubcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW", "ja", "de", "fr", "it", "ko", "pt", "es_MX", "th"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26264729006470676"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618432_1222311426470615_191703431815536121_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuUKYDmqiIEQ7kNvwGsyAE5&_nc_oc=AdpR3_wRON-AWtU02z3hP3VFHOAcY8Rp6hRB5dFJrBq-Sb-DPUyuPAzoUUNCm0IuFaU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzzFmwtwXjERG9DOHfrJGjejh3VaeV7ZOFA3PA4n2X3Q&oe=6A8D8441"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Escape From The Zombie Granny House", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "6443548731
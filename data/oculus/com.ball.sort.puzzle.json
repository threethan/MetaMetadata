s=7f20f&oh=00_AQM-6EgNOKbeenAQpEsPd5hhtM8tOCOVTTm-Rx_LC08sgA&oe=6ACE568E"}, {"file_name": "4.png", "id": "1491066843018276", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310646_1491066849684942_4020588352631429724_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJBR-cuyaZIQ7kNvwGOiRSM&_nc_oc=AdrFO0lgkOruV4T2JWu_klVysDwE9eF085B6t9xDNRLaDz3velMsBuGpNjO2HyO6-fA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmPRAZM2G8CViGxt5zLuMKfwhiz6IaTekV65Zr8Y1MZQ&oe=6ACE4840"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1044241568552054", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310734_1044241571885387_5384584488402049194_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fHgQHaU1wQQ7kNvwGrBCyp&_nc_oc=Adojh_zT344JC6djFX1xNq_6QXLJ5S8KihB3DlLRap42HfgOfQgv2iPSZoJZkO0gwOw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvF6TR5pZjLEn3gSiCuJyaj4tjoOS0grvCFFFdw59VrQ&oe=6ACE4B7E"}, "display_name": "Ball Sort Puzzle", "keywords": ["ballsort", "ColorBall", "SortPuzzle", "Puzzle", "Sort"], "long_description": "Ball Sort Puzzle: Color Sort \u2014 Relaxing Tube Sort Puzzle Game\nLooking for a puzzle game that's actually relaxing? Sort colored balls into matching tubes at your own pace \u2014 no timer, no pressure, just pure satisfying gameplay.\n\ud83c\udfaf SIMPLE TO LEARN, FUN TO MASTER\n\nTap a tube to lift the top ball; tap another to drop it in. Group every ball by color until each tube holds a single color. That's it, no complicated rules, just smooth, intuitive fun.\n\ud83e\udde9 A BRAIN GAME THAT DOESN'T FEEL LIKE WORK\n\nThis isn't a race against the clock. Take your time, think through each move, and enjoy the calm, meditative rhythm of solving each puzzle. Perfect for a quick break, a commute, or unwinding before bed.\n\u2728 WHAT MAKES THIS DIFFERENT\n\nHundreds of levels, from easy warm-ups to genuine brain-teasers\nNo aggressive ad interruptions breaking your focus\nUndo/redo moves freely \u2014 mistakes are part of the fun, not a penalty\nClean, minimal design that's easy on the eyes\nWorks offline \u2014 play anywhere, anytime\nRegular new levels and challenges added\n\n\ud83c\udf08 WHO IT'S FOR\n\nWhether you love classic logic puzzles, color matching games, or just need a stress-relief game for downtime, this color sort puzzle delivers a calm, satisfying challenge every single level.\n\ud83d\udce5 Download now and start sorting \u2014 your brain (and your nerves) will thank you.", "short_description": "Ball Sort Puzzle game, calm your mind. No timer, no pressure \u2014 just satisfying puzzles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1192218543980409"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1001581782512678"}]}, "baseline_offer": {"id": "1001581782512678"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784220900, "status": "PUBLISHED", "id": "1001581782512678"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_res
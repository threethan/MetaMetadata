3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUJnpQ97oMODXTw9hnqUpD5iJS2M4OwhKKQXkQGwUDYxw&oe=6B1036F7"}, {"file_name": "1.png", "id": "1700645457811590", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507833663_1700645464478256_1663283816925960963_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVlL2iCif8EQ7kNvwEHGjhk&_nc_oc=Adpda-3OtXCdZZeJ_qM0v7AZrxBX_OtkOFnBXtfwYSq0TVCen_7seGo7TAXH9ndpcew&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUG9YNeFP6qzDBu3ztSFCEtaf3ID4t7CR52icc5TEwF_Q&oe=6B10418E"}, {"file_name": "4.png", "id": "1491066843018276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310646_1491066849684942_4020588352631429724_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEyzvAT8tR0Q7kNvwEVPlUN&_nc_oc=AdoaUW6nyanLBQuguXinwYXI95Gk6ORaKJvv3b1mBLMQxfpjkTjCaArbLmcDGI_5lKA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUHGodDpl-MjFliTPSrLjoWXbs7Xxa1NncuQXQ6OjnJNA&oe=6B106B80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1044241568552054", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310734_1044241571885387_5384584488402049194_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmRLIKS5XoAQ7kNvwFhBEjN&_nc_oc=Adp3zPntmWRm1H2v1bYRLySSosqUqi_aLUeFd_H9RAUWGT3TAX8OYLUKsRkC8liKxww&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW7s8_HdLeBBqGWCEk7tmHGj0QGVWXoLpNlGpKAIYXbjw&oe=6B10367E"}, "display_name": "Ball Sort Puzzle", "keywords": ["Puzzle", "Relaxation", "Casual", "Color", "Tabletop"], "long_description": "BALL SORT PUZZLE VR \u2014 3D COLOR SORTING FOR META QUEST\n\nPick up glowing color balls with your own hands and sort them into matching tubes \u2014 all in full virtual reality. Ball Sort Puzzle VR transforms the world's most addictive casual puzzle game into an immersive 3D VR experience that you can only get on Meta Quest.\n\nThis is not a flat-screen port. Sorting in VR space, reaching into neon-lit tubes, watching colors click into place around you \u2014 it is a completely different experience to playing on a phone or tablet. Calming, satisfying, and surprisingly hard to put down.\n\n200 LEVELS. HOURS OF PLAY.\nStart with simple, relaxing color sorts and work your way through 200 hand-crafted levels of increasing challenge. Use Undo, Hints, and Add Tube when you get stuck. No time limits. No pressure. Just pure puzzle satisfaction.\n\nFEATURES\n- 200 levels of color sorting puzzle gameplay\n- Full VR hand interaction \u2014 reach in and sort with your hands\n- Stunning neon visuals in immersive 3D environments\n- Relaxing brain-training gameplay for all ages\n- Undo, hints, and extra tube power-ups\n- Compatible with Meta Quest 2, Quest 3 and Quest 3S\n- No PC required \u2014 fully standalone VR\n\nThe most satisfying puzzle on Meta Quest. Pick it up, sort it out.", "short_description": "Sort glowing 3D balls into tubes in full VR. 200 levels of relaxing, brain-training puzzle gameplay built for Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tra
587_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v573I7Hvz_oQ7kNvwEw8yuW&_nc_oc=AdrcNaB0cDBIH4JG3UWh7UEMEI39dJXAEn4EuggcQ3joyO161bZBlafJZ-vGOTTIIVU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcSZCDRs3PtBbLAXwKfhhyLp-0OKfuiVILbeVRtF9vvw&oe=6ACFA50C"}, {"file_name": "3.png", "id": "1953899562680715", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499311597_1953899569347381_3797868671866991172_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qvMuf2N1_8Q7kNvwHjI94f&_nc_oc=AdpmSc_Di1BQ5xDteKorCyxmnDAKHmADYVNG5t6hZF6sNMw4UwvZVCe-XUbudOWOLoI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsJXnp89zB3cnRy_M8BsN423LWOZ39Q82GDh3l8y7VpA&oe=6ACF9D77"}, {"file_name": "1.png", "id": "1700645457811590", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507833663_1700645464478256_1663283816925960963_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfOsd0GMuzkQ7kNvwEg8U9P&_nc_oc=AdptWa7c0Stv7Ebr-S4MxYGp1doicZLsZC6KJknFKY1H975QAmVR3yNvfQD7Wif-p2k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQME5pC1wMueTs41coTiiW9HecnlgSE6EehYHSpgUX7m0w&oe=6ACFA80E"}, {"file_name": "4.png", "id": "1491066843018276", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310646_1491066849684942_4020588352631429724_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJBR-cuyaZIQ7kNvwGiKwfZ&_nc_oc=Adoub77sRVKLGjhtIA3zaY-7oe6GeQPLRZL6kd3rdyvz6J011bSB6s2Mu9jN0SmtFlc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNc7-5JBr0sYUJAfKmB-ueuIGRw7MJNKOhxXypJqNZlqg&oe=6ACF99C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1044241568552054", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310734_1044241571885387_5384584488402049194_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fHgQHaU1wQQ7kNvwEUn8L-&_nc_oc=Adq9vEoodDtF3tZbQWeldnQW2MJUMNUfxlRpvd7WaJol2MJbH2U5iAtay40UpIF1LcY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPz2Dft7kNaygG5v25UOdS24ZSIHsgScu3KkhyRy3tNeQ&oe=6ACF9CFE"}, "display_name": "Ball Sort Puzzle", "keywords": ["Puzzle", "Relaxation", "Casual", "Color", "Tabletop"], "long_description": "BALL SORT PUZZLE VR \u2014 3D COLOR SORTING FOR META QUEST\n\nPick up glowing color balls with your own hands and sort them into matching tubes \u2014 all in full virtual reality. Ball Sort Puzzle VR transforms the world's most addictive casual puzzle game into an immersive 3D VR experience that you can only get on Meta Quest.\n\nThis is not a flat-screen port. Sorting in VR space, reaching into neon-lit tubes, watching colors click into place around you \u2014 it is a completely different experience to playing on a phone or tablet. Calming, satisfying, and surprisingly hard to put down.\n\n200 LEVELS. HOURS OF PLAY.\nStart with simple, relaxing color sorts and work your way through 200 hand-crafted levels of increasing challenge. Use Undo, Hints, and Add Tube when you get stuck. No time limits. No pressure. Just pure puzzle satisfaction.\n\nFEATURES\n- 200 levels of color sorting puzzle gameplay\n- Full VR hand interaction \u2014 reach in and sort with your hands\n- Stunning neon visuals in immersive 3D environments\n- Relaxing brain-training gameplay for all ages\n- Undo, hints, and extra tube power-ups\n- Compatible with Meta Quest 2, Quest 3 and Quest 3S\n- No PC required \u2014 fully standalone VR\n\nThe most satisfying puzzle on Meta Quest. Pick it up, sort it out.", "short_description": "Sort glowing 3D balls into tubes in full VR. 200 levels of relaxing, brain-training puzzle gameplay built for Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category
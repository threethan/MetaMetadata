6033568", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75340703_335814359366901_611001222958945882_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mm2cHGSiqj4Q7kNvwFOcZFZ&_nc_oc=AdqbgZaIQsuKqJH1CMUPDKNfIZNOTQghKDXIhzgnl3rb7kiheN2hg-Mudk16M9Y4Kto&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDEszM2JR_FKE0FUVAvAci5ftNTVFGTSSQa-6-J1tAbQ&oe=6AA4134F"}, {"file_name": "scrShot2.png", "id": "569012208775044", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031378_569012212108377_6772409458638556045_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3GpaqtpHcYQ7kNvwE7rzuz&_nc_oc=Adr0V2gU5YHGi7xNA-qnPk1nl0sJ7TgfY-5mjZUG6ur61U-RKoIewWbPuHx-cSWIFLw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEzR9d_IbC7N_5CecRwuniQrTyCwigyuAHigqiBPLffA&oe=6AA41072"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fistagonLogo_wide_v2_qhd.png", "id": "337685965823390", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982581_337685969156723_8225887744436180005_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5klpG_PZsAoQ7kNvwHjCgmj&_nc_oc=Adp1ifLaspxaoMHFtfosr1Y8OXtsvdFr7HgdmsAw82H3SG4OwE15UtxtgxgccnDonow&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhLxGO-w0gi4KLVbjlcI2LendK0jKLFvLU0nDWI2rQ3w&oe=6AA3FD7D"}, "display_name": "FISTAGON", "keywords": [], "long_description": "Unleash Your fists in the sport of the future and become the FISTAGON Champion!  \n\u25aa\ufe0f Punch blocks.\n\u25aa\ufe0f Create combos.\n\u25aa\ufe0f Score big.\n\u25aa\ufe0f Drop your opponent.\n\u25aa\ufe0f Advance on leaderboards.\n\n\u2b50 Official selection for Top 80 indie games-category in Tokyo Game Show 2023 \u2b50\n\n\ud83d\udc4a Hard hitting punching mechanics: Hit harder and hit accurately for best scores.\n\n\u2728 Varied Arenas: Conquer diverse grid-arenas with unique challenges. \n\n \ud83d\udca5 Special Blocks Galore: Face variety of special blocks like magnetic, explosive, handedness swap and others!\n\n\ud83d\udcaa Unique Characters: Choose your National Fister from variety of unique athletes.\n\n\ud83c\udfae Easy to Learn, Tough to Master: FISTAGON is accessible for all, but only the best rise to the top.\n\n\ud83c\udf10 Online Multiplayer Mayhem: Crush rivals in one-on-one showdowns. Your goal: drop opponents from their platforms with high-scoring combos. Challenge fisters worldwide! \n\nCompete, Conquer, and FISTAGON! \nMaster the art of punching, dominate the tournaments, and etch your name in FISTAGON history! ", "short_description": "FISTAGON, the fist-fighting sports extravaganza!\n \nPunch blocks, strategize combos, score big, and rise to the top of leaderboards with your favourite national FISTAGON athlete, or challenge friends and strangers to one vs one online match!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vd-games.com/Virtual_Dawn_Privacy_Policy_11112023_meta.pdf", "developer_terms_of_service_url": null, "publisher_name": "Virtual Dawn", "support_website_url": null, "website_url": "https://virtual-dawn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "9656827417665803"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2091989334898427"}, {"status": "PUBLISHED", "id": "1411599083265031"}]},
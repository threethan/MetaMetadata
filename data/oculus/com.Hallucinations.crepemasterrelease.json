.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1S-3zHNDa4Q7kNvwHf3OT8&_nc_oc=AdpuN3i1tknYGmyVZKkFiKTyxf47IbF7MLkyVr-V-lNKSqeEfmTTDzZUQT15t4eeVUY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxXYepml4Fl56bxMbPPTFAgzrts5FT8JLl0iQWrUxCkw&oe=6A637A23"}]}, "id": "906189725364162", "locale": "en_US", "screenshots": [{"file_name": "10.png", "id": "910020958492248", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821674_910020961825581_1676646001552535186_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-QCLinGNiQQ7kNvwH85ALa&_nc_oc=AdoIZWTycOPNk-JyyFgG9y7KSfneqDBkj81iIF_uF7pexvyR3unn8YA5A_6HZqMY2-E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKQB1-mpTNYYJGRgbM5JS_mbKt-JqFmogL4iBMcNz4XQ&oe=6A6355DC"}, {"file_name": "4.png", "id": "1297792292244898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823286_1297792295578231_1310021898201132546_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tsvB_YyRMAQ7kNvwEoRBTA&_nc_oc=AdpSssOqb2de9zUcu7tzuMj3EGAdDJ0Qv7PH5jgI8MPPa4u3J-WUL_Cya2LBg_oMTTE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkFrQrN5ErAPEcSiI22ACLsmtyMkoeSy5jSYwfZiOYBQ&oe=6A636743"}, {"file_name": "7.png", "id": "1424985075607446", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822550_1424985078940779_5550344522594263974_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4rann5PPDYQ7kNvwHiXqPe&_nc_oc=AdqL6lm6QqWX-DY0tij-y8YeyQ-Z9O83sLuRRv2nk5vVhm13DRUXdD-H6SqIeGbNxpA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBjhKrIS7YMidWwaXqmFTz4dNizY73yKny5DLesx9-8A&oe=6A637B2C"}, {"file_name": "9.png", "id": "1422471648869413", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828050_1422471652202746_3110232475221005870_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0kzEkHdeCEQ7kNvwGWlKwh&_nc_oc=AdpLr7lPpg9WPIhFoJOUZwmzX_PUr_5XnPD4R03IruFlM78cGHGTEN5GEFVGfeo6aOg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmXTfjNd-TnciXkp_5WkuIb1HUBFUi1GuUAz9w6UhvQA&oe=6A635A9D"}, {"file_name": "2.png", "id": "1925251701697621", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821696_1925251708364287_5148718230281366540_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lScsY4SdDqAQ7kNvwFyS9-8&_nc_oc=AdoUpKQiw02bKdFurfrsy92xKxKtmJdxxFiYsdY5xjmXu6RKxLy0XzdzP-G-IobfMPU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBn8_J2lSiGdxl0gGqsYwyXZjcvBDSI9_4WUk5Cw3VYzA&oe=6A636A57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Miniature youtube.png", "id": "948265401147327", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823270_948265404480660_2786606701152126884_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=im32dF3sZpMQ7kNvwHQc6ZP&_nc_oc=AdpUp8ZvN_jpkGKxAh_GChKmi2hQIAVY7N49R4Kh_DTjHwQ8n3kSmGuYhrAr1CsC_pk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPacNp-FZoyKwAdTT47HnoHn8hQKTawTsrPGfgnlACPQ&oe=6A635AB8"}, "display_name": "Cr\u00eape Master!", "keywords": ["adventure", "combat", "craft", "magic", "magicalgirl"], "long_description": "**Cr\u00eape Master!** is a fun, solo beat them all adventure in a colorful magical-girl style. Become the reincarnation of the Cr\u00eape Goddess and defend Earth against an alien invasion that threatens the world\u2019s most beloved treat.\n\n# Features\n\n**YOUR WEAPON IS\u2026 A PAN!**\n{1464856455317006}\n\nSwing, and bonk with all your energy in a fast, frantic fight. Break their guards, knock them out, and recover the stolen ingredients to save the world.\n\n**MAGICAL GIRL POSE**\n{1433306058531539}\n\nEver dreamed of being a magical girl and striking those iconic poses? Now you can. Recreate them with your own arms in real life to invoke Cr\u00eape Magic and unleash powerful spells.\n\n**CRAFT TO BOOST YOUR SPELLS**\n{1646149939733127}\n\nAs the adventure intensifies, you\u2019ll need stronger magic. Go into a Crepo-Trance, grab the right ingredients, and cook cr\u00eapes at lightning speed to power up your abilities.\n\n**YOUR STORY: YOU ARE HANA, THE REINCARNATION OF THE CR\u00caPE GODDESS**\n\nIn the far reaches of space, a ruthless tyrant has sworn to destroy the cr\u00eape, the universal symbol of joy and community.\n\nOn Earth, a student named Hana discovers a ruby-studded pan. By seizing it, she awakens the powers of the legendary Cr\u00eape Goddess.\n\nIf the cr\u00eape disappears, the world will fall with it. It\u2019s time to fight back.\n", "short_description": "Cr\u00eape Master! is a fun, solo beat 'em up adventure in a colorful magical-girl style. Become the reincarnation of the Cr\u00eape Goddess and defend Earth against an alien invasion that threatens the world\u2019s most beloved treat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wip.hallucinations-studio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Hallucinations Studio", "support_website_url": null, "website_url": "https://WWW.hallucinations-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26127987813517425"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "986953334149830"}, {"status": "PUBLISHED", "id": "1995068368043398"}, {"status": "PUBLISHED", "id": "1466996241287065"}
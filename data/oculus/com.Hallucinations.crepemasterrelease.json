qg&oe=6A63801C"}, {"file_name": "Image 2026-04-24 092247_1.1.4.png", "id": "1614540926514922", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_1614540933181588_8286562482221778321_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oLyA1HZuGcQ7kNvwEn50cj&_nc_oc=AdoT-c95raFWrmluIUS20vraDp15_a18lGE7dB_JU7EfzGb0yrpXqy6JpUupU8J7hvk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlTkp2qgywHMW7bgogftxqejZzNd-KM7KIcv1pqnHArA&oe=6A636B94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NEW KEY ART JUIN.png", "id": "1518045269851159", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827987_1518045273184492_9222432684237929650_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tO7Lzo8UoDEQ7kNvwGRju-o&_nc_oc=Adrpsr41ox1DUGo4otu5dxmTxMvxmXHOB2kifRFCUqwueoMmnFQUhPYnnzgaj192G_o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHsPCu-rPrLIqf_yng0xtdFVBtxt-ejuk7U_i-GlAAAQ&oe=6A636BCA"}, "display_name": "Cr\u00eape Master!", "keywords": ["aventure", "combat", "magie", "magicalgirl", "fabrication"], "long_description": "La Cr\u00eape est cuite... \u00e0 moins que VOUS ne la sauviez !\n\nCombattez une invasion extraterrestre avec l'arme la plus l\u00e9gendaire jamais cr\u00e9\u00e9e : UNE PO\u00caLE.\n\nEcrasez, assommez et envoyez vos ennemis voler \u00e0 travers le champ de bataille dans des combats VR rapides et explosifs. Les extraterrestres ont vol\u00e9 les ingr\u00e9dients sacr\u00e9s de la Sainte Cr\u00eape, et c'est \u00e0 vous de les r\u00e9cup\u00e9rer avant que la Terre ne soit condamn\u00e9e pour toujours.\n\nMais vous n'\u00eates pas qu'un simple guerrier. Vous \u00eates une Divinit\u00e9 Magique de la Cr\u00eape. Utilisez la Magie de la Cr\u00eape et d\u00e9cha\u00eenez des pouvoirs d\u00e9lirants\n\n# Features\n**VOTRE ARME ?\u2026 UNE PO\u00caLE !**\n\n{2303653250123446}\n\nAss\u00e9nez des coups avec toute votre \u00e9nergie dans des combats rapides et fr\u00e9n\u00e9tiques. Brisez leurs gardes, mettez-les K.O., et r\u00e9cup\u00e9rez les ingr\u00e9dients vol\u00e9s pour sauver le monde.\n\n**DES POSES \u00c9PIQUES**\n\n{916019357990545}\n\nDans Cr\u00eape Master! les boutons c'est pour les nuls. Prenez des poses magiques et r\u00e9alisez des gestes avec vos mains pour d\u00e9clencher de puissants sorts. \n\n**CUISINEZ POUR BOOSTER VOS SORTS**\n\n{1673696280456853}\n\n\u00c0 mesure que l\u2019aventure s\u2019intensifie, votre magie devra gagner en puissance. Entrez en Cr\u00e9po-Transe, attrapez les bons ingr\u00e9dients, et cuisinez des cr\u00eapes \u00e0 la vitesse de l\u2019\u00e9clair pour renforcer vos capacit\u00e9s.", "short_description": "Cr\u00eape Master est une aventure VR compl\u00e8tement folle o\u00f9 vous affrontez des extraterrestres avec l'arme la plus l\u00e9gendaire de tous les temps : une po\u00eale \u00e0 cr\u00eape. \u00c9crasez vos ennemis, lancez de puissants sorts de Cr\u00eape Magique gr\u00e2ce \u00e0 des contr\u00f4les bas\u00e9s sur les gestes . Sauver le monde n'a jamais \u00e9t\u00e9 aussi d\u00e9licieux."}, {"images": {"nodes": [{"file_name": "icone.png", "id": "2396646700822704", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823837_2396646704156037_7091107545758833827_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5tcSABUO4cQ7kNvwEVNrtT&_nc_oc=Adoe-Lk0H7LhpfQ_CNFYNRTx2E3AqH9GsC7Sh3zgs_b7m8PB7q2HfA_H3SvfmMbrBCA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlPcEAG4r9Q94EA8gEdlBnfSe1PCMsxspbX5gHa0TlWA&oe=6A63669B"}, {"file_name": "Rework key art  (1440 x 1440 px).png", "id": "1882302772460184", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_1882302779126850_6102458272278061477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMftsSv4DZwQ7kNvwG7KWiH&_nc_oc=Adpn8D-lBymQixME5xYnPf4nJDRmj7XokPKaEOaxgVYD8LjDcsCziOMG840Y0C_zEMg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f
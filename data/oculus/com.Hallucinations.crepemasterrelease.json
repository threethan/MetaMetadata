qVnf-dalg&oe=6A1C513A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Miniature youtube.png", "id": "948265401147327", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491823270_948265404480660_2786606701152126884_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_QoxCYnmF0Q7kNvwGDRrVs&_nc_oc=AdolI9s76CxZAO-vixoYA5_aQMUnIHQJVofkSrFprOQ9r5-2dKElR_ARuZGOFzdzXYw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qSKp5LN_9SV1L1Fz6hYQxDgpvKs0dDFowzJkYJWKsYA&oe=6A1C29B8"}, "display_name": "Cr\u00eape Master!", "keywords": ["adventure", "combat", "craft", "magic", "magicalgirl"], "long_description": "# BATTERED, BUT STILL UNBEATEN!\n\n**Cr\u00eape Master!** is a fun, solo beat them all adventure in a colorful magical-girl style. Become the reincarnation of the Cr\u00eape Goddess and defend Earth against an alien invasion that threatens the world\u2019s most beloved treat.\n\n# Features\n\n**YOUR WEAPON IS\u2026 A PAN!**\n{1464856455317006}\n\nSwing, and bonk with all your energy in a fast, frantic fight. Break their guards, knock them out, and recover the stolen ingredients to save the world.\n\n**MAGICAL GIRL POSE**\n{1433306058531539}\n\nEver dreamed of being a magical girl and striking those iconic poses? Now you can. Recreate them with your own arms with **gesture-based controls** to invoke Cr\u00eape Magic and unleash powerful spells.\n\n**CRAFT TO BOOST YOUR SPELLS**\n{1646149939733127}\n\nAs the adventure intensifies, you\u2019ll need stronger magic. Go into a Crepo-Trance, grab the right ingredients, and cook cr\u00eapes at lightning speed to power up your abilities.\n\n**YOUR STORY: YOU ARE HANA, THE REINCARNATION OF THE CR\u00caPE GODDESS**\n\nIn the far reaches of space, a ruthless tyrant has sworn to destroy the cr\u00eape, the universal symbol of joy and community.\n\nOn Earth, a student named Hana discovers a ruby-studded pan. By seizing it, she awakens the powers of the legendary Cr\u00eape Goddess.\n\nIf the cr\u00eape disappears, the world will fall with it. It\u2019s time to fight back.\n", "short_description": "Cr\u00eape Master! is a beat \u2018em up VR adventure where you transform into a magical girl! Become the reincarnation of the Cr\u00eape Goddess, defend your home against an alien invasion, and stop the ruthless tyrant threatening the Earth\u2019s most beloved treat. Saving the world has never been tastier."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hallucinations-studio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Hallucinations Studio", "support_website_url": null, "website_url": "https://hallucinations-studio.com/crepe-master/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26695721746744026"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499307435_1940922143480849_5281589781219488950_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtkV8Fr6uhwQ7kNvwEw7pJf&_nc_oc=Ado_mzaEH2M84ykv4ln7bXoFNrDwuA9ZC6rCd2Kg3nRRLHjCot2otv76RODDGKSZKgA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aZik7g9QuS6trgtuVqKa-Zv4pKVBzTIEA378Q0H6H7A&oe=6A1C3E9E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "displ
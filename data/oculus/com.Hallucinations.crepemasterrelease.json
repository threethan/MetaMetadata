78rMWXuHV59TzHIYg&oe=6A1C4F1C"}, {"file_name": "Image 2026-04-24 092247_1.1.4.png", "id": "1614540926514922", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491823783_1614540933181588_8286562482221778321_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMq6mypGy48Q7kNvwFFfKCO&_nc_oc=AdrdGZmHglf6IlGB33xdN4SLVh9dnYnaAKqHGqX6u6BIX3Ygym067BEG1jjdM_z3NOo&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Df6MSECNck-bbwTP8w77lUu5z6R7YWF8jpux7qD2XFA&oe=6A1C3A94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Miniature youtube (2560 x 1440 px).png", "id": "1479033553619034", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491823448_1479033556952367_2488014673045865721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CREDiqwldU4Q7kNvwEtRl-G&_nc_oc=AdplM8-tG4EL6YrQRUNawQNNMhpdchY1doPoGn4EoWFkeIftW7vqA-ymqkl-BN5Lq7Y&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6koXd9DcLGEQfs44NsaSAVUptX_bJgTzXGbXPE2wyIjg&oe=6A1C4574"}, "display_name": "Cr\u00eape Master!", "keywords": ["aventure", "combat", "magie", "magicalgirl", "fabrication"], "long_description": "**Cr\u00eape Master!** est un beat them all color\u00e9, inspir\u00e9 des magical girl et compl\u00e8tement d\u00e9jant\u00e9. R\u00e9incarnez vous en D\u00e9esse de la Cr\u00eape et d\u00e9fendez la Terre contre une invasion extraterrestre qui menace la gourmandise la plus ador\u00e9e au monde.\n\n# Features\n**VOTRE ARME ?\u2026 UNE PO\u00caLE !**\n\n{2303653250123446}\n\nAss\u00e9nez des coups avec toute votre \u00e9nergie dans des combats rapides et fr\u00e9n\u00e9tiques. Brisez leurs gardes, mettez-les K.O., et r\u00e9cup\u00e9rez les ingr\u00e9dients vol\u00e9s pour sauver le monde.\n\n**POSE DE MAGICAL GIRL**\n\n{916019357990545}\n\nVous avez toujours r\u00eav\u00e9 d\u2019\u00eatre une magical girl et de faire ces poses iconiques ? C\u2019est votre moment. Recr\u00e9ez-les avec vos propres bras pour invoquer la Magie des Cr\u00eapes et d\u00e9cha\u00eener des sorts surpuissants.\n\n**CUISINEZ POUR BOOSTER VOS SORTS**\n\n{1673696280456853}\n\n\u00c0 mesure que l\u2019aventure s\u2019intensifie, votre magie devra gagner en puissance. Entrez en Cr\u00e9po-Transe, attrapez les bons ingr\u00e9dients, et cuisinez des cr\u00eapes \u00e0 la vitesse de l\u2019\u00e9clair pour renforcer vos capacit\u00e9s.\n\n**VOTRE HISTOIRE : VOUS \u00caTES HANA, LA R\u00c9INCARNATION DE LA D\u00c9ESSE DE LA CR\u00caPE**\n\nAux confins de l\u2019espace, un tyran impitoyable a jur\u00e9 d\u2019an\u00e9antir la cr\u00eape, symbole universel de joie et de partage.\n\nSur Terre, une \u00e9tudiante nomm\u00e9e Hana d\u00e9couvre une po\u00eale sertie de pierres pr\u00e9cieuses. En la saisissant, elle r\u00e9veille les pouvoirs de la l\u00e9gendaire D\u00e9esse de la Cr\u00eape.\n\nSi la cr\u00eape dispara\u00eet, le monde tombera avec elle.", "short_description": "Cr\u00eape Master! est un beat them all color\u00e9, inspir\u00e9 des magical girl et compl\u00e8tement d\u00e9jant\u00e9. R\u00e9incarnez vous en D\u00e9esse de la Cr\u00eape et d\u00e9fendez la Terre contre une invasion extraterrestre qui menace la gourmandise la plus ador\u00e9e au monde."}, {"images": {"nodes": [{"file_name": "icone.png", "id": "1996470601304233", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491821782_1996470604637566_6711718796398739828_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXWEdHUvHKoQ7kNvwHR0uL2&_nc_oc=Adqe-azFeQY7awnbIOUdKByXRS6DsgRli_Lxt7L7TykyLJNyd6661hxuEIuDctBLNU4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ODsxhTgGnc6tpM_jNo0UhehTf5X1YGKgxvrHguko2HQ&oe=6A1C2C8D"}, {"file_name": "Rework key art (1440 x 1440 px).png", "id": "1940922140147516", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499307435_1940922143480849_5281589781219488950_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtkV8Fr6uhwQ7kNvwEw7pJf&_nc_oc
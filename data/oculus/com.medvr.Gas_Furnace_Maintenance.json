6326_1895516558596986865_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSUpexH51REQ7kNvwG6Lsio&_nc_oc=Adr1W3xC1pBNdIoObrK55PqSWrHOmiSu0sB53ZD_c_rASxU7Yc9s-MH6e1rnnpk-B-M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVicp9qh5u5CCwIWli8tUx-KdzQikTS6XLNbMTeaG-uMw&oe=6B103FC3"}, {"file_name": "HighresScreenshot00003.png", "id": "840326535236290", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_840326538569623_4222729125154499317_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouRrDz-515YQ7kNvwGrZk1w&_nc_oc=Adp20o8ICy-LvxMyVzrLvlOITc7AvBKTyTplgJl3FonHwsFEVbvUdLEIE7z1EyUKRaQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUWTFYRN8SbaxhED2cxr4ovRBc92cvQL1u0qGFK3c4CuA&oe=6B104D94"}, {"file_name": "HighresScreenshot00002.png", "id": "2277276972797632", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_2277276976130965_4300607635225800820_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzyD4c6EyyYQ7kNvwHo598L&_nc_oc=Adp1wKlHdoaVVJ_-iHhML-AjiZ8kmKRooa4AxEpM4lEpYTO1AkbPRbPs3AIb8lEueL8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXasysYv0WM6jfmO0ZvZJWqhKIRBxGS61V7Bs4md33L4w&oe=6B1041D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gas Furnace Maintenance", "keywords": [], "long_description": "Gas Furnace Maintenance is an immersive VR training application developed as part of the Immerse Learn Gas Furnace Maintenance micro-credential program. This app enables learners to practice essential skills in a safe, simulated environment, including furnace inspection, component identification, cleaning, maintenance procedures, and safety protocols.\n\nThrough interactive, step-by-step scenarios, users gain hands-on experience that mirrors real-world HVAC service tasks, helping build confidence and job readiness. The simulation emphasizes proper techniques, system diagnostics, and adherence to safety standards.\n\nPlease note: This application is exclusively available to individuals enrolled in the Immerse Learn Gas Furnace Maintenance micro-credential program. Only registered participants will be granted access for training purposes.", "short_description": "Gas Furnace Maintenance is a VR training app from the Immerse Learn micro-credential program. Designed for enrolled learners, it provides hands-on simulation of real-world furnace inspection, servicing, and safety procedures. Access is limited to registered participants for immersive, skill-based training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35496826673296148"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818852_951447067660051_7784681252068607578_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YomJ6zmfz4wQ7kNvwF_aJ0K&_nc_oc=Adp9dCj2fORZ1YBr9N0FkvJTbV-xc8SVOGctcCcYQbiluB2zAK9_xn8XVryvTPmDVgU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV1bPVpC5xgOUKRP4imZGUDV79MAxJ9aCAJZK7ccnnIxw&oe=6B10
3.png", "id": "840326535236290", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619677_840326538569623_4222729125154499317_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfdPJIw_AI0Q7kNvwGBAgdO&_nc_oc=AdqtZZiOmpzXQrI38WNh1zqCMfoGNAfr5rO0-WaKIxsGshVTuFtvtu1FFhDa-GW_Krg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53xhUoF8eimoUigyAxIKTVQ7FOFgfhXEbGbOQc3OMxUQ&oe=6A0F00D4"}, {"file_name": "HighresScreenshot00002.png", "id": "2277276972797632", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618512_2277276976130965_4300607635225800820_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evIr4dTLq_UQ7kNvwGh7GzN&_nc_oc=Adpxlt1fa4deMzh2Jz3_0WrazNZpCW0gfRn8GphEYz8caKdQyjDDaNrsEULK3P2xDMg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Njy_uhPNmpU-hOlZ4x5xWuZxhf2jZ7MTzjmdU9R3fvg&oe=6A0EF511"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gas Furnace Maintenance", "keywords": [], "long_description": "Gas Furnace Maintenance is an immersive VR training application developed as part of the Immerse Learn Gas Furnace Maintenance micro-credential program. This app enables learners to practice essential skills in a safe, simulated environment, including furnace inspection, component identification, cleaning, maintenance procedures, and safety protocols.\n\nThrough interactive, step-by-step scenarios, users gain hands-on experience that mirrors real-world HVAC service tasks, helping build confidence and job readiness. The simulation emphasizes proper techniques, system diagnostics, and adherence to safety standards.\n\nPlease note: This application is exclusively available to individuals enrolled in the Immerse Learn Gas Furnace Maintenance micro-credential program. Only registered participants will be granted access for training purposes.", "short_description": "Gas Furnace Maintenance is a VR training app from the Immerse Learn micro-credential program. Designed for enrolled learners, it provides hands-on simulation of real-world furnace inspection, servicing, and safety procedures. Access is limited to registered participants for immersive, skill-based training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35496826673296148"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "994204069800837"}]}, "baseline_offer": {"id": "994204069800837"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778740440, "status": "PUBLISHED", "id": "994204069800837"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35852161984429280", "version": "1.2"}, "id": "1501205191667997", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35496826629962819", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35852161984429280"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"chann
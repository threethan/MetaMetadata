o_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gas Furnace Maintenance", "keywords": [], "long_description": "Gas Furnace Maintenance is an immersive VR training application developed as part of the Immerse Learn Gas Furnace Maintenance micro-credential program. This app enables learners to practice essential skills in a safe, simulated environment, including furnace inspection, component identification, cleaning, maintenance procedures, and safety protocols.\n\nThrough interactive, step-by-step scenarios, users gain hands-on experience that mirrors real-world HVAC service tasks, helping build confidence and job readiness. The simulation emphasizes proper techniques, system diagnostics, and adherence to safety standards.\n\nPlease note: This application is exclusively available to individuals enrolled in the Immerse Learn Gas Furnace Maintenance micro-credential program. Only registered participants will be granted access for training purposes.", "short_description": "Gas Furnace Maintenance is a VR training app from the Immerse Learn micro-credential program. Designed for enrolled learners, it provides hands-on simulation of real-world furnace inspection, servicing, and safety procedures. Access is limited to registered participants for immersive, skill-based training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": n
dn.com/v/t64.5771-25/499618102_841766945056326_1895516558596986865_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziCyU-PmTncQ7kNvwFm3Z0K&_nc_oc=AdpHX1AiZDMKXdeBfooIZXiOoFHa5ppKyZigYlWPf3pjEEpXGb3Adnx0-JtIQ-SlUsw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_s_4e-iRlU325zbCSu6ifZDD7jAS4lrQNXrpupTZNpw&oe=6ACE54C3"}, {"file_name": "HighresScreenshot00003.png", "id": "840326535236290", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_840326538569623_4222729125154499317_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRZ-D3kj21oQ7kNvwGp_CiM&_nc_oc=AdpH_KyiM76G8_hsuk7IpqBbq4Cm7e6uyTNJHZKJ2UCTIP2E7Xy1CKcAql7wfs_ElGM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOu8N1HLkR3T0LPHMSgUJn-iAqHp3-qYYXKM-cMhS0HnA&oe=6ACE6294"}, {"file_name": "HighresScreenshot00002.png", "id": "2277276972797632", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618512_2277276976130965_4300607635225800820_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IhCFzjKfjwQ7kNvwGqOK54&_nc_oc=AdoyqmEtDFM-y2PG5V7cD0szYW2H5ClSNQJO693DZq18sN7O5WqtEG5Ig7xaA3IOto4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9z7bQdCoz9kMMkRnJnLoWks0XBDumb_UZJWL7-VHbnA&oe=6ACE56D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gas Furnace Maintenance", "keywords": [], "long_description": "Gas Furnace Maintenance is an immersive VR training application developed as part of the Immerse Learn Gas Furnace Maintenance micro-credential program. This app enables learners to practice essential skills in a safe, simulated environment, including furnace inspection, component identification, cleaning, maintenance procedures, and safety protocols.\n\nThrough interactive, step-by-step scenarios, users gain hands-on experience that mirrors real-world HVAC service tasks, helping build confidence and job readiness. The simulation emphasizes proper techniques, system diagnostics, and adherence to safety standards.\n\nPlease note: This application is exclusively available to individuals enrolled in the Immerse Learn Gas Furnace Maintenance micro-credential program. Only registered participants will be granted access for training purposes.", "short_description": "Gas Furnace Maintenance is a VR training app from the Immerse Learn micro-credential program. Designed for enrolled learners, it provides hands-on simulation of real-world furnace inspection, servicing, and safety procedures. Access is limited to registered participants for immersive, skill-based training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35496826673296148"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "994204069800837"}]}, "baseline_offer": {"id": "994204069800837"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778740440, "status": "PUBLISHED", "id": "994204069800837"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35852161984429280", "version": "1.2"}, "id": "1501205191667997", "channel_name": "LIVE"}]}, "is_for_oculus_
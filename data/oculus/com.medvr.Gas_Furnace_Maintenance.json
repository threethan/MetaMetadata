dTaWVFpE_Ll76yUqZIMoBkWw&oe=6A16E9D4"}, {"file_name": "HighresScreenshot00002.png", "id": "2277276972797632", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618512_2277276976130965_4300607635225800820_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTXvOZwTHDgQ7kNvwHspGhv&_nc_oc=Ado_yDSQI10S2X_JNGTCupIJ2RtXfgDxEADjF81-8et3qxYROrjwSGQwS7KC1abu-gM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jOnKx8uFkeTaabUCDcsXapp_O5ITDGygPid1Yg8NMLA&oe=6A16DE11"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gas Furnace Maintenance", "keywords": [], "long_description": "Gas Furnace Maintenance is an immersive VR training application developed as part of the Immerse Learn Gas Furnace Maintenance micro-credential program. This app enables learners to practice essential skills in a safe, simulated environment, including furnace inspection, component identification, cleaning, maintenance procedures, and safety protocols.\n\nThrough interactive, step-by-step scenarios, users gain hands-on experience that mirrors real-world HVAC service tasks, helping build confidence and job readiness. The simulation emphasizes proper techniques, system diagnostics, and adherence to safety standards.\n\nPlease note: This application is exclusively available to individuals enrolled in the Immerse Learn Gas Furnace Maintenance micro-credential program. Only registered participants will be granted access for training purposes.", "short_description": "Gas Furnace Maintenance is a VR training app from the Immerse Learn micro-credential program. Designed for enrolled learners, it provides hands-on simulation of real-world furnace inspection, servicing, and safety procedures. Access is limited to registered participants for immersive, skill-based training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_we
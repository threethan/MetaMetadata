FpMRM8slBD3c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU2GWK4IihQHUkbwD3Ss1w1CNHKOZmSlL2fec250spgWA&oe=6B10357B"}, {"file_name": "migrated_image.png", "id": "241945816939560", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12533772_1881615352074109_8608237719685955584_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4gMy8sjI7YQ7kNvwHZDznH&_nc_oc=Adr1_wdqdg_Fw_3hItFb_7UHE_TxN4ldRcYyQvV8N-PqER4OliuvgbpuJXeXZaUx7U4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX0WOL7jRlmbt7kiuVWmLrtKvY7uNcWsH0JMTUQLeuRMg&oe=6B103983"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot4.png", "id": "584576485082049", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139289_584576488415382_29709014635905024_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NcMuu9ej1oQ7kNvwEAM-TT&_nc_oc=AdoeJbSBb0cb5gi2ZHwypXlC12z5M-hApbMu0VUtsaaMb8g72S__QU-vHaZq7NexyoI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUzCOwsJCQ3RTeyImuWtrzIHbe67Z3UPFprkvEVyHkr8g&oe=6B104EF3"}, "display_name": "mindZense Sleep", "keywords": ["meditation", "sleep", "peace", "relax", "dream"], "long_description": "Have trouble sleeping? mindZense Sleep is a great tool for calming down and get a good night\u2019s rest! Going to sleep don\u00b4t necessarily mean you should be counting sheep \u2013 with VR it becomes an experience. The VR universe helps you to leave the day behind and enter a dreamier state of mind. As your body settles down your mind will settle down as well.\nRELAXING BINAURAL THETA BEATS \nThe lovely meditation music with binaural Theta beats will help you relax and get tired. The guided meditation focuses on breathing, relaxing and the wonderful feeling of getting ready for bed.\nMINDZENSE SLEEP FEATURES:\n- unique virtual reality environment with unique meditation techniques\n- captivating and relaxing meditation music\n- Binaural Theta beats included\n- intuitive UI \n- ease to setup and use\n- highly effective against stress and sleep deprivation\n- relaxes the mind and soul and is helpful against insomnia\n\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\nOne of the best guided meditation apps.\nSleep well!\n", "short_description": "Go to bed with a smile on your face - sleep well"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mindzense.com/wp-content/uploads/2016/03/Privacy-Policy.pdf", "developer_terms_of_service_url": "http://www.mindzense.com/wp-content/uploads/2016/03/End-user-licence-agreement.pdf", "publisher_name": "Minditorium IVS", "support_website_url": null, "website_url": "http://www.mindzense.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "643871906758027"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12727971_1113397562116179_5625413946572800000_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oY04Hh0OcUcQ7kNvwF1xcyh&_nc_oc=Adr6sAIYQaAcVvKVawD4gJvZI826M6oDYevseb9PrAqglHz-CoMJVCh0FF18XUXSUuQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUmAZ_TqogBEPv2LmyfRVRows0ekzTegsOV3ItQcNLhcQ&oe=6B10684E"}, "is_concept": false, "is_test": false, "is_trial_offer_val
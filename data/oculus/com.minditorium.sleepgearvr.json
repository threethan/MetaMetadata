lB8Aj6WzxYBgyQ5p5huBpn06VIw&oe=6B0457FB"}, {"file_name": "migrated_image.png", "id": "241945816939560", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12533772_1881615352074109_8608237719685955584_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Or0lfX3-MSQQ7kNvwF_4Z6p&_nc_oc=AdqXIutrqdmPLuHQvGqIP9rL9USDHMjBa11oLX7szJ6ACSvlhyV2nkifGIZPGdA59nI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuqxZZsvTkT1Kvn84ooI7aB3Bg_1LQ99RBsVoO9olpkQ&oe=6B045C03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot4.png", "id": "584576485082049", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139289_584576488415382_29709014635905024_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oj0go75tvxYQ7kNvwG0DZcb&_nc_oc=AdqygBmWolh1s7PCJbxZYX4wD-61_DyYougTXgNs2be3mXx7YyGU7OY0ojVBamjJjC4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgQ_FzcRRf6gncpiGVJ6ZO2nyeRLQMtOb-E-9UNezsyg&oe=6B047173"}, "display_name": "mindZense Sleep", "keywords": ["meditation", "sleep", "peace", "relax", "dream"], "long_description": "Have trouble sleeping? mindZense Sleep is a great tool for calming down and get a good night\u2019s rest! Going to sleep don\u00b4t necessarily mean you should be counting sheep \u2013 with VR it becomes an experience. The VR universe helps you to leave the day behind and enter a dreamier state of mind. As your body settles down your mind will settle down as well.\nRELAXING BINAURAL THETA BEATS \nThe lovely meditation music with binaural Theta beats will help you relax and get tired. The guided meditation focuses on breathing, relaxing and the wonderful feeling of getting ready for bed.\nMINDZENSE SLEEP FEATURES:\n- unique virtual reality environment with unique meditation techniques\n- captivating and relaxing meditation music\n- Binaural Theta beats included\n- intuitive UI \n- ease to setup and use\n- highly effective against stress and sleep deprivation\n- relaxes the mind and soul and is helpful against insomnia\n\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\nOne of the best guided meditation apps.\nSleep well!\n", "short_description": "Go to bed with a smile on your face - sleep well"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mindzense.com/wp-content/uploads/2016/03/Privacy-Policy.pdf", "developer_terms_of_service_url": "http://www.mindzense.com/wp-content/uploads/2016/03/End-user-licence-agreement.pdf", "publisher_name": "Minditorium IVS", "support_website_url": null, "website_url": "http://www.mindzense.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "643871906758027"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1042617212507097"}, {"status": "PUBLISHED", "id": "210014486187815"}]}, "baseline_offer": {"id": "1042617212507097"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1488391200, "status": "PUBLISHED", "id": "1042617212507097"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1516346661738991", "version": "1.0.1"}, "id": "1169092766472079", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "Android
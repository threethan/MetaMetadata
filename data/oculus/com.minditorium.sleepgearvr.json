_8608237719685955584_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1F1QxppnKkQ7kNvwFzIaRz&_nc_oc=AdrBWtoqadDiOFN52vsBoE-VcHvXwGS_6JS-_E_osELXJuYsAh1FA_wG0lb18NKnHuw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ASiSkIK-oguQ_NLy0NFY-xVewcH8EY9Ghi_Zm5hLvzQ&oe=6A298303"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot4.png", "id": "584576485082049", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139289_584576488415382_29709014635905024_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9AZ3QRqZyMYQ7kNvwGk4GwW&_nc_oc=Ado2712vLX5qmCkl6d0g2VwpeE_GDbMvf7b82Zw-z11Ij-vrXvwibinCFvR6ltmXW9E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8PcOrBw4SF7p_eFUKYuCPZ-k-aNzhCfk8zCEhE-5fUA&oe=6A296033"}, "display_name": "mindZense Sleep", "keywords": ["meditation", "sleep", "peace", "relax", "dream"], "long_description": "Have trouble sleeping? mindZense Sleep is a great tool for calming down and get a good night\u2019s rest! Going to sleep don\u00b4t necessarily mean you should be counting sheep \u2013 with VR it becomes an experience. The VR universe helps you to leave the day behind and enter a dreamier state of mind. As your body settles down your mind will settle down as well.\nRELAXING BINAURAL THETA BEATS \nThe lovely meditation music with binaural Theta beats will help you relax and get tired. The guided meditation focuses on breathing, relaxing and the wonderful feeling of getting ready for bed.\nMINDZENSE SLEEP FEATURES:\n- unique virtual reality environment with unique meditation techniques\n- captivating and relaxing meditation music\n- Binaural Theta beats included\n- intuitive UI \n- ease to setup and use\n- highly effective against stress and sleep deprivation\n- relaxes the mind and soul and is helpful against insomnia\n\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\nOne of the best guided meditation apps.\nSleep well!\n", "short_description": "Go to bed with a smile on your face - sleep well"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mindzense.com/wp-content/uploads/2016/03/Privacy-Policy.pdf", "developer_terms_of_service_url": "http://www.mindzense.com/wp-content/uploads/2016/03/End-user-licence-agreement.pdf", "publisher_name": "Minditorium IVS", "support_website_url": null, "website_url": "http://www.mindzense.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "643871906758027"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12727971_1113397562116179_5625413946572800000_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjnaEyMmpSEQ7kNvwGDnMEr&_nc_oc=AdrjLoHvO01OxaC7JB2zveE4dSf6dB91yHNEZCK45nD_Lk5CmljXf7fbsN4-VIy_sIk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BXHGvTreJFqUXg6O59EhvGyuMiAUAeFAOJlM5EsAHZA&oe=6A29798E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "mindZense Sleep", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1488324579, "lastRevision": {"nodes": [{"id": "1362834200428097", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1471880979518893", "is_first_pa
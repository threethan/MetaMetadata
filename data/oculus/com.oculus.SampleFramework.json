DcTgsL5NWm3vT0MkdgyKvoi6JeFfQQHkL-0rA&oe=6A4CFAAB"}, {"file_name": "migrated_image.png", "id": "214876032948747", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138839_474729376065709_1657921674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zky0AZI-DjUQ7kNvwEbWJox&_nc_oc=Adq0ABwfo-qwHt_MMk5rMEXh-l4wugmOYNmdwri2-Ksu1kMA6x_lpXMm-WNNTtoEaBw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCf42d4cBd84Qhi2jyxlOf6wxvxunrIcyG3FQ3lipbXew&oe=6A4D030B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Oculus Sample Framework", "keywords": ["Sample", "Samples", "Unity", "Framework", "Example"], "long_description": "The Oculus Sample Framework is an experimental sandbox for VR developers and designers. It consists of a set of simple scenes that illustrate solutions to typical problems in VR, such as the mechanics of first-person movement or gaze-based UI. Each sample provides an in-app control panel allowing users to change parameters such as the length of the fade to black in a teleport, the delay on a UI element, or the z-depth of a crosshair reticle. \n\n\n\n\nThe complete Unity 5 project for this application is available at https://developer.oculus.com/downloads/\n\n\n\n\nNote :  This sample browser can be navigated with just touchpad, but some scenes require a gamepad. \n", "short_description": "The Oculus Sample Framework is an experimental sandbox for VR developers and designers. It consists of a set of simple scenes that illustrate solutions to typical problems in VR, such as the mechanics of first-person movement or gaze-based UI. Each sample provides an in-app control panel allowing users to change parameters such as the length of the fade to black in a teleport, the delay on a UI element, or the z-depth of a crosshair reticle. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.oculus.com/en-us/", "developer_terms_of_service_url": "https://www.oculus.com/en-us/", "publisher_name": "O
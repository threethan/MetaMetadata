Q7kNvwGCwhZM&_nc_oc=Adm14A0Ezmnv3MdxWxPr8_gb-AB4FGNRyXmdHOkB4T5wfY-AYcE_pqT5D3G_ak7M5cE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftxqIw2wOM2lBGk2yOtrJbq5U7DM4ZoT9aSyolRfat99Q&oe=699DA32B"}, {"file_name": "migrated_image.png", "id": "141303620600932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138839_474729376065709_1657921674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WFRJ6bEVgEQ7kNvwHpEjp8&_nc_oc=Admb1gemENC2XPI2NPRYr92lCGNtqsR8qXbA82s9Au9Hoa_yktVZRRKpMR8lFxaUYJE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftTPBYORi5SuUDvFXksrt6JIdQbaN7REeaxlwz_71KaNg&oe=699DAB8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Oculus Sample Framework", "keywords": ["Sample", "Samples", "Unity", "Framework", "Example"], "long_description": "The Oculus Sample Framework is an experimental sandbox for VR developers and designers. It consists of a set of simple scenes that illustrate solutions to typical problems in VR, such as the mechanics of first-person movement or gaze-based UI. Each sample provides an in-app control panel allowing users to change parameters such as the length of the fade to black in a teleport, the delay on a UI element, or the z-depth of a crosshair reticle. \n\n\n\n\nThe complete Unity 5 project for this application is available at https://developer.oculus.com/downloads/\n\n\n\n\nNote :  This sample browser can be navigated with just touchpad, but some scenes require a gamepad. \n", "short_description": "The Oculus Sample Framework is an experimental sandbox for VR developers and designers. It consists of a set of simple scenes that illustrate solutions to typical problems in VR, such as the mechanics of first-person movement or gaze-based UI. Each sample provides an in-app control panel allowing users to change parameters such as the length of the fade to black in a teleport, the delay on a UI element, or the z-depth of a crosshair reticle. "}]}, "developer_name": null, "developer_priva
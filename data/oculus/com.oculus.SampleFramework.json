5/12139059_837555909689096_1031857532_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGG2-abk05AQ7kNvwEQIUWP&_nc_oc=AdqjVERJbjYNvOfozEXKKTTQSqWFEwhBtM3fLASdCJMx4SQbRSIAOGAJBNzPH3tncKM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9KX_UVfmTMqGQ99yCQ2GiHeUHbeFrHLGtqIdjVgqjuw&oe=6AFDDBEB"}, {"file_name": "migrated_image.png", "id": "214876032948747", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138839_474729376065709_1657921674_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkXAhKiPCycQ7kNvwGOzY_b&_nc_oc=AdppwNn_yY5bNoNnazGiZ6l7mzs6IQv8ajRPt-zsDnFJxaGYZEIV4hxyokliK3MGNNk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQkRLOt1th_alk1ijXZisGTRcIx0Gt0uCMkAcR7FZsCQ&oe=6AFDAC0B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Oculus Sample Framework", "keywords": ["Sample", "Samples", "Unity", "Framework", "Example"], "long_description": "The Oculus Sample Framework is an experimental sandbox for VR developers and designers. It consists of a set of simple scenes that illustrate solutions to typical problems in VR, such as the mechanics of first-person movement or gaze-based UI. Each sample provides an in-app control panel allowing users to change parameters such as the length of the fade to black in a teleport, the delay on a UI element, or the z-depth of a crosshair reticle. \n\n\n\n\nThe complete Unity 5 project for this application is available at https://developer.oculus.com/downloads/\n\n\n\n\nNote :  This sample browser can be navigated with just touchpad, but some scenes require a gamepad. \n", "short_description": "The Oculus Sample Framework is an experimental sandbox for VR developers and designers. It consists of a set of simple scenes that illustrate solutions to typical problems in VR, such as the mechanics of first-person movement or gaze-based UI. Each sample provides an in-app control panel allowing users to change pa
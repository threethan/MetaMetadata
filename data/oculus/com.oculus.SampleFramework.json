Q&oe=69F4A446"}, {"file_name": "migrated_image.png", "id": "514751249238815", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12139059_837555909689096_1031857532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9mPodw2kZEQ7kNvwHaNhBy&_nc_oc=AdqiHJMFrSH3tUl0iLI_A_IS44xe-Dk2iXqsThTnj7cgCqpgMVqb2vMqFTU9E9B97Fk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Js5vDvDHUM9VEWCN6nSiIdPK_UMJTXmE3cFvsgcSv3w&oe=69F4A62B"}, {"file_name": "migrated_image.png", "id": "141303620600932", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138839_474729376065709_1657921674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fc5Xm6wsSxYQ7kNvwHDxRUz&_nc_oc=Adoqou-aXTR6mGOyldpqm7hXoqqg_5WuK2nqVxMBk8Xhg7kQtmlzuE-E-NRPazaCkFI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0nE0qH0giwhZexNu0WlJB2H3rmfsSoxB9HBn5OsvatWw&oe=69F4AE8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Oculus Sample Framework", "keywords": ["Sample", "Samples", "Unity", "Framework", "Example"], "long_description": "The Oculus Sample Framework is an experimental sandbox for VR developers and designers. It consists of a set of simple scenes that illustrate solutions to typical problems in VR, such as the mechanics of first-person movement or gaze-based UI. Each sample provides an in-app control panel allowing users to change parameters such as the length of the fade to black in a teleport, the delay on a UI element, or the z-depth of a crosshair reticle. \n\n\n\n\nThe complete Unity 5 project for this application is available at https://developer.oculus.com/downloads/\n\n\n\n\nNote :  This sample browser can be navigated with just touchpad, but some scenes require a gamepad. \n", "short_description": "The Oculus Sample Framework is an experimental sandbox for VR developers and designers. It consists of a set of simple scenes that illustrate solutions to typical problems in VR, such as the mechanics of first-person movement or gaze-based UI. Each sample provides an in-app control panel allowing users to change parameters such as the length of the fade to black in a teleport, the delay on a UI element, or the z-depth of a crosshair reticle. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.oculus.com/en-us/", "developer_terms_of_service_url": "https://www.oculus.com/en-us/", "publisher_name": "Oculus", "support_website_url": null, "website_url": "https://www.oculus.com/en-us/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4798449896934262"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1170256206337261"}]}, "baseline_offer": {"id": "1170256206337261"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1456300800, "status": "PUBLISHED", "id": "1170256206337261"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1708624945887272", "version": "1.26.0"}, "id": "621086284696195", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "909419709141137", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1708624945887272"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "621086284696195"}]}, "change_log": "
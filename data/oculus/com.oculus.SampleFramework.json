Q7kNvwHGDdVA&_nc_oc=Adnzj5VES5s4DeSN9gTCBR0wbaiZ4u5qzoe3fkyFqHinQzRM23PaTVzAoucL_qvamAI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afs84T4NHAw_FY8un8Fe_3YFeS0iFLy0zZZKpkz7CW2JSw&oe=69A197AB"}, {"file_name": "migrated_image.png", "id": "141303620600932", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12138839_474729376065709_1657921674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQQxj4tFLpsQ7kNvwE9TtZh&_nc_oc=AdkJOE_tIwP5nxS-Y5PrDQk9ZYuhQ08A2qredEdNICqKvb9pd9wylxmTYzz7bM_czAU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvD_cKvfoSQVLRYmB0ugsDCOvxwcHjyeOdZGXe2Ek5R5w&oe=69A1A00B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Oculus Sample Framework", "keywords": ["Sample", "Samples", "Unity", "Framework", "Example"], "long_description": "The Oculus Sample Framework is an experimental sandbox for VR developers and designers. It consists of a set of simple scenes that illustrate solutions to typical problems in VR, such as the mechanics of first-person movement or gaze-based UI. Each sample provides an in-app control panel allowing users to change parameters such as the length of the fade to black in a teleport, the delay on a UI element, or the z-depth of a crosshair reticle. \n\n\n\n\nThe complete Unity 5 project for this application is available at https://developer.oculus.com/downloads/\n\n\n\n\nNote :  This sample browser can be navigated with just touchpad, but some scenes require a gamepad. \n", "short_description": "The Oculus Sample Framework is an experimental sandbox for VR developers and designers. It consists of a set of simple scenes that illustrate solutions to typical problems in VR, such as the mechanics of first-person movement or gaze-based UI. Each sample provides an in-app control panel allowing users to change parameters such as the length of the fade to black in a teleport, the delay on a UI element, or the z-depth of a crosshair reticle. "}]}, "developer_name": null, "developer_priva
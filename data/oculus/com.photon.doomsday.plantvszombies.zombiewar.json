KCENQuA&oe=6A1861F3"}, {"file_name": "11.png", "id": "1923685584997411", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618093_1923685588330744_1804843314825036352_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdlUDbD_-_EQ7kNvwH13Tgx&_nc_oc=AdrDUK4XrtbF_5RGFqwj0CXLuX_aJxhDkqt3l1sDGPR7siN0HaOHzIUHJSjE9YT5TfU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71J_OS7-jnLiOv1q8mjPN55P1bCf5Ayuv0oIlPvALouQ&oe=6A1832D8"}, {"file_name": "8.png", "id": "966236406344378", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618293_966236409677711_6143830901188670388_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34d6pdhF1F4Q7kNvwGx0eS9&_nc_oc=AdqdiEf-dVK15qVs9bvQvQr16t_wbrq6U6Yx_wcEq-pSBBtzKp37Pbn7NubNPDgoDLc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4W_UKwXDXLLL5vkoT8wKTakSdofC4dVhf2XrjGtjFqRg&oe=6A1856E0"}, {"file_name": "9.png", "id": "1177861014316655", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618910_1177861017649988_6073787106706367204_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4cY2-CO4rMQ7kNvwFQhmIZ&_nc_oc=Adq8JkM5gwtestw72Zhu3YylQglx7hgsSzxQ3j4JANSO6c_ZbWdLkUJfGYPIIxufpDw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58NgX-ofm6P42LDdu5xrjSSe2QklfUyIFUmiVpaFGMeA&oe=6A1856B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie War VR", "keywords": ["zombie", "war", "shooting", "survival"], "long_description": "Step into a world overrun by the undead in Zombie War VR, where survival is your only mission. Face relentless waves of zombies and fight your way through intense battles using your shooting skills and quick reflexes.\n\nEngage in action-packed VR combat with realistic weapons and smooth controls. Aim, shoot, and eliminate zombies as they come from every direction. Stay alert and manage your strategy to survive longer against increasing difficulty.\n\nComplete missions, take down targets, and push your limits in a dangerous environment filled with nonstop action. Every encounter tests your accuracy, timing, and ability to stay calm under pressure.\n\n**Features:**\n- Intense zombie battles\n- Realistic shooting mechanics\n- Immersive VR gameplay\n- Endless zombie waves\n- Smooth gun controls\n- Challenging missions\n\nWhether you're a survival enthusiast or action gamer, Zombie War VR delivers thrilling combat and nonstop excitement. Fight hard, stay alive, and win the war against the undead! \ud83e\udddf\u200d\u2642\ufe0f\ud83d\udd2b", "short_description": "Enter the ultimate zombie war in Zombie War VR! Fight endless waves of undead, complete missions, and survive intense VR shooting action. Use powerful weapons, test your aim, and experience immersive gameplay in one of the most thrilling zombie shooter VR games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/photonhorizons/privacy-policy-prismhorizons", "developer_terms_of_service_url": null, "publisher_name": "Photon Horizons", "support_website_url": null, "website_url": "https://sites.google.com/view/photonhorizons/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26672794942344784"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_2018382808758173_5572071305253586238_n.png?stp=dst-png_s360x360&_nc_cat=108&c
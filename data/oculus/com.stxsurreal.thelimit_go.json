7a0a&_nc_ohc=0DT0lEtkwGYQ7kNvwE0Ee-1&_nc_oc=Adn-GjoxHPBd1VZ3WKxI9_vFaLJvfsxqzQN6v8H9H3Ynno7w8RySHQTaeKbO1PdrNiw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu1VhZEefLhvlrLJuuPRlXUltzPygTNmEA6PJGEQp8BRw&oe=69A589C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/JO42sy", "id": "1926045480815915", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974645_1926045484149248_6898807793478795264_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQzWp_vVBiYQ7kNvwF1OygM&_nc_oc=AdlsSnHkjLTmgmVyU1m10EsVBz8zq5c1ErbpzoQhPHL-1PocFw_pKxSb904TsRq87SY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvfbWwYHRFDrrHfLz-LpXOCXmuf3CHTTBUY3TXS8AAqVw&oe=69A5A079"}, "display_name": "Robert Rodriguez\u2019s THE LIMIT: An Immersive Cinema Experience", "keywords": ["movie", "film", "action", "video", "360"], "long_description": "Enter a new world of storytelling in this blockbuster \u201cimmersive cinema\u201d experience from visionary filmmaker Robert Rodriguez (Sin City). As a rogue agent with a mysterious past, you enlist the help of enhanced super-assassin M-13 (Michelle Rodriguez) to retrieve your identity and strike against the deadly organization that created you. Also featuring Norman Reedus (The Walking Dead), THE LIMIT will put you inside a 20-minute action movie like you\u2019ve never seen!\n\nTHE LIMIT is a lean-back experience captured in a new cinematic VR format that bridges the gap between large-format movies and 360-degree video.\n\nIncludes:\n\n* Full-length 3D and 2D versions of the film\n* 2 featurettes on the making of this groundbreaking production\n* Director\u2019s commentary by Robert Rodriguez and co-writer Racer Max\n* Chapter selection to demo favorite moments for friends\n* Virtual \u201cSurreal Theater\u201d environment\n* A rocking spatial audio mix\n* Subtitles in English, Spanish, German, Korean, Japanese, and Chinese", "short_description": "Enter a new world of storytelling in this blockbuster \u201cimmersive cinema\u201d experience from visionary filmmaker Robert Rodriguez (Sin City). As a rogue agent with a mysterious past, you enlist the help of enhanced super-assassin M-13 (Michelle Rodriguez) to retrieve your identity and strike against the deadly organization that created you."}]}, "developer_name": "STXsurreal", "developer_privacy_policy_url": "https://stxentertainment.com/privacy", "developer_terms_of_service_url": "https://stxentertainment.com/terms", "publisher_name": "STXsurreal", "support_website_url": null, "website_url": "http://www.thelimitvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MOVIE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4966941566699178"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2846589482018695", "version": "1.8"}, "id": "328511664592723", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2625633214114324", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2846589482018695"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3285116645
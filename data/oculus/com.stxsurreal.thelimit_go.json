985577454", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982496_484817642026671_4122059875532406784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJkk-OP-iYgQ7kNvwGbLFfE&_nc_oc=Adp62fDFrtu42fObLpG9djTszJydIFN_2s7y-hbQulAxlfGOHH3nTYtouXisNO2ubt4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iFK25dv64pNsKH-vBOnf6JXBAA10D2NDIBJ6GYpglHQ&oe=69E75BB5"}, {"file_name": "migrated_image.png", "id": "786101568551543", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974627_360628674689528_8597212306708889600_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_e0QCE_dbm8Q7kNvwHfASDY&_nc_oc=Adq5h-Q7_qZYBpGX8HalVwH8sfs8qhgvfSKX4SBxNRsUxiY32qDHLadfgrDinC5_z_g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TuXkEGLKTYBXFNLRzaKlLNZSHaNWFMp6qzTU-h78Pag&oe=69E76F0F"}, {"file_name": "migrated_image.png", "id": "212802349785967", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974753_824688627862196_5056962230239625216_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuExI-dokW4Q7kNvwFQUP5v&_nc_oc=AdpbnVMn0IxJOzRxBEZh3iFG9VkE0cLcPyc1X1r3J5U_cr1ahamuTzcOY5nhh2pfHKQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UZ093JiylH60xbfqMZH1ubuWMNC5Asea1QvHiCEebIg&oe=69E774C2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Robert Rodriguez\u2019s THE LIMIT", "keywords": ["movie", "film", "action", "video", "360"], "long_description": "Enter a new world of storytelling in this blockbuster \u201cimmersive cinema\u201d experience from visionary filmmaker Robert Rodriguez (Sin City). As a rogue agent with a mysterious past, you enlist the help of enhanced super-assassin M-13 (Michelle Rodriguez) to retrieve your identity and strike against the deadly organization that created you. Also featuring Norman Reedus (The Walking Dead), THE LIMIT will put you inside a 20-minute action movie like you\u2019ve never seen!\n\nTHE LIMIT is a lean-back experience captured in a new cinematic VR format that bridges the gap between large-format movies and 360-degree video.\n\nIncludes:\n\n* Full-length 3D and 2D versions of the film\n* 2 featurettes on the making of this groundbreaking production\n* Director\u2019s commentary by Robert Rodriguez and co-writer Racer Max\n* Chapter selection to demo favorite moments for friends\n* Virtual \u201cSurreal Theater\u201d environment\n* A rocking spatial audio mix\n* Subtitles in English, Spanish, German, Korean, Japanese, and Chinese", "short_description": "Enter a new world of storytelling in this blockbuster \u201cimmersive cinema\u201d experience from visionary filmmaker Robert Rodriguez (Sin City). As a rogue agent with a mysterious past, you enlist the help of enhanced super-assassin M-13 (Michelle Rodriguez) to retrieve your identity and strike against the deadly organization that created you."}]}, "developer_name": "STXsurreal", "developer_privacy_policy_url": "https://stxentertainment.com/privacy", "developer_terms_of_service_url": "https://stxentertainment.com/terms", "publisher_name": "STXsurreal", "support_website_url": null, "website_url": "http://www.thelimitvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "244566881194633"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974526_1087548584747440_3604119276702662656_n.png?stp=dst-png_s
zzle. Enjoy thinking spatially, playfully, and meditatively as you bind dots into shapes."}]}, "developer_name": "Maku XR", "developer_privacy_policy_url": "https://www.makuxr.com/skybinderprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Maku XR", "support_website_url": "https://www.makuxr.com/skybinder", "website_url": "https://www.makuxr.com/skybinder", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_GB", "en_US", "en_AU", "en_CA", "en_ZA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "655043972286840"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1373826386886860"}, {"status": "PUBLISHED", "id": "249059217073627"}, {"status": "PUBLISHED", "id": "241440801170573"}]}, "baseline_offer": {"id": "1373826386886860"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1696270738, "status": "PUBLISHED", "id": "1373826386886860"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4254008688058702", "version": "1.3.4"}, "id": "471482397249694", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3767076743418568", "is_concept": false, "latest_released_binary": {"
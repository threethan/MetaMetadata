file_name": "Snake v2.png", "id": "972163726947460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982515_972163730280793_7898448096487453016_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqwWcYIeSoEQ7kNvwGQkMVP&_nc_oc=AdpCJjhcHAjTxrqftGUvEd2fYgd5RFe2mKdmu9Y_zpjuXNTCYOuRTD45ZuypPHDzRXo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR9uXqHCsIR4aaD5JCWvgeNMrOGRdgyqSBb3_Cd7wNK6A&oe=6B0C8289"}, {"file_name": "3.png", "id": "322732592685132", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031349_322732596018465_2917667273245599511_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaHw-w4phhoQ7kNvwG1vhW5&_nc_oc=Adp9XM3_VoH4W8VVN0X26ijzrRncNtTIeO-sTjDlkza5iqqC_r3JJ1nTVcjnJtgvUbQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQgCHqGuRWFE1p-Vhs-_6iTyTWAOOddA088eMFoXfuVeQ&oe=6B0C6D0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skybinder Thumbnail v2.png", "id": "521455189053751", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974796_521455192387084_5268649497731218170_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSqj4OO6DN4Q7kNvwHcYsAZ&_nc_oc=AdqwDSguYIAdcwR07yHv5WHhsV2aY0VKm7pL4W5UHIRsShI8bRPHkKPYClWDLYvsbm0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT9f2B5vCUT3xcjhOKNhxvLJYI5XuCNU0Etm3PjU739Kg&oe=6B0C6CE3"}, "display_name": "Skybinder", "keywords": [], "long_description": "Connect dots, unlock new creatures, and become the Skybinder.\n\nSkybinder is a creative puzzle. Make creatures and send them down to the world. Create whales, giraffes, ducks, and more in twenty delightful yet complex puzzles.\n\nEnjoy thinking spatially, playfully, and meditatively as dots gather into shapes. Relax to the original music and pleasing sounds in an environment designed to stimulate and soothe. \n\nCan you master skybinding? ", "short_description": "Skybinder is a creative puzzle. Enjoy thinking spatially, playfully, and meditatively as you bind dots into shapes."}]}, "developer_name": "Maku XR", "developer_privacy_policy_url": "https://www.makuxr.com/skybinderprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Maku XR", "support_website_url": "https://www.makuxr.com/skybinder", "website_url": "https://www.makuxr.com/skybinder", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_GB", "en_US", "en_AU", "en_CA", "en_ZA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "655043972286840"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1373826386886860"}, {"status": "PUBLISHED", "id": "249059217073627"}, {"status": "PUBLISHED", "id": "241440801170573"}]}, "baseline_offer": {"id": "1373826386886860"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1696270738, "status": "PUBLISHED", "id": "1373826386886860"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4254008688058702", "version": "1.3.4"}, "id": "471482397249694", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3767076743418568", "is_concept": false, "latest_released_binary": {"
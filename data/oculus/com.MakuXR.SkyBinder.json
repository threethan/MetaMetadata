_isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3767076743418568", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "4254008688058702"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "471482397249694"}]}, "change_log": "- Added in-game music\n- Added \"mute\" button to hand menus", "created_date": 1635277989, "id": "4233111893481715", "version": "1.3.3", "version_code": 15, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3767076743418568", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "4254008688058702"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "471482397249694"}]}, "change_log": "Skybinder 1.2.1 Update addresses a variety of quality of life improvements for new users and advanced users as well as a variety of bug fixes:\n- The objects in the main menu are now sequential\n- Fixed bug that caused the system re-centering feature to not work\n- Removed in-app re-centering and replaced it with the system re-centering feature\n- Fixed bug that made it so users were unable to delete lines\n- Improved visibility of the UI interaction ray\n- Improved the text on the tutorial\n- Users can now delete lines using the trigger button\n- Improved the multi-vertex drag feature\n- Removed the ground grid\n- Lowered the price to $9.99 USD\n- The controller model now shrinks when grabbing the world\n- Improved the order of the animals on the main scene", "created_date": 1632594351, "id": "4139299869529585", "version": "1.2.1", "version_code": 13, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
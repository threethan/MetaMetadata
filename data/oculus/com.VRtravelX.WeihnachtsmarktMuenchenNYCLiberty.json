4113059661932_4278872662999934332_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlaZ2P5EU6gQ7kNvwHeVRnq&_nc_oc=AdplifhQFpRSgFs4uvtmctlk_C5LJw85huPlg10miu3cX-kYNyw22hBlnMbqZTqXjP8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFRADWJpc_eT-6NrT153EcCxTQ0vMX59EyYVE0SYQQgA&oe=6AA0121C"}, {"file_name": "screen2.png", "id": "778314991146748", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035307_778314997813414_1748850553270311687_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePyrAu_F6r4Q7kNvwEKURwa&_nc_oc=AdrEBWX3KvnJw4_ygtdsUGR9TYRV15WgAhYd0Ww8sjHWV-Ez1ykhvDc_O1_2qN-saF0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJg8h1qbrO_OBTCbddu-yMCuC-X8rAAOgTJDwyzzPWUcQ&oe=6AA01630"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Munich Christmas Market Adventure", "keywords": ["travel", "travelvr", "ChristmasMarket", "Christmas", "Munich"], "long_description": "Step into the heart of Munich\u2019s Christmas Market in this enchanting VR adventure. Join Dart as he guides you through a magical holiday journey, sharing laughs and enjoying local specialties like mulled wine. Stroll past festive market stalls, admire the opulent Rathaus and its historic courtyard, and visit the iconic Frauenkirche. Every detail has been captured to transport you into the heart of Germany's beloved holiday traditions.\n\nThis VR experience lets you feel like a tourist in Munich, exploring the market as if you were there. The sights, sounds, and festive atmosphere create an immersive journey that\u2019s far from a TV show or documentary. Pause anytime and resume later, making it a stress-free way to enjoy the season\u2019s wonders. Whether it\u2019s the glowing lights or the bustling market, every moment is yours to savor.\n\nExperience the warmth and charm of a German Christmas Market without leaving home. This is your chance to enjoy a one-hour holiday escape, complete with all the magic, traditions, and cozy cheer of the season. Discover the unique joy of Munich in a way only VR can deliver.\n\nPlease note: This app features streamed experiences that require a stable internet connection. The streamed content is provided by the developer and may not be permanently available.\n\n#travelvr #travel #tourist #sightseeing #vrtravel #Munich #Germany #ChristmasMarket #holiday #holidayseason", "short_description": "Immerse yourself in Munich\u2019s iconic Christmas Market with Dart as your guide. Savor mulled wine, explore festive stalls, and marvel at the majestic Rathaus and Frauenkirche. Experience the magic of German holiday traditions in this one-hour VR journey from the comfort of your home. Pause or resume anytime, and enjoy the sights, sounds, and atmosphere as if you were truly there."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/Munich-Christmas-Market-Adventure", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "https://www.vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8878533968891220"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "29023705010565739"}, {"status": "PUBLISHED", "id": "1596652238660673"}, {"status": "PUBLISHED", "id": "1750674169437089"}, {"status": "PUBLISHED", "id": 
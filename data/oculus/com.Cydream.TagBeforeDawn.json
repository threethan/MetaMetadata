awn**\n\n\n>\n>\n>\n\n# Free & Weekly Update\n\n{1303061434919107}\n\n\n# Survivors\n\n{857998686978075}\n\n# Killers\n\n\n{756279034154352}\n\n# Environments\n\n\n\n\n{721430050648220}", "short_description": "Tag before Dawn is the first game combine asymmetric horror and full\u2011body movement. Besides the thrilling deadly chases, the battle of wits is even more crucial!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tagbeforedawn.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Cydream", "support_website_url": null, "website_url": "https://tagbeforedawn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26535033152799132"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618938_1464606825365364_8733902734104703461_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogQ3cxo2WdoQ7kNvwFST2wa&_nc_oc=AdppXlebpQNtrgblCqwo8gltd23m7j8OQEV65AnNrIEOsNJ_YImdhFgC1wqLMNzPkLg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UQvNiKcyseZn7yMB0vGG9C-R3ckbmlmTAVjP8eTE24g&oe=69FB4917"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tag before Dawn", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_
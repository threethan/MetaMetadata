.com/v/t64.5771-25/499347666_1771495306763938_8668133297982484769_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bg7K-O9hcFYQ7kNvwFM1n45&_nc_oc=AdosNt0pYEq0gxgc43uWvAA6UPD_mOQoinujzMQpvwpu7r-EefCzT0Cbk6tDADhaZ5I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj9jkm06RuUwXPmvzTDlDZAwuV0OaI1nSHe9ZnAhiGTw&oe=6B099C3D"}, {"file_name": "vlcsnap-2025-05-16-17h27m58s898.png", "id": "1039466687617748", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499321676_1039466690951081_607283884160585460_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3a3CbkL1YsQ7kNvwH2HjoX&_nc_oc=AdqtZiz-fMCCycEj1UV7k8NopW-_LI0I1EiTY4rxRzqvlD7YsmWbf84nQVfq1QGV718&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_nom9E8FGikdFXo1DJ9FqZbNS0LcOwno7sBnQ-H_eOw&oe=6B09B1F0"}, {"file_name": "vlcsnap-2025-05-16-17h28m19s655.png", "id": "660097953534396", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393971_660097956867729_3317715767658739539_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdw_Df2PuwwQ7kNvwGtIFB3&_nc_oc=Adqs-eZGB0m9gDFj9pk-mlkeB6MHYeS6JJL2XLn2QKkgAEbY57t6e9es8NCCjkkRf9Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0xK0MAEZQ5ys6bbO-Uc95oOXSFbxDK63c291O4yw0UA&oe=6B09CAEB"}, {"file_name": "vlcsnap-2025-05-16-17h30m12s202.png", "id": "1041988217261423", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499353028_1041988220594756_6973214462599839122_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Mk6HZCoePUQ7kNvwEHPn3N&_nc_oc=Adr0mDlWclzJg5wlCh8QM5eJuvO4AiSHrRhl9KbVQzBT4KL4Fy2TA8Gr8C70nnAI6CU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFA2FO5Ay_XCHqQXVvqjuttEL8ChgGRgrYxIBlF5oWqw&oe=6B099AD5"}, {"file_name": "vlcsnap-2025-05-16-17h29m37s802.png", "id": "679858538009739", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824182_679858541343072_6811813137774150607_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ydfZebO-8AQ7kNvwFafDsD&_nc_oc=AdrJjFWCutGNP78Qy9-3lFsBWukp4LWpMYaqutNRDsECRjFATfJD2kuwY9ZK2QfIjXU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShxN-5A9cQLy1_XLY9JhuQYtTOFZs_mW1WOlXori8tRg&oe=6B09B8B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New PDP Header With Stadium 5.png", "id": "1785266245365022", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830615_1785266248698355_1160044108900492578_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jd92FSbwFIcQ7kNvwFm6q98&_nc_oc=AdqWNUn9o1l7aSJBze6DPi5QIrqJADpWfrzE2NuarUZmup2JY3jd7EyAvCb5UzFiu4E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqxfLlXvZSCw9OqZy04x3ES6FB0z7je7Spaj_4CruFHg&oe=6B0998B5"}, "display_name": "Soccer World", "keywords": ["soccer", "goalkeeper", "football", "goalie", "sport"], "long_description": "## **Master Your Goalkeeping Skills with Soccer World\u2014The Ultimate VR Training Ground! \ud83e\udde4\u26bd**\n\nStep into the most immersive VR experience built for *everyone*\u2014from total beginners to seasoned pros. Sharpen reflexes, master positioning, and train with real-game scenarios.\n\n### **Train Like the Pros \ud83d\udc68\u200d\ud83c\udfeb\ud83c\udfc6**  \nUse plans co-developed with elite coaches like Daniel Pavan (trainer of Alisson Becker). Practice reflexes, low drives, curving shots, and more\u2014with difficulty tailored to your level.\n\n### **Game Modes That Push You \ud83c\udfae\ud83d\udd25**  \n- **Survival Mode**: Face a relentless wave of shots\u2014miss too many, and it's game over! \u23f1\ufe0f  \n- **Workout Mode**: Block shots to the beat in this fun, pressure-free fitness mode. \ud83d\udd7a\ud83d\udcaa  \n- **Arcade Mode**: Mix it up with mini-games like Goal Attack and Memory. \ud83e\udde0\ud83c\udfaf\n\n### **Adaptable to Your Space \ud83c\udfe1\ud83d\udccf**  \nCustomize goal size and placement to fit your space\u2014from tight rooms to open fields. Use **passthrough mode** for safe, seamless play in any environment. \ud83e\ude9f\ud83c\udf0d\n\n### **Track Progress & Compete \ud83d\udcca\ud83e\udd47**  \n- **Performance Metrics**: Analyze reaction time, movement, and saves.  \n- **Progression**: Earn rewards, climb **leaderboards**, and unlock badges. \ud83d\ude80\ud83c\udfc5\n\n---\n\n**No matter your level, the goal is yours to master. Start training with Soccer World today! \u26bd**", "short_description": "Train like a pro with Soccer World\u2014an immersive VR experience for all skill levels! \ud83e\udde4\u26bd Practice reflexes, block shots in fun modes like Survival and Workout, and challenge yourself with coach-designed drills. \ud83c\udfc6 Customize goal size to fit any space and play safely with passthrough mode. \ud83d\udccf\ud83e\ude9f Track your progress, climb leaderboards, and unlock badges as you improve. \ud83d\ude80 Start your goalkeeping journey today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://soccerworldvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "2792874329671751
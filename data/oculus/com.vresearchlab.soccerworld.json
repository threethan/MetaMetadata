video_trailer": null, "video_trailer_thumbnail": {"file_name": "New PDP Header With Stadium 5.png", "id": "1785266245365022", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830615_1785266248698355_1160044108900492578_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5mH-QyzPeMQ7kNvwFmIQ06&_nc_oc=AdrpSOuHIseO4oaEldwb7djfO1WFmPqwP1FwlNHhzBp0DzeVXmKyKiMgFhwpdr2Yiww&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXwSeQRXMhLVCQ338csr92-NC7YCB84_33aEfBd_SRDg&oe=6AF1DDB5"}, "display_name": "Soccer World", "keywords": ["soccer", "goalkeeper", "football", "goalie", "sport"], "long_description": "## **Master Your Goalkeeping Skills with Soccer World\u2014The Ultimate VR Training Ground! \ud83e\udde4\u26bd**\n\nStep into the most immersive VR experience built for *everyone*\u2014from total beginners to seasoned pros. Sharpen reflexes, master positioning, and train with real-game scenarios.\n\n### **Train Like the Pros \ud83d\udc68\u200d\ud83c\udfeb\ud83c\udfc6**  \nUse plans co-developed with elite coaches like Daniel Pavan (trainer of Alisson Becker). Practice reflexes, low drives, curving shots, and more\u2014with difficulty tailored to your level.\n\n### **Game Modes That Push You \ud83c\udfae\ud83d\udd25**  \n- **Survival Mode**: Face a relentless wave of shots\u2014miss too many, and it's game over! \u23f1\ufe0f  \n- **Workout Mode**: Block shots to the beat in this fun, pressure-free fitness mode. \ud83d\udd7a\ud83d\udcaa  \n- **Arcade Mode**: Mix it up with mini-games like Goal Attack and Memory. \ud83e\udde0\ud83c\udfaf\n\n### **Adaptable to Your Space \ud83c\udfe1\ud83d\udccf**  \nCustomize goal size and placement to fit your space\u2014from tight rooms to open fields. Use **passthrough mode** for safe, seamless play in any environment. \ud83e\ude9f\ud83c\udf0d\n\n### **Track Progress & Compete \ud83d\udcca\ud83e\udd47**  \n- **Performance Metrics**: Analyze reaction time, movement, and saves.  \n- **Progression**: Earn rewards, climb **leaderboards**, and unlock badges. \ud83d\ude80\ud83c\udfc5\n\n---\n\n**No matter your level, the goal is yours to master. Start training with Soccer World today! \u26bd**", "short_description": "Train like a pro with Soccer World\u2014an immersive VR experience for all skill levels! \ud83e\udde4\u26bd Practice reflexes, block shots in fun modes like Survival and Workout, and challenge yourself with coach-designed drills. \ud83c\udfc6 Customize goal size to fit any space and play safely with passthrough mode. \ud83d\udccf\ud83e\ude9f Track your progress, climb leaderboards, and unlock badges as you improve. \ud83d\ude80 Start your goalkeeping journey today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://soccerworldvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27928743296717510"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310720_1904564366883307_5549440845384592698_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdQeINIHJAsQ7kNvwGUxlfW&_nc_oc=AdolzzWh_7AjCFZv-Tox3PgbPK4V_Hj6Qo_l9qc-7ocRq8ERx8Bnb8W_0Gwq7BZ9rhM&_nc_zt=3
047C6D"}, {"file_name": "screenshot4.png", "id": "1819657405179863", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974654_1819657408513196_9090049418056354398_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XatJ-fekJ3UQ7kNvwEsMM_k&_nc_oc=Adqvv_OoLBwbGhywSE-hINVJIlb9gE2BLIB1KmhzJg0iXNSfga8iViiMJo4e6EDAOxw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMOzKUzGgUS2-mZTWa0fcDhSHqS7rP4A40WIVSIce56Q&oe=6B046E41"}, {"file_name": "screenshot5.png", "id": "633586072291650", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974575_633586075624983_3713006281361650813_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLqGE4SfLHkQ7kNvwEOpEL_&_nc_oc=AdqjP8vdIXbCma8r5Fl55WVB6Retmqf8HleNhnKoSm0n7CfXYVVYfq2M2X_VbEG4RRc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlCWXMa563mOs8f9XbAck_BRtgzCBxuN8UIjmTeGqqIg&oe=6B04623E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1869137520248635", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974862_1869137523581968_5236332955616659449_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rb5eKUMvk5QQ7kNvwHDvFSd&_nc_oc=Adpdt9fUrCzNaNYqYXCkBVbWPRR7n7y8aZjNHX-jGx0UgeusPqgZi_L7LLRQSpdpkj4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSw74fkUW6VsEmcJ8bJIXv4bUGhqcw8I4dve_k9O2eVug&oe=6B0478EF"}, "display_name": "Monkeys World", "keywords": ["gorilla", "tag", "monkey", "horror", "social"], "long_description": "Welcome to **Monkeys World** \u2014 a fast-paced VR horror adventure powered by gorilla locomotion!\n\n# Key Features:\n\n- Gorilla Locomotion & Horror: Master arm-based movement while navigating eerie environments and survival challenges.\n\n- Social & Voice Chat: Connect and strategize with players using built-in communication features.\n\n- Express Yourself: Customize your monkey with a variety of unique cosmetics and accessories.\n\n- Mine & Trade: Venture deep into the mines to gather spices, then trade them to Pudge the Fat Mon'ke for delicious B A N ' A N 's!\n\nGrab your friends, gear up, and see if you can survive the world of Monkeys World!", "short_description": "Monkeys World is a thrilling VR horror game featuring classic gorilla-style locomotion. Explore, survive, and hang out with friends!\nJump into an intense VR horror adventure with cosmetic customization, and unique world mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1YIbiCQfvN20nyea3ynDJN_iuUxlLENKn_VZJXwu3O_A/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "42", "support_website_url": null, "website_url": "https://monkeysworld.straw.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "37607594855552943"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75388630_447438654926180_5687330230983897854_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SI2iSQKCbawQ7kNvwGGsPZO&_nc_oc=AdoAXQhMCXaIaO95AoM4JMPkCHcrjMk7NFOj9C850-xrBiB5K9gBpUcIdvHguvXVtF8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdEddWck9SKvJlfqAUQ1TD-V489Dw2QDr-ZvHIivx1Iw&oe=6B04872
4Q7kNvwG68kn3&_nc_oc=Ado5GIn-cAVdtBVbTsjTClrKUDXqSbAf8Vo-lOcP2MO5CWHyOQNsC9-NkLNJ01DUsu0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBBrXwnyUPSXuZgrZjVpD7Jrnzf5gMVmhkVgpWTMZl9A&oe=6AE09D81"}, {"file_name": "screenshot5.png", "id": "633586072291650", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974575_633586075624983_3713006281361650813_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQrlhvfXkzcQ7kNvwETpMAy&_nc_oc=Adr1s3TS166heB9wJhKbRtNuj-aevA_0T1sbaLzWiXyssRVCH1wqiLojMtFFQdr5b0s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQtEEDfib2U_js0YulHJLu51nh5TxW4kjhgqzSXjYrCw&oe=6AE0C9BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1869137520248635", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974862_1869137523581968_5236332955616659449_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AU1KZO3vwOQQ7kNvwGHPhun&_nc_oc=Ado4ovibx0ZDYcP6fJt7zUy8lsLd4cx8IsPETfsD8ltUW8BP3kCz7bFB05N9Y4FSA6o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2k19ZUZkjBFs2jfUiC1yCMZ7UEVwegYtNTnme5qknAw&oe=6AE0A82F"}, "display_name": "Monkeys World", "keywords": ["gorilla", "tag", "monkey", "horror", "social"], "long_description": "Welcome to **Monkeys World** \u2014 a fast-paced VR horror adventure powered by gorilla locomotion!\n\n# Key Features:\n\n- Gorilla Locomotion & Horror: Master arm-based movement while navigating eerie environments and survival challenges.\n\n- Social & Voice Chat: Connect and strategize with players using built-in communication features.\n\n- Express Yourself: Customize your monkey with a variety of unique cosmetics and accessories.\n\n- Mine & Trade: Venture deep into the mines to gather spices, then trade them to Pudge the Fat Mon'ke for delicious B A N ' A N 's!\n\nGrab your friends, gear up, and see if you can survive the world of Monkeys World!", "short_description": "Monkeys World is a thrilling VR horror game featuring classic gorilla-style locomotion. Explore, survive, and hang out with friends!\nJump into an intense VR horror adventure with cosmetic customization, and unique world mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1YIbiCQfvN20nyea3ynDJN_iuUxlLENKn_VZJXwu3O_A/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "42", "support_website_url": null, "website_url": "https://monkeysworld.straw.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "37607594855552943"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75388630_447438654926180_5687330230983897854_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glP3jr00nFAQ7kNvwG082pW&_nc_oc=Adrrli3nKY70f4gl0Ps59ZwIFI2jdaHGgWv8YIbuGuC5yaQOCQ-dKmyi9a92DudDKvA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVdfQnqj8oWRQWNvRS0hsRhY36HYdFXjZu9665mHzLqQ&oe=6AE0B666"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkeys World", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, 
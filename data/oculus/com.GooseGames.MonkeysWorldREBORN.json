UQ7kNvwEKC5Ym&_nc_oc=AdqMqsuU6yWgATOxetB5bie3lUEb9nbRTMU07nSx3VqIBylWRiDTyOeMtXYfGyKghcU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3FWemcULzpJ0USOKma9MJV24mJoPoA-jO6pkpaqENow&oe=6A918381"}, {"file_name": "screenshot5.png", "id": "633586072291650", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974575_633586075624983_3713006281361650813_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6e4GSuU7c8Q7kNvwHw_lSs&_nc_oc=AdrrR040KeH_L-FIqgrHLmzqhYp2LjhRz6bv3Ls-ph27a52GWgNVkVHawP_GKdnwKQ0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4a3fN0-yJqGS8a_MH0256Z-qZI6yTK1MxWCsjAEbgUw&oe=6A91777E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1869137520248635", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974862_1869137523581968_5236332955616659449_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XYc8Ehf17kQ7kNvwFiUsre&_nc_oc=AdoLj_8w8lyLwcqfQFWezezWobBsB5iQNBPlJQFfFs9eW_CHwsynmZpuUoYZu7C-N6g&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLogYTyzin7ZqBhOyF4AoLgNPiqhUrQhVdg5l96Sx8TQ&oe=6A918E2F"}, "display_name": "Monkeys World", "keywords": ["gorilla", "tag", "monkey", "horror", "social"], "long_description": "Welcome to **Monkeys World** \u2014 a fast-paced VR horror adventure powered by gorilla locomotion!\n\n# Key Features:\n\n- Gorilla Locomotion & Horror: Master arm-based movement while navigating eerie environments and survival challenges.\n\n- Social & Voice Chat: Connect and strategize with players using built-in communication features.\n\n- Express Yourself: Customize your monkey with a variety of unique cosmetics and accessories.\n\n- Mine & Trade: Venture deep into the mines to gather spices, then trade them to Pudge the Fat Mon'ke for delicious B A N ' A N 's!\n\nGrab your friends, gear up, and see if you can survive the world of Monkeys World!", "short_description": "Monkeys World is a thrilling VR horror game featuring classic gorilla-style locomotion. Explore, survive, and hang out with friends!\nJump into an intense VR horror adventure with cosmetic customization, and unique world mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1YIbiCQfvN20nyea3ynDJN_iuUxlLENKn_VZJXwu3O_A/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "42", "support_website_url": null, "website_url": "https://monkeysworld.straw.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "37607594855552943"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75388630_447438654926180_5687330230983897854_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Ah7n_3wDQAQ7kNvwH81AMZ&_nc_oc=Adpqv1pQCyvo9El3LrhmAVZT9FUqXdOmhVlJ2F7dSUQ05dbOT2_NBfAHrc2ZdQMbtqk&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbDa80nk_u8OqlE7xeu9-f-AVjKmBzmlEG7IcYsjy16w&oe=6A916426"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkeys World", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, 
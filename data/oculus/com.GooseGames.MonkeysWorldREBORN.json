AQ7kNvwHZwG_C&_nc_oc=Adric7EHVg6AcMIQMMnWL-nAgcouS5dj-5iHw7tbZb1oRMGsQHQhanxvjYvHEki7J90&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpKWaBdkdAZSmKCnDcNwwk5aJGC1ZTcpAyzxhm8kPK9Q&oe=6A95B041"}, {"file_name": "screenshot5.png", "id": "633586072291650", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974575_633586075624983_3713006281361650813_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWbAcdM0fhEQ7kNvwH9uKW0&_nc_oc=Adq7BxjTEjTlV9l_Zh1_AGOq8LYjtSTKA4enQi-jbPtd-UbaTzE-ogMjY-EUAtKxLGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGjM6pvd7lrPfhINt4VaYoj13Z3y91U8r5FuZwlg2RnQ&oe=6A95DC7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1869137520248635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974862_1869137523581968_5236332955616659449_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bS0OoYiu4dMQ7kNvwHPM-Gb&_nc_oc=AdppUgKdCcrWK8c3y_UPJx05v70bFNNrGZ8tlg2mLAA8OmIUjphOia5g6K84LfyYJvo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_SSMJNboKjbn87i3ynoJ-OlePOxvY1VpkSWH6qjgWlQ&oe=6A95BAEF"}, "display_name": "Monkeys World", "keywords": ["gorilla", "tag", "monkey", "horror", "social"], "long_description": "Welcome to **Monkeys World** \u2014 a fast-paced VR horror adventure powered by gorilla locomotion!\n\n# Key Features:\n\n- Gorilla Locomotion & Horror: Master arm-based movement while navigating eerie environments and survival challenges.\n\n- Social & Voice Chat: Connect and strategize with players using built-in communication features.\n\n- Express Yourself: Customize your monkey with a variety of unique cosmetics and accessories.\n\n- Mine & Trade: Venture deep into the mines to gather spices, then trade them to Pudge the Fat Mon'ke for delicious B A N ' A N 's!\n\nGrab your friends, gear up, and see if you can survive the world of Monkeys World!", "short_description": "Monkeys World is a thrilling VR horror game featuring classic gorilla-style locomotion. Explore, survive, and hang out with friends!\nJump into an intense VR horror adventure with cosmetic customization, and unique world mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1YIbiCQfvN20nyea3ynDJN_iuUxlLENKn_VZJXwu3O_A/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "42", "support_website_url": null, "website_url": "https://monkeysworld.straw.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "37607594855552943"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75388630_447438654926180_5687330230983897854_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPA9GLKyq-EQ7kNvwHpnJP8&_nc_oc=AdpYoLjAI-Nuj0C0NdJyRAjUNSDzqd6cS_BhRybLpbAs86aW8FuOUU8GxpgxVrynqQA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJR_i2lAZlGvtPhu2qwvEPCtbVc5qla3CbHJAtPBVPoQ&oe=6A95C926"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkeys World", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, 
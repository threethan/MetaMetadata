ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIrOlCDAn6QQ7kNvwF-IW5t&_nc_oc=AdqKacpiUw05ByZOcnadDs5ctq-XVfUi9ymlfN27F44ibD_-SNRLNkOWO7nLqxfw6m4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmYDQFXJ3t648Uz8uO7P40ZOZ4G7vLadC3yXzRdmKBcQ&oe=6AFB33CD"}, {"file_name": "DoD2 2024-05-28 11-35-42 (0-31-27-00).png", "id": "2213675815780096", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820428_2213675819113429_2339079547917946445_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gciXLPM3jsUQ7kNvwH13FFh&_nc_oc=AdqvioTo5_9GFl9Xy9M_6o_veUcA9il8Wy9eLxFbxKKNzYW4MibrCNcajCUGSxqBM1I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwTBdx1iBdmf4XpSd556QlSzFBKX1fVYA-ZXE69Bq6Bg&oe=6AFB30FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoD_Key_ART_for_Meta.png", "id": "1548928505912944", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982620_1548928515912943_1441057688188324508_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0UHS_xG7VMQ7kNvwFIu26J&_nc_oc=Adryo5fs278EXfFv35BTM9vtNUbHQV3NTTXM3Km6t77R3JsB48r7cyvjqM2QGfUaQC8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQI7dGtJMxRvY4uEsYeE7vWUeA4TKPnbyOiMdW4VIuqbw&oe=6AFB2914"}, "display_name": "Drunk Or Dead 2", "keywords": [], "long_description": "A brutal zombie plague has swept across the world, and only those who happened to be under the influence of peculiar brews survived. Humanity, protected by bizarre side effects, fights to reclaim the planet or simply enjoy life while it lasts.\n\nAfter a devastating attack, Triss\u2019s legendary lounge\u2014once known for its eccentric menu of mysterious drinks\u2014is destroyed, forcing her to move into the hero\u2019s shelter. But survival is never easy: supplies vanish quickly, and every journey to replenish them turns into a dangerous adventure. Together, the survivors must reach the Preacher\u2019s refuge, raid stores for strange ingredients to fuel a salvaged still, and face neurozombies\u2014creatures not fully turned, but deadly with guns in hand.\n\nThis is just the beginning: ten chapters are planned, with new ones already in development. Players can expect fast-paced, explosive action with a wide arsenal of weapons, from small shooters to heavy firepower, and plenty of chaos along the way. In a world where odd concoctions are the last hope, every bullet and every sip counts.", "short_description": "A bizarre plague has turned the sober into zombies\u2014only those under peculiar brews survived. Join up to four players in a story-driven VR shooter with ten chaotic chapters, unique mechanics, and explosive action. Explore Triss\u2019s ruined lounge, raid for strange supplies, face neurozombies, and relax in a multiplayer hub with mini-games or PvP battles. Every mission brings new chaos, humor, and survival twists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://4ilab.io/privacy", "developer_terms_of_service_url": "https://4ilab.io/terms", "publisher_name": "4 I LAB LTD", "support_website_url": null, "website_url": "https://4ilab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1008279844328894"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "pt_BR", "de", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25937590639192032"}}]}, "scheduled_offers": {"count": 7, "nodes": [{
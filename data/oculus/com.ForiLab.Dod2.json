{"data": {"node": {"__typename": "Application", "id": "7049721281738919", "organization": {"id": "2058134081200972", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25386202837716949"}]}, "id": "880507584627536"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "7049721281738919"}]}, "id": "2439049392942251"}]}}, "firstRevision": {"nodes": [{"application": {"id": "7049721281738919", "release_date": 1767978000, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 6}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26443141968636894"}, "id": "834276905097341"}]}}, "binary": null, "live_binary": null, "created_date": 1792510109, "id": "29284336007850795", "is_initial_release": false, "name_with_fallback": "v8", "pdp_metadata_with_fallback": {"version": 7, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "29284415174509545"}, "release_status": "RELEASED", "id": "7049721281738919"}, "id": "29284415174509545", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7049721281738919", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2281740765683026"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2824415094620836", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drunk Or Dead 2", "keywords": ["\u50f5\u5c38\u6e38\u620f", "vr\u5c04\u51fb", "\u52a8\u4f5c\u6e38\u620f", "\u672b\u65e5\u751f\u5b58", "vr\u6e38\u620f"], "long_description": "## \ud83d\udca5 \u552f\u4e00\u7528\u75af\u72c2\u8840\u6e05\u9006\u8f6c\u4e27\u5c38\u672b\u65e5\u7684VR\u6e38\u620f\uff01\n\n\u4e00\u573a\u6b8b\u9177\u7684\u761f\u75ab\u6bc1\u706d\u4e86\u4eba\u7c7b\u6587\u660e\uff0c\u4f46\u4f60\u62e5\u6709\u79d8\u5bc6\u6b66\u5668\uff1a\u4e0d\u7a33\u5b9a\u7684\u751f\u5b58\u8840\u6e05\uff01\u5728\u300aDrunk Or Dead 2\u300b\u4e2d\uff0c\u6291\u5236\u75c5\u6bd2\u7684\u552f\u4e00\u65b9\u6cd5\u5c31\u662f\u4fdd\u6301\u8840\u6db2\u4e2d\u7684\u7279\u6b8a\u89e3\u6bd2\u5242\u6c34\u5e73\u3002\u5e26\u4e0a\u670b\u53cb\uff0c\u52a0\u8f7d\u91cd\u706b\u529b\uff0c\u5728\u75af\u72c2\u7684\u8054\u673aVR\u5192\u9669\u4e2d\u76f4\u9762\u5931\u63a7\u4e0e\u7cbe\u51c6\u7684\u6781\u9650\u5e73\u8861\uff01\n\n{1673148317493425}\n\n## \ud83c\udf92 \u7b2c1\u8d5b\u5b63\uff1a\u6740\u5411\u8d85\u7ea7\u5e02\u573a\n\u6bcf\u4e2a\u5e78\u5b58\u8005\u90fd\u6709\u4e00\u4e2a\u6545\u4e8b\u3002\u8fd9\u662f\u7b2c\u4e00\u4e2a\u3002\u5728\u8fd9\u6bb5\u5b8c\u6574\u72ec\u7acb\u3001\u5145\u6ee1\u65e0\u5398\u5934\u4e50\u8da3\u7684VR\u6218\u5f79\u4e2d\uff0c\u643a\u624b\u7fe0\u4e1d\uff08Triss\uff09\u5bfb\u627e\u76df\u53cb\uff0c\u4e00\u8def\u78be\u788e\u53d8\u5f02\u4f53\uff0c\u51b2\u5411\u6700\u7ec8\u76ee\u7684\u5730\uff1a\u8d85\u7ea7\u5e02\u573a\uff01\n\n### \ud83d\udd25 \u6e38\u620f\u7279\u8272\uff1a\n* **\u4e0d\u7a33\u5b9a\u8840\u6e05\u7cfb\u7edf\uff1a** \u5728\u6fc0\u6218\u4e2d\u75db\u996e\u795e\u79d8\u8840\u6e05\u3002\u5b83\u4eec\u80fd\u89e6\u53d1\u5f3a\u5927\u7684\u8fde\u51fb\u4e0e\u5b50\u5f39\u65f6\u95f4\uff0c\u4f46\u4f1a\u626d\u8f6c\u4f60\u7684\u7a7a\u95f4\u611f\u77e5\u3002\u5f53\u5929\u5730\u5f00\u59cb\u65cb\u8f6c\uff0c\u4f60\u8fd8\u80fd\u7a33\u4f4f\u67aa\u53e3\u5417\uff1f\n* **\u9ad8\u667a\u5546\u795e\u7ecf\u4e27\u5c38\uff1a** \u5bf9\u6297\u4fdd\u7559\u4e86\u751f\u524d\u6218\u672f\u8bb0\u5fc6\u7684\u4e27\u5c38\u58eb\u5175\u3002\u5b83\u4eec\u4f1a\u5bfb\u627e\u63a9\u4f53\u3001\u5305\u6284\u4fa7\u7ffc\u5e76\u8fdb\u884c\u65e0\u60c5\u7684\u706b\u529b\u538b\u5236\u3002\u4e27\u5c38\u61c2\u6218\u672f\uff1f\u662f\u7684\uff0c\u4f60\u6ca1\u542c\u9519\uff01\n* **\u6539\u88c5\u8f7d\u5177\u78be\u788e\u4e00\u5207\uff1a** \u638c\u63a7\u672b\u65e5\u6218\u8f66\u7684\u65b9\u5411\u76d8\uff0c\u4e0e\u5c0f\u961f\u6210\u5458\u4e00\u8d77\u5229\u7528\u73af\u5883\u5c06\u4e27\u5c38\u72c2\u6f6e\u78be\u6210\u788e\u8089\u3002\n* **\u65e0\u5c3d\u65e0\u4f11\u7684\u72c2\u6f6e\u6a21\u5f0f\uff1a** \u89c9\u5f97\u610f\u72b9\u672a\u5c3d\uff1f\u5728\u4e13\u5c5e\u7ade\u6280\u573a\u4e2d\u76f4\u9762\u65e0\u5c3d\u4e14\u4e0d\u65ad\u53d8\u5f3a\u7684\u4e27\u5c38\u72c2\u6f6e\uff0c\u6311\u6218\u4f60\u7684\u751f\u5b58\u6781\u9650\uff01\n\n---\n*\u26a0\ufe0f \u6ce8\u610f\uff1a\u7b2c1\u8d5b\u5b63\u6545\u4e8b\u5728\u201c\u8d85\u7ea7\u5e02\u573a\u201d\u6218\u7ebf\u5b8c\u7f8e\u6536\u5c3e\u3002\u7b2c2\u8d5b\u5b63\u6b63\u5728\u7d27\u5bc6\u5f00\u53d1\u4e2d\uff0c\u540e\u7eed\u5c06\u4f5c\u4e3aDLC\u63a8\u51fa\uff01\u653e\u4e0b\u4e25\u8083\uff0c\u6765\u4e00\u573a\u771f\u6b63\u7684VR\u72c2\u6b22\u5427\uff01*\n", "short_description": "\u552f\u4e00\u7528\u75af\u72c2\u8840\u6e05\u9006\u8f6c\u4e27\u5c38\u672b\u65e5\u7684VR\u52a8\u4f5c\u5c04\u51fb\u6e38\u620f\uff01\u6587\u660e\u5d29\u6e83\uff0c\u552f\u6709\u4e0d\u7a33\u5b9a\u7684\u751f\u5b58\u8840\u6e05\u80fd\u6291\u5236\u75c5\u6bd2\u3002\u5e26\u4e0a\u670b\u53cb\uff0c\u52a0\u8f7d\u91cd\u706b\u529b\uff0c\u5728\u8fd9\u573a\u75af\u72c2\u7684\u8054\u673aVR\u5192\u9669\u4e2d\u751f\u6b7b\u72c2\u98d9\u3002\u7acb\u5373\u52a0\u5165\u7b2c1\u8d5b\u5b63\uff0c\u6740\u5411\u7ec8\u70b9\uff1a\u8d85\u7ea7\u5e02\u573a\uff01"}, {"images": {"nodes": [{"file_name": "Art_1440x1440.png", "id": "1545474286568262", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820855_1545474289901595_1265532340316018837_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3uAwUGopMMQ7kNvwEK-0we&_nc_oc=AdqeuEuBDJeIjFacOgE_JPfaHvT5nJ43r2PbLy8JkbSQeiP5mAk95rQL7wgkgZ7K2Hw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQC1XirthZf8lY9strf-tNQN
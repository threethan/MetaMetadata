5-42 (0-17-59-42).png", "id": "849978607775453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_849978614442119_7818219962628967186_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfLd4bCxhDIQ7kNvwFruLOR&_nc_oc=AdoBxz_TctW-0JR78X8aSFRWlyWVc8ZIV-lgm70B0qbtcs2DxNZQR40wPwXkv60zChA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwKsc9irheZi17fZDkcEMeFHj8a4GY9Agfx2R5ZhJf1A&oe=6AEA0EA4"}, {"file_name": "DoD2 2024-05-28 11-35-42 (0-25-18-39).png", "id": "861151629617134", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_861151632950467_1575565934216625427_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAjNyhF9s_gQ7kNvwF4V0yC&_nc_oc=Ado5D73Y3m4BJc8NRZ41zHuG9-dlvciVZP4Y5ymEIWGHFuueoPNEzUtesO6TIAFJ3IM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0G-Lv8_EgTEYOll_Jb-CmvBwMZsuCpGTQ9gCJTs9vYw&oe=6AE9E7C7"}, {"file_name": "DoD2 2024-05-28 11-35-42 (0-11-29-41).png", "id": "1775918206540599", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830007_1775918209873932_363204617420510609_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VsJTYew88YQ7kNvwGvSBuN&_nc_oc=AdpokkmlFH_lKvIckgIjWn-dn9mqnE24Bzeg2nq_iBoBRahx6MGjjnQEWkzZNDVqoaI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9msDjTHKweGqL6Hs9RVRAYwhQ4dAfeIFtWHd48Q7zwA&oe=6AEA104D"}, {"file_name": "DoD2 2024-05-28 11-35-42 (0-31-27-00).png", "id": "2213675815780096", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820428_2213675819113429_2339079547917946445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mR7ank8AnkQ7kNvwFbz4hB&_nc_oc=Adr9BUwObWXldXhVjDXnLBTt2lqMiC7_rMSoR5fbOJs3BddKe5Sej3xuN8bY8WXGEsU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpDdkumMANM74hgRngHkb0aFGMN2BoO7QKKAQTQ4C2cQ&oe=6AEA0D7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoD_Key_ART_for_Meta.png", "id": "1548928505912944", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982620_1548928515912943_1441057688188324508_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJ3jgU4KZ20Q7kNvwFygYAK&_nc_oc=Adq2CTIXXMlipTRXV_m27ab3eggmaY1vnViyJX9FUdPsNmMviGgPrdi3SSqz75ZpU8o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrLJPWikbpOYfRFabVoD_oFY_SeglrVqA6o4e7ws48tA&oe=6AEA0594"}, "display_name": "Drunk Or Dead 2", "keywords": [], "long_description": "A brutal zombie plague has swept across the world, and only those who happened to be under the influence of peculiar brews survived. Humanity, protected by bizarre side effects, fights to reclaim the planet or simply enjoy life while it lasts.\n\nAfter a devastating attack, Triss\u2019s legendary lounge\u2014once known for its eccentric menu of mysterious drinks\u2014is destroyed, forcing her to move into the hero\u2019s shelter. But survival is never easy: supplies vanish quickly, and every journey to replenish them turns into a dangerous adventure. Together, the survivors must reach the Preacher\u2019s refuge, raid stores for strange ingredients to fuel a salvaged still, and face neurozombies\u2014creatures not fully turned, but deadly with guns in hand.\n\nThis is just the beginning: ten chapters are planned, with new ones already in development. Players can expect fast-paced, explosive action with a wide arsenal of weapons, from small shooters to heavy firepower, and plenty of chaos along the way. In a world where odd concoctions are the last hope, every bullet and every sip counts.", "short_description": "A bizarre plague has turned the sober into zombies\u2014only those under peculiar brews survived. Join up to four players in a story-driven VR shooter with ten chaotic chapters, unique mechanics, and explosive action. Explore Triss\u2019s ruined lounge, raid for strange supplies, face neurozombies, and relax in a multiplayer hub with mini-games or PvP battles. Every mission brings new chaos, humor, and survival twists."}]}, "developer_name": null, "developer_privacy_p
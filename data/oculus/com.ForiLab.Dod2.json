-7&_nc_sid=6e7a0a&_nc_ohc=92OLwGKiIXUQ7kNvwGYJsmq&_nc_oc=AdrmiLM3fFzkGRAKCogi9CrVjWBz6C5ZNxTu1L5I-1JciZSg-fh1s7Z8oIpMjpTmWw4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSd-AQXO0NDP17qXTWs9xdmPklXf4UnhSpAdb8coqA8Ow&oe=6AE9FC77"}, {"file_name": "5-2.png", "id": "1166624082698042", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/793139181_1166624086031375_1839761025547964883_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxSvG9VXS6IQ7kNvwG6o834&_nc_oc=AdqQwG_1ZdakBYOD8sPBK7x6TkQpvpEKnNnkJefzN3JsbVDZXFKbX64iOUl4jKZ6ZYI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpDO0l38HQFlr8jU9zJALkMfXz1vNpOf8ezhZTu44pRA&oe=6AE9F3BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoD_Key_ART_for_Meta.png", "id": "1548928505912944", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982620_1548928515912943_1441057688188324508_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJ3jgU4KZ20Q7kNvwFygYAK&_nc_oc=Adq2CTIXXMlipTRXV_m27ab3eggmaY1vnViyJX9FUdPsNmMviGgPrdi3SSqz75ZpU8o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrLJPWikbpOYfRFabVoD_oFY_SeglrVqA6o4e7ws48tA&oe=6AEA0594"}, "display_name": "Drunk Or Dead 2", "keywords": ["arcadeshooter", "zombievr", "vraction", "fastpaced", "shootinggame"], "long_description": "## \ud83d\udca5 THE ONLY ZOMBIE APOCALYPSE WHERE AN UNSTABLE COCKTAIL SAVES YOUR LIFE!\n\nA brutal plague wiped out civilization, but you have a secret weapon: volatile survival serums! In Drunk Or Dead 2, keep the virus at bay by maintaining a special antidote level in your blood. Grab friends, load heavy calibers, and dive into a mad VR adventure where you balance on the edge of total madness and perfect accuracy!\n\n{2228484847708225}\n\n## \ud83c\udf92 SEASON 1: TO THE SUPERMARKET\nEvery survivor has a story. This is the first one \u2014 a complete, standalone episodic VR adventure packed with action and chaotic fun! Help Triss find new allies and smash your way through mutants to the ultimate final destination: the Supermarket! \n\n### \ud83d\udd25 KEY FEATURES:\n* **Unstable Stimulant System:** Gulp down volatile serums in battle. They trigger powerful combo effects and slow motion, but distort perception. Can you handle it when the floor starts spinning?\n* **Smart Neuro Zombies:** Fight infected military squads that use cover, flank your team, and lay down heavy suppressive fire. Tactical zombies? Yes!\n* **Smash the Horde:** Get behind the wheel of post-apocalyptic vehicles and turn monsters into mincemeat together with your squad.\n* **Endless Horde Mode:** Test your limits on special arenas, holding the line against scaling waves of enemies.\n\n---\n*\u26a0\ufe0f Note: Season 1 story is fully complete at the Supermarket checkpoint. Season 2 is in development and will be available later as a DLC!*\n\n", "short_description": "The only zombie apocalypse where an unstable cocktail saves your life! A brutal plague wiped out civilization, but you have a secret weapon: volatile survival serums. Grab your friends, load your heavy caliber, and dive into a mad  VR adventure where you must balance on the edge of total madness and perfect accuracy. Play Season 1 today, help Triss find allies, and smash your way through mutants to the ultimate final destination: the Supermarket!"}, {"images": {"nodes": []}, "id": "1815535109759617", "locale": "en_GB", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drunk Or Dead 2", "keywords": ["arcadeshooter", "zombievr", "vraction", "fastpaced", "shootinggame"], "long_description": "## \ud83d\udca5 THE ONLY ZOMBIE APOCALYPSE WHERE AN UNSTABLE COCKTAIL SAVES YOUR LIFE!\n\nA brutal plague wiped out civilization, but you have a secret weapon: volatile survival serums! In Drunk Or Dead 2, keep the virus at bay by maintaining a special antidote level in your blood. Grab friends, load heavy calibers, and dive into a mad VR adventure where you balance on the edge of total madness and perfect accuracy!\n\n{1988701099113285}\n\n## \ud83c\udf92 SEASON 1: TO THE SUPERMARKET\nEvery survivor has a story. This is the first one \u2014 a complete, standalone episodic VR adventure packed with action and chaotic fun! Help Triss find new allies and smash your way through mutants to the ultimate final destination: the Supermarket! \n\n### \ud83d\udd25 KEY FEATURES:\n* **Unstable Stimulant System:** Gulp down volatile serums in battle. They trigger powerful combo effects and slow motion, but distort perception. Can you handle it when the floor starts spinning?\n* **Smart Neuro Zombies:** Fight infected military squads that use cover, flank your team, and lay down heavy suppressive fire. Tactical zombies? Yes!\n* **Smash the Horde:** Get behind the wheel of post-apocalyptic vehicles and turn monsters into mincemeat together with your squad.\n* **Endless Horde Mode:** Test your limits on special arenas, holding the line against scaling waves of enemies.\n\n---\n*\u26a0\ufe0f Note: Season 1 story is fully complete at the Supermarket checkpoint. Season 2 is in development and will be available later as a DLC!*\n\n", "short_description": "The only zombie apocalypse where an unstable cocktail saves your life! A brutal plague wiped out civilization, but you have a secret weapon: volatile survival serums. Grab your friends, load your heavy caliber, and dive into a mad  VR adventure where you must balance on the edge of total madness and perfect accuracy. Play Season 1 today, help Triss find allies, and smash your way through mutants to the ultimate final destination: the Supermarket!"}, {"images": {"nodes": []}, "id": "1618407616415326", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drunk Or Dead 2", "keywords": ["\u30be\u30f3\u30d3\u30b2\u30fc\u30e0", "vr\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0", "\u30a2\u30af\u30b7\u30e7\u30f3\u30b2\u30fc\u30e0", "\u30b5\u30d0\u30a4\u30d0\u30eb", "vr\u30b2\u30fc\u30e0"], "long_description": "## \ud83d\udca5 \u602a\u3057\u3052\u306a\u30ab\u30af\u30c6\u30eb\u3060\u3051\u304c\u547d\u7db1\u306e\u3001\u524d\u4ee3\u672a\u805e\u306eVR\u30be\u30f3\u30d3\u30b7\u30e5\u30fc\u30bf\u30fc\uff01\n\n\u6b8b\u8650\u306a\u75ab\u75c5\u306b\u3088\u308a\u6587\u660e\u306f\u5d29\u58ca\u3057\u307e\u3057\u305f\u304c\u3001\u3042\u306a\u305f\u306b\u306f\u79d8\u5bc6\u5175\u5668\u300c\u63ee\u767a\u6027\u30b5\u30d0\u30a4\u30d0\u30eb\u8840\u6e05\u300d\u304c\u3042\u308a\u307e\u3059\uff01\u300eDrunk Or Dead 2\u300f\u3067\u306f\u3001\u30a6\u30a4\u30eb\u30b9\u3092\u6291\u3048\u8fbc\u3080\u552f\u4e00\u306e\u65b9\u6cd5\u306f\u8840\u6db2\u4e2d\u306e\u7279\u6b8a\u306a\u7279\u52b9\u85ac\u30ec\u30d9\u30eb\u3092\u7dad\u6301\u3059\u308b\u3053\u3068\u3002\u4ef2\u9593\u3092\u96c6\u3081\u3066\u91cd\u706b\u5668\u3092\u69cb\u3048\u3001\u30c8\u30fc\u30bf\u30eb\u306a\u72c2\u6c17\u3068\u5b8c\u74a7\u306a\u5c04\u6483\u7cbe\u5ea6\u306e\u9650\u754c\u306e\u30d0\u30e9\u30f3\u30b9\u306b\u6311\u3080\u3001\u30de\u30c3\u30c9\u306a\u5354\u529b\u30d7\u30ec\u30a4VR\u30a2\u30c9\u30d9\u30f3\u30c1\u30e3\u30fc\u306b\u98db\u3073\u8fbc\u3082\u3046\uff01\n\n{1457972756279010}\n\n## \ud83c\udf92 \u30b7\u30fc\u30ba\u30f31\uff1a\u30b9\u30fc\u30d1\u30fc\u30de\u30fc\u30b1\u30c3\u30c8\u3092\u76ee\u6307\u305b\uff01\n\u3059\u3079\u3066\u306e\u751f\u5b58\u8005\u306b\u7269\u8a9e\u304c\u3042\u308b\u3002\u3053\u308c\u304c\u6700\u521d\u306e\u7269\u8a9e\u3060\u3002\u30a2\u30af\u30b7\u30e7\u30f3\u3068\u6df7\u6c8c\u3068\u3057\u305f\u697d\u3057\u3055\u306b\u6e80\u3061\u305f\u3001\u5b8c\u5168\u306b\u72ec\u7acb\u3057\u305f\u5b8c\u7d50\u578b\u30a8\u30d4\u30bd\u30fc\u30c9VR\u30ad\u30e3\u30f3\u30da\u30fc\u30f3\uff01\u30d6\u30ea\u30b9\uff08Triss\uff09\u3092\u52a9\u3051\u3066\u65b0\u305f\u306a\u4ef2\u9593\u3092\u898b\u3064\u3051\u3001\u5909\u7570\u4f53\u3092\u7c89\u7815\u3057\u306a\u304c\u3089\u6700\u7d42\u76ee\u7684\u5730\u300c\u30b9\u30fc\u30d1\u30fc\u30de\u30fc\u30b1\u30c3\u30c8\u300d\u3078\u3068\u7a81\u304d\u9032\u3081\uff01\n\n### \ud83d\udd25 \u30b2\u30fc\u30e0\u306e\u7279\u5fb4\uff1a\n* **\u4e0d\u5b89\u5b9a\u306a\u523a\u6fc0\u30b7\u30b9\u30c6\u30e0\uff1a** \u6fc0\u3057\u3044\u6226\u95d8\u306e\u6700\u4e2d\u306b\u8840\u6e05\u3092\u6442\u53d6\u305b\u3088\u3002\u5f37\u529b\u306a\u30b3\u30f3\u30dc\u52b9\u679c\u3068\u30b9\u30ed\u30fc\u30e2\u30fc\u30b7\u30e7\u30f3\u304c\u767a\u52d5\u3057\u307e\u3059\u304c\u3001\u7a7a\u9593\u8a8d\u8b58\u304c\u6fc0\u3057\u304f\u6b6a\u307f\u307e\u3059\u3002\u8996\u754c\u304c\u56de\u308a\u59cb\u3081\u3066\u3082\u3001\u3042\u306a\u305f\u306f\u30c8\u30ea\u30ac\u30fc\u3092\u5f15\u304d\u7d9a\u3051\u3089\u308c\u308b\u304b\uff1f\n* **\u77e5\u80fd\u3092\u6301\u3064\u30cb\u30e5\u30fc\u30ed\u30be\u30f3\u30d3\uff1a** \u751f\u524d\u306e\u6226\u8853\u8a18\u61b6\u3092\u4fdd\u6301\u3057\u3066\u3044\u308b\u5143\u5175\u58eb\u306e\u30be\u30f3\u30d3\u90e8\u968a\u3068\u5bfe\u5cd9\u3002\u5f7c\u3089\u306f\u30ab\u30d0\u30fc\u3092\u5229\u7528\u3057\u3001\u5074\u9762\u3092\u7a81\u3044\u3066\u6fc0\u3057\u3044\u5236\u5727\u5c04\u6483\u3092\u4ed5\u639b\u3051\u3066\u304d\u307e\u3059\u3002\u30be\u30f3\u30d3\u304c\u6226\u8853\u3092\uff1f\u305d\u3046\u3067\u3059\u3001\u304a\u805e\u304d\u9593\u9055\u3044\u3067\u306f\u3042\u308a\u307e\u305b\u3093\uff01\n* **\u8eca\u4e21\u3067\u7fa4\u308c\u3092\u7c89\u7815\uff1a** \u6539\u9020\u3055\u308c\u305f\u30dd\u30b9\u30c8\u30fb\u30a2\u30dd\u30ab\u30ea\u30d7\u30b9\u8eca\u4e21\u306e\u30cf\u30f3\u30c9\u30eb\u3092\u63e1\u308a\u3001\u30b9\u30c6\u30fc\u30b8\u30ae\u30df\u30c3\u30af\u3092\u99c6\u4f7f\u3057\u3066\u30be\u30f3\u30d3\u306e\u7fa4\u308c\u3092\u30df\u30f3\u30c1\u306b\u5909\u3048\u3088\u3046\u3002\n* **\u30a8\u30f3\u30c9\u30ec\u30b9\u30fb\u30db\u30fc\u30c9\u30e2\u30fc\u30c9\uff1a** \u30b9\u30c8\u30fc\u30ea\u30fc\u7d42\u4e86\u5f8c\u3082\u7d42\u308f\u3089\u306a\u3044\uff01\u62bc\u3057\u5bc4\u305b\u308b\u7121\u9650\u306e\u30be\u30f3\u30d3\u306e\u6ce2\u306b\u7acb\u3061\u5411\u304b\u3044\u3001\u751f\u5b58\u306e\u9650\u754c\u306b\u6311\u6226\u305b\u3088\u3002\n\n---\n*\u26a0\ufe0f \u6ce8\u610f\uff1a\u30b7\u30fc\u30ba\u30f31\u306e\u7269\u8a9e\u306f\u300c\u30b9\u30fc\u30d1\u30fc\u30de\u30fc\u30b1\u30c3\u30c8\u300d\u306e\u30c1\u30a7\u30c3\u30af\u30dd\u30a4\u30f3\u30c8\u3067\u5b8c\u5168\u306b\u5b8c\u7d50\u3057\u307e\u3059\u3002\u30b7\u30fc\u30ba\u30f32\u306f\u73fe\u5728\u92ed\u610f\u958b\u767a\u4e2d\u3067\u3042\u308a\u3001\u5f8c\u65e5DLC\u3068\u3057\u3066\u5229\u7528\u53ef\u80fd\u306b\u306a\u308a\u307e\u3059\uff01\u5927\u771f\u9762\u76ee\u306a\u9854\u3067\u306e\u30d7\u30ec\u30a4\u306f\u7d42\u308f\u308a\u3060\u3001\u672c\u7269\u306eVR\u304a\u796d\u308a\u9a12\u304e\u3092\u59cb\u3081\u3088\u3046\uff01*\n", "short_description": "\u602a\u3057\u3052\u306a\u30ab\u30af\u30c6\u30eb\u3060\u3051\u304c\u547d\u7db1\u306e\u3001\u524d\u4ee3\u672a\u805e\u306eVR\u30be\u30f3\u30d3\u30b7\u30e5\u30fc\u30bf\u30fc\uff01\u6587\u660e\u306f\u5d29\u58ca\u3057\u307e\u3057\u305f\u304c\u3001\u3042\u306a\u305f\u306b\u306f\u79d8\u5bc6\u5175\u5668\u300c\u63ee\u767a\u6027\u30b5\u30d0\u30a4\u30d0\u30eb\u8840\u6e05\u300d\u304c\u3042\u308a\u307e\u3059\u3002\u30a6\u30a4\u30eb\u30b9\u3092\u6291\u3048\u308b\u305f\u3081\u3001\u5e38\u306b\u7279\u52b9\u85ac\u306e\u30ec\u30d9\u30eb\u3092\u7dad\u6301\u305b\u3088\u3002\u4ef2\u9593\u3092\u96c6\u3081\u3066\u91cd\u706b\u5668\u3092\u69cb\u3048\u3001\u6df7\u6c8c\u3068\u3057\u305f\u5354\u529b\u30d7\u30ec\u30a4VR\u30a2\u30c9\u30d9\u30f3\u30c1\u30e3\u30fc\u306b\u98db\u3073\u8fbc\u3082\u3046\u3002\u30b7\u30fc\u30ba\u30f31\u3092\u4eca\u3059\u3050\u30d7\u30ec\u30a4\u3057\u3001\u30b9\u30fc\u30d1\u30fc\u30de\u30fc\u30b1\u30c3\u30c8\u3092\u76ee\u6307\u305b\uff01"}, {"images": {"nodes": []}, "id": "1453101526744838", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drunk Or Dead 2", "keywords": ["zumbi", "shooter", "action"], "long_description": "## \ud83d\udca5 COQUETEL INST\u00c1VEL SALVA SUA VIDA!\n\nA praga destruiu tudo, mas voc\u00ea tem os soros de sobreviv\u00eancia! Em Drunk Or Dead 2, regule o n\u00edvel de ant\u00eddoto no sangue para conter o v\u00edrus. Junte amigos, carregue o calibre pesado e mergulhe em um VR  insano, equilibrando loucura e precis\u00e3o perfeita!\n\n{1803755958080804}\n\n## \ud83c\udf92 TEMPORADA 1: RUMO AO SUPERMERCADO\nUma aventura epis\u00f3dica em VR completa e independente, cheia de a\u00e7\u00e3o ca\u00f3tica! Ajude Triss a encontrar aliados e esmague mutantes at\u00e9 o destino final: o Supermercado!\n\n### \ud83d\udd25 RECURSOS:\n* **Estimulantes Inst\u00e1veis:** Beba soros em combate para ativar combos e c\u00e2mera lenta. Consegue atirar quando o ch\u00e3o come\u00e7ar a rodar?\n* **Neuro Zumbis:** Enfrente esquadr\u00f5es militares infectados que usam cobertura, flanqueiam e disparam fogo de supress\u00e3o. Zumbis com t\u00e1tica!\n* **Massacre com Ve\u00edculos:** Assuma o volante de ve\u00edculos p\u00f3s-apocal\u00edpticos e triture monstros com seu esquadr\u00e3o.\n* **Modo Horda:** Teste seus limites em arenas especiais contra ondas inimigas que ficam cada vez mais fortes.\n\n---\n*\u26a0\ufe0f Nota: A Temporada 1 termina no Supermercado. A Temporada 2 est\u00e1 em desenvolvimento e chegar\u00e1 como DLC! Hora do caos cooperativo!*\n\n\n", "short_description": "O \u00fanico apocalipse zumbi onde um coquetel inst\u00e1vel salva sua vida! A praga destruiu tudo, mas voc\u00ea tem um segredo: os soros vol\u00e1teis de sobreviv\u00eancia. Junte seus amigos, carregue o calibre pesado e mergulhe em uma aventura insana em VR onde voc\u00ea deve equilibrar loucura total e precis\u00e3o cir\u00fargica. Jogue a Temporada 1 hoje, ajude Triss e esmague mutantes at\u00e9 o Supermercado!"}, {"images": {"nodes": []}, "id": "1250133147317911", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drunk Or Dead 2", "keywords": ["zombiesvr", "vrshooter", "vrkoop", "vraction", "survivalspiel"], "long_description": "## \ud83d\udca5 INSTABILER COCKTAIL RETTET DEIN LEBEN!\n\nDie Zivilisation ist am Ende, aber du hast \u00dcberlebensseren! In Drunk Or Dead 2 musst du das Virus eind\u00e4mmen, indem du den Serum-Spiegel im Blut regulierst. Schnapp dir Freunde, lade schweres Kaliber und erlebe ein irres VR-Abenteuer, das Wahnsinn und Pr\u00e4zision perfekt balanciert!\n\n{1806223570720766}\n\n## \ud83c\udf92 STAFFEL 1: AUF ZUM SUPERMARKT\nJeder \u00dcberlebende hat eine Geschichte. Dies ist die erste \u2014 ein eigenst\u00e4ndiges Episoden-VR-Abenteuer voller Action! Hilf Triss, Verb\u00fcndete zu finden, und rasiere Mutanten auf dem Weg zum finalen Ziel: dem Supermarkt!\n\n### \ud83d\udd25 FEATURES:\n* **Instabiles Stimulanzien-System:** Trinke volatile Seren im Kampf, um Combos und Zeitlupe zu triggern. Kannst du noch zielen, wenn der Boden schwankt?\n* **Smarte Neuro-Zombies:** K\u00e4mpfe gegen infizierte Milit\u00e4rtrupps, die Deckung nutzen, flankieren und heftiges Sperrfeuer geben. Zombies mit Taktik!\n* **Horden-Massaker per Vehikel:** Setz dich ans Steuer postapokalyptischer Fahrzeuge und verarbeite Monster im Team zu Hackfleisch.\n* **Endloser Horden-Modus:** Teste deine Grenzen in Spezial-Arenen gegen immer st\u00e4rkere Gegnerwellen.\n\n---\n*\u26a0\ufe0f Hinweis: Die Story von Staffel 1 endet am Supermarkt. Staffel 2 ist in Arbeit und kommt als DLC! Zeit f\u00fcr Koop-Chaos!*\n", "short_description": "Die einzige Zombie-Apokalypse, in der ein instabiler Cocktail dein Leben rettet! Eine brutale Plage hat die Welt zerst\u00f6rt, aber du hast eine Geheimwaffe: volatile \u00dcberlebensseren. Schnapp dir deine Freunde, lade das schwere Kaliber und st\u00fcrze dich in ein verr\u00fccktes VR-Abenteuer, bei dem du den schmalen Grat zwischen totalem Wahnsinn und perfekter Pr\u00e4zision meistern musst!"}, {"images": {"nodes": []}, "id": "1136814138683288", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drunk Or Dead 2", "keywords": ["zombiesvr", "tirvr", "vrcoop", "actionvr", "jeuxdesurvie"], "long_description": "## \ud83d\udca5 UN COCKTAIL INSTABLE VOUS SAUVE LA VIE !\n\nLa peste a d\u00e9truit la civilisation, mais vous avez des s\u00e9rums de survie ! Dans Drunk Or Dead 2, contenez le virus en r\u00e9gulant le taux d'antidote dans votre sang. R\u00e9unissez vos amis, chargez le gros calibre et plongez dans une VR folle, entre d\u00e9mence et pr\u00e9cision parfaite !\n\n{1395080949281225}\n\n## \ud83c\udf92 SAISON 1 : CAP SUR LE SUPERMARCH\u00c9\nChaque survivant a son histoire, voici la premi\u00e8re ! Une aventure VR \u00e9pisodique compl\u00e8te et ind\u00e9pendante, pleine d'action chaotique. Aidez Triss \u00e0 trouver des alli\u00e9s et \u00e9crasez les mutants jusqu'\u00e0 la destination finale : le Supermarch\u00e9 !\n\n### \ud83d\udd25 CARACT\u00c9RISTIQUES :\n* **Stimulants Instables :** Buvez des s\u00e9rums en combat pour activer des combos et du ralenti. Arriverez-vous \u00e0 viser quand le sol se mettra \u00e0 tourner ?\n* **Neuro-Zombies Intelligents :** Affrontez des escouades militaires infect\u00e9es qui se mettent \u00e0 couvert, flanquent et tirent un feu de suppression. Des zombies tactiques !\n* **Massacre en V\u00e9hicule :** Prenez le volant de bolides post-apocalyptiques et broyez les monstres avec votre \u00e9quipe.\n* **Mode Horde Sans Fin :** Testez vos limites dans des ar\u00e8nes sp\u00e9ciales contre des vagues d'ennemis de plus en plus fortes.\n\n---\n*\u26a0\ufe0f Note : L'histoire de la Saison 1 se termine au Supermarch\u00e9. La Saison 2 est en d\u00e9veloppement actif et arrivera en DLC ! Place au chaos coop\u00e9ratif !*\n", "short_description": "La seule apocalypse zombie o\u00f9 un cocktail instable vous sauve la vie ! Un virus brutal a d\u00e9truit la civilisation, mais vous avez une arme secr\u00e8te : des s\u00e9rums de survie volatils. Rassemblez vos amis, chargez le gros calibre et plongez dans une aventure VR  folle o\u00f9 vous devez \u00e9quilibrer folie totale et pr\u00e9cision chirurgicale !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://4ilab.io/privacy", "developer_terms_of_service_url": "https://4ilab.io/terms", "publisher_name": "4 I LAB LTD", "support_website_url": null, "website_url": "https://4ilab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "pt_BR", "de", "ru", "fr", "it", "ja", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "29284415174509545"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820855_1545474289901595_1265532340316018837_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3uAwUGopMMQ7kNvwEK-0we&_nc_oc=AdqeuEuBDJeIjFacOgE_JPfaHvT5nJ43r2PbLy8JkbSQeiP5mAk95rQL7wgkgZ7K2Hw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2nNJEMRzSkbkrD5yyts3IGNkw9SwR5Nzt3YQwUb_ShA&oe=6AE9E2BA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Drunk Or Dead 2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "6443548731
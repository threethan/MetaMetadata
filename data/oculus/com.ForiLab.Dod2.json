scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491830007_1775918209873932_363204617420510609_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2NKAjEJfCcQ7kNvwHV9oLC&_nc_oc=AdomZRfjF0YA-FXgtXLL4UZTBKLUMRG8XsvMatCIfT5QHS9Es0wAffdP9fzmMQb_XDw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1G9N-TSuXc7tIsCyADvSj9DIKG7sZxu9G-mUhMN9TEYg&oe=69F5F28D"}, {"file_name": "DoD2 2024-05-28 11-35-42 (0-25-18-39).png", "id": "861151629617134", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823790_861151632950467_1575565934216625427_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1hjAJQ7RXkQ7kNvwGRPQZT&_nc_oc=Adq8uk1D-q1Wpo7GPiS6Xexi__2rgmnLhXOlgAAIx22qkbXGkqAmLtvd4xgZkkpVNfc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0tqU576b0M-SM5kpOV87J2-FmWt2iEoFKjgp7ZhOFu6A&oe=69F60247"}, {"file_name": "DoD2 2024-05-28 11-35-42 (0-31-27-00).png", "id": "2213675815780096", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820428_2213675819113429_2339079547917946445_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETUFssVxRpgQ7kNvwFx6Y0Z&_nc_oc=Adqd8_enn9TWolL7cU3fsCjA5AWVls3X_dXehSIVMViQ5wtD8z3aGpeLU0M-5wIAo-o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0rxDQ7Btwu9CIPtVER2oYBEQQVDXGUFq8_ZM4CHGibCg&oe=69F5EFBE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoD_Key_ART_for_Meta.png", "id": "1548928505912944", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982620_1548928515912943_1441057688188324508_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJvmfGNqDfsQ7kNvwHJgJ1i&_nc_oc=AdrIjkXm3Hc2kNZJzbj0pQHdTqEEWUq6JKPv5DEZS3RdYgHeos07QJSLCRRhDJws13E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0BegSkKtpNR8BxZPacGs1LK1ylpkyAAzX3juF0kTgaoA&oe=69F5E7D4"}, "display_name": "Drunk Or Dead 2", "keywords": ["arcadeshooter", "zombievr", "vraction", "fastpaced", "shootinggame"], "long_description": "Drunk Or Dead 2 is a fast-paced VR action shooter where unstable survival enhancements keep you alive.\n\nA brutal zombie plague wiped out civilization. Only those affected by strange experimental substances survived, gaining unpredictable but powerful side effects. These effects fuel your abilities, alter combat flow, and force you to balance risk and control every time you leave safety.\n\nYour gameplay loop is simple and deadly: gear up, venture into hostile zones, fight through zombies, loot scarce supplies and bizarre ingredients, then decide whether to retreat or push deeper for greater rewards.\n\nCombat is built for VR from the ground up. Aim, shoot, reload, and react under pressure using a wide arsenal of weapons. Not all enemies are mindless \u2014 Neurozombies can aim, shoot, and punish bad positioning.\n\nProgress through an episodic experience with 10 planned chapters.\n\nIn this world, every bullet, every effect, and every bad decision counts.", "short_description": "Drunk Or Dead 2 is a fast-paced VR zombie shooter built around unstable survival enhancements.\n\nA zombie outbreak destroyed the world. Strange experimental concoctions are the only reason you\u2019re still alive, granting powerful side effects that push combat into chaos. Venture into dangerous zones, fight aggressive enemies, loot supplies and bizarre ingredients, then decide how far you dare to push.\n\nFace Neurozombies who can aim and shoot back.\n\nEvery bullet, every dose, every decision matters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://4ilab.io/privacy", "developer_terms_of_service_url": "https://4ilab.io/terms", "publisher_name": "4 I LAB LTD", "support_website_url": null, "website_url": "https://4ilab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_
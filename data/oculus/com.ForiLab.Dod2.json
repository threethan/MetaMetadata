f_3S-SoSVWV8Ok_avIpoWHlAUQEjoRzpNOxs9OeGJ1eBbZqx0EFM3uNcBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUOMqYRaija4t4mOgiPBj2rkp5uwdxFKLDTZOfXcpR_ng&oe=6B106458"}]}, "id": "1660006672342967", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1652508219739795", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823837_1652508223073128_8776179781560361605_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yghQBApeTp8Q7kNvwH8_B4Q&_nc_oc=AdpRfQlGAqrdEejCghzI7r8_sovLcRcEvgwf261_FldZ0bNLGcJbEf8BoLgT-echU9A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUkztPWPbZp-uQ04-clGenXnSwOOQkBrMFqY-CTw7BN7g&oe=6B105700"}, {"file_name": "3.png", "id": "1141500615297254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_1141500618630587_2404695693966413328_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZhTGiOhyccQ7kNvwEXXjwF&_nc_oc=Adpb0qHabQcFYUsVpoj8vE1QG3UgQs7cy9qF3twD5pPSWo3W6WPOofweEVwm0F1qcW4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWfN9c6F6EYtt1aRKlhbjNp1a6RJbnj_-Kr2OdMMxH10w&oe=6B104B07"}, {"file_name": "5.png", "id": "1700605798072801", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823366_1700605804739467_7257913649813500594_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjTUSmSrhM4Q7kNvwEyVSfw&_nc_oc=AdqJwe2KOw92eIlPJ6AJrCj97Vk_PVbia01VhePctjDZCteNpsCfUl304INGoXfgUaU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWN14yYDEhnitPXuGUmTUNdCeAkuXwq1e6r1gnC-wMm8Q&oe=6B1057A3"}, {"file_name": "2.png", "id": "959424440245914", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823812_959424443579247_7737539148839643656_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiRkC1CwZvoQ7kNvwHChnDz&_nc_oc=Adom5sk8d4xjn5PlmJ-M0xkJnKy3qw1EF_MqP82Zl5FHfn51We5J7pfgU1BCuk8LBUU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWii9EZMR5EAM68153Icx7sB-cZGF3mGNDWyaVNuw7jAQ&oe=6B103CCD"}, {"file_name": "4.png", "id": "2310513803068944", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_2310513809735610_3689146756871476551_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmBay2kgtvwQ7kNvwGt0V70&_nc_oc=AdpugCvUwyABH7C6xDbbePv0J6oXpiSIyjgG_WeCbFuVtLw3BgMNzn3ivT3kFA2rjOU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV-l0aavki_eCaEbSZk5_04DIX3QMPMwKETRiIt3TuNkQ&oe=6B10471F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DoD_Key_ART_for_Meta.png", "id": "1548928505912944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982620_1548928515912943_1441057688188324508_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6Dm-WiHff4Q7kNvwFVOr6z&_nc_oc=AdobZ1QmHmPPL8U3EbV_wB52SMG_M9Q3nf6ONXkaFw6FROmQ1Ag2zUb2lQL26rtMcYY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWDmx6u_IoRxgxWXFj5p2oeQFhdO-oIKwGcCxhH1grdng&oe=6B104114"}, "display_name": "Drunk Or Dead 2", "keywords": ["zombies", "shooter", "comedy", "action", "Fight"], "long_description": "Forget standard VR zombie shooters. Most games want you to stay focused and keep a steady hand. Drunk Or Dead 2 tells you to gulp down a glowing, unstable serum mid-firefight and pray you can still aim straight when the room starts spinning.\n\nHere\u2019s the deal: a brutal plague wiped out the world, and the only thing keeping you from mutating is maintaining a steady dose of survival elixirs in your blood. Step too far outside your safe zone without your stash of tonics, and the antidote wears off fast\u2014turning you straight into a zombie. So you grab heavy guns, chug an elixir for a slow-motion combat boost, and survive the chaos while your vision warps.\n\n{2228484847708225}\n\nThis isn\u2019t just a static shooting gallery. It\u2019s a full, standalone single-player road-trip campaign packed with dark humor and over-the-top action. Team up with Triss, rescue survivors, and blast through a ruined world to reach the ultimate stronghold: the Supermarket.\n\nWhy it\u2019s a blast:\nYou're up against smart infected military squads that take cover, flank you, and lay down heavy suppressive fire. When things get hot, jump behind the wheel of armored post-apocalyptic rides and turn massive hordes into roadkill. After the story, test your limits in the Endless Horde Arena.\n\nPlay standing up or kicked back in your chair\u2014it\u2019s pure, unfiltered VR fun. Load up, boost up, and stay sharp.\n\n\n", "short_description": "Forget standard VR zombie shooters. In Drunk Or Dead 2, you gulp down glowing, unstable serums mid-firefight for slow-motion boosts\u2014and pray you can still aim straight when the room starts spinning. \n\nTeam up with Triss in a wild, single-player road-trip campaign packed with dark humor and heavy guns. Blast through smart mutant squads, drive armored rides, and fight your way to the Supermarket. Play standing or seated\u2014just don't let the antidote wear off!\n"}, {"images": {"nodes": []}, "id": "1553857929884441", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drunk Or Dead 2", "keywords": ["zombie", "tir", "action", "survie", "humour"], "long_description": "Oubliez les jeux de tir zombies classiques en VR. La plupart vous demandent de garder votre sang-froid et une main ferme. Drunk Or Dead 2 vous dit d'avaler un s\u00e9rum lumineux et instable en plein combat, et de prier pour viser juste quand toute la pi\u00e8ce se met \u00e0 tourner.\n\nLe topo est simple : une peste brutale a ravag\u00e9 le monde, et la seule fa\u00e7on d'\u00e9viter la mutation est de maintenir une dose constante d'\u00e9lixirs de survie dans votre sang. \u00c9loignez-vous trop de votre zone s\u00fbre sans votre r\u00e9serve de toniques, et l'antidote s'estompe vite\u2026 vous transformant direct en zombie. Alors attrapez de gros calibres, buvez un \u00e9lixir pour ralentir le temps, et survivez au chaos pendant que votre vision se d\u00e9forme.\n\n{1395080949281225}\n\nCe n'est pas un simple stand de tir statique. C'est une campagne road-trip solo compl\u00e8te et autonome, bourr\u00e9e d'humour noir et d'action d\u00e9jant\u00e9e. Faites \u00e9quipe avec Triss, sauvez des survivants et frayez-vous un chemin \u00e0 travers un monde en ruines jusqu'au bastion ultime : le Supermarch\u00e9.\n\nPourquoi c'est ultra fun :\nVous affrontez des escouades militaires infect\u00e9es malignes qui se mettent \u00e0 couvert, vous contournent et l\u00e2chent des tirs de suppression. Quand \u00e7a chauffe trop, sautez au volant de bolides blind\u00e9s post-apocalyptiques et \u00e9crasez des hordes massives.\n\nJouez debout ou confortablement assis : c'est du pur fun VR sans filtre. Chargez, boostez-vous et gardez le cap.\n", "short_description": "Oubliez les jeux de tir zombies classiques en VR. Dans Drunk Or Dead 2, avalez un s\u00e9rum instable en plein combat pour ralentir le temps\u2026 et priez pour viser juste quand tout se met \u00e0 tourner !\n\nRejoignez Triss dans une campagne solo d\u00e9jant\u00e9e m\u00ealant humour noir et gros calibres. Affrontez des escouades de mutants rus\u00e9s, pilotez des v\u00e9hicules blind\u00e9s et frayez-vous un chemin jusqu'au Supermarch\u00e9. Jouable assis ou debout : ne laissez pas l'antidote s'estomper !\n"}, {"images": {"nodes": []}, "id": "1158653680077731", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drunk Or Dead 2", "keywords": ["zombie", "shooter", "action", "\u00fcberleben", "humor"], "long_description": "Vergiss normale VR-Zombie-Shooter. Die meisten wollen, dass du cool bleibst und eine ruhige Hand beh\u00e4ltst. Drunk Or Dead 2 sagt dir: Kipp dir mitten im Gefecht ein leuchtendes, instabiles Serum rein und bete, dass du noch triffst, wenn sich der ganze Raum dreht.\n\nSo l\u00e4uft\u2019s: Eine brutale Seuche hat die Welt zerst\u00f6rt, und nur eine konstante Dosis \u00dcberlebenselixiere im Blut h\u00e4lt dich davon ab zu mutieren. Entfernst du dich ohne deinen Vorrat an Tonika zu weit aus deiner sicheren Zone, l\u00e4sst das Gegenmittel schnell nach \u2013 und du wirst selbst zum Zombie. Also schnapp dir schwere Waffen, ex ein Elixier f\u00fcr Zeitlupen-Boosts und \u00fcberlebe das Chaos, w\u00e4hrend sich deine Sicht verzerrt.\n\n{1806223570720766}\n\nDas ist keine langweilige Schie\u00dfbude. Es ist eine komplette, eigenst\u00e4ndige Singleplayer-Roadtrip-Kampagne voller schwarzem Humor und durchgeknallter Action. Verb\u00fcnde dich mit Triss, rette \u00dcberlebende und ballere dir deinen Weg durch eine zerst\u00f6rte Welt bis zur letzten Festung: dem Supermarkt.\n\nWarum es mega Bock macht:\nDu trittst gegen clevere infizierte Milit\u00e4rtrupps an, die Deckung nutzen, dich flankieren und hartes Sperrfeuer geben. Wenn es zu hei\u00df wird, spring ans Steuer gepanzerter Endzeit-Karren und walze riesige Horden einfach platt.\n\nSpiel im Stehen oder ganz entspannt im Sitzen \u2013 das ist purer VR-Spa\u00df ohne Filter. Durchladen, boosten und dranbleiben.\n", "short_description": "Vergiss normale VR-Zombie-Shooter. In Drunk Or Dead 2 schluckst du mitten im Gefecht leuchtende, instabile Seren f\u00fcr Zeitlupen-Boosts \u2013 und betest, dass du noch triffst, wenn sich der Raum dreht.\n\nBegleite Triss auf einer wilden Singleplayer-Roadtrip-Kampagne voller schwarzem Humor und schwerer Waffen. K\u00e4mpfe gegen clevere Mutanten-Trupps, fahre gepanzerte Karren und bahne dir deinen Weg zum Supermarkt. Spielbar im Stehen oder Sitzen \u2013 lass nur das Gegenmittel nicht nachlassen!\n"}, {"images": {"nodes": []}, "id": "1155714286836117", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drunk Or Dead 2", "keywords": ["zumbi", "shooter", "action", "tiro", "sobreviv\u00eancia"], "long_description": "Esque\u00e7a os jogos de tiro zumbi comuns em VR. A maioria quer que voc\u00ea mantenha a calma e a m\u00e3o firme. Drunk Or Dead 2 manda voc\u00ea virar um soro brilhante e inst\u00e1vel no meio do tiroteio e rezar para continuar acertando os tiros quando a sala inteira come\u00e7a a girar.\n\nO esquema \u00e9 o seguinte: uma praga brutal acabou com o mundo, e a \u00fanica coisa que impede voc\u00ea de virar um mutante \u00e9 manter uma dose constante de elixires de sobreviv\u00eancia no sangue. Se voc\u00ea se afastar demais da sua zona segura sem seu estoque de t\u00f4nicos, o ant\u00eddoto passa r\u00e1pido \u2014 e voc\u00ea vira zumbi na hora. Ent\u00e3o pegue armas pesadas, tome um elixir para ativar o modo c\u00e2mera lenta e sobreviva ao caos enquanto sua vis\u00e3o distorce.\n\n{1803755958080804}\n\nIsso n\u00e3o \u00e9 apenas um estande de tiro parado. \u00c9 uma campanha solo completa e independente em estilo road-trip, cheia de humor \u00e1cido e a\u00e7\u00e3o exagerada. Junte-se a Triss, resgate sobreviventes e abra caminho na bala por um mundo destru\u00eddo at\u00e9 alcan\u00e7ar a fortaleza final: o Supermercado.\n\nPor que \u00e9 divertido demais:\nVoc\u00ea enfrenta esquadr\u00f5es militares infectados espertos que usam cobertura, flanqueiam sua posi\u00e7\u00e3o e mandam fogo pesado de supress\u00e3o. Quando a coisa esquentar, pule no volante de carros blindados p\u00f3s-apocal\u00edpticos e atropele hordas gigantes.\n\nJogue em p\u00e9 ou bem relaxado na cadeira \u2014 \u00e9 pura divers\u00e3o em VR sem filtros. Recarregue, ative o boost e mantenha o foco.\n\n\n", "short_description": "Esque\u00e7a os jogos de tiro zumbi comuns em VR. Em Drunk Or Dead 2, voc\u00ea vira um soro brilhante e inst\u00e1vel no meio do tiroteio para ativar c\u00e2mera lenta \u2014 e reza para acertar o alvo quando a sala come\u00e7a a girar!\n\nJunte-se a Triss em uma campanha solo insana cheia de humor \u00e1cido e armas pesadas. Enfrente esquadr\u00f5es mutantes espertos, dirija carros blindados e abra caminho at\u00e9 o Supermercado. Jogue em p\u00e9 ou sentado \u2014 s\u00f3 n\u00e3o deixe o ant\u00eddoto acabar!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://4ilab.io/privacy", "developer_terms_of_service_url": "https://4ilab.io/terms", "publisher_name": "4 I LAB LTD", "support_website_url": null, "website_url": "https://4ilab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "pt_BR", "de", "ru", "fr", "it", "ja", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "29771592719125119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820855_1545474289901595_1265532340316018837_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JTe-V6WrkcQ7kNvwHgc86y&_nc_oc=Adr2L-WNZh5_ROr9_YRcUHWqGk19uJB_QaQjkimkL1N0YLqtHQIESnzPgUkVQ56YgZA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUi5yMeerzLiqVYcnruvCbhHF-QcJW1Q6O4vWmcgfmtEw&oe=6B10567A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Drunk Or Dead 2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"top
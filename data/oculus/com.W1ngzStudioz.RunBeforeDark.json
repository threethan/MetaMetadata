=0gQczo-X1E4Q7kNvwEPgqbQ&_nc_oc=Adlr5iEs0znsFOtgLb6BUp_2GJmH2tZ-vlodvs7IrtXb8_2vZc4wVMi9_wvrdNOLRuY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyi7V1Nt47uiP_ZCRZWkGioGPifrJkrmX-tuYukVrPBnw&oe=69AED528"}, {"file_name": "Screenshot 2025-08-29 180452.png", "id": "612545391929391", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499295272_612545395262724_3408789596875465283_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uTIgvaP96cQ7kNvwHe_w1D&_nc_oc=AdmJrGDETXLLwGWxtYcRriUbtPDUPNH1ItxmpIvqiIg-xtgJycptOwJ1X36tT-xf-1w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGKetMs-knW4Iz4sV42WdvDK1OJICx5eDXHP7eTvfmpA&oe=69AEA69C"}, {"file_name": "Screenshot 2025-08-29 180416.png", "id": "970018145252789", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307935_970018148586122_1555365120144017770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6p2WltWE4YQ7kNvwGOOgA_&_nc_oc=AdmsrIl1T7KOD5aQbywHsnl6UTrri25Ue8134QrWbtN4DVBkIGxqbvPqPFPXiGPe30M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyL6YdzLATxaWeShH-xcd-to9NY42bTuLLoz_haUvNpAg&oe=69AEAD67"}, {"file_name": "Screenshot 2025-08-29 180427.png", "id": "1687359525278864", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304764_1687359528612197_3974438224913184066_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i82fxBlJhvkQ7kNvwGg7AD4&_nc_oc=AdkqZOu0h6RW1Pgx4rSZVXIbKOHaA0uvaEuvZVhieuJLyJ51vn9QPaKtjrL5gQpENyA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHmpKG8RsPkEM3eut_b-pzjZd16oMXL8LtW5GOzIVQFg&oe=69AEBCB7"}, {"file_name": "Screenshot 2025-08-29 180247.png", "id": "1505239580511680", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303746_1505239583845013_6366728876240561663_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZn0nJVR5KgQ7kNvwEpj_Ob&_nc_oc=AdlwLgyYBCOpyOfyDn90LWHhzR0Vzh20D8tIVnDHP1dNDxsD1zM3qSbvMGKOnxeNQso&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwyNTTex89UFDJcngpvkhgHpUdBMmkeU8gfXXS_ZZlDTg&oe=69AED83B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RUN BEFORE DARK!", "keywords": [], "long_description": "Prepare yourself for a pulse-pounding escape into the shadows of the unknown. Run Before Dark is a terrifying new twist on the beloved Gorilla Tag movement mechanics\u2014blending primal parkour with immersive horror to create a game that keeps your heart racing and your feet (or hands) moving.\n\nTrapped in a forgotten facility deep in the forest, you and other players must outclimb, outrun, and outsmart the horrors that awaken as night falls. Using only your agility, instincts, and wits, traverse eerie environments full of dark corridors, haunting sounds, and lurking nightmares that evolve as the game progresses.\n\nBut be warned: the longer you survive, the darker it gets. The creatures stalking you are not just fast\u2014they\u2019re relentless. Stick together, or go solo. Hide in shadows or keep moving. Every choice matters, and every second counts.", "short_description": "Welcome to Run Before Dark! A horror game using the well known locomotion of gorilla tag!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1tAJTBuPH8qw1TB696ys28eh6cwXWjtbP0ROPnN-dHQw/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "W1NGZ", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1Vh0J-mazHG1X_R13QEcDgKza8Hwtv7ZRLeDLD4gJNJw/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
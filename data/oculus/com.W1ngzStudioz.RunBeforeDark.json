=J0zGb8Fg1U4Q7kNvwFO5jux&_nc_oc=Adl4FWEpuCkCZTHN-ohoYdmCpxD2S1w-v8JDpLWcYOa4RLMgeD4YCs1r2oWAI4HKurU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzgFxy5T59n8JytiUSpf0gpr3VrleWRnZf8H8h3N-J0jA&oe=69BAB2A8"}, {"file_name": "Screenshot 2025-08-29 180452.png", "id": "612545391929391", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499295272_612545395262724_3408789596875465283_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L965sP1WNLwQ7kNvwEej-9T&_nc_oc=AdkLPr9uOXBOTpGmrU1JE-rihCEB1Pk9XD7LUJJ4-k8qKlXT1DQ8eKa3MgvFzqj7PLA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyfDYKlX6snbjIzGBdwUIHwHNgc7vgZZloeHTcpHZJXmw&oe=69BA841C"}, {"file_name": "Screenshot 2025-08-29 180416.png", "id": "970018145252789", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307935_970018148586122_1555365120144017770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kd8TtGpBWFsQ7kNvwHS1uH4&_nc_oc=AdkErmqxdFPkEYrOef4TddusAF5rBHwtI3gSvlixFpu35VMCTNIK6hwezvk6cxVJ1zI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPpId2PQktWyZf95LN5KoX6D81YBpn8SBLF0UV1W2g6A&oe=69BA8AE7"}, {"file_name": "Screenshot 2025-08-29 180427.png", "id": "1687359525278864", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304764_1687359528612197_3974438224913184066_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfShWCiJMGkQ7kNvwEMMjso&_nc_oc=AdkpsCOf_evQyQaOpiWeHbhPyxtiEnS89NXQh1fhWj4imPSE1_IbZ-wTOIUEFsmUgdw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxS360m4JIyWJD7k1wiyxOVv4wIPxvuQp42CsQ_704Aqg&oe=69BA9A37"}, {"file_name": "Screenshot 2025-08-29 180247.png", "id": "1505239580511680", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499303746_1505239583845013_6366728876240561663_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJ5SC3ArvTEQ7kNvwHXzHGJ&_nc_oc=AdnEFxaObpuFOneY2XGfNXVhC7CLG376kDN70HblId_-78nsA6sfkQGVPAVaQIcExHY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKJ38HWOJz8iAdr4VYZFNje4L4so-MIjAao1zp83J1VA&oe=69BAB5BB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RUN BEFORE DARK!", "keywords": [], "long_description": "Prepare yourself for a pulse-pounding escape into the shadows of the unknown. Run Before Dark is a terrifying new twist on the beloved Gorilla Tag movement mechanics\u2014blending primal parkour with immersive horror to create a game that keeps your heart racing and your feet (or hands) moving.\n\nTrapped in a forgotten facility deep in the forest, you and other players must outclimb, outrun, and outsmart the horrors that awaken as night falls. Using only your agility, instincts, and wits, traverse eerie environments full of dark corridors, haunting sounds, and lurking nightmares that evolve as the game progresses.\n\nBut be warned: the longer you survive, the darker it gets. The creatures stalking you are not just fast\u2014they\u2019re relentless. Stick together, or go solo. Hide in shadows or keep moving. Every choice matters, and every second counts.", "short_description": "Welcome to Run Before Dark! A horror game using the well known locomotion of gorilla tag!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1tAJTBuPH8qw1TB696ys28eh6cwXWjtbP0ROPnN-dHQw/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "W1NGZ", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1Vh0J-mazHG1X_R13QEcDgKza8Hwtv7ZRLeDLD4gJNJw/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
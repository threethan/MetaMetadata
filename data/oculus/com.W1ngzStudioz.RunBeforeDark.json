=8G_GZNG6bQkQ7kNvwEd6njh&_nc_oc=AdlPz2LIUucKwiMnRaRhSWgz6zZKuQ0KIB_p1rqxpRDPWfvOC-wErVEpOeMn6GQPpfU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVIjkpsU3aj27Jig3MULYI--0vDv39LVQKxZKvRs7iMA&oe=69B56CA8"}, {"file_name": "Screenshot 2025-08-29 180452.png", "id": "612545391929391", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295272_612545395262724_3408789596875465283_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_AooFW5rMfwQ7kNvwEhNt0g&_nc_oc=Admqm1KwTfGfaSc5f_tjHw1i7dz0wx6cNgzzthcuH9WcCmlkxbfv287yTKQHNS0J0ds&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5sOeoEI8490yRVMJXdKRcul8Af-21VkK7rhWjNJBPHA&oe=69B53E1C"}, {"file_name": "Screenshot 2025-08-29 180416.png", "id": "970018145252789", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307935_970018148586122_1555365120144017770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbsmXoRQQroQ7kNvwHkb4dR&_nc_oc=Adm0DsKURTXtZ1C5qvur36tQQ97IBi84k5J4z5FGCNcRaTEAerA4IdDXY3GZ1PcRbLc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy5RD-aeZ5CJB4KA4PS78cuzGr6_YegdcKJ42KW6WCYaQ&oe=69B544E7"}, {"file_name": "Screenshot 2025-08-29 180427.png", "id": "1687359525278864", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304764_1687359528612197_3974438224913184066_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gj0CAHPAwAsQ7kNvwEiiF1Q&_nc_oc=AdnvTA-kiH49apfU8ExBRNBNUuDZodrwgEkHd4Nmru6qtZO3-R5ZV9PCB3zfX-7f4FE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwm5Ft9wR1EdevTSwU95M0MH0ZmJujPuTIFv3KSlG7JZg&oe=69B55437"}, {"file_name": "Screenshot 2025-08-29 180247.png", "id": "1505239580511680", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303746_1505239583845013_6366728876240561663_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Pd7vdBnzRcQ7kNvwESYw4m&_nc_oc=AdmfUj6Vdz73y-treg69UcaB7XuW7M10abQpFsyErSdBhup-BDe5gWoRQTzzko6sOWk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwxZgnUouBJbfe6swE2jb1n9Gz3qh9ECcK5Ur_R2Q_org&oe=69B56FBB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RUN BEFORE DARK!", "keywords": [], "long_description": "Prepare yourself for a pulse-pounding escape into the shadows of the unknown. Run Before Dark is a terrifying new twist on the beloved Gorilla Tag movement mechanics\u2014blending primal parkour with immersive horror to create a game that keeps your heart racing and your feet (or hands) moving.\n\nTrapped in a forgotten facility deep in the forest, you and other players must outclimb, outrun, and outsmart the horrors that awaken as night falls. Using only your agility, instincts, and wits, traverse eerie environments full of dark corridors, haunting sounds, and lurking nightmares that evolve as the game progresses.\n\nBut be warned: the longer you survive, the darker it gets. The creatures stalking you are not just fast\u2014they\u2019re relentless. Stick together, or go solo. Hide in shadows or keep moving. Every choice matters, and every second counts.", "short_description": "Welcome to Run Before Dark! A horror game using the well known locomotion of gorilla tag!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1tAJTBuPH8qw1TB696ys28eh6cwXWjtbP0ROPnN-dHQw/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "W1NGZ", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1Vh0J-mazHG1X_R13QEcDgKza8Hwtv7ZRLeDLD4gJNJw/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
=nmsHOwQrhqMQ7kNvwE44C5q&_nc_oc=AdngJKQ_if4HDM3FzRC_1HHmFFagvylNh3ouDEf4FT07FPtoEOS_SJsKq4Wkb7a87dY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGdpj5X83b8adCrJ78qmzIeHH330T5wZh9bTVvf0nmDA&oe=69B2C9A8"}, {"file_name": "Screenshot 2025-08-29 180452.png", "id": "612545391929391", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499295272_612545395262724_3408789596875465283_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-tEkZp2aDoQ7kNvwF9_kCs&_nc_oc=AdlePUnCjWEClZx0Cj3VK-2EcUprihrMT80_GrCPjsI0PGUc6487xiG0BIhLJfdxsYE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzcbA3zrtIedvEQ7tSK1EPebF3-mt3GAldblmMprSFmog&oe=69B29B1C"}, {"file_name": "Screenshot 2025-08-29 180416.png", "id": "970018145252789", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307935_970018148586122_1555365120144017770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbsmXoRQQroQ7kNvwG8eOiS&_nc_oc=Adn8I6qqGQh1kK30xUGiZF3Dzo8bn1rOGwepwbvE_2z514JPtMZ5ea0H8WRY-adhr7E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwrGvILV0FfmdRQUd5uO5lcPjgAYx0FUbibB7uBDz9YDw&oe=69B2A1E7"}, {"file_name": "Screenshot 2025-08-29 180427.png", "id": "1687359525278864", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304764_1687359528612197_3974438224913184066_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvT-09t2ixkQ7kNvwE8fOJV&_nc_oc=Adn-8Vy8rRbkuLKLTs17S61DVQfd2G2sYH2Gy9P92PLm_66xHTxIc-dj1jQxYfm8HEs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3cIo-3xVMQH1eH7vUHvwtK8Zt3sz5XrzoO53EUlWuhg&oe=69B2B137"}, {"file_name": "Screenshot 2025-08-29 180247.png", "id": "1505239580511680", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303746_1505239583845013_6366728876240561663_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Tj8HPL1R1wQ7kNvwGWARR3&_nc_oc=Adk_0H58u2NDS3o_2u_340NhrrgUt9rZlnxhzKF0tYeUOKlNoE3iLAqD4fGgo5T94uA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzSt2DaGflOs4Lb8_sxFdiHWkVc1_c2y-3xaZIXwohQSQ&oe=69B2CCBB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RUN BEFORE DARK!", "keywords": [], "long_description": "Prepare yourself for a pulse-pounding escape into the shadows of the unknown. Run Before Dark is a terrifying new twist on the beloved Gorilla Tag movement mechanics\u2014blending primal parkour with immersive horror to create a game that keeps your heart racing and your feet (or hands) moving.\n\nTrapped in a forgotten facility deep in the forest, you and other players must outclimb, outrun, and outsmart the horrors that awaken as night falls. Using only your agility, instincts, and wits, traverse eerie environments full of dark corridors, haunting sounds, and lurking nightmares that evolve as the game progresses.\n\nBut be warned: the longer you survive, the darker it gets. The creatures stalking you are not just fast\u2014they\u2019re relentless. Stick together, or go solo. Hide in shadows or keep moving. Every choice matters, and every second counts.", "short_description": "Welcome to Run Before Dark! A horror game using the well known locomotion of gorilla tag!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1tAJTBuPH8qw1TB696ys28eh6cwXWjtbP0ROPnN-dHQw/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "W1NGZ", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1Vh0J-mazHG1X_R13QEcDgKza8Hwtv7ZRLeDLD4gJNJw/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
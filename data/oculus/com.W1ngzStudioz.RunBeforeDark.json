0a&_nc_ohc=knMss7TuTU8Q7kNvwFvPk6n&_nc_oc=Adr53lw-_Es4jzx4A4K0GzqbvVDKBkBhhNHI1g-1jopH1MSW6iKLMb8H4zqVHtSj4MA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRH0XhIARohbHa257tyeI2DAR_8YGTclPNPfYHfa1E11A&oe=6B0DC61C"}, {"file_name": "Screenshot 2025-08-29 180416.png", "id": "970018145252789", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307935_970018148586122_1555365120144017770_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dc3DqtKJ_tUQ7kNvwFHO1uP&_nc_oc=Adqr_l5QqcgwlkEQNJHnbIBfQQtQLgRU76TchSLQx72sjA4Ctj7iKL-Z_tkap3VprfY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSquUe_Nkmvr9cPYaKuFcePXi66QIsuFm7wR3QVAhTfbQ&oe=6B0DCCE7"}, {"file_name": "Screenshot 2025-08-29 180427.png", "id": "1687359525278864", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304764_1687359528612197_3974438224913184066_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJr8w3DLZmcQ7kNvwEejDvy&_nc_oc=AdoN3UwmH9Df1UgQlMIW3-DiFqU9A0hr3HwUQoCqSEvjBhJJbL60Mt1HB8r00mo2YNA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS7SK8wd9Mbfr8-S8_7Tn2_7eRSLkUOnYYMBiJVpLyZGA&oe=6B0DA3F7"}, {"file_name": "Screenshot 2025-08-29 180247.png", "id": "1505239580511680", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303746_1505239583845013_6366728876240561663_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6d6M81AafmAQ7kNvwHSEYSE&_nc_oc=AdqYH8HujZfwZ6SPTZgTiY-Yj26YMCXZ_X25O-Pds757S5Vpgxg7mYfPup0Zh_V6Bi8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSxn0axRIfwawNhdjKsoAnznDGGEaZlN2VzvLvAGltgZw&oe=6B0DBF7B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RUN BEFORE DARK!", "keywords": [], "long_description": "Prepare yourself for a pulse-pounding escape into the shadows of the unknown. Run Before Dark is a terrifying new twist on the beloved Gorilla Tag movement mechanics\u2014blending primal parkour with immersive horror to create a game that keeps your heart racing and your feet (or hands) moving.\n\nTrapped in a forgotten facility deep in the forest, you and other players must outclimb, outrun, and outsmart the horrors that awaken as night falls. Using only your agility, instincts, and wits, traverse eerie environments full of dark corridors, haunting sounds, and lurking nightmares that evolve as the game progresses.\n\nBut be warned: the longer you survive, the darker it gets. The creatures stalking you are not just fast\u2014they\u2019re relentless. Stick together, or go solo. Hide in shadows or keep moving. Every choice matters, and every second counts.", "short_description": "Welcome to Run Before Dark! A horror game using the well known locomotion of gorilla tag!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1tAJTBuPH8qw1TB696ys28eh6cwXWjtbP0ROPnN-dHQw/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "W1NGZ", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1Vh0J-mazHG1X_R13QEcDgKza8Hwtv7ZRLeDLD4gJNJw/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24878043198475509"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/
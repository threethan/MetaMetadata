S4-oKFyHS8wFDRWgYXwQBWtqg&oe=6A8D741C"}, {"file_name": "Screenshot 2025-08-29 180416.png", "id": "970018145252789", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499307935_970018148586122_1555365120144017770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poycCYhDH4kQ7kNvwFkmPBN&_nc_oc=AdpBiwVwtUswyOumSaJJNQnoJwr_zynrTZY86YrIvPFlUvRqeKBpmKoI4eYLsi3XHms&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAEUqlrgtsJLUlcX5gvs3Y1JW6_9K7W3JIFh05csA8Jg&oe=6A8D7AE7"}, {"file_name": "Screenshot 2025-08-29 180427.png", "id": "1687359525278864", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499304764_1687359528612197_3974438224913184066_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFUceKhFcQ0Q7kNvwFBv_f5&_nc_oc=Adq68pg27uYM1P_pI21k-wfEYka8tVYSehQ15RprVaU6MP7ExSDVTMBA7uD4SmK-ckk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGClUaUsilON_ZK8l_szij7TLuKoXReG740MKQ-tcZ2yg&oe=6A8D8A37"}, {"file_name": "Screenshot 2025-08-29 180247.png", "id": "1505239580511680", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499303746_1505239583845013_6366728876240561663_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qoe5F__LRoQ7kNvwFUKvCi&_nc_oc=AdpvKnvlJj8sB52DWbvCwapn-Pa88tFgbNMrlmXbiKhcIAmxJlZy2hdgLFYfZQRpUNk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNFNkUlrCZ3tA6N5evfUGAIKdtDsyyfrQok9O0xTrzCw&oe=6A8D6D7B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RUN BEFORE DARK!", "keywords": [], "long_description": "Prepare yourself for a pulse-pounding escape into the shadows of the unknown. Run Before Dark is a terrifying new twist on the beloved Gorilla Tag movement mechanics\u2014blending primal parkour with immersive horror to create a game that keeps your heart racing and your feet (or hands) moving.\n\nTrapped in a forgotten facility deep in the forest, you and other players must outclimb, outrun, and outsmart the horrors that awaken as night falls. Using only your agility, instincts, and wits, traverse eerie environments full of dark corridors, haunting sounds, and lurking nightmares that evolve as the game progresses.\n\nBut be warned: the longer you survive, the darker it gets. The creatures stalking you are not just fast\u2014they\u2019re relentless. Stick together, or go solo. Hide in shadows or keep moving. Every choice matters, and every second counts.", "short_description": "Welcome to Run Before Dark! A horror game using the well known locomotion of gorilla tag!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1tAJTBuPH8qw1TB696ys28eh6cwXWjtbP0ROPnN-dHQw/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "W1NGZ", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1Vh0J-mazHG1X_R13QEcDgKza8Hwtv7ZRLeDLD4gJNJw/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24878043198475509"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499307346_4015302792054713_5239565657258931934_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7rXI_8KKtoQ7kNvwGLc_DC&_nc_oc=AdpbsVvrEW7G2fWpyn3GbRKpL3jEC7EeGTMtXhRuJ9pBAV4CiIQ_g-BVK-ml_ZQyhSU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscd
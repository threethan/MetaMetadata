RYfoUcoc6etow&oe=6A37FADC"}, {"file_name": "Screenshot 2025-08-29 180416.png", "id": "970018145252789", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307935_970018148586122_1555365120144017770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grLFWJ02LgwQ7kNvwHDqTYz&_nc_oc=Adr_2I2Z1da59VV-IYb33UMRnx80KNAz0Y_oykMnXl0hv8iYIjX4e36JW3AK34NA9-0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_h9iqkM70HHmpEl30fP7V2YTleRXiRXX3hKs8Y-4kPhw&oe=6A3801A7"}, {"file_name": "Screenshot 2025-08-29 180427.png", "id": "1687359525278864", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304764_1687359528612197_3974438224913184066_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7GilM46mnYQ7kNvwGddEgy&_nc_oc=AdoIDmJLO5exHgIF52gywuf0C7E92kjP9-N12Sts3LZCmnHrC3JY3qGWKFguQvTFVZ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_htegmEdFKEOytldYzEPbADBx7OQEA2d9n4I9XDqkOOA&oe=6A3810F7"}, {"file_name": "Screenshot 2025-08-29 180247.png", "id": "1505239580511680", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303746_1505239583845013_6366728876240561663_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x17xahDqaeAQ7kNvwE5OKJm&_nc_oc=AdptR9q4YMfGX9kz_5EgyazknvYsJyRNxgaim1Vp_4dADpL1zxfVbUKJ1VL2fUQsV4U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Z4EvYmXqOAjl9OYbFdmz-x1CkHF5rdGH7h_D96GvSyQ&oe=6A37F43B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RUN BEFORE DARK!", "keywords": [], "long_description": "Prepare yourself for a pulse-pounding escape into the shadows of the unknown. Run Before Dark is a terrifying new twist on the beloved Gorilla Tag movement mechanics\u2014blending primal parkour with immersive horror to create a game that keeps your heart racing and your feet (or hands) moving.\n\nTrapped in a forgotten facility deep in the forest, you and other players must outclimb, outrun, and outsmart the horrors that awaken as night falls. Using only your agility, instincts, and wits, traverse eerie environments full of dark corridors, haunting sounds, and lurking nightmares that evolve as the game progresses.\n\nBut be warned: the longer you survive, the darker it gets. The creatures stalking you are not just fast\u2014they\u2019re relentless. Stick together, or go solo. Hide in shadows or keep moving. Every choice matters, and every second counts.", "short_description": "Welcome to Run Before Dark! A horror game using the well known locomotion of gorilla tag!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1tAJTBuPH8qw1TB696ys28eh6cwXWjtbP0ROPnN-dHQw/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "W1NGZ", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1Vh0J-mazHG1X_R13QEcDgKza8Hwtv7ZRLeDLD4gJNJw/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24878043198475509"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307346_4015302792054713_5239565657258931934_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNMQpn9GY5cQ7kNvwENj-f1&_nc_oc=AdoSeDLx8MLOiQDnxXvS4dEnYv0IQpR4c8Wfjgxc5tDzSIOr_BAa85DnegFYqH8NEEc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f
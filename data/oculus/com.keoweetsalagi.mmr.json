2782", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391937_584825267646115_8164220095021597837_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iA0RsujmxZgQ7kNvwFFVnGP&_nc_oc=Adq5oBH3ntZDEnfypXvMGlidZfhSiZlLm30iJC1Tvznj4f2K8aR4tnUuJ8Dv6i5tFzo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXdCC4pmQpfAAixI74_pHjmXxRZnt60FYohXCrDxChFzA&oe=6B0EF2EC"}, "display_name": "Money Meditation Room", "keywords": [], "long_description": "Money makes the world go round and we all need it. Some of us struggle with keeping money in our lives. But now by using our intentions and our mind, money has never been easier to draw to yourself. In 2020 we released a picture that can  help draw money to you through your subconscious mind. We took this picture and turned it into a room where you can meditate and be grateful that money is always coming to you.", "short_description": "The Money Meditation Room is a place where you can strenthen your subconscious mind to bring more money in your life. Take a look around the room, repeat the words and allow more money to flow into your life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://keoweeministries.org/money-room-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Keowee Tsalagi Ministries", "support_website_url": null, "website_url": "https://keoweeministries.org/money-meditation-room", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_
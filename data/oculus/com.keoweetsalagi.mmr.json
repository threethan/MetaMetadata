": "Money Meditation Room", "keywords": [], "long_description": "Money makes the world go round and we all need it. Some of us struggle with keeping money in our lives. But now by using our intentions and our mind, money has never been easier to draw to yourself. In 2020 we released a picture that can  help draw money to you through your subconscious mind. We took this picture and turned it into a room where you can meditate and be grateful that money is always coming to you.", "short_description": "The Money Meditation Room is a place where you can strenthen your subconscious mind to bring more money in your life. Take a look around the room, repeat the words and allow more money to flow into your life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://keoweeministries.org/money-room-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Keowee Tsalagi Ministries", "support_website_url": null, "website_url": "https://keoweeministries.org/money-meditation-room", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23884285901163232"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2005866199916492"}]}, "baseline_offer": {"id": "2005866199916492"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1737758040, "status": "PUBLISHED", "id"
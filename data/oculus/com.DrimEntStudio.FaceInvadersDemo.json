2_2136865874381972_4802359609706761629_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qio4akshnvgQ7kNvwFpfUua&_nc_oc=AdpLMwAV9_TlX5hujMDkADcFpL7VhrBPa71grIYjLVY-N5i3yCTQ-3veMQAeFXMfbc8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoBCcaeYIu_5ND6-upHcLffZIoRIkWaNl6CfKuAPJsdQ&oe=6ADF49CB"}, {"file_name": "FaceInvaders_Screenshot_6_HornedBoss.png", "id": "1577012684183622", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_1577012687516955_1392633407450882169_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6MmCZEm_PkQ7kNvwE6khA-&_nc_oc=Ado4_rVtWOlS3RttCB7U2wG8dYzcOfhwGTReMR8gP-6XeiR27Yx3CTI9tidB9lUsXFM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-l-p4Ls5V5OPrx7pKy3YXa4Av2PF_K4jaSHMtUdTlNQ&oe=6ADF7862"}, {"file_name": "FaceInvaders_Screenshot_2_StoneHead.png", "id": "2038484320198435", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_2038484323531768_1598647964587757620_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysOYkX88dMQQ7kNvwGmWkKL&_nc_oc=AdowxqEBT6Bq_eE5INyoCkjKOhdEe2iNGzqJdXhAnpsNh2WSWmEdGhfLoLXimXvL3Go&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqHSrpSpq_cjOjW8X9gsLp1zHZv1a2m80ZADw7OJvxGg&oe=6ADF5049"}, {"file_name": "FaceInvaders_Screenshot_5_GoldenRush.png", "id": "1387681570102620", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823905_1387681573435953_6911741242036691500_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPuBoChQVZwQ7kNvwEVfhYR&_nc_oc=AdrEZ9PsKDoIyaTCXPLlMKSc3K0VxwDPUxDwCFCB_EZN53MFDMcXTomuwceXoK0SLZg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6tBRZ3dqoVqWCYrAdX7ocfC8o5M_dph7mDQLg1BDRiw&oe=6ADF7128"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FaceInvaders_Cover_Landscape_SunsetAlt_2560x1440.png", "id": "27665872346422521", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827585_27665872353089187_2652184231761816350_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24V46WFVnTgQ7kNvwEW4qgA&_nc_oc=AdoRNXbSsSsOuQcsvWKfIfC3bjWNlSEXKQ3inwFwgd5duHMzd396uGhQ8MdYKP-tc8o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdudXD5YD_0REud0G5yIfMVzfgADoRAmjEqqc3t1a0_g&oe=6ADF446F"}, "display_name": "Face Invaders Demo", "keywords": ["arcade", "shooter", "loot", "roguelite", "blaster"], "long_description": "# Faces are invading the sky. Pop them all.  \n\nGoofy flying faces march in formation, spit at you and dive at your head.\nYou stand on a floating platform with a toy blaster. Keep them off your face.\n\n{1280508000863914}\n\n# Loot it. Plug it in.\n\nPopped faces drop gun parts onto the shelf at your waist.\nGrab one and plug it into your gun with your own hand.\n\n{1407412224331907}\n\n# Build your gun\n\nFour ports, 12 parts, five rarities: every part changes how your gun fires.\nAfter the first boss, a second gun joins in.\n\n{1810279406948674}\n\n# Fire, ice and lightning\n\nSet faces burning, freeze them solid, let lightning jump from face to face.\n\n{1126186509756829}\n\n# Giant bosses\n\nA horned brute, a King and a stone head with eye lasers.\nDodge with your body and aim for the eyes.\n\n{1091649933467325}\n\n# Features\n\n- **100 levels** in four worlds, a Golden Rush bonus level and a boss in every ten\n- Helmets, spitters, kamikazes, splitters, healers and **golden jackpot faces**\n- Combos up to **x25** and falling bonuses you shoot to take (some are bad)\n- **Infinite mode**, leaderboards with your friends and the world, 17 achievements\n- Stand in place: snap turn, a side step, seated play\n- 13 languages", "short_description": "Goofy flying faces are invading the sky. Stand your ground with a toy blaster and pop them wave after wave as they march in formation, spit at you and dive at your head. Loot gun parts from the faces you pop and plug them in with your own hands: scatter, rapid and rail barrels, fire, ice and shock cores, homing and ricochet muzzles. Build a gun that fits your style, then a second one. 100 levels, four worlds, giant bosses."}]}, "developer_name": "Driment Studio", "developer_privacy_policy_url": "https://drimentstudio.com/faceinvaders/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Driment Studio", "support_website_url": "https://drimentstudio.com/contact", "website_url": "https://drimentstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "it", "es", "es_MX", "pt_BR", "pl", "ru", "tr", "ja", "ko", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39041622898785566"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824700_4116390098665496_9191002129840678187_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDltwvtUurIQ7kNvwE5X3F9&_nc_oc=AdoISXzCEwRdBlaFFUhhfaTyUFKOF-86xjw-YEKCXCuLEvS-UGlLFvCfTZlL1JFulRg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlaWD9MmzlKVndFAllbQY5LSKxQK-S6qv84A_Hp14znA&oe=6ADF5698"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Face Invaders Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "A
76610_8625854046673385511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_j7LmrDCuhgQ7kNvwFH1fG9&_nc_oc=Adrr5FaeQC2GxsXlW5cAacuJHBx0hA2dKUOsEvcQk2GZUVvwoMVIKJPm1C4ekkva-VQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxF54C2BN7Q0e-GNB7x5tlxcMdMBvVkzLKxpD6sQrQXg&oe=6A65FBDF"}, "display_name": "Face Invaders Demo", "keywords": ["punch", "box", "face", "arcade", "powerup"], "long_description": "Face Invaders is a high-energy VR arcade brawler where your fists are your weapons and chaos is your playground. Smash incoming faces in rapid-fire waves, dodge wild attacks, and collect outrageous upgrades to boost your power. Take on towering bosses and push your reflexes to the limit in a fight for survival. It's punch-or-be-punched mayhem \u2014 are you ready to face the invasion?", "short_description": "Face Invaders is a fast-paced VR arcade brawler where you punch incoming faces, dodge chaos, and collect wild upgrades. Smash your way through waves of enemies, battle massive bosses, and become the ultimate face-slaying machine!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/1643ade9-7adf-4087-a457-cdefaf8e11b2", "developer_terms_of_service_url": null, "publisher_name": "Driment Studio", "support_website_url": null, "website_url": "https://drimentstudio.wuaze.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "suppo
5771-25/491820652_1885004162121381_311590315894752801_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5TBIUsc7vMQ7kNvwEH3z5J&_nc_oc=Adrxf76EbMBXCY8o9LL7C6t9Ap753LOEhNhplIXVT7jZ3Ce9PFBPjC8U4alFWoNt-XU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDF4dBdM4bRmtnfMfOfth-y_Kn7nqqlMrYVjV_8uMX4A&oe=6A58C17F"}, {"file_name": "Scenario List.png", "id": "2199426237533622", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823271_2199426240866955_7924959496276455667_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsOkx-N7S-AQ7kNvwFlRgRA&_nc_oc=Adpfez50O2kBiu3lhus-v18rH9IBjz1LVxqVrSKRXkR1iOq9VTNDX9uxa8cVPiDGtbM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5LR8eKmI_mm5h6oXvY8KLmLG7QUO-jbEmuqglDU-eyw&oe=6A58E0F5"}, {"file_name": "Leaderboards.png", "id": "1562070694897739", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491818885_1562070701564405_8213879947028492554_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2B4c0CGNIFkQ7kNvwF0U6h0&_nc_oc=AdpvWPvMsIoLKWztq3gll1X8beLffAFdu497kOfVXmke3SipcziHvkH875u_Gt-XrJM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaBtVVPRs-ckmsgqrUkyxodubqxRNHEVQjOrq3lHVBvg&oe=6A58F3A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e5253b6c-29e3-4ab2-8f16-5066fcb25645.png", "id": "1978866903040880", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499303198_1978866906374213_9192720447839566203_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjIYWoSMSG8Q7kNvwH2GVOu&_nc_oc=Adp4kH5rCXWJsmM5xVw63MaXZ_X37kTYtzz5T4bnmp9nieODHatVhhv7gpoKaLVbw4Y&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLL3TlKjmTjLNjrszk9U2yF7BHUg9Q2uJiapoC6ffcvg&oe=6A58C306"}, "display_name": "VR AIM", "keywords": ["Shooter", "Action", "Simulation"], "long_description": "VR AIM \u2013 The Aim Trainer Built for VR Shooters\n\nStop practicing on flat-screen trainers that don't transfer. VR AIM is designed from the ground up for VR mechanics, helping you build muscle memory that actually matters in-game.\n{892490393586061}\n\ud83d\udd25 **Drills That Matter** \u2013 Flicks, tracking, precision, speed. Multiple scenario types designed to target your weak spots and sharpen your strengths.\n\n{1972425153619209}\n\ud83c\udfaf **Your Settings, Your Way** \u2013 Match your training to your game. Adjust hand positioning, gun angles, and V-stock settings to feel exactly like VAIL, Pavlov, Breachers, or Onward.\n\n{1107486004816611}\n\n\ud83d\udc65 **Community Presets** \u2013 One-click setups from the community. Instantly load settings that match your favorite shooter \u2014 no guesswork needed.\n\n\n{25802754029335373}\n\n\ud83c\udfc6 **Compete & Climb** \u2013 Leaderboards for every scenario. See how you stack up and push yourself to beat the best.\n\n\n", "short_description": "The first aim trainer built specifically for VR.\n\nUnlike flat-screen trainers, VR AIM lets you customize everything to match your favorite shooter:\n\u2022 Hand positioning & gun angles\n\u2022 V-stock settings\n\u2022 Community presets for VAIL, Breachers, Pavlov, Forefront & more\n\nYour practice actually transfers to real games, because it feels identical.\n\nCompete on leaderboards across multiple scenarios. Track your improvement. Build the muscle memory that wins gunfights.\n\nYour aim. Your settings. Your edge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vraim.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VR AIM ApS", "support_website_url": null, "website_url": "https://vraim.com/meta", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "intern
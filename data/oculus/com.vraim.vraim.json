nc_ss=7f20f&oh=00_AQJXPw7DfNySZB46P1RuFvlTxkqZ4Tn1LbuPjtfqqRrIVQ&oe=6AA6BF05"}, {"file_name": "Both guns.png", "id": "1885004158788048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820652_1885004162121381_311590315894752801_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-jWkx8zNQ4Q7kNvwGEUIBA&_nc_oc=Adp3zZSifxU9_Te3f85o4C-_JvWB9ymxkribHdjRIK1LCFNysrd0I03iq4DCQtCewX0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVPxXamQIayYTFWOW6FmXMLSAR69BGepIMydSZt7znyw&oe=6AA6C23F"}, {"file_name": "Scenario List.png", "id": "2199426237533622", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823271_2199426240866955_7924959496276455667_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQopa8hq1ywQ7kNvwFLFMGv&_nc_oc=AdrhNIH6-a428q6FYaQ0UG5_wClZhUakNVuL_Y5RPkOTFiXfi-wjW9l9IxyHWhQI0JY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUg30fjg0c9BwwN6rSFFKHQivy0-yjFOXU1AwcmleL4Q&oe=6AA6A975"}, {"file_name": "Leaderboards.png", "id": "1562070694897739", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818885_1562070701564405_8213879947028492554_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7__OZX5m8oQ7kNvwEd9APo&_nc_oc=AdpBoxRTf8GyDV0T2t8eWgYoPmaF9vB7laVFOmRGAGl3E5bosHYvZISLdEsJXunwA1E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5bU3H_XSdPDyqdOxVSv6kcU0utSE2b3-whBS_MZhAyA&oe=6AA6BC27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e5253b6c-29e3-4ab2-8f16-5066fcb25645.png", "id": "1978866903040880", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303198_1978866906374213_9192720447839566203_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wads3j3QgPwQ7kNvwHIvTvy&_nc_oc=Ado_PsQhO4ndiKmDFhc2LfPetUYcRi5VJT-fGqtyZaP8L34hcCeFuiDgNkINAG5CTTw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXX954xYrInLmtp1KQ1P89l6Tc5VH1bEHW4sliLpz0dA&oe=6AA6C3C6"}, "display_name": "VR AIM", "keywords": ["Shooter", "Action", "Simulation"], "long_description": "VR AIM \u2013 The Aim Trainer Built for VR Shooters\n\nStop practicing on flat-screen trainers that don't transfer. VR AIM is designed from the ground up for VR mechanics, helping you build muscle memory that actually matters in-game.\n{892490393586061}\n\ud83d\udd25 **Drills That Matter** \u2013 Flicks, tracking, precision, speed. Multiple scenario types designed to target your weak spots and sharpen your strengths.\n\n{1972425153619209}\n\ud83c\udfaf **Your Settings, Your Way** \u2013 Match your training to your game. Adjust hand positioning, gun angles, and V-stock settings to feel exactly like VAIL, Pavlov, Breachers, or Onward.\n\n{1107486004816611}\n\n\ud83d\udc65 **Community Presets** \u2013 One-click setups from the community. Instantly load settings that match your favorite shooter \u2014 no guesswork needed.\n\n\n{25802754029335373}\n\n\ud83c\udfc6 **Compete & Climb** \u2013 Leaderboards for every scenario. See how you stack up and push yourself to beat the best.\n\n\n", "short_description": "The first aim trainer built specifically for VR.\n\nUnlike flat-screen trainers, VR AIM lets you customize everything to match your favorite shooter:\n\u2022 Hand positioning & gun angles\n\u2022 V-stock settings\n\u2022 Community presets for VAIL, Breachers, Pavlov, Forefront & more\n\nYour practice actually transfers to real games, because it feels identical.\n\nCompete on leaderboards across multiple scenarios. Track your improvement. Build the muscle memory that wins gunfights.\n\nYour aim. Your settings. Your edge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vraim.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VR AIM ApS", "support_website_url": null, "website_url": "https://vraim.com/meta", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}
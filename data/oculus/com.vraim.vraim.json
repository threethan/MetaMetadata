2659988165_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cp6nrkXvVNkQ7kNvwGe2_ly&_nc_oc=Adpyx19ZlwJYixHUsBbp__C7dGJ5V2gKpyUacDMGFqY4awevqgMUnsFSI-8DyiJakog&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzD0LPJgJ2kx7ZoOHgeTjFxKQke0lM7WSMHGpAdGrcZOA&oe=69CE50C5"}, {"file_name": "Both guns.png", "id": "1885004158788048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820652_1885004162121381_311590315894752801_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FG2yvH-lDCkQ7kNvwHQnF1K&_nc_oc=AdqEFLWe_0F3ar74d9wHSMFThwLqOKk566Zj4ApePg3yRVKLn2LOv5aJa-mQkv-R9IE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPkj2dNmlyzLGsVMzF4BtX0PxpK5l46nntew1c2h7tYw&oe=69CE53FF"}, {"file_name": "Scenario List.png", "id": "2199426237533622", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823271_2199426240866955_7924959496276455667_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CI4xQZnfz1IQ7kNvwGNd7ho&_nc_oc=AdqG1MqiUlN0f9eeTTov8S-exgdVfGH41xJW_eWxkJ9tjudYq-soa8PREZW3pgeEEbI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJX7Y0Py4tERP2_OttZNfe4Gjv514jds_n0-Mbw1xbEQ&oe=69CE7375"}, {"file_name": "Leaderboards.png", "id": "1562070694897739", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818885_1562070701564405_8213879947028492554_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crqbnzBVFNgQ7kNvwGg8won&_nc_oc=AdpZtDftovFbcs04mwL7cSNqJaH7VM9UpYlzJHtNpkv6hxlx3ZhQstbrBF9V1fYLQ7M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzrIKSuWbCvzE1u7GR1JkSdQtJuxVSiWmjKfT10C3u3XQ&oe=69CE4DE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e5253b6c-29e3-4ab2-8f16-5066fcb25645.png", "id": "1978866903040880", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303198_1978866906374213_9192720447839566203_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6C5fj4ldP7YQ7kNvwF0RTs3&_nc_oc=AdovqxLZDh1lYoZQvNZi94emDtod1RjXTk71HWbDfisJ9inQg_VWU9el-G982qlDRuI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwxZPrGrCygQbJkq-PJ5BTPu6TXCN4uXXqSwaLTGKV1Cw&oe=69CE5586"}, "display_name": "VR AIM", "keywords": ["Shooter", "Action", "Simulation"], "long_description": "VR AIM \u2013 The Aim Trainer Built for VR Shooters\n\nStop practicing on flat-screen trainers that don't transfer. VR AIM is designed from the ground up for VR mechanics, helping you build muscle memory that actually matters in-game.\n{892490393586061}\n\ud83d\udd25 **Drills That Matter** \u2013 Flicks, tracking, precision, speed. Multiple scenario types designed to target your weak spots and sharpen your strengths.\n\n{1972425153619209}\n\ud83c\udfaf **Your Settings, Your Way** \u2013 Match your training to your game. Adjust hand positioning, gun angles, and V-stock settings to feel exactly like VAIL, Pavlov, Breachers, or Onward.\n\n{1107486004816611}\n\n\ud83d\udc65 **Community Presets** \u2013 One-click setups from the community. Instantly load settings that match your favorite shooter \u2014 no guesswork needed.\n\n\n{25802754029335373}\n\n\ud83c\udfc6 **Compete & Climb** \u2013 Leaderboards for every scenario. See how you stack up and push yourself to beat the best.\n\n\n", "short_description": "The first aim trainer built specifically for VR.\n\nUnlike flat-screen trainers, VR AIM lets you customize everything to match your favorite shooter:\n\u2022 Hand positioning & gun angles\n\u2022 V-stock settings\n\u2022 Community presets for VAIL, Breachers, Pavlov, Forefront & more\n\nYour practice actually transfers to real games, because it feels identical.\n\nCompete on leaderboards across multiple scenarios. Track your improvement. Build the muscle memory that wins gunfights.\n\nYour aim. Your settings. Your edge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vraim.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VR AIM ApS", "support_website_url": null, "website_url": "https://vraim.com/meta", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26072175102394968"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818885_885537071147019_4958635011825878830_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6WJDGvS8YsQ7kNvwEPOk2B&_nc_oc=AdoaYO0KEj_udN11Uw5zDv3dUrg_5RwyCxb4fE8KJ48H8dqh3dcGPn61t0cvIx-EKXI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyTnDdkLGoowZc2h0gcJ3CuYVtEzobsemd7HQ6lBtE3lg&oe=69CE5C95"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR AIM", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1773499680, "lastRevision": {"nodes": [{"id": "26072175142394964", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26072175069061638", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": 
5771-25/491820652_1885004162121381_311590315894752801_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pC6wc73Xo3cQ7kNvwEHunuM&_nc_oc=AdrCQXHypxBPGdNhPOfjRUbsX-ZHQ-uFj3-eeFIpmiH5z0Efhhwy2XD4pUlhwDZiN9A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzwGaDnP6RwkNh8X73KLpAq-ZJbX_t8HUEupnzzHn4Ow&oe=6A731F7F"}, {"file_name": "Scenario List.png", "id": "2199426237533622", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823271_2199426240866955_7924959496276455667_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDKTD1eqnBkQ7kNvwFu9gCX&_nc_oc=AdqG3ukq1JVim_CPKr1vwiPOdUMTYt6o3oHFIT5JT8kbNqynrODky0P6HR2HkpPyhyI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaONce_3PWiwU_AYrNL7ou2uiKBV4dTv8whqpCaQve7w&oe=6A733EF5"}, {"file_name": "Leaderboards.png", "id": "1562070694897739", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818885_1562070701564405_8213879947028492554_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybduHTI3Ed0Q7kNvwEl4_fu&_nc_oc=AdqcYt2aNteckZKiLz3gbxu-k3AvjXDmCEUPtB8i--j_8MpRjUgQT8gGrwHa7OHcgLg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvYNACLSn2JUzy7gLtl2G7RPulxehI2b3beWpeZhxZPA&oe=6A7351A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e5253b6c-29e3-4ab2-8f16-5066fcb25645.png", "id": "1978866903040880", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303198_1978866906374213_9192720447839566203_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lc_lLy80oWYQ7kNvwEjkd6O&_nc_oc=AdqIUNJrjpS5fmpcdT6N_bAcrv6o78NNNxnVdDtvfqyOq2IPyfvPSJoYVT3AsaUBoTg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvRTE8W5oi_U_dZunUBZUda-Tnb2zrlsYocE2NJYBDBw&oe=6A732106"}, "display_name": "VR AIM", "keywords": ["Shooter", "Action", "Simulation"], "long_description": "VR AIM \u2013 The Aim Trainer Built for VR Shooters\n\nStop practicing on flat-screen trainers that don't transfer. VR AIM is designed from the ground up for VR mechanics, helping you build muscle memory that actually matters in-game.\n{892490393586061}\n\ud83d\udd25 **Drills That Matter** \u2013 Flicks, tracking, precision, speed. Multiple scenario types designed to target your weak spots and sharpen your strengths.\n\n{1972425153619209}\n\ud83c\udfaf **Your Settings, Your Way** \u2013 Match your training to your game. Adjust hand positioning, gun angles, and V-stock settings to feel exactly like VAIL, Pavlov, Breachers, or Onward.\n\n{1107486004816611}\n\n\ud83d\udc65 **Community Presets** \u2013 One-click setups from the community. Instantly load settings that match your favorite shooter \u2014 no guesswork needed.\n\n\n{25802754029335373}\n\n\ud83c\udfc6 **Compete & Climb** \u2013 Leaderboards for every scenario. See how you stack up and push yourself to beat the best.\n\n\n", "short_description": "The first aim trainer built specifically for VR.\n\nUnlike flat-screen trainers, VR AIM lets you customize everything to match your favorite shooter:\n\u2022 Hand positioning & gun angles\n\u2022 V-stock settings\n\u2022 Community presets for VAIL, Breachers, Pavlov, Forefront & more\n\nYour practice actually transfers to real games, because it feels identical.\n\nCompete on leaderboards across multiple scenarios. Track your improvement. Build the muscle memory that wins gunfights.\n\nYour aim. Your settings. Your edge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vraim.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VR AIM ApS", "support_website_url": null, "website_url": "https://vraim.com/meta", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "intern
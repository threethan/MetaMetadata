": "Application", "id": "26072175069061638", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28056084790670646"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "25871480922504930"}]}, "change_log": "# Update V0.3.6\n\n## Auto offset calibration\nWe have built a system that let's you hold up your hands like you would in your game of choice, and automatically builds the offsets for you! \nNo more tinkering with one million sliders!\n\nMore niceness:\n- Play next suggestions improved\n- Scrolling in settings menu fixed\n- Discord panel added to the main menu\n- Replay system first steps has been added. Not yet available to users\n- Config UI has gotten an overhaul with some nice search features and a redesign\n- You are now allowed to go past some of the sliders values in the settings by using the arrows. Settings like V-stock offsets and gun rotations.\n- Scores no longer round to \"1.2k\" in the score panel. It will show full score like \"1258\"", "created_date": 1785934781, "id": "27940572805555179", "version": "0.3.6", "version_code": 44, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26072175069061638", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28056084790670646"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1785751051, "id": "27914068914872235", "version": "0.3.5", "version_code": 43, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset"
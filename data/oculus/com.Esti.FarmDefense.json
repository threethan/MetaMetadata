/v/t64.5771-25/491823746_625146550565774_4454257222268007595_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10Q-wE_g13wQ7kNvwElQWm1&_nc_oc=AdqgAd0Vu1AJGDGdpUub77l9Z50CnYSh3pUHo1ZfzVOGmRAkcl2ElhObqroWIFbNXJs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKg5hyFlEW4_U6G5xmZhuP-lB_2rqsv-TVhTdfOP8bDw&oe=6AA2B6BF"}, {"file_name": "ss3.png", "id": "3223232767837612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821719_3223232774504278_6330835863458677397_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_9OQ880V9UQ7kNvwFlAV3U&_nc_oc=Adp5PXihbA3Mi1kMyWhdo87xfb57WZsp0_4tCPk9sg-1VoY5M_tg_hwe0DdsS-vFNi0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-Wm46Qb9wrX_SiCYf3v8AxQw0IU-pm9irTIt3jIuglw&oe=6AA2D27B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss3.png", "id": "1733505340610439", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308050_1733505347277105_5482383306113829041_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6o4zbXTTbsQ7kNvwGZeunU&_nc_oc=AdokB0RSxz09XjfMOSI-nmYkVx9whazZbM0WcUfREANWcYRV49l97zno6SliAgbeAfc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgQnJvF3304ln8ip-CJabo_g_ToZpZ9YVTg36JdGU_tA&oe=6AA29EED"}, "display_name": "Farm Defense", "keywords": ["VRfarmdefense", "towerdefenseVR", "zombiefarmshooter", "lowpolyaction", "farmsurvivalgame"], "long_description": "Your peaceful farm is under attack! Strange creatures crawl out at night and head straight for your fences. In Farm Defense VR, you are not just a farmer \u2014 you\u2019re the last line of defense between your land and the invasion.\n\n\ud83c\udf3e Features:\n\u2022 Immersive VR shooting and aiming mechanics\n\u2022 Defend your farm from waves of enemies that grow stronger every day\n\u2022 Build barricades, turrets, traps, and upgrade your weapons\n\u2022 Earn coins and gems to improve your gear and unlock new tools\n\u2022 Victory screen and reward system after each day\u2019s defense\n\u2022 Colorful low-poly farm environment with lighthearted visuals\n\nGrab your weapon, stand behind the fence, and protect your land at all costs.\nWhether you fight alone or rely on your turrets, remember:\nEvery night they return. Every night you must defend.", "short_description": "Farm Defense VR is a fun and action-packed game where you protect your farm from waves of strange creatures. Build defenses, upgrade your weapons, and experience farming and survival in immersive VR!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30804350659179185"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620985_1265395034966158_3225696238725318568_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IBOd3ABMzoQ7kNvwG0BnB2&_nc_oc=AdohrNl7WzQmbW1SfydB4UeVdxRIa62D3Ne6NDsr_zHyznebW-EyDFnIqYe-yXPpvMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcKLPw4p6uczWfX_5vz0BtVxCNL-rscJv-h8pOAajwew&oe=6
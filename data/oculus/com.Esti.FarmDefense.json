_trailer": null, "video_trailer_thumbnail": {"file_name": "ss3.png", "id": "1733505340610439", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308050_1733505347277105_5482383306113829041_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6o4zbXTTbsQ7kNvwGZeunU&_nc_oc=AdokB0RSxz09XjfMOSI-nmYkVx9whazZbM0WcUfREANWcYRV49l97zno6SliAgbeAfc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgQnJvF3304ln8ip-CJabo_g_ToZpZ9YVTg36JdGU_tA&oe=6AA29EED"}, "display_name": "Farm Defense", "keywords": ["VRfarmdefense", "towerdefenseVR", "zombiefarmshooter", "lowpolyaction", "farmsurvivalgame"], "long_description": "Your peaceful farm is under attack! Strange creatures crawl out at night and head straight for your fences. In Farm Defense VR, you are not just a farmer \u2014 you\u2019re the last line of defense between your land and the invasion.\n\n\ud83c\udf3e Features:\n\u2022 Immersive VR shooting and aiming mechanics\n\u2022 Defend your farm from waves of enemies that grow stronger every day\n\u2022 Build barricades, turrets, traps, and upgrade your weapons\n\u2022 Earn coins and gems to improve your gear and unlock new tools\n\u2022 Victory screen and reward system after each day\u2019s defense\n\u2022 Colorful low-poly farm environment with lighthearted visuals\n\nGrab your weapon, stand behind the fence, and protect your land at all costs.\nWhether you fight alone or rely on your turrets, remember:\nEvery night they return. Every night you must defend.", "short_description": "Farm Defense VR is a fun and action-packed game where you protect your farm from waves of strange creatures. Build defenses, upgrade your weapons, and experience farming and survival in immersive VR!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/"
ent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQN0ndMym6qFKdldEi1UTDBK7Y4tz591yz59A4babwizA&oe=6B0B19A7"}]}, "id": "1931711051143253", "locale": "en_US", "screenshots": [{"file_name": "screen-05-dolphin-leap.png", "id": "1080630308323910", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/593723055_1080630311657243_2800628099559490635_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9JLzxonJ88Q7kNvwENNAlf&_nc_oc=AdrMhDFTNV55UgtbjVMN8uHJvEIcmUn4-RAmK8pptKLAjr0LOD-2qazdnkuYNuTKu4M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ2ancKAq5gUw5kSvnq4LWuZkiHBOdDCguivNgKu2Lj7g&oe=6B0B1D27"}, {"file_name": "screen-01-milky-way.png", "id": "1075860625498062", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/593761155_1075860628831395_6965634716679710128_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S911ZoJWN94Q7kNvwH4rLhz&_nc_oc=AdrYIjuy28qPaDkYiNHo9dwZyvzNeCKWb6eSYstZcfjBTZ1z5W4YVRXXlN1Qxp9bm3Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTta2hwOF9H_nM3aC2I62klBOXkX04X1fyJ3_2TVvOuhA&oe=6B0B39A8"}, {"file_name": "screen-02-desert-dune-lights.png", "id": "4525651107655672", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499623131_4525651110989005_3085074578397416204_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2lxeUDoXysQ7kNvwEcFXtX&_nc_oc=AdrAGJ9ICBx3VI2_MigcPVWkr7X-MBj70RTJGDs9TXFs03fyB-nZSt_b2qO11DfHoF0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR-CE1vZStf49oHI94lh50O_8y042HNMGtZdvv_I9psRQ&oe=6B0B1D36"}, {"file_name": "screen-04-beach-after-dark.png", "id": "1765242017915980", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/593790560_1765242021249313_7109260996459830079_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hht2n84LSWUQ7kNvwEKlx7n&_nc_oc=AdqaZPSO563CKc19WBzExEtRyTjDHgbnn9IXx66BUaLoYOBIcUUXnh3atMDAylYPlQQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSExzL0tnAQDokQDkhiTRpqsx5Wf3mbYc7scJKQ3lA5Og&oe=6B0B27E5"}, {"file_name": "screen-03-jungle-waterfall.png", "id": "1393243916215435", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622202_1393243919548768_3799286680015593488_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDo83aCrWB8Q7kNvwGh_zb5&_nc_oc=AdoCshRDGrnM1orLHxB1z0J9zx-aqvCdFFi8Y7UC_X0PHobSTyGgCUKdkVSyL3NAXwU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQJpjrhskPfEAvzzi1S1YOGnaO752_t9rRkbhrNDGqt_A&oe=6B0B3CC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Velvet-Sky-Trailer-Thumbnail.png", "id": "1762874701481433", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499623512_1762874704814766_7336580079483196055_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ur1t8Au4T9gQ7kNvwGXp-hD&_nc_oc=AdpNtDlNxHP1lWv7P4MJUPCgQSLxnduUQxbFmCYyGEYxfPlhiq-uq0v4fyRSPEn6bc0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQBOCmaWLJ3OccPK28qD-fAoqiMIJfujL3h6YMTM-hFGg&oe=6B0B38B8"}, "display_name": "Velvet Sky", "keywords": [], "long_description": "Leave the rush behind and settle into a comfortable bed under the night sky.\n\nChoose your place: a beach beside the sea, rose-colored desert dunes, or a jungle canopy overlooking a waterfall. Warm ambient music accompanies each scene, with quiet natural surf on the beach.\n\nThe sky is calculated for your observing location and time. Explore the Milky Way, show constellation lines and names, reveal illustrated zodiac figures, and watch the Moon and planets. Choose a local date and time, return to Now, pause the sky or move it forward and backward.\n\nPick a city or enter a named place with coordinates and a time zone. An optional phone or laptop QR generator saves typing: scan the code in the headset and review it before saving.\n\nSwitch between sitting and lying views, adjust the sound or enjoy silence, and explore at your own pace. The core stargazing experience works offline. Optional QR scanning uses the headset camera only while scanning; manual location entry remains available.\n\nMade for Meta Quest 3 and Quest 3S.", "short_description": "Settle into a soft bed beneath the stars. Relax on a quiet beach, among desert dunes or high in a jungle canopy, with gentle music and a sky that follows the place and time you choose. Explore constellations, the Moon and planets at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abiemann.github.io/BiemannWorldworks/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Biemann Worldworks", "support_website_url": "https://abiemann.github.io/BiemannWorldworks/privacy/#contact", "website_url": "https://abiemann.github.io/BiemannWorldworks/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1351105368093727"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499628446_1844958796513950_2347953309188622744_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQ7I_EdUrfUQ7kNvwGML-Ol&_nc_oc=AdroJKbous0tvQYNtlkusAETxP59x9qCT0YaeAf_ergz0LaXfKyjCGSIkLV0Ca491dk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS1KKM6Up3KSBJ9JJeZWOrGR7fXvI8ta3tJ4hfzTM18kQ&oe=6B0B22F6"}, "is_concept": fals
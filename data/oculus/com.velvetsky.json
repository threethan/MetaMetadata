://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623131_4525651110989005_3085074578397416204_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t163f97xfWgQ7kNvwE6zQZE&_nc_oc=Adr0CYMAagPyq8oD0DDuolq25Q5IKXTbpdDp_QRP3HyeNI7TwDAITa2BFoziZ0JTCN4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS4CSEfvv5f2K17x375u31qMaASpU2fWOJkWlOx7QeFIQ&oe=6B0DC036"}, {"file_name": "screen-04-beach-after-dark.png", "id": "1765242017915980", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593790560_1765242021249313_7109260996459830079_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BuCks27cfbQQ7kNvwE28RFA&_nc_oc=AdoATpcgoJTVZHI9QfejzqeMNU0x_f55PwbK8F_65M_VhFVAUbH5mpx6i6HL2fTWLP4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSK_VS3o1VZpa9KH-IprUl4BSKMzbv-33gdMtEdZfeKPQ&oe=6B0DCAE5"}, {"file_name": "screen-03-jungle-waterfall.png", "id": "1393243916215435", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622202_1393243919548768_3799286680015593488_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9COhqGtyEkQ7kNvwFK-ypC&_nc_oc=Adqo5SQ5uUQk5hIGncFuhZXE4kSr6TzNHSEHQMf6lNUB8rANNnJst2B7cZ0dU4p76SM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRzgE2jx9fCjKEzh97BEMIJhmvZHVGFDLdyECPblQ_ZZg&oe=6B0DA787"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Velvet-Sky-Trailer-Thumbnail.png", "id": "1762874701481433", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623512_1762874704814766_7336580079483196055_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iP2S9iPEfFIQ7kNvwF3jhRk&_nc_oc=AdqnvNQImC5Mgea7HyBkY97g8a7FE1hSKatekO6BFkB7wfCxbVSqAdCBtMId-X2b1rE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR0wRiGJRQVTXedhOPbZl7KE8CqrPdaHjrTQ-8Fys0-tA&oe=6B0DA378"}, "display_name": "Velvet Sky", "keywords": [], "long_description": "Leave the rush behind and settle into a comfortable bed under the night sky.\n\nChoose your place: a beach beside the sea, rose-colored desert dunes, or a jungle canopy overlooking a waterfall. Warm ambient music accompanies each scene, with quiet natural surf on the beach.\n\nThe sky is calculated for your observing location and time. Explore the Milky Way, show constellation lines and names, reveal illustrated zodiac figures, and watch the Moon and planets. Choose a local date and time, return to Now, pause the sky or move it forward and backward.\n\nPick a city or enter a named place with coordinates and a time zone. An optional phone or laptop QR generator saves typing: scan the code in the headset and review it before saving.\n\nSwitch between sitting and lying views, adjust the sound or enjoy silence, and explore at your own pace. The core stargazing experience works offline. Optional QR scanning uses the headset camera only while scanning; manual location entry remains available.\n\nMade for Meta Quest 3 and Quest 3S.", "short_description": "Settle into a soft bed beneath the stars. Relax on a quiet beach, among desert dunes or high in a jungle canopy, with gentle music and a sky that follows the place and time you choose. Explore constellations, the Moon and planets at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abiemann.github.io/BiemannWorldworks/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Biemann Worldworks", "support_website_url": "https://abiemann.github.io/BiemannWorldworks/privacy/#contact", "website_url": "https://abiemann.github.io/BiemannWorldworks/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
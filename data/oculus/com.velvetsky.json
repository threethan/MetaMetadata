dn.com&_nc_ss=7f30f&oh=00_AQTmtFToBBeMwpv1SqE-qDfaaC8uPeYyWSGzIo0a9EXUdw&oe=6B0C7965"}, {"file_name": "screen-03-jungle-waterfall.png", "id": "1393243916215435", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622202_1393243919548768_3799286680015593488_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDo83aCrWB8Q7kNvwFN1Tsg&_nc_oc=AdqEtZIFj_hieFOYzV5gkafYchAr1bSWBz5rHJ7qJRtI1b3sAb-JqhEUTDtstPZAyfs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSVbcFzmKvpm7eqmm_s0VW5RHKYBf8g928cTraH_OM19Q&oe=6B0C5607"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Velvet-Sky-Trailer-Thumbnail.png", "id": "1762874701481433", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623512_1762874704814766_7336580079483196055_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iP2S9iPEfFIQ7kNvwEJi3KS&_nc_oc=AdoL4LbQkqe23FZlzdKDlDR3gdwaiQ_MiOU1HXd3T-sUie3ZxCwRnRqFfk_1OnDUPc0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQTe3-2JBWl_lEZNxLQpobNCwsVeItTdijTpzLZVycv9Q&oe=6B0C51F8"}, "display_name": "Velvet Sky", "keywords": [], "long_description": "Leave the rush behind and settle into a comfortable bed under the night sky.\n\nChoose your place: a beach beside the sea, rose-colored desert dunes, or a jungle canopy overlooking a waterfall. Warm ambient music accompanies each scene, with quiet natural surf on the beach.\n\nThe sky is calculated for your observing location and time. Explore the Milky Way, show constellation lines and names, reveal illustrated zodiac figures, and watch the Moon and planets. Choose a local date and time, return to Now, pause the sky or move it forward and backward.\n\nPick a city or enter a named place with coordinates and a time zone. An optional phone or laptop QR generator saves typing: scan the code in the headset and review it before saving.\n\nSwitch between sitting and lying views, adjust the sound or enjoy silence, and explore at your own pace. The core stargazing experience works offline. Optional QR scanning uses the headset camera only while scanning; manual location entry remains available.\n\nMade for Meta Quest 3 and Quest 3S.", "short_description": "Settle into a soft bed beneath the stars. Relax on a quiet beach, among desert dunes or high in a jungle canopy, with gentle music and a sky that follows the place and time you choose. Explore constellations, the Moon and planets at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abiemann.github.io/BiemannWorldworks/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Biemann Worldworks", "support_website_url": "https://abiemann.github.io/BiemannWorldworks/privacy/#contact", "website_url": "https://abiemann.github.io/BiemannWorldworks/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1351105368093727"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628446_1844958796513950_2347953309188622744_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqaAQAj0HQAQ7kNvwEbAX6K&_nc_oc=AdoxBcRZaFnaJ_a4RlJTJFXaZZcqBUveEaPfvXwNREPsVLKKL4ZLTVk6rtKDNMngSkw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQV2HoPfQzQTT-IN_o7pezvp3KOh4k3euOfoBf9s_HyvQ&oe=6B0C7476"}, "is_concept": fals
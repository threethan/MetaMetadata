://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499623131_4525651110989005_3085074578397416204_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnb0qQ4uf5wQ7kNvwEiu4On&_nc_oc=Ado0mis88PQCP7NOJCWhTcmNfqyFPW0rOJeUdjLSTucwR5mAt_PqKIuFxR6qmNd8Wh0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-BsBc7W3SbrTEoG_4wAW5sO73fTwxw8PUT8wRSf3I7w&oe=6B0841F6"}, {"file_name": "screen-04-beach-after-dark.png", "id": "1765242017915980", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/593790560_1765242021249313_7109260996459830079_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DchJ5NIFCIQ7kNvwEMab2r&_nc_oc=Adrct6PJIz51FhDbypF0q2cUFBbrPNlk8Imrl1coW4gzEtYAzN3hPkG9TbvAqhndvNM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFeqRcGsbdKsIJpc1RJIOgkRXttzEkFOWnct0h7ZgklQ&oe=6B084CA5"}, {"file_name": "screen-03-jungle-waterfall.png", "id": "1393243916215435", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622202_1393243919548768_3799286680015593488_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06zCINahBZAQ7kNvwEnd44u&_nc_oc=AdpUyglLrHJ7shU5XPMEEkwarphs3YrZ5fVS2OjKgRTUNpBtgQL9bWr5AsJo564ZNXI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQUr9ZZvHInVtVH16HZSlR61GmutQoca-jDviieQCcUQ&oe=6B086187"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Velvet-Sky-Trailer-Thumbnail.png", "id": "1762874701481433", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623512_1762874704814766_7336580079483196055_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ur1t8Au4T9gQ7kNvwE3905p&_nc_oc=Adp_VWXKod7vS3l6Zr3SnS8lMNWUHCimycZbyqxef6aIMZMajefAhYo2HsJd0BSjJE8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp1QSUrcb_FbafKHjQYb3-UWhRzRczTIKt3Gr63AvpTA&oe=6B085D78"}, "display_name": "Velvet Sky", "keywords": [], "long_description": "Leave the rush behind and settle into a comfortable bed under the night sky.\n\nChoose your place: a beach beside the sea, rose-colored desert dunes, or a jungle canopy overlooking a waterfall. Warm ambient music accompanies each scene, with quiet natural surf on the beach.\n\nThe sky is calculated for your observing location and time. Explore the Milky Way, show constellation lines and names, reveal illustrated zodiac figures, and watch the Moon and planets. Choose a local date and time, return to Now, pause the sky or move it forward and backward.\n\nPick a city or enter a named place with coordinates and a time zone. An optional phone or laptop QR generator saves typing: scan the code in the headset and review it before saving.\n\nSwitch between sitting and lying views, adjust the sound or enjoy silence, and explore at your own pace. The core stargazing experience works offline. Optional QR scanning uses the headset camera only while scanning; manual location entry remains available.\n\nMade for Meta Quest 3 and Quest 3S.", "short_description": "Settle into a soft bed beneath the stars. Relax on a quiet beach, among desert dunes or high in a jungle canopy, with gentle music and a sky that follows the place and time you choose. Explore constellations, the Moon and planets at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abiemann.github.io/BiemannWorldworks/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Biemann Worldworks", "support_website_url": "https://abiemann.github.io/BiemannWorldworks/privacy/#contact", "website_url": "https://abiemann.github.io/BiemannWorldworks/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
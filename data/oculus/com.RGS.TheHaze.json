n.com&_nc_ss=8&oh=00_Aftj-gsk-MfIAZdL1-HIWa_OT_SUZoCLccxZBr6ulwbGAg&oe=69A82053"}, {"file_name": "SC5.png", "id": "1362124404725249", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75286676_1362124408058582_459205631533772515_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNSfhK33l2sQ7kNvwGtsfSO&_nc_oc=AdmZpvO2T797HXZh_70Mg5_BJSAnDQzYnHg6ATEBvHBWXhoFkUBjvDA4RwKsSi2GlEA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvosIZFak20haaWfgJuNXSNkQR76p-JrxfV80DumTtB7g&oe=69A82E1D"}, {"file_name": "SC4.png", "id": "1313565479539973", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75367590_1313565482873306_3471352702550233642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIh7bk1yVPEQ7kNvwHdiahe&_nc_oc=AdlZLaN1OvO5VUHLg0GLyJHKKcRkm8uXiFpyQNlhfLnST1gJiTGbGbMAYeQ7ynluOYU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuhFJBVo9HoaO_MXJ7n4gEYqubxIzZVm-KviSru1g8w7w&oe=69A809F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheHaze_CoverArt Landscape.png", "id": "823468095973470", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984445_823468099306803_6241213035491763625_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEMvPb0QBkkQ7kNvwF22TYk&_nc_oc=Adnpj9wGTjDDoxxULvSZfhAKxPsZ_XL4_o_hdL5q0t-_PPdj5gd_QOwCYCbMAkjgtik&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvqb8ULwdUUMLUuzHiTAxJKSmJ53p06nTOa2gbV74LI3w&oe=69A832F7"}, "display_name": "The Haze", "keywords": [], "long_description": "The Haze is a stunning multiplayer survival shooter inspired by DayZ. Traverse an eerie largescale map with a mysterious forest looking for supplies and weapons to stay alive while you encounter the never ending hunger and thirst that if not managed correctly can be your downfall. Watch out for other players trying to survive or team up and enrich your odds. However, beware of various defensive mechanisms throughout the map that can cause you to bleed.. and maybe creatures. ", "short_descript
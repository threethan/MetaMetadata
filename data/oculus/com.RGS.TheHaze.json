n.com&_nc_ss=8&oh=00_AfzqjoWqHStfUVzEs-WnJ8p1pXE_UnZDoB2rZx_zE5biEA&oe=69B943D3"}, {"file_name": "SC5.png", "id": "1362124404725249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286676_1362124408058582_459205631533772515_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oNrhCeeBcoQ7kNvwH7svrX&_nc_oc=Adk6ltpCxlqDtCsfwzbggXcUPKr1CXlBe6LidR2JH-B_kPRAI1KIqFy--jHSrVg8cc0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzEWVR2HUIhiLlwCml-MWJkvo_TaIAdAGrpiihsB_onEA&oe=69B9519D"}, {"file_name": "SC4.png", "id": "1313565479539973", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75367590_1313565482873306_3471352702550233642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iiULBiE6Qp4Q7kNvwG8xL7K&_nc_oc=Adm1psz5iwQXN3gnqpPVm-rmfYNaN_aijy6ay5KfqYmMO7k_GpxLlDeSPgBNlpFqgSo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyt769FIXkxXVQkKCIpfg7NFZRHcxk8iZG_lA8xfjbFew&oe=69B965B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheHaze_CoverArt Landscape.png", "id": "823468095973470", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984445_823468099306803_6241213035491763625_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnouFbaHsJYQ7kNvwHp7hz2&_nc_oc=AdleKJaXASpd3dGNj3dKl-IFHq2D6phjxFHegBFEgLeYw2A0knAMpkrDjFFRZDhlpVc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyl2QiLRWlyecKmKG3V8e-t-8MegKy0ivsI6cfGHxDDaw&oe=69B95677"}, "display_name": "The Haze", "keywords": [], "long_description": "The Haze is a stunning multiplayer survival shooter inspired by DayZ. Traverse an eerie largescale map with a mysterious forest looking for supplies and weapons to stay alive while you encounter the never ending hunger and thirst that if not managed correctly can be your downfall. Watch out for other players trying to survive or team up and enrich your odds. However, beware of various defensive mechanisms throughout the map that can cause you to bleed.. and maybe creatures. ", "short_descript
n.com&_nc_ss=8&oh=00_AfybZfw5pCjRNrR5A0wQsZUnuAm00me_zl3V9v0NMhENvw&oe=69AD6653"}, {"file_name": "SC5.png", "id": "1362124404725249", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75286676_1362124408058582_459205631533772515_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjU26IFbEbQQ7kNvwGUIjsL&_nc_oc=AdlNydXQ1An6DCqYlG-rlrYZrL7ofccnhhkPe1hPfknPPZN8SmnDTZ1xO4jTz36GywQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDC9TcnuiOBg9Ii6OV1GPAL1jXLMF4gqtdFnW7Zf_UzA&oe=69AD741D"}, {"file_name": "SC4.png", "id": "1313565479539973", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75367590_1313565482873306_3471352702550233642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbL0EWmxBxQQ7kNvwEGeiF6&_nc_oc=AdnEsGBNdsmVbXyzE14hIerou9-DuY3mB4h_TVwKQc-IC6sNgZg-LIrgMjCh8L_Rx-A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGySfYthPcbDxjI9KJYNSs4wuDCaZg2C3Pm9GgpDq5OA&oe=69AD8832"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheHaze_CoverArt Landscape.png", "id": "823468095973470", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984445_823468099306803_6241213035491763625_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRx6TYp6UxgQ7kNvwFg3Vse&_nc_oc=AdkNZkPXkZ4D18POhg4XhstwjBBDCibxYw2i5pRVZnndN3oSJuYx9CXq_aoFIAaQBhM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwF61iThNt-BBWlswrTN_pNyiUEMmCp2ozXBAXt8FGzyA&oe=69AD78F7"}, "display_name": "The Haze", "keywords": [], "long_description": "The Haze is a stunning multiplayer survival shooter inspired by DayZ. Traverse an eerie largescale map with a mysterious forest looking for supplies and weapons to stay alive while you encounter the never ending hunger and thirst that if not managed correctly can be your downfall. Watch out for other players trying to survive or team up and enrich your odds. However, beware of various defensive mechanisms throughout the map that can cause you to bleed.. and maybe creatures. ", "short_descript
n.com&_nc_ss=8&oh=00_AfzrcXobyjBKmEQ1jgGrk8yKydINn2KGSx5Ud6iwoXtcKA&oe=69BBE6D3"}, {"file_name": "SC5.png", "id": "1362124404725249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286676_1362124408058582_459205631533772515_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXmhV9-qcVoQ7kNvwFMpxok&_nc_oc=Admiru_F3NKsXR81O0l776X7brfMK84Of7q7cJSEmEgBVqn35aLc-JSWLJptUQEduj4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7fxbzineCC4UYOYNk4o6qUwjKTrmljG2epVf2JlTaLQ&oe=69BBF49D"}, {"file_name": "SC4.png", "id": "1313565479539973", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75367590_1313565482873306_3471352702550233642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iiULBiE6Qp4Q7kNvwFsbiqt&_nc_oc=AdmEQBrtTbarLZPSSJVXK7I4TwmTysbbt46xs0hvvbWpY_W9U6w4zTubyZgZbwmzpR0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwshRP0zPSBkoKGmwOm20HoubjyxA5RC4lsC8OfNIZmXA&oe=69BC08B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheHaze_CoverArt Landscape.png", "id": "823468095973470", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984445_823468099306803_6241213035491763625_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xHvJqtH3RYQ7kNvwHmzIr5&_nc_oc=AdlT5vSZ5I149O47JKmwG4CGXG4IhgKFHuJdW_4AGqsEr694hpSUOhbg5vTsa8ab_VQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw4VWHT422UjdTTHwWnPA7txlXy4wRGHo9wgoXrV7TTcg&oe=69BBF977"}, "display_name": "The Haze", "keywords": [], "long_description": "The Haze is a stunning multiplayer survival shooter inspired by DayZ. Traverse an eerie largescale map with a mysterious forest looking for supplies and weapons to stay alive while you encounter the never ending hunger and thirst that if not managed correctly can be your downfall. Watch out for other players trying to survive or team up and enrich your odds. However, beware of various defensive mechanisms throughout the map that can cause you to bleed.. and maybe creatures. ", "short_descript
n.com&_nc_ss=8&oh=00_AfwhaLeYUJLnpXwNSlI2UkwcBvo5PjFfDS1_a3-icBCCBg&oe=69BD3853"}, {"file_name": "SC5.png", "id": "1362124404725249", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75286676_1362124408058582_459205631533772515_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXmhV9-qcVoQ7kNvwHPceqb&_nc_oc=AdmSAOKNUYxvA1q6x2qDG-unSad5V-0h3c_oftBnCT9Q64VNGmlk16yX_b5nfYBH4MA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzppg44ayg4cDUsL8ak0_Hoy9GemIxACNa6mWQt0rc3hQ&oe=69BD461D"}, {"file_name": "SC4.png", "id": "1313565479539973", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75367590_1313565482873306_3471352702550233642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=869TIRIGRTkQ7kNvwH9t43c&_nc_oc=AdkgeO8Bt7G3cnRaXv-xdfeWO6alIpmkNPpP8eUPqbnRyT5qh7iwYd7JM5cmHITIoz8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwplo2e-sVRFEyWwbpZKAdmKx_a18oFGK0lQzmkL9QzoQ&oe=69BD5A32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheHaze_CoverArt Landscape.png", "id": "823468095973470", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984445_823468099306803_6241213035491763625_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xHvJqtH3RYQ7kNvwHqwZzU&_nc_oc=AdkQ4-GW4ntFzm0P_DfQ5JL1gmB3R37U1HrwCbSfOFhTz4aG85MSkO9PKbzF65pypy4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxnet68zg5wwaqBbwsQK1vOGMODIR_eHt0GzNbe_94l3A&oe=69BD4AF7"}, "display_name": "The Haze", "keywords": [], "long_description": "The Haze is a stunning multiplayer survival shooter inspired by DayZ. Traverse an eerie largescale map with a mysterious forest looking for supplies and weapons to stay alive while you encounter the never ending hunger and thirst that if not managed correctly can be your downfall. Watch out for other players trying to survive or team up and enrich your odds. However, beware of various defensive mechanisms throughout the map that can cause you to bleed.. and maybe creatures. ", "short_descript
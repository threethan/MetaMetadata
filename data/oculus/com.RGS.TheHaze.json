n.com&_nc_ss=8&oh=00_AfzZzV9L8i7jLVocMbjrX7CfWUmpLiySBHZlFvSK_W_7Cg&oe=69B3FDD3"}, {"file_name": "SC5.png", "id": "1362124404725249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286676_1362124408058582_459205631533772515_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IoGgxvX94oAQ7kNvwGoL3zt&_nc_oc=AdkPU0M-4aSXm7aIPzweg-8VlhqX0aphY9V_Cq8wTdJ3ZGNA9taCTJhIux_BqOV062Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwvXZM7KozG0-jzt22pHfjWhLr28KNYFR8zphfIt-mtdA&oe=69B40B9D"}, {"file_name": "SC4.png", "id": "1313565479539973", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75367590_1313565482873306_3471352702550233642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otGOuET-jtAQ7kNvwHDNEQr&_nc_oc=AdmWbY1VzMRH8P0QCwYFDDfLVB4yod_saVZFdsxfsGmU6XK0kgm30dWDP5RldCZ_0MU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfylwoePl31GFi6Gt-Eux4wQd9eCAAOWkTK5OrZ4sbHvUw&oe=69B41FB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheHaze_CoverArt Landscape.png", "id": "823468095973470", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984445_823468099306803_6241213035491763625_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4vDt3d1paAQ7kNvwEhDpbt&_nc_oc=AdnxzQCdJPvyaK1mb42vGqdR5cEwNQpNGimgRYn8gGu-txDT8gYKZcQ1yGJAoxjYdNU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwqrxS1DyIU4Mau088EoKfRyvf58y2boUpJnoJWMFLu_g&oe=69B41077"}, "display_name": "The Haze", "keywords": [], "long_description": "The Haze is a stunning multiplayer survival shooter inspired by DayZ. Traverse an eerie largescale map with a mysterious forest looking for supplies and weapons to stay alive while you encounter the never ending hunger and thirst that if not managed correctly can be your downfall. Watch out for other players trying to survive or team up and enrich your odds. However, beware of various defensive mechanisms throughout the map that can cause you to bleed.. and maybe creatures. ", "short_descript
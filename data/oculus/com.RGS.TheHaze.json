n.com&_nc_ss=8&oh=00_AfzQlB41MlgniGVGonJoK9QYsLP1avuScPIZqy2VBjUYfg&oe=69B15AD3"}, {"file_name": "SC5.png", "id": "1362124404725249", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75286676_1362124408058582_459205631533772515_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEXYI92ZuGIQ7kNvwHzg_5W&_nc_oc=Adl1Hz2Lhc-TMDRK9ynq1BCNCOwgmP_uQYwi9ZqqjgWbMWvhsNBol320r7kyM2tAEE0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBZsK0ybn7S3g1t4mliDArp1-GC3FtW7MGfUxWuCqruQ&oe=69B1689D"}, {"file_name": "SC4.png", "id": "1313565479539973", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75367590_1313565482873306_3471352702550233642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otGOuET-jtAQ7kNvwE5G1R3&_nc_oc=AdlLYlvNt71dVTdMy1_XRcF3nHjRjS6qkz5ZaoWcuwNJhBIcyGvXFgfPpQRMIo-b_Ps&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfycKYAkX4etdUVoZbUXt-W4ppheVmTIiOX_NbXxdnhl1g&oe=69B17CB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheHaze_CoverArt Landscape.png", "id": "823468095973470", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984445_823468099306803_6241213035491763625_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUhQ1KsRRsoQ7kNvwHA2vMZ&_nc_oc=AdmIIcQgDDBFk2vWAlTkHTAN1L3736iC1POm8R5hhe78vrHOP39mVcf7gNrbeSUgn4M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwa49PpCW9PfAqxdr9YCvOiDluVBNEkdV5ke4FLum59_A&oe=69B16D77"}, "display_name": "The Haze", "keywords": [], "long_description": "The Haze is a stunning multiplayer survival shooter inspired by DayZ. Traverse an eerie largescale map with a mysterious forest looking for supplies and weapons to stay alive while you encounter the never ending hunger and thirst that if not managed correctly can be your downfall. Watch out for other players trying to survive or team up and enrich your odds. However, beware of various defensive mechanisms throughout the map that can cause you to bleed.. and maybe creatures. ", "short_descript
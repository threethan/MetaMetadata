n.com&_nc_ss=8&oh=00_AfzQEv4ZdNu4s3DvN8OJa1bW_6YzSvBIEFc--17QjdSDWQ&oe=69B2AC53"}, {"file_name": "SC5.png", "id": "1362124404725249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286676_1362124408058582_459205631533772515_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IoGgxvX94oAQ7kNvwFPTltW&_nc_oc=AdnhfWIW7ObdOcdlXNwCPqzKLglsXrUWNYMkqCKYf8UEk6VQr_pw16DKbg33GsWSh-8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxqcQ1yAL5GDGZBnnDzxgBJB-n6HyZzM_SNXTXxPYVdWw&oe=69B2BA1D"}, {"file_name": "SC4.png", "id": "1313565479539973", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75367590_1313565482873306_3471352702550233642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otGOuET-jtAQ7kNvwE-jnAB&_nc_oc=Adm6i4AYFgcQMt1Vhtp5ncAziSRGDYX4agAYUN9LD2VmH2_XxPFJB_EUTUb84rF6gRs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzHwc2_hLiUvjcRw23ISHiz2-GjoofmxbvRlaab5c8oBQ&oe=69B2CE32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheHaze_CoverArt Landscape.png", "id": "823468095973470", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984445_823468099306803_6241213035491763625_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUhQ1KsRRsoQ7kNvwHIn-1d&_nc_oc=Adn51cS-xg687AxX4Xa1Qy3UJgWMq87XhNwqv1o28fS4jl7gLvAZUHKPK-YR5Fmqa6E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyE2Z4UVyuzKaUheI01fImYoD7p2l4KyV-QDx5ZCFdcYw&oe=69B2BEF7"}, "display_name": "The Haze", "keywords": [], "long_description": "The Haze is a stunning multiplayer survival shooter inspired by DayZ. Traverse an eerie largescale map with a mysterious forest looking for supplies and weapons to stay alive while you encounter the never ending hunger and thirst that if not managed correctly can be your downfall. Watch out for other players trying to survive or team up and enrich your odds. However, beware of various defensive mechanisms throughout the map that can cause you to bleed.. and maybe creatures. ", "short_descript
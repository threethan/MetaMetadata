n.com&_nc_ss=8&oh=00_Afs5zuZK_nbTF4I6UsWa1N8v_4j0knQfb0R4XNpUCPBXGA&oe=69A971D3"}, {"file_name": "SC5.png", "id": "1362124404725249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75286676_1362124408058582_459205631533772515_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNSfhK33l2sQ7kNvwEpuz-6&_nc_oc=Adl28HKgk87uGpQVrZhdC7LAJl7PS8aMN0o5xmzqaSzJnHuqwiGwsAl_u-xNj8JOfsY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuFOTuBPG7zZWE8494fi2K0fVsENIWhGPr51OJ3-qGfJw&oe=69A97F9D"}, {"file_name": "SC4.png", "id": "1313565479539973", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75367590_1313565482873306_3471352702550233642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QO0qmtz_LF0Q7kNvwGURGjt&_nc_oc=AdmpcvsdVXl34kCOOx9m-KQyDlEEc7JA5myydym-irYamINBi4Fr423Iwhiq7kT4Uh4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvPdNZJawOvagDOfo_Ao7gC6QIV6GrDbOMxYYPcdFIZuQ&oe=69A993B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheHaze_CoverArt Landscape.png", "id": "823468095973470", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984445_823468099306803_6241213035491763625_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEMvPb0QBkkQ7kNvwGfSnAg&_nc_oc=AdlFd7JjKsT3WcYQKLgUfWHHCgWvxdtRynXKRUkAdmc5iERiMlO8SE7-Nn1WEDlHxHg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu9W9XCBNzruFpc0gmLoq3pdJEMsm9BwdS47G1cGXiSKw&oe=69A98477"}, "display_name": "The Haze", "keywords": [], "long_description": "The Haze is a stunning multiplayer survival shooter inspired by DayZ. Traverse an eerie largescale map with a mysterious forest looking for supplies and weapons to stay alive while you encounter the never ending hunger and thirst that if not managed correctly can be your downfall. Watch out for other players trying to survive or team up and enrich your odds. However, beware of various defensive mechanisms throughout the map that can cause you to bleed.. and maybe creatures. ", "short_descript
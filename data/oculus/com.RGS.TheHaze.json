n.com&_nc_ss=8&oh=00_AfxZEVuWLVFT9d2WzKvaZ_rQ9IHxNDFSuqW8j_qlTvn8yw&oe=69BFDB53"}, {"file_name": "SC5.png", "id": "1362124404725249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75286676_1362124408058582_459205631533772515_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDHhhZV4yocQ7kNvwGa8AJY&_nc_oc=AdnSXbvL9m-00HzBAHl0kjg_cjBcSW8XYSsUS5b469hVUORHrnEbmcWgUeM9uM95ezI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsluXzz-FdxHLGQpcQURSRlB3HcHqTDrsVuEkbbGvUfA&oe=69BFE91D"}, {"file_name": "SC4.png", "id": "1313565479539973", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75367590_1313565482873306_3471352702550233642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=869TIRIGRTkQ7kNvwHQ7wSR&_nc_oc=AdlHEiH8v5sEVQtbNwCT3mjZoFUc2qDwluH7pyaR0guVdV9L7buY7srS-yU-8lfZRHw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwRp6RL1SPq3qwnJupD6dM7rhQeHLKrB9KFQc6_bSfiVQ&oe=69BFFD32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheHaze_CoverArt Landscape.png", "id": "823468095973470", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984445_823468099306803_6241213035491763625_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mf7lUCZ_pQkQ7kNvwGfOgKB&_nc_oc=Adn3gPmre8vE7OoEoGDSPooy3IBUHBbLphvXs-_eJ06niGHTISA4kI0Hh4upaAy5ITc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxkC-DHcL7lNW_RcP0SfLKkioIsW8VJcJt3OLZPElJHlg&oe=69BFEDF7"}, "display_name": "The Haze", "keywords": [], "long_description": "The Haze is a stunning multiplayer survival shooter inspired by DayZ. Traverse an eerie largescale map with a mysterious forest looking for supplies and weapons to stay alive while you encounter the never ending hunger and thirst that if not managed correctly can be your downfall. Watch out for other players trying to survive or team up and enrich your odds. However, beware of various defensive mechanisms throughout the map that can cause you to bleed.. and maybe creatures. ", "short_descript
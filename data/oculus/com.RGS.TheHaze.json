n.com&_nc_ss=8&oh=00_AfwIc9MQXt4MLTyK-YeBBAdD13bhPowyGVMG5pwcy3yN2A&oe=69B00953"}, {"file_name": "SC5.png", "id": "1362124404725249", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75286676_1362124408058582_459205631533772515_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEXYI92ZuGIQ7kNvwGtiiXL&_nc_oc=Adk_DaW8Fl3RteY80B_OCspIwefz-qL8mAIhtrTdmflRipM6nQsR40pnuCYGvatNnU4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzEDBpITkMlF03FYsi74sCcZ7eapTZz5tmu8cMU6Ux5FQ&oe=69B0171D"}, {"file_name": "SC4.png", "id": "1313565479539973", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75367590_1313565482873306_3471352702550233642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbL0EWmxBxQQ7kNvwFqD0kJ&_nc_oc=AdnyIb90PSXs1PKaAWU6dxLwz9pFIDSZTfPjDO0fyBL81OaBekIt00u2lVJFqHZd_Hc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNLCOseVA4iGMJ7-Cz09MhdXC7OPeSdhXZ-_KbQvrQlQ&oe=69B02B32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheHaze_CoverArt Landscape.png", "id": "823468095973470", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984445_823468099306803_6241213035491763625_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUhQ1KsRRsoQ7kNvwEnb41H&_nc_oc=Adke7OpJ5q1VqGtEPgCDm0nRos5lBqif50S1jLsm5oP2nHcrryZphZURo1Ur_zx9HuM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1Eo71mTNC51BoqLuSoBmNzb10bKqmTQGk30bGM7o86Q&oe=69B01BF7"}, "display_name": "The Haze", "keywords": [], "long_description": "The Haze is a stunning multiplayer survival shooter inspired by DayZ. Traverse an eerie largescale map with a mysterious forest looking for supplies and weapons to stay alive while you encounter the never ending hunger and thirst that if not managed correctly can be your downfall. Watch out for other players trying to survive or team up and enrich your odds. However, beware of various defensive mechanisms throughout the map that can cause you to bleed.. and maybe creatures. ", "short_descript
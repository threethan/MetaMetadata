n.com&_nc_ss=8&oh=00_AfykX9lFiv7tFECp7GNwLWTR5YJg3zAdxnWJGTmDRyiVOw&oe=69BE89D3"}, {"file_name": "SC5.png", "id": "1362124404725249", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75286676_1362124408058582_459205631533772515_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDHhhZV4yocQ7kNvwG4j4Ur&_nc_oc=Adnnum3wuJj7_Jq_Fj604_UXoCu07ZPlHPsx0fcy09_VKBzMPz86F_aM7KKTxQBsVlQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVl08EPpvhpy2WN3QO76Ho5uTJkz1nmZUHvSR_314iJg&oe=69BE979D"}, {"file_name": "SC4.png", "id": "1313565479539973", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75367590_1313565482873306_3471352702550233642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=869TIRIGRTkQ7kNvwETxQmK&_nc_oc=AdnU6s0TYDQk2rPcHrrXuShPFnH97oN6QZfngGDARbhEk3PrJAWkk-Zpzp1Q7M4Ge1U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWaPir0ydClPz52_ZALDJunHONHRTg64amCqHvI3FbHw&oe=69BEABB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheHaze_CoverArt Landscape.png", "id": "823468095973470", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984445_823468099306803_6241213035491763625_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xHvJqtH3RYQ7kNvwFnR5oy&_nc_oc=AdmY1M-ER9_XAkrsNUaA5NS7tq8VGE7iSPqa6ggIR2QkZIJw5aDQWEbh03yVcc8akCY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyovyAkuq-SbnDP7V8unKqF2HBitdMLjGiUlVe_9rGb5A&oe=69BE9C77"}, "display_name": "The Haze", "keywords": [], "long_description": "The Haze is a stunning multiplayer survival shooter inspired by DayZ. Traverse an eerie largescale map with a mysterious forest looking for supplies and weapons to stay alive while you encounter the never ending hunger and thirst that if not managed correctly can be your downfall. Watch out for other players trying to survive or team up and enrich your odds. However, beware of various defensive mechanisms throughout the map that can cause you to bleed.. and maybe creatures. ", "short_descript
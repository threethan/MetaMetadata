n.com&_nc_ss=8&oh=00_AfyY4ozlTu4Ggr4qfwVfqx_gmToIs_0OI0kxN64Yt9u-YQ&oe=69AC14D3"}, {"file_name": "SC5.png", "id": "1362124404725249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286676_1362124408058582_459205631533772515_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjU26IFbEbQQ7kNvwGrViVm&_nc_oc=AdmLr6vTlx2kJ9JvfoC73CVg9IA8hGECv2YmdTYsHvBPFGnpWEBLUIyBLHz2CW_PooA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCWj3JPKjF553HlFseVmnBWha0b977NNpot1GVtVzHIg&oe=69AC229D"}, {"file_name": "SC4.png", "id": "1313565479539973", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75367590_1313565482873306_3471352702550233642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QO0qmtz_LF0Q7kNvwGEsfV0&_nc_oc=Adkl9UsVDHCQZ3tm9pR4-qnkJnEG_Aed3uo2OcYUwJC91j_Rz1MZFviOzat2FArveYo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwVL7Y6NgKhdCaag_HY4-8PL-FpknLGckPf72xGeNmnQg&oe=69AC36B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheHaze_CoverArt Landscape.png", "id": "823468095973470", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984445_823468099306803_6241213035491763625_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRx6TYp6UxgQ7kNvwGOXnMU&_nc_oc=Adk9-LzJ9Wobpy0YySi4vKvWzZp7Rao1efeGVBqwfUHs8W13_HYVhnBgUfQv5LZIT-M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyEyeO4UcO6QAH_bVVB_tJnEnMhzj4nazLWZ7UaABhXrw&oe=69AC2777"}, "display_name": "The Haze", "keywords": [], "long_description": "The Haze is a stunning multiplayer survival shooter inspired by DayZ. Traverse an eerie largescale map with a mysterious forest looking for supplies and weapons to stay alive while you encounter the never ending hunger and thirst that if not managed correctly can be your downfall. Watch out for other players trying to survive or team up and enrich your odds. However, beware of various defensive mechanisms throughout the map that can cause you to bleed.. and maybe creatures. ", "short_descript
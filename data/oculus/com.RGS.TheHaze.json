n.com&_nc_ss=8&oh=00_AfzDofcHxvVtKtUWo1oUdPr0ktwBP2mxJuAGxEgljrGVrg&oe=69AEB7D3"}, {"file_name": "SC5.png", "id": "1362124404725249", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75286676_1362124408058582_459205631533772515_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEXYI92ZuGIQ7kNvwHsRTv7&_nc_oc=AdkubJZzR1GHy_K4t2PRu9cAHUQnYWZdNqdWtEKRQsxgyfY4qU7LzAqeesebLG_mr6k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqUOH9HVbuS_fS8kN9iwzTFaCGWHjyfuYF0GlUJeQ_8w&oe=69AEC59D"}, {"file_name": "SC4.png", "id": "1313565479539973", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75367590_1313565482873306_3471352702550233642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbL0EWmxBxQQ7kNvwFqJbqE&_nc_oc=AdnpVBOBPAjqQCfqr0ad4dW5tQVLddzzH1156UGSeeGseqnyLFICy5dSlRA0d_OWb3c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6qUyIQKuJmkBvuuzUmfDTCUBqow-I_XH4BYzz0tkq5g&oe=69AED9B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheHaze_CoverArt Landscape.png", "id": "823468095973470", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984445_823468099306803_6241213035491763625_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRx6TYp6UxgQ7kNvwEa-zmM&_nc_oc=AdlsZRHu36Ee43Dz_x-HDmPCVdTRTAYSVpZliQ2hsgzQbfC4dlZMIL6Lu6r_u98__14&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzosWoYjFLYGMJkurmU-GrgkONSKlZos7NFLva6IlyUSg&oe=69AECA77"}, "display_name": "The Haze", "keywords": [], "long_description": "The Haze is a stunning multiplayer survival shooter inspired by DayZ. Traverse an eerie largescale map with a mysterious forest looking for supplies and weapons to stay alive while you encounter the never ending hunger and thirst that if not managed correctly can be your downfall. Watch out for other players trying to survive or team up and enrich your odds. However, beware of various defensive mechanisms throughout the map that can cause you to bleed.. and maybe creatures. ", "short_descript
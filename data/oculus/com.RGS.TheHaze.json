n.com&_nc_ss=8&oh=00_AfzbCLD1TSHbGbBUvuavBYkJssN0yKHZi7eV9L4qzVKqbQ&oe=69B6A0D3"}, {"file_name": "SC5.png", "id": "1362124404725249", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75286676_1362124408058582_459205631533772515_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oNrhCeeBcoQ7kNvwGadRgM&_nc_oc=Adk58_oHXB4_0CoQX6yA6Qr6EAcz6xZytnQriaJmrgZC93tljolLzUXWA9PCGwcUlLI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWoBmShRJwUySOEMp2wRm4v4zVR8ae3Sqd9QS67Ob0Rg&oe=69B6AE9D"}, {"file_name": "SC4.png", "id": "1313565479539973", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75367590_1313565482873306_3471352702550233642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1e8M7BouN1gQ7kNvwFIz8XT&_nc_oc=AdmksL391-_WkIo3x7MZtV3_rSIzDa3vwjNqmdvCmt70b137WKWm_O9WZY05r5ACmd0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEuDyr6XoWTVO_FF0wUmBK6vAZgW8s2cnsgyFbaYAVrw&oe=69B6C2B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheHaze_CoverArt Landscape.png", "id": "823468095973470", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984445_823468099306803_6241213035491763625_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4vDt3d1paAQ7kNvwFDqF6t&_nc_oc=AdklCt8NH8-xbFBsF2-K1kIv5YOuOnTkJ4u9EWDScQw-dweIU8Z8wKJxAVigi6qLsDM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy06iHWm0r8D9hUv9D4WXSVuSU_SD9HoEz_wOfBEAFQsQ&oe=69B6B377"}, "display_name": "The Haze", "keywords": [], "long_description": "The Haze is a stunning multiplayer survival shooter inspired by DayZ. Traverse an eerie largescale map with a mysterious forest looking for supplies and weapons to stay alive while you encounter the never ending hunger and thirst that if not managed correctly can be your downfall. Watch out for other players trying to survive or team up and enrich your odds. However, beware of various defensive mechanisms throughout the map that can cause you to bleed.. and maybe creatures. ", "short_descript
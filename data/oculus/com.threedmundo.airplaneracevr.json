04&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7VyyQPPgbsQ7kNvwHgVnVc&_nc_oc=AdrOSQLbRMk849_P-1xUjTI_qPlJgtjZJR80aitXxRy6bTojr3GHEgoU-Sx-CkRJJFg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJIeDSWmRB4D_rC_Pht-Pr0zUY2PkExWR8OKTjV2iYhg&oe=6AFC8C33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1097734786169864", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499298281_1097734789503197_413452464760746394_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CtLUVM4NNkQ7kNvwFmeFs_&_nc_oc=Adp0g5coV35GvCmQMpK4V98F7vq1bah0X9YeIG7kPLlbXnboAADXAoSv61TerR3ZCzM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCrwKoNGhPfz5S-28rsXMEV9ILu56E1YS9QNmWn2yN_g&oe=6AFC6BF1"}, "display_name": "Airplane Race Creator VR", "keywords": ["flight", "dogfight", "cockpit", "aircraft", "plane"], "long_description": "STRAP INTO THE COCKPIT\n\nAirplane Race Creator VR is not a flat racing game seen through a headset. You are sitting inside\nthe aircraft: the stick between your knees, the throttle at your left hand, the instrument panel\nlit in front of you and the canyon wall one wingspan away. Eight aircraft on the grid, three laps,\none line through the rocks.\n\nRACE\n- Six circuits: desert canyons, refineries, industrial flats and open dunes.\n- Arcade, Time Trial and Championship, with three difficulty levels.\n- Up to eight aircraft on the grid, alternative routes for the brave and a local leaderboard.\n- Eight aircraft to unlock, each with its own speed, toughness and boost.\n\nFLY\n- Two control modes. VIRTUAL HOTAS: reach out, grab the stick with your right hand and the throttle\n  with your left, exactly where they sit in the cockpit; push the throttle through the gate for\n  boost. Or fly with the thumbsticks if you prefer a pad in your hands.\n- Proportional turns: a small input is a small turn, a full input is a full-rate turn.\n- Look anywhere. Follow a rival over your shoulder, check the wing in a hard bank, glance down at\n  the flight stick moving with your hand.\n\nFIGHT\n- Machine gun, missiles, mines, shield and repairs, picked up on the track.\n- Lock warnings when a missile is on you, and hits that punch the cockpit from the side they\n  came from.\n\nFEEL IT\n- Layered controller haptics: engine speed in your hands, aerodynamic buffeting that grows the\n  faster you go, the kick of the boost.", "short_description": "A first-person VR air racer for Meta Quest. Sit in a real cockpit, grab the stick and the throttle, and fight seven rivals through canyons and refineries while the airframe shakes, the engine roars and your instruments answer in your hands.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/artifact/RZKHbHQZa3prhjoijucn9x", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/artifact/RZKHbHQZa3prhjoijucn9x", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1141636224969146"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2202866911113135"}]}, "baseline_offer": {"id": "2202866911113135"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790427960, "
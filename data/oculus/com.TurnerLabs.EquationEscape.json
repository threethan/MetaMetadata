966CE"}, {"file_name": "Screenshot2.png", "id": "1388554495478958", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391991_1388554498812291_8941598888344563750_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhvz3b26v2kQ7kNvwE3EXft&_nc_oc=AdoCbhzUITxh36kO7cgEQUzXAEhdjJn0mZKjQXo8t80LgVwygfqKr_nVOn3SrE74ASI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMKNQ_VeFIj4pYw9aIWEPWRDPYErPCzZ1Lv2vdxcWyvA&oe=6AA950A0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Equation Escape", "keywords": [], "long_description": "This VR game lets players solve math puzzles by combining numbers. Players grab floating numbers using their hands and combine them using operations like addition (+), subtraction (\u2212), multiplication (\u00d7), or division (\u00f7).\n\nTo switch between operations, players touch a special floating ball. The goal is simple: use the available numbers to reach the target number shown in the game.\n\nIt\u2019s an interactive and fun way to practice math skills in virtual reality!", "short_description": "Solve math puzzles by combining numbers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/jesseturner21/EquationEscapePrivacyPolicy/blob/main/EquationEscapePolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Turner Labs", "support_website_url": null, "website_url": "https://github.com/jesseturner21", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inpu
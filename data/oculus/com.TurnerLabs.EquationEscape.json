Otnn4kBdgN4ZUznMSMmCnOvz7ilvg&oe=6AFB45E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Equation Escape", "keywords": [], "long_description": "This VR game lets players solve math puzzles by combining numbers. Players grab floating numbers using their hands and combine them using operations like addition (+), subtraction (\u2212), multiplication (\u00d7), or division (\u00f7).\n\nTo switch between operations, players touch a special floating ball. The goal is simple: use the available numbers to reach the target number shown in the game.\n\nIt\u2019s an interactive and fun way to practice math skills in virtual reality!", "short_description": "Solve math puzzles by combining numbers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/jesseturner21/EquationEscapePrivacyPolicy/blob/main/EquationEscapePolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Turner Labs", "support_website_url": null, "website_url": "https://github.com/jesseturner21", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9648429621888240"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393469_665468719192856_104028715748189116_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&c
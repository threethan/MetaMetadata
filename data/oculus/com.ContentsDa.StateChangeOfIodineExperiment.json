s": ["experiment", "chemistry", "iodine", "science", "contentsda"], "long_description": "1. place iodine in a small beaker\n2. place the large beaker of water on the hotplate \n3. add the small beaker of iodine to the large beaker of water\n4. remove the flask with cold water from the refrigerator\n5. secure the flask with cold water to the stand\n6. turn on the hotplate when the heavy carbon device setting is scattered\n7. observe what happens as the iodine dissolves", "short_description": "Witness the fascinating phase transition of iodine from solid to gas without passing through a liquid state. This experiment demonstrates the concept of sublimation, challenging the conventional understanding of phase changes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8651100404976114"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_262072376786122_7170023901567158064_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hC_ggORl284Q7kNvwHLZwbI&_nc_oc
", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036682_475188521983111_8830351798657133653_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62sF6c-JqS8Q7kNvwHXCiTs&_nc_oc=Adr6NTATNa_3JLit5D0zSVjSxYbFd1UnfAw4Vgjb1lqZewD4UuSSKkGhPH1-57GGod8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Lpg9CUhsPhbjOTNQanSYheJ8z6S7S504fzwyvQug0dw&oe=69EF5676"}, {"file_name": "Screenshots 4.png", "id": "2232923450408422", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035466_2232923453741755_1393433610229906024_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yj8eFyWLB4AQ7kNvwGKeFFN&_nc_oc=AdqkviLO7e8-67ju2AeleZzhDQHDOyxEdiUgkdUVvQy7vaXgE9XHsxTrzDBYp21PwbA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1OGwYy_Ij31fA8fi3o4I7r428Xspxk7BCGssFy9p6kUw&oe=69EF4ACA"}, {"file_name": "Screenshots 5.png", "id": "879494454041221", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974561_879494457374554_7206607153467141252_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOg9HYamNJUQ7kNvwGTzFuG&_nc_oc=Adqadxfw8JXWqd-E6NPDBa_UhhL_raegUTw68DaleglfjxiNzbYa-hj7gCL4Dh51osc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af22SgjC9qOiwgWNrFyD63sLmC3iIDBqf3_p5XWstQjT4A&oe=69EF7F5F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Instagram", "keywords": [], "long_description": "Little moments lead to big friendships. Share yours on Instagram.\n\u2014 From Meta\n\nConnect with friends, find other fans, and see what people around you are up to and into. Explore your interests and what's going on, from daily moments to life's highlights.\n\nWith Instagram on your Quest headset, you can dive into your interests in an immersive new way. \n- Keep up with friends on the posts they share to feed and in their Stories\n- Check out the profiles of your friends and favorite creators\n- Watch videos from your favorite Creators and discover new content that\u2019s personalized to your interests\n- Share something you see on your feed to start a conversation with your friends \n\nSome Instagram features may not be available in your country or region.  Some features may not yet be available on Quest.  \n\nTerms & Policies - https://help.instagram.com/581066165581870\n\nConsumer Health Privacy Policy: https://privacycenter.instagram.com/policies/health\n\nSafety Center: https://about.instagram.com/safety", "short_description": "Your friends, your moments"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacycenter.instagram.com/policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta Platforms, Inc", "support_website_url": null, "website_url": "https://instagram.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6894135614029559"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "558632436548106"}, {"status": "PUBLISHED", "id": "576867624693641"}, {"status": "PUBLISHED", "id": "2264754963856829"}]}, "baseline_offer": {"id": "576867624693641"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1728935520, "status": "PUBLISHED", "id": "558632436548106"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26120254210991078", "version":
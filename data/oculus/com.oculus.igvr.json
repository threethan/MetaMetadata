f&oh=00_AQIRQOysKVaOHDFr6S0JnjfFHfKqImQpj3YnhQIfDoE4mQ&oe=6AA96772"}, {"file_name": "Screenshots 3.png", "id": "475188518649778", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036682_475188521983111_8830351798657133653_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_mNgnKEz7kQ7kNvwHhPVXI&_nc_oc=Adr6ztRjlhQBlIyisXjs2sTOTj87cy7YAuBJq2VKi3gB4_x9HMMpVl-wfddKtghX-ic&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGm5NOYowF7Q7BU_MNho3HmPpdvpXbuQDuP3VlDSel6Q&oe=6AA939F6"}, {"file_name": "Screenshots 4.png", "id": "2232923450408422", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035466_2232923453741755_1393433610229906024_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6ugessiz-MQ7kNvwFRAZio&_nc_oc=AdosXk8WxOCshSNaIskOkxqOYzJDWNQbZX0qiKluOz0rcsjWIqZBJrgFVffWbl5_afM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0B1rxRTNx_Si8tOsa272Zf9xNIfYpzYZ8ECfqboq35A&oe=6AA9668A"}, {"file_name": "Screenshots 5.png", "id": "879494454041221", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974561_879494457374554_7206607153467141252_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPH3vVu05S4Q7kNvwFWoBHB&_nc_oc=AdpgmUp2S9U8ulFJT3G-ELEEGwkJMAr83nfKJ0jALa-rT9aMAv0pZiyiV63R-RZLTmU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9B6hYpY-BmyBDrEWjrusPKJrHvSTyobB-TCmmi49htw&oe=6AA962DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Instagram", "keywords": [], "long_description": "Little moments lead to big friendships. Share yours on Instagram.\n\u2014 From Meta\n\nConnect with friends, find other fans, and see what people around you are up to and into. Explore your interests and what's going on, from daily moments to life's highlights.\n\nWith Instagram on your Quest headset, you can dive into your interests in an immersive new way. \n- Keep up with friends on the posts they share to feed and in their Stories\n- Check out the profiles of your friends and favorite creators\n- Watch videos from your favorite Creators and discover new content that\u2019s personalized to your interests\n- Share something you see on your feed to start a conversation with your friends \n\nSome Instagram features may not be available in your country or region.  Some features may not yet be available on Quest.  \n\nTerms & Policies - https://help.instagram.com/581066165581870\n\nConsumer Health Privacy Policy: https://privacycenter.instagram.com/policies/health\n\nSafety Center: https://about.instagram.com/safety", "short_description": "Your friends, your moments"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacycenter.instagram.com/policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta Platforms, Inc", "support_website_url": null, "website_url": "https://instagram.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6894135614029559"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "558632436548106"}, {"status": "PUBLISHED", "id": "576867624693641"}, {"status": "PUBLISHED", "id": "2264754963856829"}]}, "baseline_offer": {"id": "576867624693641"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1728935520, "status": "PUBLISHED", "id": "558632436548106"}]}, "liveChannel": {"nodes": [{"late
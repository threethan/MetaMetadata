avorite creators\n- Watch videos from your favorite Creators and discover new content that\u2019s personalized to your interests\n- Share something you see on your feed to start a conversation with your friends \n\nSome Instagram features may not be available in your country or region.  Some features may not yet be available on Quest.  \n\nTerms & Policies - https://help.instagram.com/581066165581870\n\nConsumer Health Privacy Policy: https://privacycenter.instagram.com/policies/health\n\nSafety Center: https://about.instagram.com/safety", "short_description": "Your friends, your moments"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacycenter.instagram.com/policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta Platforms, Inc", "support_website_url": null, "website_url": "https://instagram.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6894135614029559"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "558632436548106"}, {"status": "PUBLISHED", "id": "576867624693641"}, {"status": "PUBLISHED", "id": "2264754963856829"}]}, "baseline_offer": {"id": "576867624693641"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1728935520, "status": "PUBLISHED", "id": "558632436548106"}]}, "liveChannel": {"nodes": [{"latest_
hriX22Q9uEyrpX9vg&oe=6B09B8E3"}, {"file_name": "4Tdwsp.png", "id": "199414998005836", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982553_199415001339169_876897034668343296_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CeXfeu3tr1gQ7kNvwHb5NzB&_nc_oc=Adq6_o1KCbaFdMDlKsa3jumylH4oLn3SmJzB5KlH95UiWyNXNirzFcyR3uYL5ijAVis&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDmEM9PN2wuLE85xp9iWeq6gJ4vLsuLih4N0v4Mr3YLg&oe=6B09AEB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/r72Ras", "id": "255254845480546", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75254876_255254848813879_8167350629442781184_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qKTjfQGGKAQ7kNvwE-7lCy&_nc_oc=AdpFVvgxiD8XJDVcZz3jNak76dyspxm6XYU5cFUOTdruWv4VIUSQtV8cx7YLuQfpG0g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRleYekYMMmWLYp79NS7oqKX56J987JfP_B5iUQjYwtsA&oe=6B09ADE1"}, "display_name": "Gudauri Ski Resort", "keywords": ["winter", "georgia", "travel", "tourism", "paragliding"], "long_description": "With this app you will be able to explore one of the most popular winter destinations Georgia, Gudauri. \nGudauri offers tourists 20 ski slopes with total length of 70 km provide perfect skiing and snowboarding conditions. Gudauri is famous for its off-piste opportunities down the unspoiled virgin slopes and heliskiing options.\nYou can also experience thrill of flying with paragliding activities shown in the app. \n\n\"Georgia Ski Resorts\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourism activities in VR.", "short_description": "Explore diverse and exciting Georgian ski resort Gudauri with this interactive VR experience!\nExperience skiing, paragliding, snowmobile rides and breathtaking views of the Caucasus mountains. \nLearn more about the resort and its services while having fun on the slopes of Gudauri."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "TRAVEL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24612887994986949"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031462_569365203682202_8375065547208916992_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMHyTj4yRKMQ7kNvwHk5uvW&_nc_oc=AdpjMaom3n6ISX-Lih0PnuAYRTjPj-qPSLskpAs3fdIuyrp6assIl1AFosD4CD9x644&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpKDIFkKmcIu8uwvcFaElnX_yE5OwlBVxMhNbqo5YfYg&oe=6B09CC54"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gudauri Ski Resort", "platform": "ANDROID", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1587080260, "lastRevision": {"nodes": [{"id": "3229590317051837", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application
jj4Fjdbzg4Oe03y2NiIQW0QSvc65Vo2R0TyZQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw7wjk_4985xn3ojJIvxCWo1qFmOiAVZJ9HUmcorV9l5w&oe=69C130F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/r72Ras", "id": "255254845480546", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75254876_255254848813879_8167350629442781184_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBTgWWRsujoQ7kNvwESKn7f&_nc_oc=Adr7-NtrfyButJKAn7J3xNo1W20osKr9P__kJG9oKeM-wwaflHWQnvuR-MYeugvQfz4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyZq5dGIRXk-D-E8Xnx2CiWj7-akKI_VXBXbpWq3pjGtQ&oe=69C13021"}, "display_name": "Gudauri Ski Resort", "keywords": ["winter", "georgia", "travel", "tourism", "paragliding"], "long_description": "With this app you will be able to explore one of the most popular winter destinations Georgia, Gudauri. \nGudauri offers tourists 20 ski slopes with total length of 70 km provide perfect skiing and snowboarding conditions. Gudauri is famous for its off-piste opportunities down the unspoiled virgin slopes and heliskiing options.\nYou can also experience thrill of flying with paragliding activities shown in the app. \n\n\"Georgia Ski Resorts\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourism activities in VR.", "short_description": "Explore diverse and exciting Georgian ski resort Gudauri with this interactive VR experience!\nExperience skiing, paragliding, snowmobile rides and breathtaking views of the Caucasus mountains. \nLearn more about the resort and its services while having fun on the slopes of Gudauri."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "
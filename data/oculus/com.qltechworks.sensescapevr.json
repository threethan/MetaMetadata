-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoSx7gtxOp53IdU-_DOdTYQNyfQJDzCgLwS0KSzvA-iQ&oe=6AD3AB4C"}, {"file_name": "2560x1440-screenshot (4).png", "id": "983208746104447", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75330716_983208749437780_6341369082403641170_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvTBHYPHeqwQ7kNvwGlt5E4&_nc_oc=Ado3uSUYMyQcbHTV-m4X69BqDuwxIN0K3By-wFhMxdpDwhkueOR-wemTNpm3XWp_Crk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQbcFB9GL7KRXSwk0vAagU7JTCEzSlcwl3f9bgGM58sA&oe=6AD390D3"}, {"file_name": "2560x1440-screenshot.png", "id": "237868372080455", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57572952_237868375413788_3659218718493560123_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlrdLi057BMQ7kNvwEeIh54&_nc_oc=AdoRf-LMEYdguPV3mGk_SNInTcqFY3M61gAzpij8PEwTm-BJYwbBCvL5Rwu40OGMs9s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBTanGA51sUPjtxocbABhZcM11W8rR_Jeor-gUimFzeQ&oe=6AD38E61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-screenshot (12).png", "id": "133642826483630", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75294243_133642829816963_1002866125319797395_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O33heRThOCgQ7kNvwHgu9-N&_nc_oc=AdpvcO-lbXcmIP_0J9tlgL_Zb84FK-MevboulTITVE6hPb-qQVPI6SEBvH1RyPvZh-M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8uWelAKvgdHkYMSJ8k60KCcn2UAjMwEXl6ftzfq7l5w&oe=6AD3A85A"}, "display_name": "Sensescape VR", "keywords": [], "long_description": "A virtual world for neuro-divergent people offering a safe space for those with specialized sensory needs. It features a room just like a real sensory room with bubble columns and interactive elements to generate stimulation. The app also includes two (2) areas for relaxation and meditation.\n\nThis app does not require the use of controllers. Users interact directly with their hands with simple interaction such as pinching, making a fist, thumb up and thumb down. \n\nSensescape VR can be play indifferently from a standing position or from a chair or a bed.", "short_description": "Sensescape VR is a safe space for neuro-divergent people with specialized sensory needs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qltechworks.com/sensescape-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QL TechWorks", "support_website_url": null, "website_url": "https://www.qltechworks.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1008396250346449"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "319729963774880"}]}, "baseline_offer": {"id": "319729963774880"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1693342227, "status": "PUBLISHED", "id": "319729963774880"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6544981072204935", "version": "0.1.0"}, "id": "1702818746859673", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6544381875598188", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6544981072204935"}, "release_status": "RELEASED"}, 
12).png", "id": "133642826483630", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75294243_133642829816963_1002866125319797395_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhG8dGwAEAMQ7kNvwE-UZ8Z&_nc_oc=AdrQ8ZrpdrY4X14t4m1qk-M186dAL1of_Evzi_CjOLOtAlKpFan6-LBOt_spB74w67Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuAqjHipYuKPMqN1CYpRQxiGvfWk3zG48N4iWe-9wnOQ&oe=6A9EB41A"}, "display_name": "Sensescape VR", "keywords": [], "long_description": "A virtual world for neuro-divergent people offering a safe space for those with specialized sensory needs. It features a room just like a real sensory room with bubble columns and interactive elements to generate stimulation. The app also includes two (2) areas for relaxation and meditation.\n\nThis app does not require the use of controllers. Users interact directly with their hands with simple interaction such as pinching, making a fist, thumb up and thumb down. \n\nSensescape VR can be play indifferently from a standing position or from a chair or a bed.", "short_description": "Sensescape VR is a safe space for neuro-divergent people with specialized sensory needs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qltechworks.com/sensescape-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QL TechWorks", "support_website_url": null, "website_url": "https://www.qltechworks.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": 
-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHBvk-oEJDf-wYIdIffb5jYzTxWW3-Xe9hfDjRRRfglA&oe=6A53918C"}, {"file_name": "2560x1440-screenshot (4).png", "id": "983208746104447", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75330716_983208749437780_6341369082403641170_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFs37ZvVqMEQ7kNvwHb21GT&_nc_oc=Adq_s5SBQKw1XnOkya_CyImIxK1y3AYJDbjCWGBxKGxec7i2pcSxa03P2313DoMKFCc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAzW4a_Px201Divl_FgzS4SutQ6qgEGaqTCAixTLE0fA&oe=6A53AF53"}, {"file_name": "2560x1440-screenshot.png", "id": "237868372080455", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572952_237868375413788_3659218718493560123_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlrZZputwP4Q7kNvwHEZj5m&_nc_oc=AdrYQgE7Pd6kE2AyYxHLB4XnHNWP4n8f9rWUlIQkT1v0BlcU3do-n1OZXEkCwCxyDL4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_ZnBlx89kwxyemM16uZHvym1oJ3jrN06lTMsITmB0KA&oe=6A53ACE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-screenshot (12).png", "id": "133642826483630", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75294243_133642829816963_1002866125319797395_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIjV53XPf3cQ7kNvwGthW_P&_nc_oc=AdqrHoYqL75gpv6sxU0Q11dBUpEoqa2J1NgizoWkCOMxfbTTUKuzHGtav_SW0H_GxJ4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARq5OreClx2TSA4FPBiz0r00IaWZN-MT7VVVcOCQaiiA&oe=6A538E9A"}, "display_name": "Sensescape VR", "keywords": [], "long_description": "A virtual world for neuro-divergent people offering a safe space for those with specialized sensory needs. It features a room just like a real sensory room with bubble columns and interactive elements to generate stimulation. The app also includes two (2) areas for relaxation and meditation.\n\nThis app does not require the use of controllers. Users interact directly with their hands with simple interaction such as pinching, making a fist, thumb up and thumb down. \n\nSensescape VR can be play indifferently from a standing position or from a chair or a bed.", "short_description": "Sensescape VR is a safe space for neuro-divergent people with specialized sensory needs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qltechworks.com/sensescape-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QL TechWorks", "support_website_url": null, "website_url": "https://www.qltechworks.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1008396250346449"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "319729963774880"}]}, "baseline_offer": {"id": "319729963774880"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1693342227, "status": "PUBLISHED", "id": "319729963774880"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6544981072204935", "version": "0.1.0"}, "id": "1702818746859673", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6544381875598188", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6544981072204935"}, "release_status": "RELEASED"}, 
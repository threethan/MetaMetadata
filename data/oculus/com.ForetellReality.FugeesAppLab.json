: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfj76U1p-g8Q7kNvwHLdHI9&_nc_oc=AdoJOD67sdArLz9SEBJZGB84ANbr2r2JBLLfSX_5JUJ_bs64xDHQuTtrratVF0BrRvo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcLe756JCq5WlxqNymoD7F6edHDE5qhkN8fofH67Iszw&oe=6A972568"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MEoxUdZhLQQ7kNvwHyMcJ9&_nc_oc=Adqtjt9JHw90McxzJRRI3S0WTWvD9xtB5sN7plo5zVl7hL2kO-XRFyrTNTra5jWw-Ds&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFToLibXAITKy-w-5m0BMDdLVSlvxbOEM5-P79x6ylCA&oe=6A97491B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-JWlHUx03kQ7kNvwFbqWa0&_nc_oc=Adr7RJslqEJp2BxqxFnlgoa-4sgDzdRF_S5LkMJOipTWmk20PN8alXRG3JftSKbk0xI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCN8iJtTl6Xg_01vMcxvyd4q4nLZQMRAzy5wWVUqauWw&oe=6A974084"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNtErVpv3XMQ7kNvwHz1l1Y&_nc_oc=AdpUHnLpN7PLfPcSbmfDFB8u5W2ps14aIUtHf5OgzAFSfhQNg18eu9vrSML4Ef65T5s&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVCL85AkGbFEO2sPmZylZ5dH0BMFt5pIv2axyO7ntcRw&oe=6A974227"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lV6uuufa6oQ7kNvwGoo19g&_nc_oc=AdqKOlaWMaWmHKLIdnZZstm-hXrUFYw_iGegSJmpYHti1x-UluOKVoMmbmgUJRW0YaY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoQ-QvfPtnehV3pbWedIaGjUobxGIfeGwf248gRmKncQ&oe=6A974C28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AW-wGqlgj4Q7kNvwG_gOoJ&_nc_oc=AdoeH1QhEQlN5ZipmFWHQGCnWfSj9Q1oljuAeNOYgjLHqQ5_mhv50cueh4qW1k2Jbiw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72LBri59fko2GHpGX9Q1BDSaoQGusUVU-WIJt84T7JlQ&oe=6A15BA28"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_FSCYe6QtkQ7kNvwH7SF-r&_nc_oc=Adrk8qgNYa4ipwoPWeGr03XjD7FbSUhXSQtlp5PzWRKz1sr052cgCn1UsBNZN-7tPnY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sacrdCAW8y_fiNDOYaHoEA9pYlMCiOt27bSHpyGCtDg&oe=6A15A59B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyIPLADlcYsQ7kNvwG3cI1u&_nc_oc=AdqZ3tWgDdjlh2hRChS7nKKw0kUy4pcpO8veOuwL_tOCphcFoUkBpTn4_AvvCkUB9_Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KpxEqsD0Xaql-vracGrlqsaQ3_dw_kZLAI3MougL8zA&oe=6A159D04"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GMihhX5-_AQ7kNvwGCzJhz&_nc_oc=Adrp13WDDztEq2J68oAuLNSGYAcYgTn7Ie8VqlrAnE8MBuYqBEhENZO-u-RPRiu4ZU4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DxWGINhPAdrQQujwDQaSBlDnTdUmq7BAXqKro7d2L1Q&oe=6A159EA7"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObrRqiEu-L4Q7kNvwFQ1ERd&_nc_oc=AdoHSWKt8LqixIdB2wfDwzx6c0UuK3bKlVRdz0noVw852nvijtfmOnGb22B9n-MGnWM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pu0JpmN4_011j8qvPkJ_cym_NZYhC0kl7JBkegvuYXg&oe=6A15A8A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
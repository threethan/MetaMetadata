: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OrZ7niUCgw8Q7kNvwEJ8aH9&_nc_oc=Ado35qgI_JrlW2mZ3Txn1IXz6vdM2zbhURn-CxuDG2LHRoFAmyiGwJlWje68QyEuX6k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Mrg9aFYKy1yrg0IZac5vIQroQA-t5TR6kw_I9knDqXA&oe=6A3AA428"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sGwGc638-gQ7kNvwHnKCWx&_nc_oc=AdoMGtymbsEeC4mWzQrGCZfPL3-H2Ot_-daAhhH_dIPVJH_oMqLJum-55i8P5I5LRBI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7kFxy_Qky_e7_10Hw7HZed7LOggFRbJjZhw496IDvQA&oe=6A3A8F9B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZqzgDd4oYYQ7kNvwGCWUAR&_nc_oc=AdoBXCo81Z3hWBWXpB4Zuq4f8lVwLIWTJplQUidPd6uv5-gIy-pJP2XkoU9U3xhSGF0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DLGwR4Kdf2tARg2PTsbZt73xe1Jp9aj_TA-FaHBne9g&oe=6A3A8704"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oX8jTpFYC_MQ7kNvwE8B8pU&_nc_oc=AdpHrh1OZzmkBfnOMPL90SPKTl0uwlysLaKRjJXzu-X4af0Wl6Yw9TcRGSlfhHqF014&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AWMcNvET4_BTdIGuP6_s-9aoi4xx98iC-csP9vv2AGQ&oe=6A3A88A7"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RaC4mayeU8cQ7kNvwEkDHrZ&_nc_oc=Adr0z-BKo1cLpENLpVr9m3Bltmo3H0UwigssnFcWX0WOqKQ1SghDT2tRK2Zwrom4erM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92NSLMnlU2WTRNzLE--MGpyPFSZwNKSYXnMfyDWQhP8Q&oe=6A3A92A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
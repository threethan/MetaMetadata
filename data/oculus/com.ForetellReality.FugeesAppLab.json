: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PWfHtksFhwQ7kNvwH0fLXL&_nc_oc=AdrYQGabQBj0n5mzKtgYB0JzwaTtnVOZ8nWmBln2sJJ-xsEWbgI5-Wlh9m_1qrht-ac&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAa8WeZCguA7pjJFWyPswejA3wr9b56rzIb9GIcGujXtw&oe=6A4E6AA8"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICTiU1eX8BgQ7kNvwGgF_jj&_nc_oc=AdoiBwlj3uFomZs1DE9nhAAKRqqz8XYuaDIrOJ6aZjMFKyALXGsCYLScQ9MI1Yp6t20&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBScIq71eCh3z9AG30rxAmdobAENnrlc-uX7JiRt6TRvw&oe=6A4E561B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pURaEvgHO7wQ7kNvwGcTmzR&_nc_oc=AdqawQtzx3ao57U1HqtcSeTC8JNHAkqpD7vcAAcKIBAUQ_oLBTqqj4n1BOr8xROukpk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC47luzDu9ftQpUyU-DNotmdzx3G55KUnEkkIwAC6QWnw&oe=6A4E4D84"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIxWu61GS_EQ7kNvwFbMzFJ&_nc_oc=Adr2GfBjwYjT-9AEXWDtc-tdtQ-xRrDWwKWQKxJDZ64QjtheyDLc9GjTbj8B2XZ2Kb4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNMx0DZWlY4LeLO3__sGwjyqthz29HBetKoWHfcD7l_Q&oe=6A4E4F27"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOaDce6ojaMQ7kNvwEgePkp&_nc_oc=AdrKHC6yFlFte7hIRaZUx-Uw3iPl3PGifeEy3m-auUR6KqU31h1apE_chYhttdnVYqg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXN2K4Cca7YwR5tzhBj0p5CydjgnNvADWXTAJjEX0r-g&oe=6A4E5928"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
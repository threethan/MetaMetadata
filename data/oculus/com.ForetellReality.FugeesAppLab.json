: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njykFPJmL24Q7kNvwF3X875&_nc_oc=AdoG4y4bas7czPGwPRqhJ7sNc6P4RpKIZ6bixAZOGaAXH3rrTx8e5E0IaaZcjp-1jPQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcD254TBsOhcF4Jl2CjbUiflmjHRbwebbY7dpotvtnzw&oe=6ABFCBA8"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2pRBMxsiC4Q7kNvwE7IK0U&_nc_oc=Adoi2ecg7yD-5ckmFkmrpEq7IOkU9b1WsAmKgdVfZxRDBCJmlKVYMAhclDW-junkQxI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQe6rjCSfq1pyyNBOGc0EGwthsavFi5bzqzWJ6IRsGyg&oe=6ABFB71B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EE2tFqKcvEYQ7kNvwFbuZt2&_nc_oc=Adp-z_ROs923Lp7cUhAgXQk7bJtmaqwJ_ERbhPNLIaka3Ba8RrV1tAI97YUZbm250v8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPY3hAuZ6q9WP4xaSCn8X3Sp9Igk3Kl3KiT_HpeMbkXWQ&oe=6ABFAE84"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hY7sn80ZOrkQ7kNvwHiW59X&_nc_oc=AdpY2_KAh_l2E_ymXp-PHXhtIF9lvvtLa9_QwywzEcPHkY4vDakib_Mkq9dlhECmUdo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNA9LQe4e0ULLj_rbBSHt2Kw6Nj2WbYBRc9ShxxlACuGg&oe=6ABFB027"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLEec9P1_-gQ7kNvwHjLrmr&_nc_oc=AdpxhsbXBg6hK1pHelOIjuVCJhxW9ov9d-aUGPX0ItabC1Xy_-ND4O3y-y0c1-ILve4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFzPlUY45uawFHYO_fqD3eUnRAAJboBcEPrJ4YuZ-FgA&oe=6ABFBA28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
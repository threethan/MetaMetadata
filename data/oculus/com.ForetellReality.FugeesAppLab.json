: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6b8Sr0VINUQ7kNvwHpSYHq&_nc_oc=AdrFVrzAyXdAQD8svKMmRl8dgymRHDumvG6mF_Zeyoo9_XVbzKEP52OexXpMAe2sgp4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW6oelP7wqW7RT6F95yetQNLvl08S7dbbCgrsxkjh47g&oe=6AEC9EA8"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lX9QYsKI4HwQ7kNvwEeI_GG&_nc_oc=Adrgy5CXJhGR1Z1s6-YRJCovc5ThuUBfAPewxex4dywz8TMxZV_dl6j2QuZBb6KJTGQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq4COqRlCiORiDRK6gKZygsN8cvXfV3WzYtzTVv7Mrxw&oe=6AEC8A1B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDRZG4944MIQ7kNvwH29kVj&_nc_oc=AdoUNopXn8f53OfVVSmVQ8bFPRo8n25-RkJGhacux6H7tC4gJrtBYMg1dj1m3lwDdJM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2UMcjFJg5AG49Jd9Bk72HnKi5cbU2ipxVNQo1PBmnRA&oe=6AECB9C4"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OQg46soDsQQ7kNvwECpCKF&_nc_oc=AdoabjH18GhfWrsH6aM5UE5WtUFrTViZxk3XU9OTJ8zn9h7LnFJsQtaBlhY1QaV1mhs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5e19nCM0DcKgHDv66Y9FvE_XYRu-B43PPTKPHbcgWwg&oe=6AEC8327"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUwN1YCN8E8Q7kNvwEh5WS_&_nc_oc=AdpBf3_WaGHSwqN-fjn4sl6H9JHYdH0ISx1Kchh-nvwqrslgSWaUIIMsgxPUtfq-DZw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTml3mPlbV24rcZ2xHJZFtbGrgrPXauNXdhbd8lWPmPuw&oe=6AEC8D28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcI3zPrwW6AQ7kNvwGloyf-&_nc_oc=AdpiUhiVd_xavIEEIHlRm-w_3bO5gEL6csM3LZAyRXHUdbvpAJKnoG0UPGQbe3Tc-xo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeYk7VzvrjtRUGmjp8Px8B5D0tl2n_9XS0McUiAg3IAQ&oe=6A58F6A8"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHyqsxnfO9MQ7kNvwGf1IQf&_nc_oc=Ado1y_6Cbw5qbN0o1H4KsjQIiRTXQ5ptPbFvr5b_Pxb6KMmdfmYimAVO93dWMGTWeNE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfv7RXZ7J12BIQngNoESLUm-tFcrkV_rvF-Z9MKc2LVw&oe=6A58E21B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLcSECdzx6cQ7kNvwFt2Zgv&_nc_oc=AdoQee5OxF22tc_yvxDfEtjkXkD19sM1efLZv0UW7obYfFkTf-wFd4lKb4PRYecMpMw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOW6NphasJFaBvrzmA25oeCw9P8yxxosbCewZP0yhJFw&oe=6A58D984"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjJ-_Ae9cLcQ7kNvwFGCn5J&_nc_oc=AdqZbYQtSUEOdMQEeBMFd7OwiaCt0XfoiBFWeL4JkXml29Okw4N85H_kO83A8x6JXpQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDybE6q8hxSTx3dmhLZ0UZnvlik8hBvD2dLQiMaGuyQhg&oe=6A58DB27"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MgfxsSQqqGAQ7kNvwHX8ITP&_nc_oc=Ado0B6zmjKYuVxWaw-vrZKEKWQHwA3HoQbB9esyrPvg4Yxa5-ZyTs5oE5jpB9EOqRBQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5D6pDKj60eYcQ1c9gAPfxDr_ffn4KwfqnbjBEhdHsWA&oe=6A58E528"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
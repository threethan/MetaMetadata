: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KHbYyEEaYsQ7kNvwEL9yxH&_nc_oc=AdrEGlBHvEqJ-w2Danph25gy4xC3nWhihjtct1ZVU-INOD8L9APHUqXvaLairAFRgzQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TDlMWyTfm5JRygL15W6e_qsVO3S_jo2UbMXjpOFKHwA&oe=69E75D68"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3FgbHsIBUkQ7kNvwGIzacG&_nc_oc=AdraXIhtVcn31vBH8NrMkNLTF3yn9SE2s2XxOcMUsufu3z-oNm2BXU1C-GzjrCGb4dI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-NFuPCYiRUcbbS5V4M7xr2iJ8fPtg1YI5YFLcL66BNQ&oe=69E7811B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGY-oRjWN0EQ7kNvwG0hiRX&_nc_oc=AdrKIEata026v9JegWjK2UnDpJ6VphA3gxs4T3YWzn7gwH9_kg4yNz-1U4WOtfd4b3o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1V6DdnuUHsEdfmR5Ayn8ZMp2iLcG0k4Eh996R8qloA5w&oe=69E77884"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dInCT_p2SjEQ7kNvwGYRY6y&_nc_oc=Adp6-rHIoQ0Biaq-TVpfnI_VKxwM3HSEfSeOyVSIVUmZWsc3t6Nky4Ss6y0ytJvS-kU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3T59iHYl6nTiu-Cz2Y0PBQJLk-lRUtzvYFZASrRA4ZZQ&oe=69E77A27"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKS1tOZhfTwQ7kNvwFv781i&_nc_oc=Adq5pe9MG10vVzXVj4Za2WTmTtGp8lgSo8yGlWbPHtYOpCVfT3N3OIBuwUUFxEV1ON4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FZbH5aH2Z9OhbLMjjaJnXclqFoR_iP-b2KmnXQ3Erpw&oe=69E78428"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y98Jknwk2TcQ7kNvwGZsc85&_nc_oc=AdqSz3ahIbxbrZ15vwniwIpZteqkmbmGl4JW8W99xQMwgGTrXuJ4l62J7YPMGBxc-gw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1tAgyE7ToJSHcXri97CDRYqcAMoMmb5v3EZxuv_6lu2A&oe=69EF7EA8"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8tCOml-ZGsQ7kNvwE8yKAg&_nc_oc=AdrGYJlY6z6mM5LdWrYiTzzkwosmQnqDBPUMuVEpoX6sI2ns4zvntbNLa0szqZvDtzw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Slqa_ADk3gydhI_xQ0-gmNjtzCDqKGBBMWohKAdaiJQ&oe=69EF6A1B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4obwGck0GzcQ7kNvwEVMALR&_nc_oc=AdqU6pkAlATacquG-mTAW9fFQNHcielUeo5QhYknFIYrUDATtp2LdgXqlQ2DiyycTgY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Es3VHhrlJ6cTQtu3jOqJy8MUD9WvhzrVtIJXlJXk3Sg&oe=69EF6184"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-JZaW0eVQsQ7kNvwFKG1lx&_nc_oc=Adox8OiEsFfkJ1MuNh4VJBLJqrwaJhRjvm3TvXWFn6EEYcXxq7z4s2ZN5Mchw4DNr9Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0o01qgyPBpbJds4nN6lp7djTgc87CdxzLAKKhUyVK_Bw&oe=69EF6327"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=931eO0lrLy4Q7kNvwEUp7Kb&_nc_oc=AdrMgbCOhWwjocTcnpjeab0eLWm_y-UX490qG7X6lt3axh0lgWhnOHVMh4uPlsT0zPU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2qicmM2VIHY1wAlOGNmFJCMLuL1CErQ3pSh91RvxuQew&oe=69EF6D28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
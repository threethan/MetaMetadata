: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LC_D2GFMUwQ7kNvwHmhdev&_nc_oc=AdoQo9V-hvSHfuVVFQCrsgu--EOOrUS3ZYgQDPojV4-j89KNXp4R4z6v76ZWjtFxXf4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9roZCvZG5-Nbm-Lntuwm08igscWBZbloiyebkK8aUltw&oe=6A26DDA8"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbnur2Qu3bUQ7kNvwE-6YYC&_nc_oc=AdrInDsRKespGuwKGDo7IAa3QFMpJ3l0bemzR8g-339ZOo-iRLZ36i_tRaiGYx4hQ2w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8W9Ujg3KOKTDsNHTPC5iJbjK1jN0SsHSFSJ1vWm_8Zpg&oe=6A26C91B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lxqjcyMP1kQ7kNvwF1stZ7&_nc_oc=AdrSK8zJoPcBWvYA2Ga9pLIr_iv3EkMnxd1ltjEXQteV7vTQO8i0O-fFvoPx1IA9RCA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_t3yvvKzzIv6DXCH5waQo9oDkOxiWjyS8CIDB8MgicA&oe=6A26C084"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzCq2ixr92EQ7kNvwGTLfw0&_nc_oc=AdqBAoEYHxsJn67DxNA-oRKu89BJ95kDV3z_cg99UmdQVBo6OIaCWv8YWjRppH0pKQ0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_D_H0B8LbRXynqNXRm7xG9bGzU4Ru_Fazx19qPUSEBWA&oe=6A26C227"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHmWd_DKyIMQ7kNvwGZMtuz&_nc_oc=AdpJHeMzxR_ZsyCvkj-YLwiMy5rOH7vGvDIAskBHqMMEoNJOElzegH1OQkCEa6YjKkg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Oq_n7fA4mf9lX6h2OZQ8JVeC4GZyrDvedSCZ7HeVBaw&oe=6A26CC28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
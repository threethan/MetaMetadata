: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hA7NN5-wGcQ7kNvwEhpQ9_&_nc_oc=Adp8MHFLvBsB7whiJYk_sHz7oMF-91kXhcEyoCIikeEiMQqBduf2AUD93yDXsTIatbg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxz_QgYB2VLDvH0MTxFi0xS1yB6jux4u5D4Z5pje-27eA&oe=69CFA268"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEbGetc83h4Q7kNvwHNMqqF&_nc_oc=Adpacf8o-CxUI3c_rQBpHPePVbNDPQlTGUvbOgmK_m5ycq5s1nSMz_dNRrUGqgBixMM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwOmvYqBhC7WBiBJd0DBXNAZeu40hNvB0cRJHIxYBMrdQ&oe=69CFC61B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LH8netJdFekQ7kNvwHHEaUL&_nc_oc=AdrNRh4M_x8nUODxih4vxWRvVMIVfKG7E6mm_XvdXj3BsuhQ-n0qspg23mgshChYowQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxXIls-Wi1s41kyHOLZDAZm8L9dD4ZqjJzO5ysZ1FyUbA&oe=69CFBD84"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTmpMcYEomcQ7kNvwHBgTWt&_nc_oc=AdrLDfRgIkVdMjcYJEB_ld6APYFEBeTv-LcS0Xu2f0GY2a9sX0vsaP1OHAGlEnOHh-c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyENfHGf1zDfbwmdDlhKz1EbTSS83HGmjLWAQSFIM1mEg&oe=69CFBF27"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMmb0loOKTgQ7kNvwFhkeL5&_nc_oc=AdpfR1WLeY8qIkyuKhPsD68nwTN35Nh7hfBULjALDxNbZHJ_SeRuRVmJKRA3ZhRkp_I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHtA4RL4DEAUOl0q2OsEsgabJjyBWYt5pQ_tCtgwjeOQ&oe=69CFC928"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
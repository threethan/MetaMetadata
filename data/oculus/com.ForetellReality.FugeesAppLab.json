: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vyDtOvMmpgQ7kNvwH1leXn&_nc_oc=AdqpzAu1rS5Yxd8yT1iYXVggKeoFdeR_VWqpCQqpRJuhTDgsqdwPMxf-JwNA9kW0WIc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_b_3j4zOStcN02Pt9UjLQcpVKmMiZUrWknU1j7GqWBVw&oe=6A428D28"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DKL__zjfnB4Q7kNvwGfBpP-&_nc_oc=Adq5jzVB-Vk4WfyUlZoDqGY9SS21MkY1lEpo9NNK6eqMAH53XeRkbrJvpS9Nmy_sCMc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99EikRd3ZEs_bblcr2jTuZ3CDT4RhYlzYfEawcAPtJfQ&oe=6A42789B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1jo6UgLTEYQ7kNvwFc_RrW&_nc_oc=Ado1-ifh42fTKIC19Q8ar5UDJGOeJo3udCTU05C0dW8pVe2XKU0ew5FWG4_xJHvW9Uo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Pc-OzlVJz9u27kwwCSFpVN5IlYM9y7nw7A7TxrP-JOg&oe=6A427004"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWd1hRScTmkQ7kNvwETUg-i&_nc_oc=AdoLlek9GRuq9nEg1CNsdzvrVBSw8RLMPWJ8rwSaDwKM7uq7CbUhOkDy-yf0nIO_MCI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rYwvRLoAx1UjhrK1aoyE7ZLBfMfPAseOdNQMIlmOSZg&oe=6A4271A7"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzvJZuj12roQ7kNvwEzkfy_&_nc_oc=Ado3U21lc8UslastjPRgBWbg1yigXPVqBKBYj9EdKkS9A7e4MFTwqUaTw6qEHOE3zSU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__YiHLSkJnIQSJ_xmNBotNW-yAjSwIMxYNcyg7yvDIgg&oe=6A427BA8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiHtoXHA8DkQ7kNvwEDvGgp&_nc_oc=Adq3E9QrAjHU4GM2rbAomeQQ4mXuilg7L9gSoCbB8oeNNUHXAbLi_anSWdX27--JQSs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkHDQ9JpALdxw4aUedF4FKxyTeWv7QIWlFh1Wik5t_qg&oe=6AF87C28"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e45vZuB9w4YQ7kNvwESNYrw&_nc_oc=AdqQj9KIXZAwUIRLeqSD911vtyPbQ5L_D5-67jSmm81K9USMVBsBMXn1XrKMxEKTDVk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYVl_D2PoPdsabZH_bU2-BXgxhVSJDNGEE8lKdqXq1Dg&oe=6AF89FDB"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NA6xfAKgYzcQ7kNvwFkXrRa&_nc_oc=Adr2IkCNMkKrKjCsycpA5hEDUVVlmNy-LsM_iD3WcxrY1YNMv3W96549vNC7git_g58&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-x8pw9DRs59Xge6Bp7st08Vr8y_sAFNMR1gtKgN1nUg&oe=6AF89744"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lR2RyT4uXhwQ7kNvwEfZptJ&_nc_oc=Adrkp_O_IJqygdRLbTZBkBgxp3GPlJcRqIIZI2AIhVy96AqaZNEY0DtSwvzDv0XGcfU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmbRAxie_VxcqlM3jjmxp0Q1olRJlMIKajCCvU-Ybhrw&oe=6AF898E7"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSqTX6BHOvAQ7kNvwEzglng&_nc_oc=Adr2OxAS3ba6uKbb5YhOHX-eDNhdfd_44Wsi50SnR4iPPATSQjc-oDI7N7xUt08UBCQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAb0yDnZwsttrTyPnw-PPw2Ifm1ITXxTdnCEB3o8fPdQ&oe=6AF8A2E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
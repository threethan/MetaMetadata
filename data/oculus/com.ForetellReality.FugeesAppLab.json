: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9a8UIct9lsQ7kNvwFWarUY&_nc_oc=Adp1g96_cIXpek8DEvjV4UuU8qISO8fz8qAzhWxKuuDcpQsLiOgZCvf04FF_rE1rf4o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdcC75eo7-qDRTGPqLJCIz19Y83j363OAY_gngu6QFSg&oe=6A8985E8"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcYwF8OIFwYQ7kNvwHLJ3vR&_nc_oc=AdowDoK2ZaILV_8GcbUyxOWPeMYRauNC2F6LTve8iRIC_WeSHzl0houM2C3b0SG-whM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQlxTR_041oolHbu2ej2WKLQxskZzaQ7PhVibfTLxlnw&oe=6A89715B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpheuy4m8wAQ7kNvwEVjNQk&_nc_oc=AdoesuLMiZCMs2sT9ynf2vn5rfsS2xXaAYYPVR4wSZUnFYYY41M6MYmRSYz1vUm0eqo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCY8ANhTuEsW5iozsl-OAREjqLd_ixfgkplujaPcq1iA&oe=6A89A104"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2NBlb7AtDQQ7kNvwHyGY_n&_nc_oc=AdpWVogl05Grqt_4dg5ZPoA3g7GbHF_aI6ouArwguffMibDAGqU9hMm3gmc-jmSSMNQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDpvmuBPHGUY1xErSYcu9OuI_4bLXscPs8OOL27GGIDA&oe=6A89A2A7"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjgSUgoPUI0Q7kNvwG58Imh&_nc_oc=AdoSyULWOsAvfOC3p86_KzdPrjmcwzIwbpdUWmthCh79nTVn-re7NlZzUExz2oU7U7E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHQ7sP0ftrRFbkHSOatTai93x5vRdAxhNsPne2zvtlWA&oe=6A897468"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xqYT3DJy4sQ7kNvwFFnoHm&_nc_oc=AdrXYr_ENi7lcW4wsG-Touw8ihoH1WhOibREveC7WPYrV1CTA4O08BeGZf-AV2VaRhA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1mstM3JAo9Rw7q23tAsIeTR7ert6kXbz8d7dQZpFZ0yA&oe=69F61628"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUkUmpeBP7AQ7kNvwGlyzDs&_nc_oc=Ado9cibW8hcCv59d8RtM8gjGlXyK2ZcX81a3yr6iMbPgO7zSynDUSjzwKHiJHQod0Hk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Pl8yP4bQ-og2v9w8lBcDFXAHfIwLtQpSSc-4iDPO55g&oe=69F6019B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NqalGZNf7sYQ7kNvwFNVIsn&_nc_oc=AdpyQLHLSEyPng3fPmpTk7sHmpIndHOt5gY4wqyXHbYkFzbJmQOu7eeKbakA0rxtsbE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3hbylulSUscf4VQqa7hKVuksaWk2b16A7dt60rC2pHCg&oe=69F5F904"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PodQdMn-CmAQ7kNvwEIpr-W&_nc_oc=Adq5kM2QrQnuEPX43hqqVk_QgE5IMpLv_muLuk2Elknh-c75H_mY5Zh_ai2gkSmfL28&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1kW1YbLXaOXagD4LuK0AluIsNDqV9j9JV5rxCmdtPC8A&oe=69F5FAA7"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFL07U0n3LYQ7kNvwHfhIcZ&_nc_oc=AdpaXL-5N7GsKTE9_ncRiKO_I6d55lmPUvdTQWGfCrC5zzIgmXh-ZsZ0cJEVL3LRR84&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0vqnosyrdAo8l6ES7rcRl4yy-xAhJdD5yPvwEzGdjqmg&oe=69F604A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5irOlGnvDUQ7kNvwGZdHTG&_nc_oc=AdpXD71ZgDNN30g6nv5r5axA47Q-SjYNzaykZF0aEQWh-E8tO-5YobhNs2YY309hjmw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOp-YD2A6M0Glwme85VsZmGDXuIi6oZU7PxzDg6GEOEKg&oe=6ACF9DA8"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGOfomnKfTgQ7kNvwGhXcKX&_nc_oc=Ado5L4r8ZIjtZUIiDaqDunKual7u9KNowj06JilC1KfZoNnjkgMIBdgGn2crJOhGPUc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTNEdfOM81KCnh1zhgQCk7wemoo8Ur9NE4mL0XVcMbDA&oe=6ACF891B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELtZ9jJGL-oQ7kNvwHdyPUx&_nc_oc=Adoau_Kw79cRXeQ_nlWNh_YOunT7eBdljGrEeVuCvvvUyYynMNrZ-BUN9PMzhZh-CQw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaWpnR9yfoAVU6WcqVLOwPCTlqN45rAwwZ2b1F7icPlg&oe=6ACFB8C4"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uoAYM2pkmoQ7kNvwE23TP1&_nc_oc=AdqX8rpy52P4s3RlBJWTbyqf1p9-gEV21dmUv3x9ketBczNcYIyAE6gOEPfTXs4DouM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNI-4X0yAS5TsP3x_SFpMRMjve0_fQpYWlLfZHggaxoww&oe=6ACF8227"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlCTT5SF_s8Q7kNvwFMVp7l&_nc_oc=Adr9LxM3ZgRkB7cR2zOC285uCQNHn5fNrzWcxmem6gf-vc97bdtf6kB63ADTE8RmtE0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGv9SmRvN13RZ8v3mwT4-Fady-sWUE4ottMohggJFOaw&oe=6ACF8C28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
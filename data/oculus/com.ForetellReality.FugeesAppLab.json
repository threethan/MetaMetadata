: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INWgNXnlk5YQ7kNvwGmhmHc&_nc_oc=AdpAu4DBYyAFtOuccgxSyEvyPuHBbjZr8eFkw24vtMbWZhdrNZI6HFX3zrkU7i-XuSg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUM0Xq2x0ToGH17q5xUekY5mHeEIN_jQhr6LIHAw8uTw&oe=69C51668"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpUxj7arGVIQ7kNvwEJEIXk&_nc_oc=Adp4Kd1u3LWFEEjR59GisFCizweHiLpfxVuK-zU0-MN6VVEsgd6avgZY3KD-bWKxUuo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxV3vL-RRdELPeYNdk645rdnI1ejqKLOrUtqbOA2Ul1-g&oe=69C53A1B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9gk3-AAA28Q7kNvwHupLCb&_nc_oc=Ado92ZllXRJ3T4FGsw4Wh4mfByL42Zaf4R-Wogp8zc53oI-MldAte52mp1AvfLKPf7Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzsdg1hC9Ff1aruAl23j3R7SKNvqBPL_cLj5YPQMmfVFA&oe=69C53184"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mU1Y4tyA5OsQ7kNvwG9oWnC&_nc_oc=Ado50dU6arZbQHw3xLChxWoUXt7NFMFmeEeElDNJnXPix_UzTNrze7LtCPuyCyMXCWc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUOoRwQzS3wQz7LCyGqR7T-88zkWEEF9HWWaH92bSl8A&oe=69C53327"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0z6dIUKVAPEQ7kNvwGM5thR&_nc_oc=Adqt-pvVrLRhRlUXdO_7DYeDW-MJ8NStUGCmNfyR0TzV_xRRsRDSbYC2YJaOUCLQZuQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxRkSr4ZFHuJjU_ItJgBFpI4B_VXLXJXIf04I5d0UNQoQ&oe=69C53D28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
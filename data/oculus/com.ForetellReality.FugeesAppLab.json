: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tj5PiJcTxvQQ7kNvwGvrs9f&_nc_oc=AdpQEUwuRBdCW_IMoMjfDacMsWSI5Ljurnj13maTSwpg8Hd9VTBKV4IMFiYQ6XF9v4k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gdMz9EGcGgQVq_28PwnwmmD0wTgKTOkS9vnJl8E8dWw&oe=69DF7468"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5B5w0OyziygQ7kNvwGC6fR5&_nc_oc=Adpj29oZiQRWcCwUdVdxOL5mHY40WEf6flxpNSnv5_dmtRfJzo5ndwZlBZKMRM95cGk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iNYQAR8-2KEisUWSllHGtNFz7Umh6ysekALV4g_rzGQ&oe=69DF981B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ctj9Bn6OekYQ7kNvwEeM1bp&_nc_oc=AdqultWLx-gtqbOqEo2ROMKb8kst2riAqcm5gFtR4Jdg7ljNnIiVx_WaJbfVY-8yG_M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hkA0Ml24axRwx5Dl3uVg2GsXVymkQpaZn7s73w7EBnA&oe=69DF8F84"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLpP2N2aOkUQ7kNvwE5y0fj&_nc_oc=AdrR_WHDwsOlIiaMQNfb3dz8C04UjDi4cw4MYKl7_NPipAbw4r5Z4gM7C9tCFfUKjaw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_X2Y7VxoMavYUiLLOTUqeH1Vt55BTO-r87URtQySr9w&oe=69DF9127"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXAP_GWpmfwQ7kNvwE5kyNt&_nc_oc=AdrYOKh-BLMnKSl-CXKvzPzVd2iWvzcCKl9dZ5b8nJiB1k_nxDfAYES1cMw2zj4c4cg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cIZeiln2LtJdoDTlpCp17rxQEvhv9JHdd7xAQ-00TEg&oe=69DF9B28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
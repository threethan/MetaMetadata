: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0r1y08-e0UQ7kNvwECte5_&_nc_oc=AdomxD1gC7MRoVUY8jzg4gkAO25V4hHKs1vB3KA72I_TRWfal4KpJnKnz_3qlzokp3U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1X5mt3hVNDgBmTRM_Q3OmPDR0yzSaaDApV3WBNUwBzkg&oe=69F8B928"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJKN5x-WWVQQ7kNvwH_xg0h&_nc_oc=AdqliMX6O_inhiGmcCUFmw-rjRNkDM3lU9gSXqJfceAFeR3q6Ods_8mqlkyfgSvgAXI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2vs2PV_IVE88Sq-sSpSkQB0eCQi36_B8n6uJ5yRjkmIQ&oe=69F8A49B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xKAmQ6q3YoQ7kNvwEkFMzs&_nc_oc=Adqwj_n5EEC0RyWvUSXEyT1aUFva3eIvWaMQSAUb4UHFmLKjDbBZxoPQ8lZYaiqVn2Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1L7b9aXXzpF99vhJ84QkknP6pIkK6j9wMTsss2fIwV7w&oe=69F89C04"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PodQdMn-CmAQ7kNvwEfScIt&_nc_oc=AdrFxK6nLomUCJeGeivUF9-YQCA4UDJreNp4HUvawth9j7mIdYrKkeiMmvIBZz47epI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af08xBmahu0YadAV19aEjFXvWysZwuDZhy2crqoPO3qOWQ&oe=69F89DA7"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bxOVNjOoFsQ7kNvwEk-yrK&_nc_oc=AdrDwcdADVsYRsqU_e54V1MylSMctJkkOjPfx54fxIYM0LsZIpkPKuWXKtttXtdscgw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af35vCnu7vgOZ5etHbKZ1IiwCRfK6sphMsMYlV9XQXAgcA&oe=69F8A7A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
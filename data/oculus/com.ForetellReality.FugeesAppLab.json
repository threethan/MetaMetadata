: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTk5aOoL7MsQ7kNvwF983je&_nc_oc=AdoJwzEVRuXOelNkrcYimsOigVhOevy4o_haEcJa88sk43EZOp5-KaR2FRSz6N9Sf-A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vXaHMy_NiEDYsirK4tuC-djz1tNIIYRRRDql2L2NEyA&oe=69DB7FE8"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3DdK1it0YEQ7kNvwHh1QvG&_nc_oc=Adp1vEoRY_4gIXsr8UdWoREIUsIQUMVx5QEfi4SGwdV5Zux4olEsP1LWJDTP83MNaY8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ICY2sUnPLMowmGHzeoyOgJxM6ibtmOkZfZppPBWmosw&oe=69DBA39B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKSKrvPR82MQ7kNvwFVpoDt&_nc_oc=AdqBOrUry2cZJdpa58N0KIc_5vk2S3fumYrAjkLzxrHVLuuCh2SEmwoMxDSCvuXhMnY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vhdhv6T6j_LIqKRfDtdmMSg6XaZsKIt18ko_H-sJ80Q&oe=69DB9B04"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmVNM-8b4g0Q7kNvwHhrdW1&_nc_oc=AdoMizg_SmgkFgs9W3DYUY7Iy8_cgtTKXyMbdsUy8uWsekXA5bAjCFXo1E7tMKsKIsc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cTwkrzheaJx66FPSDpIascI9QmlL8CBWN5UL67gAo2A&oe=69DB9CA7"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hw_l50LI7BsQ7kNvwFUZ1Z7&_nc_oc=AdqhEOor2tiG0LvXVafigPwk-lR6h4WjQW-QNmR9_6-hg4KvF_WW-92Pce4wB91A2Yc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SUM1GlLdy0-KtfH5vtpJgzHiL9l_iBZViGoejeJ6s7g&oe=69DBA6A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
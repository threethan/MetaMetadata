: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0J8-EDhetsQ7kNvwFM169-&_nc_oc=Adpyrq2Dp8QgtN4nyuKiYotyrJSGkkrzSiqFVLkGBO4UTmWaLciXK8d5WzOmWpEfyTE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuhONwY7DMnpFrIKqYLlmdRAPjfotFkH-cP-LRgzaA7A&oe=6AD240A8"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_TK505AmAwQ7kNvwGObumk&_nc_oc=Adp8bUkBOOTEkF5hBpAmJyyxq_MeCfds-w_SJXHTU4GLi_4tOyca5zxmo-r2qgUXYc0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKMo3h_DSf7UY8k_-rcPA1D_zri4pKIDc8d9zBQpkx6A&oe=6AD22C1B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRTqc67_FQoQ7kNvwGKDCTz&_nc_oc=AdrPjyOrflsjcOpzh5r-A83OD-aa1HVmGyeK27Fy1z8oiZkP4ICdQ7aEpe1OHbXmEXQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrK2mnSyxumtdX1iqkRyUd-77G_Y-QhjZitwSliyJ8VQ&oe=6AD25BC4"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uoAYM2pkmoQ7kNvwEtkJYL&_nc_oc=AdoDP-G3bGh85nLv_8UrCUiGqMV373rBCdC2U-QaiR5myKrANabp1E35vyZviMWfNOQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-70i9kYAOHm6akHPEhx0K1KewdrzgTlyhR-9knk9Exg&oe=6AD22527"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_KylqdyqowQ7kNvwFukZFn&_nc_oc=Ado1Pbq5IcedjVrWoMBewOOEKxHm98MAbyR3EinWkJrZDFJEcR6zipyaKNqzcAKYIQA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNm5I_AFUwk9aEOjlOeeM6YrMZvNBhQblrhH1ieGa7f7w&oe=6AD22F28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
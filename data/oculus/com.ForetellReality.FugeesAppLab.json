: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPK1c-lLIYwQ7kNvwGQ1ZyC&_nc_oc=Adr7ljAWCZWRzdc7TSy0y0hJ-i8YC6J7I1uhX6uszbNjwOKYZ1MKzNOdAt6xpKmmSmM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeHpeBJbT-ejJH1LY0KYeM_n4M_tsbeDPO9jyd63OOBQ&oe=6AAFF9A8"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e380twqNQGwQ7kNvwHYU0pL&_nc_oc=Adpk7krtbyp-6M702LoZer18NzQ4iL_gCJQ-KtqAUlfAlK6gbtjIU3-vxNwRKiNb-9k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJKpddmu0Bl0wdIrCMjy7hxbpBILNLK-C1y8tZaiWJQw&oe=6AAFE51B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWMbsHTSgVIQ7kNvwHhIFOi&_nc_oc=Adp5gBZpzAb9ZpU0f6cbOGLOMo6s3HhhDGfJg3R08B2UCJ4C7rv5qAnJC9mtiL3sAXo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoTKOgibAnzdyfnh2ANNwf4MnGPoERTSIWmNRBBcgZ9A&oe=6AAFDC84"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4YUZkDjvkEQ7kNvwE-rkGe&_nc_oc=AdrN5wm5b8vvije_PrvVilQLB4PAbC3Zex5zRkcmfLuVPBDn8xSCfH2irUTZuCBpUs8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmWad24158oIAfOEt0NbYDly9Lc1b8HQ66QpxMuAPwBA&oe=6AAFDE27"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSOQ7US96nMQ7kNvwF9uFCn&_nc_oc=AdqlQYNJFuLHneQUchs54tnTXkVs5pxRDBiPJDTFxFbHMSSbA2JeuoG8hRxSGsmJwb0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfYoixZAXkXM4-kqINUBrkqugrhEDpAZjuo2fs2585qw&oe=6AAFE828"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
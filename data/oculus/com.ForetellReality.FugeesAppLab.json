: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7o1QuDvgGMQ7kNvwHQt3en&_nc_oc=AdrPfm_Hh7Nd19chU6AS6JHbD_7Zn_J1AR08SdheV830WXI64ShsanNfhJMXlKwHYoQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXid6b5XCelo2hYywazg5HCxfOFMws0d3Eg5Bwm1krTg&oe=6A5CB2E8"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pjsQP0CAGIQ7kNvwEJ9o_F&_nc_oc=Adr1jt51EDjpl49aFje2lMbtWmTEZZUXBuYWi_98N4JoayZ0FX-f7Qf4X0pO525TlX4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYme7RA0puRXxdQRp0riNHftKGEqsP9vukWqw1wasAhg&oe=6A5CD69B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPzTWNodRzsQ7kNvwED9boa&_nc_oc=AdqRsJM-uHd34TSBgkFC0zUeoqNcGvd7N0UHAnvX0JZm0HQ5aodc6qEiLsqkpVDAJ-U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6Vvqd8iBS8B95q40XcEcEkmtdLZD3bpC5rggiBvo_CA&oe=6A5CCE04"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmXnhePVRWAQ7kNvwHnyfQF&_nc_oc=AdrCZ5X730qJjbYF1OW9YGClh87JKqE34E7KojyCmUTjXhPCd8O2uozUuSgk-FLtpRU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIapt1_tge5drkTIFYxLt_UdWZWrlK1Uy8iEfDxIEnkA&oe=6A5CCFA7"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaHgSfIkGKUQ7kNvwGenrpy&_nc_oc=AdrBOhIfThM-es8uu1F9LsxqPtyZVooGZIArPzDBhmBd4qCBQDsOvd7nUQ9Zn30qLg8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRxZh7qSUSrxNrrUtlPHt2eAmEj8ZjhJG02nCKAjpUjQ&oe=6A5CD9A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
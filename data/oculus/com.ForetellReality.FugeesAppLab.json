: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvzLEF4tiP8Q7kNvwETbYIb&_nc_oc=AdriC1nEQKD2w-6RoPdMjyYyuYIaLsdpNcjSByQZ1xp8-uzu87tHEcsvlafR1v0JYYM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhaBvUsMe09Apd48CCd870nYf2veC0TeP-xVnssw7XgQ&oe=6AA810A8"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAZAQvkFkqEQ7kNvwGAl_56&_nc_oc=AdoDUQK_IjaGOWX7Xoe-eKUGlrGk_HBSuLevkB7nQ2tN0HnGiggCorbFYn3IcKTMGi8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaPotPbeCnE-iLL0P72rCcCmbL97Btfh1UQUHG2OppTw&oe=6AA7FC1B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oR4GnBx4wCoQ7kNvwHmWDWC&_nc_oc=Adr3PVXseF7TCrQYjICZKO2oSjeSs7XK7rp7K400JpNOGNQgWhy3-5xk3KiyMxJ71gY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeZqJSTBv13WEdHs0Un-R2aVjCTbw42nZrlUVw_dbRWA&oe=6AA7F384"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVIAfwE6xn8Q7kNvwGqZh3g&_nc_oc=AdqqgVOmQbl3yMCbNWUka611T_x3vANyvN0AuvO74GOBRvBaxzwaomRv-W7NHDecjwE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHiVPLk81V_w2cVIi4l1TIOGyvZ-9BUdQR23wbRiPvlg&oe=6AA7F527"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSXObQ4xQEIQ7kNvwHzrx8m&_nc_oc=AdrZzxC6FXUp6530ke6NFGZGkmbrjyo1BArQDz7F0Jb9X0X9xDPThTzdngs0gPePOFU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIADpbDI7s2hZf9o5aaMHf1i_NxpSDjhozlAi2ORKS6dg&oe=6AA7FF28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
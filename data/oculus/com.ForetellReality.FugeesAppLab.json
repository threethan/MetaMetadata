: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKRXWH7JHlYQ7kNvwGtvP69&_nc_oc=AdqbLGNyiuCVwl9yCFYU_jSmREDadraQh2PupCbovUXZ53UJaVKFn6vXMK6C6_tSUfw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkWyBTiaxpnoz09eoTY99_IhR5tIbWcRxaQYgsIYWCBg&oe=6AEB4D28"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lX9QYsKI4HwQ7kNvwHIu8Gl&_nc_oc=AdofesRCjjvkIPGJodbwhMFQGKoaMvMa0XY_RRbKqLFDf7BR-ulK-q9stC-eEfB947E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6bG_ioNLFjnrz9Z6JQp4Oo-dJrh22iBos0xZTKk_Ahg&oe=6AEB389B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDRZG4944MIQ7kNvwHTQOva&_nc_oc=AdoeeErWCnrStXXWuzQiodcREIBxVqJxjB6AP1tns63Qaydfy7LixNo1dSFP3pqAD2U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ9MwqiuzN5Ouhp3sx-NW5sRxeeocAfWDPzMkS0hqmwg&oe=6AEB3004"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OQg46soDsQQ7kNvwG1MdqC&_nc_oc=AdpxD2O0dfYsK1WbNVSTPtO5dqTf-_HzRi3YHaoOv7qT3TxfOjKKSXMU18CgvpT4iC8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqdGbHPwEfkSOfGZO4rxi5MJeYtnUB6HQUiBGXaO6OCQ&oe=6AEB31A7"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFfp2zSwia0Q7kNvwE-aNb3&_nc_oc=AdpS11S-vl0U9epIEJ76RX7PANluc7F_N0n3t0OiFDvUFb_nFPsZ1_pNwU7ZgiVX3ks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPUcONaPg2aDXp4-iual194Y1-DGgCcqZuzPu8O12WjQ&oe=6AEB3BA8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
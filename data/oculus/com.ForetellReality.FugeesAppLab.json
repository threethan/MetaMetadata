: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMmPMQmqR4gQ7kNvwE9yYs2&_nc_oc=Adp3qC_9fHMdswKH3-xyO8GU4-QuVECzSXgPFAdZXbz5NGRuj6IYcaJgbX_M3lvM_U0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABOEqTe4_H05d0JQfX5TKfsAAlNwL3_fUGCasRflUgrw&oe=6A5F55E8"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZY7qsYnJI-EQ7kNvwF76a0s&_nc_oc=AdrKyo6Vmq6YhtG9o4ebSaocwunJrEG8F_UkJGPU4glzyGyJBF93Y5zqy7PhXBpHGoM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLkEUyOEixVgK2TApLZkV3Yd0wBmrX6N-MzMCWJGr4Jw&oe=6A5F799B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPzTWNodRzsQ7kNvwFYEp2q&_nc_oc=AdpM5qdLTJCFTESCVW0qbMvOrbgyjRbrsxS8GG5o2zqIRx3uLrfcXSO-qFg9zdD7bQA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPEdMKRNk9AUFh-z7YcDhaxYDG-v8GCXoXqmJNs9LGbQ&oe=6A5F7104"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmXnhePVRWAQ7kNvwEW7Ek5&_nc_oc=Adovo4iLOCsofKYIwbxoz2s-ZTXm1wXp0yJntg3sK5O2MGrZ8w1UpWMhy106dJOolU8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUSUWDHq08hZI8srjuBD4u0P0xltOlYHmQ6XJUun4d6g&oe=6A5F72A7"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIvEc0f8880Q7kNvwFj4TcH&_nc_oc=AdoYpfr9tLDQxsDmpZSMQnRUGEdmfGTZ1KfaR30VWAP0xYIKkUm4O4tf3c9NM0qucKs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdDuZdjN2SoqDI-ukAyzk1GHlE8kjt6-2xKjI9WHBBhg&oe=6A5F7CA8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAjbyy_qn84Q7kNvwFY3fi8&_nc_oc=Adq6tM6QIhcAzbW6gMf2z8NbYNtr7GcMbCdGxMbM9eGvAtif8evkjWK8903ILepx3hc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIvvcJL1pfDe6VMhpia_BAYCfQkR_El9wg5ICJjNg0kQ&oe=6A4D1928"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICTiU1eX8BgQ7kNvwGouomy&_nc_oc=AdoCMCIGsr4A7Ww1dKg0-dpjWU-RxPw7gJ5q1-3EgL_a1DrKo8vStMoXKtNzhsoq1U4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfX9eVCTpzDlzVGc7le9o6r3j1oRSAuuYDi-LR0GV6aA&oe=6A4D049B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pURaEvgHO7wQ7kNvwH_-q30&_nc_oc=AdpNA580OxjW8H2qU1o0cRwOOkGdK1sjsqFISWwLINyzAZg8-SQo9z7dmS4e22_b6Eg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCi0HZeIR_dItC5lY20TiGzJ0EBLlSYddae61WFB3uEvA&oe=6A4CFC04"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIxWu61GS_EQ7kNvwG0RFqo&_nc_oc=AdrpRxSrL--PxWbrYgNjRgSlRvKVa7RAU0RuSBgZXGaF42gzH7S1vWgLOw7qmKEeK6A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2dCyfArCiec1xAjeckvRO38xZbhNNyMBwsVuwXQRCsA&oe=6A4CFDA7"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8isVSsXJgsQ7kNvwGhcTH1&_nc_oc=AdrbAD1rdHxtecTv6cnWB2d3RCBWj3AHzj0kldG8cKD-FufghFcgpTCa4vQ_gNZ3Pns&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtocu8ZYJiWbtzOSrjYza9OHe7Zm_0qyq45UGTvrGWSQ&oe=6A4D07A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XOT02nQb5MQ7kNvwGQD5_k&_nc_oc=Ado6NLnlRzoEEW0alZzXNsKB5gehKim5jkgkm39RcDGOJhekvoA_kv64X9AIcZDICIY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJAtVS6osBO99o988eoOiD-vd6PKmtEJhOqLa4dbXigg&oe=6A75F7A8"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Vi-yBCceowQ7kNvwFYKRVq&_nc_oc=AdoiKJruZelmCZOHEy2doW-X2LkzFyOYpm7N4P_fs82ja_CK_0T7p6CILVlPGP3vV9c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErfEvTVoi3juFV-VXXGYqylg1Jcs1woIf6AtiKvbgH7A&oe=6A75E31B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hR_kX3K47HUQ7kNvwFvhbCI&_nc_oc=AdoASj_tDxF-nStLcbyuJN5TlTXFboU3kBviykNwT-45pC5II4pZhkeKAYij4oaO-r4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbJp5nzxQgijA2WmV92KUv3SKkDtRbe7RwCaYquIEmYg&oe=6A75DA84"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htwWWBo5M4IQ7kNvwEl9RKs&_nc_oc=Adq171__exDDB0imr2N8L69zkFxPQjRD68RGSPp2Y8bZSkLH5G_g90_yv01DAlBd6Vs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoto5doXAoo_pRLuzPaNsHLyLe1kEqtJTWb1A0rV4hBA&oe=6A75DC27"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCQ7S-lh21QQ7kNvwFgQ2El&_nc_oc=AdqC7m6Rqog86zokGqgDLjHvdxqQ2mDC7hkgy5WDHkapMfBMH4VDuTSRrP9uG1gezt0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF90M9jNQwu5tCkHdrt5skMz4juRIo1-eJ63nuHtWfnfg&oe=6A75E628"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
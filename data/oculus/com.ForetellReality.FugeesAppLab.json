: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0J8-EDhetsQ7kNvwGZVwtk&_nc_oc=AdqMeLzD313ZihNyT6ltaJi7OmmC9qCpCLvVcGv0wVaUZ4A5dcGP_lSiWO0J8s-Haks&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNyZDOiVAlnYIPGNvPVKwim1OgVkp9BBTswoQptQNGdg&oe=6AD0EF28"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGOfomnKfTgQ7kNvwG9Ogmm&_nc_oc=AdpMQWfQRxaID5EtU03DMxJqnL57ZmZWQ9GWgk6fLqQkWhJqTAL0TThFKIyFxrvwJBk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwpbuxsI3KcjFX9qq6DcTH0atKZxzAjZaXNuIeU1Wg6Q&oe=6AD0DA9B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELtZ9jJGL-oQ7kNvwE5Es8U&_nc_oc=Adqrfl6H65cps52ibakehtHYANnPwoYB8H0yJvzcY7lhHmFkmmuW6oO9kFTBfGsL_9Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOi4Q72KfYfc82TdKL0DFspc9z0MY4UqAcmAVEuqu9xsA&oe=6AD0D204"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uoAYM2pkmoQ7kNvwFtG775&_nc_oc=Adr5Svz-adIgBugvaxdf0fWyQ_KgiihMSRl6mErTvGDO1yVOQdW9ess2NqIqw32rsfk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmmnqvbeXYVm1DGdav13rIdUD7csnDOeAwf0jNDXJbNg&oe=6AD0D3A7"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_KylqdyqowQ7kNvwHGUo6p&_nc_oc=AdqTe_M3zgP646ur1oTIZcaUeblvs4Ksl_R3CtRu2Hg7vdp7j86L8XZ5KqljZnbZhYE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPd7qQhcdUWW8gfVgQF3CwPassANfMp2jBSy9FWDn1IEw&oe=6AD0DDA8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
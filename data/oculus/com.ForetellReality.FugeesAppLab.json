: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWCrVymSqogQ7kNvwHn4pxG&_nc_oc=AdrLmLR6eLdIQ7tit4A9qGGDGJqUqETY2FQSslTEK-umDZLEFzlpeuCrhi2h9Hoq394&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDK0GN9KckqIYDa-9xNsJb-DUbtFdbnWj9OYuChifMvxg&oe=6A4924A8"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKEvv7XAXAcQ7kNvwFUofIQ&_nc_oc=AdqIZkaz8NB87ttIRy0YEc0Pz30yeY0wIoRRAGieEEe3txXEZhq2MNCnKzQ3lrbdXvc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZnPOc2vw8kvrPx859MWbes4IyFw8s_CFCVa_oNDTVWw&oe=6A49101B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilBpsmvkkJ4Q7kNvwFUrnne&_nc_oc=Adrjzz9vCbLwswlnvAMQZP7zNiJvOsovpm0oyeCXWK1rj9-EFT8X2vezcq4lOLLsF1I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrqoMKdeqYW3paXGsApuai3L13M-6WVa0_LCw2NA1Zjg&oe=6A490784"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEl4wd60MXQQ7kNvwH9y_rb&_nc_oc=Adr7eRTmfQ6uIT5u6LO2JFF8ujKxfZnrIg_w8UFeZYNNY7_zg6PE9KBE7fim9pArOIk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBP8h02MJY1AXTzimruV_UlL5N9gDqD9dFW0bjlK-iF3A&oe=6A490927"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frqYNTwmyWUQ7kNvwFqZ11Y&_nc_oc=AdpdCIE3Xuw3URh2jqQMVw3WKxZYWBq5sa3vxn0LAQkgMILhNkZlQQDPxNVZwHU6mVg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAby-Icc62diD6viveFVP2Qn8ufUArEtD0BC0Rc8sEjg&oe=6A491328"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
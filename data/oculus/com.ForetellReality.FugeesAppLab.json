: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7o1QuDvgGMQ7kNvwGGb-vs&_nc_oc=Adr6bKjABcvNcDsOdaeu28-N4bd2D-at7nFgqU7njv48YYMH9gmYBcCo4DrsBXLftZc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAzwMOyH9t0iErCWR8qOCmbyI46bk96077UNsiWaYSGA&oe=6A5B6168"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pjsQP0CAGIQ7kNvwF2nWMQ&_nc_oc=AdrHjRxKh451uW8THPSKNEu3uzLrjk1eICzbY0OszkcQ31s4GzY8dcX4wKo8gg-8-ec&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEVL8IwTSXZldjuDmHWYq386phVwRozzLafS3vGBSFHg&oe=6A5B851B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLcSECdzx6cQ7kNvwFHGGBv&_nc_oc=AdpE2TcJQJ7XFxftqPJG6szFgH-GRLORr5e65CaHP-SM6VM-Rxqh7Fw-2n4bUW9ZwGc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPZ1KMcfStkoSBBVlNvXmhLbUttX37yg7Sxfw7gW9Pbw&oe=6A5B7C84"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjJ-_Ae9cLcQ7kNvwFJAUas&_nc_oc=AdrOGVhfXXI-bNcgGvwFKWmp5jwhMreRfSoKlhdo7Wa61MPb4T922W5SwDUEW-ECBcM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvG0_zwZIylJsEn-A79e29Nk55DRLtwN7-uai6Bp9wMw&oe=6A5B7E27"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaHgSfIkGKUQ7kNvwGHMJY7&_nc_oc=Ado188jXpMCz1o-sv-Ps2IBphEMM_1-SwDcNWoCu0gMzPt3LRGMNABNOVjZIcCpbOcw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBI12B2R_497Q59MgzzeA_flahen8eqTNwMpilbsYxa-g&oe=6A5B8828"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
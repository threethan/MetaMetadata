: "963721522000910", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "441264131889872", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974491_441264135223205_7970030276054095276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvzLEF4tiP8Q7kNvwG_PxaB&_nc_oc=AdrzRIrJhr2iNPLi_jb65AidlTFi2KEhQU465O-yreEkLFFHkWY1iQyD3z5Qs7Jizpc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjydNQTWZaGEBX6ztGtqK7pB_dyN_UGQedtinprYcBQg&oe=6AA56DA8"}, {"file_name": "002.png", "id": "443250714768688", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974575_443250718102021_1351052423407545473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DY8r7bZJ7B0Q7kNvwGN9iTi&_nc_oc=Adrl-YhlX7Gj-IaXzKbid0XIYVg921M5hypzU5xVLhRUKL4GcU1S6b52ATcwVs9sbHs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLO7AgYdZfbPf-hIiiL7Z3BrHSibT--KbRcTouN_grnQ&oe=6AA5591B"}, {"file_name": "003.png", "id": "275055692345193", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982719_275055695678526_8919710582386734806_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbncSjWI1P4Q7kNvwF5kG-g&_nc_oc=AdpBa530uQcTbBQEWDFzeJOJXVdIKmXrZGAOcUE2FImcXtSj4EqumQrc39uqW9ZXO7A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeAVgGH9UekO0tLHwS2dJvYEiKBZ90KkZLvMGi9LZlzA&oe=6AA55084"}, {"file_name": "004.png", "id": "976367147436724", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982597_976367150770057_2894554143204748662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fysC4sd9uXUQ7kNvwGWaEii&_nc_oc=Adqsiscqh69H90QgqhXJwACxn3FTEGk1xvpLQYEMaVi0cqcbKABtE_NDmviOgH1wAqo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4lcjPvatKoX9Tfuc6co33MIbo5hIgwBSOQj48xC_ZNg&oe=6AA55227"}, {"file_name": "005.png", "id": "2481855685354387", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982583_2481855688687720_4139726687525641317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSXObQ4xQEIQ7kNvwGjyOtH&_nc_oc=AdqV4IpnXjEI4cMEG1oB_yrvGASHftnRD2LQ5e9h3WPRNKutaA1JUGHnZEJ5yPhv5BQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtCaEanyo1urbOpgSjjScWPWJT61CRnO9feVkZ5DC0ig&oe=6AA55C28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReadQuest", "keywords": [], "long_description": "Step into the world of phonics with ReadQuest, an innovative app that revolutionizes the learning process. This immersive application uses cutting-edge technology to create an engaging and interactive environment where users 10 years old and above can develop their reading skills. Whether you're just starting out or looking to improve your reading proficiency, ReadQuest provides a comprehensive, self-paced experience that makes learning enjoyable and accessible. With realistic simulations and interactive exercises, users can practice phonics in a supportive virtual setting, building confidence and mastery over time. Ideal for learners at any stage, ReadQuest is designed to accommodate both beginners and those seeking to enhance their reading abilities. Experience the joy of reading with an app that not only teaches but also inspires a lifelong love for learning.", "short_description": "Experience the future of reading with ReadQuest, a revolutionary app that transforms phonics learning into an interactive adventure. This immersive application provides a supportive environment for users over 10 years old to practice and perfect their reading skills through intuitive simulations. Ideal for beginners and advanced learners alike, ReadQuest offers a self-paced, engaging way to enhance reading proficiency, making learning to read an accessible and enjoyable experience for everyone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foretellreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "https://foretellreality.com/", "categor
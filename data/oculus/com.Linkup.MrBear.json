IJCI3gWpE_6N3UEVQ&oe=69B3F06C"}, {"file_name": "6.png", "id": "189253337552209", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75282159_189253340885542_1884713868086791800_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHBtQt2KN1sQ7kNvwGx_F2h&_nc_oc=AdkCGn22hOUDHkumKkUpd4bTgJ0FAe-GYvuSb5GCk2YzSonbBbBAFtE516WbI4Dc-IU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyqeGbv66zZA8b8oh1XgurIS7y2VsuYF7CsCxGV1q2iKw&oe=69B3EFD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_2560x1440.png", "id": "377764107908967", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031651_377764111242300_3292848422382229530_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7b8dYtK5epoQ7kNvwHIsIGA&_nc_oc=Adl0EJ6fw4C6wk301sTxycciRiBhF_Kob3GR4IqF-Jq2ifjS11k3bOc7H8veXDj-wYI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfybZ0dJpqHh1Kx9VkzGD-S4HueO9CPtoVVgUJgwQm4J5A&oe=69B405A3"}, "display_name": "Mr. Bear's Bizarre Adventure", "keywords": [], "long_description": "This is the legendary about Mr. Bear, who challenging skilled opponents from various countries: \nthe guardian warrior at the Inari Shrine, the skeleton king in the dark dungeon and the pirate captain from the Caribbean sea....\nWe even adapted different music styles for each themed level: traditional Japanese sounds, Shamisen music, Lo-Fi, HipHop, Trap, and Reggae!\n\n----------------Game Introduction-----------------\nPlayers need to use different tactics to counter various enemy attack patterns. Engage in close combat, deflect projectiles from a distance, knock away explosives with both hands, and dodge bombs by sidestepping....\nBy the way, pay more attention to the corresponding colors and the direction of slashes. The color determines which sword you need to use.\n", "short_description": "This is a paradise for  rhythm and ACT lover. It's also a  legend about Mr. Bear."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupx
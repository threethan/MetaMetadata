qKc2Lje0sKnptSrKQ&oe=69B14D6C"}, {"file_name": "6.png", "id": "189253337552209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75282159_189253340885542_1884713868086791800_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlCCVNYrr5sQ7kNvwHrtjXR&_nc_oc=AdmZiA3HKa8WHy6q0y07HohX4jMth5AorFm03AomDg6LE8yuGKBvvhy7CRRqiDc_9Kw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfznFh-BBIqCleUOe4x5aSIIJVie-2pE6ydQ6YsJBPPNlA&oe=69B14CD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_2560x1440.png", "id": "377764107908967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031651_377764111242300_3292848422382229530_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtXtqlsZSE8Q7kNvwEt0myP&_nc_oc=Adm56gMjXDBlwlByPFIbVP6QYi9nkv551P_vRfFz9u8-qmeuYhaLZ6lTT5hEPux9xiU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxKp1hH5cb1CzsZyemjczIthvmOHsKz8lYE18vqkCtatQ&oe=69B162A3"}, "display_name": "Mr. Bear's Bizarre Adventure", "keywords": [], "long_description": "This is the legendary about Mr. Bear, who challenging skilled opponents from various countries: \nthe guardian warrior at the Inari Shrine, the skeleton king in the dark dungeon and the pirate captain from the Caribbean sea....\nWe even adapted different music styles for each themed level: traditional Japanese sounds, Shamisen music, Lo-Fi, HipHop, Trap, and Reggae!\n\n----------------Game Introduction-----------------\nPlayers need to use different tactics to counter various enemy attack patterns. Engage in close combat, deflect projectiles from a distance, knock away explosives with both hands, and dodge bombs by sidestepping....\nBy the way, pay more attention to the corresponding colors and the direction of slashes. The color determines which sword you need to use.\n", "short_description": "This is a paradise for  rhythm and ACT lover. It's also a  legend about Mr. Bear."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupx
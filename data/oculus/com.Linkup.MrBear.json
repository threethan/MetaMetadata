bEr6LjlAS8Vr7hkFw&oe=69B29EEC"}, {"file_name": "6.png", "id": "189253337552209", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75282159_189253340885542_1884713868086791800_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlCCVNYrr5sQ7kNvwEPKd81&_nc_oc=AdmaNzaHfBNk4h-vyVL8LcmVWJQ9Baqz7pg8cjf8fGjF4o2IyGggQMbTxpVuMDelScU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz5fO00QGSHULGKbppGcWPuaeywbZnq9zOHuD8mCyM5ew&oe=69B29E58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_2560x1440.png", "id": "377764107908967", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031651_377764111242300_3292848422382229530_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7b8dYtK5epoQ7kNvwFxCeZh&_nc_oc=Adl5cvD1hLRvMPY6KwwCIYswoB4N4yvUWP6T5f3qMipXDMHp6trlH8rWL-PdW8pCiT8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxk_pdDuQJl_88p7QiIU2QZlxxZNaNbaYM6IleKFQQV0w&oe=69B2B423"}, "display_name": "Mr. Bear's Bizarre Adventure", "keywords": [], "long_description": "This is the legendary about Mr. Bear, who challenging skilled opponents from various countries: \nthe guardian warrior at the Inari Shrine, the skeleton king in the dark dungeon and the pirate captain from the Caribbean sea....\nWe even adapted different music styles for each themed level: traditional Japanese sounds, Shamisen music, Lo-Fi, HipHop, Trap, and Reggae!\n\n----------------Game Introduction-----------------\nPlayers need to use different tactics to counter various enemy attack patterns. Engage in close combat, deflect projectiles from a distance, knock away explosives with both hands, and dodge bombs by sidestepping....\nBy the way, pay more attention to the corresponding colors and the direction of slashes. The color determines which sword you need to use.\n", "short_description": "This is a paradise for  rhythm and ACT lover. It's also a  legend about Mr. Bear."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupx
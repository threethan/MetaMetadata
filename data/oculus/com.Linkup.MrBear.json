g1-1.oculuscdn.com/v/t64.5771-25/75282159_189253340885542_1884713868086791800_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzQNw1vgBf8Q7kNvwF5U9Uw&_nc_oc=Adk8X9yYEYy6X7vWClWh5sJr6oAmmfqohpTe0pgZ3OeMdROXygv5BBKh6yTKlz_LwpM&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvH8ihW5mbxLcONUJs79cT8dM2nI96KLqij8HU5GDeatg&oe=69A17AD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_2560x1440.png", "id": "377764107908967", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031651_377764111242300_3292848422382229530_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcx5GdR9Q7MQ7kNvwEobMFJ&_nc_oc=AdlgenyO8IFL1eW9a7Emo_OPd5aegilY-BEAzyVI6gvngeIUb51twb2UuV9mzMZZjts&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfukjfF3IfLO6jekDht0iVN-37mBxgY1AN-ZKEHCdKG_9A&oe=69A190A3"}, "display_name": "Mr. Bear's Bizarre Adventure", "keywords": [], "long_description": "This is the legendary about Mr. Bear, who challenging skilled opponents from various countries: \nthe guardian warrior at the Inari Shrine, the skeleton king in the dark dungeon and the pirate captain from the Caribbean sea....\nWe even adapted different music styles for each themed level: traditional Japanese sounds, Shamisen music, Lo-Fi, HipHop, Trap, and Reggae!\n\n----------------Game Introduction-----------------\nPlayers need to use different tactics to counter various enemy attack patterns. Engage in close combat, deflect projectiles from a distance, knock away explosives with both hands, and dodge bombs by sidestepping....\nBy the way, pay more attention to the corresponding colors and the direction of slashes. The color determines which sword you need to use.\n", "short_description": "This is a paradise for  rhythm and ACT lover. It's also a  legend about Mr. Bear."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name":
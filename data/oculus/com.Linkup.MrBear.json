cdn.com&_nc_ss=7f20f&oh=00_Af9Klk25VET2u1i2dhu8_sQPgQLoRNSWk81eTZsL-AAcNA&oe=6A22E6AC"}, {"file_name": "6.png", "id": "189253337552209", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75282159_189253340885542_1884713868086791800_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2Lr83wja6MQ7kNvwERREo8&_nc_oc=Ado_u76Bys5kOpLVVWpZHVAjK3oAnBVAhNXwqK3Z-pBBtsXv03vQC5pxxpIdTBM79J4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AUEPIl0bfNw5qhN8BwokRLCQxMe4P-QulpIsI9pgJsw&oe=6A22E618"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_2560x1440.png", "id": "377764107908967", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031651_377764111242300_3292848422382229530_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6f_Yic3Yf18Q7kNvwE0HSSJ&_nc_oc=AdoA6o05tXyz4MHI1-MYFlsyKulHNxUwlUUdmsXjUXnNLsrJp4qtE0_fBQJObR3QhHo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NpCUlC8obla0FCe8Th-8jrWwz2vYJmirb3ZH1MzfmMw&oe=6A22FBE3"}, "display_name": "Mr. Bear's Bizarre Adventure", "keywords": [], "long_description": "This is the legendary about Mr. Bear, who challenging skilled opponents from various countries: \nthe guardian warrior at the Inari Shrine, the skeleton king in the dark dungeon and the pirate captain from the Caribbean sea....\nWe even adapted different music styles for each themed level: traditional Japanese sounds, Shamisen music, Lo-Fi, HipHop, Trap, and Reggae!\n\n----------------Game Introduction-----------------\nPlayers need to use different tactics to counter various enemy attack patterns. Engage in close combat, deflect projectiles from a distance, knock away explosives with both hands, and dodge bombs by sidestepping....\nBy the way, pay more attention to the corresponding colors and the direction of slashes. The color determines which sword you need to use.\n", "short_description": "This is a paradise for  rhythm and ACT lover. It's also a  legend about Mr. Bear."}]}, "devel
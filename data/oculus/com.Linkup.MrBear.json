cdn.com&_nc_ss=7f20f&oh=00_Af-gnEs3YHBdzUz8iFZojbixOiCmmyyq0PW00RII03Nj5A&oe=6A467F2C"}, {"file_name": "6.png", "id": "189253337552209", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75282159_189253340885542_1884713868086791800_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vr3CEyEvjVIQ7kNvwFfbX2d&_nc_oc=Ado0Nq6oNJA3tEm_797sGppdK0joOR4C7010x8jxF-1AiS_m09Lgj_f67LKoTDkuUyE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GgssgrR965eaMvt29GVScLM5L5UgLV1L9ZsfCKYsy2A&oe=6A467E98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_2560x1440.png", "id": "377764107908967", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031651_377764111242300_3292848422382229530_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6xFjjpe8M8Q7kNvwFJ6tLa&_nc_oc=AdoifFiN4OaI6prNAuqyu_gRKtTrCwrVpAmJnzCSR9a0T3TH2E-oN_M3RqbkPNiqss0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SI3nXAhnDvNxfWFUkayL9ekHBfEiLyTfh5iUD3sdicA&oe=6A465C23"}, "display_name": "Mr. Bear's Bizarre Adventure", "keywords": [], "long_description": "This is the legendary about Mr. Bear, who challenging skilled opponents from various countries: \nthe guardian warrior at the Inari Shrine, the skeleton king in the dark dungeon and the pirate captain from the Caribbean sea....\nWe even adapted different music styles for each themed level: traditional Japanese sounds, Shamisen music, Lo-Fi, HipHop, Trap, and Reggae!\n\n----------------Game Introduction-----------------\nPlayers need to use different tactics to counter various enemy attack patterns. Engage in close combat, deflect projectiles from a distance, knock away explosives with both hands, and dodge bombs by sidestepping....\nBy the way, pay more attention to the corresponding colors and the direction of slashes. The color determines which sword you need to use.\n", "short_description": "This is a paradise for  rhythm and ACT lover. It's also a  legend about Mr. Bear."}]}, "devel
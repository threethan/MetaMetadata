dxea0GYiwXpjfJ4PA&oe=69B9366C"}, {"file_name": "6.png", "id": "189253337552209", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75282159_189253340885542_1884713868086791800_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1-9TgBmUKMQ7kNvwEfxvgb&_nc_oc=Adlb9bSVetYQN824ikuJsg-wsirjBHrgWadOAulQGzViSWDYnWhFN9vcop-ojI3GHdA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzqHVPxfxNoHPTHerUQpqpYoPxRWWg1K85f-0y-ZIDI7Q&oe=69B935D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_2560x1440.png", "id": "377764107908967", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031651_377764111242300_3292848422382229530_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nd_vs-DOcdsQ7kNvwFfLsJB&_nc_oc=Adl7qAZvekTeFfzZHkUghK_yirfIDS0dUomCjhfWCsGVAx52_6OB3siWuXUnoQuYfbQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwDQOz4a9GR8KponUXLzcVYJMIVsdQ279gvwempP4tQgw&oe=69B94BA3"}, "display_name": "Mr. Bear's Bizarre Adventure", "keywords": [], "long_description": "This is the legendary about Mr. Bear, who challenging skilled opponents from various countries: \nthe guardian warrior at the Inari Shrine, the skeleton king in the dark dungeon and the pirate captain from the Caribbean sea....\nWe even adapted different music styles for each themed level: traditional Japanese sounds, Shamisen music, Lo-Fi, HipHop, Trap, and Reggae!\n\n----------------Game Introduction-----------------\nPlayers need to use different tactics to counter various enemy attack patterns. Engage in close combat, deflect projectiles from a distance, knock away explosives with both hands, and dodge bombs by sidestepping....\nBy the way, pay more attention to the corresponding colors and the direction of slashes. The color determines which sword you need to use.\n", "short_description": "This is a paradise for  rhythm and ACT lover. It's also a  legend about Mr. Bear."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupx
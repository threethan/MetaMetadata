cdn.com&_nc_ss=7f20f&oh=00_Af6aMMFfwM8wYCccDTvRHDin7d4AXzOnHAw7jkkQJPwViw&oe=6A11C32C"}, {"file_name": "6.png", "id": "189253337552209", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75282159_189253340885542_1884713868086791800_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpD5XG0wSDQQ7kNvwE9hzcC&_nc_oc=Adr5U7oYYYbkW0QsTPah8LszuRHft2Hs4vNZxpZZZnuhmhKrDHlFFumAbUT8EHhfRM0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5b9VvvhZJoLgfGrTLaVwAcy6gsgzdmz1tNqlGMsQ4eqQ&oe=6A11C298"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_2560x1440.png", "id": "377764107908967", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031651_377764111242300_3292848422382229530_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFkLe_c9T7UQ7kNvwFgBZhq&_nc_oc=AdouRau8L7ad5Rkt8UkF2amdz0khkSyVT_5bt7VA5i239V5jZIZp-e7H5ti1WLMkajs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7v4CWUS_DPiuiWKdktaAuBhe7Bu56VhPBtiJbH8FVsUw&oe=6A11A023"}, "display_name": "Mr. Bear's Bizarre Adventure", "keywords": [], "long_description": "This is the legendary about Mr. Bear, who challenging skilled opponents from various countries: \nthe guardian warrior at the Inari Shrine, the skeleton king in the dark dungeon and the pirate captain from the Caribbean sea....\nWe even adapted different music styles for each themed level: traditional Japanese sounds, Shamisen music, Lo-Fi, HipHop, Trap, and Reggae!\n\n----------------Game Introduction-----------------\nPlayers need to use different tactics to counter various enemy attack patterns. Engage in close combat, deflect projectiles from a distance, knock away explosives with both hands, and dodge bombs by sidestepping....\nBy the way, pay more attention to the corresponding colors and the direction of slashes. The color determines which sword you need to use.\n", "short_description": "This is a paradise for  rhythm and ACT lover. It's also a  legend about Mr. Bear."}]}, "devel
9773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974601_523203428823106_5519910950293255885_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KO6kllFxFAEQ7kNvwFvm4wP&_nc_oc=AdqfSUvbCbUsN1mW0q7zTDsQ89TOuifu0r69US2ebf0zWw47fiV9U4C74cBI2sw_Yy8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mhRadQGA48ITiXrWtjDqMOnuOuWTPRYISQqBsjBEytg&oe=69DF9370"}, "display_name": "Conjure Cards", "keywords": [], "long_description": "Conjure Cards places you in the world of Sun Shard, where magic flows through every aspect of life; even in a simple card game!\n\nSummon a wide variety of creatures and magic spells to face your opponents! Take their health points down to zero to win the game. Conjure Cards features multiplayer and singleplayer gameplay, and supports Hand Tracking allowing you to set the controllers down and still enjoy the game! This is an \"Early\" release of the game, with many more features, customizations, and exciting ways to play coming soon.", "short_description": "Take a seat at the table and face your opponent with magical cards that conjure creatures to fight for you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "SOCIAL", "RPG"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "support
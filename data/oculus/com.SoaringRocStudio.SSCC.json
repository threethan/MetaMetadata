78767325780288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpLvPvYQDV4Q7kNvwGBmSER&_nc_oc=AdpXT2R1cyId-0ACRx3mu3JZit3uho7qhqm5Cosr_NoMqVSsfkXbm8iBOH8zUZJh6nc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dNbuQ9y9ic1_vANqgvBP21gPQnDpk7DKjUSdjizvuHA&oe=6A393675"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cc2560-1440.png", "id": "523203425489773", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974601_523203428823106_5519910950293255885_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yE8WtsEeqt0Q7kNvwHbnnzP&_nc_oc=Ado-DlZ1aeo3m_Uti0z_zZB3-mBtGftAAXcj2cYxbdtbMIMm4t6x44WvLTgGa9k_RlE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9U-ghYkO02EVmbS09tHwcnoVHrzoc59anEuMP7axDYUQ&oe=6A393970"}, "display_name": "Conjure Cards", "keywords": [], "long_description": "Conjure Cards places you in the world of Sun Shard, where magic flows through every aspect of life; even in a simple card game!\n\nSummon a wide variety of creatures and magic spells to face your opponents! Take their health points down to zero to win the game. Conjure Cards features multiplayer and singleplayer gameplay, and supports Hand Tracking allowing you to set the controllers down and still enjoy the game! This is an \"Early\" release of the game, with many more features, customizations, and exciting ways to play coming soon.", "short_description": "Take a seat at the table and face your opponent with magical cards that conjure creatures to fight for you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscript
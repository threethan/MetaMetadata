lqaZovRdHnA-OVfQleMgHMw&oe=69984454"}, {"file_name": "IMG_2357.png", "id": "522663988858536", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031502_522663992191869_6854278767325780288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpravNgs5HkQ7kNvwFPhJud&_nc_oc=AdmiNpwDfaMQOANCBOm5YpFpDmItHBcoDkLwe9fML1m9FdjNv8vQ9DvVOs_drm5dfFM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfswjiGnx_j0DjSTHKwGwxaT0mW2xk4dobXnnB5CyzIx5A&oe=69985F75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cc2560-1440.png", "id": "523203425489773", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974601_523203428823106_5519910950293255885_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDJMtFc-0nQQ7kNvwErTmCS&_nc_oc=AdnTW0thqZC-dRF2na2hdag7jiGmTQ9cN2koKwWHF1umMhTcPoDDgN9rV_vAgMnnhvo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftqwyJ0gyH_UuzAHLPFKCGMmdjSxLUNetBuf_mGHYUH4Q&oe=69986270"}, "display_name": "Conjure Cards", "keywords": [], "long_description": "Conjure Cards places you in the world of Sun Shard, where magic flows through every aspect of life; even in a simple card game!\n\nSummon a wide variety of creatures and magic spells to face your opponents! Take their health points down to zero to win the game. Conjure Cards features multiplayer and singleplayer gameplay, and supports Hand Tracking allowing you to set the controllers down and still enjoy the game! Unlock new cosmetics to show off to your friends and enemies!\n\nThis is an \"Early\" release of the game, with many more features, customizations, and exciting ways to play coming soon.", "short_description": "Take a seat at the table and face your opponent with magical cards that conjure creatures to fight for you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.ne
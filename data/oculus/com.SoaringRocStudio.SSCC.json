GBZsXYnleP8dOcj4Z1U6A7hmaJhXN9ImF7pl4cloiy_WjdEI6Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsRFN5g_S4zAbKxLULgnyCux5BdjwUB7BmQRvAM6el--w&oe=699D8A54"}, {"file_name": "IMG_2357.png", "id": "522663988858536", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031502_522663992191869_6854278767325780288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thZ5lA0NkboQ7kNvwGHHf1R&_nc_oc=AdlA61wdoVHMlGT9C4LBm9ji9IY_vr0CYoutzF5XELnSC44Ngx9H-_PCglrR-hsWFn0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfurAF7BH1mOFe-lKKbek_Khp-H_sZSaMxo-YbaWHATnPQ&oe=699DA575"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cc2560-1440.png", "id": "523203425489773", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974601_523203428823106_5519910950293255885_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veWrQnotcuEQ7kNvwFFnTDM&_nc_oc=Adlt-Arpw6xo-Fh0Scl8BIC1M51MzPJKjH0thFwYQ4vn5QceX4kxXII5cLgrRGXamMo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsWMtaNrzt47bBidwwcD91jlBOf0Nv38Nl4Doa0saT64A&oe=699DA870"}, "display_name": "Conjure Cards", "keywords": [], "long_description": "Conjure Cards places you in the world of Sun Shard, where magic flows through every aspect of life; even in a simple card game!\n\nSummon a wide variety of creatures and magic spells to face your opponents! Take their health points down to zero to win the game. Conjure Cards features multiplayer and singleplayer gameplay, and supports Hand Tracking allowing you to set the controllers down and still enjoy the game! Unlock new cosmetics to show off to your friends and enemies!\n\nThis is an \"Early\" release of the game, with many more features, customizations, and exciting ways to play coming soon.", "short_description": "Take a seat at the table and face your opponent with magical cards that conjure creatures to fight for you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soaringrocstudio.net/policy", "developer_terms_of_servic
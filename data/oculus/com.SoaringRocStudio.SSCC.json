at conjure creatures to fight for you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "SOCIAL", "RPG"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "482742806556303"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974466_262502208964932_6386588971231039312_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhvJ85laCSQQ7kNvwEiCNr9&_nc_oc=AdqH7U7-OzJh_bIjDdUW1dfFlshx7-Ag8nRSW2JRV_Vmls-n235NawO0Rbdd6UL3_HY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dSbgILJWoILp9mF4QS7QKtYdrjJYpUXHmEVpaocCz-Q&oe=69D6361A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Conjure Cards", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Tabletop", "id": "1676485315806614"}], "release_date": 1624019400, "lastRevision": {"nodes": [{"id": "354067082716366", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4266114700112087", "is_first_party": 
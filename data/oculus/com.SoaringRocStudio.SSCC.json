_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncf3E--KnJQQ7kNvwGcmXuH&_nc_oc=AdpqrhI6gtKdXRxNg6-5fNCr-Pn3qJW5-tqUVJ1-wBe94ST4JK8dv9As3r32ve9YkoI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vc9Ld7NPUlo7X6aPtkek5uL_b_YhdDQkzXazyeFqvlw&oe=6A3541F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cc2560-1440.png", "id": "523203425489773", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974601_523203428823106_5519910950293255885_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PuVvkGTyz9IQ7kNvwEAr4yn&_nc_oc=Adoq2Up29wQc0ZecoEujWreTE0K31RvwQI8spNK2Y74_EnRzAgXfByQXoUPgA-HcaKk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ysySTAU7adOz2f6Os4bhkV4NEaTHPm4SVuQXCjX8n7w&oe=6A3544F0"}, "display_name": "Conjure Cards", "keywords": [], "long_description": "Conjure Cards places you in the world of Sun Shard, where magic flows through every aspect of life; even in a simple card game!\n\nSummon a wide variety of creatures and magic spells to face your opponents! Take their health points down to zero to win the game. Conjure Cards features multiplayer and singleplayer gameplay, and supports Hand Tracking allowing you to set the controllers down and still enjoy the game! This is an \"Early\" release of the game, with many more features, customizations, and exciting ways to play coming soon.", "short_description": "Take a seat at the table and face your opponent with magical cards that conjure creatures to fight for you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_
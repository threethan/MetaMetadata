2606006346427_445763431883610110_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3W2TbYHXwAQ7kNvwE_NLxf&_nc_oc=Ado8-14DctAXDrdeb6MjJMyPDALJNuAKNvacSodU1TJtMi45IfcNapetDZx4bJBZNMc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwP52Addw5zM8vuPw4DBrq0cCDJTDtQN9pcQHYVuamxNQ&oe=69CE51D4"}, {"file_name": "IMG_2357.png", "id": "522663988858536", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031502_522663992191869_6854278767325780288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6dmzdABlMoEQ7kNvwH2oUT8&_nc_oc=AdoNWRwotAou4R9C5PMz6Tq2mI9NzlGMAsk0PLNPuYqwNq17iLtsb3Lw0Lk2WrUKCA4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzivuazaZlT6pWq5ocQ0JEE_wACY3rJ-HMOrONdKgv59w&oe=69CE6CF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cc2560-1440.png", "id": "523203425489773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974601_523203428823106_5519910950293255885_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ik_hvNeHt5wQ7kNvwGvriQV&_nc_oc=AdrXV2eZsjitZVPH3hJ5pRN4AyI_KkwhkSJd_xLXCCEASpYJTm3jS3H9wZgVDwKXpnQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZ_8wgFtKNHU58TYoIoCiBaq0xxflshJ2gB3jlOmkZ8g&oe=69CE6FF0"}, "display_name": "Conjure Cards", "keywords": [], "long_description": "Conjure Cards places you in the world of Sun Shard, where magic flows through every aspect of life; even in a simple card game!\n\nSummon a wide variety of creatures and magic spells to face your opponents! Take their health points down to zero to win the game. Conjure Cards features multiplayer and singleplayer gameplay, and supports Hand Tracking allowing you to set the controllers down and still enjoy the game! Unlock new cosmetics to show off to your friends and enemies!\n\nThis is an \"Early\" release of the game, with many more features, customizations, and exciting ways to play coming soon.", "short_description": "Take a seat at the table and face your opponent with magical cards th
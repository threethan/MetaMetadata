2606006346427_445763431883610110_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMv6FlBoEYwQ7kNvwEAdmuW&_nc_oc=AdrqGrOW7Z5Ly0cDeRoa8Pz_cBTqqVtExJic1Y7RYj06p4ERzbqJqUDkuc1DLgcSxAA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwBYFg213WDJba-APvHFG_ak6GpVWtE_QP3b7MEhdHfyA&oe=69C90BD4"}, {"file_name": "IMG_2357.png", "id": "522663988858536", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031502_522663992191869_6854278767325780288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9Ob2uaoynYQ7kNvwHcDOUz&_nc_oc=Adr5upv6QCqfHQFyHZ390ApoaeCf2WXSDVNkoZMHphrr7zDhCaPw0MVCwtl_SL2FiQ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz72Auv59CIfE-xRkwZKNWDHxJKW0klnRzH-CCRVVVviA&oe=69C926F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cc2560-1440.png", "id": "523203425489773", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974601_523203428823106_5519910950293255885_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yy4VlTPklykQ7kNvwFAVTwp&_nc_oc=AdpEP9KXP8qwPvqJ3HXjgUZgZIjmUnhGlUmWHxteH7BMWU1xcRtCXVc2S9NzeOOIMv0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKaE0hyXGDHt4czYBFkJFqPKMIRyoh_II2E_IpeTpdhw&oe=69C929F0"}, "display_name": "Conjure Cards", "keywords": [], "long_description": "Conjure Cards places you in the world of Sun Shard, where magic flows through every aspect of life; even in a simple card game!\n\nSummon a wide variety of creatures and magic spells to face your opponents! Take their health points down to zero to win the game. Conjure Cards features multiplayer and singleplayer gameplay, and supports Hand Tracking allowing you to set the controllers down and still enjoy the game! Unlock new cosmetics to show off to your friends and enemies!\n\nThis is an \"Early\" release of the game, with many more features, customizations, and exciting ways to play coming soon.", "short_description": "Take a seat at the table and face your opponent with magical cards th
2606006346427_445763431883610110_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVy6XHadRKAQ7kNvwGDub8H&_nc_oc=AdrnftrGKehSKzPxX97DYAvAqtwY1nXEXD1nvv8uWioLs9hcavNqNbefIevtXq8iRf8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GBK7kGQJZQSs5lSty1r8WKCxfU1uk2ccNXssdmA72YA&oe=69D4E954"}, {"file_name": "IMG_2357.png", "id": "522663988858536", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031502_522663992191869_6854278767325780288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFk_AWMzchAQ7kNvwFCFE9c&_nc_oc=AdqSev240sycaLn5UVGej2hmCSaGiJVdUHx7nR0nUaIeM8dYtDLp3Ty-2Pka358Kdzs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hwg_TZNtuA22MZKkcK4EBNVC7movqO6w-S3wXZaWwPg&oe=69D50475"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cc2560-1440.png", "id": "523203425489773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974601_523203428823106_5519910950293255885_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MonM0wCDp2cQ7kNvwEQBpfN&_nc_oc=AdpZMDxDXNdWcXbeWDH9eqkcNemATOrXOpnaCErvpN0nSuAVBrH_zNbRKeOJOU1QYhI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wnUkvGTDndHkkyN-LOReTsVByPp07LTBc1lTvQmQZnQ&oe=69D50770"}, "display_name": "Conjure Cards", "keywords": [], "long_description": "Conjure Cards places you in the world of Sun Shard, where magic flows through every aspect of life; even in a simple card game!\n\nSummon a wide variety of creatures and magic spells to face your opponents! Take their health points down to zero to win the game. Conjure Cards features multiplayer and singleplayer gameplay, and supports Hand Tracking allowing you to set the controllers down and still enjoy the game! Unlock new cosmetics to show off to your friends and enemies!\n\nThis is an \"Early\" release of the game, with many more features, customizations, and exciting ways to play coming soon.", "short_description": "Take a seat at the table and face your opponent with magical cards that conjure creatures to fight for you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "SOCIAL", "RPG"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "482742806556303"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974466_262502208964932_6386588971231039312_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlHjUL2KP8YQ7kNvwFHGL4V&_nc_oc=AdrF3xubXPowajpiKAxQeB2SXPHMFLr3nL-BowbtCpWp1xvd50bR6uXVC05sXpkC0EM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AOXuqLbOoUDDXZw-2rep7VTkuIFO9JU1GY6T8PAFBGQ&oe=69D4E49A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Conjure Cards", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Tabletop", "id": "1676485315806614"}], "release_date": 1624019400, "lastRevision": {"nodes": [{"id": "354067082716366", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4266114700112087", "is_first_party": 
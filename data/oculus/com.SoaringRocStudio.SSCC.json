CbekK3OKHx-rkemLXKT2QaSGoVBC0_xEtJ_LLwG6Z2QLGjrldo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvMy7qWfHYRBf-0DlkGR_O1NTgwGJ8LPy8Ale-2LV_Caw&oe=69A6C4D4"}, {"file_name": "IMG_2357.png", "id": "522663988858536", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031502_522663992191869_6854278767325780288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQuMVvLPDvoQ7kNvwE_KOjw&_nc_oc=AdlPrpJV-GyuHAPwwfmOnX9It1Z82o02CCBReqEi5MBGsWA5O7G1g8hM9Z8Y485-NKg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsD5ldDChA3s2h3FTxtXdhB-YOEa8ycDTUI8GBVUl9E9g&oe=69A6DFF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cc2560-1440.png", "id": "523203425489773", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974601_523203428823106_5519910950293255885_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tp13jU9aHBIQ7kNvwF2bu1M&_nc_oc=AdmGQrMLq8TiKVUnZiF1xCghaWxMuE1o1vZvH9tww6Dp10uSCkyDPL3wKX9Qo0BJ4FQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afup2PilVaVyIsmHARe5oAJ3XyxzHinbuH7Jq4vWlXxvcA&oe=69A6E2F0"}, "display_name": "Conjure Cards", "keywords": [], "long_description": "Conjure Cards places you in the world of Sun Shard, where magic flows through every aspect of life; even in a simple card game!\n\nSummon a wide variety of creatures and magic spells to face your opponents! Take their health points down to zero to win the game. Conjure Cards features multiplayer and singleplayer gameplay, and supports Hand Tracking allowing you to set the controllers down and still enjoy the game! Unlock new cosmetics to show off to your friends and enemies!\n\nThis is an \"Early\" release of the game, with many more features, customizations, and exciting ways to play coming soon.", "short_description": "Take a seat at the table and face your opponent with magical cards that conjure creatures to fight for you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soaringrocstudio.net/policy", "developer_terms_of_servic
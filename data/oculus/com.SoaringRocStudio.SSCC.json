2606006346427_445763431883610110_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiWhqDkiHSoQ7kNvwG9kXSK&_nc_oc=AdqdUvxwoLHAvV19ae-bt65VBu8sRTsoUzRT4OPbzLY-iBWg7xf637lkHOrM-WmaSbA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01MShSA7udX4D9e0AAwSfYTYym0ulOHVEMBC4JzzBUmQ&oe=69DA2F54"}, {"file_name": "IMG_2357.png", "id": "522663988858536", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031502_522663992191869_6854278767325780288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XnELykNSSRkQ7kNvwHhw452&_nc_oc=Adr6SoyY-VlI1DD0ekZQhsNBv9RlxeMzkYkzLYG7bg6RqGwmPUe9SA48L5Xi2Nqq6-o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VqUADlt5tG-Y-PUE7_XQ4ON7ZOw3GpaZQHB-iW9tCgA&oe=69DA4A75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cc2560-1440.png", "id": "523203425489773", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974601_523203428823106_5519910950293255885_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ES7PKC5shRoQ7kNvwEhK-ue&_nc_oc=AdpUg73dXaUJ5tg9Fd_xcQh_YWWHOxuGfVG6uSJgTpqqq4uq9saZQCI2Ec3SOnhKLtk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FlhQ_NpUCThD0217VKwq91fowHIb3gy33pBEG8sMWzg&oe=69DA4D70"}, "display_name": "Conjure Cards", "keywords": [], "long_description": "Conjure Cards places you in the world of Sun Shard, where magic flows through every aspect of life; even in a simple card game!\n\nSummon a wide variety of creatures and magic spells to face your opponents! Take their health points down to zero to win the game. Conjure Cards features multiplayer and singleplayer gameplay, and supports Hand Tracking allowing you to set the controllers down and still enjoy the game! Unlock new cosmetics to show off to your friends and enemies!\n\nThis is an \"Early\" release of the game, with many more features, customizations, and exciting ways to play coming soon.", "short_description": "Take a seat at the table and face your opponent with magical cards that conjure creatures to fight for you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "SOCIAL", "RPG"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "482742806556303"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974466_262502208964932_6386588971231039312_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rqvYh3_XSMQ7kNvwGh-pTg&_nc_oc=Adr2gm7RdeqtqoNbXTzBY105JNWqYAm70rBc_X2-zJxj37ycnnHbdDMZyrJxh4QG7Nw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26mmBXd6VYccX07EL2OmjeVlouEcjiXQDlL_t9X1dQ8A&oe=69DA2A9A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Conjure Cards", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Tabletop", "id": "1676485315806614"}], "release_date": 1624019400, "lastRevision": {"nodes": [{"id": "354067082716366", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4266114700112087", "is_first_party": 
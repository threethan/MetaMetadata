_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYx3uMSoCrkQ7kNvwGdazHC&_nc_oc=Adr6vxzR_-BTBH5wzc4TS4Qp83Y2old-SHXHTJa4Tyq56q5FH8Hq3I86zwernsfrOqo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmhW6_ZDDMC_v2I6SRWKBFW-urkzZjoj-REjk5qFMLzg&oe=6A64B7F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cc2560-1440.png", "id": "523203425489773", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974601_523203428823106_5519910950293255885_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JG0sFV1Lvp0Q7kNvwHKJeLb&_nc_oc=AdrQp3XE8jozn2pgIJcKL0y7BQO_MenqVfnHLFvf25Lhql3t4jOeUFcm3sLmT1dfLso&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBb_TV4uocWmJyGvC-fTb6P2-Yyx9FnnMBX4v9VjCCK0g&oe=6A64BAF0"}, "display_name": "Conjure Cards", "keywords": [], "long_description": "Conjure Cards places you in the world of Sun Shard, where magic flows through every aspect of life; even in a simple card game!\n\nSummon a wide variety of creatures and magic spells to face your opponents! Take their health points down to zero to win the game. Conjure Cards features multiplayer and singleplayer gameplay, and supports Hand Tracking allowing you to set the controllers down and still enjoy the game! This is an \"Early\" release of the game, with many more features, customizations, and exciting ways to play coming soon.", "short_description": "Take a seat at the table and face your opponent with magical cards that conjure creatures to fight for you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_
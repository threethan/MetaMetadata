5/499620655_2166980560890147_790894977733765108_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44Bx_9m07IcQ7kNvwHLr_lk&_nc_oc=Adrlkd8rZGKrs75K34OcBtIB5jmOPoMMHOJwtPI-FRQoH0wmBq6SIDI3cjbpDM4iI_s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5D-RmWhlvwexU18q0xyMw2Lf4UBGE_gZ5lVeBL0sPrA&oe=6B06F86B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape.png", "id": "2037243506976878", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623565_2037243513643544_6777129718331561596_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkW0MaHQlUEQ7kNvwG8UVuK&_nc_oc=AdqnGZdkKlS49rpeklK6a_CSrtxxL7ki9jMduTt8VD3EO5Wsy9jGd1EuElsxYiflDDE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN3GDGJSUsboWwjtrsd3x2LjrUIa3nS07LLyEI1M-GPg&oe=6B070169"}, "display_name": "Campfire Simulator", "keywords": ["camping", "relaxing", "fire", "cozy", "nature"], "long_description": "Campfire Simulator is a relaxed physics-based fire-building sim. You're camping alone in the woods on a quiet night. Using wood and paper, build a fire, and then light it by banging two rocks together (or use the lighter if you're lazy).\n\nYou've also got an axe, your guitar, gear to make a hot drink and toast marshmallows, and a few other things. Make a small fire and do some cooking, or set the whole forest ablaze if you're feeling reckless.\n\n* Walk around you small campsite and chop down nearby trees for extra fire wood. \n* Gaze at the beautiful stars in the night sky\n* Spot deer roaming in the woods nearby\n* Watch a fox cautiously approach as you stay still enough. \n\nThere's really no rules, winning, or losing. It's just the relaxed night in the woods you've been waiting for.", "short_description": "Build, light and tend a realistic campfire. Chop wood, brew tea, toast marshmallows and play guitar under the stars."}]}, "developer_name": null, "developer_privacy_policy_url": "https
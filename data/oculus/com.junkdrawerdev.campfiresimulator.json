OPiDegi5gtzSRlHn6xkzsfPTWPI6ixdlsbvHEP09A&oe=6B006E25"}, {"file_name": "burning-tree-falling-2.png", "id": "2490779205074585", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619602_2490779208407918_1484290897398583878_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BImcCBPpDowQ7kNvwFpyGhc&_nc_oc=Adrv0T9ep3YeW3q0Sm_lawpQxWx6gKK7HCMbkG-chAcO-SAwj06m1yNLfEp9Jt6yy24&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShdBzyfbzlD-IFkW0YIFxKqTKdt4pRb0ci3jfmbuA_bA&oe=6B006EAF"}, {"file_name": "03-from-the-tent.png", "id": "2166980557556814", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620655_2166980560890147_790894977733765108_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLfcQ4y4KkIQ7kNvwHcfVlW&_nc_oc=AdquKbOWiBkSGmOAVKY0Ui6386aK8J541aMGbwjSXWLwz2PmnRkETbt0vfIt-sVK0Ss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMp_rQTySSjvNM-mYjMHZ_FG1mdKI_8Gs6AC-9R_UNCQ&oe=6B0060EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape.png", "id": "2159622807990882", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622916_2159622814657548_217850951069148632_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxQ-rNz-EYIQ7kNvwH0yFGQ&_nc_oc=AdpexBjWBsqCcFKzbenD1aph1D-lw4uKWs3-X5_YkKBCW4VrpWjers3HmHX0Oi5a27Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2k0TPTzm8CetHtcNW7OW49lS3lQVeFf4wYsHOTwZWaw&oe=6B006C5D"}, "display_name": "Campfire Simulator", "keywords": ["camping", "relaxing", "fire", "cozy", "nature"], "long_description": "Campfire Simulator is a relaxed physics-based fire-building sim. You're camping alone in the woods on a quiet night. Using wood and paper, build a fire, and then light it by banging two rocks together (or use the lighter if you're lazy).\n\nYou've also got an axe, your guitar, gear to make a hot drink and toast marshmallows, and a few other things. Make a small fire and do some cooking, or set the whole forest ablaze if you're feeling reckless.\n\n* Walk around you small campsite and chop down nearby trees for extra fire wood. \n* Gaze at the beautiful stars in the night sky\n* Spot deer roaming in the woods nearby\n* Watch a fox cautiously approach as you stay still enough. \n\nThere's really no rules, winning, or losing. It's just the relaxed night in the woods you've been waiting for.", "short_description": "Build, light and tend a realistic campfire. Chop wood, brew tea, toast marshmallows and play guitar under the stars."}]}, "developer_name": null, "developer_privacy_policy_url": "https://campfire-simulator.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "JunkDrawerDev", "support_website_url": "https://campfire-simulator.pages.dev/about#support", "website_url": "https://campfire-simulator.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1493430930509531"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619602_1368997378461533_5931766444106499412_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrSqFVZlIrcQ7kNvwFHnyVu&_nc_oc=AdrW2yRpek_hKPYgTGQmN0rHsaBx5JbNcWpu3UIZm5mKLfHeZS6ncg_MG1kcMGsvCFA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculusc
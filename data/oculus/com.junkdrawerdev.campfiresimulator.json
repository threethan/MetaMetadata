YNK-TcHPcYOB5iCwqlU9eX4fP6_IRi8a5oY4Bcy9A&oe=6B0C83E5"}, {"file_name": "burning-tree-falling-2.png", "id": "2490779205074585", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619602_2490779208407918_1484290897398583878_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdcJK2Az_ZYQ7kNvwFPpzCw&_nc_oc=AdouduD4S3LmaO1d2WqpW2qRhYTt51S-644pNO_6NNMHnaV8Aq2-1St8xilCOsrmYZc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRsFgcLNpMG4FmEvQh5_LZlvZR_rHcogYgv4rzLia-_cQ&oe=6B0C846F"}, {"file_name": "03-from-the-tent.png", "id": "2166980557556814", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620655_2166980560890147_790894977733765108_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-t6ScAFF1IQ7kNvwHNLckL&_nc_oc=AdqLy48OnIJn_Pysfahe-OrcNerfLPa2QeUJRKBttnioOMUBFsWEAiiJwf47wmdhXVc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSFXjFGwHoTpbPw1Kw4iGY-A8lWak-d4BHzEugDR-2-8g&oe=6B0C76AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape.png", "id": "2159622807990882", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622916_2159622814657548_217850951069148632_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Ayza4rhlh0Q7kNvwHBm1KZ&_nc_oc=AdqBbpSWhJbc7Xl8o4laDEoBHNzEx6wJMQcbB2iv6Q9EHPgE5w-W37CGZm96fAzN8bE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQZgBSmJAX5tXrDXHqcdFJlGxjniko8_0yWvdmu_PxSYQ&oe=6B0C821D"}, "display_name": "Campfire Simulator", "keywords": ["camping", "relaxing", "fire", "cozy", "nature"], "long_description": "Campfire Simulator is a relaxed physics-based fire-building sim. You're camping alone in the woods on a quiet night. Using wood and paper, build a fire, and then light it by banging two rocks together (or use the lighter if you're lazy).\n\nYou've also got an axe, your guitar, gear to make a hot drink and toast marshmallows, and a few other things. Make a small fire and do some cooking, or set the whole forest ablaze if you're feeling reckless.\n\n* Walk around you small campsite and chop down nearby trees for extra fire wood. \n* Gaze at the beautiful stars in the night sky\n* Spot deer roaming in the woods nearby\n* Watch a fox cautiously approach as you stay still enough. \n\nThere's really no rules, winning, or losing. It's just the relaxed night in the woods you've been waiting for.", "short_description": "Build, light and tend a realistic campfire. Chop wood, brew tea, toast marshmallows and play guitar under the stars."}]}, "developer_name": null, "developer_privacy_policy_url": "https://campfire-simulator.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "JunkDrawerDev", "support_website_url": "https://campfire-simulator.pages.dev/about#support", "website_url": "https://campfire-simulator.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1493430930509531"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619602_1368997378461533_5931766444106499412_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCvk71QuZb4Q7kNvwFsKwDF&_nc_oc=AdppBxxPhqC6RfYmqM-XAv_pMF2kf74oNhnSrc6c0Wqv8_c9jKTH4f5qYOdWjFXj6FE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculusc
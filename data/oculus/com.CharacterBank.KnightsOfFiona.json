i": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623443_2031371674274318_8386471399098698822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KueNpSAxxBYQ7kNvwEowfWi&_nc_oc=AdqKTYcJdoeBaiYKCs6sSgtTCHrmRSmdV9ZylODvNnwIggZAVqQRxklU6snc_Rkv5rM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI44JBdUUJtw-qFr5qkDYgdO_AYNHq_notzlprxAVfDrQ&oe=6AB3DA8F"}, "display_name": "Knights of Fiona", "keywords": ["anime", "roleplayinggame", "dragons", "fantasy", "swords"], "long_description": "\u201cKnights of Fiona\u201d brings players to the vibrant world of Gallia where they join Fiona and her sworn knights to fight against an ancient evil threatening the safety of the realm. Players can adventure either solo or with two friends as they embark on this epic quest.\n\n# Key Features\n\n- A Deep Character-Driven Story: Enjoy a hand crafted narrative experience. Interact with a deep roster of unique NPCs, pushing the limit of what is possible in VR.\n\n- Live Your Fantasy: Explore the city of Gallia from its train station to seaside ports. Adventure throughout the lands as you fight against hordes of enemies.\n\n- Epic Boss Battles: Restore justice to the land as your tackle fierce dragons.", "short_description": "Fierce dragons have emerged in the land of Gallia. Join Fiona and her sworn knights to protect the kingdom! Embark on quests solo or with friends as you fight against the darkness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://characterbank.atlassian.net/wiki/external/NDJmMGU0NTQ0YmNkNGM1OGI3NTVkNWQ0NzYxZDMzNzc", "developer_terms_of_service_url": null, "publisher_name": "CharacterBank Inc.", "support_website_url": null, "website_url": "https://character-bank.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id
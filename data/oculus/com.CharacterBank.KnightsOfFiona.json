7kNvwHcWGfd&_nc_oc=AdrEZnJ65lD6d6jGn0-QrU06NMmAOZSJ08JWfJcI8-EOfDoNY2VlauNAj5Zzbem1hF8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBeLlqnVrse04w3Kyam_cuax7HPc10rfJakbkxWPqZ5A&oe=6AAD4509"}, {"file_name": "KnightsofFiona-2.png", "id": "1008784115284620", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623400_1008784118617953_8183366980713401361_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16-j_WH8TC4Q7kNvwF5cCXa&_nc_oc=Ado5NbXIfeDk-KdyYqDH6fMEJlPUzBgbnJLxZXT_stcb3kwOb8l0KWTCKIvSzBQ0QBE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJxzqYmp8SxkCT3Qsu3Wnk6tGci0DfAsTyFjxwjFGtIw&oe=6AAD41DF"}, {"file_name": "KnightsofFiona-6.png", "id": "997658306631476", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623384_997658309964809_2840937849806024473_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBV6N80uAnwQ7kNvwGhDuv-&_nc_oc=Adq-SdX5NxWkLvzJp50BDVwBzm8epsL6-c8LilgLC2494bTvHoUJi3J4YFsFU3-fIIw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIArEKrQnQBHlDxoqTosSwYveYu0dlQgkvnMQjqaFsP7A&oe=6AAD400B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2569x1440_KoF.png", "id": "2031371670940985", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623443_2031371674274318_8386471399098698822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VQUV6KMGw8Q7kNvwHd088l&_nc_oc=AdoxAP2SbLxqTXIHv2NwNY7XQIW8wV9LalISkcImmqEFxTtFqpCIaYdMjEdizZYqtas&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTVhQRF8YfmIAYnUD4dTL5EI63gd2GB_ZdjaJw5CtK7w&oe=6AAD430F"}, "display_name": "Knights of Fiona", "keywords": ["anime", "dragons", "fantasy", "narrative", "Japanese"], "long_description": "# Team up, gear up, and fight for Gallia.\nTake on arena battles in a JRPG-style VR action RPG with online co-op for up to 3 players.\n\nIn Gallia, thoughts become power. Knight Commander Fiona has sworn her Gesh\u2014a binding oath that transforms hope into power.\n\n{2806835839715744}\n\nStand with Fiona and the people of Gallia, harness the power of her Gesh, and fight back against the hatred consuming their homeland.\n\n# Fight Together in 3-Player Online Co-op\n{1551316092815388}\n\nWield swords, bows, and magic in action-packed arena battles. Collect gear, grow stronger, and team up with up to two other players to take down powerful enemies and formidable bosses.\n# Start Your Adventure for Free\n\n\nPlay all of Chapter 1 for free, including both story quests and battle quests.\nCreate your character, jump into battl right away.\n\n*To unlock Chapter 2 and beyond, as well as certain features, players will need to purchase a \"Story Pass\" or \"Story Tickets.\"\n\n# Step Into the Story\n{4539518626329286}\nCome face-to-face with a memorable cast and experience dramatic moments and unexpected twists as Gallia\u2019s story unfolds around you.\nBe a part of this legendary tale and bring peace to the land.\n\n# A Story Told Across 6 Chapters\nFollow Fiona and the people of Gallia through her adventure.\nChapters 1\u20135 are available now. Chapter 6 is coming soon.\n\nLook forward to seasonal events and gameplay updates as the world of Gallia continues to grow.\n\nSwear your oath. Fight for Fiona's Gesh.\n# Join Our Community\nMeet fellow adventurers and stay up to date on our official Discord.\nDiscord.gg/characterbank\n\n\n{2273825473472511}\n\n", "short_description": "A sworn-bond VR JRPG from Japan. Stand beside Knight Commander Fiona and fight dragons in a hundred-year war where thoughts become power \u2014 solo with companions, or online with up to two friends as three sworn knights."}]}, "developer_name": null, "developer_privacy_policy_url": "https://characterbank.atlassian.net/wiki/external/NDJmMGU0NTQ0YmNkNGM1OGI3NTVkNWQ0NzYxZDMzNzc", "developer_terms_of_service_url": null, "publisher_name": "CharacterBank Inc.", "support_website_url": null, "website_url": "https://character-bank.com/", "category": "GAMES", "comfort_rating":
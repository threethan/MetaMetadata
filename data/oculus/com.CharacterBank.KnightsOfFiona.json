_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eb3Hhji0Y5UQ7kNvwHWA2Uf&_nc_oc=AdqQtqwsBV9Zad11eo2Jj_zUjJVe309CMXa2D7R8V2QGMnqtVHgornM_DCof5XjIA2s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT4B4cmxI1RfnguMM1ZZ6OKR6srCpC9TCXDX54f8tpw9Q&oe=6B0C6949"}, {"file_name": "Story2.png", "id": "1595313882283753", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628411_1595313888950419_4485845558801043242_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6t4IOA-bCu4Q7kNvwGZNNJK&_nc_oc=AdrKAdo6ZHnbvAu2w72tOvhIvUJaaWEf0Y8dNlppgENcYAqfboN3ri37we4c3XTHH5g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ1PguVC8F2uqlGO6crO3Wu0x5ElZHy4hv3-1iwnsDe_w&oe=6B0C83E3"}, {"file_name": "KnightsofFiona-6.png", "id": "997658306631476", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623384_997658309964809_2840937849806024473_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Um54lZaoUXgQ7kNvwE06IXH&_nc_oc=AdoBEpIutJjDpA0Fx4P4-1O_Sq-Jzs86cWI_jeKXITy1uALbnzgkYIsDG9LU1nUyV1Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQYRjj7DzvwUOcfind2sGL0c5T61vlxg3WUaozGj5YkOg&oe=6B0C644B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2569x1440_KoF.png", "id": "2031371670940985", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623443_2031371674274318_8386471399098698822_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7szYf7h9WmQQ7kNvwFxgahP&_nc_oc=AdosS6F0jDDed1IVUx_kS_9DI3vyi9hH3SAr-OHtENQrrMLJF9qjIaZe8VT4aENjJ9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQWINQV8svLLhNZ0cKhZH0YIXSbBAOqG1tXByfvwVgvWg&oe=6B0C674F"}, "display_name": "Knights of Fiona", "keywords": ["anime", "dragons", "fantasy", "narrative", "story"], "long_description": "# Team up, gear up, and fight for Gallia.\nTake on arena battles in a JRPG-style VR action RPG with online co-op for up to 3 players.\n\nIn Gallia, thoughts become power. Knight Commander Fiona has sworn her Gesh\u2014a binding oath that transforms hope into power.\n\n{2806835839715744}\n\nStand with Fiona and the people of Gallia, harness the power of her Gesh, and fight back against the hatred consuming their homeland.\n\n# Fight Together in 3-Player Online Co-op\n{1551316092815388}\n\nWield swords, bows, and magic in action-packed arena battles. Collect gear, grow stronger, and team up with up to two other players to take down powerful enemies and formidable bosses.\n# Start Your Adventure for Free\n\n\nPlay all of Chapter 1 for free, including both story quests and battle quests.\nCreate your character, jump into battle right away.\n\n*To unlock Chapter 2 and beyond, as well as certain features, players will need to purchase a \"Story Pass\" or \"Story Tickets.\"\n\n# Step Into the Story\n{4539518626329286}\nCome face-to-face with a memorable cast and experience dramatic moments and unexpected twists as Gallia\u2019s story unfolds around you.\nBe a part of this legendary tale and bring peace to the land.\n\n# A Story Told Across 6 Chapters\nFollow Fiona and the people of Gallia through her adventure with all storied content now available!\n\nLook forward to seasonal events and gameplay updates as the world of Gallia continues to grow.\n\nSwear your oath. \n# Join Our Community\nMeet fellow adventurers and stay up to date on our official Discord.\nhttp://knights-of-fiona.com/discord\n\n\n{2273825473472511}\n\n", "short_description": "A sworn-bond VR JRPG from Japan. Stand beside Knight Commander Fiona and fight dragons in a hundred-year war where thoughts become power \u2014 solo with companions, or online with up to two friends as three sworn knights."}]}, "developer_name": null, "developer_privacy_policy_url": "https://knights-of-fiona.com/en/privacy", "developer_terms_of_service_url": "https://knights-of-fiona.com/en/terms", "publisher_name": "CharacterBank Inc.", "support_website_url":
n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyRLCZHjcaEQ7kNvwHQhZi0&_nc_oc=AdrcGTz1LTXzDu2KIc8qeVX18EVucBkcIs1sz9fW8el2WwgUVW8-4YZkwkviBElk_54&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW20f9vvATsV6qH5BhQDecrebb2YwUsOfg5_7O627HSsg&oe=6B104571"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2569x1440_KoF.png", "id": "2031371670940985", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623443_2031371674274318_8386471399098698822_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y29U5QGnA-0Q7kNvwHJm8mt&_nc_oc=AdoarxySITB4Fvtej7Bk0aO0gqXT4H_Udqfb_vag6AUCFsUIabkC6dVVdcfw5hk8S48&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXFn7gZ88FnIJvBqtHjVmLycbDBtfbYQEM44A6QH75rOA&oe=6B105BCF"}, "display_name": "Knights of Fiona", "keywords": ["anime", "roleplayinggame", "dragons", "fantasy", "swords"], "long_description": "\u201cKnights of Fiona\u201d brings players to the vibrant world of Gallia where they join Fiona and her sworn knights to fight against an ancient evil threatening the safety of the realm. Players can adventure either solo or with two friends as they embark on this epic quest.\n\n# Key Features\n\n- A Deep Character-Driven Story: Enjoy a hand crafted narrative experience. Interact with a deep roster of unique NPCs, pushing the limit of what is possible in VR.\n\n- Live Your Fantasy: Explore the city of Gallia from its train station to seaside ports. Adventure throughout the lands as you fight against hordes of enemies.\n\n- Epic Boss Battles: Restore justice to the land as your tackle fierce dragons.", "short_description": "Fierce dragons have emerged in the land of Gallia. Join Fiona and her sworn knights to protect the kingdom! Embark on quests solo or with friends as you fight against the darkness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://characterbank.atlassian.net/wiki/external/NDJmMGU0NTQ0YmNkNGM1O
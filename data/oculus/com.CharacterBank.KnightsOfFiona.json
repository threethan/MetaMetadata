_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4n-6buAsLQQ7kNvwGVTpRl&_nc_oc=Adq1m9lcJ1Ir_Q0exI1zmWV4Oxgy6ECAXAmJODfa_2gNndQrol3Zl3BrBH4S3RRkuH0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVg5BmONVfthipu1L6qyf1nXaJHH3MshuJcAjgAMIWFnQ&oe=6B105DC9"}, {"file_name": "Story2.png", "id": "1595313882283753", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628411_1595313888950419_4485845558801043242_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMIYe2MrUgAQ7kNvwHcJN46&_nc_oc=Adr8QH0k41kNlyk8pjdCpUvJLYrB5C2p2pvRbXGOAWrvn7iAuTbJ7d1eRVikT9Rbd_g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWudPO3xdCyPrgzuoc7jg6PL87ddPUSpUXlMugimyienw&oe=6B104023"}, {"file_name": "KnightsofFiona-6.png", "id": "997658306631476", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623384_997658309964809_2840937849806024473_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IH9bRVoGnSkQ7kNvwHyfrWY&_nc_oc=AdpCFnh6AlXGsk2KSykeZXiFKwmG7x6pyM17L_WqEMXimW7eQkvAqC1prbQ-xW_SmUU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUhzQYFu_MneP36NGlIKPv0FNCUDHR_WBOo5sxDS4uWDQ&oe=6B1058CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2569x1440_KoF.png", "id": "2031371670940985", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623443_2031371674274318_8386471399098698822_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y29U5QGnA-0Q7kNvwHJm8mt&_nc_oc=AdoarxySITB4Fvtej7Bk0aO0gqXT4H_Udqfb_vag6AUCFsUIabkC6dVVdcfw5hk8S48&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXFn7gZ88FnIJvBqtHjVmLycbDBtfbYQEM44A6QH75rOA&oe=6B105BCF"}, "display_name": "Knights of Fiona", "keywords": ["anime", "dragons", "fantasy", "narrative", "story"], "long_description": "# Team up, gear up, and fight for Gallia.\nTake on arena battles in a JRPG-style VR action RPG with online co-op for up to 3 players.\n\nIn Gallia, thoughts become power. Knight Commander Fiona has sworn her Gesh\u2014a binding oath that transforms hope into power.\n\n{2806835839715744}\n\nStand with Fiona and the people of Gallia, harness the power of her Gesh, and fight back against the hatred consuming their homeland.\n\n# Fight Together in 3-Player Online Co-op\n{1551316092815388}\n\nWield swords, bows, and magic in action-packed arena battles. Collect gear, grow stronger, and team up with up to two other players to take down powerful enemies and formidable bosses.\n# Start Your Adventure for Free\n\n\nPlay all of Chapter 1 for free, including both story quests and battle quests.\nCreate your character, jump into battle right away.\n\n*To unlock Chapter 2 and beyond, as well as certain features, players will need to purchase a \"Story Pass\" or \"Story Tickets.\"\n\n# Step Into the Story\n{4539518626329286}\nCome face-to-face with a memorable cast and experience dramatic moments and unexpected twists as Gallia\u2019s story unfolds around you.\nBe a part of this legendary tale and bring peace to the land.\n\n# A Story Told Across 6 Chapters\nFollow Fiona and the people of Gallia through her adventure with all storied content now available!\n\nLook forward to seasonal events and gameplay updates as the world of Gallia continues to grow.\n\nSwear your oath. \n# Join Our Community\nMeet fellow adventurers and stay up to date on our official Discord.\nhttp://knights-of-fiona.com/discord\n\n\n{2273825473472511}\n\n", "short_description": "A sworn-bond VR JRPG from Japan. Stand beside Knight Commander Fiona and fight dragons in a hundred-year war where thoughts become power \u2014 solo with companions, or online with up to two friends as three sworn knights."}]}, "developer_name": null, "developer_privacy_policy_url": "https://knights-of-fiona.com/en/privacy", "developer_terms_of_service_url": "https://knights-of-fiona.com/en/terms", "publisher_name": "CharacterBank Inc.", "support_website_url":
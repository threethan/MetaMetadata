_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GvG3CDmR5oQ7kNvwEdWKxv&_nc_oc=Adr1g1jZvHfZqacqubrfNf1oATk6Bar6DxFIs9ETX-Em5DhIbLo8NfUKEhZsM6NysZ0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUcmX1iHlAOu8PirCb7kZhBh1eUNfPOAmO0-gSFYTZDA&oe=6B032EC9"}, {"file_name": "Story2.png", "id": "1595313882283753", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499628411_1595313888950419_4485845558801043242_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67nmjZFfibwQ7kNvwEy1UVC&_nc_oc=AdqcyLDvxSZYSTGTmCsoHi-UQupziFhC1sFTsIG84jQJt_hyGFXtPK9Znd7nsDopSng&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJwRorcC45_z-EFCRNaDlHuWVX2LONkS7_jRgW_nOmPQ&oe=6B031123"}, {"file_name": "KnightsofFiona-6.png", "id": "997658306631476", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623384_997658309964809_2840937849806024473_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j36ayXiBdGcQ7kNvwHNJglF&_nc_oc=Adq8WdwA4IR02bV_j1jOwFKG6NPQ_NdLsFmfELEs0iTz4VlyreWjWwxEEUPLabQk_Zc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQIUxiv6IF2pyfN3ajetjol4UXADEv1K4Vl3c8Kt-n5Q&oe=6B0329CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2569x1440_KoF.png", "id": "2031371670940985", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623443_2031371674274318_8386471399098698822_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVebYpbOWC0Q7kNvwGX4oTf&_nc_oc=Adq_OvEVGsGOpRAa8fuyV6DVBuvb03Oa7yJd4MEjhUDTeJuCkDdMGa3bPCSjVU6KHFI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRnhvLALJy_rJYAj38p9ae6R6YZBrj7gLsn5IGzfDhNA&oe=6B032CCF"}, "display_name": "Knights of Fiona", "keywords": ["anime", "dragons", "fantasy", "narrative", "story"], "long_description": "# Team up, gear up, and fight for Gallia.\nTake on arena battles in a JRPG-style VR action RPG with online co-op for up to 3 players.\n\nIn Gallia, thoughts become power. Knight Commander Fiona has sworn her Gesh\u2014a binding oath that transforms hope into power.\n\n{2806835839715744}\n\nStand with Fiona and the people of Gallia, harness the power of her Gesh, and fight back against the hatred consuming their homeland.\n\n# Fight Together in 3-Player Online Co-op\n{1551316092815388}\n\nWield swords, bows, and magic in action-packed arena battles. Collect gear, grow stronger, and team up with up to two other players to take down powerful enemies and formidable bosses.\n# Start Your Adventure for Free\n\n\nPlay all of Chapter 1 for free, including both story quests and battle quests.\nCreate your character, jump into battle right away.\n\n*To unlock Chapter 2 and beyond, as well as certain features, players will need to purchase a \"Story Pass\" or \"Story Tickets.\"\n\n# Step Into the Story\n{4539518626329286}\nCome face-to-face with a memorable cast and experience dramatic moments and unexpected twists as Gallia\u2019s story unfolds around you.\nBe a part of this legendary tale and bring peace to the land.\n\n# A Story Told Across 6 Chapters\nFollow Fiona and the people of Gallia through her adventure with all storied content now available!\n\nLook forward to seasonal events and gameplay updates as the world of Gallia continues to grow.\n\nSwear your oath. \n# Join Our Community\nMeet fellow adventurers and stay up to date on our official Discord.\nhttp://knights-of-fiona.com/discord\n\n\n{2273825473472511}\n\n", "short_description": "A sworn-bond VR JRPG from Japan. Stand beside Knight Commander Fiona and fight dragons in a hundred-year war where thoughts become power \u2014 solo with companions, or online with up to two friends as three sworn knights."}]}, "developer_name": null, "developer_privacy_policy_url": "https://knights-of-fiona.com/en/privacy", "developer_terms_of_service_url": "https://knights-of-fiona.com/en/terms", "publisher_name": "CharacterBank Inc.", "support_website_url":
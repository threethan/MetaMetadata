t=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMegcV-tUUQijZIdPUSUy6Jx6FWNCALfPHwbJXApQJ3w&oe=6AE3508F"}, "display_name": "Knights of Fiona", "keywords": ["anime", "roleplayinggame", "dragons", "fantasy", "swords"], "long_description": "\u201cKnights of Fiona\u201d brings players to the vibrant world of Gallia where they join Fiona and her sworn knights to fight against an ancient evil threatening the safety of the realm. Players can adventure either solo or with two friends as they embark on this epic quest.\n\n# Key Features\n\n- A Deep Character-Driven Story: Enjoy a hand crafted narrative experience. Interact with a deep roster of unique NPCs, pushing the limit of what is possible in VR.\n\n- Live Your Fantasy: Explore the city of Gallia from its train station to seaside ports. Adventure throughout the lands as you fight against hordes of enemies.\n\n- Epic Boss Battles: Restore justice to the land as your tackle fierce dragons.", "short_description": "Fierce dragons have emerged in the land of Gallia. Join Fiona and her sworn knights to protect the kingdom! Embark on quests solo or with friends as you fight against the darkness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://characterbank.atlassian.net/wiki/external/NDJmMGU0NTQ0YmNkNGM1OGI3NTVkNWQ0NzYxZDMzNzc", "developer_terms_of_service_url": null, "publisher_name": "CharacterBank Inc.", "support_website_url": null, "website_url": "https://character-bank.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
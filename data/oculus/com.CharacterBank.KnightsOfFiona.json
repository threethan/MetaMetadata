_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GvG3CDmR5oQ7kNvwGMugmb&_nc_oc=AdqQTf-A0o9Z8LBzWf7ZrgDOvzwHLGupiKVUK7DhlYNeGsjjelviF7zLy7jDb0ZKeDQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzlqKvYVgHgM3Rzb4jvcStkzcV9KTi_351BCVz3OF-uA&oe=6B01DD49"}, {"file_name": "Story2.png", "id": "1595313882283753", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628411_1595313888950419_4485845558801043242_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67nmjZFfibwQ7kNvwGxzfT-&_nc_oc=AdpOjgt8TB2jLfZA6lIvwAGg2PD5LoZ534bSW1meO2tDBU5tV3lyo2ZU80Kdpq370TU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwe8BDG8usnSbTOxBReuMz0FtgnZMIrOtA4ynCZkmb7g&oe=6B01BFA3"}, {"file_name": "KnightsofFiona-6.png", "id": "997658306631476", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623384_997658309964809_2840937849806024473_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j36ayXiBdGcQ7kNvwFNL8Zx&_nc_oc=AdovpFbAEJQv8L9Q4UAiaLBvX9EUSPYxv4Uz1vaweBeMMWTngZrsS93FR6aVrFLseGM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHpCyzX61FWvSxkrF9p4MzG4pHsyWdA2TqIDZ0lYLJ-w&oe=6B01D84B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2569x1440_KoF.png", "id": "2031371670940985", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623443_2031371674274318_8386471399098698822_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVebYpbOWC0Q7kNvwH727x6&_nc_oc=AdpVKvSWSS0t93FCaRs0hPUJaSWkO6qrOKy8Uc2c18hBkH2YzpBIR5axikXkucrQsp0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNNJWMejeWEvmrw2ScX9XTxxH9vDkAArl1WGTCE5DgfQ&oe=6B01DB4F"}, "display_name": "Knights of Fiona", "keywords": ["anime", "dragons", "fantasy", "narrative", "story"], "long_description": "# Team up, gear up, and fight for Gallia.\nTake on arena battles in a JRPG-style VR action RPG with online co-op for up to 3 players.\n\nIn Gallia, thoughts become power. Knight Commander Fiona has sworn her Gesh\u2014a binding oath that transforms hope into power.\n\n{2806835839715744}\n\nStand with Fiona and the people of Gallia, harness the power of her Gesh, and fight back against the hatred consuming their homeland.\n\n# Fight Together in 3-Player Online Co-op\n{1551316092815388}\n\nWield swords, bows, and magic in action-packed arena battles. Collect gear, grow stronger, and team up with up to two other players to take down powerful enemies and formidable bosses.\n# Start Your Adventure for Free\n\n\nPlay all of Chapter 1 for free, including both story quests and battle quests.\nCreate your character, jump into battle right away.\n\n*To unlock Chapter 2 and beyond, as well as certain features, players will need to purchase a \"Story Pass\" or \"Story Tickets.\"\n\n# Step Into the Story\n{4539518626329286}\nCome face-to-face with a memorable cast and experience dramatic moments and unexpected twists as Gallia\u2019s story unfolds around you.\nBe a part of this legendary tale and bring peace to the land.\n\n# A Story Told Across 6 Chapters\nFollow Fiona and the people of Gallia through her adventure with all storied content now available!\n\nLook forward to seasonal events and gameplay updates as the world of Gallia continues to grow.\n\nSwear your oath. \n# Join Our Community\nMeet fellow adventurers and stay up to date on our official Discord.\nhttp://knights-of-fiona.com/discord\n\n\n{2273825473472511}\n\n", "short_description": "A sworn-bond VR JRPG from Japan. Stand beside Knight Commander Fiona and fight dragons in a hundred-year war where thoughts become power \u2014 solo with companions, or online with up to two friends as three sworn knights."}]}, "developer_name": null, "developer_privacy_policy_url": "https://knights-of-fiona.com/en/privacy", "developer_terms_of_service_url": "https://knights-of-fiona.com/en/terms", "publisher_name": "CharacterBank Inc.", "support_website_url":
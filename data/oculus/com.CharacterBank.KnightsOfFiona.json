cdn.com&_nc_ss=7f20f&oh=00_AQQf0ibZrWuGRNJmM3JxhyKvcpht3VrgEAOZRmvJBZ0fTQ&oe=6AF895A9"}, {"file_name": "Boot_Cine_009_0303.png", "id": "3356526267838277", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619715_3356526274504943_4522457901036969155_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBcs5o57LmIQ7kNvwFGHD1J&_nc_oc=AdrIyWonAUAdafsHsq-UOFkNbhk3AekBuxNmwUQOu_Ee2F7Dk6VJ5Yow0FSxuCARC88&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmXLkvhz2IV69DQ6p1BNO7EzNr2sb03OnHAvC5CrEQsA&oe=6AF8897D"}, {"file_name": "Image Sequence_013_0131.png", "id": "1901559210745868", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620504_1901559214079201_5447510701017943652_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12q8hof9nKkQ7kNvwF3dig0&_nc_oc=Adr-GOjtCVqP-jJO1T8o03aEAZVAP_HWE6POtVazjO3XbpxQQ0rG0GVI7QGc3WHgAi0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6Xj97u8MRjbxlDY47x8gBMHZNSshK0nK2UyBGqML7bA&oe=6AF88A71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2569x1440_KoF.png", "id": "2031371670940985", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623443_2031371674274318_8386471399098698822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iorXEpHpjcYQ7kNvwFaE_rZ&_nc_oc=AdoNWxld5GG6Wq-zGbWFCtgQ4EKYyaLpTbPC1sZDyEml9CRnXwxJSJ1B6jiTuyTSkis&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDiC0OyjzmU0MSZzCVkyiDGACthTixHj6e0m-3vqvOkA&oe=6AF8A0CF"}, "display_name": "Knights of Fiona", "keywords": ["anime", "roleplayinggame", "dragons", "fantasy", "swords"], "long_description": "\u201cKnights of Fiona\u201d brings players to the vibrant world of Gallia where they join Fiona and her sworn knights to fight against an ancient evil threatening the safety of the realm. Players can adventure either solo or with two friends as they embark on this epic quest.\n\n# Key Features\n\n- A Deep Character-Driven Story: Enjoy a hand crafted narrative experience. Interact w
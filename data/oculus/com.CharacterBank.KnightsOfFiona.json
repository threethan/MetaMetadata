cdn.com&_nc_ss=7f20f&oh=00_AQTm1WXKojgvE8tmsPNl0bHPjJPvp5mSoUT9o8EgRcs4_g&oe=6AF4A129"}, {"file_name": "Boot_Cine_009_0303.png", "id": "3356526267838277", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619715_3356526274504943_4522457901036969155_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUL7fqlgOAYQ7kNvwFx_EGb&_nc_oc=AdoRCWp9xXqlHZnzY6Jls8UeCX9SrS5ZK26hfutlVC487Slku3K6_APsicWAANQFfo8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWvU4YonxfTNGRKXszFcFF4zDUSQRT281oLUeW64EHVA&oe=6AF494FD"}, {"file_name": "Image Sequence_013_0131.png", "id": "1901559210745868", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620504_1901559214079201_5447510701017943652_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIT2MbDm8eAQ7kNvwGgjtDm&_nc_oc=AdrFdfErKmlX-IhwwnFOq5KtPwqgYY2QQ7S1naW0s3ch-cEYJcdeLTUtIsJ_1w6OumQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKahkET2f8x3UyCtADVRua8C2kpVO6UV_yqdNb7iagiQ&oe=6AF495F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2569x1440_KoF.png", "id": "2031371670940985", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623443_2031371674274318_8386471399098698822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uj0ogknqkfEQ7kNvwGLLCK3&_nc_oc=AdpUwRGzy8DHVv7orWyvEdcs2KffO_LuKsysfNApoyQDS6gi_CL2c1anzc5J_wYHCbQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlkUUxno1_iptirAG3GH0MsZ8FXV5xUHDcPPqoauuNig&oe=6AF4740F"}, "display_name": "Knights of Fiona", "keywords": ["anime", "roleplayinggame", "dragons", "fantasy", "swords"], "long_description": "\u201cKnights of Fiona\u201d brings players to the vibrant world of Gallia where they join Fiona and her sworn knights to fight against an ancient evil threatening the safety of the realm. Players can adventure either solo or with two friends as they embark on this epic quest.\n\n# Key Features\n\n- A Deep Character-Driven Story: Enjoy a hand crafted narrative experience. Interact w
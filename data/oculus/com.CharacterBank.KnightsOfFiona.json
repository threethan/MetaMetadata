5_Kr-zQuvgq-yPGvCVtrk2tkyUWGjwI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkbjz4yl5AHl584M1dCygdiXfJMcX4BT-2atpjVFP8TQ&oe=6AA1672D"}, {"file_name": "KnightsofFiona-5.png", "id": "1887570808633609", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620504_1887570811966942_2135205799513653312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGBw1Y1jArIQ7kNvwFjp-_4&_nc_oc=Ado9cKnmYfvR6A2cWU8KExhRoIXDc-xOCmFaWx4x37d1T1z-F5zjeQ56LM4yKZN7WaQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2e2-ZA5qla15V_sJB4cxk8CWEen1bPfR6NicFXbxbFQ&oe=6AA16789"}, {"file_name": "KnightsofFiona-2.png", "id": "1008784115284620", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623400_1008784118617953_8183366980713401361_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gd407bK1bG8Q7kNvwFfxUSX&_nc_oc=Adrq1UhFr45tUhl_KTxOILs284dETA9-cler5ZB9PefTDDqTzCcwoXK74rtd5SLQgdU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHsBTRolqdo-3val23Qvv_lfIhsvdbC7HqQYSc8667cQ&oe=6AA1645F"}, {"file_name": "KnightsofFiona-6.png", "id": "997658306631476", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623384_997658309964809_2840937849806024473_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBFLcF7YuMsQ7kNvwGXzUov&_nc_oc=AdoL8i4hgM_3iDF8MXA5wZ_HulwHQ-6HZf58jamtDKdsvWo3P6MgF5iVb4SFNbEYfpU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLx8t0mjqCWOI9klpmmwmV88qTZi_qIdC6ug5dEvYLB_g&oe=6AA1628B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2569x1440_KoF.png", "id": "2031371670940985", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623443_2031371674274318_8386471399098698822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GedGEuxtyMYQ7kNvwETJsYa&_nc_oc=Ado3_O5pTKDvUynOHv6hRTz45w0_9lvsBongJEngLf_GgeLhWN7toZyXblDRh36r6H4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHH5iYc25sqjFqozz_TW2dkvt4KnAeTtq2ayX3xMbyrg&oe=6AA1658F"}, "display_name": "Knights of Fiona", "keywords": ["anime", "dragons", "fantasy", "narrative", "Japanese"], "long_description": "Gallia is a land where thoughts become power.\n\nA new order has risen to answer it. Knight Commander Fiona has taken a Gesh \u2014 a binding oath that turns hope into power \u2014 and she is calling for knights to take it with her.\n\n{831277739876027}\n\nYou are one of those knights now.\n\nKnights of Fiona is a full-scale VR JRPG from CharacterBank, the team behind RUINSMAGUS. Built from the ground up for VR, it follows Fiona's sworn order as they fight for a future nobody else believes is possible. Play solo with companions at your side, or take the adventure online with up to two friends as the three of you share one oath.\n\n\n{1911955316402684}\n\u2694\ufe0f A World Where Thoughts Become Power\nGallia's warriors fight with the strength of their convictions. In Knights of Fiona, the weight of your oath is the weight of your blade. Every strike carries not just force but belief \u2014 and in a VR JRPG built around physical combat, both matter.\n\n\ud83e\udd1d Sworn Together\nA Knight Commander's Gesh is shared by every knight who answers it. Play solo with trusted companions at your side, or take the full adventure online with up to two friends. \n\n\ud83c\udff0 A Deep, Hand-Crafted World\nExplore the city of Geogallia \u2014 from its train station to its seaside ports \u2014 between missions. Meet a cast of unique NPCs in the hub town, take quests from the board, and experience a full JRPG story built for the scale and presence only VR can deliver. Localized by Nob Ogasawara, the translator behind Pok\u00e9mon, Dragon Quest, and Yakuza.", "short_description": "A sworn-bond VR JRPG from Japan. Stand beside Knight Commander Fiona and fight dragons in a hundred-year war where thoughts become power \u2014 solo with companions, or online with up to two friends as three sworn knights."}]}, "developer_name": null, "developer_privacy_policy_url": "https:
ZC9TTGmkjfEYxuLmdxBl5T6kfqApKsBnvnz5zcR1aitbNf3ukva8ZbByRf17XM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFx-B6UEhG5E7nNh9Q5dFRqG6aoSkQ3c1Iu1d5vkIYag&oe=6AA3F231"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2569x1440_KoF.png", "id": "2031371670940985", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499623443_2031371674274318_8386471399098698822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GedGEuxtyMYQ7kNvwGJTJk9&_nc_oc=Adr-MpcjQlK4OJHF73YOOuszm-iQXWgEM4wTfLSqPI3BsboXYbkqMdIJU89Ib8MEC74&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2QnrpIAE_AEdPa9yuwcPiPZGb9DOK583ckf6SH0rOdA&oe=6AA4088F"}, "display_name": "Knights of Fiona", "keywords": ["anime", "roleplayinggame", "dragons", "fantasy", "swords"], "long_description": "\u201cKnights of Fiona\u201d brings players to the vibrant world of Gallia where they join Fiona and her sworn knights to fight against an ancient evil threatening the safety of the realm. Players can adventure either solo or with two friends as they embark on this epic quest.\n\n# Key Features\n\n- A Deep Character-Driven Story: Enjoy a hand crafted narrative experience. Interact with a deep roster of unique NPCs, pushing the limit of what is possible in VR.\n\n- Live Your Fantasy: Explore the city of Gallia from its train station to seaside ports. Adventure throughout the lands as you fight against hordes of enemies.\n\n- Epic Boss Battles: Restore justice to the land as your tackle fierce dragons.", "short_description": "Fierce dragons have emerged in the land of Gallia. Join Fiona and her sworn knights to protect the kingdom! Embark on quests solo or with friends as you fight against the darkness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://characterbank.atlassian.net/wiki/external/NDJmMGU0NTQ0YmNkNGM1OGI3NTVkNWQ0NzYxZDMzNzc", "developer_terms_of_service_url": null, "publisher_name": "CharacterBank Inc.", "support_website_url": null, "we
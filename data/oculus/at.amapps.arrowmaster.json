&oh=00_AQHrQJKinYljWttLWIqKD8sOcgiTmklYEWPyrMU3RgZQNw&oe=6A90246A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LU5fqfXUt2IQ7kNvwGj1xT1&_nc_oc=Adr_dbwNMulePpCCuA2efKaXnYPI-X1M9NSBEO5Ub9dU7hRVzmGfbsLhY1TsviR2RkE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvDEQ7v4aJqqxiEWN0hU_xGI_2z87QKlnaw5yYcpf1dQ&oe=6A901656"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DrRHnhHUa8Q7kNvwGFEe6n&_nc_oc=AdqQWhAtpaEPjTkLVXLW8QgLh0e3TXuDCMm4Fp8JHiESYnQX5vxu3QPTnLcNbo5tAy4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEe-gMjLJYwPwTccoUZMtr32LBlAjG4jit8JT9Y6Z_rRQ&oe=6A903473"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkJjgItdSnYQ7kNvwHndt2r&_nc_oc=AdrorwbpuPBnUBMq2Q94hH32N0BL-06hNxwqy4pwnJA9pajKDqkreps1Xze1SjXMS3g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwZV82z3RmmjgeRtbxO-bMPC_ESjC9ddT4XE3KSUo_hA&oe=6A902D25"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYf0RszY1kUQ7kNvwHliRkl&_nc_oc=AdqE6D4lynKUhoka8LeWvg--VA2g0aj0I_8V8Irtz4FIL0y3-MjXOuiunL7nYavEpJw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6BWyHpt0bbJyx87iAyuEClCfkhcqM7Jt6G6AvUGSq8w&oe=6A900C40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_OobMbzNSOkQ7kNvwGFywQM&_nc_oc=AdoLDhGK32XuqsF2SqqLB_C-bx3VmtUQPXg9MIB5k8b8dAIwrII-e7pLngP1u9NbPmw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWuBVsV_IbbsvfdPp76N1YA8psdi5nS1Xng_UpNeitcw&oe=6A903222"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
&oh=00_AQTVuHNlnR_G5aVcQGrU4EcSIpdu2jEsXzsaAv4PEJtdjQ&oe=6AEF48AA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmW0x2TmEYcQ7kNvwGCAZ0L&_nc_oc=AdpnSO4p26pokQRIduA06TjDI9KEbvgKb5Tlyv0vKgH_t5fRpX6SVR_7Ebsueop_FtM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0w-AgGug8396FQMypHdyhCYw2GwIQ2bfDThXWwVt5JA&oe=6AEF3A96"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3EXoE2lsSIQ7kNvwGBWuIS&_nc_oc=AdqTSLV3r_jw-PkmaIkWMQ3x3pFXZPLJUlP3TNlX0UaNrCwF97yIROBt31nKMErVW9g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ24tVjFDZvnD1w3eN6tdt08ey-VjShIa_BLoYm_iANFQ&oe=6AEF58B3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bo-ETRAjBT4Q7kNvwFbrzzK&_nc_oc=AdpdegZc47GJT1o68VlHD-ul7QzFmpzokPHFyHncCzghW6dpN_L9tShhRLs6-_gbCYY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrEZWd1RP8PjJjLrK5FpduZJajCSyNz80eBVzcDG-nBA&oe=6AEF5165"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMLY7gaNT7UQ7kNvwFsNxsD&_nc_oc=AdpXjmWNpUs-kFjwmYUIoZTx53jE_B4dMZyjd41cHMOvfUl9Cv6Qe21LpQOjetaClrs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdR0_IFBwIngVrv_d7547IqNppekwcuV38HPPuTP41aA&oe=6AEF3080"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mS07If_z6bwQ7kNvwHe5oE6&_nc_oc=AdoY7n8MipfHfPjzvModA0N8hyzfGVtzgW31bt9cZDHy1F4Dv3JnUUZiVUH78ib3XMo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTM2OQLXuJCGXkd_zqC4LFTV6eu2NmRTmfexp6wITu7Ig&oe=6AEF5662"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
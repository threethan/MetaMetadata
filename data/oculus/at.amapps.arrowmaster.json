&oh=00_Af9CxMZ32dPx0i4_HzitlK62t7qproMHbynzkxPEX67epw&oe=6A3BFCAA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feHqcnCyuaEQ7kNvwHioqEs&_nc_oc=Adr7G7J0hSHpvYFZRU3sDVhDYqo0-huape62kdEBDZ4xHKeEF63fK10G8Kw5qhKUPTw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3e-xEw-DANkG5i-pjIATU1tj-i00v1HX5Pgw0Sk2j4w&oe=6A3BEE96"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTx73NFPHCQQ7kNvwEHQdpn&_nc_oc=AdpKXucBXjWEvLLVfLoCCpnpvoP4hlhIEwukMf8JCjH4FpLyk1z_FZzFIXiH06-dKaM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XQEOUhAz-mcbUJ2J9bnnIlu0Pg4h_8epACyt0UlivIQ&oe=6A3BD473"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iW3T8YP4FCYQ7kNvwH4cD2Q&_nc_oc=AdocDLP_DHXp0y8P5LjnsgtzeBERBBA61t6yNrFakx9Ve7u2i3lfdijfpB3SDxNoOOc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Wo1Akq2ldoX440fFgjPmsnCUNsp-jOiAPTQkYlLPugQ&oe=6A3BCD25"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIJoVdtqpd0Q7kNvwGmWSAZ&_nc_oc=Adot1Us7uAOeyjbz7ubAWBwjRT0SPjGdg2LHmtfGT6YPkxraXNfcFmibkHB-ccTxl1s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VV04qdwJXZY-KDLNRlcZRtaKEI6VeMbAJvBbX2X5p8g&oe=6A3BE480"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITjtbmXUCXoQ7kNvwHoCF54&_nc_oc=AdpWgz1Z8cbM0xzxoT0kyym38HfpKfJYYwV9q0ruDZ_ADV1feYzaq2w9U3Y3SZbbRQs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dbYLCK0CjAIXUuOsWkFyt0SKrX7pMOvDdu7EEozoZVA&oe=6A3BD222"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
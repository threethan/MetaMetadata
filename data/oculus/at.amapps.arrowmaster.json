&oh=00_AQSnadWWbX9r45gGcqQFHqHUcsevSGmKKz98WdD0H03aEg&oe=6AE75FAA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRCdw4OFzAkQ7kNvwF52Ffx&_nc_oc=Adp3bR7Ic2uCUH5jeHlfmNgUMPrdUNqPgMkPrFJvKK1EETU1G4rLFtzAhDc6GvcPIHY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7Rr8HhUJyO4T7Vi9PRR0LMgMUMl-cywgZdudiQKe3gA&oe=6AE75196"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYZLjPZe3EcQ7kNvwEOycVm&_nc_oc=AdquCRGglrwM6E-AqSjI9eJ4MsjJpfH3ORFJpII9qW3LldLiu6wX_5QHXUCZ7XGBcME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJriRgjsvvg9g0vhEINmSfW7u3PxfdvFMkBPdQTKyW3A&oe=6AE76FB3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Db4WDd6I7yMQ7kNvwHrBHH7&_nc_oc=AdrrfTU4vSuBGnMmvDkcl9H5Dktflq6pssMFx6SWS4PAUwQqmkXgMBd3LM1ba_dye8o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvQZ43_RxvEwN7EF7k3CS5X6WWBE093aKWR5GEOgQ_wA&oe=6AE76865"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsT--MO2z6IQ7kNvwESCBYI&_nc_oc=AdqapIiYGDmD-9mTZFYfx-PZRH10L80SSbIfhP8453TtqEEvYZ0LCioKO4jHL6IFRn8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-1PK5creSy219W2G6xwyRvX9lqpaZO04gED40trdvrA&oe=6AE74780"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dd4btlhK8jMQ7kNvwHbknaF&_nc_oc=AdrhSuKKoKvK2TuSxJ4-zm0P6dT0G2W-srbBetbe09aw88eCVTHszD_GZeOX2RVxxoY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSw1SKwtKh5FvDrNrV_Q5gW_Lb8yW0FirrHQro_YH-_Pw&oe=6AE76D62"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
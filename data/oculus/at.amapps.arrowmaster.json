&oh=00_AQEbYwfr7YcPue6EGySNKBMv6HP516SpHWvnjPaWYtjRCg&oe=6A883B6A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBqnRU6EzBoQ7kNvwH-_JIF&_nc_oc=AdrpdVUacAV60sVVdyQm38bAvG7tctufsB1ttasIzr4Cwj-8NvT7M9R7TtX5S9rp1wk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbzWsqrVLGFhTohnnbodWx8OwPBbkxLR35TRlZ6oGWag&oe=6A882D56"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVI6fQkZ44oQ7kNvwGJOan4&_nc_oc=AdrcJ5O5Nq-Gqaz49I3P705YmPjV-tD1tlAdLQC5-WK4OpEuvnZ9GZbatsJWU7k5faE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2wQ5YUSkuHFBZV1s9_7cNHdheSKUcfLGtpHZ1xA7GJA&oe=6A884B73"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_W7b9TKW9UQ7kNvwEW-rXU&_nc_oc=Adq3S9PfINjy7UEWHanF0ENxmZr1SCs1fSjhVAv4dmmaw0howAItXBk25ZMtka7YDnQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHU-YZBwyAoRBwbhiulUZuj8puAHKMhfodY3Per81e2gQ&oe=6A884425"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5BbH_98FjQQ7kNvwFoveCX&_nc_oc=AdqYaEPzQA8xyGf6DQQi5SUcL4oVXEhQ4GsDViEM7hVEpAHAMEzN7_sSkTXNcAxWFyk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbylTLdDDITFABcn9BMKHu8Dpe6huxeqxLz8fpAaxkLA&oe=6A882340"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxhhnDHKDBUQ7kNvwFttm1E&_nc_oc=AdoDvn64uu7bbXS5UIH0BkDD7y9gP59gkxg_vh7yAs1d8WVKF3zaX03bYDY6Z6nR2Aw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_JVXBUvtN7ENL2L08LmDL_pLtpRri6XNtBl6nxY3f3A&oe=6A884922"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
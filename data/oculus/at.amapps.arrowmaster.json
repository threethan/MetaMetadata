&oh=00_AQKedGH5_oSMfkpGq7hFAgrfIBkwaKrZt_4XZLbkMTkrrA&oe=6AB93B2A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56bVP9VlKvYQ7kNvwE1ibfD&_nc_oc=AdpYdYlptEEKCRztAHD55r_pURN3yUSHH7v3VEt8M6BniatfaQoZQn8RhS7kpjYXOaA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwcpFHAHGMwBjsYO5amRVfynFc7VpqceKz4JbyNzlFXg&oe=6AB92D16"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elrellOgFnYQ7kNvwHf6CaG&_nc_oc=Adroaol_qo5upTdcbJHZThoktNReLXV03cE2QZOl-6KTcZBV875no2oO92CJyzoJtK8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKsWyGabYyt7ZmzZkqEh94clKTojH1-WaBvioMl9xsGg&oe=6AB912F3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrIYmp8ul4cQ7kNvwGpPKiw&_nc_oc=Adr1yY02tU03-QG7qPVXqj_BEWB63p0gkL8Xnmaaaz4S2mZfDJvMh646fOm34s70oco&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-ABWkjyOOkXSZojAnwNRGX83M89q1_RUwdOboRAVyow&oe=6AB90BA5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKC36GcjJ58Q7kNvwFqAIGS&_nc_oc=AdoAZ1X1VZNJO5Qa5VCr1SCIkrKD-cbThHfpCCkyxsU3iFgm-HbjXQGCKv-jIzChwhg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK99TUftXh6YKdxtT2sQ_cjmQI43ZiP3pYPBCB-pSwLoQ&oe=6AB92300"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAZ9-sH9ryMQ7kNvwE1P9SJ&_nc_oc=AdomXgxJo7QAj68coxSEtYCSENVerRTAX9NUFhtSabQUlBAMwT4fMT8R4bcRwouK6Aw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpxj30pdVQun_1Nn9RqVjCOpumbPiNxYIeXz4BEOfEAw&oe=6AB910A2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
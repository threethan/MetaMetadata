&oh=00_Af3Lx0kt2w5USCV9PxNdrEjsttT8slRHxTJ2TG69jEa-Qg&oe=69F5E4EA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xG_nE4Uc0UQ7kNvwHF43uq&_nc_oc=Ado7GmGlHAnHc6VcT2vDTilvaCyrtSYwCM3Dx2iWyjdZ1tPpXno2-K900cX-BXvUc_k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0zt_HZAu9JdeKc9KuNhP3e6scU_cY7TF6vI4Qj9_Rteg&oe=69F60F16"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LedtTq4XdEQ7kNvwEFBcAm&_nc_oc=Adrdrhjj-1HXiC8t59zCXLYWaVAqKj2nFeXtHESxJgSZ9vX8F0P15JkeyqLoDHIrx4k&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3TJcfut1FdfyWndsuZu60GS_yitGfxrMjFNflLvqdxtQ&oe=69F5F4F3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHzXbW-ItmIQ7kNvwFH_vD1&_nc_oc=Adr_4QFT7F4tiYs9aJbn9wyX4SiqrdQkkON_NOABZPPVGUdk2fUTIJTQxIy-NB1_6Sk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af19TGDlKtmS-w5077RUrINTpV1FvIYl2rIty2y_jWLvnA&oe=69F5EDA5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLkmPkvN7lYQ7kNvwGrtno3&_nc_oc=Adq5fTDFFAUtqD_ZrKHeZ-EtKyDgmDOOn-cQhyENcVJ3Dxaj8-lPije4gNgppnuIX3U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1obquB4YXBINwfqFKyBGYAUHRSRvfnppYfFPqbt675rg&oe=69F60500"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZUHNnDDVHkQ7kNvwGBcK6N&_nc_oc=Adrud5NREH7Vza7EZBIsWv71FYZQbik4AAfEfB0A5kiZ5l_-2fePlpDTPwfOqxDA9II&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0tn_03tbakHDPpvUv5SSJcX_wJe7Ohzy41v8PR35Asnw&oe=69F5F2A2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
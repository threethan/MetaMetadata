&oh=00_Af9xhF4mWMFy2wUTVjIJC7HqeTPfr5Fz5RrNkVEymirkWA&oe=6A3E9FAA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJOA3zA1JnQQ7kNvwHxtB8G&_nc_oc=AdpCVVn9sfeXEfXedXDJ3Txohfa_9Kml0MWnsT1qYCL2U1uoIP_06jMRc0nrwl1YkGs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mOlEhkbRRHE2Vpshlw2g9a5PujUI4fKftL8rJbgT3Ng&oe=6A3E9196"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTx73NFPHCQQ7kNvwEfAV6V&_nc_oc=Adq2_qURlQcinOgF0m3MeV0nlsPttXc_8e-66LY5OpsetdCgrWPmRr3LG3hDMozdd6g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ee8XPs9AXzricaemT3eF2LevWFpNd8nn8FrDXFaKWEw&oe=6A3EAFB3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZEYvT-xAP8Q7kNvwFCTG3F&_nc_oc=AdoScf8T68aoCGW_9_DvWAGqsea-zdX2FCJy-Gz1y3dCvLBNbsQ00Q96UNhLt-vFmf0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZJBUYGO1HXjRs2uOKRKwBPBYl1C652jiEdGPJ9Mi_AA&oe=6A3EA865"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGwe3khq-8gQ7kNvwEsJcMG&_nc_oc=AdoHRTBmQNd-NLbU1VR62N1PxITPKki4RVYiWcbZk0-rMKqGPkDe7Hyp_Eai7gCoaEw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9k8UuDpLLgu4tqX5eqGKA24ngTOu2fAOUh6GM48a1axQ&oe=6A3E8780"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoyLMCBs0-YQ7kNvwGYT5ny&_nc_oc=Adp2C_sbroOpD69kgKu3ScZ-pXLW_opm-RHkJiid72pi70rHp1oZvm1XyLJt6SIWvP8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-K0syBKVh8tU-fclFtNRDBGOS8qjbAsMoWU5eFQ43T3A&oe=6A3EAD62"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
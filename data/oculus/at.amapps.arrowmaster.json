&oh=00_AQFGXSM343FT4tWkV5Blu2slRpZ5Soha7MKHbFa6oJDpBA&oe=6A70806A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKPPrruNKCoQ7kNvwE9Nzrv&_nc_oc=AdoO0vNPkLmF9A1rTsR9GWn9ZR9-0zS6Sa389foxiEj0RjWrvuyZG94MapzWtDwabHw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQPBC5aiH7cB2c7anPtPCuWzHebqz13QlRzt5Jyi2cRA&oe=6A707256"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cboXBnp7EgQ7kNvwGAvLbc&_nc_oc=AdoHWjjh6iNpxpBDYEoacxXP5LvGsjfmj0aUV5G4EtcQb03GiHNglXbqCIXCgeTa2k0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4Wa7VX2GuycLy1zN3Tg8FyHHV9N93QWlFsYCeGa_AhQ&oe=6A709073"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8b7D3XlI_MQ7kNvwFL4oZo&_nc_oc=AdpV4UG2ySOsfay3hSIoA1_C9ijNl2QkuxftbPPoqS_bjQgL9MHU2yY5iCSdaL52GWs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFentOFZG8z6Nybr8zyXMIZThcOZzxvV_-dGLAOffLNZA&oe=6A708925"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGwXaFLNMI4Q7kNvwErM2hY&_nc_oc=Adpj8hCGwgdiSFi4H4O-xY-yz31d72Rtv8TeUHxNdpSuiLM5T-NvulLPJecaR8SL6mc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzn-u9gIBZzdEjkKiDASEyZrnhUIs-A3i3eBYCO-QEGg&oe=6A70A080"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zl1EuWbUko0Q7kNvwH8bS9_&_nc_oc=AdrCNWhtJQFoQRR3uJUANSutOHSaF-miQqTVRNBX82s1VJOg63m0it7tov14ePkCHN4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGy6s0TYFMV0_M6HE4Qj6AlgL4anHZqLgMWQ_QCCZFnew&oe=6A708E22"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
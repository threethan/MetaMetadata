0f&oh=00_Af9-bcArSjlVGYxt4JviqSaCh5pzLFBK1Gg3YtiLd0y1EA&oe=6A4688AA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsKfNxypZ9MQ7kNvwHgvcXz&_nc_oc=Adpoxk-6obfbOA2GFqQXO6px_LzpjWOXIN0pxG63ifwn9fR1-9ybUp8z2esmhJPAzU8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gRTfQPgHVsYhMFasatTVATaRV-G4EnjSu138G0hVn-Q&oe=6A467A96"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKhFSY4VyTYQ7kNvwFiEDIl&_nc_oc=AdrTKr7s5NsjOi65LzmozhjjFm85gFRO9zicXplV1r5ksqdbHwhm9Z1pEKl-n2fmkuI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2TiQDkOkXBpefrrC8G1f9ud9ENmXjtITDPxBY4Wp7mQ&oe=6A466073"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4t0CHDxr9EAQ7kNvwFwBYoJ&_nc_oc=AdrMgjzhLp2trDbgONNOMXEThhNX3sjYsKIbs4Ub7LANSE7Sn8fC9hKkxz7TAlIqKsw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BCUnQn6yXbOeUCE2w_mKnDQbnWlIFdYKkVLK5BSmaiQ&oe=6A465925"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsjP6-9SgUMQ7kNvwEgsZ1k&_nc_oc=Adp_Mb4cOz3RKoMEQoLXtjkuD61OIjOoefe4TsyFBMWK4-KdnPNyw8clGQPeNaCsH6Q&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9z4dWqR_k5V87X77DOYyP2ugXSU97RPlbtgXnQ9Cgqtw&oe=6A467080"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qm4jgt_CfkQQ7kNvwFPwsO6&_nc_oc=Ador24iOFHoKQdOSmTcjpHqfLUKR-GW8BE8XtRZppshJgseWEuL-46GaydoK6EP6wQ8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BhAqwsxMdHtdeQ38QQ7hosV4gHg-bgWkBBEEuc6de6A&oe=6A465E22"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "reco
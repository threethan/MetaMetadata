0f&oh=00_AQJpR6YrUq3yQgJKY-9eAouaKZrHUHuREhLwYQZRCgbijA&oe=6AA4232A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SW-lGJWAt0YQ7kNvwHMcqyX&_nc_oc=AdoUtkQU4jmlNgyBeJalJg4PwNhxgSiZmHZS-8anSA7ycw4J534PWxVpLIcQS35ooO0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8eRgFNIGdkhe2CWPwdgHziIK6e_nFuvU4p2Wv-BVHmQ&oe=6AA41516"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsPCyYqtbXsQ7kNvwEhB1rj&_nc_oc=Adry-PTQ31LvbZL2vybupGXt3qUJA0EcWdzQosoylwfQpXEySjEsD_Uk1vHZWRetlP4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMb94oBOGtOo8LkTUdv_qHIvoMPNisQD8ZDzycdGlfsQ&oe=6AA3FAF3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LROiu_K9Fj8Q7kNvwHkrYos&_nc_oc=Ado7Si8a18up8MHIK0mF9stQINI7I7aDjPUlpdZUj3yBteegmrC98U_Cg66UWuXX8lc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnGuyI3gAXD5DMPjIMb2tGDo9_eoXi3F_jCUzJEWImKQ&oe=6AA3F3A5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzPjyUnxiMQQ7kNvwG21ZWr&_nc_oc=AdpppU24B-cwEosAhd7UbbPbHKQ6SkHaijFtw8giwbNHbBL0bEWOHh0gySNVSI8jWkY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-eDmMd5zwtVvlGGhwXducBOHHRnMdpC7tfkRCwOh3ug&oe=6AA40B00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GkRPVkI_UYQ7kNvwG_dVJv&_nc_oc=AdrgdYzAxz-crV3qmDb9yEREThTAx53G--LL6gnEP4a8KlQhCP-nXq5GAqp2VPPYghg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpNb0aOrehN24sNUafgZ0jQaVfcA6osSrdRUqZSfT6Gg&oe=6AA3F8A2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "reco
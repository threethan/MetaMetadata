&oh=00_AQO-GOZOE2LrIjgW7c-us1N1NSo12Rvox_AkyDNenb-Tew&oe=6ADCD3AA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3tHT5EsX3kQ7kNvwGm9gVX&_nc_oc=AdrKxnSTs0joinmQG2Oyvcr0GHvHC0tuppGH70I0T0NTPipb91ptvjVnzk5CL_A8_VE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3dH5DW7jTYR68ct9bh3Nm_IsDFbg1nIv0h30lLCYauQ&oe=6ADCC596"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ewu2IktLKKAQ7kNvwFDOTap&_nc_oc=AdqC45QPnMTmm526hQcdxqlUVZQfEpQAeED0tlBNdSThxzAK7uTzik_LWxfNj5woRQE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCxNG4creWGCmG026RCwk12cVFlIVr1cPNptCjyfTCyw&oe=6ADCAB73"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIt9_DuhEGwQ7kNvwHFHd1M&_nc_oc=Adq5ew4i49n_h3dncl1Jdg4SO1fh-b-6UDz1jXrRfzGe2yaE6sXmbHyCZC16DN9QthQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGw9MrNb1dEK8kWWR_FO2ANMJBL-XToUjgf8y--_NjsA&oe=6ADCA425"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dlin98j79KoQ7kNvwFg68uo&_nc_oc=AdoPggOW091fOGepPHYkmPGh_P1H-YLk0qNoD4pRYOMtIcFuDxo8mz6fSVi5dUzfTLI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8erQbq9ye3mzGnCOKrg_fiKAU_0Gub4iQuxaldDzQCw&oe=6ADCBB80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zo0ijIbcTCkQ7kNvwG1TQIG&_nc_oc=AdouvpOavvQ4uaGIsygHT6vL9DbuKHHNWDU-RRKyMZPhXUYElk4-mtac7B4kJk4-CD4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdwPye2-7lXVI4DvEii3wjUvb2ODNMPddWerY9_2H9Lw&oe=6ADCA922"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
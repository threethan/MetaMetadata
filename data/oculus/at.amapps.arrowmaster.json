&oh=00_Af8crqVCHb_Ywl7isriCzqMUJGyphW-NMklPbV7OPyhyuQ&oe=6A42942A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzElm4O1WakQ7kNvwH_dKoZ&_nc_oc=Adp0xAKgWY7QVgj3wplqLhmyeHqRAh4OSGEjmHV-PyQ7INhzijroxjOZYHWZKnJS7mE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pyoodo-lMHFHa39YfNxPudxdTTzCiDksRMPvrdOFKBw&oe=6A428616"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aApF8SjUoWsQ7kNvwHtwGYN&_nc_oc=Adpn8n6wp43OlgPz1JPZ3btEJeuqlZMTXfQuQqg0-TAw9qFT81rF3U87ZdjvlpAOQZ4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_KxGlcckzmgQk4kW5s5avTftBjLMsaoLAb99_mUPshg&oe=6A426BF3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyaWFIWpzsEQ7kNvwEiyBDX&_nc_oc=Adpg9b8E7-awqJ-eZWAXFr5vRYMXnGYdcBKilFkap5VoOEwFsfkmi2-mFdZQGBcTxRw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K-1uZYIgOUBnC-cB9ax5wRcXgKWiZlpmtwiVqrL6r3A&oe=6A4264A5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwrI_OZYVoQQ7kNvwEzml9s&_nc_oc=AdoBXbK9G9VkFx1pHdf-kk8dqxmCYSMn6QdC7lrRaqnhLDmXsyQQA6zzbhKxOfBeoO0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ytQkgJTWfHO_4gEcN_iTmiBYZrBie3vuFEComElpfNA&oe=6A427C00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eq4t04fscwQ7kNvwEiCNNQ&_nc_oc=Adp1Em19Aa-Mrfmvqr2sn0yWH8ElqJ7o0u6VrfCdie4UQK23Ht3QmPA0P92us_dCB30&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86KOLnw-YNqzZ3HbvSn3oXGAJKtLH6JtJezY1sGV4HLw&oe=6A4269A2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
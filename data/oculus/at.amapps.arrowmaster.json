&oh=00_Af9x04VwT7hi0E9PScou0MJlSXb3fl4RRkq3WkVnafKZJQ&oe=6A45372A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzElm4O1WakQ7kNvwFfx3Xq&_nc_oc=AdpmlbsUOtO7le-1ROP-7q3nb17CcJD1Id68P0OdG-o6UtsUPcwpLR6XSiBXybHeDrI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eoUvfYvX71-Xfj9RGgZCtjJHnwOfrd_naU3tbWPyu0A&oe=6A452916"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKhFSY4VyTYQ7kNvwHfkFj6&_nc_oc=AdqIUQibvevlNh8_NTzQ-Il21bWtusxacsyHC5IciQ2dRcTnll3dIKOyOlPMVtQzYOU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IdnZZv-wxV1FHjS6QHoxvChPDzMJTFBT9zoPgz8TgHA&oe=6A450EF3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4t0CHDxr9EAQ7kNvwHmgWkY&_nc_oc=AdoxKOLqLVYXnm7Hv9z0fxlVZ0KR6WUIQibiTYBCprS61ipSlkSrhaKNtjE7Sklb3tg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CBDsFpsk47LyCWApPEMnoa_F0tOSV503kt2UDAayTvA&oe=6A4507A5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsjP6-9SgUMQ7kNvwFh_0DM&_nc_oc=AdpQfxjnDDMfTAVzYIsMEjQqvkgNozjVYFxC-ftTT7k1_2anVEdUyQZ2vgMY2Twjt-g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JKGS26I-7aj6yDdBPRrdfw28jltKEDvh_usp2wPfSQw&oe=6A451F00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qm4jgt_CfkQQ7kNvwHyFtrW&_nc_oc=Adp2tlyJHD3mizIaqV4K2UoL4N0UrftBxZCsirb4PQAaM-wdQPMUkwQKwmaKTgXYmuM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fe78e15dYmr7yuYA5Xz9yoRHKo_uhTSXoxWnP1fNOKQ&oe=6A450CA2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
&oh=00_Af8760D6dAiP4S0Q1mnVg7DBWNNQh8sq6rlJAFWtca_dew&oe=6A4142AA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJOA3zA1JnQQ7kNvwFt7arV&_nc_oc=AdrUn9VDwvun5rT83NV8YvUZSTM6K3BLJ6Af3zUqtTk_5BQ2qco8XmkrQ_sc56lYbtE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XRANaIEBIiWgUqTO0uZ_iWK4OHUNm7gp5rhW8w8kuEA&oe=6A413496"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aApF8SjUoWsQ7kNvwGzk7Ob&_nc_oc=AdpYCqEsmthz6zw7l1hPRnPk2gZdm9Kc23AB19xPjdT_7Fo9xpNqLemo_xD0_X79zig&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0nve17RTXDyZD28nandYbKqYrZ_aSaTusktfVmFARLw&oe=6A411A73"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyaWFIWpzsEQ7kNvwE4lY4G&_nc_oc=Adrunt96RtWxywVUc6Mk3pQdqEDrghHClFeeuCg9qMVPUgXHL6ivOFZmhWlJwcqSUFg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yaoRFfkf4DTNgmwjSXq8DoWuFFcZD4Bvh3jcbTBj_QQ&oe=6A411325"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwrI_OZYVoQQ7kNvwEa2K94&_nc_oc=AdqLuV0vXjkNElgH0-Yf73DGA2brYlQPHNir5ks3eiRP7KNc56v6cf7upJMRgwHKYxA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lVztLUomMb4Gvonz4J8gNInYPk7egH5cECGoPHIw5lQ&oe=6A412A80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eq4t04fscwQ7kNvwFnDgTs&_nc_oc=AdqHPj8uVCk19-BbF1V3w01od2KodUKqoGPB2WNxA084vahdOtmjy5Mg56BQEpOFJrE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88t0ECm3gTk1fRdzDGe3jBj6z7FWXbcsvkuGrRr6jolg&oe=6A411822"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
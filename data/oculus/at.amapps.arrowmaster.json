&oh=00_AQHeAa41nvYlYiWOGlssNExWy34gnrJ85KIWj4M-T2-arA&oe=6A8ADE6A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_5S7FXK1iIQ7kNvwGoNo-3&_nc_oc=AdoEmZkDa-QqXZTlPzgFC1N7EhXOe_NEX_86siZ_e0J9HZVrYPTUQEx0RoCTJolGP-A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqldeuHVE5yfjiooF8JZnVhVuCI03YApYUbZ4XmqBHJQ&oe=6A8AD056"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pjANG6RFA0Q7kNvwEdIx-e&_nc_oc=AdpelpScrAc1r1xeNfW4nHcXeKS49OtXZl7uH6hIlSNBqGevWHptD0u41CHf2HRt64k&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDTkJdjCNqaDPLhTLrT0nuAmj2bK-qJ2dwmdMhf46pcw&oe=6A8AEE73"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_W7b9TKW9UQ7kNvwH1AaKC&_nc_oc=AdrPOpV6cf-UlcRymuDJ1LN1ecstRo4rBTvsbyWqfzxu5X408vU5nEeBMVysUV4_l8A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmr6D2YAkVT9G2LRkcIEcxjYb3YTQtdJCSedda27A02w&oe=6A8AE725"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5BbH_98FjQQ7kNvwFVzlwU&_nc_oc=AdqmThBe37OC-m5I-A6G4YaYChTArgGRyCTDuT7y5sI87fDpyoxZ1TxUPADavlQsg_Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHip4UVhTlJqxlTbo7fVlrHzWaxGtHe6RinaTpcstgiRA&oe=6A8AC640"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxhhnDHKDBUQ7kNvwHaFF98&_nc_oc=AdqxsSklfSn8t69g5SJZgU2Sp3p5MqMMqVYIPqnsd6_TbHaD8hQXD1m5LLdrVdPzsPs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5UzxZmxHUVKJu7539L5dLgAE_DsnPLmCxkkt7fR2lfg&oe=6A8AEC22"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
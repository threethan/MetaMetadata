&oh=00_AQLV_eX-37DZefbpcHV8yML0p_B3HybiRQ3a_T5E3ge--A&oe=6A9C3A2A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICLvdT2p7MwQ7kNvwH4mhQe&_nc_oc=AdqcvphKvUekn6IIbYNyswFG3j2AvfWrpmQKgNyRHFqL1Jbpq65iMH7BOzy_k_r7fLo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrYkcf24aZiraF885JwYV3YbRhYIm6mVeWuBFUZgRD4A&oe=6A9C2C16"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1D3c382XS8Q7kNvwHKxxjV&_nc_oc=AdrZ6ilPkRJrdsVkGYtYThIRJKLtHvP3jcozFhT8Y46qFdJM9jgHbl7AxZB3oOd_jhU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-wVC0TbG1hDI7-VTv3Hr7HwBEa807wM7lPV09oEh00g&oe=6A9C11F3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Azc8EcRRM1sQ7kNvwF56zYy&_nc_oc=Adok2P-DKZkwqptVsCC4ITVBXtj4NH7EvJHaDwR6IuTiAQBfSqoIljUndBDJUkOai80&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiMYXr65KAmTfIUgp2X-2vQMlQtBWjRuwLF64ZasbhyQ&oe=6A9C0AA5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rd_tXTXZ0U4Q7kNvwHM6DTh&_nc_oc=AdooAsAsmDAJxksFcwd9v7dtOLijROB0cPcPfsi8N4ShHdGK1rj-tBUIITvVwvrQ2ZY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKK71XajO_PhEIldDTzaI85TO-9rd9xD7jQI3UWjFX4zQ&oe=6A9C2200"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkLEYJjC9vYQ7kNvwGzIvhd&_nc_oc=AdoEQS58dV05-66RkP6mAzE2aeMJirR1xBMHbk5diVk1aphSSSxobqeSQhATTiAOEic&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhDTV8PNanMoCLMIp20FNjcILBhIhOurYCgkwQxdQNsA&oe=6A9C0FA2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
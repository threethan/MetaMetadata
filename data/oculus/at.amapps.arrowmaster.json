&oh=00_AQTH_aq9TOmHl5wqnHniJa7TwM8pz1TiYbTADL-cwzamxQ&oe=6AF1EBAA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkI1wvu400AQ7kNvwHen4SC&_nc_oc=AdqjkCuL-w1zjzJ4JTjEso-PlSzohDbJN_BOxghN5kb-c5N_F7n5b8Q4SatrrZOVhL8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTilhs3UG9udDwvXAHbA0HbiB1rPJyN9V2oQMVJX3LKoA&oe=6AF1DD96"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYR_8-r0128Q7kNvwEB_s6s&_nc_oc=AdrwRLszpfHjysiwUvLUnZCOC1GJRIJF3Bcoisknaig1_yJc9mIHhUxj1ZqNQZgjklg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0P6g7iolrld13ZoMq353R89ZiCP62CbJHwB5TAyrYpg&oe=6AF1FBB3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bo-ETRAjBT4Q7kNvwFLSi7I&_nc_oc=AdrTmYX15IruhhYJOWc61VhurMBnLTd7Reih11tdgT6881JaEZgO9k8kQUr4W8V7W0k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUKWbQ8Oo3wVgvWxY6gvWChVJXc1mPO_yTNijuMzgcpw&oe=6AF1F465"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMLY7gaNT7UQ7kNvwFwrvfz&_nc_oc=AdqJ9TLBx7SMTOALL6noOYgO6RsQnBZAVWe78QPcYL8Tdgrwccwh94AfEASmBF_GI7E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjQ6PNd7x1OmEAAEDxTaZafI4yLuA14kR4VRPC0XAX5w&oe=6AF1D380"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mS07If_z6bwQ7kNvwEyuA55&_nc_oc=Adr9GpmhAsUCJDaLHYjW0lv5FvO3q54fIU-lV42eFMjipYGtSzQC_BaWby3JzE43N7E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN-MZ2cV_6Pce0uPJSX-OJqzM7TyyqZ186vwVJeVWrew&oe=6AF1F962"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
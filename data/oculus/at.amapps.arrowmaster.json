&oh=00_Af7CAJfiO3Mt4xpzlrMXwAJywSlwae13Dy4W-hZ0AFwcFg&oe=6A0070EA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28ooXgQsqzMQ7kNvwH3tINR&_nc_oc=Adp3hUxiZk6xOwRlT38Nsp3uO2yRQSDar0buEy4_sNNYz2IVrl_NV_40CEQ_0wCGaM0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63wXlJRivVsEUIK1va_8cEdpfAEXra4xpC7iksb1RlLA&oe=6A009B16"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bRJw1XTy2RQQ7kNvwFHjbPf&_nc_oc=Adobv6gdVLOyRlZDtL4dt9UMhwxU5NvR7-a4MToZCrKl3JFosdXAxeMZ-iXeVN468vA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gjwYhrjh1x70jhi4vhqrz6YBhsRapmMXgglB5R6wY3Q&oe=6A0080F3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20gI9ZlBaToQ7kNvwGw7hJ0&_nc_oc=AdrAcN09dvdIQo9TyLe1emqUBtXCA6koD7P3fQ2o24i2syHveIxqwAiZIXQD5qPbVrI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7w1OuPyqOcvrZXejZqn5ebY-66zBnn-7jj5MrcUSPPSg&oe=6A0079A5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZ01OEDOAkEQ7kNvwGNKd7-&_nc_oc=AdpTUT-ILlR-qgv37rSmmPrsYgwr58D829spLrZP2vnUuZmRQekDCmhrdqMsWBr-QpU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pWhPRnPw_bRy5njv_y3Vgkx5YRTqeHSSl1bONcNS-9A&oe=6A009100"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYY45kIg4OgQ7kNvwFrpH7v&_nc_oc=Adp_L6tGLDeLZrkEqDBo38jk_TCz3okUFZTJl9GwIY9TYoFm0uonVAJcYz1uh6TnF-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6W9X9iv1wBP7yCyRh9kIYtbueZd8bWSJsj2m6AJVXkVg&oe=6A007EA2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
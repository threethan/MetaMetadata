&oh=00_AQCxb-yn1zyBmYCV7dKXaMNn5xIC1j_GfM5uKab-0PkKlw&oe=6A537F6A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4LewajeomcQ7kNvwHGevX-&_nc_oc=Adr-5imoXQDvmSSMGk4Y35g5OhCl1xojzWjKFbxiz6TuSu58T_blmem_FNBsb42aCu4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUakrMvfv8UepRGJQddlcCdL11sLzlgX6kT-kBe9QVvQ&oe=6A53A996"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFr-uS9fk-8Q7kNvwE7EHr9&_nc_oc=AdpndExG6SeJ--hxcpY29lRUIOXtO14tO4c6Zrrr8T5hWwSFtuGPcB3na9-4jTyv5DI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVb0F0vLMOGsPga9BtP6fwF6t2Y7vo4HGT_AA1J69z6g&oe=6A538F73"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ea34YJpUs8Q7kNvwEReNl6&_nc_oc=AdrUFLOSeU1WtIn8oaJ3sEU859cB4HYvlqzWfs1nZd0dqmWby4BWzDq1Sm0VSKuHwZY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXl8h52id0L5vRlV91W5AVFzKUmHZlKhV3IGWfJmBzJA&oe=6A538825"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsG8ZeLmJTAQ7kNvwE81WCy&_nc_oc=AdqYVHllAYOJZ_R2l83_I7z2x_f8A7Rnk3OLDRAzqeFrRHag9SJW8jUs9WQptPeSl54&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBELv-iNRRN5F4eytxK_aHZLtyuCmmIGVZ1W43SbBPJZQ&oe=6A539F80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1tGqiFdPWUQ7kNvwFP9fdR&_nc_oc=AdrAxUDiTtw0fv4Hnu5N4qF-UmsKyoiyZIi4T3WERgZJAPGE0G3Zn2tGUWL4IMGkj_g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhNjZX_IhbJPohLyeVhn6xncAOhsLTxHIMYeBTEOIYPg&oe=6A538D22"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
&oh=00_AQDKFKzhNtYCraajfCulfIcvJ5N-plfzL0tddLclNUdtcw&oe=6A65F46A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9rE3znsvPMQ7kNvwHTQP8v&_nc_oc=AdoHnRR_Dp_8zWJgEpHHWThTwHkirgXU3PrveJRCKYYOgC1KpCaaifMUlo-wpLaGF9E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFIZy5YAoYWLktw5qtELgzEOpyAf4uua7E1wZCcQgMSg&oe=6A661E96"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfmWx1i4q20Q7kNvwGVFq1p&_nc_oc=Adp9LYvN_kxuC1JqmtwcVZ9bARra1Hor8IiXWlA86LLMsmSn_PYoEBzMtIbKBnr2FOk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBorIVtuQabpfs3mda7YtK4Mvz7v9L8zCpWces8M17biw&oe=6A660473"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72jrDZBHkn4Q7kNvwGZCZky&_nc_oc=AdpPsLohQs8gweqYesQHFxgwrCGPt6uGkkOLWirnZI25PageWJ8NoRyq2gFsAh6Gsqk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSxdB8HAtuBpc_GTHsoCoF55x4szq4heA_kuT0VK2GrA&oe=6A65FD25"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_Xu3-iod1UQ7kNvwFhoCGn&_nc_oc=Adqht3lr0_P2SVPI0CRl3NUnREEWBYzp8WEJUQ0GCVCBGmu2a851ANFAIRDYWSpHRqo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCH-ai0168_b00KuDQdk-3KH4Xv5hXbCHGDx94s8LVODA&oe=6A661480"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVFHHuWdSJ4Q7kNvwFpx9op&_nc_oc=AdqR2Gb92aCLT9cekWkVIGiuU2F9WMzpUxSGwdwbinZhWIn62HImVR6KbKn4pgNPAuk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDI4sDu1txTv5CVoasbSpZ6AAy5QJFR4svcPRkIYniYMA&oe=6A660222"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
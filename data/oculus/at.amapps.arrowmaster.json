&oh=00_AQCZ8Nbuw47maZhXUy6oWbBdvw3MekAqxBth6-A7zO_ajA&oe=6A52662A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4LewajeomcQ7kNvwFNsI55&_nc_oc=AdoAA21KfqmhPMkGqHZGw7K_9aDPK0WmlAx5WMFxXnHWGUihqVUPZJMH24-YQrndPPo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjC5XXyp1XyFLT3rdgEkoI7oUmd_uDXgXIyCHWfRH4LA&oe=6A525816"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsd1cD7ueL4Q7kNvwHdEPKy&_nc_oc=AdqaJ0mftlvwjlSu2306pt8s__vtb-Dxc4BoNX3dUyo1YRjAEAELeT0-EythD3_4wTY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYt144ccuj_ATsFi2sO47CJwTkhGAJQ_-j2vK23iJTzw&oe=6A523DF3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ea34YJpUs8Q7kNvwHl_Izd&_nc_oc=Adpne0kO1-J5FZT3CQ7gIbq806JxRm8Ny3_G-Oz-DnsJNc3woDGd_jLWxhYlzUg90cs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDD77NPBu8d_IDMyPQBQj_jCtqV9a0iw-86U5-2aMEdcA&oe=6A5236A5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsG8ZeLmJTAQ7kNvwG3bQTT&_nc_oc=AdpiHlGwuK5kDlAnjYF3I-vZlsiS9Jo1eK95897nRtcUR4828xD6NZ5Bs4X0HmIACt8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAm_icrcsAoMe5r-_Gaz1xMvSbfxQDsQxLzbKGSi-CLkw&oe=6A524E00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1tGqiFdPWUQ7kNvwF67IhN&_nc_oc=AdpO6kjDHyDqLTpH7DHW_oz-PIY0s9kAPy1CxklS5sVqatCHFAPoACB8WpZEFYJ92fE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmSZvzKo7K1Kv6HsbhKUzKD_LPkn_GToBQ7Jv-YvqflQ&oe=6A523BA2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
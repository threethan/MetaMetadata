&oh=00_Af0WCtD6912WE9knEUZwAoDzop2uWwjq2YsDR_Gaw0ohLQ&oe=69EF85AA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnzHh1tw4C8Q7kNvwFXl9Dj&_nc_oc=AdpPOrY4DO8E9RVSeNR0MLMjfc7xdRXrwQvWprNOkR4JHmZpIUvgnK5e2xV6JDdTp6Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1IsiXvNKYaChS0yf8IzuVhOSqUEOHYiPsA8XDJzuD9IQ&oe=69EF7796"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pg4mK4JX1ToQ7kNvwHjFJXz&_nc_oc=AdoMuYLT4xmKzScvnJn6D1mzSOIGIWT4a5pMipoMC326rYyfCZPFRPyHTiLdZwHuqIk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2jS89lycOr1Z8WZNX_K_7O8ti_xzbAxi5E23WyzdOhkw&oe=69EF5D73"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KeS3PpZJVkQ7kNvwHfGUUW&_nc_oc=AdostzWlvRpMpx1scj-_9n6YF-Bf0ndFqAb5UTP8yM9-ZP2En-AV6oUjO-ZtC-7guZA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1_B5aeXvC-nHCom8yNjTARfdtd-t0K5PDksRcFmzCgrw&oe=69EF5625"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OChtXYmJH6EQ7kNvwGRjkgS&_nc_oc=Adr7KpI1YtF2H5dDbBP9NArMnEbpZWqFwtRJ-Cduwg0QkYrlSPWT-UDLWfnPOoIudXM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2vNEaWc9ReZR7c8qv4YJeciomjYo2WbymhZMAqyBQpVA&oe=69EF6D80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WxtD2Q02ykQ7kNvwFl3HAb&_nc_oc=Adq1eRn8oniwG0qsyGF3EudZA2nkaUnU_aud7Igo-8nzAK72479eTGrBl1mSdWRJzEI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1GwOqZPqu87l5BurooEUHDbYgS4cBCkZg47ahZHkHvVA&oe=69EF5B22"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
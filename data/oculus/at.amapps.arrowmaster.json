&oh=00_AQKvOaPUDNdblZ-vfjE-EvuG_lPi4hsI_J-fKNlxO8LaxQ&oe=6AB2A3AA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6-3Myspd94Q7kNvwFqOzlF&_nc_oc=AdoEW8QbcykBLYBwwWeBKloQRf-oBuvp6xCvF3fvrdjR8YDIhwRaxttEHo1UofkTUWQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjq7CI_O7QKwMWH2fvLWqimbD_QbL9oMuFPEgdBoZUeg&oe=6AB29596"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LypTRFkAMkQ7kNvwEIEW-E&_nc_oc=AdrCEdNGK6IGEOGzvNJoAnFF_J_aJsad6HQmBQXlmZYmnZwVDX5jnbLFiG9LqK1XQgs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXOOeJ02Dij9riMZWBAYIGmvOoOCBeK7OB3VTalKyemg&oe=6AB27B73"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHQL8ZxpcEUQ7kNvwELO8Vn&_nc_oc=AdoAPXha1dfnZv5fmGD54aMDmkk7-sV1lEJsST0vhvIAsxxSlThACLmpBp9n_qygc84&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICMqMSYV5GtxXFgGddjvVoi_kBRDBbBf384PFvDZQdYw&oe=6AB27425"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyaxUcDeaFUQ7kNvwEf7rk1&_nc_oc=AdrzMuGHu2zQKtBrXPHWSnQcvFOVvMPybYPTbZQ7j7YngCbMaXKEOvV8PY5a5MWqYvE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZDXtTxFWcxfkEnyn1C0lRhv-3PojCXjGDfzu2Az5jeA&oe=6AB28B80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hd6NRQlUMyMQ7kNvwEqa1UC&_nc_oc=AdoKFAj684bEGqQCH0MyDMLljXoEkHmOedz5nFHNgop7IFNXEiYsggUjDmagCHSsRTE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvj55jndKpJr40muFzSZVpdtw9XwpYqXYaonbDxX_o1Q&oe=6AB27922"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
&oh=00_Af2MXXk4Itjjd3kIrDmyvkjvpoaEcYPiHFM6yOOwKQMKwA&oe=69D4EF6A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksw2ascVEd0Q7kNvwELdIa_&_nc_oc=Adpp_G5GWG5kXlkBKu1Qx5puCXgNHtLjlC79_4A_ACVsSSi8vfhY9oaHzJCBd6NsIPg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33PUGWjDOK4NdrShZb6Q0Yad0RBITxkNVnwS4eXYVUAg&oe=69D51996"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66rqlFatNY0Q7kNvwFEXooK&_nc_oc=AdqnfhPWE06M7BnQtdPb9B2xaAH2J-k1PEYo3AlZPQcL8gGh6EoBYU7w_A1K8IMnj5M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34wBEjJ-pJyP35tkymtke6Ifvlt2Lop9ZZ3t_j9vtGEA&oe=69D4FF73"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOvGtuhCvtwQ7kNvwH_fgqs&_nc_oc=AdroWIEvlIirJLoI0FqMkLmxZkpvODfOm-DJ_hhUH_veEUyOgfUKJx4uVtf1m6DEJqU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Vdv9-8osw_FgyK5dSwPvg4chAyHTCwYtG4WLds5HpJQ&oe=69D4F825"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-fMyQC064QQ7kNvwHvNYnw&_nc_oc=AdrZ5KIeV1yhnPapzdgXJqoHeBoN7dzXScr1BgBbwwwulj9_BKylV-fx3BsZBPI0XUI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MYTGmTyOy9eN0FfL3NqWKWWW_vHX-DUgDIXIau7OuqA&oe=69D50F80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOGzU-wmpL0Q7kNvwH4zTzK&_nc_oc=AdqzMqmmhnzal3qGArYPQ-uUDdlFQcjJf47yhgQU0eTQq-EJP4bq6ID4HEKYGWZt8B8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eoKVljm1B-7qml0kUosou_apuFe-zjYKerHXbIojtwQ&oe=69D4FD22"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
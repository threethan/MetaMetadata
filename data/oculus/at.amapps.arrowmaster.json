&oh=00_AQKHpprMNM6d-4COGBtIBLDv6xQMeTkidK51awvHLpdyeQ&oe=6AAD5DAA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaHqw5COwtIQ7kNvwF5Jr2G&_nc_oc=Adqj-kmsS2xirZNuJyBQcyOFHhP3mNeHEjiGBsisGQzt6BHgyZGI_tkeE0jMbcKcqaw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBZp6bK1KJZtd6I_yBPq_k0izpnC1yWnrqaG-7F7AYiA&oe=6AAD4F96"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-GRzDEa_w0Q7kNvwEcZXuc&_nc_oc=AdpTFFoMOyepZZVf8HvLsU2wEwTpAWJN4-6wzM66TTytfZLhDhtbN4NRYCrhiY_nAuQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsZ2qHbx6fLh4Qnfgv61poh_KgOatyXhFUriPTxFspCg&oe=6AAD3573"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ad2JMaD6-UMQ7kNvwF2-p7s&_nc_oc=AdqqqW0SXKKZkzoV2UxVqSu3Pr9-g-S4SXQ8CYOyUG5VyHfpiurpPFhae6_Qg0XWDuU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlsjHU78RjhQ1LYbLlh78WcXxVKtBmMgluukGyDgnZYw&oe=6AAD2E25"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Vy7afZCzh4Q7kNvwHVNEV8&_nc_oc=AdraJTYCE4i3ujOHBNk0wEqVBLFHC_hYRqA6UgvADMOTo_Uc_6X1ZwuN3Bj5TFf_W1I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAVou08oKP9eQrnGmeLaV2xKDKQtLs37b2mVu4M9RXxQ&oe=6AAD4580"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4aN30rJ_dAQ7kNvwGShUAn&_nc_oc=AdqDa7fTuXinl3hE8S1IVeL_h2R4ZJSkXmAgKzzd9SSyksxUcNEiMxvb-rocWJmRBDU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIR40fc6Cn2_C_EARVni3CVFH_riCWfM5T1QhpydS5lYg&oe=6AAD3322"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
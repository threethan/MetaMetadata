&oh=00_AQAzw5qJMDLCrX109yIvI4jVod-Hh4BE3ABi24KarANohA&oe=6A492BAA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsKfNxypZ9MQ7kNvwEjn1ZJ&_nc_oc=AdqSYv5MY8_pqQqxIyvY8cgEyOBBXMsN5FAuYzhodH44qKdvN4LOKbNCK1JrUduwYHc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8uvxxInjNUqeiHViz-sprJiBRVbTPc8UYNpZl06clLw&oe=6A491D96"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvUCz7Ib1a4Q7kNvwH5cS0f&_nc_oc=AdqOk2yb96xsN05-PzFZe-aboy1uW-SlUtJWAQMQ4lNrLkgmZdgE_1ShE7PTCUuIK7Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPLZzPaCIk9hFNBY7TKd9dH5WpBzQCa7yLk3SPB1oyTw&oe=6A490373"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qiLZOnOnJ4Q7kNvwF5S5Rz&_nc_oc=AdpAREIB44eMoZ25G-yY9ZgKyjjzXidzCYGoz3Jjqxdzgkkdi_yQ0V_RlDwVPq1S3oo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDd3F0mOqS5w7hLVmqy3be7xzg7e6z8aiHx1imDqaxUMg&oe=6A48FC25"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdO52zPCIwgQ7kNvwFzOrqL&_nc_oc=Ado4fs9RhDLxc00YSpYiJbXpeQ0pPjhz1RVDx-vURNsqRIosGSlO1w_NV92J8EpoJk0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0pDyUqUC1aI509tUwZBVk9yI7_eXSscRRMLYpKYc9sw&oe=6A491380"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_l8H6kbqpd8Q7kNvwHLv_fD&_nc_oc=AdqrxB-A9fd7Zi4rKk0rwL9cdOWX7ZhiXJp2LkrN3oHTpvH60ZTRSR9kR5np-dxY9kc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAslRJGbHX3kRZEWg4MM1zJUygwf3qrkvJZlHacOngfCQ&oe=6A490122"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
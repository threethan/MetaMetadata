&oh=00_AQJfo-6_MWlUiMhToEEWbqFZg6N2TH8SzU9HHTwuxWjMEA&oe=6AAABAAA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nAuRLGwjTwQ7kNvwFPha5M&_nc_oc=Adqw_kctOCZ81ppg0Gwt_q5-xVcUtt5Dey-aK3mkFR03T8dhX0xGz6JXll6m83kRGZw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbtR0RuD_U8Zg6bAFWFGrqE4PSJvJSTpAMxU9HKz8M2A&oe=6AAAAC96"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-GRzDEa_w0Q7kNvwHJbO6H&_nc_oc=AdoJWXWmG57Gubzcs885QHKovr-0wSRmkp0LT1uJtG3s9-ooXjYmY9B5BWGcqwluO_A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaPQS2XYFQCoeU8j2nrd9Obe-CK185eWEXdCzjj6564w&oe=6AAA9273"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83dOp8SZ3_gQ7kNvwGA_4bw&_nc_oc=AdpSikIdVmVRMOuSEV2fv9DgCwQjpwRkfmRLDJKOoirndCbPEYDYN5wQFF2K8KPZD_M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAJhw6eLLmvHRh4SbXMU2MLJ7TYztaCMo7dxP8jt35YQ&oe=6AAA8B25"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5BauqZaDT4Q7kNvwHXR6_o&_nc_oc=AdoyUjcdgZOdkx_hTHc7T3bCCfrWXXijGFx_aD4Rz9wuDQ73lGXjaB0vqQIGm64rNjc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLI1v-VCgdHbWe_xoubda7i9EebPdIqdc6v7YmTVO_mXA&oe=6AAAA280"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKZ-Y31PgIYQ7kNvwGD6q4t&_nc_oc=AdqGycL8R7NAvb6asSvr9-vAEiO48jJLwA6QZHX8n--YYsMSXv_EARG7hZSpMIfBZuU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjjuDnIuZ6EKBGZ-5P4slEzooue9HEkaCUqWCjmfuUvw&oe=6AAA9022"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
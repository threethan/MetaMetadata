&oh=00_AQDwuNClIvAgOPj_Zsima5N0mFzPNRg7T7dx5n3FPD776g&oe=6A5114AA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjCyRrFppHIQ7kNvwHw8GuF&_nc_oc=Adpr44e41seo7gNPu-K0jZYsOzGl5u1uaJlImKtRIwRm-DuHFPYJUvQkM5tdpafx_6w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1h2XiBAQ_LfSmfyU0L-wnTe5dq4bAN0gus5_aLA-X1g&oe=6A510696"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsd1cD7ueL4Q7kNvwGRnXzX&_nc_oc=AdrgXinYHS4v5pkaMjYfjYMh3iNan5IyLf_EeVaDCepQfzxx4TpD28GJvxUPEoh2FRY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6E8i4MZ1Wcr5_m3v40KmUfrWRPRJbB4UNCBgY1OI16w&oe=6A50EC73"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ea34YJpUs8Q7kNvwHZDfYi&_nc_oc=AdowtHP8Z0XDip2sP-RaeHOvKu1ZMFqvVQFoQyrgYHmXWvfgAZ500Ikn1kI3r2EcnsM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7W1inQ_DHVLTMLGiW-2vkUt-KKLC4ELxyszXEeNcXZg&oe=6A50E525"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsG8ZeLmJTAQ7kNvwHoe5FS&_nc_oc=AdpRDGy8zIGEinlc07aKe5nhAk14xOWzwloxvTCgiP_lxB2UVAq-Nzet1ZBdF3TR2jw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNdiQE2HpRRrvDr1bPhwUsUDHUA-MtFdqDWDZ0hoacIw&oe=6A50FC80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1tGqiFdPWUQ7kNvwEYWfPk&_nc_oc=AdpLiByzxUAmk6FMF26Es1xi4bEGuCtHo3HGUOQQpLInqQnbZIyJneHM3o5pNZICG8w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8Y73gZ5_qR0gnSEFjj2uZOMjnJ4kgUmS82o-qF4Yv3Q&oe=6A50EA22"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
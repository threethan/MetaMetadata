&oh=00_AfxvG9IYpLdpu0KJ2YydOKI4UrbFK0BlpNE1mq3vo4WvJQ&oe=69CD066A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFbQbEOFX6EQ7kNvwEbuB0p&_nc_oc=AdpfzVIy1uklle648xtl5YWTUiwnM5LKRnVma5IGVsofi17moGlHlulGEDQ6tvvdYX4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw6tGzkL0wi61DPp77mLu07_yxUB1ahqIOfnB4SPLJRkA&oe=69CD3096"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ca0k9m7fr0sQ7kNvwGkBbia&_nc_oc=AdpNGfUJGJSHWKlc8P7xnZohL73OAroLzHCPyfigt62RNafLxMS1uf-G7JdoMu9rJ4A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx6mMiXDlihKxu6wVQ_VXbAq4F851Yiw11OOnjFl2_KwA&oe=69CD1673"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KELWPmfdk_IQ7kNvwE8dJOt&_nc_oc=AdpehNImsyEsuAAfotIYP7WjDdIcVwBMfRSyYykscRtBvP8IKVHbbRGpYTCXxKVdyYw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyI3ID4BjQd96b747hp7Fm5uSuLowzdL5b2mKRHHoKMzg&oe=69CD0F25"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDQTBFUd0WAQ7kNvwFILOc2&_nc_oc=Adq3f_Y_5uZpa_r0QLVOGhYOBYpdQsWY4XjiywdZNxQpw3XiQ3kl_55cyaW7hjVJYZA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNrTJYvEgoCtE0JQ0RZx2-a--DY8Y6R5aFBaoz-g8FUg&oe=69CD2680"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzvLSPai99wQ7kNvwGvGn6_&_nc_oc=AdptbZZfcnXgKn09uRiCG6KXMU6_CRaT4kbnRvPiJBQU1vn14V0zG3GGJJWbQjxUcbk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyuh_qr_JyoDIUHlOvQpoDbfIR-SBC5oEQWwsoD3WOKxg&oe=69CD1422"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
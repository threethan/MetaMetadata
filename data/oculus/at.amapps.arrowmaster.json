&oh=00_AQTTKWXgy-le6On1S5odSw9mMHZcGo11swh9JE_LvCCmVA&oe=6AECA5AA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmW0x2TmEYcQ7kNvwGhY5BU&_nc_oc=Adq-zB0VV0vbZvrmG3KykxgLIX69OEuqsWNJGYCJsZBlSDNIAtq9ElYmo7-S2vOUsDI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2lCwj1u-PLbGQQX6IZIMwCUjo9XxdApPorL-4Ry0Wuw&oe=6AEC9796"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqpA6TQtekcQ7kNvwHE3-So&_nc_oc=AdptRUh4jUyOnd-pAwrSy9dIF2wYSQB6l7lf2vyvmOn9pZnpjcibiJKuch4EQhIYrAM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuBs4cbXRvn5n3-I5xRvSKS7wQIzwets54SN8DTY69kQ&oe=6AECB5B3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLKKU7UUnBIQ7kNvwHGrWTj&_nc_oc=AdpXiK-KKUGo4f7vOhlQKhk5MuuNRWrVngh688q_tjj5v-4L3-E1YcJExM3cxt64x4c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBxIXnHGYdCS3fshedA9EC19ycIY6zoYWIsdvOm1IDzw&oe=6AECAE65"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qT_IM_qHX8Q7kNvwEHXDfv&_nc_oc=AdqH2o6bTe2cVhizDaWycnEimSpftXg4xBseDqIsAbu9_c0FU5HziT47FsZJAE-3ZEs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuVRJbE8Goh4m_p3-zuR-GoA9c1GaqwcZvM05hjryeKg&oe=6AEC8D80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jg3DO_FBm3MQ7kNvwH4rbUb&_nc_oc=AdrGEryTJN1kXLJg_Ju-2VoBo0t0wO84qoMaRMupxQMQiNp87TIUZmNhrr2evjJ5n_c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQtNLEYcqsuJTUltgoY_eL-stsMmUAY5ztZ3zM_utTgg&oe=6AECB362"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
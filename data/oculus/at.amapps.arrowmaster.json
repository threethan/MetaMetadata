&oh=00_AQAegfm8oCnSI_i62s77EuhTCKn229ftHXkKcbypsOYQjg&oe=6A5CB9EA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hc8A5UMBIE8Q7kNvwFmRVfu&_nc_oc=Adoi2qDx1WOCh5YE-6UEPfWC2km9_EHgXDFRlBPBVnKyf3HpHPf5qKmZ5QnYqfMOiCQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdze5uQhJM_uQdiFFUe1OBpGjjv199tSS4IL8MxUwhBQ&oe=6A5CE416"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0y3yCKY0WgwQ7kNvwEEUa9d&_nc_oc=AdoYWye_1tCjIP5TMDVL062n6tSGyc68DJng2-B0WJszcpnpkxMN8YnhYoOtc-pxluY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsXRKJRomTyLsvlvfjndyy58Zz7FEAl3KgCVzXDg6Mvg&oe=6A5CC9F3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRM0SIposy8Q7kNvwGVMQVn&_nc_oc=Adq3pN6SceoewrAnjJYeQMGXCMxnxO9ahX0LVut45Bp5T-exPVdWiNoKc3Sjmd3U85A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhDaQ8RVs8y6cTLWw3h3a2Xc_474OX047cM13KtcrXKw&oe=6A5CC2A5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGwhgPPR_wQQ7kNvwFBkS5S&_nc_oc=AdoacqZTtYWilFyRdANuxT5Wk__ThxvHzHm3wNowKmw2ecaQ9n8ItdNMHcJkbTiyw_I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2QHU2YDeU616z9OYYa_YSmlGCtWeXhtLd8Py4HRTKMQ&oe=6A5CDA00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaYGUWov4MUQ7kNvwEcRCQK&_nc_oc=AdrFEtl9YXzChiKc6aGB1_ss5bGKb3uEkw9hWbEtcvCmOHJZnFrp3rEoDdFIySUnyCY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9rlRrVinmv6NcHNyNpEelieUUNzS3R7qjeHxw-DeFuQ&oe=6A5CC7A2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
 "746674656693373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBWEpsBSt0EQ7kNvwE_V04t&_nc_oc=Adkbc0g-rAuNV0Xqj2eq-6YXkedrMGtynhzfthuZ8jPHrL56KnXhTCVzEYk-IhnmvQg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvHxnAxDVpw4jHNgqtrz5koANFbf-lk0GYonQMErNVU6A&oe=69A02556"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAUPhFoIMNIQ7kNvwGtOVN_&_nc_oc=AdktYrIbK7Ipkt_i5VaQm2qp8oDBt084q-ip4P85-kke9h6rxN5G-5ynHC_QjPam-l0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afse4jdgRDIvi2_kTTe6d3K8YV2HhEEkK8pzp-f72CGPWQ&oe=69A04373"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTtN5d_WY7EQ7kNvwFmXKda&_nc_oc=AdkRhrKReb0goNc1gTjctkPynpaF7GxQdBqLQw2zlNaaKUVnL420W1xNB-sVzxMND48&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvS_a9wPHzx0M3pO69tRv5lPGszQoqoxspfbGGe2KNDUA&oe=69A03C25"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iNVLg6wXFUQ7kNvwEdlHHZ&_nc_oc=AdliZkKNTvATCOCa_72Glqnj4jQsIBx8cmJicY4avZJC7IATI8OQ-FCUppf3PHwgchA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvR-3SJvO1ij686eEjJ1bqv0z8up1wMQ7bGKrvfNmRxmA&oe=69A05380"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rq7do0tfg4IQ7kNvwF_lbGJ&_nc_oc=AdlRi_qBRHPiMpIEx-QM0fDsfLyu_K3tQokj0oDMgJuhpzT9WxSPgxYJyIbcSZ_RXIU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu0bR_EYy5Yho3ZH1_mmlvdZzyDW2pSmmIuIwV_85n_XQ&oe=69A04122"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supp
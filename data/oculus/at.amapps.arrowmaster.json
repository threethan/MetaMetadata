&oh=00_Af6EJOs3_sX9TWrX3tt4J6BDmFLWfaWcgQ4z52JfQ9Z-Mg&oe=69FB2AEA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEaqfAt-zV8Q7kNvwGUhpNS&_nc_oc=Adp9x5Ong5UeQ4Jb4tvEz358QEzJDVNFUWblDPmvYjUufKPsJeVDY4-hmaD52I1iVnA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wkrx6u0rm5wHxMlqArm1ySDTd7YiLIj__7kxeNtaejw&oe=69FB5516"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2IIxu9_ywcQ7kNvwGFupPM&_nc_oc=Adrc_rX6bxACSEldVF3ba-AB-TH01Cb8htJDbv_WQG9Hwku4IFwCt-bjqDcI8tZk3Yg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7reiIL05t1W-1crsooGocE4GExiXj65d7JfwwnVIwC6Q&oe=69FB3AF3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2aSZBr5Dh0Q7kNvwEVKb9s&_nc_oc=AdpzOMliSqSvtGOPZr0M3u-HXsY0JyNZnxb927uB3LJKOcF14bfhCoZzoBOFFxc2RKI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gzNk85f5cB5Q-thgQn1Kll42eTXGPybxcBa9D-z3Mbg&oe=69FB33A5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgTd_CkfypIQ7kNvwGwt9P1&_nc_oc=AdqPm1_wube4hOO_tQv-zTTatWOOZ-AjJRxcsMBXPwsbo7301IjrY4PVUD_U8_0A5IY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ToyBbP6ewI5CfXqCEK5fwmSW2BiIFd0jsBQPhyGc58w&oe=69FB4B00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrUovelh2FMQ7kNvwGPka61&_nc_oc=Adq_v3BRiO5pIynmv36TQBOZC35PlrTWgQ0g3mgeItPUi4l2PVkNlM-EaQpUYuuHk2k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oFCQmgmw53d69K7cImL4NPswQKEBgwIoUTZ2UF13t0Q&oe=69FB38A2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
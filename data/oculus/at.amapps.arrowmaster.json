&oh=00_AQRoLncQYhO0DormNfJGiPWbmljxLqnuxP9UwW2HHUgrCg&oe=6AEA02AA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDbdD2JWOkwQ7kNvwFVbcP9&_nc_oc=AdqufrbFHy5kpROO_x2mzvInpCMDqfi2GAP1Re30Ok9Ztkn_O6N_yUhrETOWadYHjkk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-Vz5oEgGP5PUho9rU5NKWDcq9sfQs42yGMgaiA2fPCQ&oe=6AE9F496"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqpA6TQtekcQ7kNvwFkHq5j&_nc_oc=AdoHEgE5LVm3nhuFMxw4c8u5bZUkOFKEcm2JA_0EHUr9TupVaqm_PUYp-mg28DTRj0k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTqWhdHGfKA6eQqro-y4b9jex_bMYap0BzetVPL1JH-A&oe=6AEA12B3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Db4WDd6I7yMQ7kNvwHW6wc_&_nc_oc=AdrmZJCvSC5qP-J-j7XIAtLR4HBIg2ODMYDGB33dKb0gJjJED7WMqhQ9VeRIlkuyox4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_2e1Y3kdyD_7bE7gTH6ZxXIOc_5PvfacoA6ejtH1Q7g&oe=6AEA0B65"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsT--MO2z6IQ7kNvwGg395x&_nc_oc=AdpBnVYDlty_WTZA7OHvzbKRYMiAjcoa-K2J_5fMIdbEP_lusm_07E_xCRNjXxMkidY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSA2tMDrxLPhI1hTbmvNzHPGW75geLvpKbQyCFgzidvmQ&oe=6AE9EA80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dd4btlhK8jMQ7kNvwHxKbMX&_nc_oc=AdrSV2jkx7HHpqm4X3CEVEfEizc3DNAs1EKSzow1we2c88ckPoik2vx2KrDnAsOZopI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbuNj3hLSXpBvGC9CDIo9QyhhtVgLrH_gabJ11VKP56w&oe=6AEA1062"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
&oh=00_AQOrkpW80AmY3AN05aO2mZM8H-WSZFPRtr03f97M3KGuyQ&oe=6ACD01AA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbFos3BgG-0Q7kNvwEzfYOn&_nc_oc=AdqCQcJlCLl6JgB2o8_Ji1TKMs5wN9JGfJHe7wfUmqEBQ-3TbchmQCbu2mv-5oiqYk4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvOwD52sGvX_hi-8vsBERI5zBGu6eUAEYR_kh1GMx8cQ&oe=6ACCF396"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wudE3QpFR-EQ7kNvwGqMINU&_nc_oc=Adq-0uvyTADbEGbsHYLJbmNri6HNqKX2RbgUrSoSuZW7xF_mhpXveUUYOSBofbgtzME&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhLe2hS0Cl_FQgC0ZF6Cad8ae4lhlPGqj-TFIQsFKErg&oe=6ACD11B3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chPdKgjvytsQ7kNvwHWcwda&_nc_oc=Adqqm7X6SNGfXpJ_hMjpujGl6NQMAhNyxRTg2H6154un9R2pVmccfMEUPHhT76Clr2s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtzMF318j71iotBIPrCW5ybhcTcHry43DUANnl2jHA0A&oe=6ACD0A65"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyQgr-XwWewQ7kNvwGCfYcO&_nc_oc=AdqnI8Rv9GFKQPlT-rQb5K3eMPKBl7XuAmEhb0FdE9P9Keo_vZbljrxCpvUhqFjDzIE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqjFjj-omO_5_3JmpFkd4yUwUu7RU8MkHCkwyjI0fNag&oe=6ACCE980"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAsGQqOqJUIQ7kNvwE9-DBm&_nc_oc=Adqb8duRGhtXxtsqkYl0pKzUF1RdgVi3XmsDJuDukrHUQWH0tDAQgRglI2gP_mVbq2M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGaSbzqAZqWWjiHIXAd9UFvSzlvAxh-bBQV1_x-VUjmQ&oe=6ACD0F62"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
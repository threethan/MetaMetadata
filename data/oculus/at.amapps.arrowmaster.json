&oh=00_Af4VsVCiHtNiefn49NbA0qcMz70yW5iDjaZ2OqJwtO3sbg&oe=6A1DAA2A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdH_GsXZLUMQ7kNvwEobfsz&_nc_oc=AdpkUQt7z5HYHzCb4btxkvzynB9NVhcW7mkl69ClJA97o7LPysiPE03yeVV-boPecX8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5r-ZPbaCOtKraJC7HHvFcT7Zt8osK-dIhTHk-oKYkRWA&oe=6A1D9C16"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOYqc8XKwm8Q7kNvwF7x4_Z&_nc_oc=AdpAHSnH-N--IUbwvXLDFxsemnqu99MdtEVMgByGyCv7276mckQJS9twMSSxigH6asA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TAyoeR5fDPujQ_eSBGdb0WUHG0su3rauRVCqKiWVIbg&oe=6A1D81F3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_B0hfUoaKgQ7kNvwFztU4G&_nc_oc=AdqL5N2ESSSosPdtZ5Ajp99VCcnC7Td2eHxTxjH5mAseTPVfnCBrdn7JJUAMbc-ru3E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72YpRp8vAWzuweMJCEd6GNEyT9SoSSLpXGKFC_ltFklQ&oe=6A1D7AA5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWQz_05BXWIQ7kNvwEkgGvl&_nc_oc=AdrCC34khD1uqrCrRX7ZITKwo0EXH_UD2SBEwZ_XxXd3uYILRL3Rf14s5MQ7Et06Qag&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jNVcSQg2FmfoJzIKTQPfkwbYRiwd7Yc3cbPXx41DfXw&oe=6A1D9200"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYLWDyPUuLgQ7kNvwGSEEF7&_nc_oc=Adrq4ELdBGvHw9-LWmX4Z9a-TmT5Zxz9nO78pKIw5d5MEcw57cYOtZLgQVq1UArlWzI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Bmmzy7L3PawxCEK_JAJUaDm0EtQy6FgPgbaanMxZCPQ&oe=6A1D7FA2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
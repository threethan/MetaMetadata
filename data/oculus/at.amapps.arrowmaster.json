&oh=00_Af71FcjNbiEzRS6S7L0hPXb6pdsy-PZORwcG1MfolcE3pQ&oe=6A0F29AA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HETG6Cw-essQ7kNvwF79H8S&_nc_oc=AdoTbouDd3GEUcrIUl5xCh-l3XvYqujgGwxvuTuKNHzYHICIBaIkTy2V9Cfx6BNwdH4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75CJ_tkBxr82rQEJuTvAPHGrP9N6dtL8s362aSMx5w3A&oe=6A0F1B96"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odG08K8pTlUQ7kNvwGKGoMW&_nc_oc=AdpTsqphzF6J66i9D6lxwktSoqrzgLpY5c4EeFX4cOglD4R1Z6APDHBFWv3wYb9Y0dA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MWxD3lpvsNx3QvikhaQ3sg1rg28DBjcMQqP5AEOFAOQ&oe=6A0F0173"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=suE70KHNZEQQ7kNvwEkN6cz&_nc_oc=Adp5-rqZyjqpALr7oocnNp9BuodueNi_Mlt-ZsAYT59kg6yzVYhOpEsMocv1xEAllR4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wLLRSiPe3auta6BGRMbaQO8TpFlet3LBEmkD1iIx-eQ&oe=6A0EFA25"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkLGIcDUYsIQ7kNvwEHxXjq&_nc_oc=Adpqyr-vL9qVVNWneLilNx0DQ1gLpHYRrfAd_6dkm6jvFt3hAi8W1GlGs1-lXci3DU8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ColAjpCJz_kL3Ia2UOio9sE4IOzqDonDq8QItNyBQ3Q&oe=6A0F1180"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIwrJbfFbXUQ7kNvwETPmA-&_nc_oc=Adpt4uXklOUex8b7WDkpqceFRrHtULahdHnTY1rGS_YRADnzYjyaGQ9p6HMIYhI2bRc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IwOgMjPXUrSxnTeYYbE--RI4yHNu1ediZ3N0ejQjy9w&oe=6A0EFF22"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
&oh=00_AQDte2WIStAZ98oS_1Gx0rViUwtOXHYcaKkXH5xgK--g7Q&oe=6A58C56A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWlwwKJmkDAQ7kNvwFUEuZ3&_nc_oc=Ado0llF_isJYqcEzPqD6c4SnWk0s3cq_zVmiHFj0skZYBVTCfw2IVH6eAxCfGJrfyrk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDh2wi4sNEPNl87PjSClOnew_hzdNQ3n963UvUltvCFcQ&oe=6A58EF96"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxGBSAr8ucEQ7kNvwFBvmcO&_nc_oc=AdoagOtKkqqFkdxyIuOcZtBe4rblRAQzOgcGVfDj4dmL4h11gcStiEGsf8JcaLXaEKs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpe0ku5RoSnirQ_JrhnWF6mjG-wVmSQYL7JIJIlA_ISQ&oe=6A58D573"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlGTX80FC2YQ7kNvwF70M4m&_nc_oc=Ado0VC8ceASl0KYqUavkIHlIdtbYbL5qGtvNLW2HCcz9UW0tjAIqudR2JADef0EcB7M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEdBQn5QxjyQOxmjmNksRNM9gpFaPt0587esrZBa4ubw&oe=6A58CE25"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xf9JWIX1ScQ7kNvwGjHi86&_nc_oc=AdrmaAmhjIlzNwDejcVNjWLceZwmLPtp41Kh2F-z-PLmf2NPeQ5EhX8ezblHlJIVGDs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKAJbTdjjHQxgTMBpZXxXbwu53Stdw1zjxUFdUmozw1w&oe=6A58E580"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lcc2CsVvyAIQ7kNvwEAGCHH&_nc_oc=AdrAEo-k7sgbmSQYaQgPm8ZAB0l7A43PyeFpf3LP2pp08F6Hfc2A5Y_DIK0_Lf_viPU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqpiAHc7oa0GgHW5O0mziBOttFNFO48tFpIg1tGhipeQ&oe=6A58D322"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
&oh=00_AQSm7usF7p7Z7dWRxQtAhn80qiJYxKmuMzeotpkNVsrGZg&oe=6AF731AA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zo2NAg7jX5AQ7kNvwFW2j9L&_nc_oc=AdocsziOlo4N96xbU95_drK2o1Ti-cOdBOSNZzyHIeJB9dXl91mm8RvcwuxELsFqBI0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR98ZcKk-dEXwSn-JGdGaMnBwZqTU9SQ3Ovu_l37Clldw&oe=6AF72396"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpJGqTDODpQQ7kNvwE9oXA7&_nc_oc=Adq3FuDxay9_p7Ch6iQROTTgyJIKxAMIAHCL8VAsS4_FHeNX3DSs9CL4LH-YIRCplrU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWuFJ_PfqUr-RzOYA8kyvLkuc9gWOWimvUVe5J1shOOw&oe=6AF741B3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3hwZJv71AQQ7kNvwG-69eT&_nc_oc=AdpfDmO-NN8BvyZfuHA06VmdERnPQmGLVqWohyQ4JmIMO3miBo20dwN6ey02s-GQN5M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzUA_wYDSOkweUF1Mi_0LQfak6q_MP8x_Kmjj3_iT3qw&oe=6AF73A65"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UVIZDQMww0Q7kNvwH4rD25&_nc_oc=Adq59yBfmYVN7wWoZijZ01ZiWqhPhpuFznNYe3KitxnKJ5ys9Wkbp9kBdjJ8fH9iCOo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoTz0upTPc_AsG0W5yglyMB1CZAaoe-UIjmhKHFxDZ2w&oe=6AF71980"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iU4WqekUs60Q7kNvwF8ZN2M&_nc_oc=AdpItD9jmCUNtOphUtRXpIm7fqXcTlLBX1yRBZgrl8bjWw-DJYgRg0sQQvlkgROVwcU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqXqctYQy0by5gf6CC4Or15DF05Xj69CaTREKODkBd-Q&oe=6AF73F62"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
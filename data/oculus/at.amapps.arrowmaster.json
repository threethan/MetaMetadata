&oh=00_Af5ztYFqkLhfUpKzqHQ9XCgHDHIGQ0rdC5Dqr_YjpocQaQ&oe=6A204D2A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnKlKuYxfB8Q7kNvwFYubW0&_nc_oc=AdpkvJCI9JRaRcrLfdqu-UGQpRjBpjBB7QOEfnhrpYN2zvL2qCWcD4pqne-V51wEBOc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XhV6fidpm12P-n38_BBqiwm1K3g3vTlWd9_bMEe6rMw&oe=6A203F16"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jyb-OUjIUOEQ7kNvwEzW8No&_nc_oc=AdrXJBO1OB9Uxjd3nlUz2tILUQ9-7ULg98dMXxtD7ekF_Bsez6cC28sizPCXbIvoBbw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7slWDgdn1Iymt3VJAk3mvZxms4bf-DslirsIXd3pd-Vw&oe=6A2024F3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_B0hfUoaKgQ7kNvwEXTuuj&_nc_oc=AdqrUzqY2SgbKOqrJZ9FogzC5btjHtt9T5aP3IhkzDTpI5-_doq-It1hPxhdF33KRHA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_-0oPKXG8G6MeFvrTg2ZE1PTyKFhfaE_s6ofEyxh8Ng&oe=6A201DA5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWQz_05BXWIQ7kNvwE4JqfR&_nc_oc=AdrJmmGzchgQTQTCSikTP9DR2XBSlpo5brE8I5Y1QtlrqobgG5SQnADtRSzrIpN0-Dg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RsUXtQYK_ZWsya6olTK-0n4D0WLXdCSig_E5B2Ah8cg&oe=6A203500"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYLWDyPUuLgQ7kNvwFbgE9g&_nc_oc=Adqyk-oWyQeaTYUbY0qsr1IEwnYHTiESX6_Za9RclEOiKELTtwxWsFbVdW2VtCaJqNo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60nHFDrsRfHbah8rRJZqyfpNXZULJzQXwPrWKZbqaQ7g&oe=6A2022A2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
&oh=00_AQCn1GKVjCsKp5_oyZ0dtnDT3rOie-WsGlGtZKTT7tv3ug&oe=6A68976A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9rE3znsvPMQ7kNvwGQuAxW&_nc_oc=AdrWR45GNb6WW4LFaGlIIN5lJZ-QPKxFrWJEk7XH7Y8bQ_HHeV7kz5qpx397Ml-6WQY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBt4c2JUds83ISWzYjgbgp01vyj_Z356CnmPFsNUEWu0w&oe=6A68C196"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zB7g2IZbE0MQ7kNvwGqScIs&_nc_oc=AdpK6GXXyShIjCRBARp6HZiQ0NqDzSwABN4MZDlE-2Ex6d-3ZEMM_wZ-lXjmuu6sCEk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArSnqdeaDW5oo8Tnxs_nDm7JU8tRoVcET7JmYLcXk6Mg&oe=6A68A773"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r875L8a67CUQ7kNvwE41kz1&_nc_oc=AdqMkxlDZ3ufK4dHLJ4HPawniuoB6NGIKSz8gpOh8vcGuVooi8j_YD3LOQIe6P8xjtQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6w08lTNTS4oj6YFlcn3MyEzAfSImcbemfgHCYIgznYw&oe=6A68A025"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ud52uy932gAQ7kNvwGrCbq-&_nc_oc=Adonxpuq9drP-MGQAGX_s3f64Me2MkC3nKb9hweLah6TVW2Sr_zBWeovEBbHhwgjGv8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATtS9LKIlgK6ZEDcrxGHqdlkRTBMgUKSpCF7qfj7FbeQ&oe=6A68B780"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnuYonndUhQQ7kNvwG-hgeC&_nc_oc=Adpr1vgnkuZ9-H6RPsmiTCV-NdBiAqRoEwDsCpHYZNaWdnevLQ5H29aGphkTtoeAomM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsG4Jgq0aZi4_p1tTeZdn3P5-DrJGSeymPlUfmv8RvDA&oe=6A68A522"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
&oh=00_Af4izry5f_bbbv0cmzsmNo8Ssb06dZRoZbAkKiKALsNt3A&oe=69FDCDEA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEaqfAt-zV8Q7kNvwGtys-5&_nc_oc=AdoSX12pPDkOij3bBN1_Vf7L_m5QpJtz8IUv7W04h6S1D2CKgiK0-WZV-z1bI6GpHnk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af551tJ37PHHqXienfPJS4_oF1Ie09Rxuu12mMDEkLIz4w&oe=69FDF816"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8tuETDAEwgQ7kNvwHT1XHb&_nc_oc=AdpUZuqkjqFTLDXG3gf8ucRTY1uJp6vrDn4h1MSRzhKoaqMytEDzGZuvxn3k10T8FPU&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eyWohuTYY1Lz40B_unyzy49ift14lpe4iSuS-A_3Z_Q&oe=69FDDDF3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20gI9ZlBaToQ7kNvwEunCI7&_nc_oc=Ado5iBsgzeHLi6lZjXALFQBSfMyCE8fpQVMkBJ31a3_5zZPX1PboVP6RZlEM44EjA30&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PlLDa2hbqkUTaiHZ0lHFM8MeLWOgfuQFUiF4zGlc2Mw&oe=69FDD6A5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZ01OEDOAkEQ7kNvwGewM8I&_nc_oc=AdoVY-szJLWYiFL2_shRw1gN2r7IGSwtqcGFM5lqau8ZNRBYJdQL3gJ7n0AqXPxt09Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TihX2X6zTnRNZEC_X0BtfaCtXlgmIjEcXqRWwK9x8eA&oe=69FDEE00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYY45kIg4OgQ7kNvwEpRbCv&_nc_oc=AdopWZUY-Ua_iLsbzpldxhR4uBR71y6j5KWZUsONc1DfT8QdhPP8FUz8X7j0Njbn4zg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Wk3-0HEDB0gszhxLXaydoPp5HSpV6KKx9F16RicqRBg&oe=69FDDBA2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
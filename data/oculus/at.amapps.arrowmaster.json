&oh=00_Af9_ddQPrsxqYkTmIm1TRxZyFuxdHXMZOOrSV9nO1e3aDA&oe=6A3FF12A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJOA3zA1JnQQ7kNvwEO9njd&_nc_oc=AdqA6PvJy90lTCgQluStDs1FovnXbwmviTKnz-evHnUixx0i3CSUznqT48nmWp7HNbY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rX5nAW7UfxsdSSnlhEr4GGco2pYbJkI3eC8KVpLusqQ&oe=6A3FE316"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aApF8SjUoWsQ7kNvwHxb5hi&_nc_oc=AdqWh-tODhlsHEqIWuSFRlK1wFEUz765Wyl_SyWUeHKj_l1YcmWH0pilaILhDH9_yfA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4t_RCj4g7RhHHR8lWhEzOCJRaSLMTK9EtXbC7umTfLg&oe=6A3FC8F3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZEYvT-xAP8Q7kNvwHVsgyQ&_nc_oc=Adq3sO3ZClby6WMooiNXLZz8y2oCe_XFasgwZuhT1TW4Dl3eY1g_qK02dfgxpe4402A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ENFN6Uok0x47FWXeqpyD_8Oc6V2GQJLareHvkLxln0Q&oe=6A3FC1A5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGwe3khq-8gQ7kNvwFHtOrP&_nc_oc=AdoMNJ_3-K6ng09JbMuzrC5wMGdcmvf10kIZZp2fYZZAReIHqItCTsnLrMO0waNRYoo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_p5dM5DimC-r-s7GmiDP6NPF3XQpzUeBiTkWivHbJtng&oe=6A3FD900"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoyLMCBs0-YQ7kNvwGYK4jM&_nc_oc=Adom1UlRzSXsu_6F2W0QrA8LNrICz2c_Z4N2pTKCY8ysCmKBgE0BZdv8KPwAJKleO5w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SlNcqD-ICVVxjfb_UMM_OQrKWLHzn6cmPfOLnE_NZ2w&oe=6A3FC6A2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
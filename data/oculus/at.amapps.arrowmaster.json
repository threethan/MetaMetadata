&oh=00_AQH-tO26ggN1DSEL5DBmHGQjslotsrxkxufbAsPVWqzsbw&oe=6A8C2FEA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_5S7FXK1iIQ7kNvwEW6MYk&_nc_oc=Adq_n2bVLecEQc1YxopMYwnTeOdj0Jl4-cf9mYC9wGTf9Q9RfKELmp6ZbcE7P7P7GqA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbUBckUFdWMjsV6pKUKPwsfm4nyZ79RDoy320USbZc4w&oe=6A8C21D6"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pjANG6RFA0Q7kNvwGQhHz2&_nc_oc=Adq3kgMpm26aNXAbHQvk2tu3c_CF2PC_vc_XbhBufvLaSF4OFp1peQxtDBjB5TZKhBw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFy1-lChTebNh2Gm72OzfYQ9LWtmMMf96sTfwWF9WZY4Q&oe=6A8C3FF3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AADAEsJlN1kQ7kNvwGiD9hg&_nc_oc=Adq73rZL7a8Loxfah0T9bcbbKAeJ2ClYt_-5Exi3085Ba1cEeZZ7Crkq-MdEHGkrBSA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLhDUV2XRQ-RhDvU-jguNHShkhmrC5QCPzTfV96xRIiQ&oe=6A8C38A5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDqv_k7EFXUQ7kNvwHNDa0h&_nc_oc=AdqTT_tyULb_rI16mw4iLrzYiOoXIe5H3bjobZ8HaQYo4myY7hXOg1sWwurq5ZAIrCI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8wXEyEmBMVWY_vHb9YgNPNFBtAelFUX524UxEQEqsTw&oe=6A8C17C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5pd_CaX9hIQ7kNvwHzBa7d&_nc_oc=AdpZSYiDQYyQRtJzd5AQn1IpnTvvk7-ZPWkIY5JGmP3iNP4pofCKMQiMSZHP7YYfoBA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXxVliDAE7vdTQCsXaXXSxGODJn3IyfMkDC8SR6P9jSA&oe=6A8C3DA2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
&oh=00_AQN1nJRcCtqz3mgqVTIkbMqkkqbUswNp-kso1ArVA0Iiyw&oe=6AC3C72A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BD-d0xC2nXEQ7kNvwH00s0G&_nc_oc=AdpDlFobeu89KlxevgXvt9arjLc0PdUNGf0d_Ah7KNwsRtO3ciCmwFH2pK7W9pt38MU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYsmwyzJWOOxZKI_1Uu0vYDYL0tg56jj6E1BpSDDjN9Q&oe=6AC3B916"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nixvJK9EGXYQ7kNvwEe7oXO&_nc_oc=AdpdkoosT3cwuTosyjP8X4RbgvU1_A7RPG2UTraGmPW9rrcFKy_Y33BdcTEoCw_oGUk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxzMFHpfvzaDXYukZJRKtfAopMnVmAFdnjQfpjLLRLuA&oe=6AC3D733"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBA2ziOj388Q7kNvwEA91pp&_nc_oc=Adrh2YjD06epLskfPAmuh16vyguxL-haeqOyCs2uWfo1mk7hgds_66ssB2oqxh1K8I8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNU_QddZrFX-AGQ2K75QbDm-psaoBfIHRnDUsOZLFyEWQ&oe=6AC3CFE5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kf3cJKiZ48AQ7kNvwFACGAu&_nc_oc=AdowN5SkEPCW6WLvh6C1TMqK4DUKowTdAsdg0I88lmnb6wmlOBhjxDp9SHFOJhpze8I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqVl1uhMHMf5gCwdScDgmFn0FmTBfWxJwXgHqbIXqdqQ&oe=6AC3AF00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBwoyQ1ZSJEQ7kNvwFa68M3&_nc_oc=Adq2igCTzL_MfM2OcsvcTl3CcXIOFlmi-Hwx8mMMyUybfAjSfktM8jdotiGYeqHEyOM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbHMzFIQoGies3p_ShTofY3lgrn_XMrbzGaEPuYW221w&oe=6AC3D4E2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
&oh=00_Af-IUj1Dhs38g7qVzd5_d8ZsTStC0o7MnbGKgadasoCTqw&oe=6A35652A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZwefhBycgcQ7kNvwHFJrED&_nc_oc=Adox0RbF7rlzzywfmLUHFmfFE8LcEiHsWd_sSaadUIKRoUAdnFLlzSDMT_stjMyb1Co&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pyI4GfGWxfKajVsZ92dpWMTOjQAG2BdWIRCRwho2uYA&oe=6A355716"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrOm4BNNRJwQ7kNvwEd0sVt&_nc_oc=Adoch--1rfdiTBq38d9AzRMJlfZZXHUpmocnyns8bXe6JJPe0uznIANG7PGeBC0xsRg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__yZDAiqmdLLfFj1HymFQ67vk8EgcdH5x-iYvYgHCl-Q&oe=6A357533"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keRCHXBG3vwQ7kNvwE4zHvQ&_nc_oc=AdqfabjlwVFSkIbMViMiaYukFax-8-z1kHZULPA915lZx1vjQbR-49oe5nxcUCQ6oK4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0ab7vX6UjuS1UNLAI_PDGFkqOrMbiEUmOQQTr8P971A&oe=6A356DE5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8hn_18UNE4Q7kNvwHPJJSf&_nc_oc=AdpEKQWavJE9JNeiaCAHEowlYSIAyHQ6aRmXxFTBFNjPrwFfR64OBcdNUlqAbWRtouw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lSN5BQl6z6MuhUpEwBHX6v_xM1ALv7mo2l2h0xXYZqA&oe=6A354D00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3R5U2kN9V9MQ7kNvwFwip6u&_nc_oc=AdqwO57WhGj1w7QLwXUO7GazDFid30j_mRLeZBHLF-w5aX-8WpWCX4VPPsDxkUlZTic&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88bxtE2z8PMc2cOkvjScjajDBaeMGMZ6oTu_hq0ofetQ&oe=6A3572E2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
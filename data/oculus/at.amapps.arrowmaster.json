&oh=00_AQS8CtaWam8-L7Hra-bvX30qtpNpMxhK6llEVCQIjyqdFQ&oe=6AF09A2A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkI1wvu400AQ7kNvwHv-p7E&_nc_oc=AdoHbgVxeKPvAoluHkkP8klVthJ6x_MZOpW_xV_jJkcaz0HkU0FvUmeIAnO9hO6wZ_Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7JcmXpzK3eGRpRizCJhK34bmxjX-LX3skPN3YZ98m9g&oe=6AF08C16"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3EXoE2lsSIQ7kNvwGMVQL7&_nc_oc=AdogJlRRg-jNLwakjsXSk5Dzlx9PRVeeK78wm9ENWbYL7IlXEMeOcb29GhdV4I4uwBk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwGWvXO8ga51q2JAaODanyn3WrhcRnPGQ1Zy9KCCSOJg&oe=6AF0AA33"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bo-ETRAjBT4Q7kNvwFrO9Lu&_nc_oc=AdqTaMC0jnuUmK0gRzsuADXi_VQU_txpo3M0rwzB5sssq1401fA3SxD4LTZMdtb6EJw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpP9zjb7ZhitkoJ1xo8DBW8xNPsLf4Ww6Sz1uqOIAong&oe=6AF0A2E5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMLY7gaNT7UQ7kNvwHr2-Pk&_nc_oc=AdoHg_ViBQmcIooAK2BOs7rKZKNgdy3Zi1rHw1LEzI5NCp_oBgi791UcC-NUXFXF0pQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbai0LGOt_1TA3s4QIx_fxwLGXRi3Hyd7ITixx6aMVOQ&oe=6AF08200"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mS07If_z6bwQ7kNvwGi9JW2&_nc_oc=AdqOMvu62G4F_cTatD7B1kCZp47vkROVjpRqy17z5wAkFgt-99VcQL7Vv1tg6U1sfdU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUyMUxnvHpJ6hRXRvtxNSUOsmc1GfaswoJI_m52tZYZQ&oe=6AF0A7E2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
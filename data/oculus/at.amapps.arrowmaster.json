&oh=00_Af_Uwl_fIkBSicReY3yoSFl_A30aeAcgVDCw355iO-WYrA&oe=6A32C22A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZwefhBycgcQ7kNvwHR1d3r&_nc_oc=Adra6X6lxIPfXTvQz9bdBdZ3she4c6HRlC4jl_ZJCToeB7UwoJoLEF2Cl1kwu991p40&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_codCb5fulRKPE98mN_DD3PCMZmRoTc_d1OkhgGYI2wQ&oe=6A32B416"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXko2KlFhTAQ7kNvwGL4ZmJ&_nc_oc=AdoRrpM5RHMvWaoGAln1aAiw3rkgrWT73eraj7LHNlNN5CmoadIXBbn2exX-fiGc48k&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Wydd4M-PQLgloPGvWkuGy8UZdsafjPbBPa9m-Z3Zg7w&oe=6A3299F3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfg21JjX5ugQ7kNvwG5-4c0&_nc_oc=AdpXc3TZfzx0Z1rJLRsOIViyEsCQFH91MsOKOaTZnfQvU1MEGdvTY-Y8t2nUwzn8khw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e5h8HRkcwFFPaQIb-Ss8Y2w8V7ErabqjDbTvdM4BpuA&oe=6A3292A5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3rM8yPcUNIQ7kNvwFAOMO5&_nc_oc=AdrbAE_QSJhUnNwhPM2nOOZBJgUBl_EFpQu6y4r6-Kf19pyNae6pfp18m0XQ7wjLEvg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A2rsXMQVBQJs7Cme1vktbAlnF7wDEIlOLvnjszmQQWw&oe=6A32AA00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1C1ZtWosDMQ7kNvwHuU9qZ&_nc_oc=AdoWJ5p7UhbwIYIA3rsZkxtPY39qJgXwKJrOBk-uSY0Jd7DR01fjJx-iaSQLZhToWzw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4rJ-l3GBAZ9jBhHdk8g8xn277xY_TDGBeIwqXchMdeA&oe=6A3297A2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
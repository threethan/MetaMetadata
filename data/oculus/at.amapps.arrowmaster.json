&oh=00_AQLJRlpWrs9s8Ej_TrcVKz0Jqp5xa2WpLxkdshl8Jj99dQ&oe=6AB000AA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaHqw5COwtIQ7kNvwEwuyqe&_nc_oc=AdqSY-sR9mqgkvcvC_zmJTJhjzAg_P_GrAk5yBFBwGAZRU9fonOyGBVvwoV8zCaA2e8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEw3f51E280TKSP-4dXhCMkrpl26DzvXWFeqH6Yp9gDA&oe=6AAFF296"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSd9XYVERK8Q7kNvwFBQNg_&_nc_oc=AdpIeC4W94YCv6D06ipVNG-dPuFV6ZEjyai34JxE-0wzSY8RomR5KG-cR3FC_RoLItM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_gMzNOd-yyw279fDTM3Q3ehl8AEwSDzAmuwC7HPM7QQ&oe=6AAFD873"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHQL8ZxpcEUQ7kNvwFoKlzz&_nc_oc=AdpaJaHJffgUzW8DvTJsdWyIE79fRB4ARrC5778BwnkapJPw_rnBxMfLs-wMLNvEWuA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWQdJw-ZpaadJ6YLcw3dVRms3YB7WrhSHOvwhMT_5x6Q&oe=6AAFD125"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyaxUcDeaFUQ7kNvwEl8GcT&_nc_oc=AdrUqLmwMelcDVG_fpF0GXQIbKNfDtOCwcR3SzEMoWcETx51lvguiDejAwqyDqVVTD0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOK7j1sMdHKBaPsvO2UFnFPJrI4bTkRB9kCAAJAzq7sA&oe=6AAFE880"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hd6NRQlUMyMQ7kNvwH7GQ9k&_nc_oc=Adqqx4WaIx3g5fJ07LTB_Clwb5dxnCsBtsGBpzYZROaVoGe-sxSERVz5Y0WFdMYVO-M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvbBH0kK5gQPbncCU7wa1P83VfAfSkw5rpWZxYLtSDrA&oe=6AAFD622"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
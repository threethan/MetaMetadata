&oh=00_Af4cYdMelpwGXryWBvoc3iQJ-QjPtT-yTdJl3CvJjqzgag&oe=6A15C12A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mhtOYFaA88Q7kNvwEBf-94&_nc_oc=Ado1lzpuGI-RmLOUNN0xBb7W7ooP0I4dCiqgquzTzFjyUSkFty7IehMar8WuiJuDAjI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zhwcme3LhtBDEPm1bXuZ1C04tvM0aoRLwJvUXFgG5xQ&oe=6A15B316"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mo-4NO45QUQ7kNvwFhYbsC&_nc_oc=AdpTYVJ0fzv3GU9PMMOgoLIa_EhqkDMYOx8s-dpGcaV80ZeJOvDu4-cW97EY_jTfKFo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Z5n1HM2FyAxgbuJ6MQryDUNhoz0uTsP2bypGBOiN5CQ&oe=6A1598F3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taco45wHeUIQ7kNvwFJuYBk&_nc_oc=AdrPCAre9_RFpwES4yz5YJoVkvTPN2HopP0-nkodij0znPt7ly0CcA_A5fQQf3edY3k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TQfYpGjruJqcacY-p6JXGZhLb4HHvaZwJ1KilkUT4hA&oe=6A1591A5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zz_cQiBsxngQ7kNvwEDjXcD&_nc_oc=Adr6WpNkLHCv7KqH34DhFuApuw86ITZLPTehQ_F594J8zoe3pG6eJdYU6cpX0lrHcLA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Q66ds4bOBlby4An1l7TJaEcOVpjV7sgFEcHUEat7yRQ&oe=6A15A900"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YqpIaTqcyMQ7kNvwEqv7Xk&_nc_oc=AdoUo2YgiLHzFyUCtL2P2mCZJ1LXmIdHcfFvUn9o9G_zltDucrFJWNlzP7GmB7ooZAE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Z0M6pPNzMIcZlNJO3Gntik8pBpByQN527jcrrhWpgMA&oe=6A1596A2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
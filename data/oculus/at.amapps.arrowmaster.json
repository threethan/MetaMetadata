&oh=00_AQPGpnr2JcG_94jOZjM-SNFWSo6PeFa4jAihpR1VixrWHQ&oe=6AC518AA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOQxO8ORZWwQ7kNvwGngPxQ&_nc_oc=AdqZSc-n21YaGvQNir87pO9meF3aotE_uXCY1x9cQP3qZRQgXnxI5ZxmA6pqDLXfNy8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWfsLpXuyTE-pExVxD0leT2KIsYipx_2Yvkt7pHCHrew&oe=6AC50A96"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nixvJK9EGXYQ7kNvwEl9hzP&_nc_oc=AdqYS3A6aCyuvBidKL-D-4PScmXBzs7MJHdaOgFqgb4eKg3vBVaRTTKQfCnp1LmRzCc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMR-Z8PgEEnqvq4Kp6bjTTZWoJWJ0EN_vO516D9eQUAzw&oe=6AC528B3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBA2ziOj388Q7kNvwFYfe37&_nc_oc=AdqSBdS0_OUaKToOeFFni3U9fDJNDqiLfI9ug3nSkfUt-lesEyEzVUK-MUljoypMfbA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiFwYtjofAL15s-JLKQy9BOI_3CCYQitZjfaDxryX57w&oe=6AC52165"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kf3cJKiZ48AQ7kNvwH0btjW&_nc_oc=AdpvV2dLZibVyWbxkkvXOKXlLQSjg0HFz1hh06KuzbFxBET5h5TRIRhoc-bQNJa_wgA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrwI_2VbddtwrWEWb39QLrReV7VEqjCq_YuWoV5N9CKA&oe=6AC50080"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBwoyQ1ZSJEQ7kNvwECE4Fl&_nc_oc=Ado-IDtuzSq_ldjKKCgb4zsgAt8UPrmf0Hr-LVU3_9QmyIcQQ7WSnYRqNYp4gTyB-io&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgUHOpiVYwg4gZZOJvrcSHPzts5ER89h3eFI1_yD0fOg&oe=6AC52662"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
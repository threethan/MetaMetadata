&oh=00_AQPntLNefGqbtQ_m3gBbSgkWTRhpXbgmm4o36HV-Pwqn_A&oe=6AD3992A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwHY0R4cAI8Q7kNvwGJq9Dg&_nc_oc=Adpfa3yvDawIiLmCXMXlfiLR7H3iZz_vmgojOPZ9xdcmdpWGEVWoZyHBDxRnqu8yvE4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMmdy5_1TkVzA0zN5ufCwQpz-6yNMtS-TbaBI6Gw4rbQ&oe=6AD38B16"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTDbhK-v2CcQ7kNvwH4R2W6&_nc_oc=AdpqVTVGrPN0oOgyJmCo3IHZB9Vu8TkGQeQbRjWyOWWahfL-KbrRr8TGK1Y3uxBHKdc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaQLHYKd2P3sYs6FPrAHQAOfHClBjP4l76cFM1NNGj9Q&oe=6AD3A933"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CM3G6App3bkQ7kNvwEeiWmT&_nc_oc=AdqwV5n97xyPfq-8MFx9O3-Ke00FeNsv9gvbao3dSUI0LF40sV1Ajt8UVcyNEuJuYLQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFOv039oiEscjLbLy28bqKDixxBq12WhEvQplRzpPaeQ&oe=6AD3A1E5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jz5FuFAue20Q7kNvwGbUhMF&_nc_oc=AdqrGXbJvxPJAyKtU4h1ZnyOX68p1jLeEn4VYbYc4Bhgm72LOLKjTMk0O0ewLmHzt1Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnxrahCSARmLttPQ4IRZjZ5lTGqSYwMzoah3469jWQ_w&oe=6AD3B940"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvnB0-IKggwQ7kNvwEhnRRe&_nc_oc=AdrF6ojY52paSFURLJEmC8Iq_KsTsxKinBVsSYH_G6Vh_PyxMxGUu6t1Xp298v9NhkM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKsbLdQNm4r2p0jzpRJpSxwGIzV_cDk1MhCcHGIibXvw&oe=6AD3A6E2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
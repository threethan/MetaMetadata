&oh=00_AQHAFk90HYh0plVnW4Sas1ypxZd8wC_BIysBSePqEm_Yew&oe=6A75C66A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8ggqFU61tYQ7kNvwFMqQzZ&_nc_oc=AdoPDRxX2N2HwfaQ8PTyDYt7tASt4BmOuxCTIvSaQcSJxGLJlKAWLsggUXxZR3Vyu8M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPwnMYe7XSdmEqAbH9cvoMYZ9yo1ymh3CC5e8TTpfyig&oe=6A75F096"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfyFbHv7QW8Q7kNvwEvOYwf&_nc_oc=Adom9WsVcs9HIxMs68J45tcJvzXchg7twxQUreaj6rK529yx8p_lzPGxf8zNPcTGx5c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVQTScfxwsTxBfz8OzZ8PNQmyYnauqLi9FAflIEH1_ow&oe=6A75D673"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHz-QqGKTZkQ7kNvwEXT7vM&_nc_oc=AdptYTzCbJYM6UV-_I_PvFrp_4gdQN8CArjIfbTWKkoRi1qh2SGRGf8WmB-_EWJSctQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQ2ODpz6a5FqCbReFUxQqG5qRvErfBlEBBvGOClO1XlQ&oe=6A75CF25"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhoT_YXIMMIQ7kNvwHZeEbG&_nc_oc=AdpI6bYKEfXJlKnWq0E32viVBZwl1BCpTfPxOfwxEXWQFipM9WY6DU9EM89LCYTOp6Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFazmipclLft2ZLN2gEhqVxl_flw429VKEGXvdKULWVxw&oe=6A75E680"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIKUPetffy8Q7kNvwH8qld0&_nc_oc=AdrC2ec_vDrKdu5VlOYNSfVvlRB8ljJarJoZwjSWOMagcsKOULlwzAIshyqxTvL01Bo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHitWbcW6PKpa72w_u80xrHEH6JpOpgOPr8Auemz_EJfA&oe=6A75D422"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
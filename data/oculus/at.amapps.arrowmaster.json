&oh=00_Af4BpYM67LLvzANabNTwNC7j_vnKUWEtvyrnqbL9vU3fsQ&oe=6A146FAA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mhtOYFaA88Q7kNvwHUxgi_&_nc_oc=AdqtpbdrU3HVSGKAeAfrLMuG3mCIbM0qYDska7u0qd8zK4LCFoMm0QnasD0amMLHd1k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eGffVz9SxEvRyp4NvYbof3-2wereKOTzlJCZ24rJp0g&oe=6A146196"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mo-4NO45QUQ7kNvwEx8AGm&_nc_oc=AdqRPj4Hfks52VP-KZti2-0bUNseZT9yaXz-TEMw0VIpZgRc3qRCJSrAtNPVMT-0RLM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jEpstWPeeW2mZWtBXElsxsskeqLtv5ryr9khD4foxUw&oe=6A144773"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4uTLJQ62P64Q7kNvwEtGw7G&_nc_oc=Adoqr_dE5eka8Hib0Eb0z3p03IDbGYTJMiF6GZyMEaIkKM5kW3uDI1b3YvLR1YBavAs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qcee0U34YZmNZ4LZ-vKSl89Jw6ucueE95C_0DOqK6cw&oe=6A144025"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60Waumr6ZQQQ7kNvwFsTOOj&_nc_oc=AdqNICHeThVmP04l3UMaChfIF2a1xEmOBFdat0HidzFi9BxBPv-JxtbLVwrXXTkukMM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QM1qINuCavLWIaBKQymiKvcK3UNa-Kvgk8ph3h44pEw&oe=6A145780"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoDlNml_2JAQ7kNvwHDlN0Z&_nc_oc=Adq3qvbmxvCTROh9AwFYQPhkKYJXeuayJZRcF6k4XKJEbcklUZJLus_klO5LZFur5h4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FAj43dkrIBA59Cj--_LqVOr3fTPh4wjLYQSvd_j25tg&oe=6A144522"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
 "746674656693373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEI-jw7TI3MQ7kNvwEYQ5K6&_nc_oc=Adk_Pzb-LwreZUKV8Azv7BDrXoFBbaNcH6JZlMls_-fSVWu4N89SMgNabeLFCmJt3Po&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfseUxsqwndYzUR5zl6v7yiiYxO3RdLmNXTp6iGwpeUSFw&oe=699D8256"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAUPhFoIMNIQ7kNvwFGRn7j&_nc_oc=Adm_nMlfbQHbqfnNaWULojRtLQLl-t3DUyezhyQiMQS8QWROrVbT4kQyzyqagIlT7Rk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuyy3Yd4eLKz67BThbyEC9M1JfQenvLlqOgH3jPB7HhQg&oe=699DA073"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAFazBJW5fAQ7kNvwEPi1O0&_nc_oc=AdmMyy6fY9l9gI26n-EiFxin_q3Iz2yX6TExiVspI8ZEwtzuILWmyTAclRG5Ou4GJ0c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftDkGKIf7Q5u7rX1Z0WqEbOTFPX4vaZUZOw_iLPWLU51w&oe=699D9925"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80jEeIBWIjYQ7kNvwHIB7Cl&_nc_oc=AdlaLUnG77bAVx7TUembHagw14ttVmRMlfAxc89-GCyVHTPCDLQSBTx6y8TxpLJ6V1s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftP32QopMcVZloTH1HhJAdNyTs_3cl6rYYN5Ec49KOdIw&oe=699DB080"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3J1wAnAzvgQ7kNvwEo3SSL&_nc_oc=AdlkwaI4wuHr7trWfB4ZU6aLds704suQqc5m2OTOlFMeUB6XZoRHDPE2Ncx2uzPqjjQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvgOwmkG2eFXVNQV16BitEdsIQoYxA5eLnUctt1c3kHCQ&oe=699D9E22"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supp
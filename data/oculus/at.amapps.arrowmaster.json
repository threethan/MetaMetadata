&oh=00_AQFsQHZzN8G5pWIoZ3iAGHvARpfdCHy55fYwblB7xKm4Mg&oe=6A95DAEA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyA_72mJ7WkQ7kNvwGGX55L&_nc_oc=Adq6JHrlTIp4vH_mUmWoU0pLGza0h8CJbeEes-ZHujOd1fe8e_0Beov_2OlUmmSnO3M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtj5fxAqslg1dvwy6CxwNJkbNkGh4_9pDXleeM-EsXjg&oe=6A95CCD6"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDmPiy32qwwQ7kNvwHo46ov&_nc_oc=Adph4X1kzMunixkmzcM1T8Yq59yTsm7d0ZIVZ8WP-lJB-nFb4njv_lYAZGogZEMrhlY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvpD9pCvBo41HYXZRDvPAfnVNegHshF6UYx3pRts-n3w&oe=6A95B2B3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ez43C5pTBRsQ7kNvwH4VZGF&_nc_oc=AdpopXi9-zq8cjgPwzTYsujEOLGxBBppgy2P6FIKc5VLBIi-0w5v-0hXr8H0RO7O8gY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFU0AfZEv4M92m8oPOVyAoNgBADAzpan-BogBm9JvWczQ&oe=6A95E3A5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jblCLehs904Q7kNvwHCPWst&_nc_oc=Adoc0HM9Zf8Df5PNjFBbKW37ewZxEkJTt6pQ4MTJq8-RN1z135RbRoJWACu331j8ibY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFf6SH_lrTXQCPjIsc66aW-NGyZU34N98REYqXXMaLRuw&oe=6A95C2C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFFLHBS1spQQ7kNvwFYG7W0&_nc_oc=AdrfIC03orN_qx7gdbH5VilnwclT8NavYcaxR6BvZbZq-UVbvZ-XkEZsMVseoy0siFI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGA7St91SXwPP8SfwXotjsKQ0vmAWF2UO7YtMo4Bles0Q&oe=6A95B062"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
&oh=00_Afwwb-oFnjnbQP4ZFFBGHju1bM__w7PxAebLWXpIRetiDg&oe=69CA636A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sk45qmp1WDYQ7kNvwEuY7s2&_nc_oc=AdrH8H8X2wAICzRq7qVsluKkE0aN7VMQBeuYsLTbm8SCthglYjMgMhJRKRtn2AdLspQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwD_jh_z2KhlPJDRgq7FLk1xLDYq57MLzuIHb199GzrNg&oe=69CA5556"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9ohIIZFbTsQ7kNvwGiCyP6&_nc_oc=AdpQtZbFYs50Vyvq9J0Gh4a2ZnHOvpx5jGXgkVaP5ATIL6pxE8AQki2azDE0zePums8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPLpJoqagAOVcVVTfYG0mfdj_V-xz1riKbcdy_W-R4bA&oe=69CA7373"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KELWPmfdk_IQ7kNvwGF45C8&_nc_oc=AdqvlLZjWbdw8yTiAnXgrfdOLAb4qrMAqWYccA0utPh3AJc0MQNkiIGw_W2pP7YrQZc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzh7JMOrdaFKjsvU56G2PdVyxXGs02ofnt17BRaNAaDwg&oe=69CA6C25"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDQTBFUd0WAQ7kNvwFLBepJ&_nc_oc=Adp2uNE7uJYCsMsHf0dz2LaF0oNtQuF_16gdTWBNyPx0OIZ91JPNDS1mZoP-dpUHfFo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwWrA423Dwdgsgp-8X4k14KfFu6ovjhe_waioFwTgo4w&oe=69CA8380"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzvLSPai99wQ7kNvwGL9F3z&_nc_oc=Adon6yvLp-H7QMafOYYQ2HbO_tkK9llwGPTA4eV10ziLxJ8jd1PbDoP0bwJew80pjek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz6K200-i70w4gyLAumMjBzHuaedSqs8BMUe4h2QQaICQ&oe=69CA7122"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
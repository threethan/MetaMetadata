&oh=00_Af0GqzkHXm0JC6EAeOA2xxZK59BPHKH6qmH1wYAXXg1dtw&oe=69DA356A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIbfj1TGYWsQ7kNvwENRlDw&_nc_oc=AdpeTWxIYJ3_w1kzYqGAGnVKLj7NJn6MsiQIrErG-dbHwqCg4OHPCCACMDLD-AiHtyw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HybOCXba1lVRtAXQ0SfNY94RLK5RWXQ-s89SIolD97w&oe=69DA5F96"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVGiLp2Nhj0Q7kNvwHVaYzx&_nc_oc=Adq8rs9O25Aeu7944C8lf0po9DPbno7Nx9UJ5wYhQ4bwY8YlmiTybiRL7AzYWltcTTg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1W-9MXffCj0b2Rm60CixRke6BnyaBQQPeOoCGHfqGI1A&oe=69DA4573"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIyPT52fgIoQ7kNvwH4pkqx&_nc_oc=Ado7DWvWlwkw5nWilxHx8OJYrK--2hdutoHztWjt62KPBr3GpjinYYYhOVuhs_GX41w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BbXjpeOMtRT3_8CXkbSnFhqJ2O8VhZvW7M5qvQIBrLA&oe=69DA3E25"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3K3U2oGopAQ7kNvwHCetXc&_nc_oc=Adp3HkMhFF5LGGIAiFtpoPRmRyF-gwOIFd4tXiOP0Chh_pBwgN2tIiLAlmtlxsAVohY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3w4uLtX8w8sROM1-RPcxx0G9_G1TgZmPvwxBp0MQyOKg&oe=69DA5580"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0U83YNYzocQ7kNvwFMA1m5&_nc_oc=AdqrGkJp29oh32Epr7vn3p3YlDILCLN5TTzRRbhREvdN-l832vF22O6odMwvKt2E_yc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24kIZ_357Qj7qYMHNIi_DnveQfmpsr8_StHC4587sQOw&oe=69DA4322"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
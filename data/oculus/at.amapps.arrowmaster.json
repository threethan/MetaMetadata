&oh=00_Af_t6BPYjEeLcAWiJR31zYRwJs7dhXfLNrZ1e1zlQ7IHuA&oe=6A25932A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifdPGhr90bIQ7kNvwEUqJFZ&_nc_oc=AdpReJNWs2qy9KbVQNCJVqJjUEDDHm32j6ngUR_IMMN9pwoM2qRRYQsoA6cvq0kyRos&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1MnMH2dnyuleYo6KK9-sKOEOfANipLSExYMBF0Ma5cQ&oe=6A258516"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Um5cfbcm8XEQ7kNvwGERHYA&_nc_oc=AdqZ-WnCmG1KJOoTC6yhJzHTwzEL7KvMBwnuff23KZkQdP__AqGB8F68FnBp-c0WCVM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b5CrqCUdXyybRHpB6Tk1xV1mc8m7S2x2SAhdIV35qfQ&oe=6A256AF3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-gaLOKiGg4Q7kNvwGbTzMA&_nc_oc=AdoMm6laZr2UJA7TDZeJsa2tbqNU4I7DNfCwL0N7UwoR5atkTTxd5RlDhUXRC_PjjCU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oT_HsMIbZxUEOC6LCIYNuwzAm1hEgtvaNdKOgEITL9g&oe=6A259BE5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baYCNHXpoHQQ7kNvwGkQdib&_nc_oc=AdpEEqjXUo_iz5Ir40x-XapclvF1nIzwsaV7oKSkD6JZd0qpuH6vbYMez1gNlBWgpXM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_GCmefcoqRXfRePlzdD95-pL-v6f-8ug5LFyVQOkZ-A&oe=6A257B00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bCrdQZOtpIQ7kNvwEV7Zic&_nc_oc=Adobpi9UjEHqN7xYVZDfDHZ9OQfkp_FfVA48aswUOlL52aK7pomnX3BhYErOasow4xA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WlTqfLR007tDmRpvrqN1gkR1A9Bv1YOfMvZQAC0R0AQ&oe=6A2568A2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
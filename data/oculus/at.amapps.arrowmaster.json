&oh=00_AfxmXb3nTUD47yeG70IOEA-wKjyNxTA5BnFJvgE3Frjz7Q&oe=69CBB4EA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFbQbEOFX6EQ7kNvwGsw4D2&_nc_oc=Adqb5yH6hM7ocXaul_jilxaPkemKgvCqg0FYDKSFPXCeIIqgyLHJrXp1vJqGyXp7RLo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwz2_T2D1x9o-ykd0ycUb0msHWsBnAKqJ7wMRqLI17qJg&oe=69CBDF16"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9ohIIZFbTsQ7kNvwGwYmbY&_nc_oc=AdpoT03-xCFAhnDSWcPai5AG7t0-efEZNXoa57V87mJbI-fBWlXcxP5YIb3SY5VFQ8U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyeEwhDFbaQ50n9dwYNRoqTfRnVhjCYiBO45Y2HkSh3sQ&oe=69CBC4F3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KELWPmfdk_IQ7kNvwFnoevv&_nc_oc=AdoxHQMsveZ8sVs97iyU8DRNoy5v6XqdoEmYaeUD8EoZNi3QChlpCphgbKOkgRxesNw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzIdi_mcb2RqWLBmzn9M2Nzk1_iSRjgGXmV_3Hz7FySjQ&oe=69CBBDA5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDQTBFUd0WAQ7kNvwHQwkEZ&_nc_oc=AdrOnHR8pblWOXg5z7WYC2QMdRjTRYzm5wNhQegZJXy1oKJTpgY5QKIR87atKabLtMI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfylbvQHh0p5SqPZSvqgRiH0dClLEzmX36wYLG0ut8-6vA&oe=69CBD500"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzvLSPai99wQ7kNvwGXaAkL&_nc_oc=Adox99_xe155M_D7W9alGTf2CUCdm1yHuBNnWRBSX6PA-9s7bAeHrtXoPC-lMnqQTRU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwgUcqWdoeuk-IKgAdCFGZdz1jmwUThDLanoKZb40oTqw&oe=69CBC2A2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
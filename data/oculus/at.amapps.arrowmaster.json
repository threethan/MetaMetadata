&oh=00_AQOf-tBvVFiTFTrcB9eTRO0PE14TFfZtcU9hUF_EH4nzqA&oe=6AD247AA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwHY0R4cAI8Q7kNvwGqCxy8&_nc_oc=AdoH-MPgkmyO9Goru5egTKKWpbg4uQtWwU5dGFzAfz3b2gyaExVQvYHyUFaw91ii7xU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWD-7djF0Uo3fGsqA-D6QFUmmwR5bAJxPxrRViZRl1Hw&oe=6AD23996"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTDbhK-v2CcQ7kNvwEGqZQY&_nc_oc=AdqaLxCHZrn7nfauJGGijO_GgCACLTvIpqSuyyD9QVAbH4CFidH7dyHGdSmPrp5f3WU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNednDPcoMg6Jw5iTooIDUugFWou-DW2uFo_b7xH0H2IA&oe=6AD257B3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtVk8Dgd_CoQ7kNvwGEK2dK&_nc_oc=AdrdXKE6SqVrkoGhBWaAfPktCCiCRVCq0j2VMkmXLy4SpdlkSjvEHrYIVXlvhyDZ9wE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6QW3KiKUsPKaoGvYg1g9lJBGRq3cLYFUbNnrrRlUsYw&oe=6AD25065"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1gKGBlmk14Q7kNvwHpbxu9&_nc_oc=AdqlcvZYv1wHLtXTcRE6B8wHIPRpIoDdITp6zcLqJsyqF2l7N3wk3bkeKjf-dMHaDB8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqUSTSdhUUysEB7vKgsBF3hjD96gLBuXYSc_mDtrrnPw&oe=6AD22F80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHjUst_NoOcQ7kNvwGAiNJB&_nc_oc=AdrKzn9IL20jQDoowFba0h6TThsi5v0gVBJD7DpH584XamXlKg19HuxxKlsbbHrdmM8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyJRVoiXWtoEFQzOC6T9k7GPkuhk9NK6I8z0leTFEjOQ&oe=6AD25562"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
&oh=00_AQThB86JC865JIYf7hqZ7ZshRhxYItDt-m_3B2Phe20iug&oe=6AF8832A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjOMzWZHpH0Q7kNvwEQnjAg&_nc_oc=AdpmDIb-rWDuFWDdjXyYCyQdnEdBiwUZJpwmMNBZTNeYu93YcxpvrpsuahdJaLB5rHk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9dtXGSrSD4JxUebj_JuRPiH2pwTBrFa4-zr9YM3ZBfQ&oe=6AF8AD56"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpJGqTDODpQQ7kNvwHqZZEu&_nc_oc=AdpY-s0PIkHRonEceehGleUOTWxGuzomuaCUamoL9_Sb6KOCGAKcHY40li5yVN8asac&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaqOQQ8Kk0_UEpP2GmTUp1iToSycJbIHdjyPs2GL0ALA&oe=6AF89333"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3hwZJv71AQQ7kNvwF0LyKL&_nc_oc=AdqQFbsHcvE3DJRKkS83GTMbyEtfs_e20PRwnM9XFkVFBU2myPscKdoNJGNJe0BzB08&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6Gw4ofWZLcY64XTR8uxkiej8jI6ai6OnLJIWTT-_V3A&oe=6AF88BE5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UVIZDQMww0Q7kNvwF9dWfs&_nc_oc=Adrh_umEzmkn95SUfcOcoTEPYlw5iitWYzYYB3fuut90d3UEmcrIb9tf_9lpB5Ft9eo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9_0_6pSBSF-7SnwuT1OjeV81uplh2n2zQ2-wrfQLLRA&oe=6AF8A340"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iU4WqekUs60Q7kNvwFpfA7m&_nc_oc=AdqQsJopO8z7kauYQekSysIDMbkLzX_0VtFh_Ii-92dPILU4BE_B_luebGPASF0zfCw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmuHk5B7H5STL6Zbl2VagcYfwrjTfhOEOz28VvLq8o_Q&oe=6AF890E2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
&oh=00_AQFqYP5buYlELrD6OefarTi6s6THVAeQnVqrXP6jTxQqVA&oe=6A82F56A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cdg5JhHxGWgQ7kNvwFpe6B7&_nc_oc=Ado4LPLUBvrj-TWI7m5SR6VQVyIbpD_XsiV-Ni9KVpwGQZHcLI4Vet4cGMGLYxOhGlM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpAXJaGDtwZXZ2KLvKne9Y1FloYswM0vdrpmmk1Dojsg&oe=6A82E756"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meBS-iUtflwQ7kNvwHGnksc&_nc_oc=AdpeamZgoiCOuvRxXDGHcchv6YWGwd0AuNw1UU2zJHSq9eJrDvHfD2HTvbOpZTfjKUg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGui8XVk_uhi3z22JlmSSogDcUiDOdocE2OWDZnKyXxWQ&oe=6A830573"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m88ccHCttNcQ7kNvwFKbfvv&_nc_oc=Adqh9e7elzCrFSPBB_g3bdw2p4SoKs2pN425NRWkr96V13iVcNZZR80ooT_E1NxjPv4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkOZ8RmY-hbA7K5SA_SWRY-DYLLlW4FgrMe5vMsE1xig&oe=6A82FE25"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOvsQVkeSBMQ7kNvwHje1R6&_nc_oc=AdpHo53o52P2r7IcQxRGsyURkGJ0s_A3obJ317jvJLkUu80t9a8zf7SsPwGA62DYaj8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYkBvIgxr664Dzx5c2jbvesjIRF90ZwXyy052BFs4VMA&oe=6A831580"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAGx7yY2YxcQ7kNvwE7nJVF&_nc_oc=AdpaUs2JK8TwsDTiLYm8TyWhcqW89AkXIvns0EGtHm3uy-FK5rtLr8ByjefTOubLeJY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZt4HIPhwUiqyZP0an7cPI4afNlgH5zXnVnD9VwDayYw&oe=6A830322"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
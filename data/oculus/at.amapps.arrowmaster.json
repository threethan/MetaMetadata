&oh=00_AQAhqlPkN2u88mrbwyZnb2Nk0eoVV0Qgs0hDKhyXte-abQ&oe=6A6DDD6A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKPPrruNKCoQ7kNvwFmNj_I&_nc_oc=AdqN8lH8nK7pUvNQKX2d7a48Qq4yd0469WCuldnAncizbs9wnu2Su2FdCU0a1h2-qNk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3Rdr8UYoB_CTs7DkaExjf2LOjn2tl7OhbORyXYEBDgA&oe=6A6E0796"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C09Lqg-JKTcQ7kNvwGB5FwW&_nc_oc=Ado267vPNRmVMEsYOcH8xukYAXjh6md4huhp8Y5SN1ZCT3Ew06bPfQPQlrgJdVA3oyA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-HhS9JuH7ZRS8uxm40cggquJD0OUCN4q9mhJNbjnMbg&oe=6A6DED73"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_BpDWvqfdQQ7kNvwHRTsYF&_nc_oc=AdqifRJ0pFH6dNpO4p-EOq2HaCSjlPWEApo7LQCLQikRBeSRod0G3pFlq1-lC2PW20c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1hE9Wrx7nkzhotMDYtTSkCtS5ccBpwsz2lFvGL-exxQ&oe=6A6DE625"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYJOtPGLuqQQ7kNvwFDqzkh&_nc_oc=AdrAywMgjhyyrOr5GE2SU60RVYXB42T1pYQfMsU5QD4cuASTbAX43mvAbTadD7t9cxY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXW0OwGB719eqSFwtIcXy4Im3FFE_KnAzZZ0QNN15b_A&oe=6A6DFD80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-PF9Q1j5REQ7kNvwEp44Cu&_nc_oc=Adp1_ox0Q3rVFkAwMaNzLcpuZQIm7DYkzXCyeQCqzzuVbaaVadGOHrz-LZmgUUuQr2M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAU0MZ8Pz0CfP8xrz6BZQk_2grhld82JaA8XkjHr7im1g&oe=6A6DEB22"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
&oh=00_AQC0xiNiGQeit4AHlz8XqhezLUeh05lJsHxCVIMzFCo63w&oe=6A4BCEAA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8Y_0Hv_0gsQ7kNvwEp-gYz&_nc_oc=AdpejzyE_YPxLFyN_aFdSzqkVyuKzzuekLpV38dyKOIaV-odKWFiKipJySXlGorGk7k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkdYV0c4Z8wMV3L5zempQr4QouvdhFlvNVujdkR6acbQ&oe=6A4BC096"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_X_wn_BYl8oQ7kNvwFezTpL&_nc_oc=AdqBhEfctfBy4OrGKGo-ngXLybXkwd5B8rd4i4Qylr-UOPj_-WG-nfKuxAWIKClhoQ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVy6Bo5516LX9IVdN8yn7P09Lxmfun-85dLIV8VuJB4w&oe=6A4BA673"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qiLZOnOnJ4Q7kNvwFme89U&_nc_oc=AdqZ9LGS353wDjVXJVdEO_IA7EhUV9MWVfDsnhcXy4ZwW4Jbm40jPUyj8qYqDxvL8Ao&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXSZBuNmwnndYBgHa4_p1Ia509fHmIWwK2n9fo6TxW2A&oe=6A4B9F25"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdO52zPCIwgQ7kNvwEifpvj&_nc_oc=Adp-NjtgIh4z54LBZCi9EfaPJFVwzXpeicHs8sANYPZYAMSQbASrWbuDbyFETvdBF4Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2manZltFA4Ay2MsVXKLoLg42HBM1jTCCvqWa73Ubr8Q&oe=6A4BB680"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_l8H6kbqpd8Q7kNvwFEK0F5&_nc_oc=AdoBPpfhzRl14UweJhrv94T7C98a6sYu3Ce5mTUuhKyn-B2G9y3YYI1Fxwio504_wE8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMor0K3-8hlcBgcNdYqylBABqHRm8WQTrkFca-qmq0IQ&oe=6A4BA422"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
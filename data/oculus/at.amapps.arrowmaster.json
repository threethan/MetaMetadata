&oh=00_Af9Yqbr-BUV3PXay2-MR_fGGKK33F5KOv2ZbmjWiLIwg2g&oe=6A219EAA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnKlKuYxfB8Q7kNvwEvG9ZU&_nc_oc=Adpk0Ke_NP-CH3e4zxdimD8Rc--HZeS_dzOQYz3MSrj_H_4xU1otAmudQJQSyEHOHFY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vFLXA8fZ4VDPECaQQVcZj-f-gnVh14jsSAN-kLlmiwA&oe=6A219096"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jyb-OUjIUOEQ7kNvwF9LOem&_nc_oc=AdrDXjBXaossFT_qzfuYB55itXbosDVA-ZnI8QyYJglIHI66eaC_mkArJS0bXpGPwzg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DrniFMWfEa_bVwglqA7ycIMXXuUyaiNxNWDMDQCkiVw&oe=6A217673"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykAM6XsGX1cQ7kNvwF1RXZc&_nc_oc=AdpjJZl_H2ZFUieXnbWZada2UbanI49iLixJsciYWwzj0y2K9Qryx9LkySf5e7glu9E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Rrkil-uy-WVFW7P5hMKCaTtb1Cbu7-LPctCEjmZnI5g&oe=6A21A765"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfYJrdZfKQkQ7kNvwEavmFf&_nc_oc=AdqDv3_7k9UhIInGytb4Bd-KvpZ5H1CqCnO-eUyrzXxAroxI059gxElAxqZm9JUOwgw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A7DrsrcRbGBYQnXHrZzOUFbJbxDIzlelSu4D7mcx3iw&oe=6A218680"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAE2H5VuswcQ7kNvwG2HDw9&_nc_oc=AdrFHIg7FmPRz_Zoe_EnttmTzDkFxU7zlwQQwMY27-4HO1dOmnL7SbDyzmrdITL8GPw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ySWYdHLbLoHFKlBJ4b99FBtuAj_EgcmAd00umcUuK5g&oe=6A217422"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
&oh=00_Af1MYtZnyXF3ORfXMEHyuJWxUZ34JoeBa38HeMFIUqQu6Q&oe=69D640EA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksw2ascVEd0Q7kNvwHUKnzZ&_nc_oc=AdrIqmEmPFnRbsyPBK75lMF6pIw5IzEpW3hIwJy2YQ8ad0cyPfkE3_mZkFUBVEEPMHQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PnqiU8uqWTbnyKG7TavNTIhQlxtt3WjGABqlXgIf3ow&oe=69D632D6"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66rqlFatNY0Q7kNvwEUeC4l&_nc_oc=AdoxTpjeN6-ddCaQr5mlqX0hBG07MbZvVAf2MU1xbqzYDBWO0Kn-bkHfjJhfJnxSqhE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01UWdPlQFl7neLJa7gCWGhyR4h3eQzEcz5TwBwcMxorA&oe=69D650F3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHpC2PqdB8gQ7kNvwGNqv2_&_nc_oc=AdptAQKnuyFi9w1BmsDHCd68mry-GGBqZPUEHwNApX7LDua83YmBhl7UYYCieEau_QM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WOVCq1tXhY9DBC1KUC-BMv4uETAB8Tkpavc7nvIKQ-A&oe=69D649A5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9g8RVezSeMkQ7kNvwHoG_Kk&_nc_oc=Adott0uPScthF7EVSnOR47JyahosGx13vrxnouEr2C9la9_HFedVb58HVCul7myFCTA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xCZyVqPtDODGmWUh0svjtbQ0UxsCyqxTNDYkvprQs8A&oe=69D66100"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7y8sJaDix8Q7kNvwEDVNop&_nc_oc=AdrktL6Zm7siIC6a3H8QoWxe-ggpMGjvomX_q4J8OoR8eaz9CkiHU40Et4xhgg9wtlQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2p2FjG6qVFULqGKFx5vd1NJo_YsDYheXoznwb5FuSYbw&oe=69D64EA2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
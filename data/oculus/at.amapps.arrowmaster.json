 "746674656693373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ho1dn_tH10kQ7kNvwGF21gl&_nc_oc=AdmhfDmFMBsWQMNKKR6ofy7KU1Xwz5vLVebtY-pmTQWP4x4CvwetPFiOucNv-LupVXU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftF_3wC_zZeqLWywqNrLnfdeSzyvDK061_76ypTmRr7TQ&oe=69A419D6"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzqiK8KadHgQ7kNvwErJjnz&_nc_oc=AdkjzXuQ1_FGx129rbv4k5nLIXMG9goXVUozqiqAJu9zlQDMrqbCUI9SbQL8WGCsczI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft43UXBtqdedJQ45JQVREzGg_keLLqpkr0mz2tdMuvKSw&oe=69A437F3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hns6s0UuggQ7kNvwE0MweC&_nc_oc=Adn15vALuM6pq82g8p-anKEDcKCRjR8tbjkrtb23RVaMMsVfa0b_MXx0Hvb0x63uih4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft4Xm-YQd9acmXkwsO3xpzFWKlAcXAJuvqQb3GoMAh8QQ&oe=69A430A5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbHEojE0yv8Q7kNvwEon11Q&_nc_oc=AdluBX-hX2nNszTG_BMccXg0V74cefD9qTLiS8MkGOnxotjkoLBzpHYnQ4BYEIz_vr0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftonHBpL6lD9YCrF4ZiOoz9bT4QOraIgeFWFQUq2XX0xw&oe=69A44800"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYoL12pxLkQQ7kNvwHkZfPM&_nc_oc=Adl0O7R_dGJxl6ASqVflZrcR87R5yXA6dOxGBaTJNUy9FhvUkPlCF-GbVqjdtXU984Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftm3aZVT_t7COPPAyYYtcSiuCqG_QOpA0PJMLVLdGNn5w&oe=69A435A2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supp
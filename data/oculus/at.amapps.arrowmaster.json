0f&oh=00_Af8CWs2F1Vma15sGC6nYk5Ua1QMY7v0GBXsd-u4uUSJxqA&oe=6A3959AA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSl5727mhLwQ7kNvwHMKSkw&_nc_oc=Adry1owP9ILvSGfmwSyic4eTGl_kqXVX2GIoSPFkwNhX_6amVkponDH5MPrSZIq7qBM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81VxA7ume9eI8CFt5xLrJwjraaSR---clkDpLdjE7ueg&oe=6A394B96"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBNj6gRvTzcQ7kNvwEQSd-V&_nc_oc=AdqRoDgbbdoKPCNh57v4_QK82T4gvuX06XtsrZW5gBShRc4l_pYqGkV3NztidHZ--p8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9frQ01AchSS3lPeACFV1L6OwVAPaCTnu0aG3SWExIBYw&oe=6A393173"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iW3T8YP4FCYQ7kNvwHRrVnt&_nc_oc=AdrL4pU3GJIWHTJIvsKrHVhHn-mvXuCvpZKaFIloT8r5cQ7TsPlMIoodZN7nqxh_tck&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rBr6oZ3Z9t_bTk6hL-NQoopq8J7PcKaZwtz4RzQ1UlQ&oe=6A396265"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIJoVdtqpd0Q7kNvwH3fzcl&_nc_oc=Adonwe1kscatLf69uJ5cmi2ayXWAmanZpFT0ijeUdaJiVFVjB8jIDOd6kM_E9ols-Kc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ctlpVbmWD_0Co15AvSVsUob4Td5yaYdxmrtZRi6j_1g&oe=6A394180"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITjtbmXUCXoQ7kNvwES2S8q&_nc_oc=Adqe4KpdCuJ06oEv72hwEPEhWdE7KrVlIHloCkc3LjCo2JCdoLPay1LcaGWHN0QPhGk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94qKBp-b7sgDZ7My4-tPiOfKXwTSOfra_GnZX3wNFLBA&oe=6A392F22"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "reco
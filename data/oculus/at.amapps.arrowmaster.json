&oh=00_Af_jDme8sIYecJMPD0Wag14Sh85jj5nlCcgp-IoBGT-cWA&oe=6A3D4E2A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feHqcnCyuaEQ7kNvwHXWpua&_nc_oc=Adp4tNG_Ppm7_iciKVPwQMyqAkx2FUzFm2678hOZtYFAW8kCnNBSM3XUBWZjGrijOu4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8B4S1SprVqrdftDkMnot8vTe7o_7MHh_LgLSjA1FACYA&oe=6A3D4016"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTx73NFPHCQQ7kNvwGslTqh&_nc_oc=Ado5bCri49RwSgGKtFWQ65NUG8q6xfJsyc49BE2hzp5OBiiaPajAq7sLQYjfdWK87bA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nDBf4MP8kUvWTab0hVOG71wqf8xj0sjqCNpUDNjtA0A&oe=6A3D5E33"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZEYvT-xAP8Q7kNvwEX_sZf&_nc_oc=AdrBf5M6N-Bb1auFzwstrFS9zPs9vpsFotvQDkPxRMaLQGBoQgjlF_iMym5lelF6eh0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lMEAn5zbbpSAliL28ebuz7XwNp-jZ63MPIj_V2k8gcg&oe=6A3D56E5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGwe3khq-8gQ7kNvwH2VgC3&_nc_oc=AdqXv-AGAFXKYEXbYpb0GzzvTrf4UJzI6cU4jv1mFz1cQ2r06Z77653lExOMmnuD7-w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ae0UqkmdFSwN5apVtUKc64PcgO5cCMLfRupSqHddcZQ&oe=6A3D3600"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoyLMCBs0-YQ7kNvwHj5KR1&_nc_oc=Adpyattdis674aCSbI3X3pET4v8yY-6qoS4trm7om-QWugPAOIwrRKrr-QvSU7yaICQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vTr9cXcW99m7FBTCSopXsiLHTJcNrmgIWgdXjLIhUxA&oe=6A3D5BE2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
&oh=00_Af1ZyqmAJQiqUChSQU3-dMWGDLSAym-9ZGuSGlG1QPJ9CQ&oe=69D39DEA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksw2ascVEd0Q7kNvwEeThzS&_nc_oc=AdpR4xXjd9Hr3O_0PAvYTs1TM0lblE2CznF3gzvU6A1nw4kznYQsvP09hIH3tyvsrkg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MPXHt4t5KtnXEzZAhSorMss0lyMNdfF-LnGN86l_2Fg&oe=69D38FD6"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qt5YL5OVQxUQ7kNvwGCwvp2&_nc_oc=AdrE4BthghtJkptm0EUbYKuiscjV4CNeESpyAtaIX-IAAXrCX2VbB6PyvyilpWp8rI8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Sv56Cg-5JhgwQatHIIfBP80qWxs68Sdl1TWyHgRX4Pg&oe=69D3ADF3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOvGtuhCvtwQ7kNvwGWdhSI&_nc_oc=AdpjMSj5b7QoNkDDsDKIVznnQyxcUhz6q11vcFLsWF5272yb2extU5-r4txbGyq84cU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Qazc4lcG8z8d_6kjL1lXsMWDppetMmOf2cqpXkcLavw&oe=69D3A6A5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-fMyQC064QQ7kNvwEtTA6d&_nc_oc=AdrcH-pdgdh5inq6LIc0IXOLSatThSu0sOs1qrdJHmElFjKftbkpAqzrq1L9Fe1nZ6w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39AVsDxuIE_oh1hyg-7Kw2bmv6Cb4uvDXC5BDfy7Me2A&oe=69D3BE00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOGzU-wmpL0Q7kNvwEustNl&_nc_oc=AdopSSiLqnF4iQuwvuB2UUF9ufM8ENa23tez7OaFgj7S6rg9KWgkUtwgxCpNEyU-W4I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15Q5niZiTZixc7f3LAZs3kCdwMa9WfVhesf400bPdtNQ&oe=69D3ABA2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
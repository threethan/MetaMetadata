&oh=00_Af_jyligUIYieYadEGXajcQbGS_4_mcdF8T2Td3R2p1zQg&oe=6A2C2AAA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYoRr_9a3xIQ7kNvwG5kIeK&_nc_oc=AdoSxV2Bo1A8zLiDy1sDpmPpnIV520LYRIpVacIx06n2DaUwfCr6iDULyp_aA0Vxces&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZGECiB_YwSLlr4TGrw-VRyxAjzeVn3YaTOzkueQ0lJw&oe=6A2C1C96"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPBGtX35AlYQ7kNvwFArK-g&_nc_oc=AdrqY_OjlktBSW8AGhJxboU2bhdnPfopGDfOsT4B7KFvqC-uEYctREVj9IN1QRaxKgE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RqjvZlJLNoXkGWiSgE8ys7-1qjP-H9ImL9QbhUutSnw&oe=6A2C0273"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cw5e6Bv9B0EQ7kNvwGmSS51&_nc_oc=Adr7NCUKjFKtUfXDYelGVd_rdhRalmuuIAm6Kp-JpXPV_svgF5D_H0IW07dlqjEQV0A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SNRjhY8q3OPYc3KBFe0OY4dAcKXxH4wL2ZSlL3tz__A&oe=6A2C3365"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oj6fuynqsiYQ7kNvwGBqLEz&_nc_oc=AdpMLtTiHX1uNOb4L8XNdb6u1DPELOIEI8SxjUnbFhbDO335wDc29Gbw2qp6r1E_4AM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8v8C9aFbSqiEag8brEczmNIy8D4IojaeO-43mk55wMFw&oe=6A2C1280"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wyb25_skOW0Q7kNvwHLlekA&_nc_oc=AdpUiHjVhH3X9xwvm70SQw4WN3kxrl-jxpYgYHerHo0h1NtImXUTqiCjUFk97PEOZMI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89VnlfLaWGjg1PzJssTOHw1LbpppvEZZm5qVYX-Tpk8g&oe=6A2C0022"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
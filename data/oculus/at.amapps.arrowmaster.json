&oh=00_AfzKKvDFlzpyJxIXVfIRJzFX3p1fqXe8TNrtroL9CyVNag&oe=69C27A6A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Zg8aC8WLKwQ7kNvwEXiq61&_nc_oc=Ado46pOsZV4IA2grLHl7cvQ9WdGTXZIGwAss4JEhzRi7EeecNrxyn3F2kqRmevW9IEA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7EqQ8-pwnOYa2dCiC42afnSDw5RD51Qs9aJJBEnXr4Q&oe=69C26C56"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvJTamwjpM8Q7kNvwEPAQhq&_nc_oc=Adpgywb9JwyBWyX_XK5snTU5wMlfCOqw4HY_29AIIaDhMtnOTNgXhq6RfODXiTMhaMM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyrhLsauO2RlTXnWHUjJQKTYPAX7Au248YD-BUWn2YbYA&oe=69C28A73"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bz5TUSIqm9oQ7kNvwE-BGQk&_nc_oc=AdrGItdthifEHXOX6BwB_xwvqawqZpETD4_Pja-lPStc1LbX8f5uhwakLKIN77injSQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySTe9_ubDWsGAe9KPGe13RPhnJ8slQSBR3xkib3oH0eQ&oe=69C28325"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoNL8RmJghkQ7kNvwGAXvQ7&_nc_oc=AdoAJRQT4XdEvxKeKm2SfKUZzZ-SN8ACmcjzr9m26pj71ZMTeo6IIOvkokRppH-rceg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwe_uqZOfH7pOsmu2zjqbd4BJt6SmjAuO_JWG1p1nkrcw&oe=69C29A80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sn5AiXt2KYQ7kNvwHahNCW&_nc_oc=AdrmIRtVGbg8-RT65jkHVCZb3WSHCRvkIQdOwzTt3hksWdtf0QBPSR3ipBexPOWGd5w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7t6WFmMFZ0ePOuo_DEIwi0u4y_QNNtjCdAzz8RRobbg&oe=69C28822"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
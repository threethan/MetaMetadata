&oh=00_AQAZDQKvTJonbt63xG0hN9MLsGIrzXHmaF5dyTbkXJ1Ngg&oe=6A565AAA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWlwwKJmkDAQ7kNvwElhym4&_nc_oc=AdonfQ7phmr_-N-Of4C14vru-5HrcZZ7VmxLP8FPikw8iH5aAQZCyP1lJAaZwz0yhow&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_IjNxgCjJXh4L6NeO6dhH-b8e7djfcQitIft-LDjZPQ&oe=6A564C96"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFr-uS9fk-8Q7kNvwF05oKq&_nc_oc=AdqfSdPrDTdYOZ2biOZKbCjLKkE7fOq0YyoBUubhFWBLr5lsIw3CdKCJX5aun2JaUjw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsxn88XYhJ6xXrVrcvNhDYgI1Zx41LUFNQHEglHqVmlg&oe=6A563273"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqNu15Y4CWMQ7kNvwEpkQQJ&_nc_oc=AdohB0hEXa7iYvlB4FD_ixJuxNhjS27ERCFt1zL7fhPrLUApviAZC-f07m_fpHBpObE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDItBNuaaAVoXIfauggmP6VjRwPLkcD8mAK4jxgH2AFMw&oe=6A562B25"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLVL7nZR0m0Q7kNvwFgojkg&_nc_oc=Adoc_r_DWdTGwErP8gCiTXEm_PwTTlI7ub8aGa2yoN5XkQJXOYFZUmt1Kt3kFfX3bek&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeVt92AjUvHv1cL0JCS9wnJOXumhPGT32_-ss2oLXj8Q&oe=6A564280"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5asIX6C6tcQ7kNvwH-xFRq&_nc_oc=Adq8I5U1_51bROfEpmLUHaH3aIC0yAAjjt6ljwk1U_dbH5p-NNgdr8ttTsh_OU5htM8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPytaxi6-bTSZHhLlXaarU4ziCXlNymlvuC9yG6YKZXg&oe=6A563022"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
 "746674656693373", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ho1dn_tH10kQ7kNvwG5DL37&_nc_oc=AdnRgEI8OJbAqIQ96Zi3vK2F06UysLcuRKAovm4SAijwoTx-oTvQgvIvP4a84YmgbT8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuaTk-8ufhDlhOHcY0D6MHma8B1Icb76u7cwZln6_xJrQ&oe=69A56B56"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVjiqOGsJw0Q7kNvwFPvHtd&_nc_oc=AdkMMwDu1IfRTUlO6y9YdrUF6ExQ75JvkhFUbwO8Sb7rdKk1Nqb9LxR8duzZw2HfIgM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsQ2oC9qE2Wp_GOMB3Z32hDbhALiUC6mq9zPWu018B33g&oe=69A58973"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hns6s0UuggQ7kNvwEeG0CR&_nc_oc=AdnBwvw9T0a7tAl3SGDGQyQ_ExsYNxQGjj-YzcBrYbODupFhCNvWlU7BOkpCyylvnqs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuMouSRz8mGfRFtthNw64hFq3-NEyXGeLDDOOfpo66B2w&oe=69A58225"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbHEojE0yv8Q7kNvwHdHa7W&_nc_oc=AdmrizkwhSKVTIZnFS49TAap9kM3VzgiZHcCURo7TqwkQwaYrlaClD5Yz89EV6SV83w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuB6246JUPf6p-6X5rqHFtvfrUjx5kgdmQaAtZUjpCKDQ&oe=69A59980"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYoL12pxLkQQ7kNvwGCzu48&_nc_oc=Adm8wnCy0ezZxoA8CaxLq18ffJCTpPodkvfliykX_5RYCtypFPUEfJoul_8--PSxsa4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afv5s0LJ74gxTnZg551PFstOvut7wc-yhqKm8whFWTLRfA&oe=69A58722"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supp
&oh=00_Af-0E7B4FPKTQoLWxXqUpgNEpKLww2meXttYYPP6EVezZw&oe=6A301F2A"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtqLon6l_wkQ7kNvwFDmzSB&_nc_oc=Ado6Qcjd2tjtIISKbC0atR7Pl1zxv2EXBnuBr2X46yxRoEtfSfNsLm2_Kd6Fs7ICep0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Tlf7wWkVHoqbtp0VvUgXrBRA8Qk7-bpQHLdSN5UnlqQ&oe=6A301116"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXko2KlFhTAQ7kNvwFqMKHN&_nc_oc=AdphUsuqsXlpON3gFQPdTu__BB5iKZnQ7TnzFSwSpmtTI3fjAEukTyhPhHCa3stmsdU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EK3HSYkR1CGUKXE5EjPLo_OUB6wqQbI_6Eod3R8BZlQ&oe=6A2FF6F3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWSpVB_8ONYQ7kNvwEKEjMF&_nc_oc=AdrJTFDMaW4K7NgdAPyD7m6bCj5TzQ1aSnBEyx3S_ZqhRFlOzHrdSnK91h2_85Km7Gs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-S3OwB7hiss4NCS6j3CbUSce6O9vcNbXmElMC6DKuyYQ&oe=6A3027E5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_Q6QULWXMsQ7kNvwGMxfOx&_nc_oc=AdpZ6Z7U-_ftXLo03YQ3PBMv9sbCDtxake8rIp73cMCI-jrJ-xftchmF9kEpio61QtU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QiZHSxzsaS-YdYOBLtUxhZqQ50JOI5RntC_sTOJ-UaQ&oe=6A300700"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tqjzq71VLVMQ7kNvwFpFjp6&_nc_oc=AdpVCER8MTylKEr143t1-gEdDbRxFU5D2UuXyTXbhbK1P3LWloVnJ35FRhN-RT1d6RI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZzHxDBjyVBN2fMaxJs3ziMYxTg06HT_Stbhrf0JFcCw&oe=6A2FF4A2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
&oh=00_AQHggWI70ZRo8O4QL789aVAu_CSiXQxDN4csmhONip54lA&oe=6A9175EA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGnSePfZFrYQ7kNvwEle6Mn&_nc_oc=AdoTtBsWmIsBvCVY4-bHVw82furKKKCsCsDSIxdCc-BcULAyfQybCOWlTMZrOmxvdcM&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmemqCCKXD_VUTaj7XwUx06NbVRo_H3EsdqVxmdJqjYQ&oe=6A9167D6"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DrRHnhHUa8Q7kNvwEvioY9&_nc_oc=AdrE6yuVBaBCoPmWZozpwNMn-7iPueniO08ZLj0p9zpymvyFAIYFrv8o1BwekKOQ6Ec&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfiDMBoBtf2UgEeXhnfvoz_JPFNye16McfL4cYZaL9Sg&oe=6A9185F3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkJjgItdSnYQ7kNvwEjOMoV&_nc_oc=AdqzxhWWnh35L858RhQB8w78RVV8W9rdE-9xhFQL7HYgu3iEcdHrMieKcvhyruu6CQg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJNJ9wjZ38yQHihgAPl0ODtpqZNMs12Fau06s28MNDwg&oe=6A917EA5"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYf0RszY1kUQ7kNvwFjMLng&_nc_oc=Adrh3_0QwAad_2jeMhbsSuF09jhiwFXjIwUFBvbl2wLjiLt_Oz9Zu59sJ8Hnkj1doaE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWJcJmGDCKo7zIhsq82DBPmT_XZC6NBR0TWnl_C8DjKA&oe=6A915DC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_OobMbzNSOkQ7kNvwF6Be91&_nc_oc=Adrdp-YLNTCAAylVF477CSWnYYCXRuhe5GW4jRoGQY3uTqaeMEOIieEPQHjuL9OBAGw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGs1PfPAVnUb_3Q8NHpuVfO9u2z7XTcwE45RrKmdx702w&oe=6A9183A2"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
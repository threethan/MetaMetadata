&oh=00_AQTdRrjV69d28cQbumnYXxRARb6FzxLpNWPtnYC6INppig&oe=6AF48EAA"}, {"file_name": "Master-2.png", "id": "746674656693373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zo2NAg7jX5AQ7kNvwFvPk5_&_nc_oc=AdpD7w9AaMi9AJKXAR3bTtI7hHogDITzh7_3s_lrYrcECsvX_Pppwy4dMXZrdG5F2t0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYEa9cWuqHQe97Fi_jjdVpbw878z9LcXzgMtx31mjuiQ&oe=6AF48096"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYR_8-r0128Q7kNvwEQAluO&_nc_oc=AdrCQZQsoDVx2enltvCf8R-azX3SiM0K02paXt8i_cjA8yhiLHGCYPwb3TfWa-n47IM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2XYTHvn_9IflY-awCXzkYKD6rSwH0Hzm2ohvSdRZeFg&oe=6AF49EB3"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSmfsUBwoYUQ7kNvwF6stU4&_nc_oc=AdomdDvoYzZi1Ove4V9biK6-uPwsFfB5P-cJJP6zf4BzEXl6K0K1fRpAK11B_0vRdEw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuQ2f2AnMi9VuYeoasrpA01cLx1JiTE0eCbrTKnmRmaw&oe=6AF49765"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bW-T-CjkacEQ7kNvwEc0b5s&_nc_oc=AdoxiD4DkhsDGujdAj1LIPSsCNBK333frN1whkc1ITwhPAlbVkVfH8PgVqlnei5h5N4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjUdG7gtHSjcF9pnbmT6e6av-iZm6dmqJ1S7EbfRMPqw&oe=6AF47680"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dj-t20jcB1cQ7kNvwHB06uD&_nc_oc=AdoVvLHpWdbUx_AwpSVJZZi93Yiq91vI5GsURE7fFT3FiBfSXc9U7lDMwH72uV6l-mI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJYgwLzWC-3l7oadUVxU8VxgsDGs1jaJjzNLxOGlfXQw&oe=6AF49C62"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
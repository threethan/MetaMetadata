 "746674656693373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031387_746674660026706_1093039497738084575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oAlv5sNeRcQ7kNvwFUM45A&_nc_oc=Adn0U3cTILEH4oET6PEQ0_SygAM8ZBv-UohXv05ek2WfL61vYHj7Zv7vPv1Wo6y_wmI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsEpqJsHoAD1OInDRFuEtEYxvhRXX8qpVyHC0DplZryuQ&oe=699ADF56"}, {"file_name": "Master-3.png", "id": "771643413817570", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210896_771643417150903_4303972191552407160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJZQOYZ9oPwQ7kNvwFQuqp-&_nc_oc=AdkdXMWV-IVO9PgszWJFF6tpCgqgModP8e7AZH5s3IYZhvFO36TZ8I3bikrHdtKiX5I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftDA3VN62u9HJPQy4cjTI9nT1h9WqijYa85FrrT1fxC3g&oe=699AFD73"}, {"file_name": "Master-4.png", "id": "557489166409298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75540503_557489169742631_6163921996793232814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAFazBJW5fAQ7kNvwHkNW6P&_nc_oc=AdnkRuoq7OLs13Fv1Wbs35z0OpkLF2ZVxeh4KP_vVpkl6e1r6wwaSy7dhKi5Tgme-Xo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfslquoS-SjdtZPPHldiDmZd_I5GQwa2NxHnHGE6gctQGQ&oe=699AF625"}, {"file_name": "Master-5.png", "id": "6776745459089236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75568722_6776745462422569_646325243917089556_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80jEeIBWIjYQ7kNvwG3ln9z&_nc_oc=AdlOXt1yk6Wo9k1GuKXQNmGzQm0XUbA4pzDnyJilnan-Y8wQHsd1Qx3XZALXZ1485NY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvlkdNbt3XoxsFkAt_mpZ1JO0yh0dRoP-ZfcdOePf8wbQ&oe=699B0D80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master-3.png", "id": "740231434164987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75241700_740231437498320_1452555169856770047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3J1wAnAzvgQ7kNvwGhSZjS&_nc_oc=AdmglUlgS6KK6yyTnHNeZrBtFU0Xfnue4x_LVhsDDxjiS_d7iPr-wLtHXOD6YkLW3D8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvGz8YBMRENeuEDwWLYeNHohMryqf_0S460o3DeyKpaBg&oe=699AFB22"}, "display_name": "Spear Master", "keywords": [], "long_description": "Spear-throwing Challenge is a fast-paced and addictive game that tests your aim and dexterity. In this game, you'll take turns throwing a spear at a target, with the goal of hitting the bullseye or a designated area on the target to progress to the next section. \nYou'll be racing against an AI opponent, so you'll need to be quick and accurate if you want to come out on top.\nThe difficulty increases as you progress through the sections, with longer distances, more challenging targets, and obstacles to avoid.\n\nSo what are you waiting for? Download Spear-Master today and see if you have what it takes to become the ultimate champion!", "short_description": "Put your skills to the test with Spear-throwing Challenge! \nRace against an opponent to see who can hit the target and progress through the sections the fastest. \nChoose your preferred spear and adjust your aim to become the ultimate champion."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=81", "developer_terms_of_service_url": null, "publisher_name": "AM Apps", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supp
a0a&_nc_ohc=MW6eCH47QCoQ7kNvwFhWJph&_nc_oc=Ado8op8p6IeZFfs3PbCnxMo6u0OUXEQwmzyYcQxQaX1QBWVU4m-cqN9hwRfq4FWMEQc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiz5J72_EmpcPmukibVU0_P1YzMkLoq9jd8N2i3-U7Yg&oe=6AFDD2D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2023-03-16 000223.png", "id": "6498923096785654", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031321_6498923100118987_1280635150636112517_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wp7ai_p_m84Q7kNvwE2MRWI&_nc_oc=AdqjtyhfX3Ha5636SsXzytYjhpzDIdM1xZ07jmMjTipiqA5ja2O9sdDko1kbr2GyHaI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG1GiJppskzs64GGO-P9uyw8q_cdFefwqq5OzykoMVkg&oe=6AFDC348"}, "display_name": "Court Time Tennis", "keywords": [], "long_description": "PRACTICE AND IMPROVE YOUR TENNIS GAME FROM HOME\n\nIn virtual reality you can always get court time!  Move anywhere on the court and smoothly line up returns.  Address the ball and see your swing just like real life.  Hit shots with spin, power, and aim that go exactly where you want.  Express your full tennis game and then improve it with drills, rallies, and matches. \n\nCourt Time Tennis was created for active and aspiring tennis players alike, on Meta Quest for a portable wireless VR experience.\n\nREALISTIC PHYSICS AND CONTROL\nCTT feels like real tennis, not an arcade version of tennis.\n\n20+ CUSTOM DRILLS\nGet high scores and climb leaderboards while improving all parts of your game.\n\nPLAY AT YOUR LEVEL\nFine tune the difficulty of every activity, with optional aim assistance and guides.\n\nATTACH A RACKET\nWhen you have more space to swing, attach your Quest controller to a racket or extender.\n\nDRILL LAB\nMake your own drills of up to four shots, with any speed, height, spin, aim, position, and target.\n\nINTRODUCING BALL BOT\nRally and play games against a futuristic ball bot that moves and hits like a real player.\n\nTHREE COURT SURFACES\nPlay on regular hardcourt, fast and low grass, or slow and high clay.\n\nCHOOSE A LOCATION\nWork your way up from park to club to arena!\n\nLIV MOBILE SUPPORT\nRecord and share your sessions in mixed reality from your phone.", "short_description": "PRACTICE AND IMPROVE YOUR TENNIS GAME FROM HOME\n\nIn virtual reality you can always get court time!  Move anywhere on the court and smoothly line up returns.  Address the ball and see your swing just like real life.  Hit shots with spin, power, and aim that go exactly where you want.  Express your full tennis game and then improve it with drills, rallies, and matches. \n\nCourt Time Tennis was created for active and aspiring tennis players alike, on Meta Quest for a portable wireless VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://courttimetennis.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ProShot VR", "support_website_url": "https://courttimetennis.com/support", "website_url": "https://courttimetennis.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "482952943924085"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "261884313468972"}, {"status": "PUBLISHED", "id": "1883583838762254"}]}, "baseline_offer": {"id": "261884313468972"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1723149297, "status": "PUBLISHED", "id": "261884313468972"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8500688549994122", "version": "1.9.2"}, "id": "2140152696375565", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6400132813383050", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8500688549994122"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2140152696375565"}]}, "change_log": "It's the end of early access!  Thank you all for helping Court Time Tennis become a Quest Store app.\n\nAll early access players will have a 33% discount ($9.99 from the $14.99 store price) to unlock the full game.  The free demo is now 30 min, the same as try-before-you-buy.  Only the tutorial and tee-ball drills are free outside the demo.\n\nGAMEPLAY:\n   New Break Out minigame\n   - Clear waves of progressively smaller targets on Wall\n   Change wall scoring to target areas you hit in\n   Allow player to move within expanded foot circle\n   - rallies to forehands/backhands/either automatically aim within the circle \n   - larger circles reduce autorun\n   Don't allow backspin on bot serves\n   Delay bot serve in Passthrough venue after player reaches red circle\n   Filter assisted/unassisted online players for challenges\n   Don't show unavailable players for challenges\n   Autorun backs up less eagerly\n   Wait for multiplayer starter to commit before joiner can start\n   Add stats after drill, rally, match, and multiplayer modes\n\nVISUALS:\n   Animate cone rings to indicate bot spin\n   Show court outline on startup screen in passthrough venue\n   UI polish\n   Bot animations\n\nFIXES:\n   Fix \"infinite rally\" message to say the bot rarely misses\n   Don't remind players to move with joystick in Passthrough venue\n   Fixed Infinite Rally to allow movement in Passthrough venue\n   Allow early tutorial exit without repeating it\n   Don't toss ball on main menu in one hand mode\n\n1.9.1:\n   Fixed one-controller serves\n   Reset multiplayer stats after practice\n   Restore 90 fps to Quest 3\n\n1.9.2:\n   Fix rally stats when no balls were hit to one side\n   Fix playing specific bot animation", "created_date": 1723637655, "id": "8500688549994122", "version": "1.9.2", "version_code": 188, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6400132813383050", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8500688549994122"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2140152696375565"}]}, "change_log": "It's the end of early access!  Thank you all for helping Court Time Tennis become a Quest Store app.\n\nAll early access players will have a 33% discount ($9.99 from the $14.99 store price) to unlock the full game.  The free demo is now 30 min, the same as try-before-you-buy.  Only the tutorial and tee-ball drills are free outside the demo.\n\nGAMEPLAY:\n   New Break Out minigame\n   - Clear waves of progressively smaller targets on Wall\n   Change wall scoring to target areas you hit in\n   Allow player to move within expanded foot circle\n   - rallies to forehands/backhands/either automatically aim within the circle \n   - larger circles reduce autorun\n   Don't allow backspin on bot serves\n   Delay bot serve in Passthrough venue after player reaches red circle\n   Filter assisted/unassisted online players for challenges\n   Don't show unavailable players for challenges\n   Autorun backs up less eagerly\n   Wait for multiplayer starter to commit before joiner can start\n   Add stats after drill, rally, match, and multiplayer modes\n\nVISUALS:\n   Animate cone rings to indicate bot spin\n   Show court outline on startup screen in passthrough venue\n   UI polish\n   Bot animations\n\nFIXES:\n   Fix \"infinite rally\" message to say the bot rarely misses\n   Don't remind players to move with joystick in Passthrough venue\n   Fixed Infinite Rally to allow movement in Passthrough venue\n   Allow early tutorial exit without repeating it\n   Don't toss ball on main menu in one hand mode\n\n1.9.1:\n   Fixed one-controller serves\n   Reset multiplayer stats after practice\n   Restore 90 fps to Quest 3", "created_date": 1723325480, "id": "8478834922179485", "version": "1.9.1", "version_code": 187, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6400132813383050", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8500688549994122"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2140152696375565"}]}, "change_log": "It's the end of early access!  Thank you all for helping Court Time Tennis become a Quest Store app.\n\nAll early access players will have a 33% discount ($9.99 from the $14.99 store price) to unlock the full game.  The free demo is now 30 min, the same as try-before-you-buy.  Only the tutorial and tee-ball drills are free outside the demo.\n\nGAMEPLAY:\n   New Break Out minigame\n   - Clear waves of progressively smaller targets on Wall\n   Change wall scoring to target areas you hit in\n
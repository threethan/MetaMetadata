_G5ytQQ7kNvwH01urL&_nc_oc=AdrNjKYOsjmgQT2r3_23K8qiU-w-2oJFpimXuoDT_E3KN7yQ_p_E7YOEThEkzkob-Z8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGd6TEBi8Xz9peyEQzRybtrZLIR9Yxg3S41L8WAVP8Rw&oe=6AFDC2CD"}, {"file_name": "Screenshot 2023-05-19 101109.png", "id": "274793724988750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984463_274793728322083_5328320716442941395_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTpW2llcOlQQ7kNvwFvSEeK&_nc_oc=AdrCLxi5of54d02S0GbtnQkcPdsbKMGm4VWcIXV9d8SSO9aDf6KPzzMDIyDUj2AyvGo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXHMROZfj2rhiGh-FNA375_xw_p8MrEaJOhK38CNotbg&oe=6AFDC092"}, {"file_name": "whack.png", "id": "758926865726996", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003258_758926869060329_5633394843554490152_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLp8Rl_FhE4Q7kNvwGkbYma&_nc_oc=AdoEy-0yAV36z3KqY5dg1sIkx23Mft7TGPdKS9Vja58tuFvD5v019wQbvYXlQruPdW4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfww8khy916Gzkikt5RkG-GWh6q1IWbBWFveu-H1HTDw&oe=6AFDC06B"}, {"file_name": "Screenshot 2023-05-19 102801.png", "id": "621544263359065", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031563_621544270025731_8506124459421320805_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcT_SrxS6DEQ7kNvwHQf0x_&_nc_oc=Adonaj2Cp5spSAPu1pmVYaPZClUVhP6BymY2BL68wxUYrc4NsbfTu4dTpMk9t-_keUk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT338rs7-Lc-XsaiBfi0bRigG5r5ZwHKPXiSQzhMoX21Q&oe=6AFDDB04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo_landscape_color.png", "id": "803410901393833", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974585_803410904727166_8483848167643684398_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4ruknd5Q-EQ7kNvwEKUkxW&_nc_oc=AdowbPRPI0NKL40-2FC4yRjDiHhS25hSJERb3MysGpYc19GuK91NFQHm83objWSI2NY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyX3hlH_wJSNlMOlEFp8FzDQ2bTBVcp_tjbxJOiIdDfg&oe=6AFDE0A8"}, "display_name": "Court Time Tennis", "keywords": ["tennis", "pickleball", "sports", "racket", "sim"], "long_description": "Hit with a physics engine that feels more like tennis than any other game.  Move around the entire court while quickly and accurately lining up return shots.  Dominate the bot in drills, rallies, and matches then show your mettle online!\n\nCourt Time Tennis is the passion project of Eric Malafeew, once chief architect of Harmonix, current cofounder of VirZOOM, tennis player since childhood and simulation geek.\n\n* Practice and play online matches around the world using your Meta avatar\n* Move around the whole court and hit with realistic physics that you can tune\n* Play indoors through a virtual portal or passthrough venue in larger spaces\n* Earn stars and climb leaderboards with 20+ game drills, rallies, and minigames\n* Choose between hardcourt, grass, or clay surfaces in park, club, and arena venues\n* When you have the space to swing, attach your Quest controller to a real racket or extender\n* Get ready for matches against the ball bot, and never have to pick up balls again\n* Customize difficulty settings including wind and design your own drills\n\nJoin the Discord https://discord.com/invite/sgZpkJDydF", "short_description": "Hit with a physics engine that feels more like tennis than any other game.  Move around the entire court while quickly and accurately lining up return shots.  Dominate the bot in drills, rallies, and matches then show your mettle online!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://courttimetennis.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ProShot VR", "support_website_url": "https://courttimetennis.com/support", "website_url": "https://courttimetennis.com/", "category": null, "comfort_rating": "
0156_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmWDICMBU9EQ7kNvwHLnex1&_nc_oc=AdoNTMBDD8rfTJpQGTVahV3cy_HN4ePtuuF5FnfulGJPs-NNV_q2qKIx3nEKqVZpP2A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEtJvB25kKxRrdZhXML9HuBuUit0OLsAZIF7HQT5OEFQ&oe=6A771232"}, {"file_name": "7 Knife Fight.png", "id": "2067868900754115", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296057_2067868904087448_8066027180050008455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeV4NoUbgK0Q7kNvwGCm6SH&_nc_oc=Adozc7GN1Si8XQs71HB9bus9-JAPa_Bel3fVOu15MXABFajna8eLb8C0_966pSVKZsU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGd6v5MggjGwuahIgyczwCuVKoDXmRyav_I3xaohGcYJg&oe=6A772227"}, {"file_name": "6 Soldier.png", "id": "2299782423886727", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623551_2299782427220060_3205941845186657283_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ADDA7ncfIkQ7kNvwF3JfA-&_nc_oc=AdrYbNCDh_gPScLmKwi8RBhqVw22pfhdh60aXACh3JCv8c8lN5IQwTtZqJP3FKuO41Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlmwncO1TayJiLk5ASe8aCv7omSGaEuIa4ZXCeiQNtbA&oe=6A771C1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape Final.png", "id": "4391842484395432", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620817_4391842487728765_8551538056465147389_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lt0eR0u7vMQ7kNvwGIeAMq&_nc_oc=Adq1_LzjETuyZiyfQML9BiFHE5w7liNpOfiC8sCiShtUjrhy1l46v39MJkseXYzRdbs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYGiYyDc422iFP7HBnWqLSanEG-X25yuyN5-d05eFpRA&oe=6A770EB7"}, "display_name": "Beyond Sandbox", "keywords": ["Sandbox", "Shooter", "Multiplayer", "Mods", "Physics"], "long_description": "# Welcome to Early Access for Beyond Sandbox!\n\nYour feedback is instrumental in shaping our roadmap. There is so much planned and we're excited to see everything our modding community builds alongside us. This is just the beginning.\n{1447763229573598}Beyond Sandbox is a multiplayer VR modding platform powered by Unreal Engine 5. With advanced physics, detailed VR interactions and the creativity of our modding community, anything is possible.\n\n# Advanced Physics Sandbox\n\nAdvanced physics based interactions in both single-player and multiplayer!\n{768347549207581}\n# Multiplayer\n\nPhysics is more fun with friends.\n{1407491997035136}\n# Modding Platform for Endless Content\n\nBeyond Sandbox was built with mods in mind from day 1. Our Reality SDK enables the most creatively talented modders to build anything they can dream of, giving players never ending content!\n{1272614697555205}\n# Starter Experiences\n\nUsing our Reality SDK, Early Access comes with the following starter experiences: Sandbox, PvP Shooter Modes, Zombie Horde Mode. And there is so much more to explore thanks to our modding community!\n{1092105442787380}\n\nThank you for being a part of our journey from the start. Big things to come!", "short_description": "Beyond Sandbox is a multiplayer VR modding platform powered by Unreal Engine 5. With advanced physics and the creativity of our modding community, anything is possible."}]}, "developer_name": "Atlas XR", "developer_privacy_policy_url": "https://beyondsandbox.com/privacy-policy-beyond-sandbox", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": "https://beyondsandbox.com/contact-beyond-vr", "website_url": "https://beyondsandbox.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null
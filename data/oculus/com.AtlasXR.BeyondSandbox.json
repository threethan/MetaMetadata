439170135905117_7805736223085117244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmltyP-_t_cQ7kNvwFm9z53&_nc_oc=AdrBB1t8iAY9g41gL2HdiL9wDqknO9xa7fuAYaTACHo4CvzEhyww2ae-zVkxbFDS1Mc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0pJJ3jOku4Dxpcjnn_fq6BRzo9XMuPawxFngKylI3rg&oe=6A92BC2D"}, {"file_name": "Frame 19 (1).png", "id": "399801116544768", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982647_399801123211434_3214475771892155485_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0egO9LvKIYQ7kNvwGtv3qk&_nc_oc=Adr0aT3CUyyJmdyn1MwJmxxaUmZ79okdXkWxBe1shn76QBrYdYS2yomgoU9RdfKx5nw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHl4n7fdA6ZVf58komyVSmZppWn_EdB66WQtmx7uWfYvw&oe=6A92C9C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 5.png", "id": "1129080695888294", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/54823267_1129080699221627_5310614923561147564_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfmDCYf1dQAQ7kNvwGS_vk6&_nc_oc=AdoGfI0zXVvcczSGk0Ld9VxRx463hG3AwaETAIf4TzF61j-XMg4PvnylSm2MzKyBz1o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0Z12Oxu9c0c0qUkLf4VqOIEobbugaOVwF173qVy7JPA&oe=6A92D4D8"}, "display_name": "Beyond Sandbox", "keywords": ["FPS", "Sandbox", "Shooter", "Multiplayer", "Mod"], "long_description": "Step into the ultimate VR modding platform, where your creativity knows no bounds!\n\nPlay groundbreaking in-house VR games that push the limits of immersion, or dive into an endless stream of user-created content. Powered by Unreal Engine 5 and the Reality SDK, Beyond Sandbox offers a playground for both players and creators to redefine virtual reality experiences.\n\nDiscover What\u2019s Possible:\n- Next-Level Physics: Interact with the world like never before.\n- Realistic Weapons: Feel the intensity of lifelike firearms and melee combat.\n- Dynamic Multiplayer: Connect, compete, or collaborate in immersive worlds.\n- Procedural Grips: Every hold feels just right.\n- Creator\u2019s Paradise: Modders get powerful tools to build anything imaginable.\n\nPush VR to its limits. Create. Play. Explore. This is Beyond Sandbox.", "short_description": "The Next-Gen VR Modding platform powered by Unreal 5."}]}, "developer_name": "Atlas XR", "developer_privacy_policy_url": "https://beyondsandbox.com/privacy-policy-beyond-sandbox", "developer_terms_of_service_url": null, "publisher_name": "Atlas XR", "support_website_url": "https://beyondsandbox.com/contact-beyond-vr", "website_url": "https://beyondsandbox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "28245776748346597"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "4550597341752932"}, {"status": "PUBLISHED", "id": "1770218587747279"}, {"status": "PUBLISHED", "id": "1519182529799201"}]}, "baseline_offer": {"id": "1519182529799201"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "4550597341752932"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38022402907350550", "version": "Beyond-release-0.14.9"}, "id": "1315924639433560", "channel_name": "LIVE"}]}, "is_for_oculus_keys_onl
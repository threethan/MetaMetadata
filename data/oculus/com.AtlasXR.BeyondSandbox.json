pgzZCn6T6BeMAt6DzYTc9M-tuZgq5FWQ2tXSe6mCdZqqktRoMucYRYIzF4WY9v6w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3R9SlJXsyT9YHQHW1irpJX6niGXvGidTLguIHEOMCsKQ&oe=69F1EAB2"}, {"file_name": "7 Knife Fight.png", "id": "2067868900754115", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296057_2067868904087448_8066027180050008455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFaZIiInleAQ7kNvwF4GIR5&_nc_oc=Adobrx9360M2oZRirCwh6Rhd6jugLDOUToUt3WVxAPUshCVokhxfeoWIIf-qYO2KOwQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2SSE6h5ywvF2gaIgUGQ_66u8EA6RqpC0aHAHztx3lLPA&oe=69F1FAA7"}, {"file_name": "6 Soldier.png", "id": "2299782423886727", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499623551_2299782427220060_3205941845186657283_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvaFH9QgbdUQ7kNvwE06kJh&_nc_oc=Ado8DLEMWk6q3PUOMcDOX3ar7K2e42nmVJ6be5hv3xbiyB2smZN7UBHwceJsB158KNM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2EP4jvNajt8CwUny_DeFj0cuBhieOHpfhDV--L9n5ivQ&oe=69F1F49E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape Final.png", "id": "4391842484395432", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620817_4391842487728765_8551538056465147389_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYLi8mhB1d4Q7kNvwFVs5Jx&_nc_oc=AdrHXbhu8TPqvh5ih9KCMOF_XYa2C08Mg_L5tDgqaYvFDBzekHXFldSGbLltEdc2nBo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2r-dMHnmjc81J1sH0aw3ooKClIoeUDizEyXWch4ph1_Q&oe=69F1E737"}, "display_name": "Beyond Sandbox", "keywords": ["Sandbox", "Shooter", "Multiplayer", "Mods", "Physics"], "long_description": "# Welcome to Early Access for Beyond Sandbox!\n\nYour feedback is instrumental in shaping our roadmap. There is so much planned and we're excited to see everything our modding community builds alongside us. This is just the beginning.\n{1447763229573598}Beyond Sandbox is a multiplayer VR modding platform powered by Unreal Engine 5. With advanced physics, detailed VR interactions and the creativity of our modding community, anything is possible.\n\n# Advanced Physics Sandbox\n\nAdvanced physics based interactions in both single-player and multiplayer!\n{768347549207581}\n# Multiplayer\n\nPhysics is more fun with friends.\n{1407491997035136}\n# Modding Platform for Endless Content\n\nBeyond Sandbox was built with mods in mind from day 1. Our Reality SDK enables the most creatively talented modders to build anything they can dream of, giving players never ending content!\n{1272614697555205}\n# Starter Experiences\n\nUsing our Reality SDK, Early Access comes with the following starter experiences: Sandbox, PvP Shooter Modes, Zombie Horde Mode. And there is so much more to explore thanks to our modding community!\n{1092105442787380}\n\nThank you for being a part of our journey from the start. Big things to come!", "short_description": "Beyond Sandbox is a multiplayer VR modding platform powered by Unreal Engine 5. With advanced physics and the creativity of our modding community, anything is possible."}]}, "developer_name": "Atlas XR", "developer_privacy_policy_url": "https://beyondsandbox.com/privacy-policy-beyond-sandbox", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": "https://beyondsandbox.com/contact-beyond-vr", "website_url": "https://beyondsandbox.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
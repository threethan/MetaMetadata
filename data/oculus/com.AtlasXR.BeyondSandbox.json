0156_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRYFiKhHL_cQ7kNvwE-TqnM&_nc_oc=AdobYVjlTxIVQDiSVhO0wckKFODGpj0Etj7cxaKNdY9WqQYfHpkHr1KEa6wZarPguNk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8f2TsayWpEXKM99UucsEjgKFn7-bbCHnzmBPQj3vt3Q&oe=6A4BC8F2"}, {"file_name": "7 Knife Fight.png", "id": "2067868900754115", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296057_2067868904087448_8066027180050008455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5Jvdit5oCYQ7kNvwF48uWJ&_nc_oc=Adp6Q7URZZAVihwgfH-n3JxSyJRrU5XQ7lV2IWip0R5nmRIGTO8-odeqKu3fiPgq_2w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsfHAIvpsR9UWRO19ASIahZbcIT91iBfCb4YWUI3zyig&oe=6A4BA0A7"}, {"file_name": "6 Soldier.png", "id": "2299782423886727", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623551_2299782427220060_3205941845186657283_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONFJzR16E4IQ7kNvwF479nS&_nc_oc=Adr6CzqXTawbDTZE6D-8rGc2-zp9ivT1du7k28zItliOdYzBK6gBl8U-BiVrS--Alks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASac2sXUdhfAcyZY5np0LwnoxqsnSYRPMKyquPfZRk8Q&oe=6A4BD2DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape Final.png", "id": "4391842484395432", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620817_4391842487728765_8551538056465147389_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSubyWLVvLMQ7kNvwHLbC5F&_nc_oc=AdqlfpK7t-_k543D4kakfRz776eC-VmEKJk8XRjePNqOtvQty4dMZLxbQqBbcyoE7FM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYUTPESzPbHZ4cW-75tTjm3JJcB8bXXlxlXyTOQCZnlw&oe=6A4BC577"}, "display_name": "Beyond Sandbox", "keywords": ["Sandbox", "Shooter", "Multiplayer", "Mods", "Physics"], "long_description": "# Welcome to Early Access for Beyond Sandbox!\n\nYour feedback is instrumental in shaping our roadmap. There is so much planned and we're excited to see everything our modding community builds alongside us. This is just the beginning.\n{1447763229573598}Beyond Sandbox is a multiplayer VR modding platform powered by Unreal Engine 5. With advanced physics, detailed VR interactions and the creativity of our modding community, anything is possible.\n\n# Advanced Physics Sandbox\n\nAdvanced physics based interactions in both single-player and multiplayer!\n{768347549207581}\n# Multiplayer\n\nPhysics is more fun with friends.\n{1407491997035136}\n# Modding Platform for Endless Content\n\nBeyond Sandbox was built with mods in mind from day 1. Our Reality SDK enables the most creatively talented modders to build anything they can dream of, giving players never ending content!\n{1272614697555205}\n# Starter Experiences\n\nUsing our Reality SDK, Early Access comes with the following starter experiences: Sandbox, PvP Shooter Modes, Zombie Horde Mode. And there is so much more to explore thanks to our modding community!\n{1092105442787380}\n\nThank you for being a part of our journey from the start. Big things to come!", "short_description": "Beyond Sandbox is a multiplayer VR modding platform powered by Unreal Engine 5. With advanced physics and the creativity of our modding community, anything is possible."}]}, "developer_name": "Atlas XR", "developer_privacy_policy_url": "https://beyondsandbox.com/privacy-policy-beyond-sandbox", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": "https://beyondsandbox.com/contact-beyond-vr", "website_url": "https://beyondsandbox.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null
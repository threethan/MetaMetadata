117_7805736223085117244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZA-oT6EBewQ7kNvwGJcQse&_nc_oc=AdqqP9ThDi9N8rNNR71_o3e_L2Bj_xb7EAiB6IpGX8Bz_-gOHhX22XZNixgJFyb808g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvT6K0y3agXnRmkgu6ehllUilDkVzsxyNEbPHMTawRZw&oe=6ABE75ED"}, {"file_name": "Frame 19 (1).png", "id": "399801116544768", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982647_399801123211434_3214475771892155485_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3qpdUGR0h8Q7kNvwGpQ6Z5&_nc_oc=AdoEF0spOUM5eFn66EzX8bp21VhZ68wkL89ccBhcOWxnmUwocXP6gxDUNtE68B-iHSs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJo3bzm1oJiySZRPplmUBmhZcB_c3h0ZSi3VwX7vc_4mg&oe=6ABE8386"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 5.png", "id": "1129080695888294", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54823267_1129080699221627_5310614923561147564_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpZu_8mdHSwQ7kNvwG1M091&_nc_oc=AdpLqQmLB_dQHHzcPhve9wfZot2JwT4dxWjdhjCI9u_plVsvYOBBV0x5VDTxQs8akkw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtD6Wf7Wqe3eNjG1LlG0Xpf6FI1NSILu6ZquB2FbfRGQ&oe=6ABE5658"}, "display_name": "Beyond Sandbox", "keywords": ["FPS", "Sandbox", "Shooter", "Multiplayer", "Mod"], "long_description": "Step into the ultimate VR modding platform, where your creativity knows no bounds!\n\nPlay groundbreaking in-house VR games that push the limits of immersion, or dive into an endless stream of user-created content. Powered by Unreal Engine 5 and the Reality SDK, Beyond Sandbox offers a playground for both players and creators to redefine virtual reality experiences.\n\nDiscover What\u2019s Possible:\n- Next-Level Physics: Interact with the world like never before.\n- Realistic Weapons: Feel the intensity of lifelike firearms and melee combat.\n- Dynamic Multiplayer: Connect, compete, or collaborate in immersive worlds.\n- Procedural Grips: Every hold feels just right.\n- Creator\u2019s Paradise: Modders get powerful tools to build anything imaginable.\n\nPush VR to its limits. Create. Play. Explore. This is Beyond Sandbox.", "short_description": "The Next-Gen VR Modding platform powered by Unreal 5."}]}, "developer_name": "Atlas XR", "developer_privacy_policy_url": "https://beyondsandbox.com/privacy-policy-beyond-sandbox", "developer_terms_of_service_url": null, "publisher_name": "Atlas XR", "support_website_url": "https://beyondsandbox.com/contact-beyond-vr", "website_url": "https://beyondsandbox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "28245776748346597"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1217904793885610"}, {"status": "PUBLISHED", "id": "4550597341752932"}, {"status": "PUBLISHED", "id": "1770218587747279"}, {"status": "PUBLISHED", "id": "1519182529799201"}]}, "baseline_offer": {"id": "1519182529799201"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1217904793885610"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39277692961821532", "version": "Beyond-release-0.20.0"}, "id": "1315924639433560", "channel_na
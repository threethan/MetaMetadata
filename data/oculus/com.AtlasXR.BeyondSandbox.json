.5771-25/673716021_1600268715226651_6040162732186369077_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHm2nLg4wL0Q7kNvwH259FM&_nc_oc=AdoKAMljgO3eE0lbTU0Ca2ozucUFL-IwyNKoqPn-h2zgtwX9bj6be8gvHIm4ugMZk2U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeUwQB2tuhcYO383w9ItVjtpEA3g2MgF79HTY08UX5sw&oe=6AE0AA82"}, {"file_name": "1 Multiplayer.png", "id": "1405086604718929", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619450_1405086608052262_2809818139936704137_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBgI4QUs8MkQ7kNvwEaRG5U&_nc_oc=Adq3lERON5qtZW1q_JE7QvvR8Hovq3BOB0RZIoX_aMidY3Mms3rEcAJHJtxC6VB79bs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlGzkDcBH0MD7m5rNEhPBfDKtGhIE2jOUu2n96tbvCmQ&oe=6AE0B040"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BS BB Nightclub Update Landscape Final.png", "id": "1575472033828374", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312263_1575472037161707_323269224799126251_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4fX1uAlwrcQ7kNvwHB8OlE&_nc_oc=AdqLWNHYMCOwdcH8QlMgD5_K5yrxXONgWIg56a51qxroOwXCAQWH5VkKZiVAKhbEW2s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMz7m3jFd1iuTncLT9y6oY4A1pzLnMgq9mDa_F3BK3Umw&oe=6AE0C51F"}, "display_name": "Beyond Sandbox", "keywords": ["Sandbox", "Shooter", "Multiplayer", "Mods", "Physics"], "long_description": "# Beyond Sandbox is Here!\n\nBeyond Sandbox is a multiplayer VR modding platform powered by Unreal Engine 5. With advanced physics, detailed VR interactions and the creativity of our modding community, anything is possible.\n{1447763229573598}\n# Advanced Physics Sandbox\n\nAdvanced physics based interactions in both single-player and multiplayer!\n{768347549207581}\n# Multiplayer\n\nPhysics is more fun with friends.\n{1407491997035136}\n# Modding Platform for Endless Content\n\nBeyond Sandbox was built with mods in mind from day 1. Our Reality SDK enables the most creatively talented modders to build anything they can dream of, giving players never ending content!\n{1272614697555205}\n# Starter Experiences\n\nUsing our Reality SDK, Early Access comes with the following starter experiences: Sandbox, PvP Shooter Modes, Zombie Horde Mode. And there is so much more to explore thanks to our modding community!\n{1092105442787380}\n\nThank you for being a part of our journey from the start. Big things to come!", "short_description": "Beyond Sandbox is a multiplayer VR modding platform powered by Unreal Engine 5. With advanced physics and the creativity of our modding community, anything is possible."}]}, "developer_name": "Atlas XR", "developer_privacy_policy_url": "https://beyondsandbox.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": "https://beyondsandbox.com/contact/", "website_url": "https://beyondsandbox.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "39840053195585503"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312422_1787113283414178_175334277413589983_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QM3fVoAin0QQ7kNvwH4-lWM&_nc_oc=Adoaogo7TUWEDJMsQT--UaKl2HFR5iBZZdde4
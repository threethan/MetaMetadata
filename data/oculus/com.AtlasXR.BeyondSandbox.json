732186369077_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psxvR48QO8kQ7kNvwGjKJWN&_nc_oc=Ado_b04Do6oD4Dq11juAz_xolqU487XHGjI4cVidUhUda_aoqAFvqragVcyhc7Zm6cY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyUZsXVdkRBWB26JDIfQ-1MEPbFfo7csLd2T3A6zZaGQ&oe=6ACE3582"}, {"file_name": "1 Multiplayer.png", "id": "1405086604718929", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619450_1405086608052262_2809818139936704137_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVK6L5fYUr0Q7kNvwH-n3o1&_nc_oc=AdqmvcCaFQdEAoaSW0AOl6r84LbQ_k-6SYjoOBeEXSymOjODWVyjEL8mqo8Lrz_pg9Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGyLkKZQY4Q-WdpMXjUJwHhmhOy4WwEA2geg8Knq_K6g&oe=6ACE3B40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BS BB Update Landscape Final.png", "id": "1964614964512166", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302348_1964614967845499_2095647360434825808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CeOxgBQNXPwQ7kNvwG8asYD&_nc_oc=AdpF4lSicnqOI-mjtfIhlNe4x2BKzMSSFmegGNL1-h9mBfWKvG2lpC2P0YWC72d6hng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcs14CulvH1hQDyWagJmLBGCOwn28CXlGpXM5FPI0Q9Q&oe=6ACE5F32"}, "display_name": "Beyond Sandbox", "keywords": ["Sandbox", "Shooter", "Multiplayer", "Mods", "Physics"], "long_description": "# Beyond Sandbox is Here!\n\nBeyond Sandbox is a multiplayer VR modding platform powered by Unreal Engine 5. With advanced physics, detailed VR interactions and the creativity of our modding community, anything is possible.\n{1447763229573598}\n# Advanced Physics Sandbox\n\nAdvanced physics based interactions in both single-player and multiplayer!\n{768347549207581}\n# Multiplayer\n\nPhysics is more fun with friends.\n{1407491997035136}\n# Modding Platform for Endless Content\n\nBeyond Sandbox was built with mods in mind from day 1. Our Reality SDK enables the most creatively talented modders to build anything they can dream of, giving players never ending content!\n{1272614697555205}\n# Starter Experiences\n\nUsing our Reality SDK, Early Access comes with the following starter experiences: Sandbox, PvP Shooter Modes, Zombie Horde Mode. And there is so much more to explore thanks to our modding community!\n{1092105442787380}\n\nThank you for being a part of our journey from the start. Big things to come!", "short_description": "Beyond Sandbox is a multiplayer VR modding platform powered by Unreal Engine 5. With advanced physics and the creativity of our modding community, anything is possible."}]}, "developer_name": "Atlas XR", "developer_privacy_policy_url": "https://beyondsandbox.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": "https://beyondsandbox.com/contact/", "website_url": "https://beyondsandbox.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "39475495698707923"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830904_1607624147408271_1467102923633975452_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lStkE4HsfKAQ7kNvwGpdW-v&_nc_oc=AdpUBngA2Os5YmmRKTv3ulXvl-j_Zb3sfze8OV6qIApMK4HRl4-HljsYrMLPt2bYNDA&_nc_zt=3&_nc_ht=sc
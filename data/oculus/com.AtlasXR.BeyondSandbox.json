t-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN39t-4fCCEqVhTLxDaiXHFYzpM_SvkZ1kfnleYj_KJGA&oe=6ACBA4ED"}, {"file_name": "Frame 19 (1).png", "id": "399801116544768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982647_399801123211434_3214475771892155485_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPFLBMkKZMcQ7kNvwEKRGL7&_nc_oc=Adrodg6_W4RiUDk8STevw9rdyfGAlomqqlojA1uspyVM143OJmTRaY-62X55xmTmJZw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7OoJrEX5n10jvk0AjPrzDmWcztEtmhMeraBgloVsyvQ&oe=6ACBB286"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 5.png", "id": "1129080695888294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/54823267_1129080699221627_5310614923561147564_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0WN8rhi2MEQ7kNvwH_WYU0&_nc_oc=AdpmpCwiEcZ2m73KIpZy8I1ao36ltZwnjLjhffhrODttko7W_jKngc-8HFqviQX3DKA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN02K-302E0U3JY5xHSOT3oW7pbbFoUZyiYa_nBV0KcXQ&oe=6ACBBD98"}, "display_name": "Beyond Sandbox", "keywords": ["FPS", "Sandbox", "Shooter", "Multiplayer", "Mod"], "long_description": "Step into the ultimate VR modding platform, where your creativity knows no bounds!\n\nPlay groundbreaking in-house VR games that push the limits of immersion, or dive into an endless stream of user-created content. Powered by Unreal Engine 5 and the Reality SDK, Beyond Sandbox offers a playground for both players and creators to redefine virtual reality experiences.\n\nDiscover What\u2019s Possible:\n- Next-Level Physics: Interact with the world like never before.\n- Realistic Weapons: Feel the intensity of lifelike firearms and melee combat.\n- Dynamic Multiplayer: Connect, compete, or collaborate in immersive worlds.\n- Procedural Grips: Every hold feels just right.\n- Creator\u2019s Paradise: Modders get powerful tools to build anything imaginable.\n\nPush VR to its limits. Create. Play. Explore. This is Beyond Sandbox.", "short_descri
0156_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLPryu2pnKwQ7kNvwGKTbYu&_nc_oc=AdovIcTk5DHY6EJKyc7JF-0DExyQREcdkSsbyEy1BlA62Wbm4-xJc3ZEer2Cy4AQHPg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5i06Up3dPbXbk0jxsjU1Sy-ZxZXonxFq9s6RdHPiCHFQ&oe=69FA0BF2"}, {"file_name": "7 Knife Fight.png", "id": "2067868900754115", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296057_2067868904087448_8066027180050008455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vJENo68HTUQ7kNvwH9SSnC&_nc_oc=Adq5OQQygt2xhgQuvxRKdXGPiosHA5-t-KCnwAnJ25wW1nzy6cTtDdQoAv3HCZ2-tTY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69Lwg7LgjxDK8hMEczPvsK9qqfb2rV7kqYzBvlPf__4A&oe=69F9E3A7"}, {"file_name": "6 Soldier.png", "id": "2299782423886727", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499623551_2299782427220060_3205941845186657283_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AR2KwX-TpGgQ7kNvwHcTO3U&_nc_oc=AdpLUIqFFmYP1uosnjsIuf6yLrH-g5jViDB0S1ot9PJKd2txHPEK-EIqhCElkjwCn1k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KXmeV9HKD4OZboMBeWnEso4U88_umgnoC2_DZZ0VFGw&oe=69F9DD9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape Final.png", "id": "4391842484395432", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620817_4391842487728765_8551538056465147389_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tUJirujAiYQ7kNvwFA_R5y&_nc_oc=Adq1zpmmNfzbDeXL1yasWstL357y4IgjOvurwTwuPS1hzsA2lnUiYwb1GFULvZEcKII&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yDX7PeaKmmMjmLRnMPgy4EJPBGjx-poj7GN0dJBdg3A&oe=69FA0877"}, "display_name": "Beyond Sandbox", "keywords": ["Sandbox", "Shooter", "Multiplayer", "Mods", "Physics"], "long_description": "# Welcome to Early Access for Beyond Sandbox!\n\nYour feedback is instrumental in shaping our roadmap. There is so much planned and we're excited to see everything our modding community builds alongside us. This is just the beginning.\n{1447763229573598}Beyond Sandbox is a multiplayer VR modding platform powered by Unreal Engine 5. With advanced physics, detailed VR interactions and the creativity of our modding community, anything is possible.\n\n# Advanced Physics Sandbox\n\nAdvanced physics based interactions in both single-player and multiplayer!\n{768347549207581}\n# Multiplayer\n\nPhysics is more fun with friends.\n{1407491997035136}\n# Modding Platform for Endless Content\n\nBeyond Sandbox was built with mods in mind from day 1. Our Reality SDK enables the most creatively talented modders to build anything they can dream of, giving players never ending content!\n{1272614697555205}\n# Starter Experiences\n\nUsing our Reality SDK, Early Access comes with the following starter experiences: Sandbox, PvP Shooter Modes, Zombie Horde Mode. And there is so much more to explore thanks to our modding community!\n{1092105442787380}\n\nThank you for being a part of our journey from the start. Big things to come!", "short_description": "Beyond Sandbox is a multiplayer VR modding platform powered by Unreal Engine 5. With advanced physics and the creativity of our modding community, anything is possible."}]}, "developer_name": "Atlas XR", "developer_privacy_policy_url": "https://beyondsandbox.com/privacy-policy-beyond-sandbox", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": "https://beyondsandbox.com/contact-beyond-vr", "website_url": "https://beyondsandbox.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null
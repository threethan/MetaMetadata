/t64.5771-25/673716021_1600268715226651_6040162732186369077_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRIPO0o-8AkQ7kNvwHjTwb8&_nc_oc=AdrpVNqlRRho-C1QPCFUfZFErGRiGUcBZEeG9HZaU8JmMpUna4TecNx23GMXxYUK8lo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTj95OBHF9gSJDwgjGFx707UVzTZCZHVc_3nSU8VlFo8A&oe=6AEDD982"}, {"file_name": "1 Multiplayer.png", "id": "1405086604718929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619450_1405086608052262_2809818139936704137_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVFwL85welMQ7kNvwEInxLa&_nc_oc=Adq7nrMkHkQ6O2KD79TKr1x_0MRv5ecHXp9Pp4W4s37jRSZCZDqXfnyCLPS9tA2cF_I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqR23XV_y6J8gZJUaxOS-nkGY2gslZE9xy_QQdGUHh3w&oe=6AEDDF40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BS BB Nightclub Update Landscape Final.png", "id": "1575472033828374", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312263_1575472037161707_323269224799126251_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQfDa11DEOYQ7kNvwHSRdh0&_nc_oc=Adrihuo10qWyb0Q5GjpdDERuzFsg0ISHILBBJUbXyboOGpnucHI2ADg7Elrvu2vC6so&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT58JeUSyys7Wh4woCvJiBPwkKFbO2YzSo93z0-rlKKCA&oe=6AEDF41F"}, "display_name": "Beyond Sandbox", "keywords": ["Sandbox", "Shooter", "Multiplayer", "Mods", "Physics"], "long_description": "# Beyond Sandbox is Here!\n\nBeyond Sandbox is a multiplayer VR modding platform powered by Unreal Engine 5. With advanced physics, detailed VR interactions and the creativity of our modding community, anything is possible.\n{1447763229573598}\n# Advanced Physics Sandbox\n\nAdvanced physics based interactions in both single-player and multiplayer!\n{768347549207581}\n# Multiplayer\n\nPhysics is more fun with friends.\n{1407491997035136}\n# Modding Platform for Endless Content\n\nBeyond Sandbox was built with mods in mind from day 1. Our Reality SDK enables the most creatively talented modders to build anything they can dream of, giving players never ending content!\n{1272614697555205}\n# Starter Experiences\n\nUsing our Reality SDK, Early Access comes with the following starter experiences: Sandbox, PvP Shooter Modes, Zombie Horde Mode. And there is so much more to explore thanks to our modding community!\n{1092105442787380}\n\nThank you for being a part of our journey from the start. Big things to come!", "short_description": "Beyond Sandbox is a multiplayer VR modding platform powered by Unreal Engine 5. With advanced physics and the creativity of our modding community, anything is possible."}]}, "developer_name": "Atlas XR", "developer_privacy_policy_url": "https://beyondsandbox.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": "https://beyondsandbox.com/contact/", "website_url": "https://beyondsandbox.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "39840053195585503"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312422_1787113283414178_175334277413589983_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5H-NRPFInEQ7kNvwHhg9gd&_nc_oc=AdreYbEcwQP0Uf2asnYK6WU5A4R8YHt
67868904087448_8066027180050008455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0jFuRiTP18Q7kNvwHPsgdL&_nc_oc=AdoOWFX2cBiqAI0A3zDTukI-9fV12-ipCewZuZP8tLg9l2HezBf-GeGZxz9X3FqZAIA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2uFcaZSVGIiUHuAlNCrrdNSTrYtRQQSSaEhBULlv_Zw&oe=6AB7BBA7"}, {"file_name": "6 Soldier.png", "id": "2299782423886727", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623551_2299782427220060_3205941845186657283_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBImqsa2n4sQ7kNvwEW6dhE&_nc_oc=AdoEmk5dMCkmtUqCQ0yj1b62F-DLK9xGOciODJsWa41g0yCZ8ykEygWjbZxFl0EGTkU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYefmbFzqMEbAu_njjrqrvXpFEZHI_IbjmVtzWDvUJ5Q&oe=6AB7EDDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BS BB Update Landscape Final.png", "id": "1964614964512166", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499302348_1964614967845499_2095647360434825808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZVutMwllx4Q7kNvwHtEcbs&_nc_oc=AdrufjPJ_4hwT5pyLue-LxY30gOo092sN5_ez_JknMA7GV9bKLVYNZjNQ7Fdg8oW3nY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7XV-2jAKeHmEUAZVW5HEFy8mCTN1Boftn2uukEieOgA&oe=6AB7BD72"}, "display_name": "Beyond Sandbox", "keywords": ["Sandbox", "Shooter", "Multiplayer", "Mods", "Physics"], "long_description": "# Welcome to Early Access for Beyond Sandbox!\n\nYour feedback is instrumental in shaping our roadmap. There is so much planned and we're excited to see everything our modding community builds alongside us. This is just the beginning.\n{1447763229573598}Beyond Sandbox is a multiplayer VR modding platform powered by Unreal Engine 5. With advanced physics, detailed VR interactions and the creativity of our modding community, anything is possible.\n\n# Advanced Physics Sandbox\n\nAdvanced physics based interactions in both single-player and multiplayer!\n{768347549207581}\n# Multiplayer\n\nPhysics is more fun with friends.\n{1407491997035136}\n# Modding Platform for Endless Content\n\nBeyond Sandbox was built with mods in mind from day 1. Our Reality SDK enables the most creatively talented modders to build anything they can dream of, giving players never ending content!\n{1272614697555205}\n# Starter Experiences\n\nUsing our Reality SDK, Early Access comes with the following starter experiences: Sandbox, PvP Shooter Modes, Zombie Horde Mode. And there is so much more to explore thanks to our modding community!\n{1092105442787380}\n\nThank you for being a part of our journey from the start. Big things to come!", "short_description": "Beyond Sandbox is a multiplayer VR modding platform powered by Unreal Engine 5. With advanced physics and the creativity of our modding community, anything is possible."}]}, "developer_name": "Atlas XR", "developer_privacy_policy_url": "https://beyondsandbox.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": "https://beyondsandbox.com/contact/", "website_url": "https://beyondsandbox.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "38611329728457862"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312263
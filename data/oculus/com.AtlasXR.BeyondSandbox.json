t-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWxuxtv6GIteIjYoGOcOizXGk4WT2IB-Ck5kBOWzamWQ&oe=6AC65EED"}, {"file_name": "Frame 19 (1).png", "id": "399801116544768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982647_399801123211434_3214475771892155485_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bvXlmLbMEwQ7kNvwEMrHIl&_nc_oc=AdphcsaqV70Bro59aDF9gU5oBAscNEFACAFFWwNNvwhur2ClyWfUr66WZB2awmfEEgo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvJONJDPwzxTJ89CzXc-P_qHIxF41eA2vWUyEsvKf2bg&oe=6AC66C86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 5.png", "id": "1129080695888294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/54823267_1129080699221627_5310614923561147564_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_JesKakhdgQ7kNvwGuKY7u&_nc_oc=AdqNhUaMWNM37XZizC6ER2ul0k6TFrJb1uzEq-B4asgFMB6bpa6yD5PEOBn24iVifR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPErNPqpJNNYt1IbW-HmLF6AQMSWlYSr0azsZgHkDn63Q&oe=6AC67798"}, "display_name": "Beyond Sandbox", "keywords": ["FPS", "Sandbox", "Shooter", "Multiplayer", "Mod"], "long_description": "Step into the ultimate VR modding platform, where your creativity knows no bounds!\n\nPlay groundbreaking in-house VR games that push the limits of immersion, or dive into an endless stream of user-created content. Powered by Unreal Engine 5 and the Reality SDK, Beyond Sandbox offers a playground for both players and creators to redefine virtual reality experiences.\n\nDiscover What\u2019s Possible:\n- Next-Level Physics: Interact with the world like never before.\n- Realistic Weapons: Feel the intensity of lifelike firearms and melee combat.\n- Dynamic Multiplayer: Connect, compete, or collaborate in immersive worlds.\n- Procedural Grips: Every hold feels just right.\n- Creator\u2019s Paradise: Modders get powerful tools to build anything imaginable.\n\nPush VR to its limits. Create. Play. Explore. This is Beyond Sandbox.", "short_descri
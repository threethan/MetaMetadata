0156_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=st3moYuJ08cQ7kNvwEBDCtc&_nc_oc=AdoY-bRKPH7DiV8hCZHlLjdk4VQXNQz1hOtTYvQuXi1No_3Ph_Rkdy0xtlKbfXTIK6k&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QZJF-NUTLGa5DBZ9Sd5TCGKkd67UL2Lj8CgcR14OarQ&oe=6A1C52F2"}, {"file_name": "7 Knife Fight.png", "id": "2067868900754115", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499296057_2067868904087448_8066027180050008455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouugvswjLH0Q7kNvwFvQW2l&_nc_oc=AdrsRWEPcDiy5qVYxpd878TDc5lMAI6tSBugE9knWoBKI0_7Z3axNZv4WHalpEJwy_A&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4b_wni44Q1epEJCvYHzfN2T7FC478w8i6y9SEI6axyzw&oe=6A1C2AA7"}, {"file_name": "6 Soldier.png", "id": "2299782423886727", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499623551_2299782427220060_3205941845186657283_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExW0VEV_0gIQ7kNvwGg-DLl&_nc_oc=Adolbp9w3pKGkqaV0EsRoj33-MxjxtRKDez-_Fvn8_TB92SO_8Cm9Ng83Mq2K3N6dEk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6E6lR_VND1tCSNz1fkbEAlteceTkUhbSLc0koF4kcOjw&oe=6A1C5CDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape Final.png", "id": "4391842484395432", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499620817_4391842487728765_8551538056465147389_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3HJfy2E9J8Q7kNvwE13tX1&_nc_oc=Adp_vfzTUhfhwnPemDQNderRymCKajcSM25-Kfiv70SfHYaKWt4tuYNJ74yLGnrxRgI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bZOe_ZnL-oZ0OuB2oOS7LrEv5gZTG54OqwYNgUFBPmA&oe=6A1C4F77"}, "display_name": "Beyond Sandbox", "keywords": ["Sandbox", "Shooter", "Multiplayer", "Mods", "Physics"], "long_description": "# Welcome to Early Access for Beyond Sandbox!\n\nYour feedback is instrumental in shaping our roadmap. There is so much planned and we're excited to see everything our modding community builds alongside us. This is just the beginning.\n{1447763229573598}Beyond Sandbox is a multiplayer VR modding platform powered by Unreal Engine 5. With advanced physics, detailed VR interactions and the creativity of our modding community, anything is possible.\n\n# Advanced Physics Sandbox\n\nAdvanced physics based interactions in both single-player and multiplayer!\n{768347549207581}\n# Multiplayer\n\nPhysics is more fun with friends.\n{1407491997035136}\n# Modding Platform for Endless Content\n\nBeyond Sandbox was built with mods in mind from day 1. Our Reality SDK enables the most creatively talented modders to build anything they can dream of, giving players never ending content!\n{1272614697555205}\n# Starter Experiences\n\nUsing our Reality SDK, Early Access comes with the following starter experiences: Sandbox, PvP Shooter Modes, Zombie Horde Mode. And there is so much more to explore thanks to our modding community!\n{1092105442787380}\n\nThank you for being a part of our journey from the start. Big things to come!", "short_description": "Beyond Sandbox is a multiplayer VR modding platform powered by Unreal Engine 5. With advanced physics and the creativity of our modding community, anything is possible."}]}, "developer_name": "Atlas XR", "developer_privacy_policy_url": "https://beyondsandbox.com/privacy-policy-beyond-sandbox", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": "https://beyondsandbox.com/contact-beyond-vr", "website_url": "https://beyondsandbox.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null
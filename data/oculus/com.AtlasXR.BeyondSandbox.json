0156_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKGYlyCt7F4Q7kNvwGBARvz&_nc_oc=Adq3z2YSio9gPsf-8R5WtJPxoMrSqp638Opp-fl3fG8Y4ePBSovh_iEhRKrHEXUlxAk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQl51bL4FaMdUQ5Ak_tD40uioBS5iKDIzxMYpsOCiEqQ&oe=6A5F5732"}, {"file_name": "7 Knife Fight.png", "id": "2067868900754115", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296057_2067868904087448_8066027180050008455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQQaUzDl-3QQ7kNvwGXxOMC&_nc_oc=AdqfNCqv82iD2yphqth_PA_6JLpXvC719OiJlLdCI2mfCKCQLhU80UJCe5YBgj96nDU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGwg6bCKEsxoTRocYx87NsLg9OxqL6DcnIQXdTr1oHlw&oe=6A5F6727"}, {"file_name": "6 Soldier.png", "id": "2299782423886727", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499623551_2299782427220060_3205941845186657283_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2y86zgKlVoQ7kNvwFkJw-u&_nc_oc=AdoZ_cXv765EpfQXbEKBdbhaCw2fexyDwmdlruO-a-z9Dg0ORaUtraWN5zBw4PeUJYY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdhgC1RFKHg11Lkvqiy5DPubNrKVqp_sd4VDKmubHWwQ&oe=6A5F611E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape Final.png", "id": "4391842484395432", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620817_4391842487728765_8551538056465147389_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7skdSS9BjgQ7kNvwGAynyC&_nc_oc=Adp8Lk9y4gG7sbfjFx6Lf4HPPn1quOIM_f0fCFZrU0xJ6bMSka2p8sKlfY0xYun7mKQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA80V7CirYoh3Npd1lOzpzM4H89rmBtWRBsStlm-cr4tA&oe=6A5F8BF7"}, "display_name": "Beyond Sandbox", "keywords": ["Sandbox", "Shooter", "Multiplayer", "Mods", "Physics"], "long_description": "# Welcome to Early Access for Beyond Sandbox!\n\nYour feedback is instrumental in shaping our roadmap. There is so much planned and we're excited to see everything our modding community builds alongside us. This is just the beginning.\n{1447763229573598}Beyond Sandbox is a multiplayer VR modding platform powered by Unreal Engine 5. With advanced physics, detailed VR interactions and the creativity of our modding community, anything is possible.\n\n# Advanced Physics Sandbox\n\nAdvanced physics based interactions in both single-player and multiplayer!\n{768347549207581}\n# Multiplayer\n\nPhysics is more fun with friends.\n{1407491997035136}\n# Modding Platform for Endless Content\n\nBeyond Sandbox was built with mods in mind from day 1. Our Reality SDK enables the most creatively talented modders to build anything they can dream of, giving players never ending content!\n{1272614697555205}\n# Starter Experiences\n\nUsing our Reality SDK, Early Access comes with the following starter experiences: Sandbox, PvP Shooter Modes, Zombie Horde Mode. And there is so much more to explore thanks to our modding community!\n{1092105442787380}\n\nThank you for being a part of our journey from the start. Big things to come!", "short_description": "Beyond Sandbox is a multiplayer VR modding platform powered by Unreal Engine 5. With advanced physics and the creativity of our modding community, anything is possible."}]}, "developer_name": "Atlas XR", "developer_privacy_policy_url": "https://beyondsandbox.com/privacy-policy-beyond-sandbox", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": "https://beyondsandbox.com/contact-beyond-vr", "website_url": "https://beyondsandbox.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null
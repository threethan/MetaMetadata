ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827567_2205027597101606_8481420058041879745_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7hN6ZxpWnMQ7kNvwHzcttw&_nc_oc=AdqSW209rI_T9qg-1ND-kxHXmC9H_sGCUmdd9YH2UrXIXGtmM5p3DEMWL02bwUk-mZM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdEW2pT1nNe4UFc0rYCE6EPOqkDv7Y5X2dPoqHFsOEEw&oe=6AFDC0A8"}, {"file_name": "2-stars.png", "id": "1119684647217699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824665_1119684650551032_5507861826763139824_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IImkcaSREnQQ7kNvwG3ycwM&_nc_oc=AdpdMCBDfPB6SgEcm3jS_BUL3tRCViMnW06esnIuET7EDUQbtY79r71z88MLxb1kZjw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRndPhZ3V8UpRAiEM-jzjDCctMPwRTqTDj0maFtKDchMg&oe=6AFDB634"}, {"file_name": "3-discover.png", "id": "1433276324826302", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827973_1433276331492968_4631088423031544061_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBsV95q3aL0Q7kNvwGouueB&_nc_oc=Adq3czo94BDzTh45Kp9a-omtzo5YU2ID9Zt6HtL7z4HCHC_k222lFpp37wmWq7VSW4Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8ZdHXw_7xdYSDjYHnQ4WYmqt5TyDXUgFdeAGws-Dszg&oe=6AFDE1C5"}, {"file_name": "4-chapel.png", "id": "1062004813508970", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825257_1062004816842303_3824411010204972779_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8hztuYvU4MQ7kNvwGhsdVY&_nc_oc=Adp_ROLOw03DdoomysHGHOcZmDZkvAyqrg_30eH_yrnGtrBO2yMb3WvWcP3nFc4YqjA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-UUaHHkwiBnlgEJ5byA-BFiAFQ1rqxI165sV8-sSbrg&oe=6AFDDB90"}, {"file_name": "5-shore.png", "id": "1829861258189352", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_1829861264856018_6914925978790679138_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_iJmurYQrQQ7kNvwG2NlFk&_nc_oc=AdrxmB6kKgJB25AGQ8JsUEm7aF5oaYoKwVk8rXPs7IBc-Wg_AgWaEE8kwtnKzujYGlI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuump__ng-CSbs59EL9_6KauTp0Ge_TUhmcZCsDSc55g&oe=6AFDB51B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SaintFlix: Christian Films in VR", "keywords": ["christian", "faith", "bible", "movies", "cinema"], "long_description": "Faith-filled films deserve a better screen than a phone. SaintFlix puts them on a cinema screen around you.\n\n**A catalogue worth exploring**\n- Thousands of Christian films, series, documentaries and family movies\n- Spotlight picks, Newest, Series, themes and channels on Home\n- Search and filters across the whole catalogue in Discover\n\n**Watch anywhere you like**\n- A grand old cinema, a candle-lit chapel, a lake at dawn, a night under the stars, or your own room in passthrough\n- Curved or flat screen, from TV size to huge\n- Series play on with Up next, season by season\n\n**Effortless controls**\n- Point at the film for play, skip, episodes and sound; look away and they fade\n- Either hand works: A or X to play and pause, B or Y to bring the screen to where you look\n- Push the stick to move the screen nearer or farther\n\n**Your list, everywhere**\n- Sign in once and My List and your progress follow you between headset, phone and web\n- No account? Your list stays on the headset and comes along when you sign in\n\n**Ask SaintFlix**\n\nDescribe what you want, like \"a true story about forgiveness for family night\", and get picks you can play straight away.\n\nFree, with no ads in the headset. Every film plays from its creator's own official channel, so creators keep the credit.", "short_description": "Thousands of free Christian films and series on a giant screen, in a place you choose: a grand old cinema, a quiet chapel, a lake at dawn, or under the Milky Way. Pick up where you left off on your phone, save to My List, or just describe what you're in the mood for and let SaintFlix find it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sanebits.com/products/saintflix-vr/privacy", "developer_terms_of_service_url": null, "publisher_name": "SaneBits", "support_website_url": null, "website_url": "https://sanebits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1419937926981909"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1120321707386936"}]}, "baseline_offer": {"id": "1120321707386936"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793059200, "status": "PUBLISHED", "id": "1120321707386936"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1419942690314766", "version": "1.0.0"}, "id": "1777457860126943", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1419937923648576", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1419942690314766"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1777457860126943"}]}, "change_log": "SaintFlix VR 1.0.0", "created_date": 1
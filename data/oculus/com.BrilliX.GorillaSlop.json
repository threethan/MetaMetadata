4a41370AIkdFltUqZwdy4CJHMeOGPtfPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqTuTiw5LF5UuvR6NvOMSbeXqJDfnpvX1jT59VY0MQhQ&oe=6B05D9F2"}, {"file_name": "Gorilla Slop_Custom..._11.10.2026_15-14-26.png", "id": "1116769630723333", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821704_1116769634056666_5606307669497869301_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHucaGBMEpcQ7kNvwGOuAWO&_nc_oc=Adquyr3wlcs70lujlwFs6z7ts3XTW72NGCSxq7LEJ5sAajN1YeS19dVeCHdEWkyXtlQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6IWTWYRfkjckBeK9VKsVjSy9Qxl8oaONQZHFAuO9FtQ&oe=6B05C503"}, {"file_name": "Gorilla Slop_Custom..._11.10.2026_15-47-42.png", "id": "2399354513929280", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824307_2399354520595946_4781565150887072798_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHR1_Vxgw3AQ7kNvwFzQy5g&_nc_oc=AdpIGyxkMKXSvo_I05vYLc5jxXkZfeSfO_0m0vaMsREOWN5fFywlioKCUpWDZ1k9DaE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0O25YHLNGyBCgdkjX7ulEipwjIC_ofwJjVwF-km5O7A&oe=6B05C66B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Slop", "keywords": ["gorilla", "slop", "tag"], "long_description": "# Introducing Gorilla Slop!\n\nJump into a sloppy and social multiplayer VR experience packed with fun game modes, extra slop and new friends to meet!\n\n**Slime Tag** \u2013 Run if you can\u2026but you cant hide forever.\n\n**Murder Mystery** \u2013 Figure out who the murderer is\u2026or dont get caught if its you.\n\n**Building Blocks** \u2013 Build whatever you dream of with Blocks!\n\n**Casual Lobbies** \u2013 Relax, hang out  and meet other players.\n\nCustomize your gorilla in the **Gorilla Mall**, explore the world, and play your way.\n\nThere\u2019s something for everyone in **Gorilla Slop**.\n\n**See you in game!**\n", "short_description": "Run, Tag, Kill, and survive the chaos of Gorilla Slop!!\nHave fun in Slime Tag, Murder Mystery or the chill Casual.\n\nExplore different maps like the LaGoon, Forest or the Gorilla Mall where you can buy and check out Cosmetics for your avatar!"}]}, "developer_name": "BrilliX", "developer_privacy_policy_url": "https://brillix.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "BrilliX", "support_website_url": null, "website_url": "https://brillix.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "29200550546203910"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823366_1447663063957777_6838831303774927625_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQKmGPKXSjEQ7kNvwEZ2KxX&_nc_oc=AdrS3W7Bjw6BIUkOSOMZmL8YccdS79O6Zok0M0sRLbvv2LslPaxwmNzy5e58YVuQxtk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFjCoQun0EtndanrckiL7PC-EZlXSubTA4JA7RBcCoBg&oe=6B05ACD8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gorilla Slop", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_nam
185416_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mCwVGUIc00Q7kNvwGdFZpR&_nc_oc=Adq3qSvQQISW8uT8_vbj3-r9hZ5-evsO64qWAFnkDHowFet0MygkX2lcYXhAEmI3iBk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsfCj5XBMtueA3zB4i2-IOadlozZb4_jlkfxHlue8krA&oe=6AF5DAB8"}, {"file_name": "screenshot_5_2560x1440.png", "id": "3098941166979145", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673536876_3098941170312478_3123846310442273901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aaNW_FEfHcQ7kNvwEmUxEr&_nc_oc=AdpuIjFmYVmcQ_m2S8PzcQNL8B39mgckfUGuNjckVjEhCnNth2MqOiCQ_odTaRcMEpU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkcvWSDAVq7Y_rORPOKEanv3R4jfzjb6FgaCwGJn6KWg&oe=6AF5CED2"}, {"file_name": "screenshot_1_2560x1440.png", "id": "1086767854135138", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673531334_1086767857468471_5590079798319104696_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QpKmF0r1CkQ7kNvwGPJXXB&_nc_oc=Adr1A0KIreOSDO7gD3OcuqYcUZYJJlvPA7LwYuUzolg4xbVbHJoBQemtrb76zb9DfHE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR84sswppuFqRAtoZIrftAiwNR-lcb1Io8hOjBNsdDBhQ&oe=6AF5E924"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_2560x1440.png", "id": "1072561905695692", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604360590_1072561909029025_5374586618946814363_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSFMioQ_JyQQ7kNvwG1HMHh&_nc_oc=AdrtN4OfpcsKh-VUIBgbBh-0qD_6zvJZFk-URxvKAIIPLmhUYLHy85mrkb0DlYVC2tk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdH0tx99iV63jSKHpXBadJVuGU1EBEzteO28BhoK4yHg&oe=6AF5CCA9"}, "display_name": "Rollercoaster Builder", "keywords": ["rollercoaster", "coaster", "builder", "themepark", "island"], "long_description": "Rollercoaster Builder is a theme-park builder for Meta Quest. You stand on an empty lawn on a sunny island with palm-lined beaches all round, open the round build wheel with one button and start laying track.\n\nSNAP-TOGETHER TRACK\nTwelve steel pieces: straights, turns, wide turns, S-curves, hills, small hills, bumps, climbing turns and a full loop. Point the laser at an open end and the piece snaps on; press A to set it down or the trigger to turn or flip it. Supports build themselves under raised track and a fanfare plays when the circuit closes.\n\nRIDE WHAT YOU BUILD\nBuy a front car and coaster cars, set them on a straight, walk into a car and pull the trigger. The train runs your whole circuit at real speed over every hill and through every loop. Choose full motion or a level-horizon ride.\n\nA PARK THAT FILLS UP\nLay paths, queues and arches, place a station, food and drink stalls, an info booth and toilets. Guests walk in through the gate, buy tickets, wander your paths and cheer as the coaster flies past.\n\nAN ISLAND TO BUILD ON\nA 120 metre lawn on a tropical island: beaches with umbrellas and loungers, a lifeguard tower, a pier with sailboats and islands on the horizon. Plant palms, trees, flowers and benches from the wheel. Sell anything back, and everything auto-saves.\n\nDeveloped by Citiview Group and published by Citiview Studios.", "short_description": "Build your own roller coaster on a tropical island. Open the round build wheel, buy steel track pieces and snap them together into loops, hills and turns, add cars, a station, paths, stalls and palm trees, watch the guests arrive, then walk into a car and ride the coaster you built."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/rollercoasterbuilder/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/rollercoasterbuilder/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33152
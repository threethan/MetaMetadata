ent-ord5-2.oculuscdn.com/v/t64.5771-25/491831299_1238111038505615_2402255170409351479_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RFCNCTQyWoQ7kNvwH4IcbL&_nc_oc=AdoiqSFntj0I5DE8q8XrxvEOmvJA1x2zINkn_S0BTjtIFqqbyhEXNMlaui0Aq9YKoCo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLz_tKAK0nVRIhHt_HBlkWpdKs_FGqyX8WdB5_j8EegA&oe=6AFDBB98"}, {"file_name": "screenshot_3_2560x1440.png", "id": "1838092587368980", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595129854_1838092590702313_1408655329586185416_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2PEbFfuldIQ7kNvwFBR3Wm&_nc_oc=Adr1dlj5VMD-m8zRSojc5MZOwlQly9jNqPo9OqT5IiEieh4dsVK9aFZ7pDnfSFNbZJQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmiNPpcnLCvNDHXj8vnxD80Y48uHJUf54Od2hGNiD3MQ&oe=6AFDC3B8"}, {"file_name": "screenshot_5_2560x1440.png", "id": "3098941166979145", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673536876_3098941170312478_3123846310442273901_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s05kcUDODzIQ7kNvwGfUWVK&_nc_oc=AdqjTaP-MZiXsH6tZExIvnRHGBo37wVM38UdhvBw_GH8UlsG3N32hSm_ewrJZXECnwU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR06UMaO8aLOAL6oPku-NYCCnz7ddOr_kSF2ynbJvZQWw&oe=6AFDB7D2"}, {"file_name": "screenshot_1_2560x1440.png", "id": "1086767854135138", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673531334_1086767857468471_5590079798319104696_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xc7iNBKQtQQ7kNvwEIIDZx&_nc_oc=AdoxuytmclbGi7f0hxrxKJ-dF9RVyetGFcnUfYf6-btCTzteihq9GyceowpF6oT4UoU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrMMh1SfQ2SceDFXcs2pxGFBuHSu0T7sXafdoRol_9-A&oe=6AFDD224"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_2560x1440.png", "id": "1072561905695692", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604360590_1072561909029025_5374586618946814363_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgPFRAz1JSoQ7kNvwEjKs8U&_nc_oc=AdqGj84GNls4uvI0JvAi5cE6Ptcy0SgDqxCR-bPyM3xEW9mdUqVctOEKDYZanz77xrs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8d6O1fQpt0U4ha97Sf9S-SrFUXExvNZRETBhAyxLB8Q&oe=6AFDB5A9"}, "display_name": "Rollercoaster Builder", "keywords": ["rollercoaster", "coaster", "builder", "themepark", "island"], "long_description": "Rollercoaster Builder is a theme-park builder for Meta Quest. You stand on an empty lawn on a sunny island with palm-lined beaches all round, open the round build wheel with one button and start laying track.\n\nSNAP-TOGETHER TRACK\nTwelve steel pieces: straights, turns, wide turns, S-curves, hills, small hills, bumps, climbing turns and a full loop. Point the laser at an open end and the piece snaps on; press A to set it down or the trigger to turn or flip it. Supports build themselves under raised track and a fanfare plays when the circuit closes.\n\nRIDE WHAT YOU BUILD\nBuy a front car and coaster cars, set them on a straight, walk into a car and pull the trigger. The train runs your whole circuit at real speed over every hill and through every loop. Choose full motion or a level-horizon ride.\n\nA PARK THAT FILLS UP\nLay paths, queues and arches, place a station, food and drink stalls, an info booth and toilets. Guests walk in through the gate, buy tickets, wander your paths and cheer as the coaster flies past.\n\nAN ISLAND TO BUILD ON\nA 120 metre lawn on a tropical island: beaches with umbrellas and loungers, a lifeguard tower, a pier with sailboats and islands on the horizon. Plant palms, trees, flowers and benches from the wheel. Sell anything back, and everything auto-saves.\n\nDeveloped by Citiview Group and published by Citiview Studios.", "short_description": "Build your own roller coaster on a tropical island. Open the round build wheel, buy steel track pieces and snap them together into loops, hills and turns, add cars, a station, paths, stalls and palm trees, watch the guests arrive, then walk into a car and ride the coaster you built."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/rollercoasterbuilder/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/rollercoasterbuilder/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1248353175037322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673531334_1837858674235795_9125062654010343387_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3UoPGo2ApMQ7kNvwFBBdS_&_nc_oc=AdrCxDIseTdcdMOnOXHMqYd4y2GC8vV6MNA7iSur8Rz1HUkEtnb6CcazsWTRYCOLUTU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMIRYLcDmEgkvf7mlNLx6xwpRR-KrfWY7t0BiKhDCMCw&oe=6AFDD826"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rollercoaster Builder", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Sandbox", "id": "1990104051447093
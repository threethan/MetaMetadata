t-iad3-2.oculuscdn.com/v/t64.5771-25/673536876_3098941170312478_3123846310442273901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPvF6My7gVoQ7kNvwGkLdTL&_nc_oc=Adp7DHN3Ho80cZSY-WrWayFXF98fJLT8CffgHw7n_pO1JIVxJJ-AtiEPgJ-pHg7qzpE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWYJvxOz6vbjeOGZu4WVzwPWz9BCTDQDNoRtUyu2OyRA&oe=6AF1DA52"}, {"file_name": "screenshot_1_2560x1440.png", "id": "1086767854135138", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673531334_1086767857468471_5590079798319104696_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYwj-hkIr9gQ7kNvwFBoPVJ&_nc_oc=Adp_3XydH0wNtuh5YcVi0Nxu-zCPnJeshQYn1Dmbk3_0rwS8I2RLqFDqTUDvpqy7mjY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSShDgFTN8TbMeN9q7IjelC6LG9Vhqy0Lu0rh9cNsygDg&oe=6AF1F4A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_2560x1440.png", "id": "1072561905695692", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604360590_1072561909029025_5374586618946814363_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HEH-nVbMboQ7kNvwHWOL5A&_nc_oc=Ado-Dj93knq1MjIBpTC-X6Mdcm-yK-uQ2755q9TEXp_-uy8U0OeaIHA3ZwhcWCQG1-4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6XGihjNJ-9dgAUspkpEZtJvxb1Ych1-dPZAqPHilV-w&oe=6AF1D829"}, "display_name": "Rollercoaster Builder", "keywords": ["rollercoaster", "coaster", "builder", "themepark", "island"], "long_description": "Rollercoaster Builder is a theme-park builder for Meta Quest. You stand on an empty lawn on a sunny island with palm-lined beaches all round, open the round build wheel with one button and start laying track.\n\nSNAP-TOGETHER TRACK\nTwelve steel pieces: straights, turns, wide turns, S-curves, hills, small hills, bumps, climbing turns and a full loop. Point the laser at an open end and the piece snaps on; press A to set it down or the trigger to turn or flip it. Supports build themselves under raised track and a fanfare plays when the circuit closes.\n\nRIDE WHAT YOU BUILD\nBuy a front car and coaster cars, set them on a straight, walk into a car and pull the trigger. The train runs your whole circuit at real speed over every hill and through every loop. Choose full motion or a level-horizon ride.\n\nA PARK THAT FILLS UP\nLay paths, queues and arches, place a station, food and drink stalls, an info booth and toilets. Guests walk in through the gate, buy tickets, wander your paths and cheer as the coaster flies past.\n\nAN ISLAND TO BUILD ON\nA 120 metre lawn on a tropical island: beaches with umbrellas and loungers, a lifeguard tower, a pier with sailboats and islands on the horizon. Plant palms, trees, flowers and benches from the wheel. Sell anything back, and everything auto-saves.\n\nDeveloped by Citiview Group and published by Citiview Studios.", "short_description": "Build your own roller coaster on a tropical island. Open the round build wheel, buy steel track pieces and snap them together into loops, hills and turns, add cars, a station, paths, stalls and palm trees, watch the guests arrive, then walk into a car and ride the coaster you built."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/rollercoasterbuilder/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/rollercoasterbuilder/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
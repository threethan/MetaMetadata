_ss=7f20f&oh=00_Af7YEfPla9sNV5-yinO-05vtPTElJv0oJuNjUkbcliTQlQ&oe=6A11B416"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-01-06 192116.png", "id": "1597835024425573", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982689_1597835031092239_7038290704900200080_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZ9MAjpIciYQ7kNvwEtNzj-&_nc_oc=Adrw0AKhoVELGr-7LTZ9mA8skI2m24KfWUWWpSoSX-34bnWqJ1wqiC2J_d0upseiblY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ybJK6LO21aWoNdCvuHwAXIYfvj_cud9sj16XRrzLW4g&oe=6A11B9FD"}, "display_name": "Prison Tycoon", "keywords": ["comfort", "arcadeidle", "idle", "Casual", "Fun"], "long_description": "Dive into the exciting world of Prison Tycoon, a unique arcade idle game where your strategic skills are the key to running a successful correctional facility. Start with a basic setup and grow it into a fully operational prison empire. Your tasks include cleaning and rehabilitating prisoners, upgrading cells and facilities, and unlocking new areas as you expand.\n\nEvery decision matters\u2014use resources wisely to maintain order and improve efficiency. Unlock upgrades to enhance prisoner rehabilitation programs, keep your guards alert, and ensure your prison runs like a well-oiled machine. The quirky animations and colorful design bring a touch of humor to the serious task of managing a prison.\n\nPrison Tycoon offers an engaging combination of idle mechanics and resource management, ensuring fun and challenging gameplay for players of all levels. With daily tasks, unlockable achievements, and endless ways to customize your facility, the game provides hours of entertainment.\n\nStep up to the challenge and create the most efficient and well-maintained prison in the world. Can you become the ultimate Prison Tycoon? Test your skills now and take control of the chaos!", "short_description": "Step into the world of Prison Tycoon, an immersive arcade idle game where you take control of a bustling correctional facility. Clean, rehabilitate, and upgrade prisoners while managing resources and unlocking new areas. Use your strategy to maintain order, expand your prison, and create a thriving system. With engaging gameplay, quirky animations, and challenging objectives, Prison Tycoon brings management simulation to a whole new level of fun. Are you ready to build the ultimate prison?\n\n"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8739774099461427"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1749622153066981"}, {"status": "PUBLISHED", "id": "3821257801509638"}, {"status": "PUBLISHED", "id": "1343591047220357"}, {"status": "PUBLISHED", "id": "1104652348357470"}, {"status": "PUBLISHED", "id": "699875355710230"}, {"status": "PUBLISHED", "id": "1010927207203623"}, {"status": "PUBLISHED", "id": "2356313354767117"}]}, "baseline_offer": {"id": "1010927207203623"}, "is_approved": true, "firstOffer": {"nodes": [{"start
020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1RM82hj4MQQ7kNvwG2HrDr&_nc_oc=Adr8rqSx-L6aYRyJPf8NLD7tRZ159DnhcSz4gL7MD0f-K5TRYwtMvdH-CEi5y_Bc7qs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3opNSkL-IetFg0svJ9LST2P9VUj4GHYs8eGR86tdP52g&oe=69DCD0C8"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2B6kkYBzhsQ7kNvwFLYQ9O&_nc_oc=AdqVSDZsdtJsA5seVGf1_V5HPFZSrJjP8gCBcu3ECWzMqesVtCvjuD-doKIPk6SoGXY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2myK-jn90G-EQ7CU-__vpgyrUYHZiiNu-Wbvi71-jymA&oe=69DCD16D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCMCtnVIFFgQ7kNvwH_X2jj&_nc_oc=AdqCpCMT4uOiRrtZ3oUyehW8ySVhYmhKlHFEIjoLS7I8aWjkPHWoELIkPCOYUkeOU84&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06dPA27t7_irXRcZjfLSAXmvURJcuU_dE7CSgunHZOAA&oe=69DCF3DA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
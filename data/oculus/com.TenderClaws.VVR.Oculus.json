020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPI5T9o0Wp0Q7kNvwFgLRoL&_nc_oc=AdqlARRto_UX0pAXdDRVx6JdXBWvUcHAkI_ZIgnv_CumHS7R61QY0UIejqcfd_CZySo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dhgk2AfmMo5-ejSkC1vhcBPN_s50d8Ggh0-hU736qgw&oe=6A428C88"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNFDMZsQLzMQ7kNvwE-sm8r&_nc_oc=Adr9YqUG2FcYyhulpjBkLG3JvN0z80QGFiYsi6aOEXofoiUxZWtdTQBwWGmKEjdX-L8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VGNMxOUfaqZgoHaxvDmY77HEFwXHMdxL9nE7k4JsqeQ&oe=6A428D2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9YCyJom9OEQ7kNvwFM4VZB&_nc_oc=AdpiHEgwwJ5HEqDOwXKRRZyKKmIU4OHVhdyiPmMU8MM1dnk-XUV3Nn0Umbxnkzx11f0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZlXS8RXcZ-10KIn9kLVQVOBG4U-R7SX0YZlS1vKQvhQ&oe=6A42775A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylFV2d1IHXgQ7kNvwE-qucy&_nc_oc=AdrYkVYbXY4OiAh5-wOvXkqQMysXAAL4pJpSxHf0-_JHlGKaOLdqRSO6whbDgGXwVQo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2p0UNtSzuLYFTs576rMfa7kAhVxq0Hchrw1oxOm3U8pQ&oe=69EF7E08"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiMGB788kE0Q7kNvwFlzLDR&_nc_oc=AdpkT4j5CkpY9elj4iEfaEIoLVuF69kTeGl7MJ13tnHOZGzNW-Q23Q0oTKOhG9xwtRI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0lCUKggDk_3MtL_ZK5rgV1DdJGSFws13e_GGR6OaY6vA&oe=69EF7EAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLgXoe37lA0Q7kNvwHbx7Xz&_nc_oc=Ado86xdfoe6OsQzHsYx8tCBmIlLe83NsWdhn5v5jYGZRpsxcKajPtcmq5iw4s2N7qNw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3c_M_XeaTe99R7VYhE9XaSOA3pD_pLYMPWX5ol7fcUXg&oe=69EF68DA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ip2uSz_NRsoQ7kNvwG0wbeh&_nc_oc=Adov0OkEUESn7Fqp47qG9vGItGrQHUqF6ZFDAU-vcl29xr_BvPy270rSbkckbjRbcNY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCg_iCzs8zBzeXrKChHGV_WcZPhCbQ46hyItnHyYQJ4Mw&oe=6A4BC708"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkF6ofgWALAQ7kNvwF8WqCI&_nc_oc=AdrDhGwmxr9jVmR0Pc7jD4gzr8vkO-RuizDRdHfREG9UjktNtFiOnbb8sUNef0AitKk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcH5ovnMmHFbVdkoVgM3uMwUtTvlJSwvnewLgaTd0mUA&oe=6A4BC7AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFQ4VOZSNisQ7kNvwFIQfRR&_nc_oc=AdoHfbYFRcYW91YUChQH0hDIyKhiCHHuVv3m-Q2ExMYkfh9kfhRKK-xAUJTK5S1viG8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJUnQpwAePZKuM12wSMptncNKw36Eszsz4jKGRB1F30g&oe=6A4BB1DA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
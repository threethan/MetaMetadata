020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSHng6dULFoQ7kNvwHQ7RUC&_nc_oc=AdpMQ0JjRGoSDQ5pizBbyBeet8H5DqeoVeNZaP7VDsvQaC-eRT8NldHX9pNC4qWV1MY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBf86-aNIvRhcqKPrmjKeBLzKxn5yzVaa9EigboqGVOTA&oe=6A649B48"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCmXlsEXCAYQ7kNvwFihzJ_&_nc_oc=Adq16k5nlpOTeaXmA14wtCmkQKnRkARCpjAOW8HpAAEJwbNmLSHdF_uP_xS0itVVHwY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-he1do_8omrpfOdSNsVuQ9iFwVt7J5PHTchK0Gmjlsg&oe=6A649BED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2SxdLJKcnkQ7kNvwFXPO9I&_nc_oc=Adoa4SY4R46lVfCicmTTOt2lHelfz1_RMca93tTq0LkIzbxFcX21Ivz-n523K4-vLPc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2mALG2-JHwcyGMl2ZKiZ0BK6OWQPi0xYQIk_uO2t6tg&oe=6A64BE5A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
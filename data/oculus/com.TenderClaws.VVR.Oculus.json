020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzgolmTXfpcQ7kNvwEQl9oM&_nc_oc=AdofVpBhxdIktptHEX6JY7jdf1V4dhcMJtOLofdhgrowi3E9-QEVv1UAbxAPryDHQZQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_oTQuL9stj2KtD4XZ6kyMe2ddCAPL35qVMfEUUNjdug&oe=6A3FE988"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3gkFE8xKp4Q7kNvwGxJKly&_nc_oc=Adp0p7OMQdjMkcc8simERVm9yWqEX0yl9sL6QvqYdbAVxoBC_yQHIbGkzj1_SqRNBnk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D86wWSjRchFxh9H8M2dYt1DW8Sm79uOgbr4QhD_hl1g&oe=6A3FEA2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25lxorjA2XoQ7kNvwEptpYX&_nc_oc=Ado-yuJXCQqaYXvapqi6scri0ZDHg28B4cx2mwRoQ11eSyx6s2qPh8gD4LLMJNEXpWM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_V4F8hi4oakuy7m3iWvg1so00jmhJmqWVd9bIb1xmUMg&oe=6A3FD45A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
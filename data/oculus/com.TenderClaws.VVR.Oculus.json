020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXr5ezrME_QQ7kNvwEwCobM&_nc_oc=AdozfUHC5-jQhXBI3w9k9RtPfZLT1woRZa9tpf34JTjZSuSZZmAY6m1hq4wkhdlLGZE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3WQjuUC-aYbwMr1CJ7eYe5kFndrRI7oGpvwni6jX5C3Q&oe=69F61588"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TPA29xfiqoQ7kNvwFTB8_D&_nc_oc=AdpDbeJCecHnP_W3CRtk41aX09AwohAyA1TuAv6MIdVvz3uq-3E2o5O9gopsLKr1sv4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1IfMyCUGQs11J70n0jYiEGXoW9OTJntnoW_nas4NCY-A&oe=69F6162D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydDtnYqrsssQ7kNvwGF3nZt&_nc_oc=AdpRkxtsSDTwg7sx6Dj-UevcFiIHBaxOGGP4b-IQWE3_Acd8jOB6gPFM_lnY0WrOGiI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1x6ZfByOJ9lJMbDY1LToYUxIWaPxSdMlR5YNJffFnJ-Q&oe=69F6005A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
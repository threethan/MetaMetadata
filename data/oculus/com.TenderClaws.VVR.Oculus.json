020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKgni9lPjgAQ7kNvwFNW8Tu&_nc_oc=AdoeZ6v76f7NKJ6pO7r9fU2QbFFlfLZI758wtnE8L825SGiq1oIKQZYoPNyjhBOufiw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vACOVcPpanrDqfNzirfSpXUspNZfUGi8Vg0TweMj3bQ&oe=6A1C5108"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbPzA3iwMGgQ7kNvwHOH1zi&_nc_oc=AdqXHoa6wDidjWujpq1fMFJw7myJgh-yg5X4P7QDK3Fn4GgktWS31JaCthYiAMpqL0A&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uEA6URcUUmf24toS0UAyknQFe1CBahYVc-DUxoU8QJQ&oe=6A1C51AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-FgWOBOcLQQ7kNvwG1GWJP&_nc_oc=AdpKEGgVRB9TNlHw7YyCVbqv7cJ1u5cYkKQEdvNIzYxUMksYn5SiaJn2cwLURZ2p9Fc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uT2uf3DtTHNldXDFW2UVDH6lxv0DbDBvx7OqLkbwgDA&oe=6A1C3BDA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
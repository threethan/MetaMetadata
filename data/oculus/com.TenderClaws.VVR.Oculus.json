020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdiNncytNcoQ7kNvwFWB2np&_nc_oc=AdroDc5QF-CyvKV0ll6Us6phv_2eubmZfYqDXFf12oyKXoU8OUIkVTp81jy0Z421aR0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROpf7VGJ8H_fgj3h5xHV0cIFkstIwY0Kp6BB51xKrcMA&oe=6AEB4C88"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpdErNVayJMQ7kNvwGDVUD9&_nc_oc=Adp-ZU40eYr8aSjsXg5EI5GwBDEdtkgUOsejhjSUlka-9HFWacBYe07-NRPxRbeTMuc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1e9fnwN9hi7XC4MOca7fjnopb38kb2w0CPNtZq9OyrA&oe=6AEB4D2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4Y_DBgZIooQ7kNvwGBsO9j&_nc_oc=Adr_FbVw5u4XMt-skRcp7DRj1DSWZH064aiNzs83m4AI20JM3Ru5at5gjosw0kHy30E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMTq6CdNivpiNxxGevefYaNrLx9SiPaIuikeitarL15g&oe=6AEB375A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1RM82hj4MQQ7kNvwG_RSMl&_nc_oc=Adr8BktLwEjKOTHICpO7v79KQTI7kiHbW-Lnj4EQhek31wwYPY4dNq1ZAcFIE54fSUg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1J43yqit7zXLbCeWwAWiB2q1a7RJWEbIF-S-HPj9C9cQ&oe=69DB7F48"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2B6kkYBzhsQ7kNvwH7K6Y8&_nc_oc=AdphbrQyHOK2BB_JJrP-DS-ZyoUuz7urruWnU7Gr40WJ8uTYo2_i-gqjVB0IdYAylsg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BjxPiKCv9SZMH_pMepWKoWbE_9HpIQFfaI-dymHEQPg&oe=69DB7FED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCMCtnVIFFgQ7kNvwHfUhwa&_nc_oc=AdpQXN5rZcNlmOXK0h78PivoDP2X5tizw0HMMewR4ZlF4RAyDx-Bnl_irb1x9-gYYN0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37LgbRZ3L1VbGjVm3IKdqUYdUYwoIpqk4fM-aE0iVkyQ&oe=69DBA25A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
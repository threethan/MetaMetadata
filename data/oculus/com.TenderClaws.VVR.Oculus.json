020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7PYKtzc-7kQ7kNvwGYV57r&_nc_oc=AdoAIkS3ktTIGAuboCkUV-2UStixORdhuZTqYgG-KV6DR_DbQYLLNvpAQ98v9UsPLG4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9z-GJsHytokUGAgIh-lWOn74UNUwP7nTH6RxNA0O6EA&oe=6AE0C088"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyQ1rC-ytO4Q7kNvwFltK_0&_nc_oc=AdqwSii4iCXneQjxIFRB3dwNc4uHZlACvBs_64dH8LyKwWSinpI3XSUnuB9a-Dxkq5E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjjIRsulm2nCl365P1qlgFgUcm-g6wQ1KyzXt5-dqShg&oe=6AE0C12D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QWOwwjfodQQ7kNvwEXMnBU&_nc_oc=AdrEG_mqnJUXpCQ8hrgjRCCOVSWGS-1obKP8q19qKblBZIa2xcMqtyU5raIfhBX6qkM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSHBK03lJfUC7F8gP7f8eJFVR8IIvE4rgbvTb6MBa0Ig&oe=6AE0AB5A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
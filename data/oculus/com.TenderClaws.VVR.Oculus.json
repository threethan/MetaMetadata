020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UjSjN2EeRwQ7kNvwF8inkl&_nc_oc=AdqR8r2cQBgIKL8Om3QxOtNE5BNwLDU_o4bmBwkc8cEbUY0MYpr2V2ojkdsex-6sMtM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXVz9hG19txh5Vab0CAlPGuLijkjlH6ulK6g30CuGezw&oe=6AF72A08"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLo9TrM6NRoQ7kNvwGFHxUx&_nc_oc=AdqdNGH44KQ629cKUaAx-riT9ZKWj4McUfByYO8aut3izlpbNnps8Bo-7Lz8Bbcb1J8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRldzqSfdAKxZSbuwP0AiC9aB3nSRRjbAeBloYiLs1VQg&oe=6AF72AAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MATjWJdaJkQ7kNvwGwBFyq&_nc_oc=AdqXoiKuofOk-kehNU-2MO9HlCn_5pszoYk1CE4x3-qiitvsqhzeY4MXgFSqfL8NG0A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWyrhx-dsQpu_Ni-BOLtBJKRDg9Baxcnu8FEUkvOG_tw&oe=6AF714DA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIPcg0p8TY8Q7kNvwHEPAsX&_nc_oc=Adr1v9Amf6PxFFmAfD_tbuZrWIyf9X4WEpseWpN76dVchjQ62Gky0sjmgREb4Aew6Ds&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbQD7ybR_APA2HQ9D4NwfHhyLlmrC7vVrR8sGKDp1bkg&oe=6A9C3288"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8CS_q8e908Q7kNvwHm1chG&_nc_oc=AdrY9z3k62IiirM98M3t-p646ck4YmvqT2lYaq2a4Hvj8th8B14vxkcfIGYDq99Xhtk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEfrPjWvjd-bq3FYiada1OHJVtFHvwCX6M89vHfgCrGg&oe=6A9C332D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRUDCsvU-ekQ7kNvwHAJhdr&_nc_oc=Adq6sO3nbLj9ZYzzKngb3DVF6kktYQQyBnp8Gd2CvmweFSUt_ppiOdECriTDPLVgMZw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-wukypxeeXBmVDAt9Kq8JdbGAdyZysazmGTGynpvp_A&oe=6A9C1D5A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GssKpQihltsQ7kNvwGNOJTN&_nc_oc=AdpDDKRldboV_IZwuVpdG_-CipcdqRwMknZ4Smm-bmTC2Xj8NETcWLSGAyPls7BWOfM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzYJ6eEo4MfHUc955HShxgzSLSdbwa19aPc2ZqlGw7lg&oe=6AA2CA08"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlVXu8vLsZ0Q7kNvwGpEhhy&_nc_oc=Adq0dy0H6lD31kUDxuVoNN23ru6Z2hfe1K8o7ZctQpWQ7h-Yq6E8r53nTswq72fBLMQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkQAdquipoc85l1CYHtVwrRxsKk4GQ0_oT2LcZzk3igQ&oe=6AA2CAAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9lTTYx-tCgQ7kNvwEDuP-M&_nc_oc=AdprYLq3rcMqyQLLi4CUdLIowGgzzmNPdDcFTjGbF7mFdgkyFsV0pFDwTY_UvoOdfaw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLw_IvoRTUMvaE4I7KpE5G8G9OtEVTkKERo-idnYBpFAA&oe=6AA2B4DA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
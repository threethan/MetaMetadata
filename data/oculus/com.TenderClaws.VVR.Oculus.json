020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uT8BkZJfNgUQ7kNvwFp43dE&_nc_oc=AdoJHyn3qZEJzB9MJ1aBraGi33IWoPEszQjXy8k7nv4nNLydBbPcmTFeBCqoShAF2bE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyNUJYkweDTeEcGMOBYYkjyqlwl0pZHSckPbLVLuIyTbw&oe=69C90A48"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1w1GToiHjgQ7kNvwGy0zRF&_nc_oc=Adpi29-MYJM33O0YHbXGa_bCQsfMiCGfjq-5ZUSByziRXbiof-aunVtkXe_tUDfu5p8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQPHLMepQ4e6FFUU73D2SID4lGfk2D6TMsggJB-tKiwg&oe=69C90AED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KCgiUMwrCoQ7kNvwFd1bIW&_nc_oc=AdpEuck7wzMIdRTHA6FxYRQvT7qPHD33WzRaHhqGjDAUs7_VZjp_opi9o5KR1UXCTi4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4g8Jpxv6nrqgMqBWSagJ3xv1v4o0TSwZD4Xdm2l-Cwg&oe=69C92D5A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
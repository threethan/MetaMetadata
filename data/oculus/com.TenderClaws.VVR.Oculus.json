020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbWOmllTYl4Q7kNvwFdGhgL&_nc_oc=Ado6NICTqVp4PS8KFsjOl0e7i8Wr_jXNjOVCqbDs85G2DfJUaxHFiIOhA6q_M46JGa0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eyLJJRWSzfUnz0ohJgg9fxKKUwhxjoyHUaALTxl9gWg&oe=69FA0A08"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=errUEtBWo4YQ7kNvwFdoxu1&_nc_oc=Adorq9ab7TjdIP5AXFbTVVs38i3JnquMarnF6t_soPIV8_RvbIG4ylvrTB-mN8Hz6uU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-l7v-nR4BeUVCt7WbrFSaP8JYD--9J0n-dnEZk5KSpA&oe=69FA0AAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hp1WFZnMGwQ7kNvwGR--wY&_nc_oc=AdrxpfE7AxpHa5e42fT1sFLa3ARaltqmyFBcAzGCcV-qLbm0O88bQ698-q55-PycovA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oIsVnukIyJENjQEQztCCy4zrRPM-jEv0Hjs-jo3h2bQ&oe=69F9F4DA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
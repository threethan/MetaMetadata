020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFg8f_MRf7sQ7kNvwHp1BLU&_nc_oc=Adr8sw4PzdieDN_LY7jZeXRMAznHNgKAKft9QbVT-yUqkcKbxw4VUlKehzDCqwbIdkU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nb6kK4hdlcH1hvD3kuUieMqmAkRuDV-pMshxPbkO8SQ&oe=6A146808"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mB0_I_cyQ7UQ7kNvwGrnJg8&_nc_oc=AdrAMgheVNyO6QWLCQcVBkR5yHXpIGHjJ824UmdQErQT9RopWZfgiCiMiLExOldb4sU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rx56hrCp7RX7JspyT9nab5DL8g_pIPWDCS5wP5oVwiA&oe=6A1468AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ckzya_GCGHAQ7kNvwHTWjgW&_nc_oc=AdoE1GuQEPWg9-RSyNsyafn9Etc0dPId2fNUpKVtghhxmLknK8cYKHlsLqgpUZURDvU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oU_8DNPedDOL1RyZjNY9ZfNclWND1GCli04fwsPCing&oe=6A1452DA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
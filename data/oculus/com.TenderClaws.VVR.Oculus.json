020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=My98JCgo-BQQ7kNvwFsiwA9&_nc_oc=AdqBegza5vx9LziVKbekZpsMsN87KjBvcPFIHPnzeTTfzXBZKQJrSD62Ymgrvm6VsWA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXzQaGy8PctxQGgahgVkH9XzRHGVf1lNCk9pedwQSZkQ&oe=6A819C48"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNrHdoqz0cYQ7kNvwHEpdBv&_nc_oc=AdpN38N_SO2kznH8GJTH_w8Vi907BoEpgEWA1jkTgBonUUdYdkWWI6mE-GA0Vql03oA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_IOnQKcjaX0PJf6Quhbb5p1QR1GC7FpQFM2Zf-2enVg&oe=6A819CED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdKH18tgIlkQ7kNvwFQmP6y&_nc_oc=Ado-aEvxY3bLo-E7dHTzFosygozc-fqaUPwc9A6YzpwYC8Tc4L5qf1xhqRt8JLgur0k&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGB8AHiH-lqDEiiBAD24ZGQRhBRrbDC-tNP5hcscC5IEA&oe=6A81BF5A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
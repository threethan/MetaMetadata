020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFksQqldN7oQ7kNvwFNqc2K&_nc_oc=AdqD6gLVuSASUWDFg22NjdQTauz2f1tf39BASsD1rTfXt9_vGr1APi7vLsmeRMFrNzE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0R48kPX4Xh780hiqyH0VQTRMyv1wQAJj-KjEs0X-gUQ&oe=6AEF4108"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zKRv2ZR1I8Q7kNvwF1URTv&_nc_oc=AdqdT7EdV1GQLQlbG4QJqtJ2FAcINbMjwNmFvQefnx2WemFs-2lI1mc_IpgQv4Rcxc4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl6In3JxmrPB82ZfwXY2Af9kRV1G4dhfRXD4bMCtVipA&oe=6AEF41AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ooWYdqmnXoUQ7kNvwG_VJ9L&_nc_oc=AdoNiuc1pwjX-MTNvKsdC-kcyN0JifofDm9iT9ep1AVLJxdiYba1121nBBXSUqUKAf0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTd95iY8beFhxWtWJwWs-ui3GEWiCo1iBQDk_ici-tP0g&oe=6AEF641A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
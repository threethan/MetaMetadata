020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkGthJdo7_oQ7kNvwEH1gOP&_nc_oc=AdreMe7I1VyXjP3WyjQWXx5RhSVkc5QMwQOTC2UPFhN1U7xE82cIvQwmLzcWBpeXO5E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7BWKpeu9xtUczV0T5Om5qWEhtQRd96Ip_6Omd5DIDow&oe=6A79B348"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-Im_DGHetkQ7kNvwE9Jxr3&_nc_oc=AdohoofoabiTXY-mxcuUZk8vw6YLe1Vih3wANU_dapZSEF1CANjD-WHyeIlI7xm9AuQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSoykP7lsLYYja1xSKDUi70HhINmB33qYw7pRtPAbn_w&oe=6A79B3ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25QrqWF8-VsQ7kNvwED57OQ&_nc_oc=AdobedEAcYSaQ8Ldevpyv2blGE0kHBwuY9YAEZTfiDQEHmxaJ2eimr3pHMRuIbUwKsc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhQjpMdyCq99A-WUxWkhWDN9mV37QvOD9M8FrfYNstqA&oe=6A79D65A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HoiQ1o3HFQQ7kNvwGlYo9-&_nc_oc=AdrViXe0U4QspngJXpyqXWUlx_XKL5REswKW2-2gXNSW8Ujm4uYr9XZpSeslD44CI0A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtSCFnKfj86G0mv3alLRaoJ0aVWa9QRuI7ExvTppKmKw&oe=6A771048"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8snChuFjN6sQ7kNvwH_oR0V&_nc_oc=AdrTHvkrkJgOVBpXZdzuepUZdYmCL6GkVQuf5UQZhByPhZeeP7idK-cmNto4fNhGBr4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6-m9xANSw6VCrishm9KvR6UQOBjGnjNlr3x5jZC0KYg&oe=6A7710ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwDQkQLPC4AQ7kNvwGSK2MY&_nc_oc=AdqObk_FObbB-CPYrmh4CUwc618KqKB7Cwus7FH48fmcx7NDK8l1Ngx7dfOIZP4W1sE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2BVsXicp0OIkAHjD7p2lLn6GmnEEZ3T7NTnjk-n838w&oe=6A77335A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
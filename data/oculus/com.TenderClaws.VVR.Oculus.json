020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-5b-vlNb5sQ7kNvwEtAG9i&_nc_oc=Adp2kzYIIORxqhbbCN0flghrO6IE0Usj21f70tjSEIET3emk6com7V6LsDKf_GfIY44&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sErVBzxWP6V758rJEzZreURBgsgVE4OBUqSOfBxCjaw&oe=6A282E88"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQIbhVFrNY8Q7kNvwG5Maeg&_nc_oc=AdrUVSN0_X9vl_LuJuILgOe0u4fROfXAJnVGjKnogGvwoCI_AcEvp3x27fZ-rDGp8pA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nkbkeFShX_8q945r7ia8GXTL7TL8JM7Qh4qVjX0RDTQ&oe=6A282F2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9EOuNknHWYQ7kNvwFp7EpD&_nc_oc=Ado2nJtjdp2HmF-LtLquSg3_a2obPOL-mulftROuvP6HutI4k872PjatOh4g0E2UZsM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8K_GBYVA3KesypGRqLJnsKZB0M7ammfKlnfsgN2A69A&oe=6A28195A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
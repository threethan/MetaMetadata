020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aorn2wUB9-MQ7kNvwEVn3n1&_nc_oc=AdqZEvGw2ebTk0MxCL00FeOyvBRBYs5ZZ47HW4wHSPC595vTRbF7Xa4sRaYYpmEyu5I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1w3qSvGDAluM8vWngBbos1BOk0EJN12BhST6h0Zdf_w&oe=6A901CC8"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFKve7l-3fMQ7kNvwH3mIWL&_nc_oc=AdoHYGCVLxiKT6RTL0h7kxONVg3VZV1pMZAg6ta5F5JHwwSJw4KU5jDu-PWJbQzWp2E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUpMTy1Friv248hF5Kl4EncQ5I3-x0_X3-JfHGRcW0zQ&oe=6A901D6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZj8NEBA6b0Q7kNvwExe3Md&_nc_oc=Adrp6vUZbe_v4bIXz1jmLXraqz-lkdjYg0ZrNDd0lzrfKYWc8VIJEyirl-3UOq6R9Ss&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdp3Rcvv8_4wPEVz0PrmVWSmjw3E0aZNDSJrgthxeLOg&oe=6A90079A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
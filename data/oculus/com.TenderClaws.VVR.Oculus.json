020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Ql24eCWz5MQ7kNvwGB6nZK&_nc_oc=Adql1yF3VYI6HIrUkmC8uIJT5JNHtUtrm-YShKMqjrveF8WCOzJyWO1hgSdpmYeukiw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOt3-gdfM9GkLBf5a5fwacDhN6M2dy8BkwaVJUV1Xuyqg&oe=6ADF6F08"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyQ1rC-ytO4Q7kNvwHBXJMC&_nc_oc=AdoHr6BebKGn64-ymZ_OrIqdmDB2WldG4v4U-GGgIKH7fIK2IidOcogcY6JNFmd7DNo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7CbWP1MGRFme-0cV8cFd9fwDJ5JXa1etim-1CNj2RbA&oe=6ADF6FAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QWOwwjfodQQ7kNvwEccHGl&_nc_oc=AdpTuLdFwJYm0NA19ilsLjp9EW_dMm_Hh7XHJ7SZiao1iwn9yfg0Qo2BNoJ6rGI7F3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9novtlKPt0qY4-Z9wGZQmBaug6U3Wd98xiyB6B0PQiQ&oe=6ADF59DA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uY22JXkXYQ4Q7kNvwEwlaIk&_nc_oc=AdrIe8DYW7qE07Oiaq0biTOSp0ZLqelZnOiQQVqV-WjkZHhAdQFJEZEkwk1HeZKlQ44&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ma4gvBQi9LyR7ING10CPnkX3E2nEsLG1nUOoHisbLEg&oe=69E0FD88"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5i3Nw8eqPcQ7kNvwFpL5hC&_nc_oc=AdqZAaUJjNAh3GKfWIwjtDf8xMxslFRbp_GCuUojrPEK_O-AKChZdS-vU86OxwDKJds&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sygYh0fzDi2klG3WoGgI1ufRzQ_5GN6x0f5CW0xQoqQ&oe=69E0FE2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CY3-kq4TMYQ7kNvwEa5GF2&_nc_oc=AdozMLmQcFJS5D4NEfmqZgMjaI3-8hatusNe9Eo06CAjxiJTU0JG4nbICuVcHE3NrxI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06t0AnOibYt6eY7jbPsyZfHvBLtfP9iReflUsDmSK6HA&oe=69E0E85A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
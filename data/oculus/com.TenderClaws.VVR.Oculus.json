020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ip2uSz_NRsoQ7kNvwEArUZ6&_nc_oc=AdoPyFzLWpOdC85z3MnlSfEXRtXLJD5KG5HralheoViZBKo0grFZFtcjJXnI0nI3zsI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB79oNPXflnp917iQKR03vPzWVKafaTa-8UYfNwvvvZaw&oe=6A4D1888"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfFqlLKzjRgQ7kNvwHSVo8p&_nc_oc=Adpm3bc19OX1PH_uux_WUAWfM-c1g03_Wx97cwIHuT7bFlcf09x1SzcDZS0e01223UY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFajH1CN1c6dLLITSfxs4BAr4zep73EJT-YnlmFJpelw&oe=6A4D192D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUbmQlef7tIQ7kNvwHm0GU5&_nc_oc=Adp2-_alrdrjmOh2drkLNBC4v6-YbtUcgcFRlpFfkZ-kYQvk6wez1szUI8fZKe9O8ok&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwsuCLLSwENAuWo6TIiAXCNf-SjF6zocXIRstLFYR1tg&oe=6A4D035A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
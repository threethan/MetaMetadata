020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOssq2GyfQoQ7kNvwG8vOz4&_nc_oc=Adrx-IYpt3-yVPqPMKNWHAgQPLMSazZWszbBIfpyLB3e5Jsk_T7kE-mRzGjjux8dKKI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bW-c4ZHc6YdDlIGFWDE3hyh2MIpT1tVgiNR5GRRARIA&oe=6A316908"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4oz8b1RvEAQ7kNvwHYF4jV&_nc_oc=Ado7aprJ-eZHPwav1IUfp7u9K5pUWimajzFvuXiuThTpNK7b52IkPE7RMrSznkQGSxI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IVqZ5Ifaal97_zUX4D8pcTs_cPkDBFpjBHRBqDJo8mA&oe=6A3169AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dT9Xf7iJshoQ7kNvwEyBjQr&_nc_oc=AdqyZrN79rBCv2O0tl2hVnjg4fuQ-PpVo1_DUkc3GQKerOrxl5PeJM14ahX4lfuRvm4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GXWTvpafw_YZ5gn2ehHxw5DYwDht4ZbOrlZiUoGHmcA&oe=6A3153DA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
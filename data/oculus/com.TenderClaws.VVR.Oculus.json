020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnRiXvEtOFEQ7kNvwFbPPEB&_nc_oc=AdqMw9blxEeXo6DFWs48P6SkqM2GkScpZIt2pSE9l7Cwq3pXK3wag3VGbxXP9YZdTcg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3kEeLofYrRGWO40SRdC1_PZH6f89PeNO_b3szG3ue5w&oe=6AC51108"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqnVYlBwQTUQ7kNvwGAD7hb&_nc_oc=AdotJ54FpmwhToqLtPG05eIRGF2mpmrcdMY2wIg4jTSBtM8Qz3fozhUflX2yLtUJ75o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7kgJYOyYqzn52TYiZOT3kpVbpPB9MJRkGomA_10DvrA&oe=6AC511AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j55q4dbXTFoQ7kNvwFjzBpD&_nc_oc=Adr8Db-0SjzKabrfOBOtD5_jaY54bTn4HfXGjfZhhOSvjsFcgxEELdKEI3OJYlgTWxU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNG8QHHrEPswabEDIJl-FBV4mAmH-UZ9QqBs4y0ijgzpg&oe=6AC4FBDA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
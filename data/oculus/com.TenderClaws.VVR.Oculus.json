020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTIg2MXaca4Q7kNvwHm7Qwe&_nc_oc=AdoaKMh_59xKr3CJEVxVqHeANHkl0kFSQgNpaBcAK-XTCvFwII8Y4IAouBT9SAf_4ew&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMgm07kRrAQVypmtARrKJOu-vGvjL0x8SZ5bPaRWrksQ&oe=6AC11C88"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxA1pWur-CUQ7kNvwGyV_w2&_nc_oc=AdqZ0-OiYUV6vyH8mb9fdhy2TBD_9ATipih_E9A6KAF9NuKumBCIS0yypC-WxWTvo4c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbfaAaiCxWfVXGGkMbdxVwwLpaqe-PFAbyYH-SltFlDw&oe=6AC11D2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QL5iks-38PsQ7kNvwGH9Nk5&_nc_oc=Adocgr5muvFQgHn7GmjM2J46GXqh0aIS_PtnM57LK-qulIT3IZAh7KiOVia6YbgXJhs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvYiTJ4Pc-plSYWQSbFJT7WWR-W5TPGxlTg87ateMn6g&oe=6AC1075A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
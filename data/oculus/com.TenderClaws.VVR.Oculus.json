020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gyTzHvHkkgQ7kNvwGIi0CR&_nc_oc=AdoQu6FBZ4Yb6djbd7eG3dKe1SVgGSJiA1hWy1Ngm8bfAYUPHMbDvrM8hqMrBSrxiYM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yfxcOE1JJdlu8wEIQxlFUYxgdHihdgBQo2-HmQyismw&oe=6A2C2308"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HceZWS5nATcQ7kNvwFLXrLF&_nc_oc=Adp0fMDOjUUy1QuFnFemtxwibeafaCX7qO1yh8XVvgaa3J5Gp3EWWKT9oMQqF0U2E4Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-fW86gK1Xi0mRrMwVyV25QiGk5ZHS9M05-5-_kN7SSg&oe=6A2C23AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKyml6sN3mAQ7kNvwH6RFlU&_nc_oc=Adp5Om1_rYUABtbBfUHV4KAiV3mqsSelxaSfO2JT9Egibo0YVwg9XqFKfS8qnPK2wBk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cFoaCqlgwjeJMf7DRElfxVxCyXT6xZhvqNc5iNC6kSQ&oe=6A2C0DDA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
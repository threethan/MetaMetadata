020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIA7cm9rGL4Q7kNvwF7iLgQ&_nc_oc=AdrHFoUvhv7m8ivBZlKulMibqp2LKvRijNo_B1jomAFaQWh3I8VSfBKtvDLqEKnHAGc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Nbbj_m_dxxk0S9ljkYybDeofqI78yZlliPGxBv8leJw&oe=6A32BA88"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4oz8b1RvEAQ7kNvwGxWQcd&_nc_oc=Adq07gJcdRl_LPzqdPqhr1puxMY4A-Hw8sMqPjiYJyLygG7MKxyM0AWoUljCUpmIYfQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XaBtKqJ-HJkwCIwBgC_Ozah0GN4utmrdWDopdLf6zmw&oe=6A32BB2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dT9Xf7iJshoQ7kNvwEijPPA&_nc_oc=AdqPL2thmyyq89lERBtZGyJSsvFqpdueCxabQdNlv5XRCxYJ5j7DazPI_pNdzNqcu2c&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bDWvu_LxXQ_TtNqWLm9ODRaZwyghL4gNLLAAqyq6D0w&oe=6A32A55A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
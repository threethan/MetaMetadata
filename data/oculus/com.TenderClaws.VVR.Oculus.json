020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTIg2MXaca4Q7kNvwGEkzDQ&_nc_oc=AdqUqdki0T4k7lZCHt7BTWMNEGplf3CzyDODSVepZiD7Tgh3IdBltKaI4RqLQmws6go&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6HEDnhOxtBoSMKM5jRzBq-Gkc8x9tXtBKl-nVA5Fcwg&oe=6AC26E08"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxA1pWur-CUQ7kNvwFtKtY4&_nc_oc=AdpBrNPZ1cvcpbISwat-9ZAIM8Iy_HHw2HgUkdrWi8XBgW9nYmf-z2NQl3uFgWEWzUs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxvcy-wWPRV3K1JIG00UD93hS-jnOTiz0pyUJaXtL70A&oe=6AC26EAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QL5iks-38PsQ7kNvwGbS05W&_nc_oc=AdrRXIrifJUnt3X1VWLE5Gx1zsGv5a3a0k8udkorZ9aA5lCic7KeAIMAnJqtTnPBboE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQtgc2Chww49f7KemAEpvagdsAfQbxyBTWltkDk1HY-A&oe=6AC258DA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
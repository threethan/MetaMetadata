020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnNxwbjumIIQ7kNvwFpJOn0&_nc_oc=AdrcM0PMBC00k5pp-8IFNJGHwW79L-bIWhyrHzD2FPYAgLt_Slwpg3hcVKKFTCgkoT4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Xi5DLN9CWccM2-he_nMIQQ6ujMsY8Prv4NmOtThg8MQ&oe=6A258B88"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQIbhVFrNY8Q7kNvwEcFj4r&_nc_oc=AdrA4sh_kuMhgQFN6pSvZFJJt6ewybBvfwMTP69pP5a348RCVqwFpDqJa1hEMrO46cw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PW6wJC6IDmyrj1B4nwS8TnT6MkBu2_TSEkie95NLujg&oe=6A258C2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9EOuNknHWYQ7kNvwG8keV-&_nc_oc=AdoNF04RBQPiNa-LmVVdiLWn5SwdMet8nYzyvx3JHA_VTyfvuutR2LOGv4aStJnTU44&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lE-Rv6aZLMxN3da6hIoibp9TYICdSJ9j3MhqWB9-sDw&oe=6A25765A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
841357_3054020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JX8bj_yNUJIQ7kNvwF8q6Xa&_nc_oc=AdqWckxc9uvLQQQDMLXEV0oxG_0_KXOj0nqU7NRnzUyq-QGMkKJRzoeAmoXNv429j9k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vF7Q_JJy4mi_i3FOqocn_nu0H3kBlKA8E2mN5gFvLxA&oe=6A468108"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLjUeM0W4QIQ7kNvwEOqkHQ&_nc_oc=AdrfPtZlwcDzgUNuanKGk-poeMtPFjnTf3wHOYOkhdq2W4dG6Ww1R0DY55lneWT_C0E&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XHViOdwmdUHmE1aHg6rzvz55h1EdcQ3nPZFqit0AROA&oe=6A4681AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2yWjAdIMR8Q7kNvwEJHGqe&_nc_oc=AdpEnnSVXJNrOWQsKdIs315O7NyocdaoC2RYJK5MpI7KxN1CCispqTw0uFRRO_X5Y4k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GwgtmR7P7lvKeOtlC9fTsPJxBR3Kx0gcZ3JIDDtK2Sw&oe=6A466BDA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours of gameplay\nAn artichoke screams at you", "short_description": "A comedic adventure in VR about VR"}]}, "developer_name": "Tender Claws", "developer_privacy_policy_url": "http://tenderclaws.com/privacy/PrivacyPolicy.html", "developer_terms_of_service_url": "http://tenderclaws.com/privacy/EULA.html", "publisher_name": "Tender Claws", "support_website_url": null, "website_url": "http://vvr.tenderclaws.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_TW", "de", "es_MX", "fr", "it", "ja", "ko"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "236003435392167"}}]}, "scheduled_offers": {"count": 22, "nodes": [{"status": "PUBLISHED", "id": "1985115311801099"}, {"status": "PUBLISHED", "id": "2060673650815397"}, {"status": "PUBLISHED", "id": "239110429970811"}, {"status": "PUBLISHED", "id": "2387441841534199"}, {"status": "PUBLISHED", "id": "2112803752375000"}, {"status": "PUBLISHED", "id": "1184598278385490"}, {"status": "PUBLISHED", "id": "2024251177630645"}, {"status": "PUBLISHED", "id": "733663153680199"}, {"status": "CANCELLED", "id": "2007969472787764"}, {"status": "PUBLISHED", "id": "250534455763912"}, {"status": "PUBLISHED", "id": "2090629397691308"}, {"status": "PUBLISHED", "id": "1062558573905725"}, {"status": "PUBLISHED", "id": "370931030410871"}, {"status": "PUBLISHED", "id": "271854080428848"}, {"status": "PUBLISHED", "id": "339906466755143"}, {"status": "PUBLISHED", "id": "2310753949201591"}, {"status": "PUBLISHED", "id": "2242311796032951"
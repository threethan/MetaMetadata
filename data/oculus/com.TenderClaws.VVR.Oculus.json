020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foeu5i_hPYQQ7kNvwGMgqxf&_nc_oc=Adqjczw6equaY60l8xlMkiDy2Zq8yKWQQWIWnq4i4cvKhZRz3kTImSiQmDNxUuTI5d4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgW5dRk0xlNYbdrLBe-vPAGTIaDVzEF23GBjCuI79bLw&oe=69C272C8"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99LOsW9ARA0Q7kNvwHCyU3M&_nc_oc=Ado9ATBWLGAMK9by607x9aGStDVN0TiDzAR2rOwmtWVer2mFzZb3D5YJSQ26ua1AukM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx6WNsLuE76qnYfX-EmLb3cl1GO4WH74ZZPg7_F9-TkSw&oe=69C2736D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTwal9_8kVwQ7kNvwGwrTlc&_nc_oc=AdpMWkX1wH3obDxMJQViywx83qrk-FXa9W1I0Tt8l9LuledBe3uoK8DHkh3Ck-V_bcA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGPlIQ89VkwunFaSwDmbenwgVWzZNqeH4-GhBVN0p-YQ&oe=69C295DA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
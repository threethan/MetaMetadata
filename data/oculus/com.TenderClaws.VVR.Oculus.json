020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-5b-vlNb5sQ7kNvwGAbXzT&_nc_oc=AdpT_CFrtDd6_LOw7ES0hksy1K1Zg6TFEwJd9xbjuXndWJGh0-QKUV1A9-HTJ2BW1bw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EpEOjSA8bQ0AsspSyb6uSWlhWtckyRDlk-ME8a9DBIw&oe=6A26DD08"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQIbhVFrNY8Q7kNvwGiowg-&_nc_oc=AdqLCVKvZ4pjEJMMMEpv0p1p0sOS3qSRUK5CfiHkTExZ96vDuTWI8bOVrVZuC360gxM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fI3cFT45MeYUjI4Kbaf6ChaXRT4w_f035rN_a9QkTCg&oe=6A26DDAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9EOuNknHWYQ7kNvwGzQioN&_nc_oc=AdrLyWwd9o7sTnrXvZF7x6CSwEn5zQhgmYtaeCUdoOPm66jojURKGJse8dbGPpdzovA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zdeIzF0e0hsRW16-30cwtS1sxUD_d_43rQm4zmeH36A&oe=6A26C7DA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
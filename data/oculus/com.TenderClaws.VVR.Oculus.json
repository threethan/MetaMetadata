020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsCe6dkDOGwQ7kNvwEv6hTO&_nc_oc=AdoLILqUQGT2HIsc3jZIQE81rvfQsZwLAjgnLE7kn-nBbTiIk1JN3kiValuUDh1lzAE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOa9sRkJxlzP-7_lgFhCBBYc0dAUiDvGzi-1rbZBaBadQ&oe=6AD0EE88"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQnBYSC1FKgQ7kNvwH6oAk_&_nc_oc=AdpgW3W5uWTmUleJtBhyU9lLBc0QlK9hTYlS5BmMfgDxbF-RhDsem9NGus89ZesX4iw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1mqzCz4J29At8NRy7yN_nCt6zcaoXWijffBri0Wgdmw&oe=6AD0EF2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kGEtvuKW3cQ7kNvwGAh2gL&_nc_oc=AdpoMpIZwZxSe1DTIXevrcqiWkWho02qbu572GtSpannM9LEl_3Z0PpnISN6uzOt3wQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPr7ldPtuOzJzMsP58kJFvfXjvgaEShKiEwC0LxGaxLXA&oe=6AD0D95A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
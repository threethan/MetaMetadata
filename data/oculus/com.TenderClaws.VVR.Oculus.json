020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erP_gTn_xyAQ7kNvwHu6oW0&_nc_oc=AdpK2rzlXF8tAAIs6kPQ1CBRR6XhNBqVcup7E8-Szic8vD-gz2Sr797LDe50Cdq4lxg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfusYohBPvZU43-m9w2IayI-zYzxssMjRpErncSOd4iA&oe=6ABA8508"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SLpxQJhnbQQ7kNvwHBJnl4&_nc_oc=AdpaNu85JRMk_VR-hs2F9oiU-F-pW-_ln9EKPBj6DIoFK_oH2aSWGMXiDGu8A_Hk-3U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILqfwREQgx_HIKzL7tM0XUHBQSExfuujN0f0iwVcjAeQ&oe=6ABA85AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z05ijTvvbFYQ7kNvwGHWRj2&_nc_oc=AdorT5qouhbkbeAcd5HLz5q4U9m07yI989hDEjjuaNfjcR7JeMFkw95y-jrs1Vd3MOQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBCca8FVBtKRTvHuNvWdFvwaDl4zeelyIv2EPo2sWkYA&oe=6ABA6FDA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
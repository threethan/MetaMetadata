020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzgolmTXfpcQ7kNvwHModDc&_nc_oc=AdpBN123cqaASjMLtUBpD9N0ePNC_XJ6gMxUCCqG1008SwnaX1DiQcDbZ1tIe9XY8hU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Dq63XlFjQOjiIv2R7areswO0CnBCxktl8NCBwxbbZXQ&oe=6A413B08"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNFDMZsQLzMQ7kNvwHV_FCr&_nc_oc=AdpjdOc05tUwBiaqFB1kgKa1kx8REc5PMqKgt0HbJosFlCRTcD78cC21jsfw_61_BV0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qfW9Ummvrs1DWjChL13tQK_cdwT9TeIA9GpbgL3Jftw&oe=6A413BAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9YCyJom9OEQ7kNvwGajSwz&_nc_oc=AdpRJqkYOBLg5Nk3xPtwnw3XEHaOioU4EoIysWHSK2GYhD5rD-XI07NVXgNygVn1sAY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AYzmE28v_R5EQ4F-tQJxT_kWtV3SP2k8M_spOADpheg&oe=6A4125DA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
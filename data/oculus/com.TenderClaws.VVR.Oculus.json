020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIPcg0p8TY8Q7kNvwEDWBGm&_nc_oc=AdolnEhaMxzyoRJfG5ARcRQdSyHL-8DR3P_nqNn5ezRoJEU6DM9aBYdKswoIoXDzTfs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInJh7_TFXEwhGXEPt1qMecPU-c5JeyVSh-ACfrbSzQww&oe=6A998F88"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=md8Bubh6KMYQ7kNvwEtW4sN&_nc_oc=AdpZR3H5lOTCxdy1VaYw2A8x4dofkSrUW_hjA3z9ZuOvfeT6oFI5Uzs74lgTD7X5MR0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIo5xafq-jP_Lf4ZDn-myGUYPU7L8JEiosRQ4UWS2L7-A&oe=6A99902D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcBLr2CElWIQ7kNvwEofq-N&_nc_oc=AdoZpAEOdd54FzEx9R1ws8K_p8AfdCPosC3GumOfaDPDv9fUGa-TiQY6MS_pVHAv-8A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEhgitrL2GXEdmwvBg3NolI18ZSHhI6AgOoNwW9NtVKQ&oe=6A997A5A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
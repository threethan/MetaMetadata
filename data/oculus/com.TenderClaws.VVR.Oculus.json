020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPai-SKCQn4Q7kNvwH6BPjO&_nc_oc=AdpM0ULqjJX0zj-7jhNTxtX0zUTR_uOaAFfT6Sboo8KAUOd_d6jkcf9Bgd4oVNfptT0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPwC2CcfLtfILsnhxbv58mCNnUOpzV50UIofMsL7-ftA&oe=6AB69088"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuyeLRud_v4Q7kNvwE0uqrL&_nc_oc=AdqFOI2A8LSESvJcgTgX9etwwhNnWQv2Zm511njN5jZKCkuempd9Xdo2ugiK1OjvmQ0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhdn1z_KuKyS4_3pP-COjJrG8rsu2ZlynhkVy2R04a-w&oe=6AB6912D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtSOGaiMcuEQ7kNvwHwdMES&_nc_oc=AdptEuY4ej6H6sBkAM9I6OpObPF0pcc-kmuHhxiFlBnizIx_obxbPSCgA44QGJ1rohU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4p3GtzC0vcSkIBH7MV-BEdRjwfMONeuF0haQ5rAMNoQ&oe=6AB67B5A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
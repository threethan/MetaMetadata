020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Qy0dfxIzQkQ7kNvwEskyI4&_nc_oc=AdpRrMohFFZ8mEIK_njZoqVI_uUGEniPdFnLdjxJHF4hcUGPCrml1pLa6rUOwMJFW70&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0j8xN-IlIf7qS2pPizmycd5a_BwvCxTG8-6ImVkI1DjA&oe=69EA3808"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKC_6txeFDEQ7kNvwHDan-z&_nc_oc=Adpl610IX0fGmfb9ExSt4QPams3P50K-pd6zmCtfEV-37Es51fgv8_7TVoKVlQi6FRc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KXUdU3pj9JnX5wuVSgPnDjJW6EUabOWPGggpaYHlOnQ&oe=69EA38AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIKEGN0an6gQ7kNvwFBt5xe&_nc_oc=AdrrCbPotIbN-EHso3UaWWIUKRrTnYEgXB-JY95JInZgTKbB4fbO0ikSiKt5ky-8OXU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uV5E6zwlCvjLeizj0qTk8V6nM84f6kyq97a8Aby8r3A&oe=69EA22DA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
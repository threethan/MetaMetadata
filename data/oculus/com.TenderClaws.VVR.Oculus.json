020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjzZ8KN7j7UQ7kNvwHrJ_-m&_nc_oc=AdpNxEXuXk0P6C6codaYqOriKkBWqmtmiseV_r3n8vmjll-gc-K-ABYxqZxSnYXr6Bk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xHIUYNVdYXP95RHDsEmqm0KT7NtCKqQ17fYCbsKT9TA&oe=6A00A188"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPGqVxPraOQQ7kNvwFDSTZF&_nc_oc=AdowtZKBqSKukRdnzNzW7QJnv7auqYiut7GlQPMtozaiXWIHf4D372bnHpcGjsesFDc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yQ73O7RfIed_GcfIBUdmljZQKtKZ-0kHymTV8i6RoeA&oe=6A00A22D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdxCg_VR7CMQ7kNvwEE294B&_nc_oc=AdqokcBEqTAFi2LkXg_3hFTz7tw7aBo_TxGqS7C1X8vP6ciT__CrriGkEArSANL-TRw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BqyciZIpZg2DHDJvuy28JI5AXJelVid3rGP31Vzy4dw&oe=6A008C5A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
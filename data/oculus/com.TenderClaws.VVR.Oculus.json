020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EM-yFepdD10Q7kNvwEH3DMn&_nc_oc=AdqiT_iWiGAzbXCEAaOdlQvVuN4IT32XhUNVg5O7z4pm3QrG1L8zbD_bAN3VhiEoFa0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMmxU9iosfigvxtLim-lnB2luVtha48jugoh-ARBIj5A&oe=6A9D8408"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8CS_q8e908Q7kNvwEbraT8&_nc_oc=AdrYaWenFZq9KgMOYspktGjy4O6SX7SvHhPzhZ92f__eIRT3s1O5omLq4wWX2ZareuU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlYHIQe5-yRSYHQKh8Mzt7aa-awyeUDRSCyrROfTA4EQ&oe=6A9D84AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRUDCsvU-ekQ7kNvwGLRumn&_nc_oc=Adqt9Kzs0w2kkA8kjeXbk8FxQ6TJnQyEsq08P6G0-fKOSnbLHnrIGqIIqIb2ymS5HKY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrUb1sJpgBOFtMsB3ChdziXffwr1CAbP5zdkRUyhTJrw&oe=6A9D6EDA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
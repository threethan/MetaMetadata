020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GssKpQihltsQ7kNvwGBChQz&_nc_oc=Adqs1ddHQxUIEWQb3qWq7hYUApIr5IOaGrW1lt-hsZcjos1vd2Vp_CInAH-8_cC1PPA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnbaX8thPdfVZIgu7rWmXFri_Wtr-29CyMCmcpIqA8Iw&oe=6AA17888"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlVXu8vLsZ0Q7kNvwFibY77&_nc_oc=AdqlMJqU1Qtrd6zYp8977g4oGQR0DuLCSA17HJt87O2mXM-oXwK0RT56qL60YMnZGUM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcEjU_xuoPxxHnTYPWkVQPx2svxZPpsVOABVM7Qxu-Hg&oe=6AA1792D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9lTTYx-tCgQ7kNvwGE669n&_nc_oc=AdpBgJ9-eSphiUD7K8XgX6FFTTes4rfNIpo3SXoy92_CmabS0cC4CxHWqCADDzB72Co&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLu0gNcd-Ha5MrmyUbnUkwZIri8bS-Zwk8AQmsnfdxQzA&oe=6AA1635A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
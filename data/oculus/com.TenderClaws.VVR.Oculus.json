020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTMWxExSZpwQ7kNvwGcMyZb&_nc_oc=AdouAOvl4pBtYvGavRY8Oe8YN8RwWQVSniOUlGiBAAGHZ2qqwoYnYgoYapJDiKicyaQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vNV56jPtLvtxEvRfBi8vDJhuz_QN1yTAcEQ-p9bCvfA&oe=69E36848"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNHDPyvvvh8Q7kNvwFCE-mu&_nc_oc=AdpDVZS2oUsWRhiP_JYxUoSkrrqMUBfqrH5vPdviCP8h7jiKTa2mCDMQ20Zd0xWVrbo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0u23FSN4B7fNxuHXLgrnMd5Sp-o8ry1l5PU3wwqfyYiQ&oe=69E368ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgbMxr2tTQAQ7kNvwGoy5dS&_nc_oc=AdoiqB32FEIdW1e5t8x3uzJQhHegtR8a9hasuiB3PbUWK1mOMS_nBOgbnkuNAEixohw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Sn4YellPrBDoUlxtZ-PD2wUMF89qjTd7u8aBJa4lKsw&oe=69E38B5A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
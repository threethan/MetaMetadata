020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWgswF1LByMQ7kNvwEy8CwG&_nc_oc=AdpTf6Hku6yUM2n0jYuDkICCwtXGTVb_VVQ4UQTBbOh-dRCsqTODACVPs3rNqrt1D2w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIi9ZiItLwuHQ4edDrhTCfblOPxYM-LybeEmYsitFfQw&oe=6A688FC8"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNh0D0T8nKEQ7kNvwF8aCna&_nc_oc=AdrfH2Zu9IaT8Q57hkiVLWpZrOym9e2Bu5KRmZazDqAd-pzCkpce8n-fUwn0lAqiVqo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJOZeEbKAZhjS6x3u66m5jsOj6yYSps-ZXdkc8IID5Tw&oe=6A68906D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNYwrKtth1QQ7kNvwHkXLZ-&_nc_oc=AdpPLVbgXNm9DFfGtBYyFS_MZScLlD5TkM8BnYotcgmpZCkhdHoj4AowZLFSnVuNrbI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeXvkT0pS45JICIxWVU_hkwNWxHzFUinLLD9KBcbk8YQ&oe=6A68B2DA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
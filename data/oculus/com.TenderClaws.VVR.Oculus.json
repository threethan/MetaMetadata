020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJ5e_zKPoFoQ7kNvwEWzCuS&_nc_oc=AdpjI1Djov_T33fS-UvimuEefiPKOKX3elK1d9q3btr44poSyvQGWk5Rg3hddK1OUAI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwmK0T3B17g7DXEf1OJUrAgiDZL02DhpQowMpImFfRt9w&oe=69D0F348"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAJZLTJaUXwQ7kNvwF021Lj&_nc_oc=AdqU-gR4BexaiykECPjuBCwNcjk_-qKoZZc3MZX5l7pn_NdfObeGUQAfer_MK6K7-pQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1VeGNhPi9eu4GuBjdYuNyP9GnOPap-5aRLa5GFVb3uQ&oe=69D0F3ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFpqN7A-kXUQ7kNvwF_b4IF&_nc_oc=Ado_btAHki1lAWFZAesbiZjORnYAFza6V45NvNtosdG8icxgq-PIQMH8_wuHqxy-FVs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEdpet3pGRwAk9TMCHpn7V-BZEna6kqwUxRSiEAKJHBA&oe=69D1165A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
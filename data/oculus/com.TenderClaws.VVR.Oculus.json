020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JX8bj_yNUJIQ7kNvwEkXRtZ&_nc_oc=Adrzpi3wZ7NfoxD28pVQUxn76MU0_P7lXODXhmWOl_qYcbOgBOz5Nzej78yKkhmMgbM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBn25u7pOAoOWPsShrz6srMdtKBfwQI5wn_S-2GdpHBVQ&oe=6A492408"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkF6ofgWALAQ7kNvwHYUM8b&_nc_oc=Adrm-usQcwoYyOu4i8ng8eIxpMTrkf_I0Plcq_8A3rTq8OMh8VQ4w0o6tP1032Z39zU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrIHRXYKRIbGWbzcctjEo-oUlSZnXlaAJxUQzxL8_K9w&oe=6A4924AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFQ4VOZSNisQ7kNvwFUuxTv&_nc_oc=Adq22hK0qMXg1mIh-BjGGGfg4o0upv18oDZjqWDLHtaArHvX-YIkrVDUCmkG7jpi8r8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjds1tEPhCMtgifFd06uMlCsYBQiGIaUY-SyIMZVoitw&oe=6A490EDA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
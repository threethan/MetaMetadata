020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNihVXvnuL0Q7kNvwGFpQXW&_nc_oc=AdrlyPQL0aXoGKas8gMt-iLjl4Ns5pedUdiMJq3e3qFEZvrmJZXu99rp_jrMflsrhjE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1hlb2r6ggOp5RDZXd_oSqonfhigygSwPLJ2HK3VkYgg&oe=6A380088"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tiYZprLLNSwQ7kNvwE9ViWW&_nc_oc=Adqew7L9ZmsYB58ih72grcBrp3k6z8AncuvMXyC22af27oc79hFEobBZ6zPwIPeGe1o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hXe5hfiAKZHZeLRApTDTC-INRtiM2co8LkRJw9mtayw&oe=6A38012D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOgnj56fUBAQ7kNvwH9anzJ&_nc_oc=Adp7audPCbrlLzKZh4Q0e2syYczuIeUuq_8IXhpTL2gb2x-LeLP80mSTqGVf7d4Ja0I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ltN10FtREN3p56b2B_1VWAnO_9OlhDWNiISqzB6nqlw&oe=6A37EB5A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9svUrg9hjMQ7kNvwEtHCmx&_nc_oc=AdqE68P0gDZErd9biOYASmLIeoiWlKl5sKr4L4ZKSfQi2ryzCJr1LHunT7f2gFHH15g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCp1pYFlSXMFsZtkhl7kX9QKg91JPJy-ahUx6gLOO0Bg&oe=6AE4B508"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPwyoTuwx5UQ7kNvwEQvRwz&_nc_oc=AdoT7P_NTlZN2yjxI-54tpEnsT-Li2gmXFGQGzEAU87XB4jfVS_MUgwRqEpoAgon_UU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMO0V9VCltv9GZIpITcop5Sq8zL1muCA4Ubs3QoutvBIQ&oe=6AE4B5AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UnglvyXlcMQ7kNvwEvImfl&_nc_oc=AdqUXbV9gRpLku1Il_CX0n93WMMaJeckG7-XnMP8LpaezpAhpA4nrMOp-HyINsqdfnE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8c27lyIfuqv0wu2If_NgQ_MPr5wx81HKTPzO8Dx6HLw&oe=6AE49FDA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
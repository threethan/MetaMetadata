020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbECsbVPoHAQ7kNvwFlr4Se&_nc_oc=AdqaXWYRPLHgHw_G7wwzesc41BUUi50L8tOXnikQGuzXpWq-OWhO9bW7fxFU8xSv67A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gpjmvZ-NYSiPe2mZGF5bXyTizI8HhQ1WCPsu-OcfpRA&oe=69D63948"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lR9dMoNN_kkQ7kNvwErvb94&_nc_oc=AdreFEiEplhddK3RoXQuORcWm_zlJq4Y8oZOE38QDZax8oKPWaa-i_5cvX50uAyjyjg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FL0G-Xv549yS_XyyTW812Yzxv-oVXACRo9I2N0BGqFw&oe=69D639ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbho-JK3PpYQ7kNvwHCZ0jv&_nc_oc=AdodN-mH7M4kevWaXyv1LH8yzM5cPljI1hfP8M6_kaOUNIoaQs1mnzI9h6sKp_qr_uc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1blEKgOpfSHwxjlouGjIwpF51ZuVd0QGv8asGBw7aXBw&oe=69D65C5A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOssq2GyfQoQ7kNvwG9Ikb0&_nc_oc=Adq5pNex5SiINZX4Y6inPRl_Jftx_3PhDzHi9jT2mLbPUIWagsVcUnIAOV3EnF-950U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tjHovEa28BIn3Be2XeV5AyGir0Sk1t5G7WUOuDD14Xw&oe=6A301788"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qh7EBwg6oC8Q7kNvwEpBYiE&_nc_oc=AdoK4MByb59l-FYfxxU4CWqV8GW4iCt_uGRJbJqjR2R6dRHYPe4_0OazUbC-XN8qxFs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84ROuj20DZvRKg-nI-m-anpNHKH0k0_nXhR-9XjI1Tnw&oe=6A30182D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6dBHGRtG3oQ7kNvwFVOQAr&_nc_oc=Adq93x8JmhStZmzJPEgEf91CftxNyY9deqrvLWKZpz3BbL9jXBbjB8BpkzvBXpNcQek&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Vze6Q1TFWHXRnx4GqrXVoOFq7QruW9_mfBximD20U8w&oe=6A30025A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=My98JCgo-BQQ7kNvwHU0Rer&_nc_oc=Adquqc5Dqm6MgfXtzlUdVDeEe_h3Yh4B29b4pji3PXPN1EYoEUy0lpbXYqWO4Fria9I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRMiFjXsCmjT2pFqi_1w9jfk5Oe8_p9QnzUlh_l2LbFw&oe=6A82EDC8"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNrHdoqz0cYQ7kNvwFxZ7-w&_nc_oc=Adrdpqtthmvb2RDmEWaIJY5BSFmGHTRDOflu-1oGl56UjbtiNE2cf9JktGfK8gmlOf8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETz6tkCzC1mBEaCjqH-2UHyctp5xAH-bwQM9eFyaiugA&oe=6A82EE6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdKH18tgIlkQ7kNvwFQrdCG&_nc_oc=AdpGH4-NVmkEW6sLVeSkc-JRauw92KQRI_1vNl8qkp6UOzT8_CU3zP5l7HuySVJQ7Wg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZQL1F_HvZZ_lL_W00eYi_6LeOYXnmgAT5Mri04lhrPA&oe=6A8310DA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
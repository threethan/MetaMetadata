020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7PYKtzc-7kQ7kNvwHpOdLD&_nc_oc=Adoegfrc5CoXkB_l9X6GTW49HMCriM-XNhBXLE1Kl5TnwW__ZlO7Ac7cJlCHo1GTzM8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZH9mtL3qyx0_SAS3YmbyflQVBWTmntTDOVv46W62pDw&oe=6AE21208"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyQ1rC-ytO4Q7kNvwEERjsR&_nc_oc=AdoFX7XevbZwXYb_5qZ03jDL4aD5cv478g2a1KXYngNFQX2kYEEnom7WaHXnHf-KME8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbWqr30Lo8b_X5xbgkaWtPxqgjDf4eRtAgM8HW-EguVA&oe=6AE212AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QWOwwjfodQQ7kNvwERP1V_&_nc_oc=AdrcnP_nF4N688ruI2rtb-dZsREuxAoi_FJAb3Utf3qYrZ51rcB61mu8z6mzObXj_JQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPeFt2LmTd6WffYZ_Eb390U67U6ocbA9ehiBp4Fe03Ww&oe=6AE1FCDA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
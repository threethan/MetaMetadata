zqv7Bn9Aozts3Fuz-_co&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsU7I74ynque5C9PbD5I7bYxgUqq7ko1IIzjc7sGqLlCw&oe=69A571C8"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pd0podojSccQ7kNvwGCrN47&_nc_oc=AdlvgUovaz_Idhoz2aO80PTwg76wPIDT3JvKr1uvNHtEi5pf4KlfnN2aW2ecl7truy4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuEacJFLyTJdlCU4Ht_lKI4YmdsGChmTpt5eHA7_LSy1A&oe=69A5726D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nO3YqYbieDYQ7kNvwHtY6I_&_nc_oc=AdkySy3RUfm5FJXcucyUDPSSPYBgQnpRHcPZcxM-NDnI94rdd4aULCEGvHSnzHExRIQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuxBpSpuocPCm-Dg_lP81GiZaUcA2wB5ooyGfoc4KYXsg&oe=69A594DA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours of gameplay\nAn artichoke screams at you", "short_description": "A comedic adventure in VR about VR"}]}, "developer_name": "Tender Claws", "developer_privacy_policy_url": "http://tend
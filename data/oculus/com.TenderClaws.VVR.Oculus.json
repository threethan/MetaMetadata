020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tz37jYKXR4cQ7kNvwGEdzlf&_nc_oc=Adr3wv0gKCYoON_H2MK5iPWVPZX78udaECCpvih1D63lWNcXwKjOSwm_OMOjrRBrTCo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKrzGRCZ7L9ebmSV5pbgpvY3DQl3rs-u0Ne9vrDSqG0w&oe=6A576C48"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMgC1j1kMBYQ7kNvwGGGfij&_nc_oc=AdouKrymgnViPwKe1JKiPK-6Bm20a7f6oqOzunO_lVOGWHmDr83tkebdzG1ZBGbYUIE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDi-h2lpWX85v54pv-rfE1mvXjY7-IMRMLj0Zr9clvegg&oe=6A576CED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixsPUbrZUY8Q7kNvwGGX-3N&_nc_oc=AdqW8aoAc3xQKgHj1ihNIvFDv55UkxA0qSJWmrYW6Quh9XHKQGEmJGHuUkJYJtPG7Ms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAORzgQkAscEqqrulIqRpWZ2wX9_8GpPNPvEkbSSiCzAw&oe=6A578F5A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
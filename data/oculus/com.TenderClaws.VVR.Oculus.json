020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtb-KMRlH_QQ7kNvwEVg3k2&_nc_oc=AdoqfBurYioEf9uhOeNeGad-up7P2tqS9eP5BOZrvpC_r8zjbwQpOUCti44EeB8quhI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOi2Ct0WR7w8PcjrLtFqvjWDQ61YWsPFvg66p41rCEDPA&oe=6ACCFA08"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-kdWDJTgjwQ7kNvwEmCh8G&_nc_oc=Adp5SdApttAwn40u3TTbOt5dJrIY752gHIJdTq9XMINofP-ceZG1hnoHHBycE2RpEeU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaZA1tkMUL1sf6KcLVH_uldgJy3GChUlCY-0EknPN75Q&oe=6ACCFAAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hE7eTA-vabMQ7kNvwGaX6tO&_nc_oc=AdqrqRnXM58KWTKALJIKg2IdpH_vS6YVN-IU4CxDX2LqG3kN97nJK1tXmQULsMligmk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNn8u4EVIsT-5Iw5T27gcBxbWz8IkdhKUhgLU5QwO1w-g&oe=6ACCE4DA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JX8bj_yNUJIQ7kNvwEr3XTw&_nc_oc=Adrokeog82pgVacdhR7oR6MN_zO35OWrKedpSh4O7y7Mp9Rup3kFpSruA36bkbjF2Fg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XeR6NrMtF9miQM7lztn7D-Auyy7qHLX0WqQFP3zo5Mg&oe=6A47D288"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLjUeM0W4QIQ7kNvwHI734x&_nc_oc=AdrXZBMZlhM6SSWfapJsqZx55ObNkozo2E-Q8LU2ME470Ne_v1dDUaEdkdVrNDA01Rs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WXifnfqdSpH-99UNcXIqyj0yA5WvpmlPHcGhE9GgB5A&oe=6A47D32D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2yWjAdIMR8Q7kNvwFLhoxi&_nc_oc=AdqUpjbvNgvTvpQXjszRzKJA6QiqafYTBjNbsZEnbJWMLbiuwFMhQBhALLmAV5rxxVg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-Uh1fkmL26Jm61aotUlI_bFDuewiQSpcR-hhSAa51cw&oe=6A47BD5A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
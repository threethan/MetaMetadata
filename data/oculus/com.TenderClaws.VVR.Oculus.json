020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Qy0dfxIzQkQ7kNvwGCxssr&_nc_oc=AdpG_ss89Cu4OLMjEoUdyQu7g2P4fTSfLeSZzDUWhf0inCP-TXHCyTUWlJArxr99DMA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tICfZDldGucSkKk044yo-YO-uA5x0Bwn-GpKgu0OvcA&oe=69E8AE48"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJq-z_6wYu0Q7kNvwHBUVeX&_nc_oc=Ado_gZ5nT4AlZnf10AZw9TBLsnQ_6kTdkKIFmuRRkgIOueoTPjsSYM3bizXXqWA3MCs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3w1-l9y-TiY7YlgH_QyOhdLjatiqJ1Y7b5GSbVDUI4YQ&oe=69E8AEED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kgvIlRHTklIQ7kNvwHSkVoa&_nc_oc=AdperXi-IBOA-8n9Xd4sJtEvZF9xee2RSra4aiJI0qLfQw23JXiUUepspY4RLJuF3Oo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YRNtwRnBkUkVdKF3pd6PP1jeQIn35QUjGMe088m5riQ&oe=69E8D15A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
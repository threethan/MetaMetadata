020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vd5qNsr8rbsQ7kNvwFf-XaE&_nc_oc=AdobUQgDbmXab8FB-Xp863ka1v8cWA7r8uhW8aXUIieMeEMBU3yq4XcYIH4YczQcTzc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ex6HcPUqm9ZR4PAZel9TP5GJyl60Z5IaRX_6duCkmPA&oe=6A05E788"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfVbov5YI0sQ7kNvwHOvUV1&_nc_oc=AdocKxwpG07QM-kTT4BC61xMvmWyj3cgba8CpbE8VjEf8shiP2wGuQLeWmiMraS5VHg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Oh2mvdOpD_iLZKPrByzSdR-PjGupqQiZwCBLWmSsxkQ&oe=6A05E82D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxlzSP42YaMQ7kNvwH8LiAf&_nc_oc=AdpEGySvmJGQHvKd4TmnDi2IEvdyJeA8k1jS39UVBsiHxWe7cd4sANYEjawUtqUm8EQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VpDr4gF7kM79NWjEZDs7wN_T7FcsOxjrJTWhR2_UPFA&oe=6A05D25A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTMWxExSZpwQ7kNvwGPIUWn&_nc_oc=AdqbgagkzyV7vWHBL5Bi6cQuQPP7LZYVw1XJApIuS85Wxc0cNBgeb9IAXTXHm4wUsuQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KiQ8gjYtHcITQ2uPuOrifYGVmF0vtzORC0eCHU1KLkw&oe=69E64388"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJq-z_6wYu0Q7kNvwHoJt2w&_nc_oc=Adrspy9KZDVwBLo0zZ1mvlCKOiFXAcasiSyMdf9GixaNYuVr0HxYB28JOvVKixmPpKQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30FfrzDkg4k4UsSifogzLtasPxl5Cb2pwWD3Yb85grtg&oe=69E6442D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kgvIlRHTklIQ7kNvwFAI2fC&_nc_oc=AdqHuqIYeWZ3wyAG6cJtXSJnOrmnbXgXSqoeKusp3Yy_vaEjI9zPqTvRuF3kw5-XFI0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2AJUGclo6eBJ_T1REEGqk2POa1hq4yoYlHVwniTyrHCw&oe=69E62E5A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
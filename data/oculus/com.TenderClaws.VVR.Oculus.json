020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSHng6dULFoQ7kNvwHNcaOB&_nc_oc=AdrV1KE6wHJewanKIDSxN-UmKXqf2N6PLn6HjG2i5zDlo6aYLVkjxPBfhUngg7cQkWY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbetoKzdyKG-8HusRYrdIt-lYL6Mm9FAaaL0329Cp0zg&oe=6A638208"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eprMnBB-9WcQ7kNvwFdSb7e&_nc_oc=AdpRKN5KmH8PDaQYhR4Vc71jA1f9F1TbZ5kfMjAI3u9LWOP89qkakWRdmhb5wvn0rjc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASp4EhEUm081Xeew-PO1f7qgjdWd9Ji0juEFzUNNKsNg&oe=6A6382AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LytQtaXt_cMQ7kNvwHAJh0Y&_nc_oc=Adqfp4_mOpMH2utK5Hg0LmB-0iBlLoiLH7JOcIXy50dty3gZiUYpU7hSnxmeDX4TrZY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkpvAS3GX_utIUBPQ3IeLQ6WCnr4rEuSyGDFIHibaQIg&oe=6A636CDA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
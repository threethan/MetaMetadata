020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7BkN9DX50oQ7kNvwFyl8EZ&_nc_oc=AdoQaGkZJruFtHXrqpj-QVOWVL_TvNJUS6pD-sWgZLdlRJoXIbbueWRVp1aJP0Nqqqc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVtY3wkqvm2ypOMcRvhaFXFpnExIIcSnI3H7Wo3lWqAQ&oe=6AAFF908"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXbFZXif8Q8Q7kNvwGzzVmd&_nc_oc=Adq72AeL6cmDvcvTaVm3kKn7HwLB41DxkGCvRlfWvYyjuGIypBHexCOGnJ7pDYRN-b8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcB_p92LRHfMnFAt_ktOsHyvgXzL5RlWuxewwBPCaCZA&oe=6AAFF9AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZfgb_HMoz8Q7kNvwHigEZL&_nc_oc=AdoiwczkLkbNySBtuJfxmv1J7dl13Ag0OtgX0_lWBmPLxzKnBv-N7igTZbzi-JUYPR8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI317noucTxhrno8c7_8pT-Ar2bBuJpLqfGagI7iEOIzg&oe=6AAFE3DA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
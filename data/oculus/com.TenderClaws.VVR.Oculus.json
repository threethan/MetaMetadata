020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOAZ9Zo-9eUQ7kNvwEoOtw0&_nc_oc=Ado8_HUgBhpToIBJWYzcOjkWdS_tQedGzLryjbnInE9SPXsVZDkUCLdDObCgSLIbgbU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkof13Kur6VltfRuJs1KSt3ruq1-azD37z2Tm4l3IdUA&oe=6A8C2848"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmvB4UyLOy4Q7kNvwGGEUHd&_nc_oc=AdrIYBKds-qe_yhm98xJnYFnqCzP3kZ-bGul_Po7vhpr0smtWGhDENaPOMjJFJPLuAY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGonrZaTg7vEvz_tZInJtPB88tcNX3V5zKYTSu2fiy7rw&oe=6A8C28ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bJqYzwIf6cQ7kNvwFP0Dd2&_nc_oc=Ado0y6f57uJAtti5YNonezphAzQfme6DnoAJBP3B8l254fdoPbKY4Iga02NaceHpu-M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRUeWllZyLmchOVp4krfU5CYKfCaz_aTWVh_p7eDTdjw&oe=6A8C131A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
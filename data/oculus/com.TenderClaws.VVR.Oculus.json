020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsCe6dkDOGwQ7kNvwGE290L&_nc_oc=AdrErj7c4Bt7OQEHBAIsX3uP12n04KutjuNPbqO_N3S-76yEC8JdJa7q2nJORRLaZN8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPd4wxNOFqFJhS92_sOyyTRWWDj7q2VViwl7Ht1peUWyw&oe=6AD39188"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h52Wn75qXvoQ7kNvwFoRLES&_nc_oc=Adqm_ZBKYQCeqtv96DOqVkftWMjNTEbzyY9PMU8FdvlVyX3_5iB8272J2YFq9kMYUL4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOud_Qb6c4vJsY9kuTnAfaggTdS5Px9igg67e3QJy6lOQ&oe=6AD3922D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElYbGPBets0Q7kNvwFegrmO&_nc_oc=Adpr873qvE7kAPBnIil5MND8fL_ForRNIvRTXMSl7VpJZklYJ4ItNQqcCefFPBVDzro&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTmiGp1SUqmOmvbhR5V81KK_6XWeLL98NAGyc__aSHCQ&oe=6AD3B49A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2r2Ujg7tZgQ7kNvwEwCV4I&_nc_oc=Adr_hN-YBnD3vMz_CGqGnBSShuWNRsm3yUo8-5myvyH0gu3r2DpR0tP54LeJa2hbWxg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHRVB3D54B7ExGsGteKvktmwB0Mx8o7lWDOTydVCp6wQ&oe=6A735408"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dl0oyJWR8x8Q7kNvwFVM7UT&_nc_oc=AdqoWQhvv5GB0K7vx1O40YusW2mQcZvWYFljxVNdgdov06WqoPb05K7j8NFi2mEhnzY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUjmjW68rOMah7PEgI9jDpiJH8HEjz4q2lAc0wO2SCIg&oe=6A7354AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrMRWKGOv_0Q7kNvwHcKVI1&_nc_oc=Adqq1QRphZ6-0732TrXyYJXxtjOosANgLumHC2JwR25W5-cQhHs76raaybH5L9y1q_M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFItR-j1ZZPmBInAoZWeXu9ELCaEQG7VAKBYaat-n_eBw&oe=6A733EDA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
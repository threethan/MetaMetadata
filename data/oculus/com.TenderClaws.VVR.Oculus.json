020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsCe6dkDOGwQ7kNvwGI2-GT&_nc_oc=AdrwmrzSobRi73w_vaE3Dc7KqYkFdKnEd6KRy3JmowkQTnB7RpXmD5pjFJ3T3qhoLs0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlRxZveDY0EgnRKBvN8AbZs5YERLo9RdRkeY53MB3gAg&oe=6AD24008"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQnBYSC1FKgQ7kNvwEeDwsb&_nc_oc=Adq8PqQRdEpM7tgUzegssB792_DOZ55uVXDY_YmpG_DUCtc9Mm3e78_QQBx0t2G5KEA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDnITU2Krb1JlTnYW56IQrWbMP_p9mpGrI3q6DtR_-FA&oe=6AD240AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kGEtvuKW3cQ7kNvwGM6F6S&_nc_oc=AdoNNwwl8a7vsS1WJ-E2isOFYeG2emcorxy0lslCV0xR7iOI1km3gR0mvsZwQm7WdxQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtIjqNe5xRJoHSaZql3ZlFZL7XY6Pec36zOy4_JcxGew&oe=6AD22ADA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
IjFav2GWcIbGdz0m2bRI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftjKkxrxnuLEuw6mQmY--NGOg2n4p8_c2xlHgAa3RXHkg&oe=69A6C348"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BXseqoqGOEQ7kNvwGgXb9Y&_nc_oc=AdnUsyZImbb4PohROLCDtCNt5N1WRnrlm59RyKoGNiHvGg-3t8Y18jApjSbqjHUwxRQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft9eI64OLf1BJRUKyFQi_LKUVMAjJ8bNp03rD32VAlYlw&oe=69A6C3ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1KuQ7SG_NQQ7kNvwE0md63&_nc_oc=AdlFSvVaKMH2fY31-LGtRh2QBrnca17kxEoWaW8ZfPVcbHidoEqxxbAci1Jw74DVIws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvOtFnXnZM12Rss0HW3JYa2EXhRiiPrvOKYXGPOX2cNyg&oe=69A6E65A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours of gameplay\nAn artichoke screams at you", "short_description": "A comedic adventure in VR about VR"}]}, "developer_name": "Tender Claws", "developer_privacy_policy_url": "http://tend
020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uT8BkZJfNgUQ7kNvwFiVnlF&_nc_oc=Ado7yPOniIJHYDqeMj-f0_Rpe61NrKN0OYLfz_sY7hy5iD2c9a23_WknTa6vFQdYkaU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyMrx8_fC80-tFt9u1dl_Mo33FgpsBoyeJ0d7ZXsMh0IA&oe=69C7B8C8"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1w1GToiHjgQ7kNvwGn-ChA&_nc_oc=AdrrcuBEfbHnwrEnmPAjKdd_abLTlYUD-cSdzfgl3j_SBYaZp1YvPYnxz8pE_QP5guo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfymYEmwaQ2YjOHfREEzIjqBB1rgN8QnibAsKTI0yWcHuQ&oe=69C7B96D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KCgiUMwrCoQ7kNvwG8XQjb&_nc_oc=Adohj5F9UyQq0gMrNcwt-KLv7NwTmycAC-A40rJCwEpUFKjP3nMNwtt3-tbijw1WpNw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8cNuKDmDQ7siZ6SI16Xtm3iEbPCperNkB2cTcY6gr1g&oe=69C7DBDA"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
020702949605376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSHng6dULFoQ7kNvwGpVVRA&_nc_oc=AdpGbSAxkIhw0rjF4CmlDJMWFwa9DJFMb6ft1o60WwkBU8G3Hu_O4Jqx87Lxd0MB-Tw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzxkmW2GykuAX7T95rESEVHsFkIEeFrlwNsrXGeEM0pw&oe=6A623088"}, {"file_name": "migrated_image.png", "id": "252649025780110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410441_1572800192829066_3962023484208447488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eprMnBB-9WcQ7kNvwGW3NEv&_nc_oc=AdrHAh_Vqcn0tO5geA4zRI7di9d8t8XnhphkM0i1D106MHcIQIg1AaDN_KGjt56X7XM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkl70h1Ml2yk3NmkKtI76k4PUWinaIa15TI-b8ogKp3Q&oe=6A62312D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR_whale.png", "id": "2083217861960800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139007_2083217868627466_4023114695299825664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LytQtaXt_cMQ7kNvwFDh0DV&_nc_oc=AdpfE-nAlC_b2jTUefmZJ1nNieEfzJNFs0LrBCrmrWGjE0AbiKoaUqIbVCfL82hHuw8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSVsWfh505ij-vtez-m06vRYEqp2uE8wjrdFA65uszYQ&oe=6A621B5A"}, "display_name": "Virtual Virtual Reality", "keywords": ["story", "comedy", "adventure", "explore", "VR"], "long_description": "V-VR is a narrative-driven comedy-adventure game about VR and AI. In a future where AI has transformed society, can humans still find purpose? Find out with Activitude, a service that lets humans aid AI clients in increasingly curious ways. Follow the instructions of Activitude\u2019s AI overlord, Chaz, and find your calling in this tech-fueled future \u2013 or try to break free and reclaim your humanity before it\u2019s too late. Use virtual VR headsets to explore over 50 unique virtual virtual realities, going deeper into the inner workings of Activitude as the story unfolds.\n\nKey Features:\n50+ unique virtual virtual realities\n4+ hours o
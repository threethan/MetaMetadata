c_oc=Adq8E74tSGZls6ChoVawSrxU4b84_n2p5A8_PP_Gwx94Y_nJQV4DUcpIQ4fQSwuBNCE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRS7UaIRt7dSTnWdaB6R7yAez4RVEDHI8sIOFAS0ahrqA&oe=6B09A620"}, {"file_name": "ss5.png", "id": "374776848442020", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982528_374776851775353_5084674446976037596_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DwH9KFn8Z4Q7kNvwHNgZJP&_nc_oc=AdqzpGB4Y6Xnqoh5oV4G5FTcYRUy6AJLBbsdgrBUz9CR6Wgq-g1f6uFf9sDkEljetUg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgW6am8q49aUfb7JF64JSjC8LPhOl0wDye0GNcxmp5ZA&oe=6B09A31C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tableau Vivant", "keywords": [], "long_description": "Inspired by Victorian paper peepshows, often thought to be early iterations of VR, and drawing on the history of the Tableau Vivant, Displace Studio alongside Loughborough University students have created a snapshot in time - a living picture - that uses modern technologies such as Volumetric Capture and 3D Scanning to digitise the student performers and capture University locations to create a Virtual Reality Tableau. \n \nAbstract and everyday choreographies invoke the nostalgia of passing time as students go through university life. With an atmospheric soundtrack and cinematic style, audiences traverse several scenes representing emotional states such as anxiety, challenge, growth, transformation and success as they travel towards a final event that questions the transience of people, and the permanence of place.", "short_description": "Displace Studio alongside Loughborough University students have created a snapshot in time - a living picture - using Volumetric Capture and 3D Scanning to digitise performers and locations in a Virtual Reality Tableau.\n\nTraversing several scenes - representing emotional states such as anxiety, challenge, growth, transformation and success - students travel towards a final event that questions the transience of people, and the permanence of place."}]}, "developer_name": "Displace Studio", "developer_privacy_policy_url": "http://psiconlab.co.uk/index.php?page=privacy", "developer_terms_of_service_url": null, "publisher_name": "Psicon Lab", "support_website_url": null, "website_url": "http://www.displace.org.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "834856591372301"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "838318157621360"}]}, "baseline_offer": {"id": "838318157621360"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1707517376, "status": "PUBLISHED", "id": "838318157621360"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6721190891318325", "version": "0.421"}, "id": "1003051450838033", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6071884079582346", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6721190891318325"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1003051450838033"}]}, "change_log": 
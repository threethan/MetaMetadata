.com&_nc_ss=7f20f&oh=00_AQJMQmKqGjuYEMIk1REZC8dWOHbz-0XsQjyY-gC7mZhoCg&oe=6AA9413A"}, {"file_name": "ss2.png", "id": "817599653798613", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982617_817599657131946_7039322749017576073_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsJHCyTJwy8Q7kNvwE0JHOu&_nc_oc=AdqD66vhl1lFzVKIchm6HzkKEww_d-xnPr-6xSfZ6Sf6JY7jZOs9bZU-3w_Jfcv0mjo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRuoB8S6GEG1FHk61u-RCVNH8dWXarqILV5UGLerVDTA&oe=6AA948C4"}, {"file_name": "ss4.png", "id": "2162652297452897", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031598_2162652300786230_8778869556395585163_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFXhZDJvgbEQ7kNvwHV_w5U&_nc_oc=Adoen954NcnX5QV79vxsXrA0kACmVKWtiVfQEovDk8TIwUiK6B2oDLvU814wWSZF7mY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyr4o-dEbHJVAnkwMIFBq0sCq629aKTG5OQXea39zW-g&oe=6AA9584A"}, {"file_name": "ss5.png", "id": "1694346024434955", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57569482_1694346027768288_7717847594022364549_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2kWTyfjrPQQ7kNvwEF-Ehy&_nc_oc=AdrI04lHc_vngjoXhxv2CLGc7hjZgrGlawbckge8eK2aaKQYroxxYY-_jSmlh3zMuvs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGUYTOB0YH_aF56HsjS_X9UeFulhNSyMPWprUYC2xBWw&oe=6AA94B64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "circlegame2trailer2024.png", "id": "1846661522504195", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57572931_1846661525837528_3101553261134444945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpRnsdgbk1MQ7kNvwFoKxDO&_nc_oc=AdreSDqf8dWDsk9GnkgFAqcB1tbsvZpCnnz60gofiGk3k9cV-X9PXHBuuh6eAzWFtaM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmFD30YVTLMfBmLglSLiJFljIx0rQHms1KbXOTb_WZWA&oe=6AA966E6"}, "display_name": "Circle Game 2", "keywords": [], "long_description": "In this universe of Circle Game, Circles have adapted to modern times. This means that the circles know how to make modern furniture, and have took a liking to a warm & cozy feel. If you're looking for a more action-filled experience, try out the PvP gamemode! Otherwise, if you're looking for a more relaxed and slow-paced experience, try the fishing gamemode. Take a look at what is new in this follow-up of Circle Game 1!\n\n", "short_description": "Circle game 2 is a game where you move with your hands and explore the homey-feeling environment. Immerse yourself in the warmness and coziness of a house-like setting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ca2dd836-b5de-4038-87fe-388a32831a65", "developer_terms_of_service_url": null, "publisher_name": "SwitcherBeats", "support_website_url": null, "website_url": "https://sites.google.com/view/circle-game-site/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25717409331239345"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001687_1435086560735896_4215784357122026092_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozD3BlqQZgYQ7kNvwFd3uj2&_nc_oc=Adr0LXNbTlgtqUu1b9FUcH7Q9pXgQw7sybWfeW73sDSH574oi2eOZdMVx3zTngV4MPU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAZjSDrTiS9qTTChaxiwVSy_AP4rKzJZKM7o-Pe624Gg&
.com&_nc_ss=7f20f&oh=00_Af_v0qhE-sTxy2UvA7-494MVEHvlHmOvCTnSkANl7Jj6Rw&oe=6A3931BA"}, {"file_name": "ss2.png", "id": "817599653798613", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982617_817599657131946_7039322749017576073_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gndvBLvNtZgQ7kNvwGoSWyZ&_nc_oc=Adrsdgq_sKC1fdNkGNfrUH_6ffRJPiSioaGBray1F7AUTjeNEaKQiPd2lCAjiFPY_70&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bGy0y2EbPSZl2g_m_-T11XffE1csuJ5TunJt634akKg&oe=6A393944"}, {"file_name": "ss4.png", "id": "2162652297452897", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031598_2162652300786230_8778869556395585163_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUePD-pAwQUQ7kNvwEZG5Bp&_nc_oc=AdrMEZc8y9SkZ8rRJkG4bChMkvsPRI_V8UHBm9DDmt53aSdAaieLW0NXq3eUI_3WHWM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9Cbk7EuOIfNe__QRqvOTlweFm3qpHnlqdZ2Q1N52a5Q&oe=6A3948CA"}, {"file_name": "ss5.png", "id": "1694346024434955", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57569482_1694346027768288_7717847594022364549_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IjlMdR6uogQ7kNvwFvh9oE&_nc_oc=AdpFHKcp70eAiIOmBNi8lR-RrADZlDmpHnomBvDUB5pAxzcl1egqP62G1moG7_plHQI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-y4fQ5qR4iY9q_1wuexCqwwwZODObUnD7Afi-6XNpYuA&oe=6A393BE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "circlegame2trailer2024.png", "id": "1846661522504195", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57572931_1846661525837528_3101553261134444945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gnscClYtMMQ7kNvwHuRL4g&_nc_oc=AdrhrIkv3rRcA4klczuRU5LOvlh1WpGOLrlzCaAcBh_CPIZfblPAsXK1XjJSS28RIhQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8s8LLh5Rb9zhvwSOEGavP19qzzaRgbU6pGLv2EY4FNdw&oe=6A395766"}, "display_name": "Circle Game 2", "keywords": [], "long_description": "In this universe of Circle Game, Circles have adapted to modern times. This means that the circles know how to make modern furniture, and have took a liking to a warm & cozy feel. If you're looking for a more action-filled experience, try out the PvP gamemode! Otherwise, if you're looking for a more relaxed and slow-paced experience, try the fishing gamemode. Take a look at what is new in this follow-up of Circle Game 1!\n\n", "short_description": "Circle game 2 is a game where you move with your hands and explore the homey-feeling environment. Immerse yourself in the warmness and coziness of a house-like setting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ca2dd836-b5de-4038-87fe-388a32831a65", "developer_terms_of_service_url": null, "publisher_name": "SwitcherBeats", "support_website_url": null, "website_url": "https://sites.google.com/view/circle-game-site/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25717409331239345"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001687_1435086560735896_4215784357122026092_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZM3q8YPys8Q7kNvwGeHw6D&_nc_oc=AdpEp6_kECp6a7yPWsD1BzKnEP3VCSmksBs6GKN7VwcrFTrMhIGn2J7U2OoEto1_9AI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jiA5sDdhd0SK-oioAxrRGsba9yZOZ5n0EiANwCUkzOg&
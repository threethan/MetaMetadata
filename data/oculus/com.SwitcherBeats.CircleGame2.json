.com&_nc_ss=7f20f&oh=00_Af-gubERRyfOoTXDbIVzuUVhbqP3lysCKigqBMFuSvbUFA&oe=6A368EBA"}, {"file_name": "ss2.png", "id": "817599653798613", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982617_817599657131946_7039322749017576073_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGexvzEARCMQ7kNvwGpIoI0&_nc_oc=AdqalhHGs80sd-cHzJ8Qlltt3IvcJuSaP0ahHQSH6t7cy26AMO5-orM7lY9Ay0vFzQA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j67a_0RRGdANCLa5oy7nu0qCeOhlHmrng_xJyNjaS6A&oe=6A369644"}, {"file_name": "ss4.png", "id": "2162652297452897", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031598_2162652300786230_8778869556395585163_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ljqhOqrmrAQ7kNvwEBsaut&_nc_oc=Adqwp_Sy3oaXsOIrIBK3Y3Drj-UlOv7BffFHfdb_0zOgJ29flWFxHQPmAytqYXsygIU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8i_05i2UkOs7SN6VXQxE-VXmRcw92OeXlE9KnQU13Snw&oe=6A36A5CA"}, {"file_name": "ss5.png", "id": "1694346024434955", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57569482_1694346027768288_7717847594022364549_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9rnhJIyIg4Q7kNvwFxwSTR&_nc_oc=AdqBUYiqhdj-Nu63LJqXjFsjZOCPUctthev6Ke3Z3XlpK6MoExwHRWBR3zc2H4pK_GA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WeeNDx_QxqOa0N5QstLhp7a-jpkr6bv9L8LBQiiEogA&oe=6A3698E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "circlegame2trailer2024.png", "id": "1846661522504195", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57572931_1846661525837528_3101553261134444945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTmubUaG-5gQ7kNvwHKd3GQ&_nc_oc=AdrC_rYkEbophEmAKeJNq5kofi_oqqPlVyXyy8Z8C1Ua5kOynqtBs4ld5TqQIm1Ucm0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_M3x_w3-6f12afdXBR2NLY2ky4EXcpITYf3HZOwDeyJg&oe=6A36B466"}, "display_name": "Circle Game 2", "keywords": [], "long_description": "In this universe of Circle Game, Circles have adapted to modern times. This means that the circles know how to make modern furniture, and have took a liking to a warm & cozy feel. If you're looking for a more action-filled experience, try out the PvP gamemode! Otherwise, if you're looking for a more relaxed and slow-paced experience, try the fishing gamemode. Take a look at what is new in this follow-up of Circle Game 1!\n\n", "short_description": "Circle game 2 is a game where you move with your hands and explore the homey-feeling environment. Immerse yourself in the warmness and coziness of a house-like setting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ca2dd836-b5de-4038-87fe-388a32831a65", "developer_terms_of_service_url": null, "publisher_name": "SwitcherBeats", "support_website_url": null, "website_url": "https://sites.google.com/view/circle-game-site/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25717409331239345"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001687_1435086560735896_4215784357122026092_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZM3q8YPys8Q7kNvwEutjTP&_nc_oc=AdoL6q35U3cG9ohEQU30NcG_-bWaPqd15K8KqV9DEvLxCeckU124RVO1rqrmpiZy1Ao&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GGbwZuzJQIM466J6T_vlYPc15Nr_s2wxMQd16BkL48Q&
.com&_nc_ss=7f20f&oh=00_Af9z4v_-VekzZsB5kT9iWoxEWUihtHCIZOIJhxEJiIEXCw&oe=6A4660BA"}, {"file_name": "ss2.png", "id": "817599653798613", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982617_817599657131946_7039322749017576073_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s49tI1-a9jsQ7kNvwGn9uz5&_nc_oc=Ado0jeQxguDwWwHKS53OGLCvKbkTOX9PnEwLLmSE4GaYRyeSgO2NFnd7ZBuer5bvoFY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AUYrUGcsdxvh023n2QEshkL9lXKEcKUnSZe39BqdlMg&oe=6A466844"}, {"file_name": "ss4.png", "id": "2162652297452897", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031598_2162652300786230_8778869556395585163_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qb46lfca7EoQ7kNvwFhOVnq&_nc_oc=Adp-3LJW5Uc-xPpLOJ4VYtUoUqcLcZDoZrQ3ejFG9Cc0GgLGbtuuwxg8-le1IjQxOaY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yu_55KBOlk7oov0QTt41lfwtyHULRzIcf8SBGqn1IEQ&oe=6A4677CA"}, {"file_name": "ss5.png", "id": "1694346024434955", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57569482_1694346027768288_7717847594022364549_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWriTds22e0Q7kNvwFuuohF&_nc_oc=AdoxI4S6pW9uq4oNyHSt7-FZy9G3e8LvQmkPfVDZkSZxZBmpbNT_a34zffd6omaN2VA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fAbQA0-yx-Vvl6H8_IUuYXwa9eEUujEp0Bdx1H3tfhA&oe=6A466AE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "circlegame2trailer2024.png", "id": "1846661522504195", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57572931_1846661525837528_3101553261134444945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2edGZa3dhuYQ7kNvwG2Q6oJ&_nc_oc=AdqF_x1c4QzMXn73MIAEQn6q6JSXVn0WHKvY5bBZ_OAS4LJljsAYIgVqhpFWMC7bVW8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rjP9YsRqaX2vIvspgeRjM-a2lVFibvWDiTtlD3Zo1Ew&oe=6A468666"}, "display_name": "Circle Game 2", "keywords": [], "long_description": "In this universe of Circle Game, Circles have adapted to modern times. This means that the circles know how to make modern furniture, and have took a liking to a warm & cozy feel. If you're looking for a more action-filled experience, try out the PvP gamemode! Otherwise, if you're looking for a more relaxed and slow-paced experience, try the fishing gamemode. Take a look at what is new in this follow-up of Circle Game 1!\n\n", "short_description": "Circle game 2 is a game where you move with your hands and explore the homey-feeling environment. Immerse yourself in the warmness and coziness of a house-like setting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ca2dd836-b5de-4038-87fe-388a32831a65", "developer_terms_of_service_url": null, "publisher_name": "SwitcherBeats", "support_website_url": null, "website_url": "https://sites.google.com/view/circle-game-site/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25717409331239345"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001687_1435086560735896_4215784357122026092_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naB-HpeKYhkQ7kNvwHaF9Au&_nc_oc=AdoOdeMQWh-t0vCGUisPi7BN8rRXy9Ok0Pl4svfG9rU96FN_6vd0-JVKcxO8m5YRYOM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZwdvznhjNKRrKHcNTWh1-dG0to703J7ifvhSXKnHTbw&
EQ7kNvwGUK-dB&_nc_oc=AdqyD6zvC21yyndPS-jU4-OGUhI8IAcCmZ_WEdsrqPlYDCyg-2uItlWBmfQfjcRb86Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWXdPumuxEAHjlJ9hHhr12vDDbYUQ9R3NLO8VY5bodCQ&oe=6AFC7566"}, "display_name": "Circle Game 2", "keywords": [], "long_description": "In this universe of Circle Game, Circles have adapted to modern times. This means that the circles know how to make modern furniture, and have took a liking to a warm & cozy feel. If you're looking for a more action-filled experience, try out the PvP gamemode! Otherwise, if you're looking for a more relaxed and slow-paced experience, try the fishing gamemode. Take a look at what is new in this follow-up of Circle Game 1!\n\n", "short_description": "Circle game 2 is a game where you move with your hands and explore the homey-feeling environment. Immerse yourself in the warmness and coziness of a house-like setting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ca2dd836-b5de-4038-87fe-388a32831a65", "developer_terms_of_service_url": null, "publisher_name": "SwitcherBeats", "support_website_url": null, "website_url": "https://sites.google.com/view/circle-game-site/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25717409331239345"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/390
.com&_nc_ss=7f20f&oh=00_AQIFUhSW1bPvr8AdAW4rHjv0LAYPzg_hF9LNmk9Lu_tXVg&oe=6AAE873A"}, {"file_name": "ss2.png", "id": "817599653798613", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982617_817599657131946_7039322749017576073_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crXCrMnVhQ0Q7kNvwE69Eaq&_nc_oc=AdqiRDNhKsI8RhnC3jmbeo4PUcewp3y82uA21l72D8scGCVuvg9Lm5n3yW_KWueYFEw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ259hB8qAOQrRVJKQZDwgJUxgsaH5IvfLx8hQlCLt8ww&oe=6AAE8EC4"}, {"file_name": "ss4.png", "id": "2162652297452897", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031598_2162652300786230_8778869556395585163_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxKYaqWq85EQ7kNvwGsEpJV&_nc_oc=Adq3d_OUUR0d805DIdmegFviozE61-iNk0BznN0tg4XxopoJf-wk06_mLtAHk4IhUPc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmHaUPLpiSOnSvO3FkBX7KwOkjRZ4l44GPpSOgAT0MGQ&oe=6AAE9E4A"}, {"file_name": "ss5.png", "id": "1694346024434955", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57569482_1694346027768288_7717847594022364549_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gluzlT2FHoQ7kNvwHcR1Gy&_nc_oc=Adp3PYwAl1ch8dxqQP2Eet7_FFeCv1he64lP_6_INZf8MINHocIldBUWA4Qit3YqP6w&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKP1_fXbWu3aP9qLSxCI155gOzbHVtJlUy4v8kIoQ-Pw&oe=6AAE9164"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "circlegame2trailer2024.png", "id": "1846661522504195", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57572931_1846661525837528_3101553261134444945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbQj_Tl0kKUQ7kNvwFr06Re&_nc_oc=Adri6tNfmXninJJPc63d00GBpD_azlgWb3AJV6fHZaBxrNRwAsouoHeo19EPh9zaaOE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInBeDfnXHuPwIc5cmgNsvKyNDUGnBy5B-DQzuhWXQemA&oe=6AAEACE6"}, "display_name": "Circle Game 2", "keywords": [], "long_description": "In this universe of Circle Game, Circles have adapted to modern times. This means that the circles know how to make modern furniture, and have took a liking to a warm & cozy feel. If you're looking for a more action-filled experience, try out the PvP gamemode! Otherwise, if you're looking for a more relaxed and slow-paced experience, try the fishing gamemode. Take a look at what is new in this follow-up of Circle Game 1!\n\n", "short_description": "Circle game 2 is a game where you move with your hands and explore the homey-feeling environment. Immerse yourself in the warmness and coziness of a house-like setting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ca2dd836-b5de-4038-87fe-388a32831a65", "developer_terms_of_service_url": null, "publisher_name": "SwitcherBeats", "support_website_url": null, "website_url": "https://sites.google.com/view/circle-game-site/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25717409331239345"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001687_1435086560735896_4215784357122026092_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eeVi1G8tM0UQ7kNvwH6dsO-&_nc_oc=Adp1DBkc0apxs4vH2ilt2yNA4bLGWfQUeSjyGG1u0tSZS3UQH1wNCTkOLeNmVdagk2w&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9Wk2RgB3r8vXIzPDYH19EH9HeqU4jrbSPOHFwdQuakg&
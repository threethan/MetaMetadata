.com&_nc_ss=7f20f&oh=00_AQGdMycsULzgWn_g6XJLhshBe8Bx0qLtcPiNQ45rKGEqpQ&oe=6A7DBFBA"}, {"file_name": "ss2.png", "id": "817599653798613", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982617_817599657131946_7039322749017576073_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6M3yozwpLfIQ7kNvwE9qJQk&_nc_oc=Ado30RdtckSKYdizolmyOCkXVaAYwYyGjNyp2ktSbjiTzxQpMpqfPYSaraNpbLslrkc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1H-jguZDb5BRBIiumeJ_2xMWSI0aAwqS8BhYPn96bBw&oe=6A7DC744"}, {"file_name": "ss4.png", "id": "2162652297452897", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031598_2162652300786230_8778869556395585163_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8lIF-KE-wcQ7kNvwEuXhl2&_nc_oc=AdouvhnvVrZfUMOjlC8RZ4jpKmgJAotMtwwY7FzODtf_7U0tgwfg265ClIhvsM2YgmU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXGajNYZDHfqBfh8byA5WBZKszRGyA-qvB0WfuoXFkyA&oe=6A7D9E8A"}, {"file_name": "ss5.png", "id": "1694346024434955", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57569482_1694346027768288_7717847594022364549_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSUU9kY3EZAQ7kNvwF3rpsU&_nc_oc=AdpwHpPlhsOkrUG30NYB5L7IFAFoI1AWgCRdho25edxsGTQc_zxchFBZEplxOXGcNIw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIU1-xa44DwjBVhyYR2uAyHRoY6Kf1YPrahcoR0bH66Q&oe=6A7DC9E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "circlegame2trailer2024.png", "id": "1846661522504195", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57572931_1846661525837528_3101553261134444945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBweibDybvAQ7kNvwFmAKwr&_nc_oc=AdpBSU_G9AxRpxPUCByHhQsU6_hII9GFDvtSKXjDBqebA7gbbsWycqVetxl_tKGlXdQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFr4BzpbLCK29b3jDtxZEVulJP9VIdbNcLjr-p4bVp1aA&oe=6A7DAD26"}, "display_name": "Circle Game 2", "keywords": [], "long_description": "In this universe of Circle Game, Circles have adapted to modern times. This means that the circles know how to make modern furniture, and have took a liking to a warm & cozy feel. If you're looking for a more action-filled experience, try out the PvP gamemode! Otherwise, if you're looking for a more relaxed and slow-paced experience, try the fishing gamemode. Take a look at what is new in this follow-up of Circle Game 1!\n\n", "short_description": "Circle game 2 is a game where you move with your hands and explore the homey-feeling environment. Immerse yourself in the warmness and coziness of a house-like setting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ca2dd836-b5de-4038-87fe-388a32831a65", "developer_terms_of_service_url": null, "publisher_name": "SwitcherBeats", "support_website_url": null, "website_url": "https://sites.google.com/view/circle-game-site/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25717409331239345"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001687_1435086560735896_4215784357122026092_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCzLtbgMWx8Q7kNvwH6rNl2&_nc_oc=Ado16mFLvui2AtZXady8IM-I5yucSAUzXjw7MVe-v49ODFdkZYQz0GXUTqZACAcXRo4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgKE8hkqiVEbt822RPAM3RGRefEXbIckSJeIZoI-8zkA&
.com&_nc_ss=7f20f&oh=00_Af9sPVsKsNsRG2e-Rz1G3cnRaUDgK6chH-7yXwb9OcuUsw&oe=6A23007A"}, {"file_name": "ss2.png", "id": "817599653798613", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982617_817599657131946_7039322749017576073_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJmIzeKcdCcQ7kNvwFCIuQZ&_nc_oc=AdrdRMfMgvKsf97kNafWM5QUSb7ykt_zP29a9w7SizX0M3wbvnyh8glT-Yz8oGCUMQs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iBhN_A5QIMEKrbJsqRyoaNMwhmeS5rGY8k8ORHanrMg&oe=6A22CFC4"}, {"file_name": "ss4.png", "id": "2162652297452897", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031598_2162652300786230_8778869556395585163_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPJIQSjNUi0Q7kNvwHixWgX&_nc_oc=AdrWH3fwrfrZ0Q7et6tvpWWx7zY1wJfScayTAcSsLayV63VLlEDBiD1yH9VLDOXJB9Q&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OsgRmuYqNeRM91QZyc3M_Durw5UrrAAIhpGza30nVcw&oe=6A22DF4A"}, {"file_name": "ss5.png", "id": "1694346024434955", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57569482_1694346027768288_7717847594022364549_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6loy3BsebU4Q7kNvwH9CkZl&_nc_oc=AdoLX8eKtnzeDmwHLHhoo6FnPADlvgRQdyLcDPnpdRSYqzNCojCcJyrQuLvpZu7CPF0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GIm-ry6_-7rlzbkMVjmY6Ot7C6LQxTcGPY4AAyuyKwg&oe=6A22D264"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "circlegame2trailer2024.png", "id": "1846661522504195", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57572931_1846661525837528_3101553261134444945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHGNfCJ6JpcQ7kNvwFZzRkz&_nc_oc=AdqJDmZOZjJzpdF7BfCZS380o4kKqd-SoVZSBlNL1rq_440Pg1Mux6U1I9NVyVNKfEA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RFKVOAEUA7zGjyUJsrM8uLRp1UPkIFamL9QiKSjV58w&oe=6A22EDE6"}, "display_name": "Circle Game 2", "keywords": [], "long_description": "In this universe of Circle Game, Circles have adapted to modern times. This means that the circles know how to make modern furniture, and have took a liking to a warm & cozy feel. If you're looking for a more action-filled experience, try out the PvP gamemode! Otherwise, if you're looking for a more relaxed and slow-paced experience, try the fishing gamemode. Take a look at what is new in this follow-up of Circle Game 1!\n\n", "short_description": "Circle game 2 is a game where you move with your hands and explore the homey-feeling environment. Immerse yourself in the warmness and coziness of a house-like setting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ca2dd836-b5de-4038-87fe-388a32831a65", "developer_terms_of_service_url": null, "publisher_name": "SwitcherBeats", "support_website_url": null, "website_url": "https://sites.google.com/view/circle-game-site/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25717409331239345"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001687_1435086560735896_4215784357122026092_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YuwZ-o9Kq8Q7kNvwEG3-ED&_nc_oc=Ado5B0JAIF4Fc0Ma6ZlYpE0M6W9YSi0xo8b-nLtlTdoqhhyCZM5MBh56xkx-rlT0BLI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0iMICLq5kHfwDXGAQ2IZeBwnAGbH7jKtw0gSYhUOsBA&
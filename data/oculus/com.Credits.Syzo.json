1643995756816815", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499303445_1643995760150148_7569760103024876194_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Sb7D_Zi7NUQ7kNvwED_pb7&_nc_oc=AdppI-eGHSXlxDuJyDfuH8cqN_uYYrOx0oPCSPoRfFcSBb26C8WYfVZtDaOs_kWX3i0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIGh2FFp3EZ8ZfhCtGxguPORgBqOmmxeZhfo9fY8nmCA&oe=6AA00B58"}, {"file_name": "screenshot4.png", "id": "951056357753504", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499296125_951056361086837_545173859022719862_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhIGtSNeCQkQ7kNvwGp-Ule&_nc_oc=AdpMcuBQfLLv4odARDg3bV-gRA5qh5ZTvJ6eXYd-mueRjjXBuMsTXn76kGB5_cZZlA8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuIqBseIRwv1Pr0f1yGHiG08RYOYZ1vxZKTNOFOowlpw&oe=6A9FFE74"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Rift", "keywords": [], "long_description": "Project Rift is a game that people who like the game Gorilla Tag will enjoy. It has a way of moving around where you use your arms to run and jump and climb. This game is not a copy of Gorilla Tag. It is a project made by people who love the original game and the people who play it.\n\nWe do not work with the people who made Gorilla Tag. We just like the way you can move around in that game and we want to give people a place to play like that. You can play Project Rift for free. You do not have to pay anything. It is easy to start playing.\n\nWe are a group of people who are very excited, about this project. We have a community of people who like the game. We want you to join us. You can join our Discord group to talk to us and other people who like the game. We want to hear what you think. We want to make the game better. We are looking for people to help us make Project Rift a great game.\n\nProject Rift is made by people who like Gorilla Tag for people who like Gorilla Tag. We are happy to have you play our game.", "short_description": "Project Rift is a game that people who like the game made. It is a virtual reality game that uses a way of moving that is similar, to Gorilla Tag. The people who made Project Rift were inspired by the game but Project Rift is not a copy of the original game. Project Rift is its thing, a special project made by fans who love the way you can move around in the original game. They just wanted to make something fun to celebrate the way you move in Project Rift and the original game."}]}, "developer_name": "Freddy", "developer_privacy_policy_url": "https://sites.google.com/view/project-rift-web/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Freddy", "support_website_url": null, "website_url": "https://sites.google.com/view/project-rift-web", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27146073241696155"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28202580499378752", "version": "6.2.2"}, "id": "1300895864907624", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application":
t all the deets, right here. \ud83d\udc47**\n# https://discord.gg/w6jsT6XGg8\n\n\n{1383249956571522}\nMove like a superhero!\n{1901041300815782}\nBreak everything!\n{1571769843829854}\nGotta catch them all!\n{2394970080947160}\nLet\u2019s mess things up!\n{1471876660556777}\nJoin our Discord, and we need your input to decide which new mode we should make for the next update!\n# https://discord.gg/w6jsT6XGg8", "short_description": "Select your stylish Bots and arm them with wild weapons. Embrace the chaos and endless creativity in this fast-paced, all-over-the-place VR brawler. This is the most fun you\u2019re gonna have in a headset!\nPick your Bots, blast a friend!\nGet all the deets, right here. \ud83d\udc47\nhttps://discord.gg/w6jsT6XGg8"}]}, "developer_name": "MingStudio", "developer_privacy_policy_url": "https://www.mingkstudio.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "MingStudio", "support_website_url": null, "website_url": "https://www.mingkstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "34988270980786830"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499308045_1616372492936381_8372908367064266704_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
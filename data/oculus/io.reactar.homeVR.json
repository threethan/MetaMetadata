Ee9Hu9tyDoAM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RyqyJlLGWa_8lIQSZ6GdZ0U-BxisRR1eLl8S2QZob_w&oe=6A11BFA7"}, "display_name": "homeAR Virtual (beta)", "keywords": [], "long_description": "homeAR Virtual lets you see and experience your new home, before it's been built. Giving you the confidence you need to make decisions and create the home of your dreams.\n\nBuilding a new home should be one of the most exciting and rewarding experiences of your life. Yet the process can often seem overwhelming and the risk of the unknown can create stress and indecision. Experience new home design options and their layout like they're already built, giving you a unique understanding of layout, aspect, and flow.", "short_description": "Explore your dream home. Before a brick is laid."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.homear.io/privacy", "developer_terms_of_service_url": "https://www.homear.io/terms-of-use", "publisher_name": "Reactar Labs", "support_website_url": null, "website_url": "https://homear.io/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED", "genres": ["UTILITY", "NEWS_AND_INFORMATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "682675596420335"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035343_946121769467256_4492177347408008923_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc
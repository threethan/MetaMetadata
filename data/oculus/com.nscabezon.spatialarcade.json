TwXG_KtV-SMUDi5BvYs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvjAR6OP6rTiFSpnybMk3E1aZHHjDjkXDe_Nt0hXSVLw&oe=6B08653B"}, {"file_name": "4-crt-filter-controls.png", "id": "1480483760621521", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/604385997_1480483763954854_7784529683559253381_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxYAqLEgwZcQ7kNvwFAKsKv&_nc_oc=AdpppEYcslwtEkBQV5E3vdqKfieV6Om3pjO4tP_L0-yPQxh6S9D2-Xv4P-LnVImXsYE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMusDYKMZUgtVDkNPblLrZ30t8BN77zw3sKElIz9nQOA&oe=6B0848D3"}, {"file_name": "5-how-to-play.png", "id": "2120178878593196", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/673536876_2120178881926529_6565629817379292093_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7whZD-E5fIQ7kNvwG73dvX&_nc_oc=AdpF5-BCrLD8X7pZdS6Qdc0LZz9K9e5XYmOtdK5hoDQf29JX8ir55KKj2Jx63PjlOcE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfKZsQqui4qg6aXvNgrpOHZLKSFStH31N9MEfu62cwDA&oe=6B085177"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2560x1440.png", "id": "4424269247811254", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/814574569_4424269254477920_8207262051428501575_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dejeje2tfycQ7kNvwEkZtdt&_nc_oc=Adp4A8meECdI3keX88B-OA7MKLS5rqCo4ITkd-GSJ7PxCHXIaRdko1HkdBMZreN348E&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJwOEVL4mJiamtZOq1c4JQ13xi25M_H6R6P3jPXnCLAg&oe=6B085C88"}, "display_name": "Spatial Arcade", "keywords": ["arcade", "disparos", "retro", "shooter", "pistola"], "long_description": "Spatial Arcade convierte tu visor en un arcade de pistola de luz. Una pantalla curva de tama\u00f1o cine flota en una sala oscura frente a ti, y tus mandos Touch son las pistolas: apunta, aprieta el gatillo y siente cada disparo.\n\nIncluye Target Range, una galer\u00eda de tiro original creada para Spatial Arcade: dispara a las dianas, perdona a las caras sonrientes y abate a los robots antes de que su anillo se cierre. Recarga apuntando fuera de la pantalla y disparando.\n\nSpatial Arcade tambi\u00e9n reproduce algunos juegos de pistola de luz de los arcades de los a\u00f1os 90 que ya tienes: a\u00f1ade tus propios ficheros con el selector de archivos del visor. No se incluye ni se vende ning\u00fan otro juego en la app.\n\n- Una pantalla curva que puedes redimensionar, de un televisor a una pared de cine.\n- Filtros de imagen: pixeles nitidos, realzado, suave o lineas CRT.\n- 3D estereo real en los juegos dibujados en 3D.\n- Juega online con un amigo usando un codigo de 8 cifras, tambien con Apple Vision Pro. Sin cuentas, sin chat, sin salas publicas.\n- O jugad juntos en la misma Wi-Fi.\n\nSpatial Arcade no esta afiliado a ningun fabricante de arcades.", "short_description": "Arcade de pistola de luz en una pantalla curva gigante, con Target Range incluido."}, {"images": {"nodes": [{"file_name": "icon-spatial-foreground-512.png", "id": "2327031154714607", "image_type": "APP_IMG_ICON_FOREGROUND_512", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/604347072_2327031158047940_455948332943900465_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTgRDtp_qOcQ7kNvwFzsznJ&_nc_oc=Adrt9ASZa-uuorFGj8e4UFQw_LD8dHfPHABye_5LH9Q8tDEhJmJVi7NHWT72KM3xiRw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwiCfRallSJFer-6v1rm1RzL9F9Ru36rc0RwtnO3z4dg&oe=6B085C35"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1713266720357540", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831299_1713266723690873_4279047128923347970_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gui1brCy8loQ7kNvwETcTNR&_nc_oc=Adrks3Mwj860jky8JQUi83h_pWyGShKLBxKKrOHSaF1wlUb5ge4cVOjMfqVcmOr55FQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oc
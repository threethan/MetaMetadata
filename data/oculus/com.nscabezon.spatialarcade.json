uXUbiZtzFI1N4Xf11R8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-vIavr8toyw9Jp7jtHNV8_6Rjqw2zjIcy1eyJtSrDhg&oe=6AFC87BB"}, {"file_name": "4-crt-filter-controls.png", "id": "1480483760621521", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604385997_1480483763954854_7784529683559253381_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWw5webAMT4Q7kNvwHANpKv&_nc_oc=Adq_ELFNMeckTQxEKXzvNpUjNHkkw78hhns7u5D8neSUymZ3buq6vFZgaYiEWZbTtUM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR93OTBVOZXAJrWCOZdDdq_4VlMeNgc8SrakLSUNUYWVw&oe=6AFC6B53"}, {"file_name": "5-how-to-play.png", "id": "2120178878593196", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673536876_2120178881926529_6565629817379292093_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ypxb6Oit98Q7kNvwHSO4DE&_nc_oc=AdrHB2v-9aYdOBpGsxtEs-gz7wLX09HZe4NdKryWoUPC4SdEBl-jw7SX9GTm1S8a32s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjeWVrZceJsGY9rApVLW4EXO9L6D6-sXlI0G05_xYuNg&oe=6AFC73F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2560x1440.png", "id": "4424269247811254", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/814574569_4424269254477920_8207262051428501575_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9iXVbdiqRYQ7kNvwGmZvNN&_nc_oc=Adpgl7RkMDnfiULNoiL0i4aviP00jp5jj2-uo05twBmNUjo6fVJxnXQoDm4gx-X3mJo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5w-T6DhIx2lwom5cMJFWA8my0MWHdBVIkXHJ-cHnhRw&oe=6AFC7F08"}, "display_name": "Spatial Arcade", "keywords": ["arcade", "disparos", "retro", "shooter", "pistola"], "long_description": "Spatial Arcade convierte tu visor en un arcade de pistola de luz. Una pantalla curva de tama\u00f1o cine flota en una sala oscura frente a ti, y tus mandos Touch son las pistolas: apunta, aprieta el gatillo y siente cada disparo.\n\nIncluye Target Range, una galer\u00eda de tiro original creada para Spatial Arcade: dispara a las dianas, perdona a las caras sonrientes y abate a los robots antes de que su anillo se cierre. Recarga apuntando fuera de la pantalla y disparando.\n\nSpatial Arcade tambi\u00e9n reproduce algunos juegos de pistola de luz de los arcades de los a\u00f1os 90 que ya tienes: a\u00f1ade tus propios ficheros con el selector de archivos del visor. No se incluye ni se vende ning\u00fan otro juego en la app.\n\n- Una pantalla curva que puedes redimensionar, de un televisor a una pared de cine.\n- Filtros de imagen: pixeles nitidos, realzado, suave o lineas CRT.\n- 3D estereo real en los juegos dibujados en 3D.\n- Juega online con un amigo usando un codigo de 8 cifras, tambien con Apple Vision Pro. Sin cuentas, sin chat, sin salas publicas.\n- O jugad juntos en la misma Wi-Fi.\n\nSpatial Arcade no esta afiliado a ningun fabricante de arcades.", "short_description": "Arcade de pistola de luz en una pantalla curva gigante, con Target Range incluido."}, {"images": {"nodes": [{"file_name": "icon-spatial-foreground-512.png", "id": "2327031154714607", "image_type": "APP_IMG_ICON_FOREGROUND_512", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604347072_2327031158047940_455948332943900465_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjcdL3CEcBUQ7kNvwGBLDQk&_nc_oc=AdoAuConehktFsqagBdAaMPhqtlLZuciQNaVUaFsIKk9laCPziqJe6g12bjwfXYhDuk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3hAU7xzukNSM4w2rIJMffGWzL7UO5J-4Vs-VpTccC1A&oe=6AFC7EB5"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1713266720357540", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831299_1713266723690873_4279047128923347970_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naZZhoeaURAQ7kNvwFHFAri&_nc_oc=AdrumSOhAfensbLwLzFOt8nfLuhk1N2-zs7TBankir5ZLUllFB9UCjK1Rj0VPnApNAg&_nc_zt=3&_nc_ht=scontent-sea5-1.oc
cdn.com/v/t64.5771-25/596168449_2856204704780790_2619764427727915752_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3S3AL7Yi9NUQ7kNvwF89kZz&_nc_oc=Ado3uEp05viM7ILMTJ1lfemEfHrDZQrqfkevruHkfcHrN0U74dk9a_fHUe3VnDU-Pvw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMT7sBKdaqsmhWPkroBlZJiqAPvkvXBavotIuekk9yqQ&oe=6AF9BCBD"}, {"file_name": "4-crt-filter-controls.png", "id": "2401836067229983", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/673536876_2401836070563316_5122569000704133710_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QYpers2or4Q7kNvwHzEM9a&_nc_oc=AdpLBNx4gEJh-gkYRe1IzUbtildH714KkcdVXwFPy8JShh6tPkMkvkJzytwXmYazD_Y&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjG2s832qE2SHC8-5THYgbMf_Gmj1udnaDufrinjp4pA&oe=6AF9BD23"}, {"file_name": "5-how-to-play.png", "id": "2374982463262750", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830822_2374982466596083_2473409550955138653_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHmoThwtHxgQ7kNvwEKyPh2&_nc_oc=Adpq65SkZ_qNAnSe42poTTOorMj0tYdV6U7cTD9-0bPNCuBA9MLKY4VRoNkPHC3EDh8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkGdMjO9XOcM-ipcoDsc6fTY3gnhIpJfOx7TNHDK39qA&oe=6AF9C61D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2560x1440.png", "id": "1150324694332972", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830441_1150324697666305_2207271218552200338_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfIfl9oqGOkQ7kNvwFbwXc9&_nc_oc=Adraxe3_vHpyF90KTLCzUNTOTsL7IQN7TdP_LtvNJzZVzxcbGQ-ARA-zp1hbLJ7BXz4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ535XDk2cLDiGds2KDQa1TNRF2HUAfMqD4IdMWL7Td3A&oe=6AF9DAE1"}, "display_name": "Spatial Arcade", "keywords": ["arcade", "shooting", "retro", "shooter", "lightgun"], "long_description": "Spatial Arcade turns your headset into a light-gun arcade. A cinema-sized curved screen floats in a dark room in front of you, and your Touch controllers are the guns: aim, pull the trigger and feel every shot.\n\nIncludes Target Range, an original shooting gallery made for Spatial Arcade: shoot the targets, spare the smiley faces and take down the robots before their ring closes. Reload by aiming off the screen and firing.\n\nSpatial Arcade also plays some 1990s arcade light-gun games that you already own: add your own game files with the headset's file picker. No other games are included or sold in the app.\n\n- A curved screen you can resize, from a TV to a cinema wall.\n- Picture filters: sharp pixels, sharpened, smooth or CRT scanlines.\n- Real stereo 3D in games drawn in 3D.\n- Play online with a friend using an 8-digit code, also with Apple Vision Pro. No accounts, no chat, no public lobbies.\n- Or play together on the same Wi-Fi.\n\nSpatial Arcade is not affiliated with any arcade manufacturer.", "short_description": "Light-gun arcade on a giant curved screen, with Target Range included."}]}, "developer_name": "Iv\u00e1n Cabez\u00f3n Orjales", "developer_privacy_policy_url": "https://spatialarcade.app/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Iv\u00e1n Cabez\u00f3n Orjales", "support_website_url": "https://spatialarcade.app/support/", "website_url": "https://spatialarcade.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_U
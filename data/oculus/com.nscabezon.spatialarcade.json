40cGzWimGw-4VKc-IE4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGmVTTmg12a5XoXp__Bc7U0HLQy8lwSVUf837dsw_ESQ&oe=6AFF2ABB"}, {"file_name": "4-crt-filter-controls.png", "id": "1480483760621521", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604385997_1480483763954854_7784529683559253381_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDMb0uTw4qYQ7kNvwGLyWsp&_nc_oc=AdrfcGa4iAzwcppJowW7e_u_SZXRP-G8g0aYyPROz-z8Xu4V6oFXRd6K9fmal69JEk4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLgxVnkInIesmydt9R_RwP3y8wXWUUxlm6grPSCuuUNw&oe=6AFF0E53"}, {"file_name": "5-how-to-play.png", "id": "2120178878593196", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673536876_2120178881926529_6565629817379292093_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pj3Sa_EkyF4Q7kNvwEycbVa&_nc_oc=AdorWO9l52jUOVepYpiI6m_x1s8ODaxI2vwFccijU-rmO4CUKVnXYMYvPTlNjYw55ag&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT82ow0ur8WJMBhHlaZOi_wIe0Fb7qQBDpq1-oYjeyGng&oe=6AFF16F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2560x1440.png", "id": "4424269247811254", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/814574569_4424269254477920_8207262051428501575_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=see8e73gkvwQ7kNvwEGqR13&_nc_oc=AdqVbv9v_bu6kMSCN4mHwPUfM7Xw8ARZPFHLUbXLZs3rFNHePWiybXixW1LiEjei190&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJXCNzZGsbvy-_A263VK7IYnqBKRVXwY9M7oHhx5XSSw&oe=6AFF2208"}, "display_name": "Spatial Arcade", "keywords": ["arcade", "disparos", "retro", "shooter", "pistola"], "long_description": "Spatial Arcade convierte tu visor en un arcade de pistola de luz. Una pantalla curva de tama\u00f1o cine flota en una sala oscura frente a ti, y tus mandos Touch son las pistolas: apunta, aprieta el gatillo y siente cada disparo.\n\nIncluye Target Range, una galer\u00eda de tiro original creada para Spatial Arcade: dispara a las dianas, perdona a las caras sonrientes y abate a los robots antes de que su anillo se cierre. Recarga apuntando fuera de la pantalla y disparando.\n\nSpatial Arcade tambi\u00e9n reproduce algunos juegos de pistola de luz de los arcades de los a\u00f1os 90 que ya tienes: a\u00f1ade tus propios ficheros con el selector de archivos del visor. No se incluye ni se vende ning\u00fan otro juego en la app.\n\n- Una pantalla curva que puedes redimensionar, de un televisor a una pared de cine.\n- Filtros de imagen: pixeles nitidos, realzado, suave o lineas CRT.\n- 3D estereo real en los juegos dibujados en 3D.\n- Juega online con un amigo usando un codigo de 8 cifras, tambien con Apple Vision Pro. Sin cuentas, sin chat, sin salas publicas.\n- O jugad juntos en la misma Wi-Fi.\n\nSpatial Arcade no esta afiliado a ningun fabricante de arcades.", "short_description": "Arcade de pistola de luz en una pantalla curva gigante, con Target Range incluido."}, {"images": {"nodes": [{"file_name": "icon-spatial-foreground-512.png", "id": "2327031154714607", "image_type": "APP_IMG_ICON_FOREGROUND_512", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604347072_2327031158047940_455948332943900465_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYnMAhum6yMQ7kNvwHd1PG0&_nc_oc=AdqQw8sG2wsukkRd8fIcFbF8mLmAIqnPsjeIpmcafaHhOWjb2l6d78nXtbB5Qq4Gxt8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHY5h4n0hI1B6AKaC_WNUjYYkhK9FqaV_gMWsYr5AISA&oe=6AFF21B5"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1713266720357540", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831299_1713266723690873_4279047128923347970_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSwWLx7NGzkQ7kNvwEFDRQT&_nc_oc=AdosjrSUkbzrS_PHMuN-HDVwybIJ2tzobZvO9VWS_7pQe2hp05KPvakD-XxpAiRORI4&_nc_zt=3&_nc_ht=scontent-sea5-1.oc
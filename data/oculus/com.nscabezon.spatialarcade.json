OKkSLF_N0FsKDKudQF0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNBs96rZbgzJcnCgP-qLiuXiZSeyz5J5hYygFd6reapQ&oe=6B09B6BB"}, {"file_name": "4-crt-filter-controls.png", "id": "1480483760621521", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604385997_1480483763954854_7784529683559253381_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxYAqLEgwZcQ7kNvwFHH0Hc&_nc_oc=Adr1sCxmpemNev87SK_io6vDijBznv8xkw4B1QZVqqVKIhpGjztVjo-JwACm9FzmMoY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRc1GdBEXGES4ebsrCBUP2rMxCPPFWqE21Jy2GqUNihQA&oe=6B09D293"}, {"file_name": "5-how-to-play.png", "id": "2120178878593196", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673536876_2120178881926529_6565629817379292093_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7whZD-E5fIQ7kNvwEeae8r&_nc_oc=AdpAxhc9iQI1qJgfIYvKGdb6zfuINXpTYB1i1J93KkfTJoqFGAZDGbNYNqggL7WKHis&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtAN-HN3yv851fk9AXsYG4eX1qGCqZDHe8Uc4lgj55ZQ&oe=6B09A2F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2560x1440.png", "id": "4424269247811254", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/814574569_4424269254477920_8207262051428501575_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dejeje2tfycQ7kNvwFFS-hj&_nc_oc=AdrFo_2qNp1efSAUM5Gb7NWF33HswZ5EppIq5grXW1QEvOOy7IomH7h6pdcnSJOI2-E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwRO9uBfeU5H_NeroPIoIfm29ggibkxT8FLJlioWoKyQ&oe=6B09AE08"}, "display_name": "Spatial Arcade", "keywords": ["arcade", "disparos", "retro", "shooter", "pistola"], "long_description": "Spatial Arcade convierte tu visor en un arcade de pistola de luz. Una pantalla curva de tama\u00f1o cine flota en una sala oscura frente a ti, y tus mandos Touch son las pistolas: apunta, aprieta el gatillo y siente cada disparo.\n\nIncluye Target Range, una galer\u00eda de tiro original creada para Spatial Arcade: dispara a las dianas, perdona a las caras sonrientes y abate a los robots antes de que su anillo se cierre. Recarga apuntando fuera de la pantalla y disparando.\n\nSpatial Arcade tambi\u00e9n reproduce algunos juegos de pistola de luz de los arcades de los a\u00f1os 90 que ya tienes: a\u00f1ade tus propios ficheros con el selector de archivos del visor. No se incluye ni se vende ning\u00fan otro juego en la app.\n\n- Una pantalla curva que puedes redimensionar, de un televisor a una pared de cine.\n- Filtros de imagen: pixeles nitidos, realzado, suave o lineas CRT.\n- 3D estereo real en los juegos dibujados en 3D.\n- Juega online con un amigo usando un codigo de 8 cifras, tambien con Apple Vision Pro. Sin cuentas, sin chat, sin salas publicas.\n- O jugad juntos en la misma Wi-Fi.\n\nSpatial Arcade no esta afiliado a ningun fabricante de arcades.", "short_description": "Arcade de pistola de luz en una pantalla curva gigante, con Target Range incluido."}, {"images": {"nodes": [{"file_name": "icon-spatial-foreground-512.png", "id": "2327031154714607", "image_type": "APP_IMG_ICON_FOREGROUND_512", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604347072_2327031158047940_455948332943900465_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGz7BoaWpcMQ7kNvwGUQxCT&_nc_oc=Adr5zSt1LwUzHmjPXg5ImTHt_WL7St2QpjfjprR9d_-kyPWJSuX3yJ2Uf3SG2i03VgY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZKW0AVuIgjACssNI28o7qfv2XhHN6Ft-5RjHlzzVGQQ&oe=6B09ADB5"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1713266720357540", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831299_1713266723690873_4279047128923347970_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQKob4okeioQ7kNvwHq-FpD&_nc_oc=AdoFHzuJx4a8EUGyZo74BOTJc8HQleYWy76fncgq0WI9PNGNKxdlWFxXW463iO2beEU&_nc_zt=3&_nc_ht=scontent-sea5-1.oc
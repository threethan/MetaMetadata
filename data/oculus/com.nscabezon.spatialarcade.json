eeMyn2B-4Fbpkymvh6w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJDTcGvULiukxxw2zgb2kLyFUON2zWJFvqXEq-zcvr4Q&oe=6AFB363B"}, {"file_name": "4-crt-filter-controls.png", "id": "1480483760621521", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/604385997_1480483763954854_7784529683559253381_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWw5webAMT4Q7kNvwEYdobe&_nc_oc=AdrT9zQj63_fGZlpU5SAz0pWfWwheHKiz6t2ynQcSMxnUckW-x46wBvLWY2NTkUVbTI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2PsXyv2H0i6b5egrwQSRJeTjj_HZBMzylSr9zsSqwNg&oe=6AFB19D3"}, {"file_name": "5-how-to-play.png", "id": "2120178878593196", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/673536876_2120178881926529_6565629817379292093_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ypxb6Oit98Q7kNvwFz0O_P&_nc_oc=AdpveWuhubDgG4TcO559opfcjh0vaFkzmx5WHW5HDwRZLwVgJWY8GshX4JsaavQgiXE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-Tu2T4YF5Gim0zG4sdiUCpMKnC8AKp1pT1wLTdqhJpA&oe=6AFB2277"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2560x1440.png", "id": "4424269247811254", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/814574569_4424269254477920_8207262051428501575_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9iXVbdiqRYQ7kNvwFfbGLM&_nc_oc=AdqnZCvy5yRHVMaAdtZpUBjDqsL3xItRqD7rI5jQQF-PeqgsPwF9K5C-ZUpqXjJSl4I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFwED7-ceUBXNsUO2l7OtLw2lOf0yWUayHrpXzqgoE-Q&oe=6AFB2D88"}, "display_name": "Spatial Arcade", "keywords": ["arcade", "disparos", "retro", "shooter", "pistola"], "long_description": "Spatial Arcade convierte tu visor en un arcade de pistola de luz. Una pantalla curva de tama\u00f1o cine flota en una sala oscura frente a ti, y tus mandos Touch son las pistolas: apunta, aprieta el gatillo y siente cada disparo.\n\nIncluye Target Range, una galer\u00eda de tiro original creada para Spatial Arcade: dispara a las dianas, perdona a las caras sonrientes y abate a los robots antes de que su anillo se cierre. Recarga apuntando fuera de la pantalla y disparando.\n\nSpatial Arcade tambi\u00e9n reproduce algunos juegos de pistola de luz de los arcades de los a\u00f1os 90 que ya tienes: a\u00f1ade tus propios ficheros con el selector de archivos del visor. No se incluye ni se vende ning\u00fan otro juego en la app.\n\n- Una pantalla curva que puedes redimensionar, de un televisor a una pared de cine.\n- Filtros de imagen: pixeles nitidos, realzado, suave o lineas CRT.\n- 3D estereo real en los juegos dibujados en 3D.\n- Juega online con un amigo usando un codigo de 8 cifras, tambien con Apple Vision Pro. Sin cuentas, sin chat, sin salas publicas.\n- O jugad juntos en la misma Wi-Fi.\n\nSpatial Arcade no esta afiliado a ningun fabricante de arcades.", "short_description": "Arcade de pistola de luz en una pantalla curva gigante, con Target Range incluido."}, {"images": {"nodes": [{"file_name": "icon-spatial-foreground-512.png", "id": "2327031154714607", "image_type": "APP_IMG_ICON_FOREGROUND_512", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/604347072_2327031158047940_455948332943900465_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjcdL3CEcBUQ7kNvwH3cS1O&_nc_oc=Adr24w2FepKSp00YsqlavmVfTjmZQJPJDKu0y9phCAv5yejUxqHAP5N2ODELcmUZcXI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVJVJ7WShKQSjAqwVasFJGsQzg3WQKHejyLv3bRv1Hig&oe=6AFB2D35"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1713266720357540", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491831299_1713266723690873_4279047128923347970_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naZZhoeaURAQ7kNvwFFslts&_nc_oc=AdqyJTsrS_v8EvBB07vTVMBkVuEe0X2oPfAgtESU1NPCjLjLtn3vnmvUbYBatB8NqQw&_nc_zt=3&_nc_ht=scontent-lga3-3.oc
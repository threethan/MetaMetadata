RJCqQXfOHgj9jwzMW5g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1hn6LT2Ltw0yeFJjZhsYDc1zOLox-_1-jhL0Go2gpFA&oe=6B007C3B"}, {"file_name": "4-crt-filter-controls.png", "id": "1480483760621521", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604385997_1480483763954854_7784529683559253381_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDMb0uTw4qYQ7kNvwFT7hjz&_nc_oc=AdoEcYIfIiVXt2xtTYl3MDFku7FBF35qWlYpY6UtuNcbPaODhvXrpzUZuezfU4shuJk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNDIukfeplNZcA-95vCZk3GSzNV3GztvVxz7ZHCJKxHA&oe=6B005FD3"}, {"file_name": "5-how-to-play.png", "id": "2120178878593196", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673536876_2120178881926529_6565629817379292093_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pj3Sa_EkyF4Q7kNvwEgOaqh&_nc_oc=AdobGf12Fh8bVuSSUpBIIPBSpiMNLWaclcFAtTNaCn9eUZdbjc5Zl4LvYpHSpPuM9aE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpd61YY0TPHAX9Q6EibkMSk5nokA-GRf-A0f8skq1CpQ&oe=6B006877"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2560x1440.png", "id": "4424269247811254", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/814574569_4424269254477920_8207262051428501575_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=see8e73gkvwQ7kNvwFWyl5k&_nc_oc=AdoTej6QI9rOJESrDVkuzZvfySCIIalmE793CgGrJip8TgXFvYg9pnQU5FCH1gz_IyE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7bW_8_1KK5lrxmORPTJHgJxk_4yqOMulrBC4Ug7WxDg&oe=6B007388"}, "display_name": "Spatial Arcade", "keywords": ["arcade", "disparos", "retro", "shooter", "pistola"], "long_description": "Spatial Arcade convierte tu visor en un arcade de pistola de luz. Una pantalla curva de tama\u00f1o cine flota en una sala oscura frente a ti, y tus mandos Touch son las pistolas: apunta, aprieta el gatillo y siente cada disparo.\n\nIncluye Target Range, una galer\u00eda de tiro original creada para Spatial Arcade: dispara a las dianas, perdona a las caras sonrientes y abate a los robots antes de que su anillo se cierre. Recarga apuntando fuera de la pantalla y disparando.\n\nSpatial Arcade tambi\u00e9n reproduce algunos juegos de pistola de luz de los arcades de los a\u00f1os 90 que ya tienes: a\u00f1ade tus propios ficheros con el selector de archivos del visor. No se incluye ni se vende ning\u00fan otro juego en la app.\n\n- Una pantalla curva que puedes redimensionar, de un televisor a una pared de cine.\n- Filtros de imagen: pixeles nitidos, realzado, suave o lineas CRT.\n- 3D estereo real en los juegos dibujados en 3D.\n- Juega online con un amigo usando un codigo de 8 cifras, tambien con Apple Vision Pro. Sin cuentas, sin chat, sin salas publicas.\n- O jugad juntos en la misma Wi-Fi.\n\nSpatial Arcade no esta afiliado a ningun fabricante de arcades.", "short_description": "Arcade de pistola de luz en una pantalla curva gigante, con Target Range incluido."}, {"images": {"nodes": [{"file_name": "icon-spatial-foreground-512.png", "id": "2327031154714607", "image_type": "APP_IMG_ICON_FOREGROUND_512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604347072_2327031158047940_455948332943900465_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYnMAhum6yMQ7kNvwHsv_4F&_nc_oc=AdrISO4fyUxhLB7ybE0_2b6_FKUPjqw6BzTU98Nn8sPKypO_TwCifCURerPuX-f0Jiw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6cMgduvp4qttSFWadydFuotZdfCZAGt8ZLV-Bjhd4zg&oe=6B007335"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1713266720357540", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831299_1713266723690873_4279047128923347970_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSwWLx7NGzkQ7kNvwGheRNs&_nc_oc=AdrYZYFqaEVAXEmvCqjRG3M_94qZlt2jQshb9oIk6Mme8DicaSIsLBZ-0WBpHUomyNs&_nc_zt=3&_nc_ht=scontent-iad6-1.oc
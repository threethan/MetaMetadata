6t0GnRR00A6ZUpzcRjo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRPKGpk9SgennEjEjFpaw52DbXBJfFA0lIPcj6MGT9mLA&oe=6B0B407B"}, {"file_name": "4-crt-filter-controls.png", "id": "1480483760621521", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/604385997_1480483763954854_7784529683559253381_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyKmq6cT9iEQ7kNvwEtIHYB&_nc_oc=Adod04vcOrNNcZdJF99dO9e0_FH5ajQMfCGnaSeXFUB8QhshzofLGurhrxyYpnpHobM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRUQe1aH_aMaSltM6ZTjKc84rJKixJtVxnD-NCx7ECzQA&oe=6B0B2413"}, {"file_name": "5-how-to-play.png", "id": "2120178878593196", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/673536876_2120178881926529_6565629817379292093_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQ20ftOFN6sQ7kNvwHw5mRU&_nc_oc=AdojiX5bW9fsxFnvfhHi0BtuWumAwGZryxDqLBSIkcctVI52P_3YUa1se8VQaPEta2M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ34kVeUGlcSMTuVFpV3fwDq2v97hg7lGZeH147_-MPYg&oe=6B0B2CB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2560x1440.png", "id": "4424269247811254", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/814574569_4424269254477920_8207262051428501575_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzXcLrn_Ns0Q7kNvwHDFWV6&_nc_oc=AdomJxqxcHrsLwxJMC6lzHtjUUqfGDsj95Jzw1Sj8sCwdGfs0jK3tmPIICpZ0b_QJpY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSyeMHGHaayKPJz5ztyRHebkOKb8vRgojsRttxBjlYtAQ&oe=6B0B37C8"}, "display_name": "Spatial Arcade", "keywords": ["arcade", "disparos", "retro", "shooter", "pistola"], "long_description": "Spatial Arcade convierte tu visor en un arcade de pistola de luz. Una pantalla curva de tama\u00f1o cine flota en una sala oscura frente a ti, y tus mandos Touch son las pistolas: apunta, aprieta el gatillo y siente cada disparo.\n\nIncluye Target Range, una galer\u00eda de tiro original creada para Spatial Arcade: dispara a las dianas, perdona a las caras sonrientes y abate a los robots antes de que su anillo se cierre. Recarga apuntando fuera de la pantalla y disparando.\n\nSpatial Arcade tambi\u00e9n reproduce algunos juegos de pistola de luz de los arcades de los a\u00f1os 90 que ya tienes: a\u00f1ade tus propios ficheros con el selector de archivos del visor. No se incluye ni se vende ning\u00fan otro juego en la app.\n\n- Una pantalla curva que puedes redimensionar, de un televisor a una pared de cine.\n- Filtros de imagen: pixeles nitidos, realzado, suave o lineas CRT.\n- 3D estereo real en los juegos dibujados en 3D.\n- Juega online con un amigo usando un codigo de 8 cifras, tambien con Apple Vision Pro. Sin cuentas, sin chat, sin salas publicas.\n- O jugad juntos en la misma Wi-Fi.\n\nSpatial Arcade no esta afiliado a ningun fabricante de arcades.", "short_description": "Arcade de pistola de luz en una pantalla curva gigante, con Target Range incluido."}, {"images": {"nodes": [{"file_name": "icon-spatial-foreground-512.png", "id": "2327031154714607", "image_type": "APP_IMG_ICON_FOREGROUND_512", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/604347072_2327031158047940_455948332943900465_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGz7BoaWpcMQ7kNvwEPI30C&_nc_oc=AdraLQLzypMo0aDXt1cSIC7YbKZW_YguBwO3eD4-mKu_pieo7fn8M9t2q5E-6qAXjfg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTSPQlnd2T0fPn_03AEi7yeDKX2WgR8tkmrTrveKh-JjA&oe=6B0B3775"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1713266720357540", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831299_1713266723690873_4279047128923347970_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQKob4okeioQ7kNvwGumUng&_nc_oc=AdoBemyMRFnwow9pQNtqoQv0_wnWrNMsFk2R_xxQNc4uDKOgjKIK-TmvSelJtIrWdM0&_nc_zt=3&_nc_ht=scontent-atl3-1.oc
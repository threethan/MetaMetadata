RSp7aCOAhkW8ZEXgtz8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXwfIn0FxGRYmGtSHvw0CvIwVxQrU-7blo4KQ6uYaIuTw&oe=6B104E3B"}, {"file_name": "4-crt-filter-controls.png", "id": "1480483760621521", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604385997_1480483763954854_7784529683559253381_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdHpGnCWI4QQ7kNvwFsJ-rl&_nc_oc=AdoMhtFYRht1YynB-QXGP5OzvKVczQ1oeTP0G7VaUk8AxkH_Hw4zqAS8ByZ80Oy90PE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXsjyWFlXrMFGUfwsq1eEJTjD9fkN_HZjmy8fwsyRDG5Q&oe=6B106A13"}, {"file_name": "5-how-to-play.png", "id": "2120178878593196", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673536876_2120178881926529_6565629817379292093_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLelM4aV_QIQ7kNvwFhXsh6&_nc_oc=AdoEwxs4Ekwnemlv2-7-Mxvg5o1DiC_pp6tFHF5SVxnzmigG_hz8QVxovdRERAqo_jg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVoNOeRCv7ZXWTq7xZ1fjJbhRLGKC3aSIC7i0sCezWR1Q&oe=6B103A77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2560x1440.png", "id": "4424269247811254", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/814574569_4424269254477920_8207262051428501575_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vy8QA2ZN0kQ7kNvwGc2Ud-&_nc_oc=AdrNUPwFDSfKhXwunAN-G19BvJpfjpPJKkKksOK97OBVzXQ4n9PsJVcts3WaIrVAQjk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXxIzxY69a9tvt9RzSHVHiJkNrc8Q6ysPcbiLzqLcNqoA&oe=6B104588"}, "display_name": "Spatial Arcade", "keywords": ["arcade", "disparos", "retro", "shooter", "pistola"], "long_description": "Spatial Arcade convierte tu visor en un arcade de pistola de luz. Una pantalla curva de tama\u00f1o cine flota en una sala oscura frente a ti, y tus mandos Touch son las pistolas: apunta, aprieta el gatillo y siente cada disparo.\n\nIncluye Target Range, una galer\u00eda de tiro original creada para Spatial Arcade: dispara a las dianas, perdona a las caras sonrientes y abate a los robots antes de que su anillo se cierre. Recarga apuntando fuera de la pantalla y disparando.\n\nSpatial Arcade tambi\u00e9n reproduce algunos juegos de pistola de luz de los arcades de los a\u00f1os 90 que ya tienes: a\u00f1ade tus propios ficheros con el selector de archivos del visor. No se incluye ni se vende ning\u00fan otro juego en la app.\n\n- Una pantalla curva que puedes redimensionar, de un televisor a una pared de cine.\n- Filtros de imagen: pixeles nitidos, realzado, suave o lineas CRT.\n- 3D estereo real en los juegos dibujados en 3D.\n- Juega online con un amigo usando un codigo de 8 cifras, tambien con Apple Vision Pro. Sin cuentas, sin chat, sin salas publicas.\n- O jugad juntos en la misma Wi-Fi.\n\nSpatial Arcade no esta afiliado a ningun fabricante de arcades.", "short_description": "Arcade de pistola de luz en una pantalla curva gigante, con Target Range incluido."}, {"images": {"nodes": [{"file_name": "icon-spatial-foreground-512.png", "id": "2327031154714607", "image_type": "APP_IMG_ICON_FOREGROUND_512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604347072_2327031158047940_455948332943900465_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZG2gdNMt1O4Q7kNvwHJWGcV&_nc_oc=AdphhTndTaw2UMh5NRqMFG54zBI6v681ho-WEus8mZbpqzUvfJ8UgMgR3q8hSSzaneE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWXCTreLu8CwOEJQGx3j0LU6z-Kk0LB-lCkCxZgd46XoQ&oe=6B104535"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1713266720357540", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831299_1713266723690873_4279047128923347970_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovodgJzsoZMQ7kNvwEMd_pm&_nc_oc=AdqjJkTc6kacvDKJegWDDhLnmi7eJrIa32XX43YSJcQIRc8_q1oaAriWABc96cf2MbM&_nc_zt=3&_nc_ht=scontent-iad6-1.oc
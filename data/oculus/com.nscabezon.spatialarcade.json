cYREmY645WbW_6XRzfM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNgN3zDWDxyJ524t9env8dY7lbIyElUF05sCEgM0JWMA&oe=6B01CDBB"}, {"file_name": "4-crt-filter-controls.png", "id": "1480483760621521", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604385997_1480483763954854_7784529683559253381_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDMb0uTw4qYQ7kNvwE9Me8L&_nc_oc=AdpWD_FPU7BoTMa4ZQoYhTdsgE1n0cn92dKe5aSJER983xOJYGx_9Hxyg2nqbdx0Sf8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYNpKTq75czL2hZoZ7kHRYDzQsaNuc-y-TxkwOm6pHHw&oe=6B01E993"}, {"file_name": "5-how-to-play.png", "id": "2120178878593196", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673536876_2120178881926529_6565629817379292093_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pj3Sa_EkyF4Q7kNvwFtPQPw&_nc_oc=AdpZqJnMtv5er04s2xqHxrigbRMs2A_cwKlVXnIGza9ylWH_DZ13iwNxKdin5tIqb-g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR88Cbe_QXMmgXJuMOKrbH5hsiUdoLLHFnitNKAHSD0OQ&oe=6B01B9F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2560x1440.png", "id": "4424269247811254", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/814574569_4424269254477920_8207262051428501575_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=see8e73gkvwQ7kNvwFEfI5R&_nc_oc=AdrAlkwt3x05w4FPzbZUA1pVwGADet99ZPGZTl_ngEgs31gz9aBSfRY0ozXUSz3yoME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScolk1ZNV8NiAhctO2tRS87Xud7XVD-Koi7tqWCP8eDg&oe=6B01C508"}, "display_name": "Spatial Arcade", "keywords": ["arcade", "disparos", "retro", "shooter", "pistola"], "long_description": "Spatial Arcade convierte tu visor en un arcade de pistola de luz. Una pantalla curva de tama\u00f1o cine flota en una sala oscura frente a ti, y tus mandos Touch son las pistolas: apunta, aprieta el gatillo y siente cada disparo.\n\nIncluye Target Range, una galer\u00eda de tiro original creada para Spatial Arcade: dispara a las dianas, perdona a las caras sonrientes y abate a los robots antes de que su anillo se cierre. Recarga apuntando fuera de la pantalla y disparando.\n\nSpatial Arcade tambi\u00e9n reproduce algunos juegos de pistola de luz de los arcades de los a\u00f1os 90 que ya tienes: a\u00f1ade tus propios ficheros con el selector de archivos del visor. No se incluye ni se vende ning\u00fan otro juego en la app.\n\n- Una pantalla curva que puedes redimensionar, de un televisor a una pared de cine.\n- Filtros de imagen: pixeles nitidos, realzado, suave o lineas CRT.\n- 3D estereo real en los juegos dibujados en 3D.\n- Juega online con un amigo usando un codigo de 8 cifras, tambien con Apple Vision Pro. Sin cuentas, sin chat, sin salas publicas.\n- O jugad juntos en la misma Wi-Fi.\n\nSpatial Arcade no esta afiliado a ningun fabricante de arcades.", "short_description": "Arcade de pistola de luz en una pantalla curva gigante, con Target Range incluido."}, {"images": {"nodes": [{"file_name": "icon-spatial-foreground-512.png", "id": "2327031154714607", "image_type": "APP_IMG_ICON_FOREGROUND_512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604347072_2327031158047940_455948332943900465_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMQ5T0w0zv0Q7kNvwFvwAuy&_nc_oc=Adr0RaPCvJCRFHaWMqfaI1Vpc5zlsWnKiVQdz5Fa7UofbN6rA5HygNesThqbMfbdezk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFjab4lBL6tnI1bXHuLgHvBl9JQA3Nx_MU_Rkm0XY2cg&oe=6B01C4B5"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1713266720357540", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831299_1713266723690873_4279047128923347970_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fULgybLsMYsQ7kNvwGYsOEM&_nc_oc=AdpL1-EM3Os0J97t2vVM0tLxFIvxX5VKIdKKWDTm2Y1Qdu6OF1qMpa7pLOyiQGjFhvo&_nc_zt=3&_nc_ht=scontent-iad6-1.oc
N1h3ndOocfXnw6edCPo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0_cufPyZaSbVbijLSva6oyPSkRCmRlrVbxTKWxKD5XQ&oe=6B0713BB"}, {"file_name": "4-crt-filter-controls.png", "id": "1480483760621521", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604385997_1480483763954854_7784529683559253381_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxYAqLEgwZcQ7kNvwGVwfaQ&_nc_oc=AdrU_ShMjPUjpEOJMJng9uOMgPq4D7UJsXg-feGYePXPN1quDSC5jXhr3tP08H-aG7g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7O05BVrcqOHpTdjUunhoxWgEkzO7n5qpXYdyI5kxIiw&oe=6B06F753"}, {"file_name": "5-how-to-play.png", "id": "2120178878593196", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673536876_2120178881926529_6565629817379292093_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7whZD-E5fIQ7kNvwEbcMD-&_nc_oc=AdrLUvYrYLoFwZnF_W8OyuM7p_Fq6QsAadHf2RLHmC98ScOZD30ehl_JLDqzVVP80x4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoFFrvwp-bEemnAAfjUx4OF7xfDVGj0IQWQXHMdOugSw&oe=6B06FFF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2560x1440.png", "id": "4424269247811254", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/814574569_4424269254477920_8207262051428501575_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dejeje2tfycQ7kNvwG1OhzG&_nc_oc=AdoJcYHnUdzCe9TdtGqhvyd7OI-JjLuBxDJzSrZkXRiOwEpkoUM5a6Xkd5amkYE76pk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfu5CYixjQSJ0vdDk6IshU2cCbHQuIQIN6YqPu8z_HQA&oe=6B070B08"}, "display_name": "Spatial Arcade", "keywords": ["arcade", "disparos", "retro", "shooter", "pistola"], "long_description": "Spatial Arcade convierte tu visor en un arcade de pistola de luz. Una pantalla curva de tama\u00f1o cine flota en una sala oscura frente a ti, y tus mandos Touch son las pistolas: apunta, aprieta el gatillo y siente cada disparo.\n\nIncluye Target Range, una galer\u00eda de tiro original creada para Spatial Arcade: dispara a las dianas, perdona a las caras sonrientes y abate a los robots antes de que su anillo se cierre. Recarga apuntando fuera de la pantalla y disparando.\n\nSpatial Arcade tambi\u00e9n reproduce algunos juegos de pistola de luz de los arcades de los a\u00f1os 90 que ya tienes: a\u00f1ade tus propios ficheros con el selector de archivos del visor. No se incluye ni se vende ning\u00fan otro juego en la app.\n\n- Una pantalla curva que puedes redimensionar, de un televisor a una pared de cine.\n- Filtros de imagen: pixeles nitidos, realzado, suave o lineas CRT.\n- 3D estereo real en los juegos dibujados en 3D.\n- Juega online con un amigo usando un codigo de 8 cifras, tambien con Apple Vision Pro. Sin cuentas, sin chat, sin salas publicas.\n- O jugad juntos en la misma Wi-Fi.\n\nSpatial Arcade no esta afiliado a ningun fabricante de arcades.", "short_description": "Arcade de pistola de luz en una pantalla curva gigante, con Target Range incluido."}, {"images": {"nodes": [{"file_name": "icon-spatial-foreground-512.png", "id": "2327031154714607", "image_type": "APP_IMG_ICON_FOREGROUND_512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604347072_2327031158047940_455948332943900465_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTgRDtp_qOcQ7kNvwGfOF5d&_nc_oc=AdoNH31xGDKd45mofmu2yP2M-SO1mNXa_kVjdR0hRFceE8r3UuG85J82TPgcrLp-Ln8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3_yW2vF3gN_QmJebzC7eDQZ-i0V-x6CWCuvmiACe04A&oe=6B070AB5"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1713266720357540", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831299_1713266723690873_4279047128923347970_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gui1brCy8loQ7kNvwEEXZ0M&_nc_oc=AdrIHFcpnRUUHpsp23eCLmAywEkl0JlL_wl8k87GbqmxEepgKIBevFsc5tdFPdz0Qw8&_nc_zt=3&_nc_ht=scontent-iad6-1.oc
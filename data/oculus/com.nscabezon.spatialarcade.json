culuscdn.com&_nc_ss=7f20f&oh=00_AQRQdBbCvoQhjhkc0uTw7pVY6z3VBVD5ftOiDm7b8qFEaw&oe=6AFB2C61"}, "display_name": "Spatial Arcade", "keywords": ["arcade", "shooting", "retro", "shooter", "lightgun"], "long_description": "Spatial Arcade turns your headset into a light-gun arcade. A cinema-sized curved screen floats in a dark room in front of you, and your Touch controllers are the guns: aim, pull the trigger and feel every shot.\n\nIncludes Target Range, an original shooting gallery made for Spatial Arcade: shoot the targets, spare the smiley faces and take down the robots before their ring closes. Reload by aiming off the screen and firing.\n\nSpatial Arcade also plays some 1990s arcade light-gun games that you already own: add your own game files with the headset's file picker. No other games are included or sold in the app.\n\n- A curved screen you can resize, from a TV to a cinema wall.\n- Picture filters: sharp pixels, sharpened, smooth or CRT scanlines.\n- Real stereo 3D in games drawn in 3D.\n- Play online with a friend using an 8-digit code, also with Apple Vision Pro. No accounts, no chat, no public lobbies.\n- Or play together on the same Wi-Fi.\n\nSpatial Arcade is not affiliated with any arcade manufacturer.", "short_description": "Light-gun arcade on a giant curved screen, with Target Range included."}]}, "developer_name": "Iv\u00e1n Cabez\u00f3n Orjales", "developer_privacy_policy_url": "https://spatialarcade.app/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Iv\u00e1n Cabez\u00f3n Orjales", "support_website_url": "https://spatialarcade.app/support/", "website_url": "https://spatialarcade.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
zW0vRT5XnhTn6V1-UK8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQYgvCg9gzmraTXEHyVIR2DMCXyrhW5kIpGaGK0-qgDw&oe=6B031F3B"}, {"file_name": "4-crt-filter-controls.png", "id": "1480483760621521", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604385997_1480483763954854_7784529683559253381_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMKEq36e0F8Q7kNvwEyzcqX&_nc_oc=AdpwVKSFK1K6q8SJwhSXgANuV3VtEGoYkoCOiSzeI952IRxf9Haj1popoJVTV1T1bM8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxlgheNIEXJdmZpbaaas7pmK-bAceVMW4LE4iC_hkFpg&oe=6B0302D3"}, {"file_name": "5-how-to-play.png", "id": "2120178878593196", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673536876_2120178881926529_6565629817379292093_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnmGsY12EKAQ7kNvwFRJwsr&_nc_oc=AdoD-6DOm88WgX3NEkW1o8pgJiw4EAGUI_FVQ5xcZxKj4c8F8-3asVtcTCsiFJwC7i0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtXps5EI-vJZhNPLHu_DvabIQPBr0GneVMfwu7RCNRDQ&oe=6B030B77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2560x1440.png", "id": "4424269247811254", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/814574569_4424269254477920_8207262051428501575_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTaYAxb1upcQ7kNvwF9F2iN&_nc_oc=Adq_1X2wLPvv0zm21Wbq4lsuCBuu3Wx2T6xC5i4hcy-PfhjffS8iMMLzaFi3iejsQfY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTv2Y-riXh4QpViWmu-RNohCmeLLbTXRKK4aLYmMzzWRA&oe=6B031688"}, "display_name": "Spatial Arcade", "keywords": ["arcade", "disparos", "retro", "shooter", "pistola"], "long_description": "Spatial Arcade convierte tu visor en un arcade de pistola de luz. Una pantalla curva de tama\u00f1o cine flota en una sala oscura frente a ti, y tus mandos Touch son las pistolas: apunta, aprieta el gatillo y siente cada disparo.\n\nIncluye Target Range, una galer\u00eda de tiro original creada para Spatial Arcade: dispara a las dianas, perdona a las caras sonrientes y abate a los robots antes de que su anillo se cierre. Recarga apuntando fuera de la pantalla y disparando.\n\nSpatial Arcade tambi\u00e9n reproduce algunos juegos de pistola de luz de los arcades de los a\u00f1os 90 que ya tienes: a\u00f1ade tus propios ficheros con el selector de archivos del visor. No se incluye ni se vende ning\u00fan otro juego en la app.\n\n- Una pantalla curva que puedes redimensionar, de un televisor a una pared de cine.\n- Filtros de imagen: pixeles nitidos, realzado, suave o lineas CRT.\n- 3D estereo real en los juegos dibujados en 3D.\n- Juega online con un amigo usando un codigo de 8 cifras, tambien con Apple Vision Pro. Sin cuentas, sin chat, sin salas publicas.\n- O jugad juntos en la misma Wi-Fi.\n\nSpatial Arcade no esta afiliado a ningun fabricante de arcades.", "short_description": "Arcade de pistola de luz en una pantalla curva gigante, con Target Range incluido."}, {"images": {"nodes": [{"file_name": "icon-spatial-foreground-512.png", "id": "2327031154714607", "image_type": "APP_IMG_ICON_FOREGROUND_512", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/604347072_2327031158047940_455948332943900465_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMQ5T0w0zv0Q7kNvwGCbOUZ&_nc_oc=Adp17j8WxTzKruuvWasgqv8YGxkPYeWVkU9jwoF1qZeqjR-4h55fcRnKfZLdQdcLztc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjnYGydftiWq6EBjrtPxEeAYECQoXK2uKAgpY4vZ1HjA&oe=6B031635"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1713266720357540", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831299_1713266723690873_4279047128923347970_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fULgybLsMYsQ7kNvwESORLo&_nc_oc=AdqlQ8dmF7jJczmWbZG3orvrKet61_eE5sTqlPm3xF508OZGwnNEY79yM_BPNvP1Z_U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oc
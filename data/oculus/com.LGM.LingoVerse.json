QQcmxBOqVm7dalQy16_w_qft1O-GpIqySTvPBdTuln5Aw&oe=6B05A530"}, {"file_name": "picking_up_objects.png", "id": "3146461728839334", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393228_3146461732172667_3706287487870115736_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xVDncfGF6MQ7kNvwFcYs3w&_nc_oc=AdoksBFOW3XIeS0Di73sCuncIarsE4fV3GXki5h9fjwCXV3uBxVEJvPFwKyVwZRB6E0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCIuk79dcFZ_TSUlRmiV5r9JT8-GjYl-CWrFf1VyPquA&oe=6B05A33C"}, {"file_name": "multi_choice_example.png", "id": "3934472840166071", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391716_3934472846832737_5111795480125325401_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrQMs_ijUg8Q7kNvwGLdzXS&_nc_oc=AdqKEi67RQurwtzBp3BbD8Ux7JERlbRq5sjHFLSDNgZzgQlK3qbRYJ4nIvNA4cHg5dc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrXEES0ljPozMsnOQ8rIi2_4lZ3Jsj5-FWu1vAhzrJyQ&oe=6B05CD2B"}, {"file_name": "countryside.png", "id": "829620639320570", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393545_829620645987236_1977403622736127236_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4PKG6CoBs8Q7kNvwEPJBXf&_nc_oc=Ado56pt7hwc1cAHeXFDuwHzps7mmLIFccDzBSIDM4rQ3SmJDHDtX4kdwPsCftNmcnQU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbYV_cb5PvEwupQdFpTO2z05U9_lt5d6Nw1C_IykG_AQ&oe=6B05C6C1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LingoVerse", "keywords": ["language", "adventure", "learning"], "long_description": "# Step into LingoVerse \u2013 The Ultimate German Learning Adventure!  \n\nLearning German has never been this immersive! **LingoVerse** takes language learning to the next level by placing you in interactive, fully voice-enabled environments where you can practice speaking with lifelike characters. Whether you\u2019re navigating a bustling city, exploring the countryside, cooking in a cozy kitchen, or sitting in a classroom, every interaction helps you improve your fluency in a fun and natural way.  \n\n## Key Features:  \n-  \ud83d\udde3 **Advanced Speech Recognition** with deep learning models\n- \ud83c\udf0d **Dynamic Environments** \u2013 Explore a **city**, the **countryside**, a **kitchen**, and a **classroom**, each designed to enhance different aspects of your language skills.  \n- \ud83c\udfae **Fun Minigames** \u2013 Boost your vocabulary by hunting for the right objects in each scene, reinforcing word associations in a hands-on way.  \n\n**Download LingoVerse now and step into fluency!** \ud83d\ude80\ud83c\udfa7  \n\n\n", "short_description": "LingoVerse transforms learning German into an immersive adventure! Step into vibrant environments filled with unique characters ready to chat with you in real-time conversations. Expand your vocabulary by interacting with objects around you, making learning both natural and intuitive. Whether you're a beginner or looking to sharpen your skills, LingoVerse makes mastering German both fun and effective!"}]}, "developer_name": "Laboratory for Computer Graphics and Multimedia at FRI-UL", "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/lingoverse-privacy-policy/c32d666a-838b-4f25-bf17-22b14d5f5a3f/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/lingoverse-terms-of-use/31e9945d-b3d0-4d31-b6c9-9553dbaf1800/terms", "publisher_name": "Laboratory for Computer Graphics and Multimedia at FRI-UL", "support_website_url": null, "website_url": "https://lgm.fri.uni-lj.si/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "2691890164460465"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_
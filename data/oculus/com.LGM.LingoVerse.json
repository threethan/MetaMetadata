N", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/473393589_650066974197329_3615995200527239376_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZSY379pZ3YQ7kNvwHW8qUc&_nc_oc=AdlcFPxMpIHKVludQ2qkxsWFVkmCmLkFaEXAxYLrhQlVGWe0i9bBdG9TEWWaXGRwwvg&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfuYmeUXJbOH0hVBlxw57mY_Zo3aczCqPvJM9a6yztND9A&oe=69A1819A"}, {"file_name": "portrait_cover.png", "id": "646805757861591", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391842_646805761194924_869906726609990634_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKhTo07_En0Q7kNvwHkj1_T&_nc_oc=AdkBbHeXjXpvqZbFZmHuM83KzoxFq3C14Jn-1N0b36sZJC6P60pYSWGI3B1J4yy0aTs&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afv5C3uCxJOVSfJSwXh7ZpqG04it8vs3_Mox0a6-LHv2oQ&oe=69A1A513"}]}, "id": "2627525080932458", "locale": "en_US", "screenshots": [{"file_name": "image1.png", "id": "1767686780628500", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391845_1767686783961833_6654492788133886749_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEf7glhcfOEQ7kNvwEdKK4G&_nc_oc=Adk1Gj033v3tXkc6aRCu00h0kdB2sQhwyzXTazmYS4LW4ugalqHCn4eNmJS4Etu6ux8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuwUioclaG8eVKw4LkPXo8f1kGnHEi9Fw8QoAutO6riHg&oe=69A19789"}, {"file_name": "minigame.png", "id": "639075018666993", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391832_639075025333659_2757519353100597330_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPVvSlrKoJsQ7kNvwHTPrXg&_nc_oc=AdnHl3jhTaYqvAKaYGoYq_jlXqBS4jDoiNI5izw4-zXWFjKw0VXA6dkxbcfFhyNxDs8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvU4BXnO3Z8G_rLncEN1V5F7DBfN0QyOdNYhupaSZeDJg&oe=69A177F0"}, {"file_name": "picking_up_objects.png", "id": "3146461728839334", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473393228_3146461732172667_3706287487870115736_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5lkjY2ccnYQ7kNvwFg05VH&_nc_oc=AdkfOkGAXOrD2l0M7-A3rC8PkM77eAvPZ59xFtpo8EgM_eBm5aViynGDZErCG0F9-SE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvtfOr7LZ_veV5Nw80Lqmu3DvGwglltkmL2NlKfWyOFPg&oe=69A175FC"}, {"file_name": "multi_choice_example.png", "id": "3934472840166071", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391716_3934472846832737_5111795480125325401_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tT8QfZ8Hrp4Q7kNvwFZ3_WV&_nc_oc=Adk27pbM5Ig-yHsaIjTrnBH0flHgWKhU6VmnyzJ9zWDBK6bgBuxfyE0454QScgcvgbk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afu9PosQyy7d7gybzZtRMbZL-XWV3fzWTjrqVAakxJdUVw&oe=69A19FEB"}, {"file_name": "countryside.png", "id": "829620639320570", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473393545_829620645987236_1977403622736127236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdUmO7ME0K4Q7kNvwEsi-Zx&_nc_oc=AdlMohRXiEsarIgI5LUSbp3NQ22xSSAIHXlCJc3WFXyxd-5tQL-TaFRMRCSfhgqu7bU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftY5KJ0ITa0ct4DEd-Qoa65HihV-cw3-dhTzo5M6UnHkA&oe=69A19981"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LingoVerse", "keywords": ["language", "adventure", "learning"], "long_description": "# Step into LingoVerse \u2013 The Ultimate German Learning Adventure!  \n\nLearning German has never been this immersive! **LingoVerse** takes language learning to the next level by placing you in interactive, fully voice-enabled environments where you can practice speaking with lifelike characters. Whether you\u2019re navigating a bustling city, exploring the countryside, cooking in a cozy kitchen, or sitting in a classroom, every interaction helps you improve your fluency in a fun and natural way.  \n\n## Key Features:  \n-  \ud83d\udde3 **Advanced Speech Recognition** with deep learning models\n- \ud83c\udf0d **Dynamic Environments** \u2013 Explore a **city**, the **countryside**, a **kitchen**, and a **classroom**, each designed to enhance different aspects of your language skills.  \n- \ud83c\udfae **Fun Minigames** \u2013 Boost your vocabulary by hunting for the right objects in each scene, reinforcing word associations in a hands-on way.  \n\n**Download LingoVerse now and step into fluency!** \ud83d\ude80\ud83c\udfa7  \n\n\n", "short_description": "LingoVerse transforms learning German into an immersive adventure! Step into vibrant environments filled with unique characters ready to chat with you in real-time conversations. Expand your vocabulary by interacting with objects around you, making learning both natural and intuitive. Whether you're a beginner or looking to sharpen your skills, LingoVerse makes mastering German both fun and effective!"}]}, "developer_name": "Laboratory for Computer Graphics and Multimedia at FRI-UL", "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/lingoverse-privacy-policy/c32d666a-838b-4f25-bf17-22b14d5f5a3f/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/lingoverse-terms-of-use/31e9945d-b3d0-4d31-b6c9-9553dbaf1800/terms", "publisher_name": "Laboratory for Computer Graphics and Multimedia at FRI-UL", "support_website_url": null, "website_url": "https://lgm.fri.uni-lj.si/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "2691890164460465"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24656540377365576"}, "review_messages": []}]}, "cover_square_image": {"
72667_3706287487870115736_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIj1EZcO6F8Q7kNvwG7eNMk&_nc_oc=Adprlk4xmcnC0q3ca1gP9IMgembk40e_hU9WtAWMmRyKF2UbLQIaeDyQ6VBv43nEkLA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRj2Rvm9CaZMDsOc641XAahzYXYoPGGqiAvFJGoNOApew&oe=6AF1DCBC"}, {"file_name": "multi_choice_example.png", "id": "3934472840166071", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391716_3934472846832737_5111795480125325401_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H48ljJCGl9cQ7kNvwHd3eqj&_nc_oc=Adrm13awXzRbSQgjmbCjaAWNq4fCLVrbkpNNqUTZMOSrLDWt-8oX2cw5QzMeZLaeGOY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyzUVI48HAnKV8ZmvZD4M1jXmrqTFetdgr5Psxquegew&oe=6AF206AB"}, {"file_name": "countryside.png", "id": "829620639320570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393545_829620645987236_1977403622736127236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33UFUO5NOn8Q7kNvwGZSZ5t&_nc_oc=Adrl48FG2V90SSd8TTyyTCSJ9lgyaSWBGVi7qQjo9nuwUSAePlFavsQ539KrnZ-1X8Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWVzT-UqSUlxuodbXTXvZWlCNou0SIvKs2N25MVfHhwA&oe=6AF20041"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LingoVerse", "keywords": ["language", "adventure", "learning"], "long_description": "# Step into LingoVerse \u2013 The Ultimate German Learning Adventure!  \n\nLearning German has never been this immersive! **LingoVerse** takes language learning to the next level by placing you in interactive, fully voice-enabled environments where you can practice speaking with lifelike characters. Whether you\u2019re navigating a bustling city, exploring the countryside, cooking in a cozy kitchen, or sitting in a classroom, every interaction helps you improve your fluency in a fun and natural way.  \n\n## Key Features:  \n-  \ud83d\udde3 **Advanced Speech Recognition** with deep learning models\n- \ud83c\udf0d **Dynamic Environments** \u2013 Explore a **city**, the **countryside**, a **kitchen**, and a **classroom**, each designed to enhance different aspects of your language skills.  \n- \ud83c\udfae **Fun Minigames** \u2013 Boost your vocabulary by hunting for the right objects in each scene, reinforcing word associations in a hands-on way.  \n\n**Download LingoVerse now and step into fluency!** \ud83d\ude80\ud83c\udfa7  \n\n\n", "short_description": "LingoVerse transforms learning German into an immersive adventure! Step into vibrant environments filled with unique characters ready to chat with you in real-time conversations. Expand your vocabulary by interacting with objects around you, making learning both natural and intuitive. Whether you're a beginner or looking to sharpen your skills, LingoVerse makes mastering German both fun and effective!"}]}, "developer_name": "Laboratory for Computer Graphics and Multimedia at FRI-UL", "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/lingoverse-privacy-policy/c32d666a-838b-4f25-bf17-22b14d5f5a3f/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/lingoverse-terms-of-use/31e9945d-b3d0-4d31-b6c9-9553dbaf1800/terms", "publisher_name": "Laboratory for Computer Graphics and Multimedia at FRI-UL", "support_website_url": null, "website_url": "https://lgm.fri.uni-lj.si/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "2691890164460465"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported
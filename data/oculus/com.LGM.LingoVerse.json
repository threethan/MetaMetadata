N", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393589_650066974197329_3615995200527239376_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YziMkeg7BFMQ7kNvwESY-T_&_nc_oc=AdnORqvnG24Z3hkSgIzy1juSayc2B9XBhyLXXUISHHU2nPMkkEs1vDS-TH6c4hD79Ig&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvfSoL3stv44aDIRwx9L793OgkpKI6MMicyWoliz9L45A&oe=6998471A"}, {"file_name": "portrait_cover.png", "id": "646805757861591", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391842_646805761194924_869906726609990634_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFGNl2eml1cQ7kNvwHW7iLn&_nc_oc=AdlrJlRv5qeF4-fJdJf33DuW3gt7uiTYbMxHVH-K0J_idLNBj_n4ugctG9npqQKFjp0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuEpSIcbohCvRnxpfTYoXiDwty849i9j7nX_uz0Bvn6qw&oe=69986A93"}]}, "id": "2627525080932458", "locale": "en_US", "screenshots": [{"file_name": "image1.png", "id": "1767686780628500", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391845_1767686783961833_6654492788133886749_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGoQad5ts-wQ7kNvwHi1UZu&_nc_oc=AdlYH0XkoGAqZ0MnpzCwOcL83lGL2lMtP8Q2f9sCUiNTpliO3WRxkH_fRrdmXEnOuO8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvUQRl3wtTfdgCRELoQ-tK5vuePGpkc85uKpVdBN6jkag&oe=69985D09"}, {"file_name": "minigame.png", "id": "639075018666993", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391832_639075025333659_2757519353100597330_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgLpBoVtl84Q7kNvwE0hKfs&_nc_oc=AdnYBlzWiaH4LKV5LlZaccbgQGK9wfBbSvSFkCDdSrMHtQCLmBcSO4PkY11nMXxBYpw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuC8jEUakTEclzXyIgskUTa_VMCYV2CHitQE5VuibGRJw&oe=69983D70"}, {"file_name": "picking_up_objects.png", "id": "3146461728839334", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393228_3146461732172667_3706287487870115736_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmmKFVqnGrwQ7kNvwF-S1el&_nc_oc=AdnCKjWhYB73Y7lZok1ESIyuBA77J7qra5n2EId58U0R6NJEIx1mkXqhCuolrGg0jd8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afvp7oloIzRTa1WP5fAFJFw0kOm4COEjo60M5IyCPsQdmA&oe=69983B7C"}, {"file_name": "multi_choice_example.png", "id": "3934472840166071", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391716_3934472846832737_5111795480125325401_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwiPUmHmXqQQ7kNvwFAGg93&_nc_oc=AdmztFlR6f0EzBUcQpUGEUk52v87CLGBPa0GWQlnifLCW3nS1GOp2HLgUrsxRQkFif8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvdTqzwTmdXZmVGmutVisxDFWBG0sXbqd8IEl6fpjp6sQ&oe=6998656B"}, {"file_name": "countryside.png", "id": "829620639320570", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393545_829620645987236_1977403622736127236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQbaaUl55YwQ7kNvwGGJZD3&_nc_oc=AdnI5TM4EYTl96Lrg5_1xKtDbxwqiZiiJ6PO8Wlg7ztDds-0JJyVO7R5hNDaQakr5a4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvIegXspem6-BV8w_hIbIuJDaRzGCXc72xSX3RIp2-w9w&oe=69985F01"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LingoVerse", "keywords": ["language", "adventure", "learning"], "long_description": "# Step into LingoVerse \u2013 The Ultimate German Learning Adventure!  \n\nLearning German has never been this immersive! **LingoVerse** takes language learning to the next level by placing you in interactive, fully voice-enabled environments where you can practice speaking with lifelike characters. Whether you\u2019re navigating a bustling city, exploring the countryside, cooking in a cozy kitchen, or sitting in a classroom, every interaction helps you improve your fluency in a fun and natural way.  \n\n## Key Features:  \n-  \ud83d\udde3 **Advanced Speech Recognition** with deep learning models\n- \ud83c\udf0d **Dynamic Environments** \u2013 Explore a **city**, the **countryside**, a **kitchen**, and a **classroom**, each designed to enhance different aspects of your language skills.  \n- \ud83c\udfae **Fun Minigames** \u2013 Boost your vocabulary by hunting for the right objects in each scene, reinforcing word associations in a hands-on way.  \n\n**Download LingoVerse now and step into fluency!** \ud83d\ude80\ud83c\udfa7  \n\n\n", "short_description": "LingoVerse transforms learning German into an immersive adventure! Step into vibrant environments filled with unique characters ready to chat with you in real-time conversations. Expand your vocabulary by interacting with objects around you, making learning both natural and intuitive. Whether you're a beginner or looking to sharpen your skills, LingoVerse makes mastering German both fun and effective!"}]}, "developer_name": "Laboratory for Computer Graphics and Multimedia at FRI-UL", "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/lingoverse-privacy-policy/c32d666a-838b-4f25-bf17-22b14d5f5a3f/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/lingoverse-terms-of-use/31e9945d-b3d0-4d31-b6c9-9553dbaf1800/terms", "publisher_name": "Laboratory for Computer Graphics and Multimedia at FRI-UL", "support_website_url": null, "website_url": "https://lgm.fri.uni-lj.si/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "2691890164460465"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24656540377365576"}, "review_messages": []}]}, "cover_square_image": {"
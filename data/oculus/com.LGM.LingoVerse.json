N", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393589_650066974197329_3615995200527239376_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4Rx3ueURtMQ7kNvwHTEqY7&_nc_oc=AdnO8SiEu3I1GzPr8dUqT3bms017N1zcvgjWVfaQVDolX6wpoQOFb-ElAosaOrwcziE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv0tHum_nZAw2c5nFa4DaRqbz8w0Vb7YcOJeY26uCAw2A&oe=69A6C79A"}, {"file_name": "portrait_cover.png", "id": "646805757861591", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391842_646805761194924_869906726609990634_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWfiiRD6S_IQ7kNvwFUhUZt&_nc_oc=AdkPei9Dm20a_VYyoDYtMB5vyzHX7wemv2-sp4E4EgtPo1mFLdTJ0tskpz3LOVD9dzA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuAcTt421_YY1SFHes2EEgBaDlUMc6HABlkpiXFOv0eSw&oe=69A6EB13"}]}, "id": "2627525080932458", "locale": "en_US", "screenshots": [{"file_name": "image1.png", "id": "1767686780628500", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391845_1767686783961833_6654492788133886749_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpxaHdnrRpYQ7kNvwFuwdV7&_nc_oc=AdnqLcqzzkJq89-bercrLl5r9a01S7A4oiKqqYZURaI25ziJ4HdkWoSqBvr29-ECJBA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuxo8vBxNeEKDQtNzbWVIKfnymKeGBqfYmhBOfee96Fqw&oe=69A6DD89"}, {"file_name": "minigame.png", "id": "639075018666993", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391832_639075025333659_2757519353100597330_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVhphH4L7tYQ7kNvwGuL_YM&_nc_oc=AdnlOdQuRk1yEjr9U8MiYrFJtsX3j-joV7va8j2a17jIv78zFKf24FvJQ5P1x2aC99Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuWwqFTNonsVK9_Of0nc7PPaY4LuZAvQ9Bavq8iUNlp9g&oe=69A6BDF0"}, {"file_name": "picking_up_objects.png", "id": "3146461728839334", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393228_3146461732172667_3706287487870115736_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i33mtbJSP3sQ7kNvwFc_KL5&_nc_oc=Adm91FdylRLRFV0R22g0HXfsiEtBChNwXWBgSE7OakCeq44gAlBEJxFSgzl0sK2wQtg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftGoa_gl-HJwN-nLePNzUYaYMieg_LqH8joWrEeIsK3JQ&oe=69A6F43C"}, {"file_name": "multi_choice_example.png", "id": "3934472840166071", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391716_3934472846832737_5111795480125325401_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yA9rOOyOvUEQ7kNvwGVLVNr&_nc_oc=AdmQxYsZa5-YC5PAFN9-yhIUc7-LnEIqEcYLFcX3D6v7ymArnCy1tTALUSF_CmAgXIE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv3m2_2ME18Vs--k31WgvqEzkkd7vqzeHKw1qcFK0qJ9g&oe=69A6E5EB"}, {"file_name": "countryside.png", "id": "829620639320570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393545_829620645987236_1977403622736127236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4TZwBrjUAMQ7kNvwHzkgH6&_nc_oc=AdkGiGSwgEpg9R4NgcLYzxcxinyACBpyhQD51MfjrpAKN7q2kZUG7oAy9bC4alSlECA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvEyuC8oV-MmY9BXYoHbFPWgtYCYByNHw0Q_sB5C0WKEA&oe=69A6DF81"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LingoVerse", "keywords": ["language", "adventure", "learning"], "long_description": "# Step into LingoVerse \u2013 The Ultimate German Learning Adventure!  \n\nLearning German has never been this immersive! **LingoVerse** takes language learning to the next level by placing you in interactive, fully voice-enabled environments where you can practice speaking with lifelike characters. Whether you\u2019re navigating a bustling city, exploring the countryside, cooking in a cozy kitchen, or sitting in a classroom, every interaction helps you improve your fluency in a fun and natural way.  \n\n## Key Features:  \n-  \ud83d\udde3 **Advanced Speech Recognition** with deep learning models\n- \ud83c\udf0d **Dynamic Environments** \u2013 Explore a **city**, the **countryside**, a **kitchen**, and a **classroom**, each designed to enhance different aspects of your language skills.  \n- \ud83c\udfae **Fun Minigames** \u2013 Boost your vocabulary by hunting for the right objects in each scene, reinforcing word associations in a hands-on way.  \n\n**Download LingoVerse now and step into fluency!** \ud83d\ude80\ud83c\udfa7  \n\n\n", "short_description": "LingoVerse transforms learning German into an immersive adventure! Step into vibrant environments filled with unique characters ready to chat with you in real-time conversations. Expand your vocabulary by interacting with objects around you, making learning both natural and intuitive. Whether you're a beginner or looking to sharpen your skills, LingoVerse makes mastering German both fun and effective!"}]}, "developer_name": "Laboratory for Computer Graphics and Multimedia at FRI-UL", "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/lingoverse-privacy-policy/c32d666a-838b-4f25-bf17-22b14d5f5a3f/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/lingoverse-terms-of-use/31e9945d-b3d0-4d31-b6c9-9553dbaf1800/terms", "publisher_name": "Laboratory for Computer Graphics and Multimedia at FRI-UL", "support_website_url": null, "website_url": "https://lgm.fri.uni-lj.si/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "2691890164460465"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24656540377365576"}, "review_messages": []}]}, "cover_square_image": {"
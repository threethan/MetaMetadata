sAJCA&_nc_oc=AdoXq0WvZSb8ELBwZCXEKyGr7YNKcjEtpZW_qdOA1FvLo7fGdz3kxcFaGPQCv76Pw9U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUzxCruW0mw3IZFHBCK2urXoWJzoZ8YKW0x2bpwMjGsxw&oe=6B106970"}, {"file_name": "picking_up_objects.png", "id": "3146461728839334", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393228_3146461732172667_3706287487870115736_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvpJXRLhZf4Q7kNvwEj7KjJ&_nc_oc=AdrrYg-EYamLuj6UvI9Qc-HE1XgL2mqPWOkFuGOPb_QD5JmlP0AwKt5QdFCpDXRg3RI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXXIm6fzyYhZaJfY4EKjFuADpb5ikEePZ1UbZgcAxW53g&oe=6B10677C"}, {"file_name": "multi_choice_example.png", "id": "3934472840166071", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391716_3934472846832737_5111795480125325401_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQuNSMGDzuMQ7kNvwElBPt0&_nc_oc=Adq7A7Tg62JXxZcFAOTBe-PkpTrJ8c_n_ckjHfozkcXIH8nECu9Uo9UwLg4FjjgweNU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXJEd79lZpoLIK-1GAsPTp4g7ci0aKAhVg-Rk3NQPhZpA&oe=6B10592B"}, {"file_name": "countryside.png", "id": "829620639320570", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393545_829620645987236_1977403622736127236_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPF-k8pUkukQ7kNvwEzjEJd&_nc_oc=Adpphnbabo_Kh-gZLLgcHmHQxtRZ11qFBvoLyMW-OcFJwQ-caFeSpCMlrojYlQ5IH1Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXSRMlSn3VqjeDKLkoh8TAavxmPRv86wdY1b4ULcefrPA&oe=6B1052C1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LingoVerse", "keywords": ["language", "adventure", "learning"], "long_description": "# Step into LingoVerse \u2013 The Ultimate German Learning Adventure!  \n\nLearning German has never been this immersive! **LingoVerse** takes language learning to the next level by placing you in interactive, fully voice-enabled environments where you can practice speaking with lifelike characters. Whether you\u2019re navigating a bustling city, exploring the countryside, cooking in a cozy kitchen, or sitting in a classroom, every interaction helps you improve your fluency in a fun and natural way.  \n\n## Key Features:  \n-  \ud83d\udde3 **Advanced Speech Recognition** with deep learning models\n- \ud83c\udf0d **Dynamic Environments** \u2013 Explore a **city**, the **countryside**, a **kitchen**, and a **classroom**, each designed to enhance different aspects of your language skills.  \n- \ud83c\udfae **Fun Minigames** \u2013 Boost your vocabulary by hunting for the right objects in each scene, reinforcing word associations in a hands-on way.  \n\n**Download LingoVerse now and step into fluency!** \ud83d\ude80\ud83c\udfa7  \n\n\n", "short_description": "LingoVerse transforms learning German into an immersive adventure! Step into vibrant environments filled with unique characters ready to chat with you in real-time conversations. Expand your vocabulary by interacting with objects around you, making learning both natural and intuitive. Whether you're a beginner or looking to sharpen your skills, LingoVerse makes mastering German both fun and effective!"}]}, "developer_name": "Laboratory for Computer Graphics and Multimedia at FRI-UL", "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/lingoverse-privacy-policy/c32d666a-838b-4f25-bf17-22b14d5f5a3f/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/lingoverse-terms-of-use/31e9945d-b3d0-4d31-b6c9-9553dbaf1800/terms", "publisher_name": "Laboratory for Computer Graphics and Multimedia at FRI-UL", "support_website_url": null, "website_url": "https://lgm.fri.uni-lj.si/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "26918901644604
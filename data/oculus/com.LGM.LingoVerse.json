_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmjb5YhU6P0Q7kNvwEyV7u2&_nc_oc=AdmOcPmc563SzYiXjGih7gY25ZT7DOv0hEvB1odJH54QaVD03twFXXkf7UqoI_O_HTY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFLpwLMh2LcGan-Q2amjqgz8egF8Iclv1hLKct_KWGKQ&oe=69B147FC"}, {"file_name": "multi_choice_example.png", "id": "3934472840166071", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391716_3934472846832737_5111795480125325401_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LnlP1bbXDoQ7kNvwGnrxL9&_nc_oc=Adns0imKSulB4xjJFTizj4JRKDgWWiSS7RuPtGLAd1qDZ4k5lmHsE3f16-DtSduJuHE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzdVjWqEcrCQfEVksghJbqnpPI-mqIfJCOZ1iG7nh4QA&oe=69B171EB"}, {"file_name": "countryside.png", "id": "829620639320570", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393545_829620645987236_1977403622736127236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSglPfBKaQcQ7kNvwHmSgNB&_nc_oc=AdkgtC6Vt_x7RdE0hUoB4d4MfUzSRRNbTckWBqil1wSL7rVCZlO3nHLsx-G6DL4nPJw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSx0JQvWW6GG6YUMD9lFoOP5MOX13MA-EjCUMtL5y8Ng&oe=69B16B81"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LingoVerse", "keywords": ["language", "adventure", "learning"], "long_description": "# Step into LingoVerse \u2013 The Ultimate German Learning Adventure!  \n\nLearning German has never been this immersive! **LingoVerse** takes language learning to the next level by placing you in interactive, fully voice-enabled environments where you can practice speaking with lifelike characters. Whether you\u2019re navigating a bustling city, exploring the countryside, cooking in a cozy kitchen, or sitting in a classroom, every interaction helps you improve your fluency in a fun and natural way.  \n\n## Key Features:  \n-  \ud83d\udde3 **Advanced Speech Recognition** with deep learning models\n- \ud83c\udf0d **Dynamic Environments** \u2013 Explore a **city**, the **countryside**, a **kitchen**, and a **classroom**, each designed to enhance different aspects of your language skills.  \n- \ud83c\udfae **Fun Minigames** \u2013 Boost your vocabulary by hunting for the right objects in each scene, reinforcing word associations in a hands-on way.  \n\n**Download LingoVerse now and step into fluency!** \ud83d\ude80\ud83c\udfa7  \n\n\n", "short_description": "LingoVerse transforms learning German into an immersive adventure! Step into vibrant environments filled with unique characters ready to chat with you in real-time conversations. Expand your vocabulary by interacting with objects around you, making learning both natural and intuitive. Whether you're a beginner or looking to sharpen your skills, LingoVerse makes mastering German both fun and effective!"}]}, "developer_name": "Laboratory for Computer Graphics and Multimedia at FRI-UL", "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/lingoverse-privacy-policy/c32d666a-838b-4f25-bf17-22b14d5f5a3f/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/lingoverse-terms-of-use/31e9945d-b3d0-4d31-b6c9-9553dbaf1800/terms", "publisher_name": "Laboratory for Computer Graphics and Multimedia at FRI-UL", "support_website_url": null, "website_url": "https://lgm.fri.uni-lj.si/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "2691890164460465"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_mode
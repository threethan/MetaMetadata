I6Sht&_nc_oc=AdpZ-Pw6eYj3dphfUT33PJjnbRbxQePzXRNxg5Kqhwvx0cgAVJBydVV3DTQqSc3DACI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkrGOLRb1NPGDktslV4zM33TAlUSTNosL1sx_uLDqaBA&oe=6AFF0DB0"}, {"file_name": "picking_up_objects.png", "id": "3146461728839334", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393228_3146461732172667_3706287487870115736_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMK5BQOBtFwQ7kNvwES3sQP&_nc_oc=AdoIU4fOPowa2az5f2F6cU_T6PZvEZW4v5OB2U8YiUqn9KCxp2acm9orLMzwrJt76aw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTk7R78zQ369JH6HGNpaRQrPTl9sH8JMybov653BYl_UQ&oe=6AFF0BBC"}, {"file_name": "multi_choice_example.png", "id": "3934472840166071", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391716_3934472846832737_5111795480125325401_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1a3V14gh2qIQ7kNvwG1a8gb&_nc_oc=Ado09QRwL_HkdY2ItCWesCWNlUVbb3_UkPDFG0zbxpEavQtWNwZJln7i6JIL7eFMWXY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdI-L-bVSfmMTRl9SsXGxUISqh0oAMtfb-5llYL2cEEQ&oe=6AFF35AB"}, {"file_name": "countryside.png", "id": "829620639320570", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393545_829620645987236_1977403622736127236_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxIBuaW37d4Q7kNvwEf5E_n&_nc_oc=Adp_CsyIzLlu8lGre_znBf9Pd-MGp3P3cu52sOoDrdG42LhAhGtlwGEEhG4pIePUAgU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSB_GJ2S4BzPOWNLY_LUWRqb8lFxxA-CW2oo9PTNkCYJA&oe=6AFF2F41"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LingoVerse", "keywords": ["language", "adventure", "learning"], "long_description": "# Step into LingoVerse \u2013 The Ultimate German Learning Adventure!  \n\nLearning German has never been this immersive! **LingoVerse** takes language learning to the next level by placing you in interactive, fully voice-enabled environments where you can practice speaking with lifelike characters. Whether you\u2019re navigating a bustling city, exploring the countryside, cooking in a cozy kitchen, or sitting in a classroom, every interaction helps you improve your fluency in a fun and natural way.  \n\n## Key Features:  \n-  \ud83d\udde3 **Advanced Speech Recognition** with deep learning models\n- \ud83c\udf0d **Dynamic Environments** \u2013 Explore a **city**, the **countryside**, a **kitchen**, and a **classroom**, each designed to enhance different aspects of your language skills.  \n- \ud83c\udfae **Fun Minigames** \u2013 Boost your vocabulary by hunting for the right objects in each scene, reinforcing word associations in a hands-on way.  \n\n**Download LingoVerse now and step into fluency!** \ud83d\ude80\ud83c\udfa7  \n\n\n", "short_description": "LingoVerse transforms learning German into an immersive adventure! Step into vibrant environments filled with unique characters ready to chat with you in real-time conversations. Expand your vocabulary by interacting with objects around you, making learning both natural and intuitive. Whether you're a beginner or looking to sharpen your skills, LingoVerse makes mastering German both fun and effective!"}]}, "developer_name": "Laboratory for Computer Graphics and Multimedia at FRI-UL", "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/lingoverse-privacy-policy/c32d666a-838b-4f25-bf17-22b14d5f5a3f/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/lingoverse-terms-of-use/31e9945d-b3d0-4d31-b6c9-9553dbaf1800/terms", "publisher_name": "Laboratory for Computer Graphics and Multimedia at FRI-UL", "support_website_url": null, "website_url": "https://lgm.fri.uni-lj.si/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "26918901644604
1.oculuscdn.com/v/t64.5771-25/499618444_1889401621739752_8904061124924124698_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8i1ElNw84AQ7kNvwHCaMEg&_nc_oc=Adq9yagWDtsQEw5kZRM6YpUv1aQ4V2EqoWAWVHJXgXIhKDt8Zmw2mu96VIs5B6upv1I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1R--Dhqiu93yEMt3g0cO7b13wtOjG-2_DXbtLHAPGmTQ&oe=69F0CC3D"}, "display_name": "Subspace Battle Simulator", "keywords": ["battlesimulator", "bs", "simulator", "subspace"], "long_description": "Step into the ultimate battlefield with Subspace Battle Simulator: VR Edition! Immerse yourself in chaotic, cartoon-style warfare as you command epic armies across stunning virtual battlefields. Take direct control of legendary warriors, fearsome dragons, and powerful mages, or orchestrate large-scale battles from a god's-eye view. With intuitive VR controls, you'll dodge arrows, cast devastating spells, and lead your troops to victory in real-time. Experience hilarious ragdoll physics, dynamic environmental destruction, and endless strategic possibilities. Whether you're a casual gamer looking for laughs or a strategy enthusiast craving tactical depth, this VR adaptation delivers an unmatched combat experience. ", "short_description": "The game offers a top-down perspective and a first-person VR experience. It is played based on a sandbox simulation and PVE (Player vs. Environment) challenges. The game provides over a dozen different types of combat units, and players can freely combine and configure them to build their own most powerful army to defeat the enemies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sbs.xuking.tech/privacy/", "developer_terms_of_service_url": null, "publisher_name": "SpatialXR", "support_website_url": null, "website_url": "https://sbs.xuking.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id"
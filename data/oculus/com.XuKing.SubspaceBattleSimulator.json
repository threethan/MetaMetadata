deo_trailer": null, "video_trailer_thumbnail": {"file_name": "SBS-1.png", "id": "1889401618406419", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618444_1889401621739752_8904061124924124698_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CpeCBITLKX4Q7kNvwEdPeAY&_nc_oc=Adr4cC9pX_uITMHgT5AlhBHQOGdwjQ8caynF8Xa6arVFo90C3tDvF8zBCL-ceFwh7RE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2MHKTmF9Kqpb3X4bECOnXauf1ixrGUhs-XAwOv0pbGA&oe=6AC9023D"}, "display_name": "Subspace Battle Simulator", "keywords": ["battlesimulator", "bs", "simulator", "subspace"], "long_description": "Step into the ultimate battlefield with Subspace Battle Simulator: VR Edition! Immerse yourself in chaotic, cartoon-style warfare as you command epic armies across stunning virtual battlefields. Take direct control of legendary warriors, fearsome dragons, and powerful mages, or orchestrate large-scale battles from a god's-eye view. With intuitive VR controls, you'll dodge arrows, cast devastating spells, and lead your troops to victory in real-time. Experience hilarious ragdoll physics, dynamic environmental destruction, and endless strategic possibilities. Whether you're a casual gamer looking for laughs or a strategy enthusiast craving tactical depth, this VR adaptation delivers an unmatched combat experience. ", "short_description": "The game offers a top-down perspective and a first-person VR experience. It is played based on a sandbox simulation and PVE (Player vs. Environment) challenges. The game provides over a dozen different types of combat units, and players can freely combine and configure them to build their own most powerful army to defeat the enemies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sbs.xuking.tech/privacy/", "developer_terms_of_service_url": null, "publisher_name": "SpatialXR", "support_website_url": null, "website_url": "https://sbs.xuking.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comf
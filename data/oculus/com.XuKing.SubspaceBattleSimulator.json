00&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKnebWbUlBYQ7kNvwF-WsDE&_nc_oc=AdoYyHD4mLeDMimZ2ydmsCrGXO7TR4IMi2i6MtJAGsfvvNmnY34DXDT2lYElVf19m18&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJRopZe-UhIn0I-qiu-3Fc0LqBp7sEfm3WenWJkXwIJw&oe=6AFDAF48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "jimeng-2026-03-05-6484-\u5728\u56fe\u7247\u6b63\u4e2d\u95f4\u6dfb\u52a0\u6807\u9898\u4e3a\u201cSubspace Battle Simulator\u201d\u7684\u6e38....png", "id": "1508669084237632", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618442_1508669090904298_6092956307201147727_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3_F5kQARUkQ7kNvwESZMUu&_nc_oc=AdrRKST0xMGu26McR9lyLOL6yYmyxriDLxG7aj-5ZOs4xabWchDii_pAv5Bii59Dqd4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp0TQXxNiszOC_PIDoOxYQTmHi26eN3rNSiSweh2sz8g&oe=6AFDC2C5"}, "display_name": "Subspace Battle Simulator", "keywords": ["battlesimulator", "bs", "simulator", "subspace"], "long_description": "Step into the ultimate battlefield with Subspace Battle Simulator: VR Edition! Immerse yourself in chaotic, cartoon-style warfare as you command epic armies across stunning virtual battlefields. Take direct control of legendary warriors, fearsome dragons, and powerful mages, or orchestrate large-scale battles from a god's-eye view. With intuitive VR controls, you'll dodge arrows, cast devastating spells, and lead your troops to victory in real-time. Experience hilarious ragdoll physics, dynamic environmental destruction, and endless strategic possibilities. Whether you're a casual gamer looking for laughs or a strategy enthusiast craving tactical depth, this VR adaptation delivers an unmatched combat experience. ", "short_description": "The game offers a top-down perspective and a first-person VR experience. It is played based on a sandbox simulation and PVE (Player vs. Environment) challenges. The game provides over a dozen different types of combat units, and players can freely combine and configure them to build their own most powerful army to defeat the enemies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sbs.xuking.tech/privacy/", "developer_terms_of_service_url": null, "publisher_name": "SpatialXR", "support_website_url": null, "website_url": "https://sbs.xuking.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "275629210202852"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "25947580004922255"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26002498566097065", "version": "1.6.3"}, "id": "1135414781293445", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8818417124931810", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26002498566097065"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1135414781293445"}]}, "change_log": null, "created_date": 1773661139, "id": "26002498566097065", "version": 
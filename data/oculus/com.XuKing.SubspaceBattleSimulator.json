dXIQ7kNvwGl3e5L&_nc_oc=AdpWsHKtS7wRqijQ4GsqYLzJAKDyHm74CFEQaFGJFkJL2gdEJzYW5mdYdVhbaaVvNlw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0fHXmzDuDC_MqHmg4NaADZr6yHSdC2_gSMI278qbn4bg&oe=69F2037E"}, {"file_name": "\u622a\u56fe5.png", "id": "1362546745889655", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618064_1362546749222988_7147808010835857873_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_1685tL9hoQ7kNvwFYLzlY&_nc_oc=AdqArrneEPex9w845UnMT0v5U0Qh9alLQ0j6QPuYvVDM86zPFpZeKNkWJ9q7FVVFWrQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af35VfwjO6Xofc6CSthQKP5Qq1k_OmtZXwgPVsBH0ga-8Q&oe=69F1F24D"}, {"file_name": "\u622a\u56fe4.png", "id": "1558555235241534", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617831_1558555238574867_8128509811784223399_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpIxGKmAzoAQ7kNvwGjuiJk&_nc_oc=AdrxlEvqHnK4P3pqmW73J6ZqpwxFep4En81U4zp6IqEqwIp04k3KUvhc8GtqSC-VIr8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0_cL-5X_iO_BTTSl3EdHQ7WiuvFPw2A2Ie7O9S1Z9Y4w&oe=69F20CBD"}, {"file_name": "\u622a\u56fe2.png", "id": "892745477081437", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618264_892745480414770_6527761957572281477_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkHSyo7rtZgQ7kNvwH-bI4K&_nc_oc=AdqQR4YjVl8qRx4TN9e2dRqDH1P6rZUEuPF8v9thC1ZvnsIIdDvh_CjkFE4f3u3T8rs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1jwjsi-aefYEdoMr-C7aYwp4cP_o3V1ifdiC5mxasWMA&oe=69F20EC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "jimeng-2026-03-05-6484-\u5728\u56fe\u7247\u6b63\u4e2d\u95f4\u6dfb\u52a0\u6807\u9898\u4e3a\u201cSubspace Battle Simulator\u201d\u7684\u6e38....png", "id": "1508669084237632", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618442_1508669090904298_6092956307201147727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMgcosUelrcQ7kNvwFAUSGP&_nc_oc=AdqHc--oy6pEBu9gW_gmFdUhCjNSwWIRN107qHrDyFsw2rSYV2ykxQpIJQ1L5--6c04&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3g70CalidKIqa5TVj33JHYtkUAGPwlgk13XkHETDWX9Q&oe=69F1EA05"}, "display_name": "Subspace Battle Simulator", "keywords": ["battlesimulator", "bs", "simulator", "subspace"], "long_description": "Step into the ultimate battlefield with Subspace Battle Simulator: VR Edition! Immerse yourself in chaotic, cartoon-style warfare as you command epic armies across stunning virtual battlefields. Take direct control of legendary warriors, fearsome dragons, and powerful mages, or orchestrate large-scale battles from a god's-eye view. With intuitive VR controls, you'll dodge arrows, cast devastating spells, and lead your troops to victory in real-time. Experience hilarious ragdoll physics, dynamic environmental destruction, and endless strategic possibilities. Whether you're a casual gamer looking for laughs or a strategy enthusiast craving tactical depth, this VR adaptation delivers an unmatched combat experience. ", "short_description": "The game offers a top-down perspective and a first-person VR experience. It is played based on a sandbox simulation and PVE (Player vs. Environment) challenges. The game provides over a dozen different types of combat units, and players can freely combine and configure them to build their own most powerful army to defeat the enemies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sbs.xuking.tech/privacy/", "developer_terms_of_service_url": null, "publisher_name": "SpatialXR", "support_website_url": null, "website_url": "https://sbs.xuking.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "275629210202852"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommen
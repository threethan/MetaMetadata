BDQascVcz5t4AsY30LH14HLQ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af34Bk91AxksL_77Q19Ol4uhbDBQl2dAm5v9_T3UNKWVaw&oe=69F0B1FE"}, {"file_name": "\u622a\u56fe5.png", "id": "1362546745889655", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618064_1362546749222988_7147808010835857873_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpVe6sNmP84Q7kNvwGdUmZi&_nc_oc=AdrU3XKk1Z3w6Nh_d8N0hCPydan5KICZTRZ2AJ1z4lSD-pGBnpA7tQxfYUq7cp5X6qw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0c0qZimpVvUOoR4-P_RJQ4TNZ2UT-TubX1PmMbe0LMIA&oe=69F0A0CD"}, {"file_name": "\u622a\u56fe4.png", "id": "1558555235241534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617831_1558555238574867_8128509811784223399_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpIxGKmAzoAQ7kNvwFZLH15&_nc_oc=Ado3FuwHMBz_X6TftmGIPRU9oSx_C0HLPNPBVWILsxP-GHW0oRMbMD0Fug-rafK4uxw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3ueqCvODU7EFLOXx_89X88O_SDT677scd9_q16juq6wA&oe=69F0BB3D"}, {"file_name": "\u622a\u56fe2.png", "id": "892745477081437", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618264_892745480414770_6527761957572281477_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkHSyo7rtZgQ7kNvwGFyt3S&_nc_oc=Ado3gxYBhCd9wBufcM4jn4CDG3beTzao6QWJLB9L0aO7lDBsmXRWmZT7a7oOwYLoS8s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1xBD1AFCyAe_dprZkG011nDaqeiK-5XON89vGtefVh4w&oe=69F0BD48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "jimeng-2026-03-05-6484-\u5728\u56fe\u7247\u6b63\u4e2d\u95f4\u6dfb\u52a0\u6807\u9898\u4e3a\u201cSubspace Battle Simulator\u201d\u7684\u6e38....png", "id": "1508669084237632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618442_1508669090904298_6092956307201147727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMgcosUelrcQ7kNvwFDMRkS&_nc_oc=AdoES4jydIncLZVEPgP5JRVm7HZXO_-G78wyUIg6FIe5idhzbLWYMnIzSHxtFNNCauE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af10hvqrvKWUsYduQEWwNpjKKDJkU6GokOQ_CgR5Ygqu6g&oe=69F0D0C5"}, "display_name": "Subspace Battle Simulator", "keywords": ["battlesimulator", "bs", "simulator", "subspace"], "long_description": "Step into the ultimate battlefield with Subspace Battle Simulator: VR Edition! Immerse yourself in chaotic, cartoon-style warfare as you command epic armies across stunning virtual battlefields. Take direct control of legendary warriors, fearsome dragons, and powerful mages, or orchestrate large-scale battles from a god's-eye view. With intuitive VR controls, you'll dodge arrows, cast devastating spells, and lead your troops to victory in real-time. Experience hilarious ragdoll physics, dynamic environmental destruction, and endless strategic possibilities. Whether you're a casual gamer looking for laughs or a strategy enthusiast craving tactical depth, this VR adaptation delivers an unmatched combat experience. ", "short_description": "The game offers a top-down perspective and a first-person VR experience. It is played based on a sandbox simulation and PVE (Player vs. Environment) challenges. The game provides over a dozen different types of combat units, and players can freely combine and configure them to build their own most powerful army to defeat the enemies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sbs.xuking.tech/privacy/", "developer_terms_of_service_url": null, "publisher_name": "SpatialXR", "support_website_url": null, "website_url": "https://sbs.xuking.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "275629210202852"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": n
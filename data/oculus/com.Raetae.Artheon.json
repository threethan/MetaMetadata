fra5-1.oculuscdn.com/v/t64.5771-25/499308349_730903262732969_495347523220515767_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RP_rfj7B-T4Q7kNvwFeK2AH&_nc_oc=AdpPiElZczHw3OL5lXYTYlov0AXBkCnjuC71mOZFocYireNsLPMYnzMCORlugBhmmLA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqX_01eYSbZHEZsxYpaLTxTWEurBJ0LY-e9e6qoJKJDA&oe=6A8828F3"}, {"file_name": "HighresScreenshot00000c.png", "id": "748848907579017", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499304748_748848910912350_2120876843792527687_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y15U3OSSV3wQ7kNvwF77mwG&_nc_oc=Adr1cOlwesFWWsYrDeKeswsZIbUIbiFD3WywJBh87ky-FBAQiceCZxrdMiGlgkKr3Ec&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtc_df0OUIM1bM8EcccZX17BKD57ZYed34PHXZdKhYZw&oe=6A883067"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Artheon \u2013 The Living Museum", "keywords": ["art", "gallery", "sculpture", "egypt", "exhibition"], "long_description": "Welcome to Artheon \u2013 The Living Museum, a captivating VR experience that brings the beauty of art to life. Explore a detailed exhibition where each painting is faithfully recreated, while your guide accompanies you and introduces each piece with context and insight.\n\nEnjoy a peaceful and elegant atmosphere that lets you appreciate art at your own pace.\n\nThis is just the beginning. New halls, artworks, and features will be added regularly, expanding the experience into a rich and ever-growing virtual museum. Ideal for both casual visitors and devoted art lovers.", "short_description": "Step into Artheon \u2013 The Living Museum, a relaxing and immersive VR art gallery where a personal guide walks you through each masterpiece. Explore the first exhibition hall, with many more coming soon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/artheon-the-living-museum-privacy-policy/c9a78817-b9c8-427b-acb9-57922de67259/privacy", "deve
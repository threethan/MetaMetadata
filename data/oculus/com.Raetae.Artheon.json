7_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_vJN4RoiwYQ7kNvwGn9jTw&_nc_oc=AdquQyUnfSa1lmvNCabIoH8-t2T3yzHjWYjQJBPoUW_-hFkYrX-cMRTDJ4uJdxxQ5eI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0QXf6XQJsLgfkTkNORWyzd-50rQXTCyzz29gi64GvT0A&oe=69F21633"}, {"file_name": "HighresScreenshot00000c.png", "id": "748848907579017", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304748_748848910912350_2120876843792527687_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zw4wsdWNzOgQ7kNvwEVn0zC&_nc_oc=AdrwiiErakXLx2cL5Doag2HAkm5l01RYJk0WB5byP1CtYEh7XJbGF15VD6xZZReUr08&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1xLlwSbnVOOX7ym38iSmMI-IAKneMZ21NaEZDF-XSKAw&oe=69F1E567"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Artheon \u2013 The Living Museum", "keywords": ["art", "gallery", "sculpture", "egypt", "exhibition"], "long_description": "Welcome to Artheon \u2013 The Living Museum, a captivating VR experience that brings the beauty of art to life. Explore a detailed exhibition where each painting is faithfully recreated, while your guide accompanies you and introduces each piece with context and insight.\n\nEnjoy a peaceful and elegant atmosphere that lets you appreciate art at your own pace.\n\nThis is just the beginning. New halls, artworks, and features will be added regularly, expanding the experience into a rich and ever-growing virtual museum. Ideal for both casual visitors and devoted art lovers.", "short_description": "Step into Artheon \u2013 The Living Museum, a relaxing and immersive VR art gallery where a personal guide walks you through each masterpiece. Explore the first exhibition hall, with many more coming soon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/artheon-the-living-museum-privacy-policy/c9a78817-b9c8-427b-acb9-57922de67259/privacy", "developer_terms_of_service_url": null, "publisher_name": "Raetae Studios", "suppor
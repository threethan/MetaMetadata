NvwG-5oxt&_nc_oc=Adk7-RgQ0NiM3mxSQqSlGfAPBbF54QarlDVKtjMGvEbz1gptCEdV9rOg2Ja_qshOCzs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftNQfjoPbXEmwKcNzZQ3mHHwRSHCwwYR6JEjlPFaQQxPQ&oe=6999C1B3"}, {"file_name": "HighresScreenshot00000c.png", "id": "748848907579017", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304748_748848910912350_2120876843792527687_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuMUvnz49i4Q7kNvwF3chCt&_nc_oc=Adki2sQjcYLejTggtj-CajUw1BFtmKvQYpH6EP2xPChGgbRuBH6VbeFDPDzbJ3bu2yw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuV_VeMKlOG2rvyBIQo6sk-9DAO4iWCGEBpzVzYjzKouQ&oe=699990E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Artheon \u2013 The Living Museum", "keywords": ["art", "gallery", "sculpture", "egypt", "exhibition"], "long_description": "Welcome to Artheon \u2013 The Living Museum, a captivating VR experience that brings the beauty of art to life. Explore a detailed exhibition where each painting is faithfully recreated, while your guide accompanies you and introduces each piece with context and insight.\n\nEnjoy a peaceful and elegant atmosphere that lets you appreciate art at your own pace.\n\nThis is just the beginning. New halls, artworks, and features will be added regularly, expanding the experience into a rich and ever-growing virtual museum. Ideal for both casual visitors and devoted art lovers.", "short_description": "Step into Artheon \u2013 The Living Museum, a relaxing and immersive VR art gallery where a personal guide walks you through each masterpiece. Explore the first exhibition hall, with many more coming soon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/artheon-the-living-museum-privacy-policy/c9a78817-b9c8-427b-acb9-57922de67259/privacy", "developer_terms_of_service_url": null, "publisher_name": "Raetae Studios", "support_website_url": null, "website_url": "https://artheon.rf.gd/", "category": null, "comfort_r
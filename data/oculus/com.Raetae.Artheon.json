NvwHu6WsJ&_nc_oc=Adl9EURJ6itT562XKMVhI114JKKn57CrccNDOQqxLpCSybWmSkzJfF4ObBPVjKdVat8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft2zdgSZ9SvKBA3V6FvryhV7U0JAzHboZaz1gx10bL_Rw&oe=699B1333"}, {"file_name": "HighresScreenshot00000c.png", "id": "748848907579017", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304748_748848910912350_2120876843792527687_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuMUvnz49i4Q7kNvwHxpbYw&_nc_oc=AdnhgqeNRMP0CGzW4bB8_5owPRYUg5hmyQFrOXMKBpJwVomnzAmx27k2TcT-J2DTSBk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfunGH0yvQWFuPkTYT8rzI6Z_f7QiVTbQfzmyEBSo5dJmw&oe=699AE267"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Artheon \u2013 The Living Museum", "keywords": ["art", "gallery", "sculpture", "egypt", "exhibition"], "long_description": "Welcome to Artheon \u2013 The Living Museum, a captivating VR experience that brings the beauty of art to life. Explore a detailed exhibition where each painting is faithfully recreated, while your guide accompanies you and introduces each piece with context and insight.\n\nEnjoy a peaceful and elegant atmosphere that lets you appreciate art at your own pace.\n\nThis is just the beginning. New halls, artworks, and features will be added regularly, expanding the experience into a rich and ever-growing virtual museum. Ideal for both casual visitors and devoted art lovers.", "short_description": "Step into Artheon \u2013 The Living Museum, a relaxing and immersive VR art gallery where a personal guide walks you through each masterpiece. Explore the first exhibition hall, with many more coming soon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/artheon-the-living-museum-privacy-policy/c9a78817-b9c8-427b-acb9-57922de67259/privacy", "developer_terms_of_service_url": null, "publisher_name": "Raetae Studios", "support_website_url": null, "website_url": "https://artheon.rf.gd/", "category": null, "comfort_r
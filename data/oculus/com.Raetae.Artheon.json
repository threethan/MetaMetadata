iad6-1.oculuscdn.com/v/t64.5771-25/499308349_730903262732969_495347523220515767_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoUCmQFXtV0Q7kNvwHkTdgU&_nc_oc=AdpJR5DTSQv6aZe3hd3AW2Q-yD0tkkJQ2EggbFvbAhpopQwcAYdAORnw1H25lcRcOmo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh0xsyy3rWEcEIeHymmYwp_ss0_6MRJa4fbCrexV5g6g&oe=6A70A633"}, {"file_name": "HighresScreenshot00000c.png", "id": "748848907579017", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304748_748848910912350_2120876843792527687_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWfRzDuOvQMQ7kNvwFhed2J&_nc_oc=Adp-QYv2Reuyd-jZg-gh16Aljq5K4Uf3qb80suhyBH5PVCjM9x2irmvqzr7IsiC6cmI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRoBLyeGUcTr8D__9_0yDMjxmzOpufH36dPbeZI1r4UA&oe=6A707567"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Artheon \u2013 The Living Museum", "keywords": ["art", "gallery", "sculpture", "egypt", "exhibition"], "long_description": "Welcome to Artheon \u2013 The Living Museum, a captivating VR experience that brings the beauty of art to life. Explore a detailed exhibition where each painting is faithfully recreated, while your guide accompanies you and introduces each piece with context and insight.\n\nEnjoy a peaceful and elegant atmosphere that lets you appreciate art at your own pace.\n\nThis is just the beginning. New halls, artworks, and features will be added regularly, expanding the experience into a rich and ever-growing virtual museum. Ideal for both casual visitors and devoted art lovers.", "short_description": "Step into Artheon \u2013 The Living Museum, a relaxing and immersive VR art gallery where a personal guide walks you through each masterpiece. Explore the first exhibition hall, with many more coming soon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/artheon-the-living-museum-privacy-policy/c9a78817-b9c8-427b-acb9-57922de67259/privacy", "deve
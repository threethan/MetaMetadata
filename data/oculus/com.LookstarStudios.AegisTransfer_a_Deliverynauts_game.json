pLaJNTl4ZfFXOULIIfxw&oe=69FF4B14"}, {"file_name": "fot 5.png", "id": "629242753534735", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303745_629242756868068_8199482687401194448_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Te2TUYwh1zAQ7kNvwFRc01S&_nc_oc=AdrILDxF40wAQ3Efb_KEnRg4vUnktowGZhEwyvfiMP_TaZJPkk3YLnomhWXTavJoJcU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xh4cj2rGiiHpAZi2TJcB15IyBUHe10h6XAGe45H_EDg&oe=69FF279C"}, {"file_name": "fot6.png", "id": "1572805154129647", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303864_1572805157462980_1727557497343604290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpKT9IpE36wQ7kNvwHYx7Q2&_nc_oc=Adquu7Zlb1oMEwLybh0c1vu3_5GTuVfMs0RVILVdECa4T4nPrqO03G4cZgUbigYd-nU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wtfrcUIgyEPh3iaL5H4OmALtakEvX6X0_I35u-S__6Q&oe=69FF4C47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "499311574_737027715930069_3047683297922180698_n.png", "id": "4200619640258786", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822897_4200619643592119_3515316736489904911_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FmszWAGRx0Q7kNvwEoB84d&_nc_oc=AdqVCKj0yzQvr8bFzD6PgX5_kQafBZAbZv956QEVuOS0Un7cha1igTs0bZJyOH7yLac&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HLXlx3jtDLnYj86oG6X7j786QChonNfEViDxGCsQYMg&oe=69FF1BE5"}, "display_name": "Aegis Transfer: A Deliverynauts Game", "keywords": ["Defense", "Space", "Gunner", "Deliverynauts", "SciFi"], "long_description": "**The game is currently in Early Access. It will receive updates improving gameplay, adding new features, refining visuals, and expanding content until full release.**\n\n**About the Game**\n\nThe events happen 200 years in the future. Humanity\u2019s economy runs on orbital transfers \u2014 massive hauler ships sling precious cargo between moons, planets, and stations using precise gravitational maneuvers. But during these vulnerable slingshot phases the ship becomes an easy prey for outlaws, scavengers, and mercenary raiders.\n\nYou are the last line of defense.\n\nAssigned as a contractor aboard the cargo ship, your job is to operate the vessel\u2019s defense systems and repel incoming threats. Man the main turret, load and arm missile launchers, monitor system integrity, and keep the ship alive long enough to complete the maneuver. When alarms sound, you don\u2019t run \u2014 you lock in, load up, and hold the line.", "short_description": "Aegis Transfer is a fast-paced VR turret defense game where you protect massive transport ships during dangerous slingshot maneuvers. Man your station, load missiles, and fight off waves of outlaw attackers in retro-futuristic space combat. Every shot counts."}]}, "developer_name": "Lookstar Studios", "developer_privacy_policy_url": "https://lookstar.pl/aegis-transfer-a-deliverynauts-game-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Lookstar Studios", "support_website_url": null, "website_url": "https://lookstar.pl/aegis-transfer-a-deliverynauts-game/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24142397325414748"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2796007403916576"}]}, "baseline_offer": {"id": "2796007403916576"}, "is_approved": t
c=AdqVCKj0yzQvr8bFzD6PgX5_kQafBZAbZv956QEVuOS0Un7cha1igTs0bZJyOH7yLac&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HLXlx3jtDLnYj86oG6X7j786QChonNfEViDxGCsQYMg&oe=69FF1BE5"}, "display_name": "Aegis Transfer: A Deliverynauts Game", "keywords": ["Defense", "Space", "SciFi", "Ship", "Physics"], "long_description": "**Disclaimer:** This title is currently in Early Access and will be continually updated with new features, environment changes, and more interactive elements.\n\n\nThe events happen 200 years in the future. Humanity\u2019s economy runs on orbital transfers \u2014 massive hauler ships sling precious cargo between moons, planets, and stations using precise gravitational maneuvers. But during these vulnerable slingshot phases the ship becomes an easy prey for outlaws, scavengers, and mercenary raiders.\n\nYou are the last line of defense.\n\nAssigned as a contractor aboard the cargo ship, your job is to operate the vessel\u2019s defense systems and repel incoming threats. Man the main turret, load and arm missile launchers, monitor system integrity, and keep the ship alive long enough to complete the maneuver. When alarms sound, you don\u2019t run \u2014 you lock in, load up, and hold the line.", "short_description": "Protect massive transport ships during dangerous slingshot maneuver. Man your station, load missiles, and fight off waves of outlaw attackers in retro-futuristic space combat. Every shot counts."}]}, "developer_name": "Lookstar Studios", "developer_privacy_policy_url": "https://lookstar.pl/aegis-transfer-a-deliverynauts-game-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Lookstar Studios", "support_website_url": null, "website_url": "https://lookstar.pl/aegis-transfer-a-deliverynauts-game/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id"
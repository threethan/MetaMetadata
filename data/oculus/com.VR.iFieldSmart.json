": "PUBLISHED", "id": "344996571437537"}, {"status": "PUBLISHED", "id": "1440129223607656"}]}, "baseline_offer": {"id": "1440129223607656"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1700235682, "status": "PUBLISHED", "id": "344996571437537"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25852101607781029", "version": "1.6.0"}, "id": "1353660142251342", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6689615214456289", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25852101607781029"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1353660142251342"}]}, "change_log": null, "created_date": 1771322397, "id": "25852101607781029", "version": "1.6.0", "version_code": 35, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6689615214456289", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25852101607781029"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1353660142251342"}]}, "change_log": null, "created_date": 1764851257, "id": "25211924688465394", "version": "1.5.7beta2", "version_code": 34, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6689615214456289", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25852101607781029"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1353660142251342"}]}, "change_log": "iFieldSmart VR - v1.5.7 Beta (Now Live)\n\nThis version contains all the new Meta SDK\u2013based features and related improvements.\n\n[New Features]\n\n\u2022 Overlay UI\n  - Added true overlay UI support so interface can be viewed clearly on top of models and environment.\n\n\u2022 Transparent Model\n  - Introduced transparent model mode to improve visibility of UI and behind-model content during review.\n\n\u2022 Drawing Filters (with Default Option)\n  - Added filters in Drawings panel (e.g., by category/type as configured).\n  - Included a \u201cDefault\u201d option to quickly reset filters back to the original view.\n\n\u2022 Default Options in Observation Fields\n  - Added default selections for Trade, Set, and Level in Observation creation to speed up workflow.\n\n\u2022 Fluid Runtime Data Handling\n  - Improved runtime data handling to make switching between models, drawings, and observations smoother and more consistent.\n\n[Observation Data Fixes]\n\n\u2022 Captured image not showing second time:\n  - Fixed an issue where the captured observation image did not appear on subsequent openings.\n\n\u2022 Image rotation issue:\n  - Resolved incorrect image rotation so captured images now display with proper orientation.\n\n\u2022 Wrong values in DueDate / Levels / Sets:\n  - Corrected mapping and saving of DueDate, Level, and Set fields for observations to ensure accurate data is stored and displayed.\n", "created_date": 1764079656, "id": "25143412651983265", "version": "1.5.7beta", "version_code": 33, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "
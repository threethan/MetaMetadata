n.com&_nc_ss=7f20f&oh=00_Af8s3crWbOIUPTuOAUmv2Z9GUDDCwQYUXXHWl7isDNfAkw&oe=6A466BAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Forgesmith video thumbnail (1).png", "id": "1490907314277421", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162687_1490907324277420_1929344604088303616_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwWTshPAoIoQ7kNvwHFrO_x&_nc_oc=AdqTGbiO-DYBqfJJGqAa3bTkuZtCdK6kn-lTeYsBpsM8gve3vGYqE2DCG-23Yc0TdJM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9h8iLmOfsOH_QVT5LMnfxtgxfSol_y0UbNwQc_sCpjvA&oe=6A4686CD"}, "display_name": "Forgesmith VR", "keywords": ["crafting", "rpg", "fantasy", "medieval", "weapons"], "long_description": "Run a wacky blacksmith\u2019s shop inside an 8-bit fantasy RPG video game in Forgesmith VR! Use a hammer and anvil to smash away at hot metal in time with retro chiptunes to forge swords, axes, and spears for loyal customers. The higher your score, the better quality the weapon. There\u2019s not much time to marvel at your handiwork once the weapon is done, as your customers have quests to finish! Once a customer leaves, watch your patrons battle it out in a randomized roguelike RPG on an \u201880s coin op arcade machine in your shop. Forgesmith VR uses Gear VR\u2019s new motion controls to create the most visceral 8-bit retro roguelike rhythm RPG strategy simulation ever made!", "short_description": "Forgesmith VR uses Gear VR\u2019s new motion controls to create the most visceral 8-bit retro roguelike rhythm RPG strategy simulation ever made! Smash away at hot metal in time with retro chiptunes to forge swords, axes, and spears for loyal customers. The higher your score, the better quality the weapon. Once a customer leaves, watch your patrons battle it out in a randomized roguelike RPG on an \u201880s coin op arcade machine in your shop."}]}, "developer_name": null, "developer_privacy_policy_url": "http://flarb.com/privacy-policy/", "developer_terms_of_serv
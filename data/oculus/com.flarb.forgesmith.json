vHU6TW9ZA&oe=69BD4FAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Forgesmith video thumbnail (1).png", "id": "1490907314277421", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162687_1490907324277420_1929344604088303616_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-P7jJ4NYRfUQ7kNvwEhuQ-9&_nc_oc=AdmKRmrCDdG4awx2ap3xmPB28QWGC63ChTtc_iwTT7LEtpjWUFQ8W17hKSyOA_cTU0Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzEBlBADSidHQVvt7vzT1nTgBlrPZ20TNBtXh6vS5CPVw&oe=69BD328D"}, "display_name": "Forgesmith VR", "keywords": ["crafting", "rpg", "fantasy", "medieval", "weapons"], "long_description": "Run a wacky blacksmith\u2019s shop inside an 8-bit fantasy RPG video game in Forgesmith VR! Use a hammer and anvil to smash away at hot metal in time with retro chiptunes to forge swords, axes, and spears for loyal customers. The higher your score, the better quality the weapon. There\u2019s not much time to marvel at your handiwork once the weapon is done, as your customers have quests to finish! Once a customer leaves, watch your patrons battle it out in a randomized roguelike RPG on an \u201880s coin op arcade machine in your shop. Forgesmith VR uses Gear VR\u2019s new motion controls to create the most visceral 8-bit retro roguelike rhythm RPG strategy simulation ever made!", "short_description": "Forgesmith VR uses Gear VR\u2019s new motion controls to create the most visceral 8-bit retro roguelike rhythm RPG strategy simulation ever made! Smash away at hot metal in time with retro chiptunes to forge swords, axes, and spears for loyal customers. The higher your score, the better quality the weapon. Once a customer leaves, watch your patrons battle it out in a randomized roguelike RPG on an \u201880s coin op arcade machine in your shop."}]}, "developer_name": null, "developer_privacy_policy_url": "http://flarb.com/privacy-policy/", "developer_terms_of_service_url": "http://flarb.com/privacy-policy/", "publisher_name": "FLA
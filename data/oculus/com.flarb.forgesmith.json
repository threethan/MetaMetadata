720305", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162823_430131654007338_3490299860219854848_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhJjXckHgIcQ7kNvwGJCFd9&_nc_oc=AdpSlY9dMfp-ii_EMm_LMv5ndufW4CXjBsQwpxobW-D4z7q1c7W8fSPX0GItH2BUIsc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ5WxhdIi-z2znq0sjhJ9TaeAlxZczIPu9KBeO8S6rjbA&oe=6B0C64EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Forgesmith video thumbnail (1).png", "id": "1490907314277421", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162687_1490907324277420_1929344604088303616_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXkjpKMv1vsQ7kNvwFribMp&_nc_oc=Adoi2fwtPi2rP0XvHg3fOnVrDqZVlO7MvJfnQPU_WgzCTUbp1sdm787EK57d8l0S0ZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSJ8Dw7Qharr7GeHtPlRE-BA_BHK3tj05i8XBSZxebpig&oe=6B0C800D"}, "display_name": "Forgesmith VR", "keywords": ["crafting", "rpg", "fantasy", "medieval", "weapons"], "long_description": "Run a wacky blacksmith\u2019s shop inside an 8-bit fantasy RPG video game in Forgesmith VR! Use a hammer and anvil to smash away at hot metal in time with retro chiptunes to forge swords, axes, and spears for loyal customers. The higher your score, the better quality the weapon. There\u2019s not much time to marvel at your handiwork once the weapon is done, as your customers have quests to finish! Once a customer leaves, watch your patrons battle it out in a randomized roguelike RPG on an \u201880s coin op arcade machine in your shop. Forgesmith VR uses Gear VR\u2019s new motion controls to create the most visceral 8-bit retro roguelike rhythm RPG strategy simulation ever made!", "short_description": "Forgesmith VR uses Gear VR\u2019s new motion controls to create the most visceral 8-bit retro roguelike rhythm RPG strategy simulation ever made! Smash away at hot metal in time with retro chiptunes to forge swords, axes, and spears for loyal customers. The higher your score, the better quality the weapon. Once a customer leaves, watch your patrons battle it out in a randomized roguelike RPG on an \u201880s coin op arcade machine in your shop."}]}, "developer_name": null, "developer_privacy_policy_url": "http://flarb.com/privacy-policy/", "developer_terms_of_service_url": "http://flarb.com/privacy-policy/", "publisher_name": "FLARB LLC", "support_website_url": null, "website_url": "http://forgesmithvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "RPG", "SIMULATION", "ARCADE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "514381719975824"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PENDING", "id": "1042356780628480"}, {"status": "PUBLISHED", "id": "1105887472953150"}, {"status": "PUBLISHED", "id": "513960378987239"}, {"status": "PUBLISHED", "id": "281732659413434"}, {"status": "PUBLISHED", "id": "1525465080831884"}, {"status": "PUBLISHED", "id": "380780805955577"}, {"status": "PUBLISHED", "id": "2451529115172549"}, {"status": "PUBLISHED", "id": "1930650770512721"}, {"status": "PUBLISHED", "id": "817910198393719"}]}, "baseline_offer": {"id": "1525465080831884"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1042356780628480"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1317776028258089", "version": "1.9"}, "id": "1255373541208697
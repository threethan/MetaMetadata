e7a0a&_nc_ohc=PNBOJNLbl10Q7kNvwGX73Rf&_nc_oc=Adp_ZanCtK5kdpJomdkrmMK5blp4JJjhJcOoLzfyPVFzY2W6rkyxv6noeWnBtM96EGU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTonndqEA5_Lbq-OGfuoJqPJ8twjxcuLrCM_6qlvnbdLw&oe=6AFDC4E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "334694281412482", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974654_334694284745815_8646794835019241827_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAhbTxPDV_cQ7kNvwFp_RtT&_nc_oc=AdoGweV3sUc73BOxBmZpiqbdArwx3iQ3P3MdFcQsTg3EpulHvn-FJh-zdaQbVy14cP4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREmysNWc95wul_4mk9XQvtRJvS--pHpSMRFIVcOZjQXg&oe=6AFDAE51"}, "display_name": "DANGER: ELECTRIC SHOCK", "keywords": [], "long_description": "{Game Instructions}\n\nObject:\nGo through a course to the finish line with a rod.\n\nCourse:\nMade up with metal frames in which an electric current flows.\n\nGame Play:\nControl the rod not to touch metal frames.\n\nNote:\nIf you push or pull the rod in order to skip the middle of courses, the game is over.", "short_description": "Don't touch the metal frame. You have to dodge the dangerous traps and reach the goal!"}, {"images": {"nodes": []}, "id": "460748882285122", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DANGER: ELECTRIC SHOCK", "keywords": [], "long_description": "{Spielanleitung}\n\nZiel\nGehe mit einem Stab durch den Kurs zur Ziellinie.\n\nKurs\nBesteht aus Metallrahmen, in denen elektrischer Strom flie\u00dft.\n\nSpielverlauf\nKontrolliere den Stab, damit er nicht die Metallrahmen ber\u00fchrt.\n\nHinweis\nWenn du den Stab ziehst oder schiebst, um die Mitte des Kurses zu \u00fcberspringen, ist das Spiel vorbei.", "short_description": "Weiche den gef\u00e4hrlichen Fallen aus und bew\u00e4ltige dieses Spiel!!"}, {"images": {"nodes": []}, "id": "450297229894162", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DANGER: ELECTRIC SHOCK", "keywords": [], "long_description": "\u30b2\u30fc\u30e0\u306e\u76ee\u7684\u306f\u3001\u30b3\u30fc\u30b9\u3092\u901a\u3063\u3066\u3001\u30ed\u30c3\u30c9\u3092\u30b4\u30fc\u30eb\u307e\u3067\u904b\u3076\u3053\u3068\u3067\u3059\u3002\u30b3\u30fc\u30b9\u3092\u56f2\u3080\u91d1\u5c5e\u67a0\u306b\u306f\u96fb\u6d41\u304c\u6d41\u308c\u3066\u3044\u3066\u3001\u30ed\u30c3\u30c9\u304c\u89e6\u308c\u308b\u3068\u7206\u767a\u3057\u3001\u30b2\u30fc\u30e0\u30aa\u30fc\u30d0\u30fc\u3068\u306a\u308a\u307e\u3059\u3002\u307e\u305f\u3001\u30b3\u30fc\u30b9\u306e\u5916\u306b\u306f\u307f\u51fa\u3057\u3066\u3082\u5931\u6557\u3068\u306a\u308b\u306e\u3067\u3001\u6ce8\u610f\u3057\u307e\u3057\u3087\u3046\u3002\u30ed\u30c3\u30c9\u3092\u4e0a\u624b\u306b\u64cd\u4f5c\u3057\u306a\u304c\u3089\u3001\u5371\u967a\u306a\u308f\u306a\u3092\u907f\u3051\u3001\u30b2\u30fc\u30e0\u3092\u30af\u30ea\u30a2\u3057\u3066\u304f\u3060\u3055\u3044\u3002", "short_description": "\u30b7\u30f3\u30d7\u30eb\u306a\u30a2\u30af\u30b7\u30e7\u30f3\u30d1\u30ba\u30eb\u30b2\u30fc\u30e0\u3067\u3059\u3002\u5371\u967a\u306a\u308f\u306a\u3092\u907f\u3051\u306a\u304c\u3089\u3001\u30ed\u30c3\u30c9\u3092\u904b\u3093\u3067\u30b4\u30fc\u30eb\u3092\u76ee\u6307\u3057\u307e\u3057\u3087\u3046\uff01"}, {"images": {"nodes": []}, "id": "287409586682055", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DANGER: ELECTRIC SHOCK", "keywords": [], "long_description": "{Instrucciones del juego}\n\nObjeto\nAtraviesa un recorrido hasta la l\u00ednea de meta con una barra.\n\nRecorrido\nFormado por armazones met\u00e1licos por los que circula una corriente el\u00e9ctrica.\n\nJuego\nControla que la barra no toque los marcos met\u00e1licos.\n\nNota\nSi empujas o tiras de la barra para saltarte la mitad de los recorridos, el juego se acaba.", "short_description": "\u00a1\u00a1Esquiva las peligrosas trampas y completa este juego!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://redream-studio.jimdosite.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Redream Studio", "support_website_url": null, "website_url": "https://redream-studio.jimdosite.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "en", "fr", "zh_TW", "ja", "es_MX", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "398227958743039"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036700_1578026159211596_338271830850509098_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B28ut_IlCxAQ7kNvwFbjRxz&_nc_oc=AdoxBmLsRzJWjnO-WPY0c4eJ-Ajg8-DQsX6gndbWDduophSIQj4194bgf_BnbSooQgM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQa2KDxJcKEYbt82Q9apQ34V4XVn9vaAcEdkTZZoW6QSA&oe=6AFDDB4C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DANGER: ELECTRIC SHOCK", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1626295850, "lastRevision": {"nodes": [{"id": "1045819702610488", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application":
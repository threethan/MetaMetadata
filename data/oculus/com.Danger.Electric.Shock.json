{"data": {"node": {"__typename": "Application", "id": "3999970416752010", "organization": {"id": "1026624604529998", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "3999970416752010"}]}, "id": "2119191524890740"}]}}, "firstRevision": {"nodes": [{"application": {"id": "3999970416752010", "release_date": 1626295850, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4717607951654916"}, "id": "1065111814013561"}]}}, "binary": {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3999970416752010", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "4717607951654916"}, "release_status": "RELEASED"}, "id": "4717607951654916", "version": "1.3", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED"}, "live_binary": null, "created_date": 1640510364, "id": "1200078373851286", "is_initial_release": false, "name_with_fallback": "v4", "pdp_metadata_with_fallback": {"version": 1, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "398227958743039"}, "release_status": "RELEASED", "id": "3999970416752010"}, "id": "398227958743039", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "3999970416752010", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "193101865987315"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "3050761778576037", "locale": "zh_TW", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DANGER: ELECTRIC SHOCK", "keywords": [], "long_description": "{\u904a\u6232\u8aaa\u660e}\n\n\u76ee\u6a19\n\u624b\u6301\u96fb\u6d41\u6025\u6025\u68d2\u7a7f\u904e\u901a\u96fb\u9053\u4e26\u62b5\u9054\u7d42\u9ede\u7dda\u3002\n\n\u901a\u96fb\u9053\n\u7531\u901a\u4e0a\u96fb\u6d41\u7684\u91d1\u5c6c\u6846\u7d44\u6210\u3002\n\n\u904a\u6232\u73a9\u6cd5\n\u63a7\u5236\u96fb\u6d41\u6025\u6025\u68d2\uff0c\u5207\u52ff\u78b0\u89f8\u91d1\u5c6c\u6846\u3002\n\n\u5099\u8a3b\n\u5728\u9014\u4e2d\u63a8\u62c9\u96fb\u6d41\u6025\u6025\u68d2\u4ee5\u8df3\u904e\u969c\u7919\u5c31\u7b97\u8f38\u3002", "short_description": "\u9583\u907f\u5371\u96aa\u9677\u9631\u4e26\u5b8c\u6210\u6b64\u904a\u6232\uff01\uff01"}, {"images": {"nodes": []}, "id": "954690198815109", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DANGER: ELECTRIC SHOCK", "keywords": [], "long_description": "{\u6e38\u620f\u8bf4\u660e}\n\n\u76ee\u6807\n\u5e26\u7740\u4e00\u6839\u68d2\u5b50\u7a7f\u8fc7\u4e00\u6761\u901a\u9053\uff0c\u5230\u8fbe\u7ec8\u70b9\u7ebf\u3002\n\n\u901a\u9053\n\u7528\u91d1\u5c5e\u6846\u505a\u6210\uff0c\u91d1\u5c5e\u6846\u4e2d\u6709\u7535\u6d41\u6d41\u52a8\u3002\n\n\u6e38\u620f\u73a9\u6cd5\n\u63a7\u5236\u68d2\u5b50\uff0c\u4f7f\u5176\u4e0d\u78b0\u5230\u91d1\u5c5e\u6846\u3002\n\n\u6ce8\u610f\u4e8b\u9879\n\u5982\u679c\u60a8\u63a8\u62c9\u68d2\u5b50\u4e2d\u9014\u8df3\u8fc7\uff0c\u5219\u6e38\u620f\u7ed3\u675f\u3002", "short_description": "\u907f\u5f00\u5371\u9669\u7684\u9677\u9631\uff0c\u5b8c\u6210\u8fd9\u4e2a\u6e38\u620f\uff01"}, {"images": {"nodes": []}, "id": "639922570772092", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DANGER: ELECTRIC SHOCK", "keywords": [], "long_description": "{Instructions de jeu}\n\nBut:\nSuivez un parcours jusqu'\u00e0 la ligne d'arriv\u00e9e avec une tige.\n\nParcours:\nCompos\u00e9 d'armatures en m\u00e9tal dans lesquelles passe un courant \u00e9lectrique.\n\nD\u00e9roulement du jeu:\nContr\u00f4lez la tige pour ne pas toucher les cadres m\u00e9talliques.\n\nRemarque:\nSi vous poussez ou tirez la tige afin de sauter le milieu des parcours, la partie est termin\u00e9e.", "short_description": "\u00c9vitez les pi\u00e8ges dangereux et terminez ce jeu !"}, {"images": {"nodes": [{"file_name": "icon.png", "id": "1869809403214014", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001707_1869809406547347_6887606735657821599_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BOPfxNm-cIQ7kNvwGZGAFS&_nc_oc=AdqH9BcOtL0ZPTGbgQORIeoi4rupqp5r7zJiRbHtvXfUb8Jhf_st_MHjbplMbvhzklg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRbxvxeM1YYly2r7DlVHpYLS-kPcUVEIhv7h46g_cRKg&oe=6B00567A"}, {"file_name": "seihoukei_cover.png", "id": "1578026155878263", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036700_1578026159211596_338271830850509098_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0arHHdCaToYQ7kNvwFRzwVe&_nc_oc=AdoUkKfrKsFi7yBZl2zx6d95lt6EiRwdM4Hk2UxU5wqRbTxYcmkb22DpC8KYC9GgD5k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQ1LZIHd3SEtIU0UfOFa_lILK9IqBeIcNzBGWo5973Hg&oe=6B007E4C"}, {"file_name": "yokonaga_cover.png", "id": "1240561843078098", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395601_1240561846411431_4887466305539088189_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRRrQjQrZrUQ7kNvwEnQzT7&_nc_oc=Adq7SCWvw6mi-Ug62VbLIJGogjcTLmnY_aw5VeUHx9yvonOxKOnMgXARJi-vUIqgwFg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRM-1q4bLakTLM_xlH57qwvs72sQpvoks1sQ47lhW2duw&oe=6B006ABE"}, {"file_name": "yokonaga_cover_mini.png", "id": "930274564509275", "image_type": "APP_IMG_SMALL_LANDSCAPE"
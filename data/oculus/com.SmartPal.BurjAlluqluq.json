c_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8BiVjSrWqTBgWynK4FuE2polTw3NY04pD2SD2317LYg&oe=6B007D98"}, {"file_name": "\u0645\u0634\u0631\u0648\u0639 \u062c\u062f\u064a\u062f (7).png", "id": "642462347959839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422394_642462351293172_770772060691426654_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QpSA9qvd1UQ7kNvwHyt33s&_nc_oc=AdqQb4DFOCJHhYH5tYOeHaU9nI_os9DbhE6oLR6g--Y02j6kMa-BbZBY91UuHp4CU6g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxb-I-jEKhxS6VtqF9bZwXaMi7UGunLru8-Rp_OEXjHg&oe=6B005D18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Burj Alluqluq", "keywords": [], "long_description": "Dive into a virtual exploration of one of Jerusalem's most significant historical landmarks with the \"Burj Al-Luqluq VR\" app. This immersive virtual reality experience transports you directly into the heart of Burj Al-Luqluq, allowing you to wander through its ancient architecture and uncover the layers of history that have shaped this iconic site. Through a carefully curated interactive tour, users can engage with the rich cultural and historical narratives of Burj Al-Luqluq, learning about its significance in Jerusalem's storied past.\n\nThe app features detailed reconstructions of the site, enriched with historical facts and stories that bring the past to life. Whether you're a history enthusiast, a cultural explorer, or simply looking for a unique virtual reality experience, \"Burj Al-Luqluq VR\" offers a captivating journey through time. Experience the beauty of Jerusalem's heritage from a new perspective, exploring the intricacies of Burj Al-Luqluq's architecture and the historical events that have unfolded within its walls.", "short_description": "Discover the depths of history and culture at Burj Al-Luqluq with our unique virtual reality app. \"Burj Al-Luqluq VR\" offers an interactive tour that takes you on a historical journey inside one of Jerusalem's most prominent landmarks, providing an immersive opportunity to explore its rich heritage and ancient stories."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/burj-alluqluq-vr", "developer_terms_of_service_url": null, "publisher_name": "Mohammad Salah", "support_website_url": null, "website_url": "https://www.burjalluqluq.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7008152152637718"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1133598300971147"}]}, "baseline_offer": {"id": "1133598300971147"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1709751780, "status": "PUBLISHED", "id": "1133598300971147"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7030775847042015", "version": "1.0.0"}, "id": "434547515574809", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6965205480265719", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7030775847042015"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4345475155
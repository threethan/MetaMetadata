75245823_291090946688795_2071879129375178737_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGMDYtKDHicQ7kNvwHlSBTv&_nc_oc=AdqXrfltY30Sqph1EBeFt-WSHcbhq5X1VrFHHXC6RO-307W_lxJyLMDyI_iacJo1B2I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcYSVza1oAEDa9d8ZfGiLQuIGWLVNoRo--8t18STesFg&oe=6AB92BD8"}, "display_name": "CATOPIA", "keywords": [], "long_description": "Step into the shoes of your adorable cat avatar, customize its appearance, and get ready for thrilling escapades. Use your magical hands to navigate the environment, climb, scratch, and pounce just like a real cat. Interact with the town's residents and form lasting friendships.\nIn Catopia you can also express your personal style by dressing up your feline character in a variety of cute and quirky outfits. Be the most fashionable cat on the block and show off your unique sense of style.\nbut the fun doesn't end there! Engage in a range of mini-games designed to test your agility and cunning. Compete in challenges like catching mice, leaping through obstacle courses.\nSo what are you doing? Play Catopia today!", "short_description": "Welcome! This is Catopia a game which is a Gorilla tag fan game made by [Swervyman] and the game is about you becoming a cat and getting the experience to chase mice. And you can play game modes with your friends and others and hangout as cats. Hope you enjoy!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/catopiavrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "SwervyMan", "support_website_url": null, "website_url": "https://sites.google.com/view/catopiavr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection"
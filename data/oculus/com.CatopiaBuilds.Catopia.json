7rWFYZkHHUkUDv8R2I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0COLb6L3RWXbNede5pCCCgcrt_36J-0CzDGOdZwVhhA&oe=6AFDC11E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "download.png", "id": "291090943355462", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75245823_291090946688795_2071879129375178737_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyc7zZFN0mAQ7kNvwHOD5ii&_nc_oc=AdpN516NumtaRziEnmLrMydrggjyicznw7RUKdWWxHcFvtRBv_bU0IQvsAUtgNrEyPM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_993ccK20kLz_q3YNh0TfudoTVVUCbYSVc_qyxgqsWw&oe=6AFDB9D8"}, "display_name": "CATOPIA", "keywords": [], "long_description": "Step into the shoes of your adorable cat avatar, customize its appearance, and get ready for thrilling escapades. Use your magical hands to navigate the environment, climb, scratch, and pounce just like a real cat. Interact with the town's residents and form lasting friendships.\nIn Catopia you can also express your personal style by dressing up your feline character in a variety of cute and quirky outfits. Be the most fashionable cat on the block and show off your unique sense of style.\nbut the fun doesn't end there! Engage in a range of mini-games designed to test your agility and cunning. Compete in challenges like catching mice, leaping through obstacle courses.\nSo what are you doing? Play Catopia today!", "short_description": "Welcome! This is Catopia a game which is a Gorilla tag fan game made by [Swervyman] and the game is about you becoming a cat and getting the experience to chase mice. And you can play game modes with your friends and others and hangout as cats. Hope you enjoy!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/catopiavrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "SwervyMan", "support_website_url": null, "website_url": "https://sites.google.com/view/catopiavr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "113682948431237"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036671_968582540855712_7480620306881429587_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_DyR_z6GJMQ7kNvwHJt3FL&_nc_oc=AdraGB4xnIyiPA6eqAPrhK2001S501ywMT95fgFbdn4ZfrFn9Msxryj54m0vX5j1CsQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxwGIkKMd6h-9nMdGmPW7RC7MfvMUTC6T6aQStT4wH6w&oe=6AFDAD2F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CATOPIA", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "World Creation", "id": "1725996564472128"}], "release_date": 1687798016, "lastRevision": {"nodes": [{"id": "6673417266022588", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6673417236022591", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1234921887208097"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "catopiaf
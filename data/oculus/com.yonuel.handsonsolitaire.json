com/v/t64.5771-25/491820652_750787320769511_2129029583902650024_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhkHlj24AdAQ7kNvwG8TEPC&_nc_oc=AdrK3ZnpfRlxugRfkG1ThIjc6FTohlFGe1wjt0bHysK-JVpm8AVJkeIQh-mIrkwP8eQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoYXUWTasDQ1Jdcgv5NIxOdkK9_8EPY8FalnJh1Fzfrw&oe=6B09AA14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape.png", "id": "23982655051399107", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820548_23982655058065773_1175559102631830755_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pq3J0XRcD9gQ7kNvwFcqi8G&_nc_oc=AdrZKhuqYBgIuGg7FjCbaPrtAVDtVEDbNokgZlEcbIylbE98hxsO_NoUHGzDWTFAh8o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-oFQ8IFC2jHX-Js3RaDX9tCQQKq2AWs9W3WvaAIZk-Q&oe=6B09C8FD"}, "display_name": "Hands-On! Solitaire", "keywords": ["Solitaire", "cards", "poker"], "long_description": "# Hands-On! Solitaire \u2013 A New Way to Play Solitaire!\n\nExperience the timeless game of klondike solitaire in a whole new dimension! **Hands-On! Solitaire** brings classic gameplay into **fully immersive VR**, giving you the freedom to interact with your cards naturally\u2014just like in real life.\n\n## \u2666\ufe0f **Authentic Klondike Solitaire**\nClassic klondike, just as you remember it\u2014now in VR. Enjoy every flip and win with faithful rules, natural hand-tracked controls, and calming environments that make each game feel effortlessly immersive.{722022503792751}\n\n## \ud83d\udc50 **True Hand-Tracking Support**\nNo controllers needed! Pick up, place, and move cards with **your own hands** using full hand-tracking technology. Enjoy **intuitive interactions** that make every deal and shuffle feel effortless.{1021443566738391}\n\n## \ud83c\udf3f **Relaxing, Immersive Environments**\nFind your perfect atmosphere with three **beautifully crafted** background environments. Whether you want a peaceful retreat or a focused playing space, *Hands-On! Solitaire* adapts to your mood.{2864281933765513}\n\n## \ud83c\udfe1 **Full Passthrough Experience**\nBring solitaire into your own living space! With **full passthrough**, your cards blend seamlessly into your surroundings, making gameplay feel more natural than ever.\n{3777136862430918}\n\nWhat are you waiting for? Step into *Hands-On! Solitaire* and **rediscover the joy of solitaire\u2014completely in virtual reality!**", "short_description": "Experience klondike solitaire like never before\u2014fully immersive, fully hands-on! Pick up and place cards naturally with complete hand-tracking support. Relax in serene environments, or bring the game into your own space with passthrough experience. Classic gameplay meets cutting-edge VR\u2014are you ready to play? \u2665\ufe0f\u2660\ufe0f\u2666\ufe0f\u2663\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yonuel.com/Hands-On-Solitaire-Privacy-Policy/", "developer_terms_of_service_url": "https://yonuel.com/Hands-On-Solitaire-TOS/", "publisher_name": "yonuel", "support_website_url": null, "website_url": "https://yonuel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24268939989369280"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1531016005049803"}, {"status": "PUBLISHED", "id": "12
20825378868583_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCLt9Tas_dQQ7kNvwFQtQud&_nc_oc=AdqmP6e7GFgL8gOO90bVp1ee4d_YvxKN-DLd8_ZHHj5jv30lCxJV7ONK7Y8qPvttWDs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1omL-VSwUxthqb9cTRtxG6oR2oPvPhGeMg7FguAkdA-Q&oe=69DE2A4C"}, {"file_name": "dunes-screenshot.png", "id": "1138580071753872", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619113_1138580075087205_5552922039984938721_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9lSKxaZXb0Q7kNvwE-kHIx&_nc_oc=Adq_wljZs8uZWPAr4QkN7opEz6rW7UkpxCor9jPctPvHmofkiVaML48ZkNAg6bUAbs4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Nve7jDUNcRs8s6Cgmjt7A8-jrm9LbC-58QHTOaqdM6A&oe=69DE23D3"}, {"file_name": "evening-screenshot.png", "id": "1430400465759032", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300946_1430400469092365_923022133902755557_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHzYJGK-GdUQ7kNvwGgcsJa&_nc_oc=Adrr5LSZLGGpq3HnFDER2peu8eVNIF4azqK-k8PJNrICM3Jr9E6jzyVFal0Dzt0zenE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22wSNPNnjEMRuloE1HBevbRzALjBoMUtIuB7xRUCHqCQ&oe=69DE4F33"}, {"file_name": "environments-screenshot.png", "id": "2686194108384078", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619774_2686194111717411_2842216976202277161_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEpFVqEug28Q7kNvwHu3kgj&_nc_oc=Adq5XDQAIBcaiJisiPBhQMLbGM_RiVrcg2Aicao3VjYKujLdeeyl2qZn0OwKGiuXSME&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eIpmTt0tzIp8Ipw2Jpsc9b2x2RHVUg5dSg9YYaFPYfQ&oe=69DE2425"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape.png", "id": "23982655051399107", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820548_23982655058065773_1175559102631830755_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2tj6odoJVMQ7kNvwFdM7p_&_nc_oc=AdrxP6aADu06zv4G0jGStyqVBYtYOIjfy2PN5lG1ZAt3WPxZkjY__bHC4QWRcV4XOZ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fxpPsdjxe9l_Hu-1pxHsk3HH4AQyQ4TLZLEM7z8EMvw&oe=69DE4C3D"}, "display_name": "Hands-On! Solitaire", "keywords": ["Solitaire", "cards", "poker"], "long_description": "# Hands-On! Solitaire \u2013 A New Way to Play Klondike Solitaire!\n\nExperience the timeless game of Klondike Solitaire in a whole new dimension! **Hands-On! Solitaire** brings classic solitaire gameplay into **fully immersive VR**, giving you the freedom to naturally **pick up, move, and place cards with your hands**\u2014just like in real life.\n\n## \u2666\ufe0f **Authentic Klondike Solitaire**\nClassic Klondike, just as you remember it\u2014now in VR. Enjoy every flip and win with faithful rules, **natural hand-tracked controls**, and **immersive environments**.{722022503792751}\n\n## \ud83d\udc50 **True Hand-Tracking Support**\nNo controllers needed! **Pick up, move, and place cards with your own hands** using **full hand-tracking** technology. Enjoy intuitive interactions that make every deal and shuffle feel effortless.{1021443566738391}\n\n## \ud83c\udf3f **6 Immersive Environments**\nFind your perfect atmosphere with **6 beautifully crafted immersive environments**. Whether its flying high above the Grand Canyon or viewing a spectacular Aurora Borealis light show, you can adapt your playing experience to fit your mood.{1673197654085645}\n\n## \ud83c\udfe1 **Full Passthrough Experience**\nBring solitaire into your own living space! With **full passthrough**, your cards blend seamlessly into your surroundings, making gameplay feel more natural than ever.\n\nWhat are you waiting for? Step into *Hands-On! Solitaire* and **rediscover the joy of solitaire\u2014completely in virtual reality!**", "short_description": "Experience Klondike Solitaire like never before\u2014fully immersive, fully hands-on! Pick up, move, and place cards naturally with complete hand-tracking support. Play in 6 immersive environments or your living room with the passthrough experience. Classic gameplay meets cutting-edge VR\u2014are you ready to play? \u2665\ufe0f\u2660\ufe0f\u2666\ufe0f\u2663\ufe0f"}]}, "developer_name": "Yonuel Interactive", "developer_privacy_policy_url": "https://yonuelinteractive.com/games/hands-on-solitaire/privacy/", "developer_terms_of_service_url": "https://yonuelinteractive.com/games/hands-on-solitaire/terms/", "publisher_name": "Yonuel Interactive", "support_website_url": null, "website_url": "https://yonuelinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25293125020284100"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499295543_1219402126643527_8129877324462773257_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsuJRqZscKAQ7kNvwHC9VmM&_nc_oc=Adqo_SOwkccj3ba6YeB7Spb74JL5t4byPU-IDgCis6mdYTKpNspBChZ1OejC3o-4BKo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CDUapeHKiojuHno3t54h_e_e_P9EbZeriXVGwI-xZUQ&oe=69DE2102"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hands-On! Solitaire", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Tabletop", "id": "1676485315806614"}], "release_date": 1756182960, "lastRevision": {"nodes": [{"i
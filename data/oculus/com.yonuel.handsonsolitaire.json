20825378868583_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nz1V0VulRKQQ7kNvwFccMQi&_nc_oc=AdpoZDqwCrBwBRlzpVg3aH-KvSgVvirbY33nf1m9vJ6uBneNGw2j2LuTNoXLp5HynC4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kCqtY3xif3Vp4MtXaxidsdGoomDfSy3BXtqP8FBep0g&oe=69D8E44C"}, {"file_name": "dunes-screenshot.png", "id": "1138580071753872", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619113_1138580075087205_5552922039984938721_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUAogzrFtLIQ7kNvwHELL3k&_nc_oc=AdqewPPORXMMrSuNdA9gm3RmhXuz6Eqf2RG-lYLxFIj0z9UQvGg_4SNNXYIjrAhUC98&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00Bl9LrrAFhkT42fHpQ-qJiOXUslLtay7fNgpA-m4-Hg&oe=69D8DDD3"}, {"file_name": "evening-screenshot.png", "id": "1430400465759032", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300946_1430400469092365_923022133902755557_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7kPqlPY3ZYQ7kNvwGYmJLu&_nc_oc=AdqlWmwLfvfqI3hIhEtrEZQV6DHs9aq2HDaWYB3NlfAQ6M3U0eRug8w-zV1TTJJny2I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1I5fyqN-x77B80frohNuQIBqPE-SMtoJbhc_y3faJ1TQ&oe=69D90933"}, {"file_name": "environments-screenshot.png", "id": "2686194108384078", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619774_2686194111717411_2842216976202277161_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHmwMzyeQU8Q7kNvwF5SLDN&_nc_oc=Adqn53jxBQNbA5WoTwHmgGFvpT9-FtsiicoSqk95NFh-kuKtJxGT44215R_r14hHuXE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29UY5dRnhHivmVCFXEe677V3Fiodo8bAVnEUm2MwlWXg&oe=69D8DE25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape.png", "id": "23982655051399107", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820548_23982655058065773_1175559102631830755_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toQE-5GskYwQ7kNvwHK-oop&_nc_oc=Ado248tTEY6s9jjzSQj7cvu9ffSfnFVe7HlIpQEd7fXVfaMWnFarg1bNJqvPu8kcMaY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Ky8B1CjoiXgE9C8OPy5_wlJwdVw8OBVO5yiQxCPKXRA&oe=69D9063D"}, "display_name": "Hands-On! Solitaire", "keywords": ["Solitaire", "cards", "poker"], "long_description": "# Hands-On! Solitaire \u2013 A New Way to Play Klondike Solitaire!\n\nExperience the timeless game of Klondike Solitaire in a whole new dimension! **Hands-On! Solitaire** brings classic solitaire gameplay into **fully immersive VR**, giving you the freedom to naturally **pick up, move, and place cards with your hands**\u2014just like in real life.\n\n## \u2666\ufe0f **Authentic Klondike Solitaire**\nClassic Klondike, just as you remember it\u2014now in VR. Enjoy every flip and win with faithful rules, **natural hand-tracked controls**, and **immersive environments**.{722022503792751}\n\n## \ud83d\udc50 **True Hand-Tracking Support**\nNo controllers needed! **Pick up, move, and place cards with your own hands** using **full hand-tracking** technology. Enjoy intuitive interactions that make every deal and shuffle feel effortless.{1021443566738391}\n\n## \ud83c\udf3f **6 Immersive Environments**\nFind your perfect atmosphere with **6 beautifully crafted immersive environments**. Whether its flying high above the Grand Canyon or viewing a spectacular Aurora Borealis light show, you can adapt your playing experience to fit your mood.{1673197654085645}\n\n## \ud83c\udfe1 **Full Passthrough Experience**\nBring solitaire into your own living space! With **full passthrough**, your cards blend seamlessly into your surroundings, making gameplay feel more natural than ever.\n\nWhat are you waiting for? Step into *Hands-On! Solitaire* and **rediscover the joy of solitaire\u2014completely in virtual reality!**", "short_description": "Experience Klondike Solitaire like never before\u2014fully immersive, fully hands-on! Pick up, move, and place cards naturally with complete hand-tracking support. Play in 6 immersive environments or your living room with the passthrough experience. Classic gameplay meets cutting-edge VR\u2014are you ready to play? \u2665\ufe0f\u2660\ufe0f\u2666\ufe0f\u2663\ufe0f"}]}, "developer_name": "Yonuel Interactive", "developer_privacy_policy_url": "https://yonuelinteractive.com/games/hands-on-solitaire/privacy/", "developer_terms_of_service_url": "https://yonuelinteractive.com/games/hands-on-solitaire/terms/", "publisher_name": "Yonuel Interactive", "support_website_url": null, "website_url": "https://yonuelinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25293125020284100"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295543_1219402126643527_8129877324462773257_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-oFC5SaUj4Q7kNvwGFp2wV&_nc_oc=AdoLCaxcf2OeaEDl2Jb7hjdrRs8ZGXAWmjSJFtZj2Aq3ffQl2eYVX9RgMr1_VA8TJOU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DHcT5jR525x3HZoGpMAEuR0VezH3M7Z7GEDHagueXiA&oe=69D8DB02"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hands-On! Solitaire", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Tabletop", "id": "1676485315806614"}], "release_date": 1756182960, "lastRevision": {"nodes": [{"i
.png", "id": "1149491434031299", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624851_1149491437364632_1822820825378868583_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJHDSmBDqvkQ7kNvwHuP2Ia&_nc_oc=Adq1TtIwZpsnfNJsIXvGWWuVmyRwnB4w-3MZi6kL-Mvzba40qHJG0Hj_QlJ7m3GoGds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yDemNA0lM7yG0_girSvaCS1W9F3JRVWplXbTPTlXidg&oe=6A3FF18C"}, {"file_name": "dunes-screenshot.png", "id": "1138580071753872", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619113_1138580075087205_5552922039984938721_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOn9fRpHldQQ7kNvwE-11EP&_nc_oc=AdrTvIrXAM0HkmfshrgVLzoL3_-a51xp2SWsRDkWCtcEAsGX6vPtDeaiwVQcSSWKUfw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af992m7Nbgm_JzGtImdgVZTk6TESJMjIoxJjCpSB1eoe_g&oe=6A3FEB13"}, {"file_name": "evening-screenshot.png", "id": "1430400465759032", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300946_1430400469092365_923022133902755557_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wv8PBbFJGcIQ7kNvwHQ8jkv&_nc_oc=AdoWAn24a7Wj7BDH1yOYkTcakFeRMwpF9rQeDtp02kQNqTDG5FUi0D0IGqRi59rKqw0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80-xR2boRvRZjYrAS8YlYr-ugcaMydinkQssVNblE_MQ&oe=6A3FDE33"}, {"file_name": "environments-screenshot.png", "id": "2686194108384078", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619774_2686194111717411_2842216976202277161_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q76-exwBvZ8Q7kNvwH3WR0E&_nc_oc=AdodDLbKOsTXqbmYMPxPU4jn5V4TjOI4w_Mhy5pWTwE_oANMOJbafcuFyFrLrf7VK2g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UTyRSQZMDxXLSKt7i50DStqwB6h0JsHQf8r7uDBzMcA&oe=6A3FEB65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape.png", "id": "23982655051399107", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820548_23982655058065773_1175559102631830755_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbZHfug0aVMQ7kNvwFX8udj&_nc_oc=AdpiAW17uspy26tseQj9V8IBOACl-5sgm8-aLyVEnoxv27idWl-ztSlhL7BX1KB_FlM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aw5BhPej9n4i810juB0smLsB3bAETfcFqKH6ZDUpCEQ&oe=6A3FDB3D"}, "display_name": "Hands-On! Solitaire", "keywords": ["Solitaire", "cards", "poker"], "long_description": "# Hands-On! Solitaire \u2013 A New Way to Play Klondike Solitaire!\n\nExperience the timeless game of Klondike Solitaire in a whole new dimension! **Hands-On! Solitaire** brings classic solitaire gameplay into **fully immersive VR**, giving you the freedom to naturally **pick up, move, and place cards with your hands**\u2014just like in real life.\n\n## \u2666\ufe0f **Authentic Klondike Solitaire**\nClassic Klondike, just as you remember it\u2014now in VR. Enjoy every flip and win with faithful rules, **natural hand-tracked controls**, and **immersive environments**.{722022503792751}\n\n## \ud83d\udc50 **True Hand-Tracking Support**\nNo controllers needed! **Pick up, move, and place cards with your own hands** using **full hand-tracking** technology. Enjoy intuitive interactions that make every deal and shuffle feel effortless.{1021443566738391}\n\n## \ud83c\udf3f **6 Immersive Environments**\nFind your perfect atmosphere with **6 beautifully crafted immersive environments**. Whether its flying high above the Grand Canyon or viewing a spectacular Aurora Borealis light show, you can adapt your playing experience to fit your mood.{1673197654085645}\n\n## \ud83c\udfe1 **Full Passthrough Experience**\nBring solitaire into your own living space! With **full passthrough**, your cards blend seamlessly into your surroundings, making gameplay feel more natural than ever.\n\nWhat are you waiting for? Step into *Hands-On! Solitaire* and **rediscover the joy of solitaire\u2014completely in virtual reality!**", "short_description": "Experience Klondike Solitaire like never before\u2014fully immersive, fully hands-on! Pick up, move, and place cards naturally with complete hand-tracking support. Play in 6 immersive environments or your living room with the passthrough experience. Classic gameplay meets cutting-edge VR\u2014are you ready to play? \u2665\ufe0f\u2660\ufe0f\u2666\ufe0f\u2663\ufe0f"}]}, "developer_name": "Yonuel Interactive", "developer_privacy_policy_url": "https://yonuelinteractive.com/games/hands-on-solitaire/privacy/", "developer_terms_of_service_url": "https://yonuelinteractive.com/games/hands-on-solitaire/terms/", "publisher_name": "Yonuel Interactive", "support_website_url": null, "website_url": "https://yonuelinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25293125020284100"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295543_1219402126643527_8129877324462773257_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsHS5KxdK6cQ7kNvwEQOoX9&_nc_oc=Adp6yO0pAnpswTLL3kLVPzoWa3hLFJGxSEA3b5v4XnbMHE3MfqPdT17wUHIYBHFkozM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8E2XEWySDcvGd0jSWaxUhGnzKEi1nKlW2hqWqG6Pc5Sg&oe=6A3FE842"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hands-On! Solitaire", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "contex
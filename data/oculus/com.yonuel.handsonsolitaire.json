.png", "id": "1149491434031299", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624851_1149491437364632_1822820825378868583_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krrNqR0HBjgQ7kNvwEi0eHS&_nc_oc=AdqEeE_g6CxSRRwMySQpUnnWs9P1nRTI-u2gM2Seg4rFi1KJx2N_wCCuHx9hzsS7HfE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXDPsTUQxTyLTQjLA-5fbBT7ZK8W4a84cHDP1ZzmWXUg&oe=6A9024CC"}, {"file_name": "dunes-screenshot.png", "id": "1138580071753872", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619113_1138580075087205_5552922039984938721_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfp1t0AtWwQQ7kNvwH49fwG&_nc_oc=Ado-hUUY2VOuDMmRNphtBCeJJ-VaPZx2I7_oXvBocLPGg8AvX43weE8kliXOSVPm0O4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEb2Txk-DmMpw-JuqTJdgFJYWy8VeWJA7sb1LRiWQ8JQ&oe=6A901E53"}, {"file_name": "evening-screenshot.png", "id": "1430400465759032", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499300946_1430400469092365_923022133902755557_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xr7IXm2t6pgQ7kNvwFWzJc4&_nc_oc=Ado3O4pQ60G1RXpmn-TnnOWDx1vom7_1L1oEA0rtqosBfBgdRd3miDEh2QCEyiMLyoI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAVG6RUOZ6AAe7lCoVy6-4yFyfH1rcVQFhCPyOlsk6HA&oe=6A901173"}, {"file_name": "environments-screenshot.png", "id": "2686194108384078", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619774_2686194111717411_2842216976202277161_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElPSC63ovLoQ7kNvwGF_nRa&_nc_oc=AdqPfkGbOq7-r25cYiEMPrUJFy1L44cKY60CnUonF4zGpn1DZB1p7-69vwILdGFQgGI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxwLoR6JjN67ZEieHEfgxOPPX6WrNPgtxFYcZFP1CHIg&oe=6A901EA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape.png", "id": "23982655051399107", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820548_23982655058065773_1175559102631830755_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqKjqfebZoIQ7kNvwHTvTkk&_nc_oc=AdpEjSbTpZc3W1WPDr2RO48Ak1d9ud73Z4a60dom4BTP7bHl3TKWbTsNslLlyRGwKj0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNz3l7Kx9iZKQXzajRE4dzZuOC94cIdub5KkEEgC7pFQ&oe=6A900E7D"}, "display_name": "Hands-On! Solitaire", "keywords": ["Solitaire", "cards", "poker"], "long_description": "# Hands-On! Solitaire \u2013 A New Way to Play Klondike Solitaire!\n\nExperience the timeless game of Klondike Solitaire in a whole new dimension! **Hands-On! Solitaire** brings classic solitaire gameplay into **fully immersive VR**, giving you the freedom to naturally **pick up, move, and place cards with your hands**\u2014just like in real life.\n\n## \u2666\ufe0f **Authentic Klondike Solitaire**\nClassic Klondike, just as you remember it\u2014now in VR. Enjoy every flip and win with faithful rules, **natural hand-tracked controls**, and **immersive environments**.{722022503792751}\n\n## \ud83d\udc50 **True Hand-Tracking Support**\nNo controllers needed! **Pick up, move, and place cards with your own hands** using **full hand-tracking** technology. Enjoy intuitive interactions that make every deal and shuffle feel effortless.{1021443566738391}\n\n## \ud83c\udf3f **6 Immersive Environments**\nFind your perfect atmosphere with **6 beautifully crafted immersive environments**. Whether its flying high above the Grand Canyon or viewing a spectacular Aurora Borealis light show, you can adapt your playing experience to fit your mood.{1673197654085645}\n\n## \ud83c\udfe1 **Full Passthrough Experience**\nBring solitaire into your own living space! With **full passthrough**, your cards blend seamlessly into your surroundings, making gameplay feel more natural than ever.\n\nWhat are you waiting for? Step into *Hands-On! Solitaire* and **rediscover the joy of solitaire\u2014completely in virtual reality!**", "short_description": "Experience Klondike Solitaire like never before\u2014fully immersive, fully hands-on! Pick up, move, and place cards naturally with complete hand-tracking support. Play in 6 immersive environments or your living room with the passthrough experience. Classic gameplay meets cutting-edge VR\u2014are you ready to play? \u2665\ufe0f\u2660\ufe0f\u2666\ufe0f\u2663\ufe0f"}]}, "developer_name": "Yonuel Interactive", "developer_privacy_policy_url": "https://yonuelinteractive.com/games/hands-on-solitaire/privacy/", "developer_terms_of_service_url": "https://yonuelinteractive.com/games/hands-on-solitaire/terms/", "publisher_name": "Yonuel Interactive", "support_website_url": null, "website_url": "https://yonuelinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25293125020284100"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499295543_1219402126643527_8129877324462773257_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHUdAJ7THP4Q7kNvwEg66Xb&_nc_oc=AdoW2bm3fI_nuveE1vigo3bc1STjKXHxtZnIlZH-2VelqI40QieohNAWodyC7MyeU-g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1KW4rLLORVvoR1I7FvvQ5LLw0KGfiSKI1nKkyZLgJfQ&oe=6A901B82"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hands-On! Solitaire", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "contex
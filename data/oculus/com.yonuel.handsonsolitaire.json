.png", "id": "1149491434031299", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624851_1149491437364632_1822820825378868583_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jf74tM4tNbQQ7kNvwE0-q41&_nc_oc=AdrNyaMAYTGl7xIJPmsf1XbgZka5V46Y9Nb-p9teQD0WLb3LYB255KlZlxdzkKzWBXA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxgVRpeefo0-u9b1JURJ2TG3NqqM6IicwB8IejE9e2-w&oe=6ACFA50C"}, {"file_name": "dunes-screenshot.png", "id": "1138580071753872", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619113_1138580075087205_5552922039984938721_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqR-itEg_P4Q7kNvwFktn3r&_nc_oc=AdoWX8_rIOp-_q3W8C2Pz8eJM-6qz1DYOVNCrfr6y5d8twurZJ9YA8eqijZT0MhXmgE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHwguKOlyzn_8IoIjVQ8IA9qeMu2GvpR2TYaFNJsyTYA&oe=6ACF9E93"}, {"file_name": "evening-screenshot.png", "id": "1430400465759032", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300946_1430400469092365_923022133902755557_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7_uWsZdD8UQ7kNvwFO7k7l&_nc_oc=Adp0RdnjqYWIbnuHTB5yoPs1G8nomKI5Rw6kCgIX8nQnL3820EsZ66EPkuUSxmX10S4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNs_HMeYjXS_bL2zp73BkzV8IugnDCFNI-Z29Jd07nraA&oe=6ACF91B3"}, {"file_name": "environments-screenshot.png", "id": "2686194108384078", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619774_2686194111717411_2842216976202277161_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvGXKQhxVvEQ7kNvwFg9OiT&_nc_oc=Adp795UCCDuG2Fna90-wnZrRLBFfVkRieJx_9oksHDd4Nh5QQ5XbEVgRAU4ytYki5sU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjPWht1Ajj7NHhb2if3QZLsJbvxrlGXHOC5RcTHCuzSA&oe=6ACF9EE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape.png", "id": "23982655051399107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820548_23982655058065773_1175559102631830755_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V35nxtlgdpcQ7kNvwFSsuIE&_nc_oc=AdrC83vTMX_eUAGIxe5s9OlorY8fisRfucX0joqO4QViIxVXUSxWZD5OVj3gKTsdh2M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuOW0W4feggFu84v2ni4ym8b3iZ-fVG8cD-8OKbf3MnQ&oe=6ACF8EBD"}, "display_name": "Hands-On! Solitaire", "keywords": ["Solitaire", "cards", "poker"], "long_description": "# Hands-On! Solitaire \u2013 A New Way to Play Klondike Solitaire!\n\nExperience the timeless game of Klondike Solitaire in a whole new dimension! **Hands-On! Solitaire** brings classic solitaire gameplay into **fully immersive VR**, giving you the freedom to naturally **pick up, move, and place cards with your hands**\u2014just like in real life.\n\n## \u2666\ufe0f **Authentic Klondike Solitaire**\nClassic Klondike, just as you remember it\u2014now in VR. Enjoy every flip and win with faithful rules, **natural hand-tracked controls**, and **immersive environments**.{722022503792751}\n\n## \ud83d\udc50 **True Hand-Tracking Support**\nNo controllers needed! **Pick up, move, and place cards with your own hands** using **full hand-tracking** technology. Enjoy intuitive interactions that make every deal and shuffle feel effortless.{1021443566738391}\n\n## \ud83c\udf3f **6 Immersive Environments**\nFind your perfect atmosphere with **6 beautifully crafted immersive environments**. Whether its flying high above the Grand Canyon or viewing a spectacular Aurora Borealis light show, you can adapt your playing experience to fit your mood.{1673197654085645}\n\n## \ud83c\udfe1 **Full Passthrough Experience**\nBring solitaire into your own living space! With **full passthrough**, your cards blend seamlessly into your surroundings, making gameplay feel more natural than ever.\n\nWhat are you waiting for? Step into *Hands-On! Solitaire* and **rediscover the joy of solitaire\u2014completely in virtual reality!**", "short_description": "Experience Klondike Solitaire like never before\u2014fully immersive, fully hands-on! Pick up, move, and place cards naturally with complete hand-tracking support. Play in 6 immersive environments or your living room with the passthrough experience. Classic gameplay meets cutting-edge VR\u2014are you ready to play? \u2665\ufe0f\u2660\ufe0f\u2666\ufe0f\u2663\ufe0f"}]}, "developer_name": "Yonuel Interactive", "developer_privacy_policy_url": "https://yonuelinteractive.com/games/hands-on-solitaire/privacy/", "developer_terms_of_service_url": "https://yonuelinteractive.com/games/hands-on-solitaire/terms/", "publisher_name": "Yonuel Interactive", "support_website_url": null, "website_url": "https://yonuelinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25293125020284100"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499295543_1219402126643527_8129877324462773257_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5P6KmYw2V3AQ7kNvwF3QxLQ&_nc_oc=Ado0WIDmYdRsdG6ZZG3Jjmpco7jD3wSscri_6I3_ynMHNxo4-uOWPuJMzNJ_s54R9ik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkpkSrAIiO5Dl63v-B-1JGbAhp41TZe3CfmIMU_sXDHg&oe=6ACF9BC2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hands-On! Solitaire", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "contex
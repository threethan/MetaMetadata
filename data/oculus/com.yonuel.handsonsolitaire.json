ps://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314657_1492640068578734_9037510382093207806_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6Efq3qSFtUQ7kNvwH8_x4g&_nc_oc=AdrBfhvO00JmnexbT5Z04pp-Dm3n9giBV9R3M-Jn58sYSi5OlB_VaK-Xwkk_lG24lCo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORZghgFYpa_B9X5hu2S9rRGYJ_XVkFRBOLQ1tvYF-IoA&oe=6ABFD9A7"}, {"file_name": "evening-screenshot.png", "id": "4223611644528952", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824202_4223611647862285_1454206746961716152_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRB6DeYpBikQ7kNvwGmJ1zM&_nc_oc=Adre_MrtdMBd-2ZYpEvbCe44-y_df3Mub3VLHmVepHrxMNZeirRHRtwXfBhUASzaJTY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLw7K1YtLc36iRncAk-7GLwQYssRr8NdmRIeEoxuepaQ&oe=6ABFD92B"}, {"file_name": "night-screenshot.png", "id": "1111196630970017", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819375_1111196634303350_5339191154339057511_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-8EFV0W_KIQ7kNvwHnkqa6&_nc_oc=Ado9mSJH7QeAJj-cA77ibLO-EtOUSfPTjWvlUGuAFaWyDNw6uK1dJ1boQA_nckRZniQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDklCmKAaW8x9kB0ajUSqMQN-JEYwKmHnuju_PYtA-iA&oe=6ABFAB2C"}, {"file_name": "passthrough-screenshot.png", "id": "750787317436178", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820652_750787320769511_2129029583902650024_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XeKNNQMp648Q7kNvwHCIklO&_nc_oc=Ado_79x-4kTNZOw36Ig8TbDKWYWWuwHbnJfeJyhhQcsMfdK7uGKUAxnAAqtcuFlJ5-I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcDnx1fGFqn-u1nlfzNocHe6FJOTvrbdG0k7JmtT9YOA&oe=6ABFD614"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape.png", "id": "23982655051399107", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820548_23982655058065773_1175559102631830755_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLHx3GEoMqEQ7kNvwGAJRKI&_nc_oc=Adr9HuZb64vVAljqoaLFh9qT2ne14zZOyiXF6R9z-ERScCQuRIEM7Od4y4N0Khph_28&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBweiKl7wWb0lVB0qlodk_n8rH5IdlwQxf49DRUrfsHw&oe=6ABFBCBD"}, "display_name": "Hands-On! Solitaire", "keywords": ["Solitaire", "cards", "poker"], "long_description": "# Hands-On! Solitaire \u2013 A New Way to Play Solitaire!\n\nExperience the timeless game of klondike solitaire in a whole new dimension! **Hands-On! Solitaire** brings classic gameplay into **fully immersive VR**, giving you the freedom to interact with your cards naturally\u2014just like in real life.\n\n## \u2666\ufe0f **Authentic Klondike Solitaire**\nClassic klondike, just as you remember it\u2014now in VR. Enjoy every flip and win with faithful rules, natural hand-tracked controls, and calming environments that make each game feel effortlessly immersive.{722022503792751}\n\n## \ud83d\udc50 **True Hand-Tracking Support**\nNo controllers needed! Pick up, place, and move cards with **your own hands** using full hand-tracking technology. Enjoy **intuitive interactions** that make every deal and shuffle feel effortless.{1021443566738391}\n\n## \ud83c\udf3f **Relaxing, Immersive Environments**\nFind your perfect atmosphere with three **beautifully crafted** background environments. Whether you want a peaceful retreat or a focused playing space, *Hands-On! Solitaire* adapts to your mood.{2864281933765513}\n\n## \ud83c\udfe1 **Full Passthrough Experience**\nBring solitaire into your own living space! With **full passthrough**, your cards blend seamlessly into your surroundings, making gameplay feel more natural than ever.\n{3777136862430918}\n\nWhat are you waiting for? Step into *Hands-On! Solitaire* and **rediscover the joy of solitaire\u2014completely in virtual reality!**", "short_description": "Experience klondike solitaire like never before\u2014fully immersive, fully hands-on! Pick up and place cards naturally with complete hand-tracking support. Relax in serene environments, or bring the game into your own space with passthrough experience. Classic gameplay meets cutting-edge VR\u2014are you ready to play? \u2665\ufe0f\u2660\ufe0f\u2666\ufe0f\u2663\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yonuel.com/Hands-On-Solitaire-Privacy-Policy/", "developer_terms_of_service_url": "https://yonuel.com/Hands-On-Solitaire-TOS/", "publisher_name": "yonuel", "support_website_url": null, "website_url": "https://yonuel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24268939989369280"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1531016005049803"}, {"status": "PUBLISHED", "id": "1274292321431886"}, {"status": "PUBLISHED", "id": "32442821015361423"}, {"status": "PUBLISHED", "id": "2254719191699860"}, {"status": "PUBLISHED", "id": "659274553591815"}]}, "baseline_offer": {"id": "2254719191699860"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "1531016005049803"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25294328136830455", "version": "2.0"}, "id": "1760278524894734", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBina
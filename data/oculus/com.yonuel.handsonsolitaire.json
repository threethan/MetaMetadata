.png", "id": "1149491434031299", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624851_1149491437364632_1822820825378868583_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rz3cjLia20Q7kNvwHrHXQ0&_nc_oc=Adq2DfghQ6iddnzL3ZhiSeeiGnhjiZJHiqdJaLoKSzu6y4qPxxOc_nZ44_kJaths4X8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKEIHXprZCXtw0VKA_nyjF7EgSa0E383uALBBHPzNRug&oe=6A84474C"}, {"file_name": "dunes-screenshot.png", "id": "1138580071753872", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619113_1138580075087205_5552922039984938721_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Itkzw2pR0oQ7kNvwEuwY0X&_nc_oc=Adp5wMimGQjRkpdWK3MkTK1fl_ROscnD1FTwge6yhvbmMwJfhCIkl9uXfpsmF668uCY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcgnTvweGQ5HX9OXnjh8z9UYU1wQikP78XwLSqwsBygg&oe=6A8440D3"}, {"file_name": "evening-screenshot.png", "id": "1430400465759032", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300946_1430400469092365_923022133902755557_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yaHUpWVDXrMQ7kNvwGrYnGo&_nc_oc=AdoBAV8bk1z6KWxOBUkaJSrBP8-3PPpDKXq57zPXITM-8Cs2y75tSEZWxtg2pTe4kY4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIaX_SafvI4SiBBbYLw-uZu53ovNCaKTh1cDhj8AClvQ&oe=6A8433F3"}, {"file_name": "environments-screenshot.png", "id": "2686194108384078", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619774_2686194111717411_2842216976202277161_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBdhK6RmZ1AQ7kNvwHQtF2Q&_nc_oc=Adr41BfJBKuK5ikG8fP6A__zcfM5tAzx7zjPr5vzJ65v7QfwzhHOnzfWb1vWj20mzMQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5Ve81oFAdJg29TG-TCLe1MSgTUT88Ic7OcvFKkkQYwg&oe=6A844125"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape.png", "id": "23982655051399107", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820548_23982655058065773_1175559102631830755_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AE9BrZWrJU4Q7kNvwHM1kwa&_nc_oc=AdrcH5j34zvWLRwfg5OoJ4CQybju4zYoQIgE4msA8RniyhSU5YRYM38Og7neAia7MdQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9HdyevUuqQcnL-6fgLg196Qdt05jHJLdeYhyeM0QwfA&oe=6A84693D"}, "display_name": "Hands-On! Solitaire", "keywords": ["Solitaire", "cards", "poker"], "long_description": "# Hands-On! Solitaire \u2013 A New Way to Play Klondike Solitaire!\n\nExperience the timeless game of Klondike Solitaire in a whole new dimension! **Hands-On! Solitaire** brings classic solitaire gameplay into **fully immersive VR**, giving you the freedom to naturally **pick up, move, and place cards with your hands**\u2014just like in real life.\n\n## \u2666\ufe0f **Authentic Klondike Solitaire**\nClassic Klondike, just as you remember it\u2014now in VR. Enjoy every flip and win with faithful rules, **natural hand-tracked controls**, and **immersive environments**.{722022503792751}\n\n## \ud83d\udc50 **True Hand-Tracking Support**\nNo controllers needed! **Pick up, move, and place cards with your own hands** using **full hand-tracking** technology. Enjoy intuitive interactions that make every deal and shuffle feel effortless.{1021443566738391}\n\n## \ud83c\udf3f **6 Immersive Environments**\nFind your perfect atmosphere with **6 beautifully crafted immersive environments**. Whether its flying high above the Grand Canyon or viewing a spectacular Aurora Borealis light show, you can adapt your playing experience to fit your mood.{1673197654085645}\n\n## \ud83c\udfe1 **Full Passthrough Experience**\nBring solitaire into your own living space! With **full passthrough**, your cards blend seamlessly into your surroundings, making gameplay feel more natural than ever.\n\nWhat are you waiting for? Step into *Hands-On! Solitaire* and **rediscover the joy of solitaire\u2014completely in virtual reality!**", "short_description": "Experience Klondike Solitaire like never before\u2014fully immersive, fully hands-on! Pick up, move, and place cards naturally with complete hand-tracking support. Play in 6 immersive environments or your living room with the passthrough experience. Classic gameplay meets cutting-edge VR\u2014are you ready to play? \u2665\ufe0f\u2660\ufe0f\u2666\ufe0f\u2663\ufe0f"}]}, "developer_name": "Yonuel Interactive", "developer_privacy_policy_url": "https://yonuelinteractive.com/games/hands-on-solitaire/privacy/", "developer_terms_of_service_url": "https://yonuelinteractive.com/games/hands-on-solitaire/terms/", "publisher_name": "Yonuel Interactive", "support_website_url": null, "website_url": "https://yonuelinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25293125020284100"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499295543_1219402126643527_8129877324462773257_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffU4nvftMtIQ7kNvwEk3S_V&_nc_oc=AdoFnlqEKjVCpoGo4COGwLmo8UEqAcuS-J7rT4e0mSMigv7gtji2dqEoN8A2UhAsDA4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqsiak6_vv6csCus_oqv2nNcUJTC_JyPu4zOsXDUWr8A&oe=6A843E02"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hands-On! Solitaire", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "contex
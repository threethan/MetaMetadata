_sid=6e7a0a&_nc_ohc=8LFcPcbTvacQ7kNvwHR8wnW&_nc_oc=AdqQbB3WWZ-1f3929Ou-vzo677I8q-udW1TrXvz036SVqXHjnu8XUbIEcxJRqt1vMLg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwsb-EtKzYXt7z1NewKQPxdjv4UyOuVfJAFFy5FCFO5ew&oe=69C918E7"}, {"file_name": "evening-screenshot.png", "id": "4223611644528952", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824202_4223611647862285_1454206746961716152_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3BcFB07P7wQ7kNvwE-ecj1&_nc_oc=AdrH7nvax-mlTW0i7Txsh77tjc_UFUPVVoTwPVCBQ3DjEa9LfDExnua1iosPrCTvdAk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyeJz_papwnik3DsLN80lNsl4LkhAjj5hESE8KuH_ZFgQ&oe=69C9186B"}, {"file_name": "night-screenshot.png", "id": "1111196630970017", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819375_1111196634303350_5339191154339057511_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvYVya85pdoQ7kNvwF0YB5J&_nc_oc=AdqO6PThm7Upiq1KCcxnIENZGD7n9lsCnBDd-xZheHC62JkdR54iuqKyvFvshvnFEl4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxxoeLvTxP89kDF4ltWIGl3QjBr05ycqGZ1pipKd2AiCw&oe=69C922AC"}, {"file_name": "passthrough-screenshot.png", "id": "750787317436178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820652_750787320769511_2129029583902650024_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6F0Qwy9C94Q7kNvwEusE44&_nc_oc=AdpeUJEdDGB7m_zI6gg3yqafymxXa126vg5tso3DRLos6WW5k_WMeabemKIsaIBw-Ac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyAM3zR3nEln5rho3CSkwMmZiE09K0hbk1TlWAvBTcoEQ&oe=69C91554"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape.png", "id": "23982655051399107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820548_23982655058065773_1175559102631830755_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Oe6c7Pmt70Q7kNvwFBpzxr&_nc_oc=AdoebfDAXUzD82eSbyxCDe3hhYtkASvYLdZG0KYjPAcxSXmJAdLs4r0RSzF6z1AYIbE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxeUsVTP8l3BQaDZZCiofS3bv9qUptkJTVOqwB9SwBu_w&oe=69C9343D"}, "display_name": "Hands-On! Solitaire", "keywords": ["Solitaire", "cards", "poker"], "long_description": "# Hands-On! Solitaire \u2013 A New Way to Play Solitaire!\n\nExperience the timeless game of klondike solitaire in a whole new dimension! **Hands-On! Solitaire** brings classic gameplay into **fully immersive VR**, giving you the freedom to interact with your cards naturally\u2014just like in real life.\n\n## \u2666\ufe0f **Authentic Klondike Solitaire**\nClassic klondike, just as you remember it\u2014now in VR. Enjoy every flip and win with faithful rules, natural hand-tracked controls, and calming environments that make each game feel effortlessly immersive.{722022503792751}\n\n## \ud83d\udc50 **True Hand-Tracking Support**\nNo controllers needed! Pick up, place, and move cards with **your own hands** using full hand-tracking technology. Enjoy **intuitive interactions** that make every deal and shuffle feel effortless.{1021443566738391}\n\n## \ud83c\udf3f **Relaxing, Immersive Environments**\nFind your perfect atmosphere with three **beautifully crafted** background environments. Whether you want a peaceful retreat or a focused playing space, *Hands-On! Solitaire* adapts to your mood.{2864281933765513}\n\n## \ud83c\udfe1 **Full Passthrough Experience**\nBring solitaire into your own living space! With **full passthrough**, your cards blend seamlessly into your surroundings, making gameplay feel more natural than ever.\n{3777136862430918}\n\nWhat are you waiting for? Step into *Hands-On! Solitaire* and **rediscover the joy of solitaire\u2014completely in virtual reality!**", "short_description": "Experience klondike solitaire like never before\u2014fully immersive, fully hands-on! Pick up and place cards naturally with complete hand-tracking support. Relax in serene environments, or bring the game into your own space with passthrough experience. Classic gameplay meets cutting-edge VR\u2014are you ready to play? \u2665\ufe0f\u2660\ufe0f\u2666\ufe0f\u2663\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yonuel.com/Hands-On-Solitaire-Privacy-Policy/", "developer_terms_of_service_url": "https://yonuel.com/Hands-On-Solitaire-TOS/", "publisher_name": "yonuel", "support_website_url": null, "website_url": "https://yonuel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24268939989369280"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1274292321431886"}, {"status": "PUBLISHED", "id": "32442821015361423"}, {"status": "PUBLISHED", "id": "2254719191699860"}, {"status": "PUBLISHED", "id": "659274553591815"}]}, "baseline_offer": {"id": "2254719191699860"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "1274292321431886"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25294328136830455", "version": "2.0"}, "id": "1760278524894734", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "10073111352712048", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinar
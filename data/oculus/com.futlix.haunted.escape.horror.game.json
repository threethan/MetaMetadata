830441_1084964457661429_5791265303751373453_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BiHmL_6Uv_AQ7kNvwFOKt-0&_nc_oc=Ado5anvijyNw-E9OVuf0VNK-0H3OpzwDYy47ufaiKq9egHGG_K-cPzPiQlg08BSikHg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQZkege7r5bceECkHBERyk5FI-BgRK-9eBgoo6gpeyteA&oe=6B0C74BB"}, {"file_name": "1.png", "id": "1371566178136543", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/793139181_1371566181469876_772737679900740954_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttcm2aClDLgQ7kNvwFAXI1H&_nc_oc=AdpEKQKCTLWK0QS7MfFm-vNipRAFszlgkxhF246qyCu0VSKI8N4uWDKfrwv2T831RlM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTSNADFsE9KLW1Kan6LSP0h0mXgc7-qSGHHroXElHSERA&oe=6B0C5E80"}, {"file_name": "2.png", "id": "1756098462126690", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604347072_1756098465460023_1018908953880571156_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wk368GoMmrgQ7kNvwHlroJ-&_nc_oc=Ado9IeVNdzEunXWynC6aEcNzhQ6FpFLAu89uSYesp_y4_Kztv64mn-SNKtCHvUui5fE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS2KPzFMJGEN625KbhCPXqnIKOkM_hs2JvV6pD_hw4hJg&oe=6B0C6148"}, {"file_name": "4.png", "id": "1633144218195167", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830441_1633144221528500_6050571958921125258_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nS7IZ-JjQ0MQ7kNvwFiAa5c&_nc_oc=AdqVbFF1pWUnCTrmdWEdwi3xwrIuJm9nxN9rRaDY5YcxN8AX8le0WkxsQBbSRTnl-n0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTn88bq3JUqZjMNaraVYNjtEvNIQQ4sOVTMqoWNauZtNw&oe=6B0C81D0"}, {"file_name": "3.png", "id": "1113974211181531", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673531334_1113974214514864_4053371199100276452_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AqPR2QhmtcQ7kNvwFBF5bd&_nc_oc=Adp8xiY40qkA06IN6NTidsEArdpTiivokD5Zp9YG0OL4eGs_bA4ux842J9eHezwB7vA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ8ftdj4nQ9FqF3G-JkKA6C7wurRZepQZfutkk7VmeE6A&oe=6B0C686B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Horror Story VR - Granny Horror Games", "keywords": ["Horror", "Scary", "Haunted", "Zombie", "granny"], "long_description": "Welcome to Horror Story VR - Granny Horror Games, a VR experience that\u2019ll keep you on the edge of your seat! You\u2019ve got one goal: escape the haunted room before the creepy inhabitants get to you. Solve puzzles, avoid terrifying creatures, and make it out alive.\n\nIn Horror Story VR - Granny Horror Games, you\u2019ll encounter some seriously spooky characters\u2014like a Zombie Dog, a dead Joker, and even an eerie Mummy. Each challenge will test your nerves and your puzzle-solving skills. The best part? You can play it alone or with a friend!\n\nThe game offers two modes:\n- Solo Mode: It\u2019s just you against the haunted room\u2014get out before it\u2019s too late!\n- Co-op Mode: Work with a friend to help each other escape. Can you both survive?\n\nKey Features:\n- Play solo or team up in co-op mode.\n- Face off against creepy creatures like Granny, Ghosts, a Zombie Dog, and more.\n- High-quality VR graphics for an immersive, hair-raising experience.\n- Puzzles that challenge your brain while keeping your heart racing.\n- Exclusively available on Oculus Quest.", "short_description": "Get ready for a spooky adventure in Horror Story VR - Granny Horror Games! You\u2019re trapped in a haunted room, and it\u2019s up to you to find a way out. Face creepy creatures like Granny, Ghosts, and even a Zombie Dog. Whether you're going solo or teaming up with a friend, every moment counts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Futlix Games", "support_website_url": null, "website_url": "https://sites.google.com/view/futlixgames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39358128883801680"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673573223_1128302356367388_1005749405532415751_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmHNcqOVw_sQ7kNvwHgLxip&_nc_oc=AdpnUeGnZFEsfBVOfFcNSH7NG7waaW_PX0V2qWYVJnAfFOimHzf3o7nzyWeI_nTGBc4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSMZNl6_LeuXeXOVMwNvVVHeOw-NSpCwDURId1AqTNc-g&oe=6B0C5598"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Horror Story VR - Granny Horror Games", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1727792700, "lastRevision": {"nodes": [{"id": "26828012596813434", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26828012463480114", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {
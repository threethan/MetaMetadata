_sid=6e7a0a&_nc_ohc=5UE_yXgMcMUQ7kNvwEgQOGn&_nc_oc=AdpEC6KB4xG9yNOvXPTbTtxu_BNpeTZnFuhaYlLMSNDCr8jw1g00qgZd83YYnuzigYA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8ZRL1B6PhDSkRauUxhsTcNrY3X0E_MDL8JO4Ez9ADcw&oe=6AC7B93E"}, {"file_name": "1.png", "id": "1777505272958808", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825257_1777505276292141_7824630881525814644_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCc2ZJe9A9kQ7kNvwGILivW&_nc_oc=Ado9daaQTU-p10nEOEtRKVyFIgWotr13O2AmncSms7XMpqZy5x1myLiGoaYbTtUpHsg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvAPp4CjLq6s3IC3_bdZueK1UG2wGIRRVi2rT9OC_A8g&oe=6AC7C536"}, {"file_name": "4.png", "id": "918721764173137", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823837_918721767506470_3380827265362209878_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGibjpMP_ZEQ7kNvwGY5PQa&_nc_oc=AdpmF-fM7CQxtEK0siM4sPNRhKqK35FsCX8Mi-3bUF69mGdEiFIjha1P_AUcf6twyJ0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDLCXv3MRtOSHHa5mpm3mdG3PJgUXJdpyEJKQw40Yn8w&oe=6AC7CAF5"}, {"file_name": "5.png", "id": "1059932186265595", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821702_1059932189598928_5251327813598640245_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmIipggpPj0Q7kNvwEhue8i&_nc_oc=AdpNTrR_BA28tv2y5_d8O7Vq6UFTTNBMruQzGplfSnKKm4lIeqoRUrXzbw1NxRZKsFw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqHR57n3xy0fAz0qQBiuCdSmOMfwKsHNbjVZAvvjL0qw&oe=6AC7B739"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Horror Story VR - Granny Horror Games", "keywords": ["Horror", "Scary", "Haunted", "Zombie", "granny"], "long_description": "Welcome to Horror Story VR - Granny Horror Games, a VR experience that\u2019ll keep you on the edge of your seat! You\u2019ve got one goal: escape the haunted room before the creepy inhabitants get to you. Solve puzzles, avoid terrifying creatures, and make it out alive.\n\nIn Horror Story VR - Granny Horror Games, you\u2019ll encounter some seriously spooky characters\u2014like a Zombie Dog, a dead Joker, and even an eerie Mummy. Each challenge will test your nerves and your puzzle-solving skills. The best part? You can play it alone or with a friend!\n\nThe game offers two modes:\n- Solo Mode: It\u2019s just you against the haunted room\u2014get out before it\u2019s too late!\n- Co-op Mode: Work with a friend to help each other escape. Can you both survive?\n\nKey Features:\n- Play solo or team up in co-op mode.\n- Face off against creepy creatures like Granny, Ghosts, a Zombie Dog, and more.\n- High-quality VR graphics for an immersive, hair-raising experience.\n- Puzzles that challenge your brain while keeping your heart racing.\n- Exclusively available on Oculus Quest.", "short_description": "Get ready for a spooky adventure in Horror Story VR - Granny Horror Games! You\u2019re trapped in a haunted room, and it\u2019s up to you to find a way out. Face creepy creatures like Granny, Ghosts, and even a Zombie Dog. Whether you're going solo or teaming up with a friend, every moment counts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Futlix Games", "support_website_url": null, "website_url": "https://sites.google.com/view/futlixgames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
830441_1084964457661429_5791265303751373453_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paTWmvJqSj0Q7kNvwGRAnb_&_nc_oc=AdolBFDG0oHZU8fJcP-FBqpMnw9LvwXkhMNkwL5P0d_y25bMsSRSAVJ7Z2vhnaQ2wyI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8hqNJzJLUHsxz4eI3a-rLLVCOQqNnyFd8W6uaYm5wrQ&oe=6AFDBBFB"}, {"file_name": "1.png", "id": "1371566178136543", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/793139181_1371566181469876_772737679900740954_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLyUeT35Z5cQ7kNvwG9Vehy&_nc_oc=AdpHqvDgX6MHPs783R9z_dKH00ZMQIYQOz6XX3pNbPthf71sQ-rWsNhdl_qefTrLDCk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAXk0Q3KkmD4bh2GcxQAKvSktD5RgwN9RgYDPjLnGj-A&oe=6AFDDE00"}, {"file_name": "2.png", "id": "1756098462126690", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604347072_1756098465460023_1018908953880571156_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIg569PdMwoQ7kNvwEy1S2D&_nc_oc=AdpngjjoRsI0Syd3JaGqhdfB1TBDLg8c54CFRI4PeRk7jHz_0OBoOKK-fTjPF79i9QM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvAzDRei2d6m-viZvVbdqFNVr82YvbmuXZajaTTEvvVw&oe=6AFDE0C8"}, {"file_name": "4.png", "id": "1633144218195167", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830441_1633144221528500_6050571958921125258_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPlRb7JLEywQ7kNvwG-vxiw&_nc_oc=AdqtvRXFKvlVVSZTxpwda4W7UNB4ihwavzGzDi1QMMbsrDFqUDS0YmEpjxZc7eWg8o4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOSqeuimcg801z6AkoB511tqhblsEO_9t2qnz7Hn24dA&oe=6AFDC910"}, {"file_name": "3.png", "id": "1113974211181531", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673531334_1113974214514864_4053371199100276452_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YT0MggtVO38Q7kNvwGWdu1m&_nc_oc=Adpy893x0zF2y24hepYW5cahIVLNnzSUOlG9GNk2IEopu_HcLWLXAfckySu_3jm8jjI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKGXP0R12qyZvD3oqo2RH-Q_6mAREN8tuECEMmRCsHMw&oe=6AFDAFAB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Horror Story VR - Granny Horror Games", "keywords": ["Horror", "Scary", "Haunted", "Zombie", "granny"], "long_description": "Welcome to Horror Story VR - Granny Horror Games, a VR experience that\u2019ll keep you on the edge of your seat! You\u2019ve got one goal: escape the haunted room before the creepy inhabitants get to you. Solve puzzles, avoid terrifying creatures, and make it out alive.\n\nIn Horror Story VR - Granny Horror Games, you\u2019ll encounter some seriously spooky characters\u2014like a Zombie Dog, a dead Joker, and even an eerie Mummy. Each challenge will test your nerves and your puzzle-solving skills. The best part? You can play it alone or with a friend!\n\nThe game offers two modes:\n- Solo Mode: It\u2019s just you against the haunted room\u2014get out before it\u2019s too late!\n- Co-op Mode: Work with a friend to help each other escape. Can you both survive?\n\nKey Features:\n- Play solo or team up in co-op mode.\n- Face off against creepy creatures like Granny, Ghosts, a Zombie Dog, and more.\n- High-quality VR graphics for an immersive, hair-raising experience.\n- Puzzles that challenge your brain while keeping your heart racing.\n- Exclusively available on Oculus Quest.", "short_description": "Get ready for a spooky adventure in Horror Story VR - Granny Horror Games! You\u2019re trapped in a haunted room, and it\u2019s up to you to find a way out. Face creepy creatures like Granny, Ghosts, and even a Zombie Dog. Whether you're going solo or teaming up with a friend, every moment counts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Futlix Games", "support_website_url": null, "website_url": "https://sites.google.com/view/futlixgames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39358128883801680"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673573223_1128302356367388_1005749405532415751_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TERbh5_O6KsQ7kNvwGm0M0F&_nc_oc=AdpWthCBEAQi9bFhYjpwxql6aUY3LpHj-89smzjqA0ZOzlG1DMFZxDQxjzVFtHsWNOs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwsbC9yI0gmzvh9wn0XgY7tF4JcAJzFe8uqWxHd7vkww&oe=6AFDD518"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Horror Story VR - Granny Horror Games", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1727792700, "lastRevision": {"nodes": [{"id": "26828012596813434", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26828012463480114", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {
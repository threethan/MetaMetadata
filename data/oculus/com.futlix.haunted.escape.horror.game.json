974841_1668334480566303_7727439569636657572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aw1_h5_l9I8Q7kNvwF4Ai-B&_nc_oc=AdmXxdX2HjbcIpwG1dSQGlCNIh_TAYZZUt-25BuQ6jNQ9kMFJh7vs6UlVpM-LHPrupI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftQkRbgpmoazB1WGyKx1bZhSdTnZHbQcbMaGLwxg0882Q&oe=69986A77"}, {"file_name": "SS5.png", "id": "1213062970013122", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982495_1213062973346455_3756223896267353315_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkfHsvC4dMUQ7kNvwHCATlr&_nc_oc=Adl7IHiztD3X3T4FEYrLbTBOMsN53XvbuXaWWb2P8EjUehrXtKAK35KvgiPxfZCSP8c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsNM8HRoPbPz8Vpp6AWHPrKjQkYUnKRFyoSKPMYX3OneQ&oe=69985B02"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Haunted Exit Escape Room - Horror Games", "keywords": ["Horror", "Scary", "Haunted", "Granny", "Fear"], "long_description": "Welcome to Haunted Escape, a VR experience that\u2019ll keep you on the edge of your seat! You\u2019ve got one goal: escape the haunted room before the creepy inhabitants get to you. Solve puzzles, avoid terrifying creatures, and make it out alive.\n\nIn Haunted Escape, you\u2019ll encounter some seriously spooky characters\u2014like a Zombie Dog, a dead Joker, and even an eerie Mummy. Each challenge will test your nerves and your puzzle-solving skills. The best part? You can play it alone or with a friend!\n\nThe game offers two modes:\n- Solo Mode: It\u2019s just you against the haunted room\u2014get out before it\u2019s too late!\n- Co-op Mode: Work with a friend to help each other escape. Can you both survive?\n\nKey Features:\n- Play solo or team up in co-op mode.\n- Face off against creepy creatures like Granny, Ghosts, a Zombie Dog, and more.\n- High-quality VR graphics for an immersive, hair-raising experience.\n- Puzzles that challenge your brain while keeping your heart racing.\n- Exclusively available on Oculus Quest.", "short_description": "Get ready for a spooky adventure in Haunted Escape! You\u2019re trapped in a haunted room, and it\u2019s up to you to find a way out. Face creepy creatures like Granny, Ghosts, and even a Zombie Dog. Whether you're going solo or teaming up with a friend, every moment counts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Futlix Games", "support_website_url": null, "website_url": "https://sites.google.com/view/futlixgames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26877545548526805"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1260370019352590"}, {"status": "PUBLISHED", "id": "1944973176366111"}, {"status": "PUBLISHED", "id": "883073377480076"}, {"status": "PUBLISHED", "id": "1299549061648843"}, {"status": "PUBLISHED", "id": "1752542272356321"}, {"status": "PUBLISHED", "id": "3938471106427593"}, {"status": "PUBLISHED", "id": "1302708607537388"}, {"status": "PUBLISHED", "id": "524413233919584"}, {"status": "PUBLISHED", "id": "1690119055121234"}]}, "baseline_offer": {"id": "1690119055121234"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "1260370019352590"}]}, "liveChannel": {"nodes": [{"
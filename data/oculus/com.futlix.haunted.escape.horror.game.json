830441_1084964457661429_5791265303751373453_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGVi_W9QzPUQ7kNvwG6BX4n&_nc_oc=AdqOC3wqdKNHz9fAE1pcqj9DA-lMhdLlN-BltlK6Enb-l60asGc-VUqo1CAOmZN1X2Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmMhs1TP3LRNScJMHtGo82BBdkGiPuNdtY_BPe9pmZuA&oe=6B0847FB"}, {"file_name": "1.png", "id": "1371566178136543", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/793139181_1371566181469876_772737679900740954_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Rkx7D9ViQMQ7kNvwETvMsP&_nc_oc=AdpEchFm6iVUMsQh1rtZZi3i5C5VrTHaE6NbUnBN3qadochXlaWwWBzxksHmmRO3cfo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwEawSlV4Ao5CaVY-7S1dODc8EZ-aA9U3Bunt9bklHBg&oe=6B086A00"}, {"file_name": "2.png", "id": "1756098462126690", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/604347072_1756098465460023_1018908953880571156_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5G8pJQ0d2sQ7kNvwGQlR0_&_nc_oc=AdoS3JCROuI9u8B2DkJKr7KrxhXfZnZXqBJjmjec9unl__JNJV8ogU87AxP6-FjLmWk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdFZazgEZT2X8FFaVHsMN35X5hXtz_JACm__1sD4g_gA&oe=6B086CC8"}, {"file_name": "4.png", "id": "1633144218195167", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491830441_1633144221528500_6050571958921125258_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_DGehaV4J4Q7kNvwF3JDvj&_nc_oc=AdqJgXtMPkAf0C_SIE_EkSTmnoZ1FmIeDZYwbMy3oQSWC7GOAA5qhXtKKSclGv4VuvQ&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfYS_sjrD6XfGZYgc0QAUNFhfqU92D4Z7RUiw-Gyd6fQ&oe=6B085510"}, {"file_name": "3.png", "id": "1113974211181531", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/673531334_1113974214514864_4053371199100276452_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0MfMKgnN3YQ7kNvwGA68B6&_nc_oc=Adph_Sjt3MYNmhunWYnG91XeF5H1Ogq5ZE6vpNCzjqQMHf85geb2pWQ-sXWPFJeRJ0A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJ9vcVrEbWZh6Kkc-ROpzp-NLUhtBu-NlmbGMhb_-MSw&oe=6B0873EB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Horror Story VR - Granny Horror Games", "keywords": ["Horror", "Scary", "Haunted", "Zombie", "granny"], "long_description": "Welcome to Horror Story VR - Granny Horror Games, a VR experience that\u2019ll keep you on the edge of your seat! You\u2019ve got one goal: escape the haunted room before the creepy inhabitants get to you. Solve puzzles, avoid terrifying creatures, and make it out alive.\n\nIn Horror Story VR - Granny Horror Games, you\u2019ll encounter some seriously spooky characters\u2014like a Zombie Dog, a dead Joker, and even an eerie Mummy. Each challenge will test your nerves and your puzzle-solving skills. The best part? You can play it alone or with a friend!\n\nThe game offers two modes:\n- Solo Mode: It\u2019s just you against the haunted room\u2014get out before it\u2019s too late!\n- Co-op Mode: Work with a friend to help each other escape. Can you both survive?\n\nKey Features:\n- Play solo or team up in co-op mode.\n- Face off against creepy creatures like Granny, Ghosts, a Zombie Dog, and more.\n- High-quality VR graphics for an immersive, hair-raising experience.\n- Puzzles that challenge your brain while keeping your heart racing.\n- Exclusively available on Oculus Quest.", "short_description": "Get ready for a spooky adventure in Horror Story VR - Granny Horror Games! You\u2019re trapped in a haunted room, and it\u2019s up to you to find a way out. Face creepy creatures like Granny, Ghosts, and even a Zombie Dog. Whether you're going solo or teaming up with a friend, every moment counts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Futlix Games", "support_website_url": null, "website_url": "https://sites.google.com/view/futlixgames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39358128883801680"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/673573223_1128302356367388_1005749405532415751_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tt3k-Ml8cJYQ7kNvwFlxLe-&_nc_oc=Adq5qSfG7ZLcGo4x6DbrvSSisWFE1eTEEIXoZFtrKyPzatkwYZ-SdMo0M_Ac69xzEzY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQn4W6a7SJlBVmi1D8W2cEWmyKSp7floctgZCpwOd9HCA&oe=6B086118"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Horror Story VR - Granny Horror Games", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1727792700, "lastRevision": {"nodes": [{"id": "26828012596813434", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26828012463480114", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {
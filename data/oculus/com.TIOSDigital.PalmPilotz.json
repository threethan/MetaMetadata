e": "com.TIOSDigital.PalmPilotz-20241118-183936.png", "id": "852968257047129", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974841_852968260380462_6623374116287404700_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=solUia_M8-UQ7kNvwG_Lvz-&_nc_oc=AdoDeSsR-evpP_zmg_PWnS83spAzCK3y6u0jLmKQ_gIPtiXVT5qxhn3LX8n-SU10gng&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3dZv00vZLdLvsYIkR0f1fT7cpdBJemEo20mhqTtLGgA&oe=6B07006A"}, {"file_name": "com.TIOSDigital.PalmPilotz-20241119-161403.png", "id": "834477825299103", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031422_834477828632436_4764730918078749795_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XpV2dHZACMQ7kNvwHdFtyY&_nc_oc=AdqHndbFXSa_o7eoFpRYKVxoheE-5PZzEKbDMf6k616x2ymXF8IV7g-8mNcHcm-pm40&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6gf0cEASdBkA-gXNHDYCuaRegw8a1L-uQVkSlFsWodg&oe=6B070A5A"}, {"file_name": "com.TIOSDigital.PalmPilotz-20241118-184126.png", "id": "553143727417445", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003232_553143730750778_8065540037986360416_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlPVxUs9i9cQ7kNvwHtktX2&_nc_oc=Ado0Zej0DFZiWo_SRtMQpzDSZ5CpY5xyXxzJZlGcLVdyQO1sTO8udZkYHWvbWcT2qOo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRE1G4-tY2mslTWCzSj7ofy9HnI-WKJ6TqPVnK6L56klQ&oe=6B06FF4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "palm pilots cover3.png", "id": "1515560852475805", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75305757_1515560855809138_2034385607350717388_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XScthGh4ZGcQ7kNvwHUFqQd&_nc_oc=Adrao2I2j-kHKC2DM9HDRe56Bb4NEqt65_TDAOLUDBXET2iVxl6yf74lh1DU4fAZ_98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY4OP_GXB1V69--pQOf2E93Uo3xJ3UOlA8RNHA2o_UMA&oe=6B07017F"}, "display_name": "PalmPilotz", "keywords": ["Space", "Pilot", "shoot", "asteroid", "music"], "long_description": "Fast paced VR game that blends music, arcade action and skill into an exhilarating experience! Take control of a tiny spaceship with the power of your hands as you navigate through intense asteroid fields, battle alien ships, collect power-ups and more. The real magic happens with our custom music player, where dynamic music effects sync seamlessly with your gameplay, creating a one-of-a-kind audio-visual adventure. Race against the clock, rack up high scores, and get your heart pumping as you engage in a sci-fi, rhythm-infused arcade classic. ", "short_description": "A fast paced VR experience where music, arcade action, and movement all collide! Control a tiny spaceship with your hand as you zoom through asteroid fields and battle alien ships to the beat of your own music. The game\u2019s unique custom music player syncs dynamic audio effects to your gameplay, creating an immersive, rhythm-driven experience. Race against the clock, chase high scores, and get your heart racing in this sci-fi, musical challenge. Ready to take off?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://info.tiosdigital.com/", "developer_terms_of_service_url": null, "publisher_name": "TIOS Digital", "support_website_url": null, "website_url": "http://tiosdigital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
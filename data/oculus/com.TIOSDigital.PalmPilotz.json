e": "com.TIOSDigital.PalmPilotz-20241118-183936.png", "id": "852968257047129", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974841_852968260380462_6623374116287404700_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxwrzEty7jgQ7kNvwGOysrk&_nc_oc=AdqvfqHRq73J1BCFN6nL0ZJCdKpqPd7daZWjpi92I3xsDKwRqe2mFJ23xyaKzt0pemw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-pUQiCJcfZo18_3cUDm3PBmxDTBByk5Rvh4d2yppRfg&oe=6B01BA6A"}, {"file_name": "com.TIOSDigital.PalmPilotz-20241119-161403.png", "id": "834477825299103", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031422_834477828632436_4764730918078749795_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zMolwPWObEQ7kNvwGKBxhc&_nc_oc=AdpFTtIPyxLMC7khpTEaFsZaT7l9-VcoWNwc0PET_CYHh3Pne3HtVSjgGswIiv_aXNY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYy-yf0NI_LmlN7pLZA5mVsY1HTO9Q29hEUbduL7x51Q&oe=6B01C45A"}, {"file_name": "com.TIOSDigital.PalmPilotz-20241118-184126.png", "id": "553143727417445", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003232_553143730750778_8065540037986360416_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jconn_H7shIQ7kNvwE9GjUR&_nc_oc=AdriMrFgaStffPfUf3joPnPe8EB19aflLx0jIdX45rsdIl20yMO_AlZr3UacngAsQ0g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdPiT_WSK4vKEWivDVjzeXG45yp8PQ7LVA1zHgeF-B2Q&oe=6B01B94F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "palm pilots cover3.png", "id": "1515560852475805", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75305757_1515560855809138_2034385607350717388_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGIDmiosA9EQ7kNvwEOry_M&_nc_oc=Ado7xSvtB1kl8pyRPa4C9C8_VrZ6YORuG2s2jBRmsI-NULWMVRof6oUDJ0o6Fq_PGeE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPTmazfbuwcoU6S9ppzLg8OZ3RdVSJZuW2JC1tpsMY1A&oe=6B01BB7F"}, "display_name": "PalmPilotz", "keywords": ["Space", "Pilot", "shoot", "asteroid", "music"], "long_description": "Fast paced VR game that blends music, arcade action and skill into an exhilarating experience! Take control of a tiny spaceship with the power of your hands as you navigate through intense asteroid fields, battle alien ships, collect power-ups and more. The real magic happens with our custom music player, where dynamic music effects sync seamlessly with your gameplay, creating a one-of-a-kind audio-visual adventure. Race against the clock, rack up high scores, and get your heart pumping as you engage in a sci-fi, rhythm-infused arcade classic. ", "short_description": "A fast paced VR experience where music, arcade action, and movement all collide! Control a tiny spaceship with your hand as you zoom through asteroid fields and battle alien ships to the beat of your own music. The game\u2019s unique custom music player syncs dynamic audio effects to your gameplay, creating an immersive, rhythm-driven experience. Race against the clock, chase high scores, and get your heart racing in this sci-fi, musical challenge. Ready to take off?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://info.tiosdigital.com/", "developer_terms_of_service_url": null, "publisher_name": "TIOS Digital", "support_website_url": null, "website_url": "http://tiosdigital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
0_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoolTAUmP5AQ7kNvwHOhiV6&_nc_oc=AdpRNS3Qk1WvjNSlDLxyy9ZKZB2RPRRYagK8P06_jweS11if3vDp5odAWTL27eVwPXI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6DsW4lNWzaxV-oJ3h8cGKKU5t8anyR3VSMKUBJ0SK1g&oe=6AECA26A"}, {"file_name": "com.TIOSDigital.PalmPilotz-20241119-161403.png", "id": "834477825299103", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031422_834477828632436_4764730918078749795_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-UHIbAugg0Q7kNvwFT5chF&_nc_oc=AdqBntOQghGWXE4cPHPdCEYs2bfIwXlAlfrmQLSh3Kus0aqrdn18Ue4GMu5mojv3tPA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGjvQ58e_dBzwIy6YYDzmtaGL3Tv1f1TSKrR0e1P_C7w&oe=6AECAC5A"}, {"file_name": "com.TIOSDigital.PalmPilotz-20241118-184126.png", "id": "553143727417445", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003232_553143730750778_8065540037986360416_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHtGE9ATuG4Q7kNvwG9Ikzn&_nc_oc=AdrZAYFn5inDoJxjle-MlPHEXzJjKKaHtyqs-CZIsDK_zvdm0xivH3feiPRPjgHQN6g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiKusbpHJh3K2X5DVr0oKRGfpEXIT_opQCkjtu_KPnNQ&oe=6AECA14F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "palm pilots cover3.png", "id": "1515560852475805", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75305757_1515560855809138_2034385607350717388_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiBZ1go6huEQ7kNvwHfvlk5&_nc_oc=AdqfxVNcODdT4GjB5429nOXySV010UbgaG1JsEohaPyNToc6JtymmrQdrMIKQ_L-jbI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRn3nOTfVeUl2kYzoDusdi38F9S5kTIH2Y96CTkwNCYFw&oe=6AECA37F"}, "display_name": "PalmPilotz", "keywords": ["Space", "Pilot", "shoot", "asteroid", "music"], "long_description": "Fast paced VR game that blends music, arcade action and skill into an exhilarating experience! Take control of a tiny spaceship with the power of your hands as you navigate through intense asteroid fields, battle alien ships, collect power-ups and more. The real magic happens with our custom music player, where dynamic music effects sync seamlessly with your gameplay, creating a one-of-a-kind audio-visual adventure. Race against the clock, rack up high scores, and get your heart pumping as you engage in a sci-fi, rhythm-infused arcade classic. ", "short_description": "A fast paced VR experience where music, arcade action, and movement all collide! Control a tiny spaceship with your hand as you zoom through asteroid fields and battle alien ships to the beat of your own music. The game\u2019s unique custom music player syncs dynamic audio effects to your gameplay, creating an immersive, rhythm-driven experience. Race against the clock, chase high scores, and get your heart racing in this sci-fi, musical challenge. Ready to take off?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://info.tiosdigital.com/", "developer_terms_of_service_url": null, "publisher_name": "TIOS Digital", "support_website_url": null, "website_url": "http://tiosdigital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "40149427468004104"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/822999402_1119513867592062_7012762363838
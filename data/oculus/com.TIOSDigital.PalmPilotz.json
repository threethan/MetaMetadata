e": "com.TIOSDigital.PalmPilotz-20241118-183936.png", "id": "852968257047129", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974841_852968260380462_6623374116287404700_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=solUia_M8-UQ7kNvwEsgDVx&_nc_oc=AdraNvLFaBbTgR9_OKn_pWU6l0DgoRxKY7Zz8yKf-v5t_IgA_-YNq4kEG5fM8z539dg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVLeusOrJTLSK2qOvMl7ywIkgBnpPDAi_CvJOavBmKHg&oe=6B05AEEA"}, {"file_name": "com.TIOSDigital.PalmPilotz-20241119-161403.png", "id": "834477825299103", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031422_834477828632436_4764730918078749795_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XpV2dHZACMQ7kNvwH2ga3J&_nc_oc=Ado_pSwnEqAF1q4rVyFZACN-MK8aHA85_ED5YE95P_Z2cH4kM2o5LKtJnBJfMZwRF9g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-MwNrimSdw_kHXon7IEbb7gupheSoa1KufBiGVjv5Rg&oe=6B05B8DA"}, {"file_name": "com.TIOSDigital.PalmPilotz-20241118-184126.png", "id": "553143727417445", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003232_553143730750778_8065540037986360416_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlPVxUs9i9cQ7kNvwEBStc-&_nc_oc=AdoGC5e1-nSjMKTfppi4WMOBbzR3qZz95EE59PH_Ji3Uj1YqaT_xPWm0pLd-mX5s_h8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMCyag2mpKB9Mme7O4zFe_DWddLXfAYQP3j4AOMyCrQw&oe=6B05ADCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "palm pilots cover3.png", "id": "1515560852475805", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75305757_1515560855809138_2034385607350717388_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XScthGh4ZGcQ7kNvwFrxeEF&_nc_oc=AdpwlYuFFSE2lh_h74IrUWHH5rYbFSXXUEEAUz8-zBuFWPpAqZZ7cahuJmu1k63D18Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrgrrqxpbOIRrOHY9br9P7dgbUf5_BJJaejD-OhjHJjQ&oe=6B05AFFF"}, "display_name": "PalmPilotz", "keywords": ["Space", "Pilot", "shoot", "asteroid", "music"], "long_description": "Fast paced VR game that blends music, arcade action and skill into an exhilarating experience! Take control of a tiny spaceship with the power of your hands as you navigate through intense asteroid fields, battle alien ships, collect power-ups and more. The real magic happens with our custom music player, where dynamic music effects sync seamlessly with your gameplay, creating a one-of-a-kind audio-visual adventure. Race against the clock, rack up high scores, and get your heart pumping as you engage in a sci-fi, rhythm-infused arcade classic. ", "short_description": "A fast paced VR experience where music, arcade action, and movement all collide! Control a tiny spaceship with your hand as you zoom through asteroid fields and battle alien ships to the beat of your own music. The game\u2019s unique custom music player syncs dynamic audio effects to your gameplay, creating an immersive, rhythm-driven experience. Race against the clock, chase high scores, and get your heart racing in this sci-fi, musical challenge. Ready to take off?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://info.tiosdigital.com/", "developer_terms_of_service_url": null, "publisher_name": "TIOS Digital", "support_website_url": null, "website_url": "http://tiosdigital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
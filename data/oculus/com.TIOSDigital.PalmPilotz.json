0_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whsNj_c-U-EQ7kNvwG_QWzp&_nc_oc=Adrf54CHs56eCTCgkrgrDDOh8lho0SJb-oQKhFnsJmn3LLSL_FtVrEQxexWeTQo1wUM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSptDlCsun1hmTvzpzO4QggGIJ2Cl4ElvOUkircnkPjIA&oe=6AF72E6A"}, {"file_name": "com.TIOSDigital.PalmPilotz-20241119-161403.png", "id": "834477825299103", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031422_834477828632436_4764730918078749795_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BeWn2aphJK8Q7kNvwEsI7AT&_nc_oc=AdqUFVXtCY2Ne0gf5b8y38PPgUfROrmoZH6l3Mbwqnv7DWldyQazO9xiAnKrvXpkr-M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAjDh0s6elqIKw32ymnHlTE2y7eVFojLogwndWdkmm2A&oe=6AF7385A"}, {"file_name": "com.TIOSDigital.PalmPilotz-20241118-184126.png", "id": "553143727417445", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003232_553143730750778_8065540037986360416_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugAlWDFYjkQQ7kNvwHQ5Qp2&_nc_oc=AdpFdHZN_FMEScEungif_hz9us20ylxCQoIFVFZ4QmeHhH_KqMwOYAjC2aFuyo9v7_M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTy-DVh8MNQKiL51-fM-_SsLhazEaVneZ-l6IJuZ_borw&oe=6AF72D4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "palm pilots cover3.png", "id": "1515560852475805", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75305757_1515560855809138_2034385607350717388_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYfIhzKOne4Q7kNvwG9St2d&_nc_oc=AdrMqPuaJpks6iYASIUVbGq-shKpfkHOLljFYxm7X_WAPGUFFYr2iEklsG1hSAAtftc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSd5VYIZenDYXtIfwMwyqwhq-W2coOp6fnWtwOULQyJaw&oe=6AF72F7F"}, "display_name": "PalmPilotz", "keywords": ["Space", "Pilot", "shoot", "asteroid", "music"], "long_description": "Fast paced VR game that blends music, arcade action and skill into an exhilarating experience! Take control of a tiny spaceship with the power of your hands as you navigate through intense asteroid fields, battle alien ships, collect power-ups and more. The real magic happens with our custom music player, where dynamic music effects sync seamlessly with your gameplay, creating a one-of-a-kind audio-visual adventure. Race against the clock, rack up high scores, and get your heart pumping as you engage in a sci-fi, rhythm-infused arcade classic. ", "short_description": "A fast paced VR experience where music, arcade action, and movement all collide! Control a tiny spaceship with your hand as you zoom through asteroid fields and battle alien ships to the beat of your own music. The game\u2019s unique custom music player syncs dynamic audio effects to your gameplay, creating an immersive, rhythm-driven experience. Race against the clock, chase high scores, and get your heart racing in this sci-fi, musical challenge. Ready to take off?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://info.tiosdigital.com/", "developer_terms_of_service_url": null, "publisher_name": "TIOS Digital", "support_website_url": null, "website_url": "http://tiosdigital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "40149427468004104"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/822999402_1119513867592062_7012762363838
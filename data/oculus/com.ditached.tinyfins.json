/v/t64.5771-25/39031514_2862364260579688_306087352317523359_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEIDJYnNp7UQ7kNvwGltHQQ&_nc_oc=AdmuXRlyw-WJif7PEstInP00mBuUXbdVAfwvTGKk3XFF_xICWa-_A0O585-rh2xsOOQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhU6KwILugvk2JarnOolz0EEJ8Z5dMfRG2xF6V0ZYisw&oe=69B15A40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer COver.png", "id": "1288041185499986", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_1288041188833319_1651999487860440247_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwq8rZ1iKBQQ7kNvwErmFbk&_nc_oc=AdkWc6nKb6okjo6YmJYU6Ii-kvcFaXHhCFJrREBaoRNRkWX5adaDi4LuomOPzPAx2SA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3Byp8hY4ndImst_vEgvI6GOuBrlUW6xbczcJcgqV66g&oe=69B15D11"}, "display_name": "TinyFins", "keywords": ["cute", "highscore", "underwater", "fish", "mixedreality"], "long_description": "Tiny Fins lets you swim free in an ocean playground, guiding a school of cute fish with a sweep of your hand. Dive past colorful clams, snag bunches of bubbles, and avoid hungry sharks!\n\nWhy you will love it: Super-smooth controls that make sudden sprints and quick pivots a cinch when you\u2019re gliding through the water. They\u2019re a lifesaver when you go from popping a string of bubbles to deftly avoiding a spiky puffer fish!\n\nFeatures include:\n- Shark, pufferfish and squid enemies\n- Highscore system with the ability to unlock ranks and trophies\n- Intuitive, flowy controls\n- Collecting fish of different colors", "short_description": "Tiny Fins lets you swim free in an ocean playground, guiding a school of cute fish with a sweep of your hand. Dive past colorful clams, snag bunches of bubbles, and avoid hungry sharks!\n\nWhy you will love it: Super-smooth controls that make sudden sprints and quick pivots a cinch when you\u2019re gliding through the water. They\u2019re a lifesaver when you go from popping a string of bubbles to deftly avoiding a spiky puffer fish!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tiny-fins.com/imprint.html", "developer_terms_of_service_url": null, "publisher_name": "Ditached GmbH", "support_website_url": null, "website_url": "https://ditached.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "fr_CA", "ja", "zh_CN", "zh_HK", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26652350321030138"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2046530205764406"}, {"status": "PUBLISHED", "id": "1319438632776054"}, {"status": "PUBLISHED", "id": "559210789767808"}]}, "baseline_offer": {"id": "559210789767808"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1725987600, "status": "PUBLISHED", "id": "559210789767808"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26633301819601655", "version": "1.0.0"}, "id": "378196961970722", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26601010829497421", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26633301819601655"}, "release_status": "RELEASED"}, "binary_release_channels":
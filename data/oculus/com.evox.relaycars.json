_ss=7a30f&oh=00_Af1RcbwcVGRVasxAPjRd8tAlyI0iFpwMgtFbLy1utoKi-w&oe=69E244BC"}, {"file_name": "migrated_image.png", "id": "1093708840991588", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75207234_614918482587737_6997342980428267520_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4uaVGXGzDwQ7kNvwFU07hp&_nc_oc=AdpEnI3aZFJecP7cq_Y08TaR1S5a8VdiQogzyebYtJvPd_1LC-GUiZPXedTt9ChiBn0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1K_hl023TuFir-BSb3sg46eOjxSl3uyYguSY4vv7rXLg&oe=69E226F2"}, {"file_name": "migrated_image.png", "id": "510318879617479", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036678_532324200689746_8271002024384921600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgig14czJTEQ7kNvwEwSh2D&_nc_oc=Adr-Ri7lUSIGml020qG5aiRHYyGFPV4v3Ax0FqbX3bgBNzDfgjjKEHr883ZDUh3fxjg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UzoodWaDz7_Y5atYnH0cFijVPYH59BaU4GOkBYTSteg&oe=69E2459E"}, {"file_name": "migrated_image.png", "id": "539849636659332", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12504730_229751870915377_3107558359352475648_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64WDN_5UXGMQ7kNvwEMvXJG&_nc_oc=AdqvSCFRyffqVr3RIY6bGAPbGb2Vd7a47q1iWs-ue6uSkA0rOHo09aFo4IH1c2b6uMs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fglq88zAnt7lHfwCL1eYZgjuDkk4vZcOxKOJb_-1u7w&oe=69E251A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RelayCars", "keywords": ["auto", "automotive", "car", "cars", "honda", "mercedes", "porsche", "race", "showroom", "tesla", "toyota", "volkgwagen"], "long_description": "RELAYCARS\u00ad\u00ae is a truly immersive automotive VR showroom experience. This latest release introduces the \u201cSupercar Virtual Showroom\u201d experience featuring the Lamborghini Huracan. Explore the edgy lines on the exterior of this exotic, get behind the wheel and explore the interior, or, take a virtual test ride in the open desert\u00ad\u2013 all in full immersive, stereo 360.  Want to hear how it sounds? Just click the start button and choose from the Lamborghini\u2019s three different start modes. Once you are done with your supercar experience, go back to the lobby and choose from any of over a thousand vehicles in our extensive vehicle library and explore the interior and exterior of the vehicle in full 360\u00ba stereo. Our environments feature models ranging from exotics to sedans,hybrids to full-size trucks. We hope you enjoy this latest release of RELAYCARS\u00ae and look for further updates soon.", "short_description": "RELAYCARS\u00ad\u00ae is a truly immersive automotive VR showroom experience. This latest release introduces the \u201cSupercar Virtual Showroom\u201d experience featuring the Lamborghini Huracan."}]}, "developer_name": "RelayCars LLC", "developer_privacy_policy_url": "https://www.relaycars.com/privacy-policy/", "developer_terms_of_service_url": "https://www.relaycars.com/terms-conditions/", "publisher_name": "RelayCars LLC", "support_website_url": null, "website_url": "http://www.relaycars.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1086166345570732"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974473_549237885631163_4093797298507612160_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3IfR7l6QI0Q7kNvwH2qYmh&_nc_oc=AdqGtt6nOiH
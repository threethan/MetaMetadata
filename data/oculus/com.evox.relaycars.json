_ss=7f20f&oh=00_AQS7p64QQ4PWFVVX1vEbksfG4m0P0SRxgwnVTTruvaZQ-g&oe=6AF5CE3C"}, {"file_name": "migrated_image.png", "id": "1093708840991588", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75207234_614918482587737_6997342980428267520_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbatJsHrO6EQ7kNvwEHP-Gs&_nc_oc=Adr5vy1bvGz8ZvpMB8LjrtZgFptMwv0kdIsXIGwkPx40pv1TFIdTU7hZyPzo_cP4MFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSewpA93Gc8x2KZuIURYuiCsvgKtw2L8O6mv4aRs7cpTA&oe=6AF5E8B2"}, {"file_name": "migrated_image.png", "id": "510318879617479", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036678_532324200689746_8271002024384921600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KG7nwiljEWcQ7kNvwH_he1K&_nc_oc=AdqG5vOF_SJidkj38EYlYj7shG85s4pv1GgSnNEgfz_4OgLnhTq1QDTqZ1CphfaRxrI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGcZz4zKDj_7aIEljJi8M2Ixx1TBghFuKeamGq7ICyhQ&oe=6AF5CF1E"}, {"file_name": "migrated_image.png", "id": "539849636659332", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504730_229751870915377_3107558359352475648_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oB4CMu6ts0AQ7kNvwGhUkSX&_nc_oc=AdqzvQ34NpWVMB0D_yHd4wcYuZboXjhyWBKwhrF7CJ5YJahqUP5X7Vhk1Ni-5-JpNx0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkab9z9Av0xWpDxuLTjPksLOYX8X19ubtmG0suP5XW3A&oe=6AF5DB23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RelayCars", "keywords": ["auto", "automotive", "car", "cars", "honda", "mercedes", "porsche", "race", "showroom", "tesla", "toyota", "volkgwagen"], "long_description": "RELAYCARS\u00ad\u00ae is a truly immersive automotive VR showroom experience. This latest release introduces the \u201cSupercar Virtual Showroom\u201d experience featuring the Lamborghini Huracan. Explore the edgy lines on the exterior of this exotic, get behind the wheel and explore the interior, or, take a virtual test ride in the open desert\u00ad\u2013 all in full immersive, stereo 360.  Want to hear how it sounds? Just click the start button and choose from the Lamborghini\u2019s three different start modes. Once you are done with your supercar experience, go back to the lobby and choose from any of over a thousand vehicles in our extensive vehicle library and explore the interior and exterior of the vehicle in full 360\u00ba stereo. Our environments feature models ranging from exotics to sedans,hybrids to full-size trucks. We hope you enjoy this latest release of RELAYCARS\u00ae and look for further updates soon.", "short_description": "RELAYCARS\u00ad\u00ae is a truly immersive automotive VR showroom experience. This latest release introduces the \u201cSupercar Virtual Showroom\u201d experience featuring the Lamborghini Huracan."}]}, "developer_name": "RelayCars LLC", "developer_privacy_policy_url": "https://www.relaycars.com/privacy-policy/", "developer_terms_of_service_url": "https://www.relaycars.com/terms-conditions/", "publisher_name": "RelayCars LLC", "support_website_url": null, "website_url": "http://www.relaycars.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1086166345570732"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_549237885631163_4093797298507612160_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9awOauvoZQQ7kNvwEeETSi&_nc_oc=Adp9SYUza2L
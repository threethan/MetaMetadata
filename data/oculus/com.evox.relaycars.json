_ss=7f20f&oh=00_AQNJUN_zRAtgoqseekj6ipof_Wvpz-sUrczAM9i0DOGi4w&oe=6AC8FB3C"}, {"file_name": "migrated_image.png", "id": "1093708840991588", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75207234_614918482587737_6997342980428267520_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqRAGhuvXlsQ7kNvwFK5A89&_nc_oc=Adp9NxF5-2eD0GCFXIABUPqubf1hvN-fcO-wEzdDvLmVulYgVs7TuE_sFTKLqKFQYQg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTOA0DZ94sgfT5zSSdZtvekAwsh4ODfrJZnC56sJSXGQ&oe=6AC915B2"}, {"file_name": "migrated_image.png", "id": "510318879617479", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036678_532324200689746_8271002024384921600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOwemMcM1CMQ7kNvwGykNkx&_nc_oc=AdoWbsYtW0PseGI1k9C40lonzpJwKSmny7dwy1K9iqdPZRQn6b9YUM38hAiSbwQf4Cg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1GGzRbN84vd45RYOc83ir0pjoHwtGXKzAZduPXQNR7A&oe=6AC8FC1E"}, {"file_name": "migrated_image.png", "id": "539849636659332", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12504730_229751870915377_3107558359352475648_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xe6JUrvmiQQ7kNvwER1RbV&_nc_oc=Adq6VY2rZ1_ojloGCD08OySD8jKEK_OYQBGDrbmv5BvWR493eBlGZxyE0g1803EZEm0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWawYCZWt3M3Pb66kMkij2H0hlSSfezPl8UZBjRKS_xg&oe=6AC90823"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RelayCars", "keywords": ["auto", "automotive", "car", "cars", "honda", "mercedes", "porsche", "race", "showroom", "tesla", "toyota", "volkgwagen"], "long_description": "RELAYCARS\u00ad\u00ae is a truly immersive automotive VR showroom experience. This latest release introduces the \u201cSupercar Virtual Showroom\u201d experience featuring the Lamborghini Huracan. Explore the edgy lines on the exterior of this exotic, get behind the wheel and explore the interior, or, take a virtual test ride in the open desert\u00ad\u2013 all in full immersive, stereo 360.  Want to hear how it sounds? Just click the start button and choose from the Lamborghini\u2019s three different start modes. Once you are done with your supercar experience, go back to the lobby and choose from any of over a thousand vehicles in our extensive vehicle library and explore the interior and exterior of the vehicle in full 360\u00ba stereo. Our environments feature models ranging from exotics to sedans,hybrids to full-size trucks. We hope you enjoy this latest release of RELAYCARS\u00ae and look for further updates soon.", "short_description": "RELAYCARS\u00ad\u00ae is a truly immersive automotive VR showroom experience. This latest release introduces the \u201cSupercar Virtual Showroom\u201d experience featuring the Lamborghini Huracan."}]}, "developer_name": "RelayCars LLC", "developer_privacy_policy_url": "https://www.relaycars.com/privacy-policy/", "developer_terms_of_service_url": "https://www.relaycars.com/terms-conditions/", "publisher_name": "RelayCars LLC", "support_website_url": null, "website_url": "http://www.relaycars.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1086166345570732"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974473_549237885631163_4093797298507612160_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LYh46598tgQ7kNvwEQmjef&_nc_oc=AdoV7ekdxE4
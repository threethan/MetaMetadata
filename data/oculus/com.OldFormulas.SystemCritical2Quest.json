ns of enemies to kill."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1xvZa8lDaZ6EqFPTYsS0ERTAbSm1_WTzR/edit?usp=sharing&ouid=103483450248593078910&rtpof=true&sd=true", "developer_terms_of_service_url": null, "publisher_name": "Old Formulas", "support_website_url": null, "website_url": "https://youtube.com/@RxPharmacytech", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "317201160755965"}}]}, "scheduled_offers": {"count": 19, "nodes": [{"status": "PUBLISHED", "id": "1060970346905673"}, {"status": "PUBLISHED", "id": "27757270783914889"}, {"status": "PUBLISHED", "id": "1007822305559537"}, {"status": "PUBLISHED", "id": "2160585474777964"}, {"status": "PUBLISHED", "id": "912007471530772"}, {"status": "PUBLISHED", "id": "1306966724784783"}, {"status": "PUBLISHED", "id": "1202102968782646"}, {"status": "PUBLISHED", "id": "2073688986791239"}, {"status": "PUBLISHED", "id": "1090525989958998"}, {"status": "PUBLISHED", "id": "787050274045906"}, {"status": "PUBLISHED", "id": "1885570102292989"}, {"status": "PUBLISHED", "id": "1227225619118927"}, {"status": "PUBLISHED", "id": "1151925529839618"}, {"status": "PUBLISHED", "id": "620531037045616"}, {"status": "PUBLISHED", "id": "1778528629561151"}, {"status": "PUBLISHED", "id": "906216571338308"}, {"status": "PUBLISHED", "id": "498710
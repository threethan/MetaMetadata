sid=6e7a0a&_nc_ohc=LsxkQ64l7RoQ7kNvwGtTwwd&_nc_oc=AdolcJhAFSpHn6NHki_EULV1STKOLIpf8WKw4m8G6EdywIULx4Nn4qlXb5NA-WrffgY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExaGmvReYhHL2JPI1pR3jYMe2Mtk-Qx10KEdH8zqyr3A&oe=6A9011DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1140.png", "id": "976857326985219", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982565_976857330318552_3821234384762295283_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ik9_IE8TsqMQ7kNvwGw0qio&_nc_oc=AdoEWscOck7bzAOE5DwiQVHzSBhUp7fvYq9Og6ml4BjSmPNzKHMoLCyxrcgNI9EC6ng&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_tRdMRRql-D6nUVd5jAsB3qMylmgAf8Qiq7ZwYcikcQ&oe=6A901B96"}, "display_name": "System Critical 2", "keywords": [], "long_description": "System Critical 2 the Sequel to System Critical: The Race Against Time is a retro style run and gun platformer shooter brought to you in glorious VR! With loads of Weapons and levels to master This game will keep you on your toes for hours. Make your way through outer space and cold distant planets and fight bosses to progress. Expect a fun and addictive game that feels rewarding when you complete a difficult level. Experience the feeling of being a futuristic Cyborg in VR that strikes quickly and kills with deadly precision.", "short_description": "System Critical 2 is bigger & badder than ever before! Get ready to experience a platformer shooter like no other in VR. Blast your arm cannon and use guns, melee weapons, grenades,& shields to make your way through the carefully crafted levels with epic boss battles and tons of enemies to kill."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1xvZa8lDaZ6EqFPTYsS0ERTAbSm1_WTzR/edit?usp=sharing&ouid=103483450248593078910&rtpof=true&sd=true", "developer_terms_of_service_url": null, "publisher_name": "Old Formulas", "support_website_url": null, "website_url": "https://youtube.com/@RxPha
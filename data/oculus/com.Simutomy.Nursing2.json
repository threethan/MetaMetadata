: "1351370019994102", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312338_1351370023327435_4007166242616404030_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fy_ogWeqLf0Q7kNvwFjEZWD&_nc_oc=AdrR8YMaRUGa0sfzBkYDIT_DiTGlTyk5DT94V1SgTZr0GzX7v-DcszzlfU-yFW2VzHg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOhjhYkRcS6x2RscEx25IEoMKHdYaFteAxbzyD-t4ORQ&oe=6AC26B70"}, {"file_name": "Screenshot 3.png", "id": "2490148298136617", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311597_2490148301469950_3644936592338155287_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mi6Gcqeh38oQ7kNvwHkL_ir&_nc_oc=Adp7nAFRPJSJuxKkcBba7P9gwUBBm7LprTYLDdG1T85yj51ncp1-KR4lpgRbDSQ2AX0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPOgL__ecJS_JK1HY1BLrUuMivBOtE8lnYpHT6g0PHBA&oe=6AC28502"}, {"file_name": "Screenshot 1.png", "id": "1272690569266167", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313063_1272690572599500_5549806527610731280_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwyWw0Xbe4QQ7kNvwH4hksc&_nc_oc=AdqouG_WTUey4dhZvRreLpRmww7ZIRWGDHulx80BJj5WZ3WaVrXchuU1gB7Lym2siAI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpLv-2hFz8AMSWgt7qWra4_bBq-aMAuSBEinc8hfLHIA&oe=6AC2562B"}, {"file_name": "Screenshot 4.png", "id": "28034351522847754", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307962_28034351536181086_2435077088441645716_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xz1VVkEPpf4Q7kNvwGFQAIZ&_nc_oc=AdpEHckFmfWL6-Mabm6vYMs55yfL4C8sjRbeovMP5VHnEqzW6Cu56AtZwUE2AxfpivE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMVZ6Y5-mM1gfZ08nhDRhM3siECFHfWdLNA3s0MVJfoQ&oe=6AC25D4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_cover.png", "id": "2486413238437251", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/585727769_2486413241770584_4031724775493712605_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2WDCukNitAQ7kNvwGCbEk9&_nc_oc=Adrd7XcsHBEkgSH2pn3voHdrxZnihIAP8rdd4HlsGsY-u-66lzfqCWu1a34WZ-BwVbs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPodiqzVXkTHmec-vjK4aZeRXsanUcgs7pK9iuhJUNkRA&oe=6AC25DAA"}, "display_name": "Viscer Nursing I", "keywords": ["Nursing", "Simulation", "Medical", "Training", "Education"], "long_description": "VisceR Nursing I is an immersive VR clinical training experience designed for nursing students and healthcare learners. It enables learners to practice essential clinical skills and procedures in a safe, repeatable, risk-free virtual environment.\n\nThe pack covers three key areas:\n\nGENERAL MEDICINE\n\u2022 Capillary Blood Glucose\n\u2022 Blood Transfusion\n\u2022 Oxygen Therapy\n\u2022 Venipuncture\n\u2022 Peripheral Blood\n\nWOUND CARE & BANDAGING\n\u2022 Basic Wound Care\n\u2022 Ulcer Dressing\n\u2022 Compression Bandage\n\nDERMATOLOGY\n\u2022 KOH Examination\n\u2022 KOH Examination of Scraping for Fungus\n\u2022 Slit Skin Smear for Leprosy\n\u2022 Gram's Stained Smear Interpretation\n\u2022 Dark Ground Illumination\n\u2022 Tissue Smear\n\u2022 Chemical and Electrical Cautery\n\nThrough interactive simulations, learners can understand clinical procedures, practice step-by-step techniques, identify common mistakes, and build confidence before performing skills in real-world clinical settings. The immersive environment supports repeated practice and experiential learning while complementing classroom teaching and skills-lab training.\n\nVisceR Nursing I is part of the wider VisceR healthcare education ecosystem. Several additional packs are available covering other nursing departments, clinical skills, medical specialties, procedures, anatomy, diagnostics, and other areas of healthcare education\u2014allowing institutions and learners to build a comprehensive immersive training library.\n\nLearn, practice, and build clinical confidence with VisceR.", "short_description": "VisceR Nursing I is an immersive VR clinical training experience for nursing students and healthcare learners. Build practical confidence through interactive simulations covering General Medicine, Wound Care & Bandaging, and Dermatology. Practice clinical skills in a safe, repeatable environment, learn from mistakes, and strengthen decision-making and procedural readiness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.viscer.co/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Simutomy Medtech Pvt Ltd", "support_website_url": "https://www.viscer.co/contact", "website_url": "https://www.viscer.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "970758825987333"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619697_2321787041930811_563374516504278816_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_xY6geA-YkQ7kNvwF9KOHV&_nc_oc=Adom46Yc2aWP9NpmnamrH4bgIYEizkJk4u2ymxe_VDQtrLP0sZwTTa2TevC0K4A6scM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOB7rWJSYk8Xh2qHedv9JyvYMPGOF7DXaNMIXBnMcDCnQ&oe=6AC268CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Viscer Nursing I", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", 
ad6-1.oculuscdn.com/v/t64.5771-25/585727769_2486413241770584_4031724775493712605_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2WDCukNitAQ7kNvwGCbEk9&_nc_oc=Adrd7XcsHBEkgSH2pn3voHdrxZnihIAP8rdd4HlsGsY-u-66lzfqCWu1a34WZ-BwVbs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPodiqzVXkTHmec-vjK4aZeRXsanUcgs7pK9iuhJUNkRA&oe=6AC25DAA"}, "display_name": "Viscer Nursing I", "keywords": ["Nursing", "Simulation", "Medical", "Training", "Education"], "long_description": "VisceR Nursing I is an immersive VR clinical training experience designed for nursing students and healthcare learners. It enables learners to practice essential clinical skills and procedures in a safe, repeatable, risk-free virtual environment.\n\nThe pack covers three key areas:\n\nGENERAL MEDICINE\n\u2022 Capillary Blood Glucose\n\u2022 Blood Transfusion\n\u2022 Oxygen Therapy\n\u2022 Venipuncture\n\u2022 Peripheral Blood\n\nWOUND CARE & BANDAGING\n\u2022 Basic Wound Care\n\u2022 Ulcer Dressing\n\u2022 Compression Bandage\n\nDERMATOLOGY\n\u2022 KOH Examination\n\u2022 KOH Examination of Scraping for Fungus\n\u2022 Slit Skin Smear for Leprosy\n\u2022 Gram's Stained Smear Interpretation\n\u2022 Dark Ground Illumination\n\u2022 Tissue Smear\n\u2022 Chemical and Electrical Cautery\n\nThrough interactive simulations, learners can understand clinical procedures, practice step-by-step techniques, identify common mistakes, and build confidence before performing skills in real-world clinical settings. The immersive environment supports repeated practice and experiential learning while complementing classroom teaching and skills-lab training.\n\nVisceR Nursing I is part of the wider VisceR healthcare education ecosystem. Several additional packs are available covering other nursing departments, clinical skills, medical specialties, procedures, anatomy, diagnostics, and other areas of healthcare education\u2014allowing institutions and learners to build a comprehensive immersive training library.\n\nLearn, practice, and build clinical confidence with VisceR.", "short_description": "VisceR Nursing I is an immersive VR clinical training experience for nursing students and healthcare learners. Build practical confidence through interactive simulations covering General Medicine, Wound Care & Bandaging, and Dermatology. Practice clinical skills in a safe, repeatable environment, learn from mistakes, and strengthen decision-making and procedural readiness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.viscer.co/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Simutomy Medtech Pvt Ltd", "support_website_url": "https://www.viscer.co/contact", "website_url": "https://www.viscer.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "970758825987333"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1018456541025989"}]}, "baseline_offer": {"id": "1018456541025989"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786592040, "status": "PUBLISHED", "id": "1018456541025989"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "973205085742707", "version": "0.2"}, "id": "1247168184135059", "channel_name": "LIVE"}]}, "is_for_oculu
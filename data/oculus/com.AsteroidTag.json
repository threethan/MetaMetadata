hc=z4-CnFzyIJoQ7kNvwHW8hDF&_nc_oc=AdqUUZbPp7Jqb9UUGThdY0iVAvjoz0jrHm6aztCz_CXd7exJYFIC6x15pNHYTHjz_uE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSpte2mhBFU4Cq7QzZcH5_OamA9o6vLy2-EWb9_HX6iA&oe=6AF1F4C6"}, {"file_name": "image.png", "id": "2141215726499619", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823310_2141215729832952_8273553959388643869_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCZ-DkYgIVwQ7kNvwETbsc8&_nc_oc=Adrcb6qSPsW6QpW1SsAV-3hyQQnn-M5hlvXVW3EOwPXDapCeycIyn8QVFldnjW8SafA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT04LeUTxXyW3rtF6gkGBfxcguLWuA1Cns7IsA6xg2Ug&oe=6AF1FE1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Asteroid Tag", "keywords": [], "long_description": "Asteroid Tag is a fast-paced VR tag experience built around physical movement, exploration, and immersive multiplayer gameplay.\n\nEnter a stylized forest hidden within a massive cavern, filled with towering trees, platforms, ropes, and paths to explore. Use your arms and physical movement to navigate the environment, climb through the map, chase other players, or make a quick escape when you're being tagged.\n\nThe environment is designed to make movement a major part of the gameplay. Find your own routes through the forest, use the terrain to your advantage, and stay mobile as you try to catch your opponents or avoid getting caught.\n\nWhether you're chasing, escaping, climbing, or exploring, Asteroid Tag offers an active VR experience where every movement matters.\n\nExplore the forest. Master the movement. Don't get tagged.", "short_description": "A fast-paced VR tag game where you use physical movement to explore a stylized forest, climb, chase, and escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1YPrDqOVQPG24-1JeB5RdNXp-6J4XqPvTjL2IubnZnbc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "ItsAsteroid",
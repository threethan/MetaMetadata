, {"file_name": "image.png", "id": "1124282573465082", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823259_1124282580131748_3869177729870158407_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_j4k9BBcfIwQ7kNvwEZ6GAK&_nc_oc=AdpUd_mrmadAZbIEQo2FZgV7CaOQsdCKXF5FyciBqdy3PEYQ2gmi2lj6K16VwdLuedI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCp4_aPa8lDkP0ZUYdCT7hTfrmF_uLfWlsHmFj9q1RRQ&oe=6B09AFC6"}, {"file_name": "image.png", "id": "2141215726499619", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823310_2141215729832952_8273553959388643869_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUvFV42ZP-UQ7kNvwGMDNCX&_nc_oc=Adrp4MI7z7XqLfeCnilc_fMuY0u5H5e9wF6QO9VlK3Iok48pw7TTDtAsW8GDtQe32vU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgcbZP_gnwB0Z5ETTKFW6_v83zVsF9UJQnxNR_zqhpHA&oe=6B09B91B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Asteroid Tag", "keywords": [], "long_description": "Asteroid Tag is a fast-paced VR tag experience built around physical movement, exploration, and immersive multiplayer gameplay.\n\nEnter a stylized forest hidden within a massive cavern, filled with towering trees, platforms, ropes, and paths to explore. Use your arms and physical movement to navigate the environment, climb through the map, chase other players, or make a quick escape when you're being tagged.\n\nThe environment is designed to make movement a major part of the gameplay. Find your own routes through the forest, use the terrain to your advantage, and stay mobile as you try to catch your opponents or avoid getting caught.\n\nWhether you're chasing, escaping, climbing, or exploring, Asteroid Tag offers an active VR experience where every movement matters.\n\nExplore the forest. Master the movement. Don't get tagged.", "short_description": "A fast-paced VR tag game where you use physical movement to explore a stylized forest, climb, chase, and escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1YPrDqOVQPG24-1JeB5RdNXp-6J4XqPvTjL2IubnZnbc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "ItsAsteroid", "support_website_url": null, "website_url": "https://docs.google.com/document/d/156FfBR4UxbdIBesrzQC5VY6gbk4iBLGQ2lMDyciP3q0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1343436198855020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/596068480_4575957359344817_6331645090167491163_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRK86KooYyIQ7kNvwF9ReVc&_nc_oc=Ado8Atr-DZoUod5Ts23TADHjBLaZjRZ2xP8LBBuFkQK85y_ETa7JbGBkR-Lyo7vtpOk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEUI_2LYUMezo0QmLLTL_pfQPP11nVKydSdIekXAU5Fw&oe=6B09B9F0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Asteroid Tag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1791315900, "lastRevision": {"nodes": [{"id": "1280413521823955", "relea
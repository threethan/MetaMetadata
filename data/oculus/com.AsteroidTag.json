_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNsOA4OF1soQ7kNvwE1vKJU&_nc_oc=AdrS-A7IT6wl94eLf-q_y1yAV0PW5ZXLK1o9FH5Xz_m3OHnrt3Byjn4mVK5YhcUiMKY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTndxjIwbDqj971EYL0VA021Bl6yd6ZsFZSl3Z8c26_qQ&oe=6B09B76C"}, {"file_name": "image.png", "id": "1124282573465082", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823259_1124282580131748_3869177729870158407_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_j4k9BBcfIwQ7kNvwEZ6GAK&_nc_oc=AdpUd_mrmadAZbIEQo2FZgV7CaOQsdCKXF5FyciBqdy3PEYQ2gmi2lj6K16VwdLuedI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCp4_aPa8lDkP0ZUYdCT7hTfrmF_uLfWlsHmFj9q1RRQ&oe=6B09AFC6"}, {"file_name": "image.png", "id": "2141215726499619", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823310_2141215729832952_8273553959388643869_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUvFV42ZP-UQ7kNvwGMDNCX&_nc_oc=Adrp4MI7z7XqLfeCnilc_fMuY0u5H5e9wF6QO9VlK3Iok48pw7TTDtAsW8GDtQe32vU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgcbZP_gnwB0Z5ETTKFW6_v83zVsF9UJQnxNR_zqhpHA&oe=6B09B91B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Asteroid Tag", "keywords": [], "long_description": "Asteroid Tag is a fast-paced VR tag experience built around physical movement, exploration, and immersive multiplayer gameplay.\n\nEnter a stylized forest hidden within a massive cavern, filled with towering trees, platforms, ropes, and paths to explore. Use your arms and physical movement to navigate the environment, climb through the map, chase other players, or make a quick escape when you're being tagged.\n\nThe environment is designed to make movement a major part of the gameplay. Find your own routes through the forest, use the terrain to your advantage, and stay mobile as you try to catch your opponents or avoid getting caught.\n\nWhether you're chasing, escaping, climbing, or exploring, Asteroid Tag offers an active VR experience where every movement matters.\n\nExplore the forest. Master the movement. Don't get tagged.", "short_description": "A fast-paced VR tag game where you use physical movement to explore a stylized forest, climb, chase, and escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1YPrDqOVQPG24-1JeB5RdNXp-6J4XqPvTjL2IubnZnbc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "ItsAsteroid", "support_website_url": null, "website_url": "https://docs.google.com/document/d/156FfBR4UxbdIBesrzQC5VY6gbk4iBLGQ2lMDyciP3q0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1343436198855020"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1343439882187985", "version": "AsteroidsFangame"}, "id": "1928011031489419", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1280413498490624", "is_concept": false, "latest_re
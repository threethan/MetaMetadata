hc=As81nZefhowQ7kNvwEb0opi&_nc_oc=AdoTrpA5KFeIun9KsSXk0Q86ChmcrktvJ3SeCciw8wbEGeujhzIVk-cUAnRfj6rKN_k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvgXy4WUdbHTYLo7QYYjDsdxKgEWhmXj7toRDexmHiBA&oe=6AF88C46"}, {"file_name": "image.png", "id": "2141215726499619", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823310_2141215729832952_8273553959388643869_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tp_lZP5eIH0Q7kNvwFlb60H&_nc_oc=AdoxbJoDlngMXzFY_BYL6aHBnBXX3bhjgnPUpSgP0Uk01LmRGhJr8WK8CH1OgA8M5Po&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmIgV8BtBvYWzbQTynG3-nGfSZ4A-uzTa5YkZnNkAp5Q&oe=6AF8959B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Asteroid Tag", "keywords": [], "long_description": "Asteroid Tag is a fast-paced VR tag experience built around physical movement, exploration, and immersive multiplayer gameplay.\n\nEnter a stylized forest hidden within a massive cavern, filled with towering trees, platforms, ropes, and paths to explore. Use your arms and physical movement to navigate the environment, climb through the map, chase other players, or make a quick escape when you're being tagged.\n\nThe environment is designed to make movement a major part of the gameplay. Find your own routes through the forest, use the terrain to your advantage, and stay mobile as you try to catch your opponents or avoid getting caught.\n\nWhether you're chasing, escaping, climbing, or exploring, Asteroid Tag offers an active VR experience where every movement matters.\n\nExplore the forest. Master the movement. Don't get tagged.", "short_description": "A fast-paced VR tag game where you use physical movement to explore a stylized forest, climb, chase, and escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1YPrDqOVQPG24-1JeB5RdNXp-6J4XqPvTjL2IubnZnbc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "ItsAsteroid",
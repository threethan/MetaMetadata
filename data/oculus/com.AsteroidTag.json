, {"file_name": "image.png", "id": "1124282573465082", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_1124282580131748_3869177729870158407_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzzQKdEXYg0Q7kNvwELP_wC&_nc_oc=AdpU_4dTMbCEKNacbDZm-G3tuuktlDKcw2aT_euvnc9pqMTFUCTB_tHkZOPAfmAjHJg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdHfALwO_9WlemygkFwD5MohdUP2cNkto9s3ROkeSniw&oe=6B05BB46"}, {"file_name": "image.png", "id": "2141215726499619", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_2141215729832952_8273553959388643869_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XXb643acegQ7kNvwFD2lh9&_nc_oc=Adp6bYlH_49D1796HXeY5k2a7-9WfZ2XK1vCBghbM8DMXntoeEEzT1bPPm5DgWl0YBs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQP4OOmqk0JhRDdRRv73VGsudd6EeH1y-5Erm6312lipQ&oe=6B05C49B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Asteroid Tag", "keywords": [], "long_description": "Asteroid Tag is a fast-paced VR tag experience built around physical movement, exploration, and immersive multiplayer gameplay.\n\nEnter a stylized forest hidden within a massive cavern, filled with towering trees, platforms, ropes, and paths to explore. Use your arms and physical movement to navigate the environment, climb through the map, chase other players, or make a quick escape when you're being tagged.\n\nThe environment is designed to make movement a major part of the gameplay. Find your own routes through the forest, use the terrain to your advantage, and stay mobile as you try to catch your opponents or avoid getting caught.\n\nWhether you're chasing, escaping, climbing, or exploring, Asteroid Tag offers an active VR experience where every movement matters.\n\nExplore the forest. Master the movement. Don't get tagged.", "short_description": "A fast-paced VR tag game where you use physical movement to explore a stylized forest, climb, chase, and escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1YPrDqOVQPG24-1JeB5RdNXp-6J4XqPvTjL2IubnZnbc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "ItsAsteroid", "support_website_url": null, "website_url": "https://docs.google.com/document/d/156FfBR4UxbdIBesrzQC5VY6gbk4iBLGQ2lMDyciP3q0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1343436198855020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596068480_4575957359344817_6331645090167491163_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BakP8LQmmu0Q7kNvwHZijas&_nc_oc=AdoY13hf5TQ1fZty6mTjpNlM5Q_7mTyNRhxC9s6WrwnADH_93BUy_XwnNrXD_aJNBLQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSB-gYCiW0ybTXtOK6T6ICcLiVAD2TZt-WZftjSy25dg&oe=6B05C570"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Asteroid Tag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1791315900, "lastRevision": {"nodes": [{"id": "1280413521823955", "relea
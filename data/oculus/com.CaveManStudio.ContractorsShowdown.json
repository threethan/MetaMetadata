_nc_ohc=cfc4bjqLhgAQ7kNvwHNpRki&_nc_oc=Adni53PKgdkXRCtSQSNuB8TXx-dMUaFVDj-my7-T-xHWWyII29VcMK5PIYze9itbrs4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxnTJ4S86p4pV6PqlYOaEj6HeuI43MwV83Y6D15lkyAQ&oe=69BFFB5F"}, {"file_name": "mag palming-min.png", "id": "548910874939803", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822020_548910881606469_4543421072975301063_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zg6ktpZRkQsQ7kNvwF3eJuQ&_nc_oc=Adm29VpI5avqc7BYWz3EIS6Bay46K3EMTzp1R8KabRxW1bRL73lrM8NzcVIZL8R1Y78&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxw4MZFiy4RqzMKqThL8LpRX85iVk_aa70oDhHR2o-niA&oe=69BFD77D"}, {"file_name": "map6.png", "id": "1343088460776712", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830589_1343088464110045_1020003823517565749_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXulRyMCcUoQ7kNvwFwItFN&_nc_oc=AdkVMZRCaX1jul1lqnAHK0Vy4xtB4q71EvQjZoFcALsjw9xb9k8ZhaJrOo6weN5up8s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyVqpEi05ueWqrRQKeL8Usw5G7o0pfadP5gUDDfPQepsg&oe=69BFDB17"}, {"file_name": "Screenshot 02.png", "id": "1592369061424075", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_1592369064757408_654873570675317287_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaaoSH2K0MAQ7kNvwEzbz3m&_nc_oc=AdkhgcmvYXNJ_HlqiS_q6OOw3hb_EyKPL4rNeC1IeS0PEis1XVcul-j6EtIZ5F_7WnY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzx7UmlqhIqEcUgcygG9Rvr7u3_bEg6fnVt2l4o2v1akQ&oe=69BFD9FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape-2560x1440.png", "id": "833521022649493", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293803_833521025982826_889596602607421970_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrK_Ryg_Y3IQ7kNvwEqvWtT&_nc_oc=AdlZL9RkwD7Tq0VnBxCh6Uez2r1tX2fetvGZZgR_B62EjduFb1zFCBPs4X5Psu7v6aE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx04iuTJJ7fYQqGcrqZIDng14c1U-mlmd_xjjDLRkhJLA&oe=69BFD25B"}, "display_name": "Contractors Showdown : ExfilZone", "keywords": ["FPS", "extraction", "shooter", "action", "tarkov"], "long_description": "Enter **ExfilZone**, the immersive extraction-based game mode in Contractors Showdown, where every decision could mean life or death. ExfilZone introduces a deep progression system intertwined with dynamic missions, challenging you to survive, complete objectives, and extract with your hard-earned loot.\n{1348640809526448}\n\nCraft your ultimate loadout with the one and only VR **Gunsmith System**, featuring over **50** weapons and **thousands** of combinations. Customize attachments, tweak components, and design unique color schemes to dominate with style.\n{2224795561280421}\n\nTake on missions from unique vendors, ranging from elimination contracts and reconnaissance tasks to planting trackers and resource gathering. Completing these missions builds loyalty with vendors, unlocking new weapons, gear, and upgrades to expand your arsenal. \n{1856892261707045}\n\nSurvival is not just about firepower. Master health system, manage limb damage, bleed and scavenged medical supplies. Keep your stamina up by staying hydrated and fueled as you fight through intense raids.\n{630541546618689}\n\nChoose from five diverse maps\u2014Suburbs, Metro, Dam, Resort, and Smuggler\u2019s Tunnel\u2014each offering unique environments and tactical challenges. From urban sprawls to tight tunnels, every raid tests your strategy in the best VR extraction game. \n{1842428576612333}\n\nJoin our community to share gun builds, find squadmates, and stay updated **[Discord.gg/contractorsshowdown]**\n", "short_description": "Dive into ExfilZone, the ultimate VR extraction shooter! Craft unique weapons with the Gunsmith system, conquer dynamic missions, and survive intense PvPvE raids. Manage health, stamina, and loot on revamped maps. Outsmart rivals, extract alive, and dominate in the best VR extraction game!"}]}, "developer_n
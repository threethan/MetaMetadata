s": [{"channel_name": "LIVE", "id": "247209914665124"}]}, "change_log": "v.1.6.7.0\n\nFixed a bullet duplication issue.\nFixed an issue where selling certain quest items caused HQ to restart.\nOptimized the mechanism for item spawning.\nAdded a merchant exchange option for the cellar key.\nTweaked 12GA EXPRESS BUCKSHOT ammo: reduced flesh damage from 35 to 25.\nAdjusted the prices of certain ammo types appropriately.", "created_date": 1780036887, "id": "25339595665738369", "version": "1.0", "version_code": 309, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "25339578149073454"}, "asset_files": {"count": 5}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4963431797114722", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25407888485575753"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "247209914665124"}]}, "change_log": "v.1.6.6.0\nAttempted to fix a duplication issue.", "created_date": 1779256362, "id": "25236280656069871", "version": "1.0", "version_code": 308, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "25236263132738290"}, "asset_files": {"count": 5}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4963431797114722", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25407888485575753"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "247209914665124"}]}, "change_log": "v1.6.5.0\nOptimized game performance for PvE solo mode.\nFixed an issue that could cause crashes in HQ.\nFixed an issue that allowed players to pass through walls.\nFixed an issue where bots could spawn inside walls.\nFixed an issue where players could get onto the top of the dam.\nAttempted to fix an issue where extraction would not occur after the extraction timer reached zero.\nImproved the Kiosk temporary storage box; storage duration has been adjusted to 24 hours.\nImproved the descriptions of some tasks.\nFixed an issue where hunger and thirst values in HQ were not updating in real time.\nFixed an issue where loaded Sjogren magazines would disappear after entering a match.\nFixed an issue where some task items had incorrect materials after switching to LOD.\nFixed an issue where the number of hideout renovations exceeded the total count.\nFixed texture/model issues with the Tbeast CB Cover suppressor.\nFixed collision issues with some miscellaneous items.\nFixed an issue where the flare gun\u2019s collision size was too large.\nFixed some UI overlap issues.\nFixed an issue where, when using controller forward movement, the controller offset did not affect movement direction detection.", "created_date": 1778839507, "id": "25175895432108394", "version": "1.0", "version_code": 307, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "25175883828776221"}, "asset_files": {"count": 5}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
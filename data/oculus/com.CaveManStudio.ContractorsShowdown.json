20799144", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_775155924132477_2564008038609215012_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOqFLjaTU3YQ7kNvwESteib&_nc_oc=AdpzGuvf-4yU6UrwjZ9g4f6JSs1CYlQYmo3vRfdu38oXn76JvVFgrb3UnnJiO3Y3oLg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTVxkAE9wWKRwoTLoKfYHZWJJjyA8vGzS2vNSd4sn9Vg&oe=6AE74077"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image 2560x1440.png", "id": "312906721803281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75500286_312906725136614_1043827207362831468_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUIilWzN-NQQ7kNvwFuf-g3&_nc_oc=AdqTETyT8M5PjLCjLmp539BPARPlY1pU4lYBw_w5rzgr5vylxQVjJQ5VIcBV9jkuu2M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRStgHVLqgu7Ycz9MOKzgMbU9K0FJcGfHP6FlaVyQLIgw&oe=6AE7672B"}, "display_name": "Contractors Showdown", "keywords": ["BR", "FPS", "BattleRoyale", "military", "simulation"], "long_description": "Contractors Showdown delivers an immersive military-styled VR First-Person Shooter experience. Engage in heart-pounding combat as you, along with 59 other players, navigate a vast and detailed 16 square-kilometer map. The game centers around a thrilling Battle Royale game mode, where strategic prowess and combat skills are paramount.  Gear up for intense battles, dynamic team play, and a visually stunning VR environment that thrusts players into the forefront of military actions.", "short_description": "Contractors Showdown delivers an immersive military-styled VR First-Person Shooter experience that centers around a thrilling Battle Royale game mode, where strategic prowess and combat skills are paramount."}]}, "developer_name": "Caveman Game Studio", "developer_privacy_policy_url": "https://www.contractorsvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Caveman Game Studio", "support_website_url": null, "website_url": "https://www.contractorsvr.com/showdown", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6538872382842726"}}]}, "scheduled_offers": {"count": 21, "nodes": [{"status": "PUBLISHED", "id": "1372692061051293"}, {"status": "PUBLISHED", "id": "1836713487738818"}, {"status": "PUBLISHED", "id": "1733646394308047"}, {"status": "PUBLISHED", "id": "978014831780189"}, {"status": "PUBLISHED", "id": "1274709194803308"}, {"status": "PUBLISHED", "id": "943725751416866"}, {"status": "PUBLISHED", "id": "1226709408916851"}, {"status": "PUBLISHED", "id": "1382386370330989"}, {"status": "PUBLISHED", "id": "4221462381405312"}, {"status": "PUBLISHED", "id": "811091051777793"}, {"status": "PUBLISHED", "id": "1944789109709285"}, {"status": "PUBLISHED", "id": "1216316046487662"}, {"status": "PUBLISHED", "id": "716644457395647"}, {"status": "PUBLISHED", "id": "1210974660538667"}, {"status": "PUBLISHED", "id": "3829219047339362"}, {"status": "PUBLISHED", "id": "1126811645631402"}, {"status": "PUBLISHED", "id": "479651701542345"}, {"status": "PUBLISHED", "id": "370993626001205"}, {"status": "PUBLISHED", "id": "786336296469980"}, {"status": "PUBLISHED", "id": "2813926372081429"}, {"status": "PUBLISHED", "id": "432775012561146"}]}, "baseline_offer": {"id": "716644457395647"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "1372692061051293"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27116766368021281", "version": "1.7.2.0"}, "id": "247209914665124", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4963431797114722", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27116766368021281"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "247209914665124"}]}, "change_log": "v1.7.2.0\n\nBug Fixes\n\nFixed an item duplication exploit involving safe container.\nFixed an exploit that allowed players to clip through walls using the phone.\nFixed a bug in the helmet hearing system.\n\nBalance Adjustments\n\nReduced the armor damage gap between most low-penetration and high-penetration rounds, increasing the armor damage dealt by most ammunition when it fails to penetrate.\nReduced the base penetration values of the following rounds to slightly improve survivability when wearing high-tier armor against high-penetration ammunition:\n.338 LM AP: 7.7 \u2192 6.7\n7.62x54R BS: 7.0 \u2192 6.4\n7.62x54R SNB: 6.1 \u2192 5.9\n7.62x51mm M993: 6.5 \u2192 6.0\n7.62x51mm M61: 6.0 \u2192 5.6\n5.45x39mm 7N39: 6.2 \u2192 5.8\n5.56x45mm AP: 5.8 \u2192 5.7\nReduced the base flesh damage of .338 LM rounds:\n.338 LM VT-X: 196 \u2192 166\n.338 LM UPS: 142 \u2192 128\n.338 LM FMJ: 122 \u2192 110\n.338 LM AP: 115 \u2192 95", "created_date": 1792734877, "id": "27116766368021281", "version": "1.7.2.0", "version_code": 336, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27116759368021981"}, "asset_files": {"count": 24}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4963431797114722", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27116766368021281"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "247209914665124"}]}, "change_log": "v.1.7.1.0\nAnti-Cheat\nImplemented additional anti-cheat measures to improve fair play.\nBug Fixes & Improvements\nFixed an exploit that allowed players to generate money using medical kits.\nFixed an issue causing map assets and character models to appear completely black.\nAdjusted post-processing settings for PC maps.\nFixed an issue where flashbang were not functioning on Quest standalone.\nFixed abnormal sound effects when using the Armor Repair Gun.\nFixed an issue preventing the Mosin from being loaded.\nFixed an issue where the Miscellaneous Storage Box failed to display or properly categorize items.\nFixed an issue where ammunition loaded into the RSH-12's cylinder would not carry over into raids.", "created_date": 1792141206, "id": "27025800057117913", "version": "1.7.1.0", "version_code": 335, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27025797153784870"}, "asset_files": {"count": 24}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4963431797114722", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27116766368021281"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "247209914665124"}]}, "change_log": "v1.7.0.3\n- Fixed an issue where switching modes could cause data errors and incorrect trader levels.\n- Fixed HQ buffs not applying during raids.\n- Fixed some weapon spray not displaying correctly after entering a raid.\n- Fixed an issue where the AUG could spawn an extra magazine in certain situations.\n- Fixed some high-magnification scopes being unable to flip or adjust zoom.\n- Fixed the damage effect incorrectly appearing when hunger dropped below 50%.\n- Fixed the Armor Repair Gun incorrectly having a sell price of 0.\n- Adjusted the trader level required to purchase the ASH-12 in PvP mode.\n- Improved when panting and grunting sounds trigger while picking up items over the weight limit.\n- Fixed bow quivers disappearing on the ground in BR mode.", "created_date": 1791622790, "id": "26943379218693331", "version": "1.0", "version_code": 334, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26943375682027018"}, "asset_files": {"count": 24}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4963431797114722", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27116766368021281"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "247209914665124"}]}, "change_log": "Release333 - game version 1.7.0.2\nThis update improves weapon attachments, gunsmith support, and Hideout saving.\n\nFixed issues that prevented the G33, Vertex, and Mark3 optics from working correctly.\nRestored the NightHawk scope's magnification adjustment settings.\nAdded missing gunsmith assembly support for the SESA2 and MX338.\nRestored missing drop sounds for some magazines, along with paint customization for some attachments and magazines.\nFixed rounds clipping through ASH-12 magazines.\nAdjusted grab detection on some syringes to improve handling.\nFixed an issue where an earlier Hideout save could incorrectly complete a later save request during consecutive actions.\nImproved saving before leaving the Hideout or starting matchmaking by waiting for the corresponding save request. While connected, a failed exit save now prevents the game from quitting immediately.", "created_date": 1790612175, "id": "26795815150116406", "version": "1.0", "version_code": 333, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26795811463450108"}, "asset_files": {"count": 36}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4963431797114722", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27116766368021281"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "247209914665124"}]}, "change_log": "Release332 - game version 1.7.0.1\n\nPatch 1.7.0.1 / Release 332\n\nFixed missing inventory ledger entries after successful barter exchanges.\nFixed incorrect item counts during expired-item returns and the resulting HQ reload loops.\nFixed inconsistent M1897 ammunition counts between storage and Gunsmith caches.\nAdded protection against missing Scav/AI body meshes, including a fallback model.\nFixed incorrect localization of task objectives such as \u201cFind the Missing Scholar.\u201d\nFixed an issue allowing the entire ASH-12 to be placed in magazine pouches.\nAdded the missing sidearm holster compatibility tag to the GP100.\nAdded Scav/PMC task isolation logic", "created_date": 1790348930, "id": "26761673876863867", "version": "1.0", "version_code": 332, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26761616950202893"}, "asset_files": {"count": 36}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0vkL6yR958Q7kNvwG405aB&_nc_oc=AdqXWjeOy8SsqjQN_WsaqzCQZT6kgjZj1UNTofYqCRSPX4DWzelobsM6DOBmCjXfg70&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PoLVM0oDsSSRMEQpzgR3lgjxKhXgp3MfQzFq47TH1hQ&oe=69D2705F"}, {"file_name": "mag palming-min.png", "id": "548910874939803", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822020_548910881606469_4543421072975301063_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9V_GJyFv_0cQ7kNvwEg1dJY&_nc_oc=AdqbQkEC2ELBkVVDTTfFH5-QoDJGdU0oXkSyBWGTjmETjvI6hwn5pQnqtiBwD-p6ngk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zftpiC2e297-9wNKJJfJbpXAGfoXQk8T9Zv00Lt-CZA&oe=69D24C7D"}, {"file_name": "map6.png", "id": "1343088460776712", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830589_1343088464110045_1020003823517565749_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nAlDeiKK0kQ7kNvwEt01Yl&_nc_oc=AdqqMlbuySOdBdNvrt4oEpSs7S4aUV12YWw0P57yuETN8jwSnwdzIjdf1gcKZLFh7q8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0U6EsWf75QtT7jBPreXTsBpUvepN-LP7Om4MjSwzwLug&oe=69D25017"}, {"file_name": "Screenshot 02.png", "id": "1592369061424075", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974821_1592369064757408_654873570675317287_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQhDrl3qywAQ7kNvwHg007b&_nc_oc=AdqMkB0HBssFQwIjjHg0kvHQOTSTDLu2ImsXHDgB7Hspzf99DZNgIHhVMJdOvWKUErE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EdhEKLYbWQM_EO3aNkNZAjYOYKRGKykF2dvI5vZg1-g&oe=69D24EFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape-2560x1440.png", "id": "833521022649493", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499293803_833521025982826_889596602607421970_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klJjyvhaRX0Q7kNvwHecVfV&_nc_oc=AdoOyOMCpedKBXbLKvK5FD73cJfENfhht48AXNTiztTvk0p2Euy15UsI7iIJKikgN2c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JQfpQzmNIWdcIIQcBtg75a4Axw-qPJAPZ1nxgA0gUNQ&oe=69D2475B"}, "display_name": "Contractors Showdown : ExfilZone", "keywords": ["FPS", "extraction", "shooter", "action", "tarkov"], "long_description": "Enter **ExfilZone**, the immersive extraction-based game mode in Contractors Showdown, where every decision could mean life or death. ExfilZone introduces a deep progression system intertwined with dynamic missions, challenging you to survive, complete objectives, and extract with your hard-earned loot.\n{1348640809526448}\n\nCraft your ultimate loadout with the one and only VR **Gunsmith System**, featuring over **50** weapons and **thousands** of combinations. Customize attachments, tweak components, and design unique color schemes to dominate with style.\n{2224795561280421}\n\nTake on missions from unique vendors, ranging from elimination contracts and reconnaissance tasks to planting trackers and resource gathering. Completing these missions builds loyalty with vendors, unlocking new weapons, gear, and upgrades to expand your arsenal. \n{1856892261707045}\n\nSurvival is not just about firepower. Master health system, manage limb damage, bleed and scavenged medical supplies. Keep your stamina up by staying hydrated and fueled as you fight through intense raids.\n{630541546618689}\n\nChoose from five diverse maps\u2014Suburbs, Metro, Dam, Resort, and Smuggler\u2019s Tunnel\u2014each offering unique environments and tactical challenges. From urban sprawls to tight tunnels, every raid tests your strategy in the best VR extraction game. \n{1842428576612333}\n\nJoin our community to share gun builds, find squadmates, and stay updated **[Discord.gg/contractorsshowdown]**\n", "short_description": "Dive into ExfilZone, the ultimate VR extraction shooter! Craft unique weapons with the Gunsmith system, conquer dynamic missions, and survive intense PvPvE raids. Manage health, stamina, and loot on revamped maps. Outsmart rivals, extract alive, and dominate in the best VR extraction game!"}]}, "developer_name": "Caveman Game Studio", "developer_privacy_policy_url": "https://www.contractorsvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Caveman Game Studio", "support_website_url": "https://www.contractorsvr.com/contact", "website_url": "https://www.contractorsvr.com/showdown", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "fr", "de", "ko", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "10023216021136249"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303790_2396219460807369_5170208059357654377_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YF77t7SBPmsQ7kNvwFIfGKM&_nc_oc=Adqi8O9pr6Iwm-Y_GxpZmgxjvNaRidOaWeO4xEOKyzvhp_qq6hf2p7OxwyawyiH0ECE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oYg6C6SGW59ZnHq2zMuUDJVZyS_b4Zqj_ZbzLo82r8A&oe=69D247FF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Contractors Showdown : ExfilZone", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulati
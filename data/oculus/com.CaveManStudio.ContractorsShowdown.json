c_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wd_FKRzlkJkQ7kNvwGu6hun&_nc_oc=AdpdIZICd3_oTwnElvI0gjNoW2nN-ww5Iz0evAYHB8HRaCThYI88VT65BgH94IRRWio&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvkfzyL4mI-Z0rwMA77HTmDJq3-bF7_hm7fBWVFRgFVw&oe=6A95C69F"}, {"file_name": "mag palming-min.png", "id": "548910874939803", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822020_548910881606469_4543421072975301063_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2tZz_-mlc0Q7kNvwGcLKxp&_nc_oc=AdpoFeBvCtBz0NiJ4eJwVdGCwYEZ5WWwqcA9cr_Sxi7M81pYSYLDo1ujUAZVReaN8OM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlGlwXSqee-yMyx5oQpMTBXHiqzEdTQJXt84AaAPHrUA&oe=6A95DAFD"}, {"file_name": "map6.png", "id": "1343088460776712", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830589_1343088464110045_1020003823517565749_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnZSFo-ekFMQ7kNvwHAi2oR&_nc_oc=AdriIKn1rT0slau55XG8q3uP37nqUSAdvcdNjT_mq6XRfBNbGwvpyx1tdMgArmrKLGQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiF8gHSjlD4Q3eLtVvLjFhW_BXzPNk17cn0dIAq6q8KQ&oe=6A95DE97"}, {"file_name": "Screenshot 02.png", "id": "1592369061424075", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_1592369064757408_654873570675317287_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDf2_hq4LjAQ7kNvwHncWOj&_nc_oc=AdoCTo1zIzXkjT0iDJn--xA0vTGjGyf1CuB6BvpA0h5iNSsotDKO1PNBn-v7fi3TMN4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5BP-OLBfb3ji1h0doxX1hHvTUS5SsOMS6U-payEZQ8w&oe=6A95DD7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape 2560x1440.png", "id": "1272484114988525", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304938_1272484118321858_3139422607404480248_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWxpb7lUh8AQ7kNvwEuNLcR&_nc_oc=AdogbgVPjvlkxpRHTX0rex0M57moqbkT5_zLY-ozjK2T5a-XjYTxJh1s5BOEh78vIhA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIegAOVW7eald2h4Dj0MSv2Q9lLFQzdfJ5_nsnwMsWqw&oe=6A95BA1B"}, "display_name": "Contractors Showdown : ExfilZone", "keywords": ["FPS", "extraction", "shooter", "action", "tarkov"], "long_description": "Enter **ExfilZone**, the immersive extraction-based game mode in Contractors Showdown, where every decision could mean life or death. ExfilZone introduces a deep progression system intertwined with dynamic missions, challenging you to survive, complete objectives, and extract with your hard-earned loot.\n{1348640809526448}\n\nIntroducing PvE Mode \u2014 a new, more approachable way to enter ExfilZone with scalable challenge and high-stakes combat.\n\nCraft your ultimate loadout with the one and only VR **Gunsmith System**, featuring over **50** weapons and **thousands** of combinations. Customize attachments, tweak components, and design unique color schemes to dominate with style.\n{2224795561280421}\n\nTake on missions from unique vendors, ranging from elimination contracts and reconnaissance tasks to planting trackers and resource gathering. Completing these missions builds loyalty with vendors, unlocking new weapons, gear, and upgrades to expand your arsenal. \n{1856892261707045}\n\nSurvival is not just about firepower. Master health system, manage limb damage, bleed and scavenged medical supplies. Keep your stamina up by staying hydrated and fueled as you fight through intense raids.\n{630541546618689}\n\nChoose from five diverse maps\u2014Suburbs, Metro, Dam, Resort, and Smuggler\u2019s Tunnel\u2014each offering unique environments and tactical challenges. From urban sprawls to tight tunnels, every raid tests your strategy in the best VR extraction game. \n{1842428576612333}\n\nJoin our community to share gun builds, find squadmates, and stay updated **[Discord.gg/contractorsshowdown]**\n", "short_description": "Contractors Showdown delivers intense VR extraction combat in ExfilZone, now featuring PvE Mode alongside high-stakes PvPvE action. Customize your loadout, complete missions, loot, survive, and fight your way through immersive tactical battles."}]}, "developer_name": "Caveman Game Studio", "developer_privacy_policy_url": "https://www.contractorsvr.com/privacy", "developer_terms_of_service_url": "https://www.contractorsvr.com/termsofserviceeng", "publisher_name": "Caveman Game Studio", "support_website_url": "https://www.contractorsvr.com/contact", "website_url": "https://www.contractorsvr.com/showdown", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "fr", "de", "ko", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25094613190236619"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295547_4776399792587314_9086743427761001870_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bm-sQOOSjW8Q7kNvwFXpLO9&_nc_oc=AdpfDWVfhqOxFTtEGo-g0wp3d-uy2o-1sBCMiMB26DIFjN2CkC_P4l935smA8UJdoAI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0JUN16-JTo8uiKZ4z7VxBXXJBpCJJR3Nh4fprA0EJTw&oe=6A95D305"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Contractors Showdown : ExfilZone", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics":
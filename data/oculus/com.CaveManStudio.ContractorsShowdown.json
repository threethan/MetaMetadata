c_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYKnInsuD-kQ7kNvwFcOhDB&_nc_oc=AdoGJlgyy6CI3SmaRu8qDYQTP7K9Y3uXMdpLO2-UkVuqVhB71DhOU4QwyBeRnIX6JeM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-rytBFteK8-TcM7EE2UIN_dFEMooaO9FzAIjx8WJXcg&oe=6A1066DF"}, {"file_name": "mag palming-min.png", "id": "548910874939803", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491822020_548910881606469_4543421072975301063_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTSvdAMg5yoQ7kNvwGWaZfy&_nc_oc=AdrIYaykAa3_K9Edp91xCKNI90BVXkYCn6-QeijB0cZ_aPJK1PaR-Ro8_xdR2q-28A0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uG_K6HR5yAy8J1mQItRYsXMsODxQ9_bdh3SAPezOV3A&oe=6A107B3D"}, {"file_name": "map6.png", "id": "1343088460776712", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491830589_1343088464110045_1020003823517565749_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eukGAohF3-4Q7kNvwGeGqRO&_nc_oc=AdqZJMyeTzcjNlorwoZLesZ8WvUUgwMhrxN_h44nC6mpovMLX3OezJX7sbD0Ym5IIXM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Aanmfr9suJoCgx57wL2rgTxbVpvyUnMDt5TIVsRkceA&oe=6A107ED7"}, {"file_name": "Screenshot 02.png", "id": "1592369061424075", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974821_1592369064757408_654873570675317287_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2b6GUGnI7hYQ7kNvwHQ6yXD&_nc_oc=AdoILcODUevoRUAOl98xCLWGt0fudmL3bTSrtI4wJatLMtxL5scnvYxMZUFm7mwNZMc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-7C5byrweY_rMVJ_q6EX2gy4HOsoJpJ2BjCLKdLo27g&oe=6A107DBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape 2560x1440.png", "id": "1272484114988525", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499304938_1272484118321858_3139422607404480248_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYI7HkxzP1wQ7kNvwERBfHj&_nc_oc=Adq-Rd30-1RmzqZFzp6F9HYFUSURbPE9Gf03ZOccg0pOgRQnOQ9NdnV8yAxk35zqOtw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6n96xZ3U40nEpadCBuB0r5rzgjCF3iV8OeooUH8H03tw&oe=6A105A5B"}, "display_name": "Contractors Showdown : ExfilZone", "keywords": ["FPS", "extraction", "shooter", "action", "tarkov"], "long_description": "Enter **ExfilZone**, the immersive extraction-based game mode in Contractors Showdown, where every decision could mean life or death. ExfilZone introduces a deep progression system intertwined with dynamic missions, challenging you to survive, complete objectives, and extract with your hard-earned loot.\n{1348640809526448}\n\nIntroducing PvE Mode \u2014 a new, more approachable way to enter ExfilZone with scalable challenge and high-stakes combat.\n\nCraft your ultimate loadout with the one and only VR **Gunsmith System**, featuring over **50** weapons and **thousands** of combinations. Customize attachments, tweak components, and design unique color schemes to dominate with style.\n{2224795561280421}\n\nTake on missions from unique vendors, ranging from elimination contracts and reconnaissance tasks to planting trackers and resource gathering. Completing these missions builds loyalty with vendors, unlocking new weapons, gear, and upgrades to expand your arsenal. \n{1856892261707045}\n\nSurvival is not just about firepower. Master health system, manage limb damage, bleed and scavenged medical supplies. Keep your stamina up by staying hydrated and fueled as you fight through intense raids.\n{630541546618689}\n\nChoose from five diverse maps\u2014Suburbs, Metro, Dam, Resort, and Smuggler\u2019s Tunnel\u2014each offering unique environments and tactical challenges. From urban sprawls to tight tunnels, every raid tests your strategy in the best VR extraction game. \n{1842428576612333}\n\nJoin our community to share gun builds, find squadmates, and stay updated **[Discord.gg/contractorsshowdown]**\n", "short_description": "Contractors Showdown delivers intense VR extraction combat in ExfilZone, now featuring PvE Mode alongside high-stakes PvPvE action. Customize your loadout, complete missions, loot, survive, and fight your way through immersive tactical battles."}]}, "developer_name": "Caveman Game Studio", "developer_privacy_policy_url": "https://www.contractorsvr.com/privacy", "developer_terms_of_service_url": "https://www.contractorsvr.com/termsofserviceeng", "publisher_name": "Caveman Game Studio", "support_website_url": "https://www.contractorsvr.com/contact", "website_url": "https://www.contractorsvr.com/showdown", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "fr", "de", "ko", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25094613190236619"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499295547_4776399792587314_9086743427761001870_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r28pBRFTW4oQ7kNvwFg66Tc&_nc_oc=AdpHt-U-yOkY0V1dllAD0FMkG-qVLovpdk5xA7PKgFRXPvH0D4e6rnopwD6ihnkYWQU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7A0MHtAwGbZYVuB5Y3zCvvz3hNFbfvKh9Q6A5tNKUcOg&oe=6A107345"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Contractors Showdown : ExfilZone", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics":
895432108394", "version": "1.0"}, "id": "247209914665124", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4963431797114722", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25175895432108394"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "247209914665124"}]}, "change_log": "v1.6.5.0\nOptimized game performance for PvE solo mode.\nFixed an issue that could cause crashes in HQ.\nFixed an issue that allowed players to pass through walls.\nFixed an issue where bots could spawn inside walls.\nFixed an issue where players could get onto the top of the dam.\nAttempted to fix an issue where extraction would not occur after the extraction timer reached zero.\nImproved the Kiosk temporary storage box; storage duration has been adjusted to 24 hours.\nImproved the descriptions of some tasks.\nFixed an issue where hunger and thirst values in HQ were not updating in real time.\nFixed an issue where loaded Sjogren magazines would disappear after entering a match.\nFixed an issue where some task items had incorrect materials after switching to LOD.\nFixed an issue where the number of hideout renovations exceeded the total count.\nFixed texture/model issues with the Tbeast CB Cover suppressor.\nFixed collision issues with some miscellaneous items.\nFixed an issue where the flare gun\u2019s collision size was too large.\nFixed some UI overlap issues.\nFixed an issue where, when using controller forward movement, the controller offset did not affect movement direction detection.", "created_date": 1778839507, "id": "25175895432108394", "version": "1.0", "version_code": 307, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "25175883828776221"}, "asset_files": {"count": 5}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4963431797114722", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25175895432108394"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1778833048, "id": "25174897328874871", "version": "1.0", "version_code": 306, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "25174880082209929"}, "asset_files": {"count": 5}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4963431797114722", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25175895432108394"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "247209914665124"}]}, "change_log": "v1.6.4.0\n\nFixed an issue where players could get onto the top of the dam.\nAttempted to fix safety container abnormalities.\nAttempted to fix an issue where purchased items sometimes failed to spawn.\nFixed an issue where the boss optic could be duplicated infinitely.\nFixed an issue where rewards could not be claimed because they exceeded the weight limit.\nFixed an issue where research missions could cause the Hideout to restart.\nFixed an issue where the mission \u201cRecord Left Behind\u201d did not properly generate the required mission item.\nFixed a series of inaccurate mission descriptions.\nFixed an issue where the hand material was incorrect on the new Hand Only model.\nFixed an issue where cash items could not be extracted properly.\nFixed an issue where adding graphics cards could cause abnormal balance changes.\nFixed an issue where masks sometimes failed to block bullets properly.\nFixed an issue where the lounge poster wall was not saved correctly.\nFixed an issue where the character-switching screen incorrectly locked characters.\nAdjusted abnormal collision on some items.\nAdjusted the storage angle of some items inside safes.\nAdjusted the position of the Hideout data panel.\nFixed an issue where some players\u2019 match records were not saved correctly, causing maps to remain locked.", "created_date": 1778247976, "id": "25093150300382908", "version": "1.0", "version_code": 305, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "25093136207050984"}, "asset_files": {"count": 5}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4963431797114722", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25175895432108394"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "247209914665124"}]}, "change_log": "v.1.6.3.1\n1. Fixed head tracking jittering / wobbling for quest\n2. Fixed fall damage reducing health on all body parts", "created_date": 1777386720, "id": "24982719808092625", "version": "1.0", "version_code": 304, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "24982715411426398"}, "asset_files": {"count": 5}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4963431797114722", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25175895432108394"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "
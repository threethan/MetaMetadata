at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Q_XaUdg4vEQ7kNvwEd6CSx&_nc_oc=AdrT4zvgiQ-OfBZJtt1waPNFyaGAMkm0_zZmmI3ooMgV6kmWx604IB1twufQ5U1NWTc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aRfsgSvQjA93WeYNv5UM9WVAW04wkDg2ECNtyKbJSCg&oe=69DF9F5F"}, {"file_name": "mag palming-min.png", "id": "548910874939803", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822020_548910881606469_4543421072975301063_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRqchHaPjy4Q7kNvwELgELk&_nc_oc=AdrkRGCKO3wvW504Fjs-q043PlGtv-T0xH1InEJ5hdzZaIyqhir-LxhrbfIQ13l8wdg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MdNp1_Pe_kjngIzgaGtEBZwBQK9DF4acbXA_lPNt5wA&oe=69DF7B7D"}, {"file_name": "map6.png", "id": "1343088460776712", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830589_1343088464110045_1020003823517565749_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-QAAmNNH6AQ7kNvwH6b6V0&_nc_oc=AdpkKBAi2MHFfQREujHFLStyl3uNYdGTURDjbeV-vqSDzSqvooMuhIzSYca8pUlrWgQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0b1iL5jEWYFRnWLfhb5od_WN9QhzHKSxuBdk7yw-4paQ&oe=69DF7F17"}, {"file_name": "Screenshot 02.png", "id": "1592369061424075", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_1592369064757408_654873570675317287_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nr0MxsdI8QkQ7kNvwHqV65D&_nc_oc=AdrWWV_BRMXhVlqWveFCUGQTrtE353I4EjuieeEW5SmJ24ktAZOdhulyzqKESYxSR3g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wcX40dgqqfiBynb4Vu5ZW1pe6leLoIs8LRAOEkcJnfg&oe=69DF7DFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape-2560x1440.png", "id": "833521022649493", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499293803_833521025982826_889596602607421970_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2rpTKvRcI0Q7kNvwG05Rtk&_nc_oc=Adqpz833pR85X3nidNS9vi5CFdAGLUU1id9hCZ-6kRlyncl9syG5BtFlIHsvmFRCF10&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YMUeLVoGZe0O79E_w26BL9mUjrFIdSqCWJ_2Dj5vnrQ&oe=69DF765B"}, "display_name": "Contractors Showdown : ExfilZone", "keywords": ["FPS", "extraction", "shooter", "action", "tarkov"], "long_description": "Enter **ExfilZone**, the immersive extraction-based game mode in Contractors Showdown, where every decision could mean life or death. ExfilZone introduces a deep progression system intertwined with dynamic missions, challenging you to survive, complete objectives, and extract with your hard-earned loot.\n{1348640809526448}\n\nCraft your ultimate loadout with the one and only VR **Gunsmith System**, featuring over **50** weapons and **thousands** of combinations. Customize attachments, tweak components, and design unique color schemes to dominate with style.\n{2224795561280421}\n\nTake on missions from unique vendors, ranging from elimination contracts and reconnaissance tasks to planting trackers and resource gathering. Completing these missions builds loyalty with vendors, unlocking new weapons, gear, and upgrades to expand your arsenal. \n{1856892261707045}\n\nSurvival is not just about firepower. Master health system, manage limb damage, bleed and scavenged medical supplies. Keep your stamina up by staying hydrated and fueled as you fight through intense raids.\n{630541546618689}\n\nChoose from five diverse maps\u2014Suburbs, Metro, Dam, Resort, and Smuggler\u2019s Tunnel\u2014each offering unique environments and tactical challenges. From urban sprawls to tight tunnels, every raid tests your strategy in the best VR extraction game. \n{1842428576612333}\n\nJoin our community to share gun builds, find squadmates, and stay updated **[Discord.gg/contractorsshowdown]**\n", "short_description": "Dive into ExfilZone, the ultimate VR extraction shooter! Craft unique weapons with the Gunsmith system, conquer dynamic missions, and survive intense PvPvE raids. Manage health, stamina, and loot on revamped maps. Outsmart rivals, extract alive, and dominate in the best VR extraction game!"}]}, "developer_name": "Caveman Game Studio", "developer_privacy_policy_url": "https://www.contractorsvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Caveman Game Studio", "support_website_url": "https://www.contractorsvr.com/contact", "website_url": "https://www.contractorsvr.com/showdown", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "fr", "de", "ko", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "10023216021136249"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303790_2396219460807369_5170208059357654377_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RACEm-v-lr4Q7kNvwEN_IC4&_nc_oc=AdrjlnoFZtp9sviDzdJq6UsT9XaDZg3pT39PynU5ZyjWW4F4LF9XpChmMUd5-Ba3XDI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DxF1oY3ffPw34JuQspZMEmV85OJuCy1Yq89n8IOLBVg&oe=69DF76FF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Contractors Showdown : ExfilZone", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation
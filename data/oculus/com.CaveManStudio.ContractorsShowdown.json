cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vb7AEKP_PPkQ7kNvwEVnLGz&_nc_oc=AdqoRTexDiFM9kmznoe7GOL13VVT3Jr1-rQMSxr4bNjzNJbx_g5ZHe66Z3pFCWc8nbU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS12lp2TsP3jEVPxqD6MthyoN7H9SvZTAkQDRrECDjqlA&oe=6AE74B5F"}, {"file_name": "mag palming-min.png", "id": "548910874939803", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822020_548910881606469_4543421072975301063_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1x3UYEKxaA4Q7kNvwEXapAL&_nc_oc=Adqg6lBzAg0e7H3KJcOhCUNDRXSOUgrGyLLQElghalSXES1VrDFaLs6uLR_t2huSDAo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyakFJSNjCfIEIv50UzzL99GAHZ8tZ0LS6CX6VhybOkg&oe=6AE75FBD"}, {"file_name": "map6.png", "id": "1343088460776712", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830589_1343088464110045_1020003823517565749_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0GH8Ui0bZAQ7kNvwESZv7f&_nc_oc=AdqisFYRzJWZPDRXuFrnO-p-zyhOqNVI7eGZvh4l0S3yfq-4od8tNlzLOtdaxqW2VSc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE5RQ6DhUDMLEylz0V7bB5ZWISkL48VtWr-lYdP_4FEg&oe=6AE76357"}, {"file_name": "Screenshot 02.png", "id": "1592369061424075", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974821_1592369064757408_654873570675317287_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQrtjszeJ2UQ7kNvwEMVwQ8&_nc_oc=Adqm53dLCWfW78wRdihv8lSEugnVfzmhfq4k81KfR1Um22LxYnlKqjZO0gO3hzAHRb0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7hN4a6DPa8c44-4jHZLKq8o0IXN1bAmWhDpXHDLZqYA&oe=6AE7623C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape 2560x1440.png", "id": "1082849617788477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623179_1082849621121810_8060216909452847444_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQWaDzGPq4oQ7kNvwEHO0kh&_nc_oc=Adoz-Akwaj9QVElQsnCptq87jxYw59WRqKqYNvdZD6vlexLsT8QCSDVnrycKiffhTaI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW1JMPKdBPW6bfUmYjWLDXxnxAADdFq2U3tZjtsG-4Cw&oe=6AE749AD"}, "display_name": "Contractors Showdown : ExfilZone", "keywords": ["extraction", "shooter", "tarkov", "hardcore", "realism"], "long_description": "Enter **ExfilZone**, the immersive extraction-based game mode in Contractors Showdown, where every decision could mean life or death. ExfilZone introduces a deep progression system intertwined with dynamic missions, challenging you to survive, complete objectives, and extract with your hard-earned loot.\n{1348640809526448}\n\nIntroducing PvE Mode \u2014 a new, more approachable way to enter ExfilZone with scalable challenge and high-stakes combat.\n\nCraft your ultimate loadout with the one and only VR **Gunsmith System**, featuring over **50** weapons and **thousands** of combinations. Customize attachments, tweak components, and design unique color schemes to dominate with style.\n{2224795561280421}\n\nTake on missions from unique vendors, ranging from elimination contracts and reconnaissance tasks to planting trackers and resource gathering. Completing these missions builds loyalty with vendors, unlocking new weapons, gear, and upgrades to expand your arsenal. \n{1856892261707045}\n\nSurvival is not just about firepower. Master health system, manage limb damage, bleed and scavenged medical supplies. Keep your stamina up by staying hydrated and fueled as you fight through intense raids.\n{630541546618689}\n\nChoose from five diverse maps\u2014Suburbs, Metro, Dam, Resort, and Smuggler\u2019s Tunnel\u2014each offering unique environments and tactical challenges. From urban sprawls to tight tunnels, every raid tests your strategy in the best VR extraction game. \n{1842428576612333}\n\nJoin our community to share gun builds, find squadmates, and stay updated **[Discord.gg/contractorsshowdown]**\n", "short_description": "Contractors Showdown delivers intense VR extraction combat in ExfilZone, now featuring PvE Mode alongside high-stakes PvPvE action. Customize your loadout, complete missions, loot, survive, and fight your way through immersive tactical battles."}]}, "developer_name": "Caveman Game Studio", "developer_privacy_policy_url": "https://www.contractorsvr.com/privacy", "developer_terms_of_service_url": "https://www.contractorsvr.com/termsofserviceeng", "publisher_name": "Caveman Game Studio", "support_website_url": "https://www.contractorsvr.com/contact", "website_url": "https://www.contractorsvr.com/showdown", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "fr", "de", "ko", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "26719184051112850"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593895988_4622389821351993_9152603609064194852_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAaaTtp_HokQ7kNvwFKdwKD&_nc_oc=Adoq1V8y6dDAdBOejnvEbi_THm2k-FSr-Zua_q2B9D7pEeFK2iFtzL_VWf3H86JR-jQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5tPGlwrWPiRUhjuuVqGXluWyV6TgH8F-UKus0B4Lwjg&oe=6AE770EA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Contractors Showdown : ExfilZone", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": 
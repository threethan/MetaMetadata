l3-1.oculuscdn.com/v/t64.5771-25/499622315_1750797185888785_2395800951485318516_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSN_RfCBgqsQ7kNvwEEjdpb&_nc_oc=AdqkCPEJTy66ClPGZlgrH8sYV9dYYdv7ojkJMH_tvshRdos-FWUYbwj1taGUhMaewJo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQdeCgQksWWpnntAAACcRM0WWSYFCbe4g5vwZumvA0Ikw&oe=6B0B3D3A"}, {"file_name": "Resim5.png", "id": "1489160006323008", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622211_1489160009656341_5199361351526640471_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_n13wz2xHNsQ7kNvwFwOWzt&_nc_oc=Adr1gyTHFwtWiGlUDaVt9gZ1a3o7RoBvayjLVAoa7dz43ByfjzAYkFxZMCVKWwQ19xg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSEqEkcrs1S7qk_hUzfWlDtzjLbBp2CCWwNodwuArDZGw&oe=6B0B4202"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Excavator Simulator REMAKE", "keywords": ["Excavator", "Kepce", "Yikim", "insaat", "simulasyon"], "long_description": "\u2022 12 farkl\u0131 ger\u00e7ek\u00e7i senaryo\n\n\u2022 VR Deste\u011fi ile en ger\u00e7ek\u00e7i kep\u00e7e kullanma deneyimi\n\n\u2022 ISO - SAE Kontrol Deste\u011fi\n\n\u2022 E\u011fitim ve serbest oyun modlar\u0131\n\n\u2022 Bina y\u0131kma, kanal kazma, k\u00f6m\u00fcr y\u00fckleme, may\u0131n temizleme gibi \u00e7e\u015fitli g\u00f6revler\n\n\u2022 T\u00fcrk\u00e7e ve \u0130ngilizce dil deste\u011fi\n\n\u2022 Ger\u00e7ek\u00e7i hidrolik, motor ve palet ses efektleri\n\nHaz\u0131r m\u0131s\u0131n\u0131z? Sahaya \u00e7\u0131k\u0131n, makineleri \u00e7al\u0131\u015ft\u0131r\u0131n ve g\u00f6reve ba\u015flay\u0131n.\n\nKAZ, YIK, PAR\u00c7ALA !!!", "short_description": "Ger\u00e7ek\u00e7i fizik motoru, detayl\u0131 ekskavat\u00f6r kontrolleri ve sahici g\u00f6rev yap\u0131s\u0131yla Excavator Simulator Remake, sizi do\u011frudan i\u015f sahas\u0131n\u0131n merkezine ta\u015f\u0131yor. Geli\u015ftirilmi\u015f grafikler, optimize edilmi\u015f kamer
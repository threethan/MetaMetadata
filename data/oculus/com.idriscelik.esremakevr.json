cdn.com/v/t64.5771-25/604282317_1542071937266848_2615766593411771233_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pG5gIClEa-EQ7kNvwHlOcyI&_nc_oc=Adrx5m_j0o7_IW4ywF-l2iaLWEmMWTwtNeLXCETox6trc_NBv3fkRYk_o2zYpTDko9g&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwZQbXdGz8b8WTY_mjd8_u_BHqeV-6MHCHjUeDo2JRVg&oe=6A91815A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Excavator Simulator REMAKE", "keywords": ["Excavator", "Demolish", "Construction", "Simulation", "Building"], "long_description": "\u2022 12 unique and realistic scenarios\n\n\u2022 VR support for the most realistic excavator operating experience\n\n\u2022 ISO - SAE Control Support\n\n\u2022 Play freely or practice with dedicated excavator training mode\n\n\u2022 Demolish buildings, dig trenches, load coal, clear mines \u2014 a variety of exciting tasks to sharpen your excavator skills\n\n\u2022 English and Turkish language support\n\n\u2022 Immersive sound design with realistic hydraulic, engine, and track effects\n\nNo need for small talk \u2014 grab the controls and SMASH, BREAK, DEMOLISH!", "short_description": "With realistic physics, detailed excavator controls, and authentic job-site missions, Excavator Simulator Remake puts you right in the heart of heavy-duty construction. Enhanced visuals, optimized camera transitions, and richly designed scenes offer a simulation experience that\u2019s both technically satisfying and genuinely fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.idriscelik.com.tr/privacy-policy/", "developer_terms_of_service_url": "https://www.idriscelik.com.tr/terms-of-use/", "publisher_name": "idris Celik - Game Design", "support_website_url": "https://www.youtube.com/@unitydeveloper", "website_url": "https://www.idriscelik.com.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topi
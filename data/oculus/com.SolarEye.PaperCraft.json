oe=69C3D137"}, {"file_name": "QuestScreenshot4.png", "id": "1330018742260984", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618910_1330018745594317_6676103463342293357_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZykg-De76oQ7kNvwHXdVKS&_nc_oc=AdpUVcHRCDsvYVZgHbam0OQpefvG2_Yw1l1rp_QsHtMUJs5HSzThvulrVhDut0KxHOI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxnq74e-GCnmQ8TJR_bCnuKRbKPvpIOZsyLKlm6Hm4Vcw&oe=69C3F095"}, {"file_name": "QuestScreenshot5.png", "id": "25589026364121422", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619718_25589026367454755_2190227179673458669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYuNV3FUfsAQ7kNvwEaoOQ5&_nc_oc=AdozJ_BQNc2OQI5uw4he2OtVkiF6hJ9j2iJG4xN_uj24_a5PIoIxLBRRLpzIpUBBNLg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHvCwM8PtAP_m4ycwABeUvPIumctBjHgABAgNs_W7fyQ&oe=69C3EE9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer2 Thumb.png", "id": "1188424799418750", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298248_1188424802752083_3650815766645314789_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOSFHnbz2gAQ7kNvwEfwfJi&_nc_oc=AdoCjScMF6u7b97cig8HtsJkqSPi1juaIS4SD9XoltWMrhKpNhPgrlerTT2ytSBgn2E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyl_ejcqN4U4NDXUc7GAG-kHwyNtROR_FIFQbZy6dyVrw&oe=69C3BC4A"}, "display_name": "Paper Craft", "keywords": ["Platformer", "Adventure", "Editor", "Creation", "Singleplayer"], "long_description": "Paper Craft is a made for VR 3D platformer.\n\nDemo out now!\n\nWith up to 5 unique powerups that change the game in different ways, your adventure will test your platforming skills.\n\nA campaign made of 20 levels that were all made using the in-game level editor. Each level designed to use your skills that have been learned so far to continue further to the end.\n\nThe game also comes with the very level editor that we used to make the campaign. The level editor is designed to be as user friendly as possible and easy to pick up for those who want to get into creating. \n\nOnce your done making your levels you can share them worldwide where other players can download and play them. The possibilities are endless!", "short_description": "A VR platformer that takes place in a world of arts and crafts! Run, swing, ride, hover, and platform your way through 20 campaign levels. Create and share your own levels worldwide with our easy to use level editor! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://solareye.net/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Solar Eye LLC", "support_website_url": null, "website_url": "https://solareye.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1725996564472128"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34108153598771652"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1229759275404879"}]}, "baseline_offer": {"id": "1229759275404879"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772042340, "status": "PUBLISHED", "id": "1229759275404879"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35278106965109637", "version": "1.0.3"}, "id": "1924833154911897", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "33551336567786694", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35278106965109637"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1924833154911897"}]}, "change_log": "Version 1.0.3\n\nLevel Changes\n- Added animated water to all levels\n- 3-2 Added slopes to some bumps\n- Other minor changes to several levels\n\nMisc Changes\n- Slightly increased acceleration and deacceleration to try and help with tight jumps\n\n\nBug Fixes\n- Looking down while using stick movement no longer slows you down", "created_date": 1773104421, "id": "35278106965109637", "version": "1.0.3", "version_code": 7, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "33551336567786694", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35278106965109637"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1924833154911897"}]}, "change_log": "Version 1.0.2\n\nLevel Changes\n- The third menu has been changed a bit\n- 1-1 & 1-2 now has an arrow to help players into the next sublevel\n- 5-1 fixed an invisible wall that made the level impossible\n- 2-1 adjusted a bouncepad near a stitcher\n\nMisc Changes\n- Moving down slopes now keeps you on the floor\n- Stomping on enemies should be easier\n- Boostpack powerup now recharges when stomping on enemies normally\n- Small steps no longer bump the player up\n- Movement direction has been given a bigger range for moving at full speed\n\n\nBug Fixes\n- Second row of downloaded levels now points to the correct levels\n- A downloaded level that is no longer on mod.io accurately shows the data before deletion\n- Objects in a parenter that are also connected to an animation now behave consistently", "created_date": 1772585180, "id": "35169611109292557", "version": "1.0.2", "version_code": 6, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "33551336567786694", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35278106965109637"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1924833154911897"}]}, "change_log": "Version 1.0.1\n\nLevel Changes\n- 2-1 now has invisible ceilings\n- 2-4 added an extra flower to rotating platforms\n- 3-2 Removed invisible ceiling near second half of level\n- 3-4 now has a second checkpoint in the 3rd sublevel and pillars are no longer slippery\n- 4-4 changed ramp length to better make a jump\n- 5-1 you can no longer escape the level as easily\n- 5-2 has been optimized\n- 5-3 3rd sublevel checkpoint no longer reloads on death\n- 5-4 3rd sublevel difficulty has been tweaked and 4th sublevel ending is easier\n\nMisc Changes\n- Increased Torch range\n- Added sounds from an endgame area to the sound player\n- Optimized World 2 menu\n\n\nBug Fixes\n- Slippery surfaces now save properly in saved objects\n- Thread orbs are no longer visible when taking a level picture", "created_date": 1772132109, "id": "35075599922027010", "version": "1.0.1", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": 
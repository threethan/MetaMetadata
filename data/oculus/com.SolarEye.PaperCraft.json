culuscdn.com/v/t64.5771-25/499619718_25589026367454755_2190227179673458669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6dTR15ZTnokQ7kNvwEcCFoP&_nc_oc=Ado30JxKFM8NcOeAM7rHbb2pdSK5RQqVymxsy7jlC3Y2DMI4f6UH-CZI7_uX0t5g_Qc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKusZd1gDNf8XgLTb4ZCqVju-fB64CkPRKLW1mB5MW3Gg&oe=6AA6B09D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LaunchTrailer.png", "id": "1436062271528161", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296057_1436062274861494_619213007304316111_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPVnX2rJ3KwQ7kNvwE4kU_m&_nc_oc=AdrdrRWtPjbMdVJYf7fR-h5gCDIb9iTLFTR_-rdyU6Ic3_4kVR2lg84Dbj2edj_aM_8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFkCTtdzFiC34Z6RXVo444kEMcoko5rvGXjsIm1Xa0Lg&oe=6AA6B8A3"}, "display_name": "Paper Craft", "keywords": ["Platformer", "Adventure", "Editor", "Creation", "Singleplayer"], "long_description": "Paper Craft is a made for VR 3D platformer.\n\nDemo out now!\n\nWith up to 5 unique powerups that change the game in different ways, your adventure will test your platforming skills.\n\nA campaign made of 20 levels that were all made using the in-game level editor. Each level designed to use your skills that have been learned so far to continue further to the end.\n\nThe game also comes with the very level editor that we used to make the campaign. The level editor is designed to be as user friendly as possible and easy to pick up for those who want to get into creating. \n\nOnce your done making your levels you can share them worldwide where other players can download and play them. The possibilities are endless!", "short_description": "A VR platformer that takes place in a world of arts and crafts! Run, swing, ride, hover, and platform your way through 20 campaign levels. Create and share your own levels worldwide with our easy to use level editor! "}]}, "developer_name": null, "developer_privacy_policy_url": 
_ss=7f20f&oh=00_AQNyr1aLjdkm1cRa5WqyqJLm8IIdWkxXIamzGvJTIyI-OA&oe=6AE1E6B7"}, {"file_name": "QuestScreenshot4.png", "id": "1330018742260984", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618910_1330018745594317_6676103463342293357_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVFGW8B7oaoQ7kNvwGbCnIh&_nc_oc=AdrmIJOmaTy2gFXmfgjJyBuagwH13TH2yspdwSfWdX6OGcjYzcbUoD-vi24pcZRRSvA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnL3lcxC8rdOE8gHZGF5Nxi-PMtlrmInOJo7osSSDMcg&oe=6AE20615"}, {"file_name": "QuestScreenshot5.png", "id": "25589026364121422", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619718_25589026367454755_2190227179673458669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HL_x2GFiVUcQ7kNvwHmx9SK&_nc_oc=AdryfLd3_r9pt_1eoib-ynoqnWJ0PysS84SMT6LP3J160obW7IZTySvWh8xWSp-hZsk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOlCvVlFwxIEaPalP6AV0usivJKf7_OsJBtygZOL6ULA&oe=6AE2041D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer2 Thumb.png", "id": "1188424799418750", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298248_1188424802752083_3650815766645314789_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqzB2sCP2zcQ7kNvwFNJRN-&_nc_oc=AdqQefucLa0S1k8Ef7xSjzykvnBY1wKw893ia0pm4gu6-CUtr9n4SU91w0m3jFbOFqM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPKfcH1r7689bm2qOOXPM3yq89AVJIz0LdWBF80UrkGg&oe=6AE20A0A"}, "display_name": "Paper Craft", "keywords": ["Platformer", "Adventure", "Editor", "Creation", "Singleplayer"], "long_description": "Paper Craft is a made for VR 3D platformer.\n\nDemo out now!\n\nWith up to 5 unique powerups that change the game in different ways, your adventure will test your platforming skills.\n\nA campaign made of 20 levels that were all made using the in-game level editor. Each level designed to use your skills that have been learned so far to continue further to the end.\n\nThe game also comes with the very level editor that we used to make the campaign. The level editor is designed to be as user friendly as possible and easy to pick up for those who want to get into creating. \n\nOnce your done making your levels you can share them worldwide where other players can download and play them. The possibilities are endless!", "short_description": "A VR platformer that takes place in a world of arts and crafts! Run, swing, ride, hover, and platform your way through 20 campaign levels. Create and share your own levels worldwide with our easy to use level editor! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://solareye.net/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Solar Eye LLC", "support_website_url": null, "website_url": "https://solareye.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1725996564472128"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34108153598771652"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1620488759814468"}, {"status": "PUBLISHED", "id": "1229759275404879"}]}, "baseline_offer": {"id": "1620488759814468"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791922020, "status": "PUBLISHED", "id": "1620488759814468"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39537507562502868", "version": "1.1.2"}, "id": "1924833154911897", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "33551336567786694", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39537507562502868"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1924833154911897"}]}, "change_log": "Paper Craft Version 1.1.2 Patch Notes\n\n\nLevel Changes\n\n5-2\n- Added fog for visibility\n\n5-3\n- Added grapple powerup to prevent softlock\n- Covered a hole in the level geometry\n\n\nBug Fixes\n- Deleting a parenter no longer deletes the parented object\n- Fixed a bug with fog fading\n- Fixed a bug where the player would not bounce off a hopper if it was the parent of a parenter\n\n\nMisc Changes\n- The sun is no longer visible during the startup sequence\n- Materials are now a bit higher in quality", "created_date": 1789334182, "id": "39537507562502868", "version": "1.1.2", "version_code": 14, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "33551336567786694", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39537507562502868"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1924833154911897"}]}, "change_log": "Paper Craft Version 1.1.1 Patch Notes\n\n\nLevel Changes\n\n3-4\n- Increased a bouncepad's power to make a jump easier to make\n\n4-4\n- Increased the size of the enemy kill zone\n\n5-2\n- Removed a small bit of level geometry in the third sublevel that could prevent you from progressing.\n\n5-3\n- Changed the music in the second sublevel\n\n\nBug Fixes\n- Platformer paper clips now consistently stay in the same orientation\n- Fixed a bug with the level end screen that could cause it to show the wrong information\n- Fixed a bug with the Style Points achievement that allowed it to be obtained without being on the hoverboard\n\n\nMisc Changes\n- Fixed a typo in the playtesting section of the help tab\n- Added the slap sounds to the sound player", "created_date": 1788979271, "id": "39427173083536317", "version": "1.1.1", "version_code": 12, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "33551336567786694", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39537507562502868"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1924833154911897"}]}, "change_log": "# Paper Craft Version 1.10 Patch Notes #\n\nNew Additions\n\nSlapping\nYou can now slap Hoppers, Divers, and Toplings! Divers will turn the other way when slapped.\n\nNew Music\nUnique music tracks for 1-2, 5-2's ending, and 5-3's beginning have been added.\n\nNew Menus\nMenus for completing the game and completing all achievements have been added.\n\nNew Achievements\n3 new achievements have been added.\n\nNew Help Section\nIn create mode, you can now view helpful tips on how to create a level.\n\n\nLevel Changes\n\n1-3\n- Added jump pads to certain spots and moved some paper scraps around\n\n1-4\n- Changed the position of some level transition triggers and spawnpoints\n- Target lights now turn off after hitting them\n- The last room has a checkpoint after beating the boss\n\n2-1\n- Added more detail to the elevator\n\n2-3\n- Fixed some holes in level geometry\n\n2-4\n- Butterfly on the right side now has a way to return to the regular path\n\n3-4\n- Outside areas and picture now use the cloudy skybox\n- There is now a checkpoint after the boss\n\n4-1\n- Added a secret\n\n4-3\n- Fixed some Tack Shooters clipping into the ground\n\n4-4\n- Added an animation at the end of the level\n\n5-1\n- Fixed a hole in level geometry\n\n5-2\n- Checkpoints are now tilted in the direction you need to go\n- Added a system to disable lights to hopefully improve performance\n- A checkpoint was removed\n\n5-3\n\n- Bridge has better collision for the Hoverboard\n- Some enemies early in the level now glow\n- Fixed a darkness gradient clipping into the wall\n- Reduced number of enemies that drop down from a chute\n- Crushing the big Topling now has a visual for after it gets crushed\n- Added an extra checkpoint and some more grapple points in a section\n\n5-4\n- Edited ending room to be consistent with previous areas\n\n\nMisc Changes\n- When completing an online level, you can now like and dislike the level instead of needing to go to the main menu\n\n\nBug Fixes\n- Fixed bug that would cause some world complete achievements to not achieve\n- Sorting by newest added now properly works in downloaded levels\n- Platformer paper clips now rotate with any surface they are attached to", "created_date": 1788792004, "id": "39372028479050778", "version": "1.1.0", "version_code": 11, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "33551336567786694", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39537507562502868"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1788740950, "id": "39358211553765804", "version": "1.1.0", "version_code": 10, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "33551336567786694", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39537507562502868"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1924833154911897"}]}, "change_log": "Version 1.0.4 Hotfix\n\nLevel Changes\n- All level changes from 1.0.4 are properly implemented\n\nMisc Changes\n- Removed the slope helping feature due to bugs that make certain gameplay sections harder.", "created_date": 1775523790, "id": "35846498368270491", "version": "1.0.4", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
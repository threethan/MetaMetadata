.oculuscdn.com/v/t64.5771-25/499619718_25589026367454755_2190227179673458669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HL_x2GFiVUcQ7kNvwHmx9SK&_nc_oc=AdryfLd3_r9pt_1eoib-ynoqnWJ0PysS84SMT6LP3J160obW7IZTySvWh8xWSp-hZsk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOlCvVlFwxIEaPalP6AV0usivJKf7_OsJBtygZOL6ULA&oe=6AE2041D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LaunchTrailer.png", "id": "1436062271528161", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296057_1436062274861494_619213007304316111_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h33_7H3yd4kQ7kNvwHe8yhv&_nc_oc=Adqc-LBvqpeisnXPM01Potb1ozlQXLefhHq04gxRc6lk24SF5Nr3AZnXerQNktUP1LM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAS9xKfHeKOLbKDnyKce3DSxmGr5qDEykfCPvRwxBAnA&oe=6AE20C23"}, "display_name": "Paper Craft", "keywords": ["Platformer", "Adventure", "Editor", "Creation", "Singleplayer"], "long_description": "Paper Craft is a made for VR 3D platformer.\n\nWith up to 5 unique powerups that change the game in different ways, your adventure will test your platforming skills.\n\nA campaign made of 20 levels that were all made using the in-game level editor. Each level designed to use your skills that have been learned so far to continue further to the end.\n\nThe game also comes with the very level editor that we used to make the campaign. The level editor is designed to be as user friendly as possible and easy to pick up for those who want to get into creating. \n\nOnce your done making your levels you can share them worldwide where other players can download and play them. The possibilities are endless!\n\nA demo is also available for download under the name \"Paper Craft Demo.\"", "short_description": "A VR platformer that takes place in a world of arts and crafts! Run, swing, ride, hover, and platform your way through 20 campaign levels. Create and share your own levels worldwide with our easy to use level editor! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://solareye.net/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Solar Eye LLC", "support_website_url": null, "website_url": "https://solareye.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1725996564472128"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "40300743719512578"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619672_858121783819359_3567697529083525599_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJgV3nj1kgkQ7kNvwFwcA7J&_nc_oc=AdpYvCtYUh4EZ8we1F_fgHsymN52riz_mGYMqt9l2ZVm29O4HZTpcOTG-m8nSFNP1nU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOW-6bu90eqk-HImGvOpv1ehe1iucGMSgxP40gMsaJxYg&oe=6AE207C1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Paper Craft", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "World Creation", "id": "1725996564472128"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1772042340, "lastRevision": {"nodes": [{"id": "33551336621120022", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata
31880_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzRMYOAqCgkQ7kNvwEKiTwr&_nc_oc=AdpABryR5lHE0HfWdfn2nQPdWXp33a4ODESr1ITmcGK8uKxILUQ2o7YzkbuA9uFLKJg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hC__Y6tttTY9Rn2jz1IlrtlFoJb99k4IaOjrcUetexw&oe=6A2C0A2B"}, {"file_name": "DirtRacing_Screenshots_SS5.png", "id": "956140170430457", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499620504_956140173763790_4367439451626191946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmuY3NiQDzkQ7kNvwEJPD5T&_nc_oc=Adrq0xM8quKt4swAwCRnxs-kzC1mcVNOSW2r_K9TqjdhGqzqO1bJHGLFkYXXcq12go8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8N2WCk_eYJaW0B_kxok7BXLamppkv7JMmdxoQtmxUPEQ&oe=6A2C1C71"}, {"file_name": "DirtRacing_Screenshots_SS4.png", "id": "1663737814971264", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618515_1663737818304597_5513392942512896735_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXEcOAPnqvAQ7kNvwFHo3bz&_nc_oc=AdqJ3cSI10vefnnzpuzMVgcSn3-Rt_mrfQw17wPWyO_Ru2FU6TzdqSVl7Bjrf3xXAxY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84M1cqfEuNxWO0MpXyHkDHqTDyzylo569ly74ZNNBT3w&oe=6A2C09EE"}, {"file_name": "DirtRacing_Screenshots_SS3.png", "id": "4463414757312337", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618102_4463414760645670_4621950848041327339_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEyj_9CnzXIQ7kNvwEOBG9n&_nc_oc=Adog6gTr3YXo_3OTLbMxTlL065d1jxEJZWesbGUb4IdUHUPXBqXHp-JmBoE_N6NwAZ8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FqeH7zswuof3Box3A01QpUesZvzmGGLnXwz9w4Ms8cQ&oe=6A2C24B5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dirt Racing: SUV Offroad Challenge", "keywords": ["racing", "offroad", "dirt", "SUV", "car"], "long_description": "Get behind the wheel for the most immersive offroad experience in VR. Dirt Racing: SUV Offroad Challenge puts you in the cockpit of high-performance 4x4s to conquer punishing terrain, unpredictable weather, and aggressive AI rivals. This isn't just a game; it's a precision-tuned sim where every jump and drift feels dangerously real.\n\nPHYSICAL VR CONTROLS\nStep into a fully interactive cockpit where your hands do the driving.\n\nManual Handling: Grab the steering wheel, pull the handbrake for sharp drifts, and shift gears.\n\nTactile Interactions: Reach out to adjust your mirrors or blast the NOS to overtake the pack.\n\nPro Physics: Feel the weight of your vehicle with a suspension system built for realistic mud and dirt traction.\n\nCONQUER EVERY TERRAIN\nFrom high-speed stadium speedways to our signature dense jungle circuits, every race is a battle for the line. Navigate thick mud, steep hills, and lakeside trails where your reflexes are the difference between victory and a wipeout.\n\nGAME FEATURES:\nThree Competitive Modes: Dominate in Circuit Racing, Sprints, and Best Lap challenges.\n\nDynamic Environments: Master the dirt through changing light and weather cycles.\n\nAggressive AI: Trade paint with a full field of rivals fighting for the podium.\n\nDeep Customization: Personalize your ride with a wide variety of unique liveries.\n\nGlobal Leaderboards: Prove you\u2019re the fastest 4x4 driver in the world.\n\nOutrun the pack. Dominate the dirt. Own the trail.", "short_description": "Ultimate 4x4 SUV racing simulator! Battle aggressive AI rivals in high-stakes offroad races. Experience true VR immersion: grab the steering wheel, rip the handbrake, & blast the NOS. Conquer mud, stadium, & jungle tracks in high-performance offroaders.\n\nPro Physics: Realistic suspension & traction on varied terrain.\n\nDynamic Racing: Multiple modes, global leaderboards, & changing light cycles.\n\nFull Customization: Personalize your ride with unique liveries.\n\nOutrun the pack. Dominate the dirt."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gamotronixstudio/privacypolicy-meta", "develop
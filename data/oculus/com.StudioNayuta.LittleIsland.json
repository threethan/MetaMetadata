1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW5Aj1jzE7j-k3cRxsiLjCASOwH9tSE-KjYG9Z3HWKGcw&oe=6B0EEF19"}, "display_name": "Little Island", "keywords": [], "long_description": "Little Island offers you the experience of interacting with a variety of cute animals in a VR space. Dive into a world full of nature and adorable animal children. You will be healed by interacting with the lively animals. Help them in their time of need, play with them, and love them.\n\nFeatures:\n\u30fbBeautiful nature and interacting with lovely animals are healing you\n\u30fbBeautiful nature and interacting with lovely animals are healing you\n\u30fbA variety of 18 adorable animal children\n\u30fbFive unique locations where animals live, including forests and ice fields.\n\u30fbVarious items for playing with animals\n\u30fbFishing and growing flowers for relaxation.", "short_description": "Little Island offers you the experience of interacting with a variety of cute animals in a VR space. \nDive into a world full of nature and adorable animal children. You will be healed by interacting with the lively animals. Help them in their time of need, play with them, and love them."}, {"images": {"nodes": [{"file_name": "Landscape_2560x1440.png", "id": "1142337546298012", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031623_1142337549631345_562413955573729343_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vd0R_HoeFvwQ7kNvwGltmbC&_nc_oc=AdpZQ_iZz7_3vfccCo2JJ9k4Eu4DMN-Es2cx5QF9TXyyb7DviJOvduTEUQNfHF6Rq4I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW1abPgXJvTfNY6OSz8nUkXv2rmYIlzY86uI1_edeY1RQ&oe=6B0F1AAF"}, {"file_name": "Portrait_1008x1440.png", "id": "1059134344887071", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982469_1059134351553737_3778632513215331819_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4sBcTWSzWAQ7k
1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT4taq1Ele41M0zo9kLF4RaWPVQYDIxpA-gJ6jG_Lh0yQ&oe=6B0B32D9"}, "display_name": "Little Island", "keywords": [], "long_description": "Little Island offers you the experience of interacting with a variety of cute animals in a VR space. Dive into a world full of nature and adorable animal children. You will be healed by interacting with the lively animals. Help them in their time of need, play with them, and love them.\n\nFeatures:\n\u30fbBeautiful nature and interacting with lovely animals are healing you\n\u30fbBeautiful nature and interacting with lovely animals are healing you\n\u30fbA variety of 18 adorable animal children\n\u30fbFive unique locations where animals live, including forests and ice fields.\n\u30fbVarious items for playing with animals\n\u30fbFishing and growing flowers for relaxation.", "short_description": "Little Island offers you the experience of interacting with a variety of cute animals in a VR space. \nDive into a world full of nature and adorable animal children. You will be healed by interacting with the lively animals. Help them in their time of need, play with them, and love them."}, {"images": {"nodes": [{"file_name": "Landscape_2560x1440.png", "id": "1142337546298012", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031623_1142337549631345_562413955573729343_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYDqO7Y84WgQ7kNvwEWAjgw&_nc_oc=AdrEtrqLCLolXTTLqglTbFoWJOL4zTdE4wWo1I5a5U4THVhj72AanZ1BgBPS3o2ikUo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRGpryV2WFPunyfrvS20oikipo7E8Xkm0SDPJ5KADy5qA&oe=6B0B262F"}, {"file_name": "Portrait_1008x1440.png", "id": "1059134344887071", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982469_1059134351553737_3778632513215331819_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_poe8s7iEjgQ7k
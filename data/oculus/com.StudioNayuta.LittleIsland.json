1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1BsYVxGaR2JNSrZE-fRxh4HMps36b7dB-Hf7zh8tFgQ&oe=6B01C019"}, "display_name": "Little Island", "keywords": [], "long_description": "Little Island offers you the experience of interacting with a variety of cute animals in a VR space. Dive into a world full of nature and adorable animal children. You will be healed by interacting with the lively animals. Help them in their time of need, play with them, and love them.\n\nFeatures:\n\u30fbBeautiful nature and interacting with lovely animals are healing you\n\u30fbBeautiful nature and interacting with lovely animals are healing you\n\u30fbA variety of 18 adorable animal children\n\u30fbFive unique locations where animals live, including forests and ice fields.\n\u30fbVarious items for playing with animals\n\u30fbFishing and growing flowers for relaxation.", "short_description": "Little Island offers you the experience of interacting with a variety of cute animals in a VR space. \nDive into a world full of nature and adorable animal children. You will be healed by interacting with the lively animals. Help them in their time of need, play with them, and love them."}, {"images": {"nodes": [{"file_name": "Landscape_2560x1440.png", "id": "1142337546298012", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031623_1142337549631345_562413955573729343_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_8iSFrTJ4UQ7kNvwHZAzwl&_nc_oc=AdrUAitGzgV-JRyh_CW9vfKD-rfLMZenrEdzjUl9ksEMuKZjrINs7kWjQFZ9Jd3eMQk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaak1SzgT3lQDtbYFROb40EwkgHwzmAvBo0pp-snXYfg&oe=6B01EBAF"}, {"file_name": "Portrait_1008x1440.png", "id": "1059134344887071", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982469_1059134351553737_3778632513215331819_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sbEZD7UHH4Q7k
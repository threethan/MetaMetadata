on who knows VR and wants to prepare something meaningful for someone who may be new to it. Set up a real room with photos, videos, audio, and small surprise moments, arrange them with Quest controllers, then hand the headset to someone you care about.\n\nThey do not need to build anything. They can simply walk through the room, discover what you placed, replay meaningful media, and reach a final reveal.", "short_description": "Create a memory room for someone sepcial."}]}, "developer_name": null, "developer_privacy_policy_url": "https://forhilight.github.io/roomory/privacy/", "developer_terms_of_service_url": null, "publisher_name": "DAZ MR", "support_website_url": "https://forhilight.github.io/roomory/support/", "website_url": "https://forhilight.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_TW", "zh_HK", "ko", "ja", "de", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1194731520383633"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624977_1626699779110637_2035539251237938956_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcGmfi2SbO0Q7kNvwGfZ6py&_nc_oc=AdplBi5eormi8jlII8gmQOFlVE5_LCDIk3OyK0gO3977IBqmQhxU7_M1UH-paWYEANM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFL4jDMO9BRxAOj0Itj-cCJdwxMhClCQi7VN0nExQKtZw&oe=6A79C589"}, "is_conce
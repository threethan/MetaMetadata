acer", "addictive", "cars"], "long_description": "Never back down as you race anyone crazy enough to take you on and leave them gapped. Dig, drift, drag, and roll your ride to the finish line. Multiple Car select with multiple Game mode's and Tracks. Your rides are waiting \u2013 take them to the circuits to go head-to-head with the competition and prove yourself. Because one ride is never enough!", "short_description": "Love car racing game? then try our simple car racing game on your device. I\u2019m sure you will enjoy when you start driving on Track. Show your driving skills by playing this cool racing game."}]}, "developer_name": "Chipsy Information Technology Services", "developer_privacy_policy_url": "https://www.chipsyservices.com/privacy-policy", "developer_terms_of_service_url": "https://www.chipsyservices.com/terms-and-conditions", "publisher_name": "Chipsy Information Technology Services", "support_website_url": "https://www.chipsyservices.com/", "website_url": "https://www.chipsyservices.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["RACING", "SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "487578849395699"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031396_297252464301529_3178664373321203712_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-MUEbs6cMgQ7kNvwFau_i9&_nc_oc=AdnECxO8FjTQe5wLf0aHU-VoJ9rMxtORo9rUlkDBzGV0ck-k_PAdaaGxT5JHfePTUVA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs
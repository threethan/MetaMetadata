s": [], "long_description": "ARE YOU READY TO SAVE SAM.\n\nStep into a fun Mixed-Reality, Handtracking, Level based game.\nMove around in you own  3D space (3x2 meter) to save SAM, the more Sam\u2019s you save in a level the more SAM\u2019s you get in the next level.\n\nTHE BEST SAVE SAM HELPERS GET'S ON THE ONLINE LEADERBOARD.\n\nHOW MANY SAM'S HAVE YOU SAVED TO DAY?\n\nHave FUN and ENJOY.", "short_description": "ARE YOU READY TO SAVE SAM.\n\nStep into a fun Mixed-Reality, Handtracking, Level based game.\nMove around in you own 3D space (3x2 meter) to save SAM, the more Sam\u2019s you save in a level the more SAM\u2019s you get in the next level.\n\nTHE BEST SAVE SAM HELPERS GET'S ON THE ONLINE LEADERBOARD.\n\nHOW MANY SAM'S HAVE YOU SAVED TO DAY?\n\nHave FUN and ENJOY."}]}, "developer_name": "MANGO CHUTNEY PICTURES", "developer_privacy_policy_url": "https://mangochutney.dk/Save_Sam_The_Little_Green_Mann_Privacy_Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "MANGO CHUTNEY PICTURES", "support_website_url": null, "website_url": "https://mangochutney.dk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24034707529467098"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499330036_3612105015758224_6407713560684926991_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_s
6"}, {"file_name": "Ads\u0131z tasar\u0131m (13).png", "id": "843490035512363", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819407_843490042179029_7188487023292440290_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIhCzmPctLoQ7kNvwHfcRSj&_nc_oc=AdrQ_54hWGSqEQ5Ap0-Tj_QBk7oJAGmMPYlWdXdrqdckv3Hfbta-DV1IjHCazFsuJpM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVXyLODoGvN3wb1n3Vd0zsEx5at_bM_fSSTVqaeQvDNJg&oe=6B0F011E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ads\u0131z tasar\u0131m (12).png", "id": "4336702669986827", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304764_4336702673320160_8474975950293957318_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I99I4XMsfHIQ7kNvwHZY7bD&_nc_oc=AdpFE4pOxZ0M3uURl8wx2WxQ8rQF2u4nqR-CikXDj0oWmOo69LtMYvBBO80t_uLbOI8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVg6Im6fuN2xpfMnpb7giFqs2jC1N7_vFxjEhaTaLoZeA&oe=6B0EF403"}, "display_name": "MissionSpace", "keywords": [], "long_description": "Mission Space invites you to explore the vast beauty of our solar system like never before.\n\nExperience each planet up close in full 3D and stunning virtual reality. Hold, rotate, and inspect planets to uncover their unique details and learn fascinating facts about our cosmic neighborhood.\n\nWhether you're a student, educator, or space enthusiast, Mission Space offers an immersive and interactive way to understand the wonders of our universe.\n\n\ud83c\udf0d Explore all major planets\n\ud83e\ude90 Interact with realistic models in VR\n\u2600\ufe0f Learn about size, orbit, and distance\n\ud83d\ude80 Enjoy a calm and educational space experience\n\nStep into the universe and discover the solar system from a whole new perspective!", "short_description": "\"Explore and interact with planets in a stunning VR solar system.\"\n\n\"Discover the wonders of our solar system in immersive VR.\"\n\n\"Hold, observe, and explore planets across the solar system.\"\n\n\"A hands-on VR journey through the planets of our solar system.\"\n\n\"Experience space like never before \u2014 explore every planet in VR.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dodsgame.com/gizlilik-politikasi", "developer_terms_of_service_url": "https://www.dodsgame.com/hizmet-kosullari", "publisher_name": "DODs Game", "support_website_url": "https://www.dodsgame.com/gizlilik-politikasi", "website_url": "http://www.dodsgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24633222573026407"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1123047043295608"}]}, "baseline_offer": {"id": "1123047043295608"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1761380820, "status": "PUBLISHED", "id": "1123047043295608"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24633272073021457", "version": "4.0"}, "id": "1816484962292959", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24288323560849645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id
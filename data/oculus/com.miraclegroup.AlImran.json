eVTIkIFV4Q7kNvwFScLJz&_nc_oc=AdrodfdM5yLmnNpO8-KO_wpVWhZfMFtNsTiRKyZIYnBjPlhs0e1VC8MpthPbRc65vBY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3G_cUd2iaxY_5M5fpDapZi7I4hypboKqdg7OJ2QfTeBw&oe=69DB86E8"}, {"file_name": "ss 1.png", "id": "3077601552424868", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820887_3077601555758201_6450698821271420659_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFF86oXlVsQQ7kNvwEY-gye&_nc_oc=Adp3Hu_uHYT1G8LpHPh27jh7B_iShY_YCuXupGjVlojy5hICh3xXqBzzL1TyCStKyas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3b-1zavlsM-EEzHmWTckwoZHr8Vx9tqiU67f6nc0WAQg&oe=69DBAECA"}, {"file_name": "ss 4.png", "id": "2102489567266718", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821796_2102489570600051_5649877386711269915_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrCoF_dyTcgQ7kNvwFsDLdh&_nc_oc=AdrtngNrpuVGMCYOBuw7PAuDo8XGyYpRAp8dxQplJ6zZjmHTp6f4olyC9iu8VPEskIE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mbi_bK-We_LzlDJTTZzZMcJDQvrlJwbCAQ805oQhkmQ&oe=69DB98B5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah AlImran", "keywords": ["quran", "education", "surah"], "long_description": "Surah Al-Imran \u2013 VR Experience\n\nDive into the recitation of Surah Al-Imran, the third chapter of the Holy Quran, with an immersive virtual reality experience designed exclusively for Meta Quest.\n\nThis VR app provides a calm and distraction-free environment where you can listen, reflect, and connect deeply with the teachings of Surah Al-Imran. High-quality audio and smooth navigation between verses make your spiritual journey comfortable and meaningful.\n\nSurah Al-Imran focuses on faith, patience, guidance, and unity among believers. It offers essential lessons on devotion, moral conduct, and understanding Allah\u2019s signs, making it a comprehensive guide for personal and community life.\n\nFeatures:\nComplete recitation of Surah Al-Imran\nHigh-quality, clear audio for uninterrupted listening\nImmersive VR environment for focus and reflection\nEasy navigation between verses\nSmooth and optimized performance on Meta Quest\n\nPerfect for daily recitation, memorization, or reflection, this VR experience brings the Quran to life in a modern, engaging way, enhancing your connection with your faith.", "short_description": "We are excited to add Surah Al-Imran to our VR Quran app.\nListen, reflect, and immerse yourself in the complete recitation in a peaceful virtual environment. Improved audio clarity and smooth verse navigation make your spiritual journey in VR even more engaging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26631060903157837"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819281_1476152957367813_5482890587888869120_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwf4ia4Hsu0Q7kNvwGM5YtM&_nc_oc=Ado1dRBRVGIgxLbj43sYCOm45rsBGsPfkwDN928EXVFNfXks7orkhD61FYcpvNZVKYw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=
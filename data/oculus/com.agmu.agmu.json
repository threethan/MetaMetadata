uscdn.com&_nc_ss=7f20f&oh=00_AQR0jfgnEp1xO64FmurKCahRJ2tWmHqF7ISNaWlDBoIrlg&oe=6B0470C4"}, {"file_name": "migrated_image.png", "id": "232188734631759", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162754_375660682908191_6205559037786849280_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpH7cyZ17rMQ7kNvwHlm2Tn&_nc_oc=AdrBu_xkotho5AiACojCIUiYA0dnpiuR1tRJ1Yvtxw4y-GiES3ZJWeWgiZ05Y7yne4k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0Kkto14Xli3ycTmEiE1l_AnGKlYDffhy-sHWLlRU1vw&oe=6B046D42"}, {"file_name": "migrated_image.png", "id": "2554248178163223", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12482255_1565852860194930_6261267864582356992_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNw8WDZaB7sQ7kNvwGyRPwW&_nc_oc=AdokkhPCWdFsoR5DCL8UNt9-9NKLsWljBtL4_1DR4OyCUBpO9ZHvdkTgKuJUNsja9z4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTz5fskuf_jJkzom_vOxw0quaLc5iMx8UTGkOlRUMRLxg&oe=6B046040"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "agmu", "keywords": [], "long_description": "AGMU is a platform for Architects, Interior Designers and creative designers to transform their creativity into an immersive experience and communicate their designs with their clients and partners.  AGMU bridge the communication in Design, Architectural and construction industry more meaningful, detailed, and moreover convenient. With the combination of the cutting edge mobile app AGMU and skillful 3D Visualizers at AGMU, we take clients to the Architects imaginary world to see what is going to be created. Allows architects to communicate their ideas and vision throughout the project, which will minimize design alterations, saving time and money for all stakeholders involved in the project including Architects, Contractors and client.", "short_description": "AGMU\u00ae opens the door to the world of Virtual Reality for Architectural & Interior Design, Real Estate, Construction and Leisure industries. We have simplified the technology in a way that everyone can use VR to enhance their business with AGMU. We are geared to provide high quality, quick turnaround and cost effective VR solutions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aagmu.com/doc/Privacy_Policy.pdf", "developer_terms_of_service_url": "https://www.aagmu.com/doc/Agmu_Terms_of_Service.pdf", "publisher_name": "AGMU Technology Corporation", "support_website_url": null, "website_url": "https://aagmu.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3086108821607791"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1715514705234514", "version": "1.2"}, "id": "150135015776744", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1480576368728350", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1715514705234514"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "150135015776744"}]}, "change_log": "* UI Enhancements.\r\n* Public proje
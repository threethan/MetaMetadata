r Design, Real Estate, Construction and Leisure industries. We have simplified the technology in a way that everyone can use VR to enhance their business with AGMU. We are geared to provide high quality, quick turnaround and cost effective VR solutions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aagmu.com/doc/Privacy_Policy.pdf", "developer_terms_of_service_url": "https://www.aagmu.com/doc/Agmu_Terms_of_Service.pdf", "publisher_name": "AGMU Technology Corporation", "support_website_url": null, "website_url": "https://aagmu.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3086108821607791"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1715514705234514", "version": "1.2"}, "id": "150135015776744", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1480576368728350", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1715514705234514"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "150135015776744"}]}, "change_log": "* UI Enhancements.\r\n* Public proje
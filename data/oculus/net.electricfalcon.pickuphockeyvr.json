Upw&oe=69F0A2E7"}, "display_name": "Pick-up League Hockey", "keywords": ["hockey", "sports", "coop", "multiplayer", "simulation"], "long_description": "Pick-up League Hockey is a full-featured multiplayer hockey game using realistic physics and motion controls to create an immersive game that puts you right in the rink with up to 5 other friends! Created by a hockey enthusiast, PULH aims to be the most customizable multiplayer hockey game in VR with plans for player-selectable jerseys, stick skins, and more!\n\nCross-region and cross-platform play is supported!\n\nJoin us on discord for news, tournaments and more!\nhttp://www.electricfalcon.net/discord", "short_description": "Pick-up League Hockey is a full-featured multiplayer hockey game using realistic physics and motion controls to create an immersive game that puts you right in the rink with up to 5 other friends!"}]}, "developer_name": "Electric Falcon LLC", "developer_privacy_policy_url": "https://electricfalcon.net/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Electric Falcon LLC", "support_website_url": "http://www.electricfalcon.net/discord", "website_url": "http://www.electricfalcon.net/pickuphockey", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "477159150697506"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974480_367728323959939_83147340986523320
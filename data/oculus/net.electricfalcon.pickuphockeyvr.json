4615_375183953038385_8320732724855832576_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOCP4jUyPwcQ7kNvwFQWEXt&_nc_oc=AdrulX1TULYfIAgxqKxCBG-niiA2XFGqLvhsn87WjG6U6mIgctBOEePjf1EJCrOIqOQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzZ2AFrTrvo02twx9j1V7aByvrWNOukhZ7lrrfMUQ1iA&oe=6A8D9332"}, {"file_name": "migrated_image.png", "id": "142462683828426", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974623_489765921427805_7380152483512844288_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01eHaOtjHt0Q7kNvwHl4vAe&_nc_oc=AdqWNmapoPs3-4u-4wnCOyqCqZjHBs64idteVFE3YSFMTuKlRM4Trc0tAUNS7ymOx1o&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEggpwrG8_mA4EARNsELw78E4fx2obt5GP2MrVIT3IByw&oe=6A8D65DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/DgL0O0", "id": "468620766999877", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974826_468620770333210_1992676753021075456_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gehzCWANxO8Q7kNvwESOA5R&_nc_oc=AdrGTN7wPRr7Bazmr7LYfZQ_AWnCjPg-MIshRvkzei3B1mtd7zuOMGKhn60tEKfYD7g&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAihE-cliYRsjdStU0LZUYXCoR7lhfTRwYgJcEmP2Gcw&oe=6A8D6BFF"}, "display_name": "Pick-up League Hockey", "keywords": ["hockey", "sports", "coop", "multiplayer"], "long_description": "Pick-up League Hockey is a full-featured multiplayer hockey game using realistic physics and motion controls to create an immersive game that puts you right in the rink with up to 5 other friends! Created by a hockey enthusiast, PULH aims to be the most customizable multiplayer hockey game in VR with plans for player-selectable jerseys, stick skins, and more!\n\nCross-play between Rift and Go is possible!\nCross-region play is possible!\n\nDedicated server executables will be available for private clubs to host practices and tournament games. Please contact us for more info!\n\nPlease send feedback to contact@electricfalcon.net
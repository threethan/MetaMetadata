ultiplayer"], "long_description": "Pick-up League Hockey is a full-featured multiplayer hockey game using realistic physics and motion controls to create an immersive game that puts you right in the rink with up to 5 other friends! Created by a hockey enthusiast, PULH aims to be the most customizable multiplayer hockey game in VR with plans for player-selectable jerseys, stick skins, and more!\n\nCross-play between Rift and Go is possible!\nCross-region play is possible!\n\nDedicated server executables will be available for private clubs to host practices and tournament games. Please contact us for more info!\n\nPlease send feedback to contact@electricfalcon.net", "short_description": "Pick-up League Hockey is a full-featured multiplayer hockey game using realistic physics and motion controls to create an immersive game that puts you right in the rink with up to 5 other friends!"}]}, "developer_name": "Electric Falcon LLC", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Electric Falcon LLC", "support_website_url": null, "website_url": "http://www.electricfalcon.net/pickuphockey", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1065473254013914"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "288366558516728"}]}, "baseline_offer": {"id": "288366558516728"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 15493896
038385_8320732724855832576_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RC2qOBPXkasQ7kNvwGcqdF5&_nc_oc=Adr6fb1OJ0o2Nk840RPpL_9YIdy4VaKxhziSzOM-WMrL_qDjZqG0qhsVrkyxt-yXZZo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jNxrrrAn-wkdHrEp8cEOeYa9aYwf5CkiYWx1y2lXQAw&oe=6A393332"}, {"file_name": "migrated_image.png", "id": "142462683828426", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974623_489765921427805_7380152483512844288_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emnKnYMw4GMQ7kNvwFUDSzk&_nc_oc=AdoFaIah9K3H3nLkR9yna7CFdLyeHl_Pe92W34dvN_1sXqeQaUzYYZa5gdEFIquds8c&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-o6v-3rEfp852w4RePBAci8AfYZWHdTZ6VT1aylBTHpQ&oe=6A393E1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/DgL0O0", "id": "468620766999877", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974826_468620770333210_1992676753021075456_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxqB4VF22pMQ7kNvwE7IXow&_nc_oc=Adpaj1SKJT1fRSFDr-KMP8ppWFryCA7lKzw0NHVAHVxNjVpLNccgn5XR8SByraQiPIM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jmJ2xCcfHp-9vwkAVN3t7zJ0pLI68IyGp6jbQxkigVA&oe=6A39443F"}, "display_name": "Pick-up League Hockey", "keywords": ["hockey", "sports", "coop", "multiplayer"], "long_description": "Pick-up League Hockey is a full-featured multiplayer hockey game using realistic physics and motion controls to create an immersive game that puts you right in the rink with up to 5 other friends! Created by a hockey enthusiast, PULH aims to be the most customizable multiplayer hockey game in VR with plans for player-selectable jerseys, stick skins, and more!\n\nCross-play between Rift and Go is possible!\nCross-region play is possible!\n\nDedicated server executables will be available for private clubs to host practices and tournament games. Please contact us for more info!\n\nPlease send feedback to contact@electricfalcon.net", "short_descri
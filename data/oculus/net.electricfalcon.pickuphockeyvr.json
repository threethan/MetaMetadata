4615_375183953038385_8320732724855832576_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5zShBp0lCkQ7kNvwFxnZYc&_nc_oc=AdoP-jPQAv_7rDPNbBvpv4CicTGRjw9Em9lhSKOekO9SX9ST8I7Fsibhvu0dW7NHgvA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbL7bmiIr9bot5MCu8aOf-rVoDSfSgDHuRqPE8JfwRlA&oe=6A8EE4B2"}, {"file_name": "migrated_image.png", "id": "142462683828426", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974623_489765921427805_7380152483512844288_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_19JWfcH4PEQ7kNvwEQFBW1&_nc_oc=AdoM_GoFbeT2-Fwb2cRwr1oSa2jbLmPPzOAhGSJAX5Nhd_E3QwmmQntDuxJ4u5G6Fys&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzWtjjQOOHNuY0KaZC27A9P79DFGou2SiwB6ydmfzoEQ&oe=6A8EEF9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/DgL0O0", "id": "468620766999877", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974826_468620770333210_1992676753021075456_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gehzCWANxO8Q7kNvwFw2wpm&_nc_oc=Adqn-vGaNpxJIkk9K5m4vXJFM9pmL2U_dpRzeoRgLRCDVI3UM-1FoxYN3C9vcPVh11Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQMFD1a8QHauul25ahymig95vfuqU0aqD4IEdquZQESw&oe=6A8EF5BF"}, "display_name": "Pick-up League Hockey", "keywords": ["hockey", "sports", "coop", "multiplayer"], "long_description": "Pick-up League Hockey is a full-featured multiplayer hockey game using realistic physics and motion controls to create an immersive game that puts you right in the rink with up to 5 other friends! Created by a hockey enthusiast, PULH aims to be the most customizable multiplayer hockey game in VR with plans for player-selectable jerseys, stick skins, and more!\n\nCross-play between Rift and Go is possible!\nCross-region play is possible!\n\nDedicated server executables will be available for private clubs to host practices and tournament games. Please contact us for more info!\n\nPlease send feedback to contact@electricfalcon.net
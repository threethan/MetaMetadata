724855832576_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvO3pWeA4e0Q7kNvwHbabX-&_nc_oc=Ado1aeK97P0Hcihd6ko1VtGudShwwNoCY4tlvId_KRwZkjCA5MkRvYSSB414KZux6NU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXZFxNZiCEH6JSOJJzm50OmyZur25USVkLTXdudT5lyA&oe=6AA7F132"}, {"file_name": "migrated_image.png", "id": "142462683828426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974623_489765921427805_7380152483512844288_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PyhIyfqH05cQ7kNvwEqKoXV&_nc_oc=AdoAzoI2RPwVoE_FA6t_IAi8_qGkWXTUFILpyagbKBa8dmmLoYe2_tW8lG5oaCBwuhQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOmEun4pcmj0P8zr73NxF-EI7cP6KcjexMTM1BQoQXjQ&oe=6AA7FC1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/DgL0O0", "id": "468620766999877", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974826_468620770333210_1992676753021075456_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSQrg4tsyAsQ7kNvwH6ue4B&_nc_oc=Adq_PuODHcXPHhXUjdi7b5YyDRbwnMwMaSSMf-inRCZkclWzYuBOnrrrWrjLq8T5Kzg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkEia92gTOG-fB_TQZhxFhgfCLQKestrkfQ3qFqvrZcw&oe=6AA8023F"}, "display_name": "Pick-up League Hockey", "keywords": ["hockey", "sports", "coop", "multiplayer"], "long_description": "Pick-up League Hockey is a full-featured multiplayer hockey game using realistic physics and motion controls to create an immersive game that puts you right in the rink with up to 5 other friends! Created by a hockey enthusiast, PULH aims to be the most customizable multiplayer hockey game in VR with plans for player-selectable jerseys, stick skins, and more!\n\nCross-play between Rift and Go is possible!\nCross-region play is possible!\n\nDedicated server executables will be available for private clubs to host practices and tournament games. Please contact us for more info!\n\nPlease send feedback to contact@electricfalcon.net", "short_description": "Pick-up League Hockey is a full-featured multiplayer hockey game using realistic physics and motion controls to create an immersive game that puts you right in the rink with up to 5 other friends!"}]}, "developer_name": "Electric Falcon LLC", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Electric Falcon LLC", "support_website_url": null, "website_url": "http://www.electricfalcon.net/pickuphockey", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1065473254013914"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "288366558516728"}]}, "baseline_offer": {"id": "288366558516728"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1549389600, "status": "PUBLISHED", "id": "288366558516728"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2864205346962324", "version": "1.21.05"}, "id": "258507844852368", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1834306356618900", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2864205346962324"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "258507
5771-25/491823341_1538874780862289_3770199498431827908_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mSSLIw618wQ7kNvwFenw56&_nc_oc=AdoV78JN9d-LBWCtumTKQ2mSz2RuKJ5JL17Exk-oUWqTvsed66t6sa1XK3M9zvszzcs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEP4pZFhuXY7y8Xvkdw5roohR32agbqE_KKIcgj9rO43A&oe=6A8D86BF"}, {"file_name": "05_Transforms_Translation_2560x1440.png", "id": "2512916852561244", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491823812_2512916855894577_261210405095754400_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pS4sHMZZYc4Q7kNvwFzKRk4&_nc_oc=AdrxZVJAMvUTXkScq4b_OnhNrF0I_mMXwwzlzbkustb9hqE5J_E3mHDHKrpoBalTeOA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdnNeo50YFuoVeZJPspUhg-_Z2dExW8a8fb83XvquePw&oe=6A8D84C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GeometryVRLab_Cover.png", "id": "1602146794663631", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823790_1602146804663630_4998081274171704676_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwGi4urV8GoQ7kNvwFRoVCS&_nc_oc=Adqh5hXpqpYUM1Bl8AJ0vxg9iu9weV-R1xTlQVhud9GHcvdlFYSpBsFzrCwM38Dncqw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgRJZBObVoqFo4sIyMxko5AGlOPN7u4HGRYP6cgZojoA&oe=6A8D989B"}, "display_name": "Geometry VR Lab", "keywords": ["geometry", "mathematics", "education", "ArabicLearning", "3Dshapes"], "long_description": "Geometry VR Lab is a free educational virtual reality experience designed to help secondary-school students understand spatial geometry through direct interaction.\n\nBegin with a guided onboarding stage to learn movement, object grabbing, manipulation, and the use of VR controls. Then enter the solids laboratory to explore the cube, sphere, and cylinder in three dimensions.\n\nStudents can select, rotate, move, and reset solids while examining their faces, edges, and vertices. Visual guides, labels, educational panels, and Arabic voice instructions provide clear guidance throughout the learning experience.\n\nThe application is designed for classroom use and independent learning. Its purpose is to support meaningful mathematics learning through exploration and interaction\u2014not simply entertainment.\n\nNo account, login, subscription, in-app purchase, or test credentials are required.\n", "short_description": "Explore spatial geometry in immersive VR. Manipulate 3D solids, examine faces, edges, and vertices, and follow Arabic voice guidance designed for secondary-school learners."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zuhdizahdeh.github.io/math-apps/geometry-vr-lab/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ibrahimieh College", "support_website_url": null, "website_url": "https://zuhdizahdeh.github.io/math-apps/geometry-vr-lab/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1322183927634019"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823783_1043395958475937_4968751636630538675_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usO9ddyZ-sgQ7kNvwGGPu5W&_nc_oc=AdpYLj6M6JaHYbcrPtIUJeCiC1GM4Re-wMxUXyWp5S8hWIjF-DAeN7onGH1iC4BUl8s&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERN-6BkDeYWUUVOXYKMaB4w2NyNi36ZzjC2oUkTQUV6w&oe=6A8D93E7"}, "is_concep
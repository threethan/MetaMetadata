_1538874780862289_3770199498431827908_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3xFjyn7Sk8Q7kNvwGMt_3j&_nc_oc=AdoWQC0UKdbRK8otcIa3KSlJvRCByN_q-1gzPbLMokGjbhsESTLJMWpznu3gDshnQlo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGH-LZupAG4IJlFegIlvpoGMBYqxAFicMQ_K-X7Qlev5w&oe=6A9029BF"}, {"file_name": "05_Transforms_Translation_2560x1440.png", "id": "2512916852561244", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823812_2512916855894577_261210405095754400_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOGP2oJOWtsQ7kNvwEqSaAg&_nc_oc=AdqrlZhppLKmn-WhClQT1tOjLHk0MDBlhQcIvCDX_QOMRU58O8LjSHXlKPG4o5QJQXA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAsXOzqr3qQbJcQplwHRgcfT4F3z0A21EK8R0m-cgSXQ&oe=6A9027C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GeometryVRLab_Cover.png", "id": "1602146794663631", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823790_1602146804663630_4998081274171704676_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u31fL8IRYvoQ7kNvwGoZoZr&_nc_oc=Ado2vBv1sV2jr3x8bnAnt9qCKpK1CnfXTKF36vR1tecbSrwZQUn5u77bHFhCYvEf59c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENMQPyftCXTLDZuIw5v_mMf7PRWBbS29UnEHOfKxCcuw&oe=6A903B9B"}, "display_name": "Geometry VR Lab", "keywords": ["geometry", "mathematics", "education", "ArabicLearning", "3Dshapes"], "long_description": "Geometry VR Lab is a free educational virtual reality experience designed to help secondary-school students understand spatial geometry through direct interaction.\n\nBegin with a guided onboarding stage to learn movement, object grabbing, manipulation, and the use of VR controls. Then enter the solids laboratory to explore the cube, sphere, and cylinder in three dimensions.\n\nStudents can select, rotate, move, and reset solids while examining their faces, edges, and vertices. Visual guides, labels, educational panels, and Arabic voice instructions provide clear guidance throughout the learning experience.\n\nThe application is designed for classroom use and independent learning. Its purpose is to support meaningful mathematics learning through exploration and interaction\u2014not simply entertainment.\n\nNo account, login, subscription, in-app purchase, or test credentials are required.\n", "short_description": "Explore spatial geometry in immersive VR. Manipulate 3D solids, examine faces, edges, and vertices, and follow Arabic voice guidance designed for secondary-school learners."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zuhdizahdeh.github.io/math-apps/geometry-vr-lab/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ibrahimieh College", "support_website_url": null, "website_url": "https://zuhdizahdeh.github.io/math-apps/geometry-vr-lab/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1322183927634019"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823783_1043395958475937_4968751636630538675_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xA4_Y79EVBMQ7kNvwFkMAf5&_nc_oc=Adrci9hrfoI2DQ1qRSPVQHdWdaCMheKdkb3PYjKVfaJOsvHGUZPnBlBl18Gjrzk2RgY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaxd2_70QBFeJARK9SysQmJ8yACmqepMIhv1L3cbklpg&oe=6A9036E7"}, "is_concept": false, "is_test": 
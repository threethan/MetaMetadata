_2055114245192511_4009246431335829510_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IT6WudbbESAQ7kNvwFreJWm&_nc_oc=Adqpq8jzgXGlu0opdYy8KCAH3Ob60IsB9rMsspd1talZTvic-emTMOps9tJ0Cks72fU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5x6yTzKFn18tfnK4Rmik5B0pEyseoktc8vKQXmRiB1A&oe=6AF5D199"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GeometryVRLab_Cover.png", "id": "1602146794663631", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_1602146804663630_4998081274171704676_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_aa0BELbM8Q7kNvwGWD5yP&_nc_oc=AdpjnEVUfbNrXdyLbSStzkyaPOorZ--WULHZWgd72llL-gY4H2bmpmxBmozr3BNkZZo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTWsctxbsTy4MLPcc8sqUYCkxdnsngQJC-fqng5yzbfw&oe=6AF5BF1B"}, "display_name": "Geometry VR Lab", "keywords": ["geometry", "mathematics", "education", "ArabicLearning", "3Dshapes"], "long_description": "Learn geometry through observation and hands-on exploration in Geometry VR Lab. Discover three-dimensional solids, experiment with geometric transformations, and predict the shapes formed when a plane intersects a solid.\n\nSwitch between Arabic and English interfaces and on-screen instructions, including controls, explanations and activity feedback.\n\n\u2022 Discover solids: hold a cube, cylinder and sphere, explore their faces, edges, vertices or curved surfaces, complete property tasks, and place each solid in its matching recess.\n\u2022 Explore transformations: try translation, rotation, reflection, scaling and shear. Choose an axis and value, then observe the result with visual guides, replay and reset controls.\n\u2022 Transformation challenges: follow guided steps to combine transformations and work toward a target.\n\u2022 Investigate cross sections: select a cube, cylinder or cone and explore horizontal, vertical and inclined plane presets. Predict the section, then compare it with the highlighted intersection and its copy on the result platform.\n\u2022 Flexible learning: consult explanations and hints, and adjust panel height for seated or standing use.\n\nDesigned to support geometry exploration and practice in classroom activities and individual learning.", "short_description": "Explore solids, transformations and cross sections in an interactive VR geometry lab with Arabic and English interfaces and on-screen instructions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zuhdizahdeh.github.io/math-apps/geometry-vr-lab/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ibrahimieh College", "support_website_url": null, "website_url": "https://zuhdizahdeh.github.io/math-apps/geometry-vr-lab/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1499397459912664"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823296_1311919707534563_2552724461570715864_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMlTFu1u-NkQ7kNvwFcNgid&_nc_oc=AdrXDxM9m3VEuxb8wZHYurc1g849AHR2fuYGzq2JuYvFmfXfkng6DHZxLs-oycsuG4M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7MT51tV04bRq1IOvHOINc1wxzklKNMoV6R9knbuYJ3Q&oe=6AF5CF9F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Geometry VR Lab", "platform": "ANDROID_6DOF", "
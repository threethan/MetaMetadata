296687367255235103_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1TV9k2slMIQ7kNvwGbGATI&_nc_oc=AdrcYO7TAV7NW9fDXnbeFcWjWprP3GqzUMM_k_gRtCG_BDZNPGyzSoIeNzw0wtQCmpI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2DAJ0AoY3MJjoZBv5cWdBAGqfwTnl80UqLXGurFxJpg&oe=6AEA0ADA"}, {"file_name": "05-cross-section-square.png", "id": "964176813374982", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825415_964176816708315_7531669188458240236_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNqONO1bUA4Q7kNvwEMJ3rd&_nc_oc=AdoVw00rP4cJMLRHtyhSCQlai0QqbZX2pVcoh_zWs4SHVckLZwA3ozkRn5UYHXH0uvA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0xYLP8dzrc0o21NbvtW50AZwLnzhWsypRIYxY7YZOcA&oe=6AE9DEF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GeometryVRLab_Cover.png", "id": "1602146794663631", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_1602146804663630_4998081274171704676_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaPCzF7cXOIQ7kNvwGCyUNr&_nc_oc=Adr5d47Ld3wJH2SJloomCPr24fijVNx2mmGsicE7mD7jQIQ7dWCGsMekBAxHaSBgrOA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3QlxI86snsVS6RqfKYn4Ev1Vw5PgllMSkWHTPfDUEVw&oe=6AE9E19B"}, "display_name": "Geometry VR Lab", "keywords": ["geometry", "mathematics", "education", "ArabicLearning", "3Dshapes"], "long_description": "Geometry VR Lab is a free educational virtual reality experience designed to help secondary-school students understand spatial geometry through direct interaction.\n\nBegin with a guided onboarding stage to learn movement, object grabbing, manipulation, and the use of VR controls. Continue to the 3D Solids Lab to explore the cube, sphere, and cylinder, including their faces, edges, vertices, and curved surfaces.\n\nIn the Transformations Lab, investigate translation, rotation, reflection, scaling, and shear along the X, Y, and Z axes while comparing the original solid with the transformed result.\n\nThe Cross-Sections Lab connects three-dimensional objects with two-dimensional shapes. Select a cube, cylinder, or cone; choose a horizontal, vertical, or diagonal cutting plane; then observe results such as circles, squares, rectangles, triangles, ellipses, parabolas, and hyperbolas.\n\nA dedicated Learning Center reinforces each concept using concise explanations, Arabic voice guidance, visual aids, and interactive challenges. Students can repeat activities, reset objects, and explore at their own pace.\n\nDesigned for educational use in classrooms and independent learning. No login, account, or internet connection is required.", "short_description": "Explore spatial geometry in immersive VR. Manipulate 3D solids, apply geometric transformations, investigate cross-sections, and learn through guided Arabic narration."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zuhdizahdeh.github.io/math-apps/geometry-vr-lab/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ibrahimieh College", "support_website_url": null, "website_url": "https://zuhdizahdeh.github.io/math-apps/geometry-vr-lab/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1451097611409316"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823296_1311919707534563_2552724461570715864_n.png?stp=dst-png_s360x3
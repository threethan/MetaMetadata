ents\n\u2022 Evaluate turbine performance and efficiency\n\u2022 Identify common issues and learn basic troubleshooting steps\n\nThis VR experience is part of VEROlabs, an all-in-One platform that transforms education and training through immersive Virtual Reality (VR) experiences, students and educators can explore and run VR experiments across different disciplines.", "short_description": "Explore how wind energy works through an interactive VR learning experience by VEROlabs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vero-as.com/verolabsprivacypolicy.htm", "developer_terms_of_service_url": null, "publisher_name": "VERO", "support_website_url": null, "website_url": "https://www.vero-as.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25109937322026716"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "861043539586691"}]}, "baseline_offer": {"id": "861043539586691"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768346640, "status": "PUBLISHED", "id": "861043539586691"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27117212711299157", "version": "17"}, "id": "1508287920427789", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "And
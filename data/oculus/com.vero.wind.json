12277564_4143204701579850138_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkXNziiLZbwQ7kNvwFghF92&_nc_oc=AdpEyd8l0zcOzweYjIevYdcU8KSwnO69l8LLVhsyHW6HIIIbJTTv44d3waaaECkraAo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DwYaHZoM67tVgR2oYeqibkcPVUJ4IqIk0q-ARSYzVWQ&oe=6A19A79D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VEROlabs Wind Turbines", "keywords": ["engineering", "education", "STEM", "wind", "mechanical"], "long_description": "Get ready for an exciting journey into the world of renewable energy! Put on your headset and explore up close how wind is transformed into electrical power that drives our modern world. \n\nIn this interactive VR experience, you will be able to:\n\u2022 Recognize typical wind turbine components\n\u2022 Collect basic turbine measurements\n\u2022 Evaluate turbine performance and efficiency\n\u2022 Identify common issues and learn basic troubleshooting steps\n\nThis VR experience is part of VEROlabs, an all-in-One platform that transforms education and training through immersive Virtual Reality (VR) experiences, students and educators can explore and run VR experiments across different disciplines.", "short_description": "Explore how wind energy works through an interactive VR learning experience by VEROlabs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vero-as.com/verolabsprivacypolicy.htm", "developer_terms_of_service_url": null, "publisher_name": "VERO", "support_website_url": null, "website_url": "https://www.vero-as.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_
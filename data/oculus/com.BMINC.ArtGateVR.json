115853549568_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7T7PV9F5zQcQ7kNvwGptGtb&_nc_oc=AdnfKkm8iLQU9G2CXoFaxRKm3FtOX1X0XLRZ8P2DsL3ss_HtP4QJJd0rdAiJPhFR6JU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afvo4-8BS-FvUYgGq4TZKJskN7sIfUxW_w44KzaOPkyXkA&oe=69984BB4"}, {"file_name": "migrated_image.png", "id": "839090849902767", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974892_343959929657327_7569834332546662400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glJV1DZAq9cQ7kNvwGnK6WN&_nc_oc=AdkGgw7JRvMyzGoSh5t4Y5DOFtE_SIpVQDGKF_UyNFzozjUvI7uhdkAEe_u71zOUhAQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvTMMxo5fjTFw7N6hkWP_po_zXaTBkmYri-GkHFlIlxVw&oe=699843BB"}, {"file_name": "migrated_image.png", "id": "790952711392118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982626_999921863547072_7311913239955111936_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlpQJ0Rpc-IQ7kNvwHhkQnh&_nc_oc=AdnLlgvleB5oerdPiY-p_lDP93W48m_y0RGXdZlk6p4P04tttjGtN48X9tCICXYhmG4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afs5F0DzJTe6f53ijwzrmcBerupMceZ2wCX34Vmy8hEn1g&oe=699844F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art Gate", "keywords": ["Art", "Gallery", "Museum", "Social", "Collector"], "long_description": "Jump into an art opening through the hyper social VR world of Art Gate. 100 people can simultaneously visit a gallery, exhibition tour, or artist talk. If you see an artwork you feel would be a nice addition to your collection you can buy the piece from within your VR headset. Art Gate is a virtual reality marketplace for collectors to acquire Post-War and Contemporary Art. Real artwork and real people from around the globe connect in this virtual world. Pop on your headset and start rubbing shoulders with the innovators of the art world in Art Gate VR. \n\n-Join social art events with up to 100 people\n-Buy and sell artwork\n-Connect with international artists, collectors, and galleries",
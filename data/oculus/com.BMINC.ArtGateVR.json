115853549568_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TqahDi6oXsQ7kNvwENKnN1&_nc_oc=AdkqAkTOwZiV14K9r6fgBKG6X-dyhFsEzTd045WRvp07XRWUJsr2YfGGUJOpfzs_ZBw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuvbEQyOXb8JD8gOFzq1NjDEuaN2BaB7_hCArD395Jwsg&oe=699D91B4"}, {"file_name": "migrated_image.png", "id": "839090849902767", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974892_343959929657327_7569834332546662400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdQ5UjzHjpUQ7kNvwES0aiP&_nc_oc=Adm6AAoZDYeSuNVNmiTy6s98zWmQKtmZTWdNNmBTy23JurEv11u3zk2LsKYfUjSo2vQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsY2vNoOWIJRGaXYOYw9SJj7aD6FUuE7HWpwW8T9UWucw&oe=699D89BB"}, {"file_name": "migrated_image.png", "id": "790952711392118", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982626_999921863547072_7311913239955111936_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mH20mD6wgX8Q7kNvwE6xXD1&_nc_oc=AdmxPlnbb65vkg3AtFtfeK0Se2FaOMic0W-PDibdZ_pFbe-xsjB4qE_90WwKYclSbrE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftotPLpqaVcj-2PeXzWQGfsKhtM53QUnK4fVEn3OcF9zA&oe=699D8AF1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art Gate", "keywords": ["Art", "Gallery", "Museum", "Social", "Collector"], "long_description": "Jump into an art opening through the hyper social VR world of Art Gate. 100 people can simultaneously visit a gallery, exhibition tour, or artist talk. If you see an artwork you feel would be a nice addition to your collection you can buy the piece from within your VR headset. Art Gate is a virtual reality marketplace for collectors to acquire Post-War and Contemporary Art. Real artwork and real people from around the globe connect in this virtual world. Pop on your headset and start rubbing shoulders with the innovators of the art world in Art Gate VR. \n\n-Join social art events with up to 100 people\n-Buy and sell artwork\n-Connect with international artists, collectors, and galleries",
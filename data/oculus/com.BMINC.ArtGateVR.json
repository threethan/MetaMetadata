d in Art Gate VR. \n\n-Join social art events with up to 100 people\n-Buy and sell artwork\n-Connect with international artists, collectors, and galleries", "short_description": "Art Gate is a virtual reality marketplace for collectors to acquire Post-War and Contemporary Art. \n\n-Join social art events with up to 100 people\n-Buy and sell artwork\n-Connect with international artists, collectors, and galleries"}]}, "developer_name": "Art Gate VR Inc.", "developer_privacy_policy_url": "https://artgatevr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.artgatevr.com/app/terms.php", "publisher_name": "Art Gate VR Inc.", "support_website_url": "http://artgatevr.com/", "website_url": "http://artgatevr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "2983294531814809"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974590_218037079233899_5239214649139789824_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyYvLWMz1AAQ7kNvwGnu0Tl&_nc_oc=AdoFcEh_745-EkO19dutG5de0-iNbHrsunqVphiXvqyi9PDzkscbIWaaKuKo4C3PbT0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ou4ODmRekJft3BfwTzc9FOz9IK6uQF5O3W3LPdmca1g&oe=6A0C6B32"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Art Gate", "platform": "ANDROID", "context_categ
_image.png", "id": "862477387497652", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001664_1879252988841773_3310546115853549568_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_E7GfyVGmbwQ7kNvwHJHreT&_nc_oc=AdqqxHb6FQdiMaJKcSq1NJF4E0G0rfYOgWgBI274VqQM8UWVWSHaHxxRTP8SHHvEn8E&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIHDc_c0i8ivRBNvw4ebqRJ6y2vBzT9vvQ0jQCJQ-6bg&oe=6A8ED434"}, {"file_name": "migrated_image.png", "id": "839090849902767", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974892_343959929657327_7569834332546662400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbIb1BaoDDUQ7kNvwGlLtLo&_nc_oc=Adr_5czebfFQgiVa82aOGToscuBJXQZXurf0H1ZdkWrvlLQTHuuKYM3TaKRjN-b69yg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFK9LHKJsfQB2XZedfzvrPAj5kxlwBAY5kEJNEBAwR0vw&oe=6A8ECC3B"}, {"file_name": "migrated_image.png", "id": "790952711392118", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982626_999921863547072_7311913239955111936_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pqkfrk5JjW4Q7kNvwHumXrN&_nc_oc=AdpY25QixCQ4pNhmhSYUF7xbRwpIx5FWXzNXzy9JrxxkgVwkKkZ7FjmJ-bd2wiYQnL0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFK-pOsvI2TW0BQTNSrRq_WPPHPp28bNWJco4zZnp90DA&oe=6A8ECD71"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art Gate", "keywords": ["Art", "Gallery", "Museum", "Social", "Collector"], "long_description": "Jump into an art opening through the hyper social VR world of Art Gate. 100 people can simultaneously visit a gallery, exhibition tour, or artist talk. If you see an artwork you feel would be a nice addition to your collection you can buy the piece from within your VR headset. Art Gate is a virtual reality marketplace for collectors to acquire Post-War and Contemporary Art. Real artwork and real people from around the globe connect in this virtual world. Pop on your headset and start rubbing shoulders with the innovators of the art world in Art Gate VR. \n\n-Join social art events with up to 100 people\n-Buy and sell artwork\n-Connect with international artists, collectors, and galleries", "short_description": "Art Gate is a virtual reality marketplace for collectors to acquire Post-War and Contemporary Art. \n\n-Join social art events with up to 100 people\n-Buy and sell artwork\n-Connect with international artists, collectors, and galleries"}]}, "developer_name": "Art Gate VR Inc.", "developer_privacy_policy_url": "https://artgatevr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.artgatevr.com/app/terms.php", "publisher_name": "Art Gate VR Inc.", "support_website_url": "http://artgatevr.com/", "website_url": "http://artgatevr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "2983294531814809"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974590_218037079233899_5239214649139789824_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kIrEH0VDpoQ7kNvwHkqad2&_nc_oc=AdrLQwhuDZ9lo0pAgH76vNizjJ_TjD4ECfBVNbVdy-QU9-LcJyKQ2_wMfMStS_Gq5WA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGggzG_DF8nWeZn8mfdTSmTKRSwIMV-JVKSeVVE1jT3w&oe=6A8EEFB2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Art Gate", "platform": "ANDR
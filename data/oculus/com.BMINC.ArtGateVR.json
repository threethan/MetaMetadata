_image.png", "id": "862477387497652", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001664_1879252988841773_3310546115853549568_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a__ACY6wZWwQ7kNvwG_5l_J&_nc_oc=AdqW7fckJX3m9CmMkrLXJJ3VQUbWPj6kmZ_wWFhV2xJvVfQrqmmsv4WibNF_a6N5Btc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGe8ytYJxCLWh5iSk4V-bocXKL3sCuyvmjAA62MXrs6_w&oe=6A8599B4"}, {"file_name": "migrated_image.png", "id": "839090849902767", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974892_343959929657327_7569834332546662400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6m67jqLz-UQ7kNvwGuvkf5&_nc_oc=AdpfhTT8SXhWiRFmrZ-mX3S6c8_Gku0OhI90HlP6GlLS9ZqTgqwr3KFcyWnARNCSjrQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFymrMXr2OBaElIJ4ihJrUAbJlO5cefTGnuII4ZxwqIOQ&oe=6A8591BB"}, {"file_name": "migrated_image.png", "id": "790952711392118", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982626_999921863547072_7311913239955111936_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t72nyG8m4-YQ7kNvwELJL2e&_nc_oc=AdpTdCYKYoVIYczY_ynegp2HMlRKLItDLH6apbfeTe2pcQmt0ejkwyIzHnCZ_vqB7DA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8w1MO_Yv-XMD9kISW0e6JOWa-eTEnDmqLCsfxDSvh3g&oe=6A8592F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art Gate", "keywords": ["Art", "Gallery", "Museum", "Social", "Collector"], "long_description": "Jump into an art opening through the hyper social VR world of Art Gate. 100 people can simultaneously visit a gallery, exhibition tour, or artist talk. If you see an artwork you feel would be a nice addition to your collection you can buy the piece from within your VR headset. Art Gate is a virtual reality marketplace for collectors to acquire Post-War and Contemporary Art. Real artwork and real people from around the globe connect in this virtual world. Pop on your headset and start rubbing shoulders with the innovators of the art world in Art Gate VR. \n\n-Join social art events with up to 100 people\n-Buy and sell artwork\n-Connect with international artists, collectors, and galleries", "short_description": "Art Gate is a virtual reality marketplace for collectors to acquire Post-War and Contemporary Art. \n\n-Join social art events with up to 100 people\n-Buy and sell artwork\n-Connect with international artists, collectors, and galleries"}]}, "developer_name": "Art Gate VR Inc.", "developer_privacy_policy_url": "https://artgatevr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.artgatevr.com/app/terms.php", "publisher_name": "Art Gate VR Inc.", "support_website_url": "http://artgatevr.com/", "website_url": "http://artgatevr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "2983294531814809"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974590_218037079233899_5239214649139789824_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSZkxaOqcX4Q7kNvwFvcuLy&_nc_oc=Adrto1r5WYVwF0K6q1sl_U9MFOpneKTkPaKaiyOtGv4tycFteT3d_Qi7sp_ZywzowVQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-KAVqSsFihkdBbHFN7SQGOOAJm4VQF_TK2jyYJr_HjA&oe=6A857CF2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Art Gate", "platform": "ANDR
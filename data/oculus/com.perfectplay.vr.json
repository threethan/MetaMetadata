CGeBshp4DJ4Zh78&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFmLhYX5a73DmTPkJmixdTXWs3pLUzJQAn8M-BnTa1RQ&oe=6AE20866"}, {"file_name": "02-album-REVISAR-conteudo.png", "id": "1817311635938025", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830904_1817311639271358_5117875908409932257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzZFh5XQtZ8Q7kNvwHFULFo&_nc_oc=Ado58cuqTpmXBb_CH833QWrIgHfM3T8aHxO2VwJDtPQUA3mvE3oI09lCb2olCmBLem0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfDWuuSk2VkGZ4DdantQ2rWDFTNhCpKQTo0k6uA7HwNw&oe=6AE1F411"}, {"file_name": "05-player-ambiente.png", "id": "2055765878463220", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673536876_2055765881796553_5847436137716175680_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnc-tXVKRRUQ7kNvwHhV7Pk&_nc_oc=AdoC9s_F39cwLRZkTHcp5xv0L666awCH8PBhGPdkaYZwFCW3gy113tOoForFCpNg6Hw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4xc9hWdxKCevs3mfQJPqSU83XfC0U1Ai3WoTFmLvGJA&oe=6AE1E6C0"}, {"file_name": "04-player-tela.png", "id": "1145412141347729", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604370996_1145412144681062_106989400978839567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNkhlKcr_akQ7kNvwHFmEzS&_nc_oc=Adrl0P4_29UyvGk4q_Ll99X7za6IbZxoZBjEsd733Is7Q94mTK-MtTebwqhyE8Ydw8k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSWm-sowubcZGoHmT9yanJPPIPUc5SfHpYs1K5-za6pA&oe=6AE1FD19"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PerfectPlay", "keywords": [], "long_description": "Bring your own media into a personal cinema with PerfectPlay.\n\nWatch videos on an adjustable virtual screen, or switch to mixed reality to enjoy them in your own space. Resize and reposition the screen for a comfortable viewing experience.\n\nYOUR MEDIA, YOUR WAY\nBrowse files on your headset or transfer media from a phone or computer through a web browser. Resume videos from where you stopped, and select available audio tracks and compatible subtitles.\n\nWATCH TOGETHER\nCreate a local session and connect another headset on the same Wi-Fi network. Synchronize video playback and choose whether your guest can control playback.\n\nPHOTO PRESENTATIONS\nOrganize photos into albums and enjoy smooth transitions in a 3D presentation. Move between photos manually or start an automatic slideshow with your own music.\n\nFLEXIBLE CONTROLS\nUse supported Touch controllers or hand tracking to interact with the app.\n\nPerfectPlay plays user-provided media and does not include movies, music, or a streaming subscription. Format and codec support depends on the file and headset capabilities. Photo album presentations are individual experiences and are not synchronized between headsets.", "short_description": "Your personal cinema in VR and mixed reality. Watch your own videos, enjoy photo slideshows with music, and watch videos together with another headset on the same Wi-Fi network. Transfer media from your phone or computer using a web browser."}]}, "developer_name": null, "developer_privacy_policy_url": "https://quintodeveloped.guilhermequinto-s97.chatgpt.site/perfectplay/privacidade/", "developer_terms_of_service_url": null, "publisher_name": "QuintoDeveloped", "support_website_url": "https://quintodeveloped.guilhermequinto-s97.chatgpt.site/perfectplay/suporte/", "website_url": "https://quintodeveloped.guilhermequinto-s97.chatgpt.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["pt_BR"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1291663277374329"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1083823137584349"}]}, "baseline_offer": {"id": "1083823137584349"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792004220, "status": "PUBLISHED", "id": "1083823137584349"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1281384461735544", "version": "0.4.7"}, "id": "1646209203804398", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1272032069337450", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1281384461735544"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1646209203804398"}]}, "change_log": null, "created_date": 1791407867, "id": "1281417098398947", "version": "0.4.8", "version_code": 14, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1272032069337450", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1281384461735544"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1646209203804398"}]}, "change_log": null, "created_date": 1791406013, "id": "1281384461735544", "version": "0.4.7", "version_code": 13, "release_status": "RELEASED", "status": "APPROVED", "binary_test_r
{"data": {"node": {"__typename": "Application", "id": "1272032069337450", "organization": {"id": "1072269122647080", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1272032069337450"}]}, "id": "1688511419275245"}]}}, "firstRevision": {"nodes": [{"application": {"id": "1272032069337450", "release_date": 1792004220, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1281384461735544"}, "id": "1646209203804398"}]}}, "binary": {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1272032069337450", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1281384461735544"}, "release_status": "RELEASED"}, "id": "1281384461735544", "version": "0.4.7", "version_code": 13, "release_status": "RELEASED", "status": "APPROVED"}, "live_binary": null, "created_date": 1790963645, "id": "1272032159337441", "is_initial_release": true, "name_with_fallback": "v1", "pdp_metadata_with_fallback": {"version": 1, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "1291663277374329"}, "release_status": "RELEASED", "id": "1272032069337450"}, "id": "1291663277374329", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": true, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1272032069337450", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "4074238796043292"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "29417631934488414", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PerfectPlay", "keywords": ["cinema", "player", "assistirjuntos", "galeria"], "long_description": "Transforme suas m\u00eddias em uma experi\u00eancia de cinema com o PerfectPlay.\n\nAssista a v\u00eddeos em uma tela virtual ajust\u00e1vel ou ative a realidade mista para assistir no ambiente da sua casa. Ajuste o tamanho e a posi\u00e7\u00e3o da tela para encontrar a experi\u00eancia mais confort\u00e1vel.\n\nSUAS M\u00cdDIAS, DO SEU JEITO\nProcure arquivos no headset ou envie m\u00eddias pelo navegador do celular ou computador. Continue v\u00eddeos de onde parou e selecione faixas de \u00e1udio dispon\u00edveis e legendas compat\u00edveis.\n\nASSISTA JUNTO\nCrie uma sess\u00e3o local e conecte outro headset na mesma rede Wi-Fi. Sincronize a reprodu\u00e7\u00e3o dos v\u00eddeos e escolha se o convidado pode controlar os comandos.\n\nAPRESENTA\u00c7\u00d5ES DE FOTOS\nOrganize fotos em \u00e1lbuns e aproveite transi\u00e7\u00f5es suaves em uma apresenta\u00e7\u00e3o 3D. Avance e volte manualmente ou inicie uma apresenta\u00e7\u00e3o autom\u00e1tica com suas m\u00fasicas.\n\nCONTROLES FLEX\u00cdVEIS\nInteraja usando controles Touch compat\u00edveis ou rastreamento das m\u00e3os.\n\nO PerfectPlay reproduz m\u00eddias fornecidas pelo usu\u00e1rio e n\u00e3o inclui filmes, m\u00fasicas ou assinatura de streaming. A compatibilidade com formatos e codecs depende do arquivo e dos recursos do headset. As apresenta\u00e7\u00f5es de \u00e1lbuns de fotos s\u00e3o individuais e n\u00e3o s\u00e3o sincronizadas entre headsets.", "short_description": "Seu cinema pessoal em VR e realidade mista. Assista aos seus v\u00eddeos, aproveite apresenta\u00e7\u00f5es de fotos com m\u00fasica e compartilhe a reprodu\u00e7\u00e3o de v\u00eddeos com outro headset na mesma rede Wi-Fi. Transfira suas m\u00eddias pelo navegador do celular ou computador."}, {"images": {"nodes": [{"file_name": "Imagem do ChatGPT 7 de out. de 2026, 03_08_03.png", "id": "2201135260819633", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673536876_2201135264152966_5733641697835351140_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMQ_3Y1iMOYQ7kNvwE4QFKD&_nc_oc=Ado8Xa6SxZSOCBzGTHMMz2A4PCAWepx_t_l7AvK-rOpoAOzuvEjdR_IyycvOyZy3cQU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO5T-N8FOrC5uug3uiO2_R5VUw8UV-7gUFyzPUJFZKVQ&oe=6AF33122"}, {"file_name": "Imagem do ChatGPT 7 de out. de 2026, 03_07_55.png", "id": "1816319766056305", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830904_1816319769389638_7884766354508195249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-adMZf1cfAQ7kNvwH6xjo6&_nc_oc=AdpDWWDYXERTnVpZ9Po_yR8RbVOrhjpneDHihW-iu4bNIH5zAa87BecRdxnZp4Dbyv8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSe5dNtCSgSSqpAlixi7IY2_wSaRr4xyl0ut1fS6ypkSQ&oe=6AF333D0"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1624147119212242", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830822_1624147122545575_4291970968354962219_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_Mpc0GDnUMQ7kNvwFROLf2&_nc_oc=Adr0FymBVwDLa7_oOdmbqdxZB90Qg-4pHCHr0Puo5JkLxtuLZSveEBA8pzcDcoRJ0wU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH0HbqE_Q1uDAYZK1lG2bD-duwvGSlYyKdaWQ47n1q7g&oe=6AF324A0"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1127554176367619", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831393_1127554179700952_5907221915876862663_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeO8axt82OoQ7kNvwFiOK-i&_nc_oc=Adr9imRRi7mNEGyxOjcHCjAjVn23goms4-pMIhkQKGcmM2WbWWD-KQ8OSRKkIDlr2Ig&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRgsS-by7iALXfNJzrYvvO4Q3FzwUXTV-b88MGUXrb2w&oe=6AF327A3"}, {"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "1099921992435840", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830576_1099921995769173_5913535168425701380_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eI2ZDP6bZYQ7kNvwFGH-ou&_nc_oc=AdoUkbq3IdDL4Ts_b77Xy8W0QWMSNcnY8tJmFiMAW-DnNYid_TiZA6M9c1_HrybHEDw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAVNCYpP7ggf5TS5IikbjESAR2Hr3JIdTD9pfYZ289xQ&oe=6AF340A3"}]}, "id": "2365886944155492", "locale": "en_US", "screenshots": [{"file_name": "01-biblioteca-REFazer-chave-visivel.png", "id": "2299637184220037", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/613072098_2299637187553370_2325475129092591415_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpmKDpgYhakQ7kNvwE3KGSQ&_nc_oc=AdppAVhz1ZSpSzy0yoPl-cRTv92ftKL9AGThCaY85IrcEa68taIBDsV-i-hSBmpAGSA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdpu_5ORCjR2F5baShnzYeZLt7sVnnMPg29sctHtC1OQ&oe=6AF33E99"}, {"file_name": "03-player-controles.png", "id": "1640445701136624", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831393_1640445704469957_7404231614323550176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baxU-ioIkQQQ7kNvwF6h4F7&_nc_oc=Adpiq9W7C4FqMf8sEckohUluaa4oka3FgdIAIscqME1x3zdpGwjM0ZwqvQYSdjdyO_Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKtuushCwXw-08o50YzBwOGhBy0RJPoQq_wws0WSVNHQ&oe=6AF32BE6"}, {"file_name": "02-album-REVISAR-conteudo.png", "id": "1817311635938025", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830904_1817311639271358_5117875908409932257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqEbNILEbTQQ7kNvwG6REDu&_nc_oc=AdoOx1zO2VTaztl_KMvlSPcPvL0KDksFyWtYgEE5UiyR5rL9r0DurKRpyXYHAREbEyw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMUda5MR2aPeHEqe46Br4UWhRVrsYrpD8qK_kx8vming&oe=6AF34FD1"}, {"file_name": "05-player-ambiente.png", "id": "2055765878463220", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673536876_2055765881796553_5847436137716175680_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vFbMcrsrqQQ7kNvwEogdFp&_nc_oc=AdreK7XmDMCmqEhFXPRWi47jFkt-FcJsBHnVwoWlMn1-LqOh1Ufb8y_YnspqfjUVNNo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHx40zQ9NFJZmVJSH_p9nHHTVuK_dZiG5G1ctscXNmQA&oe=6AF34280"}, {"file_name": "04-player-tela.png", "id": "1145412141347729", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604370996_1145412144681062_106989400978839567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edpC2BwRvhUQ7kNvwHoA4xZ&_nc_oc=AdpuDfFlH6iqlJP3CKT3gBhu7dBOKb0gM28qgqroWEc5fGbbm08xkkRn5PVYDJWeLEU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXgfQHT9xekmpm75nB_u9aVgtlO9qzREH7SsTU_gIHPg&oe=6AF358D9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PerfectPlay", "keywords": [], "long_description": "Bring your own media into a personal cinema with PerfectPlay.\n\nWatch videos on an adjustable virtual screen, or switch to mixed reality to enjoy them in your own space. Resize and reposition the screen for a comfortable viewing experience.\n\nYOUR MEDIA, YOUR WAY\nBrowse files on your headset or transfer media from a phone or computer through a web browser. Resume videos from where you stopped, and select available audio tracks and compatible subtitles.\n\nWATCH TOGETHER\nCreate a local session and connect another headset on the same Wi-Fi network. Synchronize video playback and choose whether your guest can control playback.\n\nPHOTO PRESENTATIONS\nOrganize photos into albums and enjoy smooth transitions in a 3D presentation. Move between photos manually or start an automatic slideshow with your own music.\n\nFLEXIBLE CONTROLS\nUse supported Touch controllers or hand tracking to interact with the app.\n\nPerfectPlay plays user-provided media and does not include movies, music, or a streaming subscription. Format and codec support depends on the file and headset capabilities. Photo album presentations are individual experiences and are not synchronized between headsets.", "short_description": "Your personal cinema in VR and mixed reality. Watch your own videos, enjoy photo slideshows with music, and watch videos together with another headset on the same Wi-Fi network. Transfer media from your phone or computer using a web browser."}]}, "developer_name": null, "developer_privacy_policy_url": "https://quintodeveloped.guilhermequinto-s97.chatgpt.site/perfectplay/privacidade/", "developer_terms_of_service_url": null, "publisher_name": "QuintoDeveloped", "support_website_url": "https://quintodeveloped.guilhermequinto-s97.chatgpt.site/perfectplay/suporte/", "website_url": "https://quintodeveloped.guilhermequinto-s97.chatgpt.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["pt_BR"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1291663277374329"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830822_1624147122545575_4291970968354962219_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_Mpc0GDnUMQ7kNvwFROLf2&_nc_oc=Adr0FymBVwDLa7_oOdmbqdxZB90Qg-4pHCHr0Puo5JkLxtuLZSveEBA8pzcDcoRJ0wU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVZh2-uGDzm4hpoy3mjt6-YzHD7ouWJ1wvmaxLrTrTsA&oe=6AF324A0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PerfectPlay", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1792004220, "lastRevision": {"nodes": [{"id": "1272032159337441", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1272032069337450", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "4074238796043292"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "29417631934488414", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PerfectPlay", "keywords": ["cinema", "player", "assistirjuntos", "galeria"], "long_description": "Transforme suas m\u00eddias em uma experi\u00eancia de cinema com o PerfectPlay.\n\nAssista a v\u00eddeos em uma tela virtual ajust\u00e1vel ou ative a realidade mista para assistir no ambiente da sua casa. Ajuste o tamanho e a posi\u00e7\u00e3o da tela para encontrar a experi\u00eancia mais confort\u00e1vel.\n\nSUAS M\u00cdDIAS, DO SEU JEITO\nProcure arquivos no headset ou envie m\u00eddias pelo navegador do celular ou computador. Continue v\u00eddeos de onde parou e selecione faixas de \u00e1udio dispon\u00edveis e legendas compat\u00edveis.\n\nASSISTA JUNTO\nCrie uma sess\u00e3o local e conecte outro headset na mesma rede Wi-Fi. Sincronize a reprodu\u00e7\u00e3o dos v\u00eddeos e escolha se o convidado pode controlar os comandos.\n\nAPRESENTA\u00c7\u00d5ES DE FOTOS\nOrganize fotos em \u00e1lbuns e aproveite transi\u00e7\u00f5es suaves em uma apresenta\u00e7\u00e3o 3D. Avance e volte manualmente ou inicie uma apresenta\u00e7\u00e3o autom\u00e1tica com suas m\u00fasicas.\n\nCONTROLES FLEX\u00cdVEIS\nInteraja usando controles Touch compat\u00edveis ou rastreamento das m\u00e3os.\n\nO PerfectPlay reproduz m\u00eddias fornecidas pelo usu\u00e1rio e n\u00e3o inclui filmes, m\u00fasicas ou assinatura de streaming. A compatibilidade com formatos e codecs depende do arquivo e dos recursos do headset. As apresenta\u00e7\u00f5es de \u00e1lbuns de fotos s\u00e3o individuais e n\u00e3o s\u00e3o sincronizadas entre headsets.", "short_description": "Seu cinema pessoal em VR e realidade mista. Assista aos seus v\u00eddeos, aproveite apresenta\u00e7\u00f5es de fotos com m\u00fasica e compartilhe a reprodu\u00e7\u00e3o de v\u00eddeos com outro headset na mesma rede Wi-Fi. Transfira suas m\u00eddias pelo navegador do celular ou computador."}, {"images": {"nodes": [{"file_name": "Imagem do ChatGPT 7 de out. de 2026, 03_08_03.png", "id": "2201135260819633", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673536876_2201135264152966_5733641697835351140_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMQ_3Y1iMOYQ7kNvwE4QFKD&_nc_oc=Ado8Xa6SxZSOCBzGTHMMz2A4PCAWepx_t_l7AvK-rOpoAOzuvEjdR_IyycvOyZy3cQU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO5T-N8FOrC5uug3uiO2_R5VUw8UV-7gUFyzPUJFZKVQ&oe=6AF33122"}, {"file_name": "Imagem do ChatGPT 7 de out. de 2026, 03_07_55.png", "id": "1816319766056305", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830904_1816319769389638_7884766354508195249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-adMZf1cfAQ7kNvwH6xjo6&_nc_oc=AdpDWWDYXERTnVpZ9Po_yR8RbVOrhjpneDHihW-iu4bNIH5zAa87BecRdxnZp4Dbyv8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSe5dNtCSgSSqpAlixi7IY2_wSaRr4xyl0ut1fS6ypkSQ&oe=6AF333D0"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1624147119212242", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830822_1624147122545575_4291970968354962219_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_Mpc0GDnUMQ7kNvwFROLf2&_nc_oc=Adr0FymBVwDLa7_oOdmbqdxZB90Qg-4pHCHr0Puo5JkLxtuLZSveEBA8pzcDcoRJ0wU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH0HbqE_Q1uDAYZK1lG2bD-duwvGSlYyKdaWQ47n1q7g&oe=6AF324A0"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1127554176367619", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831393_1127554179700952_5907221915876862663_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeO8axt82OoQ7kNvwFiOK-i&_nc_oc=Adr9imRRi7mNEGyxOjcHCjAjVn23goms4-pMIhkQKGcmM2WbWWD-KQ8OSRKkIDlr2Ig&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRgsS-by7iALXfNJzrYvvO4Q3FzwUXTV-b88MGUXrb2w&oe=6AF327A3"}, {"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "1099921992435840", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830576_1099921995769173_5913535168425701380_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eI2ZDP6bZYQ7kNvwFGH-ou&_nc_oc=AdoUkbq3IdDL4Ts_b77Xy8W0QWMSNcnY8tJmFiMAW-DnNYid_TiZA6M9c1_HrybHEDw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAVNCYpP7ggf5TS5IikbjESAR2Hr3JIdTD9pfYZ289xQ&oe=6AF340A3"}]}, "id": "2365886944155492", "locale": "en_US", "screenshots": [{"file_name": "01-biblioteca-REFazer-chave-visivel.png", "id": "2299637184220037", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/613072098_2299637187553370_2325475129092591415_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpmKDpgYhakQ7kNvwE3KGSQ&_nc_oc=AdppAVhz1ZSpSzy0yoPl-cRTv92ftKL9AGThCaY85IrcEa68taIBDsV-i-hSBmpAGSA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdpu_5ORCjR2F5baShnzYeZLt7sVnnMPg29sctHtC1OQ&oe=6AF33E99"}, {"file_name": "03-player-controles.png", "id": "1640445701136624", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831393_1640445704469957_7404231614323550176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baxU-ioIkQQQ7kNvwF6h4F7&_nc_oc=Adpiq9W7C4FqMf8sEckohUluaa4oka3FgdIAIscqME1x3zdpGwjM0ZwqvQYSdjdyO_Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKtuushCwXw-08o50YzBwOGhBy0RJPoQq_wws0WSVNHQ&oe=6AF32BE6"}, {"file_name": "02-album-REVISAR-conteudo.png", "id": "1817311635938025", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830904_1817311639271358_5117875908409932257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqEbNILEbTQQ7kNvwG6REDu&_nc_oc=AdoOx1zO2VTaztl_KMvlSPcPvL0KDksFyWtYgEE5UiyR5rL9r0DurKRpyXYHAREbEyw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMUda5MR2aPeHEqe46Br4UWhRVrsYrpD8qK_kx8vming&oe=6AF34FD1"}, {"file_name": "05-player-ambiente.png", "id": "2055765878463220", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673536876_2055765881796553_5847436137716175680_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vFbMcrsrqQQ7kNvwEogdFp&_nc_oc=AdreK7XmDMCmqEhFXPRWi47jFkt-FcJsBHnVwoWlMn1-LqOh1Ufb8y_YnspqfjUVNNo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHx40zQ9NFJZmVJSH_p9nHHTVuK_dZiG5G1ctscXNmQA&oe=6AF34280"}, {"file_name": "04-player-tela.png", "id": "1145412141347729", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604370996_1145412144681062_106989400978839567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edpC2BwRvhUQ7kNvwHoA4xZ&_nc_oc=AdpuDfFlH6iqlJP3CKT3gBhu7dBOKb0gM28qgqroWEc5fGbbm08xkkRn5PVYDJWeLEU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXgfQHT9xekmpm75nB_u9aVgtlO9qzREH7SsTU_gIHPg&oe=6AF358D9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PerfectPlay", "keywords": [], "long_description": "Bring your own media into a personal cinema with PerfectPlay.\n\nWatch videos on an adjustable virtual screen, or switch to mixed reality to enjoy them in your own space. Resize and reposition the screen for a comfortable viewing experience.\n\nYOUR MEDIA, YOUR WAY\nBrowse files on your headset or transfer media from a phone or computer through a web browser. Resume videos from where you stopped, and select available audio tracks and compatible subtitles.\n\nWATCH TOGETHER\nCreate a local session and connect another headset on the same Wi-Fi network. Synchronize video playback and choose whether your guest can control playback.\n\nPHOTO PRESENTATIONS\nOrganize photos into albums and enjoy smooth transitions in a 3D presentation. Move between photos manually or start an automatic slideshow with your own music.\n\nFLEXIBLE CONTROLS\nUse supported Touch controllers or hand tracking to interact with the app.\n\nPerfectPlay plays user-provided media and does not include movies, music, or a streaming subscription. Format and codec support depends on the file and headset capabilities. Photo album presentations are individual experiences and are not synchronized between headsets.", "short_description": "Your personal cinema in VR and mixed reality. Watch your own videos, enjoy photo slideshows with music, and watch videos together with another headset on the same Wi-Fi network. Transfer media from your phone or computer using a web browser."}]}, "developer_name": null, "developer_privacy_policy_url": "https://quintodeveloped.guilhermequinto-s97.chatgpt.site/perfectplay/privacidade/", "developer_terms_of_service_url": null, "publisher_name": "QuintoDeveloped", "support_website_url": "https://quintodeveloped.guilhermequinto-s97.chatgpt.site/perfectplay/suporte/", "website_url": "https://quintodeveloped.guilhermequinto-s97.chatgpt.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["pt_BR"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1291663277374329"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1083823137584349"}]}, "baseline_offer": {"id": "1083823137584349"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792004220, "status": "PUBLISHED", "id": "1083823137584349"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1281384461735544", "version": "0.4.7"}, "id": "1646209203804398", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1272032069337450", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1281384461735544"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1646209203804398"}]}, "change_log": null, "created_date": 1791407867, "id": "1281417098398947", "version": "0.4.8", "version_code": 14, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1272032069337450", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1281384461735544"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1646209203804398"}]}, "change_log": null, "created_date": 1791406013, "id": "1281384461735544", "version": "0.4.7", "version_code": 13, "release_status": "RELEASED", "status": "APPROVED", "binary_test_r
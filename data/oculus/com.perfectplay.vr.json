jz_hzKEI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWx6iD9PE49Dmh8LcMRr1DeJo7fZMJPG79lc6wN5XleA&oe=6AFDCA99"}, {"file_name": "03-player-controles.png", "id": "1640445701136624", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831393_1640445704469957_7404231614323550176_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwCIfcPoim8Q7kNvwG3HKnS&_nc_oc=AdoGv57Q3TpmkbphDlROOwKZ7pDYjWBNfkxWvsGrIyqszEB9eoHtisOYdefnjSt7h6o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSuF_etWaueb97k4BFLi759cL_ytjtVerc-67WOqfKFg&oe=6AFDB7E6"}, {"file_name": "02-album-REVISAR-conteudo.png", "id": "1817311635938025", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830904_1817311639271358_5117875908409932257_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1uhqDHb3iAQ7kNvwHnqonw&_nc_oc=Adr-OkYtjc-lXjymTi9V5qlTm8DU0m9sBR6eD2Wcffbgm5eoVwjjEGST15OmzyxPA3c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_4YSzfnZDah3jAb2HvCMpAp0pA0tsPPyeC0EzU_KAWA&oe=6AFDDBD1"}, {"file_name": "05-player-ambiente.png", "id": "2055765878463220", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673536876_2055765881796553_5847436137716175680_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ix_5eVnpw9gQ7kNvwGA4mDr&_nc_oc=AdoWTzSUgd_28CUZbZ03wGgkLnXRa5MizZpMsFxEsnstHdBhJXv43pQz3Km3ddpTxBU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScPTVX8_wtttI3_Ft8cwVF1E5x2z-YOpB-mT-e_JLwaA&oe=6AFDCE80"}, {"file_name": "04-player-tela.png", "id": "1145412141347729", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604370996_1145412144681062_106989400978839567_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCVlzjKiLDAQ7kNvwEjLnvb&_nc_oc=AdrrW1zMo6NCVk58-BEpaEcE5_w1bhmRZ9d3jtzw2WZc7xHLW9XLJWG3Byv_PC_R8Xo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmeqmH_oBr7itn_Ul5F_Hofjz6C6JVnVnAz4KOtSsbfw&oe=6AFDAC99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PerfectPlay", "keywords": [], "long_description": "Bring your own media into a personal cinema with PerfectPlay.\n\nWatch videos on an adjustable virtual screen, or switch to mixed reality to enjoy them in your own space. Resize and reposition the screen for a comfortable viewing experience.\n\nYOUR MEDIA, YOUR WAY\nBrowse files on your headset or transfer media from a phone or computer through a web browser. Resume videos from where you stopped, and select available audio tracks and compatible subtitles.\n\nWATCH TOGETHER\nCreate a local session and connect another headset on the same Wi-Fi network. Synchronize video playback and choose whether your guest can control playback.\n\nPHOTO PRESENTATIONS\nOrganize photos into albums and enjoy smooth transitions in a 3D presentation. Move between photos manually or start an automatic slideshow with your own music.\n\nFLEXIBLE CONTROLS\nUse supported Touch controllers or hand tracking to interact with the app.\n\nPerfectPlay plays user-provided media and does not include movies, music, or a streaming subscription. Format and codec support depends on the file and headset capabilities. Photo album presentations are individual experiences and are not synchronized between headsets.", "short_description": "Your personal cinema in VR and mixed reality. Watch your own videos, enjoy photo slideshows with music, and watch videos together with another headset on the same Wi-Fi network. Transfer media from your phone or computer using a web browser."}]}, "developer_name": null, "developer_privacy_policy_url": "https://quintodeveloped.guilhermequinto-s97.chatgpt.site/perfectplay/privacidade/", "developer_terms_of_service_url": null, "publisher_name": "QuintoDeveloped", "support_website_url": "https://quintodeveloped.guilhermequinto-s97.chatgpt.site/perfectplay/suporte/", "website_url": "https://quintodeveloped.guilhermequinto-
kzMLD-lTvOdmyNM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNawVMb0HMDH09TdGPNi1Mf17CDIIby46dbr-zAI9qk0w&oe=6AE0B6E6"}, {"file_name": "02-album-REVISAR-conteudo.png", "id": "1817311635938025", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830904_1817311639271358_5117875908409932257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzZFh5XQtZ8Q7kNvwE-jc_I&_nc_oc=AdqqaFGnuOesA87sqt0VCW7QOZ3pW3W6UoWbjJz9vEWU99RaNFOnfRoLrZ6TvFnHHx8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJjC0AunIJk5Xn0pXD-JGPs52bI1SHLUD-hWYTIW_BKA&oe=6AE0A291"}, {"file_name": "05-player-ambiente.png", "id": "2055765878463220", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/673536876_2055765881796553_5847436137716175680_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnc-tXVKRRUQ7kNvwG1j15E&_nc_oc=AdpQGyaLorGV0N-qyePGXTeV3xg5e1z15cHOoZ5KXHLmjCtPzS0CHYlu_VN6LDujorw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7NG4BfHaJScMlAwl6T0P3yYfu3j4F10_Kfyfc4baRiA&oe=6AE09540"}, {"file_name": "04-player-tela.png", "id": "1145412141347729", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/604370996_1145412144681062_106989400978839567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNkhlKcr_akQ7kNvwG_sthi&_nc_oc=AdpCnPh3w5qgqm_GOpe9jRfogV7EZEkSY81Kegyyd8IJ_C6ilpL6izv0-vtqWS75WUw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdzoo-sQq1CuqUZE3ckrr52s6wfrqPm9qIJI4Not-6Qg&oe=6AE0AB99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PerfectPlay", "keywords": [], "long_description": "Bring your own media into a personal cinema with PerfectPlay.\n\nWatch videos on an adjustable virtual screen, or switch to mixed reality to enjoy them in your own space. Resize and reposition the screen for a comfortable viewing experience.\n\nYOUR MEDIA, YOUR WAY\nBrowse files on your headset or transfer media from a phone or computer through a web browser. Resume videos from where you stopped, and select available audio tracks and compatible subtitles.\n\nWATCH TOGETHER\nCreate a local session and connect another headset on the same Wi-Fi network. Synchronize video playback and choose whether your guest can control playback.\n\nPHOTO PRESENTATIONS\nOrganize photos into albums and enjoy smooth transitions in a 3D presentation. Move between photos manually or start an automatic slideshow with your own music.\n\nFLEXIBLE CONTROLS\nUse supported Touch controllers or hand tracking to interact with the app.\n\nPerfectPlay plays user-provided media and does not include movies, music, or a streaming subscription. Format and codec support depends on the file and headset capabilities. Photo album presentations are individual experiences and are not synchronized between headsets.", "short_description": "Your personal cinema in VR and mixed reality. Watch your own videos, enjoy photo slideshows with music, and watch videos together with another headset on the same Wi-Fi network. Transfer media from your phone or computer using a web browser."}]}, "developer_name": null, "developer_privacy_policy_url": "https://quintodeveloped.guilhermequinto-s97.chatgpt.site/perfectplay/privacidade/", "developer_terms_of_service_url": null, "publisher_name": "QuintoDeveloped", "support_website_url": "https://quintodeveloped.guilhermequinto-s97.chatgpt.site/perfectplay/suporte/", "website_url": "https://quintodeveloped.guilhermequinto-s97.chatgpt.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["pt_BR"], "supported_input_devices": ["HAND_TRACKI
M3Eovvqw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRICr25x_0ewzpi9Yoaz2-plZtstHEfb24c0A5LaD9ZhQ&oe=6B006D99"}, {"file_name": "03-player-controles.png", "id": "1640445701136624", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831393_1640445704469957_7404231614323550176_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwCIfcPoim8Q7kNvwGceCup&_nc_oc=AdqpoH3R9Yd1GPihRJZgmCmplMlnghr2-IhCn-srmyMusRiFt0_M6mabjDMZFMWz4OU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuauW2njymp245cKaMBqui4WocaJ6AGuljqkVoZ6If_w&oe=6B005AE6"}, {"file_name": "02-album-REVISAR-conteudo.png", "id": "1817311635938025", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830904_1817311639271358_5117875908409932257_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbVBk5xXsc4Q7kNvwFPYIsp&_nc_oc=Adp457j7kdEIYivGTPo6z8kwb8C5XuI8M8DIHNZbCmw9WRp94Vw-Mw6q-s6wEXerqw8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSb0Xd08BU4GzfLTwhCcMR5494bxoINvjcFV7-eQnRQjA&oe=6B007ED1"}, {"file_name": "05-player-ambiente.png", "id": "2055765878463220", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673536876_2055765881796553_5847436137716175680_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfN32X0w2LIQ7kNvwFy0A3-&_nc_oc=AdqpYz-o0lT_uuGRyW_SaVPLA3B1MHAvG2VLcDOg0aT5wo8aVI4paglYKomRfHJ5XWk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSspeLXch_aFyKqPhXE4KYFSG7GkPo3H0lGgQ56CMIp3Q&oe=6B007180"}, {"file_name": "04-player-tela.png", "id": "1145412141347729", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604370996_1145412144681062_106989400978839567_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=769rrQzGfZEQ7kNvwEZo4HE&_nc_oc=Ado3idVMPsyspV9TVMrot-4bUM7UNH8jACFDVymXufszQULhpqnIj5K6zDR5mTXC-rQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9DNp56zM3-2uISOOyKGYf5haFiTU3di121GWox1edyQ&oe=6B0087D9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PerfectPlay", "keywords": [], "long_description": "Bring your own media into a personal cinema with PerfectPlay.\n\nWatch videos on an adjustable virtual screen, or switch to mixed reality to enjoy them in your own space. Resize and reposition the screen for a comfortable viewing experience.\n\nYOUR MEDIA, YOUR WAY\nBrowse files on your headset or transfer media from a phone or computer through a web browser. Resume videos from where you stopped, and select available audio tracks and compatible subtitles.\n\nWATCH TOGETHER\nCreate a local session and connect another headset on the same Wi-Fi network. Synchronize video playback and choose whether your guest can control playback.\n\nPHOTO PRESENTATIONS\nOrganize photos into albums and enjoy smooth transitions in a 3D presentation. Move between photos manually or start an automatic slideshow with your own music.\n\nFLEXIBLE CONTROLS\nUse supported Touch controllers or hand tracking to interact with the app.\n\nPerfectPlay plays user-provided media and does not include movies, music, or a streaming subscription. Format and codec support depends on the file and headset capabilities. Photo album presentations are individual experiences and are not synchronized between headsets.", "short_description": "Your personal cinema in VR and mixed reality. Watch your own videos, enjoy photo slideshows with music, and watch videos together with another headset on the same Wi-Fi network. Transfer media from your phone or computer using a web browser."}]}, "developer_name": null, "developer_privacy_policy_url": "https://quintodeveloped.guilhermequinto-s97.chatgpt.site/perfectplay/privacidade/", "developer_terms_of_service_url": null, "publisher_name": "QuintoDeveloped", "support_website_url": "https://quintodeveloped.guilhermequinto-s97.chatgpt.site/perfectplay/suporte/", "website_url": "https://quintodeveloped.guilhermequinto-
9ZzQHwoM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSC3K5uQSLBSKgfSvstQ0ni9Vb020mXupwTUw_1J9RpAQ&oe=6B0C4B19"}, {"file_name": "03-player-controles.png", "id": "1640445701136624", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831393_1640445704469957_7404231614323550176_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZbD907QJdkQ7kNvwHmZaOP&_nc_oc=Adqd7V65gl4MMVTij3P2b5Ffpt5H7cORsgybcn4sEQj6pFa7drDspaIu8_BQrmWYaoc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSt5mK5OQTMyzrM5zVNilPeGeZoPwjrHym8TkpDRQnuxA&oe=6B0C70A6"}, {"file_name": "02-album-REVISAR-conteudo.png", "id": "1817311635938025", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830904_1817311639271358_5117875908409932257_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-wXoUb_CbAQ7kNvwEc8kjV&_nc_oc=AdpCvppsdYzmcf_KfOz6a07Q1hxkRDIc1iAnql-htLjSqQpbeLfFZ4p-5N2MksJ9Zrk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQTyxBi3jOyCIMAFOJkiQHwo_ryn1BYJWSuSPhKAiJ7OQ&oe=6B0C5C51"}, {"file_name": "05-player-ambiente.png", "id": "2055765878463220", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673536876_2055765881796553_5847436137716175680_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9xq-M3qL-8Q7kNvwGVLG8G&_nc_oc=AdoCuOywlKZJpdM6jjJ7aTch0d1TA0Ly9BCYtn49huiqbCwAz62nquALFaIbmXuq89w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTvigHw74srVeczZ7Faxxrp2GLpKdPwr8kxKAwzkUwNKw&oe=6B0C4F00"}, {"file_name": "04-player-tela.png", "id": "1145412141347729", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604370996_1145412144681062_106989400978839567_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYkkWvM9bF0Q7kNvwFhy8_C&_nc_oc=AdpkRUX_gAvPhJLT1ja_9UlK6gSPobTTJGpBeE8vk1yq4yrBmvZNyf7QJ0LH1Aoz8RA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTBqn_2yollZtFZCQ1qIisnRuJNBRPQhO4T1J2p0Tiafw&oe=6B0C6559"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PerfectPlay", "keywords": [], "long_description": "Bring your own media into a personal cinema with PerfectPlay.\n\nWatch videos on an adjustable virtual screen, or switch to mixed reality to enjoy them in your own space. Resize and reposition the screen for a comfortable viewing experience.\n\nYOUR MEDIA, YOUR WAY\nBrowse files on your headset or transfer media from a phone or computer through a web browser. Resume videos from where you stopped, and select available audio tracks and compatible subtitles.\n\nWATCH TOGETHER\nCreate a local session and connect another headset on the same Wi-Fi network. Synchronize video playback and choose whether your guest can control playback.\n\nPHOTO PRESENTATIONS\nOrganize photos into albums and enjoy smooth transitions in a 3D presentation. Move between photos manually or start an automatic slideshow with your own music.\n\nFLEXIBLE CONTROLS\nUse supported Touch controllers or hand tracking to interact with the app.\n\nPerfectPlay plays user-provided media and does not include movies, music, or a streaming subscription. Format and codec support depends on the file and headset capabilities. Photo album presentations are individual experiences and are not synchronized between headsets.", "short_description": "Your personal cinema in VR and mixed reality. Watch your own videos, enjoy photo slideshows with music, and watch videos together with another headset on the same Wi-Fi network. Transfer media from your phone or computer using a web browser."}]}, "developer_name": null, "developer_privacy_policy_url": "https://quintodeveloped.guilhermequinto-s97.chatgpt.site/perfectplay/privacidade/", "developer_terms_of_service_url": null, "publisher_name": "QuintoDeveloped", "support_website_url": "https://quintodeveloped.guilhermequinto-s97.chatgpt.site/perfectplay/suporte/", "website_url": "https://quintodeveloped.guilhermequinto-
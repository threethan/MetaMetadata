t=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuGEcqJcRXkfDPUVuy5UxRNmX3pOhlzor-vI1a0BjL2Q&oe=6AFDC274"}, {"file_name": "screenshot_5.png", "id": "1661538998735565", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596149727_1661539002068898_6936549956210284533_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCJMRFEv7B0Q7kNvwGCufH_&_nc_oc=AdrgEGStltioEjFqRQnlZpFejqY5Ox41HnKZLc4bZ9do_QwDDDEMBlv4OUnBB6oR8VU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQKEJTFqhT-IybaoS5oSLBp2Nb6V4Awp-q2f6tc4zrBw&oe=6AFDD8FE"}, {"file_name": "screenshot_1.png", "id": "1299252155561769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596149727_1299252158895102_6234357694234064600_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5Jtds_iT8wQ7kNvwHSveO0&_nc_oc=Adp6TxE_MEAJ5o4xzvxMbi1HUSeP_j3EZinjZZPS4_7ZcCj_d_z4jc3e7PS959Y4d40&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIvo5-66p_nCwmS0yyNnsPOxj3qGEBCsDIWzjAZVsKmA&oe=6AFDC308"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1616921910016739", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596149727_1616921913350072_4790742995842604174_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XxCKqZj-i8Q7kNvwHqloes&_nc_oc=Adq87THpm7rOUWfVkW-ohdClSs7jR_nMaSVQSGH2PBHTxx_gLMDAraGn46BjqaBQIU4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTW69UL13yKHCfx8br_wrfKE72ZMRPAN4Y9SK6qt0U9Ow&oe=6AFDDAEE"}, "display_name": "Cozy Kitchen 2", "keywords": ["cooking", "restaurant", "food", "relaxing", "family"], "long_description": "Cozy Kitchen 2 is the bigger, busier sequel to Cozy Kitchen - a relaxing restaurant game for Meta Quest where everything is done with your hands.\n\nAN OPEN KITCHEN\nNo wall between you and your guests. Regulars sit on bar stools right across your chef's counter and watch you cook, while knights, mages, rangers and friendly skeletons fill the dining room.\n\nA BIGGER MENU\nBurgers, cheeseburgers, veggie burgers and the Deluxe, garden salads, stew, ham dinners, steak with mash, crispy fries, lemonade and cola.\n\nNEW STATIONS\nGrill four patties at once, drop raw fries in the deep fryer, and stand a glass under the drinks machine - it pours by itself. Chop on big boards and stack on a plate; every layer snaps into place.\n\nMEAL + DRINK ORDERS\nGuests often want a drink with their meal and start eating once both arrive.\n\nTHE FOOD CRITIC\nServe the critic quickly for a rave review, a bonus star and a big tip.\n\nGROW YOUR RESTAURANT\nSpend tips on upgrades you can see: a sunny patio, hot burners, comfy cushions, a jukebox, flowers and art, and a neon sign.\n\nCAREER OR FREE MODE\nCareer unlocks dishes day by day and earns stars. Free Mode has no clock - everything is open.\n\nGrip to pick up, left stick to walk, right stick to turn. No violence, no failing - just cooking.", "short_description": "Run a bigger, busier bistro in VR. Grill burgers, fry golden fries, pour lemonade and serve hungry adventurers right across your open-kitchen counter - then spend your tips growing the restaurant."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/cozykitchen2/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/cozykitchen2/", "website_url": "https://citiview-games.pages.dev/cozykitchen2/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
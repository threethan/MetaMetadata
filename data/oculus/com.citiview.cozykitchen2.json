t=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdN_oPg-eGC3pzxb3G1vqHUqOxcS-PN_KkqneBcygbkA&oe=6AFC70F4"}, {"file_name": "screenshot_5.png", "id": "1661538998735565", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596149727_1661539002068898_6936549956210284533_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCJMRFEv7B0Q7kNvwHd3lA8&_nc_oc=Adq-Vs3OErLmgasm0u5HmELLrwjbIxA8tqUfH5tyh-myD520WeLkIasQXdcjv1vMLtg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxd30fB5NIWOQkxYXN2dZwCPn74L-I4ou-Ww4kb5aVcw&oe=6AFC877E"}, {"file_name": "screenshot_1.png", "id": "1299252155561769", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596149727_1299252158895102_6234357694234064600_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5Jtds_iT8wQ7kNvwGh_OPC&_nc_oc=AdrvbUesVeDLiF7hKfvkLck5CBl2pCwoEieLtDxSU8EwYppymzWvAVEDnzN0-kWDUVI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_7xU29ZISgL98tB9hPQnOQe88JdeQCejtfSRGYLDphA&oe=6AFC7188"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1616921910016739", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596149727_1616921913350072_4790742995842604174_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XxCKqZj-i8Q7kNvwHsyFWV&_nc_oc=Adr87KnhPPsA8lWoz5QHgs4zwo_5P7XehdVnqnjarHX3klczSqYrYRWWCZb_bBAqoIM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHtA2Vj73UMubsralqziUZWAyAsjEUoxzYyPkaByQUOw&oe=6AFC896E"}, "display_name": "Cozy Kitchen 2", "keywords": ["cooking", "restaurant", "food", "relaxing", "family"], "long_description": "Cozy Kitchen 2 is the bigger, busier sequel to Cozy Kitchen - a relaxing restaurant game for Meta Quest where everything is done with your hands.\n\nAN OPEN KITCHEN\nNo wall between you and your guests. Regulars sit on bar stools right across your chef's counter and watch you cook, while knights, mages, rangers and friendly skeletons fill the dining room.\n\nA BIGGER MENU\nBurgers, cheeseburgers, veggie burgers and the Deluxe, garden salads, stew, ham dinners, steak with mash, crispy fries, lemonade and cola.\n\nNEW STATIONS\nGrill four patties at once, drop raw fries in the deep fryer, and stand a glass under the drinks machine - it pours by itself. Chop on big boards and stack on a plate; every layer snaps into place.\n\nMEAL + DRINK ORDERS\nGuests often want a drink with their meal and start eating once both arrive.\n\nTHE FOOD CRITIC\nServe the critic quickly for a rave review, a bonus star and a big tip.\n\nGROW YOUR RESTAURANT\nSpend tips on upgrades you can see: a sunny patio, hot burners, comfy cushions, a jukebox, flowers and art, and a neon sign.\n\nCAREER OR FREE MODE\nCareer unlocks dishes day by day and earns stars. Free Mode has no clock - everything is open.\n\nGrip to pick up, left stick to walk, right stick to turn. No violence, no failing - just cooking.", "short_description": "Run a bigger, busier bistro in VR. Grill burgers, fry golden fries, pour lemonade and serve hungry adventurers right across your open-kitchen counter - then spend your tips growing the restaurant."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/cozykitchen2/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/cozykitchen2/", "website_url": "https://citiview-games.pages.dev/cozykitchen2/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
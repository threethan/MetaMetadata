344216_9045095641995815940_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXhhBrTcwpYQ7kNvwG2AQl5&_nc_oc=Adqr3qWjzpm_jZeDvxrvFo8Q6qF8CKwWapvqpPvbvLXzsMLoIPs6ZAaBPlj-LWplJRI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hfqAvQcy6w7_hZz7b45omf8hpAyFUbhkggY0qSbLkUw&oe=69DA4B08"}, {"file_name": "ScreenShot03.png", "id": "2057311598107878", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391911_2057311601441211_8310860660269077219_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmqAENn9eYMQ7kNvwFSUkF1&_nc_oc=AdqTshiWMbpcNxtAyPE98bZK4zJLiarfIuUKXqUJMtNXMdNLraRhRV5ulntr0lxj8xY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_5sOGB2i3aIzrxMcsJQ84gqtzFdDu9Qp3S7zLw1i7_w&oe=69DA4A2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Forefront_Youtube_Thumbnail_2560x1440_v2.png", "id": "1340037183858384", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393432_1340037187191717_4433184722322802065_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjb_vC-lQqkQ7kNvwHPynJt&_nc_oc=Adp_nDNJwwn7WhOhEu2ookmt0RFr5oOlsToI44xEpQi-vKbcCTlgp6lYJmuQx_b7qWo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07DGsIEkZV3nEWz7XyWonY3cf7gKuTX7-S5DsCdcX8xQ&oe=69DA620C"}, "display_name": "Forefront", "keywords": ["Forefront", "fps", "shooter", "military", "action"], "long_description": "# Forefront \u2013 The Next Evolution of VR Warfare\nFrom the creators of **Breachers** and **Hyper Dash**, **Forefront** delivers an **all-out war experience like never before in VR**. Engage in **massive 32-player battles** across a variety of expansive, semi-destructible environments, where strategy, skill, and teamwork decide the outcome.\n\n{1815988855801809}\n\n\ud83d\ude81 **Command land, sea, and air vehicles** \u2013 Pilot helicopters, drive tanks, and storm objectives in humvees and boats.\n\n{659860923053266}\n\n\ud83d\udd2b **Choose your class** \u2013 Play as Assault, Engineer, Medic, or Sniper, each with specialized weapons and gadgets.\n\n{978836180978704}\n\n\ud83d\udd25 **Feel the impact** \u2013 Realistic gunplay, tactical movement, and large-scale combat bring the battlefield to life.\n\n{1416901679278740}\n\n\ud83d\udca5 **Shape the fight** \u2013 Blast through walls, collapse structures, and use destruction to create new paths or deny enemy cover.\n\n{988904792660435}\n\nThe year is **2035**. A powerful energy corporation, O.R.E., has built a private military to defend its **monopoly on Red Orpiment, a rare mineral set to power the world**, while local governments and resistance fighters battle to reclaim control. You are the tip of the spear in the war to control it\u2014**which side will you take?**\n\n\u26a1 **Early Access in 2025 \u2013 Playtests begin this summer!**\n\n\ud83d\udccc **Wishlist now to be the first to fight!**\n\n\ud83d\udd17 **Join our community: ForefrontVR.com/Discord**\n", "short_description": "Forefront is an intense VR shooter featuring 32-player large-scale battles, land, sea, and air vehicles, and immersive, tactical combat. You are the tip of the spear in the war between a global energy giant and resistance forces. Which side will you take?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.triangle-factory.be/forefront-privacy-policy/", "developer_terms_of_service_url": "https://www.triangle-factory.be/forefront-terms-of-use/", "publisher_name": "Triangle Factory", "support_website_url": null, "website_url": "https://www.triangle-factory.be/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "
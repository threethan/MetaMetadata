t=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVC--JmCR8lIgegX46i8JPw7rF5Q8M8ff4V8uFR2S6CA&oe=6AABDBE2"}, {"file_name": "ScreenShot06.png", "id": "1284290416010883", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391982_1284290419344216_9045095641995815940_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KD13H9iOpowQ7kNvwGqfCX5&_nc_oc=AdoIHPGlJfGQrYedHHZMv-_aqkskv0EyFTWvCq408tovtaLZOgbwLXNP9gbhJ2EX1J0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0SOR8U9da701hA9tr3gFSSPz34BqpAEiYbZvfHa-d1A&oe=6AABE988"}, {"file_name": "ScreenShot03.png", "id": "2057311598107878", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_2057311601441211_8310860660269077219_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmcFsuxxjJwQ7kNvwGnadVY&_nc_oc=AdqchMOONHgDXB2mydOmhTzN5erCeBJbaAMMwNnJwgM5feVTnmdBE-C5vvp_8Yvi59M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKba-fvI3IxlgawdrsBLkfuXLuYTxtdcLb66pAm_FnbHw&oe=6AABE8AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Forefront_Youtube_Thumbnail_2560x1440_v2.png", "id": "1340037183858384", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393432_1340037187191717_4433184722322802065_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsEAYxP__4MQ7kNvwEQRNaQ&_nc_oc=AdqEH4FXwCA9Dj8QRZqRyyARk3GKcAsUpdazq4dhqbkMeQ1yDsQEm0z8CT1MychgK9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqLnzI9JwwHKa93Vc_eYJGwSNPrBqasbC-2_8mKmLZKQ&oe=6AAC008C"}, "display_name": "Forefront", "keywords": ["Forefront", "fps", "shooter", "military", "action"], "long_description": "# Forefront \u2013 The Next Evolution of VR Warfare\nFrom the creators of **Breachers** and **Hyper Dash**, **Forefront** delivers an **all-out war experience like never before in VR**. Engage in **massive 32-player battles** across a variety of expansive, semi-destructible environments, where strategy, skill, and teamwork decide the outcome.\n\n{1815988855801809}\n\n\ud83d\ude81 **Command land, sea, and air vehicles** \u2013 Pilot helicopters, drive tanks, and storm objectives in humvees and boats.\n\n{659860923053266}\n\n\ud83d\udd2b **Choose your class** \u2013 Play as Assault, Engineer, Medic, or Sniper, each with specialized weapons and gadgets.\n\n{978836180978704}\n\n\ud83d\udd25 **Feel the impact** \u2013 Realistic gunplay, tactical movement, and large-scale combat bring the battlefield to life.\n\n{1416901679278740}\n\n\ud83d\udca5 **Shape the fight** \u2013 Blast through walls, collapse structures, and use destruction to create new paths or deny enemy cover.\n\n{988904792660435}\n\nThe year is **2035**. A powerful energy corporation, O.R.E., has built a private military to defend its **monopoly on Red Orpiment, a rare mineral set to power the world**, while local governments and resistance fighters battle to reclaim control. You are the tip of the spear in the war to control it\u2014**which side will you take?**\n\n\u26a1 **Early Access in 2025 \u2013 Playtests begin this summer!**\n\n\ud83d\udccc **Wishlist now to be the first to fight!**\n\n\ud83d\udd17 **Join our community: ForefrontVR.com/Discord**\n", "short_description": "Forefront is an intense VR shooter featuring 32-player large-scale battles, land, sea, and air vehicles, and immersive, tactical combat. You are the tip of the spear in the war between a global energy giant and resistance forces. Which side will you take?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.triangle-factory.be/forefront-privacy-policy/", "developer_terms_of_service_url": "https://www.triangle-factory.be/forefront-terms-of-use/", "publisher_name": "Triangle Factory", "support_website_url": null, "website_url": "https://www.triangle-factory.be/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "
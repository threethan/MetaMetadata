=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH4XQlAVycYS6y_nXkrornm1TpBcPiQoeeG_So5bHkDg&oe=6A5656A9"}]}, "id": "859964116681277", "locale": "en_US", "screenshots": [{"file_name": "XOScreenshot1.png", "id": "1555867379171860", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491818852_1555867382505193_1163784270704709176_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZjm2S1VMs0Q7kNvwFxMSdl&_nc_oc=Adpaoj8EuQ8hf5CkaD2WB1GpHViviXbiukuSIDtzuOWdYU97kirUKSzcU903-MGkrqk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsyPXycTxJB7swjWGODj8VHpjbv10e9ss8yfteE9JaTw&oe=6A565890"}, {"file_name": "XOScreenshot4.png", "id": "863870552685763", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819239_863870559352429_7410937319043571054_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZpVJk6UniEQ7kNvwE6f2iu&_nc_oc=Adoe45miFYJ_lg5KVXrcpVwhxFuhn-Z8lsU4264Tkf6MVN9iGTCwrIPQa4ZRpwFtJ2c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBg0M9Jd55JJiI-Zw9qbNtmR1zX-rdVjYjrpGaoMOQD7w&oe=6A5656FD"}, {"file_name": "XOScreenshot3A.png", "id": "1210080424404365", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820270_1210080427737698_3529760868446975726_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANACVgCAXGAQ7kNvwGdJ94A&_nc_oc=AdqVaaVHLJeIiLZb9C20RfrPZSQrXP3nLSqsBpCOqvnhOyd7o7Rmjj3Z1LxUxh0e7qo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHnke5I1XvTBQMXvcY8QSWT1ILSSPlVUjKZR26a5rvJA&oe=6A56560F"}, {"file_name": "XOScreenshot2.png", "id": "1246441507331705", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821696_1246441513998371_4356389525926558762_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_os4umAzlMQ7kNvwE-uiAa&_nc_oc=AdpZ7OUd63m-uwJu6eRl3pB7RVS1CHNTg8sI8X-i0biTuo2j0Fryd8DAmQOXY_cQHEM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCbk2eC9AC4oOWDGAdrS8HXQ2gdUqKI-ZT_7tT91CTUA&oe=6A562F21"}, {"file_name": "XOScreenshot5.png", "id": "879111811727351", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821568_879111815060684_6321537830146399437_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njqO1Hn_dkAQ7kNvwFs0FAO&_nc_oc=AdqWjb4KZMaKBhnXAnaAnDf6v7qpZFdNwFpE3Tak8KIQv2Y04XJ7wMST7jIWNZUxGZI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6QuAqFex0OZDcbt4LYkQr5D35unPPhZ4HYQCbG5JinQ&oe=6A5635AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeCover.png", "id": "25520480534250446", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823802_25520480557583777_8688390932071546728_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yl8ntvspjoQ7kNvwHDTAOs&_nc_oc=Adp7ahqKYMzJydpilJsaxue0nAG0wMch0qfTyJmRDUJo5nJd8TmgIuoTrasuJbAiE3Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApcJ5JDpLMfHzZ1tKILgp_kl3zdtIc-r98WSMcWJ2Xtw&oe=6A564A74"}, "display_name": "XO Odyssey", "keywords": ["VR", "Space", "Action", "Adventure", "RailsShooter"], "long_description": "## X O ODYSSEY \n\nAn intense, arcade-style VR space rail shooter that puts you in the cockpit of a starfighter and launches you through a connected series of deadly wormholes. Built for the Meta Quest 3, it combines classic on-rails shooting with modern VR immersion: you\u2019re strapped into a detailed cockpit, surrounded by deep space, and everything that wants you dead is coming straight at you.\n\nEach mission begins as your ship tears out of a wormhole into a hostile zone: asteroid belts, minefields, planetary debris, and enemy squadrons. You don\u2019t have to worry about steering the ship itself\u2014the invisible rail handles your flight path\u2014so you can focus completely on what matters: aiming, reacting, and surviving. You\u2019ll track targets with your head and controllers, swap between weapons, and constantly decide what to prioritize: the fighter in your face, the heavy cruiser powering up a broadside, or the asteroid that\u2019s seconds away from turning your ship into scrap.\n\nYour starfighter is armed with three core weapon types: rapid-fire lasers for precision and crowd control, heavy rockets for bursts of damage, and guided missiles for high-value targets at range. Enemies use similar weaponry, so every level becomes a dance of dodging incoming fire, weaving through environmental hazards, and timing your shots to maximize your score while staying alive. Smart target selection and accurate shooting are rewarded with higher multipliers and bigger end-of-run scores.\n\n{845591194753358}", "short_description": "XO ODYSSEY is a fast-paced VR space rail shooter where you blast through wormholes, dodge asteroids and crush enemy fleets from the cockpit of your star-fighter."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.balancedcode.com/xoodysseyprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Balanced Code GmbH", "support_website_url": null, "website_url": "https://www.balancedcode.com/xoodyssey.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25325728493745388"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1330776165601222"}, {"status": "PUBLISHED", "id": "1511350337276246"}, {"status": "PUBLISHED", "id": "1468444251530783"}, {"status": "PUBLISH
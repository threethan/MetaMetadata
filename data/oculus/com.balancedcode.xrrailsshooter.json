=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af158xTKd8OuipsP4rLgQxBW9jD8TkLXTCfEewQFr7w1_g&oe=69E76069"}]}, "id": "859964116681277", "locale": "en_US", "screenshots": [{"file_name": "XOScreenshot1.png", "id": "1555867379171860", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491818852_1555867382505193_1163784270704709176_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jnn8IQkm38Q7kNvwGXq3Wr&_nc_oc=AdrzhmY6zVaZbWgKSx2hrq4Q_YEragf3API1PiB2KayNz8X1i4snLf6mBRe4iX_g5pI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pfJXkMkhb3hsMCcGplo6qFTDE6TpQcQcHMw9cYhyLQw&oe=69E76250"}, {"file_name": "XOScreenshot4.png", "id": "863870552685763", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819239_863870559352429_7410937319043571054_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbCZAtGpwyoQ7kNvwFAgNl5&_nc_oc=AdrxfuALn_hhxwewDi2j135C57B5cRqOTkt2HHLRsAfD0xW1xbh00BITAPhbOD7FEFY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2T97dyeODvBwWUIk2VnbDDTEhIODE9lPcLA6Wrz9qMvQ&oe=69E760BD"}, {"file_name": "XOScreenshot3A.png", "id": "1210080424404365", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820270_1210080427737698_3529760868446975726_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FStsVd4rU3gQ7kNvwGi0NOv&_nc_oc=AdqBDdOpDj_sZob25qFnp19-bIzMigHS-GaBoRxTtesRqWIu0-5o1BmM_u6t32Fq99o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pDTtrLtxK6kkBhLa_rf9wXzB8DsdoUlmQNlMzotgRNw&oe=69E75FCF"}, {"file_name": "XOScreenshot2.png", "id": "1246441507331705", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821696_1246441513998371_4356389525926558762_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WK3-3nejMEQ7kNvwH78gJC&_nc_oc=Adpm-oGYnrhzrP_UdZVoMIAioO7npBH2B8SliDKLy22U0VjXjoB6kn3zelqZrB81ZHE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29AUMYzbEcstX-VGhe5_dIk0ZvrNKv2mFheaeJrSRNZg&oe=69E77121"}, {"file_name": "XOScreenshot5.png", "id": "879111811727351", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821568_879111815060684_6321537830146399437_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkEAaigDv8AQ7kNvwEfjNR8&_nc_oc=AdrPwVYaNbb5x1MCn6xk-m94XLbX9eg-CN_eLTxzvu4k_N-pqr2NOfgMhfQaCS0axbs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NPhi6_2GKlaRCeiy24b9OOvLO7nBvev5rcfFFsbL0YQ&oe=69E777AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeCover.png", "id": "25520480534250446", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823802_25520480557583777_8688390932071546728_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3s70L4N_eJkQ7kNvwFhMmAv&_nc_oc=Adrii8mtqhF0PlvzAhlaxX0G_E_LBUqu22HV7ir1x5Z2vSCYOOh6V-qOvkVYXCbh8k0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rlw2oQqlRKMuQs_iPofyHiswefUcZEREsymuUOKz6lw&oe=69E78C74"}, "display_name": "XO Odyssey", "keywords": ["VR", "Space", "Action", "Adventure", "RailsShooter"], "long_description": "## X O ODYSSEY \n\nAn intense, arcade-style VR space rail shooter that puts you in the cockpit of a starfighter and launches you through a connected series of deadly wormholes. Built for the Meta Quest 3, it combines classic on-rails shooting with modern VR immersion: you\u2019re strapped into a detailed cockpit, surrounded by deep space, and everything that wants you dead is coming straight at you.\n\nEach mission begins as your ship tears out of a wormhole into a hostile zone: asteroid belts, minefields, planetary debris, and enemy squadrons. You don\u2019t have to worry about steering the ship itself\u2014the invisible rail handles your flight path\u2014so you can focus completely on what matters: aiming, reacting, and surviving. You\u2019ll track targets with your head and controllers, swap between weapons, and constantly decide what to prioritize: the fighter in your face, the heavy cruiser powering up a broadside, or the asteroid that\u2019s seconds away from turning your ship into scrap.\n\nYour starfighter is armed with three core weapon types: rapid-fire lasers for precision and crowd control, heavy rockets for bursts of damage, and guided missiles for high-value targets at range. Enemies use similar weaponry, so every level becomes a dance of dodging incoming fire, weaving through environmental hazards, and timing your shots to maximize your score while staying alive. Smart target selection and accurate shooting are rewarded with higher multipliers and bigger end-of-run scores.\n\n{845591194753358}", "short_description": "XO ODYSSEY is a fast-paced VR space rail shooter where you blast through wormholes, dodge asteroids and crush enemy fleets from the cockpit of your star-fighter."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.balancedcode.com/xoodysseyprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Balanced Code GmbH", "support_website_url": null, "website_url": "https://www.balancedcode.com/xoodyssey.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25325728493745388"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1511350337276246"}, {"status": "PUBLISHED", "id": "1468444251530783"}, {"status": "PUBLISHED", "id": "1536935750943343"}, {"status": "PUBLISH
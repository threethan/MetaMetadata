909892061470173819_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QG2HFgjwsAQ7kNvwEsZxDL&_nc_oc=Ado8yNAsABOfpm0Xb2HQK21JTAtxnQPp_wKVrqvHiEckyqGOnV3PRXzCCstTXmpBbKU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQeRWohamwhuXcqdlGOgJQoXhiAJ6gBlClYW7HztxXNw&oe=6AFF16A9"}]}, "id": "859964116681277", "locale": "en_US", "screenshots": [{"file_name": "XOScreenshot1.png", "id": "1555867379171860", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818852_1555867382505193_1163784270704709176_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSydwdSUKNUQ7kNvwGpXwj5&_nc_oc=AdoQH1tAyGWlNqOImURLLowzKmyHnad_wZH-dsNPt10rBIg7YbVoF7PqSSn-sFey1K4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThJfsni7BN0PHVbZIU2NnZPqawsVJrBrem9qRRCv4bdg&oe=6AFF1890"}, {"file_name": "XOScreenshot4.png", "id": "863870552685763", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491819239_863870559352429_7410937319043571054_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gC1j4cswUiIQ7kNvwFaszkY&_nc_oc=AdpUboneoKz6k4xn7HCD6SMb9m_6sWO586AaU_5Nfmmyrjr52IJDIfrJF-3XJHEB5xc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXWFhZeSrMTpjsmcrP9jJ6f24lfRBKuwG9gQVZvRqyjQ&oe=6AFF16FD"}, {"file_name": "XOScreenshot3A.png", "id": "1210080424404365", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491820270_1210080427737698_3529760868446975726_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvvOsJTScZUQ7kNvwEpgyG2&_nc_oc=AdoIuEwChZx4cAp1gsR_Fwuz28gDI0bhDocGB_ej1AKWBhUTHhQb4_aLskw-iTLerVc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlVM1LjDBviurt5PBZCOG_AWPr1nOQ-fQBGG-zA2royg&oe=6AFF160F"}, {"file_name": "XOScreenshot2.png", "id": "1246441507331705", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821696_1246441513998371_4356389525926558762_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_I_t38nm1EMQ7kNvwGMuXZl&_nc_oc=Adq5S_v-h7LIfJT1LcMjj2oonnSiIAlKgNoI7gixIx-aH5udRDZ6ELHg9UIj1vjz1V4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREetnLSiwUfiUY-0Auv5s1rglmMjfmqE2yNCWXcxBhHw&oe=6AFF2761"}, {"file_name": "XOScreenshot5.png", "id": "879111811727351", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821568_879111815060684_6321537830146399437_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2cab1O6M8kQ7kNvwFrUAjx&_nc_oc=AdoNxxZqRV2bofP-A_hY9w0m_rvMFzlRZMP4dqYhZvmB4RDjeESCq3D86RMaObkzmG0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGP8tfCss-8tYLnLkCbs20J_lxb1543nNVLytmw7z_GA&oe=6AFF2DEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeCover.png", "id": "25520480534250446", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_25520480557583777_8688390932071546728_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyzK4DRtx2cQ7kNvwHgOiA-&_nc_oc=AdqHs6KmhNpT0hMN3X3LGO4wpzCihS0515x_7vWtOjuGZLoPO4wPDxLrfV2av96wxMQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXqFDo7MxXhT_3ykDTvZCjdElrkPa8qP8dxll9-smBjg&oe=6AFF0A74"}, "display_name": "XO Odyssey", "keywords": ["VR", "Space", "Action", "Adventure", "RailsShooter"], "long_description": "## X O ODYSSEY \n\nAn intense, arcade-style VR space rail shooter that puts you in the cockpit of a starfighter and launches you through a connected series of deadly wormholes. Built for the Meta Quest 3, it combines classic on-rails shooting with modern VR immersion: you\u2019re strapped into a detailed cockpit, surrounded by deep space, and everything that wants you dead is coming straight at you.\n\nEach mission begins as your ship tears out of a wormhole into a hostile zone: asteroid belts, minefields, planetary debris, and enemy squadrons. You don\u2019t have to worry about steering the ship itself\u2014the invisible rail handles your flight path\u2014so you can focus completely on what matters: aiming, reacting, and surviving. You\u2019ll track targets with your head and controllers, swap between weapons, and constantly decide what to prioritize: the fighter in your face, the heavy cruiser powering up a broadside, or the asteroid that\u2019s seconds away from turning your ship into scrap.\n\nYour starfighter is armed with three core weapon types: rapid-fire lasers for precision and crowd control, heavy rockets for bursts of damage, and guided missiles for high-value targets at range. Enemies use similar weaponry, so every level becomes a dance of dodging incoming fire, weaving through environmental hazards, and timing your shots to maximize your score while staying alive. Smart target selection and accurate shooting are rewarded with higher multipliers and bigger end-of-run scores.\n\n{845591194753358}", "short_description": "XO ODYSSEY is a fast-paced VR space rail shooter where you blast through wormholes, dodge asteroids and crush enemy fleets from the cockpit of your star-fighter."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.balancedcode.com/xoodysseyprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Balanced Code GmbH", "support_website_url": null, "website_url": "https://www.balancedcode.com/xoodyssey.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "support
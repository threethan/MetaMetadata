=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7D4Zm1vdBs3LI8jZnjUcmX0rCgruZRUzuQkbiOwhsFcQ&oe=6A0C82A9"}]}, "id": "859964116681277", "locale": "en_US", "screenshots": [{"file_name": "XOScreenshot1.png", "id": "1555867379171860", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491818852_1555867382505193_1163784270704709176_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-wEGU3dSR4Q7kNvwEWhlRa&_nc_oc=AdpnbUwmU4-AZW_sZz2igcocr-FGtV8LFc6pwou6_8IIAT16dJ8T_iY5Od37zdtWvWE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NRbMbNxCzFNfF0qWjw0H2u2orlUEhJMz0KaR9LKxURA&oe=6A0C8490"}, {"file_name": "XOScreenshot4.png", "id": "863870552685763", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819239_863870559352429_7410937319043571054_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GewsdnQWRZ0Q7kNvwGhhxuf&_nc_oc=Adp-wO7OnC-aqIXqg2z-1qTzREc2T3y-TL0--ey4YbyKYCYhiErCHDff5wqa83Pv_EI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WIPVScB2UJQtA2joLXkEFU7gAU8-sP16zYqtqUHYHNg&oe=6A0C82FD"}, {"file_name": "XOScreenshot3A.png", "id": "1210080424404365", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820270_1210080427737698_3529760868446975726_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1D8q2La5u4Q7kNvwH06B4b&_nc_oc=AdqX2E8tKejLeQz-mEXRKQLZQ27u29_12citeVqXzHyZbVajkT03_YG1gchYgAtqJM4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sslnlbH_-qd0NCZndtrNFbVEKBtUZNXmIZ7nz6g4skw&oe=6A0C820F"}, {"file_name": "XOScreenshot2.png", "id": "1246441507331705", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821696_1246441513998371_4356389525926558762_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfIpUfQhqLIQ7kNvwFOwKVy&_nc_oc=Ado-Ceby-nbVVDsgckUqIhlpUSqWUDee8yAGw3jJgKPSDG7y4JCViCG4pluC9Mtdycw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eGHG9069z4QH9lr8xtWG3se68Uu1jGSkCKh5O58EVBg&oe=6A0C5B21"}, {"file_name": "XOScreenshot5.png", "id": "879111811727351", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821568_879111815060684_6321537830146399437_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsbcCqIgHLYQ7kNvwH2RfWw&_nc_oc=AdoETsxkDX6m53WxvO9W8s9zWCB0dn_VJtqT4SK4Gg3KHr1QrOp4UzT7cMdRQlokK7k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55I8tt4oZHCAq7TaVFr6tpIBO_TtIh8li1Vh9AONJyuA&oe=6A0C61AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeCover.png", "id": "25520480534250446", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823802_25520480557583777_8688390932071546728_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCdEKdZa6qcQ7kNvwFoDNlD&_nc_oc=AdocHr24U0s1ILbHziqAzftwancPjTZGGFTxtKnU9NwWtd1qB0JOedY64X-hFh0h-oM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YQpv65VTyZexY7ZbYASKNuuePfmL0gLv2UDrSuwdeAA&oe=6A0C7674"}, "display_name": "XO Odyssey", "keywords": ["VR", "Space", "Action", "Adventure", "RailsShooter"], "long_description": "## X O ODYSSEY \n\nAn intense, arcade-style VR space rail shooter that puts you in the cockpit of a starfighter and launches you through a connected series of deadly wormholes. Built for the Meta Quest 3, it combines classic on-rails shooting with modern VR immersion: you\u2019re strapped into a detailed cockpit, surrounded by deep space, and everything that wants you dead is coming straight at you.\n\nEach mission begins as your ship tears out of a wormhole into a hostile zone: asteroid belts, minefields, planetary debris, and enemy squadrons. You don\u2019t have to worry about steering the ship itself\u2014the invisible rail handles your flight path\u2014so you can focus completely on what matters: aiming, reacting, and surviving. You\u2019ll track targets with your head and controllers, swap between weapons, and constantly decide what to prioritize: the fighter in your face, the heavy cruiser powering up a broadside, or the asteroid that\u2019s seconds away from turning your ship into scrap.\n\nYour starfighter is armed with three core weapon types: rapid-fire lasers for precision and crowd control, heavy rockets for bursts of damage, and guided missiles for high-value targets at range. Enemies use similar weaponry, so every level becomes a dance of dodging incoming fire, weaving through environmental hazards, and timing your shots to maximize your score while staying alive. Smart target selection and accurate shooting are rewarded with higher multipliers and bigger end-of-run scores.\n\n{845591194753358}", "short_description": "XO ODYSSEY is a fast-paced VR space rail shooter where you blast through wormholes, dodge asteroids and crush enemy fleets from the cockpit of your star-fighter."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.balancedcode.com/xoodysseyprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Balanced Code GmbH", "support_website_url": null, "website_url": "https://www.balancedcode.com/xoodyssey.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25325728493745388"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1511350337276246"}, {"status": "PUBLISHED", "id": "1468444251530783"}, {"status": "PUBLISHED", "id": "1536935750943343"}, {"status": "PUBLISH
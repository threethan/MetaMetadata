=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4a0v0dXUuyCoOWrJNe-TsoZ7ZZVT6TO6r3wdwlCT_5Vg&oe=6A0B3129"}]}, "id": "859964116681277", "locale": "en_US", "screenshots": [{"file_name": "XOScreenshot1.png", "id": "1555867379171860", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818852_1555867382505193_1163784270704709176_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbMn-PkiDHYQ7kNvwEFex6S&_nc_oc=AdpNDiv_rtGCmm-yKs8f5msm4h5suIhzdSCpfJrNrZQph_h8F3QVwn8rD9Xw15-FZNw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79JXLb5NDZImJqFyEzlOnJgMz-wCMgrowqeHrXfULzqw&oe=6A0B3310"}, {"file_name": "XOScreenshot4.png", "id": "863870552685763", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819239_863870559352429_7410937319043571054_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GewsdnQWRZ0Q7kNvwE5JwVY&_nc_oc=AdqqIgWXFeqMUVVOHJRegRx7Tjk_uVEx80Uah7r0JHfC5T5_yq5VXiQ1xyOx7CD59Ew&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eHwJqIt0a0-0dIdisHfVaONRX6M6urRCwx49XlPoCGw&oe=6A0B317D"}, {"file_name": "XOScreenshot3A.png", "id": "1210080424404365", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820270_1210080427737698_3529760868446975726_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1D8q2La5u4Q7kNvwEU5ZEN&_nc_oc=AdpwEOb4v16AZg48uR7GHf_xOT9tDA51HxvGxhO-jmHIg-A-GfX1QvTcrvlWZrAdio4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ddAyKFWG3YhpfIJegPF7lSRKQP8GiGqJe9DGQV-16og&oe=6A0B308F"}, {"file_name": "XOScreenshot2.png", "id": "1246441507331705", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821696_1246441513998371_4356389525926558762_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfIpUfQhqLIQ7kNvwEydea9&_nc_oc=AdorUrXmxU-QpO1soMbFgMCWj_inqurzTvOEjOwkCc19Lnp1Tza3KTUL1ESsBZ6whrc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54qRaroSWlYEHm7LHu2E5eNyhYQjaZuyV1ScR3izZ4OQ&oe=6A0B09A1"}, {"file_name": "XOScreenshot5.png", "id": "879111811727351", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821568_879111815060684_6321537830146399437_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTdzPYjQ2UcQ7kNvwGeTWsd&_nc_oc=AdoiGKl52VNrn4WPwhhisXKZatZg9PQ_mcdpBU1iv1nh1f5LqhtSEiY0J9VWaqRe0lE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CUVWdLSVqwEWks7dQcRsgdU3wu8mLUG0sYFdHQRDcAg&oe=6A0B102B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeCover.png", "id": "25520480534250446", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823802_25520480557583777_8688390932071546728_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0g74pvs-ZZ8Q7kNvwEx4LpK&_nc_oc=Ado6K4ijXMXlVth0b1FDKyKqflU3b6YTKuA7PVS_HYEHtzDb5MS78QH3LtkjxezkkT4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PqxpxpH6xxw82u-BmdGlgnfi_LYMRZ2MyjytFpodSQg&oe=6A0B24F4"}, "display_name": "XO Odyssey", "keywords": ["VR", "Space", "Action", "Adventure", "RailsShooter"], "long_description": "## X O ODYSSEY \n\nAn intense, arcade-style VR space rail shooter that puts you in the cockpit of a starfighter and launches you through a connected series of deadly wormholes. Built for the Meta Quest 3, it combines classic on-rails shooting with modern VR immersion: you\u2019re strapped into a detailed cockpit, surrounded by deep space, and everything that wants you dead is coming straight at you.\n\nEach mission begins as your ship tears out of a wormhole into a hostile zone: asteroid belts, minefields, planetary debris, and enemy squadrons. You don\u2019t have to worry about steering the ship itself\u2014the invisible rail handles your flight path\u2014so you can focus completely on what matters: aiming, reacting, and surviving. You\u2019ll track targets with your head and controllers, swap between weapons, and constantly decide what to prioritize: the fighter in your face, the heavy cruiser powering up a broadside, or the asteroid that\u2019s seconds away from turning your ship into scrap.\n\nYour starfighter is armed with three core weapon types: rapid-fire lasers for precision and crowd control, heavy rockets for bursts of damage, and guided missiles for high-value targets at range. Enemies use similar weaponry, so every level becomes a dance of dodging incoming fire, weaving through environmental hazards, and timing your shots to maximize your score while staying alive. Smart target selection and accurate shooting are rewarded with higher multipliers and bigger end-of-run scores.\n\n{845591194753358}", "short_description": "XO ODYSSEY is a fast-paced VR space rail shooter where you blast through wormholes, dodge asteroids and crush enemy fleets from the cockpit of your star-fighter."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.balancedcode.com/xoodysseyprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Balanced Code GmbH", "support_website_url": null, "website_url": "https://www.balancedcode.com/xoodyssey.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25325728493745388"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1511350337276246"}, {"status": "PUBLISHED", "id": "1468444251530783"}, {"status": "PUBLISHED", "id": "1536935750943343"}, {"status": "PUBLISH
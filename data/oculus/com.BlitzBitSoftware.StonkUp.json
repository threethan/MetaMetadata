QkPuyftfSiBr1d79jxAiU7L8mjKn8T6WPY302fVLoK38c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAln71BRtIogPq23p2ToQEaHQ8xM-NbbLUlFtzCOgvMZA&oe=6A6B6916"}, {"file_name": "screen129.png", "id": "1247135006860426", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619659_1247135010193759_8974938779275586333_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJ8YoWFOq5EQ7kNvwGgFqIn&_nc_oc=AdpBsiftwDeU_nH4jAoftTQWzZxRhQ_7MYimWvoCUhgfmUBVnZaK5e78J2yvw5gfwZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6IZyWy1nxN7QCG1w6ibJ6rFLcmlZYeDBZedEWpTRzFA&oe=6A6B4FEC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Barrel Bandits", "keywords": ["OpenWorld", "Cars", "Tuning", "Guns", "Sandbox"], "long_description": "Barrel Bandits is a desert-themed multiplayer, where you and your friends find creative ways to earn money and explore a dusty open world. Start small and gradually unlock new activities as you move up the chain.\n\nBuy vehicles, tweak their style, and make deliveries across the map. Fuel stations, odd jobs, and questionable side gigs are all part of the journey. Team up, cause a little chaos, or just enjoy the ride.\n\nThere\u2019s no single path to success \u2014 just a wide open world and plenty of ways to make your mark.", "short_description": "Barrel Bandits is a gritty outlaw game where you and your friends smuggle oil, run rigs, and chase fortune in a lawless open-world desert."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/barrel-bandits/policy", "developer_terms_of_service_url": null, "publisher_name": "YueWorks", "support_website_url": null, "website_url": "https://sites.google.com/view/barrel-bandits/startseite", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}
cb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEX4FBAq71oQ7kNvwGDKxOB&_nc_oc=AdpEdkHpEnXZsScAIM0sF50rIv8HbmlFC7eFOmM5XD9x-3e-UwdlNnyRUJku-e8BHsw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdHZdD9EI3GmZAMP1ahpFUjZtyEwC1ObgcpHZeLewJDQ&oe=6AC5195A"}, {"file_name": "Store_2026-09-29_20-07-49-171.png", "id": "1420093563033282", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823790_1420093566366615_743410155110103059_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MttvcdwAXiIQ7kNvwFlDAnk&_nc_oc=AdrOZo4wuBDWcA8Fz_X4hJCEyRWsKgh9R-zjw-J5mLPCpyU4NbKXtvhTlyFqBmDQ0R8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcdRNWGIKYToD7R-By7TxVTWXkxFTrmaGNJvwmjdc4oQ&oe=6AC524BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "28940388682286060", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823279_28940388702286058_5749478649587971681_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_bUZStROdUQ7kNvwEqpbxt&_nc_oc=AdrTbuzHtredLqLtkCHxDYt0WT2a774ZcVYXGWwj8V112zflsAon99K_gYLf_xrna08&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcMqMjSrlv0J2shHiq2_nTpCMMR8cZJBGbpoO5Qy7g6A&oe=6AC517E1"}, "display_name": "Gangs of Los Barros", "keywords": ["Cars", "DIrtbikes", "OpenWorld", "Guns", "Crime"], "long_description": "Gangs of Los Barros drops you into a living open world city. See a car you like, take it, hit the streets and free roam a city full of traffic, pedestrians and real players from around the world.\n\nRun the streets, take down NPCs and rival players, and stack up cash. Spend that money on new vehicles, then tune and customize them the way you want. Faster engines, fresh paint, your own style on every ride.\n\nTeam up with friends, start a gang and fight rival crews for control of the city. Claim territory that keeps paying you as long as you can hold it. Just watch your wanted level, because the more heat you pull, the harder they come after you.\n\nGrab a car and take over Los Barros.", "short_description": "Gangs of Los Barros is an open world action game set in a huge living city. Free roam streets packed with cars, traffic and NPCs. Jack and drive tons of vehicles, tune and customize your rides, make money, join a gang and take over the city with friends online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/barrel-bandits/policy", "developer_terms_of_service_url": null, "publisher_name": "YueWorks", "support_website_url": null, "website_url": "https://sites.google.com/view/barrel-bandits/startseite", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "28079611558406571"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825470_1091401523260855_5861254910073469163_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_y8Z_DL2o68Q7kNvwGbzjLo&_nc_oc=AdqkhaDiBtxVFJEItboDbHduXtWof3aT5KkV_4hXV3NWGUAa898Fkby8ErzmJ_1ujO8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQON26EsBnDD9pw_V1BER4UZYe0zQ1PQjHp-btNT5ZevYA&oe=6AC4F1A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gangs of Los Barros", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAME
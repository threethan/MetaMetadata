cb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnyPfUg8Cr0Q7kNvwHgHVkL&_nc_oc=Adr4Bt_EyRDg0CKZy5eioWe2LbQF7j035xdynNfjQTmB3y2PTvFoG8o5PEmqHQqLNEs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdOBA4yjg703Yt6rEMSFcL_WDmJaFjIY0Sde7GeqvLAQ&oe=6AE4BD5A"}, {"file_name": "Store_2026-09-29_20-07-49-171.png", "id": "1420093563033282", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823790_1420093566366615_743410155110103059_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYAf0vNTH64Q7kNvwFyJsgV&_nc_oc=AdrzFIvCng0WnNkwXVogMBwrKZ_OjUXXIgiwMDyDRfZgpjD0RlSPazQ13Dcrya240uE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiNdgB0cO_BHnqhRJMzcY3euz3CPeqj8daM_jX3Rg4XQ&oe=6AE4907A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "28940388682286060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823279_28940388702286058_5749478649587971681_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wX_tgKYl54oQ7kNvwFq9rbm&_nc_oc=AdoTqgLKKQjfj34v0EFlfiopxNjEhVxSstE0CVdx6mF6wSydeK2CWZkXIDAPf-0-Sp4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXdAJ9IhuGSzyCKIk0kKPjlA1EThdOpcUWE0_hTloEtQ&oe=6AE4BBE1"}, "display_name": "Gangs of Los Barros", "keywords": ["Cars", "DIrtbikes", "OpenWorld", "Guns", "Crime"], "long_description": "Gangs of Los Barros drops you into a living open world city. See a car you like, take it, hit the streets and free roam a city full of traffic, pedestrians and real players from around the world.\n\nRun the streets, take down NPCs and rival players, and stack up cash. Spend that money on new vehicles, then tune and customize them the way you want. Faster engines, fresh paint, your own style on every ride.\n\nTeam up with friends, start a gang and fight rival crews for control of the city. Claim territory that keeps paying you as long as you can hold it. Just watch your wanted level, because the more heat you pull, the harder they come after you.\n\nGrab a car and take over Los Barros.", "short_description": "Gangs of Los Barros is an open world action game set in a huge living city. Free roam streets packed with cars, traffic and NPCs. Jack and drive tons of vehicles, tune and customize your rides, make money, join a gang and take over the city with friends online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/barrel-bandits/policy", "developer_terms_of_service_url": null, "publisher_name": "YueWorks", "support_website_url": null, "website_url": "https://sites.google.com/view/barrel-bandits/startseite", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "28079611558406571"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825470_1091401523260855_5861254910073469163_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CR3i0VNi30Q7kNvwHQbyuQ&_nc_oc=Adp54A6RNCsOeL6QPukdbxxITchfyKAZzA54ZjL1yuFvN1q1xDBN0-BVFLe0QvDcwOk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3QnNhME9ZpG0UhkOlxdlmbB4-PDVTxkIJODNoH-3uzg&oe=6AE495A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gangs of Los Barros", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAME
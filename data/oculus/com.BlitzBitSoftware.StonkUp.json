cb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhP3etzt28gQ7kNvwGmK6z1&_nc_oc=Adq1Fq-2nEaxjp9MELEqQllnrT3Z1ALWYY8znQdl4xpuSRwmEscVaHGkJCQSzCBrwkE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWsuKX75m6EEkX4Llm43FwZeKhJzCLtQZ9-zulhI-Hpg&oe=6AE8B1DA"}, {"file_name": "Store_2026-09-29_20-07-49-171.png", "id": "1420093563033282", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823790_1420093566366615_743410155110103059_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oy63Rn5lTjEQ7kNvwGap9Km&_nc_oc=AdqOyhnJdJuFb3AyFyURKFWHk-Za3NEEDP34BrpFqtxp67VW62cByfHmn49A5cDVWG8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAQFKZ_wL95gr_65YU61s9YVeroUxh_6wEE6-aetUrbg&oe=6AE8BD3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "28940388682286060", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823279_28940388702286058_5749478649587971681_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4CusnmqmUYQ7kNvwECvEnH&_nc_oc=AdoWEeQxt_CBpGXLmnsHc6PaQwtcl0YM8usSSpGT3UHLFE8aKeD_qJFqdCyZyde9X3Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEF-xTSGu89lHAW78aUGpYKGxzbNys8k-ak6N4irh1oA&oe=6AE8B061"}, "display_name": "Gangs of Los Barros", "keywords": ["Cars", "DIrtbikes", "OpenWorld", "Guns", "Crime"], "long_description": "Gangs of Los Barros drops you into a living open world city. See a car you like, take it, hit the streets and free roam a city full of traffic, pedestrians and real players from around the world.\n\nRun the streets, take down NPCs and rival players, and stack up cash. Spend that money on new vehicles, then tune and customize them the way you want. Faster engines, fresh paint, your own style on every ride.\n\nTeam up with friends, start a gang and fight rival crews for control of the city. Claim territory that keeps paying you as long as you can hold it. Just watch your wanted level, because the more heat you pull, the harder they come after you.\n\nGrab a car and take over Los Barros.", "short_description": "Gangs of Los Barros is an open world action game set in a huge living city. Free roam streets packed with cars, traffic and NPCs. Jack and drive tons of vehicles, tune and customize your rides, make money, join a gang and take over the city with friends online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/barrel-bandits/policy", "developer_terms_of_service_url": null, "publisher_name": "YueWorks", "support_website_url": null, "website_url": "https://sites.google.com/view/barrel-bandits/startseite", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "28079611558406571"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825470_1091401523260855_5861254910073469163_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJrlLQ63EYUQ7kNvwFYMf_J&_nc_oc=AdoGyrXzalW_LH4Mm964aTliTDxrlhjxhvD61KesSTyfmf0DzoCm_LdwISOhd6zSopE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_5LZehQ-YBkXA0B9b9LJi7r5skW08NJQwh7y8ZBuVTw&oe=6AE8C268"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gangs of Los Barros", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAME
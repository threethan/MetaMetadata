pDrSc9VXmxCKr7zVSr9hnvV23yxI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEComW-Rca8tUSqEO-iGnkvBYDHgSB44D_rJe9pxaFPSw&oe=6A8AF347"}, {"file_name": "LosBarros_20260723_150931_880.png", "id": "1569663451225539", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619187_1569663454558872_4098017157822658063_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6uY6GhYCnUQ7kNvwHAJ8MN&_nc_oc=AdrRXI94Yosq6MCfrGpJFToxRTW4IeIzbQzCWzknAelzxAYk01A6fHEa99dCoR3JuEo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1h-cruRxYm8F2Rob2Lo9_YizwKjHXWrVJhQTQ-1VUsA&oe=6A8AF199"}, {"file_name": "LosBarros_20260723_150249_793.png", "id": "2166719367222987", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499308699_2166719370556320_5635755910976479660_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYzyYkYr3WAQ7kNvwHlYL9D&_nc_oc=Adq2hoXDOSpsv21M-JT6ShPod6w6D-aZL8Z1gCE7efvGnY7xHC5rdjRD5RA-Ya16sxo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8uMjQurnZLoVJIxSFF_hqEENOo_rTXXnLVKpJ2OB0xg&oe=6A8AE771"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_bike.png", "id": "4367964540144762", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499308699_4367964546811428_901203686710697534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTckDLTmJAMQ7kNvwFqqRiq&_nc_oc=AdqR3DesiYvkeLCo0xxq8KkiyRu_9a8CnUrYSOjkPznaQbEbngiLGhHD1OL-uNIHoKw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFLFxK1LDRzMRDCwrnJ44P2IEg3AzqeXFr93YsKvV7_Q&oe=6A8AEA42"}, "display_name": "Gangs of Los Barros", "keywords": ["Cars", "DIrtbikes", "OpenWorld", "Guns", "Crime"], "long_description": "Gangs of Los Barros drops you into a living open world city. See a car you like, take it, hit the streets and free roam a city full of traffic, pedestrians and real players from around the world.\n\nRun the streets, take down NPCs and rival players, and stack up cash. Spend that money on new vehicles, then tune and customize them the way you want. Faster engines, fresh paint, your own style on every ride.\n\nTeam up with friends, start a gang and fight rival crews for control of the city. Claim territory that keeps paying you as long as you can hold it. Just watch your wanted level, because the more heat you pull, the harder they come after you.\n\nGrab a car and take over Los Barros.", "short_description": "Gangs of Los Barros is an open world action game set in a huge living city. Free roam streets packed with cars, traffic and NPCs. Jack and drive tons of vehicles, tune and customize your rides, make money, join a gang and take over the city with friends online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/barrel-bandits/policy", "developer_terms_of_service_url": null, "publisher_name": "YueWorks", "support_website_url": null, "website_url": "https://sites.google.com/view/barrel-bandits/startseite", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "27088317010869369"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499307931_1013923344721142_4058394503797675778_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNW3FYKX7iQQ7kNvwHW25Hi&_nc_oc=AdqBNu6J4mPdFMAM0Ky5CbOFyhI6mvjP
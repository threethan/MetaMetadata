8F6C"}, {"file_name": "screen74.png", "id": "629337562996996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828899_629337566330329_918444763545908554_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPZt1E5ZmngQ7kNvwGsbTMu&_nc_oc=AdkjpNiFtw65lIbuP06LMbziCxOr4VdSZuxn8GtPoOYi11sOdrqimibi-lDJ1VVS2pI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs93UWko0S8AfDnNGFLjvg4QD7Zf7_WB7ynWkZ7a2iJaA&oe=69999256"}, {"file_name": "screen129.png", "id": "1247135006860426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619659_1247135010193759_8974938779275586333_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ks6zi_fc4asQ7kNvwHq9BEv&_nc_oc=Adm5wI4pRp3U0d-6Kvo_Ud8HFvZs6lR4GOYYe99v8i0-EeHXRLBpaVFyEkXvhsYI2OI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvB2eceBtwgH0-lmEqrSXfisk-PmIs79Zijenu79X0rIg&oe=6999B16C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Barrel Bandits", "keywords": ["OpenWorld", "Cars", "Tuning", "Guns", "Sandbox"], "long_description": "Barrel Bandits is a desert-themed multiplayer, where you and your friends find creative ways to earn money and explore a dusty open world. Start small and gradually unlock new activities as you move up the chain.\n\nBuy vehicles, tweak their style, and make deliveries across the map. Fuel stations, odd jobs, and questionable side gigs are all part of the journey. Team up, cause a little chaos, or just enjoy the ride.\n\nThere\u2019s no single path to success \u2014 just a wide open world and plenty of ways to make your mark.", "short_description": "Barrel Bandits is a gritty outlaw game where you and your friends smuggle oil, run rigs, and chase fortune in a lawless open-world desert."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/barrel-bandits/policy", "developer_terms_of_service_url": null, "publisher_name": "YueWorks", "support_website_url": null, "website_url": "https://sites.google.com/view/barrel-bandit
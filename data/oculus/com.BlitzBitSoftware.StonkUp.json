5Du3qOoVS6vwRBYeM6sqFFunICW8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDhnlJieKVTSnxEshDMD1fEbTgnRQEEQE_PGBsudm7eg&oe=6A95B787"}, {"file_name": "LosBarros_20260723_150931_880.png", "id": "1569663451225539", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619187_1569663454558872_4098017157822658063_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEbSRGemqQcQ7kNvwHFmlhp&_nc_oc=Adp5WHzPzFfp74rS77UpoTdqmVzSB2CLz7WjaW9PN4mFMPHhZt0IMiKYRXKcscbBPhY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHd4uzerjGuAyjD-I84IfVjRyCqUUXpD-uA8O1iw-Id2Q&oe=6A95B5D9"}, {"file_name": "LosBarros_20260723_150249_793.png", "id": "2166719367222987", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308699_2166719370556320_5635755910976479660_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9A1le8IFfIQ7kNvwFeLvNk&_nc_oc=AdowQC96KSqFn3Y1cy3QzgMqJYj8P-3e7YC1HODa4V1De6Dip13ysF0XCakerRYBHiI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHuNUpbX_mUJq4kRebL3R0rGnOmFHlPpjU_i2PScf5vw&oe=6A95ABB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_bike.png", "id": "4367964540144762", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308699_4367964546811428_901203686710697534_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gmFVbt9JcMQ7kNvwGZfnPq&_nc_oc=AdrPNMRnDu1TWoGZ4USX3VbjIsmMyFrhjM9qAuivZUp-QkfvNbyfcVFJ-Z8I0s0F5Kw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_-w5QzmXME3XWj7mXNXa0lcbcSO_rKTQNLh9vOlAFxg&oe=6A95AE82"}, "display_name": "Gangs of Los Barros", "keywords": ["Cars", "DIrtbikes", "OpenWorld", "Guns", "Crime"], "long_description": "Gangs of Los Barros drops you into a living open world city. See a car you like, take it, hit the streets and free roam a city full of traffic, pedestrians and real players from around the world.\n\nRun the streets, take down NPCs and rival players, and stack up cash. Spend that money on new vehicles, then tune and customize them the way you want. Faster engines, fresh paint, your own style on every ride.\n\nTeam up with friends, start a gang and fight rival crews for control of the city. Claim territory that keeps paying you as long as you can hold it. Just watch your wanted level, because the more heat you pull, the harder they come after you.\n\nGrab a car and take over Los Barros.", "short_description": "Gangs of Los Barros is an open world action game set in a huge living city. Free roam streets packed with cars, traffic and NPCs. Jack and drive tons of vehicles, tune and customize your rides, make money, join a gang and take over the city with friends online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/barrel-bandits/policy", "developer_terms_of_service_url": null, "publisher_name": "YueWorks", "support_website_url": null, "website_url": "https://sites.google.com/view/barrel-bandits/startseite", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "27088317010869369"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307931_1013923344721142_4058394503797675778_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLgCRrt8p6cQ7kNvwEGsAdn&_nc_oc=Ado6dwHwLRSoMXV71yG2cRtj_tN1vSoR
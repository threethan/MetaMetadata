83EC"}, {"file_name": "screen74.png", "id": "629337562996996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828899_629337566330329_918444763545908554_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIc9dtzHh3UQ7kNvwEx7qQm&_nc_oc=AdmZMz4iKSQiVT5U-SUzfJnzeq3-L4777Qf3q-j7NHHQ1dzDO6r97ZagIc979SIqGa4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuYUZ1qvnhgZcNM5I01l-OffmKyequPX5zBvRHpLIW8gw&oe=699D86D6"}, {"file_name": "screen129.png", "id": "1247135006860426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619659_1247135010193759_8974938779275586333_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67hhm8rAwJkQ7kNvwHpKpXR&_nc_oc=Adl_VEO2rjLLkjfXQ3d1xk1RmJMKQZ7U1TUhaw1wYsGPZIk3dA2L53nHff3tOXU31Ys&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs6NehqMtarVCxUYij8Nj_91ABosgyi3fO40MUv1x6MYA&oe=699DA5EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Barrel Bandits", "keywords": ["OpenWorld", "Cars", "Tuning", "Guns", "Sandbox"], "long_description": "Barrel Bandits is a desert-themed multiplayer, where you and your friends find creative ways to earn money and explore a dusty open world. Start small and gradually unlock new activities as you move up the chain.\n\nBuy vehicles, tweak their style, and make deliveries across the map. Fuel stations, odd jobs, and questionable side gigs are all part of the journey. Team up, cause a little chaos, or just enjoy the ride.\n\nThere\u2019s no single path to success \u2014 just a wide open world and plenty of ways to make your mark.", "short_description": "Barrel Bandits is a gritty outlaw game where you and your friends smuggle oil, run rigs, and chase fortune in a lawless open-world desert."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/barrel-bandits/policy", "developer_terms_of_service_url": null, "publisher_name": "YueWorks", "support_website_url": null, "website_url": "https://sites.google.com/view/barrel-bandit
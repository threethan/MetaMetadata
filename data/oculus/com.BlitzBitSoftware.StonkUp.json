dbox"], "long_description": "Barrel Bandits is a desert-themed multiplayer, where you and your friends find creative ways to earn money and explore a dusty open world. Start small and gradually unlock new activities as you move up the chain.\n\nBuy vehicles, tweak their style, and make deliveries across the map. Fuel stations, odd jobs, and questionable side gigs are all part of the journey. Team up, cause a little chaos, or just enjoy the ride.\n\nThere\u2019s no single path to success \u2014 just a wide open world and plenty of ways to make your mark.", "short_description": "Barrel Bandits is a gritty outlaw game where you and your friends smuggle oil, run rigs, and chase fortune in a lawless open-world desert."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/barrel-bandits/policy", "developer_terms_of_service_url": null, "publisher_name": "YueWorks", "support_website_url": null, "website_url": "https://sites.google.com/view/barrel-bandits/startseite", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "9829656833828655"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1018807894112796"}, {"status": "PUBLISHED", "id": "3667297600092285"}, {"status": "PUBLISHED", "id": "1672519877335307"}, {"status": "PUBLISHED", "id": "1557389078614370"}]}, "baseline_offer": {"
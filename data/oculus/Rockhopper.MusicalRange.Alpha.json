_7491144707144836659_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4FcSYKdnS0Q7kNvwF38CaH&_nc_oc=AdqACCZkmoqpUVmZGIi2ZEbHNsCqnLbeG63JbfZQO0EHnnDRYlS1SdqNn3cuu5qHo5Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29dlKLILyxG0qt25f6VbAX6j6Iak-R0UbsqVDQAlLF8A&oe=69DCFAF0"}, {"file_name": "Screenshot_5_HQ.png", "id": "1056010235521940", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003279_1056010238855273_8892509587549964860_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_lB0WQp9KQQ7kNvwHhMSQ7&_nc_oc=AdpCm3xeSQJVoocq_-iQQtmiMZuTQ0EYNMMtNWJlETU1UOhKRmHTV5MDA4xdYKHWM24&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qbw6puFU0XSNg7Q9bdSQNjyO6s7c0sm4pjWgyOHn_7A&oe=69DCD451"}, {"file_name": "Screenshot_8_HQ.png", "id": "6579317878862576", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982685_6579317882195909_860934616259707238_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBA9YM7XV5gQ7kNvwEXSrN6&_nc_oc=Adq8Zcf87ZxOfv12XqO0LhvbJ2Yk7NDc6Us7XsD4E35V6eUx7Ruzslpn8m3yv8FSu_k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ksATWTJ7ETF1VwTomgR480MreNelPT4j4nMTCAd7LDQ&oe=69DCE504"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "3611458932476607", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572942_3611458935809940_8171731785683107976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jR2Wvv-VIFUQ7kNvwGNrVSl&_nc_oc=AdpRW-T5FbBr0L4QUb7ppir5I8HdnynMinTtQTJ4Xbcy804YC0AaUVTak-KsPNE7378&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2f8eWOfGeu8YDdF-tO4_GE7H7mDqb0X32Ye51ZzRFy5A&oe=69DCE669"}, "display_name": "Musical Range", "keywords": [], "long_description": "Rock by shooting notes! Keep your audience hyped and energized as you perform, live the Rockstar dream!\n\nKey Features \n- A Unique Rhythm Game: Play music by shooting, punching, moving, and smashing notes! \n- Rock, Play and Perform more than 25 great official songs. \n- Campaign mode: Start your journey and grow your music skills.\n- Tailor your play style with four difficulties and many modifiers. \n- Electrify your audience by performing in 5 out of this world stages! \n- Find your sound tone by trying the 4 different instrument sounds included. \n- Discover and grow your music library with Custom Songs. \n- Witness yourself climb up the leaderboards as you master your skills and performance. \n\nAre you ready to take the stage? Feel the music and get ready to ROCK the WORLD with MUSICAL RANGE!", "short_description": "Rock by shooting notes! Keep your audience hyped and energized as you perform, live the Rockstar dream!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.musicalrange.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Rockhopper Studios", "support_website_url": null, "website_url": "https://www.musicalrange.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8594264594005167"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035304_1620288541898806_9088938246447333277_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKI-uMFbNt4Q7kNvwF5kmjg&_nc_oc=Adoa5vnvokK0Ab2jKuVeD42WXA361jE5-3Eh_J50WpuB3IBgxKaDpG3ooOJIl
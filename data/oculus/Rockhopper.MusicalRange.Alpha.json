aeG-XfwjVs0loCzMVIFDYn77KEyHlfc-QgwNunm6mbr2DhC7XHU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvnI_pgU1dFAOSejez_gyDm3Rw0P89q6OVy0_lfJwPdEA&oe=699DB2F0"}, {"file_name": "Screenshot_5_HQ.png", "id": "1056010235521940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003279_1056010238855273_8892509587549964860_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYELD2BXiF0Q7kNvwEiLCC3&_nc_oc=AdkL0KwCZvOkMdxb_92mtt8bIwGJJpZrF2nCpK9da7Fan7meHUOjRtoFNKydzPOJRlY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfttlqX0LZqoLdO76vIFg04TEeMmg_mjryTi9HgiAZie0g&oe=699D8C51"}, {"file_name": "Screenshot_8_HQ.png", "id": "6579317878862576", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982685_6579317882195909_860934616259707238_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXzmL1Vu5PMQ7kNvwGTSIVc&_nc_oc=AdkTQd2B7gPDUrYH7tyaMBrF0KKv4LMer6ewQgT4ofJ52FMCIYb6JEUKbA_CEhyTsOU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftCFsGHqRcBCUXEpswE3Q8OIj-73vKjuWuJiJaCkJVsDA&oe=699D9D04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "3611458932476607", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572942_3611458935809940_8171731785683107976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sG7Ms7NgtdMQ7kNvwF5wQEG&_nc_oc=Admb8lWviwhvZqIAUfNu7FHmWCWStZJotlYUt2sWwVqLMC7JkjBpJddZTGHhGaRFhT8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu02WHSrEiBrhus89Vpj_mgJLZSOXW4S7d2UYD4zif_9A&oe=699D9E69"}, "display_name": "Musical Range", "keywords": [], "long_description": "Rock by shooting notes! Keep your audience hyped and energized as you perform, live the Rockstar dream!\n\nKey Features \n- A Unique Rhythm Game: Play music by shooting, punching, moving, and smashing notes! \n- Rock, Play and Perform more than 25 great official songs. \n- Campaign mode: Start your journey and grow your music skills.\n- Tailor your play style with four difficulties and many modifiers. \n- Electrify your audience by performing in 5 out of this world stages! \n- Find your sound tone by trying the 4 different instrument sounds included. \n- Discover and grow your music library with Custom Songs. \n- Witness yourself climb up the leaderboards as you master your skills and performance. \n\nAre you ready to take the stage? Feel the music and get ready to ROCK the WORLD with MUSICAL RANGE!", "short_description": "Rock by shooting notes! Keep your audience hyped and energized as you perform, live the Rockstar dream!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.musicalrange.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Rockhopper Studios", "support_website_url": null, "website_url": "https://www.musicalrange.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8594264594005167"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035304_1620288541898806_9088938246447333277_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATIJdu0s3MwQ7kNvwGtDZFV&_nc_oc=AdnEFD9nHmnw3v5CGg4308SjZoE5WH9AgpAwJHNl8twMRUQhIsf-Fb_wNQby8LtQDPc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs726WW82lWRidvJFb8LXIl5M2Xx8M98c-75L7eKw9bZw&oe=699D9C13"}, "is_concept": false, "is_test": false, "is_trial
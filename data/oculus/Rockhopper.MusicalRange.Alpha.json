content-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJuDl39CbFk33tTfqpda9SN1eVglSeu31tGpGrFJD5BA&oe=6A9ECF5A"}, {"file_name": "ss_3.png", "id": "5317219005030610", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982699_5317219018363942_3624416262885863649_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0YUYPOOTgEQ7kNvwFF4fO3&_nc_oc=AdptTd7J7vwf9Sp5N3v58lZKu2bH-JQ2zVBubw8oEA55J7g80DuiLBLq8jzA0BR8LFQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAwGawC-Rehreq-z8NY-JSFJJyQSGgoNPb3gTkNLi57Q&oe=6A9EB418"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreAssets_VideoThumbnail.png", "id": "1347063032487630", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75250461_1347063035820963_5564817841708634521_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aC6uxjGEE50Q7kNvwGUfUCf&_nc_oc=AdokQ5TLFkBQs6avlGlaQmnN4NyAoF5rVd81Bde9h1T7gbe_KrqxupsQfbG6i9AccwA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJglaBNfweX1ke7iy6t9ketynvL66fWDjbZns7tLckFqA&oe=6A9ED6E8"}, "display_name": "Musical Range", "keywords": [], "long_description": "Play a Rock Solo With Guns\nGrab a pair of guns and feel the power of music. Don't just play to the beat, PLAY the notes in the songs.\n\nDevelop Your Own Styles\nPerform music with your body movements. Drag the note around to change the pitch, volume, and sound. No two performances will be identical!\n\nCustom Songs\nIt's easy to add your own music. Drop a midi and sound file to your private library folder and your music will be ready for you to play.\n\nBecome a Rockstar\nPractice makes perfect. Master a song and show it to the world. Each song has its own leaderboard. See where your friends and other players shine and become a superstar!\n\nGreat Music\nMusical Range has a expanding diverse catalog. From original songs, videogame soundtracks (Still Alive from Portal), to amazing collaborations with talented artists.", "short_description": "Play a rock solo with guns! Musical Range is a VR Musical Experience where you can play music by shooting guns. Perform music with your body movements. Choose a track from the included playlist or create your own custom songs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.musicalrange.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Rockhopper Studios", "support_website_url": null, "website_url": "https://www.musicalrange.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "460381692305212"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7265107236920916", "version": "1.0"}, "id": "460192789028480", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4621135924651407", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7265107236920916"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1728103270, "id": "8309227685842194", "versio
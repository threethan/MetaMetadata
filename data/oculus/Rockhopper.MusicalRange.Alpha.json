_7491144707144836659_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XO9MIUpNlhUQ7kNvwHaSoE8&_nc_oc=AdqCQkGVOIKhRv_BkEGrVTMdAW8pCmFPCXJfdstooVyd3wp-vLq99kSJkyScLfP6nuk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcb9fCaB0xc-Gdy1AHi30F9DlE4RK7bo-Aayo5WrpmEQ&oe=6A900EB0"}, {"file_name": "Screenshot_5_HQ.png", "id": "1056010235521940", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39003279_1056010238855273_8892509587549964860_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yx3d0MSYgG8Q7kNvwFv6Iuc&_nc_oc=AdqsigSDfIGoeI4OYw3rXKAPWnCI7JdBz213E2I-o_KEv4Vvpb5Q1zpzuhJahl9W64s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTL0t7_yjwIoo6GSXNmn-4GygSlEPlPM199CV4zHd3ag&oe=6A902051"}, {"file_name": "Screenshot_8_HQ.png", "id": "6579317878862576", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982685_6579317882195909_860934616259707238_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHptVlxtgSMQ7kNvwFacYYS&_nc_oc=Adoi9Qa38WaRibVAq3Ecw5X5ZioYBExReNdiEVu1Zzgb_Mj0Mo6s-mvdyi1ydMNsUD0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0_PEDYHEUoYU1EQQzHbUNF7oKULxUGnlyNRRemTs11Q&oe=6A903104"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "3611458932476607", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572942_3611458935809940_8171731785683107976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4YWgRDpNDMQ7kNvwG-_iQB&_nc_oc=AdooM9fZ5fF-VLxMfngFm6ff0NCkExZQTCoibKgYGR0ImEqvkKfTEcRGeC8eFWXVy0c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXMY2SZwqD_vOPhQ4DErKlg-wng7POtR4Gtl4R2RYlJg&oe=6A903269"}, "display_name": "Musical Range", "keywords": [], "long_description": "Rock by shooting notes! Keep your audience hyped and energized as you perform, live the Rockstar dream!\n\nKey Features \n- A Unique Rhythm Game: Play music by shooting, punching, moving, and smashing notes! \n- Rock, Play and Perform more than 25 great official songs. \n- Campaign mode: Start your journey and grow your music skills.\n- Tailor your play style with four difficulties and many modifiers. \n- Electrify your audience by performing in 5 out of this world stages! \n- Find your sound tone by trying the 4 different instrument sounds included. \n- Discover and grow your music library with Custom Songs. \n- Witness yourself climb up the leaderboards as you master your skills and performance. \n\nAre you ready to take the stage? Feel the music and get ready to ROCK the WORLD with MUSICAL RANGE!", "short_description": "Rock by shooting notes! Keep your audience hyped and energized as you perform, live the Rockstar dream!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.musicalrange.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Rockhopper Studios", "support_website_url": null, "website_url": "https://www.musicalrange.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8594264594005167"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035304_1620288541898806_9088938246447333277_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yif2dQm5HQMQ7kNvwGtmsO3&_nc_oc=AdrZTbrV1BITlo7B3bMN3jTml9XM9CRRwFz2MKMY9qLdXyfUYSQcmB--0olDw
_7491144707144836659_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ki29iyM5iWoQ7kNvwHdXE_f&_nc_oc=Adq5XsVHGFwx3bNKoI8ljwrQzbZcgC7e5M78ZDle5i7dwFjwvfYtWTy6OzfHBwCiNIU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JfyKm0SwCoD3VpRoaj6yoKSxMiDG3fZccX35PkX72lg&oe=6A412CF0"}, {"file_name": "Screenshot_5_HQ.png", "id": "1056010235521940", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003279_1056010238855273_8892509587549964860_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTb8ywyKwskQ7kNvwHPm8L0&_nc_oc=Adq9XipTJslQhmpvxp8-5Ynm3BDyktqYwotQ4GrmrCEZaNXppxBn6OURSTEhkzyVOZU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-otRgFBDnFSWUpczipgZ5fhT80xZ_b1fojDwvrz7wbLA&oe=6A413E91"}, {"file_name": "Screenshot_8_HQ.png", "id": "6579317878862576", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982685_6579317882195909_860934616259707238_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LR5oJ05ePhgQ7kNvwGfK__H&_nc_oc=AdrzTGqyvrDtzocwMQROAjdWbzDTyl4kZJ6ql3AvqVoTc-xpwvT79pFb7a3__ClsIoE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wYvj1W_QWGzvkP6dChCEo2h6yADXfuY-Jo_5lnMdlrQ&oe=6A411704"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "3611458932476607", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572942_3611458935809940_8171731785683107976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ivhst6noSUQ7kNvwFAPZw9&_nc_oc=Adr32KBccalEqXm6VO-r6DL3tRejo7FlFdJurF7qhr4kFxTJ3RMoN4X9i-6WP9s8j4s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Adm3C7yTw2-UsNn-H6mPS_NW1S__s1DoL-WBWw8xcTQ&oe=6A411869"}, "display_name": "Musical Range", "keywords": [], "long_description": "Rock by shooting notes! Keep your audience hyped and energized as you perform, live the Rockstar dream!\n\nKey Features \n- A Unique Rhythm Game: Play music by shooting, punching, moving, and smashing notes! \n- Rock, Play and Perform more than 25 great official songs. \n- Campaign mode: Start your journey and grow your music skills.\n- Tailor your play style with four difficulties and many modifiers. \n- Electrify your audience by performing in 5 out of this world stages! \n- Find your sound tone by trying the 4 different instrument sounds included. \n- Discover and grow your music library with Custom Songs. \n- Witness yourself climb up the leaderboards as you master your skills and performance. \n\nAre you ready to take the stage? Feel the music and get ready to ROCK the WORLD with MUSICAL RANGE!", "short_description": "Rock by shooting notes! Keep your audience hyped and energized as you perform, live the Rockstar dream!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.musicalrange.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Rockhopper Studios", "support_website_url": null, "website_url": "https://www.musicalrange.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8594264594005167"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035304_1620288541898806_9088938246447333277_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-x592R5A9PQQ7kNvwHXr5SZ&_nc_oc=Adq2m4vesM1CGXGxfXZIxIH2D1Ia4eYQudfgiay2u1wEKv4CKWYmhZ7udcXXg
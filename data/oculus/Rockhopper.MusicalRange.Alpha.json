Hzb9Y4Uolu6_g_l3FDPR8RRjh1k3ITp6ygLIYavvB8Y0XKlCAe8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftbHVEAbw0JarezCs--3YO_4qD-BOz6KPwU4ssJRSDWvg&oe=69A44A70"}, {"file_name": "Screenshot_5_HQ.png", "id": "1056010235521940", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003279_1056010238855273_8892509587549964860_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diDKAS6368cQ7kNvwGy_eAR&_nc_oc=AdkZxf1oViRxRuOgelbPHM_rdVM5kI3rANP3HZUxZoG9LRaQgsdUvZMFk2AlkTB6sVI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftRvLHbiLLFXfwrxoJtoBH_bedF1hIDQWbH0pLhpJ6aQw&oe=69A423D1"}, {"file_name": "Screenshot_8_HQ.png", "id": "6579317878862576", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982685_6579317882195909_860934616259707238_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7V021rbzxQUQ7kNvwFK0m-7&_nc_oc=AdmpeI6Qax3h7BLOaMgKgc70dWk2slFsOjomxeI1e9EYxJYuoUfiwPgHZKox18ATKko&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs1Uz6j7hNxWn27WdKyy-EW8_TfHMjVah_5U_zY7xtnow&oe=69A43484"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "3611458932476607", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572942_3611458935809940_8171731785683107976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgjNLxMrihkQ7kNvwFzXUCm&_nc_oc=AdkakND5dsTcoPNGUJENSS6qeb5cPlcNokvdWRBTVsCFdGxNuVEK7brNfP7Q917geMI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftOE6nm4F8nmF7jC7ZVi7zERGZKIxUZWFP0LxXW4ZkRiA&oe=69A435E9"}, "display_name": "Musical Range", "keywords": [], "long_description": "Rock by shooting notes! Keep your audience hyped and energized as you perform, live the Rockstar dream!\n\nKey Features \n- A Unique Rhythm Game: Play music by shooting, punching, moving, and smashing notes! \n- Rock, Play and Perform more than 25 great official songs. \n- Campaign mode: Start your journey and grow your music skills.\n- Tailor your play style with four difficulties and many modifiers. \n- Electrify your audience by performing in 5 out of this world stages! \n- Find your sound tone by trying the 4 different instrument sounds included. \n- Discover and grow your music library with Custom Songs. \n- Witness yourself climb up the leaderboards as you master your skills and performance. \n\nAre you ready to take the stage? Feel the music and get ready to ROCK the WORLD with MUSICAL RANGE!", "short_description": "Rock by shooting notes! Keep your audience hyped and energized as you perform, live the Rockstar dream!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.musicalrange.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Rockhopper Studios", "support_website_url": null, "website_url": "https://www.musicalrange.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8594264594005167"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035304_1620288541898806_9088938246447333277_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCFdpzLkRhsQ7kNvwGaleop&_nc_oc=Admn7-JrlfBeRyN4rFJgcZO-HzOv7NNMp4760_MuAvYRyf2FWCCJExMR672-xq_ngFk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftGxn-NaQUittAC7fDITYDYrBwMt-FXWjKv6q8MtGisog&oe=69A43393"}, "is_concept": false, "is_test": false, "is_trial
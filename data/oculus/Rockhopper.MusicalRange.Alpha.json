iezHqycKjHBre5U5YxD9qut4wUrJxtXHXWrWMtGUpbrXC4THWpQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsZ2HuCGWsI1dfmycKBMF9ic1M3EjJe_Q2Y445McRjasg&oe=69A1A770"}, {"file_name": "Screenshot_5_HQ.png", "id": "1056010235521940", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39003279_1056010238855273_8892509587549964860_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQugxlfL9GMQ7kNvwEQCDXR&_nc_oc=AdkeGgovgkxhYnpJBHMqNf0WC_uwOROYLMb7V0zGj6q_rQDUUEJfRCLjOwE1ji4zR_M&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuztMo1MryRgv1a3p1O0nUVqP4_Ltu9T090-9N153I74w&oe=69A180D1"}, {"file_name": "Screenshot_8_HQ.png", "id": "6579317878862576", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38982685_6579317882195909_860934616259707238_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_0QfNnJYkUQ7kNvwEW7_p9&_nc_oc=AdnMqASiYVGvZl1FUiyELs4jffZVbncDxxwaapgbaevqpvTgCfhOICJ91LAI1MFn5hY&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfvsDfIdgZoDWKHO-RHM7Mozy2qFVWblQtd36etWqJoVaQ&oe=69A19184"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "3611458932476607", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/57572942_3611458935809940_8171731785683107976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=545MTgEfv08Q7kNvwHaewKe&_nc_oc=AdlFokuf2I21iYRXcXxCl5B_Nx-EIb8MXcHSTj4xqwlxtbv2NiWJAQLC2679Oeuw9Ls&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftYtS4Bz4EUELHKHPCdotNLI-QNMgOquUFlL7rhzV96xQ&oe=69A192E9"}, "display_name": "Musical Range", "keywords": [], "long_description": "Rock by shooting notes! Keep your audience hyped and energized as you perform, live the Rockstar dream!\n\nKey Features \n- A Unique Rhythm Game: Play music by shooting, punching, moving, and smashing notes! \n- Rock, Play and Perform more than 25 great official songs. \n- Campaign mode: Start your journey and grow your music skills.\n- Tailor your play style with four difficulties and many modifiers. \n- Electrify your audience by performing in 5 out of this world stages! \n- Find your sound tone by trying the 4 different instrument sounds included. \n- Discover and grow your music library with Custom Songs. \n- Witness yourself climb up the leaderboards as you master your skills and performance. \n\nAre you ready to take the stage? Feel the music and get ready to ROCK the WORLD with MUSICAL RANGE!", "short_description": "Rock by shooting notes! Keep your audience hyped and energized as you perform, live the Rockstar dream!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.musicalrange.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Rockhopper Studios", "support_website_url": null, "website_url": "https://www.musicalrange.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8594264594005167"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39035304_1620288541898806_9088938246447333277_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCFdpzLkRhsQ7kNvwEZdbH3&_nc_oc=AdmigJb1GaRnBLuSXP9PSLOpxyPjSxjkhKSpAQKX2juUrb66sku4bxe2vZoDrSGqIxw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afu0SvBvNrohzAwBTqCoAk8DlTX7BR553noaJebEPUCdDg&oe=69A19093"}, "is_concept": false, "is_test": false, "is_trial
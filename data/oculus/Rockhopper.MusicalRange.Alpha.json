_7491144707144836659_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVmhSnlohUQQ7kNvwGnNr5p&_nc_oc=Ado0Q10tO3R85hsQEdXE4R0YvWReniU9_Qn2O-hObL0kwgs4iA93FS9KiDdXFc0pSVI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aaFYHm1N9E6Uy9SL2TbGeVEhVaWXUh3G4HUM-5iGdCQ&oe=6A315AF0"}, {"file_name": "Screenshot_5_HQ.png", "id": "1056010235521940", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003279_1056010238855273_8892509587549964860_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIsfqJFYldcQ7kNvwHT8rho&_nc_oc=AdqvghY-BpH4HJqe5FgwKMAM8g5Z2-evhZdZsC8BxjKPKr__sZ6HED25oS-7QgGdN5o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8o4FFNkmG4CUkfGRrBcvTn8IUivRv8DTd7g0xbKENWIA&oe=6A316C91"}, {"file_name": "Screenshot_8_HQ.png", "id": "6579317878862576", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982685_6579317882195909_860934616259707238_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMaWeUO9DaQQ7kNvwEp_00q&_nc_oc=AdqggJdE1epukz_btiu4gLrQZvUrzKpCMh1V9S_svfaLob167al02gyTKltLTqgNyFw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uNjlT5yPtgzh-ZtNCON0m7rvQ-0KiP1MQh6VAsIedyA&oe=6A314504"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "3611458932476607", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572942_3611458935809940_8171731785683107976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3ZszoBxdP4Q7kNvwHyt1K7&_nc_oc=AdpyPpbUiOFGwOXQG70ZD0E0MtRiM3GNR1pb10kAEmsGGMD70zjUo07P9cwgmZz9sY4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kXhi4G66SQ8gcVjRcjFi3IiFnIJm2uHLrbDvy3T8v-w&oe=6A314669"}, "display_name": "Musical Range", "keywords": [], "long_description": "Rock by shooting notes! Keep your audience hyped and energized as you perform, live the Rockstar dream!\n\nKey Features \n- A Unique Rhythm Game: Play music by shooting, punching, moving, and smashing notes! \n- Rock, Play and Perform more than 25 great official songs. \n- Campaign mode: Start your journey and grow your music skills.\n- Tailor your play style with four difficulties and many modifiers. \n- Electrify your audience by performing in 5 out of this world stages! \n- Find your sound tone by trying the 4 different instrument sounds included. \n- Discover and grow your music library with Custom Songs. \n- Witness yourself climb up the leaderboards as you master your skills and performance. \n\nAre you ready to take the stage? Feel the music and get ready to ROCK the WORLD with MUSICAL RANGE!", "short_description": "Rock by shooting notes! Keep your audience hyped and energized as you perform, live the Rockstar dream!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.musicalrange.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Rockhopper Studios", "support_website_url": null, "website_url": "https://www.musicalrange.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8594264594005167"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035304_1620288541898806_9088938246447333277_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4kNZJm8PsYQ7kNvwEj3X6n&_nc_oc=AdomVZjKBPwl5P5MW4um4qlKPpsKFojyRKQ8sO5IITxzUVfQer3OhRo-zCq_d
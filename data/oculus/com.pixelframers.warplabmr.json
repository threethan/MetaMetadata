7635144548_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2llvZZTorsQ7kNvwGd9fyS&_nc_oc=AdppL3On8gLQTX2tWJQsbP2QVWyAJ25612JYHmt457mx3FTJbhAL9qAWqGybVvP50_4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkOqt78EZApelr0VrUdTGQ8wNN6QSXFbVqRP8oVQgKnw&oe=6A85A019"}, {"file_name": "Screen3.png", "id": "355461136922008", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75514543_355461140255341_4866617850929224355_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIv_LtWI2ZAQ7kNvwH35bOr&_nc_oc=AdraEs0HA8NBM318qajDbaVsUmi2gm7xY_6DiE3AIOCC2ULMcwfxzvDk-zA3x1EsiG0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuxbx2A83K6L-3KWMGBToA2W_GboejVupsGilp7QHkxA&oe=6A858653"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Warp Lab Mixed Reality", "keywords": [], "long_description": "Warp Lab Mixed Reality invites you to transform your home into a dynamic playground of possibilities. Unleash the power of portals in your very own living space, opening doorways to dimensions that defy reality. Experiment with portal physics across 8 unique and challenging puzzle scenarios that require careful use of portals to correctly solve. Since the game uses your real-world environment, no two playthroughs are ever the same.\n\nFor best results we recommend a clear open play area so that all the physics scenarios have enough space to generate properly.\n", "short_description": "Unleash the power of portals in your very own living space. With a cutting-edge physics sandbox and mind-bending puzzles, Warp Lab Mixed Reality allows you to manipulate physics like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.warplabvr.com/warp-lab-mixed-reality-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.warplabvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "co
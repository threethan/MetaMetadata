lcTVWIaiNoJZw&oe=6A315E93"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Warp Lab Mixed Reality", "keywords": [], "long_description": "Warp Lab Mixed Reality invites you to transform your home into a dynamic playground of possibilities. Unleash the power of portals in your very own living space, opening doorways to dimensions that defy reality. Experiment with portal physics across 8 unique and challenging puzzle scenarios that require careful use of portals to correctly solve. Since the game uses your real-world environment, no two playthroughs are ever the same.\n\nFor best results we recommend a clear open play area so that all the physics scenarios have enough space to generate properly.\n", "short_description": "Unleash the power of portals in your very own living space. With a cutting-edge physics sandbox and mind-bending puzzles, Warp Lab Mixed Reality allows you to manipulate physics like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.warplabvr.com/warp-lab-mixed-reality-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.warplabvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "597915392183640"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771
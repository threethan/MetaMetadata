543_355461140255341_4866617850929224355_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JeqK1R3NFo4Q7kNvwE51xub&_nc_oc=AdotWdaYDbgfsU9OqQV1BN23AC1q9RPGXWhGyfDSztOg35gPH0OQzOkOiWhuvQwuL8I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVJfHWkxQnl9rJ4WmAoVUDrQjUJwqFjhAh-m3R0ZWoUw&oe=6B005A13"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Warp Lab Mixed Reality", "keywords": [], "long_description": "Warp Lab Mixed Reality invites you to transform your home into a dynamic playground of possibilities. Unleash the power of portals in your very own living space, opening doorways to dimensions that defy reality. Experiment with portal physics across 8 unique and challenging puzzle scenarios that require careful use of portals to correctly solve. Since the game uses your real-world environment, no two playthroughs are ever the same.\n\nFor best results we recommend a clear open play area so that all the physics scenarios have enough space to generate properly.\n", "short_description": "Unleash the power of portals in your very own living space. With a cutting-edge physics sandbox and mind-bending puzzles, Warp Lab Mixed Reality allows you to manipulate physics like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.warplabvr.com/warp-lab-mixed-reality-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.warplabvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
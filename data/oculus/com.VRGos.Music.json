en_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYvuwQMs4zEQ7kNvwFv2NAC&_nc_oc=AdorA5fvEj-K_MMmGxt2nWfEDoB3X4vobneJsGFA6a2jsD3QG5U7-exjbAohaQA7Kv8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyvT2v6vXzjXLsc8V00RFDt6z9HQFL2aq9_c_BQ_VBsg&oe=6AFB3979"}, "display_name": "VRGOS Worship & Praise Music", "keywords": [], "long_description": "This app was created to spread the good news of the Gospel. With one click you will experience and participate in 360 church service, singing and preaching. Discover new and upcoming recording artist, gospel and Christian music. This app promises to uplift and inspire your day.  If you like Gospel, Worship and Praise Music, take some time out and watch some gifted singers and musicians. Hear some of the greatest preachers expound on God's word.  You will be in the middle of the worship experience right in the comfort of your own home. VRGOS Worship & Praise is the next level of faith base ministry reaching the world for Jesus Christ.  ", "short_description": "This app was created to spread the good news of the Gospel. With one click you will experience and participate in 360 church service, singing and preaching. Discover new and upcoming recording artist, gospel and Christian music. This app promises to uplift and inspire your day. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1oNX2_5pP976K7ukiVvznizMAKa9qHF-La9EtTSUMxIQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Jerry Q Parries", "support_website_url": null, "website_url": "http://facebook.com/VRGOS-Virtual-Reality-100545515285189/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "MUSIC_VIDEO", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connec
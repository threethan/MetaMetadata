3528674335271088191_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJY9t-n1thUQ7kNvwHebaqy&_nc_oc=Adr3l5x7GhbX9PYsa6Codl_XxOd_ueN0dhpe5sulWNb8pqux7XS0llAdSyCs4JtPF4g&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKympJptPw49AeV2wYN6F6PBPJQPaaTfw_ypIQKqp239A&oe=6AA414FE"}, {"file_name": "3.png", "id": "1365002872273178", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491827626_1365002875606511_680623144893069867_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rs2SFzPsijQQ7kNvwF4_FvM&_nc_oc=AdrlpIrnkCthk7W7wb334MawMmKjNYl_UErmm9RXQbUb9ULSa2e77HK74rfME2XZbYI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0MpCKYfvs8wbu3E3AVVMey6irUvrBSSvlKIuOcVqkJA&oe=6AA3FB7A"}, {"file_name": "4.png", "id": "1345063124419869", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491828038_1345063127753202_3114028335302026247_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vv4EQB829j8Q7kNvwFtcHhb&_nc_oc=AdoBFMeTdXhNzB_eOeFnTHwIUNKrmhKuv7FQk_b8M22YEyIJ_lqbqHxWuG3f6Etz38I&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUpkXO62QUan9j2podBzUMrdt28_aPfJa0_2j1y3Rc6g&oe=6AA414F4"}, {"file_name": "5.png", "id": "1645920806494975", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491824328_1645920809828308_4500634967897063640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hCqnnXrsGwQ7kNvwHyxUgh&_nc_oc=Adq0Zb8THW0wUbXcXFUj4Q3YfL3zafUFx--jjnvjdquL6dIGIolTK3_PrdeW5r2leR0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8xHfEq_ARxIYhoicyIhiHtL8n_Vpf7uYCMET2dZFB4g&oe=6AA4243C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Arcade Shooter: Space Alien Sunrise", "keywords": ["Arcade", "Shooter"], "long_description": "### Arcade Shooter: Space Alien Sunrise\n\nStep onto the red planet in **Arcade Shooter: Space Alien Sunrise**. Inspired by classic cabinet shooters, this game brings fast-paced, action-packed gameplay directly to VR. Survive the alien onslaught on an unforgiving Martian landscape.\n\n---\n\n#### Procedural Martian Terrain\nNo two battles are the same. Every deployment features an **automatically generated Martian terrain**, providing new tactical challenges, ridges, and vantage points to adapt to.\n\n#### Survive the Night\nTime is your enemy. Use the daytime to find your bearings, because when the sun sets, the real test begins. The night cycle **multiplies the alien horde**, sending aggressive waves from all directions. Survive as many nights as possible to set your high score.\n\n#### Tools for Survival\nTo stay alive against the overwhelming odds, master your movement and resources:\n\n* **Jetpack:** Gain the high ground, escape tight spots, and maneuver through valleys.\n* **Tactical Gear:** Use grenades to clear enemy clusters and health packs to recover.\n* **Supply Drops:** Watch the skies. Ammo replenishment drops from above when you need it most.\n\n---\n\nWhether you love retro shooters or want a challenging VR action game, *Arcade Shooter: Space Alien Sunrise* offers a focused and highly repeatable combat loop. Gear up and see how many nights you can survive.", "short_description": "Nostalgia meets VR! Dodge, weave, and blast through waves of hostile invaders in Arcade Shooter: Space Alien Sunrise. Experience classic shoot-'em-up mechanics revitalized for modern headsets. Grab your blasters, defend the galaxy, and claim your spot on the leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mikalaikazei.github.io/ArcadeShooter.html", "developer_terms_of_service_url": null, "publisher_name": "Mikalai Kazei", "support_website_url": null, "website_url": "https://mikalaikazei.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "2710427532541308"
3528674335271088191_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTvqj2uW0BwQ7kNvwGSXcmT&_nc_oc=AdrezoP8Mfh84j-4BdWSL1wyHbF4yKm2BIiLZHcCaj1LjM72kDzHwbr3PSFWl_T8A-E&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISF58xiYzspnrmzWciNQDEG96KCNMHNR_mxcJrY9NRTQ&oe=6AA95AFE"}, {"file_name": "3.png", "id": "1365002872273178", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491827626_1365002875606511_680623144893069867_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwgwmaQ-CAcQ7kNvwEAA6Oi&_nc_oc=AdosNuJYkaWdDu4IzdYarjWTlxa7fQEqJhAkcMrB0HKyUAR6fw8r1-8UYFvb8XMZqRo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6mkob8vMHOUYpd3UVUg1a6R5-3gPMwdJh6eZSNG4ZyA&oe=6AA9417A"}, {"file_name": "4.png", "id": "1345063124419869", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491828038_1345063127753202_3114028335302026247_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqayEEJy79kQ7kNvwHzG3Tl&_nc_oc=Adp1RP7YJLm7daL_XNpcJruZQ9IfXVJtJPMu3HSGkqlMLCcxW4mtbRZYF2AYGddLRdU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhmc4qaueBxsHiDPHWHtREpCTD1h-aQPG832KSuYWV8A&oe=6AA95AF4"}, {"file_name": "5.png", "id": "1645920806494975", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491824328_1645920809828308_4500634967897063640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlrrmhmkMlYQ7kNvwFdYwkk&_nc_oc=AdoNuwtc9shdrKknEIIfq2W5TfNdp4sfNjxClvBTyRaZF2ubO0WEp7o7g7uJ0LigHw4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF2sbwT1qKG9GA6acx-SL2q8AWh8iRDW2OvBVen1o6RA&oe=6AA96A3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Arcade Shooter: Space Alien Sunrise", "keywords": ["Arcade", "Shooter"], "long_description": "### Arcade Shooter: Space Alien Sunrise\n\nStep onto the red planet in **Arcade Shooter: Space Alien Sunrise**. Inspired by classic cabinet shooters, this game brings fast-paced, action-packed gameplay directly to VR. Survive the alien onslaught on an unforgiving Martian landscape.\n\n---\n\n#### Procedural Martian Terrain\nNo two battles are the same. Every deployment features an **automatically generated Martian terrain**, providing new tactical challenges, ridges, and vantage points to adapt to.\n\n#### Survive the Night\nTime is your enemy. Use the daytime to find your bearings, because when the sun sets, the real test begins. The night cycle **multiplies the alien horde**, sending aggressive waves from all directions. Survive as many nights as possible to set your high score.\n\n#### Tools for Survival\nTo stay alive against the overwhelming odds, master your movement and resources:\n\n* **Jetpack:** Gain the high ground, escape tight spots, and maneuver through valleys.\n* **Tactical Gear:** Use grenades to clear enemy clusters and health packs to recover.\n* **Supply Drops:** Watch the skies. Ammo replenishment drops from above when you need it most.\n\n---\n\nWhether you love retro shooters or want a challenging VR action game, *Arcade Shooter: Space Alien Sunrise* offers a focused and highly repeatable combat loop. Gear up and see how many nights you can survive.", "short_description": "Nostalgia meets VR! Dodge, weave, and blast through waves of hostile invaders in Arcade Shooter: Space Alien Sunrise. Experience classic shoot-'em-up mechanics revitalized for modern headsets. Grab your blasters, defend the galaxy, and claim your spot on the leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mikalaikazei.github.io/ArcadeShooter.html", "developer_terms_of_service_url": null, "publisher_name": "Mikalai Kazei", "support_website_url": null, "website_url": "https://mikalaikazei.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "2710427532541308"
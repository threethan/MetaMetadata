nt-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgys5JgmtYrNoadHzGNVrCDvjnKph_5HXbMqBptnyEcw&oe=6AFDD9BA"}, {"file_name": "4.png", "id": "1345063124419869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828038_1345063127753202_3114028335302026247_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDx2zoP31usQ7kNvwFxdDOG&_nc_oc=AdqAhlvynzOsFb9gOSzycDPXeBtxh2q_rnJ6rZ4Yhw5A2uudVZaRPpTcVrqAMeSY_jI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRktD44dYEA3wE3Kh4mDI4ZvELOvEulHz23RLvqv3u8TQ&oe=6AFDBAF4"}, {"file_name": "5.png", "id": "1645920806494975", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824328_1645920809828308_4500634967897063640_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9Lq8mwZhoUQ7kNvwHwAoLL&_nc_oc=AdpCd0f0GOONhGuHWx9bbcnXEV4IhX23y33MPFhL2R6s5d0KKaIEUjsU5sMXdZ7yR7g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRazuPrEkFbPoMeIL1SCQ1NL2A5xHeE4C4GPzRZ2Ia1A&oe=6AFDCA3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Arcade Shooter: Space Alien Sunrise", "keywords": ["Arcade", "Shooter"], "long_description": "### Arcade Shooter: Space Alien Sunrise\n\nStep onto the red planet in **Arcade Shooter: Space Alien Sunrise**. Inspired by classic cabinet shooters, this game brings fast-paced, action-packed gameplay directly to VR. Survive the alien onslaught on an unforgiving Martian landscape.\n\n---\n\n#### Procedural Martian Terrain\nNo two battles are the same. Every deployment features an **automatically generated Martian terrain**, providing new tactical challenges, ridges, and vantage points to adapt to.\n\n#### Survive the Night\nTime is your enemy. Use the daytime to find your bearings, because when the sun sets, the real test begins. The night cycle **multiplies the alien horde**, sending aggressive waves from all directions. Survive as many nights as possible to set your high score.\n\n#### Tools for Survival\nTo stay alive against the overwhelming odds, master your movement and resources:\n\n* **Jetpack:** Gain the high ground, escape tight spots, and maneuver through valleys.\n* **Tactical Gear:** Use grenades to clear enemy clusters and health packs to recover.\n* **Supply Drops:** Watch the skies. Ammo replenishment drops from above when you need it most.\n\n---\n\nWhether you love retro shooters or want a challenging VR action game, *Arcade Shooter: Space Alien Sunrise* offers a focused and highly repeatable combat loop. Gear up and see how many nights you can survive.", "short_description": "Nostalgia meets VR! Dodge, weave, and blast through waves of hostile invaders in Arcade Shooter: Space Alien Sunrise. Experience classic shoot-'em-up mechanics revitalized for modern headsets. Grab your blasters, defend the galaxy, and claim your spot on the leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mikalaikazei.github.io/ArcadeShooter.html", "developer_terms_of_service_url": null, "publisher_name": "Mikalai Kazei", "support_website_url": null, "website_url": "https://mikalaikazei.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27422019934117792"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1562346888832231"}]},
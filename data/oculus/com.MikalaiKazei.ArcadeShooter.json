e=6B09ACF1"}, {"file_name": "2.png", "id": "27439848765707195", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618270_27439848769040528_3528674335271088191_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uecx5y-P_e4Q7kNvwHhw6dP&_nc_oc=AdqBQ4TXRpYb8if4gI0qwcM3Xez-sy4rM00-kLDHu-0IfQPoS2IgK2skUlbQeSR1tdA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsaAeuAJ0g0iyl5e1AXtLueTsVJpsCokjAm2JwgaPEjQ&oe=6B09D0BE"}, {"file_name": "3.png", "id": "1365002872273178", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827626_1365002875606511_680623144893069867_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17j_JgyinpMQ7kNvwEEpc42&_nc_oc=AdrJgRCwFgh1VAEOMnpfVzsZxrBDaOK_S8FNWZmTjJqMgWzWA9yO2oHzPqLxr_VdoNs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSX8MkTnd9JtHH5JyjmzepeiyG81Nr9zOP6uw3GrqSiWg&oe=6B09B73A"}, {"file_name": "4.png", "id": "1345063124419869", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828038_1345063127753202_3114028335302026247_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tw1SwD0Ulc4Q7kNvwHd7H9T&_nc_oc=Adoh8k3n8COQ0W9e8nM44rmqJh6ZuY-mgZYYPX-c5CndCMFTTQ-ZKPVmy37HgutVw0g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHMQEKQ8Nomtu3bbgF6Vqx3jzODiHR_jD9QBvNmg0Wyg&oe=6B09D0B4"}, {"file_name": "5.png", "id": "1645920806494975", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824328_1645920809828308_4500634967897063640_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7-appfclU0Q7kNvwHS-mDa&_nc_oc=Adq22e2gauBfYW0kO2s8dMmBNo_tkIlz03QjJ00qkgpAN7a88ue3gsVZJEnRM3hMhQE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtTIM7vYaaDYkjF2i2c8iucHi2tS8zo2LKPPpYDNR9Zw&oe=6B09A7BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Arcade Shooter: Space Alien Sunrise", "keywords": ["Arcade", "Shooter"], "long_description": "### Arcade Shooter: Space Alien Sunrise\n\nStep onto the red planet in **Arcade Shooter: Space Alien Sunrise**. Inspired by classic cabinet shooters, this game brings fast-paced, action-packed gameplay directly to VR. Survive the alien onslaught on an unforgiving Martian landscape.\n\n---\n\n#### Procedural Martian Terrain\nNo two battles are the same. Every deployment features an **automatically generated Martian terrain**, providing new tactical challenges, ridges, and vantage points to adapt to.\n\n#### Survive the Night\nTime is your enemy. Use the daytime to find your bearings, because when the sun sets, the real test begins. The night cycle **multiplies the alien horde**, sending aggressive waves from all directions. Survive as many nights as possible to set your high score.\n\n#### Tools for Survival\nTo stay alive against the overwhelming odds, master your movement and resources:\n\n* **Jetpack:** Gain the high ground, escape tight spots, and maneuver through valleys.\n* **Tactical Gear:** Use grenades to clear enemy clusters and health packs to recover.\n* **Supply Drops:** Watch the skies. Ammo replenishment drops from above when you need it most.\n\n---\n\nWhether you love retro shooters or want a challenging VR action game, *Arcade Shooter: Space Alien Sunrise* offers a focused and highly repeatable combat loop. Gear up and see how many nights you can survive.", "short_description": "Nostalgia meets VR! Dodge, weave, and blast through waves of hostile invaders in Arcade Shooter: Space Alien Sunrise. Experience classic shoot-'em-up mechanics revitalized for modern headsets. Grab your blasters, defend the galaxy, and claim your spot on the leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mikalaikazei.github.io/ArcadeShooter.html", "developer_terms_of_service_url": null, "publisher_name": "Mikalai Kazei", "support_website_url": null, "website_url": "https://mikalaikazei.github.io/", "category": null, "comfort_rat
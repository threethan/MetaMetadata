e=6A9AC30E"}, {"file_name": "sc2.png", "id": "899554294980456", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982692_899554298313789_6782084336096795772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXUYL4JY9lAQ7kNvwEtQDlw&_nc_oc=AdqormJ1eazJJV6DrsBw2684rtt_iH6i2WfaNUHEE7drKLA4OPsuLUG-dVmTGe4cI7w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOACPwWh9l5zoh_G55BOGuJjrqOMyk9IVDlUsybr5ruQ&oe=6A9AD4E3"}, {"file_name": "sc3.png", "id": "1332901451209610", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1NGeeNU-dYQ7kNvwGWjWCC&_nc_oc=AdpRHQN8KPeaiL7PF7HgWrX-7225WUTVPUlx78SqWI1EioWDJr_EywZPUX_7JNh8xFA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiXoBu7nfObjsHE6orUcq2SPPpsNhMLC8BfnGoMX4XrQ&oe=6A9ABF50"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=madEsi8MhOIQ7kNvwHX0nJP&_nc_oc=AdrRVJIyOkUg_gjzrrfsc5jdN9ThzVmmg4n4sxdDNQnVvYHBFsaQx8NwszSNLRXXJPE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOrytm2WQ5sEZajxRHi7zK3pheHL4wFHTZl0i8cOD-kw&oe=6A9AE9A7"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qegkEnJ_zkgQ7kNvwFAmBTL&_nc_oc=AdpLLQdYPicCAyE0GAkxfLTXTR2VC1GEW_QD9F3AhgSEQd-o-fQWfh9H-10goP_kFsw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ1rDL0qQGrYLtXkYzE-XOyQis5-bnEXVFq6ekGZGQig&oe=6A9ADEFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rl3sYlPw-sQ7kNvwFGmhRs&_nc_oc=AdocIsR3OA1ElNlX1bXdoPt6sayLxLrdox-e2ZEbfNX1T0HkFHeWraaW8hZfOTe8kEw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlh7MspxfR4303LfPSP3xrcx6Ab1UricrO5ehwsV_J1g&oe=6A9AC3E9"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26522947840652360"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "2267913173749040"}, {"status": "PUBLISHED", "id": "2158570141668660"}, {"status": "PUBLISHED", "id": "2013630805934427"}, {"status": "PUBLISHED", "id": "1552469119200810"}, {"status": "PUBLISHED", "id": "1506416297130936"}, {"status": "PUBLISHED", "id": "700148739186517"}, {"status": "PUBLISHED", "id": "1496842354697989"}, {"status": "PUBLISHED", "id": "1246417143240455"}, {"status": "PUBLISHED", "id": "24275372888719437"}, {"status": "PUBLISHED", "id": "513258815169104"}, {"status": "PUBLISHED", "id": "609017335319953"}, {"status": "PUBLISHED", "id": "595367433115342"}, {"status": "PUBLISHED", "id": "1228814411669786"}, {"status": "PUBLISHED", "id": "1187489192375162"}]}, "baseline_offer": {"id": "2158570141668660"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "2267913173749040"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"no
ttps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIt-_XST5fgQ7kNvwET6CPn&_nc_oc=Adl2SHf_yzYmfdbxqhigTr8YxNPyBPCbwg2m7s8IuuA5lP__hExFhVA1g-qn_V-VLG4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aftx7BKdniWGS4F_k9Eo7fyAo3nUDqxRD7xUsuocVVJnZg&oe=69985950"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xl0n5BACvugQ7kNvwFfqfys&_nc_oc=AdnbKsYVijvHZ8TAKXG4GKEIrG3olDnAbYzNonOpEfUBdMTxWHr2Ewsd6m7hZw1nJf0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuqmYR-LhnYOasicjZWW1gCpU5j762Cql_95orsvkNVRQ&oe=69984B67"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdzfnKdY-qcQ7kNvwG-RJGz&_nc_oc=AdnjCBROBFROnf4xGMcj0tu2psHLm5HlTytvZoOWP85pIYEibv_FU6OELTUVjWgqZng&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsZYH-dH12RENqmdciRI5KyyNkY-CYi-NN_F1N_eIIzFQ&oe=699840BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owAp3c4eVowQ7kNvwHOuILX&_nc_oc=AdlGyMvQE7Nc0zF1OI2T176-q34XEigitnyaoE6KZ1nyk4F_PBx--cSt__jYbgg9bjk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftVKaMqMxslZ1ObD52_w2PkvUQXQXP6hKpWa8XQeo_9PA&oe=69985DE9"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_
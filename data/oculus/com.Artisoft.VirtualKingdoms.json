=AdrRb_8TpOgX8aeYRJhUofBSTGZLu6a-Gfh1KYGRBdQITywgNVj7xHDQspL8enEDiwA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8IY4DwdNxejhWXlY5deADXBP82Az45QKOTkVCMmimOA&oe=6A6375E3"}, {"file_name": "sc3.png", "id": "1332901451209610", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UOodBHNi8QQ7kNvwFJnCjg&_nc_oc=AdpufbK8OvLe0w0jGv53XyNtMpIqeAbCQ_6Jn35TMGhew1jyqgCDo-KJnKRNG6PNP6w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQm-JlzZ4P-Y2qLZo9vrYhAak95fydz5sTp3asslyeQA&oe=6A636050"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4dXtH_ETLsQ7kNvwEs0q_G&_nc_oc=AdomBP_e54OLPHNh-0rsJaEoN7vHtOnsOvvRpHhuFJqf4kmj5jzQR6NqVXzK5fZ68b8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgyhPE-C5te9LEKlTEzZteS8R7OXGCeb204W0lGAoEbQ&oe=6A635267"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRHjZI-9e6gQ7kNvwFTO-DO&_nc_oc=AdqdHT49LHKNH5vi-tNnsyydTlRj1d91atQvSso0ugfKZLF2E1XVe_DLQ9dpdacSVTs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdG9pHpRq21LFwzr3fMV1SBQZMscUEM9aG9mItBkLDaw&oe=6A637FFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sf7N2jF4UIYQ7kNvwFAB4Hj&_nc_oc=AdrZCK-Uq0CCW4Z9um-dNmv99eQTnM-0RCux_3voDJJQ9bjOfB6g_TwHScuDRwgrBWU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARDOdgTn1WGoHIytNA7DwbxPwpJtASlGcNHXHJBvNKQA&oe=6A6364E9"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null,
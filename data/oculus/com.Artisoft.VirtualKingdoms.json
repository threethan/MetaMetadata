=Ados6aQb7yFx6lrBH0CgKvRxeI8ijAxRqSg0gYpqWiujKn1S-76Ps7HDwwzB5yiWlf0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DXpXdGU5Xy2LD8IeOcc1BT1bQUxHvTVMRQVH6jW-47Q&oe=69F9FDE3"}, {"file_name": "sc3.png", "id": "1332901451209610", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Lb17r0-IskQ7kNvwFJwinV&_nc_oc=Adq6XOYhwaOtJEoYPgZutejQ9Ft7GwXYRswTE_sEo-2qVfb7e8cgugu3RlwXRMLnrU8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jJxWAEwyrjMm19W6Q5SW93yRyWoS-HYsriPj9OrCUoA&oe=69F9E850"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59yAxK5vL20Q7kNvwHFc9eo&_nc_oc=AdoYhZWVz0G3P9ZjHUm5hYSm-1rOMJQCsTGnYkTON95nxJYgjaoIhun-FcpukcvqY24&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6O7wq1O_ri8Dcw3lKLWfJhjZFf5oXlJQe1Wqb28v2LjQ&oe=69FA12A7"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qo5WXIelHBYQ7kNvwHXes0P&_nc_oc=Adr_38UqDb4BWeT3bSpusoB1FnuLbZGx2zE9FbwcgA0hRxBR992jqgvRlzcp8Cw_0bY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4b2d2qKPOTk0O53oBenHjWOZCGGjOVL0YUeX1d-yblOw&oe=69FA07FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXEId73WVvsQ7kNvwEewAxa&_nc_oc=AdpI0waJVrcTXGhJRHiNUjt65v5WGEAtTh44XMastpufzzf5ouxNIfGCFPhAsD-eAls&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YGpCoClNIu-XIOvKe_icxaa2eP_HX6h5irqzY7wQadg&oe=69F9ECE9"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null,
e=6ABFAD0E"}, {"file_name": "sc2.png", "id": "899554294980456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982692_899554298313789_6782084336096795772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHib7AaZzs0Q7kNvwGg1HdE&_nc_oc=AdoPVIaEumvYxOkovBoQsxadvXl2MQKaZm-kwNoY38PsWOGGU6-bsS6OdJPQFqV9ctc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMF66HoCmmBGl3-7hJbiy8qiYB1vcugTkR5J91k-DJmQ&oe=6ABFBEE3"}, {"file_name": "sc3.png", "id": "1332901451209610", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQo4z5YluSEQ7kNvwGjZfJv&_nc_oc=AdpxXr50cQZSPGs1SSz1F_3CuJzHUakvm62KYDB0GHTknpxXM56j9prMbu5v3PFdR8s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuF4rFtv3OHMcaXRVNMgWJcjeaQ8XR23YRmhSJPI-V1w&oe=6ABFA950"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FF4KXJGTtnsQ7kNvwFlRY1w&_nc_oc=Ado66dgtppVvA5KlYdWDNmSmBfJr3oka-pzeoPo9r-oFYAFu8B7SfHkyb9jjghZ-gok&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYeb_uG10C9VYj4UBFfKaHHclxhrKIBZRMT65vjHEuzA&oe=6ABFD3A7"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLUDMCUkLgAQ7kNvwH0x1ON&_nc_oc=AdqUzmP9CoF-MBoaJ_5keoGpLGf0ia4xI_HPLiWEyupQc1ocsbZ0e-nxl5ReVMvrDzU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNm07TicUrpgsOXs4D2pGWmYDLmzr-Q4RgVNwgFfsJ8fw&oe=6ABFC8FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfdroEFH6dkQ7kNvwEooUOT&_nc_oc=Adr8jfjqnAmR7GvJqubk7-BZ_TBN_5u6m9IKYNFZVOHOKURzbiLEtMp0JmFCXOKKJEo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqFOJS1Vz2madz1IEiz88t_L2nJE_WUHELxRbq4D_1Lg&oe=6ABFADE9"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy
=AdqTeCnPjGkTzhiWhdhnUWmA4yu-KVWFIrfHaEb7ThzV4yol7jLB8iVcOt6yocSto5g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8vm5VFV1JlF3j8tWJqjCZh5l89S5WPKkjAtVhfzWPeQ&oe=6A70A4E3"}, {"file_name": "sc3.png", "id": "1332901451209610", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRD8uHa3L2EQ7kNvwGv6O_o&_nc_oc=Adqv-rH9SsLN5qngCbLhSjm7hp3XAUB2n6G_PIdf7crdDe6mF8vnuzq9w4QntzeB0Js&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHW3oDGsC_ysWZO9pj2Z07ePqUvJIhos-c1sZGYCo8JUg&oe=6A708F50"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iB1rL58CTn4Q7kNvwFGwKZE&_nc_oc=Adrsv4DkLaWEdmI54So5x1pQDJxIHUgHskQiioKqkdWhA1eLqmg3eT9fTL-pJFLMQrg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJ6a4Q6wF2i04tgfFYD_gjiNEZWIiXZGx8VIPqyALUKA&oe=6A708167"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phU6M4cq0-gQ7kNvwG3bMA-&_nc_oc=Adr4miG8NX6cGPvtNZUpgmx_iA70gYAypoeUYuUeoaU3F_LLPIRpu-xHVSSQX-9tNyw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9lX9DiPN2fqnChSU-BD7aWghGAKDhVWNBAsmNmWpSZw&oe=6A7076BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtCrFEiccbAQ7kNvwG483c_&_nc_oc=Adqkb4TDhsuGply933mjHDzvi7P-Al5BkvwD3VNm8A6EdgCWDkRVW86FjWNV6qfxwHM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeJdUXh86aB9itsWjFxLT9EP1QKERf7yB_5gce7RfBOw&oe=6A7093E9"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null,
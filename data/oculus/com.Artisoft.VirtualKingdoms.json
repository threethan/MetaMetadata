=AdpoPZyKfwmBisSU_ucAd74SyFWuzYosRufKVqiChUmH7mhw2rr-xdYbtCF9Nb43q30&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iYTJg3UYFq3Q9p4vzk8V0zuwnD7AfizNZJumwamVYDw&oe=6A01E6E3"}, {"file_name": "sc3.png", "id": "1332901451209610", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDT9Q78234UQ7kNvwHn-FZO&_nc_oc=AdrDOj58JGBJuft-9rGbFNyhHWfBy3zBHsxHli23HncK1Yi9_Ck4bITJPA8hFY9OdDY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LTRMSzJrgmCYyv_iVaaTAfXWw6Qnzs-FDr6tvyF9aDQ&oe=6A01D150"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgqzR3jNap8Q7kNvwGfX3WN&_nc_oc=AdrWTFs7rag6AMyGvuaVDrVfKYczkD4sGtjHIRZHCoIp0LspUHeYAj-uyrTXMSHKJYo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gleihXrYg3U1R2G_PUobk8mjzuLk-Lda9CQgO_-I6mg&oe=6A01C367"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxUB868kzZEQ7kNvwH9q2OH&_nc_oc=Adoi3ZlDVT9sdoxP3zChUhQS0SFr8mCJ5IQ8I0YywP6L9JT6sSOiW_VWtSiYojO2VBc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GZ3JvSQ2wjp9X6skFXoWi-QZhz3LCHje1tbC4k4EOHA&oe=6A01F0FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqEf-plAv3MQ7kNvwFeX1sx&_nc_oc=AdpzDijSvoVs4KKI-0Sq7rwI0e36PHmY3Kg-ctu6bOrT190jFafnXyKath0uTLBP5Pg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rZGSIbNIqybekq712NscNoJMe9V7iuBis23sx0aOnfg&oe=6A01D5E9"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null,
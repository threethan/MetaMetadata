ss=7f20f&oh=00_AQTeE5Lqd5PapKmHNZt4b8cNjOi1BOdVxVgm_ImxAVkZJg&oe=6AFC6DFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCL3IWDALNEQ7kNvwGiiyV_&_nc_oc=Adr5HwpdMNwJtvc9UO9RMzyPVNL9NhoGF9umGQybDKIAfrmRZKosEFpdzXj5Fl1DhBY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHZRKuqdjzj6d-u-hzhWfJkEa7T3LcozEF8uZcdfoHkA&oe=6AFC8B29"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26522947840652360"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "2556720474750309"}, {"status": "PUBLISHED", "id": "2267913173749040"}, {"status": "PUBLISHED", "id": "2158570141668660"}, {"status": "PUBLISHED", "id": "2013630805934427"}, {"status": "PUBLISHED", "id": "1552469119200810"}, {"status": "PUBLISHED", "id": "1506416297130936"}, {"status": "PUBLISHED", "id": "700148739186517"}, {"status": "PUBLISHED", "id": "1496842354697989"}, {"status": "PUBLISHED", "id": "1246417143240455"}, {"status": "PUBLISHED", "id": "24275372888719437"}, {"status": "PUBLISHED", "id": "513258815169104"}, {"status": "PUBLISHED", "id": "609017335319953"}, {"status": "PUBLISHED",
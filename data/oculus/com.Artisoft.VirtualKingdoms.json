=AdrXiLY30UN9O5RTG279lrOBmhZiAtkTfNhELFOPyfJyWkbQinkkBDX3cclr79--Ik0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aDx_7L1JFWrQaWj_zrvPK7h6ELlvQZRItcauH9vB4Fg&oe=6A0C72E3"}, {"file_name": "sc3.png", "id": "1332901451209610", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bM8XPtCZuUQ7kNvwHY0zgm&_nc_oc=Adr3iZoAy3a5uygE3GOS5xoqqt8BCTCbvcNeAvlWIi68nhj2NSZn6-FC8hRBEqJa-dY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4h5aTGFDzhYNx0ABh8548M_0Gc6YJO9lNcdsJhcUngPg&oe=6A0C5D50"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuGVgNbljlgQ7kNvwFDQD_0&_nc_oc=AdqDB4QjfxY_8V23NXExs50DgC9d55TkXYnZIB0EELx9fSYud5x7z4p_pyd1LLbpIFQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6S10aYa7sxexAFdQ5ZS9Yb8Gfe4oJ2gK4gIBeUqnSWHw&oe=6A0C87A7"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plyk0YMsB18Q7kNvwHjo916&_nc_oc=AdorFir8eJpRwwwbShpwzCbwDtH2AXPkxHVcMXzSjJGT3n_5rtspi_uV4PFTLI9zARs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yvpZKIp5eAKPfqUca98fZxtxjQL-ieKvkfXegl7vYPA&oe=6A0C7CFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mVzWysrL5EQ7kNvwFHVF6v&_nc_oc=AdrXBkqA4PnyBr8eKoXCFojsAM9JylU31ixEVzSt8BKIvWC2dPXcqwkMaXXmF1ongtE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BuLyumtFlC8q-mj2R1xBoLVI7nCJ4ICg0Auj9q48ClA&oe=6A0C61E9"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null,
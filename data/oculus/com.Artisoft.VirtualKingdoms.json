e=6A81B68E"}, {"file_name": "sc2.png", "id": "899554294980456", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982692_899554298313789_6782084336096795772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dh3ENQ_CYTIQ7kNvwFA_yfU&_nc_oc=AdqWrwI1MO89kXgKFWzvFmHvbcDBhMGojNemKRJiK0tGD0ZrxDERR03w3f3NaW8macI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJnomhmO_nuAmOToHbF9X6e_u6cXhNJ7rTJchX4I1uCQ&oe=6A819023"}, {"file_name": "sc3.png", "id": "1332901451209610", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxajOq0BXPQQ7kNvwGd_Yjw&_nc_oc=AdqWzDtmqO3zVEbjuxtabyBns82ynPmsGA-Dn2ycrohp8wGDaFgrHZyi_QPSER-HxDw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbo5ghBlRuL-TK6NST6fJszfPBpLggNJv2_yCkJP_2WA&oe=6A81B2D0"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfKjdqj9SSEQ7kNvwEtMOxD&_nc_oc=AdpxJ5lYYvPSCmUUuxMbthLaSosPOU76BxVmzEw-H6WyL8tU8yim02HeEgz18JJyGqk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNGC9ahIN5kXXrBkjgcTGAIQkqi87-qHx5eJtLo4HE4Q&oe=6A81A4E7"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTR-Lde9jSIQ7kNvwFY94XQ&_nc_oc=Adq4ZU_1sq5odcf3MNmklP70QfRc_23efcwBW1Dz_bea0JB52poGKO7d2-DruF9X7Gc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuTiJysimqwdUVrbtFWok0yyY2ioOTWLsOEJc5Hf2Q7w&oe=6A819A3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05n4JPA5vLkQ7kNvwGYXkGw&_nc_oc=AdqZfGv0CIutzM1CVcXh2nYk4PQisZpEWvXUStdkYqkgW8yxi5HLjIEJQy-k_7zI4NM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGksJTV0bEQHCO5N8MJSKrPXLWOdktomxOmM2q0bXBIrw&oe=6A81B769"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy
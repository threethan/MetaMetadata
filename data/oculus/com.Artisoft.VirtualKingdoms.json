=AdqGAT8ouYDErnh8COHxPrZvqyIiuEoiaqPlBUeBhY1YKTIc2XwmmuEwz-oxPTcuAcc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_A-SdnS0hxlxcaxVLq4ONm3LK7I6dEi6YUKsbO-vCyg&oe=69C29EE3"}, {"file_name": "sc3.png", "id": "1332901451209610", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFzUJ6mAB-EQ7kNvwGw-GRZ&_nc_oc=Adp5Qhnsw9h1MYgis8U9GX0ZxbpUoVGRuQY6mSCkBo5laO3ZZxIY90J5WELrhQID820&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzt9ANnSHghdg7ZHMWJanJloGPMhJyxX_hT3XkQ_a3Zrw&oe=69C28950"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3vLhuxoRsUQ7kNvwESlgu5&_nc_oc=AdriLgL8cPop5-0rWoCFx1SbPqfk7f4_QPkO6ZaCzcOeTgaR9XOoJ-Y7YOVMHdp4zjY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGxPmakyqC6cTHPSgi31jBj6echFQDYsFr5J9Iy-pf0g&oe=69C27B67"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgzVVHpWgGwQ7kNvwFXf5Tc&_nc_oc=Adq5LfzCXcMuyTVzTjqHSbHnBBs9fMnpshTWhui0pE4mutsrZmDMkA09BoAZMfjpc_I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzvB3OXrQofs3WZM9Z_Embnpm9nlfssrPSSt0UK7K_jFA&oe=69C270BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jp3_j5L0Ev8Q7kNvwGOHNMw&_nc_oc=Adq4JtCG-eE0cJ1FR4DgfzhC_mSQdz7cty2ISync3W1qtN7sf6Mw2GsNfDGP73a1w8I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzklwul7D414kQa0K6F_h0iKPw4Ti6fCe4O5OSGaDMkKg&oe=69C28DE9"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null,
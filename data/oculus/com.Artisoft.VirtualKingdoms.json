=AdqnIzBc9FpAeJdj93YHWwK_3AoRd3zj-WlQa87uX3USXyaqWux5jUbG_1ppF7-SONc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Kw9odB1kBqFlJzmCC5soOVaoOqNyLJweRl3T3pnVgKg&oe=6A1EE7E3"}, {"file_name": "sc3.png", "id": "1332901451209610", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNN_ZCE2JRsQ7kNvwG3rZ9A&_nc_oc=AdrXHLCO5Hrl7s5XKFhr5yAuA1Voajk9XaLdUJmN-CfJxH1dcxJl6oAOz9efScKbep4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MgknB11LwHnZaJgi8QJmVD7fMRo51VZlAbIWUIvPwZw&oe=6A1ED250"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSrBClwb87oQ7kNvwHfb_zX&_nc_oc=AdoDWd18JmzygC9Pz9p1eX6fvwMAAiMRCKJ526R7kSMfOmUhSd4l5C5Yvt65HwopgwM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DusmMhLiHoEu3_nNPm2hDMc1SvDW_cHZUtfSnzHcg1w&oe=6A1EFCA7"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZzxpK9YoMMQ7kNvwHCtsnk&_nc_oc=Adp9sK5GVBRCmGiHhE5sQQ2ItfLUDoIDSsAYF0u8wvH6SKUczEXyj-v-Ak2CcnEDfuQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iqFuC0I2JMR6UnTiXOpckMzo9MAcLRgrmqCyn2SQqXA&oe=6A1EF1FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nJ8_5Veu5MQ7kNvwHgUKFy&_nc_oc=AdobyyNnFMW3QUmXm1l5_2DdxxE0-OIDpM0kic-lONLcoGaTgRg3ZuVA1JDg4fvKcyU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70TXuZgQRzJE1hnpJ02xzGH1fH4rFU0e5xLpzPvESTUQ&oe=6A1ED6E9"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null,
=00_Af3vGjjv1rFR61jPlFxS_-zsYXW_G-3a8jUd0QNmj3v_Kw&oe=69F0C363"}, {"file_name": "sc3.png", "id": "1332901451209610", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_DI1SqbVpUQ7kNvwHvRcf7&_nc_oc=Ado-rQZSUBJuqFXKBwj7SdFiNQH_7XQgxgD3b1c6m06pwmsmB4Q3gszPIMeyQnK9ozE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1W1FOZLBBwLGjIsN89igdnqe9fl9mke0D9W6AqPWau5w&oe=69F0ADD0"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Yfh5fRmlPQQ7kNvwGgyn25&_nc_oc=AdqnwZig-p4rxzmRak7tlJ2h0KNIIttlmMs4UhjKGnxN_mQQQxyc0v-LOj-yYsgh_E8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3JOhCOT1Ry2jhfVEjoecy8-g7YpiDBuVpwsGFVG4qorQ&oe=69F09FE7"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRhtpFsyWpYQ7kNvwEXwSFn&_nc_oc=AdqM-y51mA1bZApgkOY8SwhRJYffaCdWOzSZ_w2ZSe8CvmuYwTnk7sRshz1rDQu1oHs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2Pwl59ygKLXS6ouZAwJg4OUAp3k2I19NYb2oh7v1lVbA&oe=69F0CD7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xv04BxE3v_oQ7kNvwHZxBZ0&_nc_oc=AdqrbFhg1Ksy1DJH2oFZ7MQVPK2U-2V6CdvDPUoPSNj_NtSRN7gaEnOPUc8yJFAiEak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3lANBROQGLrMRukOjX6tzOJoBRnYdDsHasVZzG0vXpKw&oe=69F0B269"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852
=Adr-g4AMT2S-rK6u1xrpD-LTVzn_gxCCqXXbW9ATMZ0y5gLVxVRr1-OpT6KQKFnGlvo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WVWbbw5RPmYjQNN-ZDbNtapNYuu6NFaOqontsodVAgA&oe=69E39463"}, {"file_name": "sc3.png", "id": "1332901451209610", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IcA4KEu0pY4Q7kNvwGdpIp0&_nc_oc=Adp0vjLtrkTxUf4cqAewx34LjkD283lk8DTKGK8kA2o-J5UKZOaE8HcCrgzQTF6SnIk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wANE3RpHLv-NrSYZctv_HHVKFjIZu3s6_rUAHzk3JJA&oe=69E37ED0"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mizi84X7O3wQ7kNvwErChrr&_nc_oc=Adp7Sih4KOs54lfIRV491JiB5Dy-krluc4yQqR0SCVdBRSek2YzxdiFvcXGNqoVp7PI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1w_SFTZvsmUu_7m6vRLk96lMycJgRbv9ajzZxs5iBA0A&oe=69E370E7"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVMQy3fjvsUQ7kNvwEyy-sq&_nc_oc=AdoU5tLRg5ubqBR3jTKYKFmX0fjnoGjuGt2xqpOIyiPMSqZ2WAMoeIDh012E2XU0Lg8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0c8zxbDPxV_B3PtmZ7bN_qJY8yrEnilc6flVtdl1ikrQ&oe=69E3663A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDZRiKhzfuQQ7kNvwGgXwX1&_nc_oc=AdqhNGxvM0iPFFN2fPlMn6Jzog7iPXr5bW7a4kFWzWAknpe5w-avguftwhjUcEiIEQE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24e8RMtkYHOAoW30UZdgZD0NcEisXxUYPCNWXEtNzshg&oe=69E38369"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null,
ttps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4X1jLMOKIgQ7kNvwEJYxoB&_nc_oc=AdkXUdohLwpKh0xHU_pEns08UeAhJojw81ClmKpgx-mFCTPQzCMzxkxYzDcm1JPI9F4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftJQ3BxQIMpiRTOJkoFS08GDwT8TWu99H1Ch82f_G2dsw&oe=69A04250"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTWJyaIAUMMQ7kNvwGoLsWQ&_nc_oc=AdnWJ4xCloMNgYPfGBsSviEmn1EuqcLjE2vLkBVZLG6lCRJy4xb7K7aBB669Dg148QI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs9E8xp9mtPaBoHmel7bL9vqbsjDjiKr5AKaccYKLTo0A&oe=69A03467"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrDBDxEYQi8Q7kNvwE1Q2D9&_nc_oc=AdkGWWp9bKWqMkYMr9JOw1FKwmS3Kn4vz5tha88vKxo1eQF2pSNfMBk1ualg5QPfqf8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvRyZjEabtUd0IvCxH1yE1gjrgrgvFEoMUBwnVQrPmKIw&oe=69A029BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubC3I2-sGuUQ7kNvwFBpdL_&_nc_oc=Adlzm_7Y_loeOcpOWxdDiDHVSDPTNSy09HVxrotytcJUzVNNsE2NH1phwwoIVzar6nM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs0LKLlp4fX4gVzYP7CN0TThFVWfB2jAt7Kj7xsrvWvyQ&oe=69A046E9"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_
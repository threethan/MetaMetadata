=AdoRXDX5Z-QHzwIeBV3zb_-xP4stvw1xlxQTMIi3l-gV0AeHseEs2YSeldhyEvBH_ho&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pvzVwG0VzAX26z6Zv7rhWks15Dsc0yAXTtiw6l0vCxA&oe=6A355163"}, {"file_name": "sc3.png", "id": "1332901451209610", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1m8ZxrYtGUQ7kNvwGOVlK9&_nc_oc=Ado3MCVU_arXd4n2bNEnOlDxS0HxYqWmqXK_wW2aRxLcPdgrfREUDHYKopuae7cSxdc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8keY0XUCktsYiw2dnTmZuWa4M_aStDiMcJnH70FmHFg&oe=6A357410"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdErP_CcGcMQ7kNvwGlzebY&_nc_oc=Ado79qSchXm7lxH2UInjR9gG6LdKDTmUEK_92JPWBEPRPqptOas6B3YXxmBa1KQI858&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FEXVxDOAlDd-MVcv0RMNuyqwyTDqIYQ-tGNRJsf2zuw&oe=6A356627"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teku8ZdsO98Q7kNvwGcyY_L&_nc_oc=Ado--eK_yRFSwjQH2rzAMDo_CjCaLDvSExGPTNlg18bUxpAUZBFTD3QdTCsSmd1oTxE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xqro_wrio3IVg6UHD_ehhhzbs4zpJRs-QJe9zxTtwUQ&oe=6A355B7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szO3UxJfuDQQ7kNvwF91XYD&_nc_oc=AdrzYOw0L54-7GgJfuQddPtAhCilGZF3B88bQra_pGgbzBv49fyui0SzRO74OsHoxAA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8Slxw0tW9S6l7mbq7qxBe-bX1VkZ58EpHpQuEjDNJSg&oe=6A354069"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null,
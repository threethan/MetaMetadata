=Adpt_3E35ursWxukJDK-Ai35Eb2vPYDEHL373U8YQM8PLEQzvwhMoWqnqDJ-82aQ4lE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af055-G8ZHJ1sErdBFnjqrim3YIST2CFzFEnqdZK8OxPyA&oe=69F60963"}, {"file_name": "sc3.png", "id": "1332901451209610", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWSVTjjAe8gQ7kNvwGAKcJI&_nc_oc=AdoCkyW3GsZXgRFh8MWYc8-aJ4T0QtXgV6FE_SoWEVgd_ePZq1O4gS58Tfx8mdHfTCw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1c6hWGKfajmO4FGUSU65dK-BkqFdcNCLbzE7n9uojzYQ&oe=69F5F3D0"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLKWNtEkHVsQ7kNvwEmOtzC&_nc_oc=AdrqGvFH0oe-mB4lyu4sYGFiJfrGBJJI2Vpm1RKTKTGXZo5mLAPAQkJdbw6B7lXsUnI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0NKwPm1I9vJQ8QWwbRlpHk5p7HWVilywWc09MC9s-INA&oe=69F5E5E7"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTnaR4DqrrAQ7kNvwF7mTTj&_nc_oc=AdofIQWxikSKvXsQg5CcjB1cmvS5I0D45x5mI4IFoKwx3b7uBEFpfoluN6euqGwqDg8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1CeeKAMJEd9ioJgWZc_lNnq49PC4s04dOudXjSGjYOOQ&oe=69F6137A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7Z7P5xoyT0Q7kNvwEfux2n&_nc_oc=Ado45FJaZHS0U1RDBvFia5Tv71kW_9X1OkWXIlyShul6FYGJnvCC3nEIoior3bqqDQA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af20XNsleQqzBpP9qlizQibGljNeVmLXhHd8loNNyc4G3g&oe=69F5F869"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null,
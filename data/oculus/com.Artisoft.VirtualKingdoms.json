=AdqLufUbsASDRbUOwiJqp-1T4F9rbUScXmG2pBX0wwPdL19nuZ3jfbEwKNHe87-0xZo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3AHrj7mJa-V6_C6L3lPFy5DixxveHTnhDmJfRT21Ivg&oe=6A2D6863"}, {"file_name": "sc3.png", "id": "1332901451209610", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1fZhLgYVuIQ7kNvwE6_ojQ&_nc_oc=AdrO4Bza3pdn2QpzCtuXnu9un1DwlGpG0e2kUSYGLjJbJpbnN08ZSCVtPdoHUQzFkYk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ChaAcQT2qExxL-sfE5ABEKDpe0Y49_aLvQPRwdlDItA&oe=6A2D52D0"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3hzqf99NN4Q7kNvwGIiC6a&_nc_oc=Adq6WDyKMT--b6RubaPz3CWuR1bzdEGsq47HGl4BnS3XyhcPTjISt5J6cmee1r21B74&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2zhRKaKMETcpMs3eeWLU0Znw2HWUDEW40nFjcydKYdQ&oe=6A2D7D27"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MaNRL7On-1IQ7kNvwFWsIhP&_nc_oc=Ado4hH2LRmq3q79KT-uvay2l4x8jF0rXWQiahac5F63NC02NIHVCJasie21smj7CVaM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BvIx5gZQQ1GGfs19u_S9CoWNMUV_r881nvgsGHtTEjQ&oe=6A2D727A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kxaw6lM4Y2IQ7kNvwGFmGch&_nc_oc=Adox_2vt3vfVkmHW9BsBmC3Lt6t_YDcThQQoGCz8xIePAGUOpxEntEylh3ed5y5k2BE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ElgnmQJPMLwrMU6G4jEyp4IrII6zSjWjJSCDgaBCVzQ&oe=6A2D5769"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null,
=AdpfX7xlPkk0Mbi8XimxIy_MMjQB8_ZtgRSJBtYm3xBjcp_NnvYqSvjxToDoUmwFAdk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8z9jBHOWwQ-quThehK8Ff0XcqFE_Sd6SKvLzei2S8LrQ&oe=6A3BE8E3"}, {"file_name": "sc3.png", "id": "1332901451209610", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6iNh8ielVkQ7kNvwFh14oZ&_nc_oc=AdqbYy06CvprUxecCrXB3xFfbAV21TrGM-ml41pdZhOO0MdS7W3f7xuh8AcAO3mgqH4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MGLT2TKSgBEE2zywKUpJMm9iIW1g_6c3nxrPoRlGAFw&oe=6A3BD350"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPHbAWYpV_EQ7kNvwEXHDLm&_nc_oc=Adp64l8iFKOMv8-SMBKfzo9RMb0t68DjhaPMxj7NYU346Gumg4rWsVn8ul8LuTRqRlI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gc38F8T6dRihyeToC1N1p9BKpSYXAzSAWhOurHcoTRg&oe=6A3BFDA7"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9PTwH21l2kQ7kNvwHGljl6&_nc_oc=AdputfQg2qRvMl-RiCKMeRtX4We_LI7jKo_dZfkhamyQnyHw5p0Y2-v6vogt1eHNLlY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_K8molnMCIWELdr4-J_cebW5VfT6_-TCBaOGLtsUXZFw&oe=6A3BF2FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTU1NnqfNbgQ7kNvwGlFZAP&_nc_oc=AdouFxyD07XRDM32HUEBePMPAJDF2CM88Y7RvqzNX8qfdPczBuk0RtNFnLk6-DvPNOs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8avbnp40hQwFVsSSkMVaQXBugT-T8ErCzlcFbnPg3F_A&oe=6A3BD7E9"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null,
=Adr1BSVs4O7yFUQrZbgxBDGt8EsWJmYYDzYj74jbVHN2Xk1xQi-d5JFqg6jRYouRIqQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VZP8EIfGdltMT7SUGxGZiV0hjfzfB-GgA9xwRDxrqyA&oe=69E63763"}, {"file_name": "sc3.png", "id": "1332901451209610", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrYU4tWlOxgQ7kNvwGaCZ91&_nc_oc=AdqQ3XYB84AwR9KjCNjpP3PruFZGfz-e5UjRUpeVzhWfE-ofz4897TUI4cbuFOydIdc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wMSxWtinMKEN3a358M23SBRPJKR5ekdGnm5tjOhmiyw&oe=69E621D0"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mizi84X7O3wQ7kNvwGvFCS7&_nc_oc=AdqmPdnXC8AOv0q2Hc7IAYxKGBYtNTShsYx-M6j4LfuRFwf9Dx5IXedI2LmiFBGn3aE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CCzHgDQaE3gg3ZsRaLTmwZHUMlQb5VCh5dKH-uBIToQ&oe=69E613E7"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGxByUji6DMQ7kNvwFUWkfv&_nc_oc=Adp8SiHT9V60UboagyYIYivoCPg7AUkD_0Jb0s0wH7oIVRXze7XsQFt-CqwEunMVreU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dslha8n4FNYuTXDQu7ybb-uWEfWsKMYxQzAkPzOfvqA&oe=69E6417A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_spuU1aaYYQ7kNvwGs8-3m&_nc_oc=Adqi2OBRFACnstNPfjEctBNH-9l0ee35xrTSktlkeeYwAIgCFTUj9ERQL8vW3ulyZ8c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QjnYakMrQIDUJDrCZ8NWAd_MmX8Cy6WF3KFJG_W6EmA&oe=69E62669"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null,
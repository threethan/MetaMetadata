ttps://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6FG4DX4tO8Q7kNvwHVdIvJ&_nc_oc=Adn-ZaeNcbPcEFVbBxQxJQIB4hnHuEaEpIlTisTH2TqfExayaGfSep9YiXgpR-zw7LI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftY5z9DOIzgDPPlWC9n5s8TOaWjcDzX5wxuVm4CoVmeLw&oe=69A193D0"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTWJyaIAUMMQ7kNvwHK4eoR&_nc_oc=Adl_VyBTHr9Y4Urq1QG7zB5HFP63gJGBNXFB8d2CQy8IDytaVBCNMv_x-4NMbxAjgUY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aft19BIiOlMXwEn8GM-SJZrt-ORI21IMtg8omX_pSIkVDQ&oe=69A185E7"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrDBDxEYQi8Q7kNvwGofM7w&_nc_oc=Adnh9zrZRdpmEBhNbh6ZM5kUgv1ZZAZDAEB_UhO6xKJu6s1ODPcQkvoxCkA5xb_lFDM&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aftlv8Qksp5EPmLbx8p4z5JolPH4wG4oMrYarFAg_sY7cA&oe=69A17B3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubC3I2-sGuUQ7kNvwFAe4cd&_nc_oc=AdmhXlPCKXCJFoGaSNFrmXNxA_-KZJzDvS7Sm24orV-D9cAwN-ls4iCYs-dPQ8j3uwY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuZ8y2nnviQYKaXbnFmJNn6xT479mBbAVwvqEVOM6HLsg&oe=69A19869"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_
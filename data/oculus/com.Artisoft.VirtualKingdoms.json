=AdptEUTWnbh5jcFzckDJcpr6YVFsFZTxOUcaecwZlwuFOw3u65tFOu9QAzn5vSfKM6w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46Ksbyc9Zrx_W7CIpi3pgW1Y5Jc3qmXtbrWinvu1pAgQ&oe=6A1C44E3"}, {"file_name": "sc3.png", "id": "1332901451209610", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNN_ZCE2JRsQ7kNvwFnp4O1&_nc_oc=Ador3F99Lw8LfQTfNzxy8htCTyB1chp5F7-5b6eMGjfHYvw2wFvWg64WpNLwi0yDgBU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y262hoOdJ8RpOgeEKPiallWunsCKqqk0-LTd6C7vynA&oe=6A1C2F50"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHyuFE8p_oQQ7kNvwGqwkQ7&_nc_oc=AdrWcNA3lw-B922vrcTmxXDTlLBEn1I_imvOeOGZ26OLj_ZjY1y7uJKE-OcQgTVNduw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GVE82_KVbi7TyXOZJIIw0GmN-yooNioy3Gq2Y1lGfag&oe=6A1C59A7"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-zzzHrN7Y8Q7kNvwFlS5_B&_nc_oc=Adr_G32FN4BlzLmE3UEJ8qP3-ZK4KCvqNsPD70BGjuA82XQpzzOjo_Ct912iAriBFTc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xpm6BciIHSGEBHbJbAKB-1zODQtJ23Sj9puP4BysgYA&oe=6A1C4EFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aW05TjIHsFoQ7kNvwELiV81&_nc_oc=AdqQxTYCYa-yU82UcBcZfQ6eDLF7hO0fQUJ9fX2yjWKcZ358EFaCY7HDLcoNM8vIFeY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HWM-1GVLzW23w4opovK7jSLC4qG_h5IITD9SV5nAkCQ&oe=6A1C33E9"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null,
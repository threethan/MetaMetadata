e=6A99718E"}, {"file_name": "sc2.png", "id": "899554294980456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982692_899554298313789_6782084336096795772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOCYiKVn-BoQ7kNvwH1X9fx&_nc_oc=AdpoGV0Y66v4j1sl32wGINKOCKDYENBgVOlAf-U7G5tKMMDwgqjfJ6JUPWuJiazdlBU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqJm66wqgTw7_di6thXfOwSsp6_sDAM1HDafZTFLUT8w&oe=6A998363"}, {"file_name": "sc3.png", "id": "1332901451209610", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lHXoJ_Sa8YQ7kNvwF9OE0T&_nc_oc=Adqx0F_hNaj7JJFezMNB6nquqKIJOrqv6KjlHmdyRxRDohdvfxCmvYV5yn9IFMwJngE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVCg_iLwqvhT_lQhWCeAaGDYnn92SJmiuIl2YYKyZ_wQ&oe=6A996DD0"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=madEsi8MhOIQ7kNvwERO81f&_nc_oc=AdpFo8ZEfAqtzal1SmMh3wYXjMclxGRLA5dKWauDj7Lbm_O2XYkCJV9ki8rpCTVe_tw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHTHE6HXQO5mK9EDEvY-4wJ4PR0L7frPGu1Z_YPzsCRg&oe=6A999827"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qegkEnJ_zkgQ7kNvwFY-K4g&_nc_oc=Adrh3VyLU0oeNxhJ_zI11xq1JCZZV7tro9Sh4HdtPHuSpbSgi2d5HAj39X84FtfaKQg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8eDPT6ROVs8n9Q_WhE2t-9Gziix6w8g6tkrtHrsaAxg&oe=6A998D7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rl3sYlPw-sQ7kNvwGngIwR&_nc_oc=AdqALxi8Kj0lipSqqB74kF4DKgqXjjVQx68qKYPjWAKnf5pofZs6zv6iIqtDlQqWfIc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmUbBaxWwCECfIRLE6tbq8xrkA0J6vOPKAaOPUENBnSg&oe=6A997269"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy
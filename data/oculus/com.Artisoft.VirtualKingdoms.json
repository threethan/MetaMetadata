=AdqUVKE04hQ2hmwKxQzDsNbOZ6AVTgJLibPIRK2brBuMTEqw4VRbUVpuklbCSPAhSBU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qhlHcP-KFlQAv1vpLvP8hMDTjFCQSmk1BuEJYE_L59A&oe=6A145BE3"}, {"file_name": "sc3.png", "id": "1332901451209610", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12iIlsz_4BAQ7kNvwEVnqD4&_nc_oc=AdoGefLFkjvPT14alkuzXmH6nojCQUZk40m214FX4oC5Ns_aO6Yjg3ZRv39F9DIOYEU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qK2J5DBwrQZN24tFXCIeXyNnemE8zwqdoV-4X_y4hKA&oe=6A144650"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOrWNZ4I-L8Q7kNvwGh6Xm9&_nc_oc=AdqPdSOT5_OEnRggpFTF5HV3f20asa1qNdSp_tX-J8EQooktFCCcR86bM5QoUYfM8do&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LBRzqIYj2ubF5tAgZVKzZ93JLHJaIpz6AR4Z3ynylxA&oe=6A1470A7"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Boxgv8XUissQ7kNvwEroJ2t&_nc_oc=AdqPRosQ9KoyswF1iqTj78ThvpTcfHyus7-crzF8Ik_PxJYVMKN0y_LwZlMkFR9ovxI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55AZOKQHr5Yr7dfoIa-c5exnS9JCkfdV-aTrFMS9DtPg&oe=6A1465FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bxMbVmrUz4Q7kNvwHXaP_a&_nc_oc=AdowftR5DpvJ-8xO9C4KlLAdQojGg8FsIMr1LzlnopfI38JDw-OKPmEfebl6_Jnsxmk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67B4OxIPotn86iATK2eXOZ_D_DLQBS58QRf6R7DqL6_g&oe=6A144AE9"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null,
=AdpmRgoAR6RRhu9Dt-lWGk66x4W0Mrj7k8jZVXc4gMmtz3_dF9jjKqF6SoyWcN5u4iE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KSvNAR2hn95beoJtLOTLcl8MqvE8HY-uGqHTw5XkqZg&oe=6A37F463"}, {"file_name": "sc3.png", "id": "1332901451209610", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8HwqYssGm4Q7kNvwG4abz5&_nc_oc=Adqn9mtbVoMgO1DMPT_LbG_EnYB_b8sUx8P5VzWCNLJ2dqMmVeapMdwYAM-u2_2oB8A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wcwK7v6k700YwW7tE5cTfHr0fJ3q6KJNXBFZbo_Po1g&oe=6A381710"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGFsomBU0fIQ7kNvwEqyH87&_nc_oc=AdqleHXkgwVGtdOKYN0oR3Pk2zQN35WeFlaW3uGSLdQ1LheKJNPHft5NRh8A4s08LGs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Hj1-iUdPUkmA9-hlHdYNCfFDr1wCxRFaL_HFZMG1GUw&oe=6A380927"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teku8ZdsO98Q7kNvwG0e_wV&_nc_oc=Adom9wGU7wfxOnJBcswgncJmCaA9UulSeUSZ6nkVUtiaWeZP-p5PSkO39oVU-fyRGSk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8L-94sDCn4RralQux59PpQrdj26zJ8FOetjAtzGrkt7w&oe=6A37FE7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szO3UxJfuDQQ7kNvwFHMYsU&_nc_oc=AdqSQXm6m-d44hvzj0oVM5fyl9PdniKipzuL_jPT9DCGQr6iLMgx-kkBJmx6oG5Y38s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_D4Si67QOJcJHNUAET5MuM3zBBdMD7aaOhfxfymcyLDg&oe=6A37E369"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null,
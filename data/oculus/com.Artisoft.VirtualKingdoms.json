=AdoxInMz9C7aECRwddFNKKhA36_edVSv8re91Lp10vJlIoXaKHYMGQ1XWbgfyBAcAYs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74uGn8KDx0JN-0jcqZxu21bcC1dmLd6BCk-cTYn7HRIA&oe=6A033863"}, {"file_name": "sc3.png", "id": "1332901451209610", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDT9Q78234UQ7kNvwHLFc3H&_nc_oc=AdqdoB7F8LCQKYdK8BY-kCU6kzRTJ_GZFr03uIX0M5cwyXPgeTHROvhuDXnDsujR0EA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4r6XDuwuddfWrvJCSj0wD9jPPGK3GUTVfyhX9RGWwurA&oe=6A0322D0"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NY_mEwkj-c8Q7kNvwFtpaFY&_nc_oc=Adr99uHFpRHQHzuTlkfn3lcNU1yxcwNs1BmQvZIs6YWLHWnoHrFXX0hcm3rlbg22gWE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5j2rNCT8O8q6ErkFwfN2CiSbu3zCy6o7I9BR3i97OLPw&oe=6A0314E7"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxUB868kzZEQ7kNvwHo5BlE&_nc_oc=AdpRYGn_mG1HmMSVbn3bmZlOlv4e-N4wYye0Dvkc0vqNqs5Rs3_vq7arND3gIJ97ISM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gLqLS9YhYiEg5CXnZ7nvqyxTiXoSiHOlNM-Mxr4H75w&oe=6A03427A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqEf-plAv3MQ7kNvwG0v9DF&_nc_oc=Adr4XOXN1vIX90hUdpbOCR1nSkxn9UzUFPrAvFj2qCCK3lpopTOdGvv-OLB0WXPiIbw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ple_Jn9gaauvRzQS2IW22joe3v-PY8NS5jSlHgpYD8g&oe=6A032769"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null,
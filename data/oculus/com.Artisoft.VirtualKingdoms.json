Xt8WuAhQwSgZmA&oe=69AC3563"}, {"file_name": "sc3.png", "id": "1332901451209610", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thVDqskntEQQ7kNvwGjAgqy&_nc_oc=Adk0Uri2r4lXozuzlVio1s4Z8w67N9AYjzbDNi-CJ-NiZPUNpV5LcmshJNIYzISdXGQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyG4LQ3Tn_2rt1h44bQuhXuL5oSnKBxbqrT_aScVxnq-w&oe=69AC1FD0"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkXh6fTYRJMQ7kNvwGm5BbY&_nc_oc=Adn8jTMh-2IVqYN6mB8whdkPiKuGUDWH5Gaod46v1eJqGdgPcY9tdZnXXBYLfMkZ3VQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8nEOo_8ZVk9z53lpn6-r8Tx789yHbKLp9tXPpfRu94A&oe=69AC11E7"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxeHNDOiL2kQ7kNvwHy5-zi&_nc_oc=AdkmSuenGoljAnmu3kDOisY-ePUbMKPAbttdJzmeYG_gGNcRe6qroheDFfqWnxn5AIA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxvAK7zJhSGCfELfpkyV9-SBu7dMMtBoExaxxjWDUvDRQ&oe=69AC073A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oy22kGzUaT4Q7kNvwGmpRRv&_nc_oc=AdnpcwCestZPUpc7bUvXGlZ8FY2k4sb7DO1APTZuPR2r2KbnuN2YeBdwdhuKK8CuqiA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwOag4c4AgLHM5mJgK021V_6YNuMWmGRwF5CO89eS4SKQ&oe=69AC2469"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852
=Adotfp2OCzGMyp9jU_vhKYyNwnRwCvYnh7MUpYHgmdWJCANwxTD41JwHp317YPm0754&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClpVzylFZ9LILB9cFEAU1MfmSuRA5fsuMSfIPlohqh8g&oe=6A6618E3"}, {"file_name": "sc3.png", "id": "1332901451209610", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UOodBHNi8QQ7kNvwHeDMUJ&_nc_oc=AdpOL0cCCn3K9llRM1p6ihycfQkRmmpCYpPdKA-JV7WCinpqyS8cUgj211CKLsa_1EI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyfR9Ej1Ayi-8a2nIauojx3yqbbWiDsY9qz4KT3cC-fQ&oe=6A660350"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVhpKAedCRcQ7kNvwHEzKAh&_nc_oc=AdpwEqEmbcT1Yb5hpTz7EK7GMPTjq7e5O5tYkY17ezuLnBWJvk3KvnSLKEle2NN25pY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmkkTlPo1nz4v2Ee-nFVneVz_l1vKzoNBbuvf2yZPX2Q&oe=6A65F567"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEv2MF4TC18Q7kNvwFQCbK0&_nc_oc=Ado29R09weu1r4FitcVpEICIEMaVETiDwVfFtlua1ZdukjHt5OXQa3LHgxI9gXgfH20&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1eFCZwYY8vrXDwhXA-Q2u6WAvhKZGMLta9I3MuoZiWQ&oe=6A6622FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Yb_egOtwAwQ7kNvwGuLkDM&_nc_oc=Adqq4HFrjnCetWCfQ_kS6Ege4bxuetycStyWKQIw9qRPwvziWaoYpjEHGy9AQxs-umo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDJwpXP6G6S_cCbpcth8sQtejPTTAqkVqijds1BIWVfQ&oe=6A6607E9"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null,
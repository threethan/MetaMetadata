=AdrTo9cYOxt1F1xrkhsislPEmnrtbFMWqOMONmRrTQGmtikcUrL3x1t74_oxJ_HC64Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhme-5rnZDmzOBbpc8iP7-aXOjR8OA7l136ha8wj8BDw&oe=6A68BBE3"}, {"file_name": "sc3.png", "id": "1332901451209610", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aux8O7H_x18Q7kNvwGLZm6t&_nc_oc=AdonnvB1Z-MMi8rQUTR_A6VB0rE8M7pHAdlAhGPjpsrezdGg_DlK2E2HpAD83GBi_xk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQBwdgN5QHelRxwItNuytVCnxtcJBeAgOYJhBs3NJxBw&oe=6A68A650"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVhpKAedCRcQ7kNvwHtGDRY&_nc_oc=AdpYGAzqMIpGlwGeEeQMRCX-gb8GBNHZel6vGcU8jKsVnFiJZSTiWaNnUW_znD7fAGI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAt7PIDhdZhKymJeEF78CVS5YJNR7yIBoH0w4hpjwIu2g&oe=6A689867"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGwKVgrUZ9AQ7kNvwGtKbry&_nc_oc=Adrnm3HMhgTEOV5O1VsRydV3RR-SrTRPq1z4eJ0PE2HK5ajWh89mOPV-4xzQKomDSe0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgz-bKYUGHbR9nVoJKeJa5g3Z8n5KvXLy5VrOo9MIRDg&oe=6A688DBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SO625r_J3ccQ7kNvwFSb7Uy&_nc_oc=AdpWX8t5ZpTwffQg47RzL3b7NcFtRQaz-FOIqu-2k5puicC_yJIBY7By03HeBtr9kQw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAU8Laa3ieZHzb6aqfux50Q0ZW2ctq_MihnfAvfZSQs8g&oe=6A68AAE9"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null,
o2AmyGT75VQC0FxOHd8iEzn_Wp2J5fm4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzlXjM9Aq81T6HlahxerdLflFFVFBAo5WeHNceRdCTC-g&oe=69C14D63"}, {"file_name": "sc3.png", "id": "1332901451209610", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035426_1332901454542943_9137675190831643961_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFzUJ6mAB-EQ7kNvwHjw6b-&_nc_oc=Adq152Dq-lFWsAdf7zzRuProUrCRZTtTKKDaJbeh_V2wo7vL_VUph_8EWVsLei4EfVU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzHNcJxZizjduBKJZuDcS11isdtuVbyFv66sOPDNVEiJg&oe=69C137D0"}, {"file_name": "sc4.png", "id": "1204208754212446", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982555_1204208757545779_923760938032234225_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3vLhuxoRsUQ7kNvwFeJeGm&_nc_oc=AdqDLk_noj1wgLCYX3KOSEyQSIJRKnZstjRYL3s_su06wM2bt9SUhb0QbgU-SbRtNbM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyqcQys6AnY54OweySKLEz5SY9DqWvwVFK4IUuyGfkRIQ&oe=69C129E7"}, {"file_name": "sc5.png", "id": "1341448400169496", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982557_1341448406836162_5261155403751598858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCAY4LxiBlwQ7kNvwFZmMkN&_nc_oc=AdpeeecdOjxCg0G6u-92h1wlOEzRUfqZmhtnTINPDy9Om4ecHMt0htTAonuqpnrwP-k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy53AOysd-55NKaJ7XsT5A-cUOOuf-8pdFF7CNnJLkvvQ&oe=69C11F3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK1.png", "id": "515514147973279", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974804_515514151306612_3479715154840138267_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIwidcPBVJIQ7kNvwFjYUfS&_nc_oc=AdrIgnKM3S5drLIXjnAGjJjuv6l2X-zYUq1x5dQ7bYKo2PeMFW6CkOWj2skG3DEnEbA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzCSpGcoAag0Drp3UUF-mes_R8rIzNbWaj03AHySAHMVg&oe=69C13C69"}, "display_name": "Virtual Kingdoms", "keywords": ["strategy", "battle", "command", "fight", "knight"], "long_description": "**Immerse yourself in the heat of battle.**\n\nExperience the thrill of real-time strategy in a fully immersive virtual reality environment. Choose from a variety of maps, each with its own unique terrain and challenges. Select your opponents and prepare for an epic clash.\n\n**Command Your Army from the Front Lines.**\n\nGather resources, build crucial structures, and train powerful units to dominate the battlefield. With intuitive VR controls, you'll feel like a true military commander, directing your forces with precision and strategy.\n\n**Annihilate Your Enemies.**\n\nOutmaneuver your opponents, launch devastating attacks, and seize strategic points to gain the upper hand. The ultimate goal is simple: eliminate your enemies and claim victory.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Feel the intensity of battle as you command your forces from the front lines.\n- **Strategic Gameplay:** Plan your attacks, manage resources, and build a powerful army.\n- **Diverse Maps:** Explore different environments, each with its own unique challenges and opportunities.\n\nAre you ready to take on the challenge and become the ultimate VR RTS commander?", "short_description": "Immerse yourself in the heart of battle as you command your forces in a fully immersive virtual reality experience. Gather resources, build powerful armies, and outmaneuver your opponents in epic clashes. With intuitive VR controls, you'll feel like a true military commander, strategizing and executing your plans with precision. Are you ready to take on the challenge and become the ultimate VR RTS dominator?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/vk_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://vk.artisoft.pl/support.html", "website_url": "https://vk.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags
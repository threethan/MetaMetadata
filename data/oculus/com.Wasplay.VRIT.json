_9noBhg9IG04kAvTjl8Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzjzpJv1TtBejZ2DQD4QmssBmRcrGd84aAqYRjskZtxw&oe=6B01C54E"}, "display_name": "VRIT", "keywords": [], "long_description": "It's time for your daily dose of sport.\nVRIT is a VR fitness game made possible by the power of hand-tracking to let you do your exercices without those annoying controllers.\n\nSome annoying robots are stealing your precious clouds, but you won't let them.\nRun (while shooting some robots), do push-ups, abs, squats.. and more to come !\nShow them your muscles and destroy them.\nVRIT turns sport into a fun and action-packed session.", "short_description": "Add some explosive sport to your daily routine with VRIT !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pastebin.com/raw/kerViG0K", "developer_terms_of_service_url": null, "publisher_name": "Wasplay", "support_website_url": null, "website_url": "https://discord.gg/y3thsPB", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "ACTION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1013084952887071"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1891683785136464"}, {"status": "PUBLISHED", "id": "1956161759113812"}, {"status": "PUBLISHED", "id": "866666749070657"}, {"status": "PUBLISHED", "id": "1270209294734669"}, {"status": "PUBLISHED", "id": "584913554409594"}, {"status
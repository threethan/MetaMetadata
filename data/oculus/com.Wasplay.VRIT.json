Yx-7jdqRSXhm6_MYlroBCTDAzh_5v8PBoXlAS1LdwqKheAdxedqU1C-GUOBS_w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVwckCNWm-FMtB7o3vAV-ozAduYV7XKRRJM1My6RSuStw&oe=6B1049D8"}, {"file_name": "IMG_20250407_175106.png", "id": "639967009014526", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391845_639967012347859_8696163035317677617_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCBQrnvL2IQQ7kNvwEbvk6n&_nc_oc=Adrz7dIIqwIrm0PWYplp7YT1IF_e_Jrvtl4GSTFPfQr4UiUD62LsYjaexhF9XmTp7Pw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVZqAfjSWqiqG4d8A3najsFayU6CJY-i-5MI6ntyNvkGA&oe=6B104992"}, {"file_name": "IMG_20250407_175123.png", "id": "1180194287180680", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391814_1180194290514013_2503762577210822052_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbvBxJpp9DMQ7kNvwFX-d6v&_nc_oc=Adqdd-mZt7pSPBHzm3zqZUUPxczHP_1WQ6u-KFu3tA6Gfol3SvlLayBlpaKBbMmqjEc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUoXithCMY6m0j2H4mSKlpHD6vsLhgxHhTllbV32zQPkg&oe=6B1046FB"}, {"file_name": "IMG_20250407_175210.png", "id": "1710344276545084", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391739_1710344279878417_6392433131893774073_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0h4BptzDV6gQ7kNvwHvI5g5&_nc_oc=Adr_SIKjVpIOiIWMgG_F9oIDEuuTz6gzEY0J74myHn5NUWST2HetI4ikZwnN99NbbrQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVTigVjxrBVLsynoymYNkhBw_MSBygK2f8mAThzncYOuQ&oe=6B105578"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "478899077676648", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974713_478899084343314_368915632794476489_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7j56iq4k44UQ7kNvwHMKcDi&_nc_oc=AdonzAZblizYFGMcxrQSqXhps6CcVUV4zAzeqpV3sY7qw5LzqmAf5R0cjAjqBoxUTjU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVTqvTDVszlBTs_9B5ILeFLVDDp2BP705UFT6EAbsc7oQ&oe=6B104475"}, "display_name": "VRIT", "keywords": ["fitness", "crossfit", "workout", "body", "fit"], "long_description": "**VRIT** is a VR fitness game made possible by the Quest's hand-tracking feature to let you do true exercises without controllers.  \nDestroy robots and earn rewards while doing your daily workout : **VRIT makes fitness fun.**\n\n# Full body exercises\n{539814865827589}\nDo actual abs, push-ups, burpees and a lot more without having to care about controllers!  \nVRIT can accurately follow your movements using only your head's position.\n\n# Do your daily workout in the ADVENTURE MODE\n{3044080589099219}\nThe robots are trying to steal all your water! Fight them **with your muscles**, alternating between shooting phases and various exercices.  \nThe difficulty of the challenges you face **will adapt to you** over time.  \nGet additional rewards by playing regularly and by being phenomenal!\n\n# CUSTOM PROGRAMS\nCreate your own workout programs and save them for later.\n\n# MUCH, MUCH MORE\nShoot robots using your hands while running in the **RUN** phases!  \nEarn **cosmetics** for your tiny island such as new materials and special props!  \nCompete with your friends in the **leaderboards**!  \nVRIT is more than a simple workout app.  \n\n# It's time for your daily dose of action-packed sport.\n{606607422353949}", "short_description": "Add some action-packed sport to your daily routine with VRIT !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wasplay.fr/vrit-privacy", "developer_terms_of_service_url": null, "publisher_name": "Wasplay", "support_website_url": "https://wasplay.fr/", "website_url": "https://wasplay.fr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"
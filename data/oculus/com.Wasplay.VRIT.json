m/v/t64.5771-25/473391845_639967012347859_8696163035317677617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwoudLdm2V8Q7kNvwE0z0BK&_nc_oc=AdrwirZ6_9uVwJfrlJj7_2VVJ-4HWXfFAdLjzX24MgY4tufPVUmtxoyIkhxu4Mm7vZI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3lxKFEWroLDSbAGE561CHFTBlNYBsnkHG4Ope1dbqurA&oe=69F1FBD2"}, {"file_name": "IMG_20250407_175123.png", "id": "1180194287180680", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391814_1180194290514013_2503762577210822052_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVd6Cv1EazwQ7kNvwF-vDax&_nc_oc=AdoKa__79cfrYdJKFqySyAoY_XmfrJS2gBtTZQZW2u9DqkwAcopNRJtfAVUrrTW9dbc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Du4QNniqigm37ezcr-VMyUcHfj2l4nq8kZtMVXlOzIg&oe=69F1F93B"}, {"file_name": "IMG_20250407_175210.png", "id": "1710344276545084", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391739_1710344279878417_6392433131893774073_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNPSrgpFOqUQ7kNvwERpKoC&_nc_oc=AdrEzdM8cJhJ7EebVTP7haqt2rSGXiyHKU_SgHTUTiLj0A4a7Hhdul3Q7isNUTeM2FQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1XP8-QPxDqRZZmOV7BSZwrYfM68mds18f6bAqGC3ut-Q&oe=69F207B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "478899077676648", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974713_478899084343314_368915632794476489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3Y3JRpXjV0Q7kNvwEvQSyU&_nc_oc=AdrXwFBkow8W9Xigpvfr6jWodGCFSpZ7EpjUAJer2UEsV7OsWaKIUv0h5fb0Q1i7q08&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3JioYCL1BGG2GrGDQfQekILELVU2ILlG7kM1i08YgobQ&oe=69F1F6B5"}, "display_name": "VRIT", "keywords": ["fitness", "crossfit", "workout", "body", "fit"], "long_description": "**VRIT** is a VR fitness game made possible by the Quest's hand-tracking feature to let you do true exercises without controllers.  \nDestroy robots and earn rewards while doing your daily workout : **VRIT makes fitness fun.**\n\n# Full body exercises\n{539814865827589}\nDo actual abs, push-ups, burpees and a lot more without having to care about controllers!  \nVRIT can accurately follow your movements using only your head's position.\n\n# Do your daily workout in the ADVENTURE MODE\n{3044080589099219}\nThe robots are trying to steal all your water! Fight them **with your muscles**, alternating between shooting phases and various exercices.  \nThe difficulty of the challenges you face **will adapt to you** over time.  \nGet additional rewards by playing regularly and by being phenomenal!\n\n# CUSTOM PROGRAMS\nCreate your own workout programs and save them for later.\n\n# MUCH, MUCH MORE\nShoot robots using your hands while running in the **RUN** phases!  \nEarn **cosmetics** for your tiny island such as new materials and special props!  \nCompete with your friends in the **leaderboards**!  \nVRIT is more than a simple workout app.  \n\n# It's time for your daily dose of action-packed sport.\n{606607422353949}", "short_description": "Add some action-packed sport to your daily routine with VRIT !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wasplay.fr/vrit-privacy", "developer_terms_of_service_url": null, "publisher_name": "Wasplay", "support_website_url": "https://wasplay.fr/", "website_url": "https://wasplay.fr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "ACTION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "
jkzRXGp6IP438c87uhY-eoGMveqChW9SycXWYBhO8HyGg59SKB-apa66rA6x3E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0koebvMVFggjq4mB0p5GgfIoZJH48GfTk4akCPlNaCw&oe=6B01C958"}, {"file_name": "IMG_20250407_175106.png", "id": "639967009014526", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391845_639967012347859_8696163035317677617_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sv2mBCroDlYQ7kNvwHjdpl9&_nc_oc=AdqsAN2Hen2sLH5B7vXptN3iyDn8cxL3GLYDiN2Nfb3Mi26KQEvwKzKfXDno03SBhFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOLNjETeEQHK5Xn63hk6hMjiYrSk-Cn-v72bETkGB1BQ&oe=6B01C912"}, {"file_name": "IMG_20250407_175123.png", "id": "1180194287180680", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391814_1180194290514013_2503762577210822052_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6h8OKZwyhwQ7kNvwHG1_Xl&_nc_oc=AdqtLWUvgOm_zcv6Auic3NerY37E3TkPiEORHLIxvi6Tg0k2rF4SIXC32GLYIrkTTMk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhrYqcKTT7OLNrF-ScBvUtWU0rSUb7-gBqwBQhiZy6xQ&oe=6B01C67B"}, {"file_name": "IMG_20250407_175210.png", "id": "1710344276545084", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391739_1710344279878417_6392433131893774073_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEeZqNvgScwQ7kNvwEJAerx&_nc_oc=Ado4xxDbWung5fGA0jZI_uUCXVO_cGPM9sI4ITpsuAFQdQYK6agG-3kgAebVOJm34B0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQneH8iQ2zL_30eiKBH4qmKxk7amClnMe6IAutLHSxpjA&oe=6B01D4F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "478899077676648", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974713_478899084343314_368915632794476489_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqjbYCvxuB0Q7kNvwFtsE2Y&_nc_oc=AdppLHCO4XsyoZWXhTrvA4_-tOmbCJoArNg1oF1hKiUk5vNJ7aX9_gHQ0rIGUB2vH9Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ27UyHTjAa2eFXs3wepMssjX7QdARYFGadLJ83DhbUMg&oe=6B01C3F5"}, "display_name": "VRIT", "keywords": ["fitness", "crossfit", "workout", "body", "fit"], "long_description": "**VRIT** is a VR fitness game made possible by the Quest's hand-tracking feature to let you do true exercises without controllers.  \nDestroy robots and earn rewards while doing your daily workout : **VRIT makes fitness fun.**\n\n# Full body exercises\n{539814865827589}\nDo actual abs, push-ups, burpees and a lot more without having to care about controllers!  \nVRIT can accurately follow your movements using only your head's position.\n\n# Do your daily workout in the ADVENTURE MODE\n{3044080589099219}\nThe robots are trying to steal all your water! Fight them **with your muscles**, alternating between shooting phases and various exercices.  \nThe difficulty of the challenges you face **will adapt to you** over time.  \nGet additional rewards by playing regularly and by being phenomenal!\n\n# CUSTOM PROGRAMS\nCreate your own workout programs and save them for later.\n\n# MUCH, MUCH MORE\nShoot robots using your hands while running in the **RUN** phases!  \nEarn **cosmetics** for your tiny island such as new materials and special props!  \nCompete with your friends in the **leaderboards**!  \nVRIT is more than a simple workout app.  \n\n# It's time for your daily dose of action-packed sport.\n{606607422353949}", "short_description": "Add some action-packed sport to your daily routine with VRIT !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wasplay.fr/vrit-privacy", "developer_terms_of_service_url": null, "publisher_name": "Wasplay", "support_website_url": "https://wasplay.fr/", "website_url": "https://wasplay.fr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"
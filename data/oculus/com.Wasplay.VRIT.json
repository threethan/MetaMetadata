rSUBaZgV2rx0vfOZcejWPf-YWzGPECP6HCrFrDSgaU_tZSjf4vsfT7a9qPhL98&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSitty7PFiBjYmXgWltTyYJa4rXFxgqXWHum6u3tG0L1w&oe=6B09B258"}, {"file_name": "IMG_20250407_175106.png", "id": "639967009014526", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391845_639967012347859_8696163035317677617_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DI8dTQM7rwQ7kNvwFsDjux&_nc_oc=Adop91KEFsLEvywXivYZ_UcBeWE5w80LfB19Rhjfq_WpcliW19eb95AKwtf4G8VjWbU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjenCF7Dz9r6H0LEPCoYC9aNsuQFZJdoWRzQOu4HYYNw&oe=6B09B212"}, {"file_name": "IMG_20250407_175123.png", "id": "1180194287180680", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391814_1180194290514013_2503762577210822052_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Et1RiZhEYAoQ7kNvwH2KvzX&_nc_oc=AdqcDCVAGuOWqeqtGZ2wWaxrfLfciDHcs0jbJNOI_rxMt3DB_4eZ5b4oAb12QZN9b-o&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUSzx2ycChxaDfxHOQmibn7Q-kn3nAzBXkISgKrkRKCQ&oe=6B09AF7B"}, {"file_name": "IMG_20250407_175210.png", "id": "1710344276545084", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391739_1710344279878417_6392433131893774073_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpiXUJhWdhIQ7kNvwEHTZLC&_nc_oc=AdpRa131XLH14jCLqWj315cCl7qQuWLoS_9we7YfUY8nvDohwlCeBLbNm_Cw0DS7eLQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzZF-NMAO4AbuKrLRJrVEp4i-6N9JAo_AOeimtbVL-7A&oe=6B09BDF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "478899077676648", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974713_478899084343314_368915632794476489_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdRM4sc_CFMQ7kNvwH6pWj1&_nc_oc=AdpGtU5lW9IG5Stvz4mYp-pgCQn4mMHxyRaYiqHMoeAlm2aU6e89KicmOTrf9lKdg8E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRibJL6jUnEPJe30eygWyZYEgRLXKWC-Tzq4RE1JpUG3g&oe=6B09ACF5"}, "display_name": "VRIT", "keywords": ["fitness", "crossfit", "workout", "body", "fit"], "long_description": "**VRIT** is a VR fitness game made possible by the Quest's hand-tracking feature to let you do true exercises without controllers.  \nDestroy robots and earn rewards while doing your daily workout : **VRIT makes fitness fun.**\n\n# Full body exercises\n{539814865827589}\nDo actual abs, push-ups, burpees and a lot more without having to care about controllers!  \nVRIT can accurately follow your movements using only your head's position.\n\n# Do your daily workout in the ADVENTURE MODE\n{3044080589099219}\nThe robots are trying to steal all your water! Fight them **with your muscles**, alternating between shooting phases and various exercices.  \nThe difficulty of the challenges you face **will adapt to you** over time.  \nGet additional rewards by playing regularly and by being phenomenal!\n\n# CUSTOM PROGRAMS\nCreate your own workout programs and save them for later.\n\n# MUCH, MUCH MORE\nShoot robots using your hands while running in the **RUN** phases!  \nEarn **cosmetics** for your tiny island such as new materials and special props!  \nCompete with your friends in the **leaderboards**!  \nVRIT is more than a simple workout app.  \n\n# It's time for your daily dose of action-packed sport.\n{606607422353949}", "short_description": "Add some action-packed sport to your daily routine with VRIT !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wasplay.fr/vrit-privacy", "developer_terms_of_service_url": null, "publisher_name": "Wasplay", "support_website_url": "https://wasplay.fr/", "website_url": "https://wasplay.fr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"
: "639967009014526", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391845_639967012347859_8696163035317677617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReqU9Fx-VTgQ7kNvwGqRk7t&_nc_oc=Adr2XW0TTRqXyo9Q_Bq8J3jWRWk8untvQgQndkdrHpZH3HidiUm2Z0pN4mvxBF6hPGo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OfBWuOUW5QfqFQLBS88nTSh7R05FDdvz5qsSfeSrOjg&oe=6A295AD2"}, {"file_name": "IMG_20250407_175123.png", "id": "1180194287180680", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391814_1180194290514013_2503762577210822052_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RtvyBZoCtUEQ7kNvwGA02en&_nc_oc=Adq0q14267crBOmZAKpnSAJLPo2g7S4jz_nUM8zbDxTKzcuZK5W3G73BtOpU2Ph4FKg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JR8PRBqzElPwM403Zvdz5L8Zsu4soRsUlYRpop1uOgQ&oe=6A29583B"}, {"file_name": "IMG_20250407_175210.png", "id": "1710344276545084", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391739_1710344279878417_6392433131893774073_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d91MVbVFaE8Q7kNvwEhC-vs&_nc_oc=AdqgmSHokeA0BoeNBbA9hBnP6Ar1wSZrOs2yCkb9G_R9f3oer2Bj3yvHmdQHiAVaCcA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NzVRggnl-KxdIxfvhSQRG7cVvkUHLwKZW9hwAlu0fWg&oe=6A2966B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "478899077676648", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974713_478899084343314_368915632794476489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fr4W9dmbgc4Q7kNvwG_d8Pg&_nc_oc=AdoHVJ2wAXSoxGyWNjvXqS9DL-BVIRIvMbH2b6VWvGUX6ylVe3cvywaPTG8l6u-AH7M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_egQooEw6VeJtAkMbFUkHnjohn3m9Pqw7zTFl6R5T4fg&oe=6A2955B5"}, "display_name": "VRIT", "keywords": ["fitness", "crossfit", "workout", "body", "fit"], "long_description": "**VRIT** is a VR fitness game made possible by the Quest's hand-tracking feature to let you do true exercises without controllers.  \nDestroy robots and earn rewards while doing your daily workout : **VRIT makes fitness fun.**\n\n# Full body exercises\n{539814865827589}\nDo actual abs, push-ups, burpees and a lot more without having to care about controllers!  \nVRIT can accurately follow your movements using only your head's position.\n\n# Do your daily workout in the ADVENTURE MODE\n{3044080589099219}\nThe robots are trying to steal all your water! Fight them **with your muscles**, alternating between shooting phases and various exercices.  \nThe difficulty of the challenges you face **will adapt to you** over time.  \nGet additional rewards by playing regularly and by being phenomenal!\n\n# CUSTOM PROGRAMS\nCreate your own workout programs and save them for later.\n\n# MUCH, MUCH MORE\nShoot robots using your hands while running in the **RUN** phases!  \nEarn **cosmetics** for your tiny island such as new materials and special props!  \nCompete with your friends in the **leaderboards**!  \nVRIT is more than a simple workout app.  \n\n# It's time for your daily dose of action-packed sport.\n{606607422353949}", "short_description": "Add some action-packed sport to your daily routine with VRIT !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wasplay.fr/vrit-privacy", "developer_terms_of_service_url": null, "publisher_name": "Wasplay", "support_website_url": "https://wasplay.fr/", "website_url": "https://wasplay.fr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "ACTION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
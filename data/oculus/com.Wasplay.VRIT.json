317677617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xjf18JxZN5wQ7kNvwH5fO3p&_nc_oc=AdkG0eMfpyz7_MM42K93UNkb4ijxGm_8MWA0Y26_o8Kz1Q9tizDQJArfl4mKza2cRXE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afup4ImQO8WISgJN05Sb90C1nItdXb3FG6OLak_xej3reQ&oe=69A584D2"}, {"file_name": "IMG_20250407_175123.png", "id": "1180194287180680", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391814_1180194290514013_2503762577210822052_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_h36ufAai9EQ7kNvwFrrXxl&_nc_oc=AdlUGmPxdZImkRntwZ1P4aCJwAlgNsrtrRFkVkehKyHfg66cTxchP9c85rVfe2XBEKk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs_MOGQWJb0gCxRyFuK6Le7ney2KV7YM_ciFlNGbU32fg&oe=69A5823B"}, {"file_name": "IMG_20250407_175210.png", "id": "1710344276545084", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391739_1710344279878417_6392433131893774073_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Th6VL53QsTAQ7kNvwGw7jyB&_nc_oc=Adm-FF1cCwXwrDtaTax-EG6zgy4J62cdSoFCMhSLRhK52dH9GAOJCSk36aZ163hc5Ug&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsHlFp8sRy8Tbv0FazUal1DRt0qi8QYAkz532VnMY09Rg&oe=69A590B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "478899077676648", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974713_478899084343314_368915632794476489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRrmjkbyF5kQ7kNvwEhsV8M&_nc_oc=Adl-6kl9GyFzfM0LpM3X57KdGubm0JaavmhP0sqIqnXSsUEiz5beie_Sei6FGWcjIyQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftMSCYqxKo1ZWVit5LOmKS3ec0VsQIdYBJ_SAGmuAOKyQ&oe=69A57FB5"}, "display_name": "VRIT", "keywords": ["fitness", "crossfit", "workout", "body", "fit"], "long_description": "**VRIT** is a VR fitness game made possible by the Quest's hand-tracking feature to let you do true exercises without controllers.  \nDestroy robots and earn rewards while doing your daily workout : **VRIT makes fitness fun.**\n\n# Full body exercises\n{539814865827589}\nDo actual abs, push-ups, burpees and a lot more without having to care about controllers!  \nVRIT can accurately follow your movements using only your head's position.\n\n# Do your daily workout in the ADVENTURE MODE\n{3044080589099219}\nThe robots are trying to steal all your water! Fight them **with your muscles**, alternating between shooting phases and various exercices.  \nThe difficulty of the challenges you face **will adapt to you** over time.  \nGet additional rewards by playing regularly and by being phenomenal!\n\n# CUSTOM PROGRAMS\nCreate your own workout programs and save them for later.\n\n# MUCH, MUCH MORE\nShoot robots using your hands while running in the **RUN** phases!  \nEarn **cosmetics** for your tiny island such as new materials and special props!  \nCompete with your friends in the **leaderboards**!  \nVRIT is more than a simple workout app.  \n\n# It's time for your daily dose of action-packed sport.\n{606607422353949}", "short_description": "Add some action-packed sport to your daily routine with VRIT !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wasplay.fr/vrit-privacy", "developer_terms_of_service_url": null, "publisher_name": "Wasplay", "support_website_url": "https://wasplay.fr/", "website_url": "https://wasplay.fr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "ACTION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2439737716652081
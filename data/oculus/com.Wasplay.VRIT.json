dUAYmqdMRrxvKKsu-wVjywEmq7ymzDGsUAidvhirsAxMuM-jnIn_r0FqZPKYbI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTChX-Yy7PMW2amiPP7mg3j5vXFSHt3rpBjoS242aDyNA&oe=6B0B3C18"}, {"file_name": "IMG_20250407_175106.png", "id": "639967009014526", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391845_639967012347859_8696163035317677617_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXTQbb_Pz_kQ7kNvwHhysYs&_nc_oc=Ado1bfi6tour5aowUgKQDGwHnEcJvnfsjAoOLwQ-J6-0XtG4PwvJwpz8i9LUElTHEGI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRBzZAdz_E_l1RHo-RaKzx0e3xAxg35TROi0a9I1z9Saw&oe=6B0B3BD2"}, {"file_name": "IMG_20250407_175123.png", "id": "1180194287180680", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391814_1180194290514013_2503762577210822052_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Et1RiZhEYAoQ7kNvwEGrhka&_nc_oc=AdopYPLukCilC9p7PFcnikft_i4ekaGvhoisuMepN6ZV8OkBo9M_-vj6YJxewFhEFX8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRfYFKko1fGndflUZBhou0KZf1QTaWQ7DW5Ddki-pgS9Q&oe=6B0B393B"}, {"file_name": "IMG_20250407_175210.png", "id": "1710344276545084", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391739_1710344279878417_6392433131893774073_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpiXUJhWdhIQ7kNvwEWkNM8&_nc_oc=Adrd4bNOeLbDreC3h1S4VLzn89PJfbKhD8oZikBVny9UzCRGXsPen1VLMG4h_4ggAsA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTbjQokXsr6vXwtG9X_FoBADDCz38fQogLCyUZ1YFTehQ&oe=6B0B47B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "478899077676648", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974713_478899084343314_368915632794476489_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQdx6IpfsmcQ7kNvwGEJTmU&_nc_oc=Adqft-ANe9MNgerQF5RCQw62N-feGBwPYoA__zazXdJlDcTc6njCrTcOfUX0O3dMcQ0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTXRMoGtKUGc-rXF7pRtqK8-p4uqegsdCm0qC341tTY_w&oe=6B0B36B5"}, "display_name": "VRIT", "keywords": ["fitness", "crossfit", "workout", "body", "fit"], "long_description": "**VRIT** is a VR fitness game made possible by the Quest's hand-tracking feature to let you do true exercises without controllers.  \nDestroy robots and earn rewards while doing your daily workout : **VRIT makes fitness fun.**\n\n# Full body exercises\n{539814865827589}\nDo actual abs, push-ups, burpees and a lot more without having to care about controllers!  \nVRIT can accurately follow your movements using only your head's position.\n\n# Do your daily workout in the ADVENTURE MODE\n{3044080589099219}\nThe robots are trying to steal all your water! Fight them **with your muscles**, alternating between shooting phases and various exercices.  \nThe difficulty of the challenges you face **will adapt to you** over time.  \nGet additional rewards by playing regularly and by being phenomenal!\n\n# CUSTOM PROGRAMS\nCreate your own workout programs and save them for later.\n\n# MUCH, MUCH MORE\nShoot robots using your hands while running in the **RUN** phases!  \nEarn **cosmetics** for your tiny island such as new materials and special props!  \nCompete with your friends in the **leaderboards**!  \nVRIT is more than a simple workout app.  \n\n# It's time for your daily dose of action-packed sport.\n{606607422353949}", "short_description": "Add some action-packed sport to your daily routine with VRIT !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wasplay.fr/vrit-privacy", "developer_terms_of_service_url": null, "publisher_name": "Wasplay", "support_website_url": "https://wasplay.fr/", "website_url": "https://wasplay.fr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"
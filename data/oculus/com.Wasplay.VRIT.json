 daily routine with VRIT !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pastebin.com/raw/kerViG0K", "developer_terms_of_service_url": null, "publisher_name": "Wasplay", "support_website_url": null, "website_url": "https://discord.gg/y3thsPB", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "ACTION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1013084952887071"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1956161759113812"}, {"status": "PUBLISHED", "id": "866666749070657"}, {"status": "PUBLISHED", "id": "1270209294734669"}, {"status": "PUBLISHED", "id": "584913554409594"}, {"status": "PUBLISHED", "id": "868751741908879"}, {"status": "PUBLISHED", "id": "454224180769312"}, {"status": "PENDING", "id": "701165288027095"}, {"status": "PUBLISHED", "id": "302516501340218"}, {"status": "PUBLISHED", "id": "1523054584874911"}]}, "baseline_offer": {"id": "454224180769312"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771005600, "status": "PUBLISHED", "id": "1956161759113812"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8638869799464805", "version": "2.3b"}, "id": "710309429649470", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "Andro
u37LgtAZkcOjWCRuDIcDZBH2JPH0bVtBXdJlwxYm4vjCia1lR5Djc_BJfx2wiU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGqr8bLzGd3CPR0LCo7SxoaKlhvWjOQdOMywjeI1kpxQ&oe=6AFC8358"}, {"file_name": "IMG_20250407_175106.png", "id": "639967009014526", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391845_639967012347859_8696163035317677617_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wK2c0KABlQ4Q7kNvwGJeKxD&_nc_oc=AdpGoDEao4uT1f7ZULyU4kBKi-a4inxKcog51YMiuXSPG433OdDH6CBWZSFRbIzv4SM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWLRVif2utHJuqau6OxXM0IGyXzLBEKV5bQ1bgmyKoDg&oe=6AFC8312"}, {"file_name": "IMG_20250407_175123.png", "id": "1180194287180680", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391814_1180194290514013_2503762577210822052_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFslPFNj0sYQ7kNvwEnMSpV&_nc_oc=AdpIOFQhu-k0awSW2OFjXbcG3Z5xlxaLUvakf2bxmfo18osYydFRk21hHYEfcHSL1so&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTq6ADvO9igHzOqBsUtt0Pz-qGXm94qppKi02aArUJQwQ&oe=6AFC807B"}, {"file_name": "IMG_20250407_175210.png", "id": "1710344276545084", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391739_1710344279878417_6392433131893774073_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDChGz7UzigQ7kNvwFeX_8W&_nc_oc=AdonJ1_v1iUsiRY8qugjUs8QzUqozw0ZoGvfzX48BxTfOSbIi6sX4ERP5slZJDN-SAE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm1WeCpWuZ1XjelHXOU5zunULmr3-sWSCWtLy9IPsIYQ&oe=6AFC8EF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "478899077676648", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974713_478899084343314_368915632794476489_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mc0R1BV0gaEQ7kNvwFjJ8C2&_nc_oc=AdrLDi0pGgcNcU3S-8CXZjTMNBzGiI1lFKqEww2c9zxw-ICDDVFqeAIRIBcZWtk5R80&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyEaraN42Z2yjc3PEWDhEWFq8XnglsNgPm5SNcEk0xCg&oe=6AFC7DF5"}, "display_name": "VRIT", "keywords": ["fitness", "crossfit", "workout", "body", "fit"], "long_description": "**VRIT** is a VR fitness game made possible by the Quest's hand-tracking feature to let you do true exercises without controllers.  \nDestroy robots and earn rewards while doing your daily workout : **VRIT makes fitness fun.**\n\n# Full body exercises\n{539814865827589}\nDo actual abs, push-ups, burpees and a lot more without having to care about controllers!  \nVRIT can accurately follow your movements using only your head's position.\n\n# Do your daily workout in the ADVENTURE MODE\n{3044080589099219}\nThe robots are trying to steal all your water! Fight them **with your muscles**, alternating between shooting phases and various exercices.  \nThe difficulty of the challenges you face **will adapt to you** over time.  \nGet additional rewards by playing regularly and by being phenomenal!\n\n# CUSTOM PROGRAMS\nCreate your own workout programs and save them for later.\n\n# MUCH, MUCH MORE\nShoot robots using your hands while running in the **RUN** phases!  \nEarn **cosmetics** for your tiny island such as new materials and special props!  \nCompete with your friends in the **leaderboards**!  \nVRIT is more than a simple workout app.  \n\n# It's time for your daily dose of action-packed sport.\n{606607422353949}", "short_description": "Add some action-packed sport to your daily routine with VRIT !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wasplay.fr/vrit-privacy", "developer_terms_of_service_url": null, "publisher_name": "Wasplay", "support_website_url": "https://wasplay.fr/", "website_url": "https://wasplay.fr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"
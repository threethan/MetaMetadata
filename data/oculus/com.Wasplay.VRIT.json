dn.com&_nc_ss=7f20f&oh=00_Af8CeeaysJXORK4QYf7GR-NMrkzCn0A_QkMZNvKJbvXtYg&oe=6A3953B7"}, {"file_name": "screen4.png", "id": "466363667720049", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/86615896_466363671053382_6610687836148419085_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJLVOc8z2_oQ7kNvwHz4982&_nc_oc=Adoaibgc_a7ZY01QdYqQHr1FiLGecWKJS35duUoaBdRhqMnZOm2f4XPNVjxAbcgw4SI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XsdoYijS1nWHijZ6HxV1f5chPhD1KVt6nvUnPghp2Jw&oe=6A392AB4"}, {"file_name": "screen5.png", "id": "470612930777862", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982695_470612937444528_6361968081224546736_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-nrM4dtzDcQ7kNvwFUUNk5&_nc_oc=AdrSOhny16doSf5Y8scmHpDazWFZdhFpnC0BFMYBNJykinbKSks1XQmz9Z1Oy75I4_k&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Q7hgv2tAhmukXCdkbpsrnPwJrnfE_O4EmPeEsUqxHJw&oe=6A3932E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2021-02-28-17h16m00s899.png", "id": "257983042491003", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982586_257983045824336_6411080150472187017_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqGG8YRGGNUQ7kNvwELiDck&_nc_oc=AdqY8lbOzQi8I9u8jcr-kBV-ucvS56EH_14m6imqgIGUL0u0efbm6x3pbX__WMc6QHA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9w-8ntbqR2aQmWaIYuWoZjHdepJKXU07yYidzIpJiw7A&oe=6A39614E"}, "display_name": "VRIT", "keywords": [], "long_description": "It's time for your daily dose of sport.\nVRIT is a VR fitness game made possible by the power of hand-tracking to let you do your exercices without those annoying controllers.\n\nSome annoying robots are stealing your precious clouds, but you won't let them.\nRun (while shooting some robots), do push-ups, abs, squats.. and more to come !\nShow them your muscles and destroy them.\nVRIT turns sport into a fun and action-packed session.", "short_description": "Add some explosive sport to your daily routine with VRIT !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pastebin.com/raw/kerViG0K", "developer_terms_of_service_url": null, "publisher_name": "Wasplay", "support_website_url": null, "website_url": "https://discord.gg/y3thsPB", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "ACTION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1013084952887071"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1956161759113812"}, {"status": "PUBLISHED", "id": "866666749070657"}, {"status": "PUBLISHED", "id": "1270209294734669"}, {"status": "PUBLISHED", "id": "584913554409594"}, {"status": "PUBLISHED", "id": "868751741908879"}, {"status": "PUBLISHED", "id": "454224180769312"}, {"status": "PENDING", "id": "701165288027095"}, {"status": "PUBLISHED", "id": "302516501340218"}, {"status": "PUBLISHED", "id": "1523054584874911"}]}, "baseline_offer": {"id": "454224180769312"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771005600, "status": "PUBLISHED", "id": "1956161759113812"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8638869799464805", "version": "2.3b"}, "id": "710309429649470", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__
IcVVbJNj3KeEjrckMmy4QRbqEXufbJ9hHaKt4hlfxS1PMlVs_zYZkMNUC3J8V0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQa5ACORbSNKTdE1uAxdQvyZtMo7X73JuIychWGNk4zPw&oe=6AFF2658"}, {"file_name": "IMG_20250407_175106.png", "id": "639967009014526", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391845_639967012347859_8696163035317677617_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sv2mBCroDlYQ7kNvwEicklc&_nc_oc=AdqkL9R750Y-cge1V0VgubWNbFDSi3kuyp_5XRbKTI1mdyWZgPj7P2aX0MpZeR9P_ns&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmTvdGzQXU5SLNpSJGgGMql9duh8SXcFbmk9ED7XZBzA&oe=6AFF2612"}, {"file_name": "IMG_20250407_175123.png", "id": "1180194287180680", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391814_1180194290514013_2503762577210822052_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qCscRKuDLIQ7kNvwGIPWYG&_nc_oc=Adocj17Oht9ZRqa0UT1Ttvw4SRdkzWeq4yPG_LRu4cDv8nYvJHvM9EUbDPMBDsyGnGw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4767ruCKgjG-YGe2MqaoZa3SqASiu-Kyq4uKI_jYRgQ&oe=6AFF237B"}, {"file_name": "IMG_20250407_175210.png", "id": "1710344276545084", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391739_1710344279878417_6392433131893774073_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hmqQjT7rDoQ7kNvwGI2WfW&_nc_oc=Adpc-xJjiDET9O4rbVBNWIUpUvW78AG5e5o5NVP9Obv85wP89_NgG3tzzfs5WTLNa5Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFYbqEJU-vspFLUcZvbkH0Rc3N7yZ5IbAd6HCdDmrt6Q&oe=6AFF31F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "478899077676648", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974713_478899084343314_368915632794476489_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mc0R1BV0gaEQ7kNvwGH695b&_nc_oc=Adp3gLwG1pLHzG9Uo-7kOG978rhhCDlxAJCZarYbmpAEXZF4GnRW-6RYQPH6xnKUe4o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6VBrLNg1DfAZyzSahYmdPp0hKmor2x6F-NDsi-9QiFA&oe=6AFF20F5"}, "display_name": "VRIT", "keywords": ["fitness", "crossfit", "workout", "body", "fit"], "long_description": "**VRIT** is a VR fitness game made possible by the Quest's hand-tracking feature to let you do true exercises without controllers.  \nDestroy robots and earn rewards while doing your daily workout : **VRIT makes fitness fun.**\n\n# Full body exercises\n{539814865827589}\nDo actual abs, push-ups, burpees and a lot more without having to care about controllers!  \nVRIT can accurately follow your movements using only your head's position.\n\n# Do your daily workout in the ADVENTURE MODE\n{3044080589099219}\nThe robots are trying to steal all your water! Fight them **with your muscles**, alternating between shooting phases and various exercices.  \nThe difficulty of the challenges you face **will adapt to you** over time.  \nGet additional rewards by playing regularly and by being phenomenal!\n\n# CUSTOM PROGRAMS\nCreate your own workout programs and save them for later.\n\n# MUCH, MUCH MORE\nShoot robots using your hands while running in the **RUN** phases!  \nEarn **cosmetics** for your tiny island such as new materials and special props!  \nCompete with your friends in the **leaderboards**!  \nVRIT is more than a simple workout app.  \n\n# It's time for your daily dose of action-packed sport.\n{606607422353949}", "short_description": "Add some action-packed sport to your daily routine with VRIT !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wasplay.fr/vrit-privacy", "developer_terms_of_service_url": null, "publisher_name": "Wasplay", "support_website_url": "https://wasplay.fr/", "website_url": "https://wasplay.fr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"
g", "id": "639967009014526", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391845_639967012347859_8696163035317677617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4-C9131t2UQ7kNvwGXr4fP&_nc_oc=AdooOlXQIeDv3Fo0nM44O1XX9mxaw8PP3k1eWMAsUoGMePGfk-7zYFG7r6Si67kxwYw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_zatybvSMRFBSPCJ9-zHMVmPnumZ0JL-x4huOJPoJRw&oe=6A8EDE52"}, {"file_name": "IMG_20250407_175123.png", "id": "1180194287180680", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391814_1180194290514013_2503762577210822052_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69xIFe7juF0Q7kNvwEhsAEA&_nc_oc=AdprANUgghh2371v_00BIBChd8nHuoOoQ1VBAYpMJ6uLkPrRky6887I5bKtDpFTn-DM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMxpHUq6jMrcOxQxq__QZ9cRfxUaOOs6zedHwQrXft0A&oe=6A8EDBBB"}, {"file_name": "IMG_20250407_175210.png", "id": "1710344276545084", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391739_1710344279878417_6392433131893774073_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7wgBFPkkVwQ7kNvwF-Ux1t&_nc_oc=Adr2sx72-WSa4Vr4QEtWlckISd34SgVrpXbBBGF4tzDTvFGuOuWzB-SbRq7ivT0Ib28&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJFXSGFPDQ_NSIF1jJ_-hBHpdq9aptohHNKr0gmObADA&oe=6A8EEA38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "478899077676648", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974713_478899084343314_368915632794476489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfjSmbtRdfQQ7kNvwH9ZNhx&_nc_oc=Adqjc1YyIMaMPmGLZ65Obf_zeVlbRKa005XKZF-5RLRrze56SfRHqdeWtr_YJ9xS3Hk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXZNBX-OmofxE8VDyjr7cb3sR77-hiHSnbkw3NzPH4SQ&oe=6A8ED935"}, "display_name": "VRIT", "keywords": ["fitness", "crossfit", "workout", "body", "fit"], "long_description": "**VRIT** is a VR fitness game made possible by the Quest's hand-tracking feature to let you do true exercises without controllers.  \nDestroy robots and earn rewards while doing your daily workout : **VRIT makes fitness fun.**\n\n# Full body exercises\n{539814865827589}\nDo actual abs, push-ups, burpees and a lot more without having to care about controllers!  \nVRIT can accurately follow your movements using only your head's position.\n\n# Do your daily workout in the ADVENTURE MODE\n{3044080589099219}\nThe robots are trying to steal all your water! Fight them **with your muscles**, alternating between shooting phases and various exercices.  \nThe difficulty of the challenges you face **will adapt to you** over time.  \nGet additional rewards by playing regularly and by being phenomenal!\n\n# CUSTOM PROGRAMS\nCreate your own workout programs and save them for later.\n\n# MUCH, MUCH MORE\nShoot robots using your hands while running in the **RUN** phases!  \nEarn **cosmetics** for your tiny island such as new materials and special props!  \nCompete with your friends in the **leaderboards**!  \nVRIT is more than a simple workout app.  \n\n# It's time for your daily dose of action-packed sport.\n{606607422353949}", "short_description": "Add some action-packed sport to your daily routine with VRIT !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wasplay.fr/vrit-privacy", "developer_terms_of_service_url": null, "publisher_name": "Wasplay", "support_website_url": "https://wasplay.fr/", "website_url": "https://wasplay.fr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "ACTION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_de
87g6yVXvhWG31iihlMmJQg_i68aSNu3KDbPGH4IBz0KSewy1Z7YP8A2-s3FDJQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS7_OpBdcfi639wW80eqI4coA3sZ3o98cERaKgxDaU6PQ&oe=6B0C5558"}, {"file_name": "IMG_20250407_175106.png", "id": "639967009014526", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391845_639967012347859_8696163035317677617_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXTQbb_Pz_kQ7kNvwG4dVX5&_nc_oc=AdpHGtWYdHOPuGzFfQLPkVAIB3UVkimUBTjiYnPRw0HZ0RWVIJzQLnbKTTv6b6PYG1g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQWA85JB4mhWKrCCUe7uDy4qPXyEpoo33x4TgbyCtKGHA&oe=6B0C5512"}, {"file_name": "IMG_20250407_175123.png", "id": "1180194287180680", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391814_1180194290514013_2503762577210822052_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Et1RiZhEYAoQ7kNvwHSY-NY&_nc_oc=AdqQ7UIzYiiVnZbVtOMQ1-epjKRALnHL41Sr3QFqT6FRnAri51bKi9JW75QKHTvayMI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRz-96JL2tcHJbsNzu2INOSCANDjMIb9bsxbngj325iXA&oe=6B0C527B"}, {"file_name": "IMG_20250407_175210.png", "id": "1710344276545084", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391739_1710344279878417_6392433131893774073_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpiXUJhWdhIQ7kNvwEToQF7&_nc_oc=AdrsZJvq9pP4p4Gz56iLlwa5LJByUtV6AOqsQYc_w5nuzWGJxtJJ75N8beiS8JnOwUY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRVKUBX7JJ1iqnC3usz2Iv2FYY3QS9q1-QoP-yvIfGdUg&oe=6B0C60F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "478899077676648", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974713_478899084343314_368915632794476489_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQdx6IpfsmcQ7kNvwH3nrWB&_nc_oc=Adq6zip7gbMZH23vfkjxeDt5qAKACkHxxPgqZ5IciLF1HW-ReYFflitm6ElkM997Ecg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTVs04o1s2SQ6YOs5PlFnF4zNoRm0kDBAXNGlqH_vKZQw&oe=6B0C4FF5"}, "display_name": "VRIT", "keywords": ["fitness", "crossfit", "workout", "body", "fit"], "long_description": "**VRIT** is a VR fitness game made possible by the Quest's hand-tracking feature to let you do true exercises without controllers.  \nDestroy robots and earn rewards while doing your daily workout : **VRIT makes fitness fun.**\n\n# Full body exercises\n{539814865827589}\nDo actual abs, push-ups, burpees and a lot more without having to care about controllers!  \nVRIT can accurately follow your movements using only your head's position.\n\n# Do your daily workout in the ADVENTURE MODE\n{3044080589099219}\nThe robots are trying to steal all your water! Fight them **with your muscles**, alternating between shooting phases and various exercices.  \nThe difficulty of the challenges you face **will adapt to you** over time.  \nGet additional rewards by playing regularly and by being phenomenal!\n\n# CUSTOM PROGRAMS\nCreate your own workout programs and save them for later.\n\n# MUCH, MUCH MORE\nShoot robots using your hands while running in the **RUN** phases!  \nEarn **cosmetics** for your tiny island such as new materials and special props!  \nCompete with your friends in the **leaderboards**!  \nVRIT is more than a simple workout app.  \n\n# It's time for your daily dose of action-packed sport.\n{606607422353949}", "short_description": "Add some action-packed sport to your daily routine with VRIT !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wasplay.fr/vrit-privacy", "developer_terms_of_service_url": null, "publisher_name": "Wasplay", "support_website_url": "https://wasplay.fr/", "website_url": "https://wasplay.fr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"
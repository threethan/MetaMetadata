dn.com&_nc_ss=7f20f&oh=00_AQJuFJQKNle59F3sZ8LBv34NVyOnuGCRL4raLqnvM8nTxw&oe=6AA41D37"}, {"file_name": "screen4.png", "id": "466363667720049", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/86615896_466363671053382_6610687836148419085_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gme6Iiic-OYQ7kNvwEdXmNt&_nc_oc=Adp1O2jvb4lfv_xxknFPVis-5F8q61sdemT8ziVmvsIA9aiBEIivPwRNCkWlXIXsOJE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSTNnoficHCfOMrGu5oJmdCxDsZqf348D2PdVfBxILYQ&oe=6AA3F434"}, {"file_name": "screen5.png", "id": "470612930777862", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982695_470612937444528_6361968081224546736_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozLF92vs2e0Q7kNvwGrb3LZ&_nc_oc=Adqq2IbYOFMjc-WRSVrexIO8CAdP5K34WbhAq1_qSayqVXkosOhfffGIR0APqdopXmY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIA5HFJ6UPi5SW7V4HDQNLjzGlikgJyMea0clDKt7Y6Uw&oe=6AA3FC61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2021-02-28-17h16m00s899.png", "id": "257983042491003", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982586_257983045824336_6411080150472187017_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ooJ8AR4tZWwQ7kNvwEc6WCB&_nc_oc=Adq4h6ESgU5GHhuYJhplEHKHz9b_3kCXOMF7J-xZFxPOp47717u-crh83_NMJgbzve4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQJ2IqIlOKaKCNdJFeoYDsN1HbkGtZeleaJpXDmBBqNg&oe=6AA3F28E"}, "display_name": "VRIT", "keywords": [], "long_description": "It's time for your daily dose of sport.\nVRIT is a VR fitness game made possible by the power of hand-tracking to let you do your exercices without those annoying controllers.\n\nSome annoying robots are stealing your precious clouds, but you won't let them.\nRun (while shooting some robots), do push-ups, abs, squats.. and more to come !\nShow them your muscles and destroy them.\nVRIT turns sport into a fun and action-packed session.", "short_description": "Add some explosive sport to your daily routine with VRIT !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pastebin.com/raw/kerViG0K", "developer_terms_of_service_url": null, "publisher_name": "Wasplay", "support_website_url": null, "website_url": "https://discord.gg/y3thsPB", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "ACTION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1013084952887071"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8638869799464805", "version": "2.3b"}, "id": "710309429649470", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3894534127231753", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8638869799464805"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "710309429649470"}]}, "change_log": "# VRIT 2.3 :\n- Improved support for the Quest 3 and Quest Pro\n- Heavily improved the graphics quality on all platforms\n- Improved many animations throughout the game and added new ones", "created_date": 1726698906, "id": "8638869799464805", "version": "2.3b", "version_code": 38, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3894534127231753", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8638869799464805"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "710309429649470"}]}, "change_log": "# VRIT 2.3 :\n- Improved support for the Quest 3 and Quest Pro\n- Heavily improved the graphics quality on all platforms\n- Improved many animations throughout the game and added new ones", "created_date": 1725273991, "id": "8514807265204393", "version": "2.3", "version_code": 37, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3894534127231753", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8638869799464805"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "710309429649470"}]}, "change_log": "Update v2.2 is now available for VRIT ! \ud83d\udcaa\n\nHere are the patch notes :\n\n- The game now targets 90fps instead of 80fps and uses Vulkan for rendering instead of OpenGLES3\n- There are now bubbles that will appear at regular intervals in SpeedRUN mode (in a predictable and fair manner, of course). Popping them will deduct 2 seconds from your time. \u23f1\ufe0f\n- Improved the bullets charging mechanic during Run phases. Your hands now get all shiny when fully charged ! \u2728\n- You can now destroy the \"big bad bullets\" from those big robots by shooting 10 bullets at them.\n- The exercise instructions will appear slowly only when you come across them for the first time.", "created_date": 1689963607, "id": "6731341180217686", "version": "2.2", "version_code": 36, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3894534127231753", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8638869799464805"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "710309429649470"}]}, "change_log": null, "created_date": 1689953983, "id": "6730920406926430", "version": "2.2", "version_code": 35, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3894534127231753", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8638869799464805"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "710309429649470"}]}, "change_log": "Update 2.1 is now available for VRIT \ud83d\udcaa\nHere are the patch notes :\n\n- Added a warning on the startup screen if hand tracking is disabled\n- Improved the slider buttons\n- Improved the Crossbody Toe Touch animation during warmup\n- Reworked the \"shoot\" animation in the Run rules\n- Added a mention of the \"hand closed\" gesture in the Run rules\n- Improved the stretching music mix", "created_date": 1681399991, "id": "6384735771544897", "version": "2.1", "version_code": 34, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
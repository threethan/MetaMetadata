W9Ye8uESekKaxTPN9hm0rtWI9KWwTC3yMmjRfTGAXEbj7gBiBvnQj03E5tgHI0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSX1XQ2yDFNssA5AxWSl4ap9IRgNNJSGb00YxgodOVZQw&oe=6AFB31D8"}, {"file_name": "IMG_20250407_175106.png", "id": "639967009014526", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391845_639967012347859_8696163035317677617_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wK2c0KABlQ4Q7kNvwFrmAYF&_nc_oc=AdqispAsI0HgmlSaW8bEiXtkNq7GOUHrdzMWcyAjU-AuSqnZrUDjid9A179l8zzhxO8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeOqIsuK-yD2mITpkbK8NPGmg07p6g1OF9prdgLPjxng&oe=6AFB3192"}, {"file_name": "IMG_20250407_175123.png", "id": "1180194287180680", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391814_1180194290514013_2503762577210822052_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFslPFNj0sYQ7kNvwGvMAJK&_nc_oc=AdpkllxOtWSY1iiPtALRcWx56G4-96FeZqbYBNKw-cqd1XtJkVe_Ay8mjgiGKAHNjJc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR69uv5XV0gEEQy71K0sU3eUhrmE8mz-dlsPWbay44ZYQ&oe=6AFB2EFB"}, {"file_name": "IMG_20250407_175210.png", "id": "1710344276545084", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391739_1710344279878417_6392433131893774073_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDChGz7UzigQ7kNvwGXzwMd&_nc_oc=AdrW1pcu0vbJqGB7qByaSYV3fWKel-FvtrufjCSSmsmFEZ1lrjj5Z-H4mGlYscj57S4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtV-_oqjfKpBO4yBPA2AR8KI6sW4BaH8RNXzzz3eJFcw&oe=6AFB3D78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "478899077676648", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974713_478899084343314_368915632794476489_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzquh1zjVPkQ7kNvwG5HzvM&_nc_oc=AdrZ7TG8KiWDpZ38FBX20xqSbuTHET9a_0ujrImNRJalqkcX7bWVQEc0Q_QhdMMw82M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2ZC3RBQNoS3QF6VhUXmcAXikqXT5-QpqbxqhmR61CYA&oe=6AFB2C75"}, "display_name": "VRIT", "keywords": ["fitness", "crossfit", "workout", "body", "fit"], "long_description": "**VRIT** is a VR fitness game made possible by the Quest's hand-tracking feature to let you do true exercises without controllers.  \nDestroy robots and earn rewards while doing your daily workout : **VRIT makes fitness fun.**\n\n# Full body exercises\n{539814865827589}\nDo actual abs, push-ups, burpees and a lot more without having to care about controllers!  \nVRIT can accurately follow your movements using only your head's position.\n\n# Do your daily workout in the ADVENTURE MODE\n{3044080589099219}\nThe robots are trying to steal all your water! Fight them **with your muscles**, alternating between shooting phases and various exercices.  \nThe difficulty of the challenges you face **will adapt to you** over time.  \nGet additional rewards by playing regularly and by being phenomenal!\n\n# CUSTOM PROGRAMS\nCreate your own workout programs and save them for later.\n\n# MUCH, MUCH MORE\nShoot robots using your hands while running in the **RUN** phases!  \nEarn **cosmetics** for your tiny island such as new materials and special props!  \nCompete with your friends in the **leaderboards**!  \nVRIT is more than a simple workout app.  \n\n# It's time for your daily dose of action-packed sport.\n{606607422353949}", "short_description": "Add some action-packed sport to your daily routine with VRIT !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wasplay.fr/vrit-privacy", "developer_terms_of_service_url": null, "publisher_name": "Wasplay", "support_website_url": "https://wasplay.fr/", "website_url": "https://wasplay.fr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"
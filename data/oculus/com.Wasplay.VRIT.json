GrKWc01lUgoo6a_HbUIAnnMYvtmkzr3W4UwjQ8rYJzd1UqODcODhDv3l1GgLIs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKh8mUeCnYD-W3BpKKmQ3JPIbBhhaet2_TX02xX38V7A&oe=6B0860D8"}, {"file_name": "IMG_20250407_175106.png", "id": "639967009014526", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391845_639967012347859_8696163035317677617_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DI8dTQM7rwQ7kNvwGaXsxu&_nc_oc=Adq7rjkaMThcUkBJExqZ_0OpVKxYDeGaxd2rDN8kVhGgKq1mZ16ksaiP1pR2V4R3ApI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq_YI78hr5sNOXDvDoUoPsu0U0R0ebRwQ0erhboGYifw&oe=6B086092"}, {"file_name": "IMG_20250407_175123.png", "id": "1180194287180680", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391814_1180194290514013_2503762577210822052_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xA1rjCLQzccQ7kNvwH5hNXS&_nc_oc=Adr5B1YUvTmZn3M02J1j5YoRzlRDaAPQJIi7K3phwWzw79cEDCL49eRjGDihhcNXlSo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDjr_1TJ4_Iy_CQoItMKvnJfF3egDmqOKhymJhRaPANQ&oe=6B085DFB"}, {"file_name": "IMG_20250407_175210.png", "id": "1710344276545084", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391739_1710344279878417_6392433131893774073_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2ehbvggO6wQ7kNvwEWRiiI&_nc_oc=AdpemlB2Fi9RZUeFAlDfUAgHRo_uEfer_0CN5eU-z4VilUngzUxQj-LzdoeSHx5eHLE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4EoZ-KA4B5zJrjbDcz5TI-Lpw8qIdVws9t1JZJQTrkA&oe=6B086C78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "478899077676648", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974713_478899084343314_368915632794476489_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdRM4sc_CFMQ7kNvwE6E49D&_nc_oc=AdrvXjR4H0qz2Ds3XJi4xLZmzxHHucxbmq_5GnvcL_zCxWEAXFknUpAZWFZDwiWY6Vo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqTH-Qn7v8orPxnimcAapZ-DM2VMYsLddiNV_E3NOeMg&oe=6B085B75"}, "display_name": "VRIT", "keywords": ["fitness", "crossfit", "workout", "body", "fit"], "long_description": "**VRIT** is a VR fitness game made possible by the Quest's hand-tracking feature to let you do true exercises without controllers.  \nDestroy robots and earn rewards while doing your daily workout : **VRIT makes fitness fun.**\n\n# Full body exercises\n{539814865827589}\nDo actual abs, push-ups, burpees and a lot more without having to care about controllers!  \nVRIT can accurately follow your movements using only your head's position.\n\n# Do your daily workout in the ADVENTURE MODE\n{3044080589099219}\nThe robots are trying to steal all your water! Fight them **with your muscles**, alternating between shooting phases and various exercices.  \nThe difficulty of the challenges you face **will adapt to you** over time.  \nGet additional rewards by playing regularly and by being phenomenal!\n\n# CUSTOM PROGRAMS\nCreate your own workout programs and save them for later.\n\n# MUCH, MUCH MORE\nShoot robots using your hands while running in the **RUN** phases!  \nEarn **cosmetics** for your tiny island such as new materials and special props!  \nCompete with your friends in the **leaderboards**!  \nVRIT is more than a simple workout app.  \n\n# It's time for your daily dose of action-packed sport.\n{606607422353949}", "short_description": "Add some action-packed sport to your daily routine with VRIT !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wasplay.fr/vrit-privacy", "developer_terms_of_service_url": null, "publisher_name": "Wasplay", "support_website_url": "https://wasplay.fr/", "website_url": "https://wasplay.fr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"
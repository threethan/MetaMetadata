yOtkZdleEk9kTUfdAeH-OG_pgjaH0azEnvx_-UG12lfQpgSDgssaSG4dWbForo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoqlQoJG8mgv5xZVZLDGVG14JrnIFqgqRkIWgw4D1sJw&oe=6B031AD8"}, {"file_name": "IMG_20250407_175106.png", "id": "639967009014526", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391845_639967012347859_8696163035317677617_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdrUNgATcVQQ7kNvwEq58ft&_nc_oc=Ado4jalxyWyoh7Wx6PBdPIVERi7HaPq3NwVxXkUO_YwTFTEqXQMxrmfwnGugMtPHraM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLxvKmb3fUaTu3uOFrBnNPDQPB4CJYczXScmjOt-EF2w&oe=6B031A92"}, {"file_name": "IMG_20250407_175123.png", "id": "1180194287180680", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391814_1180194290514013_2503762577210822052_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6h8OKZwyhwQ7kNvwEiE90V&_nc_oc=Adq7Nt8gROp0PoDG1xleEL1x7qXzQ9sfQKHGLbh_qCOtLqspnvSua6IoM_Gg1eiMS2Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMUwfZe-2cs7bv6p_v93WS5toWk53vn0UK95GsBpi_0A&oe=6B0317FB"}, {"file_name": "IMG_20250407_175210.png", "id": "1710344276545084", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391739_1710344279878417_6392433131893774073_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEeZqNvgScwQ7kNvwGErPNg&_nc_oc=AdpSfdWEkU-B3pyhCDmpBKllSWMK1pWSRkyRdrH2YVtR33P1w1UyBfj-TqgKSMrpIz8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsPstqQt820rL53451QyUZKZvQLtKlxMUGem1cGRXpsw&oe=6B032678"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "478899077676648", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974713_478899084343314_368915632794476489_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqjbYCvxuB0Q7kNvwE1ssgs&_nc_oc=Adpa0ZOrXFEycifhjx9zG1ExOyNSRXq_n7d9SJMbmWzCBhMtCJCgJu-3Zu9ujYW3YNE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKagJ_vpU8DS8jn39nE8nQw5bmmLmZTAoXpGicx6tRKg&oe=6B031575"}, "display_name": "VRIT", "keywords": ["fitness", "crossfit", "workout", "body", "fit"], "long_description": "**VRIT** is a VR fitness game made possible by the Quest's hand-tracking feature to let you do true exercises without controllers.  \nDestroy robots and earn rewards while doing your daily workout : **VRIT makes fitness fun.**\n\n# Full body exercises\n{539814865827589}\nDo actual abs, push-ups, burpees and a lot more without having to care about controllers!  \nVRIT can accurately follow your movements using only your head's position.\n\n# Do your daily workout in the ADVENTURE MODE\n{3044080589099219}\nThe robots are trying to steal all your water! Fight them **with your muscles**, alternating between shooting phases and various exercices.  \nThe difficulty of the challenges you face **will adapt to you** over time.  \nGet additional rewards by playing regularly and by being phenomenal!\n\n# CUSTOM PROGRAMS\nCreate your own workout programs and save them for later.\n\n# MUCH, MUCH MORE\nShoot robots using your hands while running in the **RUN** phases!  \nEarn **cosmetics** for your tiny island such as new materials and special props!  \nCompete with your friends in the **leaderboards**!  \nVRIT is more than a simple workout app.  \n\n# It's time for your daily dose of action-packed sport.\n{606607422353949}", "short_description": "Add some action-packed sport to your daily routine with VRIT !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wasplay.fr/vrit-privacy", "developer_terms_of_service_url": null, "publisher_name": "Wasplay", "support_website_url": "https://wasplay.fr/", "website_url": "https://wasplay.fr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"
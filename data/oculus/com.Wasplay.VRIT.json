XV23Ej_EYwPEDTcP376NEw3bkrZ61o-qElB0gmAcr3c9QMgG4mJ3MHerGDDxuU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZS6bwx9RRq30Gq8I4EDb-TipJn6YvhdWp4Kq4KdDxcw&oe=6B0077D8"}, {"file_name": "IMG_20250407_175106.png", "id": "639967009014526", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391845_639967012347859_8696163035317677617_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sv2mBCroDlYQ7kNvwESIRKX&_nc_oc=AdpCq_XEs6UVa9L6t-l_UjwU9KL4Zk1wMZQlrrFgHrNzPX5WXFwWmaZ5HlzQd0A9XGQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRItJGERM26ihJofZuTsgqCRihnST2jdR5z4htxMIAUUA&oe=6B007792"}, {"file_name": "IMG_20250407_175123.png", "id": "1180194287180680", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391814_1180194290514013_2503762577210822052_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qCscRKuDLIQ7kNvwGuHPJq&_nc_oc=AdpTWSNbzkxLc8fJnW6rJGdNYzd4CqFPD-1asZ8b7eULSPCA9bicdyTm7Vn8Nr_RYM8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1qr8aKoAW9BOCUWfmRb6MXVc9B5alqUbakYRqeRGTMg&oe=6B0074FB"}, {"file_name": "IMG_20250407_175210.png", "id": "1710344276545084", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391739_1710344279878417_6392433131893774073_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hmqQjT7rDoQ7kNvwFHsUgI&_nc_oc=AdrB41LjG-Kn2icTjoxF_0dsyKCe3dcsMdOUkon39etrNLL_1T0R2l1rw0NARQHYGPY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSg64xqoi3xkiqWeEZZPUXokFk1OnnqCGsFAVyxhk6PTA&oe=6B008378"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "478899077676648", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974713_478899084343314_368915632794476489_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqjbYCvxuB0Q7kNvwH7r1xZ&_nc_oc=AdroSMn_EuXd5QFFVlExTBSVSC5NLiLmjpBgIbL-zWzn8D2hYDKvTqhFv4LGskUsBz8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXVhpq8DmEJzyE5swz2Z_g5_woCQ7KQLib0b4wqhEzaQ&oe=6B007275"}, "display_name": "VRIT", "keywords": ["fitness", "crossfit", "workout", "body", "fit"], "long_description": "**VRIT** is a VR fitness game made possible by the Quest's hand-tracking feature to let you do true exercises without controllers.  \nDestroy robots and earn rewards while doing your daily workout : **VRIT makes fitness fun.**\n\n# Full body exercises\n{539814865827589}\nDo actual abs, push-ups, burpees and a lot more without having to care about controllers!  \nVRIT can accurately follow your movements using only your head's position.\n\n# Do your daily workout in the ADVENTURE MODE\n{3044080589099219}\nThe robots are trying to steal all your water! Fight them **with your muscles**, alternating between shooting phases and various exercices.  \nThe difficulty of the challenges you face **will adapt to you** over time.  \nGet additional rewards by playing regularly and by being phenomenal!\n\n# CUSTOM PROGRAMS\nCreate your own workout programs and save them for later.\n\n# MUCH, MUCH MORE\nShoot robots using your hands while running in the **RUN** phases!  \nEarn **cosmetics** for your tiny island such as new materials and special props!  \nCompete with your friends in the **leaderboards**!  \nVRIT is more than a simple workout app.  \n\n# It's time for your daily dose of action-packed sport.\n{606607422353949}", "short_description": "Add some action-packed sport to your daily routine with VRIT !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wasplay.fr/vrit-privacy", "developer_terms_of_service_url": null, "publisher_name": "Wasplay", "support_website_url": "https://wasplay.fr/", "website_url": "https://wasplay.fr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"
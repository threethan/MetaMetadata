427588560218368"}, "id": "36772653319045142", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "28427588560218368", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2098693030237002"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "appIcon.png", "id": "660053106699621", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391911_660053110032954_2417176414817328799_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBtqtc24R0AQ7kNvwETVK5N&_nc_oc=Ado6X5i3cX2IkQtokZ_IYg993vEPEcVIwSHoCJkxFsYds83IQyGHE4TpmRaIMbzExhg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbz0KTHHZqc-8dOadeyENyIbxYS0HouHrHX4W73bx9MA&oe=6ACCFBA3"}]}, "id": "27509670172020598", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CultVRe \u2013 La cultura como nunca antes", "keywords": ["experiencia", "viajes", "turismo", "arte", "cultura"], "long_description": "Explora el mundo sin salir de casa. **CultVRe** es tu portal de realidad virtual para sumergirte en lo mejor de la cultura global: museos emblem\u00e1ticos, destinos fascinantes, conciertos inolvidables, teatro envolvente, documentales impactantes y experiencias educativas \u00fanicas.\n\nDesarrollada por **YBVR**, los creadores de Xtadium, esta app lleva el streaming inmersivo al siguiente nivel con los formatos m\u00e1s innovadores y la tecnolog\u00eda XR m\u00e1s avanzada. Desde joyas ocultas hasta maravillas ic\u00f3nicas, **CultVRe** te transporta a los rincones m\u00e1s inspiradores del planeta, todo en primera fila y en 360\u00b0.\n\n**\ud83c\udfad Arte, historia, m\u00fasica, conocimiento. Todo en VR.**\n\n**\ud83d\udccd Viaja, aprende y siente sin moverte del sof\u00e1.**\n\n**\ud83d\ude80 La cultura cobra vida. Y t\u00fa est\u00e1s en el centro.**", "short_description": "CultVRe es un portal de VR dedicado al contenido cultural:  Museos, Viajes, Educaci\u00f3n, M\u00fasica, Teatro, Documentales... Con video inmersivo en streaming, incluyendo los formatos m\u00e1s novedosos y las \u00faltimas opciones tecnol\u00f3gicas. Transporta a lugares m\u00e1s ic\u00f3nicos, joyas ocultas y maravillas culturales por medio de la realidad virtual inmersiva. "}, {"images": {"nodes": [{"file_name": "CoverImage-CulTVre-Landscape.png", "id": "1551669965653428", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391813_1551669972320094_51068120528629344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wb5fnFK0-vMQ7kNvwEy3qXc&_nc_oc=AdqKYZ5j8uHp_1KCaMa-4eIpkxrwAROIiZSRyDt5wfr5muELvos7Ddpc0Le3LZaa1CU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGboeXew-E9ZQinxs0zhmMUe9B6c8uKGFepwpryzBc4g&oe=6ACD1883"}, {"file_name": "CoverImage-CultVRe-Hero.png", "id": "1352330775791362", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391728_1352330785791361_6827268451084350092_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rnVYR9z5e8Q7kNvwFLphZI&_nc_oc=Adp0wnHyVRsU8V8ibfuJLETxhtTdNaAp94oQGhdyW6DeRf9Yr03-mxhn4QXJ0TJrjoY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpvWjwfpULhAOTI-Bo6Wi80efB73TtccsfU6uvq7Wmow&oe=6ACCEAE6"}, {"file_name": "appIcon.png", "id": "1308205033727292", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391934_1308205043727291_8664609955644883123_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hzc_1EPvYGkQ7kNvwH9Yiw0&_nc_oc=AdpLzBEJWNcEsnwAkkFj0Xy5WyyheD_1bA5qynMBPOWw64_eUB2Oawe8Oy1nREpzdJ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzIWHkQTmrk9JJbgWcCirc
6ACCE0A4"}, {"file_name": "CultVRe_menu.png", "id": "1073290831292060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820441_1073290834625393_4196116842600662382_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THF1NrvwOwwQ7kNvwFfYM9a&_nc_oc=AdoL8PaqTQE0dKyMy88QmUgZ9TEhHC3UWUZxTMqAh9Os-vLwU3TeOev1pTM7AswX6K0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQND6i9ha-MxJdVMXbziwa2yP14AXtrIg8tB3TkvKoSmVg&oe=6ACD0A3B"}, {"file_name": "Screenshot_Immersive.png", "id": "1328796638312968", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391797_1328796641646301_8222480086251085142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1hjJfwW-EsQ7kNvwEasvkq&_nc_oc=AdoHRNGZIrBHY7U40wBucBhYF7TWuLERKjOGmhap9_yhORtQOwAlF7V63TQyh1oZajQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0XkI0s_gH4t8df4RPgvBrTWAM2McCb1tSqHsm_kVIag&oe=6ACCF922"}, {"file_name": "Screenshot_vod.png", "id": "1263248851441615", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393113_1263248854774948_906403982621620836_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwBpOKpWTtcQ7kNvwHdVKkG&_nc_oc=Adqp0VUta3C_BKvbuYNXeKdz1iz7wRtezqrqmiYvtAm2khQQQPoc1uXfSemzgOjHiTg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOePxl3Y4MgNExVNggNnQ_47R5PeWzIq9YLPnD8c1paJQ&oe=6ACD0B09"}, {"file_name": "CultVRe_environment.png", "id": "1122252163343257", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824292_1122252166676590_1423218167267947777_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_XcTrjuthsQ7kNvwF6n3YV&_nc_oc=AdqE4kYTFJ84rlxSgGs27MbDz15f5qmiQmXJqERPlvfmepTfGPbvYY1cARNcmhe74GU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMZcpfcRg5FxhpS7MFSOo9H_dLb7K7wpd_iORFoEU2kQ&oe=6ACD06F4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CultVRe \u2013 Culture Comes Alive in VR", "keywords": ["experience", "music", "tourism", "art", "culture"], "long_description": "Step into the world\u2019s most inspiring places without leaving your home. **CultVRe** is your immersive gateway to global culture: iconic museums, breathtaking destinations, unforgettable concerts, powerful documentaries, live theater, and educational experiences \u2014 all in stunning virtual reality.\n\nDeveloped by **YBVR**, the creators of Xtadium, **CultVRe** brings cutting-edge immersive streaming to cultural content. Explore hidden gems and world-famous landmarks, dive into artistic performances, and experience knowledge like never before \u2014 all from the heart of VR.\n\n\ud83c\udfad **Art, music, history, travel, education \u2014 reimagined in immersive reality**\n\n**\ud83d\udccd Go further. Feel deeper. Learn differently.**\n\n**\ud83d\ude80 The culture of the world, now just one headset away.**", "short_description": "CultVRe is the first VR app dedicated to video streaming content focused on travel, culture, and tourism. Explore the world\u2019s most iconic landmarks, hidden gems, and cultural wonders in immersive virtual reality. With CultVRe, you can experience unforgettable destinations and fascinating cultures like never before, all from the comfort of your home. Perfect for adventure seekers, culture enthusiasts, and virtual travelers!\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ybvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yerba Buena VR, Inc.", "support_website_url": null, "website_url": "http://www.ybvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processo
Snapshot_20261016_144300_531.png", "id": "1780189876602072", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314351_1780189879935405_379784977290242197_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b34ACIN7bmkQ7kNvwEOplBF&_nc_oc=Adode_j1PPl5NSpz_SwxlcksTmSsF1qEjCHH2Bo74XR674iOg4_7ZfgibVErzjMVERU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgPTgx4vRlCO-3wos6swHXe4gGsaMqpPizayZ63cA8fQ&oe=6AF0887F"}, {"file_name": "Snapshot_20261016_121028_677.png", "id": "1443174884635465", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312422_1443174887968798_3392594532358945868_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8w2hAELOZyIQ7kNvwFM-SKI&_nc_oc=Adoewuo5UMmyqFh8s3hDOzo0NSvMrOmQgOVILDWozAv8tGfkgwC4H5QK_-_WbFsHELY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR44ddthIh4V7E7-UXG8j81xXurM8yvuAGb6XpAyjL8Zg&oe=6AF0836B"}, {"file_name": "Snapshot_20261016_114625_754.png", "id": "1095316323340450", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303445_1095316326673783_9011310926945349912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPmFv60ziawQ7kNvwFiV-SP&_nc_oc=AdoEa-ay9XbjplsgpFr-6jnW2bM-3ly5WdUdxNxpCWV4JgGsqVmjHkr23GV3VxG--X8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiZyg0v0pKUBE0KP4uH4CowI-x9wcxbvLsMhu9sHVfxw&oe=6AF080DA"}, {"file_name": "Snapshot_20261016_114756_555.png", "id": "28587786674235485", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303471_28587786687568817_8596811332712058107_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qs6GyoPXu48Q7kNvwH3obMd&_nc_oc=AdoJrWaFkrdccZIIAfy79KSIJ1iDVbq-dqBorydBMMARqhKHCRgCFrixl9uAS38cSm4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrGTFcW7EEkyFRGF36PPlFpoPQfB4K090Hn7FH18K3Jw&oe=6AF0AE24"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CultVRe \u2013 Culture Comes Alive in VR", "keywords": ["experience", "music", "tourism", "art", "culture"], "long_description": "**Culture is more than something you watch. It's something you experience.**\n\nWelcome to CultVRe, where immersive technology brings you closer to the art, performances, places, and stories that inspire us.\n\nExperience the beauty of dance, the energy of music and theatre, the richness of art and heritage, and the wonder of remarkable destinations. Through immersive VR, CultVRe takes you beyond the traditional screen, offering new perspectives and a deeper connection to culture.\n\nExplore a curated collection of immersive experiences that bring creativity, history, and storytelling to life, wherever you are.\n\nFree to download and explore. Enjoy a selection of free content, with select premium experiences available through one-time in-app purchases.", "short_description": "CultVRe brings culture to life through immersive VR. Step inside extraordinary performances, discover art, music, film, and explore remarkable places from a new perspective. Free to download and explore, with select premium experiences available through one-time in-app purchases."}, {"images": {"nodes": [{"file_name": "appIcon.png", "id": "660053106699621", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391911_660053110032954_2417176414817328799_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7kjeFDO4DUQ7kNvwFRoY-e&_nc_oc=AdqoH1xwgiS7jG3fVLr2nDtQ2Y-bC3DWieBRNrH5gTaHAalmyLPs1BpLtJ7d76C4ftI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoHq6d8Xgdhq0ModFcZ5E-xIaQO4-bwzoPTlk1udc4Rg&oe=6AF09423"}]}, "id": "1028087973421144", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CultVRe \u2013 La cultura como nunca antes", "keywords": ["experiencia", "viajes", "turismo", "arte", "cultura"], "long_description": "Explora el mundo sin salir de casa. **CultVRe** es tu portal de realidad virtual para sumergirte en lo mejor de la cultura global: museos emblem\u00e1ticos, destinos fascinantes, conciertos inolvidables, teatro envolvente, documentales impactantes y experiencias educativas \u00fanicas.\n\nDesarrollada por **YBVR**, los creadores de Xtadium, esta app lleva el streaming inmersivo al siguiente nivel con los formatos m\u00e1s innovadores y la tecnolog\u00eda XR m\u00e1s avanzada. Desde joyas ocultas hasta maravillas ic\u00f3nicas, **CultVRe** te transporta a los rincones m\u00e1s inspiradores del planeta, todo en primera fila y en 360\u00b0.\n\n**\ud83c\udfad Arte, historia, m\u00fasica, conocimiento. Todo en VR.**\n\n**\ud83d\udccd Viaja, aprende y siente sin moverte del sof\u00e1.**\n\n**\ud83d\ude80 La cultura cobra vida. Y t\u00fa est\u00e1s en el centro.**", "short_description": "CultVRe es un portal de VR dedicado al contenido cultural:  Museos, Viajes, Educaci\u00f3n, M\u00fasica, Teatro, Documentales... Con video inmersivo en streaming, incluyendo los formatos m\u00e1s novedosos y las \u00faltimas opciones tecnol\u00f3gicas. Transporta a lugares m\u00e1s ic\u00f3nicos, joyas ocultas y maravillas culturales por medio de la realidad virtual inmersiva. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ybvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yerba Buena VR, Inc.", "support_website_url": null, "website_url": "http://www.ybvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_t
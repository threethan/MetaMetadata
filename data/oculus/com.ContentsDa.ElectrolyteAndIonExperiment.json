i": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_1061005512173528_435888100635925182_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5uVScE0rVoQ7kNvwFrfoyW&_nc_oc=AdlvjgY0ljBPNG9h404UPDngzMI8omtRXX7BQb-nmaqnPHV1ITNAnoqCoUTOoCveXNU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwz0WSl6BOKkSE2SkKT0ZlX0_-QS3_ezulRc-6xuyQ1CA&oe=69AD6412"}, {"file_name": "chrome_Vm3WDh9ARV.png", "id": "403652429349830", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974882_403652432683163_7226161091603027228_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLj1BRCSofwQ7kNvwEUZe7b&_nc_oc=AdmEq3B7_RjhjcHHT98aa9n-50SCx2rY_dNUVYBtpmdvCK51R3-xyHprHdrm705Jb6Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxu7vjrGvhs1do58iu3u7bTp2Rra9PywF_3vjtfTt36oA&oe=69AD68C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Electrolyte And Ion_Landscape.png", "id": "351359857765546", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570305_351359861098879_5087390624247925521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7aAiQr6RIsQ7kNvwGCNjXI&_nc_oc=AdmqlrDXpf3Oir-6tlDx4I9W2sbpRNGRBGrVnqlrJeGcuo7_1Nr-xtn-eIedDN1lbas&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsYZsFtxmm-bh2FAiHcQISl25ygyY3e43OAemF8GW93w&oe=69AD51C7"}, "display_name": "Electrolyte And Ion Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "electrolysis", "science", "contentsda"], "long_description": "1. add an aqueous solution of potassium nitrate (K+, NO3-) to the petri dish, and then connect the power device as shown in the figure.\n-> The reason for adding potassium nitrate aqueous solution is to ensure that the current flows well because pure water does not flow.\n2. Add copper(II) sulfate aqueous solution (Cu2+, SO4\n2-) in the center of the Petri dish and observe the change. 3.\n3. Repeat steps 1 and 2 using an aqueous solution of potassium permanganate (K+, MnO4 - ).\n<Conclusion\nWhen you connect a power source to an aqueous solution containing ions, the (+) charged cations move to the (-) pole and the (-) charged anions move to the (+) pole. This is because ions have a charge.\n\nTranslated with DeepL.com (free version)", "short_description": "Uncover the mysteries of atomic structure by investigating ion charges. Understand the fundamental concept of ions in chemistry, learning how atoms gain or lose electrons to form positively or negatively charged ions. It's a captivating dive into the world of atomic interactions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8518768474876248"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974800_7054964307917876_4054774996763003775_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OZODsd8OHIQ7kNvwFQww0J&_nc_oc=AdmxquBdLav-MSdduyQP4IxoHPWtoY1FY5nBV7W9uWNyBgwTOrpcr9YdQjnWr6U6myk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYMYEXnV4WsguYLG7xTFOBb2s6eXACZmnRVcLj
e_name": "chrome_lL0ciGGyLW.png", "id": "2515220798682797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982451_2515220802016130_724691617509127044_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHEM-C-9OBUQ7kNvwEESzdN&_nc_oc=AdmGn0jBfKwv0dK9Hy7-boaeovwibu10U31R25mLRhqGL_sR20VM13u1QZxvtcaa0HM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzLwGSV42qEwB4SsUzO1MKHpLEkf1-YP0oEwK0g_zYeVw&oe=69B40D44"}, {"file_name": "chrome_HwMD8wR44U.png", "id": "1061005508840195", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982699_1061005512173528_435888100635925182_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GE2Z6MRjN0Q7kNvwH5hOtI&_nc_oc=AdlrxVD0U5b3BIALgkVF8T0lEGfHb4JJIgPC-kNJ2BZyVRtcj75uYRM-THV8cNrSGuU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyUC2ODnz6ahf5ygbVFTifg93CU9ySyAOXdd0eUxdpQlQ&oe=69B3FB92"}, {"file_name": "chrome_Vm3WDh9ARV.png", "id": "403652429349830", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974882_403652432683163_7226161091603027228_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1Lf576GJhsQ7kNvwHQyw4J&_nc_oc=AdlYk3y5k64skUF0_VkihzWoz4J5nq58kAVTDXqTxpIQlkjdJqA0J7A_Bh5M7cTPYMg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxailw23nFFM-c8kklIahetryUGU6_rqZr3FSPZLqOLjA&oe=69B40040"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Electrolyte And Ion_Landscape.png", "id": "351359857765546", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570305_351359861098879_5087390624247925521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciM74-ipgnIQ7kNvwGtJ8Zn&_nc_oc=Adnbk-lu7fZhhT4HbV5EqUWm_mRqBOrhRALzmAtdT0t-yiblwEjhXE1ElJkWe3HAjVQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyKW_f561Ato6iEBuAi6QYxo2E__D4lqsTViijhh0wVUw&oe=69B42187"}, "display_name": "Electrolyte And Ion Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "electrolysis", "science", "contentsda"], "long_description": "1. add an aqueous solution of potassium nitrate (K+, NO3-) to the petri dish, and then connect the power device as shown in the figure.\n-> The reason for adding potassium nitrate aqueous solution is to ensure that the current flows well because pure water does not flow.\n2. Add copper(II) sulfate aqueous solution (Cu2+, SO4\n2-) in the center of the Petri dish and observe the change. 3.\n3. Repeat steps 1 and 2 using an aqueous solution of potassium permanganate (K+, MnO4 - ).\n<Conclusion\nWhen you connect a power source to an aqueous solution containing ions, the (+) charged cations move to the (-) pole and the (-) charged anions move to the (+) pole. This is because ions have a charge.\n\nTranslated with DeepL.com (free version)", "short_description": "Uncover the mysteries of atomic structure by investigating ion charges. Understand the fundamental concept of ions in chemistry, learning how atoms gain or lose electrons to form positively or negatively charged ions. It's a captivating dive into the world of atomic interactions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_mod
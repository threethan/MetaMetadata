embQ8OsYcl2J27TZpPpsc-31A&oe=6A846636"}, "display_name": "HoloVAD", "keywords": [], "long_description": "HoloVAD is a Mixed Reality application speeding up and improving the training phase of LVAD patients after their operation across the world. \nAfter a major procedure, these heart patients have to learn to live with their Left Ventricular Assist Device (LVAD), a complicated device with many steps involved throughout daily life. \n\nWith six adaptable modules, this application offers comprehensive learning. Integrating HoloVAD into your hospital's LVAD program helps patients resume their lives sooner, equipped with the knowledge they need.", "short_description": "HoloVAD is a Mixed Reality application speeding up and improving the training phase of LVAD patients after their operation across the world. \nAfter a major procedure, these heart patients have to learn to live with their Left Ventricular Assist Device (LVAD), a complicated device with many steps involved throughout daily life. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves", "support_website_url": null, "website_url": "https://www.holomoves.nl/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl", "nl_BE"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7217153121747283"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "639389182470319"}, {"status": "PUBLISHED", "id": "938639917731709"}]}, "baseline_offer": {"i
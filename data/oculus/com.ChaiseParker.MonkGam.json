.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZHGCqi3zNkQ7kNvwF7qgRN&_nc_oc=AdodeduoZj3mGY4SWnhiOxlA0ABlEjj61ktsA6kRm1qE7PrakkrphTDA6cONHIvN1cI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAV-QCXGP3kuyoCJdRvcVhYhdWSmCWWWcN41JUSJPmIuw&oe=6A5100CE"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LT_rEOEmgMQ7kNvwHJwkip&_nc_oc=AdrwMnP8_z5gX0Jq5dYSTxVQmGeS_D0hGGP2IBWHpTaQCtU7pioM1rNdaZhTadKu_os&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIXhsUqW6RhM2uXfqcw8YJY9QAiB7NEuGEn-foqWIEaw&oe=6A50F1CA"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gy5hUb6M7rwQ7kNvwEAsL_f&_nc_oc=AdrZbQ9PZOhS3vfzPQPO6wYDoTrxaOaINXlU2xC4bF2NdKv7iezvyJwenY-no77PGOc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7WX8uwYLla75SjpWhphBMrc30cbFXlYWFjBnseU4rAg&oe=6A50F56E"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0RDI9qf2210Q7kNvwFCB2xm&_nc_oc=AdrSZoF4dikoHgW-5X0MCZUXaFUfLosRFLsKyMgiBSsvLpfKfNPO3LOPA53jjo7tPlc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCflb-7zB8PnxHsST4oIn0G8MC0ciMSry0UxgWhRl1mEA&oe=6A50F73D"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0aPzRgcxasQ7kNvwHLhfDM&_nc_oc=Adq6CXK7rKYe6NKshlbFtp8TljQ5v_A70QjAJTjm8yS_bMkQ1v_duSgcdFm8C4moP6Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXd_5-bTP2CSwTokoZHbf_VETie1q47Xm4Ae7iQeas9Q&oe=6A510B03"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdllKID6OV8Q7kNvwEhEm2N&_nc_oc=Adr45QSAciZFXg1Rz5WQRHKog6BMy4dPQyL2_d2EHTL0RYm4wytfQlWJXgFRURrAzFg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwLHIHuSVmiJEFGR6_UWjfBD44ulgSP6YvYlOrdXeYQw&oe=6AF9C0CE"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Va59u9hB2HUQ7kNvwG4Ruiy&_nc_oc=AdqBGMyR0Jdi8Ns4JR1rqhj-8PVugRarAbZNqdISnECE2rdOnm25yOiB8HJ2tP8iQZ0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDwF5_kA_Z2IvGlYeyoxNLb6hBGvcSyEST6vzduK3e1w&oe=6AF9EA0A"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5O7XOuiX9cQ7kNvwEC66aQ&_nc_oc=AdrdGAaPMZyrJeM6EoJuhIK21k7gzloOScpdwAy5YRiXCIxySf0tJ_8jKTLQXNtALMQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSC3o_nbJRzVCQQ8tPrHvRDJozual_9xCp0mZbxarBJFw&oe=6AF9B56E"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztPyB0ImePkQ7kNvwFsvWu3&_nc_oc=Adp9jqX0FcSWlFhclzbyi62WJTKTzLZ4wzz_Zb2moj1NCpGLFEAWfrSRVOxw4YSgkcE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUxRZmlP6wItRIGulyqvHfEALYftc9RA_Xn8xtsI4-jw&oe=6AF9B73D"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DoUof8fSKNkQ7kNvwE9cdUQ&_nc_oc=AdoALIGWKioLqXvE2jV3GqyKsxG9SNcN7jPx-yxl-d24ZnOs9EM91_gNCUP0fJfeuaw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSl6Zwy6hsWfxmpGEPWiaItyrH8oc6kUD_1-ndQsFQSWg&oe=6AF9CB03"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
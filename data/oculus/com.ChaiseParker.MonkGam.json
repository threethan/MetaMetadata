.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lF1h2rJDQecQ7kNvwHV7Aax&_nc_oc=AdpOEF_C5VfRcxwd4EyAfgE3rfScYm8y6Yjc97HaHAZq9mcq5vkNLCNOZ2KznZ2MazM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DNNn3VQlK78P3NTjAVCbkktvXaRp7_Sa51q_TiinmCw&oe=6A1AF34E"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_FgMQUo2bwQ7kNvwGSMs4r&_nc_oc=AdrCuFxN2LC80sOoOn8v3Y69b9cVkVhRyAt8R3ObWZuHVdrVZl7UX1JEWSs58NCiM6s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IFA0skdcUL-6KnbgGeCt2s_FRejdo5C8Q7fwI35kYKg&oe=6A1AE44A"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRm4dEz-QXYQ7kNvwF35t3n&_nc_oc=AdocOqX_TDW5Uakx9qVyMSVHfljmv2JdZlvI_v0JoBb_Oa_7Q6sxxVvIY2-wyzc5h1o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eKtTqXw9lxc8KIc0c6nDXp9Xcc53hkmqwhGHOc99-rg&oe=6A1AE7EE"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMFJUwaz_KsQ7kNvwGHPYZW&_nc_oc=AdoydYJjVkZ6ekU5SDkdLOhcIRNKPGQO5ejDrwi4yYteAJ9S-wrmtziNSkyR5Qt16yE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gI1tp9PzxTmJQxP91EjgllkpbOjpmXg63PGvDWUxo0A&oe=6A1AE9BD"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66BmmkpJVVQQ7kNvwF3IUqV&_nc_oc=AdonjzSDYfXc2iuPIE1r33TaiqxX_6Tgv65Dxf2Jd7MyNb2zBBIA5JzVVtaEMvgCUVE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WnD_5xtZljbDztkHjMBh0sBQmrXSeRPthUcOYtcP_1Q&oe=6A1AFD83"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GS_AK71r7sQ7kNvwGBsqDQ&_nc_oc=AdoowT0l11k4sydvIESUnx57lg3JJ19bhxb_srvKOClNC3vhiizNaT9HfP8aMIJPeJ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4ZgMkLlRFGsikRTTZH1KwIM-NEiUrAibT0oSYm2zWVA&oe=6A53A3CE"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXLqeIBZNGkQ7kNvwFTOrxO&_nc_oc=Adq4uNkAdys35uRpHIgU0knMN8sP_1-JDEFvxXNrYUDWkXnuDlB9J3TpH_jxHTic1xI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6xgh2FDpzFShPX-Ox9H21j5rqpVUsnkvYyn-XKqj31g&oe=6A5394CA"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gy5hUb6M7rwQ7kNvwGnHOG2&_nc_oc=Adq6VTUzOWVQTHeS7B8XNUx3daVxz3UwzV4CPauhSmDBc_3W61D0tCtAgKIfeVJzPW0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDj3bNoI7W-t6dHCFkCkMmPS8f96_2KJlrvq-QTf6bz6w&oe=6A53986E"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NX8SdSCZxBoQ7kNvwH8wAFK&_nc_oc=AdqgfmslgJYi_rr_paA3OQH0n11V6-ufa9f7bOnyLkJA_lFQjbup8d7XO3WF5dkJDy4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBz26ia168MZFy5j8VlNApQlXMuJOWdNQCb7dfxIWS4Pg&oe=6A539A3D"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0aPzRgcxasQ7kNvwGqdqkr&_nc_oc=Adr9H-109XRvXaGTRuULJu_h7UsyVcZLv23j35U7ETGpV8aT-bkmULaegfNgnTICX1g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2FnMpT2ddkaZdmcu8hvNYr7WG0Z-6iJ1qGaWuoQeLKA&oe=6A53AE03"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
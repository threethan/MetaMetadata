.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fu1Eze1C110Q7kNvwFq8A_3&_nc_oc=AdpcdLL3hiPKbdkyHtTkPlXz1cuMUycVumphqwD_RKGpYP0DJkLM1UXkXUxFex23thw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96FjajA3zB81ZZFdjUyQMCc0U1t2ur0rVxKWE31jPDOQ&oe=6A43D1CE"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHBOWpAUtOsQ7kNvwE7N55Y&_nc_oc=AdpxDHRjVMqYwXuLjkNIY7wbYzkWnfb0YQA74BT5mDI1yE4EpD-Ev3K76poAaipZpUc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hzpWeo7ezDMR_MGPY0O34OriipE0YwvrA5x_fSFSpiQ&oe=6A43C2CA"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0rab_A_xm8Q7kNvwEdUh3d&_nc_oc=AdpzfnZ89hV7TNxKvRqpA8JGqJ_My2967iIS93zct8kajcLxU7jb70Kq9qaR7xUsHjQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tohV_9KiF53BaP45jjk3MlY1eEos7wTU6iamcBjYBfQ&oe=6A43C66E"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLrmAiS_rTMQ7kNvwEVDib3&_nc_oc=AdqTKCG0h5T4XFqBVVwNeJ56GfIQsBWD_wk2XOExEQ4AWpVHZXVw0lZ1B6A9LPY6eU0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-J4_7yj-LvHpaPBnZMjuQnwxLNiW3oIUrci9WZwn3oxA&oe=6A43C83D"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAQXuZGzgQYQ7kNvwE19fj6&_nc_oc=AdpeBqdbplx-drfwog-VA2ducuu2Nj-I1dqujTB-eluNBWkY3PYM62r7D8w1kv9ifS4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DWnkBJJHTPbWhPjQpnoJ7twQ3m2tm9bOC-_q81lgaSQ&oe=6A43DC03"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
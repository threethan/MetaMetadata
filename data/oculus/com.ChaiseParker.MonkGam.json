.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65npB0oZqs8Q7kNvwFnp9p_&_nc_oc=AdozYO_KgQ3eWGjYwZN4pj7yRSKWyFN3s4b-4mtbahJ-cCabZcNqhE2n2wdVqvO_BNg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UvF5_gdslc81R2JxBhHq94hpBIGJIHr1EnoNthixW2A&oe=6A0B214E"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0UVbvpR4pYQ7kNvwFf0N0N&_nc_oc=AdqX62fCoNaETN5EjET8WvB15gpgpcTGq0sxSQMS3S8enreDg5gXutR6iXEbJBdIlQg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VN776_dtG7n8D8NciiwvM0vwy2CorxjzFFOUvqOpMqg&oe=6A0B124A"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0ldACCPDR8Q7kNvwGnosYM&_nc_oc=AdpD5NZ6p9tCHmhGQZ7R_ZhNASUnQrE8fmt1uNvelZpv9Dk7y74ZxaGI8-qXT2I8iZE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o0btwFbYB97CSijLVRXhpCYFSZuaPNNOL_rKRnOHACA&oe=6A0B15EE"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bY8MgiuC2-IQ7kNvwGy_bjk&_nc_oc=AdqRkPN-PjATOk-akuf8RDAlQ9-6kF8ygXRRV6LVJf0NesQ24CcTZ17gPpUbXISLz-o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7U1lszNn9xWxwAlKFd5tPtqvVXF4xGTwIqWwD9ExB7UQ&oe=6A0B17BD"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZBY6x8xOY0Q7kNvwEqyy_F&_nc_oc=AdqHgVS8tPPlF-kXHSxvPr-VEUUIS2fip-ynGZMacPs0hGJoEasvWWDW6SjS3f_PpCo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jMAUWluxdZcuCWC-MEtob536aYIfCovSiok3nG0yF9A&oe=6A0B2B83"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
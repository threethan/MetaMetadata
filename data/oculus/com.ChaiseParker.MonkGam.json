.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5o58PjkjXukQ7kNvwHvaVu2&_nc_oc=Adpgs3ZKwjngYI0AyS90s1c1eV9QTt6P2b2l6lvrjGvSKzc0tm9ZPgTd2MUtDckozu0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2DHBuTEPMIUecRCrJ6DKAVVXJpzyJAW8gFOlEWKegSYw&oe=69F6094E"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIf9wRcHbVEQ7kNvwGK4xsb&_nc_oc=AdqKuNxR1DQfw2g_JpxZX0Mxz6b5MiqH7hvpVl4yUAGDGlfoDONJZonyKMTIBaBxduw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0PjVQMR08k5ZAQfcNKyamDsMP2mZRw-H-nMTU_vVo8uA&oe=69F5FA4A"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMJ10gar0v0Q7kNvwHJmbcB&_nc_oc=Adodtq-dJZi9iXeRz5jA7ixnqyVwYfIUgwCoa3qeCM2D6CbWVGLh-dfyNHfK9ezDAN4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0yQV7hIyEV4EIHVoGLFUegaGcLcIoCAXFj_fKQGfrgmA&oe=69F5FDEE"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8afOMxT5Z8AQ7kNvwGmPZm3&_nc_oc=AdpNlpRaTOSZiH3wMWceirGBEVBeNh0gngbhdEw_hQzITF1uW5AweW-VSeaXjI2lFyY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af36t6uCJE5qZhFYoyErZmsitNfsgmXHPrTrM9cN7UNnBg&oe=69F5FFBD"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXwN-uukj9wQ7kNvwE4nklu&_nc_oc=AdppYe4jmTskcIM_cuQ-6yjYjkRAsZ9tEur5DEysmrFyRrpOtkgvQ-W2BDXc-X1UADY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0lzIxvrzDXQNVFFe7R7rYieVAWr2O420wwr-xXmtMKBA&oe=69F61383"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
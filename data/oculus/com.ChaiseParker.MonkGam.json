.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smI7sdh0vn0Q7kNvwHiJFWY&_nc_oc=AdqaYMtP-ZLutbpxi6gVrTW0zUyWVr8XyPSOdoH_lSFpUWhgusJNe2cJQz2SVGpgpwA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iPXOfAuI5a09qSwXScprp2i_ZqSuhh7Bnah4Qaejgaw&oe=69D9084E"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKDAJc_FaVwQ7kNvwEG2RzI&_nc_oc=AdrP-scBM3aoK5FKLWlyvo151Fg_4F4vsfIRVS3hhVe3RGNH8OXkODy3xvDu1L7zvWE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pw6tfLnAmXF9gqPFCgIQN15CMbULMRxBpJ6Ecrb86Zg&oe=69D8F94A"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dF2G7hxeLMQ7kNvwF_jyOF&_nc_oc=AdrCk-e1b5kutSkwObvpyQWCqnhDaiLWIFK3pEqkfVm6wpjg0YZsgHLQyGADxlCXG0I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DF3dzlX-xCoi6bmuMoAh4xMme_JmAomNXGZ5tn5YDQw&oe=69D8FCEE"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3gq_s_EYpAQ7kNvwETBNjj&_nc_oc=AdrJyk-YghcICjV5JP5lAM3bJjfiL2BrDuLHDql_PBt8jeDvuzZvfW_Tgzin0B4TI88&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3njuEqibz4mtxkfn9mILCsNRtEJmDh2fz7T_0IeHdjPA&oe=69D8FEBD"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLasuD-ZhZcQ7kNvwHEH6u7&_nc_oc=AdrBIEnIcyjEpfOx-T7mDWq6WtriiKkUIWJGff02flZdCZStrr4_Tsxk2TKaKJGff0I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IfcpbD86ps83WaEARxYFSPr1CcJMVVomh7DVPfPE0KQ&oe=69D8DA43"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
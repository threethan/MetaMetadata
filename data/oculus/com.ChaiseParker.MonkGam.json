.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdxIe1nBic8Q7kNvwHR1npc&_nc_oc=AdqCsP9qP86k0cD54G-hAcaDSshOUShJElSVxucCx4LEoFuMWrocZ7wU1p6z970_1Ic&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZO23IBX7nYlYsRsdEj-7kK5a5DYKPUxMuyKyPm4F8tw&oe=6A803E8E"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIt83c7CCrsQ7kNvwHj0eQx&_nc_oc=Adp6HFBt_H9jaoLlf8Mz6IAQEKyzDiEZYEcRtn1UxKSZfjhtuZniJIlar_WhZavknKg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6Ae01WGOiv90S8oPF1N5PQDHxFA7AtSz68gTpmgIWGA&oe=6A8067CA"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luPJsmeT01IQ7kNvwECCshQ&_nc_oc=AdpZo5ji6zVjar_s-JmhT44oZVyNMkpeNwwD1WuYhmppI-3ZusFMT3t8kP7C4Kqe6FQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGG8Kcf1se4_h9b4btFcAYlkCT5SAOfC_5QES0RcStNKg&oe=6A806B6E"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ut4vCN0J23AQ7kNvwG5lflH&_nc_oc=Adq7qB4Yhqtw8Wk52VXAU6OKJYvo0Yj7Mm08BcpzYkq7WhXNNOcviFTz4iDpPj2yJWU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsVHw30T1wocbmzqWlg8vuig4vsbET4vsmx-b-mwaNxw&oe=6A806D3D"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfIP5RDJh08Q7kNvwG1ItgB&_nc_oc=AdrSenPCAsArskqlbPpA-wLrT6pxZZzY7sk90ULh09qVCPomR0VwpltdAC9aEprxox4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9a5b5BlJAjTSJaeJGE6bVM4AwzaK2oD1TJjaDhQb2XA&oe=6A8048C3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
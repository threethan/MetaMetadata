.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYeKAFe5A_AQ7kNvwHPvWNz&_nc_oc=AdpRjFQ7FA4IdNLQJJT1R420G6MWEa3hD8TkH4UzoNXwbgMKm7fBDNbyXBZ-OCsutgI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_FdHv11hIH-qwgxxFZZfumttPhYASuMqGpq6on8qNzg&oe=69F8AC4E"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFWvgaViuoAQ7kNvwGunYA4&_nc_oc=AdqMqN7RBOfAJk0Pl17HLB110uOtWRgtzwnnyIekr07msS1QQRF8rQlbJaHkNP4pSbs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0XKpcy5CLTdqIpQCtRh6yXvOfe09gW0LQv9NMNKC03vg&oe=69F89D4A"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMJ10gar0v0Q7kNvwEV-KHB&_nc_oc=AdqaiTx9WzT5xmRPbr_2yh2O73Sf4HhlCYOqTLGaGA4P_7tUSihVInpFQE_q-WQ2UwA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3DCQFAfd7T9boB1cTpojQNttQs5PzioxqiAUhM_xjakQ&oe=69F8A0EE"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NtePCoFMDsQ7kNvwGL1uFI&_nc_oc=Adozh-3sXlX6b2m0uXVgcA7z5GfowpXwVIR2YTGI0485Sv12dOEp8NKqYnLjw2veDAY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3DqsC4y33ZeKzzINlvbFLU2Kho5Ah8yZhi3DNIWwa1TQ&oe=69F8A2BD"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXwN-uukj9wQ7kNvwH0fdrY&_nc_oc=Adr3wlAkOeMSQvBcNBMouxj-H2-rZ1CwXuXGGncFVvKHl9gGJn6gyrPYk_8jT4_a-QQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Bc65YhNAn-0EVIoiJqrq3g5G8wIsloAV10921agaDgg&oe=69F8B683"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
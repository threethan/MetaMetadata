.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVtkEBUfTUsQ7kNvwFFicXe&_nc_oc=AdrQvFP6Rh-jhGnxisD4UwOJib167PXlw-U3E07zToTruflDOPYvgWSbtIL_1GpHEdo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHV3Rf93zh2I5kazPibNx6jKJ7p1U8c1PDh6-DKCExIQg&oe=6A71F64E"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzBpCldoIjsQ7kNvwH4GXeo&_nc_oc=AdpahA3KluWkMRg9n0F-W7IvAbor7nXyMSpnda_1WKFfhiEquz3gg6cHjdNJwwFV6ig&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHn3yD0p-uM5Od0w4_MfwCVVOQqDYxrlItDnzL3TcICXQ&oe=6A71E74A"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8CFPn6kDqEQ7kNvwHyoWsQ&_nc_oc=AdpCLKg831PYSjAfTT8TmAyzLv7nsLiA_gqrwLajhdk6OuAUtkt2wQPWT90Kv38Aqcw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxZWX3q3W96Vg66CeYlHASPt-PeJmYrjm5tLqDQvPZGQ&oe=6A71EAEE"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCG2FdLqs8oQ7kNvwEpZuAr&_nc_oc=Adp7hg2Yxta-kUs2c3-Sw4kRALh1CLQ2LnK8tX_zarUbdp6kmxnopPwHcZd5Fk3N2Jo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBVGH_dFYj7X0hJz5brbSFkaDG2cn9WlH32DKsuRG6zQ&oe=6A71ECBD"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-8QWM7xu04Q7kNvwHUL8Sv&_nc_oc=AdrFMq3nLJ4re_aNnRTQLlw2Yat8nmw-h5_uv6PUC944boLNFtCOpoc0vy2u2aUy-n0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEe8qiiiTV86b8XVVjxjS1w-w3pRWbzFw7YWezSg-wy0A&oe=6A720083"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
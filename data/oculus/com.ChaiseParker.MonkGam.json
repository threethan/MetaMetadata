.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8DMVm8ZOOUQ7kNvwH8WF-e&_nc_oc=AdpUEGS9RxN8S87j49myQ14-9veO018qc_-EvBc_iW68djfXjv3L8KzXaYqBkEB65QM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFF067GjGbJxLckK2xSsCjv2J7g9c_i0coZYMC_zqEI5g&oe=6A90108E"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JACEUSQGZoQ7kNvwGC8aEQ&_nc_oc=Adp9FN5it4qyd5d1r21JbaKd1Mq_z7lrp4oWolCCUPNSOoN-72qU0lLRBkhiVX_VVYM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3EUrnaTZl6-W5XofPS4rKdxTyl8kCVJQUUKvY1jog8w&oe=6A9039CA"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRRv7KqLiskQ7kNvwF3sNgO&_nc_oc=AdpBGFn48JsNMiMYNfFrtX2yo8wUKytSmJhaXtDfduqn_vNO2VRxp6_cBjM9IfCgGHQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5Tb-H-ffIcf9Vx1BFt91BozHh-dGzjKIOkbAB_L0RHQ&oe=6A903D6E"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ioRdOAUmNZMQ7kNvwHknvQ5&_nc_oc=AdrXmq2Mantp9tMKUcQ4w6Ztk4KgLlLicMqpQwldPCGu0SOGuiXYcyyTghmWAACZ_dM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUnoZPiFIaLYNbUC4-7L5QRI9VxjkFm-0wZUAH5YkooA&oe=6A903F3D"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXrbBC53pf0Q7kNvwEmHZv3&_nc_oc=Adpnjrt8ixe38ZbtHzy4NtdKxgBNYZFatyn3_--LtT8OncPf-uvCKLlO8bQCTFgTg74&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEc4sUfQTlgkRjR6kKVrUA6v4w6wrsm3Od7dscpIM8pTQ&oe=6A901AC3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iK963dsqhpgQ7kNvwH5uPvB&_nc_oc=AdoM6vr_dcbHDo66x9CyId3R5oow65t1E-_2H4_OUnvh8hSzaEWFUL6JzNAH5ZLNbCM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-CS1wx6tJjLuHc96PWzfvBK2-VlAWeeZ4r1xrhBLHGA&oe=6AEF34CE"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptNPiUOwuGgQ7kNvwFs5c8h&_nc_oc=AdoEV8LxMHP34yt469O0oWXau8S_U4PUaovHfo4isxAC8PhwG1xGsO-JU5TUtFjzMRE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwXUNTkfzD7k2NfGkamSZHf2r503cdGqMzbD44qzbCXw&oe=6AEF5E0A"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAJplUwUnvEQ7kNvwFm3d_C&_nc_oc=AdovvuOFM1H64QbUMa_xJ2NjJLrUnSMG9cBLJz-mTodfsNvRjQklh9e_RT8Sji_OZPA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPQsWjrdsZZ8-XeAdqCGYIHJhJ-ejdc0E5T4_LpcrtwQ&oe=6AEF61AE"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZP025Ujc-OQQ7kNvwGBSIfK&_nc_oc=AdpFIo3Cmsg-n3-hqaCALJ82UJ7MT7nvf3rMyAQBZAi4tHE50hbI1q62ydUohjfr53w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2wHVcEz3_S4hj43gfyNv5SyWZJOdcXy7wBeYR4zA-ag&oe=6AEF637D"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHkpkJi2LdwQ7kNvwEwhpMG&_nc_oc=AdqSq6cRJJDSoRT_IEcZnkY7lToN1AtL-_jMXqxxkrqeZDPYbUujK26XM7SEdKT5MkE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV2b0gI5Fez2BbwoylbAYHvfJwY5OJ4ispsVh-0iMuGQ&oe=6AEF3F03"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
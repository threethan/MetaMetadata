.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdxIe1nBic8Q7kNvwHoK_dz&_nc_oc=AdrSMA1aNBg89EnXlvHHMk7A_GQU9abRldntMFeKP-8oEX7xPc4Tc1J7LiSUzMA-UJ4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFugcT1QXmtgLQgCv6DBBDMZSZghRdI9vZZuQReXX-xyQ&oe=6A81900E"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0CEScmnoAUQ7kNvwHc2MFK&_nc_oc=AdrfkEhYiJgoD8NihU8JbMnQIanmapjiOSke-FsJZLzcQFbi_kZMUpXEebfLbr5G9kY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGF-_cNRL1sEh0ukGmBmeP2yzXlpIVBK4_mD5BBybqoxA&oe=6A81B94A"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luPJsmeT01IQ7kNvwECiO6f&_nc_oc=AdpoTZu-ckHMSkep6IKQPJfA1yMwc3V814Nri1lYpn7z7ZRAYJOho22mhTYWm_oJx6A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG40X0jTGTV3ZgPQY2skjElPOGz_hSzyt0pLh7Ko2bYUQ&oe=6A81BCEE"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ut4vCN0J23AQ7kNvwEO7uGu&_nc_oc=AdrZd8WGLb3-jkIsdXpmgFUwd8QQYo7rtZZ145mlgLQK2nj_oJq3-q82DUTt569MBJY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXcqHBh7xeN8oWSKvnQjhy09eEht4Z49Sh6fTD0HtOHg&oe=6A81BEBD"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfIP5RDJh08Q7kNvwEE1ekB&_nc_oc=AdpkHkU97LOfIgPztmsrUFmlBfRyg-mLcDvRyEoet-BT9Qgpz8T49y9PZnspYX6EeXI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESyeHEkpIwxvT55UFCMdDG48E1U-SjBOEpPJIDUmlmZg&oe=6A819A43"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
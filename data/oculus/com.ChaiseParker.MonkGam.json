.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vY5nrGVV1TMQ7kNvwE4V4vO&_nc_oc=Adr8f0bo-9nl2TsKcUE8Hz3GzEwCQLlhanfKR02YAsiUDZoQMQQRRd1l9--0ALAchrc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Nzpz0Oc_4CKiwOkpZncaJdQ-SqI_24Zj5k3HUt9wiOA&oe=6A32AE4E"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PJy7En5WBYQ7kNvwG8VxfX&_nc_oc=Adp08EIx5pxYcLW6dFU_wsaWDFIU4cin0PiGAGIybvwBLuXGgpJUmB3gXnL2WRN5EB4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gLlTk_JByNMhcBrQ_HI4UF0dyBU3AWl88FvTJMxyXVw&oe=6A329F4A"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hgKFdWqO9oQ7kNvwHyyn2T&_nc_oc=AdrEW3K3ADTcg_pMshvOE0ROvN2op-VggJbiEliefrEFfEck2Fojicp4CH_9st0eXNs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9N5BbFDT9q3i4Flwx1XPza6RYdD9tLoQzJ8t1kbH-26w&oe=6A32A2EE"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAQvyy2NBRMQ7kNvwHjzhgQ&_nc_oc=Adoj3kqRo7i6uM_-nD-SwLfKdLDwW7l32GUpPiIZPvlETpk2yIuGeIBhZeTvKVX4BgA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Mg0xdmlS6ZUd4bF67B3lTt5ULXPVuB5F6HzmIkBM-1Q&oe=6A32A4BD"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=As89T6Kz6OUQ7kNvwFy3kIj&_nc_oc=AdozenD_cK5cfND-YQF-tizo0GCX8adIm8QN08h8-77-O-eQj-6UBDd_HiGXbkAN4a4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9RtFtynuJvzVcaosvyHAUX_Xwfgd9gLSOJYGdeKal3w&oe=6A32B883"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
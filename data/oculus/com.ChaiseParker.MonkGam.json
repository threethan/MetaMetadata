.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqFPHjcGL7QQ7kNvwG4KeK2&_nc_oc=Adphsn_5Gd87B85TY6O_xKuU70S078CKEQ7P_ui3AwU9iQ0aXNWyhhbgVFJqsNNZTy4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFh0XA5NgkqjGVBCRODNTLr3ENZT2mDogN17lw5V4Mhg&oe=6A9C264E"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6vxfo9OpgIQ7kNvwH-wLOD&_nc_oc=AdoXm7znD0-3OMGeKlj_tUap-ZGjMs1shoKVwjm435DTS3dKQXpEyosxlQnmyvCF-UQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXXH10WkHBYwms05FebJd8gU_BaVQcrK5lti13CW-o3Q&oe=6A9C174A"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MD8o0mDBY1cQ7kNvwEMWv44&_nc_oc=Adr6nMorF0rF_sEfgLPOBKIATN5DGIOBEcaP66qDIj5v3t43mbsIIz1jNcFGrCjWXy4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjzFBLfMP9bz58tpvF2mjmhJRMqZXe6J1TySRRUPLSRQ&oe=6A9C1AEE"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IG0H4iyIdE4Q7kNvwFp9YY9&_nc_oc=AdoUGch4f12G-hR9PcF6SSZA3NrlnnnI4_aTzCfGDb3T7Mu8WwoaYFtc9JkXvGpCunc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzigy8lANiI3DcvoF3NWCQsiBTa2wBwQwdk8XFlDtZrA&oe=6A9C1CBD"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00evjdZ11z4Q7kNvwEjxGlt&_nc_oc=AdpD9WQRYDFxJRDT2lOeO3Od0adazM8bqDeTAjJzcaBIpSnK2otmWt-REIV-k07Byu0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrX3dRnVvnCoior7Lmwu_DI-hhdaJBpWCRZ9ut5drKUg&oe=6A9C3083"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
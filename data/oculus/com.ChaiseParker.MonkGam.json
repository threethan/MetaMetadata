.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Man2Ugboq0EQ7kNvwEpeZBl&_nc_oc=AdoSSEANXZTnZ4Ng-X7a6DC1-g5uSTNN57gU4PHbChl945yRZZ-I1FJxEJWlLlrYZ10&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxRnrLNMxi6Bx9ee7-JRj2dZxLmyKbNGwVvL8M9g4kHg&oe=6A8C1C0E"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AUhVTVFSUwQ7kNvwGN39TB&_nc_oc=AdrWCggGVTTTkKHzNKJ_dHfE0PAi4QoVZ-AVZkW3LBECy17zSkw1c3ggIbNWUgKvdU0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGClUuYboBYPLivPYHBM1PLmh067V8ITnPayaE1dkqQug&oe=6A8C454A"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-R1byzQAm2gQ7kNvwGcPVWX&_nc_oc=AdqDVlNqq2pjK-piRDzom_wQSNeik7IHw2x7Tw5y6lWS8eCA8YpadxlVCNNLfyApH5w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0_kFMvzKRNrgd9O3GMUIF5r2Ia_bwOfyWWc8IWsw2Ww&oe=6A8C48EE"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dnOcoOhBvsQ7kNvwEaoD6L&_nc_oc=Adrp82C5kUqucQm-J2W9pi3Q2QPJhknk6FOpdHto8D8ZRZo4vwRCMuSowrTElc-k4jc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnPzNDTWnSD92NRG1yOeqf5qabogiK87tzI2ffN_9e2g&oe=6A8C127D"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofKBQqSCDJAQ7kNvwGsB0g5&_nc_oc=Adq_WG7Zhj8Cwt1C9g7hAabAYcYY1WuYMfcKUvTnguNxl-higmKoWibaFeMRv7-qqBg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJX_irtdud2N5f68H367-L9qz1DFiR7oQffzqJTUkmyA&oe=6A8C2643"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
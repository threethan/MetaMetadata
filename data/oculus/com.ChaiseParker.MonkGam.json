.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8HmZPyb6sQQ7kNvwFtotDr&_nc_oc=AdoRUGuF3QHCGZoeRzYqkEczBhXeTbIEj37MCPkEG6kG4DVoX-9485dVSA-5zVlxVXw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH88AbkZC9d7R-9Ul8xXN2iDiYQy038iTkyfZL8YYStPw&oe=6A86D60E"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuT7awuITUsQ7kNvwGo_Oym&_nc_oc=Adpm_CurnbjbWg4uVJp-mxquc5hbX8m9wF9TqtpR2TvXxeodhvqUBlgjDcckkJE2n-g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWdDJ65WayCrNT1Qioms4G6Z_H7jYIcEfSPS2fW5JPWQ&oe=6A86FF4A"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjKlMHnoFrQQ7kNvwGtoC0b&_nc_oc=AdrhS-cvItpMMrkQIAuLgzApojY8HlYUfw5FocSiDM_pAAHfMXvTYU0z2HE4VnsxIIw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnrGNg8DtO2trI8IDyP1L3-EZUOMoHw5_uvckZaBBgcQ&oe=6A8702EE"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNIPYARFefEQ7kNvwGU4OlD&_nc_oc=Adp0Vv5wE0ix-8goslZh3OM_RnPRsOnsE2q8BiRuaHqpdsLzi2PCZ5k6ADuh8tLcZns&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuOUPwHsG2KGtVjyhq0u5vm8zcjParyVqJ66k2EZ2QFQ&oe=6A8704BD"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXDQ1wUnn9cQ7kNvwGl3t3Y&_nc_oc=AdoI9ilC3bdPRRk7Pm2lBcpwwRq-dGlR4B4ZVbIxZr8drC7L1cduz9pDQSPEBmXY-Zk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSREe5flH1YPfHPg8JTzZelU9OCm_348rS4_mghpLMzA&oe=6A86E043"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
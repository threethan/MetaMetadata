.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smI7sdh0vn0Q7kNvwEvtsAT&_nc_oc=AdpWn6bSSQ5ZrtvtkR4Rk-PQnz_KFFX-Z0mOE81q4-d8OsahSSbWMyU3Qks0jJPOVbs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ANmWzfhC9MfB0d1TMU0PvkML8h5iKzshT6FyySQONvw&oe=69DA59CE"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKDAJc_FaVwQ7kNvwFVmjby&_nc_oc=AdpewI2ec1X6T9Mu6sg8CChlmlEOMTMUiHFxILrTF7_rmvI5wZ5IzXXTzFxhl7t24u0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af054232rlQEla_HYCLvCIN67vMlDDvfDXG4L23lF0y8ng&oe=69DA4ACA"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fF87LaCK3PcQ7kNvwE5Yd6t&_nc_oc=AdpbEoLIVD9oPnbcG0XawwmUOWnfsZu5v94zUXjYt7ecTLvLGo8rUOyqSycrmTTtYmQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2--ZjPkvhcPqWv5w1-XUtlS8b-hmwcx_TAHA3Jh4lRXQ&oe=69DA4E6E"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3gq_s_EYpAQ7kNvwEp-LGm&_nc_oc=AdoLSrW8b6O6biVkXo7d1gt7ERROayZcspZS44WPxgVCpuq_ogcejR250D7ZPAZjt0M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UEF67X6cgxqqgWnpJCQmXwIMFtBwd2uAwXidW0-Tqyw&oe=69DA503D"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOta5tUSW3IQ7kNvwEtgDIn&_nc_oc=AdqFPMUGrNd3z-b_6NkyeRRSOLCVu3V9WqnSSoLSiDLwrQZ5i8GrQv01PsXuAEhydMc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2D1JMOwaWQcB8omiswaN44Ovtt5lQVK5BHSEHtTk8KeQ&oe=69DA2BC3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
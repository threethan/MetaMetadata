.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOJLlIwb9UAQ7kNvwEJV_cb&_nc_oc=AdoGQhX2PVkYzZrsnEBBzoIaPEIyUNaVz3DePL1f7Zxxx-cHhVOq-woreI_NoclOpZI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vie0jD_oQri8jvo3O64NGslrdIRNyrihgOGABHyzcCA&oe=6A2973CE"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkQrWE2eHgYQ7kNvwHpLKNZ&_nc_oc=Adrh_FOn-kUo4d0nRULLo7SK5ztUmS3vgh4Yo98oRMLs38e-zdr7k4jqa3I1EbC_SOs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3XQtt5zLIwBjx5VoHH0RuS4HkIX15qz30KQAJ4yd-pA&oe=6A2964CA"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UimtdReSuCEQ7kNvwG1BC1H&_nc_oc=Adoh2tYaqHU4DG_qtaY7p2c7H83CxUnPrc_oYsXeyu4RVFsbC9g8tr6XzNVW6cA-Pb8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-R2v7Us4hdgg61FanVjPGNgXDFM4wVjCx9xk_4moP3Cw&oe=6A29686E"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpbPqoTsJMAQ7kNvwEcJuhi&_nc_oc=AdoODevh_joIgqoQMXsXKPCm19ohwwjdJN8Ws50yoSfBabkEk5d3WHs5FgZw8Xci_2o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qZ8Un-wbrAL0T0OPdrX1tyiGnx_smycCewhDV8uJG4g&oe=6A296A3D"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsfDzZap7vkQ7kNvwET3pYK&_nc_oc=AdoHmd3X_K60HeFBFC3K1Ia8pESMcpmDZrR0DmT4R4XMZUNYqmfKqTBaft6Xf3Hs03Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dCEYKjNkslBIAOoHKdqX8sFhSN5-qi4gVDUn5A90_pw&oe=6A297E03"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
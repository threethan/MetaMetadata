.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjPORi7GUK0Q7kNvwFaZaZz&_nc_oc=AdrWvmtYF1VZB_Qgk1OvAnbbvX4uDZFRDBaBGvmZJLtIzCCrx9_2hGNPADyak4-hIzc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM54kH1O1xrrhseuZascaN1s_eAB3AHbXysVy4hJaHjRg&oe=6AE205CE"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVqofVLi-NkQ7kNvwEL9Mgr&_nc_oc=AdpIO8xL07B7jXwlRdGmJEmBxfYqyds9zf7LtZACOjLTVl71WFEJ4vyCRiPMOCUgIzI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxHfnwdiT5sAZClcJmdsIsrch4ADQUqxvR7vmBfFi7Hw&oe=6AE1F6CA"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X10vAeu5NcIQ7kNvwEwP4Fl&_nc_oc=AdrRCDyOIExcOFpMvEx2W9RQzYZ6Kyi6tfo8_x9XKmYIkJ9_M_sIrlFasu7oM2xeICw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDbCKbDCYytAIoLaJgab3ZqoI1zRfykMN5hKmLOclNCA&oe=6AE1FA6E"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66XgYv0T2g4Q7kNvwHhg6Iu&_nc_oc=AdoGA0rWwCvTpQx4Krw4jKcvrNVjrqzG8Kch5L_rmYXkfQZyvjFPOHsCW2NFuBGv-bw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0ORYer2kRDzsG_wagz-Lo65LY4YrwNHMnNp_3H8oM3A&oe=6AE1FC3D"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyhZNQgPqcoQ7kNvwEtYcpI&_nc_oc=AdrqOL_hiy1HtfUfmwap7e8npE8PzgWSr-raxL1Jhb_Rlx2vBkhz1rDyuboDrkkiMbM&_nc_zt=3&_nc_ht=scontent-sea5-1.o
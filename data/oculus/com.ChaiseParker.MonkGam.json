.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vY5nrGVV1TMQ7kNvwFptwuw&_nc_oc=AdqSmR8BiHECBJOL7bZZaVbgjsHc_MvHgoov6-FFA4IWxa0kTm_spCAMuScOSOi3vXo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AdzxLlfO6KMZcW6id-ecMVYDFo8n1qEF08_LGJQuX1A&oe=6A315CCE"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EK-to5daOW8Q7kNvwH94jrh&_nc_oc=Adoc9E1MyxbLP9tm1qQ4V35Bod-tBnc_JXwPt4qSvKiyz0iF_oPUmgXF6o0rNuwyG4s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SDMW23m3BCqAvqg4xkAeYvNVbGaYsLRy-RZayQ2kXag&oe=6A314DCA"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hgKFdWqO9oQ7kNvwFQOD1z&_nc_oc=Adp5Mp-rng4fPvFzBW7T2_Nrhh452yS5lkGsBkJmQNDJr6OJ0_j5NlgObdDabteDdf4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZWyZiOgmW_TwoQ1qfHCUdbHazb27BkYN5Y8d7pOHEYw&oe=6A31516E"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAQvyy2NBRMQ7kNvwHsqjm_&_nc_oc=AdoTPTCNtM8BluohAurPccvk3wxZInI2YsboMISvjyIq4ACTVXrl-P0Bgnu3xmO8kps&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8d0AyGRq5EVW3no6CfGgYTj-5PIRLlWMqQXAVpj3eD3w&oe=6A31533D"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=As89T6Kz6OUQ7kNvwHBCa-8&_nc_oc=AdqxiYPVmOmq9KJZKI35HLcS8uq5vKsRxGt0lYHEsCg-fGj006cWIysCcXKqr0P5uEI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FZqvVyFQwlpcw8kA1ORl6A0i_hMe9HB3TutG1FLXLVw&oe=6A316703"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
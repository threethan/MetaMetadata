.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PiK0yHypTzEQ7kNvwGIdSLD&_nc_oc=Adrz0YTCIqHzlIrUdyzv1fTYIwlt3QRhNJUnRig4_1Znypp89jpJSJ9oBKqO8sQdY74&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyvhfaySrJAPo6NYxbvm8Qdu_0M33g6cKJRYHJhDUG4fw&oe=69CE7C4E"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6b5KmGJ__wQ7kNvwGjKXrX&_nc_oc=Adp-vHq7qDToUjMM-xgDbKZy6p8vHYcRB7PLFgIIVNrzHDSiXaW_ctjDMkP6-u7CyGM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxlL6XspeUrssXYRNk5xbxFTW2GIJ3HHVqZLlQPhYTP_Q&oe=69CE6D4A"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_tn_otnCFkQ7kNvwHTmfIo&_nc_oc=AdoLjh-gp0VvxfxflGErBTZRWGy9m0hAQruZYAkQkw4StALRfEzKvsTjj5Emtn7WQgk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAs7BpOdrJ9OXC_D26e4rR4h6SUMi_U_pzzv-71jPpnw&oe=69CE70EE"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPej9735rWYQ7kNvwGbb3OD&_nc_oc=AdoTHHTlT6VGDVYPU41dhUHX0yIPxE1NnPORY3PY3k1SPXHsjE7mXLRXE5c052qKPAs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJCzquNTb805tfKPwl7ATz3P1nLRbis8XNSuwDGomO8Q&oe=69CE72BD"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUJ5ksrUpOkQ7kNvwFkbK-z&_nc_oc=AdoQ2-06NQbcrCHsF8PlfAMWsl2et9-PwOQIn_SsdlmgpHMG5jyhxPLtfAczwKlWAaI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyi9GWoG2AQMZgbap5kZ29EGKHY6cfUE4cw0PM3EOBm9Q&oe=69CE4E43"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
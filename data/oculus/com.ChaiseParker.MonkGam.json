.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Pl37POS7jAQ7kNvwESMOc_&_nc_oc=AdoJjIOF755pZpxD5uWhALOneZ-ZJPOAlKw4pArHWjsz0XTGkpA71Ri9XNvLX4GT9Tg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2GXCq574Lee67KuDpsF-O56PD5Rr0_DKqDsJQs6Gm7Q&oe=6AB6844E"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbO1HcM0mb0Q7kNvwFvUC0_&_nc_oc=AdrGzKoJJAMxgM9Tt6drmJ3HtKrthg9F9AGdR74W3qirYSPPft0II5hbNh1JEDEJUEQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNkYDCIlS2qnLxRkezh1NO9Em_MjlXplN_v8srWyYZwg&oe=6AB6754A"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcSiWNPceT4Q7kNvwEq6VfM&_nc_oc=AdrJJLQ4wxqAJG09q1KPSMR5DKM6wZT3euzdnXP1tmPR_Xl-yNGx4atj2s89AhTRPV0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiej776YSwjzAKb5uuQ8dYeZr8aDCGU2XhfDoo53FxsQ&oe=6AB678EE"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IW4CnctE6lgQ7kNvwF_qIAM&_nc_oc=Adqcx2xzbJl79DTyZ5AJz0kdu3OnN1InxCzuUG3STSBQB5IHsSAQc6l42RUkpEbfd5c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXxY_c5o8vTFttnb8QUinDN9r6n2ZJaEBEaRld81ZR3g&oe=6AB67ABD"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=To1rQ9nd02YQ7kNvwFYjbbs&_nc_oc=AdpcCEQ23n1E__0VT_FIJwq_0pNFKDoZw9l_s-5d6ueDVX4Kbq9BPNdOm17MiAikiAk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJB9CcwAXcuF59xnw7gXwowReUDJA6OGDPUE5kjZp0CCg&oe=6AB68E83"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
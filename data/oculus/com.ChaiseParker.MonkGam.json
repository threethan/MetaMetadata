.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irn913T0I0sQ7kNvwHDwWzv&_nc_oc=AdqKXeJJ2f0M9pdiJ9FJMBW-9GjJ6rl9wYDHqDS0aLr3CFrHh6wPu_w0dzGYa6D2sEc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBy5l-Vfx6GcpBj6uwbqHsOkCCKNUGD4lc8nImCVNWsnQ&oe=6A4A694E"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXRq1QfD_NsQ7kNvwG0YKi7&_nc_oc=AdoStcidqfT6wjlHcHoSs9PkFmoDa8rYNVL6STEcBPXjJi7lkyJarR8MLxARKt7Ib5Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYaPWn02SBnYZyh_SOm61Watjf5-_dkZ7i816iwm0PXg&oe=6A4A5A4A"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdicBaY0038Q7kNvwFDEkFL&_nc_oc=AdrxJ1s2t9kqLZJagafrQzSR0SbNtMrTREA4hjMrtTp4TLsWU0L3THrGLk5EQJDPfCk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4zCIygACxxq3XZtA3iqolwjnv0ehZgDc7sliM9IJOUQ&oe=6A4A5DEE"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0d4pIoz4nWkQ7kNvwEeFlEW&_nc_oc=Adppr7OtIhbjra8_RlmTOViTpWgbQOELSyoTuWf7HfnvQjToNq8wIZmtp4Y9QDqtanw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvglVW_BLtAELXZ5o_ZTkI3_lnW_VWEgMevuWfuV2W5g&oe=6A4A5FBD"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jttVHEB0c0Q7kNvwHggaFy&_nc_oc=Adp3gf0V1hwERp0PhK8J0Qf1stfmUvWfyDJjkSGIRZ33dOb8X9x16SBnNvRVG33rihA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAe7ckI1W4OA-TiE5CFCDkKYCay7GmWTNB0LAElHMV9MA&oe=6A4A7383"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
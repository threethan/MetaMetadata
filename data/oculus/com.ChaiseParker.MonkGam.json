.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFenJ-chNs4Q7kNvwFTR8Bq&_nc_oc=AdoNnhLUmX4nnj395nccs6I85yiTr8qu-MfSb9Vu_mY71xU879Kv3zrrI-JvCO20_G8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzlq--WCV6Icc-eWrBd7Xu_DE5AlJkTjIUQLtgbGTXUQ&oe=6ACCEDCE"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fM15mPa4I6UQ7kNvwEI7upq&_nc_oc=AdpuwL4i7ooaaZeZDSEycxjDXx3Cce_FW3bMQi6uQKeGwAskp2R2a0f_X3PHxNDN1S4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxwhmfVmHG422wVzOla-0vkFfDvKGAsuCJR9RICB19aQ&oe=6ACD170A"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a49lxHRwCzkQ7kNvwFKPsuo&_nc_oc=AdplBMdwSf4x2kMo9meIMaYTLt2QrUtTeyHG_3Q5hr4ZSyCwAPDcp1gBsImwvVcAIQ4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOszZNloVymIQnRKlcjamVQdh6B3gn2Dzqf-RD0XJM2pg&oe=6ACCE26E"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xChVugRXsPEQ7kNvwHEUzAT&_nc_oc=AdrG4ZHGC-uKrUE5ICUEXDyjcyxFcG68QJg4C7tY4iC3YlGrTYTD5sl2FocyGoa5N1U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOr4ADeHNVaMnSqC_J1rPSY2zIl5Xm4Qq_6pSdZBWv1nA&oe=6ACCE43D"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jp0YJ-RMb44Q7kNvwH3nkNR&_nc_oc=AdpV-DxI6HyPbqnhYui0VIOlxa8aCYMZT9icI1f9kxe4aZMyz73io3xeDkAmrvsw2rQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.o
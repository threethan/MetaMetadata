.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sThfeKTnTy8Q7kNvwGHDz8P&_nc_oc=AdqpfHaTWU2zSdNiHuMRaIMaTqRZP9XLfubZ-MLXCPCphFCcML7yIGvyYxDzkB7z-34&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DCqaukXAwNDduw5xo4XDSCfsePgC0nYvYLmac2K0BtA&oe=6A3FDD4E"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OgykKSVC70Q7kNvwEUZHjL&_nc_oc=AdoLt8hE6mEBoQ2L-7T4299jnykYJs7rGgxjkoHu6apGwkMiBndqWA57ntfHllW_KCw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-n2FvCGiS3furingUK2a70BjPueeB9E3PWKsjzMJUsEw&oe=6A3FCE4A"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jLPhKpQlq8Q7kNvwHYXMpj&_nc_oc=AdpR5qbQZal8fmq9jL7uygDmEwSwKdV86e4TOJ079V3cNh6NLK5lgkP2cG27MaAvwag&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GgK3k1WjrA8S03rjlty0hQj7PrYXrRATN-eslgJj9Dg&oe=6A3FD1EE"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bH0oxx1OZ40Q7kNvwGcbSXQ&_nc_oc=AdoR-P5lHcE37is3hhMLBsNSSs8X3YyiWYr-CHBo4Bqe5qYrHP0lv2i-cC0lDmp0ifg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6dfxjexg6ZKvWetLeFBlL28BGmgqJ_9qdENMKMfrjgQ&oe=6A3FD3BD"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CILsWmOFSUQ7kNvwF6sTJC&_nc_oc=Adpf8vHKerCCDfr3TRJgdxZNGNQIFLpgGk1099F1TtSxtNlbM6qk7CVqGa3BL471iZg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mXb6bF_nAiDDGXtGVI9Qf97EKfI85jPdKT3YAoSFAXQ&oe=6A3FE783"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
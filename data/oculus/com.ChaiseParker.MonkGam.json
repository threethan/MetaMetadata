.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMTPPlUzViwQ7kNvwHPG2AP&_nc_oc=AdpVDczqU_0m51caLkzBQ110W2a1XzhGuA26tHoYrqJmXD5L2hg3g0dkFHDhUxfLAGU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VNmsPncgFO2PAd-a2y9w5nI74anURBxJYTHmKgjaYGA&oe=69E0F14E"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNGw9YgQbfoQ7kNvwGXZQAq&_nc_oc=AdpzKjmbVuj9amv3inm0kQyx53H8W0R6EZ58LIUEX-L8K2AzHZB1ZbRDX9FmMacQYwA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0U9SSUc_c80t8RPcYJQpALLbjUyyxwNvNtggVysL_D4g&oe=69E0E24A"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iChA8kUlndoQ7kNvwE4GDoS&_nc_oc=Adptotv_xs4ezE4fbKZRa0qraSxZaR7AvCb_WVRR34qYlKkA2dIPVk_Na-mizNaTPFY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yz_AJv9B48se5WM5z5JLsxvAAuemF-sG9jI_2eb3Ufg&oe=69E0E5EE"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCV-yLFEbkoQ7kNvwHWsCsF&_nc_oc=Adot4QEs4qLH44PDLtUgysH5Xrs8cE0Vb_XZ0mcEJGFrQzVUVJ0isC93IadWmR05qrg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3x7D0rAjWkwQVTqev7MxY1GZQbJ-z9vuEFKDSRm_D1qw&oe=69E0E7BD"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tf3FDCc-JlAQ7kNvwHHPpJW&_nc_oc=Adot_MjLqxaBE0TYC5xAkw-Zu6El7Z5ocCDGQcbx1O8vaqa5sheLBb_AyHvse96F7yk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lQzkCpelsGD1EUYfD7fRWjDqZrBbqE7kYbb7FlP07vw&oe=69E0FB83"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
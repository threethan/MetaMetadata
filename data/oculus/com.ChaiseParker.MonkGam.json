.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1_E3UfVW8YQ7kNvwF2j_KQ&_nc_oc=AdqK4jT7E6HZouflfiCgD_9Lf6-LC6NCPAtC61ovUCqxBOzFud3ELID_bH7Q_-txsHQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xWTYChtJC1zeC5Ue9T3pc4qVK2e1DOX1J2ISr9rtctA&oe=69D6654E"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GF7tpd9a524Q7kNvwEVnSEF&_nc_oc=Adq4QQ5F8CZGe7xEhJhfbdfVMgcHJW87U0DNPkWZjbJXyNrSV54FGCziStYY0LsqU0g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CYsbsFTHSeW0AEq02DKofm30L-sx1W1EGWE_Py6-LlQ&oe=69D6564A"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dF2G7hxeLMQ7kNvwFpu7lg&_nc_oc=AdoOBGF3wCRWu6d0Y-1eDhM33vPQVntWc-qZUxuln-2LtGms_9BaLpqlQkA9wQdUQkU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cQy0nM3ynum2QP5byD92N6Qi3lwH4IBCPZ80OqJoMmg&oe=69D659EE"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ui6ilg1cys4Q7kNvwG5w6MG&_nc_oc=Adps7fbUznzeFQ8YNjrqepFtn7wnPrqB62Yst-HEQwWDclgl22EwLtkVyahJQmax5f4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2k6nXY5bFYe_pXSXc6KuGLRnnYrf2wCISBzCYT3s8AIw&oe=69D65BBD"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLasuD-ZhZcQ7kNvwEU8jJ0&_nc_oc=AdonivOUxoX-TqlbdQ1WTDhs-M2E4TV5T2GfPxfrzHcoErI50G8Hej_Go8uNcVwyHVI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18gxs0Xt8gQZJtlqZjUUV1WpGOckW5SlyT9x4BCKNvmw&oe=69D63743"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
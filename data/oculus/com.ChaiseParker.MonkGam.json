.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOJLlIwb9UAQ7kNvwG-PUo0&_nc_oc=AdrpJ5Oc6nkGN8UUOvOqI6yAbBNja6c9WV5q0nGxNEkHKhrd0869lVlatKTAY3bMVxY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Yp8eZtMSURI2iKgITksN12Feq6tiY3cGvr9wk56EfVg&oe=6A28224E"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkQrWE2eHgYQ7kNvwHSHc3Q&_nc_oc=AdrIiYEfOAIct753t8p944RBcu9QEHo80lE9lIzOEwPjTvA_CX4UVjJRDH1NFL6UfNU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qECa3jkU5kWtm7A1zjuuZN2u50mbGa2kPDh26Ybg54w&oe=6A28134A"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0r-w7b8HLcYQ7kNvwHrTO29&_nc_oc=AdpvdHVgRj8AuLvmwbxL18CKe14KKtN9cXTw3DLxIU8uosqOC2sAYm7Oe09v3Ajxn8g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sgDY9bFyPUczFNuC9kLhdnxBAJwapOj5lo6CnSPfylQ&oe=6A2816EE"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpbPqoTsJMAQ7kNvwE6-lP7&_nc_oc=Adok2zNFxWnCu-JdIssljKqEbodmaW2ZRN-jhjdoJ8dazzteY9LlbTwckjUD_YrIA1Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wlxbjuoxZFdSj-mA7rOGqaC389RA-LbEqkESZW3TMJA&oe=6A2818BD"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsfDzZap7vkQ7kNvwFEZnLS&_nc_oc=AdrAS1PmNm7f6hL9Qa_eY2iw7xq3elXliixhvcibpmy0wCY7QC3PF44CaP6hg9Ki8_I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9A3aSWlsblw4CF7-FYfpY6fAA9OisvNhJKp8e-ODLT8g&oe=6A282C83"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
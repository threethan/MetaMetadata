.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3qOdRjFTk8Q7kNvwG70ktp&_nc_oc=Adp_O1dbSLw7cmud-rgNqBNL9oVzqUIR1hP9a20RCAIoI507-dDrNT4hrb3sdMV52eI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DT9NaOVPR9a9PwAyfvJ-TAMpcpW-Aw5a4a0uLVPks6A&oe=6A218ACE"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVI7hwGsueAQ7kNvwGkx5gA&_nc_oc=AdqEqjEqzciijnN5Ba-xOvxJA4I94XgeV_cKDK5GfgZCHIaOVLs6MT3hGK-sdMrDu8M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yaAW8q4dbUQA06hiRclDdsmfaikGaOZVCIKOkR88xAg&oe=6A217BCA"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_J24v_n1XrAQ7kNvwHpkyxE&_nc_oc=Adq3hhnLinKntWpm_0n0DcZaFAoEawzzgEqawfwWhdFxiDOBDL4rwzGrzZSY9S0REcE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-d4uvnisYVO1Oc2XjGld4DyapUm5EpCImWuR5USasS_w&oe=6A217F6E"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dekWrRZiGqgQ7kNvwE3hRZ9&_nc_oc=Adrhj_1Gb7ozf8b6uJfQ5Se_f3uDYKAwzzGhySUbY0wSYuEiazseCg0NpQdvk3lLm1s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WYcrbVJqWXBWvyARibLNcwsQ7N9OBkBSFaHYWFmkjiw&oe=6A21813D"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGI52GOcJ94Q7kNvwH_VB9t&_nc_oc=AdrjdizUK15V7NKCvx4BlgiGCXX-GiXR7JsGDbj0JZmiqFdh2txgzxltf0t__SH4ARI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98WrNOh5qcXN_aj3XXbEVV652jxjRRYB0On0ZnAS2ijg&oe=6A219503"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
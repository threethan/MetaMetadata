.com/v/t64.5771-25/39003273_304405948848904_67215033701319489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckBcwQ0mUPAQ7kNvwFdrWHt&_nc_oc=AdrRsMV5idhC2fjdSG8cyW6i6JZLk4WYFYTKi5F2x0TAMliYNqzFp8h9Oo5Db3UetDw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHLg7gvHQM_zv78yUOV89kNGZ7nr5PlbeFlHPnjnXocg&oe=6AC1104E"}, {"file_name": "Beach Ratio.png", "id": "1524699001612558", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230046_1524699004945891_5534875263859813941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uPh2W75nUYQ7kNvwECj8Qg&_nc_oc=Ado5C31Qdf_lJDo-q61ELFMCdi3Ati6svlF2Xrx1Cz3soLfiDmLXFYEYejwbVzqSW34&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQ86cZnDlxxUIslnWZCajjv4WEn4l8RHnE6As--cqx_w&oe=6AC1014A"}, {"file_name": "Grav Ratio.png", "id": "222432490452671", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974750_222432497119337_6382718653884332988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAcyjEm9YFAQ7kNvwEZeUVm&_nc_oc=AdrSEpKASXlmBkT_UJwKRR6XM6M5PbM6IXt-FGSu5XQJoavf1Al4tJNg4Bavl9LrfDQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5HPW82-cBgCDSY9kO-E5Z39XhS2W7UP_hn2ivwdspfg&oe=6AC104EE"}, {"file_name": "Shop Ratio.png", "id": "295942623081584", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982481_295942626414917_2400093366669453789_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=462Smw_8MREQ7kNvwGA_zEU&_nc_oc=AdqUGp3k1lvQQfA52xxUHkzGBIO97l8PGnOagz4lid0u7lUp1PSHE7CIKwi0wh3Chdc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPgP2DNdIA3Rg6C7-tDDP4RomosCUAAal3UaOdKvIm0A&oe=6AC106BD"}, {"file_name": "Water Park Ratio.png", "id": "311131768065302", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001659_311131774731968_4951174306301394732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hw1i6KVMZmAQ7kNvwEirRg5&_nc_oc=AdoTX0PPw48C56pXfhO3Z4OmUNFkXaOcC21W680oZIGVx_7N41531W7zxXJEW_d-dxM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVS9UFXEKV4aKCX1fWw7J5lEJb9KFUqhfATzVSlWk1Dw&oe=6AC11A83"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkley", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/monkleys-website/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1366340120947484"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
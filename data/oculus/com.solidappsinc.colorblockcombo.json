za_9uAL3tUSvhz66GqY_-7wRGqwH7uaNOLeqDkjSFgY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83eeMRi5poMrkEMVZMsJfXZ0TvVjSM41SHtSXDS8SsWg&oe=6A39608A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "661385533538411", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473393491_661385536871744_4114205476350948819_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxVT9vZNHDUQ7kNvwH-97SU&_nc_oc=AdroWatkh-Uk_I2Yzo4LY6NevGnFtDKUrI0TtL54SsvlhWysiYeaRz4aEHX2KgDs6uk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CUdMnbqDFhHZYYLNMrbqR84qZTzfN7IaVDI1ZzkYXHw&oe=6A3956FD"}, "display_name": "Color Block Combo", "keywords": [], "long_description": "Color Block Combo reimagines the classic block puzzle experience for VR. Feel the rhythm, see the colors explode, and stack your way to greatness across dazzling worlds. \ud83c\udfae\n\nFeatures:\nImmersive VR Gameplay: Precision stacking meets a mesmerizing audiovisual journey.\nDynamic Combos: Chain block combos to unleash spectacular effects and climb leaderboards.\nChill or Challenge: Choose between relaxed zen mode or pulse-pounding competitive sessions.\n\nWhether you're chasing high scores or seeking a hypnotic escape, Color Block Combo delivers a deeply immersive VR puzzle adventure like no other.", "short_description": "Dive into a mesmerizing VR puzzle world! \ud83e\udde9 Stack colorful blocks, trigger powerful combos, and lose yourself in stunning visuals and immersive music. Master the combos \u2014 unlock new dimensions of play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://solidappsinc.co/vr-terms.html", "developer_terms_of_service_url": null, "publisher_name": "Solid Apps INC", "support_website_url": null, "website_url": "https://solidappsinc.co/home.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES
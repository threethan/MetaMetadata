5.png", "id": "1386351705736642", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393328_1386351709069975_8584559853304368863_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zfE5J9len8Q7kNvwEPbSXe&_nc_oc=AdqQwRXc1SVYLOHO7AG1OktGk4FhVSUEP5yx7kHM5n72Av9FAWdFEHCI8ZhCK3NrazM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6sqKDVFxoE0qx12LmQHTxEM6E6R1xZJTYCNHUmKKy6w&oe=6AF4958A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "661385533538411", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393491_661385536871744_4114205476350948819_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDEcJrj-sLkQ7kNvwGVgn6G&_nc_oc=AdougqjJd8SYw6ITvWnolshFhtczhJO_LDxxmpybbAI1p1z6P1XJ30Obdg6Ih5jJcPY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStLzofKDMQhzcRR4k8NYvPohWfvi7n8YD4opTmF-O2lg&oe=6AF48BFD"}, "display_name": "Color Block Combo", "keywords": [], "long_description": "Color Block Combo reimagines the classic block puzzle experience for VR. Feel the rhythm, see the colors explode, and stack your way to greatness across dazzling worlds. \ud83c\udfae\n\nFeatures:\nImmersive VR Gameplay: Precision stacking meets a mesmerizing audiovisual journey.\nDynamic Combos: Chain block combos to unleash spectacular effects and climb leaderboards.\nChill or Challenge: Choose between relaxed zen mode or pulse-pounding competitive sessions.\n\nWhether you're chasing high scores or seeking a hypnotic escape, Color Block Combo delivers a deeply immersive VR puzzle adventure like no other.", "short_description": "Dive into a mesmerizing VR puzzle world! \ud83e\udde9 Stack colorful blocks, trigger powerful combos, and lose yourself in stunning visuals and immersive music. Master the combos \u2014 unlock new dimensions of play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://solidappsinc.co/vr-terms.html", "developer_terms_of_service_url": null, "publisher_name": "Solid A
0YQHKgKautYwSWglYj0p5F-Y8L62ZLaCbxaBmVVw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzfaoNKYoWtrVdjXTHp-azefUqAN41pdzKy8ZfNsEx-WA&oe=69BD542B"}, {"file_name": "ss3.png", "id": "1523586531739344", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75540503_1523586535072677_554244124604331332_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaH7E524V0gQ7kNvwF0A0ZP&_nc_oc=AdkbCv2-g6jYWIDQwQgINKEM4eLrNWOowwni9wyxAr4XoNdAnMdg6u__D0WjEQSO4Jc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxmUmKMAWOElv1JqZooGR69z7JnqerJ9glrebpS3AVgeg&oe=69BD3A89"}, {"file_name": "ss4.png", "id": "287361020823261", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57568684_287361024156594_6321629804379123126_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4S2bEnoilOYQ7kNvwEuT4Vv&_nc_oc=Adn4VeP_qu9d95pYbuJYLxhW5k-34WoTNfKWA8X9Qahm-XeBQI4laxe0OJy93XKtQAM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxqL0b-BL872FSPQfeXAfTwRhAUBMbXsK9g2w_BGgXJPQ&oe=69BD589C"}, {"file_name": "ss5.png", "id": "217044561372189", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035396_217044564705522_2329637064441792377_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clIf_unrPXUQ7kNvwHVL9eX&_nc_oc=AdkwCOpVNt0Dhj72zTnHSX9Xedrsvq5F1rSV-tNEQ48SqXcQXU-wfBlXLe9gGU-TOds&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzd48C5vOO8Isw-mUSdHrbBm8T_lBw4F-lHhbADjDQEBw&oe=69BD5260"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBOX_CoverTrailer.png", "id": "680194554042786", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001706_680194557376119_7857106052663886372_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8djaxgV1KU4Q7kNvwFwxfu1&_nc_oc=Adk_wWZIVa0rfStV9PHdFge0e-CYRXWhfFbiBzOZnejXdAHuypkyw9inZRtIfoKiaxo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwc3AcSP6v0lCucCQZF4ST5YhglJSLAym2ehTPddutaPg&oe=69BD5829"}, "display_name": "VRBOX", "keywords": [], "long_description": "VRBOX is a sandbox game based on Radgoll with euphoria style, shooting from weapons, and gore.\n\nThe game contains blood effects and splatters on walls.\n\nThe game doesn't include a story mode, which is not planned yet.\n\nFEATURES:\n\nSandbox mode: you can create any NPC, such as an enemy NPC or a normal NPC that can't damage you and doesn't have any weapons.\n\nWave Level: In this mode, enemies will eventually spawn, and your mission is to survive as long as you can.\n\nClear Mode: In this mode, you have to kill all the enemies in the area.\n\n\nThe VRBOX doesn't have many weapons for now, but I'll update the game with new weapons and levels.", "short_description": "A sandbox game based on ragdolls and shooting"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/15FFzkA-9mcaz6qIIRLM0owTb2iC9zYFhljUh8NMwcFA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Level Games Studio", "support_website_url": null, "website_url": "https://www.youtube.com/@levelgamesstudio3671", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7533650366658029"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031395_844664237250129_2410704372108623958_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a
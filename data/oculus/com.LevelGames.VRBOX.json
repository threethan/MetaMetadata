119_7857106052663886372_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGyne8pPHQQQ7kNvwFJYl77&_nc_oc=AdpKfaZcmLvAplo-OYV9zVIuCRsebLrvj1q8Q9nolm5Rj9utvd5ztHyOSKeD57aPEa4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWZTTQ8doKdFxdPi_Qypvfix2ur3XUSYKFBgKuy57S4BA&oe=6B0F1069"}, "display_name": "VRBOX", "keywords": [], "long_description": "VRBOX is a sandbox game based on Radgoll with euphoria style, shooting from weapons, and gore.\n\nThe game contains blood effects and splatters on walls.\n\nThe game doesn't include a story mode, which is not planned yet.\n\nFEATURES:\n\nSandbox mode: you can create any NPC, such as an enemy NPC or a normal NPC that can't damage you and doesn't have any weapons.\n\nWave Level: In this mode, enemies will eventually spawn, and your mission is to survive as long as you can.\n\nClear Mode: In this mode, you have to kill all the enemies in the area.\n\n\nThe VRBOX doesn't have many weapons for now, but I'll update the game with new weapons and levels.", "short_description": "A sandbox game based on ragdolls and shooting"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/15FFzkA-9mcaz6qIIRLM0owTb2iC9zYFhljUh8NMwcFA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Level Games Studio", "support_website_url": null, "website_url": "https://www.youtube.com/@levelgamesstudio3671", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
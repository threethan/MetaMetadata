content-iad3-1.oculuscdn.com/v/t64.5771-25/39035396_217044564705522_2329637064441792377_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqzgKdxIcewQ7kNvwFu4xj4&_nc_oc=Adk78zMeCiNF9ZzTtsDBTu9e7pSrVT6a8sEtVBa49X_J81c0_Iekc1QbQ0-DlcB3Qc0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu9kv-pYDBmYqSwq3VCSMiTGVGz208tUl8VOZGzepLkdA&oe=699DAE60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBOX_CoverTrailer.png", "id": "680194554042786", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001706_680194557376119_7857106052663886372_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5DaUA6IZeMQ7kNvwGHNsTG&_nc_oc=AdlKHXZwgh4x4oQePJF7jnnGcuwuukR2NL3PELtj6mGKrJoII7NI8Z02Nuy0dtTajHM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv3AR2bPOgFPdrvDCbTPHYd3W_A3QHjgfY-pLvIu2aqmg&oe=699DB429"}, "display_name": "VRBOX", "keywords": [], "long_description": "VRBOX is a sandbox game based on Radgoll with euphoria style, shooting from weapons, and gore.\n\nThe game contains blood effects and splatters on walls.\n\nThe game doesn't include a story mode, which is not planned yet.\n\nFEATURES:\n\nSandbox mode: you can create any NPC, such as an enemy NPC or a normal NPC that can't damage you and doesn't have any weapons.\n\nWave Level: In this mode, enemies will eventually spawn, and your mission is to survive as long as you can.\n\nClear Mode: In this mode, you have to kill all the enemies in the area.\n\n\nThe VRBOX doesn't have many weapons for now, but I'll update the game with new weapons and levels.", "short_description": "A sandbox game based on ragdolls and shooting"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/15FFzkA-9mcaz6qIIRLM0owTb2iC9zYFhljUh8NMwcFA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Level Games Studio", "support_website_url": null, "website_url": "https://www.youtube.com/@levelgamesstudio3671", "category": null, "comfort_rating": "NOT_RATED
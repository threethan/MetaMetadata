vwEzS2-2&_nc_oc=AdqrGeQsFsZBo8npfxujj7MMRcpkoDiKGAgwpirGDZCg9YxEA-Uo5zT717_tRApxtl4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGh18lTtnVoo_BuVaIY1KrXg1SMfOyAGIR1k2tN-3IZfA&oe=6A8EF2AB"}, {"file_name": "ss3.png", "id": "1523586531739344", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75540503_1523586535072677_554244124604331332_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D-Re0TRDX8Q7kNvwGGur_t&_nc_oc=AdpsAL4qFJsXtGou_PtbJWFb2MagGRlqgi9HLciDPZu7PANoxI59Iww2flnkfYBIqME&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgwL8BiqssUe60WDsXyYO_viIEsgIi2UUXDPGRmNZVtw&oe=6A8ED909"}, {"file_name": "ss4.png", "id": "287361020823261", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57568684_287361024156594_6321629804379123126_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJxURDSSIWEQ7kNvwFpYa9M&_nc_oc=AdqKPp-mTVHwKZrBOOmhioaxmwhWxDBswNQxi9GUhUxtmoDz4zOtOtH1c62SGN9KzK0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELJ1_MYK2yBZZetWQ7_qIksw5ah5uysqbWOXyPP8CACg&oe=6A8EF71C"}, {"file_name": "ss5.png", "id": "217044561372189", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035396_217044564705522_2329637064441792377_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qa4cXSN8n24Q7kNvwHdBYKG&_nc_oc=AdpSZtbh5PvGolieiBLWvrfvhbSooyC21RMWTEwvFNjy9n57UeoMjEyatwZPb2cMBGY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJF8JfhTelBsUwwIW_j4BbnSRTBlI7sOt7-uBXL8hzhg&oe=6A8EF0E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBOX_CoverTrailer.png", "id": "680194554042786", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001706_680194557376119_7857106052663886372_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQkffrZFrscQ7kNvwEhFYH2&_nc_oc=AdqyjiRGlwvBEW8pDIC6DOKTb6k08Z4i_bAC54y07LXmBwyFmvBoXxaeAtI1tDFvlGw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYqhCOqDFPaOmq7lolFUzbWIN6VjVxjT5Xmw5UHYP1ig&oe=6A8EF6A9"}, "display_name": "VRBOX", "keywords": [], "long_description": "VRBOX is a sandbox game based on Radgoll with euphoria style, shooting from weapons, and gore.\n\nThe game contains blood effects and splatters on walls.\n\nThe game doesn't include a story mode, which is not planned yet.\n\nFEATURES:\n\nSandbox mode: you can create any NPC, such as an enemy NPC or a normal NPC that can't damage you and doesn't have any weapons.\n\nWave Level: In this mode, enemies will eventually spawn, and your mission is to survive as long as you can.\n\nClear Mode: In this mode, you have to kill all the enemies in the area.\n\n\nThe VRBOX doesn't have many weapons for now, but I'll update the game with new weapons and levels.", "short_description": "A sandbox game based on ragdolls and shooting"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/15FFzkA-9mcaz6qIIRLM0owTb2iC9zYFhljUh8NMwcFA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Level Games Studio", "support_website_url": null, "website_url": "https://www.youtube.com/@levelgamesstudio3671", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7533650366658029"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031395_844664237250129_2410704372
CDd2h&_nc_oc=AdoPuxzKx1Orbtr_3ylsRAktayhihp1HJe1WdFE6XoF--jGhPwxyPyVFs0WONMThi8k&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9wn5y5qYJHx0Evg44hIfY65xV_5MbXirivtf7BYY20g&oe=6AAE96AB"}, {"file_name": "ss3.png", "id": "1523586531739344", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75540503_1523586535072677_554244124604331332_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feiCNDoZ5o8Q7kNvwEn_Qpe&_nc_oc=AdqW0KD-rVM6VgAWwwmsTjil_pOs8vRTQPRqUOCfpf6Z3ema2uG2rNVFiN8u8A9Nas8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKN1S_7DbXe_SuyAcLhGudbV2lyzxICB46LaQx3722-1A&oe=6AAEB549"}, {"file_name": "ss4.png", "id": "287361020823261", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57568684_287361024156594_6321629804379123126_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YETmKptcisQ7kNvwEnRzxE&_nc_oc=AdrBkR6HvLt4GCLCZ_jH73nChUAGSoLwhhyphN0HTIv_YNvOVO2t-1bDb4owHqj_r5k&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ09FQFC99vIe8otfCCXE2JKUn8vPkurbdjhoOKaoPF6g&oe=6AAE9B1C"}, {"file_name": "ss5.png", "id": "217044561372189", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035396_217044564705522_2329637064441792377_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTjpvRYyVKEQ7kNvwFq5ylo&_nc_oc=Adpp8d0YeQ0TuP4_EY57mNIvYfYyiDjfKH-6TgRO-qmsKdK8g78F-HGQgsEuytc4uWk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqu-UY3LM3MI4Y2eVb-e2ZazOmPHGZoS4jSX_LtCnE5g&oe=6AAE94E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBOX_CoverTrailer.png", "id": "680194554042786", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39001706_680194557376119_7857106052663886372_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzSPodiiY3MQ7kNvwHtGc-d&_nc_oc=AdqI0OIqGEBOtCuGZDkx-tCz7W91WCxeX4Jkada5DISbGmYtFfz9GjjMYhHCpmqhI1o&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4Yu4aArCdWF7YQvb9atwneUtgpIRaM38qzoow4xJgEg&oe=6AAE9AA9"}, "display_name": "VRBOX", "keywords": [], "long_description": "VRBOX is a sandbox game based on Radgoll with euphoria style, shooting from weapons, and gore.\n\nThe game contains blood effects and splatters on walls.\n\nThe game doesn't include a story mode, which is not planned yet.\n\nFEATURES:\n\nSandbox mode: you can create any NPC, such as an enemy NPC or a normal NPC that can't damage you and doesn't have any weapons.\n\nWave Level: In this mode, enemies will eventually spawn, and your mission is to survive as long as you can.\n\nClear Mode: In this mode, you have to kill all the enemies in the area.\n\n\nThe VRBOX doesn't have many weapons for now, but I'll update the game with new weapons and levels.", "short_description": "A sandbox game based on ragdolls and shooting"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/15FFzkA-9mcaz6qIIRLM0owTb2iC9zYFhljUh8NMwcFA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Level Games Studio", "support_website_url": null, "website_url": "https://www.youtube.com/@levelgamesstudio3671", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7533650366658029"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031395_844664237250129_2410704372108623958
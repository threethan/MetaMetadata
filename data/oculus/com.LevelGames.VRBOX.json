uut28&_nc_oc=AdrVr_SrccbigcXz5iVSi33iCR22o24Vjc4q5jBTRbiLq3rE5EJkZUEI6xCK8YrXMfM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgmRJhDh81Ss0Y7rsitDovBBuHEmfPZ7bcqBC8KlHKPA&oe=6A7DCF2B"}, {"file_name": "ss3.png", "id": "1523586531739344", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75540503_1523586535072677_554244124604331332_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoyWrirGUeAQ7kNvwFssoSs&_nc_oc=Adqtm3Vsgb0LRxAXlRDODQH3mutCSB75Z0JcgdnY9_9pDWz8RvOVqJaJI0p-SPWELno&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKkRutHunZdIU27p5vsnjgZpp60nne68wHr0StUKQnPQ&oe=6A7DB589"}, {"file_name": "ss4.png", "id": "287361020823261", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57568684_287361024156594_6321629804379123126_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iV1hEho8BbgQ7kNvwHVwVNy&_nc_oc=AdrmOVcplKlJilPTyfmedaBkSULE4fFRaOZ8HnVRSAN9Y3F3No4PnGIaeYZTHin-C7Y&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMAuSVD9JPtrXTVs3VWe8ZZAgZeZsYnMg7TXLu17ljJg&oe=6A7D9B5C"}, {"file_name": "ss5.png", "id": "217044561372189", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035396_217044564705522_2329637064441792377_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKEsOIDFuzcQ7kNvwHCCIEx&_nc_oc=Adqhc5OYZyqCT7bcbgrxw83VuGe5P7E6hVcaLanYkCvQCo7_NaTWYxxlw6k0OQIUXwk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjm1UOhbsDJKXAiGjh50Tf1-BDiGrMHmnKXUqvXaioYA&oe=6A7DCD60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBOX_CoverTrailer.png", "id": "680194554042786", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39001706_680194557376119_7857106052663886372_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcNNBaFFXvAQ7kNvwHDqr_b&_nc_oc=AdpMnbBe4PkbbqKhqOBnT-6ifVWHesBS7owCaVQRDRNKkUHSstxFJP2Q296TqwqCCWs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeo1gXxx3vy1RyxPRFDGz6HtDnifLqJvlioDmFui9Bcw&oe=6A7D9AE9"}, "display_name": "VRBOX", "keywords": [], "long_description": "VRBOX is a sandbox game based on Radgoll with euphoria style, shooting from weapons, and gore.\n\nThe game contains blood effects and splatters on walls.\n\nThe game doesn't include a story mode, which is not planned yet.\n\nFEATURES:\n\nSandbox mode: you can create any NPC, such as an enemy NPC or a normal NPC that can't damage you and doesn't have any weapons.\n\nWave Level: In this mode, enemies will eventually spawn, and your mission is to survive as long as you can.\n\nClear Mode: In this mode, you have to kill all the enemies in the area.\n\n\nThe VRBOX doesn't have many weapons for now, but I'll update the game with new weapons and levels.", "short_description": "A sandbox game based on ragdolls and shooting"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/15FFzkA-9mcaz6qIIRLM0owTb2iC9zYFhljUh8NMwcFA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Level Games Studio", "support_website_url": null, "website_url": "https://www.youtube.com/@levelgamesstudio3671", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7533650366658029"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031395_844664237250129_2410704372108623958
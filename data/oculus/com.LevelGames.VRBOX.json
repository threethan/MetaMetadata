content-atl3-2.oculuscdn.com/v/t64.5771-25/39035396_217044564705522_2329637064441792377_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8AZxs03nIQQ7kNvwH7TamA&_nc_oc=AdllWjDJCHktn5sghr-4SdMFUF12vjkWG4klAOUf6vnNRu97u79iVyg13n2j96htpaU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftdzpJjsae6Mho2YH_stGLP4N1vpdVCON2jHGH66ahSxQ&oe=69A59760"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBOX_CoverTrailer.png", "id": "680194554042786", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001706_680194557376119_7857106052663886372_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzedfpHhk0UQ7kNvwFHVynv&_nc_oc=AdlcsryZLm0dH9Was5KiWyPSKfpvxLL5p5RFL4XbYg156mSJ1sFAS2XS1oxfQESG2Nw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuQamLzHXAX4LMLgcWKYE8M3jqHecvFv3IchVW-YN8Mxg&oe=69A59D29"}, "display_name": "VRBOX", "keywords": [], "long_description": "VRBOX is a sandbox game based on Radgoll with euphoria style, shooting from weapons, and gore.\n\nThe game contains blood effects and splatters on walls.\n\nThe game doesn't include a story mode, which is not planned yet.\n\nFEATURES:\n\nSandbox mode: you can create any NPC, such as an enemy NPC or a normal NPC that can't damage you and doesn't have any weapons.\n\nWave Level: In this mode, enemies will eventually spawn, and your mission is to survive as long as you can.\n\nClear Mode: In this mode, you have to kill all the enemies in the area.\n\n\nThe VRBOX doesn't have many weapons for now, but I'll update the game with new weapons and levels.", "short_description": "A sandbox game based on ragdolls and shooting"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/15FFzkA-9mcaz6qIIRLM0owTb2iC9zYFhljUh8NMwcFA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Level Games Studio", "support_website_url": null, "website_url": "https://www.youtube.com/@levelgamesstudio3671", "category": null, "comfort_rating": "NOT_RATED
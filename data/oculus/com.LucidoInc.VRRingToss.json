8nPS98rMozNdTzjevb1ota2JihVO7MOI6SlwuLxKBI9KYRy9UeITWhyZEpbvk4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOG4lc5xH0X5dlZbzA1A034sQb2DpDkGA_RJeLvtAFCoQ&oe=6AD3B198"}, {"file_name": "New Project (11).png", "id": "1572391703418317", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392025_1572391710084983_4428980370928935033_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iu2S4jizYEkQ7kNvwEWdVsz&_nc_oc=AdoeSHqIsp_WQTLO_o1CWtPqU-90WWj1FDDIqjuNDBvXVytKOi6GaAvyT_VgWJbHeZ0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6cWPnRjAJWtCHhiDmsbh_W4aC--8Ba5h5XzWUdzub0g&oe=6AD3BA22"}, {"file_name": "New Project (9).png", "id": "617922867601807", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391934_617922870935140_8422128019279911204_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBXgIQeepGAQ7kNvwEUoKoh&_nc_oc=AdorFrc5_6WJ264liyD1pxZkA50NmEEbp5O-MOK_bazKA2OMNCO8GFjOG7PCmxjaOVw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1NYg7MA_Tss7s_XlzmQp82pvlH_Njxr_KlLWFSIOogg&oe=6AD39F9E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoopla VR", "keywords": ["ringtoss", "carnival", "hoopla", "carnivalgames", "dartgames"], "long_description": "Hoopla VR is a fast-paced ring toss game set in a nostalgic old pub environment, offering an immersive and engaging experience. With just 10 rings and 2 minutes on the clock, players must aim carefully and toss rings onto pegs to score as many points as possible. Featuring realistic physics, intuitive controls, and a time-based challenge, the game is easy to pick up but difficult to master. Designed as a hype casual experience, Hoopla VR provides quick yet competitive gameplay, encouraging players to improve their accuracy and beat their high scores in a classic pub-style setting.", "short_description": "Set in a charming old pub, Hoopla VR brings the classic ring toss game to life in immersive virtual reality. With just 10 rings and 2 minutes on the clock, your goal is simple\u2014land as many perfect tosses as possible and rack up the highest score!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucido.life/policy/hoopla/", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9102004773167824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393059_977094597177851_9072525806509539545_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYfKHN72EJ8Q7kNvwHxUwl0&_nc_oc=AdqePkKmf3dXk_qAo1LXwDS5O12IiXTQJRYbgNGcXT0gTtSc7QMHNsQmQ2zdBdI4M6E&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRCTnU2lDRPEIzQIa5i10WQi46W5-oXyEf2hSLVSqciA&oe=6AD3A319"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hoopla VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1747853700, "lastRevision": {"nodes": [{"id": "9050068431694792", "release_type": "SCHEDULED", "administration_status": "APP
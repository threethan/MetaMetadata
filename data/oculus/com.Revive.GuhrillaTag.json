0f&oh=00_AQT0tHVQgpDvBq8olJyjDzw7QtkqHDaYuWvRFzO4DF_48A&oe=6AF8A620"}, {"file_name": "04_upper_floor_reverse.png", "id": "1745368823387111", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593718973_1745368826720444_8499656063000397679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfamH4wWoEUQ7kNvwHPiXx8&_nc_oc=AdqoG53d3UKCEiLfdfRByFpU9jaYldOlwt0y5b3cLaSs4vK5Zl9D7FanjpuYmBwoCtE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRk65IOnqBVBd5Mts8L4N0LQ11lfLicrJZA-nPsFlAKaw&oe=6AF8AAA3"}, {"file_name": "01_spawn_room.png", "id": "1130425363177134", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628446_1130425366510467_8825115977884924388_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQycyvfJ9EQQ7kNvwFjPtBt&_nc_oc=AdpkaW-CBQq3R_d5Qhii6b5KVvG2oRLu4PMPlQpwxcbQLbaCJKNsxYD1Z_lUuI9moFQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6PCNIfmDCBPOhryyu4CyuL083CHc7UGy78KRxhvgr1A&oe=6AF8869A"}, {"file_name": "07_lower_floor.png", "id": "1878610643518784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593718973_1878610653518783_4745417721537611440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHWotewM79EQ7kNvwE68a7N&_nc_oc=Adr82xiKMtnT55tXbkGwlLX3FWgW2BLUt50dvV9jiccSMaKc9f6FOEJoyaN-1BpqgA4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiCFs5_5SqaxvKY0kYOtHF0nTM8G9bMoPcCnan17k2PA&oe=6AF8759B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Guhrilla Tag", "keywords": [], "long_description": "Guhrilla Tag is a social VR hangout where you move like a gorilla. There's no thumbstick walking: you push off the floor and walls with your hands to run, jump, and climb.\n\nWhen the game starts, you're automatically connected to an online room with other players. Talk to everyone with built-in voice chat, see who's who from the name tags above their heads, and chase each other around the room.\n\nFEATURES\n\u2022 Arm-powered movement: push off the ground to run, launch off walls to leap, and pull yourself up surfaces with your hands\n\u2022 Online multiplayer: join a public room of up to 16 players automatically\n\u2022 Voice chat: talk with everyone in your room\n\u2022 A hand-built brick room to play in, with stairs and a desk setup\n\nGOOD TO KNOW\n\u2022 An internet connection is required\n\u2022 Movement is fast and physical. Play in a clear space and take a break if you feel motion sick", "short_description": "Move like a gorilla using only your arms. Guhrilla Tag drops you into an online room with up to 16 players and live voice chat. Run, leap off walls, climb, and chase your friends around."}]}, "developer_name": "Revive", "developer_privacy_policy_url": "https://sites.google.com/view/guhrillatagpolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Revive", "support_website_url": null, "website_url": "https://sites.google.com/view/guhrillatagsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "853912607747485"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622188_1638769001183593_7714224455818048227_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eV6zD7PpT64Q7kNvwFG4XUU&_nc_oc=Ado2qLNSJOKrdSPf8TgoBBs1X7BHBpHn0vyVrd1uICAXYe25tB0N2yg3FL_se72KtI8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn
0f&oh=00_AQSkcS3q6SaHJTdsN0remUhotl4UZpCJiC9FJ90YqiKaow&oe=6AF47960"}, {"file_name": "04_upper_floor_reverse.png", "id": "1745368823387111", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593718973_1745368826720444_8499656063000397679_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCW4IoIpTRkQ7kNvwFJKEXV&_nc_oc=AdpVCuA7Rfp59C7Ccnpsgl3yhjJbR1-9R3ut2ksaZb9YBTRe9PYqLB6atV-JJMU3Smo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXQoXQ63JpnZRr2suYCGA25y_Tj1gLy6AEr5IFwOSv2w&oe=6AF47DE3"}, {"file_name": "01_spawn_room.png", "id": "1130425363177134", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628446_1130425366510467_8825115977884924388_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ojsvDnXwZwQ7kNvwH4Ozqm&_nc_oc=AdovbO3QvquF-vDO1WJiMkB8ukAN1s0ASGPxSikwopGU7MT02w9H4sVV2x0uctDA0eE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQODrlRXEHwceCpVc5dSzJbNyhO6j85f30u6gIGT1ScFA&oe=6AF4921A"}, {"file_name": "07_lower_floor.png", "id": "1878610643518784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593718973_1878610653518783_4745417721537611440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8WIQNEmp0EQ7kNvwEeP8FO&_nc_oc=Adpc0Ka2sITMr6sqU3kNlbiQias4cJ3d2CfvjbdJB8fZLlqq0c3PkNxNFF8LKaa75n0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ66V7NKNPei7GpQnhlkfh8P7WvqXPHN5ILd3P06NQM7g&oe=6AF4811B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Guhrilla Tag", "keywords": [], "long_description": "Guhrilla Tag is a social VR hangout where you move like a gorilla. There's no thumbstick walking: you push off the floor and walls with your hands to run, jump, and climb.\n\nWhen the game starts, you're automatically connected to an online room with other players. Talk to everyone with built-in voice chat, see who's who from the name tags above their heads, and chase each other around the room.\n\nFEATURES\n\u2022 Arm-powered movement: push off the ground to run, launch off walls to leap, and pull yourself up surfaces with your hands\n\u2022 Online multiplayer: join a public room of up to 16 players automatically\n\u2022 Voice chat: talk with everyone in your room\n\u2022 A hand-built brick room to play in, with stairs and a desk setup\n\nGOOD TO KNOW\n\u2022 An internet connection is required\n\u2022 Movement is fast and physical. Play in a clear space and take a break if you feel motion sick", "short_description": "Move like a gorilla using only your arms. Guhrilla Tag drops you into an online room with up to 16 players and live voice chat. Run, leap off walls, climb, and chase your friends around."}]}, "developer_name": "Revive", "developer_privacy_policy_url": "https://sites.google.com/view/guhrillatagpolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Revive", "support_website_url": null, "website_url": "https://sites.google.com/view/guhrillatagsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "853912607747485"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622188_1638769001183593_7714224455818048227_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuLShuPFHcMQ7kNvwHjg256&_nc_oc=AdrJsIzYkjXSOvhXqa4N1LtdF0og757VKIKeZrHS3slL84_NwJGPZcOrqK0_6RhWNhw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn
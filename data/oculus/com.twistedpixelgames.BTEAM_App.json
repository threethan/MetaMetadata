=6A0B05A5"}, {"file_name": "migrated_image.png", "id": "551556028807331", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162769_298123294036831_7821411006822744064_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59mar34JWU0Q7kNvwEI-bhs&_nc_oc=AdobrQI9Ei--EAZzVdRgNup84ussvOjCLcJbIvREM43n17MuMLlDcwBVSPBtb7BaMSQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7m7ib-d2sQg8d0NS24OZvwftO6Ew32__K3thQC96Rhww&oe=6A0B2F70"}, {"file_name": "migrated_image.png", "id": "517406058975998", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162753_690733501112750_1138895159325360128_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUNGoIBxvpQQ7kNvwHKiAOa&_nc_oc=AdrKZl-S4q4t61yXG41JKveIFRSLGBMIJ_c8XAPfzlULGrC-ySAXchZm90Ub66TwIN4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6w7GkNWEgI7cixyj8e42KIef6UgMdp52zdAanZHE0t1A&oe=6A0B320E"}, {"file_name": "migrated_image.png", "id": "259663251702888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162717_1789869947980253_5066768941951483904_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLIrhfK0-qkQ7kNvwEgvlvh&_nc_oc=Adr8cjmrOl8PFhJTDX4R1hjj56-VX8ThH8w1FEPaE7hIMcNyhWXnB1zpjZEDaNSJsfk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42HPFrnKtw5DTwS_LrWdvZUlS3CMZYc6eMNJkAR0OEqw&oe=6A0B1FB4"}, {"file_name": "migrated_image.png", "id": "213816883302843", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162711_1987800701497150_4142700148327186432_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-prgrMjkvEQ7kNvwH2H-co&_nc_oc=AdodOTZzVdRhvSryLWNcBoPL4-BTW6SS9yJF7tX_bnNDp-pE_t5WmlN8kolrVdCuW-M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Jdbl1yUun6VcpmZIdFWVLCGvAdD8IQhTDFZPwwzDmjA&oe=6A0B0135"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "B-Team", "keywords": ["BTeam", "Team", "Twisted", "Action", "Comedy"], "long_description": "The alien invasion is underway!  The best and the brightest met the enemy head on, and got their butts kicked for the trouble.  Now it is up to you and the members of the B-Team!\n\nDodge to the left.  Dodge to the right.  Dodge to the left. No, that\u2019s your right.  Speed down the path while dodging obstacles and overcoming deadly enemy traps!\n\nThese aliens are carrying heavy firepower.  Use the Team\u2019s special weapons to fight through wave after wave of determined enemies.  \n\nWe are facing an enemy that is truly mentally gifted.  Their puzzles and defenses are like nothing you have seen on this planet, unless you have.  Put your mind to the test with quick draw challenges!\n\nTime to prove you have what it takes to be the the last, 2nd best hope for the planet.", "short_description": "The alien invasion is underway!  The best and the brightest met the enemy head on, and got their butts kicked for the trouble.  Now it is up to you and the members of the B-Team!\n\nSpeed down deadly paths lined with traps.  Shoot hordes of enemies who are trying to kill you first.  Solve puzzles created by the greatest minds in the galaxy.  \n\nTime to prove you have what it takes to be the the last, 2nd best hope for the planet."}]}, "developer_name": "Twisted Pixel Games, LLC", "developer_privacy_policy_url": "http://twistedpixelgames.com/privacy-policy/", "developer_terms_of_service_url": "http://twistedpixelgames.com/vr-eula/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://twistedpixelgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player
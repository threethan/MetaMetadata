=6e7a0a&_nc_ohc=st5FtEaXufoQ7kNvwHmbDXo&_nc_oc=AdodlJ11g6CidKK8bn9ByoaJEauZnjhCxHKeh0ZTjQEvHDRHgle2PhGWDnY2gp6QhUY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRa27WsWkkrxUvqXcyYyhahFfBP4dmUmK8do0l4n8v9xA&oe=6B048374"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVERART_LANDSCAPE.png", "id": "206803009919589", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504730_206803013252922_2459364042523803648_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoYwLDUQJL0Q7kNvwE4ccMH&_nc_oc=AdorkX1X1BNz1aKrxsRFGFXVmzDZ-DpfsLPNybf5Z-Hq1n1x88kofJX98VK5noQfzgk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSC1I04VRsDwDE3goeMUXcAY0g1OFXQlaDJKADlUCowSw&oe=6B04838A"}, "display_name": "THE B-TEAM", "keywords": ["BTeam", "Team", "Twisted", "Action", "Comedy"], "long_description": "The alien invasion is underway!  The best and the brightest met the enemy head on, and got their butts kicked for the trouble.  Now it is up to you and the members of the B-Team!\n\nDodge to the left.  Dodge to the right.  Dodge to the left. No, that\u2019s your right.  Speed down the path while dodging obstacles and overcoming deadly enemy traps!\n\nThese aliens are carrying heavy firepower.  Use the Team\u2019s special weapons to fight through wave after wave of determined enemies.  \n\nWe are facing an enemy that is truly mentally gifted.  Their puzzles and defenses are like nothing you have seen on this planet, unless you have.  Put your mind to the test with quick draw challenges!\n\nTime to prove you have what it takes to be the the last, 2nd best hope for the planet.", "short_description": "The alien invasion is underway!  The best and the brightest met the enemy head on, and got their butts kicked for the trouble.  Now it is up to you and the members of the B-Team!\n\nSpeed down deadly paths lined with traps.  Shoot hordes of enemies who are trying to kill you first.  Solve puzzles created by the greatest minds in the galaxy.  \n\nTime to prove you have what it takes to be the the last, 2nd best hope for the planet."}]}, "developer_name": "Twisted Pixel Games, LLC", "developer_privacy_policy_url": "http://twistedpixelgames.com/privacy-policy/", "developer_terms_of_service_url": "http://twistedpixelgames.com/vr-eula/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://twistedpixelgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30573826172204658"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162690_1478070048977452_8873295059353600_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bALeGvC7td4Q7kNvwHtHVl8&_nc_oc=AdoJOfjNNq10AVhQLrUsWtmFu0tMdS8ItEdAKOKiDRoTwogOF-CViA3a88o5axX5cnQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuUHU3Ar4EdVqCA3rCi6MnBSLxNcmlzxbbKj5SmXiVrg&oe=6B04779B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "THE B-TEAM", "platform": "ANDROID", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2
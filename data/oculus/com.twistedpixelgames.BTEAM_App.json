=6A708925"}, {"file_name": "migrated_image.png", "id": "551556028807331", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162769_298123294036831_7821411006822744064_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGZXzZVPO-cQ7kNvwFOQPB2&_nc_oc=AdqO3wQCQz7N0Ix53CnD8wp6spLrWDiZh9mmNmL8pt96WZEqZBNdI_QP-h60VysIEQE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoDEz-JbPy8k-XIp7pxNsK8aNpagKa7POhr9uXUvCqkw&oe=6A707AB0"}, {"file_name": "migrated_image.png", "id": "517406058975998", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162753_690733501112750_1138895159325360128_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BbPH7NAIyAQ7kNvwEY6i0O&_nc_oc=Adr08ec6JjiE33J4LfhaqT1IaRZ8-uHjlk8QZNlCo0Pw8WEF3bpeI-gtb5bSNxyjGxY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuTADwsJpf0yfAxYfjms5x3tJ_6Znzq_-A9NSHbQ2g0Q&oe=6A707D4E"}, {"file_name": "migrated_image.png", "id": "259663251702888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162717_1789869947980253_5066768941951483904_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjzDhep0j_EQ7kNvwFy2CZD&_nc_oc=AdqGHNUxeqt3F6oj3NlRC2VTT2M4gElwJD0fps2s5fuAigcMS7em5eRXMU80vh79lxg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGR-RESlaXam_9YFxpyeXEqdVWVK-c0tjQME7cYKnGYBg&oe=6A70A334"}, {"file_name": "migrated_image.png", "id": "213816883302843", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162711_1987800701497150_4142700148327186432_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrLbZ7AgVV8Q7kNvwH_gZMd&_nc_oc=Adq2yUORTHlpOXB2vGUUoM1Tj8D0BfahwlkLb6BIx-8BAs8xfdqUYfvi6BWjqPUiy6I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7Mb1d3s1ufYRxYNS9NtStH2LSiVbBPTumzDJkesW60w&oe=6A7084B5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "B-Team", "keywords": ["BTeam", "Team", "Twisted", "Action", "Comedy"], "long_description": "The alien invasion is underway!  The best and the brightest met the enemy head on, and got their butts kicked for the trouble.  Now it is up to you and the members of the B-Team!\n\nDodge to the left.  Dodge to the right.  Dodge to the left. No, that\u2019s your right.  Speed down the path while dodging obstacles and overcoming deadly enemy traps!\n\nThese aliens are carrying heavy firepower.  Use the Team\u2019s special weapons to fight through wave after wave of determined enemies.  \n\nWe are facing an enemy that is truly mentally gifted.  Their puzzles and defenses are like nothing you have seen on this planet, unless you have.  Put your mind to the test with quick draw challenges!\n\nTime to prove you have what it takes to be the the last, 2nd best hope for the planet.", "short_description": "The alien invasion is underway!  The best and the brightest met the enemy head on, and got their butts kicked for the trouble.  Now it is up to you and the members of the B-Team!\n\nSpeed down deadly paths lined with traps.  Shoot hordes of enemies who are trying to kill you first.  Solve puzzles created by the greatest minds in the galaxy.  \n\nTime to prove you have what it takes to be the the last, 2nd best hope for the planet."}]}, "developer_name": "Twisted Pixel Games, LLC", "developer_privacy_policy_url": "http://twistedpixelgames.com/privacy-policy/", "developer_terms_of_service_url": "http://twistedpixelgames.com/vr-eula/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://twistedpixelgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player
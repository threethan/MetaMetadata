91_1531304574355719_4651695625402723499_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVCypaxKiEIQ7kNvwFKdAc_&_nc_oc=AdoDfYzYWJ6PzygVDMI5UI3UcxF4lmfgIxVrxiHn-5AxNnmYRN-0OApWbaaduaiARXE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp2g0Xxh6HfGGEo6TFEnfOqGURJLMKZ3Za__eDAzo1KA&oe=6AFC9294"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videocover.png", "id": "334089665973844", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75367591_334089669307177_4932419493797319377_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZkfye96OSUQ7kNvwEJRs_7&_nc_oc=AdrtksZe71dQR3ll1bo4Zw_gpW07YUBDWwLe9s-R0reQc9mfKgvvgWAlCJdIAN0wAhw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRumgZGnMkc4khEOi0dRFNkSvntWWMD590wt5JeDrIBkA&oe=6AFC83C1"}, "display_name": "Terror Cave", "keywords": ["horror", "terror", "cave", "theme", "park"], "long_description": "Welcome to Terror Cave, one amazing experience that will reproduce the effect of the famous theme parks terror caves where you sit down on a chair and a series of weird creatures will try to scare you, while you cross into a suggestive scenario.\n\nIf you are impressionable person that can easy be scared and are afraid to not support strong emotions, we recommend you the \"Sweety\" version of the experience, that will drive you in a tour with mild emotive and amazing feelings, but if you are brave and love high impact, go ahead with the \"scary\" version, and get ready to be shocked with strong emotions!\n\nFREE VERSION WITH SWEETY MODE ENABLED.\n\n", "short_description": "Welcome to Terror Cave, one amazing experience that will reproduce the effect of the famous theme parks terror caves where you sit down on a chair and a series of weird creatures will try to scare you, while you cross into a suggestive scenario, FREE VERSION WITH SWEETY MODE ENABLED."}]}, "developer_name": null, "developer_privacy_policy_url": "http:
7f20f&oh=00_AQFXvkYRQ0Uqd6tPUELSB_9U6asDHpWNWEpffNf3q3ZXhg&oe=6A844C6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-01-06 001743.png", "id": "1134933044653443", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974796_1134933047986776_5001262997766155437_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmjyEVof8QkQ7kNvwErvstU&_nc_oc=AdqF_vW7XIgF_jkpA808u0P-lTy1uvGW9caieRI0LVR6nyobYNGpiVUguwedElspdH0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq5OymK8uZ9vZIMEPzPJ2yj1qiMWMXMnF4OrH_hR8LUg&oe=6A845EE6"}, "display_name": "Stick Defense Arena", "keywords": ["War", "Defense", "Army", "Comfort", "Casual"], "long_description": "Step into the electrifying universe of Stick Defense Arena, a groundbreaking VR experience tailored for Meta Quest. Take control of your heroic stickman character, equipped with glowing swords and powerful shields, and face off in breathtaking arena battles. Every move matters as you combine strategy and quick reflexes to defend your ground and outsmart opponents.\n\nImmerse yourself in a visually stunning futuristic arena filled with energy bursts, dynamic lighting, and intense action. Customize your gameplay strategy to adapt to various challenges and unlock unique abilities to gain the upper hand. Whether you're dodging enemy attacks, launching counterstrikes, or commanding your defense, the game delivers an adrenaline-pumping experience like no other.\n\nPerfect for players of all levels, Stick Defense Arena combines intuitive controls, engaging gameplay, and endless challenges. Dive in and prove your skills in the ultimate stickman battle. Will you rise as the arena champion?", "short_description": "Dive into the action-packed world of Stick Defense Arena, a thrilling battle strategy game designed for Meta Quest. Command your stickman warrior in epic arena battles, wielding glowing swords and shields to outwit your foes. Engage in fast-paced combat, strategize your defense, and conquer the arena with skill and precision. Featuring vibrant visuals, dynamic gameplay, and a futuristic setting, this game offers endless excitement and challenges for players of all levels."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/stick-defense-arena", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8896096600444755"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "2314130312663081"}, {"status": "PUBLISHED", "id": "3961138770846725"}, {"status": "PUBLISHED", "id": "1403346111256040"}, {"status": "PUBLISHED", "id": "797069183201042"}, {"status": "PUBLISHED", "id": "1447979676379709"}, {"status": "PUBLISHED", "id": "1805792600150347"}, {"status": "PUBLISHED", "id": "1395565684935757"}, {"status": "PUBLISHED", "id": "1243162063410101"}, {"status": "PUBLISHED", "id": "561130980247605"}]}, "baseline_offer": {"id": "1395565684935757"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787079600, "status": "PUBLISHED", "id": "2314130312663081"}]}, "liveChannel": {"nod
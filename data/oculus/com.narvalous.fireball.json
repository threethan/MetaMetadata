3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2arD3Zhr2EXqutyDDU0uuqwgEP_o_SVvyo-RhHdhaIA&oe=6AFB3F03"}, "display_name": "VR Wizards - The First VR eSports Game", "keywords": ["PvP", "Multiplayer", "Strategy", "Arena", "Wizard"], "long_description": "Are you a pure-blood, a muggle, or half-blood? Are you a casual player or a hardcore player?  Will you be excited to play against the computer or play against your fellow players?  Do you enjoy to play at your own pace?  Or in an adrenaline-filled battle with others?  Are you 13 years old or 70 years old?  No matter what your background is, you will love this eye-catching, action-packed game.  \n\nIn this unprecedented VR game, you will be playing as a wizard.  Your goal are to battle with other wizards in real-time, or to defeat the slime monsters.  \n\nIn game tournament and real life tournaments will be hosted to decide the top wizards of all!  ", "short_description": "VR Wizards is the first VR eSports game featuring both PVE and PVP arenas, where its PvP arena can host 2-4 or more players to play at the same time.  Due to its fast and thrilling gameplay that requires strategy, agility, and responsiveness to shoot, dodge, hide, and escape your enemy attacks, the game is born to be a great eSports game suitable for players of all levels. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://xgameportal.com/html/privacy.html", "developer_terms_of_service_url": "https://www.xgameportal.com/html/terms.html", "publisher_name": "Narvalous, Inc.", "support_website_url": null, "website_url": "http://narvalous.org/games/vr-wizards/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "ADVENTURE", "CASUAL", "ACTION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
10&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuHWUkH4qm4Q7kNvwFcLoVr&_nc_oc=AdpTRVdDAUB0RbWmAqVIe4N6UYc23wi7ViHMTuR2UPSMxG9-06vMzXLoM_1-oyOE1a0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBx5Y9tmXLALmTY6vmIq6q_moKqKIa_6tYETyD3xLa5eg&oe=6A5A2093"}, {"file_name": "screenshot_20260410_134005.png", "id": "1496454735597901", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491830613_1496454738931234_4242212272124382722_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbbYzs7xSUoQ7kNvwHJl2lr&_nc_oc=AdooL-cxWkm92TQw2sWBZX7GcMxycmSapKqFMxPjxXeKzscDjc7vQpNajgnYK5-P5fQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1-fXOmW1bCLa1ZT5twSZ6_2fRIQcg8BPPzxAtwhhcDg&oe=6A5A1C5E"}, {"file_name": "screenshot_20260410_135057.png", "id": "823681217067474", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618515_823681220400807_4405464871182584249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_C5Kc6HY4CEQ7kNvwFErFJT&_nc_oc=Adp8tRfKv7tod_-XD0JxReAtFkvs5JeIiqtcTbqFthaG95Kr8BwmTEh2AlMic3Wmq0U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRTbR22pgmsUgfAA3C2zBbFr2VXCnV3jmyP4h_S7ywKQ&oe=6A5A192A"}, {"file_name": "passthroughScreenshot.png", "id": "1670685123837468", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499299051_1670685127170801_2156858041988709653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZSmH2akxz4Q7kNvwG6O8NH&_nc_oc=AdqtKRtOlL7WREOLq1uv08auqmlk0IwrMoDtZpokkoJwL6U04jPSCg29MY150sBo9fo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKmuan-J4r8fKaqi0sA4evCYhrBYR8iy_z9G_Ma5MiWw&oe=6A5A38AD"}, {"file_name": "screenshot_20260323_163616 copy.png", "id": "1499663591827472", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499305050_1499663595160805_8782467042364251775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tj9ireNDLj4Q7kNvwHrGYR5&_nc_oc=AdrF59A4H4LHz6xnvMZG1YAwXBWP5-WXeoIwZ4C6OMtG0yXkOKsqfyZolj8KWbe9_54&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAld5y6IzNVR_f03qUGKlotHLN1vrRCfFk7uq9k5jQKPQ&oe=6A5A2488"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_20260319_140948.png", "id": "2034223767476113", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499293658_2034223770809446_5369473063921564291_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIpoZKjitGsQ7kNvwGQvHZ-&_nc_oc=AdoYk_XZw6rjb8pSUdixCq_deLFIExji3yS1566cEDEg6WeDLTnTd2lCgNqaeTTbsmo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuYw8gihkPPigOwtQS5dwkJNT_vK0P9Wxa-8uwPshb2Q&oe=6A5A45CE"}, "display_name": "Pixel Paint Universe", "keywords": ["pixel", "art", "retro"], "long_description": "Pixel Paint Universe is a pixel art studio where you can build sprites, room-scale scenes, or entire explorable pixel-art worlds.  It features easy to use, intuitive tools.  You can even add collision to pieces of your world, creating walls, ramps, stairs, platforms, and more.  Choose from different floors and skies to set the mood of your world, from bright outdoor scenes to a pure black creative canvas.\n\nNot a pixel artist (yet)? Import sprites to your headset from your PC to start building quickly.  \n\n{2072231329990421}\n\nBuilt in retro color palettes make creating cohesive art or worlds easy, or you can create custom palettes of your own.  \n\nPixel Paint Universe also supports passthrough, meaning you can create and place pixel art in your real environment.  Make a diorama on your desk, decorate your room in retro game sprites, or create pixel art wherever you go.  \n\n# Tools:\n- Brush Tool\n- Shape Tools \n- Paint Bucket/Fill\n- Select\n- Line Tool\n- Eraser\n- Undo/Redo\n- Color Picker/Eye Dropper\n- Copy/Cut/Paste\n- Duplicate Canvas\n\n\n{1311938244211126}", "short_description": "Pixel Paint Universe is a pixel art studio where you can create individual pieces of pixel art, or create entire worlds!  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://aury.s
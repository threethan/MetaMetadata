10&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KpUuqr-u0wQ7kNvwGrsuGd&_nc_oc=Adp-mhued0DrpOJbpAlEBVUYt1lC2Strv4Mii-KJDL_2jpq1QfIK9VV_6cSGtI10dpI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9p-Jb6KzS9XjRSXI3xp2q0s_OHgNIAOI62c4l0OqNlQ&oe=6A3BCE13"}, {"file_name": "screenshot_20260410_134005.png", "id": "1496454735597901", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830613_1496454738931234_4242212272124382722_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kanNEOPaF4Q7kNvwFa9Jb-&_nc_oc=AdoPBxGf0LcexhTVs2GzEAnwOSx9eFQo-U704_iOqiYLRaI6E6cqkTzgN6iQnp8xJFA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86csdRD26GeAANiIk2FjT5MzcIh4K5jbxoxolcEh5Bgg&oe=6A3BC9DE"}, {"file_name": "screenshot_20260410_135057.png", "id": "823681217067474", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618515_823681220400807_4405464871182584249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0cqm7UsWLQQ7kNvwEs1rIP&_nc_oc=Adp8NpLyip1JWCInNZtqGEpCV9gLo3ZyVcHk-PRB6-2LuhoXQbUK5M9IuydqUSFyarE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_6FTxW9GtEblUch2CF1El5dq-Id2D7y34fAsRVqWcgQ&oe=6A3BFEEA"}, {"file_name": "passthroughScreenshot.png", "id": "1670685123837468", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299051_1670685127170801_2156858041988709653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwiWOVyhEGsQ7kNvwGS-ZF4&_nc_oc=AdqoxVfymCAn6IjKTXvOnqY60Lub2LfFGEXqAkbnTrA9b2Av8M1JvAoNbg9vSvjGUSM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JBhdFo-yb37JLTVhivImSDElCPxekgLj99O_QM17iCw&oe=6A3BE62D"}, {"file_name": "screenshot_20260323_163616 copy.png", "id": "1499663591827472", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305050_1499663595160805_8782467042364251775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7c9rQ3zm3hAQ7kNvwFRDwIS&_nc_oc=AdoNbP9zqMTLTgfw1rRjIPQwNasSXuY_z4i-H49z3ra0bY1cmOpdf-n2HIPw0r2QGxo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9niB9ZbzuxAagFBxQFUJoRQjwVOpCVm5DVvfKzTWZi0A&oe=6A3BD208"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_20260319_140948.png", "id": "2034223767476113", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499293658_2034223770809446_5369473063921564291_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-y9VdSHsmNAQ7kNvwHTyHBe&_nc_oc=AdrwSMpoFLCLcWtSyD0GwB_GjsUw5h_z9iz6v-MqMEUizz5S_uKDmvzOAgAT0w3dBaY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MFAw7eRENIj5GaRUEnVHeqNgprdz_43Cd2mQAv8ZqWA&oe=6A3BF34E"}, "display_name": "Pixel Paint Universe", "keywords": ["pixel", "art", "retro"], "long_description": "Pixel Paint Universe is a pixel art studio where you can build sprites, room-scale scenes, or entire explorable pixel-art worlds.  It features easy to use, intuitive tools.  You can even add collision to pieces of your world, creating walls, ramps, stairs, platforms, and more.  Choose from different floors and skies to set the mood of your world, from bright outdoor scenes to a pure black creative canvas.\n\nNot a pixel artist (yet)? Import sprites to your headset from your PC to start building quickly.  \n\n{2072231329990421}\n\nBuilt in retro color palettes make creating cohesive art or worlds easy, or you can create custom palettes of your own.  \n\nPixel Paint Universe also supports passthrough, meaning you can create and place pixel art in your real environment.  Make a diorama on your desk, decorate your room in retro game sprites, or create pixel art wherever you go.  \n\n# Tools:\n- Brush Tool\n- Shape Tools \n- Paint Bucket/Fill\n- Select\n- Line Tool\n- Eraser\n- Undo/Redo\n- Color Picker/Eye Dropper\n- Copy/Cut/Paste\n- Duplicate Canvas\n\n\n{1311938244211126}", "short_description": "Pixel Paint Universe is a pixel art studio where you can create individual pieces of pixel art, or create entire worlds!  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://aury.s
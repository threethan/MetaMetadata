&_nc_ss=7f20f&oh=00_Af98VvroDtoRngh60sZHbQn8MaquzpK7iFlVcnA2kNWDYw&oe=6A2EA308"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_20260319_140948.png", "id": "2034223767476113", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499293658_2034223770809446_5369473063921564291_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBpDXLGM_qcQ7kNvwE2H-s0&_nc_oc=AdpuIqNk-rj6yFnyonuSN7MUwWH-M-NCHF_JYlTVT8NPMUap6FPUJ5NMcXz0-SSDyMU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_euypRGGHLvl-EVojLhgaOWFDQHqja7H23GKJZhjgZOw&oe=6A2EC44E"}, "display_name": "Pixel Paint Universe", "keywords": ["pixel", "art", "retro"], "long_description": "Pixel Paint Universe is a pixel art studio where you can build sprites, room-scale scenes, or entire explorable pixel-art worlds.  It features easy to use, intuitive tools.  You can even add collision to pieces of your world, creating walls, ramps, stairs, platforms, and more.  Choose from different floors and skies to set the mood of your world, from bright outdoor scenes to a pure black creative canvas.\n\nNot a pixel artist (yet)? Import sprites to your headset from your PC to start building quickly.  \n\n{2072231329990421}\n\nBuilt in retro color palettes make creating cohesive art or worlds easy, or you can create custom palettes of your own.  \n\nPixel Paint Universe also supports passthrough, meaning you can create and place pixel art in your real environment.  Make a diorama on your desk, decorate your room in retro game sprites, or create pixel art wherever you go.  \n\n# Tools:\n- Brush Tool\n- Shape Tools \n- Paint Bucket/Fill\n- Select\n- Line Tool\n- Eraser\n- Undo/Redo\n- Color Picker/Eye Dropper\n- Copy/Cut/Paste\n- Duplicate Canvas\n\n\n{1311938244211126}", "short_description": "Pixel Paint Universe is a pixel art studio where you can create individual pieces of pixel art, or create entire worlds!  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://aury.studio/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Aury", "support_website_url": null, "website_url": "https://www.pixelpaintuniverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24437951355869694"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1666832264604038"}, {"status": "PUBLISHED", "id": "1671941510600679"}]}, "baseline_offer": {"id": "1666832264604038"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780758000, "status": "PUBLISHED", "id": "1666832264604038"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26784836437847829", "version": "2"}, "id": "1969374197159140", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24437951332536363", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26784836437847829"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1969374197159140"}]}, "change_log": null, "created_date": 1778260301, "id": "26784836437847829", "version": "2", "version_code": 6, "release_status": "RELEASED", "status": "APP
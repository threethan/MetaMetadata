11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaYCEYJ5ttOAhBslgJeiuL9nhwwidrA9TPkRCFAmoEQQ&oe=6A8EE088"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_20260319_140948.png", "id": "2034223767476113", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499293658_2034223770809446_5369473063921564291_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyzpHWfECn0Q7kNvwH94P4B&_nc_oc=Adqw1FlUTr51HTIGXceB7jM2kNE3U9cvOZuNLLvzt07unOuMDLMxo7ku6_-O0XKnXQ4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEtTnoBc4xd0BEnQYd_m_p7o2YEplesqyxYEEOPX0HEQ&oe=6A8EC98E"}, "display_name": "Pixel Paint Universe", "keywords": ["pixel", "art", "retro"], "long_description": "Pixel Paint Universe is a pixel art studio where you can build sprites, room-scale scenes, or entire explorable pixel-art worlds.  It features easy to use, intuitive tools.  You can even add collision to pieces of your world, creating walls, ramps, stairs, platforms, and more.  Choose from different floors and skies to set the mood of your world, from bright outdoor scenes to a pure black creative canvas.\n\nNot a pixel artist (yet)? Import sprites to your headset from your PC to start building quickly.  \n\n{2072231329990421}\n\nBuilt in retro color palettes make creating cohesive art or worlds easy, or you can create custom palettes of your own.  \n\nPixel Paint Universe also supports passthrough, meaning you can create and place pixel art in your real environment.  Make a diorama on your desk, decorate your room in retro game sprites, or create pixel art wherever you go.  \n\n# Tools:\n- Brush Tool\n- Shape Tools \n- Paint Bucket/Fill\n- Select\n- Line Tool\n- Eraser\n- Undo/Redo\n- Color Picker/Eye Dropper\n- Copy/Cut/Paste\n- Duplicate Canvas\n\n\n{1311938244211126}", "short_description": "Pixel Paint Universe is a pixel art studio where you can create individual pieces of pixel art, or create entire worlds!  "}]}, "developer_name": null, "developer_privacy_policy_u
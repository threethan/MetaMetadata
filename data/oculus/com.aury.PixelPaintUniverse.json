10&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLVafTw3P5gQ7kNvwHrslg1&_nc_oc=AdrRZCyp7_NSR7ps8aABle_WcE8e08m6sxn8G53vm9o1L9HlOp-YBL1fx0nytNanwnw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAs6CLAohobKakSeGIiMusVDkXcuv89L1O_n0qz_IDgcQ&oe=6A6B4413"}, {"file_name": "screenshot_20260410_134005.png", "id": "1496454735597901", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830613_1496454738931234_4242212272124382722_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hE3JpRMZbcAQ7kNvwEfc77I&_nc_oc=AdpnM96mhKrrEJjOfYsExH7w6-dw_5yN6Mjv29oavfrs2OSYaE9CwR_9S28bmU7KtRw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQPRyh9B5BVZLVL0M6kERLtcVmcMenM0_gl_m573KZLg&oe=6A6B3FDE"}, {"file_name": "screenshot_20260410_135057.png", "id": "823681217067474", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618515_823681220400807_4405464871182584249_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsHoQf2oUZ4Q7kNvwGBZLAo&_nc_oc=AdpZsYHTmM0GzAqVyKeok2mGmrRWJ8vP39K3bDnFWUKBJCUoCj3AAUNsumPmWtWJVZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAt40Oq9FDheVxnVwLXGAk4UPX4YCtFE7VYT8pPGHGRYQ&oe=6A6B3CAA"}, {"file_name": "passthroughScreenshot.png", "id": "1670685123837468", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299051_1670685127170801_2156858041988709653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwB6FaCRItgQ7kNvwH5z9kt&_nc_oc=AdorkliqF0tT-jp0Qdmo4P_FuRc8TnmkxaQJUTwjiIazE0luBl3BwAfo7SWXFYxbcNw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAX9NLLWNyP_ZUvdPmyz46kD2lfiX1u0y7Q3S0y15nPjA&oe=6A6B5C2D"}, {"file_name": "screenshot_20260323_163616 copy.png", "id": "1499663591827472", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305050_1499663595160805_8782467042364251775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkZZy1DsbbMQ7kNvwEBMZfH&_nc_oc=AdoKyxnQa9EVBlSFLeNKnJ-gJ2kNn8JcT-cnG6pX3qtto-xV9rEYP_-OFcMEsIrupgI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6QiRrZJQKpZnbWVswBp3nk1ItJXQjB5hQLfQD5jk7Vg&oe=6A6B4808"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_20260319_140948.png", "id": "2034223767476113", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499293658_2034223770809446_5369473063921564291_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVCEDZcqqF0Q7kNvwEXoJv3&_nc_oc=AdocaW5Af_auj3ggw6eSsof9yaVm9xLqsviGOieYZKk1QAo9QdvOSsC0MueGWRFfEIY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnLJXd9cRSTcJujg6NyoooBXpT0ujH_BMHWq1KOYRb8w&oe=6A6B694E"}, "display_name": "Pixel Paint Universe", "keywords": ["pixel", "art", "retro"], "long_description": "Pixel Paint Universe is a pixel art studio where you can build sprites, room-scale scenes, or entire explorable pixel-art worlds.  It features easy to use, intuitive tools.  You can even add collision to pieces of your world, creating walls, ramps, stairs, platforms, and more.  Choose from different floors and skies to set the mood of your world, from bright outdoor scenes to a pure black creative canvas.\n\nNot a pixel artist (yet)? Import sprites to your headset from your PC to start building quickly.  \n\n{2072231329990421}\n\nBuilt in retro color palettes make creating cohesive art or worlds easy, or you can create custom palettes of your own.  \n\nPixel Paint Universe also supports passthrough, meaning you can create and place pixel art in your real environment.  Make a diorama on your desk, decorate your room in retro game sprites, or create pixel art wherever you go.  \n\n# Tools:\n- Brush Tool\n- Shape Tools \n- Paint Bucket/Fill\n- Select\n- Line Tool\n- Eraser\n- Undo/Redo\n- Color Picker/Eye Dropper\n- Copy/Cut/Paste\n- Duplicate Canvas\n\n\n{1311938244211126}", "short_description": "Pixel Paint Universe is a pixel art studio where you can create individual pieces of pixel art, or create entire worlds!  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://aury.s
2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tmrFhltcYwQ7kNvwHGrS65&_nc_oc=AdoSZQ5tULh1Sj8szaAix0AnqtZLidWfZ8_4okZ4ZfW-NlZa2CQjc6WOvO-O0gub1ls&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jIOjybHIfThGle_V8P-qHldDZP1B75f5QP1AlkP0mqw&oe=6A17037E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFREooEVkOUQ7kNvwF6x-Mg&_nc_oc=Adrqu1J18kiDIUJqp_6GWzXlecDVSb8545Wm3IqpBRusoXbyteexKGmSVM93sYOQv7w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7krcNdLlJNoi8H3zpIcvpFLAdSH04lbZcuTRfCRPgvgw&oe=6A1705BB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4PYpQFpJpEQ7kNvwEsb5Q4&_nc_oc=AdpNUiSPYxz7pfXsjf-9lSkOPEg7239ycg7DIYITu8-ZoWdUREjCyG3Q0u3WM12O9nk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78naa4nqYvlVYqx14J744NQ9Pcp0Di3K60CqLkPBOqtg&oe=6A1703B8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bb2LT1qLXSMQ7kNvwGZeD0K&_nc_oc=AdrEjsZYddDMlJ2euo8XgrhAThZbOvyVgyvIcB6rXDQeYhu61zRcDZZn0EXUR6WXjyY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7artZu9hsUVmPUK634Szb8vhph3cnAwITOldbtl_vmeA&oe=6A16FC31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agn17H7hzKMQ7kNvwGjGdCP&_nc_oc=Adpa17vIZ41DuCl7dCCrACI978o94ZRXc90Tgf2wuDiC-b0KX0bkPh_POvRpqrxCCIs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZtY8rEIbWmRIVelo1x5LmIiKN8rgO7bqpEkEO9Q0lRA&oe=6A16EFA0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qx9qofEbkLQQ7kNvwGH3WeG&_nc_oc=AdrkRB1CBSdsjUL4r7WbdxTUvJihuScE0tKrctV_LjpWzM5eiz0w_GmmC9mLEZfeHTQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1b6IVIQ8WabuZheM1KzY9r3YcXsHwZwpANv2-rWD8sdg&oe=69DA5E7E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvKMk6Mn_xgQ7kNvwHW68yE&_nc_oc=AdpT-NLKp_NuydXLM9opI0HKRWJKJJSdmlXyFw5Wk3OiDRMBS2mNS7qrU9fk3aOVi5A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2V17IJvIiat85bk63DjSHXsumkQ89Qd45-UWtC7khjgQ&oe=69DA60BB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqayvrmRG9MQ7kNvwFDiZRT&_nc_oc=AdpfTpctA-aXad-lAak_luLIYAmm_gdimaeSQb_EZJFDeHvG-jMz97hCV_ge6WdcaeY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nDfQ3lq9gkVtXChxIrpe6kap2OYwlHNLrAE-g9dAvzA&oe=69DA5EB8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXzrxkSuoa8Q7kNvwE_lcwk&_nc_oc=Adrzpn18QoAAF8w0nqsFhCOf7DilT7KFLvjl-VNaw75Z43GIaykTp7uzI4-VpCJ6hHo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IsqaVhHR6U_e_3HovLM39qgnGknTG6lZlJ9mGfbJsPg&oe=69DA5731"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UY9-ehi4YYkQ7kNvwHvbm3-&_nc_oc=AdpB_ojfCvYKhV_Sc0n7T_iKwoV2JlfdRZ0N_YcP6KQ3R2_MHUSvmKMkEFDgihZ2-DQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2P4a15ieC2mmr092ROMLVXIao26tdkgeZsM_CZnlL6oA&oe=69DA4AA0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null, 
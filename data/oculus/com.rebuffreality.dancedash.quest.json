90158442676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQWkCRtNtoQQ7kNvwGrdx74&_nc_oc=AdrW7KpgdZYkFyleXK2Q3PM-ipqc6c-5O_K2QLEOa1N4F1Hi6vY5J-JV4s8YGmyKR7U&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdvZLYHbFHITf-lFAhx1UN5-hSAjRGvofWXyEjWYJvBA&oe=6AA959FE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9ju-fRleCMQ7kNvwHC2pGW&_nc_oc=Adpc8rmG0_UnNxDoEuJE_0gRTOsf5iUbTraU3Kv6l_kyW0eQpTdtS4Kyu3PVVSl_OfE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4L_mn_Rn_59MDSVTau3olhdIm0wJycTr6BVrTT6l4cA&oe=6AA95C3B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rbBVHRzqbEQ7kNvwGTpgSM&_nc_oc=AdoIufFqLWEP0Xng6unQ4JnDakzJh6agKbTL_yq05Ufu9BO474fsa59kA1A419Dz_JE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIydWYQzctyc9IxJINDs-nIFSnsh6EkjULYmLTKP5y7kQ&oe=6AA95A38"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAPgaORYj4AQ7kNvwFueP4k&_nc_oc=AdqZRV5GxROxSdfzaCDiWkdPizS_A1CslTU5YpJWLkPsTDjaDBDKvOdPg71Fj5oS6Ho&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGTb9-mVcmcvPEBBNODeVqEZYCk88zjXKhZtQQyXRkSA&oe=6AA952B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGXLUU5PnagQ7kNvwEcj8SA&_nc_oc=Adru_RJzQonB5w5_-drFZxcOOTOn---g1zh85j2Rq3L4l7ojvwRVWGJIekgzBadP38Y&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI66C7jfhkB8MwlGHjWzh8AGUvX5SibHsm5DMvd6Grk7g&oe=6AA94620"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "cate
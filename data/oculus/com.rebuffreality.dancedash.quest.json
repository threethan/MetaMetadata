2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUrrbcvsMFgQ7kNvwG5g7WR&_nc_oc=Adr5XsGgHx84gIaRVZYQem8G9VkxKJi4CxDKIo7RjZXXHndpLeYP04vCsOqXH6DzZPE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vN-SYscj3rSOTjNuFUKP5fCiAWfMpuL-VDwkUnuHIdA&oe=69EA307E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePB0LpWTUOAQ7kNvwEDNGH2&_nc_oc=AdrUUMGR1jEtwqUrIsNyWP753Fh-n1ecyawNyrWuTOLwWHTI9ni8o7sTESyqqgywXXg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Kp3vxAsG1X4lrDgUGMak2nRz9qbAk0-biZ6XlOrJGPQ&oe=69EA32BB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdHoncwkoB4Q7kNvwEyCXl_&_nc_oc=AdonB_iXZ4o_oPMKtEFcMEEv8UO84dsTq8MOT-Y39x70u9yUROLzdu36v2qpe1EqkU8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kCWwgn1ebPBblHx2QfRUprOl-5b-1xRXXkhEIHMii5A&oe=69EA30B8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkaZLpkZK50Q7kNvwHqiDPV&_nc_oc=AdqpNEKqFY9SzCAurStfAjStaKpsi193-eqEuI8DNnJYZdD_F1I_1mRjZHE10x90izA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yQMcq5CPq9rGHkTF5k3gXbVaFctB77OYOQ3ROReuhsA&oe=69EA2931"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9uQMbab8VQQ7kNvwGWj34k&_nc_oc=AdoKu1WIoQLai83UjwsEPrPynjb4HPWHAVtzoYJ9trvNqWQDM4HE2TYHLTQynD0bElQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-Osx5Wz6bw2Dtr3AOJTJ8HiNN11YsTQ4iogocfSwYeQ&oe=69EA1CA0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
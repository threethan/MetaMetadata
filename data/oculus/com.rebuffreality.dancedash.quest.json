3V3pHTFXc4xVv3q_of5PP5qjz_-GF5tzAVWWPEcl8-s4quhqlun3X8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuSy7xl_Au7_P9gFd8RHvy13Sn_09KRevTGEPBQVNDtEA&oe=69A56A3E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFGNLhaN-UoQ7kNvwGFnLu8&_nc_oc=AdkqCBNwKlLOfOM4n6LPuHnoMmwCG-9n5KdwlBCZLFS3Zpd69a_m5BvspTgKK1bRGhM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft4WRBYRFPRxkB8TRkx8ZxWlwT_9zA24Rc7FZ7w7TNmLA&oe=69A56C7B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIQ-dVN53iMQ7kNvwEe_oaB&_nc_oc=Adn7lR5ksp2V9V6e77p7gdQlU0Nd_6umFJMQj4tcehl4AGY2a7Im6a_3U2UPlFcHYCM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftRRqntOZO7WYBAquVpJomiwlTrZZHd1hbV9_8A2r7-3g&oe=69A56A78"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ergk6ae4L0Q7kNvwFyYjW4&_nc_oc=AdkxOuHFeW7psng_dMOYv3d8cZRUCP9fZRD4edWeJglBkkmI_p_aof2bq9nvJDZEBb4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aftahn1lwwEaWdkJtOzlh5XmCgy5OISDuHMXCi8AC1pDjQ&oe=69A59B31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZ41Br3pQ3IQ7kNvwE24ios&_nc_oc=Adn3kC023pKGjr6troO96WOkNQtBcCmqsKXRxWHZOe-XK2Lp484ArY9a8GXWtVNLW0s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuVm4GO7y_hL4BbUaXNv-vChn80X4XpNT1RbT_wGwvz2A&oe=69A58EA0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"
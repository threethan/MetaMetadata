2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRzjzvN_uj4Q7kNvwGK_CqV&_nc_oc=AdqR2_lY3vQS4MANbhfjYC1xjdgmMuiYc5lJAmL1bJh1mkSQl3xJGvqNtxRk5Ku9mhs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af361hASrtvYPH-APG_KdPROvovvxBmOzopbhQj6lJh28w&oe=69F60DFE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qih9rYgaIHEQ7kNvwGxjsy_&_nc_oc=Adp77nJsMK8sUwEsehIfFoU_8umRsxL1ylpCsD4X3A90-b_6T4k2nhSyRl66IVKGswg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2h_PzW4kR1uuVjpTWQANw4Ec0NhumESgWLcKDkguWeew&oe=69F6103B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGphrC1xSmUQ7kNvwE88NAQ&_nc_oc=AdrdgzyXufrglnHRtaHBL-dUiS-yPDeLj0ZLVOfAnW9rd0OQsSzaGkxQq5WUNDniddU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3-xNXUiTE4yghzuPFO-mismd8CMG5umL_TAs4pm11Kxw&oe=69F60E38"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdNRhOXGoCIQ7kNvwFjg3DK&_nc_oc=AdqHoaQ9lUpD_6kavFybZ3Om213q5AyvYVBwk5cw5Ffk39aY9rXAyIga2EOEHr_-9pE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0QpWgTNPY0SRG6WODnHeNslQ46ybZqo-tVgqKNh6dMnw&oe=69F606B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eeQKW5JuMEQ7kNvwFB4pU9&_nc_oc=AdrmEZFw0GTbS07PQeLJR4a2YbWRRtTa8qnKAQ0ggBSETzv9NpukTA-Kgc6Cl0oAdss&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ER0KJBAuKQE6XQ9_uC5oYHZtxs-S4nIpVP2_P1jD1iA&oe=69F5FA20"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
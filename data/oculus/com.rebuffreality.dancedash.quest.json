2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RP-VMr6sixAQ7kNvwFFOjgD&_nc_oc=AdomneyVYtBMi8p0rmgw5nZMY4J9OR6shQCPxoL1rB9ql7NTD292MyNKkOLc9sX0N3Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQCORInaCQTKsNHDlgSglu7zJT6UpyR5UjUfElc-vddA&oe=6AC8FDFE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysD5jHthK3QQ7kNvwEY1APX&_nc_oc=AdqJPw5rvn0ReMCWpis5mh73vKaJEeBAUpPbk6ERWcdue6fRZi7KYSq62o43X5x1AY4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3LlbJYFmDQIHnND8PGuU7vgggmlkRfaS4p1sN9Ktzwg&oe=6AC9003B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0KQYoVC3nYQ7kNvwE8o7qZ&_nc_oc=AdoEV-r7SQ4_fUEngPgQGFCTOTsFOupLioKt_X3N2MxtI_5qOZC25RtjlyIYU5nlarM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuwWnhv2-VZSi8OXl83DwIeAkwSVLnKzxLbfYaAEpzyg&oe=6AC8FE38"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVKGTzEb1U8Q7kNvwF3bfpH&_nc_oc=Adoi0LJHF2cYltdh0m35tNcqP2veW5WJjG3dQ-aMPBkGi1IJzNcmFoXU8zAWh7cCl9A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKWo8D-czZW0BOLq1snISgfsH8L8oPa_QlV6lS9FfaIw&oe=6AC8F6B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5tM9it3AukQ7kNvwFWxBlA&_nc_oc=Adoza2HYX06gjuBTabcc-OE2s0QKqXPEhJM0LObbNR7PAPuF10KO-uFz0j2PKZTvibk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxQJj8B2DqzX5IsRBooTZ1bC--rFKVDTZTvXy0k8sEfQ&oe=6AC8EA20"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
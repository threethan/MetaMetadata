t=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOuXxikGUGcQ7kNvwFKCiEp&_nc_oc=Adkih6_xLA8P9KZ_d1hQFXJyHefjIi5hz7xkYpFlFNzvvkcH-8OoEPqm9rdQ9Q4Havs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXCq_1ckqq60X07EwGaJX6HG4usP7y7-PNR7SIiONpVw&oe=69B147BE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTs1wuCl6XkQ7kNvwGkDmh8&_nc_oc=AdnIL1P3OfYx2wm1Mp9l-vbvPV2BOGJEGOHuRl60BtoxiOO19kv_hQM8dCWYlvnrEow&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2septjHOKRVDqlBRIcnJLcEkihZo2I20R4AHBV14SGQ&oe=69B149FB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yemjj0sQ7EwQ7kNvwHOzZZ9&_nc_oc=Adm14ty8ji_xJCdPaaAX1VbansOYpzBAGV0RhzoVTc7rvdR470nMmRuzTJ9i8Z5AN1M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-mRJx608Z_Mwfe8yyjle-7PZte3cQ6U4g2p_8CA9Edw&oe=69B147F8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vQxNSNFJaMQ7kNvwGg6LJ2&_nc_oc=AdkyzwhUG38TZXVQzz8S4qbBg80VqFGL6gj1BJfpm42j8Uz66AgIXKbZnrFntmNRtJo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxr6xqAJyN-g2PJYKctUOyErIR5-HJCfqhCGPo0FpYaGw&oe=69B178B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CVR8a7kI9kQ7kNvwFDW7TM&_nc_oc=Adks6qnkxd9QJzOY8_5vxtOgvUCozRUojbnBfLCCc3OXUcElfVk23KxSKNR0sJ14Jhs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxgUvaIpBIwPnthfUEmzthk-t1n-NKivacTqC33cRP1g&oe=69B16C20"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags"
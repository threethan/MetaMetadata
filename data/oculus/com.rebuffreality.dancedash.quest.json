2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xez9-wpWDvoQ7kNvwGmSvMg&_nc_oc=Adpvmmgsk6UgDbSdc8leGmwM8vLuplJqO-eZqMDHyyMQp0E9LjErqf9YyrV00QRo0LU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WM-mce2lkEsSG8Fg-tWm-oZmcwpWTOwqDpPeOWigXyA&oe=6A31617E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tj8T37PHpXkQ7kNvwFKbMe1&_nc_oc=AdqcE_wIGELJ3BidQ8H_c26TAD8HMZGlrtMCmtK3fKh-sFko30JqJ7vpToL5hq3aZAg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Io2ZL7Y4HPH8D53cHlH_T63dSyQEBM5q1g9Sd-L28gA&oe=6A3163BB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oEgAqb5eJcQ7kNvwEow6ri&_nc_oc=AdoL77q9dGaNffmi9_vr9UU1_BHJYHLOIcYqD0hDAakj-Tf11B3vPT4y4g_F8U_ydfY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3mJyO05CNTq6TQdoev14vz7gZIIHOt5R92DfDnR0OYA&oe=6A3161B8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ynr_ltaMs90Q7kNvwHygxKS&_nc_oc=AdrEKirFvlEo_lumSdJ5ysQmlKfcLFsFfrLVLfKv3w7ubdG6cW4nV-YAC8Z1HM4yZ7c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0jt5xtOEWHn1mjfmp2B9aepmPyvYVciSNm7f86RVKxA&oe=6A315A31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1w6ylxjIZHwQ7kNvwFRqstk&_nc_oc=AdpSxMmNK5uXsKe0oo_RJDXJ_OOiIl3zW7XWzFKbQkWoTT1U2OAaz380h9JIYEtVvpQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rlJfd-H7vAX_VgPiPJgUCf_5_7p_7IsVcWYV65Lx9LA&oe=6A314DA0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
90158442676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xA5Oh1YCHAwQ7kNvwFTsHN9&_nc_oc=AdpLDxpnj03j-o5f_ffeC6-_tvFeEJJreNr2EEWHrege4o8IovpxcV9UkxYZhpOJImU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJM72lJm2imv4gpmImJ3Ry6agOLdmDa97cRXuCzLSiQdA&oe=6AAE9FFE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3450LSrWxk0Q7kNvwEgEbsv&_nc_oc=Adow0X45mKIWNROtiaeo0oGf34sWUpKGm-xJoQzSkkwf9ugOfEjqtAYq9sqHmCgmkFU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnvZzHiq7_76HQ5odMfWuO0LhHus5i4ssRIkdIjeA2fw&oe=6AAEA23B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oi_WETGzK9cQ7kNvwGANIG9&_nc_oc=Adr166byQHnbIQz7QEaKQ55uJDrvan-R7JYc_-xJ_MPdfwxVeVL29T_2la6H3DL80u0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKc7E2BIiqiC0VQrBt3qcLCf_jv1BVgggioGxtHmSuIiA&oe=6AAEA038"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3qQ2S73iNcQ7kNvwGZsCha&_nc_oc=AdpIlMMOk5FhEFYLP0LZZYXrVbRhp8tLPWUbLSJjjY6JMW92EmNQmGoaPOdSAk9_Bwk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJn_wTLOlOtVLuiApdhhZ4wf4PWt4kVm8tl6XZ-IUXc3w&oe=6AAE98B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RVh8xNV0QcQ7kNvwG8uA3i&_nc_oc=Adqt1i3jtKC_ceeW3RKhjPok3JiPp24zqrv46Hd1PJxuu7K3mOV9IAVux4s8EY9_rTQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR7uC44XTOJXeAe8hDFY1AgqxslNxKwLW3pr2lgWpSfQ&oe=6AAE8C20"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "cate
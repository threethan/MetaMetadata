2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1DXBNF-sKkQ7kNvwFtWsye&_nc_oc=AdrIEdqeY-VZvJTYiMq9Vwa5dybScBvEi4uVigDXV979J0Hw3DSzh844-tdCgIRmI7Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3B1KqFLzWmh0g-_jTh_Os280WGQiAeOTBwH7l_QAvd-g&oe=69E63BFE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHxmW7dluA8Q7kNvwGgwJVH&_nc_oc=AdpJDdUk_rulCDF0W-jAjh-xhci3buLXp6Q-vIus3c33nyPX_v9PO9Z5RmmJ1dNeRow&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36C9qrRRqFh-LdJXb8IdO2q0ctW8LdlRlRKlqLNq1c2g&oe=69E63E3B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IPx6DFwbtkQ7kNvwFzgdx-&_nc_oc=AdpadKpbhTF7ar5wqWjmR4MG7TKqKUhqntnh-IfU5Gb4h2VtbxCS9m1W62C3TFZkD9w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1P8v-ZtZZvzUcwcP0tQ4Db7UdHlgbBNFfo4sdHU_cxYw&oe=69E63C38"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GKGlH1c8ZkQ7kNvwF1dGaA&_nc_oc=AdqyFv-2HR2m4psLN2yyETs2PTQQIGzHmUm5okn9FmvGRt0V4TgzRCekOnqaxFBKRJk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eN48d_gANFgzXI5wqjKyeIn0gV-61rWokV0H6L-1XeA&oe=69E634B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKluI8uncaEQ7kNvwF5GojN&_nc_oc=Adq8daaxE3NOlrsEZ927CGv6jNZJEiDGU4bRViL2Kac4JcUnquL0uqFBcGG9Hx7Y7O8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18j5nFiFkxOfVUjZ1boXXSseb_40zQ3lUGpsaNriQvdw&oe=69E62820"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
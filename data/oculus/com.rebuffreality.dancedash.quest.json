2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZPzJy2xvAkQ7kNvwFeU1kk&_nc_oc=AdrEHHy7rBYmCeJtF4sb9kosb93EOreiqryClVK8YQJXaDDEZZZIztlR2Jx3x8ZPdvw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8j05UzvhWNbLFYszZLYqUO7QSkyNakDzaewLdyZJxxhA&oe=6A34047E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tj8T37PHpXkQ7kNvwGN-eGH&_nc_oc=Ado-ISjyuaNw-rtm5RJtsJUxuv_bygUg0PJ1Wae-2nXS3_t3J7ppLRuudPr-eR_V0xk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8q-S88FzHLjHcMiAsckkZ8Ue36jq5UzhQvq4HDAVHP4A&oe=6A3406BB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAvupM29PzoQ7kNvwFgiqXc&_nc_oc=AdoMYUvAO7eHzJsuvtXCkIAdcXb6lSmdKy_MS9OLmIYnzr7Fa1txRpV6TiM_npL4AJg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WNwNjxnESaSpmsBpM9lqvif9f3VuZV77U4T4_s5cEag&oe=6A3404B8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hmp47R1SaWwQ7kNvwGccHBA&_nc_oc=Adpbf-m0w6ypEk-1AlA7pCgFaLArYh8SGZ6_b79Btp58hZQvvdfkiW0U6PQyjkLdqv0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HM3QINBO7yi9CPGBSCMYJ3P1JRR_gvrKXa_sarjWV-Q&oe=6A33FD31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YX0UzgyqmgAQ7kNvwF3aoXr&_nc_oc=AdpA-huGN55daoqLxdTzD92x3FO9PBwBt29dJWF0lCeJ8z1kspHDlqxChjMNzfJ8kZ8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8chpkw6A-TLBahW2thLIHVbFgHzwW8zuX_z5C4m2iy_g&oe=6A33F0A0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
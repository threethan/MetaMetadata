2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frRlIs4PrmoQ7kNvwFuAStv&_nc_oc=Adp8Tho7hZqd5U0ZtTGSKV-Sst00tELo_3ofHLg9QphWDeEQE4Qax3tepSIXgeAGhDc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_MGRV6CnuBzyTEzJH6htd9t6AkflPImNpT5RTXnqymA&oe=6A58EE7E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOzhPp2l2sMQ7kNvwHdd-6V&_nc_oc=AdqstGOBsBWCRtGhGFkzRa7xXdcj6IW9urKdCMdGgMogW3RfeuEp060gC5uSMugIbP4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvV1kvLw3e_IWQWmxQWr3t0iR-zwcmOrGGzDYx7W-WUQ&oe=6A58F0BB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SicFNEhWS5cQ7kNvwHvhMBV&_nc_oc=Adqz0RXkddSPIJ1dUFbpAt4wjUPX-0rJhgwv35YVdcMG6T5b78WYVb4DPFtOddwFhnA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAr1g_mVZ_4zvPrP1AjD3piZ-Sv3ICu2QDgygbHLZv-EA&oe=6A58EEB8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPGkuUmdCokQ7kNvwH-ipRu&_nc_oc=Adpt4W8GQn0fe7OmmdshK2lmiE8F2lbuz4NMmj2T4VqDariB0eI_Id7cGZByjMAaxlA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-9pNV5vdLNUGi0Mh_J4UY1caiEgQ6IJx2TTCCba-xXA&oe=6A58E731"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9ly5-_8wwAQ7kNvwENyrnR&_nc_oc=AdqgQ9z0e8-3GSYwz-OWmGoKAjt9N5XZgDytmkaYovKo2slq0UJUrVW2_GrC4Kd9G_o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClksR_OO2Ic-6WlanDLsBLqLwYIrIswMFfB9d6DCu1CA&oe=6A58DAA0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
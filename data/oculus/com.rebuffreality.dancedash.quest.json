2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKwo9d5SsHoQ7kNvwHvlVgJ&_nc_oc=AdrtkI2UzN57ZlZj7fXIbURKUmTJwTnfFzkkUuJV9yXuYgCGjLtsGN-rrBaWVJB09ls&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClkGtSIemvdTaA2B6Qwo85Mv8zRIOS9X2xCmGWVAKjtQ&oe=6A4D10FE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W77tVbvTDHsQ7kNvwHiKm_3&_nc_oc=AdqmDhF2MyREbWlvT5TAf5ox1c-9ffmok9vgGfpr4g1fq-Z6FrVfqTiop1H9D6yTRW4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBErG880G8IphEdYkpukSC1Ixboiav460jIoJ-r63UBYA&oe=6A4D133B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qU-i8OPyMr8Q7kNvwEDhElP&_nc_oc=AdqKSbfzR1AuPtfmqk3r1C3LMFwJcrUiWe5ZMdmcTSLUSDvSpWxcIZboxTeU3zADVHg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPLoj-SbuRl3K_BrfZT3JfjHfZ-ar8WXtPBW69fr604A&oe=6A4D1138"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwuNc39B2hMQ7kNvwGI-brk&_nc_oc=Adp9i7JL-r5YXvrMpkOiY_BYnwVhhR2RNUYFzdkIqNSKt_kcyQcW97-k3qdaa9soujw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCS2gb_ZMapSGHCS6_QzU8TwBUlQSVQM5uahfGEPshfrA&oe=6A4D09B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4IAlpR3lmkQ7kNvwHJGVau&_nc_oc=AdoxjiwJ02pwe6FkmHE0GbhXwve9EnhbNrE-4WE6B-Si7gh_PDmNnyIiktaQ_qiRF5o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxQCVyoAEB6LlEfBBS12Hqgx7VE2OLnKUbM3Nbe3BTSA&oe=6A4CFD20"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
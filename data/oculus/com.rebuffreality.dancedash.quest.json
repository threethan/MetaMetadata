2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKwo9d5SsHoQ7kNvwEpC5yI&_nc_oc=Adp4BIsah9bvixSQ0d-DTmd1z5m9klTokrp7Liat8S5b7NJRIin4BdCHA8sIyUDeU_c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbaJqGIxGrgv8LrNo3416AheUYzwJ1Ma3plux8La0W7A&oe=6A4A6DFE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1p5MQDhRQ0Q7kNvwEUi0F4&_nc_oc=Adol2RQ-t9EnGIWAwQw4PLoxqgu-ZTQOlqu9ZkG1L-5ZuKogrenk2BAtCDsC-xK3xjU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtGYsxHxtzPDDwukjc-5cIYH7c3w0zsPAQZAgsqSy5Zw&oe=6A4A703B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAXENuyb4_wQ7kNvwHiOFLX&_nc_oc=Adro4HoaJdenmGh4HyMzpElVlaGT9IZc_ynL0P43HMoRO9Lj8Fg2SZSMwe9ahlLcR98&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNlZUDs62JvbGGb55Dx41nMQznDKX8fF7z8vVS0LCf3A&oe=6A4A6E38"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwuNc39B2hMQ7kNvwEuLSMO&_nc_oc=AdoIgJm5DUNrZA1uBkZNeHo4DW6RCAiOE-HLA10PbuTeIAqowJu2UexE5Pca4B0cymw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAk6FWYLC0B8x-DXnpmw5rNiEfpRZkoaCYuDccGAPXNNA&oe=6A4A66B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AS3JC2X3XBkQ7kNvwFNrUIJ&_nc_oc=AdpeY_N0iudE6KzV45JnpEtFwQPzjcm1lQYNVK7wrXjUiYIZdIa0wf2-RGc1H0EYcLk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBi1P4uww1meOjo5Oz_wtSmQBhlsC4NKAl6iS52UqVK_A&oe=6A4A5A20"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzNLnmQYsTUQ7kNvwG3gAdK&_nc_oc=AdrTAFJm3fEJVF6v3jRJe9i_fIymqGWgtlf_tLMVeDEfFB8ncfPkn9tMKqbO_pFq2NU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0krVGd-EcN9o8V_Rra87HcBVw9wInf3EYtOrC1kMDSOg&oe=69EF767E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJMDBNqbxMsQ7kNvwH98t8c&_nc_oc=AdqkqKiDekVtmtFT3aIxHU5oYt6I-bkKMdxY3LzCnR5Kvpct0W0lH53Cf0YNYPPQ7Us&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0yC_aSETFqo_3WQKIrYBOUwOy6-lpbYRUv3LK_YjMUZA&oe=69EF78BB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eJGwTgmlC0Q7kNvwH9xWkC&_nc_oc=AdpxSDcGcZbEAMIx7e1d8UMd3LjX6O_ybKwrdXnWTfaAue0IOxO-81Hu8xYYRheweks&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af18_gVC9ttLscIBHKIxU-DHRzjg-2MpxzZeyE1R8nM0-g&oe=69EF76B8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBlmViEQat4Q7kNvwHI759b&_nc_oc=Adrm4BLqnoFSkTLN0f1TubmoXu0liRp2bBvmbTElirh-FYhZ1w9wLzJaBKYGTnNFBcE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0vhgptABFtVb6O6kYRfpuvrI_mRXU9aqyBwcC3NPvGtw&oe=69EF6F31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcI0W_h8nboQ7kNvwEyXNNv&_nc_oc=AdqXz9qRuKby-20BBK-uiu1r1An3ACX-5FgOPbEHFjttSjSZNkjFsbvPlnZgWsgyyFk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1c8RTPFOB6X3jEWrItZKPB0lp8xH5hpWr5RGDPs5zBvQ&oe=69EF62A0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
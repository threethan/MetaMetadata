t=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8ayybsZe3oQ7kNvwFegoVC&_nc_oc=AdmfaiQsTlbEV3P9b7ArOqZilHQIw21KfRoS68WytVTFsOHCyCDPcSj2OU5VXG3l8yY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPaBO_4yzmYmUpWh9TOuwYzPwdvs95FsouUWiyjgM4yw&oe=69BC0BFE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgQgjmRy-EkQ7kNvwGlYlKg&_nc_oc=AdlaqUdcpwkLeI1LiVW0ctpn_TxZq3Ml8msvmEYoPO_xCL1Akha8cE7f2JbaGDNNfFo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzhKH1AAIrDXvsKDqqr0nlxFo-IAbYn8gukffAPROoCHw&oe=69BC0E3B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TB4JYBUsamgQ7kNvwE-pdrn&_nc_oc=AdntZzZsbdR0X9pKqrnE1xb4F-_7-aWTDceA59xevwXnCohHdA6Jk-jIcoxWQEORcTY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx465E_qMY1JwJfvQfmCnlHi_UR6i019B-AnINaE_9_Jg&oe=69BC0C38"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcYmBcdqdBgQ7kNvwFrQDsw&_nc_oc=AdlS1oWtr4jwZUdJrsN6BCcNJ21YCjsYWhgCpA8WlsHnVbgxfDB5exmEktwUFGuHaHk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyjoa6SHYwQXiCjy7O7c-HSmGlPEYGJCLhbuwliIMTKDQ&oe=69BC04B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOHKI8z4S_kQ7kNvwGjadaS&_nc_oc=AdlntFEsI1TVt973GwBHuDPWD6gGF7oBmXPjLVBTZTiwTLyA7kQVX5mCf91Qyx2OOEs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzpcM4-F4uR1Uke6eImsMNFgBfHCplio8SHriT3lfQUkw&oe=69BBF820"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags"
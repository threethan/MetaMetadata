2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqX4XmT_wn8Q7kNvwEkovpx&_nc_oc=AdoA9OeMjOCoRZgURV8KzWmqFhjUOW8TAOx6A3w4ZUGfMNU7lN0Xy5UjllE5QujIJgg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoEsIYVDg4E-eDOw9Obczh2J3sCAgTZKrvAQRscCV-BQ&oe=6A9987FE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6KqvAbrPtMQ7kNvwFnSQwO&_nc_oc=AdqRY25vubPyX4GUilErhc2n3R3r3xK78KfE_dJadoJw-C6IzmObspvpLo_J_ATPlqA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEMEF3YvJI7PgOzkg4lnT_VhRh4R1Cu4Hpoo4LNXNMJQ&oe=6A998A3B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cagyBqu_i5EQ7kNvwHkoCfv&_nc_oc=AdriULWwwhsG-sxvpMvUqWRXYk9DQxHBFNO01RTC_uwkT77SxCs9E2IHPu-zXkct8aY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwhhBZFmqsGMZa_euyD6SO7DvcspHTD22SypWgzimPpA&oe=6A998838"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyyqu5-8apMQ7kNvwHuu-UK&_nc_oc=AdqadwWAa2coZjG6_os1QKpvnkzCA4m3EveJsI2_EzbuQZVUzTHNP1pPtzTadYMEQK0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3XSlLMNdGaIn3KTljhfaS1CY5rGU2Ej-abteq3jg22A&oe=6A9980B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJJxnFqDSLQQ7kNvwEre6xn&_nc_oc=AdqLodnqv1rHG1lfbv6x8uy6up49_Qdxf1xTutZxqzFvi7L5ucA8dYFcPSQAlNt-oEQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLu2JY6fLJ_ERF-nG_3vcNJDlc3FhAhexUY6kjtJSp9g&oe=6A997420"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
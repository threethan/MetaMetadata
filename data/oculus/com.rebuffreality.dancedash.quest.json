2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESZ_ZeD7GKIQ7kNvwF0LZnQ&_nc_oc=Ador-53iLPnIdIsC9EA0DIfthvjqlhP-s9VP5_KWDQiHv4ATflmAjQlvE715XPWVPCU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjTa31uOja6TiAMSAXeGWZ84k8eBzr2V2kK0npHaf4Sg&oe=6AB688FE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BiozwskFoGcQ7kNvwGH1NC8&_nc_oc=AdoRrdgCsngnkH8MZrGUJvXOgc4ZKcNMISQmsnLTtgt2wf28rQtUGDJ4wtbu0dqkAEo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJm2UdG9rifrCCVFvrB7GPkNVZ-g6dqE2Ax7hniv-eXig&oe=6AB68B3B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9rO1YvoHAoQ7kNvwFMGsvK&_nc_oc=AdpWp-1U9pUmXP2o8BMl8xuuGpr1HGLZdx7g2qFyz7qqkIK2fwgwvuwHR_LuceTI-Bk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfjmq6L7iKY7OgB6mOBUgUeqf8Az-rmuMhniiOWmWsHA&oe=6AB68938"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUvZ1dvGH4QQ7kNvwFetPWH&_nc_oc=AdpiJqE-8dujpz1SjIUztpD8O1SGbwzWvNjMylhZuVuDlg-AgzPR2D4kiLc0klKqq40&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICtWP1hIQmm4nxq0vMWqpKSUtB2qYLxh88sjYel4YOXw&oe=6AB681B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpIS1DZc4RcQ7kNvwHCiQ1V&_nc_oc=AdpDxJxLSK7TnhuOsKfVQ-YFEVyw-pSVeDSlfkKZ7mnOgOxQwz5zoRaCfbS0Q-YkIdM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhzXpp47UXZGfnaXlcXeIrCLCbwq6NbA6WfZIaVHTQpQ&oe=6AB67520"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
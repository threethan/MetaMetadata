676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K84R6ju_uCAQ7kNvwE-dY-C&_nc_oc=Adobcd8PSt2uOrMvijVj6Vrs8sBXT1MMiOguYVMaLoikHgXBUybHPu08yPy0a-r3pJY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfymBDMVN-PTGW5utQbR1tJU4LIl97ayQFssEDhiDJl91A&oe=69CE80FE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgW_G-_Mde4Q7kNvwHEQWZA&_nc_oc=AdpQYN6qlILqwrzWiSK_htPOWCsn7pNaGHzR7pzIFkDVeFdsjt6eLuK3InxJOnvmbNw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzTEucJApSB_CqXn_zwfETxF8ZPANzvVG_HT_D1gB9E9g&oe=69CE833B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZA3JUnm8CiYQ7kNvwH0t5yU&_nc_oc=Adr68NemFiuJDX0HpAKoYPaDUPzfZYXkRWv-El63xquiSaqR2a-fKYl5foFXI8sTYAM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPk7z6NEQ22alAJVtdYl_l10ubxZRb_p0WVurxiUvU9w&oe=69CE8138"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dd3DdkZEfW8Q7kNvwGy-VLS&_nc_oc=Adq_aZP6WOjbZi6HjRl60N0hIU4JayyyQ7ZtRLqqrdSJ35kfp81n-pffnERVk8Z5jGc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgE0aVhmMf3MmyGR9XRKNRayBAOxPm9eCrdWnx0uVp-Q&oe=69CE79B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2a_HTwEi0uYQ7kNvwFPrxei&_nc_oc=AdqHpMLIJ713TZWp3tP_uprAK6yT688bzzdJzXnmz8HOBH69Oz_xD1j3Rolob20UjNA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyktLtPpjFCiNcbtxeRmwGyI4xh49vLaqOURTW35aonfw&oe=69CE6D20"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null, 
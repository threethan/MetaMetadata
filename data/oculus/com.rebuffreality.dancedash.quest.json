2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n__8ZyxXJiYQ7kNvwHxjWaT&_nc_oc=AdpUGBlfHgtvP2q1j2i9GzH-wJOMkWl910y7AycGLWGtANtcMpzX_DhLBDfYZcb7D0Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnSx8Ph544vx3OIwrVFC-G13I4wPttQ0XrS1A-rEL64Q&oe=6A54F9FE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ukXtZCC4AkQ7kNvwFxP_kO&_nc_oc=Adrz5KPQfCqlRRj9otg9gKt4ObV_9h7ErOVJGEx988d4UNHT9_4-w6VtbF9eEsEN9l0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAR1fcURojbd8YP9zMgASpmDdUmgXb0Mc1g_sjUxxJHEg&oe=6A54FC3B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVOo0J2Qa7oQ7kNvwHsKnda&_nc_oc=AdqPj2zRUDptNv_2gBKfcjGjY2Q9gW3SwCDQRdS7bFYyvkWpz8zKt6rSeDhXxp6lxss&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB69epILW6UXsu_WRxr0x0uKWP5jaYIa76FTQXMz-tbKg&oe=6A54FA38"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JovuVJnSULQQ7kNvwH7yGQY&_nc_oc=AdosN1tZTWVIXPeftwFBZlaAnQAq009VM-8u3L4NPVamYzfgtdAPfCoGp0fjmDWc9Ws&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAX-8wz25Y1hfW1aq3_OVCrJnI_sfwIEElk6aSeGZqXlA&oe=6A54F2B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jiOZz9pkZwQ7kNvwE7VmIU&_nc_oc=AdpWiNCOImGs6DSf2WI2-HuB3arlxL-twTq1tEML8iippOmwhsWHqhYRAReIFR0dkrY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjT-WaXwXZGeoA7sAIqKxauACop2cWf7rkPMvo4oG3bg&oe=6A54E620"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
t=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3ddq8Dd8KsQ7kNvwE0mYSM&_nc_oc=AdlYiIGooTjt4IG0YhfkfP1Xt0WT44fLL0ylpOeIeo9O4pFKwXxWj0RTYv8rUBo4SYg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw_Ec5BIbLxAvuqNGk-3j5w_ZODqwaFAGUp8SYPhdoTsw&oe=69BA823E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgQgjmRy-EkQ7kNvwFP938Z&_nc_oc=Adkmn89KefDIJd5FuHxYf8xIZkoROvzM4cU_OVOIOnmrvn_YZYHZbs4v2r1M4ujHMpE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyKHu5IoCGkfRLDzSVLSixlSpXkxyZsKXEztzu7CYYnFQ&oe=69BA847B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TB4JYBUsamgQ7kNvwEgSIrx&_nc_oc=Adkj2qIj7J5BY7la5drZtiFLJjOg_TRWFGOGwGvM_VxCYUo4TwLFon6PVJkXdlXOUP4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyj7pJLCUQ_nCjvk_04B9lQR85teUJ05KepqggxQy-91A&oe=69BA8278"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfSf2-sgODIQ7kNvwFMAFnD&_nc_oc=AdlSCugJe2bcGJvToWxEjDsTJqAO8XwOc-ig0tTSe1nFQmF9jZVCEzY0Y0Ga5EVp6IA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyN_0Ivp8cyd8_phyeANimbIhDH2xRjCGHBKihQbgELCw&oe=69BAB331"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOHKI8z4S_kQ7kNvwGpqixB&_nc_oc=AdnjgQSBofL3nGvD7icWYwa4m1Gff2hFXqClfJ5P3f9pHJw5-dBsYQ2w4jRfW4zjROQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyarWb0dzfsJo3NsqEWSrJeE7ekNakTUrbX2zXr-g_pTg&oe=69BAA6A0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags"
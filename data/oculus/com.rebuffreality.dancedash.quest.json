2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ld9dbKU7iYQ7kNvwEN-n13&_nc_oc=AdrevxHy03AuyzcToQ94FQZ6M9TP3FQSsGPPSPTYgR8_f94I_XbwxVbLKgSEA0xx9Zs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FBV-cfVuM5dF9enj7EqMt3QcHfeQr6QeiUIc0hcuNTA&oe=69FCA57E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzEhTrjOAfoQ7kNvwFGBCZS&_nc_oc=AdqF7s2Qtj1P7LVGMqQNJ8p6kPTqAVMbe_XTbA3R5JY0OJt54EKmhyjZAIF0YJF1X7w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HKS5JEO-C47lV26B29VFlCKv9rz0ZLXIm4RdGwRSN-w&oe=69FCA7BB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjUJINM9d6EQ7kNvwEK9yhZ&_nc_oc=Adocw3pFQnTTcIXDDFrlTycXeJHxM_x6cJUZ_bW6V4yCkUzj9nmhuGbNWpbQ5pvoFig&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_oRyC_HCcQp0F6iSwAPLrA4uIqhTfwtjDeKLI8bBU7w&oe=69FCA5B8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwVRb5oNG70Q7kNvwEcNGVt&_nc_oc=Ado56q1p3wzN8VVxNFnCZMIgtyZaWTYmqNHRSEY96VvFiWj5EVSFH9Vw2nSXrgekYCw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4P_QdepU6m7TYQb5bZx_vWdfsjIYOMKGrn0F28pxY6WQ&oe=69FC9E31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6Wn78dwsKYQ7kNvwGLIDt8&_nc_oc=AdqdalWOGZUhxANIvI2QgVCPsqiZ4Z2myeo-JG1aCne8JCVXekYobUkzqZ7RckJjQJ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fL5ubpkFiBBB7HZqhhZ3GoRYtOxB__NE5trA717geNA&oe=69FC91A0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
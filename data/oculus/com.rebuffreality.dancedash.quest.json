2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-G90EnPkIYQ7kNvwHErfgJ&_nc_oc=Adph8yppfcT5VEM0qMY0UxahRTGON260Zijy6CI20az13y8MT_2fDPD5gZTGsuO3wlA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMR8g4YDjb0ATLyea6DsGoDOhGXHL87owuLddTJTj3CTA&oe=6ADF677E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcxt3Yju_2oQ7kNvwFbKerf&_nc_oc=AdorVM6bralyr7v3x8BhSQUSl4JgixyAo7Ka6i8F3LByOI_YqnxwT0O5Xc5vZJtl-fM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPijXSy_rMJIkm5RcNPYdh1G1vPz3FVCZ4SzrdxIL5JCA&oe=6ADF69BB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_a68fd_IY-kQ7kNvwGaPX65&_nc_oc=Adr4Uf_1El6ELQ-OxE14KQX53sXJeu6JKtcWYlb5KdM2N1mrTTSM-EBnJpuglmUbQ1U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1WUjdGqWBmGwvGbHyJmQKWHiRG9YKszxNeecsg91PQQ&oe=6ADF67B8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_KC4nHqaDIQ7kNvwElm-6J&_nc_oc=Adqn8tc0AGjwhY4OuE2w1kGSQaJ8kk8zo3S7xO1ujXljps0qldtr0A6NT2RoHAINJAM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuCFDrkANhngawSvaFUbuw1BGJBx3BiawB4D2WcCrvxQ&oe=6ADF6031"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ous4htiMLEEQ7kNvwEb2IX_&_nc_oc=Adre_wdtK78ygFFN-eEQ4juaRUrYVmn5UJKydWrheaPBh4gHpKqmpBri2LALAjr6PRc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpq4TI9EmLR9-Sn9ks1WgFtnNhaUX8-N25QYst0t2YJA&oe=6ADF53A0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUmNTTq_tAIQ7kNvwGkYCOV&_nc_oc=Adp_nxXHoyZ9pDq0KvF3W2JQgGTwMN1SaGy4-CeLHyXM4_JR141kK7gHZIdwDclhl_o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_-0eZ8szwGHveLjH8ac6FTFoUp1SXbvdAaBn7nzWGJQ&oe=6AE4AD7E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZSbaw601WgQ7kNvwF5I7aR&_nc_oc=AdrsV6ROuN070m-IoFFYgtzje5Yma8CWXIKAbDxpbPPnMoPlNYx8RY3D5yVOk7pVoBw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMW3i_k2SCcYJOD2PERLZ4KzmmYYpY6QDBqWd3A-911ug&oe=6AE4AFBB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hav5_7r0kIMQ7kNvwFU-nAB&_nc_oc=AdoyUS6tR3ZTPoAevDasufzxj9CDc8lQogafb-RPChU9_Uqm0ttoJJkbtcjGHOstop4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMc8QemrcgcSxZSLJTVcBf2MViHk1BThewftXiJlWnuNg&oe=6AE4ADB8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVDFsgrNdrIQ7kNvwGui0gP&_nc_oc=AdqT3RGvFaSiEXPsdnWUXKpR0MofOXnYpsp4TH3iC7y0_Nofgd70qpyu4ZfEd3lh4dA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAKTF5PYJBqSDo5o4aKlfH8YsTv9x6lwwhUrSb3IL6dA&oe=6AE4A631"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqKHKocOp1sQ7kNvwHOtV-8&_nc_oc=AdqTwxWetRVV2_oAYOejy8abcURTtslPMM2EMQ4sKVAVxrnPZVPmsXNcYOGB2jKnUtk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiFUlB7FVBLpNTC8Lnyk9ybi1HMlydBWJQ7DwzLTqquA&oe=6AE499A0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
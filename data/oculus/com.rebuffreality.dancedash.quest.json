t=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wPN5zFupvgQ7kNvwEcg916&_nc_oc=Adnc0HbuPaaT4X2SNEySByL2LBGVHSi-x_9hMgqKNBp-pLcLzV8RwOm3I5PJq31N5kc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3kxnjl2Rk1f6l2JC8jn6-zPmAaGfjzDgU0_UclSq8Rg&oe=69C0007E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyjvoUtGh_4Q7kNvwGtepeK&_nc_oc=AdlmBlZq6khyjHzRqFc6MojogxHX5jj_2aw4ZjCd5OJxOcq8HtfZc511-bL5HvEQPOA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwvWAmeRZgCxD543sL_96xRJAteLn-j8UkeKkK6ETs3UA&oe=69BFCA7B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3z_RGBrL0MQ7kNvwGnIni-&_nc_oc=AdnyXc9Xg6bwqbDrz4Qh6i4U5hD56n4rIzj69s7XP4_CF2XzkJ6766aiZSWq2YMmAO0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyaiLKrcrtqVeXelMIzEGjle-yHl3YSB5oDbiErBwy4OA&oe=69C000B8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsbhIV-K2H8Q7kNvwE842qj&_nc_oc=Adlgnr9GoOCHzEO4m-LaPk_R3wliSkD1VyfJ8o6i-OYwwzUK8e6lbPzGUSUVBQALmAU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwH17fRq_Yrqvqg-2-SR1BBfcG-tONiPT7AFbPTtiYagw&oe=69BFF931"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9mnvQTdygIQ7kNvwG8TnpE&_nc_oc=AdmGIu3_Dagjt1PR0n3WUaOk7ZdC9Amqmj_HkZRdPCK42PUiMOOkEd69HkPBAFsV2ls&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzyIC7c0LTLi04LsGLqKE0VgVcUR9wiW6j4DA03Dwk8hw&oe=69BFECA0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags"
2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XS8i3lts3LYQ7kNvwHyXmnr&_nc_oc=AdpMWzy9bH-Bx_bM4ctgOOfZJMlxrngaf4G0XWOxk-Lnwz_MUsN9sOmcVxMtBc6FIRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52xXZ9cF3Y-EGoJiR-9j4w4CYIhBSuq4YaHSnS3Hju9Q&oe=6A1EEC7E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xF765eS03DkQ7kNvwHdS2ns&_nc_oc=AdrHiVXUFWOAbSyOZNJiOWtk6AKNhABOKRr-pchw1UUC4w1o2QbDAXIKkqOCkX-8tPE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jHM1rJjOsB0qyvjjdrEK4zuzJeXmfBe3YGbyZ74zxUA&oe=6A1EEEBB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmfUhKJ36cYQ7kNvwGSXhbU&_nc_oc=Adp5G3I4xUuz6Sr7SQvez8vrFX3BzSKHKZd-coVG5NHfx3S-x8QyLyvhWWZW9exltV8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CGBPn4ma5O5AN2TOKkj1sb3UbW_CK1DZ8MjIb04GzCQ&oe=6A1EECB8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpitQea7V_gQ7kNvwG0MBeX&_nc_oc=AdqElecXAZu1xge7Du8oaMJyy_SZfrqLQGQ6UVBrXqPyFBsX3VjxxteEHXRo7P6ruBs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61LZT9kp6igf01LLypNULE-JPRm2LTUyckRgqnvIPuhw&oe=6A1EE531"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymJ7c61yerUQ7kNvwGQDMa4&_nc_oc=Adr-qPh9VQj13NWDvciE5n0zKqy5IzKjd_hwAoBWwrdPq2ByvVBD8hYd7ODWFkafsYo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FmiOK0XKZPpj9KevAjsCs6G9vgHRKw_nDvhDtGk4ycg&oe=6A1ED8A0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XS8i3lts3LYQ7kNvwHtyOIX&_nc_oc=AdokW8xeTz_nW1J-uhvKYW5PmC1Ok8my0DewTq1Nvi7WfUYgZ7h2dx86owklo0uQ1bI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aZT68EIP8f_S_csaJ5IbxydlYCIMsXYF_7DAz3atSUg&oe=6A203DFE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xF765eS03DkQ7kNvwECvZRi&_nc_oc=AdrKwB8ZvgL1ULhPtHyb5K0xhzj4aFjWa3tjzezNg79jNGDVU9EL9LXoa5q6voM3DSA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Hb0LZPf9bb_Ja8AoQ3hjInDV3LYTiIp7BcAJDZZrtrg&oe=6A20403B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C91NtMU8-FMQ7kNvwE9m8fS&_nc_oc=AdqMqYPvmMnXk9otm2X-0omvSnpxGmRRS3spK_HBWwHDRXNNZ2OG5zC8ic5_kE68gIw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Sf85ZL2CCgRCvqL3dyC2avzAeYeOlWIzIkUGvmxiOKw&oe=6A203E38"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpitQea7V_gQ7kNvwF-wsqt&_nc_oc=Adptv9G-YP_m4WKdSPcVK35lO_JQJaARWNjowqsfXdfkqKUcgqTd2tF39WnPxeRB6TU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mNjztNlcRyzyejDsClIA_XL6H46aL5aYHsodg1LvrOg&oe=6A2036B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-w2S8I2_qmEQ7kNvwGtwDeM&_nc_oc=Adr4J86B8qLR2VR313sduw2sYZsFA3cBrePfaesw_6J61sh4Epswij-4AW_XTaBUpF0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uwX4PODarSXzu5_xbJexBcCruyURFX8T3lmIAdxqbUw&oe=6A202A20"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
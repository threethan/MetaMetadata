2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6EqH9iLqbEQ7kNvwFhNSsN&_nc_oc=AdqC4sczXEUPJRKh6vZtBOyoCsIaB1knjR57q4Rhg1VvUG8O_iZXq3aeGBkQ7fsfBcQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzk-U3lc1m2NPj6DeSaKaJp7dOzTI6RswQJUBSsaGuLg&oe=6A7B357E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dc1eUjykXckQ7kNvwH-j9XV&_nc_oc=AdqsLDn4DZ4tUyfOOaiVdfiKfBB1VJqwdGO2lGwEkHQiX2y3Gj8IV4z8RnDKMUFndvw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFl2IUEQaiaMbLSgzehFV6APB-WCR-w0E17X0lQznGx8A&oe=6A7B37BB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J19lgv_mJfMQ7kNvwFATKjL&_nc_oc=AdpAEEhLW0wkzEcNrfgfGr1xd0AGvjUaAt6RyVV6vIUku5yajfKpgyA5stF901Eq7iQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxq6Y7HHSTHRCRw-n27A4GLWQ3XnJLCD6vtE1I4FC0ww&oe=6A7B35B8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLAm2t2PePgQ7kNvwHEfith&_nc_oc=Adp5hXkpqFJEcZpNbK7Aa1eHYSt6zYYLKTnyJuHZ7r14Tl0xWOgdeUReNfXMZHo4Kr0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQclwxURpjDiy1Qe3lWhG_E9F6IcWnKr4yvcSAIhxA_Q&oe=6A7B2E31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdgS72LS8LYQ7kNvwHMbATt&_nc_oc=AdoXssAhBmiKOX5mxUAL8zyXGIbSYhVAVHIxaRy4tQFJBKSrQAIMjsYOw5MfYlUDIlI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6cSYmdu1ENHQQq-d4m3xT57-B_h9K_YKmrmRYtwJA2A&oe=6A7B21A0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
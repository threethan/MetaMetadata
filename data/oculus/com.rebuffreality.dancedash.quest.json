2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frRlIs4PrmoQ7kNvwG2D6c8&_nc_oc=Adp5o39NSXHjoCfKwD3Mf2fW-GI666romS3Y4nKgJGtfky__52tUg_aPfO_qZuPeteQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdu3c0eCjlB1XJGYYK8wUaiud_5uDyusGAA9FwjrrJyQ&oe=6A564B7E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ukXtZCC4AkQ7kNvwFQOYU1&_nc_oc=Adp_fSBFAxqP75OWZ7jLe9UgES7XzyWHE-mb304MM5cBFBlD5qwoxyf-tifj2TZEcms&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnoPnyqUHvcioUwt6vSXkjLvkHHw9XgMKIKeSN0fBxHg&oe=6A564DBB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVOo0J2Qa7oQ7kNvwHMkZQI&_nc_oc=AdoCgPrj0x2jBShDpSnWweke2Q5unl41d6LgHojCf0bKeJ-VBcAX29iMCHEtntp_TT8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxvmAJZSxPUj5SmJWomZzPxHphSreY9K6rUfj3N-xr3w&oe=6A564BB8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPGkuUmdCokQ7kNvwEMP7Im&_nc_oc=Adq2GM6qU3uQrjZgGq_i8h2Ud3jd6dA_fIU4DOWAoO6ehCA9XyhrR_sU3l_6tb4sAm4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbvpFlB6GM6BsFdmVPSUaZgigC_AO_fC8oNDxxyGe8ZQ&oe=6A564431"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jiOZz9pkZwQ7kNvwGSQNJV&_nc_oc=AdokSe8BKHjSCYg2PBpntbOiYMAcdKAboEGFxM2z8MKW4GHcmG8V9J6yD7Whpd0CN6o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvHRcBtHbsKnDuNuyIj0I3NwBayL16bcUUKUIRsGW0uA&oe=6A5637A0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
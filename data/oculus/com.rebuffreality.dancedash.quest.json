2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWeiz4ZAc7kQ7kNvwFjXLaH&_nc_oc=AdowYw0nHuIywjnPzl3q2WD36suyTV_J3fBkaVcTEQUGFw3hc1xwonHG3i_Z48tkiYA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKDzV5jGTo-ga7KGhcQt10QaU3jalJAe_-qZXf1lWY2Q&oe=6A51057E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pn8plFsbPJUQ7kNvwEtH6DT&_nc_oc=AdoYLeQBFnHEThf5YmfsssB-DKJZexgGDgoQKUxvGDNp9aTVPFNIBnHHomHat1v3o7U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAo6UcsK1hFylHZsgOUtfkSkyCw96XAgQa2QK2vzizNRQ&oe=6A5107BB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GZQSRNmiDEQ7kNvwH-VcjS&_nc_oc=AdqVu36RyYD51_A5db9NA25r0o4Y1LObnwlqq4Gd55Yi9KfCcRWfQJ-tm1-YpTPL4Vo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDL5N4F5myK3HcxleY9B8sRMyi6ZmUVMcUvb3XasGxmeg&oe=6A5105B8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRnERVBt58wQ7kNvwE-U1jJ&_nc_oc=Adq97yYttoKa7egtu-j9KJ8pjgKpouYVo723n6tW4JBXUYETufSgIhBzdqx4SsuizLg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBE9wVEtuxr-P6AttGcKsoReWBMDOzg5y83-USwIVE2nA&oe=6A50FE31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSgiuK3btRYQ7kNvwGSgHJw&_nc_oc=AdrMHgMISN12Q08FWQCmLiPHnxx7_uk5BFoQV5FmQuzazNxvMi3yJH8gVECkhOucpxg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbvpUO7-XwdZTmLe7Z8Tq4i3WaXpzGfdRnBjVIBa57WA&oe=6A50F1A0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
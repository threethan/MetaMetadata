ontent-iad6-1.oculuscdn.com/v/t64.5771-25/75286676_292875476973095_7784434845127809702_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoyp1ZhUbIAQ7kNvwEkTZrS&_nc_oc=AdoOceBTPpCcYLCgHbPLc7ZTREsqt_VN0BQcuSxA7cCFeLB47az9BA8O6yj1wHqIIQ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVr1JogwYKicUkzbbJWwAiCf4ZHwjD_aJ3Tf3X5sKuIw&oe=6B005D42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "996802831614449", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75367592_996802834947782_2069001060840845651_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdEBSWQJPyQQ7kNvwFsns67&_nc_oc=AdogRbL7F6bg289Vy1Beh_kkCibo42EkYUK1bzMc-mtib-tbqWFWyXZLeZPuHagCQvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr7fvlv9mTILJaVkkFlm2fYV2wKyTWYk06LuAk5jtY7w&oe=6B008471"}, "display_name": "Dance Dash", "keywords": [], "long_description": "STOMP THE BEATS, DO THE SHUFFLE\n\nHarness gravity-powered shoes to hover above the dance floor, commanding the beats with a stomp. Slide to rhythm and shuffle, shuffle, shuffle!\n\nDUCK, DODGE, JUMP\n\nFinally JUMP like you mean it in VR! So stay alert and nimble, with some quick reflexes and sick moves, you can easily overcome any obstacle in your path.\n\nUNLEASH THE DANCE DASHER WITHIN", "short_description": "Morph your VR rig into the ultimate dance floor. Finally use your feet to stomp the beats in this pulse-pounding, full body sensory symphony. Pair with Quest controller Trackstraps (see below) to unleash the Dance Dasher within you."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "274332
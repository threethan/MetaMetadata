2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-9PGKzjxkkQ7kNvwEJvbl2&_nc_oc=Adquel0fxLyGL9phUh5-R9adFgc07v6mfvmaOruOKrJy7I9D3Ve-JC6IsJIA1Zitf3o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJFRI2A5m025eAwgM8YQWVBoStG5mylAv-05lsa-jeRQ&oe=6AA5657E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qv9aGJX3bZQQ7kNvwEioODy&_nc_oc=AdptZManVtBO-BBbZQycfW0JrhDZN22T9545Aoww1MXipGWpyO4yK3Ko7rTlyxf91Zg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwFUcSXWwlqxu3yFj0X9SSia1BgyCtXtPXw8t9f25Ynw&oe=6AA567BB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBAztNjH34AQ7kNvwGJu8Bb&_nc_oc=Adr-GCxQvXWUq3MI_m7cduMMobjHNID_-N1qhrPBBm0mG5gJChpHAB6gWEQi2iAnwUw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2nwtKmTbTe5zJBZOnUFhyx_0-w5ugTKe7YFmGOoAqyQ&oe=6AA565B8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbgxC2OjrxMQ7kNvwEN6Nh2&_nc_oc=Adqe7zBcGpB5l5Yy_Y-XvG4eoyT9sE_FDfds4G6HQnYaJOJY13GxX-U9PRMdjqb9Oh4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDI5VmAu5g8-X8z6OoaZUXEDl7gtu70oes83-AQJ0Njg&oe=6AA55E31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47qqKxWeuucQ7kNvwETyWKA&_nc_oc=Adq4mbfcu6YGe5kXJHpABYv6RQFfi0gNzQbfbRhmUjs-Ix8Sr30ngLmbS3w8Qvx7o3s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0NiOTZwJxpRCiw6E3u3Hzlh8BIvIrnFU1yypy4u7Ykw&oe=6AA551A0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
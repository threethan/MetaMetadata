ilqxHd2AlpFoi_9LzH8ihYGxchzsa1g4neJuGIZEvBu6px0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6x5_c1SvHybX1KxLynY2iUEHs6X9xe1PQYV4oIH401QQ&oe=6A0DB831"}, "display_name": "Dance Dash", "keywords": [], "long_description": "STOMP THE BEATS, DO THE SHUFFLE\n\nHarness gravity-powered shoes to hover above the dance floor, commanding the beats with a stomp. Slide to rhythm and shuffle, shuffle, shuffle!\n\nDUCK, DODGE, JUMP\n\nFinally JUMP like you mean it in VR! So stay alert and nimble, with some quick reflexes and sick moves, you can easily overcome any obstacle in your path.\n\nUNLEASH THE DANCE DASHER WITHIN", "short_description": "Morph your VR rig into the ultimate dance floor. Finally use your feet to stomp the beats in this pulse-pounding, full body sensory symphony. Pair with Quest controller Trackstraps (see below) to unleash the Dance Dasher within you."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6604108616382820"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "1361487335648364"}, {"status
676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99yyYeFN1toQ7kNvwF29uHl&_nc_oc=Adp0UP2pAQm2TwPzDjnCSFj3rFqKTE5A-9XmdubfWADS0nEb6RA8wRA9PpK8Hok1VIg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qQuldyhE97Z6fPk3_oz4oz74tMTnAflsj8axaS5JWfw&oe=69D3C6FE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngdu4tKZC58Q7kNvwFLujp2&_nc_oc=AdonQiy9XnrU432BW-QTP0D3yFyO7EFxd8QNs5pXkApR3KnwJI9n_ooRfMSYQgI2LM4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RdsB6DVrRFJySdnyjUcckWfDZKi_-r6RijMzW25aDwA&oe=69D390FB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9bGWW4Np-UQ7kNvwEdeNXx&_nc_oc=AdrEdd9iXrvZvnaqQDfCKUIRnkBkGEWcP9DlBtuwhGNW12etEBuR3Q0ADp50ki7Nmrk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-_nQjfnfHN9h4UG4E2ytKpuZwmv_JcMTFxhBPV0k4DQ&oe=69D3C738"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUUtV7Y4XfIQ7kNvwEPlYgy&_nc_oc=Adp1_No4B07XNdsu6wuGdMw-MAWYZCn1p7W2vAhG2TDqRFIm4ZguWH75zXMVxhvMBLo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0W_Q9HLMFWq-6AQjtps6bGVdEH60v6XKuTnov04tBzdg&oe=69D3BFB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=488iwzEt2FIQ7kNvwHXTlUB&_nc_oc=AdomqZiTCHd-2IxpAaD3GQcflkfhdYJGQkoaKeFCWw4hIFzqmbzO8pRSmUIxHSG9wc8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3w-1LIG_zCuyxjF6BpKw0Uk9nNUGDTi--eJvbkO3lZ5w&oe=69D3B320"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null, 
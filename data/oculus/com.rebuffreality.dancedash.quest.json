t=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8ayybsZe3oQ7kNvwGqXBLk&_nc_oc=Adk_q2iqoG3N_ZxvAmcyQguU4lrNcg1ofX4hqFDFzFusmfNakZX4los_oYLXpXYDpP4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwjieDTrr-EfZci4q-vqFwpwuObolWfdJYcjHDDRsTEqw&oe=69BD5D7E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgQgjmRy-EkQ7kNvwFoVVye&_nc_oc=AdlP0cxIoc6z9QIsrAuZYgyn9iwgB9kfd94T3CUQt6Qe1LS1fK083VsbsTBCCky_NaI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_3MPQl5n-UW99dBrSa2c8m34TQGkiQDHDEJmw7D9Jgw&oe=69BD5FBB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3z_RGBrL0MQ7kNvwHMo2LX&_nc_oc=AdltmEbzOjQXSdqzwQRqNiA4R_Uj-EM7LwF43sKKkVjrAlJSx0B-vqBuJCNdTkNxnA8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzAj49Le7ai6vuzMAXUff36kwTEdTYuuMUTkQA68Nz5XQ&oe=69BD5DB8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcYmBcdqdBgQ7kNvwGp8VSV&_nc_oc=AdlzEOeBjj1t09FIDPUJChotxa9jquZ3nVJPJLWc9_-95I0ZIbKxiZSS9ZA04Kgp8AI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxwUdlvebzPt6-HY0rkmzntU-8h8RvoHWbdQGvadZ23VQ&oe=69BD5631"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9mnvQTdygIQ7kNvwHTITT2&_nc_oc=Adno33xeLKZykOmR7bZPBiPUauRMoDh-XMrdMMjL4AFpPM6z1bAuj5-9ui1tQy4pk8Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9D5UaEWOrxABT9lrWnrurNQDV6cr4kDu4-_hLrzGdKw&oe=69BD49A0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags"
2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C40dK0dtFAwQ7kNvwGDMNrS&_nc_oc=AdrKxTSDFsFmd6woKqdI_niAmV91j8J58Xdk8HEJF5QG_uVjK7LEBm5p5HnVafA3eZk&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03QqX90j8qOmzPCyiPsuTwkkFgdZG0B4YzOpoUSkv74g&oe=69E2477E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9MTk_qGB3AQ7kNvwHPuO01&_nc_oc=Adq9J2AhU4GmmtVFGSIBU1KNDB3cTP0jwITPIeMwsUzENCgpabUGSzc5mhn8hCq5aig&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17_pWqSH6Ldqdf9pYKsc4vwT7SeW5GjjeVaZBYt0KPbg&oe=69E249BB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmcybWbRpDwQ7kNvwG3UV9R&_nc_oc=AdqLxztD7YZc2G9NG3loVhv1oGUQFYAPykYxukPghRO58gkuVf7qnU4wl-b6snESFTk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af356TJQKfAFEZe5rzas-1t7jsms2yiYZ-fBRBdAZ3eMZg&oe=69E247B8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-r1hA1FVkYQ7kNvwFGopFA&_nc_oc=AdqeuVsuDSYJjn5VduJGUvixpPLYxXKsul0w_WR0RTDvdqOq1FkUyxxi1iOarNHHVRM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BCI7ooN2Q6K3WWEUFnVvpbJNEl2OVyq6ek8YV11ApDw&oe=69E24031"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QR0xPxFYRf8Q7kNvwFIT0S1&_nc_oc=AdpMFNe7Mtig1-2uHOY-hxXvrMKkP1QvxRiyxCJqX7yEjJF2ublKClre_s-sF6yJx-M&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eJFJP3wNjPsRT5SUX59RJ3_IkR3X9AB0QSRbBIKp1RA&oe=69E233A0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
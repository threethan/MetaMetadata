t=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rqw0ZuGVRtIQ7kNvwGft6Kc&_nc_oc=AdkUbGG4Aj8I2Zr7mqR5Rveoslikm0pj_eYOtTyKLbY12E0zM0STCJyK0mWXAU9TA4I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu5CRQsAmPmruuJmjn6Z_gXbvksXfe92Fjwvg9M8byBRg&oe=69A80D3E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2vDdpBKPbcQ7kNvwElr154&_nc_oc=AdmPVA14iLbbRIuMocigxF7s-jJ_-jjeUK_0K9Daw25uAyV_WUMSZW7e8Ugq9Gvn1bY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afuq1DwHtEmibmgN-bUICCa7Mz9PYWa6hSa0ZJ0FSHRFhQ&oe=69A80F7B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIQ-dVN53iMQ7kNvwF1OY1C&_nc_oc=AdlNFZe1aMFiSJZOeBepYUk0jPBNvkExPi3JAZ-4bqJDxW4e5qXYtea-9-7C9ZS3JeM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfutmBuE61yVGdCFPmQ2qW1sbEOGFI8CrIY5zkqYaZeDog&oe=69A80D78"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrV-chdUFuMQ7kNvwHuj49e&_nc_oc=AdkDRH3HByuUHdjbyFG9QNwhAuqXMSCqi1qd8ZPRKBe3YYuNGFm-o-f5yuHV0j2unIc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuBs_fAHd3blh5SSToaVvN8AKos7pOogpOIEE2v2mmsdQ&oe=69A83E31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZ41Br3pQ3IQ7kNvwF6sgyu&_nc_oc=AdkLFIRPbl_soAmsfVdfIetw_7NbtSXSQGnitrN3flkSVQ-74XUIVJIH45e-MrZS6nI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftb-IljJyGf7pi4YulsGcLZPI5wUg6t_6pFzl9KPi0K1g&oe=69A831A0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags"
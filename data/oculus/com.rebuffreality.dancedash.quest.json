2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsVCIizQIH0Q7kNvwH-hUcd&_nc_oc=Adp2_tYLd9sODC0ZtvWmkKAj14e7_rItQj5LnCt8GN5hFtQczKWXrpIQeRmhLcakvQ8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkvAFNZ5i2CA9nmLdP1iQJq27WjU22P6l6EfOx80QjQA&oe=6AD0E6FE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpAZ3vv7K3YQ7kNvwE5DiEZ&_nc_oc=AdrAsJf-LMEo0M5yLddgpP2K95IGZUXjkiseJF2j2WvoCzetL9X6Whkv-4DyDyYNpwA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHQvE4vbfunjzCOmn7gHFDmq4mZwRgrI2NueExtgaLUg&oe=6AD0E93B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjrrsQTGlmoQ7kNvwHbZT9x&_nc_oc=AdqpokWEC4ZqHoWaeH4ETj3fuD-DSnz81Ocog3BbOcT21_b-PgrqN47dwd4WrP1JjH0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrh2XD3CI6eKh3bxTR_XDyRvnQ1HyQSsJkRkIykbZ5QA&oe=6AD0E738"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zR2Q4o7I4sQ7kNvwG8P_SA&_nc_oc=AdqAoBRIz-fXOg6sBgej--TjEO5s2FFOncm1BdyFH6GjXI3BTGARu8OAULxEcSzUceU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVImS5fskWfM73fnZYgK4JHEWWV1fKA8TK9wQMchPztA&oe=6AD0DFB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cg99bNxRvTUQ7kNvwFCoO1s&_nc_oc=AdpYs_T56suqHHkPyF68qE3Fcjl7PRdrVbnz1OJ_SVU4boiv9rri8OJt_ISR-8o9yzs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfkRfMHVycaWLb83UlxPNgzckc9okSbKudwzi7HDmbFA&oe=6AD0D320"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
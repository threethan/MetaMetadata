n6AQyOhV5M8Q_0RwACz_SOV4kGoegakDHfoUwFOGsDK2A4t6WmhJUVE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afug4BNHRKm8Na4KJSqekNQYJLRMPzWuo94vkglwdZKEeg&oe=69998CBE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvAo0CbGqwAQ7kNvwEHi-IF&_nc_oc=AdnSQiAhPhHn5Ab1aMjaU-Rku5RqRUN6Gc8XAx9a1KgqstsLkOJMVM24yn4wHWjGhac&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftcZzMlVoRRLv500nMnPmF9l3U_Tvdvyw8hCDi-d_zaRA&oe=69998EFB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyh2LFVUYO4Q7kNvwEudkhO&_nc_oc=Adnsqm7yg86b8LU2Y-qFuHBTAK_A1wZmn1sWvlIXbDyk-VF6Lq5bKE5Fw-Zf4p9Y9d0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv87LeemvL2KgHQ34i4HRtv1oozlN6tl1Oonxxf9UNbRg&oe=69998CF8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5PeQXgV52cQ7kNvwFG_yAZ&_nc_oc=Adl0t64KaDIUr6ioGyY49UJE4PK-LhwlrQDvhALiqBHUeHVPwwXINR6yba1LZqRyFUw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuDES3S3gAce_2DmVsstq0MrwT4LOeof2t2x6x9dRGW6g&oe=6999BDB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ZLpmldU2-0Q7kNvwH1HmAY&_nc_oc=AdkEHfDOJwJxxr4sKB7eZBwjNgQVQDAIDJdJX6RiPVcLHwsjP54PgaTjGpB8bLCBTrI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afua7yvgxhOIuy_kC9AFEQoyFBlWF8laN3iB-18YLTV0SQ&oe=6999B120"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480
2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0mShSYGh2IQ7kNvwE2nDHz&_nc_oc=Adprr_xAJ4CkqRKk8ZQrIIhXnUnR9tzR02e8VFqpbxESw_9_LJ6nZE2QUmj6sf6MuuM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2PFTYdXd-twuUx-Y__3yNlBSZf6JMWlpcRdFpFA6ekGA&oe=69F75F7E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qih9rYgaIHEQ7kNvwFEH3wS&_nc_oc=Adq_WuIVjQG-ESBswmR4gnchZ0TH21QXq6h4Nbx4HH9VK1XjG8xdPd9K-DX6F-b-rnI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1XPgqrVlHcfyZWTYjpRlJbsj10Ju-kZIlzOJPULw9eRQ&oe=69F761BB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGphrC1xSmUQ7kNvwF_QLq6&_nc_oc=AdowP1Hg3-ZnJw72rwN64Pk3jZCwuvUAYNdKdFFjKE9LS6LBsjZ30V2adEwnGwxFVGw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3WTe9iY4sZvVr2dXZTgJBUMyngtHkafiiP2SvmiNrtfA&oe=69F75FB8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6O656UCUSPgQ7kNvwHKx03c&_nc_oc=AdrR9Uw6l83qIZr9UwBL9b3IiB87I96JOJgL92DSfYPkVEh2cE6vhUGI45heBgIc70U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af37LEmejR9cb1QLvr8wVmzgMT-7EBB0-hJzscLTVwnKPQ&oe=69F75831"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eeQKW5JuMEQ7kNvwGHoX0r&_nc_oc=Ado2viP7uNowSC9j8Rp5VIa3Tu30kdSJveTmlB3rirAti5Et2Kc4r8npisJdW-MNGb4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2W1WQAu3--aO9wOPqTRGcmRIE_V8p971iguieDX4GseQ&oe=69F74BA0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
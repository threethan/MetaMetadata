2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WzRUgVns3TAQ7kNvwEBSFXg&_nc_oc=AdrLUZZyQMBxufniHF0eKwt-xQJF_44m9UioT9WA5wTWFqG26YsVy6_gppfLMcVY-8c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkpzcHED5Gen8VR6ps39ZAG_Wo_UC_mV2mo2j11yGRtA&oe=6AE35BFE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZSbaw601WgQ7kNvwEEcELO&_nc_oc=AdqT0SlVKnaV67bd5UlJhs8zD9PMehGlNnjYz20ejUzQI1ehwCyEmh5Wo8fmT-hNLUA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3lHFIbjP_aNmrLxF0jaD2ze8gvuLhPCes0--IeoqOiA&oe=6AE35E3B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hav5_7r0kIMQ7kNvwFtu_Vv&_nc_oc=AdrgECzVMtYMUgZstpUd4RUT9luJHo4Xtlerr3abRLV8faMk60Pd1uN66Y_IjOci3bo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNb3omUglBEmFrtK68J89ZHdkcqukr7WKkcgtTHYv3vcA&oe=6AE35C38"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bx8V5SXwrzgQ7kNvwHD0kZP&_nc_oc=AdqtUaha02ljJBc5CkeJ8pMEkkj6exz8H7mFR43qjciI2ceKkTDcVqaCRzlhp01xH10&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnV1x1YuiCI57zELdXEAJ68FN7zCHFhhN3TK-bGoznhQ&oe=6AE354B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqKHKocOp1sQ7kNvwFi3uCu&_nc_oc=AdqxyJFHXqfxgLcWPzcWV7RhmwXSD00SVO6Z4aOE4s2NOz0oiL015TWj-25E4G-LKXk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjGgKPEqdbYsq_FnVlAqLgDDTAUeXEcBKqS32ENu9lcg&oe=6AE34820"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
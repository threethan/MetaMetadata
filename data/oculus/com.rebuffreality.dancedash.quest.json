2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1DXBNF-sKkQ7kNvwEURaPI&_nc_oc=AdqlXVz15HCJGqJbSDHTvRXi6tJUf4nRnYxsDZVyn65Y1vKfXDEXHkCxtKKWGiBKK3s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hrjsZe5iqL7ogpdFORt6q5NlWspQvFoKyVWOUuxYFUQ&oe=69E398FE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9MTk_qGB3AQ7kNvwG7cslR&_nc_oc=AdpiIR5AJLtMGbzdM3Frlbds-I00coolmnBZ9ZEyfwM4CtXjmpqov21VcLW9Zn-nYbE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1k9bbhqkdmhVz0ownuEhCwofRzPe-Rp8Es-_6SEWSBhQ&oe=69E39B3B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmcybWbRpDwQ7kNvwEJqvI0&_nc_oc=AdqFLfnNn7diBT2d0YTOyvslz7T3hstntW-zH1xGZTQUrd8Yt9rZW9FYdZ7L81ZVmD8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ezvncM-ieusmKzlgmwkhPJuot8OffoRf1SpyubvXKDA&oe=69E39938"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GKGlH1c8ZkQ7kNvwHd-w4M&_nc_oc=AdqeW4gL7u6uVGWH-zREyLLm7_74UZhPLbLKw6hT1Z5kUFzvsLTAAJd3PAL_SlpFdTw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jm2BOMmfbQqMj6zUnaEmHxpnVuDjfuL1jKb4Fmsyzvg&oe=69E391B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QR0xPxFYRf8Q7kNvwHOSpab&_nc_oc=AdpEF3DPYf_ReZEfL3cbHZbvwRx2_CX9EoJ9_4LZwtXKPZ8-c23T69e4UfkJjxBgy5A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sKG1yLzgnFXbu4HGQc8G1ddg5SSC18leWf6wMjVsvTQ&oe=69E38520"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
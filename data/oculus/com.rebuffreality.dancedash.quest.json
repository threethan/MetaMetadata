676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K84R6ju_uCAQ7kNvwGO3I9I&_nc_oc=AdpL8Xtgb8cSZ78lSrwCDT4pmAq9jx8_w0r1xtb8aqk3UYXSXCKjFFF0EvmynWaIzUw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQv1YR84FC3UwytpNLCv1IIAOO6Pka_ToEtaEVUXeKZw&oe=69CCF73E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wU5L4LXHXwcQ7kNvwFaVJ5B&_nc_oc=AdoGTbO5s0HxDMxqqJf0-Bea0FvV7CiJoOvsIKtXeyc1lYosMPvCOAxwcm0J1w60VQA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAaTYiRiC5tgCGWGU-F365gzkBHVm9M4evZeyJocyi5Q&oe=69CCF97B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZA3JUnm8CiYQ7kNvwFRWEfV&_nc_oc=Adp_gzCKBy1xqZ20h2FSrDbS_vo-WeMhJePDLI_5BHhNNVGsZuimJ6ZxRa5yy9KLa5s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBVDq9Cx0_ivX2aXdMJ7kurbI_xzWWdYyHJ-Fzgp8nMg&oe=69CCF778"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dd3DdkZEfW8Q7kNvwGmb0bm&_nc_oc=AdoTTv7h3snKx1cNSqXTnwD6mhYwae6O9gDKZHfCbTlWJxbFoaN3j_VErPGS-kf8H_k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxO_MMVykotYrN8jAPiIdzgLQmZwVBIAYAUn-k5BRQOIA&oe=69CD2831"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2a_HTwEi0uYQ7kNvwFwMwun&_nc_oc=Adp27uI6tFkOI_krKDYGPHugr4siuE-5WB-g8qrNRVGihieQswGrQGbvxDYq6yOqrsU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwn6bL94TFrAp9AHSwDvBWjVH70zO6BgFH6tdscY1vcrw&oe=69CD1BA0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null, 
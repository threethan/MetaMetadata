2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C40dK0dtFAwQ7kNvwEfAmOy&_nc_oc=Ado4gk9zSi5chqfa0xuZw-h8UnMzJvrKlHcqKUFA2NFj4gXxfHnXVWR2oMM9r92J5AU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00WcdTmCSEJ2zODwyqs6wodXXMpRCS3t3KfXyN5zjY_g&oe=69E0F5FE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zw_ktBeEKP4Q7kNvwGXBJA_&_nc_oc=AdocEmxIfAKHH01g6mcbkGU1teTXug_u9W6fmInLNI2R2r3Xk9eWwflgqVgbi3BewR4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_sCPAeEmikto1yW0YwdiSvYSq1YCBMfJRvZYDxOY56Q&oe=69E0F83B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmcybWbRpDwQ7kNvwHd8L5U&_nc_oc=AdqwHnIytt5HTZHrJRiM5j-fNbv4wQuNa6fAa4E6RriWFeIgWQ8cHU_wI-G7NHDlx-A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wzTcBAL-E7qq2LIXAlryCxJnzrBo91H9cJBqZubXHvA&oe=69E0F638"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-r1hA1FVkYQ7kNvwFlHAYe&_nc_oc=AdqbBp_fNb6TeyDSBxDoCYeG0IPGN4IxrsUn71cu1R_q1CO0KtR2_40lfmGuxipecA8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0w7rWYq8ePviXzk7zKTU50q94e8dWoNYzt9Isa-wf_Bg&oe=69E0EEB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QR0xPxFYRf8Q7kNvwG9dflg&_nc_oc=Adrg01gDu0zOR8J8WG2VT5DKt7Y1BVbkHCe18qufXGAhEQc6c4P6kCae5xeaIXK4ZnE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_EexxofKdQTlIa9ZHDK_OXOXKnGe2QhlMsDbtSzjg1A&oe=69E0E220"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
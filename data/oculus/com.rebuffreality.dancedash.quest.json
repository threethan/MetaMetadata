2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TE7y--5OX1EQ7kNvwFUIxEt&_nc_oc=Ado96Y4hSrHIG9LEX8EFdVU90pyNLnMa9npf59VfMRz28_LJxt-TNt_GL3-a6ao8GCU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqMLpY5hiEOyQy1a3DN75ho5rMy55JfAKwzZ9OWB_m6g&oe=6A5CE2FE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wr_hOfLtkPoQ7kNvwEKQBTT&_nc_oc=Adq0W1fRX_fSjGUGMKN27K3kVcdV7IFSN74ooDwZ5fyFyURUfxh1Fp6ToXkU-g6dSys&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRPhJ3NVjbHlyXKyg5WxZJ8r4bHqS32Xh_qE3ZPp8D8g&oe=6A5CE53B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39obN8zi2ioQ7kNvwG8vxWg&_nc_oc=Adru6opccyv2rii24IoxtPxYLtpqtIdOguqtxQcgEsS-pokqDixxvpprk_x6E-HM3WA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjL9RL2u6gNgbOPwRhyWA99BvZ_j2dcNJap84r4H9XjA&oe=6A5CE338"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0H5943Vkc_wQ7kNvwHtBkIj&_nc_oc=AdpSF6ktGP8SDE3CCJxDHc-4yRhpQrpYExnfd_AS_Pfj4HWzdqN2GIN64dzK4xarPhI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkkvs-YXbs1VfTz5ghUEcnavKdbIEp_XAe4-sw9m4q2Q&oe=6A5CDBB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akZ7MMsdS7IQ7kNvwHKZmx9&_nc_oc=AdqOEbOQfflZBfQnqjVTPeFYkbKccqdahXQ2PCdPjEelN22sC4jSz7ta_hNUX4WFCxA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCk_2h5G_kgmmMKGLKkrMGV6rLP3O4yB1fMyuwPqwpUFA&oe=6A5CCF20"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
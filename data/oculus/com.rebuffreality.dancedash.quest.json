t=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLavh2Jcr3cQ7kNvwE7J5q2&_nc_oc=AdkXWKzMUK2RGy3hfDq5Oh1A0_IEMfAX15X-Jd8WbP8MhCvAxhhQDshqPwRVhovK5Wg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwuXfN5sal4gprDrwKJ0Y8WZO0ns8PkHG4oU976QQeCpw&oe=69B68DBE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-L7jsujlM8Q7kNvwHe98PP&_nc_oc=AdnocEh2o-krc1xr_DBsoVx9Yw_uxL-bFinG9hN9HLihAsIAjGBltz7ql3vv4QN5KgE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxqo-bPrhlxNmmkV6icisQhIInaTITL3bCo4jj_yWtS2Q&oe=69B68FFB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbcGIYNURDcQ7kNvwHnsSPW&_nc_oc=AdlG2t-Go7naXJad1KLz6cq-X0bKh0jWKh-mdIkE-w0LtxYpAxYrg1CugjLobC203hw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhzspPcd0AFJsxbIIe-UwQC1YZWxnIlJ6Aiae1-BWloA&oe=69B68DF8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poWAN61zzBAQ7kNvwH-ji9G&_nc_oc=AdnfdANKdeCaaAp2Da1R2KGEdvx43AieR-frvOw0GKoNr7cZdENnpV1VGqXTt3gbmhA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5Eku0QHHmPBtYwgCHaqEgrvdEtdN0FKuc1r_izp4tBA&oe=69B6BEB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0hp_bCBaU8Q7kNvwGFIuRp&_nc_oc=Adk6UjaWfupbx6_4xUY0MvwA6Ddf4kJjgImt7PhVCJ1B29N8koTlErAyCwZGPdLMYhs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0uKTMNIm_9YL_CKNmFyHRkZOjicyPMi8KurIlN9mBvg&oe=69B6B220"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags"
2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RP-VMr6sixAQ7kNvwFF9hZE&_nc_oc=AdpNZDyW-eIL3fYAMF439ezYgySSWFUO5h8X-xsJOhJBgQr1-oReZyjXakFcbyZlO6w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpEbzVEWGR9YwKL9o1PRqnQatDaxXdIWqc9M1liOUA-w&oe=6ACBA0FE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxA7wi9Tyu8Q7kNvwFIFsW4&_nc_oc=AdrF4c9D9iDikuYuUpnjns2apjpzLQhkkGg14wIvpolrK6aWqo8Md0juuw2XWPT-wzk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN357tsXprXhsr61ZQuIOVU8tHNLVIrDgwtY7CY-fmlZw&oe=6ACBA33B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDAGahfr2FoQ7kNvwEuGs1d&_nc_oc=Adq-i9IEEh9FL1AykIc2GC-0Yzi6RCL08FYkVBdHT44qRWShsgCU0z_b51qXQHZ2-bY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9Qt4iJUoO-4V5cIud8Iw2bVkoRImRCbKWkXvo4oW11A&oe=6ACBA138"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVKGTzEb1U8Q7kNvwELKD4N&_nc_oc=AdqkFiZFmjvtvR4704xqRE3S8vK0o8r7QzBw4gk5C2NNVimjM8Lf2S1m7oJQzmJBtGM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVT9f72Dc5FM0c-a5Vfr4y2vSbCXdMVGiDiZ680QbUxg&oe=6ACB99B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaPKCi1OhlEQ7kNvwEgdC0X&_nc_oc=AdrVbqPHOU-nR7L27U4vOaO6a2LPTaSMlJCJVTJa_nSimCCdKpke3xidp0cEJU_kZQ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkI1tE54wY4FxuV6eb7OECaaStIZhqXkG7S-K8v6lMgg&oe=6ACBC560"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
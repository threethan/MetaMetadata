2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znDd8OBGthAQ7kNvwHp88NN&_nc_oc=AdpaDeKxyoW7sRfZt7dDJB4dHvtIIj4D25KDzJ3FaYgkk9QZuxHBmJ4XVfgb1c4hVmY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0HNCsdvxXJx8-b93Vs4nwLD167gH6-WV1RpTl5uxMvg&oe=6A2D6CFE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iM1y38-AhS0Q7kNvwE1fnVB&_nc_oc=Adpvuz9X0djLGLZ8QhAlEupzJ7YgGRRkai5TYOOxOahTTPxjiSnjSUXhFg-JIy18P2c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VU-vBaYALY4hWGGbN5mYMP7PaX7E3mGJQt1JYGNJoKA&oe=6A2D6F3B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PU2xdmeS53IQ7kNvwGHHs67&_nc_oc=AdrOhU71Y4O9YbItL4LIyOs-xNp1SFI-MuPxNf5MmM41RgbBIJ5vOwIF_23nsjN4DJI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HCbLZGzsi5-7MfMQDt6M3xXVKIBRdBKuGTYPYanxEbw&oe=6A2D6D38"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xa_M7NctrgUQ7kNvwGJ4zkw&_nc_oc=AdrTmyLcKKorfDU1HC1MYFHVDYQBuci4fT4JFnOKxoucbP6VpIvq5gIX_aLZA4opqoc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ebC7ystQILKrI8CrEGeOzFuF3DcN1GuFNQ8aavv0Asg&oe=6A2D65B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fenbJKryTUQ7kNvwGANJIP&_nc_oc=AdoaX-bTo28jHSNd-AaQJD7owJ77GrdqCQNteEelKuR9GNyd3r7X1k5jq-jx_z6ZM3I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8X_CAgXIUImngIVAsdGeiDqyS5DGILKEskD7Lkc7O3sg&oe=6A2D5920"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
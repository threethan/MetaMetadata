ontent-iad6-1.oculuscdn.com/v/t64.5771-25/75286676_292875476973095_7784434845127809702_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAN5j5bNBd0Q7kNvwEh055v&_nc_oc=AdoD1H0hyso0nJ3gDyDNW7xeKJkS7VgOS9X7jQjoEXJbkuynIr_CwDsd0DhIWrh24cQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZ2mC0dbyE2Q6WwHDWieCcgDvrgQ1IOBYrwJdUeyb9KQ&oe=6B048A02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "996802831614449", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75367592_996802834947782_2069001060840845651_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kj20uMywaa4Q7kNvwFdvZwP&_nc_oc=AdrbpaY1B_TAAWFqjkHxU4w8OQhReeM4gB9pC0_A4l43pXKYGJuY-HD7pQunVgYzCiI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSU3D5oJpIffyjRAlpzZ7jJ7NWUUFQrIEGW7suKdMZElg&oe=6B0478F1"}, "display_name": "Dance Dash", "keywords": [], "long_description": "STOMP THE BEATS, DO THE SHUFFLE\n\nHarness gravity-powered shoes to hover above the dance floor, commanding the beats with a stomp. Slide to rhythm and shuffle, shuffle, shuffle!\n\nDUCK, DODGE, JUMP\n\nFinally JUMP like you mean it in VR! So stay alert and nimble, with some quick reflexes and sick moves, you can easily overcome any obstacle in your path.\n\nUNLEASH THE DANCE DASHER WITHIN", "short_description": "Morph your VR rig into the ultimate dance floor. Finally use your feet to stomp the beats in this pulse-pounding, full body sensory symphony. Pair with Quest controller Trackstraps (see below) to unleash the Dance Dasher within you."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "274332
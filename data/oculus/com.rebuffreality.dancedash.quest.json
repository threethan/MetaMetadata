2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hr-BzbCfaGAQ7kNvwGaH2iT&_nc_oc=AdrkiDrUlFA9tQKwPFShMpKwlR4ohLPxImSkrgl0QsX_4k50AomA7R1ISFYGhhxw8m4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNL_6xRszHh8p-mi6I0lX1ULGuYk4nrf9h2HoaCdNH7Gg&oe=6ACF957E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpAZ3vv7K3YQ7kNvwGi9chg&_nc_oc=Adrdquk2nMBI7m-MoBXvfpECYF4Q4zBz1fbIBM_0J_C3DiXNBBXc-Gto2QnWa8WU94E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYeTRWRv_b8sJdeMYImSIkoJLzcW7yJ-grGjRxLy3fFw&oe=6ACF97BB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjrrsQTGlmoQ7kNvwHUJUj-&_nc_oc=AdoENul7boulWkSN-nHi9tJYxxRxhew4TMRJ-eIiu_IUor8VppMbbocsGL4UgLylD6E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwWUlxhlcRCZxwM-moPJzknNWwxz2NJg3fMOu3igwRlg&oe=6ACF95B8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nuq188EYQNMQ7kNvwFUo9PE&_nc_oc=Adq6el-OgYBT_9u-Y9fN_IWMk_KJ5V-9k85llmypWEPslGjAazJJ85zV763W-ox4o-A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeM5-jf7efEO09t1oXhU-MSz-EhvJWHbhRUFD2b5LVVQ&oe=6ACF8E31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cg99bNxRvTUQ7kNvwHwCw95&_nc_oc=AdrdzOV1QqICahzTsv2jjQy95Kqa-q6O5HIWxfGdp01QyUwwJ-U0cOjZeQ9EAKOm1bU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCwlWS4SBpIrHf4ouBkXjkC272G6IlWh0wiiBcsOgv_w&oe=6ACF81A0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
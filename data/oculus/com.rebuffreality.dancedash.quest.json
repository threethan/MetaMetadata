2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VscqUcF7-cQ7kNvwFsH_3h&_nc_oc=AdqC5dRcPMDNpVbNuJTQgYMtgm28zmjcX11tGrobRMzStPC_mSkpEVVcS7lRQzB7010&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5teRmrEbgnvCP99LR9re_l7XbK59uff48i2yuSBP8gNQ&oe=6A106BFE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=st0r2BevlzUQ7kNvwFr4VP0&_nc_oc=AdouXqWzQRESIdzfkb2lw_4dHWBeYbFg-p-RleAJXclu8ZFiTczJpfLr5-BAK4RqfC4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JALby7w4mbzVWavdSPBJWfp2QjReEAvwzcevsMLNQdg&oe=6A106E3B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INjz-H6US4gQ7kNvwGbIki1&_nc_oc=Adr0st_LJqfcNQiNJtJ7Xkd9QfkdELUtPRkhS7A-c_E7-U2wJgnPdv6U6QXku2QCdlA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iwaA8OUkWFUIWPkfP48-IEgPm-mzua10A-QOam0ozBg&oe=6A106C38"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O76MYnxnJXsQ7kNvwH5nlAG&_nc_oc=Adq9dJMdaB1DjgIBD9ED2L5ght1BHvL58v5Bkz0zD1oWzhBJ_O2M5zYAJGHgAVSxuPI&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Hcts-xDDR4qFaSHpAp_Nyi2rXp4UV6mmOJffK9zenFA&oe=6A1064B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqVgwZTiDKQQ7kNvwE7ni4Z&_nc_oc=AdqzVAuSzcdFX1MlhJbdUb8jMwwwCdzk4Mm6jVc5x4S-AtIUX-Ar7zWtu_l4SO17RCc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PfbiMQAN2LX-Z8ZSNlyGRlLoZGf6bj9oMSNOgf8c92g&oe=6A105820"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
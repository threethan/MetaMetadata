2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUrrbcvsMFgQ7kNvwFz3-v-&_nc_oc=AdpPkOfosj4o84PffrdQLAbTidOJkRi6KCdVS8PcvbUBeXH4Rj_P-KZCXK6GRbTcy1k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nKZib2DhdpVhmx6GX5b97YYWuMjExRHZY9Zb-LVwOfA&oe=69E78D7E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHxmW7dluA8Q7kNvwGuVFdO&_nc_oc=AdoQuoMNilOFgQyEa--1MXNYUffI19hZxR3HbtygEVVZRpM2DDSlykBr77bxX5LJ0eA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3IKZd2HLj7ABTBbRUo7uZBbuxvl8Zaqtj7JM9yVK3rsQ&oe=69E78FBB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IPx6DFwbtkQ7kNvwGn43xo&_nc_oc=AdrKEKE83E8gI2y0cv6KVWAfORkbHVyPClt_lKlrM1w4i-oYgny8G8Kbaw3vUn8qU44&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1upiAgYpeHL8P2iBdT3ssiNmm0KtQ92gGuoIMBWbP0_g&oe=69E78DB8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkaZLpkZK50Q7kNvwGLCouR&_nc_oc=Adqzy8ue7Ieyo7TO0Fl8P4r5XGsomp5bpSdb5uJwr3MNsajMgn7q7KWbM4amBBnw7Js&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32L1QUYBdIkzWwWyTdUmwyzpoHyDxV2U9SjgpvBqB9og&oe=69E78631"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKluI8uncaEQ7kNvwENCz9c&_nc_oc=Ado070qzGPICH4WtBsQFTMNsZDyNA1j7mqPhAiRSvNgJKNhiaIadnORDKSJ5hgIQsok&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2laCJe3dPvaEK7VWZm7xgnu70tNsKLdGazRMM3XbJmzA&oe=69E779A0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
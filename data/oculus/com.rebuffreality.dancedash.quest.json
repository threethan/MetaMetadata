2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bb8MFWoHOOkQ7kNvwEhNz5F&_nc_oc=AdrHBrYEwKQA9HqTqxib4cFPlUwgdvIc1NpJkOKqkn6UvT8q_ShnAPeUXWtxt2ZOw9M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS7c5hYe1wxh8dz79jAB93d-7iKWRVjHWLqwPncfxDjA&oe=6AF1DC7E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nz2gthU_CPgQ7kNvwEw7EF8&_nc_oc=AdoJbDqsPDvP794SgOZ_gKKVMWZSK7JX44ifv5ZHE4jWZpL5J71ay9mMUmFJDHBYVWA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYPGP2eYGsG3FOM5hR73s0x_tRIcyD9yIY_k5esRGO9w&oe=6AF1DEBB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJzftGumQWcQ7kNvwH3YR6K&_nc_oc=AdqCkogsBPU4pV9-l2zNkN_wPFHH7q3p_bZh88vGSXOuAC4LADXAo1uwMOPPBHaKlek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_PYc3-BIN-qLfODEaXaHKXHKiNO6MsgEJQUYu9-0QQg&oe=6AF1DCB8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATiire6FoVwQ7kNvwFcZTEy&_nc_oc=Adrk-7eHpw_LxFLHWBSlAbAYIoQn8gKxyLFJ5LqijOdpPwX5ZmAU7XYja1yHAGwNt2s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZGehKdmwcPxcf0IXE8Y47BcufGuxi5F2qcaq-UMrSaA&oe=6AF1D531"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLBIxBi9q38Q7kNvwHaOgTw&_nc_oc=AdrPgRe-FdtwDqTVppz0S-qtoDkf5VH9vaYfaQR5lfkv2aNGXWDJ2j333tTJjIlw-gE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDGDTs-VKSF6Mz-c0KppGQoDxknicgRPgkHwbPCgMnjg&oe=6AF200E0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
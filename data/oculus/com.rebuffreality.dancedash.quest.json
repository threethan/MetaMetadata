2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kzl-MFYCnJwQ7kNvwGiQZly&_nc_oc=AdoUr4av0rJ8QG40b26MX0Fw1zNONez8Xb0jQ7SXf_zvNL8nW1guMp2x4GV_opyq9_g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPgSKJXQ5l1Pk48eR5rBg-dzgsPMh3kY7gBmueIDCOzg&oe=6ABBCEFE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OeU2IVncrYQ7kNvwGfZyS3&_nc_oc=AdrEj-6dgfXCdqLABG-ii_LePACPgeIYl5VMxK_mMs8Gwh8uLdX6u_31pWzf5pT42r0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJviQSMO22Ic8mOOY8hXP7De8ILPgWidI7nVbbjPO9wVg&oe=6ABBD13B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-22KoHlzSLgQ7kNvwH11hyc&_nc_oc=AdpkPeRAcBmCa8Aw86TngreGBZ6w_AyWOE1Gy_u9dW3ioSexpH-Y4DFtyWgck8U-ayk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOikrfCSJG0-wLohsu-Eu97KO9wmBLx-mmaZ8Gl6XMhQ&oe=6ABBCF38"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEExr1JwEjMQ7kNvwErS4lR&_nc_oc=AdodpRYy-68iRsv6gyLQr4YdIla77ElOdgxoOXONt09eDaNpiX3sY3NDLpBxqCTXR8o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMpAKJKejM9s5fLhNzVp1DPDGfnKOi3Cuz33ZMGqB7Pw&oe=6ABBC7B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIjSQQ1xS20Q7kNvwGpzR-H&_nc_oc=AdpEWk6O091wdCrcQogh3Pv5OJtr02N-BumsNhhxpyYLVoAQQRbwLlXlgQzgMXwE0r4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQKW8U5ofqoETjPcfGQiaILHL7S4d1sf4T_G7LbFLSUA&oe=6ABBBB20"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
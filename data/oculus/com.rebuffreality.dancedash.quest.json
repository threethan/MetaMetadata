Y0UjYs5hMW78FV0Ag0c15QqdTiB6_NdEr28Oh3-7T2hrh5161wXcRTQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af36NrTFQFiXujDkWvJtXz3lACBrY5ruaz95gQ09IG0jgg&oe=69F0C7FE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJMDBNqbxMsQ7kNvwHa5lMQ&_nc_oc=AdozDaP8Doec7NIpScdw8vOBhkJWEsPDPBPzM9A5RwGvFzylu9UFSdxi9jhpr42oi2Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2XLQnsBiba_d-SF3Irk_abu_gfHWW2Ho3s0XlGplWR4A&oe=69F0CA3B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUwt1fLZxBEQ7kNvwGsgh0B&_nc_oc=AdppgsoCwUnjdC-bgte2wEyNMEK67p7s1ezYsPbp75bl-T4PeC0J6uCXZhgnzTjI2zw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af27GK5Eo4SnDSNDTschbqKpb8UreNbJ1aECseqhbZkj6w&oe=69F0C838"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBlmViEQat4Q7kNvwG2gDMx&_nc_oc=Adp1AJDYmqkKwGHcXxfMZ7AFWVUYCLdefLV2haAbrIgtSmOsoleV00HPgW7T-mwRUDA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3gnBPSBtbSXtFLmNkzoXaVp6XajgmwHtIPNfQOV19mlg&oe=69F0C0B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z1KioCdFxnkQ7kNvwGFxLcN&_nc_oc=AdpbdDFuvqaUWH7zMwo2vBl7FDlnfmfWYJqaOrxgtJy6JVhQ7jfDwhKKQ85W4jPnTbs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2DjNrU7fLofhRASAoiq6yJ8FmmhPSCwwXYeHcjsJtJzg&oe=69F0B420"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480
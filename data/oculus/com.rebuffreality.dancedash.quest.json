2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fM6FeY56RKcQ7kNvwG44SVn&_nc_oc=AdqfYHXic_epbBU8xctoeeZxKnjZtGULr-rxsLuFbQbOBV--B8S17tKbTrSZA8CAzK0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGPjuiqCME2mZtHgWPvkVGmA_p-292oFNuhlTChNCaHA&oe=6AB142FE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKZXaIYv5fIQ7kNvwHpwCPB&_nc_oc=Ado-4gHR40fp6cCX9ZaB7ou-PHrm8IuJRstnL_FgFFLfnipVo5ryScrNcuH1Ne-iFPg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgaIu3O1Wji8Ezc26D2iX_6U-5oZCfnlSTE6JzAddoJQ&oe=6AB1453B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oi_WETGzK9cQ7kNvwFHWSC5&_nc_oc=Adp6lLyD4aNJrT3uZ8jq9cEI0yoJeGfBCCjNcRRxWyn3XhDdsOMYvekyUdxOYFpigiE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkATLgRTesDuootab6sYd8-JtOjty6RVNMn6umB9Xd2A&oe=6AB14338"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JItZtS4LCXwQ7kNvwFx19DI&_nc_oc=Adr3_2ykdSpPmLW6vrAmn12UsiCeCg2k7M-NorlfLTq2lIVWjPP1AkPI92NMWsQpLoQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKztUNx6b2gm1aRFHP3fFwUqlny2kjrL7ZZXMgmPDjtPA&oe=6AB13BB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RVh8xNV0QcQ7kNvwGaFYE6&_nc_oc=Adq3CNebt3j2F15Mz8Sr3u1aPgPG0AQqzlHV-3IWvz2F8nDjwcfV_eYAAA4wzi4TW8k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNfbLUe0BVkzylByieUAmFognOvX_9bHjH3DsDbZrJAQ&oe=6AB12F20"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
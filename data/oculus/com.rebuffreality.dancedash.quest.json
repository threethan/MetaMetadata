t=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lq8AYM4ic0wQ7kNvwEDYi95&_nc_oc=Adn93DtPikrBxFKj5Ysf16IFjQ1Z1hLG2Sml6SctL5exbCxSZcu6519Gu6DOMVIC_90&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx06jUN0ZC46N-olaFDdhcAT8ufZAey_ViRpwmhgcs20A&oe=69AEA4BE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTs1wuCl6XkQ7kNvwHcRZZJ&_nc_oc=AdmM53fBIrid347agBZoJKx-NaugMTCJySjVr1Biw9VOCMPCi0x-DGyY_H6NXiOaapY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRmlx3N96ndcucX6wyibmSQf4FRv1fm7SS1UkESwQT3A&oe=69AEA6FB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1o9iNmogXCQQ7kNvwGdTq2E&_nc_oc=AdlFbutEZB3NDeoa57vaPvR7RB6ChlG5Cs8vSwxxzj-d4IrOj3xjBJ6sgFUPWOxmBJ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzbjaPGQZeJGU4aiOARYz1HISkg9q72ci4o-j44ic4biA&oe=69AEA4F8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rhMrrESyPsQ7kNvwH7dc7Y&_nc_oc=AdmXDrCyHCeHNJgiZi75oT909V5zfsqHOrxFMOIIkyczBANxXcRilP0SeoxaGncXSeI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw58VMffa1STXJEQ869NB86NJ4hTb9P987Ypfq8Iqoorg&oe=69AED5B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Eb5C4aDLqsQ7kNvwFEgv9F&_nc_oc=Adm5B0LLe1OZxFYa9VQjGX_7e1I6-59TFX07nbSNnzZGNx-qHfNzCZlEVaGgz3nPfp0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7DR-RKxztrhVX_D9w4le5kCdF8dtpJMMMmKeqFdgKBQ&oe=69AEC920"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags"
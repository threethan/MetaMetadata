2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtcVRZ6IWY0Q7kNvwEoO02r&_nc_oc=Ado471MCFSGN_gG47Bst2HoZn71r3okUoH8NMC8wwsCKZ3tQDzTH-RrjsOkmOL9c9Ok&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7p8j0uk55hWNSnFnCGVQ_zym_HIMJu-ikqFOadI8ht7w&oe=6A01EB7E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYJgsMKjOHkQ7kNvwGxGwY0&_nc_oc=AdpM5bFBGEhmQSgPKH8BgQnZacMAYhi_fdTtQ-6TCq6aEEYVdCX-qPxPxRo3Jcbp6Tw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uvs0PMDuDlFzjKbf1pOA49Jc9RudZtOM2izcg8TH2Qw&oe=6A01EDBB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgm7W9jZm7EQ7kNvwFSeVqR&_nc_oc=AdqKY_MNQqMyE7WssUepnxtSn1QlxaoxmJbyWBZRBuRWYll6imGPKuEErok_b2dldFc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7z3E2BCXKeeGGcqblhAt-kR0hkXL70-WPVcwd64MC4zA&oe=6A01EBB8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hXbjdeoWN4Q7kNvwHakdxS&_nc_oc=AdrVR3oWI_4DjYskiza-vAWs1HOyHjylqcuXpM1fC6qWfBxfGSebkzKUR3Hn-a3gF1E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uUR6x7lXMKBWbAryyKvXRfMQOXQOmcPnOjZ2y3M9_rg&oe=6A01E431"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2yW7feKKjoQ7kNvwGYDa1V&_nc_oc=AdpVIQYis1DG9hK6C83XiEKG2UokfL60adUBiSJJpCBUhV1ID-3GK4ZFta1uwZfh05c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6imVelO8cXSX-1x1JgbJ4_neyf5uHk7nIn1UWKRs1mZQ&oe=6A01D7A0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5KML4t6bcUQ7kNvwFw-Nnm&_nc_oc=AdrHSvZD2NAisWcpWzN4Wu6Bn5C0d-rGQ2T85TeUbGS9MG3giW7FQMHYyRD4w2Zz1Tg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43apnXA-cbB57EDdUvKxExrpZK2xWGL4oT9M2qI8R8EQ&oe=6A130EFE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYTiW9zhqzUQ7kNvwGaFvQB&_nc_oc=AdpwfLyqoXO9qJwhgv1cH1eoOnZGZRgzLdB65Nh9gx_7Hpf-aLsKFLsqZWL_DuMvZvo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LoTKE-gY_2qd0HVB7mLUmgnf19bO9KRf6ajyLLxfABw&oe=6A13113B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INjz-H6US4gQ7kNvwH-4xRC&_nc_oc=AdrYQqO-slUbuM3j__RyVXlhKpWKztauM2lbCUMyHdjiDI4TAqt-e0VNzXnE2orxavM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KmAJsUDta9ADkuA3tF9YNUB2OpV7nZCrn4gq7bCtFXA&oe=6A130F38"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9bEtNWv-_IQ7kNvwGObFC6&_nc_oc=Ado4mu0PGgRuBUhig5rxQkgBZ_e_1rs4Y41JKvex7PJSciJuhV9A2m8GtVjjly-IrBw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6N-6j96Q0wqQonDc-x0MQd0UHU5fCT21wttUm8uLKg_w&oe=6A1307B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqVgwZTiDKQQ7kNvwG0N2Y4&_nc_oc=Adp3F3wR3jyR4a_ohnWM-qPWEvwF26w44_ZbaThG8ZW-CIlYGR9VhUuEuR5S6vDMl5Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5V60izNXhpdJ4HUp-6CeMvU-x6TDIts4H0Y6dwRoqq2A&oe=6A12FB20"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
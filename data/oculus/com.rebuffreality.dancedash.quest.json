2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgkYUJL5-lsQ7kNvwFgAVh5&_nc_oc=AdqRSV6x82lM7eYuMaicGCcgZ0c4QjXwMa-6Ih8zNVdkdUaEH_LHX_H9LR8O0x6bQHE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwfravegmZs8RF_-iB_JMy5ERN8DjbVWvU4_g0yyPWRg&oe=6AC3B7FE"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCBPR8vS6ccQ7kNvwHGpzxr&_nc_oc=Adowu3OwLucJ-vZPy1Qt494SOOxte9wGSifLkDGlRq-OGA9Rn0fHV3JzrsSTSozqMhA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-dT7SuyIER7CF-0dlvW79ow45JR3K81eaWzggX_2hmQ&oe=6AC3BA3B"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnAkKsr-RvkQ7kNvwHe-x7E&_nc_oc=AdoXuJTMiTGukuk5r66TvE7a7taJYkyBYx1jihnWaLyeBas7QtpoyHTONWu26gxPJdM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNj1owreGLC8ESs1qrcXNwz2Cy9G1pC9fN5H2Uwpixgwg&oe=6AC3B838"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhPHRD4A6g4Q7kNvwGvnrvW&_nc_oc=AdouDXBfh1sbpyDzroDWIJEOsTUTgPxWoZsFO7tQZhPIt2RCfRJo8UavEcGyN5wcwXg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3g_nR6627NhTDKeNQqsXwUMmAgqVFAYtk9JVKOTmmuw&oe=6AC3B0B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LilHLcybq0MQ7kNvwFwbu2t&_nc_oc=AdqV01UV5vh-TdPs23Y1WytYLIeXfkZUfAnG8R78VF_odMghhf_onmtb7t_3R2GG9Y4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdtCy3CqDSPQ_lXFo-bhpzHgJAer6sD385tGI4Hdy_uQ&oe=6AC3A420"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
2676_3109443522369431630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FI8GNtCEriQQ7kNvwHyGZeu&_nc_oc=AdqHLF3j5yhh_9FHqzPvvyFK8B9AIlb6HEOQZ8Xj1neQ993uTtsPYCffTLHzwAnVRqc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HF-Svkyaj7fbe3KJSOsv8tuzneb7HP2O7o7CVIDTNyg&oe=6A26D57E"}, {"file_name": "3.png", "id": "3812334885722142", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610708_3812334889055475_7795052954404349491_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5X43loVoQbYQ7kNvwEFNdnA&_nc_oc=Adq58sRxKdejCFbcBZZaSf6sLypskd-cnuLk9IqaNH0E4MqNJUlwggkKJyVkj6ax4bI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DbnpLblsa40rYkJw_JecC6hWFq1aVeoKLsgVu8yIYkQ&oe=6A26D7BB"}, {"file_name": "4.png", "id": "1884950668645520", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974460_1884950671978853_4975143993225760301_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pHFcl28Tv0Q7kNvwFaucyp&_nc_oc=AdoIsiQ0Uq6YR01WfuxFF1juhe0NdcBgrpPHM6DlHjVkoqgn7qjv0VBMfMsqKo4xsH4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8f0cXaKOqAyPmP_eqYj3P_wbNnOPykDJjVcvfC9gNlA&oe=6A26D5B8"}, {"file_name": "5.png", "id": "528952326267599", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57566697_528952329600932_1590082070944628834_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79aRJeB6eBsQ7kNvwHdSRyC&_nc_oc=AdplfDHe4V94SKT4qtZCQWj_93RsX2czpc6GB4zRYj2RcrnqN0N6ZhMqDnBmtW9DSwM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92CYKBqHIGFTq0slVNdda42RxMmQwq9yY9bUJQAxyDtQ&oe=6A26CE31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DD-meta-video-cover.png", "id": "1531913677428796", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031377_1531913680762129_8526821131804025808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdNbq76CqDkQ7kNvwE5SO5B&_nc_oc=AdqrlvUxShnC3J5ef4NOSNZle_lReZ8yZIYc5uzTc0NHwr_vqqZsC1mRug9nYCz8VF0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8w_iiuidwdBdt65_Iw7xvKC9IRniVKFnZk9Rw6dMEquA&oe=6A26C1A0"}, "display_name": "Dance Dash", "keywords": ["fitness", "beat", "leg", "mods", "fbt"], "long_description": "Dance Dash is the definitive FULL BODY TRACKING game, with AI powered phone camera tracking streaming, with our FREE app for your mobile device. Fully compatible with Quest 2 & 3 standalone.\n# ** Your Gateway to Full Body Tracking\ud83d\udd7a**\n{433447386102396}\n\nStomp the beats in this pulse-pounding, full body sensory symphony on your Quest Headset! Craft your own rhythm, groove to community maps, music, and mods. FREE TRIAL.\n\n# **\ud83d\udc83BUST A MOVE**\n{775062488145996}\n\nDance Dash features intuitive mechanics like ducking, dodging, jumping, slapping, and especially shuffling, making it easy to play and highly engaging. Choreograph your most treasured tunes, and let the world know how you rock!\n\n# **\ud83d\udcabDD Editor to Create, Share, and Connect\ud83c\udf0e**\n{807231754337921}\n\nDive into the DD Editor (separate application), to create your own beatmaps for endless gameplay. Learn cool moves from influencers\u2019 videos, or play original music videos in-game\n\nJoin our vibrant community of members from countries all over the world: discord.gg/dancedash!\n\nSupport: dancedash@rebuffreality.com", "short_description": "Free FULL BODY TRACKING on Quest standalone empowered by AI powered phone camera tracking streamed from your mobile device. Groove to 100s of community songs and maps IN-GAME plus viral dance videos and MVs. Experience Full Body Gaming Without Limits in the most engaging arcade-style rhythm game ever."}]}, "developer_name": "Rebuff Reality", "developer_privacy_policy_url": "https://rebuffreality.com/pages/privacy-policy", "developer_terms_of_service_url": "https://rebuffreality.com/pages/terms-and-conditions", "publisher_name": "Rebuff Reality", "support_website_url": null, "website_url": "https://www.rebuffreality.com/", "category": null,
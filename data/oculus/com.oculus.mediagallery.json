0_AQS3i4clAnyXLHLjoP4GAVi90AzW2Fwlf-FUgM3NvmNtBQ&oe=6AFB214E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Oculus Gallery", "keywords": ["Gallery", "Photos", "Videos", "Movie", "Dropbox"], "long_description": "After June 15, 2023, the Oculus Gallery app will no longer be available on Quest.\n\nHowever, we\u2019ve added the ability to view your media in the improved Oculus TV app where you can also access a growing library of VR immersive content. \n\n_____\n\nGet totally immersed in your panoramic and 360 photos and watch your videos in a virtual home theater!  You can stream your personal media and DNLA/UPnP.", "short_description": "After June 15, 2023, the Oculus Gallery app will no longer be available on Quest.\n\nHowever, we\u2019ve added the ability to view your media in the improved Oculus TV app where you can also access a growing library of VR immersive content. \n\n_____\n\nGet totally immersed in your panoramic and 360 photos and watch your videos in a virtual home theater!  You can stream your personal media and DNLA/UPnP."}]}, "developer_name": "Oculus", "developer_privacy_policy_url": "https://www.oculus.com/privacy", "developer_terms_of_service_url": "https://www.oculus.com/terms", "publisher_name": "Oculus", "support_website_url": null, "website_url": "http://www.oculus.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_i
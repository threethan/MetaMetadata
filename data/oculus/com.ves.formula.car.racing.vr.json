e7a0a&_nc_ohc=PzA3EgLLlDUQ7kNvwHG50Cd&_nc_oc=Adp-ib-Pj47uinOjIMr8HBk-yjSPZ8p_kldZuU2drpOUff6beUOGHgoC0Ellm_K_Tf4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQStZmR6iv1ExpvcvBSRo3Ym1uhqY7IA6O4aRqbEcleqw&oe=6AFC925E"}, {"file_name": "EDSQ.png", "id": "1801100907884635", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596068480_1801100911217968_7529658598035932646_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mS0Uv2u8tT8Q7kNvwE5UtiC&_nc_oc=AdoVc8UOEoeHtQLedFsealQRAUIse098jDlgHAcENn46evlxiQhbnGjbqfcu4k9H5d8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUAMCnU1s95eP7IsoIxPLlpSp1MEWB_miD5gtMybQu-g&oe=6AFC80DB"}, {"file_name": "5RA.png", "id": "1418003193091184", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673573223_1418003196424517_481561007532468854_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_gEtYAOVQIQ7kNvwHqsgdd&_nc_oc=AdolvpOzmvn8yXTIQ1mG4so0IaHlF0Npnoz9m_yojFTJ4wImagaw4vlrqNboH2T9ZBA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ14i85rjfXFwx47TSc4nzaGLEGPW9alEu8gh2OumBh7A&oe=6AFC80CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Formula Car Racing Game", "keywords": ["f1game", "formulagame", "carracinggame", "racinggamevr"], "long_description": "Get ready to feel the speed! \ud83c\udfc1\n\nFormula Car Racing Game puts you directly behind the wheel of a powerful Formula-style race car in an immersive VR racing experience for Meta Quest. Feel the intensity of high-speed racing as you accelerate down the track, attack corners, and compete for the fastest lap.\n\nDesigned to deliver an exciting and accessible racing experience, the game lets you experience the thrill of Formula racing from the driver's seat. Every turn, straightaway, and braking zone becomes a test of your control, timing, and racing skills.\n\n\ud83d\udd25 Race at Full Speed\nPush your Formula car to its limits and experience the excitement of high-speed competition.\n\n\ud83c\udfce\ufe0f Immersive VR Driving\nStep into the cockpit and experience racing from a first-person perspective designed for Meta Quest.\n\n\ud83c\udfc1 Master the Track\nLearn every corner, improve your racing line, and chase faster lap times.\n\n\u26a1 Competitive Racing\nChallenge yourself to become faster and aim for the top of the leaderboard.\n\n\ud83c\udfae Built for Meta Quest\nEnjoy an immersive racing experience designed specifically for VR.\n\nPre-order now and get ready to start your engines!\n\nPut on your headset, take control of your Formula car, and discover what it takes to become a racing champion. The track is waiting. \ud83c\udfc6", "short_description": "Experience high-speed Formula racing in VR! Take the wheel, master every corner, push your limits, and race toward victory in an immersive racing experience built for Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vision-edge-studio/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Vision Edge Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vision-edge-studio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1395886220255250"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
tent-sin2-1.oculuscdn.com/v/t64.5771-25/491821913_635091892871737_6305162872121935692_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCoPHZYTCYUQ7kNvwGbSPFX&_nc_oc=AdpidJARHfHSLvNJWnCotTrl-3pHtoVHxqRGyDppG2GUafBvu2IStrCvI1MLoWwtfAo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7Kzb699SgfvqpOJ2yF3bymBK0iVpFGVwx1eM0vRNGGQ&oe=6AA95E99"}, {"file_name": "Horror test map_Custom..._08.06.2025_12-13-26.png", "id": "1218628432696926", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491820956_1218628436030259_3024766798224201873_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qR83WTV8zD0Q7kNvwFZ7YP6&_nc_oc=AdpeFEvPXKJHzp5NeNTb-EYSnfqEEqY-wXuKwcmTM8h8wQlGPHjsv8fKlMDs2_7tKXY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfnqR2p-5jvTX_oc2v2vExcNWTRMatVltNlworJvyiFw&oe=6AA965C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Liminal Chimps", "keywords": [], "long_description": "Liminal Chimps is a strange and silly horror adventure where weird chimps roam even weirder places. Explore surreal liminal spaces\u2014like empty malls, looping hallways, and glowing office rooms\u2014while avoiding the unpredictable chimps that call them home.\n\nThey're not exactly dangerous... probably. But they are mischievous, loud, and full of surprises.\n\nWith a mix of light horror, strange environments, and fun chaos, Liminal Chimps is a bizarre journey that\u2019s more funny than frightening. Just don\u2019t let your guard down\u2014these chimps play by their own rules.\n\n", "short_description": "Liminal Chimps is a unique mix of horror and surreal fun. Navigate eerie, liminal spaces haunted by strange, unpredictable chimps. Expect unsettling environments, bizarre encounters, and moments that blur the line between fear and absurdity."}]}, "developer_name": "FearDev", "developer_privacy_policy_url": "https://sites.google.com/view/liminal-chimps/privacy-policy-liminal-chimps", "developer_terms_of_service_url"
7kNvwFwY5d4&_nc_oc=AdoYNL1l7NesT3Vo1938hgop6nJbZts0eoK5bVsKU7z6VjyufjEQ18vzpgQDFS-gj6k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3t0GzfCcuMCS4ZOctIzZkEik-M6LK-iaeoKIlPtGkd4w&oe=69F0CC99"}, {"file_name": "Horror test map_Custom..._08.06.2025_12-13-26.png", "id": "1218628432696926", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820956_1218628436030259_3024766798224201873_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Or8hdbqSdnYQ7kNvwHcQra6&_nc_oc=AdqA0QzbKQC_cq_GxCyqMnmVLKwIvVJ6vao0L4qi4jE_G0O2_W7EdUSXsnKRZSRSHuQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2EhzhY1wd5H_1vuRJZJQQ6ZjOo1S6lhf1KKctSVvhRoA&oe=69F09B87"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Liminal Chimps", "keywords": [], "long_description": "Liminal Chimps is a strange and silly horror adventure where weird chimps roam even weirder places. Explore surreal liminal spaces\u2014like empty malls, looping hallways, and glowing office rooms\u2014while avoiding the unpredictable chimps that call them home.\n\nThey're not exactly dangerous... probably. But they are mischievous, loud, and full of surprises.\n\nWith a mix of light horror, strange environments, and fun chaos, Liminal Chimps is a bizarre journey that\u2019s more funny than frightening. Just don\u2019t let your guard down\u2014these chimps play by their own rules.\n\n", "short_description": "Liminal Chimps is a unique mix of horror and surreal fun. Navigate eerie, liminal spaces haunted by strange, unpredictable chimps. Expect unsettling environments, bizarre encounters, and moments that blur the line between fear and absurdity."}]}, "developer_name": "FearDev", "developer_privacy_policy_url": "https://sites.google.com/view/liminal-chimps/privacy-policy-liminal-chimps", "developer_terms_of_service_url": null, "publisher_name": "FearDev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminal-chimps/home", "category": null, "comfort_rating": "COMF
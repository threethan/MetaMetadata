-lga3-2.oculuscdn.com/v/t64.5771-25/491821913_635091892871737_6305162872121935692_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckq9xxYTK9cQ7kNvwERth-J&_nc_oc=AdrtS0JuntnXk6t_dtyZQv5TtW9dNhWmYpc1AMLqvzq_zyLv7rF9pVjIUgfzQccWbKw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0DN3t7d0dIgoTfJfkDW0GsA0U4Arv9B_Azn-C9A3-Fg&oe=6AE8A699"}, {"file_name": "Horror test map_Custom..._08.06.2025_12-13-26.png", "id": "1218628432696926", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820956_1218628436030259_3024766798224201873_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuXYWmueDAsQ7kNvwEEUW89&_nc_oc=AdrdQDO-IUBLE0ZCn78g1nJ5O6YQ86QS3XCoZG1qmlPa9eRFEXHIxAQ9foCXamK4t3Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREsDjWZ-zbk6HBxUtnDpUz0_fueEYOQ3hq-1ibfuYyOg&oe=6AE8ADC7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Liminal Chimps", "keywords": [], "long_description": "Liminal Chimps is a strange and silly horror adventure where weird chimps roam even weirder places. Explore surreal liminal spaces\u2014like empty malls, looping hallways, and glowing office rooms\u2014while avoiding the unpredictable chimps that call them home.\n\nThey're not exactly dangerous... probably. But they are mischievous, loud, and full of surprises.\n\nWith a mix of light horror, strange environments, and fun chaos, Liminal Chimps is a bizarre journey that\u2019s more funny than frightening. Just don\u2019t let your guard down\u2014these chimps play by their own rules.\n\n", "short_description": "Liminal Chimps is a unique mix of horror and surreal fun. Navigate eerie, liminal spaces haunted by strange, unpredictable chimps. Expect unsettling environments, bizarre encounters, and moments that blur the line between fear and absurdity."}]}, "developer_name": "FearDev", "developer_privacy_policy_url": "https://sites.google.com/view/liminal-chimps/privacy-policy-liminal-chimps", "developer_terms_of_service_url": null
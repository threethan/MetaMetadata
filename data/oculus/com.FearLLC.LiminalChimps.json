es haunted by strange, unpredictable chimps. Expect unsettling environments, bizarre encounters, and moments that blur the line between fear and absurdity."}]}, "developer_name": "FearDev", "developer_privacy_policy_url": "https://sites.google.com/view/liminal-chimps/privacy-policy-liminal-chimps", "developer_terms_of_service_url": null, "publisher_name": "FearDev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminal-chimps/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24937233322533146"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1898152627636290"}]}, "baseline_offer": {"id": "1898152627636290"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749748920, "status": "PUBLISHED", "id": "1898152627636290"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25335545262701948", "version": "0.24"}, "id": "1247743853732595", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24850710007852145", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25335545262701948"}, "release_status": "RELEASED"}, "binary_re
DGIThjX0zqt_wSNsY5Ba9e9jWLCt4KwCXaOc0Z_YM4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQda-gOmP8ER0EQOPgbUNCvk5DQTCU27DxC-Fu8Hz6W-g&oe=6B071800"}, {"file_name": "Horror test map_Custom..._08.06.2025_12-13-19.png", "id": "635091889538404", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821913_635091892871737_6305162872121935692_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jCujNtHXU4Q7kNvwFIaFXw&_nc_oc=Adq6EgKtTY4JF763OIGdkfWE5r0Itr2snOAKAhMq4G1VGOpKq0Z0VBRckNKwYN5kz4s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTffPGFr8ofyM33gLQ99JHZphU010bmAFeZymlfUb7s_A&oe=6B06F919"}, {"file_name": "Horror test map_Custom..._08.06.2025_12-13-26.png", "id": "1218628432696926", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820956_1218628436030259_3024766798224201873_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GT5OkRBBcwIQ7kNvwFUFDyP&_nc_oc=Adqg6xCkgXLoAmiCkCZmanoFPBZWtOZoxyYbDypi2PtVB_uBCWxW9CIKUzOLM-Nng2M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsGUMUU9JEFa1nRdHUDYufpbCltTjtTFZiAKZzTNVxpQ&oe=6B070047"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Liminal Chimps", "keywords": [], "long_description": "Liminal Chimps is a strange and silly horror adventure where weird chimps roam even weirder places. Explore surreal liminal spaces\u2014like empty malls, looping hallways, and glowing office rooms\u2014while avoiding the unpredictable chimps that call them home.\n\nThey're not exactly dangerous... probably. But they are mischievous, loud, and full of surprises.\n\nWith a mix of light horror, strange environments, and fun chaos, Liminal Chimps is a bizarre journey that\u2019s more funny than frightening. Just don\u2019t let your guard down\u2014these chimps play by their own rules.\n\n", "short_description": "Liminal Chimps is a unique mix of horror and surreal fun. Navigate eerie, liminal spaces haunted by strange, unpredictable chimps. Expect unsettling environments, bizarre encounters, and moments that blur the line between fear and absurdity."}]}, "developer_name": "FearDev", "developer_privacy_policy_url": "https://sites.google.com/view/liminal-chimps/privacy-policy-liminal-chimps", "developer_terms_of_service_url": null, "publisher_name": "FearDev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminal-chimps/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24937233322533146"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1898152627636290"}]}, "baseline_offer": {"id": "1898152627636290"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749748920, "status": "PUBLISHED", "id": "1898152627636290"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25335545262701948", "version": "0.24"}, "id": "1247743853732595", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24850710007852145", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25335545262701948"}, "release_status": "RELEASED"}, "binary_re
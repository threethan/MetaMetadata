ohc=GK7J48ucP8IQ7kNvwG9ao4N&_nc_oc=AdqDDTsCg6O1W7-zAG8hWHg7yQGwhrnRS9V5pT9nmWw1NUqglao0fA7qnwuhfqsqtBs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KfOoTdGq-LChxDYSZoBuPvuj0kVaAPB4tt56lQQedpg&oe=69D63659"}, {"file_name": "Horror test map_Custom..._08.06.2025_12-13-26.png", "id": "1218628432696926", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820956_1218628436030259_3024766798224201873_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njAertHR5fAQ7kNvwGSfWNN&_nc_oc=AdpkV5lHcOcZ5xzg0qffHtcPsuD0Jmv3bDd_CGpr-KKPQ-x-34jlEZ0LM62boCYAfks&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1p-aG2uJ1jwNLh5Rtke_ogcSc67oLYxMJzEx-12Z12Hg&oe=69D63D87"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Liminal Chimps", "keywords": [], "long_description": "Liminal Chimps is a strange and silly horror adventure where weird chimps roam even weirder places. Explore surreal liminal spaces\u2014like empty malls, looping hallways, and glowing office rooms\u2014while avoiding the unpredictable chimps that call them home.\n\nThey're not exactly dangerous... probably. But they are mischievous, loud, and full of surprises.\n\nWith a mix of light horror, strange environments, and fun chaos, Liminal Chimps is a bizarre journey that\u2019s more funny than frightening. Just don\u2019t let your guard down\u2014these chimps play by their own rules.\n\n", "short_description": "Liminal Chimps is a unique mix of horror and surreal fun. Navigate eerie, liminal spaces haunted by strange, unpredictable chimps. Expect unsettling environments, bizarre encounters, and moments that blur the line between fear and absurdity."}]}, "developer_name": "FearDev", "developer_privacy_policy_url": "https://sites.google.com/view/liminal-chimps/privacy-policy-liminal-chimps", "developer_terms_of_service_url": null, "publisher_name": "FearDev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminal-chimps/home",
c_ohc=MewIWk10gqEQ7kNvwFVnKxH&_nc_oc=AdqgzdcaN76YGxEz6G7jNjSVIWTU4HeY3JDqmGp2FYTSz_wltAZ-T3shQm9GYi7EbB0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY1RsAHzt5prhUoeL0HuI2dg5fEHRw5HeoiWiiZ5XjMA&oe=6AFDB91D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta App Cover.png", "id": "2067715230301659", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825052_2067715233634992_1552264466354846139_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lR2B4z7G0YQ7kNvwELDN8P&_nc_oc=AdrkQy2Nqy6EL7B-4gEG_gVQArHaWbS6vlmvmTU3mPE2JEfX0lnfiSEB89h_D6PxGCw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjgMjliCeXFI-2e4gl6sJacgLyMY-3g8Cq_SJ6vDbvew&oe=6AFDBA7E"}, "display_name": "Air Pistol 10m Shooting", "keywords": ["shootinggame", "10mpistol", "airpistol", "olympic", "aicoaching"], "long_description": "# Experience Olympic-Standard Shooting \u2014 Anywhere\n\nTrain like a professional with a digital version of real Olympic shooting ranges. Whether you're practicing for competition or just want to improve your aim, this platform gives you realistic, high-quality training.\n\n# Smart Coaching That Helps You Improve\n\nGet personalized coaching powered by AI. The system learns how you shoot, finds areas where you can improve, and gives you clear, useful advice to help you get better, faster.\n\n# Real-Time Feedback\n\nUnderstand how you shoot with instant feedback on your grip and aim stability. Focused training drills help you build precision and consistency over time.\n\n# Practice on Your Schedule\n\nTrain anytime, from anywhere. All you need is access to the platform to start building world-class shooting skills.\n{24274164718912152}\n", "short_description": "Experience Olympic-standard shooting in a digital replica of real ranges. Get grip and aim stability feedback, focused drills for precision and consistency, and personalized AI coaching to accelerate your progress."}]}, "develo
c_ohc=mBxJUhj72jkQ7kNvwHztWfn&_nc_oc=Adpx78jZfJMteTO-qadvu3aK1_3Rqqhgy71Atnu1BaKyXX7nWe-KspGiUQu1br5pi3Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSpQ_-5QyWpikEkxYM3X9FCuDYsCkVz3-yqULZ5IK76A&oe=6AFB161D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta App Cover.png", "id": "2067715230301659", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825052_2067715233634992_1552264466354846139_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S15fL5IkNgYQ7kNvwHkd_4B&_nc_oc=Adp4cWf2wCKsUxWenx8Ahgegr6avolK75NWHyzcvX3iS-G3cppOnxkjMqWaAXRM-dII&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBGvjkvHE93ZCI_vB6IyCYNzsscGqAfyeEvCUIuRgd8A&oe=6AFB177E"}, "display_name": "Air Pistol 10m Shooting", "keywords": ["shootinggame", "10mpistol", "airpistol", "olympic", "aicoaching"], "long_description": "# Experience Olympic-Standard Shooting \u2014 Anywhere\n\nTrain like a professional with a digital version of real Olympic shooting ranges. Whether you're practicing for competition or just want to improve your aim, this platform gives you realistic, high-quality training.\n\n# Smart Coaching That Helps You Improve\n\nGet personalized coaching powered by AI. The system learns how you shoot, finds areas where you can improve, and gives you clear, useful advice to help you get better, faster.\n\n# Real-Time Feedback\n\nUnderstand how you shoot with instant feedback on your grip and aim stability. Focused training drills help you build precision and consistency over time.\n\n# Practice on Your Schedule\n\nTrain anytime, from anywhere. All you need is access to the platform to start building world-class shooting skills.\n{24274164718912152}\n", "short_description": "Experience Olympic-standard shooting in a digital replica of real ranges. Get grip and aim stability feedback, focused drills for precision and consistency, and personalized AI coaching to accelerate your progress."}]}, "develo
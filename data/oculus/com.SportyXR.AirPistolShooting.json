3634992_1552264466354846139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lX1WRxAifEkQ7kNvwGTOhg6&_nc_oc=Adq3Xcw5YXyq1zrd4aAq-9QzyJOvqGmrXNzg-USJ4my3Nzdz9MjHb-70Jh4fr6he9Ew&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHBAxLqzissiaBBE2SnJpvgPwHmeXiejxP9e78BLuEEw&oe=6AA4147E"}, "display_name": "Air Pistol 10m Shooting", "keywords": ["shootinggame", "10mpistol", "airpistol", "olympic", "aicoaching"], "long_description": "# Experience Olympic-Standard Shooting \u2014 Anywhere\n\nTrain like a professional with a digital version of real Olympic shooting ranges. Whether you're practicing for competition or just want to improve your aim, this platform gives you realistic, high-quality training.\n\n# Smart Coaching That Helps You Improve\n\nGet personalized coaching powered by AI. The system learns how you shoot, finds areas where you can improve, and gives you clear, useful advice to help you get better, faster.\n\n# Real-Time Feedback\n\nUnderstand how you shoot with instant feedback on your grip and aim stability. Focused training drills help you build precision and consistency over time.\n\n# Practice on Your Schedule\n\nTrain anytime, from anywhere. All you need is access to the platform to start building world-class shooting skills.\n{24274164718912152}\n", "short_description": "Experience Olympic-standard shooting in a digital replica of real ranges. Get grip and aim stability feedback, focused drills for precision and consistency, and personalized AI coaching to accelerate your progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sportyxr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "SportyXR", "support_website_url": null, "website_url": "https://sportyxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "26876553382
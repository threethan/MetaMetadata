=6e7a0a&_nc_ohc=hczpgj0Ef74Q7kNvwH6pqlD&_nc_oc=AdkdapZ5lStO0a_P3oParK4az7awWzHTD8jn5k2lhkW8atkJ2fOvwETP2FlPgnF1KnQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJ_U7CyMJj-t9DoeXpg5jZhYn8txxfEk_JE6qn9601KQ&oe=69BE773E"}, "display_name": "Air Pistol 10m Shooting", "keywords": ["shootinggame", "10mpistol", "airpistol", "olympic", "aicoaching"], "long_description": "# Experience Olympic-Standard Shooting \u2014 Anywhere\n\nTrain like a professional with a digital version of real Olympic shooting ranges. Whether you're practicing for competition or just want to improve your aim, this platform gives you realistic, high-quality training.\n\n# Smart Coaching That Helps You Improve\n\nGet personalized coaching powered by AI. The system learns how you shoot, finds areas where you can improve, and gives you clear, useful advice to help you get better, faster.\n\n# Real-Time Feedback\n\nUnderstand how you shoot with instant feedback on your grip and aim stability. Focused training drills help you build precision and consistency over time.\n\n# Practice on Your Schedule\n\nTrain anytime, from anywhere. All you need is access to the platform to start building world-class shooting skills.\n{24274164718912152}\n", "short_description": "Experience Olympic-standard shooting in a digital replica of real ranges. Get grip and aim stability feedback, focused drills for precision and consistency, and personalized AI coaching to accelerate your progress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sportyxr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "SportyXR", "support_website_url": null, "website_url": "https://sportyxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "2687655338230691"}, {"id": "1043107547362485"}], "external_subscription_type"
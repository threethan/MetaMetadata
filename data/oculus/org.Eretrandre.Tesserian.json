60"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1096424303387334", "version": "1.3 (40)"}, "id": "902207035780912", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1020101031019662", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1096424303387334"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "902207035780912"}]}, "change_log": "- Quitting the game now closes it right away. Before, a \"not responding\" message could sometimes appear and keep returning until you closed the app.\n- The highscore list now shows in brackets the store each player's name comes from, so you can look them up.\n- A tutorial instruction is reworded to make clear that you can place a piece in several steps.\n- The Feedback button in the menu now has a NEW sticker.", "created_date": 1793302597, "id": "1096424303387334", "version": "1.3 (40)", "version_code": 40, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1020101031019662", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1096424303387334"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "902207035780912"}]}, "change_log": "- Fixed a \"not responding\" dialog that could appear when quitting the game and kept returning until the app was closed; quitting is now also quicker", "created_date": 1793299091, "id": "1096385300057901", "version": "1.3 (39)", "version_code": 39, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1020101031019662", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1096424303387334"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "902207035780912"}]}, "change_log": "- New Feedback page in the main menu: write a message to the developer and send it from inside the headset, optionally with your e-mail address if you would like a reply.\n- Clicking into a text field now opens the Quest system keyboard. Click away from the field to close it.\n- Smoother, less jagged edges in night mode, in puzzles and in the Polychoron Watch.\n- Smoother edges in the Polychoron Watch when an exhibit is shown with Inset edges or without edges.", "created_date": 1793130447, "id": "1094406353589129", "version": "1.3 (36)", "version_code": 36, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1020101031019662", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1096424303387334"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "902207035780912"}]}, "change_log": "- The hummingbird in the title sequence now draws itself smoothly, at an even pace through its tight curves, with a tapered pen tip instead of a trail of separate dots.\n
gAOMOVSpxVR7MbtyXoRspw&oe=6AC2539A"}, {"file_name": "sozai3.png", "id": "561939999646359", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyLScE1kg8YQ7kNvwG7pOAu&_nc_oc=Adow7OUXwEQReip8atqZ5sYuqfSUMsZJ3K3PNf1T-7SVcldCVawgC9bydvQdTtOWywU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8RFr2Geap2fB9A9HoybJhhm6TXBY9N70M89QNxjTG2g&oe=6AC258CB"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMjpxAdlg5wQ7kNvwEAXXGP&_nc_oc=AdoxpxJPmWMZm4wpX5K264KHhUkM9YEIjcqTE7ivA1P8Lf8WIBFf84X9KLSvbejrUVs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8_x5pnD0tsZfvFI_DfAXUCyzENFbHO5MkLq3nIXqg0g&oe=6AC255B6"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4urr6nPHs40Q7kNvwFqo5AK&_nc_oc=Adqi_Lybl_5qW4LuuZS1DsF6VDkqJGlvHNiJLeOAY2CDUo_8pEJR2QmtHSZyBljizV8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEwpo9_6BqqFyac6cP3iKFQ6MyOuojkP8-ePaKQ7FAMA&oe=6AC26574"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L68KqMPJSG8Q7kNvwFc-0YQ&_nc_oc=AdpHSCmsCQxlJFG4RBh5IGSOIfyyHOMhQn16Yi46uz9HO5DteUCG6xAqC-ydeWfHN4Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVfSV-eIxRvrA6TdpWDQ-plr9XidwdhURK6iNViRA09Q&oe=6AC25844"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102
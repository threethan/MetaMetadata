3391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nBRZH10mNcoQ7kNvwFD3cvw&_nc_oc=Adr4Anjp-NA4c4Z2WWf0GBrvWmXVDsBlrGBqXMv3Z1xme-Fhi8dOIYDUdRAnd-NElv4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyY9EgPvgBU0aMmtyuAPeo40mO1ZUessyvEzqtPzdnvCg&oe=69C1444B"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCdNJaTbhSMQ7kNvwEt3aRs&_nc_oc=AdoJbORVqloGAw5KNV5VRcr1DGHaOReqBsD6n1NxFUEiFtxXXXyZJxYU_ukuTDmgfmk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDiYQt-zTZlw9Tf4xVAp9BHETSsu7G_zXDWBsXleNnwA&oe=69C14136"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZsAV6VxDuwQ7kNvwGLq2SV&_nc_oc=AdoaLSjOsljest_b3aaR5FhCiStYA9A7nBCf3Ap3A2SmiVL5DAUYfGrnDG3IZBU3TzQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyt28S_GUwEyz6MWwrkKx60lmCbp6JO2Oke_VOuzVPISA&oe=69C150F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=112aD_2_R2MQ7kNvwHK-12a&_nc_oc=AdqZ9YhQc9I0kERYBw79_gkoyk1IU8CtL1vHNyf7NTOZMaWQU4Lqpok6r6pHUwRTYUw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwicsGCqmRgIt0J8gq4WrvTlbXbD0EbzvA22EV8EcpiKQ&oe=69C143C4"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTU5mgBIV34Q7kNvwFn60CK&_nc_oc=AdrFiuUrD05jz9lBm0y3mvpz2czy6wcXHIDeyj2AqWt_ICv8UbiD3ltTmsny71G1JnI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculus
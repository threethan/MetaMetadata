3391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3Uept_xF9kQ7kNvwHhW-91&_nc_oc=Adl4KXueq8fdvcFF1vfKJUcldEFJaYcsbuXHZrO2UeSuVEoG4Pw_GaCcRr9bEnCiejg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtU7ATGjAyEjZU9R17g0BIAml15bqz68fE3PW9x5oGYA&oe=69B95B4B"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NB8ZOH1D4VsQ7kNvwE0wBaH&_nc_oc=AdmuqgObhywIuqzPmnMkR3a_lTqc0LJ0yPP4K06AgESjnS9BWOrNcoPykappsInZPBU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzgXQCQbCwGr9W2LyjLXi09f5WAN9AVGU6wflAJCiCd1g&oe=69B95836"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GL6J6n6S2wkQ7kNvwGmi6IG&_nc_oc=AdnCB2mvv5cmAk9CuGyrm0aSvn210sWmVJBu1_lqGwT10iWmIrwsZOHviWTbKmkqXeM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxF8GYFaJyYBBs2n4CPOBYb3PurawbH5Hz-HVrv84ILSw&oe=69B92FB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spBvC7om1c4Q7kNvwGi-qvN&_nc_oc=Adkg9lmCTDW4jtjMDRMyScHuwgaj1v1qanM1F_yOrlfMn-gAAeylFQCHr2qeYSKXWP4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfztFi5S5XzuHpWTVkur12Vls2LD2fIx7Ye1JcMfipEfJg&oe=69B95AC4"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZORyNdDfqikQ7kNvwENwmBa&_nc_oc=AdmfiUo5QR30DwMR4zKQhkX_-KVEESNW-KGWGywlK8XBebp2e1slx-7B6g-jMOfjhYE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculus
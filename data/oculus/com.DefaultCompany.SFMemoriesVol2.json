8FPMNglXvAOr2n3WuSvWA&oe=6A3FCF1A"}, {"file_name": "sozai3.png", "id": "561939999646359", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xykh1n7v_8cQ7kNvwFBF1hp&_nc_oc=Adox3JF6z3JcJcuTVtwBpS0g_-_VS5leqVXsHwkP-6HUFYIg823wxIVeWlz7qD-AaZk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b1VM99wrl4reZPsiA4NNT21sXVsU_OuAkQ5l9KoolBw&oe=6A3FD44B"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHFgkqaHosYQ7kNvwEvhZq6&_nc_oc=Ado_xwkDN7LKxOPc-5ZYceOswNG2Y-mUQMq_yZ4mdrv1YfRMvYVw0zew3OU75cPP-Ac&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9neVHhrJzoVicvrErjJfMAYItWpjnE9_zzuUksOYq5Cg&oe=6A3FD136"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjfDGmyC4YwQ7kNvwHC0ikO&_nc_oc=AdowuWCrdR2N2-joKVWz8UfOTQvGTlH4wdn5K65hv2QpCmREUzk1Pfo6u9NBr0tXKWA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ofjrTRzNIDO6-14R8MFshDvNctvyOqPCQQki-QATygA&oe=6A3FE0F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PcOs89vw7g0Q7kNvwF7SbcO&_nc_oc=Ado_cIE1yZycdEIfIXVihKrvnj2oU0f_jE5g_tdyBCa621JHOwz73h1vEwOyGC0rxW0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87wf_Wd6fUXAIpniYXe5NLWKbt-SnEfscpgOmIRU5oAA&oe=6A3FD3C4"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102&
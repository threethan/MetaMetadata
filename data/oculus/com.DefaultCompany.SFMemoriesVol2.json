4njK66B3KNy7PBLWTR1Y2A&oe=6AE88F1A"}, {"file_name": "sozai3.png", "id": "561939999646359", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R85rtZvzHlwQ7kNvwHMVC6Y&_nc_oc=AdqHGn8Egn4hoJnywAPszHVM0quscDVTFHs1Y3Utya-q4kI79uDFkEI6KlD2LAWfvzQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNpEfIkr2XUcmMrMs2l7DLvx7Bkej3eYVCCnaOgLpyUA&oe=6AE8944B"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aj4WHzBrMscQ7kNvwGRGJ3J&_nc_oc=Adr1agr2XiZ8QmOCvQn-8liHmbwlCDEMLcDHRTB0POKBFQa5emPF2digHCQ0sbNufSc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQdW643N93_ZesBKU5bHffcDMM1phXD6jRS70Hgyd10w&oe=6AE89136"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnECsUC4-lsQ7kNvwHZ0LQc&_nc_oc=AdoA_kLsmqS-_u-rxrVNoaBR0tbj1uD8rEy6EPNpCClsiHIDl4iHTkFcs2ujXwMliLw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyI6isTlnaQVMg2WwKrstGrQZpghBcS0Xa1DBle3c9TA&oe=6AE8A0F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSLyL6AmbkAQ7kNvwGUWMjP&_nc_oc=AdrCAGauQuCzb1AV89CvXc9gJIAqvYaV6ZKJbo3w9Lxp4QoIzvd_dMX0I1dtjVIyPN4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKYSlR8Afw4sKnG1YKxLkLRG-Twc6txNfSTcvT1E3OqA&oe=6AE893C4"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102
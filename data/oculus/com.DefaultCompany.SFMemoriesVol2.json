0f&oh=00_Af-YPDBwCmwieN0_mPYIwfRwuwCbgSx10PLmkOqET2t-Jw&oe=6A36949A"}, {"file_name": "sozai3.png", "id": "561939999646359", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdHrlmakTOkQ7kNvwH-89Md&_nc_oc=AdpLHmxnflFGJRZDtOuYO3uGGx8B0-9KtU6Qr13Nxq8EwbHxpyiXtFtsKvBSYxZt8SM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZZkR2E230vb-MJpoof2Lv0xhEF2lib13bg8i2PSpH1w&oe=6A3699CB"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dngY-4l3kzUQ7kNvwFz3QZf&_nc_oc=AdpYHXLOXwgPeTSdKYLIP0IAmBEgcB95LVI66mc3iu-wJ97R4hQTwD-3MKWo6Hg9lsw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A_9pLa28P6QOd3_cYTX2H4OAbKdo63Fd11xKkyZKDrQ&oe=6A3696B6"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0hM_g-fijsQ7kNvwFwqxPx&_nc_oc=Adr33Xttm0lgFVjd6blUMVz0PFwHeeez86CPhQqAYSJ3DeGS89L6fm3nfGzWqdf5d24&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NRw0KQPGOS7fi8isOL9I09a1z8yC-uC-o7GO5W5N_Zg&oe=6A36A674"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYMrkDtmt0kQ7kNvwEowFXR&_nc_oc=AdqNjZ8RzvMiHuYSi_oD__MvKtQTyEClrd4cQIXHd_AqzFrP5j6z1On01g0p-ceh_wc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xvc7Hc0T51g9Rwzu8B7hBM7VkCea8aCp6uGSJ62o1zA&oe=6A369944"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_
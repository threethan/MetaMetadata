3391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_4tJCmjQ4MQ7kNvwF0b3qX&_nc_oc=AdktWXmY32zw65rzrVOP6nj0BJEgNLHjtCorwzluCNYmeFdUH4nwfqafTFepYgLZbnA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyyUxKM4Ol5O1-fCLPUHSFsV0_u4a8V3Zvx68hAdDWvbA&oe=69B020CB"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFjtj4EyV2MQ7kNvwH_jsa3&_nc_oc=AdlvEyksKwcrEP8jlYcHW_pGTsbzJYAnFdLcpc46_jYsq6rNapPe5Keb0OPMLiipNBc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4CaPUFTFAwNf-g0zEpZucM1ibcULYXbyTLtXocKsipQ&oe=69B01DB6"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kYWb1J2CIIQ7kNvwE5VEme&_nc_oc=Adm_dn6mTud7ea1S_VgDctgelUb-PvYplQzI4inFH74XJtNiIlY1f9c8XAjMKLvn4NU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKnehGGvUsf5pVOu2nYcWYsgFrIpftdUxrXSwohkX0wQ&oe=69AFF534"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9m6icz0PnMQ7kNvwEW96gr&_nc_oc=AdnwYnIRYMB9TgIxwF6qemQeJbW_zl2ayE0dho4iLAm5ajidv6Ca1xj7Tbqgln4R5Og&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxdDp6Slcaz5SsEKEmi5aFplwBmTFxmT-GQWADW5OLjEg&oe=69B02044"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=un9hxv8FTQAQ7kNvwERDVMP&_nc_oc=AdmOeCIMMMzPAmwu4oOPhpFQkH9Kqq0F_Nk444BMemxlxhQzvOS_XFQdkUppZttqj5A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculus
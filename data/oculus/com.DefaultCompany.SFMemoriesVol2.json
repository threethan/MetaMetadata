3391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQJ0bYLge8IQ7kNvwELhM4o&_nc_oc=AdnMHnxSICZLXqPlHqDALC2HInxKXBaKQy4OOkv46XA5a4UvRrL21kW22_RvviXrytU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwqnzsNcJGLB_7fDXDV2--0egpSJuvKC7to29Aq3-adKw&oe=69B1724B"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFjtj4EyV2MQ7kNvwEsgwtp&_nc_oc=AdkVd0zD4WMloCM9Tsm4nKHDLIiCFF1eov7pvVAFoXeNi-F42TtDkosIODgMoz5EqdE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHTQ4LcfPAFuRwNNXAKcqH5P9g5KxOSDI8AqJyfksoGQ&oe=69B16F36"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kYWb1J2CIIQ7kNvwGLF4HW&_nc_oc=AdngectgOAKWVPIH5AY_e_sax-ifNnBXKduV7LyK-i_Y5kDFJpvA0kRzXZI4Pm_NPRI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxW5sYpnA8ZNaYhLZCETnEbfJcD-c0q-p6bZQLAWPaNfw&oe=69B146B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9m6icz0PnMQ7kNvwGQLYA_&_nc_oc=AdnBc4b32ZsC8tPoIDCpVdCkoHlIrqTkXn0kwT8ZkNvbLp6E1gQGa9QVqrIJTLeEnNI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afww4LRVRNTYAP_9HOGtQfoYfjieTsrPvrGbB_Xz-7TOVQ&oe=69B171C4"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=un9hxv8FTQAQ7kNvwEt7I1T&_nc_oc=AdmDI8jErUV2q1iJJXUcz98ozgxD-b6Gt8xk-JqUEYnZ2olqBT98Zxj7S7poQa_jTnM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculus
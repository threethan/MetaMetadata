3391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BX0oEXooEKIQ7kNvwGa6ovd&_nc_oc=AdkLh8wG4GiW66Njjkzf_Wkitd21IGaptUg0AYzfOxrXHPQ2uktEvtMvXehqqilMWGI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyH7QaAswsBgELOXVElLcC9bvkgBbr5i9Qc7LerZVE8xA&oe=69B566CB"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRZTj8iI4qIQ7kNvwHWUM9F&_nc_oc=Adm31ud0SGmfVEkRq8_5JDVYJIPDEtHrVxoQhUx5G4fzUVqk_2vzXdc_DFrei-IFzXU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx6_hp8pGIj_v2PXFcz6XzBHqNFgLEBBLVIwB0FZuRWLA&oe=69B563B6"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-NCrOqD034Q7kNvwGRrZP3&_nc_oc=AdkCgvErSujUrd1v8bKPjEwRpewQZJPY4UKSKZUeomrdhJQmBrLGGaoteIk1j4mx6FY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzcG09zh2q7Q4kBRmQuCkcgJqkoy1A1TFke784W2fnjcg&oe=69B53B34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4-FYilipgQQ7kNvwFUCVPh&_nc_oc=AdltpN302mDZb-z6Qz9o66_92fJv0U7GYWGWKfp3822ZaHDFOxrw1ST0bbyZbVhYJ0s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afws40qE9-eUkrdAPjC08tMW95a2VZr2kk_MYwPCtuCVSA&oe=69B56644"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxNJykXBLn0Q7kNvwHN3cVo&_nc_oc=AdkXiDT02Tzuk230iJo1WSgE1xu3ozpoVJhZKzKyEX7Mqe97jHsr6zFXcmKg6trpkgM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculus
3391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3Uept_xF9kQ7kNvwGmONko&_nc_oc=AdlWRts9CyuyobB7rEEhm5CXGzeKnZt-kGmqEY_VdpIExY_KUwIUXEmclhN1FUUyyog&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyqhf5VVW0rjijNKEB5fw8hoF12E2PMT-xokr-CEbm3Ag&oe=69BBFE4B"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSXmdWnB7DUQ7kNvwGWnm82&_nc_oc=AdkXYv2FCpIvCxgwiMLnO4O2ssR-gRrCGqja4RG6CW1CRvRwGwG36mJF7eHqGqb16AM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyo7KSSejmic6nSDH6eb7Q6amv8dHpMyIVKrwrgZNwavA&oe=69BBFB36"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZK1rvZv3NYQ7kNvwE6124q&_nc_oc=AdkN6Cwu_pxDGarmFjnU4gkVZNTN_EdBjXBiNYOKfqpSRuue0yTxoungHRmNiwwjMSg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwHp3u03FrYlnfHyCM1_6rbODo3Wi_NBYW53WM0Ob_PpQ&oe=69BC0AF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJs2tB5WqGQQ7kNvwHbszEq&_nc_oc=Adngz8DWngmXPfPpteUGv6Em7ZfGdCJIsv5_1LM5x-QOgNp0uJHY-d7ey52kmpOlVWQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZWWdYH9yBHqLxIthJfE3tlqpLed20YO4nesJ6sRrdeA&oe=69BBFDC4"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k58TolTJ_FQQ7kNvwGiwrIT&_nc_oc=AdnZNkpKrpT-IGlvj57B_Q0HiCqHnET3pO_TbdHRxmM_QxFL-8avYK01hu8ZIgMWdlU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculus
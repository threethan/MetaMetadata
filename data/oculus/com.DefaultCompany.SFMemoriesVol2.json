kxZ9vPTYpy-WIMnQIuFWEg&oe=6AD0D41A"}, {"file_name": "sozai3.png", "id": "561939999646359", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wa95svrNTZcQ7kNvwEV2zZD&_nc_oc=AdobfJScdz0z6XFX0LxA5nQx0bsNrWUX3uwQXBKBnlsFHhVkfLumrTyC-MEtPIumiHw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmymYHcT5kG6g4y0cDvtg9OFW5TWy-1AqSwlgvYBlSaA&oe=6AD0D94B"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkU5aDsut7AQ7kNvwGTRRi6&_nc_oc=AdrnkMB4VvGqiHCj_8kIE9I1bnnhdPYEOtNp-Ri667oONcEOSaiH5v8uul98ly7DVgQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3pf1vorM_Pk8ntc7xQllfYC0e_KWhQtHTD5SZMHoh6w&oe=6AD0D636"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tp5wjfJLT0EQ7kNvwE4tl9M&_nc_oc=AdrHFlVSkAkSBtWF6VzvVmMK2wpUxF1kshPtD_gt6SkvhYOxEkPDLD8oCMiET0WYJtQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-D-lg9JzzynSBqDTMru8ndsrqe8oxb2vWs2hJGc1YqA&oe=6AD0E5F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veslfjA659sQ7kNvwH_5mZH&_nc_oc=AdpobM0dwE-x3DoumsRVgHuqn5wvSTCTRpWDx4hAI7ZD4c3b5tky-eDgT57GxA5N4qk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZLRfRy-oG4TWZ1H7FxDDaZbML9ISvayU5Pjz6TgrI1A&oe=6AD0D8C4"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102
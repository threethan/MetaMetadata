U4am-9JDXHeZzPYlmL3K_w&oe=6ABE5F1A"}, {"file_name": "sozai3.png", "id": "561939999646359", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGVhaV5rubEQ7kNvwG_PYIN&_nc_oc=AdprLx_yLwf7bZ0g9nME_qiuGxXAPOXjl3T7hQC20159SOiGNt3zmcs4Hm4Y0IlmTZM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLX8Qx5LpAcY6vCZ-xNb64FuPmgK6TEhXwbpKR5qzTe0Q&oe=6ABE644B"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rG8lA3uTqwoQ7kNvwHuaugI&_nc_oc=AdpCXt9TFAUMg1pMAt4hzbIKvj7KnJUCgmNIIvkKiznMZiv3QyGruBzcqqV4KNOI2WI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUnWIObQcqipcU2YGEnElozRZSTMyIwlBsodYhd7Ny3w&oe=6ABE6136"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6wFpMewlhkQ7kNvwGiEiI1&_nc_oc=AdrkgSKwZzaBT9_AqHoHlyhlXtGjh0PfjwdRgK9D6P76ZaIFJY9IksrZpiMeD8LTOZ8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL289Q0tpTUVl8vGKAnP2MvLoyvv1ev1vd56fZRK9Idmg&oe=6ABE70F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AROzPW7aVZwQ7kNvwEITv8m&_nc_oc=AdoTpo-9N53BvzPUbrN8P-uRGC5Ob7YQyuvcVzGu4rLtaEpISnp125oOLNyQx60fvTM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbbDwOiN_jAcIh3HOhDWY5pQyhGNzrY11Bq9aBdTWXTQ&oe=6ABE63C4"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102
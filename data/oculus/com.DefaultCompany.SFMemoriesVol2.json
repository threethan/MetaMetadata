NE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392132_657252896794275_593620199703172609_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8bN6UhO2gcQ7kNvwGSl-Xb&_nc_oc=AdrGMPdlm3Xprj-vMi5HL9G_8iduSnLNGri6AapiZu52AM6CqkD4g3cTEN8JUJq4PeE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJxDhQY-ewk0iM6OUpTLSPsHmLynTM4s4QnyyrRceP7g&oe=6A8ED80A"}]}, "id": "1388779525697989", "locale": "en_US", "screenshots": [{"file_name": "sozai1.png", "id": "1140289997784072", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473392127_1140290001117405_8232041255001954208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DJaZQoKqgMQ7kNvwHnhYp7&_nc_oc=AdoXKkkXuxbrWvGkYWAEt0eagPJOBK6dSac-ji7oJ4VFYhqsMJwEAKybEI0HCbwxZRg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCoVMgFDlLcN8OZ45uWVKXweGatBSdrsDm8IHDhh654w&oe=6A8EF4DC"}, {"file_name": "sozai2.png", "id": "1186214362898109", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473393594_1186214366231442_4115948364086679190_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Cjv6p9bEmAQ7kNvwH3dro-&_nc_oc=AdpvYR-j970G81zbMmo7qvte_gDArrGIF1Zo14-azi7LHUy0EOfNRq8aVwS5xTC1Lkw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0ZXVadxqeyrSk26D5hqIVNUeA-ADJrhtXw9v5pl51sg&oe=6A8EE91A"}, {"file_name": "sozai3.png", "id": "561939999646359", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocLZXH-pjRIQ7kNvwF2nvq_&_nc_oc=Adq6t5ctdeVqDMsSjY8fujHvFc_hxlBg7sx0iIyMC4vKccTYWL9x4DLQzfaA-zh0Kxo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFt0pcF43PwbRC13lu3qW-4ACXzd7H239QghAZzadXr7Q&oe=6A8EEE4B"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKeTgqaQCQsQ7kNvwGpRYq-&_nc_oc=AdrxeZcExsfxeGTv2oPYI7pYkGiIaoqhCv00d1GbWg0t8u0yAMIiA7DMqNxwkb1vBg8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrPLb91d2K6_PSTn2aHgjJp4r9CxS0m-IFYl2c5_Jfgg&oe=6A8EEB36"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4B4kiTGEhCYQ7kNvwHDqsrq&_nc_oc=AdoWU15InlA54tojpy9He5U217nuHZm4dFuPw20Axtqpldh-Dw2N8IrSucpAZ-KOGow&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXAKbFHclUg5KJuWOGeQU6PW39L2gd3c-K-FQA7glLEw&oe=6A8EC2B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7PtyJo-SuAQ7kNvwFfjr9b&_nc_oc=AdoCiY2s_MHBssaWaD4ONVOOMukvxsjAvhHk4IJ_BZKXG-MA71JDJqnX7AkHMTmJwmE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPQTB-KpnMAkvhOhyNRW74ldXKvt4p4c25DqHAW6N8pQ&oe=6A8EEDC4"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2025/03/privacy-policyschoolfriendmemories.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2025/03/about-schoolfriendmemoriesvol2.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITT
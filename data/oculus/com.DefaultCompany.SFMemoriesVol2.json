bpV1khomQuGUFlesGsaWg&oe=6A45151A"}, {"file_name": "sozai3.png", "id": "561939999646359", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyShfF4bVskQ7kNvwHRlx5b&_nc_oc=Adq-dSx4M20uOomeVRSUhdjNVOw2Axn6sv9PACXveIVL_9CVWco_Kstv4WrxtdPLNVw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JgWhtonadbXBS4DQKWbqiP5omPvNfoGbYDjbm7AUlcA&oe=6A451A4B"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqUt1cvuov0Q7kNvwHGUwtE&_nc_oc=AdoyFvZ6CRrdp1CaydNUl33DX3Bg09N7zVY3Wc-YAArsstNGjL8lEsCHXdMoQoDLQ-s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jVEBDM1O8ler_NiteOnMtkyO1wi_9SmiCsh08tbxOUA&oe=6A451736"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_Lx7R0w8v8Q7kNvwHcHwbq&_nc_oc=AdpoFqbvhJetys1fSDoR6rnHZD9zVXYkopK4kvQN1iTe-4E4bu28schYa2kGPhRtfBc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LkCY_ybk18FhCQEFOFEK7oi4kJ8P_n4Reenq_gSB4BA&oe=6A4526F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0N_w22LawIQ7kNvwGT1AXv&_nc_oc=Adp5K89219dM-4VtcKxnoalw81RTAkncTBdNHxoVmd3iJOdG4Yj39DJzie12OHv5Mew&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bEKVwbpNy556yJDHfgs1JfW-i2gvAfjiVrjheEPpDSg&oe=6A4519C4"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102&
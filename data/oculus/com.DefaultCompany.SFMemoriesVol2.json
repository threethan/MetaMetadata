jHXuZn3f-jSqQdTGUrFfA&oe=6A4BAC9A"}, {"file_name": "sozai3.png", "id": "561939999646359", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oowBnMnhJ5EQ7kNvwHwGzJ2&_nc_oc=AdoskWTIQmS1uHJPCS4qPup5BZodsUC-XTjX2sNTfuYCGRd5diQ9--x9X8qKw0LOLuI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCM_EHGYCMJO4ILttN-R5AWFgQRaugbo0ZDozAjbnFYeQ&oe=6A4BB1CB"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rDqya-b6moQ7kNvwHK9gvO&_nc_oc=AdpJ4WK4JvKcRXuF824xSgspUCtt3V9t6csd77OJIy-M6irjcEhOzte4gC9xTo5JnE8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMznRHsKgdhaX-8Fx99QzL5TPKZ8_lT6lMaZAg3PavsQ&oe=6A4BAEB6"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PY6jx4xaZ5UQ7kNvwFce-a2&_nc_oc=AdpkVTn8zE4JAKbmkwGkMp6xxBoH19oVuJN3BJpSe6YtUw9U-wK5cU1Z-r6J3YtGgiM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0P-jU47hFG2Cz2l4p9fDcLH_wR30uWO8av247_BPlew&oe=6A4BBE74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCm45ju7oD4Q7kNvwGpivSa&_nc_oc=AdqmvWICHojoMghiZvDp4H2CAsUF_P5m33H3WvAZY4rhcjk_VgfmrGnNTzE0RwQUSBU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSswVdkNVj-1PdGZBYYtOAbXFhy4Ny1xRplpQ1MrKtFg&oe=6A4BB144"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102&
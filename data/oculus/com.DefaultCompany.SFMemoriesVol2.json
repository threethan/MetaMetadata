0uIMah3qNR_Kipn4oCo9A&oe=6A32A01A"}, {"file_name": "sozai3.png", "id": "561939999646359", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qb1a1feXK0wQ7kNvwHiGLb3&_nc_oc=AdorShn0Q-hyWMBlD0b1yYb544G3GukfXedsRyh5mMTiDcC0QWw2qaJzb3wdQ8KJ544&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93V_TxoGFkF7DKV9j414W8GlOdX4uRK4vlTmTKyNNUxg&oe=6A32A54B"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnUdoKQnCDEQ7kNvwEZbsCU&_nc_oc=AdqqSH2sDLVRLF1ZazVeVr9w_YzS1nWAfZfuAhfsBpkXD3FsErLRXb7UbGeiH0RRpk0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uEfuVszeJulX3hpOF-ZFf6KqidV73yxd6YP9u_zFWAg&oe=6A32A236"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYKXYyBTulcQ7kNvwHs20To&_nc_oc=AdqPlrC2Yi6DRgDnBv8xHdOsZ4WM-mE3hmDGzq8Z7cKbRY4JeaP_vvHaFu7t4W82iQ4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6rXvUKH8sOqV348MYsnGsxAkVq04nsuKK5ab1lWV-Jg&oe=6A32B1F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vg8vE_c724YQ7kNvwGLMe6j&_nc_oc=AdqTjE8PxDOpP_RZMZA4RY6g8M-IJ_chspq00JpjcBAnsrQ_GRSp6GoW-aB8rdU11vg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PwgICNjNPoA19CUqoOUhNG8uxBIPdphgVsQhRg_vn6g&oe=6A32A4C4"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102&
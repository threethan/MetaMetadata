en4BiUOG2HSkD4wvyF_lGg&oe=6ACB8E1A"}, {"file_name": "sozai3.png", "id": "561939999646359", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mko9BHQhPZMQ7kNvwGQt6r_&_nc_oc=AdrqKtuhVNyp5go_jyS6x62jfmVWf7mqYD5VnVqTk-oKNxszknaTTmijB5riqLpS3qg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPruIIjybqK2w3J1-V6nyyF2k-NSqL_g83HDYJZ94bQ3w&oe=6ACB934B"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjuE4cvLKyoQ7kNvwH8e123&_nc_oc=Ado1k45XwB50eDa4hARVk0xaKgymsNaEEDmnbTF2obAUmyBk0FoROsaPlegdi6nSkGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7qsAX7l35d4dgy1kyJCHFw7NntVYQe7mRp7SGnc014w&oe=6ACB9036"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVT5q9j7csMQ7kNvwGJNcqC&_nc_oc=AdprzRga7mwdoe6ttSKXRPQ0mjm-LmuTUWbkHZLd86ox0CynsW9qLu3cJdDZZOIWpq4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLChPHb5mzzgMdWTTub0jPVPRd6Rx6S6Bsw_GpUouhMQ&oe=6ACB9FF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cbPYb24PV8Q7kNvwE29xZ1&_nc_oc=Adp8QvvFiBiGJP_r46zGOvSgM1ZCcT6ZKqB1IZ4z301BxVWWq9oDIhauKafPQBBqQKg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4wvlFbqP13WN3VAxIXlouTQ3RvIvgleQf_8InbN6B6g&oe=6ACB92C4"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102
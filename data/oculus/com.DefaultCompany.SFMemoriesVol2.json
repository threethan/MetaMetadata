1b\u30a2\u30c9\u30d9\u30f3\u30c1\u30e3\u30fc\u30b2\u30fc\u30e0\u3067\u3059\u3002\n\n\u3042\u306a\u305f\u306f\u4e3b\u4eba\u516c\u3068\u306a\u308a\u3001  \n\u5b66\u6821\u306e\u4e2d\u306e\u69d8\u3005\u306a\u30b7\u30c1\u30e5\u30a8\u30fc\u30b7\u30e7\u30f3\u306e\u4e2d\u3067\u3001  \n\u30d2\u30ed\u30a4\u30f3\u3068\u306e\u65e5\u5e38\u7684\u306a\u4f1a\u8a71\u3001  \n\u6642\u306b\u30b3\u30df\u30ab\u30eb\u306a\u4f1a\u8a71\u3092\u901a\u3058\u3066  \n\u5f90\u3005\u306b\u4ef2\u3092\u6df1\u3081\u3066\u3044\u304f\u69d8\u5b50\u3092  \n\u8ffd\u4f53\u9a13\u3057\u3066\u3044\u304f\u3053\u3068\u304c\u51fa\u6765\u307e\u3059\u3002\n{2356403878065960}\n\n\u7f8e\u8853\u90e8\u5ba4\u3084\u5eca\u4e0b\u3001\u4fdd\u5065\u5ba4\u306a\u3069  \n\u5b66\u6821\u306e\u96f0\u56f2\u6c17\u3092\u3088\u308a\u611f\u3058\u3089\u308c\u308bVR\u7a7a\u9593\u306e\u4e2d\u3067\u3001  \n\u9752\u6625\u6642\u4ee3\u306b\u5473\u308f\u3063\u305f\u4f55\u6c17\u306a\u3044\u65e5\u5e38\u3001  \n\u3069\u3053\u306b\u3067\u3082\u3042\u308a\u305d\u3046\u3067\u3001  \n\u3060\u304b\u3089\u3053\u305d\u304b\u3051\u304c\u3048\u306e\u306a\u3044\u604b\u611b\u3092\u697d\u3057\u307f\u307e\u3057\u3087\u3046\u3002  \n\n{1198978045112343}\n{522753250600864}\n\n\n\u307e\u305f\u3001\u3053\u306e\u30b2\u30fc\u30e0\u3067\u306f  \n\u52c9\u5f37/\u30b9\u30dd\u30fc\u30c4/\u5a2f\u697d/\u97f3\u697d\u30fb\u82b8\u8853\u306e4\u30b8\u30e3\u30f3\u30eb\u3092\u4e2d\u5fc3\u3068\u3057\u305f  \n\u30af\u30a4\u30ba\u30b2\u30fc\u30e0\u306e\u30d1\u30fc\u30c8\u304c\u3042\u308a\u3001  \n\u305d\u3053\u3067\u9ad8\u3081\u305f\u81ea\u5206\u306e\u80fd\u529b\u3092\u5408\u308f\u305b\u3066\u3001  \n\u30a8\u30f3\u30c7\u30a3\u30f3\u30b0\u306b\u3061\u3087\u3063\u3068\u3057\u305f\u5909\u5316\u304c\u8a2a\u308c\u307e\u3059\u3002  \n{1862155974567007}\n\n\u6700\u5f8c\u306b  \n\u3053\u306e\u30bf\u30a4\u30c8\u30eb\u3067\u306f\u9032\u884c\u5ea6\u306b\u5fdc\u3058\u3066\u30aa\u30fc\u30c8\u30bb\u30fc\u30d6\u304c\u884c\u308f\u308c\u307e\u3059\u3002  \n\u307e\u305f\u3001\u30b2\u30fc\u30e0\u518
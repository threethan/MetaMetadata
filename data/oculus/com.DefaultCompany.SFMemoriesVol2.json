40387444506728", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1owAcUIuPIQ7kNvwHzmgSu&_nc_oc=Adnq384vqV7G0YfRcxHLpr2SHYFGKWH6gsYF5f-emEqjLeNFOl2mgsAv17nt4slmOrs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvYOWf19W0rlLj9M9sq4nOgovrIQmGWssKgdzjSnFBPGw&oe=69A2EEB6"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbWGJsolFvYQ7kNvwHoq1qu&_nc_oc=AdlXSc1R0eXh7P6CBoGx9tky2dbHwXfVVDt9hdJpursfQZ5UdKAsnh9LnMZ-b0YXFiE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuhV-Yo5yk5nbFFo7SwW0tYaC9YQPoaDFKMoTqK7EHhNg&oe=69A2C634"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntFRFdFVJDMQ7kNvwEFfi2g&_nc_oc=Adn7AcLq5RWeJtOY4KSpf3YBTw1jcEgBL6q8FkV41UesSVzcwwq8NaSd3nAEkWO3stw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu9ZZLIt0JJ1OJXMIO-3ohSCGJPREDg-lvgOnvkz0iwSw&oe=69A2F144"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18KgjqgfIHAQ7kNvwEECQYe&_nc_oc=AdnY0h-ZHONZNOT4Ej9uhRJl6KjwE2Q58Kc6JDz_BLIeDRvMpLYep2gmHUyX680_ako&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftVzJiS4uZ0AAUnAXjBSpKhJs4KSHvPivKEaC1VEYxnnw&oe=69A2CFB0"}, {"file_name": "sozai5.png", "id": "1862155974567007", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392127_1862155981233673_6629870527784498539_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAlcnhwpWNMQ7kNvwGtHYrF&_nc_oc=AdmamfMPKgO_hJTIi8cf
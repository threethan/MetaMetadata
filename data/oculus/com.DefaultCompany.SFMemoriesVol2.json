40387444506728", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXSRR_Lyzl4Q7kNvwHIGZ5W&_nc_oc=AdkxMI2mm49nSbZ_AkAf_GL7ekelWEYi_o4lOjSqAE7C3QlRSL9iZguK6ycmSWiOkSU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfstdZkNNDnwGxCqG9voFAFW1nyVYvFoKQxaLYvlfEBR5A&oe=69A6E336"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvWqCAaP4G4Q7kNvwHaZLMP&_nc_oc=AdmWJb_RDmnTggKeEMyWGXOzJYYZFnPCr3sHdRNDyOE3EM3dBFLES4jzWDcK_yhfA1E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuS3f8D8lb0TyS6mZ-memvbUN3XwFn_PGkkj_RimNSFhg&oe=69A6BAB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4dT6d2MPZQQ7kNvwFlPtA3&_nc_oc=AdkX51MrqEvBjFMfr5BbnRJXtfVIMHAExHDPzY1_vfP2YtS4UvI-QVpQ8uMxRaSqT14&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvVpwPcVMlXwih7k8wJSd9yugaBQ-HAdjiORg_-uOZMmg&oe=69A6E5C4"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOXofK0FV44Q7kNvwGHylQg&_nc_oc=AdmAjyZCbdWPODOJUltnNZOilZB-zMhgq-5wJvPY7GFVSzM98m_tqYYPtxCbMlxHwps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs_s_dubs_JjDQ_lCWbVtyL47Ge0LBogWoH_q26OEtKrQ&oe=69A6C430"}, {"file_name": "sozai5.png", "id": "1862155974567007", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392127_1862155981233673_6629870527784498539_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2rZIU_NIK4Q7kNvwGcl6sy&_nc_oc=AdkPbLlqlibFl1irpeMG
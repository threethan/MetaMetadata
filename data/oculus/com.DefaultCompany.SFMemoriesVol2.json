S1Him1qCdCeZ4v0ziYUwQ&oe=6A2AB71A"}, {"file_name": "sozai3.png", "id": "561939999646359", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7Xa9qRhLbcQ7kNvwHXhcpo&_nc_oc=AdrTwDW5IHjsINHR2qpGhleWRnNhEcaF6tpsMB_xxEioTLOUg5-LJACDBng240zH2ZA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yXAEOZcbOcQb_6MuiyiozXuoeh6hqFFyvxkHIcj_DtQ&oe=6A2ABC4B"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1fa2ovk9l8Q7kNvwGjgFcV&_nc_oc=AdruZJF9JXcBFJAvvuHdpVIeZeTAh5H0m-0YUxoOVugZ-9LrMU4Jgf497cp5RAf0rWs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XyjO9hfmksfE5C0_PfnHCArSRnWaIt7jFGFUI42oJuw&oe=6A2AB936"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvUOESh75_kQ7kNvwE2YQKh&_nc_oc=Ado-NC3TCKwWjUP1MCXiCwnVf8d9hOpBiimFf1GT__zFAF7330AyrS0SBgUfNks_dSI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8z5NKx86u4CMPUkQ-sFdQlIt-sXaIHCpGRB4mZ0j4htg&oe=6A2AC8F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaBK4KlFGywQ7kNvwE89EHH&_nc_oc=AdrpHKpb4hczsattNGzCpGZSRSLfVoE_KE1hNGpZ0E0jy9wP1yVfwtIcCw6Ezcn6NcA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8v-g8EaFHbqCKgjQvdvfFWfwzdzTaSZcVY0_i7JI90aQ&oe=6A2ABBC4"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102&
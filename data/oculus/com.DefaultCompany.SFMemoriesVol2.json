3391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BX0oEXooEKIQ7kNvwHXKK8h&_nc_oc=Adk-w2Ex3Wd_vPiWEjlaj0fveQhr--LFBcRrc7v4v9ROLwl5qRF0vsJEjGimcBURb3U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2HjQSRB3VylGcRQc8QTthEcm6T3bwl1r2kH7Ho9WTFw&oe=69B809CB"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NB8ZOH1D4VsQ7kNvwGdavbE&_nc_oc=AdmUrJLp_03fkPHNvaw023u0RGqyzOwq-_fFQVrC-IpBKmCB1PUGS1txePMEaKIskAQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwe2ZfzyNiUv4UOAGQOaqmdtYVVT6vwv-toLs9pPb99Dg&oe=69B806B6"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GL6J6n6S2wkQ7kNvwFUugaM&_nc_oc=AdmKqvV4CdUrVd2RsMHqjhHrl8KB9VUZtwo5XaDPhh73W65Ckz6zpIOOeZMp2s6Gtlo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx7KJrlbT7LIPH-n2bljK0ZIs-jodfNv1m6yLmsQ3aHGg&oe=69B7DE34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spBvC7om1c4Q7kNvwFU9zdH&_nc_oc=AdkXPUy2RZDz8ZB83V4-xXLjKMvotRoYBpDvPrQX6GB3-JjGIe4oJG3H4VkZkMxb_H4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxo7IqnuAKXRzC5g2fUZPZgs872IyahchZpj237AvjgMw&oe=69B80944"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZORyNdDfqikQ7kNvwEHVJ8Y&_nc_oc=Adlzom-z3Tq-hOdWjAWBRRVj9kM-8mEtPKNW4BXZStYqjZxnUxgHSXikEK3t34LHZHk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculus
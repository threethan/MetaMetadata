3391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_4tJCmjQ4MQ7kNvwGQETKx&_nc_oc=Adlx94P6wPoOCe648bNXJskNX6RGzOOwyl6qT5cXGzFYYYqN8Z5kDCQpA9qO7SHMTXM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDc4fk4q-SovBsJWY-DSKm7QETdMVCR80umlBF2llJyw&oe=69AECF4B"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFjtj4EyV2MQ7kNvwHkLn9s&_nc_oc=Adk1Ys3VNxwxE1ouJaraI3R1ge6nfYOe4fJkqtny6gj4R75E3Uu2-JfD9oBT5K6A9to&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzpzULpkh1Kwq5ke3QKqgub_rfeiYthV2ZHX-7rtOwAqg&oe=69AECC36"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kYWb1J2CIIQ7kNvwEp6U7M&_nc_oc=AdkXbntM4tJgfxOaE36WiMPDX4rUjon2a3vdviigp1hQsue5ckTH9vM_bu-SzJCCNFI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwy5emQwtE-n_X3bv5WJkXVCC3KgB5cuNDC9tT9ELbGhA&oe=69AEA3B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cT2YWNzX9oQ7kNvwGyzG5B&_nc_oc=AdkWTIWbhccZl-0WpGQxJZ5LNRmEtmKpL77lobE9l49_i22_fDxAmOoDSgumwdt05Gg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBvXBTGYRx7s8w40idgOk2_s9UgTAK2VPdh3W9yeFpvg&oe=69AECEC4"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=679W_nGyZRQQ7kNvwHvhYRv&_nc_oc=AdnTmpAluUSZ4DNDj6FO3O8fZg7AlrrNM9BDWNwvF-M3SEBZz6-Jaek-vlO3Kt_yHX0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculus
YlvBI8F5x1DUa1VOpLoIA&oe=6A79D11A"}, {"file_name": "sozai3.png", "id": "561939999646359", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zT-01SOKHBsQ7kNvwE4bsNs&_nc_oc=Ado3pnbE67KVLLhdMCFd1XOGxplx4D5Adh44NzwnF1oFTEsi0Qqv1HuSM9Vp5N7oabE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXSGFfMJa3dzNEjJZj7edo4L3QD8at-unU3vdKKVFU3Q&oe=6A79D64B"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJ5ZE9XxZrUQ7kNvwEQNEdh&_nc_oc=AdpyPEm3uF6HyhqB3EFumI1Qx81FXfjHcJ0FXaooGNt0eaiRc-NFDsLDn9H5i2xVRWU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2VIiUoLTOLjyV72mzmbW5r3kGsq6MZUPyTO7w7di5Lw&oe=6A79D336"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEO-qYgDEkUQ7kNvwFLkd1b&_nc_oc=AdrCoZ0AEahca-jRu_C8w8MzJigbpe-PebZ_fQIcm9HoX3-zxVOffsPIwxwwR533ZwM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiaoNOaXonOSV1_qfaqK9tboUM73GKDeIILDc2meg5hg&oe=6A79E2F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1o8f9BHRurQQ7kNvwFGLp3C&_nc_oc=Adp09xen9ulguX3Jfr-e8qKc-P9WD2eebp00EO9ncRzZIHGCgrDg1pcuABX03NbEihs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZS03Z-e7E5UtN3iHWQXuK4zlMqcrUEerBJfdQdlHU9w&oe=6A79D5C4"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102&
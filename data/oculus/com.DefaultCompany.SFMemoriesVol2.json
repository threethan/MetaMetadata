r4MurBilNNJjD-abUrvS3g&oe=6AF747DA"}, {"file_name": "sozai3.png", "id": "561939999646359", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yIjwzbqKLIQ7kNvwGBxv6J&_nc_oc=Adr3d3Ig_CRHOvBd28CRe-Lyy7mX3KBrLPKDx_4GzjOKOamdCtqZuqSNMxSulqOBkJM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsJ1_INFbjQKunhoijieGkJCJ1HU181_VTfJTWNMhDUQ&oe=6AF714CB"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2liwKnqUBNkQ7kNvwGpc_T2&_nc_oc=Ado8SeH7EPMc8eTds-j1gQPDYSSIwSoSH_W5cBEtBo5DACz9qY_0dwg9pHf8Z9hKe54&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQI_EGZHnd_eTlkxtusz3tIJn7i16tUW2sH90qQsHeyzQ&oe=6AF749F6"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=onHyk-anAXgQ7kNvwGsirvZ&_nc_oc=Adq3omL-q1FlIze-9td7fqa2-_YMvZmsqptetxw6NaQv-2H-2UYhFUtcB9MRmWM9SIY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu9_PSyX7MeHCiwFKP5ydD5OEoPQ8NAyz9vHsGt0n5lw&oe=6AF72174"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkDwqvzZi18Q7kNvwHK4ZgB&_nc_oc=AdqOdbeBz5nT--2uw2pAT6uJePQq60ccQw8yGW3DOk7VN3ujL0SYXgTATQfo-EzE560&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfsGUq_GYcw54DhZmoqV-2BFaD1vFE_h7Fp77tLcPYQQ&oe=6AF71444"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102
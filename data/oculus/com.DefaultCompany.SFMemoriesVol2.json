DyARMOdZ0RtyAEg5dtFT28A2RERSQFERxlTrwt5lqxDVEw7RM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TxDibxup9H9jQgZN4bfb7k9AM3ZkZmyDSlyRpvg4rPw&oe=69E77CB6"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEmP34jbwgkQ7kNvwEak8ey&_nc_oc=AdoVkkHuoyu25fzDKSJk9ac6XEQ650NpgIHlvPgHXgZOkDSO8mzusciFri_6WUwqfC8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17euw4OaNrOruU7E2t9_STZEYo1-JHfsn52lHA8OdVng&oe=69E78C74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPsjv9NbnvAQ7kNvwHKLjNz&_nc_oc=AdpVZQOc0e8cvbxJRVKGkYA5r53IktgCHrH8Zzo3dG1rSGcjAv1w39ujiCsHbJhPhJ4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GYY21z8dZElEHT9vImcuZIgItdWNLCiVqY0WNplJBGA&oe=69E77F44"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2025/03/privacy-policyschoolfriendmemories.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2025/03/about-schoolfriendmemoriesvol2.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_
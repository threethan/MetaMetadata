UcpsvAdMcgo4UeMJ-HGnQ&oe=6A1AE51A"}, {"file_name": "sozai3.png", "id": "561939999646359", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4Rd4BGbkJUQ7kNvwHfyjNY&_nc_oc=AdpAtY13gnLBmuEfPqxBpzssUYK_oJrIPYb0Y_E0Lro4B9jCVDwiUHeagEchh-qnnLY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IIpDEzaNI1MOtJxY-xwNc0qoa4qhGDQvMAqFY1rN1uA&oe=6A1AEA4B"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVvei1xFzKEQ7kNvwEBYV6S&_nc_oc=Adq1-04VSADi1X4IorA2t2JeectJfXjvYGCSB-t8pbd3p8KVl3g-d61myE2r2g9esPM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wsav8mTPLjpK1coFzLOFg9u66-dfbLvcOpRynOk7hew&oe=6A1AE736"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7i8tWw98SGYQ7kNvwEX3tN_&_nc_oc=AdrdQjS1SYxisHncY55zsNBH1dLxEDotP7ASJTOv_QJsy7dlH9sGE-PKEzXDA19SFsE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BCOaa_LD74KBSTgoErZ1zf3dnNAnhqkcM5LSDKkkD6A&oe=6A1AF6F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLmpFKkyKIwQ7kNvwFGa3hM&_nc_oc=Adq5KSQYRc2KnfK7IHV19qraJdzwTaMJ2MBJlyBMZ8t4N5jazWHBgnlKGQwH7bchTuc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jn21T9BjTfHZPg2PqYpiwXkuobFzieYP0WI-MBaQ0Sw&oe=6A1AE9C4"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102&
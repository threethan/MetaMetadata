40387444506728", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ib0nlTGetKIQ7kNvwGP0Oj-&_nc_oc=AdnR5oN-ZwPlXICZl_QTyPhlIEuqAI76GkBXXks3-xsGp37g7mQaY8bXCBC4NbpiAFI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs8aPVCELHu3heFrkY_nVgqg7AYZsfCGovfv88h_i7RlA&oe=699B05B6"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qwHlm-r3DYQ7kNvwFpwTyK&_nc_oc=AdlyotUlopHBgc8RTOIwV7i2Xrga1jtJBZNLjVoGRehMIxA2ykTbKSrYzAL8Lk0euiw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvey-EBbeiFxWr6vqeWdszU7Bp6uzJABH_RYQU2OXL6aA&oe=699B1574"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhce0iRu9WYQ7kNvwFFKiiq&_nc_oc=Adnyrr-fWpdXve6FuJ_EXMtWyRsPbPnvoQakC-SQG4H5WDXI0kLkc7RMNeGmr9rMhuo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuLm6TCoveW1fn4ESZCxaGPwS14B0I9p_IYnaHGOONolQ&oe=699B0844"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PO5wkFGgHCQQ7kNvwHZ3Uyz&_nc_oc=AdneDqbokd4fqo2ab8UV0As4wyq5CBtDRFTCaAhjwrEiip_eX0s85jo8t2tMdhEER6U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsNOO_4PnvnRhTQPqfqVNcvjG39m5ZVp_-uXd-HMZLtJw&oe=699AE6B0"}, {"file_name": "sozai5.png", "id": "1862155974567007", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392127_1862155981233673_6629870527784498539_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJuBAbu9ZOMQ7kNvwGb5XN9&_nc_oc=AdmhqQARnwXyFl92kjNL
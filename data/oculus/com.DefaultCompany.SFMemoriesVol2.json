0f&oh=00_Af81XpX0Orjhgg8bJIatffuPJXBHYstONIDyQK7ya2wh_w&oe=6A22CE1A"}, {"file_name": "sozai3.png", "id": "561939999646359", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rj1Zevp5BO0Q7kNvwFn5gTi&_nc_oc=AdqElclaOd_8AV69f5xG-kvHzhp0Bz7P2fnZ8uZpsPzHngt7ByTUqtAJxURCD9TjvGQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VSQybXItwpRJH1nUcepTmBmwc9jepNJCavw6wjEKnxw&oe=6A22D34B"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ym9cnUHR_nUQ7kNvwEV67eX&_nc_oc=Adrl2wtRtka5uNpfmK8Mj3uN7yEWyl6VFkW8DHzVQjjP730yuRFtrUB5N6ICw3125bo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ALCO5zz98ZjFkZcK_Jq6Z87fwOPm_ZhGK3MXQ6JnB-A&oe=6A22D036"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKsYjJkep0wQ7kNvwEvC-8T&_nc_oc=Adpq340k819Ctewtx7YMQkJoNl952s-PrTJBe-lNdrzR-yRRBdSWsRXqmlTQl24npIQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Lp2ILGXq2JR2Wg6amG5IpRnWFjOhAkndAc1XDRsrpBw&oe=6A22DFF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ap36VzzP9nIQ7kNvwEg9t0c&_nc_oc=AdoM80hbyw5ZrD1w5Qb2wvUuWQDGpu2f6836Ve3tjtKZHL6zYC1P1odssk3-wdRdf-U&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9laeVvnAtJVaZsFy3RbAXi16KHzK2MrZ3bIxUkatva8g&oe=6A22D2C4"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_
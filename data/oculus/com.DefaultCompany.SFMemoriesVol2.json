-a8bn9G5mw5EEP2PpqhIww&oe=6AAA989A"}, {"file_name": "sozai3.png", "id": "561939999646359", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3YV3uG4aOUQ7kNvwH5MmwZ&_nc_oc=AdoGgB2-rS6_mXnyD6g4c7Guh6sj1CNwv1nEwjSrpTcR4zUoZvdJxn2RnLiZbfXYpcs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3x3s5yB4rJNXe6_-Q2No632bHmVmgsBrwR4RasRuZ5g&oe=6AAA9DCB"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnpbCWAulXIQ7kNvwF6qTA1&_nc_oc=AdrU6pO5_28Senccw9WvvU2VB0wkBVtnUdALk7nGGwoUXYvfFDMvTG86Dch9-duCkjU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQbozNlmIdQGEwShcnFPmuIb_4qlhdHKbjlEy55A3AUQ&oe=6AAA9AB6"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7QQaKXu4fcQ7kNvwHI3DO9&_nc_oc=AdrkRDwv7XW7wU5O-VOUaGdLvGj7pq8hP446I8CgKGWX5XX7Ls2dFAMhpo6p47kNx8s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdOWCnz7D06iGAz8VyJae4zOt-lTc3rOBYUWecAhERtw&oe=6AAAAA74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJFq4oF9KsYQ7kNvwFvWjcW&_nc_oc=AdpdP24IlE1v_rHhEfNwgeZ8VkzJD85P3INSkEjGtvM2mGw9utZZCg7x1DNxpY-odXI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUPUhj8ziQdQwCoi_OSSnYjhLKwoLzasSC_oyzxLJLoA&oe=6AAA9D44"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102
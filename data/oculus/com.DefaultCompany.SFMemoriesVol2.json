3391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3Uept_xF9kQ7kNvwEI_ERG&_nc_oc=AdkWSX1d3j_2wbbbXWrpaFOHQuigVDqOPyEX9pRZy5__bm1p4NVpr3LEQAiwR06_qoU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzNEeeZaMirD5Tig1C7yLLeNh3eAc6InwJU_u3kmG2hyg&oe=69BAACCB"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSXmdWnB7DUQ7kNvwH5cN7x&_nc_oc=Adnaikt5kqLlK4PgnRsZhNALZI5DeZ2Gst_un1AG75O4nH-_dT6TB-s0fI0M87IPsjI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwhwpCFeUHYbHqz6t99XP_odVyvYaegkn6K9-fT_0Ngzg&oe=69BAA9B6"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZK1rvZv3NYQ7kNvwGrBH-d&_nc_oc=AdnBJ0swJOIeeG7JoCT8vJCVCdMrgnQtVmoFevzvL7mOwVQV0h27BdAabRYVguH-P9I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzpRTCx5ASiogSgLyA32H3DgLe9JMZpCI_6KSlyzDlaw&oe=69BA8134"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spBvC7om1c4Q7kNvwHhdsgc&_nc_oc=AdlRtN7CdwS3d4v7M5efhX_g75iw6Q2W2YjPCvI-sSW4qmj8_K-UJ3VCMM5genLsQ7M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzxCrPf63NIEpwExCH-1kBCqW66tgCx1j_bjDR-k6vTlA&oe=69BAAC44"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZORyNdDfqikQ7kNvwHaQo_o&_nc_oc=AdnepDekmh4fqKw_Vk_0JRrnhDt50ouwXxxgBVP5uhSfcA9pZU3hpcM8YdZyCUWhYkI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculus
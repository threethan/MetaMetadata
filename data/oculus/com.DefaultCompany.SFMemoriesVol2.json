JKupiFIuwkO-gbgY10vag&oe=69E2349A"}, {"file_name": "sozai3.png", "id": "561939999646359", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AvfBvePwkQQ7kNvwFK13cY&_nc_oc=AdphO1DcxHd3B0QW0vIG2IB3J7TGpnmLyLBVneK-3CtXFzQh1cLB0nzkA3DHCmuErs0&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PWv61C_RpJvf-CXcG-ZK4ILrEntw9Kgygycy2FofPIg&oe=69E239CB"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCIYSvnzOqwQ7kNvwH5gcMd&_nc_oc=AdoiKIlX1ild_xwe4HYByaB1WCBvBadXmzlBp6hcL90vZOf8-crrlY0u1zZIyKRkrDs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vNiyZ48_20bOkZpN3R_3ehn5WnzwygwGqWdaA12npYg&oe=69E236B6"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdW5pwH-Ug8Q7kNvwFkfDCT&_nc_oc=AdrZm5NzyuNhegFU63SN86p0nb9E9BIMPKB_tVyyaPRJhKKkrexQxnBGBhJfNe1DoSI&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2S4C3RzuuaID-FceFP-6HEDk7hHieqwb1YvA41NB02-g&oe=69E24674"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYiqVqlseiYQ7kNvwGO93U7&_nc_oc=AdrhLCdJmMNbfPxihV7VZuDJCTshzpp0v5mFAWFA5fWQBCP9KTX-nCTFYVopruxv5XI&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kOBt_DrLkaP0bk8X0xDuU3N43hvQoiEDI54jmIw2csw&oe=69E23944"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102&
3391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BX0oEXooEKIQ7kNvwHQ5oke&_nc_oc=AdnUMNBxnFmCPG7N7IfGWxyMnt-n7SG9xzZzC2cj7BpYEp2endR8qKOIX2fl7rHoco8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxucU2_-KZked9KGQMd3cdLFwAzcoKY-Hs1EEmFLnMs3Q&oe=69B6B84B"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NB8ZOH1D4VsQ7kNvwH8cjtY&_nc_oc=Adm7S_xCjEDNIxxNSpTccpnZHL4l9G04j68ESKNcqryBuNG6aG-kojn5ak6nbyHYAg4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxV-St5vPGmw1ptdyx9NaQG568sggY2YwTiONzmKFsOIg&oe=69B6B536"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GL6J6n6S2wkQ7kNvwFMU_6B&_nc_oc=Adlv4lf_Z4HnNhNhyh8Uq2fQwzdc4PuCRJT-5x_Zpi11jgUAWzOm0O9wI7Y-4-mZwYU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJj1hL64ZexXcn42gUj08pHW-YMAK7B3rkXTL7seGnJg&oe=69B68CB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4-FYilipgQQ7kNvwFVGN4n&_nc_oc=AdnYQ--keN_nu4drruKhpbDKWwz0zZN4HoL9OZWb15ZUdIjUAZYamaaro65oZTb7dzQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyajSWUg_P0aFOoaCDlRlrmADYXbVesR-mbdzkV3RYNTw&oe=69B6B7C4"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxNJykXBLn0Q7kNvwGzROKL&_nc_oc=Adnd1ZFot1vl88rPL4NUwQCx-nr2LQ9JD1Q5QIGVIliom_YAfTnt63R3DsF--VGUcdg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculus
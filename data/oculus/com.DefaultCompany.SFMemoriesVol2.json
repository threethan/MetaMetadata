QF6E9YSWWwyTAvFa7naM3Q&oe=6AEB321A"}, {"file_name": "sozai3.png", "id": "561939999646359", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_561940002979692_467633327288024777_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIhoSg4s-kMQ7kNvwF2_fz9&_nc_oc=AdqjuLiogcCdSGah9PnhChz5-_F7NvMyWqAKfiRvTCcWjrEih20T9bXPwDyv3gHoNKk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToJxoKSFNUrqQ4dxi54f5yN0OWYm7gBgntqdokMj5mEQ&oe=6AEB374B"}, {"file_name": "sozai4.png", "id": "1140387444506728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGWvHy8y31AQ7kNvwFbAPJJ&_nc_oc=Adqv74CW-yKcfgpUkcUcdKMRawnIW8j8og02EBpcNXtsED3W-JcdY89xtb3l0_Dlmf4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfu6PaoqIacAOGa4epJYBu66J6VVFRXcNn2y1qD3XDjA&oe=6AEB3436"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8NRoxBxV2MQ7kNvwEdm6lN&_nc_oc=AdrnBwWq4P5ROiAeQCdVm1zC89yBouQMnohhHtsK0qknCf6IAZncdRq0ZZc1pwMmlU8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWmfnMX42GZ5f2VzgJW5l4BbQN413z2SOGuHSGQjL5jw&oe=6AEB43F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSLyL6AmbkAQ7kNvwG2qtBS&_nc_oc=AdrYGMHFTRmY4Lgvy2Pi-lQhl-jEMbeF8KqRbfTmYqZtDEkn77RpIDX5EZMF9qSjJ0A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe6FIOT1anhge9n5IAbilx4cxyMJMMDqIhuwkL9IbRdQ&oe=6AEB36C4"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102
40387444506728", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391954_1140387447840061_6998846011535892130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1owAcUIuPIQ7kNvwGn-OaB&_nc_oc=AdnwxBrFzlJYGS2XlEt-JShRgfELjl0Ey43pn0bzeW7wE3uJ2ZGHgvt2H8_dvmzPyuA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsaPU_WyHFkARVZhQZnuMMDigHBJj8QYI7tk1ZPSpHzfA&oe=69A591B6"}, {"file_name": "sozai5.png", "id": "577722088642948", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392175_577722095309614_8524206018872391151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbWGJsolFvYQ7kNvwHj8-sd&_nc_oc=Adl3OOJVDsw4kPTfKoghdDH2HSl2LhOQn7rO1JRkZSfDmNnr-uL20vVzQnCnAnkncPU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsCNCaGIa9QxxCnZBjzIo88x45WR0lNJ8d7H2IiniV-cw&oe=69A56934"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samu.png", "id": "1051080220408406", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391872_1051080223741739_764702256454421387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4dT6d2MPZQQ7kNvwFtLYFG&_nc_oc=AdnqINZ_Vp3dCgHcxOmqIEjhGO4Z4cWj7yIfBq9Z47EnBEfQo3-p6D4bbt6SchhjWVI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afsl1eLCGUe6OJ0-USkse7VCVVp6CwwbzZIwTLlDpbFgrw&oe=69A59444"}, "display_name": "SchoolFriendMemories Vol2", "keywords": ["ADV", "Quiz", "story", "school", "lovestory"], "long_description": "A Once-in-a-Lifetime School Experience for You\n\n\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of deepening your bond with the heroine through various school scenarios\u2014engaging in casual daily chats, sometimes filled with humor.\n{1133967428503053}\n\n\nEnjoy an irreplaceable romance in a VR space that brings the school atmosphere to life, from the art club room to the hallways and the infirmary.   \nExperience those seemingly ordinary yet precious moments of youth once again.\n{668624309055360}\n{1695107394716292}\n\nAdditionally, this game features a quiz section based on four main categories: Academics, Sports, Entertainment, and Music & Arts. The abilities you enhance through these quizzes will bring slight variations to the ending.\n\n{1292510498519654}\n\nFinally\nThis title includes an auto-save system that records your progress automatically.  \n However, please note that there is no option to reset your data.\n\nJust like your real-life youth was a once-in-a-lifetime experience, the youth you live through in this game is also unique and fleeting.   \nCherish each moment and enjoy the present to the fullest.\n", "short_description": "\"SchoolFriendMemories Vol.2\" is a romance adventure game where you can experience the youthful days of high school, centering around everyday conversations with Akari Akesaka, a senior aiming for art school.\n\nAs the protagonist, you will relive the process of gradually deepening your bond with the heroine through daily interactions.\n\nEnjoy a moment of youth in a VR space that brings the school atmosphere to life."}, {"images": {"nodes": [{"file_name": "sozai1.png", "id": "2356403878065960", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392301_2356403881399293_5160666627903576270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOXofK0FV44Q7kNvwHEb73Q&_nc_oc=AdnUvFjQtERJ3yurUSnFO_H-73o7HO7pc7TNbxfKkRtjIXTk4Z6P3unMrJHc1af3kPU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftizrBi2SpeI2Lwx7lsHK-c4G1KBHGfeGQf1O_w4eLXiQ&oe=69A572B0"}, {"file_name": "sozai5.png", "id": "1862155974567007", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392127_1862155981233673_6629870527784498539_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2rZIU_NIK4Q7kNvwF528fI&_nc_oc=AdlaQoQe61KDVQDICOPC
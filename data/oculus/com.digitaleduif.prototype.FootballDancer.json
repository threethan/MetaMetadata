C3FC"}, {"file_name": "WhatsApp Image 2026-02-05 at 11.20.35 (3).png", "id": "1654332039269620", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821081_1654332042602953_6052622308991868589_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BlN_QjRDhoQ7kNvwHf8gzw&_nc_oc=AdpndjzwbTCzhg7bnRKylbyls3I8eHPxgcNcsJk9emyPQO92ioaTE0TotxMyGnGHByI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6WvwwmcyZRctcMqp1yiOA9t-xw9bq6fQI8lQ7PWGQ7w&oe=6AE89397"}, {"file_name": "WhatsApp Image 2026-02-05 at 11.20.35 (2).png", "id": "917294400698720", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823746_917294404032053_8645275828212020030_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wixlQ5hjcpwQ7kNvwGttbjP&_nc_oc=Adr-JxqvHd34o1J5-aUM-56Kt1Cy-EVUL7FgkL7oSpA_Nvr9LfscYGtIqYG45_RsM_w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKYJzg8wI9q9v3lodc1o5Zen2b1grzkdlk90J43rzXcw&oe=6AE8ABF0"}, {"file_name": "WhatsApp Image 2026-02-05 at 11.20.35 (6).png", "id": "1821798208526088", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822327_1821798211859421_7930804709875614136_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q67tFDRMIXIQ7kNvwE_kkA6&_nc_oc=AdpuxZljThtAGMDTnTkI7KI9NMOnlg6tYBV6EpdFHVusgRPozoJI5IbUq1mGLIStvgE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWymJSNIF4Dd2o-178lwvC_0Y4-_GtQcX0kkLsNAEkLw&oe=6AE89B64"}, {"file_name": "WhatsApp Image 2026-02-05 at 11.20.35 (5).png", "id": "1758127358904434", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821682_1758127362237767_897671427929779523_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RIIKUQhJEoQ7kNvwEqwAMz&_nc_oc=AdoJ0tulCXuOvUNXM68agr9kZ9ZBp67HmNX8fF2wU_9E2ZxK7ZQwXjN7fCQyAy7M4ts&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQD-h8T41X9FqP9ImZL6lSy_zsKdfwOmvKKkkw4UxN6xQ&oe=6AE8988D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FootballDancer", "keywords": ["football", "dance", "free", "funny"], "long_description": "Bring the party into your room with Football Dancer, a playful Mixed Reality experience for Meta Quest. Drop a virtual football avatar into your real space and become the choreographer\u2014tap simple controls to make your dancer move on command.\n\nFeeling classic? Hit Macarena and watch the avatar go full \u201chey!\u201d in your living room. Want something old-school? Trigger The Twist and keep the vibe rolling. Ready to flex? Slam Breakdance and let the avatar spin, pop, and show off some serious moves\u2014right on your floor.\n\nNo complicated setup, no online stuff\u2014just quick, joyful MR fun whenever you feel like it.\n\nDo you want a chill dance moment, a laugh with friends, or a mini performance in your own space? Start a routine, mix styles, and keep tapping until the dance floor (aka your room) is officially open.", "short_description": "Football Dancer is a simple mixed reality app for Meta Quest where you bring a virtual football avatar into your real space and trigger dance animations with easy on-screen controls. It\u2019s designed for quick, playful sessions\u2014no account, no internet connection, just instant dancing in MR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitale-duif.nl/privacy/", "developer_terms_of_service_url": null, "publisher_name": "DigitaleDuif", "support_website_url": null, "website_url": "https://digitale-duif.nl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS
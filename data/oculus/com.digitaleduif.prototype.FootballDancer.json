5B7C"}, {"file_name": "WhatsApp Image 2026-02-05 at 11.20.35 (3).png", "id": "1654332039269620", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821081_1654332042602953_6052622308991868589_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnfRLXMrsToQ7kNvwHIPkFC&_nc_oc=AdoVwin-gq_bQ3c02-0NCFT7hfiqDDopqJUX1m5a4NhKxLZ_4M7h0UfH6yuSHK1ZmLM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoPdQsF3_V-MzS1KYeRS-CzGWo0COvPfTQghBjdgA4Dg&oe=6AEF6357"}, {"file_name": "WhatsApp Image 2026-02-05 at 11.20.35 (2).png", "id": "917294400698720", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823746_917294404032053_8645275828212020030_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pj8jVShe7eoQ7kNvwH14FOc&_nc_oc=AdqRJALwI9DqkaNaHw7kI9J7bctdt47xGh1aLNsO4OFVDfu-E-IRWzKRoPwxcj2f0MY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFecRxVMEblUBBICtsxkpDPH-HC2DosI0vnl2AiVaKcw&oe=6AEF4370"}, {"file_name": "WhatsApp Image 2026-02-05 at 11.20.35 (6).png", "id": "1821798208526088", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822327_1821798211859421_7930804709875614136_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abeI-Bs3HJgQ7kNvwE-12uS&_nc_oc=Adps7dsnUFrTQt1PGwTrpghlz-G8DK8qn4CswALXoYX6jXsty6mxUDwLpNyvbaFfr_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6YnDEn_5A4kljJGrHut4dn-B9txjlntzwsE_C4BYTtw&oe=6AEF32E4"}, {"file_name": "WhatsApp Image 2026-02-05 at 11.20.35 (5).png", "id": "1758127358904434", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821682_1758127362237767_897671427929779523_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFGhH_VikoMQ7kNvwFKwz3V&_nc_oc=AdrKa0IokooUO3KMF1zpfHTQ9p5BitkR2FUzVIUX7E7qP3JFK29qDHdmVn66zFdW_EM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9jvLFKFwH0GcjYeGtPCr9Qqx_c_e5r00eoAx4780jaQ&oe=6AEF300D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FootballDancer", "keywords": ["football", "dance", "free", "funny"], "long_description": "Bring the party into your room with Football Dancer, a playful Mixed Reality experience for Meta Quest. Drop a virtual football avatar into your real space and become the choreographer\u2014tap simple controls to make your dancer move on command.\n\nFeeling classic? Hit Macarena and watch the avatar go full \u201chey!\u201d in your living room. Want something old-school? Trigger The Twist and keep the vibe rolling. Ready to flex? Slam Breakdance and let the avatar spin, pop, and show off some serious moves\u2014right on your floor.\n\nNo complicated setup, no online stuff\u2014just quick, joyful MR fun whenever you feel like it.\n\nDo you want a chill dance moment, a laugh with friends, or a mini performance in your own space? Start a routine, mix styles, and keep tapping until the dance floor (aka your room) is officially open.", "short_description": "Football Dancer is a simple mixed reality app for Meta Quest where you bring a virtual football avatar into your real space and trigger dance animations with easy on-screen controls. It\u2019s designed for quick, playful sessions\u2014no account, no internet connection, just instant dancing in MR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitale-duif.nl/privacy/", "developer_terms_of_service_url": null, "publisher_name": "DigitaleDuif", "support_website_url": null, "website_url": "https://digitale-duif.nl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS
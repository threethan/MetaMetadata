culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=9MaCZN0K7n0Q7kNvwHWuYZQ&_nc_oc=AdoR1mNC9HnGYS5OqzJdh2mf0iTcUfnGTVqDsaMLxDvpemdQBUFL95asf3pgJ49e0tw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zUAoK1VaZIe2WZyZiwGXxOBR0IiPgEsfIlltnwP18oQ&oe=6A09CF31"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2qwJlJnNlwQ7kNvwEazHA9&_nc_oc=AdpRv0JMCsfHdRa-_isI9vfXPtcomoztwis0_UVSoznXb4XdOczFPLU4RBTbgj66ZTc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TIM6oQqQRWjZJpKuDjARA6oSOcfewlaNnr58oXniPVg&oe=6A09D9F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrqG7JryAkoQ7kNvwHF5s98&_nc_oc=Adr94HQoj_WAM2-0uPq2_SoRIq4UNungKQ3VE9xf0DMs-Sa0zq0DpZW0zhEqg-1gYig&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Lq_B7Ou6PQ8DE_JRWmrBNoA-KEvxO1BUYuwgmjIzEgQ&oe=6A09C727"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=YdzDSewVed8Q7kNvwEoIBbH&_nc_oc=Adp9-o281hi7Zo5wA9vm9peZJWt_EmlBBYjfXw5j0-pbBFf5t3V2tw0WsDOfDEpkE-o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gZcWo1gJsWxgLfkayQJCrpvpnmeYWScCIrmjVJlN6Og&oe=6A3A96B1"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pjorDXbeJMQ7kNvwH9w3uV&_nc_oc=AdpbDbDjmMkJh6zYK0NSyQ_NAfaGjzYRKwhtzRvcAZB5NbYCLxl_oYIw6SxN9tADKpg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hAgsRpCHpUwVSWOg1g6_0EyBtK9PtJVk2vk_LOqmP2Q&oe=6A3AA172"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8ktqaEcoQgQ7kNvwHvQUPy&_nc_oc=AdpcH3Obhz23lyusDULVo3hIxiecGx2NnN6L_5iRlSgH2Ss3osXQKmVfudGFXFWzmVg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82gE2Z8-e4HEmpX_pzFlRdG4QuYQmEwh0z5z1DwLUxow&oe=6A3A8EA7"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
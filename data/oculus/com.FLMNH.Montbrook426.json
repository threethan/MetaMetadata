culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=ZpQQ7bJ_a80Q7kNvwELi4Ct&_nc_oc=AdqlRIAktaVkhy1v57TC5dJ2UaWyrEBROr2h7KCYTG_rH6JHFsPjlKmBRSiGRTLBvBc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zmRIQeilKrsovYOeDeeTkCdTK5lVuExtvXRR22eYZXQ&oe=6A3FDCB1"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJbaEmay01IQ7kNvwHm-ckN&_nc_oc=Adqy-Rz4pAjHp8lazlwBZxV9aWDtAa5Dz7le8yLbCagpPGCoje9uG-_g2frFOwNjJ_k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GGjpH81kP0Nt4rAsFtQiJE_yoA46CC_uKr5PNjnR0vg&oe=6A3FE772"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vb77MHqdBkkQ7kNvwErTzED&_nc_oc=AdqdSpPXdzv03pKwStSsmS--SHgo8i-CgHSe34KKb6ZQYpC6CobdQctNM5ZYXEobhIo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DZyC17yvJie-9N8hAx_CO3UEIWsL4XaPo7lDa4Bgc6g&oe=6A3FD4A7"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=G4zBqBHWOqEQ7kNvwEraoc1&_nc_oc=AdrsqJ1IRkIIcu5vbF3La3SzlrftfHuSjo_Bgy1FQMUofACanBe30dvogY7S9bPUT1Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kpH5NqFDUCkBLW-H0XF_b29uZwav3oNSAvO4il0VXvg&oe=6A26D031"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GiQynHQVMIQ7kNvwE6xC3t&_nc_oc=AdrDOUqcjoYWw30LBJo6-9eS7bAM3llNQC8sKyBDn7WWzzTK91nh7N5wnZdObeHnSgw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Y3L7SH77H_DnWVUoVy63aO1UAcbiyOmgVFDGbOQFSFg&oe=6A26DAF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5g4yEFUYu9wQ7kNvwFOROWU&_nc_oc=AdolQOfHzV2GI6-rTEtLy7jEYIOtHHugpp-wOkaJe8pOnBVMJdCQUDGrPH2vFftujXg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mkWGgLAPcPM2lnHUzTT--Pd2m3ELNK2RjNkAm1txskw&oe=6A26C827"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
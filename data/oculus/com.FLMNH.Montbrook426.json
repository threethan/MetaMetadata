culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=_2h77StJJNUQ7kNvwFuDsnH&_nc_oc=Adoku_GwnMTofZugn9u8MtxvK2qa-rQGKMVCBByB8m9ecE84uC9_pgcdgGQc3e7L6AI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoDK7VHX3-av6Q_LzVTcpLMj4UQGmI8QoBDINmpKaLCg&oe=6AF1D731"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImyXhlTvIfAQ7kNvwF9xCWy&_nc_oc=AdrEUpNnh4pY-ZPa5gILF2ccHxo9w9ZujDwRGm5l0b_Tcpj3aAjbBTpF7wGP1bpIlPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBwRk0sQI1rqS5yUjiVPUxxMSnWL26ASs8_gt6ldFNrA&oe=6AF1E1F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2i0vxG2_F2UQ7kNvwGuhYOZ&_nc_oc=AdrHn4rSW5jbN5CuW-bNVi6IMusiRw0PGkhsOyU1Cvw7NogB2PvCrLtNLDDvmTGv6_w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHgPvpNdTKsvFGAyaLDFhZI-aCJSNuecQknCory089gw&oe=6AF20767"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
J8d9XuYDpgye41Vg&oe=69A1A8B1"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8wRRkEmibIQ7kNvwH9Kbm4&_nc_oc=AdlAuCc9ix7IYGer4xpp3ZVjDwDCz0zBEjT0oqBDplohgoJnr0zlV7drq0JjL9QbL3k&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftgMS_LiuF7pSIDd0KskcixB_IeUVXH479tQQ856Vnuyg&oe=69A17B32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2pcrAZ1cfEQ7kNvwH-zN9n&_nc_oc=AdnIJP6BSkY0FOUVqbfpQXrqA9MRXNirOgd84kLjRgQVrmzQ2zeeHedhxPyPLA_eMMc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsfqLb_MwvajpE-dDLu8P84oGfh_u6SPDg4cvkuMBo0Fg&oe=69A1A0A7"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fossil dig site. Explore and learn about the dig site and collect alligator skulls ranging from 5 million years old to the present day."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.floridamuseum.ufl.edu/digital-lab/digital-data-policies/meta-vr-application-privacy-policy/", "developer_terms_of_service_url": null, "publishe
culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=3dYCQu8L3XgQ7kNvwHZR8Bb&_nc_oc=AdrS2YxuTmjOgATX3e8sgWJDxC1Mgm_qWqKGLOpwIYdCsOAt9__iH8rgpiM-ABGlVDk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5i_sbiaDoZNCwSTLm8_7JlwfSxsbQ3Z2k6_lKAob10jw&oe=6A0F1531"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqTRXZHvzyAQ7kNvwHdVLVE&_nc_oc=AdpYeypYMNGp3KuDz04n9sW8XnOkYChofmlrrH2Cs3Czszbku9gxtvWnvSiRGPYSgmE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FW8oZVQfJgHBV4mjt6EJ0bk6S0H0JYvVIFPfoEtrwnA&oe=6A0F1FF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dugznxwkzJ4Q7kNvwFn3E8A&_nc_oc=AdqQawVNB92MRFY2uS2vF3TPAGwx6ju-acYGF1gfK-tP-YiOVFXa5qdqcRiw2CAawg4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AKP0LZ7N8S9QLUyC98UZxyWqt_olmIFyvrq2jt1XVUw&oe=6A0F0D27"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fossil dig site. Explore and learn about the dig site and collect alligator skulls ranging from 5 million years old to the present day."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.floridamuseum.ufl.edu/digital-lab/digital-data-policies/meta-vr-application-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Florida Museum", "support_website_url": null, "website_url": "https://www.floridamuseum.ufl.edu/digital-lab/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "409554784609964"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1086088358697768"}]}, "baseline_offer": {"id": "1086088358697768"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1664553600, "status": "PUBLISHED", "id": "1086088358697768"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5634739066547673", "version": "9"}, "id": "403152154503019", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5192837127404538", "is_concept": false, "latest_released_binary": {"__typ
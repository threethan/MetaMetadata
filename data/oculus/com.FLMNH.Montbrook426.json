culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=B-_gZt3CgMYQ7kNvwG1r791&_nc_oc=AdrbKAdkUnhenxrjC3-msMNf3BODZTxN0yTS_GdvT_YTLBH6fDQIiFinpXkw6jPJAug&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuTTjT4WWuUzD86icxIOvcr5rbVeG7qcy3kS9D_w19xw&oe=6A92B2F1"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9si90yHWVyAQ7kNvwGE41w6&_nc_oc=AdpMZnmLx7A2rf8rnKjJnhHic2p6zlDcKtMGG9c_tJRJOc0IPUpGC-p11QU0l66wwGQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHna5uUXZt8jB8wRM3xyV7v7T8m5gHSLMWAp-0dPrcO2w&oe=6A92BDB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2-bMjiqg4kQ7kNvwG8PUhk&_nc_oc=Ado1PXcikEwwatwYUu56qUmqAOmJ1aYg2GWDr2C-Cq-hs-s9XWe2KVjV6YebooiKgKo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVGyZfPvcs8VZygxFyAQtDxCF14l7z39WLRWwrj9nKTA&oe=6A92E327"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
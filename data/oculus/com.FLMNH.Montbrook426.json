culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=AGsuZ7tGoPcQ7kNvwGzsBHa&_nc_oc=AdquFrzKJJ7uEEl3pWqLLP7h0GxCqua4EtTSEFHebQt2hKhBRSnsLFUMPUa38eiiFYM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0l6DaLux4LcHCRk_V7kSykCFBg13m4_8XqVgPUV9ccjg&oe=69E393B1"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdyV8eK37bAQ7kNvwHY71dO&_nc_oc=AdqSy7Swi-rtkia_Xj0uE0ARaAnxLjjEz66Qdh6J0orpY72p7KUFElQZhpsqPJeUaLs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3O2XQdgKgbzDdJ1ytpw1rKfjmqmkRLpUBwir6RNbfplw&oe=69E36632"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bJySHgBnbUQ7kNvwEVnyCP&_nc_oc=AdpMqU5aIBDn4UkPOX7bIRNMxDa25U2cVyqwz_w7N_WBWg2SraG9hg4W85WO2IH9--0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gGuJzJRh9A8ML-Lbzj_g4bBASfGQweNgvuDby1eD9Nw&oe=69E38BA7"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
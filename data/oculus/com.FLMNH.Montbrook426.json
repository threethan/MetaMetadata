culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=oH_rbOIkKmoQ7kNvwEdSU4p&_nc_oc=Adopxg5SKBISDEAbQ6bj-ukPQg-l0Ahs_wOOZH7gPv6ofujn01vQ_YvfosiTcVX10ek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIX08DSZvgn-57EU9F9brEfoqSt1p_VGVyJpq9TynV1w&oe=6AB7D531"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qw4FZDdKadkQ7kNvwEFcVxh&_nc_oc=Adr2qsNTVr97_fSm1GiaXXymdJhSAQh7f384_G4-e0Z8iM2U-wJNPchduuKPK7HYeG0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJopNnV5sB96p_YMBiZ62y2ZIJSwapL5oXOqYYAgQNaCw&oe=6AB7DFF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cz6csOcbj6kQ7kNvwHAMXAM&_nc_oc=Adrj2_PXrSkZoG7GoHT67Fe0WsUBFYh4MIr-IgEcNCrFzO5tkergmrTOCaaInPgYLYg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgKxoir1JRsbjOUDlmokGUiV5K8t7vmyGVPzaUlFoY2g&oe=6AB7CD27"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
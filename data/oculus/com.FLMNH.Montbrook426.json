culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=8FrewN6j8XUQ7kNvwGveWZ2&_nc_oc=AdoPI8MYMl4FYaxkINueWoNcoma9kyIBVPBmYhLN3MJO41scEB-ien4xxxmv45C4omc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZhKpKBMHJc5t_Xb6_zKwP7SmlTDtCOVJ-DO5-_A-MJQ&oe=69EE1FB1"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbw6Y-ZBk2sQ7kNvwELcNvc&_nc_oc=AdrEPOc9qm0IDjqmIp0i4NKhSDw4g8SDgx0SWf0vDpCayZlvHsX_ZnbpUP9fwwULBnY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2m5wZdGVGXsBB51eGmX6dbhAdR1fP9BwXJSj17iy6QJQ&oe=69EDF232"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SGWtBmlFLQQ7kNvwEeJYow&_nc_oc=Ado4Ygkf7qikQDf9BCixfUAofkG2Zx7OfgGHhjZsVaP2GQ_Jfo6LTESvhOInS1j5jmw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kHxPc5qIhXU3SBHyMUCezftFHu2bkCcf7Gp95TTNFNg&oe=69EE17A7"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
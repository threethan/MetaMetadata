culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=kkiVcntE-e4Q7kNvwFpuTNi&_nc_oc=AdpZIatg0yeZxSShz_UjrPlOhKlXxGkK6_2RSzLRFmfeWakRe8GW1TRuJuw__1-mOck&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_T8xCYPCwD6FLdZrfYxvLvTYMkAgfMJCVkFiL3gyv_dA&oe=6A2AC4B1"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7B9_EGb7QUQ7kNvwGjfvcv&_nc_oc=Adpcv-qwWynthqJw3pHd5nhMhhdCurLfWYaItv0p2ZLYXOw0-UQX7SsnARxVh-F9Yy4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Xyp5d-DLUI5FxY4rZxqp9CVTN5YfDIKLrg6W4P4G4ng&oe=6A2ACF72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUBK1aebS8AQ7kNvwFaFL2B&_nc_oc=AdpcrheLk7BQsJjWM9bluJ_OIKXTgPCE2-ZzgCKIKtmB6fqxj-cipk1M2MgcIXZIK3o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vjaMAA9XXXCY-ki_5pkpW_LC8dC20lJzGm6wAWPTa7A&oe=6A2ABCA7"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=3Rp13zBwSu8Q7kNvwELkE-o&_nc_oc=AdrgYUMegUZ9id60G3KeDAEMaK74HeP2OWnd0n05v1AOeG91IRKpgYqXRgTtHFxUvuo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWD_Q48bh5IJvyG467_AXB0AoggaxcZ33umP5TBRm9yg&oe=6AA6B1B1"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2yI9EB8wl0Q7kNvwEC56nJ&_nc_oc=AdrAvPQgHGGqQKNLsWTIYK9UzTW7FO1m9A9PqmlSUQZLAFrEmK_HKiA19PM1z8nhsg4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwH3tN-lq9yeG3Q_H0O_dtfRBY4WjVzKHJrgInA3wovw&oe=6AA6BC72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSCCmQQZ_M8Q7kNvwFx7AR_&_nc_oc=AdoqpebgiLk0OmvcaUlshN-ynbULjD8IPg4AYqobGaEtCEyLXO2my4X4bYZcNFnDwXs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbYZQXJLcy8fUh83nzwK9TOdoB2PuDMBk978Qz0pRf3Q&oe=6AA6A9A7"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
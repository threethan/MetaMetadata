culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=hahZYfoTlRsQ7kNvwG15qRe&_nc_oc=Adou4ja_Csb_9EF7et1u5puESOvr4_k0H8x1h9YMbj6CnKx3ujFP56UPeC0unPnszlE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_U2m83egjixrmWndLtM8_8E8QcaKmq65sm2pDP-8uXFw&oe=6A37F3B1"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pjorDXbeJMQ7kNvwF_-Nr1&_nc_oc=AdrZvdLqxtFA2tlF5yDEwsTvuM8vZo-JtTK2uspNGKnllGeiW5-qhiF6qXcUjqsS_58&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BslU6wtV92DguXCyqoIXmjQ9-uV-vXXsd9D0MiBP1GA&oe=6A37FE72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8ktqaEcoQgQ7kNvwG-iM8k&_nc_oc=AdrvxsAn1ScmYzIgTPsucvtcoxyxjN8ieFF6t6kZ0CnQrj9FZ3HQuuLdGbEjwV5Lqmc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87hBrkG7n1VQKIXRL8PZUbNKyeaYhF7SrKJIu6uk6b4g&oe=6A37EBA7"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
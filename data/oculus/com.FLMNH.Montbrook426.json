culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=3KDxuxZda6AQ7kNvwEvD8rx&_nc_oc=AdrO0mtBThqGZ9ti_k1FqZFvoa4M7w4KfMX7Fp1l3EmQcoBDHyt2r4Db8L5DMoRz8bk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGBIkkkz3LqPleD39xS_nEgCnWfFgsvMUJ0pIe4SbBEg&oe=6A4BBA31"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2a3wvkBxx8Q7kNvwG1Yook&_nc_oc=AdoBxpLTAZD4GrK6ca5SZsaup5C7sIqgls6blo8T_riG63t-eHW4KdD3aNUYaiU-DQk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGeF-sVyQKe6Erd8bHaCNfbt4Uf_GWlXE7ImqpgBAaLA&oe=6A4BC4F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFhWKSvJAZkQ7kNvwEncjgv&_nc_oc=AdpO3KaqMorz1tSzLrZIVKOsNxw_viswS9revsKJHPQxJFlMHgKwEsrRjoyN5JlmaQ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9eleDziU90WUsZlOokPchdvrWlFbNgpZ702UsifFLCA&oe=6A4BB227"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
hds_9y7M6lk7_hMw&oe=6999BFB1"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHGFTa4QOPIQ7kNvwGFUsiP&_nc_oc=Adk7O3eGS1zBv474HQmu954awh_IU3NT1pF4-5IOpGL0ck-DjSgtVxWBXcVDW2JNqXA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv-HPTCxmjwcu7tzAnvvWQKk3mClLrZQidJekqxt8LNyQ&oe=69999232"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ea8uUHUXlSoQ7kNvwGtATTx&_nc_oc=AdlR3vRXGswCCstX-HZYw7Jut4pnGO9TD-ccEMI90a29XA5iQ2k4DJbzNkt-SkD35Xk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftQB4B4YNPoK5NZOxyZl6KHEy_FGm7MDGCR1S4Htt3Z5Q&oe=6999B7A7"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fossil dig site. Explore and learn about the dig site and collect alligator skulls ranging from 5 million years old to the present day."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.floridamuseum.ufl.edu/digital-lab/digital-data-policies/meta-vr-application-privacy-policy/", "developer_terms_of_service_url": null, "publishe
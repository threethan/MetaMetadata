culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=eEvSMOVcs7oQ7kNvwHJEVgi&_nc_oc=Ado3blaRv1r2pYSKGLbV61mP3gHcjpSuE6IHoKLV1pRElDtWDJ4B_GnExU7BPQIx56A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lUEL7zT3gCNQEKC-wZ02208aySaWqZagoDX_wIBAz9A&oe=69E8D9B1"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I81evS0q4NcQ7kNvwEP6_qt&_nc_oc=AdrcgQ4R4kmPkQBvFgiphaZFleb12vvkhDc5v78l4LfjHL43aJL4ub6NAVTHWhjqQMI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DS9umUJNFMcH_nnFXhwJ2A47APmaqUcZ8ZC7YjY4JHQ&oe=69E8AC32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njKen2j2v68Q7kNvwEl0rdK&_nc_oc=Adr4-5rN3qHSsF5y057-k301tHrFdgF116l-xbBo8qzCgMo6LQRlnmoJsQ5pV-hz-M8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28CF8uRgRO0q4GqTFtKareKWVDy-GZZKzXdliiBe8xEQ&oe=69E8D1A7"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
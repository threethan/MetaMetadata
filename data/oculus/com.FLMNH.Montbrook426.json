culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=a7lbA_OVsuEQ7kNvwEIjZ8v&_nc_oc=AdpnX0wizMTkTN3Y8RhrSatYL52Ggg2h_-L3EbjrJqhotPBcdkplY_d-YOPyY8NkwRY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCO6irlS2voLlU36gJWVx_SHrKJXvyyDFHWmbLaaw9XRw&oe=6A6A0CB1"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfF26uU9fpgQ7kNvwGLPnPg&_nc_oc=Adrss4iSc6-FBFEy_yt0r-SuVpBFJRQ3OyiXQiIE8enmQ2N-5vf0GcuZWoWy_7Y77r4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhKKvrTa91BI9pr3RfjPjIJxWR8DfEc89wyo7M-sbo1g&oe=6A69DF32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=us9jCfryXxMQ7kNvwEz-kh8&_nc_oc=Adq-uecTSn1dkgkWzCr4Xm8DY36WgxlLwVoTtOggsU4QfqJBUT9F4mBJkXSrLu6U5XI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWQG1igmiNmdYrnecDPkpifjGtnqtjHV1UaG3Ao8s_mw&oe=6A6A04A7"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
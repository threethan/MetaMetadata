culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=2RjMbx-mNEIQ7kNvwHUyZwK&_nc_oc=AdrX_fARafbEgon4m5_HZmGA_FhlG_Vjdh25xyPNIDJZAyDhebg9A-ZrZ2dgUPdVtdQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzA3fzzCL28jQBY6X81hjnotEdp5-zF4W0eTFr6UcRAUg&oe=69C54131"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pppyRONCMhcQ7kNvwFEqrff&_nc_oc=Adp_8mlEZ0taab-WEo5XQjDD5dPss7gFsU_2DemqMb5sqDYXiW551Fv10CvwaortE7I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxRsziOHrura2L8QJfUjw3UIosf06A2TotBWxek5ZgvnQ&oe=69C513B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6j2e1G-kogIQ7kNvwH2JOvp&_nc_oc=AdoueMznsKo2Criy9KrRLGcnTu0YqaJqpGfScJMFBeieXReL89Y5N2SHTMKQycVqQR4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWV2E0cW6HpkWEDFRg-xztOOocfkY3KGFswHZl2uJVoQ&oe=69C53927"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
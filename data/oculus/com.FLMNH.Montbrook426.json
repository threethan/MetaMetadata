culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=qSRfvzDx7agQ7kNvwFVnzCh&_nc_oc=Adq75FxfN_3B0eKz0NtIswnu72TRh3pbyJNhf1C76qPgh3_-8rKtdH-i4pa9JyUuizA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPZa-iSQyvV99kzriAMnWKDYxAB8goZQGVdxUJ02OJFQ&oe=6A9EC8B1"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKPNX4Il6TgQ7kNvwHCW5ml&_nc_oc=AdpDw3eYa9-eRmVIChcYNF4199tXyJ2tJ6QEi2RQ8H5WXES-x7hzrb4obyo6AATQB0s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBT_QqVXIjbp8WDGUw5bSJxuheKWqXOgVijZwFbWl27g&oe=6A9ED372"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mK4ayC1PELAQ7kNvwEewvNl&_nc_oc=Adpif0ZwrTfAVUII9qk9COUto91AXbNI3Ky6B_JSfogSN5OLUHb_GJ-CI1mTD6LCRFo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsxuGakbmGMMOQOUT1Gllqw19XX887Fd2ck11Tk3WIXA&oe=6A9EC0A7"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
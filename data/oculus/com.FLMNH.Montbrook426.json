culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=OKU8TS2rcK4Q7kNvwGtzj9U&_nc_oc=AdprOIBjiprE7IQEKrk9CZUzs9Lo29fXVe1m6U_VUEFsQJggDes5whCnj609B9FYJqU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jOvxxC_onix3AkH1jT7KcBcAoLxf8wVf1u-ucQdJXww&oe=6A1EE731"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7h7epL-uhEQ7kNvwG_nNkP&_nc_oc=Adr27xx9CUkzom7yBWn-OcBxUv4YTs_9Jf1wUSbYhTCnUraRQeV-ScmIz3DRRfGUT3M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IQno_KnyGQ9zu7FzQsx_3I13BPgqlfX1Uk9yEHkrSUA&oe=6A1EF1F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRSNyZc48ykQ7kNvwFrp6bK&_nc_oc=Adqbs6MsAUa1WLtU6e8suV3ZZo7SEgpNazSWeH-j0BZQj-DEZ2vWjBXRo1gDbNIOuXY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zVjj0vgL5tCydJeQ34dShbSw5fA9wWnarsV0p4l5Jzg&oe=6A1EDF27"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=JQg3BEDc2g4Q7kNvwHUq2m_&_nc_oc=Adp20v1-azewZcf0NjcLOPlkrB1Gz0XujJgM--1IrSXtSS18eoI_-j-LMG3CbzLxfbo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHOnwnw2YIIi2k52I3bwyL2PlBlc-DvLzdDc44rY2u3A&oe=6ACCED31"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sb0qt08IL4YQ7kNvwFrU9EB&_nc_oc=Adqi-aHAjG60iZcaJG3a1jNdLW9lyF1VshA3L-KuCcmGTgsBk1Uw2NBKJBonbrzb4Rw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgmiF037vvO3RPpq4ZHqdj8AV_ZuoNiLADTwMVdououQ&oe=6ACCF7F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AK4RKtgP-oQ7kNvwHuRyFR&_nc_oc=Ado1wpfvU68Wx9xsQtLGa4uWPfIppXyx4ikrPPuLSlLbeBnyOkb-CqnH348IJJYCFyE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPn5Pb_H_otTQ9X02qe2D6OwPcMxfu4eSYIDUn7pooKAg&oe=6ACCE527"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
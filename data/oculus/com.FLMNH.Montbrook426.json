culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=V_uA12EazvoQ7kNvwGEVLzE&_nc_oc=AdrK0RZr5d90bnHaXxEt7KbWKTDcQO_hblA5tiPkFvbmHVVLh7Ta7rxXpAl3_hL-qpw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7Si8GuLMzh0G4dNS37Nj2BRPmypVL0IVEUDtZt4Uvlg&oe=6AA2BD31"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzNXY4-gMVQQ7kNvwEP_jrz&_nc_oc=Adq26CY8dHK_gSSUR-gpIT6b_kKewdZfp3phh7kucOfNGN8TEjAc4bQeoEQMRz57Q5Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKu0UDj-rsIwx_qSZFxo5WARvNer2Qk-Gp2VGENy4_z_Q&oe=6AA2C7F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAi1Y5jbY-EQ7kNvwEgcyLr&_nc_oc=Ado4AxPn-RJ5ZF8IWWN4N1IJ0rCrMuX2qLPmYlWI-p88zazbpdd3F1AIYxbxOA_K778&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLk9y9fRSGseDtH0525e_jF6L7C-Dg2UPUe6D1ACCNa_A&oe=6AA2B527"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
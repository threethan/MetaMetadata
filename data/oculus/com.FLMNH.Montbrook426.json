culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=DAwynybQnUoQ7kNvwGxKW4B&_nc_oc=Adr0cn17j2phAW9eJLgfhNI2HpVRtxJiBSzuJMUYoCsQYsPy7nLdlstIWHwLLtw5JBY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAYE8TLstyiM8I9Ut5TtG42q-avq8_oWGb9frbSbAO3Q&oe=6AEB3FB1"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=giHL706lI6IQ7kNvwFVeRRz&_nc_oc=AdrDgmkuouuT-EEcesM5U05GOYoqkRG54F6tk2Iebk0wdJWMQAeyf7uOdGQvKSFfJ7E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyyabHPhpkFPHYDlVQBAiS5gun8ppOJiS1BHW2YBepaQ&oe=6AEB4A72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsGvmn-owA8Q7kNvwELGUr9&_nc_oc=Ado8qS00c26UxWbUN7nNS7gWldVf8dvJMSl9Yc2QRj2Qmjo_Hz0j9gAJhCDDN9I_mY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2Uy-ao4rDfNoBc8oiidFKvVxkSt7tuaOEtv5Myl8caw&oe=6AEB37A7"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
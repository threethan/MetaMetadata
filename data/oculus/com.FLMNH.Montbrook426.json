[], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fossil dig site. Explore and learn about the dig site and collect alligator skulls ranging from 5 million years old to the present day."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.floridamuseum.ufl.edu/digital-lab/digital-data-policies/meta-vr-application-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Florida Museum", "support_website_url": null, "website_url": "https://www.floridamuseum.ufl.edu/digital-lab/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "409554784609964"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5
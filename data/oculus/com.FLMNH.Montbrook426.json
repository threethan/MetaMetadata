culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=3Rp13zBwSu8Q7kNvwEQkBKM&_nc_oc=AdoiGqS_chau48mN4Md7_M_tMInchehEDB5GOjc8G6ErYDizP_J97-AlT447cIWzXiQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJp9E74m3otFoUNZfk6775AqYJ1miqweJ4cisZPAYYbyw&oe=6AA80331"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2yI9EB8wl0Q7kNvwH_Vwxo&_nc_oc=AdqyQKYX2DKnY7LLR_09knTYppub9eIuZ3vYF16X-PAECdFCHAwG207Vp8Bdtm2Dzjg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAFPjOn3Zb7anxbPXaVGlfZ9kW1J-in8G6E4JF2ydB8A&oe=6AA80DF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSCCmQQZ_M8Q7kNvwGXqUhK&_nc_oc=AdpxDgC2upY4uokhuJ7Dv3C2X4HX5xMRePc_W9OQ1dkdPtvLx8yEB2X0TzFSTT9bEag&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuOzC6wihv6o9DIGoa3lmA1i5GznPVedg5hK2tSjFNsQ&oe=6AA7FB27"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=D5RqdkiTn20Q7kNvwHMZgpE&_nc_oc=AdoAPL2NV2fLXLLrL7JzeGMQfv506aCe6140xVe66IErhWrCPmsCYUD-0gFPCHj1TYQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUPnQcWVAolFoiLfufwSisXs5JzCpBvVfPf8OBTefqOg&oe=6A5E2F31"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqhxWJgB9wwQ7kNvwF05yWw&_nc_oc=Adp4s8xuYkEjXD8vBfYwA1SyvTa6328bR_GDm_a8IoCvl2ltvhbyGaxr2PPsd48khBo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCppID-uym30sWZfSwWeUVGWYd1CCdK52YlT6ZQMwJpiQ&oe=6A5E39F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYGxXzBkNVAQ7kNvwHQMVQx&_nc_oc=AdomB4Ka-01u73angO-UmOWS68GeuubkslNlW54bGxhL0L7XllIc9EHBYC_NQb0R_y4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8-id7bln2HeGgacvcCo5ul8mUlA9nFPOoLAfzBd9hSg&oe=6A5E2727"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
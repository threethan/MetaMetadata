culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=AGsuZ7tGoPcQ7kNvwH6u_j7&_nc_oc=AdrqbsFNN3zyQ4v7eZ3E87aHMyWlbzKMOuBKxOlPEo78vhTsZ53CG-aRExFmZ0HjYYU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1p870Q_1DZkx3MjCsEo7_quR0NL96eGEqmOuHX-IQXGg&oe=69E636B1"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5U-Njrld-IQ7kNvwFW_vgQ&_nc_oc=Adoz2Dr3FvOBjR0BQlwtk_v_qXge8NhPC9J4MZmEJJFoF2whSamj9eTcyqkEy3oC6B8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Y1op0xFgIR4NMlio19oZOfALRp8UmOpYbw5sju6OR8w&oe=69E64172"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHOBfBBjyJgQ7kNvwF4c7bS&_nc_oc=Ado5YX4sQBhHppGonL49lHDlykALaZmUTNwG0GtsgQb0tkQMKcspoJGgtIPRmmUXtmk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2waWgcZ1XGJbNrBEJMcY2B0xDaIccfcZKGFWnW0Uu89g&oe=69E62EA7"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
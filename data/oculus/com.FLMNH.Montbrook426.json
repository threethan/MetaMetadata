culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=DEItCN7owMAQ7kNvwFOypr7&_nc_oc=AdoLwgSBpyTihIEy-3SLQJ9iUT5OCyOyVtzb0m8Rrk3q8T3sZNMspL6lm7E_us3Dzdk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgapa00I0oUbr58uQqiFo1mdAx_ijxTg3iyJntSVFD4g&oe=6AF47A31"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImyXhlTvIfAQ7kNvwGB6dng&_nc_oc=AdqQvz0hT4LyvsD-xtW7BRbrtvaT7ANjPxQCaSFxTDgiMunrQztpJ8gKeb9EgU65wZ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR92rARQC4ChcBWefafyx5EbjvVhNNFVMuvET4UTpw_BQ&oe=6AF484F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2i0vxG2_F2UQ7kNvwEjXclE&_nc_oc=AdogEmpn-Ovw-uR6IExLnKMjRWQdYPcs1Un5OCtIBQ3cxnqul5dZpyXZlXcZ5RTQ4TA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBdNVEtjePCRwFEpjKXactDi0ppp2EpCVDkd2mcPDYZA&oe=6AF47227"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
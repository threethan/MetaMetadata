culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=T5EsBcu_7vcQ7kNvwG5R2Xs&_nc_oc=AdqMNf0TyFXaLRW78I1dbZuieMVcP2sxm01DbbG-TqVUd6paJtcPXdP1RsDbApkzqQw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLE1BSdozcQ4R6Px4N4Luqb2-0ejGGDMkcYOMEfgIBh9g&oe=6AAD4931"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EjNU74zpWwQ7kNvwFzg_1B&_nc_oc=AdpMEMRpStpjEhjdfZ0j5oYBiUZgkmP5ka2u0hIBALDIIgTVJ95jN6kIS1WPCADLvxg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLu6RQIYJuSaCZhvScljw8CP7KojV_0MpzBUYOjO6CN-w&oe=6AAD53F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-E9nyGLhhDcQ7kNvwFhKm8b&_nc_oc=Adpa_OMaDCsWSq0NLeN5Jj-38BGfOHF_A-7Zs8qXdWoVETHP2av6aAc-XvsmfOea_Yk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaf5gwFBuCUcD7z9qPZ0YCEUEL0RjEj2B1-c4lxUkvzw&oe=6AAD4127"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=UQNE9ZNyzUIQ7kNvwFCXOAB&_nc_oc=AdpInL-Rqk7MKjS6p2uWuFIDYT6N4v7vKU8VwjT_u8lIgrgLZlQ0klOawlm8qOn6nGs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PzBr3dAMVYffG0VSXxpdYrcF5tNtUIOzjkR2Tfhys4A&oe=69FF4331"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fq3eE8TaOdYQ7kNvwFuNwHr&_nc_oc=AdofBDv4ERMyiyIlI4SBAFG_Z05vfIjiOj9ORzk3r6p_ZpuRVH1DTCQ60Q0WqRiYkSg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DjHogq3L1wWUpCAA6Q_poJC-BglxujeBTCo0rc_XDzQ&oe=69FF4DF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VEz2Jga1I8Q7kNvwFOysR4&_nc_oc=AdrOmmuKkFBSdIwlIFwgyoTrfIaCWqMrxh2TGdAqojb312DXjV5CcgNb8-6_PAWZUbI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JpWbn0cIxLeXt0_1ejeiw2KqP_YK6TM9-0fLrOzTOdQ&oe=69FF3B27"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
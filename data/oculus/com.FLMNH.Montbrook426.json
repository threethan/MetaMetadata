culuscdn.com/v/t64.5771-25/38974726_688940699000308_7816431745121105130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=CdNLNB7AmFcQ7kNvwEMhVzd&_nc_oc=AdrN6dod4KiiZ36KVNARCUMYcxOtFjx07JPnG0fsA5YeSqN0k57jKhvlSP-zcZ48gG8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrgOV8zZsVMZOrFnQA2FNfj8zVKZgfICoxJUf6BBNaGQ&oe=6A4E5D31"}, {"file_name": "Completed.png", "id": "517144899962064", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974562_517144906628730_4758469682023572006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2a3wvkBxx8Q7kNvwGpOYm_&_nc_oc=AdoUDXJKBkXzZ_WJ5RhRw6H5rff1QTz0BqnRvJV_7BTL2_l2rkZzYLrRmz0ZoOIXkrI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0HQYzjlSnVI-zH8pKXOeycf0zqHawK3wX1jR7sEz1wA&oe=6A4E67F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverWithUE4.png", "id": "411156063969869", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974762_411156067303202_7052553982695646967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFhWKSvJAZkQ7kNvwGZkhFN&_nc_oc=AdqCmOeas6rxzbXmdrx-pZ_dSf2aLWoIbytSmUY7M0ZpMRRQPpj591C_Tx9xCwhvB2k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSrjBX8t09fo1lv4J7x5X5rnYPAvt1OqTDmx6qhu9wUQ&oe=6A4E5527"}, "display_name": "Florida Museum Alligator Collection", "keywords": [], "long_description": "This app, developed through the Florida Museum Department of Natural History, Vertebrate Paleontology Collection, and Digital Imaging Division, seeks to bring users to some of the spaces and dig sites associated with Vertebrate Paleontology research. Collect fossil alligators from the Montbrook dig site - alongside a modern alligator from the Herpetology range and a fossil of a different species - to help the researchers describe a unique species of prehistoric alligator.", "short_description": "Jump into a digital specimen collection space that includes looks into the Florida Museum's collections and the Montbrook fo
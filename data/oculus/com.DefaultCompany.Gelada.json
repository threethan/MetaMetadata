tQQ7kNvwHXdvMs&_nc_oc=AdqNwgZbL1SAtQWikYoc1mJK5hHHmZumCiAv-wGpTOBw8bDLNv44YNUo23YUFEddoaI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5KFlAQRSIsQXwOm-SF81sI06hEKHU9ovlJr25wO9EAQ&oe=6AFB3802"}, "display_name": "Gelada", "keywords": [], "long_description": "Welcome to GELADA!\nA Game containing an absolute TON of ideas, including some we accept FROM THE COMMUNITY.\n\nDrop some down in our DISCORD: https://discord.gg/EFqx763jvN\nCheck out our privacy policy for any concerns, if any concerns pop up, please send over a message to my email: darkifiedd@gmail.com\n\nI've spent approximately 4-6 months alone learning how to use unity, on a previous game that I had named \"Ape City\".\nOf course at that time I knew pretty much nothing about unity, but I learned.\n\nWith the help of Malex (developer of Just Chimpin + more) + Spacer (beta tester, developer supporting future pc exploits being shut down) we managed to develop the game you currently know as \"Gelada\".\n\nThank you all, seriously, it means a lot.\n\nAlso P.S. \nWatch out for \"him\"...", "short_description": "Welcome to GELADA!\nA Game containing an absolute TON of ideas, including some we accept FROM THE COMMUNITY.\n\nDrop some down in our DISCORD: https://discord.gg/EFqx763jvN\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/apct-industries/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Excell", "support_website_url": null, "website_url": "https://sites.google.com/view/apct-industries/updates?authuser=0", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "reco
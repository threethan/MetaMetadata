=AdnZ5OJVg6WyJWLzdGKL-EFanBcDfbYLXky0Ocl5KTqsiwaxb2POFTHnpibKqN-2E1c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afumtfs7LLhfDC1CGXEzL8WPGJeHLFc2-Kz5WHPqv1YOyA&oe=69A2EE3C"}, {"file_name": "ss-2.png", "id": "1332266731706340", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822550_1332266735039673_8100009495787672824_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDYnZOgKgU8Q7kNvwGA6mnR&_nc_oc=Adlta0X7i2VvSq8B_M9P8lNkDCYKlMjBd3LKgB4p2YV1ZqsyaAeO2EVI5gcGSCAchY4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftoBL1U4bFxCR0MGfKlHZB1W6WVu3nmzwiwfH2DeURdWw&oe=69A2D1FA"}, {"file_name": "ss-3.png", "id": "2556770804709411", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821115_2556770808042744_168867314432637241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMq4sdygM7cQ7kNvwHidCnL&_nc_oc=AdkrwfydVhlQ8WYhoiKyrOXCUbQb0IyilxQ2g2pyd27HdGwuQ5XvzOGdaN6XR97YQUo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs964Bzi3RvoqgshqHM59iz-1PrW2v56jWBe6r9CcuAhg&oe=69A2FD67"}, {"file_name": "ss-1.png", "id": "2028480447917184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819356_2028480451250517_5504327197980301938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIrH0mgG_XsQ7kNvwEQsjav&_nc_oc=Adk1cTWJ4cy1g2mIbVbGP8rkeBaLU9SH4Hxv-AAxXKGGzLG-QQJbIHRpl0EuKZcqNw8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvl-n-OvzKrrsbK4ALK3hl2SCnqgYyS4sFgc5ZhBZ65Tw&oe=69A2F2B5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cup Clash VR", "keywords": ["party", "cup", "ball", "casualgame", "minigame"], "long_description": "# Cup Clash VR: Smash or Stack\n\nThis virtual reality game combines precision, creativity, and strategy in a simple but engaging way.\n\n### Cup Breaker\nIn Cup Breaker, you use tennis balls to knock down cups from a distance. Aim carefully and throw to break as many cup patterns as possible. Every hit feels rewarding as you see the cups fall.\n\n### Cup Builder\nCup Builder tests your stacking skills. Follow a displayed pattern to build a tall tower of cups without letting it collapse. Think through each move and try to stack as high as you can.\n\n### Game Features\n- **Two Modes**: Cup Breaker for smashing cups, and Cup Builder for stacking.\n- **Simple Gameplay**: Focus on aiming and stacking without unnecessary distractions.\n- **Strategic Fun**: Take your time in building or enjoy quick, fast-paced cup smashing.\n\nCup Clash VR is a straightforward experience, letting you focus on the challenge of smashing or stacking cups.\n\n{1583804702345811}", "short_description": "\"Cup Clash VR\" is an action-packed virtual reality game where players engage in thrilling cup battles. Use strategy, quick reflexes and precision to stack, toss, and clash cups in various dynamic environments. Challenge yourself in this fast-paced, immersive experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/meprotech.in/cupclashvr/home", "developer_terms_of_service_url": null, "publisher_name": "MEPROTECH", "support_website_url": null, "website_url": "https://meprotech.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24425937363752351"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820566_1458997281838074_79867605111539782
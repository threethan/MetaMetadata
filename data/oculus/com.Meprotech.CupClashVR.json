=Adn3NK21NQ7GpGYpoevoKczerzR6jwG8B1pdi1_rahJh5BoWswVX-EvGtKzjJvxPfzI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft5U0Z-1Nglv9dhOozKy36ISyW__rP0N1Do8-q-9GDZUQ&oe=699C56BC"}, {"file_name": "ss-2.png", "id": "1332266731706340", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822550_1332266735039673_8100009495787672824_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKcX4JnDj5sQ7kNvwG2ssPZ&_nc_oc=AdnPPgRAa8obFVOMlL3kGWfHV_rfSzc7D8iEAPi8oOJTFmUJDgHW-jtJ_VHYvELN8nE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuY4G1-HNtHJt09t56jWmswvPp1fY06EYNFUDNSEPZ5WQ&oe=699C3A7A"}, {"file_name": "ss-3.png", "id": "2556770804709411", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821115_2556770808042744_168867314432637241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pN8V6bhKjUsQ7kNvwGG0l92&_nc_oc=Adle9gG9qc6_vv-Y0QrXfVzfHADNzctk2E3xiZGhoh6iGs4hnEd2KNt3JwPUTIBn9JE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsnNIPF5WxbdLAmk0NkOzsf5uuPtZAFKUj1rjkUHF1ZHQ&oe=699C65E7"}, {"file_name": "ss-1.png", "id": "2028480447917184", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819356_2028480451250517_5504327197980301938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAERgliUTKwQ7kNvwFAlwbQ&_nc_oc=AdnNzORCs-7-hq78FhvGcPQqxuSMFt4FdlX9RFO0TiCLrroGjnlKnQrZ0f0qdFDAIv4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs5Z_8-oBuRUbNXUF3jvF4ordGqSWvjKKNPnV52yJYgtg&oe=699C5B35"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cup Clash VR", "keywords": ["party", "cup", "ball", "casualgame", "minigame"], "long_description": "# Cup Clash VR: Smash or Stack\n\nThis virtual reality game combines precision, creativity, and strategy in a simple but engaging way.\n\n### Cup Breaker\nIn Cup Breaker, you use tennis balls to knock down cups from a distance. Aim carefully and throw to break as many cup patterns as possible. Every hit feels rewarding as you see the cups fall.\n\n### Cup Builder\nCup Builder tests your stacking skills. Follow a displayed pattern to build a tall tower of cups without letting it collapse. Think through each move and try to stack as high as you can.\n\n### Game Features\n- **Two Modes**: Cup Breaker for smashing cups, and Cup Builder for stacking.\n- **Simple Gameplay**: Focus on aiming and stacking without unnecessary distractions.\n- **Strategic Fun**: Take your time in building or enjoy quick, fast-paced cup smashing.\n\nCup Clash VR is a straightforward experience, letting you focus on the challenge of smashing or stacking cups.\n\n{1583804702345811}", "short_description": "\"Cup Clash VR\" is an action-packed virtual reality game where players engage in thrilling cup battles. Use strategy, quick reflexes and precision to stack, toss, and clash cups in various dynamic environments. Challenge yourself in this fast-paced, immersive experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/meprotech.in/cupclashvr/home", "developer_terms_of_service_url": null, "publisher_name": "MEPROTECH", "support_website_url": null, "website_url": "https://meprotech.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24425937363752351"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820566_1458997281838074_79867605111539782
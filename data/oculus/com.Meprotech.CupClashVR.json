=AdkMlxKsi_7_bL-OoVps6U9iYbewwIlxHhd7XzU8GAZEEmC9jo1MZct1_0W99cmpYoQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvMqFwTOcvYtRihPWN74gxhXKEmnDky0LZVXl54rkf4xg&oe=6998623C"}, {"file_name": "ss-2.png", "id": "1332266731706340", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822550_1332266735039673_8100009495787672824_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZ15dk3A9HUQ7kNvwG7ndR2&_nc_oc=AdnH8Q9JZeyeaA0gwAZRk7-mOgpw5AixB10sIGGLDjr2L7-h9T-mtqky0PIOCTNJaEM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsV_T__TT60g_7YGX6XJ6CXg7FPFxJB6cJW9UkiSmPrIQ&oe=699845FA"}, {"file_name": "ss-3.png", "id": "2556770804709411", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821115_2556770808042744_168867314432637241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oTctj-4-gtUQ7kNvwGUmHiC&_nc_oc=AdlctkJLZcG8q6zpEMP-0ZEBdMIW1NHJUCqm0IEDLcfjitWFE7l-O5la2GON4o7NGRE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsxjKRKnmC96t77n5BexSzGI3ZAtyGAhG1TGcpAIyc6EQ&oe=69987167"}, {"file_name": "ss-1.png", "id": "2028480447917184", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819356_2028480451250517_5504327197980301938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6W5nZWGQGUQ7kNvwEXNJ7L&_nc_oc=AdkfPe9u8wycy72ZNGDoVnqHz1haDAG4yQzfq0s3RQNpBa5p9OMm9nEm5-PhVHhIqYg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvTU8YQkVepzCycA3MgeEF3k41t0xYefs_DGi4DAqeSpw&oe=699866B5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cup Clash VR", "keywords": ["party", "cup", "ball", "casualgame", "minigame"], "long_description": "# Cup Clash VR: Smash or Stack\n\nThis virtual reality game combines precision, creativity, and strategy in a simple but engaging way.\n\n### Cup Breaker\nIn Cup Breaker, you use tennis balls to knock down cups from a distance. Aim carefully and throw to break as many cup patterns as possible. Every hit feels rewarding as you see the cups fall.\n\n### Cup Builder\nCup Builder tests your stacking skills. Follow a displayed pattern to build a tall tower of cups without letting it collapse. Think through each move and try to stack as high as you can.\n\n### Game Features\n- **Two Modes**: Cup Breaker for smashing cups, and Cup Builder for stacking.\n- **Simple Gameplay**: Focus on aiming and stacking without unnecessary distractions.\n- **Strategic Fun**: Take your time in building or enjoy quick, fast-paced cup smashing.\n\nCup Clash VR is a straightforward experience, letting you focus on the challenge of smashing or stacking cups.\n\n{1583804702345811}", "short_description": "\"Cup Clash VR\" is an action-packed virtual reality game where players engage in thrilling cup battles. Use strategy, quick reflexes and precision to stack, toss, and clash cups in various dynamic environments. Challenge yourself in this fast-paced, immersive experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/meprotech.in/cupclashvr/home", "developer_terms_of_service_url": null, "publisher_name": "MEPROTECH", "support_website_url": null, "website_url": "https://meprotech.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24425937363752351"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820566_1458997281838074_79867605111539782
YRbT5-rYT17uRrjf0ZL6LpSNO_AlV2UUjEOpRw6z_Klc7sJdGw1OHCc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oEdWJPcB6Wfcw4qAwF_sHwjqMokjrB3Y_yFNuzUfyJA&oe=6A144333"}, {"file_name": "ss-4.png", "id": "1277845167363770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821702_1277845170697103_3419768359387623619_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDwCk6CNZ0AQ7kNvwGK1ANp&_nc_oc=AdqU_rrmF2pwY1BoZqdF-hdUFyZ3t854PCjgD_DqwZ_WfxbayTX_wSBXgTQ-1wAy_K8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gMtEFZW1rDb4j9Pd4f-2NvefR4xEP8j60nkglRHd35g&oe=6A144F3C"}, {"file_name": "ss-2.png", "id": "1332266731706340", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822550_1332266735039673_8100009495787672824_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mt829hFTFsUQ7kNvwG62TAj&_nc_oc=Adpy38myTtpfp6RhsOOZW8nu9AqTDnHpjVMBaMFDB43v5CxZ6k9bE9VOjH_9_xKAS8Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rxgDgz7AVGeKKCs2AlJoM5qntv076RP-sRdUfh_iZsQ&oe=6A146B3A"}, {"file_name": "ss-3.png", "id": "2556770804709411", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821115_2556770808042744_168867314432637241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7L1VusFt5qgQ7kNvwFD47li&_nc_oc=AdpRSw7bxg2pXKFygo3KjQYNFg3bjVDVwtpL7xq5UHVQ4UqgIrh5iC4o1zEg1DI_NV8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4R5eF6XjKmbVqku20MEB-bv9bdbZZFfiaR-shDPeo-iQ&oe=6A145E67"}, {"file_name": "ss-1.png", "id": "2028480447917184", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819356_2028480451250517_5504327197980301938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jaCB8xUCPMQ7kNvwHIY7SB&_nc_oc=AdqvEOhUA9cZj6t6s3ttMCER88qBQF6XhH2ZXCW5hYuRy3GFRhfsW1g6w5GPAA5TBkc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5v7h-4sRCy8EPXuh0_vJ5-y4Ewhu5YZL8mEaI37XY6UA&oe=6A1453B5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cup Clash VR", "keywords": ["party", "cup", "ball", "casualgame", "minigame"], "long_description": "# Cup Clash VR: Smash or Stack\n\nThis virtual reality game combines precision, creativity, and strategy in a simple but engaging way.\n\n### Cup Breaker\nIn Cup Breaker, you use tennis balls to knock down cups from a distance. Aim carefully and throw to break as many cup patterns as possible. Every hit feels rewarding as you see the cups fall.\n\n### Cup Builder\nCup Builder tests your stacking skills. Follow a displayed pattern to build a tall tower of cups without letting it collapse. Think through each move and try to stack as high as you can.\n\n### Game Features\n- **Two Modes**: Cup Breaker for smashing cups, and Cup Builder for stacking.\n- **Simple Gameplay**: Focus on aiming and stacking without unnecessary distractions.\n- **Strategic Fun**: Take your time in building or enjoy quick, fast-paced cup smashing.\n\nCup Clash VR is a straightforward experience, letting you focus on the challenge of smashing or stacking cups.\n\n{1583804702345811}", "short_description": "\"Cup Clash VR\" is an action-packed virtual reality game where players engage in thrilling cup battles. Use strategy, quick reflexes and precision to stack, toss, and clash cups in various dynamic environments. Challenge yourself in this fast-paced, immersive experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/meprotech.in/cupclashvr/home", "developer_terms_of_service_url": null, "publisher_name": "MEPROTECH", "support_website_url": null, "website_url": "https://meprotech.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null,
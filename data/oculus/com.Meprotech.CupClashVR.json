yg-aJ66sqDAUIxFG0vdE43fSylgctW8kk_lAh_7l167AN9xSsJBwpbc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7P6Bzu0-1PAsv0DyE6QY97bA8yjN87iXxle39mMao-mQ&oe=6A12F1B3"}, {"file_name": "ss-4.png", "id": "1277845167363770", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821702_1277845170697103_3419768359387623619_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDwCk6CNZ0AQ7kNvwERRjAg&_nc_oc=AdrTEnO9T65GDEN9dcbKh-F7DA1NqbTSQ1jQpZ43s_n9PMGAhAG_euVVB-watp8NTKU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nWuqoCw7iJPWhm2XqTw5E5ZBMgKpYUiHsiagEd6jH5w&oe=6A12FDBC"}, {"file_name": "ss-2.png", "id": "1332266731706340", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822550_1332266735039673_8100009495787672824_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mt829hFTFsUQ7kNvwGTXtIB&_nc_oc=AdrSNcylJDq0zXMdxc4ii-KfRTR6lIt6hXBf-rRSn3JZFW8ZkHn9x5s2n8aEAIwewHA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5w1jB-aebMmQ1frn_5ilK1IFiF5dgwr9o2ThJWRwEC_Q&oe=6A1319BA"}, {"file_name": "ss-3.png", "id": "2556770804709411", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821115_2556770808042744_168867314432637241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7L1VusFt5qgQ7kNvwFPPd2I&_nc_oc=AdpJKy8rfAIFdcPzN0y4oHlB5RWrVSPyb3rqMzhqftxEVqHu6pW_tNC1HFXWs_mk_mk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OP1oZc3kLd8Axe-ABGA26iNtnEmQcTUdNQGSWJyRnwA&oe=6A130CE7"}, {"file_name": "ss-1.png", "id": "2028480447917184", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819356_2028480451250517_5504327197980301938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jaCB8xUCPMQ7kNvwGeQpBj&_nc_oc=AdqsyJsSjMfgGR2pJAWK9-AYGleYVKBf05fT6FZH61ig8br44EKRWJnGhUDCLrAjpt8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FvARya2Ee_xhrA6dNWJErl2bwuBxnp2ZyxnDgqIBtiA&oe=6A130235"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cup Clash VR", "keywords": ["party", "cup", "ball", "casualgame", "minigame"], "long_description": "# Cup Clash VR: Smash or Stack\n\nThis virtual reality game combines precision, creativity, and strategy in a simple but engaging way.\n\n### Cup Breaker\nIn Cup Breaker, you use tennis balls to knock down cups from a distance. Aim carefully and throw to break as many cup patterns as possible. Every hit feels rewarding as you see the cups fall.\n\n### Cup Builder\nCup Builder tests your stacking skills. Follow a displayed pattern to build a tall tower of cups without letting it collapse. Think through each move and try to stack as high as you can.\n\n### Game Features\n- **Two Modes**: Cup Breaker for smashing cups, and Cup Builder for stacking.\n- **Simple Gameplay**: Focus on aiming and stacking without unnecessary distractions.\n- **Strategic Fun**: Take your time in building or enjoy quick, fast-paced cup smashing.\n\nCup Clash VR is a straightforward experience, letting you focus on the challenge of smashing or stacking cups.\n\n{1583804702345811}", "short_description": "\"Cup Clash VR\" is an action-packed virtual reality game where players engage in thrilling cup battles. Use strategy, quick reflexes and precision to stack, toss, and clash cups in various dynamic environments. Challenge yourself in this fast-paced, immersive experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/meprotech.in/cupclashvr/home", "developer_terms_of_service_url": null, "publisher_name": "MEPROTECH", "support_website_url": null, "website_url": "https://meprotech.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null,
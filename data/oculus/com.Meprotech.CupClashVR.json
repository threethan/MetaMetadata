1337_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkE66hobimwQ7kNvwFGG7wN&_nc_oc=Adq85v08tbWcFOU9GFYYmeHYDILupWgVhBM0JEEsIIbp7Vx67OCG7NRveKsW_J_MiVA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2Q5G6A4UQVjJbB0UJBs4rXTPd0L26lC3FYNn3KIYCWJg&oe=69F09F38"}, {"file_name": "5.png", "id": "544533391449905", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974723_544533394783238_2618581233150498749_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7n90x-YXKoQ7kNvwE1Mfvb&_nc_oc=AdpjhbSIFB9hgnCEMpaexm4bT9T-4guTR3qku9q9b3AaY5EcvaX-cadDIfIR8iC2If0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0726z8W4PdWjLBJXu_rLUJNLhwyJFnig-4rZBZU0v9_Q&oe=69F0B32A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cup Clash VR", "keywords": ["CupGame", "CupBreaking", "CupBuilderGame", "Ballthrowgame", "Cup"], "long_description": "Welcome to Cup Clash VR!\nPrepare for an action-packed adventure in this thrilling virtual reality experience where precision, creativity, and strategy collide! \nCup Breaker challenges you to grab your tennis balls and shatter as many cup patterns as possible from a distance. Aim, throw, and feel the excitement as you knock down cups in a satisfying display of destruction! \nIn Cup Builder, test your skills by stacking and aligning cups to construct the tallest tower without it tumbling over. Follow the displayed pattern, strategize your moves, and rise to the challenge at your own pace. How high can you build your masterpiece? \nWith immersive gameplay, Cup Clash VR offers a unique blend of fast-paced action and thoughtful construction. Whether you\u2019re smashing or stacking, the fun never ends! ", "short_description": "\"Cup Clash VR\" is an action-packed virtual reality game where players engage in thrilling cup battles. Use strategy, quick reflexes, and precision to stack, toss, and clash cups in various dynamic environments.  challenge yourself in this fast-paced, immersive experience."}]}, "developer
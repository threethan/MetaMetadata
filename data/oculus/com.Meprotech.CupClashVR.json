40V06pMUmOXGBPy13h3ayftaj749LpOuUj42kii_joQfK_iwKvc76Nw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1c193Xvn-X-4jAIE0-Z3EbxZlmB5v_gYWexCzw7UPsxw&oe=69EB64B3"}, {"file_name": "ss-4.png", "id": "1277845167363770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821702_1277845170697103_3419768359387623619_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XC8RKu_GgRMQ7kNvwFOgCsA&_nc_oc=AdoaOeqSmobO0bdmUoXKoNXgtzHhzqFp2QsHywt27-wuW-REQiDk_xHaImjq6Q2cRcY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36ZVu00h0eZ8hbWHC9xM9qtItn-BaDzNB8mQTzAJybqA&oe=69EB70BC"}, {"file_name": "ss-2.png", "id": "1332266731706340", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822550_1332266735039673_8100009495787672824_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnbOnVgDL0oQ7kNvwHIT3w7&_nc_oc=AdpzsCgt8mmcuCv0tFSER9gtLdRT38l796qqpZiQtvpKwTk4i_z995SC2bNL2-7rjOM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Kh3POuke-9seAjpkWUhpVW0B9ZHnVpZRPLhheOyEozw&oe=69EB8CBA"}, {"file_name": "ss-3.png", "id": "2556770804709411", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821115_2556770808042744_168867314432637241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Xd5rrhVRGMQ7kNvwGtmXRA&_nc_oc=Adqfyh8KyLTgBS6rFtUaG9eo2n_9qqddBsqjOQym7SSdbh2p8l-pL5FGiW3PZXuHwOc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RSD3quLAFHw2wUOnVgUeYOr27_aetM4Xg8suLNIGO5Q&oe=69EB7FE7"}, {"file_name": "ss-1.png", "id": "2028480447917184", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819356_2028480451250517_5504327197980301938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dg5FPtQ6_h4Q7kNvwFp3UsS&_nc_oc=Adoob68BgdzPwUbOXpbaFcSpxROSLLvBrORql9k8HkidJ_hz2VUbNdlZmJ5G5R5Ri-A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ohUfsqmwGSwLTe9Dxv7Ags6htrnA8Be3qSnWcwYlfrA&oe=69EB7535"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cup Clash VR", "keywords": ["party", "cup", "ball", "casualgame", "minigame"], "long_description": "# Cup Clash VR: Smash or Stack\n\nThis virtual reality game combines precision, creativity, and strategy in a simple but engaging way.\n\n### Cup Breaker\nIn Cup Breaker, you use tennis balls to knock down cups from a distance. Aim carefully and throw to break as many cup patterns as possible. Every hit feels rewarding as you see the cups fall.\n\n### Cup Builder\nCup Builder tests your stacking skills. Follow a displayed pattern to build a tall tower of cups without letting it collapse. Think through each move and try to stack as high as you can.\n\n### Game Features\n- **Two Modes**: Cup Breaker for smashing cups, and Cup Builder for stacking.\n- **Simple Gameplay**: Focus on aiming and stacking without unnecessary distractions.\n- **Strategic Fun**: Take your time in building or enjoy quick, fast-paced cup smashing.\n\nCup Clash VR is a straightforward experience, letting you focus on the challenge of smashing or stacking cups.\n\n{1583804702345811}", "short_description": "\"Cup Clash VR\" is an action-packed virtual reality game where players engage in thrilling cup battles. Use strategy, quick reflexes and precision to stack, toss, and clash cups in various dynamic environments. Challenge yourself in this fast-paced, immersive experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/meprotech.in/cupclashvr/home", "developer_terms_of_service_url": null, "publisher_name": "MEPROTECH", "support_website_url": null, "website_url": "https://meprotech.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null,
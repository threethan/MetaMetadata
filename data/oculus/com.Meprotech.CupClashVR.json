T32smnCr8Hn7Pfv6xYZ68o90wW56Rfdn4bnetFYuK_50bAGYs715jHs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Hk8OLcahhZ5IdrXght-JUiM89U-hWhhL0gBNOV_vmbA&oe=6A047133"}, {"file_name": "ss-4.png", "id": "1277845167363770", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821702_1277845170697103_3419768359387623619_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utMob_9MkM4Q7kNvwG87yQv&_nc_oc=AdoMBj05S9WLp41RII-67zOCdP2y1ZMkoRSfuj5HLMgE77qDrfdCuj5TZ3cTCYKQjfg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50vzUTx4G4ubeFtpHo3vyQ6yUW4q8nDvhGCNZmQzFdHw&oe=6A047D3C"}, {"file_name": "ss-2.png", "id": "1332266731706340", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822550_1332266735039673_8100009495787672824_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdQpAbx0AWcQ7kNvwFrsRG9&_nc_oc=AdoJl1CgwXhRijfZPfhgSgUPlFV5iEL8vP3ykvUKfP37njfmUjyXij5cjrme0cgKFm0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HiMqP-z35DsCOtT2xyCl_NZLQItA6jSPkU4wtmVPsKQ&oe=6A04993A"}, {"file_name": "ss-3.png", "id": "2556770804709411", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821115_2556770808042744_168867314432637241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3Nn2LuGA5IQ7kNvwESZn8p&_nc_oc=Adogr-zPPSYH-gPFsDyUQ0h9hDRUxhbMwT5fl7wZKcWIRqA9agFI_3lwGIuSmurLH-0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-vXp4Ri4t2kiBuVUj1e4bbF9g9Av7vDu5-TGTowt8zQ&oe=6A048C67"}, {"file_name": "ss-1.png", "id": "2028480447917184", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_2028480451250517_5504327197980301938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGk8IRgwePIQ7kNvwFbymDw&_nc_oc=Ado4YrUkmJ1EoEw_O-FNaSfmMEwmhupTEhmIZqeRretO0mT03b3eSoElvDhCNpm06eY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45I5ZnN0Xh580Uvl84acgbf01gtITCV4QGPuP-jmumPQ&oe=6A0481B5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cup Clash VR", "keywords": ["party", "cup", "ball", "casualgame", "minigame"], "long_description": "# Cup Clash VR: Smash or Stack\n\nThis virtual reality game combines precision, creativity, and strategy in a simple but engaging way.\n\n### Cup Breaker\nIn Cup Breaker, you use tennis balls to knock down cups from a distance. Aim carefully and throw to break as many cup patterns as possible. Every hit feels rewarding as you see the cups fall.\n\n### Cup Builder\nCup Builder tests your stacking skills. Follow a displayed pattern to build a tall tower of cups without letting it collapse. Think through each move and try to stack as high as you can.\n\n### Game Features\n- **Two Modes**: Cup Breaker for smashing cups, and Cup Builder for stacking.\n- **Simple Gameplay**: Focus on aiming and stacking without unnecessary distractions.\n- **Strategic Fun**: Take your time in building or enjoy quick, fast-paced cup smashing.\n\nCup Clash VR is a straightforward experience, letting you focus on the challenge of smashing or stacking cups.\n\n{1583804702345811}", "short_description": "\"Cup Clash VR\" is an action-packed virtual reality game where players engage in thrilling cup battles. Use strategy, quick reflexes and precision to stack, toss, and clash cups in various dynamic environments. Challenge yourself in this fast-paced, immersive experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/meprotech.in/cupclashvr/home", "developer_terms_of_service_url": null, "publisher_name": "MEPROTECH", "support_website_url": null, "website_url": "https://meprotech.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null,
=Adn2PLevbyG1U31b64ge2RJBKyqEiHB4L3yGJ-TZ0Z7kRpH3d4MhMSTAhbkjUgWOK0A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvQcfRSa2bBP3R-7Isf_vezDaDsu6eTJGFeI8eayQkiSQ&oe=69A6E2BC"}, {"file_name": "ss-2.png", "id": "1332266731706340", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822550_1332266735039673_8100009495787672824_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpJ1PHO--g0Q7kNvwFLCgwf&_nc_oc=Adk2Tr5qKbW1vw0833i5uqDzXhMfTZRMPZ1dkZ4ZzPYTLA9s0mEb36nxq5mvmF4kKQ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvhwo_BT_EX5aYvzM8vfNY1Qfl5kNBYIqdXnFSwZ0BgJA&oe=69A6C67A"}, {"file_name": "ss-3.png", "id": "2556770804709411", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821115_2556770808042744_168867314432637241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9_lmwBrho0Q7kNvwFPeY1T&_nc_oc=AdnbQWhPlxRU-ZN3AHeiMRh0EIOet3topzFUwSO9s-F_AGSg5n0zk1tAxB6hwEjzIJ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuAN3vYGChTDjA_bKIJhyEFeiTyQ5kwEVGViNKPtPJn3g&oe=69A6F1E7"}, {"file_name": "ss-1.png", "id": "2028480447917184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819356_2028480451250517_5504327197980301938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ns0JnPMbTycQ7kNvwGYC6AR&_nc_oc=Adnmr5QQUjYJtMqYx1wXB-KZkPw2vo4XED8LKgFdL7H0No8AKyYpALUEAFIEuf0RrU0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftfrs8LVuDGde8TTJp5tuIY-DJPm1JlNX3aJAu_w4VJbA&oe=69A6E735"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cup Clash VR", "keywords": ["party", "cup", "ball", "casualgame", "minigame"], "long_description": "# Cup Clash VR: Smash or Stack\n\nThis virtual reality game combines precision, creativity, and strategy in a simple but engaging way.\n\n### Cup Breaker\nIn Cup Breaker, you use tennis balls to knock down cups from a distance. Aim carefully and throw to break as many cup patterns as possible. Every hit feels rewarding as you see the cups fall.\n\n### Cup Builder\nCup Builder tests your stacking skills. Follow a displayed pattern to build a tall tower of cups without letting it collapse. Think through each move and try to stack as high as you can.\n\n### Game Features\n- **Two Modes**: Cup Breaker for smashing cups, and Cup Builder for stacking.\n- **Simple Gameplay**: Focus on aiming and stacking without unnecessary distractions.\n- **Strategic Fun**: Take your time in building or enjoy quick, fast-paced cup smashing.\n\nCup Clash VR is a straightforward experience, letting you focus on the challenge of smashing or stacking cups.\n\n{1583804702345811}", "short_description": "\"Cup Clash VR\" is an action-packed virtual reality game where players engage in thrilling cup battles. Use strategy, quick reflexes and precision to stack, toss, and clash cups in various dynamic environments. Challenge yourself in this fast-paced, immersive experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/meprotech.in/cupclashvr/home", "developer_terms_of_service_url": null, "publisher_name": "MEPROTECH", "support_website_url": null, "website_url": "https://meprotech.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24425937363752351"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820566_1458997281838074_79867605111539782
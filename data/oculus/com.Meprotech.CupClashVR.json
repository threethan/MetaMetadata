hf1r3Zq43zeXo80ekjcNOnnhm4zhHPPNnNowL5YYHOl3j5F4OAPeBUI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kxRqt5wmxwQNAFI9zfXrlwu3gKt9M2LyaO0L2SLlOcg&oe=69E8C1B3"}, {"file_name": "ss-4.png", "id": "1277845167363770", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821702_1277845170697103_3419768359387623619_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVw67ffqisIQ7kNvwEuVQ8z&_nc_oc=AdpfIcNPdHZqBC9Ky2uS_hWJc3UKu8AhwqYsf7ljYlT_NgodmSyFava8x18xo52dNBc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XVRBsrf3f75CGLmPu_ws_-z5IRmH2PuH-dWGt2Q9J-A&oe=69E8CDBC"}, {"file_name": "ss-2.png", "id": "1332266731706340", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822550_1332266735039673_8100009495787672824_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rhoIajMUBAQ7kNvwGu3s-w&_nc_oc=AdqcKEJYjvpSn8RiW6Tz_LM8_53WQSyRUlVWPe3rpDhb6MIh4wqzPF_3dBud4FCD3Nw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af006lcPJuNDi0PhsJkJux4-4PFatDJZdBQS8R1reMDuOQ&oe=69E8B17A"}, {"file_name": "ss-3.png", "id": "2556770804709411", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821115_2556770808042744_168867314432637241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2gB2AZPivEQ7kNvwFK5FgP&_nc_oc=Adqqj4LzVF5-moKeLK2tiCc1aRQRQ9_-7PYwYUrcg8GQj4zvt3UsBxSy_rB-CNjU23Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Om-URSfUjHRaKrCj62WbPI6PPISzoN9B-lO0WJ43E2A&oe=69E8DCE7"}, {"file_name": "ss-1.png", "id": "2028480447917184", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819356_2028480451250517_5504327197980301938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHFKnTztIYsQ7kNvwF0fXBn&_nc_oc=AdrTokNvg10HmNLa-obOfN3K7HoSXgYw0ka1I048795bVfgIUQZgS9KEuK3oiVa3SWA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vpv6EJZ8ENGlkjgqb7EKGnevULlbn-Yu4Drq9L_YECQ&oe=69E8D235"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cup Clash VR", "keywords": ["party", "cup", "ball", "casualgame", "minigame"], "long_description": "# Cup Clash VR: Smash or Stack\n\nThis virtual reality game combines precision, creativity, and strategy in a simple but engaging way.\n\n### Cup Breaker\nIn Cup Breaker, you use tennis balls to knock down cups from a distance. Aim carefully and throw to break as many cup patterns as possible. Every hit feels rewarding as you see the cups fall.\n\n### Cup Builder\nCup Builder tests your stacking skills. Follow a displayed pattern to build a tall tower of cups without letting it collapse. Think through each move and try to stack as high as you can.\n\n### Game Features\n- **Two Modes**: Cup Breaker for smashing cups, and Cup Builder for stacking.\n- **Simple Gameplay**: Focus on aiming and stacking without unnecessary distractions.\n- **Strategic Fun**: Take your time in building or enjoy quick, fast-paced cup smashing.\n\nCup Clash VR is a straightforward experience, letting you focus on the challenge of smashing or stacking cups.\n\n{1583804702345811}", "short_description": "\"Cup Clash VR\" is an action-packed virtual reality game where players engage in thrilling cup battles. Use strategy, quick reflexes and precision to stack, toss, and clash cups in various dynamic environments. Challenge yourself in this fast-paced, immersive experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/meprotech.in/cupclashvr/home", "developer_terms_of_service_url": null, "publisher_name": "MEPROTECH", "support_website_url": null, "website_url": "https://meprotech.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null,
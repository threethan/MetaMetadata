wnjqS8jyQM0bx3w5a7n4nbIrt5ye1dVVZvrt84dRP2vueCha8-9BhmQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pprfxuCp6hgP1fYfw2IlAnnLniP1uGU2lfx0IzkkVAQ&oe=69FB36B3"}, {"file_name": "ss-4.png", "id": "1277845167363770", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821702_1277845170697103_3419768359387623619_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhL7VFqPsgEQ7kNvwGHABTP&_nc_oc=Adqqodz77CYWPwnnixZRhc2WIVMkMeFWgJshZzoi24USGUtvxTcq3T41HpnM6FGIZhY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NMcH4dk4wCZWxYJC30MiiBff_CGwNWgcGFv7nxORhkA&oe=69FB42BC"}, {"file_name": "ss-2.png", "id": "1332266731706340", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822550_1332266735039673_8100009495787672824_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRmYicrHsDQQ7kNvwEGwPeO&_nc_oc=AdoWZ-5rkDmlDrpKRC045LMheOd_UON8rskOlKA1KspKzlvwExTihhRa45LfWAxbVls&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af704SAdkietCCwNzPCSMMVCtf1xueEmDRDaK8wOAs-coA&oe=69FB5EBA"}, {"file_name": "ss-3.png", "id": "2556770804709411", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821115_2556770808042744_168867314432637241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9a_CnIQi3oQ7kNvwHH4omL&_nc_oc=AdqTJROPsZQjqdOOQxf6jNLv9XWCg0NJyzaxSTe9i2ahbPAQRTWI9j7E58EEtP3m6V4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aPr3OI3DvWekaqaErjzNG6xguJtrA-uDjC1XcEf0EPQ&oe=69FB51E7"}, {"file_name": "ss-1.png", "id": "2028480447917184", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819356_2028480451250517_5504327197980301938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9-Tsp7QNXwQ7kNvwEGvvjE&_nc_oc=AdqtADk_ndqLyj0aVWjfSzU5M_qIto7x934lrebiOrxWzIT6ZlP48sKMPDW6975usFM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hj4CJaFnv1iTbM2WBRF8jwSJa-2u5kFHzdZ5r3jikhw&oe=69FB4735"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cup Clash VR", "keywords": ["party", "cup", "ball", "casualgame", "minigame"], "long_description": "# Cup Clash VR: Smash or Stack\n\nThis virtual reality game combines precision, creativity, and strategy in a simple but engaging way.\n\n### Cup Breaker\nIn Cup Breaker, you use tennis balls to knock down cups from a distance. Aim carefully and throw to break as many cup patterns as possible. Every hit feels rewarding as you see the cups fall.\n\n### Cup Builder\nCup Builder tests your stacking skills. Follow a displayed pattern to build a tall tower of cups without letting it collapse. Think through each move and try to stack as high as you can.\n\n### Game Features\n- **Two Modes**: Cup Breaker for smashing cups, and Cup Builder for stacking.\n- **Simple Gameplay**: Focus on aiming and stacking without unnecessary distractions.\n- **Strategic Fun**: Take your time in building or enjoy quick, fast-paced cup smashing.\n\nCup Clash VR is a straightforward experience, letting you focus on the challenge of smashing or stacking cups.\n\n{1583804702345811}", "short_description": "\"Cup Clash VR\" is an action-packed virtual reality game where players engage in thrilling cup battles. Use strategy, quick reflexes and precision to stack, toss, and clash cups in various dynamic environments. Challenge yourself in this fast-paced, immersive experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/meprotech.in/cupclashvr/home", "developer_terms_of_service_url": null, "publisher_name": "MEPROTECH", "support_website_url": null, "website_url": "https://meprotech.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null,
_AQRG3cCEczw6VuhNEBcJRwXOb2Ir_tQXbG4Z4P20KkBEdw&oe=6AFB38E4"}, {"file_name": "3.png", "id": "1173164207103113", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75348039_1173164210436446_9072273882407821337_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLlnkD2OUQMQ7kNvwGk33Xm&_nc_oc=AdrP62ADhRRDC_bUrB8o68ql5RbgtGO-KEj8tety11btQxaxuvNCrt16lBqaffX2am0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZ5GTe8vMehij_t2-mMsDPY2Z87ZDK_WQZE1ZbmWEKCA&oe=6AFB2678"}, {"file_name": "5.png", "id": "544533391449905", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974723_544533394783238_2618581233150498749_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jawAfieglUQ7kNvwHuiLdy&_nc_oc=AdoQQkamY6enwMADYWyKvVtlNQWM4c-3kqXUNLikeXSjc3zDpj9l1xCuU8InLA7iQvQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMHLuVLKJss2eB31K5eEZQxFr3NFFhFmDYCYGE23bL8w&oe=6AFB3A6A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cup Clash VR", "keywords": ["CupGame", "CupBreaking", "CupBuilderGame", "Ballthrowgame", "Cup"], "long_description": "Welcome to Cup Clash VR!\nPrepare for an action-packed adventure in this thrilling virtual reality experience where precision, creativity, and strategy collide! \nCup Breaker challenges you to grab your tennis balls and shatter as many cup patterns as possible from a distance. Aim, throw, and feel the excitement as you knock down cups in a satisfying display of destruction! \nIn Cup Builder, test your skills by stacking and aligning cups to construct the tallest tower without it tumbling over. Follow the displayed pattern, strategize your moves, and rise to the challenge at your own pace. How high can you build your masterpiece? \nWith immersive gameplay, Cup Clash VR offers a unique blend of fast-paced action and thoughtful construction. Whether you\u2019re smashing or stacking, the fun never ends! ", "short_description": 
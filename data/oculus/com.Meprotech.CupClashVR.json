LZwIQyps-sCyK53g2YAj-ipSAp6HCP-BKXpEU1D0A&oe=69C7CC33"}, {"file_name": "ss-4.png", "id": "1277845167363770", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821702_1277845170697103_3419768359387623619_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C52tuzzT4NsQ7kNvwH_XBb9&_nc_oc=AdoJ4mg8bbZ9DefM_Qmu7BwWBfhybgKZWNz4FCTn1cTIT5PZXv5I3e5DIqdABm_9ebw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkFUELKdCpxrYishYUEr9onCgD4yPxP5yX4OPIR93c7A&oe=69C7D83C"}, {"file_name": "ss-2.png", "id": "1332266731706340", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491822550_1332266735039673_8100009495787672824_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1rMTp8rPKIQ7kNvwG_7qvd&_nc_oc=AdrcHMEyGZShQQkRJz1BqoZpPZ6gnS0Xq2BHo32mno1l_gYYLvSrLk0HJuSs-pG4ntc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz83GFUsh0eKUpELpRDXVif4Ps0oD8PqGPV5QTFbjorAA&oe=69C7BBFA"}, {"file_name": "ss-3.png", "id": "2556770804709411", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491821115_2556770808042744_168867314432637241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uwFmT8ILS8Q7kNvwF46-gG&_nc_oc=AdovcOmHdziRTvzBANJhI2LlQhx8CsdkTt_K9WyVmBRMl6MO8VT-VgjPAufqZzZLrVg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxv1xUH_JN1ODAnN0b1T53ScKYQSyzIR7qgA7aQEopwvg&oe=69C7E767"}, {"file_name": "ss-1.png", "id": "2028480447917184", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491819356_2028480451250517_5504327197980301938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1osdguH_JrgQ7kNvwHlzoBk&_nc_oc=AdqywJLrwOr1W6P6LDowTJLH8ecb24GanpfN-48876C1TWsyfU0aaYzzLiv-TqvxWKQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyAWQElPqeWNi_OWUAwI0RMyKwiU4AShD9DOHTjXeZzPw&oe=69C7DCB5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cup Clash VR", "keywords": ["party", "cup", "ball", "casualgame", "minigame"], "long_description": "# Cup Clash VR: Smash or Stack\n\nThis virtual reality game combines precision, creativity, and strategy in a simple but engaging way.\n\n### Cup Breaker\nIn Cup Breaker, you use tennis balls to knock down cups from a distance. Aim carefully and throw to break as many cup patterns as possible. Every hit feels rewarding as you see the cups fall.\n\n### Cup Builder\nCup Builder tests your stacking skills. Follow a displayed pattern to build a tall tower of cups without letting it collapse. Think through each move and try to stack as high as you can.\n\n### Game Features\n- **Two Modes**: Cup Breaker for smashing cups, and Cup Builder for stacking.\n- **Simple Gameplay**: Focus on aiming and stacking without unnecessary distractions.\n- **Strategic Fun**: Take your time in building or enjoy quick, fast-paced cup smashing.\n\nCup Clash VR is a straightforward experience, letting you focus on the challenge of smashing or stacking cups.\n\n{1583804702345811}", "short_description": "\"Cup Clash VR\" is an action-packed virtual reality game where players engage in thrilling cup battles. Use strategy, quick reflexes and precision to stack, toss, and clash cups in various dynamic environments. Challenge yourself in this fast-paced, immersive experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/meprotech.in/cupclashvr/home", "developer_terms_of_service_url": null, "publisher_name": "MEPROTECH", "support_website_url": null, "website_url": "https://meprotech.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices"
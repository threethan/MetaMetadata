dzS5vLyzIQzuVNNELEbpK5vZqH4-CGLqpT9to1UJQ&oe=69C67AB3"}, {"file_name": "ss-4.png", "id": "1277845167363770", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821702_1277845170697103_3419768359387623619_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIzbKTtyCJAQ7kNvwGpMAPi&_nc_oc=AdqSKyUdsLg4JnEeTWH9B8tZ_hNyuwPhwsGF-XkyAkba6jNx4Hq7VmudnmcmtVGJ1ow&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzP2r5f3BspS2Kj-9RuHzkmW4za2Y9WT17M87sXJ4nVmA&oe=69C686BC"}, {"file_name": "ss-2.png", "id": "1332266731706340", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822550_1332266735039673_8100009495787672824_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1rMTp8rPKIQ7kNvwHjex5z&_nc_oc=Adr_0KICEmyz8KRCwZedEOJcc5Tj0adN0-i3nslUYvk9EId8qAwNBf3RZqPiW1Fwlwg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxoIAD7MqT6vhIeQ27mGVJFVwkRdqTtBMknzzD6WeFB6A&oe=69C66A7A"}, {"file_name": "ss-3.png", "id": "2556770804709411", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821115_2556770808042744_168867314432637241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUz8Jntk3lIQ7kNvwGShGWQ&_nc_oc=Adop8Pb55MpXUgPl_rTszQhp2tiyxtVzpWiyIV5nWTIGfh69WRR5rQiRjGvuq2NRsuw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYCY9iE0vrGkH0fwx5ybQ0WMYaMzwXnGr8uSx0naOMJQ&oe=69C695E7"}, {"file_name": "ss-1.png", "id": "2028480447917184", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819356_2028480451250517_5504327197980301938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6RShkULo6MQ7kNvwEVSBI3&_nc_oc=Adr4gKxDTDeOQZaKsvdkpgLjhNcvAn5F1CQsJYj3mi1Xn79RJhfqCl-asX5Xa6fTWII&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwBGGL_eS_E4rS8rwh4XGVIbe0UmwOIiAo8PrxzRIdTrQ&oe=69C68B35"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cup Clash VR", "keywords": ["party", "cup", "ball", "casualgame", "minigame"], "long_description": "# Cup Clash VR: Smash or Stack\n\nThis virtual reality game combines precision, creativity, and strategy in a simple but engaging way.\n\n### Cup Breaker\nIn Cup Breaker, you use tennis balls to knock down cups from a distance. Aim carefully and throw to break as many cup patterns as possible. Every hit feels rewarding as you see the cups fall.\n\n### Cup Builder\nCup Builder tests your stacking skills. Follow a displayed pattern to build a tall tower of cups without letting it collapse. Think through each move and try to stack as high as you can.\n\n### Game Features\n- **Two Modes**: Cup Breaker for smashing cups, and Cup Builder for stacking.\n- **Simple Gameplay**: Focus on aiming and stacking without unnecessary distractions.\n- **Strategic Fun**: Take your time in building or enjoy quick, fast-paced cup smashing.\n\nCup Clash VR is a straightforward experience, letting you focus on the challenge of smashing or stacking cups.\n\n{1583804702345811}", "short_description": "\"Cup Clash VR\" is an action-packed virtual reality game where players engage in thrilling cup battles. Use strategy, quick reflexes and precision to stack, toss, and clash cups in various dynamic environments. Challenge yourself in this fast-paced, immersive experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/meprotech.in/cupclashvr/home", "developer_terms_of_service_url": null, "publisher_name": "MEPROTECH", "support_website_url": null, "website_url": "https://meprotech.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices"
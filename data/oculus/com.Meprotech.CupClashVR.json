_AQQP3NonM3Uc566acTT5V3vJ57iY2P5hPtLuAf64uuCKeQ&oe=6B0DADE4"}, {"file_name": "3.png", "id": "1173164207103113", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348039_1173164210436446_9072273882407821337_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlW9USE82FQQ7kNvwHOhPC8&_nc_oc=AdoRhMuRLjshh8MZPTjQjutRyN-v1kLQ3uz6vUG6gYfl2zdtvUexQRCPZ1Tp27AoEyI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRoBy11f2RR0AGTt1LXiAY1n9NIOQIhiDnO7347D8-9Gw&oe=6B0D9B78"}, {"file_name": "5.png", "id": "544533391449905", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974723_544533394783238_2618581233150498749_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fvyrdx5nKPEQ7kNvwFjJ1Uf&_nc_oc=AdoMtKb4BvI-LBaDoXol4JIUrc6djKtxCoyuQxSNuydbaonQoYPavUVDJ877YAvsHSo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTp4NJ95UBTOwnLvgXKcpPCS4sESjHnNIAjoL5sk6A9gg&oe=6B0DAF6A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cup Clash VR", "keywords": ["CupGame", "CupBreaking", "CupBuilderGame", "Ballthrowgame", "Cup"], "long_description": "Welcome to Cup Clash VR!\nPrepare for an action-packed adventure in this thrilling virtual reality experience where precision, creativity, and strategy collide! \nCup Breaker challenges you to grab your tennis balls and shatter as many cup patterns as possible from a distance. Aim, throw, and feel the excitement as you knock down cups in a satisfying display of destruction! \nIn Cup Builder, test your skills by stacking and aligning cups to construct the tallest tower without it tumbling over. Follow the displayed pattern, strategize your moves, and rise to the challenge at your own pace. How high can you build your masterpiece? \nWith immersive gameplay, Cup Clash VR offers a unique blend of fast-paced action and thoughtful construction. Whether you\u2019re smashing or stacking, the fun never ends! ", "short_description": 
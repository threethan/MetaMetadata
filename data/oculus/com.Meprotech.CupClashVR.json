6af4sHEQvPaRWKxobPCZqCewXFz9FJELgwyv7xJAzD2mhg7N4pXzpHg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JlHj_aMI_uYxVXaEOJXZEDA2GoBAb0puokQanXUwEzg&oe=6A031FB3"}, {"file_name": "ss-4.png", "id": "1277845167363770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821702_1277845170697103_3419768359387623619_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utMob_9MkM4Q7kNvwEzk29g&_nc_oc=AdrfrX4pku_O4Cyb3PS9iTWA4hmTkiQw2eAHNxkmtCQ5mremn2SWeysGoqf64CYn9a0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4S2k4pkt7BEFBptYlGpKLLnXVIzf89W7RFeiVfKss57Q&oe=6A032BBC"}, {"file_name": "ss-2.png", "id": "1332266731706340", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822550_1332266735039673_8100009495787672824_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdQpAbx0AWcQ7kNvwENiEq9&_nc_oc=AdpotQs5m0LsLtYcVXhNqrE9a_VWZ3TL7ApDFIdTJbSyFF_Oup0d-6GSj1mD7IGIdvs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ilr5qeeQyidRyx3Vf_fpi0mcshxOrXqc_UKce3AdzAw&oe=6A0347BA"}, {"file_name": "ss-3.png", "id": "2556770804709411", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821115_2556770808042744_168867314432637241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3Nn2LuGA5IQ7kNvwF5Qyb_&_nc_oc=AdpFvs3NoieZo-HrobNWkDCsOtioII38lM-CiQ5R8am3H1Gb_G808n2sWfEkwOwaqrQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56WgXjOXhs84lHgBxtw5-vyM3CENl7xB6tIImpiOknmg&oe=6A033AE7"}, {"file_name": "ss-1.png", "id": "2028480447917184", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819356_2028480451250517_5504327197980301938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGk8IRgwePIQ7kNvwG481uw&_nc_oc=AdpGDW5tJeWu4rSUzRdOT509kW7ztZKaQb51SZyUj6-F3ui3Bem_9Df6mwMLjehAdxM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Lr7aPaDvWBOF1vDCDqEy9jEuJyS-l9PTC_HqOs0EtHQ&oe=6A033035"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cup Clash VR", "keywords": ["party", "cup", "ball", "casualgame", "minigame"], "long_description": "# Cup Clash VR: Smash or Stack\n\nThis virtual reality game combines precision, creativity, and strategy in a simple but engaging way.\n\n### Cup Breaker\nIn Cup Breaker, you use tennis balls to knock down cups from a distance. Aim carefully and throw to break as many cup patterns as possible. Every hit feels rewarding as you see the cups fall.\n\n### Cup Builder\nCup Builder tests your stacking skills. Follow a displayed pattern to build a tall tower of cups without letting it collapse. Think through each move and try to stack as high as you can.\n\n### Game Features\n- **Two Modes**: Cup Breaker for smashing cups, and Cup Builder for stacking.\n- **Simple Gameplay**: Focus on aiming and stacking without unnecessary distractions.\n- **Strategic Fun**: Take your time in building or enjoy quick, fast-paced cup smashing.\n\nCup Clash VR is a straightforward experience, letting you focus on the challenge of smashing or stacking cups.\n\n{1583804702345811}", "short_description": "\"Cup Clash VR\" is an action-packed virtual reality game where players engage in thrilling cup battles. Use strategy, quick reflexes and precision to stack, toss, and clash cups in various dynamic environments. Challenge yourself in this fast-paced, immersive experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/meprotech.in/cupclashvr/home", "developer_terms_of_service_url": null, "publisher_name": "MEPROTECH", "support_website_url": null, "website_url": "https://meprotech.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null,
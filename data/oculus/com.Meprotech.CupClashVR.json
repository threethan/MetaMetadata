MU2MeHAYJKayKi0JaiHQOwfHQjdBui0ruNZ3N-TQA&oe=69DA4133"}, {"file_name": "ss-4.png", "id": "1277845167363770", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821702_1277845170697103_3419768359387623619_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CvI6q-G5IYQ7kNvwHr0de1&_nc_oc=AdpU-GI0GyELx_UQWR4GtxrxB8rojoT0eGGYBpCTpKkfff_TxN2_JkZkgERC-wv3C1I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mUJ2BQM2n6x5G0_SAhm-bN7ev7_I5FjnJCih3lZtg2g&oe=69DA4D3C"}, {"file_name": "ss-2.png", "id": "1332266731706340", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822550_1332266735039673_8100009495787672824_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kosonh-g-J0Q7kNvwFlKK1d&_nc_oc=AdoNujeA98-298esnAKp8HzJFt8H1Z_5-4Kflz2lJ9V1LNohEqbwFYQANVIwL5Ark_Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-JWk2Gn7AU3_CmFuvvNYd88DQ6AB1xaxe4p1J6xigSQ&oe=69DA30FA"}, {"file_name": "ss-3.png", "id": "2556770804709411", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821115_2556770808042744_168867314432637241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17zfzMVta7UQ7kNvwFhUv5_&_nc_oc=AdrbslkHlX6DGhgC9FIhiqjC7dIQq3uIy-92WBrRgGEl6WLkSFI2CP55KNSBBwcKA2o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Nl1d4wZJMqqXL19H-vU5NFEg7M4Qo4xQiWEKBpSmR6A&oe=69DA5C67"}, {"file_name": "ss-1.png", "id": "2028480447917184", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819356_2028480451250517_5504327197980301938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yln2B8c0C9MQ7kNvwHzKnB6&_nc_oc=Adqcvp1FFpS9B2QYlRGjcTn9WArUMA5b1YD5AxxMHgMDXcpaxIRGQBXWkNK44mtN88s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RGZXFIkmTBXrnDDJoMs3_1mkZfsvOvNJV-j5KtXEf8Q&oe=69DA51B5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cup Clash VR", "keywords": ["party", "cup", "ball", "casualgame", "minigame"], "long_description": "# Cup Clash VR: Smash or Stack\n\nThis virtual reality game combines precision, creativity, and strategy in a simple but engaging way.\n\n### Cup Breaker\nIn Cup Breaker, you use tennis balls to knock down cups from a distance. Aim carefully and throw to break as many cup patterns as possible. Every hit feels rewarding as you see the cups fall.\n\n### Cup Builder\nCup Builder tests your stacking skills. Follow a displayed pattern to build a tall tower of cups without letting it collapse. Think through each move and try to stack as high as you can.\n\n### Game Features\n- **Two Modes**: Cup Breaker for smashing cups, and Cup Builder for stacking.\n- **Simple Gameplay**: Focus on aiming and stacking without unnecessary distractions.\n- **Strategic Fun**: Take your time in building or enjoy quick, fast-paced cup smashing.\n\nCup Clash VR is a straightforward experience, letting you focus on the challenge of smashing or stacking cups.\n\n{1583804702345811}", "short_description": "\"Cup Clash VR\" is an action-packed virtual reality game where players engage in thrilling cup battles. Use strategy, quick reflexes and precision to stack, toss, and clash cups in various dynamic environments. Challenge yourself in this fast-paced, immersive experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/meprotech.in/cupclashvr/home", "developer_terms_of_service_url": null, "publisher_name": "MEPROTECH", "support_website_url": null, "website_url": "https://meprotech.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices"
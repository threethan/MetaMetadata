r0Nofr1yXWncpGPMLFeagMABWXNr-qtWWXd6N2FgQ3fKGUod44tSg3Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4P6Evk8wCOsrJ8bVzCjLjAMGQSawsWzGMAooq-wKEXUA&oe=6A1594B3"}, {"file_name": "ss-4.png", "id": "1277845167363770", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821702_1277845170697103_3419768359387623619_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDwCk6CNZ0AQ7kNvwGjEbjI&_nc_oc=Adq-s6m7h5tn4ynyh1Kn1aGi86c1Ib7EvtRhHsWYVSui66nW-G49zzuhbFtVHY_ZZr8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56mVclPu4pn5sdDbbnjf5-W8iqk1MdCNXplKoPOauZFQ&oe=6A15A0BC"}, {"file_name": "ss-2.png", "id": "1332266731706340", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822550_1332266735039673_8100009495787672824_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RN3rYRaKhrYQ7kNvwF0aTwJ&_nc_oc=AdraP1DB2iYsewCUOTXrlP_jn-1jQMqrz45cIhk7-RltY61SBb9gQM8yplyji37MfGc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tanNHRUob8uuadQ6UWiEkhCqD5fpk8JmPrQYdyplgyA&oe=6A15BCBA"}, {"file_name": "ss-3.png", "id": "2556770804709411", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821115_2556770808042744_168867314432637241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-3RHVw-S-gQ7kNvwGoWx1E&_nc_oc=AdpEvDm_d4msC_iJrSmXactL-s8anSIugFoeqYfv0gaFTpax6BpnTc67hroJue--Z98&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7K9vXqUr5sgf0L9t3pc2T1N00eg7uQPtnJjVZWcVxItw&oe=6A15AFE7"}, {"file_name": "ss-1.png", "id": "2028480447917184", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491819356_2028480451250517_5504327197980301938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jaCB8xUCPMQ7kNvwG0GJXa&_nc_oc=Adp_YX5L22kd7jkBIdjO480jzZpzKZF-4_tLTK37PiwTKJXML0Ak1NkU0O6-o-Q3h-o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cXXC9ThGkRy08SjdOkCSp4sCIbYcqSaxbPBjImtlbQg&oe=6A15A535"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cup Clash VR", "keywords": ["party", "cup", "ball", "casualgame", "minigame"], "long_description": "# Cup Clash VR: Smash or Stack\n\nThis virtual reality game combines precision, creativity, and strategy in a simple but engaging way.\n\n### Cup Breaker\nIn Cup Breaker, you use tennis balls to knock down cups from a distance. Aim carefully and throw to break as many cup patterns as possible. Every hit feels rewarding as you see the cups fall.\n\n### Cup Builder\nCup Builder tests your stacking skills. Follow a displayed pattern to build a tall tower of cups without letting it collapse. Think through each move and try to stack as high as you can.\n\n### Game Features\n- **Two Modes**: Cup Breaker for smashing cups, and Cup Builder for stacking.\n- **Simple Gameplay**: Focus on aiming and stacking without unnecessary distractions.\n- **Strategic Fun**: Take your time in building or enjoy quick, fast-paced cup smashing.\n\nCup Clash VR is a straightforward experience, letting you focus on the challenge of smashing or stacking cups.\n\n{1583804702345811}", "short_description": "\"Cup Clash VR\" is an action-packed virtual reality game where players engage in thrilling cup battles. Use strategy, quick reflexes and precision to stack, toss, and clash cups in various dynamic environments. Challenge yourself in this fast-paced, immersive experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/meprotech.in/cupclashvr/home", "developer_terms_of_service_url": null, "publisher_name": "MEPROTECH", "support_website_url": null, "website_url": "https://meprotech.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null,
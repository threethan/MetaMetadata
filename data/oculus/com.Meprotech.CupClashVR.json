lwg6GyiholZqku_3JKwaiClWg33waSSln9iDZAtrMS3zhX_5IACLfns&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af07ZgInkdUOLciWd_-wX5SWq87DPF_EaSmTk2ZsQMMyNw&oe=69F49F33"}, {"file_name": "ss-4.png", "id": "1277845167363770", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821702_1277845170697103_3419768359387623619_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0E9xT7sPJLgQ7kNvwGdIRSs&_nc_oc=AdpHuyLiHdPAmashY2CrAdN2_Xwfa1NkmqS5jDF723ELk082FcNJkaednabd7zYH3do&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0MsSEJoSHHjOs1QqG4DhWw9ekDz2IZd0HsR42F0BnQmw&oe=69F4AB3C"}, {"file_name": "ss-2.png", "id": "1332266731706340", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822550_1332266735039673_8100009495787672824_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSeNTC3coe8Q7kNvwFUv5CE&_nc_oc=Ado3oONv6kHUFMBCOuO2bnE-MUQ_dfc10IBdWtPGaimf0k7fD1MLYGOwkj9shDjKfvY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ljYa3ZDwCfwP8GMcF9lzw5J9KkR0Y3_362wDdX1DHIg&oe=69F4C73A"}, {"file_name": "ss-3.png", "id": "2556770804709411", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821115_2556770808042744_168867314432637241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cv1jirW0JMQ7kNvwFDGQ3s&_nc_oc=AdpSc_K6wGrD41PiA5tkaJ7kds76f0P37S6o6twPhlDD2SWEUmyptxX3ejUd9BeBcnU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1_qS655TdIctwPcj51qR0aqHODLriMqcLdrUnp83G1ZA&oe=69F4BA67"}, {"file_name": "ss-1.png", "id": "2028480447917184", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819356_2028480451250517_5504327197980301938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pO58DVzAYggQ7kNvwFmmate&_nc_oc=AdoRXP-TLHcNqJHRDxmZ89_LVd4G1nO-_rAiiluP9VRoQ8gl-1srDQAFxvYvlYlotzQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1oOmJcjcqsXtbELeB4Fqnu2YcMAfRmEerLNHbt4wPjCQ&oe=69F4AFB5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cup Clash VR", "keywords": ["party", "cup", "ball", "casualgame", "minigame"], "long_description": "# Cup Clash VR: Smash or Stack\n\nThis virtual reality game combines precision, creativity, and strategy in a simple but engaging way.\n\n### Cup Breaker\nIn Cup Breaker, you use tennis balls to knock down cups from a distance. Aim carefully and throw to break as many cup patterns as possible. Every hit feels rewarding as you see the cups fall.\n\n### Cup Builder\nCup Builder tests your stacking skills. Follow a displayed pattern to build a tall tower of cups without letting it collapse. Think through each move and try to stack as high as you can.\n\n### Game Features\n- **Two Modes**: Cup Breaker for smashing cups, and Cup Builder for stacking.\n- **Simple Gameplay**: Focus on aiming and stacking without unnecessary distractions.\n- **Strategic Fun**: Take your time in building or enjoy quick, fast-paced cup smashing.\n\nCup Clash VR is a straightforward experience, letting you focus on the challenge of smashing or stacking cups.\n\n{1583804702345811}", "short_description": "\"Cup Clash VR\" is an action-packed virtual reality game where players engage in thrilling cup battles. Use strategy, quick reflexes and precision to stack, toss, and clash cups in various dynamic environments. Challenge yourself in this fast-paced, immersive experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/meprotech.in/cupclashvr/home", "developer_terms_of_service_url": null, "publisher_name": "MEPROTECH", "support_website_url": null, "website_url": "https://meprotech.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null,
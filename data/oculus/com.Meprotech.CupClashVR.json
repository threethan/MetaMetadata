of6g24S-QpciRHoa79OulDiK89RrlopRmNJABaC4Q&oe=69D64CB3"}, {"file_name": "ss-4.png", "id": "1277845167363770", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821702_1277845170697103_3419768359387623619_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Addw1SiqMokQ7kNvwHnV0Cw&_nc_oc=AdobYcad_JH6tYYKV9wcIB-DmzVPIlosUZ9V0RGy4Dcl2LC4TTWhiz2hP20lDp1HkwU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fdpNFyXyar7Tz3Rl2y3xKBUvG1QIX_hAVGnxgufGSMQ&oe=69D658BC"}, {"file_name": "ss-2.png", "id": "1332266731706340", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822550_1332266735039673_8100009495787672824_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4TtUD8oXloQ7kNvwHKpEfw&_nc_oc=AdpFUKLwMiaOL2VGBWAl8qpqyz9q8iD_1pli4OnuLAiJZ2hDdUc8gVMlOOx0hZbpdmE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Aihyq8szvg7eMnkbnN1o_qdvU5LG2wWMjJas-BzUFfg&oe=69D63C7A"}, {"file_name": "ss-3.png", "id": "2556770804709411", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821115_2556770808042744_168867314432637241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsCbu3vrubMQ7kNvwHb5Rkz&_nc_oc=AdpltAyEgCiUXqfYFlYWZW3lw26z0rJ0m1Q33bVyMqO5QnGj7ebf6EdL_qN6Wt0HSU8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GaD-cLROZ5woJ9ujQR76JmmhpnJmNSVCVUyd-tCATHA&oe=69D667E7"}, {"file_name": "ss-1.png", "id": "2028480447917184", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_2028480451250517_5504327197980301938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NW4av8bEu4Q7kNvwFi4ez2&_nc_oc=AdoYDOwyfFLdDU2UYINAHN0Yi-yG_E-DUxJ3T2gLfwcA6SzGeCKtTFX6XW730gxD1FE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gPCQ7kMy4RFb_D43_TKmYw8dGOOHOrKzVaC3Mf4RZeg&oe=69D65D35"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cup Clash VR", "keywords": ["party", "cup", "ball", "casualgame", "minigame"], "long_description": "# Cup Clash VR: Smash or Stack\n\nThis virtual reality game combines precision, creativity, and strategy in a simple but engaging way.\n\n### Cup Breaker\nIn Cup Breaker, you use tennis balls to knock down cups from a distance. Aim carefully and throw to break as many cup patterns as possible. Every hit feels rewarding as you see the cups fall.\n\n### Cup Builder\nCup Builder tests your stacking skills. Follow a displayed pattern to build a tall tower of cups without letting it collapse. Think through each move and try to stack as high as you can.\n\n### Game Features\n- **Two Modes**: Cup Breaker for smashing cups, and Cup Builder for stacking.\n- **Simple Gameplay**: Focus on aiming and stacking without unnecessary distractions.\n- **Strategic Fun**: Take your time in building or enjoy quick, fast-paced cup smashing.\n\nCup Clash VR is a straightforward experience, letting you focus on the challenge of smashing or stacking cups.\n\n{1583804702345811}", "short_description": "\"Cup Clash VR\" is an action-packed virtual reality game where players engage in thrilling cup battles. Use strategy, quick reflexes and precision to stack, toss, and clash cups in various dynamic environments. Challenge yourself in this fast-paced, immersive experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/meprotech.in/cupclashvr/home", "developer_terms_of_service_url": null, "publisher_name": "MEPROTECH", "support_website_url": null, "website_url": "https://meprotech.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices"
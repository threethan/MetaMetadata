map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FguhvGRdcgoQ7kNvwEQmU9O&_nc_oc=AdrGGzce6Ot0YhyFyDNoANMeqH3cGnE7YOnTIjxdYqVIljkAANdY-_Bl5LVyHm8yi-I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWPnF-uUBh852-mpV3a6msk_LzoOTk5Wj_XXudDJdQ_1w&oe=6B0EF19E"}, {"file_name": "OrthoGait_Screenshot_04_2560x1440.png", "id": "1194565372899064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604375581_1194565376232397_8057307713064306143_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZWS_8klCv0Q7kNvwEBtauX&_nc_oc=AdoS5rQvU7unuulFSBuJrubNNIVOicgxOL1owMazFEMFApMkrqMsK6ZGkbuRQdZeSbE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVYndJ40MLdQfqiEU7rAnWrQsLjIepR3w4Pk-cFOczDIQ&oe=6B0F049D"}, {"file_name": "OrthoGait_Screenshot_03_2560x1440.png", "id": "2638308483287444", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/613086565_2638308489954110_1218497612173033888_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMMSN5T8XlQQ7kNvwGj4LKA&_nc_oc=Adqss8mMY8WBuafY4k3wMyD7RRTXCihWAWlPD5rPaZPynClYUsE8pSBapbCVEBu1hlU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXFkehYo-_JWBvL9Y84WVZuJz9Z-sZJTTOKgXI2R9TY2A&oe=6B0F0CEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "604370996_1127667486782376_8807787372494056311_n.png", "id": "1563864019115412", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/618722728_1563864022448745_4454297205607406646_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBm0qaytYwwQ7kNvwHNK0lz&_nc_oc=Ado1LPGvDWvnDj6riVHhjh74L1BCGmr7E8QnTWPtzhZAxECcXy0gktVIQ0Rz9fyTA1k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXLQvX0z8JvaJs4Ev1BWDDzm7tzuNEx83L6q12c219iAA&oe=6B0EF98D"}, "display_name": "OrthoGait Clean", "keywords": ["gait"], "long_description": "OrthoGait Clean is a movement-study and documentation workspace for Meta Quest.\n\nAnalyze a selected image, use supported outward-facing cameras for body or face landmark detection, review saved sessions, compare repeated assessments and export PDF or CSV reports. Bundled MediaPipe Lite, Full and Heavy body models are available.\n\nThe native XR workspace presents an illustrative skeleton, tracking status and a separate measurement window. Move each window with hand or Touch-controller interactions, or use its labelled position buttons, Face me and Bring back. Browse the 98-entry movement catalog by domain or search. Missing or stale results are identified rather than presented as current measurements.\n\nGuided protocols, hip-arthroplasty follow-up records and descriptive face-geometry review are included. Face outputs use relative model dimensions and angles, not measured millimetres. Spatial placement and depth are estimates, not validated room-space measurements.\n\nLive camera capture requires compatible headset hardware, Horizon OS and permission. The headset observes a person in front of it, not the wearer's own face. Image and saved-record workflows remain available without live capture.\n\nProcessing and records stay on the device unless you choose to export or share. No in-app subscription or account is required.\n\nAn educational and professional documentation aid. It does not diagnose, recommend treatment or provide surgical navigation. Independently verify every result.", "short_description": "Study movement and gait with local body-pose analysis, saved sessions and reports. View recognized geometry and live results in movable XR windows. Live capture requires a supported Quest camera and permission. Measurements are estimates."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.orthopractis.com/privacy", "developer_terms_of_service_url": "https://www.orthopractis.com/terms-of-use", "publisher_name": "ORTHOPRACTIS.COM SINGLE MEMBER P.C.", "support_website_url": "https://www.orthopractis.com/contact-us-feedback", "website_url": "https://www.orthopractis.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1470796592775410"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604275479_1462550829301129_4663717898502272859_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qa-wxrxO8GYQ7kNvwHDXa2k&_nc_oc=Adpfi7s1o6WrFOa4rkhGMPk26OSlENaCUngncR_wljEeKuQN3YPtjnvoxMx5xN_9H54&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWdYJ7otEwAmr2N6w-nq34ZiAOwECH807_4YOkZlZAjBQ&oe=6B0EED06"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "OrthoGait Clean", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1795460100, "lastRevision": {"nodes": [{"id": "1470796619442074", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1470796589442077", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1178150288089118"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "icon.png", "id": "2623885248045306", "image_t
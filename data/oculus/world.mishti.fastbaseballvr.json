OfwXQQ7kNvwEpYEd_&_nc_oc=Adqdgp28rwfmM6irEUGM5LpCFKRnOuNWCaD8Vc-Ve27W9U-9tMixLlwoUzW9nc6uiGo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSdXhrjuWtwkJVfZXEkIRjgH-I4oC0aPUAEWD9sGDe7jQ&oe=6B0C748B"}, {"file_name": "10_impact_miss.png", "id": "1444113294280522", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622195_1444113297613855_6359764685023836153_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whsE5a24Q5MQ7kNvwGH5nmk&_nc_oc=AdotQsbqsarzyidpqoMqyyj7IXe3Zj01JW9Bzzz4SEJ1GOuRZYpEnU_HHS9Yy2eOCRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQbM6TzZaB46Mv57HVkW2cgY64MaSvDuo_7u1fqEbFtog&oe=6B0C6C82"}, {"file_name": "09_flight_plate.png", "id": "29079585744972158", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623131_29079585748305491_5858362719600807317_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXKDKZ7ygBIQ7kNvwHNryBG&_nc_oc=AdrjlMgYebY10gRAluYPtiiIKfm50lQMilG-uP0LxgMcPpu8mPe2bPAJFKb3hEGmyRI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQZdeAacuTwIzblw2-PEOWkMQ1ptH7dOmfmAfoR3FVDPg&oe=6B0C4F7B"}, {"file_name": "02_runup_mound.png", "id": "1018062511253824", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593776279_1018062514587157_6771872510320777247_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kRjU8ZohVsQ7kNvwGXATir&_nc_oc=AdrYLLcENy6ZeP9wzl0hWKpcejXf0iXuOnoaHZIuXL5tMD3sgmF_Jqsmn0MRzItftGI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSBReNLmBsrabkz-XkN2I9Hme97LcZB4JhSqG5biZsbIA&oe=6B0C7AFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1362631099049992", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622153_1362631102383325_845190154687543206_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0iaO6YVm7cQ7kNvwEGQMGl&_nc_oc=Adom06uPDbZ6-h1twI4FKUMo-V98PnQEcJvsemjxGKioc5vlvhW3eGMKFwbd6ZRzPVU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSW7KT-vCbbdkIaOuix0k7cz161LZz03Lb85ijXxJPM7w&oe=6B0C5C8E"}, "display_name": "Fast Baseball VR", "keywords": ["baseball", "batting", "homerun", "sports", "arcade"], "long_description": "You are in the batter's box. The pitcher sets sixty feet six inches away, comes set, and throws \u2014 a four-seam at the top of the zone, a slider off the plate, a curveball you were already out in front of.\n\n**Fast Baseball VR is about the half-second between release and contact, and nothing else.** No baserunning, no fielding, no roster management. Tap the bat and he throws again.\n\n**Six ways to play**\n\u2022 **Free Play** \u2014 bat until three strikes. A foul is never the third.\n\u2022 **Heat** \u2014 starts at 40 mph and gets faster every single pitch.\n\u2022 **Home Run Rush** \u2014 home runs only. Everything else is an out.\n\u2022 **Pure Contact** \u2014 three lives. A foul or a miss costs one.\n\u2022 **Twelve Pitches** \u2014 no outs, always a score. The one you cannot lose.\n\u2022 **The Chase** \u2014 reach a target before the pitches run out.\n\n**Nine skies.** Classic, Orbital, Dune Sunset, Thunderdome, Skyfields, Aurora Ice, Ashfall, Lantern Dusk and Prism Arena \u2014 one open field, nine worlds.\n\n**Built on real physics.** Every pitch is solved, not animated: real speed, real movement, a real strike zone, and your swing read at frame rate. Pick a park at 250, 375 or 400 feet and find out how far you can carry one.\n\n**Made to fit you.** Assists if you want them and none if you do not \u2014 barrel size, power, ball size, a landing marker, a visible strike zone. One controller, either hand, seated or standing.\n\nThe soundtrack is the developer's own song.\n\nNot affiliated with or endorsed by any baseball league, team, or player.\n", "short_description": "Step into the box, read the pitch, and swing for the fence. Six modes, nine worlds, three park sizes, and a swing read from your own hand. No baserunning, no fielding, no menus between you and the next pitch \u2014 just the half-second between release and contact.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://games.mishti.world/privacy", "developer_terms_of_service_url": "https://games.mishti.world/terms", "publisher_name": "MishtiWorld", "support_website_url": "https://games.mishti.world/support", "website_url": "https://games.mishti.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1318579758008453"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628092_1739687010626510_3514025380066793490_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIiLPTs-lzEQ7kNvwEaHKvA&_nc_oc=AdoAHafstihqk1W8tnn52m-9C2rwA4yYQuhvLF5KSTKBYvLvT5Iy-_kCqHDa7ZkFPRk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQTQ5I_YjwHycLEHd1X9H17XfvdFcfTvgTAFPuk3e2H_g&oe=6B0C794C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fast Baseball VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Arcade", "id": "1592192974313489"}, {
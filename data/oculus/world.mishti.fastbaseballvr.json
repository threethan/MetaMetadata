J38_EQ7kNvwEMoYQg&_nc_oc=AdqXVYrj3-cKjr8pv8GzWm84EDGpX5_Rlq4e35VBQI4U4hmbHAqKw77bdkidiVobVVI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX2FPJux8SC7q_QHHFZhXOtrn7aW-_XbF9H-728I30Zuw&oe=6B10690B"}, {"file_name": "10_impact_miss.png", "id": "1444113294280522", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622195_1444113297613855_6359764685023836153_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kT53dCeVIBIQ7kNvwGduPEU&_nc_oc=AdpMhA4PZELEPMz3HKB_fWloIGNzVE25alvB70LhAGjJb9N8OeUTeBLD3FmcKXxZAyo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUevQJb_L5nDzvmP1VDsKC3r_RDxKgPQQydH94pJxRPqA&oe=6B106102"}, {"file_name": "09_flight_plate.png", "id": "29079585744972158", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623131_29079585748305491_5858362719600807317_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NqYptnv6VmQQ7kNvwFuZ-Vu&_nc_oc=AdqX4RZLIdKmv8jlj2LQ9DduJQD_5x0-NVkTFte-f3YHeTcO-9FFezkKmltrpx83LMI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV7Z7MjWUUgQ_AEuj15GIuTd0MrAGbK3Q8IcBEqKHBVlw&oe=6B1043FB"}, {"file_name": "02_runup_mound.png", "id": "1018062511253824", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593776279_1018062514587157_6771872510320777247_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzWR9YrWmOsQ7kNvwHBF_OV&_nc_oc=AdpA6kNSwhVZQDpb9ImnUybsBY8lyBVPGIVMG2L2b0_ffjgvRPdFsD4_8wE4UHwTVQM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWKufyHBMyIuziSJWTzhh8AHR7Iy4vNO0fmKVhClq9C1Q&oe=6B10373A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1362631099049992", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622153_1362631102383325_845190154687543206_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9DuPpy1ZGIQ7kNvwFpJDsz&_nc_oc=Ado98xPpnsFyZwrQT4eoSiD0HnR9r2I0fjeQn0nFHKXyN9gdc3NxVeCQaZ3K6G5i9aI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUrP4jSs94B80o4cRcjTjOMMiNNLNyILfjMAhw6pcXmlw&oe=6B10510E"}, "display_name": "Fast Baseball VR", "keywords": ["baseball", "batting", "homerun", "sports", "arcade"], "long_description": "You are in the batter's box. The pitcher sets sixty feet six inches away, comes set, and throws \u2014 a four-seam at the top of the zone, a slider off the plate, a curveball you were already out in front of.\n\n**Fast Baseball VR is about the half-second between release and contact, and nothing else.** No baserunning, no fielding, no roster management. Tap the bat and he throws again.\n\n**Six ways to play**\n\u2022 **Free Play** \u2014 bat until three strikes. A foul is never the third.\n\u2022 **Heat** \u2014 starts at 40 mph and gets faster every single pitch.\n\u2022 **Home Run Rush** \u2014 home runs only. Everything else is an out.\n\u2022 **Pure Contact** \u2014 three lives. A foul or a miss costs one.\n\u2022 **Twelve Pitches** \u2014 no outs, always a score. The one you cannot lose.\n\u2022 **The Chase** \u2014 reach a target before the pitches run out.\n\n**Nine skies.** Classic, Orbital, Dune Sunset, Thunderdome, Skyfields, Aurora Ice, Ashfall, Lantern Dusk and Prism Arena \u2014 one open field, nine worlds.\n\n**Built on real physics.** Every pitch is solved, not animated: real speed, real movement, a real strike zone, and your swing read at frame rate. Pick a park at 250, 375 or 400 feet and find out how far you can carry one.\n\n**Made to fit you.** Assists if you want them and none if you do not \u2014 barrel size, power, ball size, a landing marker, a visible strike zone. One controller, either hand, seated or standing.\n\nThe soundtrack is the developer's own song.\n\nNot affiliated with or endorsed by any baseball league, team, or player.\n", "short_description": "Step into the box, read the pitch, and swing for the fence. Six modes, nine worlds, three park sizes, and a swing read from your own hand. No baserunning, no fielding, no menus between you and the next pitch \u2014 just the half-second between release and contact.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://games.mishti.world/privacy", "developer_terms_of_service_url": "https://games.mishti.world/terms", "publisher_name": "MishtiWorld", "support_website_url": "https://games.mishti.world/support", "website_url": "https://games.mishti.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1318579758008453"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628092_1739687010626510_3514025380066793490_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OlCf7iCbQaIQ7kNvwGcGt36&_nc_oc=Adrj28k8Uqhw6bUUQY7KTWBgS5aw5VwWrQ8eQkWOY0PQpssCcystEX6jF8BCbNX8U1I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXDcgZHqvQtWtppqhArYt4Q64ijGz3Tx5rxogbSHXwpQA&oe=6B10358C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fast Baseball VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Arcade", "id": "1592192974313489"}, {
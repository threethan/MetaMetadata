-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNt9iJmYhVe60dWzLdEs3m8rgdA0VIYFN8KxvlkQcNYw&oe=6AF9E183"}, {"file_name": "icon-512x512.png", "id": "1079857234673389", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499628893_1079857238006722_2831208416637979847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-JDxTaDVeUQ7kNvwGc1Fcy&_nc_oc=AdqzL6WiT7FiaeJ74zJVVO5KchCjDvcMm1d6MXeWWQtVRH_s9x42aqnhaO6VOUwoL9Q&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbOS3U7bvCzOFq7am2esnazXiXLZ2-VDbDGk7wmMzY8Q&oe=6AF9BA29"}, {"file_name": "logo-01-horizontal-ball.png", "id": "1046864981718899", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/593784242_1046864985052232_3187573690809789129_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_K0gkHAShggQ7kNvwF4zMqw&_nc_oc=AdrJ5mu-271d82vmGYWxAG05yjNcoC0Qv1oI_hTg7TZ7ydw55hIq69lOzLcXq4hT8SE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGrm5SJaIkxDlxMtNuPqhdOGuIXasfV95ikm-ZDaPrDA&oe=6AF9B562"}]}, "id": "1418025766383900", "locale": "en_US", "screenshots": [{"file_name": "04_strike_bat.png", "id": "4558286997824660", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/593902063_4558287001157993_8050201674058693930_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7x0nTg68e8Q7kNvwHZA4us&_nc_oc=AdrvnSfzGlnX0pD-vFV1Tt3lZ5Rhiq0-AIQWSrOQbRDSXyOZ2XhrK0mrg0EXMMtOlpE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_xO8ADUwxY4izPIsXicUZCYb9h3OiuXDmYiD7MuT7lA&oe=6AF9E415"}, {"file_name": "05_impact_lowside.png", "id": "1054246360985398", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499628909_1054246367652064_5381745924572609053_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4LJA-GFhD8Q7kNvwHpwQ84&_nc_oc=AdpFnvJcfyFDX_XWOlTjr2Ds3ULJw8YZCI27HyHnClDOJRnz-Fu37_4X3nrCyS4hbUY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5wA4pprIDGJamBguXnPdiTDeItiN5ifY5qjHKNtGw0w&oe=6AF9C74B"}, {"file_name": "10_impact_miss.png", "id": "1444113294280522", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499622195_1444113297613855_6359764685023836153_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPg-8HKutNAQ7kNvwFYyhax&_nc_oc=AdobFC2hBLfAF5NCbMCBx2t_EzFUWVS4RhfYMdxQoBKBcx4OxRcVq5bhfiGV9vfsUZg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQz_1i-AUxEzeWB3fDdlm2uC_fkEJ9M8OGkoInax5DvWQ&oe=6AF9BF42"}, {"file_name": "09_flight_plate.png", "id": "29079585744972158", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623131_29079585748305491_5858362719600807317_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUHdE6EKS0cQ7kNvwGoeZT8&_nc_oc=AdpwcIzTvXRsFsZZVjM45d2vI4Dd0vzJjBKfP7v1aY-gAFuCDtRq81nbRPd6RN5I19E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTapALPWbXM7RPSPlDUkqb3LYKibbUlzqpnFQr5gYn6WA&oe=6AF9DA7B"}, {"file_name": "02_runup_mound.png", "id": "1018062511253824", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/593776279_1018062514587157_6771872510320777247_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNVptg2REkwQ7kNvwGVMoTQ&_nc_oc=Adq39aphxoQBdMJCywgPfEnxGLpvOormxDGFf3anzxXOTbe-5qnQHXNNWK_rv9EuJ4I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDVQrvB7B6nmpvH2LpE2Ios4DKYshl_dKehVk2IiU89w&oe=6AF9CDBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1362631099049992", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499622153_1362631102383325_845190154687543206_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymoO_NV0a5EQ7kNvwE8eLlv&_nc_oc=AdrsOSqcixfb2rhk3e1bwFCghmHIp9RrKb9qIGu1Lh9nyN_mAnPjDwgwoHik0CoI5ek&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ4_KDZZjJwLqRoloaZUdS2DA-mrRukN4egCpMsYn8bg&oe=6AF9E78E"}, "display_name": "Fast Baseball VR", "keywords": ["baseball", "batting", "homerun", "sports", "arcade"], "long_description": "You are in the batter's box. The pitcher sets sixty feet six inches away, comes set, and throws \u2014 a four-seam at the top of the zone, a slider off the plate, a curveball you were already out in front of.\n\n**Fast Baseball VR is about the half-second between release and contact, and nothing else.** No baserunning, no fielding, no roster management. Tap the bat and he throws again.\n\n**Six ways to play**\n\u2022 **Free Play** \u2014 bat until three strikes. A foul is never the third.\n\u2022 **Heat** \u2014 starts at 40 mph and gets faster every single pitch.\n\u2022 **Home Run Rush** \u2014 home runs only. Everything else is an out.\n\u2022 **Pure Contact** \u2014 three lives. A foul or a miss costs one.\n\u2022 **Twelve Pitches** \u2014 no outs, always a score. The one you cannot lose.\n\u2022 **The Chase** \u2014 reach a target before the pitches run out.\n\n**Nine skies.** Classic, Orbital, Dune Sunset, Thunderdome, Skyfields, Aurora Ice, Ashfall, Lantern Dusk and Prism Arena \u2014 one open field, nine worlds.\n\n**Built on real physics.** Every pitch is solved, not animated: real speed, real movement, a real strike zone, and your swing read at frame rate. Pick a park at 250, 375 or 400 feet and find out how far you can carry one.\n\n**Made to fit you.** Assists if you want them and none if you do not \u2014 barrel size, power, ball size, a landing marker, a visible strike zone. One controller, either hand, seated or standing.\n\nThe soundtrack is the developer's own song.\n\nNot affiliated with or endorsed by any baseball league, team, or player.\n", "short_description": "Step into the box, read the pitch, and swing for the fence. Six modes, nine worlds, three park sizes, and a swing read from your own hand. No baserunning, no fielding, no menus between you and the next pitch \u2014 just the half-second between release and contact.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://games.mishti.world/privacy", "developer_terms_of_service_url": "htt
-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQU-kvnRKFcNs3zf-L_K-B9W_TSUCrv6q9Pyk4LBAtOVw&oe=6AF5ED03"}, {"file_name": "icon-512x512.png", "id": "1079857234673389", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628893_1079857238006722_2831208416637979847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xK602mN6fcUQ7kNvwEYDzYI&_nc_oc=AdraT2-HJLm270AudHCjGMxsQa2uC5uwgoFRo7B8nceRGXWfhJr2OZsK878FLBG8Io4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJapl9qT4zS_y0OQgjRC98rJRVpGjfE4xMsNu65eO7kA&oe=6AF5C5A9"}, {"file_name": "logo-01-horizontal-ball.png", "id": "1046864981718899", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593784242_1046864985052232_3187573690809789129_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAfhZ2uY_wIQ7kNvwFcK_AM&_nc_oc=Adqx1IPHUNe5PDaI2GvHwfwqyU3GASvuFcPlpSSMq40gdhZxn1NA-kvfqCxCaJsIvzM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfUaG1AhabPCHrGGbqx17INeXvfHrLkkKOPgHxzcNmrg&oe=6AF5C0E2"}]}, "id": "1418025766383900", "locale": "en_US", "screenshots": [{"file_name": "04_strike_bat.png", "id": "4558286997824660", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593902063_4558287001157993_8050201674058693930_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzUa_YxQWmUQ7kNvwHDfutE&_nc_oc=AdqIDtBuOmqNEdVDTiq2-GGli4iCOf1CKIY8HJGBhZda0bC8hkLjvNCm23iyDugHCAo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmImoKfXAjrGddqNNJxw_UJuWfLn_LMsfqQEgXz_Yxiw&oe=6AF5EF95"}, {"file_name": "05_impact_lowside.png", "id": "1054246360985398", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628909_1054246367652064_5381745924572609053_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_w3go8E9RUQ7kNvwGZJyHe&_nc_oc=AdpvIouI-1t_xkPSnidFcfrg10MZILmcqsoeI05zGmE50JFW1uFAKMgQRCMtTL4maAo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5xA_9EiDyLPMgQQs75hlvqp1DCkTOBdcUn9rhiirW6Q&oe=6AF5D2CB"}, {"file_name": "10_impact_miss.png", "id": "1444113294280522", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622195_1444113297613855_6359764685023836153_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxcdnj-ujjkQ7kNvwGq0xCk&_nc_oc=AdpjiuV2qwl71hib3M412yccfFZQp8weztkW6xgo5WkGVYjJXENdmXcUhuG3oVB7TfE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRr81a17fTV5WZcIJmhQpBZDhAzOlxQRuzP_NRzV2QYqA&oe=6AF5CAC2"}, {"file_name": "09_flight_plate.png", "id": "29079585744972158", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623131_29079585748305491_5858362719600807317_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czXbnUyljW8Q7kNvwF6QwNA&_nc_oc=AdoTJcj9UIeM2Ken6TrdKphdvZegCYxzH6dLxzKiwBFL97gCvO3wSM5G9q-czaUBXGQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtikQDbwZ3cp7xC8J_25Aex36sx2dsEmdAMWzDv1uTew&oe=6AF5E5FB"}, {"file_name": "02_runup_mound.png", "id": "1018062511253824", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593776279_1018062514587157_6771872510320777247_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7js2A3GGm48Q7kNvwEQukEZ&_nc_oc=Adpx6MXpIstocw45ktjNzuRxZvJEh-iAoLwHBiMUSi7BTCyAB7fAL_SyoS9HqGX54Ls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkWbsVBcwIuVDJIt2VMeVknOjVKYzcnOdyt3ELXMHsDw&oe=6AF5D93A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1362631099049992", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622153_1362631102383325_845190154687543206_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbVrS_bv9HYQ7kNvwG5HqmZ&_nc_oc=AdpSrS7tVWP1QTeLO1d_HTStDxe3iPkiUkmf7CqdhqlBKk7vXRR2FRCPzKUVp4fNPNo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYiSkcrNmCEmJMUqTgGJIeLk-dp2IXG9vc01PuJ3pDGQ&oe=6AF5F30E"}, "display_name": "Fast Baseball VR", "keywords": ["baseball", "batting", "homerun", "sports", "arcade"], "long_description": "You are in the batter's box. The pitcher sets sixty feet six inches away, comes set, and throws \u2014 a four-seam at the top of the zone, a slider off the plate, a curveball you were already out in front of.\n\n**Fast Baseball VR is about the half-second between release and contact, and nothing else.** No baserunning, no fielding, no roster management. Tap the bat and he throws again.\n\n**Six ways to play**\n\u2022 **Free Play** \u2014 bat until three strikes. A foul is never the third.\n\u2022 **Heat** \u2014 starts at 40 mph and gets faster every single pitch.\n\u2022 **Home Run Rush** \u2014 home runs only. Everything else is an out.\n\u2022 **Pure Contact** \u2014 three lives. A foul or a miss costs one.\n\u2022 **Twelve Pitches** \u2014 no outs, always a score. The one you cannot lose.\n\u2022 **The Chase** \u2014 reach a target before the pitches run out.\n\n**Nine skies.** Classic, Orbital, Dune Sunset, Thunderdome, Skyfields, Aurora Ice, Ashfall, Lantern Dusk and Prism Arena \u2014 one open field, nine worlds.\n\n**Built on real physics.** Every pitch is solved, not animated: real speed, real movement, a real strike zone, and your swing read at frame rate. Pick a park at 250, 375 or 400 feet and find out how far you can carry one.\n\n**Made to fit you.** Assists if you want them and none if you do not \u2014 barrel size, power, ball size, a landing marker, a visible strike zone. One controller, either hand, seated or standing.\n\nThe soundtrack is the developer's own song.\n\nNot affiliated with or endorsed by any baseball league, team, or player.\n", "short_description": "Step into the box, read the pitch, and swing for the fence. Six modes, nine worlds, three park sizes, and a swing read from your own hand. No baserunning, no fielding, no menus between you and the next pitch \u2014 just the half-second between release and contact.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://games.mishti.world/privacy", "developer_terms_of_service_url": "htt
-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj4g4giZYfIW8U-F0Awla1WMLQTH-Yt5eRIbr3TkqUag&oe=6AF89003"}, {"file_name": "icon-512x512.png", "id": "1079857234673389", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628893_1079857238006722_2831208416637979847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-JDxTaDVeUQ7kNvwHwRore&_nc_oc=AdrpCPbm267mW5brNsrMEWvSJAApOGf0EIrLufPTkXrPVyCzfncZX83J9wyraSBcLk0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZMZ89Xg3ki--F_W9m4dVTEc2IDbeyOyJjNWn0NkOfrw&oe=6AF8A0E9"}, {"file_name": "logo-01-horizontal-ball.png", "id": "1046864981718899", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593784242_1046864985052232_3187573690809789129_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_K0gkHAShggQ7kNvwE8N_al&_nc_oc=Adow-DgcWjm_LEvFOUHP9RL4vaVfB0_vAqzSqgIHQtHpSwkD5pdCaTFCloa0iSI_Csg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs8pT-dXUzXLkeHr3hozv_SX4sudduNgdc2dlCl8jUcQ&oe=6AF89C22"}]}, "id": "1418025766383900", "locale": "en_US", "screenshots": [{"file_name": "04_strike_bat.png", "id": "4558286997824660", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593902063_4558287001157993_8050201674058693930_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzUa_YxQWmUQ7kNvwEUIsPK&_nc_oc=AdpZ2eb961F6aQ7S9gfczZwVlVbW9ThsmjBPwwGwF1dIxGG8qWtuSqd5Rc5I9nrxNRw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZAxx2zM2XGlxH8fPecAibKkN1r8KGmqNrRWWtvEKxOA&oe=6AF89295"}, {"file_name": "05_impact_lowside.png", "id": "1054246360985398", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628909_1054246367652064_5381745924572609053_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4LJA-GFhD8Q7kNvwHCMyIt&_nc_oc=Adq17tHb6hWARg2dhDTj_06CYTpKDvhArbEy-RkkFDBwfxgGmLso0stGsSC75oIU9vg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBWGw6aR9zgaivdByseDsDwMgeGyVVOGT0I5Dksh7DHw&oe=6AF875CB"}, {"file_name": "10_impact_miss.png", "id": "1444113294280522", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622195_1444113297613855_6359764685023836153_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxcdnj-ujjkQ7kNvwFXBTUp&_nc_oc=Adqjx7_iN_VJO_Dv6O-ieIXNuiMRWiesPjgTK_zRv6fn4JTdx7krj4uiIvqF0V9j2AY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaYG6SCVl6h-dyiA-ELhPTDGibo9IF8jtS4-gRDm6m2g&oe=6AF8A602"}, {"file_name": "09_flight_plate.png", "id": "29079585744972158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623131_29079585748305491_5858362719600807317_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUHdE6EKS0cQ7kNvwEUk54A&_nc_oc=AdrTSMeXj7wgK_gL0-lYBrHeHGzuM2jptH2p7WnrOSh5civc33uVcfRkbe-q5lycu4o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFxePv9mnwLFnsWReQ_BXs_5DU85v-4fvuleDpcbcY0A&oe=6AF888FB"}, {"file_name": "02_runup_mound.png", "id": "1018062511253824", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593776279_1018062514587157_6771872510320777247_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNVptg2REkwQ7kNvwG2eOla&_nc_oc=AdrGLlUPr0lfyHYpRPonio1MN1Uw32mOexf7dO91yVEDZdU-CMNuMml20vd0h8MBIvs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3FJAtVIuUA_wnVUE6kCW1QOCS0Wmqp7ilrDJVMmZuFg&oe=6AF87C3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1362631099049992", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622153_1362631102383325_845190154687543206_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymoO_NV0a5EQ7kNvwEfwMmX&_nc_oc=AdpCgpAnggpoWLWyIYbudqopm0IbJM3kTHcLxoN2foypMZPIx-DVHsulQYsMTfJbXLQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhoIlny_Gq6jMgrUGpRFG25Aa11adVgdRgaIQkvu0eaA&oe=6AF8960E"}, "display_name": "Fast Baseball VR", "keywords": ["baseball", "batting", "homerun", "sports", "arcade"], "long_description": "You are in the batter's box. The pitcher sets sixty feet six inches away, comes set, and throws \u2014 a four-seam at the top of the zone, a slider off the plate, a curveball you were already out in front of.\n\n**Fast Baseball VR is about the half-second between release and contact, and nothing else.** No baserunning, no fielding, no roster management. Tap the bat and he throws again.\n\n**Six ways to play**\n\u2022 **Free Play** \u2014 bat until three strikes. A foul is never the third.\n\u2022 **Heat** \u2014 starts at 40 mph and gets faster every single pitch.\n\u2022 **Home Run Rush** \u2014 home runs only. Everything else is an out.\n\u2022 **Pure Contact** \u2014 three lives. A foul or a miss costs one.\n\u2022 **Twelve Pitches** \u2014 no outs, always a score. The one you cannot lose.\n\u2022 **The Chase** \u2014 reach a target before the pitches run out.\n\n**Nine skies.** Classic, Orbital, Dune Sunset, Thunderdome, Skyfields, Aurora Ice, Ashfall, Lantern Dusk and Prism Arena \u2014 one open field, nine worlds.\n\n**Built on real physics.** Every pitch is solved, not animated: real speed, real movement, a real strike zone, and your swing read at frame rate. Pick a park at 250, 375 or 400 feet and find out how far you can carry one.\n\n**Made to fit you.** Assists if you want them and none if you do not \u2014 barrel size, power, ball size, a landing marker, a visible strike zone. One controller, either hand, seated or standing.\n\nThe soundtrack is the developer's own song.\n\nNot affiliated with or endorsed by any baseball league, team, or player.\n", "short_description": "Step into the box, read the pitch, and swing for the fence. Six modes, nine worlds, three park sizes, and a swing read from your own hand. No baserunning, no fielding, no menus between you and the next pitch \u2014 just the half-second between release and contact.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://games.mishti.world/privacy", "developer_terms_of_service_url": "htt
2.oculuscdn.com/v/t64.5771-25/499622195_1444113297613855_6359764685023836153_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPg-8HKutNAQ7kNvwFYyhax&_nc_oc=AdobFC2hBLfAF5NCbMCBx2t_EzFUWVS4RhfYMdxQoBKBcx4OxRcVq5bhfiGV9vfsUZg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQz_1i-AUxEzeWB3fDdlm2uC_fkEJ9M8OGkoInax5DvWQ&oe=6AF9BF42"}, {"file_name": "09_flight_plate.png", "id": "29079585744972158", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623131_29079585748305491_5858362719600807317_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUHdE6EKS0cQ7kNvwGoeZT8&_nc_oc=AdpwcIzTvXRsFsZZVjM45d2vI4Dd0vzJjBKfP7v1aY-gAFuCDtRq81nbRPd6RN5I19E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTapALPWbXM7RPSPlDUkqb3LYKibbUlzqpnFQr5gYn6WA&oe=6AF9DA7B"}, {"file_name": "02_runup_mound.png", "id": "1018062511253824", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/593776279_1018062514587157_6771872510320777247_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNVptg2REkwQ7kNvwGVMoTQ&_nc_oc=Adq39aphxoQBdMJCywgPfEnxGLpvOormxDGFf3anzxXOTbe-5qnQHXNNWK_rv9EuJ4I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDVQrvB7B6nmpvH2LpE2Ios4DKYshl_dKehVk2IiU89w&oe=6AF9CDBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1362631099049992", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499622153_1362631102383325_845190154687543206_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymoO_NV0a5EQ7kNvwE8eLlv&_nc_oc=AdrsOSqcixfb2rhk3e1bwFCghmHIp9RrKb9qIGu1Lh9nyN_mAnPjDwgwoHik0CoI5ek&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ4_KDZZjJwLqRoloaZUdS2DA-mrRukN4egCpMsYn8bg&oe=6AF9E78E"}, "display_name": "Fast Baseball VR", "keywords": ["baseball", "batting", "homerun", "sports", "arcade"], "long_description": "You are in the batter's box. The pitcher sets sixty feet six inches away, comes set, and throws \u2014 a four-seam at the top of the zone, a slider off the plate, a curveball you were already out in front of.\n\n**Fast Baseball VR is about the half-second between release and contact, and nothing else.** No baserunning, no fielding, no roster management. Tap the bat and he throws again.\n\n**Six ways to play**\n\u2022 **Free Play** \u2014 bat until three strikes. A foul is never the third.\n\u2022 **Heat** \u2014 starts at 40 mph and gets faster every single pitch.\n\u2022 **Home Run Rush** \u2014 home runs only. Everything else is an out.\n\u2022 **Pure Contact** \u2014 three lives. A foul or a miss costs one.\n\u2022 **Twelve Pitches** \u2014 no outs, always a score. The one you cannot lose.\n\u2022 **The Chase** \u2014 reach a target before the pitches run out.\n\n**Nine skies.** Classic, Orbital, Dune Sunset, Thunderdome, Skyfields, Aurora Ice, Ashfall, Lantern Dusk and Prism Arena \u2014 one open field, nine worlds.\n\n**Built on real physics.** Every pitch is solved, not animated: real speed, real movement, a real strike zone, and your swing read at frame rate. Pick a park at 250, 375 or 400 feet and find out how far you can carry one.\n\n**Made to fit you.** Assists if you want them and none if you do not \u2014 barrel size, power, ball size, a landing marker, a visible strike zone. One controller, either hand, seated or standing.\n\nThe soundtrack is the developer's own song.\n\nNot affiliated with or endorsed by any baseball league, team, or player.\n", "short_description": "Step into the box, read the pitch, and swing for the fence. Six modes, nine worlds, three park sizes, and a swing read from your own hand. No baserunning, no fielding, no menus between you and the next pitch \u2014 just the half-second between release and contact.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://games.mishti.world/privacy", "developer_terms_of_service_url": "https://games.mishti.world/terms", "publisher_name": "MishtiWorld", "support_website_url": "https://games.mishti.world
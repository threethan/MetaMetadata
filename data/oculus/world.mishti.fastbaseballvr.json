-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBcGcK-MQfSueaT4Y9lSwFxPpNzZOK1n0jkbHSyoHa4g&oe=6AF73E83"}, {"file_name": "icon-512x512.png", "id": "1079857234673389", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628893_1079857238006722_2831208416637979847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xK602mN6fcUQ7kNvwEAeycp&_nc_oc=AdqjlOkoWKv8sXMUI3metW0kBDDSMizvSwVEdzRD8-S-emDZ9IguaK8ndnRUh_DThBU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt0G9MJYjtPOtrEuq-hPgPuZKmwzL47Mgqfxk5shD7Ig&oe=6AF71729"}, {"file_name": "logo-01-horizontal-ball.png", "id": "1046864981718899", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593784242_1046864985052232_3187573690809789129_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAfhZ2uY_wIQ7kNvwF2zSnk&_nc_oc=AdprAbMvGB1Qg_NVloPlKXzhwphcUnzciy19tR7tTvEH7bBDs5HlG-ClIUfXh2rEkvk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_LWoI5hIhxQTjGL-Pyk5n6Jx191v0dtp65dEsCUhOWg&oe=6AF74AA2"}]}, "id": "1418025766383900", "locale": "en_US", "screenshots": [{"file_name": "04_strike_bat.png", "id": "4558286997824660", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593902063_4558287001157993_8050201674058693930_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzUa_YxQWmUQ7kNvwFNk6bF&_nc_oc=AdpXtTwsgbl9VQr7FhWDKgJBM4V-RjQ20Kz0yQOJLEpjcymBphGKadBiWYbQtsaHRIU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4n08ercTudMwCsOJkcgWCFEoJHQwq6GJnTxKjmTQZdg&oe=6AF74115"}, {"file_name": "05_impact_lowside.png", "id": "1054246360985398", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628909_1054246367652064_5381745924572609053_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_w3go8E9RUQ7kNvwHzjusR&_nc_oc=AdrNt6ey4_ZmsvyA9WO1uNtnqWq9UALPDgSL73TZvPJnBE_kZcdxe6SVleR4g0_mRuM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGqCpsbLXeD8OundU3X9tzdCFg-vofKTeDQySUchxmmQ&oe=6AF7244B"}, {"file_name": "10_impact_miss.png", "id": "1444113294280522", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622195_1444113297613855_6359764685023836153_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxcdnj-ujjkQ7kNvwGwUJl7&_nc_oc=AdrHcFBI_prTF0u6CUDLk5bfYPtQJIzQIhc2EDC0ATVam_kQPoklVrctLg6bblBoRIE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy6QT6bTa1Je1iq6zVTBYE_DijcoSFT1wXshzOJGYq7g&oe=6AF71C42"}, {"file_name": "09_flight_plate.png", "id": "29079585744972158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623131_29079585748305491_5858362719600807317_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUHdE6EKS0cQ7kNvwGyn23L&_nc_oc=Adq_dfZkhCVJbnmj6mfN4qDLGgCahX-cYSa6L54dbcxufpJlA5Rx1l5BC5jHc0Is1uE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJUS855vocZoHol7KKVTnkoNQ5z54wFIXPelFIbP_jCA&oe=6AF7377B"}, {"file_name": "02_runup_mound.png", "id": "1018062511253824", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593776279_1018062514587157_6771872510320777247_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNVptg2REkwQ7kNvwHfVJxx&_nc_oc=AdqiyxhzUpTyLUAggvf3Xm-b4bQC4f7Zus-kUaIW8PHKz66y5WErKHdIGnRyRJJD5xg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3GwNMR8RdCTTPUnPcyHYbEX5kyrlRGQjuAwwf0Sgu7w&oe=6AF72ABA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1362631099049992", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622153_1362631102383325_845190154687543206_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymoO_NV0a5EQ7kNvwHqyrSF&_nc_oc=AdrqjJr-VLJdVxAWcgS5g9cUNvFvIUFjo7eDmesrGYe9x7Un_DpFxefGNgKZHmDjxv8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShlbvy2xTuI69cOZmb5MotJRebFhrDySzm4xq6C2Rg2w&oe=6AF7448E"}, "display_name": "Fast Baseball VR", "keywords": ["baseball", "batting", "homerun", "sports", "arcade"], "long_description": "You are in the batter's box. The pitcher sets sixty feet six inches away, comes set, and throws \u2014 a four-seam at the top of the zone, a slider off the plate, a curveball you were already out in front of.\n\n**Fast Baseball VR is about the half-second between release and contact, and nothing else.** No baserunning, no fielding, no roster management. Tap the bat and he throws again.\n\n**Six ways to play**\n\u2022 **Free Play** \u2014 bat until three strikes. A foul is never the third.\n\u2022 **Heat** \u2014 starts at 40 mph and gets faster every single pitch.\n\u2022 **Home Run Rush** \u2014 home runs only. Everything else is an out.\n\u2022 **Pure Contact** \u2014 three lives. A foul or a miss costs one.\n\u2022 **Twelve Pitches** \u2014 no outs, always a score. The one you cannot lose.\n\u2022 **The Chase** \u2014 reach a target before the pitches run out.\n\n**Nine skies.** Classic, Orbital, Dune Sunset, Thunderdome, Skyfields, Aurora Ice, Ashfall, Lantern Dusk and Prism Arena \u2014 one open field, nine worlds.\n\n**Built on real physics.** Every pitch is solved, not animated: real speed, real movement, a real strike zone, and your swing read at frame rate. Pick a park at 250, 375 or 400 feet and find out how far you can carry one.\n\n**Made to fit you.** Assists if you want them and none if you do not \u2014 barrel size, power, ball size, a landing marker, a visible strike zone. One controller, either hand, seated or standing.\n\nThe soundtrack is the developer's own song.\n\nNot affiliated with or endorsed by any baseball league, team, or player.\n", "short_description": "Step into the box, read the pitch, and swing for the fence. Six modes, nine worlds, three park sizes, and a swing read from your own hand. No baserunning, no fielding, no menus between you and the next pitch \u2014 just the half-second between release and contact.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://games.mishti.world/privacy", "developer_terms_of_service_url": "htt
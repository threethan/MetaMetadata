30_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmwGbmFmknkQ7kNvwGDPGkP&_nc_oc=Adq3YrR6JxD4QaoDj8OzwZHsyN07WHYaH7r-F4cklpJO0fnanEh29osDBM3O3RZBXyM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSR5QRqe1mhldjWRSjo9DlFkGGRBppfp6Kqng32iFcMzw&oe=6AFDD895"}, {"file_name": "05_impact_lowside.png", "id": "1054246360985398", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628909_1054246367652064_5381745924572609053_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSNU1uQFLw4Q7kNvwEVkQRC&_nc_oc=Ado9dgwgbT8ZSx8cgfkVyTrpyLeWDBASho891KLL079woAnW3YWZ2TsDNCj6YIoxCuc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwcRQYvJAex5mYDoouo9tLagtYTtlpiaODVzVr9lOV0g&oe=6AFDBBCB"}, {"file_name": "10_impact_miss.png", "id": "1444113294280522", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622195_1444113297613855_6359764685023836153_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Thb-NaoyOwQQ7kNvwFNmzNj&_nc_oc=AdofXfTKFX3TcatdxCPfcwqSu563FPvz4gboTHZsQfRBT3KAzxn2fNdlKS-0i9CzSp0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNbDvbDH5JcAf95iL3xZ9mbsZrFi7lYspFlknpGYTukQ&oe=6AFDB3C2"}, {"file_name": "09_flight_plate.png", "id": "29079585744972158", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623131_29079585748305491_5858362719600807317_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EihqCo5dPMQ7kNvwGkTxzx&_nc_oc=Adpusi1TbFcrdlaQ6WCmUrCK2PDUVlKstHc7E5pHYSf553lhAi83lLAfYElugJhlYms&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5qylMQeSzYlpZaZZ_rxZVn9Ad7lZoYU0zXeShOhVvoA&oe=6AFDCEFB"}, {"file_name": "02_runup_mound.png", "id": "1018062511253824", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593776279_1018062514587157_6771872510320777247_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dRInBG2hS8Q7kNvwEL22XB&_nc_oc=AdprgP-cIiSwTLFdF1duB8xuoD8RppLHEtWNYGieArAz2zObNYJ-F7q2eDXlL_t8vGk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaZJe9yJf29Vsh4S6UAd1QqneTHH8Q3jPwyK30QcuqAA&oe=6AFDC23A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1362631099049992", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622153_1362631102383325_845190154687543206_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7moZh8WCSqkQ7kNvwGngGUi&_nc_oc=AdpSXCGDQMjDQrcY_OeJqoMY37QTnE9aMld07z0M9QpMi8vBQSHVEdUJ6IYDSp_6ODk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI2DrNMztDlgUKKAT8MYvSG9stVHHOVv9xu-H4YNN4vA&oe=6AFDDC0E"}, "display_name": "Fast Baseball VR", "keywords": ["baseball", "batting", "homerun", "sports", "arcade"], "long_description": "You are in the batter's box. The pitcher sets sixty feet six inches away, comes set, and throws \u2014 a four-seam at the top of the zone, a slider off the plate, a curveball you were already out in front of.\n\n**Fast Baseball VR is about the half-second between release and contact, and nothing else.** No baserunning, no fielding, no roster management. Tap the bat and he throws again.\n\n**Six ways to play**\n\u2022 **Free Play** \u2014 bat until three strikes. A foul is never the third.\n\u2022 **Heat** \u2014 starts at 40 mph and gets faster every single pitch.\n\u2022 **Home Run Rush** \u2014 home runs only. Everything else is an out.\n\u2022 **Pure Contact** \u2014 three lives. A foul or a miss costs one.\n\u2022 **Twelve Pitches** \u2014 no outs, always a score. The one you cannot lose.\n\u2022 **The Chase** \u2014 reach a target before the pitches run out.\n\n**Nine skies.** Classic, Orbital, Dune Sunset, Thunderdome, Skyfields, Aurora Ice, Ashfall, Lantern Dusk and Prism Arena \u2014 one open field, nine worlds.\n\n**Built on real physics.** Every pitch is solved, not animated: real speed, real movement, a real strike zone, and your swing read at frame rate. Pick a park at 250, 375 or 400 feet and find out how far you can carry one.\n\n**Made to fit you.** Assists if you want them and none if you do not \u2014 barrel size, power, ball size, a landing marker, a visible strike zone. One controller, either hand, seated or standing.\n\nThe soundtrack is the developer's own song.\n\nNot affiliated with or endorsed by any baseball league, team, or player.\n", "short_description": "Step into the box, read the pitch, and swing for the fence. Six modes, nine worlds, three park sizes, and a swing read from your own hand. No baserunning, no fielding, no menus between you and the next pitch \u2014 just the half-second between release and contact.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://games.mishti.world/privacy", "developer_terms_of_service_url": "https://games.mishti.world/terms", "publisher_name": "MishtiWorld", "support_website_url": "https://games.mishti.world/support", "website_url": "https://games.mishti.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1318579758008453"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1078852801626555"}]}, "baseline_offer": {"id": "1078852801626555"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time"
-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbJp9-bPs0TRcWw1eUkWKYJh0X2uQyVBiQuk3zU4d8LA&oe=6AF1F883"}, {"file_name": "icon-512x512.png", "id": "1079857234673389", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628893_1079857238006722_2831208416637979847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gbochDkOOoQ7kNvwGWzJMw&_nc_oc=Ado4nQwI5BNfDrxnaQlnCEkTRjvjkLlmY5LLDwAQjJL8q3KDezM-REATmQMsKDS8vRs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5msjGq56d58lmbfcmhdY__jMHc0VgrIXNyskwlZqfIw&oe=6AF20969"}, {"file_name": "logo-01-horizontal-ball.png", "id": "1046864981718899", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593784242_1046864985052232_3187573690809789129_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1N_CqZXP-AQ7kNvwH9yNhU&_nc_oc=Ado-d0qqygNpc5n1HTH-f-3kn3TeMT_8yCjvCRw7EOLZbiBMptFDxlW4vgogDExjwr4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-YcCTx9kGaAYSDTcyxLisPFSSvMAzpg_nyex-kjkdXA&oe=6AF204A2"}]}, "id": "1418025766383900", "locale": "en_US", "screenshots": [{"file_name": "04_strike_bat.png", "id": "4558286997824660", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593902063_4558287001157993_8050201674058693930_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrDTSEC7vPYQ7kNvwFwq5AZ&_nc_oc=AdpvqlDmSqriLVS7mSBO3_ib06xi1B4WIUJIiEHEXygCjnkElAEJW73OPKWOP71AFoM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIF2AkN1X5TlUE8lri34QULmZl6KrX4kK6ZpDX7ydVPg&oe=6AF1FB15"}, {"file_name": "05_impact_lowside.png", "id": "1054246360985398", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628909_1054246367652064_5381745924572609053_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMOfQD3H9LEQ7kNvwHgKCQU&_nc_oc=AdqSA1T7AP92o2WV5Y2DU-covcgnhYDI-C-wp8SXnFeBLr1SVIb7_Vpn0iyO3J0NRno&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ78oR4IaZw1Yv-xeMBizbaYRT0s0lksnp87-r3CQHd8Q&oe=6AF1DE4B"}, {"file_name": "10_impact_miss.png", "id": "1444113294280522", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622195_1444113297613855_6359764685023836153_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDRuqfMFADQQ7kNvwFIXF45&_nc_oc=Adrth1OwpqS9Y1zdytjqyQ8v8MOvTYiOo4MXACr6F_2ikVss44KD7RTChAxpJuGO7oc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt9wrCoDAlZy1MCiGG_Bc5oyQe2s38Kx7EzgUi1lCifA&oe=6AF1D642"}, {"file_name": "09_flight_plate.png", "id": "29079585744972158", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623131_29079585748305491_5858362719600807317_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxcfJl8-UJ8Q7kNvwE5gemg&_nc_oc=Adqf7JeHVcsUfHmb_c4LsiHrT1gx3jf5k4v8jjOOSarO5-9djBzeB3vDUQyznTvJQaA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZ2XZTq6rGgpYBIfTyoJVBb7I3rSPFEmdMLTNjFvAW1Q&oe=6AF1F17B"}, {"file_name": "02_runup_mound.png", "id": "1018062511253824", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593776279_1018062514587157_6771872510320777247_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBmTu8paEJQQ7kNvwGeuN69&_nc_oc=AdrOnjTayi7UVtmEdBTaXk0Vx1K-yr0jLF9efdRBNvuAVAa3oBpvqukt5cLs9x9_3ZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSDwe8ckC0EsYz4uEfMslQh81hAYRpDMp00Ggmi47Jrg&oe=6AF1E4BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1362631099049992", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622153_1362631102383325_845190154687543206_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVfw1XyyoEMQ7kNvwHs8bbu&_nc_oc=AdoaDJ2oMM_07ZGZDKEGtFxzVABQosBHggbFma_jkVQSVnMj_cGugFWi5dm-6Jw_f_o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7WF4-N9YJ9cEGIxumiQen18OzjP0amsatR1Pw9c2QTA&oe=6AF1FE8E"}, "display_name": "Fast Baseball VR", "keywords": ["baseball", "batting", "homerun", "sports", "arcade"], "long_description": "You are in the batter's box. The pitcher sets sixty feet six inches away, comes set, and throws \u2014 a four-seam at the top of the zone, a slider off the plate, a curveball you were already out in front of.\n\n**Fast Baseball VR is about the half-second between release and contact, and nothing else.** No baserunning, no fielding, no roster management. Tap the bat and he throws again.\n\n**Six ways to play**\n\u2022 **Free Play** \u2014 bat until three strikes. A foul is never the third.\n\u2022 **Heat** \u2014 starts at 40 mph and gets faster every single pitch.\n\u2022 **Home Run Rush** \u2014 home runs only. Everything else is an out.\n\u2022 **Pure Contact** \u2014 three lives. A foul or a miss costs one.\n\u2022 **Twelve Pitches** \u2014 no outs, always a score. The one you cannot lose.\n\u2022 **The Chase** \u2014 reach a target before the pitches run out.\n\n**Nine skies.** Classic, Orbital, Dune Sunset, Thunderdome, Skyfields, Aurora Ice, Ashfall, Lantern Dusk and Prism Arena \u2014 one open field, nine worlds.\n\n**Built on real physics.** Every pitch is solved, not animated: real speed, real movement, a real strike zone, and your swing read at frame rate. Pick a park at 250, 375 or 400 feet and find out how far you can carry one.\n\n**Made to fit you.** Assists if you want them and none if you do not \u2014 barrel size, power, ball size, a landing marker, a visible strike zone. One controller, either hand, seated or standing.\n\nThe soundtrack is the developer's own song.\n\nNot affiliated with or endorsed by any baseball league, team, or player.\n", "short_description": "Step into the box, read the pitch, and swing for the fence. Six modes, nine worlds, three park sizes, and a swing read from your own hand. No baserunning, no fielding, no menus between you and the next pitch \u2014 just the half-second between release and contact.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://games.mishti.world/privacy", "developer_terms_of_service_url": "htt
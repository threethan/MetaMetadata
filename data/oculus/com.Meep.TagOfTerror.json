ucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsZrOk7la3UQ7kNvwGZXdTa&_nc_oc=AdrZL5HoVFPqjX206sZxmo2R8zl2obrspHGLCTHhKPNFPW5Mlze_yOaMo9vMHlNV-aU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyloG70k2PoviC3AKbfySAnejkIpfsjGTxKevn2iJfvg&oe=6AFB46FB"}, {"file_name": "SampleScene_Custom..._05.10.2026_20-32-45.png", "id": "1114592641249092", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/789889603_1114592644582425_4683224522887291709_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7y6HjA7jAoQ7kNvwEFjf-s&_nc_oc=AdoeeA2PUZx6nkFLtoP_soPC8J5RhqHkeH6A4iaVxyAseKgDnhaJ8ZPB_KDMX7lPCOo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdqYKsey1ALDbNEXBB4ffAMGTjoO8iLVvTTjPwe3brGA&oe=6AFB20CA"}, {"file_name": "SampleScene_Custom..._05.10.2026_20-33-48.png", "id": "2293108837922192", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/673658581_2293108841255525_146548161772533350_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyxTbYBfMYcQ7kNvwGXM-YN&_nc_oc=Adrn9XPN4TKNjt7eNZzg_r68_ErR7BtmkrDh95tN6B4Wa-6fgMSvkDsIvLo_vbeGd0w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-mK21jk9jiB9zFQAO70Vi3Kn_LaKtGdb90iosWqu1ZA&oe=6AFB28F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tag Of Terror", "keywords": ["Ghosts", "Horror"], "long_description": "You play as a Monke in a strange universe where countless ghosts are hunting you.\n\nYour goal is simple: survive.\n\nEach ghost brings a new challenge, becoming harder and more unpredictable as you progress. Learn their behaviors, find ways to escape them, and do whatever it takes to stay alive.\n\nBut there is more hiding within this world.\n\nExplore mysterious locations, discover hidden areas, uncover strange clues, and investigate secrets scattered throughout the game. Some ghosts may be connected to mysteries that haven't been solved yet.\n\nAnd you won't be solving them alone.\n\nThe community plays a major role in uncovering the truth. Share discoveries, test theories, investigate strange encounters, and work together to find solutions to the questions surrounding each ghost.\n\nSome answers may be hidden in plain sight.\n\nSome ghosts may be hiding something.\n\nAnd some mysteries may require the entire community to solve.\n\nExplore. Survive. Investigate.\n\nThe ghosts are waiting.\n\nWill you find the answers before they find you?", "short_description": "You play as a Monke in a universe where a large number of ghosts are out to get you. Your goal is survival, with each ghost being harder to escape than the last. Along the way, you begin to uncover strange mysteries, hidden areas. Certain ghosts appear tied to specific secrets waiting to be discovered. How will you survive?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/tag-of-terrorvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Time Level", "support_website_url": null, "website_url": "https://sites.google.com/view/tag-of-terrorvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1475905795599255"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/673751957_1079312104725807_4851219658060870917_n.pn
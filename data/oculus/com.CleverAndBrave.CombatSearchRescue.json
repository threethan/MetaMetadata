content-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WaLkn-EKIys6JvRMHCIaFgVzgG6VOtiTR1ONd-lQ47A&oe=6A01EF23"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3XVW8MRTagQ7kNvwFxahoC&_nc_oc=AdoqqohTNlvPCIxbrHveK1QM6MG6FRsX5Uaz4QkMuddherTkRkZk0bekc_Grlx7bujo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-SWp7GiGA_XWVMv211tM4tZ8G2xOKw8BpDvoYV2AFlw&oe=6A01CA39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92igl2okGhAQ7kNvwGaEp7S&_nc_oc=AdrjQp-7Gpyn03j4VNjpmvepqwai-Dm_BoEjcUU0B-7-bxzMVwCG_weX1bQZ5sqiAuw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SevhDkD4_B2niXO82lGDFuqpp1I8liMuBfma-MvYqGg&oe=6A01CA04"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
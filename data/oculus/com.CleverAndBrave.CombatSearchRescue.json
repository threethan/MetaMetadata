&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1KY0RLhB-kQ7kNvwFCT844&_nc_oc=AdqylEiSQjZ8PVW2QpUB3YEUxpv8tbpUHDQlLtDoU0kz-it8KJdx5Ds32gfjcH6yVZw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8RqJm05vdONXGJ-WmTKqg7SBc3e2BjMINk6Wb_ed0Yg&oe=6AFC7F79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZP0uSd9kVp8Q7kNvwF-iFto&_nc_oc=AdrN_nZfpMYAIl0rw-NsDyTE5FYi2c9PPPtMNaIxVMZDFYA7dYIGErO-MTv2Yus-WBA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4rrKXPjT-T1cFeJqG-VYvfIFN9jStnSqVGpji6RG8mQ&oe=6AFC7F44"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://combatsearchrescue.com/privacy_policy.php", "developer_terms_of_service_url": null, "publisher_name": "Clever and Brave", "support_website_url": null, "website_url": "https://combatsearchrescue.com/", "category": null, "comfort_rating": "COMFORTABLE_F
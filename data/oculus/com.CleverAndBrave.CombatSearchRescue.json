content-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCsuCSOSy-jrq-84uScJY6-u_EJopVjSQn3RICLcav4A&oe=6ACBA4A3"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USfSKGj86jMQ7kNvwF6tzrQ&_nc_oc=AdpTYVpNqDy8gDO6Kl-BwqNbuCAyIsw2uL2jgVakY7bFPIiFvbxGAPk9_Mij46pgdgo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_fNoOzO4lM6S1k9dgWm67w9rFB5VzeZMf2PozyJQGCA&oe=6ACBB7F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJGQ7bn0eMgQ7kNvwF2C8j9&_nc_oc=AdqiXJ1YkHctmXe0i35uVpRRjNQz-0NbloGA5FMucjp8URism0VdyLRvgVt_-5C0HAM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0eQJ5oXE4yaRtFFkgkjuJ7bTVuSK2Pjkzb_kIrJ_7PQ&oe=6ACBB7C4"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
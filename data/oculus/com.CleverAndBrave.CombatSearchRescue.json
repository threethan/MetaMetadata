20f&oh=00_AQTDuzPXYO5IJ75uvmbuCapZjtmtuyM0CpH-vyW_YIhA3g&oe=6B07225C"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_3.png", "id": "789318210674013", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312376_789318214007346_5534937032544403868_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hxcBFHCPNYQ7kNvwEr8F-x&_nc_oc=AdqzRVWwTAP_rnAb1gfk2mp04IJgHID9xbGxwYlVVfoISmyzAPey2CDakK6feuCL_y8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQiij6mEtfLOb2Vr_erlay93shOrleUWZ3mReq2EY6Qg&oe=6B070749"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_4.png", "id": "1722230288492475", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827063_1722230291825808_8322606282782413843_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2LManX0g5oQ7kNvwHXYvNH&_nc_oc=Adrb1LyXtOEOOJT7mHedFU_eSp_J3rR7_ZRgQjnQihHMaskGmxsp0C8qTIQbL5IwCas&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnYM8LyCE9S6R4xBOr47_n1mQuAiqgCOzD1Ih-Y4dGRw&oe=6B06F823"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdf1hi7PFQkQ7kNvwFg5wUH&_nc_oc=AdojmRt3jgs2VTloUSwFeD9TKJUEWtRpFJB0I-XhIYnnRmF1zjYyM1kJPYj8vu3o5uU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxpEBNOINkrppPMR5FpkInS3sd2b267oI-HtQ8-zN5ag&oe=6B070B79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iM4Ossa5iYQ7kNvwExtu_q&_nc_oc=AdqG8wjVAUkRPlXDNKxlvGWcOSt0-ZVrHVNfixTq4BvGSQnDoUcnyJ3F337px-RH3Wo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7QgvizVtdXFRnMT9hhKqA6Jru2ku5IlBzyWtjd9UpQA&oe=6B070B44"}, "display_name": "Combat Search Rescue", "keywords": ["Arcade", "Shooter", "Retro", "Scifi", "Space"], "long_description": "Inspired by arcade shoot 'em ups of the 1980s, Combat Search Rescue places you inside a retro space adventure.\n\nLaunch from the mothership and pilot a shuttle through dangerous asteroid fields, drifting cargo, space mines, automated defence systems and hostile drones. Battle through increasingly hazardous missions, rescue stranded survivors, and return them safely.\n\nEach rescue reveals another piece of a larger story, with survivors telling a different version of events than your radio orders. As missions continue and loyalties are tested, unsettling questions arise. Are you protecting innocent people from a dangerous enemy, or helping those in power maintain control?\n\nDesigned for comfortable seated VR play, Combat Search Rescue delivers arcade-inspired action from a unique perspective. Surrounded by drifting wreckage, asteroid fields and enemy defences, the gameplay stays true to its side-scrolling roots while immersing you directly in the action.\n\n\n-  Classic side-scrolling shoot 'em up gameplay reimagined for VR\n- Guide your shuttle through asteroid fields, mines, drones and automated defences\n- Rescue survivors and uncover a hidden conspiracy\n- Master dual-weapon combat using lasers and bombs\n- Collect temporary power-ups including rapid-fire and triple-shot weapons\n- Battle your way to a climactic final confrontation\n- Designed for comfortable seated play using standard Meta Quest controls\n\nEvery rescue brings you closer to the truth.\n\n{1136799412220909}", "short_description": "Rescue survivors. Uncover the truth.\n\nBattle asteroids, mines and hostile drones in a side-scrolling VR space adventure."}]}, "developer_name": null, "developer_
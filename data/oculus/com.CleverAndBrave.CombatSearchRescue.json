content-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3R3VI0Mf1TfkB1ekPWOeE3rdWXyOzoIAgt2P0sgD9MA&oe=6A9ADD23"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwUZjYBj8kQQ7kNvwE5rhVS&_nc_oc=AdoPX3BzWpi_vzeBBJQssCwWiREXeOGl0ecbajlNDhD7kdJlxXLm_EnSUDKqDDXwgUQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLa1B6czDjlK1wpujfaLoPQw4KjUCoONlYpNEBgX_VMkg&oe=6A9AF079"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Tu8TgcZCSUQ7kNvwFhBp1t&_nc_oc=AdrU0mqJarn48qFAEDx1FQKgIiP6XMwnhVgRWkpbZ3asb1f6FkDxUK_G6kYKpOh8d6s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgA1n-pzAXfRWRFjALpYfGvbjcxFWdbbJ17eT-H44GgA&oe=6A9AF044"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
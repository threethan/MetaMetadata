content-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-h0hePqCiPSusF-d8V_lhBX1VlIUCkdXAc6GG67Bv2Q&oe=69E36463"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmUTJdetTnYQ7kNvwHcwebs&_nc_oc=Adpw9ftkpbXaeaCu6DEI4dBejLc8MG_xNt_BfB1zoAhj7tyq12a9JqfupHKAaWUqO44&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XZ0xuaHgqDf3DGPHOwYs9nRGPQxB4act5h6_7J8z6sg&oe=69E377B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSKG6OjqLOUQ7kNvwGN8j_W&_nc_oc=AdpiJJIiLLctF9TV79_Mu0mE-8FEw5q_s0Ln6qA976D5gJUpmxjLNmnd_2ZsKji3ylM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0--t1DTw2Nc4Kl7JO6r0sb-O34730bSgJAqhGRXFEoiA&oe=69E37784"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
om&_nc_ss=7f20f&oh=00_Af0jq_DNv8q7AbYe-WamFmsmV0255xf9X1nLVh56tXcdwQ&oe=69F1E4E3"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqZlO1E857MQ7kNvwG9SCy8&_nc_oc=AdqvJHJc5T-v6-Ibx-9uS3TcYqP9oI_EzT5DCvsJumR2zXpP8l8ITkG1IrGwsir79G4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af20K4G7KU3_CRz5bEeTsF2H7DVHEnHKbiy6-t2dfEn3cQ&oe=69F1F839"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23cSKhoE8MwQ7kNvwGxPc_a&_nc_oc=AdqPbJPHzWOUOcyE58Udwsru0DW1retKb8y2NOlVeL-vFW2hxadOWdvH_0N3fLN2Dow&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0HEwvM1Rxk3L0T-UC4RANylnZMsFAIDLHnjkBz4eqKCg&oe=69F1F804"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}, "developer_name": null, "developer_pr
20f&oh=00_AQQEIL3BD5JAN3IVD8xx4o7wf26K6forA0vO4xxjM3tnqg&oe=6AFF011C"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_3.png", "id": "789318210674013", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312376_789318214007346_5534937032544403868_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2-t0_HCCjEQ7kNvwF3OaJs&_nc_oc=Adr-Lub_UmfolLiC2g283CsXavKeX4ywkjaBN0Ly7xJ6xD0Ww8MnXRhE9kCeD_hPpoU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR04yM4a47DEvfNlu_MDrgkS8uLbwUzY98xRTynYVQgkg&oe=6AFF1E49"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_4.png", "id": "1722230288492475", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827063_1722230291825808_8322606282782413843_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5-Z4TGinjsQ7kNvwFxXUAM&_nc_oc=AdotuwDr-9locOmxLziNv0nMrhUTlovziW-rHqeTg8XxPoLXzonCHxuZKARGS91tHbk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTahs-AM4iRWNX4U8iz_OcD-pGfT24pdOLBratx7X2cVA&oe=6AFF0F23"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVx9ELZAC0IQ7kNvwFJveQJ&_nc_oc=Adr5QLTHfD19gVhiYdwdsXy5qEsZ6GJ04Ye8r0iSsSdu-_a8ouvH8T8wKR9-1LDxypw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPeAGj8sWnsjt5qy6WMg9UWsSsP-QhFHohQiCUOnfI4w&oe=6AFF2279"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47dG8RWvDF8Q7kNvwFXe9TV&_nc_oc=Adp3vUCj0-V5Q_j_V7TV_pwXq8QCGzxcHTlJIXLJPpPkiOqNNyl-6EYufXR5BLP8vPs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2Ss0CpT8D4SVb5magLter5V-a9D0eWtZgK1j3iuI7Uw&oe=6AFF2244"}, "display_name": "Combat Search Rescue", "keywords": ["Arcade", "Shooter", "Retro", "Scifi", "Space"], "long_description": "Inspired by arcade shoot 'em ups of the 1980s, Combat Search Rescue places you inside a retro space adventure.\n\nLaunch from the mothership and pilot a shuttle through dangerous asteroid fields, drifting cargo, space mines, automated defence systems and hostile drones. Battle through increasingly hazardous missions, rescue stranded survivors, and return them safely.\n\nEach rescue reveals another piece of a larger story, with survivors telling a different version of events than your radio orders. As missions continue and loyalties are tested, unsettling questions arise. Are you protecting innocent people from a dangerous enemy, or helping those in power maintain control?\n\nDesigned for comfortable seated VR play, Combat Search Rescue delivers arcade-inspired action from a unique perspective. Surrounded by drifting wreckage, asteroid fields and enemy defences, the gameplay stays true to its side-scrolling roots while immersing you directly in the action.\n\n\n-  Classic side-scrolling shoot 'em up gameplay reimagined for VR\n- Guide your shuttle through asteroid fields, mines, drones and automated defences\n- Rescue survivors and uncover a hidden conspiracy\n- Master dual-weapon combat using lasers and bombs\n- Collect temporary power-ups including rapid-fire and triple-shot weapons\n- Battle your way to a climactic final confrontation\n- Designed for comfortable seated play using standard Meta Quest controls\n\nEvery rescue brings you closer to the truth.\n\n{1136799412220909}", "short_description": "Rescue survivors. Uncover the truth.\n\nBattle asteroids, mines and hostile drones in a side-scrolling VR space adventure."}]}, "developer_name": null, "developer_
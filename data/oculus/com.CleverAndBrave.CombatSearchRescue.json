=00_AfwsOjtbjPwOudieiQbab9A_A-WVWNJV9HM6gJEjGMJhRw&oe=69C11D63"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvukHteBtcEQ7kNvwGwFAcH&_nc_oc=AdqvDjHxwWn4Q7-RCP2_154rtamMaTVJSJlKV7zI0ebUymg-amSrGQIO52vmuo7xdAc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afxg-ZO8Vk1dFjvDjXY74p4P_gu-1Ci9orBpbwWm6v-l_Q&oe=69C130B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwihxDJ3lO0Q7kNvwHMbnJX&_nc_oc=Adq65Chv0nsPXXQd7Q6cF6OL4jezZF5wqForRIEnZO1MiARQITzFotaLgKR6j1ElkkA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz9RRxQ_AzzQuWjt3LvU7CG8cBJsg3RiWW9qQcBs4W-Ng&oe=69C13084"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}, "developer_name": null, "developer_privacy_policy_
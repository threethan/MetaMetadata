content-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lj1w75fVu-8cM2rR5vWXzNeJGYWu4sGOT7tqgbEUqaw&oe=69FF4C23"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oo_3xZHpabAQ7kNvwEZ_3VT&_nc_oc=AdojPFGNKu4BqcywPa4zi94Me8bGsDI94MEv1tO8xNZRJGiGmXl6Sba8C8PV3SOE2sI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RPZj0OaXrU56eB7y1SmPsLtzc-c-DU_ZyG3QA3YXuUw&oe=69FF2739"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XczVEsNDmAIQ7kNvwEdMRrg&_nc_oc=Adoxl86lrBme7jBO9CTg0nI2tiJwzqv8Pe8ArIO2NSP1I1GlKUDlE2Vz2H9vP4NkS8M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sXqDPwNGauIRz_N2_bFd_U05LW51Q5vR6m67ZQig9fA&oe=69FF2704"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
content-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nNGEIzbPCXO6ODCIJrkWTKliwD3lXJOvV-SoPNiu6aA&oe=69D39263"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiWmHkrpJQUQ7kNvwEycIdU&_nc_oc=AdrrvIJcryVHQYSw57hHCf8XnZ5mU8lMH9tDR32uqrt93DfWtnFCRYyY_OXA2HwhcU0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bMapwoP3Nt6oEF60dz_dKEyWslMz2jCiR5t05QNsOfQ&oe=69D3A5B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbLnirtBBIQQ7kNvwHYYSHd&_nc_oc=AdpPJ-lB2H9m5fg9HjSsVjd3XkM7GscgoSEjOQoVFINpRGv2rSzHTv3FEBiVuGatdmA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19kXUufyzz88HoQSLUlz52MQvPvIg0i7w932Xmplicrg&oe=69D3A584"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
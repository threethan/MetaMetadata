content-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcVxfj-yixXp3Yu8fKkHMCx5YLGm2ewMFeKE6vSS5wOg&oe=6A8046E3"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8zbnxL2RREQ7kNvwE-LpDy&_nc_oc=AdpJvICSLB3L5mpn-QfC1QCZ1KjZeYmhvniDGgXxkSYKjGphRhtliz-dssg17l9XHpA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZPaAX8JhlpwNg3enzA8q7mGN2Gd_6Y4gty-H8T28_zw&oe=6A805A39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UKPnVTUKS8Q7kNvwF2fNQq&_nc_oc=Adoad-3IxyT5ZAOG6ktMZ6La0U9edQ9ASJ_iCmSS99rHeLfPVCj9vka9H8GQT6zygRc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRL3csYtL6hNRYg4nDTISfzhSzvdqI32fiZ-RNU-Wqtw&oe=6A805A04"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
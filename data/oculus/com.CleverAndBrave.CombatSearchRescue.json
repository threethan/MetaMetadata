20f&oh=00_AQQPfZyCC6YByqzgtcniydjCO0TR4iGDe1NCpudjnC6-dQ&oe=6B00529C"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_3.png", "id": "789318210674013", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312376_789318214007346_5534937032544403868_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2-t0_HCCjEQ7kNvwE98kKq&_nc_oc=AdoP6SGqwq65uB3TavyKF22lI-VbTOfF5bXj2VlsLN3H63TUdpuRaL-gqUgdVKmcq90&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfiHDme21tXD6sF6xvmCjNqu5XpALpIY-qEHWd_Nn0PQ&oe=6B006FC9"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_4.png", "id": "1722230288492475", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827063_1722230291825808_8322606282782413843_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5-Z4TGinjsQ7kNvwGWPOjS&_nc_oc=Adrpdx58BZ9tt8BJdtXH5TRdFRU9wuSPlKZ01xK8jisqfuhVkqA1cYJgdccoxPvg8HI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlfUvGnotoETCZ5qoqTfMNx-cP9k3JX3dUwh9Qmc25Cg&oe=6B0060A3"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVx9ELZAC0IQ7kNvwG4yXq4&_nc_oc=AdoaA_tMPIO-ZS44n-ZZpH8fA5iF7aMYFtLIPY8SzlcoJn_P8JYTqGZLIN_QwnsBFUQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyJGM7d_Hi2VaFL6d_yDeeHyv7XuATParA2xC2V9X43Q&oe=6B0073F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47dG8RWvDF8Q7kNvwH9KzGs&_nc_oc=AdoyJLaS_heM4k-Y8yxDFwNnD83AKbVmAk7FrYm6a7TEO6j7SwJk3m68a2P-Dy_Nwts&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRp7qpq36s0j_lgcUAKIw--V516XZingMU3YXnVddXWRQ&oe=6B0073C4"}, "display_name": "Combat Search Rescue", "keywords": ["Arcade", "Shooter", "Retro", "Scifi", "Space"], "long_description": "Inspired by arcade shoot 'em ups of the 1980s, Combat Search Rescue places you inside a retro space adventure.\n\nLaunch from the mothership and pilot a shuttle through dangerous asteroid fields, drifting cargo, space mines, automated defence systems and hostile drones. Battle through increasingly hazardous missions, rescue stranded survivors, and return them safely.\n\nEach rescue reveals another piece of a larger story, with survivors telling a different version of events than your radio orders. As missions continue and loyalties are tested, unsettling questions arise. Are you protecting innocent people from a dangerous enemy, or helping those in power maintain control?\n\nDesigned for comfortable seated VR play, Combat Search Rescue delivers arcade-inspired action from a unique perspective. Surrounded by drifting wreckage, asteroid fields and enemy defences, the gameplay stays true to its side-scrolling roots while immersing you directly in the action.\n\n\n-  Classic side-scrolling shoot 'em up gameplay reimagined for VR\n- Guide your shuttle through asteroid fields, mines, drones and automated defences\n- Rescue survivors and uncover a hidden conspiracy\n- Master dual-weapon combat using lasers and bombs\n- Collect temporary power-ups including rapid-fire and triple-shot weapons\n- Battle your way to a climactic final confrontation\n- Designed for comfortable seated play using standard Meta Quest controls\n\nEvery rescue brings you closer to the truth.\n\n{1136799412220909}", "short_description": "Rescue survivors. Uncover the truth.\n\nBattle asteroids, mines and hostile drones in a side-scrolling VR space adventure."}]}, "developer_name": null, "developer_
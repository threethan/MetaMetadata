content-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbbc2eizxnFl_l2uBqne_PhNjuife4o4Cza8kl_J71tw&oe=6AA02323"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPYWsP7XOgQQ7kNvwF7zWeU&_nc_oc=AdqOcMZ5CDujzrPegFt0l55-3DZ4UbLxyP2CadsI-IlM1YL5VnPocuwtvB05ZA8BT00&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvvSYyQhMWal-f53gGNF9QVA7pKwTJp1SVYNRsRKPeyw&oe=6A9FFE39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OS1CTW24o4Q7kNvwGMLkQB&_nc_oc=Ado3NgL2NW0t_VCIXvt3sp5tOPhsCnJnKg1MrU0DCU3wXPD8ELNBfRY76fBfhoXmNx8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeo9Ktj3RqleTKNM_WXDu2Y0xsMo0aT1fyYKwo3eqUsw&oe=6A9FFE04"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
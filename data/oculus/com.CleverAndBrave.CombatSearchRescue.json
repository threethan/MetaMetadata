content-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQSRlNH8t02cE1zrr_w8RGm7A_X1ZE5jbbvQ33Aei8NQ&oe=6A898163"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_ljmzORZ-oQ7kNvwGYxTXP&_nc_oc=Adp4_1k5JjuQQVHh97iA73YvFx-sqk6pk1xooi_OruUp8mAJkXs6yNHAhZ4jMGdO-yE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMUNhRiipNM3WBpFKbh0EPe8Y3cLyF5DyGpCl9znYPvA&oe=6A8994B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVmW5atFLc8Q7kNvwF7Ip2K&_nc_oc=Adqvd7-1O9MNxjj3XHtvyEribsyG3zDKHJticdC46PUITRG0Q-lM5gXChASQ_yz0tFk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5BGg9zDMk_AM_AHjIp_j568VT8cDg1iLhYTr79Hn4nQ&oe=6A899484"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
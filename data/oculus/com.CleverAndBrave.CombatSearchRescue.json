content-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_alSLGPcq8wcdNMPzx6pR5DPTXFHLlaMw3_bFin0N7Ng&oe=6A2C1F23"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V48n2DZfkjwQ7kNvwFSgogh&_nc_oc=AdqIch_e1grz9rgbjjtS7gOgI6SBwqtqcGp5tDd7RS9yPtc54JRCRsKeWal1suFDr2U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pv0hCGocd2vQg5F0ZpLVPdzrkxKPAKQ46Qyvs6RkWvA&oe=6A2C3279"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2RAkano84AQ7kNvwHeZhWd&_nc_oc=AdqJvqPoR7jzb4GTFNVohFS-X3HOON_f_CmM7fzS8ZnQMCm46WTSPU2R3JuWMnVm4vs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sPGfaBgRH7qZN1JxWeEspamg9f0XbdsR65G7dIJJMKQ&oe=6A2C3244"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
content-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VdZnlqQH6zCZsViF6sHWcKs4-dY6m3_KZQrk5FJfFVA&oe=69E79123"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qwOwXENY-8Q7kNvwFrszou&_nc_oc=AdpnQRnyQCmTiGHr0asUvT6upUof_Ka79oEpuePaXnrKCIBqEi34PcdN0QqGba0-B5M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3puqqr-Yy_QaiAmaRNvJIePtdxwF8TQPxTVVC-z23jEw&oe=69E76C39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwtIcWu-UfQQ7kNvwEIyevP&_nc_oc=AdoBA7IVpz_Ryi6FNPZen0L4UuEcs9e0XnFXsHt7yHb8AYIof0w95jBYKvLB1cVzt9Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-349p3nO6dVDN3nb1mmFR6lHyFfWPQCrCUWpg2zH37w&oe=69E76C04"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
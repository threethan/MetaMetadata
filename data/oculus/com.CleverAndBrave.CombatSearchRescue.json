content-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGz6EHbMT5ICzPbumXYhrd_c9ssuDbJ5ipq6ABwXrkLwQ&oe=6A9720E3"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sSrN0FMD7MQ7kNvwHrMK3P&_nc_oc=Adq2S2cU5Qsga9DAYW2AswVk-y7ZlXwlWA7G403849qYkURW3EQ3qu03epSrufuvoq4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdU37EV7s5kpl0_2YozvUCnaX4Cc4mGm4vlqPu0eaIyA&oe=6A973439"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMleT-yKEuwQ7kNvwErhkiE&_nc_oc=AdonYbbl35hrq2EzplhqL3mVhkP6f3z7zOV2slsKnruurDtzEHW-EM13OIU_iXtZbzI&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZIFwwH12QdgS1HB8W0-54qwhc1KbcWCuJB0I7u_--KQ&oe=6A973404"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
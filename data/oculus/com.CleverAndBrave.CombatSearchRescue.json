content-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzrXQH8X5Mva2O2aZEOV-CDE15jG2KqRv6Y0PAmnlbkMQ&oe=69CA57E3"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCyHrx_0nY4Q7kNvwGvtK87&_nc_oc=AdrgQ6bEiJ32-oHNlXura6B6Uoh4rcqz2fLZsbOZlu7Ul2wyHxKl6xeXbjx1PaK3xKQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypT1w_oisBL6jTU7Ad_yeQPgCI3HIuwFgSmnOs1QXQMA&oe=69CA6B39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geSwPeK2UgUQ7kNvwGnaGdx&_nc_oc=AdoQChLQLK7Qmk1m0nH4zNG0Pqvp9plu7gHg7AO5XqlEWHW_Yj-winvhQADp2V6sp_k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwU0UjwyXOvqdzQC1wJkcnPT4K6TM_0EAARh05tWB9kvQ&oe=69CA6B04"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
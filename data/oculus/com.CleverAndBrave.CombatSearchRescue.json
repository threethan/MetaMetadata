content-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vD8BL2dqt4Fp5KmlMZZRSeLy1By5NjYWKwfR1DWgP-w&oe=6A32B6A3"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvPU_xgCbogQ7kNvwEOByLZ&_nc_oc=AdqEW2gQ45652cxHyXvwf29F4KWxvtxL2DChL-_CS_K3uAzg10v25cjN6sxkSS8xRJA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YvWqueARdjwb4vUgnkTLVhxZMVjnW5VoD3xEaLV_I6w&oe=6A3291B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8U0d2-qvPGUQ7kNvwEtsv6g&_nc_oc=AdqFyYipdo3J3RkR686b1JjU7jISJ0Xr_kdH5oYbrZkYmEv3uJ3Ab5gI-cFISimO7d0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DcWseefsIGquwyecESYjv_RecZ2Ll2FPk6Fq_QY7G3A&oe=6A329184"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
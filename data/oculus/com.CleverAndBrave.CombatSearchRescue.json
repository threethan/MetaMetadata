content-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54ImhI4r7AJDu3sXYGIatrRxwE6-U2O4MyVmb7oakGDw&oe=6A15B5A3"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdpYEIvy1gYQ7kNvwE3EVx-&_nc_oc=AdpfA_FrR3AhU-7_-A-8I9dLzKnNKM0JU5kmL_PJ1EPE3rDnQbt_5-276yaiq5zhQxM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ot2SmX5eemJsoXyNmNY_OXO-4nhXhsVvh3WWDdiQOQw&oe=6A1590B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2pJyDIXlXwQ7kNvwG3vyce&_nc_oc=AdqnuUw5VcDdfKNJPx92zlLR3cJWTvySYKKIfOpYn46lo22_vCAa_HSr42EGlpvgPkI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74zp4T86K-DQKd8sDz0KdBTHsMi-9wVrIEfK19jR3W8g&oe=6A159084"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
&_nc_sid=6e7a0a&_nc_ohc=Gu-FMtNISJQQ7kNvwGfy7cV&_nc_oc=Adp3-Kw9FoTCY2JJuIjlWw-c3uH2xLN0WOnIx1ZD_4_IibGJ3L_uz9nqmy0cJ_G6qiE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPwZow3xiC9TV4rqFGudDpwwHXfmymWlJap9bsujc7wg&oe=6AECA949"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_4.png", "id": "1722230288492475", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827063_1722230291825808_8322606282782413843_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqrJb2L6pj4Q7kNvwGryt7P&_nc_oc=Adp-7g0HKnzggEGigDdvlslkFzzA6d7kb21JbL0OE4YqPZ0iaQiQdsD7KfFY34867wI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUS76GzN0P2yaxocq2CVJnyo0bM65iA8rUSu7uA_kIUg&oe=6AEC9A23"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RF7YtxU8404Q7kNvwFxhV5F&_nc_oc=AdraK8XeYeTjdqLet2rqHz2ksRdPlTy8YJtDrzEHff7G-HkARHFIODk_hZFPNQeu7y8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVa5xrh3ik7fjcCNe1kVQxkAeT7YpEjlrJGdi0slUpkg&oe=6AECAD79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L29r_zvH5koQ7kNvwH37qFY&_nc_oc=Adr8FwX1oF-YzDnRf62wPkdz10K3o7EYZVIEgvgC1VnYTLZ7bmuERduLaIoiX4oMKBk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrTYNgm3e_jO6uhwHzpHOJgKR0xzc7E1dbuztccECeDA&oe=6AECAD44"}, "display_name": "Combat Search Rescue", "keywords": ["Arcade", "Shooter", "Retro", "Scifi", "Space"], "long_description": "Inspired by arcade shoot 'em ups of the 1980s, Combat Search Rescue places you inside a retro space adventure.\n\nLaunch from the mothership and pilot a shuttle through dangerous asteroid fields, drifting cargo, space mines, automated defence systems and hostile drones. Battle through increasingly hazardous missions, rescue stranded survivors, and return them safely.\n\nEach rescue reveals another piece of a larger story, with survivors telling a different version of events than your radio orders. As missions continue and loyalties are tested, unsettling questions arise. Are you protecting innocent people from a dangerous enemy, or helping those in power maintain control?\n\nDesigned for comfortable seated VR play, Combat Search Rescue delivers arcade-inspired action from a unique perspective. Surrounded by drifting wreckage, asteroid fields and enemy defences, the gameplay stays true to its side-scrolling roots while immersing you directly in the action.\n\n\n-  Classic side-scrolling shoot 'em up gameplay reimagined for VR\n- Guide your shuttle through asteroid fields, mines, drones and automated defences\n- Rescue survivors and uncover a hidden conspiracy\n- Master dual-weapon combat using lasers and bombs\n- Collect temporary power-ups including rapid-fire and triple-shot weapons\n- Battle your way to a climactic final confrontation\n- Designed for comfortable seated play using standard Meta Quest controls\n\nEvery rescue brings you closer to the truth.\n\n{1136799412220909}", "short_description": "Rescue survivors. Uncover the truth.\n\nBattle asteroids, mines and hostile drones in a side-scrolling VR space adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://combatsearchrescue.com/privacy_policy.php", "developer_terms_of_service_url": null, "publisher_name": "Clever and Brave", "support_website_url": null, "website_url": "https://combatsearchrescue.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3
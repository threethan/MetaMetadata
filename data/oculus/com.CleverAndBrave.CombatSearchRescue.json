&_nc_sid=6e7a0a&_nc_ohc=KeOF_Zr7ClsQ7kNvwEFONcK&_nc_oc=AdopzkB2_d3mpE-Elld85IPvg1Vea1hEwyGm6VP9yM2HKaT7tx93P-w6DfANLdJbyJU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2EVBuGSr-3oxOqH6A-Y8ATU7BWZRyfrFfBetQ5spo0Q&oe=6AF5E3C9"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_4.png", "id": "1722230288492475", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827063_1722230291825808_8322606282782413843_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yb99r12bF78Q7kNvwEQ01DR&_nc_oc=AdpGVRfRcModTHxlLFhtCousjEM5U28qJaFAaSq58f5w1MmS8vuflRF4qQyImZwPQ-o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPYWTUEcLrb9GDc17o96MtSexdEcKD1abtOF2vcBVdmg&oe=6AF5D4A3"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3swPO-vbAcQ7kNvwED8300&_nc_oc=AdovpAoVZsyEQfV5Qc045n_3p05dhVmNUB_lvG9QTBhcI9m0swpqCnHHGMZVroQ1z4k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHoz2MitLORsb_2fXPZZolGsoi0ctceARDej1M40D9dQ&oe=6AF5E7F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9-EJ02nDzAQ7kNvwHrRGMD&_nc_oc=AdqjSXfnpQBzGJmQVztEtPublroYm5uiOYFWiyncTJkogQ6Vn2UbFgsutsEWHfWLqvs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNM7Px0ZWJF67nYtrMhh_akx0fFEt8ktSPzT0pQ8LCvA&oe=6AF5E7C4"}, "display_name": "Combat Search Rescue", "keywords": ["Arcade", "Shooter", "Retro", "Scifi", "Space"], "long_description": "Inspired by arcade shoot 'em ups of the 1980s, Combat Search Rescue places you inside a retro space adventure.\n\nLaunch from the mothership and pilot a shuttle through dangerous asteroid fields, drifting cargo, space mines, automated defence systems and hostile drones. Battle through increasingly hazardous missions, rescue stranded survivors, and return them safely.\n\nEach rescue reveals another piece of a larger story, with survivors telling a different version of events than your radio orders. As missions continue and loyalties are tested, unsettling questions arise. Are you protecting innocent people from a dangerous enemy, or helping those in power maintain control?\n\nDesigned for comfortable seated VR play, Combat Search Rescue delivers arcade-inspired action from a unique perspective. Surrounded by drifting wreckage, asteroid fields and enemy defences, the gameplay stays true to its side-scrolling roots while immersing you directly in the action.\n\n\n-  Classic side-scrolling shoot 'em up gameplay reimagined for VR\n- Guide your shuttle through asteroid fields, mines, drones and automated defences\n- Rescue survivors and uncover a hidden conspiracy\n- Master dual-weapon combat using lasers and bombs\n- Collect temporary power-ups including rapid-fire and triple-shot weapons\n- Battle your way to a climactic final confrontation\n- Designed for comfortable seated play using standard Meta Quest controls\n\nEvery rescue brings you closer to the truth.\n\n{1136799412220909}", "short_description": "Rescue survivors. Uncover the truth.\n\nBattle asteroids, mines and hostile drones in a side-scrolling VR space adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://combatsearchrescue.com/privacy_policy.php", "developer_terms_of_service_url": null, "publisher_name": "Clever and Brave", "support_website_url": null, "website_url": "https://combatsearchrescue.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3
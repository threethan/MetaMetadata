content-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24YWav7b7FbnYwauPmAdWfE9ye8zQtY7WQ-jLAMKabMA&oe=69D27923"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiWmHkrpJQUQ7kNvwEDRkns&_nc_oc=AdqdC6LDJ-k-N-lNjmNSNkNSdyrHiXJmf5AP_6r0Z587r3krsY8q91K8k4CTHz8NMFk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bnDvvTDziKAX44uU_BmPLaP7p2Z84IfxYHc4hIDLq6Q&oe=69D25439"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbLnirtBBIQQ7kNvwFQJWpY&_nc_oc=AdpFmFdyNJlNzJgMTsrq0G-h1vh8QN1edZlSIgKi5B2_4yljIkW__ZOfk85VTIwM5rM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yeC29Q3q0mzvlbO7Ko0Hr9MNNcm-Quv9ZtCE6h55n-g&oe=69D25404"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
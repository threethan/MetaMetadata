content-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDe7Y_GFMdY36sbJOhiKD04YJuWW14XfPqIy2qZ22otfg&oe=6A4FB7A3"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opDzyqFD0jwQ7kNvwGtrEBG&_nc_oc=AdqYC2HmWCFlwVJxIx10vpzPHFFAV1FXZjwZqB-aZQ6sx07bd1syp-j428yY5GNjjyM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADQQwkwOxjb1pAuicLgB1ebl4aCtI6Ef2ub8I7OMpmAQ&oe=6A4F92B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gHqRkA3Ao8Q7kNvwGcsoja&_nc_oc=Adrla6uA2P97Cqc5mD2r7mOzNSjnOzJnopYKkMf8aRnj_inv1v-OSOXq0jKlZPtHrCY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9l-cWTT5slRib0NbGmGmN51rLLh7zDUQ8eOfQq06CfQ&oe=6A4F9284"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
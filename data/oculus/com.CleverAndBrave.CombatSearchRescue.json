content-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwSjS2qkmRhbiBB3Y4daq5H8wBN3eFJ4m4_mPHQ4ju8Q&oe=6A53AC23"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMdVk-W9Zg8Q7kNvwG6d6EK&_nc_oc=Adp7PnXzSOkZxzRsVsuFfM5Yybjha-b_rGsyeqtgIvraeJEO-dP2sKEkhAKWIChUS2U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcW03FfNKB8X0vqU3iReK_U69hAlU3ChKbtpLdtwkWAw&oe=6A538739"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIpuLSfvaVEQ7kNvwEJF1Uj&_nc_oc=AdpjtgPO0ke8ZiKUFAhkjtjlnrEPmUt5a-7VcVOUl84dzjZ3yBqOcNjLHpMN_CD3NP4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVoKQdwC-bl5QG06FJgljBCsK1hpkkjn3-3Zrkc9mcSQ&oe=6A538704"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
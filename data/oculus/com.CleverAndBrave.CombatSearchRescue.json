=00_AfwiZ6K_zLkKSCIK62WiTDhXShdmcaNreethb6wmLp8dnQ&oe=69B93463"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WGBssQl-OUQ7kNvwF7TCET&_nc_oc=AdnbVgffoHFdhkknbRWOJE9HVm8Zxic-6oOowyHokI6uidx6uUnPLk2b_DCfp2NkF-U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyTKKkRDmvJHTbuiknQ1ZSLZlQ7prqa5WgvsSHSN2IQEQ&oe=69B947B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JK_2JtGGxSUQ7kNvwGU8XaF&_nc_oc=Adm8toP8GxEI_2wSOMdOveT_ICx3g5PLtmodtJH9000VXuXg9H3aAUFMUk89DE0ghEE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJn9Lk60b75tMjDhOB_nzUHpq1PjpbmCHWQJ0iSqjHVw&oe=69B94784"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}, "developer_name": null, "developer_privacy_policy_
content-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQ69YEvuRiHaf5KUQpgcoCYPjekcSbAB45rxYflu60tw&oe=6A64CFA3"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Qb2vpEVTEYQ7kNvwHf8bfS&_nc_oc=AdrG3cx5tHmSD882Q_xABaiCJNzJmxoFc9kbel2NAWcnB5k5DeOyGsmOWOEnTgHK9zI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPVxouiT5CP0pGNaznXpvd8Tv7ddubDdDxBLQOCrkOjQ&oe=6A64AAB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ih90dduqd9sQ7kNvwGgJQ6W&_nc_oc=Adpco9ziZaY2kaxR3-8PjZa-zle63XvOuEH2BC53RwhWwmUt9JseJfJ9ircBI-XYpT8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApTUYBX95nd5eqwdQVhyHO_4R4riGpfeY3owJZXlFSrg&oe=6A64AA84"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
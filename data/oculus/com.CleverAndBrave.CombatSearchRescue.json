content-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz04a1uYlypbjY1-rH8TN_-5dYLoe4u97UnOmzx-l1CMg&oe=69CF9DE3"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpCOlwS8qAsQ7kNvwHbhAmb&_nc_oc=AdoWLfJ65OSLtvvubd0gCO2ZRePkZTzTHcsKHORIDd8voPOv4w9BzqK4HDAwNj6Ymks&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWximuGm44fHvu55i73IiqiSWYkxfuCoqnuT8yujwpQQ&oe=69CFB139"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLwm2o_X5YEQ7kNvwEfOXaf&_nc_oc=AdovcM_QxzrlqFNye4W467x9nOSpB-QkN-9LHVKxVOyX5J1cd7KSEnutoOxJ_CvOht0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzM6JBDUHFH5q4Ok-pH4khi0CgxpoCKyBwDAtJ2bz4uBg&oe=69CFB104"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
=00_AfsNUwvHcSZlZQ-8vA-XyPIFpYwdINMajYJ3sMjkt07QCQ&oe=69A810E3"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkTWZl-_pvsQ7kNvwGrltDg&_nc_oc=Adnh0CRMLGs7TJ3crYyn5igI-SsKTNSDJqr-vJWzuPC3IUceyYOoeSYqDzmbzsuBKpk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsYplr26JhmzxCE48IzU0brF-6k8XXqwjXDX6t7lLU0BQ&oe=69A82439"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saAgr0nUPiUQ7kNvwHYMbxv&_nc_oc=Adl4Y6QQ6x5BD5MwTCEvFdr405bRKb4e30EdSVy8OS_4_scl8mHPP8QGA8Kp2r1-EKI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvaZrJCw9Bnf_MO_IQYBMx-R9juy0knOd5bYYKL1EpJ9w&oe=69A82404"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}, "developer_name": null, "developer_privacy_policy_
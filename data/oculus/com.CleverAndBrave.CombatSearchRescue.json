content-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyh5wrxJRAAsTIOk42Iu14rMNiUzel3dEoVyJN6qN_d0w&oe=69C7B4E3"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojssgXYLj1UQ7kNvwHRfB4b&_nc_oc=AdrrEIS59PcgXeKznNPDiKnZ68ki62ZPahCgYag1azeF8n6yiQ1xHwNg2SGuu61C_u4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDNtRQIoZnfSOPngCIQnB9H08MN3YUnJLsSNl-pR3Qtg&oe=69C7C839"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrPkmTHl9rUQ7kNvwG9Fl0-&_nc_oc=AdpUifbl2nKcTjT_QihIV8Hef0qm4rpHaGkULiLt0-MM9RtlEo1smxdV03h6C7n9RvU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzFXCqd0xKGsLGWEN4OzU741w0Zatorje0VPsWtPvEX5A&oe=69C7C804"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
s."}]}, "developer_name": null, "developer_privacy_policy_url": "https://combatsearchrescue.com/privacy_policy.php", "developer_terms_of_service_url": null, "publisher_name": "Clever and Brave", "support_website_url": null, "website_url": "https://combatsearchrescue.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25292705187021391"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "25303064029278600"}, {"status": "PUBLISHED", "id": "745480691853392"}, {"status": "PUBLISHED", "id": "1826029388809710"}, {"status": "PUBLISHED", "id": "1538219601171947"}, {"status": "PUBLISHED", "id": "905178069154563"}, {"status": "PUBLISHED", "id": "1167610974797897"}, {"status": "PUBLISHED", "id": "1360801752292988"}]}, "baseline_offer": {"id": "1360801752292988"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "1826029388809710"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25232067609751816", "version": "1.0.0"}, "id": "1740637530163143", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"
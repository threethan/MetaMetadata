content-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XRc6-I1zEP2QeYJ6h6zdnsiPyC-t1I9bscN-NB9Nmig&oe=6A243623"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCOhiKbRhkwQ7kNvwG0wywu&_nc_oc=AdowwP8XlmnNy_7UId4PpOenMVKUDnHaW1FPvOSslSePu8pqpUDH7Eb1Q4vjZz3LsSU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Iy4wi5VUu9OdlHy_jheE2uOQ-3G0vwoV5eLlNvgm3ZQ&oe=6A244979"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVTuUSBdzWMQ7kNvwGSZ9Es&_nc_oc=AdrsAOoRZG-SJ3EMRjc9dGdfTImKfhONwPdyjebZex47-tfmuTbPkrPMsXxhgTU1LCA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8b5Kdx_hv51K10c4zFlzEfC9yv2vx4mi8qa4AlHFOFpg&oe=6A244944"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
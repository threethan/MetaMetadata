content-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLfP_EZfsvfq0SbrmrT4rPd5NCSkbpUH5trN9_zWDQrg&oe=6AD38DA3"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4yW7U8jwjUQ7kNvwE1zb_T&_nc_oc=AdpP18UotGCSoW7yFc9btTrkC9oBaaISFEJQMzMgimRQKucoQJJ7kdsT9wUSPqICGf4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwX3BK82Y_-oOhEbjQsD7bjFqZYOCfsYkyx1iH1xl13w&oe=6AD3A0F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qB5lqUgtiToQ7kNvwF2fXl8&_nc_oc=AdoUE-jHN9kZ6v5UJoe_ExLFtV5J03tgqcr96QJB4lMqnEo37rpmARUprHdR9Eqvjpc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsPryjwL-x_g12w3uNrKu5SCB_iKpg87AT3C3WACSXcQ&oe=6AD3A0C4"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
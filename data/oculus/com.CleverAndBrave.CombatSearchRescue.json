content-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICNORw9QETFYC5o1mJn_--XzmkoubDX9pr-x4kPKT63w&oe=6A9ED1A3"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scPnbB-T9x0Q7kNvwHILM1p&_nc_oc=AdorrfIU5BeWkPnVdc-gAuQUzp85CneqrDPcT1UfaMXVh0IJIwC3mowCw6na71AQRqY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5Lw93NPE48UTYRx4kdbf12AwOkEI6teIBbMeprt9ewA&oe=6A9EACB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40zBHN8tsm8Q7kNvwHk9aor&_nc_oc=Adpmq-YTxFkaO5E8C4485zy_NHvFSs-FyZjkAias--gSf6K_S7-92rZ5MPaeTH-4nvI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGmhzjQs9Wq1H2saS2_U8waW0W09rTc0-2CQ6rOpTbPA&oe=6A9EAC84"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
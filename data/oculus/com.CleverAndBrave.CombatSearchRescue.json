content-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjQtoSmQ9_D9jhvqMdWV5fB3qSJNmtsDm-qzIqpzFA9g&oe=6A92BBE3"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4Fg24z1xNYQ7kNvwEdGn36&_nc_oc=AdrjgSN2Wn7R1BxqhM3XpAsHZuf394ZIGogdUFNt7cFFsIkJpoyTgbinidg9gCTNVWg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4WFh67_Z3N0oZxZ4qvO3XBfpXDRFMQBWf2hl_lV1bmw&oe=6A92CF39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xIQq3CJk_YQ7kNvwHVVWGz&_nc_oc=AdpeV_SBmeJSBmCc3pp-ug1N-ru7QTNlBf0gFToJ77O5mY8YlpO1AdfwJUO8zYVnZdI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWv6Nz4iQ8ho0cAlbXvdv3fk7Cq_NIK6Rcfi-Aql0h3w&oe=6A92CF04"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
=00_AfxDw9teClduFY4ueRJD-NYfaLMK118aBqEkRMkKaUVqfw&oe=69BC0FA3"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYNzKOA1i_8Q7kNvwFsbLtr&_nc_oc=Adm6UCsOLfYav7wzjvQbYaBL12AOwlxBvNBsjQwH4hvsLfUArJxlUqhH7mCqYyeg5nI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzCCXKm_eMK5qTc1Vw0wfAAioqi1HP0Ox_VNnZBBoHy9A&oe=69BBEAB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ltcvwRM83oQ7kNvwFi7B12&_nc_oc=Adn4S8N2h_YzeAQ00oqxNQ_IH4qgqCOSRLP8ZZeHsGkxSKELinOXDXmnY0j1pFoVIY4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLxIp9m13SYVuS_ZEe3ivpV4ijuSXUTVhQZxP8cjbgCA&oe=69BBEA84"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}, "developer_name": null, "developer_privacy_policy_
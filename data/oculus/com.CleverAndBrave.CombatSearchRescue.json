&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVx9ELZAC0IQ7kNvwFJveQJ&_nc_oc=Adr5QLTHfD19gVhiYdwdsXy5qEsZ6GJ04Ye8r0iSsSdu-_a8ouvH8T8wKR9-1LDxypw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPeAGj8sWnsjt5qy6WMg9UWsSsP-QhFHohQiCUOnfI4w&oe=6AFF2279"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47dG8RWvDF8Q7kNvwFXe9TV&_nc_oc=Adp3vUCj0-V5Q_j_V7TV_pwXq8QCGzxcHTlJIXLJPpPkiOqNNyl-6EYufXR5BLP8vPs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2Ss0CpT8D4SVb5magLter5V-a9D0eWtZgK1j3iuI7Uw&oe=6AFF2244"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://combatsearchrescue.com/privacy_policy.php", "developer_terms_of_service_url": null, "publisher_name": "Clever and Brave", "support_website_url": null, "website_url": "https://combatsearchrescue.com/", "category": null, "comfort_rating": "COMFORTABLE_F
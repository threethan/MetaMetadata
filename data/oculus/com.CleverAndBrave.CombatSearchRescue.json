content-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGGgKbbXSGR3NWCZl1HvBiYof-u1Y4YBLD3HvGSnJfVg&oe=6AB29823"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyoAokz29QIQ7kNvwEWzJDA&_nc_oc=AdrR6ETQ1VGUbqv8GDty9QBn5dAxouW5a-7XKw4FwshwZNwgsqBqrkdi8Fh6lGP6Pp0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2bFbBEk1PKv1oV9v2TOLdTQdTU6Cm9XVN3DKJyus_DQ&oe=6AB27339"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XD0tzgQ8bjkQ7kNvwGGlDP9&_nc_oc=AdqcwIB9WjWz6aBRyYKkxABByRqa2nquxiM3RnH3xXFznOp9p2-nmNYLluCO_Tes82A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSVw0YTQ93tV00NkEGDmEfe9npDgsujZSANzcDs91L1A&oe=6AB27304"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
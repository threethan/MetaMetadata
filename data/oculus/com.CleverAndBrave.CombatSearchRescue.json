content-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1iJUdmb9ls0V5DzW0G65JGtopjxevEEpQUUw8eigrTg&oe=6A662123"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Qb2vpEVTEYQ7kNvwElagCG&_nc_oc=AdrObU9X2IvFtO5E9q7FC6F7SoUiKA2MEabyQAW-lFKlmPkFUgEnZcCQpIXk8yUJLm0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhgR0JsdlI9EZOBgnJlyxadl2KvI66C3tQ6Vv5uuJsJQ&oe=6A65FC39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ih90dduqd9sQ7kNvwH0y3ql&_nc_oc=AdoaqeD2u9aBxdSi-EDceW0Q0TV96Dyv3I70W8i5ryYjbvClTrehGHqx38x5rehos4w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzbyiCT0fHDtYxT29TsnkHcD_b5pM6B10vsgEM8A4hUQ&oe=6A65FC04"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
20f&oh=00_AQSx72gm1nNRAN2kix03gbDqF2yG1CZdsQP8ZR9c12PVmQ&oe=6AFB44DC"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_3.png", "id": "789318210674013", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312376_789318214007346_5534937032544403868_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9fmBq384jEQ7kNvwGXqRcJ&_nc_oc=AdoxgYR_afemmiLWyzOHUWt8DPceveDg8vV3YEzLULyAJPhUfoGSvHavn1nkvki2N7A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS73BTh4o6LzSMJgrIvhTY5NN_LXkq7eppUZqoJ28bE8w&oe=6AFB29C9"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_4.png", "id": "1722230288492475", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827063_1722230291825808_8322606282782413843_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7qbu6WzwFcQ7kNvwG1YG66&_nc_oc=Adou24hph_JZ705SKHVx9zsy5R7s5gF5ubxCoaKm4V_TBbgS2_lUowPdRaTZvyv_IR8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRh5mGMPpLYSn6oXX74OL9Y1abMAH7yauhhk2qvHddFwQ&oe=6AFB1AA3"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1KY0RLhB-kQ7kNvwFH3lqM&_nc_oc=Adqw7nrRAw4EiD9fBOpiiBAA5VkRNnJzG-OvJw4YRWimfo-RZjLTV9NXkL__JbMHmGk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxiP1u3tYRC5TZIW68TABBoopVKVPxgpC2oCbFIawwdQ&oe=6AFB2DF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZP0uSd9kVp8Q7kNvwHthTFh&_nc_oc=AdoRXVe2J5_1WX_Ts4QK26Khte-xZ4lYZ1RHrY6TENrAkdkT8n4ApiZ9wJSwHOEb1Nc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKRcEpulTUdcRxhXppXrnVg-4gOi_VCrnZMtK1rLyP4g&oe=6AFB2DC4"}, "display_name": "Combat Search Rescue", "keywords": ["Arcade", "Shooter", "Retro", "Scifi", "Space"], "long_description": "Inspired by arcade shoot 'em ups of the 1980s, Combat Search Rescue places you inside a retro space adventure.\n\nLaunch from the mothership and pilot a shuttle through dangerous asteroid fields, drifting cargo, space mines, automated defence systems and hostile drones. Battle through increasingly hazardous missions, rescue stranded survivors, and return them safely.\n\nEach rescue reveals another piece of a larger story, with survivors telling a different version of events than your radio orders. As missions continue and loyalties are tested, unsettling questions arise. Are you protecting innocent people from a dangerous enemy, or helping those in power maintain control?\n\nDesigned for comfortable seated VR play, Combat Search Rescue delivers arcade-inspired action from a unique perspective. Surrounded by drifting wreckage, asteroid fields and enemy defences, the gameplay stays true to its side-scrolling roots while immersing you directly in the action.\n\n\n-  Classic side-scrolling shoot 'em up gameplay reimagined for VR\n- Guide your shuttle through asteroid fields, mines, drones and automated defences\n- Rescue survivors and uncover a hidden conspiracy\n- Master dual-weapon combat using lasers and bombs\n- Collect temporary power-ups including rapid-fire and triple-shot weapons\n- Battle your way to a climactic final confrontation\n- Designed for comfortable seated play using standard Meta Quest controls\n\nEvery rescue brings you closer to the truth.\n\n{1136799412220909}", "short_description": "Rescue survivors. Uncover the truth.\n\nBattle asteroids, mines and hostile drones in a side-scrolling VR space adventure."}]}, "developer_name": null, "developer_
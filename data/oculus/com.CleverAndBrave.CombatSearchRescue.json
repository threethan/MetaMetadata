content-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIM3aw0tVFHfIWHbwBg8F154tFc5VnsTUA4PWM5OnUWug&oe=6A998BA3"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwUZjYBj8kQQ7kNvwGy4e-2&_nc_oc=Adr74bgrAXXNYxdvtGaiLGV1jpnbSjYYwvJv7P_T-j04IpS4cuHCMQnvWHNtJ3hOKlw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQHfM7Tzt6-tJ5fM0YzNGCAyAgEOZi9zC45wbAWidnsA&oe=6A999EF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Tu8TgcZCSUQ7kNvwHsh94h&_nc_oc=Adrf4PCXGr75IqSGJ8XL2wYhHmMhCTP2-6FqzXIhiDLpRXea8rjhRk3_DklY3zrWGtk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzA4-KHzb7e_SE4A-C7UY5D0_FB-LEyLqF6wek5I8Pjw&oe=6A999EC4"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
content-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FkamG5MqsZAHkBR4uCOjLkWfcQlF6qoZc9HYOGmwYiA&oe=6A43DA23"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRII31Mj2v8Q7kNvwFuZm0e&_nc_oc=AdrL11dda-FQ5pjGLTw6lHwWK2p3umOci0chuaDgzNCiuvqxIWFIc1A0RIflApSFnuE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QOxUTRZ3-k-kRHwyWJ4BjzNkmC64vzodQeqZmLeIqdw&oe=6A43B539"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gWbWagMyywQ7kNvwF60ofM&_nc_oc=AdowFCNBUxblCxSYEZ8zbJTOmoZ0vHCuJthTNgrxf_KnwMdoCHhfMiqxcnJ0dGiE0M4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CcKVNEWTr3Y52UCc2EFtVmmeao8yy5GswSh3H1hghBw&oe=6A43B504"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
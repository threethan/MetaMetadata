content-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4PNee9F0OcRLbknpTtVHxytVaMSTKEr4JWcgfuzB6bA&oe=6A770C63"}, {"file_name": "CombatSearchRescue_Meta_Store_Screen_Shots_2560_x_1440_Image_5.png", "id": "2171766606567030", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507823984_2171766609900363_4147618211786775689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30zfOCQMjbIQ7kNvwE5MGHv&_nc_oc=AdoE_91ZyXHoKafvOBdIC8ix-pWTh3FKtzskkzNre7hW6oolUO-k9K_vUYPstSrhISg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5-tpwVizeikDdsugoGi2V9JriEU8979T_mddzHXV8EA&oe=6A771FB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CombatSearchRescue_Meta_Store_Trailer_Cover_2560_x_1440.png", "id": "1361856482280691", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824611_1361856485614024_8623398926021963791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25kSIND5HmsQ7kNvwF7m0I7&_nc_oc=Adq7AVK184cnsMoU3yyES9HJ8UFT9iO8AZDICGOA3O-KqIj5uM7kMuE3cusaueaEr2A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXVZDu_4Vhg8KGv2pnLqIV9oa8qkeJhA0awcEMcsx-UA&oe=6A771F84"}, "display_name": "Combat Search Rescue", "keywords": [], "long_description": "Combat Search Rescue is the first game in our VR 'n' Chill series, designed for Meta Quest VR gamers who don't have the time, space or energy to flail around their living room dodging missiles.\n\nIt's a retro-inspired, side-scrolling, space shoot 'em up that immerses you in the action, like being inside an arcade game of the 1980s, with enemies zipping past and lasers streaking by your head, but the gameplay remains third person side-scrolling.\n\nFly your spaceship with thumbsticks and buttons and stay planted comfortably in your favourite chair. That's the spirit of VR 'n' Chill.", "short_description": "An arcade-style, side-scrolling, space shoot 'em up immersed inside a 3d environment.\n\nPlay standing or seated using the thumbsticks and buttons on your controllers."}]}
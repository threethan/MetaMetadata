0f&oh=00_AfzH5aY4u2pS7m7T0cC9J1TJ-nXkH4EAub4qYnz6623H5A&oe=69CA798D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FySAdn3BUIsQ7kNvwGa3fLP&_nc_oc=AdpE_W5sipR6YnZGhp4GH8EzZ_GzHtqSyt9Knpya_2Ftg4taYVD3Ve7R8-ZTfHslGN8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzuB85tSggZAGq5Zs5KnmvRpdSLVuu6Ru899uzpMCWphg&oe=69CA70C3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-B-i2diNnyUQ7kNvwHgy24q&_nc_oc=AdqdNhmhQWFvTZyv4PoObilsuStSWH5-dGgR2G-ZIuHV_0oxphcm0b1A4O7a73RjC6A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxHEt-OUD7PXwYcfYRWg-GD0Rv4G3e_N6m7OFnnf3wHeA&oe=69CA5F83"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVo0rMG8DoYQ7kNvwHT0mPt&_nc_oc=AdqvjZ5_2pUvorEpS9WvVA49eDj8A-9Qj2J_tpDpQ12OeXdE2TA5v3td91yyu2i-LZ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyv1hcpJou-LFlLNeJJIUiwSPpeU6-ABeiuOtlqN-wztw&oe=69CA6A4B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H97pMuKT4NgQ7kNvwEsSmmB&_nc_oc=AdpyDHLMWvzLMLb_7LYCss-hYmGYrinjeeNe7uh68Zbagc8bnjq2oZriF3jdTsJq-gE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKUDiXCAQNo02WNA2FmtsiWgluw95KsAlFtnD_uhX9sw&oe=69CA8629"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iq2sgjpSoz0Q7kNvwEDxRQd&_nc_oc=AdreHL9xi9FkHAD7gXddEMvtBuNpgz2M5fdJW0c95rWqm-4iumvSbGll3m5iHexLksE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzWfrhfF1wHkATSMNflWB4l2oShrlykcPwzYbDQhRQ70g&oe=69CA62B8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
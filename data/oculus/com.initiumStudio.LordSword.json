0f&oh=00_Af4PfYyOtdMsCDHBPv7Q8ntpWoqYJ5AesTc9R_w2NmoFBQ&oe=6A1C368D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0b5Uadl9Hy0Q7kNvwEst8Q3&_nc_oc=Adoxsr76yUAj85Cde_CyUJ9ThboTR79_D7LHz5U_uzahW68lY6ptqfOBcM5K3P0VaVw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ABGqJve0hglDZJZurbL0qenBKqOTr8aVzcBr4i0rQhg&oe=6A1C2DC3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ASaSdtZeJgQ7kNvwFK4N_8&_nc_oc=AdpI2bX9o_xtAML6Fbr3NNJRJHXKP_RCf33Y-P_BB7pVFCzbgaT1TXttiN3W9aH9FX0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4izkRF7J167InYPrYg7x7ev6Xy2Q2UGXB3sF9fGcR8Qg&oe=6A1C54C3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFi6nIYP_WUQ7kNvwGvY7Lq&_nc_oc=AdpbHB0bXlpQvTZKrwiyD7nb8CA-vSDqStrYhBgbkIGkDhKflJKs4XIa8We6I7qd14s&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5M3pJ8tqOwn2Sy2I6F9JtKEOXF_3AyS-49jwCcC7nKKw&oe=6A1C5F8B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5vqEaZ59AcQ7kNvwEIM5GZ&_nc_oc=AdqGD961KL4d7fFIj-KbxZv-gBBc5B2VyMpWLSWub2ezQb_avt0aTzgszoywA0NHcY0&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AnmzrE0d3b6F0KWmOQZ1CAYIK0ocdBsj0YiemPUWleg&oe=6A1C4329"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXavwB6KgC8Q7kNvwE1UfAs&_nc_oc=Adoe41RcIbT9RgnH3NGkwWKh_Y7JpPy-jWslWqKRALDueEsRUsXvAauoXgtVugSEFBw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OKd60yFyt7apmozRs2KM0U-8hq3ee7VczJfNrfPYg5A&oe=6A1C57F8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
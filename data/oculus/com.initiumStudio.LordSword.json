0f&oh=00_Af4YhyyoxjyDjXtI-V2QmSaNCVthBs5AvrbWV1Qr1MgQAA&oe=69FDE40D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMUimVepSvQQ7kNvwHXT7hi&_nc_oc=AdrFGYrmbR69j-MDjXdeJsI1jH97QirQKunLJfNfbrBLdHCIQJr47SzYFiicHAqDuMY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QTGqufAhPs20FUWfIF-EudY1SH1X2rj3iXmboueqgIg&oe=69FDDB43"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VF57W_Un8EQQ7kNvwEyDKzu&_nc_oc=AdoDVQnQF0d6qEmxfEWr45_-39VWPtQrNKQRrUkyCXHueOnI8_pKkP1WHUU7knSMiVU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43msBj96uFZDrn9q4AvyI-22-Fhj2wxSNoEMeuWrKOzQ&oe=69FE0243"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGuJA1X1Y9IQ7kNvwGymkLv&_nc_oc=AdqmO3unpBYEpp1eak_SB93lDv__b85464HpDoLYYkwbaNbpT_tUfX4D3q99nI9-X4I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af418IYXM8zN9dRuVNoiFPOwPca8Qm0tETra0Qy1oduoAw&oe=69FDD4CB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLSXrdt8qt8Q7kNvwGiDyg2&_nc_oc=Adp-ZQpRgi8XvjwVNbISB-gsUWyCmDjTY7lj-YjcSocuOSnoLocPZN2t6GxAY_Lp9D8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hBAnCXsoym7scilDP3coBVi-paRCHuGMHirHj2wM9lg&oe=69FDF0A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfRVDNi6iFoQ7kNvwHHTC_x&_nc_oc=Adq1HCBGaiBMFDq-xeQTlPbdEyLVPPGr-SVjvl7wsxm4NLjdpQkEzIBxvPERe8cGBvs&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bwPaFgqeEl8JAw4wUTqM09HCtFSwnsL6QILLpXUy-WQ&oe=69FE0578"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
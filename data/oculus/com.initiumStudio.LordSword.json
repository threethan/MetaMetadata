0f&oh=00_Af6GQ43xqz_lxVZtvrFxWtYqdHpvqbl7BioqJG7ZmZVuOA&oe=6A071E8D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Faq877aNzvoQ7kNvwHRsuyr&_nc_oc=AdrQs0FlSTIaYCALWk2jtNPwsf9mDxmrGOC2PWswn5_8Tv7PuuFvhPmDFqQ1lkFbM5E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4f58cen5-fogdEOzVUa7wwQbQkFeE7C_oxUp-MnKC0Eg&oe=6A0715C3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvcsLllKMRkQ7kNvwFjmO5D&_nc_oc=Adp0lIAR4sVWVTeA2qmCHsFo9gsea9gCGbNBpPBYogELVPseiGpmab-Q1ezgDKXJ2UA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eFcPfRF5EMOXdI8iDhPYSgomUBTwCljMhtybZb3vStw&oe=6A073CC3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9gaaUGuDT8Q7kNvwFQKQyI&_nc_oc=Adp9_xV6ibVvHY4agtc5rmYPGRZS5NpkTdUu5t7DA0XzpgaweOeQX8JlKZIaoMN3V20&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6c1s5ANmr2sTiSJ0iEgLLkPXFRj3hfKfRHM4gR-fk25g&oe=6A070F4B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYKlbVrTj9YQ7kNvwGWBt44&_nc_oc=Adqoob0H99rfIHouokq_jDHxNI8k-3CtIBUdl9ZHgajMH_xOiOomYeux7-fRFFAacs8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LuDArZ6oSoS41EsISAldZ0UGPOJneTOX-TsoPdTiLXA&oe=6A072B29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esQAv7FZjlIQ7kNvwH9XQx_&_nc_oc=Adrj1AEy_NSPK6h8QA4DO1X8BSH2Wl1CTkgwGzAl2dxJaKZxUqoLkt6_D3ceLsgRB5s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71QDQYAPzUgmc-1ms2DdK431UPznR-Udg-YcZ2n0r9rQ&oe=6A073FF8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
11-1.oculuscdn.com/v/t64.5771-25/38984464_881094380084792_3297189931982762456_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95zrWgkrA-cQ7kNvwGNqV3p&_nc_oc=AdqlN30-hl3N6nXcDj2ZburoeJzW8s9dJUYm2_Spnhk-ALGFvVfY8QKXs1i5fCCBpGw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HqpQ_F-ery8yTvK6_7CrkNCBSAq3TmbRzHpOaOX3QwA&oe=6A22DEE5"}, "display_name": "Lord Sword", "keywords": [], "long_description": "Lord Sword is an expansive VR game that offers players the opportunity to experience various combat skills. Players will hone their sword-fighting techniques, hit targets with archery skills, and unleash powerful attacks using cannons.\n\nThe game features challenging missions set in different locations, allowing players to diversify their skill sets. With various types of swords available, players can create unique battle strategies, while each location presents its own challenges and atmosphere, immersing players in a captivating world.\n\nEnemies possess special skills that both test and encourage players to think strategically. Upon defeating enemies, players have the chance to collect their rings. These rings empower players to strengthen their characters and effectively combat more formidable foes. Lord Sword aims to deliver an unforgettable knightly experience with realistic graphics, tactile controls, and a rich gaming experience", "short_description": "Lord Sword is an immersive VR game that takes players on an exciting knightly adventure"}]}, "developer_name": null, "developer_privacy_policy_url": "http://initiumstudio.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "INITIUM STUDIO", "support_website_url": null, "website_url": "http://initiumstudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_RE
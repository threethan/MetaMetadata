0f&oh=00_Af2oUTX9wKO7ytJ_RmtnBdfU-2iHoY1kpmt9tztUeX4MsQ&oe=69D8FA0D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgb3Czek8rsQ7kNvwFT5wBF&_nc_oc=AdodZA2KJ2zb6b002N8EeWB00IsrhTTlw_FUWi5kgQk8haA8DguSSb1j8RCCwbJ6o1k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1A3G_rINIpdTfTJkmyq9R6kr1YVlO00zWslPN534lNTA&oe=69D8F143"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_fUFcllcqoQ7kNvwELKY4G&_nc_oc=AdqWrUqcFkWitMyk1vFwsxUcHKMHQpMPZiN3_p-WBAYNV1DHX3iuZ-32bFVgYZvOx64&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HFPpDnw55hf1MothivQcuXPjpC16sGKYCgAbK-Q7zuQ&oe=69D8E003"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7eHPuTtzbwQ7kNvwHVrxsn&_nc_oc=AdogojVYt7b3z2Kf3HyXF7PagqtHd-PMp5pZtsZKWq7wHXdlNkPwtwp1nYcr3s_MwEU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2g4rAYtp6tgJU4fFAGHwyyV7OJ8VmbuMtWE_cY5EsE2Q&oe=69D8EACB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1f0Ea6GQi0Q7kNvwG3a4Rn&_nc_oc=AdpXA9Lx5NrcyDDgzVR3QnOUO4mt_eTlYSCsMgtLTbJQmCu_-ca2gm9j0m2cU_hUzDg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0l29hKP_RP2LD2SfcvTzCtiR3pIXL88plNtNYuvVB72A&oe=69D906A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0VxegdLnKoQ7kNvwGg53vw&_nc_oc=AdqEdfmhz3z1wtWhb9apcpunUqrUJ3UKgka1aYxmkqOis04nyzrevIB4Oiat9dH9Jz8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36Yru5WfVLVNEvPY8KwhqB61wu50dJ8nZanAubAdTWdg&oe=69D8E338"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
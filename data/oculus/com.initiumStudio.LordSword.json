0f&oh=00_Af_k8Avuzx-MF3KQfhAdHFnCI7iuFrbXky1jWaun6DYT2A&oe=6A41208D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8I72fT3lX4Q7kNvwFh_YdZ&_nc_oc=Adp1FkRejOVmhILdh2ZHZbJ_u_xS9Sq-Gn_Nv3IW1eHCWWPLAuXV13NTWxDQ6x8H4Ps&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-S99NwcxDUQCqlWoBNkH0U6e52xj6LkyCmat67K0pwhQ&oe=6A4117C3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExnzUlpP5EMQ7kNvwE7G-ZP&_nc_oc=AdpZMVvsQklAg9usfIB8DWIj4vi3exDBWlACdEnMFv9585jejiXuqMs2IotlnP008jg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Le-PQTTXRUkzg1WEzzm5pWyMVTEEQ4V3XKw74I9GsOA&oe=6A413EC3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTRRyfF56UMQ7kNvwGAkPrt&_nc_oc=AdrWiY0L88RQUtmuU7QlqphlcxbHiD4KQKx-VO0oxo_GoSjTWhczX0MC0q0DF5ypXto&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-czLQC3Lv4vzPjs6w_VpEhs4lKE8nS_Qz_U7FntK6nkQ&oe=6A41114B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFBOmpcKeB8Q7kNvwHAha1J&_nc_oc=Adr_SWmqZF67l7Z27zP0vEmjktB-okAukrCNgFrY4K_K2IdVO0U2Adn9rJf-kBX2faw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af961HjFPiHKeHCJbx0IbXOXNn-okEGi5-CXoBc0HyEKnw&oe=6A412D29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccSm-UCUIcMQ7kNvwGIP-N9&_nc_oc=AdqthlhnSZRikY8mITAAWV1gOQIexm9Yhtvt2Bjn9MHInzbb2ryPcf0-UGa6a_XvKwM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mwot5HolQJpeTkGLeuNDoGnViPaU-yUpoQHJ_g7tRrg&oe=6A4141F8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
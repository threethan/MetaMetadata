0f&oh=00_AQDJSjkMg9_n_eRkHNwxRDXDs1S7Lsxa502mboVcvJV0Xw&oe=6A56388D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qXi36vyHtsQ7kNvwE8Rs32&_nc_oc=AdpSQWYWWMqZ3szGDsIsAR7U4v1HeKLaKxJN73RAdanXw3zOreKIGeR6hDbFLG22KHE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_RBlEa_tNC39Xboe3NTQIkr_yPcYhu1X1I0xBU0CVdw&oe=6A562FC3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmFr1cIoYvkQ7kNvwEgYX0r&_nc_oc=AdoYHF3aI7GqaR3N2csKBDHcZa6uLE3h26AGIikwHSABdyrdP_Siat1WQGI-UytjBkU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgTtvyQRE0IUuLU2q7o1dpR2Txk5pvOLe8FNwMHnnNMg&oe=6A5656C3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DD1qTFeubLkQ7kNvwG4MgVS&_nc_oc=Adrwukrbq9S9a3jbwaN3GWh8Vj5V1E2wBzc4n6wdvv4u9fTE7mXsW9p2rvVHxxpp2U8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNFMGg7ZO2IHjUqfpbsJPRtiOPPQyNsRakhLz5U_vzug&oe=6A56294B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9s0ELtGQUoQ7kNvwFAT9Jw&_nc_oc=Adr_SyqAuaJrQtpZ6Ty8zUOwZv7DA71_Vj7akXLjgVo8n9A1Xb6r-LdHsuCuxqJ7-e8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD69e5hvSIYM8FZX31ma7nU5Nj17L81vN60n4nSPIaMKg&oe=6A564529"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8Es1Tm7KFEQ7kNvwF9tImp&_nc_oc=AdoLyEiJY4qcDn7LdPDLbRIllQWewnILEFGkbU14JiA7M8ZAmbabRd_qv9u2DTIeqes&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZl_Xl4HudAoOVoKARP2AscMvkY5JxPj5VMTEEq-0Bsw&oe=6A5659F8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
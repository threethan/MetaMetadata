0f&oh=00_AQDZ-qb_dCrawK2qyZuDZNTEpAsSJB47cTI4IrRF3bzgdg&oe=6A50F28D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvIuOJziRoAQ7kNvwE868Pn&_nc_oc=AdoYN5CsfXAKPL6HyD9N_CxFBNQe_WAQcdwfIRGLfcrrwgj6667g6V8tIevfq5XdLdQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQeLjcsRlE_vKQUshxEWrpF-OUCCcrPDGJAQb-6GyVRw&oe=6A50E9C3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkIfIjPMGQsQ7kNvwGYTUYU&_nc_oc=AdpavQfVYZhWfj77C0A94Ug-CG_1OxC5M4MvMZ8FMPZamBCGv3Y75lFelsCWo5QF0aU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9zmzR6yLlmgrKeD7i273YFklyz5SyzJed4m8CQZJvxQ&oe=6A5110C3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Nc2UHD3RlcQ7kNvwEZ4Ebc&_nc_oc=AdqVlO6i_1CrFDt3-z9nuQt7X77RZzCLSf14ApGwkjaFMdNkyY8kKBsMItAUebzfQxE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjqOGSBbdMbc5-VNZx2GApczWAr2b1ddlUiA22ulBm_g&oe=6A50E34B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNY5675bajkQ7kNvwHg11V0&_nc_oc=AdqS8L0ydc5d28Iwc91CEmmV7Mee4fTNY2f4JbbewMopSN5dUhB4TC9KTM4JRcHAFHQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiDk7InhKNcnwCZSej48DbyYYZNTR8-yAR37Nyu9Ir8g&oe=6A50FF29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9Gx_i48PkwQ7kNvwFMVtSK&_nc_oc=AdoZUFBb1yDLkpHWLCQXGzFmKCItszhBrbNUvL0SnzPK8NmimPgp2VsTQHqebZI7g7o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUOKoAZ2uhVLF90CPFQhlki0PHWFCZjvPQL3cqcwTFyg&oe=6A5113F8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
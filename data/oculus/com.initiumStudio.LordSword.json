0f&oh=00_Af5uH974T696ECm7sCBb9jsWKaMouyBJiHL0AmVKEXvIlw&oe=6A159F0D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02CiNX0yTgAQ7kNvwFhFwIu&_nc_oc=AdpEFPbvQ7sewxg0N_2FttZx_RYP1LT2HjNx8aDhPAdQkhxFRTJMfSfm4EqNuKnthKA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JGFf-RDdZLXQKJdcuOxe-xxpEEoSNOrVP4A5qxTSeDg&oe=6A159643"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dwaQaAlS5gQ7kNvwH9mFYW&_nc_oc=AdpeilDkdupRAT6YdwWFa6npf7yiKVT1Xc6T74MTtVYUf2Zj1Kn79UHhedLm6hD8Glg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5088MAh-Y5QPZF1fSWxECpsmcWUNAbRERDkEv1-oJdRw&oe=6A15BD43"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bAncdVuqZUQ7kNvwF2TWPZ&_nc_oc=Adphhp4TfVkGjaqi0r8LqPtGZK23-PAP335Z8mxcWsjhCM5MDIIE2YxefTpuMd_KTEU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5agD826DEq3LBurOU_iY3pdtTz-EmTynNYlxIxWv451w&oe=6A158FCB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mf-4Qj51D8YQ7kNvwEFjady&_nc_oc=AdpsJrU3MTWgoWGeiJ1vP8vKpCoiFEQuCp5AAVzaGZeVxKiJLAtP9jcAKePndhk_v7E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jI8maN7-pU1-2aWqdJRP1lYkTlFFstF3qNK9ed-PnNQ&oe=6A15ABA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Niq9aEFI2dQQ7kNvwF8XMKc&_nc_oc=AdoIDsWDFN1fw55qx5Oj59sTcTcTVUGRQKhTyqjjIcUap28RKh1WrtlmVvublNjTg-g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nmltehwuQWOFNNzV5wG-pUES6AEzd-IqtM3Ov8NHo1A&oe=6A15C078"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
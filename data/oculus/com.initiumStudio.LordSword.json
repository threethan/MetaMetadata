0f&oh=00_AfwxoLKtfRwBnYnozZCI9FMbZhcAuRrurKQHOvG-zqHyjw&oe=69CD1C8D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JLkGKy5-hsQ7kNvwFcPTQL&_nc_oc=Adojdq1Ynyowr6QLgwZ5ArXyHQX67mmuNyg6i1i_6w34P6vTDOfZU-ad9kbxjAJPwJM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0SBHNWCB5Typmyg6G4idZgeMU7se-ZEXcNpvgpZhotA&oe=69CD13C3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-B-i2diNnyUQ7kNvwGj02e1&_nc_oc=AdogN2Jz1OOj53SFA97h-66NjibfWuajCqbF9sZjVQSbO48KCT1QtDifrMHC4MywgWE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6Vi-7u6f-q545t-0f6qvXxtUrsmjBsgVHQOIzkr4GKg&oe=69CD0283"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IA8ID8QFTpgQ7kNvwHCTPNU&_nc_oc=Adoebv4-bgq2sIlWdoiAXqeZ6dmKeiUK_eaqjhdVilwMSEZuQiuO7H7rE23rcVAwAG8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyM-aBg6JW4dOhME5TiS36urYwnsLC34q1J0wW0QZPX3w&oe=69CD0D4B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H97pMuKT4NgQ7kNvwGhXJN_&_nc_oc=AdoGXh9Rt6cDHAxvn32rFxdnIaVdse9o6mrwNFBMUuntYHyj5PTXKrxRNXmi2oe4qOU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMILFJBVMfBcyz8Zpyr19RrauCqu1CGkR_0AHrEjd-7A&oe=69CD2929"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iq2sgjpSoz0Q7kNvwG5UjtS&_nc_oc=AdpKXN3wrkqaeM3QEw5Q5YmI0vlnzg14ya8UMtr3SZBuoVOX5rjjcAlPSKZJXCcn10I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzO-JBsdj79zu-ptMvmlUiDBU-QJz1zNtxvNkLeIKmavQ&oe=69CD05B8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
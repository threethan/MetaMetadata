0f&oh=00_AQCdUA4ZHpAS5rAPs3ASEO02IHexrY4L4qgy897yBsy2Dw&oe=6A6F450D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnekDRnGdVQQ7kNvwEmv5-c&_nc_oc=AdrTVLdP4zdoDAKK3lpjIWSxFpvl74YZlxfhPG_q5znd0UAsAQ5skKQuj1BcYi1gv4I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBTpxXOyXfEGe005bc5Jci1hCmvChSeC00nZ5MwXFKWA&oe=6A6F3C43"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNoLyhbj-FMQ7kNvwG9uOEV&_nc_oc=AdrDa4EJ1IFbb_pvbn6UCVDe-qWK7egaA-1TsBFr2ZRx0w3QaqmH4DLvVb_ewJFO7nE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCD52PVX-lViWQibWBftZAU-O3Ptnj5Vv_fvB-kT5Z44g&oe=6A6F2B03"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NsFz4xCE1cQ7kNvwEVtCDa&_nc_oc=Adrg1nnmE3OTPkAApoVArQNSA_xR7o38YcYM5lO_lWSE_V6rGxRN1Ddio_e7ENyw49o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLmMg_t6MdPdnBxkuLq4VvXLme53gqoN95K4T3aja7Xg&oe=6A6F35CB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLUhxnHjThcQ7kNvwFhAhBB&_nc_oc=AdqEBxiZGDv5AaWfX52NuXFGhEzA3zUfnMmDXkf5Q5drgP9a_TSKDpO2AQungTqbp4Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIa6uqQ3LScfIrM31_i_kxuFTAQYHBDNrFDNLinXHHBQ&oe=6A6F51A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyKhsRU9tIIQ7kNvwHXVNa5&_nc_oc=Adp8FE_tSxEfLw__KKWt3LgklAlOLfl7vwZyx1QsCXsC30NddKy3FrXREpafaB-5Urk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmVGOvzbsL78OqN3kXtNkJ7mqtvhuvyixFNsGOlwESDw&oe=6A6F2E38"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
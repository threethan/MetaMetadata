0f&oh=00_Afzvl_4LkH9B2Q2i0x9zt-OBUzQguc7QW942eX5h4q4oiQ&oe=69C5338D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFum6DzgVv8Q7kNvwEFyEv3&_nc_oc=Adr39L4mbflKykIZ-onnh6xBFU6mb7PbXBjMZYl9GnRXRiOyevsOIxAgIUn8gZmvL-4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPKbVbEf8l7Fp-NYQoenIw7zT-cLk1jXBauCLlYZhk3A&oe=69C52AC3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-EeEeQswVMQ7kNvwEv0MlT&_nc_oc=AdqSdYG9mFbCxQm_cK31ucBYnIdHyFr3sVZX2IN8lPsTgHHh2SVDk7KHovIpleamP1U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwoAbbJCm8ihLEv4sCdHpalnm3AKfB1a6Pfzc22AQrJTA&oe=69C51983"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBQN8pBxZEcQ7kNvwGq1gaf&_nc_oc=AdoZv7yKP0RQ8VuqBfMWzEhO_ughbistgBEPptMxCBNEvCbPzYB0T7nNCQuDN93oRHk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIrfiSiYS_cJQLLqJ8RynuOTpjYAe-6WQbD7fDwW0iFQ&oe=69C5244B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BeA9baBSQ8Q7kNvwEUigU5&_nc_oc=AdpTfmNBVGOo-_yRQ-HlMCgMPEK7mtFMG2NWttrL5pnMlB_RzqQkNi7fruvZnIl-xwU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-vHMLpnquAwkNhR9Ia1ahI5ZI6xIHvFFoMV_jyCAHag&oe=69C54029"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdgSGlVWgOMQ7kNvwHCeDLH&_nc_oc=Adom_bvTnEuntU8eJSD4lDSBjGpkbeeiZDRpQsQCq5QYKOdS1ze1vOG1vJsyutRk_UE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJGDlGknkjxRYJ1pqVAtI_SFVWG3ZsJhMPo88yiR8OFg&oe=69C51CB8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
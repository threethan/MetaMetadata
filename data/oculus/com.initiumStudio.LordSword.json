0f&oh=00_AQN1FmKLjiXREwz3ORxacd91t6EUXHmfaolt0mIZAKyNyg&oe=6AC3A50D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5FCLN6norMQ7kNvwHK2zMc&_nc_oc=AdqjyZO3Yb3tzLT8x8bbHywVg80ZXCTV5qSHpJQTHivjkChA2VMP-DYw3c1aIwZOJxc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYn9UjlrDqUmukCctXiYYywGWBygPKAsSvhz9KRamOHw&oe=6AC3D483"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQWKNtTJNLsQ7kNvwGo4MVf&_nc_oc=AdqMskGMxcikmyf5sVesANYjQgklsl-HGJdBgzGJbkpWRakem1NFYfyGPGa5tvImJ8c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcOovDzEBxbo49VyYSr-XjmMOOeQsgfanq8HPMM2J24g&oe=6AC3C343"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tk5Ad3fN9UMQ7kNvwE1fCP1&_nc_oc=AdprUoL0b8bVXk2bLhdUIB180ngzRwL_8o5TBg6rp5tgrGivSjk0qWUr-Ee2Ihx8OmU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDXVCFEma1fjfu-EOGTJlBzJ-E4FkYeaYB5ASkh45TRw&oe=6AC3CE0B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrAjWo0SY_EQ7kNvwH_Nm9E&_nc_oc=Adpujpd3xZZ24FoAfElRBQ8uLwxoUJep_KnE_-syploeOXjTUH5PZbXNw_gRozthMUM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtl6nTCJ5qHHifc46NozBwwHxOfRTiOkxy1WPvt1J2OA&oe=6AC3B1A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WU4In7F9WQYQ7kNvwG_64Kn&_nc_oc=AdopRrHebOnjoH_axX8KEx6EWxte0m4zKZN3X10uajlZAhO6j5kD6t5TChBPvlMwyeI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXUzReWRriV0OqCuJztFfECurGSu9Y6R32GosiqK1lJQ&oe=6AC3C678"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
0f&oh=00_AQFYswxa2-OyBsKyQB0dTezC0on46zTrOjOcfzRKpTBLAg&oe=6A942F0D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJ4VTnR8i5sQ7kNvwFejM0d&_nc_oc=Adp_Zl-a7EInkh8VOfshrezFPC02ldFfeTJjf-EBsqBhYP7UnyR_aGjmmVlkZZGhrFs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8Na5sjaKLtFo3n7tkhwGPWwGel8PsDoIBFmRKaJNrfw&oe=6A942643"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwr-v7mHs3cQ7kNvwFpUtoY&_nc_oc=AdqNEK72c-SkDOo0jG3IYqICzuZzszt1eH1AYWWK_mh2-CpZWPjAdT06u44AaDEHyeM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUKIbCoEOEO9njSR5TvI3LumVFzy2rSxOPprZd6hnVYw&oe=6A941503"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVhw68DRwhUQ7kNvwHMssLq&_nc_oc=AdqrvvYI1w7mDjJgB_lAnWMQroLEnw_BBj90_Am9QjxYGpSwTPfCrsBICQtodD_cdGc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWmA4PacLV5ZZyuQwRdIi6rahfzvf8o_RICf5OTainLg&oe=6A941FCB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFgfchf0874Q7kNvwH0sKjH&_nc_oc=AdoB2zpVykpucUeuYByXL4UgzlfU9StJwg7LBxtPc2LLSGZ4v1kckdfQ1__9coWpLk0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5t-y99PN5KwjAcWquAye63f8UCGb4NkhhvpxgLf4T1A&oe=6A940369"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXvCRir7kWsQ7kNvwEGpTLS&_nc_oc=AdrBmAeNrOtm3oxNt6abzy9IgW2nXE-oBlBNmAqRJhTetmCReln_npHRyB-SWs5MVC4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZJuBJNGPlgQ10huYGomWGiljkZmYiBhoMiO3iIrsz8g&oe=6A941838"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
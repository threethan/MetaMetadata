0f&oh=00_AQPF7d0yhC39qKudfcpVqE8et6awtsdQRNsEOF-zQgfy0g&oe=6ACD17CD"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsUF3k_0WsYQ7kNvwHrlet8&_nc_oc=Adq7pUVPfs2nEppiWT1MuYTZSuJA55T2uXfJF6IUoCH7d8BPOgCywWRhDbCWaEqieUk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSAeUx4E3ghghxijG0fyJ_4Dt_A3I1aObvxvPvE25j4w&oe=6ACD0F03"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVrtiIWkqq4Q7kNvwELDeAJ&_nc_oc=AdrnIjlccipoQ7iRTldogrw6lUXVHC9xHu1vktk_X6rBj6ime3X6doXqdVULuaOMwnQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvttgDMTvP7RbJWXeU2C92SgKOL9VviYC3hmaXMEi29g&oe=6ACCFDC3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPumfr-PQX0Q7kNvwHpV-is&_nc_oc=AdpMqLWmn0HtjTZKOryFrrgqsEtOT1h0SGxwp1RoH2a_qdmywMTRzT40Kb7GZDrEeUI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjQbNapNSRoKceOBMTd6QDFtXOTM12-5jAGTjNYamN9A&oe=6ACD088B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWz5IwJ14KAQ7kNvwH-65ws&_nc_oc=AdqiZTgvdwEsNkoADaqAKVeMBaEJ1UI800Tw2aw3_FqLkLNgWe-W1aYN2L_GEBfswoc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVFRE792YJ3YhwJf9oZeBEtaWrd0goTSc7LhzYsiUx0Q&oe=6ACCEC29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfdSxXA6XVMQ7kNvwGuRraB&_nc_oc=Adpmrut46LKUMx6vfpy9eBBRrK5X3PlEQjS_YTkUKirY63OPXsUoEYnNOjgpceDaBKQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_7Je-MHqqPGmlXu2bSNPQjEbLBJ8nCI8b40FCRVAI8Q&oe=6ACD00F8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
FreyF-cZoymiF1GE3ej_rgGdMnw&oe=69B9560D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNJ2PPEA7vwQ7kNvwFusSOo&_nc_oc=AdnmSUnrRuv44eOOdxpSB-V_W36vpdZPNnb1I9T1SlIfsx2EeJtTfR8mjPDOLIy-EE8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxLaco91Vk-VmuMKEBEQO9vDZQDNyPJSSbzbntPVDKEcw&oe=69B94D43"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biLmnxqDkmkQ7kNvwHM9MRT&_nc_oc=AdnGPxg7x57oyj3XMsuDLavm5qVae-QZECcxOd8PAmVv_NCriUGSOS2gKEGBQDNWoYA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw2UIAf9l-Dsvm0V4H_q5yauhHtSUbpb-ntDXubSpx_yw&oe=69B93C03"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chyvh73e9W8Q7kNvwFSlyLL&_nc_oc=AdmhLI4NP9AjVyqluuqH3Hce5f5n3-1rbML4iLqJGnX8wOa7rgR494KZrtz2GFSZFzs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfylaIfADMAorAmh08BFzM4QElUYElSWoIo7WailxTqTag&oe=69B946CB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q935vVkcMhMQ7kNvwEJ_OMm&_nc_oc=AdmI5wmBDM_dc4Z698gy5Dhhh1LwCSNP-2S7Qj02lETBYo76h9zI12FhCyuW6lditso&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxiZhl9y5fcvoEeIT8tkX-Un2l4wakJr3g2zVanYrHJvA&oe=69B962A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VEgIKdZQsEQ7kNvwHkBl-F&_nc_oc=AdlQunn4GC6bc82IXajURAhy9BmwOYCjk3aDRSeKjvpUnAVbMoKarU3FloGGbThpR-k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxOdvIZCsi0Al6zaWr5gnfbhzZ3QxjNEeLR1siwQ34B3A&oe=69B93F38"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "website_url": "https://gametriclabs.com/", "categ
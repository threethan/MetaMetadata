0f&oh=00_AQObT4XIhPGaSwXfhA0gQIkrZthJkznJcM--7e7LFAaMRg&oe=6ABFB08D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTTPv_HngngQ7kNvwFFEFlh&_nc_oc=AdqqnF_jXKQ0KG0Ibe7iIU4wQkLGV1ScteoxUzreTt1YPVMKzl1zSp7_E7u_dVUo2ss&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO01vG17jrS3wXtI2wdjLpNrYSzpYQJdEBLRLr_7hFSgQ&oe=6ABFA7C3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--t97O58V_QQ7kNvwGzt1Vx&_nc_oc=AdotIZIktuML_ZqT2jpYwHPe4BhN2Oep3M_UI18BIjdpi5accDdl9W6Tu-bH4cSqf_I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTKxwzV4FplbNUZyQCnoCyX9WU64Xt1y1nRhNK_Rw9Kw&oe=6ABFCEC3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZ5CgkSIKhgQ7kNvwFr6zjX&_nc_oc=AdpT6rxOWr11PoVDNpZrKrjRphsOqhoyrcHeAEo51wQVSh_48eIwmGeSWJwFiz2Tpks&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZL52ELzP3xG2B4qcfvcbS1cGGFUjEFuMo_2HCM9EiYA&oe=6ABFD98B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qf8vePwwsn4Q7kNvwFLfxIF&_nc_oc=AdrsI9fmElhTN8hBFgvaW5y0V1qkh5lulePpXPqu2Eo-2va2gtJXKgT-EUyslABEqFg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBQMl5dzkXxTXJQC8t9jwGK6ne38Cl2az8UvUU4DCjvg&oe=6ABFBD29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ra6-hj5-48Q7kNvwESrF9l&_nc_oc=AdpNZZMvH4i5dxkWj7OpTJRlJ4yBKPbh-HOEI86w15MFR9e0QyTqbEHleXMtYkJwqiM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmlM9MQSCb1HPAKJEAshouRuo0Uyelqh-sGZ6jEljJLw&oe=6ABFD1F8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
0f&oh=00_AQGtfygSF7ehugQQZUsC_In6IbWonF8gFXXuPpUNRJ3BQg&oe=6A830B8D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l52vmbFKFukQ7kNvwF0ICRr&_nc_oc=Ado1bbpkazP5a-O_gkvctKV_qRkCklEzuNeOvyewzQ3YvRHicOdaQTgIGlwpzkW1rzM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcs9d5fdvu3Qm6YWV8DpAX4oVzIzFflxt0Mal4LJB8cQ&oe=6A8302C3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiTjpgk5q3gQ7kNvwH6siKw&_nc_oc=AdqwPP94FcRqXc2pKx71GYlVGBvmSnSnE4wI7rrsezXObuKoYfjIbHDmKrbMZfX9Urw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGivebSC65mHBbmm9UpbFLvaCVl2wtEt6bHatxbsRxiow&oe=6A82F183"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXRXQ99WOj8Q7kNvwFDy2Ft&_nc_oc=AdrNtvyFCiWslsnYW_yBArE-SK02l29n-In9KeHqkj91l5gcVhVIz9sy8mkZFQopEoI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7e1UFzBjxbYG-vi-nALiDw-MZ56UBCm91ceWG_f3IaA&oe=6A82FC4B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNiXWy8f6lEQ7kNvwFexo-0&_nc_oc=Adr9ZdA2sRrpRvXqU6EpNtX8oaq6IBxI8WFCLB29hw54tYyuxbpFqqXljghAwynN84c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyh2hsWh2IM3BbqXKQBJO0rCQirr59MY3wvILRkmduiw&oe=6A831829"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1Ch2YlyMoIQ7kNvwHgeBj4&_nc_oc=AdrKNp_ENdyp6jQW_TqVKtZ8rIP0diIOb_rk1NcaQBpPx-s89vjxgp1LhxW9DkjhAlQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGil9r7SxKj0QIh0DcfSKe6fYshBz1Vs9QPm2cEkh_LHg&oe=6A82F4B8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
0f&oh=00_AQOl18gZnpIAJQwGaSgWkHYzmFgKhzrhBp0f0sn6XJ0Lxw&oe=6AC7998D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttFDhpGyapoQ7kNvwHG3bI9&_nc_oc=AdoiIQ22zduXxn2-I4WlbcIsMle7cxrzotU8IN02ZxfW0G0EWRH2d_9m1FLX0jES0I0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKAixQ9ITPtgi1nNBVZxArMp3KfRCEwlAt5TuEZ9GCdA&oe=6AC7C903"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TSvKfy73XAQ7kNvwH9OjLE&_nc_oc=Adp_O8DQWSUWcKVO-tuZnkJj87V2aNypbT7kzQzfcjNtpo7XFjgR3G-rVIx481MDxz8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoOxsLsHaLGwl3e2aae3BWVNEPQu5sLuhVPm9GAn1Ltw&oe=6AC7B7C3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COuWKl8gtPgQ7kNvwENmxZw&_nc_oc=Adp8xtzfO71YYYKVwQVjk5zcpATyuSFhy6daHqwgAr0I48m-z6ZB2Z4EN-xcr5R8CNk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO97pyWxw0GMgpoVgfHIp9eqDmgtJAyu7vv5Mi4yo7aVg&oe=6AC7C28B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZ7S6hNngrQQ7kNvwENcUG7&_nc_oc=AdqbGmkX0VPfC4ywD_3ejDIhzbPwuNhsoa6HX08GL82yr-hnv630VSGnI_x-NFPm1ys&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTg14gxFX1LG2ztOonZKvImUWgWn16U4ANbseW_FMHnQ&oe=6AC7A629"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1H8KArcbcRkQ7kNvwGibIM5&_nc_oc=AdprtY9-xMHbu4hl_DMdWA0Xgvb8EnYEJzsHYk5wVA20XJbzBgFfz7ll0F9GsXLxQE4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7HY2enmRVzeAcIV8PtBmTZ1mr1lxfjv7YvFXIhy4uPw&oe=6AC7BAF8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
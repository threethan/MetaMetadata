0f&oh=00_AQAHhmsU18VJLuteuJANsd5UPzQOSUh9og731ZWPD83pjA&oe=6A49098D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7hfaAWnt9sQ7kNvwHIFLGJ&_nc_oc=AdpWgljgkhXYY8m9uvva19U3UDYNKI_97hcsFD1e724oFii8sHqanL1qN3OGFd5aBKA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqkMyaHgeEJEBK7Kh-HV0m6piB5ztvK-rAa_x1_PUf5Q&oe=6A4900C3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GERayy48encQ7kNvwGUWErw&_nc_oc=Adqye1vfM-TMHVv2Hj2jjabhib8Y1WRPjyKh7tZxn-95PwG2rs9fGl1Z4Z5VReZKl6o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmfXUnTyhKq5VuRmtx2KmMzMEP6J_4Ljn_eRzvW1J0wg&oe=6A4927C3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgLT5nL6BmAQ7kNvwFlMKaW&_nc_oc=AdogA9uPLWgQDrjNOovqI3Ph-I3Wl7bhyO8333USYM1KvtFJoV0ymj4zfTaxOlDuwNk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDsBv8b7bKxqnYxELIimkXoTgJA8dJmkm7ZONdYRqxOg&oe=6A48FA4B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHIzBauyf7MQ7kNvwFdj2Gw&_nc_oc=AdoIrRTpMU8deYy0fIt0NE9LnsG7Y4Xy2jIA0C5lGUyunr2Bke-VgTBwyY7ARJa-wx4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlhnQhwbPjBl6QocVu6mFG9rMljC_dlLGTJOdfdNKj4A&oe=6A491629"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZwD1VZjpPYQ7kNvwEK1sMQ&_nc_oc=AdoAISauyPo_8dYuxUf3Nz1VSvU_lJVnsiwNKkycCVT4B-mgJo1O17P7YqYJ9e4YuCE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAH8AsEZaOC5mgwviiI9AWvI0M8xevzpfr2WtdrInHkyg&oe=6A492AF8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
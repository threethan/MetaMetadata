0f&oh=00_Afx0rTwCFwNXAprVA-XNDjST7A_sb1wf74dIz_L76CXx3w&oe=69C6850D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFum6DzgVv8Q7kNvwGep3me&_nc_oc=AdrWDFvYGgqetUO9iDQNFnq_GEiEfF9semYy4UmfMWxRhgDGb1nsYsnlWVELMY64VFU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQs64r4AU66knoIYLipcegd5isg1i87Z0kkZKR262k9Q&oe=69C67C43"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2PrQcTycTkQ7kNvwEA9jne&_nc_oc=Adoq6xms3dWTVjsTAe5rDFsK2ckfI1YZw6BpkqPB3_1TJ-ErqR6h8I4Y2acMaFVVyqo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWgfjS7_vPzFugaIfYJ3xxRhjuu_p2K2AAecJaMWKaOg&oe=69C66B03"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBQN8pBxZEcQ7kNvwEDj6If&_nc_oc=AdoXDMNvfckNxxRzbZ5gM314diqDSwtdIK8TjpOGMvCH-lV5-QSGw3mGx5Bc0ilcwzU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyAgk692Km1yAzkxYv1iOd24Ofleb1Yul5NOseooWX_uQ&oe=69C675CB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUaPwLQbH7gQ7kNvwFfB7h4&_nc_oc=AdoPDEIMW5kgDEaGDD69ZiPOJuhogGQdLAx3puHAGi3solp1Pk0ts_TnxIOW0lheIKw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw6G80fPqU1nvGqwgY-oD6PLHGD1O8SKRwp6sLWZdRyZA&oe=69C691A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lj8d1-5z_3oQ7kNvwFKOKjs&_nc_oc=AdopIgUi7AmZLmEsJ55KRdWeVtKkPgbdEtrbzYYtuRmoV2KJH8lYwZ-5fCpGrv-HMhQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwudMAOvBBB5W9QyNmuvu2wqEGemgFeYD3-Y4hq-uql9g&oe=69C66E38"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
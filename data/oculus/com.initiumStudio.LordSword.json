0f&oh=00_AQBFCPqL_1_t38zb-Y9qHtvKhgSRAWUgvsxmtTQ72_nObA&oe=6A6B508D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ix1ennW9ZR0Q7kNvwH-XRWj&_nc_oc=Adr13tcBOOTOVf52v-h6YrlpYnGWZIIWCEI4WrWWKxu1LrhHVEo9hfF2nA7B2XcxvAw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOqv5ltmu9odOiAUSDMUoX3Q4Tsd_ONPxUv-NI89sltQ&oe=6A6B47C3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZ0oxNirr8YQ7kNvwH6litE&_nc_oc=AdqEq_1sADugif4Y0b-LYM31MIDbh8LodFtAQoxcPpDu9dpp3KDS0L4PuntnLscq8lc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFErBMduv0rnuLQzFEc7j7sBRaCCpkphS4MwXLiyciAw&oe=6A6B6EC3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIGhs8TbsIgQ7kNvwFGDyrB&_nc_oc=Adq1t6c-eL8gMaoE2_7BUcwXWvEaI8leYvwOetrTJ9PDzbmS8Y9fQ7vJwuVAxtyNn_s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAwgMpUpnt0lhDQX-qQcC3ZCuAdHYygqbX8hNCyikfXw&oe=6A6B414B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkLrlsFbNC0Q7kNvwEt2cJJ&_nc_oc=AdpwnojcdOpiuGP5I1CvloJOAhyYFRR-22oHrgecTFIHGwAK6uxq9er5qBrASkQM7ik&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1AIgs5wneXCbijxPV4X9meU7U21BYU2IuCtuYhtDylA&oe=6A6B5D29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EyMrPyIMHgQ7kNvwEsQwaU&_nc_oc=Adq63B50Nge9MQ1DAjEVmZFpoAa1di6R6xpComu3k0eKPWM50fb27KHW1GF9OzAJabI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdGIJ9J-msWh26GOb92F_6lgnuqEGu2G0E2R406mpyyQ&oe=6A6B39B8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
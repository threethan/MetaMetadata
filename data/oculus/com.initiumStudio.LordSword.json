0f&oh=00_Af4MCtWNtmVUYB5RDONc8eZ8DnM6-FXUiH0ikaXxTk7aww&oe=6A202B0D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFNGaIy4HJEQ7kNvwHyN8f7&_nc_oc=Adq7J43-j0bYi4x7WzeuKl7lJvxan-HpeAf9XScUYhE-sdO8HRRA8_wdYPCVzn6BgCE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GSjd6gB1r50zurgNPp4Xr1A2dkxTLU-Xn08nu8Ko9oQ&oe=6A202243"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5H4DGdglYgQ7kNvwETEEiL&_nc_oc=AdpGjLie05tJ3L4wQlcw4RIYcdBuVjaJl9k273Xgb39T3AJHmbWAg3TggxnTt3KrsxQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7018gi1N8hKAfmF3tyXNYe4HRICkrNnY05ICUfhAIo-w&oe=6A204943"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wT0NS_Ss3ssQ7kNvwFC6pmB&_nc_oc=AdqLJPUPAD7jMhs8abo7oPwk87WRFDMmJ4jdHL6FZrST1CiQVh67dYgr1uBcrzTs3W8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XhDJ0pIWNKtMLjJnuPdqjyxU9KjtnIVaMLKZblNmANw&oe=6A201BCB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PURWJkkBag0Q7kNvwGKXHO3&_nc_oc=Adp_dME33QN6nBx-65lvTAEq9gGIq-TYPZljHRzCc0DzRs7ZeU9cz30TG8sWrdOM60I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CnrbaPmfXoIgQm5RBFtCSa08U3coY0agdDVyM4ux1GQ&oe=6A2037A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E08OcDjvJXIQ7kNvwHTShnc&_nc_oc=AdqKabHwR2FtT3TcI32qetLHIoLw9AHDb5fi7Gvd2WZXuHGCtnu01JRvsvJIU8j9ZI8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yJ2ywH8jW1GMJiG70Xo3qkYyFmAtbsy-vwVhoJMSwqQ&oe=6A204C78"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
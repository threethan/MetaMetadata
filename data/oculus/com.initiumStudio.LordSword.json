0f&oh=00_AQJSMKu776CBF5LzV-8TkYNhlhIhDVFcFrO9UHhOl2Y9yQ&oe=6ABBBC0D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_1Dg3btXjIQ7kNvwGaeBM_&_nc_oc=AdrHHV9TaPN_TN0ajhWNYT5-C-k2q0Rw3WWMyw7yJIu9rv84ne9C2w-lt3iArABFzPo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItXOi2K8fXn0BSJGIjNjdLfDcViHoCmdKr_1K2WGybqQ&oe=6ABBB343"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFDOb08JGEYQ7kNvwGZ1nrc&_nc_oc=AdoChS-G1Ynbrg-NBmw_mVRlMvsW8M9_j36xI2Hc1Y4Z7XbUEps40HaX83yVlWI24jg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqq1S4cLK7L0OfHoIWtTO_hWlMZEcwoq7-MlUbDdtY4w&oe=6ABBDA43"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvtteT1GpnAQ7kNvwEAPIGc&_nc_oc=AdrshZo9jxaLKRm7ij9fzEYh1QauGLsc3uHXAyO-wQdQsK_UuvHHozTbrVz1862T0vk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzKBGH57mL7K0_KHfXZomAkYmdfuoNdWqf14ZEhZsvZg&oe=6ABBACCB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hgsjwADs3kQ7kNvwE-308o&_nc_oc=AdpMJ3iH8U3FrNPqd5j7sGTQJUfuH54GVuMo0ir4iOXPWnJsIm0C4RieEqIgsuMlrME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHwE8hw2oGk7OgSwaaXrIH-u6Tzh1tGT3Ap2tBNwCkMA&oe=6ABBC8A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHq2kFezeqAQ7kNvwEcNTn_&_nc_oc=AdoekE8Dv2SRvibLNwzW3ZaMssBWHrq7AyRRftXerzXXofHAKPf_JdapIc8wvsxUwcs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2Y9T4HooAy1hgnF5XN9SaRl8NQLB-lpP0GdWoiX8ILA&oe=6ABBDD78"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
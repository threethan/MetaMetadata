0f&oh=00_AQFtMTMxdLehnJT2-6FsuN_8bfNHmHKBy5Rxx9TVh0qztg&oe=6A97428D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raexbDfRQ6kQ7kNvwH2HzgO&_nc_oc=AdpVbawdjwNywqzY0OuCFQVjhmMN_71954aRpKUa7d1qzG5bThGuxtXRZfsYIEXrc4U&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2dDcl4bCbFANzRowCAclnGM5ikttKRbI5t1_VMHa77Q&oe=6A9739C3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwr-v7mHs3cQ7kNvwHU-sDl&_nc_oc=Adr9drOHgKuiebmyngQwGS4eeBqkc8BxzJvyB2pNbbnJfX21fy_3FVSZNnTOzF5QCkg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH62PRy7R71bkFkr4bvVF9YWhRoz3cTRjj6Dy2eLvxjVA&oe=6A972883"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEnX7grRHEcQ7kNvwFG4U4d&_nc_oc=AdqrAzeKingBXftNy9iCluki2QWP9atGWW1Rtz_KpRy-KGJ95T9Rkh6SMzA8wRR5KAc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRTzSWApiLxHSRR8svk7z-op0cSE4ufp1wWrFK6ybHHg&oe=6A97334B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFgfchf0874Q7kNvwEgz13q&_nc_oc=Adrmn2Sb3oXRGCxs6qmYVLFQPRyEn1oFs2JjI5emuw3rZjVGKvCKwcM5gAWiaK3Gd_8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGp2U2PJq1N1wGOZzktKEMRl0fQWK5nHupINtAoUQcJHg&oe=6A974F29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXvCRir7kWsQ7kNvwHTAVxA&_nc_oc=AdpvcqdcEuEv9fdoeTNobAEKNy0DHlVzDH2sVSTl-15pIqAx_RgHvPGpyJN06AI3byw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfaVpvRNpXDTBbsbrFtUPQooGuiyF50oqtGefsRPJ4xw&oe=6A972BB8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
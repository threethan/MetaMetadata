0f&oh=00_Af4ODppsHiXv74KRz3EIP132zj1-RHLIvZViJU_OVHb3gA&oe=6A00870D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ek0qqBWngAsQ7kNvwFVrIEc&_nc_oc=Adrb9h-aFjJXOjt9xnL1ZZQ4bAgOQ4Fio4b3Mm4jdRgazUJ8cJNQp8u016FRuAnNrRw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53RIPYiUIMH1fRsIBUkog0G7PhUib8hrjF4S8itfQ1sQ&oe=6A007E43"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VF57W_Un8EQQ7kNvwG3n0Ei&_nc_oc=AdowtsOYJ4oXPzqcxI6NSFmvQrNcZJQ7VzejddFYK54pUpA4KPsBnkf7iNOrNyTENxQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4H3m1m7IUvQY_lN0e7ZVQzFPNXbzsLx24DWKAmoXqASA&oe=6A00A543"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-qbwOfkQRwQ7kNvwGvDgFe&_nc_oc=AdoUNC4TR6BujZWiDW27XBjmiskDiklY22O5WqzOcOgEfNcKHVQXh9bTz9eX5V_Pmlw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HlFjMOo1vEXA0qDtn5Lfb9IeYhnPi_OWLxy_vh9Q1aQ&oe=6A0077CB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLSXrdt8qt8Q7kNvwF1oN2c&_nc_oc=AdqIPdxWTnBMf5SIZMBUv4iaHQiEU1ar9w3P7Hrj9oVSXT9t5Y7sKmHfBv9zs3aEz1w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DKYhm-sl7urDPtpD108kiERoUgtW3iFiF45fUyoG4cA&oe=6A0093A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfRVDNi6iFoQ7kNvwHdL63H&_nc_oc=AdpcD0lh2pif511DkLBi6h_9ZFWCRkcGkY_vRu-3iB9Zk94mHNmwaqYFYx0oZJL_9hA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IQlPL2Wjg9DbipQYr9ZadHP-1jDqPU8Jns-lDFo6nLQ&oe=6A007038"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
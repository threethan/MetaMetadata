0f&oh=00_AQHfBn_zVp-OkXDSAbK7F22ji--dD5oCmfMaUpUlc53VtA&oe=6A87000D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlxZbfiNy1kQ7kNvwHfKhaP&_nc_oc=AdoC698GzQQzmuJnguZjEv9Xbz_TPANdeOZictWqOCKpLpRDM_g1yo7fZYi3MeNfCmM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIakong7WnvU-fIY6b2GfGCUyy-lN6Jv2qJxgZhDzZGA&oe=6A86F743"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwZaBEPXVwQQ7kNvwGHJUV2&_nc_oc=Adp_KEUletkAF-JmzY-4dnwKygVbja40_mBvvVRSr_qUd3koShLIADYmfBvueXIlHc8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxV9bsxJZvvsHnf2vrHnRALfA8eh29XdMLxobAGmW2Lg&oe=6A86E603"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgKhdjWpea0Q7kNvwF4LEdR&_nc_oc=Adp9AJxlHErksCK1dPtYabOc06IjQUMjd2Ku7NGdC1I3R5AE38M_Y7SjTNTlfjk80ZY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOqRMf0cR_gfQQ8vlfDF795futlYJc6XI5SoprQq5N6A&oe=6A86F0CB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0IBy2jAcssQ7kNvwG09v3u&_nc_oc=AdpeJi1_Tg7AbvhN70KZRbtNVRKjJq5WNR563OqSj-RivnRB1mtxWGrvXSWvOVBkMvA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrsLzSsejqPbMIQe2Jic3B2OpZdeB-LjzePPvaZlrOGw&oe=6A86D469"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KP6jeJn7WUQ7kNvwGZ4TvM&_nc_oc=Adon8Xp7DbCbX9raWDkSFU91IQZV0e-abOauNIUCKrnMk-ylwdvDwYd_vSrwQQM78PU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhfL3rYrfn2HYrUIcROGL5WQkwEl32F4Vy5Yh65zeDUw&oe=6A86E938"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
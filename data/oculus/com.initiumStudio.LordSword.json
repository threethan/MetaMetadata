0f&oh=00_AQKl0BGSkDo9NZmceNij4K_KQKnns_k0rtoYs_lMgBWBng&oe=6AB9190D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_1Dg3btXjIQ7kNvwG4XqiM&_nc_oc=Adoi9o6GgLhEZ9Twhrt5ICE_qMPo1y9rs1FxkctQA1TjGEcl2a4ke-EAXE7AzBR-hIE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkeRc0u1a_Z_TuIgBvU98UDH5924o2E6I7goVvdSSItA&oe=6AB91043"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDRFGxNVaBIQ7kNvwGToWtJ&_nc_oc=AdrYevutoVaAr66aOR-RsuQlKeluTDDskdL8i-cUnh0HIpSbHvou6ch1nStjt8wY8Zw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLX6uqLhfrUBCQ2o-Ytmu9EOpM3zTdbY4H61SMfgcbIJg&oe=6AB93743"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCrU4f4vuRUQ7kNvwHTouo5&_nc_oc=Ado3cSxhwADOHouzCDhFwe7xQgZruFSMaPj8WqPb0m3IrBP1jbrxQFsb60iE-2kGL9E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvfQK0cwLsjMgW0XPRZXtVDWmr2fF7Qo1ALbWgS0a-tg&oe=6AB909CB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFITuNf-ejwQ7kNvwGMlp4Z&_nc_oc=Adpa8co4OtLOyxCaIJznBZz8J0dCQx0xs9Jc0LoFJZfc74vUvcO2jH-lFxZeFsBVe2c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITG4QaPuFdg_WqAx8Bq44qujV-UShfpkBDmMkPRJ38Fg&oe=6AB925A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4QzT3L1ZiUQ7kNvwHl6Op8&_nc_oc=Adp4cRYgPeJGnHWZgvXj9xmg6czWJS1_UF4UZQZ_PwapaNI6wcRO694yRGO1qp3kTdQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJspva2rqorIsYQEOpzhWaBUgw4rugs6JbcXITSKVxnQQ&oe=6AB93A78"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
0f&oh=00_AQRA_VyQ28gOilT6Kmn644xtxCO_nWzEHhlOzXqBEZ50PQ&oe=6AEE0D4D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1ID5jpllMkQ7kNvwHKgtpb&_nc_oc=Adq9bpXk8sXjwKM-sZInM89u1qJTCQF5Kclvc1DusUqu2JiL2fzje7r2lqkFSfLzxk0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSomMoALqc2WyHC2iEUF9Jmi-J5pKir_MAoJwAZeKI72g&oe=6AEE0483"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z44pgHsszR4Q7kNvwF69mJY&_nc_oc=Adr1ZMoXKjF0cd61N7qpZ7Wspg_3IU6RVOcYTo7TrqfnHL9D1oa82Ybgv_drZB-MMCM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTA8tI4-l07cDSG9A_rK6xFW-o-MFM7OssOpJlg90McPw&oe=6AEDF343"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNC1jSohdpYQ7kNvwEEPaCe&_nc_oc=AdoybWBkd3aDWpB8nN2ubou3VzCUkGYZbqn1ibv_Rq71Y_SDUU3eXeYLQcwtQ-USjlA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFk45MMYwIshc6KCIDUwWU-M0Wh1ju43Ys8HwpJB28Fw&oe=6AEDFE0B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRMqk8gVEGEQ7kNvwEVxnL4&_nc_oc=AdpCOwK9pqXSdfG1GRi5uHfzDhKTqPefZj-tbI8owk8v4TL-DnaxzABHKbWMpLldw4I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLD_b_23OJ09IjQeBEi3CoFLUJyshcc_yRKn3xuo1Oqg&oe=6AEDE1A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBvRXUEe-JkQ7kNvwGrgW7j&_nc_oc=AdoSg8_r8Xt0leh4aqpcsAocz6_9m9m48Mz71c4kPlmbuza9piaaVq5-Rz5csdasxrY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAF16uU3rOaD3n9j5-Oe37pAHLSqoybJ6QOWI5KhTgGg&oe=6AEDF678"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
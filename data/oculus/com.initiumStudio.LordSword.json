0f&oh=00_AQAd6zp3AA2fjWf_wUxtDyzkejNIk-laSPQkaSvjm2G6bQ&oe=6A660A8D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXdPCNPI7e8Q7kNvwFwJlv8&_nc_oc=Adp74N8j2r9B52A9HC061BqwkDI4oYkwnAHGDkVtWeAiBOGSMMhJtzI7i8uiXsu0_ao&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8YzvTyhMJ5ZMRBZSGR1cg6WsSaYpcNqRItkbiLRfXdg&oe=6A6601C3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tu54s75x4v0Q7kNvwHqu2H_&_nc_oc=Adp7RtAJwcoqTtwbIrInxX9SRWnATgrMRrv_B2DhtI2oXVwrn3kzFnqnl61DtpNrQLo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjlBs_Hlz_4Kc1oC2NpQihT_bZoDDRC3URbT9uWO7YAg&oe=6A6628C3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sL7WCwI6C-MQ7kNvwFgFOrZ&_nc_oc=Adr8vDr5qOF2sHGDlsj0Bot1PLP68yz_Wt-VumU9b2AZ3Baj9SwIgu4_B2m8Y4bercY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuAHOvOMiF9APQvMyQPM0d9mWrgnQHqzu59U_q-DfA3w&oe=6A65FB4B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qAyiwTscGsQ7kNvwHOjQfB&_nc_oc=AdpadIW407mK_eJMnK8kNiyr4CgscF4II_OeVfUZZVd3zjb0k6XBHUeFJl7xzyA3dE4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIJE_D4OjwtWsb7vToSubgvb3WKbGribNldWo5k1eBTQ&oe=6A661729"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSPTv_p_qUMQ7kNvwEIe1Bo&_nc_oc=AdpGdiWMbtUVEkwEY8NFMu4A6an7v4Hu3e7U5WSeKpT7x-qq3jjaCV9jc7L-N7x-aO0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYSJ8cC0lPZoMcAS2SZKwH0JUjDli1dPrmr8N64oK82g&oe=6A65F3B8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
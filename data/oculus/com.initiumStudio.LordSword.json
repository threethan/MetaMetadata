0f&oh=00_AQJYh75asgYPaZLWPHxaIEU_nBU_GUF61Y8kW1IK_qANQA&oe=6AB7C78D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvDKiflZQJ4Q7kNvwHvSiOG&_nc_oc=AdrNrMmHaSQKbz9Wr18CBKndzoV_ekBM3zKXxd4sX-v1klozarRkJo8Jv7TdGa0qU2U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7aCDfEAFbe4z7Viby1Si0T8xo-M9thFCh0Sf-FRbClQ&oe=6AB7BEC3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDRFGxNVaBIQ7kNvwEXJ6GZ&_nc_oc=Adr-3U7VdkdHEX2rOzb_qr1v_FZ9No-X5WdqVegucwYM6CLxpxo8JVCydD69fu-AuOU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuSNDNWAH1-SlvPjyw1DVxc3uoS3amxb1Wq9AFnZYn7Q&oe=6AB7E5C3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCrU4f4vuRUQ7kNvwGHiupL&_nc_oc=Adru9IhaFi5deIE_ls9P9F6AUCS8xtUTsSdPEVkTehXl-JjXlwZlgbAX9ESFPHdmtEg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9jSE2S5OLpyITVWXnG6mvkxn04KTkJRyH1BCaAwQ7Hw&oe=6AB7B84B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFITuNf-ejwQ7kNvwHiB7eJ&_nc_oc=AdrCJyf9_tZWWydgzwx6zQSV923UY7-Ab0e3ycNrflkVbnoMmrAUq9RVxE-1-qkLGkI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFBFAma1KxnzUAhywo70kgHnvX_moT3NUkhT-X-1VfuQ&oe=6AB7D429"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4QzT3L1ZiUQ7kNvwFmNQIj&_nc_oc=AdqLI39UJsmRRkkKs9wnrxLkgltiCTf_ECs6r6bg96L1apkthjtVSu6vpDSifZ4tBT0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwJlpQyJ9FTmZkhrYzXmq3uwtUrB4fQEPDA_smKboRPQ&oe=6AB7E8F8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
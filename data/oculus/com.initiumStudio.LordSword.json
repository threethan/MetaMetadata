0f&oh=00_Af11ZtoGaf4Ft7sJMRDVBk1KUrFXb_C82MZrXQAbfbTEXA&oe=69EE120D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7MENtA61AoQ7kNvwFpPcen&_nc_oc=AdooauN4W6ABR1ZvYpOmcSm7vnHLWonUUTAyaqaCgV-JQF_ux29Faik21O_LUa4Gwr8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tKe7AUuxqznzq_basV4galuITMnYyi-ajdtJGzObxHQ&oe=69EE0943"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7sXlB88K7QQ7kNvwH1gCii&_nc_oc=AdpZSzksrxkk-JOmBviBikLu8d4XV_y2y9ugvTLPlt1t-mWrb_46kHD7smrdH7ucLco&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hfVHn9-B5AfywBcLGHAkWS_CRk0gvPGkEdRv7vjI-jQ&oe=69EDF803"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hi-uB1DS-yQQ7kNvwGA_PRw&_nc_oc=AdrMqVuh0lVcKm73DNHuCuHREa7AxNFnAXQuH-w12YtkGAgDkV_w60FjpUYPkXe8Ssw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oNx9LMpZygC9HqGGThMfOj0d2Ss4dq0cHKyUD6ha7Nw&oe=69EE02CB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0F15YKFB14Q7kNvwGS69_m&_nc_oc=Adpu29E0MB81HkxiIcwaW9hpXEaFlhuqBDXPwlJ6iyWVTGkBwAIe3Wfk-_puyNiFasI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xVDFfOa_-7mZp084Ab3UFE_iIxqpcDl7fJVjeub0V7g&oe=69EE1EA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_f-5qXMx2cQ7kNvwGiP5s3&_nc_oc=AdqFLoSJ-IBplqQf9JI-SkSmTnQn40lCDD9k0RR3a96THBpjv7uq2sc-u3On_QSDxzE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Ikv423tASi_tWM__KgIHmDBXDb_cnziGE9hC1OKcwMg&oe=69EDFB38"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
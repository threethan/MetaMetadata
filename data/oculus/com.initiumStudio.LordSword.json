0f&oh=00_Af8RQr7KS_Sg4r52O6XUkTny-dxGscnplsRpnUC84eRf9w&oe=6A3FCF0D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8I72fT3lX4Q7kNvwEvEuRC&_nc_oc=Ado1r3VFhSpU0syiYHTnDtE-_OnS-J99iDbb5Q7jkt2C7JpBWlyyL75tOGEwYxr3Ez0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Yl7U4NbxcwPqJGnwfduhJfW1ZQ7bSI3HRvlcej493_g&oe=6A3FC643"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-loud8VAiZAQ7kNvwGN0O6F&_nc_oc=AdrjAZP6OHZuuG7eKcU1d0VQ0W1lwTi4tB4WSJYTFizJEGfy0BUU_BqHL7FEOVrkY3s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ivQ5ixym3cKFTLx8vabS7x3YW2TiaXU5ZsY03gE_Byg&oe=6A3FED43"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTRRyfF56UMQ7kNvwGmxnuD&_nc_oc=AdoVrtliNaSHeAjk1wrmRGN6u6EX9Q6qqgo3RNbNSEQURgIyGXfihHDoOGpVIdxiNto&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VvVgKo-ixzArnL9mygaStA28uuVl5N_tpbDo9A3Um9g&oe=6A3FBFCB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykH_jC27nFAQ7kNvwG9snwe&_nc_oc=AdodwpzMZj7F7GttYAgrs7OsBQDWZ9W2ykS135vuYTh8bl17kmTLj9QCRJGUIydiGHY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KLS9q8bS1fS0UV1JHKxHNhobvzC0zvgkttyOclOgTTQ&oe=6A3FDBA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rr_SbAUfMxEQ7kNvwENcTJf&_nc_oc=AdoisGj0vkxfsVXRY61F1OMnv72tXvwkodtLdM-Uunac6KKY_umUpqNaczE79H3lnzA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tS_poYYlW8Y2-EP7DisvIGhMb8_TwWwfHLMG5XDt6yg&oe=6A3FF078"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
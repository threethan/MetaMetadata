0f&oh=00_AQHwoQTZU74GNBRJaPIo4EXM42wD6W66SNCg1RBabCEugA&oe=6A92DD8D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJ4VTnR8i5sQ7kNvwHNGkUO&_nc_oc=Adq-Xjkp7u1PKHDXH2HD7oIALYTLeNl9G0aU04QC-UHajpq1U89iKo9zkBsqd7l_A1A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8X5POFCIr--osJ6vZbcDIHcmJ0cy-00nxx3Pl3wMSow&oe=6A92D4C3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psPZwfb4fakQ7kNvwHsrGVZ&_nc_oc=AdrotORDGqdGwXCci3M5OX1shuGRGPuMzvHTeYau1nsV3vYLiF3g_ABNGCc1xK0ktUc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4n9jzhOEiIH_FDnOTLbHfUDfyNRmTXcWGAviYGiSmog&oe=6A92C383"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVhw68DRwhUQ7kNvwEaixcT&_nc_oc=AdrVujRKsDwhQ5dvZTXweOemyqe7hf6emR_XJVDZodQ4HHjbmZ6u-61W3KpJtKTmxWk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDD1Lu8v2jBg1TIIlYjrsUYICAF-Dv8koH6UgEXsDarw&oe=6A92CE4B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-Ahi1cEyJAQ7kNvwENC6xb&_nc_oc=AdqBDPDW3X95wNaMT4CXp7gsxc-svGf0S8LR_IeUS7A_4iDiSUkagrQ9H4sQRTD2t6s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_gHxp4HJsMu76tMWLVOtPVbzftz6Bs2159yr9TDNGFA&oe=6A92B1E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5ia7JNNEoYQ7kNvwFfQjmA&_nc_oc=Adrs8A8U44ehkWa-KBaAa7BgmYQ9LlE2uKf8qbYRA25aLzmqatvwOI7vc4zjPyhDqyA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1XkVYVBQEULzKQlkvMoCz8N5FZhP3WEV6_ipG1osRXg&oe=6A92C6B8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
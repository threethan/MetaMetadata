0f&oh=00_AQOalm8cIhWgQqCOQry_w_lZF9Hkhdg66esOWnilcOFgXQ&oe=6ACF828D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsUF3k_0WsYQ7kNvwHK3KAJ&_nc_oc=AdpaY7-WiRtEgaD5Qg05o-I49I8VHcgosl0cG6Y9A2dsxDwcKNN3LTztGR4zg-fc9Xw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-l0u4rWKFjh241ObSbebsZAI6pIaOBxpl6Hn2xZ_OuQ&oe=6ACFB203"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvLVQbWolj0Q7kNvwFDaFno&_nc_oc=Adq9Aps5eleVcKtFKzv-ADv-DSG7CgbexsMSR95n_nfjJ9LyFQgLBQFgtPPlvp4TFO0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYKenEOpxLHNECvsiaFYt0AylzDKdWC75R3CIPd8w79w&oe=6ACFA0C3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vA0TMjzazEwQ7kNvwEVcZNi&_nc_oc=AdrbiGsIfoagMufRZ_KzQeF0j8jAHR68rhDEARhskue1UYL1gaGZL04LZkSuM6knv4s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKJQnPuhYDbb-aOYq5H_T-9k323CbUicrOxdG8V3kwyA&oe=6ACFAB8B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19rmazOl1bQQ7kNvwHxYv-p&_nc_oc=AdrCDspHJmQL5t0bC-wVQ1FFlhiRUMKuAVD4igTYK86QDG-Y4E6fp1KFey1q685xfUQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMT_OAxVOZxOnKCxtwXY6Wucf2jDVzJrXHfvW_ROTcJUQ&oe=6ACF8F29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgKryqQ3xHwQ7kNvwFh0O1R&_nc_oc=Adpmo73x3iYSX5u7P3wK3gvSLViijmax-ajkVea1IZXY-fDnt4yQ-FHrDKJa1QdXTDo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9Vi01mdTjmyZ7ZUpya4eBQNHH5oVBXMK7H642Vnz1Eg&oe=6ACFA3F8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
0f&oh=00_Af5bobNTJvHNiPUuoX6jvvkHziJZk7WEz1jlqW17Mvd_LA&oe=6A19938D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWgzTt1Jqu4Q7kNvwFKy1_P&_nc_oc=AdrioSoaOTUjSzOEeEa2r79oct848YDjlAmUvluHc6oimluUeRve5Y5ETYmKOni7eGM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5agwGKxg2A3pB_-mi1mR2QWQ0fxv8ovRrBycfbH7hCUg&oe=6A198AC3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ASaSdtZeJgQ7kNvwEaZ7s0&_nc_oc=AdpUNdI41Bui89Sr9Q5FVlws4WtPXpo49gRnjrhe4Vbi4AkAu2PIp8LynjS8jO09Cpg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7juowk995JHNCdYJBXCh118W3_dkaiX0X2nm3Jvquqpw&oe=6A19B1C3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2JfY6-fFMIQ7kNvwFi2Yuu&_nc_oc=AdrK7yJ5rB53vvOPMRKTx5PMWSTwcKv4Kjq8dteFnJRzqPhlgiSdchmyD0fhlFa0-5s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KI5II_OBGxp_FZT429a0WF2zQgytE3fVDAqbDZFd3eg&oe=6A19BC8B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5vqEaZ59AcQ7kNvwHGGFd3&_nc_oc=Ado7cqqzz26FuGJf3V8Wh5aicMleCh9fEf5Lh_NVm0NuzVXaFrfO80Ylqx3G-YhIHOs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DCGo3sFMAp-zCSOFU062BHYPhJQW5oI5CICF3T5Y3Jg&oe=6A19A029"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXavwB6KgC8Q7kNvwFk6Dm3&_nc_oc=AdrKlZvqjfZGAnTNiNa-1hAQz9tIwKry1b9-JE6mhhQ7lUP9Vttg-tv4KQhSfwKLGfc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4u9sYgOTBMwKpfWW8QxWvR23RMk-N_YwSZdFMAsif06Q&oe=6A19B4F8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
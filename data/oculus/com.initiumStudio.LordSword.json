0f&oh=00_Af1RskuP4XOYb9oO6r6McrQ0fPu4FuvJIFZ7ffPnSBRBuQ&oe=69EA1D8D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBpNFTknEoEQ7kNvwGNaElQ&_nc_oc=AdofRT9I64lH-9kLVrlr3QK75J90f_M3StbY_5BzJb3XsTWaBiAHUS5PZSrdna6wPiM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af306GBHBVJxA44tWSChMdB-CycRQMzYf4AksMotIC_a0w&oe=69EA14C3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xhp-9eiADWIQ7kNvwFuLtcE&_nc_oc=AdqAoZamA8SBdmoLQZgSdfOos7x-WjiPAeidh4ktnbp6TRfmbF5fNYq9NoWhczMnc8U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cbV5qS19L6pnAFVghi5z-qzaPo3EnqqcJOoS4GQgOcQ&oe=69EA0383"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4FSuBCj4QsQ7kNvwEGLf5s&_nc_oc=AdrBo-qmMYGDVP7RR0TVMtfqEtvUcFpLf_zH_Eytbxp4CjH9y6J-UkdIT63P0ojmN_0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wnLEbILCxn9hPFf19A9_jEFK5ORPIVa8TPMZz-Mz2gw&oe=69EA0E4B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qf4MlrtbC1YQ7kNvwFAM0jQ&_nc_oc=Ado8hwrtmx3URmxeQvIahfdb2nWCEtKv45jt8an2zPlSqG1QZuHWqZW1xcwycBoZr4k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1f8vvi85XvcZcmjMYm_0N9xhPVAdf6r8DuG08dJmYjnA&oe=69EA2A29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vtvsgjqxpsQ7kNvwHaLtf5&_nc_oc=Adr0L7RQbkrFns4iAVmoflhRBpfsD6pDz88l_9UmDKgeGmyq0JUyMxHsYh1UUrl_0iA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KWWhKan3EdmxVLQV0Py5v1-PY_XwI0sVnMqjyVn9QMg&oe=69EA06B8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
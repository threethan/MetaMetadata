0f&oh=00_Af3q6BYhQ7aPtQs3RPzmB1NF9xRttgQDEr5k9fzJAQZKWQ&oe=69F74C8D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhXENvIZOKwQ7kNvwGTggXe&_nc_oc=AdpZlCVsxmXmgtM29NTHBH6gIu2c1sfunFNPRVvkojWF5skmAUpE-B4ROV-U7HAitKg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1j-HqnOtS6SnErczSD_DFlVPhALCIjoHLmg9ZoueZUwg&oe=69F743C3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rBJLSQ2vVoQ7kNvwHOMiTC&_nc_oc=AdodlridGsQCjCBav3bZia0vC2IG9mpQGOtg2_8uyv1Jc2wHBbihQbdJvRag5qc1Egk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2w3gZt2eVMt82idBnRn15je7VUJr6lEo_Gb-9rT7R0Cg&oe=69F76AC3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Ki_R-DhjtsQ7kNvwGkH0oP&_nc_oc=AdoU6SW3Y-EjPa8sAT1aIP_HSFFwsb_Ios6ua4uVj8VbDrrjIINMC_W8LBHwrP5sEDk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3-qd_DVmVTGrig5cHAAysx6trUfYewdAinC0dBMaS2lQ&oe=69F73D4B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ci9gI_sFGMQQ7kNvwG6wIt4&_nc_oc=AdqU2pi4x2V3iBDvkRgdIw_8Aj7HC_Dp5kWH9tvuqzhz9B1XaoA2H8qcNzX6XiZU-CI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3tDuBTkKO05ttJst89AthM7GA3XmqHVtg6BjVok9XfxQ&oe=69F75929"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qG2AVd7RG0kQ7kNvwEhQi8o&_nc_oc=AdqvTEQQ__5eD7GTbyQPDpld6CJTfLc5wPgzZbQFiSEM0prlwpkYU-3ZHQ-enA6eV8w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3rQKTu7JVtITR2sesbWNPrVrX67tEm78zIWF9l1WrfXA&oe=69F76DF8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
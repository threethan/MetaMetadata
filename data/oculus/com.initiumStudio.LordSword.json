creen12345.png", "id": "246898261472932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8ygr2V5CscQ7kNvwGu9xA3&_nc_oc=Adko5-qeL9bZ0ltt2YuJB_eSW1EhqqJZVng541HL-5Nw1n8ZuyZDuZRtAEVE0w_KAiQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvpQ2w5OomZXoAsjuVC0xRPGWfRRRXpEx7XSlolsGApkQ&oe=69A43543"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjTJcWeBq6QQ7kNvwG9SLTW&_nc_oc=AdkW3ESp018GZ-8VS1kg8eGwJbaHYrfzSqpOfxpkQMm1Xb1ZuwDZAlIjPZimNMto75I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs-1-rEsK-HnZVDlJ3Ugqkl-5iMBJTy5g206kk3GyWIwA&oe=69A42403"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEVA2DPLIccQ7kNvwHvJo9M&_nc_oc=AdnRO4YYctjSHvyybQ_n6kUACVNuOW6X3wJhvDjgl7uFPuE932pgdkWbFlpvxA4Qe6w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs3_QaxwYP7Er-jSmIyHZin6fFETDgtEIGUJ_FSxNsrEA&oe=69A42ECB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXu8erPWCpEQ7kNvwFbpUbH&_nc_oc=Adk17vl6Rb5cpVUvqFKBSUEPuXe0OyS79ssDfyx2tzUJ9-VBy0RAO4xrQ9nJPDcSm68&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvtdtp3Kl4ahpVB-1Hca8fqSeBJd5eeY8FlKTLRWFkfsA&oe=69A44AA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CpO0ufqdi0gQ7kNvwHqxAjB&_nc_oc=AdmTtH8fpDTanT9J3fAufNjVSxJhfN5GhrBROQDERb0dvF0OUoC0vx1iTr5JS_nEfzE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs-KXqlr4W9HvFuqk8R-nxQhovkpwX7OOSfGSaTBMfMsw&oe=69A42738"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "website_url": "https://gametriclabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "274332
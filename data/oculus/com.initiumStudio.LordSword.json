0f&oh=00_Af09MYtHOBsOqbLfa-NB-YDcr3H5-D8UCIz1SafVrZxA9g&oe=69DA4B8D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgb3Czek8rsQ7kNvwEldpHp&_nc_oc=AdoptreYxV1YVj4aiYWyijuVhE49QFrzLl3sOY1FMArS28offlNXYWR6HNfLKyno-lQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Dze6Q0c5DQMEMLKCFDlCz6D0xWKpGXwYnfoW5-MLKZw&oe=69DA42C3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKKnJMktH-gQ7kNvwGHt8Ma&_nc_oc=AdqhJ0oRhk-ohBUukIV1eGyWkgzwm-Swa4tlBSI7uEZTkWOhHGxTOJDkxRwGEkirUmI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-5a3LNNbEg96t-5Z_DVBIUMcU8TawKPwgNR8glIPoKA&oe=69DA3183"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7eHPuTtzbwQ7kNvwG3nDu4&_nc_oc=AdpTvZBfpVlDp74AtlbdgJzYMFet_VGnRXJZ8hFlq0U-IdC6wcgIlUjybtT2C4MDM_Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BXONWDnMIGVI5bVp8i-tkNa6Pix9vmQ0LBbBNV6Nadw&oe=69DA3C4B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IKFnhXeTY8Q7kNvwG-GAl4&_nc_oc=AdpQkJPbBIk5jk4myhjIN1_nrOm-b7_htG0z1gkkA69Fu36Y2fOPgR7DmpYtdE5ToYs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Sw3rKGSBbWlOnTUk72-MgDeP1yP8jwuRmrCP0dMYENw&oe=69DA5829"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqBE2LombqoQ7kNvwFEV0vX&_nc_oc=AdoXXwtEGZwXOryblSfb7Ze6VqUJV1C-on3puQmquVMBYtxHncHo84o3yZww4fs67OM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZXB3ozBxuKBFqwDWdUPkoa1ULT31_wYy855idt1astQ&oe=69DA34B8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
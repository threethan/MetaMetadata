0f&oh=00_AQBQqRhN_wEkiD1teMSX4pO8qGh_LFlFUKH_AFcKce2ehg&oe=6A54E70D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2fXPkpdNS4Q7kNvwFQTcWQ&_nc_oc=AdrQa8Y2M48cN1jevbDEM3uuZRQAWX_5m2aUqaiNPBscKUIH2uwy88DIT-BjWXUbtQo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoEHsNOJBg4Bzez4tnadLQMue6zMswsQNiTRuOsLcBgw&oe=6A54DE43"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmFr1cIoYvkQ7kNvwHfBwdi&_nc_oc=Adq9Z315r_92dlP9WJ68IsoVffzhC2irDWB-tQcT6R1JEuUADPVcNJz9diZ9BcFUKjU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9q4rgDiD16jzj5bNgqSs2FIn4oyRyi-8T027tSljFpQ&oe=6A550543"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DD1qTFeubLkQ7kNvwEutO39&_nc_oc=AdpT0Aijz9tAC3LY99mlciKpXS5jlHYKNa6VSn-GK1uw3ifZtwblyqujCz1pGTOgcqM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRRw2c4D7-FstM9eZX6SqWj9McRlwA286Yl3CIc_1L2Q&oe=6A54D7CB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9s0ELtGQUoQ7kNvwGF8s12&_nc_oc=Adqdvb0OP40QSd3KZOq0HozU4gkYpenQuCtBiZna9L_K0h9Wxllk1mtnMOtEaPuSy9g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZKXGzUk7MQqF0nFN0Uytab2fSOCeiSPMpAf2vG6p88g&oe=6A54F3A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8Es1Tm7KFEQ7kNvwFVmelk&_nc_oc=AdqLG11Ff19gsUTZmMDW7Njg71QhJd8yOedU9bnjIcvMlziWKm--ybnYj0D_J0xXtJg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmh1bcIFHaGLAJTsI774E0FNf0lMNGEnYtDuKDA2w9MA&oe=6A550878"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
0f&oh=00_AfwKcl9OfDUGj1P5VDBjMIJuJBVATe4qtjFVEGk1635Kyg&oe=69CE6E0D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JLkGKy5-hsQ7kNvwFgVKPk&_nc_oc=AdqrwcqkQMsL67Sq7HfBa8b8uIIngK0LU5jj7r1SwnNP4MXt8zxppkxdiSIpZcGukV4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3gBm5JN1--WT3RxgxvTaGTfba9OgQbNrllacvmi3TXg&oe=69CE6543"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHWUqI1BPgkQ7kNvwGDv_89&_nc_oc=AdrhsemuPh7pEtlEamA56ad48VEKTww8LagjAG8WQ3_Q8h3GZEtQw_KVA8Ucw7N1L94&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwlGQ6KPMdpi8kaLFmzKqtYyKDHTZLRR7OQXMMl_yFdkA&oe=69CE5403"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IA8ID8QFTpgQ7kNvwGqBxBy&_nc_oc=AdpE9Dkr14YU7LjdNNxr6FK9iSY7RZ5b0J_pDAn2kFuMG2oQAiZG4NKjzkGm32rJzRk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwLTA3z62zRTbRe0zyLL1m78DDTwYwS9wI__UeB57G7wg&oe=69CE5ECB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVK1lS0sWcQQ7kNvwEtyM-q&_nc_oc=Adq5SZQatKEIZvpDeSYD5jjPfDynE66X-ck6gSy3S0Gj4iXVnKf2KDzz7GVxEBh4Q90&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOkH5qF9PXuNtdE8WpjqPnx2YFjdCT6U9SVJW0WJtC7w&oe=69CE7AA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhdAP6cg_o8Q7kNvwEzY-Q4&_nc_oc=Adq4x8Z9KkNyowlbUpzwCw04IeTgeGYk93oQQSocmFh4F0XqaWbVYXG_lv0FWWFbuY0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxrfuLkmbJBefV8jIyMvY5lgpAtGK2EbSyP01kjLB4D4w&oe=69CE5738"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
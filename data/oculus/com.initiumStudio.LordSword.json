0f&oh=00_Af0q11Iw5_miN6YQ8nvw5nAdMOy_LWNlBl7RofatrdBjpQ&oe=69DB9D0D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4TiO_gP24MQ7kNvwH5SL9p&_nc_oc=Ador9fBr51ndviJs2NzDCge8r94nZuCXt7yrPEO6F3PUrgTA5AO0kNIooL-_LK5_IS0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wOwNjnKFsRg76n73m5nHlP_Zv22E6SoKiGMNjffyonA&oe=69DB9443"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKKnJMktH-gQ7kNvwFknP-m&_nc_oc=Adr2bf3kwhP-KN332InZMC3TQ-IqDOhOnTY3InSiPI0zb2ybU_11r4g5lnuxOC4xavg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_eOt82_XYOYjdPvDV8JV0uIttNHai2_v-BKWFQBiX9w&oe=69DB8303"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7eHPuTtzbwQ7kNvwE2c-MZ&_nc_oc=AdqCUJ5NTlh4S0qY3ufNbBRDKqtrHHbT3VSKWMA58y6Le8VNmVV5-fgy0FAffttuDEQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-54IUpEV6Ym3dyxDX8QwDG7RE-awfoKGQCXUIEkw3Ew&oe=69DB8DCB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IKFnhXeTY8Q7kNvwHZ-1GG&_nc_oc=AdrDSF7ceDWRx0LPEM4lR80rSPqZ60wTtcCXe7wNsv6NGyNIWhYTdJk0_l-0GzXLQZg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fDvMWkvhwGB2ww1a1RWJ7LUCzfYWYgod-MFiZjtkJlQ&oe=69DBA9A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqBE2LombqoQ7kNvwFYBlAX&_nc_oc=AdociE9v8NtY2OOTPz-o1pBzFVlD4QtKSBBIVUxYa0hRusxxc0xzavGDKa19PZ55p84&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qoPHTpb-qUxwPykiVLOb5vdNRwHMVFc3W7vmpEBLl_w&oe=69DB8638"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
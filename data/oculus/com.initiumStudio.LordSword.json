0f&oh=00_AQJnrqZLYVhbn6f5_O_R3HsIssT8HEQM-deBsg9W4LECjw&oe=6ABA6A8D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_1Dg3btXjIQ7kNvwFFGqH3&_nc_oc=AdrIJ5_VdTzs3WrZvP6qeok7Kqm5ISe9aGUH0YHPDsjyfuBfcvyVJoStedzL9p53z38&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKU6-8Xy4gTQ4C0wG2eGEBXjHvVUmu5eppnyVQKtwFn9A&oe=6ABA61C3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDRFGxNVaBIQ7kNvwGHurVt&_nc_oc=Adrq87x_aBsDX15qZzhhGr2EzjgXqoDofH863LfBGtFCOwtikH4GXB4Kn_-Vb1sODvk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFTeBuAww_N7rfWqxetFJFWyyENOpo86yQ29L-tjnvYQ&oe=6ABA88C3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvtteT1GpnAQ7kNvwHGTw9R&_nc_oc=Adq5GAp79g84dkepX4Ravid7UJMEIrZ5CcpBYZ8EprxYIiLOoE4kO3FDvR7i0ODfZWE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRIG7jSdTMJNIjkp7KJF3lTDhgOi9xL981s159bQBMWg&oe=6ABA5B4B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFITuNf-ejwQ7kNvwHWRnAl&_nc_oc=Adp7t3pLWCEi9kZtjqVupLOr41g41ripCm6b9_cCpIfIUGOtBuRprbDJesta5rCpqnc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1Cmsy2c8nDiQwGQMo3-ft1-mxMWqdsqBLM3ZgmX9Z8A&oe=6ABA7729"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4QzT3L1ZiUQ7kNvwF2rqJ0&_nc_oc=AdoqJeyYDh-Bd5FNow1jrkH4SbkQEFoA1fM_5p5ZnKSjBQy9cs7U2uWieIBEg6btfNY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVpINvHc1Sax2rl9cAK1FHMgsFuiTfoCQYu_1mLanWTg&oe=6ABA8BF8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
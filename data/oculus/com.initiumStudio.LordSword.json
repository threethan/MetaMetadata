0f&oh=00_Af2-8Y6jW-bXilPGm0OwffkAsxTfC31GhhYAPlAn24kpfw&oe=69E3860D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2puE8ruuDUkQ7kNvwF4ZUR-&_nc_oc=Adp0QNoJDn2_Immb_HnrGO-8LznN2804FbIXtBBPe8y2nFII2XuGSXgheNSr7Wuk-AM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RCRq6I5kkWRiSh2fnGgILPuHjyn2Or6UmfsyJVRwymA&oe=69E37D43"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LeA31zSVcIQ7kNvwEaFLHr&_nc_oc=Adpr1Qoqz8-633EeCp_m9pPuzrAFA5zzy_PAw1o2ttjbqayzsYnCw6Wta_Mmbq1l9iU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mGC1VkPVJ_YN9PVCYSGEOPWpfBcwniSBKjkxXzpd0Iw&oe=69E36C03"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9PmOBD1woYQ7kNvwH-03k5&_nc_oc=AdoCJG_ZX3moPR4sg6OjP6DUbMbf70XjnZCemAadv7vObklez3zWfnxllqmiOuB6NFc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1R_Odchft9_ThvTcV18kXfj0QYYrN5b8kyGURJJQazrw&oe=69E376CB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ruXCtzXxaEQ7kNvwHNs9Le&_nc_oc=AdoU35fImVSawpRgOIFHaU2SvFVqEY6YIGA3rBpzpEdDa-JzYICzEePKPV0gccu55A4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DtRFxEPEpl-CplJGu2BJ5q84gvqLTdwPVBOYXjGzRXQ&oe=69E392A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOrJmUE-CAsQ7kNvwGewc6m&_nc_oc=Adoy1S0YqcRDEa49YF7Z4F4KKzzX7LZcBchohczLSffsaLxtm6Xb8-b3oOnPW7Hm0X8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xO0Qkvqbgox7G3RDRLYBQMS1c3DHevJIHUaLa9wec2Q&oe=69E36F38"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
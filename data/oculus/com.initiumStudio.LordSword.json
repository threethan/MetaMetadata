0f&oh=00_AQC0PBmfLHn4JfN13jH9O6b-_hDsLWFnwm1XMw9SkvHbCQ&oe=6A63678D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68scx0AQ0QkQ7kNvwGnHlYN&_nc_oc=AdqqYTrTNdpnrYH_zHqGp4XFFcAPp44gtXKBIs-bQOtOT7F0pzCc5A3tLZLSSJETQcY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnzxZabCk41nTHQ8Rq9ORbDrWIRBiSNvMV1OJxqgRy3w&oe=6A635EC3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcQ98C4eMuIQ7kNvwFkv-jg&_nc_oc=Ado8M3fkaQZtvPPa5AZ7C91_VtFaL08uhAG68xaFQg9ceyUkAMrNpnUldUTCFpZswXs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDS-xjueCSyzNIgWr4dLGsOpqx8JQdeiZPBP_UVT6U-bQ&oe=6A6385C3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sL7WCwI6C-MQ7kNvwGlCqpR&_nc_oc=Ado9jcQKDf5t5Ak-m3DmoSaGxVEqbrJL7Qm5cjMgndt-SC6BbdiuGW8Ccl9HoBsOiUw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtnZ1-VAi7NBf03vsRwXGq7qJ4YjlgVAS5bLKDi4oqiQ&oe=6A63584B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HptUYmy5H0QQ7kNvwGzLZ-D&_nc_oc=AdrULxnhAj57lKdgxQfClf7ars-Aojh2jVBE89I8KMoNofXkgsnR9dxsJte5D6bZNC0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSO66INLMV63wtWYXq4WWIBSbcz1p8EG5RVb3PUR51Eg&oe=6A637429"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9oNM11B-lEQ7kNvwHbQHw8&_nc_oc=Adq2wsQG5jNhvaEXZL1K_owXl6cmRYJSli5dv0fOeejSAskHNHuCuIf10E62khSLSFw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBs9sB8V1N6R3JyqAy6o896uHJfnuBkICCWiYVx20TRzg&oe=6A6350B8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
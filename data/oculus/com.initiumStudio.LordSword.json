0f&oh=00_Af37A5tLNFiASNU28lIJ5nSfw2pKhj9anwt_4j5LJzm-tg&oe=69E6290D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2puE8ruuDUkQ7kNvwGX0c3V&_nc_oc=Adp9bQsxQunioQPWk98Gwzq7Kt1Jek4n7P7Dv1O8H35ISkW_uaOAzUZ8-3cTC1BpNqo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0g2JYUIrJeyUUvyqRRRqHanpKxOTNl8cPH5ixlDwKeDw&oe=69E62043"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sv0UeFbCQ34Q7kNvwGg0e1v&_nc_oc=AdqgDclMXqIDgAe67TxNOJlJyTpwuYP2swPgqwXU4StpGSJrR2QfzAQVvWYzaCNy7Fs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1w22JfMhkwXhmgnZEO2LcpuaGUG5b_koMTR9H4T76TCg&oe=69E64743"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9OhEo_bh-j8Q7kNvwFWM-3q&_nc_oc=Adr39TW7TTEOKil8_SbGXE8CMnCFjSpQlmKzcAksFarx7MOjPxfYUtEW_RERUmcN1Fw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BU49Wi9_TKWuZCHJP_aqzu-PaTPuO0HuV9ShVKFKomA&oe=69E619CB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEbcDry2-84Q7kNvwFwTS2-&_nc_oc=Adp9D1LIz1yo2zwJaqOZT9I8_u1A89vHuHwvE3vTSZb_L_EeQ2pM5ZAhaBBDeDo8PcA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ORSPZ1UtoBQB0NQuDGNwS7D2VHqourYJJnYYE57I7EQ&oe=69E635A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7HSH5Xw2jsQ7kNvwGuB_8R&_nc_oc=AdotKsW7LQ2_gGke9GNQ-ZJ4cP7RXft_nDooRw_cDLB7CG3sd9eYfM8G-IYb4ampJO0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GOt8NfeEXOC80WTImX_1ZetKZ1JYXQowHtjiYJnkyrw&oe=69E61238"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
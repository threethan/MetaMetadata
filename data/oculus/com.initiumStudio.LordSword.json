0f&oh=00_AQBXXC2DgrZSe9GYRNMT87m9yEbdWbgJIqQPzHK4OI80rg&oe=6A62160D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68scx0AQ0QkQ7kNvwGhMLHU&_nc_oc=AdoiUPK49aSDqTn85n46-UL9nqo1D1CjHxVkJD_fLbgaPk1JTQBt_dDsKaLVuB2VJqs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9BFsRFtcXpjBbiuV1WErWAsDoLGm18XUlibzdpBPPhQ&oe=6A620D43"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcQ98C4eMuIQ7kNvwHa4vin&_nc_oc=AdreI5T31frgzbIWzNJPiXTbX6IjBkHi2Ch01M3ctEwPCUVNBiD-VuN_5sK5bUMeIHw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4T8nCcH-qIEWjFHY1IdD1E77XMdiW35fVa9xx_8hLBg&oe=6A623443"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPBOn7auhKYQ7kNvwHNr0lE&_nc_oc=AdrUwopB3TFgG81aN6ApgwzAozkr_U2dKzaWAoKwp9jWi4rH7m2ofnwlqzeSM14yK_8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMVC6xhwwlgtjgdnVxM5BHDTw5Hgfi0qbgPpMyVLNFlg&oe=6A6206CB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HptUYmy5H0QQ7kNvwFqWYn6&_nc_oc=AdpYgTABUpOFTIw4CSu9nbhlfJKI-BpVCwtPXqMJwYKwxnf181rlz0iDZacnx1vXiXI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAULph033EvNDae3CI-e9bLfcJvY0q0s_vajEj75nU-7Q&oe=6A6222A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9oNM11B-lEQ7kNvwFG0fWd&_nc_oc=AdpuL6xiO6QnENmFNZD-gMOiadpY3Uh7TxRjVOp_2ldCXgpxpXnDYPCVnndHh01jMTg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDudiQuZuda2JE7tdO-8gK9ICAo37ESi5d4TRdu0gJ__g&oe=6A61FF38"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
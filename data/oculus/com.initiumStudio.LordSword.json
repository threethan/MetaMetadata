0f&oh=00_Af9hK42tu5cylj5Hx2zmXIZ2c4WkVVNuvgzFqPeNBHuOtA&oe=6A2AB70D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXNMm1in0ZsQ7kNvwHpjpo8&_nc_oc=AdpCLrluWUphh9-VC9N4QNUAYezHLmD34yBtVl-z5eTtdh2fS3UwrLxEmNYgtU6rbMI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xwy9AW9voZ_p3QIMH3hBcMM4vKhFLicYaR77_BdJcIA&oe=6A2AAE43"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qk1mFeme4hYQ7kNvwEmPk-V&_nc_oc=Ado2mynPEW_L36D6wPFkDoDLTTaHxB-WR10Xdnc0QmRyZSGJLFMg0kyOYLd7oFjDRh4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tXYLhzCGcMQojBVW1DFe6Gb9dUDjVk1Bkl0oQBplRcQ&oe=6A2AD543"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDHjFnrlIsIQ7kNvwGiqU-Z&_nc_oc=Adoq67O-uqNYBby2QfOAemGjyngflC2UrSNObqRifrOb5e_PWE6KeFqlruAA3ms3zn0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81Mi28vMNst1rz9DjxGFbiEB-IFMUxYhe8jJzhWqMLZg&oe=6A2AE00B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpUPFlaVbugQ7kNvwEhNRmR&_nc_oc=AdrNnFuJ_-IecmwUHd7QYKlANrL7G0j4ewrD-3dzFDsZPJ32UheqktQemG42Ir4XYr8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-esixksQRypkgAZVb0qZqHHIdYYDXRpDPMPx6I5wot8g&oe=6A2AC3A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDfxTuEeZhcQ7kNvwGzQ3X3&_nc_oc=AdpwfajgDjHs6xQx-H78rghiN-dzg5z5sl8PA7SJDOw08ZyY9xIZvzU4zX23yYw4sAw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JEEekuG_p_JqLAUNkGHshwaV5BmP9BG-QMIEeFJq0Lg&oe=6A2AD878"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
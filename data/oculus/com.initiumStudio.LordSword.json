0f&oh=00_AQNCtNquPvoBp_tYEbKphAPF3_PwvW6TCQZ34B05E-SzDw&oe=6AC2538D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5FCLN6norMQ7kNvwEyFggs&_nc_oc=Adq7AQorH4QGJ49nNDW5mzk87ntyD2r4Bu0CzspYJMRz23KYyVsFd6zs1ScJN02I2Yk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhZ2cpDV_B7XDcOGVn1nH-P1an2XbMm4Xtg5WNkgYaHQ&oe=6AC28303"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--t97O58V_QQ7kNvwEhbfka&_nc_oc=Adq8eiu6E1-ryjWtvkzwm2k05uLUIGMxK-GCBHSWoP5zexTrSO7LKSkhw0tr0_AsghU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtOnSea-ju06UJo2pFcu1nckjl5LGkz5nLhLtOgFjHCA&oe=6AC271C3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tk5Ad3fN9UMQ7kNvwFT2OQ-&_nc_oc=Ado3PTxy5rSi27H-3qEJKks37QITfgZRIolGiYRJq8l5rGrvYx1KcKTKuTN6gqPFELU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKdF5jdbegjQ7qcQV3BkB1KbCmm3w4R-6xMCK4STsMmA&oe=6AC27C8B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qf8vePwwsn4Q7kNvwGM4cVH&_nc_oc=AdpSzLgoLP55ULLB5ISOx4BTAaT2av4L4QkGecxn1uEdru_rluyuxz3cghgMHfzahRI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMftrJdm8I6T9rINujGz9NU9Pp54WUms4SULxShH_Y8Q&oe=6AC26029"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ra6-hj5-48Q7kNvwHZYcFB&_nc_oc=AdqCmeqUX0RM3oI55ZbFvyargcab2Otu-9Hs1e_hotlr2jEC-8Ft3oBkqrFKUXRGaME&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8593VgLKsa8HKaOKgRf_2OvVFAhalUvc7HDLM2Cdq2g&oe=6AC274F8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
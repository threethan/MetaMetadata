0f&oh=00_Af06BHjOUhak4CLQ-Cqni6j1LpAdiCdATWS9pdnlms8vfg&oe=69E0E30D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7bBx4FyFMIQ7kNvwGKAFre&_nc_oc=AdqSfT4E1Wep9FPS0ybxcZY68X8u5aPAQbPsrn0HpdDWrl-IT8CEsnyiTKMw-k2BAes&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xw4jCLMps-SEH6Z0HH4KC0bbSkTCCOlKSzi3DH7CnDw&oe=69E0DA43"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TmnIXveeIIQ7kNvwGRJ6Z_&_nc_oc=AdqGjZPSO_ftGoRe-3MNwciE5JNmzFQM_wwU6klqXic_Ugw2iWstmZWByl5hyqyyKZ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qaKM8ISXkklUuVpa7wHs2bRgYYkEA6fDsoz1E4btqOw&oe=69E0C903"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9PmOBD1woYQ7kNvwGOdBLF&_nc_oc=AdqY3upJCzDtPaI9CI04be9r0iPTKkQ09y0j61nBIS-kkHaa2RXFerQOEUYsVW-Rono&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zyErNxQjF9EKEAfxVtg7pC57nfoh5FyySf21BuJVNRg&oe=69E0D3CB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrEu2W98ll8Q7kNvwFXlWBN&_nc_oc=AdprxUbbR1F9Nlp051VNiaO7X3Ol_v2HoRxhxchu5p2LEz4L-N_1SrKZv3YrUi2yMbE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kX6I8qVT6L1xZ99xlv-XMdqj5frM6Zx_2iA9hoSfjDg&oe=69E0EFA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynOWvNrSTkUQ7kNvwG397EC&_nc_oc=AdqKjM2aclaIjnVuQg7CLaDTerlCxmxkm5e4NAkriy1noIJIx05tXYxk4QMC_ZtyHSw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1T7mzxBB-lBBxaMpsrEg3wLzrEGAGT38LX_6ySPfoAxA&oe=69E0CC38"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
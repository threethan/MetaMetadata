creen12345.png", "id": "246898261472932", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mcf60yYPnc4Q7kNvwGqpiwS&_nc_oc=AdlrJWG1mVp8q1Xz_7ywF2TTTnx8funle4y0Q1Xu7EyjiFAv7UQF4fiIff6-bxbXefw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvVq0CqtHcRoQZyvNkvh5XQQMI9ytQieC3JG_4Qkn3Mzw&oe=699EEF43"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtg6XozLkUwQ7kNvwGzMo-G&_nc_oc=AdkBRFuyOwf7puP9HjANb6kXq7lt0fDPkYpaDWfJTFl0rp-oTDIMB4ihMRi3Yw18I3s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afts4ykmQhTnzQirXuMaTeZgAmqyrvBH00I64nQUIVivCg&oe=699EDE03"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8bE6l2oyIQQ7kNvwEmfNMq&_nc_oc=Adnz7lpA5zmZWpBoaZhAkgEVnh1MrvVLWQEu2V6w5bZIEkQtUWMzNxXe3QrqOE-l1Zk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftAkh6pvl5GPCeEUv_lAFSh2w8fy0VUaAe2MiV3xh0ogQ&oe=699EE8CB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpafAFvx3s0Q7kNvwGDdD3J&_nc_oc=AdmqiBw-biCkkQpfd14tXPi0T_IIJNU5sIMy8sOi3o6xjg5dTMwFcXdjc_imVg8-2iw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfukpHQn7kBUvdFYVh1owFHUtef5FL9deoKvI0-N_JTE9Q&oe=699F04A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYuyUYenyVUQ7kNvwG47iWB&_nc_oc=Adlb0R8IloskH8qO0ShfdazWVY42p5DVYazxtNzmcw2z-Zj8Nvhree5qOAClNaFpie8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftGu3z9JOipiwEQO3YWWtAMpvRk-j6xrrNWe9H5nLugng&oe=699EE138"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "website_url": "https://gametriclabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "274332
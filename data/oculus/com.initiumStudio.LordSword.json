0f&oh=00_Af3NzDH3ej30Qtf_rVOljKhN9cAy8DYMVOy-APwvAeS6hQ&oe=69E8CC0D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBpNFTknEoEQ7kNvwHoTcqm&_nc_oc=AdryrsZy5ITYHSDlHPUddJuOBFELoRN-6uIcmDVMJfMZ7Iy_WrwILixpYSsWaa2wM0I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3IqpxTgrCeTisj9eamw3_fb4-pSL_mwYP8A8yj41zqwg&oe=69E8C343"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sv0UeFbCQ34Q7kNvwGlz1nj&_nc_oc=AdoDl42eals70aD4_MFhxnQJ1doX1iR3RU8SZ_f2bR6arGiv2Mi8HdIqD_vX0OPHFgU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qc_xPB7GPumFRz5P7m5pmTHc1F5Nd40oitYwPEnCELw&oe=69E8B203"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4FSuBCj4QsQ7kNvwGnltE-&_nc_oc=AdrOj9CAd8QdwDhlGJ0AfIJKZdEyIuZkmS2-irAZ0n0aNXWVKOJfKrJo5oC4M6QCYbo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13I7uWs_1pVzsH7Kjnzw8wmIBdTBkX3hZkwG4Q8SyFMA&oe=69E8BCCB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEbcDry2-84Q7kNvwHmh9yU&_nc_oc=Adp551IiMh9VoKX2tGRu8XL3b37ERM0PMCrFykhMLsmVEceIqI8QAfIeHqRD51TfmS8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MQNUQSjzbf8tFwo_d8EE-wAhSj1xI0JkMTBuTtHn8qw&oe=69E8D8A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7HSH5Xw2jsQ7kNvwGWHTPX&_nc_oc=AdrXewn-_bIOxKhYa929dWLI50SqTKvWG1o7EmUH5m0zWPzMZRXu-RkX5b_L5GbfJOw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZCDEpfBooO4rOb1AoAuDU13eRxYTvLsxBg_efTBv2lw&oe=69E8B538"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
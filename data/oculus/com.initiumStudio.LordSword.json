0f&oh=00_AQTFD3W976-Nvr7E-1PRQevHoG3N7H8Xhyxwa5TNz2Uptw&oe=6AEB320D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3LuiA-s-nUQ7kNvwFh5vgE&_nc_oc=AdpF2P1mh3HGamquZalB3WExbW76qNcc8CVlnPPzrhe-QOHHJxcz-7oaBaaKlxUa4KE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfcz9xA9KpWwUOrGBl-_5h_NiLPEnVXn3YCB5fkK-cMQ&oe=6AEB6183"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z44pgHsszR4Q7kNvwE-CdCc&_nc_oc=AdpqPmxPihh8tlnNpgeBIULhcSHRzPtV4nzlIPxlJip18Ra2uOHRupU4uqj8L3ZgRqs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXreNpzGbD8R1xtEnDOlRFtH5fCnq9eCmh5A-ttsoynw&oe=6AEB5043"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jaRzOztvGLYQ7kNvwFUHHai&_nc_oc=AdqrZ_rm3qZDKOKYR16qYMvLIiz8TeyBSwT2-SVMgfcn6kzqEzrlgU_StykrospF_5U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRymefSAYVS_EVldTCK81ZCFI-vekHdt86OyTr1GtXe7g&oe=6AEB5B0B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRMqk8gVEGEQ7kNvwE-seKL&_nc_oc=AdqoUc8qkMYElkLnSMapEA0ucelagZ65WzioBmTn-4yQpncSHYiPtiCS5NKe_Z3w9MM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeqbEMheqz3F7M67_1OWBSkePW2GnczCY_1amt-PcrrQ&oe=6AEB3EA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBvRXUEe-JkQ7kNvwEdlWyK&_nc_oc=AdqWLnn38c8GAq4hm6jePQHEwPM5ZN9TLl68ryejS9hSTv8V2Taor33MD9Wpi_Cz3Yg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRM8YUP9-7pKHX7G391koJmMJDjz_6TF0rfYZDyVT3ePw&oe=6AEB5378"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
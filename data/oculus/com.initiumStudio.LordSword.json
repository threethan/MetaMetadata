0f&oh=00_Af3Ikcqce8Kk3nrubUur3bRl6SSsGxJVhjASvvwMo1Xg4g&oe=69D3B40D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WQJGKewAMkQ7kNvwFmZC06&_nc_oc=AdoQoewqZJ7Pq40M9IXVkOaLQ2LGbq8pba1HviplQpUcgWsTgs0OWwR8_tFq2uhPVBo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36fZNSWbRDcBEJ8fONoTqXURGrE9M-zqq7VBsP18P7PQ&oe=69D3AB43"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdJwXsyRF1wQ7kNvwEPVju2&_nc_oc=Adpo46c4GOwOP04GC65T52Uk6rS_ncNe0H4rjGi_CnDh835NKEfSMOQ8lz2JaMWK_Cg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MIOkB3wQSu4y8t2Winmdgo8nO_76TGoHgJB6zhh9kjQ&oe=69D39A03"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqbxgnG55iEQ7kNvwE5xxtP&_nc_oc=AdpyF0_ujctvf3fmPE6piy2zx3mODIxB3Rrh8mGtHZckMAl01UcnfCAXhZC4K3UIWTg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dByPIUP0m3mjEZEyPI3K-lFiajud6faf6ylj1rEFU-w&oe=69D3A4CB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTVktCKDUkUQ7kNvwG5W9FQ&_nc_oc=Adqw4gOssfrse6rWs-cstUJWGgJ5EJ1tbSCFmqnXk9-JitrXCs9PJl0CCLeGsOTLSM4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_m-4e0-bkrHxQqGQwDoqgrAlVVSK0Zlym8FTCwK5zjA&oe=69D3C0A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S02aLd3U12gQ7kNvwGWjCWV&_nc_oc=AdosUGvd4sH9j_CNvQNZZYOxnnEriz-a1Ms8oAvw0wQOLcVzsry2G1N0RhY26plNbLU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25wp4eT7bH2jPv0uQ2fJi_5USJhed-2zaWOjIaZHZVyQ&oe=69D39D38"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
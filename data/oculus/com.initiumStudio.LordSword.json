0f&oh=00_Af26JLkNH_mclcqSqps3eUdEazZk0iSI7QAPOSv3gU8wDA&oe=69DCEE8D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4TiO_gP24MQ7kNvwHKXxKM&_nc_oc=Adq5RmTKIs9g5KANKNF_hcO4pO6BUIZqDq5zUVxAWL8Z6n38Aw6QkjS0j33Kf03FBjY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bU5rxU5vzvtItYiUrMGC2LBeHQP3EIVh9vRwLgBxKVA&oe=69DCE5C3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKKnJMktH-gQ7kNvwHHs-Ad&_nc_oc=Adq3U51DCj8_wQnfK1QIF7NYyLVBHYqT1UN4dP4LrAQhewHNUDZcGaaalY8_nIx5snk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KdbAXJZYK32bWnTfnCrsg2uavtZA7l7JewAn_C0k9xw&oe=69DCD483"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lC88JtMuvT4Q7kNvwGza6t5&_nc_oc=AdqC2jxKmHL_Y_yk8lXtiS5C52BdUHU6p8ETkXxANLSEXuM8808oKfLqTUHsodvdwQY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dlLm-KbtpcfhqJ1bauPQL9GVuFePqH3E8afo9ZLt6rw&oe=69DCDF4B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IKFnhXeTY8Q7kNvwHMop-k&_nc_oc=AdrbsYdaDiE9Z7nQaNcPZrDGKB7zucduQ9sPFZDc2B0A9fBx_hTH6KZanNq_5HrXOss&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cTT3FkSBbQ7eThlLi6ze2d4HnbHqCUX93aYtNS9fQ-A&oe=69DCFB29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqBE2LombqoQ7kNvwE9pKDU&_nc_oc=AdohviSmSrbEb0_bufDbbG-kZsLT--eC-R44Sk7qceUi8OM9L9sWw1A9ySSpvW-a3rg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uaGFHwNJetq-muQHI1lpsw2zZFdO3DyvDC1DdLdm3Yw&oe=69DCD7B8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
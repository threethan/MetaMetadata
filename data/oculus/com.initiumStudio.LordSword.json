0f&oh=00_AfwtK7F1xz5eYoE0SWBmISefmjL_G5oSW9AlInxuizn2Xg&oe=69C3E20D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFum6DzgVv8Q7kNvwE3myuT&_nc_oc=Adri8juR8urDjH2_F9Xp1c4c12j9_sjQcmLDNtT0mUZ_YiKb3LhS-mBWQ0QR_2vVML0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0jMzfUvFu8_L7FR1y1XFmWztbwZtIGDmm8Uvd9S2ZAg&oe=69C3D943"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-EeEeQswVMQ7kNvwF15Jlc&_nc_oc=Adp5l1hFs43iwl5ohwXRnqgJnnqdhCjGipcLJ4Buq8ddZPhalCHleG58tGdCPICy9Wo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzm5IcTBJFR3GHsY7dhJzPy9HZEpgM-Z_hMpTod1UeLgA&oe=69C3C803"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JslV0b0OgaAQ7kNvwEXRiTj&_nc_oc=Adq0fpCCUPeodlthASnuRV4PTeGhsOHgOvVMgnkoamkN-wFO_FEJ4aAML52zqP_pITs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afye8D-MFBMk-cddS3sebOSsjaBG8vpUsdyYMx6X26RhXA&oe=69C3D2CB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BeA9baBSQ8Q7kNvwFw7u6x&_nc_oc=AdrhPDp2LBcTSXSx99qWFsR4cgWnHZxOYrNHGh4YKaydZAruO_5SbhqtCHSuLPW0kNM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwLphCpmMx7V--jzl4CvNwoGFjl1D-RPEqotDESkKUY1A&oe=69C3EEA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdgSGlVWgOMQ7kNvwEikWan&_nc_oc=AdpK7P5Djhy-UYoCgl1YWUj1oJdcMSX3iWjezQGXlxbJ7CeO-_rvvNS27LP0rPE6u-Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxzqjnxtp2N4AklI8SRky9iBzCpUE02cpCeMjadFqOZnw&oe=69C3CB38"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
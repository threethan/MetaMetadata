0f&oh=00_Af6icpd7uCtc68iATSBuruFqoYXsoEihRo26-IslnwIHHg&oe=6A1D880D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0b5Uadl9Hy0Q7kNvwFQJrgk&_nc_oc=Adq3SG3mplbKomLAVhjyFouxE-74g1BNGoGb8-uTsef6qGQZStkM2TID6fs_3bVAAiY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NslIkLP2WEduTVudZNTj1hoOpZlPoLT8sQ3DZpFF7ag&oe=6A1D7F43"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5H4DGdglYgQ7kNvwE7Mt5s&_nc_oc=Ado5D9P9yrCZeC-ESbDMEPUdgpS7PCxTghWu64rEUtE9Pi_GLziURvj_paBGiuazjzU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kBQjjt9VSjBNylEtOz4qJYdf0FeWEgPEbaHsQB0aSSw&oe=6A1DA643"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFi6nIYP_WUQ7kNvwFz4PeV&_nc_oc=AdqxGlOjVruwD5uBPyw91HyoNRrFtnFN34xPf-1InDiYdcm-svQIJj0PXvvLXodvBgU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lFmEzaAHt5IiPkSH-wX82PnF2Kil1dib4ptbIIq_Dzw&oe=6A1D78CB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PURWJkkBag0Q7kNvwFKAN6C&_nc_oc=Adr1yPnfBkKmfsM838Gpv4mllDqUSMf4o_LfFOBkrufRDt0ai39Alix7foYK8ynXCpM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BeNPnKWW_JEfQWcuQOLr8r-6ETAtwULRDVSDyhi_7hQ&oe=6A1D94A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E08OcDjvJXIQ7kNvwFCYt5P&_nc_oc=Adp7cFvC4D4q_rGSat8TS6pcfik7WDIO2XJgY6ar-_W4UQHGYgtqBd1uoWcE4yciRko&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hDGDyLixkVWWcnb0VEiZYEpx4rvWnx2qLobCf8i2cIA&oe=6A1DA978"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
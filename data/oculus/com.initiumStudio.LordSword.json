0f&oh=00_Af2VmPVNvkxVpLKz4wBd5MGRdX_AlvmMK2YINzJzp6bxvg&oe=69E2348D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7bBx4FyFMIQ7kNvwEiTrEX&_nc_oc=AdrT0AuUWMc7sZFEAQm7a22rNrgTiH_yvS4tD7jnoOPvKuX33ffPpv5dgwIZqYeNMlA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2G8U5xD0rhsYxDUZHUFGIsyRAQTUzOiG5xd98Pqlv-lQ&oe=69E22BC3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LeA31zSVcIQ7kNvwH17UQk&_nc_oc=AdrfVRcVVC5105qSFuKx-aZix2meITBMBs1ibmx_66_meaGQxLKG-7QUXAL_Mj5ioHg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WhO2fkiPvplE5HYF_yDWr7r6zhW4ScstU6vc-ZlmswQ&oe=69E21A83"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9PmOBD1woYQ7kNvwG-e8Vu&_nc_oc=AdohJcih9aUO_pMiCKx1j18Bcla6Bqh0n8sSIlUjI5-kykfD0EX2QLMEpHSNf8laUaA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GPDfeFIJ04HUojzhmIdQuLoz4ciPXcreB1zQPGf-VWQ&oe=69E2254B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ruXCtzXxaEQ7kNvwEfq7pz&_nc_oc=Adrd31SMbgvt5Gighi2YwpPEv2AfY2X8qhzFrK2yBpsLvUgLbTb86N1JusYY1NV6Qtg&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RizOjM_1vmKpHzeasOQf4pc8Xh2guNo216DHs960vHg&oe=69E24129"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOrJmUE-CAsQ7kNvwHi6qQS&_nc_oc=AdoMafOu1h2HjYmPLpvP8A1mmytMRqc5aSy0YTFIcEuoVUmgDNOLId-E0jO71C8or6M&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IsRY99nHnI4zPYwAtxZD_RyT0jONrofV0ZyeQQPI7WA&oe=69E21DB8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
0f&oh=00_AQT_sbO27Dqj1hqhe_Bx2207i4CrZY_F7j-r2CKNL5ZlUA&oe=6AF5F64D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOvOdS8KwqkQ7kNvwEOS67l&_nc_oc=Adq9MY9rhg08yil94JAa8vC5kNf2pQ-YEQp4pIGx2kfzJutyoGAGDrGlGtI8q9jzy7g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtb0GkNGjE3JjXdaoU2K1TO0QFm_dBfTgIN3Xdichbvw&oe=6AF5ED83"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1OGVWp6jyEQ7kNvwEhQUx_&_nc_oc=AdrNYsLjJqk9BLEZ-io00glh0MQb8l9HKSJIUsO7Uh-HFhmhHTQrYlBkIaBY7HLCIuY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXdPkJaB0mIoB44oGRJbmC7IYWTAeYQDZwjlSuzugaOA&oe=6AF5DC43"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCf__1Jy18QQ7kNvwFzlrk5&_nc_oc=AdqohEWisZqE5H6K5pk-iTQqaFtafEVbAjDZsmFiEIeh4PL2fQg29SvEQMp7M1XcRf0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYGHX5WtRjrWpq6zSUp6QHXjNnK4DfeOyUk3uU32WKcg&oe=6AF5E70B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7qbTTgIYCgQ7kNvwHvOJJQ&_nc_oc=AdrNSOWpSGgg9LVUam2mfZvJLwx6jDOW465oFltu1H9RuKcQBj3RLTDjPfcydwR6e5M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLTF_mz75j2ValbsknHZeGiEt8fuRbwx_nUkbisApUeQ&oe=6AF5CAA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVkr8mKLe5sQ7kNvwEjP92p&_nc_oc=AdrRwz7ka1nFPH2dWLAig_KEEqwP4oftcVUYrJQExrLD6y-yGjmqvyylzj8lE8IBH-U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSo5C7adFjrIF_Y09cOpERHcq2D1oV-6Ykb8GXHrBqZ1Q&oe=6AF5DF78"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
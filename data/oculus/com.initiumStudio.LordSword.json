0f&oh=00_AQKOUbPXbTWOSDmL6-5-WAijOoQdMW0fC83fWJ1HD6N4vw&oe=6AAD3B8D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pi1TuGGip_oQ7kNvwF6RnPs&_nc_oc=AdqFauheeBAx9Cm_gCHt4M0rPVgpT9TEH66TPCS90jMVXY2SFg1LLoCCbS6Km6MzFtA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_RV2_O8HfAf0Oa6-RwBO9Lkazm3iEvgtMKYxcOc9gEg&oe=6AAD32C3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nf-NtYaMyO0Q7kNvwECsMmH&_nc_oc=AdobHHI26ZUs3j9KruF61U2JLSMuKmlaJq7kQgZYX3KJmEx6yo6Rhd0SpnNezwAHUeU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1S_0QkOhq4LKw7V4K1Y9djsCzpOE58GmCa8O1Op25Og&oe=6AAD59C3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYuxeTxVYssQ7kNvwEO33TA&_nc_oc=Adpd8C8F_1B5UiwEUy3dsvyGZEE2eiqeL8Xkn1fgXfa-xyjd6Duc6ElNNtUVj9mw8pc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaRuEjK37qt_8Lwv7mz_2_SBhmIGO07UC1PIswjMIT0Q&oe=6AAD2C4B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90hwphtGusIQ7kNvwGWvHVF&_nc_oc=AdrSTAACa6ugzx61PuvdgzES2oGYXUDICgkK-B9HOA0LKJ9Vq1RPOR1VS1IbXqp9JOs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYEqBGcPMFpYZ9a7UqdbmXDmW9CtnNd7D2kS3pc1kljA&oe=6AAD4829"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlooWfEqpXwQ7kNvwFqNOSF&_nc_oc=AdoKBAeFqqmBLFIAgxBNSFBrk6AlU36m36Y9ictQKeXj1kvMTbR24kAHYp43ohUvd7U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEhnO5nGkakMwimzfw53_4fWUlTSIlEF4B3BmN2Y3kVQ&oe=6AAD5CF8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
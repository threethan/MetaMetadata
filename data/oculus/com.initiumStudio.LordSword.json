0f&oh=00_Af3Z_7Hwkm4RA-VuVSoIaoe7o4iXq58N3VzYGCDxw6uBEg&oe=69D6570D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WQJGKewAMkQ7kNvwFLyEtd&_nc_oc=Adqljvqz0yRMJ8qRTMbDxP8TE1vodnngRzhnb5OtGU5Q94whjijYF9I-sSO3GRpJmDQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16XI3U100-dbk0ARLLEQDwAkndWp9LI_udkxpR7MHdBQ&oe=69D64E43"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_fUFcllcqoQ7kNvwHl7vka&_nc_oc=Ado0-kCZ9xo4ARabLHQ4GZX5GXuBSyBQZT_tvn5DnJRpYCpJFaciv-L8Ibax8Y-lTjg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18oQoHjXNnsJ-oOBOXBOJNy6sOkJWXMthG12vAbzttPg&oe=69D63D03"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAEKNREtzwkQ7kNvwE7Mr55&_nc_oc=AdoCmlsx-SbSqFZX2eVJqkKPqS-cYGmI8bjTCxZVT4AWUKmzoIS06Wg8rIQb70D3xjs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EvBlSIIQAij7E-xeQSnOrzL7mELkBh8DDs1kiTLW93w&oe=69D647CB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1f0Ea6GQi0Q7kNvwF5S4sD&_nc_oc=AdpvxxkRraJcTH7DxVJKDpeme3Ucvu4f_03Gxo_cFaKVDsz3OSr6wvITTPDWL2vfSFk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Eyf1EU3rCsg-JiZDCPaGiKDDjfx-JJpKKHcM2UNlL4A&oe=69D663A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0VxegdLnKoQ7kNvwERhv5l&_nc_oc=AdrRdSOhakWj-rXIl73WS-_mUwiTr09hpfzU9rS0XgY2UpCyhIEC_ZrDGnfijjP4hMQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QLbPqidulVZo7Ltrzqvyca6aK7LG361RTqVdYrIcx7w&oe=69D64038"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
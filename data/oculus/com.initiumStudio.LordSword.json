creen12345.png", "id": "246898261472932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhDMS9GVyUMQ7kNvwGvuwSk&_nc_oc=Adn7vUJe-szWv2IaBg6Ntw-EwhoCoAQuFEEn0iv1RYCTVUCPxNWR0CmmUmqb4dZ0tdw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfutedAJNWHRVu4dUNo3D2SCm4CfTer0M3DfNzWQ8GETOA&oe=699857C3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJ8CvKalPh8Q7kNvwGugiMr&_nc_oc=Adk-0h76r3LLYBhZBCUtTfj8vOJM6ip8lhwKobJLGRCP0hCLRNA1TsE4Rrl2hMlx6e8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afs7AwNBriCZAZUq7KNmQB1_XevSSxWQg8N53FA7SH9OJQ&oe=69984683"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPbQ0NBlqdMQ7kNvwFJe6ZX&_nc_oc=AdlfJlawUfGURRJe25Ai8abi9FXIf8Rvg-XTBk8fBOp2uykFrPTXMd1CGYRLwl1WNzk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsNLQZpuYC9jVqzVdV7nRpuVoEy1mYW_DKCvN-ZbVy1Tw&oe=6998514B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWre5aQlC28Q7kNvwGkUeZG&_nc_oc=AdnKgk0MQ-bAKb0_EZR9Wohun3wkyuGpXXe_f1oq1E8plBgJeDMRHPevfWLxOsl2VIY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft4wpHvi4qOxbuUVE7MQ95AbWGC_qntbSu_qEFqyC3eqg&oe=69986D29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ik5nGpMthQ8Q7kNvwGBkkck&_nc_oc=AdlV6mkrJqd1rxVN8LzPAROd57e5QYukOHallhvWFS4U-Z4A5u0WS0qc7CzivH8fq2Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afus0TjEU1YAD28qrMXoWU-J9q-7NVeseNqnPQoU4b7jvQ&oe=699849B8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "website_url": "https://gametriclabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "274332
0f&oh=00_Af-slpQPKuHnwBvsRCwVQO1MNWR_mgqKa3WqkFhhM52NkA&oe=6A3E7D8D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8I72fT3lX4Q7kNvwFILTDB&_nc_oc=Adrwfby7n8sEnknh9RvLjcai2uN5uyAOiqdDF5ej7HeUic_L_0TCDIeEJ2a_wfvVM14&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WaXk0kAlWdsJciHnhvMILA624vsr5WTK_i8oR18YGcw&oe=6A3EAD03"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-loud8VAiZAQ7kNvwF-Evnw&_nc_oc=AdpMfE0dVBsTKtcgFak-S8_0vm16ki7RBXEbWGjiIiNoM9i8xjnAPZMTKZQW8yedDQM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bfiQ6clYAruMns1gDKpjaHTFXQmyU2hKBx_4FE_f5qQ&oe=6A3E9BC3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5VqB4pplBkQ7kNvwH370fZ&_nc_oc=AdoEUSc3ekzrLSUZSkOYTGmMKQGIAl_UIQas-GbioMfSFs84ZVLCpHkQ6jN8qy_Ka0o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HIw6Sy8zfLwx5JTWrgsvCZ168aja0Bk0KQxBsyulgWw&oe=6A3EA68B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykH_jC27nFAQ7kNvwFXbtrj&_nc_oc=Adr3KvD9RE0y7NjAZgCgtAM2V38eJC77z3uUcJTblc58Ie4xMUeTK5Al30eK_WHZk6c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8H1YKWxvxw5GObNLX5sdCKBCmmU1hGksmTix8xvz1ySw&oe=6A3E8A29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rr_SbAUfMxEQ7kNvwHqYKOR&_nc_oc=AdpHM7nDKTAGQ5serCLVOmvz2X7A4YAtQN90qGer1kqPENgbSFx_5AYxuCTPgloo8jA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bC8sFzSkdIZlij3BVivrdzn9MYBA0jxbMjlSoxPrsHw&oe=6A3E9EF8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
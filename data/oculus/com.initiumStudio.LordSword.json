0f&oh=00_Af3a_D4Jg4Sk4tKPGaj04uxZC3lTyjMrp7aSS-0zvZLNBQ&oe=69F3580D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6eMP2PAKRZwQ7kNvwGoDgsP&_nc_oc=Adp74Og4DdXVTq81s0KI7HhjQFvnJOPMtm3rHp-fEgVw8tw5TFkwRiCFbGSi3xpjySI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3GT3B9miJgSk-rHEZb6Pq9wKoFKGuZQhjo7zC3WmmCVg&oe=69F34F43"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fK_abWuU33kQ7kNvwFTLDZB&_nc_oc=AdqiK-2kM8RkXt61NLDNduVKfxsRm_AjyHgAkPQUTQn-FQLg1igAP5VhjxUijVwbVw4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af27mNNpan9lsiGMzUw2N2RhaRI9uc1-liHsoGAT_ou4BQ&oe=69F37643"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OR1rfbwQ10cQ7kNvwGfw4Rr&_nc_oc=Adp1ug267PZYdtLCTNOqzRgqa6Iz2-CTfvWA1gNskuMmblbSwmyWMaBqLnCx7lraL_8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3tjaheparQgbCLu0_SycVJsU3ejc5CWYNZJ1STRHqN2g&oe=69F348CB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJBihJWdI2sQ7kNvwHhJVXx&_nc_oc=Ado_ybhs7uvIjO0U9PYvp12HiAVXCjAqB5fHX579QyxhOKuPpmUaEv9ByFDWb8mq7VE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3DIKr-u17Lj7N4iVwx7J_AduuZj5dsdDRxhFBXnYbynA&oe=69F364A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddcWgA0sIkIQ7kNvwFn23YO&_nc_oc=AdoHU30-9xSBzc939GYyT02kcTH871RXUa7k55TOJaceyzzKnPbKw9JOXqX7GNnx6WE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af36lWeLVelK6fSCvGHkbWWu2c_1inpCCdedqcXHZN6KKg&oe=69F34138"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
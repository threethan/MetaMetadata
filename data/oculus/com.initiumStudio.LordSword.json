0f&oh=00_Af2osXkRUfr4jNypm73QMSDh3HVg7dvUmSUAoZ3lMql-ww&oe=69DF918D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7bBx4FyFMIQ7kNvwEGezTk&_nc_oc=AdqmHtEGPRQWN4A8hcPNWSn1-lucySz16Tl6c5ullQLTBHWQ-emqL8dwitGS5AqeQEY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0L8ORbjcqo9dVbJhOPo2lj0-SNMj_liIpXJzOu6mbmhw&oe=69DF88C3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TmnIXveeIIQ7kNvwFayy_Q&_nc_oc=AdqIYbUQ7BP1gPsx0rCIXszILt76Xo9F1A3NXjVp6sYMfL1tZS48JymBA0y7stp1SkI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CE-6qlbt3S5YQIlGo8zwqd6QVCNskL2CDfrdI-wEbJQ&oe=69DF7783"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lC88JtMuvT4Q7kNvwFix4wr&_nc_oc=Adqt7m9n93hyjIeiAaU4yy9lp9UCyZd0es6wvMfO3TsS02-emN1On_OqhNPtC74xLgU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-AzDcAAgS1Fd9kkUo3S8R3BSx38WzPRiZ1GdRRBS3qw&oe=69DF824B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrEu2W98ll8Q7kNvwFwUng5&_nc_oc=AdpSynzX-Ix8bEMMa-sHj5b9r2cBmxARrve9qtdlltgUbutzgIz31jrDbkQQ4DiG-EI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13RcbfjQqMOn_fBg68_fT6x54NuP7yCuhhJx6YCXKHjQ&oe=69DF9E29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynOWvNrSTkUQ7kNvwHdjv7F&_nc_oc=AdoRTRQQH0dQI5srg4ql3yqEZv9d9SjNAqtNGe2uBpMQGPI1m10BNNGNBzRrj4hv2Bo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31joSFb5mHe4mzKuCOk5rLbZ-odU1RHOcnJ6rtw7Nt-g&oe=69DF7AB8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
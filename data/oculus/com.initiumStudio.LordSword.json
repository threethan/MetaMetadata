0f&oh=00_AQNWeHyZsHjeGK8NSGQJpl48rM3ZIEg1zI6yVamOwtfvJQ&oe=6AE1F78D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itGUua3lGAAQ7kNvwHYPedq&_nc_oc=AdqCb_78C6-cvRFCDupF9yr5X37cz-IBlVPIkfBdic0ZilfrYq5g_WSt2CEnVFbKbjE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPL7gogqIM_ctrm3anOIS2quScz3ycfxROr_gUtsUoYxQ&oe=6AE1EEC3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1rSlG_V_D0Q7kNvwGhYvLS&_nc_oc=AdoYh_C21MLZEArIlUoytMq2LNLSIDVt2NbxAXsPA1kkT4Hnler0GDhmuuS_qKaEUxM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNu-LdqWozN4kMFtCXLndmU5gCjfLh8xd-U8OK98k4nZA&oe=6AE215C3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLEXM-ypwDUQ7kNvwEfvwUD&_nc_oc=AdrTGOxaEunxA00W3pmxl5T98D4aa0BAaYbiqxdpDt4EibIKOqKH9bNeGMdlCqZbXv0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOEZxgP9FapTQB_7C9VD7oNxorBDnlKoRJ5hAzU38qSg&oe=6AE1E84B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coDhMWMjzxwQ7kNvwF76-BX&_nc_oc=AdpG668511vcLR_OMYfdqbftlHJoRhRLRIbS9MY6kBsMA9ptVOjZk3nHQclXTt9aIFw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5HahEn5Z07TDIDhk3Rzzzfqnd4JnnDCHdhc7Zvhvjmg&oe=6AE20429"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWW5dSTzitAQ7kNvwHShnaV&_nc_oc=Adqe1RrLqGgx6CZqeeuRY-Fhw7HtpXTKURVRTRq5I4e35MjHBtg53pzs25YpX7SnQTg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkxbnTT8Gw2dad8izjK6nxEuj1HxFazsYoG0swGMLZhQ&oe=6AE218F8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
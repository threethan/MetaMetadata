0f&oh=00_AQHVivN3yabqFBR_pJvhPn8zOmm7olsXPkT8JQtMiBNuUQ&oe=6A71E80D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uv4C_g2iQVoQ7kNvwFinN4E&_nc_oc=AdqhkjoKcU0PdmqtAF9fBOZMFsu7xPG3MHHt-TrYy_kp4LCx85owGZvKiWzYkt_O6sA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3qQi-2L_DMrIerdaKmgUoPr03ORyjEpNG96MDipZq4A&oe=6A71DF43"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELJG1Je2TsQQ7kNvwEii6kW&_nc_oc=Ado0ltQ-qlXDY6506yp76t_aDI9h6pztAGBnJSxLbBxbydXYLSwkxqZm7d1YgHbW7TE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWjXuO34ZZgMr1z3QeHKN24CsO7RvowGb7LHiDK4QSUQ&oe=6A71CE03"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NsFz4xCE1cQ7kNvwEliSpl&_nc_oc=Adryf6XfaHC6AuSaO2cy6DRMkDaOV0DdMS5TaEatUmWAdyceIpm4GxwJzRzCVqZF4KI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIwj9-z_4prDugeP3YmzGEX5aJ3YrUXbHH-CallbWaeA&oe=6A71D8CB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kP1xLNvFrhEQ7kNvwFXAaVP&_nc_oc=AdoFFuCrBNTmE53MrQIHzRPKdaek9YlW_KxBbMusiloHp3-ePvSVv5bl1EEltozUML8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGabM_n8Y-bHxcNzt-6t68Nblskpl3o4fAFxoLzLh3IHw&oe=6A71F4A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4yRbrrnsoIQ7kNvwHuaQOY&_nc_oc=AdrX6BDqtazzSU4599dBUSyZgXPlXTWdCrsPHdJK9dsjd-7mEj0j8kWXh6dfhz-x9tk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJ47PzsEplhPK3HNqy7GEPHL75KC-i0_JEVh24uzEbwg&oe=6A71D138"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
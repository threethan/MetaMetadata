0f&oh=00_AQEgrnTNMhDjnNkxhIi7xloNGIJxQHD78YTKmBa6gW8eEw&oe=6A79D10D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGTeQ4MmbaAQ7kNvwEV_Ks7&_nc_oc=AdolN-vXmanmkUIZn-giYDB3y4lgylw7_x9y7DPPmkxjtDQbhEkwPOQwsb46nvUpl0w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtsEmmfouUro7wlQGlUlIGf3-Lv-J4xcZtHOWY3CUk2Q&oe=6A79C843"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymq6xTXTUqwQ7kNvwH4Tsqk&_nc_oc=AdpeM9IrZ28Em6sH-6WDN0yFsyPKM5F6ekV11qV1M5zSEqe0Eh_CMH6Bg2usnhH7h2A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGiPTqvgP4AfTpd6X454ac8g5Oh-HyXQr5WIYAHoD7tw&oe=6A79B703"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tvjx-etXE0YQ7kNvwFEunvD&_nc_oc=AdpatcsMv4qL2whAunbzKw6AzhSMiWdJ8ih4RhmPUSPkCCCrjzJolY2Gz0HKKwCID1g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGELtD0-XfbuNJOid8nm2CBwyfKd_kpd2ErDewi1k0yaA&oe=6A79C1CB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkF1BqYnJYoQ7kNvwEZx7AY&_nc_oc=Ado_6QhiD60puENCVIppjqTbm1ygnHnnAr6k9KSvBnfxkJPScpU3NOKEh1OfkQr5s8I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFy1PS4qr2L3A_KEDQv0lVD4POv4ndS4hC2Fleqb1NnUw&oe=6A79DDA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRUeBTejXdUQ7kNvwGhvMY_&_nc_oc=Ado7uVjcZRh_PlSYDKSfWGvY0pZbsyzMTiQa8cELRYCMc18t4qPSgiDy4U5nqWcBoxw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHKPKfRcSeeKiXdAHDYyH82HLXykyhXeGZOS2ClcUHFw&oe=6A79BA38"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
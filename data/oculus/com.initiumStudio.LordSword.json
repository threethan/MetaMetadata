31982762456_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a08oZFmr0uAQ7kNvwG3B5SY&_nc_oc=AdoH8DVV4GAGWiWWpCieQccwqCjBmc-4tqUBlbSXvoBcygPnuNrAnBHkqts6xbDaWVQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3V4F1k2gPsLJGbZm6DUz-l2g0ZRucGqe5vU9QPHkR7jw&oe=69D667E5"}, "display_name": "Lord Sword", "keywords": [], "long_description": "Lord Sword is an expansive VR game that offers players the opportunity to experience various combat skills. Players will hone their sword-fighting techniques, hit targets with archery skills, and unleash powerful attacks using cannons.\n\nThe game features challenging missions set in different locations, allowing players to diversify their skill sets. With various types of swords available, players can create unique battle strategies, while each location presents its own challenges and atmosphere, immersing players in a captivating world.\n\nEnemies possess special skills that both test and encourage players to think strategically. Upon defeating enemies, players have the chance to collect their rings. These rings empower players to strengthen their characters and effectively combat more formidable foes. Lord Sword aims to deliver an unforgettable knightly experience with realistic graphics, tactile controls, and a rich gaming experience", "short_description": "Lord Sword is an immersive VR game that takes players on an exciting knightly adventure"}]}, "developer_name": null, "developer_privacy_policy_url": "http://initiumstudio.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "INITIUM STUDIO", "support_website_url": null, "website_url": "http://initiumstudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection
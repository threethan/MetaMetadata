_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ2-FE-AB70_xJczNDP_sUvjjrV3vgGVLzXlq-D5BEs5Q&oe=6B0C6C69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_BO2EF-wlcQ7kNvwGBRQ_m&_nc_oc=AdqEPkcgrf6zhjtTbAtvOX5L28_DUm-O5V4EXlyvgmkRcwYtbFN7dbuCI4a9yV1p8Xo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRCls1n7XgdpyWSewgvSV9ahZrym5Y06tSGApB82ogUow&oe=6B0C8138"}, "display_name": "Lord Sword", "keywords": ["combat", "archery", "medieval", "action", "battle"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "website_url": "https://atakanerdeger.github.io/gametriclabs/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29705547019132669"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820652_1851160492464584_6882961558622310293_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdywYN7u0-4Q7kNvwHkq1c9&_nc_oc=AdrXZrST2coyiNeNS-Wkoi6BAsOhwdY6AmtQ4TnNzL9QEp0pzsj7FbKkISmSqRQD9E4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSREjYcRTtI9-_heOacNhdmwf1Ei6LQkCSJOP0L8CWXuA&oe=6B0C5CB2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lord Sword", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Role Playing", "id": "821934236779161"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name"
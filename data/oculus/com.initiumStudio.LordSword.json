0f&oh=00_AQNxFkQ-6r_yVnCDpSBnvnUi02rrcDlZOgtP1dArIj5itA&oe=6AE3490D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itGUua3lGAAQ7kNvwGpty0K&_nc_oc=Adrjw2pnQAxniMFF8fC5bQJscKXYCjdOFT1fjNULcPVNyI44SHCZhtaDJokF2f834Xg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrS32bBqUATdmG2cnbxsEQYK9UqFtxE0eNN5OzfkDR6w&oe=6AE34043"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZYvWCXylJkQ7kNvwE3jTOK&_nc_oc=AdqhPUGuzGatMvqiQiXlPdgS7mrP8lDZc0xYuorghgYlIHpCmVcpkP3OCze3bwIl6VI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIOEliEV5mBLChMH1i0URqFKgusa5IACTdMQnhVkHb4g&oe=6AE36743"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLEXM-ypwDUQ7kNvwFWCnMu&_nc_oc=Adr4FiJ8bO-I8r8Q7DzTG1k0akgb4MICeuL5jJOlBhXr2vvjBalQnK5PGzXb8nFZhMM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGXVlEsI_iPkwuYkxOklak2cygkeyVdUNRdx4uwCoehA&oe=6AE339CB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKL_EqYNm24Q7kNvwGgLshh&_nc_oc=AdqOQT4Hr1sk30L2jGUPqJ9zVXtb5ysIi0YqKain_oYVEj19of2tF1tWqHiEbx83F_Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPd-J-3llhHJ8tkQRat6di6OkIiG5issc2trLaJCp3y-w&oe=6AE355A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOW5ru_MdtQQ7kNvwEELraY&_nc_oc=AdrQxtVgM7nHP2KxZd3_TZ8ekcFrwd4LSZDzbCNQlWijM5_LFCUgdTY65RjGNBMlHq4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5uD9i-lYILe4v1SAAQCaNf56GiLY4EUUV3zFr7LULfA&oe=6AE36A78"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
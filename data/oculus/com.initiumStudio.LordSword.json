0f&oh=00_AQRpryyWrwCGNYfeFq5GKa30nwP4WFs6tP8jfUOCdnVHrg&oe=6AEF5ECD"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1ID5jpllMkQ7kNvwG8sMNt&_nc_oc=AdrUkf5wlk_2iqz53Xmp9JcCs3FTuJ6L8GjWJOhSnURBvWhqzD3cq-54xShHAeoiEAk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHJSk4lhNvCS9ydOgllVQOZudjMVoTNARZ3s_jh8nfyA&oe=6AEF5603"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxQcdHQ3ZgQQ7kNvwFdHiTu&_nc_oc=AdoApKD3YeIWEYF_V9oV_mPLNhdBWhAY-T93Dc_6NvX0J6mHPKHKWGXsaQ5pzBylfw8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVAlSy1EvPzbPoDcfGNzjPc68OiAz8gsVF9F0LUfsCUA&oe=6AEF44C3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNC1jSohdpYQ7kNvwFccA-3&_nc_oc=Ado_mxr8KzdDnuh1ppbuEhaUCBAS1L6_GoqnF54jylPGVnV6PjYuxpSo8IwVWpAJ-II&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXnd7ZVnPThBeEphUKTo6nYZPfvyhQq7pIDNwL-DregQ&oe=6AEF4F8B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nF9mQQUEQMoQ7kNvwE5BHhR&_nc_oc=Adq_2OuK_HVRz13gGYk4rsm67TGUodHFvyi6Y9QBPEHkpC5fdF6oZPQgIKfu8yq-v2o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROWC9tPaMp3L0Uz-qQ9NKhDOtuYMhIyKdtaBGhOgEaLQ&oe=6AEF3329"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hd7aCmvFSg8Q7kNvwGfGqJ9&_nc_oc=AdqOrFvAaz0abIHNvltUj_VxBOJLWxJQpzv8WNvR2tNh0z6i_vFcqoNFef7V6H03xkU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXMpm0NXNUlGYgI6WLB7cQGNrFGBCGlO3Wbsy1CURIgQ&oe=6AEF47F8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
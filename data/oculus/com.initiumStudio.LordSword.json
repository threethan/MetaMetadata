0f&oh=00_AQGFLpGAvhWI02WFgkwVnDEpCUHR1QzwLYhfLwq39pkPGQ&oe=6A8AF48D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_hjbbaQ204Q7kNvwEoT22r&_nc_oc=AdoYpIaY46rcChRcCg3tQ90oakrNWDzKX9EjsZXeKsGnc7Ed178NiQv18gh6HBpS8qY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDfpkWXLkuPaxjRyxNBcceovfS7wUT8b-TNrdef6s4zg&oe=6A8AEBC3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ZvLdSiIOloQ7kNvwHrr4z5&_nc_oc=AdouoEGb1haqicKS5phgkIreF1b1e_DRp43AyULZoJw-a_Rs1kFQQudLg4dxt-rawmo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVNU9T4o88CyMD4z1hKEJAdyOo8_wAGq9u29fdtjawFQ&oe=6A8ADA83"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QU6ojEsgGoEQ7kNvwHp3bAc&_nc_oc=Adrk0FAa2IgEzcYx9DEBnEQxvfOjjxiL4VRkhExIZIw1KEQayQR7kK4-s8AMzoSS624&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEi1WF7szapHZrlzc-dzuimf4ymhW0a049EnDrbnWmybA&oe=6A8AE54B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkt5RQDwy3cQ7kNvwGzv0Ln&_nc_oc=AdoGYxxm2LlIAblLcWPkM3C4xPHZi09IFb7cYp8MQq_aGKnBznJAfjqFdXumgGhy0VE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGql7NFqk2XD95R4f9J6Wtw3IXGyf_2BHKE3XNe5M6LAw&oe=6A8AC8E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vj4JryDsKnAQ7kNvwEw04T6&_nc_oc=AdqBhJ7eXCq6iWn49L1T8Yjyn2Ifg0Jq41CiiD4p050vN4u0iJFG9Y69as9ze4tfM2w&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8jVzqBpcFcQOewwisoOfF8IKFMU9FRr0EuvKtJm5t4w&oe=6A8ADDB8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
0f&oh=00_AQNB541SxgS78_fHtEpCVGec2XyH9IAw4XACGeX9MQdA3w&oe=6AD3AF4D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htgKNpqpYlUQ7kNvwGzh1yz&_nc_oc=AdrTRu16sgGimjivL9-Sbl0nLrIKPqF7bFeP2DOo5PqTE45aYReD5FMT5aVWZjsTcHE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4ta2mnQzHSAAx6giepBqv2crpb5FwdZLK4v_ebr9nmA&oe=6AD3A683"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_Qa5P2n25cQ7kNvwE_eAMl&_nc_oc=AdoZCKdNG7EVjwUeOaJdjXoIA5H0njd1j68xzC78adfu1Cghv8jgnRFOkFP_L_TLTeo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZTqk85QzbSm_5bmoUDK90LzdVcmjw6GHkxYNhM8PTbg&oe=6AD39543"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4HEuT3Md8AQ7kNvwG3PoVx&_nc_oc=AdqF_87441Ekn_icQdELKUbJkATsKM3bBk6wXHpmL262pgiZPg6HNvUHtokUTLSxWwk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBcbYfLMNFD-RLbzsHKUXqfW97bGmlyoFGgek24u_sAA&oe=6AD3A00B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvzuSc66438Q7kNvwFXOm0o&_nc_oc=AdpxHBo5XHqRXFot8goxMYDgNBFv_kmSgrDbgTVwp_UEDJAqNWgraFJ-FdclsPj5BO8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-UHomQVaG0uoBb1KFs1H0MCEFUpNy2BEUi21EJ1WgCQ&oe=6AD3BBE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dh6TbeG3DZQQ7kNvwFnFlVP&_nc_oc=AdpZEuviMkWdLMeeboQgrLNWHGi63P18q2bbZdpLS--HTi5TwAzNChksYjbkMl0pKUE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGjovadmZGYpeZkc3gok0_CQ0_oufS5iSwh1JnK9W4gw&oe=6AD39878"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
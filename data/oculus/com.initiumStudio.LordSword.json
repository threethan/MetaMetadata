0f&oh=00_AQCGkPAkDaWVNRlN5mbLapd6_IkZbBDjF_WaX7zFiiRd9Q&oe=6A64B90D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68scx0AQ0QkQ7kNvwEog40j&_nc_oc=AdowoKDUgGk7-1uN_yo3ZLQ1sJ6ndMOfcCCkG2wilPhc6Fg0WLnXxSACaVzur0xTPec&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlzuMG6WitMH9BWjLvCI3hYL3UjhWRcwo_SwVml-jqPA&oe=6A64B043"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tu54s75x4v0Q7kNvwE6JqZ8&_nc_oc=AdqNgjnpqMJm_58v9W9udgIccPmi_kwPm5bQ4pwuPb90nvSb9ybTXqvT2p9GyQVUZKw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhZHTnU27FIdn4vzeP2r-mCzrvkSyNaSzDJ6ogYlclkQ&oe=6A649F03"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sL7WCwI6C-MQ7kNvwHL_4Kq&_nc_oc=AdrcSlS8hSVfD4lkpv2Q9MPfb_7UDKEkb0kfZK5UTxmMsLD9MMnCPSMsHx5EMPk9lkM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDaLUlCTD9E47T6VYJIheQ9hL_cV9IJjEepeVAQYz2Rw&oe=6A64A9CB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qAyiwTscGsQ7kNvwEa72Zv&_nc_oc=AdoPW3PeXArkiz1VlgpqZe7K6Y116Gb3Yc07pwLZSIp0vljoPCDYRwGsRg6A8W3-cKI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqqugRUkMlMnpyBKAUT_dR-R7vNUxLHQUn-mE5q5CGVA&oe=6A64C5A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSPTv_p_qUMQ7kNvwG0qg17&_nc_oc=AdpY26G5ZuIe3CH4J6p8UOu5sX0xJyUeEcT1KHqf36OJd6GghyX_bHXV11j_BzXZfdk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZ321Qsc-lk9-Ls8xpqdhHa8xufyOAMiiTBCmaUnIv7g&oe=6A64A238"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
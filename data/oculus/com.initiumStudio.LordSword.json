0f&oh=00_Af_PQPWMLIIvV5a5nXmNaMAHLValDoBpvX2CJLUy1FHt-A&oe=6A2C088D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXNMm1in0ZsQ7kNvwE_tCYa&_nc_oc=AdqPkBo9haP0FL9atTY46U9EDTzVTcHSygpSZ_03BmmME5uQjppRkFdL_hhWqj84bB4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--58vBtfwUK8jxNxg6fr0bhS77MyndoqmYP9hgoTfm1w&oe=6A2BFFC3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qk1mFeme4hYQ7kNvwGKTwnb&_nc_oc=AdpUHA41vphGdM_Str2eT91_XELL2zboXI1P1BGaNjOs8m3tBC5h99CJGBd6_G3nZOw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CdUNKHRQ6iRSvNSVlB21uK4BefTgCC7KaU39WtBvhvg&oe=6A2C26C3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8c9T6lbuPIQ7kNvwGaV17m&_nc_oc=AdrwMnht1ASI9s2qIdilZSTbR7dd2ETmPPLlNZikf6J3FPar-XLy8uqqIU3j2Pf1HGY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FAs2cPvE77pcZgxprujeHQgPU9uWhae617fa_wQqdRQ&oe=6A2C318B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpUPFlaVbugQ7kNvwGaSmaC&_nc_oc=AdoU-AtY1PdEk1azZ9rccA56_Db4we78g3hHIuwr9JSk7al6F87fMskKT8Ks1VJ9l2Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JopNEoG14PQiso1Rs_78EAenSPLa808wuU5wwzPObBg&oe=6A2C1529"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDfxTuEeZhcQ7kNvwEZ3kro&_nc_oc=AdpaYUMNLsQM5g5vwhIJBJ6jkpN7t4FvhgQ39GHi_gRgeqWj_6Ztd0EflAebZPZ8-io&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9su9cyXw9XrRKiifHITGxf5jT0Y6RmaKEaS1LxF_saXA&oe=6A2C29F8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
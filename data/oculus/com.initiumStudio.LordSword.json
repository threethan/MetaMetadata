0f&oh=00_Af6itEb2bZe7akPYuTiKj5ZdF4SS_tpy4OSlH254vbJmXQ&oe=6A047B8D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwQ11Qnnj1sQ7kNvwFpqnYV&_nc_oc=AdroXhQO2NUHXi50CDGPS0qgiKv7ImD_5eRYIRHFM6sUh8rTAWXnbDYTOOe6BsvnPfs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KZxAnl76XkqPRrO8f1AZNlnjPGGP5fZjduECArLtoSg&oe=6A0472C3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mB_hg1P3WiUQ7kNvwHtWnZc&_nc_oc=Adp6KCmdaDkjl6HEMkfdfSbE_fBY7fnxj5Q6eU-LxlZ8d5cEiXkd1ssy48ReWTboB6I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76XJowXdX4ppCPEpfkHxdeXBu93oXX0iZefC0EVrVzcg&oe=6A0499C3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9gaaUGuDT8Q7kNvwED4LKw&_nc_oc=AdrQ81H07uPJRu8oCvm8WkqhuzNokkQEATTWdijVrsJGRXcHy1VZEg1Z5wE0iLU1meA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6N5pbVOcLHYDbsVB0tWW2mq9S7ZN28yae2LLmWHI0IQA&oe=6A046C4B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJuI61ENCYEQ7kNvwHW9AhW&_nc_oc=Adonr5wEwJ9Z9zSDjOeqH8LZU6A5F1T8AhHlNKSmK9NdhcEpVmbEmC0I9DxIG_V_bWo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4g5nO6C9tiqc9zGvTvkP621zmzkmqRQ_bBHN2qReq0tw&oe=6A048829"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84KVk02Juk0Q7kNvwGBa_d9&_nc_oc=AdqrFZEsKS6_5pOqsdF81z37c2zf8j_y0CUDDtn6MyRvVmTNK1kvOZW28kxR3chyelo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cMzhNiOstwtT3EH22i2CptbQS6eJT0KOmmVMKkKNVuQ&oe=6A0464B8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
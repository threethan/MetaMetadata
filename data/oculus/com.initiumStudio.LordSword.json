0f&oh=00_AQJk5DP7Ul6uvSlqIY68Z_D7oA6zXAlflnLXP-qegcnpRg&oe=6AA6A40D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSSfwmrxGBQQ7kNvwE-mDa7&_nc_oc=AdqcNlGI0Xd7bCQCaeCBeJtQcSVhLZYSCe-7LtyiPGtjk33XFr9EJ2k-6Z6vZSfWyL0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_VDoMP-d8M5cebwF0_2pXvmKDw7VnBrhSph6Ry1OUrQ&oe=6AA69B43"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KP7GiLukrgkQ7kNvwH_mWVg&_nc_oc=Adq0CiyvuS2qO1vioVKzXTfTn5mJs1nHd2vuFCB7ew7sRt8BxH8VmWAAarImcXjaUaE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmbnqgq2eTORKeMmXfVsi6aptizmVl3RyxdglOI8TLUg&oe=6AA6C243"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UF-8ocXRYwQ7kNvwGLAjMg&_nc_oc=AdoRrQhrV_EeBvWxeJBmWAPC3NKlU527HcoP7Ibprxl14igNTzw-Lti4V72P9Z9duRk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJ2SG6uxEL8rh6OJ-XucQjBqS8nUX28fB75ZOFdau9QA&oe=6AA694CB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7y3AsnsVA0Q7kNvwGm_OlB&_nc_oc=Adqbojfe6VwgasswtRcsZoch1tSnUZJKRu96hiZy-bjz_264YBQskiNBPCuu7A4AKyA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH_ByrZXQypfgwwHH-QW0wXBhY8YJUxTR2YL_dx5kUlQ&oe=6AA6B0A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bRfIlDA8CfcQ7kNvwEtFl-B&_nc_oc=Adqpy5zJ_-9JjBYaTnzdNKCxJtaD8Afr9m5rdXmaV70aMZxbyQi8oaedKahmYUGKDJA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbgEPhJIk_hOcBCU9tjX2bM1zFPLsQRisDOlJsYSwlEw&oe=6AA6C578"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
0f&oh=00_AQGnCOHTLrHi6YPGBIL3sGJv0ypz-f4rrVwyO_WfpnHI_Q&oe=6A95B8CD"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raexbDfRQ6kQ7kNvwGzkti7&_nc_oc=AdphwhiSidcnwQEKzFluuh_uL9FoZVzKVhsXmzHvh7pv2PeT69-FD5Ta1bLi4u8BI1M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeuNzdpsh2k5V677KT8eNrCZairuduPqztNzhU2K468A&oe=6A95B003"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwr-v7mHs3cQ7kNvwGTu_o8&_nc_oc=Ado9Ei1RG4JXFOrt2SPZMpujymqXDuqBr8aZFxLAQ1UfNQRfi-_y0AyA4t_6jU31rBc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsk-T-GfPGG8n8oVhNfcrIH_b44AOYrQbD4ToZdKMuXA&oe=6A95D703"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVhw68DRwhUQ7kNvwHnHi5v&_nc_oc=AdoVSuwdxJi08aB12M0jwovuGourQjqX_aj4dyZ9Wvpy6ArLqqgyWstu69ZTin56Zzo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElB4G7FsxQ5ukPuJqdSuZ3xpBhyeIKuMvTvBNIsa0uaQ&oe=6A95E1CB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFgfchf0874Q7kNvwFYchX3&_nc_oc=AdrHwyR9dp4lh-ogo9_bHxCuNXYJXHqYlTtCMsccBAywxis12gvGsFqDqm3emsggOJc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzw7qKbPwGJW8dJzlkQmhKD9QDzhAbsB7azont-AJp6A&oe=6A95C569"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXvCRir7kWsQ7kNvwG1Q1vG&_nc_oc=AdroRZo4NjD4x8Mh94iCo0F0qxyz15Q9Zloeg-EY5V-4XXfVmBSbdmGWQ-RPoTbJ0wo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHB7LL7EsXe-FHTVgJOg_rhU8p-QeoNSyVjbZ9Wwd7lSA&oe=6A95DA38"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
0f&oh=00_AQHesMWX-0S764MpZ86AA434WXWXpNqOlo985bL7ik8ZyA&oe=6A7C740D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGTeQ4MmbaAQ7kNvwEsgFDd&_nc_oc=Adqm2rqeXkD1fP4Agbr8P9CNwlp56wrDszfk9neJCbffSvq6XiV6NeBJlOJgam7T89k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFcCIz2XDA3n1lMAj9wXuORoR5j_FueJvDqn8B-7NC1w&oe=6A7C6B43"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PuMcwjcJ83IQ7kNvwGfCe4v&_nc_oc=AdrWBpt3CFobUarTRU4XHHE2Qizj95_INw0p-7lPeBZrZPIcZkq9BJQpNf8e-z-uLew&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYKsg5QC3oyVh0EldX8C62EYKfsoCMnSxluMj9EjgJ9A&oe=6A7C5A03"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YIo2kVDp88Q7kNvwGWFnwR&_nc_oc=Adot6D5W94Lk_22JRPFse36trPd6kMGMcXDwgLVegEdMZrCqow9kB3gqUtko-a7G310&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETF37M5rslalMOLAaLywwhPh5WeTtHIu1mTKs_xeiDuw&oe=6A7C64CB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HGAEW5JHY8Q7kNvwG1vq7Z&_nc_oc=AdqsFpARNRIdMJXVY53oy2W5Kdp5w14VqhsKi8N3yphT3IyQ2pwj7z9x03C7pIOypZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFp20qt_uwcUPFFKJUTpgB-tfWkrtuRS43S3bdCfOJQSA&oe=6A7C4869"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wE9f2W_RK8oQ7kNvwGtmtsM&_nc_oc=AdoFPDfqT_bcyabN8AGCVM4juy7teFjXgREDLcUKKMeYbuBfwND3N-IYfoYsupInIso&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7VvqxcZb_XO3Ktbper7QIerxkKPYIjY8VPfbbigWhNQ&oe=6A7C5D38"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
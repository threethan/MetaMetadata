0f&oh=00_Af1FiRm8JJyM_bgxpluU8jLWNl-xmeMulKuur35dsqTQBw&oe=69ECC08D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7MENtA61AoQ7kNvwEX-mhF&_nc_oc=AdoLOpKTDgpsaORu8qrTPQkkjI1tCtZhGyrIDOPvZh3eZ2JpiUR7Co774uWlY0xh4lE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01OO16pVgC1QqVydAOSbP2uelJBA1wn3WgliYgH9olyQ&oe=69ECB7C3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xhp-9eiADWIQ7kNvwGoWW1U&_nc_oc=Adr-HRSEPSj5MAqDFiPrBDjAkE1nahfKTYyn5EqURkKpvf9RHAgXku7w7WTLTdguBC0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KIA0BAw5U35BD5kw0lva574x-cLFmEr3BnEpz4zKo7Q&oe=69ECA683"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hi-uB1DS-yQQ7kNvwGesDgH&_nc_oc=AdoQz2oJg6ucAhiCKbb3YYOonrwTa4Wso5Lt5WoSHZCQPsMFQpa4bNjM5wy-krpYCbA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fd3nDoYGpNQfUMfrCYn4PraKN0ylKuitf667-rMYUfg&oe=69ECB14B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qf4MlrtbC1YQ7kNvwHvePEj&_nc_oc=AdpD3KxM9Rj37EDUY7Y4Raw3H74Kk0SFcN3QolLarj0R3L7Nnhl1I_PjGG5YUZOwxxI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3v8mFRc5xG05emkAle7RDWgNLJX9tC8KUru68UpWKcsg&oe=69ECCD29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vtvsgjqxpsQ7kNvwE-T6aQ&_nc_oc=Adq-dzgyt5VSgme4Q4hXdAdmyq7p9SlakuiT6G_89bHsqwKXndKXRus9PjCgMma2tjY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jPg7YXbEUmwCbIYPPp6k6R5APYpjSmb4NalU2Lh8NBQ&oe=69ECA9B8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
0f&oh=00_AQNu6t3fNrIIOkm34TZrxuMtp_9V80R7QO6mjkSlHjTuOA&oe=6ACE694D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsUF3k_0WsYQ7kNvwFNUBFa&_nc_oc=AdqEsXktVDYjG5kmTUaIt-9qhY30AWvnYROfVXWg-1MjSEhM0mXcQIxT7BfdgaDlvzg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRJOx7ZSTxcLfZ2LCCyTCF0mUtcmdR_XkfQ2RQZyWtSw&oe=6ACE6083"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVrtiIWkqq4Q7kNvwEDLPMP&_nc_oc=Ado9noPDSkd_sGC_OOAphVkZUfsbvHMa3gNZcIpWHlOfolyTJIH5yRAc0bVRf-lQlXg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUXLtRjVdnFm086Ac95pYNf2pkfP3TXtPjb3_dMy3paw&oe=6ACE4F43"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vA0TMjzazEwQ7kNvwFiIgSm&_nc_oc=Ado_cZe4YXadGtFBDhxYd-9d5zlBDwiNtJlGCEMfTe4LhjpGmRcQ6X8nPbPZ9yiEsKA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFNlYmFpMbBXFISKxjcqZyLS7-VmUMovWi17cBGwXR3w&oe=6ACE5A0B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWz5IwJ14KAQ7kNvwGOZbaS&_nc_oc=Adrix_djxWC4hpTfaZSZpR7QKfALSJ8uP9yIBssZG03pAw4SY1eJUWvnPbIMFBH206k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNk1d-Xm_gXOgYYr6do_oXUbR2D5C7JvwyrLrihdfQvzA&oe=6ACE3DA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfdSxXA6XVMQ7kNvwHGAhPw&_nc_oc=AdpcGSOO6RJntLH9UMJlbOgBudBBmvjegpPZ5rqlYHbJBGKzB7Blkxf6wFHDAnMmYGc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhqQRdFaBBsdw7LBt8MKZ6-fSkzj-hAxox-3T9tijcbw&oe=6ACE5278"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
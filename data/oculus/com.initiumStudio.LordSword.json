0f&oh=00_Af_6QbK3XceBwNhm86zwvUlcgp5iLnr-TpXb_t8V_QoFug&oe=6A29658D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utFAu2C2GiQQ7kNvwF4lMrm&_nc_oc=AdoMUJyQPmCwyIRZyqikTJtQvDfPUO4_sP2AFZLMpD5KQF7i20T8ezOLWqYsR4kMI1o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Cn2RxkQC1bO2Fw15nWD5Ww5ViNYMcOm5DI701txJvEA&oe=6A295CC3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qk1mFeme4hYQ7kNvwFuDgjC&_nc_oc=AdrtOwvOva1iLm-tBngRn2kiK1yn86bx-EoFDY34_ABEv1LtmNnmoIL4tKmCM75qIao&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OLP731RyxAy1WXp-cnXoBJIBuDMBUlX9tqAuPrDDCrQ&oe=6A2983C3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDHjFnrlIsIQ7kNvwGLoIjP&_nc_oc=AdqLqSgxNmWdpMLFA4kRKf4z0wR3HIJkylnMjD3Qa5gPKRUOQ1KCyKW8FI8uB_Al-yE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9018Rw7a7ytFnfZSV_82_Jf5NWBWOmTyjI3ZTTv7cJAg&oe=6A29564B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpUPFlaVbugQ7kNvwGiDuXt&_nc_oc=AdrklM-0J34r_8V1gtCE7dDYtugFLw2ILk1I-zOvnAHrWenHf7t6B2dBBjIEUa90a8s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8OLgZcPLgArKj93rM5cYiF4q9P-6HB3Hpe6-ci51Mzw&oe=6A297229"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDfxTuEeZhcQ7kNvwHEjQoi&_nc_oc=AdqXfbMseQQNmlnXuM6eYVKAXd4ayTIZ1adR6GJPLHx8YRJ6PP7CqAGgAyKf0GFSMxM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bQdl8yXHoRrA-vD0xwpF65k0haSN9D1LzjNguLykB6w&oe=6A2986F8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
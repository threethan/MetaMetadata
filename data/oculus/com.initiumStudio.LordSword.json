0f&oh=00_Af5AevqiLsVS_w175-qbjSRR3LOp9J5P_vdNkc1FAV2eTA&oe=6A144D8D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02CiNX0yTgAQ7kNvwETWOHA&_nc_oc=AdohUdwmt3k48slvfZKc9snUD_YnA7HKS1y_aHHxCvnrGpKXVZNGFJ4cHLm4Pn72wII&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7c5OD4B2Kg-ZClE_N5j5KzyZGOEprRC2ZglRtXyvdNbQ&oe=6A1444C3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNxvSHSuRBIQ7kNvwETIQfW&_nc_oc=AdorAC7KoCKtxAJZXRwB9efoQrEq7E3SqrjUvDlL594KPl567E1Ecfbi83vHTKLWKCg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UE9ryYfAwwvx1XWp8qdD9jDFwlKCuN561OyiPHAARJg&oe=6A146BC3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bAncdVuqZUQ7kNvwFwqE6E&_nc_oc=AdrT-Yu8M3OrLpkkmdkgG3oBwQj1qWgpaLz4TE18DZuUrn4g8bdNB42Fmf4g55thi_4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5b0cB4sdloqVWU7xcrrmL1LHITYZmNCuuLZOKsFJFbsQ&oe=6A14768B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9tCo83EQ0EQ7kNvwHIjuLD&_nc_oc=AdrStYHJHzJqgvF-o4DNaNz6mzk7Yl2FrFKHg1miQFtL1hGS2PnyxDpOjBhCchcR-_U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tN0a1KbDfsN7tSB_u_DTO4WmgxNRYd-1ua1TJF68JWQ&oe=6A145A29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mmue0D1-u0wQ7kNvwGAz8l7&_nc_oc=AdrvqkyNwR40TSDVR3BQiQPtmXdYVtsFnvPyDuFExiJlsaUNBIpJWf6jYQWuq4lnFz0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jdipLVj2kcziemBdzTKLHHWTZPG9XkaApdOum5UtyiQ&oe=6A146EF8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
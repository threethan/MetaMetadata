0f&oh=00_Afx_6Hi1lgDEqKlcgowAdK0mbWfOT16DNwWNVKF-FVZQxg&oe=69CBCB0D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JLkGKy5-hsQ7kNvwFLpDBb&_nc_oc=AdpVTQ98fgBwOhFvP9VyGbOtakx5byTRbOKjR0XXyP4n7lNlxf_tVd9DucFSUgcnBcw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5H8MJMCksP6dWMsVVD7rybJn1qIdsyyzVno2dynfftQ&oe=69CBC243"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-B-i2diNnyUQ7kNvwGkGcZq&_nc_oc=AdrPUoYLHZi-nInaMCwgBhzaWCpRdTyXvhtdKPmK211k8BnMVZMvSKpyJRH3Smz-iSQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxdANWf6cn8NTnoS6rV8I5dk1VLLvef92hIcdDB4oukKQ&oe=69CBB103"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVo0rMG8DoYQ7kNvwG2dAzk&_nc_oc=AdqI4oDLyQx-0DVgORXItPThuf9fudcfhETtlBWHTvp2XIQfLhbyBf9l4YWQBIvC0fI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxP6bpKEOQPDz9wcSaduLfqmssOy8_lM01bJT3nMi_u0A&oe=69CBBBCB"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H97pMuKT4NgQ7kNvwHx1P90&_nc_oc=Adp_hKRkZVBL9vzsQZ6gVQDYSZ8X0Q2RPy3EAZDn2HF5fdkB1ZZQIoyKYeIWJHwdOAg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1176glz7QHcJo4SEBbhxWPNrCqbBzmqLzbVoDZSiwXw&oe=69CBD7A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iq2sgjpSoz0Q7kNvwEU90VF&_nc_oc=AdqUQ2wVWYhwGLPDFdY6-ksY7XPMkWkZUgTxMVXFBUP9RVkxBw9Ue0GbmSzhuU_quBI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzoiYkay5FHNZLuleTkW505MgJQ2f5_7j-opBMafG2LSw&oe=69CBB438"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
0f&oh=00_AQDP9UmZ0PI6nHL59X60d1OMkYZuntwzm2K52TdKw8stxg&oe=6A68AD8D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXdPCNPI7e8Q7kNvwFYMFrN&_nc_oc=AdqCyiP1HJneXIr2Qp0v-BTKYbu6MyAEBcDmbdSAkpkdhvfCik6z-YYObE4sZk_SpTo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAL9-H_jgAaz8zqlddo7A7jlL2aNn5yK4oO0YcqqfuzFA&oe=6A68A4C3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZ0oxNirr8YQ7kNvwGO05D4&_nc_oc=AdpXcwrJ9AiD-TlMxmrdVOO0oYj_cZ4lnS197_O0EBTJT7dPSQ64uoS_MsuxHoo1lGw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0LWPMq9uhiAJGFlHUDasaXr0OVdSmDF8d4SAUPOiU6Q&oe=6A689383"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQK6PgLorDEQ7kNvwHHOO9L&_nc_oc=AdoR6ocw6OkL6RJwDDNYyJwQR1PYybEbJDAzJA1Xnj1-mib2a4Y9EY_IMC42Wr1A7rQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDQDnwVheEpgqgieLSohQEypnJhZk4ddkz8E_Sut3lug&oe=6A689E4B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkLrlsFbNC0Q7kNvwGGsk84&_nc_oc=Adr-mlqPQ2Z2TVjK6UVLDrbvw64dDLzZNRP-a8-n3M4yMapHcRUGrIMolak6N1bccrI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB46zcZ-n-LaEnsZrpf4_QFyAGjtnufgIaRRIgjuN6VlA&oe=6A68BA29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EyMrPyIMHgQ7kNvwHvBFQZ&_nc_oc=AdqZHmxGKon6nxtKQsTIS0cJHc5fvyZqBbaMs9kLc3AQceUMN7jcjJ89H-3O8qrd1LI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDo-B3sVpbCsBwBw4kDQkVGFUUAskBMxqEOsbLUc_gEQw&oe=6A6896B8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
0f&oh=00_AQKAjw2RDrtpeGxHt10RG3rECCvbjTqT8JfRiBG62VIlUA&oe=6AAA988D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Es4rmV4uSwYQ7kNvwGvYOa6&_nc_oc=AdqTYt6nFGo0VKAbmNXCk6c1T1Fc56sld3SwWyGHIaCvUgxOxuMRwFe4V18m9x1L8kk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzCWTcEpeJVC-NdYHae-CvnrLqWCmP0tGZZiq06t_IRQ&oe=6AAA8FC3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlJhpkl2hPcQ7kNvwHVGjDQ&_nc_oc=Adrz3nvutysiYIn6zTxVC0EkeO0hmUo5pEliommKkNJ5Hh1M0y9bj1PLl5YDCe2QMTA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKt1MML1n83v1lNHDSRSSDjyUklbuPlxm37ykLWL8N0UA&oe=6AAAB6C3"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYuxeTxVYssQ7kNvwFh57tn&_nc_oc=AdoHMjwhRs3bxO7_jjYk-xNp6FJnQRuaarF7GNEBrd3MDlewSo02fuD1Zst5HlIMJp8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCRRMcW1Hn5uNi9pC4hSArcMgdje6mPYlqQfa7r-neWA&oe=6AAA894B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PsMMeY2elYQ7kNvwE-GBiK&_nc_oc=AdpzqBsvymDTOQYOWyKp704jDqIDd_VVAVrVhmN0IDRRXz0XPB4dHFAh9iLAXPTL7DM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUwEtOOhsw5Zr4-AeUrQbdZri7ymvCBBh9n_GSev8JEg&oe=6AAAA529"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJxCHxZg8iQQ7kNvwFuZVwP&_nc_oc=Adort1jViY1rORPkiu0IXg0XqTKHlnM-lczvTNEIUZwTIINLuoTVNbH0aff9K1s9Ofg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFvVugX1eFAAjs8SlBggPFHgrlTmYEPfischtL8d0H4Q&oe=6AAAB9F8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
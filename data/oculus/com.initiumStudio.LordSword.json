0f&oh=00_AfyeyEZLSXlfQ8yR35-h6AsOj47rx4qVbHilsvMFGTSa2w&oe=69C2908D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_K2YOl73DLAQ7kNvwGSqB0z&_nc_oc=AdoXMKPGhkIc6R0dl1DUra1ucgIBcltkx_yvYACwwNcyv58mz77rWIXjLvBW5jswj_k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzC9RVLKuYYj3T4uReTrP4n2SedbhE0RcG5ml_0SDmOTg&oe=69C287C3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-EeEeQswVMQ7kNvwGWjasa&_nc_oc=AdrIjGUO3pgAZPuCF2JpK9MgGFkzBbrBeG_fO4Dv69rraS7_8pdybQxEORdIMJqgDvo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxxxN56-9BpDOP2DjgrG73TG8DQw14sfn8wisV64h0z4g&oe=69C27683"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JslV0b0OgaAQ7kNvwHgH5ot&_nc_oc=Ado9hTG5Hi6THYcKFi7RgaSbL8YFzg9v6dKK57y3uPStjt6zo16W-iRF0yX8fGLvlbU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMpgAoCJv8gKmv7rNML1SCDngkiN2QExt4JjGHLVVrhg&oe=69C2814B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BeA9baBSQ8Q7kNvwHLKzPG&_nc_oc=AdrT3bct7_re7Z68fz59Z3f-jHufcLSD-4_BTwqmcTUyAvNa16-qbzFqkmWujQURxZY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-bgwEXCyXhO6CVfIkOKENkXnXz5lBO0D98yDIFFIZIA&oe=69C29D29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdgSGlVWgOMQ7kNvwE_jKcV&_nc_oc=AdowgE1HUk1fsMQMv8-cM8IbX6PaSkvdp_pjb2q2YkjJ6sm9vxioIh_HAfEKcisPzk0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5xTG1gnbZXKwXDYs4x8sXUUP4921shdVauPyn77JZcg&oe=69C279B8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
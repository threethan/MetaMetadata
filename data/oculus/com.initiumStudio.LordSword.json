0f&oh=00_Af2MxuNg67ey93eNP24aU95rr5_TsXyoAf2O_1QssPNloA&oe=69E4D78D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2puE8ruuDUkQ7kNvwEVjQzJ&_nc_oc=Adp_kVUFbDwPAKZzDgojvbNlJEIYklx4HtQwi1gwrqBcG05gnvonLs-q-LtEODKS1PE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-ky1rRFOMmoT8tafFWS7wJdh8ASnGSaY1RarDxk0oVw&oe=69E4CEC3"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LeA31zSVcIQ7kNvwG5noEy&_nc_oc=Adod2Vdt1Yuw2IAP5M5xz0O8FajVKDVbJfsk2z85zXDsrdUVtt0wFMmDO0sL-73_SXs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sNAa1hnJZ7SaPDlC9oM7iRL3xQlmU4u8yx6AbQ_N-cw&oe=69E4BD83"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9OhEo_bh-j8Q7kNvwF2PYjv&_nc_oc=AdonO5BxVOiAWIrvzMAWgEPTYWM1RvStn5FgFssdnq2Pq7mjPS2-LolmaVQq6AZ2kJs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uLbzygT4fJbAu5lthZBmZXeLJGo_2Fcp6iBbAibSmtA&oe=69E4C84B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ruXCtzXxaEQ7kNvwGl14Ul&_nc_oc=AdqQLHz902CxDIJWr4njhbHo6kl7CEk5NEufBp-kjDvuewnTL6iWxFfNc7pMmlMoMx4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mVpzs48AGGxqGkXLXbgZA7Jc0Uk667M6sKwlLtXRW7g&oe=69E4E429"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOrJmUE-CAsQ7kNvwFv8wnj&_nc_oc=AdrNv7steZPfAOY9sR1tP9Chs1AQ7fn7MCXmvB7jP1Ey6C4nIGm2_jbkRj_oXK1416E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZhYxfDpq4LXy8TvQN2yaxh0lTujYfjMbiR7ieAjTdUQ&oe=69E4C0B8"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "w
0f&oh=00_AQKX5PxN-NrA4trdv2s2WSxR1PYcvWaba0DuHZQVPBO1rg&oe=6AB6760D"}, {"file_name": "gamescreen12345.png", "id": "246898261472932", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974713_246898264806265_5381629368639228970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvDKiflZQJ4Q7kNvwH4nd10&_nc_oc=AdqTLwumCeWLw8ZKiYWePwelzyWf2_RnGQG_ErUMPcuUvXYePIFtbbWfbPNz2gqmrMQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtA7Il7ttdIQeN8JnMK81zs-MpJiM05i0mTKHWa7KZMQ&oe=6AB66D43"}, {"file_name": "gamescreen1.png", "id": "371374958797614", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031529_371374962130947_3540417017781708338_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhuNBf-YBmAQ7kNvwH64LUs&_nc_oc=Adrvh7kTJpqAxtdSEPONk6r91jPswvGFIknz6teVsVEA6cqN0M9g1XihehLTRmVsilY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdH5winFStJCbXbmeQjnsFkGHrlFao4T0tly9PoIRBTQ&oe=6AB69443"}, {"file_name": "gamescreen1234.png", "id": "657110669942332", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035383_657110673275665_8191198135835254505_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCrU4f4vuRUQ7kNvwGj-0Kb&_nc_oc=Adqqtcqh04N35VP7CkJ7g1H88sTGBWKW-g3m6GYDVfJ8bpj4upjSyct88sXt9cMvXEY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJq1iJm2RmnEngsk06YKycjNWZN0Fbq9J5QeT2WF6yZsg&oe=6AB69F0B"}, {"file_name": "gamescreen123.png", "id": "861362685732774", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86652083_861362689066107_5970623050731370384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ky-wt8yVA48Q7kNvwGmUBVw&_nc_oc=AdpctdQ1h9Jp2cyRwV2q5iTf8BroN7K2BUcCeejXU0M4hf_PAODrugGQyiFMklHFYjM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFriHrYQeBDZWJbUfDSbXM9o8dXzVXYMJws4RX7-z1UA&oe=6AB682A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x14440lordsword.png", "id": "1021737459927982", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819476_1021737463261315_2880860548768558844_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hgdfr02HrkwQ7kNvwFyLgZ_&_nc_oc=AdrdQMvzezH-8596HNWfeRqg_cHIysKpxUi-hkLzqVqS7EABYhht2pUddAXHEsvFsNo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAD_NniOlnswSo_-dtblNnQ2jUnLvaEUlx1s19uEghwg&oe=6AB69778"}, "display_name": "Lord Sword", "keywords": ["VRConquestGame", "MedievalAction", "SwordAndShield", "ArcheryVR", "ArcadeVRGame"], "long_description": "Lord Sword is an arcade-style VR action game focused on world conquest through varied medieval combat.\n\nTravel across the map and fight to conquer different regions using multiple combat styles. Some missions focus purely on archery, where you take down enemies and defenses from a distance. Other battles throw you into close combat, fighting with swords and shields in direct, physical encounters. In larger sieges, you use cannons to break defenses and open paths forward.\n\nCombat is dynamic and destructive. You can break enemy shields, overpower defenses, and smash through obstacles using raw force. Each weapon type feels distinct, keeping gameplay fresh and varied as you move from region to region.\n\nThe game is designed to be fast, accessible, and fun, without complex systems. Every area you conquer brings new challenges, encouraging you to adapt your approach and choose the right tools for victory.\n\nWith arcade pacing, physical VR combat, destructible equipment, and a conquest-driven progression system, Lord Sword delivers a satisfying mix of action, destruction, and domination.\n\nConquer the land. Break their defenses. Rule the world.", "short_description": "An arcade-style VR conquest game where you fight with swords, shields, bows, and cannons to conquer the world."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "suppo
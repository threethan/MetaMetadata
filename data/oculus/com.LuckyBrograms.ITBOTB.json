&_nc_oc=AdrIVV8dO0ZG42d9WUG0zungBYn_VLAJY8QapejRBFdD2kzFq-I3sOQXwGzFyuh1m5k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SkR6AnCkEtxJvw4rjDFehKKR2itlkpUHYi4q6JUL8lQ&oe=69FCA230"}, "display_name": "Into the Belly of the Beast", "keywords": ["action", "adventure", "puzzle", "platformer", "physics"], "long_description": "\u201cInto the Belly of the Beast\u201d is an action-adventure game where you jump into the role of Sploosh, a sea worm who is heading out to bring back his children who were swallowed by a huge sea monster. On your journey through the diverse and unique locations inside its body, you have to make use of the given properties of this special environment to solve numerous puzzles.\n\nMaster fights against DNA based enemies in creative and inventive ways: Eating DNA of different types will change the behaviour of other creatures towards you and will provide you with different special abilities.\nFind the best tactics for each area!", "short_description": "Into the Belly of the Beast is an action-adventure game where you jump into the role of Sploosh, a sea worm who is heading out to bring back his swallowed children out of the belly of a sea monster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://luckybrograms.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "LuckyBrograms", "support_website_url": null, "website_url": "https://luckybrograms.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langua
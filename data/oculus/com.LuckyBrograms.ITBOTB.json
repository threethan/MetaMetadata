ated_date": 1791218424, "id": "40066900336242559", "version": "1.66482.0", "version_code": 2663, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "40066893649576561"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35218389384427036", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40070110205921572"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1181114180577614"}]}, "change_log": "What's New \u2014 v1.664\n- Smoother camera and punchier hit feedback.\n- Enemies behave more reliably (incl. the Tentacle boss).\n- Better performance and lower memory use \u2014 fewer stutters.\n- Fixed the main menu running after you close it.\n- Meta Quest: rebuilt on the latest Horizon/OpenXR runtime.\n- macOS now requires macOS 13 (Ventura) or later.", "created_date": 1791193503, "id": "40058399010426025", "version": "1.66478.0", "version_code": 2662, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "40058393637093229"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35218389384427036", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40070110205921572"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1181114180577614"}]}, "change_log": "FIX: WallTrap is now syncronized", "created_date": 1777018343, "id": "36200911996174765", "version": "1.555.0", "version_code": 2659, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "36200907282841903"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35218389384427036", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40070110205921572"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1181114180577614"}]}, "change_log": "Full Remaster of all Textures up to 8K\nURP, Graphics, & Shaders\nURP Integration: Initialized URP setup with new custom shaders and post-processing integration.\nHero/Player Updates: Integrated a new Player head FBX, enhanced eyes on the player prefab, and improved overall hero quality specifically for VR/Mobile.\nBoss Fixes: Resolved the Brain Boss bug and fixed BossScene camera handling.\nEntity Additions/Fixes: Added new glowing fishes, and applied fixes to the gumsack and more.", "created_date": 1776240729, "id": "36013705701562063", "version": "1.537.0", "version_code": 2658, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "36013700851562548"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
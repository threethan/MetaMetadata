?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqKChr8i9vYQ7kNvwGWXA_1&_nc_oc=Adr4PDqkUpFkqG6Ku-42mDFbBj_39DyIlV54Nel9BGe6YGRsBmG3rhaYKlSfAcWSYDo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cqJ-CsP9kyVoGUUmu74m0sE268QtHF_b8LqDOTDKBGQ&oe=6A11A7F5"}, {"file_name": "cb_room03.png", "id": "331477753146473", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036614_331477759813139_271405501176878627_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVd0OuGnFakQ7kNvwFFYZoP&_nc_oc=Adp6T6COe7s5nD783x2JjPHKRtKT3OpCT85RYeedPuTRDvZL5j5QakpzdTzuqMEzDgs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59POaapwKds467TZxmdh2GS4e4fvfsLX-AEPIcJAEe9g&oe=6A11A43F"}, {"file_name": "eng_social_soccer.png", "id": "1275095123881093", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75254875_1275095127214426_2608683143222814144_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHtrwWr5dqQQ7kNvwFZvoHf&_nc_oc=AdpGSSQojExyH32ip2gcEUbC4o3m8lBz9mCcnjd_sxuTbgtJDrJtbD6qT3CougRZIlY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43lKNrI96joBKN-m-c5yKZ9jCNlmbYGfS0gmSy6jP0cA&oe=6A11A30C"}, {"file_name": "cafeteria_post_02.png", "id": "670108341956450", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/86636486_670108345289783_7821924724203181479_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSMn3PeldnsQ7kNvwGOp3jb&_nc_oc=AdpbnNaqgps2GGY_nzytGlmWVXZDSsWeJzEi4rueHMax1VumOuBo0CUenH6DyiDEQVE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YRPhgopf0N0lY7qzY5UFptoH5XLdU6mOoYGoD_APUgg&oe=6A11B132"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stvrcaf.PNG", "id": "1347674722606091", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031356_1347674725939424_4814664499412655823_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sc0EtyqSgzwQ7kNvwGOITFK&_nc_oc=AdoUv3MlwkCHpgy-Uie0pIVj9AycwOq1dB-Db58W4I5vvgEgThOuuvv6mTuErh6-ERQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pdjx1yc5KAE9XavLf19xckX2AwDGaYFSVTOEK7I2fzA&oe=6A11A1DB"}, "display_name": "Smile Proud", "keywords": [], "long_description": "Smile Proud is a 2-player game aimed at providing psychosocial support to adolescents with cleft lip and/or palate. In the game, players work with their chosen Super Pet Pal, SuperCat or SuperPup, in going on missions to help others in difficult social situations. During these missions, players have the opportunity to practice addressing these situations with their psychologist, who plays with them. Players have the opportunity to learn more about how to address these situations and gain skill points along the way, while playing fun and engaging mini games. ", "short_description": "Join SuperCat or SuperPup on an adventure to help others in tricky social situations! You\u2019ll go on quests with your Super Pet Pal to help a student make friends, win a soccer trophy and help a social media star understand how to deal with cyberbullying. On your journey, you\u2019ll learn the skills necessary to address these challenging situations and gain skill points. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/13Qq1A5pVVwtP4qs9GiOn6irv1RvdzsUq/edit?usp=sharing&ouid=105529289327632046589&rtpof=true&sd=true", "developer_terms_of_service_url": "https://docs.google.com/document/d/1jArzbSbgeZEYzy4o2AC0yddLXhJywpFS/edit?usp=sharing&ouid=105529289327632046589&rtpof=true&sd=true", "publisher_name": "Smile Train", "support_website_url": null, "website_url": "https://smiletrain.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "821934236779161"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_grap
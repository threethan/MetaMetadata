0a&_nc_ohc=FCJdX9PgEmMQ7kNvwHc_EiN&_nc_oc=Adl0nrj2DUg2u2a71SuSYOJfIlTly1yecCaIuRKp9AZZkuOhNVxvJKxwclqfUpmIiOs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxcNQBI0uFGgwGtntMFg4xWY22EaIUGehJmV3wCHNv2cg&oe=69BE9975"}, {"file_name": "cb_room03.png", "id": "331477753146473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036614_331477759813139_271405501176878627_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ifc7Aj8fbVkQ7kNvwGTKuRN&_nc_oc=Adl5oO7be_I5qZW90RTGy3sNCbvnempXNVwXW58A5iRdNdmXUqiibeAv8NaBNAjCed8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTxM4ICbatsqW8YHGvtqs6un0mJMjvcVBE1qmOKacdQA&oe=69BE95BF"}, {"file_name": "eng_social_soccer.png", "id": "1275095123881093", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254875_1275095127214426_2608683143222814144_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAWh0vZuW1kQ7kNvwGASC3B&_nc_oc=AdmWxJtHZbT_JzhVM6ydzscfO7x3hncVrcTDoetSVzaMdSHvbqN7Zl7qBWMKq_OWRdw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwvpbH621wfe_oC8bWVFcoU3QFL5kIJ9qivRlUPIUnmIQ&oe=69BE948C"}, {"file_name": "cafeteria_post_02.png", "id": "670108341956450", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86636486_670108345289783_7821924724203181479_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KUNqJP7l9AQ7kNvwG8DT67&_nc_oc=AdnJywC9CcvuHF_uI6IYQykzBAlv2GmCnu5i5Sp5T8xLUE4XVA3mbPAEfu5RRiPkmqw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afywlev6_f1s-BzvK03N9r6PBDjXhnb30onAfiRjLzXJkQ&oe=69BEA2B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stvrcaf.PNG", "id": "1347674722606091", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031356_1347674725939424_4814664499412655823_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tn20hAnn5WYQ7kNvwFvhHAE&_nc_oc=Adny6CAzO4438PirKl5Ckj1Zd6IJgX0UatGN82K_ziIx6ea4vsjgnm4oOHyJN05pNgQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyFgj6bl6STA8K9sJPK7nY8oYc0OU7wZUlFrGHKZfwA-A&oe=69BE935B"}, "display_name": "Smile Proud", "keywords": [], "long_description": "Smile Proud is a 2-player game aimed at providing psychosocial support to adolescents with cleft lip and/or palate. In the game, players work with their chosen Super Pet Pal, SuperCat or SuperPup, in going on missions to help others in difficult social situations. During these missions, players have the opportunity to practice addressing these situations with their psychologist, who plays with them. Players have the opportunity to learn more about how to address these situations and gain skill points along the way, while playing fun and engaging mini games. ", "short_description": "Join SuperCat or SuperPup on an adventure to help others in tricky social situations! You\u2019ll go on quests with your Super Pet Pal to help a student make friends, win a soccer trophy and help a social media star understand how to deal with cyberbullying. On your journey, you\u2019ll learn the skills necessary to address these challenging situations and gain skill points. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/13Qq1A5pVVwtP4qs9GiOn6irv1RvdzsUq/edit?usp=sharing&ouid=105529289327632046589&rtpof=true&sd=true", "developer_terms_of_service_url": "https://docs.google.com/document/d/1jArzbSbgeZEYzy4o2AC0yddLXhJywpFS/edit?usp=sharing&ouid=105529289327632046589&rtpof=true&sd=true", "publisher_name": "Smile Train", "support_website_url": null, "website_url": "https://smiletrain.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "821934236779161"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommend
a0a&_nc_ohc=H6kQ6OCwC1MQ7kNvwHzpb0M&_nc_oc=Adm0vQ18OpF-BLHXgXbp_zkmaiEDzwe2lqBAsuRbudPXum2KwH9pB1Wd1jOJ8NHgiZc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfyMvP4XR7FtMr_-sODQQnHNkS5QgF78PqRtRBkOsHYKBg&oe=69AAD2F5"}, {"file_name": "cb_room03.png", "id": "331477753146473", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036614_331477759813139_271405501176878627_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a33-gxHaZdUQ7kNvwGOJZP1&_nc_oc=AdmP-DajBtqF49zX0XiB1zxA7TgKJva0xd8caOblMF6xg3Vcx1Bsh4tylnE10-AnyhM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afw9aUQBw359L0HxsO9XrREiCfohCAO5C7IFtFXLUczkng&oe=69AACF3F"}, {"file_name": "eng_social_soccer.png", "id": "1275095123881093", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75254875_1275095127214426_2608683143222814144_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPScbEohym4Q7kNvwEQsMZL&_nc_oc=Adl0vS_O1l13ePW5Qnk9F-zANUWBHivUBCRvTT7Lrq3Of749wcXm5fqB4GeCIkbPbhA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfyySLQfkDmW4g5_O0VIixL7nTdLo1b7V3QtHS3T63RHvQ&oe=69AACE0C"}, {"file_name": "cafeteria_post_02.png", "id": "670108341956450", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/86636486_670108345289783_7821924724203181479_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mc4JstEmflIQ7kNvwHZpfk2&_nc_oc=Adm2DG9Pd1RZarWKJmc-vsennetD7fkHf5rez1LKjP4JmIodJ-1kOAn_kkdZ2wxfOcs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwl8cWrc7apeDLKjMM9TZ-xM5F6cr2lBsj1bo0PUQfiMw&oe=69AADC32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stvrcaf.PNG", "id": "1347674722606091", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031356_1347674725939424_4814664499412655823_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZlmPRVaviIQ7kNvwG7lF68&_nc_oc=AdkFYzDj4mJ6QmVtC--Lw0Lo_RZR38d5yqyo7DXzMTcyc0Yr09-0-S2uRM_YScv7ZXw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afxc1CrM6reFQiI5R75LzFoAmbMaCDHKTdmTJOlaqmYn0g&oe=69AACCDB"}, "display_name": "Smile Proud", "keywords": [], "long_description": "Smile Proud is a 2-player game aimed at providing psychosocial support to adolescents with cleft lip and/or palate. In the game, players work with their chosen Super Pet Pal, SuperCat or SuperPup, in going on missions to help others in difficult social situations. During these missions, players have the opportunity to practice addressing these situations with their psychologist, who plays with them. Players have the opportunity to learn more about how to address these situations and gain skill points along the way, while playing fun and engaging mini games. ", "short_description": "Join SuperCat or SuperPup on an adventure to help others in tricky social situations! You\u2019ll go on quests with your Super Pet Pal to help a student make friends, win a soccer trophy and help a social media star understand how to deal with cyberbullying. On your journey, you\u2019ll learn the skills necessary to address these challenging situations and gain skill points. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/13Qq1A5pVVwtP4qs9GiOn6irv1RvdzsUq/edit?usp=sharing&ouid=105529289327632046589&rtpof=true&sd=true", "developer_terms_of_service_url": "https://docs.google.com/document/d/1jArzbSbgeZEYzy4o2AC0yddLXhJywpFS/edit?usp=sharing&ouid=105529289327632046589&rtpof=true&sd=true", "publisher_name": "Smile Train", "support_website_url": null, "website_url": "https://smiletrain.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "821934236779161"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomme
4_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MnPPMs3114Q7kNvwETK03e&_nc_oc=Ados9RQRK_TWhv-jXZ3nAnDHXnJxfQJuMxmjOl6tj9YhRLSM6UrvwIqGpaKkzDPEFVo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVZqT4eQ8CXtgp_RrKom7NI1_pfrgGAJoGcZ1_KEnvkg&oe=6AA54B0C"}, {"file_name": "cafeteria_post_02.png", "id": "670108341956450", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86636486_670108345289783_7821924724203181479_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwAFatQKdl4Q7kNvwE6hbWZ&_nc_oc=AdqSgwnLKXY27lF4WJnASeF7YCdwAM7ElReFx417zq3SkmUClyI_PaRf-Crz8eIPGtE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpmj5dwZtsYH__mf1M5fW3iz-hDmNzuFoRMUNnhboYrw&oe=6AA55932"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stvrcaf.PNG", "id": "1347674722606091", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031356_1347674725939424_4814664499412655823_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwfNzzVtSfwQ7kNvwFevzeb&_nc_oc=AdptWxiIWJiOJhZWLFst91HEDSq6Mp8VPR89ndSQFpV0-NVTYKJfnXtG-Bx9sOMq6_E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfb9U45c7jBMPuzfrVcA11TXn3BKSb1QIsH1CVT9SzvQ&oe=6AA549DB"}, "display_name": "Smile Proud", "keywords": [], "long_description": "Smile Proud is a 2-player game aimed at providing psychosocial support to adolescents with cleft lip and/or palate. In the game, players work with their chosen Super Pet Pal, SuperCat or SuperPup, in going on missions to help others in difficult social situations. During these missions, players have the opportunity to practice addressing these situations with their psychologist, who plays with them. Players have the opportunity to learn more about how to address these situations and gain skill points along the way, while playing fun and engaging mini games. ", "short_description": "Join SuperCat or SuperPup on an adventure to help others in tricky social situations! You\u2019ll go on quests with your Super Pet Pal to help a student make friends, win a soccer trophy and help a social media star understand how to deal with cyberbullying. On your journey, you\u2019ll learn the skills necessary to address these challenging situations and gain skill points. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.smiletrain.org/sites/default/files/2026-08/smile-proud-privacy_policy.pdf", "developer_terms_of_service_url": "https://www.smiletrain.org/sites/default/files/2026-08/smile-proud-terms_conditions.pdf", "publisher_name": "Smile Train", "support_website_url": null, "website_url": "https://smiletrain.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_CO", "pt_BR", "tl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28358460667081099"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974804_7443416602390036_9017832350779492661_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YHXyOtNIm8Q7kNvwH2YV7a&_nc_oc=AdpNTKsRnHZTxW9TIxkEyn8GELVexc6Mcftwdfj_w3RRR_dzU3ZV-oNn5wfVzGCxR-I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIk8CmuNBUcXAmIP3khedyUOoy0g4_OpUsAEtheX3EALQ&oe=6AA574CE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Smile Proud", "platform": "ANDROID_6DOF", "context_category": {"context_category"
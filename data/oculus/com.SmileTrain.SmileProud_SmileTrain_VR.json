0a&_nc_ohc=Kk7UrghScawQ7kNvwHkjrXz&_nc_oc=AdlgjwFs6F1iNQZ199Y3fzuWVaEHY4djelD0AWcwHwTmHRtXEMGZotO5jlR1uC7d-qU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzX0d1CLrQSy5o_oyc3G_F8o0xvn6MbPXFTxw-Pukn2oQ&oe=69AEC775"}, {"file_name": "cb_room03.png", "id": "331477753146473", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036614_331477759813139_271405501176878627_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIf93gO54uoQ7kNvwECmTA4&_nc_oc=AdnBQSPnEsvxqxNXVMqY2z0_9PhxYrom6rrUOqKGh9VyIx5ko06aMfOOt2XI3EIcrUw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBEUvCvnnE609zZ3Rey9XsiwwvlpM_65wMLBJfJ9rhiQ&oe=69AEC3BF"}, {"file_name": "eng_social_soccer.png", "id": "1275095123881093", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254875_1275095127214426_2608683143222814144_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNsPukdHUTYQ7kNvwF4xxir&_nc_oc=AdlAhEklLesJgUTCy8TuNO_QRdVioAHFCwa6sOAUHO97YMExdobODr8a4DlpFSVWWso&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9GHRpmgW16a4XjU-KA85761-KZGpf8BHgCPFEIrxRiA&oe=69AEC28C"}, {"file_name": "cafeteria_post_02.png", "id": "670108341956450", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86636486_670108345289783_7821924724203181479_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZY3xMp0bnwwQ7kNvwHRbx4F&_nc_oc=Adk28MxzloljDf_kwZvt3eSUdvGCN8bWTpZnw28pe8K5qT8NffH34ma3nPX-0VnctBU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxubMq62h3eMLW7fnSqZBrC1IIu5OD34g8g7ApC3vWyyw&oe=69AED0B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stvrcaf.PNG", "id": "1347674722606091", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031356_1347674725939424_4814664499412655823_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQ4p--K0ER4Q7kNvwE-gRGH&_nc_oc=Adm6rs8pGEFqPmx_iksQQ6edLwgKs2wA6CNQYNEa5iKUXCjXAvNoynyvSn5HX5SiKaE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyg0HX3hxdzR678HeMeg3NENvlXnErgQaR1WGYrzmXbCg&oe=69AEC15B"}, "display_name": "Smile Proud", "keywords": [], "long_description": "Smile Proud is a 2-player game aimed at providing psychosocial support to adolescents with cleft lip and/or palate. In the game, players work with their chosen Super Pet Pal, SuperCat or SuperPup, in going on missions to help others in difficult social situations. During these missions, players have the opportunity to practice addressing these situations with their psychologist, who plays with them. Players have the opportunity to learn more about how to address these situations and gain skill points along the way, while playing fun and engaging mini games. ", "short_description": "Join SuperCat or SuperPup on an adventure to help others in tricky social situations! You\u2019ll go on quests with your Super Pet Pal to help a student make friends, win a soccer trophy and help a social media star understand how to deal with cyberbullying. On your journey, you\u2019ll learn the skills necessary to address these challenging situations and gain skill points. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/13Qq1A5pVVwtP4qs9GiOn6irv1RvdzsUq/edit?usp=sharing&ouid=105529289327632046589&rtpof=true&sd=true", "developer_terms_of_service_url": "https://docs.google.com/document/d/1jArzbSbgeZEYzy4o2AC0yddLXhJywpFS/edit?usp=sharing&ouid=105529289327632046589&rtpof=true&sd=true", "publisher_name": "Smile Train", "support_website_url": null, "website_url": "https://smiletrain.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "821934236779161"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommend
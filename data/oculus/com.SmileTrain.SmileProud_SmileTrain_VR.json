luscdn.com/v/t64.5771-25/86636486_670108345289783_7821924724203181479_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfrxU3By8UYQ7kNvwFl84pa&_nc_oc=AdqMr-G2RhizHMf9LY-lzSasTtHkmzP2cknEyrwGu_KtIn9xeNTZbFDSAllUyGlrUOQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKc3IS1D-u9AmR4HgDW7KZSBjqm5dpFdj6lGp18XGoTaQ&oe=6AAA9F32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stvrcaf.PNG", "id": "1347674722606091", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031356_1347674725939424_4814664499412655823_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2zf8lO-mwcQ7kNvwGzA8pO&_nc_oc=Adq84BdKg6nfn1Xz1sYf5w2Bk_RkweALGmgDvgsfc_ox7hwhCNJb3wDB8nCz_ax5THI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYwEMiJa3v3ELFDzRx6k-7ClIUytO3ZYmxvnaAOTiybg&oe=6AAA8FDB"}, "display_name": "Smile Proud", "keywords": [], "long_description": "Smile Proud is a 2-player game aimed at providing psychosocial support to adolescents with cleft lip and/or palate. In the game, players work with their chosen Super Pet Pal, SuperCat or SuperPup, in going on missions to help others in difficult social situations. During these missions, players have the opportunity to practice addressing these situations with their psychologist, who plays with them. Players have the opportunity to learn more about how to address these situations and gain skill points along the way, while playing fun and engaging mini games. ", "short_description": "Join SuperCat or SuperPup on an adventure to help others in tricky social situations! You\u2019ll go on quests with your Super Pet Pal to help a student make friends, win a soccer trophy and help a social media star understand how to deal with cyberbullying. On your journey, you\u2019ll learn the skills necessary to address these challenging situations and gain skill points. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/13Qq1A5pVVwtP4qs9GiOn6irv1RvdzsUq/e
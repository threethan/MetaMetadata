0a&_nc_ohc=Iz6Yctqn8fgQ7kNvwH9N3xq&_nc_oc=AdmB3DvQHHfA4TbEGOxEvVIW_jI7XxxG9cJ1k0YKpcuUC8YdZ_qtaIR-41POpaovM3k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw1_DF-GS7-fYRwOLO66PBu6GBXSLtullFPLSnkTvgRmA&oe=69B95375"}, {"file_name": "cb_room03.png", "id": "331477753146473", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036614_331477759813139_271405501176878627_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nI2266P0Ly8Q7kNvwEjINVO&_nc_oc=AdlE4CoEvHykc5flaWITTE4Ii6ZjInkwmQpNSgJFhqcWQw67weU2EqDSNBTyRSi5aU4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyTGEs6py-Z3OtmKOJUDKB54Z4R0CzIeZey56Q_M-HdZg&oe=69B94FBF"}, {"file_name": "eng_social_soccer.png", "id": "1275095123881093", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75254875_1275095127214426_2608683143222814144_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2xlrd7mXDsQ7kNvwG4gYZI&_nc_oc=AdkZ_4bFBx3FsGlQ4NV1BGe3Wn2wJ_zSuu2bbLhoGU3upnsRgIEXRM125fh7peUxL4A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwgZGv0az4JBEd2i2IHcS7FGGSsPPEqfsVqh-AI5-kiFg&oe=69B94E8C"}, {"file_name": "cafeteria_post_02.png", "id": "670108341956450", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86636486_670108345289783_7821924724203181479_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbAsMSZ53_kQ7kNvwFWmtvz&_nc_oc=AdkeOA_cX5TUmpn0arpF-wdghTlqvJR5WM-1sATw8o_eiRq0bkZ6sRsk6jyKGlD2_6k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxvtApx4zeiGbIVayVrFM0FrT7Y0kfYYPAfClfM0Ftukg&oe=69B95CB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stvrcaf.PNG", "id": "1347674722606091", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031356_1347674725939424_4814664499412655823_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0pB5w0FK2gQ7kNvwEdjn6f&_nc_oc=Adk5zvXcwvvdGU4L5-bEYfM40neCooieqNwOVNVFUhvltPwIc5AgYypXb3Xw0CtS43M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzQA7jrkGe2S3vi7htGwry4LnCRnBAc_vzYYwtcR-PWkA&oe=69B94D5B"}, "display_name": "Smile Proud", "keywords": [], "long_description": "Smile Proud is a 2-player game aimed at providing psychosocial support to adolescents with cleft lip and/or palate. In the game, players work with their chosen Super Pet Pal, SuperCat or SuperPup, in going on missions to help others in difficult social situations. During these missions, players have the opportunity to practice addressing these situations with their psychologist, who plays with them. Players have the opportunity to learn more about how to address these situations and gain skill points along the way, while playing fun and engaging mini games. ", "short_description": "Join SuperCat or SuperPup on an adventure to help others in tricky social situations! You\u2019ll go on quests with your Super Pet Pal to help a student make friends, win a soccer trophy and help a social media star understand how to deal with cyberbullying. On your journey, you\u2019ll learn the skills necessary to address these challenging situations and gain skill points. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/13Qq1A5pVVwtP4qs9GiOn6irv1RvdzsUq/edit?usp=sharing&ouid=105529289327632046589&rtpof=true&sd=true", "developer_terms_of_service_url": "https://docs.google.com/document/d/1jArzbSbgeZEYzy4o2AC0yddLXhJywpFS/edit?usp=sharing&ouid=105529289327632046589&rtpof=true&sd=true", "publisher_name": "Smile Train", "support_website_url": null, "website_url": "https://smiletrain.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "821934236779161"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommend
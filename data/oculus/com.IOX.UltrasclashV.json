.5771-25/39031600_1097588267481539_1441771463292176882_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kF7VMsoCy3wQ7kNvwFyw5P7&_nc_oc=AdktG63XzT_yXeNm42AHRmC_MWMgJAa4OaCqcDY_QEsT88X0XbRORfRlUQNdnM1vVRQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuuLyrYfKmz_ljoqylZwCAcBHTCqI_H-a-_EWUXYad0gg&oe=69A4273E"}, {"file_name": "screenshot-bully2 (1).png", "id": "3109815769292844", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982563_3109815772626177_6284524619823654227_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8Y9h-l-b98Q7kNvwGh0NEd&_nc_oc=Adm2WxEztxdn5U49ZGe2obL2SDlr6QpFIw_7Eotgs9Oj6s-5FdzSXeM469SX6BSVjd0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuZyWfayTqz3qVLYgOkf7voB4mUjkKX2eaT2C4CimKuxA&oe=69A42B1A"}, {"file_name": "screenshot-bully3.png", "id": "732978577649854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982492_732978580983187_8954213730478558859_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyY6MpPwJuYQ7kNvwFMpiFa&_nc_oc=Adk5dYA6ZTUUZ1TU7WKHt2ItMsJSGnftXttzHzdCfVxHoPZyoSuebeEJ7F8Zil6GFwU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvsbhs6oddpfXasa22t3HDqCI_5Dz7Jv-kyUMmmLxF4bA&oe=69A43944"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultrasclash V", "keywords": [], "long_description": "Ultrasclash V is a unique blend of three of the most beloved gaming concepts: anime, fighting, and sandbox approach. Combined, they create a fast paced, high octane virtual reality experience, in which you fight hordes of hostile cacti-men in a desperate, yet unmistakably hilarious, fight for survival.\n\nFEATURES\n\nPunch Movement System: we created a VR locomotion system which allows you to roam the map using your fists, punching in the direction you choose to move to!\n\nCrazy Bullet Time fights: just like in The Matrix, freeze time to gain a tactical advantage and defeat your opponents.\n\nPhysical engine: we bring you accurate physics feedbacks in addition to badass sounds and enemies, all reacting realistically to your punches.\n\nAwesome cartoonish stylized graphics!!!", "short_description": "Ultras Fighter is a sandbox anime fighting game, designed and primed to bring you a unique and creative approach to being a hero, just like in your favourite anime!"}]}, "developer_name": "IOX S.r.l.", "developer_privacy_policy_url": "https://www.ultrasclash.com/3009-2/", "developer_terms_of_service_url": "https://www.ultrasclash.com/terms-of-service/", "publisher_name": "IOX S.r.l.", "support_website_url": null, "website_url": "https://www.ultrasclash.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "ACTION", "DINOSAURS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "264141875928065"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6210228325692446", "version": "0.5"}, "id": "283137273644547", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4313636265351671", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "
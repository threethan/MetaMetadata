content-ams2-1.oculuscdn.com&oh=00_AfshK0ugtvzzsXTd4R1T2Tm_9SoGZJ87Tm_hYUjEmsWsaA&oe=699EFD82"}, {"file_name": "5.png", "id": "2404697546328669", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572936_2404697549662002_6744001405025737672_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dA_Bl6KdzdcQ7kNvwGAUxtB&_nc_oc=Adn9zogE5GajDGS2YrV4SJZ8_t4_Di8lMZbEE5D-MVhu7Hem0zmiYIpRF_6z3hqwoLg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuHl8rVUydXJeqxX8z_-55XeN0Rp-qqW6iAUnJIPxsHIQ&oe=699EEEB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "578040073613401", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001713_578040076946734_8153214829952110504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKavw1_6rh8Q7kNvwGBmN39&_nc_oc=AdlW4d1Q0kN39uIwP6PsBilSg46nZ9QSWR4ts4QRNXQbDt1hGBHWa-QlrD9XdREkHew&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvzL3ypLaRCHuBpNjzKPL4e0Qv1aUppSYwENcs6whGDww&oe=699EF74E"}, "display_name": "First Person Tennis - The Real Tennis Simulator", "keywords": [], "long_description": "First Person Tennis is the first tennis simulator developed for VR.\n\nNow, you can play on a real tennis court and face professional tennis players. \nYou'll have to show all your technical and tactical skills.\n\nVR Controls:\nHold the controller/racket and play tennis.\n\nFeatures: \n- Arcade and Simulation mode.\n- Online Multiplayer.\n- 3 different ways to run through the court: Teleport, Run in Place, Sliding Run.\n- One handed serve.\n- 7 different court surfaces: clay, grass, hard, blue-green hard, classic synthetic, indoor hard and indoor synthetic; each with a specific rebound. \n- 13 tournaments: 4 Slam and 9 Masters. \n- Full ranking system. \n- Fully customizable 3D male player. ", "short_description": "First Person Tennis is the first tennis simulator developed for VR. Now, you can play on a real tennis court and face professional tennis players. You'll have to show all your technical 
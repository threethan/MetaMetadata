946129", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031326_847240709279462_9081410908319983688_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5aQ0OoQJKwQ7kNvwE9JQxX&_nc_oc=AdkST9Uluist6nnMILKKRsNpMFsGMqpzdco-xLtVTeAzO9SEf_Z9F1kkc4F4upSvk_Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfycHclK4p12EdRZZlvBJTIRvF9Gu88ogYLhcyZ6QA1D9Q&oe=69B2C402"}, {"file_name": "5.png", "id": "2404697546328669", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572936_2404697549662002_6744001405025737672_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5A968sOhOoQ7kNvwEV1HPK&_nc_oc=Adl-rPwFQ3wqMw_WBP7Ej7QLT2daC52afUo4QNPb_rDMy5zwSbA2_LJuhLmZBn78w6w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQOHdM8KUoBR3HlSH92HPV_hrf9K5o-eRZXlEwkj7CYA&oe=69B2B533"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "578040073613401", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001713_578040076946734_8153214829952110504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uY-WelcVHUQ7kNvwFPe5sT&_nc_oc=AdkWlulGoHi0FRGQHcoaNwfCXsHejFww-IJ0Ch43S5CPx7CH7Zp-LDbVdVXepLDgphs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxnprR6UMpfbq_mmldtYITiuXIQpEnaoNHu_htJ985Vog&oe=69B2BDCE"}, "display_name": "First Person Tennis - The Real Tennis Simulator", "keywords": [], "long_description": "First Person Tennis is the first tennis simulator developed for VR.\n\nNow, you can play on a real tennis court and face professional tennis players. \nYou'll have to show all your technical and tactical skills.\n\nVR Controls:\nHold the controller/racket and play tennis.\n\nFeatures: \n- Arcade and Simulation mode.\n- Online Multiplayer.\n- 3 different ways to run through the court: Teleport, Run in Place, Sliding Run.\n- One handed serve.\n- 7 different court surfaces: clay, grass, hard, blue-green hard, classic synthetic, indoor hard and indoor synthetic; each with a specific rebound. \n- 13 tournaments: 4 Slam and 9 Masters. \n- Full ranking system. \n- Fully customizable 3D male player. ", "short_description": "First Person Tennis is the first tennis simulator developed for VR. Now, you can play on a real tennis court and face professional tennis players. You'll have to show all your technical and tactical skills."}]}, "developer_name": "Mikori Games", "developer_privacy_policy_url": "https://sites.google.com/view/fptprivacypolicy/home-page", "developer_terms_of_service_url": "https://www.facebook.com/MikoriGames/", "publisher_name": "Mikori Games", "support_website_url": null, "website_url": "https://www.facebook.com/Firstpersontennis", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ru", "en", "pt_BR", "it", "fr", "es", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "3168313566780415"}}]}, "scheduled_offers": {"count": 52, "nodes": [{"status": "PUBLISHED", "id": "1798531220841296"}, {"status": "PUBLISHED", "id": "1583593212565906"}, {"status": "PUBLISHED", "id": "1171396568538880"}, {"status": "PUBLISHED", "id": "850546804281303"}, {"status": "PUBLISHED", "id": "1157933899076915"}, {"status": "PUBLISHED", "id": "1510998640352850"}, {"status": "PUBLISHED", "id": "725961420063372"}, {"status": "PUBLISHED", "id": "2790359397822942"}, {"status": "PUBLISHED", "id": "1730172574377487"}, {"status": "PUBLISHED", "
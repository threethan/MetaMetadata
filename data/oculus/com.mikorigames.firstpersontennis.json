mqircc6gdEWAxfAtBofpUMdOab17FgS_7y5uDHP2_SzMPrOqbG7jHtBxY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Zbb_t5xd7CO69qQvKH8dIfua_YZ8SaoHypm8BEBkFwQ&oe=6A36C522"}, {"file_name": "4.png", "id": "847240705946129", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031326_847240709279462_9081410908319983688_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTE29HDK3X8Q7kNvwEjVR5U&_nc_oc=AdqQ6_Vg6M91O-yOTZPxO3mToSlw_ycCdGbuPtXYD2UKfB_ZDKNVzHQctQNEwP2paoI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83y9KIDo1HxGYqmRjsY_AgSXu1FzOu_jvg_0OfnGTQ3Q&oe=6A369A02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2180848762417510", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473391808_2180848769084176_409298743687545579_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RbZhaXG1Mv0Q7kNvwFFo6R9&_nc_oc=AdpQv6nv9i7au-3HtjMaMsyd_QtXDUY1akZfYMDRep0MkDSq16iZvrydjhhQ11pRdKY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8a6ZkzV-6POTdHowRiFabEYtPyS6ELcK2zA639ovXPnA&oe=6A3691C0"}, "display_name": "First Person Tennis - The Real Tennis Simulator", "keywords": ["tennis", "padel", "pickleball", "badminton", "pong"], "long_description": "Welcome to the **First Person Tennis**, the first tennis simulator developed for VR.\n\nFirst Person Tennis uses the most innovative physics engine to reproduce the real tennis shots in VR. Thanks to the support of a big community and professional tennis players, the game is in an endless development to reach an incredible level of realism.  \n\nFirst Person Tennis can be played by both tennis players and non-players, the simulator has different levels of difficulty and options for any need.\n\nJoin First Person Tennis Discord to find friends, opponents and play online tournaments every months with big prizes.\nhttps://discord.gg/9rtH7VuwSd\n\nFeatures: \n- Single and Doubles matches.\n- Arcade and Simulation mode.\n- Online Multiplayer.\n- Mixed Reality.\n- 3 different ways to run through the court: Teleport, Run in Place, Sliding Run.\n- One handed serve.\n- 7 different court surfaces: clay, grass, hard, blue-green hard, classic synthetic, indoor hard and indoor synthetic.\n- 13 tournaments: 4 Slam and 9 Masters. \n- Global Leaderboard. \n- Fully customizable 3D characters.\n   {554950153827856}", "short_description": "Welcome to the First Person Tennis, the first tennis simulator developed for VR.\n\nFirst Person Tennis uses the most innovative physics engine to reproduce the real tennis shots in VR. Thanks to the support of a big community and professional tennis players, the game is in an endless development to reach an incredible level of realism.  \n\nFirst Person Tennis can be played by both tennis players and non-players, the simulator has different levels of difficulty and options for any need."}]}, "developer_name": "Mikori Games", "developer_privacy_policy_url": "https://sites.google.com/view/fptprivacypolicy/home-page", "developer_terms_of_service_url": null, "publisher_name": "Mikori Games", "support_website_url": "https://discord.gg/first-person-tennis-the-real-tennis-simulator-442706345460891659", "website_url": "https://mikorigames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ru", "en", "pt_BR", "it", "fr", "es", "ja", "zh_CN", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "support
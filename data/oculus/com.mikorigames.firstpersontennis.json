content-hkg1-2.oculuscdn.com&oh=00_AfuXrE1gy96dz6Kc4JdwSBLGoA8AzYWRQKbY14t-l6NaPA&oe=69A1A082"}, {"file_name": "5.png", "id": "2404697546328669", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/57572936_2404697549662002_6744001405025737672_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCae9GxkBJEQ7kNvwFu6S0U&_nc_oc=AdmqrFEd2wImcEnLiD19U2rCG5m858xnoeX6MkRXIeby33iWdM0TDagidqZuppZUhRg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfseJ5C1u4dzjj8-GTkevAdidge9zDWbkOqh4bRUBcoQnQ&oe=69A191B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "578040073613401", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39001713_578040076946734_8153214829952110504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKavw1_6rh8Q7kNvwFpqk-Q&_nc_oc=Adm7RrzCKDH_IQMLEz1pmfi3XiM1lMTV8W0ys-lQARLlI1RR26Sg5LJLmJmXRiS9pKk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afu6boOslgTj0TQIRTaKKGESDpgO8FZUy_AIp_5xhvsA6g&oe=69A19A4E"}, "display_name": "First Person Tennis - The Real Tennis Simulator", "keywords": [], "long_description": "First Person Tennis is the first tennis simulator developed for VR.\n\nNow, you can play on a real tennis court and face professional tennis players. \nYou'll have to show all your technical and tactical skills.\n\nVR Controls:\nHold the controller/racket and play tennis.\n\nFeatures: \n- Arcade and Simulation mode.\n- Online Multiplayer.\n- 3 different ways to run through the court: Teleport, Run in Place, Sliding Run.\n- One handed serve.\n- 7 different court surfaces: clay, grass, hard, blue-green hard, classic synthetic, indoor hard and indoor synthetic; each with a specific rebound. \n- 13 tournaments: 4 Slam and 9 Masters. \n- Full ranking system. \n- Fully customizable 3D male player. ", "short_description": "First Person Tennis is the first tennis simulator developed for VR. Now, you can play on a real tennis court and face professional tennis players. You'll have to show all your technical 
content-iad3-1.oculuscdn.com&oh=00_Aft9eDjwwp51EEraFuJun1F3WhwWOH6HBxkX2_kX1RwGbw&oe=69A2F202"}, {"file_name": "5.png", "id": "2404697546328669", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572936_2404697549662002_6744001405025737672_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCae9GxkBJEQ7kNvwETFo-O&_nc_oc=AdkX1K9Iir_9r8kAv3qx7UTcZ7UrrCDjWBXXG6XzB3m3Q0KpBumaDHlKgLpmWF3Ooio&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu40iRjkmmZMps1Ep3JaNipG7xZL5gq0ZxJZ1Ui1aBLSw&oe=69A2E333"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "578040073613401", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001713_578040076946734_8153214829952110504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSmQZiLUVcoQ7kNvwFnwgXN&_nc_oc=AdnhbNThGUyhaAbXN0AIv09q0bbJDPWfvshGmEeiAWIsPh61NbMxdD-j8JzBFd6TedI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvrhcZsbMzyskU_-7QfaeRbNba8qcu0vHShmWmssmMBXA&oe=69A2EBCE"}, "display_name": "First Person Tennis - The Real Tennis Simulator", "keywords": [], "long_description": "First Person Tennis is the first tennis simulator developed for VR.\n\nNow, you can play on a real tennis court and face professional tennis players. \nYou'll have to show all your technical and tactical skills.\n\nVR Controls:\nHold the controller/racket and play tennis.\n\nFeatures: \n- Arcade and Simulation mode.\n- Online Multiplayer.\n- 3 different ways to run through the court: Teleport, Run in Place, Sliding Run.\n- One handed serve.\n- 7 different court surfaces: clay, grass, hard, blue-green hard, classic synthetic, indoor hard and indoor synthetic; each with a specific rebound. \n- 13 tournaments: 4 Slam and 9 Masters. \n- Full ranking system. \n- Fully customizable 3D male player. ", "short_description": "First Person Tennis is the first tennis simulator developed for VR. Now, you can play on a real tennis court and face professional tennis players. You'll have to show all your technical 
946129", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031326_847240709279462_9081410908319983688_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLUxWRsQ7DsQ7kNvwFD05ga&_nc_oc=Adk4FErYdiletrk_uptzipr8oG-ZfWUBleCHlWoZyhxEhfSdU9rWsT25dplyEizPDTY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGn7xDSpkZs73EmzUYOQEg505txvmNTQ2qVxHowvGKYg&oe=69BEA182"}, {"file_name": "5.png", "id": "2404697546328669", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572936_2404697549662002_6744001405025737672_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMFmpZFuRGEQ7kNvwF2HwbK&_nc_oc=AdnZOLe6xI89JpQ_3GV3_FE0GG-7POnQH_e5HKOD7eyn5SFLVnPCulB1RGnL6uXKvjk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwc3ic8Xqf3EK23xQ0MGYVbUHeNK5IXlSgXQS274c8Ycg&oe=69BE92B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "578040073613401", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001713_578040076946734_8153214829952110504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdkd8rpEefIQ7kNvwEPPeN8&_nc_oc=AdmDb6Bim32jbIBZmV9TNqzvld_AWdtfvLyjep2KhFWN3-LUTsvmTpHF7O1ZMdE-_8M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzlMZLsoRmeFDNmqGLyBEtDViwV5HWhvNPPwUlaSL0SdQ&oe=69BE9B4E"}, "display_name": "First Person Tennis - The Real Tennis Simulator", "keywords": [], "long_description": "First Person Tennis is the first tennis simulator developed for VR.\n\nNow, you can play on a real tennis court and face professional tennis players. \nYou'll have to show all your technical and tactical skills.\n\nVR Controls:\nHold the controller/racket and play tennis.\n\nFeatures: \n- Arcade and Simulation mode.\n- Online Multiplayer.\n- 3 different ways to run through the court: Teleport, Run in Place, Sliding Run.\n- One handed serve.\n- 7 different court surfaces: clay, grass, hard, blue-green hard, classic synthetic, indoor hard and indoor synthetic; each with a specific rebound. \n- 13 tournaments: 4 Slam and 9 Masters. \n- Full ranking system. \n- Fully customizable 3D male player. ", "short_description": "First Person Tennis is the first tennis simulator developed for VR. Now, you can play on a real tennis court and face professional tennis players. You'll have to show all your technical and tactical skills."}]}, "developer_name": "Mikori Games", "developer_privacy_policy_url": "https://sites.google.com/view/fptprivacypolicy/home-page", "developer_terms_of_service_url": "https://www.facebook.com/MikoriGames/", "publisher_name": "Mikori Games", "support_website_url": null, "website_url": "https://www.facebook.com/Firstpersontennis", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ru", "en", "pt_BR", "it", "fr", "es", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "3168313566780415"}}]}, "scheduled_offers": {"count": 52, "nodes": [{"status": "PUBLISHED", "id": "1798531220841296"}, {"status": "PUBLISHED", "id": "1583593212565906"}, {"status": "PUBLISHED", "id": "1171396568538880"}, {"status": "PUBLISHED", "id": "850546804281303"}, {"status": "PUBLISHED", "id": "1157933899076915"}, {"status": "PUBLISHED", "id": "1510998640352850"}, {"status": "PUBLISHED", "id": "725961420063372"}, {"status": "PUBLISHED", "id": "2790359397822942"}, {"status": "PUBLISHED", "id": "1730172574377487"}, {"status": "PUBLISHED", "
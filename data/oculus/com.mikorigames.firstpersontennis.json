content-iad3-1.oculuscdn.com&oh=00_AftL3JkLnghTKw5JYbKTKr0MR_JEVa86RDb5EVoPlT0s-A&oe=699DAC02"}, {"file_name": "5.png", "id": "2404697546328669", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572936_2404697549662002_6744001405025737672_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dA_Bl6KdzdcQ7kNvwF_tDPU&_nc_oc=AdnZgHdJbRFraDeYIOGx4Dz1Abn6WcUVjmfKitZWDS1PU15-8ybHuxSNrlc4H6NKvJY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu7k5PA3MGvDKi32tH51O_qORA4yMfZEE_jzNyzgz24yw&oe=699D9D33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "578040073613401", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001713_578040076946734_8153214829952110504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEcBQ6zKVc8Q7kNvwHqxBDc&_nc_oc=Adkc2Zp-whRA71eZuivzqOUV56VdrHojIczaf6zshM0v6aVhpRCqmtXMND32YbcoHSs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuSG6cwbinotqZGPP9hBkmFX2Xe0kMTLDepbCNIS27MaQ&oe=699DA5CE"}, "display_name": "First Person Tennis - The Real Tennis Simulator", "keywords": [], "long_description": "First Person Tennis is the first tennis simulator developed for VR.\n\nNow, you can play on a real tennis court and face professional tennis players. \nYou'll have to show all your technical and tactical skills.\n\nVR Controls:\nHold the controller/racket and play tennis.\n\nFeatures: \n- Arcade and Simulation mode.\n- Online Multiplayer.\n- 3 different ways to run through the court: Teleport, Run in Place, Sliding Run.\n- One handed serve.\n- 7 different court surfaces: clay, grass, hard, blue-green hard, classic synthetic, indoor hard and indoor synthetic; each with a specific rebound. \n- 13 tournaments: 4 Slam and 9 Masters. \n- Full ranking system. \n- Fully customizable 3D male player. ", "short_description": "First Person Tennis is the first tennis simulator developed for VR. Now, you can play on a real tennis court and face professional tennis players. You'll have to show all your technical 
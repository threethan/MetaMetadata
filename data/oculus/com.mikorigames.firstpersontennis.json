content-ord5-3.oculuscdn.com&oh=00_AfuuBHProd42vzDtLpNfm-3HOvA6sO0RC8R-1IcbOwNSyg&oe=699B0902"}, {"file_name": "5.png", "id": "2404697546328669", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572936_2404697549662002_6744001405025737672_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bh1uITmkpDkQ7kNvwFs8oOu&_nc_oc=AdliKrqVnY_DA2Q6D-WePwRv3bsYaq7di0j__WEu55aAg_v0H7hkOkTyGNEj_z_8XPE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuFX8vPh0Y9M3pIKBldwgGjXWCQxdE8j46dCAgi4HJ4ug&oe=699AFA33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "578040073613401", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001713_578040076946734_8153214829952110504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEcBQ6zKVc8Q7kNvwE0gBax&_nc_oc=AdmB6N3iO6xfHlkVipiPIampX0raynKDvG-uONqPC85pOT8nlzZYEWkpBViHct9_jjc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft6mE7EJa8Pjb5VtTy2rNaynppPxxF7HNPZLFoy9bhJrg&oe=699B02CE"}, "display_name": "First Person Tennis - The Real Tennis Simulator", "keywords": [], "long_description": "First Person Tennis is the first tennis simulator developed for VR.\n\nNow, you can play on a real tennis court and face professional tennis players. \nYou'll have to show all your technical and tactical skills.\n\nVR Controls:\nHold the controller/racket and play tennis.\n\nFeatures: \n- Arcade and Simulation mode.\n- Online Multiplayer.\n- 3 different ways to run through the court: Teleport, Run in Place, Sliding Run.\n- One handed serve.\n- 7 different court surfaces: clay, grass, hard, blue-green hard, classic synthetic, indoor hard and indoor synthetic; each with a specific rebound. \n- 13 tournaments: 4 Slam and 9 Masters. \n- Full ranking system. \n- Fully customizable 3D male player. ", "short_description": "First Person Tennis is the first tennis simulator developed for VR. Now, you can play on a real tennis court and face professional tennis players. You'll have to show all your technical 
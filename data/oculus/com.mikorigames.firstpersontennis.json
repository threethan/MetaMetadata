CO3mnadynwxN_XZtvCSLxgCayzNjsT-p3oB8TG-6f6PutSGI4l9HYGbTHxg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXWlXSUDsw0Sk1NaQnXMkSmwxIAV4yL7TqXQnxdd5jvOg&oe=6B10562B"}, {"file_name": "3.png", "id": "379064010595825", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031440_379064013929158_562566670393182718_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCIlH0T1NqoQ7kNvwGRiCO7&_nc_oc=AdouO5P2bwS6ku3ZEVtDAgC2k_U0dRCXs6HBf584W2xpK6lJ7aBPBaovUBv9ZaSRMRM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVEkt2KspoUE4NnN_2_mGeE1nJlT54BD0iDso-HnKbWTA&oe=6B104CA2"}, {"file_name": "4.png", "id": "847240705946129", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031326_847240709279462_9081410908319983688_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZAdRFysopkQ7kNvwEd8v1E&_nc_oc=Adqitbx8sSXGfNjeZqaFmRQ4SnpXl3JdFgRtxTCdEvWrozU7-H3UvLYrtJUANS6XYT8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVTPlBwisuzn_ndOjFXlY2CkusXAH6b-3uV83bD4VWeew&oe=6B1059C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2180848762417510", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391808_2180848769084176_409298743687545579_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWAfHYkJ7d0Q7kNvwE72pSu&_nc_oc=AdrkpcELVRHSLjGezYBRbiceRc9FjszY5YU1HwoXVc8NcZ495xXEUig7_GHP1hXP968&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUHKsa9whBnT12CwwtZQ8ps4wU07NX_veG5MxoVBx6V1A&oe=6B105180"}, "display_name": "First Person Tennis - The Real Tennis Simulator", "keywords": ["tennis", "padel", "pickleball", "badminton", "pong"], "long_description": "Welcome to the **First Person Tennis**, the first tennis simulator developed for VR.\n\nFirst Person Tennis uses the most innovative physics engine to reproduce the real tennis shots in VR. Thanks to the support of a big community and professional tennis players, the game is in an endless development to reach an incredible level of realism.  \n\nFirst Person Tennis can be played by both tennis players and non-players, the simulator has different levels of difficulty and options for any need.\n\nJoin First Person Tennis Discord to find friends, opponents and play online tournaments every months with big prizes.\nhttps://discord.gg/9rtH7VuwSd\n\nFeatures: \n- Single and Doubles matches.\n- Arcade and Simulation mode.\n- Online Multiplayer.\n- Mixed Reality.\n- 3 different ways to run through the court: Teleport, Run in Place, Sliding Run.\n- One handed serve.\n- 7 different court surfaces: clay, grass, hard, blue-green hard, classic synthetic, indoor hard and indoor synthetic.\n- 13 tournaments: 4 Slam and 9 Masters. \n- Global Leaderboard. \n- Fully customizable 3D characters.\n   {554950153827856}", "short_description": "Welcome to the First Person Tennis, the first tennis simulator developed for VR.\n\nFirst Person Tennis uses the most innovative physics engine to reproduce the real tennis shots in VR. Thanks to the support of a big community and professional tennis players, the game is in an endless development to reach an incredible level of realism.  \n\nFirst Person Tennis can be played by both tennis players and non-players, the simulator has different levels of difficulty and options for any need."}]}, "developer_name": "Mikori Games", "developer_privacy_policy_url": "https://sites.google.com/view/fptprivacypolicy/home-page", "developer_terms_of_service_url": null, "publisher_name": "Mikori Games", "support_website_url": "https://discord.gg/first-person-tennis-the-real-tennis-simulator-442706345460891659", "website_url": "https://mikorigames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1023770785722696"}, {"id": "33
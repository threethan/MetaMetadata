1410908319983688_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WN1-iaL4et8Q7kNvwGQ8FJw&_nc_oc=AdqPPJh7xiugJ9rBhHDWlPQKEto32EkfgHyGuTjUMl6XOVjiN2L4NOhcZ5h_h3r61N8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1QmYbnyCh7ouEW8dU-iPamkRk5iphBwp39mX2fviGuKA&oe=69F20C02"}, {"file_name": "5.png", "id": "2404697546328669", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572936_2404697549662002_6744001405025737672_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUtwIwFqhcwQ7kNvwHwTDvT&_nc_oc=AdqNJmIRcaStV1ToT5mUtFjZeoQ5pexuHVPKTIoOG8x7Dsw8u2rRrfqG9xbq_FfepMA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0JL9cXLFr4lyMsw6KMOJQgBD7PMWnCrfbngB-R4mHtfw&oe=69F1FD33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "578040073613401", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001713_578040076946734_8153214829952110504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqzYo1gP45cQ7kNvwGdT7gI&_nc_oc=Ado0q9ZXo-AIKyxRSbWGbXzOhQ_rTWvbxSWebh__pd8jS75j_b_6kDlBBNvwhhMmzkI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af22foq4U_mtNpbO_YD1rVpK-qpAx2GwoI4Ow4klFiWwOA&oe=69F205CE"}, "display_name": "First Person Tennis - The Real Tennis Simulator", "keywords": [], "long_description": "First Person Tennis is the first tennis simulator developed for VR.\n\nNow, you can play on a real tennis court and face professional tennis players. \nYou'll have to show all your technical and tactical skills.\n\nVR Controls:\nHold the controller/racket and play tennis.\n\nFeatures: \n- Arcade and Simulation mode.\n- Online Multiplayer.\n- 3 different ways to run through the court: Teleport, Run in Place, Sliding Run.\n- One handed serve.\n- 7 different court surfaces: clay, grass, hard, blue-green hard, classic synthetic, indoor hard and indoor synthetic; each with a specific rebound. \n- 13 tournaments: 4 Slam and 9 Masters. \n- Full ranking system. \n- Fully customizable 3D male player. ", "short_descri
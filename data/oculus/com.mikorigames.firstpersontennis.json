content-sjc6-1.oculuscdn.com&oh=00_Afups6kSzE2f-Yiugq51bo6lT6p0LoC-whmE2HUO2Bv5JQ&oe=69986602"}, {"file_name": "5.png", "id": "2404697546328669", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572936_2404697549662002_6744001405025737672_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bh1uITmkpDkQ7kNvwFtg_YF&_nc_oc=Adnak6-JrgD80q8UJaI_AT_Yurct14hTRPWF9JR_JYx3UcckQZ-51npfY8yFGDle_js&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aftb6QsNkDZKnoNVMAc88Di2UAET8NMfCwGOBx-CZd3q6Q&oe=69985733"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "578040073613401", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001713_578040076946734_8153214829952110504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IYr6M8epCYQ7kNvwFApjN5&_nc_oc=Admj0RMrCxFI4UgJYZ9usaFAJ5i3Tz81E2JGaNmOPHFgtGc9D5qlhxm-H0N1hK1kAMU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfucsW-2N3xgbrLpk5aZGhp69Wfocqqtx1c5fcB6rSggig&oe=69985FCE"}, "display_name": "First Person Tennis - The Real Tennis Simulator", "keywords": [], "long_description": "First Person Tennis is the first tennis simulator developed for VR.\n\nNow, you can play on a real tennis court and face professional tennis players. \nYou'll have to show all your technical and tactical skills.\n\nVR Controls:\nHold the controller/racket and play tennis.\n\nFeatures: \n- Arcade and Simulation mode.\n- Online Multiplayer.\n- 3 different ways to run through the court: Teleport, Run in Place, Sliding Run.\n- One handed serve.\n- 7 different court surfaces: clay, grass, hard, blue-green hard, classic synthetic, indoor hard and indoor synthetic; each with a specific rebound. \n- 13 tournaments: 4 Slam and 9 Masters. \n- Full ranking system. \n- Fully customizable 3D male player. ", "short_description": "First Person Tennis is the first tennis simulator developed for VR. Now, you can play on a real tennis court and face professional tennis players. You'll have to show all your technical 
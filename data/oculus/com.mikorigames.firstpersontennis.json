946129", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031326_847240709279462_9081410908319983688_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wr4T2gKnFQcQ7kNvwHFJ9BQ&_nc_oc=AdnU84xbsqAQanPMJXyPk8rE1ZPO4SrDnVgD5L8fMwXCqOlfxmWHbKSo8YXtmyxUjc8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyIwwsVtZa2NtqdSd4sisGL1v-wLkKkbH8uppVPyBJa0g&oe=69BAAD02"}, {"file_name": "5.png", "id": "2404697546328669", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572936_2404697549662002_6744001405025737672_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hi5JHqd5y9EQ7kNvwGyp3Fm&_nc_oc=Adlc41-R5AIF44WvPryOSdTLakFNSEV17DGzM3zjORXav3Ynznpav1N9hC6XYxq_s3Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzXZILyveFBg5ocLiuXdGYRToaFhCHo8WSicyUj2db7Vw&oe=69BA9E33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "578040073613401", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001713_578040076946734_8153214829952110504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsSln1EREfEQ7kNvwF2yyVW&_nc_oc=AdkDIiGXPfQ9p0fnLGsn5Y8oSgx0n3GRZSejWDQVK9C4xFFx7CnXjrpP8pzg4zFMLps&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwlTaadrMCSJrPvASBlLimBaV_lPPiVusBDtgAQI9bkOQ&oe=69BAA6CE"}, "display_name": "First Person Tennis - The Real Tennis Simulator", "keywords": [], "long_description": "First Person Tennis is the first tennis simulator developed for VR.\n\nNow, you can play on a real tennis court and face professional tennis players. \nYou'll have to show all your technical and tactical skills.\n\nVR Controls:\nHold the controller/racket and play tennis.\n\nFeatures: \n- Arcade and Simulation mode.\n- Online Multiplayer.\n- 3 different ways to run through the court: Teleport, Run in Place, Sliding Run.\n- One handed serve.\n- 7 different court surfaces: clay, grass, hard, blue-green hard, classic synthetic, indoor hard and indoor synthetic; each with a specific rebound. \n- 13 tournaments: 4 Slam and 9 Masters. \n- Full ranking system. \n- Fully customizable 3D male player. ", "short_description": "First Person Tennis is the first tennis simulator developed for VR. Now, you can play on a real tennis court and face professional tennis players. You'll have to show all your technical and tactical skills."}]}, "developer_name": "Mikori Games", "developer_privacy_policy_url": "https://sites.google.com/view/fptprivacypolicy/home-page", "developer_terms_of_service_url": "https://www.facebook.com/MikoriGames/", "publisher_name": "Mikori Games", "support_website_url": null, "website_url": "https://www.facebook.com/Firstpersontennis", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ru", "en", "pt_BR", "it", "fr", "es", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "3168313566780415"}}]}, "scheduled_offers": {"count": 52, "nodes": [{"status": "PUBLISHED", "id": "1798531220841296"}, {"status": "PUBLISHED", "id": "1583593212565906"}, {"status": "PUBLISHED", "id": "1171396568538880"}, {"status": "PUBLISHED", "id": "850546804281303"}, {"status": "PUBLISHED", "id": "1157933899076915"}, {"status": "PUBLISHED", "id": "1510998640352850"}, {"status": "PUBLISHED", "id": "725961420063372"}, {"status": "PUBLISHED", "id": "2790359397822942"}, {"status": "PUBLISHED", "id": "1730172574377487"}, {"status": "PUBLISHED", "
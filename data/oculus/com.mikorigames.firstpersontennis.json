content-atl3-3.oculuscdn.com&oh=00_AfseNQcSQN6CxGkRHGp_7Ke-o2JXtYyRsxxwxMuwdYPneQ&oe=69A59502"}, {"file_name": "5.png", "id": "2404697546328669", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572936_2404697549662002_6744001405025737672_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4SmXF-YYncQ7kNvwG5MY5u&_nc_oc=Adkkb2e7xSoXiS6NdYD8MigU-jByRBWs6WyJLCjP6txniv5Uk24Fr4UUjIa2IF6h3rE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs9onThiGlo4_G5-jsAZn6bWpaEn-VyxcZkN3owgh4Rug&oe=69A58633"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "578040073613401", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001713_578040076946734_8153214829952110504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSmQZiLUVcoQ7kNvwH571Mu&_nc_oc=AdkKjNnQbzCfDbpNOB2N8v3Tqrq0vZOGG4EUOxSOLKniP5X6ISAEBdMuq37YUk5LHWY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftK5Z8jeAgSM9nwoZFZDpMXrhZEa0N2xfJaQkSsGXhofw&oe=69A58ECE"}, "display_name": "First Person Tennis - The Real Tennis Simulator", "keywords": [], "long_description": "First Person Tennis is the first tennis simulator developed for VR.\n\nNow, you can play on a real tennis court and face professional tennis players. \nYou'll have to show all your technical and tactical skills.\n\nVR Controls:\nHold the controller/racket and play tennis.\n\nFeatures: \n- Arcade and Simulation mode.\n- Online Multiplayer.\n- 3 different ways to run through the court: Teleport, Run in Place, Sliding Run.\n- One handed serve.\n- 7 different court surfaces: clay, grass, hard, blue-green hard, classic synthetic, indoor hard and indoor synthetic; each with a specific rebound. \n- 13 tournaments: 4 Slam and 9 Masters. \n- Full ranking system. \n- Fully customizable 3D male player. ", "short_description": "First Person Tennis is the first tennis simulator developed for VR. Now, you can play on a real tennis court and face professional tennis players. You'll have to show all your technical 
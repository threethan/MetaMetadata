content-iad6-1.oculuscdn.com&oh=00_Af3b9RDh9B2qii0J8_SubIyf3Usvm4sR7lC67To6B6H3Xg&oe=69F0BA82"}, {"file_name": "5.png", "id": "2404697546328669", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572936_2404697549662002_6744001405025737672_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUtwIwFqhcwQ7kNvwFv0C2H&_nc_oc=AdqNXmOQPOR2TFN4KAo1Z5lD-bqAkce0jUpAm5XGyE778IPipWqWhkPj2SdcnIOJB7Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3urF2b0Cq0ZyUzbt2OsGpJEbxuKbBq0GeUsYOQll1tcA&oe=69F0ABB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "578040073613401", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001713_578040076946734_8153214829952110504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eo1FxeErEMAQ7kNvwFCXsJb&_nc_oc=Adp-YfNmjvsEwPpTeDz7oisP2QOBPAiEZMpjnMk0Yb9oCRpoZW8E4pyLsiVDxF6kAw4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af14jspEG6J2f5C7CGE2VQa9cDbo579M-dw1GaAGhflcrA&oe=69F0B44E"}, "display_name": "First Person Tennis - The Real Tennis Simulator", "keywords": [], "long_description": "First Person Tennis is the first tennis simulator developed for VR.\n\nNow, you can play on a real tennis court and face professional tennis players. \nYou'll have to show all your technical and tactical skills.\n\nVR Controls:\nHold the controller/racket and play tennis.\n\nFeatures: \n- Arcade and Simulation mode.\n- Online Multiplayer.\n- 3 different ways to run through the court: Teleport, Run in Place, Sliding Run.\n- One handed serve.\n- 7 different court surfaces: clay, grass, hard, blue-green hard, classic synthetic, indoor hard and indoor synthetic; each with a specific rebound. \n- 13 tournaments: 4 Slam and 9 Masters. \n- Full ranking system. \n- Fully customizable 3D male player. ", "short_description": "First Person Tennis is the first tennis simulator developed for VR. Now, you can play on a real tennis court and face professional tennis players. You'll have to show all your technical 
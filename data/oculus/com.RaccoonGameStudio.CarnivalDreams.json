iB7Fzg&oe=69BAAA5D"}, {"file_name": "Western.png", "id": "410777414407815", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57566685_410777417741148_6569393910833229394_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nODzkhwwRycQ7kNvwFRG4CH&_nc_oc=AdnTFefcvOn422YniztOLumrQivFLAAn-ZLjJOKOKBCItusjbFDibq-CY5cCgH6kfIc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzaO5CjM6_apMVafWb5gbjRVpjB-4O53kUF9TrY0hJ4BA&oe=69BA9AF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Video.png", "id": "435275938741423", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031316_435275942074756_6689148180939225515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtPBZN4sV94Q7kNvwGXffy8&_nc_oc=AdnztjNTN6V2i8AH27Qce0VBkeiJ8DSz4iTbtQ7P3HLCTh8BUstlU-mPWxlAnC4mYcI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxe796o8FyLMYHzghTjHzc_QkjT82HdOVCFdcCIz65fJg&oe=69BA98B0"}, "display_name": "Aimtropolis Demo", "keywords": [], "long_description": "The doors of Aimtropolis are open and we are bringing you a taste of it in this Demo.\n\nIn Aimtropolis DEMO you will face the challenge that this VR shooter/Arcade game brings to you. Your goal, get the highest score in each level and get on the top of the ranking. Make yourself worth of the crown going through our different worlds with an environment inspired on western, medieval, WWII, Pirates and cyberpunk.\n\nWhat are you waiting for? Face the challenge straight away or practice with our training grounds to improve your aim and prepare for the challenge. \n", "short_description": "Do you think you have a good aim? Prove it. AIMTROPOLIS is a VR arcade/shooter where you will have to prove yourself and the rest of the world in 5 random minigames. Get the highest score, and position yourself as a world champion.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raccoongamestudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name"
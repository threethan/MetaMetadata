8974613_821922955817367_5889000722902621221_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fq5HSh1x0pUQ7kNvwH7ohC4&_nc_oc=Adq3HEG1qftGF-LQypz_QbTX7GkCVDc_f_zpHGcW7Bt1j9lOEAaPocWMwA0ZWgwS-vc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJy2LSfRxZF53igejeZCrwVxeESP8XxMHvS2pGzrTuC6Q&oe=6AA81386"}, {"file_name": "Medieval.png", "id": "658340355846667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75549076_658340362513333_1064927184215706836_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6oJJtO_LYUQ7kNvwGqcCsE&_nc_oc=AdoIbZmtgYeaS1xn_v05X9FiuYb9kOHQahP95NZgp4Lk6PDypnBC5wsDg_3hjyyRQ8U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJi_gQ4F83EnmpSG6v2uyWZxs5wU3KAPlSQId-r5wKoTg&oe=6AA7F9C7"}, {"file_name": "pirates.png", "id": "450095600351129", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001661_450095610351128_2160571409650283165_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeE3Ea-OHd0Q7kNvwGMT-aD&_nc_oc=Ados-a43P4zTGDr2v_R8wsa3s5iIMPppy9GUXJpNAheq0aEMg7lTsGg50uyO77x7m5M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPgDRPdxbnntL00myjQ4DgZ-JaM-EPlnyg91K4z0zb4w&oe=6AA7F85D"}, {"file_name": "Western.png", "id": "410777414407815", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566685_410777417741148_6569393910833229394_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yiaLIyekgcQ7kNvwHn1o_I&_nc_oc=AdrrJW9SYrgzTuB_vp9kdwD6jc3lz4Ll7Tbo6h6uyM2vt-hlYm7UaU1iH01DFMohS9Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFIAEzsK-oSpRt5nPy_6Ki31wqGWxoM0VfJKZYTWAqZg&oe=6AA7E8F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Video.png", "id": "435275938741423", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_435275942074756_6689148180939225515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l434BvLKH_AQ7kNvwHetkOR&_nc_oc=AdoGESVx7Cs9exxUZi5boiaZ6hsSnKgdI91RvSlzbiE87sehygRarJrMB6e-_oE7ANo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL74Tc45-nDvsCKimJwLQXl3HW8zY3buKN_sKR4u5xtdw&oe=6AA7E6B0"}, "display_name": "Aimtropolis Demo", "keywords": [], "long_description": "The doors of Aimtropolis are open and we are bringing you a taste of it in this Demo.\n\nIn Aimtropolis DEMO you will face the challenge that this VR shooter/Arcade game brings to you. Your goal, get the highest score in each level and get on the top of the ranking. Make yourself worth of the crown going through our different worlds with an environment inspired on western, medieval, WWII, Pirates and cyberpunk.\n\nWhat are you waiting for? Face the challenge straight away or practice with our training grounds to improve your aim and prepare for the challenge. \n", "short_description": "Do you think you have a good aim? Prove it. AIMTROPOLIS is a VR arcade/shooter where you will have to prove yourself and the rest of the world in 5 random minigames. Get the highest score, and position yourself as a world champion.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raccoongamestudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Raccoon Game Studio", "support_website_url": null, "website_url": "https://www.aimtropolis.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1085623515468981"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.
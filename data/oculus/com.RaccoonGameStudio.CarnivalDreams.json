haxLJ4VWpVKYYVVyOk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXw7DFYl5roXSxc3bcqWI7i9IEI1F_5jD_SxXPmMT6xg&oe=6A8EEBDD"}, {"file_name": "Western.png", "id": "410777414407815", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57566685_410777417741148_6569393910833229394_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMmiKgKzjR4Q7kNvwHNVfPG&_nc_oc=Adq-dWadcHgEK-jA5BUmLIOxJG3yzayGUSOxyhljfFpQlLV3V51AM0jfHx1pO9TZ2JI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkESznJVeHvCFEeW0VzwXxEG4lqz3-abDlImUnnORsMg&oe=6A8EDC73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Video.png", "id": "435275938741423", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031316_435275942074756_6689148180939225515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hmc8YKjusx0Q7kNvwFV_MdW&_nc_oc=AdpkDhaTbgBcAR9uht7jYm6m1VIxHT1WbMcCoXKdd5-eodS3SNf-FGRwFdSuHRw_PtM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEdDvsmGs_TgiBVWJp37AcYg-759B8l4Gd6Hn3tCq52g&oe=6A8EDA30"}, "display_name": "Aimtropolis Demo", "keywords": [], "long_description": "The doors of Aimtropolis are open and we are bringing you a taste of it in this Demo.\n\nIn Aimtropolis DEMO you will face the challenge that this VR shooter/Arcade game brings to you. Your goal, get the highest score in each level and get on the top of the ranking. Make yourself worth of the crown going through our different worlds with an environment inspired on western, medieval, WWII, Pirates and cyberpunk.\n\nWhat are you waiting for? Face the challenge straight away or practice with our training grounds to improve your aim and prepare for the challenge. \n", "short_description": "Do you think you have a good aim? Prove it. AIMTROPOLIS is a VR arcade/shooter where you will have to prove yourself and the rest of the world in 5 random minigames. Get the highest score, and position yourself as a world champion.\n"}]}, "developer_name": null,
kh24xVhlriU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpWIvcdu1ir4GoEnmimkKx0vVtwH-z3k-auGwp8Mc-Gw&oe=6A7DC85D"}, {"file_name": "Western.png", "id": "410777414407815", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57566685_410777417741148_6569393910833229394_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thhOLZAjtdEQ7kNvwG0Wq98&_nc_oc=AdpXN5Qe7CMDWUBxCYspmyBoK34Y8euN_rINxUpaEAGlNJTysrcFXsrFShnKAy92H2A&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsfXBl3qdEuRaA2rbfrxHmoCM0wr9ZrJoKhon2TNK4_w&oe=6A7DB8F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Video.png", "id": "435275938741423", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031316_435275942074756_6689148180939225515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mmid7Rax9u4Q7kNvwFGMcz-&_nc_oc=Adpd-sG_jmVo5gDRbWnSLS4pCPS7gn1FC6c2Pm5OF8Z4NHnLl0PQcp-JdKJK_s-FPs4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6m1VyunowSqtvkD1jTuw1sr9KCg5haQ31jEd9tGEsgA&oe=6A7DB6B0"}, "display_name": "Aimtropolis Demo", "keywords": [], "long_description": "The doors of Aimtropolis are open and we are bringing you a taste of it in this Demo.\n\nIn Aimtropolis DEMO you will face the challenge that this VR shooter/Arcade game brings to you. Your goal, get the highest score in each level and get on the top of the ranking. Make yourself worth of the crown going through our different worlds with an environment inspired on western, medieval, WWII, Pirates and cyberpunk.\n\nWhat are you waiting for? Face the challenge straight away or practice with our training grounds to improve your aim and prepare for the challenge. \n", "short_description": "Do you think you have a good aim? Prove it. AIMTROPOLIS is a VR arcade/shooter where you will have to prove yourself and the rest of the world in 5 random minigames. Get the highest score, and position yourself as a world champion.\n"}]}, "developer_name": null, "develo
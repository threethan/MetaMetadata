22902621221_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9Qw_zVUGycQ7kNvwEAy4Pr&_nc_oc=AdkFeD3DQ_9eDNtEqVFWaKORzfeFaIBXA3TFSyZTJ4DNkoWTK9H-kN2jyAZ6Zvh-62U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxoJ6elYKX7wZw01z8v1gQudid6q97iOd7hYy8k4MZYvA&oe=69B3F5C6"}, {"file_name": "Medieval.png", "id": "658340355846667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75549076_658340362513333_1064927184215706836_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7eiz7AjUtcQ7kNvwG_klfL&_nc_oc=AdkVCr80_gTNOT8oRmWoANsx5iakYqYcPqvSwpgnk8stoaRTilrJenC1il1umRY0VWY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwzsRtY75lp_1AjmMBeZFLAb6ThFDWI-XVuCbUI8eH19A&oe=69B41447"}, {"file_name": "pirates.png", "id": "450095600351129", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001661_450095610351128_2160571409650283165_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQlmwUv_X5EQ7kNvwFApyBx&_nc_oc=AdlCjCbkoCVvxBVyD5OwkTZlmCI3RQqv6Q7Z3yI0tmx3brxG6x7CV2SjayWkYMpg3aw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw_Zd_Mg-IhJ7We4MA9LNX34X-ax7ga8nxnao2XS3Cd9Q&oe=69B412DD"}, {"file_name": "Western.png", "id": "410777414407815", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566685_410777417741148_6569393910833229394_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnNQ3TdlMlcQ7kNvwG2KHTL&_nc_oc=AdnOyqfiZRzUIa78MJT_bbD9YGhE_tAR4Vf0ksy_QroXo-ZGxo7Gjs7woxRGj5M8la0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyBvhDzEsgSfQjCTj5zx-thNR_8Eb06K6SoQBsefD-oBg&oe=69B40373"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Video.png", "id": "435275938741423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_435275942074756_6689148180939225515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4QA1XGA7qgQ7kNvwG4xbXL&_nc_oc=AdmUSMY1a3a7trB0lOfSFtZmbN_UYn9LuO2qiBJ-ZstQHV_7N4bqNumz65hlLtVYPQ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxJ62sUENA6kacqTG_xI3TlNLmu3Q2semsdH4a9mjoGxA&oe=69B40130"}, "display_name": "Aimtropolis Demo", "keywords": [], "long_description": "The doors of Aimtropolis are open and we are bringing you a taste of it in this Demo.\n\nIn Aimtropolis DEMO you will face the challenge that this VR shooter/Arcade game brings to you. Your goal, get the highest score in each level and get on the top of the ranking. Make yourself worth of the crown going through our different worlds with an environment inspired on western, medieval, WWII, Pirates and cyberpunk.\n\nWhat are you waiting for? Face the challenge straight away or practice with our training grounds to improve your aim and prepare for the challenge. \n", "short_description": "Do you think you have a good aim? Prove it. AIMTROPOLIS is a VR arcade/shooter where you will have to prove yourself and the rest of the world in 5 random minigames. Get the highest score, and position yourself as a world champion.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raccoongamestudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Raccoon Game Studio", "support_website_url": null, "website_url": "https://www.aimtropolis.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1085623515468981"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031514_1229203967650780_163696261077138840
z3Xw63_XwPo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsMPMpiVhCcI8fwZWIxLAJdAOiUFi3VTqaEpKvGYTTcQ&oe=6AAE8FDD"}, {"file_name": "Western.png", "id": "410777414407815", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57566685_410777417741148_6569393910833229394_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13nFP3vVmuAQ7kNvwH5_rkc&_nc_oc=AdqaCeHUaiRoQ74-vKQDg8GM7LI_d44wGvQea2VOR0BsZwOnMvkX3DY2PgffSkd44Zg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSVZiBvJj7cKu2Q7n8APYfbHswwtFoRxweP6hpdvRNeA&oe=6AAE8073"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Video.png", "id": "435275938741423", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031316_435275942074756_6689148180939225515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKvDqcJyXUEQ7kNvwEEp1sC&_nc_oc=Adpzj0nbGMoGU4kfskaSqL4VXFW1mGJbpcl0nQkD5qhEmg-mZSVvc-e9E0qBOkQxtNQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEitDameEa9lk9_IRXGVbM_lFnyZZhOB2PU0i-Nzeu8A&oe=6AAE7E30"}, "display_name": "Aimtropolis Demo", "keywords": [], "long_description": "The doors of Aimtropolis are open and we are bringing you a taste of it in this Demo.\n\nIn Aimtropolis DEMO you will face the challenge that this VR shooter/Arcade game brings to you. Your goal, get the highest score in each level and get on the top of the ranking. Make yourself worth of the crown going through our different worlds with an environment inspired on western, medieval, WWII, Pirates and cyberpunk.\n\nWhat are you waiting for? Face the challenge straight away or practice with our training grounds to improve your aim and prepare for the challenge. \n", "short_description": "Do you think you have a good aim? Prove it. AIMTROPOLIS is a VR arcade/shooter where you will have to prove yourself and the rest of the world in 5 random minigames. Get the highest score, and position yourself as a world champion.\n"}]}, "developer_name": null, "develo
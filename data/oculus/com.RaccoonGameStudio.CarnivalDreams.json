QlFerimdE7wukDZe8c&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEGg5AA-XFPwQRZ_GJIMHo-OgmjCvykr91-PfOu0-5Qg&oe=6A8D9A5D"}, {"file_name": "Western.png", "id": "410777414407815", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57566685_410777417741148_6569393910833229394_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMmiKgKzjR4Q7kNvwGk6ACJ&_nc_oc=AdpeAkg4acfEZKVk4IMriwD9Sqr6tyUQgkXvHVJ9r7tK_roI3u4dt1HX-x73GIjuonA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyJUHjWqU3kgmA8VDG8074lWsQFlwZQBHBnieD972h0A&oe=6A8D8AF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Video.png", "id": "435275938741423", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031316_435275942074756_6689148180939225515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hmc8YKjusx0Q7kNvwEiHJMm&_nc_oc=AdojaMhAwArUE653VN75Ywvn9PS6sHQ2HZol2drtHg_glyyHMTB5zeyUrNVGV5FbRGE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqvol9agF1oLFlJQowC1ZgVgLRLJcUh0LPpTLdn8_bmA&oe=6A8D88B0"}, "display_name": "Aimtropolis Demo", "keywords": [], "long_description": "The doors of Aimtropolis are open and we are bringing you a taste of it in this Demo.\n\nIn Aimtropolis DEMO you will face the challenge that this VR shooter/Arcade game brings to you. Your goal, get the highest score in each level and get on the top of the ranking. Make yourself worth of the crown going through our different worlds with an environment inspired on western, medieval, WWII, Pirates and cyberpunk.\n\nWhat are you waiting for? Face the challenge straight away or practice with our training grounds to improve your aim and prepare for the challenge. \n", "short_description": "Do you think you have a good aim? Prove it. AIMTROPOLIS is a VR arcade/shooter where you will have to prove yourself and the rest of the world in 5 random minigames. Get the highest score, and position yourself as a world champion.\n"}]}, "developer_name": null,
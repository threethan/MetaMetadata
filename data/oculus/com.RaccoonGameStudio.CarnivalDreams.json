DPpZiQ&oe=69B5645D"}, {"file_name": "Western.png", "id": "410777414407815", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566685_410777417741148_6569393910833229394_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnNQ3TdlMlcQ7kNvwGhhNHa&_nc_oc=AdmaSNQDFS4JXpvD1fzkr6g7ujdPFWBnyzMDewATxY58OGbDzlNBe1P3PF_x2ThmSog&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwavAu8FwcU53fuRgiS5abOfjEMACPx1qugxtnbfRNoVQ&oe=69B554F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Video.png", "id": "435275938741423", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_435275942074756_6689148180939225515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4QA1XGA7qgQ7kNvwEW9qUt&_nc_oc=Adm1yT_2PgqfV14s9uAsnuVtm9AfUanDhynQlMz2sL6MXxmie9BrAgaNwbyQy-cppHs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz33lG5Focc6-59sdIuckLqSO-4DTyrwAeddKhGbifg4g&oe=69B552B0"}, "display_name": "Aimtropolis Demo", "keywords": [], "long_description": "The doors of Aimtropolis are open and we are bringing you a taste of it in this Demo.\n\nIn Aimtropolis DEMO you will face the challenge that this VR shooter/Arcade game brings to you. Your goal, get the highest score in each level and get on the top of the ranking. Make yourself worth of the crown going through our different worlds with an environment inspired on western, medieval, WWII, Pirates and cyberpunk.\n\nWhat are you waiting for? Face the challenge straight away or practice with our training grounds to improve your aim and prepare for the challenge. \n", "short_description": "Do you think you have a good aim? Prove it. AIMTROPOLIS is a VR arcade/shooter where you will have to prove yourself and the rest of the world in 5 random minigames. Get the highest score, and position yourself as a world champion.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raccoongamestudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name"
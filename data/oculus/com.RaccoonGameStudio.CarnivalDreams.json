Q7kNvwHWYyNM&_nc_oc=Adm2qT7ahcmjR3FSpPz8FkHN_VnJKPPgn7xUn7sX5_EwKwdP5kWJycpRWmKSFtp8nsI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvpVpcUJXnYzFb_k_Xz6R8BzOa6NGAGwBiZUdtUpSy6BA&oe=699EDDC6"}, {"file_name": "Medieval.png", "id": "658340355846667", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75549076_658340362513333_1064927184215706836_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Z46Ng5eYWEQ7kNvwGYDBrV&_nc_oc=Adk2Vjgcwiznr9zcqs4HjyJfsbCqFv0r66YWFOq6jJnW_ZhvBnssRmU_V4Mlyt_VSZI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftdt1Ax-J0PlN0LyvoTceNAgkD_7weTRD0PhDLOriLewA&oe=699EFC47"}, {"file_name": "pirates.png", "id": "450095600351129", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001661_450095610351128_2160571409650283165_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lD2_GZvynNYQ7kNvwHqaScx&_nc_oc=AdlvNPoy0Cyu4kN5sdSPTvdwXt_u0u4FQZF8xMxoxc23a-v86y8HZ_tz8PJkbYJAfVA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsKmqZUh9C4iIw3JEo8YTB35WaxVdKQ94sgOJoGcI-R9A&oe=699EFADD"}, {"file_name": "Western.png", "id": "410777414407815", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566685_410777417741148_6569393910833229394_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EixLCdNFIEIQ7kNvwFAbnSN&_nc_oc=AdkI-jA6A0Gg1_4VxbflHcohMqHbRr2DjGJ-jIIAeupuAU9LbZdgcPhKxZ1TlgOV4yc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftzG2JUw7bas5ZZG4JvMnKZLn2IcbAc1MYJ1mpX2Hm16w&oe=699EEB73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Video.png", "id": "435275938741423", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031316_435275942074756_6689148180939225515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCUXBV1YmuYQ7kNvwGCIr1g&_nc_oc=AdmRpD7ffCdgytgixFwLyCtSj4gvEXmBWH9hw0Lf83UdJI3_S5axa4l-QEBeknVCvAU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afshbftkq8UouRfbHXPiSGlVuljI8w_aDZuXISE29VEjcg&oe=699EE930"}, "display_name": "Aimtropolis Demo", "keywords": [], "long_description": "The doors of Aimtropolis are open and we are bringing you a taste of it in this Demo.\n\nIn Aimtropolis DEMO you will face the challenge that this VR shooter/Arcade game brings to you. Your goal, get the highest score in each level and get on the top of the ranking. Make yourself worth of the crown going through our different worlds with an environment inspired on western, medieval, WWII, Pirates and cyberpunk.\n\nWhat are you waiting for? Face the challenge straight away or practice with our training grounds to improve your aim and prepare for the challenge. \n", "short_description": "Do you think you have a good aim? Prove it. AIMTROPOLIS is a VR arcade/shooter where you will have to prove yourself and the rest of the world in 5 random minigames. Get the highest score, and position yourself as a world champion.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raccoongamestudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Raccoon Game Studio", "support_website_url": null, "website_url": "https://www.aimtropolis.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1085623515468981"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031514_1229203967650780_1636962610771388409_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BDmZwKEzR8Q7kNvwEO_073&_nc_oc=AdnptuhI6XZOQJ
BnM1YQ&oe=69BD4D5D"}, {"file_name": "Western.png", "id": "410777414407815", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57566685_410777417741148_6569393910833229394_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffb-rBv8odgQ7kNvwEyi_p2&_nc_oc=Adm1PWWxA2CvHD4oFMf8o8tyWevh2wW6Qb2BkBaWX7j86yJDJ1kB5eL_Lq2_n_ef9H8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzlmI7MH3_0l_rq4g68Nm6EY10OIBZNFhoLqPojBORu0w&oe=69BD3DF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Video.png", "id": "435275938741423", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031316_435275942074756_6689148180939225515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtI_8Mth9DYQ7kNvwHch0pT&_nc_oc=AdlC7NlnZ1PzsT5o_QnVuX2mhtuMKlc-vYkSxq4VCmYa-XVmrb367Hu47UV7nmI2M-Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3Tf7vwncRI0DikzDedQeMB8QGhyg5BdW1fC0CO26SbA&oe=69BD3BB0"}, "display_name": "Aimtropolis Demo", "keywords": [], "long_description": "The doors of Aimtropolis are open and we are bringing you a taste of it in this Demo.\n\nIn Aimtropolis DEMO you will face the challenge that this VR shooter/Arcade game brings to you. Your goal, get the highest score in each level and get on the top of the ranking. Make yourself worth of the crown going through our different worlds with an environment inspired on western, medieval, WWII, Pirates and cyberpunk.\n\nWhat are you waiting for? Face the challenge straight away or practice with our training grounds to improve your aim and prepare for the challenge. \n", "short_description": "Do you think you have a good aim? Prove it. AIMTROPOLIS is a VR arcade/shooter where you will have to prove yourself and the rest of the world in 5 random minigames. Get the highest score, and position yourself as a world champion.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raccoongamestudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name"
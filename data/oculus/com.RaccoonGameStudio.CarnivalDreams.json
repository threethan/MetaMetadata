22902621221_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HY6K0Cgzz5oQ7kNvwFEGJy6&_nc_oc=AdnpuwbDW0ne2b89lfIT14VAERIwQ1tCJtb5QP6msKtWcoudqi1ay5S0TC_3e8VKT20&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyO6Ci5dKxEX9Aq-cGLAgZs01-nsH5zUgGbNFUROoRicg&oe=69AC0CC6"}, {"file_name": "Medieval.png", "id": "658340355846667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75549076_658340362513333_1064927184215706836_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDUZoCY7ursQ7kNvwG-2JXN&_nc_oc=AdkTatG2n6ylezvihDRo7Hv86uBJOQCTaCn_8x5JBkc-Vb73dp-25eKDwItG7rTRtwU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz6OlOxdkdcfVvTaZdhow1vvM7CUnPAAR_hgExdaYAAKA&oe=69AC2B47"}, {"file_name": "pirates.png", "id": "450095600351129", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001661_450095610351128_2160571409650283165_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHUTP2pHa4IQ7kNvwEmk5TL&_nc_oc=Admlvy5JsFJy62D7Nw1xGypIc-1wuxa0TsadHBZxr9bPQ4SI3B_lUG818z-qJTOhHSo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyUYw-FXXKL2O18niKFOdKqVLYeaQvCRG2rpfdTK3-Znw&oe=69AC29DD"}, {"file_name": "Western.png", "id": "410777414407815", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566685_410777417741148_6569393910833229394_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgmxC-jKUIEQ7kNvwHJOKbX&_nc_oc=AdmCJfLB5FjdYz5D9oZjpfOjT9GbENW5z_33A2za9thzng641uPDq06uJtSI5MG0hwY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyF5vOpgS1K14E50rbVhtn7hLQLzwHVtqthfmp7y5E_Qw&oe=69AC1A73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Video.png", "id": "435275938741423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_435275942074756_6689148180939225515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jn7h9s-COaYQ7kNvwGZN0q7&_nc_oc=AdlMALCBBgjDDD8oQekpcMfNVMMin5qJ-5OW1cC3V-MepwFDgS6d6Wt1w8ZSSDj5CkY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxx0jtKe6XqLAxAm5rdK8PzSARfKSMGZWwaBq-qRXsTtA&oe=69AC1830"}, "display_name": "Aimtropolis Demo", "keywords": [], "long_description": "The doors of Aimtropolis are open and we are bringing you a taste of it in this Demo.\n\nIn Aimtropolis DEMO you will face the challenge that this VR shooter/Arcade game brings to you. Your goal, get the highest score in each level and get on the top of the ranking. Make yourself worth of the crown going through our different worlds with an environment inspired on western, medieval, WWII, Pirates and cyberpunk.\n\nWhat are you waiting for? Face the challenge straight away or practice with our training grounds to improve your aim and prepare for the challenge. \n", "short_description": "Do you think you have a good aim? Prove it. AIMTROPOLIS is a VR arcade/shooter where you will have to prove yourself and the rest of the world in 5 random minigames. Get the highest score, and position yourself as a world champion.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raccoongamestudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Raccoon Game Studio", "support_website_url": null, "website_url": "https://www.aimtropolis.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1085623515468981"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031514_1229203967650780_163696261077138840
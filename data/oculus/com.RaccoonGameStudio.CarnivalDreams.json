11CeTw&oe=69A986DD"}, {"file_name": "Western.png", "id": "410777414407815", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566685_410777417741148_6569393910833229394_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M30FTeZHsKYQ7kNvwGmzq7B&_nc_oc=AdnVxxV-g4VpiG2kEo1s86Sg7G9enP_pTIF1w4mDy-Z7FjrGuPtGFprDvg4-nL6XWxw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afti2YGjsr-FjPPMtcN_UPJPJch4eibN_HsyiKHsvT1uSQ&oe=69A97773"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Video.png", "id": "435275938741423", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_435275942074756_6689148180939225515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttO5IdfKixEQ7kNvwHoLXNW&_nc_oc=AdkHNnMunPH2uc9vtIvbPkcMHiDvgd8Kksoxqpn1A-f2wbpKwUTzCnUN6kuF7nxmzwc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afv85HZccbuw1sC5LUbom4OI7UU5M-fXantEUG1S6iFfxg&oe=69A97530"}, "display_name": "Aimtropolis Demo", "keywords": [], "long_description": "The doors of Aimtropolis are open and we are bringing you a taste of it in this Demo.\n\nIn Aimtropolis DEMO you will face the challenge that this VR shooter/Arcade game brings to you. Your goal, get the highest score in each level and get on the top of the ranking. Make yourself worth of the crown going through our different worlds with an environment inspired on western, medieval, WWII, Pirates and cyberpunk.\n\nWhat are you waiting for? Face the challenge straight away or practice with our training grounds to improve your aim and prepare for the challenge. \n", "short_description": "Do you think you have a good aim? Prove it. AIMTROPOLIS is a VR arcade/shooter where you will have to prove yourself and the rest of the world in 5 random minigames. Get the highest score, and position yourself as a world champion.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raccoongamestudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name"
Q7kNvwFgIfKp&_nc_oc=Adkbl3hVVMrh4dObCWGiDDIvk8tf8tt18R5zAQ0RxjKEK23hy_1-60fGffyh0CHxl6Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs7pleBCgq9yLCfxz1k1dv-ILJmHT721Aq_O9poEY8vpw&oe=69A2D246"}, {"file_name": "Medieval.png", "id": "658340355846667", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75549076_658340362513333_1064927184215706836_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_8QFAI2e-YQ7kNvwEMcrqE&_nc_oc=Adlg0rfAAcq6-d43spPTwwIh5prttDwTJ6L2Qyf4jcy6iO8VqNdKZC2psfZIth4ruBs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuQn4fPeNhK2ErqUUe2zpPVf3iIVEmxHOCM7O0TkYvQFw&oe=69A2F0C7"}, {"file_name": "pirates.png", "id": "450095600351129", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001661_450095610351128_2160571409650283165_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cguWQRHllrUQ7kNvwG__9ZQ&_nc_oc=AdlmKQVjAsdCoCnCzyeV6DJKDf3rK6ngok1dIM2ueq9awPchU58XkpELQO932sCiih8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs37214WZcnhZbx0htGie7opM4De4Ta6mzcLiPDJrkP_Q&oe=69A2EF5D"}, {"file_name": "Western.png", "id": "410777414407815", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566685_410777417741148_6569393910833229394_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtruKZy0deQQ7kNvwE4um9e&_nc_oc=AdlSUMCJaSkOpt3JBmJKA-XLzbSUhaUisQhX-R4G5biFUqW6dIWrrFrDJ96KoNOW3MY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft4waNnMXtOZyxmY3s7Pi82Vha4sDZSizvtnMn3VWwdxw&oe=69A2DFF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Video.png", "id": "435275938741423", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031316_435275942074756_6689148180939225515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNiWnz_YUBoQ7kNvwH5SiRb&_nc_oc=Adl1PyV5dTsX03WuJ86EVrVYrJ59y4j0J9MZnXqQFFiWmAC31crxbD7SQ_EElm5rz6Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvQadVWBZlK1d4LWPK0r3rFkLrgizQNrv8Ak5Ao4VDNAQ&oe=69A2DDB0"}, "display_name": "Aimtropolis Demo", "keywords": [], "long_description": "The doors of Aimtropolis are open and we are bringing you a taste of it in this Demo.\n\nIn Aimtropolis DEMO you will face the challenge that this VR shooter/Arcade game brings to you. Your goal, get the highest score in each level and get on the top of the ranking. Make yourself worth of the crown going through our different worlds with an environment inspired on western, medieval, WWII, Pirates and cyberpunk.\n\nWhat are you waiting for? Face the challenge straight away or practice with our training grounds to improve your aim and prepare for the challenge. \n", "short_description": "Do you think you have a good aim? Prove it. AIMTROPOLIS is a VR arcade/shooter where you will have to prove yourself and the rest of the world in 5 random minigames. Get the highest score, and position yourself as a world champion.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raccoongamestudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Raccoon Game Studio", "support_website_url": null, "website_url": "https://www.aimtropolis.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1085623515468981"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031514_1229203967650780_1636962610771388409_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ik-VMGyss-EQ7kNvwFt2Gye&_nc_oc=AdlCpEioq4dPFi
_ohc=NwGVLuOineAQ7kNvwFxKI__&_nc_oc=Admcw2Qhn9yJQoam9h99pkYnE-gVl5tK-5FiYLFONr1Dvaj6pj-Psd2xJxZuDcUf8KM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvx_U_AWykGbBQKsbCnQI8bdKIkpKu5m8_zGMLja7XsNQ&oe=699AF6F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Video.png", "id": "435275938741423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_435275942074756_6689148180939225515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1WP4HbuZ1IQ7kNvwEYuEsv&_nc_oc=Admw2jD4uvkTmlObZdmQUctbfl1dDf6PHSZj2WbZ1DueF_4nNtRTnpShAVoDTtTnBi4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs3lgXwZMyyI9nDWmhG78dg51Re34w7ZIwiPhPIFQ1c2g&oe=699AF4B0"}, "display_name": "Aimtropolis Demo", "keywords": [], "long_description": "The doors of Aimtropolis are open and we are bringing you a taste of it in this Demo.\n\nIn Aimtropolis DEMO you will face the challenge that this VR shooter/Arcade game brings to you. Your goal, get the highest score in each level and get on the top of the ranking. Make yourself worth of the crown going through our different worlds with an environment inspired on western, medieval, WWII, Pirates and cyberpunk.\n\nWhat are you waiting for? Face the challenge straight away or practice with our training grounds to improve your aim and prepare for the challenge. \n", "short_description": "Do you think you have a good aim? Prove it. AIMTROPOLIS is a VR arcade/shooter where you will have to prove yourself and the rest of the world in 5 random minigames. Get the highest score, and position yourself as a world champion.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raccoongamestudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Raccoon Game Studio", "support_website_url": null, "website_url": "https://www.aimtropolis.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription
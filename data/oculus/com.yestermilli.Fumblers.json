", "knuckle", "fumblers", "gorilla"], "long_description": "# KNOCK EM OUT!\n\n**Fumblers** is a chaotic multiplayer VR brawler for Meta Quest. Swing your arms to run, climb and leap across rooftops, scrapyards and rush-hour streets, then shove and fling rival Fumblers into the void. Every round brings a new map with moving platforms and deadly hazards. Earn stars, climb the scoreboard and show off silly hats. Chat by voice with friends in the lobby, then dive into wobbly, slapstick fights where everyone **fumbles**.\n{930304743271306}", "short_description": "Fumblers is a chaotic multiplayer VR brawler for Meta Quest. Swing your arms to run, climb and leap across rooftops, scrapyards and rush-hour streets, then shove and fling rival Fumblers into the void. Every round brings a new map with moving platforms and deadly hazards. Earn stars, climb the scoreboard and show off silly hats. Chat by voice with friends in the lobby, then dive into wobbly, slapstick fights where everyone fumbles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/fumblers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "yestermilli", "support_website_url": null, "website_url": "http://sites.google.com/view/fumblers/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "528142316460358"}, {"id": "2710427532541308"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_inte
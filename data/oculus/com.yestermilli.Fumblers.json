hc=j1Eef-ZEFeIQ7kNvwFhZRL3&_nc_oc=AdoqiG22sOu6kRmqOpMFi3sfx4VrJKW3jmvvdfHAo4HzmKkFk8sUoA-MjwrF4R2PSi4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr_NwaGRKu9vkzkIlio8UShXXjEgQOuFtc4-Dyiu0Msg&oe=6AF725B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fumblers", "keywords": ["gang", "beasts", "fumblers", "gorilla", "knuckleheads"], "long_description": "# DON'T FUMBLE THE WIN!\n\n**Fumblers** is a hardcore, chaotic, multiplayer VR brawler for Meta Quest. \n\nUse your hands to navigate but also fight other players in our various assortment of maps. Each round has its own gameplay addition that makes this simple task a lot harder with new obstacles for players to overcome. Talk with your friends and potentially team up in our other gamemodes 2v2v2 or Waves. Dress up your Fumbler with a large variety of our own cosmetics that bring much more life to the game.\n\nHowever at the end make sure not to be the one who **fumbles!**\n\n{1712214187123880}", "short_description": "Fumblers is a hardcore, chaotic, multiplayer VR brawler for Meta Quest. \n\nUse your hands to navigate but also fight other players in our various assortment of maps. Each round has its own gameplay addition that makes this simple task a lot harder with new obstacles for players to overcome. Talk with your friends and potentially team up in our other gamemodes 2v2v2 or Waves. \n\nHowever at the end make sure not to be the one who fumbles!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/fumblers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "yestermilli", "support_website_url": "https://discord.gg/fumblers", "website_url": "http://sites.google.com/view/fumblers/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "52814231
6D8VV46FnRV7f-IeaK2g&oe=69A8218B"}, {"file_name": "Screen_2_Toilet_Passthrough.png", "id": "399092643246026", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003226_399092653246025_3513024666909186113_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjUn81Cz38QQ7kNvwHflx6W&_nc_oc=Adn-OehWCoq4Ix6Txo5Qj7HrTinGlXOdrt2c74opJhiDO4HmYduEUNjvce2Om0HkJfE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuOIcjlT-vFedLe-IKI_oZML6ULDGTL0WLIR_29yvc8vQ&oe=69A80F8C"}, {"file_name": "Screen_v1_FencesA.png", "id": "1809628033134368", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982612_1809628036467701_5448370794054911283_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgmDFtjq7YYQ7kNvwFpivB3&_nc_oc=AdnYsfJyRcGjOD9XSJ754FDyteoZfyesfU_FuU7jH2dQ7z91LnaJxsCz7yPO6Ks60sA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsyy-lPd76N3zPqxGvtmNU5z7ART5CHX7kv7BjB0pl2nw&oe=69A82570"}, {"file_name": "Screen_Preorder_v1_PlanetRings.png", "id": "1010280957553281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254872_1010280960886614_8548514678587306840_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-d_gVfDHXYQ7kNvwGHxY-v&_nc_oc=Adkzy6m3siP6xJtyrnbbKcjd-2oRsAwwzUdCiHCKtOiA_-TaIst2MKjCREPxi44sd5U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsUmSgqL3cXx2SKeyoAIfkWjRrDmTrYgMCRtbNBtmASmQ&oe=69A829BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail.png", "id": "510259041956853", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982674_510259045290186_8234367733913918752_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCjwxu5MMgsQ7kNvwHtKAce&_nc_oc=AdnP6cWjayovkSfWZCDIX7Sufsvebst1dELUMQ2l_bfUOwkf-VPRjswZ0QV4zG8_KfI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuQ-XxHpWXm5NFnEnDGx_GvIReLTH8ao4zhSqeyYskMsQ&oe=69A83607"}, "display_name": "Snapstick", "keywords": ["puzzle", "funny", "build", "easy", "slapstick"], "long_description": "Snapstick is a **perfectly normal puzzle game** about connecting things together. It's perfect for normal people. Okay? Okay. Don't worry about it.\n\n\n# WHAT'S IN THE BOX?\n* 500+ puzzles by the multi-award-winning designer of Linelight\n* 60+ original mechanics\n* A memorable cast of very normal characters\n* Featuring music by the legendary Grant Kirkhope (Banjo-Kazooie, GoldenEye 007)\n* ...And much, much more!!!\n* Anti-climatic bullet points\n\n# PUZZLES, PUZZLES, PUZZLES\nBuild objects, solve 3D mazes, build coasters, bounce lasers, and much more. Scratch itches deep in your brain.\n{1223440118880908}\n\n# PLAY CUPID\nThis dog is a normal character with a normal storyline.\n{495296376732218}\n\n# SHADOW WORK\nPlay with size, rotation, and light. This part is pretty shady.\n{3925841577697925}\n\n# RUNNING JOKES\nWe apologize for nothing.\n{1747873889318890}\n\n# HANDS ON\nOptionally ditch those controllers and get fully immersed. Experience a white-glove service!\n{1057724902413239}", "short_description": "Snapstick is a perfectly normal puzzle game for perfectly normal people. It's filled with great puzzles, terrible jokes, and chock-full o' variety and surprises. Expect the unexpected.\n\nDO: Assemble roller coasters, match shadows to silhouettes, connect streets to unite dogs, bounce laser beams, and MANY more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mydogzorro.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "https://www.mydogzorro.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommend
dn.com&_nc_ss=7f20f&oh=00_AQC3M2Dt3xXq5M4H5d0MoyFS8i2EAmpNF90v8hfq-827IQ&oe=6A5A1C0B"}, {"file_name": "Screen_2_Toilet_Passthrough.png", "id": "399092643246026", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39003226_399092653246025_3513024666909186113_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLI9F3qYSv4Q7kNvwE5RheH&_nc_oc=Adr0jMynubZjQ19kAbmGn08JKIO7SmUL3m1Elf5C60jU_esj7itgMYVeoWhLTQjEjdY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQlAFXWHVQIbMiYYnBwOmkVzCg9SOLyxWBvveLKzsL-Q&oe=6A5A424C"}, {"file_name": "Screen_v1_FencesA.png", "id": "1809628033134368", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982612_1809628036467701_5448370794054911283_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEWBkD6-glkQ7kNvwEbg9Qt&_nc_oc=AdpeLwEueDHEXcvvOj02dvbfCol4Mor_MlC9OGCF-1K9ftgquj3WEvIcj5icm6QNQqw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-nYWXIbKm0s6QcyqGlzoD71U7slPAUnTqWGnyGKB2zQ&oe=6A5A1FF0"}, {"file_name": "Screen_Preorder_v1_PlanetRings.png", "id": "1010280957553281", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75254872_1010280960886614_8548514678587306840_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26_wz96knuEQ7kNvwGqohaQ&_nc_oc=Adrcx3r6MwnrxmJUsrDXv62J3oVUVBVk-xr0K-LIl3XhtMNj8ZsN3upJdXbAFxaoltw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEEe39eoqA-LQlTcq2RPFai5bicbxX0vmQJtibdtTaDw&oe=6A5A243B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail.png", "id": "510259041956853", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982674_510259045290186_8234367733913918752_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zS_MKfO19UQ7kNvwEQ_-kN&_nc_oc=Ado5T8D-1gYW0WcYZQtip6KRYF8zyzHppvAtNjm9iRUA6XW44MpbX-vgmQAqQr7qBNU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6WVwEjn_QLtrEvrAsIspnHNFIHzZHNLOg78Dq0P5ZrQ&oe=6A5A3087"}, "display_name": "Snapstick", "keywords": ["puzzle", "funny", "build", "easy", "slapstick"], "long_description": "Snapstick is a **perfectly normal puzzle game** about connecting things together. It's perfect for normal people. Okay? Okay. Don't worry about it.\n\n\n# WHAT'S IN THE BOX?\n* 500+ puzzles by the multi-award-winning designer of Linelight\n* 60+ original mechanics\n* A memorable cast of very normal characters\n* Featuring music by the legendary Grant Kirkhope (Banjo-Kazooie, GoldenEye 007)\n* ...And much, much more!!!\n* Anti-climatic bullet points\n\n# PUZZLES, PUZZLES, PUZZLES\nBuild objects, solve 3D mazes, build coasters, bounce lasers, and much more. Scratch itches deep in your brain.\n{1223440118880908}\n\n# PLAY CUPID\nThis dog is a normal character with a normal storyline.\n{495296376732218}\n\n# SHADOW WORK\nPlay with size, rotation, and light. This part is pretty shady.\n{3925841577697925}\n\n# RUNNING JOKES\nWe apologize for nothing.\n{1747873889318890}\n\n# HANDS ON\nOptionally ditch those controllers and get fully immersed. Experience a white-glove service!\n{1057724902413239}", "short_description": "Snapstick is a perfectly normal puzzle game for perfectly normal people. It's filled with great puzzles, terrible jokes, and chock-full o' variety and surprises. Expect the unexpected.\n\nDO: Assemble roller coasters, match shadows to silhouettes, connect streets to unite dogs, bounce laser beams, and MANY more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mydogzorro.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "https://www.mydogzorro.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "re
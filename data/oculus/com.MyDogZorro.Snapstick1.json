ent-ord5-3.oculuscdn.com/v/t64.5771-25/38974681_3418916435075514_2077016708238167722_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrUhtYlSCegQ7kNvwHNK2HT&_nc_oc=AdnGbkWTnjQS8NLz6qYHHkEM4YTk5ShQNJxf15Ux3QyrsSMR0_IJxM-78zmsg9UM3f0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvmV5rBEw31nVOV4HfGJ4ioqzXyuZkzB6Phmw-WAJYXiQ&oe=69A44C1C"}, {"file_name": "Screen_Preorder_v1_Punchline0.png", "id": "962264205584287", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295751_962264208917620_1294629659748263180_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXgy9ZN3IbAQ7kNvwEwhdvS&_nc_oc=Adlu_qJtNAcSOGigMZXt5XZjek6Ri09YwRBbALpoeQMrB-S2BgExxjHXfXRPzJvWz08&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvj1k8gtC4z9xnnEBsz9riGMhBSF1vxFaaV_trxIs5m1Q&oe=69A43531"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Preorder_v1_ThumbnailB.png", "id": "2457094281347939", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286673_2457094284681272_2062835017525816130_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwCicENlXMMQ7kNvwGngdIj&_nc_oc=AdkNeuAw-f4dnGCH9dmPYUmPKco1XW_8Xa5qNHX5-fG6YV2YO-PWCdPff-9ViMf26MQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv7NB3EyVOTnFTLK1QlFF5_-A7TrdyaVFEWEy_RetpOFw&oe=69A43A1F"}, "display_name": "Snapstick", "keywords": [], "long_description": "# FEATURES\n- Over 600 puzzles\n- Over 5 hours of real good gameplay\n- Over 60 unique mechanics\n- 0 apologies\n- There are 5 bullet points\n\n\n# THINGS YOU'LL DO\n- Grab\n- Snap\n- Stick\n- Win\n- Buy\n- This\n- Game\n\n\n# EVEN MORE INTERESTING DETAILS\n- Over 600 puzzles designed by a multi-award-winning puzzle designer who is much better at designing puzzles than writing store copy\n- Over 2 jokes written by an award-winning puzzle designer who is much better at designing puzzles than writing over 2 jokes\n- Featuring music by the legendary Grant Kirkhope (Banjo-Kazooie, GoldenEye 007, Mario + Rabbids Kingdom Battle), who is much better at designing puzzles than writing music, but he had very controlling parents\n- Dogs\n- Passthrough and hands support, because it's hip\n- Music\n- Over 20 unresolved low-priority bugs\n- \u2026And so much more!!!\n- Anticlimactic bullet-points\n\n[headset and controllers sold separately]", "short_description": "Snapstick is a bonkers puzzle game about love. Play delirious, VR-rich mechanics and experience themes of toilet love, dog infidelity, secret-agent-couple's-counseling, ASMR planets, and more. It gets weird."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mydogzorro.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "https://www.mydogzorro.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8186299241427562"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "1567725171225450"}, {"status": "PUBLISHED", "id": "1382961890195664"}, {"status": "PUBLISHED", "id": "1386394146264187"}, {"status": "PUBLISHED", "id": "4123918204523844"}, {"status": "PUBLISHED", "id": "1117629469756214"}, {"status": "PUBLISHED", "id": "1496368784687294"}, {"status": "PUBLISHED", "id": "566466529268019"}, {"status": "PUBLISHED", "id": "650091744169280"}, {"status": "PUBLISHED", "id": "514449824672081"}, {"status": "PUBLI
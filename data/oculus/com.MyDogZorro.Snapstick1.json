_1010280960886614_8548514678587306840_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vd99SQOr-fIQ7kNvwGk0-kN&_nc_oc=Adr8E8knCEFXGRzBDv_-NcJWHkPNheJslPomGforD7a0aEIbBZDPPvuUD_YSiAGCsS8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--gBin0_R4TKy3XsqEMfkef5_4ibt-vb2k4q5vPsxxzg&oe=6A2416BB"}, {"file_name": "Screen_Preorder_v1_LasersSpectacle.png", "id": "3418916431742181", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974681_3418916435075514_2077016708238167722_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHkyuph0X-4Q7kNvwE0euam&_nc_oc=AdodUSBMi_maAGO7zC38Lvhs2wLlsDMmykLxCoJAYk0FJGv48GKzGpNgcexfMlJnEec&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9u2QoGj6pHRrjIluFw7jOauAr_KgPKDbvvCWVFiu_trQ&oe=6A242D9C"}, {"file_name": "Screen_Preorder_v1_Punchline0.png", "id": "962264205584287", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75295751_962264208917620_1294629659748263180_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTeiJq9_708Q7kNvwGkbEnV&_nc_oc=Ado2kI-036VMMneKZM_UeKhRnc8EJC_WowUdCuwhF7C1qgfeCa078T-JIBWNhg3v-FQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HOOV2F3K9x6CzIrQ8MSNMkquGtrz-wtiqMQhH-tj_Pw&oe=6A2416B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Preorder_v1_ThumbnailB.png", "id": "2457094281347939", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75286673_2457094284681272_2062835017525816130_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGO8yOLo48QQ7kNvwFtiEi1&_nc_oc=AdprF_wzyoIepY598bHW9l8wVQtP2MlQdqfSXi0dR904So5gS-kKzQ5gCHB29-fEK_A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OVpSvdQrIN4589rmdW0Rna5Et3l1kkX_2OSAq2knMjw&oe=6A241B9F"}, "display_name": "Snapstick", "keywords": [], "long_description": "# FEATURES\n- Over 600 puzzles\n- Over 5 hours of real good gameplay\n- Over 60 unique mechanics\n- 0 apologies\n- There are 5 bullet points\n\n\n# THINGS YOU'LL DO\n- Grab\n- Snap\n- Stick\n- Win\n- Buy\n- This\n- Game\n\n\n# EVEN MORE INTERESTING DETAILS\n- Over 600 puzzles designed by a multi-award-winning puzzle designer who is much better at designing puzzles than writing store copy\n- Over 2 jokes written by an award-winning puzzle designer who is much better at designing puzzles than writing over 2 jokes\n- Featuring music by the legendary Grant Kirkhope (Banjo-Kazooie, GoldenEye 007, Mario + Rabbids Kingdom Battle), who is much better at designing puzzles than writing music, but he had very controlling parents\n- Dogs\n- Passthrough and hands support, because it's hip\n- Music\n- Over 20 unresolved low-priority bugs\n- \u2026And so much more!!!\n- Anticlimactic bullet-points\n\n[headset and controllers sold separately]", "short_description": "Snapstick is a bonkers puzzle game about love. Play delirious, VR-rich mechanics and experience themes of toilet love, dog infidelity, secret-agent-couple's-counseling, ASMR planets, and more. It gets weird."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mydogzorro.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "https://www.mydogzorro.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8186299241427562"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLIS
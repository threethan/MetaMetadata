AtEjnvaX2Q6-q00Mw&oe=6B0C7E7D"}, {"file_name": "11_Screenshot_04_2560x1440.png", "id": "2380138856064548", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619602_2380138859397881_5647001189222451927_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Ti9LmS26jkQ7kNvwED7DCx&_nc_oc=AdqJ9Mt2Af8fL9lEqIzMSaK8is7XVrtVyLefJlZHbB-Y6kaO7cikfyD7mg6OFSvOGzk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSL4VJzZ3awhB7chfO7Lhzxn8GyH3sQ3ZZ9UhFsbORNeQ&oe=6B0C765C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16_Trailer_Cover_2560x1440.png", "id": "1650529959559293", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619382_1650529966225959_6937430513776092703_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfqJNuLtRSQQ7kNvwF2x0YI&_nc_oc=AdpGojWE_hJZhsgHzZh9TPbog3GdxVN256FzWWrqtzluwGPI_N1fZr76LbhHM2DzLQs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRp-3Wx0XvSFfW25Za6slohQlyM8iIdfOkrou8CErtwrw&oe=6B0C76B2"}, "display_name": "Survival Arena", "keywords": [], "long_description": "# SURVIVAL ARENA VR\n\nEnter a world of immersive VR survival and combat! Face dangerous enemies, complete challenging missions, earn gold, and grow stronger as you fight your way through five different maps.\n\n## FIVE UNIQUE CHALLENGES\n\n- **Survival Arena:** Fight enemies and survive.\n- **Rescue Mission:** Save and escort survivors to safety.\n- **Base Defense:** Defend a house against three waves of enemies.\n- **Treasure Maze:** Explore a maze and collect treasure chests.\n- **Final Boss:** Defeat a powerful boss and escape.\n\n## FIGHT, EARN AND UPGRADE\n\nUse motion-controlled melee weapons and shields in immersive VR combat. Earn gold through gameplay to purchase better equipment, improve your character's abilities, and unlock new maps.\n\n## FOUR DIFFICULTY LEVELS\n\nChoose Easy, Normal, Hard, or Nightmare. Test your skills, master the combat system, and take on increasingly challenging missions.\n\n## YOUR SURVIVAL STARTS NOW\n\nExplore, fight, upgrade, and overcome every challenge in Survival Arena VR!", "short_description": "Survive five unique VR challenges! Fight enemies, rescue survivors, defend your base, explore dangerous mazes, and battle a powerful boss. Earn gold, upgrade your abilities, unlock weapons and equipment, and conquer four difficulty levels in immersive VR combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vannamdigital.github.io/survival-arena-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Van Nam Digital", "support_website_url": null, "website_url": "https://vannamdigital.github.io/survival-arena-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "vi", "ja", "ko", "zh_CN", "zh_HK", "zh_TW", "es", "fr", "de", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1406407845890247"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1161943422836800"}]}, "baseline_offer": {"id": "1161943422836800"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793835780, "status": "PUBLISHED", "id": "1161943422836800"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1406469715884060", "version": "1.9.1"}, "
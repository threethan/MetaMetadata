t=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9FlKEFmjOwQ7kNvwGuWNIq&_nc_oc=AdqE2fI6STY9Yz_NqUcsacCdFXfjDlAZ81dEv-vUhLLXg24EwElB_bXQIDoQh-Mv3eU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjb50JSCc2pUAVXBAtLZEh0GLbRChbKZPHsjdsIo46Nw&oe=6B04876B"}, {"file_name": "Calippo Stills 4.png", "id": "1580342459914528", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824292_1580342463247861_5667675833731912308_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rr1SfqFLzGYQ7kNvwHFrASG&_nc_oc=AdqkzjdEBTLHeL-OCKPtWOEQ6oaOGQl5cJJGWwCnxvAtQy89zS7P2qkLRdUj-DU3yCw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwbqm-QrEtQc_cvIJLF4-pcBQiZUzv_YHxrGu1DSgBvg&oe=6B045F53"}, {"file_name": "Calippo Stills 5.png", "id": "1430269461921797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1430269471921796_4559115927778200887_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3oLzpeJA2MQ7kNvwEskv4j&_nc_oc=AdqZiwR1stEaJ5xUgo-bQ9H3pFzEFSAodH98JNowYEMNJStWablvdICHSNYVD3IXRIQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1vLufwr-fHwyVSIaCC5JfBpAjwCoPIxN8nv5m-Lnw6A&oe=6B047946"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape.png", "id": "2414400088995528", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821682_2414400092328861_4906929329957265098_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcuK4EGNHbUQ7kNvwFiMJwy&_nc_oc=Adrkj795ALdGdJ5wdkxGKIcUumd6ZptoRXgw9FyrNlAxTbOUDWa8z4Zcn0FKf-AOzzg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-J_2iJ-2a1r2FIZNRjHPd9jV7dIBzq1tlRYLU2QnH5g&oe=6B0486AE"}, "display_name": "PAYDAY: Aces High", "keywords": ["PAYDAY", "heist", "coop", "fps", "guns"], "long_description": "Nothing hits like the moment the mask comes on. Plan bold jobs and pull off stylish chaos - one explosive score at a time. PAYDAY: Aces High is the definitive VR co-op heist game for up to 4 players.\n\nFramed by business titan Warren Jupiter and thrown in jail, it\u2019s time to hit him where it hurts: banks, museums - hell, even his \u201cuntouchable\u201d penthouse. With access to bleeding-edge tech, black-market toys, and weapons no sane dealer would list\u2026 revenge has never felt so good.\n\n{749775147955919}\nRoll out with up to three partners in crime. Plan the job, stack your tools, and execute with precision. Every alarm you dodge, every bag you haul, every trigger you pull pushes you closer to that flawless payday\u2026 or the kind of heat that burns cities to the ground.\n\n{1279158540732320}\nGear up and hit the score with an arsenal that keeps growing - ARs, SMGs, shotguns, pistols, plus gadgets like grapple and sentry guns. Spend your hard-earned cash and rep to unlock the skills, gear, and toys that crank your heisting game to the next level.\n\n{1759707558323280}\n\u2665\ufe0f **Ace of Hearts: The Mastermind**\n\nThe brain behind the chaos. Lines up every angle, every fallback, every escape.\n\n\u2663\ufe0f **Ace of Clubs: The Ghost**\n\nSilent, surgical, gone before anyone knows they\u2019ve been fooled.\n\n\u2666\ufe0f **Ace of Diamonds: The Technician**\n\nGadget freak. Orchestrating the theater of destruction.\n\n\u2660\ufe0f **Ace of Spades: The Enforcer**\n\nThe hammer that keeps hitting when things go loud.\n\n\nLoad out YOUR way. Mix weapons, gadgets and skills into one high-caliber heister.\n", "short_description": "Nothing hits like the moment the mask comes on. Plan bold jobs and pull off stylish chaos - one explosive score at a time. PAYDAY: Aces High is the definitive VR co-op heist game for up to 4 players."}]}, "developer_name": "Fast Travel Games", "developer_privacy_policy_url": "https://www.fasttravelgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fast Travel Games", "support_website_url": null, "website_url": "https
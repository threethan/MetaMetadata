4OM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8Ly1wkiU_quWBY54qw6p8BSkp9VjcfDpPOByiXqFwtA&oe=6AF20169"}, {"file_name": "GalleVR_Quest_2560x1440_5.png", "id": "867392892287297", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618472_867392895620630_4506663788960480277_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NZsUKokFrgQ7kNvwE4gs7p&_nc_oc=Adobs1_PYUNM3U-tuUFMiSXvDhSb0tu0XiZYpr6--710ZDM8oKtPM-woMzKaDJoenLs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7lN-RMp1v7LhwLjTC3zmQjXgnUdgBND1_KMPVkI3xxg&oe=6AF1F3C4"}, {"file_name": "GalleVR_Quest_2560x1440_1.png", "id": "1301976455238073", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618297_1301976458571406_149789106916638412_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tb3noTnxlBwQ7kNvwE864bu&_nc_oc=AdpU3iP-Xt9-tPCQdfXe-fvMqtWCK9PPtHTF8KRcIBFbF3wzAl26AVVC0t4x_9r_6gI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvbDJxEQ4xM42bA62tzLpzgjKgAi4kwLRolN8FR47Tmg&oe=6AF1FABD"}, {"file_name": "GalleVR_Quest_2560x1440_4.png", "id": "960881856851097", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618103_960881863517763_4534566312019963156_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YI5Yvc4psSoQ7kNvwEKjOxp&_nc_oc=Adprq5vzQ_tN1WuonZIeRihKTD-U6k5-0oov-TCjkx7i_Wp9QVrbAT2Oe_e7YVKu0B8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlnTfY1Rkw3qIRi2kc5snj-69O7tL4qJl1Qr2gjd2vWA&oe=6AF1DB57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "frame.png", "id": "2635777030139588", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618440_2635777033472921_5322343097023740952_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rM0H1XBtFeAQ7kNvwGjMB25&_nc_oc=Adpu6VNNwNiO1bCkhbxfyGfa2-9YmR52i9GTrvvaYO8aF_Tnyvs4usahDTS_C8vHOPY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZ6WC4JqLqa2gNe6GQz3wyNpn5QKtBNhdz4xWAf4A9iQ&oe=6AF1D30B"}, "display_name": "GalleVR v1.0.4", "keywords": ["Photos", "Gallery", "Social", "Screenshot"], "long_description": "GalleVR is a community-focused platform made to put your VRChat memories back in the spotlight. Built by a solo developer and VR enthusiast, it solves the lost photo problem by automatically organizing your photos into a social, and private-by-default gallery.\n\n**Why GalleVR?**\n\nWe all have thousands of photos sitting on our headsets that we never look at. GalleVR brings them all together. It's the simplest way to sort, manage, and share your adventures, on any device.\n\n**Key Features:**\n* **Free Unlimited Storage**: Keep every single memory. GalleVR offers unlimited photo storage for free, so you never have to choose which moments to save.\n* **Private by Default**: Your privacy is the priority. All photos are private until you explicitly choose to share them with friends or the community.\n* **The \"Magic\" Background Sync**: Our lightweight companion app works in the background while you play. The second you hit the shutter, GalleVR identifies the world and tags your friends automatically so your gallery builds itself.\n* **A Social Hub for VR**: Follow your friends, see their latest adventures in the Social Feed, and leave comments on your favorite moments.\n* **Smart Auto-Sorting**: Photos are automatically sorted by World, Friends, and Date, making it easy to find that one memory from months ago.\n* **Cross-Platform**: Browse in VR, on PC, or from your phone via the web.\n\nGalleVR is a solo project built with the community in mind. Every feature is made by me to make navigating your VR memories as fun as making them.", "short_description": "Automatically sync and manage your VRChat photos. Capture your favorite moments in VR and access them anywhere with GalleVR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gallevr.app/privacy", "developer_terms_of_service_url": "https://gallevr.app/terms", "publisher_name": "GalleVR", "support_website_ur
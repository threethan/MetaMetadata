png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLJaM9FYa8kQ7kNvwGqyliF&_nc_oc=AdoNSu5u89omIKat6IAjlBCGcrLtOQqZKeurdenlmVa2TXnmrhEpyWvw3dz_A1FB6NY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV826WLhg3G4U66qBRk2wGHl5mG0pL7uOjwm49KyD0gQ&oe=6A60D86C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "689845179995120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_689845183328453_919185214266887576_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OZHycfawKIQ7kNvwGPhgC6&_nc_oc=Adp_LWV9k2b0zr9Q-6Dyy20gNm50Ry-A86C2-9KgSFhM-79OVgiZ3RLFCJY4ild6Vt8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlPu7MPUE5aqxNt7_GiqfZbVADLOYOcxIGdREawu3-XA&oe=6A60D0B0"}, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "c
9E0DF5B"}, {"file_name": "3.png", "id": "1889133625171599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2sv5MD9fhUQ7kNvwHQidAC&_nc_oc=AdovrB1YZYlRW1GxClaGiTZCnOaEpjjxKXrSV9O5DUYicd1l--nLN19jl7rSh_qsvls&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nQMhAHWwMaB4qVZP1YihwspVNgICVl-LGUb9zldSxjA&oe=69E0E2F3"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58kbod308SAQ7kNvwHsYRqj&_nc_oc=Adpw6YpHgKMaeGGGuqEsilNz-6D2DxNJXVa2LXJkxsU0rrDdWwYVo1PkZcEn3skbw9w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pZ8IlGjh0a6TJZWd7qKCx74Ivj8cDkTf6Qdw6LPz0OA&oe=69E0E2A1"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16sR2Iomw3EQ7kNvwE-7SF2&_nc_oc=AdoZ6Ud9oydxJA4zTSppukRSJFudjqlhPp9h22Xj5pF3MprsgXoHenhruZI8cI283zs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24L3QOy2GAsrRqKsFcINEgCvoqqAuC6X6GIffuhXUVnQ&oe=69E0D57C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "s
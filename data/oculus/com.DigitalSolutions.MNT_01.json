d": "1889133625171599", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03Qz9G_2se0Q7kNvwH1Epbz&_nc_oc=AdmZk342DCYbHLFxKHR8BWQzofBCnx-zIwETQhF4JDSPrb0WvLT0th_TCz3hPxHZNcc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwXkfzOJ7TRoPl8Gunyfd-bVSbvluF1LUemwQCJmGx_Xw&oe=69AC26F3"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAij0Sa1glwQ7kNvwF9yUsC&_nc_oc=AdlMCmiWMAzrNpIfO_6G4dWlZ46OHfT9u2kNPFmVZ3fXXL53E0bMCT3vRkBhh8pZeEk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx7PRk_mFiF49XBOEiOD1lrgTLtrALoaRyUYC0aJizWxQ&oe=69AC26A1"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeOP4hxzXPwQ7kNvwFKMCkJ&_nc_oc=AdkC6GDPtxNkP6RZmnwz83GPR5oa2SDojZnihpqU2ar4oKGt49qrDqdWDeLV6vP6E6Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxU9suAon3-KGNYWYsLxCd8bBIcI-VtQd8huT3azg6Fug&oe=69AC197C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the pl
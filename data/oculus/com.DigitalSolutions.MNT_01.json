9D7A4DB"}, {"file_name": "3.png", "id": "1889133625171599", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wc-2N3WRwDoQ7kNvwHcFY3o&_nc_oc=AdqnZXDjbvNIZ2cOWRZpZ1IzUCJAkZzOPhqxMcOi_gHNj05PY832_dCPSvLn3fthIaI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3T1iyajASUaSzrbTiKO0ryvzDNkS8fCr1IQekPXYn7mA&oe=69D7A873"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54_hmjgk6OYQ7kNvwFIVIuD&_nc_oc=AdpPULP76R1OBq7P5_GyVR5xcskej-1kWBYe89XPvz3ISxdJE8F55TolYgRfizZxK58&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WkU7GmzGKDniFsYr9phgCYqRx5TLPDxLPFJwCYuGR_g&oe=69D7A821"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QTsG4-rHXsQ7kNvwF-uxnl&_nc_oc=AdoDKd1JKrCmAHykPrBinunQFlihHYr3zqVcd7FWbU_fbdk8xrSqkBjhqkEtSWc5RXQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3USk4YdVe7llIggnqcKDGX-RW-zb_1qDCSzgBdafSHyw&oe=69D79AFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "s
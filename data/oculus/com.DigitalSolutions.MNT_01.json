9CBC75B"}, {"file_name": "3.png", "id": "1889133625171599", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sfZb4-Wo3MQ7kNvwGJSbKT&_nc_oc=AdoNsQdjpbI7hpw011UBVX-zl7LMsmcbPSgUD_h3wahlcIPSkKeKR2TrdQI4OAq5A9o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyFK85E7FFfhqxs-IAJLwx-_o1Sth0hVcJoJrrW-OB5xw&oe=69CBCAF3"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbsrdq0cpP8Q7kNvwFxG6lu&_nc_oc=AdoSQvg09_IDKx0q7pkvcPw12ybg1gb5te27igJyvefjgBLUd9Q8Xidx2f8x_QYHiGg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwyBauQLVgvp7lM7KvFogBvnE0pXRE677wATl30Asc3eA&oe=69CBCAA1"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hRnCYLXoUQQ7kNvwEtzHzL&_nc_oc=AdpmmwRnDu8N7Rlry9CIAEpEL2-kWMOcyp2r9ocbn-2U41zpWvBZAYX9B5GfZpm_qps&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMUXa6bVDqZlwdxhP7n8OUil85ElWrw9jG3Sn3xzPoRg&oe=69CBBD7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "s
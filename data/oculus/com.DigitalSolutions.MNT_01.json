9CA75DB"}, {"file_name": "3.png", "id": "1889133625171599", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBUWBOsZCkIQ7kNvwHFhzq1&_nc_oc=Adr3KafvJ5grKJKEeq4NXYVLma1QJ3Xm5WymRZEpo7SM8g_DsD_hIENRP5PH2Wuz1SY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLcPzRFrXuXZS2SMUF8Q-v-04zZlSBqW-VJ6pU1UeZCQ&oe=69CA7973"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbsrdq0cpP8Q7kNvwFljwuE&_nc_oc=AdokM6lsWmre9q7NeHAJfLn1Ea2G2vUVMNCrDPy5h8C3Gkm5aUftwQzRtlpKFNBUI0A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnbFhF0AXm9Nqv-WQ2qy_SaCM12Rj6hOVc5Hy1edyvZg&oe=69CA7921"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hRnCYLXoUQQ7kNvwFlCFyQ&_nc_oc=Adp_G1IyJf6FT590e7_jZbrDVo_vx5hGmqRmzyMSWbyU9vpTvNDXU1sjt_gpvGuShD8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYjv_3ObY--tqIaxizakAxUvaPCsfQWhp_2gJDk0-k5g&oe=69CA6BFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "s
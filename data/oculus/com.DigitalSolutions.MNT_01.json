9DF8DDB"}, {"file_name": "3.png", "id": "1889133625171599", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2sv5MD9fhUQ7kNvwEsYUO3&_nc_oc=Adr-vSlMSWprT7hJaK9aJL1zL1rsh4XFvqPT187wddkGB9Fd7Yli5KKn8TYZX-V6HqU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uXgEe1QhvGdXpTjzZ6gi7FhJtTf-xt79dUSDRZ5s9rA&oe=69DF9173"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0wA-ypRRlUQ7kNvwH5jMC8&_nc_oc=AdoE_04nBUaL5nDmOBSHVaoIGtnHCccU7uxejDoWE0eBL2KOCM249tBQb4EQgCo4djM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22XQao7ab6-87WegsO-hnXtyQskYudt0SfPojX1wxXaw&oe=69DF9121"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cv485g0PnKkQ7kNvwFlkVTK&_nc_oc=AdrUruOBdRMY73B0ihmHAU_73jmkGk54Q2P-k_huYAE0VxlFh2bZHqvtAjLssKrsI4c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Tp48BmeeBYvqCFKw21iTvyt3LweMTfv6rRZqYouxeZQ&oe=69DF83FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "s
nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUT95336huYQ7kNvwGqNrV7&_nc_oc=AdpMysUm3WhZlHL-AKuPvJVWxwsQJucZ4OAMcySXnKJ__S8Zh97FPccj1B9grOfgd98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXAnoI2gHff96WsvmN9mxXZZFS2XKNkkv2DyH2POtXcqg&oe=6B0F1239"}, {"file_name": "2.png", "id": "757288149579872", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003271_757288152913205_7342296507944513087_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-oOTTPhTxYQ7kNvwHqhhns&_nc_oc=AdpJ5kprGFOhtsLZrVnEKCjG43hjUouNv3sGS0y8G7cMGuzmxiSHwxrE6LA7Fbw9z6Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXbw-lpYAPeRiwqLZfDxpyXa7aHla_9-j6gcO7gsejV6g&oe=6B0F16AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "689845179995120", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_689845183328453_919185214266887576_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTv_vtkFka8Q7kNvwFi797n&_nc_oc=AdqE8An60nrzXf_J8p2l_MHSqzDJ22rOBe3KoKThIJkf_uv8QUvh_86x3cOY_5l8ROo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUFYH1JT54Xg2baD9OFV0ir7q0Q0z165cDONJ5rD5lNrA&oe=6B0F0EF0"}, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7003096893093299"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "928202143448609"}, {"status": "PUBLISHED", "id": "622336123938964"}, {"status": "PUBLISHED", "id": "904545728092618"}]}, "baseline_offer": {"id": "928202143448609"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776157980, "status": "PUBLISHED", "id": "928202143448609"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7182634821806171", "version": "1.0"}, "id": "1562089661254769", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6989317311137924", "is_concept": false, "latest_released_binary": {"__typename": "
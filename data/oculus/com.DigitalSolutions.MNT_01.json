png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yg7bPqPnBsQ7kNvwGOdejO&_nc_oc=Adorz54611a1VCU6rcBNsyTfQ8X28vke3P7Br9KcCiuPvM9zXp29wkqS5sdh0M-4Uhw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uikNElCVGVLC9fHlQeJ7TLsrUFZcMLQzG-bTf7DIknw&oe=6A3556EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "689845179995120", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974855_689845183328453_919185214266887576_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxVEMOOZvMwQ7kNvwENlnVk&_nc_oc=AdoXd9hIh0cgSPKNxltk6eZjfY6IGaSJ-Rp2w6GHDS5vcbfnqz4NO5TMvbEw79W_T5E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HO8HhsMPCx2lcjsqjcu6Bjdgqxo8tcKjcRJaUyFAbig&oe=6A354F30"}, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "c
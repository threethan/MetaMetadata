png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4J3qcE4tNQQ7kNvwGVqXpd&_nc_oc=Adrf31OBQKPjWsv6ua3eG-RlAgM3Z7WKRaQtOfsei0qX65RLph08Fcd4ZHgsHQs_svA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WMgAmg0-M9X8zbQZKVDZHGgA0okKK1X9v70L-v-ICJw&oe=6A0DC9EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "689845179995120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974855_689845183328453_919185214266887576_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7YTKKqJG5QQ7kNvwGUeUo-&_nc_oc=Adoj6P8j8KCMKSz2GnCInYdub5Ke_rjxJ76a_WHlNOAXrQTbjWHuAJ_56ITFBixo2Dc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5geFgwFJO_ZhMY6tpvCY3xmgdUGD-lEgmcevq96srdWQ&oe=6A0DC230"}, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "c
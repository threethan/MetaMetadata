png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QE4QFn3SREMQ7kNvwFoygZD&_nc_oc=AdoyfkmIxbTcmh9tVnRndqDauDSByzs7sZba2NR0vsiwxpWpLxiEX_z2dWjbyS97OyI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1t-zIQ_cWl4BAw1XXuc3WJhf9MzscXcMKZoXl29zbtNA&oe=69E78E6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "689845179995120", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974855_689845183328453_919185214266887576_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ndi2ftC-P9MQ7kNvwFSDwUX&_nc_oc=AdqYpjz9101Z1h5BwsfpJGRjdtz6pruztOYKj1-409yBMzKYQ5sO-OWdp5jjETnn0aY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Q2r5CXMUOSwNvQ1KDaAeQr6LdOHfUQjrh9-v8CSnG6g&oe=69E786B0"}, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "c
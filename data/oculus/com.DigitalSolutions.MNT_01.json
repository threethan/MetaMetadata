png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ksd7taU2DN0Q7kNvwE7g8k7&_nc_oc=AdpJ1erzAQ0jeVRtwSMKD4EQlkc2I4o_u5ahEGzM9EvwI0RtwFegAS7vCX9WtvUGdDE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1451rDSFLCdgGLazGaqnN2LN8DxmrqPdNcBZeSaxmyAw&oe=69EA316C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "689845179995120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_689845183328453_919185214266887576_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pk1AyYWIElwQ7kNvwG8sazS&_nc_oc=AdrWZ75OYSz3L3e4jou9IrzhdRSntSGzNjHyYow-J-_MxVQRgEwWzdALe0v1zcfrfdE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sKSw7xtly_KLU0-taFMng-xmevU6eIS_0EQ5RFFl11g&oe=69EA29B0"}, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "c
9D8F65B"}, {"file_name": "3.png", "id": "1889133625171599", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wc-2N3WRwDoQ7kNvwF1lY_K&_nc_oc=AdqNfFjuywu2FDLkxMVvu9QV5BqNM_7KZbqF4qjRU3cWjXwzma9lWV_HON7mdAGSp1Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DA7RsUFV8E1dDcVv3XdMzgiSwEb_4IgFwKRUon5efgQ&oe=69D8F9F3"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mYv4Yl_QUsQ7kNvwGu6g-W&_nc_oc=AdoRJLd7a_-8pP0nfP5Gjbdht29PH153mBJ9Gvms4iULqYBg7_tT1qQXWJev4S29T70&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nmXp3oFek-g3x_oIDO_3TgkX0CQG9YDgafm25DKYn9w&oe=69D8F9A1"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLZ3WFpfnjYQ7kNvwHpbHAp&_nc_oc=Adr7iDC1qOy-UvNaKLNgTUMCw4yS0q5AuqO79Es5YjuvSuVdx5FT-RdU3cy9mHdqzhI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Nn7aq00rjUf-ikCKw1EUbZpz8zF65BLh82tGaoKPS5w&oe=69D8EC7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "s
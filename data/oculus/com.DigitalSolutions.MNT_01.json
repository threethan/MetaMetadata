png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kykTI4D-3msQ7kNvwGe-li8&_nc_oc=Adp6k_ORC2t06FVXqx4qd3R_I9N7ZJupIRbGsRkDvbfffAWD8VzC-s6rC54PS6eGcyI&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SS9ZzIzqBB5hJ7Z8B4sBCu4af6kWat3xGJ7Ll-21gZw&oe=6A106CEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "689845179995120", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974855_689845183328453_919185214266887576_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7YTKKqJG5QQ7kNvwE4ZIYN&_nc_oc=Adp_xLFFTfV_SDjHtRcoTotcCM0__1nisa5hbjAH1NTiIzEGjRcz91V2Z2pieq0a4UU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53Onw_5r4yrJoMvTdtuLNXW9lgtalMxOkcu-NspCaR4g&oe=6A106530"}, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "c
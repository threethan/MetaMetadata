9D3B05B"}, {"file_name": "3.png", "id": "1889133625171599", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiNLuV8YMjYQ7kNvwG8ooFY&_nc_oc=AdrSlCFP5sM7bnp7pAiYZAo2R39EN3CkMQ9kWFW7vd0kGt8cT0gspweA-DBH7ecTLIc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nvb2Itnocf_86SKM7kMULoRsTWuwqOJHN__uitqsQkA&oe=69D3B3F3"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVmEkQlGQqYQ7kNvwH-KMXh&_nc_oc=AdovdTXkjOrLYYx0Geil7Iqp-WnPn2OpWW6VH3_j2jFnRszM9NzwmTddGSTpCI5ZvFQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-YFl9sUMLvDW0AW3R8rKs9cCil2M2ptCllY28AWHjTg&oe=69D3B3A1"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FF9VV1WOuTQQ7kNvwG2QK4y&_nc_oc=Adq-BmGGxJXl9dwDJ5KVMvDaWkcgC5DGFxe9EHpgDMuqghX7CtnfDaAr-JfcS4dbF2g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1k1bdpSQtbMpp4_XQ_nocOOLuAO0ufeFezhFBuFNBQMg&oe=69D3A67C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "s
d": "1889133625171599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIwgE9nyH1IQ7kNvwGQzMUn&_nc_oc=AdnUQSwf2rFhmeWV2CCj2Wlvq5RDHiqk0IOhO62sTimNvXr-y52jzaehz95FAF1oVIM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyfVfaLdrgpw2MNrvkHIyBn7oEDIdMXVerPDz8WuEHpVg&oe=69B01B73"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkz6cOXzMuYQ7kNvwFCR0SG&_nc_oc=Adksc5dpCKKny6WKtJTRoAXpZn4x6HNd7QiuxrVyNSjn_kxUgwoyckaFCesZx8lwtJk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAf07QGZpKbCQWscndJ4KesB6f7P2p1s5PopSAoNPIfg&oe=69B01B21"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHULbrTEUb4Q7kNvwEgUhn2&_nc_oc=AdnH41r0Ht8pueFTg78lTmvhdvmSbmNTT1yONnwfxaMj7zb4wJ3xPD7sZfoLWJpNJSA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9gudr3XO-GGnALw31kb15DB6XytVsT2w7sw1XIgxKXw&oe=69B00DFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the pl
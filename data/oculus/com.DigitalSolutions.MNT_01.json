9C6815B"}, {"file_name": "3.png", "id": "1889133625171599", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeH-x0qL7gwQ7kNvwFPWXJb&_nc_oc=AdoNtniIQkVfSwXLzNS-baDDmLEe4HyDJE7lxiwucj6M8TYlKK-H-opuOI98Mwwu1tA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afymkh2b0T8Rv74fUUB76S9fRkA_PIoW6cFB35ftJ1xJZg&oe=69C684F3"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBPIwxjc9QQQ7kNvwGLjSaq&_nc_oc=Ado-sjoOk4vyu0mimH4MAUqL2YdEQ769oYLMgsgw0b-LeQ6U05MzoLqyqFNNFcWlkNs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvONyRATAEH5gtjnrx2voxQhUGFfDVD_7bMBWI8t8JTQ&oe=69C684A1"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWWcqiDIiZMQ7kNvwG_G0-5&_nc_oc=AdrhpL4a3DB_BPzkg-dsYWUAKNtsrGdiaHipuQnEcTBfxUzLpb_G3js9BL3pXojIDjc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6iQILnhZPGgL1VA5hUEl5f_AGT0D8LPSbop0-I979tg&oe=69C6777C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "s
25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCxTi9ttPHEQ7kNvwFGwyqt&_nc_oc=Adlh9fqvSoG8JjL0wW0JEHBCApqRDKZUrTeOZ3GFk_sqz3HPbccy46lr3OUSU4pwBfU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afuq0eTG9CfXNgj5lUJ9X80gimsvhXwoUTr0weVke77s_A&oe=699EF7F3"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mkkRc5rm5QQ7kNvwFc64HG&_nc_oc=AdlOUhvC7moFBWxDu1B6uZGyMNBQzBd8KNYroYBPhcfssg7L8aMrejzHhd4hbtyyRL0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsscrVqZ70b2clIL7iJfC-zE2ZwQAp1Wyi3ksT5p8j7fA&oe=699EF7A1"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PromiQBqEgQ7kNvwEQoGQN&_nc_oc=AdlgxMux5B7q6YTAfRBGzggyOE7jrJmtLsg07k58su0yqgZxQ4EYSnjsgxZ_UOtV5SM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu0l8JhJR1R8svw68FRba8mkGJsehPtGUXKOKwHTLCujw&oe=699EEA7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stu
png", "id": "1889133625171599", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVqjB1S2350Q7kNvwH_bGuQ&_nc_oc=AdmuMUbNHkTxVxzzkMs2Qzq_9s4gJN_QZLUqPBWyA9J4FpVfZ5ynxU3QNnUOQlJleyI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfwqXJ3g6qT8GUGF0R9moej04Aq7o5rK1oc-Unc757tJXw&oe=69AAD573"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAij0Sa1glwQ7kNvwFaxmqA&_nc_oc=AdlxHclG6KeHpnnpKGPR-YvjUcFWEefrhWgcZpM1nz7_sArOVq7hUfoWdNhjfIfpy7A&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzcOcHe6asOUXb04NM19iIKw_A9M2ZW0Ux-Wt8_R-pYrg&oe=69AAD521"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeOP4hxzXPwQ7kNvwHK4iD-&_nc_oc=AdlwO9hrjDh7PMIqnDoqd6HbfD2UN_k4O4CMy5kxzPxXt80icuhKOHoelx5LryovGFY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfxpM93q4YBpYKnYfwqcvVJdDLc3HBQ2fCbwGWxnSsXCyQ&oe=69AAC7FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused
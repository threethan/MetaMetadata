9DCEADB"}, {"file_name": "3.png", "id": "1889133625171599", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=es69lfDmBlkQ7kNvwHP1sWe&_nc_oc=Adr8Jqc7Ytfn3GwBu8E2K5iJ7qMec6li-h2KLmukQdd03yJIEl9oNbPmQR27Cqi8z0c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BGA6eck2EI78Fgi8b_aEYq2_zDPEaZpllRkCvv8SUVQ&oe=69DCEE73"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0wA-ypRRlUQ7kNvwHzrAQE&_nc_oc=AdocMUWWhjUmkoHNyr6NG2IXYbKBX8cYiYDUEaikX6g5LtBuFr6y4dX-xQTzxRharxY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PBqSjMypfq2EC6n8mlJDhMo5rZb5fS61X-UzQ4OJpiw&oe=69DCEE21"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cv485g0PnKkQ7kNvwG5DsB-&_nc_oc=AdpqtNlIhgcZWGKBWcQPN6cfV7sTQbQplWu-ehbiCMSqgEITbSrcgBLo3l5P4BzVGHM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DVcno9MZFtf3RBibyqZsuTxw_UAuxoBQSk8a1rHnRIw&oe=69DCE0FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "s
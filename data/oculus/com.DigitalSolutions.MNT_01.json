25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mz0sLcGWkhMQ7kNvwGfiS9O&_nc_oc=AdkEST11uufQ_NN9j4uzdt0T53V1k_1cUGzAKKiOEhIuLOmS0pNAyMvX8ZVb3cOw7U8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afv18_u5SY33iS5wWXdWL8Ip-yjnb8ykFP6J48VdsVIpaQ&oe=69A19AF3"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOOXHAQoUGUQ7kNvwFkLfef&_nc_oc=AdmOfCpNmSRVpuBQ3ygqxHstM4yNg0vApmVudP3nrNqtw9vEgri9U1qYjZJbBLyIrz0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfszHMnwQtNGO_OLwxffsymmaIIy3Kg33S_6Ho9a_2IYXg&oe=69A19AA1"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cy-bYpG_oQQ7kNvwEyvwMP&_nc_oc=Adka4OWe5hWqZmWQkHilS16E6Zs4b1c7mxx_UXaoUp2N0htJY4JgCHexU0_F67EyP0w&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftxXQr__Nlj2iqywvhvwGIAZ8D3YPC65_HrQYBB-nBMBA&oe=69A18D7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stu
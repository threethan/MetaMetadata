9E3825B"}, {"file_name": "3.png", "id": "1889133625171599", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVqsO6jb2J0Q7kNvwHklSpU&_nc_oc=AdrS_OhRDHbmxNn9CdDfQkYM555uMxDD9gsFXKjm64qotfZqcff2a1P9ai_DuhoTlT8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2j0JXcuzE6QP6ZokQxLX25c-f0FTc60EffhI1EJN9BVQ&oe=69E385F3"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58kbod308SAQ7kNvwE_9rGD&_nc_oc=Adoodq7kn-IArWXmlgQI48_Q6yskuydjFruO_rmkLXlJqQrFqo_uaV_ymTMxgaxlOaI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Bfvdc223qTUfHPsdy2EiwDCzDsZ69peeS3DcZaNto3Q&oe=69E385A1"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16sR2Iomw3EQ7kNvwEIPoeF&_nc_oc=AdqSCWVVhe6wqie6wmZRemuVHMvQ_Op5kdpGM9LxyZ8SMq-YvJc2pYfkyu_fKOGGNNw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YHuZ8pHZOXgF5EQRQ6R4RO9mYuHNgghVY6cKub75k7Q&oe=69E3787C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "s
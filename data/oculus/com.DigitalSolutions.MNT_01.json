d": "1889133625171599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9wRuKJCjkMQ7kNvwHC5yAi&_nc_oc=Adm73CPY8mSQ74g3N_jbOXmbNljokpx6h3ActmuNgQTmVtHGebvJx_yFLmmvFJd5Cvs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3wldPSqX1fsvkqT6Dd_cXFYN3m29NZmDgTSubir10_A&oe=69B56173"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esEm9O3ZOVgQ7kNvwGvH_O7&_nc_oc=AdmoJsl3grET1dsiICsXWiqkU830R1jPsYtuUQCnkvcI2mOdXsHzJ23_Wnksot7AZ7w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy25Q7UezqWLChOdRh0w3rpa3zDuecWnh2GJBSoQwgmtA&oe=69B56121"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3fd-Fb1GD0Q7kNvwHBWquQ&_nc_oc=AdnOO8cWw4TTc3rAspA205voEOHYtcOm2zrAiBiagAeYXKm0NgHqsIJH6X2-CUSZG8Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzUYSyLZmWkx8MHG591EDKo60kVQi4kA_PhVOELlJBEoQ&oe=69B553FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the pl
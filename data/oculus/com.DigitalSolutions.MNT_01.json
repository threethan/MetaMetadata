9DE3C5B"}, {"file_name": "3.png", "id": "1889133625171599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=es69lfDmBlkQ7kNvwHCukjj&_nc_oc=AdpZ0am8EcCUK9XHtUokfvc9wKEbswlxqXTxD4WibgoW4SxkgrS1G_GfPZjucuBBhZ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LjUIG-mOBCmE7JIKxkqiW_FJK46BKcN4FNjPRVKABJQ&oe=69DE3FF3"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0wA-ypRRlUQ7kNvwFnJi4O&_nc_oc=AdoGEwHpSZQz_zu2KaJBP1MuW3cx57bDYh_AjlGCyuSNazzCVqY0FYFpE-ypIC6cM5w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18vvQzk0A6SnqmrkJcydIm6Xubrp47hxS7fwcThSM0JQ&oe=69DE3FA1"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cv485g0PnKkQ7kNvwGafFSB&_nc_oc=AdoOQzO0e_t5S0kUeoA86dl35_dqht8hut3keElNTLC0zW8UtDMaB_FtvTESy6LunIQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Guo2GrVz-095LZvi3Hwe0nDR_JUh4G23Y0sNduJmpQQ&oe=69DE327C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "s
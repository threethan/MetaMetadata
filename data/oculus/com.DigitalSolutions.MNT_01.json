9DA47DB"}, {"file_name": "3.png", "id": "1889133625171599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wc-2N3WRwDoQ7kNvwHXjSRs&_nc_oc=AdpESpb1thAv_OpDKwbagfHN8jF98sR9lGrc2CNkQDEN7CLzGgVRENNvmoDRLdzoxZM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gWMGavCnBlHzb0N4glXJ_1G6BXyclMeDhJCjYyAiUPg&oe=69DA4B73"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mYv4Yl_QUsQ7kNvwEhLE3i&_nc_oc=AdrOq3YWqEOU7q8CHbBv05qytTPhXPzLQ34HjDxbskbMv2vWL-Ksb5XCnI7xSasjilo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cYVijt3bo1dVT7g97WQWd_BPWXRDdjRRr5UMs_y-mqA&oe=69DA4B21"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLZ3WFpfnjYQ7kNvwFLU09T&_nc_oc=AdrGLdb5DRyKYjPwhSwh1jjO9dP1AIz8X-laPL4Rur5cpS9WncY-NPhMTGBmZQXvUu8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15NNVBqkVshrhRE1S7qwLL9v37Solf3xuxx9celFDBuQ&oe=69DA3DFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "s
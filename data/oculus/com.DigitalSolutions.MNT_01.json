9C28CDB"}, {"file_name": "3.png", "id": "1889133625171599", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcmLXeIWodAQ7kNvwHXrANZ&_nc_oc=Adqn6PO0ocWIyvP9LekDmbgVVjG4tb3i50AqDU-FY-3vlido3LzjkWMKx1hea4vRCsw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxcoHdYY187ykKAtaabBaR1LDMdoIDvDTpMnnR5aGSlmg&oe=69C29073"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIQzQG4pYlYQ7kNvwGQ-t-W&_nc_oc=AdriNG49fB_QIZ0aj3KiiG26K6twQCOknjBG8FkqmWLbpMs2lO3QgssZxrYLd-PBYcA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxjxSHLVDvsMtSo1TOdraip8MnLJbnElufIuN4Jp6xjPg&oe=69C29021"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcKPBuPiMj8Q7kNvwGk8Yhs&_nc_oc=AdqPNUMd9cjCcpiTzIgWeopt8FjnrR-W4MRbVDQygewzW4SWEERHI-WR6GO8LNZH6G0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLbV7K4hPWYCf9n_lJ5ru4WFUa63KaVdgbqKXz_giVUQ&oe=69C282FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "s
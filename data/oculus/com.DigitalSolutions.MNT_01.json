png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8ATskMs7LoQ7kNvwGCC751&_nc_oc=Adq-12FR_CvsbNs7FMujjCUQrHW0oSygfrhsseCuaKBNd6rALx9O4sFj4vtaK1zXohk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNyAeoIz-DOjFMnbdqCnp5lu-6JQqse0NXZsqwCMngGw&oe=6A8195AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "689845179995120", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974855_689845183328453_919185214266887576_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76DLtVgHhbwQ7kNvwH1gbmt&_nc_oc=Adrujtg0H2qWX2w9C6g-zJAw-u-2s_gsSSLlUgkAAwO605y8E8sJp4Hwrgf04PHc9Dw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCFmXL5ie4EOwNVFHM0fZxvHJ7AaDsF3HQb82z9mUBQg&oe=6A81C630"}, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "c
png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RR5s0ozLJb4Q7kNvwE7v8ak&_nc_oc=AdrpHRN1pSDlJmVxbKhR8WnjRK8lalCdLuq4mMI59p6jY_35Tfx3Wuhbie8OnpNR3Zg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqRMjjitaGW02N7BiULcIEHptWYDH8tdISSVAK_oUVjw&oe=6A6CB5EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "689845179995120", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974855_689845183328453_919185214266887576_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWLaNNj1qKsQ7kNvwE5fdiZ&_nc_oc=Adq_s-zk7JrYHRjUuvJm7KsqX_Nzvd3n2MTYJn2ORu4vxQKGYNpLiBftCNi3Jzqs8cA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0Nj87r5rVsXtwqwYrDlN65Kfu4WnCjvUHfORRpaESFQ&oe=6A6CAE30"}, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "c
9D25EDB"}, {"file_name": "3.png", "id": "1889133625171599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6axOBnYtFoQ7kNvwEn1QCo&_nc_oc=AdreTogdHe2MJzMVMVj41BFyO2ROzak3y2V-33qbgj7OxYdK_IMQqJCFwwDJFR50axw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1m2Syh8bmB-Xazlb6PHp-VWdEhm4S9nfCkApVBQQvPrQ&oe=69D26273"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVmEkQlGQqYQ7kNvwHltVp2&_nc_oc=Adoox3D1B0SOBDokrnQdPcfLqxJWDnEbrxP1KDZWWPbJ2xxYHkM90ovdnzPCxv6Ly2g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iGkHltjf8uJJL8NAiUrcVOhyPJp2DTQ4WAP_k0ACKpw&oe=69D26221"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FF9VV1WOuTQQ7kNvwEDd8oY&_nc_oc=AdrrkrdDoVzTfcaQ7Gx2V9l13GaMvXU6DAVdAGu7PnUVmotE93dhslmzw6K98baBPZc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yOYq0t9oHscZyAdjwTKwjaDy3iKGjT_-3PCGP10-n1Q&oe=69D254FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "s
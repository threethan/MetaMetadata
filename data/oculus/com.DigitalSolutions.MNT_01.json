25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbZwWbwfZSgQ7kNvwEYrPLj&_nc_oc=Adnj2hqnEq2KZ_9CNEPkUgBHgGYAaLPxTON-ndiGj4NWUJ4o_5Ksh9SOzcEA01RSgaw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsZBUS5ukaPWc2j8oG6G2DmmKuZ4setIJwVfbeakFmWnw&oe=69986073"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viU2wFDUdV4Q7kNvwFhv8WT&_nc_oc=AdmG5LqUm-au-ewB9wNpIv18d0poRxiJExnqrqvtmRrEc4wTeKZFElqVqAb9cjbDVmI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvqBgol3uriHwwJ-C5_JaDH2IX7xi40gJTjDAF1QaBTpA&oe=69986021"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VF7KG0XDD94Q7kNvwGAI3UU&_nc_oc=AdkBOCZ03FybTFu0UtPcaaxFEywo8IGUtSlyHVmLeQU9FGjDajNXlEXonu_EtTrMf8o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afu7LfpxeujXDKgy8m3BZdAuDaeG21Wy-Bq2OYis7EPwfg&oe=699852FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stu
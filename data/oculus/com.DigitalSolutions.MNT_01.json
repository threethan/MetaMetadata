d": "1889133625171599", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDdBkWpGVHEQ7kNvwFP25hP&_nc_oc=AdlqEKRloSLxUYPLuALsLc1hAuo6GylqnVo7aznq8d_yO3-mBLVX8XbobqnGVfC3Wv0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyTcWeF-HmCSHP6TWi5GT0vWfDgYmOZvpFV-q-UMk0-zw&oe=69B80473"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esEm9O3ZOVgQ7kNvwH_46Ai&_nc_oc=AdmqKxeJd7akhZzkP6XjaLM4-nPEyxgZusCmR62VooV9Z9o9wtIFWw6EZszTEIETwF4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy8TrzlBq1KZUVH1uBP2KcNLK8QCAr8VOZQ8yQKfR4c2Q&oe=69B80421"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3fd-Fb1GD0Q7kNvwG0K6Kv&_nc_oc=AdmHROtjaYTxFOzfvnQvkrpYhL5L_rWIR5ATP0v3MUbRpuHNOp7UMO-QCv51lQow4mM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzTPr2x94k__bxAbCHXrVinXMaKaKmwNjetgJ4fyJFmlw&oe=69B7F6FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the pl
9D6535B"}, {"file_name": "3.png", "id": "1889133625171599", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiNLuV8YMjYQ7kNvwEPK6mM&_nc_oc=AdrB8ASlCVS8AqN42nJwAh-HvNGZXMJZvVy9tlp1xAD0H8r6uX_iWmVtG-pK9LAMBS4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22TBuwafQHwY6EiAhblhSYu0Tl0OJZEDs_FNvKUm9rkQ&oe=69D656F3"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54_hmjgk6OYQ7kNvwEd7Ps2&_nc_oc=AdpqVftrTOB50GXAJH6gvR97VJUsa7Y-E_0Ivw8ruwlXERv8wtjz3GDoqORrf_E6LAE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BqjeVXeq4VfPh8GZA8W-NPvkbmhaNM8kyzWFGwkOoNw&oe=69D656A1"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QTsG4-rHXsQ7kNvwFO5M2f&_nc_oc=AdpTr8C8Do6m2RpU10aE3kWGYTN6Dgzph_aqSlEiTjQw5MEmuO7_m5Rpdge-1P5V18c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DQ2-lUkkeHvG9WN56u7r3BpGs31MZPdahiA4OARY-Dg&oe=69D6497C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "s
9C52FDB"}, {"file_name": "3.png", "id": "1889133625171599", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeH-x0qL7gwQ7kNvwFIy5Cg&_nc_oc=AdodfMs0g2W_YA9xJYwEoYkbrNRJKbgohSv9S23OGwaprQAiTs1Jzt26RjmccTU_nK0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw31cvrM8ap6FM_YEhCWgErsiyeA8z4_SXiz7BNBrzurw&oe=69C53373"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBPIwxjc9QQQ7kNvwGEGB79&_nc_oc=Adq5YXb2ZOnYzvb6o8JGEG31Z4VtOQGFIFsvQFqHeSgaxKMkhd9bMiACfC998u_Jawg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7pwy9jMradXs-STomM2pr_YvaCmLUhxbhXKZSdPw-qg&oe=69C53321"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWWcqiDIiZMQ7kNvwH8wm9H&_nc_oc=AdoO7HxSp4Hh7sETnGFoEaZdZKTZz2FhtppIfN6jqHU55gNL9krH5EJudaUTQ0YUn1w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwR_D3H-JtybdfV_ZraVRCootxVlTevmH5bQp1yOwCr8Q&oe=69C525FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "s
9E230DB"}, {"file_name": "3.png", "id": "1889133625171599", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2sv5MD9fhUQ7kNvwG-VCUS&_nc_oc=AdpnaXy72ufBeO4HxFNZxSqXGbFl2Ah235mv6EoE0VfG8hEtVcKZZpOlcJVCT2PWJho&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_bC3gc0k5iIffSZsb8r9pmHFxS2B96KKuni1OdgNoVw&oe=69E23473"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58kbod308SAQ7kNvwHPmmu6&_nc_oc=Ado0FWDBjj0zH4i35QNkDxo9P5ZKLPrsQYp9xNPbS29gXnNCP5IBhqwvvKI7kj3r1iE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zF29N4NSjZL3co9VW5xrvEvlhosJXVD0PYk8JErDi8Q&oe=69E23421"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16sR2Iomw3EQ7kNvwGWULZK&_nc_oc=AdpQjysO6wRRCouylfw9qgqltabiy9nisFAxIW3tvXIZ8OYzE198F9SjgMzLfJeDCv8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Bs9cEf_F8r0gotWFeAwPahfHfKd2DMOUS9q_u-2Ak1A&oe=69E226FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "s
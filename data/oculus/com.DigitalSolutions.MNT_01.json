9CE6A5B"}, {"file_name": "3.png", "id": "1889133625171599", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sfZb4-Wo3MQ7kNvwFZwYvn&_nc_oc=AdoCGYescDfGNDX7IboI5SQWtkS6QCl4qKHWZny53QUdY-6mdZ8A1GXDKzL4zCVh9uI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtN3UWMqdDMYQrl8qrI18bB-SJu7s6nnDvqZogXNBE6A&oe=69CE6DF3"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odbTxRNSGYsQ7kNvwESvsN8&_nc_oc=Adon1Bssda0RwdEv7aqu-LjYBOYDxacEFpqXUMQXmHIgEKKF7J1Sssx_ylzPTlE730E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzyeGjeaP_uLvXQ4_DDaQhkXidf6BIXmMuwg5j2KYg5GQ&oe=69CE6DA1"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NcqJVSk3ioQ7kNvwHHF2Wr&_nc_oc=AdoJVswd5WVdtSoYzEjZ46GjMeQkFV0rsehF9s5_I8LbncL2zAXipfLlAxVU8WBcKNA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHISHoTTEkhpiWU_SYt9beNaWSfWMKLL0LTHsZq9qGyw&oe=69CE607C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "s
9C7D2DB"}, {"file_name": "3.png", "id": "1889133625171599", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBUWBOsZCkIQ7kNvwHnOc1D&_nc_oc=AdoOhTHpWrQ8h9KjrSvGKvvM_Nfz4n2L4WKbtYXzyTjv8gUe0WKc5aAjnMNCqbSgUdg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwL2dRJGT2v4SePjQPWTU5v8tkmr9RbnKaAZFjrI3lE3w&oe=69C7D673"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBPIwxjc9QQQ7kNvwH2FNbB&_nc_oc=Ado_yyY0QzHU1WalyZcgNFIhI6Nx1fA_oBrXQMFJ5EEVvb_nx3CIK_K0X_pkrK_BJaI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKzAEm-xFROtjiKY0-Ra5lMNn8CxScHsErvXdNqaX-5w&oe=69C7D621"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWWcqiDIiZMQ7kNvwGQwjrt&_nc_oc=AdrMz448Z6h3HVfWtVBbo3xLYQZlOTtWxCWiUjkcDOPR56-QzDJYPemay_waWu-CGFE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8wwYtx1lF5-v8Rg7H4jTegaml5zK1wMgJNCJBQg0L5w&oe=69C7C8FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "s
25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCxTi9ttPHEQ7kNvwGbL9f_&_nc_oc=AdnPzvcfTqaynh1QOi1gPdDXuXgEESzGk1Egu3idOA6n6IRJCKQN0CGuMPfCS_lS_I8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftxL5DYLaRvp2CnTQd0-_HSUnrWlfM2VWhtIbC2LZmqSw&oe=699DA673"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mkkRc5rm5QQ7kNvwEEXTpx&_nc_oc=AdmkEukhd2uZIPuiJGj2FSQ8ycRsIw5McSABbuk2BIq_OEhn9TSWn5J1YdI5UHuCwL8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfugGbRmOlKSrUsUvOduZMBNQT-zAdp5kUrdTat58eBO4Q&oe=699DA621"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PromiQBqEgQ7kNvwHcBh0d&_nc_oc=AdlhgR0czsE7LHAP-yS55h4kVFow-2gmx4SIFWj1KBiAiW4BC2I7sRoDmw37XPllHew&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuRwAWxnlLjwPQTKf6r-Nts2kHSL0nhviv8dSQHcI-dBA&oe=699D98FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stu
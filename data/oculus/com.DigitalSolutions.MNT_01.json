9D10D5B"}, {"file_name": "3.png", "id": "1889133625171599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827786_1889133628504932_7831113039281475214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6axOBnYtFoQ7kNvwE13d5D&_nc_oc=AdpB5tENpGoVsU3tekI7g5keT--S4UX40v79zTXgbOuGiD4z0KFgHuWu5zXzGG6fpw0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2VrExM4FkaM6kchmvcMkpSJX-ac3zxMv-ZOaJSLyeMA&oe=69D110F3"}, {"file_name": "4.png", "id": "703314155392207", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391964_703314158725540_6971951890739665815_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVmEkQlGQqYQ7kNvwGMXX07&_nc_oc=Adpzi5V3jOZiax8ohRAtobnPddPpJCt3cvLxsm5aRWqlmtEz8XKIk3OyDnDPYC2aj7E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzVVvPN1Uumi7y7Zhks86buonbSUZdGTbbWjL-ofIy78g&oe=69D110A1"}, {"file_name": "5.png", "id": "669108729356889", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391915_669108732690222_6412275602623748326_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FF9VV1WOuTQQ7kNvwFyADtr&_nc_oc=Adp2rTmAmc85k7-v2FERWNbqV3mYHkz6rYjyIwZ6DQoAlBVy4ywI6fE5ciTKIXDForI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTyJWT2ipO1HS97JWbeUWzIwOiMxLXHosBu5-zdOXY0Q&oe=69D1037C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "s
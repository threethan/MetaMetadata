h5i93XUe1d20&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkmpAJc86ESQmygPa63REKOLS6g9JyCM4kWfQtsJugwg&oe=6AAA8D92"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsnNZgwH1RAQ7kNvwE0ZMMh&_nc_oc=Adr6cZmBDb_IwcS1LSaGlW99-C97LMnJTCmclofPGbNyXeYMZhfAaa8NVtwxPTLlTlo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMUzVmimaKpXqlB0D3O5kBmCZ9gl-LV6AXXvKCfnAuiw&oe=6AAA940C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FaHePiJS0HAQ7kNvwHJJ44W&_nc_oc=Adqn-yYMhLiKIp2DXueTCYYNFeFMRpQFtgu9DT7fSwBl7Kb7kl6gQWxA74GNkQVBfSo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDN1o1k9eRVkET8am3dwmxdT0k1ZyDHqEHihYJhNu_0Q&oe=6AAA94EA"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
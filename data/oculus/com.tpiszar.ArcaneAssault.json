Ji-jQWtp6dtY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxQxPY8PuynfFbZUBgfQjPYlqKr37BQ2j65pk8pznzYg&oe=6A942412"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmeidRl3XgAQ7kNvwHKjepz&_nc_oc=AdpjY7iucZYx2Vhp-pS1V4R63BtBsHaGg7OwDB8AQ2CGw1HRpaO7BX8habai32-lqEI&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHI72L64A6zZiZz6Uj21Ia25y2zDa-7jsAtZPHAZnwtrw&oe=6A942A8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KppqzuL6a_8Q7kNvwG9KBgJ&_nc_oc=Adpv8CmU_Z65uWahrdMWohpWjLFnykFh240Blk8-psbHclamyfvidLHzoOyr0QI-4ns&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8roJK5qIGAgcy3Jun2cVbs5rdEYATU72pi45a4Vd8Sg&oe=6A942B6A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
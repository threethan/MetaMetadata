jOmNxk7Y6pKE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkAXk3N9LnR7DxcJKicqHP1QmW4doNLNxxLoNcCRcy8Q&oe=6A54DC12"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dseciHqKW_cQ7kNvwF42qKJ&_nc_oc=AdpQ3Eg8sdv4zdWQzys1ZOdYOZBW_eQB85tds_58hpdHFopUgTCpU0b4fY-UZr_kXrc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWYirZ0J6s9mUKnx8W1oC0SzS0bs3z4lKCMd9Gnso4qQ&oe=6A54E28C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hu_T1s31ZcsQ7kNvwE-1ysa&_nc_oc=AdofgTorwjiSxHeSdsBy2P6X6bP8indrDKB8njWNsoKunFrXy7Tslrv5tf_TuABF350&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNk74Sj0_qycTj3Uh6G6-ItICSD9KUBLP0N3xc2mh7Nw&oe=6A54E36A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
4iOHAgobGStI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mwAIF46ByReEYq_tfA9IV5YQYR2F30vLoq3LB60djRg&oe=69F9E492"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmFM0lot630Q7kNvwHBIoc8&_nc_oc=AdoPem8h3qiXGcy-0-G17RBjBfEWV6SmqmP7aHKbpwkgbkm5YyGzCNsSvFj5Oqc3YzQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Fw-ei-l9NN78-HZMNp95d8KmzAFCndy4-BoVCovx-eQ&oe=69F9EB0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlpUeLqreucQ7kNvwGBilX_&_nc_oc=AdqSIgG8_JBkMoT8zQz-z4WZ-q-MeGxwOCWgmGI5cIcmrW-Zw_mMXjwFk49SLaXsj6M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4D6JNOU-kTiSQmWHq6vSeCTZXPdie4sF3XGQRpptMGyQ&oe=69F9EBEA"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
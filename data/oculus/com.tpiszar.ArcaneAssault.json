7QKoyhzPzKqs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFur9XPGSoB5K19GP2IhnWQDVBTxPnHNwTxSf8TyEu0Ig&oe=6A772312"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rjhyjc5NT5wQ7kNvwHtR_3o&_nc_oc=AdrE9DSYSFF3kcYQX8J_Q6Z8_C4rVTqqBNvYqmokLZJClfLbMbj5qrfMMBl5wrkE0E8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzpK16I70YUpgPBmjT5S9em7nM4dwsAQ_Z5kvTLxqbxg&oe=6A77298C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLBCiPqqGKwQ7kNvwHNppNv&_nc_oc=AdpNYVuwwg8HZQtApf9wjzR2e3hj7N44NI0p4slC7kifV-XQPv1DRwH2INoEfNu2sHY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDNdoqLX77EQZkrQqEvUIMBjjE-LMDbdAW67WBd1wnPw&oe=6A772A6A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
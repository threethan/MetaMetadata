cDeDh0J2eXV4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzNwfDSHrmA07EblrePWnEs2mSTf1KKMKUZkO1FQu0KZg&oe=69C67A12"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2w3WNQyEqkIQ7kNvwEiMoIB&_nc_oc=AdrRlfEENRy8vbfSVy0i258OmLW8R-1Mjv7RSHk6MGajY-dyqe0SJOD2G_Ii595pQm4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxg9fOcZUEf-LyN1ZL4ViUbZYQpiIUs4Syo2mQkkLxPpw&oe=69C6808C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=077jK3BkBgwQ7kNvwFoU8Xl&_nc_oc=AdpVXxV0tnIwm6MQ4KXnGzhULcAxCGnOVnKYlBRO5fFAzB_VaSDV4PovUe3HnrpJWVg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxXHJ8IqxVk615jtjy3SJYXN2q1jn-j1E0KGjmMipNZpw&oe=69C6816A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
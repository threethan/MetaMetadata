o4-ADGeyV8YE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yi_aGwe6Y8ahRss55uaETFWan3ZNd_QjcMoTBN8aNug&oe=6A2EA092"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRS9V28A7ToQ7kNvwEWAL0O&_nc_oc=Adr7DYRTmyivO6t0xagBjhFJ3jDD8HFjYEqABAaIA-gB7dTT9YKP3N2Ihu8mc1TsIgg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RFGwqHP6bIp-gXxk-uib6NakvBKQ1PyEPHI53kNyALQ&oe=6A2EA70C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgn5HhTxm5UQ7kNvwGZygAY&_nc_oc=Ado_PqV3ImCeUHrdqKTU36DaVB4EAINoxW7pSMlBL8w6MYWmv2GxK6FF_gazciOKQ60&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JbTSaFn9dC2boSpEe2pLazoH_4MfVZlplf6ZDINwStA&oe=6A2EA7EA"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
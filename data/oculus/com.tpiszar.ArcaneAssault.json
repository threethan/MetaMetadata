wu2Uwd-56JpM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwrcQOhoYt2nzY_Uup4NRFVjkDzMEM_kmcLY24rQH4lRg&oe=69CBC012"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UD76WsrVlgoQ7kNvwGmSiuJ&_nc_oc=AdquSSqgHKJ_5bfp7Qloi2wpAAJEt_-Em2WfqRbDzgyEQG0u7QJHKuHOurWRgRupv4k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxL3zdE2AwKorWvFizanG3UcbaX7t02jEpA3EWGTGURew&oe=69CBC68C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QX1X3KcTsT8Q7kNvwFHgMMD&_nc_oc=AdqXlQzrdm54C_LFJFrbzzOW-aAPBhVOmnUKKQoX-tO8DdfH4qr2zLQd7l7wA04X1TM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfztPzbNNeisaw9QLGTw03dRyyGmMn4nu9VgiuARaxv6AA&oe=69CBC76A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
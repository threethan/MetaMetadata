g-0LTU-VyK8c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBh5UTrhYjBngs0O_C1jAvV0AglRsbUlmLNsEwVT1noLg&oe=6A4A5012"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pS-K6Ed4bqcQ7kNvwER8Ekg&_nc_oc=AdopZY3ngLYUcZ3AVuTVUiBOPnuSjui3xpCjJ8YYMk6_jm1fbphZXLlL2mUX1TnKGIY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyu7JpeHVejZ9Elm6-QC_T06qoIpcCpLtITJrFoVPBog&oe=6A4A568C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhnvkZtyA84Q7kNvwFozvaB&_nc_oc=Adr3fgk7M2HE5V8-TJRASYTCmGvv7QHNR5vtEtdyBHLe_1B3utcQ1GFfDfR_ZvX_bZg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXuiLIePiRzZPGjCrJ42e4ENbzr6LlKy5usOzg_rQ_yA&oe=6A4A576A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
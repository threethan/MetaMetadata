gqC7Eq4I6ep4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJKv3xpMdIr_0m4u_udrqWCST73U2BN7POLOIXxYmyRQ&oe=6A4CF312"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdYJ2Kn0FzoQ7kNvwFHEDru&_nc_oc=Adri_iYGMCFSDtKsaJNwsdDBeNO96LW0O1_uq8NNvnc3xffh-gGqZvZ9wqMfKUQh9Ms&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgGOxf7eD8QLPBt_ySEisnTpzO1BkT80lam_lOkxLh9w&oe=6A4CF98C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhnvkZtyA84Q7kNvwFZNjhm&_nc_oc=AdpQ18pXGFDqTvABotbUV5zHrmNj1TNh_40gQJ_wU3616J5KRb8SELfPvuyLxhhwimw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqUzrFtcd3X3nP1Xli_e5PbuX-Adp56R4jObS8VY9c1w&oe=6A4CFA6A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
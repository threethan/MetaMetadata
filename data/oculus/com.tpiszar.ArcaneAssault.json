80gH2ue4llQ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3oo0rh6cb_BHq8dQULdefB2SQQML7lLlF7-4bpE75Mg&oe=6AA54792"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tj4MMYvDEFkQ7kNvwEeFsZs&_nc_oc=Ador_20jp-aEAylFX-s3Mcy8sFkkzwIVUzbBcq11pvAzb2oyRKFedWDY3hPOZxvS_zc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL28MFgXTq8wxIsLiz69HrpDGuSiynX7ywjdQJnTyRkAw&oe=6AA54E0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BcOifRpvAoQ7kNvwHfsrlS&_nc_oc=AdohVWR4IK3c6VGLofidr_WaYFKFu1xryFb4qIwKs9sWQmeG02FhKVbgveF9-u0zwbc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrW0nq7o2Clu6zS72ISPxrAGjG325PJzmeuAlJRAsb8w&oe=6AA54EEA"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
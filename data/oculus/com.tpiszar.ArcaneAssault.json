BPSSAqBWGEv0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JwKKV6Pw_10oVbQKUQ05yYMy1dkGdgtRPz0JM7vdCPQ&oe=69EB6412"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9_QvQwSuNQQ7kNvwE3cr0I&_nc_oc=AdryiALAP28a4dkjXT3J330JwAjdeQ4K_cXrCdOnRAqNOtQIC05pJqbQEagyUYf36Vg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0X5nOn__INeehea4Cffv9klmwgmYLqFviYTVaVUAeFYA&oe=69EB6A8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8kW-jx3F8MQ7kNvwFGRh9H&_nc_oc=Adpv-Kb9eBKaDXY6Ih1C-Lv6LZuhPSXG2xcJx2ijYk4AXTLlrL28ZzHE2vw0UM7zEQc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22cF6wDUHxWGHktON2Sy4h0q90_uLiBvvFbTKTIbNG7Q&oe=69EB6B6A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
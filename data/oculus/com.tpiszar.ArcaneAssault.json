xM8omZreNnUo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZLNN304ieP27kxOo5Ryxw78Ye0bKFsX5zBEtI0D3H-A&oe=6AA00192"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkHa-nmtMiIQ7kNvwFRz53K&_nc_oc=Adp284AccYm781ZVNk7FQGoan6qZzn2XxoGhDv3Dah01SoEypWAJhqhgmSosG63hDak&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaqdhakg9lEKR1LnIPVAnb0faUVgv8NK0dtRknX_UxPg&oe=6AA0080C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFuuEiVR_p8Q7kNvwHCL7sE&_nc_oc=Adq2tbrmU7VeMYLZYOWdq-XbwzNNGZRS7mulrV1SgEBvDqy7N_EO4QjAjZtEvhRYvIs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbjpts25jtM_mn2YNZey5e2XCXoxPYl2wSvRDstOqWVA&oe=6AA008EA"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
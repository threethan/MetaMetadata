pU0wGlJPex1g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KcAzHll_ygNwr1cRrQrn7hPWNQbHnXdmKn3_uKsjhxQ&oe=6A159412"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwPW-_nDlxIQ7kNvwEtnNr7&_nc_oc=AdrV1KO27aDSZ5o9h4Rs_n7me26VFW8iyuCz5B62LgU4DWq1CyaoINhynVeHCgJ3jlo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4f-FlCc3FIFjcJ4RjHwZb-6uNQJeCK1SHM3fteEIDWpA&oe=6A159A8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgZFYkpPs8QQ7kNvwEIrlAy&_nc_oc=AdokcJUYphXtz4hFzXSrYU36o6tr09nNzzeHGRiYtTDKHn8ncfS9ydZ-bwuTgzR4CJM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4U9aUv4u-DEN1pqMdf0vHDXhasAg4N3srVsePGyByIfA&oe=6A159B6A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
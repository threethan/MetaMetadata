.oculuscdn.com&_nc_ss=8&oh=00_AfzdSlTSWYT7vFrejNsFDBiyMG0ooRjZ3bb9Ffj34iUX-Q&oe=69BD3F92"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4XCGZm5F1EQ7kNvwGAmawV&_nc_oc=AdkKC5rZk7DmWGO2d0SoCXkilqeS_6nclrsS9_nFhRWiSzV-s33BUn4BPSiZo7DPjBc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzoyBG5h7x9AozkIWAAQWvU60dttXNCpPvjOAgN3OscYQ&oe=69BD460C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0qXYRQKs4QQ7kNvwE8dfLe&_nc_oc=AdkW3cwnNgMLtWt9AtDBVqvnakVoNPGIjDthNUOQDVTcn4IuYd12Ptu79UgpA3jZctQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBBYlOIv--gFZGvMbq6BhAdD8LoxsvB7wV5oH0kEapCQ&oe=69BD46EA"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes against you! Features three main levels with increasing progression of enemies, spells, and towers to use as well as an unlockable endless mode."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1QBOO29Isr98s23pcXoUxCqxdCCGNfhdm8Nza00Z21uk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "tpiszar", "support_website_url": null, "website_url": "https://www.youtube.com/watch?v=EHl6CAHWxbM", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29644283315162719"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1284973585935646"}]}, "baseline_offer": {"id": "1284973585935646"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1745346120, "status": "PUBLISHED", "id": "1284973585935646"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "31520221774235521", "version": "7.0"}, "id": "1226406505521359", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29542504955340556", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "31520221774235521"}, "release_status": "RELEASED
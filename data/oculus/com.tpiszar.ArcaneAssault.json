XDMKiwXZZxvM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLH3V6Y48SrqyJLw-LFv_thDL8P33GN-CFaPK-6V5_JTg&oe=6ABBB112"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BYoY-DAoSMQ7kNvwHceJv3&_nc_oc=AdpOgGcIodWot3fBQuqQOU6ggNWDBsItfC4VMbb1QmzRjQIYxUitMU3UmlzgyllDa1A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMwWAuoB0HMDceuA7TFg8fZjWZtK94wLC3oZaVR_KoLA&oe=6ABBB78C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReyVzKXMcDgQ7kNvwElc-U0&_nc_oc=AdqO3yZndKfzpJj-v7EEqepb5fy1yP8B1C0kntxANIs2GbGgEo6Y_qL4J-aSe1-dJIQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6Xeu8y-wxduUwEH9iSnuf8yJuBZg-k2C7JMxhPTM0Ug&oe=6ABBB86A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
QQJ5hg4B8YOU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qoswAdaAhufT_eeQWyGb2hSYJkGHZ6kj8fI-wLLW2TA&oe=69D4FA92"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X51j68pnO1AQ7kNvwEAQcya&_nc_oc=AdrqhzTdbTYWEudYPYnnNHOUbVqfnSZ3aZAaRVjC0W6NLt7gInWl8LQJBYDY0m5MzVk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JtOjOeLhP3SRPcXAOlOfeCGRhEvaw1L9Fy6sosNr0eA&oe=69D5010C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLHuxBkz9AMQ7kNvwE_XqHd&_nc_oc=Adrb7PEpNg6I_HDWrm2L-Pa2vJODXtiAiCj1dGoBp0SG9cm34Crph5bhfEm7Ue3aZzA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aSHKhTlvUUQa1B5SK_x1iONTrR_gS-VZ0scEqYzuX2Q&oe=69D501EA"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
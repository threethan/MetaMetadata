lwnDf36d86Uo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMbxwQMhHfdWfrknwaKJv97ZcRjLvO2GIEs5mc-gS1TA&oe=6A830092"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=da77md5lj9IQ7kNvwEcRO4D&_nc_oc=AdrDxaCTXPBaDsBX3JUoDEC3ACTL6pZsl9hwR69fEeQ5NuCGvwnZmMNiHUqB0F1nveU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYnFG4qgL0wxBOdEpOO2rShHEpsp1Vb5nEy-SyqviF_A&oe=6A83070C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m85Rsil03HcQ7kNvwFZMwHr&_nc_oc=Adr-DVVFfe7V0JVuw36I4hVYcyWeIcGugZgBABCfITxjbx_WHh-R4kQo_n1bW0PqUjc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFusWSwvjE4GYzI8TKHdF0wrmcTeMf_UvjjTR9WyXKR-w&oe=6A8307EA"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
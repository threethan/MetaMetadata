0CdELkDg9764&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxEUUGnQrwaeirboFZsW0JaXO3PiloEzoufNs7L85IKw&oe=6AC91852"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4trBAKDDvTwQ7kNvwGJERrp&_nc_oc=AdppBt_py3LchMKIMeKfsyrOm2-uT5uFydCV-i1C2UbA-aWi8Xotg-fh7eeiOyddeG8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJj0S9NLCPICxTEF9TZ2rbQw3EyozGlHHBKisR5UiUgw&oe=6AC8E68C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NW2IIWH51lkQ7kNvwHjko3W&_nc_oc=AdqcqS56QFS7quyLZAgQ3gEjxEwEX6hsW20dFOG42Pv4WHw0Z5UyFrmgPMUfJAPe3Js&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPK9hKqiLQzoBVpy0ylmBOmOR7DPPX3ZC54FCpIadeSQ&oe=6AC8E76A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
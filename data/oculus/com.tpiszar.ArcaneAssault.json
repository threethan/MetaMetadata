Gbp4dyLtHBAA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyeKY7zRJqxSpARurNxjQfB4TmCk_d5B4HgV71u5hgrA&oe=6ACBBB52"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_YgbpFU4ooQ7kNvwFJ7Yf0&_nc_oc=AdqlON005Ilbnv5jzIbL9KQQPi2Xl5g1x1Nu-NJANbFhqnWmrT6OgKx5tHiJS5ebocE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMi0IAprKsx8ZPRpL2TP9PFCbAYAVWNFhbYkopdJGKbA&oe=6ACBC1CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NW2IIWH51lkQ7kNvwEKhoQr&_nc_oc=AdqovgxmhGWG006zZF8EJZ1WinSFThZ2QWG3VVgnB7oTRw2mEjywOhRUY1ITcrHGpLw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4Bz5tOEgSpyWzUkFu_0gpZpPskq4fcE8xob8fhhnc6Q&oe=6ACBC2AA"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
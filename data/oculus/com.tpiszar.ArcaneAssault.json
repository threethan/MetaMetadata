qCBFOQ43hEOk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71GZMeRQeuBAFYOfmo-m7uz5hJ4LSraihGzKUXFIOsrg&oe=6A047092"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seAI8PSJK8QQ7kNvwF2fwCg&_nc_oc=AdpklzZZLQJe20EmqEhzGT2DWhW6RQy9Xx96AnKhQ4GjKE2l33EAaAmeHktYnwFLST4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74-5j4blpl7WCPW_XT0bFce6BF-aMsNkiqaBDKHCc_Ng&oe=6A04770C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7y_-MH1040Q7kNvwE_KMG3&_nc_oc=AdrgI9M5ylPcsu4aMieRykgzTrekEwedo9mhZA_sgbh7nPRyXHYLVkhgy3txA-tBLu8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qJNh0XdjiYwl0l2nidPN_0o6kkxyyqweO4hxwzrZpKA&oe=6A0477EA"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
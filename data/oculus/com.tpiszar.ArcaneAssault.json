.oculuscdn.com&_nc_ss=8&oh=00_Afxs_7IvBGmjwKa192ZSGPd8kTn7qLJ3yj1eApZi64dIbg&oe=69BA9C92"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4XCGZm5F1EQ7kNvwG-pfyl&_nc_oc=AdnfC74dTG18FDqqtpHSsryIdRglYH0QsIqQhlXSQ4pYZgYWwF3JPPG13tkV4Lo20Ek&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxCAPrGwWZu18NeTVd7gzWZGQDeduXmQvq_fVPtMITPyA&oe=69BAA30C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mH-LgthwNoEQ7kNvwFJLW2D&_nc_oc=Adme0Z3FHPu4TzxCbhKI5d-JGEu42TYfnVQp0KJuhip99a_V4RSYvKMIGAI_1Iiv5rs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy4yuKoQW9h1FBFoA4uGZQDOqvvrUj-Pg6NFS7WS1dUnA&oe=69BAA3EA"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes against you! Features three main levels with increasing 
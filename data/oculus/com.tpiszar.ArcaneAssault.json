9_2wspVP5PSs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35UG3EoLMJweLYKtLinMZOgj8e4RShsHgEasDRJN5PVw&oe=69E8C112"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKH-UeinMMsQ7kNvwE-eboy&_nc_oc=AdpbTHNrtaWYK3Bf7D9W1cQ9xnAJ9vD4DnsRr8e5DJ7DYp5MfuiVgwTs1Sfdd28CsQo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Lyjm7_hDKVCD6m03CEzs1cyCWpdyyanu04ZQiLC1-Ew&oe=69E8C78C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXOF5re2VZYQ7kNvwE8MQan&_nc_oc=Adqd28nmbBzAGnRQ9BBUoNV9HULzlhH6DCuPWdgE_QKq_f0Ja0ufPuNc4QKuzEkAtvU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Gd45KIswRHQV0AARiAad0QVVSFKTsyyaUfW1JiW8qjA&oe=69E8C86A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
.oculuscdn.com&_nc_ss=8&oh=00_AfyldpO5REoJiif7sv_Hork6s2BloSUAATXEOZq5ZP-b7A&oe=69B2B392"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grw8bZ0GbOgQ7kNvwFKN73N&_nc_oc=AdmJwujUTb20CisymzmkHKDM3uYcnKAv41Jo6bVxli-VL4-k-RlpDwEJJEHOj1Qqj-g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEy6aBzMmQCbcW-Q6-H6qF9XJaTG5XCxpTGQGiZpeGSw&oe=69B2BA0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETM9q7un6L0Q7kNvwFFwt3u&_nc_oc=AdmSH75vfa1LPu2t2AZUxTHAoi6-jr30pM7GHurE3XO1g3MBTtz3i6o1sAH4Cv0WmjY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzce46q8z0T_Vd1gfdFcaCgvGutJH72yg3ZKPOb2BokdA&oe=69B2BAEA"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes against you! Features three main levels with increasing 
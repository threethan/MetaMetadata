.oculuscdn.com&_nc_ss=8&oh=00_AfyIkOTvpvq38oUWC0O1gLhu2t6JHqjmWR738ofBOd-i0g&oe=69B40512"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grw8bZ0GbOgQ7kNvwFbcSKN&_nc_oc=Adl38ypSMPKhfvCWdu14sEHC4Oi5-Fp0zOO5vzRH2GqbMMochgBsxAbqxHYgqIZnZ-E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxr60nTvihG7vrDCMoPZrRw9fTfgyMXckAjf5rvN6Jveg&oe=69B40B8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jv7SWZoYpnsQ7kNvwHcVoxR&_nc_oc=Adn50L-frt8O03KjsEZasdOPDY5osaOq0atYOjuNOC88-63JEtVVHUBM6DiQzNB4szs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxEDM3Cjii6_1LgysrfRWJoc1e1tWYaRv4PEeY1A5d-JA&oe=69B40C6A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes against you! Features three main levels with increasing 
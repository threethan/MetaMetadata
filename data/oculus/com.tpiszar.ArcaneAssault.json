1b-vHjJ7-0gE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZlfASCV76wx-DHVdzbXmGWPeXF7hX9alBO4jufomUwQ&oe=69CFB492"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=py-OtZqSIb4Q7kNvwG1TqGg&_nc_oc=AdpjhHkbZhoQ2wEtuGOpb5IPh-NzE8tX6VwuOFjSddyIXB21tZUEG7zcABIvGuuSTZA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfysYy4Xco4CF1S7JXh64-vfoTYYlYBg7ikw-WfwTtruyQ&oe=69CFBB0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-C8b9onE_gEQ7kNvwE1kPdi&_nc_oc=AdrFjOznLdNrPl4F47QDnZjYmVgiOaPnDiKsbZtT3BFk6LScOpY39O7vCYhcFWFuKOk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfygYYg-OOryccZSC86lOi5xVZZRahAXMmlDVYNjYX1TWQ&oe=69CFBBEA"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
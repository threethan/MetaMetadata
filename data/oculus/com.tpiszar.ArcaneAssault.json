3LLchtOhxkNo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTu6pyXNggxuB378_TxCA-eQ3dfqsNebR8wYe1F8Wzpvg&oe=6AE8BC52"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kspLGTS9HpoQ7kNvwE-LFQ-&_nc_oc=AdowmYoOwuSjL_pzXsZfcNNn5DBeKtbAJevPHc5ZDxtVp6g7uytyq6Kxu7kFT2XlDMQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThmtdOv3NPWHfsSltBm_g89Sh5lT1PZ5iCbOcTl-S6rg&oe=6AE8C2CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGu5gkR8-4QQ7kNvwGjofrW&_nc_oc=AdrotoAUSyQb1ei3un1lTo75qtTALco8Ch0OXvfDmsRBCthvdpyUge6qn-rYYWummP8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgTIbCAL4I0CW6YyS3W2uSlryVzCZEdl07bltVdYRkAw&oe=6AE8C3AA"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
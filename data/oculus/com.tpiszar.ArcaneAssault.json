vRq-zZV8Mo0w&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3teb_RbsoZsUvC-xaHlLZXXjhKud0pFedtqVdTDsOqWQ&oe=69E22992"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkJ2zpERGkQQ7kNvwF_pPUX&_nc_oc=Adp31fc6cDiKeklImr43iv9fcRXyUvaIqjs90xP9tp0Qds2qGB94pc9Cqgt_xECLW0Q&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14vha15D3W2aEbYOWu98P2epEKYNCjS5osXEvWgJ5PXQ&oe=69E2300C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nkMgcgfVaIQ7kNvwF65C3Z&_nc_oc=AdqdyaCtTsJfsjLQ8MVGTqIkgN34S7kwx6ez0zTV1w4CFzIAHF0L6kdYC2vzFgFuxD8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lanv1W8lpaKX0g5A4bDdZ9zVMKIgZ9Mkvipc7TeIsLQ&oe=69E230EA"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
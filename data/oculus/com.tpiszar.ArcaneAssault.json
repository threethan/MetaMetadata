ooxbuqHKQi2Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwvKyD-iZ0dwPAoHJ26ORDLaXetmMW-ac1gEoJNONIOg&oe=6A95ADD2"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9FwuWEJ2VoQ7kNvwEh13vr&_nc_oc=AdoXcVfnBkPI_7bRgTekgpVcL6tbUSVy7qmChRIoECzna77y1y1fImuP3F95YLPNljg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9q1a37gl9RWC-wTq08p4ppjvaYJkYvkwraGor9dwgfA&oe=6A95B44C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ab5FHrh7UYkQ7kNvwFF9WYR&_nc_oc=AdrMZy1SBZL4OUpMk_U_Q0AuEnwpgkV7ZWXfkQse5h09OPoqntwD2U9ErWjTJo4ccSg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTYG5438EcelefBRuz4-MMVnwwd_tWcxa9WpUCKdCy2A&oe=6A95B52A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
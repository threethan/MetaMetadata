6kBwzL-Ppuu0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sWGbOJeryeZdX8deGTlGVRMbX-x7FCx83N5GWGmtqBQ&oe=6A12F112"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nqfv8xVUx4Q7kNvwEJrTEM&_nc_oc=AdpYUilBumdWNYBnLppEkhs4nkTp4ocND-THNojHoqu4sjo4s5elSCvnBBTaoFd1Ik8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61-1HRzqA5DItLo_OebXUn-5l6XuBA86ZbkC0JZ3mTqA&oe=6A12F78C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgZFYkpPs8QQ7kNvwGktSJp&_nc_oc=AdoipCn74Dj4Put0l2AuTQVf79bGFbFOe1hice3nQCXLI6zFBTJgfw4WyXFmZdfMxW8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61FkZmATg1LcipTG7dw_15eddPnU3qNVKlmtgEx6bhbg&oe=6A12F86A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
NFMnG_E5zTiU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iWk9854nkNY-NyqyVu-j_IKwXRdKOARCgT5RQtv-qOw&oe=69D25792"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X51j68pnO1AQ7kNvwEHx8Eg&_nc_oc=AdpTFm9J_66XUyZDRYe2gZXncuWQ16CSO2Kn-4OHHI9mCGfdZ8mPU-88UEGbJbW6WSo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OC7JzmheocdVXtkH2tp55NXgkmBu4aoShZ7BMn_qE5Q&oe=69D25E0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-C8b9onE_gEQ7kNvwFVL7g4&_nc_oc=Ado75VTKlOi8Sj1dbsFVU9FgEsDfbls9x8I6KpXfPEL6gn0Mt7FJq3YgW4LsjuoynZc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iA2hLVMj31icRTeSZYOTY46K1MUDMhOq7EnYekC5UOA&oe=69D25EEA"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
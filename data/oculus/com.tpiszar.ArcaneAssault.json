MS-WFiz-Lhk4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjGqS4N-isGq0K-PgMHy0zM6EXRwn7nOFPCJt276BKFQ&oe=6AF9DFD2"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HoYwboHXR-cQ7kNvwHVU1Vf&_nc_oc=AdqVxKOF2AyWUlQloicyqgnXDXRdfXSEG23j2gbXeIz27w_Wy_YPn-A0LnUJwS7S3lk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQF_8EpaLCuk91DkIZz6IJJjlB1e5NFLQ4EKbbiIZTixA&oe=6AF9E64C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgtvuDhctA4Q7kNvwHaPSn7&_nc_oc=Adpnu8k14GlmXmrBOERBvbGanP6l7buQVAek37IdK7ob6Koun9vTQ8uIP8rgFzK5LtA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6JRE-adVzrQk4tsQWoV5OKbevwNoezUr_WZkzc8r0WA&oe=6AF9E72A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
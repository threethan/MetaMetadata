HgdHsU2ykvt4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0V5nOhTz6X0ZYSzRhu-1-1U7J8r8a0L-vf9xxbBgnJpw&oe=69ECB592"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9_QvQwSuNQQ7kNvwHzhC21&_nc_oc=Ador_ZZS0H9xAkhc8rJ_EG66ZuqobjxVylMR4nXRBOQesZGWjod3v6EMssiZyBew73s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WKur28F3_-3qdKVcXZ7aUxWShqh7evDl6wZOuDeSGnA&oe=69ECBC0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8kW-jx3F8MQ7kNvwFm6yuj&_nc_oc=AdpoY9QdkV1jckh6yxvNi9LSCSbyZuqaaI97hIge8rUAKKc8UexX8WiBJxjziWrSGao&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tO1qYCperLyMr0_NAWH17wj15ZYBL9Tk2le1_0Aw-EA&oe=69ECBCEA"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
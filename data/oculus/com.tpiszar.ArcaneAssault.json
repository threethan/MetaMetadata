wQZ1mFbP7ip8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RG_voZApEaX0n-bg8VKpjrUrHt20uUIDN7q2jOX9uvg&oe=69FDD912"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_GH4MEjFWoQ7kNvwE7ujn6&_nc_oc=AdryDAp1DXK7cK2vqjGI726fJotX9ym_TmL3WetMUQ93vCkCtk15bRc_7kGkR9mBPYw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7a-jBt7S0q5GI_Sxy4AXWv_Ydl8rA99nC8UjU2oqRMLw&oe=69FDDF8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raAxTh596sYQ7kNvwGdhfGt&_nc_oc=AdqcQD-3nMo1khQz33zcTcObl_7SvxW4w-DwHu8j-tQ83fJDcLk4WLSjMEgSXTvtkhg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wO3OI1-pwwUTwCqLUwIUuw0sHy_ggrFJgfK_Vwv6fYg&oe=69FDE06A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
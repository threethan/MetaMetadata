hqfAsFFaA5Qo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uxuA1V_Wn7mGXhmvC_a_6gkwJgsRGDE5F3fm2b2_InA&oe=6A183712"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwPW-_nDlxIQ7kNvwFkJciP&_nc_oc=AdrbawF5P6U0HSF7zy399qscNW00rDtZgEVrbWT1Ja98uLbBxZH3Lug_y-T0zoCwqbg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69geEJjfVHxGWZFNMQnzm-dAIpYf6IjmGnL7-kQvzPMA&oe=6A183D8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LL8_13uquzQQ7kNvwGvdN-x&_nc_oc=AdokPaevLYiQKHRozFn5O-gSEqJc3vx_plcmadiEAxr7viWWffSTJr221CwnzCmgn0Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MWISsOkMcNmNW9RL2fsf2dNkYYyDO9cwsIMtZnOvpDQ&oe=6A183E6A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
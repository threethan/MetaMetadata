4NM2G3ysjGhI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIURXol2i_GUPQRcv2YrdQAAzv6aXRF7A1Is7-vKkW_w&oe=6AF0A552"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLMvy3THh1wQ7kNvwFa2XMZ&_nc_oc=AdoIVj4OISUGml8sk0qCKdHXb3COzmXGNN7iAtU98tSnEHBvTBvxhvsOko8nJBb3P2o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_6-4nVz2RKL6WZp1gVMrt40vU4S4lHPoc69a5GSTJcA&oe=6AF0ABCC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_evJxyCXRwQ7kNvwHyTqvD&_nc_oc=Adosxk4yQkenaxPk49scbFXvKkobwIorRK9AAyHvcQazoh8RaS6R3RFUzhT0qM-pdZE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3k27_JnQ-FnM0qRGwfq1KCov5iBs_A9Xm7UQtaB7esQ&oe=6AF0ACAA"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
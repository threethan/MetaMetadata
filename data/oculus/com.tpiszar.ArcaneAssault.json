e4-0gNqJ-Qgw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03hW8skqkeXQCpYJhONMeoolvJIaVGrQrj_lt8u5gMow&oe=69E4CC92"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkJ2zpERGkQQ7kNvwGuMY_k&_nc_oc=AdrCFuTIQ6gD9a4g_TmO12Bryt6R6VwJNKKBNGevK_hbesFj185jLqmr_gr8II-qWkg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UrmHp8-OYnCL_ZISq0XpejAzxjz8byyamkQ_gE0y8Xg&oe=69E4D30C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RchTXGbKLvwQ7kNvwGW9LgM&_nc_oc=AdrcEk0xByu184YyN7AGPINexxJyN3tszi1gqvjxarlydrMdlwtqdlCQzOERrqMskBI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Sv3TQsUPYUIvQB0Y3saPsSSccPib4FR2RgjLbvxc7Lw&oe=69E4D3EA"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
.oculuscdn.com&_nc_ss=8&oh=00_AfsFrmC-2SNgLRLLW-BtfIoZAEHdAauJFfHSDEm8ob8FJQ&oe=69A97912"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSBgSncf8ZIQ7kNvwGk6weH&_nc_oc=Adl3wjrgLJUMofvlGu-m5qQt6ajxava6x7sNr2Qibhdnb5ifmyuht3xkab8JBxAPGCI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvvAI-uZaBz4oaRGIGCYi1HpDo-5uaFufkTxXUXXh_NnQ&oe=69A97F8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6_cZFyJtF8Q7kNvwFA9I_X&_nc_oc=AdkT9TrrjPDyhkquM0aDisxlOItOKoiYc6OyRfvP40MI8tLqHBNr5kltAFf-QXeu_F8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afs7irpPCD0RMjY2ClWxbMF14675oKiLxexoi1U3YIwCkA&oe=69A9806A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes against you! Features three main levels with increasing 
cg6_uQFCrnz4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xB35N9ZWPZf4qS0znuhqPLFkevKRu5Zui7C-J4gnBgA&oe=6A3EAAD2"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLLcC7BGjJMQ7kNvwFcAF2J&_nc_oc=Adp0ACg0x7YePLguv73MZWcxRCFY02iMRYiMf5s5QeiH_7j77kL-pyV93OhUu69nDF0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ejQU988_Sj2VbTWYO2hLHWpaJdxY36ghpNJpuiYjQfA&oe=6A3EB14C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6o4-k7UGuLMQ7kNvwGrzrWY&_nc_oc=AdrkrgkqG4cQZNatlfi1KJEemrksc0wTMTnYzre0DQr8wHGFK4mL_BoGDefT-qgig30&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Lw7eshBIgXqlQ-NTfVq4J2CxGCzOPC0kO0RGYf7866g&oe=6A3E79EA"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
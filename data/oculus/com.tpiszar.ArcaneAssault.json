9X45k5Mj244c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBYTXizR_A2eYlX3vY3DX-aXdFHoMHc_RPhPETcFqJPQ&oe=6A99A252"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9p4qx7aDlQQ7kNvwH8nz9z&_nc_oc=AdpzC4bl5bgBStJdZxV-QCMjBtJLl6bxKMS16jcujA-aoZKVKsYqfprR5WtHA_k7giU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjlDqLOOq9qOjS0Q2923U2nC0rG6xWhajYsegBDImkjQ&oe=6A99708C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2iYOpbS06ksQ7kNvwFKLZIE&_nc_oc=Adpd3Vk6Ae7emzHz9KyJinVGkJVS85LSUDtAj2szinn8HvDjmzSWmQnNR08QqC5jng8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfUzMbyGuBaPwJltXbr16Spqln2FE-eu2L9rzGrVRE5w&oe=6A99716A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
.oculuscdn.com&_nc_ss=8&oh=00_AfzOBZloPuE0-EwM_68F-H4EpH8-ho8x6AKYwoD0qzne7A&oe=69BBEE12"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4XCGZm5F1EQ7kNvwHDYgxF&_nc_oc=AdlFmha0oR2wAY4SVt8fJlERBguYN-N8TuZLv1PgqO5R56MRmDQWwSHj8EH2Zuhin3k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRGpfmmJrZh_GEYzy0u61-LxGPjWez8LOWeXmR9l4nvw&oe=69BBF48C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0qXYRQKs4QQ7kNvwGQCby7&_nc_oc=Adkdrjz_HE6C-sGBE7hIX5dQhaPoDJEheYOyRag2f8ncbKAdQnlW2WmurWwny47Tk40&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-9utzwfR5qalf_tDZZRsTy6JkAzAk7zuf7VYZtuqoNw&oe=69BBF56A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes against you! Features three main levels with increasing 
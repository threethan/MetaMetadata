o5ngHnvxQIxM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FickE3mkLWZy4ZKJ5fCgUrI7u8doIA1rO46_lP-o8vA&oe=69EA1292"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9_QvQwSuNQQ7kNvwHsZHsu&_nc_oc=Adr8pgECJ-TLKk7sFiYgiyEZG96YHzSe3HuLz1-05t_x13vG6XfGPSEHBKZiWIWj7ck&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38UAS6VONWBTYY_xL-mdqrN9UM2AJIGUeW3GwUVni89w&oe=69EA190C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXOF5re2VZYQ7kNvwEg-7v6&_nc_oc=Adokqn1UO1nY8AvvNjTIkGn1IOPl3DLlubexpJijQMz2faPyryxsBUZYlN0lfUvuw94&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IWVGG_5rWyUiwR44-QWoLCKtk8uBN-B-0CJLEy3oeHw&oe=69EA19EA"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
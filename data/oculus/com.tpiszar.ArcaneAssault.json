NnRdG7n7lARE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKW8meRcXMT4Y75EhVqU8qI0Qv3Qs_9fCq0JjAwihF3aw&oe=6ABE8C52"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BYoY-DAoSMQ7kNvwGdByrU&_nc_oc=Adq7h68NE5thxkwug-EHxoXxht8Ks-zKhFMHJWcfPZQwOApfS3Nl28IyAbqNflvXhgQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnL9vwMouQ77-TCPXeaTTC0LFXsMMZqcL6S-wz0Tt5Eg&oe=6ABE5A8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mX-0Yv_M_rUQ7kNvwFuQw9C&_nc_oc=Adq235cVhQV-Rp0v9PW--tKJEo1exLs6TSsODbPwBj6tDCS238Asfh43wtvsf5ucB0Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKluvSw0r_JD5FGLVfLd8_-ZTQ_w8aLT94mHW9aiKUSg&oe=6ABE5B6A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
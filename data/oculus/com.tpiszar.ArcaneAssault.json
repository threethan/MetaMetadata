YTvObUNA2qhw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMB3UoxRbO3nVImd9W11kXoRPfmfWxTsEMxG2YMfKfTTw&oe=6ACE5E52"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_YgbpFU4ooQ7kNvwE3XR5z&_nc_oc=AdoE6muAgLpywlES1NleQZFgULKEfkpecEPdAe4EsKE4v0bi8bnVcslX8cULzNqgVpM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwoAkiQdk9QrhEBFEgm0qHCM5JfHcuhA3u3VXHq3CJRg&oe=6ACE64CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQMWwD0XYTYQ7kNvwEDuF4f&_nc_oc=AdpUCeZhM5gSqSar_QcYjoMKax1EzwGGnKCyu7tJKXrdnthW-NklGQyCZNz2i6ros_Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTTBk-qG50mcXonxvrGA1r3Y6m0WdnO6_H0jqPtkcAfw&oe=6ACE65AA"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
w5t6S_Ihv91I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVOOMxvkcWtRNBRJzPuqHJ3JkOUu7D0FUWjET2G0P8-g&oe=6A68A292"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhPPhr361-MQ7kNvwG52h6f&_nc_oc=Ado3Ki2BhE0yV5jAXNB1Wlphvo1Mzafg_y0-jcXJ6r5OhvSU9vj-IW_ImNmWjvCN12Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfRHkjxRqIdlQoWQ991K2yHN3wqEn260ONb3hW_YTEDw&oe=6A68A90C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yqTqqUQm1sQ7kNvwE-bBhy&_nc_oc=AdrsNFAJbs7S1OLU4cbyXQlMRujLWDnqMjbFLGNSZGVK0y5FQRdA6jgSAp6Y-dOYPLo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYwPXJimBLuy06H40bRllCsAS_AtYijprNjxRuTER-eA&oe=6A68A9EA"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
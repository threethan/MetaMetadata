QVLEUfjQtHk0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLoF29I9g583caiapOGuCP_fGnHsYkzd3w_w5XFsT6cQ&oe=6AC67552"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iwx6zAJNA6sQ7kNvwHJTc8V&_nc_oc=AdoxRbtqEzaKZrg66AH1Mwpc0Mf_ShASiEt0qrkA9safhPzuzzP6rgBG7PgaVp0sPyc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQ0e6WgprbK1wCZwaffs7E8hOfI4ILm4I_280xh3BCUQ&oe=6AC6438C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JC4oV7iwLVsQ7kNvwHamgJO&_nc_oc=Adpaw32BreaaVhT7oZ1PkeGGe-88e3uBluRPIkajWnxor2aXv6p4vWbXvCo-4GVPErg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkykkpXWeVPx0ZxlAPfomqimGpRbDelEhS5q76zeJ9Jw&oe=6AC6446A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
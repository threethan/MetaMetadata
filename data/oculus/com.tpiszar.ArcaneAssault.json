fHtweZrVCJbs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bsSMiEg2WR2fyF_VOHaTR2K_dthmyZW4m_2hOxdNfUg&oe=6A2FF212"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRS9V28A7ToQ7kNvwHTef5x&_nc_oc=AdpfGXRSuwdtveE-aJn4A3sQJWKMxyizPF0wRaksIaTunE_0COtd3N9nOrRlqQYNQJc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ga96ZNoz1LXCawkemliuxL6gASHW4obvz48Ibs2D_dw&oe=6A2FF88C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgn5HhTxm5UQ7kNvwHWBzDm&_nc_oc=AdrCuivoqEA2XclodyklFFR5SQakYRkbXr_7IVPM-rYcxMJeY4g-MgWu6yLHMj0-vnc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TIGMNIFJVtddfD0H3xnK4I_LIl7JGgbVsUKLmUESGXQ&oe=6A2FF96A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
ArBt0GP0o9IM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCReJI5ZPm6DN5lKtCXWEJeunUgQSDlh5t_mKBYdsVq4w&oe=6A577F12"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dseciHqKW_cQ7kNvwEe4PIi&_nc_oc=Adp7SEdhb889IhTYRSyKYj2Dar4TUVV74P3DcjdWpofz8OZau8t7x30h6aF0kStDoGA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeInOkqToVvDApheKl4h82RdWODr3GlHNNmmTAsd8vXw&oe=6A57858C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imGsosxovi0Q7kNvwHuF_9b&_nc_oc=Adrc6oWyOkbwo75xJEzcjrkiR5VQ5wJ9v8sCTozbTVunn7Q_1yZbNNPIITV4sipzlIY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqhhSJ_RnwOFOAdLfJ3ehwBXKWCb_K5cG0ckoR_Hl11w&oe=6A57866A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
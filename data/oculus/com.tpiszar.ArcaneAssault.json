i6FrWKmLNhL4RGWeE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y2b4u_uh217LqCryie75Ayz3Uuz9N_hzcFpr1lE0MBg&oe=6A22FB52"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMhMx2DRNwQQ7kNvwFx9wrb&_nc_oc=AdrUCLhHdaNCudL8UXUfiRsLhJMAK9UOvwP-jsnZEDGbxxy9TVVhG_3UVmVIqsR8pvQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ma2Iq1tBIvIYN6Qu5SIc80rXVdBuKKeHKdeBDny6O0Q&oe=6A22C98C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvNENxrfd8IQ7kNvwFIMjiV&_nc_oc=AdpW_j3PQW_IomKMzXXbprAl1wmQkvKH_vr2EtKpuBp6QE8vfzbiK-8VpHa383J-qYA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZmD_sufFppLe9MlB9812TJVloE6oaAWyXG0SDcL2haA&oe=6A22CA6A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that 
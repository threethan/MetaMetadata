UfZqsa98ytb8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9whoF1HEqfAi4H5uqJC6e9Zrjj2w3qRaEQZfY7i_Xd9Q&oe=6A3AB652"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5pEhsghVHkQ7kNvwGKrx6S&_nc_oc=Adp7rExiZr1mUt8VB-TME_oY3_T1sykaozyxgpUPznMAPYigXKPFGcLummQA2Oe1TQU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9A-dYk9UAUWc638FJPqv3U5hNigN4FmGYexFpRoquy1A&oe=6A3A848C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCZEQweONzEQ7kNvwGnbTiC&_nc_oc=Adr9l16ju4MRJJChoyqMTZtzRnQ_6MyM_dPnPAYaKWNGYsneX_FFIisNdmaiSd4eyRg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8F5Wyev-vcErSP1d_L2ixDldNwXLeQFFOD_kxeJXLgAg&oe=6A3A856A"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
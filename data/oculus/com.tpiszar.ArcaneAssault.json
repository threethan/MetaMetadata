oV0baTlolmFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCGXl1MHpNCMZGYD41j7z883hoMbMQWOMK03j_Nvw85w&oe=6AEE0252"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKGBJ5zP24EQ7kNvwHSzGnA&_nc_oc=Adqieb9TVu3TDI9jUYdFa5T-jAaR6pBnT9lgslo66Ayn8uKsKPflNOd8PIkyndNf01o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQF0299jt1YJnMd6yRWHnRAISh30_epyMLpEHXgnwbupA&oe=6AEE08CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iy7WtsVCLtsQ7kNvwEt3H42&_nc_oc=Ado_h53-zBAMqTnA8VYs7zayK3cl1TgJZbTAO7XoqlRly2Uh2AxmP2ojedEoOmyINl4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqIi6Yt2VFvsZaWxwJCbjpz1gwwv9moQS_ZYbgVyeouA&oe=6AEE09AA"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes 
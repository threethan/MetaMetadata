.oculuscdn.com&_nc_ss=8&oh=00_AfxW1NJi1N-2l1-2Gp7tVGYjbrkYaocP8bJUF5SaNQ-9mw&oe=69B7F992"}, {"file_name": "Meta_AA_SH5.png", "id": "1881227182637020", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823437_1881227185970353_8409026283491988616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSP6gXhXq2gQ7kNvwGo8HN3&_nc_oc=AdmepQJrMX-cJDIEGCQrmDgIETNLQkdisnAH3WFO8FWNJ-lnzcNqj-S4g7OttASHWUg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZxUYmRLgVxLe-rlk0vYF5lOMETpAud5Dq6EE8r2MJgA&oe=69B8000C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Cover.png", "id": "586096713801911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392000_586096717135244_4706808562202875992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mH-LgthwNoEQ7kNvwF1hgGc&_nc_oc=AdktsjnShOr1McGAtxFYeMu_5Q-Oyz2rLUGmIycHU2ffeElmou9D5dk6p1EfdkL9cww&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyfS_9R3DHhCmU6_KxslVZqlH3AX9im2N5jq6eJzvZkRg&oe=69B800EA"}, "display_name": "Arcane Assault", "keywords": ["Magic", "TowerDefense"], "long_description": "In a time of distress, with many monsters roaming about, a wizard must make their way across the land to assault these creatures using their arcane power, defending themselves from hordes of enemies along the way. Using your map, place down towers to spawn them into the world around you and destroy your foes. But, should things get too hairy, do it yourself by casting spells and unleashing the full power of your ultimate crystals!\n\nFeatures:\n- Eight unique towers\n- Seven unique enemies\n- Three castable spells\n- Three ultimate abilities\n- Three main levels\n- An endless mode", "short_description": "A magic themed VR tower defense game. Face off against hordes of monsters as they descend upon you in waves. Place towers, cast spells, make quick getaways, and unleash total destruction to clear your path of all that comes against you! Features three main levels with increasing progression of enemies, spells, and towers to use as well as an unlockable endless mode."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1QBOO29Isr98s23pcXoUxCqxdCCGNfhdm8Nza00Z21uk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "tpiszar", "support_website_url": null, "website_url": "https://www.youtube.com/watch?v=EHl6CAHWxbM", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29644283315162719"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1284973585935646"}]}, "baseline_offer": {"id": "1284973585935646"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1745346120, "status": "PUBLISHED", "id": "1284973585935646"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "31520221774235521", "version": "7.0"}, "id": "1226406505521359", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29542504955340556", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "31520221774235521"}, "release_status": "RELEASED
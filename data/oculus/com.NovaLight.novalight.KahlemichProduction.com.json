.com&_nc_ss=7f20f&oh=00_Af-3G20gJzkAzqAU2CnBe7oY2pNCtEtYfg2Up2VJ9_KIkQ&oe=6A2AB75D"}, {"file_name": "1000018160.png", "id": "2218389835322019", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818852_2218389838655352_8656270571394147227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2RML2Okwr0Q7kNvwF32Llm&_nc_oc=AdpZCFw4j25SpY0pPzN6XW4bUUh-glh2l5KTJ63Ir6lBjoTLKV5KjBbKg5GBI1ePu_A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9icH5eNB89aX017-wuUHHsb4hvin8E9b6o7jOppaMAGg&oe=6A2AC02E"}, {"file_name": "1000018161.png", "id": "1308549704291953", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820887_1308549707625286_1357400561119125643_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TvaFZlfTukQ7kNvwHjaeRv&_nc_oc=Adq0LZdTQppqhxyUqXMmD-6luChwmb9sozZZkWM9dq0Debk9aucQscXHPEOuBsPWHI0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_N0bI70lYixDpH815v7JVq9Ue7uYdjSHPlGriaxKELfA&oe=6A2AD8D1"}, {"file_name": "1000018162.png", "id": "847515664448960", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819356_847515667782293_6503763359966103153_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ah1fBz_9YXkQ7kNvwE6Ca6b&_nc_oc=Adq8YhGKf-1sHa3rvVwKx6iVG-ysn_B0DWnBZFz0UoCWdL0j4h1rN_eqypnsHx6vYMM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_esZ3IehtH9t4mn4sb9IpUVq8rk1iHMffSWUUR4wb0Tg&oe=6A2AB0EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Novalight", "keywords": [], "long_description": "NovaLight is a multiplayer horror game that plunges players into a series of terrifying, ever-changing environments\u2014each with its own twisted lore and survival mechanics. From the creaking floorboards of Granny\u2019s house, where silence is survival and every door hides a trap, to the warped halls of Baldi\u2019s schoolhouse, where logic breaks down and punishment is swift, NovaLight keeps players on edge with unpredictable threats and dynamic objectives.\n\nBut the true descent begins in the meat caves\u2014a grotesque underground labyrinth pulsing with organic walls, echoing screams, and something that hunts by sound. Each map forces players to adapt: light sources are scarce, enemies evolve, and teamwork is fragile. NovaLight isn\u2019t just about escaping\u2014it\u2019s about enduring. With randomized events, unlockable lore, and a growing roster of cursed locations, every session is a new nightmare.\n\nWhether you're solving puzzles under pressure or hiding from something that shouldn\u2019t exist, NovaLight turns fear into strategy\u2014and survival into a shared story.\n\n", "short_description": "NovaLight is a chilling multiplayer horror experience where players must survive the darkness across shifting, atmospheric maps. Each location\u2014abandoned labs, haunted forests, derelict space stations\u2014unleashes unique threats and puzzles. With limited light sources and unpredictable enemy AI, teamwork and silence are your only hope. Every map tells a different story. Every shadow hides something new."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kahlemich-production.jimdosite.com/privacy-poiicy/", "developer_terms_of_service_url": null, "publisher_name": "kahlemich", "support_website_url": null, "website_url": "https://kahlemich-production.jimdosite.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": 
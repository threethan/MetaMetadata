cessible to anyone, anytime, anywhere in the world through VR.\n\nVisit, meet your friends, host parties, or just hang out in amazing VR homes designed by award-winning architects and designers from around the world.  Interact with and modify the home environment, change up the decorations of floor plans, and envision the perfect home you\u2019d like to one day build in the real world.  Platform includes  lectures by architects who share their vision for how to create the perfect living space for any budget.\n\n", "short_description": "Visit, meet your friends, host parties, or just hang out in amazing VR homes designed by award-winning architects and designers from around the world.  Interact with and modify the home environment, change up the decorations of floor plans, and envision the perfect home you\u2019d like to one day build in the real world.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/47e3822b-bcd5-4f83-af77-2648bc831c46", "developer_terms_of_service_url": null, "publisher_name": "VR Neighborhood, Inc.", "support_website_url": null, "website_url": "https://www.vrneighborhood.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "947524899867418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974911_966869547803795_18555
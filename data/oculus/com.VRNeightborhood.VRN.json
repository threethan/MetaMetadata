0Z_fT_9uXJ8QG77WbI6QSDIf-9_Ys&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRc-4n2GnExWL7fxZYw56uTTC9lw6looHP5d-eKQnrwJA&oe=6B08749F"}, "display_name": "VR Neighborhood", "keywords": [], "long_description": "VR Neighborhood, Inc. is a social friendly platform dedicated to making innovative residential home design accessible to anyone, anytime, anywhere in the world through VR.\n\nVisit, meet your friends, host parties, or just hang out in amazing VR homes designed by award-winning architects and designers from around the world.  Interact with and modify the home environment, change up the decorations of floor plans, and envision the perfect home you\u2019d like to one day build in the real world.  Platform includes  lectures by architects who share their vision for how to create the perfect living space for any budget.\n\n", "short_description": "Visit, meet your friends, host parties, or just hang out in amazing VR homes designed by award-winning architects and designers from around the world.  Interact with and modify the home environment, change up the decorations of floor plans, and envision the perfect home you\u2019d like to one day build in the real world.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/47e3822b-bcd5-4f83-af77-2648bc831c46", "developer_terms_of_service_url": null, "publisher_name": "VR Neighborhood, Inc.", "support_website_url": null, "website_url": "https://www.vrneighborhood.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrGYLFvHgtUQ7kNvwGCE0Dx&_nc_oc=AdqVDpPJokgl9c47yd8r92R7NwTpmvjBQoNGu2SSELeWoMgt3sqYPKDD_3wCC2RXRkI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxR97_PX4h4PYqNkjOQb5YKqsQFUpZLoQe5M3U4cjOGQ&oe=6ABA6AAA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwmvIZeBuOQQ7kNvwHCjCpb&_nc_oc=Adp666RA3MTwIG1cCHSymq0LLETOhG8zONtHkJ85e1lVYiQKPn-fV_CpRX5o92GBZDg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-a8gJW8J-2c3eOV8dEjVDM8NpIuwDlNqFztPJKa9iJw&oe=6ABA898A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKbGRIT6QIoQ7kNvwGPpInd&_nc_oc=AdoL2lMsyBza1v6CnDf9BSFJshHr_qJQvXe1H7x0j4xHIr-v24Dy_tkzbIVODJkH-rw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsG_GGUKfGC9dYGbjO07Buf0vECLkB5e196V0yoY4ImA&oe=6ABA7C1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WI0HkOUNQDwQ7kNvwEZM2hK&_nc_oc=AdrRCLkOqql_-64ZRRG_fwPdd-4Qn8arsowWK3VkLRD11M6f7ok_R_rB-TXYsA0oWeA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJprRqHqz0JcjieIq7bGkqR0OA8PQ6u9cJumPuB91zPEg&oe=6ABA6F19"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-y_Jopv4ZmoQ7kNvwGS-UK3&_nc_oc=AdogoGDJE6ZQm4W3jHZC_BgsUFjpwQbPnWkeJOnQ54wxczQ4Z1rNj5Ozq5nh05MGLu8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=
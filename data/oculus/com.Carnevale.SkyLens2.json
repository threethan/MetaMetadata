ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egnMhcMJJUYQ7kNvwGU5QNm&_nc_oc=AdoMC3FL0xaOd5vCeqcmrByhsuj1najgoWDjG1GYwl7Q2W7qFVAnZ0vgFwhtW5SJEKs&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Xae3INi2a5LOvptU35cDXsZHwePW4Wi8xkZc1Suv0qQ&oe=69E234AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgR-4cdF6p8Q7kNvwFapRr8&_nc_oc=Adoc-bcXuq4LuCpRa4wqup9uYplOYLVF3eAzPiqbq5FFZmDrlQXcPawzG1kqaohbFIg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ifZNcPbxRXh5H4FatUyB553Y_GsilLmjju7yA3fR9AA&oe=69E21B4A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsxpLGlOROYQ7kNvwHBg8Bg&_nc_oc=AdpudMw6xXOgssSDKi_lelRTArZR5vmq4lILKSXVk2KmPpvj1biZPBIGs1yNLZkv9fA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RO7ynIaT8xgCnqlLZIOEHiTOgk7wEu1LT43GUUt3buw&oe=69E2461B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7G0V99k6yOMQ7kNvwEAvcP0&_nc_oc=AdrNcTHIrUe3ca-W2b8f7uNSXovSsZSAppudjncKex3zkkIvbvREOoBuTtPj5x2wmr4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39YdOF1O2sxwes8K0J9miMmPw-_kW09W_RLJUqBFddYQ&oe=69E23919"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rpbs0Uh6qXUQ7kNvwHXNe9R&_nc_oc=Adr9J1erhFAIm7bYysZfctsI4EFHoYb2G9Ruuz6BACXSkbvix7bP7GRevERY8O9sEes&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=
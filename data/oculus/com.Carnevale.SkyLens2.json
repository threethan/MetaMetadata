ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2MiePmiypQQ7kNvwEN_GZc&_nc_oc=AdqEx51j2BkcULscOrEhnbFbL74roI06epi2gxkNw7p1yJDdRrL2vqpTHfImCUkPTFc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jg8eZGr_lTdWXJvzvWjjlejheVgv1vsPPzC5BB8CToA&oe=6A25712A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_0nV4BQLU8Q7kNvwGSW3sR&_nc_oc=AdoFxQ0TGhB0-DtJn73-Z0eOcKuPGUtlCDRgUyHmNnQOi97S_U9gX6ge6C4tTTUrE9I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eSfGfofMMbosxy0SSG5nBvoXqp-4cKaRP_c2nzoq7YA&oe=6A25900A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0l9PBQn04x8Q7kNvwE8Jh0g&_nc_oc=AdrV4nHIUJXFJ153bOXZ6mFX9RHf26gpapWsincka8sCaYw6grlNTbMHXp9SIscDK-c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SOkmKdpNPPvN1daIO4dvg8SR1GtSD4OiiWZwfHdSrBw&oe=6A25829B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jm9HG2PeCW4Q7kNvwHZLtRE&_nc_oc=AdoRauIO5v1X_hWrIctM5e1cw_hLpYYvGv8RL4ba7FnVYME4Ty8MX9J4hNP8NnTiwlU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9af1NUDd5im3BTal8BahwD_Azbrawt5zJT9RbFS6Z02A&oe=6A257599"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSjtu1sPVnEQ7kNvwFpz7AU&_nc_oc=AdprLvazEowKNt2dSc92B4Y5bx9nHtWv7X72rNqQZTLPeTbqk2y0JtELfZuLBvdjnIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=
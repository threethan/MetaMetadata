ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPoqQljNTIsQ7kNvwGTVj3Z&_nc_oc=AdrmavSdPMUST7Je9oi5o0f9buVTS9mUiO_CZJGO6ByvoozojrF_hramOtdMClOOfbw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02g6coiST9nllTl-xFES_P6O-bLX0KTGpRzEpSh_-3Vg&oe=69D505AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xx6f3bDJesYQ7kNvwHlMWkD&_nc_oc=Adqp_JxRL-O4P0uAKprWUf7n8IbaLLgavdyP_MDGgXhqy5QqPkK_OZoPDPnApZSwmIY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zCJw8RFS_Ayh6r6luv9FeC2OQ-0lymSDTFrNN7wB2jA&oe=69D4EC4A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgKGR51E0lIQ7kNvwEl8CnH&_nc_oc=AdpwCrr31xhPLhQCNU_HJPNDeUsAcp7IhxlL4YBUvgCK5CYRIUyV6GKOszq8O9l7kPg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QmWKNcNOhTv98N-MgYFg0IxDT2QhmCif8SAVcl1tD2Q&oe=69D5171B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jL6u2hTdNgQQ7kNvwEJdhNu&_nc_oc=AdpyCfc4VrkXEEQWGVPeWl3K0YiSagP5G7AZ3-0HlRkilGvQ7jR_e4PemvZDKd7kJ-k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kM9wNtxKyLkxMhwTFE8ph1WHRCTaWbgTiNqXE6DEZwA&oe=69D50A19"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfsh7esvBmMQ7kNvwEWjp9V&_nc_oc=AdqHCNXlHq3HPjXNBGl1Z27tacuTnZfQVsFj6LrwgYrKPQ9ZFsMDFEmqCYg1ZrljuuU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qnxKT5pWYsQ7kNvwHg7PB7&_nc_oc=AdqhN9MxWy_x4lGTh13yfUB5HzMXttiME0dLHb1cIi3yF1Xn7Hvecrbkd0e19b2xgn4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eoEgZ51Fgjp0ReOkq-opZaj76nu0IRKHraRJ3v4THbg&oe=6A12FC2A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6utoFUDGB3QQ7kNvwHcdFb8&_nc_oc=Adp5gbxDZZFKlbIGBkJXGhWiq9AggVb6oPkdG_0bhlwB9f1oavc59Zu9blI-YpJoGxg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xXerXsNs_iMdEV_XFSEiVfTSp-Ix9-6xSFH23VtxJ1g&oe=6A131B0A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=md4kxyM2KHwQ7kNvwH4zmyI&_nc_oc=AdpQ4Z8-BRnsF0xYFj_ESR2kQZqsrALkoEP5ZAIBPFs-OED8Ze-EN1jRZr8uQde3ckg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40UWN5mUeTy-4UyuQtUEG_dP_Jf92Pth-ALh982OEdZw&oe=6A130D9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8KHqg0lQ88Q7kNvwG8-TJf&_nc_oc=AdpS4h2DXi5PNmxs0IJRXdwK-fIe6CWzMAPLA2umZcAqO-OoO6FIG1Ewe0pilZGcwC0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oqvb-PmtXBvCxQ8Nn7jA3sJtac1s1PTv1EpxPZhd8KQ&oe=6A130099"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNrJJzn8LawQ7kNvwGntfNm&_nc_oc=AdqqikTwsvNxFe2KqjvARGBwqq06520xWjlHUF1yRn_if-QivXg1UKTcMyQ2INL6jqM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=
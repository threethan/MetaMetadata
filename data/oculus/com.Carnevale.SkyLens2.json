ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8RpgVSFUNgQ7kNvwGIZL13&_nc_oc=Adpdp-jYfuZzGzbfk4hNXvDFBf_dFDSmVgEgmZq3otv2WdQoAWMGFV-DNu-eY8YXb50&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCZMRZcusuWH2DJDcqqxiv6LkorilucR987cutih56gg&oe=6AF9EAEA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjDiuJ_5wDkQ7kNvwEtItkv&_nc_oc=AdoQom7ssZmlvWZFnS-egQniNP0-4AIgClZw2Yq2bA-xPvmqyHgtrYUR3JfOeLmczQc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1YjkVoonc1d4viTchPFYi17uRs_1ngRrM2JQIJDF5MQ&oe=6AF9D18A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1e5sc0GuB14Q7kNvwHwGRAD&_nc_oc=AdozI6z-8D8mU6RD309R05wJf7wlM9D59ApfTNXZmxljWUC-J1Gfy89TfU8lsW7lXDw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSVyj8pNFKl1IX9s0GD4dODzW-11QQgNqT7FBCwlY59A&oe=6AF9C41B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGjh6kMorAcQ7kNvwFO-JOO&_nc_oc=AdpOXotHpCnmwGf_Sxaj_B4mvCuZiIkQ_bgwD3sGngbojK6nI2_XGzqFteXJp70QYAs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwlACXcPaNbnA4Q5Jys-jSLcb2PT8qKLJ9bWLV-MiNXg&oe=6AF9B719"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaexYrN1ZysQ7kNvwFhhQrV&_nc_oc=AdpScJLD32huukJD6fx-wldsv2IkpjB1ihS6ep8VqPW-jAyp-dpC0y3hu3xviVCE4AY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=
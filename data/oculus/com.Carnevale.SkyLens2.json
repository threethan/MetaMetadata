a&_nc_ohc=5H-aUy_BNJwQ7kNvwE0PRN1&_nc_oc=Adk3w1HodwlZjwlmsNwdgTBIVoL9rELGuffJvsguc1rTiRM2ZS7I1LT-2fAuRhopC34&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxzRlyID5WMwN3l9biBVZawbcH37vl5uUdTGAMMOYwerg&oe=69B6B32A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBn1a_PEYWEQ7kNvwFW5Hn4&_nc_oc=AdmdO6FeocYs9yuFPPuVBfugPNOFjNXuqgoixn495sgxBfVI1KTVmTyU774p7vu9tAA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1e8aUx-fRPbjt-Wtad6MI0PaIeM26xJz4fDo0ySAS7A&oe=69B699CA"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCRvTS1B9QwQ7kNvwGTX4yS&_nc_oc=AdmDip1e9ia0AlnuAZwqMLvHuAZFCT7IHZs99F4gSnPBtW_EbY7IkP_DKsCSWYRqZfY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwm742R4kWKv9RuG1C_EEv-qBxMaUDJQaZLR74CP1HWnQ&oe=69B68C5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gA1Ow-iCcUQ7kNvwGC4wY-&_nc_oc=Admdku4OBYwiSZ3RlbcA1qW25TjnGzDJGN5HON8SNEVq6S0pqLgOWyE6orAmd1F78rY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNUdCirrnFNHrinltwoDtZP9aRovmKUhNBaYrTsV3GtQ&oe=69B6B799"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fW23SrGQ248Q7kNvwGXutMB&_nc_oc=AdnLTIhf2__-r2RPBH-v2EW9_5CFwMpsQ6kkGghAgretJSUuUIi5xXfbjFOFBcZ2wGw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwHRBQcla4XmLLeHOJGPj2W1YI539xp390sdzj4Wus9mw&oe=69B
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9u_YnZI4bzwQ7kNvwF3JwYP&_nc_oc=AdoIsTOEZyf4_guQiJb36lwty2l-2DvJmf6vapPn169CKcjX-2roxs7_xQsIzeAYfp0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4flu0NbDjaifFolTFCVlqa5lTMkSlKI9jHNV3ursa9w&oe=6AAA98AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wqTtCPuWOUQ7kNvwEr78xS&_nc_oc=AdrEK7GIdftmthYo83DCxnXA96pV2ah6IXfj2VMHG3m_Z2RKqRRRfyw4kCn0dCaBkGk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYaRjdQkP60jQblU4qXIPzCueRNSAFwVjLK30GMOmXQw&oe=6AAAB78A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfY67ZgJ2CcQ7kNvwE48bOj&_nc_oc=AdoZRU_bHhSA-Z3XaAJImM4b8pBUkVyN4z-zMfJbFXjPdecLzzDMcoE8RS4C5VvhQaY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWxiIZArBmd_SJ1F0pO9MNcrPGaJIEcbdbJ4Q1qYHosw&oe=6AAAAA1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_L6NronOq-AQ7kNvwHzsxP3&_nc_oc=AdpyTYfre7lfgQSjpr1GkWX_7EZT3Hc_fbZSMtpUkrXFIl0LiZ79TBmutLk-IelZQZc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXm--KOTSp2d2WACK2zXoerHijvvJXehsCsb0eEAeLeQ&oe=6AAA9D19"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EdGnK1d5K4Q7kNvwGTDe7Q&_nc_oc=AdpryYbPQ-YkJ1NbsgJApUAhsVXTUe5HGnTwWbNFhs2B3JL73P93OD4tIKbIUYFrIzg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=
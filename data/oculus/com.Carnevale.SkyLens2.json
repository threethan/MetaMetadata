o0nSVOLylWbPb3-YYX4xkNFCNP8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0TSGTRJlZVRDhsK1amkD09rqwEWwsQUNZ78-t8qrtguQ&oe=69F0B52A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Jqv6Dd9CDMQ7kNvwFcQfEd&_nc_oc=AdqNpKMmzb8-3XRwpYm3io6HL0a862ewn2c4BCQxBIk3zRhHoD7CLJSwKzGys5Ye5ys&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1T1S5MY-9pVMI-dI7mo1kfss101AseFQ0Fa5R-okRsRg&oe=69F09BCA"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zDKIga4RAAQ7kNvwFBXA3D&_nc_oc=AdrgzqVaNXJIPsndhB3ehnY_XR7eXpFXA9uq3y1GMHAEcJ5KpcvZRpi6rAPE-SCBynw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1E-zZ-0LKUDm1PDf8wDdIbs4AQplqRWRTfmvnzuXR2OA&oe=69F0C69B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_Lj__sDy5QQ7kNvwFriD1w&_nc_oc=AdpdepkRGdlfV87uwnQHrhro08Q3J30F2uxLmhe7_tiST6DaDxhHuTLSOnJ3sJ73eUw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1iETsexjAdr55W5O65zUZiSeDo6iUS4z9CtOKNHo79yw&oe=69F0B999"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00FZnR13wAwQ7kNvwE37b1C&_nc_oc=Adp90G1EUD-MO9InlTcqLapa_jUqyaGq3KeGe702OFAgwfViLqly5ndHbIAndKhG2xI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0ZI0VZamr2hYcseCRK3-Nvs0rkp9LjfROHveuqfERypw&oe=69F09FDC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SkyLens", "platform": "ANDROID
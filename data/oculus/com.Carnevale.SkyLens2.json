ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fS0dV9tI5VYQ7kNvwECM_Xi&_nc_oc=Adovk4jyJb_W7oSsv-8gm3QaMVKlAb74TrYMNNA31V-cEXZBuFq1Hdmh-RqfNj1KTFQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54P0WjEEwLhhFgJ6RMH71uLMd_hP2yCJDRvcwltt7T_A&oe=6A047BAA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hR5Fr-SYNlEQ7kNvwEDxlRZ&_nc_oc=AdofCZOe8hKMI0uaAAigrH8nU_XdIE7h26g-5mpAzU32fJ0GQRj9-etW5kV8cT3eLLM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55hAYbpCfey-_k8OugKrkVaXKdW88xpWlOTXPAPZSVMw&oe=6A049A8A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmq7RW4DmSoQ7kNvwGZLsT_&_nc_oc=AdpWptAIUvZ7WXElVnxT6oIQmnSeSsI8LybVjDYH3gzUAhS_V2IKmnxpTr_R6aIVHag&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-NKiOmPKvgV4AdizxG1LQY2W-4Fu9053EhF7_8noTSw&oe=6A048D1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtxTUPI-KBwQ7kNvwFCiERr&_nc_oc=AdpNdlcpqPOjRtcZJEhuHTJraPqG5XOniCMki83SIO5WiM_NJfzIHMGzTf1jblCXaLc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XLxRUGdobVM-VsWvs0ECumxBDkoL9TWS7EfdMvrhsTQ&oe=6A048019"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDYMt_-9eegQ7kNvwE9B3_Z&_nc_oc=Adrk08dpw7-T04kR9BhJFesG1ulYRAZzb9bHnBwJJ5OWa_iLufOnmv4ueXAr_8o8C7s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=
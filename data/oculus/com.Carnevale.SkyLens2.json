ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySRJqNmA2vgQ7kNvwFdqo4e&_nc_oc=Adqo0NLqlPXzUIiCiWt0sw8fwioG1Qkbkyj-htIg0xrH5CdjuCbHHJSB4zXiirDkl0Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBy4PF-N-GM6mT65C0GBjDmtF2nQbfBX5hM2uzLy12c4Q&oe=6A5A2D2A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hprHcmxZCsEQ7kNvwEFnUtB&_nc_oc=AdrhvpOsyB9kbUBKcKU_pSDNvOyh5CLItJTZ6yu1ZSo_rFS3OwN5dSYPnuzlk2SUDDE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB28P7SaHJiU-rVPjSH2bKY4n2cz-ytWX0Ik4yZUGbmvA&oe=6A5A13CA"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoHMLSYUyoAQ7kNvwF_dX1t&_nc_oc=AdoR6PUQqEOxG-xUXtFACPydwNvytGZoEHtmXjrRdjnPbMumXZKFl0cRai7qrawXlxU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDulprXwYaulPXPUb6ogPoYsLS6lai7PZcwgYRjN5dbPA&oe=6A5A3E9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggeyNt-GPEoQ7kNvwEKtHt_&_nc_oc=AdrDe2aNBBDL8vXUKuyVPNtiSZP0AcYiBHhiTv0-Hla1Mxg_ThiCKEy_b7V06LDIqd0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCLRGhpTJ1klNQGzXb2NwWMntJFgzfvKGJPgTbSsRMoQ&oe=6A5A3199"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FgM2RAV2HoQ7kNvwFwpDId&_nc_oc=AdrUnlnsOTmmRQsU-bfKd_UlbSc2LbB9buyHFKpz8Ox2n2vVS3nlEity2bakrfl61dc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_gAyMv3a-8Q7kNvwEtgalG&_nc_oc=AdpOT2kMCiJ9c966_7I6x9OdloinBIh4Thoyll9Z9qCnzQx3OQUpNk32LcPopLos2C8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NbjLNUdcwUOiFQSCjH8S3Ho7UMKiKUDXCnkakrPfC6g&oe=6A0C64AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKuOKAXKCcQQ7kNvwGtovYY&_nc_oc=AdrOcNT_z_l9LRjxXDMIq8-06himybx2CmzrZ3bWKDTlhYpTXtXJ2wyxGSyT4Ze0tEs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KsIo_LMPlD1wLNxUbWqJCIrR96J_Q1G2XHkuqC39KVA&oe=6A0C838A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxP3xCrAHiIQ7kNvwHjNlfq&_nc_oc=Adpl8sAl8GMF_-JVEFCKe8vVIQp06Uoquz4xP5uMgNqSg_d5wpo4MKF9VqwE7CqHw-Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UV7HHQ45NnVzBJTGQeiXLrXXuKxy6tfho9NIXlBlojQ&oe=6A0C761B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIOoHYEulzAQ7kNvwFaEzP9&_nc_oc=AdoUP4IuEzNN9BXfoZ_EcofPEdfIcnt0trArcb7TAdxhbsbL7mF2kkBivzY5DEQcKDE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5A-K5Csv2zIVF1vQg7T4_e_kF4Z4czuqeauBXCWYFjbg&oe=6A0C6919"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sp_QDjsKqpwQ7kNvwF-k544&_nc_oc=AdpUxQfzefCNatNjSmLL6IlRvq8SSe1yULsfwvACFBaKtyxI6xvbKV6hpMaGO_QjVTk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=
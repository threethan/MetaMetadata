ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6rGT7LwhpcQ7kNvwG0putu&_nc_oc=AdoOdNjReAj1O8TCkcnAiVFiLqKqmzSJjIXMmMy0kYWP34nb9UvOzycSpGmQlaIMkfs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjJYarIWKJYz2fIa73X1Wrp75JysMV4WUv4HD7a1sEpQ&oe=6ABD0DAA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwmvIZeBuOQQ7kNvwF5UeBT&_nc_oc=AdoHnRUz9a81xX-WYSb95V1v_h5VuWPRyc7cZ06jDp-XzxnRFABjPfvbtejyEaaLagw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhyjWVv1AwnUSTrDK0gcMoBISuC-RGuH-5XX2qbcO52A&oe=6ABD2C8A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxZgBo17O9YQ7kNvwFZ3XFO&_nc_oc=AdrMcrWrAPgEQgah58c-BkHXeyzj2R9L1YpGNxl06oItnkyul0X8ylcq6pdlBaV5jb8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxcd9gqTyIoJEVnBC4zEPRDHF043X3_i8Ogw7nGxW2TQ&oe=6ABD1F1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJD0kjQ4PBUQ7kNvwFRbyKK&_nc_oc=AdpI2MWqWia6JI0dgs-Lbd-9_29pvBF60HPLuZmVZb6GEPCE8k8Bcxd-9dM5E-b7jk4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpEArGeVPgKrYBrMEW0SzDDFbzKRnANG_wcnrtbHQDMA&oe=6ABD1219"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-y_Jopv4ZmoQ7kNvwHS_W7U&_nc_oc=Adqi_ktWS0nmBmJijI4QkGelWEX5oin5VX1MmJt1CLGKFfAC8e4UZfGtCv0eoi-IzNE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wqbx_wQDnkQ7kNvwGfbay4&_nc_oc=Adrnv6E4EXkNz0ypJwu2yf5V7g9Mf6Zo5PnFgvJYKC5Dpk68m7-dUT6MXoen2gnXtZA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9s1uz93OvG0kEibqmybMerNbOSizckeMVVlbU3SaKQA&oe=6A845D2A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qidObkOKHcQ7kNvwFA7Awb&_nc_oc=AdrntIhyWFecWOTF6VVdWhiWdM3IpHdrbSoq5oSNwI87tpxI0T16aIJUu4Jtmfi2YW4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbg0batFHU4zdsV9EsndJmXx8GC1UwWPiMODhLnXLPpg&oe=6A8443CA"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEkdH0NFKlwQ7kNvwHlnQQ7&_nc_oc=AdokJ24OBfeqVFyUCLL9udC_Qb1VG9aMxYvxeFNwFnc-DQ6e5j1g40Cg96BY2SGJc1w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1uac6Kwg4o4ZhlDuELkfRdJ_v_GayMpuhJ6NGoxN5CQ&oe=6A84365B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKNyrKzcAuAQ7kNvwGgOOdw&_nc_oc=AdpYexGUK9YGcjIM3zg-CISD-G1OIg2J9dSmhjEOFy3yTjILnP-QxfQkM39FIClp_r8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJy0jeqsTyUcZh3oxnW-cMuKh5gfK9XXfr62JCSSgDsQ&oe=6A846199"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUeXwcqxmuoQ7kNvwFM4LWT&_nc_oc=AdpXbamxZ77ok-yknGp-SAeDEcLuianhuUFqxKHrMRSPwiUraflUoyeC9-gh5gw8Y6I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=
": "1218938712766523", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982608_1218938716099856_607862685058392298_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lz53MWtF9EQ7kNvwGhiD2C&_nc_oc=AdrDnqNvSF7f_zP-18tOvam8TJGiKIIKGHA2fKtRJVYN_E4v7phWA7P2wcWHqKZqD_A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QuJUtip-6SD0mi1cFk_nL-fXVpejyqQ5Hj4UxkHWZHw&oe=6A36AE75"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing Skylens, your passport to a new dimension of weather and location-based data exploration! Immerse yourself in the world of mixed reality that seamlessly blends digital data with the physical world.\nPicture standing on the bustling streets of Tokyo while checking the current temperature, or virtually strolling along the serene beaches of Fiji as you gauge the real-time forecast \u2013 all inside the comfort of your own space. Witness dynamic weather patterns, explore temperature variations, and track precipitation levels across the globe. Whether you're an avid traveler, a weather enthusiast, or simply curious about the conditions in far-flung places, Skylens reveals a world of invisible and interesting data.", "short_description": "Introducing SkyLens, your passport to a new dimension of weather and location-based data exploration! Immerse yourself in the world of mixed reality that seamlessly blends digital data with the physical world.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": 
a&_nc_ohc=5H-aUy_BNJwQ7kNvwFpbFfo&_nc_oc=AdkjcKWdWtJmqpakSFBTdayP78ghDlJ21vzeeGyxzq2BqRLiBBcKANvx_dm1tyFyDno&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwF711WNzKHKZPDshj59avoiVeTTblgU8sH7Bdlc76ivg&oe=69B561AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBn1a_PEYWEQ7kNvwHLfx3e&_nc_oc=Adl9E_l4yna117pW7PAjHUDHdAdFYnQOWzSmPQOgcd54_KYY4f0j1Nl-nR50h1360lU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyEsATjSZI1mnjT4H-wYVHxBWm44n5QrV6kRPldIOCcaw&oe=69B5484A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lC2jRnY0YmkQ7kNvwHZKby0&_nc_oc=Adl-EnqSa4GiFagTUckcx0_rayvjH4R2eIlxXDqkWUSHSk8nvZFbn6kAil9kUFJuW4k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzErBkggoxXFAhPYnh-1LEc1E0e3iD5r9I-A2xs956xSQ&oe=69B53ADB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gA1Ow-iCcUQ7kNvwGdgZDa&_nc_oc=Adlk8Bc5pjyaDrDBSMapXUkOAXBza0wphEbAnI_Sbx7rlAEn-XJY5M3pFMLFcPDM06c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGrEmcuc2clkLjhqZDg_4z4B_w9Aybu-vwzuEbIGpoaA&oe=69B56619"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fW23SrGQ248Q7kNvwGgqBdJ&_nc_oc=Adlhvw8Rg6EX5gO66WN-iZc98hfr6HEsmBpTxf7KnvveZOu0abGldLXB2KWhFpasgAY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzvsKiEqCD_klHaRtcduvF_w70yBq1JVxIQNDaQpfQSEw&oe=69B
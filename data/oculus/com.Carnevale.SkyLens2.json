a&_nc_ohc=B71E2tC2SlMQ7kNvwGwGtOE&_nc_oc=Admdm1LiD7mq5YfchN_q4Og3M76sm9SUQWk9xe0XILRVEphHOu668Rpcrl9AgXyPq_E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwTOkl_PLyuYO2J1RxEDOa3ZfSKOmbbOAWCXvhiXNZ8qA&oe=69B01BAA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fod1fHv6s0kQ7kNvwHZvgIg&_nc_oc=Adn5RMuzKcmcF7MeLrnwEMM-85wEqorMVIkExOym3fEYrZzXw5Rjmq2mgBauDgK_Jzs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxcANiErwCNmiyDhrez8FqBKorHKVjK9Kp3xDDR-TYaZQ&oe=69B0024A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eESchdQKGNUQ7kNvwFYjfOK&_nc_oc=AdkL3G3hi2UVNZV3hKnQOu_nrGlIv2O9fsIy-rN05vA1DF_vwrZPefAtBIf84dJ_Cw8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx21B2uB0zcuY5kly2fvHS51c_CrHKz98Po5qx5WoPvcA&oe=69AFF4DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3lwhjlmEiYQ7kNvwE2KRgD&_nc_oc=AdmqE3vo_kh-Dz0hCZvnThewh4u4_S_l-9-gMeOsBfouK7qr1TbBOKuKOjmzZ00XsWc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxKmNAS5O90KGTpLOA09suLbmWkpuEgWaJcRLJ7Xtyvig&oe=69B02019"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfiCY9rMo3sQ7kNvwG5NmiO&_nc_oc=AdmD0WYi9fdgx54SKHXLWrSqbv1G4LtdvyIQd0aXhfbLuc5XFwMVlAnq-hydvBkv0bk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjDUK7jCiFLnzGuDAGWlnaSbxVPbNJxe9ILGzLRENRsg&oe=69B
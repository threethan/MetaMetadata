ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMLHBNMMU3wQ7kNvwHgR1D8&_nc_oc=Adq5QpQLD0bh0K4YQOTcA7ZMAhNlPJOd7VVCTlfDIJ_QlFPBw-G_GQgiPKpnSdvsP5o&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-3nAVaNe86RCcUpbgMyDSfvJQz_ItJ3JKWgo0CNlUPQ&oe=6A10592A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6utoFUDGB3QQ7kNvwHDoQX9&_nc_oc=AdqjD0TNKWBLg5ma-9fAMsSbHa6yEc90VZMNcxGVFTuOx6btZ-iegojaQNNeI_qbQ-s&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nMF8p_HWgX2eq5C6j-b8gpPLk3vL-hJknmwQG_e7kzQ&oe=6A10780A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cp71TJiGpBUQ7kNvwGr9KFZ&_nc_oc=Adrou1i7tkWdjcrP_oqbBFo6lzz3J_2cdA_6ddkJQkC_OJv5K1LKkfn9CgjBV0BEE5U&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uGbZGNtTufzW6Eosxds64_sju9jyCcRTMW7nvD-9LPQ&oe=6A106A9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wD9U5qZaqOUQ7kNvwELhdcm&_nc_oc=AdqqFp2H__RZFg2XFpvVcVg3eXPfxZJXDFLWVj3FpjjcNjp1GTk_DE1CuypF-_Y_NC4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6n81BL_hnYkCHVEgJjBkQi9DqLMQc8dAt7iSGqd95Rgg&oe=6A105D99"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNrJJzn8LawQ7kNvwHmsNBo&_nc_oc=Ado_kQuLTqpYFmYCH31eSWxMs0NvMbPMbzf3wp4gP2AoVCluXUZ2QybXfdOf5zooZYI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=
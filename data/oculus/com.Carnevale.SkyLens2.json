ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_gAyMv3a-8Q7kNvwGP7C0J&_nc_oc=Adpcc1Re3hU_7aSWbHJ9lyPHGcxav7y1ORzmzuYX_TqWxWOEq2pxWRzLzF1rlTevJ3E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GU9nIz_vCCFdaUTaJSVabGfnrNQX9qdfrzDLtgyjZfA&oe=6A0DB62A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKuOKAXKCcQQ7kNvwG0AzBM&_nc_oc=AdoWQwaP5rZoVCO6w6T_8xBb8FbrsTwWIHsL9GCC4tXRNATtRyCe6VghWcxO4HXp_Yw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SiAFeRKnWimAhhL9mxjVv2SB1xX0KtFFGolluMk-9jw&oe=6A0DD50A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cp71TJiGpBUQ7kNvwGSxQJA&_nc_oc=AdpOJK_5KFLZlUvK-p6rZ-ULrSbku2T7Ji1P9w-4xtfX7hJtRKLwa3Y_qY8nrW6bkWQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZNuA4t2EilhVfzMBSFLfi0WsHHCZa2Jyb52cjliKBzg&oe=6A0DC79B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIOoHYEulzAQ7kNvwEN3MJS&_nc_oc=AdqPjkN5ib9eajBdMjyLv2S6r4INNJD9lE7xDOBO7PQ1VT0-LfujSK894Hy7LPyC5Gc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5q7dcyj4h2beWBmDPv5nkGoFwKfsDYKpUq9uqHKHZFCw&oe=6A0DBA99"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sp_QDjsKqpwQ7kNvwEb_gcp&_nc_oc=AdohLQmSlbsW-z6EVJUOgUCbziDOH79bD8ZPLesJLADrAGgDekvNEYzqPUXqUTIXHPY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=
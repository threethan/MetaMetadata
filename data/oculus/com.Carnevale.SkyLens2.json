ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dRJ46b0PzsQ7kNvwFRsGDq&_nc_oc=AdqJkDvYyAd40iqTpWmWiVbQ98Y8QHjCkh_LuwGmSs4dYr9vePRbZl_I5ju34AvUibE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRREwRS8eBaVT_2NbG9pzQAKEJABMJOKwDUZ0lzrs_kFw&oe=6AEF5EEA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwhwWthu7BoQ7kNvwHjKbZJ&_nc_oc=AdpWj3BCGh9ABDRwk92Np5MIl7mPQY_PKszpw7f-kSszdb7YgjNejlD49fiOcbQi2N8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQOSSzs_nFR8fOtWrwhQZL52KpSoG_rp3ik5v1vAuZTQ&oe=6AEF458A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHEEA7DiVVwQ7kNvwENLR5w&_nc_oc=AdqewZ88SJPOA-kal19UDdcz5Itze6ByB4oCKjRUx9R6mayq19oHx63nc66xaisjRoo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl3yg7F1Ku-7szuR1GpE99p2RcyNs1gFcpYqDFnDpKig&oe=6AEF381B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpuTJ4hXR0wQ7kNvwFE6c0z&_nc_oc=Adpw_QO-G1esySczM9UqTRzHaVGYk43sa171rvE9rRpfJws3C3wTmVozN88HjzSfYw8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkLxbWBPVLQPJ9hwchiOZsjyqvwOwmxslQBaYoZh_H-Q&oe=6AEF6359"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQn2LfgPIAkQ7kNvwE6cj0H&_nc_oc=Adpz9Dp1kfGccmeK8Pg0U2bD74840sRP0UDQNOEZlhOTrMpp_08n7UuOQvlYwNgondo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=
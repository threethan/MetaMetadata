ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8B-lWHgl1cQ7kNvwGIaRa9&_nc_oc=AdpUJj2nKgdXgTu8mtN4bQnIs22JXyWp47_bi6P3Ck3KrIEx-NoZ8iRudajDAl3EaRE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AlVLoo63V3lKRrxCGsmCG3lJ3MLB-rtpHwR9B7QXMcA&oe=6A2C08AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYy4kENzVQsQ7kNvwGF3N1o&_nc_oc=AdqaKlokukanEZM94zv7BDuwa0hz49JzeKkV1SL2m8yQ2rbQn0_vW2cCaS-3284Ugig&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e6C07mMhp0TFLefAysMWNoyS1c8j8Yp7a-4DKtIqKkQ&oe=6A2C278A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SbdlRCwnakQ7kNvwHdXZ-F&_nc_oc=AdpFnjywmjLrt1cB8JCT05q8FOiq3EYSpiwAqcIpTRAcVKpx9aPOw4MODZZUN3YIKxU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nElOH46dHq6F7700X_D854xzTfp6uwfBziOrZFmB-nQ&oe=6A2C1A1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2xS95d2rRgQ7kNvwGRFEPr&_nc_oc=Adr5aFIMvbV9sYLpqgvVUqd0s1gb1e1cFuD7pXzjhNvc1QpV2mzgMzHpmCYFXno1TT8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89_iuGwmNz6OKRWREbUa0mP4BAPbKAvviVWdXBHNXJgw&oe=6A2C0D19"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dM5kc-RBg7cQ7kNvwGsWGbZ&_nc_oc=AdpNT9ERtaDpjjR5BNDRAQEggNcvVCJpeYmxppdGAw0iIglNBcuumeDj8lSQ0iwaPNA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=
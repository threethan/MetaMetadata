a&_nc_ohc=5H-aUy_BNJwQ7kNvwFOyeuR&_nc_oc=AdmID3HBhXLjVVj9RkcmcmE_1-J8Svkf4O8f5OOqL_zYGcmFZ2jgWXTf_cu5kWB9wdM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKzrUYAFLXqtJLFhU46pcfuOL6sJqsowRl6e3UTwfFlA&oe=69B4102A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjC5v0x5iaIQ7kNvwEopsht&_nc_oc=AdkBFNtCVjUxlqaXbeAjHaWWXrJYjpgMjQlo2FE73GGqCj7ZF0I6lat4Ucs7ongbsxs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfybHghu8M1ZYWno0pclYGEovk_w2wQ2wfsKVVR5ip0bKg&oe=69B3F6CA"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lC2jRnY0YmkQ7kNvwEEcKr-&_nc_oc=Adlt-mfi5Z2E8Nr5UgdJkpWo1gIT0_jQyyUFJrngQaLEOexjH3qnw2D4Q49NRHziVqw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwabkeaz52Ep5ZELOnoNAp9iA5-y36COPH86LwnIa2e-A&oe=69B4219B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gA1Ow-iCcUQ7kNvwFPX1O-&_nc_oc=AdlJbYNukZsHNRVkfKDHSXSsj6ZIbsApdW3L_Av0HgAMvvtXewnWjs5BHLkzzATiVyA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyNaL02u39f8eJBviE6k7DOJNxxTOQ-ayZShJvbb8l8EA&oe=69B41499"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6x1cqoSjIsAQ7kNvwEkmCB1&_nc_oc=AdmssSt8T__9fdG0CwB1ob5EeL6hMyE_HxoJDpK2gfKlqHdy5cKqiG3hslXf3p_ny3M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyrKI_CNPecMkd2CcRhjVP3O1hUh9OXjcx28w2IPmdY7g&oe=69B
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMAytXdMn7oQ7kNvwHa1mdu&_nc_oc=AdoYExVBt-PlW8Z5av3sQ1h8w5vqLn7GGZSFdjAYSJHze_VkvRWdNZD3nbmTi7rnuhE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUNEF9Z3NncQsqGn4OCeSpxzUVvzT_88lgkOXIuv7pCg&oe=6A7339AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMwo_9upij4Q7kNvwGBnKaz&_nc_oc=AdoRhAZaYgV_SNKBaK0UL91OJ49g7yBknglfWsFsgj-Eb2dHYwplpSJqVAAYF8uIUww&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-vQz3BkaLPnLgxCtDKMxCbNw6XLE_9U-qVq9PwlGj7Q&oe=6A73204A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sEDtqU-2jgQ7kNvwEfRYrz&_nc_oc=AdqZGJffAFBJo4ToFHlpwLov-IP4ZinKBgK6KqZjL9ffhsHprGAGD_-5VnAT2w0DDxI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGX33CrR01vBKUi-_euxRf6bDcD6tGU9hbOrOmQ0Nqu5g&oe=6A734B1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3QWwlzRsLQQ7kNvwE-zWdP&_nc_oc=AdoLzoSV_O_7fIB-d2kND-koRA00Lr8-nTefdLoYnL8WkID-gEfL6wL0EIDKaBkbrcw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAywIl5kXf4x4rkpg_DKSR_MCDH16wR_KCdFpWiYlMrQ&oe=6A733E19"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXn9EV3Ohw4Q7kNvwHrrXrF&_nc_oc=AdpVfBzgOe5rkIMesqVaKYxI3fYgom1ry_nxAIZblv7BaKEWf4oULAALfivQuWYtV-I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnkzKHnzwQoQ7kNvwEzTnb7&_nc_oc=Adqb3TKvvGkwv_kZAJdOrwdok11_DvcjttRowfkh3FdCmqnv5igIsqHTZAp-nojWEVY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7O3v3E0Uwl-UJVDKdtGwIv3bDQmkyEFNyAx2yKuUz7jA&oe=6A1ED9AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qf8tEqA0joUQ7kNvwElijRI&_nc_oc=Ado7ncU9xuhMK21zinDZbGP-LiVFLNe6VM-QfWu0rkpU14bD2KCOINqo72jbRbYgijI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Qlg9IR0Ifrbcz3t2eeDfKBTgmp692lmMwOpXNpmnMRA&oe=6A1EF88A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0gp0I5xWEQQ7kNvwGm6HAB&_nc_oc=AdqCas6iz3X_eQMpsTlV2ayn5PTBf1losFq67mQebkxSYP9uQyukWO_61Aj1UY95Ayw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mChc2Z0JguXhnIrwM2DYa3vFZ4bzyK2Mu3PMjsL9Ibw&oe=6A1EEB1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTT1BSf5FsEQ7kNvwGt34Ez&_nc_oc=AdpHurXOtH5anuq3jdcWcTAN-NuY6poAtCmaHN-wg4CSyRTFIl5heI8EIA1ELhxnYrw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-vJ22N7hiBRgsDdAw-os8L6bfb-ITbZWHJZJft2E_og&oe=6A1EDE19"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_FJJSb3m-wQ7kNvwE-C5sL&_nc_oc=Ado6_xlu4b7m_KzXRd_Wy2rWeQpu7yuD_icKOLJgFeZ0BsMNDk3GhgF0swE9cTGFKTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=
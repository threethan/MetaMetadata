ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vw4sjA-PknkQ7kNvwHlKTdm&_nc_oc=AdrRoFgQQcv_VShjy94t5PGEJva98El51GZsk9p6XDQIK2-VJwjnPDeN78HPC93PGOk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeMnYWXph0lCQYBzBOHQQF6tyMPiOzBM-jjA34oghsaw&oe=6AA7F5AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9Hl6iCJ0iMQ7kNvwFGOUCn&_nc_oc=AdoiJdi1F2AQqsJ2EiNISo5HSXcoieRoNP3pCox2dWzNgczvoSMeg7Wh6TXZ4Swt18k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqjVzaBB1Qs2gQRR2fWbKVqj9PCO7hvjB_kOsoFsRKbw&oe=6AA8148A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfY67ZgJ2CcQ7kNvwFWLAul&_nc_oc=AdpoOYRKjTNhljvakl-yZrgMc78sRyJfmS39l1xiKJCD9FeU7KjfIEPBkfjWReiQ6Ks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJferRjWx9MNsYecfh2KRxupms5i03aqZwhx715lfHUWw&oe=6AA8071B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ln7QOSdG4z8Q7kNvwEI-j3e&_nc_oc=Adpuy_aEwkNqX7e1tIrmXBagIUVny6UKtws0jHmhfn4hDpDewmOrL5dskGZLWc2AaJI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqUwM03FdM-I8gEjT7SerzLNK7hHq0rMwqKme-YOHAgA&oe=6AA7FA19"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkB1JxUXYWcQ7kNvwHENisx&_nc_oc=AdoGQ_qSDby_AhzcG0qfy1oCXkjrTVw6DKT9am6oPf2J5AWwNNT7P6LRKni_Pc8Msio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=
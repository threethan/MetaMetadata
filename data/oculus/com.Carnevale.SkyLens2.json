ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AW7CL8sESkoQ7kNvwGtjTTT&_nc_oc=AdqUY2OJksPYwAOgZbYe0mNAPsMduYJZdUiqeSZhejrlRzJBZzU695RougNvKEZ7zVc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP3VjP_xrXEUpGMVkgPhsTPtO9uZOWxE7iSF8Vb4e3fw&oe=6A8AF4AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3jzG004cmEQ7kNvwHKQiE0&_nc_oc=AdrTuceqgSpQmVHqK46AlD3me-Y6dE2ghf0gPmKN09g1V3IRptV0EM9ovn2WlVf5WWc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSiqRW7MnimcRAVC371Cn2Bd5J84Xeu6H3lvsw5dfZCQ&oe=6A8ADB4A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAlleLX998sQ7kNvwGLzgwa&_nc_oc=Adp6_PHAOH2H46o9fu2CkDnt0hYN6Yc9nFbOoAxVYnFJhom5ixUylLckTWIOeGezraM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEof5Jv_UjiehhfwfXA458RtGTB8o1rsvK3F4V2VZmkXg&oe=6A8ACDDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOraZdLmKeQQ7kNvwG8gQeC&_nc_oc=AdpYQ5wqqYcyrVQ08mkyeqVz0SyhrN8noeMupSqpAGthdhAslVT4Ec5q4-7VLq9N90A&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJ2qs4Kqs3NsbBgtbkb-nWELN2TUI6GcfLgMImhhCWLw&oe=6A8AC0D9"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1Y_omEYm64Q7kNvwHKDsfB&_nc_oc=AdpefHqYiwezjKQFA13MHkBxWp-swYrBf_9wNGe8Bj7rS7ayxzqJs_AXk6WXl0XbI7w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2MiePmiypQQ7kNvwExW2Tv&_nc_oc=AdqPiWAS0zgxzHzQku7Adh-ibn67HN8p98TwLNd5HxM2QQVIijRMKCVhjFCgzFTX7OM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lyuVhYwYfEB3-pHrfqruM9iFvDX6qtO5fSS5Z7AHveg&oe=6A241FAA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_0nV4BQLU8Q7kNvwFVCtr_&_nc_oc=Adr9G92-jVIc4YquQP-bbOFxJDRd3ahtzhTsL_x8kluM6F8Bmea2PVNAe5pOXyQpTVg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0Y7UYGxFZWYqH4OsSNUEqo6dMSnYvIYxCu8F6jpxwyQ&oe=6A243E8A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=928Vo8UFTXgQ7kNvwEwFRYY&_nc_oc=AdoJIlVejaiaY1bMm54lZaKwKMCh65Y8snWGZQVIcOydrWEHW0xl3lYtNjfbkhIT-z0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RXknXhDt1ycrDIeYoVGpq-w9_oQ4BCoIRLGGGv9S9-Q&oe=6A24311B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jm9HG2PeCW4Q7kNvwGsR9KR&_nc_oc=AdrbUTxaKVhIVYEQWgmCWjaS3w5usUNmPPH-FCmwJGUSO75ySEg3_p62SHja1eriK9k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yC0NQ_ZmXNKJ4L2grWnlknksqDLO_SofTy8VWtbEV5A&oe=6A242419"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSjtu1sPVnEQ7kNvwH00L26&_nc_oc=AdpEdtj_MDZ4iNxQAq8KAvrtiKTn8xROth0AregGFQiYD6WhSZNpnAn0k_LmH8MdgDY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=
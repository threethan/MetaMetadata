ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emF7YmOnkKIQ7kNvwEZLZDM&_nc_oc=AdqRbLfjIwI43zeJkQqtMwcVYywbdQ9wUmMHxqMmXmtTSoc8-b6s9dbHW3AqHCbDN5Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD527pdK3KAyLLFtGjkRqTxSKVGZCgZWgPQ-4YCQwS3jA&oe=6A54E72A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtesNizSiE4Q7kNvwGHgK4t&_nc_oc=Adq9nJSYTZKFUcQGDLIPzyyJJ-wjSlh2FHF7ULCBDWfaGH3Z6FRPJW0T0-3QOyb9Dpw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0njgB1B5DvTMYOeTUIetV0DfhnL2n-JdVlHSF3L1eSg&oe=6A55060A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udq6aW1QYwIQ7kNvwHh7c5v&_nc_oc=AdoczBI_YluDpcJya1QGl7nR6zbY7GgIwkexrzYq432CBj-iEJUPajiOzfBijXpukjY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqTcCetHukrHutcUEU2OlKMN9Pu_qylFttoXJwIStC6w&oe=6A54F89B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGqRyWOD9e4Q7kNvwEvlbrl&_nc_oc=Adrc0i5J8bsfWlUHmiMgr8mHymcedBKw-OAsBx8nL-x_BLAaFT2QXCmxT1lPwGPMlqs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6jtjWJFUjCkgIq2xpus3IZcueSwrp74wv8HRwdS6_Uw&oe=6A54EB99"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eS0zrZ6EVEQ7kNvwEykC7a&_nc_oc=AdqFZTwvnnkqEnacoUihQF7rQkINeXOXSNri9PwcFz1C6wWameu91AhectdmefflF_A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=
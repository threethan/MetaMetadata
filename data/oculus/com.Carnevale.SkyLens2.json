ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fS0dV9tI5VYQ7kNvwGpMcDB&_nc_oc=Adp1pu8wa4TAUWJF3Xxa4DXw7c--v9JWHmUa8kuCSSR7sTpe15dwqptw8ditnqAtDxo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7C5_xWCV0FPDPjnap1ouQUhZrQvWRPXdPNPh7SUKDshQ&oe=6A032A2A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFyWYHuJybkQ7kNvwE6YoBq&_nc_oc=AdqSUbRQMD6JGIWO4SfDoiIa1ReybUSilp9y1rvDT7e5asNvmZkiDqNm_8bC-tYgr0Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NN_3Ws5CHoltn3XtZ7Vtdcz5x3obCNLshyYLN7kOKyg&oe=6A03490A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmq7RW4DmSoQ7kNvwHbzzEu&_nc_oc=AdpvFuhL4zq7iBh0AN_lGPWhrvogP2JdoeKtsJ3_jtgpyFAznTa7Xclz-z9DDi6ufDA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lUb_vt0gtqdKH-00q2imLeMAYCCLj2I_B1oPOcdAf6Q&oe=6A033B9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtxTUPI-KBwQ7kNvwGQwjyz&_nc_oc=AdrqL78wxgUkRURLLroz9vF6U-jrYTz1rSK-2OZ9AYut6pPNcI7l0GY1vn-wxrqbtB4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NchsROmqlPbPcMfhfCPY0ot07uasw5ncuVslnjMgFyA&oe=6A032E99"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAIIITmfDcsQ7kNvwFSmhDF&_nc_oc=AdpA7ywK9rA8-Md_bVFPitboxPTKuQtyHTGlEBmZ7uFYPh_f80uau8IYZ7t7Nh3WIdU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=
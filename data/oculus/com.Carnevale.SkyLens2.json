ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHsD9_Fw__AQ7kNvwH7hD3q&_nc_oc=AdpPstAaFuAoncBrxWEYqxCwBpD0vtyFPKo1ozbm3uwJtykaQRdNpsXl0xFhq7Z6zJA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQDevMpHiAzNxPqEPpVOtoOzHnz-fcF6phKbGnkHscpg&oe=6A918C2A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMO3NJJayC8Q7kNvwGnLrYS&_nc_oc=AdqV9NylUeBZ8DqMJl1AHKrMnNvfIUR8x08KKa5hfmT21ehibAS65HJ2TNyjU6Axscw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0fAqWyV6Ceu309sh3V0vRY7qSsANyc1M9DBvj_xsdWw&oe=6A9172CA"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LH4aKGB9vHoQ7kNvwHSjUqN&_nc_oc=Adr_BMiOcA476SnO2qp2hPkKEFDQLirIVFkbGKkkQYy37GzUoIyK58fWJX3diBNfHYA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVDTHVhax5PVakaOzgI63sKgJRUZXmhwCZe3SYIoN71A&oe=6A91655B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9Ifyc6mzmMQ7kNvwFxlyvf&_nc_oc=AdrQZDmvYHwkElmTkEIjv5OjaQurfD-sg_IzDS8lKG2ldBI1bllls0jOt9efIq2Kl6w&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4y-eo0jX5bSTLPszQPDgtYBPip2BzkPReSw5ZgRmWYg&oe=6A919099"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wArxCAKhCkgQ7kNvwGwW4Q1&_nc_oc=AdovfQZqeNw583uMoqGumpzRm0N0cnl9Unmz60XYMxoES_E3L9b3a41nF9WrSRie7Es&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=
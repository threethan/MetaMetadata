ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1DI85A6EtcQ7kNvwF9HyCI&_nc_oc=AdqYRpC7_zvnHzluyODtCA3yTWPrg6gsetYqWbl60qdPgbE5RJoxJsn-tvzaItsC3EU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YCwEgSHC8HQG7v5ILZ6Un1zurc9g9JuSgndXvVP5xQQ&oe=6A47B82A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hix_MtrJxtoQ7kNvwHiMxOK&_nc_oc=AdrJwvutLivCIjFj_4OUHaTYwueH8FWw1Ey3Ua4i_BIOk4FiDjUcoALTM-s8HiNjsUI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eZauGhmlrSO7QltoXKyhG5hneqwuAvtDDIG-0hDz6oA&oe=6A47D70A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-kcscfOnoEQ7kNvwHSMuPp&_nc_oc=AdrA6_njAFr9WPonGy843rCY2asqeTwL0FE_6NcMjwJduEPLVqT2IZh7Q71G38_ErbQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TC_IpfPCEmVjBuJ7MyJpn2--_rqoJwsB5a3v6hvI0Ug&oe=6A47C99B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8L3ZuDnvtF8Q7kNvwFDeDRs&_nc_oc=AdraM6A-E7oZE4lQXbfHi5gPFi7BrdvsyvvFB4qvBkJy98pdhcf6x0QtcQZVdtyf9D0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6N1rjh-orwpvDFoDNKcxi_7XO1vPKGGRGk2YRI74IVA&oe=6A47BC99"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRLUw2UUf_oQ7kNvwHWuvEN&_nc_oc=AdojrTr08SMKNEymTZRLV99wgyE4ODDzJXGlslteQBM9S_M9ZIoIbRTkWSkrE0fPKqw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iiryJm04sxIQ7kNvwFUpdBm&_nc_oc=Adq0BM3R92eMu8JTRIg_T0cbFINHH1l5DWrwD_dUfM3wQDnxGSXYhpsnreuwUGNJPyY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2LAVOrVNZUozft2LvIl_zu1OgbkSeFTZd9N32q1PU2w&oe=6ACE696A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NS4TU4s1NdIQ7kNvwGPZUbn&_nc_oc=AdoHl3ZQvl8F2VwxT6wWY2jeUwsvZa1gxdCea2zZ-L3ztqbRxU8Pd8BNEIGR-hx8_7M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO61E6154Vi0L0WjEJGSA_Tpzx87d5db0EMasiANPgiEQ&oe=6ACE500A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFhQx9vzJVwQ7kNvwGmwFYz&_nc_oc=AdqjQRxjvCiIsCPXuaRIoHiwaLjEVxK5ZNR6_JowHVvLEgq9pvvgtdsBJCpzGrr8YCg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNNBCXDJQfRgdghQx0LqkWcWrEcJLRF7s6o3zejv4s1Q&oe=6ACE429B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92VgAYB1czcQ7kNvwE4KcFp&_nc_oc=AdrjO2UDqK9Wk-zrrCWGMGf72DbP9B_qB0kwBzlccl5H0rYbdWfTX3Ik6dlatjfAYJE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM85_DNtcP2ClfC86I8Sdr80ivMfeY0oVGi186kRzyS9A&oe=6ACE3599"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIhl2hPkH1cQ7kNvwHrPCGq&_nc_oc=Adp7uc5XUkQOa7jG3sRbC1tUjD0ZTP-T-F7RXSP3wYuPvSrhMCoWlz4eaxrgN4mdva0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=
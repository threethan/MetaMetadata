ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8I5VRYJM0EYQ7kNvwF45sh2&_nc_oc=Adq_VTnhVrR_6ONyOBqMV4T3yhfxeNOtExw1_v0pH-1XHzx62Ba-te7QtU51bnSMaE4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4jlz_MCSOS4LZQYzIXyPk-8NzQTLO1Yl7rVKN0IqCSw&oe=6A4E4FAA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZ7qMs_IfYIQ7kNvwGYQT5z&_nc_oc=Ado1nMZoZzqVq0rW57Xh_PpjOgXr7lXyOGANmTogFQps00cdNjUWkzgmjTUQgCDTmMo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3BnqkqWVDBn28I4E-vp6xB0F4A_R7qvW3k3oxv9RmEA&oe=6A4E6E8A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dU0dCaR6m2QQ7kNvwGpljmT&_nc_oc=AdqZDWxIjBpSNHh8cxPzpS6LFB6t45jm1yumodnde3Zh-yL-swmh40ARUCT7XPzRFz4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDON8R3U47vd7yG48BEBy6Hk2ASUymJ_IUdlxFcas3Odw&oe=6A4E611B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kKrxn9r2wEQ7kNvwG-2nko&_nc_oc=AdrlVIv5AExoPGLT7lywnCRIpXz5O2mhxcoVZo8yHJSa5he_vCuAL6rligsENbaNl6w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPAfD3kyCS67fa7sgWjtT73QN7G2yXAyci2Iw2gdsQWA&oe=6A4E5419"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHk0EdTI988Q7kNvwE2LqYc&_nc_oc=Adr2Lowe39rGqgi3HDfeXd4etv3lFKbCiWCRSdxFKhaOwinQpM3tZWAAJtH2M1yGE5U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=
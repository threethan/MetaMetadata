ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKYnEkM6EUwQ7kNvwGZIhnT&_nc_oc=AdoJ8RVU2Ehs_IfgK_BEZWenvdtyzdCcSkGfM74OohtQsV8v5UMngXmTs_D9NS9h7lo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzxxuEoZ6jFdyE6DcHQm3booNbuWERbPrY89vTS6DMN7g&oe=69CFBFAA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SJTE6wBEzkQ7kNvwGT2_Mb&_nc_oc=AdrsjKVqmEjXTw2t1ln0qDA1QiMPTMm9TLK6WamJzzo-rfj_Cmq3LSNMJyPg-J0RBAk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGlvKNiimvI8w11VvEEQEJPinnoLvctvdvMh2cqOhDkQ&oe=69CFA64A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsAc_XEAV_IQ7kNvwGYWuyG&_nc_oc=AdrggCCaS3k3VPM6puOjlaIEfxrbcyi41wpcZd6WwOEVDORmCcN_UehpFKMqrzjC71s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3fNSeNA0fZeP60QGhkQIaGG8AmVVPlfFNrxrdKxtWsQ&oe=69CFD11B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqq8aySSAboQ7kNvwEPFgcj&_nc_oc=Adqtz5ZCKOle0EC02Z70LhNkh5xOx9ib13xXf6XdyX9Wl6hmDGA_tPYhghwRyOU7oUo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwYwPqWgQD3PISLjt0EUAOPNXezSWD3di0lfOJ-fu2unA&oe=69CFC419"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgqVenQTeJ0Q7kNvwF2uW9k&_nc_oc=AdotY27_c_9kV0IkNSCDZJmI5s_BpCpL56xtPL_SYIADEm3qU2_fULV0C46KbUdGipQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=
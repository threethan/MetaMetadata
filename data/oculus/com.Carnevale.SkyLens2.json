ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emF7YmOnkKIQ7kNvwHv3XDj&_nc_oc=AdoUtF7F72Tv2IrQu4iJpcHhzXSX277iMFB2bXmM-8k7dP_5ht2ZqQDGfmg_JuAqusY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAE6gK_XL5K6NOioLPylRnvC7pn7uQuQ-KkTr-0kEwgtQ&oe=6A5395AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtesNizSiE4Q7kNvwH8MO9N&_nc_oc=AdrAV04Y8SfImBOPq6aGhNe8gHnHpPftsuyKYzNB30IKQ0ph-JFJtYVL6sTEM266Qj4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAy0rugWB1GGdrUFdXrZlGtyWmXKOzgLftNNwEBhAKAdQ&oe=6A537C4A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXffaiJDKJcQ7kNvwG7zB6K&_nc_oc=Adp0FMtBe51rSHquSSkPUqUdvElB_JtGrjGyoLh74AZNk8H9lRd1MBAXojPM8D1FxRk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFJ8p_T-x5ovxM_aG3TbIl3dx-EbxoGC4hcsvA-u4SeA&oe=6A53A71B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGqRyWOD9e4Q7kNvwG4M7Ny&_nc_oc=Adpmb8olJ1IjWD1s-KLSjkCEe0T1Yn44-_8Ibd11ztNNufZpYTHUj1g_aEtl0d2U9Y0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBF_RFPpfjF95LhvNbVe-p7oGfEWsgnCMDPN_3Mm1YGfA&oe=6A539A19"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eS0zrZ6EVEQ7kNvwFoQ4g2&_nc_oc=Adq8wF0m18QgWt6Sg7PotNVzoI9ZycUKYn6YmxXXufTrQLfeJk-Z7ifDwV5VLL1SCts&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=
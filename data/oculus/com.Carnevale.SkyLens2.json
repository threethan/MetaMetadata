ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3Zgz-GZ-NoQ7kNvwHqFaNe&_nc_oc=Ado84wD1_y_OZNaepCdbUwVtPpUoBjhNSZOFlxSPnjE6MoOnhhG63jSKhnLHgXDP-oo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjkZos0Rq0cQjBH4T6XjwtCE0YqLA0OiRumqFR_LGzmw&oe=6A69FF2A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2w-H0nA5B0Q7kNvwGUEbaU&_nc_oc=AdojybpkobTjEmlmuYlUhkMLtsIYtZ68hmFzdBcfFa_suZcQoth_Mm1zTFKXISZlHg4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwlytj7sgIFAGsYb7c3wT04-Btsg_1Evu4rsn7rbjNwQ&oe=6A69E5CA"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Mv-nLo6aokQ7kNvwFYuZbv&_nc_oc=AdoImvxFN__6vx2ivUoZf87qX6UEVleUVLJKMLsHd5lh_Ugd5cEc0TQOhzOHODMdZHA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAML9W_Z2gqhVRKB7l-7K8QydflRL5WS56KQ4l6EXTKqg&oe=6A6A109B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4t1C8EoS0AQ7kNvwEhRDWV&_nc_oc=AdruQ67Si1N_mcEpRWGULU_9aBtV1G6DFpbqxdDX879PF7WeW5f1PLU3vWvkeqYhwBw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZ9D4Ap-nVyIPJBu-xFJONB6Xs70YHjWHgAeXPaemAsA&oe=6A6A0399"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=locs7QVY6PgQ7kNvwE6WiFp&_nc_oc=Adpl14hcOOWiUlyirAtsJWVIjrug56dGTxgpZrY3rvo3i6nXxvyAZvA1qy7TMiY2Img&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=
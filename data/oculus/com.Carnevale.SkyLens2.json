ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApYSpEMbOKMQ7kNvwE_hO5d&_nc_oc=AdqVKkklUhSL69XeBrQruObFBjwXqpmWb62S09XRGbsi57z_GBBejq9ln5USP7WvWk4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af929z8Jx8D3Z6lGmwCW_LvtF5PKv8dm78O-OVmP2k1YWA&oe=6A3BDAAA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7MjqASTuowQ7kNvwG3tlCG&_nc_oc=AdoFYeZx56XbkbTTQverSXQdi5UVqz6oXxqRHOFhMGuC7zN44N7JxVu6jdF_IFwmfOU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rQxYd8ECO6dIImIrXK-Uibr9w7E0GUz6HgvKBuuFsZw&oe=6A3BF98A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfKdVQv7OToQ7kNvwFMuUEL&_nc_oc=AdpGvcStHLZ5TrqlHw05YYV6x0HLjKF3xKKm_myhS8Cw4Wx_clUOITUqHTw1oUpaB5s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Btq1sLrf6EfQFLlyNBWl4N4cgt9qqHDUEfht8Mc2p0A&oe=6A3BEC1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1GhaEwb3NgQ7kNvwGQ4STk&_nc_oc=Ado0tVqhSirJdpqO8WJhX0x34Yb-dBCpHVXpksjej25SOr2d2YHBoHCVUn4nX0S0mGU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YnQ9PO8_F0kMAOv2B18Mo1AZyW01C59yd0B9av9PWYA&oe=6A3BDF19"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLkrCIq14kYQ7kNvwE-0I3m&_nc_oc=Adrqzhp4qrJA7NohSVA5b-z7nAW0MB5Mt9TLdoS2UsNFVYU_bvAtQE9njJe-ThqpNdg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8B-lWHgl1cQ7kNvwGICmA_&_nc_oc=AdqEMUpQHsu-3XwA3RoCnxR8wPiA4YCbfkFThNy9iPMMCqg39OwE_YpBpet-s20ZMQQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bP2HPJQ_KLnSq6kJhQh_2H4imn6V6yrKnRpRCA9uEbg&oe=6A2AB72A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsAohQlSdo8Q7kNvwHql7bT&_nc_oc=AdrjKp-3JFGvk3NfkJi6HqJggId3bAQcylAeR4FOPxUmAFizC0IfIklejq-0u7qEk2w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lhUYbFUBeiz8KSny67tJShrhNmac6kcNw0XiEA7CEkA&oe=6A2AD60A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SbdlRCwnakQ7kNvwHUhWPi&_nc_oc=AdqAjm6XM1Q4Mw2qk9y6dllayU4a7MH9TtD8DDVzBX0PYraBN5f18ruSvuR-VkIEfJA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yZSi9Rhruyg6MB9IBeJa0sLzIMoVhrvCJiuSYjs_5Ag&oe=6A2AC89B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2xS95d2rRgQ7kNvwGRn-hq&_nc_oc=AdrDaZtzO1HC9GZy7HqTeMdOuhSg0NJm4j7ZbMaZ9-hyV1RANbsjaS3lRjzihZQ31ZI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4SlEG-nXE4tax0Yn7FKSKFPTB2dihopU07YSw_kD4OQ&oe=6A2ABB99"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEbfZ0ZSUm0Q7kNvwEwVZSV&_nc_oc=AdpE9FojLxLfCsvfvntH58ZqqzHOcP-zPXVoLk_LoF61CvekcwV1NkMi4TQbImNvpdA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u75J_qrOCBcQ7kNvwGtc737&_nc_oc=Adp4eXnCEp-SAtXJvIJm5I74SysIO3BA-lbjs1g5_gjeoZtDzeGOK2XZCYj9WAmaiUU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZKO1g1Koui9ePqUMiA8DmDhUccbb-cL4TzBqXrHVXKw&oe=6AE1F7AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlBO5VCM838Q7kNvwE_lysy&_nc_oc=AdrW9RmsU8wvViUZcHBi2flwPbNspXV4d910XC6POqtuwsZ5DTyDfTHcy826jiBEz1c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdtL3ImEp8PYHSyIs52WXWNz_sNIGvo9fZ5A-33qty7A&oe=6AE2168A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IrKpJtZhh0Q7kNvwE-g650&_nc_oc=Adrz-wL5pq4-tOPo812GnmTvtFE4-gBFo6zNchACWmEPDuHIwu63YN0KJtNLXl8wm3s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpQvkDbCX6r6WqyeTMXcaMgXY-GHmrQyeEW_lKwoWeuw&oe=6AE2091B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6kPwZJvzDsQ7kNvwFOSrhi&_nc_oc=Ado0HITtR-g0z5Aazxc4pbBwQSRAPZdjf42LvxRqBCKpgNAP_G1wHkPTtqHAnwSr79M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJC8yIngxjm-9G46opq7HY5xgN1MycC05ZQKywJBdw0Q&oe=6AE1FC19"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOkeYHUcS4IQ7kNvwEYPAOC&_nc_oc=AdqO4c0VMAo8rivgek_CrOZiQkhQPVqZBxdeuUCS6XjjYSu1Tw4vx7_Rc2hNclDSvwM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=
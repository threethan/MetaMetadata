3_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIpcupYy-Q4Q7kNvwFnzo45&_nc_oc=Ado634tEWwbGldqrxDifQdvBRcSVuWMGKBrTRuzAfV1JpblXmkd8ULXFwOQL4b1G0bA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8p1lGy3cOBajinjVQNMuDIWZP8yBAmfBT4jaCRAv2rmA&oe=6A3694AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaExbg_1h8cQ7kNvwFBkZoH&_nc_oc=Adpc74YGSHf1zwY_uUYIyDpoEJd9NfzmygSd3uLl1BGc07_E9e00QtCwRlgmthLudbQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IegmoBgeJEpwNo-2TZNbDIOaIaEpGH3m1gVsI7KqoHA&oe=6A36B38A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YN84mzgA6YQ7kNvwHVctoI&_nc_oc=AdosrHpGQ2worymEzhOl8_xWfI-u6Hkvecztfb3vVcB6yYv8dy6txzPeTeVPjcLF3D4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91jAgB8a8XKkefhRHg5BPYRlzDDIKS8gpG9weBJfvxVg&oe=6A36A61B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxR6Jfy-PpoQ7kNvwHywNXc&_nc_oc=AdopNiPuRVSXm64HosnKbpwxr9CIHxd9yuvItr9LW-i-qWrr8i6dtsKVmWzJWekfdPU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-llDu2ZtJ-h7ynz3QjBjUnSFAk6Lb6d9BjUZvzTtaxcw&oe=6A369919"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbFGAWBcBkUQ7kNvwFN5Z6u&_nc_oc=AdqvwihiaQq0VRpBTO3VdsTGFB8RsaLX4Pn7MBK0JqPgSwTCSSQUU2WI63NKKfTfmIQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7
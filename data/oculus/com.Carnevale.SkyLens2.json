ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAuECFlL6x0Q7kNvwG-MXmJ&_nc_oc=AdqvpJJrXaU3X8vtAVPyRwjf1iMUKp0ej1lfUErC6ZaqWqE--8Fj1GwiG1JoQ3lIUb4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8S7egihoi07XqmUrlvpJKUTHT_sC8arFn8Yp0t1FjaeQ&oe=6A35432A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaExbg_1h8cQ7kNvwHnx427&_nc_oc=Adqq6UQjYrcCESBckGQ7HOFen0PWntfr_OVlFUyXBKi8AiYEI6zXdBdUyMr2XKVwvQY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NTC8U01d6ig9w0o0Cx_bSQx67lmcuPgUbIcaVi8EoQw&oe=6A35620A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YN84mzgA6YQ7kNvwGXeT2w&_nc_oc=AdqmcOkXbByKvzoUoearOZSvRAk9KGnz14tW5NvYdVLIZD6HyCEiRZgvzJgCdb-vBQ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9F5cBaU2uO-zVzrEuP-KwTgYx10lYTAaP2zBBrsjElkw&oe=6A35549B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVhywJ2cysAQ7kNvwFr7G1B&_nc_oc=AdrhucT1p_H6fBAzTdFPK87SxvLY_um0rdMkVL6rYjstmIyhRkafWlQNQ3gahmyK0Fg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91XD99x18tDR7z383VSkTCm-qEPF_gVmf1VQvWp_bm_g&oe=6A354799"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbFGAWBcBkUQ7kNvwE1eDLM&_nc_oc=AdrDeWErBPtuPeS2JN0Q-pb67wRHkbUitfJskBb9oymu3g8Zq7hcmkdNRRnIGtKWD7k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=
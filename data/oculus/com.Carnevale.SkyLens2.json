ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bM8lT3uq1YQ7kNvwELKg3g&_nc_oc=AdpHeGwoPzj2dkiD4eT2ygi4w8rKaWnjyV_W2gW3R-OB6Rd8-B050j_N7V1Zwz9QCCo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyK7Cto0t_gA7hNeqjtiwZImXmF32JTTMKFXIfBSRQ8dQ&oe=69C6852A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Gs1JDtuXacQ7kNvwHWkACj&_nc_oc=AdrOvSGySOwjQrreQev-W5LYM7PGcJ1t7VF3CTpaC64uNF8mGkoHJgWggNJ8hUPXanU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzoQ2yu_e68r6ejnyAwsij9BPTK-6-CBQ4IzsL5mTs5jQ&oe=69C66BCA"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WyjlZH3lEQQ7kNvwFBTQdM&_nc_oc=AdrOvAMGpPiJJK2DJgZ7XoKUhbVu5FCsyC1lX4XnF6a0RdM0iAgXHLBLtsTE05ORWAo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEZa_ChmGKpHVf8nDrpoQxcqGJSaB5J0wObHBjQVG0LQ&oe=69C6969B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmhgfzXLOYEQ7kNvwFpuNzH&_nc_oc=AdqBdX5K_DIRQ-h6A5pnpMNzZc6cpzTLHN-e1Qut7ZvUI_ur4tCfH_qRlqlqehcY-aU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxCdlnFFYDD8BASa-b26v5Qv32USvIjN5BOF6wXa5Gn4w&oe=69C68999"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POL2lrWzrbMQ7kNvwG0DODr&_nc_oc=Adrg-l5ItM0nOq-EsJ4KLk6QjPMANPmSxUfqh9AWvv4kmPwDoD7dIiqLprQQU70JSh0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOxxHmp5r8MQ7kNvwHxHW0M&_nc_oc=AdpaXaGbS3F1WS33ShwzMkp8_mv2aQwjgjdSDdXqsdT3w3B1yRoIgAk1nvW7j9a_Foc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqaeQsJKNh2fi6KNpKeA4y1eJjgaMYaVDuOuptN0MOTQ&oe=6A9C182A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWtAUit03fwQ7kNvwFAt8Cy&_nc_oc=AdofBVlzyvpb-Pcu380BrtN3ermYSOSHArqenm9xa9y5kOUp9qrU8l9525IpvV2Nros&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgKUHW1aQxBA-Bjw9JvmKnZvnZEh01lKwANNf6nFEjNg&oe=6A9C370A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrC8XtsX4y8Q7kNvwH8C1Pt&_nc_oc=AdpHW6_nb0b_-Ynz0BYOkGuLnMDRELEZ8-YTMghY9_U3FqFb_wlrduNmVTAI3Vhg9aQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJN3oUWR2YpRvz3v6bfY1m861e3R-pd2-9Hl3sFvCVjgg&oe=6A9C299B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAtMFVj9kCIQ7kNvwH--51r&_nc_oc=AdqyCCyWuSGURG4nSivuqvuhzOXRWN02figzSL0cs-GV1p9Ff8cFz3GU6HS36oq4WSo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLczUwiN21F0DAVtgMlmRGAAcNjN5oT-vJozlMSfLA8IA&oe=6A9C1C99"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1M7Dy53uIIQ7kNvwGt0EAq&_nc_oc=AdqQiE3GEuwHhTzbXvzKypUr1UPpB2A2x83ItcFcU5E675hkwuC5UQQS4PneWO2zwOY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=
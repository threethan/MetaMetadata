ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPvWYk2Uxh4Q7kNvwEDIgP2&_nc_oc=Adr3LCbOC566h-ASCLUpJjoIu0rs9NFK-gDNOWtPnbOIxc8V9l3IePXSwQ_Clr_KCpw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wl9Ac0CJu3O_ziqL7tQdP-2w_tK3sPhv0vYojBr09MQ&oe=6A18422A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSGPNpWz8awQ7kNvwE20LNo&_nc_oc=AdpNjRF7r5Zj6zUSWEPWT9qlkv1-iqCfOY8AjDd-Hhv9Af0NHP2UfjgPcAJjInMXn8k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zf1DRUyZTHw2y7RtrMfeFolX7095U7yoDzwitVxOgbw&oe=6A18610A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ew6lQj9cT8kQ7kNvwHRq24O&_nc_oc=Adrasi3103RLXiSepjuQ350sgm6rjwscgqAVneWmlCwXd2fGQVyMlJi72cBS1ofFLvc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6syZV8HdJG9sjAYgD9zRJRAizf6tg0e_09V7alsyMLag&oe=6A18539B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HL82RdzPhscQ7kNvwGmwwYL&_nc_oc=AdrCsYjmZ0911SeHwkTM7gZ0Jgr_MHq2w8xc-CpRF1dNPPhqu-_4E5yJDJQ-rTHqV74&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_fJxnTIt4BfuEkU3LPDJLLNf8hMb7-KHJIMvOHrDKOA&oe=6A184699"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skDqOalCHVEQ7kNvwENFJuK&_nc_oc=Adr2NZJnM8BDDW2ziLRjAKzivzjYIfRe9qx1VqRjlaFLS8LMmvK-kKuuLs5pdlZySQA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-geHMd6t2QQ7kNvwHITuKj&_nc_oc=Adp0vrFZaDAKUUURt_T3ZYOE49DWE2oN6Ok-r6HP5nXBBXUlKpsUY95_TUbxA9c95cQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFoB27JRbO1dBBBu49bG_amJp_PtKsUYBfqSWc453MCw&oe=6A5638AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtesNizSiE4Q7kNvwFZSQRo&_nc_oc=AdqFLDXIZ5vNpqBPXcEvFwYs5TNG3L1GMWIM0e-7EXfpYbNbcKC_u1PxNkDGNXr9YJo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAut4qJnpV_OJSKvpysbTzh5rvmuhG-GOibneSqpU7fPQ&oe=6A56578A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udq6aW1QYwIQ7kNvwFZ_6aJ&_nc_oc=AdpfkxGUcqvpYb5xDeZkdWfwO7zCPpwTAOYLPGnoUid6XQqmFBeDv0aaObFPnU829dU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDO_edVuGb70WkA9fxWyz4jvgGoEPs0DiuZXfBB3DFovQ&oe=6A564A1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ig-2eaW6y_MQ7kNvwEvuWX5&_nc_oc=AdrXYSShBcdcnVh0J-2MKbLRMgJhj0i5tllQffvLwnJVbggmiEUCzmSTPZIghMlfBSM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhkOhgCcLS_sMsCX1eJ8Q65YUzE8KHW-0Y8nEGesfoyA&oe=6A563D19"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eS0zrZ6EVEQ7kNvwG6Sifc&_nc_oc=Adppn5i-HCgOuSL8_c7tUaH6vl0NsFFDMYcZIR8fKZDB8IdN2Khv6jXzI8rp1urpnWQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=
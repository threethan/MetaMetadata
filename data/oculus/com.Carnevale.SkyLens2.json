ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpjOm0_clKwQ7kNvwG2ln_G&_nc_oc=Ado8QfkGLwTjtGKd62fpQQxK3UYdu6spIBDq41rR2cD73OBzDPjGr8QU8Dw0k0hIstw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90DhudeQVbqVlkZWUMIvJR281TcW97IBGmiOdT_jcVRg&oe=6A42722A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jjglPXjF0kQ7kNvwHjVPBt&_nc_oc=AdqVOJ4rMOm1kMhZWt2JELRsT16HhtspMg6mU64xwxjBddhMCdb3WtH29ryITll9H2Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tAURjx3ftDfGGm0gCpNnbcaP0D8HK-FTcvWsMO-g0vw&oe=6A42910A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgT7C5kVcZkQ7kNvwFigDg8&_nc_oc=Ado5XpManeMXB_wrL5YkcwjqogiQTEsSgwFa7DJezfIXI4t6B5PD_tAcfFLVGJtnA3I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-h09Vqi51oYdeLw_Og8VqWTigiAG64W5vGEyzj-xDxsQ&oe=6A42839B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifwwA6CEFvwQ7kNvwGGSqaC&_nc_oc=AdpuX4nzGbdev4qS5ujX1MZ4gAQKwmyCKX6MZUDdDC60KtVPO16RCXtn2uQxeGNVS58&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-u-L-pfRYx3nt3Cuy5Z2flaaaHaA6mQPNN9HZo4JyoLA&oe=6A427699"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4calKG8T08UQ7kNvwHXRVcE&_nc_oc=Ado2iN1qL4bIHf6JV0lr-72sv-BwS3ua-WIOMtALxy24Dzuo4jBuKRoR5a7C13NfT0Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHNCEJM42OkQ7kNvwHYUdiK&_nc_oc=Adoqd8iObxgr5KBzz1E9ue_wsOgg4Bs3o9Ix1a9QG4zwTYn36Pa4tNcGt0mkErvZ-Pk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LPpVRGKXBHkmkqzx0idQlEhJBrhCPioiZuayQnVLkGA&oe=69E3862A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgR-4cdF6p8Q7kNvwGUiOX9&_nc_oc=AdoYlF-SjLalcnVbL4-Rd3amqhsNRWtxCiQXu9CCDh366EaFqGVUWwxCIqlVjTImfqo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PtD5R55wxmoLCdksloA2r3YMHLH-sjrfPa2FMBwVT7w&oe=69E36CCA"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsxpLGlOROYQ7kNvwH6wbTi&_nc_oc=Adp0OSM1aHfX2kKWfswvjoMyVFkbtSkUd0uVONHQX95Anom3W-ZJdCr_oqDKxaZDbfE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OY9P7gsrfJvGxi9Ww_5n3W5Jn5blOra32QtJcazvK4Q&oe=69E3979B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAhFWmYYT4kQ7kNvwGcJeTg&_nc_oc=AdrM138J6pSBavFfr1x2aaxD1iGLOgV_HcoUA3Y-kZ3rSkDLMMM13odZCbBsDyXOKVk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vWDZwilFud-QL2YPWwqmEW0LbsAg7NrIzaqkyMYMGug&oe=69E38A99"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rpbs0Uh6qXUQ7kNvwEcLhO1&_nc_oc=AdoUr3rUIzn8VWhRbCsBfTLoicqKONjrQTh5Jznwv3fAWV6YUXjA_noV30CwtAMCN0o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=
q1-eogVRY77SqMjBe-UzxH8dQFU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvYbM11GR6yLILjuuBXLZ_u6uUgDnEHPK8R98UGt5Xhyg&oe=699DA6AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3AXRlC0uEoQ7kNvwEoVEEq&_nc_oc=AdmBdv5A2cxX7MZEzXt0qnI_7ZlRCFsHcluGquVa_9ehADhhHvaHzE1lTQt-7nZfaD0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsxVODaND6dRdLHo5ld9zLKZgJXbN8xE0UmjaImjCO_og&oe=699D8D4A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWEXN0DT68sQ7kNvwELGFGO&_nc_oc=Adlzexs642ZGWIi0Eb7oSTZtcegZNOcNsJMobXMVfExqgYEDBRb8N5ZUk8gGZVlYN0k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft5OWq7lVfMudOBse0czT3WjTMQl3fFLzmRIGpXq0akCg&oe=699D7FDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=337BBLp7fMEQ7kNvwGL2gQD&_nc_oc=AdmlAboyX98FV7I7XbtT0JD-RdH8Q995toRKt1fWsYkrmrJs8SWaKSFFvWURHN0NB5M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftEntpDjqobLr6YeCnmSkQrm-XO0QslrMcJS726DVtnmA&oe=699DAB19"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lo6nxQeQ0noQ7kNvwG2pQ2_&_nc_oc=AdkyHfG9EdzwAupv6mABLRyKabGK2EZfU-ccc916IhH0_25uJEeVSjZG-zneF2qolvM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsUgD5IGDV4rfSbZCy6wOUKYktpb-SkpOEtao5gTizXVw&oe=699D915C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SkyLens", "platform": "ANDROID
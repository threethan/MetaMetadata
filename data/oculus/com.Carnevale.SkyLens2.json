ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpMoeff8XfsQ7kNvwFIc6Y3&_nc_oc=Adpl_n1ApBbDzrV_HEftFYx8H6qWqAnN6Qgt_2ywlwdjQStUgl_CB-vBrx8VaSVX7ck&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5iDN4q_ZzMkpXxU8aqx3y5tVpBuX-_UcjCrOBORQIiQ&oe=6AD0D42A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NS4TU4s1NdIQ7kNvwHFGOsm&_nc_oc=Adpt_6MLx8p4Mc05SXj4ZPMuXEIkTFvLpQr1ovz6u9JtuCNwGsy9fAWIwDJA7geX1Ss&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdd-o0HvicGT1GF5-sa6fIPtkko_hIdZtt3lLm3AGeWg&oe=6AD0F30A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxWnHeebw9AQ7kNvwGNTMAa&_nc_oc=AdroRhD0fqSMkJIcy8T291TdXvc2gsuIHFA34FdXch6tzSNSWrtuZbjoox8Il8CjhII&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqp9sHiZyJvaydRGwbXDMlLygL36IxQh0zLz3PRzmcBg&oe=6AD0E59B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mja27XdyD0wQ7kNvwHUZHFS&_nc_oc=AdpAb1fG-v8mrfANEsbJ0ggnOObbrUvp2G5FOEp29HPyU5GTn2VJpIzVJF_T5yXK-5U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVrwUYRUArPG3muNYBvM__RtO7ef05CWNvA_5rGkIoIw&oe=6AD0D899"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIhl2hPkH1cQ7kNvwFHD9JX&_nc_oc=AdqkvC5LRfxJdiA_gQn7Zg-BeZj_TZpUyEeb-PG1IDviMYufEywwgL1WUsGa-N2KLXw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=
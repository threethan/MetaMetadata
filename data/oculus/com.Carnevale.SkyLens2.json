ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qnxKT5pWYsQ7kNvwFgLC22&_nc_oc=AdprEWdtpAcM1Ze_BYHUM-eyHqpqUr5-JSSMRr-s-71zS7UdWe8pS08LbSvna1ADnSA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CbStBaVl7xODLiNzPiMQu3AVBsarQE1sYnEqCVViA_w&oe=6A159F2A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ThfqpH3OK0Q7kNvwE2HcY4&_nc_oc=AdpPzib7eJFnwCDqssKGMoPAJmBYbOq3YznzY5MMhC4KwpkhV7r8jSba2EoLpGYuMzs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-Sdb3qAelCVbtpxALtdbRATPGDPJa7qMUFr9-ZFiDKA&oe=6A15BE0A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ew6lQj9cT8kQ7kNvwH0EA_5&_nc_oc=AdoCKUbSU2Q8-5YDW6sHpC_KKd4AQ78y6XD73JGxMjmWTKu93aN0UacCv3U6-rz4uns&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WwpS0y5MC8icT2tzejXRDJJq-ghEML5ZKgDdmX-TPYg&oe=6A15B09B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8KHqg0lQ88Q7kNvwHunFgA&_nc_oc=AdoSV4-mPEcUEO5ur-TmGfH8geNwOyWWvARWGpFXZHmEGbJP3n4MWblj_5RPhCegHzw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sUa1igyO4uxpNAbyqt6jQsPhQEEoMQ54pC0YCAFqukw&oe=6A15A399"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbgNNP7h11sQ7kNvwHc__lv&_nc_oc=AdpsAu-QuYHn2vhS_d9XZHbmzx71EWeC20KFsZxR9TmLODyR3qIe2nmM3PxMeDnSrKM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=
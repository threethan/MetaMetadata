a&_nc_ohc=Cyw3kPmoGhUQ7kNvwG1Owow&_nc_oc=Adn3hyrevPkn_dMmRW-bB0S6hVO4mEsRoX_S0qiiV8fYZFniELuasYYE5_a4RRVEcJQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyMWYxhimW8y0p9b7k7a0-cO-JjQKtH8jRephZVotUZ0g&oe=69AD78AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fod1fHv6s0kQ7kNvwHt2itY&_nc_oc=AdnKfl6Hb8KSxeRcjFmVkyBpgCHdxchq6RvEr2Cc4UyNeCq8rKJspe7mQ_JQk4UD26g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTUeIZzhDIYm3xif0-weZ3kZIiMindedEkKp9DNlJ3Og&oe=69AD5F4A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABKFzX3YTaMQ7kNvwHBs7y1&_nc_oc=AdkSsVlgEaGBplexc_BzJI9uD5R1UmXZQdu8UHQA5dJaX_M4MO-qnBqkmOPOVudrB68&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2c2Ylts4Ff6EVsM3sd-XYi5-IGpgLPY9bfFKnt40PEA&oe=69AD51DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fhw0lNw5UegQ7kNvwGGFPw5&_nc_oc=Admr0tZArFMWmrZDRQw645P08Itbvh3Wp6bWLBwLYx-M3SrNOJoaTu2zeMn2Z_nYPuw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnpMSzii0GKx76i6to24gBwEozHpx8jKxIfJx5z1IyEg&oe=69AD7D19"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfiCY9rMo3sQ7kNvwEJNrSe&_nc_oc=AdlFEglXGQ-sLBY8iiFnpVXionvth8QE-wXcftYRDg4wmQgvEXfw5HlJylWamu0qzKc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwoE-azvBSYV062eJI5IOpY2pUDVAf-976ESgDLlpCO6Q&oe=69A
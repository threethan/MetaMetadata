y-t-wsDFQohn7DU8xQ3LPG1zuk8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afthzh3PmmrWPMj3WsD1ovRy3cZEMlrW0nxdS0CRLdIkFA&oe=69A19B2A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sII8iQeWTZYQ7kNvwHiBBWy&_nc_oc=AdmqOYoAnjnLI07KPHKXH3L8kJ6i3G3DHCUZ7ja7L5YTql-B4DRmF_ZwWHd2wseW61I&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftGicROAS-QlVrWsKhlum6qJ73vZxqvoI2z5GfJHtt1Ig&oe=69A181CA"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p49ogRUFIW8Q7kNvwH507Sv&_nc_oc=AdmKhuinva_UsQsEeT0l-FBeyMPbCrKs3RMvz8c8UWvT1n3ZPZB_zfqBWSLWqSiMqqY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsgXeaIF49ZWnadNOQHBi8C6i77d53j-172JiWSvPt1AA&oe=69A1AC9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vQ1tGEI528Q7kNvwG97GVv&_nc_oc=AdlK23kzITEemQT8zwG6DSNUH6-x9JSlOrfRR5sDWiLumtaok8eL8TrSiSPwQA20Yqo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftTPfAGLmm4vDgwfct5q4snacWlgRbhTu4esyupJBToag&oe=69A19F99"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PH9CbN2gSDkQ7kNvwGZr0ec&_nc_oc=Adl8St3dXqOtoxsPQDo1TK6eokgXdXnGurT2sweiJItK6LUnBzOjOkIFFxAYIVucSSo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfueGy4kXG-NiNL-L6W3TKrEY-83WJF5QCObIHvlF5OAZw&oe=69A185DC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SkyLens", "platform": "ANDROID
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JpzmLwLCd4Q7kNvwFEX6rM&_nc_oc=AdogRdjYNqjAnnYJLrQZhYy3w-RG_kBVUq5h74yBrUnQlhKjrT9oRNF1cn7FIcPmbGU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8hvL0QABwexiNwiyljFE7gycaLoxj6JgJI1no14TnoA&oe=6AF3536A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9SKDlGk4REQ7kNvwGSbwbL&_nc_oc=AdpgdopM3jQU7NMOcKEddF4Ag9Ot7ydmXhSKN39KmIoEmGED62UB-lq_pTMXV6iL7FU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb4-Mt04f3FuvjgenwNNw919qWOOETTj-VHMdBMYKoXw&oe=6AF33A0A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ir-x4-V4ueIQ7kNvwGbHGEt&_nc_oc=Ado2yNxvW3jwutwLBJhJFBy84T7OwMp4gfqhmGgq2Qcc3kTvYsMFFW47tsOAr8vu-dE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmy7YqG88zw7QGzsCOmYEmIJqVqi61fSp5NbNJnMUr5w&oe=6AF32C9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-SgXzvwVsPoQ7kNvwFOFnmJ&_nc_oc=Ador2ZcXiyknhN85_sJsWhLLaVRbMFr1IcFhSRDsh5rjY2Jk8e6G95HuXDTWkb5NgCk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjvwG9XB5-mlfr3oZqVfw1mgyvc_ORL8eNj7gHXMG6sQ&oe=6AF357D9"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59F846WhhtkQ7kNvwEC9K1t&_nc_oc=AdoB3kah13CfkqbiDLYNnRTsDSJA7LiF9lrGihAU1W1FwWUcYzHOMDQK0y2aYE-vBCc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=
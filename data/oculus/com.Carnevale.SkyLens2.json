75856592943_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YqocnCBAk4Q7kNvwFSzCBA&_nc_oc=Adq989qHSHoh9rEDj-fmHIO92Whszn0h3bp7DY4AC2Bpg3Qtg_JyP6LPcnAFKdk92ow&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPiSZd3iTLN1KEaS5D-fW8Cry1_3Qqkbv5YLnsQAtW1A&oe=6A85AEAA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qidObkOKHcQ7kNvwGX6EVr&_nc_oc=AdpdzmOcahJ5284xiIM2nOdNnaxy_h1l1gJjj0GujKgpQOdGuEKm_XfAWxl6NZhQHUw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEABgiR13C7c-0XZ-JUaJjmpNP24hou1VyS3MLVFMKjXg&oe=6A85954A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEkdH0NFKlwQ7kNvwELbdHl&_nc_oc=AdooUbFjvQnpJIJ8Dnoz0Aw8EEJ2vD_prmsKBsRVQ0oNcaxjg44TTRJ-wo9tEY6Ip5c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlaiV0jSoYV6_yD7tmiO61JqOxRVV4LVPuupiFoPbEng&oe=6A8587DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kL1Mi53XsEYQ7kNvwEEY1nh&_nc_oc=Adrxxgor-9MgddWwr1HCwUHgaCQe-jityacMS7FaSC1d5TfH2MblL9EYH4t_TpkoLxI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlMXclIEmW1N1nfPy4-O3Mj9I6CJPfTrOZx6QOkZ9Nuw&oe=6A857AD9"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUeXwcqxmuoQ7kNvwF0Q9ia&_nc_oc=Adqhq9JaxxXxNJQTCfn63k9MUBx4WoRSfMfYwiA6E1kAGjcQuNcAJDwAHLomM0EY76U&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.
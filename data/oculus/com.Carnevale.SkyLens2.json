ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHNCEJM42OkQ7kNvwEc6eS7&_nc_oc=AdpGD6z_tQ0lkJnz6F7XJN4mO0rpNACk3uJ6rq0MqFsLsdtdnPUCp8tV0ctQE-vCemk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14jgOD-ITN4qSrH_2l7tGHArr6LO_4s4IlRPBlYGBXwA&oe=69E6292A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5aPeM3jx1QQ7kNvwG91EJ4&_nc_oc=AdrEkn19BT0dZVKfXd9cIuCvSPohxp-RHYIGmy_LULdfcOpiMNSaGZvBv5ZJY7EYuFY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3L7j1ZxnfNMbouMY8zApmSV8nw4_6hQ_wpLFyshKRVjg&oe=69E60FCA"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3MeDlKgck0Q7kNvwFCVeFV&_nc_oc=AdoEaSqKDgdGZuoDOMwDkY4KH0i_OUHTpbvI-Mb_Ad7eo11_Uf8kVllzb3i9JtFdago&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2x8PsOQe1eLtD37k6d3OrtkFNLYKeeqfvQNQZBuxmuMQ&oe=69E63A9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAhFWmYYT4kQ7kNvwGrO7yG&_nc_oc=AdrQw2IYfDtlJ_1GgDG9S9cMj4h5G0rc93Izjte22dTXJJe6R0F5S84w_g100Gp5zYU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GdfskxP1N5n4SPJ6wwESFGI_jFgxbOFqjcFoMuSfRbQ&oe=69E62D99"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=si4EQjYe--UQ7kNvwHMzYIj&_nc_oc=AdqhZY4ntp1mE2tfyZa2xx9lWEF8iofxkhrfnr1JXwCwdj2UbinIGmiEwkZ1lm1S70w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVa_EZxpXkoQ7kNvwGawkSg&_nc_oc=AdouwwCl2ja6V1gRVt54pSw8FOwNjDwMOGUxwlWD528EW2f-Z_JX_eGF77mCfCKWgOE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LOGfVjdkbmXebcfQ4qb5zc43ygGHh7nr2jx9dpOUz7A&oe=6A2965AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsAohQlSdo8Q7kNvwEBevFO&_nc_oc=AdpKvnOk45n7_h-FwxUNRCJI8j3INa5PyKDhkrvfRZDoxb9RrkXrHlcghLziZNVvW50&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CCymrWq57BpV441-Nomul1wJbxO6BTXHpgbK5zV6Anw&oe=6A29848A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SbdlRCwnakQ7kNvwEZnJwl&_nc_oc=AdoiKPpGaoJKsqYOCAGNgScWxDjP5b9pSN13rRcfhyhILkWtbsuCW72--eWbCeDlMQM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-b_QRKUinRgK5fXUEghGB1mo97N_QEkK5CpkosDtRog&oe=6A29771B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0c68YfMvkooQ7kNvwF5HfZ0&_nc_oc=AdrJfLTIp0OmXI6XuDmUpQNNcLQGF5M_9MO3xsT3TyVYSJX5RR3qj3wn1q2HEFWtJ-s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WwUlpJWwRLL_KSU2FpKFITw_ke3o0Y4B-vgyjOCp_EQ&oe=6A296A19"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEbfZ0ZSUm0Q7kNvwErLHnf&_nc_oc=AdrklSkOSuw6tuKSe29kowZ0UiVXF8tYvA1V_UOPFtmSY7ng5zZh53l-4ShiaSsN5qA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=
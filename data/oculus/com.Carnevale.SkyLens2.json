ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMAytXdMn7oQ7kNvwG7_nYr&_nc_oc=AdoUgfN-y0zL7mbx8lhKVy4k21d6qjCOXXl5lvB6r8ecJ1UHKqpcgyY2XSKVDMXh7l8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0ObGq1dijM8UEkF8FnAbwFttKj93xIOvnOZ_QhqK1iQ&oe=6A748B2A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMwo_9upij4Q7kNvwG3ETwG&_nc_oc=AdqEJsmAyFCJrPQ1hdj5dgB8klc5JLK-cRztm4OUWi-WAkKr4-De4VtQ9pJFeYiss9o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcGPL2U0HHGBOtjm7n7qS9jTd6orfKLuNQh7faTqFdeg&oe=6A7471CA"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdJIn3nlOt8Q7kNvwEg6US0&_nc_oc=Adrvo1TY6hZ8wck7uhvYDxQAJ3BQ8-W2CNPf-UJrR1CZABuQwVCUM3fw-9t1oJsItwY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkFOYyidf7xl__AoCqLxTj3Tz3PSJJyytJMUfoFN9TJg&oe=6A749C9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3QWwlzRsLQQ7kNvwGkxDst&_nc_oc=AdoqHgE2pDRH2WKqbinB9wg679WnJBgzgNTUuphe-TW5mRyhNGjdUDmKAvYKTmcT0W0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAfCuT_U3eTc4oiP2gENZm1V-ZY5VVFQIaeH4YRE1Zdw&oe=6A748F99"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXn9EV3Ohw4Q7kNvwFsFt3H&_nc_oc=AdreOP5-oChxmjxehaKiy96Jt09DPtHfL_x8-VUJwqJceo33kdS_o-u2edpovuLRHBE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=
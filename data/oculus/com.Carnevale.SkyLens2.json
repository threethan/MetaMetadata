a&_nc_ohc=zWqHk-9Wv4wQ7kNvwHRK8wL&_nc_oc=Adl0kXRjO7EILOffAHr5S28obgvOK_dPGDF1nhmtxZbczDVYRPsKJC7wbi9Rv5yXIsM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBevcjpyKyjLWE23QbwXXKa25OmYnCGbOBUnyqKS1pIw&oe=69B9562A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BIFqNKWLFQQ7kNvwGZsCZ8&_nc_oc=Adn0-l0JZfE-1cxlIYG15U59VGkfUjGbbDBL00kM1vP41iz23ZypOdepwQVTooTgybA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzvXHObbedqv7NEIiEkzdmrVEG7uaUEnMj1Pt8MgA52Fw&oe=69B93CCA"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCRvTS1B9QwQ7kNvwERdfdD&_nc_oc=AdnTCTujywLWlDAUwuKWdNGAWNaG3_vi-ZHiUpgAi7vEZrl2ft5zgl1rJwkZwYIQRXs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxvclEQqijf0QR-aFzdNDM8M3LHHzyNCDZNc8UGCzPj7A&oe=69B92F5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HQbfm0ZpGQQ7kNvwHIws1r&_nc_oc=AdlnuhERiQt1vKflM2icrTX7nm9cKwTi_k-b-of0Ni0d2PkCrJTyNwblXcGcFSgqhhc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyWyACd2lKSH7etyWbs5qnjogt9tLO4rEKZ4uaX-Y6mJA&oe=69B95A99"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNGkMT0NVk0Q7kNvwEjPAcO&_nc_oc=Adl6Ap8fuG__aiNNb3gzTLY2VQ2S1xK7mpisrFosoXxrRNL2jEIx9CXqsM1GVHR2QmA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxFbhWtsmWRDbkQWSuGW1Y4wEO6rSAVWsLzhfn6PFyK6A&oe=69B
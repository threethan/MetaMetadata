ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhMj6nG2rOoQ7kNvwGmuy_1&_nc_oc=Adp1np-BpBdAfhgVP0DzwQRGPmNM0EInRwelEw0E6b3FFbonhI0Kfuc8p2Gf00uZCqM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8ePhT1F0BxYjOVlG7jCuUB5y2KpE30iRkrn6F229nlA&oe=6A7C742A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vw_1IoHUOgQ7kNvwFE69MX&_nc_oc=AdpKx6dj-1lg-gpwKD-4CyojIUL1-1o97YjoJGtgHEVA4IzHsSLe9f6tm2Gqm_OUjfE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdkysXhXTXZvk6_ZeqCSLINylAYNRd9GnoeIvVaQJI3w&oe=6A7C5ACA"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u56WN0N07I0Q7kNvwGlZClS&_nc_oc=AdooZNe70__XzZkKoPndCu6gmnAhxruLfYa-anqajQWa89umr4yRVLkmCs-mi71m47k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgfoBFnB-ZlwwZdocHVK9BBEK2LpK4kHhtiz7n_noVFQ&oe=6A7C4D5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qy7fiQC3P2IQ7kNvwGG-5Ec&_nc_oc=AdrJCW5JydYABmWk0dRF_wrro1Jj_eOacBEiJEW0-ZiBwOkEqkTflDjC9eWHkpDt6Rg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHr-lObrT6J_nUj6guK1fWCT7ewamu-NsNL_ge6W_tcQw&oe=6A7C7899"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_Lyc8qEtx0Q7kNvwFCrSM8&_nc_oc=AdqiWf1-jXjsqK_lW4mEk3bu64hZ8iTwLR76t_7gVkVihTe3_eK9AUX5ZbWWsNps9rs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpMoeff8XfsQ7kNvwGl9PsL&_nc_oc=Adoo1y053mCn4SY-xgPyg8slAOgGzG6A026CUZp01bdDEQG6ak3SAHIg816_RBOt444&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQON5aZ4uukPC8JgMVSv_ytPijBU7bjHmm-EnceoUU4OuA&oe=6AD3AF6A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiSxRpEPHFwQ7kNvwEo2H3F&_nc_oc=AdqwYfnFbA-3r1Gq3SOrS_QSqtptaL6-W3aWZ6O_z3JX94ZUTaLiSATYs-Llkn1UMNM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxbFpOgElHOZCQgy8znyqaH9uYobI21m0ZYCaHXw_tTw&oe=6AD3960A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bb8QWhBjJgsQ7kNvwEjpCrP&_nc_oc=Adr8CODtTSeJzS-EpSWCxGi2P5VlQaiOKpDqPTPB91Rus4brnn3qi0FlJtIlnQ2pVrI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4ruigzQnBk-PgWu-72nCS7Zd3lA4nptDWhnbOA9UCRw&oe=6AD3889B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mja27XdyD0wQ7kNvwGSy2nT&_nc_oc=AdpL4yxJqZABI5Ie9pgzXQpdFYAc2adGR-mXfSVNCz8sTZ3T4BITUbKWJNgnfhhk2Oo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOur4LAksk20po2iA8qr4npXy6xZX9i7mrgObHPh3jwkQ&oe=6AD3B3D9"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVwmB3v06N8Q7kNvwH7LtJh&_nc_oc=AdqUS5JZnXMuryDrRB6DzHwQR40EVfFWun9DQvmVoQ5Yxbinj8BCsrwJvGPga6WsOso&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=
a&_nc_ohc=cAuwuCDPVVgQ7kNvwF9hjer&_nc_oc=AdnWwNl4m1SFYogCaZsuynj2NQPnQKj6e_BjvLy-5TqMkE6QWdkEf-OLBa5YSaXr1zs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYHAibeDYBF2cPDqkLiyX88zQrLCYkpxdReOSAWMOMdw&oe=69BBF92A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BIFqNKWLFQQ7kNvwHl3Fiw&_nc_oc=AdltxLdUX1_GDkY9ZciTN2AwghTh5RJ2MV6-jjeLKqpZsSL2YNc4W1bHDucO3lW6PB4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz8ycWYxqGFaKJQ_fgYTWxIepbqdcxEh0faebok5M6kMA&oe=69BBDFCA"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiqRXiH_U8QQ7kNvwGmauTO&_nc_oc=Admj5ddEVeYmgEILTTRpeCandHKIuI8tk6ulgXR0IRBO8RGJTJHIvx8_2ddDaIO5iJI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyWkpB58Q0i37lcQYy1CiYrQcnmikGtZ01VvYLSlUNegQ&oe=69BC0A9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjQGSMyjO3sQ7kNvwEJrOXa&_nc_oc=AdkctqYy00yw6FzVBFKj-n9inBmfAHrjo4gJ-bmQDEmhQBY0vUIDxG9Y1grqbF1UfYk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw005Nc6g_WnywUoMVdW_COVGzluK4q0trYFc1H74unPg&oe=69BBFD99"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNGkMT0NVk0Q7kNvwG3Mh07&_nc_oc=AdltwXL1G1ueng-RVAFRXPmTgkcd8rAYTMkd85paVHrBGm0jsLdLgRJ5djhYza7xMF8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxwZ9Bfgsue7_OL4ugBh_NsWO3jLmajJx3-zWIAtxNQCQ&oe=69B
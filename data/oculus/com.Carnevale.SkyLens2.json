ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wqbx_wQDnkQ7kNvwFbHfH2&_nc_oc=AdrDJW-KO4VyZrWUtzWx_qlnnIXWOWdE5vFvGKgF7Rb1N_P2z9RSpYxO7k5wuZ4fImA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0xxLI_2yGDwR3DGDQVGy3bTDPJzEUPXC9e5bYthz9gA&oe=6A81BA2A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqeSyNBZKkYQ7kNvwGKZdEH&_nc_oc=Adro5w6i9af38dmiaxvVKHC9YNuwXWK7jCKj1kF13FRNiGrvhppjYyit1fG0CZL7YNY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNX3f0Ny0dzdKQe5I0ZKML1a8N3vw4GDvimDe0RnPUEQ&oe=6A81A0CA"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zg4Yk_8e1BgQ7kNvwHrjCav&_nc_oc=AdprFs5ntXxogA-ck0UE7QjKTcwvzFA7oQ7VaB-lGZfyaSbVTSuEk6D7YQfzd8oSFCo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXwI8aVaXU_ecGxzJzB8CwiJdS_M9xBQu3RW6J7C1Exw&oe=6A81935B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKNyrKzcAuAQ7kNvwEUSG-1&_nc_oc=Adp4c-FK4JcbU4YxeqhodUO6xBMbuI0r0_v_Sk3_A9EtClT8A7MiMSjR4o0Nh2eKS2E&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZ1fUK5rSJaVW_RV1491qI1g0HPhPRpXMBomfaPJasnw&oe=6A81BE99"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dx0zAdOazVgQ7kNvwFcFyim&_nc_oc=Adqh3SRjpQmWLBIxOxdYgDF7fA6eEi4DVjmAeV_QOPHUIMkRG4e1iSnSegZnSJNUwL4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=
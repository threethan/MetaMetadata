ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EStmdoOob-cQ7kNvwEGdCng&_nc_oc=AdoJD4i2XQOn_rXaQY8LkP3O3iWAT6Bxd-IoMbWusHeJ0OQkLcX_TecopGzoI6nxBeI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFF79zLxn8WS2P0zy_sOk7QiuvPFemxTcJUn25PkEwzA&oe=6ADCB1AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lyadCxG5UQQ7kNvwFEiu6T&_nc_oc=AdpTzkLt_ZJ_-Gh6DwGgrZ2hdGYPYoNTnYHriwkNLBg4cfCAa7BwCa5Wc0e7mWOY-98&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuFQNDltkPFxO7Dr0xr4DWLGOwciIdtLqyWJxOy_6pAw&oe=6ADCD08A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_qgFGcKbkwQ7kNvwEy9qBB&_nc_oc=AdqPPxm-NLF4CIo2ko_UObV2Cousm47xU0Rz19yMFkwgSoyex4YwK4efUci56HxU5Fo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMieIcZ0fgbwnKq4je3dmAJvkEMUM02uAhsKvRwTB47bA&oe=6ADCC31B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_EuN45tVxkQ7kNvwHWuE7d&_nc_oc=AdpL_CCcSkcAOci1QNGvcbfDL6Z3q7dnS_jTHio5LHoJQDTrr_Q_lKX8Bu2SC0X1uYU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPP49Qw8G1nH9M1VQ38EAKEv23VoQDZ-mDzt2DFqjZVEQ&oe=6ADCB619"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZG4xuhKNC_kQ7kNvwEFI0Fa&_nc_oc=AdoQbYnccx84ymFVR2VIZWr0ABz-e7q3EQFbhdK3zZsADZri3RDmMao87vCOebXxrKU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcjDBwAGyZgQ7kNvwHJBx97&_nc_oc=AdpKsnnuXBPZEzjdJeg4ZiOb6bXH9Hy0eQXo0op1hwLSdUCRC-bk2LPLD6BduYxM4K0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0tovk2U6DNM94LKKKf_yZn9Qll2gTg_nNbeq5mTv4q0A&oe=69F5FB2A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAg93XSkR2UQ7kNvwEWkoj2&_nc_oc=AdokfMwuA4sPVtvz3rWAoS8BDVgUZMNYM9C--_Rx3g6jpBWggxq9gH8lzwJ7O8iTDvc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2toHwuTofSfoOLG73tXKOo8k6qQ6cwox4zxz86FDBh6A&oe=69F61A0A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItP4HlHU83wQ7kNvwG73f0R&_nc_oc=AdrKCMotKzyckDBG08qIRTwooTPH1zQb5Du8pxe9KoKWNpKfmh7jeXIARMPvjh23iJw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3GiKUB8eOdf10Tde_ZEUvp0OggxQnxAicCqpo6zDUg3g&oe=69F60C9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiY7EnmYcJ0Q7kNvwHf0XRM&_nc_oc=Adp0BxF3PPJwpzUap61WDYFKf1cqikSTmESjbnffiX9akhj38VZMviiuT-nTwqfXhzM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3hn3orDd8rMFED0asDwxzpFsxOt_IN5eQsZLCJoEEx7w&oe=69F5FF99"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Go5W2oaLXi8Q7kNvwHfdZKe&_nc_oc=AdrJWjy599jjd1Si84Y-A-_rZC-O5wH1a3pIKx6lAphqeawsriKYqikSu0NRGRLWUjI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=
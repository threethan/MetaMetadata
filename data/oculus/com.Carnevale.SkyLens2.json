ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApYSpEMbOKMQ7kNvwHuA4Ve&_nc_oc=AdqcWFh26Fp5fwJMGn7aflMq6qvjVIGs33TNJ82PBgYLuCtVutWJZHBifFGQmoQ4se4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Y9VHf9aHZ8SfmDsGTnTl5YByqCQZpW7mVC9Xw2zJ3Lg&oe=6A3A892A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfUjS2MSWFkQ7kNvwFrqXHq&_nc_oc=Adoky-WZt_w9DLrSCr8d1DXFmjPxu10ny8m-sOgU3frMnsfyi8PeqDzCgn8HDl9LYYg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZGCTKIl05PmFwWbCHvjZC7oA--MDv_BOlJJyRwF7D-w&oe=6A3AA80A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfKdVQv7OToQ7kNvwHqMphl&_nc_oc=AdqP_OiIh-8LhltOeH5il23a3je3rznhUwSEQ7Mb7wIMAsE0V_BxDOB__3-rzB2seP4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6vD9KQRsn9H_iDg0gp_mJNrwpHFM2QShra7MKTHw2pA&oe=6A3A9A9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1GhaEwb3NgQ7kNvwG2M6UU&_nc_oc=AdrG-YjCe-bcVhE0cbbCju1yCBDBtrMWv6eomMyIRT111HMs0UjGggosrWTSqS26wZw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HKZYyBFwfeaFG6u0Mn_Z5-_0UFk_8zZd3nS1IjwSx-Q&oe=6A3A8D99"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdROSAJwnocQ7kNvwFhy8QG&_nc_oc=Adqkz0ozJJrA2CwV__2KnVTXwFIJWorbfm-ofS2rPgDpam-Z-T0TgYZTM334kaE-6D4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=
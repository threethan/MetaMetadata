ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haR1C5RFUvQQ7kNvwEQ4onX&_nc_oc=AdrDkRcXHHkzxuTExbqijj4u5GLWrlxWDICWfzTrg_Ig1Wm78DUiMGTVz_9GN7nDS9M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Lb66caeVhwrkk4XX-R30aivnxxb8yDQ5mHE9H3IXNcg&oe=69DB9D2A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEQ1FfrWaOQQ7kNvwGJ0pdN&_nc_oc=AdrKIFM8HjMvZtDdzXQvnNzXd5kFC0bXNedqvhuWLwXJcnsZTzHU_xs_4A06CunM4sE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LJYddjih3bYSwxiOxe_I5Odf47ilzTisX5OUjT4hAQQ&oe=69DB83CA"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOhi1mHpukMQ7kNvwHtYDhm&_nc_oc=AdrjNCOTc_v3sspbBgh0IChw8KqXtoBYgPYez7_Z1wXB7zDlD1h9tCzz5CJ6wZeTsTA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DY-a0GkO6myy2dKl-KmPjknCK8gCtI5J8XpSIZzF15Q&oe=69DBAE9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAVOAjV0-MEQ7kNvwF95Yo1&_nc_oc=Adqq2VLIBziASAAYSFYgQuc0N31HLHzWyv4ID1z5ZpsGGLMmpaeiaWfk2NfRCoc4gh0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EcbguoGKhl4Ty8kmk5D27KSqNlwzII4L0FxU-4ScoKA&oe=69DBA199"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gz0EsGQhzfQQ7kNvwFX_mPH&_nc_oc=AdpVENHmWvXQRY26RzYkulylxWbIXSNGoO1XAi8VfBjyshxxGWrREgsgDD2viLWl7R0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=
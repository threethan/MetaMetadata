ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOxxHmp5r8MQ7kNvwHUjISt&_nc_oc=Adr89rm5eeyG6laG6SfNGjnomF06BUicc2BV8hgqQ5M_nZyxotJ0GRrfmXCkkCoTJ4I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKU96YAzXQPSFyshOgqPTWIhXRm28L20Kzd0ddxjyTPSg&oe=6A9AC6AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWtAUit03fwQ7kNvwH6pCKU&_nc_oc=Adok9406KCBXPhrzRoUjnERbei3DjcceU7UOIktvrA9L1VqI2rVB95tyGlN_f9YOoIM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXx2bhPQcKawHjtjAOw9JXsWCW5xQqsdTfET-zuKOdNg&oe=6A9AE58A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oS-XgcK45msQ7kNvwGPGjZ8&_nc_oc=Adr5k_wbittCQHjQ5HhL2wBLsBbF6ujlA_qyYitCr5GCCD_l35B_KjuFqRTw_t8zLgY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL77sGCvrn8jNyty1KKyWaja_MxzI1OsYhYSz_tlSe3FQ&oe=6A9AD81B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAtMFVj9kCIQ7kNvwGCZYdp&_nc_oc=Adp9FuNeeOIN8fFojIJ79XfqJ7BQ6HISQqxHq3_bG8S2MfRoQpik1wVQNU3ogdRDdoE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQP8AQJE_23xcHz6NFlM4P7HKaP8miWlQOVg3j6HPHZg&oe=6A9ACB19"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1M7Dy53uIIQ7kNvwEFF3Em&_nc_oc=AdrVNfMSh9FpMmICQFqCYvDPWwAAhp_ufjq-D_qBVZ2MYK7H5ycrA_KBy0LwFYjzdZQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=
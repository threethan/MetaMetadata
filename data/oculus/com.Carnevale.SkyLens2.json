ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHNCEJM42OkQ7kNvwFxtnRh&_nc_oc=AdoQOYBdHyape0_V47GBkvIh9kpC76jn__VOXixWB2ghqfvOdGRG-N4H8zDz82ouDx8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Z8UQPeyy-WV6Lw4-E86rIpikIBaOS58EG7zWQ41zVHQ&oe=69E4D7AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5aPeM3jx1QQ7kNvwFCCEKl&_nc_oc=Adqg6OEOEdplxBxs2T2Fm5YgP5nneI2l-USAIvR4k5LNskVn-l6p2x97HAJRMvb5YHw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-cn8Juq9nP83H6LEfM43q_95wMOw0CCH1Wg-bkgV29w&oe=69E4BE4A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsxpLGlOROYQ7kNvwGIaaa0&_nc_oc=AdrZjrD4CtIs6a2pbyWy5EJycKL1mGy5U7fQ937balB5hD6H4yKxcr_PQBR4jbGQSLw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1at5ERaIiCWWY6KHSTwfEv4fsqqkYiRJNGMPoVvmvZ5A&oe=69E4E91B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAhFWmYYT4kQ7kNvwFWXwY9&_nc_oc=Adqwr4VAh2JUKaVeXHKQ_LNANkwVfTLlEqELOhAZ3yaswm-hD21yT8D6lk72cvSRX7s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yworQ28m8VYYLlAdc4JATstCTOB1l0lLsXFrd76FuOw&oe=69E4DC19"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=si4EQjYe--UQ7kNvwG2WPDh&_nc_oc=AdqBFodHn-C_pVbibxIpqoC2GQBrBjzlAKZ3zFtPua7VGi1fRkzudr_Mo7Tdtbj1H10&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=
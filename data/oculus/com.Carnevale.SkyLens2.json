ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrGYLFvHgtUQ7kNvwHRSV4u&_nc_oc=AdopaouoIYndnTez7ZmQZVizffDy5XGtLriSgxUR2QgO1JwxnTenDHOuSN3HQx2Qv2Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdsyD6EYhVTOIMWC9TIA1R0HKAZtk6Oxxdege8m-DyyQ&oe=6AB9192A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiKADoojcNgQ7kNvwHmwl0G&_nc_oc=AdpyQ7JAf3zEhE4l_T4FDr7YpqHJWwSgRMoe4vL8RLS9XVbWlLf4Vm6VARV-Zn4zZbo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKyl3MbrwrceaybAZfI74qBMcNNeFKhXWc2aJUhfk9BQ&oe=6AB9380A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKbGRIT6QIoQ7kNvwHVozai&_nc_oc=AdpMeEfq4EFYd2m1q_VDvV_C5iPgJF2AKeHalz2lC0kuVJMfHk6i_vP_0-zaBeJibJg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlNk1RLPE9724tuGiC1WnKssFx0ciKto5zCfcHNDPg-w&oe=6AB92A9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WI0HkOUNQDwQ7kNvwEJFLJF&_nc_oc=AdrCT7SNYhQyQ9v_4_bjga4imK8BmQeA9P1B76DT8Dz_hatvaEUhqBEd_kRAkA5OHlc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6wHSw_GBAcdCA11YRlOWamjIa9YtsmXAY2qFidDaTxg&oe=6AB91D99"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nzHTrEtXFYQ7kNvwFUuWVK&_nc_oc=AdrS7GridKYdVhEppbZv0TOr9r4B1BGksbhqDx0e6JpBGig2ijEr1Qi8jrUZfhd-Ask&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=
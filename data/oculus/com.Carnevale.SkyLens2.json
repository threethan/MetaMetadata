ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVa_EZxpXkoQ7kNvwHQUdza&_nc_oc=Adoqn90y5g617zxHcnZ6Fh0K-v1Aw5AMkhuY_1dTFGXHNh5nGyQgqGgTu9u37rlIPhk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8MEawbZ8eQ3Wyy3LpfruNC_7UushLKGzdTVGUqaHdaQ&oe=6A26C2AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_0nV4BQLU8Q7kNvwH_vOHE&_nc_oc=AdoPcVkfWs5NC0lRzx3WpiIMdqsvwjJ2HaVk6mDtog67oEn-bfRliKfSKgzJiQcVFqQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NOgvzTYfF4aVpYBqIKpY869q57rW-ynFHk8ElXr9arg&oe=6A26E18A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0l9PBQn04x8Q7kNvwHb8hWm&_nc_oc=AdoSCjdPcIw1EBIF4K1cdeyW_t6P3Io6kNo38xqJOiSjKNZuVnQ4GDDjs15MzvJiF6o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-v2lSOX8RIMPDf6ca9aYFvYvTmpm-wNymypMtQv_eUjA&oe=6A26D41B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0c68YfMvkooQ7kNvwHL5aNp&_nc_oc=Ado96cg4U-b4AspaKCMd5NeYC38BaM7VTp83DS1KxBg_-qi_AqQV2BzWoBKPDZrjkko&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SnnqsXJtYj8wOPmuvty--0ijP7ADfVYvy8p0mXbQpMA&oe=6A26C719"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSjtu1sPVnEQ7kNvwGCrXFY&_nc_oc=Ado9p4grYakkpBByYmQRcpJw0W5VYkG3BFQqPhuJEloS3qIrGSEkwkBisKmqQe36CBk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHsD9_Fw__AQ7kNvwGTW9aO&_nc_oc=Adr_YDaMZJsWPQrCzcBlRTGHZlA3rNdn0tMpqVLDinCm_EckBcPSIXJktrcbCtCVu3k&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFI7_eEtx4lZmfnKzylU-tNk4T_fhYd2s3ymkz_BVM_MQ&oe=6A942F2A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FxyNZl6sDUQ7kNvwEJE047&_nc_oc=Adod_hOlEwFf3iQV52tWOCLeqoNmvj5fnd0_q1RhlGxZccHNFc-RGRpspAe2AnEGK3A&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIfE2ckErbr86ekZBn4V3qPbmHNRWXxmv59MdNHjS-3Q&oe=6A9415CA"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7anPkuL6XoQ7kNvwGLSjS1&_nc_oc=AdpQ3EufLoIq2LRltd4yy2jVTaIaCr8MPGPW1VifNCr5XK4LcWtDxiQM7gLYnjuXftc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaqZjCfbGoKM9KO6TaqaUWcV0epRo26eP730Is9bLZWg&oe=6A94085B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9Ifyc6mzmMQ7kNvwG8555D&_nc_oc=AdrqQIjSM06PeR9N4oLil6kt2729Nsm-4vHWm9plWIwalkf0zzKa9dhgW4bI-cGzjH4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8MBnQhIVPVpy2iw-YnbSnN1qerWne8eR-72adq_jhgw&oe=6A943399"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLoZduhlagAQ7kNvwHOYhXl&_nc_oc=AdqvzPF2R3qyN5WRxDmVWRKtT9lNSQkGxK7AikeYSfwkrvZpyKh-F5xW2vWgtghMGRs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8B-lWHgl1cQ7kNvwHOHUOj&_nc_oc=Adplv8aFb21aflAtzGzS9AKhbPN-EX3Ro8cVhyPu1TikqEne8o_HsHXFnVcJu7t61g8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9X8CB_iiSCFBSBQRe9hHUJxNM0hWODrBUraHmo8RAa6w&oe=6A2D5A2A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYy4kENzVQsQ7kNvwEE4vB6&_nc_oc=Adq_E-Mzz6LkY0mqZJbHIJg2dRfuorX7kW_10-ghjS1Vk2w_ljXUpI4Day_KXetov3g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-igMOuaAYVYAVRyJNpiAZRwrGXCj2nwHkG4sKEtlTJgg&oe=6A2D790A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zn7WEHV3rV0Q7kNvwHuL-Wm&_nc_oc=Adoiw4LmK3AHHIrVWzaGuPo4gR-3SawfxWKw27s7qJqCw8eNSCw4LvWk8PcVidgeqWA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JECRG6iDLmg0wxFvYeMGTMpiZo29F7y5-Sjcb_ifcng&oe=6A2D6B9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2xS95d2rRgQ7kNvwE7sOYw&_nc_oc=AdoFpfj4HmNRYlQdXsEvXm5AZMkoponiW41F2-IqmeJZjNg2684tIfp98QgApvSIVJ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_k3eN1xVbfqKMJIhJLsGwQcFEoJBrgjgKkGesNKG8D2w&oe=6A2D5E99"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dM5kc-RBg7cQ7kNvwGpMPm8&_nc_oc=AdpuaCvlhV4tTy0dM3qg2ANcAQNV1r1iGU-hmwrpo1-Q_JVBpsSA_7n7rGvlVbQEXpw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8I5VRYJM0EYQ7kNvwGyGmMF&_nc_oc=Adq6X8Xz1C3jWeswXVpOS_fN-EJxlAyxuZDydEeyJftGPux6cW2oinzpmTl0jnzGZl8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAF3bE4gEulRjO9lKxGs9-nTifpBBDrV37jCN1YY2obNA&oe=6A50F2AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=savk4xLk_5AQ7kNvwE78zYv&_nc_oc=AdoPSFjGJw-TAGZSVVOZVaC-3PeK2bYlAY5R_hAbKBYTTrlkwQrtGsfW0fNT-bBVA_o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB789_0lvhZK0Yv6Mvj2yyThczT1YHb0sibWCBdnP9ySw&oe=6A51118A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXffaiJDKJcQ7kNvwHoVTZ3&_nc_oc=AdrUSOKJ3fPnAYM8DrTLUd_B4ZxxSDKYHMSZMPpi0K9XS2PwtyUlPvAsXa5kRz0vfXI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_9mW-ZYZ2Z3mu1tyqCphJRlq5cNuHMPXhxfvgL8ZB3g&oe=6A51041B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kKrxn9r2wEQ7kNvwHp9Fl9&_nc_oc=AdpWAVk_vZYGJfABHVVD4c4hWvlZH2V6e5i8u5bQYAOKEpEAyuSWFaqur2gE-ZUIuBM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBxF-KdccRIzb1zPs3GCljP4hEs7oqEPF2u7gbrr5jCw&oe=6A50F719"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6BJePQ9gngQ7kNvwHxZbYa&_nc_oc=AdqIXDruspc5Ql7TSsBPI8KssVRlZMZ46_h97niVfeyGb0mbi5sww-miUIvv0UxxJZY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egnMhcMJJUYQ7kNvwGIRdOC&_nc_oc=Ado2AaKxzMp0CSuWqxI0DcUSj2Du-DztwaQgnqLYPik-hBe5TKG2q8r0zOqLGrdEjZE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VuDd7w6Ni03qpLObfhjpH5OfKypVTBRmnpltoUL_YTw&oe=69E0E32A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgR-4cdF6p8Q7kNvwEXVFb_&_nc_oc=AdpEpq5tl13cg5HJbJSrLh0b2MdDT5a77TrPuSGeIYHTH5BhPNCSkJSnU0s_BzIY4L0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af269wNmxExENq1qDZ_iuMW1GR2eOQMhwy-HP2RRYYdJSQ&oe=69E0C9CA"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsQzqtf-txkQ7kNvwErLHsM&_nc_oc=Adpc_Gyi8rpFt9-hV4fN0ZyteJDnPs4kwL1A-1tslTiy1bSxOpElRoREt2mS1pnGFic&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3arV7q7UCop966E7SH7UaLmXJ5kaJTvgEeSzC4nLK2AQ&oe=69E0F49B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7G0V99k6yOMQ7kNvwEv_RtZ&_nc_oc=AdoOa6EkCSScYwCP42dbEjBMiiofSprMMaVgEEYbSC0exjkjQ2eCfrasOZVvh66dFvM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0W9-gU-2nnhXrD_V58jAJth8vdNUi0gYi95dgPo8PC2g&oe=69E0E799"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rpbs0Uh6qXUQ7kNvwHRn4B8&_nc_oc=AdptEfAotbmUyEBobEc27eSyowgan2XD5oWClrBc8sREH8TwxJzrBE2XDBlyZoHXuI0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_G3ceJM5IXUQ7kNvwHrrB10&_nc_oc=Adp2F4r7zJYqxWH_wmfQMkOYjc78qnt87fnbsgmwJVz2cdQxeNmUdQePFWZBWSnfAYs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxl4Yv-wgwC7E9DJGWyvVD5YQ8crIbmKMolrWUL3REJOw&oe=69C290AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckisL7t_FXQQ7kNvwFx7cMY&_nc_oc=AdoF4lk-L_J0pzdQpHmfBUK16q48cXe9DyAqPr2OMU1X-QPsJp0T9UANTb1FfCjd6oE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPIHvu8zM2LZAVe9ZdosNzEQndH-zm0Va69RLvIJfk4w&oe=69C2774A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHZdTicM8wsQ7kNvwGSXkD8&_nc_oc=Ado9Qcyi5gELaAyeEnVWZ2qOLbqVGTM0doEZ37oTV65PaCmfL94vKbHXU3dKIzxJgC8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxN8bXtfgUcGs86-7gSX8ewEPbifJLYwhbpkhaClzfOwg&oe=69C2A21B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAg39mWXR6sQ7kNvwGB7apd&_nc_oc=Ado6LqCsmiiA6kdggZEhbvynGRmlrBzs1UDjSpPlhr_9j3lHIYzBsw9KKW_-WKYA_FI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxv8jP7m-b2F8ZM3pWC6JFxkcLwtK-onRhcwiJJZJVglg&oe=69C29519"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaT-Ruajf7gQ7kNvwGl-vHI&_nc_oc=AdoILVfMH2BiTh5n4i47b-NoAsoTAtwnzddaMB0eONikXgRzkXNGXdGApFQKvQZk-6E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=
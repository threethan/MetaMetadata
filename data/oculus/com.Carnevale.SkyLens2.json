ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tcMK5Ux8nwQ7kNvwHruqha&_nc_oc=AdpVq_HMWs7i013-KfxVTdna94VapZ975WzBj0d_OwqdobdieP99GerIm7u_P26upcA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYd7l74lO1kT6rihfxQvlEUDOe2ti5NZ9rsLhQKkZ6dw&oe=6AB6762A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiKADoojcNgQ7kNvwHrj9na&_nc_oc=AdpGcbIMeEZr7WKV6nu3PFZXo_K3gChayYbQgU2HpQXhvvcANwRst-dySkWbvmW4j_4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKpyoDI8NWWfi2h7A_Ko3zX1hVYx9RGUC8J4jGddKWPA&oe=6AB6950A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INgUV4lQD98Q7kNvwGqAmc_&_nc_oc=AdqOMUAvapDk29wvD5Irnn0KObduFJud9bPkl_DCh_AuTLTwdQCz3J7wfRF_KQqmieQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILuFLMrsAbraVLA-QOb1PA6uXzuudfUxZ7mm_4__5AJA&oe=6AB6879B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uNgIDIQYVwQ7kNvwHu-DtL&_nc_oc=AdqoVdEwoj0OwhTIUnBXLLBN_ciieu3pen9taRCGXFDiptFYp2gwrA3fRZKXqPYySZc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOyiYWntRpTR7fgsUGAoPOzWbUmgzJQceTdxtajHaCzg&oe=6AB67A99"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nzHTrEtXFYQ7kNvwG79L-N&_nc_oc=AdoVf5zw8GD0kBw5NnNeo8yRhZEMYCtUGLLy7euL5WIexwcBb3eZBY5P23IovQwvv8I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4J_MxrlxS0Q7kNvwG4S9gW&_nc_oc=Adr4CgT7nwwgMozYBpWXnsX_EfRl4Hdj5Nyps1BvHnMuVCrIpiUe_whaTazMiAlXSQI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLC8yNk1VXuUeM2NflhbwV867gLZLFsKvsnTSDrRRXeog&oe=6AAD3BAA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wqTtCPuWOUQ7kNvwEDe__3&_nc_oc=AdqY1nNpNvIgHtJNRBnBMvTc5vfgHLbouBx5c4P8Zn3PctnJ9OIZWjSoDwmPzZk7jAI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLW3IrMZsmNLRYQ_hLFY8jt4kUYX_k6f8-FOW_6wxtjjA&oe=6AAD5A8A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYDX6MjEXxsQ7kNvwH15W6s&_nc_oc=AdrLiAtfgnONKpJFKX49iYzm2__DXZzIm9QuLYadtwWK2NS1pqb5Aj6nb9m6zEwJJDk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKo9CMRex1zCQf15rhNeC1ZMJxZmA2LuRziI4cGCRwyXQ&oe=6AAD4D1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GCotBv_8lwQ7kNvwH1fVwY&_nc_oc=Adp4kEaXKpGe7pyI_yWlxLBQUqD3FqpweHXnVhYtV6dge6oh_ST0M-rWmtTTbBWLESM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLa-Sjwl1B4QrptbgIjKRfz2nXK9e0a3dUey7N2hGQ8hA&oe=6AAD4019"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EdGnK1d5K4Q7kNvwGtJrEc&_nc_oc=Adpy01yA-CKZHO_-lnEYQCpJP91sE1StKGThwPDRjs9yk0GL3vnbtLF48vkwvVqAy2M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flZ0zEe_9joQ7kNvwFyfyI-&_nc_oc=Adrng0gKr1uxyBA0I5ImMq86S8ppSI2X9xs3Y6XvWb38tFD0AcZ3WHfryMwMW0joEkQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEV9bQfk5Q0e_FA2mNoV9L5Rd03XiQeA-pWo4A65D3fGw&oe=6A8068AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqeSyNBZKkYQ7kNvwFQn4eN&_nc_oc=AdrclzEUVV097kO4DE_unQf-_-rgj9ewqxprWdtVoiPdMUGXn1_HzKFBtA7UfnsasL4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVC6WLIQgAfZYer2Vigre4Q0d6NRSMze5-YXqd9Ia64g&oe=6A804F4A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zg4Yk_8e1BgQ7kNvwFMFt6_&_nc_oc=Adq95Qe0rO5LxPvRSgGO89gsV1QlAo0yFcrrIAMj6lnzpjKZW1dHu8QnP-5YRLMco8I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-EvJCtjorAPB8ls0midr6QFmles2vfIKG9VJhJTkCEw&oe=6A8041DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_kjMCRG4ZoQ7kNvwFkxKtj&_nc_oc=Adob8XwRSm4wWBVz0qBIbgOiocQ6MujJpd-QqKvOgMGILmOR0BDKqa2PxsQxivuaYyk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVWK7NEc9UxBhme2-WpT9NBYUyjpYi1yZOIMQOznplNg&oe=6A806D19"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dx0zAdOazVgQ7kNvwHbGvQx&_nc_oc=Adrvp72ex5lmOhauUuKdnjtQ5rfx2kklOfLu0Xm-fAG6EHmpk41xLjP9ZP--KHDiTmw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=
edp8WIZGGZyh-IZ8X9052yDdqbc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuywVKNnYyqCCVXfWdeuZU8rlpsCYou7fBiydDCwm7HXA&oe=69A2ECAA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sII8iQeWTZYQ7kNvwEgCpdS&_nc_oc=AdlYyxV6UfGWPvshWOiMXclCcpw2aelAYlQsweonQpdKneaeN1lAELIlXanDlzyPYE4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftDlu6_KbXrDdw5cBmHdVh9lwmZCM7dvDoSUTJDixeRqQ&oe=69A2D34A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z1RA2Isll88Q7kNvwHJKBSd&_nc_oc=AdlLqTMvOvPl0MAZJOFxrqKtS2CT8qSk8WAJKF4FIRuG88kwTiXrEw4wZa3aVX_d03c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftq1BEF8JSR63OJdPZsHLcsnK-wz4vFGFyxu7ueixKdkA&oe=69A2FE1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vQ1tGEI528Q7kNvwEBfz7G&_nc_oc=AdmrlHBalB87FT88BJNGlXaf7h6QfLQslOoit7R7rdF5LA1p527nb975cqC1-Wdp7kg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsv4emFeI82ATtpWSyS6hLsrouN8P2chiXE9ybiIoSvbw&oe=69A2F119"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PH9CbN2gSDkQ7kNvwEhRinB&_nc_oc=AdnZjcIxXZx7qpKVULMMZlhpWsE6sLYTY1rJxIWQdx9K2AipqHcWKrTRPgV33yf9Whc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft5T4iSUW4iU_R18TxUtoIiV6Ubz6XsOiCLTAF8uJHJWA&oe=69A2D75C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SkyLens", "platform": "ANDROID
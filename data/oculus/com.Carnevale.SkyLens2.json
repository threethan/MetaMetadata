eTsfYMvo5XKa0DOllODwojPF9Os&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfucDsZ_Srdp1JZXDukoSuT5VaNPO5MCbYrBg0eQraehNg&oe=69A6E12A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2zV9MKDQ-YQ7kNvwGgPYYx&_nc_oc=Adk61Hl0uNjEYSgTE6ceaYZkktGHQZA2p4y5Q-p-cSXDcEVnpePuLA7OFOcY0YZi9-4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv8lSfeWW3bUBzlmcavt0-dGSp9fINmSwGQnQAHa8F9SQ&oe=69A6C7CA"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbmlPCIDLV8Q7kNvwEsK9Ds&_nc_oc=AdkaDBxstt3kFRV9dgaDHmv5qwFaqWFtGLjOBVInwr-0YFsJ4SmbDg4PFMjfs5i2qLA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv599SZdzxTEvE0tnRTH6wBPD-8EOzq8Q3RFc8BsA5MgQ&oe=69A6BA5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZxnOTy3gr8Q7kNvwGMsIkw&_nc_oc=AdmcLpCza9TyL1q4o8us8TJp2ykfwGaE7HUopzbJzdbPBZUhZIjyV64hbl8WU_jp0l8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvUl3I_8vcaHDT7Unczr0ZXP5kVnsZ2vFEque-IuPpP1g&oe=69A6E599"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8EzUT8i_9isQ7kNvwFmMjZZ&_nc_oc=AdlobKYpHZKxisUlR9JdFi3Y62RpLL9QYKaCT2c_qU8Ms87ymcSOJR_yj9PX3_eBU14&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvD5s5BeyBFQy0jfE1vp4GLQNTEALYJIAd8NxvTdPRXEw&oe=69A6CBDC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SkyLens", "platform": "ANDROID
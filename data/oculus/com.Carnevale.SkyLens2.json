ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9N9PK4LbxmQQ7kNvwG650cI&_nc_oc=AdqiVKvhHTILS3iaWdQ8n6LNMFR3vnDkCodT3n1j1qmbhqhLuJiD_k0Xk4NKJ3cVAjE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TgIklpqjarAzuMX2noAvrNR_fYhfsrjPHoVk1_8NPGg&oe=69E77AAA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5aPeM3jx1QQ7kNvwGFJgyv&_nc_oc=Adowd1Y8UR5T7EgmkDhn28LRD62R8f1z468VAs-793ROi8yd71D8YzChIiL_ViQcIZs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Gvw89E8KUVKg1D9ZR-heA6J4WFWNBXfx5TAxgeRocWg&oe=69E7614A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3MeDlKgck0Q7kNvwHAE2NV&_nc_oc=AdrPTahDBknCp1IvxOGl2gKdn-U5YQvus7_laeIUmcd10-kks_bWatXxK6B9XrIlLgE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PNmIDD_Ls0yhzKneDVYazITM9w--3EuCnxbfF1jhcwQ&oe=69E78C1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ecp4h_KCygQ7kNvwFt0SMn&_nc_oc=AdoARjtf-UqK42gEWHTGEXN7Mx27Xhx6QA_HskHwIB6V42hbU2pntrkkt-RmKvupAaA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26XZJU585vGBz4wmU0ot49UraQ4RWdYVuSlJowXB5Ueg&oe=69E77F19"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=si4EQjYe--UQ7kNvwGutm64&_nc_oc=AdrfM1inYUrY0AxofPBJR_4JGfqfehiuy9RlA913m7iS75LtyTw7D9965bleLtrFXFY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySRJqNmA2vgQ7kNvwHs56Ab&_nc_oc=AdrtJqO60V3BxjJhMmZn-Qop_nV5DjyJFmpZ4cY1MxNzzVNKqOgxg7cNFruU0Mh6HYM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTEov8laMqj_Jcwmi6LkArDfT7mV5RQdmSxMAEC4dmQQ&oe=6A5CD02A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFYW7hwYAPcQ7kNvwEfK74h&_nc_oc=Adq2THc5HZ29cB2YklPYQkEol5TLraftF6ODuGp2MFUAPqGWWlY5dTTypifSSMa5oYw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2ki61yYreY0_E0ODVGY70-TffWC4pfG2WIiRRuJdhlQ&oe=6A5CB6CA"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WffC6NEX5XQQ7kNvwG0XXwt&_nc_oc=AdpSdjbEGtFxDXvSMhht02XDWA1gjcIcAZwuWhNnQWRe-d8Lu_y2ca5fStAhM6pmvvM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbcHmiXMnJ_RNHuUsjKwgxQ-qhopkT36Vyeo9uNWN_rA&oe=6A5CE19B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggeyNt-GPEoQ7kNvwErVMer&_nc_oc=Adp2omJrcFakw2KsmIgS1L5rZmQwWWWd9t6ZD3ffwlfrNSAH3rQUymW3015KazgO41k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAp4opdXq2wKEs5psrcdD3M4esorJsxeHbnf6tDYK2QmQ&oe=6A5CD499"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BU5ahKgKv8Q7kNvwEJzW7d&_nc_oc=AdrpV1F3jOmgpVbpN8XffNKsvbcI2PR-zk-ZVlcOUCuXeKRlGR-3F1vWhovBA9L12wY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8I5VRYJM0EYQ7kNvwFkEf8w&_nc_oc=AdqAniNSWizHghsyo0e_WlikN6hl-BKq9HxF94O4ePbyabo_-t6hGKXwEgygU1Z8Zvs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmCZ1FQY4OzSMayjAaUKQX2md6pdiqrNnaqk4ccbjwgQ&oe=6A4FA12A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=savk4xLk_5AQ7kNvwG2jGEY&_nc_oc=AdrPK-my14xfli2xk-lEqYhYW6A7zzDNPFKWuoSngu_CQ0YgIifqfxRPbH8R71ZPH58&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCu8UMDVPBOnMcSVpKDbVQDpE0vebZAB3U_jy0zk_b6yQ&oe=6A4FC00A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dU0dCaR6m2QQ7kNvwFTsIGQ&_nc_oc=AdpGId45nIYLSMFoxlL4HX9h7DRELjMgED5HFV2PUCUaHfSKLm6j8eeDaUJXrSHtN_g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKZpOxzQqw3q45RrsDgBjdPi54tFDmgCNM0PMjzQJ4Vw&oe=6A4FB29B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kKrxn9r2wEQ7kNvwFZluIW&_nc_oc=Adru_QokTCfowVeMdpZEuuXpQcFMkuTcxQgqSxLxsA9BlSOLugHRnQkx4wzWM27lzVY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAK0cqkWZ458xOExiFkJbeON2m0VYQo8iNxX49R-YB-yQ&oe=6A4FA599"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6BJePQ9gngQ7kNvwHxt76T&_nc_oc=AdpqCyveM_z3ejjR9fK66FMKvQVw_yvq-3Dms6wpeuSsWr4aCQFrM-wG2au6B6-aLp0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=
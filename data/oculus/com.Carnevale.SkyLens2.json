ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYWOPQMYiLgQ7kNvwHeCgT-&_nc_oc=AdpNWMZIl1UvMJLIe4EmzMw5fg-kPFC8TfIuYasdkFz7ix8_49bVIibxrbwUFE5MIW4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzP_fD1MTymHOrUVSVjDIlH4YPNKzwdzxh-5GUR5XozQ&oe=6ACA74EA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeCPBlIJu0QQ7kNvwFp558w&_nc_oc=Ado_rHwiAOS4V9TMqX8DvNhUj_0JOin3f8Myho0dqlNnMrsKjM0BDLHGod3sev9T3eI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBae5iU1qT9idRAF71gPJNeKz0kIaTdUDPtHEJlqgolg&oe=6ACA5B8A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75VLFCNE6LAQ7kNvwFJlz8u&_nc_oc=AdqaVDbE9FfP2HpdHYgkio6ue23FzOd3lfxSl_M8VJFPo5HTKEPPdN0JdeMTV_TL9XM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNY4nXKbt75a0blhmmLzjRcr9j6gCWdaMLXV1RiE40Ctg&oe=6ACA4E1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyOATwoS17wQ7kNvwFQ7qm5&_nc_oc=AdqM_9JWG8iUv8zz1QQ8v1SsLIzGV10OV5LSlnB_4gBvZQ4AvviKFJ0AEsye7o2necg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMfMPYHJDX9ScEpXs3mfThCDGA2nh3Kuebj_6vxOLp2w&oe=6ACA7959"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AW5Mvbd7vkcQ7kNvwF40mi7&_nc_oc=AdqEUXEB6kwdAPpS6MybPowuNj_8fRdoGHazwvnoDM5-bD4piJ4Yoz9R6_8iN-B9HeM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=
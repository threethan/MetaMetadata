ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YqocnCBAk4Q7kNvwF0MQcy&_nc_oc=AdpQ6e_hWA9fxYFDCrhgFj9itbX3cgZA9dIoZST8PtTzZTqrfLLRsZqH8tUBNNLI8a4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFweM-v4o6esd1YIJy4bZ_VCvesccDtqe_7FNJwZf1D5A&oe=6A8851AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGmvOBLV0tkQ7kNvwHcvRnl&_nc_oc=AdqIs8tDIeOj5GlkTXZdQx0wvYcFoyYgSpriHXIBPMh52m2CHrA6uUdybWpUxdBU5G8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlnHiN-JAPPE-WQ3DBxhgMamLikpdOJyRClYS4vz_oIA&oe=6A88384A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAlleLX998sQ7kNvwFVbPuK&_nc_oc=Ado7lfE7BlEs8pBhqiRJP8lIRc0enD2oZfcC3257pANPitWlGoC-P3lz6SJrITAUYrA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1olQbcej64nXCsxL9vAee2oc_PwvKAOXelCIddbvalQ&oe=6A882ADB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kL1Mi53XsEYQ7kNvwE_YOJe&_nc_oc=AdpKK3KeP1Ys5wD_UqDRUGUU3BJpU5IgrurAs4cfyHCwya7fwj5ifds15CK_6wAit40&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDPPrYeVsN7NvukbsgYY3kCx7vjnow3_kAD-7-yW1tuA&oe=6A881DD9"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIATvmoteVUQ7kNvwEc96ZR&_nc_oc=Adoyu4E6RwEyFNVbKqrgdeYgKIpFiuAZUD1q3iAxZ4YK0POj11nWk-YqKzQghX65hpg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=
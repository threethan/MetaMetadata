a&_nc_ohc=pUWbhq_6leoQ7kNvwE8ixjW&_nc_oc=AdlyLvxfuRgF1vl9SW6KXMeYXa3Y43Qu6O5BB_zLsxbMBUqzpZWdfcUB6rhm5ltm8K0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvhfcS-g9WGNvrgPymlpF2KjnO1xLjj38tjGnK9Syd5wg&oe=69A832AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2zV9MKDQ-YQ7kNvwFczmcL&_nc_oc=AdkAp0hP4ZKi_8fiqCJyIrYGEbpDV92W5YdAK-9gUIs4qaEqXvIsKQW46Kg4AMBYX9I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv4TLpl9LXf5Zdk1Tuwcxz_UVL8Ujqt5Abt9tx7yX_MiA&oe=69A8194A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbmlPCIDLV8Q7kNvwGr3iMW&_nc_oc=AdkyyAJ6rExwlpbbibxLl_ZT8N2kkPvdrwIbC4-RMDyO875UvIA72ptNMewIMeFw7bY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsU1lHOYdvgU6e76FKbR7OTmOg1I2S3WMlGmFAxgb7KDw&oe=69A80BDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDKCNxnboxwQ7kNvwFZXsX1&_nc_oc=Admrp9DRDsODGmaq79hp_NNpTztzMUkV0lgAjd2vWeLhwwDVmZoSZhibzbRLQojvp7A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfufT6IJxWNvBfVaDvdt-ZxyxWyaTxjWISCEbk-atkJ6bA&oe=69A83719"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8EzUT8i_9isQ7kNvwGxgayB&_nc_oc=Admz8RCQputesHJTVUIqxUxm4VBmK6GH7DAl8AR2Tu-2GSfreh-ddeCT5zL9GvJPNSI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftQ4wRo5_Y3Oi4hVW3rC3k64kIRZkspKEzVQbsOkCaBPA&oe=69A
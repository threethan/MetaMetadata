ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVa_EZxpXkoQ7kNvwGN-03M&_nc_oc=AdqcGTYtPjQBOuoAH_UdeZ4C1NdI8Y4oJ9_DfEBXzS8ViqEvW2qshler3xFJcavvVGc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LtGJYGRusom-s31aR0bUHzRx3Aohxx65ek1rC3wLjDw&oe=6A28142A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsAohQlSdo8Q7kNvwHu93Nk&_nc_oc=AdqqT1F-9JSuA1kUlX8gj8jYyZlZPgEqbxYSFmJhKzflCBbpr0kvfWbPBYzL_m6dNBY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uDon0knw1fUWQPB5YP2BjPIyAiXllzmDRyx1LJcbbpA&oe=6A28330A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0l9PBQn04x8Q7kNvwGnrsBc&_nc_oc=AdoStO1LHBD_yeYVZ1ar4ocaCcxqHDT5egHNTJ_sQRlQoQBmObST7uDeRbHSuvgtn9Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-4zng5ezTDkqTAp8HpURmE_F-liDhxTl-wgRkxmsi8g&oe=6A28259B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0c68YfMvkooQ7kNvwGE9SIs&_nc_oc=AdpSX6idnfzKVcXhwZMXl8kkpHmZFHfmTMNNpNebSujY9XIxTuPIMWkKBowtNGmfqcY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pbbCgaI6xoBVXxveIKWuLBMDzeV70QGnCkGCGp5uNcA&oe=6A281899"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEbfZ0ZSUm0Q7kNvwGY8OCq&_nc_oc=AdpDLw_JGf6B9MbiV9z8Qy3_M3douBGTjZr-KPq3B2_zK96ZYVfqJowSVXOeF4UQPmg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=
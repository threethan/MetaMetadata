ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuI9isQhR5EQ7kNvwE_F1zB&_nc_oc=AdqJd1r-rhuG90MMh5MLPvzjfFuqKDTn6JkBvEst-2aKObrINloYZFeDdN9PhUVCbXo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9umcEHEzTX1xZS8fvXK_cp1edApnAjIcBxwbcTWo2iwA&oe=6A2FFD2A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYnAqai151YQ7kNvwHr6flO&_nc_oc=AdrnXORmR990eKZ1FlHsu7ueXGTNrZ_vKFc_RRZOlKzNpt5zsYWf6mJ1TTWW5ljjMsM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_02og-haWhWJponeJFTHhw29FUQOYqO1nkeEjG4n0dDw&oe=6A301C0A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zn7WEHV3rV0Q7kNvwEPqEtf&_nc_oc=Adq1pRCo9JHrAytGCUkjiUQiZ8tW6-yO860qjaibcAms79SKF4LtGBCB5QyvORPRM8w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8G1lUY9ad-Hikdo35vBi_w3phRR2IMNq8fTmiKTLa6lg&oe=6A300E9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8d-yozuVtsQ7kNvwGK2KSZ&_nc_oc=Ado4nG6Zi5PHKwbdmlGgXHh9OzcaW3O31OBsLQNem_0UCdg_WMP3M86YaprsOZsYcsw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Xg-WoSMgtckh0NUbdfd1XBC_NiW5rACznoaULE2xgfg&oe=6A300199"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKltXavQwPQQ7kNvwFlGy3N&_nc_oc=AdpAisiJKjIh5RSzul2-tWnmVa8OWEOnIl5HzFb0IyXNtN2mj6dTTLN5jwASYr2ZHq4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpjOm0_clKwQ7kNvwGrEeMJ&_nc_oc=Adptw0G_dIvTkTUnF6Bgp1O9X1F7qSGworF4V8bNQHV68Sq2MNLh5mfvIAAJ74yWBo0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8izw2yJznQf9U-YXjEQLnBtmQp2HQrD1Ywnt6a6KfWlg&oe=6A43C3AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yv2bOUEXU7MQ7kNvwHA9phY&_nc_oc=AdpHC1oESYgVNLFyGBXQv5srgLC2CPzMYZXPcdatO_FOyPVj3mi-y9YQxm2AxVqE30w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SX5Xt5ykkpUHuLrNll7TLtbgwZepoaYVuRuNSEHL12A&oe=6A43E28A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgT7C5kVcZkQ7kNvwG5LDaN&_nc_oc=AdrMGeuj63JdfaU7lF3FYZ2F7KpKhjABKdO3i_QaWd42W3D1xxGLHbqdf32Y2IL0khU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LyDy7bsLOvRHDu9s7hBZKQ7LAiqBKuSiKkFY-cMG-3w&oe=6A43D51B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifwwA6CEFvwQ7kNvwHDVTxS&_nc_oc=AdqXtUcAodG57lIjl3qvCTg9tNh5GekRbxCRrrgXTRdrT5s8QszEdQTp_3VhJ0B_RtA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RJoFo80hoocrPwrKtTXvKKBl4TwYqWsnlV1gDyrV3kg&oe=6A43C819"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6qFd1WVJ5gQ7kNvwEX_BNl&_nc_oc=Adr6CUO17YWXMyw23SFFq-qRn50srUV6P6_VUMFZcUKVW9Ct_2Qz5dTcg7HVdbmzcg4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcjDBwAGyZgQ7kNvwFUvMqG&_nc_oc=AdpUYEWMAjazeJVB62DbZi5DLn7YeOFqVy_mgOmRXHEfeCCN6MgA_DwefSrhxG1ZKts&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2BjioNeC4cpKvJsL91SG2_2GM_Mxfao8rGgxa21QMGPg&oe=69F4A9AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAg93XSkR2UQ7kNvwECOVeG&_nc_oc=Adqr7rT8wC5vdFYHIWV50x1u5nc10VGA8z7PRLgJNAgEpCMR8xyBgzfSI5ER6dvvsa0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0zXqCdReCx1dR-vUpJMuPU4WoAMyGg_5nkHgeUg__KPg&oe=69F4C88A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeoWd1QKODsQ7kNvwEKp0PP&_nc_oc=Adq2m2FpRReOi7RTpLaoXMZVDoeJGb_qcBzNRExAEosThOvAmFgkQR5wpqmjBO3YiYo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0A0Z5hbzlx67BIInVYgEU7CW3CJLWaYW6HGD4Ak8YtuQ&oe=69F4BB1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiY7EnmYcJ0Q7kNvwFsitcA&_nc_oc=AdoRkLBh-4-ixKKbsJxvuJgpK9B0UAawtyFfL31m5cL9cbI9i4pCHLHxTDlMqQnJFUs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2HPMNdnBJLESTSpRgZh-rGjy8cUr5gBkm-GKCUe2qQRg&oe=69F4AE19"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Go5W2oaLXi8Q7kNvwEXDgtI&_nc_oc=Adrr-V2s9kA4scqGrAzsNN3Bifen-aBDx_z1Enr2WdT7NfH8JDAG7TY671UGzPrizUU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=
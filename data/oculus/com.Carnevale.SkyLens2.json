ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSy8pAv2rlIQ7kNvwE97HAA&_nc_oc=AdpvekIzNzcUVnWc6pVMm6OJx64xR6ZeIR9v_EHOQqpeWkMz0_ga65U3lNB9Q6fowWY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCodL6bj0wUGl8wSKj-O5eVePyAVsgGz6cuKWrtbmJqw&oe=6AE88F2A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEKPyWrJxecQ7kNvwFDEKm8&_nc_oc=Adr_YUV54JG9MD_r8Dqb-2jFCrWvhNfeQoF07fEe_pbvf131q2dv0FJKJESdB0b_FQY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYjp09POFVVPUzlITsN-keJP6DqSn93nk8QUHlLfrlnw&oe=6AE8AE0A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAN9ua36lc4Q7kNvwHSmI8c&_nc_oc=Adr0GSXyRmVFal6KX6fUl0FA2nnnGi2ocZUY1FUXxnJkK4n1SllTzm8UnoSxJ7F7Q-A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvQtHr5EnX49ngkLbERRdImxt94ACHbJPLh2ISionkJw&oe=6AE8A09B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awZ3vlOFNcYQ7kNvwFbpZRl&_nc_oc=AdrcO26x7jv2IWsdHaxf_Dw0w_WWiGy4pazDkQWkCFapB6Vp7ANEaDBxtSrH3PceUCE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTHJAWljhTiNMqcJgBufdps441mtzan8WZCK8QWC9G5w&oe=6AE89399"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3MmhBXT9JwQ7kNvwGQm46d&_nc_oc=Adp2q2d2Vxg-NAZScTqDlNBGXEgtR1I_NnF_3PUy_8CGVVNZ_xcqXV0hhLzYgOrueYY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=
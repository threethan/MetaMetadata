ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNkWDT0TKpEQ7kNvwEDldy2&_nc_oc=AdpsBhtd3bJhyf24rjAyy14a46cfD6aMJPS5AJMl3JZVgjksdUXAEVt5Mse6jghSeQU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbP5UIv3f5ZQx3R7C9FPLfW31gWS7YmAHG1H06lFs2zQ&oe=6AC253AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUJ4JQ53Zt8Q7kNvwF4tn1B&_nc_oc=Adqs8_MXyTrhLWV-eTDHTA7ggdj95Y8NquCj_65JxQJUzVLr8w7nSm7mOInycTpr6Z8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMp43TJPcEKsufC4Ketj3AO1vPMP9sGORcdsBvAThyWzw&oe=6AC2728A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppqKElTY8G8Q7kNvwFHncSQ&_nc_oc=AdrqBRU1pXwb2c0wJ9R3K_IbMAL3Qc5FMgEEuPiHPm32Ts8q4aUjTCpSD6_TQl4PH1o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxp6l_BZIoYQo0d9xLt0fI0nKzQPToukwnbnnwMO6e4A&oe=6AC2651B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2T4pVsfzkoIQ7kNvwG3CMdZ&_nc_oc=AdoDL8CdT1vztHiMnGx8A03V8LaW-bR2gF8C-dknjKy6Q0YlASfgneW9IGncgBg6U84&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLWUnVgtWYrAlZAPbPYIGO7mBFvT9GDJ0-ETkEFSHTRQ&oe=6AC25819"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWEtoPw6bQQQ7kNvwFNIZk6&_nc_oc=Adpy_KdqeXBishxW7UxfrAp5Shd68ANQnWkCaNEPTyt2-nTpxT4kA5CjYbGgqsGi7sU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haR1C5RFUvQQ7kNvwHJseva&_nc_oc=AdomEaSc-C3pNe2SBWEjLQypNucA23vuicVkDM9xbxxwaSFDyZc6WGC2qW5YLd_sXo8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YCHbz6GYaqHf8bojFcIi1bEFRwEf44258GhUVWuRUTA&oe=69DCEEAA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVQWmjf1mPkQ7kNvwGiZG8y&_nc_oc=AdrNicwwFVKaq_VtaXXsftrhItruVt_-R1EuFMKpCWdsmtmChLM2bWEX98n48D2hOgs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ySW8yaprcW0Qzm7W6ce8HjHDlxj8O4X8JerJeH8-2sA&oe=69DCD54A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOhi1mHpukMQ7kNvwH_CY73&_nc_oc=AdpqZPF0Nf9z2CNWSuUJ7CgJITTdrSzkFr1Hl-Ks9GF0WIy746L-1uDH9tCXfdDZ0lI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Hwy7WXPEw_DRfdAZN1VGKjOIN0WDJ32mOAf-s6K2Xuw&oe=69DD001B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAVOAjV0-MEQ7kNvwFwSilL&_nc_oc=Adq8E9w0NJBm_NUBIdprHKROj6N7fOeWldKZm3YI6hr4xXSRIzOhAvRPl9KeJf6VV9w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3A_eOCwSD11Fp7pOyJ9gGSGb7j1O_orYaI0VXF6J5L4Q&oe=69DCF319"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iYv4kiS_BUQ7kNvwGMg66q&_nc_oc=AdrDwv9WL3egEeZ3FbEfgloCmTN_5ZGGpZQad9MsXOwdQ5fcKn0Vls_4AQ87ZlqMNa4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=
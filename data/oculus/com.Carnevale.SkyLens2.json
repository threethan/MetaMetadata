ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sijbae6vftEQ7kNvwFrSxdl&_nc_oc=Adqkf0XfuFbxAW1B_l0qYccfNj6e-oOcmeJaq-BD_Bz3BfICUN0THG0-b17R7wLl49E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwfq10gflTPsehuMKcdurBG3sPu3HFfZT4qut6zP4CK5w&oe=69CD1CAA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SJTE6wBEzkQ7kNvwG_I6Ic&_nc_oc=AdolYSy5Hb8F5Rr3M55rFjEYFmbHW9OAPcLU1ThUfJgB25_3ZDN6ghDI7kjRASA7Z3M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfymznGuaGtEqiswbO2QWi0Xz5OBa7huTPvjwnfdCsZAfw&oe=69CD034A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ax8CEYEfDVQQ7kNvwGC_jV2&_nc_oc=Adr0tRjfUSZISzIxpHjRZe5nOtoOL2wOPhRUoDrEJNHhNZDKF4qTMhYLVD5Z3G3WJmM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzp7Bjn6JfZtKWZ8bpF_Nqo5M4bni_qK1go-Lt5gxB8uQ&oe=69CD2E1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pijk_11rKDoQ7kNvwEp2RuC&_nc_oc=AdqkLXXRY-WngYkxVXuM-srmQt1WTC6GGtQTw0EG-P1vCh9IcRbw4sC3fztX_sloTtQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwy0h0s137eKupZeVIoQ-vP06eiQDmpb-EbkKpLd-iz2g&oe=69CD2119"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgqVenQTeJ0Q7kNvwGX_fMO&_nc_oc=Adq-zi7BCB5Lw49TnvmrDKRCWAnXSNhb8yHtoAt6aqEG6vXtQ03Yf4GF2k1d0M0PMmM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=
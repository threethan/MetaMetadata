ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6rGT7LwhpcQ7kNvwGi3qu6&_nc_oc=AdqP0FAzt9-VJUwc3Y8pOoIIBeRroFaM_EgnkjnQRhsFUXxrpSmhC_Qjcpg4ihbXZzg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOF8HMOYuLpRIRa_JEVJD46mZFZ0UH5RgJ9lcTxV_AG3w&oe=6ABFB0AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7tSu8cwBwYQ7kNvwF_LeKt&_nc_oc=AdpjyVAh1LlNNeOAaq5rL2yGG8D4sWNGGULl54iFyTjPzy2yxPW1r7bEHviEguQMAiI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6DOhM1w0hceLBCQHjWPJydFwsXxIUz2H1kOwVIav0Tg&oe=6ABFCF8A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppqKElTY8G8Q7kNvwHxHR6P&_nc_oc=AdryM673EAnZQKd6IDjx5nvlYGGRUQYYlTWJxbBICeJZo5m-3gmgxXHCRC90RiiVqao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqLKkl1THmhDTqWjDIY-b7mqCagwUObdCgEiTs0BayDw&oe=6ABFC21B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJD0kjQ4PBUQ7kNvwGFcjGY&_nc_oc=AdqTDis0AHTa9yrOq9hSXPWdh-jZox67UGb1lZ1yZQp9zRtaS18tC5De1WQoBQT93Uk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLsTAZ0RM4uGjMLVl_KJh7j98JOy77aE7HfKkA_TRx8Q&oe=6ABFB519"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvLR-JADyrMQ7kNvwG3YMtR&_nc_oc=Adp4AZmFNIfu2Td1rtBIydVUC_9jxib3t1HMqbBIxEZf__PgjZ54CB-Vv6bK3xVf2kY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=
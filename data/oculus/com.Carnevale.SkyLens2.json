ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAuECFlL6x0Q7kNvwFkAfuL&_nc_oc=AdqLlTxewpb7lu-6wokgLsHxO2SPAfzmhxgNVDrxYQPzxvN7KoVHy_Qp5itulaNnxfU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Zd0Y8GrxiLGYbRnPTibo4MCshsxvIzgwqU_VvxivFdA&oe=6A33F1AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaExbg_1h8cQ7kNvwHrXx2A&_nc_oc=AdqQpcOcJNfKWOd2iOH9QKkARHrpHjk760cvA1agKug8Xw1R6S_kbp3__oTGP8v8u7E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6vLptqwhSV33rrVKbr2wIiaZh5jCMWpF3m28AaVa-RQ&oe=6A34108A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFp7ZsNtTO0Q7kNvwGMAZn2&_nc_oc=AdodeOtSZgLa0c8W_W1CNnZab4AXST3yTcnVFs95h9W9pAp-NEhbpreWuRA0sVI-fWg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wtxwtUd-RUTiKsBu3vmzoGHmdad0zvyfzxyTzweRmYw&oe=6A34031B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVhywJ2cysAQ7kNvwENJYnM&_nc_oc=AdoQ687VtpFqH4M9gvhkuhIYu04UQr5j78jinTsgCNvvOEAeoQqvv2MEvwWZfzK2tOA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ese1I4Qk8rgU_HLD0lbFG8VLpoVFbHFeIeiusFux5kA&oe=6A33F619"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbFGAWBcBkUQ7kNvwEN4rfy&_nc_oc=AdrRFi7EJOxjEpNgC6jFsC3akdMhfJWozJdUMZ73WTgknB_9hSOxnDNa5i73aITRfCE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aWohNNmKLIQ7kNvwGRrr-v&_nc_oc=AdpZOzWvJ_ErnS5CVCr0BpGcyiMcUmbjCXb2Zo9eg5N77THuT0nRqDhV1784TEc2IUo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQCPWO5lGAgYTtE8-WOeMaFkXiiFGokKLxOwf8lPQmaw&oe=6A4A5B2A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hix_MtrJxtoQ7kNvwG6rZAR&_nc_oc=Adqf4x5nJrqphTmoI9j4MoN6TsDnavpCHBNEvv-V0faxLwTl8l50UyHOcOs5ryfBj9o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxFNxgUNMu68iqO_3FYl6wr8LkbuecTkz9SNs5xBwXZw&oe=6A4A7A0A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXqJgpkkKdQQ7kNvwEmZpur&_nc_oc=AdrR-hvntwgSZl9z0nXaKKBhbVBbz4zGuIZkaQuhGie-5mmPe8V6QMAkyLLDvjr9GB4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEaGdXP3QiWL1dRACp6UFjWfUSMyTstwwlF33bZFT3Bg&oe=6A4A6C9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJ1BlBgemu4Q7kNvwFJ5qyI&_nc_oc=Adp3gHfLh9jabff_7JRT2A1_nu72Shn6GXkZrtxmngnA20BgopLizVag9mQOzuEpzlI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYnzH-vd5O5mV2uNTFotpZSkkIXRJVR7dErX0dL29MuQ&oe=6A4A5F99"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRLUw2UUf_oQ7kNvwGhisWp&_nc_oc=AdrR8zm8_1Dn8fRjJbnrv763Fg-4umO2XRzAQs1MvpnjL9hNaG7kH45WqhwIXDXO-_g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=
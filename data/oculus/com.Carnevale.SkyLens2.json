ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSI8-92-NJwQ7kNvwFtRv1c&_nc_oc=AdpCOQldl6kLxEpDlYT6pMLCZZw8_FMAdB4sXQi3sfp7fV6kMypW56lz74LPhusS3L8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgYYmQrESkY-FHE0t8iYMlnUbniZWtI-pnanHjksfBCA&oe=6AA00CAA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UcKXocuC2wQ7kNvwESer8x&_nc_oc=AdojL_ldJ1wpetMSfR-5m-Ka5nhz-j9OXc9wjrclIaO9iIJka2ssbyyyCJygD5HJdCY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3T4xv9Agnvc_lpyj9aMlLrNN2OpDu8TZlU_xMccLUtw&oe=6AA02B8A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcVM6iw2Qk0Q7kNvwFMzeRC&_nc_oc=AdpX_QbgjLCEtoVCrmhCGZ858T6yF_Css5Pd6Z5FkVzEgHA9N3JspM0yrRUiQNC5L4Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTCzTLZtNlRA5KDZDJmuP4CfEiNB6DnIQO_Nife3uU3A&oe=6AA01E1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yc5ZGZm0fz0Q7kNvwFAnumu&_nc_oc=Adq6v36FnsIGIfe714opF3eagPgT4aJd-_nJmU1gQA8JX4f2gc8sixJVim1IZYKMnqI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLr_ZJ8WFUBrD7oAAAuvoTBfCvT5MoHG5VtgW7LZ0Jppg&oe=6AA01119"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e71RmnlcFIoQ7kNvwE91kX4&_nc_oc=AdoEKx8OdFrakWL8K8LkOXVJsRwen93cwTsXsiKmKw0EiIAn8Js8iJnBYDnbCxFO0UY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=
ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPvWYk2Uxh4Q7kNvwHZQ5ok&_nc_oc=Adpe-F53YG-1JmkADVEuV-ve4N1ZuNXD1ZMrLmrCr9PuIbAQHf3xRrf3b_uzH0FjN7g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tbB9NTpzOp8bfI8lM8r_E2NL-M3GXnlScmlQelXUC-g&oe=6A1993AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSGPNpWz8awQ7kNvwEwVw2S&_nc_oc=Adr1-NfMJQ-KPZ-fLuOPKCxTnRmBR_K3kv0Ke28DaSz8tx5De32TdKrRl0PWy2hFL_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lxoXLlQyYZnseP89OFWNM2vWs8xxVSIyG7rvVrhuPmQ&oe=6A19B28A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liDcyM9vJcsQ7kNvwEH38XS&_nc_oc=AdpAYDj4COOpR5UmijVja6WuefuIh4gaCOaQOZpdyZ1pETW52x4tyD_OzeC9tIlxAd4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e6DNPyuK7QO_E5HgpC76LmiC3Yl3NNoCwj4wQl2gLGw&oe=6A19A51B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HL82RdzPhscQ7kNvwGTBX8s&_nc_oc=AdpUBZGXV-1zP2KNEDOBFb5MgMF0iEcMn-i7Hab6jNR3h4yWWpd7gHxJ7injha9dYJU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4L8qYYNg9NEMSjCnVDFU9RbDpz6mafVtrMgjRirRM_iQ&oe=6A199819"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skDqOalCHVEQ7kNvwFq4HAc&_nc_oc=Adq4AmSk4cVGktNHKkp87hGqCJPqyS4h5ZyYLyQA1ysBMsdWSMrCkr8VtTJs67885cY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=
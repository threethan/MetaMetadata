ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9N9PK4LbxmQQ7kNvwHV66sV&_nc_oc=AdqZ2GtBNeV1a9QxDEODAYChkUen_Gn_yTvfJCHk-bxlAXCGVzQR61cCT10ActI2S6c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1J9ag_J_8S8JnztnZYNOVI40uXPaCJLDu2oNLLWUXtiw&oe=69E8CC2A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29alWcnyFpQQ7kNvwEY6xKo&_nc_oc=AdoDBVfUXZakCCXxBNSfm8ylDwuqzQ00xMZTF2pMxTQsakFo9RCdsiB0_n5AdGVf7ak&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17AwggXc7CjXwJlEQBi46mlSExQ99bIHqMGlZ_u-zyLQ&oe=69E8B2CA"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3MeDlKgck0Q7kNvwHAbXTA&_nc_oc=AdrIsrUM9N9xpOTFlHXkyknMigcOJw4GBXB-2PCW3FbQ2X4FEkLv6k1FHp1MBQ0GbUY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lN7m_H4wiCVNi9qEvWLejr9jblEWJz8HXyFp7-5kN5w&oe=69E8DD9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ecp4h_KCygQ7kNvwFrqxe8&_nc_oc=Adp15Jq4eLu_-wtoqTY1Dqq9jHN2Jq2A2HXbQdpD6St-KpNvMuOtnwJQX4YMqFzQkZQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yFjkNRnHPiCLrtGKF_ac4uTdqqUVfKqSFBS6u-WxYQg&oe=69E8D099"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARGujVvHmqsQ7kNvwFV6gcb&_nc_oc=AdpRypE-x4stQ6Su2h8f5KkIl3YqQbyKBuqj07Xpj07p7cDRj1IVM-1QopSbADttT10&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=
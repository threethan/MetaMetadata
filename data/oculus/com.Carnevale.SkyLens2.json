NwDZRnSpubZSeEoRot3d_627eSk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afs43bjUJ3Q0_YRa3vnaZpV1J9FmPMur9WjjWRI32m_LJA&oe=699860AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rggc0J2B-UEQ7kNvwFBzNdl&_nc_oc=AdnWw0PkYdGxkEut4MLw4Q5IQY6FLSkFRHlHQbMu0WqB7Cmhcei4FmLJzv5JaQaLu2g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfskyomHrHuM9OqITDS2nFsh7VCX0xeLqxt3MWaP1F8gJQ&oe=6998474A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8AENkfUnJYQ7kNvwF42Sfk&_nc_oc=Adnh0fpVoCdQr9x0FlxJna44QkEDruygPfnANFbHnxlcuVDwEaQIXng4V86lAz3ecwo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfunfBc5UucICUp_62naRsjZTaRv6fJZgcESw4WrqIudKQ&oe=6998721B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VD5Ftg-Dl1MQ7kNvwGzKtwn&_nc_oc=Adlb3JE-Rd5CfWfVokwg90YRer3G8mkLFYqBfNQATHlN1dvcO4rInTtwLCyjZ15vbvo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuQfn3PiYs1JOLQtLQh5LTf-whqzVumh0SG7lxnuQgsAQ&oe=69986519"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LP8OkzeKWc4Q7kNvwF6TnuV&_nc_oc=AdkhuwYTNrWbH5jii5JtUCeJA2JCjAA6ISi1EGJa_J3fhAMOcGq9zCblZjufiyjgFFU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft4ZIwgdB_FYLGLd5vm_2bz5iVNhzATpfG4SfdY71d9LQ&oe=69984B5C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SkyLens", "platform": "ANDROID
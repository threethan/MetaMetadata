ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qnxKT5pWYsQ7kNvwELIAYg&_nc_oc=AdqgGhNGHOnaXpDK-PxXBoy05AE2Mc_TOHZmRj-JEmNBJCsH6thyOV3GiaOb-bUIk8c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-IEsUllaA4-tfz_3cAuTMZVzSfvCkeiIFisCnVjx1EQ&oe=6A144DAA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ThfqpH3OK0Q7kNvwGiDcm6&_nc_oc=AdqrEEcb3bD2qyViYqnEq1Dm33DuV6wvqOHIXIVLrt-bfoQY0jBywFX4BS3LCs6JaGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PwAA2_Zl5og1HPvSgSvLrUXhqSjNSyp9pybjoDJf8TQ&oe=6A146C8A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=md4kxyM2KHwQ7kNvwFHRBtu&_nc_oc=AdrRPS3IZFalbix9vls5KiaYWvosDSy8dXWYFt7GiGuGcqo0JvR_fqVpFkduNACM5TY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rveLLZChzKl2G6RKN7rNeL-vW2z5FqqiWhY9_FffsAw&oe=6A145F1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8KHqg0lQ88Q7kNvwGPFIp0&_nc_oc=AdpyURTcmi39SdlUdTHYQy2vuOb7Myivsfa12Y0jYK1naTmiMVWvvuFFKc8-2wFycZY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xoOvM9tdUaBxhGjtyr0lpcoNBm45pY6_94JOf8VDc8Q&oe=6A145219"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbgNNP7h11sQ7kNvwG2aTAq&_nc_oc=Adqa1XFKiZwD9KY8nnSrtzL0c9l2I60yhZvEZ24fXyynpYRHqkE5HgvtyIywyUVKkMY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=
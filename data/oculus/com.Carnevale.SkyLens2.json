ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pb2xizGn4OMQ7kNvwFv8j0_&_nc_oc=Adp2vyQKweNwfR-QnJbgwryiCRybgP3VwhFPAPd8x3rfv8f_FnKYm0hxaQUJCUT5IBM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRxr9oLaVdjJrN4ttnShiw2ecKNVlrkB10KXUxiLzS-A&oe=6A903AAA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMO3NJJayC8Q7kNvwEjAdNJ&_nc_oc=Adqz7gTY5Fk-8jW_g2M0qJEis1E5_Cw8pW-2XMK9QGQf8exQ1CRAxwUKCFcLyHWmhPg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTao_zr0XYKZWB4BitNlcxnMX-NDLzmNM0ccID4aKmMg&oe=6A90214A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LH4aKGB9vHoQ7kNvwH8fQa0&_nc_oc=Adox_eGC1pwuYaMwOdwQJDIDFc8LmTM4WXTbiHt3A91ecEnz627qK2cGPTBJ8OzYLZ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmHKAavSbIEMTc4r9wYVC04kXAnarAmLpHV523QKvlKQ&oe=6A9013DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnmdBx3lt-UQ7kNvwGaRR2R&_nc_oc=Adqo7Ew5txa0I59E4ilKdTxQczrDLWeh0taoeUj1a7i2iqPnfQbg7QurDFaEOtU-B_Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFysAxX-NuwXeCOTzth8OFObjiCLKlQT0v_7vJtQLaV_g&oe=6A903F19"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wArxCAKhCkgQ7kNvwHyFfH0&_nc_oc=AdqWvEVe84zuwmWQmzp6nVwy0-vo1HiyQoTyy_pxJ_9WtOIb1IYM14FocvbC-YfqrUU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=
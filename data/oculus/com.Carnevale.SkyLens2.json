ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6u7YE6KFzuwQ7kNvwGbzXf9&_nc_oc=AdpB7Fp5rVZE9xm0hU0MflUbKz3T1KNkbxxxtSLUf-T-DsdsL5nmvc-GHn9wxGD0FV8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6jKvEvhHl_r_41b7XYoJTkeci4fF-pcvPckwpKhL0aw&oe=6A6DF3AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuBS7Zt7vMoQ7kNvwFnm0H1&_nc_oc=AdqNOgAeFcLfVwS0Aw9S6seH9V2WqA6RPRIQx0IzFIMMqr_Vpi3jnvk6oAZscH46aHc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkuvWeHEJaCFhOsEXNsZ0sLv-5BOK09QBjgIIHuYRFYA&oe=6A6DDA4A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDfSHr0-Yc8Q7kNvwG-1AxN&_nc_oc=Adpt0JnmhW8updPYcypIZrSFg5BYUwF1cwWeZNv4FkPe4SF-XM3_QvA4YOUNFXO0L1k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQ6FZy-5u_beGPP29R33re550k5nKJhu8PODLaBCf78Q&oe=6A6E051B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ibd52orZgbwQ7kNvwE67NAP&_nc_oc=AdrSwIH4_lWk_xjM48LpXChi93ax6Cdi3HEEvbonSjn8Doht4iPIil61ofIX_qzZVn0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1JTTTValv6zmwCiDoBxmCfmuWiiY-H2XQkwrbGeU7pQ&oe=6A6DF819"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTn5HT7toNkQ7kNvwGxyQBb&_nc_oc=AdqFiQtxIP6fBNhmMDI2xQW-OdgRo-USDdU7GIajZmwIe7Ms2DNhyVYDoma4c50VJCE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=
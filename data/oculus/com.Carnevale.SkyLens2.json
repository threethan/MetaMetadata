U86ZbAWTACFvh1ARfYaQKXGUcQc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftKH3dQkwJ70QOcKXgGjlmD3G1LqBFT-OyhBWPXBcp4uQ&oe=69A43E2A"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sII8iQeWTZYQ7kNvwEIMNSg&_nc_oc=AdkBleI68JsVS4Zm8MuEJpDKJhC3-EM5uQjsnN7yN8ij3jiqZoEn_D4HllMnpWpU8rc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afthx4rB32zoGWkUSNQLDH6O9T4MI_024Y0aRAw8tGsrwA&oe=69A424CA"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z1RA2Isll88Q7kNvwH4NZNp&_nc_oc=Adlkp7ktwQ_LbwI8u42P7JaVwfWac2P1E7FYqhb7vH_s3YzFCgBM4b09SScufwZ6oOs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvSMO94JVWZSc4Jc_Yh94a5nheW70SmGFQJqejgD0i2kA&oe=69A44F9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZxnOTy3gr8Q7kNvwG1ST8P&_nc_oc=AdkVo2qeDzup66__JxLlu4rhpcJJpuyRDDtt8u0zJCRhYSS6u2cIxmEbLrIn6CUebR8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsHgF3kPKCZLeQcGRYrKfFthGGazpsOPQyJTkjIuH4dCg&oe=69A44299"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PH9CbN2gSDkQ7kNvwG_uHq2&_nc_oc=AdnRMAl61lvKzFKvXQcCj42KVmAfS6cGfHazWCO4tXdkSe11KV03feS6wgAVQuyDTeI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft4Do2n7GtaeBOW9L0QHJKIEHIB37HdZvBx0YJpfg1yPw&oe=69A428DC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SkyLens", "platform": "ANDROID
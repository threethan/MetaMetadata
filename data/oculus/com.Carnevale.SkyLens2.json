ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dE8vNmgSBgMQ7kNvwHG4W2v&_nc_oc=AdqjFCHWVXqy2M0Vd8aPoVI2_MsLescgba82AP92XsV0q1X9FE05OOgqTCWECBlABIA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6R1BfKuchHiVHHJUQxZjke8WzaGm3Sm2l6fvMGEoM3lA&oe=6A01D8AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFyWYHuJybkQ7kNvwFFyRrM&_nc_oc=AdpWRGUbU8Z-OMCHhSrPH0Su56zGujRSYdV9RhtzC2FX3FUNSyX5yeFv1KKV6ptsdKA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ulldYEhe1cba4XFSQHBToHeZWHBmY80CpzigozTtxaw&oe=6A01F78A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmq7RW4DmSoQ7kNvwEwoEPn&_nc_oc=Adp__NkQXEHMSQv0qonvG28Y4QIc6FIPLEWiAV0egDRgD7lZAZA2w_22u4VKV8vgpPI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af646H27an9vlFjzZif6qRhrpPiQihNsvmWYk2yo0ee9FA&oe=6A01EA1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2suSAflJFS4Q7kNvwEXvVtd&_nc_oc=AdoHt7Y3ZebQHIvi7QFmHCpoEqiARCYTW6w5NV0KRv30FpLgX15u1p2pcGJh76LUl4Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JXAer9Z5JmTf7_fLbASgwF1zRLfUqoaNpXPcW30bgyw&oe=6A01DD19"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAIIITmfDcsQ7kNvwHBnda1&_nc_oc=AdoQoGBQZgm7FEAI8uz18c17j_nQeMbj72Z51A9BnHglpXROqF06N4akmoPyRFA7XG0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=
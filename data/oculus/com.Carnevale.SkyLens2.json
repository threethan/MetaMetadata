ng?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dE8vNmgSBgMQ7kNvwHvLYco&_nc_oc=AdpGKNZecP5Eomh4NU2zUZWTCqeSBrr9NXZRo6o-LqnpVFzHiPSjyuvNiAoGAIpgTWw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-LJv8-XZfPJ3r10BXbYDfM6HMBCsD1nh0gKIio_Zo_Q&oe=69FF35AA"}, {"file_name": "Voice.png", "id": "1188072149090595", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75639796_1188072152423928_3859487897109674860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BuQZywXgvEYQ7kNvwFneLET&_nc_oc=AdqZFTnfA6GB3BDfVk_m7ZopOzASMptq0J_9xsXRI0Dp1xDDZSzi-jOKgXbxTBrk6Qo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75BFz7Yno9KCXUC6N1dzjz3pN0tq3o1lhhuDs9IloMdQ&oe=69FF1C4A"}, {"file_name": "Sats.png", "id": "519690867478072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/427336364_519690874144738_1555330507671014573_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzatFB2nKYYQ7kNvwHS3H9F&_nc_oc=Adp-Q2Y_dwOIrgZx2Tr6Kdl8rl2MH1iVId9IoxnXJlwMB3JvLFpSapoUhbH6OYS9Dsk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wtYPg-n3ztqQcCt9o7MBArg3yHvy8Iv1Ll0NOn6RdHA&oe=69FF471B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1183954759355001", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75612011_1183954762688334_7472894946712134861_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2suSAflJFS4Q7kNvwGY8BkH&_nc_oc=AdrrSc0XV1vSj70dBa9PY-yGsKlKZnHxdDyfvGtBPsQ1J6SstRDjv1-Oo6zN4-5HUUo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74XfNHR-RrAMGVKlir0GKP1iHDB-QyN0D80zsEK6KwHw&oe=69FF3A19"}, "display_name": "SkyLens", "keywords": [], "long_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n\nWith our proprietary Dynamic Data Lens, SkyLens overlays a tremendous amount of data in AR mode and can transport you to any location in VR. Simply say \"Take me to Paris,\" and SkyLens will whisk you to the City of Light in VR mode, where you'll experience live weather, aircraft, and satellite data as if you were standing on the Champs-\u00c9lys\u00e9es. Use the innovative bubble control to fly above the cityscape.\n\nWhether you're a traveler, weather enthusiast, or just curious about distant places, SkyLens uncovers a fascinating world of invisible data.", "short_description": "Introducing SkyLens\u2014your gateway to a new world of weather, aerospace, and location-based real-time data. Explore the sky above with live updates on weather, aircraft, and satellite positions.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skylensapp.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CARNEVALE", "support_website_url": null, "website_url": "https://www.skylensapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27017171177930472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974552_884210913552927_6874955230517852362_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJgLPbvLtN4Q7kNvwEDsu4H&_nc_oc=Adri_UljG_YD5d5EvSwGixvW5-kfTO29Zt0gpO9Jobtk7iFHjGarnEfxFH5Tw5HeRlI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=
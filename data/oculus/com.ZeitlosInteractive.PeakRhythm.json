nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlXWv-9NhMvcpn25lCXJulQhr36ZgifWWhP-qIB1YFtg&oe=6AB13992"}, {"file_name": "112.png", "id": "919234247326315", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298291_919234250659648_3225944418494968782_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2hABtxrL5EQ7kNvwGkaKpZ&_nc_oc=AdqoUCaB3p61ADTEFJM9cfHFKDawr4mTr85lPpFOtcG6SewPrDy-ovCivm8W2NPBAjo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjwJ85hRwC1So6WRKPqB7QsrcH3mRwgOnA0iv9TGtQGQ&oe=6AB14C88"}, {"file_name": "113.png", "id": "932200949318965", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296183_932200952652298_7166229103004231922_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWB9F_2PjakQ7kNvwFnC9_W&_nc_oc=Adp8WHYYLrpC8NRZqjnrtOA2nk2ulzCGyV1625zO2_ovSyulN78IYpT5Zush0xHxlO8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZgVW2UNX93S6jyMu-Ctj0WA23mAuHHobiZSshBZaEbw&oe=6AB12C16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560.png", "id": "985057036727083", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036639_985057043393749_3945160790566893943_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuoaV1PS-YAQ7kNvwFlN8Lp&_nc_oc=Adq__2g619kg3qqwupBEBVZV4PPw8ce5HobDnHA6vzsBjg2_6oauc-HPxNChRHE8uMI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMq5mmY1b4Cza8kWpGvD38XScTYmWtFm3nA1uHEHiXZA&oe=6AB155CF"}, "display_name": "Peak Rhythm", "keywords": ["Peak", "Rhythm", "Climbing", "Beat"], "long_description": "**Peak Rhythm** is a VR rhythm-climbing game where music drives momentum. Every grab and twist powers your robotic platform upward through a neon-soaked city.\n\nSync your moves to a high-octane electronic soundtrack to master the flow and dominate global leaderboards. Blending physical precision with Cyberpunk aesthetics and Y2K energy, your rhythm is your engine.\n\n**Don\u2019t just climb\u2014perform.**\n\n{3227020670835876}\n\n### \ud83d\udd79\ufe0f GAME FEATURES\n\n- **Rhythm-Powered Climbing:** Master \u201cRegular\u201d grabs, \u201cMulti-Twists\u201d (volume knob motion), and \u201cDouble\u201d holds on a 5x5 grid. Perfect hits boost your speed; misses slow you down.\n- **Solo Mastery:** Ascend 8 original tracks across 3 difficulties to perfect your runs. Compete for the highest altitude on map-specific leaderboards.\n- **The Soundtrack:** Launching with music from indie artists **FEISTLING, Killin\u2019 Void, Ion Diary,** and **funiel**, spanning Drum & Bass, Dubstep, and House.\n- **Custom Content:** Includes a fully functional **Beatmap Editor** at launch. Create your own maps with your own music.\n\n{1918357589050667}\n\n### \ud83d\ude80 EARLY ACCESS ROADMAP\n\nThe climb is just beginning. We are committed to delivering frequent updates based on your feedback. Planned features include:\n\n- **Social Multiplayer:** Climb side-by-side with friends in real-time.\n- **Ranked Mode:** Competitive knockout tournaments.\n- **Voice Chat:** In-game communication.\n- **Character Customization:** Personalize your avatar\u2019s look.\n- **Cross-Platform Play:** Expanding to other VR headsets.\n\nJoin our community to help shape the future of Peak Rhythm!\n\n\n**[Discord Link: https://discord.gg/RZuzxpRcyV]**", "short_description": "Ascend to the beat in Peak Rhythm! In this VR rhythm-climbing game, every grab and twist drives your robotic platform upward through a neon-soaked city. Sync your moves to a high-octane electronic soundtrack to master the flow and dominate global leaderboards. Blending physical precision with Cyberpunk aesthetics, your rhythm is your engine. Don\u2019t just climb\u2014perform."}]}, "developer_name": "Zeitlos Interactive", "developer_privacy_policy_url": "https://docs.google.com/document/d/1m9m8oIvVGi1Jxm-RDJnRC5fAazVq8xWyeuEFiFQgQVc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Impact Inked", "support_website_url": 
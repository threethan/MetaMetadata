e=6A3E7C35"}, {"file_name": "Monkey_Portrait_META_1008x1440.png", "id": "884918977768489", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296077_884918981101822_7167061728395023535_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h53Dk2u-2PEQ7kNvwFWVgv6&_nc_oc=AdrwQgLLzlDZzXeRkz3fso9NGTv-3QfaWXbzNWUbemX54oArt8QvYaNErDRO-aPQ-w4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A2mNj6vR9Unkkkf7YrYQGRlzC4w52C3Hk8Rt-uEIknw&oe=6A3E8F92"}]}, "id": "1651878689560116", "locale": "en_US", "screenshots": [{"file_name": "111.png", "id": "25916931177957435", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307311_25916931191290767_3818196392550984477_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFbvMddsHKEQ7kNvwENZKFD&_nc_oc=Adr_Sm6yK9z5o7-mkyatfbDMbEOGwLIsMmVV7432IoUhmp7uG6UazsTR0m-0vGM0FMM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zsYDReXfyGKDjZ_mV1O_qkq8_2-F3bJKYnkfV3AI1ig&oe=6A3E7D98"}, {"file_name": "114.png", "id": "1535648550850321", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296236_1535648557516987_411574390659179791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPgG1RnHKKgQ7kNvwGmzOiF&_nc_oc=AdpZuLmY9DJ2REDTawErHCLgKjtoJsPK87Q4Q-00v6S8Nc6ls9pTWRsjAyEiQIpDAM8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OkvtdKwMJPibepBB7MSTiiPOeuY7Grn6zkjJ2Yt8CMQ&oe=6A3E7FDE"}, {"file_name": "115.png", "id": "1452980166228862", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620875_1452980172895528_3408575233146654177_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8MNPH-zNH0Q7kNvwGdwdj6&_nc_oc=AdqTWHbwYPMwCDCMVBVz4YU8Ru1HnksPhwFhBU0TjmnXQAkSD0pwY77ghjFIHTvKXmU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zGkfZ_kxheiSS2ys7qRCUG8_1pWdLxMEoWsMlNY3Vdg&oe=6A3E8712"}, {"file_name": "112.png", "id": "919234247326315", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298291_919234250659648_3225944418494968782_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHx-uzK8ON4Q7kNvwFOS5es&_nc_oc=AdpmwbshMgwWdDJKq8YfKLOFDcfoWF_J7A1LA78NBhwBS2HwHF4SFMsVIGNYs13ea1c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af890D1lAOosOHW9yuxjoSk8AyG-rziKSZfCRHusBYtsRQ&oe=6A3E9A08"}, {"file_name": "113.png", "id": "932200949318965", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296183_932200952652298_7166229103004231922_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VH350veAlKEQ7kNvwFcmOmA&_nc_oc=AdojGLWMbh1hCasAb5iaNrpmkfrrSy13J7GPRsxSebaOSk6Mr-9YZiFZ8mwrpyqmow0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80TQ-Mpo2Z5BOAurT_rLVqIvW6FVDMSHOE2gG-qe5UWA&oe=6A3E7996"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560.png", "id": "985057036727083", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036639_985057043393749_3945160790566893943_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-G5Xe6IkfPoQ7kNvwFeXjy7&_nc_oc=AdrFpMuzF_qcBkY7f7y-aLub4Pz09vNzO2Bxd45dIPpaUkb7DRQKnYO_i1HXdUxY2Qw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ebiWODqXGLpnaTBYb7W89efAsAZvvK6Q7hiXD9h4aMA&oe=6A3EA34F"}, "display_name": "Peak Rhythm", "keywords": ["Peak", "Rhythm", "Climbing", "Beat"], "long_description": "**Peak Rhythm** is a VR rhythm-climbing game where music drives momentum. Every grab and twist powers your robotic platform upward through a neon-soaked city.\n\nSync your moves to a high-octane electronic soundtrack to master the flow and dominate global leaderboards. Blending physical precision with Cyberpunk aesthetics and Y2K energy, your rhythm is your engine.\n\n**Don\u2019t just climb\u2014perform.**\n\n{3227020670835876}\n\n### \ud83d\udd79\ufe0f GAME FEATURES\n\n- **Rhythm-Powered Climbing:** Master \u201cRegular\u201d grabs, \u201cMulti-Twists\u201d (volume knob motion), and \u201cDouble\u201d holds on a 5x5 grid. Perfect hits boost your speed; misses slow you down.\n- **Solo Mastery:** Ascend 8 original tracks across 3 difficulties to perfect your runs. Compete for the highest altitude on map-specific leaderboards.\n- **The Soundtrack:** Launching with music from indie artists **FEISTLING, Killin\u2019 Void, Ion Diary,** and **funiel**, spanning Drum & Bass, Dubstep, and House.\n- **Custom Content:** Includes a fully functional **Beatmap Editor** at launch. Create your own maps with your own music.\n\n{1918357589050667}\n\n### \ud83d\ude80 EARLY ACCESS ROADMAP\n\nThe climb is just beginning. We are committed to delivering frequent updates based on your feedback. Planned features include:\n\n- **Social Multiplayer:** Climb side-by-side with friends in real-time.\n- **Ranked Mode:** Competitive knockout tournaments.\n- **Voice Chat:** In-game communication.\n- **Character Customization:** Personalize your avatar\u2019s look.\n- **Cross-Platform Play:** Expanding to other VR headsets.\n\nJoin our community to help shape the future of Peak Rhythm!\n\n\n**[Discord Link: https://discord.gg/RZuzxpRcyV]**", "short_description": "Ascend to the beat in Peak Rhythm! In this VR rhythm-climbing game, every grab and twist drives your robotic platform upward through a neon-soaked city. Sync your moves to a high-octane electronic soundtrack to master the flow and dominate global leaderboards. Blending physical precision with Cyberpunk aesthetics, your rhythm is your engine. Don\u2019t just climb\u2014perform."}]}, "developer_name": "Zeitlos Interactive", "developer_privacy_policy_url": "https://docs.google.com/document/d/1m9m8oIvVGi1Jxm-RDJnRC5fAazVq8xWyeuEFiFQgQVc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Impact Inked", "support_website_url": null, "website_url": "https://zeitlos-interactive.com/projects/peak-rhythm", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics":
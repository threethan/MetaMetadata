scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8z9wlERafQbQcbsWkPFldQOk9VOKJrR0ZwXWZ4pw0gNA&oe=6A3FEB88"}, {"file_name": "113.png", "id": "932200949318965", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296183_932200952652298_7166229103004231922_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VH350veAlKEQ7kNvwFD8-0C&_nc_oc=AdqrFqJuUn_rKMsEaFwv0VpFdKd34zPaf3tQnCWzNi0Lam850PiOev5KsRdXs3nO16g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JyzQEOS0Q9jsfIX-bVg1qC9DWy9TAGbQJLyKLKRtlVg&oe=6A3FCB16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey_Landscape_META_Multiplayer update.png", "id": "1417060986392015", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618102_1417060989725348_8534853147061436651_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuUGKqIBZuYQ7kNvwGVSoUq&_nc_oc=Adrx0w9NXVjsgjGx0pSYISlNHIca8y_adKQ6C-21LtKsauWhdW9osaV83n7zPTlKJ6k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VkmxyLtmh9IJ2sVZHWarxjTXacTwAJ-3ALhGMCHTZDg&oe=6A3FD2BF"}, "display_name": "Peak Rhythm", "keywords": ["Peak", "Rhythm", "Climbing", "Beat"], "long_description": "**A VR RHYTHM GAME BUILT ON TIMING, MOVEMENT, AND MOMENTUM**\n\nPeak Rhythm is a high-intensity **VR rhythm game** where you climb by moving in sync with the music. Designed for fans **of music games, multiplayer VR, and fitness gameplay**, every run tests your timing, focus, and endurance.\n\nClimb through a neon cyberpunk city by **landing each grab in rhythm**. Every correctly timed movement builds speed. Stay on beat to accelerate. Fall out of rhythm and lose momentum.\n\n\n{1238897895052210}\n\n# \ud83d\udd79\ufe0f**FEATURES**\n- **Rhythm-Based Climbing** - Time your grabs, twists, and jumps to stay in sync and maintain flow\n- **Momentum Driven Gameplay** - \n Accurate timing increases speed and keeps your climb alive\n- **Solo Play + Global Leaderboards** - \n Climb 7 original tracks across 3 difficulty levels and compete for the highest run\n- **Multiplayer (Up to 4 Players)** - \n Climb alongside friends or compete in real time\n- **Electronic Soundtrack** - \n Drum and Bass, Dubstep, and House tracks designed for flow\n- **Custom Songs & Beatmaps** - \nCreate and play your own levels with your own music\n- **Avatar Customization**\n\n{822324106879582}\n\n# \ud83c\udfc1 **BUILT FOR VR FITNESS & REPLAYABILITY**\nFull-body movement designed for active gameplay\nImprove coordination, timing, and endurance\nHigh replay value through score chasing and user content\n\n# \ud83d\ude80 **EARLY ACCESS**\nPlanned updates include:\n- More songs\n- Voice chat\n- Cross-platform play\n\n**CLIMB FASTER. MOVE SHARPER. STAY IN RHYTHM.**\n\nJoin our community to help shape the future of Peak Rhythm!\n\n\n**[Discord Link: https://discord.gg/RZuzxpRcyV]**\n\n{1495473138871447}", "short_description": "Ascend to the beat in Peak Rhythm! In this VR rhythm-climbing game, every grab and twist drives your robotic platform upward through a neon-soaked city. Sync your moves to a high-octane electronic soundtrack to master the flow and dominate global leaderboards. Blending physical precision with Cyberpunk aesthetics, your rhythm is your engine. Don\u2019t just climb\u2014perform."}]}, "developer_name": "Zeitlos Interactive", "developer_privacy_policy_url": "https://docs.google.com/document/d/1m9m8oIvVGi1Jxm-RDJnRC5fAazVq8xWyeuEFiFQgQVc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Impact Inked", "support_website_url": null, "website_url": "https://zeitlos-interactive.com/projects/peak-rhythm", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "pla
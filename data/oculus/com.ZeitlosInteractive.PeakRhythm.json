&oe=6A08725E"}, {"file_name": "115.png", "id": "1452980166228862", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620875_1452980172895528_3408575233146654177_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aFiyYGFqroQ7kNvwHnmotC&_nc_oc=AdqayAgZTENoxm5wRGEePoCXKnZIQWbPcZofQF4nLWNtYT9UoqPpKu9WZ23CX1RmlqE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6d-IZbEgOSziTRFdnWzunG1QVihH7dYudfy_5pNGYqIQ&oe=6A087992"}, {"file_name": "112.png", "id": "919234247326315", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298291_919234250659648_3225944418494968782_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhAVQ_4B3ewQ7kNvwEz-VnN&_nc_oc=Ado_thW17RlWSa1LD0y7StaHG9lk8yh7L1E_r6ViAj83wYwWHWGEHEeNir8O7ufoqTU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UvYogAQNedh4WZRaHtwGNGGTsnkL54sW3afK4OWdFLQ&oe=6A088C88"}, {"file_name": "113.png", "id": "932200949318965", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296183_932200952652298_7166229103004231922_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBA7XI3b6GUQ7kNvwFkG5Cl&_nc_oc=Adp_V7TqJ1Jt3Tt1kKVu8GlDG0R25kh092ejj_EZAI19gKWIWU9hob1rVgPTGDqLdOA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BRXXyZtzl3kpx3FJDO0nWF1nlbZC33D5SwTxlITK2wQ&oe=6A086C16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560.png", "id": "985057036727083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036639_985057043393749_3945160790566893943_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBhIQFikD3cQ7kNvwFTC_vb&_nc_oc=AdrA9nMAvMcr_B4utVV2Iaw9-4XphF_Z9_lwnTauJ4-qZULX5nPsFUVMTkG3lX28xms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yP0Y1qQ2FKxYg-0dxbjsET1Rk-UvoilfxP7O4pG6QdQ&oe=6A085D8F"}, "display_name": "Peak Rhythm", "keywords": ["Peak", "Rhythm", "Climbing", "Beat"], "long_description": "**Peak Rhythm** is a VR rhythm-climbing game where music drives momentum. Every grab and twist powers your robotic platform upward through a neon-soaked city.\n\nSync your moves to a high-octane electronic soundtrack to master the flow and dominate global leaderboards. Blending physical precision with Cyberpunk aesthetics and Y2K energy, your rhythm is your engine.\n\n**Don\u2019t just climb\u2014perform.**\n\n{3227020670835876}\n\n### \ud83d\udd79\ufe0f GAME FEATURES\n\n- **Rhythm-Powered Climbing:** Master \u201cRegular\u201d grabs, \u201cMulti-Twists\u201d (volume knob motion), and \u201cDouble\u201d holds on a 5x5 grid. Perfect hits boost your speed; misses slow you down.\n- **Solo Mastery:** Ascend 8 original tracks across 3 difficulties to perfect your runs. Compete for the highest altitude on map-specific leaderboards.\n- **The Soundtrack:** Launching with music from indie artists **FEISTLING, Killin\u2019 Void, Ion Diary,** and **funiel**, spanning Drum & Bass, Dubstep, and House.\n- **Custom Content:** Includes a fully functional **Beatmap Editor** at launch. Create your own maps with your own music.\n\n{1918357589050667}\n\n### \ud83d\ude80 EARLY ACCESS ROADMAP\n\nThe climb is just beginning. We are committed to delivering frequent updates based on your feedback. Planned features include:\n\n- **Social Multiplayer:** Climb side-by-side with friends in real-time.\n- **Ranked Mode:** Competitive knockout tournaments.\n- **Voice Chat:** In-game communication.\n- **Character Customization:** Personalize your avatar\u2019s look.\n- **Cross-Platform Play:** Expanding to other VR headsets.\n\nJoin our community to help shape the future of Peak Rhythm!\n\n\n**[Discord Link: https://discord.gg/RZuzxpRcyV]**", "short_description": "Ascend to the beat in Peak Rhythm! In this VR rhythm-climbing game, every grab and twist drives your robotic platform upward through a neon-soaked city. Sync your moves to a high-octane electronic soundtrack to master the flow and dominate global leaderboards. Blending physical precision with Cyberpunk aesthetics, your rhythm is your engine. Don\u2019t just climb\u2014perform."}]}, "developer_name": "Zeitlos Interactive", "developer_privacy_policy_url": "https://docs.google.com/document/d/1m9m8oIvVGi1Jxm-RDJnRC5fAazVq8xWyeuEFiFQgQVc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Impact Inked", "support_website_url": null, "website_url": "https://zeitlos-interactive.com/projects/peak-rhythm", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25197402373267632"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2468429903673066"}, {"status": "PUBLISHED", "id": "889796700576504"}]}, "baseline_offer": {"id": "889796700576504"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "2468429903673066"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25868942679446928", "version": "0.7.0423"}, "id": "1424252264915686", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7639650372802770", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25868942679
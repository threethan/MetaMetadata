AkTPKUZ2ECCsOWcEXHGc8jABrc90wZw&oe=69B01B83"}]}, "id": "1250309949821516", "locale": "en_US", "screenshots": [{"file_name": "111.png", "id": "25916931177957435", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307311_25916931191290767_3818196392550984477_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MR-Da-2qwyQQ7kNvwFZwg4x&_nc_oc=Adk7qIJOJvpW_CM5BXam3ckLMz5Z6BN8NKYt64sHc-YNoMIfHQCV-kNdnxAm3tkXLhQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVQstMCUvUa5Z6SgnBWSYbPHfM8t30FNj27_ca2cvvPA&oe=69B01B98"}, {"file_name": "114.png", "id": "1535648550850321", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296236_1535648557516987_411574390659179791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGrSGImbCnwQ7kNvwExJUYq&_nc_oc=AdmWTuPfs-lF-ZBGLyyAl6Vm827BJCoL47DjW2aO5ya-O5jlNQCv6scMpWWnxN9rqMU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3GMcnlmShd10GClmPq4yYKwkXXwr4Ex6XDpyBQhdcnw&oe=69B01DDE"}, {"file_name": "115.png", "id": "1452980166228862", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620875_1452980172895528_3408575233146654177_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bfu8DRX99xcQ7kNvwEolNog&_nc_oc=AdnM7rhEfQ5SpbopZ04QM1ZH1GC_is2W4mSy9koyJwJ5zV2rz3b1-T1OPOcewl_vuMo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyK1P6D6u-dU1f-YS1_Fn-Kj1qTIkmDEJBErKX9As619Q&oe=69B02512"}, {"file_name": "112.png", "id": "919234247326315", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298291_919234250659648_3225944418494968782_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_voFgY6nkNAQ7kNvwHcArvx&_nc_oc=AdmucShnXGHdeCzmB2e0vzIojX-RoBKTe0nMabJV5oEynJ8cfFGHrrsTiuwgiXX6e18&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwOnnWl8fTa3JuxxTHMGKfxNW9XVmugwfUV1zXGgjuTnQ&oe=69AFFFC8"}, {"file_name": "113.png", "id": "932200949318965", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296183_932200952652298_7166229103004231922_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfADe01dszMQ7kNvwHlqSre&_nc_oc=Adl2WluSOvHveoFB4hhfZKpIfVHluhRcRcUGpU1C2Qw56At_kOJ2_chMrZdd1MLVQps&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxg3kX96KauyVBqtVdoj6lIiQf8hnnYB86ZitNnxE6bIQ&oe=69B01796"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey_Landscape_META.png", "id": "1446150356946572", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623131_1446150360279905_7844833360176196988_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nfi1a3JZmzUQ7kNvwGYMii_&_nc_oc=Adlly7ZHUyqfjUqyGvkMWjXTVc4oOnm2WDG7oB4-DqIJ_pFhCGiDrMc_vzCpY5JDiPQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRGuR6-sK7Wb_o_smBFKal2HiwRpLphC0qFI0C1l0D-g&oe=69B02193"}, "display_name": "Peak Rhythm", "keywords": ["Peak", "Rhythm", "Climbing", "Beat"], "long_description": "**Peak Rhythm** is a VR rhythm-climbing game where music drives momentum. Every grab and twist powers your robotic platform upward through a neon-soaked city.\n\nSync your moves to a high-octane electronic soundtrack to master the flow and dominate global leaderboards. Blending physical precision with Cyberpunk aesthetics and Y2K energy, your rhythm is your engine.\n\n{1238897895052210}\n\n### \ud83d\udd79\ufe0f GAME FEATURES\n\n- **Rhythm-Powered Climbing:** Master \u201cRegular\u201d grabs, \u201cMulti-Twists\u201d (volume knob motion), and \u201cDouble\u201d holds on a 5x5 grid. Perfect hits boost your speed; misses slow you down.\n- **Solo Mastery:** Ascend 8 original tracks across 3 difficulties to perfect your runs. Compete for the highest altitude on map-specific leaderboards.\n- **The Soundtrack:** Launching with music from indie artists **FEISTLING, Killin\u2019 Void, Ion Diary,** and **funiel**, spanning Drum & Bass, Dubstep, and House.\n- **Custom Content:** Includes a fully functional **Beatmap Editor** at launch. Create your own maps with your own music.\n\n{1495473138871447}\n\n### \ud83d\ude80 EARLY ACCESS ROADMAP\n\nThe climb is just beginning. We are committed to delivering frequent updates based on your feedback. Planned features include:\n\n- **Social Multiplayer:** Climb side-by-side with friends in real-time.\n- **Ranked Mode:** Competitive knockout tournaments.\n- **Voice Chat:** In-game communication.\n- **Character Customization:** Personalize your avatar\u2019s look.\n- **Cross-Platform Play:** Expanding to other VR headsets.\n\nJoin our community to help shape the future of Peak Rhythm!\n\n\n**[Discord Link: https://discord.gg/RZuzxpRcyV]**", "short_description": "Ascend to the beat in Peak Rhythm! In this VR rhythm-climbing game, every grab and twist drives your robotic platform upward through a neon-soaked city. Sync your moves to a high-octane electronic soundtrack to master the flow and dominate global leaderboards. Blending physical precision with Cyberpunk aesthetics, your rhythm is your engine. Don\u2019t just climb\u2014perform."}]}, "developer_name": "Zeitlos Interactive", "developer_privacy_policy_url": "https://docs.google.com/document/d/1m9m8oIvVGi1Jxm-RDJnRC5fAazVq8xWyeuEFiFQgQVc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Impact Inked", "support_website_url": null, "website_url": "https://zeitlos-interactive.com/projects/peak-rhythm", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
": "114.png", "id": "1535648550850321", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296236_1535648557516987_411574390659179791_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqJi1xT4_yQQ7kNvwGDgC-w&_nc_oc=AdoBik9rvqOj694j0WE9CIgHgYoTW9GPKIf6Fmp-lBWOX9OiporkgaU1Fl9p2NheiZU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWuHM1exD7ZkrrLkVynVtiGfebftFGTY_i5ZNjI4h6pA&oe=6B09BF1E"}, {"file_name": "115.png", "id": "1452980166228862", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620875_1452980172895528_3408575233146654177_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJimz7S6A34Q7kNvwGpygrb&_nc_oc=AdqVgQwJ69M0mH6Mkk8B8FOF3uFlI0gSVefEac6LH09jbAi9wbhdF1YuVl85DW2cTzQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0f31BLUXXfrJgS1Jg-UgRjYuc26jTTkRHKiBdBEgo4Q&oe=6B09C652"}, {"file_name": "112.png", "id": "919234247326315", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298291_919234250659648_3225944418494968782_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nVkL-WPW9sQ7kNvwE6C8uD&_nc_oc=AdrkTleCAe4gk4U5dn4wEIW8K7-6SDVTEue86beSSjXEmMBVRA7TrsCqcsCbCEwamjw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQufTH5l92_MHy1yE0LRrdK8O2UCGTr8XQ3-ggSwEnkQw&oe=6B09A108"}, {"file_name": "113.png", "id": "932200949318965", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296183_932200952652298_7166229103004231922_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgSBMbHpPZEQ7kNvwEVsMHj&_nc_oc=Adp30HBTSmv6ZZwzYnCR8la-Hi3s8G0GZP-XuI12EFzLYljIec6curodFusMnw_1HJA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRm2elvaR_z_RXLuaexEvmKwTATEKkPAaF7u3FkLB_Wjw&oe=6B09B8D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560.png", "id": "985057036727083", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036639_985057043393749_3945160790566893943_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfB9cuEj3xUQ7kNvwFsOCR9&_nc_oc=AdqGmJ1DZBhrT3ION_4DglncfqGKBG7XclaVvYy1AuN9HcZi2v7MJUZNDnPHXJ902tw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_5j_oPk3wR6D46FcAImEF9GnBlNe6Vp4pZJgV1pfmTw&oe=6B09AA4F"}, "display_name": "Peak Rhythm", "keywords": ["Peak", "Rhythm", "Climbing", "Beat"], "long_description": "**Peak Rhythm** is a VR rhythm-climbing game where music drives momentum. Every grab and twist powers your robotic platform upward through a neon-soaked city.\n\nSync your moves to a high-octane electronic soundtrack to master the flow and dominate global leaderboards. Blending physical precision with Cyberpunk aesthetics and Y2K energy, your rhythm is your engine.\n\n**Don\u2019t just climb\u2014perform.**\n\n{3227020670835876}\n\n### \ud83d\udd79\ufe0f GAME FEATURES\n\n- **Rhythm-Powered Climbing:** Master \u201cRegular\u201d grabs, \u201cMulti-Twists\u201d (volume knob motion), and \u201cDouble\u201d holds on a 5x5 grid. Perfect hits boost your speed; misses slow you down.\n- **Solo Mastery:** Ascend 8 original tracks across 3 difficulties to perfect your runs. Compete for the highest altitude on map-specific leaderboards.\n- **The Soundtrack:** Launching with music from indie artists **FEISTLING, Killin\u2019 Void, Ion Diary,** and **funiel**, spanning Drum & Bass, Dubstep, and House.\n- **Custom Content:** Includes a fully functional **Beatmap Editor** at launch. Create your own maps with your own music.\n\n{1918357589050667}\n\n### \ud83d\ude80 EARLY ACCESS ROADMAP\n\nThe climb is just beginning. We are committed to delivering frequent updates based on your feedback. Planned features include:\n\n- **Social Multiplayer:** Climb side-by-side with friends in real-time.\n- **Ranked Mode:** Competitive knockout tournaments.\n- **Voice Chat:** In-game communication.\n- **Character Customization:** Personalize your avatar\u2019s look.\n- **Cross-Platform Play:** Expanding to other VR headsets.\n\nJoin our community to help shape the future of Peak Rhythm!\n\n\n**[Discord Link: https://discord.gg/RZuzxpRcyV]**", "short_description": "Ascend to the beat in Peak Rhythm! In this VR rhythm-climbing game, every grab and twist drives your robotic platform upward through a neon-soaked city. Sync your moves to a high-octane electronic soundtrack to master the flow and dominate global leaderboards. Blending physical precision with Cyberpunk aesthetics, your rhythm is your engine. Don\u2019t just climb\u2014perform."}]}, "developer_name": "Zeitlos Interactive", "developer_privacy_policy_url": "https://docs.google.com/document/d/1m9m8oIvVGi1Jxm-RDJnRC5fAazVq8xWyeuEFiFQgQVc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Impact Inked", "support_website_url": null, "website_url": "https://zeitlos-interactive.com/projects/peak-rhythm", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25197402373267632"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1456094360017518"}, {"status": "PUBLISHED", "id": "27999033089699001"}, {"status": "PUBLISHED", "id": "2468429903673066"}, {"status": "PUBLISHED", "id": "889796700576504"}]}, "baseline_offer": {"id": "889796700576504"}, "is_approved": true, 
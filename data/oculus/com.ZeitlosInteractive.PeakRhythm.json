8"}, {"file_name": "113.png", "id": "932200949318965", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499296183_932200952652298_7166229103004231922_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B95Gm-9zUogQ7kNvwFFbKO0&_nc_oc=AdohDiaUPO7lnNo4KJQlWf0WQ38apqcNqJqZkPfkkfhbIGHCkK_EwIs2ZooVvjS7YH0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1kXj8F3oPIh0KsvlH9Xi7XeMEnDVMLGFuYvxzKidaP2A&oe=69F20296"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560.png", "id": "985057036727083", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036639_985057043393749_3945160790566893943_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfBPFtMlY88Q7kNvwF6IyRg&_nc_oc=AdqmtMAxONRalmKQE2Z4c6GmBzsInv1xqdf2ePhEiGWtRe3bAyT98Lc4a-leTWFmyJc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3fw8Qtym-x579KcbW34NZHll1oFUr2K9arA2yFeHNP_w&oe=69F1F40F"}, "display_name": "Peak Rhythm", "keywords": ["Peak", "Rhythm", "Climbing", "Beat"], "long_description": "**Peak Rhythm** is a VR rhythm-climbing game where music drives momentum. Every grab and twist powers your robotic platform upward through a neon-soaked city.\n\nSync your moves to a high-octane electronic soundtrack to master the flow and dominate global leaderboards. Blending physical precision with Cyberpunk aesthetics and Y2K energy, your rhythm is your engine.\n\n**Don\u2019t just climb\u2014perform.**\n\n{3227020670835876}\n\n### \ud83d\udd79\ufe0f GAME FEATURES\n\n- **Rhythm-Powered Climbing:** Master \u201cRegular\u201d grabs, \u201cMulti-Twists\u201d (volume knob motion), and \u201cDouble\u201d holds on a 5x5 grid. Perfect hits boost your speed; misses slow you down.\n- **Solo Mastery:** Ascend 8 original tracks across 3 difficulties to perfect your runs. Compete for the highest altitude on map-specific leaderboards.\n- **The Soundtrack:** Launching with music from indie artists **FEISTLING, Killin\u2019 Void, Ion Diary,** and **funiel**, spanning Drum & Bass, Dubstep, and House.\n- **Custom Content:** Includes a fully functional **Beatmap Editor** at launch. Create your own maps with your own music.\n\n{1918357589050667}\n\n### \ud83d\ude80 EARLY ACCESS ROADMAP\n\nThe climb is just beginning. We are committed to delivering frequent updates based on your feedback. Planned features include:\n\n- **Social Multiplayer:** Climb side-by-side with friends in real-time.\n- **Ranked Mode:** Competitive knockout tournaments.\n- **Voice Chat:** In-game communication.\n- **Character Customization:** Personalize your avatar\u2019s look.\n- **Cross-Platform Play:** Expanding to other VR headsets.\n\nJoin our community to help shape the future of Peak Rhythm!\n\n\n**[Discord Link: https://discord.gg/RZuzxpRcyV]**", "short_description": "Ascend to the beat in Peak Rhythm! In this VR rhythm-climbing game, every grab and twist drives your robotic platform upward through a neon-soaked city. Sync your moves to a high-octane electronic soundtrack to master the flow and dominate global leaderboards. Blending physical precision with Cyberpunk aesthetics, your rhythm is your engine. Don\u2019t just climb\u2014perform."}]}, "developer_name": "Zeitlos Interactive", "developer_privacy_policy_url": "https://docs.google.com/document/d/1m9m8oIvVGi1Jxm-RDJnRC5fAazVq8xWyeuEFiFQgQVc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Impact Inked", "support_website_url": null, "website_url": "https://zeitlos-interactive.com/projects/peak-rhythm", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor"
er": null, "video_trailer_thumbnail": null, "display_name": "FlameMonke", "keywords": [], "long_description": "FlameMonkeVR is a multiplayer VR game created by JustZeroVR. The game uses the movement of the popular game, Gorilla Tag. The game has different player customization options such as different usernames, colors (still being added) and cosmetics. There is a room computer so players can join lobbies with their friends or by themselves. There is one game mode so far which, is horror. Read more information about the game modes in the Game Modes page. There will be more maps and game modes added soon.", "short_description": "The game where you may be... a FlameMonke."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/flamemonkevr/information/privacy-policy?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "JustZeroVR", "support_website_url": null, "website_url": "https://sites.google.com/view/flamemonkevr/flamemonkevr?authuser=1", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6475748205861256"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974643_414114851505036_5598061844245177280_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEnad1-rD7wQ7kNvwHJOcPQ&_nc_oc=AdptXmm1-GHvfkOrT0gYu2WU97FDk_dWDGH_3NQFGCIpIlK_d
t=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtuu0XCOnfloTFHRxYQx3kylKb3hLoAgcX3FMY0CwnpQ&oe=6AF5DD2A"}, {"file_name": "3333333.png", "id": "2297145147782317", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298248_2297145151115650_7258842256857187859_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmDNZ8CPyUEQ7kNvwETgaKo&_nc_oc=AdpsfAnSHFMyiqVRd_1FaqiYHE8wb2hmMtS6PF6S_UXyygdryN47Zim41hrvyPJwy-U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQN8RiJ0RQCO9vLO5Qc0CNHSvys1K-jilxaHDsJOAWcXw&oe=6AF5EE9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Prism Taggers", "keywords": ["Tag", "Taggers", "Monkey", "Gorilla"], "long_description": "Prism Taggers drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, monkeys, gorillas, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Prism Taggers is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "JKS", "developer_privacy_policy_url": "https://docs.google.com/document/d/1hYEf1vBkkPNtDsqfL_OXBRrrTjioz2SfTjFN0eFddes/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "JKS", "support_website_url": null, "website_url": "https://sites.goo
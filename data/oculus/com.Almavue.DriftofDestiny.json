"}]}, "id": "1206188670769274", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1241547620690772", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303196_1241547624024105_6059115589865538928_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OoC3GNfQfsQ7kNvwEzaOBd&_nc_oc=Adp_YsmDuFje8c0urub69-ka99Cn9MKBAstsSpWxa4Fmok3T9BNNwzWzKNj_Cp4Bevw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCu4UjZoP8pJtfi4WeeEkxEYsrS8_lKQ13A1ZpNTxe9SQ&oe=6A50E37D"}, {"file_name": "4.png", "id": "2165905963880556", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499344589_2165905967213889_5757196788905416155_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUg0-hclENoQ7kNvwFdB1Kg&_nc_oc=AdrXQrIt0TJqyYl6vWR_ICoAKa0Il70RENymzFlHskRY78pFM0FvAFuqSl_53WpqTEM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClzEmLWmWZQony7thOG6g_AK7Wkci74GhiJKjNCYva3A&oe=6A50ED1A"}, {"file_name": "9.png", "id": "2510794299256952", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499344529_2510794302590285_1458478074327363918_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fN97p7t2x4sQ7kNvwF7utPh&_nc_oc=Adp_Gd6dx8m9URqW8QB_ulkMudey5VIJgdEr3uFszdPBGjJnxL_uu8iiG3u6-bvvaaI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2-YRSSZex8DtcIaWG3cawDmiNvAwL3dVVvncy7VbWZw&oe=6A50EFCE"}, {"file_name": "5.png", "id": "3374131656061820", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824532_3374131659395153_4696539659511824366_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qB35T1BDY_4Q7kNvwHdAGuO&_nc_oc=Ado-nv8_Ofuk3PqlIsZ83XRXsPRUEwJ_vEKFJ-sHsaKNfPddz4q511dWcmNawJK9DfU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6RdZfUS1dfUYmnhkSqo5ZN-pNYhxYYm-2xT0VptTLfA&oe=6A50E96D"}, {"file_name": "7.png", "id": "1757367198517770", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499311966_1757367201851103_4691672627301073724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOZJuGef4GQQ7kNvwFxnq2r&_nc_oc=AdpYoj0D1du_HE1NVD0BFIl-3C4sLHQPRKsmc0K2qMSyZceFUTSGNSJh8lqOX8gjkKg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLxJZdLlrMEJJ9gbzQFxsvkn9dAaBdT2JtwOPN66AZcQ&oe=6A51075A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drift of Destiny", "keywords": ["FastCars", "RealisticRacing", "RacingGameVR", "DrivingSimulator", "CarRacing"], "long_description": "\ud83c\udfc1 Race Toward Your Dream\nWelcome to a VR racing experience where speed meets soul.\nThis isn\u2019t just about winning \u2014 it\u2019s about becoming who you were meant to be.\n\n\ud83c\udf0d Explore Breathtaking Worlds\nDrive across stunning landscapes \u2014 from icy valleys and countryside roads to thunderstorm-ridden mountain paths.\nEach track tells part of your story, crafted with immersive visuals and atmospheric sound.\n\n\ud83c\udfae Fully Immersive Controls\nBuilt for Meta Quest using intuitive VR steering\n\nSeated or standing play supported\n\nRealistic vehicle physics for an authentic feel\n\n\ud83e\udded A Journey That Drives You\nYou play as a girl who dares to dream differently \u2014 pushing past doubts, expectations, and fear.\nWith every race, she proves that dreams are not distractions \u2014 they are destinations.\n\n\u2728 Features\n\ud83c\udfce\ufe0f Immersive first-person driving experience\n\n\ud83c\udf26\ufe0f Dynamic environments across multiple levels\n\n\ud83c\udf99\ufe0f Poetic voiceovers and emotional cutscenes\n\n\ud83c\udfaf Smooth difficulty curve with rewarding progression\n\n\ud83d\udcf8 Optimized for comfort, clarity, and replayability\n\n\ud83d\udcac Your Dream. Your Drive.\n\u201cThey said I was lost in a dream. I showed them the road I made of it.\u201d\n\n\ud83d\udce7 Questions or Feedback?\nReach out to us at zunaira.nazir30@gmail.com\n", "short_description": "Blaze through stunning VR worlds in a story-driven racing adventure where every track brings you closer to your dream. Feel the speed. Live the journey."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/e36205e6-639d-45d0-b5ee-d2df85163723", "developer_terms_of_service_url": null, "publisher_name": "Zunaira Nazir", "support_website_url": null, "website_url": "https://zunaira0042.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29776346151980246"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303324_1125794449376023_1267006553315731111_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kgh_whtVZfoQ7kNvwEf6ZtC&_nc_oc=AdrvgVOizaE2UpyAwsOqIsPF8qRJPQMjUuGz8pB_TiUvbC9X-MAGQW5KsXJCiHvOvCw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOp5-UakkPVQK1USuP5EptH7Fqpfqa_ONGeuK6B48udQ&oe=6A5101E9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Drift of Destiny", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1748890800, "lastRevision": {"nodes": [{"id": "29776346205313574", "release_type": "SCHEDULED", "a
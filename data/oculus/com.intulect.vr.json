s://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303476_2630050647337413_6393422574423242231_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEVp4vD26uEQ7kNvwGsAOXM&_nc_oc=AdqBYew52Ob1sxtErSneNA_HYuMXAH82W1OAuzLn9LOeWnI5UyFjZfvicX5GbOk1AZ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0RKTvw6zKDrze2QXHxpt8Q6o-Im8003NUZBgdNt4ePEA&oe=69F75082"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEdd5csadhYQ7kNvwGXlrTS&_nc_oc=Adq5ipnyBTevF1HLJplGkPt0fXDMp3ONCq8MNhbLg01thgmbskcdxhe5fCKDIByPjsY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3KmLSPohl8kwM7IY4SMSdECATw7fVzdzrddGjQDJs-xQ&oe=69F74C7C"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlBlGoYCN1AQ7kNvwG0tc5y&_nc_oc=AdqViTlXxHPRa9hHyQuoetbQldB6uKk5VGvCmeIqxijJJrw7EXBEiNQtNqOScFSgJEM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af18r-psaUsTDiNHg3GabYdjIDxnRUzCM_rYlGyWaXIUaw&oe=69F74D41"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qi4MiSWjt88Q7kNvwFU8Glh&_nc_oc=Adr_zKuOkIZTd-lzY4vpWsTm3VNIaaT4stly3cgWoMHZdicFuRWimS5A3I1zgPNV2zk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3SUCrNuJozlXrtNQHTK5CzOjlgKnAhQgljnNLokjW7FQ&oe=69F740A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ufe_NVi2W4Q7kNvwHgViBl&_nc_oc=AdqOwh9yxMLK0c3TF6YPZB0Sae22CW-q6X0pKzx12xOIkSn9v7HDxOXhPvPlP3ciXFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3QQFup2h4RxZkltLuFRPq08f6JHQu4x29lDsJ22VSvCg&oe=69F7559A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publ
NvwE6urw_&_nc_oc=AdqZX3qOy-eyDPAE5iup-gfJXaWsvpKntRYzGrRjbt7IBnggXusrH35uTjTlD9-hJik&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENt5-QPHQVdy3MXSgRC0wUHuxQARmuMec1vSsdtspedg&oe=6A8D9B82"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbVp0bPOWhkQ7kNvwFFYTKG&_nc_oc=AdrLV9AYwfSG20-F7LFCIBbjZYkQFpSMJHSbjRBamnUjA4T62vJ-Ga5dTqBKA65tkD8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdAQbZrtH-DdEmE_hDqJVYEguZLZG6khzh65ZXYY6hGg&oe=6A8D977C"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zFr3zDtipsQ7kNvwG0w6y2&_nc_oc=Adou8gg6ZGqPgzPj3goa5-5q9E3FT2V9IgHmaZRcPl9mr5gpvZ1GLD7Gv-fB9Haglys&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFu_qZgSJiUSC5PAYNE622meQ-JBYqK-7ghRFDOUwoLlA&oe=6A8D9841"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edlNM3co96oQ7kNvwERpqml&_nc_oc=AdruweFkDnIDEb-OVXTk9PlKTyhX8qaPcq_NrbP8to3UeTb-W0IFr4UjIlleu7tM-_4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHhxiIg61ZOfQwdMtCgsFSu-G5vIF8dBVRzqHzFj8RkA&oe=6A8D8BA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbngDCDWqSgQ7kNvwEjuuH4&_nc_oc=AdpnM2GSJY3tgt0K5-eaz7k3-oqdjYP7HjdskxvbI26aKLscoAbD1OSrdc_FB4fH3vs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGS4foSgJPXp5o5nsv5XUWJEp-cDef5wQ5__t9vONtwRQ&oe=6A8D685A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Intulect", "support_website_url": null, "website_url": "https://intulect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST",
vb6AiHnfBiW08u5vItxh5oIC7kSULEBG73kVUY7z4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsZkrOoGG8sZe9REMNScliqbJw1Y1adIjZysOMPlBesQA&oe=69A83682"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDGLVu-MtWsQ7kNvwEIzFTu&_nc_oc=Adl7NjM1hygE_xPqW6tRtlTD6FK-gVcqfuhOzC3aIxhmjErokZVHRK-Fd6-Cwq_YoLc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfujGUR9I2E0kzSV6R3Fibdv2VD6_u7JNB8GYJbq0rhJNw&oe=69A8327C"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhJX00R64kkQ7kNvwEgOFOJ&_nc_oc=Adl9QyMQbNRKrPy949IHvQ5gNmLlS-M-WF23p18h_anp5RVjPgLQKlEwqmdYZO7hwQU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftawlTEzTO3pJkJCgq77et5-lkqoFQl9MSmBN56HEy24Q&oe=69A83341"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pfSexpTuPMQ7kNvwG1IJS8&_nc_oc=AdmJaUq5Uj6-yIE9g73E4m5lHl8zhnDJYoWVZ565gtcpwXS4VWcEkHQlgdZ3yhrr8p4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu9SiKER4BuufZ-m3LrgKOXoYGc4NfsPfxDizEnT9k8vg&oe=69A826A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pltLUjUh7lkQ7kNvwF0RjA5&_nc_oc=Adm0fZZZP98NJAwT9BlLNe4GFvLvHsCl1ZyGn6VUG2re_1b8TsAUAaOouu0xzis5lxQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvESBRWQ4ARm5RYUI2qVLR9syfyCgrK-2NDRq3O3hdPVw&oe=69A83B9A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Intulect", "support_website_url": null, "website_url": "https://intulect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "
EvecqRljY7YrJxIYrPTcSdTesGmxMKlBgMUFZ4s7M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwM1C1BVfarvsHPrhtDyC3iOITpfB09xMGx_ERrxqhlew&oe=69B01F82"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBYqwLJeCk4Q7kNvwHlTR7k&_nc_oc=Adl-Dyipv5IXxXYDqhGoia_4lnpAvt3J1gd43dyJwRinkFFhnEaR0eCLmrdioG9vtNo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzChOceswbPPesbmiRldtYnh0fR1-EZpqYfHkfqhrA19A&oe=69B01B7C"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G56svxxm9B8Q7kNvwFMditO&_nc_oc=AdlP6wxeN57K4C-CGX63dmfR-zSlNoPsH22Zo604iB-PMEDxw5LAmQk75u3Qhv_fkR0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgoSNSt-bh3O6LFWGN7c7ZQqPG9rfke2sePmqUIfU96w&oe=69B01C41"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaeuluLxptEQ7kNvwFQ8Vzq&_nc_oc=AdmnC_a0qfZYE9-CIyJXLleEGP_lLFFwU21NKJ06TEWhN8QIgNjP760mxw18EEoF3WI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzlCcX4iw3_ZyeAk_LH2CVH5-6RfKjl99PDJRuxNlKkDA&oe=69B00FA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MofdQnzeSnsQ7kNvwFJqkRq&_nc_oc=AdnHdEHBioxY8eRSY9sn_baXexOTAN8EQV_vLT1DXCtooeAub7RIWrI9tZEYw8bb6EU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyntAx7TZf9tQUgXDjtE32wumso6QZScX2-0TLyOWfnTQ&oe=69B0249A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Intulect", "support_website_url": null, "website_url": "https://intulect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "
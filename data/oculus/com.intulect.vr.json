": "2393630997676153", "locale": "en_US", "screenshots": [{"file_name": "5.png", "id": "571822119304108", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819396_571822122637441_40044050544292125_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gR54zAFAYzAQ7kNvwG148-E&_nc_oc=AdqODNSrdd0PwT7iHrm4CQcfJUopONw24AegRo3Wa_7zaoou4kYLvujLHVRd8TVQinA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRdqKDUYl_dfSxeRD2PNb1jDzdOmuZooyucPP9Efxt04A&oe=6B0C6037"}, {"file_name": "2.png", "id": "2630050644004080", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303476_2630050647337413_6393422574423242231_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6_Wv9a7ECMQ7kNvwEe2zOx&_nc_oc=AdqLGz6hUF89iDlceHJ06AN7h8SeIaLf5mi614qtQE3c8M1CgguM8wn0URh4fyYH6gI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQXNpEW9UWOzm9mSNndSZTmunnoBgdwueGSvXMZkb8NNg&oe=6B0C63C2"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tw4RV88O_qsQ7kNvwHD-3ki&_nc_oc=AdrvL0oj7DUzuL8A2YaIv85Eqizg5rBDin24erZ7072JcImnbNw3TjUF1nVAf_zkfSA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRyO5BGThmsoI9btI12XpQRcPozzghFVTP98IRp00zL8g&oe=6B0C5FBC"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gubzbe044eYQ7kNvwFnGbh3&_nc_oc=AdqQOwGW7k-yj1ZoKuY_z17axDDC0OWoEhyysQElQh6ynmGkd6FGiTKmw9OybIPg8ec&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS5NiaXuhAvpFT5dlvB1Wv9ublNjvtK-MkIJG3-DJn8Eg&oe=6B0C6081"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXBkDZi1oa8Q7kNvwF8SV9T&_nc_oc=Adq6FaYgrcRstm6W2OSO3buQgxHvmFMLMau8ixJXoQfSwJPs1GkrpJGGAjOlAN4CD9E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSCVs-_tEgDzWYYRo__84o9v_NJrQTV3spaM3D4RA_6hw&oe=6B0C53E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPFPKk26sm0Q7kNvwF0qeUt&_nc_oc=AdoiWqYrexnY5r4fQ8p_Nj8ZTZIeyknes8tPLZCUxpkyYBu60WfKYDlbF43PdcKE9eo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRIKTInlwrkXp9SIqk85ZGaZ8CXdMZHTmBa11Lxx1xXXA&oe=6B0C68DA"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Intulect", "support_website_url": null, "website_url": "https://intulect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10058054407596799"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1255739739548970"}, {"status": "PENDING", "id": "1321140609085734"}]}, "baseline_offer": {"id": "1255739739548970"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750249980, "status": "PUBLISHED", "id": "1255739739548970"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29283145334661
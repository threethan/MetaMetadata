3.oculuscdn.com&oh=00_Afs_qQRi13C2ZVe5TCs1cTOVMn0W-7tbdNAmQhiI5cnVIg&oe=699C5902"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eluHVcGMRBQQ7kNvwFPUAyw&_nc_oc=Adl6kyB3sRBW2lMquioQrEFAFB4FcwI5ulQ6fDvFNSAxFemGzK6ctaBtZNShKyFk6gk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvrZ7yTF8Bq5JjpHVUR0XtmCLdzSwRyRyo3yPz4YcRclg&oe=699C54FC"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBJbgycpXngQ7kNvwG7UF0P&_nc_oc=Adl5hs7Lgr12O0_gm0V6wOGJyJLDloowrUz5-mKS_rjnAidHlVGMOQXLlnBlTw3jnww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftqqsCfBFiaez07Efmmp2MJ1QbLo7C1sj9VXyRAxzv-0w&oe=699C55C1"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=McUop0rvjhkQ7kNvwH42zA1&_nc_oc=AdnFzb6TlhjujvonH3Mwg5K6yaLVKYSDJmlyCT9Re1A2PFUdQmOnKSgmbNCuQzfeLas&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu23EAxf7dEO645qiJttJBDs45yw2G9Q0ejSDygqACkJg&oe=699C4926"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-T6DmtwfFzsQ7kNvwFoiIqb&_nc_oc=AdnpQKDzMbiWGWcQxbWu7li8iLuuCml1WV7cZWc57j0e9M0bANkd2IdJH4SOrijgXTA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs6DBpWZg0YEfp2tb1DodYJwhBt9iH13KiCfcOWbfUTBA&oe=699C5E1A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Intulect", "support_website_url": null, "website_url": "https://intulect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "10431075
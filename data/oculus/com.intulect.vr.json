BAz_qP63kgE_warDkmPpUhPZoQTNdja1B36mpnt6M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxWRRgddry4Ym28qOPoubiIZoKmXagQzZcOCtVBdfjEaw&oe=69BBFD02"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcrNv-5VzoIQ7kNvwFo0HXo&_nc_oc=AdlzMqubmGNiq2Xx9KtVbILaXfXWWoEt80erIvjv_vz4pcfUSqndJ3puvP1rY-72g_4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw503Etmy43Cc7Z6qx2sojp2PiJUwwMnmbNS95SPmyI0A&oe=69BBF8FC"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2t4cuHZF9woQ7kNvwFSxSR4&_nc_oc=Admt1lm7b3II3FWJ6_g7V9qU5iKO5ExOZIsD1UCj7b_VryTGws03rewI7SYyyrWLNp4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwFn8LSDFwv0NRcGiVqPWynxl5MBD1cM8miKq7ZO5zsag&oe=69BBF9C1"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynp-cH1s-JoQ7kNvwHP5czk&_nc_oc=Admt3qahoP5fa92wX3Dv2sCQNGEOps6bYxG4K-wO4VhoX_zPO6mgNOPXWSLHG8Arg3M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzRVgl7MliUM-hHH9zZMKNIrqvXrlrEXQO71PixDHv_3g&oe=69BBED26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YO7E-mcCEV0Q7kNvwFpHB66&_nc_oc=AdnJbp3TWFen_iD4yAJFFnMSa9TyqI0577kGB-aVj8mVV_bh7DB0B4GdwoxQUcEKZI0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfziDRi2NoKkWZFQH04kiykJ8-c8Mpsy6n8K70IoET3FNw&oe=69BC021A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Intulect", "support_website_url": null, "website_url": "https://intulect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "
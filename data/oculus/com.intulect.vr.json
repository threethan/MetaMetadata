om&oh=00_AfujFIAPvV54LjAWgEe07qiquL5vdEwtuvnghay3byK6MQ&oe=6999B602"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nw5-Aw46zdsQ7kNvwHWEMhY&_nc_oc=Admb9lNGS5hcvCyJHLain7UnBVJTIK7QF11tyh70STZv9yQwYdfK-KmHz92_Gg1hS4Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsiXC7gFpIjdYLF7Wxh3-k1Sxn_7AN0Jlem2jcMhZOLow&oe=6999B1FC"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bltHMDB9aa8Q7kNvwFgqKpQ&_nc_oc=AdlGe32WbU6B2GVT2tICT8h877-grPEaNcgqjnqk5IxzEsKCdjivgwjCed_kYqKoypA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftME6TLrWbwh6Sb3kYMR_tujdkmm_xU8V-fJF3Re5WQeQ&oe=6999B2C1"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFwLChQAQgIQ7kNvwGv55y-&_nc_oc=AdnWCScPyVrll9twjhC_ZnvCvehGWy-HO0nNO8kDXrh2h9BdO7Y6cVdofpGRjWPT6tc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftxEDgCwUPcdAS1DzaNFisqW0051zllJw8a3T4e5IehxA&oe=6999A626"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAsocqTQKOYQ7kNvwHsCuIH&_nc_oc=AdkI6HLGdACrvqTHsQRyokF7aJebDKfSRvf-r1GGD5B6pq9Z3SWVfyycoxAQdI4Ravk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsOtA-oBE7MPTB6NG_hX482LkZmLPF6sc_JVRg-eXKsNg&oe=6999BB1A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Intulect", "support_website_url": null, "website_url": "https://intulect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], 
om&oh=00_AfsJOmeDlEprjpd2EL-xDu3jUstYuKQSHPrJ4ZBtwZvE7A&oe=699DAA82"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eluHVcGMRBQQ7kNvwF8_1gj&_nc_oc=Adlo_KY-7AgqSG-834-bPQczyZK4115s-AIJZlDlyOgVTK_7y_rlasEHZ1M0UEdF1mY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuRK_HRxgWIks8hP7jZQYOWsBmafxZjMyw_H8Dy_eXPZQ&oe=699DA67C"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBJbgycpXngQ7kNvwElhckb&_nc_oc=AdkUBG15dftPIvw724JAzxLZLCkz5MtVA8Qh02-XHMT1CYmLMfL1J91VGt66QKy55CM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvMdBiyzZhxGQFkGD1qhL5UHCGpvuR7rXk-iA_A0u30CQ&oe=699DA741"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=McUop0rvjhkQ7kNvwG9pQI1&_nc_oc=AdnuJa5eFNpU4HMx8q3-7prowu-GHy9xwgjCJYnPQanV_G3w1ASH3FJLZStPpzIDT8w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvUGNFNSsR0W_ThBbhMmIsRtZQEj6GrQ1xLe499COf8rA&oe=699D9AA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-T6DmtwfFzsQ7kNvwHcBUW_&_nc_oc=AdlHMN_PKXXuEhtEqDG6_g8UCERyXS7ZOWY_ZgGm8VP8keHwPwgv6JOxMCpPoJPoKdQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvrdmFWWeDSdpVtc2mWeLFCCbMdPEX2oSX7epgLpoAkYw&oe=699DAF9A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Intulect", "support_website_url": null, "website_url": "https://intulect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], 
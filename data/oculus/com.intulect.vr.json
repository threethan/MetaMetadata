": "2393630997676153", "locale": "en_US", "screenshots": [{"file_name": "5.png", "id": "571822119304108", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819396_571822122637441_40044050544292125_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drxf9lZrjPMQ7kNvwHx7Dt2&_nc_oc=AdrpYGsTNEE6OyWjzR54d8FyTKPNXtTwdKo_MgzTT06fUEouIwLzdgLq545SJCR8-Fo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN7aVF-Hd_kzHlWdN7CuwX8P1P0SyqYzKLO_xr4qwdHg&oe=6AFF3137"}, {"file_name": "2.png", "id": "2630050644004080", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499303476_2630050647337413_6393422574423242231_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMu-UGisLTUQ7kNvwG-81YX&_nc_oc=AdoBiFKqqGVWdZayWi1OSxILJQrRCTkZ1yjDAURFr9o8zzg3eFK1Sdo4Y0x3kyTTPcU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjse-NpWGZmMnHoPid1LXcPmJJIMiJk3Ot3nFmKUNQvQ&oe=6AFF34C2"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMoIPVgP_MoQ7kNvwGl9WRa&_nc_oc=Ado3aKU06ZtTprpKxKCKe-x43dgwo9DK2NShRhMdjkCbGafrySS4oOyudliz-xspq74&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6fZRlwX1W0MlqLC7jvkB_Zn_0p4w2yubgY0n-g5Ek6A&oe=6AFF30BC"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuQHWm92jEYQ7kNvwGwdRMQ&_nc_oc=Adqti5VDh4uag7ZNzC12bjnAEn_h2WgzXVg-hq1oACXCoqWhTVGlzvN736ftHbqzmu4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlEzrryXe2UHobKeVRtl7KaIi9ZfrHRhKtElW8-k0sDA&oe=6AFF3181"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dw9zqHekw9wQ7kNvwHiF7oC&_nc_oc=Adr4m1UjlogLZd3tbTdsJLOW0j1QItsQfluIu59P0rGwjH6RcYHBjuu4niExF6rPZpE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6TrtMAsx0xI7ZFiY3sv0HnHpIhM65U6ColbD6zcox0A&oe=6AFF24E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfQW3lmGekcQ7kNvwGCnR1F&_nc_oc=AdqS1wysOJaRTj0nLmL4mBpWklA9Rvn5_9sfgMAg9K-FoTcLMl45y6-Wn7uVQ24sP7Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJYnaMb9x5Qn2wcDFrwWQZFVA9BlOfG8M745Hf8IL9jg&oe=6AFF019A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Intulect", "support_website_url": null, "website_url": "https://intulect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10058054407596799"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1255739739548970"}, {"status": "PENDING", "id": "1321140609085734"}]}, "baseline_offer": {"id": "1255739739548970"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750249980, "status": "PUBLISHED", "id": "1255739739548970"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28958962613746
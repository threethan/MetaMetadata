J2v_6E_DX0kq_IbAUVPfapIo0nJB1FRfUEnSurHyo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWe_yPBcd5mz0CiPo8pLBJdbpuIT8FPn51HDKd9cOPDA&oe=69AECE02"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBYqwLJeCk4Q7kNvwG5sh-0&_nc_oc=AdmjFTpIPoXYRDAoVb2S9pta8ZeRhTnjhoOr7VtczUCUVqlcokzVNHzuCYJz59QIDeI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQt_kGwR5hf9GcjwLT_YzxiS44_-Owm0teE04CKudvWg&oe=69AEC9FC"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrXxoROLfzUQ7kNvwHY7y5g&_nc_oc=AdkR1FWtBZoF3comBkSzLnt9CroxMmqRN1j9qisqY-6X5fwd07ZLmS9xdao0CQfuJOY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDbU2KTN8k1-7L1AQ_4ZP-2kSGkwpsMuWSPMdJ59juRw&oe=69AECAC1"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lin37n8TVpcQ7kNvwFZ30yC&_nc_oc=AdlyNxjcCkn7Ck2TuW8-IKRPfKpzzNa_uFflKZaDsENdUaS5Sx6sXZ4VfukoWIZNX8Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5jkcdCdo334dbkN5ukV69jf7aD2naZWooD5zXBQ-pvw&oe=69AEBE26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyoPG1uOmjwQ7kNvwG2MMW1&_nc_oc=AdmrNBRr3GLOGA1tct1lFYGE4uFBy3iLFQVIkT-4iavf3FFCEYYZKPt_0jBwZNnr7a4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwp9vW0SsiQenWDmictt2N36t7ORfQ20NP9qCKev0ahmw&oe=69AED31A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Intulect", "support_website_url": null, "website_url": "https://intulect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "
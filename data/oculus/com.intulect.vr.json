IQKT&_nc_oc=AdoHCT05V_UIseWuyVcwPH4_c-HRzn_MRCibJUH24msu9kknGDFSx3AJ7-XWjDArhGA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8Mm8CCPfeun5xiyUjBIoeCb1xPFZ2nvp1Ri8Vr25SWg&oe=6AAE9102"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrYT9Ui40VwQ7kNvwEpoQZI&_nc_oc=AdpISWq2tjAVi9H9LE6pUtCkeCJuCiO5fvdv5FB1FRHND_BQn9A-W56qbQ7iLO2c0ng&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpkSdToEkvRSsj26uNMfApSB0G5xjqcFimh5hti8r7wA&oe=6AAE8CFC"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MQcG-BxEw0Q7kNvwEbA9ie&_nc_oc=Adpmorcy4riftDZ9BFGjrNclkDmovOM5D-W8CCxgDMJZ3uUP36GlIWgKyPi6ulY8_-c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6AxpAKHg80aU3u-yyKrCZ4a4zNPJcGE0LDZrP8Cho5g&oe=6AAE8DC1"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlBHTI7XehUQ7kNvwE2YiTk&_nc_oc=AdqBzlNhJIw56EBTQ159Q_UNM4SCRMWa0TKgc3K-EnJsyo6yWn1pGMTIOq2i8v-hh0M&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIS9bH-lY1LbeODtx_PxC55L3QdDNzWS5lGCl9OP3WzQg&oe=6AAE8126"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07Z0TCl7G5YQ7kNvwE6HpYy&_nc_oc=AdqAQv6KuSs_fluPXD3cBHHSXEXIY_LZPexCTsfcznWxSj8gEGozdBrh26YsOJkwRTg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ_bbj5uP1lf0yfNWT-GBLK4OfqJt5QSQLm7xUrFQ3zw&oe=6AAE961A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Intulect", "support_website_url": null, "website_url": "https://intulect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfor
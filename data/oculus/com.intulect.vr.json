1.oculuscdn.com&oh=00_AftyAxXsi4bq-byCfoO8GVp1bOg7d5WZHBDqrtO5KY14cA&oe=69A59382"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xl3Ah3JbfoQQ7kNvwEfwjw7&_nc_oc=AdkAMAdjAUBRTaVI7uwbLOfzxgjkPxd4aeLu17avIuRER6veDr3jDVpV5U_peQGBE84&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afvwst4QzFx66qe95gg4ixzvxGC3wA0IfbKctI7trY0_5Q&oe=69A58F7C"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1im3WQF5wV8Q7kNvwGsHlA1&_nc_oc=AdlBajgOZSpf-cm1GIAoz8AQbR5gcAEZn_N-uv9Yrux4EqR4aE5UKf8UzYb_QcZfA3M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afvw3QPdrpZz52XWH3GsaoZQJrWUmX6B4xZdfCvvQreQNg&oe=69A59041"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3CryYSiRJYQ7kNvwE-iuCl&_nc_oc=AdmiEkFqrBGF1vN83tVzI7YnU_6cZLyPuS92rIdVTrm8URtSgp7DM439mSalPuf9Ly8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftapGHnCHgdTFMyzZz6G_EDTXhIHEOnAEivQbGTVpQUYQ&oe=69A583A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ls3LuNeRKf4Q7kNvwHRpGA6&_nc_oc=Adlo4duH1UonlB3EFGIotzi_qUHRB6yo4fdtRXhsi7E6kVp7KZ1uGB6C4oKJrndPTaU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftfCv-d2CHxv8zU6E1N4OmYydApx3MoaEiZIfUoXIFnhA&oe=69A5989A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Intulect", "support_website_url": null, "website_url": "https://intulect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "10431075
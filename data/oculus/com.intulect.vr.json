NvwF6TFI1&_nc_oc=AdqvFxL4_Q-h9Cndxpzsf6FWnXANZACVOMQLCsTMqEZx3jtPYVqgj6jUfGXCFSr61lM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiVjb50pm-p7iZAGNGZP2x8tzFFd8X12xnBHDQ5m8qHQ&oe=6A8EED02"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbVp0bPOWhkQ7kNvwFh-VQ7&_nc_oc=Adoze4Jf-mvwYiSZMwU-T0sZnJY_hb0V6wyWzDDlVszjkQK40TEKb7FgsSOtML3GnA4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLYASaM2MqEYEwHg9y3Z9giXzZztfZTq6qvcMp4iUHyQ&oe=6A8EE8FC"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zFr3zDtipsQ7kNvwHtN77n&_nc_oc=AdrNwEkmef4UIu81QGAOu9I8reNyJl-TJw3Q3XfwxW7qAYxxsuEHqFZu__ypk6a7rT8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhB6BaPGfODZnFyt6A3LVZDewBGZ2eAxJ7wmRK2hzWOA&oe=6A8EE9C1"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edlNM3co96oQ7kNvwGcSvc1&_nc_oc=Adqx-gH8EGNXGsrrseixtC7UjIJELK3V0HDRYzlXzYNCACOpVCYYs8ymS7JgpO_bL88&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUWV7RRqKMv-Ct_5-jeozDd_OGGSs9ZPeAJ0-JZNWCVw&oe=6A8EDD26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbngDCDWqSgQ7kNvwH1Wopb&_nc_oc=AdoqM_UH20zqK4hxltEsIOfjQG5_h3dlxAoPXV90gD2bNvs48-g7rrrr5e3CT37ShKg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZHnjhzm4M1J7MGz81SNeILz1rxuInUnCgEAgAgc7vcQ&oe=6A8EF21A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Intulect", "support_website_url": null, "website_url": "https://intulect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST",
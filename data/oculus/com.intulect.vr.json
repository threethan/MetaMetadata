GZZM2kS1r1OgavgPaleDolWbUenBWX-Tf9VmN8gwM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyi6bSPMXkK7LXtQyqhg242qv3P8h2teG3C_kX0xO8kNw&oe=69AD7C82"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EB1pi56CvbMQ7kNvwEiCK7T&_nc_oc=AdlOV5Lj3JaTX7KyQIWhsjlhrFz9ohmCnUVg_3ugdIr84KJ0cBhLuEucr0Ju5D3EjRQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLiaGH_7I-NF3amY8DN8Zedeioe0jjM2-2DnMyeA7p3A&oe=69AD787C"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrXxoROLfzUQ7kNvwFlfrA3&_nc_oc=Adninydz04HvQqv8HnmgAZ4-4ducG1YcMPH8ipsf2yEkq03Qp9GqpAZey6WduUfS3k8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfygT0JMzJUaPtcVEFCSlgvUvhoym9kMzdH8p0JXBg3o6Q&oe=69AD7941"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lin37n8TVpcQ7kNvwFGTKCA&_nc_oc=AdlWMYdPg078vKmU5v5H8AkjqoiEiHqT-pvoWievoWoZP6h_xoxvUAW6627xTTTG1yo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwd3ZmLmKLpASx-FE8TS7vaxq8rQBL7oJZVR6XcRaTYJQ&oe=69AD6CA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyoPG1uOmjwQ7kNvwHF-fEz&_nc_oc=AdkND8vWGTRXVEys5StsLMQKDqL0EqETtodM4ovY5j5NKIQoD8pjW-TEPPdJjuMW94o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwzK6OIfJh5NyiGtfMvk5lr0KM11G4XNZCwOH75L1P80w&oe=69AD819A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Intulect", "support_website_url": null, "website_url": "https://intulect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "
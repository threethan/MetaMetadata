gSKies0gg6rM3qUkGsXMxC6FXJa10_SEy0kdAfJDI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzXevXHnm0DZFy_Y__Mo4P23FCAlvKe4GOb5-Q9np1kWA&oe=69AC2B02"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EB1pi56CvbMQ7kNvwGHEjEK&_nc_oc=AdkfxRMajLqrP41fVxtR5XgHmLoH6qk1nddFyD6uwHNB3cccl4lQdavw0Wl_rjSry6o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxcf79ce9OvPnTInerp67amEfXhtyLcXD-4erq22Ox2xQ&oe=69AC26FC"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrXxoROLfzUQ7kNvwF7BqAu&_nc_oc=Adm8jsCbr5bbSdBuG9PsPN3XMDjbt9gU4OlVHjGgbLGoJpdwfKQkoqqHZOJfW8Epidk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwv7on6_qMpvNvkgsbez9V8j9oYsYH16RHqGWsBYFSR7g&oe=69AC27C1"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lin37n8TVpcQ7kNvwGbys00&_nc_oc=AdnBVBgXkxUVBMdsFadNfoFbakChz3UXNT5nlR-Ykh7vjEjEh3fIf0oeSetDZaT3zVM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzsSlbwk5L5Tc8IFW_JqU74WzJe_kFoNfb2ATY6LTF5CA&oe=69AC1B26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyoPG1uOmjwQ7kNvwGsPtiv&_nc_oc=Adm_L6EBjPZh1CqjvkS6yaPOskd3pLyXGDDgIhH70F4HP0bGi13tjP6kp36zkL9v4g0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxiemfF3LdPdRISCK7kO0JyKO4VtqaM55HlPEnPUK7Aig&oe=69AC301A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Intulect", "support_website_url": null, "website_url": "https://intulect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "
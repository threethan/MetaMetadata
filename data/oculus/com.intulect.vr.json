s://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303476_2630050647337413_6393422574423242231_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyUaOPgJPXwQ7kNvwEnNkac&_nc_oc=AdqpT5FwhuaOXI3Bmvc03r3B4QDvDf8830bNjNMpDbx-YpxyI10iFB-R4GTrbhEwXEs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9M09DkRFZ6qxdTSSq0vlVft7kgl5QvY3QrQ-euOcHz1g&oe=6A47BC02"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fU17nvQhAtMQ7kNvwGuRe37&_nc_oc=AdrYRiTgDzLLBB5_cEz0CG50acsmASmW6hS99wi9JhjxZ-ebHxLnlDAzBfRJHTaIofc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89Auw3scoVii324WYrjw-S3FEcmiQ8o7fXkqO3cZE3JQ&oe=6A47B7FC"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4XH6lNqloUQ7kNvwH_E5UA&_nc_oc=Adqnn00H5QilacAdH7-KRh2NIUyT3Sea7NlR7ZM4Xsr4IpqppRTA4fVKVGB-2YeEkQ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2GufJPQ4CRwRG_9xF_bJBgRw7W59nuy95Z5XxUfunrQ&oe=6A47B8C1"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NALVAhvAPDYQ7kNvwE_11sQ&_nc_oc=AdpWLI-G33pr7zBEXK5CePFlkjDji6mlBzu5wLQJP5bXzxsR8_i1RLdwsE5vr8uMJzA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xRSkH8fyVzEhovjhn26ck0E_3RGUr9pASfb2Hc-M-rg&oe=6A47AC26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jBt08EHlNUQ7kNvwHUaAkQ&_nc_oc=Adrzl1v35O_eXvv1JDm9p6PXvBcv3Me7rutL2B-5_MjtvHBCk-3REqYyAttRW4-iu-0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_K-ORporWzD5Trn3k0wyQ1VBvpfUNB1cUhBW6yqXR2fw&oe=6A47C11A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publ
RP_o&_nc_oc=AdqCGNm4O9tB0Qp1M3kGWvvvzUlniwzG7omUK8TsFpSCjU5k_4RqnzP6ua3r3Xe6Cf0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UBAi6cWyYuC-4y7As-SmYz_W8fPpP32Dw_AK2dQwdrQ&oe=6A393B82"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLTsanHB0fwQ7kNvwFu-Bm0&_nc_oc=AdpNC_WQ1hlKteIqVw7VYN78fhjKUaS3yJwT2LAiIyF3i3aWR_NatyDhUc9vg0p-kO8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GB7Y9gX7lZTHZSYSPMR2icqfrYX15m3aHGXb36gn1Mg&oe=6A39377C"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8wJ-DCfHL4Q7kNvwEE-S0t&_nc_oc=Adr5Z6Dq87XtK-EqevAomKov7OSxrlIgxTXGC65rc2Ub9FGVdxdKU25uTCDjVzVZIMQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9q4kv-MEXX8aZLquWanG8MvGB4_YuijGH_msQe1nw2Ww&oe=6A393841"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBfefAo1mycQ7kNvwHQ5Mql&_nc_oc=Adqg2UlemWwuJUIZ2WoG0IpYYO9oYA8yMcSZnF-KOK30FnY6Njclkd1P1OvuR3554x8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ggYvx6KD88qMyzX1V_ShHPDolq6kY12a2qGXvTw7JXQ&oe=6A392BA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUu7QuxzidIQ7kNvwF5eA5R&_nc_oc=Adp7d8mKdhvYj2Gk_3z7ir-UepIy3p7OH7RnZdNTf6T4IgJAFDy4_cnrEIH5WmA9ppI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bOoRxOFaCvkP3JSaqEK9KkjBUhS11aVRA7JHiQATjVw&oe=6A39409A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Intulect", "support_website_url": null, "website_url": "https://intulect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfor
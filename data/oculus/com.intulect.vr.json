NvwEqpJKS&_nc_oc=AdpoVsrgivI-GH3j_Y3SgSQS6_jKukrlJsof23VKKuvUkXLM6rD25dDPleZtTZAbYW4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJdpJVxRiuVJUCAwBItuRS40NFRqmZ-K6jCHbgfENZWg&oe=6A85B282"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STL_00-pdGMQ7kNvwGz5-_Q&_nc_oc=AdrZ_u_gZkP5N-zN4or4Y3M_tr2I5SPg01tf-AFQik2vOKM9UbzSCAqhtox5cW82rco&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJPpIBfrQPDX9LzRrGQA0BpVtvx8v65Iczi35VVAwpJA&oe=6A85AE7C"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WIaDLiatdcQ7kNvwHMWnxI&_nc_oc=AdojgnLR50-_0tkOrmBUMnod15lFQ5qOvpG6TzzX40NWZXOZ2sjguJzIneopQz127rQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHO0BdpEONwwoFDlPSlLnio0PV2HJA8xvKKTYUrxe6LPQ&oe=6A85AF41"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtAp6NfqxCkQ7kNvwFamEsT&_nc_oc=AdpjDvHwHcdQS6xSwmtjNnOzI-wG2DpFcQM3WIvsOgi4ABErj0kaBsQck-eda3ofZzY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSWk31jQ181SlasP3qVzPxZw1q3qnyoTV8xusNOmE0yw&oe=6A85A2A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efh32-BOvOUQ7kNvwFiuMYG&_nc_oc=AdprGYc7En0O6XPhDIL2iBR9xEfhTpucyg6FPcaFMm7bSivCq0pB8cgsAOPjTb09jxY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHva9r4mmPsyruq3MXnhUGuGuKGevLjpu7fHOpCPuEOPA&oe=6A857F5A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Intulect", "support_website_url": null, "website_url": "https://intulect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST",
3.oculuscdn.com&oh=00_AfsnI9AaUpULj260E1wGdnaivT_SNrFns-O1OpbszFK66Q&oe=699B0782"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eluHVcGMRBQQ7kNvwFvRXN-&_nc_oc=Adm6PaYKVJD0pe1Iu6LWjNT6KJkkU5bnVm1vBhFrcKy2cb0MWoL5CxcLW7G1F-tTrZ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvSd9YrCJlgAdytrkFjKaThcyYyTeH1Gwvh0y4jK9iphQ&oe=699B037C"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bltHMDB9aa8Q7kNvwF7mH3_&_nc_oc=AdmTHSm3ow7rC3b_xzYEicsKgEsEjCG9gezz8_SQfRG5Bg6aQ99jXAnHCVu27DmadXU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftoNZ_2_zWDWbMvmtsWHLBGUDtlvyO4PWIOBKs-th2BYA&oe=699B0441"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFwLChQAQgIQ7kNvwF6YQw-&_nc_oc=Adm1L3lgNJJAcKwZfnkl647XoI2ATzlVQ-UFfhADIQ0aOS7FAbL9sQHAYnhFOn6ayy8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftxYynIGeO-U6Qb6-nzulCB-RO_8gyFi7b5knHINcP0fg&oe=699AF7A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAsocqTQKOYQ7kNvwEQ13bK&_nc_oc=AdkuXIpgXNQYGcP_XpT3WBqMKgfIDdeR_1ZrvtK-iUfzV8UwMF_727qL3T5sqbo0q6w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvl8S31fvLxBdEEn0cAY3t0kwXtfPZz0mARcMo9Pmvbgw&oe=699B0C9A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Intulect", "support_website_url": null, "website_url": "https://intulect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "10431075
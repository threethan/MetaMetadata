s://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303476_2630050647337413_6393422574423242231_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNUO_k7bANYQ7kNvwHoyqe6&_nc_oc=AdotRzq1qpENir5mfrdo-vbZ48scucJKvnDh5xREfHJ9-41eejLauJMLTuWtKN03pxc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFhZFQ-t1Id-DOav_eSWm1a8AcyY50kxsLPcPh61OIdQ&oe=6A788382"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rq4H7JJLBwQ7kNvwFKPTyg&_nc_oc=Adp1PVLUmn6fqwcVT6Epi34yXe7LV3MKpBOrATX5oKcw7Rsv0lMgoHjOZdOxl6QpSGk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0nECNb7-ovC2zWapJNkSY5jHeSP_YVsGRErJsnatxHQ&oe=6A787F7C"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ONbAGiZvyMQ7kNvwEmk1ut&_nc_oc=AdqNGAV9owJAIhMJi8B-WaNw3VZdarBEI3Z7lKuw3kisU37kIn1WbvtYYIeqThs7nQo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSjknBSOtfKZGqRo92a3_jTuFsrXxLogzh7yjxLcSJTA&oe=6A788041"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNCsNODuD-AQ7kNvwHnjY5V&_nc_oc=AdpJQL6KuxWm4ot7-TpKgLphQpYbjwBSREY25Et65u--QM1pR_bxnh7N0rZpY9vL1Kc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBfIyC2XCQHTHUJDAyOysxQcj6SqREGzENckOz437bhg&oe=6A7873A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XnP4HALbXfkQ7kNvwHe_DMe&_nc_oc=AdrGS2zcDxc5TuW_MM54Rhk83eQTbhNbmxCFhofd5P28acyWUwW7Qtj8tye-vZuX6tw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVtBeDkFGRPfQWih5vhZctLgpOlzRjphJ7v-Ypau0mkQ&oe=6A78889A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publ
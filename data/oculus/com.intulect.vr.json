s://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303476_2630050647337413_6393422574423242231_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_rXOPJmRpEQ7kNvwEBH83J&_nc_oc=AdqSf1tJSOjGZj3UoN5SDiOszXr5Bre3R_Nqeao19aLmJjnaplRLqQvl8JL8_Fnv388&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bKojrf8COGNgdR6nv8D7NKn3kn0MTFMYVAo3FVP6ZSg&oe=69EE1602"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSDQ311N9FgQ7kNvwEptEr7&_nc_oc=AdpAUgvV8spRrMnq6UcxXQkt2S6TdNxdidKfspONL_fMSZnHeZUyN0OHoi1oPh-0azs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31554gwejZ9hBa2FnqWhMjMjHIVf7n3GB74zlXh_mMww&oe=69EE11FC"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmsQqfhg698Q7kNvwHBOPFq&_nc_oc=AdpCoh9kGYCRcWrQQQOXO5FoLZGR7WO1yzUCGu_YphsCUlNFD-SyUdy_AmCbBnh_2yI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TYRyX2AQ5K3x453skTmkZfxiTcLn0Y1LrICA1g3C2aQ&oe=69EE12C1"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81ExKBbgGBoQ7kNvwGE-YVv&_nc_oc=AdoknFz7vUA5fM9k10GVf7fz5r5kkUMiD65w-vMTQLBxg4GvGhLazVlU98R2MtOBDdE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XIvo29P0bL72d3kzahzrGOi95PvILL4WhI3woGWpbDA&oe=69EE0626"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9mV24R_LfYQ7kNvwHShZd_&_nc_oc=AdrYzm0PsG4dfTDk61bov3UPXPD-GxcUVUHEGoULhvg-Fnhe76OCodK5s5zPpTnorCs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SH8qiB9m7uiJUV9yjiALm_hq9OpAOevIHs9C57N3FNA&oe=69EE1B1A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publ
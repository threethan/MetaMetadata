T9s2WSKzHyyEd_F-Xul9o6eLUZcVMD5icDrP7yKW8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxSKe9eDcmgAOCkn7GYgQn0GWzamibsXGrGNff1Dnxo7Q&oe=69BD4E82"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcrNv-5VzoIQ7kNvwE2MG3b&_nc_oc=AdkYM-YOmrN46-L8nddlgg1iWEyUDIoWZx_CtHDX1rONCMI2BDMuK1hrd_6WueCuDMw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxvK6g8S_Y-z-MwirMBtxLU5CGN0HwFPhm1ig_beYgagQ&oe=69BD4A7C"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2t4cuHZF9woQ7kNvwEgR6Ol&_nc_oc=Adka1qoqmWW5AWNpSnLvur486Ha8Dp2aOCk0xgP-9CSrsDLTwpWSWvaydoEMmfkZruc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyL_D8lKmFT25shC5ON5TjCDVZ3yNqWSoXRwl9h1DkpIw&oe=69BD4B41"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynp-cH1s-JoQ7kNvwFT8cmP&_nc_oc=AdlZeWx0AUqaKOzQgjffz7mJ-hrm5TJ4MeMELnPzEQ3pOk-R1C1ht-nmA2pav-NLlLY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwX22K-lvAXgx13owpgfDbyGt-VCRlixNZUFZd5vbgmsA&oe=69BD3EA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YO7E-mcCEV0Q7kNvwEbWvPn&_nc_oc=AdnJyGjpjEl0XaknuBGKIDcfK2j-mXepW9T7VhqKliwIEHbNEgqbCJH7JLLblYDnT6k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMFypC35g2iA4TuGe4arHhn8BlqDdBrr-LRVIxT1JRTQ&oe=69BD539A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Intulect", "support_website_url": null, "website_url": "https://intulect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "
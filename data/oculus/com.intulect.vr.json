": "2393630997676153", "locale": "en_US", "screenshots": [{"file_name": "5.png", "id": "571822119304108", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819396_571822122637441_40044050544292125_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOjCwQ5WSZ4Q7kNvwG1hjww&_nc_oc=Ado-venSit1i8e_mDKm0YzuJhaEZKv68t3vLSOZ1VTDbd5nodOFhj013C1RfOgVVqPU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlJ3J_xviL-XbztkxRvdc12txnIW9F03_40oo3Dob-DA&oe=6B071A37"}, {"file_name": "2.png", "id": "2630050644004080", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303476_2630050647337413_6393422574423242231_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbKaRVU7aT8Q7kNvwEikhe0&_nc_oc=AdqR5RukeFkgSYcTbLf9GHdav2Z615qyPgfH0nA9k6YLPcgyT6dRNS9mWXE4No9EubU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBtf8zG3ZNNzA_BnRsdX-758KPtBXZQUHGqiK2TINu6Q&oe=6B071DC2"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scth8HSv_xEQ7kNvwGAqjV4&_nc_oc=AdqfveArqMmJGeU1mOx6U1ZL5PoG6uMXCAab9hxD7rdSgBlOtTk5aLn9L9JLhLIvUhA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgRCTIqXP4OocEmXFyDCm-VeFAuohaNATh1Yt0NCvT9g&oe=6B0719BC"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpaJKX6fMVwQ7kNvwF5M2uM&_nc_oc=Adqs6MqiZfq6LaCNZPkgOvQNsPvgncK-fKCX4EprkVqcC_f_rSLHP3gC3st5r8mZwO0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNNi4befcEmIy-wVeBmjRqFi1NiUNuvjc82oLio63h4w&oe=6B071A81"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1CnERSTM3AQ7kNvwEqhPpa&_nc_oc=AdqnFRqo_r58hAK0OxGZpBVqlKwltstKcTzAQmYxEV-5LRGFLndWiExRoFPdj7A1KvU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8RjPeqxmy2LR86TIkGnr741j1_Qu15G7VVLxTzJDdNQ&oe=6B070DE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zlWCI5FD-YQ7kNvwGmoIMf&_nc_oc=AdqVWYkvc2lEKUjYR57NnRUpsZWnoQydAJw4wzsLVKvjOCSg2hBIDuASDVwl0dL_D9U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZhLs6thZ-YDboBCyr0p21WRy1bf_c0OEBDtvfJ9EHtw&oe=6B0722DA"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Intulect", "support_website_url": null, "website_url": "https://intulect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10058054407596799"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1255739739548970"}, {"status": "PENDING", "id": "1321140609085734"}]}, "baseline_offer": {"id": "1255739739548970"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750249980, "status": "PUBLISHED", "id": "1255739739548970"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28958962613746
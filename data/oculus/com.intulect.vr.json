242180677502059_8955428851085587533_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDgMyjlcaeMQ7kNvwHZsZb-&_nc_oc=Ado_EhN475tFYSeHD3jEbaZmEn1VLXbPAx5BRoH-vG43utUWlv2lUWOPW0Gw_dv_6vs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiJtRsy5csuKroCXwqAW0EPelEQN3-ab3Uj5kF21-New&oe=6B08745A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Intulect", "support_website_url": null, "website_url": "https://intulect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23957926203849718"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823485_2491018981281183_5202675151807927028_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8wOnCh1Wk0Q7kNvwGC2fRg&_nc_oc=Adoo--_ES-vsQlkLY7v1xpe2WXQy3p8m_hUhIKPp1RbKVaZwiBb2_SPbL0FhmdQtT6I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCzd2d_xZ-cL5mJs3eBk0jBwpN2G92LqZ5EOdseIEPXQ&oe=6B086C89"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Intulect", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medical", "id": "478089301798119"}, {"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1750249980, "lastRevision": {"nodes": [{"id": "9236649609737287", "release_type": "SCHEDULED", "administration_sta
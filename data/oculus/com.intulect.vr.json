s://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303476_2630050647337413_6393422574423242231_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKYtMSkR9zEQ7kNvwFMuzuN&_nc_oc=AdopLyk888UItear6OK62AjHg7gwFSUZYI2KpeSIJiZpWVqXcjFJOFWCa2skBsF7Eog&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcf6YTVDqO8XNu93DkFnnaYWzHIS-xizMaXwckYgM7yA&oe=6ABFB482"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-pm89tGQG0Q7kNvwFzIZ9s&_nc_oc=Adp8lFkWWTMH6L-MPgB_nKhD18ODljVThR9slDgTj4NThIRO5fIGiheCmob5d8HwtII&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxm28q17vhEsaB64SvZMfmHxpsXPp1V8WAunlhRUyHJw&oe=6ABFB07C"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxBhu9QzR1cQ7kNvwGR6k5g&_nc_oc=AdrmwHep8FCrbeLnDDaX2_sWQbOJy6kMP_4fljYncHUy-XB1t5BcI3nMAIE_o6IYT7Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFCrgdbDA1cb-3MKacgzxNj_mF749UoQbmObQ0ceKu1g&oe=6ABFB141"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cm0proiZ_poQ7kNvwHTKlw7&_nc_oc=Adqi1jmRF-5npIKkdsHJUQyk3sIBqj1i5O8FYbNMehO7YHfGy2SgUeYoN-sSypQ58N4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsBCnMTXp7G7U5mhyzIkHkAJV8knm-DVxJ4mFqnsTZ7w&oe=6ABFDCE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXYbnWRADNcQ7kNvwEFyvdV&_nc_oc=AdoGr26YMW3oKZPJWKFtF5IZ17Oy0ox_3eKuWXQJfAmTlVZo6rkhqXrxJLi1HVLdrSA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFrpLCMMcD7JvkT60AukJFuOExwQB69ZzAoJwlQ0vFkQ&oe=6ABFB99A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publ
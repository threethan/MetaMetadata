zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af33FqZVlX2uTUrterGveXMU5dzXtbt288Zj97b6uBEdTA&oe=69F20A82"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYUNM0I6aHQQ7kNvwE8VU5f&_nc_oc=AdrlsoabYdcjxM32Fc50rdHBhXFyt_gpJlnRJs4kvu3MIRSyWC3_khnosjXOoWsfNoQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1L4Nf3wnuVCMRLRxaPJ9S0aWYimIcrUpnsImNvNSAtHw&oe=69F2067C"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoAHRPmX3-4Q7kNvwE-MBL1&_nc_oc=AdqpJ4iKxMOTyyGYVwVcBekdXBZLiwS7JjYS9g5EnqYxTc9oyQRFFBapgLMDB5T4DvE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0wi6YEr3anSesQ3UztrGKVrDEvLi3lBFSrorqIydscZQ&oe=69F20741"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebQyrl5VDV4Q7kNvwFz9CVf&_nc_oc=Adq6ZzWUhHKwRJn3B14TvW7i0BOymlx9WeoW4pa2UZFJWkKLwklxa12T3JWeabhwQAo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3n8_jNyU5JrCT0MjCbgK36gMiyHz5nYf1T_7g0qiGWVw&oe=69F1FAA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xcddhdkw_H8Q7kNvwEEZGZW&_nc_oc=Adre2GmhsUo4Gp7ndR2z_0aeKJK3RsboLoBL0fYDheQnQKT9dqqSSiTag5zR7_hnecU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0WiWz8SCJUB1-irCkbzOJ6abLTTGLLSjekF9trK3L95w&oe=69F20F9A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Intulect", "support_website_url": null, "website_url": "https://intulect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "4780893017
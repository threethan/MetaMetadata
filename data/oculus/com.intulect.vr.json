4-L0eFzJn7mlR0ZT3WgMe2fllenE7B5rUbFywi4a4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaT-04zlJOq_ShCQ8zy-DRGAyagE9r-FVWdm1puIS03w&oe=69B17102"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBYqwLJeCk4Q7kNvwGyMSVG&_nc_oc=AdmqLYr_4bWKKkWdKmO_rcbTwLEQmZMFqND78ZQKcpI1z1mkIt-ubCspdx1ogjsOwkA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy8CRHvwzfMfkMfirldrFMlpPF0sgD6kZqJBGoB5hZqiQ&oe=69B16CFC"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G56svxxm9B8Q7kNvwH-kpWi&_nc_oc=AdlBVuKDMHlQrIE7j-RcX-Ndbi0GmMP7zKVcDpYsuEIcVeuY5jGcVpeWEnNyQc9jgIk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVUdCKwuv12qMqWOFhjBHeHNUI0yfQhttSpTQLMXTCkQ&oe=69B16DC1"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaeuluLxptEQ7kNvwE8J8jX&_nc_oc=AdlhjfRiX-R8vX_bAGjkTusqQuE6zIYyAR__G1wcoi1bRICN4d2FJ6n5ff6LxJQGpYw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyoO8rdSx9bUPKcJjLtokUtw7hTv1YwVd_FrQFS-XNqrA&oe=69B16126"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MofdQnzeSnsQ7kNvwHaHVEy&_nc_oc=Adkp8YS7H5vBTGapoQkCVSsC3BKe6kPNIZXCMIf_RAT9560QCyzgrQCxLRPaU0luybQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRLjM8yI5zhQzGA2dT2QRKrA2PfujCRuHjeZTAjv8y4w&oe=69B1761A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Intulect", "support_website_url": null, "website_url": "https://intulect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "
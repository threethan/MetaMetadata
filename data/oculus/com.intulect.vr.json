CDtE&_nc_oc=AdrZxZARZse-jYrz2bFER3h73mpIeBH5YN_vzjUqNTZiDjJQdxTCpRnyB9Av_BFdjfU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8u8DPDv98-0BO1s-ktNFHGafUKwEgjUq7ZdfCeCoUVgA&oe=6A369882"}, {"file_name": "1.png", "id": "667704452803486", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499298254_667704456136819_1022445440440322231_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrteKgn2zeoQ7kNvwEj1nB9&_nc_oc=AdoSsApnP3Xj8SGdmdu4PGICMarNtWBigQAXoU4l9Q6iDAIHltDfZ-Kmvd7Wsh4B870&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iNgiJQQVM4aIwYJXPy-iJTrzHuhGrGWOrLIGYbBliiw&oe=6A36947C"}, {"file_name": "3.png", "id": "2212265415867784", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820648_2212265419201117_5311145768653546432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8wJ-DCfHL4Q7kNvwHz_uSF&_nc_oc=AdpmeK_1aQb8jHVdSUicPJSM1aNNN3-ga1WX4wnUzmAXJKv4r7nc4qdZxUiwcCsoEAE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_X6fberPLvjZ9gzfea6WVgsRhEqpkG1W1ecuaOhtZrAQ&oe=6A369541"}, {"file_name": "4.png", "id": "687428147377431", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499312039_687428150710764_498678448022996487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBfefAo1mycQ7kNvwF1qbhx&_nc_oc=Adob2zHvwIe7ikBsc727WV_d5OvX8fakFQP-ojGnmVpXLPu2xf4ucKPHsByCdqMftkU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jzMJRfqf4NQ9RynH6BHsJMdxyE8LbIG0fvZeOycza2g&oe=6A36C0E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Banner- Intulect  (1).png", "id": "1242180674168726", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499307413_1242180677502059_8955428851085587533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUu7QuxzidIQ7kNvwEa1Y-X&_nc_oc=AdrXW_TCB7TF7CSZhxUmu-c6BsGuYkrxaZKmoFirtmInFEiiO1Li1qzFleat0yqu8S4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Iaqv-m-X9e8psVXK5ZP3x6tEXisDrkd6J9swewfP5Kg&oe=6A369D9A"}, "display_name": "Intulect", "keywords": ["Nursing", "Education", "Simulation", "Healthcare", "Medical"], "long_description": "Intulect\u2019s AI-powered VR Nursing Simulations provide scalable, immersive, and competency-based training for nursing students and hospital systems. Our platform leverages AI to moderate and assess clinical simulations, eliminating the need for live facilitators while ensuring realistic, high-quality training experiences.\n\nKey Features:\n- AI-Moderated Simulations \u2013 Nursing students engage with AI-driven patients and scenarios, allowing for self-guided, competency-based learning without requiring an instructor to be present.\n-Real-Time Performance Tracking \u2013 Automated grading and analytics provide educators with detailed insights into student decision-making and competency development.\n-Scalable Clinical Practice \u2013 Institutions can expand simulation access without increasing costs, making hands-on training more accessible to students.\n-High-Fidelity Patient Interactions \u2013 AI-driven patients respond dynamically, improving critical thinking, prioritization, and communication skills.\n-Seamless Integration \u2013 Designed to fit into nursing curricula, our simulations enhance theoretical learning, lab practice, and clinical training.\nWith Intulect, nursing programs and hospital systems can provide flexible, cost-effective, and data-driven training solutions, better preparing nurses for real-world challenges.", "short_description": "Where Training Becomes Instinct. Intulect is an AI-Facilitated Nursing Simulation Platform to improve clinical preparedness for all level of learners in healthcare. "}]}, "developer_name": "Intulect", "developer_privacy_policy_url": "https://intulect.com/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Intulect", "support_website_url": null, "website_url": "https://intulect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfor
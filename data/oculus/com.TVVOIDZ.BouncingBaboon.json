yZY8bPCSrX0daCT7Gu6UfEn-DLbTMKzfk4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSuJtp1vaK9AqzwXwk264ucgnsc7cHodhtMHPBCw-anA&oe=6AAD5D24"}, {"file_name": "SampleScene_4K_17.05.2025_15-06-15.png", "id": "1733164250603383", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499361329_1733164253936716_5116391949939568888_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eArojgu6MzkQ7kNvwHSWFp5&_nc_oc=AdoFBfxB6kkSapyZo9Ax8kd8bQCuBJ1GGOIsyObjfalj8X1MttyQk_NXH56Wr4J-b4o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF8WP08Q5kM5WvfI9ZwNKZeHm_AB_KRHQHc-iVgz7vuA&oe=6AAD459B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled571_20250630144933.png", "id": "719729697423252", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820594_719729700756585_5813998063970535049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gx3NuqMVlzgQ7kNvwFlSs2w&_nc_oc=AdpdB-ISg79pYbNcDm9ALv9i-PLLdRuQcxR4kHzCDQ2mpv4wPdko_lRjOJEwOKRZWzQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItrGRqS6xhdQZuBzVfbdYvP4JPSrYw8cXG74vSv63XlQ&oe=6AAD5511"}, "display_name": "Bouncing Baboon", "keywords": [], "long_description": "Bouncing Baboon is a explorable game where you can bounce and swing your way through the game, there are a variety of maps you can play through, such as:\n\nForest - Jump around on trampolines or climb up trees for a ton of fun\n\nCaves - Go down the slippery slide into the echoing cave where you will be tasked with mining resources (in a future update)\n\nShop - take a break from the chaos and put on some wear for your baboon\n\nBeach - Jump from platforms sitting on the water to jumping in the water and chill with friends\n\nShore - Ride in the giant ocean in this map with the brand new boats\n\nPool - Swim with friends in this smaller map or get a tan from the upstairs portion\n\nwhether you're a parkour master or a laid-back player, Bouncing Baboon is the game for everyone", "short_
2fbDmQWXtl4qccqVf7yTlBxQERvuE7jWE0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsL5vC4VCh0EIi1IYn0O-tz3amFH22IH3wnuc_iYlGXA&oe=6AB7E924"}, {"file_name": "SampleScene_4K_17.05.2025_15-06-15.png", "id": "1733164250603383", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499361329_1733164253936716_5116391949939568888_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9Y9PStc79QQ7kNvwGCBQD_&_nc_oc=AdpowiIkfB_tV4SXO2jC4I7fm3MH-xZDEBZQFYTXirvI25CigEBnNdaulD_tv_sUuBA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1mALqyA1V5yeHapAnpc2eca49OGWAh3dVadfzSlClmg&oe=6AB7D19B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled571_20250630144933.png", "id": "719729697423252", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820594_719729700756585_5813998063970535049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m96wSZmMj08Q7kNvwHhu47_&_nc_oc=AdrKmBi6OL_7VHMmddrL7GoitglpRtpvxT6jp8Ks0HQqpnX5Usf9o7NwQY1dCF8Uaus&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1lHnRVW7Zv2uNnEuOcqsonHn8yhYN7Gk3c3Hw3ZpOew&oe=6AB7E111"}, "display_name": "Bouncing Baboon", "keywords": [], "long_description": "Bouncing Baboon is a explorable game where you can bounce and swing your way through the game, there are a variety of maps you can play through, such as:\n\nForest - Jump around on trampolines or climb up trees for a ton of fun\n\nCaves - Go down the slippery slide into the echoing cave where you will be tasked with mining resources (in a future update)\n\nShop - take a break from the chaos and put on some wear for your baboon\n\nBeach - Jump from platforms sitting on the water to jumping in the water and chill with friends\n\nShore - Ride in the giant ocean in this map with the brand new boats\n\nPool - Swim with friends in this smaller map or get a tan from the upstairs portion\n\nwhether you're a parkour master or a laid-back player, Bouncing Baboon is the game for everyone", "short_
w1P_UH92D9q-jhsIrkMR0ko2NZLG2iGl2A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2iyxEARKEGa2Bqx80nivLlIrm6p-0yysm3XLOMxlUzAw&oe=69F76E24"}, {"file_name": "SampleScene_4K_17.05.2025_15-06-15.png", "id": "1733164250603383", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499361329_1733164253936716_5116391949939568888_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVTM7dLC2P8Q7kNvwEqlWYy&_nc_oc=AdqQdeItgIMk2W6c99vdscPcCA4WpMQ7LUkDMp6LSG07zU0D1J9Mzq7A7rCzULmwKQs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0z8cI4MquwE9DprJH8jdyBQIgxyFhYNFQH2t0EWWPakQ&oe=69F7569B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled571_20250630144933.png", "id": "719729697423252", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820594_719729700756585_5813998063970535049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6N02emH0r5wQ7kNvwE5nkMC&_nc_oc=AdoE5rubReHHupKoQgt5RvjfHNH-35FKRlawRcLgHW5Q9m8YfIxeaCTJlttTZST3Dhg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1KEfAYDeTmXkL8vmIlPfkvOEYfnxWKIyjQa5cj89VHkg&oe=69F76611"}, "display_name": "Bouncing Baboon", "keywords": [], "long_description": "Bouncing Baboon is a explorable game where you can bounce and swing your way through the game, there are a variety of maps you can play through, such as:\n\nForest - Jump around on trampolines or climb up trees for a ton of fun\n\nCaves - Go down the slippery slide into the echoing cave where you will be tasked with mining resources (in a future update)\n\nShop - take a break from the chaos and put on some wear for your baboon\n\nBeach - Jump from platforms sitting on the water to jumping in the water and chill with friends\n\nShore - Ride in the giant ocean in this map with the brand new boats\n\nPool - Swim with friends in this smaller map or get a tan from the upstairs portion\n\nwhether you're a parkour master or a laid-back player, Bouncing Baboon is the game for everyone", "short_
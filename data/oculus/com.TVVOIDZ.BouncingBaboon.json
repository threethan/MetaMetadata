xHZ_fG1S6aC2PuJvzh9vcjgSXjvjNHX3eM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqUjqf30CaLpKlktwbleK6EhCetTAxmOhsXNud6so0oQ&oe=6A95DA64"}, {"file_name": "SampleScene_4K_17.05.2025_15-06-15.png", "id": "1733164250603383", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499361329_1733164253936716_5116391949939568888_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSr3VmTrXNwQ7kNvwFk6x6J&_nc_oc=AdqF_EQO-XVf0qGm7xDOuPHuEk3pbgGSDdGUfKU453IQRaR5sXmSdccAmA7L1inE_w8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGm-XQR-mSJjvwxQSn5CXI0mVocW-Y61BiUig95A8xgfA&oe=6A95C2DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled571_20250630144933.png", "id": "719729697423252", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820594_719729700756585_5813998063970535049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cu1hHPWEg48Q7kNvwGaYBQB&_nc_oc=Adq-APyRVQyFRQEgT3vcLMp-4FaIxuKPNh5hu548SKRz1M5xkU3PwOhw7GGUhr65MLw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKTE8iJ-6Ff2Riwgtt_wO_Y87jJQ7G5f0U7WYdhvapyQ&oe=6A95D251"}, "display_name": "Bouncing Baboon", "keywords": [], "long_description": "Bouncing Baboon is a explorable game where you can bounce and swing your way through the game, there are a variety of maps you can play through, such as:\n\nForest - Jump around on trampolines or climb up trees for a ton of fun\n\nCaves - Go down the slippery slide into the echoing cave where you will be tasked with mining resources (in a future update)\n\nShop - take a break from the chaos and put on some wear for your baboon\n\nBeach - Jump from platforms sitting on the water to jumping in the water and chill with friends\n\nShore - Ride in the giant ocean in this map with the brand new boats\n\nPool - Swim with friends in this smaller map or get a tan from the upstairs portion\n\nwhether you're a parkour master or a laid-back player, Bouncing Baboon is the game for everyone", "short_
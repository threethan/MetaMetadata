LffNLJgiqZp8DDd4a2xnJ-GqGF9elMLqRk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2rKFVq-vU10fy2K39Nqj83nF7bdKcOR8WlDG8ovJuzg&oe=6A2C2A24"}, {"file_name": "SampleScene_4K_17.05.2025_15-06-15.png", "id": "1733164250603383", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499361329_1733164253936716_5116391949939568888_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZAIfIkPTXEQ7kNvwF4-2gb&_nc_oc=AdoC5BqYV5NiV6U5sgjDpR6W7sySynqYp5bODe-jAXFMfrH8Xs7jajEEf6oUs30Oj8s&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9M4rzdO4s4jr7kzltubSYEDI5Lhb3R5w3-QfOj-dAusw&oe=6A2C129B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled571_20250630144933.png", "id": "719729697423252", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491820594_719729700756585_5813998063970535049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35LIett9ax4Q7kNvwH-UxUG&_nc_oc=AdqzFDfHSoxCEk6vGuIhwj17Q4gxu0yAAPQ5QOy9SZuMnxkvv8UTOLAA6GrgSbMY6oQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96up6exXgWrVQrk6PVDCIGW_3HEL2jzvrVfiMlobFkeA&oe=6A2C2211"}, "display_name": "Bouncing Baboon", "keywords": [], "long_description": "Bouncing Baboon is a explorable game where you can bounce and swing your way through the game, there are a variety of maps you can play through, such as:\n\nForest - Jump around on trampolines or climb up trees for a ton of fun\n\nCaves - Go down the slippery slide into the echoing cave where you will be tasked with mining resources (in a future update)\n\nShop - take a break from the chaos and put on some wear for your baboon\n\nBeach - Jump from platforms sitting on the water to jumping in the water and chill with friends\n\nShore - Ride in the giant ocean in this map with the brand new boats\n\nPool - Swim with friends in this smaller map or get a tan from the upstairs portion\n\nwhether you're a parkour master or a laid-back player, Bouncing Baboon is the game for everyone", "short_
3H6QWybnSRuvro2n7aL67GvImLi_V0zxrE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQId5gTXGSSoftNDbmXRy7gdZae8iz2CmD90nVABFXYhrA&oe=6ABA8C24"}, {"file_name": "SampleScene_4K_17.05.2025_15-06-15.png", "id": "1733164250603383", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499361329_1733164253936716_5116391949939568888_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9Y9PStc79QQ7kNvwHa_FKp&_nc_oc=AdoRJsa_KZlLQ7lZ77VeMJ9F_Q7f1r09cVaoBbw2bHlxCRk0-8xkDQ-HWt7z5d6kT3g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfhIM9AfKYPNbh_-zC9d5auqBMKwS5YtkmI7e0GtrFQA&oe=6ABA749B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled571_20250630144933.png", "id": "719729697423252", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820594_719729700756585_5813998063970535049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKiMVzL2TuAQ7kNvwG-kmFM&_nc_oc=AdqNwEZfx7LRWvV19Ep3Gsqap3-T4uzCqR5soT6q-AJFTLabTgEO7aaXJXzqhNxnKA4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkTkGllkA5FFu_aRdgwx7V9-f_Y2koAbeP4GXerumRPQ&oe=6ABA8411"}, "display_name": "Bouncing Baboon", "keywords": [], "long_description": "Bouncing Baboon is a explorable game where you can bounce and swing your way through the game, there are a variety of maps you can play through, such as:\n\nForest - Jump around on trampolines or climb up trees for a ton of fun\n\nCaves - Go down the slippery slide into the echoing cave where you will be tasked with mining resources (in a future update)\n\nShop - take a break from the chaos and put on some wear for your baboon\n\nBeach - Jump from platforms sitting on the water to jumping in the water and chill with friends\n\nShore - Ride in the giant ocean in this map with the brand new boats\n\nPool - Swim with friends in this smaller map or get a tan from the upstairs portion\n\nwhether you're a parkour master or a laid-back player, Bouncing Baboon is the game for everyone", "short_
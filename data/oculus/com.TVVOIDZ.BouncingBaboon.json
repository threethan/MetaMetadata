yM7UeqEZRIhvlTjpBInmHNffcPe7zEteM8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSjptYFrjA1XkWcVjwCkzcT8Mt7rB3huyRdXVV9nV0dQ&oe=6AEB53A4"}, {"file_name": "SampleScene_4K_17.05.2025_15-06-15.png", "id": "1733164250603383", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499361329_1733164253936716_5116391949939568888_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyPoVZzKzmUQ7kNvwHJPnVN&_nc_oc=AdqybEbWGuQ3-xhYTPxjOwGLrOQz5GuwGVnZyx_V9ZjqxqaZhtG8JzT7axnxyQ_8-PA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQv9nrQDqVAx8xNPrvs7fpaU7ZJV3uaGfelNyGn0z4Pkw&oe=6AEB3C1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled571_20250630144933.png", "id": "719729697423252", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820594_719729700756585_5813998063970535049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKxwmLO9Y3gQ7kNvwEerQ4V&_nc_oc=AdrbJNjvBAFL3bZuIngGOTvL7Mf7fAUJ-4oaWVRycckr0RQv9eGsnScGKYJ8zUfLEFw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZuXxS-Gl8GkdcSV1TzmOkT8AIF3PM8svTEdc8UucWNA&oe=6AEB4B91"}, "display_name": "Bouncing Baboon", "keywords": [], "long_description": "Bouncing Baboon is a explorable game where you can bounce and swing your way through the game, there are a variety of maps you can play through, such as:\n\nForest - Jump around on trampolines or climb up trees for a ton of fun\n\nCaves - Go down the slippery slide into the echoing cave where you will be tasked with mining resources (in a future update)\n\nShop - take a break from the chaos and put on some wear for your baboon\n\nBeach - Jump from platforms sitting on the water to jumping in the water and chill with friends\n\nShore - Ride in the giant ocean in this map with the brand new boats\n\nPool - Swim with friends in this smaller map or get a tan from the upstairs portion\n\nwhether you're a parkour master or a laid-back player, Bouncing Baboon is the game for everyone", "short_
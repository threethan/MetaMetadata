&oe=6AE74CC1"}, {"file_name": "SampleScene_4K_17.05.2025_14-53-07.png", "id": "3981262085447099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499352406_3981262092113765_3883376745715535268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAugRRxfpBwQ7kNvwEJRh3r&_nc_oc=AdpDX5K5lQotpybKTCnjoZdxKiSLddtbtmDi4XkKK5RUTsqRMq9cqx_d5_R6Js5fmlk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE9_4RJD8WZrQwwSEpe5VmWxGt-jKU1sjzufquwHFRYg&oe=6AE769BE"}, {"file_name": "SampleScene_1440p_17.05.2025_15-08-31.png", "id": "1815662666028443", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400782_1815662669361776_6262723299433321752_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbrAINXmQ6EQ7kNvwHslno0&_nc_oc=AdrzjQ1GZFx9-ioheivgQ0hqg4pYed4rUvIoF-ypUdKHuk5-jbUQl4RfY-gl7OwooHM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjNvpe6Hi-vhNcvNDOHNUqOxZo-0UVtDkC2wyltG5R1g&oe=6AE75F24"}, {"file_name": "SampleScene_4K_17.05.2025_15-06-15.png", "id": "1733164250603383", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499361329_1733164253936716_5116391949939568888_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUeaC6sbSSwQ7kNvwEKTvYN&_nc_oc=Adpn0A2BtpQ_XqWpGEfOXYuw4GekuA9ysD2Qzl0UOlpb0VeB3Sn2oITZaaW16A4mYXM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDQODvrSIdMHOOZq8d2UC-yU0K9rsdfoKNPBVF2_VF5g&oe=6AE7479B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled571_20250630144933.png", "id": "719729697423252", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820594_719729700756585_5813998063970535049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UK6yjFoiTOkQ7kNvwG_lh4k&_nc_oc=AdqaDgW59R-HmSN4JwtlPf0Yjq5hMdYD_-zeyWVudlitpw1l4lScv-CTqzBM-7rZ62A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBvoEAkbH06XF4jimBvnvxasZXpE-QRwmYILP06TV-Hg&oe=6AE75711"}, "display_name": "Bouncing Baboon", "keywords": [], "long_description": "Bouncing Baboon is a explorable game where you can bounce and swing your way through the game, there are a variety of maps you can play through, such as:\n\nForest - Jump around on trampolines or climb up trees for a ton of fun\n\nCaves - Go down the slippery slide into the echoing cave where you will be tasked with mining resources (in a future update)\n\nShop - take a break from the chaos and put on some wear for your baboon\n\nBeach - Jump from platforms sitting on the water to jumping in the water and chill with friends\n\nShore - Ride in the giant ocean in this map with the brand new boats\n\nPool - Swim with friends in this smaller map or get a tan from the upstairs portion\n\nwhether you're a parkour master or a laid-back player, Bouncing Baboon is the game for everyone", "short_description": "Bounce around in this fun VR game, bounce down to the caves or go to shop and pick up some fresh cosmetics"}]}, "developer_name": "CoolBlue", "developer_privacy_policy_url": "https://sites.google.com/view/bouncingbaboons/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TVVOIDZ Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/bouncingbaboons/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "10087116791383798"}, "review_messages": []
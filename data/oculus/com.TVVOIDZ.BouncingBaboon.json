&oe=6A1AF441"}, {"file_name": "SampleScene_4K_17.05.2025_14-53-07.png", "id": "3981262085447099", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499352406_3981262092113765_3883376745715535268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=So5uuydE0_kQ7kNvwGRnDrP&_nc_oc=Adod5ns5LvFzRYtkYSNeMWf7E0F6jNnpJXHDCp4DGH68rx_RyoKPbZgUVcBrHCrdAno&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54In-eGMGN0z8piQmwKBGL9siwoSTmbWcLOTGswQaSeQ&oe=6A1AD8FE"}, {"file_name": "SampleScene_1440p_17.05.2025_15-08-31.png", "id": "1815662666028443", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473400782_1815662669361776_6262723299433321752_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgP89LU6ggoQ7kNvwE174G0&_nc_oc=Adq2Gdrg9xjZb0uEn4pXf3YSnONDrcuqWtYqbQwNFnVzb5Ar_pYbzLJoztaqLW62TaA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sI2OyxZf_GXkzDYtaXp4hJadC6fVP2w7oTr2_GGE7vQ&oe=6A1B06A4"}, {"file_name": "SampleScene_4K_17.05.2025_15-06-15.png", "id": "1733164250603383", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499361329_1733164253936716_5116391949939568888_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8KePjj4mJ4Q7kNvwGlcqj-&_nc_oc=Adryvc9ja3Zk1042MIpLpWfitKpO0A16-BFGDUyXkyWhhGBAv6fpqZpl6i_0Q2N6gks&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4C-rhVJynKdNCmBpZQ4mm4zFEmRapjVK2uHDfTJQ9pNQ&oe=6A1AEF1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled571_20250630144933.png", "id": "719729697423252", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491820594_719729700756585_5813998063970535049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1ZFimqQjZ8Q7kNvwGOCucz&_nc_oc=Ado-oBrI2eKMoPLLA0kWwVNYjYWtcHpMtAh0FXyNVoEJ1R48PjS_43pUhJljgvvt9yg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73zlXdl8kV5BN6z6ZwCzUp6QdonUS9VSQFfY6g27VM0A&oe=6A1AFE91"}, "display_name": "Bouncing Baboon", "keywords": [], "long_description": "Bouncing Baboon is a explorable game where you can bounce and swing your way through the game, there are a variety of maps you can play through, such as:\n\nForest - Jump around on trampolines or climb up trees for a ton of fun\n\nCaves - Go down the slippery slide into the echoing cave where you will be tasked with mining resources (in a future update)\n\nShop - take a break from the chaos and put on some wear for your baboon\n\nBeach - Jump from platforms sitting on the water to jumping in the water and chill with friends\n\nShore - Ride in the giant ocean in this map with the brand new boats\n\nPool - Swim with friends in this smaller map or get a tan from the upstairs portion\n\nwhether you're a parkour master or a laid-back player, Bouncing Baboon is the game for everyone", "short_description": "Bounce around in this fun VR game, bounce down to the caves or go to shop and pick up some fresh cosmetics"}]}, "developer_name": "CoolBlue", "developer_privacy_policy_url": "https://sites.google.com/view/bouncingbaboons/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TVVOIDZ Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/bouncingbaboons/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "10087116791383798"}, "review_messages": []
zMKfAShtJ8Mx3Ex5yGPfPQMd2RVrSx5BjU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuVS4nIi09f9D4R9e1FpjtCj_iYXJQYeo45898LRTevg&oe=6A8ADDE4"}, {"file_name": "SampleScene_4K_17.05.2025_15-06-15.png", "id": "1733164250603383", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499361329_1733164253936716_5116391949939568888_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5hL4ARpbzQQ7kNvwHAEnVS&_nc_oc=AdpRowgwCIV3WO22GQRF5j2lj4JcZKhMeP_DPP_NdYSjxmd9DN7tbfqMiZVbUvtHhfk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4PQZgjKDzXBMDmj9es8Qkw3LRJ_1jCq7zqrcoskyWnA&oe=6A8AC65B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled571_20250630144933.png", "id": "719729697423252", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820594_719729700756585_5813998063970535049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4akTep7q_wQ7kNvwHlwJFk&_nc_oc=AdrwbPHPOzBOfnO6DevMW0_554ZsVNz_wch3TlYYuYPRxKHqq4zuDySH1_3J4HVIQV8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_bq-luZhWwl2IlHw__WyJDIcSI-Sd09g8KfP7xLe06w&oe=6A8AD5D1"}, "display_name": "Bouncing Baboon", "keywords": [], "long_description": "Bouncing Baboon is a explorable game where you can bounce and swing your way through the game, there are a variety of maps you can play through, such as:\n\nForest - Jump around on trampolines or climb up trees for a ton of fun\n\nCaves - Go down the slippery slide into the echoing cave where you will be tasked with mining resources (in a future update)\n\nShop - take a break from the chaos and put on some wear for your baboon\n\nBeach - Jump from platforms sitting on the water to jumping in the water and chill with friends\n\nShore - Ride in the giant ocean in this map with the brand new boats\n\nPool - Swim with friends in this smaller map or get a tan from the upstairs portion\n\nwhether you're a parkour master or a laid-back player, Bouncing Baboon is the game for everyone", "short_
b_Cpev8GQQ7kNvwGqtpoO&_nc_oc=Adqw4AvZ-yxfw9KLc8MuR6DFEYLCMSCS0_DBFW-Y0ws5XmWFc3y-09bHESJ1wqKTT8c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXC6FZV0KPi-i1f67QrMR9Cq4Xh_tVq3X-TaP0e7oWdg&oe=6B05D781"}, {"file_name": "SampleScene_4K_17.05.2025_14-53-07.png", "id": "3981262085447099", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499352406_3981262092113765_3883376745715535268_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqxQTXsewGwQ7kNvwEf7m3f&_nc_oc=AdqojlPsjP6vgqCyJRkHXtKkVGsrqNfy-9IoYDSFV2s7VtEGZM-vpyks7WVNSnqr-6M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTS5E8h9aQtCiCoQKWqTTLM5cZCEm3HTCz1ypxfw_uhFA&oe=6B05BC3E"}, {"file_name": "SampleScene_1440p_17.05.2025_15-08-31.png", "id": "1815662666028443", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473400782_1815662669361776_6262723299433321752_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZaYXKNPt5FIQ7kNvwGRSn5O&_nc_oc=AdoVEiBgcUyGaIxbavy2KAnaNkXlbtXrAtkn8zLVlQtP0tts0a194BvfbjkdIUv0AXk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbOWre-DPZgskYMZQ_R4wIC-WBwyezHm-KjqlKjIBElw&oe=6B05B1A4"}, {"file_name": "SampleScene_4K_17.05.2025_15-06-15.png", "id": "1733164250603383", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499361329_1733164253936716_5116391949939568888_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CU0P75xU2l8Q7kNvwEh87rq&_nc_oc=AdqBwgC6eObN_MPue9Mj0G9Zec5socizAu-7PGfRgXClZrmbAZWFC8oLRasz3xCHVAg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrYWGhkcMfYAZlhl_EcINchhRVrn7xPQAafScwg_rxBA&oe=6B05D25B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled571_20250630144933.png", "id": "719729697423252", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820594_719729700756585_5813998063970535049_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZlCL7j6PoIQ7kNvwGlRdAZ&_nc_oc=AdqaSwCV2m9iU6zjBsAOgiWMTPT4q8ooBad8l0vpdkd1gxx0PJMx8XUwO-z6z5q5oJo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLBrt-Ba0aGQwGiBtXn7YX42WYcfBjxq1BHrooIQKafg&oe=6B05A991"}, "display_name": "Bouncing Baboon", "keywords": [], "long_description": "Bouncing Baboon is a explorable game where you can bounce and swing your way through the game, there are a variety of maps you can play through, such as:\n\nForest - Jump around on trampolines or climb up trees for a ton of fun\n\nCaves - Go down the slippery slide into the echoing cave where you will be tasked with mining resources (in a future update)\n\nShop - take a break from the chaos and put on some wear for your baboon\n\nBeach - Jump from platforms sitting on the water to jumping in the water and chill with friends\n\nShore - Ride in the giant ocean in this map with the brand new boats\n\nPool - Swim with friends in this smaller map or get a tan from the upstairs portion\n\nwhether you're a parkour master or a laid-back player, Bouncing Baboon is the game for everyone", "short_description": "Bounce around in this fun VR game, bounce down to the caves or go to shop and pick up some fresh cosmetics"}]}, "developer_name": "CoolBlue", "developer_privacy_policy_url": "https://sites.google.com/view/bouncingbaboons/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TVVOIDZ Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/bouncingbaboons/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "re
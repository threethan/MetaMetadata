Nh-tV6hya38M_9joykgX56IHkV0cr0JmQs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rA8HbR-UdBDzRaMu6vtEpJgB-c_Gkec6o98iYnMPzBQ&oe=6A146F24"}, {"file_name": "SampleScene_4K_17.05.2025_15-06-15.png", "id": "1733164250603383", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499361329_1733164253936716_5116391949939568888_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urWb0BO6iQEQ7kNvwFwi1Tj&_nc_oc=AdoQOpDJZkmcH5iCOwQ8yv6N3X8vglFZitZ0mUnfTQH5JB2le5U-1WhuJum5p41CKIY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Cu_Fl982wg7bmUUZTnwpJaUW4obNcRu-hdeBtoy1AJg&oe=6A14579B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled571_20250630144933.png", "id": "719729697423252", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820594_719729700756585_5813998063970535049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYiFrhnmX4kQ7kNvwE1PUes&_nc_oc=AdpkP647hJioqi4S2SPvaQzscZUoSC_s5xUmctFwPyOLDwGYC_6r5aho37MknBGYLwg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6syeR9be_G8YbXKru6Vgs5gdzPkKZ8X9LdsPh7O4mjhA&oe=6A146711"}, "display_name": "Bouncing Baboon", "keywords": [], "long_description": "Bouncing Baboon is a explorable game where you can bounce and swing your way through the game, there are a variety of maps you can play through, such as:\n\nForest - Jump around on trampolines or climb up trees for a ton of fun\n\nCaves - Go down the slippery slide into the echoing cave where you will be tasked with mining resources (in a future update)\n\nShop - take a break from the chaos and put on some wear for your baboon\n\nBeach - Jump from platforms sitting on the water to jumping in the water and chill with friends\n\nShore - Ride in the giant ocean in this map with the brand new boats\n\nPool - Swim with friends in this smaller map or get a tan from the upstairs portion\n\nwhether you're a parkour master or a laid-back player, Bouncing Baboon is the game for everyone", "short_
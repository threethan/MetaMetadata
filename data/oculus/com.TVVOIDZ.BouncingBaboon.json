GU8BunQMH6tXHkdeK8lfVSlB2-1OAckPV8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6las-cBeaOtTzdMVg5X_gnv6qcof9_30qslfJCf8Eb2w&oe=6A1C5824"}, {"file_name": "SampleScene_4K_17.05.2025_15-06-15.png", "id": "1733164250603383", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499361329_1733164253936716_5116391949939568888_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8KePjj4mJ4Q7kNvwHMS7Hu&_nc_oc=Adp_PF0I29u9te-ZFTQIo445GFEFsP3pICoKNGYhIDMmLMxG02vSQ89qxNts1jmzXCw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IOCzg6MdVmESapkQGEVqgR1sr7BA1EfaCYzUILiAf3g&oe=6A1C409B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled571_20250630144933.png", "id": "719729697423252", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491820594_719729700756585_5813998063970535049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUEWnpoHQPAQ7kNvwHWALyE&_nc_oc=Adpi5EuXbJDcV4B6it7Ej3FgRVkOPx_IKbW4NrVafK2JKFjH2EXqGo6ulf4zr0hA6Oc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7v2re_xoXSPlKlXMjwzeJuONRHIDn_gB9RvS-fXtaMbA&oe=6A1C5011"}, "display_name": "Bouncing Baboon", "keywords": [], "long_description": "Bouncing Baboon is a explorable game where you can bounce and swing your way through the game, there are a variety of maps you can play through, such as:\n\nForest - Jump around on trampolines or climb up trees for a ton of fun\n\nCaves - Go down the slippery slide into the echoing cave where you will be tasked with mining resources (in a future update)\n\nShop - take a break from the chaos and put on some wear for your baboon\n\nBeach - Jump from platforms sitting on the water to jumping in the water and chill with friends\n\nShore - Ride in the giant ocean in this map with the brand new boats\n\nPool - Swim with friends in this smaller map or get a tan from the upstairs portion\n\nwhether you're a parkour master or a laid-back player, Bouncing Baboon is the game for everyone", "short_
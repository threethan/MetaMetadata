&oe=6AAD4AC1"}, {"file_name": "SampleScene_4K_17.05.2025_14-53-07.png", "id": "3981262085447099", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499352406_3981262092113765_3883376745715535268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAdRDYgTRMMQ7kNvwFhDVoc&_nc_oc=Adrq_seiojiS2eeQF2tgIENk22Ss8qRCEWqJkFhazv8E3HwYP_fjUALivhRSawS9c5I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjALAXywBabwwXO6oGXFJTF_RHiRyR1lMzjYFSwC49zQ&oe=6AAD2F7E"}, {"file_name": "SampleScene_1440p_17.05.2025_15-08-31.png", "id": "1815662666028443", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473400782_1815662669361776_6262723299433321752_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6uY-rlemYUQ7kNvwH6LSgD&_nc_oc=AdpGMAPs8Fc7BNBab0jjqh2HkRK7BMxhbyZY8bPCSrX0daCT7Gu6UfEn-DLbTMKzfk4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSuJtp1vaK9AqzwXwk264ucgnsc7cHodhtMHPBCw-anA&oe=6AAD5D24"}, {"file_name": "SampleScene_4K_17.05.2025_15-06-15.png", "id": "1733164250603383", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499361329_1733164253936716_5116391949939568888_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eArojgu6MzkQ7kNvwHSWFp5&_nc_oc=AdoFBfxB6kkSapyZo9Ax8kd8bQCuBJ1GGOIsyObjfalj8X1MttyQk_NXH56Wr4J-b4o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF8WP08Q5kM5WvfI9ZwNKZeHm_AB_KRHQHc-iVgz7vuA&oe=6AAD459B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled571_20250630144933.png", "id": "719729697423252", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820594_719729700756585_5813998063970535049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gx3NuqMVlzgQ7kNvwFlSs2w&_nc_oc=AdpdB-ISg79pYbNcDm9ALv9i-PLLdRuQcxR4kHzCDQ2mpv4wPdko_lRjOJEwOKRZWzQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItrGRqS6xhdQZuBzVfbdYvP4JPSrYw8cXG74vSv63XlQ&oe=6AAD5511"}, "display_name": "Bouncing Baboon", "keywords": [], "long_description": "Bouncing Baboon is a explorable game where you can bounce and swing your way through the game, there are a variety of maps you can play through, such as:\n\nForest - Jump around on trampolines or climb up trees for a ton of fun\n\nCaves - Go down the slippery slide into the echoing cave where you will be tasked with mining resources (in a future update)\n\nShop - take a break from the chaos and put on some wear for your baboon\n\nBeach - Jump from platforms sitting on the water to jumping in the water and chill with friends\n\nShore - Ride in the giant ocean in this map with the brand new boats\n\nPool - Swim with friends in this smaller map or get a tan from the upstairs portion\n\nwhether you're a parkour master or a laid-back player, Bouncing Baboon is the game for everyone", "short_description": "Bounce around in this fun VR game, bounce down to the caves or go to shop and pick up some fresh cosmetics"}]}, "developer_name": "CoolBlue", "developer_privacy_policy_url": "https://sites.google.com/view/bouncingbaboons/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TVVOIDZ Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/bouncingbaboons/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "10087116791383798"}, "review_messages": []
N7V-8SrdKQ7NMPi4xoBTIqPaIiFZ9rRO24&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRToNYbFDLzEvrQQgwRWwmQ9tLxs4O_OpPHUE9T3B9-w&oe=6A4E38E4"}, {"file_name": "SampleScene_4K_17.05.2025_15-06-15.png", "id": "1733164250603383", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499361329_1733164253936716_5116391949939568888_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cR2IdQDU26UQ7kNvwEnpNEt&_nc_oc=AdqccWPbBtAtCQZXLtQnW_gcYu8yHbdCVpTV1am-dqSrFoh61w-shPzPAn1kKzNcS10&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2kJRrQgFLQ_Cby93IdVkd1SL1WeJ93dojWIUIrC_r-A&oe=6A4E599B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled571_20250630144933.png", "id": "719729697423252", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820594_719729700756585_5813998063970535049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFo-p5i8wpcQ7kNvwHGpR0Y&_nc_oc=AdpwQazHOc1bP2-zyplekwAPhoGo0XcYUx8SmI7w7w-t4kvxf4oBDGZkDnqqs9Q_-Z0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4nfDxiPE45So1eGNEezrxX1RRgNb4e2eNrheZJ4-uZw&oe=6A4E6911"}, "display_name": "Bouncing Baboon", "keywords": [], "long_description": "Bouncing Baboon is a explorable game where you can bounce and swing your way through the game, there are a variety of maps you can play through, such as:\n\nForest - Jump around on trampolines or climb up trees for a ton of fun\n\nCaves - Go down the slippery slide into the echoing cave where you will be tasked with mining resources (in a future update)\n\nShop - take a break from the chaos and put on some wear for your baboon\n\nBeach - Jump from platforms sitting on the water to jumping in the water and chill with friends\n\nShore - Ride in the giant ocean in this map with the brand new boats\n\nPool - Swim with friends in this smaller map or get a tan from the upstairs portion\n\nwhether you're a parkour master or a laid-back player, Bouncing Baboon is the game for everyone", "short_
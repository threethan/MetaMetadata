&oe=6A4A6A41"}, {"file_name": "SampleScene_4K_17.05.2025_14-53-07.png", "id": "3981262085447099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499352406_3981262092113765_3883376745715535268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QP4FLqmEEGQQ7kNvwF53ptg&_nc_oc=AdrY2s75k4IwuEMZHkR8H8nflLSp-T84SiRQjglaEfYnjy4BQAy11q55FcdJGlwPeWU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaLRGfV4KP_qawvQAUwwriqgGw1_aLqfNpWdm-ASeOkg&oe=6A4A4EFE"}, {"file_name": "SampleScene_1440p_17.05.2025_15-08-31.png", "id": "1815662666028443", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473400782_1815662669361776_6262723299433321752_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Xz4d-603ycQ7kNvwFutpAj&_nc_oc=AdqpOuEXkH5WMedd3pbfWbjcm9ILljWqeHWM-Q9AoshmfIoV2RxnHnVx1ENQlrMDFLc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrGJSZMBUrcQ5i4MlZVNhfff7K3cEFbIMzCDsqNDJECg&oe=6A4A7CA4"}, {"file_name": "SampleScene_4K_17.05.2025_15-06-15.png", "id": "1733164250603383", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499361329_1733164253936716_5116391949939568888_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxrH62Tb1OQQ7kNvwEGAGg0&_nc_oc=AdpkTMdzQQjt-W7Cu5dtevCAdJjkCbAj9oPHd2VQgDzskjk8BTJtN8T8r1G7PE1CthA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoxhOqcennCpWWfSUOBVMdv_JlqGrE5Wk47S7Kx8KVjw&oe=6A4A651B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled571_20250630144933.png", "id": "719729697423252", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820594_719729700756585_5813998063970535049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2viHA8y9lrkQ7kNvwExA848&_nc_oc=AdqKjvCDLHxeOqsZjZMBOjtOXMAbFUD3HiTrJo2HBA2Ouf-yw-RbPp5eGNn9jaanAPk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6K9jVxad6T18s3NMJijqrRxRp09s2nWTtPWyXQO6M3A&oe=6A4A7491"}, "display_name": "Bouncing Baboon", "keywords": [], "long_description": "Bouncing Baboon is a explorable game where you can bounce and swing your way through the game, there are a variety of maps you can play through, such as:\n\nForest - Jump around on trampolines or climb up trees for a ton of fun\n\nCaves - Go down the slippery slide into the echoing cave where you will be tasked with mining resources (in a future update)\n\nShop - take a break from the chaos and put on some wear for your baboon\n\nBeach - Jump from platforms sitting on the water to jumping in the water and chill with friends\n\nShore - Ride in the giant ocean in this map with the brand new boats\n\nPool - Swim with friends in this smaller map or get a tan from the upstairs portion\n\nwhether you're a parkour master or a laid-back player, Bouncing Baboon is the game for everyone", "short_description": "Bounce around in this fun VR game, bounce down to the caves or go to shop and pick up some fresh cosmetics"}]}, "developer_name": "CoolBlue", "developer_privacy_policy_url": "https://sites.google.com/view/bouncingbaboons/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TVVOIDZ Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/bouncingbaboons/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "10087116791383798"}, "review_messages": []
9DwIDYljYYH_EwqIxxr5FPCf7oN_HARPCw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9JuMVP_W7UKxdRBCID2b1k5bpJNwRiIpjenIP8hx1Og&oe=6A9996A4"}, {"file_name": "SampleScene_4K_17.05.2025_15-06-15.png", "id": "1733164250603383", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499361329_1733164253936716_5116391949939568888_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4hOw3L_NfIQ7kNvwFm3mUE&_nc_oc=Adp0YXUAuSkKwDUjuO0VweuEjI7h4q_grrYf8IFWsmGs9dlJzX9MZINi8S4vC1B5MvU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTUuaf75xNI4Kh7O8dniDNHjdxsfWjPCTPDso6PDO_Mw&oe=6A997F1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled571_20250630144933.png", "id": "719729697423252", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820594_719729700756585_5813998063970535049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7b6Y4wkpwOIQ7kNvwHP4q9F&_nc_oc=AdqQRTRu-lo9vZ_PK7X8fENO-VJw4lWnKjmGU5YOQrIo8Ije6cyG5mSkFwLMavuhJQE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKq7S9H5R3X9gH2tbF8pQHu017qE_Lw9lPeqEZoiMKGog&oe=6A998E91"}, "display_name": "Bouncing Baboon", "keywords": [], "long_description": "Bouncing Baboon is a explorable game where you can bounce and swing your way through the game, there are a variety of maps you can play through, such as:\n\nForest - Jump around on trampolines or climb up trees for a ton of fun\n\nCaves - Go down the slippery slide into the echoing cave where you will be tasked with mining resources (in a future update)\n\nShop - take a break from the chaos and put on some wear for your baboon\n\nBeach - Jump from platforms sitting on the water to jumping in the water and chill with friends\n\nShore - Ride in the giant ocean in this map with the brand new boats\n\nPool - Swim with friends in this smaller map or get a tan from the upstairs portion\n\nwhether you're a parkour master or a laid-back player, Bouncing Baboon is the game for everyone", "short_
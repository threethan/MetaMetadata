1527826631774548", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_1527826638441214_1297453206451596333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pk2YOd1q2-8Q7kNvwHO12iM&_nc_oc=Adqr5lRQQxGNxzSh2FoIVv-ewFO6sl6JKGK0MHLmRn8ASiXSaX2RT-_rDu4WFz8CWp4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6T88XvRDgkpxbqH2geFTfoDfdIWo9GVB-WPIvuAzYxkw&oe=6A048A15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "1445949953773557", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823901_1445949957106890_7516487468909062797_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RK_CNHLqMUIQ7kNvwHFpjBU&_nc_oc=Adp7bwAcq5wuWrsCvf5vUfdP38H8KFTKYDeHU4zzZbeFCfL0o-l8J0xpbTxLf-yNo6w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fVGbqYlFb-Otb_90-JNA5ySTQCrYhrX24E7f414L5kQ&oe=6A048C27"}, "display_name": "Truck Racing", "keywords": ["TruckRacing", "BigRig", "Circuit", "Arcade", "Driving"], "long_description": "Think you know racing? Try doing it in a 5-ton beast!\n\nTruck Racing offers a unique twist on the motorsport genre. Leave the trailers and speed limits behind. In this game, you take control of powerful semi-truck cabs (bobtails) and push them to their absolute limits on professional race tracks.\n\nDrifting a sports car is one thing, but sliding a massive truck through a hairpin turn requires a whole new level of skill. Feel the weight, hear the roar of the diesel engines, and battle for the first place against tough AI rivals.\n\nKey Features:\n\nHeavyweight Racing: Experience the unique physics of racing trucks. Manage your momentum and braking points carefully to stay on the track.\n\nCircuit Championship: Race across various tracks featuring grandstands, steep hills, and sharp corners.\n\nCompetitive AI: You are not alone on the asphalt. Battle for position against 4 other racers who won't give up the lead easily.\n\nArcade Fun: Jump in and race! Intuitive controls meet challenging gameplay for a fast-paced adrenaline rush.\n\nTrack Info HUD: Keep track of your lap times, speed (RPM), and position with a clear heads-up display.\n\nThe green light is on! Rev up your engine and dominate the circuit in Truck Racing.", "short_description": "Forget the cargo, it\u2019s time to race! Truck Racing puts you behind the wheel of massive semi-trucks modified for pure speed. Compete against aggressive opponents on winding asphalt circuits, master the weight of your heavy rig, and fight for the pole position. These giants aren't made for delivery\u2014they are made to win. Can you handle the power of a racing big rig?"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30541893825426574"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1509855500819451"}, {"status": "PUBLISHED", "id": "1866090044047783"}, {"status": "PUBLISHED", "id": "1036702348644188"}]}, "baseline_offer": {"id": "1036702348644188"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779303600
_6gQKb8jXqF-QoEZeyNt5Zg&oe=6A11B672"}, {"file_name": "migrated_image.png", "id": "827023631152248", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162701_242675506264163_8790123992624136192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIS73Elgly4Q7kNvwG7rcLr&_nc_oc=AdqnnvNRFgTqNDwoVxOOD_eWcC4TzTmhNFDa9VeBCa_FT2V-lnKcfqRyGU3T-7u1aCE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5swXutiNlPEJQwnCBAUxY9hp_emxat4qIBRHEn-tkdPA&oe=6A11AC57"}, {"file_name": "migrated_image.png", "id": "670728800329760", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162702_1520552044697293_1024152462312865792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFEQV9U_VwYQ7kNvwEg9J1J&_nc_oc=Adr0TQYFFr79HX3vWqd5xo9XeJ1u8ggxkSfRdJllgVeMWBayViCArB-fc0g1xOSMtF0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-u0-kV_4BMFT2d28eFqbnpbVxjyKuvKHcDjXkahOj8Q&oe=6A119F6A"}, {"file_name": "migrated_image.png", "id": "586337405561688", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162701_147951319178411_2097782780371927040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvITJW4eIewQ7kNvwEqLtWz&_nc_oc=Adowdt9hSsIL01Dq88Jv3F6NoJKmWb1mr6DcHBKacmquDw9K2URzUsqtyZdPbMtgonY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qqCKo-JdBOrMk7NcX5-Ra77h1bjMlWk2j4wccuJkjTA&oe=6A11A35F"}, {"file_name": "migrated_image.png", "id": "209994773540672", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162731_268445373681963_2567427906477228032_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkZcMvfGkJUQ7kNvwHKUW78&_nc_oc=AdoIeuGBI39PKRz12JejB71POniIPYFg6WFPtXndbOrVlFLs6sxdVwoLCFP5DQFq_jk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7y2EF4n3NFximOy2hAz9ECK3ag22MLlOQ6lSeczf5ULw&oe=6A11C20A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Twobit Odyssey", "keywords": ["twobit", "squidbeam", "puzzle", "exploration"], "long_description": "Only using your gaze or the VR Controller, guide a little robot in a strange world, helping him solve problems and puzzles, and ultimately unravel the mysteries of this dark and enigmatic place. \n\nTwobit awakens in a dark and mysterious place. But he is not alone. He sees you. You are his guide. When he asks for direction, look around and find a location for him to explore. When he finds a button, nod your head in agreement to activate it. Need to see what lurks in the dark? Activate the Twobit Vision and see the world through his eyes. But who is Twobit and, most importantly, who are you? Are you a figment of his imagination?\n\nTwobit Odyssey is an unique VR puzzle-platform game based on the award-nominated game Twobit.\n\nFeatures:\n- Eight mind-bending levels, fours different environments and bosses.\n- Unique control system.\n- Designed to prevent motion sickness.\n- Immersive 3D sound.", "short_description": "Only using your gaze or the VR Controller, guide a little robot in a strange world, helping him solve problems and puzzles, and ultimately unravel the mysteries of his origin.\n\nFeatures:\n- Eight mind-bending levels, four different environments and bosses.\n- Unique control system.\n- Designed to prevent motion sickness.\n- Immersive 3D sound."}]}, "developer_name": "Squidbeam Games", "developer_privacy_policy_url": "http://www.squidbeamgames.com/", "developer_terms_of_service_url": "http://www.squidbeamgames.com/", "publisher_name": "Squidbeam Games", "support_website_url": null, "website_url": "http://www.squidbeamgames.com/twobitodyssey", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "
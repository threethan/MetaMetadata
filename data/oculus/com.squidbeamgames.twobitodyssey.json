516D7"}, {"file_name": "migrated_image.png", "id": "536703570315269", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162702_1520552044697293_1024152462312865792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYFwtvOPC0UQ7kNvwEeCDmS&_nc_oc=Adp2pal3Knk7g9KbtJfoVILYvXUJKAuGhqVbmT9w20Z4pP53mcPtqj0MnWHE4om7KBM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jgawtTxCNqUptGunXg3J9eeHpnFViCDmIYUvHcztv3Q&oe=6A4509EA"}, {"file_name": "migrated_image.png", "id": "203612124307068", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162701_147951319178411_2097782780371927040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NSDz9HUX34Q7kNvwGgnE1_&_nc_oc=AdoWQAQJrpBEGBLZXgbL6j1IqGfEzg5FsbIij0VxBTX3YFB7ukCVSMciRMKThiK5VLA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hjlXMotGz9k3BH00ePe_UXb78P3QhZibsLxKe3CDvug&oe=6A450DDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "twobitodyssey_video_cover.png", "id": "1236709949762533", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162682_1236709956429199_7492834034309922816_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vsBk9Fkws8Q7kNvwHu-vmx&_nc_oc=AdoYpk3FoH1husVyUZRv4NAYy-wWURt7SmsJE42b0YEKEvHw42BVe7lveauG_o1jvYo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9spOZ0xapNLl30RbTbrDJBHR_tqSuxWYwXuBfAUnMDSA&oe=6A452A8F"}, "display_name": "Twobit Odyssey", "keywords": ["twobit", "squidbeam", "puzzle", "exploration"], "long_description": "Only using your gaze, control a little robot in a strange world, helping him tackle problems and puzzles, and ultimately unravel the mysteries of this dark and enigmatic place. \n\nTwobit awakens in a dark and mysterious place. But he is not alone. He sees you. You are his guide. When he asks for direction, look around the room and find a location for him to explore. When he finds a button, nod your head in agreement to activate it. Need to see what lurks in the dark? Activate the Twobit Vision and see the world through his eyes. But who is Twobit and, most importantly, who are you? Are you a figment of his imagination?\n\nTwobit Odyssey is an unique VR puzzle-platform game based on the award-nominated game Twobit.\n\nFeatures:\n- Eight mind-bending levels, fours different environments and bosses.\n- Unique control system.\n- Designed to prevent motion sickness.\n- Immersive 3D sound.", "short_description": "Only using your gaze, control a little robot in a strange world, helping him tackle problems and puzzles, and ultimately unravel the mysteries of this dark and enigmatic place.\n\nFeatures:\n- Eight mind-bending levels, four different environments and bosses.\n- Unique control system.\n- Designed to prevent motion sickness.\n- Immersive 3D sound."}]}, "developer_name": "Squidbeam Games", "developer_privacy_policy_url": "http://www.squidbeamgames.com/", "developer_terms_of_service_url": "http://www.squidbeamgames.com/", "publisher_name": "Squidbeam Games", "support_website_url": null, "website_url": "http://www.squidbeamgames.com/twobitodyssey", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PUZZLE", "ACTION", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1964621017055932"}}]}, "scheduled_offers": {"count": 36, "nodes": [{"status": "PUBLISHED", "id": "246997099250291"}, {"status": "PUBLISHED", "id": "660981294476067"}, {"status": "PUBLISHED", "id": "599400380527946"}, {"status": "PUBLISHED", "id": "1540331546137866"}, {"status": "PUBLISHED", "id": "602783650562092"}, {"status": "PU
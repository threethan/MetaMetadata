-54rDqRCDcV4BKgluPg&oe=6A184DF2"}, {"file_name": "migrated_image.png", "id": "827023631152248", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162701_242675506264163_8790123992624136192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qc3zFTU74-MQ7kNvwHC5jDC&_nc_oc=Adq4jtFYBt5JQZxdOzfRg0Dp5nnbE-WGLCn_JLN3AKUdH39b3D74F9rO3vTG27Y92Oo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wzm3Out9H7EaEEM7vKniEuHv4pmhQP0lp1nSS1nj5yg&oe=6A1843D7"}, {"file_name": "migrated_image.png", "id": "670728800329760", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_1520552044697293_1024152462312865792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoxYjkBkWO0Q7kNvwFfKjxQ&_nc_oc=Ado3RyyhfJry2Yu_JJyVgP8v7xwo-bUFTunBNPzonBvFOceGgGVs7zJ9fTKhsQhMgyE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5I6XR9WXNfAP8th2Vbv1xT2OWDT-fag_u-ekiVBlaosw&oe=6A1836EA"}, {"file_name": "migrated_image.png", "id": "586337405561688", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162701_147951319178411_2097782780371927040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dePjY8cznd8Q7kNvwHv9FTd&_nc_oc=AdptNoPu5Tqo37tNTb7zyEvcck7PPg-IpMnb3TuNs7xUG0rFCWETVEAhu5ea0choL7A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48p0IY7U0nMrf5W609Ls3ij799qRgtASRsPkYt_q-XPQ&oe=6A183ADF"}, {"file_name": "migrated_image.png", "id": "209994773540672", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162731_268445373681963_2567427906477228032_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHCJGbj7HAAQ7kNvwF2u6h8&_nc_oc=AdqDExXfiSSKo3iV-nJauf1oPYHSRB1CAjiPlz0O94HSeggT2Pkyxa3jMYrlNxMF0NY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6apj0YSJ6RIY0-vwvTkDaC3yT4KNd8y1SyJxXVr-E5fA&oe=6A18598A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Twobit Odyssey", "keywords": ["twobit", "squidbeam", "puzzle", "exploration"], "long_description": "Only using your gaze or the VR Controller, guide a little robot in a strange world, helping him solve problems and puzzles, and ultimately unravel the mysteries of this dark and enigmatic place. \n\nTwobit awakens in a dark and mysterious place. But he is not alone. He sees you. You are his guide. When he asks for direction, look around and find a location for him to explore. When he finds a button, nod your head in agreement to activate it. Need to see what lurks in the dark? Activate the Twobit Vision and see the world through his eyes. But who is Twobit and, most importantly, who are you? Are you a figment of his imagination?\n\nTwobit Odyssey is an unique VR puzzle-platform game based on the award-nominated game Twobit.\n\nFeatures:\n- Eight mind-bending levels, fours different environments and bosses.\n- Unique control system.\n- Designed to prevent motion sickness.\n- Immersive 3D sound.", "short_description": "Only using your gaze or the VR Controller, guide a little robot in a strange world, helping him solve problems and puzzles, and ultimately unravel the mysteries of his origin.\n\nFeatures:\n- Eight mind-bending levels, four different environments and bosses.\n- Unique control system.\n- Designed to prevent motion sickness.\n- Immersive 3D sound."}]}, "developer_name": "Squidbeam Games", "developer_privacy_policy_url": "http://www.squidbeamgames.com/", "developer_terms_of_service_url": "http://www.squidbeamgames.com/", "publisher_name": "Squidbeam Games", "support_website_url": null, "website_url": "http://www.squidbeamgames.com/twobitodyssey", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppor
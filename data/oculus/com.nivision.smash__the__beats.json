3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyFDX5Zp7GPJHrTZsTrYt4J-cZ9OndKoPATswjJILbIPA&oe=69B40E09"}, {"file_name": "migrated_image.png", "id": "529143797801545", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974549_2026771984055710_6855105693788143616_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrIidTaK1YAQ7kNvwGi_AWg&_nc_oc=AdmwYswzSAZOcQR6wEqXMVhEZmJ-cFnT6rXcBmeqp6a9HzbjtuTRVW4iODs7vNoMsXE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxtIlBdzoufoKETF_zw9Lo38xXruzYFKrCbYOvsM9VQ2Q&oe=69B4132D"}, {"file_name": "migrated_image.png", "id": "514040819516173", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982592_1861135210673175_7534725856824918016_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LtX3Lyq0OZQQ7kNvwGkeiO5&_nc_oc=AdlzeH6-fuUD7msz9qU4sn_6E_UELhnZ13bYhKBCjBNmoIcCSHPE7LIbawzbUBs2WQk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyIqAa4khNvSF6j6pcy1X_cGPLHlMpENuCsr0s3rH78zw&oe=69B41393"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/kKS07V", "id": "489900695058613", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974691_489900698391946_4969603158079700992_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNgiEJHMsjwQ7kNvwHM-3Ba&_nc_oc=AdlLoX7nLv9QikweRoIQIdf_i-W6DVzIR7caHqh6ewvB8-B6QnYjG0Lud_jJoIvH4m0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3hfOvjY7HAz1ZqAINDX64ur6gt93_daS6aGEga7nmhg&oe=69B401C7"}, "display_name": "Smash The Beats", "keywords": ["music", "rhythm", "beats", "smash", "saber"], "long_description": "Smash The Beats is an energetic music game that will surround you with music. Come face to face with the beats. Play with 31 handcrafted tracks available in the game or choose your own MP3.\nAll you need to do is to feel the music and smash incoming cubes exactly with the beat.\nBlocks with the blue arrow smash with the blue tool, for orange arrows use the orange tool. How to change the color? Just press the trigger.\n\nIt\u2019s up to you if your controller changes into shield, hammer or sword. \nTry them all to smash the bricks.\nYou can play easy, normal mode or if you like challenges choose advance one.\n \nSo put on your GO and start the fun with smashing beats.\nIf you like energetic music, rhythms  Smash The Beats is for you!", "short_description": "Smash The Beats is an energetic rhythm VR game. Smash the blocks in time with the music. It\u2019s up to you if your controller changes into shield, hammer or sword.  Play with 31 handcrafted tracks available in the game or choose your own MP3. Put on your GO  and start the fun with smashing beats."}]}, "developer_name": "NiVision", "developer_privacy_policy_url": "https://sites.google.com/view/nivision-privacy-policy", "developer_terms_of_service_url": "https://nivisionag.wixsite.com/smashthebeats/eula", "publisher_name": "NiVision", "support_website_url": null, "website_url": "https://nivisionag.wixsite.com/smashthebeats", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477277164071905"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982686_2685113878204740_9093648463849062400_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JO5GjAPxBfcQ7kNvwFND_XT&_nc_oc=AdnBh3vlATbc96TWCso71E5xYdWgC86YJEeNq6HHcrFaSp7NL3Tx8KEc0iAbn6-JxsQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxhD
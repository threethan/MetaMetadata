//scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974695_111094539829419_979855118809694208_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAAatoQmkeIQ7kNvwGyKdnm&_nc_oc=AdoALp7Lo-F8vqqMNFnDwmde8-xuN_ZfSYkTqAj4rxH6rlMjNOKp4iCfYSVAWI6Y4es&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCF2eT8n5BjiZwcaUGHVSgqGs95_IGwWntwKJShK8xSTQ&oe=6A661972"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/OKPFvg", "id": "891597001043982", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974529_891597007710648_1919576886384525312_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6hIKMmuiC4Q7kNvwFoLgDT&_nc_oc=AdoXG1BF-fNVJYCApNp32NQAkgcbPfnSi_elNBoAwzjkjsFxzfWy9g5EHWJonWD1iPk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAl1pGEOpnDTCfWCJJ4JO-6gBpOTSxAxuBVVLN9_9ZrLA&oe=6A660CE6"}, "display_name": "Smash The Beats", "keywords": ["music", "rhythm", "beats", "smash", "saber"], "long_description": "Smash The Beat is an energetic music  game which will surround you with music. Come face to face with the beats. Play with 15 handcrafted tracks available in the game or choose your own MP3.\nAll you need to do is to feel the music and smash incoming cubes exactly with the beat.\nBlocks with the blue arrow smash with blue tool, for orange arrows use orange tool. How to change the color? Just press the trigger.\n\nIt\u2019s up to you if your controller change into shield, hammer or sword. \nTry them all to smash the bricks.\nYou can play easy, normal mode or if you like challenges choose advance.\n \nSo put on your GO and start fun with smashing beats.\nIf you like energetic music, rhythms  Smash The Beat is  for you!", "short_description": "Smash The Beat is an energetic rhythm VR game. Smash the blocks in time with the music. It\u2019s up to you if your controller change into shield, hammer or sword.  Play with 15 handcrafted tracks available in the game or choose your own MP3. Put on your GO  and start fun with smashing beats."}]}, "developer_name": "NiVision", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "http://nivisionag.wixsite.com/duovr/eula", "publisher_name": "NiVision", "support_website_url": null, "website_url": "https://nivisionag.wixsite.com/smashthebeats", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2422460597889353"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3100187043343774", "version": "2.0"}, "id": "2216069331771380", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2227827680579719", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3100187043343774"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2216069331771380"}]}, "change_log": null, "created_date": 1579887087, "id": "3100187043343774", "version": "2.0", "version_code": 62, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset"
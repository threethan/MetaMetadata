ent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpRLp-PJE3ncrgsEHQNydzMif4X1X_D2fJX-HMGPFehQ&oe=6AFDD60A"}, {"file_name": "migrated_image.png", "id": "202569951085394", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974549_2026771984055710_6855105693788143616_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2iyRq85cZoQ7kNvwFHJp_N&_nc_oc=Adp__C1WaPbH2hT8jHlVO9LJ5TjAcBRMQDRVZaMRrvhrjk3Tcg5KPfFWqIdWQ2zBrQg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfokdkp5vrLnzrpi5Rd2n_CxM6L5cMRMTZ5y_567ss5g&oe=6AFDE26D"}, {"file_name": "migrated_image.png", "id": "2588405114711790", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974695_111094539829419_979855118809694208_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmy6ey_XCFgQ7kNvwEcx-2P&_nc_oc=Adp4rikFYh_6n-FKmYMTKT8LPz51l1ITdq_nXR7My4yIsLrCIaaNlco5sHMZTBRz7jk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTX151IHPz2cgRYwaGrkmCJRejNxO6UfjenOBlwBmOTiQ&oe=6AFDB5F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/OKPFvg", "id": "891597001043982", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974529_891597007710648_1919576886384525312_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmtqAMxsJeAQ7kNvwG_vGba&_nc_oc=AdritMmBQG2ysrQt-jUsbHqjGRtScIp1dZZCdtObpkYXZsh8xlfp_w0V9ADFDEkM-pU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6_GKXpWDJOLxXPmHUqRAUg7swW29aSwFOeIIUMTiiRA&oe=6AFDE1A6"}, "display_name": "Smash The Beats", "keywords": ["music", "rhythm", "beats", "smash", "saber"], "long_description": "Smash The Beat is an energetic music  game which will surround you with music. Come face to face with the beats. Play with 15 handcrafted tracks available in the game or choose your own MP3.\nAll you need to do is to feel the music and smash incoming cubes exactly with the beat.\nBlocks with the blue arrow smash with blue tool, for orange arrows use orange tool. How to change the color? Just press the trigger.\n\nIt\u2019s up to you if your controller change into shield, hammer or sword. \nTry them all to smash the bricks.\nYou can play easy, normal mode or if you like challenges choose advance.\n \nSo put on your GO and start fun with smashing beats.\nIf you like energetic music, rhythms  Smash The Beat is  for you!", "short_description": "Smash The Beat is an energetic rhythm VR game. Smash the blocks in time with the music. It\u2019s up to you if your controller change into shield, hammer or sword.  Play with 15 handcrafted tracks available in the game or choose your own MP3. Put on your GO  and start fun with smashing beats."}]}, "developer_name": "NiVision", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "http://nivisionag.wixsite.com/duovr/eula", "publisher_name": "NiVision", "support_website_url": null, "website_url": "https://nivisionag.wixsite.com/smashthebeats", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2422460597889353"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3100187043343774", "version": "2.0"}, "id": "2216069331771380", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_bin
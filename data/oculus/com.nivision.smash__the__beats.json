cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KfAx8Pizj8Q7kNvwE4k00z&_nc_oc=AdkWk0IIYo0S8xuq6BMGpjD2O76K52GfyDFdbiH0h_ciwQD2A6OYF9Y6zw0QGbef9y8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwjint4U4N6H14L9iiwvNvWa-Xwqp0PT7Pkw9pe4-m6sQ&oe=69BFFC72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/OKPFvg", "id": "891597001043982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974529_891597007710648_1919576886384525312_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9xEpc8qHmYQ7kNvwHHa-Y6&_nc_oc=AdkyipE7olluK8XfZB6KygV7Z49I6UW6VCEoz_arIn29I0CsB9f_m-3O5ObfKo6_KFU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwyR27eqRZZFIUc2mG2LOQUc4Nm9KtSYljOh_1g7pc63Q&oe=69BFEFE6"}, "display_name": "Smash The Beats", "keywords": ["music", "rhythm", "beats", "smash", "saber"], "long_description": "Smash The Beat is an energetic music  game which will surround you with music. Come face to face with the beats. Play with 15 handcrafted tracks available in the game or choose your own MP3.\nAll you need to do is to feel the music and smash incoming cubes exactly with the beat.\nBlocks with the blue arrow smash with blue tool, for orange arrows use orange tool. How to change the color? Just press the trigger.\n\nIt\u2019s up to you if your controller change into shield, hammer or sword. \nTry them all to smash the bricks.\nYou can play easy, normal mode or if you like challenges choose advance.\n \nSo put on your GO and start fun with smashing beats.\nIf you like energetic music, rhythms  Smash The Beat is  for you!", "short_description": "Smash The Beat is an energetic rhythm VR game. Smash the blocks in time with the music. It\u2019s up to you if your controller change into shield, hammer or sword.  Play with 15 handcrafted tracks available in the game or choose your own MP3. Put on your GO  and start fun with smashing beats."}]}, "developer_name": "NiVision", "developer_privacy_policy_url": null, "developer_terms_of_serv
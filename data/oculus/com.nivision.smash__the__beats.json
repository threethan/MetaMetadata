QdGw7zN6ag&oe=69A43C09"}, {"file_name": "migrated_image.png", "id": "529143797801545", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974549_2026771984055710_6855105693788143616_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PubQaimahxwQ7kNvwG0xEz9&_nc_oc=Admfftx-v1GW5VubXmfnBo_iuER80LQv9bDYECKBmP8NNgQNvuejZ0bJN50-1Ry4zkA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfthMTrp08IN6fZb7BU6ymJ0qGthToHUAQV2-CBkilLGNw&oe=69A4412D"}, {"file_name": "migrated_image.png", "id": "514040819516173", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982592_1861135210673175_7534725856824918016_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L36OMuteC48Q7kNvwEn3MB5&_nc_oc=Adm1B8QqqOUNkVUbSpeZuXSKlc3YrbPIt2v2WvESksIvQpln1oaPgZXmn2rvoGKtsxo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftGsOaONGyR9TCLkjfHJlWOTXqtxMYp4dCwqGlB4Kv6pQ&oe=69A44193"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/kKS07V", "id": "489900695058613", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974691_489900698391946_4969603158079700992_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lM5m6evcxC0Q7kNvwEKCffQ&_nc_oc=AdlR4Ry0jbNZBCurbSrOXPBV8zltW-YMrB4FuKqY_BhQJanXkLy4pO-8qvCQahP40E8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv3Uky3nGSMq2dMUCrOajLL2pZXkRhY5IEu1kM6PgLx9Q&oe=69A42FC7"}, "display_name": "Smash The Beats", "keywords": ["music", "rhythm", "beats", "smash", "saber"], "long_description": "Smash The Beats is an energetic music game that will surround you with music. Come face to face with the beats. Play with 31 handcrafted tracks available in the game or choose your own MP3.\nAll you need to do is to feel the music and smash incoming cubes exactly with the beat.\nBlocks with the blue arrow smash with the blue tool, for orange arrows use the orange tool. How to change the color? Just press the trigger.\n\nIt\u2019s up to you if your controller changes into shield, hammer or sword. \nTry them all to smash the bricks.\nYou can play easy, normal mode or if you like challenges choose advance one.\n \nSo put on your GO and start the fun with smashing beats.\nIf you like energetic music, rhythms  Smash The Beats is for you!", "short_description": "Smash The Beats is an energetic rhythm VR game. Smash the blocks in time with the music. It\u2019s up to you if your controller changes into shield, hammer or sword.  Play with 31 handcrafted tracks available in the game or choose your own MP3. Put on your GO  and start the fun with smashing beats."}]}, "developer_name": "NiVision", "developer_privacy_policy_url": "https://sites.google.com/view/nivision-privacy-policy", "developer_terms_of_service_url": "https://nivisionag.wixsite.com/smashthebeats/eula", "publisher_name": "NiVision", "support_website_url": null, "website_url": "https://nivisionag.wixsite.com/smashthebeats", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477277164071905"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982686_2685113878204740_9093648463849062400_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQXFmAx74l4Q7kNvwFVxdtj&_nc_oc=AdmNqIGCMRTsf88zG2ZLrtZaGa-_j-yq8DvxfDzHpbFgbbPbqOcSxRIGaXTNREdlEc4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsvcNA6w-Uj6M4KKoIKe0umHYHXKIrSpxS_v1U1_QjvZw&oe=69A41CC8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false,
eTd6_NHOLA&oe=69A04789"}, {"file_name": "migrated_image.png", "id": "529143797801545", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974549_2026771984055710_6855105693788143616_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKG_d35bE4cQ7kNvwEcIVai&_nc_oc=AdkcHiyEj2_FUgi2ve5FvPISq09ogu39ZCSUwZiGb4MIth_7NY_VZnFnI43an1MO8qs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afue0mpEyeDB1-_R9506-HC6buRzKwvpmDxh0NkgVxryBw&oe=69A04CAD"}, {"file_name": "migrated_image.png", "id": "514040819516173", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982592_1861135210673175_7534725856824918016_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDA0K5TrIGgQ7kNvwE9Wnbf&_nc_oc=AdlsqwJB3NIAFnP7PjIR-_rXNYnAwgFlpuDJJvgjqDQL7T971zKJ_9Lf5vdZMWm0-lY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu-1T4aNWHpgUZAKQxDFG-OEMoJLgxeVWFud8n4axAXZw&oe=69A04D13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/kKS07V", "id": "489900695058613", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974691_489900698391946_4969603158079700992_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FN4TjRsXoMQQ7kNvwEVeGOX&_nc_oc=AdnN81C6MtUbXqyrFJXAHBTr7TjjOH_ihpmZbH_LrskggtX0hZASHKG8k98yH6io9mI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvKlZhlCASkcIdV1RFPIKBkIZNDvOFiLWPwVNEX_oe9Lw&oe=69A03B47"}, "display_name": "Smash The Beats", "keywords": ["music", "rhythm", "beats", "smash", "saber"], "long_description": "Smash The Beats is an energetic music game that will surround you with music. Come face to face with the beats. Play with 31 handcrafted tracks available in the game or choose your own MP3.\nAll you need to do is to feel the music and smash incoming cubes exactly with the beat.\nBlocks with the blue arrow smash with the blue tool, for orange arrows use the orange tool. How to change the color? Just press the trigger.\n\nIt\u2019s up to you if your controller changes into shield, hammer or sword. \nTry them all to smash the bricks.\nYou can play easy, normal mode or if you like challenges choose advance one.\n \nSo put on your GO and start the fun with smashing beats.\nIf you like energetic music, rhythms  Smash The Beats is for you!", "short_description": "Smash The Beats is an energetic rhythm VR game. Smash the blocks in time with the music. It\u2019s up to you if your controller changes into shield, hammer or sword.  Play with 31 handcrafted tracks available in the game or choose your own MP3. Put on your GO  and start the fun with smashing beats."}]}, "developer_name": "NiVision", "developer_privacy_policy_url": "https://sites.google.com/view/nivision-privacy-policy", "developer_terms_of_service_url": "https://nivisionag.wixsite.com/smashthebeats/eula", "publisher_name": "NiVision", "support_website_url": null, "website_url": "https://nivisionag.wixsite.com/smashthebeats", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477277164071905"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982686_2685113878204740_9093648463849062400_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTTDJNwKnAQQ7kNvwGW9IQm&_nc_oc=AdlCVPfCtZ5huqlOSaeamS_8Vv8ay9OzUDYVkMyTvExCSSJqg2QFB-eR9j8IHx_GTws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvdgoYzw74GRgLAmRRR4stH2YDKtQ-xY39N17JnBQPtrw&oe=69A02848"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false,
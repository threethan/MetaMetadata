XoxzMuNlgkgiZ85_fG7w7E2VtgzMQ65ikQw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sNeDyA5KldsfLD-F8jaTnR7UmpPKMUwZy8C9c43o53w&oe=6A230449"}, {"file_name": "migrated_image.png", "id": "529143797801545", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974549_2026771984055710_6855105693788143616_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymA3rxxggvoQ7kNvwEJBueC&_nc_oc=AdqBu1t84BoQoe-Kr1rlMpj-QC-DOD-CqV1KwCg1Uzi8ounTT7clOJJSO-U4iCVVl_Q&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GK47mclt09RVfCbgotnRG3Wzi2ZzMX14fV-oOTIv4QQ&oe=6A22D12D"}, {"file_name": "migrated_image.png", "id": "514040819516173", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982592_1861135210673175_7534725856824918016_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfzCGa24VjYQ7kNvwGeMMNP&_nc_oc=Adpv-py12vzP5klmJTt-pWJZ7h2mh8JAMK4uLSlT0jTQ8ljqS-zDP5Lh4B11qo3uWvk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vvwQz8CE3ZwD9RbaygumsQJKjLQwg6bdZ0ywmA4vRkg&oe=6A22D193"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/kKS07V", "id": "489900695058613", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974691_489900698391946_4969603158079700992_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAVjcQzF21AQ7kNvwEKOe7q&_nc_oc=AdrZl2KPmbdy3XipbV9kg6E4E1za3AtW-SHBIMXas1Amklg7IBHoBnX0GgO8rWUQjGI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5WvbTP_atNcIW3xdhocaTSrHO6NTxNwdJHiHo_FfsBA&oe=6A22F807"}, "display_name": "Smash The Beats", "keywords": ["music", "rhythm", "beats", "smash", "saber"], "long_description": "Smash The Beats is an energetic music game that will surround you with music. Come face to face with the beats. Play with 31 handcrafted tracks available in the game or choose your own MP3.\nAll you need to do is to feel the music and smash incoming cubes exactly with the beat.\nBlocks with the blue arrow smash with the blue tool, for orange arrows use the orange tool. How to change the color? Just press the trigger.\n\nIt\u2019s up to you if your controller changes into shield, hammer or sword. \nTry them all to smash the bricks.\nYou can play easy, normal mode or if you like challenges choose advance one.\n \nSo put on your GO and start the fun with smashing beats.\nIf you like energetic music, rhythms  Smash The Beats is for you!", "short_description": "Smash The Beats is an energetic rhythm VR game. Smash the blocks in time with the music. It\u2019s up to you if your controller changes into shield, hammer or sword.  Play with 31 handcrafted tracks available in the game or choose your own MP3. Put on your GO  and start the fun with smashing beats."}]}, "developer_name": "NiVision", "developer_privacy_policy_url": "https://sites.google.com/view/nivision-privacy-policy", "developer_terms_of_service_url": "https://nivisionag.wixsite.com/smashthebeats/eula", "publisher_name": "NiVision", "support_website_url": null, "website_url": "https://nivisionag.wixsite.com/smashthebeats", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477277164071905"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982686_2685113878204740_9093648463849062400_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0L8xOIdcmEMQ7kNvwFR-jLs&_nc_oc=Adq5pmHmmaU1P7Q9SAAb2iJcs5drYRy-vzLGykThe0T4S3XS4tub3KlzjVSgJHpZOJo&_nc_
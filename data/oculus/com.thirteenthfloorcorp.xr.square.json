962450592_6171269874321457152_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKW0s-QcOMoQ7kNvwFfGWKi&_nc_oc=Adq2JV0psGQOMr5zF1gx-FDf0-3V58xdJaBXj_YQErCZl1ALgT_mIe6b_u5bSjPLN28&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBhv6xFc0Up1xi7gDu0xmUxbp5krA2FegRCd9f0cjkeA&oe=6A941D0F"}, {"file_name": "YJ0uGT.png", "id": "717691965643809", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/86629764_717691968977142_1137987430872252416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlqXMAc_A-IQ7kNvwH-hxcT&_nc_oc=AdozmY_yTQfINWyFFkLufbKagLRyWIX21SBOFN6ruQ31ejCa78MaYMrpBrKkXYQBqx0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqILMAyIMk5hTN7F2jDoW4_U6AFuV3h4IE6OG5IXoJ6g&oe=6A9423FE"}, {"file_name": "ZNDT7S.png", "id": "2646658452327032", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75367593_2646658455660365_295646771059621888_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSUrQz2XEF4Q7kNvwEOTFX8&_nc_oc=AdrmUYoZ98Ahua_uATGCse4Js0m5okc161VRdRpfjrx9FhW3qVo4EL-kbZHOL9Ye_YE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAQH0U7itoExjI0REXLWkwRAnXjQ94fsaB1W1pB4iCtw&oe=6A943352"}, {"file_name": "3znoDD.png", "id": "604219800442483", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75488373_604219803775816_1002583600408821760_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTZoyjzJ31QQ7kNvwG-uAXS&_nc_oc=AdqHijwyBzLRaY7KUvIKCw0sHORZTiIn-W2M32NYHLALLtZ_ORozxHrmI4LRSK8mxBU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2VuT8aBhF6anvuFzJhhqSPWmhL6lKhx8HOdJte3lquQ&oe=6A9405B9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "XR SQUARE", "keywords": ["XRSQUARE", "social", "classroom", "conference", "meeting"], "long_description": "XR SQUARE allows teachers and students around the world to interact in real time. Our aim is to improve students\u2019 learning effectiveness in universities and general schools by enhancing class quality and extending student experiences outside of small and large classrooms. We offer virtual learning spaces that supports large group chatting outside of the classroom. In comparison to traditional video lectures, it has has been proven that education set in an XR environment will improve learning outcomes by more than 15% and improve learning effects by more than 90%.", "short_description": "XR SQUARE allows teachers and students around the world to interact in real time. Our aim is to improve students\u2019 learning effectiveness in universities and general schools by enhancing class quality and extending student experiences outside of small and large classrooms. We offer virtual learning spaces that supports large group chatting outside of the classroom."}]}, "developer_name": "THIRTEENTH FLOOR Corp.", "developer_privacy_policy_url": "http://thirteenthfloorcorp.com/index.php/2020/10/06/privacy-policy/", "developer_terms_of_service_url": "http://thirteenthfloorcorp.com/index.php/2019/08/23/termsofservice/", "publisher_name": "THIRTEENTH FLOOR Corp.", "support_website_url": "http://www.xrsquare.co/", "website_url": "http://www.xrsquare.co/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "487476402763639"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031564_991416651380070_8948803900799310191_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTguHh2t7_IQ
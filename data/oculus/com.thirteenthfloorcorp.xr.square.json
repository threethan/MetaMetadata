962450592_6171269874321457152_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7cVL9j74ooQ7kNvwGwrwkU&_nc_oc=AdrxZ6Gts5ZPCyZw41Vy5c9di1LKP-o6suT4j1L9dJQ_E90EbiLwDz5C3jR9D0USJrA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBv1n5bQL9Wy3d7_r5Td8AHrE7Px-sVSzXZcgtaHwsk2w&oe=6A6F330F"}, {"file_name": "YJ0uGT.png", "id": "717691965643809", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86629764_717691968977142_1137987430872252416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omXD_hu8zqQQ7kNvwESgbtH&_nc_oc=AdoCXwjhNFFDVjRfoWCz6cejM3Nqh3pLDHO-X1t968DqGvf3uMPi75Jp6WJ3_017wYc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCv39ILJHgBTyPuHTVOIaESyjpEhd64vRnAOPzQWVWSXQ&oe=6A6F39FE"}, {"file_name": "ZNDT7S.png", "id": "2646658452327032", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75367593_2646658455660365_295646771059621888_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEwQN6OQr_0Q7kNvwEHWD9d&_nc_oc=AdrIux2UpzDhSpDmidt2b5UiKy6qEdDYIGMyZJ-sHxcq1nH4o-XolyUYXaCaUbOC2ro&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCizhXZiyd37JRGJzjQNqwaQ1UmfuopjCcQ7Pw2KsTerg&oe=6A6F4952"}, {"file_name": "3znoDD.png", "id": "604219800442483", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75488373_604219803775816_1002583600408821760_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GpoQLSE93cQ7kNvwEP4arA&_nc_oc=AdqzXR8GGdsLJyIPgc-cBWn11Ifm_aSRHO1VVJPBWCShFjW4aKPKntBH5KWWow9RhsM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPM5Dg6OKlrL4u0CqAqpDWt7e8MY8kej_U5zWYkJKjyA&oe=6A6F53F9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "XR SQUARE", "keywords": ["XRSQUARE", "social", "classroom", "conference", "meeting"], "long_description": "XR SQUARE allows teachers and students around the world to interact in real time. Our aim is to improve students\u2019 learning effectiveness in universities and general schools by enhancing class quality and extending student experiences outside of small and large classrooms. We offer virtual learning spaces that supports large group chatting outside of the classroom. In comparison to traditional video lectures, it has has been proven that education set in an XR environment will improve learning outcomes by more than 15% and improve learning effects by more than 90%.", "short_description": "XR SQUARE allows teachers and students around the world to interact in real time. Our aim is to improve students\u2019 learning effectiveness in universities and general schools by enhancing class quality and extending student experiences outside of small and large classrooms. We offer virtual learning spaces that supports large group chatting outside of the classroom."}]}, "developer_name": "THIRTEENTH FLOOR Corp.", "developer_privacy_policy_url": "http://thirteenthfloorcorp.com/index.php/2020/10/06/privacy-policy/", "developer_terms_of_service_url": "http://thirteenthfloorcorp.com/index.php/2019/08/23/termsofservice/", "publisher_name": "THIRTEENTH FLOOR Corp.", "support_website_url": "http://www.xrsquare.co/", "website_url": "http://www.xrsquare.co/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "487476402763639"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031564_991416651380070_8948803900799310191_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_rRg_VxlcMQ
5_647669962450592_6171269874321457152_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70YJ_h9tG8QQ7kNvwGhoqKe&_nc_oc=AdrVJ-h0xKpT_IVC8bh2ei9-wMeQsBTTXOe45fzyIMzunRqEo_K5u9fhFT4nzf08o_4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHsUdxd-klYcqVKn62DrPR9oyogmT74z4pOA42MKoPtQ&oe=6A8D858F"}, {"file_name": "YJ0uGT.png", "id": "717691965643809", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/86629764_717691968977142_1137987430872252416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRXMk8S-tMUQ7kNvwFQ_7ov&_nc_oc=AdpBC8zjPD-tudcjF_BxvevlAoYssKeUi4E77nQsVI2yR6Gr89GF86duucjF_i2Xgc0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfmLF__2LvgaGOt_iI0XNmsputOh4voGN7Le5hPS9LNA&oe=6A8D8C7E"}, {"file_name": "ZNDT7S.png", "id": "2646658452327032", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75367593_2646658455660365_295646771059621888_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pY-WT0CnKMQ7kNvwFAyGdP&_nc_oc=AdrmDayrNKTPGa6pa6IktAeKNwTXLOb7nwMSV4ICoprAZIB4UA0iUWtt1YuL59agReU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGa7Hq1aZ-fuO5O_rkwU8N85KF42JNAv4WD1UEQ_qFd4Q&oe=6A8D9BD2"}, {"file_name": "3znoDD.png", "id": "604219800442483", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75488373_604219803775816_1002583600408821760_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMNVacTTLo4Q7kNvwFH45Y3&_nc_oc=AdraIoPeS1yAI_gEaR320rqvYq4jFAuBO1TR0BJ1KBggGDGqm31rag84s7Mu74QaATU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0Qh-imIINAA3SnT2kysvwIMzTP0BNUbZhXz_wpCDANQ&oe=6A8D6E39"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "XR SQUARE", "keywords": ["XRSQUARE", "social", "classroom", "conference", "meeting"], "long_description": "XR SQUARE allows teachers and students around the world to interact in real time. Our aim is to improve students\u2019 learning effectiveness in universities and general schools by enhancing class quality and extending student experiences outside of small and large classrooms. We offer virtual learning spaces that supports large group chatting outside of the classroom. In comparison to traditional video lectures, it has has been proven that education set in an XR environment will improve learning outcomes by more than 15% and improve learning effects by more than 90%.", "short_description": "XR SQUARE allows teachers and students around the world to interact in real time. Our aim is to improve students\u2019 learning effectiveness in universities and general schools by enhancing class quality and extending student experiences outside of small and large classrooms. We offer virtual learning spaces that supports large group chatting outside of the classroom."}]}, "developer_name": "THIRTEENTH FLOOR Corp.", "developer_privacy_policy_url": "http://thirteenthfloorcorp.com/index.php/2020/10/06/privacy-policy/", "developer_terms_of_service_url": "http://thirteenthfloorcorp.com/index.php/2019/08/23/termsofservice/", "publisher_name": "THIRTEENTH FLOOR Corp.", "support_website_url": "http://www.xrsquare.co/", "website_url": "http://www.xrsquare.co/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "487476402763639"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031564_991416651380070_8948803900799310191_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc
962450592_6171269874321457152_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvBV48Iw0P8Q7kNvwHOG1HT&_nc_oc=AdqiHkn6RRL-kRDrrZ4p5B44Hmyn3hrhATckmjnJtDsPMKtE2fwdGbiMqyHs5vEoh1o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nFfAiM8YTkLSNaks3V7byjdW6J0uAKMvMd8Xmuqsbgg&oe=6A2445CF"}, {"file_name": "YJ0uGT.png", "id": "717691965643809", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86629764_717691968977142_1137987430872252416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6vBQ8sv3CMQ7kNvwFnVWvY&_nc_oc=AdrIjGuvvR4NgxI258BubtLXGJj_yvL20onyBj44B0V24jidgrUSy_RkdRnQMqwjuKk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af945gO5V-R55ERbaNrfQskDM1rFx-n1Dq9jLl9rx5sm6A&oe=6A244CBE"}, {"file_name": "ZNDT7S.png", "id": "2646658452327032", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75367593_2646658455660365_295646771059621888_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bzah0fXwC1UQ7kNvwF_5gKH&_nc_oc=AdpJAtU8eJ5XDnBbtZtE4gLTomgeLyePMzogqB0a_4dCG1hoThL_AapiXj8GcUzLYQc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bXJGuO2s1eeupZ6f4TjKfnRXqecn0JUapuLarIiHrLw&oe=6A2423D2"}, {"file_name": "3znoDD.png", "id": "604219800442483", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75488373_604219803775816_1002583600408821760_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ot3KVV2xt4Q7kNvwEVHue7&_nc_oc=AdpzOaJUKqTrE12dquu46Ricj9x2dWHugrknmjGCRsCXQXi0zOHO1RjJPwPELWXWF_I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SFNB7ddrpIOeEwpVm9drNoGpZdpGrfEEUl1eoaZBqtQ&oe=6A242E79"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "XR SQUARE", "keywords": ["XRSQUARE", "social", "classroom", "conference", "meeting"], "long_description": "XR SQUARE allows teachers and students around the world to interact in real time. Our aim is to improve students\u2019 learning effectiveness in universities and general schools by enhancing class quality and extending student experiences outside of small and large classrooms. We offer virtual learning spaces that supports large group chatting outside of the classroom. In comparison to traditional video lectures, it has has been proven that education set in an XR environment will improve learning outcomes by more than 15% and improve learning effects by more than 90%.", "short_description": "XR SQUARE allows teachers and students around the world to interact in real time. Our aim is to improve students\u2019 learning effectiveness in universities and general schools by enhancing class quality and extending student experiences outside of small and large classrooms. We offer virtual learning spaces that supports large group chatting outside of the classroom."}]}, "developer_name": "THIRTEENTH FLOOR Corp.", "developer_privacy_policy_url": "http://thirteenthfloorcorp.com/index.php/2020/10/06/privacy-policy/", "developer_terms_of_service_url": "http://thirteenthfloorcorp.com/index.php/2019/08/23/termsofservice/", "publisher_name": "THIRTEENTH FLOOR Corp.", "support_website_url": "http://www.xrsquare.co/", "website_url": "http://www.xrsquare.co/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "487476402763639"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031564_991416651380070_8948803900799310191_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZcmpOYay2AQ
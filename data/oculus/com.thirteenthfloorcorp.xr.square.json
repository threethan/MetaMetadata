962450592_6171269874321457152_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBBgjlz4ZZ8Q7kNvwHDBGOE&_nc_oc=AdpD4bpqNnHzEtsyeUQLP7N5bCiSMH1SVVK9mQ6O-mGxVj9TyOVJ5npC8I9YbTbeIF4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1Roc6NLTTEdX1SQPAbF3AhnPcSDKsZV2m8Nxd1hcTlA&oe=6AA29D8F"}, {"file_name": "YJ0uGT.png", "id": "717691965643809", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86629764_717691968977142_1137987430872252416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6ODuv97AH0Q7kNvwHqwM8d&_nc_oc=AdpJCVoKQMhEZBNhtjw78ecPPN7tkqSNtZk5hGSYcqoPvUb8-6A6_kZNUc-g9BDUWb4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK35V6hkYLpxqOoI9jcYNzxXtc-fCWB4gM1TC8xgD089g&oe=6AA2A47E"}, {"file_name": "ZNDT7S.png", "id": "2646658452327032", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75367593_2646658455660365_295646771059621888_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlKoLe098mgQ7kNvwFzRIc-&_nc_oc=AdrwI9PMeCq9y3ZPl6nzJMhYiXiAmZ_uCZmkiJ6irj-coBAdMTunatoue3sA0KHlrk0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgsDO9wRGyvOkHxlGLXSfoo4O7Yl1b-LM3qhAKjEZuGw&oe=6AA2B3D2"}, {"file_name": "3znoDD.png", "id": "604219800442483", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75488373_604219803775816_1002583600408821760_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPJqWuL7Pw8Q7kNvwEqKzjg&_nc_oc=Adrh4rvlFcMaxMxtjfUZ4PXfHPTIX5FOigcs9pSHr2l71K-mUVJ6p56pEPkUK5idyS8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKY6G8XuZW_B-sxZ9xfbvMO-7I4FL72DpCB-pPr0ZxONQ&oe=6AA2BE79"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "XR SQUARE", "keywords": ["XRSQUARE", "social", "classroom", "conference", "meeting"], "long_description": "XR SQUARE allows teachers and students around the world to interact in real time. Our aim is to improve students\u2019 learning effectiveness in universities and general schools by enhancing class quality and extending student experiences outside of small and large classrooms. We offer virtual learning spaces that supports large group chatting outside of the classroom. In comparison to traditional video lectures, it has has been proven that education set in an XR environment will improve learning outcomes by more than 15% and improve learning effects by more than 90%.", "short_description": "XR SQUARE allows teachers and students around the world to interact in real time. Our aim is to improve students\u2019 learning effectiveness in universities and general schools by enhancing class quality and extending student experiences outside of small and large classrooms. We offer virtual learning spaces that supports large group chatting outside of the classroom."}]}, "developer_name": "THIRTEENTH FLOOR Corp.", "developer_privacy_policy_url": "http://thirteenthfloorcorp.com/index.php/2020/10/06/privacy-policy/", "developer_terms_of_service_url": "http://thirteenthfloorcorp.com/index.php/2019/08/23/termsofservice/", "publisher_name": "THIRTEENTH FLOOR Corp.", "support_website_url": "http://www.xrsquare.co/", "website_url": "http://www.xrsquare.co/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "487476402763639"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031564_991416651380070_8948803900799310191_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htQGxEzhvDkQ
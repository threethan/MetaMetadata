962450592_6171269874321457152_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=US6cg78IA-QQ7kNvwFGfhE0&_nc_oc=AdpAYkqR7T66_MWI9kShjWVofBNvGyi5VntYJ_72TFfTuQJM9bA6b8ykKlULgi7zZgE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oM9RLFDL1rQ_Zqg1J4L2ZLUlSOysN0quJZex2GQtBjg&oe=6A1C5CCF"}, {"file_name": "YJ0uGT.png", "id": "717691965643809", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/86629764_717691968977142_1137987430872252416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIgsrRmmJ8YQ7kNvwGn2sxF&_nc_oc=AdozfeC0NAqYxFBHV6vA2-G03Q6ozkoVfenwbipcWYRAHBwOjv0_11Ueq1cVmTdgGi4&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zYiUX6lWRMmTtPx-9AzGbsfzJ2qJYujVXTQl6-_CEDg&oe=6A1C2B7E"}, {"file_name": "ZNDT7S.png", "id": "2646658452327032", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75367593_2646658455660365_295646771059621888_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ca6zHcu_svwQ7kNvwFhdNXn&_nc_oc=AdrOx6oiQS42_p3XcrvTK8WiUPmyIk2T27Qmvwk1-KP-d1Q9bAbLisigghUvdSj8mCY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kP2ArD-zDZFcPSZ9tkVf2d0n_ZzX0CikzS54GrcB2lQ&oe=6A1C3AD2"}, {"file_name": "3znoDD.png", "id": "604219800442483", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75488373_604219803775816_1002583600408821760_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzQAbFKwQLUQ7kNvwEVD53m&_nc_oc=AdotLHO6Q3Jcn77UjTG8ZEqaPtC153w31UvzJaGZA4hXiB6WL1a_ec1v9S44JKwIZyM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60ykfRj0e0GosupLxq6XrjphjoKu02jcbMthB2ThBCFg&oe=6A1C4579"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "XR SQUARE", "keywords": ["XRSQUARE", "social", "classroom", "conference", "meeting"], "long_description": "XR SQUARE allows teachers and students around the world to interact in real time. Our aim is to improve students\u2019 learning effectiveness in universities and general schools by enhancing class quality and extending student experiences outside of small and large classrooms. We offer virtual learning spaces that supports large group chatting outside of the classroom. In comparison to traditional video lectures, it has has been proven that education set in an XR environment will improve learning outcomes by more than 15% and improve learning effects by more than 90%.", "short_description": "XR SQUARE allows teachers and students around the world to interact in real time. Our aim is to improve students\u2019 learning effectiveness in universities and general schools by enhancing class quality and extending student experiences outside of small and large classrooms. We offer virtual learning spaces that supports large group chatting outside of the classroom."}]}, "developer_name": "THIRTEENTH FLOOR Corp.", "developer_privacy_policy_url": "http://thirteenthfloorcorp.com/index.php/2020/10/06/privacy-policy/", "developer_terms_of_service_url": "http://thirteenthfloorcorp.com/index.php/2019/08/23/termsofservice/", "publisher_name": "THIRTEENTH FLOOR Corp.", "support_website_url": "http://www.xrsquare.co/", "website_url": "http://www.xrsquare.co/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "487476402763639"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031564_991416651380070_8948803900799310191_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYLw8HecS24Q
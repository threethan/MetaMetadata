962450592_6171269874321457152_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hyFf5pdsXkQ7kNvwG5sXVr&_nc_oc=Adpp7ClV7JWR7l9KzDm8aYLY7pPVV4ayIEC7_5UJiW1m4Z5Keq4GOiksa3Zi-A8-Z6M&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSJeLTJdK3QHSKVFOgBOs9v8-sQXg8YYStNKPj80edqg&oe=6AE36F4F"}, {"file_name": "YJ0uGT.png", "id": "717691965643809", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86629764_717691968977142_1137987430872252416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_HaDnM7tYEQ7kNvwFdNmwd&_nc_oc=AdqL8XMO8m1N9FP1zw-qPBYqOHhsvyXqvsY2tN3xYThAE10JuKib_NumDC8Ffg2YyBE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhz_2Y2z_s6jlAJWK0RtvB6uiGCPi0L5bl1prXCRDkFA&oe=6AE33DFE"}, {"file_name": "ZNDT7S.png", "id": "2646658452327032", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75367593_2646658455660365_295646771059621888_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZCaXHSWQl4Q7kNvwG9JO4f&_nc_oc=AdqRhDU1VG08eB5FsF0fPjwAgf2hxl9pGDv0CFSj2jF5pMr7IVPjo-Sz9g-HBUJIacg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOegL91pUzx3URY7Tz_i7-AmMoBEhSbTO6vc_PPXVem3A&oe=6AE34D52"}, {"file_name": "3znoDD.png", "id": "604219800442483", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75488373_604219803775816_1002583600408821760_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pu9l6vYHZZYQ7kNvwH7SVat&_nc_oc=Adpi-JNazUHtB3iZhHgkl3vHysfhaZUZK_mfAgbqM4R4npYI04T6hXHgqIpdl7xd4Jc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODkTc596SfXDJFPs6BvfqZHFNvZh64oV-nsCBn8Z36tA&oe=6AE357F9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "XR SQUARE", "keywords": ["XRSQUARE", "social", "classroom", "conference", "meeting"], "long_description": "XR SQUARE allows teachers and students around the world to interact in real time. Our aim is to improve students\u2019 learning effectiveness in universities and general schools by enhancing class quality and extending student experiences outside of small and large classrooms. We offer virtual learning spaces that supports large group chatting outside of the classroom. In comparison to traditional video lectures, it has has been proven that education set in an XR environment will improve learning outcomes by more than 15% and improve learning effects by more than 90%.", "short_description": "XR SQUARE allows teachers and students around the world to interact in real time. Our aim is to improve students\u2019 learning effectiveness in universities and general schools by enhancing class quality and extending student experiences outside of small and large classrooms. We offer virtual learning spaces that supports large group chatting outside of the classroom."}]}, "developer_name": "THIRTEENTH FLOOR Corp.", "developer_privacy_policy_url": "http://thirteenthfloorcorp.com/index.php/2020/10/06/privacy-policy/", "developer_terms_of_service_url": "http://thirteenthfloorcorp.com/index.php/2019/08/23/termsofservice/", "publisher_name": "THIRTEENTH FLOOR Corp.", "support_website_url": "http://www.xrsquare.co/", "website_url": "http://www.xrsquare.co/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "487476402763639"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031564_991416651380070_8948803900799310191_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=il1qGmRZCqAQ
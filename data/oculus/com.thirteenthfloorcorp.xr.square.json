/scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75488373_604219803775816_1002583600408821760_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KCXWjcKNx0Q7kNvwFFCOeQ&_nc_oc=AdpEsS1X40O2Vb1NSV_4e6IFf7wJ1oDqSCb2J2jz3lZjeRaa4lngi11gIMLTK3AnMok&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BypqTiKolSCbieHRgwx8A0LnIn8fSTWKXtK_HiAwKVw&oe=6A297479"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "XR SQUARE", "keywords": ["XRSQUARE", "social", "classroom", "conference", "meeting"], "long_description": "XR SQUARE allows teachers and students around the world to interact in real time. Our aim is to improve students\u2019 learning effectiveness in universities and general schools by enhancing class quality and extending student experiences outside of small and large classrooms. We offer virtual learning spaces that supports large group chatting outside of the classroom. In comparison to traditional video lectures, it has has been proven that education set in an XR environment will improve learning outcomes by more than 15% and improve learning effects by more than 90%.", "short_description": "XR SQUARE allows teachers and students around the world to interact in real time. Our aim is to improve students\u2019 learning effectiveness in universities and general schools by enhancing class quality and extending student experiences outside of small and large classrooms. We offer virtual learning spaces that supports large group chatting outside of the classroom."}]}, "developer_name": "THIRTEENTH FLOOR Corp.", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "http://thirteenthfloorcorp.com/index.php/2019/08/23/termsofservice/", "publisher_name": "THIRTEENTH FLOOR Corp.", "support_website_url": "http://www.xrsquare.co/", "website_url": "http://www.xrsquare.co/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_ty
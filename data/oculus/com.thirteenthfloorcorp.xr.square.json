962450592_6171269874321457152_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpaYioo8R0UQ7kNvwGPl1PX&_nc_oc=Adr2d-qX93GywxVOqgR3F3_4pEfMRJq4Qi8d6_nEQGl6jt1I23IJTNgC7DRVXd-bkvM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1EJL4T6ZJDkyYTJnQsI-s39unrZgZJMibO8lotSmx6CA&oe=69F3460F"}, {"file_name": "YJ0uGT.png", "id": "717691965643809", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86629764_717691968977142_1137987430872252416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lISIEOFi0UQ7kNvwGvh5mU&_nc_oc=AdqJe7ddl-uJk2niXsW3eCRN3ZvloePzszZAbh2v05weuWSd-VQ1FUTSRkP67QtrnNE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1VVbFyQyXAxVx95YQBK5sYsa8fqw3h_USbEtNVVH9XCQ&oe=69F34CFE"}, {"file_name": "ZNDT7S.png", "id": "2646658452327032", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75367593_2646658455660365_295646771059621888_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXgvrOr3cTkQ7kNvwEPzwXH&_nc_oc=AdpTfv4WBckwO0zx3d3SOTz3hzsOngNp--ND2eNrm4MCyujOtjy7vU6r0L4QfTq5wws&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af33Le-TxVRKTeJ2Xq79mc6eib62lNVjUkY_p8Kwm6L3vg&oe=69F35C52"}, {"file_name": "3znoDD.png", "id": "604219800442483", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75488373_604219803775816_1002583600408821760_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56XqDqoX4Y0Q7kNvwG3vHYO&_nc_oc=AdqhBQop6jxZkVDP5jEpnKnIXdAKMiQoaNBevPN7q_vv4tBEsvfB3k73iWIhbRHeHa8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Reihr9-JdJfd9qWcy-f2Takt4aywNsGFlPOmyHws6vQ&oe=69F366F9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "XR SQUARE", "keywords": ["XRSQUARE", "social", "classroom", "conference", "meeting"], "long_description": "XR SQUARE allows teachers and students around the world to interact in real time. Our aim is to improve students\u2019 learning effectiveness in universities and general schools by enhancing class quality and extending student experiences outside of small and large classrooms. We offer virtual learning spaces that supports large group chatting outside of the classroom. In comparison to traditional video lectures, it has has been proven that education set in an XR environment will improve learning outcomes by more than 15% and improve learning effects by more than 90%.", "short_description": "XR SQUARE allows teachers and students around the world to interact in real time. Our aim is to improve students\u2019 learning effectiveness in universities and general schools by enhancing class quality and extending student experiences outside of small and large classrooms. We offer virtual learning spaces that supports large group chatting outside of the classroom."}]}, "developer_name": "THIRTEENTH FLOOR Corp.", "developer_privacy_policy_url": "http://thirteenthfloorcorp.com/index.php/2020/10/06/privacy-policy/", "developer_terms_of_service_url": "http://thirteenthfloorcorp.com/index.php/2019/08/23/termsofservice/", "publisher_name": "THIRTEENTH FLOOR Corp.", "support_website_url": "http://www.xrsquare.co/", "website_url": "http://www.xrsquare.co/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "487476402763639"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031564_991416651380070_8948803900799310191_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeMrHaZHmpUQ
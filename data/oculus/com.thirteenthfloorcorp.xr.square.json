962450592_6171269874321457152_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70YJ_h9tG8QQ7kNvwGXMp6R&_nc_oc=AdpEpkzHq1NjE8lMrT2eBB3JnumBNGe2dvZE0NsP9mcdkhyZGjRJEpi89a6nf9T6uOw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuTdy2x5N-yKTeV9pFKKKAJIhmE1dC3UQJOmAKVPsV2g&oe=6A8C340F"}, {"file_name": "YJ0uGT.png", "id": "717691965643809", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86629764_717691968977142_1137987430872252416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Y4DKNqDC7cQ7kNvwFRmoiu&_nc_oc=AdrlJnuygDWmhRzP2Ovk5__H5CjBVf-RRpJWYUP01j6K9byC11WR58p7HMwuNsYXc0I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEFj9MNz_j3BaliPcbPKIV6a2Qd5SdK5XYD8PSfl733w&oe=6A8C3AFE"}, {"file_name": "ZNDT7S.png", "id": "2646658452327032", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75367593_2646658455660365_295646771059621888_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pY-WT0CnKMQ7kNvwFt3rdV&_nc_oc=AdpTebx7PIhY_jg8ACMkF_XNYYqZc2GPKxxa-DqdUAQ1mzXyaKdb6q8bNgs8FhIiMWg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8_k9YhEIi6dyIFg3sFHYxH9apbPmOCpfAGGiuyBp4Rg&oe=6A8C1212"}, {"file_name": "3znoDD.png", "id": "604219800442483", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75488373_604219803775816_1002583600408821760_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNfcxM1aGwkQ7kNvwEcWQNF&_nc_oc=Adr-i0ApiX5TMtXX1WvZCCa8b1d5KB87gKMPFSE82JVAhqdnhpBKTJxj6vExO3ct6w4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJ16qz5B7czGxdmNpHnp9_nFN627byVUBVeyBgJw4EBA&oe=6A8C1CB9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "XR SQUARE", "keywords": ["XRSQUARE", "social", "classroom", "conference", "meeting"], "long_description": "XR SQUARE allows teachers and students around the world to interact in real time. Our aim is to improve students\u2019 learning effectiveness in universities and general schools by enhancing class quality and extending student experiences outside of small and large classrooms. We offer virtual learning spaces that supports large group chatting outside of the classroom. In comparison to traditional video lectures, it has has been proven that education set in an XR environment will improve learning outcomes by more than 15% and improve learning effects by more than 90%.", "short_description": "XR SQUARE allows teachers and students around the world to interact in real time. Our aim is to improve students\u2019 learning effectiveness in universities and general schools by enhancing class quality and extending student experiences outside of small and large classrooms. We offer virtual learning spaces that supports large group chatting outside of the classroom."}]}, "developer_name": "THIRTEENTH FLOOR Corp.", "developer_privacy_policy_url": "http://thirteenthfloorcorp.com/index.php/2020/10/06/privacy-policy/", "developer_terms_of_service_url": "http://thirteenthfloorcorp.com/index.php/2019/08/23/termsofservice/", "publisher_name": "THIRTEENTH FLOOR Corp.", "support_website_url": "http://www.xrsquare.co/", "website_url": "http://www.xrsquare.co/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "487476402763639"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031564_991416651380070_8948803900799310191_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDp6w_V8goUQ
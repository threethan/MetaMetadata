_ohc=5uGu6qSrhQIQ7kNvwH1hZtR&_nc_oc=AdqWujbv7wBOHG0uN8CDMcVH5MaxxxSBm8kuf5FzmfvApEIe2mvS3v6F4rs4KX_TWKk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rJ0AM5j4EH-RDYaqLxkogRSOZ-AfH52hqHVe22eEGdw&oe=6A26CD7F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9N3lgwSUucgQ7kNvwHRleFe&_nc_oc=AdrfJ-B6ah4Ar4TqYX-SnbC-wd8aVRiJCtb0Kv9sa6NkE881naeWpbqSqL5eGMUFtm8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83LUObn4soERT4HhfW5yhfbakGUb6t6GmNOcFXBlGiKg&oe=6A26CA07"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJ3Cq0zirLkQ7kNvwF4LMCy&_nc_oc=AdrjAHJaOz-PII_uOOhP5h9t29zKVH04m_noLs-hbD2WGQlgsZ6UcooAFWiCmWDhVVc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97xALLp4FnBmabasQRKOd-EbtpX877W3VXa3eOCZA8SA&oe=6A26CE5E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3FqVtRxqCkQ7kNvwHqjOWQ&_nc_oc=AdpCLK8okDSjDMBr2BFSNguuQI7M7gUW4HCQRqnYGgavNigIEfFHSkaWootFWcHpLiY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BuufKBrp6MgQZX_Ye8hN3ccq4LOhEpVsOPKakLM1zAQ&oe=6A26DF12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGuHwAdgrKoQ7kNvwHBpIf4&_nc_oc=Adr34u0gR1nhte9FqQ4WHlQJdM80VH4JBDncso4O23iPsVDibRrQUmJUpHoM-nVJqMY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5LgvPLe0tuMQ5E2mT2mGxoltv-8DI6u2FUSOjDkDjgA&oe=6A26D0E8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
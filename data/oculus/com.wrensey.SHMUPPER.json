_ohc=G95IopF4PpAQ7kNvwFH07BZ&_nc_oc=AdrgO2iMgmHjGuPeTOzjJpC4a-37zavZyh_4Zt5ny4nJmswne7p45V27r7YBHGwT6Xw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94_SYnlbeKSLCB9uoYobxURLhZIzvgM_rENtWg0UHRSw&oe=6A31597F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RtbslWaEwWMQ7kNvwGS4t-S&_nc_oc=Ado2iITnsQbHug7Bfev1NTFMnXjI3m_0Q6r5o_RiK9stnTw1qSvlI-33kVRxMP-M3j8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hW08gsdhB5NeH-dnm2PUZEzlpaLmAJsh2JIh88HIYKQ&oe=6A315607"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RtiuKVeWo8Q7kNvwEUbYxv&_nc_oc=AdqcM-5SaEA1eot5Xv4JYYL_UFJGVERy2oaSSLfqONlzWU8WMCpH2TD1WFYUTzJourc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9F_eT26rvyKEx304trvDhAZ6UnmI5qvkzdGxEMDi9o4g&oe=6A315A5E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IbmpVD0k70Q7kNvwHPKNIU&_nc_oc=Adq_zm059YZrhsL-xmSNC3J1qmpnr5Yo8Ybq6qEhOcGILMSqt3KjcFdKIxXDrmxX2KU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dcdoBN4VHNA7T7IMv055VutDgpvP9Ed08HbkikrRkbg&oe=6A316B12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoBSH09Y6RcQ7kNvwE_y6sa&_nc_oc=Adpx-ZgiQ3JQ91hRctqZ7KafbewO4-7HtDoaLj5ztv920sUlYMqG5-7dGk7n3XeEnm0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3R0xKKXqoRG40HVWyoumKiPBpTPBoW140MJ0TVKFjDQ&oe=6A315CE8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
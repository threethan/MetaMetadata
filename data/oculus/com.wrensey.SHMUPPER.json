_ohc=mSvqPpccLh8Q7kNvwH9OChh&_nc_oc=AdqjyT2IuQ4TdCDQEZMaCMgrCCH72gZmv3Nt0C0qO89KojozXAf5cDj2Aq_InEcfCtM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5fVQjRNX_3T51_OKi-iusA5z5UtnEyALBcAi1ff5wog&oe=6ADCBC7F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsuVTIvuD6QQ7kNvwGrxVQ5&_nc_oc=AdqzFH55zSpu57fFUWD2Mq16dq0PY-Oq1z7VcgcMuwFnawkCBnrZYW-42GGmdO4YDas&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMijMNBI6hdm4cMDiFSZbQeB0cASlFYP2NyFTiDk1yakA&oe=6ADCB907"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeDMrfS8Ms8Q7kNvwG53Mbb&_nc_oc=AdrdyIm7QEJpSdPb8mb1NDjjXUAjOkFRbQ1u5HSKI-0SbYJV6GubqdFVdBrwcXQBXfM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpACmg9WagT_mqz-ihDcnOQkToVmqitppSONvRtcvJNg&oe=6ADCBD5E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWAx8Mj4eewQ7kNvwFuB-Tf&_nc_oc=AdpKxrDRQjopJQoiWuLg7ms20P0GEJm7lnaEeQDCvj97B4TuRqlkZP_af1y80yiuYvA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNR3sbJOBKE_sLMEyhFhCXCo9F3-8v8b1_cqTkcaBee5w&oe=6ADCCE12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQpIx7l9-FEQ7kNvwHPKvMh&_nc_oc=Adqzx3MnPNHPN4jWO4K45LFeJie2x-if0Xx5crSBR8oIZ4fCgGfxtARkHXpBIfyD5MI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPOB3vOiS2OzCk3I-6UDFNjxFPpN1PoNG26pjMcrx_Gw&oe=6ADCBFE8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
_ohc=OHy3GOuZIY8Q7kNvwFR7Ea4&_nc_oc=Ado1yKNjdbL2DXwRZYXOXqe1JaMjr7g02ernLgp0AHSBiTaj1V6MJNNLzHSC3FlBZwg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31kxP0-0NgrWwHtsebyHl06uKiE9VaZd9O53rRAY2VxQ&oe=69D661FF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fi5UvIXVzEUQ7kNvwGffixi&_nc_oc=AdqR4e6YAgGG_aVyNdnooiNaDdwEXQZtBOcDJZZdxbIGc7hGmUVlBQMkwY3jgHj6Rbw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ifZto2GaDKNR9Z395glgdChOgl6uoK_v7-cnNnL2_jA&oe=69D65E87"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxumjM7yU_wQ7kNvwFvt7Zv&_nc_oc=AdrOy-GKg4RFYiUPAPr3XdqdjHSFuatRIt3Bs8M6mZ0_BAPwOq6D6sipI4Fr4HCynac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2e8q5x1dRmp8BRJrpvPU5jFqbAfZoBuEU_ucWtfWp13w&oe=69D662DE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXqg9GdJD4AQ7kNvwF9AfoL&_nc_oc=AdooMeXaqr5p2xROn1CSNIA4qpewvowabTmKK6FJq2AvHIIZ9pXZn9nHr7vDBJSIyjQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cYTVEckM_HPzXMzRSz8T4WQoAD9JyTJIrUhJMRsBl_g&oe=69D63B52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sK2HZUEDco8Q7kNvwGeve6E&_nc_oc=Ado06jB8LDbWy-nq49rO4lNpboTTa3i8DGRYtAzNHP02Wr3oGbPbvZYrUzb63_cuFEU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vGjV28UCKdqy9BNm5n-J7WLTu4kkiRuCW0FdeOBb9wQ&oe=69D66568"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
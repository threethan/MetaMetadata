_ohc=50wDkh7IZU8Q7kNvwG0L-oI&_nc_oc=Adp-KFd3FlBKJr4jZ28LXkokfc8WeKLM9nmV4TIkXqpjCFPI5lE4tBrai6recAH3bfM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af38tNdsySe20sap0d19aJPn8nR4XztNVNmvOykOy4CI8A&oe=69F4B47F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsxNj-hCuW0Q7kNvwFgK5VO&_nc_oc=AdpuBCxIVR7qqUfkyY3-QLz0D7Mm4HN_pqUhRrtFyeD7HRAH4Vgkg50dmJQsIX9Qtsc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0o__6n55HJgHSvz2fY5PQYz129_clV4vRtjEpI6o0oug&oe=69F4B107"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQJZ3CvSPScQ7kNvwEB1SW5&_nc_oc=AdrVl7qCmw5a5W02GIPk2b17rRUskaElzWE2ytsJLJ_Y_JOQ38eBGAPL9O63RswsG_g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2gKqUKUu2XEjECCmFcE168Pp7gGtW7kKLVcOOqyN36FQ&oe=69F4B55E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnide2h6NlAQ7kNvwGRNG0I&_nc_oc=AdqbLh-_a4P1eHrxCfMo3Y-v2gKTRavExXqRtV8qnoz4Bpc3jOL60Yy_H8HUT4q4MIs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2BgfZkoz4Z8yIwIkIRMshjgduX6hrMRhqf8Zt0YyDFGQ&oe=69F4C612"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9i99qstTL0Q7kNvwHXHIpJ&_nc_oc=Adp9xJvHgOzV63bo13bmoPONozcw7u2X7U9emAUBYyLk-oSo9HFO_XyBj0y1gvdiZJg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af30oeY_ECsEEc-G6yy7o2rydZC4svdbQ-yIpXSJRV1Nnw&oe=69F4B7E8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfumobMRbmipQgTD_7NK0kURqnTxDI1psgU7awD3hbfySQ&oe=69A448FF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPIvuIFi4ckQ7kNvwHIMwCE&_nc_oc=AdmV2mD4M6DFCPrAvsCkdH03F6DhQSdMLQnXmL6soeb1gXsO6DwlFdiam76YfVYP4Sg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsKe3rrzBkdrDfhswDVtTPWz7e88m7wK2jvkkY71Qfi6A&oe=69A44587"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ndn-xHx6g9EQ7kNvwHs3gdo&_nc_oc=Adll4Kdx6A2_ecFiZpLkIWdrIoTJp3WrivxBe2F1KqWbuaKWUSUDddfLlTZmDQ9EvtY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvADtEPPf7ATf8trBTkWeP04r3h7NfMdZySJYsL_Ndg3A&oe=69A449DE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikAuj-2SxrYQ7kNvwFEgVab&_nc_oc=Adkb5Xma-SRQVM4rXnNklQ2KEmTlRoDYCXALlWk3LdzLVPffP8hQtyrmrgacFp6wPtw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftB9Qi5yE0h3wu1apJtR6Owl1T2zliwN7gQijvcQxQlQg&oe=69A42252"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpJAl_RFIzAQ7kNvwGkESxo&_nc_oc=AdmyuQTU9A8p91yTd6XkDVz82AVMYvhAO-3saHlcR_eqjOT8bEVtuHTGH04AdESpJ_k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftxb-Ti4iwxN9VB4SRZEWsd6cafARtYiLUbGCN5eA3rGA&oe=69A44C68"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE
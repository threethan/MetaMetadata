_ohc=uGVURA1508AQ7kNvwHaUj9i&_nc_oc=AdpyQ4UXUk3FA-VS1jCcGHuPPqioCf7OLp72oHlcAwrd530PmRwfp7gVTYJE85spnvU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUUtVvbWoCjn71lOoMYiI58tDwPikSGJMJmSpynT0hlw&oe=69C7E17F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WBhLTbxLssQ7kNvwEAg1JX&_nc_oc=AdplWXTvjlNdjL19ClD9JBlInsOArcxOn6WCGNswLhgjHRDCfGer3zCpHqT_G-vPcyE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_ewnrqlJjb5M2G_PZbPG_lM7FhBNGYIE3YHLTy0WnjA&oe=69C7DE07"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_w3Zt3jadsQ7kNvwHe5XwH&_nc_oc=Adq1sMBgq8L9oAjrklkjYFqSO1OrbrAG7Uqoggnc3xFUNajSYTB68geN5Cd-hnJG18A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzIbYxILI42r8ox4NV5t8NM71OlG96RTrEJQxWkzmGWFg&oe=69C7E25E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sUoCx5boiUQ7kNvwFs4qBK&_nc_oc=AdoAHg7eZkXBKUkMx7i9uvHvl6aw8RFfUVx5GN0hAsJAEoLih3CECdB5zUWnSLX5w0Y&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwU5qL3UlB4Mrd7gXSCdAjPu4UfJwu3TPb9IcGAGPME9g&oe=69C7BAD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57W_Q0ehYg8Q7kNvwG6mldF&_nc_oc=AdqnA5VTn0iDZaJA6l2l-7hmDS-D_8b9ASIHe3q5QxT20a8wQnMKsbxgrzPec9Dlgts&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQCfCykN0QMoBXyWpKe9Vb0EmAC9i-uAZgr7_dgRrxbw&oe=69C7E4E8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
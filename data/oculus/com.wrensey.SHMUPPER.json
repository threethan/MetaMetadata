_ohc=5uTldAh2H5sQ7kNvwEBLkyj&_nc_oc=AdppQNGHXILxl_-8FhCHDJuTYVb4RJxPeVIi64oEo7l_QbqhFsEP9EuMcaBZCcZmQbw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM314tgo1-0JbRbmaS7x5CGttJyV0s5J8esbyOKWFyMkA&oe=6ACE3BFF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6dtoWjBNzoQ7kNvwGi-lMA&_nc_oc=AdojHLHMA-iBOXRcZYNqzcp9QhprXvYRLm5nf3mXxqyYVvmMcnb06biVmPfW9gq0iwc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHG5ScuE74YbY2HK9ux42SY4pASqpst6wIOjXmsJ_P7g&oe=6ACE3887"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBuqFwGQBiYQ7kNvwGvNT7n&_nc_oc=AdoDQ4F9vSPaKaauLlT0YziEi2PtLtNTff629l4DkSUeDVI8CwMO70R7r4Ef1AILEs0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXqEzlfykzq3aClyjy3MAjRdUUyRddQ5vETKRILQ1j_w&oe=6ACE3CDE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52p-h6SRn_YQ7kNvwGbiBo4&_nc_oc=AdrPAuUTYCKYnHE-ZURA0voJqA5RHVOvdGKX4_uIyLlrtaa1ucd20-trQnyq3duAugI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqXp5l0mz8sFydAovGUCkspYGnSAyHDA8LqgP8-7_8Mw&oe=6ACE4D92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5Yj2dyd9D8Q7kNvwElDpRu&_nc_oc=AdpomwkWhc6lrUPYBMOVP7mAx7o8QqI7a3L6x9OsgyegLyhnCf8ui2c1VdFkoITUPgk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTq7EGegdzMMvmlPTk9DGlpvnQVxWL0AU1bCtHih5sSQ&oe=6ACE3F68"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
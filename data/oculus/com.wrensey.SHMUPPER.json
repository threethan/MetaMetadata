_ohc=8Z-itfY_Jx8Q7kNvwExOQ2S&_nc_oc=AdrvxGY5WIBQRATfg8LmRxjFbUYPZsgpdYSJ3xtRriOvAHYrwIl1z5FqQE7w1u9tUVQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IMKMBOTWcb4JKXVlsXt_dasioKxdDMluUmCRRINNNsA&oe=6A1D92FF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-MQ9kFiuncQ7kNvwGdAn1K&_nc_oc=Adp1yyVFuAo4ftxIyrzd-x_KUS9NrXLnPZY9TVn8MWxoFSZMjs3dK_E3OUeMqKP5npg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GlLrYv9Wwni2tkpp7vGcUM5MwnScjgZ0mIXU5hwr5EA&oe=6A1D8F87"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLJqweilExUQ7kNvwFTLOTH&_nc_oc=Adpa49ywrgm17qx8bUiD8jKXa4sjYhIAoTuregR-ArXHI9QsWtyLXnKno2sEXWm2L7Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_pzexGd8k8nPFSjhZtFz_JCzTO5M2E1xEkw86BfOHjQ&oe=6A1D93DE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_I66_djpPkQ7kNvwG7YRAu&_nc_oc=AdoG7d40qChoGwHDQuIxGpQxmYu1yDWUSbmXOVR93juTeyHhsm3XOI1pjvQrwMka8ro&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4D1KItl4EL1iek_o64YXc2pIZEP2xwUS8p983gmAaQdg&oe=6A1DA492"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aCJi-bDUtUQ7kNvwFmC7c8&_nc_oc=AdrNW8-lRxCzg1gBtVxPc54K2ps6iDNQM9ZVNDtkmeSjKAj4JzbBeoOw19tYBZ_Lcpg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BTjpq8XCcAoy1KT9sr-c1tEZ35aiOKUSQDtnpA6yO9Q&oe=6A1D9668"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
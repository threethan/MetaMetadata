_ohc=Ohy0ylVW0SQQ7kNvwGYxTc_&_nc_oc=AdrCITWynMlsO58jE6WJ4wZPtyD6KtAENKNHGJFQJU6Y73vPDyrD9GcpgB9FnS_w9EY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9P6-o05qW23rSx2v2U20QlVm-rqOrI4G2-_2Wydo6ZZw&oe=6A2D64FF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qD9XbTev5kQ7kNvwGvXGCH&_nc_oc=AdpVi5_wMsLAQGPALlDax3OWNTxxfbIP4e-m3iGpPJGIJa3QwrCaBruwJzOVZOK1FMM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_efhkYIMMxhsDiP3rypnSCvTePmln8s2f3Q8M2rRkhGA&oe=6A2D6187"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rR_U-J9r_1YQ7kNvwGIaPuC&_nc_oc=AdoEh6G85VFL5Rn3ohKRRIbYp5EEvSHmuv72cJ7TV05mzqsiI_8QLLN6pJwsU7E0Nc0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MNkyUPFcr53GLT9eglvzvXR2Ou-qErM7BiUgJNvdMNg&oe=6A2D65DE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAitmn0DwqoQ7kNvwEENzzF&_nc_oc=Adr-F_yOzp5b0nuNX_SGEalVKrhKSeFUXbHlTnQK-cARsnRRPMUmefOV02GhVC8v9vI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qX0YY_n3Frun3QKd37nei-JHv38Mao-SMNPgPz3QXiA&oe=6A2D7692"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDJeCDgwe7cQ7kNvwFs_9Du&_nc_oc=AdoXSN4X0Rc2wFXocRt_CDYPS3buNDW0S6o_fM-Cl2zOqYmERDWRH9w25q80s2oLMl0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QHrzcgFHO5AMbSeKC5PZDeuMnro69UlBwwe1fEUE5Sg&oe=6A2D6868"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
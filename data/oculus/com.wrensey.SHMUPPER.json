_ohc=8Z-itfY_Jx8Q7kNvwHcAffa&_nc_oc=AdqIhp7PqsPm2hszf_TJwyoJ0wRX1Clyo2P1nH6_1dfIZc1RGafTEN7U03ohPykC_ts&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zvyqseOij1pRWDaoIhn91NIZIGy-lNiuqb5h6yZOtAw&oe=6A1EE47F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SwQTdVLZqkQ7kNvwGGj2qs&_nc_oc=AdpYcR13KIyuhUPkTkIYWv9wCuuGiyxrM689zKx7OUVp6hInOQWwQ-yMVZZo2lHMJM8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YOC1m0-0tAc7DTspKssGsF0gQiTM7Y7s6ZI8Cz6kUUg&oe=6A1EE107"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLJqweilExUQ7kNvwEdv_o5&_nc_oc=AdpxXNvZnqg1n46O0hHJ0T5J6GtWxmq4d1keMV9C5pLezTKG0K1C_4KVAYs7njG8p4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WrHZTZ8kvLLEIP48PiOa6EibAMzTMZNQ9W0p-5mnLUA&oe=6A1EE55E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_I66_djpPkQ7kNvwF3Kb-Q&_nc_oc=AdrSWTQhKuXPoQ1JCb5ZyPfkTSL4pSkQ3jCVbNRku04cpwOHoRwq3A8J4Xw9nGG_Mn8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6t2B-VlW371l-nGwcgZXfj-Jx5sXMwQ5UCu6h0x_tlkw&oe=6A1EF612"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aCJi-bDUtUQ7kNvwHh4UR4&_nc_oc=AdrYdissX1uPpMTWCgOpWJdAGKRZU51wy-TtDxtpn9qiezczMw8SF-85uUGWfTjbEAU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af761OeRjtD8ubL0Eieu3PYLu62bjBosLzPiCLhTTJC2Bw&oe=6A1EE7E8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
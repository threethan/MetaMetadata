_ohc=_VdShl58FoMQ7kNvwGkZD72&_nc_oc=AdrOhzSIj-ayEfQuL538qttOJQBabzU2jsNnscTBXzzgkfr-UaitQUgvzaMwH4fQjcU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxjLL-AvUc-BiKQsqg1716iPI3-jGrTGp1u4ynQ7SKQg&oe=6A4D08FF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OE381cU9oRUQ7kNvwG-DT8D&_nc_oc=AdocFwjXYzlGXgQW00MqtNmmhi6lgShKKuvrnUSxo2xf6z_lKzFELvaNGpOJJ6SblT0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfr_w-x_1KihF12OsYPg_rR3gk9hDORJcoxEK8mkktAQ&oe=6A4D0587"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIZxSJsDlqUQ7kNvwEdyy7L&_nc_oc=AdpktaWGnsehsQMch_7j4dwRWfoeq-cTFmvmuIhIakC9ilxXPPzUbw6UbnDasUbh4Z8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-zVvbTYnOPPrI81WOLHZ45vPpnW3T5ysfIY2LwrgEWg&oe=6A4D09DE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nBKfj7MT_gQ7kNvwGjqP1s&_nc_oc=AdpIN-EQ6Uz2Pqn-d1bY53bZIAxrv1hZAnrn0I4rA-1YlSYqFXdkfhDNeLOe4kMry9w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5URaVVdv0w4-54hrgrllXPq9LtkrCY_eZu94PEMrw0g&oe=6A4D1A92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y77rnBAAiYAQ7kNvwFtPJoE&_nc_oc=Ado9VqU4YaKRYkfE22Eb40l3qcEKGLba8pBy3zr4odGRkZc-lIPv7F1LwIJetqAbcfQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAbfyUnbxCpxzA7Kz9nIRVf0UwGWUjmih37vFHMZLGfA&oe=6A4D0C68"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
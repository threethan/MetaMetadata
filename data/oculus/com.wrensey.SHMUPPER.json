_ohc=ird6OCIluyQQ7kNvwE1x5Lu&_nc_oc=AdotiZu9DvZmQzz8YHnTc2gPDRuFKB5SmDiNPJBTxj9vLkyfrKZJgxUFKuC9_lwyQf4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Uu0isjCAzAtrN_2E_-oZJqXy7rwA1K39aGkMeVe5PtA&oe=6A3BE57F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLCITlAGUncQ7kNvwHdlnDr&_nc_oc=AdpmqVhes4vkERQu7yt7wmoHXgk5L5quoOPOwpDr0yH1aUv_7G4eAUIIKqc10B0PDW4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TJptAlxyv3vebVlEJANdDBV5QvcGSVNfy4nqQaBFRxA&oe=6A3BE207"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlECTaUNEg0Q7kNvwEXtgSp&_nc_oc=AdppieZFPRHBOOJYBHZRnv4oaTz5kpkmBJ4eISN1PA1KD24AOnRqQ-T2xClb-lqq8fM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kD9-7uiBa__-zuJU7_pZvwe98-d35H6q8u8jQlpZT-Q&oe=6A3BE65E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7C5yb5Dc-cQ7kNvwGGkgbf&_nc_oc=AdrSie8qZn29A5TWMo8FsA-RXZVae9f3QXwwC5HK2ym-XUhc38VYZbxq9qIL8ugs1GM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fH_odOjA9dBcwKBweoKjxj7Jq9tLBS67jlULqgMZ98Q&oe=6A3BF712"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keYpGa6u6ZwQ7kNvwExefAh&_nc_oc=AdpXYXA25iuVtjVvSCaahCXXGi_IDSFvfCbtjDLCJfBwQX458G4uJ9sNB2cXVVQNFNw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ftFJ6TM2CV56xCJYprft9YMTEpGWcyO_JGyd26Y8qfQ&oe=6A3BE8E8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
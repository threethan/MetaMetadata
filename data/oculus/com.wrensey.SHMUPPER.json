_ohc=rlcDaGSApCUQ7kNvwHB8zIT&_nc_oc=Adpu8Zw_01IAYQJWNqH9rGBMhQu2-SwziliR-71FyiTAFOP_WIINxfqaFjuvv8m-_1M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMd9v3Sk_C2emKCTGmXBtUUh6W_vIwVrkRmcIq8Q510lQ&oe=6AC10CFF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnPpBNxAysUQ7kNvwHWfSq7&_nc_oc=Adr64y6IWFqybjrqx11MJtCrjNpPFpqabeWMjjAk1zRln2f2Qht3kPhEtuAnWb-YGTg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRhhUU-uih3ehrLVfORSpdbrV0XckpXGupWzK6ZRWvAQ&oe=6AC10987"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVf426IX_FwQ7kNvwEI9cNq&_nc_oc=Adqtu39w-RfvSDY5pvIbiDPEbMMf6NEflLr7yip6ftSjCmVN02AR3tpE3Q-UJZUaoX0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRnSISgjT6hK57Wr6vxCpZyIv72dJ7cUe70tHFsuamMg&oe=6AC10DDE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeSb0GogFuYQ7kNvwGAKoRb&_nc_oc=Adp8rA3pVEYVZdZUUUaoBWUQgZmJ2W7VZ46ZXSr4o5eFTG37lSBhTBFRxQRgpbafDVs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZ_mQdwbY_N7Pm4UzHqZmZWvh_0Ladbg91rbgmMMpAbg&oe=6AC11E92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNoo7vtWkhEQ7kNvwH3deqP&_nc_oc=AdoGD0aObiN78bFlwZ09gufDrB-DwxvoAKFNkqnh0WMxHbfCIBjFhIwv1eoJHAsSYMU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkOwYUNz9CWVRmUsBe9vMod0153WnTKq3jxxJuSU6ZXA&oe=6AC11068"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
_ohc=D5FiEyRkpWwQ7kNvwFcQ4Rd&_nc_oc=AdoY3kXS14EPb-OodAGBXDAdJsTTvO2eSvEESAr1WXXUvJaxKdMYJN0rOE7BJJP2FZQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNVxHZrh2FVXjZLnlcEy5KTDjZqoY_cQz3qK2jYVo5Xw&oe=6AF71A7F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEMu1Fss9e4Q7kNvwGroxNG&_nc_oc=AdqwuihYOT0vUrqdBooEoUNa1PStobt0tThcXdZc8SxTdc_RrFvLlljxfsULPW2Nup0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPwfAKUtC9lUedIJAw2HY4ZC-BO3KYNi01aXU91iby5w&oe=6AF71707"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmNbsJ1u-4wQ7kNvwFw4HdE&_nc_oc=Adq9TTY-yt-bWELMFY7qybW47XVeQrRks2CWpawsb7AN1K6xZCR1wI3et9iLxzznIKM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9KkGZe_FyxSC87ILM544bVKJaVjS8C0nN-ZimbLesYA&oe=6AF71B5E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixAMN-Rv8dwQ7kNvwHJ3lRS&_nc_oc=AdoXZDxy5sQ19KgC4rLX3uKh3bxOx_u3Si8yY2QEQp3-n1qx9nHwbvuTP6NRGU36Sxk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQVhhIwLfwgABR1vZEazDeVjGQLc2p5UHp1Es4TYob5g&oe=6AF72C12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyDbMlQ8c7AQ7kNvwH2x6Jv&_nc_oc=Adq3BkIMDNQ3IMROZy3OwH0ca4STf9-v7cNe_kS0YcvwFOTy1LBV_hR83NrCl_1oK6A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2rAtTD-N-nHQeP_OyS2GzdVRYZlQIxJxbYqlE6pgdPg&oe=6AF71DE8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
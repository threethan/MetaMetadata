_ohc=qdj8eKu7_LsQ7kNvwFhLDn8&_nc_oc=Adq8X40gd22cTs8ByQBfad8Dl0VkaQ-WbopWukRMU9d8dyt0mgLS-UtqU3bBkd32KK8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxRnsIZhZShHX-IdEXOCU1DVcFwxUI446jw40Xc-fBaw&oe=6ABA757F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lA8BKZll5ukQ7kNvwE3oZp3&_nc_oc=AdoSc-pbvtKfBermRPE4BD2kThDSU-XyjQgP0tVXdq0txrCrClfpEYCpHadLgJGovBU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLI9P8PtU3zSso6M-DGs3eO5xFgJP1BcyClj2Dxk0wHbQ&oe=6ABA7207"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10Rn07gDAKEQ7kNvwG0rpSV&_nc_oc=Adq8GFh4zUc6YIx471-KpbkMIcguQiblyR6whILm183IoPeM3b0V2jvpAAFYcTryH0U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNqJWsyW9yO23ufUUArh9-UcYLidrVw6Innrr-jnJnjw&oe=6ABA765E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUlem8wPivQQ7kNvwFxwanM&_nc_oc=AdoTuyiGdD3l2NEg-_-FyEY9TM6HHVySHAMh63xRtVu6S7V268CgKs_9xTUy8GdN8h0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsjujNeXtqniK4OxeIp7X0on9pUiCBZOO9XWL4TVQnDA&oe=6ABA8712"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKuCCbdyGl8Q7kNvwEmOInb&_nc_oc=Adrf_PcAQRLYPEz63Wfk6x5pdIlu43YbFwCkSxdCJR6fYY-UylnhRTDkADuH4qd5CF4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ81QNo06i9jxErlUpzkGDD7pLnRcAAXWy7NFuRJzqKbw&oe=6ABA78E8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
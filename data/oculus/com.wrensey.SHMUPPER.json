_ohc=RBvfKMATRNkQ7kNvwEpb6zi&_nc_oc=AdpoyXX1AUsIVjlK6uSwUzsJE2WNrJgIJxTeqHtrMKyD8xDoxVwKPv7szcQ4ZxKTe3E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGp24w3pToDZ4tfNKXuGHzbHElWcEvIHyzGGGekR44EdQ&oe=6A8C18BF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AsAITmrLUQQ7kNvwHVF5yC&_nc_oc=AdplDetMkQTkFAbrC1N0JNYcbWtCj6YmJW4amiaIiejKbdkvbJWrc7OxYthbu2DQD8E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkZAUldtyz3hE-4cB4KPpzSnMQIJyQPzU7yWsSbnN5sQ&oe=6A8C1547"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8h_HthYTz_cQ7kNvwFvoQ4l&_nc_oc=AdpyR6wwAX_8XatJ8m0wx3NNVVNll8EkjJGJOi5RyNgSo_MAJDD6QIoLntESlgQd8yo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjxOP7wJL5jvasGlrv-DrciWO9z7ddZXX_sk1bMn9V2w&oe=6A8C199E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wna4SXIigawQ7kNvwE6E-uA&_nc_oc=Adp3-5PJxWDOIX2-nr8P4g5Ib0oHwEFLibU9fhrZrrHgb9uCWso13EfD1AcTGtORa2o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnCpbH2tywX48sZJeskHO9oVcIZa9XH-4OZ51eCU_Krw&oe=6A8C2A52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZ56vU-vE0YQ7kNvwEMsZVG&_nc_oc=AdoF8DaJNINLjBqa6XgVJp0HraV0eLxG7Gf_6t_vVa_mFb_nCA5WJCH5PgggxJ91Rcs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN6alH46jYtN7Npd-2ud8KNr93lc-I34zbNFRJpe9oMg&oe=6A8C1C28"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
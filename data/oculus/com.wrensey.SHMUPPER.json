_ohc=QuYhLPVf_esQ7kNvwGsEllG&_nc_oc=AdoSrTi8T_rBRGuXaWTu5jaSQjiO6Tvs8eU1jFMv9eKtoc8TYOMyGvWEZgtbsRvZmLQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6oqpAr4wLQJwQHo69JZIqBLVnrkJdjVCTtXpx-_Ht3w&oe=6A5CDAFF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7k-FhZ9mOa8Q7kNvwHE5iSy&_nc_oc=Adr0pxwMhCkQHjMbQ99fUqvOypmiqQ_6NCECECwkkwYPNYFXSiAwsO2A5KdDZSWbv3Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACStLh7JMjux2Jrva1aJK9UmFK0y24ZsmVXyqzIZI7JQ&oe=6A5CD787"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9_E-Ji_hvgQ7kNvwFNWh1q&_nc_oc=AdoEXUL67GO8exdbsa-DpkOXTiq_9HHiOem_zNXenMhC74RmBFmw39Ja1ncnJrE4dJk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUJ9-9DetIiEEPJGEDQZiEn7NGAcB8b5NJSw1BUnD8mg&oe=6A5CDBDE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0JTCOAOxBAQ7kNvwF3fzgE&_nc_oc=AdoWzpQsAlvQ8E9TZw4-SCqhDCS3KeO-IJQ5nb0JGk51_DN4g0V6gQqlec8J3Hn9Ds0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCP3R7F9Qj1vU18ITjeHd0neIzs0lQEmP60Uu49A0l89Q&oe=6A5CB452"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BtpYJdsQKkQ7kNvwEfnqp4&_nc_oc=Adqbyisa-cm4McV4e3bxD7M2e8H_tIas6iFhhof--gxbev1LOyJm-N5A0tWXMdW4RaQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6dIVsM9-nOvifRmNpy11MCfWpDhfZavsXzyFYTJux6A&oe=6A5CDE68"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
_ohc=OJxMsmm8c3cQ7kNvwFdo-OP&_nc_oc=AdpRGMWDi5Al6s_U0P992T61uE5VE59pgcMHbXChZAUTXYacJ0kZoOFTX7ClQlb-QmE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83xu4HvwcGPZmBs6PZJSJ_WxwAFcSWvqYnchXDBGlVNg&oe=6A3FD9FF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAMWVmI97UgQ7kNvwFXQbWb&_nc_oc=Adr43TMSuk4Y4hotvzdxBLc3yaVI6o06pewn7u7s1YhZy9QbYORJpwfp5i4r1CrPceU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pUazw0IdKEW-muee5VJt_ma0LLDIMBZPMU0aCQJqmWw&oe=6A3FD687"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpHxkXb628QQ7kNvwFKkEyg&_nc_oc=Ado2ZFxzIqWVtWapXHIfucQTXXR8zgLQOT9cMerECNob2KmVEKsMuv-KG0lsQRsm-mM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VObPML7f61SYIrfhtJb_3N_Tqz2Ub8egzwMigXhUc5w&oe=6A3FDADE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7F47trmwpcQ7kNvwFuP-Gv&_nc_oc=Ado-_7Sgb2fOZYDuVA7zzmZJ5qmYrtvmRqoQZZHxJlfUsDa4iMXFAJ6XTsP9B-i_NcY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YHSwgFAyBGY6_-MVAziwCOmzXQ5PWDRMLv4BA7L90Qw&oe=6A3FEB92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvaRgwdW6CQQ7kNvwHkTssJ&_nc_oc=AdqBp-ql0_5iBa1AGn_-FuKWH3iOlCD76hMFrAWGB7r4KlZQb2FrHH6LC2zTD-0Z8hU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NBm7GRloPDhdL3b8bBR1TvORaxBVJWZ2JbxKagEKdBw&oe=6A3FDD68"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
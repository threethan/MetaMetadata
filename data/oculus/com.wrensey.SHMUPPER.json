_ohc=X9fwIB5meAoQ7kNvwGGm9xw&_nc_oc=Ado_oeBq3crQqfuXnJrBxIAwz2V1P0eU7u7h9m4yNDVILHOLLmg-Pr2gK0aEgBp1YAo&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vW4XjYWpMphm-wCDC26Lt0ziBxsrN0oK78e6qgn3nfA&oe=69E23F7F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sV3SQK9clYkQ7kNvwE75OdK&_nc_oc=AdrmvHnwn31jaEQSMBLMPP7i4h6FGxbU6qJy-yh1kCFli2nl4AN495oIck2cvjnDSlE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SwxjxmrzeiIp2thT8pCcJauR-RBDWpz3nsOfsY5DJWA&oe=69E23C07"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7GTEA0DV9MQ7kNvwG3RsQc&_nc_oc=AdqL5zxEqVewBLYKwfz4yxzF6LcsJFqAvCOLHVKxZqnfG-Ci5c_l8ossuaQY8oKKr7g&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XWbE84H5pyGKxiIZgaBgE1Pte9A6Kl5x8xNZqr25DzQ&oe=69E2405E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2pfUeWyIAwQ7kNvwGbdHkh&_nc_oc=AdpfoasKn2yRt5oheqVZ7-aD_wnLh796Wh6b3P7Uc3iaLa3l4KmfAGIvW5smnoxpmVI&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1V1YeAbISBLONQzijP27TDP48z2oSq02z5fCqc_pN8hw&oe=69E25112"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cq3LUL36z38Q7kNvwHQNlbL&_nc_oc=AdqjhD5gjCVgr29hzU22padBZwlFCF7QkgtAfDoYZhxVjd_wZbDk5Icr1D8EhNkRaCw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gFdgSRKpYUQWEyPvZtn-CJKP4ZDT-L5_CCo5_bzjygQ&oe=69E242E8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
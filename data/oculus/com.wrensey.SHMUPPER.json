_ohc=Tb18mBoj4bsQ7kNvwH25QzS&_nc_oc=AdodLLgBrAHPHP6luLBLn6kgrZGFfjxpewMrPXmlECczvOr_lQpyT6KLhaIU3am4YwQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHFipdGzxXLU706cpunE7AHPxrKgKWMe0mvlyoP9-kdw&oe=6AB28C7F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkZO2iO3ctEQ7kNvwFM7z_W&_nc_oc=Adp4uFSR-sN18wx0Yg5wSP6Azxcxnn--ck9MpLRkC3RyCOLjhbMc72qPH8JgXvMl1zs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaBu9C9XKRmm_Z9bPcQ8dBB4coQrQpCnG6xt_vpOUUfg&oe=6AB28907"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTf2SO5t4zIQ7kNvwECjI9y&_nc_oc=AdpikAVVi0eugfBs4r_-FbITtS0ztWDQjQCe9KcFxRE7mmYg30uCK1Av6iJpdHXp8Pc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKy6mvHS1RW9kYowZ3NEkHL0gUHXqH0I6hOZRTvsgTAVw&oe=6AB28D5E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5utZBzIcU-AQ7kNvwFb5EyK&_nc_oc=AdqHLv94jGZkpfPJDEeQg6CYTYAvFzUIcd6-ZS679UILvkJmMkOL0nSzchq1fsxTzTU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK05BQwo4CN3LubTvyVRtJp1K_GU-fSqVIfwz-GPD2LEg&oe=6AB29E12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lVTN-_dQQkQ7kNvwEfm4tK&_nc_oc=AdoNoJ9kQO06JwAG9zeQj3PlOVzdBHc-idY-340BPoxqu0EZGNVtDzoUbmdDDSnucoE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8SFTCMWMWqX2qrq-_5y4DYc1w-gkH21Hm3jBm-JhABw&oe=6AB28FE8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
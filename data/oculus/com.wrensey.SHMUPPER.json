_ohc=wVzN5xkcumQQ7kNvwE7dz1d&_nc_oc=AdpbcuT7GJPuYYxSPJk1P9NABcHmjBNxpKFrfH__0QD64FrYxU6nJCnl_Z4qjayF8l0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VhAa4_xsCaQkAV8Dd2R2pGOfvSFVpgAWWJBNgwijl6w&oe=6A15A9FF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QqA0K_OEdoQ7kNvwG3THLc&_nc_oc=AdpMacdwNh37vSfQccDpjaN66Lv2b_1d-fQiLYGg6U5guqecFmDShHX7vRLVzjcGMM4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af472jW5w0I1dBrmI-N9odA4auD-tan6l3VEp7vxX0DWTw&oe=6A15A687"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7slOpIWKSGgQ7kNvwGJiGcf&_nc_oc=AdqjuiwoE0PozAvBZ2tg3H0DwQkzc0jx0G3tRiMK93gJtZVPcjTOmcgTh758kOQaOvE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PtesOYXA4h9PP0T5RKy7EG1TnmaKWl2q0ubXBA92dVg&oe=6A15AADE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eiy25Qs9wkQ7kNvwHcM9TI&_nc_oc=AdpboAslnF7MPieIYsVl9UKE0s3eGABVFv8i6J0LY8P5li63Q279CejOtKfra6ibhm4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZKN6nSvZl0VgPP6Kvh4eQlQaJLbhiH2UtyAagOB08iQ&oe=6A15BB92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDMox5lpyScQ7kNvwFdyIyF&_nc_oc=Adqj0M1tcU2vzRrUfwcKoPBGaRGbFWLbKwIOGMwAvSfLYw2xtt5ik6nN0_sXlTfRv1I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZvB3L0TTBmgp2rOrOqUFLjZDkf5uEjK9f2ZQKXb4KTA&oe=6A15AD68"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
_ohc=0oM25NBHmZoQ7kNvwHsXv2K&_nc_oc=Adqs5vdL29NDBiMB3nnN7c1jlrHJAqxDTTNvabPOz486SUvNWAn8paP9JYgzCAN0fYo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEBujdCsmbN3W2RwhPq7tA6i3z_R7L3qhg8OoA8Be-IA&oe=6A58E67F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bpBxbQlL9kQ7kNvwG4RPvV&_nc_oc=AdqstBOH8Jaq2eWZzNPVUuplSN0ZNLAvdSaBmDMMhEsxkxN-lqfnBQP8PX4dHHwv45A&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7-l8fGA9eyzQlR0AzlUXt_vvigw8Vlk2ZJKs49YLotg&oe=6A58E307"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5y26p9Yz-ScQ7kNvwHe7Eky&_nc_oc=AdoQYt69xNqmkporgzHAY1ywLa0PHee-rPZ0Q-zarbAEOw7wsuBF4VNzDZezl65QZZc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCyKElNbftbEJxBuhc7wejndepWto3k8pkavjtRnjb0A&oe=6A58E75E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-j31fEFEVIQ7kNvwGcaGZ0&_nc_oc=AdptYL47bE4rFMkcPNR9wdvF0WhpRQoLK_HIM2xI8KCICyuzvzzlo-YjJpPU77Zd5CM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPSw854d7UMOg9VQ_JbaAIqsGsdbrLcrUB7CHloZhaJQ&oe=6A58F812"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nghshUlReC4Q7kNvwHrC6sV&_nc_oc=Adpz1e7kVW4kU6Nyp5jiDqEVA06j7XOCCPh_aMjPm0NYqir64TWwF4JRCUYoprv3E3M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMCjNPsoARR8jMHQn0HlLJRCYm3bLua-qHhsNtyXLgSA&oe=6A58E9E8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
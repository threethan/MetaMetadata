_ohc=ZeVBdR4a9jcQ7kNvwFO56HX&_nc_oc=Adr2TCutidjWqdD7AwOcmsEqH9LgqOfG_4cplInKOePsUPVHfLVekuMpUYfOaDJYSGw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5e-fSnikYSCTGgzvZUmdldGoClnSAMsNErERybOCRHpg&oe=6A1C417F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-MQ9kFiuncQ7kNvwFAVEPi&_nc_oc=AdrfyHIgSuEVK1gXEa-FhpGjmqfn_MZDqT6Pj8-lVhR8KgvRXSpaebGXIRvsBRPYz1Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mzn14WRm4ZYvHnJVQNNni_vUrSaz8ZozRmoHux_AxEA&oe=6A1C3E07"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLJqweilExUQ7kNvwHg4Rl_&_nc_oc=Adojfpg-CeQSxUH2oQlbggA2Jou7CfFT5To9EzbOg_TD1P0U3jBsJR3o8N6_AYSOBEI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fRCC6cz0RaIa7QUHTOIha_axkyUBMJlbPefV51KKXkA&oe=6A1C425E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgrYtRfoLvMQ7kNvwHI5sAm&_nc_oc=AdrADc6JlhhX7pTXY1ro8HJeA55JyajhJdMSE2qVErKmdP8U-BPf7t9ualeuw7diWbo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4A2AMy-RH-_l-OX2aypnnY7VFHbds1e1hm2N_S2n8EJw&oe=6A1C5312"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aCJi-bDUtUQ7kNvwGdpHhs&_nc_oc=AdqP3l807XOfYSGU7Zpjk6yltwcbXFp0lvxHoNRLqCA31tJSAiR0GsF4R-8-X78nA68&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BO6D4LM_--L0VocU4pAOwz33Mc0e_tByDF4hep5KALA&oe=6A1C44E8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
_ohc=_53JdzlGCEcQ7kNvwFAx-3L&_nc_oc=AdpDRo5lIEQfkQ0Q2aNySJzqljcAkFBFf2Vp34Ucb6_RUQMXMz9wNhAbxyqQTUTWHAk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2dKU43SQvsCXbkSio593FA3qeGSpEYR_xmi-ubf4onw&oe=69CA847F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WBhLTbxLssQ7kNvwER6WGr&_nc_oc=AdpdJMW91vQIvfYm34Z6xE36WQ7gGyxq_J7g3-LKg85CS4na6KNURm5V4-ZP7u3Fiag&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwwdaUv_Nv3JykCx8PeRyHpG76XL9gB8pXav9_IFc-Erg&oe=69CA8107"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DU-nD6vHi9UQ7kNvwHigfMc&_nc_oc=AdrkBYqbbhck6EcSvwcsIlGvm5Sj9TUracMIQn9PZPRIxKqVCjlm72W498OJ486T6Oc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx0VhM4_tTPg-T-22p_pGzOJ7ZDIoHnOClopEmi79kKtA&oe=69CA855E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvfYNxWEOcAQ7kNvwHxj_Vf&_nc_oc=AdqQz-74H8azaoQV3Ruz7yltk6pSZTlSxu9arQnscgUA2qtCpEdOnwgaodjhoh98hTk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCYBJFpmrMlt3PqQl0tzBEy17C-5RT4GzsVm3dr6fglg&oe=69CA5DD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DjP5eD-hGIQ7kNvwFDaihe&_nc_oc=AdqkeK8VjUV5MLTySXwr9M7BaDqNYP0tMZGRs8PFngfYpL-ih-4XpZzUCgLYxF0q-HE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyyM33a20mjTK1KFHdlegJBO-DUNNJIzzfYn6A3bj6YDg&oe=69CA87E8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
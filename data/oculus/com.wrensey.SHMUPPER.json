_ohc=uZaAJywtJwgQ7kNvwFNCVXK&_nc_oc=AdqYa3QQo3CqCNt9wLBLUey7FspDGJiDLalYGsoJOmHQa-YsD59n04XbV7OlSKHbOqY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GNB8f0MGjiNy0b_9e9jkJHYbxnV1i7Lo1yauhrWbuoA&oe=69DBA7FF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sHWt22afO4Q7kNvwEBCbdI&_nc_oc=AdqPG5pmox70Euwgr6AuqACQeXFnlQNnryhalbQZCKV607THDWk90jz1GZ3PqAMak_A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zHoY1xnXAP9K9m8VUiIRuUMKWvYE1Oh_Ol2r4_HmqMg&oe=69DBA487"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LD4gKakBlPgQ7kNvwHEtOtI&_nc_oc=AdrgQWar5slnQNnm7D7t_CPTPqTrrAZGhTxde0mySau2i0Wg58Jic8CkUP-1_LlyB7c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28Sp_SVYbEOBQnKUNIU3FuBeNUJCr1YEsUNYFNQ-0LCg&oe=69DBA8DE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzV_JUJtfgwQ7kNvwHBd46h&_nc_oc=Adq2xVkX9G3Y3QFDSFamPPrq7MQLdPVpIoBB_ebQW3z6zha8ibsbt0HLyHDlCz3vfY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3noVqMM6XI6bT0g60Jx1GcS6r3PSXe8r0SQgNJ-AHmxg&oe=69DB8152"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xf9UbFsZ_IwQ7kNvwEP7yvt&_nc_oc=AdrPF6KSrBcqmcmFVsvzp9avf7bDfXaH7KQRsjaPpZVk42xTUkwsjOtn2Y0o_a0UQ0M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31bOmv28EGUcW75hSPaW1Vqcj4gXtaN8X0Lomt9Tua0g&oe=69DBAB68"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
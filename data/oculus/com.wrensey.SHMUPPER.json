_ohc=GgEPF5kE4WMQ7kNvwHXasaP&_nc_oc=AdoqTanpuEsA8vJNFrl8h6ph8iU5qadDmnGM_H1jqtxV__8hvtt8M855vAP_FNX3Ll4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yWw980aoTJpHNnWyBvAk8GtyCkxcoUsfXfHs1KTTSHQ&oe=6A2AC1FF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qD9XbTev5kQ7kNvwHpYE8v&_nc_oc=Adr5VhFag7m5bGGP4Hpei5RnWBysQ150aHQBZC7kFhl533U6cryqh0i_dx-nVRcQ7P8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-u6V_P4RQStpFVEXV-ZBukswG_z13ce-yY2f2JAOS76g&oe=6A2ABE87"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhdrSJReLfAQ7kNvwFwFGLo&_nc_oc=Adq9mB5jee51DcVuoa1CCBHp8I5gW6mJLNhpi71JIKpGq9GAxKFl_aIrTPffzGbm0-w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fz2A12HdtKrsDbZRBAArYUhydt-n_sWmfegwuNsYDZQ&oe=6A2AC2DE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YM1oDNhODBwQ7kNvwGzlWJd&_nc_oc=Adp8zXyV_ceoCifZ2YDZRHhHL_j8D7DBtnhOslMRPvMr2EcKI4moJoAyxVHQ-O27zCU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_goGjHTCWvpRDwiQJb5V5jxOtQ3rzL_ed1PTXHvYbvPQ&oe=6A2AD392"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTWYUwe7Ru8Q7kNvwE5UbgI&_nc_oc=AdocwhWwm2XX8KTCLSKs-QxsD8tTVFYAG6HvARKvfkJWCVlbjKruSfa5KEJoqNscUXI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PZ7LUPp6VrJ6xmLTDb0vw5ACAc28c5hQF0nAxe_szoQ&oe=6A2AC568"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
_ohc=YTNLY1v2RnIQ7kNvwH26946&_nc_oc=AdrA3rmsyvipj-04pRiHKErgAEKknvOEC5Mrzr7_Jc1Am_vU5zBwX7Lo-KphIGwbUTg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy53VIV_Yx-MGyTrJyuX1tl-yMUcFz7-QckRQNEIur6zA&oe=69CFCA7F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=de9Sh1B1uJ4Q7kNvwHCVfYw&_nc_oc=AdowC8BrRUlll-WpquwusDn-3UqDyR5XYehX078gEMsa7147kKSDQC-BPCU6J-zppO8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwtKma-U-nYld5jE-J6wJ3TGpP6CywhdtU-BhQRuhrPWw&oe=69CFC707"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9XSr5r5cnQQ7kNvwGEf9Ha&_nc_oc=Adraq-51oAOiGCCZYyu4IXDo5cUcnwFNXg08KtSe2QBj9ZMd9oMZ0k59ogwPqhAADGg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxtz5iRATLmmUdlacCOb8eqRJ4cb_NTRYsx0_mn2W1CUQ&oe=69CFCB5E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6JRB0pD33cQ7kNvwEbwVus&_nc_oc=AdrNkVc1Nob3dU_0O5NDFl37R9p8G_2isOP3ci7E6om2mWoEBQCzKn0fJHp-pBZ-Xjg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwBovNt-hquOeZs0Uksb84UevwLj1uHD5ZUB0uNnrVbmQ&oe=69CFA3D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqmRoONhe-oQ7kNvwG_hnvD&_nc_oc=Adp739rckWYov0NcfhImt2JA_HrWWbJ-9feMAH7QDTSKMx38T2Cw1awhlW3c25hngJk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzhp8gg4Gg7w4KTOg2kPDZuneCqy0vnSgSjHh6JR7uVfA&oe=69CFCDE8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
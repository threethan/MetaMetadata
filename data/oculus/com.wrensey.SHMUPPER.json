_ohc=C3xUeSBrOxQQ7kNvwH8rSxC&_nc_oc=AdolYxy5o7oORzdPyb2-MiX4gV3CylH-tQD7rHqB2nfEcQaKtVqiCJVs9AXHbK5liGo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7j7qQnlnYq71WJbJNBZR8kcOfVDzmfAfQjGj-8ifNdLQ&oe=6A0B1DFF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p90QVIf9wBIQ7kNvwF9R89s&_nc_oc=AdqAHpi-bJufpLNEszOnhyDgdzzNIuYv84b92NMhttN1H5oeHRbWRimhN3C3VRFuL7w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Rw_IJkqAtOkgZxydfVwVbC8hpVdgD3UA50VKWRILhPA&oe=6A0B1A87"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e01aELICzmsQ7kNvwH2Ez7l&_nc_oc=AdqxFPwnA2-b08e1SIDxUNlCuCS9WY8Krr7_xoqIax5X3vR__7JsxQFEo1K2GTFHhB0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TmmUN62uGxMlS-gP5U_aTHR05JRHB1JrOPswMg36E9Q&oe=6A0B1EDE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tn9dAiF8qiUQ7kNvwHUoPou&_nc_oc=Adptyu0jwM4GoKOmWJSGjBqEmmcy-AUJRGEMTJSKAdaEwMJQmlX4orOiDoGOT4u-8AQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4j33DYqEvsKgHR-QLnXX26U8VrZUDDlkP-C1cx2ru_bw&oe=6A0B2F92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2yk3Iqg6JkQ7kNvwEK9otR&_nc_oc=AdopqYsKqtWXViktvOEdZrEjn3ff6vcVkXK3HUv70k3ALS2uFQkaxnc0DCbAM6485TU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jHjwxuE4PpYcHcYDPTt_ClaR0pQ-Gv0qWsuHI4oL_GQ&oe=6A0B2168"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
_ohc=VkCqN44Nq90Q7kNvwHS0Nko&_nc_oc=Adq7yNlsYl6MvUZUnEqqdYodEwrRU4rDbaDH10hYTL01BDW_JbRPTrdowCl2yZhGcYQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Qw__WiutZ91AJW6DQ9kIl_8qgEBRWDYqT563LMbcTwQ&oe=69DE4AFF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sHWt22afO4Q7kNvwHraloB&_nc_oc=AdrqZUk12qWLnKI9Vgx4EEAgx6Tt3MwZUEziPMUc-QL_IzZLAy5eMIneID7WDTa6GdQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xAOLiwFIiBu4K0Re2GDzLDvGQMQeaVp87RNMLkg9IQw&oe=69DE4787"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3SwCDkcBg0Q7kNvwFmJprX&_nc_oc=AdrGCUzI1OLeFTXJn2WhHHTG6PhbJj6vF9wfc8tYXo6V8bUAYuwDulraoTzdtRphwik&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ds23ujOGaWBZ439wVXoFb9EWYxqBjyDJjBOsrvP0BEQ&oe=69DE4BDE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oX-EA3wyyLIQ7kNvwH5pcHE&_nc_oc=Ado6tcBC3jep5RFSKqYYStxpDnl0DGNEJHOEDB_-igBXXYboVfwA_k5tUpO-90_loS4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1O_9KaYAnc2fy7Ao0Uibib5dY0A4_yf5BiM8fS4-kWmQ&oe=69DE2452"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhjMiQciHokQ7kNvwHWBVN3&_nc_oc=Adp-xAUyeL0mLXA7_vLQNW4_3AehpccvIO2cbq4D5-75hfbZN_CDqjN9eTjNIY2Q-94&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1d_S87JHCxhD0LwVCdmXwIFP_i7a9OGTY0YI305rVbJg&oe=69DE4E68"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
_ohc=LNcYL3oACRoQ7kNvwH1gR9b&_nc_oc=Adpl8qFMVbKkBOcaFpCaJ9zIEYzAwmEtlqGhqOvLKMD69xiSYtIGSdLazvIR88tpi6g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gf9oNcwYwsXxcq2hlA6jng5zs4qyQOeG7HUhezqQHXw&oe=69D26D7F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=de9Sh1B1uJ4Q7kNvwHc4fQK&_nc_oc=AdqSirqs3T55mMgFevIO1498sfuj61-zPzWeE4c-gGxDBW6oS_UhXsPuWVB9CIlP4zs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HEldJ2XjZ30bz3-4GbNvcxl63xZrIq7f8wQoO1u5a-g&oe=69D26A07"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEGUMmRCjwEQ7kNvwFNYFTQ&_nc_oc=Ado3XF142CmYQhYlAFS29POAFTzRlf4f2UvvZRMPBgCFTTTR6MYmRfCnYLmuZVkXYn4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NVIXlgMpaMlmS0Z_9zg-40t3fozPPhKM5Bv8WgzfEDQ&oe=69D26E5E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M92_LSfwHj0Q7kNvwG0NeiG&_nc_oc=Ado3LwSQ-h_qrinzDm1dLvyXDKTcOjmHC48JgwpwYgGidl3tpCZb0dZ10Hpf7FbWTEI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TI_s6cqoo8KTdS0jWLPpg7rgjvp1NsRf0t5sCsTFSvw&oe=69D246D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWj5gkAV4KQQ7kNvwGEJglG&_nc_oc=AdqzX1uSSQlF6gw3VkIT00K7p_YJmGXjP00uQ77gDWm8S5LWKymbxlY053og3Eka9-Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2leqN4CMktMo6FMdWqrbFrW9Zm6cSN8KHoK1MYvQaVJQ&oe=69D270E8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
_ohc=MhmtFIYDW_UQ7kNvwGo-ZaZ&_nc_oc=AdpIKatz4TDbKePfONVzk3UbzmmrJoWce2SKslg2hGO7O5W1ZoQLAXAMwfy2u87E3vQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OAGZSedfy6Fz5LOoFtkURe0xEXqhvdeFTjMfypeoAJw&oe=6A21877F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SwQTdVLZqkQ7kNvwE6sL1E&_nc_oc=Adp3sxN8XKMwumDd4YbX06Z3sfMGi3ofSv9ZIoh97g0ydNkOkhOakvHRdJ9DtrsEdNU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kxkuAy1KY24uV5ocGzR055BZhhFzZy6bIi6o5NkRhfw&oe=6A218407"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmcIpJSFeDgQ7kNvwEoMdH9&_nc_oc=AdotLTZel5-6eZ2rexzWNEPUr2pZ9mpgEAh0SxkEhBfbfHkehEjPWyKnIbSFN-v4bis&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-H3aJaJHI6etTGe3wQd4PurxdwqnuHl1tP4GZqtwiH9g&oe=6A21885E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VyCqsn87CsQ7kNvwHxPDX5&_nc_oc=AdoICrDT2hkSvoF9Q9tKmdeZO60RJDCfv-wmZu7wTw5ru5ar0XgTF6FEW14OmDHg_Jo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xbBR54dmSY3kIQRYR2HJn-WLZpEMgzzXky4ZJNipU2g&oe=6A219912"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAM76LmIKhQQ7kNvwHa3h7l&_nc_oc=AdqSbDvK6CZs4Nqfd3dxyHMJbeNyP2nSfBG5XWkszroWjpvD6j7Lnva2vPKSXsr4s1g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Nco1k1cSOikMFmVTG3bXMHNkCWstR87l-f7wpk9BhxA&oe=6A218AE8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
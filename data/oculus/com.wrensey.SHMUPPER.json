XXM6UokOwIujmcvjNjgSEWmQYU8tZRHJXXtfYSMmI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfufY8ZsM_DWdX2un_9wJlJ3irS-kFzstVcRxuX8t_M3_Q&oe=69A83A07"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aW1xNhOwAjUQ7kNvwFKDEwE&_nc_oc=Adm-jGE_xszSkq2lWRxEVjXdlkkz8riD6iw-52kT1dKq-_k9bVFXRWm6IwHpo24X5Ig&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvNu6og2GXCGQL7Tfo6saGTNhZV-C-wRk0DhM9pPnhxkQ&oe=69A83E5E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJlHwXzqiIEQ7kNvwG5EY1B&_nc_oc=AdnLj3bo06iK1uDjJdVIUjtTQQ_hgcPfl6iUJNwYREhWcJgRvH0bRiTJkQH0xhmO3XE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv-Fy8laq_UX4BnxATMF5Vo8JnsQxUMeCBTvUi_Dx3yQw&oe=69A816D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbd7VowL3ZcQ7kNvwEoCbXH&_nc_oc=Adm7kprDBJTJVl5iE_-bHf1QSdCb2IreHEtcANLns4PLzf6cEeA0ma7lUACVu_WiDCQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvyBbVR5faLM0SOcO06tmq2DyTijfDuyWS0N77jDSQoOQ&oe=69A840E8"}, "display_name": "SHMUPPER (Demo)", "keywords": [], "long_description": "Have you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "Have you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5143349832356092"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2764344137210572"}]}, "baseline_offer": {"id": "2764344137210572"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1617292920, "s
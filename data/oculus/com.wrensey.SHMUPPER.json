_ohc=d5bWjqHpfHAQ7kNvwHEDmYk&_nc_oc=Adovn0io0DQnNQdBOgQoRXejX4XwdglrvssR1YEOCTpV9jv13ObA1ohY8ovPC2pcs5M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPaQSuCx5Qh2rNtRDdPkmD8LwxP8PTB2ZiU_c6sOZfzA&oe=6AAD467F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wnbvkppAH8Q7kNvwHbKLMq&_nc_oc=Adqpr8okkaMxjAbK1k4vf6v7LPy2VOdGVXLkVhK-VuemaCQBGSUaag1wvA85wZsHbhw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJw-2Xl54cF50NXeDsypOxUSzI0NjjZeA_-RKLCLZNQDQ&oe=6AAD4307"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nq4XjdAHHvgQ7kNvwHc29F-&_nc_oc=Adpb5EKLatdjhGMAQejRH1SZIx8avku1FGnUVxjp4EykV1blnc2M8Zk1Iq_k3nHOyHo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqE5kQxtLR-xw1MwPtjeJMkwAELEjN3gmG0z6q-MFRZQ&oe=6AAD475E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TunZTeiabCYQ7kNvwFwvKN_&_nc_oc=AdqQCyAbGSzpr0dwDqQ5OUcedLwfKhv0Q7zCQmCxNm2Gt4BYc9_b83lpEpo73hgNRdo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGeYB4C49DjlfHTe2u2W7-7Wtic4dCkxwF1FN5jliihg&oe=6AAD5812"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7uIQgLjKYYQ7kNvwHTCAXe&_nc_oc=Ado6_107B-b2Ak6uOY1KH2Ees3sSJrulfd9GNbGXDNeoQTWnx4NNU9lfEwU-gSO-lmI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_-Ke-_G1Uli93jo9NAszCVLdE5Og1YDF-faTW2XFbaA&oe=6AAD49E8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
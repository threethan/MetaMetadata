_ohc=3kERFey3LxkQ7kNvwHxt8GI&_nc_oc=Adrm4rFXqBnmED73OZoeE89wdmX6dKfNz_E3JWD4QVUL7l2MILBWEOk_9p6MY6JI0aY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DUGw47PUiVpzXkx_U5EeF02ao_JJ_4sdZgrgDOqKumg&oe=69FC9D7F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qG0uLru4brAQ7kNvwFwy3vu&_nc_oc=AdpltCl9A4y4_Ov6XR6iPb7Vvb7ygzmq4w80hg2z5yCjQlWeYmmi_pmAG37XPYujd1o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42C5T6JE-G9PvJ8saKE6XjGNplKPJ22aYhDuXBd5bDEw&oe=69FC9A07"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mz8N_EXeA2kQ7kNvwHNCDcy&_nc_oc=AdpZD__mKz6pZbWfSGhSB3qWY6lWJ0o0cpcwWsIL9leqKQWfBpvZBpTS1vrONC9X1S4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af628ymF6jnjDA3D0PWWeaQc0HmXK14jj2vqYgkkiJ5pMQ&oe=69FC9E5E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDYTBtSUNiYQ7kNvwHnVUpZ&_nc_oc=AdpFp2Xu-c5tBqu0v-ZgxWXYfhdJWxNJZG88d4vlBPCXVepLqrjHVlQHn61MlfJVczw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CSB4vBXVCG9cBQJjsFOZ9gYfl2s0Hn855mx97q5cu_A&oe=69FCAF12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dbW6SLLAT0Q7kNvwHU0RhT&_nc_oc=AdpNiCaQ9o-3_zTqpke4yED36gsWOKQoyM_xiVdekWyiX5qnvw2GkOM_vI6jizoZ84Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WH5JJw3bHTnGoxD9BDPm5eabU1Di4iFP1Nf_69Hl-ww&oe=69FCA0E8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
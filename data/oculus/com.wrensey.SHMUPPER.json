_ohc=1xOGB5DmUqkQ7kNvwGdbt7S&_nc_oc=Adpcc1QHHpMxK8oi0jIkjLmq2AQeG4bqge8v_aUkMWASh2pdmw5r70O2sGflxsajDFk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRt7bY-4BHjnRf4hBPz6i_oBCuW8zAu4BtN8ZmpvnUOQg&oe=6AEB3CFF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZfNLGBazWsQ7kNvwH056qC&_nc_oc=AdpfD3hgebCkJPdByECHX7txjX_u4Q6dQUr0CjkNlAf9v3LNoBX2QMrNA3FusyFL4rU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1X7HEz27l8YuAt8QR5_ivBK4xd1Vs3eC4letA7B4Qbw&oe=6AEB3987"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8QCYkbuDmsQ7kNvwGlPu3-&_nc_oc=AdoA9DKHhpPRdzLv32zq8PxyNsdVlhOAe6Y4M5S3BW-EcjK-dK94lwwxH5qUC0CPn_Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpb1icNaJjkWtYCPZIb4uib_3aFY33O3pyrYgmu-KQVA&oe=6AEB3DDE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuWBWAmsQ_kQ7kNvwH39R-G&_nc_oc=AdoldMQqpplSITwaQFj58sc0vuDkMekreF8IO3p8-kYqUgqVImWfUVQv1_vOBvuUe0U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKOQ76k8iGMRLA34M5_KvyBFQiVvptIoHhCmcGn1iroQ&oe=6AEB4E92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AvOFf_RqAcQ7kNvwHJFaId&_nc_oc=AdqId7q5vnDNdRnqj65F8QKUH7pmRF4v9i19qTyeYMQyTrNJu5lQ8el_7uckabV3TyI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD7SkZzb4Hxi8AokfqC0esr1VgB8yQDnJnrF_WD4Gt2g&oe=6AEB4068"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
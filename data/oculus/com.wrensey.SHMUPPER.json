_ohc=YTNLY1v2RnIQ7kNvwHFhCsf&_nc_oc=AdobhQFkAYebiti8Li48snJEKet7fK_LYy5AZ6d_zMLCIo9nbhNDSZcTFhTHfuBTz2U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxoempP6zlsAuE9GtIokNvPhjlhZZlX2v_-HgaUUfrP8w&oe=69D11BFF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=de9Sh1B1uJ4Q7kNvwH9BcJj&_nc_oc=Ado3zLPfX8Rq5mM9WX5Zklq97scmcsay-WQTF8pu5MpatwAgufRnN3eJbgJvYGJRHRI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1v5-xmxL_yAPHjiVni2Ux6q79TzAMEqi0zYTYgPn4uw&oe=69D11887"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEGUMmRCjwEQ7kNvwGwYSAK&_nc_oc=Adpl9pIH2S0yoioODoxZh376n6lfHkV6gLTbgIfFdaUF4G1i7XyL-v0lC_V_8p4p8fw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxH3skREPslKL9dSmsC88QSN1Hkqw6GlhPu_PA27rWhPw&oe=69D11CDE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6JRB0pD33cQ7kNvwFxeF-c&_nc_oc=AdoQpDMySTcz_58A0xJVvgJnLhZ2Pb6fGTABnw-THs3fN0-E30-KZAY_VYVFrAEUUbQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0TnegVDNNq42jLp8aWvwJiZGyXtI3Bd4UyK_MpfVg8w&oe=69D0F552"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWj5gkAV4KQQ7kNvwGg8uM-&_nc_oc=AdoJN5cPaFFiCIZo2V2JNO4Sn58nUtSCdU_OdyNHF7kuhnybkUy8WPJrIfTVLDIPQek&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyMFU_CoultJzhdIbMMgHTxs-f8O0Q8HHQL3Lrv1D4TlA&oe=69D11F68"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
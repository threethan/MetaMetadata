_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsHqug_hDu7PaHrVdWxQ-1vReG1yWbUatnkG8jVYu-dqw&oe=6999BCFF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BFOYJ3es6AQ7kNvwEphfzk&_nc_oc=AdkZ6vi9o4Mb30KWY4g1__BFGmVY5cnGEG6-xZNHBgZVaP-WknKMYkGNgpbEJxd7los&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftGyzyXYzK6lylx997SpiaUvMBrvvqgjNcJBQKe4seZxg&oe=6999B987"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFF-IFmDpvEQ7kNvwEZx8gJ&_nc_oc=AdknBziyHVXTzNAAYeSnh6uerDUF9NbXLrLPn_0k0MO2gtII8LvUJDIx2acE4enfBVQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft_cqItP92lx4Q6E62tumD1tE1cDqHPI6kAAvC1c_mVFA&oe=6999BDDE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwrqUCJpeEQQ7kNvwGMlqX-&_nc_oc=Adk1sQxA_JIJVCJosq5Nb7aDRsgfoQ_DgfyZOMI7BgeHEG0JVC_PckDLHSn4X-PG8r0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu_JRrc1xCK5Z4NtXAPFYndHk7vtkiyvIqyrbPlkcHK1g&oe=69999652"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjKmif0tF4kQ7kNvwHL57rt&_nc_oc=Adla_01m9RCWCExcAm6KW0NKDVoS0F13I8-HZ6kaT9Vg-oXQqbeBYdG6q7-2EPQB604&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfstfURJSfIPAEhcFybJcDhhSxcABwtrCOIg6p3tq0qivA&oe=6999C068"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE
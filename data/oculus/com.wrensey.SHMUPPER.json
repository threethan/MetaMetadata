_ohc=qAl0Z2mI9HoQ7kNvwG1SU6B&_nc_oc=AdqCc9hzb9TFAM2A7elN-UhHk7S3c-KKmhxSeAnknhGBy_6K6K306X6cJ2dIj3KeoHE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9HXfWaOEZb2L4bE3NkOw6G5kBbLFSx_5XcxK3NKoe2A&oe=6AF082FF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6jUWrxl9f8Q7kNvwEPhmJv&_nc_oc=AdoceiHsYvtWKcwLsWCkxP4mYv_Gj__UwHbN1VePb02bVrDJ2Cg4dwDxVtnKLkvl-UA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQt2nYkScs5c_xRld3QRtbYE9GS9coA-Enm6OpgoXmufg&oe=6AF07F87"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fh7qjhRXowAQ7kNvwGSL3zG&_nc_oc=AdpVo4gQvogkoOKb79f9d67CriibCDLMfMwGz6fsCZpUJtXeAUeae0g4EHchIgWLfqE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAozbKhXVh1A3Rb4yK7MT_jfkfGNWYKMnqyNuDqgpCQw&oe=6AF083DE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVXdIc6LiRIQ7kNvwEgb_Dw&_nc_oc=Adq7bo-JF4VhWfiDFld1La_24H7F6VHvY8ve78lUXRIZ1cMgGoJJ6lmIOUu8zYDabIc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkSAqHWUbc87jA7JXzYqtuY_2ntLNUh-zXce95oadimg&oe=6AF09492"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bURiHWAZE3sQ7kNvwEeoI2v&_nc_oc=AdpOD35X4ULLlZlttWRcq3CzZbwWFVsTFnms781NRCbF86gw7bXDj8vXsFhSKy52R5A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7U7IQLZOZvJfInsWY1h1ZfGtn2vbyAWMORygHATj8wA&oe=6AF08668"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
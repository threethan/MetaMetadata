_ohc=WX5x34wpaioQ7kNvwH5Uwd8&_nc_oc=Adqha8jy42efgFz-cPvzj00-PSIHHXn-7RitoAgcZ1kU2SBlPH33E1pr8txPgTM5RDM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjgKzKVHxANA9tmnWvcpxY0ZrEakyxHouK6ODNrNkSMA&oe=6ABE69FF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_ItqMKN9TUQ7kNvwGcu2TF&_nc_oc=AdpVlErX5dLzUcwL5mjy2jcLA9QYVAPFu2qcMCTo9NnLVRFPq0rPtaEDQP8Pi7Htxt4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR4Xiik9cclWEIstmLgY0kvHArEkT_0ESRIjULhaHONQ&oe=6ABE6687"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVf426IX_FwQ7kNvwH-mWGz&_nc_oc=AdonAzcg3dID9YYIcFqwLdDf1IBuvuCrV_P1CO8gw__wmAttmPidIaLgMaC9xTh9Vf0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKx_gAY4Vjp_6GIXAffBZ_GQPdANB0MahcDCo_fTgGvYA&oe=6ABE6ADE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjVHWk-QdsAQ7kNvwGK2xxQ&_nc_oc=Adoz58vOOcWk5bMOWUWaNX5kcQ0kyf5YFMqHzy4SSBYKNn9eLLcV24Bvsy9SKxIiQvE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRwBIQvS2wt_Ney-GyJMMdaLAR4gQgS55uvOOwT7zU4Q&oe=6ABE7B92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNoo7vtWkhEQ7kNvwGPzdFK&_nc_oc=AdqkN7xBg_mYiU3aatPll_mULksGZ0dOW0Fm_0L_VxdZP2M5Ji2wMbI3gm-VeNY0sdo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsBowAmOHCpoapm-t8E542HLP6_nOVZDMVIgEIm_9j5w&oe=6ABE6D68"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
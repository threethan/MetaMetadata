_ohc=C3xUeSBrOxQQ7kNvwH7OpNC&_nc_oc=AdrAbpH_E4nJJ7aylpYO7Bkx7imArrO4KCsneMBwi35K8CAN7Ehh3g52oQyLHm7ODjw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Y7ndtcDQVHY3ri8ifqymfGQd6X3U-VWT4Ylk0OWZIcA&oe=6A09CC7F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbMIGiOz08AQ7kNvwH5hGLU&_nc_oc=AdqhxJnIJiKteW775V-3bXAtokoOrRoBKxql_szYg7qXGwpD297jDGNQw7TBKwnnC8k&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5By6fW-5yfgphDq28yr7IBFoVeRw3eQbBYl_ohlvJ-iQ&oe=6A09C907"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e01aELICzmsQ7kNvwHKLFnX&_nc_oc=AdqE-0ETIjQiDIqsRSteXAvK0eB012R-jIAJWCM07eLaGVI5RTXwymJoVJjTF9jUWwg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VNp0NfUDD2zbez53_ucrayg_pIuldGnTBiU5etBb9hA&oe=6A09CD5E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tn9dAiF8qiUQ7kNvwH187IQ&_nc_oc=Adoa7h5H1Sft3yOMzcW3pFryj2Z7E2CGA4UMW3HvAym8NuvUxUuEsj-PgWHBkqYV4ck&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77vbEiZiY0iTqMALd90cLvRdsXW9mBiAUabYByYhMqcQ&oe=6A09DE12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2yk3Iqg6JkQ7kNvwEviATG&_nc_oc=Adp41D-hP9FLpoh9MQk21AdD7OLJPjg5eHplCOVvk0N8ez3s9_H6Kp8pa_HVpnm0IRE&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bNcUCEd_P0qzNPn2YwLoD6KsYc7mMK9xzperOwzfDJQ&oe=6A09CFE8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
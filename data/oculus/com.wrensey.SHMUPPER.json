_ohc=9AEdC-LFbOwQ7kNvwFOOun_&_nc_oc=AdrS6ZK5bNXVzCm9EjQWDCVu_FZz71q9IbWBC2FFnbI3uEk3SMxpii0jzj7aR-Y08Aw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mMFxWHJkYF2XmY82BTnqUeYiTEJpa-F2Og9tPwAXpzg&oe=6A0091FF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7PWtVmJzoUQ7kNvwF5dyx4&_nc_oc=AdpGP1Y7OVnKIxyTAOkhplt0zvzB56ROPuYQ23oGKWGtfzGat8cEJ09wXTJjh6F_FIU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4A8rggQ-zXYQXDAQNIeJLAwb8qx-qyNUeMjCP4nPiJQg&oe=6A008E87"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxiJ_6-5o48Q7kNvwEPYFLx&_nc_oc=AdpdUJvtvUbb-mUCzWDP9NaWvW0A9onz6o1QfK_3E55MK1MckOQftLZdS768HIKbbT4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ySPOJmIULFa5Pk3DF5stu4AVkKo4cn8xxe7ka-R4FGw&oe=6A0092DE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dI2C5-OiCYIQ7kNvwHogDkj&_nc_oc=AdoAceTSXS-LFAlgjTMmx9m259rFOSuQwWYgYQ1xh9VGRLFv8WqeKbt_8Nb2zeQvfSE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7K9UiYq-Ml2XHd8yeUgCaJQuBQkCqPqWwULMswAedr8A&oe=6A00A392"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzsfoMsgbBEQ7kNvwEsKAjw&_nc_oc=AdqTTWeZyCCSC1nOtw82JvlZPWOIOdptOyf2kVZ5C43_jMzcLan-6R1HjDcWSSCDs-o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NilMmcq3laF54VevwZgUj4KRf8OVqn47eNeCgDRsZnA&oe=6A009568"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
_ohc=qAl0Z2mI9HoQ7kNvwEBNt4_&_nc_oc=Adrlmw0LpeQXDPuvsammNL5W1HRh1CIn8JSzPA_VPKZvwbqHeFyadXBlUojaWqJljlg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSez3MJWT_97kwVGddzyBZDhhObsjxhRUaR1DbYgmjCHg&oe=6AEF317F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2SA6ISCo-cQ7kNvwH-B8Pv&_nc_oc=AdrgwLILvfE4XLNbvXviOOG0_rXkD-eoLb9zNUrZ8-guLDI0XId4biE3nlbBqkVQKbk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8ArRPbHiI62yM7xeIub10uIqeA4BgqfA55GnsBGwa2w&oe=6AEF6647"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fh7qjhRXowAQ7kNvwHBkzC3&_nc_oc=AdpqSh8SYhkcDzWHPGLD3NTBmQig5_Ehh27wHU-NtnN4zk4j5sdQpVxvGC6rqVsy3PI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSe-1GhCrq16dRqeIoetAK1kekpkKK84E1abP0NU0V4uA&oe=6AEF325E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVXdIc6LiRIQ7kNvwHmdp6b&_nc_oc=AdpZdI7LzgfjEjiElri6GGdo8FThOTLduzyp0OlahteZ0KeQO-gD6Qszpusu_BsBK9Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbSWPj1TbRmR3LBJhS2iuo7qbUo_1jBwn4sosZlaLdVw&oe=6AEF4312"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bURiHWAZE3sQ7kNvwEF0HQn&_nc_oc=AdoF-28N5LNU5Ub8IU9mI0fNQWr5dzpV_G21G3HTc5Pb9zQxfn-S_qPTm1O3NuBpC9s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1nmUev9fQCDYyk7I1dvCMPViGYtv34rh75TRssgdX7w&oe=6AEF34E8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
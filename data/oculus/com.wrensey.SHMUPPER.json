_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3__2eiKaU8MTwXlptAOmUO8zl2hcvUn3CJt6bno--a7Q&oe=69F0BFFF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fd0Hxhl7F3gQ7kNvwHvoru1&_nc_oc=Adp9D8AzlU4cowHPFxg9JhpZJ44MhQeqAbTlMpwGrE4duR3KbL8AaH-YR_saoYPUEI0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3wZ92IsIKSlvBxaEM-qeFGXLUKB8nSatAocLhdCkTv6Q&oe=69F0BC87"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Uri3qZkKBoQ7kNvwE1F0wV&_nc_oc=AdoJfp2t0YsOUOvvU5e5PHJ-RvcH928rR1yb72WGdnFC9EOjXPnMq0koj1ovfXh9_Js&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af39eLesDvXhb-ynd6uJgkGQ1QrsI9BtLFIe0nr0l9yJgw&oe=69F0C0DE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5J9DbTKpvcQ7kNvwFpuDQs&_nc_oc=AdrXUsYuZlRliTN0cAk8zI0DthaVDbmiPKOfdRR3lTOYiCFQPTS2tMzw3i1ZoQxiZj0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2uhXvS1vw1RKBzMXnQpwMxpHPSYGLkAo3srSQgzkjMIg&oe=69F0D192"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mdrh5lgTTrsQ7kNvwFBIfge&_nc_oc=AdrzZ85KSwywtc-ZWDUMucSLlj3lXQzMezykA20a1lMPimwfy-0aUqJDO5r-UxBY10Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3myWbOrszxixuwibVw24bo4vEhRWcwQ1lLsbaAwQTeIA&oe=69F0C368"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE
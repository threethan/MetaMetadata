_ohc=YTNLY1v2RnIQ7kNvwEhR2_T&_nc_oc=AdqUCU90zZWTj5eCV7Y9_D2s9Gz2FE6iPZ1ePdaqSK5IX1wJT2Ri145zjcfBJ_-bU2E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDQtgM0unhqMRsz7ehlPa-pf2KUtAzqK6um-yqnEBoTg&oe=69CE78FF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZG8mbubkaIQ7kNvwGMiHs4&_nc_oc=AdrA2R40OeB2iNnPe7nmk-90GV_U5z_nNBiOhZv7KllBDwNUR0wIdqJY21iBIrUCiSM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8vsQH2bPF1eUA02ll7KvhPXmWL5QS5dcswn-ct143MQ&oe=69CE7587"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9XSr5r5cnQQ7kNvwHG3161&_nc_oc=AdoamDtDrBBF9bCEW6oTAVVLUE7cUvkXpLI1CZa3SHteNGo-NYLm2tmn2MO2fVRXgwY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKeyGx4p9kH1qo4fLLvrm0pcVnNdmvI-8kS_COqv4FVQ&oe=69CE79DE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6JRB0pD33cQ7kNvwHAwyns&_nc_oc=Adpv_YHBVFPO_4pBkF_gFhsVI5Ha7ui6_bswjRhSMWMKraRN_lbng5P4K3CHkaTmzsk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjPGWls3hR1B6BK-bX-d60D3seOdbdzy_BFwJ4uLM-4w&oe=69CE5252"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqmRoONhe-oQ7kNvwGiykIH&_nc_oc=Adrdkw4OhgwobZVpAi7Z6tCojUHtmUrTxMcg2ecw6s6lsEO6trUzRtkrNRhKorfHnJA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjLg-_TCqSskKdWGZiciMw5z57OnI8nuDpgWcIIRifeQ&oe=69CE7C68"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
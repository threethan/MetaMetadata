_ohc=Mut1HWuUicgQ7kNvwFJWqDd&_nc_oc=AdoUlf0OCPZaOBQeNx_k1yAQzqsdntFgAraEgvMuXIL5PozeUrHPok216VWc9fNhOHY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaNSU9CGP0wY2blcedE_Hl3LyYwQm2R6MRtQlUIS9TMQ&oe=6A66157F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjLt-QH30xUQ7kNvwGu72S0&_nc_oc=AdpnNLjLB5SW0T30DJRR09yEkxoQ9xaQKTVEyPYvlaU1YrwUrVII_3q8UIJlbx2J9Nk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeWWS1e2u94_3dfgBXdjmoMGAKVXbG3NSNMgZmS7YJGQ&oe=6A661207"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYdL4GMRjo0Q7kNvwGHbdHw&_nc_oc=AdqrpuhQuz56DYfeouAcR5uq5XAKychgjx7lyj2FGbUOUlNDkwD90J2K_UEz8PLrzpY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDysid8gXj6o7BDaVYr05atW4Pm5o1U2AbGB8BGfgiZdQ&oe=6A66165E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haccPs00x9QQ7kNvwG33lVi&_nc_oc=Adq23XWM5DDh4ehWS3_n-IJW2tn0i33dwagSGQBWzQfSEu58zn_vdn2PWe_03BRb-hc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCm87KesZRHJF1aHiECqFLg-li-wZ_Sp4h6M0v78EvbMw&oe=6A662712"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_LmsGm7YsgQ7kNvwHrp0DN&_nc_oc=AdpJ5iVBzFNIlIhD8sRJp2x2s31Qptdfxjkm3iROsK3fd7VjrmjdLobLDTwB9RAUrjM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJdUx27wissagLfE7g7BuYPXu2rjofDndrO7ScjLraZQ&oe=6A6618E8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
_ohc=ayCK0elhBUwQ7kNvwFa0q3G&_nc_oc=AdoGvlCSLx9i7AYrayKHh1eDglp_ifgSFd8kcQrk_TQRCQm6ybh5Rg6r2xyyGwEBswg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvcv6uYBzrNc34PnzcTAr5MsNTI4_-IBPscCM309h0EQ&oe=6A9866BF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgVZVlN6v78Q7kNvwHbzUdg&_nc_oc=Adql6v4LSioN0nfgd1KPnRi-DPLahpTLVnbqog3Px6EfRSTLtbAKJPHxRfmLnEjesTI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaqAoI0HNIb9-9Z5AwAsIKE6vW6SgIV3RK56CaURY77Q&oe=6A986347"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uApSy8UoH5MQ7kNvwFT4HIk&_nc_oc=AdrwGJAqXDvRDp5_CUxrAqGpaBtdLTo7GKQFO641945noETUiCti8PeXHZozfC-HBZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5qkGK0GBbwV9OfYNLUAkDaas0CKNWJSJxytdR00NsTA&oe=6A98679E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aWBR6bA3fkQ7kNvwEsrksd&_nc_oc=AdrTyocffiIhmlyTi2pLQ5zeQCWMCLZFjSyFKy-TRAVPGKivaPWiClSLEVgMg4qtTqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzXwPkpZFrDLkuhLvqzNon3RK29nyK1bJFecAj8sNPCg&oe=6A984012"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Use5nxMSUsQ7kNvwHtfoTS&_nc_oc=Adq4OHFob4CvXu1842blqg7lnLKGAkDqVbQp39T1_0W7zwOw1ILOQyUiJUUmexXBB7M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdxp6jGtMH3qCoVYHKt-Wu36O_VUGjGU2Z_izPT5V5VA&oe=6A986A28"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
_ohc=xELGezh0f5QQ7kNvwFnaGNY&_nc_oc=AdpKz12H7ErJWq2AOki1EGD-UGk38OlyWoxhHEDD_Y5Luq6SiaUXvTftH3yiT1xyh_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XzOoh-vFhMoe-gwbY__9KdVsnWR9SlFcc1IrXgREt2g&oe=6A37F0FF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1C-05CgiHnUQ7kNvwFuqXSa&_nc_oc=AdqyUNPyBoeR17VhvKDY1LDFCY3pfbExKE7HjV4--Z7E5irmtO0vbtvhc5qeGYB7V4g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81n2jM7jJ3Xd4jcbrwbMUPduToUdSqj57EPldWVXCZBw&oe=6A37ED87"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QC2PQI7fTJIQ7kNvwHog4TT&_nc_oc=Ado6ZZT8X_ahgtPzOpY6hiFMgiUAIFWW2kRtahJhV6fAl36kSYQGdxlgcVLBfB6n01A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-C_NZfNbdd_m-BFHWNCzs5A3Nw_dAr3E3sMTLgNbzCAA&oe=6A37F1DE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=onUAyaYrMF8Q7kNvwHsmw1T&_nc_oc=AdqiwWavdCX7vPRZWimRlQDxNOs0cjBimpei-45pnHyGIfwXMMs2sqUm-K61kQa49XQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ui2NMCqRkSDkKPVcWa8FY-19dCfZ4khy1KonXXgruiw&oe=6A380292"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjqzIQFhpw4Q7kNvwHj-GJM&_nc_oc=AdqSikiVUKYWihPYzYARDYFrY6Dcj6N_bXsdsWn-As1n-ao0bHwzu3BAcvyyj7PRz-s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jrcGRwwW5eg_uM94UE-GPZCSAQf6b6HQUdonEL5xG4w&oe=6A37F468"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
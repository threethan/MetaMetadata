_ohc=Mut1HWuUicgQ7kNvwFp_K2w&_nc_oc=AdpYrAVsf1X7nyXg2Erk5_J8gAadtH8A3KOBPXhoSCEVNGS75CiahIs-EYej72Xj9NQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgJL4DP3sNRiDfyVUhXR_G3GkBX3-VwnrkFngEksv42g&oe=6A64C3FF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPCLFBqF7egQ7kNvwGHy0xa&_nc_oc=AdqaoR8GPcoLjTmRBsRyI0Stvwuoj5kcPGSkJN1sulHsXCWKQir9vAbryoS0y9hOpJM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6JThAIOty1WPVfs5liTOjlnOcBVz6qh5wdnH1qyXgaw&oe=6A64C087"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYdL4GMRjo0Q7kNvwGuJeH4&_nc_oc=AdoocU1zyMz15xhbAMKJILFrGKbHd7TquUs4Y3PhKXKuDKhGAs8-vIK0dbIjHJwEdRk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDl8_Ahrralf-PAWnA_jHfQc2dA1-6myhI4KFRgJjSU0g&oe=6A64C4DE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haccPs00x9QQ7kNvwFX4Tv1&_nc_oc=AdoM-QXBJS6FnpFsZ1w-iw_kp7dC6BaQdLMEn-sHWHfZsvs2bvsdcD9pfgbGpA8khZA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAx_A7NQl0Q-5fjeQpW7kE1jWQxJgU1DFADQ7-R6qxesQ&oe=6A649D52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_LmsGm7YsgQ7kNvwGbrBXX&_nc_oc=AdrQAEMxbSIxtgYzUSGbXEhoK1UVyeG0Ckf-ObN-fVbEO6pzvs9VXNwoBV4YhFYCNIs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjCim5TuwKTgtYusWGmzYczX6XPICBKn3tgtCXOKv1ww&oe=6A64C768"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
_ohc=f-_J6JBmZxkQ7kNvwGSycvR&_nc_oc=AdqNMI_wJsCA-KEH4YC2BrWJRBbNiAnhIPRhXm-FWNOmalXdBHHu8kWyufzw2_0ydYo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NR9srUjqEDIxtPnnI6nsBM4iW4m7jjsKC3CbtYWF0aw&oe=69E633FF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIhAuHgWwugQ7kNvwEJY07Z&_nc_oc=AdoIMor9_FFM21kdmfpqSFAj9g8YBvYZ0A__9WVFzX58ptXXL6sj31bKe5gqXk9DgI4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17RWtc53uPrXomyjuMXiORYTGsYFCPO2Nuurh460Pabw&oe=69E63087"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4QtzldCLOEQ7kNvwGTHbtr&_nc_oc=AdqUdRS06kuamxWLweNeFpOx9xzLljbPMztvHdOEwAj7I3gpVjZ0-x1JoIL9M78Fn4Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ps0aHK3mSVhxmE4KpEP6fKutBELcZkyRZWH2rpSXzvA&oe=69E634DE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6l9qYmEldBEQ7kNvwG9kR1b&_nc_oc=Adp6fXzY60EcluMKkaoKIRmpdcg3xEt0FkROCGlxp78RhHXuq9vwP0y3hYrNfqcNFAQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lW0ynKn6I5a7uT05l5nQ_S05-cyz2QtGNsl4CJyhOig&oe=69E64592"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqzEAkrlUtYQ7kNvwHP23ab&_nc_oc=Adr9smtwVXGF1sP3Xae-6vL2mau850DEHJ29iVpg9WA7aywD3xdIiw7eRKPVHY1aGDY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1m2XH_dSKqmj264yBpXaUDdkcIGt8lnCwO5Sp718rMmg&oe=69E63768"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
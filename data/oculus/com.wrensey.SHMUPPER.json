_ohc=G95IopF4PpAQ7kNvwGPzYtR&_nc_oc=AdqLnCBWQew8o8ABy0RYlCaTkU6bLC6VMCv8ckayVphb8i5PEtlyIPyr-Y5aPOGPUhA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ECPvmhUIF-Jb0eg2xqhM3QRbDnWFN2IzonEZYzJ90Nw&oe=6A32AAFF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mqgN2BEQGQQ7kNvwHoaIMY&_nc_oc=AdqkRDbhmQwdKJFK6QTONY5qNAAPgjl3q6JRbx8ynR7CCSdOUH3F3X-3Y9R7g5eX1GA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WY28WbICi_VpOiernDRYfuYdBFU_Tzv8KFWrcJCq26Q&oe=6A32A787"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RtiuKVeWo8Q7kNvwGrjwdu&_nc_oc=Ado-z-dnWh17Lxc8sQxKD2SMuWYhrpGXXODo9MIDe1_3wRs-lgPimidNQxQqVYgAnbM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gEReLDNTeyPbIBiRN5SEd1TxTa2L17WdhcmcprM5BGA&oe=6A32ABDE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IbmpVD0k70Q7kNvwHBaYIS&_nc_oc=Ado0iGddC5CFrZiWPgBOKZtSUz56xL9OXrqpHjcFx6XPbJiwcLM8T3-Zt2EulUG1-nQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0Doo_7gEPRkkO_9RtZAeo73K-afX4aTYwHIZFcnJyUw&oe=6A32BC92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoBSH09Y6RcQ7kNvwEImVga&_nc_oc=AdonZzvtV_ipAMFkgfIeq7F9TPkI7KNclSthheMSk5kY2me2iR8gaC4H_W5o_z5D8wI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hFSmCPrRUhEhmS2jxlKQOzDuIYzUmo_XDoe2uD8gU0A&oe=6A32AE68"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
2idc8OdAFbU8c7Pgyw8dZL-Lj3fv_kphng8yRdkFk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy_4WFA76Xcnruh-GUyEFbUUZQ7eTgAWl908gDGgSaW_g&oe=69C14687"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLVhDWrFQjwQ7kNvwHjNsU9&_nc_oc=AdpIqyFTl9jyaiGQDEmwNAFmM0J7a-JV9qw50Nj8geGFSn2SmE3MzBHFJ45hC_AsSu0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzN4Y3qcT9EdmtTFnHIlj8p2G0OzXWLzA8OoRuIb2tyCg&oe=69C14ADE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUMnB-K6twYQ7kNvwGvdN7Y&_nc_oc=AdqdMozj2jifdAHTgzDio0eq4UEsADJqRam5aKp50OXpNLUGBsCDDCtLdnTi0cYAvhk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKBSDmX2H69w2Boli4PQNAJpif4xaa9iRQ-TD7WnHY6g&oe=69C12352"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fa62w5Ox54IQ7kNvwFToTXp&_nc_oc=AdrFhXKZliIFMt-AAso3cJscqYSkZ68aGa58bx5p-6Hi9Ip9ZUGN01g5liVo_wU7XDg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzcNzToPq6zq_0KLwtMVPtM6eISEnrerpQIIfMT60S1pQ&oe=69C14D68"}, "display_name": "SHMUPPER (Demo)", "keywords": [], "long_description": "Have you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "Have you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5143349832356092"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2764344137210572"}]}, "baseline_offer": {"id": "2764344137210572"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1617292920, "s
id=6e7a0a&_nc_ohc=RBvfKMATRNkQ7kNvwH0293v&_nc_oc=Ado-Lu3kYZ-3SRO3znXncvm8W7EB8EtoA8gF804t5rLTwdXMjAglnA5WG6AmVMkGEqw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE87skE95Qjj_tnjSN7p4GBnOEHUIX3yvSXndxbnSX8pg&oe=6A8D6A3F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1vkZCrUHh8Q7kNvwHoe4AT&_nc_oc=AdpTuSXzUZe9M00BMDmtZSnAOJXPUmlP7NVSYgL4YMEt8G-Y-IuJ12SxRyB9XKpo7ns&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEv0MQsew_kglt8srzka3OZTGmtNkI2790zwwxkXkeHQ&oe=6A8D66C7"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8h_HthYTz_cQ7kNvwEYLWAw&_nc_oc=AdpyYDx9bDpaccHpodJcWwVvBmaVdZHPvI6PZ6a-ABVOq1GEYQkVXHDn_BjR_HeMcrU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdkF0HJm-u0onyPm28B5MGfq-2Lq7IKcYFwzSdzLyu3w&oe=6A8D6B1E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wna4SXIigawQ7kNvwExrxsf&_nc_oc=Adon069Pwi7xuCLRGMw3siAU7sIC5rSrxnXUMLc7rviBX3K9nQLvA8ZfKSxGWFVm-gs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXewA2idK3YH-GRf6V2ACGgk1deN3DwvxhBpaOcrgscg&oe=6A8D7BD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZ56vU-vE0YQ7kNvwG1XUjY&_nc_oc=AdqDgKn7ZfGvzFywBGU-FYJaP84Dzi_yWVLERAXNrDmeXsY77SNbQktykVFuqx93ZF4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEG31ywER1gIpda_K--XXVVD1RQ8oYl58bVCizOPyjIzg&oe=6A8D6DA8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_g
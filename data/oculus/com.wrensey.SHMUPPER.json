_ohc=ZBQBUpqqZRcQ7kNvwHj31VP&_nc_oc=Adqj_0iovs07XsTCzkTmNlHxFPMm5vKbTHhiiEog6Lha_hUmdM7k4KILoNiTxzethm8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFevJCwa7EWHUFbuEU_RibKLFm26KW_SwwH4EAPUFEgQ&oe=6A915EBF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=werwuCdW0goQ7kNvwF6Md2S&_nc_oc=AdqS0asNlbLcMJofvo9zNqFsdRWP5zkXbk0jKBH5k3wC91SZDSijg7TQe6F5PAe8WKI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSHRTs7EXuLaO17x3kqpRDy3-OnoA-Gkd-pOyB_pEZrg&oe=6A915B47"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdiK3o70yPsQ7kNvwEeqQsI&_nc_oc=Adphv9g5pFx7LYItHQS1gDQ_IXtch9LtCsYOxIgE3jXTav6gV8fNvOrEIfxfGkOZUGs&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoYnBY0v_w2g5HTNfpe-9u3jHFsBGK1ojmy5T9m_B3Ng&oe=6A915F9E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6kDCFd0hl4Q7kNvwFOcJd6&_nc_oc=Adory6j7KsMKLNAw6FV1Mn2bgHq2H1QY7h7pyKcvyI5nTJp3Uw-pdF_ucYfncwnPR_Y&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKrh_sA56LgPlLXSUnCKnkwRKnIMr6bXmqBQxM_pgU_g&oe=6A917052"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLBGmegiR8UQ7kNvwGDN3xO&_nc_oc=AdoikeZa9_mhKR_2j486yrY0VxOusLOhcL4GmxZ2PTiU98iH2se_azMZeROgmziAzG8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxZfNka3Ob1bccqdy95bjTYCMVcTQ-Y0mCJ9YTDB57fg&oe=6A916228"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
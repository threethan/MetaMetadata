_ohc=jx5aEtfvc5oQ7kNvwGiKOia&_nc_oc=AdrQUNm-spMkkeld0Dgdeg0rbwnwUhA3QRhFZV_9hMJAxLTQfQ6YylZulyw0jk2sO8c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjprjhY5qrgyesg14n806Yhk18bSii5IMJbPzaT-db5Q&oe=6A80737F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Li14duSh1zMQ7kNvwHX26hZ&_nc_oc=AdppTkRbOBog1uPQzq-Kgq0jzQQPxfuR7ma0mVsClZtz6lDX6xgvR0I00DYH62utIBo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMluhdzJ7QWDxlCQW9pFNUjMQWjF3-WBoV9nKKDmGsTA&oe=6A807007"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xb9oSst2CQQ7kNvwH0HEy4&_nc_oc=Adrg8v3baTlPXgh9IYvW0zdW0hXhCw9com_Jgq6ldOoeFJr7iN7ppi6Lft8VEPNTAJY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJWELPWGikicqzhdLwQdQb-60LTGermqTds3bUbk45ew&oe=6A80745E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mytdRNQg85YQ7kNvwE4DS-g&_nc_oc=Ado948upDQLJ-xKFXupt2FV_7mdDANYXRQgv697VmIuMmV2pEezkj95wpUpFRNp6c60&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZeAHNhmLUJCecuBw-ebOWu9FI2UxvNyJm8-2DKU7Z2g&oe=6A804CD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cf5VizQivD8Q7kNvwH5hDfu&_nc_oc=Adp2MJ_iVy2elxa-XK0PSo-y3lrqt6zpuisLi2TPI-MCP1leCwevir57MgCZdMd86tA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFItQ1ygduLWuoG4SbAtr-ug8Ja3YKnqmEfQQIu9pS6Dw&oe=6A803EA8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
_ohc=C3xUeSBrOxQQ7kNvwEnKeif&_nc_oc=AdqEfCV8GlUIke2WQY4-BcoWXEWBQmNYkucaiIMdsx2qiCFS8Br_4JsgQfLKZfLnesE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cB0JqH9Mun_RLs_tOcM9Gn4vVT_6bKSJ679i4pl8ELA&oe=6A0C6F7F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p90QVIf9wBIQ7kNvwE3wMSd&_nc_oc=Ado4EEnpNJYbVbu72KKM-zheGkc-QmhOkzeRZBvuSRK_2HRcglqsIRqCz4oxLFzvPHQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GFl381WAJp6PM3wWDlJWy48ePmDlRqVDd5iUWpykpdw&oe=6A0C6C07"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvmkjwGGZG0Q7kNvwGrE82F&_nc_oc=Adr4yEwD6ybbMb_8jy8p7paLCnC-ywv5aOk3VCFg5iSnLHPSzE05ZLcGkfK05LJXtR0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UlNA3SbuH0vP3Bs1ZG0npee3uAgx4DKW4hpvNDoVM0Q&oe=6A0C705E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tn9dAiF8qiUQ7kNvwF8z--R&_nc_oc=AdqXaYpnvVV51cm4OEsZWPZK5OYC3iNaUmFG3SKCuQITlK7aHC7el9LiDG6maOuh8EE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4p3NVfiz1gw5jej--tdmHmSkF8BK5px53XAlKNvfqnAg&oe=6A0C8112"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f71wptt43_UQ7kNvwHw_Jop&_nc_oc=Adrv0lsbrtTY-G6x7hFJaCnvEP7YPWH7jMxSd6mJYOoC1cKQKD0c-GPFeoo28xjt7zc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5l1_5ZdSexO2fYNzPgZjzygOZddXkJ8ncWQb-BOStBQA&oe=6A0C72E8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
_ohc=oMODab6si8kQ7kNvwHuZxZN&_nc_oc=AdrNnCtd15cvLz624ljOUDNzUZ4mjidwyVsDW-h7np6_-T4AgJ3u1JLVC6Ryy6azZoY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhnFPzIcwzGg6sBhDCDAHBeq6W1BReOWUe-3K8fR5D9g&oe=6A75E77F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSl_wcPSRIcQ7kNvwHG2eak&_nc_oc=AdqnM_F0Hg-RPwJcndWgSbCFHv_gai13gCOWIVzBJnHnUZeiuSGTb4IbJcDp3SNX-So&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGX0s8VDPLsROmOri10RCPNyhR1vKm0vZ7nf7_NAEZP-g&oe=6A75E407"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DleK9agKnGgQ7kNvwHOO3jI&_nc_oc=AdolLOgjgiF_99LuJzlsRMtsQYMKn2IaRUED5rTYn_ynrP8A5t6G5c8jKnZAbqjkImM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpXG7xGBZ-8YDL8qAn5E6S0bkutBDEN5LIU4es18KmWA&oe=6A75E85E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fq9PA3rLJUsQ7kNvwFgqHTl&_nc_oc=Adp_M2NIssP9todqCZo2Pg9ghwfxkj44sS9oIF6VgSJ2sE4935elzT7NhbD3FsFYKis&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEphaB5uemv0fVTpTESPIpB7dWHIZxmLVgl003qbMWbhg&oe=6A75F912"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJvY94GzvUMQ7kNvwFaiOZQ&_nc_oc=AdpVfSmC0Lb1jzaU42C5yyoe7inuWyp9GCQbNu76PQk9Ye7rIhNd0qKMlylQjEgNdGU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFTP5zES2WtcCrfK9M62SCrBlzXkxfFgHfrigmqcdCig&oe=6A75EAE8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
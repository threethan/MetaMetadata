_ohc=f-_J6JBmZxkQ7kNvwFjKdBf&_nc_oc=Adqmkd0TCAcHf6fVm8rgRKN7y6wX6gzSJNDAmaU0jtdj3iHIb4OSkXNAZr0TJJ2sJCY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BBo7FVhJnYQh_6oeI2WZnd-8BPlecsjhYjfg_X05l5Q&oe=69E8D6FF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAvjwL3A094Q7kNvwEwqqir&_nc_oc=Adp7KmSZhl5rz8AyduacfzUT3MUJ5q8KdetTdgeuHapqHfKS6bsrceKZDIH5GasuNsY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AK4U7iAB76v1K3Njzxyy2Yg60H7ly3S7zlfBCsSjTRQ&oe=69E8D387"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBLFR0EMtlUQ7kNvwGRQ1sP&_nc_oc=Adq06A--dKsyEhJzOS-VkmZqpq6OIWYYKr_5XzMRBRjjjaVZVsgZLbqWy4b4_iLIWZ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HdZbgGalVDI2P8ufx0ffVktg40jOmvgsrw_M8STfozA&oe=69E8D7DE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6l9qYmEldBEQ7kNvwGJOcmm&_nc_oc=Adqa_BFnWFM546LLXFAyB-V7ax2-LbdCjSyIHgLI-PHTmbhvQJ-0H557zYKeNluyFdQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XlJk57UJ-7o1CUwQVlncLxm1doX6rQRA48pjyG_CGOA&oe=69E8B052"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SemWArIQxr0Q7kNvwHOLWh0&_nc_oc=Ado297vEQPSVxJezmh3GFSaIK5zN5fzLhG3LDG1_Cos5TWePxmd_fyRs-COq8Qyyn0E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BFV9VN-nffmUh-j1CB2IeIJzGaybp0JlsoZo6kUKNCg&oe=69E8DA68"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
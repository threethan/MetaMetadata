_ohc=ayCK0elhBUwQ7kNvwGcEB4x&_nc_oc=Adrjz7X55HucbeKpllTCKPiECaVYdatkmWIO3mVws1Ezz4JuajH58-PA5DLt9gpbSjk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrrt4VTVnfRSyqPLFHEmcYbQMEuQX4ctyzhHRHMDOBlg&oe=6A9AD17F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOaDhZPhx6UQ7kNvwFW72QJ&_nc_oc=Adoaaqi1fLQE7TgWESJrqnObwTHaGXUhbnb6qT7uwMxLjqFKiImvwAd6_SE6EXOqJJQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHjjr_sGkyWM688DhdELAGTp347Z0CoGOEbSZAfyL8RA&oe=6A9ACE07"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXpODKNSMNwQ7kNvwFX6FMK&_nc_oc=AdqYzl1iTsyKsvClOUFuVem4iRjEQpX7kd2EyvMZamUyOG7PaB7sS_REZDqrB08-C6s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpMoXW-uE_R24qph-KHtnh__1tdg_q5n_X6GCG9cqsOg&oe=6A9AD25E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aWBR6bA3fkQ7kNvwGcHSe7&_nc_oc=AdpvuHTr3oFzPrUWsLCLazCH1-s5lX2P_bwb_ZEPB6HB1hkW3JDl6CKzkMMKtoniCk0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAkCc4qZ9QZWfx2_0BkPQwNX6weNr0z6GrHyE1o1z2iQ&oe=6A9AE312"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xgiyZN6BC4Q7kNvwF6QB81&_nc_oc=Adqjc_tFdXblH-1SvGiAhDkI3YYv8QaFGSjwwoEuT2DmUURs0JfTJlwjWaSWEL0d-yg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5b-AkGtNV1x-i0EsSe1DDYk50-WCoY62EZhfs1rQzog&oe=6A9AD4E8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
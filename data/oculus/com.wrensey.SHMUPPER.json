_ohc=9AEdC-LFbOwQ7kNvwFc1nj0&_nc_oc=AdrS3roiVSWVdk9jS3OS23jKOYIIunx3PAUbMgnmj9myvznBWCQ8oBEUdKlSd7IhfGY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bcZMJlV_5gnM85xhNrCmBhNNnvS9Xz2IvJAekW-2IZA&oe=69FDEEFF"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qG0uLru4brAQ7kNvwFzOXUN&_nc_oc=AdrT8FHmV4XhP79iNCLlK36pfswWs6ZJd_1Xz2mklE-1HxQjg2MdoknbXiuFcnH9ssc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OcXO1y4qyHr3X5OsmCsHJLu6ATcFxMlM1hrh8iCufGQ&oe=69FDEB87"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mz8N_EXeA2kQ7kNvwFfaV9U&_nc_oc=AdoOIDOgPwYcgPa_n8w__AFBtX_tl8S_tJ56aXLL7UVkL20XBHCxQtaFSkQEVvTXcEE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7H4av_94Zj5o61U4Jjm-gbb65iR7dg1kk-NdASNxvODw&oe=69FDEFDE"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dI2C5-OiCYIQ7kNvwEHPGKG&_nc_oc=AdoqiwLiVg6cmZDgxG4B4gb9mBl3K5sD7NsNpZTZbLtW3Hw-y11Vj4sPGhx1ICq7Fzs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rHaKkPzn01FZKy1pU6gD3Qgg5G9l725_oOfrm9aMPTw&oe=69FE0092"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dbW6SLLAT0Q7kNvwELy-n4&_nc_oc=AdoKZgYqRY9FASIFjtU0ceWRMkN79OOdQ3MKSpJARBrwiP2Yi79bCRXz0XpPxbBBs0U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7H24OTvDKA6biE1heXRM3o6ZYkEMwTaNnEGXQDrsdbLA&oe=69FDF268"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
_ohc=wLdnhaTECDkQ7kNvwHHClIp&_nc_oc=AdqVePh90IGUUSASFDvlt1io6DDiwFZtVw8yCTzyF-jdRMb6sAAC3EDtXJH_lujTkMs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS67vKZI__X5LuV6EfI9QNNWhX7U4-mPx38rnZZreEJqA&oe=6AE9EB7F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZfNLGBazWsQ7kNvwHBuqUg&_nc_oc=AdpkirGZrcibW4XEW5c0HH7JBg9MZNpUcBAIm8s-VJa6pVTvc8ud62fgtmAfKbLYFds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToSD2thC6TZmX7VRJ9ASCID-LDWgtdhLhiMjkxmHWbQg&oe=6AE9E807"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8QCYkbuDmsQ7kNvwFGfSVn&_nc_oc=AdrJPhhXoGbZLvNI9LoX7AIi50q2ZhH1MIV8oeH5UK4uHe0MJ4le_B7ApOmU58LbI38&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJaBvVCPdMrwXAV3HHS_ydQvnAF16za5FI_LemfdqCaw&oe=6AE9EC5E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GqamB997HIQ7kNvwGXdYXk&_nc_oc=AdrO2n2G5RKH1UVPt06HmCk7W8D4YLy5-TW4Bpnxhp1VpEO2kZ3bwEsp6uC5KaLj9zs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnD64uWWIkLxUcpkoftHl2jsVVOkrjEXK4pwygleZxaQ&oe=6AE9FD12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AvOFf_RqAcQ7kNvwFJjF-0&_nc_oc=Adq3ZCOGt_jYElHt_LF92T5QARyz7mkQlgfsP2OPusg6VK6vp7UXvT3yM6ttVdXc6Q4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGFMcYOx_CYQK7y9Sr8n7rbEg8ZhN5jYMs4bj6Ffsx4A&oe=6AE9EEE8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
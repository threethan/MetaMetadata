_ohc=ZBQBUpqqZRcQ7kNvwEWqB2V&_nc_oc=AdqpZuqYyFU0JF1bC-dNOUucPSArme6ZrrkU2M8VOsoGlqWUtolMvm6LfHpNdUuo9HQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErI8fqwk2BTVoNiL3ALz0yso62XpXG3yNurrKdz_B2hA&oe=6A900D3F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1vkZCrUHh8Q7kNvwEeAYIn&_nc_oc=AdoLJAzJv22lMgqi7zSny0zQ17Uwq-DJf2vm7RhskHVN_U1wXKeOzwpDzaMSz86gscY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPG--Ivbt82cw-dZEECh6JboVFSwFjhV7WwHxyjmEaOQ&oe=6A9009C7"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdiK3o70yPsQ7kNvwGCdVWZ&_nc_oc=AdoalWqlnmotknaaoh8mJ1XG95XsYSGxdo1r7n_euWnv8NOfkc_XKiX0giOUgL0_QQc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkdQLlx51BXgHswsNtyulPx3X1y7MrJ-cbC45fDVxQ4A&oe=6A900E1E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6kDCFd0hl4Q7kNvwEcJysR&_nc_oc=AdpW6IwxGC_NwgaggB7Ki8g4VJpy-Fj1nNwXHZTGd6mhFKcS_0O0ONlzK6kI-p_LlT0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0pf6SgUhVcVUd3FGpcYFzqeaH40QKemJxan3o7h-1EQ&oe=6A901ED2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLBGmegiR8UQ7kNvwGG0Fvd&_nc_oc=AdpD-y6c2WX1rvhYIaUFcTKpffpsKuDCPMZ-44Ou8hvvRE5oKVBAZo2Bmwho7Nyk2L8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnQCX_gdSjNuGdt54cHez2xgeLW8C76fEUQRdtqeOhzA&oe=6A9010A8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
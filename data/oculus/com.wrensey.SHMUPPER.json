_ohc=ehyQtx_gf7kQ7kNvwGxOlPP&_nc_oc=AdrmUMNaz7iM6iJNQfYG_mlTH2NQGTqP0-B-W0DmH7LeVmX0iBqMY9Zz2C8kRQvqaBo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1arrm5P9bvqYzVGdQnO4pCN6v96mfpidkiJb9J6ldYvA&oe=69EF6E7F"}, {"file_name": "storeShot_4.png", "id": "461706031546379", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974827_461706034879712_219498851670986028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fd0Hxhl7F3gQ7kNvwG3Az2s&_nc_oc=AdqkIFlcIIP5odhyG-jccal_bSpzaJW0SMSQJsNtudBomZRU7Vya809KAbaJ9XimO88&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af04FuQAHmb8lse3P-3YpFopoby4WjhP5-RLQlYlrhPujg&oe=69EF6B07"}, {"file_name": "storeShot_1.png", "id": "1101855813658769", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974820_1101855816992102_8806418871866348803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oa_LtpeXvkkQ7kNvwG05vb0&_nc_oc=Adpe2qID1Lg2TOkD-P6nJxzC6AUvUH5HRTuRAMAL2lnLbGQAC75oVCt4QpZ2OwMWLSA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3DmoyKT8ylsRx99HrfhUltZv9lZd_WohBCPe7TeN1Yzw&oe=69EF6F5E"}, {"file_name": "storeShot_3.png", "id": "1917893115028734", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974684_1917893118362067_5388885521248075099_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5J9DbTKpvcQ7kNvwFWeuNI&_nc_oc=AdrBwn1NfAUlikHp6JVAkj2kc-nOZkAvmkYHjIKNHpttcosAVaHDoQdb4nclCG1uKQE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1--918Y3OXds0mOXX2CDvJ2V27UL3-MNAnAAEzo9k93Q&oe=69EF8012"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key_Art_01.png", "id": "630217451080550", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031424_630217454413883_6000066187856028787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfUxsHwR72AQ7kNvwEXAaEr&_nc_oc=AdpYb2xLyvY3ovmlTf-AmPSluel3K25ztEhvh3XXCU-wzwuTGbL-Vc_fd2JzctwvQ_w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1K7ijGZOCvOsCECqE-RG0HAh2xWF2rtWCG9kInZpQrtg&oe=69EF71E8"}, "display_name": "SHMUPPER (Alpha Demo)", "keywords": [], "long_description": "Known Issues:\n- Random crashes on Quest 2 (If you experience this, just close the app and try opening it again)\n\nConsider taking time to fill out the Demo Feedback Form! https://forms.gle/VfNTeAHANpcKfwFi9\n\nHave you ever wanted to play a retro-style space shooter from a more immersive and engaging perspective? SHMUPPER is a dog-based arcade-style 3D SHMUP or \u201cShoot-em-up\u201d that does just that! It tasks the player with the objective of battling waves of enemies through unique levels across the galaxy. It draws inspiration from classics in the genre such as Star Fox, Metal Slug, and Macross with a VR twist. \n\nWhile inspired by the iconic titles mentioned previously, this game comes with a twist. While in VR, the movement of your ship is done primarily through the movement of your body! In order to steer, the player must lean or step forwards, backward, left, or right in order to maneuver through space. ", "short_description": "SHMUPPER is a dog-based 3D SHMUP or \u201cShoot-em-up\u201d with a retro-inspired space shooter aesthetic in a VR 3rd person perspective with innovative ship steering mechanics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/16lFrus7R7ppi39mqaBgltVsrpCqohCfF/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wrensey", "support_website_url": null, "website_url": "https://shmupper.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
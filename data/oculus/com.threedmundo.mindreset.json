uluscdn.com&_nc_ss=7f20f&oh=00_AQIYtir1cIILRJOjem98ryq7Sai71nP0AERvG0V-d0X2Bg&oe=6AB12563"}, {"file_name": "captura_5.png", "id": "1371836718424180", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623400_1371836721757513_7236752081464592420_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUjvypAnxIQQ7kNvwECiVo_&_nc_oc=AdomsnUNhYttJAxA1EgdwweP_lpXrHDNjofVpEOuCDd1MyGRvj35kbxk7_41R2ncO-g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2fgu2zUUQ3NzaRnbKqOQOipR5crwquC2IwEgu1KU9xg&oe=6AB138E1"}, {"file_name": "captura_1.png", "id": "1758906478792676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620817_1758906482126009_5852303415899777201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8me2bwBliMQ7kNvwFxbnjd&_nc_oc=AdravBB10DpXCyVuSevT9hTcHCzcB69duHe154TfSpO1aGrBCgor1a8I7pfeQ-J7BD0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzEmvpveXkSHLmSSHUzLNQJd7UT6qYCJnDtp7lqrEX1g&oe=6AB134A7"}, {"file_name": "captura_2.png", "id": "1572125964626112", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623314_1572125967959445_3265121464218702874_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLkDvlVLMEIQ7kNvwEY5EwH&_nc_oc=Adqkj3fi-WT1bVdmGhhgFL-qlusqaTLVbZvAirroTHEUz0ZcmwtYY699RF2WE9vqYAM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIK7PPzKqXRtwP3qAvb14GzAaXMoLe316DS1bDLuwld6w&oe=6AB12F96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "2202059907239915", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620921_2202059910573248_4405307347959623885_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxfEdklV7X0Q7kNvwFH46T7&_nc_oc=AdqQi3j3J0Pmm_RNeJtqS_-kGeQu8lmTPwoK9iP05pm1QhJuZULoIYL6pS6_gx7E7xc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKghZr4pkkZbisn-NnGIwJkI9BxpYXkSso8oJgzjOUPdQ&oe=6AB143E6"}, "display_name": "Mind Reset VR", "keywords": ["hypnosis", "mindfulness", "insomnia", "habits", "wellbeing"], "long_description": "Next-level technology for your downtime.\n\nMindReset turns your headset into a personal audiovisual studio for\nrelaxation and focus, built with pro audio technology and AI.\nOne premium purchase. No subscriptions, no ads, no internet. Yours forever.\n\n14 IMMERSIVE PROGRAMS\nWillpower \u00b7 Calm \u00b7 Unwind \u00b7 Night Drift \u00b7 Inner Light \u00b7 Gratitude \u00b7 Focus \u00b7\nInner Strength \u00b7 Confidence \u00b7 Motivation \u00b7 Balance \u00b7 Clarity \u00b7 Unplug \u00b7 Discipline.\nEach one: 5 sessions, 5 quick 5-minute sessions, and guided breathing rhythms\n(4-7-8, box).\n\n55+ HOURS OF MASTERED AUDIO\nAI narration in native English and Spanish, layered affirmations, binaural\nstereo design (delta to gamma, 40 Hz), nature soundscapes, 3D-panned music,\nLUFS-normalized at 320 kbps. Sessions up to 30 min with identical perceived\nloudness \u2014 no jarring volume jumps.\n\n7 IMMERSIVE WORLDS\nForests, night city, beach, an alien jungle, the entire solar system and a\nsanctuary of light \u2014 each with its own comfort-first living tour.\n\nREAL-TIME GENERATIVE ART\n14 visual acts generated in code on your headset: mandalas, auroras, ocean\nwaves, flocks of light, comets...\n\nHAPTIC FEEDBACK\nGentle vibration through the controllers and a breathing sphere that pulses\nwith every phase.\n\nPROGRESS\n28-day plan, streaks, stats and smart resume to the exact second. All local \u2014\nno cloud, no accounts.\n\nAn entertainment and relaxation experience.", "short_description": "Unwind and refocus. 14 immersive audio programs and 55+ hours of studio-grade sound.\n\nMindReset is an immersive relaxation and focus experience on Quest.\n14 guided audio journeys, 55+ hours of studio-mastered sound, 7 living\nworlds with cinematic tours, real-time generative art, and gentle haptic\nvibration synced to your breathing. Full English and Spanish. 100% offline."}]}, "developer_name": null, "developer_privacy_policy_url"
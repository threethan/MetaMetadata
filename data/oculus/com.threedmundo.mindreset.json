d": "1089830723483030"}]}, "id": "975129688874092"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1089632290169540"}]}, "id": "2199905670808037"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1080980721034697"}]}, "id": "1918693155460819"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1078277797971656"}]}, "id": "1540912091157854"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "8659496074075907"}]}, "id": "756067645443626"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "5891786154170029"}]}, "id": "1030126614306267"}]}}, "firstRevision": {"nodes": [{"application": {"id": "1094266553039447", "release_date": 1789565280, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1131759055956863"}, "id": "1051159074175653"}]}}, "binary": {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1094266553039447", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1131759055956863"}, "release_status": "RELEASED"}, "id": "1131759055956863", "version": "1.2", "version_code": 11, "release_status": "RELEASED", "status": "APPROVED"}, "live_binary": null, "created_date": 1785546532, "id": "1094266576372778", "is_initial_release": true, "name_with_fallback": "v1", "pdp_metadata_with_fallback": {"version": 1, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "1131748265957942"}, "release_status": "RELEASED", "id": "1094266553039447"}, "id": "1131748265957942", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": true, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1094266553039447", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1077251631309139"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "3283095218748018", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mind Reset VR", "keywords": ["ansiedad", "fumar", "relajar", "cuidado"], "long_description": "Tu mente merece tecnolog\u00eda de otro nivel.\n\nMindReset convierte tu visor en un estudio audiovisual completo, con audio de grado profesional e IA. Una sola compra premium. Sin suscripciones, sin anuncios, sin internet. Tuyo para siempre.\n\n14 PROGRAMAS \nDeja de Fumar \u00b7 Calma la Ansiedad \u00b7 Libera el Estr\u00e9s \u00b7 Dormir Profundo \u00b7 Luz Interior \u00b7 Gratitud \u00b7 Enfoque Total \u00b7 Autoestima \u00b7 Confianza \u00b7 Motivaci\u00f3n \u00b7 Menos Az\u00facar \u00b7 Libre del Alcohol \u00b7 Menos Pantallas \u00b7 Peso Saludable. Cada uno: 5 sesiones, 5 refuerzos SOS (5:00, lo que dura un impulso) y respiraci\u00f3n guiada (4-7-8, caja).\n\n+55 HORAS DE AUDIO MASTERIZADO\nVoz hipn\u00f3tica con IA en espa\u00f1ol e ingl\u00e9s nativos, afirmaciones subliminales, frecuencias binaurales (de delta a gamma 40 Hz), naturaleza, m\u00fasica con paneo 3D y normalizaci\u00f3n LUFS a 320 kbps. Sesiones de hasta 30 min con volumen id\u00e9ntico, seguras para dormirse.\n\n7 MUNDOS INMERSIVOS\nBosques, ciudad nocturna, playa, selva alien\u00edgena, sistema solar completo y santuario de luz, cada uno con recorrido vivo dise\u00f1ado sin mareo.\n\nARTE GENERATIVO EN TIEMPO REAL\n14 actos visuales generados por c\u00f3digo: mandalas, auroras, olas luminosas, bandadas de luz, cometas...\n\nH\u00c1PTICA TERAP\u00c9UTICA\nMasaje de cuello con los controles y esfera de respiraci\u00f3n que vibra por fase.\n\nPROGRESO\nPlan de 28 d\u00edas, rachas, estad\u00edsticas y reanudaci\u00f3n al segundo exacto. Todo en tu visor, sin cuentas.\n\nHerramienta de bienestar y relajaci\u00f3n. No es tratamiento m\u00e9dico.", "short_description": "Reinicia tu mente. 14 sesiones inmersivas y m\u00e1s de 55 horas de audio de estudio.\nMindReset es una herramienta para el bienestar y el entrenamiento profundo\nde tu mente: la plataforma revolucionaria de terapia inmersiva en Quest.\n14 programas guiados, m\u00e1s de 55 horas de audio masterizado,\n7 mundos con recorridos vivos, arte generativo en tiempo real y masaje\nh\u00e1ptico sincronizado con tu respiraci\u00f3n. En espa\u00f1ol e ingl\u00e9s. 100% sin\nconexi\u00f3n.\n"}, {"images": {"nodes": [{"file_name": "cover_hero_3000x900.png", "id": "1655573649513063", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619668_1655573652846396_4466523137018471591_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0AZXlo_4EMQ7kNvwHA7PTc&_nc_oc=AdpmieDufQzpHCloYS3Ar85GVZFOVg1A_of69C6-aXqEr80PSSrj6SQdz8TJUo8YDx4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7VFWEqZ_dYDr05W6gIdf0zjHjWKg43tk06-fk_YStCw&oe=6AB154BB"}, {"file_name": "icon_512x512.png", "id": "1649310379931613", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622211_1649310383264946_7619828457816164294_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mlWf5YPxAIQ7kNvwEjEbBb&_nc_oc=AdrO8LNa0QXSCkIkKeOJaKqtPi-TuG-ttDddN0e0cpcScbGlFcbvx3_wocsEG2D8ylM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbEkEXWx52BzdTlznAP36Ys-w3jIueElkgkGUTyGoOyQ&oe=6AB149EC"}, {"file_name": "cover_square_1440x1440.png", "id": "1415334000453288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620940_1415334003786621_2046282799370749712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oxmHhwcihcQ7kNvwGMhJto&_nc_oc=AdpQlYoZyWxgB7YxBJ56Gx8Tw5F7rs3U
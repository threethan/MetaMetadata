://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12482156_2022187917821513_8118850926728445952_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThnjT9YJsGoQ7kNvwHWKXTG&_nc_oc=Adnp8PmjWHVR_vv6pwCRd-qP4OBkgd9-O_YROoEau63u0Da4r6jIF2b841m-QYXUtys&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsPvsgCBabxq1y-XGGFQa0h0oe_0duCQBQUo5F8X-nbFA&oe=699C52DB"}, {"file_name": "migrated_image.png", "id": "920065201742843", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139031_154219158620697_9075024678199754752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPsYgQvSGdIQ7kNvwGk8ZKE&_nc_oc=AdlD-WzqHniBFHOiktq0omE47h1DLXGl8dIFy1Z5qwepU4Ob7rAAOpHGJTCjCW2XWRc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftdJr1NQiMzQJ0ue0KLVvOPHO9UNOwhGmQYjjkoTP_wLw&oe=699C31A0"}, {"file_name": "migrated_image.png", "id": "232543251214464", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12504730_760985997442787_2767711066237435904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScXhKS52aZ0Q7kNvwGRcMiM&_nc_oc=AdmtKfhq13j5jh7At1NanIZUwY8OMFjlhO9JdqWHCTwbNXbIBdMGfeFfq1IkZpu6XW8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfstGjYv2iTMKLVF0yrarG7iUOby1M_GK6ELzo62uyhcoQ&oe=699C3300"}, {"file_name": "migrated_image.png", "id": "221737232361879", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410200_225380458022006_4982043835795243008_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5nkGlPt8nQQ7kNvwH17ikg&_nc_oc=AdlMHkX-ACI2EQCqJitcAmNPRia8mULBWpHB1bPn2nxQPe5pc-nDGo3d0lEMYBumHNs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuDwIfqKbn6CmXaQns81IDGIYU0PL4vflf9B90ZmevEcA&oe=699C376A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "151395935542566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386220_151395938875899_6172689287998341120_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cl4_-8ny9oIQ7kNvwFE-b1D&_nc_oc=Adlg9ibrx_7P4TOAzj1o4_aKyDFU5jwhSP9PSP2FfumIW31i7i83qNQvVBgPJRUWssg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftpQSPbU8ARhaa3nbppto7k4X480GjsRMfRrRQdaJfwVA&oe=699C33EE"}, "display_name": "The ArcSlinger", "keywords": ["Arcslinger", "shooter", "western", "cartoon", "arcade"], "long_description": "When the world is in danger, the people turn to a hero. Entrusted with the mythical gun Angelheart, you must take down the villainous Gold Smoke and his dastardly gang. Do you have what it takes to become The Arcslinger?\n\n- An original story and universe\n- Discover dozens of Arcs and sling them to unleash incredible powers\n- 15 levels of first-person shooter VR fun\n- Become a master gunslinger as you fight your way to saving the world\n- Featuring the voice talents of Nolan North, Jessica DiCicco, Roger Craig Smith, and Jason Spisak", "short_description": "Enter the world of The Arcslinger, an original cyber western where you play as the unlikely hero of this story. Shoot your way through the game\u2019s 15 rogue-like levels, collecting Arcs to power up your wise-cracking gun, Angelheart. Become a master gunslinger and unleash powerful abilities to take down Gold Smoke and his gang before he can take the power of the Arc for himself. The game features the voice talents of Nolan North, Jessica DiCicco, Roger Craig Smith, and Jason Spisak."}]}, "developer_name": "Big Red Button Entertainment", "developer_privacy_policy_url": "http://www.brbent.com/", "developer_terms_of_service_url": "http://www.brbent.com/", "publisher_name": "Big Red Button Entertainment", "support_website_url": null, "website_url": "http://www.brbent.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
5/12504730_760985997442787_2767711066237435904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84L9V0ypahcQ7kNvwE3kYB2&_nc_oc=AdmM2tk6R0X6ggDyJpChc4R9SuKJJFAyng2qQhM8TLFXXU9sRvNKxHBWrvZNzp6vVC4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvG6QdNJKoOmajb1tlLMRliJDNW9m-PCDR70yeeOcEiuQ&oe=69A56D80"}, {"file_name": "migrated_image.png", "id": "221737232361879", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410200_225380458022006_4982043835795243008_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7RSRwBK-C4Q7kNvwEMhx0i&_nc_oc=AdlEq4hgAOjo-8QaQsM6ZWlVERre5S_R4V4GhpCF9HiO34XeP941Ai2pnoJkWhdeOyw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afswv6FffE9pGUGQh9-GvnoR8JBoNthyeQs-5yNsUxlEzw&oe=69A571EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "151395935542566", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12386220_151395938875899_6172689287998341120_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBIdEhyApikQ7kNvwH3Yjh1&_nc_oc=AdmKYXL3cQ-i-HdJh7PFdr3lGvAz9oWgAPwr08-hEgFeQcIs1jTRoSISb1jpdrcrxno&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvuC5jnNKM7lMwq3Gl-zOeiirNmTyyuVl-_nCKsPqgJig&oe=69A56E6E"}, "display_name": "The ArcSlinger", "keywords": ["Arcslinger", "shooter", "western", "cartoon", "arcade"], "long_description": "When the world is in danger, the people turn to a hero. Entrusted with the mythical gun Angelheart, you must take down the villainous Gold Smoke and his dastardly gang. Do you have what it takes to become The Arcslinger?\n\n- An original story and universe\n- Discover dozens of Arcs and sling them to unleash incredible powers\n- 15 levels of first-person shooter VR fun\n- Become a master gunslinger as you fight your way to saving the world\n- Featuring the voice talents of Nolan North, Jessica DiCicco, Roger Craig Smith, and Jason Spisak", "short_description": "Enter the world of The Arcslinger, an original cyber western where you play as the unlikely hero of this story. Shoot your way through the game\u2019s 15 rogue-like levels, collecting Arcs to power up your wise-cracking gun, Angelheart. Become a master gunslinger and unleash powerful abilities to take down Gold Smoke and his gang before he can take the power of the Arc for himself. The game features the voice talents of Nolan North, Jessica DiCicco, Roger Craig Smith, and Jason Spisak."}]}, "developer_name": "Big Red Button Entertainment", "developer_privacy_policy_url": "http://www.brbent.com/", "developer_terms_of_service_url": "http://www.brbent.com/", "publisher_name": "Big Red Button Entertainment", "support_website_url": null, "website_url": "http://www.brbent.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "630491738178123"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "120120035521989"}, {"status": "PUBLISHED", "id": "2452346664850359"}, {"status": "PUBLISHED", "id": "972960649527361"}, {"status": "PUBLISHED", "id": "216900775596415"}, {"status": "PUBLISHED", "id": "374110796865312"}, {"status": "PENDING", "id": "1841622785889388"}, {"status": "PUBLISHED", "id": "200995100534500"}, {"status": "PUBLISHED", "id": "572314000230253"}, {"status": "PUBLISHED", "id": "764191934012039"}, {"status": "PUBLISHED", "id": "250206725539099"}, {"status": "PENDING", "id": "173184913344775"}, {"status": "PUBLISHED", "id": "2260137530762169"}, {"status": "PUBLISHED", "id": "291462761451264"}]}, "ba
://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12482156_2022187917821513_8118850926728445952_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYoa8Z75sKsQ7kNvwEag-8b&_nc_oc=Adm_KRLFptS2Jy8WVLP1kndX4m7LoFZks1LsJvBEdnZr7rKyrhBAbQI8WQDCWAgj244&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftmobJTG6GHutgRl6M8LFDvUsaDGGtCzWS1lnSSfMalqg&oe=69A6DEDB"}, {"file_name": "migrated_image.png", "id": "920065201742843", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139031_154219158620697_9075024678199754752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THnIhmy1L-EQ7kNvwFyqvaj&_nc_oc=AdkLBUG5vTtn8G-eHotzpIIniYKSAhiR9fMgKnMbbMk2jLpUCvBgk0kYqdpu9-KMJos&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuotkTjwyM1O-g44ncekrzTrk2lqbOOL-MntSu3Bvpx-g&oe=69A6BDA0"}, {"file_name": "migrated_image.png", "id": "232543251214464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504730_760985997442787_2767711066237435904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ch0xBXtxdIQQ7kNvwG3bHh8&_nc_oc=AdmAQU31x6Hi5FDaN3XqNeHLS4Xw7tSYAY6wtw_KU-_uBY9l_yPWHoZZcLEl-EgRDig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuSOasH4PeoAWx783GauHMOGvwBtvHHt4PAz1Sa6l8g8w&oe=69A6BF00"}, {"file_name": "migrated_image.png", "id": "221737232361879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410200_225380458022006_4982043835795243008_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7RSRwBK-C4Q7kNvwGeBrFE&_nc_oc=AdkcrbP8B759MXSeia4noLvB5aIBZ2mvm3KsOL99JyzKNgm4bUABGXfLQT04U-JAFig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu2LwljLzxXXwmETQkjv0DutpzQ6YXMnexNUuqZey-HxA&oe=69A6C36A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "151395935542566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386220_151395938875899_6172689287998341120_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBIdEhyApikQ7kNvwE6J8eK&_nc_oc=Adn4eMBHLxgiul1PC1TIX4v0hzh95IUrVcL-p54aasEir6bLNOpWgIDzm28pJjax-5s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftHfDzkXdTKVIUG4mkPwgsWUe7BMUYYYy7A8aSHz2aKbQ&oe=69A6BFEE"}, "display_name": "The ArcSlinger", "keywords": ["Arcslinger", "shooter", "western", "cartoon", "arcade"], "long_description": "When the world is in danger, the people turn to a hero. Entrusted with the mythical gun Angelheart, you must take down the villainous Gold Smoke and his dastardly gang. Do you have what it takes to become The Arcslinger?\n\n- An original story and universe\n- Discover dozens of Arcs and sling them to unleash incredible powers\n- 15 levels of first-person shooter VR fun\n- Become a master gunslinger as you fight your way to saving the world\n- Featuring the voice talents of Nolan North, Jessica DiCicco, Roger Craig Smith, and Jason Spisak", "short_description": "Enter the world of The Arcslinger, an original cyber western where you play as the unlikely hero of this story. Shoot your way through the game\u2019s 15 rogue-like levels, collecting Arcs to power up your wise-cracking gun, Angelheart. Become a master gunslinger and unleash powerful abilities to take down Gold Smoke and his gang before he can take the power of the Arc for himself. The game features the voice talents of Nolan North, Jessica DiCicco, Roger Craig Smith, and Jason Spisak."}]}, "developer_name": "Big Red Button Entertainment", "developer_privacy_policy_url": "http://www.brbent.com/", "developer_terms_of_service_url": "http://www.brbent.com/", "publisher_name": "Big Red Button Entertainment", "support_website_url": null, "website_url": "http://www.brbent.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12482156_2022187917821513_8118850926728445952_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZihS5EhKt0Q7kNvwHQX3kU&_nc_oc=Admn1H5URODLtd_-6xkfOXZpJx3FLAg3ulH3jNRzVQWfjQ8WWvSY_9ZPd2ShRk2pryE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuYV8LUfpxu6bpkmnQqmrf3aBAM58j8JG73MafNVc1lxw&oe=69A0475B"}, {"file_name": "migrated_image.png", "id": "920065201742843", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139031_154219158620697_9075024678199754752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNdKwaU2aWIQ7kNvwF8t25C&_nc_oc=AdkzvFDItRMA6U3dqL5cUGa0WBNfQVDNrUcf-Rj2wggeX0oPHA8kkYtX04cpkkTmkos&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuyMQFI6MNTvUcrgUKvMseqvsMyG9JpUX-P2w3if28_tA&oe=69A02620"}, {"file_name": "migrated_image.png", "id": "232543251214464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504730_760985997442787_2767711066237435904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Q8MAI6BIcQQ7kNvwEJTgZj&_nc_oc=AdnS1Fbc4geTk0bzAMTQz-4uoe3sck_kgWDqIw2ui8Q4uAqXqYnlz8iDx9WsEf2OYHs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu17TQXnP9wutAFFaLX2hyjfvapN1G-KQ2eRKC76c-RUw&oe=69A02780"}, {"file_name": "migrated_image.png", "id": "221737232361879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410200_225380458022006_4982043835795243008_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E92EnLpm9WIQ7kNvwENO5Xl&_nc_oc=AdlwOMtwnAUtxjhvVmN7dYEZJGzQrru8wFBu0rYc4P484lm2vSfwaIVpa093zeqjI28&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftK-8-OHWrzeod56F6slDNh3LhtnQAGsXi0-DEIU3aPqw&oe=69A02BEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "151395935542566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386220_151395938875899_6172689287998341120_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjF_6TB4K2EQ7kNvwHMfCty&_nc_oc=Adn3JXIC2yGgZYs4TTyi6lEJ78Xo-s4pWZ9qT8SEqMdW-6BBOPqU1WGaXzb4nPXRH54&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftJdsvzLRev9SagN5j407mTZMcv6HRqtvsy1yIQodazDg&oe=69A0286E"}, "display_name": "The ArcSlinger", "keywords": ["Arcslinger", "shooter", "western", "cartoon", "arcade"], "long_description": "When the world is in danger, the people turn to a hero. Entrusted with the mythical gun Angelheart, you must take down the villainous Gold Smoke and his dastardly gang. Do you have what it takes to become The Arcslinger?\n\n- An original story and universe\n- Discover dozens of Arcs and sling them to unleash incredible powers\n- 15 levels of first-person shooter VR fun\n- Become a master gunslinger as you fight your way to saving the world\n- Featuring the voice talents of Nolan North, Jessica DiCicco, Roger Craig Smith, and Jason Spisak", "short_description": "Enter the world of The Arcslinger, an original cyber western where you play as the unlikely hero of this story. Shoot your way through the game\u2019s 15 rogue-like levels, collecting Arcs to power up your wise-cracking gun, Angelheart. Become a master gunslinger and unleash powerful abilities to take down Gold Smoke and his gang before he can take the power of the Arc for himself. The game features the voice talents of Nolan North, Jessica DiCicco, Roger Craig Smith, and Jason Spisak."}]}, "developer_name": "Big Red Button Entertainment", "developer_privacy_policy_url": "http://www.brbent.com/", "developer_terms_of_service_url": "http://www.brbent.com/", "publisher_name": "Big Red Button Entertainment", "support_website_url": null, "website_url": "http://www.brbent.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
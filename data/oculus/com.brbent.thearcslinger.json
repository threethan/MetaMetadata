pNkfkT-2A6vPZw8gwrlKXC0GFKLrBvY-wknpm4C38AuWmYDcWnC4bksK1HgT_kcCI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lPc5kCbVtutuLlf0ry4wIjubxiqv_GPFt2AqrLgAHRg&oe=69E8E0E0"}, {"file_name": "migrated_image.png", "id": "232543251214464", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12504730_760985997442787_2767711066237435904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TS8F_zoazGQQ7kNvwGFiRNt&_nc_oc=Adrcvtiy1yNXenlfFAcl_LBD24-YHkg7sXIxoeCWDaxllyeeGMu8U6APHi1XbJhTUPU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QJAJWG7C6-RqOVgz6_w09VKbLPMI9vP7CiyI9f621zw&oe=69E8AA00"}, {"file_name": "migrated_image.png", "id": "221737232361879", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410200_225380458022006_4982043835795243008_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2sQt2w0omEQ7kNvwFcVahn&_nc_oc=Adr7_M_LpGaeylKRcqN74bGmyPB5rjIRNPw-ImWgINf5bqWLHXSq8H3oRF8vEJBe0TA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2d3dMEc78f9PppZBjyxniDDwkGRmiOKpc88yJp20j0Jw&oe=69E8AE6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "151395935542566", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386220_151395938875899_6172689287998341120_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pNK-H32vN0Q7kNvwEIghid&_nc_oc=Adrw6dIL63iHplEnTyS8VZz8Pt2A2LbpM9Fo6tGWE_4sKrjJ6KH2MXOu9yCWbS9oe4A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28i2Scins4Gw03a1h1wcOQDSOSar-vHjhJwatcfBHT5Q&oe=69E8AAEE"}, "display_name": "The ArcSlinger", "keywords": ["Arcslinger", "shooter", "western", "cartoon", "arcade"], "long_description": "When the world is in danger, the people turn to a hero. Entrusted with the mythical gun Angelheart, you must take down the villainous Gold Smoke and his dastardly gang. Do you have what it takes to become The Arcslinger?\n\n- An original story and universe\n- Discover dozens of Arcs and sling them to unleash incredible powers\n- 15 levels of first-person shooter VR fun\n- Become a master gunslinger as you fight your way to saving the world\n- Featuring the voice talents of Nolan North, Jessica DiCicco, Roger Craig Smith, and Jason Spisak", "short_description": "Enter the world of The Arcslinger, an original cyber western where you play as the unlikely hero of this story. Shoot your way through the game\u2019s 15 rogue-like levels, collecting Arcs to power up your wise-cracking gun, Angelheart. Become a master gunslinger and unleash powerful abilities to take down Gold Smoke and his gang before he can take the power of the Arc for himself. The game features the voice talents of Nolan North, Jessica DiCicco, Roger Craig Smith, and Jason Spisak."}]}, "developer_name": "Big Red Button Entertainment", "developer_privacy_policy_url": "http://www.brbent.com/", "developer_terms_of_service_url": "http://www.brbent.com/", "publisher_name": "Big Red Button Entertainment", "support_website_url": null, "website_url": "http://www.brbent.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "630491738178123"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "120120035521989"}, {"status": "PUBLISHED", "id": "2452346664850359"}, {"status": "PUBLISHED", "id": "972960649527361"}, {"status": "PUBLISHED", "id": "216900775596415"}, {"status": "PUBLISHED", "id": "374110796865312"}, {"status": "PENDING", "id": "1841622785889388"}, {"s
h2sw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvVDj70jzYvmYurDZF-SZOmckoU6h2BAfI9t5AWx8XCQQ&oe=699ED6EE"}, "display_name": "The ArcSlinger", "keywords": ["Arcslinger", "shooter", "western", "cartoon", "arcade"], "long_description": "When the world is in danger, the people turn to a hero. Entrusted with the mythical gun Angelheart, you must take down the villainous Gold Smoke and his dastardly gang. Do you have what it takes to become The Arcslinger?\n\n- An original story and universe\n- Discover dozens of Arcs and sling them to unleash incredible powers\n- 15 levels of first-person shooter VR fun\n- Become a master gunslinger as you fight your way to saving the world\n- Featuring the voice talents of Nolan North, Jessica DiCicco, Roger Craig Smith, and Jason Spisak", "short_description": "Enter the world of The Arcslinger, an original cyber western where you play as the unlikely hero of this story. Shoot your way through the game\u2019s 15 rogue-like levels, collecting Arcs to power up your wise-cracking gun, Angelheart. Become a master gunslinger and unleash powerful abilities to take down Gold Smoke and his gang before he can take the power of the Arc for himself. The game features the voice talents of Nolan North, Jessica DiCicco, Roger Craig Smith, and Jason Spisak."}]}, "developer_name": "Big Red Button Entertainment", "developer_privacy_policy_url": "http://www.brbent.com/", "developer_terms_of_service_url": "http://www.brbent.com/", "publisher_name": "Big Red Button Entertainment", "support_website_url": null, "website_url": "http://www.brbent.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
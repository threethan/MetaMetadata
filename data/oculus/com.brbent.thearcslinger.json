://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12482156_2022187917821513_8118850926728445952_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tiCJeaHX_8AQ7kNvwGLruZ6&_nc_oc=AdlqnsMKOvP49XWWd_QFmr-Y0obmLCba5YIKKIvBnvBbDWH8Ug6JtNKUNWauLj3IQZE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afuwdloa_dittgzTYo4aBy-uIKK8deIwvKAXpkaQB5hmUA&oe=69A43BDB"}, {"file_name": "migrated_image.png", "id": "920065201742843", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139031_154219158620697_9075024678199754752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyYsVHK724gQ7kNvwEGpII1&_nc_oc=Adn3T7NwNzUA5ZuB9KiA8uST7q65C1W57Akg2ZEerLcHlmoIlzYW6zh2gbrsxfolGhI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs4WQdiXwFDLU6AvbxIXQySUk3oxx3Xq2vTgS60ayFKJw&oe=69A41AA0"}, {"file_name": "migrated_image.png", "id": "232543251214464", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12504730_760985997442787_2767711066237435904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84L9V0ypahcQ7kNvwE_9QDL&_nc_oc=Adm-uaA-VNjCM5Quet0Ghk1xaaO2zjlFOGwPdHYbIAPyZkLhws3WDFFVrKu76cuw-dQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvCRcAnN8ocCmBjxNwZ2_z2jzpoRpc_9e5p97Kz7Vzi6A&oe=69A41C00"}, {"file_name": "migrated_image.png", "id": "221737232361879", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410200_225380458022006_4982043835795243008_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0wwRWpJLYkQ7kNvwHZIybc&_nc_oc=AdkLY_NWAn0o4u2ZBpjk46bWikm5IrJe5zSHmO7rhO2UUsrHkTDhl1zuIrQTf2L2njA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuZcgBwAXjdckHHID2uMqnATbiiPdc6evZ7kDAUpzm4ow&oe=69A4206A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "151395935542566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386220_151395938875899_6172689287998341120_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=905hhC1WajIQ7kNvwGrKm8F&_nc_oc=AdlBZuR7AQ24TcyifLBCXt5X-hzSIGWuwPHxXudfrKcfy_W5ZgtzWIYIf69dFKztUoc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs4_QSOLI5HDfLoNlA8vAleKay9UMVVbB_3VNncS9p_AA&oe=69A41CEE"}, "display_name": "The ArcSlinger", "keywords": ["Arcslinger", "shooter", "western", "cartoon", "arcade"], "long_description": "When the world is in danger, the people turn to a hero. Entrusted with the mythical gun Angelheart, you must take down the villainous Gold Smoke and his dastardly gang. Do you have what it takes to become The Arcslinger?\n\n- An original story and universe\n- Discover dozens of Arcs and sling them to unleash incredible powers\n- 15 levels of first-person shooter VR fun\n- Become a master gunslinger as you fight your way to saving the world\n- Featuring the voice talents of Nolan North, Jessica DiCicco, Roger Craig Smith, and Jason Spisak", "short_description": "Enter the world of The Arcslinger, an original cyber western where you play as the unlikely hero of this story. Shoot your way through the game\u2019s 15 rogue-like levels, collecting Arcs to power up your wise-cracking gun, Angelheart. Become a master gunslinger and unleash powerful abilities to take down Gold Smoke and his gang before he can take the power of the Arc for himself. The game features the voice talents of Nolan North, Jessica DiCicco, Roger Craig Smith, and Jason Spisak."}]}, "developer_name": "Big Red Button Entertainment", "developer_privacy_policy_url": "http://www.brbent.com/", "developer_terms_of_service_url": "http://www.brbent.com/", "publisher_name": "Big Red Button Entertainment", "support_website_url": null, "website_url": "http://www.brbent.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
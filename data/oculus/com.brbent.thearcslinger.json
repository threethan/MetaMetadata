qZhZU4VBwtFz6F68v6tvjHwedp6JXtvNcO22tkreWx9CxaLpO0_3zuGhgUFLam3D0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8SUpvsKEVqV3R0qvuUNJT7CzBMMyzzXvHnY7kt3IeoQ&oe=6AE9F560"}, {"file_name": "migrated_image.png", "id": "232543251214464", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12504730_760985997442787_2767711066237435904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJXFnvYonRcQ7kNvwEPqrtB&_nc_oc=Adq1TCEXiPMDrw6fawkwQJ979TVIQsm3qKyKfQYV9OeDBz8HoSUS4R5iTT7hEDTBdyQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQa9isHSFbMOgukV02Sk1qS-J2dr6MoG4FJqWqx680Qyg&oe=6AE9F6C0"}, {"file_name": "migrated_image.png", "id": "221737232361879", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410200_225380458022006_4982043835795243008_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9IDCdn4Nh0Q7kNvwEszEbc&_nc_oc=Adp3n8EtpJqSoVaRYV0YqTW7DIdpbdZyZI1T9NfFY5Rs_WTqaS8oUmqNnU8Obx8qGNk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrN_38W3czUZFqqIfBM1u_03jGEXgZFa4aX0gU1LgwcA&oe=6AE9FB2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "151395935542566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386220_151395938875899_6172689287998341120_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovEBZ4pXeV8Q7kNvwGnQjm_&_nc_oc=AdqbT4dvvWylKuVh4WINX7tZcp_cyH3VSymk1SU46OfQBbOLUktFctOVDzEFshr_CT8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgTe690ZFkQpy_uo6d2w6YmkyYB4SujcapRnOskYAlTQ&oe=6AE9F7AE"}, "display_name": "The ArcSlinger", "keywords": ["Arcslinger", "shooter", "western", "cartoon", "arcade"], "long_description": "When the world is in danger, the people turn to a hero. Entrusted with the mythical gun Angelheart, you must take down the villainous Gold Smoke and his dastardly gang. Do you have what it takes to become The Arcslinger?\n\n- An original story and universe\n- Discover dozens of Arcs and sling them to unleash incredible powers\n- 15 levels of first-person shooter VR fun\n- Become a master gunslinger as you fight your way to saving the world\n- Featuring the voice talents of Nolan North, Jessica DiCicco, Roger Craig Smith, and Jason Spisak", "short_description": "Enter the world of The Arcslinger, an original cyber western where you play as the unlikely hero of this story. Shoot your way through the game\u2019s 15 rogue-like levels, collecting Arcs to power up your wise-cracking gun, Angelheart. Become a master gunslinger and unleash powerful abilities to take down Gold Smoke and his gang before he can take the power of the Arc for himself. The game features the voice talents of Nolan North, Jessica DiCicco, Roger Craig Smith, and Jason Spisak."}]}, "developer_name": "Big Red Button Entertainment", "developer_privacy_policy_url": "http://www.brbent.com/", "developer_terms_of_service_url": "http://www.brbent.com/", "publisher_name": "Big Red Button Entertainment", "support_website_url": null, "website_url": "http://www.brbent.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "630491738178123"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "120120035521989"}, {"status": "PUBLISHED", "id": "2452346664850359"}, {"status": "PUBLISHED", "id": "972960649527361"}, {"status": "PUBLISHED", "id": "216900775596415"}, {"status": "PUBLISHED", "id": "374110796865312"}, {"status": "PENDING", "id": "1841622785889388"}, {"s
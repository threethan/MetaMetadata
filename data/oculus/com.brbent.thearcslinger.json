://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12482156_2022187917821513_8118850926728445952_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThnjT9YJsGoQ7kNvwGVT3Fa&_nc_oc=AdlWupFJluCxw54PwLWiy1QWqNqsTFMccDDJs6wIJ7koKV4T2GxFBYwbGIF3ub-pNmY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsjxsG2vDXkl8B5xZ88sK--nNcsrNwj50UdwrJid8TL2A&oe=6999AFDB"}, {"file_name": "migrated_image.png", "id": "920065201742843", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139031_154219158620697_9075024678199754752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaQPdB-aaXQQ7kNvwEaj8mo&_nc_oc=Adn_OvBn4r_gnO1itsh7DqIxgLYYeE1oxULr82FFD2as0ITNkIQeBb-nHx5giHw_W4Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs5C1MHPtxv5795_Z9rU71RgBjHBXtykSvF-hFklIheSQ&oe=69998EA0"}, {"file_name": "migrated_image.png", "id": "232543251214464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504730_760985997442787_2767711066237435904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTUc-vxRV8wQ7kNvwHGT6a9&_nc_oc=AdlYr44cATXj-Cf0bJWx1m97Wu6GKSjj-9pny7S7zZyOFFnoJvz8E-GFdkaWbc7ufAA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsJ8qRbWEDO56Nj_QUIx8Wkf4EkZPJFd2FZmCNI0GXkhA&oe=69999000"}, {"file_name": "migrated_image.png", "id": "221737232361879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410200_225380458022006_4982043835795243008_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5nkGlPt8nQQ7kNvwGxEmlo&_nc_oc=AdlcT968YnrzeT0fyTs6wYHK10dfqnneZMmXJGux7lzVBQc6E3GjdC1l5Mg-4nOT8I0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfumQqBdkrYyQoKIEGYVSb7bX1GiTWW3oqzGlnhhRDNsZQ&oe=6999946A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "151395935542566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386220_151395938875899_6172689287998341120_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cl4_-8ny9oIQ7kNvwGPVgOU&_nc_oc=AdkkYbacjVUmQTwys0UnR_gZGrUM5_x47QwXYBjRBb5Xqf_L22xufMZy-fXFjepuJrU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv-IgknvSbL6Vxja28gcgWkL5Ix-XIwa4YQdKJ6JXSUXQ&oe=699990EE"}, "display_name": "The ArcSlinger", "keywords": ["Arcslinger", "shooter", "western", "cartoon", "arcade"], "long_description": "When the world is in danger, the people turn to a hero. Entrusted with the mythical gun Angelheart, you must take down the villainous Gold Smoke and his dastardly gang. Do you have what it takes to become The Arcslinger?\n\n- An original story and universe\n- Discover dozens of Arcs and sling them to unleash incredible powers\n- 15 levels of first-person shooter VR fun\n- Become a master gunslinger as you fight your way to saving the world\n- Featuring the voice talents of Nolan North, Jessica DiCicco, Roger Craig Smith, and Jason Spisak", "short_description": "Enter the world of The Arcslinger, an original cyber western where you play as the unlikely hero of this story. Shoot your way through the game\u2019s 15 rogue-like levels, collecting Arcs to power up your wise-cracking gun, Angelheart. Become a master gunslinger and unleash powerful abilities to take down Gold Smoke and his gang before he can take the power of the Arc for himself. The game features the voice talents of Nolan North, Jessica DiCicco, Roger Craig Smith, and Jason Spisak."}]}, "developer_name": "Big Red Button Entertainment", "developer_privacy_policy_url": "http://www.brbent.com/", "developer_terms_of_service_url": "http://www.brbent.com/", "publisher_name": "Big Red Button Entertainment", "support_website_url": null, "website_url": "http://www.brbent.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
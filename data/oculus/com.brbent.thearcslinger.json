ile_name": "migrated_image.png", "id": "2609979059286420", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12482156_2022187917821513_8118850926728445952_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYoa8Z75sKsQ7kNvwHyNNsM&_nc_oc=Adnh3v03WyKMavGzGGzaCKdxcH9u33N8nM-kJMJa9iEylBpzHys6W-4xtnbMb2WIy3Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuOMZXiqr5M4uPFGc05m0IFNH60MI42vdOrS9_jcU3bXg&oe=69A8305B"}, {"file_name": "migrated_image.png", "id": "920065201742843", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139031_154219158620697_9075024678199754752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THnIhmy1L-EQ7kNvwHI116z&_nc_oc=Adl4E5c-Om03VHkCoO53SQjko47Gp6vGN3RkoqYvFAVwgin9EllY6vp28P5M-VbzReg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuLUT_0SVMNxLuYhKjhr_UUYom0RmHICKRob59saX57_A&oe=69A80F20"}, {"file_name": "migrated_image.png", "id": "232543251214464", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504730_760985997442787_2767711066237435904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ch0xBXtxdIQQ7kNvwGfGJoy&_nc_oc=AdlPV8qU2SoN5ukOrxA_4qSBqIcv0S6SweIDmNXGWzcSDcCo_q9ySP6Rv3UkIdv9Owk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvkmzo-SPi7n3hCkIDHJ_rhp4k6soG_1TWRI9OstwY6qw&oe=69A81080"}, {"file_name": "migrated_image.png", "id": "221737232361879", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410200_225380458022006_4982043835795243008_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7RSRwBK-C4Q7kNvwHTcrAT&_nc_oc=Adk_PbsTxnstkWCLKK2Jmk4j41XsRJXKewzhoBSg92ppBYMj5dqu_aAc6ihtobNr9Gk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft5EK-UURAcCkyRhqiEnq1kNEzhtQJDxilwMruTSk_w9g&oe=69A814EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "151395935542566", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386220_151395938875899_6172689287998341120_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBIdEhyApikQ7kNvwHIu4uR&_nc_oc=Adkg7XVvfRBmrY24F9xkXHddm0qC9Fxi0Dj6KXk150N3vDSQF_wnx55zhyjB0DEYKdI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuLlWO_o5I5l4PU74mWvRmBG4GKsjv3zXJJH50BAMltPg&oe=69A8116E"}, "display_name": "The ArcSlinger", "keywords": ["Arcslinger", "shooter", "western", "cartoon", "arcade"], "long_description": "When the world is in danger, the people turn to a hero. Entrusted with the mythical gun Angelheart, you must take down the villainous Gold Smoke and his dastardly gang. Do you have what it takes to become The Arcslinger?\n\n- An original story and universe\n- Discover dozens of Arcs and sling them to unleash incredible powers\n- 15 levels of first-person shooter VR fun\n- Become a master gunslinger as you fight your way to saving the world\n- Featuring the voice talents of Nolan North, Jessica DiCicco, Roger Craig Smith, and Jason Spisak", "short_description": "Enter the world of The Arcslinger, an original cyber western where you play as the unlikely hero of this story. Shoot your way through the game\u2019s 15 rogue-like levels, collecting Arcs to power up your wise-cracking gun, Angelheart. Become a master gunslinger and unleash powerful abilities to take down Gold Smoke and his gang before he can take the power of the Arc for himself. The game features the voice talents of Nolan North, Jessica DiCicco, Roger Craig Smith, and Jason Spisak."}]}, "developer_name": "Big Red Button Entertainment", "developer_privacy_policy_url": "http://www.brbent.com/", "developer_terms_of_service_url": "http://www.brbent.com/", "publisher_name": "Big Red Button Entertainment", "support_website_url": null, "website_url": "http://www.brbent.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": 
://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12482156_2022187917821513_8118850926728445952_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvNh-tBFw68Q7kNvwFPvsEp&_nc_oc=Adp1s4Dpl9Qw8EX5wiDXPRoZLzN0bvy39v-1Kn0T7asX2JZ5Sp0YIpSlU0jVGbueFog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0Owjk-Hf57WaKEozKbiXM3KNiU-ZMSt6vm-R6uf_29vQ&oe=69F0B2DB"}, {"file_name": "migrated_image.png", "id": "920065201742843", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139031_154219158620697_9075024678199754752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHEegXaqGQkQ7kNvwHVrRxS&_nc_oc=Adp12Xvzgv7YdQC2mQ-_3_HJE2P3SIMlX80vdPPGAYfxxQkRktqK0jdBNk4cfjeDgoA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1Cw43O1Y2ngI00l1091kQkm863GlGVgTq_pvK-Owb5rg&oe=69F0C9E0"}, {"file_name": "migrated_image.png", "id": "232543251214464", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504730_760985997442787_2767711066237435904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2Z_cWY0xVYQ7kNvwFVM9mO&_nc_oc=AdqpDwCAdIyQAlGOvn-XCqjOSuLFopNIGsAogPD0jsE-kBpAEG3Ht5XQCgjuWdzXqSk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3SXMkyWSOwyrvWHs7t9xfCDvu4vX-4Auj5T9mN9w2qKg&oe=69F0CB40"}, {"file_name": "migrated_image.png", "id": "221737232361879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410200_225380458022006_4982043835795243008_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPTHGHk23UEQ7kNvwEe9rm9&_nc_oc=AdqlfTO3aEKtLis2e5700BvCCfut9yJDVukDJ0oOOhEKGgeEE8iGjzFgS3CAiu8Tskw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3XMDKvccObfXJqD3yz8l4pc4Kln_DVDuxRjJ5g4a3GNg&oe=69F0CFAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "151395935542566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386220_151395938875899_6172689287998341120_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ambEnaZgNegQ7kNvwGfo02o&_nc_oc=AdrAqEhhRej9AWff8cW5HB1eofY97vNXwCTrNsr7ee8BtJFsyag6ysSah65U4XHo4GE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2_IEOK6sbNETkPFQ4ackGlWp2G-a5e8A6RT53vF2QZKg&oe=69F0CC2E"}, "display_name": "The ArcSlinger", "keywords": ["Arcslinger", "shooter", "western", "cartoon", "arcade"], "long_description": "When the world is in danger, the people turn to a hero. Entrusted with the mythical gun Angelheart, you must take down the villainous Gold Smoke and his dastardly gang. Do you have what it takes to become The Arcslinger?\n\n- An original story and universe\n- Discover dozens of Arcs and sling them to unleash incredible powers\n- 15 levels of first-person shooter VR fun\n- Become a master gunslinger as you fight your way to saving the world\n- Featuring the voice talents of Nolan North, Jessica DiCicco, Roger Craig Smith, and Jason Spisak", "short_description": "Enter the world of The Arcslinger, an original cyber western where you play as the unlikely hero of this story. Shoot your way through the game\u2019s 15 rogue-like levels, collecting Arcs to power up your wise-cracking gun, Angelheart. Become a master gunslinger and unleash powerful abilities to take down Gold Smoke and his gang before he can take the power of the Arc for himself. The game features the voice talents of Nolan North, Jessica DiCicco, Roger Craig Smith, and Jason Spisak."}]}, "developer_name": "Big Red Button Entertainment", "developer_privacy_policy_url": "http://www.brbent.com/", "developer_terms_of_service_url": "http://www.brbent.com/", "publisher_name": "Big Red Button Entertainment", "support_website_url": null, "website_url": "http://www.brbent.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
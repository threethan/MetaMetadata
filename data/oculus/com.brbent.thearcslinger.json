://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12482156_2022187917821513_8118850926728445952_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZihS5EhKt0Q7kNvwEjn1kS&_nc_oc=Adl-VRzEIqbq293FNeGqFLqGeXWikP9gmyE-t5QA0vrOy9oGg7WGyblOeqSNhYaibcw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsSqSP8jQz6SNFRUM7kB3GZ3DKHDY8iaBcU1rOqqaltTg&oe=699DA45B"}, {"file_name": "migrated_image.png", "id": "920065201742843", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139031_154219158620697_9075024678199754752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPsYgQvSGdIQ7kNvwFu6jZR&_nc_oc=Adl6NcLQuTfow9-i1cPoMW-0CCYgVpfVNA8RDlEsqp8Q_BCzS6363Bm-WHdhD7Js_F8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv2rMduVaBJquu2Qc79urBCcZn4R5Cn_CtRdW3f0EKdRg&oe=699D8320"}, {"file_name": "migrated_image.png", "id": "232543251214464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504730_760985997442787_2767711066237435904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScXhKS52aZ0Q7kNvwHow1Ea&_nc_oc=AdmpZ2wpw0hZc4iVNf2z4532sb8JQ5_4Fga_8TQc_cALdohGZ_gAq05UnwqFhn9RtEU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuiHPQYALikeoYk6ZWq12A3ekP--1J_Xjdt3Q3CfbdCuw&oe=699D8480"}, {"file_name": "migrated_image.png", "id": "221737232361879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410200_225380458022006_4982043835795243008_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E92EnLpm9WIQ7kNvwFeW7dV&_nc_oc=AdmDapqMggYxm6tIjnTP5w2D3DEMYgASyVykTPY2y9_EAugCM_TRQRtLhg4aXZG5tV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvqjELCKKhTi-gtMAJiiraHg4_2gUXt6dLezZhqiZpjmg&oe=699D88EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "151395935542566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386220_151395938875899_6172689287998341120_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjF_6TB4K2EQ7kNvwE4vQgF&_nc_oc=AdlsmlxofONy3gXr_x778a57QFZrQCUx3cEa61AgeU9l8_aOv71k8O2V189ZHtu-ZKQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsL-eX-ZysISbYKiGez3fEfTc9BLEP_g3HVX6P6RNVzpA&oe=699D856E"}, "display_name": "The ArcSlinger", "keywords": ["Arcslinger", "shooter", "western", "cartoon", "arcade"], "long_description": "When the world is in danger, the people turn to a hero. Entrusted with the mythical gun Angelheart, you must take down the villainous Gold Smoke and his dastardly gang. Do you have what it takes to become The Arcslinger?\n\n- An original story and universe\n- Discover dozens of Arcs and sling them to unleash incredible powers\n- 15 levels of first-person shooter VR fun\n- Become a master gunslinger as you fight your way to saving the world\n- Featuring the voice talents of Nolan North, Jessica DiCicco, Roger Craig Smith, and Jason Spisak", "short_description": "Enter the world of The Arcslinger, an original cyber western where you play as the unlikely hero of this story. Shoot your way through the game\u2019s 15 rogue-like levels, collecting Arcs to power up your wise-cracking gun, Angelheart. Become a master gunslinger and unleash powerful abilities to take down Gold Smoke and his gang before he can take the power of the Arc for himself. The game features the voice talents of Nolan North, Jessica DiCicco, Roger Craig Smith, and Jason Spisak."}]}, "developer_name": "Big Red Button Entertainment", "developer_privacy_policy_url": "http://www.brbent.com/", "developer_terms_of_service_url": "http://www.brbent.com/", "publisher_name": "Big Red Button Entertainment", "support_website_url": null, "website_url": "http://www.brbent.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
069_867883579377746_3506050179350505599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYCRUzuvZ_oQ7kNvwEfEJ7A&_nc_oc=Adq5ahtITuWx8a25_PnBnM_cAZRkn-bvEpPXji5dMOfXCwH045uYl3EbnaQOftsO3Wg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEohJWwpgBFdMfPYIF9n2baGNfbfKrRnXv-qq1tsuTEUw&oe=6A92DFD5"}, {"file_name": "2 Screenshot 2560x1440.png", "id": "1219888766768995", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617762_1219888770102328_625861554141402806_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVBNZMg86jQQ7kNvwEK2Li5&_nc_oc=Adrl8Cipv0DwmN2Mm5VKmjfZlBZhTdegVurtcNtMaAPtK8QuC0U82ChQh8VRDEVwCzA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzvg3Y5x8qfwSBfxq6klmIpbwh7yuDn3BPORbDqSpx2w&oe=6A92D76F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IMVR", "keywords": ["imvr", "interactionwithnature", "longlamai", "Penan", "molong"], "long_description": "IMVR is a co-designed virtual reality experience developed in close collaboration with the Penan community of Long Lamai, Sarawak (East Malaysia).\n\nRooted in the indigenous concept of Molong, a philosophy of care, custodianship, and reciprocal relationships with nature, IMVR invites users to experience the rainforest not as an observer, but as a part of it. \n\n**What you can experience**\n\n- Explore a 3D rainforest environment inspired by the Borneo rainforest\n- Choose a living entity (Olong) and see the world from its perspective\n- Immerse yourself in authentic forest soundscapes\n- Learn about indigenous ecological values through embodied interaction\n\n**Why IMVR** \n\nIMVR fosters ecological awareness, and a deeper emotional connection with the forest (tana), through immersion, not instruction.", "short_description": "IMVR is a co-designed virtual reality experience developed with the Penan community of Long Lamai in Sarawak, Malaysia, exploring the indigenous concept of Molong and inviting users to form immersive relationships with nature."}]}, "developer_name": "Naqib Izzuddin Bin Hussien, Diana Azlyz, Tariq Zaman", "developer_privacy_policy_url": "https://github.com/ArslnS/IMVR-Policy/blob/main/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "ASSET-UTS", "support_website_url": null, "website_url": "https://asset.uts.edu.my/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ms"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25676800368621995"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619715_905449561921224_4082512243669690094_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k806IX_6F9AQ7kNvwE2SgZn&_nc_oc=AdrWrBPvNxAWE3r1NyC-2zvBwmFvG3MFAZtue4x7yqV-jXC5SOntk28BUxhYqxG5wS8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLafNIMpTPfZw9FDledWFpuBGV5qx8EQsGSlvbMfr8uQ&oe=6A92CC87"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "IMVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1768357080, "lastRevision": {"nodes": [{"id": "25625744590394240", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pd
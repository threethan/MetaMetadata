m&_nc_ss=8&oh=00_AfxBMAyCyOw7H7T1I_NCA-fdYwcMADj9n3KAYJVlysQIZw&oe=69B80837"}, {"file_name": "02.png", "id": "3944582409090470", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391798_3944582415757136_7547502902844342887_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JIB2Diz-FgQ7kNvwHcc2ZH&_nc_oc=AdkW3ik2gKl9aVUfmhu-JlH3QIkT_Yxf7Alcs-puLvM-LsQpKPEr15ecJ_XwOFk5XA4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7W_SuHmAG-PNdEBnnFCncNJlBxfxvm8NaZ28yTt4RBQ&oe=69B7EEA4"}, {"file_name": "03.png", "id": "1039667917592115", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823910_1039667920925448_659154416653733806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3pzpX5zF_gQ7kNvwEOf25o&_nc_oc=AdmYy1rn6AT1T7Mj7eCG0ghLy76jKETrGEARmE4MPaOnvZWfVVN1ynQQUXogQ3rRwVA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxxx25feD3ifSiTJKg0Ht-mOnwyJzBQ3bFphJxFjxOFMQ&oe=69B7FF7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_landscape.png", "id": "1236605321403984", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499313101_1236605324737317_7602870625137517911_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0Jeebe9DIoQ7kNvwFulFsj&_nc_oc=AdlyZJ42FZy2D81swqI1AK6mbS8vQ1TenPcAwPqks2rPOZbQC4cxDE6pfjfkAriQYpQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxhmqDHX2GNcca3Hiwy4mTpEu4uURLyUOchp9gWZtLxgA&oe=69B80BE7"}, "display_name": "Artivact XR", "keywords": [], "long_description": "With **Artivact** you can easily manage collections, create 3D models of your assets using photogrammetry, and present them online.\n\n**Artivact XR** lets you experience those collections in the metaverse.\n\nBoth apps are highly customizable and can be used for your own projects. ", "short_description": "Artivact is a free, open-source tool for collection management and presentation.\nWith Artivact XR, you can experience those collections in virtual reality."}, {"images": {"nodes": []}, "id": "1207107027823675", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Artivact XR", "keywords": [], "long_description": "Mit **Artivact** kannst du ganz einfach Sammlungen verwalten, 3D-Modelle deiner Objekte per Photogrammetrie erstellen und sie online pr\u00e4sentieren.\n\nMit **Artivact XR** kannst du diese Sammlungen in der virtuellen Realit\u00e4t erleben.\n\nBeide Anwendungen sind hochgradig anpassbar und k\u00f6nnen f\u00fcr eigene Projekte genutzt werden.", "short_description": "Artivact ist ein kostenloses, quelloffenes Werkzeug zur Sammlungsverwaltung und -pr\u00e4sentation.\nMit Artivact XR kannst du diese Sammlungen in der virtuellen Realit\u00e4t erleben."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artivact.io/#/page/quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "arassec", "support_website_url": null, "website_url": "https://www.artivact.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9256702701097864"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1816980615784993"}]}, "baseline_offer": {"id": "1816980615784993"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1748526180, "status": "PUBLISHED", "id": "1816980615784993"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typ
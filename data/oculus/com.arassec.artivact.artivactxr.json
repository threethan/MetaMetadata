\u00e4t erleben."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artivact.io/#/page/quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "arassec", "support_website_url": null, "website_url": "https://www.artivact.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9256702701097864"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1816980615784993"}]}, "baseline_offer": {"id": "1816980615784993"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1748526180, "status": "PUBLISHED", "id": "1816980615784993"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26125834640424739", "version": "v0.5.0"}, "id": "2051610115295427", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7886903711411110", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26125834640424739"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2051610115295427"}]}, "change_log": null, "created_date": 1779118478, "id": "26125834640424739", "version": "v0.5.0", "version_code":
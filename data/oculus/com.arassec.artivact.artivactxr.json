cdn.com/v/t64.5771-25/473391798_3944582415757136_7547502902844342887_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flKweNoJaTIQ7kNvwFxUHfi&_nc_oc=Adr7YSEls6r1E4Vo4YVSde523aKd5XM2-R5YNxUsu97AJ-bwDNqzHx10OYzzIhKuXow&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRO5g6RRs-yjl1oEiLsC3ESkBh24a-hmSy8whophKafyg&oe=6AFF1AE4"}, {"file_name": "03.png", "id": "1039667917592115", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823910_1039667920925448_659154416653733806_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxNkJ0UbC38Q7kNvwH2qE1E&_nc_oc=AdojlVyqVhyizN1ndlARSpHQ1-pxYAx-pGF1XDh-WTKd7C376U8ptnhR-7nHClgxUIE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpiKPb0tt5JxEgYtav0NPxZLhnSt_KdA0Ku0xvquTiVA&oe=6AFF2BBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_landscape.png", "id": "1236605321403984", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499313101_1236605324737317_7602870625137517911_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8WRI-cmRGYQ7kNvwH2dicw&_nc_oc=Adr3OHstCPsj__4W7mxt0vUupFgWGi88ODAv1V1CgzXT8aFvDMHgP4yL69tNt5sRzbE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRri2-_D8-0lUoHQYSKZsZsosmm6XLNmT3gVV9x2n3IxQ&oe=6AFEFFE7"}, "display_name": "Artivact XR", "keywords": [], "long_description": "With **Artivact** you can easily manage collections, create 3D models of your assets using photogrammetry, and present them online.\n\n**Artivact XR** lets you experience those collections in the metaverse.\n\nBoth apps are highly customizable and can be used for your own projects. ", "short_description": "Artivact is a free, open-source tool for collection management and presentation.\nWith Artivact XR, you can experience those collections in virtual reality."}, {"images": {"nodes": []}, "id": "1207107027823675", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Artivact XR", "keywords": [], "long_description": "Mit **Artivact** kannst du ganz einfach Sammlungen verwalten, 3D-Modelle deiner Objekte per Photogrammetrie erstellen und sie online pr\u00e4sentieren.\n\nMit **Artivact XR** kannst du diese Sammlungen in der virtuellen Realit\u00e4t erleben.\n\nBeide Anwendungen sind hochgradig anpassbar und k\u00f6nnen f\u00fcr eigene Projekte genutzt werden.", "short_description": "Artivact ist ein kostenloses, quelloffenes Werkzeug zur Sammlungsverwaltung und -pr\u00e4sentation.\nMit Artivact XR kannst du diese Sammlungen in der virtuellen Realit\u00e4t erleben."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artivact.io/#/page/quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "arassec", "support_website_url": null, "website_url": "https://www.artivact.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9256702701097864"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1816980615784993"}]}, "baseline_offer": {"id": "1816980615784993"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1748526180, "status": "PUBLISHED", "id": "1816980615784993"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2612583
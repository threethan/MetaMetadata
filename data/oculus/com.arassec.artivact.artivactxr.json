cdn.com/v/t64.5771-25/473391798_3944582415757136_7547502902844342887_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShqSOxV8TGEQ7kNvwEYT1Yg&_nc_oc=AdqytECe5ype9TVBUrte_Wz5RSQomf6ur9OrqQspb882pbGRTHrwNv-AsF-cAwsnYXs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqhtSyWwbl4JsDy9YS_6e1kRhrqQwaiU2izykKo2nWUA&oe=6AFDC964"}, {"file_name": "03.png", "id": "1039667917592115", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823910_1039667920925448_659154416653733806_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxNkJ0UbC38Q7kNvwHw_7SC&_nc_oc=Ado04Jck7nmHXp0-nr9a3tW59oVOM8nXoVBsDan3QSjVouG0xVbQq9EiFeGKhA9gWRk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo58XzAAnQ4hmBgjz_DIXWoC8Qo8o1BkPPKbNlZlR3BA&oe=6AFDDA3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_landscape.png", "id": "1236605321403984", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313101_1236605324737317_7602870625137517911_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zimU_kRaTPUQ7kNvwExM5MM&_nc_oc=AdoVTGOR0u6tkw0kKPFAaG7F6gAYMuiA5RBYbhcojW2PzdxxxRLP_aINSW2g9FPOB3c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUvjarMleAfPBlR4XqnNtn_AAc8rPooZnrZIjj_hPaMA&oe=6AFDAE67"}, "display_name": "Artivact XR", "keywords": [], "long_description": "With **Artivact** you can easily manage collections, create 3D models of your assets using photogrammetry, and present them online.\n\n**Artivact XR** lets you experience those collections in the metaverse.\n\nBoth apps are highly customizable and can be used for your own projects. ", "short_description": "Artivact is a free, open-source tool for collection management and presentation.\nWith Artivact XR, you can experience those collections in virtual reality."}, {"images": {"nodes": []}, "id": "1207107027823675", "locale": "de_DE", "screenshots": [], "video_trailer": null, "v
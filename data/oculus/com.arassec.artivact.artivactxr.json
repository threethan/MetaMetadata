cdn.com/v/t64.5771-25/473391798_3944582415757136_7547502902844342887_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqZUmSxx5roQ7kNvwEmJedp&_nc_oc=AdrX2Q3_eERlAcc-uFgc02Iy5dIIcFaS7BAggr9nhL3KbWswlxWXGPYhTxle1MWyZkE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1Yln1D-rKeJ5YLhrqhMpcw8DLU6VUmNZvLOIblw6weg&oe=6B030F64"}, {"file_name": "03.png", "id": "1039667917592115", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823910_1039667920925448_659154416653733806_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XQRmW9Q9JoQ7kNvwEaxMek&_nc_oc=AdoxtJunmrKnFHcSE-E0lYXTzkXc8kaePEjv9ueqpt1TSW78Y073j6ePoIrS-1ykStc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8offcIRtaeOAqb74BBJLMcv90UgHmTC7UYz5F_Xcj5A&oe=6B03203A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_landscape.png", "id": "1236605321403984", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499313101_1236605324737317_7602870625137517911_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wV3torvZc2kQ7kNvwE5bZUM&_nc_oc=Adps6wZFGFc88WcJvqdCP9DDk6d3klSYPOi_t3i719_1egSfCZYxXMlUjh0ECY7OyFM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7QlWB8lTLiINVyErXd_xbZXP77U1AMa8IoNe8oxeLLQ&oe=6B032CA7"}, "display_name": "Artivact XR", "keywords": [], "long_description": "With **Artivact** you can easily manage collections, create 3D models of your assets using photogrammetry, and present them online.\n\n**Artivact XR** lets you experience those collections in the metaverse.\n\nBoth apps are highly customizable and can be used for your own projects. ", "short_description": "Artivact is a free, open-source tool for collection management and presentation.\nWith Artivact XR, you can experience those collections in virtual reality."}, {"images": {"nodes": []}, "id": "1207107027823675", "locale": "de_DE", "screenshots": [], "video_trailer": null, "v
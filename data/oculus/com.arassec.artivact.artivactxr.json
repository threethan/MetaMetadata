3h4aToO6jSiVYx5sufY8FPddDTSZ3FGPrKEcVpsy1qM_X1oQs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_w8MtycoNvUX0KywiE0xu0xlp-cAIhY4pfUGSuZeQpFw&oe=6A43BE7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_landscape.png", "id": "1236605321403984", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313101_1236605324737317_7602870625137517911_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsOaFP03pqAQ7kNvwGxQ-Mw&_nc_oc=AdqxmYeATyLJkarOD8aXGv0Bo3b2xHIJIuIyel-kp9jHOMuLYI7T4uBc3WA1m3TXDIY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UEQS7ZyTrVlJFax1OyaZfUaptE-wljy2p6h6ok7fLaA&oe=6A43CAE7"}, "display_name": "Artivact XR", "keywords": [], "long_description": "With **Artivact** you can easily manage collections, create 3D models of your assets using photogrammetry, and present them online.\n\n**Artivact XR** lets you experience those collections in the metaverse.\n\nBoth apps are highly customizable and can be used for your own projects. ", "short_description": "Artivact is a free, open-source tool for collection management and presentation.\nWith Artivact XR, you can experience those collections in virtual reality."}, {"images": {"nodes": []}, "id": "1207107027823675", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Artivact XR", "keywords": [], "long_description": "Mit **Artivact** kannst du ganz einfach Sammlungen verwalten, 3D-Modelle deiner Objekte per Photogrammetrie erstellen und sie online pr\u00e4sentieren.\n\nMit **Artivact XR** kannst du diese Sammlungen in der virtuellen Realit\u00e4t erleben.\n\nBeide Anwendungen sind hochgradig anpassbar und k\u00f6nnen f\u00fcr eigene Projekte genutzt werden.", "short_description": "Artivact ist ein kostenloses, quelloffenes Werkzeug zur Sammlungsverwaltung und -pr\u00e4sentation.\nMit Artivact XR kannst du diese Sammlungen in der virtuellen Realit\u00e4t erleben."}]}, "developer_name"
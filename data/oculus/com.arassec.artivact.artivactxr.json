6_7547502902844342887_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMndofyHPH8Q7kNvwEUCTmE&_nc_oc=AdpbfMcb1SLpJ88OKa45QiSqH0pgd4ctb8fyt4lmALr_aYbl8kNNq3LxFP98tb0g7OM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2HxT8xJpdBfWBz4UumljX0dZWjosLMn3kVscNNI6U8gg&oe=69F09F24"}, {"file_name": "03.png", "id": "1039667917592115", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823910_1039667920925448_659154416653733806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EIzu52cnrYQ7kNvwEqHMCA&_nc_oc=AdoWsVsuAgIsIK1eGVhhfXEAnGBAr3km2a4s8nzf_02XYSRCHdSvz21ZB9lxy9FKBwE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3jx20MmEt8mKYwiQYX4GP-hAr-FR3VUDfLv0e_0CEPaQ&oe=69F0AFFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_landscape.png", "id": "1236605321403984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313101_1236605324737317_7602870625137517911_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8DcqnI1714Q7kNvwFbivkF&_nc_oc=Adr_mhVu5KAnOSv3n4L4XHNI1hs3WhxQMQ_cFKZAoEZztcSkCBQBPfY7p1gLkqzDVj0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0Nvo9R35f85qGiEmeAkhtpOUp27DVUCnH3_2N__Uh_Jg&oe=69F0BC67"}, "display_name": "Artivact XR", "keywords": [], "long_description": "With **Artivact** you can easily manage collections, create 3D models of your assets using photogrammetry, and present them online.\n\n**Artivact XR** lets you experience those collections in the metaverse.\n\nBoth apps are highly customizable and can be used for your own projects. ", "short_description": "Artivact is a free, open-source tool for collection management and presentation.\nWith Artivact XR, you can experience those collections in virtual reality."}, {"images": {"nodes": []}, "id": "1207107027823675", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Artivact XR", "keywords": [], "long_description": "Mit **Artivact** kannst du ganz einfach Sammlungen verwalten, 3D-
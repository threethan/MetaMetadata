7547502902844342887_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWAfM8g4YvcQ7kNvwEumlOi&_nc_oc=AdnIGpp-5ZmlwDz7FP_CfK5tTisitZe7t27FpujGfDqvh_Asc7frS_dbEkmEawcDvVE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afu_tDKW6_8WRwTy1OEHNQMvVkhn0ywd17GQK8so8RdQ0A&oe=69A18524"}, {"file_name": "03.png", "id": "1039667917592115", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491823910_1039667920925448_659154416653733806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjkVhmph3oMQ7kNvwEgfkbW&_nc_oc=AdkE582tpvOluItYT7HvOYTDULD-xn0aq9QjyVoYcjW-9ERlWc_X5kOOyHIjs1sRVm8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuJrfmDoS1AdAPNamxAeFbWF39CZjCV5txFhs8mNFM4rw&oe=69A195FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_landscape.png", "id": "1236605321403984", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499313101_1236605324737317_7602870625137517911_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0UBv5pmmYoQ7kNvwEoQjdU&_nc_oc=Admx9Gr9MeLQHL6z62gleJ2J35ns4iEy2hON8lvKydPmeIeUJ8zX10nJQS0j68GI6u4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvtYubnBHzHPF0D44_yCkIgxU-ogmapgiSsgNkpZt1BJA&oe=69A1A267"}, "display_name": "Artivact XR", "keywords": [], "long_description": "With **Artivact** you can easily manage collections, create 3D models of your assets using photogrammetry, and present them online.\n\n**Artivact XR** lets you experience those collections in the metaverse.\n\nBoth apps are highly customizable and can be used for your own projects. ", "short_description": "Artivact is a free, open-source tool for collection management and presentation.\nWith Artivact XR, you can experience those collections in virtual reality."}, {"images": {"nodes": []}, "id": "1207107027823675", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Artivact XR", "keywords": [], "long_description": "Mit **Artivact** kannst du ganz einfach Sammlungen verwalten, 3D-Mo
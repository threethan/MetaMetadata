cdn.com/v/t64.5771-25/473391798_3944582415757136_7547502902844342887_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flKweNoJaTIQ7kNvwFFRQ73&_nc_oc=AdryGrTs8weJxV72lwPVqMEKdUf6IxDPRgjsKHKItunJ0Riy6NzehMzEn4Gn5kr8skk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmsAqOAFFD4RAq1cDxG2Pi3JSuPMQjhCwnl0DC7L06IQ&oe=6B006C64"}, {"file_name": "03.png", "id": "1039667917592115", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823910_1039667920925448_659154416653733806_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XQRmW9Q9JoQ7kNvwEdcQjg&_nc_oc=AdqribKBHR89qwp58d3wEf267NaZiYYM8aIlfFPqpDcp_fxg_5hSbA3e2p7p6PcSs9o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPLCWFVxjEhi3TrHMGNqfOvibXDZfakWek3BNg7QmF_g&oe=6B007D3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_landscape.png", "id": "1236605321403984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313101_1236605324737317_7602870625137517911_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8WRI-cmRGYQ7kNvwHpcHBc&_nc_oc=AdrOkKsxIsPVvfcZCH_CQ3yHIK9r60Ud1hAW7JzxJPpjcTLQgTd_idvv43c3jXq_aLI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUa5dldkZPcwRuxRQolzqARWaDlwpU8ZEa3A7u8FwlEA&oe=6B0089A7"}, "display_name": "Artivact XR", "keywords": [], "long_description": "With **Artivact** you can easily manage collections, create 3D models of your assets using photogrammetry, and present them online.\n\n**Artivact XR** lets you experience those collections in the metaverse.\n\nBoth apps are highly customizable and can be used for your own projects. ", "short_description": "Artivact is a free, open-source tool for collection management and presentation.\nWith Artivact XR, you can experience those collections in virtual reality."}, {"images": {"nodes": []}, "id": "1207107027823675", "locale": "de_DE", "screenshots": [], "video_trailer": null, "v
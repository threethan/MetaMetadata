RI-cmRGYQ7kNvwEXsKAF&_nc_oc=AdqagQhQcoY_ujkORwpWb2H0shu89UpaDkMYnd2bvQJOpHLttzeuqbC-Gpz4u185kuo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTASdVHVsPgHqVpzbF7UVKZn07V6x8_Bo9xezPb3-4pVQ&oe=6B01DB27"}, "display_name": "Artivact XR", "keywords": [], "long_description": "With **Artivact** you can easily manage collections, create 3D models of your assets using photogrammetry, and present them online.\n\n**Artivact XR** lets you experience those collections in the metaverse.\n\nBoth apps are highly customizable and can be used for your own projects. ", "short_description": "Artivact is a free, open-source tool for collection management and presentation.\nWith Artivact XR, you can experience those collections in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artivact.io/#/page/quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "arassec", "support_website_url": null, "website_url": "https://www.artivact.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26125981993743337"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393444_592537319883730_8979111643847687329_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8aa9Q3seBwQ7kNvwFEGZxL&_nc_oc=AdrZ4Da
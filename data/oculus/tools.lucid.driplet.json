HlGASFs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTN8ULMTpBOwWIq7ZCyHUF3Ce43oHInEkh0PbWMc9T-Dg&oe=6AE88EC5"}, {"file_name": "screenshot-4-incoming.png", "id": "1113825394373679", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823341_1113825401040345_4872833833538770428_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3-XKJcQW2gQ7kNvwEnSbEp&_nc_oc=AdqS88zQpi9zrrSf9hgN2zITvVzJRL7B3qZqQOQitxu_xLRHPM4L9wXqdiyEHEJbMEo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSS-VqsB_Tqq8-GVUKC8GuLhrXTlrm-er_wl4RZI1mMwg&oe=6AE89BB6"}, {"file_name": "screenshot-5-nearby.png", "id": "1811228260218330", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823910_1811228263551663_516948066241076091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H26PZrKbr2YQ7kNvwEnaEPg&_nc_oc=AdogSfn-r4suQXCAerSBI-Day1DbARSaCEL69eQIrdzfXURuQN9EV2KDL_Jhq-mMvK8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWp6ix4i6gUTraZgMwGUVzAvI6H1ewGpBC3PwgbWvRVg&oe=6AE8909F"}, {"file_name": "screenshot-3-transfers.png", "id": "1657229052601706", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825497_1657229059268372_826008601438921780_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wnI84JI1mwQ7kNvwEt5fZ9&_nc_oc=Adqqpwz_SGwZVoKCj0v0xcyi7XU1R3iMl2Dwx80UeKp5f1gY46xNN1jSpLV1E8vtvzE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0JCBccHjEvweqlZSqr55vEJrRSwmzFnJEuD2OoIimhg&oe=6AE8B220"}, {"file_name": "screenshot-2-send.png", "id": "1414488933562419", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823757_1414488936895752_8658235911140566827_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLqNq5IVwTsQ7kNvwEAYgtf&_nc_oc=AdpJSTAnMe3PNDWSidzO7p7JyXuwc7y1DzWoDaOydCDR0fasyx4QGX7GDB1s_12nSYE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTm-LUL3Z3mKTod5mCfyySWKLnkcrRPTD9UkQ1pZg-vGg&oe=6AE8A24C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Driplet", "keywords": ["Media", "Transfer", "Videos", "Creator"], "long_description": "Driplet is the easiest way to get your recordings off your headset.\n\nCapture a clip, open Driplet, pick your videos and tap your PC. They land on your computer in full quality within seconds, and nothing is ever uploaded to the cloud.\n\nWHAT YOU CAN DO\n\u2022 Send videos and screenshots from your headset to your PC with one tap\n\u2022 Send files, links and text from your PC back to your headset\n\u2022 Pair once with a 6 digit code so your devices find each other automatically\n\u2022 Choose what to accept, or let your paired devices skip the prompt\n\u2022 Keep transfers going in the background while you do something else\n\nPRIVATE BY DESIGN\nFiles travel directly between your own devices on your own network. Driplet has no accounts, no cloud storage, no ads and no analytics. Nothing you send ever passes through our servers.\n\nBUILT FOR BIG CLIPS\nEvery file is checked when it arrives, so what lands on your PC is exactly what you recorded. If the connection drops, Driplet carries on from where it stopped instead of starting over.\n\nHOW IT WORKS\n1. Install the free Driplet app for Windows from driplet.lucid.tools\n2. Open Driplet on your headset and on your PC, connected to the same Wi-Fi\n3. Pick your clips and tap your PC\n\nDriplet needs the free Windows companion app, and both devices must be on the same local network. Turned on Developer Mode? You can also transfer over a USB cable.", "short_description": "Send your headset videos and screenshots to your PC over Wi-Fi. Fast, private and free.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://driplet.lucid.tools/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucid", "support_website_url": null, "website_url": "https://driplet.lucid.tools/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
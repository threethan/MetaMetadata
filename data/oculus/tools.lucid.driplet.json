771-25/491825497_1657229059268372_826008601438921780_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wnI84JI1mwQ7kNvwEt5fZ9&_nc_oc=Adqqpwz_SGwZVoKCj0v0xcyi7XU1R3iMl2Dwx80UeKp5f1gY46xNN1jSpLV1E8vtvzE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0JCBccHjEvweqlZSqr55vEJrRSwmzFnJEuD2OoIimhg&oe=6AE8B220"}, {"file_name": "screenshot-2-send.png", "id": "1414488933562419", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823757_1414488936895752_8658235911140566827_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLqNq5IVwTsQ7kNvwEAYgtf&_nc_oc=AdpJSTAnMe3PNDWSidzO7p7JyXuwc7y1DzWoDaOydCDR0fasyx4QGX7GDB1s_12nSYE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTm-LUL3Z3mKTod5mCfyySWKLnkcrRPTD9UkQ1pZg-vGg&oe=6AE8A24C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Driplet", "keywords": ["Media", "Transfer", "Videos", "Creator"], "long_description": "Driplet is the easiest way to get your recordings off your headset.\n\nCapture a clip, open Driplet, pick your videos and tap your PC. They land on your computer in full quality within seconds, and nothing is ever uploaded to the cloud.\n\nWHAT YOU CAN DO\n\u2022 Send videos and screenshots from your headset to your PC with one tap\n\u2022 Send files, links and text from your PC back to your headset\n\u2022 Pair once with a 6 digit code so your devices find each other automatically\n\u2022 Choose what to accept, or let your paired devices skip the prompt\n\u2022 Keep transfers going in the background while you do something else\n\nPRIVATE BY DESIGN\nFiles travel directly between your own devices on your own network. Driplet has no accounts, no cloud storage, no ads and no analytics. Nothing you send ever passes through our servers.\n\nBUILT FOR BIG CLIPS\nEvery file is checked when it arrives, so what lands on your PC is exactly what you recorded. If the connection drops, Driplet carries on from where it stopped instead of starting over.\n\nHOW IT WORKS\n1. Install the free Driplet app for Windows from driplet.lucid.tools\n2. Open Driplet on your headset and on your PC, connected to the same Wi-Fi\n3. Pick your clips and tap your PC\n\nDriplet needs the free Windows companion app, and both devices must be on the same local network. Turned on Developer Mode? You can also transfer over a USB cable.", "short_description": "Send your headset videos and screenshots to your PC over Wi-Fi. Fast, private and free.\n"}]}, "developer_name": "Lucid", "developer_privacy_policy_url": "https://driplet.lucid.tools/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucid", "support_website_url": null, "website_url": "https://driplet.lucid.tools/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1104139222212212"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824328_1888816612484058_5749363980793472935_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9oTL0YyDtEgQ7kNvwHXwWII&_nc_oc=AdqwpHN8N2JK_64yMG8mj-hVhL1UiyD7fEyghFi8rSGTHesRQBac8z2kjAhW_38wGSk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVrPMwCGgNb8-hWgrYuqdOBJ2fYq8mbBnheiAbhFR5IA&oe=6AE8C2B3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dripl
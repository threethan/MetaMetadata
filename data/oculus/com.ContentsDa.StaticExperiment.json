vwFAkJB7&_nc_oc=AdrSAFnLR7MYzG5h02QuanE1gFE6Qfe8N0BgKwuoB_9GZYSU7RWzYVSKcTonzLhPXTU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwVlET_VfMUJ7cL8410yctsRL0uF12yVX0gB3FSt2D-ww&oe=69CBD148"}, "display_name": "Static Electric Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "physics", "electricity", "science", "contentsda"], "long_description": "1. Note that in the real world, fires are caused by high voltage, so wear gloves for safety. \n2. Connect the wires.\n3. Pick up the bar magnet.\n4. Install the bar magnet.\n5. Connect the wires where the bar magnet conductor is located.\n6. Press the red button to start.\n7. Watch the metal rod move inside the horseshoe magnet.\n8. Pick up the horseshoe magnet.\n9. Reverse the orientation of the horseshoe.\n10. Press the red button to start.\n11. Observe the metal bar move outward from the horseshoe\n\n<Result\nUnderstand the force of the current on the rod and the aluminum foil, respectively.", "short_description": "Experience the shock of static electricity. Learn how static charge accumulates and is discharged, showcasing the basic principles of electrostatics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported
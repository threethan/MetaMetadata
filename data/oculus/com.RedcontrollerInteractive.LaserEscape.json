ame": "ss (4).png", "id": "1974481293187498", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499623601_1974481296520831_4624026906493768331_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GDJ_nc_BGkQ7kNvwEUSMfP&_nc_oc=Adp20Z_uPDXiJ73LFWO_smezbmmNnJg5lRitVWLr3omuEjY138A_XxV887xtsEK3MGw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88JQrEhdjzcSd4iW5FtMg-pUnVEWo8aYT_Bwy15LgmQg&oe=6A36A08B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laserescape.png", "id": "961855773555242", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499623370_961855776888575_2711585747433107274_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcccJ1tPDw0Q7kNvwFIY_w9&_nc_oc=Adrs76rLJBct90ue29VNuF-7dsjKwjcTb7t1tgKsIo0t-gKNGANzteRTs9_pB_XI8Io&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_hwoyjA66rukArN8_hTEo-EXn-bM6EAeq91B3a4swsQ&oe=6A36A432"}, "display_name": "Laser Escape", "keywords": ["laser", "escape", "dance", "thief", "MR"], "long_description": "Laser Escape turns your real room into a living laser vault. Your walls, floor, ceiling, and furniture become part of the challenge as the game builds mixed reality escape levels around your actual space. Start at the safe zone, study the room setup preview, then move carefully through glowing laser traps to reach the far-wall switch and complete the level.\n\nEvery room creates a different mission. Lasers can hang from the ceiling, stretch between walls, sweep across the space, blink on and off, rotate like security scanners, or warn you before becoming dangerous. Red lasers are static, blue lasers pulse with timing windows, yellow lasers move, purple lasers sense and fan across the room, and orange warning beams keep you under pressure.\n\nThe game is designed for physical play: duck under beams, lean through gaps, crouch, crawl, time your steps, and use your real environment as cover. A body setup system helps tune laser height and comfort, while room-adaptive generation keeps levels playable in small or large spaces. Progress through 100 levels across easy, medium, and hard sections, unlock new layouts, replay stages, and keep improving your escape skills.\n\nWith passthrough mixed reality, glowing laser effects, spatial laser hum, alarm feedback, controller and hand interaction support, and a satisfying finish switch, Laser Escape creates a tense arcade challenge inside your own home. Move smart. Stay low. Don\u2019t touch the light.", "short_description": "Turn your real room into a high-stakes laser vault. Dodge, duck, crawl, and time your moves through adaptive mixed reality traps, then hit the far-wall switch before the alarm catches you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1SGmO6u21AJusuGQpWi86I7JUBZtnS9VVfTDdCO2oUEc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1526176072626230"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1699350347763598"}, {"status": "PUBLISHED", "id": "1381705130429356"}]}, "baseline_offer": {"id": "1381705130429356
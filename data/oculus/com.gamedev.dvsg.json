WnREfaxOAK8LwBRjFCbv4nKDQ3b79XrKtgFo8jeKlI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLe0h-t2qV-z6E8XJcyIxsRQc5XYq9m3kkBvWCrQp7yQ&oe=6AFDDD3C"}, {"file_name": "DvG_Screenshot5.png", "id": "10087919144647189", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307346_10087919151313855_5851434226166432561_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1Z_xDSNtCUQ7kNvwFRvnv2&_nc_oc=AdpzX6zMDJkHbJnkuwZvdwPf0DE_nmn1KRqzDNT2UV3CD55MG-JKjAk6Vn7nLNFPurs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQfmawlsdi2IZEuBJEyiYV5W5UE0PY3A2doUR9CHYs1w&oe=6AFDD4C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DvG_Trailer.png", "id": "24278476138514415", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296119_24278476148514414_8425608439958956480_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Ae94Ph2tc0Q7kNvwGhYTHm&_nc_oc=AdpZYzgSGy2RtYbXPr2dLeBFJI7UBnjTJBQwCZmLzNOALHwnF1amUzWk7WzpnOG4RDA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbrjc2uPz5P3Bh7t59LdbovLGsIaoVKWTYnLp6DAxgnQ&oe=6AFDAF39"}, "display_name": "David Vs Goliath", "keywords": ["education", "religion", "bible", "family", "kids"], "long_description": "David Vs Goliath is a family-friendly virtual reality experience that reimagines the iconic biblical story for a new generation. Designed specifically for younger audiences and their families, this interactive adventure blends cinematic storytelling with fun, accessible gameplay that encourages exploration, strategy, and learning.\n\nStep into the shoes of young David as he embarks on a courageous journey to face the mighty Goliath. Along the way, players engage with a series of immersive story scenes and adventure-based mini-games that test their reflexes, logic, and bravery \u2014 all within a vibrant and stylized VR world.\n\nWhether you're slinging stones, solving puzzles, or exploring ancient landscapes, David Vs Goliath offers an inspiring message about courage, faith, and overcoming the odds \u2014 all while introducing kids and parents alike to the magic of virtual reality. With its accessible mechanics, replayable design, and educational undertones, the game is the perfect entry point into VR for the whole family.", "short_description": "Step into the epic tale of David Vs Goliath \u2014 a fun, family-friendly VR adventure that brings the legendary story to life through immersive storytelling and action-packed mini-games. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacypolicy-davidvsgoliath.tiiny.site/", "developer_terms_of_service_url": null, "publisher_name": "VR GameDev Paraguay", "support_website_url": null, "website_url": "https://www.instagram.com/vrgamedevpy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_AR"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24237620709263303"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1184222320236901"}]}, "baseline_offer": {"id": "1184222320236901"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772121600, "status": "PUBLISHED", "id": "1184222320236901"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25749333471425345", "version": "8.0"}, "id": "1988738565269799",
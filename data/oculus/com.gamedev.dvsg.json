73_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BgkMEgUVWsQ7kNvwHmjW95&_nc_oc=AdoL-0UnxDghZ1LVbT86Zyfc_30eGUaUxjsP8TkrvZff8hQso7l3MePF63bk3U_0NeE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_hs4GoIFM-dHNy4-muyb1D_llUcB8q5q_ICJ__vZkBg&oe=69F355FC"}, {"file_name": "DvG_Screenshot5.png", "id": "10087919144647189", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307346_10087919151313855_5851434226166432561_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNg2iigtQrsQ7kNvwE8hVdf&_nc_oc=AdpEeUbfyTBpMaG7X0smyIRUffQ1GOgLo5d588P3rdfvagZm4vYNqF_peDuXFpK0A8g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2YquIppjW1MS1SbC1SNqmwcNx6GqPsr1yoc6BB1WhLwA&oe=69F34D80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DvG_Trailer.png", "id": "24278476138514415", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499296119_24278476148514414_8425608439958956480_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KD-DWhkopSQQ7kNvwEZgm3Z&_nc_oc=Ado49byV2uRsxMvEeOKCxT982B0fDyPtWFaLmd4K3jvScd1WZhb1ItTOKPbX4kkrWNI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2JE5C7Dq_B2VCqTKjA2bWQYGjLbAPIqFEgDkuEZdOQhQ&oe=69F36039"}, "display_name": "David Vs Goliath", "keywords": ["education", "religion", "bible", "family", "kids"], "long_description": "David Vs Goliath is a family-friendly virtual reality experience that reimagines the iconic biblical story for a new generation. Designed specifically for younger audiences and their families, this interactive adventure blends cinematic storytelling with fun, accessible gameplay that encourages exploration, strategy, and learning.\n\nStep into the shoes of young David as he embarks on a courageous journey to face the mighty Goliath. Along the way, players engage with a series of immersive story scenes and adventure-based mini-games that test their reflexes, logic, and bravery \u2014 all within a vibrant and stylized VR world.\n\nWhether you're slinging stones, solving puzzles, or exploring ancient landscapes, David Vs Goliath offers an inspiring message about courage, faith, and overcoming the odds \u2014 all while introducing kids and parents alike to the magic of virtual reality. With its accessible mechanics, replayable design, and educational undertones, the game is the perfect entry point into VR for the whole family.", "short_description": "Step into the epic tale of David Vs Goliath \u2014 a fun, family-friendly VR adventure that brings the legendary story to life through immersive storytelling and action-packed mini-games. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacypolicy-davidvsgoliath.tiiny.site/", "developer_terms_of_service_url": null, "publisher_name": "VR GameDev Paraguay", "support_website_url": null, "website_url": "https://www.instagram.com/vrgamedevpy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_AR"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25820657000959658"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499304106_791390830239079_6139516106138196039_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HOynPkR5aMQ7kNvwGn_hR8&_nc_oc=AdpNgKwbue7SozIcehPtOQCG5-4GY4BROonUV3b8_n9hM5aV9W7I2qPf16KS8UnvgiY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3CoT9NcoK98XhLTrkF
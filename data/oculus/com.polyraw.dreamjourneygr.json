file_name": "migrated_image.png", "id": "2670940506480987", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974504_346908802552417_4840251821299597312_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQLm0WAfsKAQ7kNvwGn2biQ&_nc_oc=AdqkS_PNtiSpPZL-75yO8OgLMb7Dko_oXvqb97RB7RkNcJ8XgqGFf1mhcg6EC2X96zY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSF3l4SMPk_QHY0Uam9TLWDGkQg5KphpftkDaI9yTAbAQ&oe=6AFF1C6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZH2Tu7", "id": "240870423448125", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974847_240870426781458_5687980006483951616_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqDQ4Ldn5wMQ7kNvwHXv6GB&_nc_oc=AdoTO9fR1iXI37Fs49AmU247cPkQmnSbJh4DcokFdX77gMl5ouc5GMwUQ1C-S__OvWw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4WIZmmgb9rrQLgHGlIjS7UyX23GfBBOYQ-3F59BEmMQ&oe=6AFF166B"}, "display_name": "Dream Journey", "keywords": ["dream", "relax", "water", "fantasy", "natural"], "long_description": "In a realm that straddles the line between enchantment and the echoes of medieval antiquity, the power of a spell has breathed life into dreams. Delicate fairies, their wings a shimmering cascade of ethereal light, become your gracious guides on this wondrous odyssey. Nestled within a rustic, handwoven basket, you are gently lifted from the ordinary world into an extraordinary realm.\n\nAs you soar through the air, the fairies lead you on a meandering path, unveiling a panorama of ancient landscapes and hidden natural treasures. On your voyage, you witness the charm of forgotten villages with moss-covered castle walls, where time has softened the edges of history.\nYour aerial journey takes you across tranquil lakes, their mirrored surfaces capturing the clouds above, and over the rugged silhouettes of mountains that stand sentinel in the distance. These wondrous landscapes pass beneath you like scenes from an age-old tapestry, each one telling a tale of bygone eras.\n\nThe fairies' wings guide you through the meandering pathways of this enchanted world until you arrive at a marsh of mystical wonder. Here, the water shimmers with an otherworldly light, and the air is filled with the sweet scent of exotic blooms. This enchanted marsh is a realm where reality and fantasy entwine, and the boundaries of dreams dissolve into the embrace of the extraordinary.\n", "short_description": "From the creators of Relax River and Terror Cave... Dream Journey, wich we reached to next level of reality! A new experience that will overwhelm your body and your mind and will teleport you into an incredible world where past and nature melt together to create a dream scenario with wonderful creatures and incredible realism and details!"}]}, "developer_name": "Polyraw Development", "developer_privacy_policy_url": "https://www.polyrawdevelopment.com/Policy.html", "developer_terms_of_service_url": null, "publisher_name": "Polyraw Development", "support_website_url": null, "website_url": "https://www.polyrawdevelopment.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EXPLORATION", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25004913112455725"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974660_898380577025825_819605052862758912_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=
&oh=00_AQTCQGhT-M39Pb8XKIT8_X0a-OAUCFsYbKDwHkmEfDA-Jw&oe=6AFDDCA1"}]}, "id": "906924377564668", "locale": "en_US", "screenshots": [{"file_name": "migrated_image.png", "id": "573532459910235", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974526_243629183170929_3360017035227561984_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfVPVbMeI14Q7kNvwHMKY1c&_nc_oc=Adq17VgRKl4fKfHdL_tpfr4iqSb1K6-iEWc8EBUyUgTyst_zaJjrCP4tWwt9hUExH5U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQY7DJrRdwNiVooPgttLitJsgGh-NN0rvPv700yRbD24Q&oe=6AFDD2F8"}, {"file_name": "migrated_image.png", "id": "229255228125715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974924_231498694390466_728028022170451968_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKEEoXYFqz4Q7kNvwGLNS4g&_nc_oc=AdoTxQBD0ycklkJ5tISBzmtCHQaADm0U190V0YTPJxLk_z7GImfZrt6vPILXsJZAe08&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTu173q8Y_womScyntEM6po7TUl2xT8TSpe7O0DGYVxWw&oe=6AFDC387"}, {"file_name": "migrated_image.png", "id": "156635608819060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974463_255135751709413_479333786346061824_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDlKI0rfnwAQ7kNvwEBa6di&_nc_oc=AdrTwOyN9JQ06iJlCiXeSLgCiLHoNMXGP36aPq0Qwf5F1y85aKGRCeXgqkmF-O2kMyI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKQ8GNN7eD1MX8b-mbTfR0sIE41VainzMTE3RGu27-Xg&oe=6AFDB532"}, {"file_name": "migrated_image.png", "id": "238976960612888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974665_2170315296552716_6662553513815441408_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0Cy90rscTMQ7kNvwFXhXGJ&_nc_oc=AdoVdymRbdasf3gsKSmjFkmj0wJXozWxTWfWD0IkxYoC7YstXO0-_5PlnVhyqx7ab5E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSr2GfC7sY99rIvIbz32j1Orua9T3VnRxCvv-dGSUaHhw&oe=6AFDB2AC"}, {"file_name": "migrated_image.png", "id": "2670940506480987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974504_346908802552417_4840251821299597312_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQLm0WAfsKAQ7kNvwHd8xF_&_nc_oc=AdoxyfwuuchkMd5S3AyA3-49r6yH2WU7dlPKPpDhVg9egZrfp2EObj5lR_Sn-JNCFA4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNUEqLPqMxK_LspOetu1dmTY41FGWhVBDpZLL5GwQ1XQ&oe=6AFDCAEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZH2Tu7", "id": "240870423448125", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974847_240870426781458_5687980006483951616_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RtVjq7Yn48sQ7kNvwEtAf4l&_nc_oc=AdpE4h93VidRsrR_z2joU-NnQPoVKQpPEtV3A2Pe5qWg2NQApy8IlQ3DFzAQIqBzAJY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJJd8QhVnZiCeBc01OwwCMq0TFiKSDdvCw53WyXgJLKA&oe=6AFDC4EB"}, "display_name": "Dream Journey", "keywords": ["dream", "relax", "water", "fantasy", "natural"], "long_description": "In a realm that straddles the line between enchantment and the echoes of medieval antiquity, the power of a spell has breathed life into dreams. Delicate fairies, their wings a shimmering cascade of ethereal light, become your gracious guides on this wondrous odyssey. Nestled within a rustic, handwoven basket, you are gently lifted from the ordinary world into an extraordinary realm.\n\nAs you soar through the air, the fairies lead you on a meandering path, unveiling a panorama of ancient landscapes and hidden natural treasures. On your voyage, you witness the charm of forgotten villages with moss-covered castle walls, where time has softened the edges of history.\nYour aerial journey takes you across tranquil lakes, their mirrored surfaces capturing the clouds above, and over the rugged silhouettes of mountains that stand sentinel in the distance. These wondrous landscapes pass beneath you like scenes from an age-old tapestry, each one telling a tale of bygone eras.\n\nThe fairies' wings guide you through the meandering pathways of this enchanted world until you arrive at a marsh of mystical wonder. Here, the water shimmers with an otherworldly light, and the air is filled with the sweet scent of exotic blooms. This enchanted marsh is a realm where reality and fantasy entwine, and the boundaries of dreams dissolve into the embrace of the extraordinary.\n", "short_description": "From the creators of Relax River and Terror Cave... Dream Journey, wich we reached to next level of reality! A new experience that will overwhelm your body and your mind and will teleport you into an incredible world where past and nature melt together to create a dream scenario with wonderful creatures and incredible realism and details!"}]}, "developer_name": "Polyraw Development", "developer_privacy_policy_url": "https://www.polyrawdevelopment.com/Policy.html", "developer_terms_of_service_url": null, "publisher_name": "Polyraw Development", "support_website_url": null, "website_url": "https://www.polyrawdevelopment.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EXPLORATION", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25004913112455725"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974660_898380577025825_819605052862758912_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=
tent-iad3-1.oculuscdn.com/v/t64.5771-25/673652249_911320248498803_1166758614804344202_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dBENtLs0c4Q7kNvwHJ3LFU&_nc_oc=AdpcwJGa8M8czykv4syuKL00oGxCS4ThER4HQ0FwBrQAI8B6PJCCmFYXsrjJ8HZPGvU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuJgBP1frIMzOvSRaZ4GeGt-GgIqdXNIu4aPBkuX2Oiw&oe=6B047536"}, {"file_name": "screenshot_5.png", "id": "988860414228136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595119480_988860420894802_4453862886954338780_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVRcW-HE20EQ7kNvwE--uEx&_nc_oc=Adpw1frnDpKpIjADt9XOksfcFrmTrk4H9biGXaccs9jrmD3XfxJXq6ejvm2yDyyl_aU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsbwf4YvAuPq0_6k79mgsB_yWdoFMf2XgRhPXyUHo56A&oe=6B0468A7"}, {"file_name": "screenshot_4.png", "id": "1779053113311961", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831569_1779053116645294_3260792093846080294_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlETRcLVE40Q7kNvwEHC7dn&_nc_oc=Adr36y0OKygvBSII4WVk6ysnaCyXpZk2xFqy_R-V0qAqK1F1GUB-dU05UsIdbH2dMhQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6kw5YCyUX_VQbcYvdSsFsLLjyHF0TtJxW5NJS_TBsmQ&oe=6B046B43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "2621837651589363", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596061819_2621837654922696_1696866843641578207_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9-nYVGQK1cQ7kNvwEaraIf&_nc_oc=Ado1ko-0-MHBTB3B7kic4FM7SnaWa0pBvjnlxCeZPly3vRyQOF4PCFuBqj-Z8xCr-Lk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTH3yQZ1tDcpp59nxzjcMMzLda6OMPgqZvkIGw4hsqBhQ&oe=6B0471C4"}, "display_name": "Flight Simulator", "keywords": ["flight", "simulator", "airplane", "helicopter", "pilot"], "long_description": "Flight Simulator puts you in two real cockpits, built switch by switch, and a whole archipelago to fly them over.\n\nTWO AIRCRAFT\nFly a private business jet with a full glass cockpit, yokes, thrust levers, flaps, gear and speed brake - or a twin-engine rescue helicopter with a bubble canopy, cyclic, collective and pedals.\n\nA COCKPIT THAT WORKS\nLive flight displays and a moving map, an autopilot that holds heading and altitude, altitude callouts on the flare and approach lights on every runway. Grab the yoke and thrust levers, or fly with the thumbsticks.\n\nGET UP AND WALK\nPress B and stand up. Walk back through the leather cabin and look out of the windows while the autopilot flies, then take your seat again.\n\nA WORLD TO EXPLORE\nThree airports, a canyon, a coastal city of towers, a wind farm, a stadium, a lighthouse, a marina and ships at sea. Discover ten landmarks.\n\nDAY, SUNSET AND NIGHT\nFly through golden-hour light or land at night with the city lit up below you.\n\nSEVEN FLIGHTS\nFirst Flight to Night Landing, every landing scored - or just fly free.\n\nControls: left stick flies, right stick is thrust and rudder, A flaps, X gear, Y autopilot, B stand up, left MENU for the flights.", "short_description": "Take the left seat of a private business jet or the pilot's seat of a twin-engine rescue helicopter and fly a 32 km island archipelago - three airports, a mountain canyon, a coastal city, day, sunset and night. Real cockpits with working instruments, an autopilot, and a cabin you can get up and walk through in flight."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulator/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulator/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "
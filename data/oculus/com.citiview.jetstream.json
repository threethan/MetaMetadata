46831_5171305190174689094_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtZMMiuyzDQQ7kNvwHumnW_&_nc_oc=AdosV-ha7fKtAjrkg78CON0ZVtmVLgdq8iXQu5uABOLT53c8W7yd1sKoCfd13Du6rn4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT4GJhEZ4EWlsQDut5jclZhPOH-tQ3rUI9RCZuj9V41PQ&oe=6B0DA249"}, {"file_name": "screenshot_1.png", "id": "943180398415324", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831964_943180401748657_7245575884042390186_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zFRE9mxMb4Q7kNvwEs3LTM&_nc_oc=AdrxRqwELxAOThl3J6HG_sd0B11PoHaxPi7JosYOgb0QHAjsoHIqoT5Vip2cxuUjExQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTyj5WiyMK11aAc1zzVeT3Vz-noLyvNWGQ1NPmt1L0DAg&oe=6B0DD1C0"}, {"file_name": "screenshot_4.png", "id": "2622890774780606", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604347072_2622890778113939_136753567720574721_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwhxGw_KWkYQ7kNvwFazQLd&_nc_oc=AdoLDYMOwPOqO5y9PxHCJo2Pkz6cQOghCi7wp72vSNyNoBGZ9j6O9YTQza8ausuGHO8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQToiMsZCfu7AjuAJmcmCVudDURPvQkMw1_ChcuPrQmxzA&oe=6B0DA740"}, {"file_name": "screenshot_5.png", "id": "1070429849139750", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831393_1070429852473083_5729511624885897376_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbn3gcWfTnMQ7kNvwGBDGgO&_nc_oc=Adp45i7SEkoeG2eO-ZnoIqAYe1uFwWINGTnVkXtXgCJ2zmcTgGq-JPiQzqw6_aILdp4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ9sRX89zH4IlYOGdwha76MPovVJKAPiN-MnHvVxaUTqA&oe=6B0DB34C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "949068081133586", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830576_949068084466919_6846321982329183708_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1xeWszULmIQ7kNvwFCVm8g&_nc_oc=AdqccIYVJcYeJj9CvF4V33feIpwN213bf4aS4VhN10hXlR4l8_zPakjR2XFTNYb2NfU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT1j9mPdWlz7NqJr9FUrQ5A19aZGqkmBU1TXjbFB3h-Bg&oe=6B0D9EF3"}, "display_name": "Flight Simulator", "keywords": ["flight", "simulator", "airplane", "helicopter", "pilot"], "long_description": "Flight Simulator puts you in the captain's seat over real cities. Amsterdam is included; New York, Paris and London are city packs you add from the LOCATIONS menu.\n\nTHE REAL AMSTERDAM - INCLUDED\nReal satellite, elevation and map data: the canal ring, Centraal, the Dam, the Rijksmuseum, the A'DAM Tower, the ArenA, IJmuiden and Zandvoort. Schiphol with all six runways, Lelystad, hundreds of turning windmills, the tulip fields and the North Sea.\n\nLOCATIONS - CITY PACKS\nOne-time purchases, downloaded once, yours to keep:\nNEW YORK - Manhattan, the Empire State, One World Trade, the Statue of Liberty, eleven bridges, JFK, LaGuardia, Newark, Teterboro.\nPARIS - through the legs of the Eiffel Tower, the Seine and 29 bridges, Notre-Dame, the Louvre, Versailles, CDG, Orly, Le Bourget.\nLONDON - through Tower Bridge, Big Ben, the Shard, Canary Wharf, Wembley, Windsor, Heathrow, London City, Gatwick.\nEvery city has its own hangar, eleven missions, airports, trains, boats and night lights.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter whose canopy closes down over you as you throttle up for takeoff.\n\nA STEADY COCKPIT AT ANY ALTITUDE\nRock-steady at cruise altitude; inside a cloud the white fills only your windows.\n\nAIR TRAFFIC CONTROL, A GLASS HANGAR, ONLINE CO-OP\nTaxi and landing clearances. Walk around, repaint and wash your aircraft. Quick Match or a private sky with a code.\n\nENGLISH AND DUTCH menus.", "short_description": "Fly the real Amsterdam, built from real satellite and map data, then add New York, Paris and London from the new LOCATIONS menu. A steady cockpit at any altitude, a fighter whose canopy closes over you for takeoff, air traffic control, your own glass hangar, eleven missions per city and online co-op."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulator/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulator/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1292431987296107"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673573223_1777393530068456_994086177763530698_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJYRgOCDTPIQ7kNvwEolmmh&_nc_oc=AdrHCtd0oF8toqkFJA0YsnsKYDgFRjQVQz_MpkzuVfh8U1YgiM0kazx13oBqCVKSGxg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT_wb9Q2Ip5WvSUhs0G8-0jpebJFrjBulZfS7RYAlXlCA&oe=6B0DCFAC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flight Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1790601300, "lastRevision": {"nodes"
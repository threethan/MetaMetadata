tent-sea5-2.oculuscdn.com/v/t64.5771-25/673652249_911320248498803_1166758614804344202_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zdecv7Rd4PUQ7kNvwHRo0EH&_nc_oc=Adr1J1j_-Oje8DkaYLayJWhJrjYAPne0fgWNydglI0KS2r7SHs1ZrOxE7DNT54tQLNM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAvfunfwFTkgv9BXZ5OBZchOpNGnDHGzyHXE--kdm0DA&oe=6AFC8C36"}, {"file_name": "screenshot_5.png", "id": "988860414228136", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595119480_988860420894802_4453862886954338780_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QH4TzZT7b94Q7kNvwE2B12i&_nc_oc=AdpL2xkF7-4IhOGrwQZxUJgcP7o32cLpKFesWnh4pwBtX1X1_iXyiSiFXQHejGW-ABc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkTcgR5L7DEAB5Sj6XHvCQGOZKv-8sodHYXZ9Qj9RFng&oe=6AFC7FA7"}, {"file_name": "screenshot_4.png", "id": "1779053113311961", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831569_1779053116645294_3260792093846080294_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61saZcWLM2AQ7kNvwEVyQW7&_nc_oc=Adpihuw1T1Zkv-oDEEub-9AB5TQKaf8CD56mzT7Y0vK8Fgt0PAj8t4QtobYviXI6VaA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQI-0VllUPd01Yj4BzjeNoroWtlFRr56hSeJ-KOfyzR3A&oe=6AFC8243"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "2621837651589363", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596061819_2621837654922696_1696866843641578207_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoR1bZ-UE48Q7kNvwHTi1UT&_nc_oc=AdpRhsHi0Q1wHR1C40NIxBnfOax87KrmeBW-v4uePHg99vYrs5U65gAIo3uFZjRZeJE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSahWreUqFBCmr5l0saxy6Si2aW3go3Jepy2bM424joZg&oe=6AFC88C4"}, "display_name": "Flight Simulator", "keywords": ["flight", "simulator", "airplane", "helicopter", "pilot"], "long_description": "Flight Simulator puts you in two real cockpits, built switch by switch, and a whole archipelago to fly them over.\n\nTWO AIRCRAFT\nFly a private business jet with a full glass cockpit, yokes, thrust levers, flaps, gear and speed brake - or a twin-engine rescue helicopter with a bubble canopy, cyclic, collective and pedals.\n\nA COCKPIT THAT WORKS\nLive flight displays and a moving map, an autopilot that holds heading and altitude, altitude callouts on the flare and approach lights on every runway. Grab the yoke and thrust levers, or fly with the thumbsticks.\n\nGET UP AND WALK\nPress B and stand up. Walk back through the leather cabin and look out of the windows while the autopilot flies, then take your seat again.\n\nA WORLD TO EXPLORE\nThree airports, a canyon, a coastal city of towers, a wind farm, a stadium, a lighthouse, a marina and ships at sea. Discover ten landmarks.\n\nDAY, SUNSET AND NIGHT\nFly through golden-hour light or land at night with the city lit up below you.\n\nSEVEN FLIGHTS\nFirst Flight to Night Landing, every landing scored - or just fly free.\n\nControls: left stick flies, right stick is thrust and rudder, A flaps, X gear, Y autopilot, B stand up, left MENU for the flights.", "short_description": "Take the left seat of a private business jet or the pilot's seat of a twin-engine rescue helicopter and fly a 32 km island archipelago - three airports, a mountain canyon, a coastal city, day, sunset and night. Real cockpits with working instruments, an autopilot, and a cabin you can get up and walk through in flight."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulator/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulator/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "
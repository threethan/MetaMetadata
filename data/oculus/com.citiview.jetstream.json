46831_5171305190174689094_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IayDxyolDhsQ7kNvwEwb3ej&_nc_oc=AdrSwfKBpGMSa5Xiw6gt7pk4uZQY9pGiNSVCQqaCFV5GwLPtzNUAE5oXPPL5jRv5ElQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT021jHPj2IjInmbEkZRSnnnZvgQz0cVGPGVuwzVih0jg&oe=6AFDD049"}, {"file_name": "screenshot_1.png", "id": "943180398415324", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831964_943180401748657_7245575884042390186_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjcXpQ9pft0Q7kNvwEQQMnC&_nc_oc=Adqi5Ti8lesn__quuIkCsDaWoBgyPGGNqRN2jFuJOvTemOQq9P_6ytplEijZT11NSQo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRC5PiGAl8kolAneo1h_j3wQeHC0OwGk1s6oic-MPtl5w&oe=6AFDC780"}, {"file_name": "screenshot_4.png", "id": "2622890774780606", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604347072_2622890778113939_136753567720574721_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_L2Z7KFs5UQQ7kNvwGAFe2R&_nc_oc=AdrWWVEow5yDEKR8MICF6Ay6AiOmRMCrs2puLKMNqDSeAMDXpltLRmLEvmn0AnHn--U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQV9VceMR0G9rHl21hQq9geQl-wTNyhJUZQOJmUVUa-Q&oe=6AFDD540"}, {"file_name": "screenshot_5.png", "id": "1070429849139750", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831393_1070429852473083_5729511624885897376_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bq_vNjKeFGcQ7kNvwHsWXMJ&_nc_oc=Ado3WLbygHjR3nkjGktI3-aG3OapJaaSCmhitETeaIl7vcpTx0nWutPh7EzujymAzhA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQk8_Ru19qC6-HeCd5KU1D5kOy06YbTElwlELQ_5gYnJA&oe=6AFDE14C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "949068081133586", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830576_949068084466919_6846321982329183708_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pc0UMxHAEiMQ7kNvwHMx_fV&_nc_oc=AdoolvwuKvgeS6S9KIO4Li9gAGeYfIcr2rDm3uXKr_6muu3FwTtd-NxBG1UazaTnH5U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcj-IzLK942X2Q_v8UxRsPATTg3I8WzA-wyW9sXmQ3MQ&oe=6AFDCCF3"}, "display_name": "Flight Simulator", "keywords": ["flight", "simulator", "airplane", "helicopter", "pilot"], "long_description": "Flight Simulator puts you in the captain's seat over real cities. Amsterdam is included; New York, Paris and London are city packs you add from the LOCATIONS menu.\n\nTHE REAL AMSTERDAM - INCLUDED\nReal satellite, elevation and map data: the canal ring, Centraal, the Dam, the Rijksmuseum, the A'DAM Tower, the ArenA, IJmuiden and Zandvoort. Schiphol with all six runways, Lelystad, hundreds of turning windmills, the tulip fields and the North Sea.\n\nLOCATIONS - CITY PACKS\nOne-time purchases, downloaded once, yours to keep:\nNEW YORK - Manhattan, the Empire State, One World Trade, the Statue of Liberty, eleven bridges, JFK, LaGuardia, Newark, Teterboro.\nPARIS - through the legs of the Eiffel Tower, the Seine and 29 bridges, Notre-Dame, the Louvre, Versailles, CDG, Orly, Le Bourget.\nLONDON - through Tower Bridge, Big Ben, the Shard, Canary Wharf, Wembley, Windsor, Heathrow, London City, Gatwick.\nEvery city has its own hangar, eleven missions, airports, trains, boats and night lights.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter whose canopy closes down over you as you throttle up for takeoff.\n\nA STEADY COCKPIT AT ANY ALTITUDE\nRock-steady at cruise altitude; inside a cloud the white fills only your windows.\n\nAIR TRAFFIC CONTROL, A GLASS HANGAR, ONLINE CO-OP\nTaxi and landing clearances. Walk around, repaint and wash your aircraft. Quick Match or a private sky with a code.\n\nENGLISH AND DUTCH menus.", "short_description": "Fly the real Amsterdam, built from real satellite and map data, then add New York, Paris and London from the new LOCATIONS menu. A steady cockpit at any altitude, a fighter whose canopy closes over you for takeoff, air traffic control, your own glass hangar, eleven missions per city and online co-op."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulator/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulator/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1292431987296107"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673573223_1777393530068456_994086177763530698_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUqRnalfD2cQ7kNvwE4H7Y1&_nc_oc=AdrIeU4fOXwLjagzD_9bFC1vEuR-ZfAsKNGtKg2SQ9C_Cpfl60Q6UhkccZ6aFqlcm4A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQc0ad6BueKW6eJZtsltlCVvrtfVxr2ulXmesaJmnp5qA&oe=6AFDC56C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flight Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1790601300, "lastRevision": {"nodes"
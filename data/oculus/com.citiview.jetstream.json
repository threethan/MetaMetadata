tent-atl3-2.oculuscdn.com/v/t64.5771-25/673652249_911320248498803_1166758614804344202_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2unyz3jHFUAQ7kNvwE6w4Fk&_nc_oc=AdrvnntHPrqR4cwzgpUM5HYbk6S2XEO0Fpnsy7P3F7ik7Dsr60W9fIQERQwcQBAaUSk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ1lJMUXkKMTwxLifyQFMTlRsHxgXq0tyRYAqR5MKDVXw&oe=6B0B44F6"}, {"file_name": "screenshot_5.png", "id": "988860414228136", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/595119480_988860420894802_4453862886954338780_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDap_iFQNDwQ7kNvwHqhDxn&_nc_oc=Adqt1HEejhpp5s3rY6IB4as-MV6aWAqUz-jjljZkuU-ZqmHSSJA9G6izKphYes7I0lU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR-WQIoHCe0jn1o9p1hA5bYsvaoQ6bkq8Q_74hE4SdVvg&oe=6B0B3867"}, {"file_name": "screenshot_4.png", "id": "1779053113311961", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831569_1779053116645294_3260792093846080294_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2zjCjcVbjkQ7kNvwGAjhPo&_nc_oc=AdpkXVkipH61ZZvBDmURwG96_iz8uKq0eLailKS2L5ccanYvw7vUCrI5POdw1mwf7gU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSoDOXGcyc_fgbe3PbVYzzjrA0gAJ-cg05xNHlzRs12cw&oe=6B0B3B03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "2621837651589363", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/596061819_2621837654922696_1696866843641578207_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwH6jhC9pLsQ7kNvwF5bTv5&_nc_oc=AdpRWRq7E83ESDp8trirKxAKen27Z0JVDgZbMTRLLTYwlnGNqgz-qF0bVEi10yHU4tQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSewNIo6wXVu875h01ODQiMs7y6HX1N4nMkBVtqCh5k3A&oe=6B0B4184"}, "display_name": "Flight Simulator", "keywords": ["flight", "simulator", "airplane", "helicopter", "pilot"], "long_description": "Flight Simulator puts you in two real cockpits, built switch by switch, and a whole archipelago to fly them over.\n\nTWO AIRCRAFT\nFly a private business jet with a full glass cockpit, yokes, thrust levers, flaps, gear and speed brake - or a twin-engine rescue helicopter with a bubble canopy, cyclic, collective and pedals.\n\nA COCKPIT THAT WORKS\nLive flight displays and a moving map, an autopilot that holds heading and altitude, altitude callouts on the flare and approach lights on every runway. Grab the yoke and thrust levers, or fly with the thumbsticks.\n\nGET UP AND WALK\nPress B and stand up. Walk back through the leather cabin and look out of the windows while the autopilot flies, then take your seat again.\n\nA WORLD TO EXPLORE\nThree airports, a canyon, a coastal city of towers, a wind farm, a stadium, a lighthouse, a marina and ships at sea. Discover ten landmarks.\n\nDAY, SUNSET AND NIGHT\nFly through golden-hour light or land at night with the city lit up below you.\n\nSEVEN FLIGHTS\nFirst Flight to Night Landing, every landing scored - or just fly free.\n\nControls: left stick flies, right stick is thrust and rudder, A flaps, X gear, Y autopilot, B stand up, left MENU for the flights.", "short_description": "Take the left seat of a private business jet or the pilot's seat of a twin-engine rescue helicopter and fly a 32 km island archipelago - three airports, a mountain canyon, a coastal city, day, sunset and night. Real cockpits with working instruments, an autopilot, and a cabin you can get up and walk through in flight."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulator/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulator/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "
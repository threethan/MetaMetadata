46831_5171305190174689094_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IayDxyolDhsQ7kNvwHubjWm&_nc_oc=AdpZAOvECp0HB9ERVEbKUrzhBrNDoYLi4QGmO178PFyiYXMlKS78i3rZ0K5uNOcZgmE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTI9Z1U6PI6Qx3qxVoGjl5DALYHk2w3oEHinsslJL7ASA&oe=6AFC7EC9"}, {"file_name": "screenshot_1.png", "id": "943180398415324", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491831964_943180401748657_7245575884042390186_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rdOSPouigQQ7kNvwElGQB8&_nc_oc=AdoNjDVhJEuyfrufG4n--KJuMtCgbOaA6ygR7bu3FlhEXfQkr8hea9rhF7_Y1WEPb8U&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbb9NWLOfLWICx6LCw3tqBPXYRNh6Qv9BUCJ1aeuOe6w&oe=6AFC7600"}, {"file_name": "screenshot_4.png", "id": "2622890774780606", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604347072_2622890778113939_136753567720574721_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_L2Z7KFs5UQQ7kNvwH4Lqs3&_nc_oc=AdqKd7cLE3MsgT7_c9di3BIUPcgQb4PE7c5yeA1g6vrUmEpzwf4EB_9PfJnyVu688is&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiEaTXZ8mrHvjKw2Yu8PfmpcDvBwOwq7AW-bWBnk-G2A&oe=6AFC83C0"}, {"file_name": "screenshot_5.png", "id": "1070429849139750", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831393_1070429852473083_5729511624885897376_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDYxPMn2hmoQ7kNvwFk5H_H&_nc_oc=Ado0kHaMUmkDq1xIRhIPfnkhtSlp8hAuWnEDOHHBvr-yBUHdvZt741-kp0CGE6Nfh9o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROtxJZeGLCG3OV-KZuHTZNvmizlj0CAhiY6KEYEIpNpg&oe=6AFC8FCC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "949068081133586", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491830576_949068084466919_6846321982329183708_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ch3CUENs6-wQ7kNvwE0z0yt&_nc_oc=AdqcV7Txy7K7QV_OmmaFHR6Yk21TkIPoopgilq6uc_UrzQorVl853TCNK3etZuQSFIg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSenCY5QHDq8MgclGfeLOeU_VTUHGxDHejsQtcMHmBgyQ&oe=6AFC7B73"}, "display_name": "Flight Simulator", "keywords": ["flight", "simulator", "airplane", "helicopter", "pilot"], "long_description": "Flight Simulator puts you in the captain's seat over real cities. Amsterdam is included; New York, Paris and London are city packs you add from the LOCATIONS menu.\n\nTHE REAL AMSTERDAM - INCLUDED\nReal satellite, elevation and map data: the canal ring, Centraal, the Dam, the Rijksmuseum, the A'DAM Tower, the ArenA, IJmuiden and Zandvoort. Schiphol with all six runways, Lelystad, hundreds of turning windmills, the tulip fields and the North Sea.\n\nLOCATIONS - CITY PACKS\nOne-time purchases, downloaded once, yours to keep:\nNEW YORK - Manhattan, the Empire State, One World Trade, the Statue of Liberty, eleven bridges, JFK, LaGuardia, Newark, Teterboro.\nPARIS - through the legs of the Eiffel Tower, the Seine and 29 bridges, Notre-Dame, the Louvre, Versailles, CDG, Orly, Le Bourget.\nLONDON - through Tower Bridge, Big Ben, the Shard, Canary Wharf, Wembley, Windsor, Heathrow, London City, Gatwick.\nEvery city has its own hangar, eleven missions, airports, trains, boats and night lights.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter whose canopy closes down over you as you throttle up for takeoff.\n\nA STEADY COCKPIT AT ANY ALTITUDE\nRock-steady at cruise altitude; inside a cloud the white fills only your windows.\n\nAIR TRAFFIC CONTROL, A GLASS HANGAR, ONLINE CO-OP\nTaxi and landing clearances. Walk around, repaint and wash your aircraft. Quick Match or a private sky with a code.\n\nENGLISH AND DUTCH menus.", "short_description": "Fly the real Amsterdam, built from real satellite and map data, then add New York, Paris and London from the new LOCATIONS menu. A steady cockpit at any altitude, a fighter whose canopy closes over you for takeoff, air traffic control, your own glass hangar, eleven missions per city and online co-op."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulator/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulator/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1292431987296107"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673573223_1777393530068456_994086177763530698_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUqRnalfD2cQ7kNvwGnNge6&_nc_oc=AdqUy1eypF7EFXnaybc7e6J2JAsf1jcxUuQ-U1LScOTafPb3VA5cG2MBt37TBFy6M6Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT42p3VnjES5Z4s5PC6bJaM1IljXzuKC8HOYykEpvWqPg&oe=6AFC73EC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flight Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1790601300, "lastRevision": {"nodes"
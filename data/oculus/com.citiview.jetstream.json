46831_5171305190174689094_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtZMMiuyzDQQ7kNvwFf0muz&_nc_oc=AdouvNHEqeNo6JazenQ7a2S6YtHCwoF-rktk29ZQiCWs03L5XJBs9uedDCbSPjS9KaI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQi-L-YTBypt7AE4fGDHk_78xoyoN2m21BHXvF2VgbGPw&oe=6B0B3789"}, {"file_name": "screenshot_1.png", "id": "943180398415324", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831964_943180401748657_7245575884042390186_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5yKVZXvFlkQ7kNvwEXUHlA&_nc_oc=AdpuRThhqxIiByZ2bDQFj_5tLkw9RxzTQz9ogH0gTeOEq3FWAGs86fQIwKDJzl3rdzc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRrR8vObxBF8zKWK8rkLp3bNuNoN1m_EL_Xs8gwBqmSaQ&oe=6B0B2EC0"}, {"file_name": "screenshot_4.png", "id": "2622890774780606", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/604347072_2622890778113939_136753567720574721_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwhxGw_KWkYQ7kNvwGPFdY5&_nc_oc=AdrfcPdYgcXgFrbDYUaQLT87juZ6q6iTBHNgJVdnUfIdLceQvUSCmiWLr3qpfbVx9WI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQcrpoyJkS37UgPCykyMY3cPJjMe8l66gfSAMuVHORFcw&oe=6B0B3C80"}, {"file_name": "screenshot_5.png", "id": "1070429849139750", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831393_1070429852473083_5729511624885897376_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0VK6xXUJasQ7kNvwEeqcMl&_nc_oc=AdrhssN7_Vi9PtGF_7qzQr94f_7B_b171aBBWy2us9skT9nzVBWhoPScAJXEb_MpWR4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSKsddGildoV7DLIm6PkpYQbi60H_fAIf3SVFsocWoF8Q&oe=6B0B104C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "949068081133586", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830576_949068084466919_6846321982329183708_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjMYIi0zzToQ7kNvwHK3f8A&_nc_oc=Adp6Sp4ugPSViNaKvvx64063Hq1C1WJ2NWY7vHOiMWxL2_9vpCqct4HqGBCMZiB2wXA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSuYBNkcv8lwmN9vtPd2jhpyI4pfmqcvsl7pRgqnHneUg&oe=6B0B3433"}, "display_name": "Flight Simulator", "keywords": ["flight", "simulator", "airplane", "helicopter", "pilot"], "long_description": "Flight Simulator puts you in the captain's seat over real cities. Amsterdam is included; New York, Paris and London are city packs you add from the LOCATIONS menu.\n\nTHE REAL AMSTERDAM - INCLUDED\nReal satellite, elevation and map data: the canal ring, Centraal, the Dam, the Rijksmuseum, the A'DAM Tower, the ArenA, IJmuiden and Zandvoort. Schiphol with all six runways, Lelystad, hundreds of turning windmills, the tulip fields and the North Sea.\n\nLOCATIONS - CITY PACKS\nOne-time purchases, downloaded once, yours to keep:\nNEW YORK - Manhattan, the Empire State, One World Trade, the Statue of Liberty, eleven bridges, JFK, LaGuardia, Newark, Teterboro.\nPARIS - through the legs of the Eiffel Tower, the Seine and 29 bridges, Notre-Dame, the Louvre, Versailles, CDG, Orly, Le Bourget.\nLONDON - through Tower Bridge, Big Ben, the Shard, Canary Wharf, Wembley, Windsor, Heathrow, London City, Gatwick.\nEvery city has its own hangar, eleven missions, airports, trains, boats and night lights.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter whose canopy closes down over you as you throttle up for takeoff.\n\nA STEADY COCKPIT AT ANY ALTITUDE\nRock-steady at cruise altitude; inside a cloud the white fills only your windows.\n\nAIR TRAFFIC CONTROL, A GLASS HANGAR, ONLINE CO-OP\nTaxi and landing clearances. Walk around, repaint and wash your aircraft. Quick Match or a private sky with a code.\n\nENGLISH AND DUTCH menus.", "short_description": "Fly the real Amsterdam, built from real satellite and map data, then add New York, Paris and London from the new LOCATIONS menu. A steady cockpit at any altitude, a fighter whose canopy closes over you for takeoff, air traffic control, your own glass hangar, eleven missions per city and online co-op."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulator/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulator/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1292431987296107"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/673573223_1777393530068456_994086177763530698_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZs9q-J43SUQ7kNvwH9kSM8&_nc_oc=AdoitlyTCVIQl2yWeSvMrmmaLLi-vhMF6P916buJsGweDPS_CGL2ImJsDCwn6MdXXDg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTTY-U4fXscx2SyybnZYAqPtBn-v3p73VZ1NeQgWOmDtA&oe=6B0B2CAC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flight Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1790601300, "lastRevision": {"nodes"
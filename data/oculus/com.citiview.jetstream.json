46831_5171305190174689094_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csxI_7tufYsQ7kNvwEIkCx_&_nc_oc=AdrxfUiQRRdABxkCxJLyUM2ZYdB7gU-fjbOGA6w3UsrjyK7q38ZHKpwmzU7yL7sL7Hs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWceonFUrIGYwk4GLkwRMSQQNW3nT2Mb9iw0KTL2449A&oe=6B0467C9"}, {"file_name": "screenshot_1.png", "id": "943180398415324", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831964_943180401748657_7245575884042390186_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyeHVJjMnlkQ7kNvwF7xa3k&_nc_oc=AdoCypunNf_y4hk9Rc4sCZYZR-Ri4fzxwkZ-YMon36ZtFLF-Ue_Bd66Ba4n6EN2aFIo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIOw4bEnyfTxe0sHKr5Cr8GWA3Hq8QHqU9XxpFG1cOsA&oe=6B045F00"}, {"file_name": "screenshot_4.png", "id": "2622890774780606", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604347072_2622890778113939_136753567720574721_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOm5SO3PBGUQ7kNvwElOrH7&_nc_oc=Adr2qW6vdzzoWPh3CfhRO6zD6wGTjeE5WW2ySq9G_gFhgg2HDafZCNcaM8oRZT4idjE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHG67rVIh0Zt_5h8fleKjpGF1vF2olIDPS06KS5YFnow&oe=6B046CC0"}, {"file_name": "screenshot_5.png", "id": "1070429849139750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831393_1070429852473083_5729511624885897376_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2iIfwa6BIsQ7kNvwFontKR&_nc_oc=Adrt8FSlADepFsqjd8SaAoflvhmt2Vsfp6Ab6_Vi3EvgTUA8P9B9XYKPZ6gwkeHbTHc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQC2irydpOfuvHrpJNdLZFtdI2boT5aNhW-JAQfMx4yig&oe=6B0478CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "949068081133586", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830576_949068084466919_6846321982329183708_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADB7FlzZmE8Q7kNvwFgsva9&_nc_oc=AdpiQ2p8X9r8jrOrwNe84qqiSpH8d2bS2uPSdISob2V23qJ1b2I0j8HHs9vzSWTLdHw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCm3VWBpqindR0sUyeQ7yUutYDswM6Nttp3P_7-h9UyQ&oe=6B046473"}, "display_name": "Flight Simulator", "keywords": ["flight", "simulator", "airplane", "helicopter", "pilot"], "long_description": "Flight Simulator puts you in the captain's seat over real cities. Amsterdam is included; New York, Paris and London are city packs you add from the LOCATIONS menu.\n\nTHE REAL AMSTERDAM - INCLUDED\nReal satellite, elevation and map data: the canal ring, Centraal, the Dam, the Rijksmuseum, the A'DAM Tower, the ArenA, IJmuiden and Zandvoort. Schiphol with all six runways, Lelystad, hundreds of turning windmills, the tulip fields and the North Sea.\n\nLOCATIONS - CITY PACKS\nOne-time purchases, downloaded once, yours to keep:\nNEW YORK - Manhattan, the Empire State, One World Trade, the Statue of Liberty, eleven bridges, JFK, LaGuardia, Newark, Teterboro.\nPARIS - through the legs of the Eiffel Tower, the Seine and 29 bridges, Notre-Dame, the Louvre, Versailles, CDG, Orly, Le Bourget.\nLONDON - through Tower Bridge, Big Ben, the Shard, Canary Wharf, Wembley, Windsor, Heathrow, London City, Gatwick.\nEvery city has its own hangar, eleven missions, airports, trains, boats and night lights.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter whose canopy closes down over you as you throttle up for takeoff.\n\nA STEADY COCKPIT AT ANY ALTITUDE\nRock-steady at cruise altitude; inside a cloud the white fills only your windows.\n\nAIR TRAFFIC CONTROL, A GLASS HANGAR, ONLINE CO-OP\nTaxi and landing clearances. Walk around, repaint and wash your aircraft. Quick Match or a private sky with a code.\n\nENGLISH AND DUTCH menus.", "short_description": "Fly the real Amsterdam, built from real satellite and map data, then add New York, Paris and London from the new LOCATIONS menu. A steady cockpit at any altitude, a fighter whose canopy closes over you for takeoff, air traffic control, your own glass hangar, eleven missions per city and online co-op."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulator/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulator/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1292431987296107"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673573223_1777393530068456_994086177763530698_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ciwdha_NDoQQ7kNvwEAAhzF&_nc_oc=AdpXSuCYC7jvPpkcDb6m5upiP4OxKp4WOVf42jWKCzR_Mq2K30kHWeShtsmmnIHRslk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7gx9xynB3d82iSxfAoE4hyMViJ1c6Ya5XkYyoUwCvIw&oe=6B045CEC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flight Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1790601300, "lastRevision": {"nodes"
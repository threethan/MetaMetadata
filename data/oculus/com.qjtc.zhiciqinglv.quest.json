6751859_4438282251291248581_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVSmLOk5b00Q7kNvwFIYNgU&_nc_oc=Adp2FeYHJYIlhDZtwzNNaq4Coi2l8XUt2CmnB0kg_qAcVPFaPa_CXsQyoSWnZO7idJg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDREAlisgdbqwq-sd3viQrDkbhwn9kr-O0zqhF3oUi3hA&oe=6A5B86D9"}, {"file_name": "Screenshot_com.qjtc.zhiciqinglv_2024.08.07-15.47.27.373_673_\u526f\u672c_\u526f\u672c.png", "id": "709321051353871", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462964_709321054687204_6253127467104286919_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qzK2yAb-aKAQ7kNvwHjAHtl&_nc_oc=AdqZe3IdtDD8aF1Gr9fWc4sfM58F9ow0sf43KvRywUzjRhdJeEqrvTE5SkHodRbJ6ZU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG7gP7NX8M029mFx64cAamwIh5Dtt7UxodMeLafLh9gQ&oe=6A5B7789"}, {"file_name": "Screenshot_com.qjtc.zhiciqinglv_2024.08.07-15.47.50.229_133_\u526f\u672c_\u526f\u672c.png", "id": "2828100664022073", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982692_2828100667355406_7810138239095812987_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDiJrLxMNtsQ7kNvwEiMvaQ&_nc_oc=Ado8Vaz8_eZ7diAmOVnbRS7u-6GiH7be8cf7wTvpoahe7UXVNoBaMjFcssOYTkGILys&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZknUYXmZjbyZYQfiFqxXx6fPCpJvvjzE42-IIK5USuA&oe=6A5B8426"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u7ec4 354@1x.png", "id": "912526407368792", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_912526410702125_4861362283946910263_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4a5orrZMN6wQ7kNvwF3n_Jp&_nc_oc=AdopSlSN5QrLnMGi_u_eEny5_-Z28mDUa8yVz9reY7JVvEOkxg0fyLhy2ACjTttZwC4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoxUaqEMfLFNVwbz3S80X9pvxkYzVqPnqDH31TcbSvuA&oe=6A5B8C1D"}, "display_name": "PoeticDance", "keywords": ["PoeticDance"], "long_description": "The creative inspiration for Poetic Dance \"The Journey of a Legendary Landscape Painting\" comes from the \"A Panorama of Mountains and Rivers\" painting.\n\n\"A Panorama of Mountains and Rivers\" is one of the top ten most famous ancient Chinese paintings passed down through generations. It was painted by the Northern Song Dynasty artist Wang Ximeng in half a year when he was only 18 years old. Unlike the black and white tones of ink wash paintings, this painting is named for the use of mineral pigments of azurite and malachite green, depicting the splendid and magnificent scenery of thousands of miles of rivers and mountains with its gorgeous green and blue hues.\n\nThe entire ballet poem is structured around chapters such as \"Scroll Unfolding, Seal Tracing, Silk Reeling, Minerals Exploring, Brush Making, Ink Grinding, Painting Alive\" narrating the story of a young researcher from the Palace Museum who \"time travels\" back to the Northern Song Dynasty, and from the perspective of an \"The Scroll Opener\", \"witnesses\" the story of the painter Wang Ximeng creating the \"A Panorama of Mountains and Rivers\"\n\nThis group dance expresses the concept of layered mountain ranges. The dancers, with their resplendent bodies, outline the boundless rivers and mountains that are as poetic and illusory as a dream, narrating the legendary tales of classical Chinese style.", "short_description": "The Journey of a Legendary Landscape Painting."}]}, "developer_name": null, "developer_privacy_policy_url": "http://file.cooolar.com/h5/zcql_agreement-private-en.html", "developer_terms_of_service_url": null, "publisher_name": "\u5143\u7f8e\u79d1\u6280", "support_website_url": null, "website_url": "https://www.cooolar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recom
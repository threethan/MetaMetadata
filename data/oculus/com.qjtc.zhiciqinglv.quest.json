6751859_4438282251291248581_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y580dBcz4VMQ7kNvwFuzeYz&_nc_oc=Adr1SPKLmAcAcX3hqu46ZwzsGoBbijTyBvoHZByX13YtmAg-KbQGhfd7I-pMmlYmv5w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xI5XSB-3oEPUr60CKGDaQZ1N6hg5So-L2HqzWGQIYgA&oe=69FB4959"}, {"file_name": "Screenshot_com.qjtc.zhiciqinglv_2024.08.07-15.47.27.373_673_\u526f\u672c_\u526f\u672c.png", "id": "709321051353871", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462964_709321054687204_6253127467104286919_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdLqpccEL7wQ7kNvwFXeyNr&_nc_oc=Ado83aPyn1PIdfKm5WOpmBxK01foNvGOCitFILkCZR21VVZo-TBmiV7CxCcM76rPZoE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_6LskZFYcWQ0_pIdCuYp0zX3UjPrDq_yEsXX3y1zKiQ&oe=69FB3A09"}, {"file_name": "Screenshot_com.qjtc.zhiciqinglv_2024.08.07-15.47.50.229_133_\u526f\u672c_\u526f\u672c.png", "id": "2828100664022073", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982692_2828100667355406_7810138239095812987_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqKJiVSb6cMQ7kNvwGniqe_&_nc_oc=AdqRiy2sY3p9EpiEWmS4c8GU7SRLDPVYCdGzm1p_k4AJn1JCM-x6mx7QikOjxILhH0E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XCc78ykqApkq4VR9VORPSLPd1UJLMqKyKDJv0nZIo5g&oe=69FB46A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u7ec4 354@1x.png", "id": "912526407368792", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974446_912526410702125_4861362283946910263_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwMsqp4JbmgQ7kNvwGL7zDF&_nc_oc=AdoIsZNyEnSydNGali5cFJuXg2KN08VYZlWW1Eh2JYYj1lYErytiz5ccGKNjn4H8ync&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CTEg0Ro-lFaxXWwn_k2fbF8fDT4LTFWb3ws7E_y7XOQ&oe=69FB4E9D"}, "display_name": "PoeticDance", "keywords": ["PoeticDance"], "long_description": "The creative inspiration for Poetic Dance \"The Journey of a Legendary Landscape Painting\" comes from the \"A Panorama of Mountains and Rivers\" painting.\n\n\"A Panorama of Mountains and Rivers\" is one of the top ten most famous ancient Chinese paintings passed down through generations. It was painted by the Northern Song Dynasty artist Wang Ximeng in half a year when he was only 18 years old. Unlike the black and white tones of ink wash paintings, this painting is named for the use of mineral pigments of azurite and malachite green, depicting the splendid and magnificent scenery of thousands of miles of rivers and mountains with its gorgeous green and blue hues.\n\nThe entire ballet poem is structured around chapters such as \"Scroll Unfolding, Seal Tracing, Silk Reeling, Minerals Exploring, Brush Making, Ink Grinding, Painting Alive\" narrating the story of a young researcher from the Palace Museum who \"time travels\" back to the Northern Song Dynasty, and from the perspective of an \"The Scroll Opener\", \"witnesses\" the story of the painter Wang Ximeng creating the \"A Panorama of Mountains and Rivers\"\n\nThis group dance expresses the concept of layered mountain ranges. The dancers, with their resplendent bodies, outline the boundless rivers and mountains that are as poetic and illusory as a dream, narrating the legendary tales of classical Chinese style.", "short_description": "The Journey of a Legendary Landscape Painting."}]}, "developer_name": null, "developer_privacy_policy_url": "http://file.cooolar.com/h5/zcql_agreement-private-en.html", "developer_terms_of_service_url": null, "publisher_name": "\u5143\u7f8e\u79d1\u6280", "support_website_url": null, "website_url": "https://www.cooolar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recom
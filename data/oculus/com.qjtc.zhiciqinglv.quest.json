286919_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2NLUlcZ2fwQ7kNvwGgOc_O&_nc_oc=AdpIxBz3dvuUXe_4_9SmnBGQVsCp7Pb45XbGoC_uTlcTRnfFcOwwXGh1tRA3mjRVNS8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO02Dn1-JbKSpSqSCLdXB_-zl5HB1RahVqcenyJgtLIPw&oe=6ACD10C9"}, {"file_name": "Screenshot_com.qjtc.zhiciqinglv_2024.08.07-15.47.50.229_133_\u526f\u672c_\u526f\u672c.png", "id": "2828100664022073", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982692_2828100667355406_7810138239095812987_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0DXhPJklLwQ7kNvwExt5IL&_nc_oc=Adrj5UtPPgf434LTIwr540OBZQNsOT94o9GIjX8Ms14yGAAwJMf1ILFguNtpvVWCkJc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7QDH4SuuCaODfjZPKQ-a5V4dNH7h9b-Ixsc4JTuqPKg&oe=6ACCE526"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u7ec4 354@1x.png", "id": "912526407368792", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_912526410702125_4861362283946910263_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OoJ3mhWXBMQ7kNvwG9Hutz&_nc_oc=AdqRoD9wb0bq8zX24adiKsylocwDO_wwNB9nVaV-vPZvRdv3B1xrIgyykpEctDmHsTA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfwGB2r4BTWSGgpjAHwz7t8KfnVPsBduabhwSWM2pM1Q&oe=6ACCED1D"}, "display_name": "PoeticDance", "keywords": ["PoeticDance"], "long_description": "The creative inspiration for Poetic Dance \"The Journey of a Legendary Landscape Painting\" comes from the \"A Panorama of Mountains and Rivers\" painting.\n\n\"A Panorama of Mountains and Rivers\" is one of the top ten most famous ancient Chinese paintings passed down through generations. It was painted by the Northern Song Dynasty artist Wang Ximeng in half a year when he was only 18 years old. Unlike the black and white tones of ink wash paintings, this painting is named for the use of mineral pigments of azurite and malachite green, depicting the splendid and magnificent scenery of thousands of miles of rivers and mountains with its gorgeous green and blue hues.\n\nThe entire ballet poem is structured around chapters such as \"Scroll Unfolding, Seal Tracing, Silk Reeling, Minerals Exploring, Brush Making, Ink Grinding, Painting Alive\" narrating the story of a young researcher from the Palace Museum who \"time travels\" back to the Northern Song Dynasty, and from the perspective of an \"The Scroll Opener\", \"witnesses\" the story of the painter Wang Ximeng creating the \"A Panorama of Mountains and Rivers\"\n\nThis group dance expresses the concept of layered mountain ranges. The dancers, with their resplendent bodies, outline the boundless rivers and mountains that are as poetic and illusory as a dream, narrating the legendary tales of classical Chinese style.", "short_description": "The Journey of a Legendary Landscape Painting."}]}, "developer_name": null, "developer_privacy_policy_url": "http://file.cooolar.com/h5/zcql_agreement-private-en.html", "developer_terms_of_service_url": null, "publisher_name": "\u5143\u7f8e\u79d1\u6280", "support_website_url": null, "website_url": "https://www.cooolar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8160464927401554"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename"
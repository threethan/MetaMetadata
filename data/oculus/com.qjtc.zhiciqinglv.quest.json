DCJ2SNQ&oe=6B0710FC"}, {"file_name": "Screenshot_com.qjtc.zhiciqinglv_2024.08.07-15.47.07.558_274_\u526f\u672c_\u526f\u672c.png", "id": "1176364230085193", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036681_1176364236751859_4438282251291248581_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-Cm5JuKQiYQ7kNvwGV4U4o&_nc_oc=AdrRgbyYpaK0LHsHqf6mIJFAjbWh2jnyRXetbxH-IgemDFoNFBwVOMvH_PrPmM8K1A0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2NDHqNtgaG3dB6k-bEmMO21Ys8qOmhHJ0kRJ0jhwjHA&oe=6B072219"}, {"file_name": "Screenshot_com.qjtc.zhiciqinglv_2024.08.07-15.47.27.373_673_\u526f\u672c_\u526f\u672c.png", "id": "709321051353871", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75462964_709321054687204_6253127467104286919_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBWeipq_QHwQ7kNvwHixGN1&_nc_oc=AdoxoExjkTEwsOLI4A2xDE60Cv3cDMIiy5MCVty_ei0h3frwvTQTsNrbZ-ZFakpTPSY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuQEBDf1Ls1kDuKJ-dHs0VVA_asRQuv7tuFtghgX_fsA&oe=6B0712C9"}, {"file_name": "Screenshot_com.qjtc.zhiciqinglv_2024.08.07-15.47.50.229_133_\u526f\u672c_\u526f\u672c.png", "id": "2828100664022073", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982692_2828100667355406_7810138239095812987_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ym7v3Oys9PIQ7kNvwHzpSyI&_nc_oc=AdrJ9SgQxSQZL0TzkpqNnxFraD6CtUSAyBLhXFU6Zfz_XbqqR2Qj5CUKhJlUbEr6ZJ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaoM3TOy0lUf2VP7ogogXuRKkQgQVgjBVu9yB2xoRxMQ&oe=6B071F66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u7ec4 354@1x.png", "id": "912526407368792", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974446_912526410702125_4861362283946910263_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxLjW6HTHOEQ7kNvwFaKE3d&_nc_oc=AdobsKAYh7XmhqCwORcM3WY1nikJUWAGn1OTPZM7LPBnv4h00ZCOKlZC5OkuWi_IKJo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDz-N7_NUMrJ_m0HqGLTxRfPcE4ZR5I8I0GmEoOs46Jw&oe=6B07275D"}, "display_name": "PoeticDance", "keywords": ["PoeticDance"], "long_description": "The creative inspiration for Poetic Dance \"The Journey of a Legendary Landscape Painting\" comes from the \"A Panorama of Mountains and Rivers\" painting.\n\n\"A Panorama of Mountains and Rivers\" is one of the top ten most famous ancient Chinese paintings passed down through generations. It was painted by the Northern Song Dynasty artist Wang Ximeng in half a year when he was only 18 years old. Unlike the black and white tones of ink wash paintings, this painting is named for the use of mineral pigments of azurite and malachite green, depicting the splendid and magnificent scenery of thousands of miles of rivers and mountains with its gorgeous green and blue hues.\n\nThe entire ballet poem is structured around chapters such as \"Scroll Unfolding, Seal Tracing, Silk Reeling, Minerals Exploring, Brush Making, Ink Grinding, Painting Alive\" narrating the story of a young researcher from the Palace Museum who \"time travels\" back to the Northern Song Dynasty, and from the perspective of an \"The Scroll Opener\", \"witnesses\" the story of the painter Wang Ximeng creating the \"A Panorama of Mountains and Rivers\"\n\nThis group dance expresses the concept of layered mountain ranges. The dancers, with their resplendent bodies, outline the boundless rivers and mountains that are as poetic and illusory as a dream, narrating the legendary tales of classical Chinese style.", "short_description": "The Journey of a Legendary Landscape Painting."}]}, "developer_name": null, "developer_privacy_policy_url": "http://file.cooolar.com/h5/zcql_agreement-private-en.html", "developer_terms_of_service_url": null, "publisher_name": "\u5143\u7f8e\u79d1\u6280", "support_website_url": null, "website_url": "https://www.cooolar.com/", "category": null, "co
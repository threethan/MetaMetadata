6751859_4438282251291248581_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGA6wao7JVYQ7kNvwGuwMXN&_nc_oc=AdpmqcUBDS4DsZWyHCLQ3IUKhFJWUVmHpfScPdWmImDBX1ebP5_QmcMqUrBh09fzmIU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYQfcwZE4BHW6SZJUNer3Z1i3DXv6lK6q45UGTg17Vmw&oe=6A50FAD9"}, {"file_name": "Screenshot_com.qjtc.zhiciqinglv_2024.08.07-15.47.27.373_673_\u526f\u672c_\u526f\u672c.png", "id": "709321051353871", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462964_709321054687204_6253127467104286919_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igHIOr0tvlcQ7kNvwEdwr8W&_nc_oc=Adq2WIubX6CuxkpcvNl5AVuj9gYO6hQAGBvrjz-67OOmEkqbEw8-EIWQr5SZi_48Ftc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAc2mSPi06GMtYtnLERS33SbYe2rmK2yTwV8YCO3My9Vw&oe=6A50EB89"}, {"file_name": "Screenshot_com.qjtc.zhiciqinglv_2024.08.07-15.47.50.229_133_\u526f\u672c_\u526f\u672c.png", "id": "2828100664022073", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982692_2828100667355406_7810138239095812987_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEmhqJKv1QAQ7kNvwEMU8SE&_nc_oc=AdpcaBAssih-1u0D2yN3icKq3Bjk9oO8Ow_1BBhO2tX2gptBKxt9E9zJAuhQvjc-GE4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBRvC94AAWnmd1fMt_HlNmbLpz-CLmh6MuVSk8e61Rkg&oe=6A50F826"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u7ec4 354@1x.png", "id": "912526407368792", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974446_912526410702125_4861362283946910263_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzMoHCvCcQYQ7kNvwEX1axD&_nc_oc=Adp5bYq1826babi9ieLahJyk-4-ZyKGpE1vz4kJVyHiGeaksNUQi2wIU2emV5lp_a4M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbLoQ8hbxG-dBfuCJEM4MoBGHLiwVfABLwYXkbduczow&oe=6A51001D"}, "display_name": "PoeticDance", "keywords": ["PoeticDance"], "long_description": "The creative inspiration for Poetic Dance \"The Journey of a Legendary Landscape Painting\" comes from the \"A Panorama of Mountains and Rivers\" painting.\n\n\"A Panorama of Mountains and Rivers\" is one of the top ten most famous ancient Chinese paintings passed down through generations. It was painted by the Northern Song Dynasty artist Wang Ximeng in half a year when he was only 18 years old. Unlike the black and white tones of ink wash paintings, this painting is named for the use of mineral pigments of azurite and malachite green, depicting the splendid and magnificent scenery of thousands of miles of rivers and mountains with its gorgeous green and blue hues.\n\nThe entire ballet poem is structured around chapters such as \"Scroll Unfolding, Seal Tracing, Silk Reeling, Minerals Exploring, Brush Making, Ink Grinding, Painting Alive\" narrating the story of a young researcher from the Palace Museum who \"time travels\" back to the Northern Song Dynasty, and from the perspective of an \"The Scroll Opener\", \"witnesses\" the story of the painter Wang Ximeng creating the \"A Panorama of Mountains and Rivers\"\n\nThis group dance expresses the concept of layered mountain ranges. The dancers, with their resplendent bodies, outline the boundless rivers and mountains that are as poetic and illusory as a dream, narrating the legendary tales of classical Chinese style.", "short_description": "The Journey of a Legendary Landscape Painting."}]}, "developer_name": null, "developer_privacy_policy_url": "http://file.cooolar.com/h5/zcql_agreement-private-en.html", "developer_terms_of_service_url": null, "publisher_name": "\u5143\u7f8e\u79d1\u6280", "support_website_url": null, "website_url": "https://www.cooolar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recom
7kNvwGdFF-T&_nc_oc=Adp01DlM4geeeAsaf4qpzDrzH8pCQoE9fzVfm13_8HFbQdHQCuaJzwCkeFmSccZHhzE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnH5GddE30XdPBIr4q_id-Gp4JEakF6k7TJw09jhAe2w&oe=6AA405B5"}, {"file_name": "mr6kWW.png", "id": "250912249552068", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982473_250912256218734_3911875050923360256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPTPPDqm3qcQ7kNvwF4xMlr&_nc_oc=Adoyyq7wVn_ncxV987g85nYC6TTFCoxpJ-75fq_WGEUdoGBJHke7aTozaCQI1TZHC8I&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5LZlfxBsxmljEaRkeIqWnqPZ0-bqaWStooDfzIGYWEA&oe=6AA3F4C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Horror Maze", "keywords": ["horror", "maze", "dungeon", "generator", "procedural"], "long_description": "ATTENTION: If you have any heart or epilepsy problems do not play this horror game! Be warned.\n\nYou must escape the horror dungeon before a creepy creature put hands on you!\n\nEvery playthrough will be unique due to the procedural maze generator.\nWhen you start the game a new world will be generated, you wake up in a dark cell...\nTry to make it out alive and avoid to make any noise because the creepy maze monster could hear and chase you...\nHide and try to stay safe, find items or tools to succeed and escape with the elevator.\nHeadphones are recommended for ultimate immersion.\n\n\nNew Features coming soon! (Tell us what you would like to play, we love feedback!)\n\nIf you are experiencing any bugs feel free to contact us, we're still learning.", "short_description": "You must escape the horror dungeon before a creepy creature put hands on you!\nEvery playthrough will be unique due to the procedural maze generator."}]}, "developer_name": "Tom Foerster", "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url": null, "website_url": "http://www
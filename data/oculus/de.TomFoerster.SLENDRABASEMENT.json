5/38982473_250912256218734_3911875050923360256_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5xA0-_htG4Q7kNvwF3nOmx&_nc_oc=AdqrFktms18YVzuPfUjuEFrF16caa31FyQIkn-P80TfdYaj06x_vp-qp3_n1UJsLHn8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXMtQ_fMRcl5V2horRZTIUWSK9v7x2xtkcjdGRa8tJ9tQ&oe=6B0EF684"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Horror Maze", "keywords": ["horror", "maze", "dungeon", "generator", "procedural"], "long_description": "ATTENTION: If you have any heart or epilepsy problems do not play this horror game! Be warned.\n\nYou must escape the horror dungeon before a creepy creature put hands on you!\n\nEvery playthrough will be unique due to the procedural maze generator.\nWhen you start the game a new world will be generated, you wake up in a dark cell...\nTry to make it out alive and avoid to make any noise because the creepy maze monster could hear and chase you...\nHide and try to stay safe, find items or tools to succeed and escape with the elevator.\nHeadphones are recommended for ultimate immersion.\n\n\nNew Features coming soon! (Tell us what you would like to play, we love feedback!)\n\nIf you are experiencing any bugs feel free to contact us, we're still learning.", "short_description": "You must escape the horror dungeon before a creepy creature put hands on you!\nEvery playthrough will be unique due to the procedural maze generator."}]}, "developer_name": "Tom Foerster", "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url": null, "website_url": "http://www.forstech.de/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "p
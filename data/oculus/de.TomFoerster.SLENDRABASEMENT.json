oculuscdn.com&_nc_ss=8&oh=00_Afw2bTTW14o1EDpW5Z_OEYBacX2gNReqx5LtyI5QNRHYSQ&oe=69AC2BB5"}, {"file_name": "mr6kWW.png", "id": "250912249552068", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982473_250912256218734_3911875050923360256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bP_Ut2ZZ76AQ7kNvwHs-bP8&_nc_oc=Adlyt2HpPrjD8LSXnzbZTWUDiymYPULTLfi3buV7g9PmnvEBWeU8qwtuUISfIcemo3E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwMLiHC8wZ7zjsZf2QlrMTS3jaumhpmnhz6g7pvvSXbGg&oe=69AC1AC4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Horror Maze", "keywords": ["horror", "maze", "dungeon", "generator", "procedural"], "long_description": "ATTENTION: If you have any heart or epilepsy problems do not play this horror game! Be warned.\n\nYou must escape the horror dungeon before a creepy creature put hands on you!\n\nEvery playthrough will be unique due to the procedural maze generator.\nWhen you start the game a new world will be generated, you wake up in a dark cell...\nTry to make it out alive and avoid to make any noise because the creepy maze monster could hear and chase you...\nHide and try to stay safe, find items or tools to succeed and escape with the elevator.\nHeadphones are recommended for ultimate immersion.\n\n\nNew Features coming soon! (Tell us what you would like to play, we love feedback!)\n\nIf you are experiencing any bugs feel free to contact us, we're still learning.", "short_description": "You must escape the horror dungeon before a creepy creature put hands on you!\nEvery playthrough will be unique due to the procedural maze generator."}]}, "developer_name": "Tom Foerster", "developer_privacy_policy_url": "http://forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Foerster", "support_website_url": null, "website_url": "http://www.forstech.de/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "conte
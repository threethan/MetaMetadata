 like no other.\n\nExplore this virtual world and find those that have been affected by this tragedy you are now involved in. They will help you out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onlywander.com/last-outta-dustin/privacy-policy/", "developer_terms_of_service_url": "https://onlywander.com/last-outta-dustin/terms-and-conditions/", "publisher_name": "Only Wander", "support_website_url": null, "website_url": "https://lastouttadustin.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "785049135986928"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1110018376258937"}]}, "baseline_offer": {"id": "1110018376258937"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1658166360, "status": "PUBLISHED", "id": "1110018376258937"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4598683396831774", "version": "1.3"}, "id": "118221046821626", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4060759473957505", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "4598
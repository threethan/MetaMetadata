O7nUSD4x4TA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi-OCxh3R1Xe5Yn9xbK9b_j2XEm50PPQprMSw68Nl12A&oe=6B070973"}, "display_name": "Last Outta Dustin", "keywords": [], "long_description": "You find yourself in a strange, run-down town. No idea how you got here. No way to get out. If you help put the town back together maybe, just maybe, you'll find a way to finally leave this nightmare behind. But beware! You may actually like it and end up staying.\n\nForage what you can, defeat those who oppose you and build a town like no other.\n\nExplore this virtual world and find those that have been affected by this tragedy you are now involved in. They will help you out.", "short_description": "You find yourself in a strange, run-down town. No idea how you got here. No way to get out. If you help put the town back together maybe, just maybe, you'll find a way to finally leave this nightmare behind. But beware! You may actually like it and end up staying.\n\nForage what you can, defeat those who oppose you and build a town like no other.\n\nExplore this virtual world and find those that have been affected by this tragedy you are now involved in. They will help you out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onlywander.com/last-outta-dustin/privacy-policy/", "developer_terms_of_service_url": "https://onlywander.com/last-outta-dustin/terms-and-conditions/", "publisher_name": "Only Wander", "support_website_url": null, "website_url": "https://lastouttadustin.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
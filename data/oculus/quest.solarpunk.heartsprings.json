U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMKuZFjLOycP9Ct8y9nmGcIH2j8C3R_Jq78nNZuq5kcA&oe=6AFDB182"}, {"file_name": "glacia-kinetic-upgrade-2560x1440.png", "id": "1725808052457816", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824700_1725808055791149_5740600845931566345_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ea4TLWvhxvwQ7kNvwEqBWbc&_nc_oc=Adr8monet99qeOz2g48a94AOceyp48W6hvXcNehdzlzFB6g1bP0S7FOqSuuLIlmsHhs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5vvg2HXXqqRj79D7hkFC36f7Hfp4lJyCw4VvrUO9_Ng&oe=6AFDCA62"}, {"file_name": "glacia-missile-specializations-2560x1440.png", "id": "1835484280787692", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824671_1835484287454358_6660613162679069661_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOXu_u0n_h0Q7kNvwFoQjPz&_nc_oc=Adp8xomM10px5oaamjGvTDmENrvRQ1lS44-0iwB8vmj5eaXNvVUp4Ay1mhlCXuFktLU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-3MzeYBvh1D-5BZU2HxKmfPmVJQCLgIen9Gj3mhyC-Q&oe=6AFDD01F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "solarpunk-cover-2560x1440.png", "id": "978158214606293", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824328_978158217939626_2029387465870333613_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4OWU6qWg5UQ7kNvwHj6Ilk&_nc_oc=Ado7CZItCOUsQCevv1SDhP1TRPgpCno1EfZKQ0eT7iJnzbCYfjtJPCyu1-yxncNqXvU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWd07TIOopyqwSx7lrpSSiW2fhJ7zF43LHXAZlLlxktw&oe=6AFDDDAC"}, "display_name": "Solarpunk: Heartsprings", "keywords": ["towerdefense", "strategy", "towers", "planets", "solarpunk"], "long_description": "Seven living planets. Twenty-one battles. Your hands in command.\n\nSolarpunk: Heartsprings brings tower defense to a miniature world you can rotate and defend in VR. Build between winding roads, watch alien waves approach, and protect the planet's Heartspring.\n\nBUILD YOUR STRATEGY\nPick up Kinetic, Tesla, Missile, and Frost towers. Preview their range before placing them. Choose permanent specializations, launch guided rockets, break shields, slow swarms, and focus fire on Menders before they heal nearby aliens.\n\nDISCOVER SEVEN WORLDS\nDefend oceans, sunlit dunes, frozen landscapes, volcanic terrain, dense forests, and Noctara's glowing night. Each planet brings distinct roads and tactical conditions. Survive to unlock the next mission, then return for a perfect three-star defense.\n\nPLAY YOUR WAY\nUse Touch controllers or hand tracking. Play seated or standing, adjust the planet's size and height, and move the panels to suit your space.\n\nThe full campaign is included. No ads or in-app purchases. Progress is saved on your device. Gameplay runs locally, with Meta purchase verification at launch. Available in eight languages.", "short_description": "Defend seven living planets in a hands-on VR tower defense game. Pick up towers, rotate the globe, and protect every Heartspring across 21 missions. Choose powerful upgrades and specializations. Play seated or standing with controllers or hand tracking."}, {"images": {"nodes": []}, "id": "2022514168465616", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Solarpunk: Heartsprings", "keywords": ["TowerDefense", "Strategie", "T\u00fcrme", "Planeten", "Solarpunk"], "long_description": "Sieben lebendige Planeten. 21 Schlachten. Deine H\u00e4nde f\u00fchren das Kommando.\n\nSolarpunk: Heartsprings bringt Tower Defense auf eine kleine Welt, die du in VR drehen und verteidigen kannst. Baue zwischen gewundenen Stra\u00dfen, beobachte anr\u00fcckende Alien-Wellen und besch\u00fctze den Heartspring.\n\nPLANE DEINE VERTEIDIGUNG\nGreife Kinetik-, Tesla-, Raketen- und Frost-T\u00fcrme. Pr\u00fcfe ihre Reichweite vor dem Platzieren. W\u00e4hle dauerhafte Spezialisierungen, feuere gelenkte Raketen, brich Schilde und verlangsame Schw\u00e4rme. Konzentriere das Feuer auf Mender, bevor sie andere Aliens heilen.\n\nENTDECKE SIEBEN WELTEN\nVerteidige Ozeane, sonnige D\u00fcnen, Eislandschaften, Vulkane, dichte W\u00e4lder und Noctaras leuchtende Nacht. Jeder Planet hat eigene Stra\u00dfen und taktische Bedingungen. \u00dcberlebe, um die n\u00e4chste Mission freizuschalten. Kehre f\u00fcr eine perfekte Drei-Sterne-Verteidigung zur\u00fcck.\n\nSPIELE AUF DEINE ART\nNutze Touch-Controller oder Handtracking. Spiele im Sitzen oder Stehen, passe Gr\u00f6\u00dfe und H\u00f6he des Planeten an und verschiebe die Bedienfelder.\n\nDie gesamte Kampagne ist enthalten. Keine Werbung und keine In-App-K\u00e4ufe. Dein Fortschritt wird auf dem Ger\u00e4t gespeichert. Das Spiel l\u00e4uft lokal, mit Meta-Kaufpr\u00fcfung beim Start. In acht Sprachen verf\u00fcgbar.", "short_description": "Verteidige sieben lebendige Planeten in einem VR-Tower-Defense-Spiel. Greife T\u00fcrme, drehe die Welt und besch\u00fctze jeden Heartspring in 21 Missionen. W\u00e4hle starke Upgrades und Spezialisierungen. Spiele im Sitzen oder Stehen mit Controllern oder Handtracking."}, {"images": {"nodes": []}, "id": "1881946016300990", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Solarpunk: Heartsprings", "keywords": ["torres", "estrategia", "defensa", "planetas", "solarpunk"], "long_description": "Siete planetas vivos. 21 batallas. Tus manos al mando.\n\nSolarpunk: Heartsprings lleva la defensa de torres a un mundo en miniatura que puedes girar y defender en VR. Construye entre caminos sinuosos y protege el Heartspring de oleadas alien\u00edgenas.\n\nPREPARA TU ESTRATEGIA\nToma torres Cin\u00e9ticas, Tesla, de Misiles y de Hielo. Revisa su alcance antes de colocarlas. Elige especializaciones permanentes, lanza misiles guiados, rompe escudos y frena enjambres. Concentra el fuego en los Menders antes de que curen a otros enemigos.\n\nDESCUBRE SIETE MUNDOS\nDefiende oc\u00e9anos, dunas, paisajes helados, volcanes, bosques y la noche luminosa de Noctara. Cada planeta tiene caminos y condiciones t\u00e1cticas propios. Sobrevive para desbloquear la siguiente misi\u00f3n y vuelve por una defensa perfecta de tres estrellas.\n\nJUEGA A TU MANERA\nUsa controles Touch o seguimiento de manos. Juega sentado o de pie, ajusta el tama\u00f1o y la altura del planeta y mueve los paneles.\n\nIncluye toda la campa\u00f1a. Sin anuncios ni compras dentro de la app. Tu progreso se guarda en el dispositivo. El juego funciona localmente, con verificaci\u00f3n de compra de Meta al iniciar. Disponible en ocho idiomas.", "short_description": "Defiende siete planetas vivos en un juego de defensa de torres en VR. Toma las torres, gira el planeta y protege cada Heartspring en 21 misiones. Elige mejoras y especializaciones. Juega sentado o de pie con controles o seguimiento de manos."}, {"images": {"nodes": []}, "id": "1790955232026731", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Solarpunk: Heartsprings", "keywords": ["\u30bf\u30ef\u30fc\u30c7\u30a3\u30d5\u30a7\u30f3\u30b9", "\u6226\u7565", "\u30cf\u30f3\u30c9\u30c8\u30e9\u30c3\u30ad\u30f3\u30b0", "\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4", "\u30bd\u30fc\u30e9\u30fc\u30d1\u30f3\u30af"], "long_description": "7\u3064\u306e\u751f\u304d\u305f\u60d1\u661f\u300221\u306e\u6226\u3044\u3002\u6307\u63ee\u3092\u57f7\u308b\u306e\u306f\u3001\u3042\u306a\u305f\u306e\u624b\u3002\n\nSolarpunk: Heartsprings\u306f\u3001\u624b\u3067\u56de\u305b\u308b\u5c0f\u3055\u306a\u60d1\u661f\u3092\u821e\u53f0\u306b\u3057\u305fVR\u30bf\u30ef\u30fc\u30c7\u30a3\u30d5\u30a7\u30f3\u30b9\u3067\u3059\u3002\u66f2\u304c\u308a\u304f\u306d\u3063\u305f\u9053\u306e\u9593\u306b\u30bf\u30ef\u30fc\u3092\u914d\u7f6e\u3057\u3001\u8feb\u308b\u30a8\u30a4\u30ea\u30a2\u30f3\u306e\u6ce2\u304b\u3089\u30cf\u30fc\u30c8\u30b9\u30d7\u30ea\u30f3\u30b0\u3092\u5b88\u308a\u307e\u3057\u3087\u3046\u3002\n\n\u6226\u7565\u3092\u7d44\u307f\u7acb\u3066\u3088\u3046\n\u30ad\u30cd\u30c6\u30a3\u30c3\u30af\u3001\u30c6\u30b9\u30e9\u3001\u30df\u30b5\u30a4\u30eb\u3001\u30d5\u30ed\u30b9\u30c8\u306e\u30bf\u30ef\u30fc\u3092\u624b\u306b\u53d6\u308a\u3001\u914d\u7f6e\u524d\u306b\u5c04\u7a0b\u3092\u78ba\u8a8d\u3002\u5909\u66f4\u3067\u304d\u306a\u3044\u5c02\u9580\u5316\u3092\u9078\u3073\u3001\u8a98\u5c0e\u30df\u30b5\u30a4\u30eb\u3092\u767a\u5c04\u3057\u3001\u30b7\u30fc\u30eb\u30c9\u3092\u7834\u308a\u3001\u7fa4\u308c\u3092\u6e1b\u901f\u3055\u305b\u307e\u3059\u3002\u30e1\u30f3\u30c0\u30fc\u304c\u5468\u56f2\u306e\u6575\u3092\u56de\u5fa9\u3059\u308b\u524d\u306b\u3001\u96c6\u4e2d\u653b\u6483\u3092\u6307\u793a\u3057\u307e\u3057\u3087\u3046\u3002\n\n7\u3064\u306e\u4e16\u754c\u3078\n\u6d77\u3001\u7802\u4e18\u3001\u6c37\u306e\u5927\u5730\u3001\u706b\u5c71\u3001\u68ee\u3001\u305d\u3057\u3066\u30ce\u30af\u30bf\u30e9\u306e\u8f1d\u304f\u591c\u3092\u5b88\u308a\u307e\u3057\u3087\u3046\u3002\u5404\u60d1\u661f\u306b\u306f\u7570\u306a\u308b\u9053\u3068\u6226\u8853\u6761\u4ef6\u304c\u3042\u308a\u307e\u3059\u3002\u751f\u304d\u6b8b\u308c\u3070\u6b21\u306e\u30df\u30c3\u30b7\u30e7\u30f3\u304c\u89e3\u653e\u3055\u308c\u307e\u3059\u3002\u518d\u6311\u6226\u3057\u3066\u3001\u5b8c\u5168\u9632\u885b\u306e3\u3064\u661f\u3092\u76ee\u6307\u3057\u307e\u3057\u3087\u3046\u3002\n\n\u81ea\u5206\u306b\u5408\u3063\u305f\u904a\u3073\u65b9\nTouch\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u3068\u30cf\u30f3\u30c9\u30c8\u30e9\u30c3\u30ad\u30f3\u30b0\u306b\u5bfe\u5fdc\u3002\u5ea7\u4f4d\u3067\u3082\u7acb\u4f4d\u3067\u3082\u30d7\u30ec\u30a4\u3067\u304d\u3001\u60d1\u661f\u306e\u5927\u304d\u3055\u3084\u9ad8\u3055\u3092\u8abf\u6574\u3057\u3001\u30d1\u30cd\u30eb\u3092\u597d\u304d\u306a\u4f4d\u7f6e\u306b\u79fb\u52d5\u3067\u304d\u307e\u3059\u3002\n\n\u5168\u30ad\u30e3\u30f3\u30da\u30fc\u30f3\u3092\u53ce\u9332\u3002\u5e83\u544a\u3084\u30a2\u30d7\u30ea\u5185\u8cfc\u5165\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u9032\u884c\u72b6\u6cc1\u306f\u30c7\u30d0\u30a4\u30b9\u306b\u4fdd\u5b58\u3055\u308c\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306f\u30ed\u30fc\u30ab\u30eb\u3067\u52d5\u4f5c\u3057\u3001\u8d77\u52d5\u6642\u306bMeta\u306e\u8cfc\u5165\u78ba\u8a8d\u3092\u884c\u3044\u307e\u3059\u30028\u8a00\u8a9e\u306b\u5bfe\u5fdc\u3002", "short_description": "7\u3064\u306e\u751f\u304d\u305f\u60d1\u661f\u3092\u5b88\u308bVR\u30bf\u30ef\u30fc\u30c7\u30a3\u30d5\u30a7\u30f3\u30b9\u3002\u30bf\u30ef\u30fc\u3092\u624b\u306b\u53d6\u308a\u3001\u60d1\u661f\u3092\u56de\u3057\u3066\u914d\u7f6e\u3057\u300121\u306e\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u30cf\u30fc\u30c8\u30b9\u30d7\u30ea\u30f3\u30b0\u3092\u5b88\u308d\u3046\u3002\u5f37\u5316\u3068\u5c02\u9580\u5316\u3092\u9078\u3073\u3001\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u3084\u30cf\u30f3\u30c9\u30c8\u30e9\u30c3\u30ad\u30f3\u30b0\u3067\u30d7\u30ec\u30a4\u3002\u5ea7\u3063\u3066\u3082\u7acb\u3063\u3066\u3082\u697d\u3057\u3081\u307e\u3059\u3002"}, {"images": {"nodes": []}, "id": "1772525327284799", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Solarpunk: Heartsprings", "keywords": ["towerdefense", "strat\u00e9gie", "tours", "plan\u00e8tes", "solarpunk"], "long_description": "Sept plan\u00e8tes vivantes. 21 batailles. Vos mains aux commandes.\n\nSolarpunk: Heartsprings transforme le tower defense en un monde miniature \u00e0 faire tourner et \u00e0 d\u00e9fendre en VR. Construisez entre les routes sinueuses et prot\u00e9gez le Heartspring des vagues extraterrestres.\n\nPR\u00c9PAREZ VOTRE STRAT\u00c9GIE\nSaisissez les tours Cin\u00e9tique, Tesla, Missile et Givre. V\u00e9rifiez leur port\u00e9e avant de les placer. Choisissez des sp\u00e9cialisations permanentes, lancez des missiles guid\u00e9s, brisez les boucliers et ralentissez les essaims. Concentrez vos tirs sur les Menders avant qu'ils ne soignent les autres ennemis.\n\nD\u00c9COUVREZ SEPT MONDES\nD\u00e9fendez des oc\u00e9ans, des dunes, des paysages gel\u00e9s, des volcans, des for\u00eats et la nuit lumineuse de Noctara. Chaque plan\u00e8te poss\u00e8de ses propres routes et conditions tactiques. Survivez pour d\u00e9bloquer la mission suivante, puis revenez viser une d\u00e9fense parfaite \u00e0 trois \u00e9toiles.\n\nJOUEZ \u00c0 VOTRE FA\u00c7ON\nUtilisez les manettes Touch ou le suivi des mains. Jouez assis ou debout, r\u00e9glez la taille et la hauteur de la plan\u00e8te et d\u00e9placez les panneaux.\n\nLa campagne compl\u00e8te est incluse. Aucune publicit\u00e9 ni achat int\u00e9gr\u00e9. La progression est sauvegard\u00e9e sur votre appareil. Le jeu fonctionne localement, avec une v\u00e9rification de l'achat Meta au lancement. Disponible en huit langues.", "short_description": "D\u00e9fendez sept plan\u00e8tes vivantes dans un jeu de tower defense en VR. Saisissez les tours, faites tourner le globe et prot\u00e9gez chaque Heartspring au fil de 21 missions. Choisissez vos am\u00e9liorations et sp\u00e9cialisations. Jouez assis ou debout avec les manettes ou le suivi des mains."}, {"images": {"nodes": []}, "id": "1498436399007648", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Solarpunk: Heartsprings", "keywords": ["\u5854\u9632", "\u7b56\u7565", "\u624b\u90e8\u8ffd\u8e2a", "\u5355\u4eba\u6e38\u620f", "\u592a\u9633\u670b\u514b"], "long_description": "\u4e03\u9897\u9c9c\u6d3b\u7684\u661f\u7403\u300221\u573a\u6218\u6597\u3002\u7531\u4f60\u7684\u53cc\u624b\u6307\u6325\u3002\n\nSolarpunk: Heartsprings\u5c06\u5854\u9632\u5e26\u5165\u4e00\u4e2a\u53ef\u4ee5\u4eb2\u624b\u8f6c\u52a8\u7684VR\u5fae\u578b\u4e16\u754c\u3002\u5728\u873f\u8712\u9053\u8def\u4e4b\u95f4\u90e8\u7f72\u9632\u5fa1\u5854\uff0c\u8fce\u51fb\u5916\u661f\u654c\u4eba\u7684\u6ce2\u6b21\uff0c\u5b88\u62a4\u661f\u7403\u7684\u751f\u547d\u6cc9\u3002\n\n\u6253\u9020\u4f60\u7684\u6218\u672f\n\u62ff\u8d77\u52a8\u80fd\u3001\u7279\u65af\u62c9\u3001\u5bfc\u5f39\u548c\u51b0\u971c\u9632\u5fa1\u5854\uff0c\u653e\u7f6e\u524d\u67e5\u770b\u5c04\u7a0b\u3002\u9009\u62e9\u6c38\u4e45\u4e13\u7cbe\uff0c\u53d1\u5c04\u5236\u5bfc\u5bfc\u5f39\u3001\u51fb\u7834\u62a4\u76fe\u3001\u51cf\u7f13\u654c\u7fa4\u3002\u5728\u4fee\u590d\u8005\u6cbb\u7597\u5468\u56f4\u654c\u4eba\u4e4b\u524d\uff0c\u6307\u6325\u706b\u529b\u4f18\u5148\u653b\u51fb\u5b83\u4eec\u3002\n\n\u53d1\u73b0\u4e03\u4e2a\u4e16\u754c\n\u5b88\u62a4\u6d77\u6d0b\u3001\u6c99\u4e18\u3001\u51b0\u5c01\u5927\u5730\u3001\u706b\u5c71\u3001\u8302\u5bc6\u68ee\u6797\u4ee5\u53ca\u8bfa\u514b\u5854\u62c9\u7684\u8367\u5149\u591c\u666f\u3002\u6bcf\u9897\u661f\u7403\u90fd\u6709\u4e0d\u540c\u7684\u9053\u8def\u4e0e\u6218\u672f\u6761\u4ef6\u3002\u751f\u5b58\u4e0b\u6765\u5373\u53ef\u89e3\u9501\u4e0b\u4e00\u4e2a\u4efb\u52a1\uff0c\u518d\u6b21\u6311\u6218\uff0c\u4e89\u53d6\u5b8c\u7f8e\u9632\u5b88\u7684\u4e09\u661f\u6210\u7ee9\u3002\n\n\u6309\u4f60\u7684\u65b9\u5f0f\u6e38\u73a9\n\u652f\u6301Touch\u63a7\u5236\u5668\u4e0e\u624b\u90e8\u8ffd\u8e2a\u3002\u53ef\u4ee5\u5750\u7740\u6216\u7ad9\u7740\u73a9\uff0c\u8c03\u6574\u661f\u7403\u5927\u5c0f\u4e0e\u9ad8\u5ea6\uff0c\u5e76\u5c06\u9762\u677f\u79fb\u52a8\u5230\u8212\u9002\u7684\u4f4d\u7f6e\u3002\n\n\u5305\u542b\u5b8c\u6574\u6218\u5f79\u3002\u65e0\u5e7f\u544a\uff0c\u65e0\u5e94\u7528\u5185\u8d2d\u4e70\u3002\u8fdb\u5ea6\u4fdd\u5b58\u5728\u8bbe\u5907\u4e0a\u3002\u6e38\u620f\u5728\u672c\u5730\u8fd0\u884c\uff0c\u542f\u52a8\u65f6\u8fdb\u884cMeta\u8d2d\u4e70\u9a8c\u8bc1\u3002\u652f\u6301\u516b\u79cd\u8bed\u8a00\u3002", "short_description": "\u4eb2\u624b\u5b88\u62a4\u4e03\u9897\u5145\u6ee1\u751f\u673a\u7684\u661f\u7403\uff0c\u4f53\u9a8cVR\u5854\u9632\u3002\u62ff\u8d77\u9632\u5fa1\u5854\u3001\u8f6c\u52a8\u661f\u7403\uff0c\u572821\u4e2a\u4efb\u52a1\u4e2d\u4fdd\u62a4\u6bcf\u5ea7\u751f\u547d\u6cc9\u3002\u9009\u62e9\u5f3a\u529b\u5347\u7ea7\u4e0e\u4e13\u7cbe\uff0c\u4f7f\u7528\u63a7\u5236\u5668\u6216\u624b\u90e8\u8ffd\u8e2a\uff0c\u5750\u7740\u6216\u7ad9\u7740\u90fd\u80fd\u73a9\u3002"}, {"images": {"nodes": []}, "id": "1400405488912296", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Solarpunk: Heartsprings", "keywords": ["torres", "estrat\u00e9gia", "defesa", "planetas", "solarpunk"], "long_description": "Sete planetas vivos. 21 batalhas. Suas m\u00e3os no comando.\n\nSolarpunk: Heartsprings leva a defesa de torres a um mundo em miniatura que voc\u00ea pode girar e defender em VR. Construa entre caminhos sinuosos e proteja o Heartspring das ondas alien\u00edgenas.\n\nPREPARE SUA ESTRAT\u00c9GIA\nPegue torres Cin\u00e9ticas, Tesla, de M\u00edsseis e de Gelo. Confira o alcance antes de posicion\u00e1-las. Escolha especializa\u00e7\u00f5es permanentes, lance m\u00edsseis guiados, quebre escudos e desacelere enxames. Concentre o fogo nos Menders antes que curem os outros inimigos.\n\nDESCUBRA SETE MUNDOS\nDefenda oceanos, dunas, paisagens congeladas, vulc\u00f5es, florestas e a noite luminosa de Noctara. Cada planeta tem caminhos e condi\u00e7\u00f5es t\u00e1ticas pr\u00f3prios. Sobreviva para liberar a pr\u00f3xima miss\u00e3o e volte para conquistar uma defesa perfeita de tr\u00eas estrelas.\n\nJOGUE DO SEU JEITO\nUse controles Touch ou rastreamento das m\u00e3os. Jogue sentado ou em p\u00e9, ajuste o tamanho e a altura do planeta e mova os pain\u00e9is.\n\nA campanha completa est\u00e1 inclu\u00edda. Sem an\u00fancios nem compras no app. O progresso fica salvo no dispositivo. O jogo funciona localmente, com verifica\u00e7\u00e3o de compra da Meta ao iniciar. Dispon\u00edvel em oito idiomas.", "short_description": "Defenda sete planetas vivos em um jogo de defesa de torres em VR. Pegue as torres, gire o planeta e proteja cada Heartspring em 21 miss\u00f5es. Escolha melhorias e especializa\u00e7\u00f5es. Jogue sentado ou em p\u00e9 com controles ou rastreamento das m\u00e3os."}, {"images": {"nodes": []}, "id": "1096200246494316", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Solarpunk: Heartsprings", "keywords": ["\ud0c0\uc6cc\ub514\ud39c\uc2a4", "\uc804\ub7b5", "\uc190\ucd94\uc801", "\uc2f1\uae00\ud50c\ub808\uc774", "\uc194\ub77c\ud391\ud06c"], "long_description": "\uc0b4\uc544 \uc788\ub294 \uc77c\uacf1 \ud589\uc131. 21\ubc88\uc758 \uc804\ud22c. \uc9c0\ud718\uad8c\uc740 \uc5ec\ub7ec\ubd84\uc758 \uc190\uc5d0 \uc788\uc2b5\ub2c8\ub2e4.\n\nSolarpunk: Heartsprings\ub294 \uc190\uc73c\ub85c \ub3cc\ub9b4 \uc218 \uc788\ub294 \uc791\uc740 \ud589\uc131\uc744 \ubb34\ub300\ub85c \ud558\ub294 VR \ud0c0\uc6cc \ub514\ud39c\uc2a4 \uac8c\uc784\uc785\ub2c8\ub2e4. \uad7d\uc774\uce58\ub294 \uae38 \uc0ac\uc774\uc5d0 \ud0c0\uc6cc\ub97c \ubc30\uce58\ud558\uace0 \ubab0\ub824\uc624\ub294 \uc678\uacc4\uc778\uc73c\ub85c\ubd80\ud130 \ud558\ud2b8\uc2a4\ud504\ub9c1\uc744 \uc9c0\ud0a4\uc138\uc694.\n\n\uc804\ub7b5\uc744 \uc138\uc6b0\uc138\uc694\n\ud0a4\ub124\ud2f1, \ud14c\uc2ac\ub77c, \ubbf8\uc0ac\uc77c, \ud504\ub85c\uc2a4\ud2b8 \ud0c0\uc6cc\ub97c \uc9d1\uace0 \ubc30\uce58 \uc804\uc5d0 \uc0ac\uac70\ub9ac\ub97c \ud655\uc778\ud558\uc138\uc694. \uc601\uad6c\uc801\uc778 \ud2b9\ud654\ub97c \uc120\ud0dd\ud558\uace0 \uc720\ub3c4 \ubbf8\uc0ac\uc77c\ub85c \uacf5\uaca9\ud558\uba70 \ubc29\ud328\ub97c \uae68\uace0 \ubb34\ub9ac\uc758 \uc18d\ub3c4\ub97c \ub2a6\ucd94\uc138\uc694. \uba58\ub354\uac00 \uc8fc\ubcc0 \uc801\uc744 \ud68c\ubcf5\ud558\uae30 \uc804\uc5d0 \uc9d1\uc911 \uacf5\uaca9\uc744 \uc9c0\uc2dc\ud558\uc138\uc694.\n\n\uc77c\uacf1 \uc138\uacc4\ub97c \ubc1c\uacac\ud558\uc138\uc694\n\ubc14\ub2e4, \uc0ac\ub9c9, \uc5bc\uc5b4\ubd99\uc740 \ub545, \ud654\uc0b0, \uc6b8\ucc3d\ud55c \uc232\uacfc \ub179\ud0c0\ub77c\uc758 \ube5b\ub098\ub294 \ubc24\uc744 \uc9c0\ud0a4\uc138\uc694. \ud589\uc131\ub9c8\ub2e4 \uae38\uacfc \uc804\uc220 \uc870\uac74\uc774 \ub2e4\ub985\ub2c8\ub2e4. \uc0b4\uc544\ub0a8\uc544 \ub2e4\uc74c \uc784\ubb34\ub97c \ud574\uc81c\ud558\uace0 \ub2e4\uc2dc \ub3c4\uc804\ud574 \uc644\ubcbd\ud55c \ubc29\uc5b4\ub85c \ubcc4 \uc138 \uac1c\ub97c \ud68d\ub4dd\ud558\uc138\uc694.\n\n\ud3b8\ud558\uac8c \ud50c\ub808\uc774\ud558\uc138\uc694\nTouch \ucee8\ud2b8\ub864\ub7ec\uc640 \uc190 \ucd94\uc801\uc744 \uc9c0\uc6d0\ud569\ub2c8\ub2e4. \uc549\uac70\ub098 \uc11c\uc11c \ud50c\ub808\uc774\ud558\uace0 \ud589\uc131\uc758 \ud06c\uae30\uc640 \ub192\uc774\ub97c \uc870\uc808\ud558\uba70 \ud328\ub110\uc744 \uc6d0\ud558\ub294 \uc704\uce58\ub85c \uc62e\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uc804\uccb4 \ucea0\ud398\uc778\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uad11\uace0\uc640 \uc571 \ub0b4 \uad6c\ub9e4\uac00 \uc5c6\uc2b5\ub2c8\ub2e4. \uc9c4\ud589 \uc0c1\ud669\uc740 \uae30\uae30\uc5d0 \uc800\uc7a5\ub429\ub2c8\ub2e4. \uac8c\uc784\uc740 \ub85c\uceec\uc5d0\uc11c \uc2e4\ud589\ub418\uba70 \uc2dc\uc791\ud560 \ub54c Meta \uad6c\ub9e4 \ud655\uc778\uc744 \uc9c4\ud589\ud569\ub2c8\ub2e4. 8\uac1c \uc5b8\uc5b4\ub97c \uc9c0\uc6d0\ud569\ub2c8\ub2e4.", "short_description": "\uc0b4\uc544 \uc788\ub294 \uc77c\uacf1 \ud589\uc131\uc744 \uc9c0\ud0a4\ub294 VR \ud0c0\uc6cc \ub514\ud39c\uc2a4 \uac8c\uc784. \ud0c0\uc6cc\ub97c \uc9d1\uace0 \ud589\uc131\uc744 \ub3cc\ub9ac\uba70 21\uac1c \uc784\ubb34\uc5d0\uc11c \ud558\ud2b8\uc2a4\ud504\ub9c1\uc744 \ubcf4\ud638\ud558\uc138\uc694. \uc5c5\uadf8\ub808\uc774\ub4dc\uc640 \ud2b9\ud654\ub97c \uc120\ud0dd\ud558\uace0 \ucee8\ud2b8\ub864\ub7ec\ub098 \uc190 \ucd94\uc801\uc73c\ub85c \uc549\uac70\ub098 \uc11c\uc11c \ud50c\ub808\uc774\ud558\uc138\uc694."}]}, "developer_name": "Fidel Seehawer", "developer_privacy_policy_url": "https://solarpunk.quest/privacy/quest/", "developer_terms_of_service_url": null, "publisher_name": "Fidel Seehawer", "support_website_url": "https://solarpunk.quest/support/", "website_url": "https://solarpunk.quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "ext
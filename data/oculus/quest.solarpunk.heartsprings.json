0179774", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_1287054590179773_376938092779090122_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0T3TMt_PGYQ7kNvwGOejrb&_nc_oc=AdrWUD215NsuOjAZBim0NCucCAYNa066ofCwcLSVR1PYmsfYtiYNMj3ADxM_lQZDDUs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2Kev8SpCeP6-GuLym_6Q1B9IRjy7TRvlx2mhe-h-amQ&oe=6AFDD1A8"}]}, "id": "1063632393329529", "locale": "en_US", "screenshots": [{"file_name": "quest-restored-52.png", "id": "2129693217756126", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825497_2129693221089459_1199541266420546882_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZ9Koa6DwwAQ7kNvwGmXh2b&_nc_oc=Adr18vz9p_E-iTRBUfFq39_fJUWejuRyEP-HK7EITVy9wdFMJOXx4GHuayE49oeNd00&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR98v4UncA5CnyKS9sC3lBY8KgSvRIBKLjZlv4MT6C66Q&oe=6AFDD1C8"}, {"file_name": "quest-restored-40.png", "id": "2939075066470082", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823901_2939075069803415_4682523425111277048_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3B-4lMndLIQ7kNvwHMLI5h&_nc_oc=AdoV3V3w_ccgiO2F0bFu-JfmOITvUbNSiMTZH2JrWPmVABkV1ZOSXNBEdL8Yee4C1bM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_y0YnzT25Jiy2V4PTmhVCO13DfwmwiUoQFOf_sXpR2g&oe=6AFDDF2D"}, {"file_name": "quest-tower-placement.png", "id": "1390907929792898", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824741_1390907933126231_4324217694694089450_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fjyahN2VgwQ7kNvwHKnYqd&_nc_oc=AdonNTsDIdEyP0zi8yvoJkXnpiFGSZYVuHctNQuBXa3rp6Cr2xIotpGtwVlmSRg5UA4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2XpAlr98yxKsnp7QDffSKq8_qzNawazpu7E28EWpn-w&oe=6AFDCF9C"}, {"file_name": "quest-ashkar-upgrades.png", "id": "1120227437130468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824292_1120227447130467_6712399106330949767_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_GlzQX3ryoQ7kNvwFMeliL&_nc_oc=Adr42b8nClizKaeuPOk2dP73g4Nh61Tu50sK4P_LoxrjX7FnZLgpTQzSs-n1mLxXtjM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTF1Bp1aUomOzEteBzcbiEufXCEnjzwHqhkwXOL_iuscw&oe=6AFDD652"}, {"file_name": "quest-ashkar-combat.png", "id": "1447718113941061", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825305_1447718117274394_3378572732903437265_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVMiKJWbpgsQ7kNvwF1hlfB&_nc_oc=AdpCeoyM-ZgiV5CRiuI0reCBV_dU6q8TpZNVOsgfi7KSnBAOmW-Wdd_KP2lk6DyIYfA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_3aaxQ3aAGJaiT759a22VDQNOIyOzIKEyEr6CovXq6Q&oe=6AFDB780"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Solarpunk: Heartsprings", "keywords": [], "long_description": "Bring a miniature living world into VR and defend its Heartspring.\n\nSolarpunk: Heartsprings is a single-player tower defense game across seven distinct planets and 21 missions. Forests, oceans, frozen landscapes, volcanic terrain, and a glowing night world surround each battlefield.\n\nPICK UP YOUR DEFENSES\nGrab towers from the tray and place them beside the enemy route. Rotate the planet to find your next build site. See a tower\u2019s range before placing it, then choose upgrades and permanent specializations.\n\nMAKE EVERY SHOT COUNT\nCombine Kinetic, Tesla, Missile, and Frost towers against eight alien types. Prioritize a dangerous enemy, break shields, slow crowded waves, and stop healers before they restore the swarm. Call waves early for bonus credits and replay missions to improve your stars.\n\nPLAY YOUR WAY\nUse Touch controllers or hand tracking. Play seated or standing, adjust the tabletop height and planet size, and move the panels where they are comfortable to read.\n\nEnjoy the full campaign with no ads or in-app purchases. Progress is saved on your device. Gameplay runs locally, with Meta purchase verification at launch. Available in English, German, French, Latin American Spanish, Brazilian Portuguese, Japanese, Korean, and Simplified Chinese.", "short_description": "A living planet, a tower defense battle, and your hands in command. Protect the Heartsprings across seven worlds and 21 missions. Pick up towers, place your defenses, rotate the globe, and focus fire on dangerous aliens. Play seated or standing with Touch controllers or hand tracking."}]}, "developer_name": "Fidel Seehawer", "developer_privacy_policy_url": "https://solarpunk.quest/privacy/quest/", "developer_terms_of_service_url": null, "publisher_name": "Fidel Seehawer", "support_website_url": "https://solarpunk.quest/support/", "website_url": "https://solarpunk.quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "es_MX", "pt_BR", "ja", "ko", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1324500927416204"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1753448525773187"}]}, "baseline_offer": {"id": "1753448525773187"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791482760, "status": "PUBLISHED", "id": "1753448525773187"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "
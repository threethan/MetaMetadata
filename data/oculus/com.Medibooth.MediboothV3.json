e, and self-\ndiscovery. Whether you're seeking to unwind, refocus, or\nsimply escape the noise of daily life, Medibooth VR\nprovides a serene space to reconnect with yourself and\nthe present moment.", "short_description": "Medibooth VR immerses you in serene virtual environments, guiding you to relaxation and mindfulness through five unique meditation experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mediboothvr.com/_files/ugd/5306d6_c1deb7b389b44ad4bd4d5fc10a6a2142.pdf", "developer_terms_of_service_url": null, "publisher_name": "Garage Atlas", "support_website_url": null, "website_url": "https://www.mediboothvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9146127485514388"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393523_490117790807024_2796345537400006425_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfZwam7FMzoQ7kNvwFEW3wf&_nc_oc=AdqpAgjza9VWXo457rcUM9wY3vZnO7O98c9pE39nFk-luP-stRxT8XReRrgQOg7R9hg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEadxpMb8O5k3Vcdh6YFIFX8s4LTykrGE62kqBo71XIiQ&oe=6A844713"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Medibooth", "platform": "ANDROID_6DOF", "context_category": 
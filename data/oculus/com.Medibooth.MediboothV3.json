rsiveWellnessTechnology"], "long_description": "Medibooth VR is a transformative meditation app that\ncombines the power of guided mindfulness with the\nimmersive potential of virtual reality. Journey through\nfive beautifully designed levels, each offering a unique\natmosphere to inspire relaxation, inner peace, and self-\ndiscovery. Whether you're seeking to unwind, refocus, or\nsimply escape the noise of daily life, Medibooth VR\nprovides a serene space to reconnect with yourself and\nthe present moment.", "short_description": "Medibooth VR immerses you in serene virtual environments, guiding you to relaxation and mindfulness through five unique meditation experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mediboothvr.com/_files/ugd/5306d6_c1deb7b389b44ad4bd4d5fc10a6a2142.pdf", "developer_terms_of_service_url": null, "publisher_name": "Garage Atlas", "support_website_url": null, "website_url": "https://www.mediboothvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9146127485514388"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393523_490117790807024_2796345537400006425_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqAzhyVoALUQ7kNvwFRVv7y&_nc_oc=AdoU
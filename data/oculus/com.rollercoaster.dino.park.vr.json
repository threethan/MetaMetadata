QbJ5p78h78&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WCxek3v_PhrXSxUZWhdfYM1dieuAmUGgnBGxxhgAYAg&oe=6A242556"}, {"file_name": "4.png", "id": "1680107596666439", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499303746_1680107599999772_3826613643115583333_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yn0nVKs3g6MQ7kNvwFFDHz1&_nc_oc=AdpnyBlNA5YUO-F_jUN7AExhqE2qZx4u3uV5hurZ5IvA4oQXd7SOKIbvkqRp85ONcKI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RRFqGucyGrkKDlXOdPc4-ofatd-dSL2JgnQBqshwixA&oe=6A241ED8"}, {"file_name": "5.png", "id": "1250975090574155", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499307470_1250975093907488_6570551899842521598_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LV-NL7ryJiUQ7kNvwEDQHLr&_nc_oc=AdpKlzdhgi58hezQt3Fw5jW5tKMdH4x1MWJJLk6gs1DK5032A9bNtmgEWw9PtDqMUvk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bAbmJPbIiXUP2cjV4TSBpkXHdXwDspd6NCaZakBrYSA&oe=6A2432DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Roller Coaster Rush - Dino Park", "keywords": ["Roller", "Coaster", "Dino", "Ride", "Rush"], "long_description": "Roller Coaster Rush: Dino Park is a thrilling VR roller coaster simulator that takes you on an exciting ride through a wild dinosaur theme park filled with giant dinos, fast coaster tracks, sharp turns, steep drops, and fun amusement park thrills. Experience immersive VR coaster rides as you race through exciting tracks, prehistoric environments, and action-packed theme park adventures designed for roller coaster fans and dinosaur lovers.\n\nExplore the excitement of Dino Park with high-speed roller coaster rides, thrilling descents, fun park attractions, and unforgettable dinosaur encounters. This immersive roller coaster game combines the fun of a theme park simulator with the excitement of a VR thrill ride, delivering fast-paced coaster action, giant dinosaur scenery, and nonstop fun in a prehistoric park setting.\n\nIf you love VR roller coaster games, roller coaster simulator experiences, dinosaur games, theme park adventures, amusement ride simulators, and fun VR simulator games, Roller Coaster Rush: Dino Park delivers an exciting ride experience with dynamic coaster tracks, wild dino environments, and thrilling park action.\n\nRide through exciting loops, sharp turns, steep descents, and thrilling coaster paths as massive dinosaurs surround your journey. Discover the fun of a VR theme park, the excitement of a coaster adventure, and the thrill of a dinosaur park ride in one action packed experience designed for players who enjoy fun rides.", "short_description": "Experience a thrilling VR roller coaster simulator in Dino Park! Ride fast coaster tracks, giant dinosaur adventures, theme park thrills, fun amusement rides, and exciting roller coaster action in Roller Coaster Rush: Dino Park."}]}, "developer_name": "XZ Solutions", "developer_privacy_policy_url": "https://xzsol.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "XZ Solutions", "support_website_url": null, "website_url": "https://xzsol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34938906975723273"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824741_2269795040212403_162410648672279383_n.pn
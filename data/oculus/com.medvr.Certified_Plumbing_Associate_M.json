pAL&_nc_oc=AdqTIkb63ys3huGlIjP2bmyD6kuMt7GnCf3vh1J0SDpbjW53gaXCTXlE_K8Dgv_aY7A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WUBQqIm9l_h44Y32w9qr_dFb9xho61uc49oxnUL7wgg&oe=69FC8D4D"}, {"file_name": "vlcsnap-2025-01-30-18h44m50s137.png", "id": "1823245791752961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391865_1823245798419627_3331351789956567964_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9g7Cmimt5sQ7kNvwH4bezk&_nc_oc=AdoDsY7o7pHTZtC-kOmqCYMdZb4UB_-v7Ij9VN4Y5OeDqUfrBud8zlNG8p2bITBNFPI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KgL4Y_c50fWe3ifZn34Ji_Ft_pXODgYzCTxedESM3sA&oe=69FC83EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified Plumbing Associate", "keywords": ["Plumbing", "Immerselearn", "Training"], "long_description": "Certified Plumbing Associate is a VR training simulation that offers comprehensive, hands-on practice for aspiring plumbers and professionals. Dive into interactive modules covering essential plumbing skills, including:\n\n- Proper use of fire extinguishers.\n- Techniques for using hand tools correctly.\n-Understanding Plumbing PPE (Personal Protective Equipment).\n- Inspection and maintenance of power tools.\n- Accurate measurement with plumbing tools and pipe length calculations.\n- Introduction to plumbing drawings, pipe fittings, and fixtures.\n\nThis engaging virtual environment provides realistic scenarios for skill-building, allowing users to master essential techniques safely and efficiently. Perfect for both beginners and seasoned professionals, Certified Plumbing Associate ensures you're equipped with practical knowledge to excel in the plumbing industry.\nTrain smarter, safer, and more effectively\u2014immerse yourself in the world of plumbing today!", "short_description": "Certified Plumbing Associate is an immersive VR training app designed to provide hands-on practice in plumbing techniques. Learn fire extinguisher use, proper hand tool techniques, PPE, and power tool maintenance. Gain skills in measuring tools, pipe lengths, plumbing drawings, and fixture installations. Perfect for aspiring plumbers and professionals seeking practical, interactive training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerselearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "8971239896257671"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1293187481895299"}]}, "baseline_offer": {"id": "1293187481895299"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1738562280, "status": "PUBLISHED", "id": "1293187481895299"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24046482781640136", "version": "20"}, "id": "2030843240672675", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8959968040718190", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id"
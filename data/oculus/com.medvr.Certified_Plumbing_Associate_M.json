Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrwzBnQcOC1wr_2VhVNnUy-jhwkmZJsiS0CfizyOpEGA&oe=6A510550"}, {"file_name": "vlcsnap-2025-01-30-18h43m57s657.png", "id": "953476393091624", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473397186_953476396424957_3101880245997863484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsnAWFEeylgQ7kNvwHgCsHv&_nc_oc=Adr5g43-AYjApSMHFmK7T88DBP_v33UeVklxyriLLCFgDlCuW29ea5UUOhuFf_1bE5g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCODo8kIJZew2J7jI-1vaJm5NhC1R-_XLHDsYXW1yWK8g&oe=6A50ED4D"}, {"file_name": "vlcsnap-2025-01-30-18h44m50s137.png", "id": "1823245791752961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391865_1823245798419627_3331351789956567964_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3yLklWow34Q7kNvwFvLxPK&_nc_oc=Adp_8IInlj9XpstlVJrUVShdxeacJRjadT6uIPPCjf2fL_ctx3dfmubMyV7cmb1U6oc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBdcQxEe9A64rLoPwGixZXlZC-ZsfctGJt4oUYrAyrzA&oe=6A50E3EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified Plumbing Associate", "keywords": ["Plumbing", "Immerselearn", "Training"], "long_description": "Certified Plumbing Associate is a VR training simulation that offers comprehensive, hands-on practice for aspiring plumbers and professionals. Dive into interactive modules covering essential plumbing skills, including:\n\n- Proper use of fire extinguishers.\n- Techniques for using hand tools correctly.\n-Understanding Plumbing PPE (Personal Protective Equipment).\n- Inspection and maintenance of power tools.\n- Accurate measurement with plumbing tools and pipe length calculations.\n- Introduction to plumbing drawings, pipe fittings, and fixtures.\n\nThis engaging virtual environment provides realistic scenarios for skill-building, allowing users to master essential techniques safely and efficiently. Perfect for both beginners and seasoned professionals, Certified Plumbing Associate ensures you're equipped with practical knowledge to excel in the plumbing industry.\nTrain smarter, safer, and more effectively\u2014immerse yourself in the world of plumbing today!", "short_description": "Certified Plumbing Associate is an immersive VR training app designed to provide hands-on practice in plumbing techniques. Learn fire extinguisher use, proper hand tool techniques, PPE, and power tool maintenance. Gain skills in measuring tools, pipe lengths, plumbing drawings, and fixture installations. Perfect for aspiring plumbers and professionals seeking practical, interactive training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerselearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "8971239896257671"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1293187481895299"}]}, "baseline_offer": {"id": "1293187481895299"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1738562280, "status": "PUBLISHED", "id": "1293187481895299"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2
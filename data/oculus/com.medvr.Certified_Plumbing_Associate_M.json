}, {"file_name": "vlcsnap-2025-01-30-18h37m54s148.png", "id": "531961935879802", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393905_531961939213135_4155838995787176415_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97zm0JVwXiQQ7kNvwGYC1ty&_nc_oc=AdrD9NI3zrBhetYGr-qCMhjEUXwKEMRaK4fnW2UJIYx-0VeG0TzUetRfsDUy-2lNx44&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfUYrC0KEK0NFWpALBn5hCLPPsOPrmgURCPlPPaO-Y7Q&oe=6A86DA90"}, {"file_name": "vlcsnap-2025-01-30-18h43m57s657.png", "id": "953476393091624", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473397186_953476396424957_3101880245997863484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5l6L4xif5REQ7kNvwFxrNcF&_nc_oc=AdpNw9Kzvwuf4cxBinGrGkCZyXZcbvQeBHJ_cPpWsf4I9fSg4jbMskbXrAE0Cwrgd9s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgMTdpNQUVEGd6AaKbXVDnWFADAxl4DGb3CKVpToWdbA&oe=6A86FACD"}, {"file_name": "vlcsnap-2025-01-30-18h44m50s137.png", "id": "1823245791752961", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391865_1823245798419627_3331351789956567964_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2iN9QJ3Bl0MQ7kNvwF50GUo&_nc_oc=AdpXg_OFOLOp8t9T-uiNLiywDnJsBJiaosUl9f1GU-_cPax_GSBXhRDRPaJFS9NHXa0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETXE2uug9c-ShQVE3s4UQejljQf6sTiTH0xI0g4U0Qag&oe=6A86F16C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified Plumbing Associate", "keywords": ["Plumbing", "Immerselearn", "Training"], "long_description": "Certified Plumbing Associate is a VR training simulation that offers comprehensive, hands-on practice for aspiring plumbers and professionals. Dive into interactive modules covering essential plumbing skills, including:\n\n- Proper use of fire extinguishers.\n- Techniques for using hand tools correctly.\n-Understanding Plumbing PPE (Personal Protective Equipment).\n- Inspection and maintenance of power tools.\n- Accurate measurement with plumbing tools and pipe length calculations.\n- Introduction to plumbing drawings, pipe fittings, and fixtures.\n\nThis engaging virtual environment provides realistic scenarios for skill-building, allowing users to master essential techniques safely and efficiently. Perfect for both beginners and seasoned professionals, Certified Plumbing Associate ensures you're equipped with practical knowledge to excel in the plumbing industry.\nTrain smarter, safer, and more effectively\u2014immerse yourself in the world of plumbing today!", "short_description": "Certified Plumbing Associate is an immersive VR training app designed to provide hands-on practice in plumbing techniques. Learn fire extinguisher use, proper hand tool techniques, PPE, and power tool maintenance. Gain skills in measuring tools, pipe lengths, plumbing drawings, and fixture installations. Perfect for aspiring plumbers and professionals seeking practical, interactive training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerselearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "8971239896257671"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED",
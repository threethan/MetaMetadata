23.png", "id": "1303013344273262", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394008_1303013347606595_2660461130878419161_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WklSgbI-Qs0Q7kNvwGmBywO&_nc_oc=AdlYGJ2b9_9N-PyuXej5gXTxA0j5Pjpxujg9we_dIZ3CQ4lKEt9j6fuwNUe6Jv2E-BQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzrsLygDiuxECFhpLJTmyMEGrjJuZSSy30MSiNaNk-_YA&oe=69BFEABF"}, {"file_name": "vlcsnap-2025-01-30-18h34m00s522.png", "id": "1133754631789005", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391894_1133754635122338_2108955058144306954_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J595LyJ7gUkQ7kNvwFI3ApJ&_nc_oc=AdmFM4yCe6KDvZ097D8Axet9Vmor4QHA8ClE0Q71LxnKNZZqdetTzVAO2Vb5lI-HfSQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxI3rdVe47Ev7d7FxllWE9SdxZF-RMG3tfPz5ueVzl8A&oe=69BFDB0B"}, {"file_name": "vlcsnap-2025-01-30-18h37m54s148.png", "id": "531961935879802", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393905_531961939213135_4155838995787176415_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYPCzocERjoQ7kNvwFvX5I-&_nc_oc=AdlgQS8JVLbGbvyVRczxzWfbfHTjYO6tjwRo40EU_cpoR84NXj4Z3LK06IfANRAM5Hc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfymBv6YjXSdKsRglwPhefi1EM1B4P-ENzOv2dR0cSwznA&oe=69C00050"}, {"file_name": "vlcsnap-2025-01-30-18h43m57s657.png", "id": "953476393091624", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473397186_953476396424957_3101880245997863484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYcdNyqbrAIQ7kNvwG9zY1d&_nc_oc=AdlUei1WAUyhN11RaOygWpSPqM9ZyiJ0N9yEQ7ZgVOc-63AaMGyqFopnpI3A08y_2ME&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwB6KeqjMtOq3KUOC-CsG_41Ws21D2UeLR9vLVEJt0e_w&oe=69BFE84D"}, {"file_name": "vlcsnap-2025-01-30-18h44m50s137.png", "id": "1823245791752961", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391865_1823245798419627_3331351789956567964_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aps0kwdnbzoQ7kNvwF0OFkf&_nc_oc=AdmNDdF0Bsp_1eEn38GPdiqy6VVc79HvkxaQap-8DjY9lD29y0rGX-wDHLp-XYCCIPQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxuk3shceiVF-N4TRzoPCNnhJPWv-qQJjRJfx8iFFXI9w&oe=69BFDEEC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified Plumbing Associate", "keywords": ["Plumbing", "Immerselearn", "Training"], "long_description": "Certified Plumbing Associate is a VR training simulation that offers comprehensive, hands-on practice for aspiring plumbers and professionals. Dive into interactive modules covering essential plumbing skills, including:\n\n- Proper use of fire extinguishers.\n- Techniques for using hand tools correctly.\n-Understanding Plumbing PPE (Personal Protective Equipment).\n- Inspection and maintenance of power tools.\n- Accurate measurement with plumbing tools and pipe length calculations.\n- Introduction to plumbing drawings, pipe fittings, and fixtures.\n\nThis engaging virtual environment provides realistic scenarios for skill-building, allowing users to master essential techniques safely and efficiently. Perfect for both beginners and seasoned professionals, Certified Plumbing Associate ensures you're equipped with practical knowledge to excel in the plumbing industry.\nTrain smarter, safer, and more effectively\u2014immerse yourself in the world of plumbing today!", "short_description": "Certified Plumbing Associate is an immersive VR training app designed to provide hands-on practice in plumbing techniques. Learn fire extinguisher use, proper hand tool techniques, PPE, and power tool maintenance. Gain skills in measuring tools, pipe lengths, plumbing drawings, and fixture installations. Perfect for aspiring plumbers and professionals seeking practical, interactive training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerselearn", "support_
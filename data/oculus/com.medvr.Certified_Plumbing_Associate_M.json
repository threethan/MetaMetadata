ap-2025-01-30-18h34m00s522.png", "id": "1133754631789005", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391894_1133754635122338_2108955058144306954_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9abunqW5UxIQ7kNvwHN8888&_nc_oc=Adqlj7RBdgavolBMOSkaK20sMRHXGLFgmLz5rWQek1s7f2QUMy-decBIOOj_ngvO7Hw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8G-nrCyaH908djwf1AREiesrldzE17z-vPPubB54DsA&oe=6A9FFA0B"}, {"file_name": "vlcsnap-2025-01-30-18h37m54s148.png", "id": "531961935879802", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393905_531961939213135_4155838995787176415_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dq6MVsNmbugQ7kNvwGM88XJ&_nc_oc=AdoJFQoClm0s6XDg4_v4oKh7U0V5fbPlRc7r3PQnDy0eKdV6K75AjuLTcQ0As4HbVww&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcMhnhVQU4hMM6Jj4b8v3Jq8Qot_Sg7DjKMTCnQkYBnQ&oe=6AA01F50"}, {"file_name": "vlcsnap-2025-01-30-18h43m57s657.png", "id": "953476393091624", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473397186_953476396424957_3101880245997863484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3idbHRd8BEQ7kNvwG9_kw7&_nc_oc=AdpeH60z9P2jf_HP7CSQXacgNSdc5JtliiPVJj72-6cAhaZAKCtl8U924GBeqluYrqg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWFfP_AD8--TRnP7A9P7cn5Kel2w5dQqZ__peoDZzi2A&oe=6AA0074D"}, {"file_name": "vlcsnap-2025-01-30-18h44m50s137.png", "id": "1823245791752961", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391865_1823245798419627_3331351789956567964_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9MdsRNK6-kQ7kNvwHgvLg6&_nc_oc=AdozWLcE4v8gBKM6MkEh-BBsOtLcLRs7GCHwiOwwOQQ9vq3vVahrIRWlmmbFdfd5kAg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiuj5NTQxr0tqxdIOsXXhchcEE46s2DwsoVgknI_S1yA&oe=6A9FFDEC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified Plumbing Associate", "keywords": ["Plumbing", "Immerselearn", "Training"], "long_description": "Certified Plumbing Associate is a VR training simulation that offers comprehensive, hands-on practice for aspiring plumbers and professionals. Dive into interactive modules covering essential plumbing skills, including:\n\n- Proper use of fire extinguishers.\n- Techniques for using hand tools correctly.\n-Understanding Plumbing PPE (Personal Protective Equipment).\n- Inspection and maintenance of power tools.\n- Accurate measurement with plumbing tools and pipe length calculations.\n- Introduction to plumbing drawings, pipe fittings, and fixtures.\n\nThis engaging virtual environment provides realistic scenarios for skill-building, allowing users to master essential techniques safely and efficiently. Perfect for both beginners and seasoned professionals, Certified Plumbing Associate ensures you're equipped with practical knowledge to excel in the plumbing industry.\nTrain smarter, safer, and more effectively\u2014immerse yourself in the world of plumbing today!", "short_description": "Certified Plumbing Associate is an immersive VR training app designed to provide hands-on practice in plumbing techniques. Learn fire extinguisher use, proper hand tool techniques, PPE, and power tool maintenance. Gain skills in measuring tools, pipe lengths, plumbing drawings, and fixture installations. Perfect for aspiring plumbers and professionals seeking practical, interactive training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerselearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "pla
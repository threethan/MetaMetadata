23.png", "id": "1303013344273262", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473394008_1303013347606595_2660461130878419161_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2pqImsVJcEQ7kNvwHLG1Ji&_nc_oc=AdmTH4-wcdZPL_rIbnJSxtNOueA6uJvKwyrcB4IHj0CziNEIBc_nXpUPt-bYO-n4Jc8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyrb_DAfzu4b7rAlZh0FTvo1T5OYbvPCjd5OtoDsZ-FVQ&oe=69BD47BF"}, {"file_name": "vlcsnap-2025-01-30-18h34m00s522.png", "id": "1133754631789005", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391894_1133754635122338_2108955058144306954_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J595LyJ7gUkQ7kNvwEBS_KI&_nc_oc=AdnImZvrDAM4KP5-GNkNDgZ5Y8EK5sbnlCQVdmo2NKy9_bInZ1UR49jrsZFtDbQKaaQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyeAuskawLRqxKqQwTwPdlYFLsqg_D89Yc6wt64NCxDzA&oe=69BD380B"}, {"file_name": "vlcsnap-2025-01-30-18h37m54s148.png", "id": "531961935879802", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393905_531961939213135_4155838995787176415_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbjj6Obo5t0Q7kNvwEWZK9V&_nc_oc=AdkRqFi6mBhHouoYnKc1_e66I965H7LlgdP9wMO_Ud8cuG5_xGw8VZf2Ot6Q1Qw-8_0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwJcbYeSUYDiA5nR7L-YNJTIpasLdLNcDRdF4vUykyIpA&oe=69BD5D50"}, {"file_name": "vlcsnap-2025-01-30-18h43m57s657.png", "id": "953476393091624", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473397186_953476396424957_3101880245997863484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_M0qUinuynsQ7kNvwH9jbyR&_nc_oc=AdklRGT0a1FzfCYMybM6GjTIgI2WTwS_cb3j0eAqB1U54u8nZC9y33OOUuNATHjtK-Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfydcIMKtIvIzL2Pk_J_o4Mpc6GPEXH5T-VeyaqsVUWSIw&oe=69BD454D"}, {"file_name": "vlcsnap-2025-01-30-18h44m50s137.png", "id": "1823245791752961", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391865_1823245798419627_3331351789956567964_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aps0kwdnbzoQ7kNvwFEm1jm&_nc_oc=Adm6dDD5DD7oLm0nTMoIv9HXWyx-qB0hMWDA8qPTrU3Gde9tJB9NRkiZJYczw3308rM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzB5Nk_U-4raXPayEOgax0x6w6nqGNfEnj4pUE66Dvlog&oe=69BD3BEC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified Plumbing Associate", "keywords": ["Plumbing", "Immerselearn", "Training"], "long_description": "Certified Plumbing Associate is a VR training simulation that offers comprehensive, hands-on practice for aspiring plumbers and professionals. Dive into interactive modules covering essential plumbing skills, including:\n\n- Proper use of fire extinguishers.\n- Techniques for using hand tools correctly.\n-Understanding Plumbing PPE (Personal Protective Equipment).\n- Inspection and maintenance of power tools.\n- Accurate measurement with plumbing tools and pipe length calculations.\n- Introduction to plumbing drawings, pipe fittings, and fixtures.\n\nThis engaging virtual environment provides realistic scenarios for skill-building, allowing users to master essential techniques safely and efficiently. Perfect for both beginners and seasoned professionals, Certified Plumbing Associate ensures you're equipped with practical knowledge to excel in the plumbing industry.\nTrain smarter, safer, and more effectively\u2014immerse yourself in the world of plumbing today!", "short_description": "Certified Plumbing Associate is an immersive VR training app designed to provide hands-on practice in plumbing techniques. Learn fire extinguisher use, proper hand tool techniques, PPE, and power tool maintenance. Gain skills in measuring tools, pipe lengths, plumbing drawings, and fixture installations. Perfect for aspiring plumbers and professionals seeking practical, interactive training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerselearn", "support_
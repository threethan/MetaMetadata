ap-2025-01-30-18h34m00s522.png", "id": "1133754631789005", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391894_1133754635122338_2108955058144306954_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9abunqW5UxIQ7kNvwGDk8if&_nc_oc=AdqwAshV9fJ0sWqFjVqr5fKCa-6hVorgEgF6HjmTYPQibXB31lktOU-SHq7yndgTJEU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-fPdck4Rm8IBzYwH5FbGOXmnqgIZ-_cejWfkyDSc-cg&oe=6AA14B8B"}, {"file_name": "vlcsnap-2025-01-30-18h37m54s148.png", "id": "531961935879802", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393905_531961939213135_4155838995787176415_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsLo1Dib03MQ7kNvwFAr4e1&_nc_oc=AdpXV5_2Y47FGI_HjsojwMVuhEPgj1YXVgZu5od9nDOWpr0AtQG6H3pFv9RhZ-xQ-cM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjw0D4S1JlEa9AXLcRh3VbwNHJW7RMslcQOEHOYeMUTg&oe=6AA170D0"}, {"file_name": "vlcsnap-2025-01-30-18h43m57s657.png", "id": "953476393091624", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473397186_953476396424957_3101880245997863484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RODQJzDHsXwQ7kNvwGPNWTd&_nc_oc=AdplwnLO5Uwd-pF37v9iD3SzbplSmtujHMMEWy7MdGh84KebZgo2u7y1iZ6Ug-5VJ-4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKP1IxSv395QJc7mrxKOkhLVqaoD4qpPoG3pGvlXLMjxA&oe=6AA158CD"}, {"file_name": "vlcsnap-2025-01-30-18h44m50s137.png", "id": "1823245791752961", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391865_1823245798419627_3331351789956567964_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9MdsRNK6-kQ7kNvwE8CEyt&_nc_oc=AdrLI1qv5bV5E_ZPYsbD2JWhB-HVeuHNrZ1XFDxZfgvNlCWqyGPt8JyXra4gdxfqFLU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAm06q0L5KBci9qXNG5tBftfO8K8vxvcUE4_iJ9ogwwg&oe=6AA14F6C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified Plumbing Associate", "keywords": ["Plumbing", "Immerselearn", "Training"], "long_description": "Certified Plumbing Associate is a VR training simulation that offers comprehensive, hands-on practice for aspiring plumbers and professionals. Dive into interactive modules covering essential plumbing skills, including:\n\n- Proper use of fire extinguishers.\n- Techniques for using hand tools correctly.\n-Understanding Plumbing PPE (Personal Protective Equipment).\n- Inspection and maintenance of power tools.\n- Accurate measurement with plumbing tools and pipe length calculations.\n- Introduction to plumbing drawings, pipe fittings, and fixtures.\n\nThis engaging virtual environment provides realistic scenarios for skill-building, allowing users to master essential techniques safely and efficiently. Perfect for both beginners and seasoned professionals, Certified Plumbing Associate ensures you're equipped with practical knowledge to excel in the plumbing industry.\nTrain smarter, safer, and more effectively\u2014immerse yourself in the world of plumbing today!", "short_description": "Certified Plumbing Associate is an immersive VR training app designed to provide hands-on practice in plumbing techniques. Learn fire extinguisher use, proper hand tool techniques, PPE, and power tool maintenance. Gain skills in measuring tools, pipe lengths, plumbing drawings, and fixture installations. Perfect for aspiring plumbers and professionals seeking practical, interactive training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerselearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "pla
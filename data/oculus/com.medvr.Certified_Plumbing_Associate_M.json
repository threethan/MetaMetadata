culuscdn.com&oh=00_Afv-UTxY_f01sAWjcljQqLWCcbmnRjxRlFhrpvA7zA1-Qw&oe=69A58CBF"}, {"file_name": "vlcsnap-2025-01-30-18h34m00s522.png", "id": "1133754631789005", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391894_1133754635122338_2108955058144306954_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpfj1r4Nfa0Q7kNvwFqumdv&_nc_oc=AdluwRv6bh2AAEKeVzaP4Nqd0td5yr5q0qe3JT0eKCKa2xOx2ZJ-Loq-Bs3W1uZaRz4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvzNyowg-IFr0shbPiA0ktQ22qPbcw9cwgsfDLlOyeWIw&oe=69A57D0B"}, {"file_name": "vlcsnap-2025-01-30-18h37m54s148.png", "id": "531961935879802", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393905_531961939213135_4155838995787176415_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myW_xzXwDoAQ7kNvwFDtHp6&_nc_oc=Adlfcm93nm6CsgIXfkijhaf4H2qo-ZKsIwgL79MBXzWsIerNLcYrpbITi5H0pDa_eZY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfunYl4h8lqaEhTEhTzjyq9fdEsd9E137A_drzdESkE54Q&oe=69A56A10"}, {"file_name": "vlcsnap-2025-01-30-18h43m57s657.png", "id": "953476393091624", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473397186_953476396424957_3101880245997863484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vh71cUBNAM8Q7kNvwGhWg3a&_nc_oc=Adl3UO6vmRnEOl4lzTt3XkwUiPK4wWiAvIjdVOvWJ30eA4Wd75_-KXEMKq_ipYhu4Uo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvZ_VP-ZIRBxG92GpR7mpbRye_e5l_HU2S_S-cZvzPgbg&oe=69A58A4D"}, {"file_name": "vlcsnap-2025-01-30-18h44m50s137.png", "id": "1823245791752961", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391865_1823245798419627_3331351789956567964_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYQMwYs5KN4Q7kNvwG_vvQ6&_nc_oc=Adk28Yir7CNsItF6CCfye57_zoX68mMfl02_ufrLgu_OrAd4wY-YLdhm_IrNPsPV9bA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvpwrpSpdAn7NibXfBqFRIJAmPXTox80AgR3Y9VHFNtig&oe=69A580EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified Plumbing Associate", "keywords": ["Plumbing", "Immerselearn", "Training"], "long_description": "Certified Plumbing Associate is a VR training simulation that offers comprehensive, hands-on practice for aspiring plumbers and professionals. Dive into interactive modules covering essential plumbing skills, including:\n\n- Proper use of fire extinguishers.\n- Techniques for using hand tools correctly.\n-Understanding Plumbing PPE (Personal Protective Equipment).\n- Inspection and maintenance of power tools.\n- Accurate measurement with plumbing tools and pipe length calculations.\n- Introduction to plumbing drawings, pipe fittings, and fixtures.\n\nThis engaging virtual environment provides realistic scenarios for skill-building, allowing users to master essential techniques safely and efficiently. Perfect for both beginners and seasoned professionals, Certified Plumbing Associate ensures you're equipped with practical knowledge to excel in the plumbing industry.\nTrain smarter, safer, and more effectively\u2014immerse yourself in the world of plumbing today!", "short_description": "Certified Plumbing Associate is an immersive VR training app designed to provide hands-on practice in plumbing techniques. Learn fire extinguisher use, proper hand tool techniques, PPE, and power tool maintenance. Gain skills in measuring tools, pipe lengths, plumbing drawings, and fixture installations. Perfect for aspiring plumbers and professionals seeking practical, interactive training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerselearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ad
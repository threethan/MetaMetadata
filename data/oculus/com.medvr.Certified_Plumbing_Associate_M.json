ap-2025-01-30-18h34m00s522.png", "id": "1133754631789005", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391894_1133754635122338_2108955058144306954_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVjl1vk7nAcQ7kNvwGX3Q6x&_nc_oc=Adp14F-dhhYuqx3Ww76hkm7tDqsN5oPazCyXz0BPQHNZXBb11s7wfwelQHBSrf_zN4I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIR_V2YdV9bX1_BrY88emeRfNdfp4Ya6ZXCKVmTN0LKg&oe=6AB3F8CB"}, {"file_name": "vlcsnap-2025-01-30-18h37m54s148.png", "id": "531961935879802", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393905_531961939213135_4155838995787176415_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTXoy3wr8eMQ7kNvwE_eeqd&_nc_oc=Adog2Oyi8uKy3edBVsBdfQc6JPzVFyIojLO0BYYBqUzFVVgv3rlQDiA-cznFtCcE7PY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVhSNDOJQshqobKQmdSAL0K9fTiScHuTdCfxXYXl6UfA&oe=6AB3E5D0"}, {"file_name": "vlcsnap-2025-01-30-18h43m57s657.png", "id": "953476393091624", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473397186_953476396424957_3101880245997863484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_vd4b9Koz8Q7kNvwESDxWy&_nc_oc=AdrGM0WHZ9p06orrXpPNlM28p00kOqNIOgb6jtSkC4K-6ANmFRfW6fXtehOc-T0nN_g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcSK8tLoOOh7O47bNF_p5sFcofr-KTarcTTF7kleTCcA&oe=6AB3CDCD"}, {"file_name": "vlcsnap-2025-01-30-18h44m50s137.png", "id": "1823245791752961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391865_1823245798419627_3331351789956567964_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTat0PQuHUIQ7kNvwF2Wqlk&_nc_oc=AdrQGZtQ5JDxdLmvuNrSpxHwb2Wym9-dvpgeFQu_XGZp3jt-lKWu9ZSlQi3Mq-6bHpM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLnvFFeqUhtviUO3wAqfFBmfmYYnnFQraV-uutQgOJiw&oe=6AB3C46C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified Plumbing Associate", "keywords": ["Plumbing", "Immerselearn", "Training"], "long_description": "Certified Plumbing Associate is a VR training simulation that offers comprehensive, hands-on practice for aspiring plumbers and professionals. Dive into interactive modules covering essential plumbing skills, including:\n\n- Proper use of fire extinguishers.\n- Techniques for using hand tools correctly.\n-Understanding Plumbing PPE (Personal Protective Equipment).\n- Inspection and maintenance of power tools.\n- Accurate measurement with plumbing tools and pipe length calculations.\n- Introduction to plumbing drawings, pipe fittings, and fixtures.\n\nThis engaging virtual environment provides realistic scenarios for skill-building, allowing users to master essential techniques safely and efficiently. Perfect for both beginners and seasoned professionals, Certified Plumbing Associate ensures you're equipped with practical knowledge to excel in the plumbing industry.\nTrain smarter, safer, and more effectively\u2014immerse yourself in the world of plumbing today!", "short_description": "Certified Plumbing Associate is an immersive VR training app designed to provide hands-on practice in plumbing techniques. Learn fire extinguisher use, proper hand tool techniques, PPE, and power tool maintenance. Gain skills in measuring tools, pipe lengths, plumbing drawings, and fixture installations. Perfect for aspiring plumbers and professionals seeking practical, interactive training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerselearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "pla
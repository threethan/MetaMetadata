scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572940_830763345799411_4192181376620077197_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dm3m2GH0Vy0Q7kNvwG6DAlq&_nc_oc=Adkyjit28af7tY2BDAj7lJex1rDIUudJTHFGN8DGT6Et35pKSYoeD5DJGz3_5gTizLY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft0pxqvBV39vr2zHzBniIj1DKcaXRsX_G0BGBmQjDOvWw&oe=699869BB"}, {"file_name": "zerog5e.png", "id": "1048405573450539", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001714_1048405576783872_3723899864187407035_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REGQ22NkTKQQ7kNvwEdkhfW&_nc_oc=AdnSVlM7m7d_I3Bd7WaES9qrnn1JomttWGAQ9FNvyin33J-RNiTGZHQagRrMjPhP60w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuVOtvS9y0nYTe6sPmCYSUppweFT65FAB22ZGKQWwIpnw&oe=69984BFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vIDEOcOVETR.png", "id": "8964806610218356", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974646_8964806620218355_1338032258312468621_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqHwPs-QTTkQ7kNvwEVAVMU&_nc_oc=AdlQAGDyaebnRpYk7IZo2AzfIQIcJAOtOBOpoNGxA1Vsy8mf4QaCRQfnpUxTG25m8Ww&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afuzt1IZSk7Qb7jiYXXMyjZfjP-WxqC0cFiLDhUspGQ53w&oe=69985AEA"}, "display_name": "Banana Company", "keywords": [], "long_description": "Banana.Co is a fun and engaging virtual reality game where players embody bananas in a whimsical world. Inspired by Gorilla Tag mechanics, it offers a lighthearted adventure perfect for those aged 13 and up. We welcome everyone as long as they practice safe gaming.\n\nCommunity Guidelines: Our inclusive community prioritizes enjoyment and respect. A dedicated moderation team ensures a safe and friendly environment.\n\nGameplay Features: Explore imaginative maps, customize your banana with various cosmetics, and engage in creative activities. Players can forge friendships and enjoy lively interactions.\n\nJoin us in Banana.Co for a unique experience that celebrates fun, creativity, and camaraderie in a world of laughter!\n[Yellow44 is watching]", "short_description": "This is a very fun VR game using the gorilla tag loco motion system but you're a banana! So if you want to play a fun funny game where you can bring in your inner banana then play Banana.Co."}]}, "developer_name": "ZaneyGames", "developer_privacy_policy_url": "https://sites.google.com/view/bannacompanyoffical?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zane2Evil", "support_website_url": null, "website_url": "https://66d7a5532d916.site123.me/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27418109511136613"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "516671757811467"}]}, "baseline_offer": {"id": "516671757811467"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1729114140, "status": "PUBLISHED", "id": "516671757811467"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27611910215089874", "version": "0.36"}, "id": "535216355942957", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27395736353373929", "is_concept": false, "latest_released_binar
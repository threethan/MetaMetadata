scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572940_830763345799411_4192181376620077197_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqX0uQqCYvcQ7kNvwEJNZdd&_nc_oc=AdmX8bdfu6lG0jKPVUfvtaUMGUxFqll_1Voa6Bi2v5vNU1kIeVbPimsxaXzADE7H_Nc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft6fl1HhXsAGoFxkW6DJ5JrknvXGxMZuXKzo_9MQDX_Fg&oe=699F013B"}, {"file_name": "zerog5e.png", "id": "1048405573450539", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001714_1048405576783872_3723899864187407035_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvfciM4X-wgQ7kNvwHbaaL5&_nc_oc=AdkQvaUgaSy3sUGy-5k2qCGE2USjNEiI48rYGxH_hI-ngdFiCKW5JZCaFB7Kj1Yh_9I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv5TVM00XaZAVtK_zMV2_ypDia9ONiA2nZ5KpQXogM2hQ&oe=699EE37B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vIDEOcOVETR.png", "id": "8964806610218356", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974646_8964806620218355_1338032258312468621_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmH3GxZnR1YQ7kNvwEs-EBp&_nc_oc=AdlN8NPAzP_JUabcWSk8bWTAuZSdON4NBaDy64gFMms3elvFLxrTJgfp1uxCkiBI5xo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afuv1ZqRG0NRyaxM4P0pr9Zmb4u2uYC7K6Fi7HjDFKzbbg&oe=699EF26A"}, "display_name": "Banana Company", "keywords": [], "long_description": "Banana.Co is a fun and engaging virtual reality game where players embody bananas in a whimsical world. Inspired by Gorilla Tag mechanics, it offers a lighthearted adventure perfect for those aged 13 and up. We welcome everyone as long as they practice safe gaming.\n\nCommunity Guidelines: Our inclusive community prioritizes enjoyment and respect. A dedicated moderation team ensures a safe and friendly environment.\n\nGameplay Features: Explore imaginative maps, customize your banana with various cosmetics, and engage in creative activities. Players can forge friendships and enjoy lively interactions.\n\nJoin us in Banana.Co for a unique experience that celebrates fun, creativity, and camaraderie in a world of laughter!\n[Yellow44 is watching]", "short_description": "This is a very fun VR game using the gorilla tag loco motion system but you're a banana! So if you want to play a fun funny game where you can bring in your inner banana then play Banana.Co."}]}, "developer_name": "ZaneyGames", "developer_privacy_policy_url": "https://sites.google.com/view/bannacompanyoffical?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zane2Evil", "support_website_url": null, "website_url": "https://66d7a5532d916.site123.me/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27418109511136613"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "516671757811467"}]}, "baseline_offer": {"id": "516671757811467"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1729114140, "status": "PUBLISHED", "id": "516671757811467"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27611910215089874", "version": "0.36"}, "id": "535216355942957", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27395736353373929", "is_concept": false, "latest_released_binar
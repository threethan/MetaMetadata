": "8964806610218356", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974646_8964806620218355_1338032258312468621_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43kjAP4yJk0Q7kNvwFcqW1S&_nc_oc=AdrNpKYWuQbE23UtGW__sZ5YI3i42XoGnqR97OJ2mgndGUH7TjP5hbyR4TM3-XOeDJE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjy6cQDi8KTC38QYEyhs0cBvaSw4iNBhZc7QMnRLVbhA&oe=6AFB36AA"}, "display_name": "Banana Company", "keywords": [], "long_description": "Banana.Co is a fun and engaging virtual reality game where players embody bananas in a whimsical world. Inspired by Gorilla Tag mechanics, it offers a lighthearted adventure perfect for those aged 13 and up. We welcome everyone as long as they practice safe gaming.\n\nCommunity Guidelines: Our inclusive community prioritizes enjoyment and respect. A dedicated moderation team ensures a safe and friendly environment.\n\nGameplay Features: Explore imaginative maps, customize your banana with various cosmetics, and engage in creative activities. Players can forge friendships and enjoy lively interactions.\n\nJoin us in Banana.Co for a unique experience that celebrates fun, creativity, and camaraderie in a world of laughter!\n[Yellow44 is watching]", "short_description": "This is a very fun VR game using the gorilla tag loco motion system but you're a banana! So if you want to play a fun funny game where you can bring in your inner banana then play Banana.Co."}]}, "developer_name": "ZaneyGames", "developer_privacy_policy_url": "https://sites.google.com/view/bannacompanyoffical?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zane2Evil", "support_website_url": null, "website_url": "https://66d7a5532d916.site123.me/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUI
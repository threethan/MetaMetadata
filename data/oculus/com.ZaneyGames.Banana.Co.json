c_sid=6e7a0a&_nc_ohc=5bhae6OeejkQ7kNvwEwPx5U&_nc_oc=Adoez2kuF8Qziw2-QMZjObsX7SpK16mcVh2J6n-K_-vh_lHLs4FbDq8nuQw1PAurZsM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXTWHSPfGVvL7DUYG9xT_tB2dmPheXMx3Vk7gkudB7f4Q&oe=6B103FBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vIDEOcOVETR.png", "id": "8964806610218356", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974646_8964806620218355_1338032258312468621_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klTySZcSfSoQ7kNvwF2_rVE&_nc_oc=AdqK77GEmdDcgmlBBTDiItnRXLNkx6Q0ZOIUuHvzT6ov9H5DPt9hTqg3_J0K0BnJxYE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXkTgqhVc96jUVSTrUeXo4mNTZuqyjxYxWfdSNgE_YKHA&oe=6B104EAA"}, "display_name": "Banana Company", "keywords": [], "long_description": "Banana.Co is a fun and engaging virtual reality game where players embody bananas in a whimsical world. Inspired by Gorilla Tag mechanics, it offers a lighthearted adventure perfect for those aged 13 and up. We welcome everyone as long as they practice safe gaming.\n\nCommunity Guidelines: Our inclusive community prioritizes enjoyment and respect. A dedicated moderation team ensures a safe and friendly environment.\n\nGameplay Features: Explore imaginative maps, customize your banana with various cosmetics, and engage in creative activities. Players can forge friendships and enjoy lively interactions.\n\nJoin us in Banana.Co for a unique experience that celebrates fun, creativity, and camaraderie in a world of laughter!\n[Yellow44 is watching]", "short_description": "This is a very fun VR game using the gorilla tag loco motion system but you're a banana! So if you want to play a fun funny game where you can bring in your inner banana then play Banana.Co."}]}, "developer_name": "ZaneyGames", "developer_privacy_policy_url": "https://sites.google.com/view/bannacompanyoffical?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zan
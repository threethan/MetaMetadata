om/v/t64.5771-25/39003280_258731866207499_4157969065618168007_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcbLxHLJRsAQ7kNvwHgx1x3&_nc_oc=Adqf0QfK-sKPUQNU3Fk2yNfFJbUD68dhOJnfLS-1mPG3oLNXLpqnq04JnER7dWbmnJU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdbsFkiefoNwP4fD1OhyBEu32PxH4ODa1fOJJFdWkMsA&oe=6ABA5E79"}, {"file_name": "Screenshot02.png", "id": "158316396454336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001671_158316399787669_617991505424861133_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5k2bqVYJXoQ7kNvwFfPz4p&_nc_oc=AdqYOgcQsy3UlyOw5Xn7zQVxPgy6Wm5XlOBSCF3yWbXrJZpU24wOae2rtvzH542pB8s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqAuavtPAHOwGyYV3yBf_-NVK6exAXlnhX4udJpQfmKw&oe=6ABA8AFE"}, {"file_name": "Screenshot03.png", "id": "587372536021968", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569446_587372539355301_8038260481219331058_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbGTcQFQJAsQ7kNvwGyqbG3&_nc_oc=Adppbeb3IkDQbDxvwt4sqaFeayuBqcVnWrudac0kDr6_D0NBoWitvpHjh3jfZzs8Dw0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFZFS3rN8X1ATjxA5VnQnPKOuAMYRAtnVGO3lA79Mj8Q&oe=6ABA5C10"}, {"file_name": "Screenshot04.png", "id": "1418671108530916", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001703_1418671111864249_593447480392490612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x05Zg1PejlEQ7kNvwG0lN1i&_nc_oc=Adpdj37SSMMi6kdLaUXPAxeRF-dwqGyL9RJrEC9oWyh0Joqzyc1WE7Yvz_7NFog43FE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqbbrUrhJ4qTjikTG3r9d-a52O5Gp82ko9x80puzekMg&oe=6ABA73FA"}, {"file_name": "Screenshot06.png", "id": "383047896930649", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035322_383047900263982_3743273071828181411_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fs1kNUTuQhEQ7kNvwGLZv8t&_nc_oc=AdovsJR7M0NbiQODlfg9dhbiJ4moqVg7tVKlD8eoA8PUG2hQWnRA0fqq0QkjgvUWlt0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLB82HntDdAV4vQo37QmwJIolI4QdOnErDHGHAp1gB8og&oe=6ABA853D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Crane Simulator", "keywords": [], "long_description": "The Tower Crane places you high above the construction site, where you are tasked with lifting objects to assist in the construction of the building with various lifting objectives that require different techniques and simultaneously train you in how to operate the crane properly and avoid risks. \nThe Overhead Crane located in a warehouse challenges you to complete obstacle courses in a timely manner with difficulties scaling for each Obstacle Course. These fun challenges will teach you above the operating of such a crane and how to carefully avoid bumping into obstacles while moving through the course. \n\n\nKey Features:\n\n- Realistic Overhead and Tower Crane simulations & controls\n- Includes Tutorials on how to operate both cranes\n- Physics based simulation in every situation, allowing you to knock over stuff and learn from \n  your mistakes without danger.\n- Challenging Obstacle courses for both cranes challenging you to complete courses in a short amount of time!", "short_description": "This VR Application includes a Tower Crane Simulator and an Overhead Crane Simulator, challenging you in mastering the both very different cranes. These crane simulators will give you insight into how they are operated and some of the challenges of handling machines such as these. \n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://visual-eng.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Visual Engineering", "support_website_url": null, "website_url": "https://visual-eng.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type
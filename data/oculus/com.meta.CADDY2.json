bUK2A3EBvpIhyA&oe=6B085545"}, "display_name": "CADDY", "keywords": [], "long_description": "3D CAD Visualization tool utilizing hand tracking, gestures and poses\n\n- View exploded views, cross section views, and scale parts and assemblies\n- Build your own sub-assemblies on the build table\n- Write, draw anything in full freeform 3D.\n- Measure both IRL objects and virtual assets\n- Team up with other players to collaborate on the same assembly in network \"distributed\" or local \"co-located\" states\n", "short_description": "3D CAD Visualization tool utilizing hand tracking\n- Visualize and interact with hardware models in Mixed Reality!\n- Write, draw and measure anything in full free form 3D\n- Build your own assemblies!\n- Collaborate with other players over network or in a co-located space\nEnjoy the immersive experience!"}]}, "developer_name": "Raghavan Vasudevan, Jason Putnam", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/?utm_source=www.oculus.com&utm_medium=oculusredirect", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": null, "website_url": "https://www.heycaddy.net/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24587605277550254"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57574716_32113375736
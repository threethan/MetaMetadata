-landscape_2560x1440.png", "id": "1294290815303848", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610708_1294290818637181_5893564362229760204_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vM8totX7TxkQ7kNvwHdrVNL&_nc_oc=AdmH_oEFrexfefZBOPEOD_fIETZVDtK6KLaygr7oUgJNT5nazDaQqUDs2YOVgsfdPIM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwF2xxIafj6eL3wkhpCZFM5dkWZiQUEEE3XTkSKGDB_aQ&oe=69B024F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CADDY", "keywords": [], "long_description": "3D CAD Visualization tool utilizing hand tracking, gestures and poses\n\nBring in your own models in OBJ format and explore using hand tracking\nView exploded views, cross section views, and scale parts and assemblies\nBuild your own sub-assemblies on the build table\nJoin with other players to collaborate on the same assembly in network distributed and local co-located states\nWrite, draw anything in full freeform 3D.\nMeasure both IRL objects and virtual assets\n", "short_description": "3D CAD Visualization tool utilizing hand tracking. Collaborate over network and locally. Write, draw and measure anything in full free form 3D!"}]}, "developer_name": "Raghavan Vasudevan, Jason Putnam", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/?utm_source=www.oculus.com&utm_medium=oculusredirect", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": null, "website_url": "http://www.okcaddy.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
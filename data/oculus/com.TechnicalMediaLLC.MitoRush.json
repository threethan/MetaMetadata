hero-3000x900.png", "id": "1813060296805904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499628882_1813060303472570_2726408037377302320_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbJtz32r6m0Q7kNvwFQXk3b&_nc_oc=AdrfLvgZ9DQmGj27vzUmzirF7yXoB8NxgY56uk8NboCV21xz7ZIkooMAI488dLPt5qI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0zZtHH2F-sClVqEBLFPETTDkj62-nrV3UYx3CHNJWEg&oe=6AFB4B87"}]}, "id": "1248074460641763", "locale": "en_US", "screenshots": [{"file_name": "com.TechnicalMediaLLC.MitoRush-20260926-053721.png", "id": "3378235279015695", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499624656_3378235282349028_5443183823316175979_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZcPreYlviMQ7kNvwGrC0sx&_nc_oc=AdrQRks5Igw1Ek2dcOFRcwqks2zyOn42g5poLhR3iDrS4xEIes2EGhNhy2Q81qp-Ys8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9XgQ4yrs0CYlBlQpw7mvs-kwkLgY896OAfouyLfP-sQ&oe=6AFB32BA"}, {"file_name": "com.TechnicalMediaLLC.MitoRush-20260926-054018.png", "id": "1626235092362385", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499627502_1626235102362384_6821503916689686582_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SpFF7G9lWUQ7kNvwG7M5s7&_nc_oc=AdpHpd8oJjCXU4gN0rAZdqh9llKUd7NebDppLEXp097zyvSJ9V5nJw_QWzZ4c6rTNhk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTse46Yl6VbV5TlyMT1Qp1dLj1Po4AOg6LrUMwGXS2J2w&oe=6AFB3A6D"}, {"file_name": "com.TechnicalMediaLLC.MitoRush-20260926-053848.png", "id": "1619253179863395", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619374_1619253183196728_8968988806605962146_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DV-jHmGD4qkQ7kNvwFYH20B&_nc_oc=Adpa9x-WREvAxEBSp36MTQJ2hC8x5V6AP5mHY7qknFjQhrHKPv3tB3DDvdMtCff0BaA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDHwP87R8NeL3CN5IpS5TFELaJ0yagrlem0jl7iA6qXg&oe=6AFB31DE"}, {"file_name": "com.TechnicalMediaLLC.MitoRush-20260926-045121.png", "id": "1603621587837418", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499624606_1603621591170751_6462140605694135058_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxoJ8lpfI9wQ7kNvwGIWtH-&_nc_oc=AdrDN96fYwImIcp5CcycBoXcn2CkVEt-VtEtX-E4cw_Qu_3UTSWl65SWmdzzEIEF6mo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFunY_5Zq3nY9d13cTF9q5ueOpl6XDOS2FptqAqmUOVw&oe=6AFB3B3F"}, {"file_name": "com.TechnicalMediaLLC.MitoRush-20260926-053630.png", "id": "1327517526083046", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499628882_1327517529416379_6882822583030067814_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEOmK3THzvsQ7kNvwF0ezYm&_nc_oc=AdoetWODflZc4sHZfmH_7RaF4zTH0avWw0Cr5_KcIbct5-pkqrGcJ_Rml_tKcPNyFpY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSl9b51SDsu34xEQVQtr1JhtSIjU9nQlLczEnWwpLlxQ&oe=6AFB3AFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-2560x1440.png", "id": "1481305757379362", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499628875_1481305760712695_2995580032871028984_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVdzI7jwWJQQ7kNvwGXIrQc&_nc_oc=Ado4UX53jYmznJdj7YMmG8SHq0KpRSYlWMDz8jaJ7YTArQLL3njyX0iGCfgtuGrNebs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxhyocDZdLWixyQVCeED1g--VRuIkxcXnlcbsQMW_Xog&oe=6AFB18AD"}, "display_name": "MitoRush", "keywords": ["fitness", "rhythm", "boxing", "workout", "cardio"], "long_description": "**Move to the beat. Bring your people.**\n\nMitoRush\u2122 turns music into a workout. Crystals fly at you on the beat; you hit them with your hands, dodge, duck, and \u2014 when you choose \u2014 kick and sprint. Two ways to play:\n\n- **Flow** \u2014 full-body movement to the music.\n- **Boxing** \u2014 punches and stances; tracks can call a stance change mid-song.\n\n**Your body, your settings.** Four difficulties. A five-step *Targets* ladder from hands-only to everything. Seated play. A calibration that places targets for your height and reach. Pair a Bluetooth heart-rate monitor and your effort shows on the results screen \u2014 never on a leaderboard.\n\n**Studio: live classes with voice.** Create a studio for your gym, family, or friends. A host starts a class, everyone plays the same beats at the same time, and you can talk while you sweat. Drop into a class with a six-character code. Studio members can author beatmaps in the web Choreographer and publish them for everyone.\n\n**Keep score.** Personal records, league boards ranked by minutes and points, and a recap after every session.\n\nMitoRush\u2122 is available as a **Solo** subscription (all solo play and the full library) or **Studio** (everything in Solo plus live classes and authoring). Billed through Meta; cancel any time from your Meta subscriptions.\n\nNot a medical device. Consult a professional before starting any exercise program.", "short_description": "MitoRush\u2122 is rhythm fitness in VR. Hit crystals to the beat \u2014 Flow for full-body movement, Boxing for punches and stances \u2014 at four difficulties, standing or seated, with a targets ladder from hands-only up to kicks and lightning steps. Play solo through a growing track library, or join live Studio classes: a host starts, everyone plays the same beats together, voice included. Pair a Bluetooth heart-rate monitor to see your effort. Solo and Studio subscriptions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mitorush.net/legal/privacy", "developer_terms_of_service_url": "https://mitorush.net/legal/terms", "publisher_name": "Technical Media LLC", "support_website_url": "https://mitorush.net/legal/data-deletion", "website_url": "https://mitorush.net/", "category": null, "comfort_rating": "COMFORTABLE_FO
hero-3000x900.png", "id": "1813060296805904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628882_1813060303472570_2726408037377302320_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fANPN-eK2BUQ7kNvwFECaCB&_nc_oc=AdqTi0EZHHV3D8awgOTEhno5Mp-XwIQaRvNeMHRqjy5zhy1xrYJukCtwAaQ65t9UBFg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQd-qKOZRXyXr6lQzKsjAAVrGFwkhcwS4-O406wY3HICQ&oe=6AFC64C7"}]}, "id": "1248074460641763", "locale": "en_US", "screenshots": [{"file_name": "com.TechnicalMediaLLC.MitoRush-20260926-053721.png", "id": "3378235279015695", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499624656_3378235282349028_5443183823316175979_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0cM2ecc_jkQ7kNvwH3vh2g&_nc_oc=Adp-lBu898zBITjW5HytilcG9_504hB-CBZhP90vAXz0yHTqSAO-7jiSWgU_KoiOyxE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpQ5OO_0kWBs1Cy-WqgY_-AnmQV1rInaHv7yYb_BK8iA&oe=6AFC843A"}, {"file_name": "com.TechnicalMediaLLC.MitoRush-20260926-054018.png", "id": "1626235092362385", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499627502_1626235102362384_6821503916689686582_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SpFF7G9lWUQ7kNvwHW2tIS&_nc_oc=Adq3EPqG2Y5gU75GgNg5pnxk0JrIeQfmYQBjUFwlwNM2ntynhQwM1Dc8a07Txja2A2Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQk_mrhoLWk8gJWt6SZRQV5Qe7WxEVVwwqo8tw7vQuuvQ&oe=6AFC8BED"}, {"file_name": "com.TechnicalMediaLLC.MitoRush-20260926-053848.png", "id": "1619253179863395", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619374_1619253183196728_8968988806605962146_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DV-jHmGD4qkQ7kNvwFlL-rr&_nc_oc=AdqtUbdCiq0iqJ6jqPjWGO9bRPua4s3cRPS_0fJvecO_dlTAnxTQ4qp2zhA-25x8LUw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzoTiGPexNxJI7-05o2mbFAz1QHbsBJfFA6oYNuRf6Pg&oe=6AFC835E"}, {"file_name": "com.TechnicalMediaLLC.MitoRush-20260926-045121.png", "id": "1603621587837418", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499624606_1603621591170751_6462140605694135058_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxoJ8lpfI9wQ7kNvwG9YpFk&_nc_oc=Adq8YbXnyew-F82Dz81qcSytJ--1eeK61X6gHhwKz541R4csbORVOOpCFpeUoRBS2yI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMqQ1FH-LEH4lrQ2UBgaLExylLGMvDzUN2GL2y-lHnlg&oe=6AFC8CBF"}, {"file_name": "com.TechnicalMediaLLC.MitoRush-20260926-053630.png", "id": "1327517526083046", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628882_1327517529416379_6882822583030067814_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEOmK3THzvsQ7kNvwE2dCoj&_nc_oc=Adrhbk-i6hnyso7slGEUkrpIDc6Vg-sVZiMC_2urStOBXuGhaaf2-7c_gZd9ACb7ID0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKNZ1MdGIpvaQOcwe5tg4MP_YEMeq3QwV0Pfr2J-_sLw&oe=6AFC8C7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-2560x1440.png", "id": "1481305757379362", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628875_1481305760712695_2995580032871028984_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCNthMC5tlAQ7kNvwHrZ6iV&_nc_oc=AdrUCWnJ3sspU4QjwKvrKYq-VYawigPRAZfyZv3bIJs46mzVggl5VynVJfrzawWg1xo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNEFMnPs7pgwbpf7bBuVl6cdad84DuI5j_BZLVrSUcmA&oe=6AFC6A2D"}, "display_name": "MitoRush", "keywords": ["fitness", "rhythm", "boxing", "workout", "cardio"], "long_description": "**Move to the beat. Bring your people.**\n\nMitoRush\u2122 turns music into a workout. Crystals fly at you on the beat; you hit them with your hands, dodge, duck, and \u2014 when you choose \u2014 kick and sprint. Two ways to play:\n\n- **Flow** \u2014 full-body movement to the music.\n- **Boxing** \u2014 punches and stances; tracks can call a stance change mid-song.\n\n**Your body, your settings.** Four difficulties. A five-step *Targets* ladder from hands-only to everything. Seated play. A calibration that places targets for your height and reach. Pair a Bluetooth heart-rate monitor and your effort shows on the results screen \u2014 never on a leaderboard.\n\n**Studio: live classes with voice.** Create a studio for your gym, family, or friends. A host starts a class, everyone plays the same beats at the same time, and you can talk while you sweat. Drop into a class with a six-character code. Studio members can author beatmaps in the web Choreographer and publish them for everyone.\n\n**Keep score.** Personal records, league boards ranked by minutes and points, and a recap after every session.\n\nMitoRush\u2122 is available as a **Solo** subscription (all solo play and the full library) or **Studio** (everything in Solo plus live classes and authoring). Billed through Meta; cancel any time from your Meta subscriptions.\n\nNot a medical device. Consult a professional before starting any exercise program.", "short_description": "MitoRush\u2122 is rhythm fitness in VR. Hit crystals to the beat \u2014 Flow for full-body movement, Boxing for punches and stances \u2014 at four difficulties, standing or seated, with a targets ladder from hands-only up to kicks and lightning steps. Play solo through a growing track library, or join live Studio classes: a host starts, everyone plays the same beats together, voice included. Pair a Bluetooth heart-rate monitor to see your effort. Solo and Studio subscriptions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mitorush.net/legal/privacy", "developer_terms_of_service_url": "https://mitorush.net/legal/terms", "publisher_name": "Technical Media LLC", "support_website_url": "https://mitorush.net/legal/data-deletion", "website_url": "https://mitorush.net/", "category": null, "comfort_rating": "COMFORTABLE_FO
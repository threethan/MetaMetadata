hero-3000x900.png", "id": "1813060296805904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628882_1813060303472570_2726408037377302320_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7_Aplxp2LAQ7kNvwF12Jry&_nc_oc=Adqh8oBEhQoeJvShQJN9AaNpxF_vUF1VO8g3FE9xWQauVPaS7Ak-BSMepLDejygP4so&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeo_vpvpzX3AHEoa5r0osPb783xq6clRyXS9UEeDmxhQ&oe=6B005947"}]}, "id": "1248074460641763", "locale": "en_US", "screenshots": [{"file_name": "com.TechnicalMediaLLC.MitoRush-20260926-053721.png", "id": "3378235279015695", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624656_3378235282349028_5443183823316175979_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmkMowPsgawQ7kNvwFk4N76&_nc_oc=AdqO__hvuMj0NzMNzKGcdyAp6VuUoRU8cYMKrG7l6NQwC1SuCyDZWwucWaEZB_8wZng&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtMPFuijuyWq-0MntQ7q2ZhNb25wtUottS4-DmmKDxmA&oe=6B0078BA"}, {"file_name": "com.TechnicalMediaLLC.MitoRush-20260926-054018.png", "id": "1626235092362385", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499627502_1626235102362384_6821503916689686582_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qc9HmpOF3I0Q7kNvwHSWg8I&_nc_oc=AdqohA0rUPTpnMktjX4_Mf_xT_q1q4UfKquxEB-Q1dvzM7INY9Y3337n_DIIoUU0WKQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU4i1WqjUv8KcV2JMPlTr6uPo6xQYanLqrFgrMvObDBA&oe=6B00806D"}, {"file_name": "com.TechnicalMediaLLC.MitoRush-20260926-053848.png", "id": "1619253179863395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619374_1619253183196728_8968988806605962146_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pewoBRAk0ckQ7kNvwEn4wCt&_nc_oc=AdpROvlIUlpXTNXX0J6sWERcKa_UZNaD3slZY-v0nSndTLhRi4jejxwsxsjWwXyli7w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCvvKdaS5tmLYUjqcqKu6wNGtUBD6jDGeLvqGVqGBEMA&oe=6B0077DE"}, {"file_name": "com.TechnicalMediaLLC.MitoRush-20260926-045121.png", "id": "1603621587837418", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624606_1603621591170751_6462140605694135058_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipXGihtHeFAQ7kNvwFqZlhB&_nc_oc=Adpfg-4fgu8XZiHGbxAzzOfLIt-YrCQWymUEic3K5pgJVqNPeIyOkbWxul_bOoOJDMM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYxY2lp2NWm7LCG_nJ-ZutgQmzG5UcOQ5jQMFv6_20iw&oe=6B00813F"}, {"file_name": "com.TechnicalMediaLLC.MitoRush-20260926-053630.png", "id": "1327517526083046", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628882_1327517529416379_6882822583030067814_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bdZh09dPtAQ7kNvwEgPwAP&_nc_oc=AdpMX9M1QW8kVNYt8PTGbuwfiCj8I-tDsPzNsifeke9UXL0r-GdxyfsLU_RRCjvGQFQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1MgegjQ6HTbVd6rJW7k6XBSg5aqFMnpVkfH8BSzB_fw&oe=6B0080FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-2560x1440.png", "id": "1481305757379362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628875_1481305760712695_2995580032871028984_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WO0VCpyh4joQ7kNvwEKKyEJ&_nc_oc=AdqDt7Txz1Iu_J-fIkMsY2RPfCkMuzhQ5Ol4PYaCAj7ZPyJ8KG1v6Sq8KJdZypxPoEc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRh7MffgSDHXbIeKHIDsqF5eTXIE-GTp_8Db_euVZoSdA&oe=6B005EAD"}, "display_name": "MitoRush", "keywords": ["fitness", "rhythm", "boxing", "workout", "cardio"], "long_description": "**Move to the beat. Bring your people.**\n\nMitoRush\u2122 turns music into a workout. Crystals fly at you on the beat; you hit them with your hands, dodge, duck, and \u2014 when you choose \u2014 kick and sprint. Two ways to play:\n\n- **Flow** \u2014 full-body movement to the music.\n- **Boxing** \u2014 punches and stances; tracks can call a stance change mid-song.\n\n**Your body, your settings.** Four difficulties. A five-step *Targets* ladder from hands-only to everything. Seated play. A calibration that places targets for your height and reach. Pair a Bluetooth heart-rate monitor and your effort shows on the results screen \u2014 never on a leaderboard.\n\n**Studio: live classes with voice.** Create a studio for your gym, family, or friends. A host starts a class, everyone plays the same beats at the same time, and you can talk while you sweat. Drop into a class with a six-character code. Studio members can author beatmaps in the web Choreographer and publish them for everyone.\n\n**Keep score.** Personal records, league boards ranked by minutes and points, and a recap after every session.\n\nMitoRush\u2122 is available as a **Solo** subscription (all solo play and the full library) or **Studio** (everything in Solo plus live classes and authoring). Billed through Meta; cancel any time from your Meta subscriptions.\n\nNot a medical device. Consult a professional before starting any exercise program.", "short_description": "MitoRush\u2122 is rhythm fitness in VR. Hit crystals to the beat \u2014 Flow for full-body movement, Boxing for punches and stances \u2014 at four difficulties, standing or seated, with a targets ladder from hands-only up to kicks and lightning steps. Play solo through a growing track library, or join live Studio classes: a host starts, everyone plays the same beats together, voice included. Pair a Bluetooth heart-rate monitor to see your effort. Solo and Studio subscriptions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mitorush.net/legal/privacy", "developer_terms_of_service_url": "https://mitorush.net/legal/terms", "publisher_name": "Technical Media LLC", "support_website_url": "https://mitorush.net/legal/data-deletion", "website_url": "https://mitorush.net/", "category": null, "comfort_rating": "COMFORTABLE_FO
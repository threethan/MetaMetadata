99624606_1603621591170751_6462140605694135058_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3Fdev3zTVkQ7kNvwGlQTX-&_nc_oc=AdqI_oLQZOHR-sjGeKGpMFXeYtaxH4_YM_T34YF3BFb4D-T9_BjXBFHbHuaLpylcdO8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5r8i2WCWhNq0_eDXEZD60CzOcTKUNB8-dHN3f6TtPwA&oe=6AEF5DBF"}, {"file_name": "com.TechnicalMediaLLC.MitoRush-20260926-053630.png", "id": "1327517526083046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628882_1327517529416379_6882822583030067814_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZYBX8F7BD4Q7kNvwGueCFJ&_nc_oc=AdpjfgLMHp0ED1Si3FkbPP_Lsx3U5OV7oL6YHq5lBwZPqsysEfeLXzUcVebdtp06H98&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJqAz-taGLCD2W-Sn_Fa8vSqijIW82Y0NI_n1LtgcQ0g&oe=6AEF5D7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-2560x1440.png", "id": "1481305757379362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628875_1481305760712695_2995580032871028984_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2WDdnx3hvAQ7kNvwEiIwsZ&_nc_oc=AdoRA9PfR6A3_04_yaJtHvG-b3_FbMosmjzuSA_7R0v_DvucPYMSlbF_0chLscdSrzs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuIpnJs7IZ4JyguDuJ9xI1VEEpEoKEBaGjg-H_oBJXtQ&oe=6AEF3B2D"}, "display_name": "MitoRush", "keywords": ["fitness", "rhythm", "boxing", "workout", "cardio"], "long_description": "**Move to the beat. Bring your people.**\n\nMitoRush\u2122 turns music into a workout. Crystals fly at you on the beat; you hit them with your hands, dodge, duck, and \u2014 when you choose \u2014 kick and sprint. Two ways to play:\n\n- **Flow** \u2014 full-body movement to the music.\n- **Boxing** \u2014 punches and stances; tracks can call a stance change mid-song.\n\n**Your body, your settings.** Four difficulties. A five-step *Targets* ladder from hands-only to everything. Seated play. A calibration that places targets for your height and reach. Pair a Bluetooth heart-rate monitor and your effort shows on the results screen \u2014 never on a leaderboard.\n\n**Studio: live classes with voice.** Create a studio for your gym, family, or friends. A host starts a class, everyone plays the same beats at the same time, and you can talk while you sweat. Drop into a class with a six-character code. Studio members can author beatmaps in the web Choreographer and publish them for everyone.\n\n**Keep score.** Personal records, league boards ranked by minutes and points, and a recap after every session.\n\nMitoRush\u2122 is available as a **Solo** subscription (all solo play and the full library) or **Studio** (everything in Solo plus live classes and authoring). Billed through Meta; cancel any time from your Meta subscriptions.\n\nNot a medical device. Consult a professional before starting any exercise program.", "short_description": "MitoRush\u2122 is rhythm fitness in VR. Hit crystals to the beat \u2014 Flow for full-body movement, Boxing for punches and stances \u2014 at four difficulties, standing or seated, with a targets ladder from hands-only up to kicks and lightning steps. Play solo through a growing track library, or join live Studio classes: a host starts, everyone plays the same beats together, voice included. Pair a Bluetooth heart-rate monitor to see your effort. Solo and Studio subscriptions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mitorush.net/legal/privacy", "developer_terms_of_service_url": "https://mitorush.net/legal/terms", "publisher_name": "Technical Media LLC", "support_website_url": "https://mitorush.net/legal/data-deletion", "website_url": "https://mitorush.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "26624742183878253"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_2269386147149799_1960952452528981193_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lN_gjh0OT88Q7kNvwFZP_oj&_nc_oc=Adp0DLqmTUXTisuC0Qj-I1F4rWqenddAWE0ZGAW3p-oBEmX94_-Jj1jANWaKwqbvTRE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY4duOYP_yVtDi8SjavIWWw8Vo7-JsS4KjAsMB-qVX6w&oe=6AEF3A01"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MitoRush", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1791280440, "lastRevision": {"nodes": [{"id": "26624742227211582", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26624742160544922", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1390439813160585"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "flat-512x512.png", "id": "4026382810829714", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622214_4026382814163047_4298005756767637141_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hYhRLBW2UcQ7kNvwFgNxhB&_nc_oc=AdqPLbS8-mifrpLNjknd1aeFn5bKW1tcKGINux0gVgwYcnswqVLVtNwgPQu3t4Dsnjo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRcoXhBGw2DpkNmBtP8tGsBPRl5Y-UEyrAa2X
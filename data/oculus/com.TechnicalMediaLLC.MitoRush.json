6-2.oculuscdn.com/v/t64.5771-25/499628882_1813060303472570_2726408037377302320_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFhy7VyZGdkQ7kNvwHGoKz-&_nc_oc=AdqjK8S63A_wZ36eW6_4U-bzGifGdR7I99A_xMDFhAMh7ZZyeeAG_zqoUPny4WV_E64&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpxszlPcOmuH18IOdMxYIs9zlQTb3sgmZktu3vWhcF0g&oe=6AE35847"}]}, "id": "1248074460641763", "locale": "en_US", "screenshots": [{"file_name": "com.TechnicalMediaLLC.MitoRush-20260926-053721.png", "id": "3378235279015695", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499624656_3378235282349028_5443183823316175979_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBjZl88VBicQ7kNvwHalcMF&_nc_oc=AdoHmgz1I3GDkwsGcZdN0-YwevICLVFfpwmNmGB0JiH-6eefxVlcl5DgPTIfGUy3_Lw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfVFiwBhfZGNIcIRCeM2MEDAftGmpdSTTEyG3-a2Bc5w&oe=6AE33F7A"}, {"file_name": "com.TechnicalMediaLLC.MitoRush-20260926-054018.png", "id": "1626235092362385", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499627502_1626235102362384_6821503916689686582_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1Jbrre2bmMQ7kNvwGm276n&_nc_oc=AdpeS245iHWezBtVKTwKmFuHLbywmMI8E5TXLxbArOQ7fj3A5Jk8dKCd8BWma6sg8EE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmE-ozzhk3pP8rHqKZNMk0yr3FKVvKUAartkYetTwxTg&oe=6AE3472D"}, {"file_name": "com.TechnicalMediaLLC.MitoRush-20260926-053848.png", "id": "1619253179863395", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619374_1619253183196728_8968988806605962146_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VW46Lcr7SlgQ7kNvwHBCPUv&_nc_oc=Adqe93YfYRYvVY5AB76obfiiTvz6VyO-393v5ilg4J5EfYCWIaxslcUys-58BEJTSgw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHuMy3MVkFQb7a9Sb8jZfjSZNX9Z8ZMBNrwzg958b1Kw&oe=6AE33E9E"}, {"file_name": "com.TechnicalMediaLLC.MitoRush-20260926-045121.png", "id": "1603621587837418", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499624606_1603621591170751_6462140605694135058_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1M6d418-j9cQ7kNvwE2uGiw&_nc_oc=AdodDPgpSg1WDWiEGgA7DwGy3odgFuc8UESZV0u8i0cgdqC6r7aN8kMFLFHg94UrGyY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1Yp2VUmGlZ3Gnvd8Rj2KwTIiM5CPlP8mkb1-ksorRUQ&oe=6AE347FF"}, {"file_name": "com.TechnicalMediaLLC.MitoRush-20260926-053630.png", "id": "1327517526083046", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499628882_1327517529416379_6882822583030067814_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9ZmDiOWzzEQ7kNvwHTepqy&_nc_oc=Adokm45hDlkKx4V4UIyBdPGguOXCfv7lMFmXFHfUHo0VbpWzC1rJdUIietdKy_tY-Sk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbMZEv0JJ3WMKAkeLJZ4WZ2TmQOs4T_h2O1roc0ny2RA&oe=6AE347BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-2560x1440.png", "id": "1481305757379362", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499628875_1481305760712695_2995580032871028984_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNNRdng4gk4Q7kNvwHLLx7G&_nc_oc=AdpJtWyu0MhlhUNoyZDhz6Uj9lf5I3uJWCWQ7-3mzhXQLwb7QBQ75Hs9LKtny746bfw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVuLcbyDtxSePNRvdzQIDmLbcIhyfgot3zFOIdei_lhw&oe=6AE35DAD"}, "display_name": "MitoRush", "keywords": ["fitness", "rhythm", "boxing", "workout", "cardio"], "long_description": "**Move to the beat. Bring your people.**\n\nMitoRush\u2122 turns music into a workout. Crystals fly at you on the beat; you hit them with your hands, dodge, duck, and \u2014 when you choose \u2014 kick and sprint. Two ways to play:\n\n- **Flow** \u2014 full-body movement to the music.\n- **Boxing** \u2014 punches and stances; tracks can call a stance change mid-song.\n\n**Your body, your settings.** Four difficulties. A five-step *Targets* ladder from hands-only to everything. Seated play. A calibration that places targets for your height and reach. Pair a Bluetooth heart-rate monitor and your effort shows on the results screen \u2014 never on a leaderboard.\n\n**Studio: live classes with voice.** Create a studio for your gym, family, or friends. A host starts a class, everyone plays the same beats at the same time, and you can talk while you sweat. Drop into a class with a six-character code. Studio members can author beatmaps in the web Choreographer and publish them for everyone.\n\n**Keep score.** Personal records, league boards ranked by minutes and points, and a recap after every session.\n\nMitoRush\u2122 is available as a **Solo** subscription (all solo play and the full library) or **Studio** (everything in Solo plus live classes and authoring). Billed through Meta; cancel any time from your Meta subscriptions.\n\nNot a medical device. Consult a professional before starting any exercise program.", "short_description": "MitoRush\u2122 is rhythm fitness in VR. Hit crystals to the beat \u2014 Flow for full-body movement, Boxing for punches and stances \u2014 at four difficulties, standing or seated, with a targets ladder from hands-only up to kicks and lightning steps. Play solo through a growing track library, or join live Studio classes: a host starts, everyone plays the same beats together, voice included. Pair a Bluetooth heart-rate monitor to see your effort. Solo and Studio subscriptions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mitorush.net/legal/privacy", "developer_terms_of_service_url": "https://mitorush.net/legal/terms", "publisher_name": "Technical Media LLC", "support_website_url": "https://mitorush.net/legal/data-deletion", "website_url": "https://mitorush.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "26624742183878253"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499622276_2269386147149799_1960952452528981193_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7X6uHdv-AwQ7kNvwEEAxdO&_nc_oc=Adom3D7sCn58ioBX18LM4LOQuNrLaoSXVOnGOexz39aAE7xbSm8fg0D5PvZLy7-klpU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5wCV0Fxw91t0ByRpKHNPNUIpxJz2SVAkUgaX7rSdPBQ&oe=6AE35C81"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MitoRush", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1791280440, "lastRevision": {"nodes": [{"id": "26624742227211582", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26624742160544922", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1390439813160585"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "flat-512x512.png", "id": "4026382810829714", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499622214_4026382814163047_4298005756767637141_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLbb6xkTNyEQ7kNvwFC6tZE&_nc_oc=AdpXY5yYI5cIR12APiBFbila6XWiHBIeK8zEKLmG56dkUg5WZgkcuKsijGIBaxtfUsQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXhwxQWg2ztv180fEP5XrIYimspO3sYRqBXFJ
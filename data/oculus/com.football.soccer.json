xbAAfsD3ztM8o-Et4rnP4P9py5cw8ouV-j8Mni3_-xjiizkABdwQFqs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRHC3f6oEJsXEjLPhzY9UTpajzlMKatGOd4YniPCk8prw&oe=6B0DB98A"}, {"file_name": "1-power-shot.png", "id": "1687469289465361", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/654969972_1687469292798694_5317617708347462799_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0Z_tHIK-m4Q7kNvwFLnyXC&_nc_oc=AdphEAqWjipLEO3QV8kSYMkdh4MN-u2aSMaHgULommYJ8TF89b-cHoiormUk6_dS06U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQm6-EIHscosQV1elyIuclH9kCVssMRa9eKBci-u5D0cA&oe=6B0DA43A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Football: Soccer Simulator", "keywords": ["Ball", "Football", "Soccer", "Sports", "Simulator"], "long_description": "Step onto the pitch and experience football from a whole new perspective. Football: Soccer Simulator brings the excitement of soccer into virtual reality, where your timing, movement and technique shape every play.\n\nKick, pass, shoot and control the ball with physics-driven gameplay. Work on your touch, line up your shots, send accurate passes and strike the ball with power and precision. Every match is a chance to sharpen your skills, create a great play and score the winning goal.\n\nTake on other players in online football matches, compete for every goal and prove what you can do on the pitch. Whether you are setting up a teammate, taking your chance on goal or fighting for the final result, success comes down to your control and skill.\n\nPut on your headset, step up to the ball and play.", "short_description": "Step onto the pitch in VR. Master physics-driven kicks, passes and shots, sharpen your football skills, and challenge players in online soccer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": 
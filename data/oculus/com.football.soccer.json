XOdY2avwAq-8dPwtFiswlTCfbAJSOJS_2VfvIrySoIkQztoHM-U-61k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSyDtDaFPBNaSWr7ll27cfmllL1wmn_T1U829j3cFFI6Q&oe=6B0C680A"}, {"file_name": "1-power-shot.png", "id": "1687469289465361", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/654969972_1687469292798694_5317617708347462799_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0Z_tHIK-m4Q7kNvwGR_xnO&_nc_oc=AdrslZLdzRZdQfAl2UwiCXmKNuH3w53kbYccmArhWscfzPlORI8FByiDXYE6d_RVFjQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSWAtJj32LSvqdVnUbK1-C7Xf-wbz2A7Vr0kFclg4zDpw&oe=6B0C52BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Football: Soccer Simulator", "keywords": ["Ball", "Football", "Soccer", "Sports", "Simulator"], "long_description": "Step onto the pitch and experience football from a whole new perspective. Football: Soccer Simulator brings the excitement of soccer into virtual reality, where your timing, movement and technique shape every play.\n\nKick, pass, shoot and control the ball with physics-driven gameplay. Work on your touch, line up your shots, send accurate passes and strike the ball with power and precision. Every match is a chance to sharpen your skills, create a great play and score the winning goal.\n\nTake on other players in online football matches, compete for every goal and prove what you can do on the pitch. Whether you are setting up a teammate, taking your chance on goal or fighting for the final result, success comes down to your control and skill.\n\nPut on your headset, step up to the ball and play.", "short_description": "Step onto the pitch in VR. Master physics-driven kicks, passes and shots, sharpen your football skills, and challenge players in online soccer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": 
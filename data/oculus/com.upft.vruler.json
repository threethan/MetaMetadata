_ss=7f20f&oh=00_AQM5LKr8Yt_0VZBbT0_32hORPtJUVoAzevXC1XY2gSbseA&oe=6ACD01A1"}, {"file_name": "\u30b7\u30fc\u30f3\uff12_2560.png", "id": "26209775272046975", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619159_26209775278713641_8709827802175148510_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p25PXuh3jpUQ7kNvwFHdNWe&_nc_oc=AdqmjDLZaLXr7lCFMHPjKcwRtBw3TjNPWpPOQICG2cgnAlZxcSgpbhpOKb7JWHvouoM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPH9pFMFUZ0urbW6t5XI0KsZpLAyEHnE-9cvzHfZkWilA&oe=6ACCF1DA"}, {"file_name": "\u30b7\u30fc\u30f3\uff13_2560.png", "id": "783275041497698", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618442_783275044831031_1975751670242047325_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eSa64g7e9gQ7kNvwEBmSjF&_nc_oc=AdoLWdC-hb_B1Jy7OeC3z04ZmrT7-AB379jklHzG1TImeEg3l52boUnsKXrB5haKHe8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvcsoTbBe6zUSDR3bNINAD0p87UXSPL8i7Zj5_Imrl1Q&oe=6ACCE703"}, {"file_name": "\u30b7\u30fc\u30f3\uff14_2560.png", "id": "3990206301277546", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618937_3990206304610879_381880560869317141_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-lIXBCjDPUQ7kNvwHvpkkO&_nc_oc=Adp3HSUZhGjeRZmt5CbtCPnPBEXztn9m9H2b-jXcNhWEfbiI8YU6LMJChw_7QJd9aek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXXTZkEri3sgs86vYmDa_xfhH7X8jPkAxI2d9xh77_iw&oe=6ACCFAF0"}, {"file_name": "\u30b7\u30fc\u30f3\uff15_2560.png", "id": "1243126824574843", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619681_1243126827908176_1758391069480939336_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jcg0qExb9b0Q7kNvwFNQH5y&_nc_oc=AdqEu3iz598cT6xRMAfftrqu4UNiwJfTOGt09Tnie8PpWDj2DLDYJXlRmDwgM2WcPNo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTdZDE9PsAfu3h-ORM-qJAbLj-IWDRpRM9q1ejtY7WvQ&oe=6ACCF753"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1974661950102370", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619680_1974661953435703_4924291664495900389_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYHkA1PZLMgQ7kNvwHeAS10&_nc_oc=AdrllJHYqpQPG0S-XgsnJ6eFrvuijX6BYcle9xvFedeM85biLonnYdGHfdujOUOyYy0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMu2ttOtcndFl2SAQvra3IqPFjzaBnTpNhlWLh5YsKvDQ&oe=6ACD0793"}, "display_name": "V-Ruler", "keywords": ["ruler", "measure", "length", "surface", "area"], "long_description": "\"V-Ruler\" is a convenient tool that allows you to easily measure distances and areas in the real world.\nWhether it's the height of a door, the size of a ceiling, or the surface area of a desk\u2014just point and measure whatever catches your attention.\n\nUsing controllers or hand gestures, you can instantly measure distances and areas.\nSimply select the edge of the object you want to measure to place a pin.\nConnect two pins to measure distance, or enclose an area with pins to calculate its surface area.\nThe intuitive interface and clear visuals make it easy to adjust or delete pins as needed.\nMeasurements can be displayed in both meters and inches, so you can check values in your preferred unit.\nEven places that are typically hard to measure\u2014like the height from floor to ceiling or the total area of a room\u2014can be measured effortlessly with V-Ruler.\n\nHave you ever wondered how big the doors around you are? Or how wide the ceiling is?\nBy measuring spaces you usually overlook, you might discover small moments of surprise\u2014\n\u201cIt\u2019s more spacious than I thought,\u201d or \u201cI didn\u2019t realize it was this long.\u201d\n\nStart a new measuring experience with \"V-Ruler\".\nSmart and simple distance measurement can make your everyday life more convenient.\n\nRecommended settings before launching the app:\nSwitch boundary mode to Walking Mode\nSet up spatial data for the area where you\u2019ll be using the app", "short_description": "V-Ruler is a smart and easy tool for measuring distances and areas in your surroundings.\nFrom door heights to ceiling sizes, just point and measure.\nYou might be surprised by how spacious or long things really are.\nDiscover small moments of wonder in everyday places.\nStart your new measuring experience with V-Ruler today.\n\nRecommended settings before use:\nSet boundary mode to Walking Mode\nConfigure spatial data for your space"}]}, "developer_name": null, "developer_privacy_policy_url": "https://up-frontier.jp/metaquest3-app-privacy", "developer_terms_of_service_url": null, "publisher_name": "Up-frontier, Inc.", "support_website_url": null, "website_url": "https://up-frontier.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27437229925876834"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393567_2151608695269127_6645090873314897085_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4GxN_YnJ3IQ7kNvwFKZKFM&_nc_oc=AdrL8GtfN3Xu0Whll6QxRU2NnizfK83ADuN8w8M1YtgiJiaSvxh-YGaN65OUpYOU61A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKsGpWK4PJYpwDCG4-cnRXc0ILv5fHGa2Fvg2-lypeFg&oe=6ACD0429"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "V-Ruler", "platform": "ANDROID_6DOF", "context_category": {"context_category":
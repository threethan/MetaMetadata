s://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499617762_899807123037966_227168990617120742_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrtwDMkHRiQQ7kNvwHgLdy4&_nc_oc=AdpreABDc0QC17xYGwr0mhLTss6YvKHWdEeljWtYfrFYeLoedOS8hAO0K5BqvQspclE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJZCqRH5_hBtF7hPlME1UmqYxIcjVU8UJThOxELZ9SqA&oe=6AAEAF21"}, {"file_name": "\u30b7\u30fc\u30f3\uff12_2560.png", "id": "26209775272046975", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619159_26209775278713641_8709827802175148510_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTH-bSBiWtgQ7kNvwFkNeEw&_nc_oc=Adqrrvtk0J9e7Pwc7odL2X0szIqFDfjh9bGfbu2Yxpm6ZurKhhvrgdKKCvL3zF9dTps&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfqgdV0GjlOS2ieByNHwbdpMl0yQj_HQciODh-liQh4g&oe=6AAE9F5A"}, {"file_name": "\u30b7\u30fc\u30f3\uff13_2560.png", "id": "783275041497698", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499618442_783275044831031_1975751670242047325_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JqaygCFQYMQ7kNvwESnU0u&_nc_oc=AdrZnC3aFkOcq2WRV5d_p89Qd88h_CeUakP0LuGXpGxvFdv799PP8IJoChHhqEBHKWk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-qBfCTrdHJUtTqZvchVRfsTpxt27kuGKt0372n70cjg&oe=6AAE9483"}, {"file_name": "\u30b7\u30fc\u30f3\uff14_2560.png", "id": "3990206301277546", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618937_3990206304610879_381880560869317141_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-NvLwmUaTAQ7kNvwFPDFxt&_nc_oc=AdoWKjeOoqnVW9V4dl5rrDlnGdR3K6W8zRFHcXq_w5BNYKRI8fOpkBX8BR-qvcpF9GA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVhgiJNMvhJK-13NV_ZeKpq0Cc_cQ_l1dEcQki7g6bCA&oe=6AAEA870"}, {"file_name": "\u30b7\u30fc\u30f3\uff15_2560.png", "id": "1243126824574843", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499619681_1243126827908176_1758391069480939336_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeCHo3McArcQ7kNvwGo0jLN&_nc_oc=AdpjBi0FhnKieTbM_xq-UezOjUWhSJWYZqjcfKF59NXtGmWsDyhHldv3RIYjZHyienk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLseHxp8O7so_4SqBazhiiN-WmTldP3dXPx0nE3FjmRhw&oe=6AAEA4D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1974661950102370", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619680_1974661953435703_4924291664495900389_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92YyvAcCW-4Q7kNvwEZDGDD&_nc_oc=Adr7xFzAK44_c4bSg9khWvtFuxRWaTulVM6Nhw1vvv1yptRf8_Q7TBB6zAgNcyzIx_I&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPxPtUcGHYpaPl4aTSc_phR0E8UH2Q5rmMolUzex1RAw&oe=6AAEB513"}, "display_name": "V-Ruler", "keywords": ["ruler", "measure", "length", "surface", "area"], "long_description": "\"V-Ruler\" is a convenient tool that allows you to easily measure distances and areas in the real world.\nWhether it's the height of a door, the size of a ceiling, or the surface area of a desk\u2014just point and measure whatever catches your attention.\n\nUsing controllers or hand gestures, you can instantly measure distances and areas.\nSimply select the edge of the object you want to measure to place a pin.\nConnect two pins to measure distance, or enclose an area with pins to calculate its surface area.\nThe intuitive interface and clear visuals make it easy to adjust or delete pins as needed.\nMeasurements can be displayed in both meters and inches, so you can check values in your preferred unit.\nEven places that are typically hard to measure\u2014like the height from floor to ceiling or the total area of a room\u2014can be measured effortlessly with V-Ruler.\n\nHave you ever wondered how big the doors around you are? Or how wide the ceiling is?\nBy measuring spaces you usually overlook, you might discover small moments of surprise\u2014\n\u201cIt\u2019s more spacious than I thought,\u201d or \u201cI didn\u2019t realize it was this long.\u201d\n\nStart a new measuring experience with \"V-Ruler\".\nSmart and simple distance measurement can make your everyday life more convenient.\n\nRecommended settings before launching the app:\nSwitch boundary mode to Walking Mode\nSet up spatial data for the area where you\u2019ll be using the app", "short_description": "V-Ruler is a smart and easy tool for measuring distances and areas in your surroundings.\nFrom door heights to ceiling sizes, just point and measure.\nYou might be surprised by how spacious or long things really are.\nDiscover small moments of wonder in everyday places.\nStart your new measuring experience with V-Ruler today.\n\nRecommended settings before use:\nSet boundary mode to Walking Mode\nConfigure spatial data for your space"}]}, "developer_name": null, "developer_privacy_policy_url": "https://up-frontier.jp/metaquest3-app-privacy", "developer_terms_of_service_url": null, "publisher_name": "Up-frontier, Inc.", "support_website_url": null, "website_url": "https://up-frontier.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27437229925876834"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1398926008216267"}]}, "baseline_offer": {"id": "1398926008216267"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774485000, "status": "PUBLISHED", "id": "1398926008216267"}]}, "liveChannel": {"nodes": [{"latest_supported_binary":
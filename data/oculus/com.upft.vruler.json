_ss=7f20f&oh=00_AQOEhwYRfZqMfwlZaEFbmG-Zvw9C-vYGMKHgmnCA4Oh1iA&oe=6AD247A1"}, {"file_name": "\u30b7\u30fc\u30f3\uff12_2560.png", "id": "26209775272046975", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619159_26209775278713641_8709827802175148510_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDnK-dvjk48Q7kNvwGnvCfp&_nc_oc=Adrs_2r112SMHXEu5LGzazaO87ay2WzI2lQliAqP5RfDvsD8lE2EZsv8xDXnE2cPneY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQTDOT25F-jdx6vJ7PHo3mFEH-IWK5TCwA5-aSapAGAA&oe=6AD237DA"}, {"file_name": "\u30b7\u30fc\u30f3\uff13_2560.png", "id": "783275041497698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618442_783275044831031_1975751670242047325_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhzGRwb0kFUQ7kNvwEVfo4P&_nc_oc=Adr09toKMHQkaDGD5nIq0nGvZnIEihL41PhbcXIVyGYi24sJWMJ9CwpiExn8xin9rFo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEmwftJ41TijU_irxHKRv67nk2Bb-oFmKVCiEo7zVr5w&oe=6AD22D03"}, {"file_name": "\u30b7\u30fc\u30f3\uff14_2560.png", "id": "3990206301277546", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618937_3990206304610879_381880560869317141_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFDnI1vFF-YQ7kNvwFjsetG&_nc_oc=AdoqLFcWwMK0dJpiPIpYuU0fnGg0eHwlE8TeTXZoor5wmYePu8b21MZThb7XRbueQ0c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqURB7-imghN1GAR07g3YAhAEcpLjPzytYGvmWbK4MBA&oe=6AD240F0"}, {"file_name": "\u30b7\u30fc\u30f3\uff15_2560.png", "id": "1243126824574843", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619681_1243126827908176_1758391069480939336_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyYnuLjvtXsQ7kNvwH5ZFaw&_nc_oc=AdqsQ4VQTUsh_qy8DGZWqwA6ia3sGH4r28-roj5Re8ftsE0clEF0Ku49JsR8KlgUGSE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsmw1VNDLJfl2JntTWrytdoXYMbD13C_Y5hiraR4aAWw&oe=6AD23D53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1974661950102370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619680_1974661953435703_4924291664495900389_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sk9BgerCKooQ7kNvwGXxarI&_nc_oc=AdrUgDpul1dWHPuefaqKJJeALGWOhbz-lwYhjQvVo9X_jpHhfY4qN1WW7qaSlwWsvTo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzKsMgpaAqLuRB2MkCk2oehdngjY34s-MFnUuhHrDkVQ&oe=6AD24D93"}, "display_name": "V-Ruler", "keywords": ["ruler", "measure", "length", "surface", "area"], "long_description": "\"V-Ruler\" is a convenient tool that allows you to easily measure distances and areas in the real world.\nWhether it's the height of a door, the size of a ceiling, or the surface area of a desk\u2014just point and measure whatever catches your attention.\n\nUsing controllers or hand gestures, you can instantly measure distances and areas.\nSimply select the edge of the object you want to measure to place a pin.\nConnect two pins to measure distance, or enclose an area with pins to calculate its surface area.\nThe intuitive interface and clear visuals make it easy to adjust or delete pins as needed.\nMeasurements can be displayed in both meters and inches, so you can check values in your preferred unit.\nEven places that are typically hard to measure\u2014like the height from floor to ceiling or the total area of a room\u2014can be measured effortlessly with V-Ruler.\n\nHave you ever wondered how big the doors around you are? Or how wide the ceiling is?\nBy measuring spaces you usually overlook, you might discover small moments of surprise\u2014\n\u201cIt\u2019s more spacious than I thought,\u201d or \u201cI didn\u2019t realize it was this long.\u201d\n\nStart a new measuring experience with \"V-Ruler\".\nSmart and simple distance measurement can make your everyday life more convenient.\n\nRecommended settings before launching the app:\nSwitch boundary mode to Walking Mode\nSet up spatial data for the area where you\u2019ll be using the app", "short_description": "V-Ruler is a smart and easy tool for measuring distances and areas in your surroundings.\nFrom door heights to ceiling sizes, just point and measure.\nYou might be surprised by how spacious or long things really are.\nDiscover small moments of wonder in everyday places.\nStart your new measuring experience with V-Ruler today.\n\nRecommended settings before use:\nSet boundary mode to Walking Mode\nConfigure spatial data for your space"}]}, "developer_name": null, "developer_privacy_policy_url": "https://up-frontier.jp/metaquest3-app-privacy", "developer_terms_of_service_url": null, "publisher_name": "Up-frontier, Inc.", "support_website_url": null, "website_url": "https://up-frontier.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27437229925876834"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393567_2151608695269127_6645090873314897085_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhQynH8ArXEQ7kNvwE-aMTq&_nc_oc=AdpuIwj5-fOJsz_-sC_up4QI1XOLAVxy_VwNVq3yOdxzz2IuYVXwbF5l_bsUH1I_1To&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyu0ol-zKits5g73_64miSdcl31P4soXEudUgfoqn8-A&oe=6AD24A29"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "V-Ruler", "platform": "ANDROID_6DOF", "context_category": {"context_category":
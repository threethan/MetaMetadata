633", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499617762_899807123037966_227168990617120742_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cz1I1s_Bt7EQ7kNvwGyXHOp&_nc_oc=AdpPygppdTdi9wb4l7-WDPZlGuxCC2y1lgOSWtD8tIx0ynRKV0l71YAGqvQPjsQ97_o&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQ_attlXKrCzV9-UVfLfhd3zKYsQDqDgMJ-9sIxKZAYA&oe=6A859861"}, {"file_name": "\u30b7\u30fc\u30f3\uff12_2560.png", "id": "26209775272046975", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619159_26209775278713641_8709827802175148510_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dknXlZ13fVgQ7kNvwHp4n40&_nc_oc=AdqWuE5QAymqJsbqJCvzIIpM3BmSINLJKFBLuP_GXYKQjLp2iKVg1L1idUMixJmjKsc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTkfiOFOVpvtdiOp5gUJcgSasldbPIIwjE5Ka4pSULQw&oe=6A85889A"}, {"file_name": "\u30b7\u30fc\u30f3\uff13_2560.png", "id": "783275041497698", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618442_783275044831031_1975751670242047325_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2u9qO9iXQwQ7kNvwFhuCtG&_nc_oc=Adq6VdbAjqdn4AELpoR9bLpytKAfy2dVB91IO9NnmCmsKl3UrNIjuKzsMlYwwN8WSkw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDWzQWAehzS9WSE5tZ1-g6DtMx2uZ-9IpgtwA-O0Qv8g&oe=6A857DC3"}, {"file_name": "\u30b7\u30fc\u30f3\uff14_2560.png", "id": "3990206301277546", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618937_3990206304610879_381880560869317141_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WzPg_50-ksgQ7kNvwGfnyEn&_nc_oc=AdqW7JFAJm4MCIrKBd1H88Ee4HhbG5GNA78P1k-JpHArylPqjzReSaaThTYkwm47hjI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFm5ZmKanLk__PVYF7yQLiEhszeW8QDD09uzvGSETcq1A&oe=6A8591B0"}, {"file_name": "\u30b7\u30fc\u30f3\uff15_2560.png", "id": "1243126824574843", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499619681_1243126827908176_1758391069480939336_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLMStzARzI0Q7kNvwE5tMFw&_nc_oc=AdoxN-yIOW3Oj9iW9PNNNx6dbamSQvvB4mW33bI--hm09V3g1z_tjpwBMx-8bSnwHas&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDmmeZ-npHYIbkou8MWC6by1SXEMM9AkdXplTA4kbTeg&oe=6A858E13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1974661950102370", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619680_1974661953435703_4924291664495900389_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UDMycQKs6kQ7kNvwEjnUiB&_nc_oc=AdprRZ4ngSSj5ADilWCAcWPe1oqz00mv9SCv4TYnnspbZZZhKEMoSscMmwRdoGYb-4E&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwVIlnDfWcP0FY9P_TECPEUgz-92JcMBGMY7FN5LLimA&oe=6A859E53"}, "display_name": "V-Ruler", "keywords": ["ruler", "measure", "length", "surface", "area"], "long_description": "\"V-Ruler\" is a convenient tool that allows you to easily measure distances and areas in the real world.\nWhether it's the height of a door, the size of a ceiling, or the surface area of a desk\u2014just point and measure whatever catches your attention.\n\nUsing controllers or hand gestures, you can instantly measure distances and areas.\nSimply select the edge of the object you want to measure to place a pin.\nConnect two pins to measure distance, or enclose an area with pins to calculate its surface area.\nThe intuitive interface and clear visuals make it easy to adjust or delete pins as needed.\nMeasurements can be displayed in both meters and inches, so you can check values in your preferred unit.\nEven places that are typically hard to measure\u2014like the height from floor to ceiling or the total area of a room\u2014can be measured effortlessly with V-Ruler.\n\nHave you ever wondered how big the doors around you are? Or how wide the ceiling is?\nBy measuring spaces you usually overlook, you might discover small moments of surprise\u2014\n\u201cIt\u2019s more spacious than I thought,\u201d or \u201cI didn\u2019t realize it was this long.\u201d\n\nStart a new measuring experience with \"V-Ruler\".\nSmart and simple distance measurement can make your everyday life more convenient.\n\nRecommended settings before launching the app:\nSwitch boundary mode to Walking Mode\nSet up spatial data for the area where you\u2019ll be using the app", "short_description": "V-Ruler is a smart and easy tool for measuring distances and areas in your surroundings.\nFrom door heights to ceiling sizes, just point and measure.\nYou might be surprised by how spacious or long things really are.\nDiscover small moments of wonder in everyday places.\nStart your new measuring experience with V-Ruler today.\n\nRecommended settings before use:\nSet boundary mode to Walking Mode\nConfigure spatial data for your space"}]}, "developer_name": null, "developer_privacy_policy_url": "https://up-frontier.jp/metaquest3-app-privacy", "developer_terms_of_service_url": null, "publisher_name": "Up-frontier, Inc.", "support_website_url": null, "website_url": "https://up-frontier.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27437229925876834"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1398926008216267"}]}, "baseline_offer": {"id": "1398926008216267"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774485000, "status": "PUBLISHED", "id": "1398926008216267"}]}, "liveChannel": {"nodes": [{"lat
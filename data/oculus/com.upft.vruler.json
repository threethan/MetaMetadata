_ss=7f20f&oh=00_AQE_5mjiy6eiw2xtS94lrlLDG-zm0NizSQYBrHAshE8ifw&oe=6A732361"}, {"file_name": "\u30b7\u30fc\u30f3\uff12_2560.png", "id": "26209775272046975", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619159_26209775278713641_8709827802175148510_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ypMHnhijSgQ7kNvwFSSNAM&_nc_oc=AdoA8AsaAW246cHTJLLJZ5imypjaY0lbYjj81wpLUJcN53sZVWwRKdWdQD0xAA0mNUg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkKq7RXfTrd0H3a3ky-SQvM1t3M3gUEch1lSIRZQbU5Q&oe=6A734BDA"}, {"file_name": "\u30b7\u30fc\u30f3\uff13_2560.png", "id": "783275041497698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618442_783275044831031_1975751670242047325_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTYYDMGvz74Q7kNvwGWNC76&_nc_oc=AdrDhOsHusfsNxCPO1pF5o0omno7aRORbb13If_keGea6a0iTXPhOjDs7pduUQojmnM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHz0Ikb8uAljCvA4RQKRygyN2KnuxE_dnh59BdtNEv7nA&oe=6A734103"}, {"file_name": "\u30b7\u30fc\u30f3\uff14_2560.png", "id": "3990206301277546", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618937_3990206304610879_381880560869317141_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6CRcVPOXXUQ7kNvwEsjT0N&_nc_oc=AdpUDQ3FAoP7MPwPOubZQOLX9isDjUGn-BfxEXcQrrssEApjwcWSpXI41xlSD5klT-E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhaaI8SxGgDg8kG045wsaMs2jVbx_RBDGoxCnVbnptTA&oe=6A7354F0"}, {"file_name": "\u30b7\u30fc\u30f3\uff15_2560.png", "id": "1243126824574843", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619681_1243126827908176_1758391069480939336_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pP07iEU6ABsQ7kNvwEFLiPW&_nc_oc=AdrQk5bNdvbu3-Gm8wgc23n3nePx9uqo0tAIBixQ8cxi6-xOy1wFTDa7kasKzDnkcPs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENLwaEQQJyP2JgLSqGck-hp_XJa5jihZHCAQ8Dn9pW-w&oe=6A735153"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1974661950102370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619680_1974661953435703_4924291664495900389_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_OkmQAnmD8Q7kNvwFjOT0A&_nc_oc=AdpgyD3C4oxZh6jGbFo_dY7YdBA5O6CdXFwh_dRcOvEbTxoNXdJNscGX4wPt3M_WdEU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMYPme4eh1PcE1nhfpmbg_aGQ1XOU0tAwZgQBTx0HsyQ&oe=6A732953"}, "display_name": "V-Ruler", "keywords": ["ruler", "measure", "length", "surface", "area"], "long_description": "\"V-Ruler\" is a convenient tool that allows you to easily measure distances and areas in the real world.\nWhether it's the height of a door, the size of a ceiling, or the surface area of a desk\u2014just point and measure whatever catches your attention.\n\nUsing controllers or hand gestures, you can instantly measure distances and areas.\nSimply select the edge of the object you want to measure to place a pin.\nConnect two pins to measure distance, or enclose an area with pins to calculate its surface area.\nThe intuitive interface and clear visuals make it easy to adjust or delete pins as needed.\nMeasurements can be displayed in both meters and inches, so you can check values in your preferred unit.\nEven places that are typically hard to measure\u2014like the height from floor to ceiling or the total area of a room\u2014can be measured effortlessly with V-Ruler.\n\nHave you ever wondered how big the doors around you are? Or how wide the ceiling is?\nBy measuring spaces you usually overlook, you might discover small moments of surprise\u2014\n\u201cIt\u2019s more spacious than I thought,\u201d or \u201cI didn\u2019t realize it was this long.\u201d\n\nStart a new measuring experience with \"V-Ruler\".\nSmart and simple distance measurement can make your everyday life more convenient.\n\nRecommended settings before launching the app:\nSwitch boundary mode to Walking Mode\nSet up spatial data for the area where you\u2019ll be using the app", "short_description": "V-Ruler is a smart and easy tool for measuring distances and areas in your surroundings.\nFrom door heights to ceiling sizes, just point and measure.\nYou might be surprised by how spacious or long things really are.\nDiscover small moments of wonder in everyday places.\nStart your new measuring experience with V-Ruler today.\n\nRecommended settings before use:\nSet boundary mode to Walking Mode\nConfigure spatial data for your space"}]}, "developer_name": null, "developer_privacy_policy_url": "https://up-frontier.jp/metaquest3-app-privacy", "developer_terms_of_service_url": null, "publisher_name": "Up-frontier, Inc.", "support_website_url": null, "website_url": "https://up-frontier.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27437229925876834"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393567_2151608695269127_6645090873314897085_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzCC23KrX38Q7kNvwGW0aLO&_nc_oc=AdpLB7cKFjALvC0Vy0IDno-bSwYNuTlXKsH7qQ00dcTZhVvlNmZmHNocygAq-IKztfM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFr4XImSaW4APEETtHbHtOWX4eBvWSTan7CaB5sYU5Cpw&oe=6A7325E9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "V-Ruler", "platform": "ANDROID_6DOF", "context_category": {"context_category":
/499617850_2388120594963268_2341086176779943447_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBfEnJm-JfYQ7kNvwE_7Gkb&_nc_oc=AdqTqhVHFckAOl2MzNuHAv0Q8m2ZCVZyXay0JOU-SZeJjT4RpEiqLPRxyYuTQN0uKYY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmUV9UIC1ZXJ6xHEBm1sD0DZYvYpO42kzylUVqP5T2rA&oe=6B05B228"}, "display_name": "V-Ruler", "keywords": ["\u5b9a\u898f", "\u30eb\u30fc\u30e9\u30fc", "\u8a08\u6e2c", "\u9577\u3055", "\u9762\u7a4d"], "long_description": "\u300cV-Ruler\u300d\u306f\u73fe\u5b9f\u7a7a\u9593\u306e\u8ddd\u96e2\u3001\u9762\u7a4d\u3092\u6c17\u8efd\u306b\u8a08\u6e2c\u3067\u304d\u308b\u4fbf\u5229\u306a\u30c4\u30fc\u30eb\u3067\u3059\u3002\n\u30c9\u30a2\u306e\u9ad8\u3055\u3084\u5929\u4e95\u306e\u5e83\u3055\u3001\u673a\u306e\u9762\u7a4d\u306a\u3069\u6c17\u306b\u306a\u3063\u305f\u7269\u3092\u6e2c\u3063\u3066\u307f\u307e\u3057\u3087\u3046\u3002\n\n\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u30fb\u30cf\u30f3\u30c9\u30b8\u30a7\u30b9\u30c1\u30e3\u30fc\u3092\u4f7f\u3063\u3066\u3001\u8ddd\u96e2\u3084\u9762\u7a4d\u3092\u77ac\u6642\u306b\u6e2c\u5b9a\u3067\u304d\u307e\u3059\u3002\n\u6e2c\u308a\u305f\u3044\u5bfe\u8c61\u306e\u7aef\u3092\u9078\u629e\u3059\u308b\u3068\u3001\u30d4\u30f3\u304c\u304a\u3051\u307e\u3059\u3002\n\u30d4\u30f3\u3068\u30d4\u30f3\u3092\u7e4b\u3052\u308b\u3068\u8ddd\u96e2\u304c\u3001\u30d4\u30f3\u3067\u7bc4\u56f2\u3092\u56f2\u3046\u3068\u9762\u7a4d\u304c\u6e2c\u5b9a\u3067\u304d\u307e\u3059\u3002\n\u76f4\u611f\u7684\u306a\u64cd\u4f5c\u3068\u308f\u304b\u308a\u3084\u3059\u3044\u8868\u793a\u3067\u30d4\u30f3\u306e\u5fae\u8abf\u6574\u3001\u524a\u9664\u3082\u7c21\u5358\u3002\n\u30e1\u30fc\u30c8\u30eb\u8868\u793a\u3068\u30a4\u30f3\u30c1\u8868\u793a\u306b\u3082\u5bfe\u5fdc\u3002\u305d\u308c\u305e\u308c\u3067\u6570\u5024\u3092\u78ba\u8a8d\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002\n\u5929\u4e95\u304b\u3089\u5e8a\u306e\u9ad8\u3055\u3084\u90e8\u5c4b\u5168\u4f53\u306e\u9762\u7a4d\u306a\u3069\u3001\u5b9f\u969b\u306b\u306f\u6e2c\u308a\u306b\u304f\u3044\u5834\u6240\u3082\n\u300cV-Ruler\u300d\u306a\u3089\u7c21\u5358\u306b\u6e2c\u5b9a\u304c\u3067\u304d\u307e\u3059\u3002\n\n\u3042\u306a\u305f\u306e\u5468\u308a\u306e\u30c9\u30a2\u306e\u5927\u304d\u3055\u306f\uff1f\u5929\u4e95\u306e\u5e83\u3055\u306f\uff1f\n\u6c17\u306b\u3082\u3057\u306a\u304b\u3063\u305f\u5834\u6240\u3092\u6e2c\u308b\u3053\u3068\u3067\u3001\n\u3053\u3093\u306a\u306b\u5e83\u304b\u3063\u305f\u3093\u3060\u3001\u3053\u3093\u306a\u306b\u9577\u304b\u3063\u305f\u3093\u3060\u3068\u5c0f\u3055\u306a\u611f\u52d5\u3092\u898b\u3064\u3051\u3066\u307f\u307e\u3057\u3087\u3046\u3002\n\n\u300cV-Ruler\u300d\u3067\u3001\u65b0\u3057\u3044\u6e2c\u5b9a\u4f53\u9a13\u3092\u59cb\u3081\u3066\u307f\u307e\u305b\u3093\u304b\uff1f\n\u30b9\u30de\u30fc\u30c8\u3067\u7c21\u5358\u306a\u8ddd\u96e2\u6e2c\u5b9a\u304c\u3001\u3042\u306a\u305f\u306e\u65e5\u5e38\u3092\u3082\u3063\u3068\u4fbf\u5229\u306b\u3057\u307e\u3059\u3002\n\n\u203b\u30a2\u30d7\u30ea\u306e\u8d77\u52d5\u524d\u306b\u4ee5\u4e0b\u306e\u8a2d\u5b9a\u3092\u3057\u3066\u304a\u304f\u3053\u3068\u3092\u304a\u52e7\u3081\u3057\u307e\u3059\u3002\n\u30fb\u5883\u754c\u7dda\u30e2\u30fc\u30c9\u3092\u6b69\u884c\u30e2\u30fc\u30c9\u306b\u5909\u66f4\n\u30fb\u30a2\u30d7\u30ea\u3092\u5229\u7528\u3059\u308b\u7a7a\u9593\u306e\u3001\u7a7a\u9593\u30c7\u30fc\u30bf\u306e\u8a2d\u5b9a", "short_description": "\u300cV-Ruler\u300d\u306f\u73fe\u5b9f\u7a7a\u9593\u306e\u8ddd\u96e2\u3001\u9762\u7a4d\u3092\u6c17\u8efd\u306b\u8a08\u6e2c\u3067\u304d\u308b\u4fbf\u5229\u306a\u30c4\u30fc\u30eb\u3067\u3059\u3002\n\u30c9\u30a2\u306e\u9ad8\u3055\u3084\u5929\u4e95\u306e\u5e83\u3055\u3001\u673a\u306e\u9762\u7a4d\u306a\u3069\u6c17\u306b\u306a\u3063\u305f\u7269\u3092\u6e2c\u3063\u3066\u307f\u307e\u3057\u3087\u3046\u3002\n\n\u3042\u306a\u305f\u306e\u5468\u308a\u306e\u30c9\u30a2\u306e\u5927\u304d\u3055\u306f\uff1f\u5929\u4e95\u306e\u5e83\u3055\u306f\uff1f\n\u6c17\u306b\u3082\u3057\u306a\u304b\u3063\u305f\u5834\u6240\u3092\u6e2c\u308b\u3053\u3068
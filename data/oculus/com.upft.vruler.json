633", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499617762_899807123037966_227168990617120742_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2JdiM80bw4Q7kNvwEhQL2h&_nc_oc=AdqyZ3xFHgcQoZGCZ4dPtk7JDk9lNH2E8jxncit1IrDcIun2J46GACV9Lw2cS7T2W0Y&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGf_PbhIV_Ng00X1B7PGYaQOQwMRs8buB0bRYizteynOg&oe=6A8D8161"}, {"file_name": "\u30b7\u30fc\u30f3\uff12_2560.png", "id": "26209775272046975", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619159_26209775278713641_8709827802175148510_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsmXMwmUWPsQ7kNvwEKday2&_nc_oc=AdrBucvOWQp4iOxDL6caSzu-Kpg6H8gSogaSw4yvtAjvQ-SUHt6CIP0nHNz59KxZ2kw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhd7Nmg4f8fhJhP1os0hEUmieTLzPFjYM7OkjkxwDPSw&oe=6A8D719A"}, {"file_name": "\u30b7\u30fc\u30f3\uff13_2560.png", "id": "783275041497698", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618442_783275044831031_1975751670242047325_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8m1gRSIc4NAQ7kNvwEbYstr&_nc_oc=Adp28lW9-O7kKNt0bodEdP5jA4R1JP--wQ7VV3gXLUSTf5kEhs6K2XRoYnAZSHrii2w&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLwESxxzkQcBDAV9sb_JK8tdJZq2pFmywyBO9RYBOlaw&oe=6A8D66C3"}, {"file_name": "\u30b7\u30fc\u30f3\uff14_2560.png", "id": "3990206301277546", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618937_3990206304610879_381880560869317141_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtSy0DR-BvEQ7kNvwHVAiKI&_nc_oc=Adpp2VBYgpkRLwahzTW4MefWXV7u6Ft6fDJrx8CfN7fApCFOmItqKoKe6QKhwhwl_FY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHv1PADErNbAiB0y_yySzC8zi6RFztDFRPAynfU_AEYFw&oe=6A8D7AB0"}, {"file_name": "\u30b7\u30fc\u30f3\uff15_2560.png", "id": "1243126824574843", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499619681_1243126827908176_1758391069480939336_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QoJbgUUXB7MQ7kNvwGxLkxM&_nc_oc=Adp15lqV97nk2hDS_3ynRSvUp5G-7_eRti-ThmEZycBII3EGL8PagvZszS__3ifsJ6M&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH32AXRvu4S7bHtWNLI9dlCJkg-e-2hupJQKG9IphJ6TA&oe=6A8D7713"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1974661950102370", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619680_1974661953435703_4924291664495900389_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATPclMFzZFQQ7kNvwEiQLKd&_nc_oc=AdoU9mM9RoyDXPmBPBFCTty5aqI7JhW2F1flFOzvlPoUXymZDveVxv_wB-Nn1ijn4Ak&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwxA4hKUPeKVg5qCxS23pMbc35zjkB8B2F7_4mYbwBmg&oe=6A8D8753"}, "display_name": "V-Ruler", "keywords": ["ruler", "measure", "length", "surface", "area"], "long_description": "\"V-Ruler\" is a convenient tool that allows you to easily measure distances and areas in the real world.\nWhether it's the height of a door, the size of a ceiling, or the surface area of a desk\u2014just point and measure whatever catches your attention.\n\nUsing controllers or hand gestures, you can instantly measure distances and areas.\nSimply select the edge of the object you want to measure to place a pin.\nConnect two pins to measure distance, or enclose an area with pins to calculate its surface area.\nThe intuitive interface and clear visuals make it easy to adjust or delete pins as needed.\nMeasurements can be displayed in both meters and inches, so you can check values in your preferred unit.\nEven places that are typically hard to measure\u2014like the height from floor to ceiling or the total area of a room\u2014can be measured effortlessly with V-Ruler.\n\nHave you ever wondered how big the doors around you are? Or how wide the ceiling is?\nBy measuring spaces you usually overlook, you might discover small moments of surprise\u2014\n\u201cIt\u2019s more spacious than I thought,\u201d or \u201cI didn\u2019t realize it was this long.\u201d\n\nStart a new measuring experience with \"V-Ruler\".\nSmart and simple distance measurement can make your everyday life more convenient.\n\nRecommended settings before launching the app:\nSwitch boundary mode to Walking Mode\nSet up spatial data for the area where you\u2019ll be using the app", "short_description": "V-Ruler is a smart and easy tool for measuring distances and areas in your surroundings.\nFrom door heights to ceiling sizes, just point and measure.\nYou might be surprised by how spacious or long things really are.\nDiscover small moments of wonder in everyday places.\nStart your new measuring experience with V-Ruler today.\n\nRecommended settings before use:\nSet boundary mode to Walking Mode\nConfigure spatial data for your space"}]}, "developer_name": null, "developer_privacy_policy_url": "https://up-frontier.jp/metaquest3-app-privacy", "developer_terms_of_service_url": null, "publisher_name": "Up-frontier, Inc.", "support_website_url": null, "website_url": "https://up-frontier.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27437229925876834"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1398926008216267"}]}, "baseline_offer": {"id": "1398926008216267"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774485000, "status": "PUBLISHED", "id": "1398926008216267"}]}, "liveChannel": {"nodes": [{"lat
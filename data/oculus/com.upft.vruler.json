s://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499617762_899807123037966_227168990617120742_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iL9oGK5S3kQ7kNvwE9GR1m&_nc_oc=AdozLpRWwrDTE5L10DhwcfsbAhiueqQoe_Q6BBkfkteFnv2FIYHFk9neSVHPbNE9bV4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TqQCfoS1gad_yezgprlGx1JAX-_zVS8ySQDzPAGloUA&oe=6A4688A1"}, {"file_name": "\u30b7\u30fc\u30f3\uff12_2560.png", "id": "26209775272046975", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619159_26209775278713641_8709827802175148510_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGK6qA06AksQ7kNvwHt2F-V&_nc_oc=AdpJLzN0cMayi2ZLT6q9_avweWjMEqE5-pyCc7GDrrx6Oj74JTUBk3uI6W_yiVd4QdY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uuF6RZhcDDTDLkFAodDHcfXP-9WxTSWNql6ZC-ZQ-Ew&oe=6A4678DA"}, {"file_name": "\u30b7\u30fc\u30f3\uff13_2560.png", "id": "783275041497698", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499618442_783275044831031_1975751670242047325_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJIZIGDWwzsQ7kNvwHM2z-b&_nc_oc=Adrw7HvQiD9ElIo0iXteRM5K2-J8YSavk4nRlzaaDzfivGAzAtP_kLxGgyuoSqkkc44&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83FC2LMG5mWfGB8W-2ydLxw5uoyHgbNX9OeNbcsKrLbA&oe=6A466E03"}, {"file_name": "\u30b7\u30fc\u30f3\uff14_2560.png", "id": "3990206301277546", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618937_3990206304610879_381880560869317141_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Adzjr7A3zcQ7kNvwG3V30y&_nc_oc=Adr_ZTlLeDTVRR7eNJL1bqiEXRiIuPF2MHcADvKjq2u4-rC5KWh0ooEJUQRKsA_LnfM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Hcfi-eW3yjtA54HJ20e3-pLJo1FLKRFUowWwJzxNH8w&oe=6A4681F0"}, {"file_name": "\u30b7\u30fc\u30f3\uff15_2560.png", "id": "1243126824574843", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499619681_1243126827908176_1758391069480939336_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ry0S50zAHeUQ7kNvwHQ8Xhq&_nc_oc=AdpR8uYyl8LnDT50YRdv6uArzB-KG3iOih7sLrlNKBhfiNtJR6BgaRhFOfeqhNqH9Zo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GFsAyviur6NsfN9JZgUDlJ3KzXeTd7P4iNX8FobGcvg&oe=6A467E53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1974661950102370", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619680_1974661953435703_4924291664495900389_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8tXVIbY-hcQ7kNvwFJ0EII&_nc_oc=AdoJm3A0bikQW3V0Ag6vGEPhsREDTKe0AYUdwmMDlpwydZ8HqB0j1yITwYQ9Jhv_IC0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9293RTKQEegO8CWADOUChx8Tp5nK9LRNMA1m10M-NmKw&oe=6A468E93"}, "display_name": "V-Ruler", "keywords": ["ruler", "measure", "length", "surface", "area"], "long_description": "\"V-Ruler\" is a convenient tool that allows you to easily measure distances and areas in the real world.\nWhether it's the height of a door, the size of a ceiling, or the surface area of a desk\u2014just point and measure whatever catches your attention.\n\nUsing controllers or hand gestures, you can instantly measure distances and areas.\nSimply select the edge of the object you want to measure to place a pin.\nConnect two pins to measure distance, or enclose an area with pins to calculate its surface area.\nThe intuitive interface and clear visuals make it easy to adjust or delete pins as needed.\nMeasurements can be displayed in both meters and inches, so you can check values in your preferred unit.\nEven places that are typically hard to measure\u2014like the height from floor to ceiling or the total area of a room\u2014can be measured effortlessly with V-Ruler.\n\nHave you ever wondered how big the doors around you are? Or how wide the ceiling is?\nBy measuring spaces you usually overlook, you might discover small moments of surprise\u2014\n\u201cIt\u2019s more spacious than I thought,\u201d or \u201cI didn\u2019t realize it was this long.\u201d\n\nStart a new measuring experience with \"V-Ruler\".\nSmart and simple distance measurement can make your everyday life more convenient.\n\nRecommended settings before launching the app:\nSwitch boundary mode to Walking Mode\nSet up spatial data for the area where you\u2019ll be using the app", "short_description": "V-Ruler is a smart and easy tool for measuring distances and areas in your surroundings.\nFrom door heights to ceiling sizes, just point and measure.\nYou might be surprised by how spacious or long things really are.\nDiscover small moments of wonder in everyday places.\nStart your new measuring experience with V-Ruler today.\n\nRecommended settings before use:\nSet boundary mode to Walking Mode\nConfigure spatial data for your space"}]}, "developer_name": null, "developer_privacy_policy_url": "https://up-frontier.jp/metaquest3-app-privacy", "developer_terms_of_service_url": null, "publisher_name": "Up-frontier, Inc.", "support_website_url": null, "website_url": "https://up-frontier.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27437229925876834"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1398926008216267"}]}, "baseline_offer": {"id": "1398926008216267"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774485000, "status": "PUBLISHED", "id": "1398926008216267"}]}, "liveChannel": {"nodes": [{"latest_supported_binary":
.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-fhbCj1ZvMQ7kNvwEh9tUk&_nc_oc=Adq0J8MIacShRei3PAgKLhnu3w2Y9cNhu2Q-i05N0j0r8O81wRqhp_0xmhK2C_tZjtM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0N43yglYzEadBvZXKyigtihoOxR1Ff0pJ20pGRC-cMHA&oe=69F0CA08"}, {"file_name": "Casting_Screenshot_1765103537545.png", "id": "1104742181586163", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822307_1104742184919496_6120143953366972677_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gxhqp6Pt_lIQ7kNvwGfzJzI&_nc_oc=AdpVf0tcDpbeaGzFGlnVHUrD35t-yhs5JLlhyc3GCmODnFzPt9sNCSc6vVoy9HBhf14&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3kv66GL7LWQ_8YWVC46QgB262GJx4NaiUYfFJg9hmp3w&oe=69F09FCB"}, {"file_name": "Casting_Screenshot_1765103583932.png", "id": "1391095509403068", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_1391095512736401_169648631721017292_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZh_FbPFF0gQ7kNvwHYJWox&_nc_oc=Adpmca9voWJ92Bn75oqkXKHPrkdKFW8-ql_0YMbD81Ur2HvOHOD0JSqT0f_kHwuUTk0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1Wv3BzJiYiXOKIa1r_qrx0EK0KF0l0xgEvj0EwxT4xCA&oe=69F0A5AB"}, {"file_name": "Casting_Screenshot_1765103596273.png", "id": "769684419463419", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_769684422796752_6918169812731646421_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nglcruRtwlAQ7kNvwEPvGXD&_nc_oc=Adq-0eCQAHsvisCHy3DToBanfXAZODZxot2-3GTxkicEoEg6CKArBHv8Jq9cLIGcjVc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3i1-4iLiASCIEkrVljYj2l77_giu2qmCWw3zeI3yX6nA&oe=69F0C93E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master_Archer_background_16:9.png", "id": "564913840050065", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823837_564913846716731_1242383866612167287_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLNQx42bcSIQ7kNvwHcvX9v&_nc_oc=AdoolGcjCB4M__9pxHOpocAbtMutmnVzFwIVMvBV5fZrjWmfMJUbgzcDuMF_oamCOwA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2V7KQeatayv1WUYYebanAXZ9GrgjmzfE9oOqNqAqiA8g&oe=69F0C104"}, "display_name": "Master Archer: XR Multiplayer", "keywords": ["Multiplayer", "Archery", "Action", "Shooter", "Mixed"], "long_description": "**Master Archer: XR Multiplayer** brings fast, skill-based archery combat into your real environment using Mixed Reality. Any room becomes your arena as you face opponents in intense 1v1 online duels that reward precision, timing and quick movement. Realistic arrow physics and responsive tracking make every shot meaningful, turning each match into a true test of focus and accuracy.\n\n{1534642394460204}\n\nChoose from multiple modes designed for different playstyles. Compete globally in **online PvP**, create private rooms and challenge friends in **custom online matches**, or push your speed and precision in the arcade-style **Balloon Hunting** mode. If you want to refine your technique, the dedicated **Practice Tool** lets you experiment, improve aim and build consistency without pressure.\n\n{1383744146622980}\n\nMixed Reality enhances immersion by blending virtual targets and obstacles directly into your space, creating a unique sense of presence. With fast matches, smooth controls and a high skill ceiling, Master Archer offers both accessible fun and rewarding competitive depth. Draw your bow, outsmart your opponents and rise through the ranks to prove you are the true Master Archer.\n{1601166047716003}\n", "short_description": "Master Archer: XR Multiplayer is an intense VR archery experience set in mixed reality, where precision and speed decide the outcome of every duel. The game features several modes: competitive online PvP, private custom online rooms, the fast-paced Balloon Hunting challenge, and a dedicated Practice Tool for improving your aim and technique.\n\nUse your real environment through XR, master your bow skills, climb the leaderboards, and outshoot every opponent. Every match is a new test of focus."}]}, "de
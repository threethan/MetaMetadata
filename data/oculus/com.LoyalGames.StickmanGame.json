.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_j9GLFvrcDIQ7kNvwEWXfU4&_nc_oc=AdmCSVh4eFoQeh6ubtQNDsfwaY8eQdqzh4MPUF7e0Uq-UnDBM5iIsMnOMxUzxwa5D-E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afsa_mF-vXKXR4eM6fb2EjKFJvOATENbXTQrsEYg-OJAtQ&oe=69A41AC8"}, {"file_name": "Casting_Screenshot_1765103537545.png", "id": "1104742181586163", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822307_1104742184919496_6120143953366972677_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5CTPfBkAuEQ7kNvwFOn7yo&_nc_oc=AdltQ0Nz_-4igLS8cMknJbwCenkGOpi4Qwyc8OctE0X9MEGIg3gakYfvjNPpU7Tr8ek&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvrtMwBU15aZQShDl0jyeuA_SGZi_cQKIafVK5S2AYIIQ&oe=69A428CB"}, {"file_name": "Casting_Screenshot_1765103583932.png", "id": "1391095509403068", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823746_1391095512736401_169648631721017292_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKf1_XxWsXUQ7kNvwFMiiHF&_nc_oc=AdmVBzlg5fSk-KWWHqWcIBAWbz9NMDgTYagT8lpnpTSzto0kvXkrv7MuSY7WoCktkD0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftMhMulExeQxHHa4hKgTKH0DIqUUoXbwAvxuNC0kog14Q&oe=69A42EAB"}, {"file_name": "Casting_Screenshot_1765103596273.png", "id": "769684419463419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818860_769684422796752_6918169812731646421_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Myhw7pESEboQ7kNvwE9q6DL&_nc_oc=AdnvZnuGQnjr11AaJJ4EQdIP0--xa-TQu8H4UlcUe9JHHZDiwVud8hB_Lha8PazGmgk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu661FLiZ40CHxhlYq85TeAIlt0C7224ZMbA0HHrY4zPQ&oe=69A4523E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master_Archer_background_16:9.png", "id": "564913840050065", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_564913846716731_1242383866612167287_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VAE5eRd2bsMQ7kNvwGcolI4&_nc_oc=Adms5NrhPpx4jufb-u5CmWMMRGHB-mopyiUVXEAu09MVaCygO0TJvWiV_sxUAEIfGUg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuUFH8UXhC1D6-g_dxWfTtLNoSFt_EFFu56DuaF47UtuA&oe=69A44A04"}, "display_name": "Master Archer: XR Multiplayer", "keywords": ["Multiplayer", "Archery", "Action", "Shooter", "Mixed"], "long_description": "**Master Archer: XR Multiplayer** brings fast, skill-based archery combat into your real environment using Mixed Reality. Any room becomes your arena as you face opponents in intense 1v1 online duels that reward precision, timing and quick movement. Realistic arrow physics and responsive tracking make every shot meaningful, turning each match into a true test of focus and accuracy.\n\n{1534642394460204}\n\nChoose from multiple modes designed for different playstyles. Compete globally in **online PvP**, create private rooms and challenge friends in **custom online matches**, or push your speed and precision in the arcade-style **Balloon Hunting** mode. If you want to refine your technique, the dedicated **Practice Tool** lets you experiment, improve aim and build consistency without pressure.\n\n{1383744146622980}\n\nMixed Reality enhances immersion by blending virtual targets and obstacles directly into your space, creating a unique sense of presence. With fast matches, smooth controls and a high skill ceiling, Master Archer offers both accessible fun and rewarding competitive depth. Draw your bow, outsmart your opponents and rise through the ranks to prove you are the true Master Archer.\n{1601166047716003}\n", "short_description": "Master Archer: XR Multiplayer is an intense VR archery experience set in mixed reality, where precision and speed decide the outcome of every duel. The game features several modes: competitive online PvP, private custom online rooms, the fast-paced Balloon Hunting challenge, and a dedicated Practice Tool for improving your aim and technique.\n\nUse your real environment through XR, master your bow skills, climb the leaderboards, and outshoot every opponent. Every match is a new test of focus."}]}, "de
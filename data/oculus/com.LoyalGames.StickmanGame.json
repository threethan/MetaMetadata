393271", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825481_2383723092059937_1807172818959500658_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-fhbCj1ZvMQ7kNvwEq0M7Q&_nc_oc=Adq0FBXlAjfRTCakN9RplKUSTunwRyQD44Js-0qMD4aqtzzmg5XSoZ8ipG6APASGY4k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0IQKs-qUYlfkjJWeNzOguLPZPZLIYBBvqmxyzb900Fog&oe=69F21B88"}, {"file_name": "Casting_Screenshot_1765103537545.png", "id": "1104742181586163", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822307_1104742184919496_6120143953366972677_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gxhqp6Pt_lIQ7kNvwHWk6PM&_nc_oc=Ado0iqlT1twPMvabuHqkgXrglS6VZV0C2Yo19cJonPDVC7cE23blIbEy_rDCzRbDDpM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3SgVcoQp_l9f8MiV87cLWeYDZeYyLDShU_mn9fz7e5bQ&oe=69F1F14B"}, {"file_name": "Casting_Screenshot_1765103583932.png", "id": "1391095509403068", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823746_1391095512736401_169648631721017292_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kyyrjfe_BRgQ7kNvwEwUhW0&_nc_oc=AdoB_ARFCySc39Pj7QU5VXWH27RAsowggClyLqkrJC5N9WcQDBuLHtRbejF9xHPq6u0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1gttTP7SvgT7AcSMcJNDZAjyYynwfbjbiDXQi5_YPaNg&oe=69F1F72B"}, {"file_name": "Casting_Screenshot_1765103596273.png", "id": "769684419463419", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818860_769684422796752_6918169812731646421_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zICD0tYkUbEQ7kNvwGTRnRp&_nc_oc=AdqncxWdlr6fKtIkeOm7LFAiw0MtYEND6bqFl2MiOIFTJWuDuktmaXm4J-SiDfy-kGE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2JwmqkS4jz1SyzgTYeygAdFz1XpM9PuQYVMw8YaVheRg&oe=69F21ABE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master_Archer_background_16:9.png", "id": "564913840050065", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823837_564913846716731_1242383866612167287_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qb-vFq_jbWQQ7kNvwHpvahL&_nc_oc=AdqAYRwJAf8k-Kt3KGIYLAwdpoZsijU2gdIEt91NIDTfIlMc6e_mpcR0Gjuj4O0y4dw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2pQ7dd_dhIn6cFbNE70z3m9D5rsT1ZKO2YaZWCSX77eA&oe=69F21284"}, "display_name": "Master Archer: XR Multiplayer", "keywords": ["Multiplayer", "Archery", "Action", "Shooter", "Mixed"], "long_description": "**Master Archer: XR Multiplayer** brings fast, skill-based archery combat into your real environment using Mixed Reality. Any room becomes your arena as you face opponents in intense 1v1 online duels that reward precision, timing and quick movement. Realistic arrow physics and responsive tracking make every shot meaningful, turning each match into a true test of focus and accuracy.\n\n{1534642394460204}\n\nChoose from multiple modes designed for different playstyles. Compete globally in **online PvP**, create private rooms and challenge friends in **custom online matches**, or push your speed and precision in the arcade-style **Balloon Hunting** mode. If you want to refine your technique, the dedicated **Practice Tool** lets you experiment, improve aim and build consistency without pressure.\n\n{1383744146622980}\n\nMixed Reality enhances immersion by blending virtual targets and obstacles directly into your space, creating a unique sense of presence. With fast matches, smooth controls and a high skill ceiling, Master Archer offers both accessible fun and rewarding competitive depth. Draw your bow, outsmart your opponents and rise through the ranks to prove you are the true Master Archer.\n{1601166047716003}\n", "short_description": "Master Archer: XR Multiplayer is an intense VR archery experience set in mixed reality, where precision and speed decide the outcome of every duel. The game features several modes: competitive online PvP, private custom online rooms, the fast-paced Balloon Hunting challenge, and a dedicated Practice Tool for improving your aim and technique.\n\nUse your real environment through XR, master your bow skills, climb the leaderboards, and outshoot every opponent. Every match is a new test of focus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lemongames.studio/privacy-policy/", "developer_terms_of_service_url": "https://lemongames.studio/terms-of-service-terms-conditions/", "publisher_name": "Loyal Lemon Sp z o o", "support_website_url": null, "website_url": "https://lemongames.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "33607417048843511"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33807154562203091", "version": "1.0.0.1"}, "id": "1619122328798790", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29917620531156533", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33807154562203091"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name":
.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5lRao9NLm8Q7kNvwGJbPOp&_nc_oc=AdkICwjyDtHMxdWdlBjnjLk7KhhG1DACt-FNMwQeJ9WZGRaR8-M3yytombJe1KguWvo&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfutNjihsupsV2m7345jpWhhbK-66NgldzRnslLCqIYO6Q&oe=69A177C8"}, {"file_name": "Casting_Screenshot_1765103537545.png", "id": "1104742181586163", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491822307_1104742184919496_6120143953366972677_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kRb-2c-Qx8Q7kNvwF5YmWM&_nc_oc=Adn9gD9ZqK1gbMIyfBv4-gN46oU3wdQepPuvA7o0gRenQWi9Y2oY6R4cLD1xkgywcq4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfspL_73GKY1Jbh0SC0w5-lkbLGQufP0WLI_WAFAEeMRlg&oe=69A185CB"}, {"file_name": "Casting_Screenshot_1765103583932.png", "id": "1391095509403068", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/491823746_1391095512736401_169648631721017292_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_81kcZnssO4Q7kNvwFFoSPY&_nc_oc=AdkDY3494C9IQcd34ZMK5afL4xRnmnuRV-B831KvrrzE3nlgOtQoBSG61M9zg8bLSPI&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AftF1L78I8dG8bPOeTGD1jeT20Qd6HxNSfEGzvZPsDPTAQ&oe=69A18BAB"}, {"file_name": "Casting_Screenshot_1765103596273.png", "id": "769684419463419", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491818860_769684422796752_6918169812731646421_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16qNGzAgg0kQ7kNvwEhbUEa&_nc_oc=AdnBPty8Do4K5FAhb-tLscafw9NOekfZodAxT3jifoUG4GFhjQR64VLrIQ5ZLRjEK0I&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuIr2LVrtGPaW0EBmn-OpJE51SrV_z5qYZeGmkS3z3Irw&oe=69A176FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master_Archer_background_16:9.png", "id": "564913840050065", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491823837_564913846716731_1242383866612167287_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vARQtIItx2QQ7kNvwHGWHqP&_nc_oc=AdkZV6oeRTyI4cxW8OybrbYzIGQLfj4btewy1UiCk4Ywg9yEJRJq8CLhC-CA2kuJAaI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfswruajZMmRdeWEGnmeTxqMNGRT_qJDTMUlTHvNSVxhqw&oe=69A1A704"}, "display_name": "Master Archer: XR Multiplayer", "keywords": ["Multiplayer", "Archery", "Action", "Shooter", "Mixed"], "long_description": "**Master Archer: XR Multiplayer** brings fast, skill-based archery combat into your real environment using Mixed Reality. Any room becomes your arena as you face opponents in intense 1v1 online duels that reward precision, timing and quick movement. Realistic arrow physics and responsive tracking make every shot meaningful, turning each match into a true test of focus and accuracy.\n\n{1534642394460204}\n\nChoose from multiple modes designed for different playstyles. Compete globally in **online PvP**, create private rooms and challenge friends in **custom online matches**, or push your speed and precision in the arcade-style **Balloon Hunting** mode. If you want to refine your technique, the dedicated **Practice Tool** lets you experiment, improve aim and build consistency without pressure.\n\n{1383744146622980}\n\nMixed Reality enhances immersion by blending virtual targets and obstacles directly into your space, creating a unique sense of presence. With fast matches, smooth controls and a high skill ceiling, Master Archer offers both accessible fun and rewarding competitive depth. Draw your bow, outsmart your opponents and rise through the ranks to prove you are the true Master Archer.\n{1601166047716003}\n", "short_description": "Master Archer: XR Multiplayer is an intense VR archery experience set in mixed reality, where precision and speed decide the outcome of every duel. The game features several modes: competitive online PvP, private custom online rooms, the fast-paced Balloon Hunting challenge, and a dedicated Practice Tool for improving your aim and technique.\n\nUse your real environment through XR, master your bow skills, climb the leaderboards, and outshoot every opponent. Every match is a new test of focus."}]}, "de
.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXFCnxMzUagQ7kNvwECfYeH&_nc_oc=AdlLQXgzDBp_-AHowC-rQqVXECFd-VJr_GpJSXM_v8ig0WcZMLigopD3QpOTy4l4lD0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsGd-A1Aj58FEVdDOm6eKsmhTZClzpQUTG5OSTz6rHf_g&oe=699ED4C8"}, {"file_name": "Casting_Screenshot_1765103537545.png", "id": "1104742181586163", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822307_1104742184919496_6120143953366972677_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Y9stUUr5rcQ7kNvwGMJATu&_nc_oc=AdmlhbeGWsL3ixIlOuw5lICJSST-2ObtvqwaeIyxJoNY3TWcT7e_rbN5lDjWaN2NXVI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfufDRjDsJfD53f0T6dVrbL2vXKs-oYZIdPF14cVcdY93g&oe=699EE2CB"}, {"file_name": "Casting_Screenshot_1765103583932.png", "id": "1391095509403068", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823746_1391095512736401_169648631721017292_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_81kcZnssO4Q7kNvwEKla_t&_nc_oc=Adnf0AZ0EiWqId6prai_bIiWh0CzauFL8FEgrF4-lyqepP6k2Xfg7FF8NZEHfVtQDn0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu2wVAFrClxCh19qfYoYs1zLq_kW4oOFmtsuBGpVXSeuQ&oe=699EE8AB"}, {"file_name": "Casting_Screenshot_1765103596273.png", "id": "769684419463419", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818860_769684422796752_6918169812731646421_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16qNGzAgg0kQ7kNvwGWTj1F&_nc_oc=AdnIZ9pJjxBc4tCCoJXu4-EGOfEobzitcLB243r92TcpO7Wz9CK2fWfGO_7WrWGAb4E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afse1nE3zNzVgmIpNfgA4BFQjFNSsQIqz9QHRxTyk4z_Qw&oe=699ED3FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master_Archer_background_16:9.png", "id": "564913840050065", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823837_564913846716731_1242383866612167287_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vARQtIItx2QQ7kNvwGy4TWL&_nc_oc=AdmKApz8IBlBtumlTTr6pvRkRPTPLdSLaIeUJh_bSr9WUjBJpso4qKzgAajSCv8Vqpo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuaBWeYMGHQMbTJVtZ-U14BHfxwoW4Fp8novS_AHV8mmQ&oe=699F0404"}, "display_name": "Master Archer: XR Multiplayer", "keywords": ["Multiplayer", "Archery", "Action", "Shooter", "Mixed"], "long_description": "**Master Archer: XR Multiplayer** brings fast, skill-based archery combat into your real environment using Mixed Reality. Any room becomes your arena as you face opponents in intense 1v1 online duels that reward precision, timing and quick movement. Realistic arrow physics and responsive tracking make every shot meaningful, turning each match into a true test of focus and accuracy.\n\n{1534642394460204}\n\nChoose from multiple modes designed for different playstyles. Compete globally in **online PvP**, create private rooms and challenge friends in **custom online matches**, or push your speed and precision in the arcade-style **Balloon Hunting** mode. If you want to refine your technique, the dedicated **Practice Tool** lets you experiment, improve aim and build consistency without pressure.\n\n{1383744146622980}\n\nMixed Reality enhances immersion by blending virtual targets and obstacles directly into your space, creating a unique sense of presence. With fast matches, smooth controls and a high skill ceiling, Master Archer offers both accessible fun and rewarding competitive depth. Draw your bow, outsmart your opponents and rise through the ranks to prove you are the true Master Archer.\n{1601166047716003}\n", "short_description": "Master Archer: XR Multiplayer is an intense VR archery experience set in mixed reality, where precision and speed decide the outcome of every duel. The game features several modes: competitive online PvP, private custom online rooms, the fast-paced Balloon Hunting challenge, and a dedicated Practice Tool for improving your aim and technique.\n\nUse your real environment through XR, master your bow skills, climb the leaderboards, and outshoot every opponent. Every match is a new test of focus."}]}, "de
87.png", "id": "2383723085393271", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825481_2383723092059937_1807172818959500658_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVrJGvIiQK0Q7kNvwG88tfp&_nc_oc=AdqRsj7QEwZfaitLIjoSEVlm-l9Ht1UND-pqfLRY8nw_4vjizVxrFNhaQMpviqBNNyA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCF1DHFICwUtGTWD1qfxfsnGAAqLXB0dLgVL19b8v_NWw&oe=6A579F08"}, {"file_name": "Casting_Screenshot_1765103537545.png", "id": "1104742181586163", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822307_1104742184919496_6120143953366972677_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhaEFehRZZ8Q7kNvwHIUsO5&_nc_oc=AdpKdZysz2fQ8v8lB9pzyfVg7K8BdNkswVibOe-qm2dZLN0TWBiiZqk5mmqm3UBTqpU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBR9mN5cJZ634sKZJDjDgKlYGXoVA6kQ2AzoAwRCWdVmw&oe=6A5774CB"}, {"file_name": "Casting_Screenshot_1765103583932.png", "id": "1391095509403068", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_1391095512736401_169648631721017292_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-b7nfuq_A0AQ7kNvwGLRpHC&_nc_oc=AdqZWlxH5XU2BfJrz-TmiMe3rt7J8goCxJkLaP80XHjEM6tkIwAJmMfNbgJpiNXLBrE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaeqlC32QZtxg2OZqrYvYi6LzsK3Mo04rImbUcX0WAdg&oe=6A577AAB"}, {"file_name": "Casting_Screenshot_1765103596273.png", "id": "769684419463419", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_769684422796752_6918169812731646421_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhWQxkBkWRQQ7kNvwHoB7iJ&_nc_oc=Adq0gL3TMa8OlpX7XMGKBPsmY5n7vh47xLrDPPtomtD_S7sFTDCcFthAlcehqyUiyzA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGcIaWHmtmSj0GFCSvz9uDes0-zKc0bsSLqxtIlxBcpg&oe=6A579E3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master_Archer_background_16:9.png", "id": "564913840050065", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823837_564913846716731_1242383866612167287_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jC8RqD-4uhgQ7kNvwEUAwAh&_nc_oc=Adr5mDKw79_XLF7TGMEMraEBUVXw_ORp-L0zOXZRUYxFPKICsBb50-N6-_SEWmuSb04&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqRaYBnIcs6lD3lfeSIUNbYSBHAmvrhS9Gd-KMyPbkeg&oe=6A579604"}, "display_name": "Master Archer: XR Multiplayer", "keywords": ["Multiplayer", "Archery", "Action", "Shooter", "Mixed"], "long_description": "**Master Archer: XR Multiplayer** brings fast, skill-based archery combat into your real environment using Mixed Reality. Any room becomes your arena as you face opponents in intense 1v1 online duels that reward precision, timing and quick movement. Realistic arrow physics and responsive tracking make every shot meaningful, turning each match into a true test of focus and accuracy.\n\n{1534642394460204}\n\nChoose from multiple modes designed for different playstyles. Compete globally in **online PvP**, create private rooms and challenge friends in **custom online matches**, or push your speed and precision in the arcade-style **Balloon Hunting** mode. If you want to refine your technique, the dedicated **Practice Tool** lets you experiment, improve aim and build consistency without pressure.\n\n{1383744146622980}\n\nMixed Reality enhances immersion by blending virtual targets and obstacles directly into your space, creating a unique sense of presence. With fast matches, smooth controls and a high skill ceiling, Master Archer offers both accessible fun and rewarding competitive depth. Draw your bow, outsmart your opponents and rise through the ranks to prove you are the true Master Archer.\n{1601166047716003}\n", "short_description": "Master Archer: XR Multiplayer is an intense VR archery experience set in mixed reality, where precision and speed decide the outcome of every duel. The game features several modes: competitive online PvP, private custom online rooms, the fast-paced Balloon Hunting challenge, and a dedicated Practice Tool for improving your aim and technique.\n\nUse your real environment through XR, master your bow skills, climb the leaderboards, and outshoot every opponent. Every match is a new test of focus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lemongames.studio/privacy-policy/", "developer_terms_of_service_url": "https://lemongames.studio/terms-of-service-terms-conditions/", "publisher_name": "Loyal Lemon Sp z o o", "support_website_url": null, "website_url": "https://lemongames.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "33607417048843511"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33807154562203091", "version": "1.0.0.1"}, "id": "1619122328798790", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29917620531156533", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33807154562203091"}, "release_status": "R
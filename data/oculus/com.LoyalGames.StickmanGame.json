87.png", "id": "2383723085393271", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825481_2383723092059937_1807172818959500658_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBim9e7CfOwQ7kNvwGu5qfb&_nc_oc=AdpbBLgdyY3qrJBPVOHUCCFkw1esODgTyfmCCjxUtK5_E2frC7kPgJo6KqqZDBIThZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAnZo2W2Odc8VvhtRO7tJuHXTFCXbzGtjLiar5PtkdXg&oe=6AA80A88"}, {"file_name": "Casting_Screenshot_1765103537545.png", "id": "1104742181586163", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822307_1104742184919496_6120143953366972677_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrnOo27XTVwQ7kNvwFDE6Qx&_nc_oc=AdpmrinlUD5XvXN16JFQ7712e9W6wQ6TPyeUVNq94OWG1RjyMue6gueMSF1aoX-ZLB0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGaGvKz8xkH5wGbMeNlZKEWZiZDn55VDyYNzaJ8QQSXA&oe=6AA8188B"}, {"file_name": "Casting_Screenshot_1765103583932.png", "id": "1391095509403068", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_1391095512736401_169648631721017292_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ee2DyRrdSsQ7kNvwHIuCBA&_nc_oc=AdpPH2UarlluxfE3hw2c45qQAfiMtV8ymGos3JN1K-si8YRRJ7QuPXuzTgCxb8DJJLQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsgBSDVWp5j7CsIBYtuwvmGHiKhKwrux81QtabBOXu9A&oe=6AA7E62B"}, {"file_name": "Casting_Screenshot_1765103596273.png", "id": "769684419463419", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_769684422796752_6918169812731646421_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIXiLwK_tPMQ7kNvwGPFHx0&_nc_oc=Ado76MMIFHVeu_SJ9JGbr4TkcJAj_K6x4h09z8QqDZk8DIWe4nvZg5sOFTHTs0z4Tn8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzHZk0lQCmKW_2awV7sisHpUwEDrbfyeD6pkgzfb0F0g&oe=6AA809BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master_Archer_background_16:9.png", "id": "564913840050065", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823837_564913846716731_1242383866612167287_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqRpkshzU3AQ7kNvwEmME93&_nc_oc=AdoJ2EMGSPauA6XoyJ9jUfQBfGNyyPH9e_d8yeTWQ31BoAxguwBCeG21wNRnTO1jH2k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHHW2NRBb_ONr6MET7lKCrOjRYfAglWqnW_3wQVeGlUg&oe=6AA80184"}, "display_name": "Master Archer: XR Multiplayer", "keywords": ["Multiplayer", "Archery", "Action", "Shooter", "Mixed"], "long_description": "**Master Archer: XR Multiplayer** brings fast, skill-based archery combat into your real environment using Mixed Reality. Any room becomes your arena as you face opponents in intense 1v1 online duels that reward precision, timing and quick movement. Realistic arrow physics and responsive tracking make every shot meaningful, turning each match into a true test of focus and accuracy.\n\n{1534642394460204}\n\nChoose from multiple modes designed for different playstyles. Compete globally in **online PvP**, create private rooms and challenge friends in **custom online matches**, or push your speed and precision in the arcade-style **Balloon Hunting** mode. If you want to refine your technique, the dedicated **Practice Tool** lets you experiment, improve aim and build consistency without pressure.\n\n{1383744146622980}\n\nMixed Reality enhances immersion by blending virtual targets and obstacles directly into your space, creating a unique sense of presence. With fast matches, smooth controls and a high skill ceiling, Master Archer offers both accessible fun and rewarding competitive depth. Draw your bow, outsmart your opponents and rise through the ranks to prove you are the true Master Archer.\n{1601166047716003}\n", "short_description": "Master Archer: XR Multiplayer is an intense VR archery experience set in mixed reality, where precision and speed decide the outcome of every duel. The game features several modes: competitive online PvP, private custom online rooms, the fast-paced Balloon Hunting challenge, and a dedicated Practice Tool for improving your aim and technique.\n\nUse your real environment through XR, master your bow skills, climb the leaderboards, and outshoot every opponent. Every match is a new test of focus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lemongames.studio/privacy-policy/", "developer_terms_of_service_url": "https://lemongames.studio/terms-of-service-terms-conditions/", "publisher_name": "Loyal Lemon Sp z o o", "support_website_url": null, "website_url": "https://lemongames.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "33607417048843511"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33807154562203091", "version": "1.0.0.1"}, "id": "1619122328798790", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29917620531156533", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33807154562203091"}, "release_status": "R
1&_nc_oc=AdrELza3yVzvIKMtjs82Z9vJWNTV4QWl4BLkS-ccs8BJBH_H7QAs7eRL_NCLFSJgsYA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqa4wWmKe6cJvRxV7ze2iSmNWsmJviqpiuQcrVzTuekw&oe=6AF8AAC3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stuff: Horror", "keywords": ["Horror", "Sandbox", "Backrooms", "Liminal", "Multiplayer"], "long_description": "# \ud83d\udd79\ufe0f Stuff **Multiplayer Horror Action**\n\n# \ud83d\udc80 Beware the Monsters\nHorrifying creatures lurk around every corner. Run, hide, or fight \u2014 the choice\nis yours.\n# \u2694\ufe0f PvP and Weapon Collection\nEvery battle is a chance to prove who the true survivor is.\n{868646472513144}\n\n# \ud83e\uddf0 Explore and Interact\nDiscover and use 40+ unique items \u2014 from tools to rare artifacts that can save your life or change the course of the game.\n# \ud83c\udfae Play Together\nTeam up with friends or survive alone \u2014 your fate depends on your decisions.\n{821277124055890}", "short_description": "\ud83d\udd79\ufe0f Stuff\nDive into a world of fear and survival!\nExplore a vast map, collect valuable items, and trade them for in-game currency. Run from terrifying monsters or team up with friends to stay alive.\nDiscover 4+ unique locations \u2014 warehouses, sewers, and caves \u2014 over 40 interactive items, and 20+ weapons for intense PvP battles. Prove you can survive the night!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/stuff-horror/8d6cccb4-3fd2-4fb0-8f80-caa5b17e4fa4/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/terms-of-use/243fb74c-0c41-4be5-aa39-0b75aecf2f7d/privacy", "publisher_name": "Jus Team", "support_website_url": null, "website_url": "https://bogcde.github.io/jusTeamHiPage/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
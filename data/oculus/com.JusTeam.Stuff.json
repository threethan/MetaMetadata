!\nExplore a vast map, collect valuable items, and trade them for in-game currency. Run from terrifying monsters or team up with friends to stay alive.\nDiscover 4+ unique locations \u2014 warehouses, sewers, and caves \u2014 over 40 interactive items, and 20+ weapons for intense PvP battles. Prove you can survive the night!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/stuff-horror/8d6cccb4-3fd2-4fb0-8f80-caa5b17e4fa4/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/terms-of-use/243fb74c-0c41-4be5-aa39-0b75aecf2f7d/privacy", "publisher_name": "Jus Team", "support_website_url": null, "website_url": "https://bogcde.github.io/jusTeamHiPage/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26442265988697095"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1726678221333759"}, {"status": "PENDING", "id": "1186168770158742"}]}, "baseline_offer": {"id": "1726678221333759"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1766095200, "status": "PUBLISHED", "id": "1726678221333759"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29992228150367510", "version": "15.69"}, "id": "144
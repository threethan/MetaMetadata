-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1J7OyaTW9xQODbNFAfLTbagB3_owEIByVOWQE-oKtsGA&oe=69F4A6D4"}, {"file_name": "VRaum-Meet_Screen-Shot_5.png", "id": "959261145232850", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75236136_959261151899516_1402472634186579841_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEnB0LSL3BgQ7kNvwHHcHEH&_nc_oc=AdoFlbVoSUPPD0r7ApbtQnF-lazGBREl5PP6lvWKHGwC9TLvLzRb5ueAvRegld4ktIg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_ukd6T2TmBqVkr2HGuRTfFwopOKR7VDQphz1efpR-Gw&oe=69F497F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverLandscape.png", "id": "592435376120251", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982715_592435379453584_8057301181136921699_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=neYdcXQ6LtgQ7kNvwFkiFan&_nc_oc=AdqO-VnVFQLP0IyAFyeqUtpTL5iHukgJKGxt2XKpfIoZ8aWA56zCWmPD6IBtDhUBz5o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2FLtYrsbGqfrRnxdI4JhOC2IrNJlQBhOPJTLZolr9-MA&oe=69F4C683"}, "display_name": "VRaum Meet", "keywords": [], "long_description": "Convenient Meetings Anywhere\nMeet with your colleagues in virtual spaces. You can converse with your fellow workers far away as if they were right next to you. Start a meeting wherever you are. Avatar's facial expressions will help you communicate more naturally.\n\nEffective Tools to Assist Work\nUse various widgets to quickly and easily get your work done in virtual spaces. You can download your files by remotely accessing your personal PC. Attend your virtual meetings conveniently through various platforms.", "short_description": "Welcome to the virtual space specifically designed for remote meetings. Collaborate with your colleagues using virtual avatars in VRaum Meet! Start conversation with your colleagues as if they were right next to you, even when working remotely."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meet.vraum.me/Privacy%20Policy_VRaum%20Meet.pdf", "developer_terms_of_service_url": null, "publisher_name": "Immersivecast", "support_website_url": null, "website_url": "https://meet.vraum.me/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1591891807904800"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "791995579015977"}]}, "baseline_offer": {"id": "791995579015977"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1683218427, "status": "PUBLISHED", "id": "791995579015977"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6191901267565449", "version": "1.5.4"}, "id": "1853754981668281", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6047746898647554", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6191901267565449"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1853754981668281"}]}, "change_log": null, "created_date": 1683186813, "id": "6191901267565449", "version": "1.5.4", "version_code": 57, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id"
cdn.com&_nc_ss=7f20f&oh=00_AQHaIzMfMu2d-nlH1o0ZzNdRr72GF4BihTQZZ1Wpf0KZog&oe=6A85AAF4"}, {"file_name": "VRaum-Meet_Screen-Shot_3.png", "id": "926867435216336", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75203623_926867438549669_7790078712667243437_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kihHE8NBYaEQ7kNvwFS4xT_&_nc_oc=AdqJz45SH5E6eI8QV0RQWYZRpi0M7iV-262zx5J5StDMmwQOsTLnTE7TNACKj6aX2Hs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkj7K_p4cOwKBOuPkuDZ1_PPQXe6dSfX5q0FbRl1oyLQ&oe=6A859332"}, {"file_name": "VRaum-Meet_Screen-Shot_4.png", "id": "1381455642667467", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982700_1381455646000800_2133149388258625982_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=-mx6ZOEVMWMQ7kNvwH0hvEr&_nc_oc=AdqVr7iyL4l7cXZOUmAaUPD64CCqJaCuXwzOLOIaoIiSysSkvA0z34FYK_lYWGPzfH8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcuLX7x5MYjJSbgp4XP2Pomis1wBkRhPAdoW9OV8nMmw&oe=6A85ABD4"}, {"file_name": "VRaum-Meet_Screen-Shot_5.png", "id": "959261145232850", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75236136_959261151899516_1402472634186579841_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztPlNlW33AkQ7kNvwEWeeoZ&_nc_oc=AdqERYls0X5rXHMrHFCAZ-GZaqoCSJHlFI9f4X0k8tqDvTH4lnghcn9beMEOwMLGd3o&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCD690S1XSHeeqWhBKqk8gvYLvqU8TqhUBP055plygrw&oe=6A859CF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverLandscape.png", "id": "592435376120251", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982715_592435379453584_8057301181136921699_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUHYGlyDew4Q7kNvwEXGnet&_nc_oc=AdoRdoMoCfaa5YotblQ0NYHMn2okY0WkCbZb451vQp0cwZ5YfD2EqjL2zfdsZ_empPc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkK2E894mZKD-WsQw6a8WxEIT-3WKUGUUytQA0Ihd1bg&oe=6A859343"}, "display_name": "VRaum Meet", "keywords": [], "long_description": "Convenient Meetings Anywhere\nMeet with your colleagues in virtual spaces. You can converse with your fellow workers far away as if they were right next to you. Start a meeting wherever you are. Avatar's facial expressions will help you communicate more naturally.\n\nEffective Tools to Assist Work\nUse various widgets to quickly and easily get your work done in virtual spaces. You can download your files by remotely accessing your personal PC. Attend your virtual meetings conveniently through various platforms.", "short_description": "Welcome to the virtual space specifically designed for remote meetings. Collaborate with your colleagues using virtual avatars in VRaum Meet! Start conversation with your colleagues as if they were right next to you, even when working remotely."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vraum.me/meet/policy", "developer_terms_of_service_url": null, "publisher_name": "Immersivecast", "support_website_url": null, "website_url": "https://vraum.me/meet", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6795280307227539"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031410_886334599314965_3331485087654701037_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qruTu9vg57MQ7kNvwGmroAb&_nc_oc=AdpT1cs1Pv8AiJ6
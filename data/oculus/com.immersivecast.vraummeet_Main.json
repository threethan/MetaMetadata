zfH8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcuLX7x5MYjJSbgp4XP2Pomis1wBkRhPAdoW9OV8nMmw&oe=6A85ABD4"}, {"file_name": "VRaum-Meet_Screen-Shot_5.png", "id": "959261145232850", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75236136_959261151899516_1402472634186579841_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztPlNlW33AkQ7kNvwEWeeoZ&_nc_oc=AdqERYls0X5rXHMrHFCAZ-GZaqoCSJHlFI9f4X0k8tqDvTH4lnghcn9beMEOwMLGd3o&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCD690S1XSHeeqWhBKqk8gvYLvqU8TqhUBP055plygrw&oe=6A859CF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverLandscape.png", "id": "592435376120251", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982715_592435379453584_8057301181136921699_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUHYGlyDew4Q7kNvwEXGnet&_nc_oc=AdoRdoMoCfaa5YotblQ0NYHMn2okY0WkCbZb451vQp0cwZ5YfD2EqjL2zfdsZ_empPc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkK2E894mZKD-WsQw6a8WxEIT-3WKUGUUytQA0Ihd1bg&oe=6A859343"}, "display_name": "VRaum Meet", "keywords": [], "long_description": "Convenient Meetings Anywhere\nMeet with your colleagues in virtual spaces. You can converse with your fellow workers far away as if they were right next to you. Start a meeting wherever you are. Avatar's facial expressions will help you communicate more naturally.\n\nEffective Tools to Assist Work\nUse various widgets to quickly and easily get your work done in virtual spaces. You can download your files by remotely accessing your personal PC. Attend your virtual meetings conveniently through various platforms.", "short_description": "Welcome to the virtual space specifically designed for remote meetings. Collaborate with your colleagues using virtual avatars in VRaum Meet! Start conversation with your colleagues as if they were right next to you, even when working remotely."}]}, "developer_name": null, "developer_privacy_policy_url": "https:
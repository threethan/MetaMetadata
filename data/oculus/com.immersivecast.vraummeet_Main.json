c_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_p8F0292Xg_6TbTlm1f9G1p0kCGixOeqOx4O7R3uItzw&oe=6A230394"}, {"file_name": "VRaum-Meet_Screen-Shot_5.png", "id": "959261145232850", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75236136_959261151899516_1402472634186579841_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z23ovGGx_hsQ7kNvwGpCy93&_nc_oc=Ado7VnYtJpXvg2jIfCBRDcmtZi3JqYKQCE4Ma5c4NiQAIN89IqGldBGzh6MjbZ3rk6w&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-3coKkOE97Hx2jZtZqDjZh7xAB1Qk4cYvqqYPF--5cA&oe=6A22F4B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverLandscape.png", "id": "592435376120251", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982715_592435379453584_8057301181136921699_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uXt0dt149kQ7kNvwFb_VYr&_nc_oc=AdqIDWPmGzbmlb-TQVe149zea266NGlHxuMpLZQuIE__ezkCwuRDAa5rgRQKI6c4jU0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aMpVJQcgcO7VrXoAY0kPNAuZyi7zaUPxnsVcA0ol49g&oe=6A22EB03"}, "display_name": "VRaum Meet", "keywords": [], "long_description": "Convenient Meetings Anywhere\nMeet with your colleagues in virtual spaces. You can converse with your fellow workers far away as if they were right next to you. Start a meeting wherever you are. Avatar's facial expressions will help you communicate more naturally.\n\nEffective Tools to Assist Work\nUse various widgets to quickly and easily get your work done in virtual spaces. You can download your files by remotely accessing your personal PC. Attend your virtual meetings conveniently through various platforms.", "short_description": "Welcome to the virtual space specifically designed for remote meetings. Collaborate with your colleagues using virtual avatars in VRaum Meet! Start conversation with your colleagues as if they were right next to you, even when working remotely."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meet.vraum.me/Pr
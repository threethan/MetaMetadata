//scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036703_547154884500020_1057514946239049650_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yx7nS2RP74wQ7kNvwFlCI2a&_nc_oc=AdpX6EeSkEh6_bm9lsHkSMbEbzRlx-M5lMLDwAeiUBxKW9Adgg6LuiYRkOy7DdrxPy4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtwJc5QBntkdPuiE8Vv14saGU8Q1IUWphuGITWpNSHBg&oe=6ADF535C"}, {"file_name": "SSVR_Screenshot_5.png", "id": "844024577847278", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031335_844024584513944_2157433220101409974_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74yy3PRoqkMQ7kNvwFNKVbe&_nc_oc=AdoH5NWUfdfdNqWi6LmpblutN1MD9GQTGvDGKlA70FhbuF0ec-kDQ6M_2So0lP-n0TQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5Av6b_CCFi41Eg8rvjRoBs8tjLN1p1vhoQ3EzhTcjdg&oe=6ADF450A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Trailer_Cover_2560x1440.png", "id": "954160626742817", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974803_954160630076150_5739559737043376528_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Usp5ZG3maN4Q7kNvwEjKhGI&_nc_oc=AdptQGuJsvRjxRSQny1Opk4c--eIWuMEZ-vOBC29NlqXovI9-G3GUlM8iIsagNyRIzk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBIf2idFWMoE1qL6H4aVLSk5uU-0VHd9Zml7Np9HNk9A&oe=6ADF4E15"}, "display_name": "SkyStrikers", "keywords": ["sport", "pvp", "action", "social"], "long_description": "# New Level of Competitive VR Sports\n\n\n**SkyStrikers** is a fast-paced, high-skill VR competition where every move counts. With physics-driven mechanics and real-time positioning, you'll need precision and teamwork to succeed. Choose from unique suit classes, each with special abilities designed for offense, defense, or control, and work with your team to dominate the arena. Whether rocket-jumping across the field or timing the perfect strike, Sky Strikers delivers the intensity of real-world sports in a thrilling virtual experience!\n{973578628117862}\n\n\n# Features\n\n\n**- Immersive VR Sports Action**: Experience the intensity of competitive aerial sports in virtual reality, where every play requires precision and skill.\n{552734413807834}\n**- Social Hub for Multiplayer Fun**: Meet up with friends in the Sky Strikers Social Hub, where up to 10 players can participate in casual games like Volleyball, The Floor is Lava, and HollowHoops.\n {520436050872564}\n**- Ranked 3v3 Matchmaking**: Test your skills in Skyball matches inside The Dome. Climb the leaderboards, earn your spot in the Hall of Heroes, and be immortalized as a top player.\n{462621563496060}\n**- Unique Classes & Abilities**: Choose from different suit classes, each offering distinct abilities like rocket boosters and game-changing moves to help your team win.\n\n**- Strategic Team Play**: Work together with your teammates, combining class abilities and tactics to outmaneuver your opponents.\n\n**- Aerial Maneuvers**: Master gravity-defying moves, soaring through the air to make the perfect play.\n{937728998237846}\n{1060957431919550}", "short_description": "SkyStrikers is a fast-paced, high-skill VR competition where every move counts. With physics-driven mechanics and real-time positioning, you'll need precision and teamwork to succeed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chamber8.gg/#/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chamber8 Studio", "support_website_url": null, "website_url": "https://chamber8.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "support
_sid=6e7a0a&_nc_ohc=ioYHUe7kqYgQ7kNvwEe796E&_nc_oc=AdovXW0psPuYw9cCpH30jCq5v4UKK4rGMaPTRnLCfeTofvXDXE3KOZ6XhLeR-mLOnbM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbtYDts-SQX27D1d-7s1Jza8_uY90H7X4TF8lDsh4hsg&oe=6AFB4C10"}, {"file_name": "vlcsnap-2024-09-06-18h32m26s611.png", "id": "547154881166687", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036703_547154884500020_1057514946239049650_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RQ_xta9MnYQ7kNvwFYKKd4&_nc_oc=AdrW8W7TO6k4-ii8GFis1QYiIwKLRLJqw3qGZdvLLZJL577ekCux2qVnHfYQ3NCyhtw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9FAKZnka2_bjWgmbiSWBuOh59E67wDRO-bjPLfGD2jQ&oe=6AFB3B1C"}, {"file_name": "SSVR_Screenshot_5.png", "id": "844024577847278", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031335_844024584513944_2157433220101409974_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n45DHHl1LhEQ7kNvwHxJ9VT&_nc_oc=AdpShvR4Aahga2CWdE6GehKsBTNUZ0Dhz6JlrLGzIhWc3VbsxpN7Fh2VWFQ8UNLwb58&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR30tclcqLB6Y0P5I6AUImjGF_7yH6HPPz_WumBgkSvUw&oe=6AFB2CCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Trailer_Cover_2560x1440.png", "id": "954160626742817", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974803_954160630076150_5739559737043376528_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJbeJDFw5jMQ7kNvwEfbStd&_nc_oc=AdrykEml38ZTJDyyFnrQH-f3zdkgOUCYc6c46btHWUbe9RcDernn3CeeUjtGieyO3y8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFQiO5Mi-A_0ouZedigI1EAbkAebHZtcXiHHaAD_0itg&oe=6AFB35D5"}, "display_name": "SkyStrikers", "keywords": ["sport", "pvp", "action", "social"], "long_description": "# New Level of Competitive VR Sports\n\n\n**SkyStrikers** is a fast-paced, high-skill VR competition where every move counts. With physics-driven mechanics and real-time positioning, you'll need precision and teamwork to succeed. Choose from unique suit classes, each with special abilities designed for offense, defense, or control, and work with your team to dominate the arena. Whether rocket-jumping across the field or timing the perfect strike, Sky Strikers delivers the intensity of real-world sports in a thrilling virtual experience!\n{973578628117862}\n\n\n# Features\n\n\n**- Immersive VR Sports Action**: Experience the intensity of competitive aerial sports in virtual reality, where every play requires precision and skill.\n{552734413807834}\n**- Social Hub for Multiplayer Fun**: Meet up with friends in the Sky Strikers Social Hub, where up to 10 players can participate in casual games like Volleyball, The Floor is Lava, and HollowHoops.\n {520436050872564}\n**- Ranked 3v3 Matchmaking**: Test your skills in Skyball matches inside The Dome. Climb the leaderboards, earn your spot in the Hall of Heroes, and be immortalized as a top player.\n{462621563496060}\n**- Unique Classes & Abilities**: Choose from different suit classes, each offering distinct abilities like rocket boosters and game-changing moves to help your team win.\n\n**- Strategic Team Play**: Work together with your teammates, combining class abilities and tactics to outmaneuver your opponents.\n\n**- Aerial Maneuvers**: Master gravity-defying moves, soaring through the air to make the perfect play.\n{937728998237846}\n{1060957431919550}", "short_description": "SkyStrikers is a fast-paced, high-skill VR competition where every move counts. With physics-driven mechanics and real-time positioning, you'll need precision and teamwork to succeed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chamber8.gg/#/privacy", "developer_terms_of_service_url": null, "publisher_name": "Chamber8 Studio", "support_website_url": null, "website_url": "https://chamber8.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context
id=6e7a0a&_nc_ohc=Fsip_GZZMpcQ7kNvwHfplbs&_nc_oc=AdpL80cBKkqd-cml85XIlDsTIEG446MJIhPu6EbCIXzm8nqnFmAaPix1OJ8ofzbYFX8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHonrvRLyicbmA6aEhnmWN1N_E6VMrL-qKDhF-hsUk-g&oe=6AEB5281"}, {"file_name": "shot3-in-the-park-2560x1440.png", "id": "1267552208795199", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596168449_1267552215461865_3287969712779672387_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEbszMz10mwQ7kNvwF57VRr&_nc_oc=AdplS1wGFkmlVzV6M0Z9XtgMfDELMf58ymiCVCcABg-a0pn_pPymuCanAqqV-lUQnMU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-WhbSgx3pHbx5QJhw3InQuRKdYl9msnR-_GApKqnA_g&oe=6AEB4638"}, {"file_name": "shot4-the-gate-2560x1440.png", "id": "1365583112408430", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/786297305_1365583115741763_7605621278133427600_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJcy42lbnKQQ7kNvwFh1pHB&_nc_oc=AdphzTk6yanxNNoy4AhE-f2qsQcGUb7Xn6StJwmC-AoFrm4VaOE5KCH3XrFqPS68gJY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeSRESG6dYv3WGJjTplzXtEpBo40i-HKei3X_jPWyAYg&oe=6AEB3B49"}, {"file_name": "shot5-ball-field-2560x1440.png", "id": "1123371563585027", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673759338_1123371566918360_4737379732877043415_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRh5AqbSiHoQ7kNvwGSaKo5&_nc_oc=Adr6mu4nu59Syi8zbg-IkMkoT62H7K667h-erCT2Faar1XeDvwUeXHf2giBTz8O3Gco&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPnZuT7k-HBsnrC8DinSlq_NfAWQxcnfT0T50wROxr4Q&oe=6AEB5155"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1010953301951591", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595129854_1010953305284924_1966249931642140231_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6M8H4aXSC8YQ7kNvwGTOLP0&_nc_oc=AdpDR8DW3H-Gl-1Zvd67HdPT2eL6Yivv8pTJvptoXYzxnzYujiykyuHxtKtEw4zS87g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHfBTEGdx8INnyuVAcx6UO4sW5CxeNLAvGZk3coBDolQ&oe=6AEB56BB"}, "display_name": "Batting Cage", "keywords": ["baseball", "batting", "cage", "sports", "park"], "long_description": "Batting Cage puts you in lane one of a city park's cages on a warm afternoon, with the bat in your hand from the first second. No rack, no menus to fight.\n\nThe machine at the far end feeds you a pitch every few seconds down a real forty-foot lane. Swing through it and the ball comes off the bat the way it should - and the last five balls you hit stay lying on the turf where they landed.\n\nPick your game from the board by the gate. FREE CAGE to just hit. INNING for nine pitches and three outs. HOME RUN DERBY against the clock. ALL-STAR, where the machine speeds up every time you connect. Four speeds, from ROOKIE at 35 mph to ALL-STAR at 70 - the same numbers painted on the lane signs.\n\nHold B or Y and the world drops into slow motion so you can meet the ball, then snaps back the instant you hit it.\n\nAnd it is a real place, not a booth. Walk out through the gate into the park: the mown lawn, the paths, the plane trees, the little-league backstop and the handball court. There is a snack bar, a flag on the pole, and a block of walk-ups across the avenue.\n\nFEATURES\n- Four netted lanes on a park pad, the near one yours to bat in\n- The bat in your hand from the first second, with real contact and carry\n- Four game modes and four pitch speeds\n- Slow motion on demand, so you can meet the ball\n- Hit balls stay where they land\n- Walk the whole park - lawn, paths, ball field, handball court\n- Original music, or turn it off for the breeze and the birds", "short_description": "An outdoor batting cage in a New York City park, on a bright afternoon. Four netted lanes on a concrete pad, a coin-op machine down the end of yours, and the bat already in your hand. Swing through the pitch and watch the ball go. Then walk out of the cage and into the park - the lawn, the trees, the ball field and the handball court are all really there."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-battingcage.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Group", "support_website_url": null, "website_url": "https://citiview-battingcage.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1231438580062115"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1602359578298172"}]}, "baseline_offer": {"id": "1602359578298172"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789491780, "status": "PUBLISHED", "id": "1602359578298172"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1234072503132056", "version": "1.0.0"}, "id": "1088086573605085", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1231438556728784", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1234072503132056"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1088086573605085"}]}, "change_log": "
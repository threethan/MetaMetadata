ps://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/793139181_1384687557154262_3120782744858686553_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgP1BOAq8DkQ7kNvwEBfdQR&_nc_oc=Adq4KnEkDNXhUPTEfbcZW_GDsbdeDXK-zmbDXI7pd6LK-a9gVPgZdRdBxpY9LOkLpYE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVi4BDL30oeW6OEQVPS0Z29ofhxiUMaiRMBo5Yvxqu1g&oe=6AFC7601"}, {"file_name": "shot3-in-the-park-2560x1440.png", "id": "1267552208795199", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596168449_1267552215461865_3287969712779672387_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwBxlm7l0UUQ7kNvwEyFDgX&_nc_oc=AdqdDBwiqitNlk0i0iQ_M1Txp3Ns9KliOwLu3fVnfunMK-CJ2-ufjr9Eax2EWvY5nn8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwyot-xX7toDTlOR9wlkRPrCvyD3i51i-ZJCMV5MGSwg&oe=6AFC69B8"}, {"file_name": "shot4-the-gate-2560x1440.png", "id": "1365583112408430", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/786297305_1365583115741763_7605621278133427600_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvECtqJTQbkQ7kNvwE3X48X&_nc_oc=Adq5wfBoeVP-X5XpFRRL3rqJL9kTswM4stjkVo7mnNj0-5rF_x3VCzI0z-nK73VMjLo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzURlE1EefsdyqcjGiIYEo6oBava7qac0xAt3lqczGFQ&oe=6AFC9709"}, {"file_name": "shot5-ball-field-2560x1440.png", "id": "1123371563585027", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673759338_1123371566918360_4737379732877043415_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyCm728rdTUQ7kNvwHAxHq2&_nc_oc=Ado21HWSpZoG0KufqSN_vscOZj2ntZ52mF8nrPg70pAhIEHC7obwGPHgK0IfxI8INlk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9PSCi5exiD3EvnlmeowketDkoCAf9WKqFRtcQgx68Vg&oe=6AFC74D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1010953301951591", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595129854_1010953305284924_1966249931642140231_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfcnmeJlCXoQ7kNvwH_zRla&_nc_oc=Adq4fqvfdhfdsMp7B5ZZ4pzaHMInDrip59-CYa1Yw0fiWj6MK98SLDuE51znYyDHjI4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVkNPKhFqRzRnwA_AIZV6wQaTbr_UzilO4qJ47ysjcDA&oe=6AFC7A3B"}, "display_name": "Batting Cage", "keywords": ["baseball", "batting", "cage", "sports", "park"], "long_description": "Batting Cage puts you in lane one of a city park's cages on a warm afternoon, with the bat in your hand from the first second. No rack, no menus to fight.\n\nThe machine at the far end feeds you a pitch every few seconds down a real forty-foot lane. Swing through it and the ball comes off the bat the way it should - and the last five balls you hit stay lying on the turf where they landed.\n\nPick your game from the board by the gate. FREE CAGE to just hit. INNING for nine pitches and three outs. HOME RUN DERBY against the clock. ALL-STAR, where the machine speeds up every time you connect. Four speeds, from ROOKIE at 35 mph to ALL-STAR at 70 - the same numbers painted on the lane signs.\n\nHold B or Y and the world drops into slow motion so you can meet the ball, then snaps back the instant you hit it.\n\nAnd it is a real place, not a booth. Walk out through the gate into the park: the mown lawn, the paths, the plane trees, the little-league backstop and the handball court. There is a snack bar, a flag on the pole, and a block of walk-ups across the avenue.\n\nFEATURES\n- Four netted lanes on a park pad, the near one yours to bat in\n- The bat in your hand from the first second, with real contact and carry\n- Four game modes and four pitch speeds\n- Slow motion on demand, so you can meet the ball\n- Hit balls stay where they land\n- Walk the whole park - lawn, paths, ball field, handball court\n- Original music, or turn it off for the breeze and the birds", "short_description": "An outdoor batting cage in a New York City park, on a bright afternoon. Four netted lanes on a concrete pad, a coin-op machine down the end of yours, and the bat already in your hand. Swing through the pitch and watch the ball go. Then walk out of the cage and into the park - the lawn, the trees, the ball field and the handball court are all really there."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-battingcage.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Group", "support_website_url": null, "website_url": "https://citiview-battingcage.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1231438580062115"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/585799753_2268837987184162_1278655178066866968_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACq48NZ1hyMQ7kNvwHrHkmG&_nc_oc=AdojFla8eoSaqAvWebInEx-pS4UiLiIfTg3G-gyFO_1_PfEBG6rUnB9-ePpFvBU3tAE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRlNW0WWVSjOd_A3xCbRfxT3rBK_uVyfopT6AUL7b0bg&oe=6AFC664E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Batting Cage", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "cont
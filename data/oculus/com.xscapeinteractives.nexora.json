t-1-dark-2560x1440.png", "id": "1804806790843748", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312310_1804806794177081_6900333246128067198_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g24J1SK5oNEQ7kNvwF5CySO&_nc_oc=AdozZMapjKn3StshOPLsb4zEgwNvvV6Zmb0cm82goFuwOlUGdPYuKKeBvKrCm0fuVXo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6VFOJVivPhfx9XRV0iVoXngIaMcnasbvgZMYNdR5_AQ&oe=6AF5EDA5"}, {"file_name": "screenshot-2-forest-2560x1440.png", "id": "2292882684621499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295481_2292882691288165_767201006331958924_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gg_QQKNWI0MQ7kNvwE6ApC8&_nc_oc=AdqZxztdQzxEcS1fSZzO2NrbMBjB7FKDycSaQzL4hp-vdesBqJEpYMxCp03OSMyxxng&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR2A1_UsY_80b5xL91bMZABxjTJi-SGKZwYdEswSotyw&oe=6AF5C468"}, {"file_name": "screenshot-5-voice-2560x1440.png", "id": "1437777158304115", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499297170_1437777161637448_3018530433966127095_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcmgzhxzDwgQ7kNvwElUibD&_nc_oc=AdrIe5l2WUP_nn_LudY-Ty5PQR6WU0vtl6pJguE3fUto8RcTMI1F-a1Imk7cMXbJdX8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2awT36-3cDYHrOw8NtF12b8dOZK-TKaI3wWQlxRSHpg&oe=6AF5DC47"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nexora", "keywords": [], "long_description": "Nexora is a free chat app from Xscape Interactives for hanging out with friends and communities, now on your headset.\n\nChat your way\n\nCreate your own spaces with text topics and voice channels, or join public ones in Discover\nSend messages, pictures, GIFs, custom emojis and audio files\nRun polls, pin messages, and react to anything\nMessage friends one-on-one\n\nTalk face to face\n\nJoin voice channels with up to 8 people\nStart 1-on-1 voice and video calls\nTurn on your camera and share your screen\n\nMake it yours\n\nPick from lots of themes, including a spooky Halloween one\nCustomize your profile with a banner, bio and status\nOrganize your spaces into folders\n\nBuilt to be safe and simple\n\nSign up with just a username and password, with no email needed\nOptional two-step login\nPictures are stripped of hidden location data before they\u2019re sent\nBlock and report tools, and moderators who keep spaces friendly\nFree to use, with no paywalls", "short_description": "Chat, voice and video with friends and communities. Free, with no email needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexora-nu-eight-99.vercel.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Xscape", "support_website_url": null, "website_url": "https://nexora-nu-eight-99.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1321188507752605"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300738_1790992788907404_692642999457376058_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15Liiu-y4I8Q7kNvwHP4X12&_nc_oc=AdrNxWFOVyNkg5R21sjcoRUp6YAhBsmVHDAcs647Q1YDjPqaUsEhGJVdYLY9LbK4Jqo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRz36alpy3Pw5wBM_rOsRTukK5EAUx9NLv4pSlV5H0xWA&oe=6AF5C4C1"}, "is_concept": false, "is_tes
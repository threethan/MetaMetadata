.oculuscdn.com/v/t64.5771-25/75203614_1854403628393772_3682524425465415967_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNqbvMERnf4Q7kNvwHGkPlb&_nc_oc=AdkrFIW0kT_18aTAPfZbL2XOsEbqLz0x4l3FW8oXYvPqjZcEZueDgRRGNtg6n0VXdoU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1HBS3fKTKhmiN8oIUmaTWpbj0mEgFhEBom_XuTaNqbg&oe=69B69DFA"}, {"file_name": "AVATAVI_Image_04.png", "id": "494124203566963", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/229198953_494124206900296_3058497728771996828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Omon7JcvqUQ7kNvwFC_4-_&_nc_oc=Adk3aj0fe1T4Kg9fQ9jfkmtlufD0XEfpkcj1KEiGT9MoxSAcae2AgVXmAsDppm4CjoI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3iEFpfFPUjG87YsFEz2zuLhV7Q0J5kqlP90nxwtxbzw&oe=69B68E7D"}, {"file_name": "AVATAVI_Image_05.png", "id": "1229368271813217", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031566_1229368275146550_3021007392769947934_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-D7Th3ZDrUQ7kNvwFkx4tv&_nc_oc=Adl6PkL_oFPft-Ja_GrK6WwFTmCZ4D-plOJ7ga7dtgZ4Q5U9Lp5-v3Eikr1YTQFNTcM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyNnYMOFuSUC-xEzjKBviYl8moBlIWfj19QDGo_ff-xKQ&oe=69B68F88"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVATAVI -Play with Your Avatar", "keywords": [], "long_description": "The theme of AVATAVI is \"Adventure in the real world with your favorite avatar\"!\nIt is an AR application that allows you to make your own miniature avatar or favorite character appear in the real world and go on adventures together!\n\n[ How to play ]\nLet's take a walk in the real world!\nThe stage is the real world! Let's play by wandering around the real world using the move cursor.\n\nLet's make them dance!\nBy default, there are 6 types of motions such as dances and poses set.\n\nLet's change the size!\nSwipe with two fingers to increase or decrease the size of your avatar.\n\nTake photos and videos!\nTake photos and videos with your avatar to record your precious memories.\n\n[ About adding avatars ]\nAVATAVI does not have a character generation function. Instead, it has a function to easily add your favorite character CG created by various external services or by yourself.\n\nSearch and add from external services!\nAVATAVI is integrated with Sketchfab and VRoid Hub, the world's largest 3D model sharing platform, and you can search for and add avatars published by creators around the world.\n\nAdd your own avatar!\nYou can upload your own avatar to a cloud service such as Dropbox or Google Drive and paste the URL, or add a file saved on your device to use as your own avatar.\n\nExample of how to create an avatar\n- Modeling by yourself using 3DCG software\n-Scan your entire body in a 3D studio.\n\n*Please check the official website as we are constantly updating the formats that can be added.", "short_description": "Snap Avatar in Real World!"}, {"images": {"nodes": [{"file_name": "AVATAVI_logo_1440x1440.png", "id": "7277926652328507", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984460_7277926658995173_7144167082499857577_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jE7kRExK81YQ7kNvwEUF7nN&_nc_oc=Adn-nw235bk27IlibUfoVC01KRTVxkmRz1RxnAqbZ0IatVvw8PsGoNxUbdsie-2HeCk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzziIeL0RaC78m9V9J7DjEUJEb95nUC0RmPCskKY9cqkQ&oe=69B6B0A4"}, {"file_name": "AVATAVI_CoverArt_1008x1440.png", "id": "2201350546881836", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974734_2201350550215169_3080362978855455118_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYa6IEPTr1YQ7kNvwEipZwk&_nc_oc=AdkKspPKyGpKS2KFipvKXp1LGNMp50pKys4tojUNtg86MSmDXUidThgu1vrRzNJ1I3E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-i4rCazyv0pFvvpRv8uyBT15e8KC0RbphEve77qjMRg&oe=69B6B472"}, {"file_name": "AVATAVI_CoverArt_1440x1440.png",
.oculuscdn.com/v/t64.5771-25/75203614_1854403628393772_3682524425465415967_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ia5RKmJl5Y4Q7kNvwGWRGbn&_nc_oc=AdkpBToJFOExQ5ObDbdgTi2MEOLwjsfFWn-K1KklJd7XXWO2gqToOMPkysXKZ9qYE4U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxyEmmlIceR0cPA9dt03RVmRuO7PV-c_znIfzs4PgdJ4w&oe=69B7EF7A"}, {"file_name": "AVATAVI_Image_04.png", "id": "494124203566963", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/229198953_494124206900296_3058497728771996828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Omon7JcvqUQ7kNvwGCJfhc&_nc_oc=AdnmUJ2wMnE-5UIChizcCdW51z5euRcttcrpLG27BkBz1eMoz_aBRwL7pr-yzV29TSY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWqZbTur63bCAFiyKjT-SVFMSuryq9ffLW0kvxlAyiug&oe=69B7DFFD"}, {"file_name": "AVATAVI_Image_05.png", "id": "1229368271813217", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031566_1229368275146550_3021007392769947934_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvmWlMkmxuwQ7kNvwGB78_f&_nc_oc=AdkF813cB4QhMj4q6n6-eDqlPf3COgI6dGkVop7GYB-BiHjfNy-G1XRNQkltW2JgbQs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz_RuYokJEd5wf06g_bcu5-cutv7FIPuXSV-ovRH-NakA&oe=69B7E108"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVATAVI -Play with Your Avatar", "keywords": [], "long_description": "The theme of AVATAVI is \"Adventure in the real world with your favorite avatar\"!\nIt is an AR application that allows you to make your own miniature avatar or favorite character appear in the real world and go on adventures together!\n\n[ How to play ]\nLet's take a walk in the real world!\nThe stage is the real world! Let's play by wandering around the real world using the move cursor.\n\nLet's make them dance!\nBy default, there are 6 types of motions such as dances and poses set.\n\nLet's change the size!\nSwipe with two fingers to increase or decrease the size of your avatar.\n\nTake photos and videos!\nTake photos and videos with your avatar to record your precious memories.\n\n[ About adding avatars ]\nAVATAVI does not have a character generation function. Instead, it has a function to easily add your favorite character CG created by various external services or by yourself.\n\nSearch and add from external services!\nAVATAVI is integrated with Sketchfab and VRoid Hub, the world's largest 3D model sharing platform, and you can search for and add avatars published by creators around the world.\n\nAdd your own avatar!\nYou can upload your own avatar to a cloud service such as Dropbox or Google Drive and paste the URL, or add a file saved on your device to use as your own avatar.\n\nExample of how to create an avatar\n- Modeling by yourself using 3DCG software\n-Scan your entire body in a 3D studio.\n\n*Please check the official website as we are constantly updating the formats that can be added.", "short_description": "Snap Avatar in Real World!"}, {"images": {"nodes": [{"file_name": "AVATAVI_logo_1440x1440.png", "id": "7277926652328507", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984460_7277926658995173_7144167082499857577_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jE7kRExK81YQ7kNvwF9RVFj&_nc_oc=AdmQ11a-0wizuoN-hUdYVRaYhqkNV-k0q2a2O94F8AUW1L9roq43yuc6v-JN-giJS_M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxBfptyOez64bHCgwvEppySVKRTFqVmqDiD7VIT0mYhtQ&oe=69B80224"}, {"file_name": "AVATAVI_CoverArt_1008x1440.png", "id": "2201350546881836", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974734_2201350550215169_3080362978855455118_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYa6IEPTr1YQ7kNvwF1zRrD&_nc_oc=Adldc0jM7jyHA5mdtabwk2KDQ_aCm_txWWd4wNAg7rJ0STls-awq8I1CFl-LtQzkkuw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwcedg-G6hsfrlMXJ5ayo6yWAGwAuCfTYtl42P5yJouNw&oe=69B805F2"}, {"file_name": "AVATAVI_CoverArt_1440x1440.png",
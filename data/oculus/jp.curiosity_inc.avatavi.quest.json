_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XASOFfhMBR0Q7kNvwGSxR5H&_nc_oc=AdldfSMzlSbvUKW82fDd3Z9BWLY-sB2slDDinRYYa4SGAz45mDxLKvfGHkGXc3GzeBo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuegJjELDlNB1u-BhkBIxAuyfrIYlYgTHESaJKCZJaWCw&oe=69A6CBFA"}, {"file_name": "AVATAVI_Image_04.png", "id": "494124203566963", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/229198953_494124206900296_3058497728771996828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7m3rFgr18IQ7kNvwFkiDtN&_nc_oc=Adl5g6Nceaim0ix5CNKo5Fb3PfobD3EGuUKqUQhBiqAN7F0dj5OV1qmXfp6HawFZxIs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvn5IkdOXXIaZ59uPnjWIsxgFRtn6v6Ly5DGwrcTq-_aA&oe=69A6F4BD"}, {"file_name": "AVATAVI_Image_05.png", "id": "1229368271813217", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031566_1229368275146550_3021007392769947934_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkDCaXV2bK8Q7kNvwGo-3hy&_nc_oc=Adnyu7xc2tTzNLK6YKHEA95f4fq8bK7Ar4WtN9KKsaQ1cuPSN0jgzGJxdWgkgsyNoCE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuBiSTpLFSHaGSzGH8Ekr-eG1134WqTrLndhbDNzSPW6A&oe=69A6BD88"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVATAVI -Play with Your Avatar", "keywords": [], "long_description": "The theme of AVATAVI is \"Adventure in the real world with your favorite avatar\"!\nIt is an AR application that allows you to make your own miniature avatar or favorite character appear in the real world and go on adventures together!\n\n[ How to play ]\nLet's take a walk in the real world!\nThe stage is the real world! Let's play by wandering around the real world using the move cursor.\n\nLet's make them dance!\nBy default, there are 6 types of motions such as dances and poses set.\n\nLet's change the size!\nSwipe with two fingers to increase or decrease the size of your avatar.\n\nTake photos and videos!\nTake photos and videos with your avatar to record your precious memories.\n\n[ About adding avatars ]\nAVATAVI does not have a character generation function. Instead, it has a function to easily add your favorite character CG created by various external services or by yourself.\n\nSearch and add from external services!\nAVATAVI is integrated with Sketchfab and VRoid Hub, the world's largest 3D model sharing platform, and you can search for and add avatars published by creators around the world.\n\nAdd your own avatar!\nYou can upload your own avatar to a cloud service such as Dropbox or Google Drive and paste the URL, or add a file saved on your device to use as your own avatar.\n\nExample of how to create an avatar\n- Modeling by yourself using 3DCG software\n-Scan your entire body in a 3D studio.\n\n*Please check the official website as we are constantly updating the formats that can be added.", "short_description": "Snap Avatar in Real World!"}, {"images": {"nodes": [{"file_name": "AVATAVI_logo_1440x1440.png", "id": "7277926652328507", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_7277926658995173_7144167082499857577_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaf44peL33wQ7kNvwFCjdF2&_nc_oc=AdmpFxI7M28z8SmBl2MO2tZC6WCyS4NgHGkRYLDH-QE7mMJRwuyqO4K2JTeF9OdKVsM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfufIEz6dEWuMg5Wcdhb1gWHIi6JVsbcJa-7Qj62Y1UDAg&oe=69A6DEA4"}, {"file_name": "AVATAVI_CoverArt_1008x1440.png", "id": "2201350546881836", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974734_2201350550215169_3080362978855455118_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubUJQhbOVpoQ7kNvwEM-Kc_&_nc_oc=AdmUC4BPygjX-Obyrg8GJTwe1ZJ1_hWqa7P4Umnz_3gqZh-16bOjn1elVYOEecHi0To&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuYfFhH0QjaMmKxoJmqjScRc2BHp4IfHHFWrET7wKFDzA&oe=69A6E272"}, {"file_name": "AVATAVI_CoverArt_1440x1440.png", "id": "1200101820953672", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/5
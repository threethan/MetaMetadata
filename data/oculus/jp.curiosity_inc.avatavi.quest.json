01y-JijWJSBjsj6czqLZZar4NhBLVk7-37X-_3CTjdLwfcY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWlLOMyi4qecOS4bjavLvEzn-SNzk2nz_BrqMCMz7Chhw&oe=6B0F1901"}, {"file_name": "AVATAVI_Image_03.png", "id": "1854403625060439", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75203614_1854403628393772_3682524425465415967_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15KYmyQrn8wQ7kNvwHO6rqH&_nc_oc=Adq0S5YbI8oxYUvEfvmThiXcxUqaWzZZ9dpL-1WWW9VawoAC07laiy_infkz5HozAVA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWfAM8AsInmwtBzVABzUfrTWQFQQX4DizqV8LVKXOYjIA&oe=6B0EEDBA"}, {"file_name": "AVATAVI_Image_04.png", "id": "494124203566963", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/229198953_494124206900296_3058497728771996828_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhFVfA8TZrkQ7kNvwHlQdWD&_nc_oc=AdqeGJTRbZxfaUAPBq_KgGiufvcUMf3ahTOIO__JqceK4Z-d2NFEK-wJQqfnwpmw-Qs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVTZaYcc4dHzu99aTzelYw0NOd1lcs4Ugw5i3ENbQmfFA&oe=6B0F167D"}, {"file_name": "AVATAVI_Image_05.png", "id": "1229368271813217", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031566_1229368275146550_3021007392769947934_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WFbdiC9iQsQ7kNvwFnbHyx&_nc_oc=AdqIcsvORVmqArhn9o_1wM5XgKaU9vvwYQ-N7ro-BRODwsQdO4O6PoY6u8_Rlnt1FbU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXtEFDzxJo15TDugHBKcYctgtRu286o2FjasQuoQASO7Q&oe=6B0F1788"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVATAVI -Play with Your Avatar", "keywords": [], "long_description": "The theme of AVATAVI is \"Adventure in the real world with your favorite avatar\"!\nIt is an AR application that allows you to make your own miniature avatar or favorite character appear in the real world and go on adventures together!\n\n[ How to play ]\nLet's take a walk in the real world!\nThe stage is the real world! Let's play by wandering around the real world using the move cursor.\n\nLet's make them dance!\nBy default, there are 6 types of motions such as dances and poses set.\n\nLet's change the size!\nSwipe with two fingers to increase or decrease the size of your avatar.\n\nTake photos and videos!\nTake photos and videos with your avatar to record your precious memories.\n\n[ About adding avatars ]\nAVATAVI does not have a character generation function. Instead, it has a function to easily add your favorite character CG created by various external services or by yourself.\n\nSearch and add from external services!\nAVATAVI is integrated with Sketchfab and VRoid Hub, the world's largest 3D model sharing platform, and you can search for and add avatars published by creators around the world.\n\nAdd your own avatar!\nYou can upload your own avatar to a cloud service such as Dropbox or Google Drive and paste the URL, or add a file saved on your device to use as your own avatar.\n\nExample of how to create an avatar\n- Modeling by yourself using 3DCG software\n-Scan your entire body in a 3D studio.\n\n*Please check the official website as we are constantly updating the formats that can be added.", "short_description": "Snap Avatar in Real World!"}, {"images": {"nodes": [{"file_name": "AVATAVI_logo_1440x1440.png", "id": "7277926652328507", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984460_7277926658995173_7144167082499857577_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOrjqK31LewQ7kNvwF0VDMa&_nc_oc=AdoZiij8L9UgvR6RjjpOV3QolpTEfChi8_Wj_E_REfccD4ug5cCANe3_4H8Kbtbw9rE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXj4jcfRXjX6uq_h5lQDnarP5vJF1XF6lWUeUDvkKrMrA&oe=6B0F0064"}, {"file_name": "AVATAVI_CoverArt_1008x1440.png", "id": "2201350546881836", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oc
.oculuscdn.com/v/t64.5771-25/75203614_1854403628393772_3682524425465415967_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ia5RKmJl5Y4Q7kNvwHytCOA&_nc_oc=AdlbbfJhDqbOhOddNIKGffphUEWO68_1MMFXa7-LZ_QOpY963N8OYwuykDlJVlwOdzg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfysP9gufGshW0t2gybM-FfzYZurOIV0D7ULSolgdZzNCQ&oe=69BA927A"}, {"file_name": "AVATAVI_Image_04.png", "id": "494124203566963", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/229198953_494124206900296_3058497728771996828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNioYjNGJ2cQ7kNvwFHYbyX&_nc_oc=Adk9U2_-yMM1L1k2TFC3MZZKj3I6_C_q0-r6MOT3UbKZx_FBPIeEFA5YVhUg7WB6WuY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyYt03LBFvU0FnwT8aZL2hn3vMOsGAZ39Rc0EtoMYLQaA&oe=69BA82FD"}, {"file_name": "AVATAVI_Image_05.png", "id": "1229368271813217", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031566_1229368275146550_3021007392769947934_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvmWlMkmxuwQ7kNvwFm7T58&_nc_oc=AdkO_GEAMq1QfmT-jeESK0zDgrdavK6mTXH2fbR4YUrW_9pl0hRE_WRamZdDJm3wQvQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfysJGryxgf-Z0ZpWKURM0et5Qq5XtKy5UKw4BDipvGR2A&oe=69BA8408"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVATAVI -Play with Your Avatar", "keywords": [], "long_description": "The theme of AVATAVI is \"Adventure in the real world with your favorite avatar\"!\nIt is an AR application that allows you to make your own miniature avatar or favorite character appear in the real world and go on adventures together!\n\n[ How to play ]\nLet's take a walk in the real world!\nThe stage is the real world! Let's play by wandering around the real world using the move cursor.\n\nLet's make them dance!\nBy default, there are 6 types of motions such as dances and poses set.\n\nLet's change the size!\nSwipe with two fingers to increase or decrease the size of your avatar.\n\nTake photos and videos!\nTake photos and videos with your avatar to record your precious memories.\n\n[ About adding avatars ]\nAVATAVI does not have a character generation function. Instead, it has a function to easily add your favorite character CG created by various external services or by yourself.\n\nSearch and add from external services!\nAVATAVI is integrated with Sketchfab and VRoid Hub, the world's largest 3D model sharing platform, and you can search for and add avatars published by creators around the world.\n\nAdd your own avatar!\nYou can upload your own avatar to a cloud service such as Dropbox or Google Drive and paste the URL, or add a file saved on your device to use as your own avatar.\n\nExample of how to create an avatar\n- Modeling by yourself using 3DCG software\n-Scan your entire body in a 3D studio.\n\n*Please check the official website as we are constantly updating the formats that can be added.", "short_description": "Snap Avatar in Real World!"}, {"images": {"nodes": [{"file_name": "AVATAVI_logo_1440x1440.png", "id": "7277926652328507", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984460_7277926658995173_7144167082499857577_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwP23xDUlZAQ7kNvwGuf3cP&_nc_oc=Adl7_NsMlFWC-vPQ5wQd4nVtmdQDPaUEGk0fvU2rwLejbKPWtDrzcsi3vrm-cUxm2ts&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy7vL1g7x3uFZEnWXVb2Rz7PdIhgusu0XEdSoZzv-Od5g&oe=69BAA524"}, {"file_name": "AVATAVI_CoverArt_1008x1440.png", "id": "2201350546881836", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974734_2201350550215169_3080362978855455118_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZW49r-dfnSEQ7kNvwHDTBfg&_nc_oc=Adn3ihg9t7OG1_NXXp5HAb-pKVaFOPbdPSjZ2fY-rJZLkmZmBwXvws84pzlGGZcxC7E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzyu08W0HaE_1NIAnlgsbbzkTaaVkznwTrCE1R2d5MD4Q&oe=69BAA8F2"}, {"file_name": "AVATAVI_CoverArt_1440x1440.png",
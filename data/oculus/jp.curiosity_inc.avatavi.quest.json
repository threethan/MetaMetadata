5sWUPEC0TsnyzxrieIlOTPnFTCY-xSan9tz6iCH17a6QTv0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQZnw578Ncs0oLg1b5ojiomKPPbZq_W7avkMjsFWPWalw&oe=6B0C7601"}, {"file_name": "AVATAVI_Image_03.png", "id": "1854403625060439", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75203614_1854403628393772_3682524425465415967_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15KYmyQrn8wQ7kNvwGd_wEE&_nc_oc=AdrggkaXZugCbD_jxF6oVgzkHrQPEVfydWPc7E-PuTLSB2GD5-ug1qwZtYXzybyCe-w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSNayoQeLYjnUqlPZBdRKVfftUWkq9VOhWBdgupY36GCA&oe=6B0C82FA"}, {"file_name": "AVATAVI_Image_04.png", "id": "494124203566963", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/229198953_494124206900296_3058497728771996828_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHW6W93_NE0Q7kNvwHgBWDp&_nc_oc=AdoWxDEEHW_1Vd1xsxZO0NdgSzozJ3aCFIx_zF-l2Nl0RAp818PDKw45mD1_h1QhpVQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSP8rabnzQ_eGM4zEBRVp451calxnqEOlJVR7w8z9zvfg&oe=6B0C737D"}, {"file_name": "AVATAVI_Image_05.png", "id": "1229368271813217", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031566_1229368275146550_3021007392769947934_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSTmWulPKkEQ7kNvwHNvcyV&_nc_oc=Adq_YjA3FYXzw4y0YzujEVKB906ZHh-YWl5-3oqpb4S4NICQ7tIE4m_MJ00bVoBTQU4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSgnG9FMmhPiyt5PBRi3yBNAthmBJIiY51CoTOoOOYEhQ&oe=6B0C7488"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVATAVI -Play with Your Avatar", "keywords": [], "long_description": "The theme of AVATAVI is \"Adventure in the real world with your favorite avatar\"!\nIt is an AR application that allows you to make your own miniature avatar or favorite character appear in the real world and go on adventures together!\n\n[ How to play ]\nLet's take a walk in the real world!\nThe stage is the real world! Let's play by wandering around the real world using the move cursor.\n\nLet's make them dance!\nBy default, there are 6 types of motions such as dances and poses set.\n\nLet's change the size!\nSwipe with two fingers to increase or decrease the size of your avatar.\n\nTake photos and videos!\nTake photos and videos with your avatar to record your precious memories.\n\n[ About adding avatars ]\nAVATAVI does not have a character generation function. Instead, it has a function to easily add your favorite character CG created by various external services or by yourself.\n\nSearch and add from external services!\nAVATAVI is integrated with Sketchfab and VRoid Hub, the world's largest 3D model sharing platform, and you can search for and add avatars published by creators around the world.\n\nAdd your own avatar!\nYou can upload your own avatar to a cloud service such as Dropbox or Google Drive and paste the URL, or add a file saved on your device to use as your own avatar.\n\nExample of how to create an avatar\n- Modeling by yourself using 3DCG software\n-Scan your entire body in a 3D studio.\n\n*Please check the official website as we are constantly updating the formats that can be added.", "short_description": "Snap Avatar in Real World!"}, {"images": {"nodes": [{"file_name": "AVATAVI_logo_1440x1440.png", "id": "7277926652328507", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984460_7277926658995173_7144167082499857577_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxqpV-BjbHsQ7kNvwE9Ry9O&_nc_oc=AdqECcegBFiojNtON_3TSc_CHCEoae0zrJfk2orzSozy8githrWD1Xrfv3kWFN1peic&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRexpF8oTKuLm2jb6Q5-rsr157pXwqYu9Jwzn9K4fE_5g&oe=6B0C5D64"}, {"file_name": "AVATAVI_CoverArt_1008x1440.png", "id": "2201350546881836", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oc
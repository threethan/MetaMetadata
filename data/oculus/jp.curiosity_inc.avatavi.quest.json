4370495622717_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-fOCUZTdeoQ7kNvwE8rTqn&_nc_oc=AdnoweRGF2r-6zdMf4C83vJmVN04EnUQmP_MyxgPINIlclSb64A9k9B1QZv4VBs79YE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuWoMEumLv_5_K_cRSLb1CQvskatwa2K6qgljpNXNz7aQ&oe=69A97629"}, {"file_name": "AVATAVI_Image_04_2560x1440.png", "id": "425819040025391", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031419_425819043358724_1465067981975189427_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_6mq7uZcX4Q7kNvwH6ZpnS&_nc_oc=AdnQ-Wx7IWip6GKAZxKTPLF4gbZfJj6zPcS_1eBmDbEYkD1LPx-X2vs5SUjC3bFI_AI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuFLC8eclx8M4o0FLZcbVH5UbMCRol7Mqt2DaFKwK95SA&oe=69A98AA6"}, {"file_name": "AVATAVI_CoverArt_2560x1440.png", "id": "6943284979133359", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75286675_6943284982466692_5896843589462956105_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOC6GWzwwQ4Q7kNvwE4jHom&_nc_oc=AdlD47qO9lxk1yagWvO5JlPEf5mNtPO0s06UJ4R-OK5XGPIyVpFzde4AgO_mnEWZ-R0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftHc0p1Y16hBUfAooMF8eqcClivQXM_DoQkl52EHqPmdQ&oe=69A99536"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVATAVI -Play with Your Avatar", "keywords": [], "long_description": "The theme of AVATAVI is \"Adventure in the real world with your favorite avatar\"!\nIt is an AR application that allows you to make your own miniature avatar or favorite character appear in the real world and go on adventures together!\n\n[ How to play ]\nLet's take a walk in the real world!\nThe stage is the real world! Let's play by wandering around the real world using the move cursor.\n\nLet's make them dance!\nBy default, there are 6 types of motions such as dances and poses set.\n\nLet's change the size!\nSwipe with two fingers to increase or decrease the size of your avatar.\n\nTake photos and videos!\nTake photos and videos with your avatar to record your precious memories.\n\n[ About adding avatars ]\nAVATAVI does not have a character generation function. Instead, it has a function to easily add your favorite character CG created by various external services or by yourself.\n\nSearch and add from external services!\nAVATAVI is integrated with Sketchfab and VRoid Hub, the world's largest 3D model sharing platform, and you can search for and add avatars published by creators around the world.\n\nAdd your own avatar!\nYou can upload your own avatar to a cloud service such as Dropbox or Google Drive and paste the URL, or add a file saved on your device to use as your own avatar.\n\nExample of how to create an avatar\n- Modeling by yourself using 3DCG software\n-Scan your entire body in a 3D studio.\n\n*Please check the official website as we are constantly updating the formats that can be added.", "short_description": "Snap Avatar in Real World!"}, {"images": {"nodes": [{"file_name": "AVATAVI_logo_1440x1440.png", "id": "7277926652328507", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_7277926658995173_7144167082499857577_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypGVuAF1qToQ7kNvwFBIJkA&_nc_oc=Adl7WaHsvOdf4THabvwThdGSm1zyPpdZPeD6Di9J9P24tLz99KLcw3NtosJOoNJEtEo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv3RsVyYsS3KwqmxG1TrwYm5l0jQ0xnf40W-ZIODqwKLg&oe=69A981A4"}, {"file_name": "AVATAVI_CoverArt_1008x1440.png", "id": "2201350546881836", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974734_2201350550215169_3080362978855455118_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXBtjW3YafcQ7kNvwEGwxs2&_nc_oc=Adk26kMSAuKzZuFXChcHVicUHHzMhULPQ19QhwzZIg1uIumi6lden6QC2srFiWTm0rY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsaH0v1bg5f91Oup01N2hXHeBtfgLkfR6696U0Y1B2T8g&oe=69A98572"}, {"file_name": "AVATAVI_CoverArt_1440x1440.png", "id": "1200101820953672", "image_type": "
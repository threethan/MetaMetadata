629875640821_806414370495622717_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiL51fuR1lIQ7kNvwGRUUNc&_nc_oc=AdmiTw2qOdGmRXQb48geS2nFpVXl8UUXXyzfLdvp46cgx0kuIrAF8mZu0q_-gDrKvR8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRM2eEY_l_sTkjN2Sj4XN1zcFtU_WIiSTbA6-N4B6PNg&oe=69AAC7A9"}, {"file_name": "AVATAVI_Image_04_2560x1440.png", "id": "425819040025391", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031419_425819043358724_1465067981975189427_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uHghaWDsM8Q7kNvwF2Giwb&_nc_oc=AdnXB4SAwAAF-3Rgnn55axKuJKBEXY74TIsx4HyfzBZyQgdrAQm70ixAN9e3iB9v_2c&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfwWL-wWSQ5_gwovcKIK-IoyO4B_YdZoEa074Sp3TdNdjQ&oe=69AADC26"}, {"file_name": "AVATAVI_CoverArt_2560x1440.png", "id": "6943284979133359", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75286675_6943284982466692_5896843589462956105_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOC6GWzwwQ4Q7kNvwGFwvNq&_nc_oc=Adklh7DdAxC-LplSqx9MqoEAaMOGqGwOZj00QbErxg8xqnXCRhHCRw2Im3zxSJjhhCk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afy7JJJpbIL3ZdnNf7hWbLPiz2lBFrZbYYW2GJ-VEpgHBQ&oe=69AAAE76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVATAVI -Play with Your Avatar", "keywords": [], "long_description": "The theme of AVATAVI is \"Adventure in the real world with your favorite avatar\"!\nIt is an AR application that allows you to make your own miniature avatar or favorite character appear in the real world and go on adventures together!\n\n[ How to play ]\nLet's take a walk in the real world!\nThe stage is the real world! Let's play by wandering around the real world using the move cursor.\n\nLet's make them dance!\nBy default, there are 6 types of motions such as dances and poses set.\n\nLet's change the size!\nSwipe with two fingers to increase or decrease the size of your avatar.\n\nTake photos and videos!\nTake photos and videos with your avatar to record your precious memories.\n\n[ About adding avatars ]\nAVATAVI does not have a character generation function. Instead, it has a function to easily add your favorite character CG created by various external services or by yourself.\n\nSearch and add from external services!\nAVATAVI is integrated with Sketchfab and VRoid Hub, the world's largest 3D model sharing platform, and you can search for and add avatars published by creators around the world.\n\nAdd your own avatar!\nYou can upload your own avatar to a cloud service such as Dropbox or Google Drive and paste the URL, or add a file saved on your device to use as your own avatar.\n\nExample of how to create an avatar\n- Modeling by yourself using 3DCG software\n-Scan your entire body in a 3D studio.\n\n*Please check the official website as we are constantly updating the formats that can be added.", "short_description": "Snap Avatar in Real World!"}, {"images": {"nodes": [{"file_name": "AVATAVI_logo_1440x1440.png", "id": "7277926652328507", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38984460_7277926658995173_7144167082499857577_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypGVuAF1qToQ7kNvwEXOQch&_nc_oc=Adkvfcx2aOIGXT4e-ilICx1xKzXD4sxJk4CgPnTPgIRUl_sBeJKtN-26p_70LwmeTRg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyjjAY73bpvXDw1cc3v_8Rn0vsQ2fke7zhWb1jyfx8qZg&oe=69AAD324"}, {"file_name": "AVATAVI_CoverArt_1008x1440.png", "id": "2201350546881836", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974734_2201350550215169_3080362978855455118_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXBtjW3YafcQ7kNvwHkbqwc&_nc_oc=Adm1nLhSxhYFglBIGB-x9574SfUZPM3BmR2Mn-JyJTrUqZbYOkqXSNgIFNIc4W09O4U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzwh0rlpa895EVtrZZGYAT2TjUsG645ttp7vEgtdOf7ag&oe=69AAD6F2"}, {"file_name": "AVATAVI_CoverArt_1440x1440.png", "id": "12001018209536
4_2560x1440.png", "id": "425819040025391", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031419_425819043358724_1465067981975189427_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_6mq7uZcX4Q7kNvwEXP4Tf&_nc_oc=AdnjU8uPGVsVk9HbPfTUdUkDzfTJqlpmxm00LMkkKL1fFd9sRQ0UkoOBffQ9__z0Mhs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvU6hcaBgh10NI1108QBW_Hdw4Wic0AB91W7gdxXN67Ag&oe=69A6E7A6"}, {"file_name": "AVATAVI_CoverArt_2560x1440.png", "id": "6943284979133359", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75286675_6943284982466692_5896843589462956105_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdx87LBHLjAQ7kNvwGQ80AU&_nc_oc=Admbtwf5z39UD7BRueWdXiQ61RUBNWiwsd8l-4075SSBfI4WREdK8qSZOWLrf7Zv8yk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvBJmatExxEfghm-yx9NSQVSnnBhZi0lWAPO8PkTq6q_A&oe=69A6F236"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVATAVI -Play with Your Avatar", "keywords": [], "long_description": "The theme of AVATAVI is \"Adventure in the real world with your favorite avatar\"!\nIt is an AR application that allows you to make your own miniature avatar or favorite character appear in the real world and go on adventures together!\n\n[ How to play ]\nLet's take a walk in the real world!\nThe stage is the real world! Let's play by wandering around the real world using the move cursor.\n\nLet's make them dance!\nBy default, there are 6 types of motions such as dances and poses set.\n\nLet's change the size!\nSwipe with two fingers to increase or decrease the size of your avatar.\n\nTake photos and videos!\nTake photos and videos with your avatar to record your precious memories.\n\n[ About adding avatars ]\nAVATAVI does not have a character generation function. Instead, it has a function to easily add your favorite character CG created by various external services or by yourself.\n\nSearch and add from external services!\nAVATAVI is integrated with Sketchfab and VRoid Hub, the world's largest 3D model sharing platform, and you can search for and add avatars published by creators around the world.\n\nAdd your own avatar!\nYou can upload your own avatar to a cloud service such as Dropbox or Google Drive and paste the URL, or add a file saved on your device to use as your own avatar.\n\nExample of how to create an avatar\n- Modeling by yourself using 3DCG software\n-Scan your entire body in a 3D studio.\n\n*Please check the official website as we are constantly updating the formats that can be added.", "short_description": "Snap Avatar in Real World!"}, {"images": {"nodes": [{"file_name": "AVATAVI_logo_1440x1440.png", "id": "7277926652328507", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_7277926658995173_7144167082499857577_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaf44peL33wQ7kNvwFCjdF2&_nc_oc=AdmpFxI7M28z8SmBl2MO2tZC6WCyS4NgHGkRYLDH-QE7mMJRwuyqO4K2JTeF9OdKVsM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfufIEz6dEWuMg5Wcdhb1gWHIi6JVsbcJa-7Qj62Y1UDAg&oe=69A6DEA4"}, {"file_name": "AVATAVI_CoverArt_1008x1440.png", "id": "2201350546881836", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974734_2201350550215169_3080362978855455118_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubUJQhbOVpoQ7kNvwEM-Kc_&_nc_oc=AdmUC4BPygjX-Obyrg8GJTwe1ZJ1_hWqa7P4Umnz_3gqZh-16bOjn1elVYOEecHi0To&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuYfFhH0QjaMmKxoJmqjScRc2BHp4IfHHFWrET7wKFDzA&oe=69A6E272"}, {"file_name": "AVATAVI_CoverArt_1440x1440.png", "id": "1200101820953672", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570304_1200101824287005_847677145276628162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybpYDHvJeIEQ7kNvwGdDLc8&_nc_oc=AdnC0h0oAMd2nUI9ugYUDyFJX9QsD_8-f7fKUNtolkp-qc-a5asezPjdhTBIwFdEqzw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft1EelrlWEt0hmgQldlVhf
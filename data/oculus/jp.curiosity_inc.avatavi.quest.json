4370495622717_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbgZQYbngJ8Q7kNvwGSqmB_&_nc_oc=AdnzzNIlisiyu-h6jNa-P7JiJJkik-XoV0ZpxoXIImpR8Sqv9rdwCXkURwrGV0bCnes&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzpoBKG_QQJ4oLkaZBmexeOlVcvSrD6xJmTmDNucG5dlw&oe=69B15F29"}, {"file_name": "AVATAVI_Image_04_2560x1440.png", "id": "425819040025391", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031419_425819043358724_1465067981975189427_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtsTU-HgeWYQ7kNvwET7oa1&_nc_oc=AdlVBmxxsM-CGaNMBf775lyQ3O3BMcIC69BZl18XXPxOBuP6O--FQvnNwv7EyqjPsU0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDQPtddCjYtnacre_6hXr6PEk2OfyCEEhC8zve3-GYLQ&oe=69B173A6"}, {"file_name": "AVATAVI_CoverArt_2560x1440.png", "id": "6943284979133359", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75286675_6943284982466692_5896843589462956105_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4W1RhXhIC4Q7kNvwGJEFXC&_nc_oc=AdlycrXat6E2KRbl_ZLLym7lkZjYP_9s1sgb1_A92x633AwHS4fdQAC_A8BojWf31og&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwT9j2R-ZCrNCpGfj7eaBhCgk81FNACDpPIX5GyWgNdNw&oe=69B145F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVATAVI -Play with Your Avatar", "keywords": [], "long_description": "The theme of AVATAVI is \"Adventure in the real world with your favorite avatar\"!\nIt is an AR application that allows you to make your own miniature avatar or favorite character appear in the real world and go on adventures together!\n\n[ How to play ]\nLet's take a walk in the real world!\nThe stage is the real world! Let's play by wandering around the real world using the move cursor.\n\nLet's make them dance!\nBy default, there are 6 types of motions such as dances and poses set.\n\nLet's change the size!\nSwipe with two fingers to increase or decrease the size of your avatar.\n\nTake photos and videos!\nTake photos and videos with your avatar to record your precious memories.\n\n[ About adding avatars ]\nAVATAVI does not have a character generation function. Instead, it has a function to easily add your favorite character CG created by various external services or by yourself.\n\nSearch and add from external services!\nAVATAVI is integrated with Sketchfab and VRoid Hub, the world's largest 3D model sharing platform, and you can search for and add avatars published by creators around the world.\n\nAdd your own avatar!\nYou can upload your own avatar to a cloud service such as Dropbox or Google Drive and paste the URL, or add a file saved on your device to use as your own avatar.\n\nExample of how to create an avatar\n- Modeling by yourself using 3DCG software\n-Scan your entire body in a 3D studio.\n\n*Please check the official website as we are constantly updating the formats that can be added.", "short_description": "Snap Avatar in Real World!"}, {"images": {"nodes": [{"file_name": "AVATAVI_logo_1440x1440.png", "id": "7277926652328507", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984460_7277926658995173_7144167082499857577_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ex7XXXrd6ZQQ7kNvwFT6Z--&_nc_oc=AdnIRmxcn0ejBnQcHfr5aNDhYWCrP-PeaCZq8pFDCJif34Jc5-4HpuarO8qFeAHqlJ8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8LfPzVSHqS4K7PeOcojvDx4KSfN2ZXjltPYEVBbvP1g&oe=69B16AA4"}, {"file_name": "AVATAVI_CoverArt_1008x1440.png", "id": "2201350546881836", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974734_2201350550215169_3080362978855455118_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8R_NDnA_r7kQ7kNvwGmwy27&_nc_oc=AdmMvEosqdy5V3dpBflOrzGha6xEbrCMuX6k94sDhc29JRi8K9PSGWwAZiY4ijYvs4c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAeNJD9bbkGogujgHA-9TKjGcG7kMdNmJo6mZbgjpb9w&oe=69B16E72"}, {"file_name": "AVATAVI_CoverArt_1440x1440.png", "id": "1200101820953672", "image_type": "
s7QNxYlYSJ3O80hvOrwLHYPeAMuQljaa75KF5THqkJ1Jiqg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQ2cFSIkGFfwhiUOyCJShGsFtzDYHFm_7ZV_ZqGotpWA&oe=6AFDBD41"}, {"file_name": "AVATAVI_Image_03.png", "id": "1854403625060439", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203614_1854403628393772_3682524425465415967_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltHDJzFOex8Q7kNvwHOZNCu&_nc_oc=Adp6aCaWUR5AFDGgrHDLYf-5f_X_wIY5DJSUP9m8J-hDBW9--Eg0lh0sCoF7xWtubn8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOLcaDVC2zu32CKcmpUySIEdn-vXLKiQNPoSxAFk4j9w&oe=6AFDCA3A"}, {"file_name": "AVATAVI_Image_04.png", "id": "494124203566963", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/229198953_494124206900296_3058497728771996828_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bRt-Oc3lhQQ7kNvwFpeq9f&_nc_oc=Adp0Xa_uMnMcPu9AHPSYNs-XTotlz_SvNBPvS4SQZOznltDHrWU3bl1uh_qZRaH4UHw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTP-IjAa6pnQgHR18u2Tgl9vAXUrS5amnPs1_7hHaJ_XA&oe=6AFDBABD"}, {"file_name": "AVATAVI_Image_05.png", "id": "1229368271813217", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031566_1229368275146550_3021007392769947934_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKpVLIHXNlsQ7kNvwEIfKTb&_nc_oc=Adr14TH2LMUXlgnFMRsFcb2p4luLQXl9xIK6094zSpccW1nWOA6p0wDFKwpqEQAz_YQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaN84rw26TKDTUIpxMf8Pss3-ceKb7udRPlvXZJ2xzCQ&oe=6AFDBBC8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVATAVI -Play with Your Avatar", "keywords": [], "long_description": "The theme of AVATAVI is \"Adventure in the real world with your favorite avatar\"!\nIt is an AR application that allows you to make your own miniature avatar or favorite character appear in the real world and go on adventures together!\n\n[ How to play ]\nLet's take a walk in the real world!\nThe stage is the real world! Let's play by wandering around the real world using the move cursor.\n\nLet's make them dance!\nBy default, there are 6 types of motions such as dances and poses set.\n\nLet's change the size!\nSwipe with two fingers to increase or decrease the size of your avatar.\n\nTake photos and videos!\nTake photos and videos with your avatar to record your precious memories.\n\n[ About adding avatars ]\nAVATAVI does not have a character generation function. Instead, it has a function to easily add your favorite character CG created by various external services or by yourself.\n\nSearch and add from external services!\nAVATAVI is integrated with Sketchfab and VRoid Hub, the world's largest 3D model sharing platform, and you can search for and add avatars published by creators around the world.\n\nAdd your own avatar!\nYou can upload your own avatar to a cloud service such as Dropbox or Google Drive and paste the URL, or add a file saved on your device to use as your own avatar.\n\nExample of how to create an avatar\n- Modeling by yourself using 3DCG software\n-Scan your entire body in a 3D studio.\n\n*Please check the official website as we are constantly updating the formats that can be added.", "short_description": "Snap Avatar in Real World!"}, {"images": {"nodes": [{"file_name": "AVATAVI_logo_1440x1440.png", "id": "7277926652328507", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_7277926658995173_7144167082499857577_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aU6lIfuTSg4Q7kNvwGaOwYT&_nc_oc=AdoAvc5N_ILoeeJsBZHUxU2njJor2WLyowimvuihV2G5bOCmcB_jEI1VhyfnB3Aniik&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQ2BgsKw88cX3VarMD3aKsGIIMeq2_kCN5b0MvcMhEJw&oe=6AFDDCE4"}, {"file_name": "AVATAVI_CoverArt_1008x1440.png", "id": "2201350546881836", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oc
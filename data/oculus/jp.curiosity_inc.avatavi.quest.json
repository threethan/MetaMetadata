.oculuscdn.com/v/t64.5771-25/75203614_1854403628393772_3682524425465415967_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgywdtTcT4sQ7kNvwEqeskr&_nc_oc=Admpw-c4CjJtCgZMt3dMcO6zANaPaaHmeFd65cspDqiAhNQW6n4xhpFf_ATaroJTIUA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxqsIXS1mQ9eVdtkokNIBstoL4OlAss4iw4Zu7oXTLAYg&oe=69BFD87A"}, {"file_name": "AVATAVI_Image_04.png", "id": "494124203566963", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/229198953_494124206900296_3058497728771996828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FswJm4Opb5gQ7kNvwEeYGf9&_nc_oc=AdktxuyqmxqDWA1uulTq3zRBwcuk78I6GDhYj3Da4u9-j9jSwy0dyL0CtAqf7neFwOw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzy1OBVgH9o392c5ImuxJFtp2praBxj31YzQQyIDfd9cA&oe=69C0013D"}, {"file_name": "AVATAVI_Image_05.png", "id": "1229368271813217", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031566_1229368275146550_3021007392769947934_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pwG_1F6VwkQ7kNvwFFL4WY&_nc_oc=AdmZjVtE8sqONO6b91rejBsY9OIf_HYlhDz0jx5S2fgYHhU2JKdgyazOicIERsGXCto&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_DglgLdlF8ho-mmBISnNp6Eh80nFslt9wLS68eTdXGw&oe=69BFCA08"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVATAVI -Play with Your Avatar", "keywords": [], "long_description": "The theme of AVATAVI is \"Adventure in the real world with your favorite avatar\"!\nIt is an AR application that allows you to make your own miniature avatar or favorite character appear in the real world and go on adventures together!\n\n[ How to play ]\nLet's take a walk in the real world!\nThe stage is the real world! Let's play by wandering around the real world using the move cursor.\n\nLet's make them dance!\nBy default, there are 6 types of motions such as dances and poses set.\n\nLet's change the size!\nSwipe with two fingers to increase or decrease the size of your avatar.\n\nTake photos and videos!\nTake photos and videos with your avatar to record your precious memories.\n\n[ About adding avatars ]\nAVATAVI does not have a character generation function. Instead, it has a function to easily add your favorite character CG created by various external services or by yourself.\n\nSearch and add from external services!\nAVATAVI is integrated with Sketchfab and VRoid Hub, the world's largest 3D model sharing platform, and you can search for and add avatars published by creators around the world.\n\nAdd your own avatar!\nYou can upload your own avatar to a cloud service such as Dropbox or Google Drive and paste the URL, or add a file saved on your device to use as your own avatar.\n\nExample of how to create an avatar\n- Modeling by yourself using 3DCG software\n-Scan your entire body in a 3D studio.\n\n*Please check the official website as we are constantly updating the formats that can be added.", "short_description": "Snap Avatar in Real World!"}, {"images": {"nodes": [{"file_name": "AVATAVI_logo_1440x1440.png", "id": "7277926652328507", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_7277926658995173_7144167082499857577_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRtp0p3sGZUQ7kNvwHF2Fmf&_nc_oc=AdlPzHivlgLXw5giIBxqhRl4ITkDi5aAKoLIy9FjxeO-F5-LIJ3NLxN50CpppZpcb80&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyMGccO9eGbT6cVNufO32u-F1nBX1QAKi0YthFMOf38Ng&oe=69BFEB24"}, {"file_name": "AVATAVI_CoverArt_1008x1440.png", "id": "2201350546881836", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974734_2201350550215169_3080362978855455118_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbasNOi4rugQ7kNvwEN-55g&_nc_oc=Admk1ZGVCfmTSWemFwMsL4AEVKehQjTbNmpOGYyY146K-kFP499A_s2Qsd5Nf8oH0ws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwz3nVlWqo1cUXxmocrkIfPs-uEj0ylknNXbbheB8goPg&oe=69BFEEF2"}, {"file_name": "AVATAVI_CoverArt_1440x1440.png",
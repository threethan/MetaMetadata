.oculuscdn.com/v/t64.5771-25/75203614_1854403628393772_3682524425465415967_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgywdtTcT4sQ7kNvwF-jIiX&_nc_oc=AdpwB4YlsqSfhRgEbL2bGaWQ5o9lDEpcyo3jrQd1GWtPYYyZADXZtMqs-oE2gcgutjc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxd286ZFlFjjDCk4Qj4_1WkdRs5p20IjLUEQjNJxJcYcQ&oe=69C129FA"}, {"file_name": "AVATAVI_Image_04.png", "id": "494124203566963", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/229198953_494124206900296_3058497728771996828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xO-hR4l5UgEQ7kNvwEod5Zs&_nc_oc=Ado5QNHhxYTV34vGI73fhCt_1G7udzq8JCDBlhrJTi1tKjsreIUV14X5Nsk8UypqGdc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwweiVWEYwx4gYa_mI75OUD66w24G_XwXkQ93nakzgWjA&oe=69C11A7D"}, {"file_name": "AVATAVI_Image_05.png", "id": "1229368271813217", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031566_1229368275146550_3021007392769947934_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pwG_1F6VwkQ7kNvwFtfYud&_nc_oc=AdobMGqtuLvIB7p5pd9QzJhHk5BlLZVLQ6iZi9NLuCsGFGwgcxgejfPHLYWNVmZe8OA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxHbuTiJJEvXIdWDvWw2mmwJdSbFpxQ-L0LS-iek2hfuQ&oe=69C11B88"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVATAVI -Play with Your Avatar", "keywords": [], "long_description": "The theme of AVATAVI is \"Adventure in the real world with your favorite avatar\"!\nIt is an AR application that allows you to make your own miniature avatar or favorite character appear in the real world and go on adventures together!\n\n[ How to play ]\nLet's take a walk in the real world!\nThe stage is the real world! Let's play by wandering around the real world using the move cursor.\n\nLet's make them dance!\nBy default, there are 6 types of motions such as dances and poses set.\n\nLet's change the size!\nSwipe with two fingers to increase or decrease the size of your avatar.\n\nTake photos and videos!\nTake photos and videos with your avatar to record your precious memories.\n\n[ About adding avatars ]\nAVATAVI does not have a character generation function. Instead, it has a function to easily add your favorite character CG created by various external services or by yourself.\n\nSearch and add from external services!\nAVATAVI is integrated with Sketchfab and VRoid Hub, the world's largest 3D model sharing platform, and you can search for and add avatars published by creators around the world.\n\nAdd your own avatar!\nYou can upload your own avatar to a cloud service such as Dropbox or Google Drive and paste the URL, or add a file saved on your device to use as your own avatar.\n\nExample of how to create an avatar\n- Modeling by yourself using 3DCG software\n-Scan your entire body in a 3D studio.\n\n*Please check the official website as we are constantly updating the formats that can be added.", "short_description": "Snap Avatar in Real World!"}, {"images": {"nodes": [{"file_name": "AVATAVI_logo_1440x1440.png", "id": "7277926652328507", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984460_7277926658995173_7144167082499857577_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmi3ZUxyOC0Q7kNvwGpSn3z&_nc_oc=AdqXeqazES4XWOMvdIsZ3SolTw6MZW5_SyuJiu8lDvW8XcX9dRMEFWmd8kR53KqvWDc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzYFEUL1hcoDicYEK-C8oXmEN1TOYpT7isv1PfOKhsDkQ&oe=69C13CA4"}, {"file_name": "AVATAVI_CoverArt_1008x1440.png", "id": "2201350546881836", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974734_2201350550215169_3080362978855455118_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Jit4T3slskQ7kNvwGYTshx&_nc_oc=Adqh7tX2FIXzhVxN-Nt_8Dcv8ktY2ResQc0xgRlDMc_CFMJQdxya4SsI7sjtLJWpdqQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyIyi4A34BehOakyi5CwFtO273cRuKEKRxxOVX1KVXGbA&oe=69C14072"}, {"file_name": "AVATAVI_CoverArt_1440x1440.png",
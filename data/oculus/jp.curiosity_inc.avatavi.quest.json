4370495622717_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-fOCUZTdeoQ7kNvwFWTEDh&_nc_oc=AdmIAMc1ILryQFPM0EEr74r4a973amjrYqL97BaMzWObKU-NMY56Pk8fWybNsKCb4kw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvHExaL_PMPVzCnj8t4jZU60rhCZndPxOrRsfrKIpDO-Q&oe=69A824A9"}, {"file_name": "AVATAVI_Image_04_2560x1440.png", "id": "425819040025391", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031419_425819043358724_1465067981975189427_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_6mq7uZcX4Q7kNvwGYhbQj&_nc_oc=AdnXa4Zlj4HlZk0JTlEr7jy-Q8uoZxtJHX4ChOtr2RkT0Dcrt5a-c3zfTusdBnXXJT8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv3etwnScX006t4eBGcXhU--xWSziW69YvjGGdSnyEhgQ&oe=69A83926"}, {"file_name": "AVATAVI_CoverArt_2560x1440.png", "id": "6943284979133359", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75286675_6943284982466692_5896843589462956105_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdx87LBHLjAQ7kNvwEQp4ec&_nc_oc=AdkTNyb7DkiwX4lW0oMm1HqwRd4Tuz3hgPZpol2Od2IEeFoLmEneDnsaxI-VrL9n-Ko&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft2dhjqQ6avKoR2QOvOd4xYg0TyXEco1MlQ-fhj8pVCFw&oe=69A80B76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVATAVI -Play with Your Avatar", "keywords": [], "long_description": "The theme of AVATAVI is \"Adventure in the real world with your favorite avatar\"!\nIt is an AR application that allows you to make your own miniature avatar or favorite character appear in the real world and go on adventures together!\n\n[ How to play ]\nLet's take a walk in the real world!\nThe stage is the real world! Let's play by wandering around the real world using the move cursor.\n\nLet's make them dance!\nBy default, there are 6 types of motions such as dances and poses set.\n\nLet's change the size!\nSwipe with two fingers to increase or decrease the size of your avatar.\n\nTake photos and videos!\nTake photos and videos with your avatar to record your precious memories.\n\n[ About adding avatars ]\nAVATAVI does not have a character generation function. Instead, it has a function to easily add your favorite character CG created by various external services or by yourself.\n\nSearch and add from external services!\nAVATAVI is integrated with Sketchfab and VRoid Hub, the world's largest 3D model sharing platform, and you can search for and add avatars published by creators around the world.\n\nAdd your own avatar!\nYou can upload your own avatar to a cloud service such as Dropbox or Google Drive and paste the URL, or add a file saved on your device to use as your own avatar.\n\nExample of how to create an avatar\n- Modeling by yourself using 3DCG software\n-Scan your entire body in a 3D studio.\n\n*Please check the official website as we are constantly updating the formats that can be added.", "short_description": "Snap Avatar in Real World!"}, {"images": {"nodes": [{"file_name": "AVATAVI_logo_1440x1440.png", "id": "7277926652328507", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984460_7277926658995173_7144167082499857577_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaf44peL33wQ7kNvwHAOg0n&_nc_oc=AdkmY6u2ddsiGzfqwARbV8WnchkmH7Wns0QC9gItFUGO-1bvR9dCW2JK3O3DYMnRu9o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvcv8GiLPFYtE7tgW7bxJ6f7AK_1biC38JTNDH5UHtTnQ&oe=69A83024"}, {"file_name": "AVATAVI_CoverArt_1008x1440.png", "id": "2201350546881836", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974734_2201350550215169_3080362978855455118_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubUJQhbOVpoQ7kNvwE2iX6E&_nc_oc=Adl7vL7YQ5bqZL337grp0Haakv9MCFTsIHPkDLaBT7hGmNFswY1XjeN0icCsqUhB-nE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuIdJvT6ZE7OKbFukj9Uoc5cx89xyy8VO2y_CIXPfaQ8w&oe=69A833F2"}, {"file_name": "AVATAVI_CoverArt_1440x1440.png", "id": "1200101820953672", "image_type": "
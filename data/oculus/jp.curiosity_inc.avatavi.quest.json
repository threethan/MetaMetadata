n11-1.oculuscdn.com/v/t64.5771-25/75203614_1854403628393772_3682524425465415967_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SFXHxpZe4sQ7kNvwGKUP3R&_nc_oc=AdmpT_tjBvfDXo2hievtQsg2XkCclsi524Yr7FwBnPIMcsus7XFEyzDKL8lktAx8NYM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEcd6fT_yd6xWi-r6l_I1oWleiHfUoGE01qaIIAUU7Zw&oe=69AAC07A"}, {"file_name": "AVATAVI_Image_04.png", "id": "494124203566963", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/229198953_494124206900296_3058497728771996828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwRqWpGvEh8Q7kNvwEK9T4h&_nc_oc=AdmKvWzUMV3eSaMiDC6lQJv-6cYks2NWL4LsNV7N6w4de_jOjQVHyx0hZ1aAlpQz8og&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwX8_Yv8p-1Gn407MyWFXuEutQg1j9Itj1qTYeBe2JlIw&oe=69AAB0FD"}, {"file_name": "AVATAVI_Image_05.png", "id": "1229368271813217", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031566_1229368275146550_3021007392769947934_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiVupI5HV5cQ7kNvwEwtryi&_nc_oc=AdkP9JifcHGzc77Ak__473C5ijRhPJeXUuleUkuoGnUnSLvHNZgPieRo7nIoTjFq7F8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfzHrReRnVEA8aI4lhEhIuWPO6el8lQq3hLydn5rRbLkNw&oe=69AAB208"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVATAVI -Play with Your Avatar", "keywords": [], "long_description": "The theme of AVATAVI is \"Adventure in the real world with your favorite avatar\"!\nIt is an AR application that allows you to make your own miniature avatar or favorite character appear in the real world and go on adventures together!\n\n[ How to play ]\nLet's take a walk in the real world!\nThe stage is the real world! Let's play by wandering around the real world using the move cursor.\n\nLet's make them dance!\nBy default, there are 6 types of motions such as dances and poses set.\n\nLet's change the size!\nSwipe with two fingers to increase or decrease the size of your avatar.\n\nTake photos and videos!\nTake photos and videos with your avatar to record your precious memories.\n\n[ About adding avatars ]\nAVATAVI does not have a character generation function. Instead, it has a function to easily add your favorite character CG created by various external services or by yourself.\n\nSearch and add from external services!\nAVATAVI is integrated with Sketchfab and VRoid Hub, the world's largest 3D model sharing platform, and you can search for and add avatars published by creators around the world.\n\nAdd your own avatar!\nYou can upload your own avatar to a cloud service such as Dropbox or Google Drive and paste the URL, or add a file saved on your device to use as your own avatar.\n\nExample of how to create an avatar\n- Modeling by yourself using 3DCG software\n-Scan your entire body in a 3D studio.\n\n*Please check the official website as we are constantly updating the formats that can be added.", "short_description": "Snap Avatar in Real World!"}, {"images": {"nodes": [{"file_name": "AVATAVI_logo_1440x1440.png", "id": "7277926652328507", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38984460_7277926658995173_7144167082499857577_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypGVuAF1qToQ7kNvwEXOQch&_nc_oc=Adkvfcx2aOIGXT4e-ilICx1xKzXD4sxJk4CgPnTPgIRUl_sBeJKtN-26p_70LwmeTRg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyjjAY73bpvXDw1cc3v_8Rn0vsQ2fke7zhWb1jyfx8qZg&oe=69AAD324"}, {"file_name": "AVATAVI_CoverArt_1008x1440.png", "id": "2201350546881836", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974734_2201350550215169_3080362978855455118_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXBtjW3YafcQ7kNvwHkbqwc&_nc_oc=Adm1nLhSxhYFglBIGB-x9574SfUZPM3BmR2Mn-JyJTrUqZbYOkqXSNgIFNIc4W09O4U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzwh0rlpa895EVtrZZGYAT2TjUsG645ttp7vEgtdOf7ag&oe=69AAD6F2"}, {"file_name": "AVATAVI_CoverArt_1440x1440
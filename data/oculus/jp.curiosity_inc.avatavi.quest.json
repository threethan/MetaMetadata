_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iERpnt9HnmkQ7kNvwGdcUZO&_nc_oc=AdlGAc5LBDbJjIKjcXhFJULMr76rqYDJJNLE7nL6PAIiIKYulFLYJeS_R6isPYi1TFk&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfurWS-47yO7hQbLgHuHFAmrxv4a5LU-yRHSqfUZQBsEfw&oe=69A185FA"}, {"file_name": "AVATAVI_Image_04.png", "id": "494124203566963", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/229198953_494124206900296_3058497728771996828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7GAYe-46igQ7kNvwGOzfSI&_nc_oc=Adky-bsVSXaGevcEfwNCrLq8nzvIsVWh2qQdhGm4ykXlaZ0FMnMrItYirCFD-i1-KkQ&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afv4SZCQ8qdvApAYHxjbIcR5lPDUtvjxVr16XbCbwbFAvQ&oe=69A1767D"}, {"file_name": "AVATAVI_Image_05.png", "id": "1229368271813217", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031566_1229368275146550_3021007392769947934_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZHkXKr5YjYQ7kNvwHq9tlQ&_nc_oc=AdncCDDyV0FeRrGtoKy2sArQs69fUPoxO4zZCvZweXzzfhiN4tDDQGwLO_bLBxgJf88&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aft3v9gQd2o7XqL-K2oqWE1TQCxbQ6prdaOzuEfK45msRA&oe=69A17788"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVATAVI -Play with Your Avatar", "keywords": [], "long_description": "The theme of AVATAVI is \"Adventure in the real world with your favorite avatar\"!\nIt is an AR application that allows you to make your own miniature avatar or favorite character appear in the real world and go on adventures together!\n\n[ How to play ]\nLet's take a walk in the real world!\nThe stage is the real world! Let's play by wandering around the real world using the move cursor.\n\nLet's make them dance!\nBy default, there are 6 types of motions such as dances and poses set.\n\nLet's change the size!\nSwipe with two fingers to increase or decrease the size of your avatar.\n\nTake photos and videos!\nTake photos and videos with your avatar to record your precious memories.\n\n[ About adding avatars ]\nAVATAVI does not have a character generation function. Instead, it has a function to easily add your favorite character CG created by various external services or by yourself.\n\nSearch and add from external services!\nAVATAVI is integrated with Sketchfab and VRoid Hub, the world's largest 3D model sharing platform, and you can search for and add avatars published by creators around the world.\n\nAdd your own avatar!\nYou can upload your own avatar to a cloud service such as Dropbox or Google Drive and paste the URL, or add a file saved on your device to use as your own avatar.\n\nExample of how to create an avatar\n- Modeling by yourself using 3DCG software\n-Scan your entire body in a 3D studio.\n\n*Please check the official website as we are constantly updating the formats that can be added.", "short_description": "Snap Avatar in Real World!"}, {"images": {"nodes": [{"file_name": "AVATAVI_logo_1440x1440.png", "id": "7277926652328507", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38984460_7277926658995173_7144167082499857577_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SaEzZWKO7xMQ7kNvwHRNNvR&_nc_oc=Adkn85bEjqshUEYXW_6oUhBxvQftWdr1_tv51UuwhvoW-Fe_jKpNmHmeNpkKnohaGS4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afs7chQR4e3IcbMbR61oe9aqtQWU1sD_qWeH4RzB_Y9bfw&oe=69A198A4"}, {"file_name": "AVATAVI_CoverArt_1008x1440.png", "id": "2201350546881836", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974734_2201350550215169_3080362978855455118_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KDbyjdkyuYQ7kNvwHgf6OH&_nc_oc=AdmPai7AHrZQ1i7Q3Jx53sCvHI41fyrJZwURzvZs0olI8EzA6tYBotOPYr-KTd3-XMc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsnKdydI3atEhJ6Vitjoy7kWEmL5FDm6hm0F8UAIyCneQ&oe=69A19C72"}, {"file_name": "AVATAVI_CoverArt_1440x1440.png", "id": "1200101820953672", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/5
.oculuscdn.com/v/t64.5771-25/75203614_1854403628393772_3682524425465415967_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SFXHxpZe4sQ7kNvwHzTlIf&_nc_oc=AdmyA8V-ebWiwVj4yFxY1l7NUisqewcYAYrmgs3Jr47e-xzyvon49BG9nJjZOAVQSNg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuLRL8bk2alzMNLbrsqFnpDDZgVoXWjBdMIb6lS2K70Gw&oe=69A96EFA"}, {"file_name": "AVATAVI_Image_04.png", "id": "494124203566963", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/229198953_494124206900296_3058497728771996828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwRqWpGvEh8Q7kNvwHqRN92&_nc_oc=AdmCypV9aSNBk_iww5zIdknwbqYCejeEavNVNzz_2Kp4HpK88JlQpQx-TrhH5wbrypI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvHhS-cO9q8P0futVgUBtCIepNfGJQyG8R_7Gjk0sWvBA&oe=69A95F7D"}, {"file_name": "AVATAVI_Image_05.png", "id": "1229368271813217", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031566_1229368275146550_3021007392769947934_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiVupI5HV5cQ7kNvwHY5WF7&_nc_oc=AdltWnAd6NxHO_wPLcvjOf_YCvisrTaGsA3ARLctltHgJJd5y0BUgZGvJjKW9hyJpZg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuMQ-8sAAvpbbgscXLqLQQnK-tUk20aHw7jB2w_HDFS7Q&oe=69A96088"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVATAVI -Play with Your Avatar", "keywords": [], "long_description": "The theme of AVATAVI is \"Adventure in the real world with your favorite avatar\"!\nIt is an AR application that allows you to make your own miniature avatar or favorite character appear in the real world and go on adventures together!\n\n[ How to play ]\nLet's take a walk in the real world!\nThe stage is the real world! Let's play by wandering around the real world using the move cursor.\n\nLet's make them dance!\nBy default, there are 6 types of motions such as dances and poses set.\n\nLet's change the size!\nSwipe with two fingers to increase or decrease the size of your avatar.\n\nTake photos and videos!\nTake photos and videos with your avatar to record your precious memories.\n\n[ About adding avatars ]\nAVATAVI does not have a character generation function. Instead, it has a function to easily add your favorite character CG created by various external services or by yourself.\n\nSearch and add from external services!\nAVATAVI is integrated with Sketchfab and VRoid Hub, the world's largest 3D model sharing platform, and you can search for and add avatars published by creators around the world.\n\nAdd your own avatar!\nYou can upload your own avatar to a cloud service such as Dropbox or Google Drive and paste the URL, or add a file saved on your device to use as your own avatar.\n\nExample of how to create an avatar\n- Modeling by yourself using 3DCG software\n-Scan your entire body in a 3D studio.\n\n*Please check the official website as we are constantly updating the formats that can be added.", "short_description": "Snap Avatar in Real World!"}, {"images": {"nodes": [{"file_name": "AVATAVI_logo_1440x1440.png", "id": "7277926652328507", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_7277926658995173_7144167082499857577_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypGVuAF1qToQ7kNvwFBIJkA&_nc_oc=Adl7WaHsvOdf4THabvwThdGSm1zyPpdZPeD6Di9J9P24tLz99KLcw3NtosJOoNJEtEo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv3RsVyYsS3KwqmxG1TrwYm5l0jQ0xnf40W-ZIODqwKLg&oe=69A981A4"}, {"file_name": "AVATAVI_CoverArt_1008x1440.png", "id": "2201350546881836", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974734_2201350550215169_3080362978855455118_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXBtjW3YafcQ7kNvwEGwxs2&_nc_oc=Adk26kMSAuKzZuFXChcHVicUHHzMhULPQ19QhwzZIg1uIumi6lden6QC2srFiWTm0rY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsaH0v1bg5f91Oup01N2hXHeBtfgLkfR6696U0Y1B2T8g&oe=69A98572"}, {"file_name": "AVATAVI_CoverArt_1440x1440.png",
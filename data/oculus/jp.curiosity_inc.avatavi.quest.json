3Ors-MC-bSkkfANywq_t4YMYhsHSEQqVJju2eBMSBxB4BLo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5ip1d8q9eAsYaeQ7AyG-wi-wMVFsFt32hniEMoXIL7g&oe=6B084941"}, {"file_name": "AVATAVI_Image_03.png", "id": "1854403625060439", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75203614_1854403628393772_3682524425465415967_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHnAay7jouEQ7kNvwFdG325&_nc_oc=AdryWnERTXCRB-f17I0rr10cY3c6UVoa6oUBZ2nxttGeHdAS3GO74gagZCWQOwJOwd4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRy7ybSYyt8pLZqOZbUvBPcmsIVhNMZwXA69ZaSmh5Qng&oe=6B08563A"}, {"file_name": "AVATAVI_Image_04.png", "id": "494124203566963", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/229198953_494124206900296_3058497728771996828_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqZE1ZeHMOAQ7kNvwHTGSAD&_nc_oc=AdrENgLaU2LE_cdDJ9rUd_VlLJi7WvvS7iPSRXBLi3_E4xm8WrGb80J3kVzsBU-XqZg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzSwgCtWXFj2L0bHvmZa0eOW6EswtJu1ivpw9vIapJNQ&oe=6B0846BD"}, {"file_name": "AVATAVI_Image_05.png", "id": "1229368271813217", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031566_1229368275146550_3021007392769947934_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-k_Jq9VBFgoQ7kNvwEqOR0C&_nc_oc=AdrAVZHQX1Ve4aPQ-TReyC4klhex92Pttd7ihx_LZbIPBuy7N3kVqtT3Q9V4S7EltsU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWHBHq-6Aigcl44KOFXck0bmJIhMngW0GiPQEq2aY60Q&oe=6B0847C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVATAVI -Play with Your Avatar", "keywords": [], "long_description": "The theme of AVATAVI is \"Adventure in the real world with your favorite avatar\"!\nIt is an AR application that allows you to make your own miniature avatar or favorite character appear in the real world and go on adventures together!\n\n[ How to play ]\nLet's take a walk in the real world!\nThe stage is the real world! Let's play by wandering around the real world using the move cursor.\n\nLet's make them dance!\nBy default, there are 6 types of motions such as dances and poses set.\n\nLet's change the size!\nSwipe with two fingers to increase or decrease the size of your avatar.\n\nTake photos and videos!\nTake photos and videos with your avatar to record your precious memories.\n\n[ About adding avatars ]\nAVATAVI does not have a character generation function. Instead, it has a function to easily add your favorite character CG created by various external services or by yourself.\n\nSearch and add from external services!\nAVATAVI is integrated with Sketchfab and VRoid Hub, the world's largest 3D model sharing platform, and you can search for and add avatars published by creators around the world.\n\nAdd your own avatar!\nYou can upload your own avatar to a cloud service such as Dropbox or Google Drive and paste the URL, or add a file saved on your device to use as your own avatar.\n\nExample of how to create an avatar\n- Modeling by yourself using 3DCG software\n-Scan your entire body in a 3D studio.\n\n*Please check the official website as we are constantly updating the formats that can be added.", "short_description": "Snap Avatar in Real World!"}, {"images": {"nodes": [{"file_name": "AVATAVI_logo_1440x1440.png", "id": "7277926652328507", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38984460_7277926658995173_7144167082499857577_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wn0XnzWyz70Q7kNvwENsIUk&_nc_oc=AdpslDDBnxSzs2XxmzwIgEiq7PUxknX-BVhfbYZ_ruIITpCMLTjozARAjnFugNjXFqs&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQODu5k7QcgVwtub_9fsxjGIQV6U2ZE3nimGVWiuUoGA&oe=6B0868E4"}, {"file_name": "AVATAVI_CoverArt_1008x1440.png", "id": "2201350546881836", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-2.oc
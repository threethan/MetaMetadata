c=WP9vmIuslHAQ7kNvwHbwQUk&_nc_oc=AdqjUTbvftMr0kYtCKZQEAnvYp2FYPszalN8UBy-ePJDehZGBHiZL5Muk0WxanuaeJQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVLhSOGMIJ07Ec4xMXfsScV4BVDHi2VC83u4KuWkUdc3Q&oe=6B0EFFF9"}, {"file_name": "OculusScreenshot1683549951.png", "id": "774709577637537", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984475_774709580970870_8585705982865402913_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZshcMqiNjfMQ7kNvwGt2D98&_nc_oc=Ado21dcwqV_nuvwpLK2smd3Zrny5uCQb37s2kPYA7bEbo0A_umrnNb6ZuymC-Jk17oQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXsP7WCOGWD5bf6_xDyHVya2iXAN_VJEFI7-uY3RPE7dg&oe=6B0EF50D"}, {"file_name": "OculusScreenshot1683550003.png", "id": "3404043899910934", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984463_3404043903244267_8910237253400018926_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4vnAvwdfZsQ7kNvwGxNB1L&_nc_oc=Adp49NTQyCkjxcClO6hq0U2VTqFb7dg0cF-hMI9dtaUgMofVn_tyROVOIsZMek2uwrI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXXdArdR7APyh25nzp4Ka-pgLmLmUaWXMuhD65UlCXsVg&oe=6B0F1131"}, {"file_name": "OculusScreenshot1683549983.png", "id": "777721613939319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031634_777721617272652_5287507362453473583_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ef96lc2u6isQ7kNvwEHYkib&_nc_oc=Adr6sZ_Wp0vlZa3PpDfGZgd0YBIdpsd2JYHbmk0xcJ4z_ptsUlQKeANvrvLjZk0VsEA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX4LD-v93sdZLcPMnfMoPX_XVV1xbzVqFgsu2dBVnpeGw&oe=6B0F2107"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2023-05-08 094426.png", "id": "3437315319872900", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036636_3437315323206233_4712682067395856163_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsRMk9X3fs4Q7kNvwEYvIO7&_nc_oc=AdqnmQ74d7OW06jgTXbj-NrShnHCcUWjGHmtgAQIgnRdmT7zIx3ZOvSO8OR1k_-LN3k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV0Qxq6YrHXxFT0J8wfPuLaeUCCG-4DPgolP7nuSwUNlg&oe=6B0F0AE1"}, "display_name": "Ground Zero", "keywords": [], "long_description": "VR ZTD: Ground Zero is an exciting tower defense game that puts you in the middle of a zombie apocalypse. Use a variety of towers, including the Photon Blaster, FlameThrower, and Freeze Ray, to stop the advancing hordes of zombies. With the Left JoyStick, Right JoyStick, and Primary Hand Trigger, players can move around, look around, and pick up and place towers. Explore multiple maps, including a mountain and a mall, each with unique challenges and enemy spawn points. The game features a scoring database system, global leaderboard, wave progression, and a variety of control options to keep players engaged and challenged. The upcoming 1.1 update will add more towers, maps with different difficulties, and the ability to obtain weapons that can be fired. Get ready to defend yourself against the undead in VR ZTD: Ground Zero!\n\nIndie Developer, although expect regular updates, multiplayer update soon?", "short_description": "\"Defend against waves of zombie attacks in VR ZTD: Ground Zero, a thrilling tower defense game. Use a variety of towers and weapons to fend off the zombie hordes and survive until the end. Compete with players from around the world on the global leaderboard and prove yourself as the ultimate Survivor.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/jldevelops/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JLDevelops", "support_website_url": null, "website_url": "https://sites.google.com/view/jldevelops/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "275
nc_oc=Adpy-ofbpPMLIhj5ukrhN5lV9i3FYLJu-UMQjffk37jXSlJ39NPaoZl5Ct1z314-KvE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgkOWo6gZ_Rti5AWBrGQwilBXONB5QdlSspvOOwEG7_g&oe=6AFDAF21"}, "display_name": "Ground Zero", "keywords": [], "long_description": "VR ZTD: Ground Zero is an exciting tower defense game that puts you in the middle of a zombie apocalypse. Use a variety of towers, including the Photon Blaster, FlameThrower, and Freeze Ray, to stop the advancing hordes of zombies. With the Left JoyStick, Right JoyStick, and Primary Hand Trigger, players can move around, look around, and pick up and place towers. Explore multiple maps, including a mountain and a mall, each with unique challenges and enemy spawn points. The game features a scoring database system, global leaderboard, wave progression, and a variety of control options to keep players engaged and challenged. The upcoming 1.1 update will add more towers, maps with different difficulties, and the ability to obtain weapons that can be fired. Get ready to defend yourself against the undead in VR ZTD: Ground Zero!\n\nIndie Developer, although expect regular updates, multiplayer update soon?", "short_description": "\"Defend against waves of zombie attacks in VR ZTD: Ground Zero, a thrilling tower defense game. Use a variety of towers and weapons to fend off the zombie hordes and survive until the end. Compete with players from around the world on the global leaderboard and prove yourself as the ultimate Survivor.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/jldevelops/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JLDevelops", "support_website_url": null, "website_url": "https://sites.google.com/view/jldevelops/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "275
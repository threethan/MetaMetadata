&_nc_ohc=OfxywT2K060Q7kNvwFXloVg&_nc_oc=AdqnfHG02XcXjfvs_MK58Ulw_dyevFv5AUMjwIuM1G9-aBYKN_vhwDNUeipj-Xm0hzg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPV3bqD4Gu4BN5Vbz0p_QN1xZe5DyCGgCVtmpUtsLBIQ&oe=6AB51B83"}]}, "id": "4356029028044012", "locale": "pt_BR", "screenshots": [{"file_name": "home_10_Quest.png", "id": "1471900691162468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307435_1471900694495801_4829947570561919049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwaaKScBbhgQ7kNvwGnd6d3&_nc_oc=Adrdaw2YfCu2Yh2aAkq9N9iz19emZo6Z9ad2SFVUKN_h182QENuVV34G1MQjUxdrB1k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIJ_jQfi15QahURxSEeIzPHsXNs0t4iRKoUi_EBjmpDQ&oe=6AB54A4B"}, {"file_name": "settings_10_Quest.png", "id": "1391193859145570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308010_1391193862478903_5269474807905197381_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8dEunQNmN0Q7kNvwFIF-u1&_nc_oc=Adp9BROF0lTFmbFG83_nX9TMPzu-JH3mImnFOXJ94mkHk8wSNDTjlWC1KXPcXATqCLM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPPQZ3cv2b1-4FxprxtxRYPcb_nePBAnhYrrR82KZ0Bg&oe=6AB528C1"}, {"file_name": "home_10_settings_Quest.png", "id": "890412220264365", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310817_890412223597698_6569410573752295327_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGyLeHvsjUwQ7kNvwHKOYL2&_nc_oc=AdorNQy7oI1iFGmaaonh7JqTlCfHhmuVOl5Y8uHBJAJkjJrBZ2sGtC8Q28KVF06a0MU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA6PH_15v_UveeUnfPhRajcsH5NDvnMi-dekLOWl-7WQ&oe=6AB54204"}, {"file_name": "edit_10_Quest.png", "id": "1209432111385989", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310731_1209432114719322_5500871760126419425_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGRTqtmAhsgQ7kNvwFN8hvH&_nc_oc=AdpgRhhQPV9jTOtFomzFhHk_acza3mps9CreFZ_HaHqtwtYIp5GtjOmCCne_EaFirL8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJJ377Bb-vev5ORcK2OlWd74dyyYI2_AmGos5PDDmXCw&oe=6AB535C1"}, {"file_name": "player_10_Quest.png", "id": "908261954943342", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303746_908261961610008_2600051788214719246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93iIbDKkl7UQ7kNvwGdCh6V&_nc_oc=AdrVCAnpXUvOL3NWDi3ts9731Rx6caWtXij5Q66ZtLkbL5VOKS2loPv8-Ok72GUcZSY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1ze4t0vuIQ0QDZnQDqln5kiuqoXPLOTJmYzxM4M2ECQ&oe=6AB52A62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Viol\u00e3o", "Ukulele", "Cifras", "Letras", "Biblioteca"], "long_description": "O **Cifraria** \u00e9 uma biblioteca profissional de m\u00fasicas e de gerenciamento de cifras desenvolvido em Flutter.\nCriado para m\u00fasicos de todos os n\u00edveis, oferece uma experi\u00eancia fluida para gerenciar, transpor e praticar suas m\u00fasicas favoritas, tanto no celular quanto no Quest.\n\n\u2728 **Funcionalidades**\n\n\ud83d\udcc2 **Arquitetura Inteligente**: Organize suas m\u00fasicas em pastas personalizadas com uma barra lateral em glassmorphism (efeito de vidro) para um visual premium e moderno.\n\n\ud83d\udcdc **Gest\u00e3o de Repert\u00f3rios**: Crie listas personalizadas e organize as m\u00fasicas na ordem exata da sua apresenta\u00e7\u00e3o.\n\n\ud83d\udcf2 **Compartilhamento Pro**: Exporte seus repert\u00f3rios atrav\u00e9s da extens\u00e3o exclusiva .cifraria via apps de mensagem ou utilize o QR Code para que outro dispositivo com o app recrie a lista e as m\u00fasicas automaticamente.\n\n\ud83d\udd04 **Transposi\u00e7\u00e3o Instant\u00e2nea**: Mude o tom das m\u00fasicas em tempo real com um motor de transposi\u00e7\u00e3o robusto.\n\n\u2601\ufe0f **Sincroniza\u00e7\u00e3o em Nuvem (Google Drive)**: Fa\u00e7a backup e restaure com seguran\u00e7a toda a sua biblioteca, incluindo pastas e m\u00fasicas favoritas.\n\n\ud83d\udcf1 **Pronto para o Meta Quest**: Modo paisagem otimizado e dimensionamento de interface para um ambiente de pr\u00e1tica imersivo e sem distra\u00e7\u00f5es no Meta Quest.\n\n\ud83d\udcc4 **Importa\u00e7\u00e3o Multiformato**: Importe cifras da web (extra\u00e7\u00e3o com apenas um clique) ou de arquivos locais (PDF e DOCX).\n\n\ud83c\udfb6 **Cifras Interativas**: Acordes clic\u00e1veis com gera\u00e7\u00e3o autom\u00e1tica de diagramas, com suporte para Viol\u00e3o e Ukulele.\n\n\u26a1 **Foco em Performance**: Banco de dados local para carregamento instant\u00e2neo e funcionamento 100% offline.", "short_description": "O Cifraria \u00e9 uma biblioteca profissional de m\u00fasicas e o seu aplicativo definitivo para gerenciar cifras."}, {"images": {"nodes": [{"file_name": "icon_app_cifraria_1440.png", "id": "25137093062632621", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303140_25137093065965954_5340243871155545084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAfdY1yEdLAQ7kNvwGi1_A-&_nc_oc=Adoc-WuoKLt27u5zMCb1jW1AyLpg7yi06a1FCsNJ8WgurOafyQV07ughawDvesAM7z0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWqj4gudQ2_PjBLXL4fSYEttnPkVBcMwKm38CTQJi6aA&oe=6AB530A4"}, {"file_name": "icon_app_cifraria_512.png", "id": "1950929249182186", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308090_1950929252515519_3579238828299289210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDfOFuPpxF4Q7kNvwFexzvH&_nc_oc=AdpLmmUYbVyE42YZ7r1vbAs734tDsfcSdQGX8xTtrz-w7wvhPb4JrWh0NsSBrCOsU6I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnUnRRqYTxzxYqkm6SCLwNUmJ5t6FSNauedtwxxHD3IQ&oe=6AB5337C"}, {"file_name": "cover art cifraria.png", "id": "1221596580110880", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307422_1221596583444213_1996221161851683055_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3XnTyCvt2IQ7kNvwG_
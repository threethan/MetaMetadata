OGt0Lu2iJaups&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKCd5K4SOPAmqc6moPMEnk1SE-3X9Ji5s8NvcVBgaGSw&oe=69CE58EB"}, {"file_name": "settings_10_Quest.png", "id": "769903052409522", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307962_769903055742855_5369264695749606127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyFJytnO4kwQ7kNvwE5cVS7&_nc_oc=Adp-ajc0D9Xqe2CjZUQZVKznniEtXssct1CPlhx03439LGBWzhUk0pzbf-noXpXkA-o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzy8_h5tX9dnKUUKuSe6mzosomCuGMgVqFInJjYNlz-xA&oe=69CE7884"}, {"file_name": "home_10_settings_Quest.png", "id": "26256487057309894", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499298291_26256487067309893_260636835105670560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INPSEJH9T4YQ7kNvwH53bRu&_nc_oc=AdrO8m_QdbsioXVG-Q1RELSa8Z8Fu8WS1wW_22IlUnt9c42Gq61YhGlSlgxZqzJNa-I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfysYw_NpNZzRw8WSLmbWPNXAdhbt63w2ZM3xyHq4glBNQ&oe=69CE6884"}, {"file_name": "edit_10_Quest.png", "id": "791165707365094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwYHo8829T4Q7kNvwFFghRS&_nc_oc=Ado-lEvcEaBBzgbhZShhhl7fIWbLVxMOoVCPweYOQN-lmXiRf8OuZN5JCsVAKoPi9TU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVqUHWH6niBrMmVCo4JLN3XRuLxndUJNBTEcRvyjtzrg&oe=69CE6D28"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksY2QrPieEMQ7kNvwGhZNKv&_nc_oc=Ado-YsiJYjLV4oqParsyECKOh-nSsn0pjc9TUGSQrYCFKcZbbMuRUjjWekApKXgphok&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8p89krHPlaTioBFZy-xKdDv_tKyg9jaZzsiyOpGINpw&oe=69CE6BCA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-u-GYraJYkUQ7kNvwH-xVWo&_nc_oc=AdrraN6nLK7dAFNeQUsFpgMNa6c4S2VL49X7H4f5ihIahoKervIwCek3Q3HoPtHTf_o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQMlgsXmagYkjusRuv6nHUp6V4FO3Ta26pIyLNOSCc1g&oe=69CE56D7"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "u
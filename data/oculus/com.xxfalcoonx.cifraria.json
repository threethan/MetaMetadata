mMf7mtpohEwQ3921g&oe=69A96EEB"}, {"file_name": "settings_10_Quest.png", "id": "769903052409522", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307962_769903055742855_5369264695749606127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gTrZY8LKxEQ7kNvwEUdeVW&_nc_oc=AdmN0p7O7euZqNIH_rBgUCbEPJuS3fE0HosobhZacgj7tHDbWJ4eg2RwBNH00BKC0QY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuB9IJdOLaQbbei0ihIAGJ2CZ91_wa-sUHMaVFjLf_PHA&oe=69A98E84"}, {"file_name": "home_10_settings_Quest.png", "id": "26256487057309894", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298291_26256487067309893_260636835105670560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tViNbhlXcZgQ7kNvwGCicOL&_nc_oc=Adl1WJgN80OiEJrm16fjYYAisR8_rnc7RTkRAueEaOktZIeVfY6aNrteeqOB9W8dzNw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afv1JwvMh0vLhqEvARtMVOSCXP3JYIaKPJNSB5cQ2BIknA&oe=69A97E84"}, {"file_name": "edit_10_Quest.png", "id": "791165707365094", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_K9BsJMdocQ7kNvwH0NwA5&_nc_oc=AdnMbiCElmeCoDXjnixQ3P0xCTjMoin01xNtsPpSj1BTLUECb2ZetJDV3ljMb1PYGlU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftLjYLo-J-81VPvQpNh_W6ZPmn7h74ZG6M_jT5lpEm6_w&oe=69A98328"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lbx63aX49OYQ7kNvwH3O_IN&_nc_oc=Adls4F1fE36c4SpTzrzHBhHaD5ZuE4MFpIxqk70ftJ9PTBxby0i2ZGR43g41FjjNMXI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfscutrauZtR_y9zvRjDCUZ20ICRucGe-W5Nrz5LeECZmw&oe=69A981CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pelG5V0BZAQQ7kNvwF_lxTi&_nc_oc=AdlrmvHf2fkkiQo02_B3rttwt4YX5KlMBENzWiJqT7B-JVVfXexvnVPHhPnlr_JwmiI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftD_7FmKV1Y7UzTZkDw_bzR5dCfzv4kw2J15-aRlBoY8w&oe=69A96CD7"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7
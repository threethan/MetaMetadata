_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CqL4Hv6AKbNXSF5KUIrCkY81Tdyc7-TeizaYODH734w&oe=6A22FD43"}]}, "id": "4356029028044012", "locale": "pt_BR", "screenshots": [{"file_name": "home_10_Quest.png", "id": "1471900691162468", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499307435_1471900694495801_4829947570561919049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sr_kBTPqVYQ7kNvwHx82g-&_nc_oc=AdrJVf2CVmh1Z42zhb6eG4AL-qv3BzD2MfNP-tVCmaxO7WvgtZx1DtrroYf0-8xev5c&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZbhUQl5T_K8SzOj_n-bGmqHIJCGN1q1Q73eCVk6Pvtw&oe=6A22F3CB"}, {"file_name": "settings_10_Quest.png", "id": "1391193859145570", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499308010_1391193862478903_5269474807905197381_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DAk5PnXgjUQ7kNvwElXi16&_nc_oc=Adr1f7U7Fl9xjRjac7f2XQYRhpDmwxs7vvO4hITTbNfCmaBdnQ26eyT2KocyR3aaoMI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KMexedeo-yrZJlZ0BBRXJDATNn9RFfCmSK7wCTSyuuA&oe=6A22D241"}, {"file_name": "home_10_settings_Quest.png", "id": "890412220264365", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499310817_890412223597698_6569410573752295327_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbnuIzl3n3YQ7kNvwEEE761&_nc_oc=Adrpw7yEXvz7M9qwx-ZvqxUPmri91jidq4mdLE7EC34Z4ouxLsZIw-uO1Sk6N4flwCo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xDK0r_HmQE7Fb4iPv2QbFMH8rhdAEIEqElNyVlys31g&oe=6A22EB84"}, {"file_name": "edit_10_Quest.png", "id": "1209432111385989", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499310731_1209432114719322_5500871760126419425_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ubht-pyC_YAQ7kNvwGQ5J4P&_nc_oc=Adrj89wLJfPC7DbHJELtuSH4Re79DOWsEdRoZ1pBIjYq66CN0lKtZq6N8K8y4ZDE8_s&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sPFyKFELbpBoWDH1HVv2cjvdo8MmpbmaA3TxwA3RGvw&oe=6A22DF41"}, {"file_name": "player_10_Quest.png", "id": "908261954943342", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499303746_908261961610008_2600051788214719246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ANaqLIn9wgQ7kNvwHOQHvK&_nc_oc=Adrp62ze-C2BHbitZPdyti0ehSQFVu9LZVx473ain23sZDs75CrM6rRFeVMDkqgHjx8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7jRQznz13j9snOjj7bmsLVAD216bVkEOVIP0_G3UClw&oe=6A22D3E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Viol\u00e3o", "Ukulele", "Cifras", "Letras", "Biblioteca"], "long_description": "O **Cifraria** \u00e9 uma biblioteca profissional de m\u00fasicas e de gerenciamento de cifras desenvolvido em Flutter.\nCriado para m\u00fasicos de todos os n\u00edveis, oferece uma experi\u00eancia fluida para gerenciar, transpor e praticar suas m\u00fasicas favoritas, tanto no celular quanto no Quest.\n\n\u2728 **Funcionalidades**\n\n\ud83d\udcc2 **Arquitetura Inteligente**: Organize suas m\u00fasicas em pastas personalizadas com uma barra lateral em glassmorphism (efeito de vidro) para um visual premium e moderno.\n\n\ud83d\udcdc **Gest\u00e3o de Repert\u00f3rios**: Crie listas personalizadas e organize as m\u00fasicas na ordem exata da sua apresenta\u00e7\u00e3o.\n\n\ud83d\udcf2 **Compartilhamento Pro**: Exporte seus repert\u00f3rios atrav\u00e9s da extens\u00e3o exclusiva .cifraria via apps de mensagem ou utilize o QR Code para que outro dispositivo com o app recrie a lista e as m\u00fasicas automaticamente.\n\n\ud83d\udd04 **Transposi\u00e7\u00e3o Instant\u00e2nea**: Mude o tom das m\u00fasicas em tempo real com um motor de transposi\u00e7\u00e3o robusto.\n\n\u2601\ufe0f **Sincroniza\u00e7\u00e3o em Nuvem (Google Drive)**: Fa\u00e7a backup e restaure com seguran\u00e7a toda a sua biblioteca, incluindo pastas e m\u00fasicas favoritas.\n\n\ud83d\udcf1 **Pronto para o Meta Quest**: Modo paisagem otimizado e dimensionamento de interface para um ambiente de pr\u00e1tica imersivo e sem distra\u00e7\u00f5es no Meta Quest.\n\n\ud83d\udcc4 **Importa\u00e7\u00e3o Multiformato**: Importe cifras da web (extra\u00e7\u00e3o com apenas um clique) ou de arquivos locais (PDF e DOCX).\n\n\ud83c\udfb6 **Cifras Interativas**: Acordes clic\u00e1veis com gera\u00e7\u00e3o autom\u00e1tica de diagramas, com suporte para Viol\u00e3o e Ukulele.\n\n\u26a1 **Foco em Performance**: Banco de dados local para carregamento instant\u00e2neo e funcionamento 100% offline.", "short_description": "O Cifraria \u00e9 uma biblioteca profissional de m\u00fasicas e o seu aplicativo definitivo para gerenciar cifras."}, {"images": {"nodes": [{"file_name": "icon_app_cifraria_1440.png", "id": "25137093062632621", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499303140_25137093065965954_5340243871155545084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4fT0P9t538Q7kNvwGjfDtF&_nc_oc=AdpkDNZulKYXTK8tDItG3v9eRHnAA8BMMi8R4j2a5eZZOaKdnhTRjwyxVzSHcaplS1Y&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6cDLuKA4aKc1vAcR5GlVrbZQx3ULT1UIY04rzyOcx9w&oe=6A22DA24"}, {"file_name": "icon_app_cifraria_512.png", "id": "1950929249182186", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499308090_1950929252515519_3579238828299289210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjRTq6pMxFUQ7kNvwFKYvkQ&_nc_oc=AdqSF_45pOnTxGp-0H9s3khHh35r_n2yi-y4zCP-uk_QVaTh2kItiMKTemlIBzt1Xjc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rTheb_xYBg6WwIMTcENT0uld8olbK8AXWwmk7NLejNQ&oe=6A22DCFC"}, {"file_name": "cover art cifraria.png", "id": "1221596580110880", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499307422_1221596583444213_1996221161851683055_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZQRj_oeJTcQ7kNvwEKfzdB&_nc_oc=AdoAYkHVQFRGTv_qZZZ2f8EZQJlkWD05ho5qQyz3S41UW5_EdAHNmPdSIKYZm3VqWCA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Vz3JcwLUcB-kNbbTMRRgsRuTKmpJBlUNmxwCWajNciw&oe=6A23002E"}, {"file_name": "hero cover cifraria.png", "id": "955328883720100", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499303140_955328887053433_2299564742518944745_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqaZ07tEQ7oQ7kNvwHymFAY&_nc_oc=AdrkUmSZhyvSvwxZtibK-ZejBOeW0eh_oryPofF0q47_o7L40xZK9C8cp7199wZeS90&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ASKGzWRiGgREemKgSwUOJT63LxpmiSStdlVmjiBmVew&oe=6A22F9C9"}, {"file_name": "cover_cifraria_portrait.png", "id": "923398230271609", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499303790_923398233604942_8149238291275724655_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLZfoCcQvHUQ7kNvwGasjtp&_nc_oc=AdpksUVSpeeEA8ibp9ewSTeFut3v1-Lkn5cJ2nOxb1aCe4HHSP5z8zhiRdHRUUq71lM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oEx3Y33HIi3Tr4Apyi4iWsgWwc7Bw59Tx7T0_RDMLZg&oe=6A22D156"}]}, "id": "2120506675398089", "locale": "en_US", "screenshots": [{"file_name": "home_10_Quest.png", "id": "1645036636740857", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491819323_1645036640074190_2595786236772761378_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4VKlg6PqXAQ7kNvwEemV0Q&_nc_oc=Adpy0rFeP3TAM20jtqO-y0cOJlWbmlYO38f0ER_aDVs007_zkNZu439DN8BxmnqGNrY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EdkjZBjdEXj2TxXXrNYr5pShbzAcdq__ECgjm0CdxJQ&oe=6A22F532"}, {"file_name": "settings_10_Quest.png", "id": "827413820421285", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820855_827413823754618_7016173846081243344_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BA9HPmpF-5oQ7kNvwHfVJdd&_nc_oc=AdrMUWN5v7MRPF351RmuRKFJYgtumNfaG2X4PQgfZAhDaLm7UzJcbhmybjEXB4aYIA8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-K9Tg5Ga-hmXKwK0p976ZyM2-_WK_83uyGDDjrlD8xgw&oe=6A22E9E6"}, {"file_name": "home_10_settings_Quest.png", "id": "1684432329357395", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491819854_1684432332690728_2661215708382739758_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yz0XrqQ-Q3kQ7kNvwG8VoFq&_nc_oc=Adqg1q-olu1jyHQYE32dBklfXhqIawjT9DTYj1KJK79O3ta23mPb6Iwuanepwmqn0yo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O2OwZ3BUiX54OrqLZW0V2GKmU7eTL88YwkTA7mZOjJw&oe=6A22EDA3"}, {"file_name": "edit_10_Quest.png", "id": "991159246965883", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491821682_991159253632549_3726168677936387175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xi2-MWP3wIwQ7kNvwHUXeiG&_nc_oc=AdqDv28gFWY6RrxB_oUDHm5T6X1HJi61Kr4-m1Tr2ar-QO8Ugl9nUPHa95wUu63tlmM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0GdN1G7CEG42ux3GHDDJ36REzmqTcuTBapLtaYRe5gQ&oe=6A22D5A3"}, {"file_name": "player_10_Quest.png", "id": "966149539200528", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823296_966149542533861_6133643743596760205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cny7-wAxQAgQ7kNvwE6Tr97&_nc_oc=Adpbz331afjkpPLNlma6qmUQWJEaKCLs_rrOYlSupwTSfBgI-54hGOiPXLt3VVBMOIA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8d4U9efGPJFCdK9LShec3jklIlk44ne9JR5c1v9U6XTg&oe=6A22D4F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udcdc **Setlist Management**: Create custom lists and organize the songs in the exact order of your performance.\n\n\ud83d\udcf2 **Pro Sharing**: Export your setlists using the exclusive .cifraria extension via messaging apps or use the QR Code so that another device with the app can automatically recreate the list and songs.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/18BVoWuGr5oKZaX6z0ZCklOlUod5mBmQH/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "David Kalil Braga", "support_website_url": null, "website_url": "https://davidkalil10.github.io/Cifraria_Website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langu
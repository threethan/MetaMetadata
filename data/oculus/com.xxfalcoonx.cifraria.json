12454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnoKWL7Pg4QQ7kNvwFPQc8F&_nc_oc=AdkyFTS7YDBDfIMueO_ycrwg05qIpgVmdTKCmZ0713i5cA482vs2eI0RP18o3pLusP4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwdOLwAIdbaU8o7d56Ed3kZBqTb-2GOLSFdaXHdOiGZ4w&oe=69BBF828"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhTIpY5ikesQ7kNvwEPon5-&_nc_oc=AdmjHgyiUbXoD3nlVF7td_Hi6dwdRTQrUhahZa4p8LNfRVVGVYSlgnGloQb9hVzbVdo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx5K5dvzlXs4mXbVBGfnq1XoUjn4mQLmDVZucTTMielIw&oe=69BBF6CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNVDex-GBFkQ7kNvwEFhfN2&_nc_oc=AdnHIgHJY7sZ7Uucod_u2uHAlGd5uilH-ygasy3ySIod5DqIxIiETVj7YsFsTUSqwkc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxZJLdeWKEmO1lj-yDXKqAlLTou7t7SzwRaOjBREPFbrA&oe=69BBE1D7"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDTS0ZIuou4Q7kNvwFeT_0W&_nc_oc=Adk9KiqS2m0z8fjsxWDQLqEahWl923yVt4eUiTaVNY-iHRzEcH6sJCqWeYrR0AknaJE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzB6n6aIntfVPLGU53VDBz8VKrr9qz2cUZvXKD5cFFhzg&oe=69BC0A0F"}, {"file_name": "cover_cifraria_portrait.png", "id": "1470913137957685", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304019_1470913141291018_3011473396555673668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDVSUqhsgqQQ7kNvwFUI6fL&_nc_oc=Adm9NEDwzg84d7MvE4WUX7IHLc7FnVS5xfriMWzsS56-vX-OU4wNvxXZrZ3FlFy5BVg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwgw7gGG8ApgHg2YUObkuPegO9M3lbXdw1mE2GkNQ00gQ&oe=69BC0D43"}, {"file_name": "icon_app_cifraria_1440.png", "id": "1469012724923209", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499301053_1469012728256542_7416521803008086253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dE_7PLBGOoQ7kNvwH2JGd_&_nc_oc=AdmF7lRLbbyPn9IPS
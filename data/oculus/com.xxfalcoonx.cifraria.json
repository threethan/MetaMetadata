12454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1ZSsLTfjlcQ7kNvwEmW8Iz&_nc_oc=AdkJzYEQzqxU6LiigfLQfMssIcUIchmJGx_OXScXs_eVShFeH7ldUvghKHo1x1TaQJs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx91vTUicyD4_imsTnNh6e5b0ESq1jjpnWF_F_954Uz-w&oe=69B560A8"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xPkOgzWtksQ7kNvwHei-Uj&_nc_oc=AdnMxUZsqfQ6n8Ol925rZWwx1eKynQSsmJH1ICHPmCqD7zi4YydnJ9axqIswWA1jyBM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQS_WSpSHpi6d7GpGmsYhzdz7cJgLD-Ko6ApWPucwPKw&oe=69B55F4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCPrELhGz78Q7kNvwGzOEzi&_nc_oc=Adl2CcYkhimRRLGaLIJdQ3fb7IFKxGhFsPqntnZ_KKw5P0Cv1Lpa_f40eT6qfV--AH0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8LLNvNk7nReoOiO8mmvvJUN2HCZLm0NdQlcIMZV88SA&oe=69B54A57"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3kIh_jNQ9UQ7kNvwEz3CA9&_nc_oc=Adkm8Xo2FjT40JK_uPhyUx9ntYTVwZ9FaJltS8Sjx10cqTI4zSzmCy8iMEWG97gRF58&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyo_NkDiKqLB0XdatpDw6aDW72QrudZXJ6sw6uyEvzCKw&oe=69B53A4F"}, {"file_name": "cover_cifraria_portrait.png", "id": "1470913137957685", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304019_1470913141291018_3011473396555673668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oJYaDfvV78Q7kNvwHBNP8w&_nc_oc=AdnR2YYQvQbz8Z-_HP7vliqo-2DU1gBbINynoWmHX9YF0ybAkjI_LIF84sxIiOIDMW8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyoPs1Asxl_3sx6364hP4pXPaZ3w1t41Ui_8HUIu6N14Q&oe=69B53D83"}, {"file_name": "icon_app_cifraria_1440.png", "id": "1469012724923209", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499301053_1469012728256542_7416521803008086253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lb3Dz3yRDxYQ7kNvwEaUzVv&_nc_oc=AdkC-wfP2v465QPLh
12454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FanWb__gAAcQ7kNvwHrhsIz&_nc_oc=Adky9RygeeC9d3YvnR3dJYYNGzhhGXYF368iy6_rMZrgfeH1sK_d3Oh3NkevLJw8kVE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXLpPNFH6B0aS15BdabrhiMqlI4DA37CJTNGHxSwu2pA&oe=69B803A8"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hBCZ2Zx_xAQ7kNvwFTTlSQ&_nc_oc=AdmROgxUgKdfFbMI0iauVMxm8UTin90eal7jUuIevHLOG5AlY-9Q_o9a6UvO6sgJCnw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwi4DOKRl16UigqpptDnN0Ext7lgsBcY24sDvQEhdlqUg&oe=69B8024A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCPrELhGz78Q7kNvwF-Axqt&_nc_oc=AdmRfXldoyW5PKNeZZ5Fjg74tYsGgxHneln19PcTSXUSSaENJjII-CoRbx5wV8YcOKo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzbvV7AtX0aKzzeV9RUUfhPCGwvPrawO3--eY1GT3hPhA&oe=69B7ED57"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hYTczYyRScQ7kNvwHVAF5m&_nc_oc=Adlu3ZUR-DlkDxKyjXJpEkZhrXAKsAumCZAPKVbZwfbpsDKWinbvFj_7kg_k7jE59lw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzs2QVIs5Mvep2Lh3L3_5n59yA_etR7OkxFQokhCKXObQ&oe=69B8158F"}, {"file_name": "cover_cifraria_portrait.png", "id": "1470913137957685", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304019_1470913141291018_3011473396555673668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_1o0HJAbLkQ7kNvwHe8-5T&_nc_oc=AdkXOlIQM3zV9quZ-W6WU8lLIewqkRcx1BqggJDN42h_3oHwMUl0YLPIIxg4v2wiQvs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz-4HXH2uWuNgU5BbhJi3Qf5vQKI5XGQSbc7Rrd9MdBiQ&oe=69B7E083"}, {"file_name": "icon_app_cifraria_1440.png", "id": "1469012724923209", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499301053_1469012728256542_7416521803008086253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lb3Dz3yRDxYQ7kNvwENFRgv&_nc_oc=Adn--aIQ5qhIivM4E
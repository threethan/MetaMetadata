content-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CpPOqEs6E7pjcQbFsxrMqhpWg1ApqJ8XerijobIoGzQ&oe=69DE3703"}]}, "id": "4356029028044012", "locale": "pt_BR", "screenshots": [{"file_name": "home_10_Quest.png", "id": "1471900691162468", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307435_1471900694495801_4829947570561919049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meCUEIteBMsQ7kNvwGv815g&_nc_oc=AdoTUXTJ5X65h9rd_S2fWCpNcVHcswaZp-drn5t5wI4uLUob53heoR32yVF6NH38LqI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-GkdejMQri7olxbnzCgnRqH22I8jr64VFcZVF7mwq9Q&oe=69DE2D8B"}, {"file_name": "settings_10_Quest.png", "id": "1391193859145570", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308010_1391193862478903_5269474807905197381_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wfDjdVSsskQ7kNvwFHrlWz&_nc_oc=AdpWGrV31caKkBTiKx0QQ-fBMfazhXDjpMaD7WuT6TrV8LCaZymQF96EQY-hVZF1Euw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RLYeVCVNaSR8pm7MbMl8fOstA_1aWig8bikGFEvr2Jg&oe=69DE4441"}, {"file_name": "home_10_settings_Quest.png", "id": "890412220264365", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499310817_890412223597698_6569410573752295327_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iY__kvtXjkIQ7kNvwES6_7W&_nc_oc=AdoA1Mx3ZfhtBxSDR-3HI87aRmaQvrFOowbEo2zL3RK-soQm77h9Tn0-Zw5Xf3jW_vQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fOx1XY6NGVDhRU2h6XYGNAzfcH1WsoE3HN99nHvkErQ&oe=69DE2544"}, {"file_name": "edit_10_Quest.png", "id": "1209432111385989", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499310731_1209432114719322_5500871760126419425_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z09LVUvBMsoQ7kNvwHjLlZU&_nc_oc=Adr5p0qFGouL90cFhkdvDSCXLP8E4y10Y0EO5p1AcgXshNhsuv3qsJizeFnyYlqpoMY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1h7SUTUz2ys5BAXZUX5LCY-ZisApaKxXuQiCOSNjTcow&oe=69DE5141"}, {"file_name": "player_10_Quest.png", "id": "908261954943342", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303746_908261961610008_2600051788214719246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNVqcDWrF3AQ7kNvwEF84v5&_nc_oc=AdoCVSGuG1mgtFzOoa8HmBJwfvOmzNdUeTiRhhoU8OQpm36qUAFwU5lSoBl9zVaoacU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3b2rZnHnYkATPdIHYyRsqqKuqKofVty_ZZ6oUxGohrIQ&oe=69DE45E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Viol\u00e3o", "Ukulele", "Cifras", "Letras", "Biblioteca"], "long_description": "O **Cifraria** \u00e9 uma biblioteca profissional de m\u00fasicas e de gerenciamento de cifras desenvolvido em Flutter.\nCriado para m\u00fasicos de todos os n\u00edveis, oferece uma experi\u00eancia fluida para gerenciar, transpor e praticar suas m\u00fasicas favoritas, tanto no celular quanto no Quest.\n\n\u2728 **Funcionalidades**\n\n\ud83d\udcc2 **Arquitetura Inteligente**: Organize suas m\u00fasicas em pastas personalizadas com uma barra lateral em glassmorphism (efeito de vidro) para um visual premium e moderno.\n\n\ud83d\udcdc **Gest\u00e3o de Repert\u00f3rios**: Crie listas personalizadas e organize as m\u00fasicas na ordem exata da sua apresenta\u00e7\u00e3o.\n\n\ud83d\udcf2 **Compartilhamento Pro**: Exporte seus repert\u00f3rios atrav\u00e9s da extens\u00e3o exclusiva .cifraria via apps de mensagem ou utilize o QR Code para que outro dispositivo com o app recrie a lista e as m\u00fasicas automaticamente.\n\n\ud83d\udd04 **Transposi\u00e7\u00e3o Instant\u00e2nea**: Mude o tom das m\u00fasicas em tempo real com um motor de transposi\u00e7\u00e3o robusto.\n\n\u2601\ufe0f **Sincroniza\u00e7\u00e3o em Nuvem (Google Drive)**: Fa\u00e7a backup e restaure com seguran\u00e7a toda a sua biblioteca, incluindo pastas e m\u00fasicas favoritas.\n\n\ud83d\udcf1 **Pronto para o Meta Quest**: Modo paisagem otimizado e dimensionamento de interface para um ambiente de pr\u00e1tica imersivo e sem distra\u00e7\u00f5es no Meta Quest.\n\n\ud83d\udcc4 **Importa\u00e7\u00e3o Multiformato**: Importe cifras da web (extra\u00e7\u00e3o com apenas um clique) ou de arquivos locais (PDF e DOCX).\n\n\ud83c\udfb6 **Cifras Interativas**: Acordes clic\u00e1veis com gera\u00e7\u00e3o autom\u00e1tica de diagramas, com suporte para Viol\u00e3o e Ukulele.\n\n\u26a1 **Foco em Performance**: Banco de dados local para carregamento instant\u00e2neo e funcionamento 100% offline.", "short_description": "O Cifraria \u00e9 uma biblioteca profissional de m\u00fasicas e o seu aplicativo definitivo para gerenciar cifras."}, {"images": {"nodes": [{"file_name": "icon_app_cifraria_1440.png", "id": "25137093062632621", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303140_25137093065965954_5340243871155545084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAqTlPxvDrQQ7kNvwFIcaYy&_nc_oc=AdrC-MI35-o5RKrmca0pFMsGXMFNViCKpzt2B-W8jsmp-bqKOzr_ilWB3CZGEs4tR7k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yPoN8vgPOaIpF6xXVeS40j_ma5mXkLrRqrqNtIgcrRQ&oe=69DE4C24"}, {"file_name": "icon_app_cifraria_512.png", "id": "1950929249182186", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308090_1950929252515519_3579238828299289210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8NNrWIra6AQ7kNvwEA-PLN&_nc_oc=Adr18uSeM9L0XEzwK3ErpXrpFgq-0iPDEY0dKaCHMML9yWfOSGc488jT3TGxEwg05wQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dgKT3jRKv1t7h0xV5lGVurI9e8PU5WuQy7_TpWWl8lQ&oe=69DE4EFC"}, {"file_name": "cover art cifraria.png", "id": "1221596580110880", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307422_1221596583444213_1996221161851683055_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrzziQup-AgQ7kNvwFWdRD0&_nc_oc=AdrhaBMu_VX3XE3IaMA5c0t5W_sEAMu5fE9ovdxxKJ-impMH-lN_7P5vs2by71q8qUY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lQ_CmLYO27WCZV5GaciA5S2gRlFWyqVxw-nZ8odmmtA&oe=69DE39EE"}, {"file_name": "hero cover cifraria.png", "id": "955328883720100", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303140_955328887053433_2299564742518944745_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HS-Gf5nFnnQQ7kNvwEmHCmS&_nc_oc=AdpgIBhpTUE5AFPjoMH9uxGAv4T0bOEM62K1Nb1zAK_GhHgL8INfGPhJTTnOAbQc93M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hNKqTgpF93bctT12oZX99-l3svpFCdIHxz4aDKcPANA&oe=69DE3389"}, {"file_name": "cover_cifraria_portrait.png", "id": "923398230271609", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303790_923398233604942_8149238291275724655_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqDaYLCN5vQQ7kNvwGTc0Lb&_nc_oc=AdooskFHk3C0ifuw54--KANe5YyFJ9BQy8m_F1ACshUGE8uyo2iurIdHLj61oedqzgA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sFf01hc_kLTIp-4ZIQTheZJHuXbOISSqVXPfBwb_MpQ&oe=69DE4356"}]}, "id": "2120506675398089", "locale": "en_US", "screenshots": [{"file_name": "home_10_Quest.png", "id": "1645036636740857", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819323_1645036640074190_2595786236772761378_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N02mXJJ_SVQQ7kNvwHOoeX7&_nc_oc=AdoAvWGI-p_UAz-JjPMto85qycm3fzVQHL3hBt9mlbYQPhBvZHsxGOMajR8xbXaVFso&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zTixIAqu80518OkJw8mUGxgGZNLg85_gU5wwPc36l0w&oe=69DE2EF2"}, {"file_name": "settings_10_Quest.png", "id": "827413820421285", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820855_827413823754618_7016173846081243344_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MV6C8XjfmqQQ7kNvwEGs5sO&_nc_oc=AdpSIh8ezuxhUi_ERZbe76WtqbTHdn69JhpRvhfIFHteRPbaYtN-3jUXaM1VwTGn4MY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NObnt9OI5XAAu6Z4_-xCV5ZUW9sVJF1Vu1TUyApDWWw&oe=69DE23A6"}, {"file_name": "home_10_settings_Quest.png", "id": "1684432329357395", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819854_1684432332690728_2661215708382739758_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkmAPUuXF94Q7kNvwGxX_FD&_nc_oc=Adp4rZD8XPEjNlQCrXNe9wM86md1aJyaU7Y9Z7FunprGvdNe8kM2RNxvxdSsC3GKXVc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GbFFJgoOccNXvxKtSzfvwEnM5Jo0HaY7HmpVbckk_mw&oe=69DE2763"}, {"file_name": "edit_10_Quest.png", "id": "991159246965883", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821682_991159253632549_3726168677936387175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UE31Kr-bhLoQ7kNvwG51iMu&_nc_oc=AdovJL9aJo86fDlcYbt74VAt7XBMBw0DgWoLB_iOhkDhJHdLO1f5SNosiIce8e_-8hk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IfFuWuiBTD5dJ3P_x0MrHqEjyiDjUNGes1cSmTHPtyg&oe=69DE47A3"}, {"file_name": "player_10_Quest.png", "id": "966149539200528", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823296_966149542533861_6133643743596760205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgPe1Lq8ubYQ7kNvwESNZvZ&_nc_oc=Adr-iWSya7jjfkTkTRGEGEKLOlEE_aC4Vwnqb42Zpl6LXO1L2A5sPDLlqMrjz3OYzPI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24-GANGQUuz1zw_HeaEvlmeDDKvtxyOfJxUw6LMqzjyA&oe=69DE46F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udcdc **Setlist Management**: Create custom lists and organize the songs in the exact order of your performance.\n\n\ud83d\udcf2 **Pro Sharing**: Export your setlists using the exclusive .cifraria extension via messaging apps or use the QR Code so that another device with the app can automatically recreate the list and songs.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/18BVoWuGr5oKZaX6z0ZCklOlUod5mBmQH/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "David Kalil Braga", "support_website_url": null, "website_url": "https://davidkalil10.github.io/Cifraria_Website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], 
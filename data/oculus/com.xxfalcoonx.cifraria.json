M2j5PSl4FIqQilu9g&oe=69AD636B"}, {"file_name": "settings_10_Quest.png", "id": "769903052409522", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307962_769903055742855_5369264695749606127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SayRUhphW0QQ7kNvwELry5X&_nc_oc=AdliapLatBAiTWeLNnBIDorjwLF6z_hcqtkkK7NnvFzPylZph2WuHnuqy2tP-gG5f7c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzlzjS3Cr7t0I1BBTNzNMHnBTVgPUU8ffGuxL8uW6eNYg&oe=69AD8304"}, {"file_name": "home_10_settings_Quest.png", "id": "26256487057309894", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298291_26256487067309893_260636835105670560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMbUbfjbQJYQ7kNvwGDe_TG&_nc_oc=Adlf4PbKMXNiKNPnwm0JEcXeNZrWawqiuRMiTL4RNkYIbYce4e-WMCGlU2wIU6VUU9g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afydi5fE8eo3kUdVpPO2U7VLZev42cuw9et22dDJ9bfRwg&oe=69AD7304"}, {"file_name": "edit_10_Quest.png", "id": "791165707365094", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KokOSjTmxuIQ7kNvwFqf2NG&_nc_oc=AdlaFOsWXu35SulJMJgjmZJlepcAX_dg-jk9rTm6-Flj44il8McsBSmsqiWPYHC59BE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxl2Tkxr-ejPDvtsXoW-HeUYzaj5MZ1wFXjcnvDeIk5vg&oe=69AD77A8"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0Yo3JEvV_YQ7kNvwEbE-Ce&_nc_oc=AdmdZfhvL3nqR7ck57UQOVzGN9hZFHeqs3GFV-643ubZgPpvBY5hEqukGaTUDsYC2is&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJliOf6_km-uJX9euWxyDLIDa4NgvkERBojy39F2uVSg&oe=69AD764A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GLuPdKAFjwQ7kNvwHnW_VH&_nc_oc=Adl0Im1p9L-q5QRliQAfbdP3Fp9cS7UPccgNnbnSwqTBGbTwQgJRptK3lurt07YjWJk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3SrYLMvmeAkDSn62EIDm0Z4C_4j6T3kRi0NGxlsSjWQ&oe=69AD6157"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7
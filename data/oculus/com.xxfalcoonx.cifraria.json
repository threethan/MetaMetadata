12454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7943LgQZEAQ7kNvwHwbXKS&_nc_oc=Admz9w4rwvU-iw5UwwKOQzXKHTlx22M3jt2OqZ3an4wrBETP5KxBQOHPuG6uVskap18&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOsQ1KVE3ix9cr8VDEpYbi6kL5Qmb4ZPzyn6ElFeAZbQ&oe=69AEC928"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0Yo3JEvV_YQ7kNvwHbYrdL&_nc_oc=Adn9sW4dfkxyhZD4hc-8-mt-jb4xv5RWfEWXspNIAUmI-KNSabnrsfh_26wDEkltbCE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfytOdJ7d-3K1O7zZyStIBqdz8qXLHtZrqDD232g5KW2KA&oe=69AEC7CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GLuPdKAFjwQ7kNvwEKS8MP&_nc_oc=Adm44AOO5nO8IfXM8_n_rpOQ6-n5vWFPbm_vAQ-zqpGzAkye0N1awUx7AYAvV2Qrqng&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLWr5ul_GugTE8X_YB1o9DTx8EdmISrhM5FNRDUXdLTg&oe=69AEB2D7"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zB5hlUz_hAwQ7kNvwEBKR4g&_nc_oc=AdlNFoHfFUoD9fxYsw70x3WN7P1pbY5BhQdzL7i8QaB_DBG1Ag36UOKgFk4OSuFgNw8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBUwebCHDWB-UctdN9UbOx-wrcTFYfxlCkRVkB5CC0xQ&oe=69AEDB0F"}, {"file_name": "cover_cifraria_portrait.png", "id": "1470913137957685", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304019_1470913141291018_3011473396555673668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huxUUN0GUkAQ7kNvwE6HUrT&_nc_oc=Adl2016yOvPX-klyvQsSRis4pZoHU1SgqFAXYGKcqHitaIRECZNO7mtYLqF3HUYdVM8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwIJ8yttUuXaHSZR6tWKaUEb5Rx41JFI34XsNiSDvc-aQ&oe=69AEA603"}, {"file_name": "icon_app_cifraria_1440.png", "id": "1469012724923209", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499301053_1469012728256542_7416521803008086253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1M2L8M8KUYQ7kNvwEwgxFg&_nc_oc=AdmvfvB5hdi0wuZ5e
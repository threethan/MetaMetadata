content-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mGl4ftxCZgRGREnrJUG9NMXhElEjHssCOM5j0KbEZvA&oe=6A159603"}]}, "id": "4356029028044012", "locale": "pt_BR", "screenshots": [{"file_name": "home_10_Quest.png", "id": "1471900691162468", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499307435_1471900694495801_4829947570561919049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBI8Wz6SX5AQ7kNvwGZ9lcG&_nc_oc=AdpEaHXIc8vXeK9z72fCpmRWwY34jgkBXQ52P5QW3qBX8adw13y0Kx1N0xrgk9diCHA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Bi9KhaSl65--v11T-OM30ADwQ3dI2Vzjm2e9XTV_HgA&oe=6A15C4CB"}, {"file_name": "settings_10_Quest.png", "id": "1391193859145570", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499308010_1391193862478903_5269474807905197381_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55NQTb86heUQ7kNvwFZMy2y&_nc_oc=AdrlDPyjrM-Lh3gPJHFwykCitRrgY-Gpk7stN2EzRt5zG54hHPvDqgbHqnakocJv9KY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UTcZ8phasil5RRvNuDGJGx95jMcWbdT-T4Xlqvx2VeQ&oe=6A15A341"}, {"file_name": "home_10_settings_Quest.png", "id": "890412220264365", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310817_890412223597698_6569410573752295327_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ld61T5LYnskQ7kNvwG5s7IZ&_nc_oc=AdqmNjANciCJr1NXfMLXDd6x0_ryHeHfLD6p5sLM9IqWGi4RTSbQeRzQwr1XeoP5K-4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7J4hXakSNtu4MuE0huZkytHc4cOOiYr90MxVRopZgfsQ&oe=6A15BC84"}, {"file_name": "edit_10_Quest.png", "id": "1209432111385989", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310731_1209432114719322_5500871760126419425_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVq7o39aP0oQ7kNvwFmGBgO&_nc_oc=AdrkUiH92qtGnZeD25l6ALbKhEHq1ml2HLHK8skXX2nzy35fSYBBF88e5ymIPGXwuZ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JiA8Qeh1rHW2zva103uzbzXMyPZMkiWw9i98sFzUDmg&oe=6A15B041"}, {"file_name": "player_10_Quest.png", "id": "908261954943342", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303746_908261961610008_2600051788214719246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJUtycFNhLIQ7kNvwEHvu2H&_nc_oc=Adr7LXFiL_yB2qKBLIP6ATOGIzhK-UeuYI8Fkx5EG_ABswUwq1BDZKaOA3fUJBann6c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lJUpM3wDT-FLKo51wv_F01GY-5s1JmLvfieBXBnCazQ&oe=6A15A4E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Viol\u00e3o", "Ukulele", "Cifras", "Letras", "Biblioteca"], "long_description": "O **Cifraria** \u00e9 uma biblioteca profissional de m\u00fasicas e de gerenciamento de cifras desenvolvido em Flutter.\nCriado para m\u00fasicos de todos os n\u00edveis, oferece uma experi\u00eancia fluida para gerenciar, transpor e praticar suas m\u00fasicas favoritas, tanto no celular quanto no Quest.\n\n\u2728 **Funcionalidades**\n\n\ud83d\udcc2 **Arquitetura Inteligente**: Organize suas m\u00fasicas em pastas personalizadas com uma barra lateral em glassmorphism (efeito de vidro) para um visual premium e moderno.\n\n\ud83d\udcdc **Gest\u00e3o de Repert\u00f3rios**: Crie listas personalizadas e organize as m\u00fasicas na ordem exata da sua apresenta\u00e7\u00e3o.\n\n\ud83d\udcf2 **Compartilhamento Pro**: Exporte seus repert\u00f3rios atrav\u00e9s da extens\u00e3o exclusiva .cifraria via apps de mensagem ou utilize o QR Code para que outro dispositivo com o app recrie a lista e as m\u00fasicas automaticamente.\n\n\ud83d\udd04 **Transposi\u00e7\u00e3o Instant\u00e2nea**: Mude o tom das m\u00fasicas em tempo real com um motor de transposi\u00e7\u00e3o robusto.\n\n\u2601\ufe0f **Sincroniza\u00e7\u00e3o em Nuvem (Google Drive)**: Fa\u00e7a backup e restaure com seguran\u00e7a toda a sua biblioteca, incluindo pastas e m\u00fasicas favoritas.\n\n\ud83d\udcf1 **Pronto para o Meta Quest**: Modo paisagem otimizado e dimensionamento de interface para um ambiente de pr\u00e1tica imersivo e sem distra\u00e7\u00f5es no Meta Quest.\n\n\ud83d\udcc4 **Importa\u00e7\u00e3o Multiformato**: Importe cifras da web (extra\u00e7\u00e3o com apenas um clique) ou de arquivos locais (PDF e DOCX).\n\n\ud83c\udfb6 **Cifras Interativas**: Acordes clic\u00e1veis com gera\u00e7\u00e3o autom\u00e1tica de diagramas, com suporte para Viol\u00e3o e Ukulele.\n\n\u26a1 **Foco em Performance**: Banco de dados local para carregamento instant\u00e2neo e funcionamento 100% offline.", "short_description": "O Cifraria \u00e9 uma biblioteca profissional de m\u00fasicas e o seu aplicativo definitivo para gerenciar cifras."}, {"images": {"nodes": [{"file_name": "icon_app_cifraria_1440.png", "id": "25137093062632621", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499303140_25137093065965954_5340243871155545084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mP0O9Dxs_gQ7kNvwGcq6XK&_nc_oc=AdpRyKLf3KdeVh6lQ_ucmDqWBeSJM9Ozj9aH02G_AqSqFu5Edibhzcf3vsYoltTYB60&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af721Zzjw1NpoxSI4CocHAppLKEIhT6_NDl6loU-dphSrg&oe=6A15AB24"}, {"file_name": "icon_app_cifraria_512.png", "id": "1950929249182186", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308090_1950929252515519_3579238828299289210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJZmJsczDVIQ7kNvwGtNhH_&_nc_oc=AdpCWro3_z79GCDMiDfrln9fZ1dzuq6SQW2fbPtD80xxkEv5b4rzwFHtA9JfTbtwoFg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6e-k-jyg0apDlDlHXaBM3P_4Ux6X6UVxRVW-E602FFRA&oe=6A15ADFC"}, {"file_name": "cover art cifraria.png", "id": "1221596580110880", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307422_1221596583444213_1996221161851683055_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1iYFlXctuMQ7kNvwEpDahF&_nc_oc=AdogE_mZeyNtSAjEeyAO318esQU191esxvV5w3qPZwOUhGPorYcfSi2JvhWcvIDSkd8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Flzl9tZlSf7pwcE1EfqfQCFSACajdC_GH-5VcIcEDJg&oe=6A1598EE"}, {"file_name": "hero cover cifraria.png", "id": "955328883720100", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499303140_955328887053433_2299564742518944745_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGnoechtZ9oQ7kNvwFdCrw-&_nc_oc=Adpd7VztQiZF6mZHBUiSq4IciLaAiOGndzsRABsoLfQXXz-HI2mTRXfYA9L100i1lXc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54SZDvkoA5_mUUOuNGwUvXVNmTZWFwPMpH3BhvBj2VeA&oe=6A159289"}, {"file_name": "cover_cifraria_portrait.png", "id": "923398230271609", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303790_923398233604942_8149238291275724655_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBkyTGgYcZEQ7kNvwFYoTY6&_nc_oc=Adq0bNBlHRSCx4bG1e-bhoWmo-AZflLoctoQJzB4WJLVORfyT7WptDe-o21brnVT1e4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JVh6zPNnEfd-8F26DAzB75HbQXxdzGN3UGwcHmPT6HQ&oe=6A15A256"}]}, "id": "2120506675398089", "locale": "en_US", "screenshots": [{"file_name": "home_10_Quest.png", "id": "1645036636740857", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819323_1645036640074190_2595786236772761378_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bqa9QsLK5o8Q7kNvwH7XY3O&_nc_oc=AdqmHBOrvZQww2vSxSeJgCjp-cCNtmrPLuT-Y4dVuM2sDEFi7p64puIEnc4k8Ie01KA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CfphTnzs-_ReJuJM5m_sn6L5rv-2GoDm2aLq8cacThA&oe=6A15C632"}, {"file_name": "settings_10_Quest.png", "id": "827413820421285", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820855_827413823754618_7016173846081243344_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PS4Cfl5F88Q7kNvwHSqbKx&_nc_oc=Adpb6IdxWDoL8cKDPY3RkiTlccozm9A7HVLC-fCumHLINMcre_-OmaotLPj7R3Xvj1s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vmir98A5V-6UqVPusMbRtiiiXJXjsGZpXeRr_S2Azvg&oe=6A15BAE6"}, {"file_name": "home_10_settings_Quest.png", "id": "1684432329357395", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819854_1684432332690728_2661215708382739758_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-c6bMpJ2SHwQ7kNvwE7JGlI&_nc_oc=AdrD4ZriH3wn2oECuCcD1F3zYKXC-LU_y81YLoS5Ht-zK2btLlG9O3g3ClgHZhKF43k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71NFMnwoRBRJxTOEMij3PrzyNC53XVWI9VvIf13ZMhsg&oe=6A15BEA3"}, {"file_name": "edit_10_Quest.png", "id": "991159246965883", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821682_991159253632549_3726168677936387175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lT6L5DQ0zG4Q7kNvwGMf2A1&_nc_oc=Adpmj6eMIlCZrRNU1ubzGsWio2GsUxvPD5uzXABNaZxzPM2tQZDGguWTfonFKY8m-u0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KEEwnuoluNpPrGJs4W4XzghX-oBI2XS68KMLL1QYHuA&oe=6A15A6A3"}, {"file_name": "player_10_Quest.png", "id": "966149539200528", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823296_966149542533861_6133643743596760205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSvP_kccPFAQ7kNvwGEIjjJ&_nc_oc=AdpuBFVB9Aev3rn4QbKiL27Fa326NGBv8rrJBHNRD0GYQQmcb48TdRA1ioEPZmJkcbs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wN3feXai5GHZznIcuSXWNHi1Dw-Bx8pmWTHwJGmXckw&oe=6A15A5F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udcdc **Setlist Management**: Create custom lists and organize the songs in the exact order of your performance.\n\n\ud83d\udcf2 **Pro Sharing**: Export your setlists using the exclusive .cifraria extension via messaging apps or use the QR Code so that another device with the app can automatically recreate the list and songs.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/18BVoWuGr5oKZaX6z0ZCklOlUod5mBmQH/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "David Kalil Braga", "support_website_url": null, "website_url": "https://davidkalil10.github.io/Cifraria_Website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], 
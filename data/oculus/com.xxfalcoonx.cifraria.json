oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPGmMCmkieIQ7kNvwHwRFR0&_nc_oc=AdppCf-EZ-0HhqSvuCr00ntmkt7dktWs5IwnQnXSzp3W-25F8KWgpgonGv2ixl7oE-g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTmLYsiSWaUXkqdE5D8vrFS-0lYwjB8xZeG09ba2LP0A&oe=69CD1BA8"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksY2QrPieEMQ7kNvwHJ9ZoT&_nc_oc=Adopo-1g6DCpQ546rV9IZpURSAyVMkA3O7mIhVVuwIJr4gf_444EVauyEvLzeXGGv0k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGRTSIpnBw8BacAaf71_IUDvbAjNOdFwQoEmcv5Mg6cQ&oe=69CD1A4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-u-GYraJYkUQ7kNvwGo8eBt&_nc_oc=Adoa2hhxPpntS8E-YRHbC-8PX7Ud3AuhXMcNpCRQkp3xEpDfFAvO_MH0LHy3xnwmNIQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwh4UUWH8CDCQ1Xjz7bQZjbBiwS48147RHDtq-DakGrwg&oe=69CD0557"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EN7yK5msZHAQ7kNvwEI4k8u&_nc_oc=AdrQ_l1dP6SazmHUfSV8-s0_RxLqABRnhyq7hWwGvpSsLfDkCFayMCDr4iWSSiMXrV8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7QOM3QJTeqsUMfkVvT4R_vBzulpCmvhybprTmEttevA&oe=69CD2D8F"}, {"file_name": "cover_cifraria_portrait.png", "id": "1470913137957685", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304019_1470913141291018_3011473396555673668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38XMX59XCWkQ7kNvwH9S-hf&_nc_oc=AdpQJvsZkx80mXUWGrq0uAbw1XqJN5YXptqDBR7netaaGwzU3M0reWb6uprSmLipBm8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJfMzt3ppFnbq_aHTH3b4pgYl-JGu6RRzp2guIgohkAQ&oe=69CCF883"}, {"file_name": "icon_app_cifraria_1440.png", "id": "1469012724923209", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499301053_1469012728256542_7416521803008086253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_
nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1y_3LO_p164wjj-9CyAK4gs63XXOtFBKl7IX3ykSqzA&oe=6AE9FC66"}, {"file_name": "home_10_settings_Quest.png", "id": "1684432329357395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819854_1684432332690728_2661215708382739758_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3W9ynlEn4dkQ7kNvwECT8yI&_nc_oc=AdpPhPWKT56MwklRmipI7OgeUt_tuhibBm7WutAWKs1W0imevKkBsXaqwc6b6X4jeq8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWeNqSoe5kKEcADdqX9Rq9tYNCDwGcY4uZYPMNIDEJtQ&oe=6AEA0023"}, {"file_name": "edit_10_Quest.png", "id": "991159246965883", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821682_991159253632549_3726168677936387175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTfAzL6zFacQ7kNvwFWN5qS&_nc_oc=AdoyJJ9TP2skvL4Ou1KZp4_-PanCoYzrJMLk8beY0lW2XjM6HGALdDkYKWhjqPMeA1A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShyZCiRQppjHIrMdHo8i45S26IDX5sMz61-KkqS1VW9A&oe=6AE9E823"}, {"file_name": "player_10_Quest.png", "id": "966149539200528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823296_966149542533861_6133643743596760205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCx85qMnOEQQ7kNvwH0Xxnx&_nc_oc=AdodAojyXubSUetDP-ql4ByQc6EddwgQW4v_TtrTAegPaAgbf5c0ncZ3_OQSQisU7xk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8uiUwY_RLObYTDt6LF3CxnY3HCI8jT-6r9LJR1m2U9Q&oe=6AE9E778"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udcdc **Setlist Management**: Create custom lists and organize the songs in the exact order of your performance.\n\n\ud83d\udcf2 **Pro Sharing**: Export your setlists using the exclusive .cifraria extension via messaging apps or use the QR Code so that another device with the app can automatically recreate the list and songs.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/18BVoWuGr5oKZaX6z0ZCklOlUod5mBmQH/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "David Kalil Braga", "support_website_url": null, "website_url": "https://davidkalil10.github.io/Cifraria_Website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_g
_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oVC9PVlWTt09GnZvHfS2ReLgQIm-JUHzmVg6d1d4Spg&oe=6A465D83"}]}, "id": "4356029028044012", "locale": "pt_BR", "screenshots": [{"file_name": "home_10_Quest.png", "id": "1471900691162468", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499307435_1471900694495801_4829947570561919049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3S5wPn36pgQ7kNvwEOvm-V&_nc_oc=AdoglvZLw-23hTr_lKVFT652GicCxloIe6HKH2bJvuXxIKABNDHyP5XJF5dnpuQm0WA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_agTG_uXPRr-vrFJRPlRAaG8TZ9Ad8MN9udptUBms0VQ&oe=6A468C4B"}, {"file_name": "settings_10_Quest.png", "id": "1391193859145570", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499308010_1391193862478903_5269474807905197381_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_8SbGxkeSEQ7kNvwF_B5IY&_nc_oc=AdpTbzrx8zLkh4v8rtFWECZj5UdXNoF4DAX2Gee0j42z1mqEmQEhe4_blZuePAzuDf0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mLQJg_-FhlNe2Le9rmZ4MPHQNCArBkDWaZrHQD5KhBw&oe=6A466AC1"}, {"file_name": "home_10_settings_Quest.png", "id": "890412220264365", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499310817_890412223597698_6569410573752295327_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoSw2NGDhHoQ7kNvwEq-mIZ&_nc_oc=AdoViNl9f1AUC0XLZ4wjM4E_U3r1AyfRfKNkOFt2UquyrwldVWcFvwdyG_KjFWSJogU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cah-zcU_RM98fad_7oXpT-MQqPcR3avpKr6S8duNKdw&oe=6A468404"}, {"file_name": "edit_10_Quest.png", "id": "1209432111385989", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499310731_1209432114719322_5500871760126419425_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3T_xnhjvkd0Q7kNvwE_hwlh&_nc_oc=Adrc5_C4-Nuon9-fh527UiOA6-_VpcM_gfU0HIGW5rn7LqntHFU1YDC66zrCgl5EfDA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zmwmg7UoFJLg5t9pmfJCm1TlKcC-TfE1H1hSGr3ZocA&oe=6A4677C1"}, {"file_name": "player_10_Quest.png", "id": "908261954943342", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499303746_908261961610008_2600051788214719246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdHGb2f3HpwQ7kNvwF9Ngjq&_nc_oc=AdraIoqMcpcPmYPueMQgczrqRq4MizQRRVO_53Ypv9JahWFLhNpvL3_vbGahSUz82S0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_W-sSoQY1T9jYqHcQcEeuGO5DHRMKzQ-rSZDKqkuxfGg&oe=6A466C62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Viol\u00e3o", "Ukulele", "Cifras", "Letras", "Biblioteca"], "long_description": "O **Cifraria** \u00e9 uma biblioteca profissional de m\u00fasicas e de gerenciamento de cifras desenvolvido em Flutter.\nCriado para m\u00fasicos de todos os n\u00edveis, oferece uma experi\u00eancia fluida para gerenciar, transpor e praticar suas m\u00fasicas favoritas, tanto no celular quanto no Quest.\n\n\u2728 **Funcionalidades**\n\n\ud83d\udcc2 **Arquitetura Inteligente**: Organize suas m\u00fasicas em pastas personalizadas com uma barra lateral em glassmorphism (efeito de vidro) para um visual premium e moderno.\n\n\ud83d\udcdc **Gest\u00e3o de Repert\u00f3rios**: Crie listas personalizadas e organize as m\u00fasicas na ordem exata da sua apresenta\u00e7\u00e3o.\n\n\ud83d\udcf2 **Compartilhamento Pro**: Exporte seus repert\u00f3rios atrav\u00e9s da extens\u00e3o exclusiva .cifraria via apps de mensagem ou utilize o QR Code para que outro dispositivo com o app recrie a lista e as m\u00fasicas automaticamente.\n\n\ud83d\udd04 **Transposi\u00e7\u00e3o Instant\u00e2nea**: Mude o tom das m\u00fasicas em tempo real com um motor de transposi\u00e7\u00e3o robusto.\n\n\u2601\ufe0f **Sincroniza\u00e7\u00e3o em Nuvem (Google Drive)**: Fa\u00e7a backup e restaure com seguran\u00e7a toda a sua biblioteca, incluindo pastas e m\u00fasicas favoritas.\n\n\ud83d\udcf1 **Pronto para o Meta Quest**: Modo paisagem otimizado e dimensionamento de interface para um ambiente de pr\u00e1tica imersivo e sem distra\u00e7\u00f5es no Meta Quest.\n\n\ud83d\udcc4 **Importa\u00e7\u00e3o Multiformato**: Importe cifras da web (extra\u00e7\u00e3o com apenas um clique) ou de arquivos locais (PDF e DOCX).\n\n\ud83c\udfb6 **Cifras Interativas**: Acordes clic\u00e1veis com gera\u00e7\u00e3o autom\u00e1tica de diagramas, com suporte para Viol\u00e3o e Ukulele.\n\n\u26a1 **Foco em Performance**: Banco de dados local para carregamento instant\u00e2neo e funcionamento 100% offline.", "short_description": "O Cifraria \u00e9 uma biblioteca profissional de m\u00fasicas e o seu aplicativo definitivo para gerenciar cifras."}, {"images": {"nodes": [{"file_name": "icon_app_cifraria_1440.png", "id": "25137093062632621", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499303140_25137093065965954_5340243871155545084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evbQZXcvjbkQ7kNvwH-lmsu&_nc_oc=Ado5AuKsEfD6SdKwAiP98hQzqx2YvQ2nFZ8HQ0ZzkLWZAy12tOUTLyayIHPfuFv10Do&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Pmqw4DUj2HhGBnVR4nvqOXyKCE7_NB_qgCRvzx6LuMg&oe=6A4672A4"}, {"file_name": "icon_app_cifraria_512.png", "id": "1950929249182186", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499308090_1950929252515519_3579238828299289210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZXngPxBkBMQ7kNvwFbulqm&_nc_oc=AdoxhxFucVRI3cvQXaUwMSwrdOm7g9KcvyXWutsHKKmq7-ZEClJP9eDmfWHiDnJJIG0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tCUzhaJLVsHKNKQ0QGdboXAh4uUMeWKsJb8G4FL7a3w&oe=6A46757C"}, {"file_name": "cover art cifraria.png", "id": "1221596580110880", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499307422_1221596583444213_1996221161851683055_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQU84NqkYdoQ7kNvwGVKY4Q&_nc_oc=Adrzy6waHBoa_in7R29GTIKVm5RAQDmRONHtZOsCGLgjod02ZxB_hpZKus2ElMA9La8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YF4lbHcTqrDv4GvuFoK8wav5SUio4JEZQY_1LEpOTTA&oe=6A46606E"}, {"file_name": "hero cover cifraria.png", "id": "955328883720100", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499303140_955328887053433_2299564742518944745_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeySm2IZbYcQ7kNvwHdf7sf&_nc_oc=Adog8suR54KrHCamH5vDtUITvMMD--mYubKklnGmo42d9Rdm_ci2zb7ZM5cDY8Zz3eE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9v6L8TFDXwVZYrWHPiZb3Ufw9PfgLYTR4U_GSEVZmseA&oe=6A465A09"}, {"file_name": "cover_cifraria_portrait.png", "id": "923398230271609", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499303790_923398233604942_8149238291275724655_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30bjehW2fE4Q7kNvwEnMZL-&_nc_oc=Ado0-DgLpaPdr79A6TasxYMkqBMtY_BKRyERdtGBngnk6AatOvfLkYC1nTk3tLiW_-g&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IjK2AsueZfih3YXqLT8SzHgd7f8dysITY5a6Q65UMxg&oe=6A4669D6"}]}, "id": "2120506675398089", "locale": "en_US", "screenshots": [{"file_name": "home_10_Quest.png", "id": "1645036636740857", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491819323_1645036640074190_2595786236772761378_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqkhgQpgjvEQ7kNvwHNwAEo&_nc_oc=Adq018Xeong2yDQvfriCiyB6gkOyUwssqdQoc0WfYC45K0XsKKCpVQ5_gNigXyb_fqs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6KyKmlo1LFRG6FyKxCtLsNVLGwssQ_YWtg33AFrDQjQ&oe=6A468DB2"}, {"file_name": "settings_10_Quest.png", "id": "827413820421285", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820855_827413823754618_7016173846081243344_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSqAnzQZNS0Q7kNvwEpuA0O&_nc_oc=Adr0c9pr4SoSVfKdijMznavsW_eFTNYOeGYYN6_JST6AzX--d_mu03prdMLNyiojAQc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AaV7a8Hh0gmG7ZyAYA_N3bbjVh4VtLysS4G1wqsRMYA&oe=6A468266"}, {"file_name": "home_10_settings_Quest.png", "id": "1684432329357395", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491819854_1684432332690728_2661215708382739758_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Gl--pGXezAQ7kNvwG5Qek2&_nc_oc=AdpDXZ-lFV3ik9hXoKdLxxcJ5r4TaO4ZW6tP9g4eRzfYmtl1DI3LVsFn7lzPCLuTqV0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-bJ3rDUgFqgwbVd-RIpjFWEeMVLT860JbQsJvK_vV0A&oe=6A468623"}, {"file_name": "edit_10_Quest.png", "id": "991159246965883", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491821682_991159253632549_3726168677936387175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8mCmMUAbccQ7kNvwFzO9BE&_nc_oc=AdqvxlvEHs0X2utrYlpkHQ_swjEQ0P09KsDUuRWUyyLX6UhzzsVXXfowFfx_CQ2gqC0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jkZG8lb7MzX_dR6qi_X3tGm2MGQmdxMojJ6tI8hLDIQ&oe=6A466E23"}, {"file_name": "player_10_Quest.png", "id": "966149539200528", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823296_966149542533861_6133643743596760205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1AhwlK7WXMQ7kNvwFk_Cr1&_nc_oc=Adp1WwK7OT2sz8HB6wtbnSaxoPcV41EhL-nLIdb2RBjfXCKTDi3cIEM3hS_DiLRUkV0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FlyvGLeoM2m0Cx8tBc12J3-AyZuYFJVeJyjPZHBNOuw&oe=6A466D78"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udcdc **Setlist Management**: Create custom lists and organize the songs in the exact order of your performance.\n\n\ud83d\udcf2 **Pro Sharing**: Export your setlists using the exclusive .cifraria extension via messaging apps or use the QR Code so that another device with the app can automatically recreate the list and songs.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/18BVoWuGr5oKZaX6z0ZCklOlUod5mBmQH/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "David Kalil Braga", "support_website_url": null, "website_url": "https://davidkalil10.github.io/Cifraria_Website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langu
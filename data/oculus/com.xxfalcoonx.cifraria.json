-VdhJtgiEbDkM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Z6JtIBfenDg9Wj08t1IJPHRZ_kTu6PfGbR-ApvdqZMQ&oe=69D4F06B"}, {"file_name": "settings_10_Quest.png", "id": "769903052409522", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307962_769903055742855_5369264695749606127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVE4GsXi3YkQ7kNvwEAMn0y&_nc_oc=AdqCHNrrTvSlmRDQlByxtGqLy6l-JhfE6XkFkuVpZ2eki2vcBlAIiZ-Dbm5t6nH_0Lg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2m6ySVrTZ7ncJ-M3SsQXjDtJnKpAr2lI-r2q3vVHWtXQ&oe=69D51004"}, {"file_name": "home_10_settings_Quest.png", "id": "26256487057309894", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499298291_26256487067309893_260636835105670560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9erPHmv3tUMQ7kNvwHGIDjm&_nc_oc=AdpWNdOOr07EQXaU__J0kFRa-nMJRpKsn8YF_MKrgrwjIUzffBJJnrcFwM2Te5DOXmw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-Z-rlYIo6Tl2LS6WqC_gHyzb8F2_cRgM7zD62IRDf1g&oe=69D50004"}, {"file_name": "edit_10_Quest.png", "id": "791165707365094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnkd6BjYgOMQ7kNvwFcSmAY&_nc_oc=AdqTRh4BpiDjy-Ybv9M4EQ6lmAHUCkEptAtsvmLcCHK7FXCtBy2qyV1Eta0ULNkfBXI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JvXBZvc7qTKKjWDyXtTs4pHwoka7PGDrAD2xQcMUNsQ&oe=69D504A8"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2tor29iEUsQ7kNvwFkkPh_&_nc_oc=Adrgcd5vGZSntBUDE8_ZIW0QvGTonzCmD1KR0aY2Kz3YO2a64n-nJcbEuWlc6f3SU3Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pdngRxxTnerbtU6SvoNta0Rjh2dhe8dJ6lAkljf9uHA&oe=69D5034A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUKJSzZkfWQQ7kNvwFZVJbK&_nc_oc=Adr-lKzhQMIJ-jZG4EOjQe7kNU0jprxuiHHN8vMGULBR2ZXXqGYIKCvLlZ6Jxrw_VGI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OxCBzzmAg3Y5IjGYWvkSiQLCHlp1Qp49JYhBPkGD0uQ&oe=69D4EE57"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "u
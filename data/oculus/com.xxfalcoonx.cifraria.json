oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3UuoANJaxYQ7kNvwF6SI9A&_nc_oc=AdoquU0XKxLoKFPYTqYR9LR6d5KRPxYj4QgEz9scugF2x9woLky62FZOanWEvIp-118&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyapzTiHz4EEcy13REbYcRHYdaBPXwFl2eG2H5ZsRQA7g&oe=69C532A8"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CC3gyIWEG3MQ7kNvwHVcXAS&_nc_oc=Adq85NWT3uy5C3HTr0rOfTVz7-qryJBYKtrsrm-ISMgs81I-NukoPQHiy0GS5DGbAlo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw37hIvMcNbopftTw_38FLrgCUVAaZV78EHX21ZydQgCQ&oe=69C5314A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=og2Ckby7ASkQ7kNvwHZQgmy&_nc_oc=AdrL-fBpIQMtDzD958xhgWNUa0L_dJpz5uHrRZoraAkOdYSTlfrHNBI_VSeeJrL9Aos&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwzTorNBh7tgbowNYga_eYe0m6cRNP_pEjLeROOD-WDag&oe=69C51C57"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDDQAhfdNXAQ7kNvwEQnHpH&_nc_oc=AdrjLRqR1gNF_dFniKhbxaqZDU_b3iuSL4P7bgBX2mc6zJ7YzuyugnLFEeM8bD9Iw1g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxzNGIJXkxvVhbYRnqFtaPJqNCB_uiOEwNfdkZfnx7UhA&oe=69C5448F"}, {"file_name": "cover_cifraria_portrait.png", "id": "1470913137957685", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499304019_1470913141291018_3011473396555673668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dvb_25Wm690Q7kNvwGODpGq&_nc_oc=Ado6kOx2Q8HdpT4KWKzJUDcZVeFDEHvRFlNKHKIvAKD77g7tNYty6OGZ1kDCx0yFGIw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-brLFA0yC5zZhcKFUzvRMJvdl_OFfanzZyl1da6DPFQ&oe=69C50F83"}, {"file_name": "icon_app_cifraria_1440.png", "id": "1469012724923209", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499301053_1469012728256542_7416521803008086253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_
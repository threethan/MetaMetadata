2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIk1QgZCrEJqQkUU5qgVdGHDhD8Fn1POxaipaolNz7gw&oe=6B0708B2"}, {"file_name": "settings_10_Quest.png", "id": "827413820421285", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820855_827413823754618_7016173846081243344_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwsKMQ-sYEcQ7kNvwGfVIop&_nc_oc=AdoyjUCMrGXEr5JJ1kji-_LdhUr4e5oT8y7r9eBCzUkXnvYEZCk85GpAly5Rw0WMR0w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0gz61jDIcip0lwWkioFnMUcUU1EJU4NWaKsdHLCVQEQ&oe=6B06FD66"}, {"file_name": "home_10_settings_Quest.png", "id": "1684432329357395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819854_1684432332690728_2661215708382739758_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocjzoofMfxgQ7kNvwHCJaID&_nc_oc=AdruXUM9RPLnpjeohr5zinzVWjmDjGFvfezx_NpQKvKtWUKcTJDaUjpswVJaHeal1n0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToDqk4P1ejdgZB1IuqoMdo1geTGVii35d-xu2RXxuyng&oe=6B070123"}, {"file_name": "edit_10_Quest.png", "id": "991159246965883", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821682_991159253632549_3726168677936387175_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nip-IY0zEfAQ7kNvwF7He7c&_nc_oc=AdqUgO1yXT5Su5kB9TaHjcd43wi0_tqH2ZJk-fC9HAAHZsZjgO9gCL1YrSGvS8lzxtQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsZzakATTfUdxwDQW5IuAXg2RBLeGMo1wlfhISYHTgfg&oe=6B072163"}, {"file_name": "player_10_Quest.png", "id": "966149539200528", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823296_966149542533861_6133643743596760205_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOFYdNAwWFQQ7kNvwF-PT8p&_nc_oc=Adq1iPL8oNICaldEqY9lmE-Q4waK8PRpDxy7AkFJQ1cPZxqc2Xsr-Wih700XAPnwaS0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDkN91rKaEdbHlvD-S5V2bizvIT559-7PW9HkfBBF5vw&oe=6B0720B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udcdc **Setlist Management**: Create custom lists and organize the songs in the exact order of your performance.\n\n\ud83d\udcf2 **Pro Sharing**: Export your setlists using the exclusive .cifraria extension via messaging apps or use the QR Code so that another device with the app can automatically recreate the list and songs.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/18BVoWuGr5oKZaX6z0ZCklOlUod5mBmQH/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "David Kalil Bra
&_nc_ohc=wDHnn2eDmsAQ7kNvwF8CHVr&_nc_oc=AdmljHx7Ic6IEG6fP07t3Vl_qTi7dcQLcIUionf-0n-my3fWhNrz1d4TsjSRkx11ab0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftMNxSLaIIfWk2fI0h2AVNr33ol8AEgGj3oNyZKa6Hu5g&oe=69A59A04"}, {"file_name": "home_10_settings_Quest.png", "id": "26256487057309894", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298291_26256487067309893_260636835105670560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nPegFZmfwwQ7kNvwEjUDyp&_nc_oc=AdlSKWzxtESxC4l_x9LJfLPMLH_B87Vjdenbinm4svitmqe-gaOTGc8394xN8Bvz0Yo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afub4pt-tmHVu9VIjx7whtLoTUU7wJQKqjcVA4AptbmdJA&oe=69A58A04"}, {"file_name": "edit_10_Quest.png", "id": "791165707365094", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VcUR53j8sBkQ7kNvwHqTlmU&_nc_oc=AdlMpF9lp7Ops2XK-nEd3dBR_TSELOisddO1-AqXX1-_ORDJBVe5ihTAU3CYLZc3fvk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftxG0N1NKxeSGGR1RIWEtZFQxTYSjxXwhFb0-_vI3rzcQ&oe=69A58EA8"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MTcoq4l4ksQ7kNvwH120bn&_nc_oc=AdnLEg9gzrfrusd_1eHK0X3bGLDCi34YDFDXT3N0-qlTejifv5UcDV9yAHbBU9D20N0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsBtwP736DtIYZV3d3OC0qw0rXULq63je8k8VgGgYI7HQ&oe=69A58D4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYSsiArzedUQ7kNvwH7nk3l&_nc_oc=Adl4aeutvu0gTK8omh1xbz0bDhzcuDXFJP_dWbua4uvZ_OI9eBBzubRADpkvxNcTTvQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftnCPY3zjM15329fES1ea27WTpuSgCZXEXtstG0H0ykOQ&oe=69A57857"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llARPypnSNAQ7kNvwFpqk6S&_nc_oc=AdmGU9ak5Tjlk8vWLDaQv27MprkEE4-ex_O4AYvAfeAud0qHqD79CzxDjlrMfQ_XTW0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afv-UPC-lOVp4HgAlQgnc_IAvAhRDqf6fpPbpaFYNFQPeQ&oe=69A5684F"}, {"file_name": "cover_cifraria_portrait.png", "id": 
oSnfyHX7H5UBQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxebuJIAdiWz9I5kbrljkL2awD80rrNE8R9PJeTeymHIw&oe=69CD076B"}, {"file_name": "settings_10_Quest.png", "id": "769903052409522", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307962_769903055742855_5369264695749606127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyFJytnO4kwQ7kNvwGshZeB&_nc_oc=AdpvkjwH7p6U_PteJymslq5K27hJ-xJGT9qR55pZM-5mfJYJG3u6EmwLQIq7Ng6Pn60&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwU94-kT8sb0yorXmqsvAm9K9Pkcp6LthvtLRFjnz26aQ&oe=69CD2704"}, {"file_name": "home_10_settings_Quest.png", "id": "26256487057309894", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298291_26256487067309893_260636835105670560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INPSEJH9T4YQ7kNvwHNqIp5&_nc_oc=Adp5UTNeKoYNbielp6q3yB-r6MsiG9HVoqpBRNF5fxj5PKBKeKk1u92dSRSp6Zf3uQ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzhil94VNSTC5RHa0Sajawc7ulP-JNq3Hy3YWYhbi8UFA&oe=69CD1704"}, {"file_name": "edit_10_Quest.png", "id": "791165707365094", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPGmMCmkieIQ7kNvwHwRFR0&_nc_oc=AdppCf-EZ-0HhqSvuCr00ntmkt7dktWs5IwnQnXSzp3W-25F8KWgpgonGv2ixl7oE-g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTmLYsiSWaUXkqdE5D8vrFS-0lYwjB8xZeG09ba2LP0A&oe=69CD1BA8"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksY2QrPieEMQ7kNvwHJ9ZoT&_nc_oc=Adopo-1g6DCpQ546rV9IZpURSAyVMkA3O7mIhVVuwIJr4gf_444EVauyEvLzeXGGv0k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGRTSIpnBw8BacAaf71_IUDvbAjNOdFwQoEmcv5Mg6cQ&oe=69CD1A4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-u-GYraJYkUQ7kNvwGo8eBt&_nc_oc=Adoa2hhxPpntS8E-YRHbC-8PX7Ud3AuhXMcNpCRQkp3xEpDfFAvO_MH0LHy3xnwmNIQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwh4UUWH8CDCQ1Xjz7bQZjbBiwS48147RHDtq-DakGrwg&oe=69CD0557"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "u
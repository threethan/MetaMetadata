2u0ooYGQunPFVNCkg&oe=69BBE3EB"}, {"file_name": "settings_10_Quest.png", "id": "769903052409522", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307962_769903055742855_5369264695749606127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oP-od65xb8EQ7kNvwHvKlVY&_nc_oc=Adm5367wyAlbnwIryxpO8ZnNoaRyPMCydBeUBg66yTGOYiEZAapAeDYp-pvVMzUQdyY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzgWs687iK2g_TAzZqqqueSBGj3GUSKafowYSnOZnpgnQ&oe=69BC0384"}, {"file_name": "home_10_settings_Quest.png", "id": "26256487057309894", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499298291_26256487067309893_260636835105670560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEjaG3_O4HAQ7kNvwFuFQ8G&_nc_oc=AdnyUEHN1bUDKdSUElL0BY9vSedMbvAVVbp8y7NoYXfQp3qu4nNnTgSTZECycnUel7M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwAavGOxlndM0sOVLwfPD1fHCcA73-DVQ19sqINagYp0A&oe=69BBF384"}, {"file_name": "edit_10_Quest.png", "id": "791165707365094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnoKWL7Pg4QQ7kNvwFPQc8F&_nc_oc=AdkyFTS7YDBDfIMueO_ycrwg05qIpgVmdTKCmZ0713i5cA482vs2eI0RP18o3pLusP4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwdOLwAIdbaU8o7d56Ed3kZBqTb-2GOLSFdaXHdOiGZ4w&oe=69BBF828"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhTIpY5ikesQ7kNvwEPon5-&_nc_oc=AdmjHgyiUbXoD3nlVF7td_Hi6dwdRTQrUhahZa4p8LNfRVVGVYSlgnGloQb9hVzbVdo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx5K5dvzlXs4mXbVBGfnq1XoUjn4mQLmDVZucTTMielIw&oe=69BBF6CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNVDex-GBFkQ7kNvwEFhfN2&_nc_oc=AdnHIgHJY7sZ7Uucod_u2uHAlGd5uilH-ygasy3ySIod5DqIxIiETVj7YsFsTUSqwkc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxZJLdeWKEmO1lj-yDXKqAlLTou7t7SzwRaOjBREPFbrA&oe=69BBE1D7"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7
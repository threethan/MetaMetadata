7a0a&_nc_ohc=RVk9x9R-5h0Q7kNvwHh_NUm&_nc_oc=AdnugPYth2DUY-Vfh35y_ysNaE_r9XWyehWUriq9nnORLE61DYXWJlPtf7WRHdHmRWo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvRq-CWoVGhnP0-l5FluYw5803aiVklZYYnIrViGcINCQ&oe=69A2F704"}, {"file_name": "home_10_settings_Quest.png", "id": "26256487057309894", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298291_26256487067309893_260636835105670560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKc2maxEd-8Q7kNvwF7izkH&_nc_oc=AdmC-RA6QkUNxCdX_OP9jiqwP3aQeD-ajBVkZc90A-E0BkU7IzfAFhJlLpLatoRtTJw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvwbksqlXLTbdsCoKqgF4TviVf8rL4PiKsBhb9f0LXwfg&oe=69A2E704"}, {"file_name": "edit_10_Quest.png", "id": "791165707365094", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VcUR53j8sBkQ7kNvwHcW3QT&_nc_oc=Adm67f477THScxUP_AUm3TappW2rc_yEUMkVY6155aJL_1CWPO87oFYFTaGluEvllJM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuTLlnIqmKEQ8JJCEn24tcW9lKXLme8MKEXUXy_heInnw&oe=69A2EBA8"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9lXIXF3WqwQ7kNvwGVRtvp&_nc_oc=AdkManV8TI9_agr_Ju16CNEHFopBFsR2-YS86jdU_VpND-HFnUBtsmsfGgA4sJWW8PU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvd5WwKuVw1dq0h6ABYr1mxEz1CI77EbwjChAZBMbeL8g&oe=69A2EA4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8jhOFMoloYQ7kNvwHwBL9m&_nc_oc=AdlRKpyMV9eoZtzyK1yHp7gSh_ic2u0Iag29-UL74k9Ff2yt1kM3z6vEt79-CHxLUjU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsz4hflWlwwSgG374N9YYzFiTD06Pr7LjxNjGAfOk9pog&oe=69A2D557"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llARPypnSNAQ7kNvwGBPCwT&_nc_oc=Adk4kUjXvTQF-Z6XAN-loNrk-1W9RhY2j1okiNyEEjgvKCml9ccTwa-MTfoMsLG-EqU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsTMzAYHCdCvFPcPjdMkrpoIXY67BqHrgcb4WwfVGZzjg&oe=69A2FD8F"}, {"file_name": "cover_cifraria_portrait.png", "i
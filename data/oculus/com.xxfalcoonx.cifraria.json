2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTHmDQ9JgeTh0M62Qxbx3NaoOHrz2a3HQSW-J7AOPh1Uw&oe=6B0B3572"}, {"file_name": "settings_10_Quest.png", "id": "827413820421285", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820855_827413823754618_7016173846081243344_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkIVkQa4aBoQ7kNvwGjTQ1I&_nc_oc=Adoe4QSWtEfK25kyMkUd91_P57UU8tlLwwf3z2WFCeMJAsQLyC4JzGgrbgYCAdRV5go&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQFRIZjCGnbEs5qo-SMwcmu8glFh6sRhrfBYx9C1hmTXg&oe=6B0B2A26"}, {"file_name": "home_10_settings_Quest.png", "id": "1684432329357395", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819854_1684432332690728_2661215708382739758_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Gemy6HhYPEQ7kNvwG3y2Un&_nc_oc=AdqLrmGdjmy7HxjmyqP6o0locg0Lo-1BUaGwzy8QHod1WqenmQDm6jhar8rpNsPKV1E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQwT3Iy-cn4d3o1zs--kQ_NnuBZuFApttRzLABbcN5jDA&oe=6B0B2DE3"}, {"file_name": "edit_10_Quest.png", "id": "991159246965883", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821682_991159253632549_3726168677936387175_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVv9gTroYeMQ7kNvwE75C67&_nc_oc=Adpl9heLVuF_u7N2s12RZP8P1Uk3DwHxmHhXoRTcindQjTON_c6nbZgsOXZ8OXo8saY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRRXNVNuqAkSrAU3sF6ZO3Siy9s3atO12p48F-RqACzkw&oe=6B0B15E3"}, {"file_name": "player_10_Quest.png", "id": "966149539200528", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823296_966149542533861_6133643743596760205_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrriPFQ-zkcQ7kNvwEoicco&_nc_oc=AdoQJxBofCTfy0gbjwDERESFfsnMTpWBxXsDfADXaiM_86fqfXJtRxSKDp7GwbEFx5M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTtZJ9G181KK5cn_Chvh3lLgNKWVp9uA5lRu-b82y9J9g&oe=6B0B1538"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udcdc **Setlist Management**: Create custom lists and organize the songs in the exact order of your performance.\n\n\ud83d\udcf2 **Pro Sharing**: Export your setlists using the exclusive .cifraria extension via messaging apps or use the QR Code so that another device with the app can automatically recreate the list and songs.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/18BVoWuGr5oKZaX6z0ZCklOlUod5mBmQH/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "David Kalil Bra
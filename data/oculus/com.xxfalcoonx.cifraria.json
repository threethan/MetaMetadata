12454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KokOSjTmxuIQ7kNvwFgJxDF&_nc_oc=AdlImqX7msrvguGfaQ3b7DF3DrGnHzgIjWBfhXFO8MLrc3sgAU5qRmUEBec5ads_AfE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOApY3NPA0Jqhawba_aZMxX-mDuS6bSDMSyG321uwUnw&oe=69AC2628"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0Yo3JEvV_YQ7kNvwHZJGTN&_nc_oc=AdmAZe315hKUbWzS12JNc-BOq1rN4IMH3Ws_75zQPGbldkfc1rAkM_0E2tx-HfBqa34&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz9AW1eJH_0CbaQn3Wk7_W_35k2uLSqHyifgzN7eauj6g&oe=69AC24CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pelG5V0BZAQQ7kNvwHQSQii&_nc_oc=AdlrHP8uy4RpYESNqbTFVR0x0th19dyL-6DCG7wEPFNafITlzYZA4t0mEhNTXRXptQI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyA4pODYp0k31oxYc4yfu3AXpZGmQ_5EVo3MK03afKrKQ&oe=69AC0FD7"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnpIRokO5kAQ7kNvwH9sggc&_nc_oc=Adny0IpsJcGENmmuvJGCdTv5dg7AQOklCTSkd_NxjzkOjiQng6P87uqeOcUKw4jIpGg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx5FODRCP9RLf4b4o0isN3xtr4RhWh8DO4j9lwdMxqzSw&oe=69ABFFCF"}, {"file_name": "cover_cifraria_portrait.png", "id": "1470913137957685", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304019_1470913141291018_3011473396555673668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huxUUN0GUkAQ7kNvwF6Nz65&_nc_oc=AdlpM06JX7EGUyT3x8bBvX5VM8HnW0oTYnUcMd3HPFfnleIjnLkAubVVMnUX6BWEV1U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwYqEl6ZGP2KTE73Ei183v6GpFKydQdPuTm18aCrRNcOw&oe=69AC0303"}, {"file_name": "icon_app_cifraria_1440.png", "id": "1469012724923209", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499301053_1469012728256542_7416521803008086253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3Fsf1h3ngoQ7kNvwEgtjFV&_nc_oc=AdlhX0qghpm6BxsEo
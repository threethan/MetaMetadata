2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTu-VVeVfYJ0m5FFAcqNYgGLo3Z5r54VT1iNbUDrF5Mpg&oe=6B085A32"}, {"file_name": "settings_10_Quest.png", "id": "827413820421285", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491820855_827413823754618_7016173846081243344_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkIVkQa4aBoQ7kNvwH42j6Y&_nc_oc=Adq_1AorL8gabZ50RC5FuI1b9gzuaK7Or7eXy0Nrj1T8ao13ODsJxZ6sM6hBIBv78gQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTe8nLLjXYxhGJ366IrNt2poRs74P0uQ6smiL-gj9Dgg&oe=6B084EE6"}, {"file_name": "home_10_settings_Quest.png", "id": "1684432329357395", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819854_1684432332690728_2661215708382739758_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Gemy6HhYPEQ7kNvwFD4tYo&_nc_oc=AdoNRsOB5Q_iskix1aBN6iYyfFczsMqWOTXhThV07DuSeyX4J3duoKJZxeOJilVs2vc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8ILr3KP8ck3M9FzFXESFyXaJUiQj_xZnUQzyok5sjsA&oe=6B0852A3"}, {"file_name": "edit_10_Quest.png", "id": "991159246965883", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491821682_991159253632549_3726168677936387175_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nip-IY0zEfAQ7kNvwGbvjpa&_nc_oc=AdpECw_cHpV2IXjbgjhU-t_hjmvk14wD9jCaaSN8L6OHePhw_d0ix2lKUS0sUrhFaPU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTg1JgW7pEZUG8vHywGLkozcXU2cepKjnim3qxHyrAqWA&oe=6B0872E3"}, {"file_name": "player_10_Quest.png", "id": "966149539200528", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823296_966149542533861_6133643743596760205_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOFYdNAwWFQQ7kNvwGwIJ6A&_nc_oc=AdrpQ5DOiP6eQyx51GsFzvBjd8NK-0gXO41Qr8k5xvDMw8uCItWd81ZBq5a2YJWQK8M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzGZTym9j-L1Y6VAOJOBb2qXTmCVVaHWe5ud-1c65feg&oe=6B087238"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udcdc **Setlist Management**: Create custom lists and organize the songs in the exact order of your performance.\n\n\ud83d\udcf2 **Pro Sharing**: Export your setlists using the exclusive .cifraria extension via messaging apps or use the QR Code so that another device with the app can automatically recreate the list and songs.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/18BVoWuGr5oKZaX6z0ZCklOlUod5mBmQH/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "David Kalil Bra
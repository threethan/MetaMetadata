content-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjqP-VpEUf4NoBqYE19FfUZh0imiXhpN-pLWon1WC86A&oe=6A58D283"}]}, "id": "4356029028044012", "locale": "pt_BR", "screenshots": [{"file_name": "home_10_Quest.png", "id": "1471900691162468", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499307435_1471900694495801_4829947570561919049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iINxGmIZI4AQ7kNvwHCOBLf&_nc_oc=AdpGU9I73Yjfy7LOVk9WjQAJLKBLQS3pbvLxpbnkS6ZjbOwYTcVDbP5MY4ym2PlCggo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoPfq2RA6V_Yv1s_RHPzzkEMisoy0YuzwPIVGtq6fEMA&oe=6A58C90B"}, {"file_name": "settings_10_Quest.png", "id": "1391193859145570", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499308010_1391193862478903_5269474807905197381_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLEOMxeKieQQ7kNvwGIt8bk&_nc_oc=AdpVLQlvveJEy1kRv1rZp4LGUm09De-8IlS_DRBOZLvMgKkAVtsFVpLJ-WBQEsGTQH0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSAdYUpOBimm0Xm4pbhyX0WXUm19CnlcrmSSNilWK6_Q&oe=6A58DFC1"}, {"file_name": "home_10_settings_Quest.png", "id": "890412220264365", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499310817_890412223597698_6569410573752295327_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROkYyxHWqgIQ7kNvwHZ7Yme&_nc_oc=AdrFgfMpXqBIUk12CVMOkqeggP-UFHienvGraMMdMSbcfujJQux1tzv3e4Frf5ccPC8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChykK1YtJEM8jgYsIw3uHSrl5qpqbkwxNQZyYNJYlt7g&oe=6A58F904"}, {"file_name": "edit_10_Quest.png", "id": "1209432111385989", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499310731_1209432114719322_5500871760126419425_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOryzdZXL0UQ7kNvwH0sAbd&_nc_oc=AdosYLeMii7yjsFekp796EzjRzpbJaCHoh3kIvaupNBm_0PSl2vslhvoIKWsuKDNo8o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTCYb31SMxN0qIArdP6YlnQvr2_6LMzyJTUbA1Tdaf6w&oe=6A58ECC1"}, {"file_name": "player_10_Quest.png", "id": "908261954943342", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499303746_908261961610008_2600051788214719246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7x0fmOXcr2cQ7kNvwEc122q&_nc_oc=AdpMqQRoGYVd3w9IlVhYWOaYI_TWEfNQfZI3K7PB_7WTCaz8M5sGM8gVtrQF5_stNIs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZ4O1FoACXpbJPTCl1JaOEaPQP6FHgZkMKEUli48u0EQ&oe=6A58E162"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Viol\u00e3o", "Ukulele", "Cifras", "Letras", "Biblioteca"], "long_description": "O **Cifraria** \u00e9 uma biblioteca profissional de m\u00fasicas e de gerenciamento de cifras desenvolvido em Flutter.\nCriado para m\u00fasicos de todos os n\u00edveis, oferece uma experi\u00eancia fluida para gerenciar, transpor e praticar suas m\u00fasicas favoritas, tanto no celular quanto no Quest.\n\n\u2728 **Funcionalidades**\n\n\ud83d\udcc2 **Arquitetura Inteligente**: Organize suas m\u00fasicas em pastas personalizadas com uma barra lateral em glassmorphism (efeito de vidro) para um visual premium e moderno.\n\n\ud83d\udcdc **Gest\u00e3o de Repert\u00f3rios**: Crie listas personalizadas e organize as m\u00fasicas na ordem exata da sua apresenta\u00e7\u00e3o.\n\n\ud83d\udcf2 **Compartilhamento Pro**: Exporte seus repert\u00f3rios atrav\u00e9s da extens\u00e3o exclusiva .cifraria via apps de mensagem ou utilize o QR Code para que outro dispositivo com o app recrie a lista e as m\u00fasicas automaticamente.\n\n\ud83d\udd04 **Transposi\u00e7\u00e3o Instant\u00e2nea**: Mude o tom das m\u00fasicas em tempo real com um motor de transposi\u00e7\u00e3o robusto.\n\n\u2601\ufe0f **Sincroniza\u00e7\u00e3o em Nuvem (Google Drive)**: Fa\u00e7a backup e restaure com seguran\u00e7a toda a sua biblioteca, incluindo pastas e m\u00fasicas favoritas.\n\n\ud83d\udcf1 **Pronto para o Meta Quest**: Modo paisagem otimizado e dimensionamento de interface para um ambiente de pr\u00e1tica imersivo e sem distra\u00e7\u00f5es no Meta Quest.\n\n\ud83d\udcc4 **Importa\u00e7\u00e3o Multiformato**: Importe cifras da web (extra\u00e7\u00e3o com apenas um clique) ou de arquivos locais (PDF e DOCX).\n\n\ud83c\udfb6 **Cifras Interativas**: Acordes clic\u00e1veis com gera\u00e7\u00e3o autom\u00e1tica de diagramas, com suporte para Viol\u00e3o e Ukulele.\n\n\u26a1 **Foco em Performance**: Banco de dados local para carregamento instant\u00e2neo e funcionamento 100% offline.", "short_description": "O Cifraria \u00e9 uma biblioteca profissional de m\u00fasicas e o seu aplicativo definitivo para gerenciar cifras."}, {"images": {"nodes": [{"file_name": "icon_app_cifraria_1440.png", "id": "25137093062632621", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499303140_25137093065965954_5340243871155545084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JfHE1pYSeYQ7kNvwEH-FtR&_nc_oc=AdpYv1GRfWMjyEjudGFKiYiL9FuKe2gRUr35PTg7Qqv94uOW7UB6JZd7rPTB6k-JcBc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtnit60yDxZikkXnlwOTWqUGl-zJWSgtKwmeSbEezfSw&oe=6A58E7A4"}, {"file_name": "icon_app_cifraria_512.png", "id": "1950929249182186", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499308090_1950929252515519_3579238828299289210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OISGekMEukQ7kNvwFIXDMI&_nc_oc=AdpyJAMyp3kcjW4jjqT1N11AGVXPwQG-iaHKmX982bPfaSBQeoavuw2LfeQ2g05mVjE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAf3oSiTod8YQ_kUEswCTh4v6MHY0gOndgd4Zq0OiMBSw&oe=6A58EA7C"}, {"file_name": "cover art cifraria.png", "id": "1221596580110880", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499307422_1221596583444213_1996221161851683055_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5scRukugzYAQ7kNvwEDjaSy&_nc_oc=AdrX5uFgjz5RXM_7QwT4239F9mf4qnPAfAVWqndHoZC01pFeRlC9oSe70R1cnWyKphY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQeWHyN0siRZN6lf5lL4WRseQ7wWh2T57krSRW0Y6KfQ&oe=6A58D56E"}, {"file_name": "hero cover cifraria.png", "id": "955328883720100", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499303140_955328887053433_2299564742518944745_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtV323DbMosQ7kNvwGPNprZ&_nc_oc=Adr5r4gSmEir1vSmfJTZoM5zYhPWUJQQ8qguljMR9aEyfhMSGMpayiDIwzPFjldZHWM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZlMUdYP935wxN8EDVam5_6Kum-DVr7JSIyfCuZ7MMPA&oe=6A58CF09"}, {"file_name": "cover_cifraria_portrait.png", "id": "923398230271609", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499303790_923398233604942_8149238291275724655_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WdhbAJ4PgwwQ7kNvwHCRWSI&_nc_oc=AdpxOWpNr9pvG8kQlu-ieqQPM9zNeaFdI8XwNB2FNSLo-qe2eYhRKM4vrcoVpBF8jqY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFmVRycIPxnFAg0e4okwCBlLrI-gYUumy3dlhpa2ps8A&oe=6A58DED6"}]}, "id": "2120506675398089", "locale": "en_US", "screenshots": [{"file_name": "home_10_Quest.png", "id": "1645036636740857", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819323_1645036640074190_2595786236772761378_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDGnEh7ShTsQ7kNvwFXLSqf&_nc_oc=Adph3oQxA9l6FtsoG_AKELUOPxfcGkkJVmE4JudDU1ClekWo_Lu1X_V3jHWNT6KC0d4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDs9gy1Pa9RBpmvC1t_R6pizS4GBAhAMAr-OQPOrDLSXA&oe=6A58CA72"}, {"file_name": "settings_10_Quest.png", "id": "827413820421285", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491820855_827413823754618_7016173846081243344_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODcatGGL9poQ7kNvwF8Fxe5&_nc_oc=Adppsny63ZV23gnUokme-r628qZC7LfQEU5HVXMkvv2ngXBSTAHOwMmQIGgj-pfpoZk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGEo-fie2ofS9OJBcxAahvWYNj4iKzTnabYtyRjObYKQ&oe=6A58F766"}, {"file_name": "home_10_settings_Quest.png", "id": "1684432329357395", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491819854_1684432332690728_2661215708382739758_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2JpgOQlRT0Q7kNvwHCODe0&_nc_oc=Adr5B2-XHyMny5_l-f1vVrTTr9HHdRzIBEqc6l2O-pfttFe4C9EeLnaI5VDIUB8b9Ec&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvp-zKkMSE8IZsVmaviAjIJXzcniFiX5k1pQrWMLWisg&oe=6A58C2E3"}, {"file_name": "edit_10_Quest.png", "id": "991159246965883", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821682_991159253632549_3726168677936387175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9SXx76wOxAQ7kNvwF7NHoj&_nc_oc=AdrlWzoJ2SwN7caHS0wvQ3hJX0GR-PqxhRn8fvSgB8RNN-gU3yNM_Vk_x7CyG4P8xQg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDkblSD95-rgbwL-c3XFwbjGuaxcIllCoOIO30DxLX0A&oe=6A58E323"}, {"file_name": "player_10_Quest.png", "id": "966149539200528", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823296_966149542533861_6133643743596760205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tbjmz5azUzgQ7kNvwEHnnAG&_nc_oc=Adooob4PxnX0flmtRMKs2g9WytKtZjPQqIMQjxM4vi0x79uhZ5IfWV5tpK7Z1JEgJuo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmFKCX7fbKEIC_qQTrRGvueLhoASlJ584Efr9yjOWO9Q&oe=6A58E278"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udcdc **Setlist Management**: Create custom lists and organize the songs in the exact order of your performance.\n\n\ud83d\udcf2 **Pro Sharing**: Export your setlists using the exclusive .cifraria extension via messaging apps or use the QR Code so that another device with the app can automatically recreate the list and songs.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/18BVoWuGr5oKZaX6z0ZCklOlUod5mBmQH/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "David Kalil Braga", "support_website_url": null, "website_url": "https://davidkalil10.github.io/Cifraria_Website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], 
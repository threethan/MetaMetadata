_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dAsaGXp_FuFtE4FYyM0pSky0SKgjQb8G1Xmykk5tVgA&oe=6A36C3C3"}]}, "id": "4356029028044012", "locale": "pt_BR", "screenshots": [{"file_name": "home_10_Quest.png", "id": "1471900691162468", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499307435_1471900694495801_4829947570561919049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIN4BzbOPGgQ7kNvwEwODjq&_nc_oc=Adq2IqKgjwMZ4SxvXvF65Egqwih97PHVzTUf97Ob5Uvi8HPm4MU0pRZfYToALj8bIj4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Fzs8_4bntfMvXOB4fTUf3OjXZ8VZ_kNMQuc2MIb-c4Q&oe=6A36BA4B"}, {"file_name": "settings_10_Quest.png", "id": "1391193859145570", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499308010_1391193862478903_5269474807905197381_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sf80Fi3KyzsQ7kNvwEFwvQh&_nc_oc=AdowFzf7_PzZT7XILba6kYIaLuoSnwCDsF9xxsCknvdHxtgGpgoouHbuUu6zFXkT5Y4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YCQUP1VCgWrmb-0wTx3x4KM_rDs-q5We8pTPdoahrSw&oe=6A3698C1"}, {"file_name": "home_10_settings_Quest.png", "id": "890412220264365", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499310817_890412223597698_6569410573752295327_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J01t9TCRa9EQ7kNvwFVdC_e&_nc_oc=AdrEkTGPQFuK8YQhF9VPEgnHGma-XXrIXwCDlCkyuT8VyR2nC3PI-aGp3iqAcGoywiY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_U2p6-E0EBlcbAnR-ocUhezyNMZVuG1nGdFcNjb3boSA&oe=6A36B204"}, {"file_name": "edit_10_Quest.png", "id": "1209432111385989", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499310731_1209432114719322_5500871760126419425_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbu_XZmY4oIQ7kNvwHrhEL_&_nc_oc=Adp5crgppQl-GNO25V8rUJ9fjyET1ejxq3-_yeewRB2C4OC2UfCJchUUVDFP75UN6kU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9u4aIQ43neq707Kv8zKttDROCNI-2LBuPS9INgXkqLcg&oe=6A36A5C1"}, {"file_name": "player_10_Quest.png", "id": "908261954943342", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499303746_908261961610008_2600051788214719246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_Th7vAaYnoQ7kNvwFEQh8H&_nc_oc=AdrZNX2UJAbOO7VMrRnr4O1yTTjhGWeu5xDmsC7aApyDq-3R-niOUA6AexCbyi4jXvs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8o7SQSFc04cAc59bHJ_nyw06PXn1OBFBQSprkOnBjUfw&oe=6A369A62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Viol\u00e3o", "Ukulele", "Cifras", "Letras", "Biblioteca"], "long_description": "O **Cifraria** \u00e9 uma biblioteca profissional de m\u00fasicas e de gerenciamento de cifras desenvolvido em Flutter.\nCriado para m\u00fasicos de todos os n\u00edveis, oferece uma experi\u00eancia fluida para gerenciar, transpor e praticar suas m\u00fasicas favoritas, tanto no celular quanto no Quest.\n\n\u2728 **Funcionalidades**\n\n\ud83d\udcc2 **Arquitetura Inteligente**: Organize suas m\u00fasicas em pastas personalizadas com uma barra lateral em glassmorphism (efeito de vidro) para um visual premium e moderno.\n\n\ud83d\udcdc **Gest\u00e3o de Repert\u00f3rios**: Crie listas personalizadas e organize as m\u00fasicas na ordem exata da sua apresenta\u00e7\u00e3o.\n\n\ud83d\udcf2 **Compartilhamento Pro**: Exporte seus repert\u00f3rios atrav\u00e9s da extens\u00e3o exclusiva .cifraria via apps de mensagem ou utilize o QR Code para que outro dispositivo com o app recrie a lista e as m\u00fasicas automaticamente.\n\n\ud83d\udd04 **Transposi\u00e7\u00e3o Instant\u00e2nea**: Mude o tom das m\u00fasicas em tempo real com um motor de transposi\u00e7\u00e3o robusto.\n\n\u2601\ufe0f **Sincroniza\u00e7\u00e3o em Nuvem (Google Drive)**: Fa\u00e7a backup e restaure com seguran\u00e7a toda a sua biblioteca, incluindo pastas e m\u00fasicas favoritas.\n\n\ud83d\udcf1 **Pronto para o Meta Quest**: Modo paisagem otimizado e dimensionamento de interface para um ambiente de pr\u00e1tica imersivo e sem distra\u00e7\u00f5es no Meta Quest.\n\n\ud83d\udcc4 **Importa\u00e7\u00e3o Multiformato**: Importe cifras da web (extra\u00e7\u00e3o com apenas um clique) ou de arquivos locais (PDF e DOCX).\n\n\ud83c\udfb6 **Cifras Interativas**: Acordes clic\u00e1veis com gera\u00e7\u00e3o autom\u00e1tica de diagramas, com suporte para Viol\u00e3o e Ukulele.\n\n\u26a1 **Foco em Performance**: Banco de dados local para carregamento instant\u00e2neo e funcionamento 100% offline.", "short_description": "O Cifraria \u00e9 uma biblioteca profissional de m\u00fasicas e o seu aplicativo definitivo para gerenciar cifras."}, {"images": {"nodes": [{"file_name": "icon_app_cifraria_1440.png", "id": "25137093062632621", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499303140_25137093065965954_5340243871155545084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqpCsJ-_2wcQ7kNvwEv_eX0&_nc_oc=AdqCpJKAYRp7DYhjkhF--oOLR3m0Zw5ttAXENq0mtUymJ3HcJALKssr78DqmzHmSAXI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82tUC00aH4EjM7UmNQ22_vXUBPv1xRS_8cGhCL3HXipg&oe=6A36A0A4"}, {"file_name": "icon_app_cifraria_512.png", "id": "1950929249182186", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499308090_1950929252515519_3579238828299289210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHJBegw2TXUQ7kNvwEcSCnH&_nc_oc=AdrjjbCbNUyHvmg-dRr4BweawtU7uzuPgE7VD-5uRHM4VJ81pARFuQ6RkG1vlhnPdtU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gWSrryySW_mosPv4JAKwvXux6pOVJ2wUeFfBMGRktxw&oe=6A36A37C"}, {"file_name": "cover art cifraria.png", "id": "1221596580110880", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499307422_1221596583444213_1996221161851683055_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_2Y6bIoGVEQ7kNvwEEuOt5&_nc_oc=AdqUJtPUY9Pag-ErB_6KzTFjMXOTzAejpgvLmMgZ0xXX-8W9etUu-H0y2pdwCZQriqc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SrbqMw5I9VjwioZrSdaUUZVUwxh4prJ8yFHkQumzAww&oe=6A368E6E"}, {"file_name": "hero cover cifraria.png", "id": "955328883720100", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499303140_955328887053433_2299564742518944745_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1PZgemPsbycQ7kNvwEO75oZ&_nc_oc=AdoXPwao8z68Gq3RGLG3ZgcWh7Up3Wxid3aKKmYDVbL45eL-LLI2CpoIaZCZAHZwdNY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qkZGphHcROjMBOFoQ0ebeO_Z2LTbGyPnxFLv_ClaVVA&oe=6A36C049"}, {"file_name": "cover_cifraria_portrait.png", "id": "923398230271609", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499303790_923398233604942_8149238291275724655_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRodwokZFWoQ7kNvwEI0wGJ&_nc_oc=AdoFmFmTiPlzhae8hgwhkvEDogBYqATC9Bj3nThqHfl-OjY7_k_aW5BIAJJS9J0Pc0U&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FXqR0ahH_xpC6DyOPcFddfxjnnK_D4lJvwd_plXaD_Q&oe=6A3697D6"}]}, "id": "2120506675398089", "locale": "en_US", "screenshots": [{"file_name": "home_10_Quest.png", "id": "1645036636740857", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491819323_1645036640074190_2595786236772761378_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44exh19Z3DYQ7kNvwFOJwku&_nc_oc=Adph_tyaDqtdYYgl_pImQCYNLU5Jajp-4kgPOlpXfuuqWcMoT5M5Dwhu80yz2rq-A38&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KT1xv6RRK140KoyyBB79HywaXqliQyAl98r0W2tWZhQ&oe=6A36BBB2"}, {"file_name": "settings_10_Quest.png", "id": "827413820421285", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820855_827413823754618_7016173846081243344_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7oHaWeazwgQ7kNvwFH6yh7&_nc_oc=Adqk1W2xNRZR2EgdIrwn_lTPG0SBDxrZT38vRikRZQ8r8GKCOzwQ_OTyr_KP17rLktg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qJx_Dq7I5thORQ4aBJdkiRwDilVW9Z-_tLq2vmthd0w&oe=6A36B066"}, {"file_name": "home_10_settings_Quest.png", "id": "1684432329357395", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491819854_1684432332690728_2661215708382739758_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zoEl323HVYQ7kNvwGs5Wy5&_nc_oc=AdoCE4Cp1Zr0YfoCi7FNlv1aDreBROTM-gixFEpjnxYBQTribd2iBYFmbVCpIuMcnmo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NwRArti2TZYfnSzASKsH4vhtI1g13MMik69AjLHVvjA&oe=6A36B423"}, {"file_name": "edit_10_Quest.png", "id": "991159246965883", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491821682_991159253632549_3726168677936387175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-0N_EUj-2UQ7kNvwGXYvYW&_nc_oc=AdraSI3bZGLbczrPkSx-fT9yggP1LyK35dnpQ0dHmRIVZ4NE2OkxWoLOrfjUF06Lo6c&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8H1CFBiZPjokBexlFJr7XjlD5dmNNpC9NIPT8iOXuS_w&oe=6A369C23"}, {"file_name": "player_10_Quest.png", "id": "966149539200528", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823296_966149542533861_6133643743596760205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4uvYRTGQDYQ7kNvwF-2CXx&_nc_oc=AdrqnLhHRjJjQsSbovW8wCDGrJESvQ3tXvHr_e4B9lkeGoA-Gn3bffeqW31ID11t7nE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KmUhbx4YE5cGLERisWmIVDifoMvJOut2An8Tu5Mt7rQ&oe=6A369B78"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udcdc **Setlist Management**: Create custom lists and organize the songs in the exact order of your performance.\n\n\ud83d\udcf2 **Pro Sharing**: Export your setlists using the exclusive .cifraria extension via messaging apps or use the QR Code so that another device with the app can automatically recreate the list and songs.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/18BVoWuGr5oKZaX6z0ZCklOlUod5mBmQH/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "David Kalil Braga", "support_website_url": null, "website_url": "https://davidkalil10.github.io/Cifraria_Website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langu
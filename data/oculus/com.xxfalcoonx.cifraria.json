0f&oh=00_Af02cpBRpGRSfFED1q-Y3cGAtVA709ISsipFhtzXyGDsjA&oe=69F1FD83"}]}, "id": "4356029028044012", "locale": "pt_BR", "screenshots": [{"file_name": "home_10_Quest.png", "id": "1471900691162468", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307435_1471900694495801_4829947570561919049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTlZLh-Bz1UQ7kNvwEB3Z7g&_nc_oc=AdrTvKYqx3HK5LOeIblBMckSbNoxZtetJJGYdwIal1cR9wYsUd0LifhYqOgJUgtPauY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3F5y6YrnbI8SRqFaDa_79GoMlXtSUKC7DQoW4yXyQEEQ&oe=69F1F40B"}, {"file_name": "settings_10_Quest.png", "id": "1391193859145570", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499308010_1391193862478903_5269474807905197381_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Do30QUvBBKMQ7kNvwEj5oAX&_nc_oc=AdpTCNeKZWNjUPI99k8BoyMArz4X5r3YT4fhJW3PwhugSBuKt9-4eL97jOqZMzVFnbk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3Fz6OmsMaRlLvX2IEffdrVkUsnQc9-Q8MElmG0JVn6hg&oe=69F20AC1"}, {"file_name": "home_10_settings_Quest.png", "id": "890412220264365", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499310817_890412223597698_6569410573752295327_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gOmy6rjeCoQ7kNvwEtnZsb&_nc_oc=Adr4GAbDmDyzTKytoPTEbn2ZMfqyaUdXyYe0FVlONSiTf-VOjUHPinbWmpe8cwdYMzg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3DNMePjudfE3reNbFGi8zDC-I2rF3c_pvQAe8tjS3zJg&oe=69F1EBC4"}, {"file_name": "edit_10_Quest.png", "id": "1209432111385989", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499310731_1209432114719322_5500871760126419425_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0fqDdmmTv4Q7kNvwFjFJpX&_nc_oc=Adq7HSdZvVLSpyLWFb7PodYCsFppOlMJgUwB2PSn-a5hIlHGca2ck4q-4a2L9BjkRd8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1v4ycegHWVjnY5SsAI9lRIkvDcjFS4xKZRGm14PYCKLg&oe=69F217C1"}, {"file_name": "player_10_Quest.png", "id": "908261954943342", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303746_908261961610008_2600051788214719246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_0QwAszbx4Q7kNvwFILDZ-&_nc_oc=Ado18ga9NUNqGn1FIo3J4bgbQcTPdppso2q9ye-VqGsuylbfisw4NVX6kxZl9qXO0Rc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1kpNogGYfWhCY9OTrf18Tvt9pVfpiVPKT_BwTlQP8yCQ&oe=69F20C62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Viol\u00e3o", "Ukulele", "Cifras", "Letras", "Biblioteca"], "long_description": "O **Cifraria** \u00e9 uma biblioteca profissional de m\u00fasicas e de gerenciamento de cifras desenvolvido em Flutter.\nCriado para m\u00fasicos de todos os n\u00edveis, oferece uma experi\u00eancia fluida para gerenciar, transpor e praticar suas m\u00fasicas favoritas, tanto no celular quanto no Quest.\n\n\u2728 **Funcionalidades**\n\n\ud83d\udcc2 **Arquitetura Inteligente**: Organize suas m\u00fasicas em pastas personalizadas com uma barra lateral em glassmorphism (efeito de vidro) para um visual premium e moderno.\n\n\ud83d\udcdc **Gest\u00e3o de Repert\u00f3rios**: Crie listas personalizadas e organize as m\u00fasicas na ordem exata da sua apresenta\u00e7\u00e3o.\n\n\ud83d\udcf2 **Compartilhamento Pro**: Exporte seus repert\u00f3rios atrav\u00e9s da extens\u00e3o exclusiva .cifraria via apps de mensagem ou utilize o QR Code para que outro dispositivo com o app recrie a lista e as m\u00fasicas automaticamente.\n\n\ud83d\udd04 **Transposi\u00e7\u00e3o Instant\u00e2nea**: Mude o tom das m\u00fasicas em tempo real com um motor de transposi\u00e7\u00e3o robusto.\n\n\u2601\ufe0f **Sincroniza\u00e7\u00e3o em Nuvem (Google Drive)**: Fa\u00e7a backup e restaure com seguran\u00e7a toda a sua biblioteca, incluindo pastas e m\u00fasicas favoritas.\n\n\ud83d\udcf1 **Pronto para o Meta Quest**: Modo paisagem otimizado e dimensionamento de interface para um ambiente de pr\u00e1tica imersivo e sem distra\u00e7\u00f5es no Meta Quest.\n\n\ud83d\udcc4 **Importa\u00e7\u00e3o Multiformato**: Importe cifras da web (extra\u00e7\u00e3o com apenas um clique) ou de arquivos locais (PDF e DOCX).\n\n\ud83c\udfb6 **Cifras Interativas**: Acordes clic\u00e1veis com gera\u00e7\u00e3o autom\u00e1tica de diagramas, com suporte para Viol\u00e3o e Ukulele.\n\n\u26a1 **Foco em Performance**: Banco de dados local para carregamento instant\u00e2neo e funcionamento 100% offline.", "short_description": "O Cifraria \u00e9 uma biblioteca profissional de m\u00fasicas e o seu aplicativo definitivo para gerenciar cifras."}, {"images": {"nodes": [{"file_name": "icon_app_cifraria_1440.png", "id": "25137093062632621", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303140_25137093065965954_5340243871155545084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDOtesQGhD0Q7kNvwFWHr9Z&_nc_oc=AdrLHfnSLmfZ4BOAmdqILx6XYu3x5PI1MJc4J7XKcTaSblvG9BlkUutHcHV0UrzsHx8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3HervasTqVz42IivVzlxLxQHiLoZr6Ggy2l9KRnxjEHw&oe=69F212A4"}, {"file_name": "icon_app_cifraria_512.png", "id": "1950929249182186", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308090_1950929252515519_3579238828299289210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nf433HZAZDkQ7kNvwGsfQkr&_nc_oc=AdqzATGjPk72fmXsOMZ_5o8hQ5X5cdAkx8BWrEB1rIQ_oGN79LBZYzM6gOLoFUb6d0M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0O1H3l6RA-nkHfiQIxYk7XEzzN10qQ-JJdOgWnTuZ1dA&oe=69F2157C"}, {"file_name": "cover art cifraria.png", "id": "1221596580110880", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307422_1221596583444213_1996221161851683055_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdxaLkwR7PEQ7kNvwHxhxZA&_nc_oc=Adr3IYPV56wTrMWp_rJss_nct3rTevMv4qSOc8uV7k5GiPaDngsvqP0bON2d7cdB3i4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2wOxZiHoP0jMwzKa6a4UsBYIGHCaz1MNTnTgLn4uYSXg&oe=69F2006E"}, {"file_name": "hero cover cifraria.png", "id": "955328883720100", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303140_955328887053433_2299564742518944745_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCuczH4nLs0Q7kNvwECMaY5&_nc_oc=AdoKm7D8KBlew7QaUrQZ2OnUiJ7_CDrAjSgUoj3V59EcyILFYa8ZtRQ4oZf3_C8NO4A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3IorSij614wa6cbJIiHOPGGkxwUZsmMkF0xNqIeXprpA&oe=69F1FA09"}, {"file_name": "cover_cifraria_portrait.png", "id": "923398230271609", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303790_923398233604942_8149238291275724655_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzW1NGMFtu0Q7kNvwH-euWf&_nc_oc=AdoZK7f5LR5xbbkf7FguLH9KYrjPpiKB5vCLmoIud1rvmvExKIVl3EQutaBec8Dozec&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0VsYCCfSLULD44971hNyeLdfHEbijtTssYhRPUgn_r0w&oe=69F209D6"}]}, "id": "2120506675398089", "locale": "en_US", "screenshots": [{"file_name": "home_10_Quest.png", "id": "1645036636740857", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819323_1645036640074190_2595786236772761378_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3zn-GobncwQ7kNvwFRGcSk&_nc_oc=AdqMt-vMUfaqjFesm3PK0ayoQTK4Svu4NzjL9jAJQVQUbM3osW_50-XjH0tfPzfiKe4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0fZkxgeVNNjn_t6lcv_OzcBuVRp9KIhhPlyv-XNW0x4A&oe=69F1F572"}, {"file_name": "settings_10_Quest.png", "id": "827413820421285", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820855_827413823754618_7016173846081243344_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtRJ0WzrOF4Q7kNvwHIZJ_C&_nc_oc=Adqhtz5fTKuP1ELJ2iAE-qxSMFdgf7NHhaGBOSTmLYKRoA9IcVZv_I-F2GfzwEexJ6c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1NFu5NMsWslgNnIpSPILHtpKo0-VPtCHfKLA0b1vYOiA&oe=69F1EA26"}, {"file_name": "home_10_settings_Quest.png", "id": "1684432329357395", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819854_1684432332690728_2661215708382739758_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6aSxbWXfQwQ7kNvwHNl_iL&_nc_oc=AdrNZrVIKxABJfkdaBADU8o96Hq7Snelj7uvkvMeqNe929Oe7WDMQRdm8yvTVj2I13E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3VDObDtxIufMmhYfAD-MQBvcdOMTT9ADI2GfczqvLZFA&oe=69F1EDE3"}, {"file_name": "edit_10_Quest.png", "id": "991159246965883", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821682_991159253632549_3726168677936387175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbqean92YmEQ7kNvwEjmuup&_nc_oc=Adofsf9nE38kWrr9kKGtBcZhhh-T-Q7icyRfKFPmjPRpLu2BEjLKlQG7fFEltuFseh8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1EmbsYwqO-otJC_URD5v1YBbcSbeQJaeFvEBDg3SeByQ&oe=69F20E23"}, {"file_name": "player_10_Quest.png", "id": "966149539200528", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823296_966149542533861_6133643743596760205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qecwRMDtc1sQ7kNvwE7iaUs&_nc_oc=Adr5ENy6SaJbp8io4vGhXOUy427qIRbvfmrfLt70IM1kp0u3lLB6elI-VCCL4IedBdo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af37VEuMsVNHEd9Gk3LthtesqLNG6xcIUP0p72JBnjWOsw&oe=69F20D78"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udcdc **Setlist Management**: Create custom lists and organize the songs in the exact order of your performance.\n\n\ud83d\udcf2 **Pro Sharing**: Export your setlists using the exclusive .cifraria extension via messaging apps or use the QR Code so that another device with the app can automatically recreate the list and songs.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/18BVoWuGr5oKZaX6z0ZCklOlUod5mBmQH/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "David Kalil Braga", "support_website_url": null, "website_url": "https://davidkalil10.github.io/Cifraria_Website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_US
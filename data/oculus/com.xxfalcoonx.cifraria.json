oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IVpPn1NZ1sQ7kNvwEPHe43&_nc_oc=AdoTI7ie9XiTWYio0xIJf8JeeGH-hAREB5ITPD4zuLipXO3a1snpKzrXrqGKYQCP4e4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyuL-ubZHOqSfCMaRTK4N0GCrr_AnP7DKqVM9CEA2Etdw&oe=69C7D5A8"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55lhHOXrwbsQ7kNvwHcJDHS&_nc_oc=AdqM0NOlIWJ4q8O0YF280xAr48D5lr3fK8FrIRGxnFcYweLb3oOQv0q7E87I7CmAC9Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzgs7hMXLaNOPrftM6N0fGM_6qy2JsxpT5JhBIyvGZkKw&oe=69C7D44A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=og2Ckby7ASkQ7kNvwF1GI5g&_nc_oc=Adq-hAWZF4a59bqa4R5p0aRm_NeuKhe1VqHKKqJ0EMp-jhOY_aqpGNhHKmxEaWKLApQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxu5q9GUZ0XPo77fgw2i46LhxRXNSIGGpBNr7_dcM6FEQ&oe=69C7BF57"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7VEiWUEX6kQ7kNvwGb-sXN&_nc_oc=AdrTnd8q6EdamaTUk1fx6UA8oI1mGIlERoYNj7n597WQ8Ws29eoxZUnES5A9ZDLp2Zk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3POM5Ja6PSDg9o6HWsZ7gZRMfy1nJ83rl4UPbF80DWg&oe=69C7AF4F"}, {"file_name": "cover_cifraria_portrait.png", "id": "1470913137957685", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499304019_1470913141291018_3011473396555673668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhW0bseRfQUQ7kNvwHvyFQJ&_nc_oc=AdroiiCRysskVQ_UfJ50phBwxEdDGi5SgnvZmTAkj-HKmnD_GYdnH7r9t1V-F49Ocus&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTsjRriOhhAhe-bxvb0HfSbQUIZHzxtaHtkaRbHqiSiQ&oe=69C7B283"}, {"file_name": "icon_app_cifraria_1440.png", "id": "1469012724923209", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499301053_1469012728256542_7416521803008086253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_
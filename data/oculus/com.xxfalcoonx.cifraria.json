4xoneyw4EK6p2quCg&oe=69B157EB"}, {"file_name": "settings_10_Quest.png", "id": "769903052409522", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307962_769903055742855_5369264695749606127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAZkIsT1r9oQ7kNvwHhySPw&_nc_oc=Adn61i4YFBzn--5w_uFEXQ8NKvtSGoNWQWU8BZQq2rF7aOImBbQaL0vDv45UNiqsi1o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZdtofYlBVWrETEx9IK7k88ZEjd7RN-c_CQqD-PspKmA&oe=69B17784"}, {"file_name": "home_10_settings_Quest.png", "id": "26256487057309894", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298291_26256487067309893_260636835105670560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbg6bs6H1e0Q7kNvwFcso_b&_nc_oc=AdlnrPUc_KVwwfjGGhgOm0pPDEU1y40NjMFQrst_fgkZY_k6oOtPKATQx_4A_098xfo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzwQq7BRekkfZZvvNTaP50ZDfD9o6qAL6a2QHr55TFLg&oe=69B16784"}, {"file_name": "edit_10_Quest.png", "id": "791165707365094", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7943LgQZEAQ7kNvwFFs3PJ&_nc_oc=AdlBzZkpt5sOVCKeJZtgcvSG3yrbl_H2VhnaJRkg6wDAdPn_7Oxep-bTz_g286m3XHc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwfd2xa8e3Og9SkDPO0REhW2tS5vtmBbKCQIgGRaIv5nw&oe=69B16C28"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjQcTIvb6G8Q7kNvwFDwcY5&_nc_oc=AdkjK4ESfGC_HK0Cjalf3oFlSIYWEgmvXjUKeu7RWuYs8-2zviOEbm5rJuwWOB54myM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyjqyechdZZNnYqgQz4I2jlXQNphYe_SatXAtGsqEkspQ&oe=69B16ACA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSE3aSg3V_kQ7kNvwE6nuBq&_nc_oc=AdlN6Jn8VHEPZeVOON9vPGc0Dci5SrXktegXmSaMa52QRfkb-Srz_cXP3vTUKuSYcDA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1_0zYvym-eyxXJzwmwITywkAufgkZSghLqdBIr9ISVg&oe=69B155D7"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7
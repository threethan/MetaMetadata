nT7brydkV-X10EhIg&oe=69C129EB"}, {"file_name": "settings_10_Quest.png", "id": "769903052409522", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307962_769903055742855_5369264695749606127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3u6PxcZ6xMQ7kNvwGzi2as&_nc_oc=Adoy51oSWUWc2HNCu0Zs5WulDN-1ogaYvYZTpcSaGWtr1HbTgDZntIxidsK5FA6VEo8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afyl6YOi08veEkiCwZneCklaIpeUTekK_r4VvjAwkGaKGg&oe=69C14984"}, {"file_name": "home_10_settings_Quest.png", "id": "26256487057309894", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298291_26256487067309893_260636835105670560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eG4iTfqy-ZYQ7kNvwFYZ9HN&_nc_oc=AdrsKeY9fUnuwhk8pAlO2edW_WRcE_DrymOpkixU3kSmNK-EbI3WrGXbdM4Z0IWoQAo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxAUxTfoHElH8iYjUez2PdvhkHovmz_5Kj6zRrOwXQ7vg&oe=69C13984"}, {"file_name": "edit_10_Quest.png", "id": "791165707365094", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c59rixqTDEcQ7kNvwHUgegq&_nc_oc=AdrODczU67JA4fz1_-pltAuw1EOLWeUC4W2zgKUp52PtoUn-aF7EDtICdAuk3W5PYVg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwFhwV_vWX_B4aPR7BPZV7czp1Ft44BYiiB7WgSlz5xvA&oe=69C13E28"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5Ba2mwn5NMQ7kNvwHzPpyR&_nc_oc=Adow8erSp-1-u6VbHUAN1dNO24cnFJEJ7hb1jLwZoSmZU7Hx0sY9EBHXaFmvlxcTw08&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEkNTjuOmzJwdSFL7uAUyQvjVF0JcuoqPAmeLJT81FjA&oe=69C13CCA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4l3kprQtdWcQ7kNvwEn_jF3&_nc_oc=AdoqnxMssfSLK5j-ftee768CUgBSrHMoyayyGYPB3mEh0iETZI3pIYY8_gSWISwn7W4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzW3RRL2tm3Ra2955icDS-ntP8Be2YERup0Sb6ftG1ZHA&oe=69C127D7"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7
&_nc_ohc=V1adRCkzD5cQ7kNvwGt4wbq&_nc_oc=AdpwJdseN0wg48KqdDUIw12Qc9Lo_W57SBnJWODkmaHOPNx54dsVZ-pVUUONCtdj5O8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI52FTqRH1qkhyu3s6Gkg4d03rxl5WgotVl-7wLzodtig&oe=6ABD0483"}]}, "id": "4356029028044012", "locale": "pt_BR", "screenshots": [{"file_name": "home_10_Quest.png", "id": "1471900691162468", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307435_1471900694495801_4829947570561919049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3mz919Ws9YQ7kNvwHsmmBu&_nc_oc=Adpb-EywSq6d_AJagMZNg-D7n86PWmf7heF4rPp-9cMKVwTixETgjXdEOWKH26jF55o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnZw58v7yuK05Pb7H5Iv5Q0x4au6FdhbtS_tXoFoJoRA&oe=6ABD334B"}, {"file_name": "settings_10_Quest.png", "id": "1391193859145570", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308010_1391193862478903_5269474807905197381_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utT4QawxVE8Q7kNvwF-yVZe&_nc_oc=AdqBaA9QQIuv78z_uboVDOQWLbNkKeJNr09kRjdil-f-LLku4AJ-FhobGih_rhPUqtQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3qPbQm4pUGjM9e3eNSVxEaiog4nW00pNmjvwGnhMixA&oe=6ABD11C1"}, {"file_name": "home_10_settings_Quest.png", "id": "890412220264365", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310817_890412223597698_6569410573752295327_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMnGndrUcYMQ7kNvwG99GRV&_nc_oc=AdrUfnYAITtXXl7s88UgdmH0Lw-I10B4h92-b_uWeew5Y0c_uyt6yMSHR444MfC2Gp8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYat8js6UUn12BlujTAGOloW1emjqrDg4MFFDdPUx0tg&oe=6ABD2B04"}, {"file_name": "edit_10_Quest.png", "id": "1209432111385989", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499310731_1209432114719322_5500871760126419425_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRjcF7VnviYQ7kNvwG785BL&_nc_oc=Adoyz85X73m2ESZtNrhm4-JH26ev0iedbkbFzt3IPP-92wSHunB-CdpZbFdxGDu3YtE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0CaO_3gOYlVytcaPF0ydjKzNlaALYkFl8yX7LYkt2WQ&oe=6ABD1EC1"}, {"file_name": "player_10_Quest.png", "id": "908261954943342", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303746_908261961610008_2600051788214719246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2dZuqA94ecQ7kNvwGZyo_e&_nc_oc=AdoHLNwy75tvxBz0dOwBHmlM6DEXBHwsRsHfYDhS9DOTA6-Wo23LrcjTzlygiUwvmq0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsOEozRF_6kfLFnYp_uXpVCGewjrlmTLk43D_WZZXrNw&oe=6ABD1362"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Viol\u00e3o", "Ukulele", "Cifras", "Letras", "Biblioteca"], "long_description": "O **Cifraria** \u00e9 uma biblioteca profissional de m\u00fasicas e de gerenciamento de cifras desenvolvido em Flutter.\nCriado para m\u00fasicos de todos os n\u00edveis, oferece uma experi\u00eancia fluida para gerenciar, transpor e praticar suas m\u00fasicas favoritas, tanto no celular quanto no Quest.\n\n\u2728 **Funcionalidades**\n\n\ud83d\udcc2 **Arquitetura Inteligente**: Organize suas m\u00fasicas em pastas personalizadas com uma barra lateral em glassmorphism (efeito de vidro) para um visual premium e moderno.\n\n\ud83d\udcdc **Gest\u00e3o de Repert\u00f3rios**: Crie listas personalizadas e organize as m\u00fasicas na ordem exata da sua apresenta\u00e7\u00e3o.\n\n\ud83d\udcf2 **Compartilhamento Pro**: Exporte seus repert\u00f3rios atrav\u00e9s da extens\u00e3o exclusiva .cifraria via apps de mensagem ou utilize o QR Code para que outro dispositivo com o app recrie a lista e as m\u00fasicas automaticamente.\n\n\ud83d\udd04 **Transposi\u00e7\u00e3o Instant\u00e2nea**: Mude o tom das m\u00fasicas em tempo real com um motor de transposi\u00e7\u00e3o robusto.\n\n\u2601\ufe0f **Sincroniza\u00e7\u00e3o em Nuvem (Google Drive)**: Fa\u00e7a backup e restaure com seguran\u00e7a toda a sua biblioteca, incluindo pastas e m\u00fasicas favoritas.\n\n\ud83d\udcf1 **Pronto para o Meta Quest**: Modo paisagem otimizado e dimensionamento de interface para um ambiente de pr\u00e1tica imersivo e sem distra\u00e7\u00f5es no Meta Quest.\n\n\ud83d\udcc4 **Importa\u00e7\u00e3o Multiformato**: Importe cifras da web (extra\u00e7\u00e3o com apenas um clique) ou de arquivos locais (PDF e DOCX).\n\n\ud83c\udfb6 **Cifras Interativas**: Acordes clic\u00e1veis com gera\u00e7\u00e3o autom\u00e1tica de diagramas, com suporte para Viol\u00e3o e Ukulele.\n\n\u26a1 **Foco em Performance**: Banco de dados local para carregamento instant\u00e2neo e funcionamento 100% offline.", "short_description": "O Cifraria \u00e9 uma biblioteca profissional de m\u00fasicas e o seu aplicativo definitivo para gerenciar cifras."}, {"images": {"nodes": [{"file_name": "icon_app_cifraria_1440.png", "id": "25137093062632621", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303140_25137093065965954_5340243871155545084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPTe955pT4EQ7kNvwE7fIVz&_nc_oc=Ado3URvwOL3TEX50eRfYTy-PcY1QsP4xIROy8c4Y7vCsyu5VmyMsm2kC4hbv-Ys9KxI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIP4YGkdSIX5FSqEuLvaakaDVDlce5sjVQEG7DH1-RuNA&oe=6ABD19A4"}, {"file_name": "icon_app_cifraria_512.png", "id": "1950929249182186", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308090_1950929252515519_3579238828299289210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=od1gYJ_8LgEQ7kNvwG_lhcI&_nc_oc=AdoI-MYGrE-N8eVD-C-WNxu6w9hBgybT4LqE0q9gdnSLJUul34KAyqKA6GcnUklRNGc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKykrAsfvf9d0-QqhXFw2Y1XugYOKLzXD4v5SE42TbIPw&oe=6ABD1C7C"}, {"file_name": "cover art cifraria.png", "id": "1221596580110880", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307422_1221596583444213_1996221161851683055_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFr4OKGPL2wQ7kNvwGM
it.png", "id": "923398230271609", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303790_923398233604942_8149238291275724655_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W47C5ZVQAXkQ7kNvwGxQcIO&_nc_oc=AdluzmSsrTcDXSzF_qAz_1iunWIk6Jxj_2cx_nwFAe6dDJILQfgBKctU_JzbTZvSJIk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfviR0Ipj_fVf3UN7q13nRKtKMZqxAEl_VCtVZNiyE6RgA&oe=69A44156"}]}, "id": "905947788695354", "locale": "en_US", "screenshots": [{"file_name": "home_10_Quest.png", "id": "897440809941813", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499298291_897440813275146_3101914859183847625_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awZRXG-SZh8Q7kNvwFRw1Ds&_nc_oc=AdnSas3GmXMm7UlZtLtL-HitO64Umls-3gV2kTtYt9WwRAi8kLcy5kRgcEzwJFpWLzQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftKd_78hECQ8ylyXcBTDzFzEl7o10in-li8sSXqRYoElQ&oe=69A428EB"}, {"file_name": "settings_10_Quest.png", "id": "769903052409522", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307962_769903055742855_5369264695749606127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDHnn2eDmsAQ7kNvwGenzOx&_nc_oc=AdnmFTDzEMGDJhlWGRXk7AHFb5fwt2h0Be34ku5MYuwF7x2QWeq4Ci6F-GMi7bMvwVA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsNo13X-cGOGJK-tkACWMo7CibmuaLseTAbiLds7AyUng&oe=69A44884"}, {"file_name": "home_10_settings_Quest.png", "id": "26256487057309894", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499298291_26256487067309893_260636835105670560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nPegFZmfwwQ7kNvwE05nmT&_nc_oc=Adk6iNFhDaH7AG56xm8WDWDswXojIb39rgb8J6tlRmup4zB3PXLl8enmfSEmhV-2fvY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft5shK6ilQepePd86uc9VEavQ8wlqcAIe8QoR4YqpXJrQ&oe=69A43884"}, {"file_name": "edit_10_Quest.png", "id": "791165707365094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VcUR53j8sBkQ7kNvwEwJ3SG&_nc_oc=Adlpmy5Y2QF_aeTlBj90AMYfC8SLWgpHgEt_JtdmpMk5-1HxXH1mgVk4UAia6t3qCfc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuMzdiU5xEDqgjHKhoH-J-tUcYre_HfvI_FYLLh14JJxQ&oe=69A43D28"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MTcoq4l4ksQ7kNvwFIjvul&_nc_oc=AdktoDx7KkflYAC3HhETSHiXMj8UJwbM_3vGQR_q--Ox1SErNEP1r1EMQ0Gh34cRyfs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfufwI1WLdbCio9_jiZZcbjAjWCBJqxCAzbZzbdRG3nr4w&oe=69A43BCA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8jhOFMoloYQ7kNvwEg9soF&_nc_oc=AdkDvtuW1mj0IR73iqrmyJ59LbQE-f4R5QoSSNWOgNdqICHg6zz5XlDXsaNu6-L2VOA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuG-EnBJtULXiVdmrVFRcLECPg0vaY-jxvkc0MsYDed7w&oe=69A426D7"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llARPypnSNAQ7kNvwHAFkIp&_nc_oc=Adlne2HFPh-vX95RqDxSWjLOL60Zt1ZO1pyFqfuD8vzuxuUAJDA8HGobrDOyIyjloaA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu7JeHxzstCtIjrtl5wlFlOAva78hzdMiNODnePBlpPQA&oe=69A44F0F"}, {"file_name": "cover_cifraria_portrait.png", "id": "1470913137957685", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304019_1470913141291018_3011473396555673668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5HhSCHe74MQ7kNvwFQYxbC&_nc_oc=Adkuz_Gj7C5C7FchJOVwKGW7hWpo1Yf-QpfTrfcGf9Tful5vmdXVYu-Ka0UOn-FbXw8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfttDaco3KRnhrr2fgAIjqJQIGlKmyd3JNL79UrzeLGmOQ&oe=69A41A03"}, {"file_name": "icon_app_cifraria_1440.png", "id": "1469012724923209", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499301053_1469012728256542_7416521803008086253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dohjn873MV4Q7kNvwEanL8L&_nc_oc=Adm1KV9Wox7aGjYi1vb_PPEE_pioKGJ5xPJMGvlL7rVgP9y1nFJGG6Kw3SV1-uqtMMw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftSBaH-yAWn_n
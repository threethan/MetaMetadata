wxDypTEsdqVDc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyohhu89TcPK65RTGhZYRtcrgvK40DsngQYRv6B-TT6nA&oe=69C3CCEB"}, {"file_name": "settings_10_Quest.png", "id": "769903052409522", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307962_769903055742855_5369264695749606127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qZmR6iJFzUQ7kNvwGGVb4s&_nc_oc=Adr08-mBo8N8FHURFhgyQFOGHAwzlm7hqomd4uBUIr3ZJX_aJr3s8nHrXFx6NFF-TGg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxAgmOrtkGE5698uHujoPfWdaj6DLglCMzCIhn5Z3eEqA&oe=69C3EC84"}, {"file_name": "home_10_settings_Quest.png", "id": "26256487057309894", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298291_26256487067309893_260636835105670560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRAuCKnrVlwQ7kNvwEW53yG&_nc_oc=AdorAO7LzBFlEfuhM_BVVnUgnUD-gpHiWD5kZnNFzIS_WT9cfbN7HFWQOBp1PWvVfeY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPLEpdvOTBHsXfLzS6icE_XuWcUbx0i_cIdQBLQJoAow&oe=69C3DC84"}, {"file_name": "edit_10_Quest.png", "id": "791165707365094", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3UuoANJaxYQ7kNvwEIkxDG&_nc_oc=AdqH0g74J1MkSu0OXFHY7ulI6iT-4xl8B6WNiPSGygMyTGKQunIWAfZaqHk1Vu-YP_M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVnpxi2lRO71it_7a-_l9j1oTYUB6aJBq1JLqIvdbfNg&oe=69C3E128"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CC3gyIWEG3MQ7kNvwEM9HuU&_nc_oc=AdpcwFvuHKr0VoIYef7w2rHgKDdDs-CSi_pOKPt7DrQ0NZ1mY6avDuS4qGt6RxUjcVw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxM6SagDOBO2s26zTEvYZCBpqLHAyi4Z2bRMax7y1IrQA&oe=69C3DFCA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4l3kprQtdWcQ7kNvwGDpZi2&_nc_oc=AdoqHr3e5RbqXSHqbMcmDgGnXt2phk0gnYZ69JzDAOGwJo0_v4ZK8jEKQ-BabyPtE9w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx0Ce7xEjeg2eLi41-zJpheTtZp-87TJHDUV38E4RkxTg&oe=69C3CAD7"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "u
12454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnoKWL7Pg4QQ7kNvwG5-1Ag&_nc_oc=Adkco27BbZIUFiyo9FuFUfYoUeoa6YXqoaecuk0sZHCJg3Juh9Xj0yVWhzATNuJCo-I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw3tluEsN_W2LQftYqY9tmFgTS4YYkE-AATmohJxl2n1g&oe=69BAA6A8"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hBCZ2Zx_xAQ7kNvwG-0CRS&_nc_oc=AdnBtzHJRhx0u5bB2QPuyq3A94bKnb1azOJpswmVaJQuda_S8WOZmYJUQNkf5vk2zzc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxpMjZfonijf8cSKxLWkA-vN3SuPsNqYoYHwR1yy6wC-w&oe=69BAA54A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNVDex-GBFkQ7kNvwH_1DNZ&_nc_oc=AdndCrcNFW49aMO3E78eP6hC_UvnWTC3gP4_L0Y8ZWpbm5b51SPCTXEqXDg9qI69rtk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzGm44Is_ZttrvxITndX6ZhtEkpcefheMXcLRGMYP-cog&oe=69BA9057"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDTS0ZIuou4Q7kNvwGi7yvB&_nc_oc=AdkdPiFjABt9kgBcYKsk47he1yRsKZdsb-tYOGPDVRK4Nc-Qqwhak82Iu_jVxPc549M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzr6r3ljsahfDtUj8s-5ZqMalKLVmqSSEfH3Uw5ouk6Kw&oe=69BA804F"}, {"file_name": "cover_cifraria_portrait.png", "id": "1470913137957685", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499304019_1470913141291018_3011473396555673668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_1o0HJAbLkQ7kNvwHwpGh4&_nc_oc=AdkXYNWlUI9P8Di76wDbLJxvCYXqEWjkFF57At6wfmr98KbVnIz5Nqv5TTJtD25NkYg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwZGZYDIxJ4j6yiYLa5cCcLIws-W0ZihIy2tlQbtxEqUw&oe=69BA8383"}, {"file_name": "icon_app_cifraria_1440.png", "id": "1469012724923209", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499301053_1469012728256542_7416521803008086253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dE_7PLBGOoQ7kNvwFyVKX6&_nc_oc=AdknDh1zdyWjsKQ0W
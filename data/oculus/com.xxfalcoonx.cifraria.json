wgR00NJ_lngTqmlXA&oe=69AEB4EB"}, {"file_name": "settings_10_Quest.png", "id": "769903052409522", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307962_769903055742855_5369264695749606127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SayRUhphW0QQ7kNvwEPBaf6&_nc_oc=AdnITW1xXPO_tZWep-EFpzvxZcQR3EtHyJPvhMsSpxYHPxwnXVZK6hNgyQB7Fo2mF2A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx75vkU8O9hDeYxpeMBxpTMRmiwfTFlieak2FpHwa7eFg&oe=69AED484"}, {"file_name": "home_10_settings_Quest.png", "id": "26256487057309894", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298291_26256487067309893_260636835105670560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMbUbfjbQJYQ7kNvwEdtXgt&_nc_oc=AdkSy4Sie7P6wM4TVJBPLqoGzM2nfaJjnh11ciqedrI85bQe3-dVVw0lb6Lr37KwRaw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyfK1rJW0ltKDJNNi6KABhR0DdYigS7vv_rQOyl7B-VAA&oe=69AEC484"}, {"file_name": "edit_10_Quest.png", "id": "791165707365094", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7943LgQZEAQ7kNvwHwbXKS&_nc_oc=Admz9w4rwvU-iw5UwwKOQzXKHTlx22M3jt2OqZ3an4wrBETP5KxBQOHPuG6uVskap18&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOsQ1KVE3ix9cr8VDEpYbi6kL5Qmb4ZPzyn6ElFeAZbQ&oe=69AEC928"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0Yo3JEvV_YQ7kNvwHbYrdL&_nc_oc=Adn9sW4dfkxyhZD4hc-8-mt-jb4xv5RWfEWXspNIAUmI-KNSabnrsfh_26wDEkltbCE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfytOdJ7d-3K1O7zZyStIBqdz8qXLHtZrqDD232g5KW2KA&oe=69AEC7CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GLuPdKAFjwQ7kNvwEKS8MP&_nc_oc=Adm44AOO5nO8IfXM8_n_rpOQ6-n5vWFPbm_vAQ-zqpGzAkye0N1awUx7AYAvV2Qrqng&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLWr5ul_GugTE8X_YB1o9DTx8EdmISrhM5FNRDUXdLTg&oe=69AEB2D7"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7
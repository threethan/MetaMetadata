lojDY4xyLwSYQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tJKlG1cQPQOh3Mtld2eFw_mZPEVYIejUrldVus7jqbg&oe=69D641EB"}, {"file_name": "settings_10_Quest.png", "id": "769903052409522", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307962_769903055742855_5369264695749606127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVE4GsXi3YkQ7kNvwFlLQEJ&_nc_oc=AdqjU0bEigRn88ysxu3GhNyUGR0iL2y6JUPO1_OT49AR59PQWS2AXIjYYYQiKo1SdGg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lEPu4jHPB26P4Nn03xpKhfIkrG_ZUDUp4VPOg4Z065A&oe=69D66184"}, {"file_name": "home_10_settings_Quest.png", "id": "26256487057309894", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298291_26256487067309893_260636835105670560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9erPHmv3tUMQ7kNvwHYrf-9&_nc_oc=AdpWqoZPLPiisXrf4kn_F102Qd60F4TunoMYGlLKBWdEMUBL7SDnw3ayuSR_hCMx2aE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1t8nLMdVAppsqtZd53S4LteKVyzI6wjXjYLq0WQo9zvw&oe=69D65184"}, {"file_name": "edit_10_Quest.png", "id": "791165707365094", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWHjKFwJ5HoQ7kNvwFcxVdO&_nc_oc=AdpgzexUWnUL6f11W9VAhhiWxAQwoSyBztwuEWzG05EZ7zWLfIpxEq-DQDYTkpePq04&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KXx6t58amh3FvKOKOjo96IBDNGW6y4rcAse0h_fju-g&oe=69D65628"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2tor29iEUsQ7kNvwGtMnjo&_nc_oc=AdqeF6h9gSoBTTV3WPqktv_WUq68iXsne0o_grpnHMfIjoiwRTjEMs38wy4bBaEsgeE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Sk9yu5NGDZDd_7lp7mmCInv6N1bSOYanO2UDaIqwL7g&oe=69D654CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUKJSzZkfWQQ7kNvwGDwgAd&_nc_oc=AdrlH7IPpZZZrzOAsUkKwyKmDJyHYKKPA08Un7R-meBPVr8p6USAFHtiBff32ea0E_4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13ZgGYH9Vh8huaAuMT1Sji6D77_8_-7H0PPIbCskUyvQ&oe=69D63FD7"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "u
qQMHVklddnAfo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxmuhn_RxQ_LiTIFUDUk-5zHkVh7wnA2zPj-XawYMhotA&oe=69C66FEB"}, {"file_name": "settings_10_Quest.png", "id": "769903052409522", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307962_769903055742855_5369264695749606127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qZmR6iJFzUQ7kNvwE_1Sby&_nc_oc=AdrvNQ9Ky2KicTAHzMBVI-d67tDHW62yTpkK9VpDx2ELrqll_J77y1WThWy6nS1UYvE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3Y_kDMHUXZhEREfFgEbkWgdDe8MZ4XDDryDVbSdmStQ&oe=69C68F84"}, {"file_name": "home_10_settings_Quest.png", "id": "26256487057309894", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298291_26256487067309893_260636835105670560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRAuCKnrVlwQ7kNvwHHGMP9&_nc_oc=Adqf5Silwh1OCgGKmDU56Tw8zPG9WWMlvX2HoEpG4qOi6yEL_PpFZocuznDWXmF-unY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMb1lk9j8z52gmE_W0_wQwi2QLogvvxrcI9-APmMk8mg&oe=69C67F84"}, {"file_name": "edit_10_Quest.png", "id": "791165707365094", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IVpPn1NZ1sQ7kNvwGD0wKH&_nc_oc=AdoS59m8yGw9aNnQKUWDGRauwsG-Y8nvU7u3b550OjNS4NOKLjNLTkpSVHoYNKw74Ko&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkvA68fH-v6WpCraQzN3Vz9Je5mVRQur-l-bCjTMZsAA&oe=69C68428"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CC3gyIWEG3MQ7kNvwE1_MHB&_nc_oc=AdqwWxV7QcUYlV0CI40vPPGYLnUugeQltf2dC_3x2xUBO9kQFgoUpOFZeRC3UAv0vdY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxlnSq2HEJhXnr73jwV5bkL2ODwqD9ww33zdewyEEe9pQ&oe=69C682CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=og2Ckby7ASkQ7kNvwH44ktK&_nc_oc=Adq-XLye1oWIlk4WTSFs7A2rQzRh2NpkEvUHzho0aDJgkEQxe_hp8icszlbo_FV1Jp4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw7seb6LNakK4npb_zQqE2i99RWVvkZgxkFXWqHVcnxsA&oe=69C66DD7"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "u
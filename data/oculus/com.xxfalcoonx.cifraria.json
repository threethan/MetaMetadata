&_nc_ohc=wDHnn2eDmsAQ7kNvwH_uWa0&_nc_oc=AdnHJ8WWJBR1j-PsLfXSV5obDsjg8ruGC_exMqvYQhPYV4W7rw-mcn9KX6XkWlLp2ko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfspO8qgsvOEJr8iKK3aFWsOF0biKvMc1t7YjB_xXLTHqA&oe=69A6EB84"}, {"file_name": "home_10_settings_Quest.png", "id": "26256487057309894", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298291_26256487067309893_260636835105670560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nPegFZmfwwQ7kNvwHpmA_k&_nc_oc=AdmWONWmpGQcR9mLD7hARVolA2DsGIJEBvxz4SFQvug--RsX4v0HrixpSA6qly8O0kM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvwzMrJOqHKoD5DHcoRMkaiUAJprC3oLmrN5jucuAUItA&oe=69A6DB84"}, {"file_name": "edit_10_Quest.png", "id": "791165707365094", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_K9BsJMdocQ7kNvwG-ULZE&_nc_oc=Adl4fC10kGqoZjC3VOPwhyJptNL2Kgduz7BaPrsKXXHju-a3PfCyHEfo8CJUvfQ3wFk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft4IqbxajK_8nrl55f2sFFelNpOtI4jof9Th9elXfzOwg&oe=69A6E028"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MTcoq4l4ksQ7kNvwEvYmml&_nc_oc=Adl4IGVhAYMN7zimP6BrAju6pZsxj5ROSRaDAx2h1HnaMiwCbnXIurU4aEX4MiSdg6c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvyxniW1vSwwQCGv2X8sHxiOw1WVgii2UTef1F9MjWKLw&oe=69A6DECA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYSsiArzedUQ7kNvwHK45T0&_nc_oc=AdnswFQUX658JbtCTkaK78Y7E_kZL58_46tcNCF4mUGAC_toucLaz5V0tVkoEsRLNJ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsp85nx6k-hFwMwtGFVJT_VXoNofDtRwGw56ZzI97LLog&oe=69A6C9D7"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJ7Tke8B2UAQ7kNvwHlv58K&_nc_oc=AdmTPyb-RvtYn0Kxo7-XsCgcoC0Lvk14ibN-5REeGtWhD4FAEB4lWVSm0mK2wb0Xm3M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvAVktj98dFKlJ-D9l-P3s2Cft_9NPailw9a8zk_3e-aQ&oe=69A6F20F"}, {"file_name": "cover_cifraria_portrait.png", "id": 
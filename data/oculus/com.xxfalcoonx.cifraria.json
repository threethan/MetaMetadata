12454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnoKWL7Pg4QQ7kNvwH9P6Y3&_nc_oc=AdmOzCt-GQcves0SAcEcpdf9bS_g1OCO2AVXcP8w2rJRz7chj9fXGnmPbCLzXNyqRvQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmuiQWgys5N0uiydujXfQxaHTvgWexSbP8eWbGVPrEMg&oe=69BD49A8"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhTIpY5ikesQ7kNvwE7DJ5u&_nc_oc=AdlIqlihLrrW-95RnUE0jcRFB9fAF0Cc-jtqOknAJ_2Ag4j9IM6kIwQWm68fn8qYsCQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwY5Z7qrI8Ndn5YY6XSZR8oX9P7FDe8hUpwHSso2TEBPw&oe=69BD484A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_1H9Qu35aoQ7kNvwHi-8yw&_nc_oc=AdnGe3lFYoS8O-CnZUshBkpEGpBVWRW7GUtLLkpIqGByQ2KyfBfPjjThOp1cu_5Ei4Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxvS-uUdaBXcjn8FOVixGDUThgfN5QVyFuHuE0TGkZKug&oe=69BD3357"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDTS0ZIuou4Q7kNvwE8GimW&_nc_oc=AdkRr8GQsUTYJQbuwGAnUkdjMJlh0v4-frKyGoBJLETm8w_6nqnuNaawxQPumGmPfCQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwTDgUGK8yaKvCfI1D5ZkUd36JCnq1miWCYMyzB5N1XCQ&oe=69BD5B8F"}, {"file_name": "cover_cifraria_portrait.png", "id": "1470913137957685", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499304019_1470913141291018_3011473396555673668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDVSUqhsgqQQ7kNvwHbyfya&_nc_oc=Adli6rI8_KMTvBliDp56OsKg5t7PX9nHpWcmfXHmG-Q_hG1gCppDFHoZhuemhzzR5xU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKrMJa8xls05NwCjtkMP5yE-gd5rX_leSkCepbx2Qfsg&oe=69BD5EC3"}, {"file_name": "icon_app_cifraria_1440.png", "id": "1469012724923209", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499301053_1469012728256542_7416521803008086253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9pC9t0Hp_kQ7kNvwGFi9vM&_nc_oc=AdmHt1SFsCUPgezxH
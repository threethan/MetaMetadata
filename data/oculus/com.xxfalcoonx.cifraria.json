xe8VYFBIaluFEkb_mBmt8dtajYznQ&oe=69F0AC03"}]}, "id": "4356029028044012", "locale": "pt_BR", "screenshots": [{"file_name": "home_10_Quest.png", "id": "1471900691162468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307435_1471900694495801_4829947570561919049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTlZLh-Bz1UQ7kNvwHQF8H-&_nc_oc=AdoAs5Mzv7MAd1VqSxGZ6zMfdQ5cAVDMdMfDJNAO2uUatgYkkjnwolu33_U_yRIauOY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af28sjfODmBa5k9d0KLiunT5r6RtSKOs29shGtzeDuTwUg&oe=69F0A28B"}, {"file_name": "settings_10_Quest.png", "id": "1391193859145570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308010_1391193862478903_5269474807905197381_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Do30QUvBBKMQ7kNvwG1Lpk7&_nc_oc=AdreleDWVGsKtbZw1teoRCLY5-YMDBrl57TE_-0FyFge3fYkMgcZ411vICxJe6Jl7G0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3Hxd7MTUNtqvFGl0pE3BxGNI4A_vl0Tcj97FlJ2vpsag&oe=69F0B941"}, {"file_name": "home_10_settings_Quest.png", "id": "890412220264365", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310817_890412223597698_6569410573752295327_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyhEmHZZn-kQ7kNvwGMsP_R&_nc_oc=Adp4A-dQ5GIfG6s-FhiS-uQs_Wfbot9dcNG6fwBN-bPI96VPAmCznjL6bkVIMMLGTqU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2Gkd-Xr0FCB78Am-CS6IMuJYDmkArOqV5_zM1Jw7TVsQ&oe=69F0D284"}, {"file_name": "edit_10_Quest.png", "id": "1209432111385989", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310731_1209432114719322_5500871760126419425_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEoIj3CTP1kQ7kNvwEZ7Ura&_nc_oc=AdqEHYZfUmTikH_r9sQMab4oCXU5sXVwWySNZkEz696JTZ8jA2PicHwassQMW4nn3Mg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0TDmxm-5zXGKMPISnSZKQHjZmLb73n3VpT128YNcKePA&oe=69F0C641"}, {"file_name": "player_10_Quest.png", "id": "908261954943342", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303746_908261961610008_2600051788214719246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_0QwAszbx4Q7kNvwFmeCo9&_nc_oc=AdqWq4Vtj37sYKZdl3yuTMqB5V2ZXy5_-CoqJhwx9tmxB6UPvSJhNWthj0ChNcMh4E8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1VHax7LyzVeNeYtDf-588L3sN02Fwf0-g6ipqr5_Iyyg&oe=69F0BAE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Viol\u00e3o", "Ukulele", "Cifras", "Letras", "Biblioteca"], "long_description": "O **Cifraria** \u00e9 uma biblioteca profissional de m\u00fasicas e de gerenciamento de cifras desenvolvido em Flutter.\nCriado para m\u00fasicos de todos os n\u00edveis, oferece uma experi\u00eancia fluida para gerenciar, transpor e praticar suas m\u00fasicas favoritas, tanto no celular quanto no Quest.\n\n\u2728 **Funcionalidades**\n\n\ud83d\udcc2 **Arquitetura Inteligente**: Organize suas m\u00fasicas em pastas personalizadas com uma barra lateral em glassmorphism (efeito de vidro) para um visual premium e moderno.\n\n\ud83d\udcdc **Gest\u00e3o de Repert\u00f3rios**: Crie listas personalizadas e organize as m\u00fasicas na ordem exata da sua apresenta\u00e7\u00e3o.\n\n\ud83d\udcf2 **Compartilhamento Pro**: Exporte seus repert\u00f3rios atrav\u00e9s da extens\u00e3o exclusiva .cifraria via apps de mensagem ou utilize o QR Code para que outro dispositivo com o app recrie a lista e as m\u00fasicas automaticamente.\n\n\ud83d\udd04 **Transposi\u00e7\u00e3o Instant\u00e2nea**: Mude o tom das m\u00fasicas em tempo real com um motor de transposi\u00e7\u00e3o robusto.\n\n\u2601\ufe0f **Sincroniza\u00e7\u00e3o em Nuvem (Google Drive)**: Fa\u00e7a backup e restaure com seguran\u00e7a toda a sua biblioteca, incluindo pastas e m\u00fasicas favoritas.\n\n\ud83d\udcf1 **Pronto para o Meta Quest**: Modo paisagem otimizado e dimensionamento de interface para um ambiente de pr\u00e1tica imersivo e sem distra\u00e7\u00f5es no Meta Quest.\n\n\ud83d\udcc4 **Importa\u00e7\u00e3o Multiformato**: Importe cifras da web (extra\u00e7\u00e3o com apenas um clique) ou de arquivos locais (PDF e DOCX).\n\n\ud83c\udfb6 **Cifras Interativas**: Acordes clic\u00e1veis com gera\u00e7\u00e3o autom\u00e1tica de diagramas, com suporte para Viol\u00e3o e Ukulele.\n\n\u26a1 **Foco em Performance**: Banco de dados local para carregamento instant\u00e2neo e funcionamento 100% offline.", "short_description": "O Cifraria \u00e9 uma biblioteca profissional de m\u00fasicas e o seu aplicativo definitivo para gerenciar cifras."}, {"images": {"nodes": [{"file_name": "icon_app_cifraria_1440.png", "id": "25137093062632621", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303140_25137093065965954_5340243871155545084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDOtesQGhD0Q7kNvwH6wzcd&_nc_oc=AdqVGUsdNZrcom_pEdSlWQUX2lfWPwyJ6hR2aQbSFOcbINRII6ipIUiHMaMybxxg_Bo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1KRDcs_mm4waV262zpR9joa4cG9HZrC-0rcVWirKs7qA&oe=69F0C124"}, {"file_name": "icon_app_cifraria_512.png", "id": "1950929249182186", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308090_1950929252515519_3579238828299289210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nf433HZAZDkQ7kNvwFEugBC&_nc_oc=AdqH8V6GIrSs5BR5a5AH7qAyq5EwUU7Q-xlMO7c-r2A8j6C2vqAu1EczYIIO6alJ8-E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3zHP0FOCcQg5qot3S5TDdU3wzOM2Hjaq2qTvwPYDKgeA&oe=69F0C3FC"}, {"file_name": "cover art cifraria.png", "id": "1221596580110880", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307422_1221596583444213_1996221161851683055_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdxaLkwR7PEQ7kNvwHFiha7&_nc_oc=AdqUm_jW6LFrd1sHQemQyAim3cb26FS8S6qyv8MTf-_Qyb_emPLrGHTfPbDAAewHhVk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af33yu0LcwTnDQY2pbkwu1-eEgHW_CjEW4nQS8hjhbcY8Q&oe=69F0AEEE"}, {"file_name": "hero cover cifraria.png", "id": "955328883720100", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303140_955328887053433_2299564742518944745_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCuczH4nLs0Q7kNvwGBdOmf&_nc_oc=AdqQ3CWNNvo1kOGJz5EySi7uQO-FEvoa901mFN_isfR3yHndJ94Hzc5VeNwVuGOvlPo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3NHWN-KxmHu7MWBPYl3maJc9TReI_K9jjNFv6WQ8Nl9A&oe=69F0A889"}, {"file_name": "cover_cifraria_portrait.png", "id": "923398230271609", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303790_923398233604942_8149238291275724655_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzW1NGMFtu0Q7kNvwEQ-nor&_nc_oc=AdpF12WvzartoJiAnNdhm1T6If76UI-LoZ7ahnUoaPaEMOATB8__D1Pv-4Yp4gsFeh4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af09cwlZwPUaMaHpSzsjrbZDE9BiXRhxEnqhEkt2t0CWPw&oe=69F0B856"}]}, "id": "2120506675398089", "locale": "en_US", "screenshots": [{"file_name": "home_10_Quest.png", "id": "1645036636740857", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819323_1645036640074190_2595786236772761378_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZzKBkWvlwMQ7kNvwH0rg8L&_nc_oc=AdrcIwlGxqBN00lwHg8WU4ip983Yfr6Tj6MANV_gU9_2gSiJkJ-iuhSD0S1lXBJrLRU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af26nFoh7FZ6vbh9IIPMBIuELVO8TzUSo881Kk8tMwPo6w&oe=69F0A3F2"}, {"file_name": "settings_10_Quest.png", "id": "827413820421285", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820855_827413823754618_7016173846081243344_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtRJ0WzrOF4Q7kNvwH_chBc&_nc_oc=AdoUU3pWiep3E-vHtUngopBjt2PdEhC-9bCLityF1MAhyXGO6CBguBwRITOayD4r8mE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2iEhmEGaRmD4Zwf8rQd8tAxSJ0jHWC98wlR83KcJlB1A&oe=69F0D0E6"}, {"file_name": "home_10_settings_Quest.png", "id": "1684432329357395", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819854_1684432332690728_2661215708382739758_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6aSxbWXfQwQ7kNvwH20mCE&_nc_oc=Adq4VCfst_3_v-ebiwcETwfM3WRJit4WnOWzpAznSrV6mH5ZxB7nw_Of5PXGUF4PTcY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3_zwOC_Rx4mGucx53epcw5u9fjxDEdjIeDTUtMqM-wkg&oe=69F09C63"}, {"file_name": "edit_10_Quest.png", "id": "991159246965883", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821682_991159253632549_3726168677936387175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fWAdxXJdtMQ7kNvwG2jhZK&_nc_oc=AdpcmaWCtRcOSFoGsmW8WJ3vehFTuwSf8ZnQhEgCwwIXnpqKT8nb8IIcWDCj2arx6mc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0ilt81wmQX6Hbpd87uI6IMWUfCJtzknk1MtRf4rsjEkQ&oe=69F0BCA3"}, {"file_name": "player_10_Quest.png", "id": "966149539200528", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823296_966149542533861_6133643743596760205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRaRS8oj_pEQ7kNvwGenoUJ&_nc_oc=Adp5RfeR36ZCeBY03zv9L4PvKPxKElK4dG2rArIjx03fDJdGHJob1yDfMZyNfBBS-L8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af07uB5y9lpSVkQqU0qZVqB4UWsD-KyhezjE3PHgPXof0g&oe=69F0BBF8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udcdc **Setlist Management**: Create custom lists and organize the songs in the exact order of your performance.\n\n\ud83d\udcf2 **Pro Sharing**: Export your setlists using the exclusive .cifraria extension via messaging apps or use the QR Code so that another device with the app can automatically recreate the list and songs.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/18BVoWuGr5oKZaX6z0ZCklOlUod5mBmQH/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "David Kalil Braga", "support_website_url": null, "website_url": "https://davidkalil10.github.io/Cifraria_Website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26033073703041914"}, "review_messages": []}]}, "cover_square_imag
it.png", "id": "923398230271609", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303790_923398233604942_8149238291275724655_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W47C5ZVQAXkQ7kNvwEcc6pS&_nc_oc=AdlAuLdihp4RTygoCI_IWdH_zcgzaq2wx2ewLy3kP2UXckDZgs9dCuGgPmW-qQILVHg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv7g0z9TB4qtsdSDhaCgJmaanKLDb39oXjS2h0aPYexDA&oe=69A6E456"}]}, "id": "905947788695354", "locale": "en_US", "screenshots": [{"file_name": "home_10_Quest.png", "id": "897440809941813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298291_897440813275146_3101914859183847625_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-KmlWrpxdQQ7kNvwEqUcUq&_nc_oc=AdlOC10-cAXUqDctKHj4qijViMWNKwPfibOgrz2UFB5bGaJcSZBYRVgXKIgXpJ0iams&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsp1L7mapEpoALM20LJEdMWPVzsoGsCY1AuFeRUpkyCcw&oe=69A6CBEB"}, {"file_name": "settings_10_Quest.png", "id": "769903052409522", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307962_769903055742855_5369264695749606127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDHnn2eDmsAQ7kNvwH_uWa0&_nc_oc=AdnHJ8WWJBR1j-PsLfXSV5obDsjg8ruGC_exMqvYQhPYV4W7rw-mcn9KX6XkWlLp2ko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfspO8qgsvOEJr8iKK3aFWsOF0biKvMc1t7YjB_xXLTHqA&oe=69A6EB84"}, {"file_name": "home_10_settings_Quest.png", "id": "26256487057309894", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298291_26256487067309893_260636835105670560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nPegFZmfwwQ7kNvwHpmA_k&_nc_oc=AdmWONWmpGQcR9mLD7hARVolA2DsGIJEBvxz4SFQvug--RsX4v0HrixpSA6qly8O0kM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvwzMrJOqHKoD5DHcoRMkaiUAJprC3oLmrN5jucuAUItA&oe=69A6DB84"}, {"file_name": "edit_10_Quest.png", "id": "791165707365094", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_K9BsJMdocQ7kNvwG-ULZE&_nc_oc=Adl4fC10kGqoZjC3VOPwhyJptNL2Kgduz7BaPrsKXXHju-a3PfCyHEfo8CJUvfQ3wFk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft4IqbxajK_8nrl55f2sFFelNpOtI4jof9Th9elXfzOwg&oe=69A6E028"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MTcoq4l4ksQ7kNvwEvYmml&_nc_oc=Adl4IGVhAYMN7zimP6BrAju6pZsxj5ROSRaDAx2h1HnaMiwCbnXIurU4aEX4MiSdg6c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvyxniW1vSwwQCGv2X8sHxiOw1WVgii2UTef1F9MjWKLw&oe=69A6DECA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYSsiArzedUQ7kNvwHK45T0&_nc_oc=AdnswFQUX658JbtCTkaK78Y7E_kZL58_46tcNCF4mUGAC_toucLaz5V0tVkoEsRLNJ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsp85nx6k-hFwMwtGFVJT_VXoNofDtRwGw56ZzI97LLog&oe=69A6C9D7"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJ7Tke8B2UAQ7kNvwHlv58K&_nc_oc=AdmTPyb-RvtYn0Kxo7-XsCgcoC0Lvk14ibN-5REeGtWhD4FAEB4lWVSm0mK2wb0Xm3M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvAVktj98dFKlJ-D9l-P3s2Cft_9NPailw9a8zk_3e-aQ&oe=69A6F20F"}, {"file_name": "cover_cifraria_portrait.png", "id": "1470913137957685", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304019_1470913141291018_3011473396555673668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5HhSCHe74MQ7kNvwHgCtqZ&_nc_oc=Adlq35QygftaeaoNndTW45IgaJcZ4_BieuJKPv_WHVYn_R9MQNNzLU2zLKxKJ_BeBAU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvT1caC8ftBqTMEQzagwZHu1xOOD_XQxqTb4-Vh45fjmg&oe=69A6BD03"}, {"file_name": "icon_app_cifraria_1440.png", "id": "1469012724923209", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499301053_1469012728256542_7416521803008086253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SVGZxEdpK4Q7kNvwGGh9_p&_nc_oc=AdmXRJ7Y24WPn03RydpyARqW1WksD__SXCSUqx0GlvYy8mJKfcb-HvrsCfoaCWf4Ky8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvoV5wo-ljxg_
oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3UuoANJaxYQ7kNvwFYXz5E&_nc_oc=AdqGCQy36AXVQc07V-uIQZiRcYr074_rr2KrLD8B0MmmZC3DHq7Jth0rsSA4E-hODoI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtIyXU_-gFhXF0y5Yj468kjWdncDxLQ60a9zyRm4HNew&oe=69C28FA8"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5Ba2mwn5NMQ7kNvwHwTfsy&_nc_oc=AdqkhntFYAl58iUu6AleT3OeuS1V8FpDS1hGNyYILFFqSPl3nrmawOgftl2OiQ0yZ0U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzgRDe-LuTAbWP2vp0BDC9sWhbqpAg67bwZEF0Yg2Wgyw&oe=69C28E4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4l3kprQtdWcQ7kNvwEJ_ZVR&_nc_oc=AdoTU0ni32ewXUr8oFL4t_RZTrEaUqofyfsWj-XufQEsbSfmWznf0SeTGsGo4m52fVU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzsXDZE9IyzoQr0HVUfQNalT-nMyRhwgpk0ODlrOFuKig&oe=69C27957"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDDQAhfdNXAQ7kNvwGcbhny&_nc_oc=Adr82Ez38N4PCe6Vk5Gu8iiWARJS15r-yKcMWDhDQw33MOC8CoSwW16o2AJ6Sm9ikJg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJabAY2OUfnbH0jq9bkIK-f6r2RrTdAxESYvvjOrDjiA&oe=69C2694F"}, {"file_name": "cover_cifraria_portrait.png", "id": "1470913137957685", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304019_1470913141291018_3011473396555673668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTxnPzVX3SgQ7kNvwFjwXrH&_nc_oc=AdqzEsiz3mEbK-115fvwGVOo9TApPyX8AQIest2ThKSlLsoMysT4A1yZWBZRY9-aN74&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxs3arbfZkMSdKIgFqAqU0ZDLLaxYqKOB-JP8RVZpCokA&oe=69C26C83"}, {"file_name": "icon_app_cifraria_1440.png", "id": "1469012724923209", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499301053_1469012728256542_7416521803008086253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_
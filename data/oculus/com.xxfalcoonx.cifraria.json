RLYFLzHh81L0oAdew&oe=69AC11EB"}, {"file_name": "settings_10_Quest.png", "id": "769903052409522", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307962_769903055742855_5369264695749606127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SayRUhphW0QQ7kNvwEu4C76&_nc_oc=AdkXdWYK7O6HL55W-BLGsMxQcku9fKXtfQG8bieFEq70cp8nSpqQ3lQF-nO2v-tGdf8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyzHT_UhkRSvWnokxJopOoYC-DrjB2r1jk7I4D5gyioDw&oe=69AC3184"}, {"file_name": "home_10_settings_Quest.png", "id": "26256487057309894", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499298291_26256487067309893_260636835105670560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMbUbfjbQJYQ7kNvwGoTS1k&_nc_oc=Adnd9uC7WTFSdtdK2n6oxWcwO8aofeiWU6kqAlSOck5JWAZtigCSQ3onGckxg6hNkXw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyzshnMKXmsQ-TwIpAyh0fPZeuM8hKfta15jdLTb-aJ0Q&oe=69AC2184"}, {"file_name": "edit_10_Quest.png", "id": "791165707365094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KokOSjTmxuIQ7kNvwFgJxDF&_nc_oc=AdlImqX7msrvguGfaQ3b7DF3DrGnHzgIjWBfhXFO8MLrc3sgAU5qRmUEBec5ads_AfE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOApY3NPA0Jqhawba_aZMxX-mDuS6bSDMSyG321uwUnw&oe=69AC2628"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0Yo3JEvV_YQ7kNvwHZJGTN&_nc_oc=AdmAZe315hKUbWzS12JNc-BOq1rN4IMH3Ws_75zQPGbldkfc1rAkM_0E2tx-HfBqa34&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz9AW1eJH_0CbaQn3Wk7_W_35k2uLSqHyifgzN7eauj6g&oe=69AC24CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pelG5V0BZAQQ7kNvwHQSQii&_nc_oc=AdlrHP8uy4RpYESNqbTFVR0x0th19dyL-6DCG7wEPFNafITlzYZA4t0mEhNTXRXptQI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyA4pODYp0k31oxYc4yfu3AXpZGmQ_5EVo3MK03afKrKQ&oe=69AC0FD7"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7
-Cg5mt8ToJ4qQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyn9Kk0dS4b8fxmNwLz_7J33N6YrW6ZIgXlVFguytB5Qg&oe=69D0FBEB"}, {"file_name": "settings_10_Quest.png", "id": "769903052409522", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307962_769903055742855_5369264695749606127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsDPg0V9GIgQ7kNvwEIr0Kz&_nc_oc=Adoa18v7muzfm0BVXAvUYPnXXKzOicBWILmwJyL5hbzznyUJoltNa9pr0ld2ZDufQFk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxcIU3ZPXSemJ8tlmDMZdSKo1MPJ7jNkmpsa0ftF73eUw&oe=69D11B84"}, {"file_name": "home_10_settings_Quest.png", "id": "26256487057309894", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298291_26256487067309893_260636835105670560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ql1SLP506SUQ7kNvwHSKPsT&_nc_oc=Adonu0DpjlZmB5hZfzLv9-Uf-WAWSKFH20fDJjzjWD8r_R-lOU6AMcXU4XLqMUS-1Vg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPmJ0aRBXaG91mjpsfgXPyDqAELCvsH3eCZt0MBb7E4Q&oe=69D10B84"}, {"file_name": "edit_10_Quest.png", "id": "791165707365094", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwYHo8829T4Q7kNvwE5o50P&_nc_oc=AdqDvmyNYqK_9KgfHiKLsS6RvGDABF00MIaVT3VgnmFc9gpEDNTP8p1EflB9qH2TRno&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwW_nbFsc7NSt3aWUYRCBChucPF2exzJSXxVPxcdIu3g&oe=69D11028"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zr9QsACjh-AQ7kNvwH2DMle&_nc_oc=AdpGv6D3f6PGpYp_gF-mmSWD6DeESaDhJluDUBUwrnuTWyp_4fwyB6hMnDQs7fUuc1g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwX_L7eMwcDMaugfV0V2kTlfKWw8Th1rJ5xUHke1FJrkw&oe=69D10ECA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BI4c8GnHQGUQ7kNvwEKWTSz&_nc_oc=AdqhX1F5Q8pSgIo7VfIWUqbkq9BKZaAOlMTA95NdskAzi2SYoZiH0qYl5lVWCcfRxrc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzox7vPUU71qXWp5eh8GNuMYUbPEHwrgU-xnt77XHVMGg&oe=69D0F9D7"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "u
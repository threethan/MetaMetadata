t=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdPzpWu4pv2n3WqK1H3a3o-Z21fiJgOfx01yFXNZe0TA&oe=6A8D8E83"}]}, "id": "4356029028044012", "locale": "pt_BR", "screenshots": [{"file_name": "home_10_Quest.png", "id": "1471900691162468", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499307435_1471900694495801_4829947570561919049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jIUpgAZvpAQ7kNvwEDLxw2&_nc_oc=AdpyByBMySlqIPP_suKe90V0zW54crSqcCz9ARlCboNqZdMgOYZzUpV2UHwMs_x5aR0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFU3Oei_Upn2YnjnG2CWXa4bQ0fSyUHrke4MKs_S0ZGWw&oe=6A8D850B"}, {"file_name": "settings_10_Quest.png", "id": "1391193859145570", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499308010_1391193862478903_5269474807905197381_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDkJze4JCscQ7kNvwFfPNWh&_nc_oc=AdrwdyXitWCM0xjcO1d7zW7wV7Xs2zTJWR8I5bK-N-eSQChpsaes3fL5kuXLVTqw14Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEn_cDczJyADkA-ejPIC--lDT_aSt0ZfcwuNp6qnNUyCw&oe=6A8D9BC1"}, {"file_name": "home_10_settings_Quest.png", "id": "890412220264365", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499310817_890412223597698_6569410573752295327_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tmTl9ig6soQ7kNvwE6yijs&_nc_oc=Adrpegkokarw0Jfnzysy1RJy1ebHIdw8c9ga_AgY-8KhoVmav7eom-YItFNUCWF9xM8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBp3GRWkN-oKRwNiVI1--7uvkmC98lDFevTvduBz087g&oe=6A8D7CC4"}, {"file_name": "edit_10_Quest.png", "id": "1209432111385989", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499310731_1209432114719322_5500871760126419425_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDaVLCAiVF8Q7kNvwHRjTHx&_nc_oc=AdpxLee0nDu3KJghbcBtYpK5z_M_pldeK5Y_i9-PRoCCm9cRP-8uFYx12XqoXuLihhI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-Kco6zq83FlFYSQCz4sozUtAiHAZbQHah4P1-gu8D3w&oe=6A8D7081"}, {"file_name": "player_10_Quest.png", "id": "908261954943342", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499303746_908261961610008_2600051788214719246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNOSC0Em39EQ7kNvwHRj0ZK&_nc_oc=AdpZIU-xMX-v5WCYMNfC7VbDLH4bVQ_L2XQhyvUgcTxnQ31lio2495SCtIJxfeE7z-Y&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7Z__E2EQzZMjmc_vPIG6aW49Luj1s6Srx5m__XSW1vA&oe=6A8D9D62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Viol\u00e3o", "Ukulele", "Cifras", "Letras", "Biblioteca"], "long_description": "O **Cifraria** \u00e9 uma biblioteca profissional de m\u00fasicas e de gerenciamento de cifras desenvolvido em Flutter.\nCriado para m\u00fasicos de todos os n\u00edveis, oferece uma experi\u00eancia fluida para gerenciar, transpor e praticar suas m\u00fasicas favoritas, tanto no celular quanto no Quest.\n\n\u2728 **Funcionalidades**\n\n\ud83d\udcc2 **Arquitetura Inteligente**: Organize suas m\u00fasicas em pastas personalizadas com uma barra lateral em glassmorphism (efeito de vidro) para um visual premium e moderno.\n\n\ud83d\udcdc **Gest\u00e3o de Repert\u00f3rios**: Crie listas personalizadas e organize as m\u00fasicas na ordem exata da sua apresenta\u00e7\u00e3o.\n\n\ud83d\udcf2 **Compartilhamento Pro**: Exporte seus repert\u00f3rios atrav\u00e9s da extens\u00e3o exclusiva .cifraria via apps de mensagem ou utilize o QR Code para que outro dispositivo com o app recrie a lista e as m\u00fasicas automaticamente.\n\n\ud83d\udd04 **Transposi\u00e7\u00e3o Instant\u00e2nea**: Mude o tom das m\u00fasicas em tempo real com um motor de transposi\u00e7\u00e3o robusto.\n\n\u2601\ufe0f **Sincroniza\u00e7\u00e3o em Nuvem (Google Drive)**: Fa\u00e7a backup e restaure com seguran\u00e7a toda a sua biblioteca, incluindo pastas e m\u00fasicas favoritas.\n\n\ud83d\udcf1 **Pronto para o Meta Quest**: Modo paisagem otimizado e dimensionamento de interface para um ambiente de pr\u00e1tica imersivo e sem distra\u00e7\u00f5es no Meta Quest.\n\n\ud83d\udcc4 **Importa\u00e7\u00e3o Multiformato**: Importe cifras da web (extra\u00e7\u00e3o com apenas um clique) ou de arquivos locais (PDF e DOCX).\n\n\ud83c\udfb6 **Cifras Interativas**: Acordes clic\u00e1veis com gera\u00e7\u00e3o autom\u00e1tica de diagramas, com suporte para Viol\u00e3o e Ukulele.\n\n\u26a1 **Foco em Performance**: Banco de dados local para carregamento instant\u00e2neo e funcionamento 100% offline.", "short_description": "O Cifraria \u00e9 uma biblioteca profissional de m\u00fasicas e o seu aplicativo definitivo para gerenciar cifras."}, {"images": {"nodes": [{"file_name": "icon_app_cifraria_1440.png", "id": "25137093062632621", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499303140_25137093065965954_5340243871155545084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9q5Gtf1HCYQ7kNvwEKGFSw&_nc_oc=AdrIE0kov0oFoRNPd5ZWg1RQVz07fcIx-FJ1OyfVOP3eDexVwRKacsgDE7GGjdYB5jI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8KVJxE_9TGh23S4rtIGCOdmhfj5ia9wphqwL9ekpAoA&oe=6A8D6B64"}, {"file_name": "icon_app_cifraria_512.png", "id": "1950929249182186", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499308090_1950929252515519_3579238828299289210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9INrikLMgLsQ7kNvwFCKza-&_nc_oc=AdozsRYz_RYyognDWi48XowO_0kWGCenSqQANySeUuvuPNx-a2V3W9W1hGfnuW1Gxqk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3AHexSuim7qFDuuvUJu6TFOOgt83SGhGJokSLapvz-A&oe=6A8D6E3C"}, {"file_name": "cover art cifraria.png", "id": "1221596580110880", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499307422_1221596583444213_1996221161851683055_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOia48x7O7IQ7kNvwFcN4Ul&_nc_oc=Adqt85ROvpw6X8P5ch58Ujyknd52oMKHC7eD-a58JjPKULVvpuxhkHyyCRnHt2iN4RU&_nc_zt=3&_nc_ht=scontent-lhr6-2.ocu
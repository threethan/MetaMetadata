12454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_K9BsJMdocQ7kNvwH0NwA5&_nc_oc=AdnMbiCElmeCoDXjnixQ3P0xCTjMoin01xNtsPpSj1BTLUECb2ZetJDV3ljMb1PYGlU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftLjYLo-J-81VPvQpNh_W6ZPmn7h74ZG6M_jT5lpEm6_w&oe=69A98328"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lbx63aX49OYQ7kNvwH3O_IN&_nc_oc=Adls4F1fE36c4SpTzrzHBhHaD5ZuE4MFpIxqk70ftJ9PTBxby0i2ZGR43g41FjjNMXI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfscutrauZtR_y9zvRjDCUZ20ICRucGe-W5Nrz5LeECZmw&oe=69A981CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pelG5V0BZAQQ7kNvwF_lxTi&_nc_oc=AdlrmvHf2fkkiQo02_B3rttwt4YX5KlMBENzWiJqT7B-JVVfXexvnVPHhPnlr_JwmiI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftD_7FmKV1Y7UzTZkDw_bzR5dCfzv4kw2J15-aRlBoY8w&oe=69A96CD7"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJ7Tke8B2UAQ7kNvwEg-BKO&_nc_oc=AdlfJ5e97nJw3SwO-mFcFvo-1c39rsjQLHqPWIvGbmVdSPLghMzpjRy4ljIKar7n1_Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvBRMuO1GRCfhXlqDl_UH6qrF55n6AYM_dN2sCzewG3FA&oe=69A9950F"}, {"file_name": "cover_cifraria_portrait.png", "id": "1470913137957685", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304019_1470913141291018_3011473396555673668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAn9CTEDkR8Q7kNvwHIT3Fm&_nc_oc=AdmMqRHqtMkI7TFMuzm6qEAsJi-_gfmCuoVfEvaSvzIP8FZ3PoZBaQVT28Hl_Zk2qPA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afs7t3byPZZraUDip6i7S8EoVBWfNv8zvaOY1c9-9L_BGQ&oe=69A96003"}, {"file_name": "icon_app_cifraria_1440.png", "id": "1469012724923209", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499301053_1469012728256542_7416521803008086253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3Fsf1h3ngoQ7kNvwEoXBc8&_nc_oc=Adl1Ux4hAHVoHPfIi
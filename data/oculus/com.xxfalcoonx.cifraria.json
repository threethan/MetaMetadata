YKk6yR-k51_GukV5A&oe=69B54C6B"}, {"file_name": "settings_10_Quest.png", "id": "769903052409522", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307962_769903055742855_5369264695749606127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4hJ-CjKndAQ7kNvwHpx3cu&_nc_oc=AdmauEWx6HUAhWeq363bQzFcLrv8AL0_4DBhrV6ruusLRsobn8inx12OiI1YY5tHuyA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx6RpfL5xieV2S0QmK11PhImYRWBQ37bKf1GChTMvTCzA&oe=69B56C04"}, {"file_name": "home_10_settings_Quest.png", "id": "26256487057309894", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298291_26256487067309893_260636835105670560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlkpSe-AL_QQ7kNvwFOs2pk&_nc_oc=Adn1aaMFEu_mpGunt-fB_kFufhQBV3SqCpWxIETCSdQK2yCVkjqL4jBkSCrASmi2TC4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyGdWUVQ6fw-RkpbwrFgCcTq2mEsMURc0xPfrqsSKhkkg&oe=69B55C04"}, {"file_name": "edit_10_Quest.png", "id": "791165707365094", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1ZSsLTfjlcQ7kNvwEmW8Iz&_nc_oc=AdkJzYEQzqxU6LiigfLQfMssIcUIchmJGx_OXScXs_eVShFeH7ldUvghKHo1x1TaQJs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx91vTUicyD4_imsTnNh6e5b0ESq1jjpnWF_F_954Uz-w&oe=69B560A8"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xPkOgzWtksQ7kNvwHei-Uj&_nc_oc=AdnMxUZsqfQ6n8Ol925rZWwx1eKynQSsmJH1ICHPmCqD7zi4YydnJ9axqIswWA1jyBM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQS_WSpSHpi6d7GpGmsYhzdz7cJgLD-Ko6ApWPucwPKw&oe=69B55F4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCPrELhGz78Q7kNvwGzOEzi&_nc_oc=Adl2CcYkhimRRLGaLIJdQ3fb7IFKxGhFsPqntnZ_KKw5P0Cv1Lpa_f40eT6qfV--AH0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8LLNvNk7nReoOiO8mmvvJUN2HCZLm0NdQlcIMZV88SA&oe=69B54A57"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7
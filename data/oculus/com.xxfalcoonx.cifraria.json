96RnwEo1To9GU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2djO7ZguVSNW1ZTJXD50GUhW_QzOqg8PE72FIdk8NtKA&oe=69D39EEB"}, {"file_name": "settings_10_Quest.png", "id": "769903052409522", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307962_769903055742855_5369264695749606127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVE4GsXi3YkQ7kNvwG0e64x&_nc_oc=Ado-wtK8D5dJ8XClic3v_cPAbTIZh7nL_u8mtvSuEV9M2QOTIZ_5GPQPZ8WfK1ERVJ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3csIpNxroC0giDAtPgn3QeTOieyVx7OJnBkwJ0yNK9XQ&oe=69D3BE84"}, {"file_name": "home_10_settings_Quest.png", "id": "26256487057309894", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499298291_26256487067309893_260636835105670560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9erPHmv3tUMQ7kNvwGKQ6hb&_nc_oc=AdpspaPy7gFFPEfbHS-0Ye1dEqtA-Q_HfmUTjfC2-ysalVgtSw3ZHn62AKuKyeu6AKk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xUBbf4LSSRfXMiR5h64Gr1d9vOBn6b2jF8vTegt106g&oe=69D3AE84"}, {"file_name": "edit_10_Quest.png", "id": "791165707365094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnkd6BjYgOMQ7kNvwG-ckxG&_nc_oc=AdqcPkn520OF9Mh5COVTEb9Fcu-Mj0pHqJjh50YimWuuGyI5hJfKnbTTnoZ_6G1SZ8o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dvniUskg6AJh7qJeB_VQ-HzLWmrGt4LKAyjK3vw3FCg&oe=69D3B328"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2tor29iEUsQ7kNvwF0r_CA&_nc_oc=Adq0jtTm46UubWxt_vlty2qcD-8ziUSAYeq8EXJwokg9gnygMcm-1OeaDAXg_TVd0zU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3c_x0Kd6N4cARQExZv__e-f7SVFST9dJpEWpZSNzXc0Q&oe=69D3B1CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BI4c8GnHQGUQ7kNvwGeC4BL&_nc_oc=AdpLM-994R6Us2-txS9dC4_NGb-0FPr7KItdPD7NoKK4P8XTlaCo7DDXx0_lGOeRgsY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tNw-XlRhBejGi8WNJ3IU7hJJKS-fD0svQCUEBCildFA&oe=69D39CD7"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "u
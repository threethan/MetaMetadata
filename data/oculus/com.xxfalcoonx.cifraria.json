2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0Q0b6SZLBCn_hBoHebpHc1T5tjKDagcxXrfkXo8_RBA&oe=6AFDCE32"}, {"file_name": "settings_10_Quest.png", "id": "827413820421285", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820855_827413823754618_7016173846081243344_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4BsZoFHNUIQ7kNvwGWIir7&_nc_oc=AdqmAKrjyPdGeTS0NE4prcOIY03oXYVbk7DStPtyA2slvXMNiM-OYuqaSqSCGGV9Cq0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPjFhNCVxwMGQIVaXEgTbrt1d3xPSt_E11DCFMm3mgDQ&oe=6AFDC2E6"}, {"file_name": "home_10_settings_Quest.png", "id": "1684432329357395", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819854_1684432332690728_2661215708382739758_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pIwn6QjFxnMQ7kNvwEO9gSc&_nc_oc=Adqk6De9P9oKKIpOdB-mJCNq2ydC1_hLkHFYm2Yt4EtcJXL6I7rIzMJnUZOv2TDhGVY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT01EpGfBcyDAMpYzvV1GjkZ-IFmYUmBM3NzfVXcXMU4A&oe=6AFDC6A3"}, {"file_name": "edit_10_Quest.png", "id": "991159246965883", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821682_991159253632549_3726168677936387175_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUhiypnMPw4Q7kNvwFLhjl1&_nc_oc=AdrFzGP0W-eHkmNumZxU9OUPeyATtAPsq4T5zmZyhCWwvuFsz2oKFUoZhLgwBLZTscw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTRnjkZqZCyc-Aa7aEBLW7NSPv2baJZGAhRD6saSFvwQ&oe=6AFDAEA3"}, {"file_name": "player_10_Quest.png", "id": "966149539200528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823296_966149542533861_6133643743596760205_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKO0d8AJYYcQ7kNvwE9LoWR&_nc_oc=Ado095pJxYLHFApTeeqURsUJxJjOWN9t0m34wRyyRliw74NlHF-d4a4_2ttkNeZqVWo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKcDH_Rru9lDebBHZOIKj_MCjXHWLLJWP57I2nE7uBdQ&oe=6AFDADF8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udcdc **Setlist Management**: Create custom lists and organize the songs in the exact order of your performance.\n\n\ud83d\udcf2 **Pro Sharing**: Export your setlists using the exclusive .cifraria extension via messaging apps or use the QR Code so that another device with the app can automatically recreate the list and songs.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/18BVoWuGr5oKZaX6z0ZCklOlUod5mBmQH/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "David Kalil Bra
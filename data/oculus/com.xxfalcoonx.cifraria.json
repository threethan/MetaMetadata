2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSKmqUIXVmYJXVPRx6r7i4ZKd_Ji7nzbEVsm3CUzaFDsQ&oe=6B0C4EB2"}, {"file_name": "settings_10_Quest.png", "id": "827413820421285", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820855_827413823754618_7016173846081243344_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4pLw2yphbsQ7kNvwGeBOQu&_nc_oc=AdpqgEJ6dM9XSfxCYFQ8Zn8UEZIutCuXS5JyqvpyUwtlGoRp6ZBNU27Mz3Q0hBXDm2A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRynpSz1opBF-CRVbvFxmEmisigG86WdbM-oiRyHaX4mw&oe=6B0C7BA6"}, {"file_name": "home_10_settings_Quest.png", "id": "1684432329357395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819854_1684432332690728_2661215708382739758_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4H78I5u8ZgQ7kNvwFr5Uyu&_nc_oc=AdpI5gcvLzvraVQYHlwcsfkWxVeAIbUc1ZTZ8BB6H3NkQBUbxw4Zv1yTwG7NpfNlKt8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQUaum48ZgnD1VuK8zp6jQj-MD3NMkdm6DJ0o2TEIGMWQ&oe=6B0C7F63"}, {"file_name": "edit_10_Quest.png", "id": "991159246965883", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821682_991159253632549_3726168677936387175_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVv9gTroYeMQ7kNvwEkvRDt&_nc_oc=AdqdZ28bYVTAuWplzzhlSJy3xfZX4f47_jRno_qNBodjyy37nnI4MA4fMNkun0X9EeI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSQ4DdiiPySMueyUdw3MyoD6yl3Ckv_HWNTA52NhN3IwQ&oe=6B0C6763"}, {"file_name": "player_10_Quest.png", "id": "966149539200528", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823296_966149542533861_6133643743596760205_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrriPFQ-zkcQ7kNvwHpZBLP&_nc_oc=AdpDUl7h9BY-Mm789UOYoawcEdw9ZI8WMcH13ViBTPixTfj8pDY5g0OT6yd3KSIhe0k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRxK74g7QgHS2TPMISuWJVfHJ7u5JQ7MzA9iV1i_cKbaQ&oe=6B0C66B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udcdc **Setlist Management**: Create custom lists and organize the songs in the exact order of your performance.\n\n\ud83d\udcf2 **Pro Sharing**: Export your setlists using the exclusive .cifraria extension via messaging apps or use the QR Code so that another device with the app can automatically recreate the list and songs.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/18BVoWuGr5oKZaX6z0ZCklOlUod5mBmQH/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "David Kalil Bra
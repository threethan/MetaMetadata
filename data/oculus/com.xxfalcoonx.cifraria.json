oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IVpPn1NZ1sQ7kNvwH4tUje&_nc_oc=AdplLe_XAgwzR6F0y7JoXSV3rAq5q26-aIE-FE5F7V1o-fBrVLfauP_I_x_Pi29MBBA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwevyUh6Y6n6rHka4Xb9XQ41wx-V327-Jtd8BefWwK2MQ&oe=69C92728"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55lhHOXrwbsQ7kNvwE2l7mF&_nc_oc=Adr4NxUuEgs5MqvWwqDhMHD1oVlkPIv7C-hTlSDg1SOhYCh2vSIDjzEXTQVV83f8P-M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhBJGO5nnbv3DkJgUM318dS0kUv4wXDnMD0h9OzriQkQ&oe=69C925CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvhocnjFACoQ7kNvwFX-WeU&_nc_oc=Adp4pfrW2m4B_mg5HLfZdIgPMJb5tupzkkLDj_ugD6BVVvaaSfyeuQBDHr__tYZ_J6o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwi4G-LQUw6d0Eo_wfMn-omgPG6CPrwbJKZlaqqHORYTA&oe=69C910D7"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7VEiWUEX6kQ7kNvwFaWRXC&_nc_oc=AdrehYxhhQZAxAjamU9k7aNLrze8RQdbu6fTIErAeSmbMD9_xohhoCZKiSHx_HmyUGs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzcMufTSzGfQJImk8scpzpqcM2erNUoFy7OaB4MSl8Jgw&oe=69C9390F"}, {"file_name": "cover_cifraria_portrait.png", "id": "1470913137957685", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304019_1470913141291018_3011473396555673668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhW0bseRfQUQ7kNvwFxZeN0&_nc_oc=AdroFPqxUJU927BYZwYJTggDeXOlx7wYh4HOfpyvQNvxWXAp5o23vUgKADhEIvNSqDs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4qGW4bVspjot_kOEmixWZvghoqW95Pil7HjAv3VcCaA&oe=69C90403"}, {"file_name": "icon_app_cifraria_1440.png", "id": "1469012724923209", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499301053_1469012728256542_7416521803008086253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_
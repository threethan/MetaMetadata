9zGzyeZ8LtU1ewJyg&oe=69B69DEB"}, {"file_name": "settings_10_Quest.png", "id": "769903052409522", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307962_769903055742855_5369264695749606127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4hJ-CjKndAQ7kNvwEdgmgY&_nc_oc=Adlubez6KnhbBPEv5Bf0aj6RpvCiT6n901gQ9gl6Vz6FaR1KS3O5m74PfH42NOm7MWU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwbQJXIMwf6tWL60v_ZQLAbvDqXv_QZEOnJzX-rT3dXtg&oe=69B6BD84"}, {"file_name": "home_10_settings_Quest.png", "id": "26256487057309894", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298291_26256487067309893_260636835105670560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlkpSe-AL_QQ7kNvwFgsj0y&_nc_oc=AdkgS3Df09q2Qtietdidam7osQDyjvrJHhTgD5Be6vNWoTmbRxaRIzJCulkkE4jtUxc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxwBeHke6VzN1KwoIfkisFqnJAssXuU768hZWbcowX7ww&oe=69B6AD84"}, {"file_name": "edit_10_Quest.png", "id": "791165707365094", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FanWb__gAAcQ7kNvwGOns5k&_nc_oc=AdlxPrpbKY7CLyFjJOTR3_ZozwTwtKSQm6yyWgMFTx05YOcqOR9vfebr-AdK59bp4Oc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFnlRaKaQDnIbfORqsyLzoeXIm0-sAX95NUpgL3k2IAQ&oe=69B6B228"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xPkOgzWtksQ7kNvwHoyLxU&_nc_oc=Adn47zRW1nKbWrjxFOjNsUfnbwlrRXUvBkEcjW93OEriU60_aTLY-5HjkZ9aGaOMem8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYU__gK1NbGrqwlIKA6JJTFzlSHCIsnFahSoaYGacaFw&oe=69B6B0CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCPrELhGz78Q7kNvwEmjfMG&_nc_oc=AdnB9o94XOKG7skquYPhcmqQSjF6GNUH-MZ3UDqYNe-LmexvARybrodrS853qu5ay3k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9NCVXqN9ZhngGjhYa02RSRg0qnV4wl4V8vzaO68xHqg&oe=69B69BD7"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7
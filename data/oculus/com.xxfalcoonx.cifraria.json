scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMjsuPm-i_ss4Wc71zxQGQZD5AJgcSzOSMbYwtYlZeGw&oe=69D0F644"}, {"file_name": "edit_10_Quest.png", "id": "1209432111385989", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499310731_1209432114719322_5500871760126419425_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVIXTLY9F7sQ7kNvwHnZpJX&_nc_oc=Adr7KmU9M5hPaONh93dOsNvHykbvEaPI4qKmhxd_8qm_vt1z-Y2S5Mla1tj4XctXMlo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxN13yoYXmHXa4h9OsstYpC2Vmo4OPlktHUB7B0vPyKCg&oe=69D12241"}, {"file_name": "player_10_Quest.png", "id": "908261954943342", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303746_908261961610008_2600051788214719246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1G6GiN3o-CcQ7kNvwGmbqnP&_nc_oc=Adr8jKUgpfi1A2t0lalocH91zNvbBBR-lTvuJF1ZALsvA3J91GjwKsJKO3vRrxgaSL8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwmru5K_p1oloZFSK2iEb1BisherjwHWH6QQF6nWkEZhw&oe=69D116E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Viol\u00e3o", "Ukulele", "Cifras", "Letras", "Biblioteca"], "long_description": "O **Cifraria** \u00e9 uma biblioteca profissional de m\u00fasicas e um aplicativo de gerenciamento de cifras desenvolvido em Flutter.\nCriado para m\u00fasicos de todos os n\u00edveis, ele oferece uma experi\u00eancia fluida para gerenciar, transpor e praticar suas m\u00fasicas favoritas, tanto no celular quanto no Meta Quest.\n\n\u2728 **Funcionalidades**\n\n\ud83d\udcc2 **Arquitetura Inteligente de Biblioteca**: Organize suas m\u00fasicas em pastas personalizadas com uma barra lateral em glassmorphism (efeito de vidro) para um visual premium e moderno.\n\n\ud83d\udd04 **Transposi\u00e7\u00e3o Instant\u00e2nea**: Mude o tom das m\u00fasicas em tempo real com um motor de transposi\u00e7\u00e3o robusto.\n\n\u2601\ufe0f **Sincroniza\u00e7\u00e3o em Nuvem (Google Drive)**: Fa\u00e7a backup e restaure com seguran\u00e7a toda a sua biblioteca, incluindo pastas e m\u00fasicas favoritas.\n\n\ud83d\udcf1 **Pronto para o Meta Quest**: Modo paisagem otimizado e dimensionamento de interface para um ambiente de pr\u00e1tica imersivo e sem distra\u00e7\u00f5es no Meta Quest.\n\n\ud83d\udcc4 **Importa\u00e7\u00e3o Multiformato**: Importe cifras da web (extra\u00e7\u00e3o com apenas um clique) ou de arquivos locais (PDF e DOCX).\n\n\ud83c\udfb6 **Cifras Interativas**: Acordes clic\u00e1veis com gera\u00e7\u00e3o autom\u00e1tica de diagramas, com suporte para Viol\u00e3o e Ukulele.\n\n\u26a1 **Foco em Performance**: Banco de dados local para carregamento instant\u00e2neo e funcionamento 100% offline.", "short_description": "O Cifraria \u00e9 uma biblioteca profissional de m\u00fasicas e o seu aplicativo definitivo para gerenciar cifras."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/18BVoWuGr5oKZaX6z0ZCklOlUod5mBmQH/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "David Kalil Braga", "support_website_url": null, "website_url": "https://davidkalil10.github.io/Cifraria_Website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25589638270718795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.c
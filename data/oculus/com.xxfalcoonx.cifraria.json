12454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FanWb__gAAcQ7kNvwGOns5k&_nc_oc=AdlxPrpbKY7CLyFjJOTR3_ZozwTwtKSQm6yyWgMFTx05YOcqOR9vfebr-AdK59bp4Oc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFnlRaKaQDnIbfORqsyLzoeXIm0-sAX95NUpgL3k2IAQ&oe=69B6B228"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xPkOgzWtksQ7kNvwHoyLxU&_nc_oc=Adn47zRW1nKbWrjxFOjNsUfnbwlrRXUvBkEcjW93OEriU60_aTLY-5HjkZ9aGaOMem8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYU__gK1NbGrqwlIKA6JJTFzlSHCIsnFahSoaYGacaFw&oe=69B6B0CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCPrELhGz78Q7kNvwEmjfMG&_nc_oc=AdnB9o94XOKG7skquYPhcmqQSjF6GNUH-MZ3UDqYNe-LmexvARybrodrS853qu5ay3k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9NCVXqN9ZhngGjhYa02RSRg0qnV4wl4V8vzaO68xHqg&oe=69B69BD7"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hYTczYyRScQ7kNvwGB1SWl&_nc_oc=Adls6oAdnoERbtkWcmml-5XF3K_mSbVHwXBsXeWf2xb597cm6HnTHSjpy4ecFqeAcu8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyz1quYS2lLWrWT0N0Y04lx49jmhsCnAGNzbXpr50lCTg&oe=69B68BCF"}, {"file_name": "cover_cifraria_portrait.png", "id": "1470913137957685", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304019_1470913141291018_3011473396555673668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oJYaDfvV78Q7kNvwGQS3Zh&_nc_oc=AdkqzR-z25NEtY55PfGyvp7lfRiLzPPUXhb1eYC3XUQrI2Cce2VcNQfmxB3E_c91VZA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLtvC_EhcDjZv6V2UbA2AIGf2YwSVdHFJ1uc9dmwMukQ&oe=69B68F03"}, {"file_name": "icon_app_cifraria_1440.png", "id": "1469012724923209", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499301053_1469012728256542_7416521803008086253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lb3Dz3yRDxYQ7kNvwGE7_zK&_nc_oc=Adm3j8Z3w144cGXcL
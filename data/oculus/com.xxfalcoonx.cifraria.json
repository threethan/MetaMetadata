content-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqrPzcPAfJ6DVJ3jgbtCQ1LVDkj_6SppgmYeX_9f-0SQ&oe=6A8C3D03"}]}, "id": "4356029028044012", "locale": "pt_BR", "screenshots": [{"file_name": "home_10_Quest.png", "id": "1471900691162468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307435_1471900694495801_4829947570561919049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlbUny7qqRIQ7kNvwE68SQy&_nc_oc=AdpFcgg2JJwY-ySFTUkwYG9ftoggZ118xIAYrAU73NMFT7DwhnVqA6ZAOuoN0hTZTek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvfZfmVcSQmW2JSXhqMALcY3krhuVemLwtMZ7GScCtCw&oe=6A8C338B"}, {"file_name": "settings_10_Quest.png", "id": "1391193859145570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308010_1391193862478903_5269474807905197381_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDkJze4JCscQ7kNvwHAV15P&_nc_oc=Ado1o0CXTZ5i2Y5LfBG1aKH07Lwro0nhGp9jMYrVWPJ5XapmDScUpXfZOaalFozyuOg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfFEBdCpS1AxRiXBHCG9ts2PmS8FnCch-78WRRG_peKA&oe=6A8C1201"}, {"file_name": "home_10_settings_Quest.png", "id": "890412220264365", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310817_890412223597698_6569410573752295327_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tmTl9ig6soQ7kNvwFmuvgZ&_nc_oc=AdqdxEkYwBZmqKJL0s7_s1u4CW3cdVaE1nF14azrV2swQ7O0TU60EtMWa8r5Toe5BFc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFciY_g9TAeFJDWH8sk8SeMPiH-SbNzcBf096ZVmkrw-Q&oe=6A8C2B44"}, {"file_name": "edit_10_Quest.png", "id": "1209432111385989", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310731_1209432114719322_5500871760126419425_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDaVLCAiVF8Q7kNvwF7NG6e&_nc_oc=AdpDCK6bFInOnd9HJ-RFZ6e-_bmRfTbFq4H6TkQ6JQQjvyjT3HGUI38zpURJHVJCEuA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGx8DtyXva99q5DeV0eySO99QIz4oulD24z-PhYCBy7Vg&oe=6A8C1F01"}, {"file_name": "player_10_Quest.png", "id": "908261954943342", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303746_908261961610008_2600051788214719246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNOSC0Em39EQ7kNvwGEB_dP&_nc_oc=AdoOngwtPuDGkZeDQ8tn4DMHgB6kD1S5EUl2fACtmkyY7MaopSEaukVtknpmAQCW7jY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6d_0FhA-NMRLY9P0iMDDWWT8nZw72rlM4V8iz1LtRWA&oe=6A8C13A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Viol\u00e3o", "Ukulele", "Cifras", "Letras", "Biblioteca"], "long_description": "O **Cifraria** \u00e9 uma biblioteca profissional de m\u00fasicas e de gerenciamento de cifras desenvolvido em Flutter.\nCriado para m\u00fasicos de todos os n\u00edveis, oferece uma experi\u00eancia fluida para gerenciar, transpor e praticar suas m\u00fasicas favoritas, tanto no celular quanto no Quest.\n\n\u2728 **Funcionalidades**\n\n\ud83d\udcc2 **Arquitetura Inteligente**: Organize suas m\u00fasicas em pastas personalizadas com uma barra lateral em glassmorphism (efeito de vidro) para um visual premium e moderno.\n\n\ud83d\udcdc **Gest\u00e3o de Repert\u00f3rios**: Crie listas personalizadas e organize as m\u00fasicas na ordem exata da sua apresenta\u00e7\u00e3o.\n\n\ud83d\udcf2 **Compartilhamento Pro**: Exporte seus repert\u00f3rios atrav\u00e9s da extens\u00e3o exclusiva .cifraria via apps de mensagem ou utilize o QR Code para que outro dispositivo com o app recrie a lista e as m\u00fasicas automaticamente.\n\n\ud83d\udd04 **Transposi\u00e7\u00e3o Instant\u00e2nea**: Mude o tom das m\u00fasicas em tempo real com um motor de transposi\u00e7\u00e3o robusto.\n\n\u2601\ufe0f **Sincroniza\u00e7\u00e3o em Nuvem (Google Drive)**: Fa\u00e7a backup e restaure com seguran\u00e7a toda a sua biblioteca, incluindo pastas e m\u00fasicas favoritas.\n\n\ud83d\udcf1 **Pronto para o Meta Quest**: Modo paisagem otimizado e dimensionamento de interface para um ambiente de pr\u00e1tica imersivo e sem distra\u00e7\u00f5es no Meta Quest.\n\n\ud83d\udcc4 **Importa\u00e7\u00e3o Multiformato**: Importe cifras da web (extra\u00e7\u00e3o com apenas um clique) ou de arquivos locais (PDF e DOCX).\n\n\ud83c\udfb6 **Cifras Interativas**: Acordes clic\u00e1veis com gera\u00e7\u00e3o autom\u00e1tica de diagramas, com suporte para Viol\u00e3o e Ukulele.\n\n\u26a1 **Foco em Performance**: Banco de dados local para carregamento instant\u00e2neo e funcionamento 100% offline.", "short_description": "O Cifraria \u00e9 uma biblioteca profissional de m\u00fasicas e o seu aplicativo definitivo para gerenciar cifras."}, {"images": {"nodes": [{"file_name": "icon_app_cifraria_1440.png", "id": "25137093062632621", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303140_25137093065965954_5340243871155545084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9q5Gtf1HCYQ7kNvwGettYa&_nc_oc=AdpujcVZHI3a1bOIMsIHt_j_CUjsUiSf8JiMDy_LZ3Lsvf1oZHGwcCHYj7tUd7M1obs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQqseiZ17Wzo9WtV2PpPy0_DYwdX9LXET9XVgXAvqDfA&oe=6A8C19E4"}, {"file_name": "icon_app_cifraria_512.png", "id": "1950929249182186", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308090_1950929252515519_3579238828299289210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9INrikLMgLsQ7kNvwFc85-m&_nc_oc=Adrvxr5QTXIjLgJB3IPTc2px6VJh3kuauN1uB3G4YHvit-AYpSbBj8m_LYp8zGYCZqM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF64es9AS8cWm3wDumS_jxtQFW8J97hhTIH95JmGmcr7Q&oe=6A8C1CBC"}, {"file_name": "cover art cifraria.png", "id": "1221596580110880", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307422_1221596583444213_1996221161851683055_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOia48x7O7IQ7kNvwE1J4vl&_nc_oc=AdoubkBJYMan9mrXEcE8rPT9sa4XWsgmwtcV9nfkhvXjY9JfgeXR7oPNxQ-osDaFqHc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgLsrCPzg9qWGu4Jsdh5jU03miZEQxWejVLclWZ8sHcw&oe=6A8C3FEE"}, {"file_name": "hero cover cifraria.png", "id": "955328883720100", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303140_955328887053433_2299564742518944745_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b26i7xZbOn0Q7kNvwFxTOoo&_nc_oc=Adrq-HlQq7URg4SSlgKt-x9aN4hjcrgyQUNbAaR7N6zWHieWjZG5FoZ94fPNO_iU7TA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3emtvOxB8H3vAXR1-u5hHRRWC-LLwvBzNZgVf4AmewQ&oe=6A8C3989"}, {"file_name": "cover_cifraria_portrait.png", "id": "923398230271609", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303790_923398233604942_8149238291275724655_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAUd93e9iicQ7kNvwE9LhTV&_nc_oc=AdqkWsjbQ7qEsYeRGR44Ir7IbXJ7yuh-2pdQAwF6KlfQFAul-PgEH27ox0GEBFhDwA8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHd0Y8nDxmOxc_oSwle94HwZRAcN2ug-z_k5UGyFMhOcA&oe=6A8C1116"}]}, "id": "2120506675398089", "locale": "en_US", "screenshots": [{"file_name": "home_10_Quest.png", "id": "1645036636740857", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819323_1645036640074190_2595786236772761378_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wv0hn83V39AQ7kNvwHpSkoS&_nc_oc=AdpFQk7gu6P8jzbGQFtUmyrL34NklRnAwLG2PQBoilsjn45U8basDMRxyBMpJTEIZDo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCMv37x6cix68A0jD17V7M97kdexf6vhn8fo5Zcy5JvQ&oe=6A8C34F2"}, {"file_name": "settings_10_Quest.png", "id": "827413820421285", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820855_827413823754618_7016173846081243344_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyC0jVV7_voQ7kNvwHbaghx&_nc_oc=AdoT2_MAdunk5sDXeh1aa6U2KOUScSmInZ9Ms4JCWWSMXr1EAfjIROzaEn9E-z-7OUY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH68t61lq_slyrVI4B26WlxJsf8DatoQFrnoBVThWPrzA&oe=6A8C29A6"}, {"file_name": "home_10_settings_Quest.png", "id": "1684432329357395", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819854_1684432332690728_2661215708382739758_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98QXyhSX-YEQ7kNvwGr2LgU&_nc_oc=AdqLnG3BvX_6cRHDAHiX2LIZvOtpIVYvkRAUawc6DtNT1Y4s-2D2KFj5QAKwfoBL3HI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPC5h6OwyqHT2EBtQJPMr35mBb8k3mNT-UshY6ibEa5A&oe=6A8C2D63"}, {"file_name": "edit_10_Quest.png", "id": "991159246965883", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821682_991159253632549_3726168677936387175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKIYZi8Wcu8Q7kNvwFhMW8u&_nc_oc=AdqTjhGMuMsucBQbYaDvGW8TSDzvPDhDAu8DdYBIgOXVeHvhX8jlNLqBYcGlwfrsnro&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEseNeWCUeKVLnIKoG1zHujT_Dm43EjL-GlsKuHa8snjQ&oe=6A8C1563"}, {"file_name": "player_10_Quest.png", "id": "966149539200528", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823296_966149542533861_6133643743596760205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6y5czBdh4kQ7kNvwH2pbgL&_nc_oc=AdrzYlnDb3_TchiRsGQN_jVjJfP1Kcnmn0VPA7mZxAb4vaeTDfdxpp1JjhZB55yW-bU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkgPaM1s3ca1aUwu57_Tjqq_hmVepyIRCeb4boxuqA7g&oe=6A8C14B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udcdc **Setlist Management**: Create custom lists and organize the songs in the exact order of your performance.\n\n\ud83d\udcf2 **Pro Sharing**: Export your setlists using the exclusive .cifraria extension via messaging apps or use the QR Code so that another device with the app can automatically recreate the list and songs.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/18BVoWuGr5oKZaX6z0ZCklOlUod5mBmQH/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "David Kalil Braga", "support_website_url": null, "website_url": "https://davidkalil10.github.io/Cifraria_Website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], 
oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPGmMCmkieIQ7kNvwEXmmdk&_nc_oc=AdqVHG8sIQISyXiEaf41osMe7XOOD-KDcnkGmrQR6mfWvZ9i1rxTvFy2ejWNdx1aoI0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDXhZAs5_yY6yI2Vj_rJjS5ojugMRQ26jnFuNGWlOS7g&oe=69CBCA28"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksY2QrPieEMQ7kNvwEglSy7&_nc_oc=Ado4ZfQgOXrN6NOfEJ9e1otdNiBbDlQ9AXcmN7OcOj3owfiubYj1zyV4hi6I3-qD9c0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3bBaj3b27RahnCJZuYTU-qb0Z_BfI3p0LiuGAFyHjQA&oe=69CBC8CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvhocnjFACoQ7kNvwGhStb3&_nc_oc=AdrUj8ybJKSWrr1PY8m8BIrdjv_9DeNSxDL2Q7xmWvIHM9YojGZcJrhnXsyJ4_UcPW0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_ihDXL7Kuyr_FLcwHc7l9tiblPVtAGJd6RQrUvh1sQQ&oe=69CBB3D7"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EN7yK5msZHAQ7kNvwFNcngC&_nc_oc=Adrr2mPyAVwuHOKH4i-fZnME_vC0g3s9zg8RDRiaiySchE7pTG8pJxiS-UeDE86-XdU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzimWfDoEeMZiv0tiTgWDIs_s4TxJEy1NLWXgf7Iwf7ww&oe=69CBDC0F"}, {"file_name": "cover_cifraria_portrait.png", "id": "1470913137957685", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304019_1470913141291018_3011473396555673668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38XMX59XCWkQ7kNvwGEfzZD&_nc_oc=Adr2vlDtcGmLFIq_R48UnwHw4vE__L80-xWPKwQQkWXq0acBhO5PZ7L3quPf7MF9yXU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxW8yUNQrOH0rwlW4RrporAwmCrUFXMMRWDCUTreJIxRQ&oe=69CBDF43"}, {"file_name": "icon_app_cifraria_1440.png", "id": "1469012724923209", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499301053_1469012728256542_7416521803008086253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_
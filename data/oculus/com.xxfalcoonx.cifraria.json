msbxD4wdv43BQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qcvVxmG_h-gP7QtLYF1LNQDVXlzqswHIm90Hw7CMPAg&oe=69D24D6B"}, {"file_name": "settings_10_Quest.png", "id": "769903052409522", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307962_769903055742855_5369264695749606127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsDPg0V9GIgQ7kNvwG_2AGs&_nc_oc=AdovLh6sJA3XY8bwGNEN9HjQH9NZLhhJ-xq8HgRc159DHu4svD26IljkQ49kJ4TaXso&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xBQpoobR9RpHki3u9UFvr20mSSfbSGxqYfZbyOjAAnQ&oe=69D26D04"}, {"file_name": "home_10_settings_Quest.png", "id": "26256487057309894", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298291_26256487067309893_260636835105670560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ql1SLP506SUQ7kNvwFOp4Nm&_nc_oc=Adp3l66eycFX9FNMrcUR0qNzhIjpT4pxWzcF9RAX8PQDz_Wip9cvgT0BhJZi2_iwmuQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04cPUteNBJHKaBqmSLGFqjPAfR5trLv9C8W6HB0O_C9Q&oe=69D25D04"}, {"file_name": "edit_10_Quest.png", "id": "791165707365094", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnkd6BjYgOMQ7kNvwENpIDM&_nc_oc=AdqcBpF6XdwbSIJPkvIcLhvP4Ae4bOSvH73LWbh2T9246EvYRVjTTEekfN14wO8_GLU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33v7ZH6BipyenuL41Be7fba7ew1BYWv0m-YWyFw4ST0g&oe=69D261A8"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zr9QsACjh-AQ7kNvwFqjRC-&_nc_oc=Ado7jl75JTkn9KkBBJyeW7xtn7oHhYcdqmNYom-zICYwbfLN7CJqW7nuGfbsc4v_Q_g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1v1nFV3yp3Rq7syQhHT4ToyOoj2HureS4g6N54uyFWKA&oe=69D2604A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BI4c8GnHQGUQ7kNvwGE74P6&_nc_oc=Adry3Dfn8MOvLtZdaynCWMxdaUY1eKy3ZlFsa1uBM7ErigWXymn213yRuPl_ACoZTjE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3s9HY1BM0RfjcqwUdrcdROo3jhBHbvhbVleZ7j_b0XgQ&oe=69D24B57"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "u
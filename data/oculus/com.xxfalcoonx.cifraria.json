oculuscdn.com/v/t64.5771-25/499312454_791165710698427_3600746330745442491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWHjKFwJ5HoQ7kNvwFsqoDI&_nc_oc=AdoCiYPNfioGbKOdKemUMXLTXyC8s_1c1qhUheLKcHP8RTnHwkZ2pAJCE-MTV6mYBQ8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0t8WBQs8FrN-XyEw85S4iiygVLZUTyFpFQlNiUMKtReg&oe=69D7A7A8"}, {"file_name": "player_10_Quest.png", "id": "25920738937546797", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499304162_25920738944213463_438337298222585684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8wBsXD3Q30Q7kNvwGS8nS8&_nc_oc=Adr3OtfjtKeLGK1R2HeZCte4WJZoUZ2UVhIwtwfpdoDFEs3foxctvVtfvk3SHUt3cVM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RQMXNuvvHEtsppQn1Ux3tbeFvFBeJFEGmiTLTQl6wmQ&oe=69D7A64A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Guitar", "Chords", "Songbook", "Lyrics", "Ukulele"], "long_description": "**Cifraria** is a professional song library and guitar chord management application built with Flutter.\n\nDesigned for musicians of all levels, it offers a seamless experience for managing, transposing, and practicing your favorite songs across Mobile and Meta Quest devices.\n\n\u2728 **Features**\n\n\ud83d\udcc2 **Smart Library Architecture**: Organise your songs into custom folders with a glassmorphism sidebar for a premium feel.\n\n\ud83d\udd04 **Instant Transposition**: Change song keys on the fly with a robust transposition engine.\n\n\u2601\ufe0f **Cloud Sync (Google Drive)**: Securely backup and restore your entire library, including folders and favorite status.\n\n\ud83d\udcf1 **Meta Quest Ready**: Optimized landscape mode and UI scaling for a distraction-free practice environment in Meta Quest.\n\n\ud83d\udcc4 **Multi-format Import**:  Import songs from the web (one-click extraction) or local files (PDF & DOCX).\n\n\ud83c\udfb6 **Interactive Chord Charts**: Clickable chords with automatic diagram generation, supporting both Guitar and Ukulele.\n\n\u26a1 **Performance First**: Local database persistence for instant loading and 100% offline functionality.", "short_description": "Cifraria is a professional song library and guitar chord management application"}, {"images": {"nodes": [{"file_name": "cover art cifraria.png", "id": "26363610273328303", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491825052_26363610286661635_6102729689722817825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUKJSzZkfWQQ7kNvwGL4sPQ&_nc_oc=Ado2Lb7XcZ1LTBDNKD7VHrFcSTytnGebh4jm4YXVcYaC2AxE7jozaBD-9jpekBt5wUY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Z6ykKk8Lr8QajdlSGzmQd55xZ5RNpWgocfFWv46LfHg&oe=69D79157"}, {"file_name": "hero cover cifraria.png", "id": "1480906750220476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822968_1480906753553809_65238026530416871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjECOTHLA3IQ7kNvwG3HM5n&_nc_oc=Adr0AhCMCpC1OrvmnGgN9b_9Ve96MJB6zLRiLD1dyqye-UXhScs7FE-BgReVIa18YgE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jrAETBGn0dDkKgw_BgC5RieDRKgjXSJgNJ2QcNAsvtA&oe=69D7B98F"}, {"file_name": "cover_cifraria_portrait.png", "id": "1470913137957685", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499304019_1470913141291018_3011473396555673668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NujW3jRsXHEQ7kNvwHCjIsR&_nc_oc=AdpjCrhqIxJi_im-dGE9ddHfKa0ne3ZH-npudaEE_c1Nrfd0yt1KwuGzVgp9Sortmg0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BY3JnHM7ys7bQUPdJ543BAG_vrDpkKbRZg7yVGoMZSg&oe=69D7BCC3"}, {"file_name": "icon_app_cifraria_1440.png", "id": "1469012724923209", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499301053_1469012728256542_7416521803008086253_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_
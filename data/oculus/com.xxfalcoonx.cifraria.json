&_nc_ohc=QV33FX6ddv8Q7kNvwEhqTjD&_nc_oc=Adp2or9S9w71eForWEiaUO4lbQhnDELOyu0b-xkfycV7tgZsd_vQ4A7GqFd0fp8jGcs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOWXe3dRg3cUYPJC_e0WnNx5_mdmgOs9Q9kPuFvZquxg&oe=6AF9E1C3"}]}, "id": "4356029028044012", "locale": "pt_BR", "screenshots": [{"file_name": "home_10_Quest.png", "id": "1471900691162468", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307435_1471900694495801_4829947570561919049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPOqYRsHFLgQ7kNvwG_Zmc9&_nc_oc=AdoLp3GQU-d9wJH7jokZXv0mFymYheVFtOrU3rGt0-C5udaVjFYYz6NfhzivYLR44v8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuvczFEuAusYqPGmA87e4WVdwLltoFZf3aJwImXu7iVg&oe=6AF9D84B"}, {"file_name": "settings_10_Quest.png", "id": "1391193859145570", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499308010_1391193862478903_5269474807905197381_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2_A_xYn3BMQ7kNvwHurCxW&_nc_oc=Adrh1QwBzUFZ7V2CyZcWxz0_zkva0n5RvKawX53wAanDoy32DnfE9Q_DsJ2ftUig-fU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1ZRXnyG8jt8xjGmgKbBagCUH00YrV7_FBdhSUMcJOAQ&oe=6AF9B6C1"}, {"file_name": "home_10_settings_Quest.png", "id": "890412220264365", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499310817_890412223597698_6569410573752295327_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJUqEXhpH00Q7kNvwEttIA5&_nc_oc=AdrpUUVIiOWe8CQ_sdAAf2d2pZDN_jUq0Jbl0S3MelrJtYXqBUDZHDmBUvHi0sPzMDc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6M97JZLWcpgDiFWZJrrd2WwV5ogU26BXk7j5BDfVsWA&oe=6AF9D004"}, {"file_name": "edit_10_Quest.png", "id": "1209432111385989", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499310731_1209432114719322_5500871760126419425_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thUkcINkuIgQ7kNvwFukVo7&_nc_oc=Adrx0WbXspHpnzjmuDBpqX4CUetIV4s3Vc_04D_ekLbQ2N6o7MP_MWw7G5AyBEzlek0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRklTsOKA3YdP6qMu6ZXKaBWjOkpIcoxhZFJ8JNbSEC0A&oe=6AF9C3C1"}, {"file_name": "player_10_Quest.png", "id": "908261954943342", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303746_908261961610008_2600051788214719246_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwD-bLvThAcQ7kNvwFHyQoP&_nc_oc=AdqNzPC-42d7qxA0zahiakO_xW_Rm1zlDDxxqVMem0KocCG27xfH8P_zj8ix6f_KWVE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcriq-TLtq4pFTglbegyZ9QaOfW3IM4kVFgSeuDu_Q0Q&oe=6AF9B862"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cifraria", "keywords": ["Viol\u00e3o", "Ukulele", "Cifras", "Letras", "Biblioteca"], "long_description": "O **Cifraria** \u00e9 uma biblioteca profissional de m\u00fasicas e de gerenciamento de cifras desenvolvido em Flutter.\nCriado para m\u00fasicos de todos os n\u00edveis, oferece uma experi\u00eancia fluida para gerenciar, transpor e praticar suas m\u00fasicas favoritas, tanto no celular quanto no Quest.\n\n\u2728 **Funcionalidades**\n\n\ud83d\udcc2 **Arquitetura Inteligente**: Organize suas m\u00fasicas em pastas personalizadas com uma barra lateral em glassmorphism (efeito de vidro) para um visual premium e moderno.\n\n\ud83d\udcdc **Gest\u00e3o de Repert\u00f3rios**: Crie listas personalizadas e organize as m\u00fasicas na ordem exata da sua apresenta\u00e7\u00e3o.\n\n\ud83d\udcf2 **Compartilhamento Pro**: Exporte seus repert\u00f3rios atrav\u00e9s da extens\u00e3o exclusiva .cifraria via apps de mensagem ou utilize o QR Code para que outro dispositivo com o app recrie a lista e as m\u00fasicas automaticamente.\n\n\ud83d\udd04 **Transposi\u00e7\u00e3o Instant\u00e2nea**: Mude o tom das m\u00fasicas em tempo real com um motor de transposi\u00e7\u00e3o robusto.\n\n\u2601\ufe0f **Sincroniza\u00e7\u00e3o em Nuvem (Google Drive)**: Fa\u00e7a backup e restaure com seguran\u00e7a toda a sua biblioteca, incluindo pastas e m\u00fasicas favoritas.\n\n\ud83d\udcf1 **Pronto para o Meta Quest**: Modo paisagem otimizado e dimensionamento de interface para um ambiente de pr\u00e1tica imersivo e sem distra\u00e7\u00f5es no Meta Quest.\n\n\ud83d\udcc4 **Importa\u00e7\u00e3o Multiformato**: Importe cifras da web (extra\u00e7\u00e3o com apenas um clique) ou de arquivos locais (PDF e DOCX).\n\n\ud83c\udfb6 **Cifras Interativas**: Acordes clic\u00e1veis com gera\u00e7\u00e3o autom\u00e1tica de diagramas, com suporte para Viol\u00e3o e Ukulele.\n\n\u26a1 **Foco em Performance**: Banco de dados local para carregamento instant\u00e2neo e funcionamento 100% offline.", "short_description": "O Cifraria \u00e9 uma biblioteca profissional de m\u00fasicas e o seu aplicativo definitivo para gerenciar cifras."}, {"images": {"nodes": [{"file_name": "icon_app_cifraria_1440.png", "id": "25137093062632621", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499303140_25137093065965954_5340243871155545084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVWQRlt9vAsQ7kNvwEddqCb&_nc_oc=Adpjjdbw5i1hniek-3OxERqIO6sjCMQPsSd8TjXZutIAfgi-15Ydd5VW_4TQfqkQEwo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpzom2y4-otxBux7J5PNEuS4gbk1AkZwrnRJkfK9Em9Q&oe=6AF9BEA4"}, {"file_name": "icon_app_cifraria_512.png", "id": "1950929249182186", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499308090_1950929252515519_3579238828299289210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkR9Grbfy9YQ7kNvwGxfBzN&_nc_oc=AdoNew289s2ucsUrA6MqFUhi1oS54DLR5XtdmGA8etBoEpDS9UfJBYlbhbcamKj2Pnc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPeLbxIJiHxSWSuvPhUJeVgKJp1LDpl9aCKA7yxSHr_A&oe=6AF9C17C"}, {"file_name": "cover art cifraria.png", "id": "1221596580110880", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499307422_1221596583444213_1996221161851683055_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABISW0SNrvIQ7kNvwFo
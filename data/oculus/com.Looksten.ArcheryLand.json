5771-25/39031495_582094936911306_6800017255329826407_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsg03bfQTFsQ7kNvwFuE31j&_nc_oc=AdrIvonCv3mZ4ZjTSZ3MgYazBEXpb24AWsyK0KwCFzs_1K-qanvcoNt3Z0-v1m7OT90&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYUxwOJtYYwfd9mcYUpgjGMRWUGdbkSz5FfG-_DlOxfA&oe=6B086EE3"}, "display_name": "Archery Land", "keywords": [], "long_description": "You became a warrior who was called by the goddess to protect the shrine of water. \nAs evening approaches, monsters aiming for the Shrine of Water appear.\n\nWarrior! \n\nPass 6 ordeals to protect the shrine of water from monsters.  And become a legendary warrior who protects the shrine of water and protects the goddess by killing monsters! \n\nAlso, Be the greatest warrior in a breathtaking 1v1 battle with other warriors in the arena of Archery Land.", "short_description": "Archery Land is a single, multiplayer VR shooting game, and Enjoy the thrilling feeling of hitting the target in our Archery Land by aiming the bow at the wide land.\n"}, {"images": {"nodes": [{"file_name": "Cover-MiniLandscape.png", "id": "1094889764444935", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974655_1094889767778268_3491009783949024005_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtHtJgXXd0QQ7kNvwHlThbl&_nc_oc=AdoDbGUAxAD_GK1oHzQWDHk6x4Ev_ZhmE1sU1lW6DcBpLNeZqola04Ju4LuYFj_-DJk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgWKoOg8GQfi2kwgLyAjMGzzF_ps59o8vySFmRHKNgbw&oe=6B086B81"}, {"file_name": "Logo.png", "id": "1038643100096859", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974716_1038643103430192_688937563710773948_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_KQX4s39pIQ7kNvwHg81CG&_nc_oc=AdqQe7KgtOhk6iq9fik1crRrZs1odI3SdQarhg5Ss7oEmgDwAhbWeuJ79TVk8Rz-Ia0&_nc_zt=3&_nc_ht
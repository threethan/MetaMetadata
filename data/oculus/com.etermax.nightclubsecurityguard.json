_2425434324673679578_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umsfysy252kQ7kNvwGQVNyt&_nc_oc=AdlnSrNtWKVm4PAzS4d8lrM7-OlZp6dWk_QgvTK0g524MsSRPd25wrtlXg0oqxoiaSc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwcDzulNqn-lhSWsi-TJAJrFmkmsCJg6cW_wxoGeb1QnA&oe=69B16D3E"}, {"file_name": "Screen_3.png", "id": "1426867195737452", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618499_1426867199070785_8158469394558004889_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RERbDOmgkaAQ7kNvwEz2CpZ&_nc_oc=AdkGVbfRpk7gNUVeM0XbwuNYb60OFGs4LR0xMtoQAElF0nuuX8lSLO1oGEBG0-lE4t8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3HbCnXmArnN8TCZIUmaIb1hD6rIl4PdHIlyuAK-igrw&oe=69B17191"}, {"file_name": "Screen_4.png", "id": "1933029233957238", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618103_1933029237290571_4002543048314846908_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLZ1Ar25CScQ7kNvwGg0B3i&_nc_oc=AdmoxWven4VcqgPFc42iHOJpLL3kq2z_b0f-3IXmeKct9qVAzz0dde3tevVRSyetfD8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx65TYXPcpp55tVE70QkXHBqvFa2MlI21EFbrASATVCPA&oe=69B17533"}, {"file_name": "Screen_5 (1).png", "id": "917785050692415", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619594_917785054025748_5713467866172121850_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NetZfgWJf7oQ7kNvwGFvZUu&_nc_oc=AdlKZ7HolcoUEvl8GKdiK6aOUK9Kc90anRUUOKY1F8bULHkdUkrJc3upaHRjn60VdOs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afym_WNzpHuFYizw1tIs9-1EbgvFPXq2GihVQ2dM-MGksg&oe=69B15087"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Night Club Security Guard", "keywords": ["nightclub", "security", "guard"], "long_description": "# Welcome to the door \ud83e\udea9\n\nYou\u2019re the security guard\ud83d\udec2. The night\u2026 is  **already out of control** \ud83d\ude05\ud83d\udd25\n\nGuests show up with attitudes \ud83d\ude24, excuses \ud83e\udd28, and zero patience \ud83d\udeb6\u200d\u2642\ufe0f\ud83d\udeb6\u200d\u2640\ufe0f. You\u2019ll need to **think fast**  \u23f1\ufe0f, **make tough calls**  \ud83e\udde0, and **keep the line moving**\u2014 even when everything starts to spiral \ud83d\ude35\u200d\ud83d\udcab.\n\nOne choice can calm the crowd \ud83d\ude0c Another can turn the whole entrance into chaos \ud83e\udd2f\ud83d\udea8 That\u2019s the fun.\n\n**From the creators of Airport Security Guard**, this VR job-sim comedy brings the same familiar humor \u2014 now louder, faster, and packed into a nightclub night \ud83c\udfb6\u2728.\n\nPressure builds. Reactions stack. Order slowly slips away \ud83d\ude2c\ud83d\ude02 \u2014 all without fighting or violence.\n\nFast decisions.\nNonstop reactions.\nNo complicated systems \n\n**Just you, the door, and a line that refuses to behave** \ud83d\udc83\ud83d\udd7a.\n\n\ud83d\udea7 The club isn\u2019t open yet \u2014 but it will be soon.\n\n**Night Club Security Guard is coming soon to Meta Quest** \ud83d\udc40\ud83d\udd25", "short_description": "The club is loud \ud83c\udfa7, the line is chaos \ud83d\udeb6\u200d\u2642\ufe0f\ud83d\udeb6\u200d\u2640\ufe0f, and you\u2019re the one guarding the door \ud83d\udec2\ud83d\ude05.\n\nMake fast decisions \u23f1\ufe0f, handle unpredictable guests \ud83e\udd2f, and try to keep control as pressure builds and the night gets wilder \ud83c\udf89\ud83d\udea8.\n\n\ud83d\udea7 Night Club Security Guard is coming soon to Meta Quest \ud83d\udc40\u2728"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3315
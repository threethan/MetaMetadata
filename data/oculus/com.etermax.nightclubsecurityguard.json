7f20f&oh=00_AQTXhyWXN8_wRyTCfZll_ep89WGMQcWtf4JRrMOKcft1SA&oe=6AF8ACBC"}, {"file_name": "Screen_2.png", "id": "1560862611867727", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620940_1560862615201060_2425434324673679578_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rC9ZaY6EYNMQ7kNvwF_e73w&_nc_oc=Adp_NNus8h1jjFoi4v_Wf6zDdlozu78KRvK8lnUwiDn01QfEGWdlhdwL8qMgaEVV0VA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHzgFQTUwNVev_gsceqSctp8Gw5ByXXTwlOdLVEXum3w&oe=6AF8997E"}, {"file_name": "Screen_3.png", "id": "1426867195737452", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618499_1426867199070785_8158469394558004889_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXj6WOG52VEQ7kNvwHY3vHR&_nc_oc=AdqwERPInl_Ayd9gV-FGT3YQ72GwVf4W9xZGD2-UF1WjqOuRCP10wFIOg7Mctsf4ZXg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAg0IhSAPOIiOq65zfyKO5TyzL1eJBPpMdeiKPtgkzYg&oe=6AF89DD1"}, {"file_name": "Screen_4.png", "id": "1933029233957238", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618103_1933029237290571_4002543048314846908_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dl9MuBBhJwQ7kNvwGLk55j&_nc_oc=AdoYObjLzZv5ZQQH5gEnWqoRxPmKrhoct9iYaqc1wXw-38DxavZuDlFw_vUt4xBMi-w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNwPiaLaVO0m5fG5jfS5Jg4p4ZJPqZuBzhbzKYC0H6og&oe=6AF8A173"}, {"file_name": "Screen_5 (1).png", "id": "917785050692415", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619594_917785054025748_5713467866172121850_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEuAF9OI6aQQ7kNvwGk1MTb&_nc_oc=AdrqCzwz1P2x3SawFvE6MHSygjDzmLOOzl-lpXjj0jERQOcaUNFZyENo_5na7XvgZvw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDC5_qKyVKD84zT3PT68s3k0e1898pMQHL2WWluSEgJw&oe=6AF87CC7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Night Club Security Guard", "keywords": ["nightclub", "security", "guard"], "long_description": "# Welcome to the door \ud83e\udea9\n\nYou\u2019re the security guard\ud83d\udec2. The night\u2026 is  **already out of control** \ud83d\ude05\ud83d\udd25\n\nGuests show up with attitudes \ud83d\ude24, excuses \ud83e\udd28, and zero patience \ud83d\udeb6\u200d\u2642\ufe0f\ud83d\udeb6\u200d\u2640\ufe0f. You\u2019ll need to **think fast**  \u23f1\ufe0f, **make tough calls**  \ud83e\udde0, and **keep the line moving**\u2014 even when everything starts to spiral \ud83d\ude35\u200d\ud83d\udcab.\n\nOne choice can calm the crowd \ud83d\ude0c Another can turn the whole entrance into chaos \ud83e\udd2f\ud83d\udea8 That\u2019s the fun.\n\n**From the creators of Airport Security Guard**, this VR job-sim comedy brings the same familiar humor \u2014 now louder, faster, and packed into a nightclub night \ud83c\udfb6\u2728.\n\nPressure builds. Reactions stack. Order slowly slips away \ud83d\ude2c\ud83d\ude02 \u2014 all without fighting or violence.\n\nFast decisions.\nNonstop reactions.\nNo complicated systems \n\n**Just you, the door, and a line that refuses to behave** \ud83d\udc83\ud83d\udd7a.\n\n\ud83d\udea7 The club isn\u2019t open yet \u2014 but it will be soon.\n\n**Night Club Security Guard is coming soon to Meta Quest** \ud83d\udc40\ud83d\udd25", "short_description": "The club is loud \ud83c\udfa7, the line is chaos \ud83d\udeb6\u200d\u2642\ufe0f\ud83d\udeb6\u200d\u2640\ufe0f, and you\u2019re the one guarding the door \ud83d\udec2\ud83d\ude05.\n\nMake fast decisions \u23f1\ufe0f, handle unpredictable guests \ud83e\udd2f, and try to keep control as pressure builds and the night gets wilder \ud83c\udf89\ud83d\udea8.\n\n\ud83d\udea7 Night Club Security Guard is coming soon to Meta Quest \ud83d\udc40\u2728"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support",
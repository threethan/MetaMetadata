uscdn.com&_nc_ss=7f20f&oh=00_AQJ8kHIrUSKzzZd90WNZ1kuxBH17yDdV5pi1lv3nB5FINw&oe=6AAEA07C"}, {"file_name": "Screen_2.png", "id": "1560862611867727", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499620940_1560862615201060_2425434324673679578_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQpeAw8PlgUQ7kNvwGfNyAC&_nc_oc=AdoWdVPvxAsz4a-b9r_TP3E4VmEasj6NgE_WMYNsZghYNFuFAFKuth2FnntcU7EfC9s&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ6B_pu0KiH5DfQ3eCcYwdewkK1G208VN443izLcRUWg&oe=6AAE8D3E"}, {"file_name": "Screen_3.png", "id": "1426867195737452", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618499_1426867199070785_8158469394558004889_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnIWHgGbTUMQ7kNvwERXDYa&_nc_oc=Adra69b0nXRlN9d3A8HNQwdo7Sw-ZTkHp366kV2lF_r686EJf6ZWONamcs65ZE2ONdQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIhbXKgSc3bcI8ERXn47qFce08yVtamOl5vLSjWtv4Mg&oe=6AAE9191"}, {"file_name": "Screen_4.png", "id": "1933029233957238", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618103_1933029237290571_4002543048314846908_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhNSM_o97LEQ7kNvwE_xbwW&_nc_oc=Ado3lrBGxA3R6XBe2SZAeX9oVBOYFj61XDlhUkYXLBXvQ01EumuPxSoI-meMoTJ2am8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQNXnE-SDNqYOrCCgix0k5abRLIUBoCkzAKauSOVTKbQ&oe=6AAE9533"}, {"file_name": "Screen_5 (1).png", "id": "917785050692415", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619594_917785054025748_5713467866172121850_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ee9KWvX44AgQ7kNvwG9xtEU&_nc_oc=AdrHRbkmYU--AHs4DoEA5S31lMuIAQcWB9HDNYtIqD9Jy70L4GZDeacWEeZTNBVFQjg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdOjsJ8fhPX-PbIEtiR2dUz4Ana8UoEr8xnRzg392RKA&oe=6AAEA8C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Night Club Security Guard", "keywords": ["nightclub", "security", "guard"], "long_description": "# Welcome to the door \ud83e\udea9\n\nYou\u2019re the security guard\ud83d\udec2. The night\u2026 is  **already out of control** \ud83d\ude05\ud83d\udd25\n\nGuests show up with attitudes \ud83d\ude24, excuses \ud83e\udd28, and zero patience \ud83d\udeb6\u200d\u2642\ufe0f\ud83d\udeb6\u200d\u2640\ufe0f. You\u2019ll need to **think fast**  \u23f1\ufe0f, **make tough calls**  \ud83e\udde0, and **keep the line moving**\u2014 even when everything starts to spiral \ud83d\ude35\u200d\ud83d\udcab.\n\nOne choice can calm the crowd \ud83d\ude0c Another can turn the whole entrance into chaos \ud83e\udd2f\ud83d\udea8 That\u2019s the fun.\n\n**From the creators of Airport Security Guard**, this VR job-sim comedy brings the same familiar humor \u2014 now louder, faster, and packed into a nightclub night \ud83c\udfb6\u2728.\n\nPressure builds. Reactions stack. Order slowly slips away \ud83d\ude2c\ud83d\ude02 \u2014 all without fighting or violence.\n\nFast decisions.\nNonstop reactions.\nNo complicated systems \n\n**Just you, the door, and a line that refuses to behave** \ud83d\udc83\ud83d\udd7a.\n\n\ud83d\udea7 The club isn\u2019t open yet \u2014 but it will be soon.\n\n**Night Club Security Guard is coming soon to Meta Quest** \ud83d\udc40\ud83d\udd25", "short_description": "The club is loud \ud83c\udfa7, the line is chaos \ud83d\udeb6\u200d\u2642\ufe0f\ud83d\udeb6\u200d\u2640\ufe0f, and you\u2019re the one guarding the door \ud83d\udec2\ud83d\ude05.\n\nMake fast decisions \u23f1\ufe0f, handle unpredictable guests \ud83e\udd2f, and try to keep control as pressure builds and the night gets wilder \ud83c\udf89\ud83d\udea8.\n\n\ud83d\udea7 Night Club Security Guard is coming soon to Meta Quest \ud83d\udc40\u2728"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://ww
_oc=AdlhUnEsZCTBB27Ecxy0vMAAWJkAWRUpEQ8EpGs18BfGerxyc4aE74ahvWOAjDSb9MI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfshUNGaqNu_TkkTOr01TZxt1U6i_nHw1vgwpMUs_LR2OQ&oe=699C5EFA"}, {"file_name": "ScreenNCSG_01.png", "id": "931519709437616", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618093_931519719437615_7652705394402167247_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpeBuP70cAkQ7kNvwFyGBRD&_nc_oc=AdmzC6P8o9JATnoKGOF09bUY1V-aRllF9peph1SqEskkmac2YJgTYMBH-V_CeLXttOs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft6KlOicJPQ7mxsWsZRv53kDMzvmuhZBLnkv7o4d8kazA&oe=699C3835"}, {"file_name": "ScreenNCSG_03.png", "id": "784799824048409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619485_784799830715075_5013806143144176371_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bx0sLh3YybMQ7kNvwHszlIG&_nc_oc=Adlb1_jP9Ki-4YupsWtV1umkw-OBGNYg6cToRoPgQxklTZjTmsXqLI1y2kdutGbF-nw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsEN-VGpGSo_lrlJXoyewxSTipIkSFcKmr-jRErI9r3PA&oe=699C4A53"}, {"file_name": "ScreenNCSG_05.png", "id": "1446363993614526", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618442_1446364000281192_2790690135243870641_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxV7wUKirA8Q7kNvwGoRCfg&_nc_oc=AdlGG4ExUAWFl4HAh81TX5UtjMd_XvGnzsv7W4gfgC-Xlw5yhUfiBPVdLPOGP3dv_14&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuaYkGRlXZ5Rtc7-DkqEj5DvKcJL-pr4fUFtsC_dSm5dw&oe=699C5453"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewScreenNCSG_01.png", "id": "1451828369995194", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_1451828373328527_6116292065737015199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1SF411sxDwQ7kNvwG8oSEJ&_nc_oc=Adny6Z6I_BdCMdKd2OIOXILYhWZHEK_lDGkjdfA7w1kbPOEQE-6vKMizjy-GwECRSHU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afto8g_9zdoXvn3K1Oc6WinaR2j48bbTmX_IPJ9wOXDGdQ&oe=699C3B87"}, "display_name": "Night Club Security Guard", "keywords": ["nightclub", "security", "guard"], "long_description": "                                                                                                                                                                 \n\n# Welcome to the door \ud83e\udea9\n\nYou\u2019re the security guard \ud83d\udec2. The night\u2026 is  **already out of control** \ud83d\ude05\ud83d\udd25\n\n{1415090246788520}\n\nGuests show up with attitudes \ud83d\ude24, excuses \ud83e\udd28, and zero patience \ud83d\udeb6\u200d\u2642\ufe0f\ud83d\udeb6\u200d\u2640\ufe0f. You\u2019ll need to **think fast**  \u23f1\ufe0f, **make tough calls**  \ud83e\udde0, and **keep the line moving**\u2014 even when everything starts to spiral \ud83d\ude35\u200d\ud83d\udcab.\n\n{25620567477596357}\n\nOne choice can calm the crowd \ud83d\ude0c Another can turn the whole entrance into chaos \ud83e\udd2f\ud83d\udea8 That\u2019s the fun.\n\n**From the creators of Airport Security Guard**, this VR job-sim comedy brings the same familiar humor \u2014 now louder, faster, and packed into a nightclub night \ud83c\udfb6\u2728.\n\nPressure builds. Reactions stack. Order slowly slips away \ud83d\ude2c\ud83d\ude02 \u2014 all without fighting or violence.\n\nFast decisions.\nNonstop reactions.\nNo complicated systems \n\n**Just you, the door, and a line that refuses to behave** \ud83d\udc83\ud83d\udd7a.\n\n{1627619151597703}\n\n\ud83d\udea7 The club isn\u2019t open yet \u2014 but it will be soon.\n\n**Night Club Security Guard is coming soon to Meta Quest** \ud83d\udc40\ud83d\udd25\n", "short_description": "The club is loud \ud83c\udfa7, the line is chaos \ud83d\udeb6\u200d\u2642\ufe0f\ud83d\udeb6\u200d\u2640\ufe0f, and you\u2019re the one guarding the door \ud83d\udec2\ud83d\ude05.\n\nMake fast decisions \u23f1\ufe0f, handle unpredictable guests \ud83e\udd2f, and try to keep control as pressure builds and the night gets wilder \ud83c\udf89\ud83d\udea8.\n"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25780780948231730"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618293_1564662044841720_4462393604471954933_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wt8l39ewdX8Q7kNvwHDcRRb&_nc_oc=AdnwvAC4Prpm5mGryJUF9Cx60waaXnHCpohHbVyFayhhZm_5dBsKXfbJ3fpHO7g0NLA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvJfAKXkcqBsioxUPvqYacE2YJY8S6qd743YZlWHZqk8A&oe=699C53CC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Night Club Security Guard", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1770820680, "lastRevision": {"nodes": [{"id": "25171354785841019", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25171354749174356", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": 
id=6e7a0a&_nc_ohc=kHKTHCVN9fUQ7kNvwEdQy52&_nc_oc=AdpvtFfzCfEkE9Xrlydj02cit2BzXAZUrZBI9ofnciuEj0N1joVE0BhKgV-SBF3xhm0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELqEeSZN80xcpdKZkPBxFKAeJAhk9kOLNQgOePM85koA&oe=6A9417A5"}, {"file_name": "NSG_Screenshot 1.png", "id": "1470845877945067", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499617847_1470845884611733_4966766023818313016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_Jyy_IWXeYQ7kNvwHPyJ09&_nc_oc=AdqxngsPIM_-SzK2smeScBYgnPffD66-JDgQiWiqGnuaovwkOnDbQsmKEw2TaMGaylo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhOYkPdSghhfNKyVckuIBtsk_bcpISUlX37V4lRFuU-w&oe=6A940EC7"}, {"file_name": "ncsg001.png", "id": "4474468362874796", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499618093_4474468366208129_8648280303881944460_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7im8LebgMDwQ7kNvwGGjK4a&_nc_oc=Adqd9qJn5rhfaKPmlsrAVHR_gsImVazgvCahSzVmD73eifQv-WxdXPUGMKMe8V6QlWY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHq78RzEa8vvRpnht2lMe1qO5uktwYMT0Q62VZHs90zpQ&oe=6A9417A7"}, {"file_name": "cnsg002.png", "id": "1601302374288634", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499619098_1601302377621967_4045059050436380321_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7nIUqLHHNoQ7kNvwFfvVEI&_nc_oc=AdrYXg2qYednaUEqXyZDowiZVHMWPI6zepTq5gGWPTsMh0k1OFKKlMfmKtLN1HE_ZKE&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaDhRhnXiHJ6N8OjawddzZuJPJWIp14WhxWB8LsxeY3Q&oe=6A940F49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NSG2560x1440_VIPS.png", "id": "3039321236458231", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499299808_3039321239791564_5344769432823183381_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nF1G6l6mGLoQ7kNvwERh2wM&_nc_oc=AdoSgJpuFeRLQUzPtTNIRWMz89ZP5TngfHTaJf374MbUHRMUmklDqj7U9ecFuljoPsU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzMGc0AeDVtc_7HCIbO2tlawz-dAPLmA6RN95g4oqFZw&oe=6A940804"}, "display_name": "Nightclub Security Guard", "keywords": ["nightclub", "security", "guard"], "long_description": "                                                                                                                                                                 \n                                                                                                           \n{2716133055387696}\n\n# Things are getting aggressive \ud83d\udd2b\n\nMost guests complain. Some argue.  \nBut a few push things too far.\n\nWhen aggressors start trouble, you\u2019ll need to **fight back and protect the door**. Keep control, hold the line, and make sure the night doesn\u2019t spiral into chaos.\n\nBut that\u2019s not the only problem tonight.\n\n{964371032585550}\n\n# VIPs are arriving \ud83e\udea9\ud83d\ude97\n\nLimos pull up. Influencers drop names \ud83c\udfa4. Entourages expect instant access \ud83d\udc40.\n\n\nSome VIPs arrive drunk \ud83c\udf7b.  \nSome are drugged \ud83d\udc8a.  \nSome show up filthy and expect you to ignore it \ud83e\udd22.\n\n{1689978059050275}\n\nYou **can\u2019t turn VIPs away** \u2014 so you\u2019ll need to **clean them up and sober them up** before letting them inside.\n\n\ud83c\udfad Spot fake status and bad behavior  \n\ud83e\uddfc Clean up messy VIPs  \n\ud83d\udc8a Sober up party animals  \n\ud83d\ude97 Manage luxury arrivals and special treatment  \n\nYou\u2019re the security guard \ud83d\udec2, and the night is **already out of control** \ud83d\ude05\ud83d\udd25\n\n{2134599054031513}\n\nGuests arrive with attitudes \ud83d\ude24 and excuses \ud83e\udd28. You\u2019ll need to **think fast** \u23f1\ufe0f, **make tough calls** \ud83e\udde0, and **keep the line moving** \u2014 even when everything spirals \ud83d\ude35\u200d\ud83d\udcab.\n\nFast decisions.  \nNonstop reactions.  \nRising chaos.\n\n**Just you, the door, and a line that refuses to behave** \ud83d\udc83\ud83d\udd7a.\n\nJoin us in **https://discord.com/invite/etermaxrstudio** to stay up to date at all times.\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "The line just got dangerous \ud83d\udd2b\ud83e\udea9\n\nAggressors can push things too far \u2014 and when they do, you\u2019re ready to fight back and protect the door.\n\nMeanwhile VIPs are arriving \ud83d\ude97. Some show up drunk \ud83c\udf7b, drugged \ud83d\udc8a, or filthy \ud83e\udd22. You can\u2019t send them away\u2026 so you\u2019ll have to clean them up and sober them up before letting them in.\n\nPower. Status. Chaos at the door.\n"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27819320964377708"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499303864_1923592181582287_2420997385171227157_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3oIiE-HoxgQ7kNvwH5GaUL&_nc_oc=Adon38ueALHI6o-toOfVLwOt0XdtKgKB-fM2LlvsYZkbU9QI1vAQCCoBbaoKnf8v9GQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFc22X8G5o8Hh_dO09I3
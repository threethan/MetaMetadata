_oc=AdnK1TiBWy_0SW2JSxcQ-kfTQpt-O1sLvyWsZScgziyFxDLZ2Jc-gayo22YnJG7u1yw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuiJ_V0w0S2l4tLc84yRojdCCkjaG8SY9HtmH5OBzKSKQ&oe=69A0537A"}, {"file_name": "ScreenNCSG_01.png", "id": "931519709437616", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618093_931519719437615_7652705394402167247_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsV-CvzNKTYQ7kNvwH1zdjA&_nc_oc=Adn4d_9j4TvjXMSYDkbdgqjiQFpKGBUAJChE9rssMdGlWvH19DZsMiJPrmmjEnYfCfY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuEnlIQkzjXDFEdewwkUgSiLechL-zVh-_oQlwx3sd3VQ&oe=69A02CB5"}, {"file_name": "ScreenNCSG_03.png", "id": "784799824048409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619485_784799830715075_5013806143144176371_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrICTN2G-L8Q7kNvwGYYaJz&_nc_oc=AdljBhzMDf3C3MTb8VO8BGIxffSda_7ZM46-pryEA0ycclRNEdrxgm0Ipv1aJGqkNkw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsGXT6kvuHyjYif4TEF5vhgTTQwi_h7NKO0M_3Zz-UK5A&oe=69A03ED3"}, {"file_name": "ScreenNCSG_05.png", "id": "1446363993614526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618442_1446364000281192_2790690135243870641_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYC_i3Won74Q7kNvwF5OMMk&_nc_oc=Adkp4H2GsdTBgFJXb2tZDJAoVaOBNy8Tn9KnNfW3aC4TxXK2Ipn-rF3ov8Zh3bzsnX8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu3mg3JQWSKmsSGQKQqjz0Sb-xUFXH3IqZ6OrXBETWUGA&oe=69A048D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewScreenNCSG_01.png", "id": "1451828369995194", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_1451828373328527_6116292065737015199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8A2zcdWJDBUQ7kNvwGEZent&_nc_oc=AdlkqAKt17A-CeX8an3gKF0Cd00ulI64-Bbt_aqdmUdzC6KUSypG9Mym4c_Hudp_zls&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsBAisM5OadpURgURzL7bZWHLtq4EJzBlAFi1tuusXLTw&oe=69A03007"}, "display_name": "Night Club Security Guard", "keywords": ["nightclub", "security", "guard"], "long_description": "                                                                                                                                                                 \n\n# Welcome to the door \ud83e\udea9\n\nYou\u2019re the security guard \ud83d\udec2. The night\u2026 is  **already out of control** \ud83d\ude05\ud83d\udd25\n\n{1415090246788520}\n\nGuests show up with attitudes \ud83d\ude24, excuses \ud83e\udd28, and zero patience \ud83d\udeb6\u200d\u2642\ufe0f\ud83d\udeb6\u200d\u2640\ufe0f. You\u2019ll need to **think fast**  \u23f1\ufe0f, **make tough calls**  \ud83e\udde0, and **keep the line moving**\u2014 even when everything starts to spiral \ud83d\ude35\u200d\ud83d\udcab.\n\n{25620567477596357}\n\nOne choice can calm the crowd \ud83d\ude0c Another can turn the whole entrance into chaos \ud83e\udd2f\ud83d\udea8 That\u2019s the fun.\n\n**From the creators of Airport Security Guard**, this VR job-sim comedy brings the same familiar humor \u2014 now louder, faster, and packed into a nightclub night \ud83c\udfb6\u2728.\n\nPressure builds. Reactions stack. Order slowly slips away \ud83d\ude2c\ud83d\ude02 \u2014 all without fighting or violence.\n\nFast decisions.\nNonstop reactions.\nNo complicated systems \n\n**Just you, the door, and a line that refuses to behave** \ud83d\udc83\ud83d\udd7a.\n\n{1627619151597703}\n\n\ud83d\udea7 The club isn\u2019t open yet \u2014 but it will be soon.\n\n**Night Club Security Guard is coming soon to Meta Quest** \ud83d\udc40\ud83d\udd25\n", "short_description": "The club is loud \ud83c\udfa7, the line is chaos \ud83d\udeb6\u200d\u2642\ufe0f\ud83d\udeb6\u200d\u2640\ufe0f, and you\u2019re the one guarding the door \ud83d\udec2\ud83d\ude05.\n\nMake fast decisions \u23f1\ufe0f, handle unpredictable guests \ud83e\udd2f, and try to keep control as pressure builds and the night gets wilder \ud83c\udf89\ud83d\udea8.\n"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25780780948231730"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618293_1564662044841720_4462393604471954933_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-QT6hHuV4wQ7kNvwE5BQWk&_nc_oc=AdmYwtNnXZ1N9uYanir4PiZQPNgw5QNcy7bRYs1NW6adFzPHDIYOWVGq0CmNLyVFVHI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvg3ay9SGfFvhj0aPtFt3sk1SQVbiHIE9igXZahIfGquw&oe=69A0484C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Night Club Security Guard", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1770820680, "lastRevision": {"nodes": [{"id": "25171354785841019", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25171354749174356", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": 
=1-7&_nc_sid=6e7a0a&_nc_ohc=yHFmi2pngVwQ7kNvwHcYUQE&_nc_oc=AdkMQTt8eauXffAI1NzsHMOYwQKqYu9swpFXpTLADAkkPxsRh1JWJbHplHs1QtCpx7s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyXQFbLKcryqXGkhOqGCdE1fi1vH8_yHihT8gb7bpFu9w&oe=69BA9231"}, {"file_name": "NSG_Screenshot 1.png", "id": "1470845877945067", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617847_1470845884611733_4966766023818313016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QolEYhSmaEsQ7kNvwEZ41Lo&_nc_oc=Adl8FmPQfUoCB2ecX6_rjX2lsvJvcEKvDpz2_gy6wpVlcYCcoGORuv7So0VCLX87xSM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyHevlreLkhAVA6sz_CHvcfqXxEgLLLOurQf_57XU3grw&oe=69BA8747"}, {"file_name": "NSG_Screenshot 2.png", "id": "1648030643039664", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821178_1648030646372997_9025758410693008300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_d7okyK9g1QQ7kNvwG9n46g&_nc_oc=AdnqCnGW6n8HMK3ZdwdtWxsPIq-SBtEtm6i5X9W-YykjDir_Z5ZEFRpNicvdA-hrUaM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afylm7IB_Lhija4dGfOx76yg3Cj4OrDmBbdTE65Ql0MQ1w&oe=69BA99A5"}, {"file_name": "NSG_Screenshot 2 (1).png", "id": "1373301531267522", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307479_1373301534600855_657375561983585260_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Br5wC6sHvYQ7kNvwFclyIK&_nc_oc=AdmexbbYzD6KEx2Ge88yJp5bmsWOVizkxFS8TLF8-GRroxMCEM53jc9rt2BAS-xum6E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzF03KwMdS0GJJBhZBxeJBChEmxidWn9XvYw6kM9P0fOg&oe=69BAA78E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NSG2560x1440_VIPS.png", "id": "3039321236458231", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499299808_3039321239791564_5344769432823183381_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rk6FZUKXJPEQ7kNvwHZ4EiZ&_nc_oc=Admq79n1BT4qM7Cf3wuB3uOhi8mJR6YKhjq9D0As3pD6yrrxoNcdEfK1CyQYPmsJgxA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyWVEys5enwZEPlo2kgvfrYRanKtr01qCTmOuxPKSgeqg&oe=69BAB8C4"}, "display_name": "Night Club Security Guard", "keywords": ["nightclub", "security", "guard"], "long_description": "                                                                                                                                                                 \n                                                                                                           \n{2716133055387696}\n\n# Things are getting aggressive \ud83d\udd2b\n\nMost guests complain. Some argue.  \nBut a few push things too far.\n\nWhen aggressors start trouble, you\u2019ll need to **fight back and protect the door**. Keep control, hold the line, and make sure the night doesn\u2019t spiral into chaos.\n\nBut that\u2019s not the only problem tonight.\n\n{964371032585550}\n\n# VIPs are arriving \ud83e\udea9\ud83d\ude97\n\nLimos pull up. Influencers drop names \ud83c\udfa4. Entourages expect instant access \ud83d\udc40.\n\n\nSome VIPs arrive drunk \ud83c\udf7b.  \nSome are drugged \ud83d\udc8a.  \nSome show up filthy and expect you to ignore it \ud83e\udd22.\n\n{1689978059050275}\n\nYou **can\u2019t turn VIPs away** \u2014 so you\u2019ll need to **clean them up and sober them up** before letting them inside.\n\n\ud83c\udfad Spot fake status and bad behavior  \n\ud83e\uddfc Clean up messy VIPs  \n\ud83d\udc8a Sober up party animals  \n\ud83d\ude97 Manage luxury arrivals and special treatment  \n\nYou\u2019re the security guard \ud83d\udec2, and the night is **already out of control** \ud83d\ude05\ud83d\udd25\n\n{2134599054031513}\n\nGuests arrive with attitudes \ud83d\ude24 and excuses \ud83e\udd28. You\u2019ll need to **think fast** \u23f1\ufe0f, **make tough calls** \ud83e\udde0, and **keep the line moving** \u2014 even when everything spirals \ud83d\ude35\u200d\ud83d\udcab.\n\nFast decisions.  \nNonstop reactions.  \nRising chaos.\n\n**Just you, the door, and a line that refuses to behave** \ud83d\udc83\ud83d\udd7a.\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "The line just got dangerous \ud83d\udd2b\ud83e\udea9\n\nAggressors can push things too far \u2014 and when they do, you\u2019re ready to fight back and protect the door.\n\nMeanwhile VIPs are arriving \ud83d\ude97. Some show up drunk \ud83c\udf7b, drugged \ud83d\udc8a, or filthy \ud83e\udd22. You can\u2019t send them away\u2026 so you\u2019ll have to clean them up and sober them up before letting them in.\n\nPower. Status. Chaos at the door.\n"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26039060929070396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499303864_1923592181582287_2420997385171227157_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0tyzo3GlTQQ7kNvwHY-aIz&_nc_oc=Adl5TLpdkMdC3ktCo_FT9e0HX4j_fqmTth_sMKA99pWoZ63vTQasRPexc09n_5II9No&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxC18sz8kTwFjccaaNaUg_3YNWFQ3dYTXED8VMzSgPEvA&oe=69BA9753"}, "is_concept": false, "is_test": false, "is_t
f&oh=00_AQT6hP23Y5DRQKTqzigxbyqKl0g4KLDCqXlvw5Wpc7MGcA&oe=6AF48D27"}, {"file_name": "cowboy05.png", "id": "607311835428962", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391883_607311838762295_8050934543066833954_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BM87vrsmg4Q7kNvwGPZHip&_nc_oc=AdrDdAM8b586ChfbCZ0EfezeN8naMvO3pMsgeOfHWZv3vddbvZ4V8zs51YgVYP8vV98&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVM4TGUju4UR2CmUWtZsQyqWoSqR3zEi013CMn8IdDog&oe=6AF48D3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Western Gun Shooter Cowboy Sheriff", "keywords": ["revolver", "gunslinger", "west", "defence", "wild"], "long_description": "In this game you are a sheriff of a town in the wild west. When you are protecting the piece of your town, outlaw cowboys keep attacking you. Luckily, you have two reliable double-action revolvers, excellent gunslinger skills, and three brave deputies to help you. The town folks are counting on you. ", "short_description": "Hunt down outlaws with your double revolvers in a realistic wild western town environment. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://karamuyo.wordpress.com/tug-art-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mustafa Tu\u011frul \u00d6z\u015fahin", "support_website_url": null, "website_url": "https://karamuyo.wordpress.com/western-gun-shooter-cowboy-sheriff/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS
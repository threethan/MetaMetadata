ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPerH_3BbAyLKDdUYuGX5hsxv6i9JtKQg12G1v4yZ_3Sg&oe=6AC7AEAA"}, {"file_name": "Still 2025-12-21 163711_1.1.3 (Custom).png", "id": "904749742308208", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821682_904749748974874_7072301537645098243_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcQ9BpSAs-IQ7kNvwGk2Qb-&_nc_oc=AdqmuSb7TjV1KJDqLGqm8H1GitBS4llAWIbwpphgLawlfgfe-wXIY-OWPXT5dgarT7M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNisfVxWQg1sCJ66w5YzEutoHrFiei7WqU4z0GfEzKvuQ&oe=6AC7CDBE"}, {"file_name": "Still 2025-12-21 163711_1.1.5 (Custom).png", "id": "926630016387451", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827611_926630019720784_105111629006764937_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRtOWzyqfUsQ7kNvwFdkg8o&_nc_oc=Adr1wyHHbHRFC4WvMbU4w_lo_-lTNwNy5O4pamzTDUCE-kXs40tUE8yQJYxCXXUbgdA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwxu5JCDljKpaLVnMXhJImf2H_UsvSMvjF4R3m0DaodA&oe=6AC7B6F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Just-One-Man-Store-FormatsCover-Image-(Trailer-Thumbnail).png", "id": "4480961592140390", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491829165_4480961595473723_2230291764345148973_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W24htQe6GkYQ7kNvwG5vvvA&_nc_oc=AdqxaoYwwHze5kgoVusytkcqGyBnynrSnRWE5Ki3iCPtBNVRZQJWXiDoU1bgUBpdjg8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPD1XAKxZxiQlaGEt-PGpFmydDGLz2PkE0oaaHTl20mpQ&oe=6AC7C3C3"}, "display_name": "JUST ONE MAN - Demo", "keywords": ["combat", "fighting", "ninja", "sword", "arcade"], "long_description": "**JUST ONE MAN** is a hack-and-slash game where you are the OVERPOWERED VILLAIN. Stylishly slaughter enemies with a variety of weapons, combo attacks, and overpowered abilities while listening to aggressive beats. Invent your own playstyle and achieve highest scores by performing the wildest combos you can imagine.\n\n**THIS IS A DEMO VERSION.** For the full game, go check out: https://www.meta.com/experiences/just-one-man/8802299089893750/\n\n{1366993488509940}\n\n# SMOOTH AND SATISFYING MELEE COMBAT\nVisceral slices, impactful punches, lighting fast dashing. The fighting is designed only one goal in mind: it has to feel as satisfying as possible. Immerse into the flow of the combat and become the ultimate martial arts master.\n\n{1147178310667413}\n\n# EASY TO LEARN, HARD TO MASTER\nThe basics are simple, everyone can learn them in minutes. It is up to you, what kind of fighting style you want to come up with, but only the **COOLEST COMBOS** and **EDGIEST EXECUTIONS** get you that sought after SSS-rank.\n\n{939895022043332}\n\n# FEATURES  \n* **PUNCH, SLICE, PARRY, DODGE** and **DASH** your way through unrelenting waves of enemies\n* Use your **FISTS** to punch enemies into a pulp\n* Grab the **WEAPONS** from fallen enemies to vary your combat style\n* Unleash powerful **ABILITIES**, unique for each weapon\n* Scoring system that rewards **THE COOLEST COMBOS**\n* Traverse four **UNIQUE ENVIRONMENTS** to test your skills\n* An **ENDLESS MODE** for facing the ultimate challenge (and workout :D)\n* All the while listening to the **BANGING SOUNDTRACK**\n\n{1619995022464709}\n\nAre you ready to **BECOME THE VILLAIN?**", "short_description": "JUST ONE MAN is a hack-and-slash game where you are the OVERPOWERED VILLAIN. Stylishly slaughter enemies with weapons, combo attacks and devastating abilities while listening to banging beats. Choose your own playstyle and invent the wildest combos to achieve the highest scores imaginable. This is a DEMO version of the full game. If you like it, please go check out our full version."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raikirigames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Raikiri", "support_website_url": null, "website_url": "https://www.raikirigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25879792504994875"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2020974975134211"}]}, "baseline_offer": {"id": "2020974975134211"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770933600, "status": "PUBLISHED", "id": "2020974975134211"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28063828503257920", "version": "1.2.3"}, "id": "26208709642087178", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25879792441661548", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28063828503257920"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "26208709642087178"}]}, "change_log": "- Updated the demo level visuals\n- Ultimate impact frames\n- Updated UI\n- Bugfixes and improvements", "created_date": 1786991395, "id": "28063828503257920", "version": "1.2.3", "version_code": 63, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 
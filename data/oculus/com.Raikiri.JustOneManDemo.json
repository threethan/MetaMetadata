n.com&_nc_ss=7f20f&oh=00_Af9dO2Qg6BJ33yS0WtdilgJX8-OA_rQz8DuYrBlw1Znf3A&oe=6A26D7AA"}, {"file_name": "Still 2025-12-21 163711_1.1.3 (Custom).png", "id": "904749742308208", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821682_904749748974874_7072301537645098243_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppM86oUVIfAQ7kNvwFtCxJD&_nc_oc=AdoViPFkeiRCqnKMV4_cREH6BdcEZmHSPmn3ui8DZxcteQZqF1vSF-rg32NuyqlLMpA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NOjhUHWLApimUxfKo3xp0_QxTPTW8d6rC7_8KXNr-Yg&oe=6A26BE7E"}, {"file_name": "Still 2025-12-21 163711_1.1.5 (Custom).png", "id": "926630016387451", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491827611_926630019720784_105111629006764937_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mInLCDHH1xkQ7kNvwFfQx8T&_nc_oc=AdrZ_vx34eZh3-H-vCQty9dZ1hcvKPrjipfdNaNvQJpa_0JeR0vtGblJDuRBiJgQfPg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_npSJVNLOFKzQdcCYYl5g3mykLDQWcpP530rE-K8uUag&oe=6A26DFF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Just-One-Man-Store-FormatsCover-Image-(Trailer-Thumbnail).png", "id": "4480961592140390", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491829165_4480961595473723_2230291764345148973_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4brHrGW_icQ7kNvwH52nn-&_nc_oc=Adqn51L9i0_EeCzpSjScCGELCuwRjtqJOqKjUSyoTHeFGVd600ufbbBBYb9K8qLKZrc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fixhGELx_KRoDJIicRJB-ET5DUKQ-4g9tdCpa-Bf4Dg&oe=6A26ECC3"}, "display_name": "JUST ONE MAN - Demo", "keywords": ["combat", "fighting", "ninja", "sword", "arcade"], "long_description": "**JUST ONE MAN** is a hack-and-slash game where you are the OVERPOWERED VILLAIN. Stylishly slaughter enemies with a variety of weapons, combo attacks, and overpowered abilities while listening to aggressive beats. Invent your own playstyle and achieve highest scores by performing the wildest combos you can imagine.\n\n**THIS IS A DEMO VERSION.** For the full game, go check out: https://www.meta.com/experiences/just-one-man/8802299089893750/\n\n{1366993488509940}\n\n# SMOOTH AND SATISFYING MELEE COMBAT\nVisceral slices, impactful punches, lighting fast dashing. The fighting is designed only one goal in mind: it has to feel as satisfying as possible. Immerse into the flow of the combat and become the ultimate martial arts master.\n\n{1147178310667413}\n\n# EASY TO LEARN, HARD TO MASTER\nThe basics are simple, everyone can learn them in minutes. It is up to you, what kind of fighting style you want to come up with, but only the **COOLEST COMBOS** and **EDGIEST EXECUTIONS** get you that sought after SSS-rank.\n\n{939895022043332}\n\n# FEATURES  \n* **PUNCH, SLICE, PARRY, DODGE** and **DASH** your way through unrelenting waves of enemies\n* Use your **FISTS** to punch enemies into a pulp\n* Grab the **WEAPONS** from fallen enemies to vary your combat style\n* Unleash powerful **ABILITIES**, unique for each weapon\n* Scoring system that rewards **THE COOLEST COMBOS**\n* Traverse four **UNIQUE ENVIRONMENTS** to test your skills\n* An **ENDLESS MODE** for facing the ultimate challenge (and workout :D)\n* All the while listening to the **BANGING SOUNDTRACK**\n\n{1619995022464709}\n\nAre you ready to **BECOME THE VILLAIN?**", "short_description": "JUST ONE MAN is a hack-and-slash game where you are the OVERPOWERED VILLAIN. Stylishly slaughter enemies with weapons, combo attacks and devastating abilities while listening to banging beats. Choose your own playstyle and invent the wildest combos to achieve the highest scores imaginable. This is a DEMO version of the full game. If you like it, please go check out our full version."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raikirigames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Raikiri", "support_website_url": null, "website_url": "https://www.raikirigames.com/", "category": nu
427653_232449437227133_4644015173567250432_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhK6fdfWyusQ7kNvwH3_cXD&_nc_oc=Adqvusz_ch5snkSQf4JgNb_ka3wE6fKxbfpqoMGb2cckFxKNaF8zb4oISz5komz-rH8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLytrQMZKkuiplxNo4VBa7Qvbn2eZM8qPQT6mgAoEKog&oe=6A81B194"}, {"file_name": "migrated_image.png", "id": "305583337070236", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12482393_179330362566901_4903899727638036480_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hsrh5DK7lFUQ7kNvwH8NYLj&_nc_oc=AdpsHn6wlsW5T_5sQXaR12cMsljMzXAlJC03mkhFHpcVVzkF2EVVjodHBc5fodEuAWE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8Mjsnknd80Xi8J872AHwayvuImK7ywizfwGf4I6cfLA&oe=6A81A7C9"}, {"file_name": "migrated_image.png", "id": "1393309907538468", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12727931_1439031419453841_5702114627890970624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnymnhOiK7AQ7kNvwF_VdJ3&_nc_oc=AdruJHDR3-9RboxSah1MSGN65yt_6nVvewqG-h-jljCNaK_fhwesnzxQRO7M_0WDyhY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHW-0HYaUFN6W2n3pf7-z7449NwKscqCunCq8iNfzzgwg&oe=6A81AD4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calcflow", "keywords": ["Math", "Calculus", "Education", "Visualization", "Graph"], "long_description": "Everything starts with the math. Are you ready to see the third dimension of mathematics?  \n\nCalcflow features intuitive ways for you to understand and share with your friends the complexities of three dimensional mathematical functions.\n\nWhether you want to edit our example functions or input your own, immerse yourself in beautiful graphs!", "short_description": "Introducing Calcflow, the future of mathematical modeling. \n\n- Experience math like never before\n- Graph your own parameterized functions \n- Unlock your mathematical potential\n\nImmerse yourself in a fun and interactive way to visualize beauti
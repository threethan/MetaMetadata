alcflow", "keywords": ["Math", "Calculus", "Education", "Visualization", "Graph"], "long_description": "Everything starts with the math. Are you ready to see the third dimension of mathematics?  \n\nCalcflow features intuitive ways for you to understand and share with your friends the complexities of three dimensional mathematical functions.\n\nWhether you want to edit our example functions or input your own, immerse yourself in beautiful graphs!", "short_description": "Introducing Calcflow, the future of mathematical modeling. \n\n- Experience math like never before\n- Graph your own parameterized functions \n- Unlock your mathematical potential\n\nImmerse yourself in a fun and interactive way to visualize beautiful 3D graphs. Calcflow is great for visual learners to get a better understanding of complex parameterized functions.  "}]}, "developer_name": null, "developer_privacy_policy_url": "http://nanomeai.com/terms.html", "developer_terms_of_service_url": "http://nanomeai.com/terms.html", "publisher_name": "Nanome Inc", "support_website_url": null, "website_url": "http://nanome.ai/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3114480408798666"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12427653_264639650643827_1112360993104592896_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsu_crCY00EQ7kNvwGNkzKq&_nc_oc=AdnSVbRTvR01MclK8W7YSTGWO5s3MGPP_4NegPfjf_Q_YB7nDr6OEOGjyB71u
n.com&_nc_ss=7a30f&oh=00_AfzTs36cWQf-snMqHXSfozOvHHkqlj9s9n0hEpNBWbnwHw&oe=69C52149"}, {"file_name": "migrated_image.png", "id": "1556275231208442", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12727931_1439031419453841_5702114627890970624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPICCq_8-7cQ7kNvwHrst2u&_nc_oc=Adqpt_Q4CNJYLZOC52dsEPlhK22pLuGQrtVxeYppqZ8hgGJbqWxciti4Ip22we33Wq0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7-oWM17SugB4Z8pN3wX4lR807BNHySzSDtUaOGGck0A&oe=69C526CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calcflow", "keywords": ["Math", "Calculus", "Education", "Visualization", "Graph"], "long_description": "Everything starts with the math. Are you ready to see the third dimension of mathematics?  \n\nCalcflow features intuitive ways for you to understand and share with your friends the complexities of three dimensional mathematical functions.\n\nWhether you want to edit our example functions or input your own, immerse yourself in beautiful graphs!", "short_description": "Introducing Calcflow, the future of mathematical modeling. \n\n- Experience math like never before\n- Graph your own parameterized functions \n- Unlock your mathematical potential\n\nImmerse yourself in a fun and interactive way to visualize beautiful 3D graphs. Calcflow is great for visual learners to get a better understanding of complex parameterized functions.  "}]}, "developer_name": null, "developer_privacy_policy_url": "http://nanomeai.com/terms.html", "developer_terms_of_service_url": "http://nanomeai.com/terms.html", "publisher_name": "Nanome Inc", "support_website_url": null, "website_url": "http://nanome.ai/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "rec
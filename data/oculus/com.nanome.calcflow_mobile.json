n.com&_nc_ss=7a30f&oh=00_Af1ZEuTePlRScb6-Hf8iVoxrIbbNWocKTb7reRiuWJA_3g&oe=69D644C9"}, {"file_name": "migrated_image.png", "id": "1556275231208442", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12727931_1439031419453841_5702114627890970624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CY6wGXq6VXMQ7kNvwGAcTEQ&_nc_oc=Adqr9p5k6stTq9Khd7fclpzgZtyOiZm2Fa9JaEQV-r3FeZP_sQXBgtCSqQk9t-1xWhs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hPDndfPA7xiSmh1LjWRkE9EyDu1L5WZl8M3ubJU58wA&oe=69D64A4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calcflow", "keywords": ["Math", "Calculus", "Education", "Visualization", "Graph"], "long_description": "Everything starts with the math. Are you ready to see the third dimension of mathematics?  \n\nCalcflow features intuitive ways for you to understand and share with your friends the complexities of three dimensional mathematical functions.\n\nWhether you want to edit our example functions or input your own, immerse yourself in beautiful graphs!", "short_description": "Introducing Calcflow, the future of mathematical modeling. \n\n- Experience math like never before\n- Graph your own parameterized functions \n- Unlock your mathematical potential\n\nImmerse yourself in a fun and interactive way to visualize beautiful 3D graphs. Calcflow is great for visual learners to get a better understanding of complex parameterized functions.  "}]}, "developer_name": null, "developer_privacy_policy_url": "http://nanomeai.com/terms.html", "developer_terms_of_service_url": "http://nanomeai.com/terms.html", "publisher_name": "Nanome Inc", "support_website_url": null, "website_url": "http://nanome.ai/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "rec
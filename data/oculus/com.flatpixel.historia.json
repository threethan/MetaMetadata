c6-1.oculuscdn.com/v/t64.5771-25/38982638_592214013375522_4826992967751774341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9WyIZtiz20Q7kNvwHpVB21&_nc_oc=AdmW3h9xoh_Ae_DappMrsPmAt5087wwHjxWS7aFF1Y36wr4KIaS3OoXjPARdT6W76f0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afsd6a-mn_3iTEdd89j11bbh8t08LSGb3OEaTSPF3RSFbA&oe=69984AEB"}, {"file_name": "dolly.png", "id": "1910451259480923", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974757_1910451262814256_449261031949517295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtnbbuUKoWoQ7kNvwHalNeR&_nc_oc=Adl3d5cuPZc8xj37u_uyUXLmM509WoAKYbh6o0_YZSrLetIc7ZO8TfBTG1odDjhFdu4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfukWw14Whm-5CUYkFqgMsXqRhBZIJ3318_h0iVUhZboSg&oe=69985257"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Historia", "keywords": ["Educational", "Tabletop", "Cards", "mixedreality", "history"], "long_description": "ATTENTION: Historia is a **prototype** fully playable but still in development and in **early access**, with plenty of features and content yet to come. Please keep this in mind when reviewing, and feel free to share feedback at historia@flatpixel.fr.\n\nHistoria is an educational mixed reality tabletop game where players piece together historical events to discover and learn about the past. \n\nPlayers embark on a journey through time, placing event cards on a timeline chronologically. Each card acts as a magical window into the past, revealing captivating animated 3D scenes of historical events.  \n\nAs the player progresses through the game, they unlock new Time Packs to explore, providing them with opportunities to delve deeper into historical narratives and expand their understanding of the world. \n", "short_description": "Historia is an educational mixed reality tabletop game where players piece together historical events to discover and learn about the past. \n\nATTENTION: Historia is a prototype fully playable but still in development and in early access, with plenty of features and content yet to come. Please keep this in mind when reviewing, and feel free to share feedback at historia@flatpixel.fr.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://flatpixel.fr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Flat Pixel", "support_website_url": null, "website_url": "https://flatpixel.fr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27901393739451796"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "529818366564718"}]}, "baseline_offer": {"id": "529818366564718"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1731592200, "status": "PUBLISHED", "id": "529818366564718"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27859530320304805", "version": "0.2.2"}, "id": "1191446618723995", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26569314675993049", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27859530320304805"}, "release_status": "REL
ding them with opportunities to delve deeper into historical narratives and expand their understanding of the world. \n", "short_description": "Historia is an educational mixed reality tabletop game where players piece together historical events to discover and learn about the past. \n\nATTENTION: Historia is a prototype fully playable but still in development and in early access, with plenty of features and content yet to come. Please keep this in mind when reviewing, and feel free to share feedback at historia@flatpixel.fr.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://flatpixel.fr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Flat Pixel", "support_website_url": null, "website_url": "https://flatpixel.fr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27901393739451796"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "529818366564718"}]}, "baseline_offer": {"id": "529818366564718"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1731592200, "status": "PUBLISHED", "id": "529818366564718"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27859530320304805", "version": "0.2.2"}, "id": "1191446618723995", "chann
2095210894392717", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619751_2095210897726050_8750518535702010235_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Jix7hsubO4Q7kNvwFPGOAS&_nc_oc=Adr4bR-G-D9LdQHoLcvr26oeNzqXNSCA4G2MGKKO2bV4parl6X3_DRYf7tDiakCtS_w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnH5FWnTnuKUQ_Cn1YAI0RNqS4ZDjU8IFu8yzw-VxBHQ&oe=6A6B4EBC"}, {"file_name": "com.boxingdrills.vr-20260713-162406.png", "id": "2478518782658063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_2478518785991396_3146099330790565842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnudn89Fb6wQ7kNvwF-LVGc&_nc_oc=Adpr0PRzHtqyo4qp8Ie3cssh4_9USqoKfG-Rx1NJycMkTBRhAY_T0sBPwVigVewODtM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAn7vKov4lXbS0hKdbZLWzmXfQH5KDXZjuHIFRjMrOSlQ&oe=6A6B57A1"}, {"file_name": "com.boxingdrills.vr-20260713-162231.png", "id": "1343092313992102", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619685_1343092317325435_1884872166106631142_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNXEBdXnJJgQ7kNvwHLQkVf&_nc_oc=AdpGuwgz5JDOzERxhoeVn8jNEIyJe_eaMADqVhWkwTxD1Okv8oRn78V-iax-JIwWZxE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvezhjYfHBvEhUi3a6H_TdSLv0_Dsp3nQEYL72c_YmHw&oe=6A6B62E0"}, {"file_name": "com.boxingdrills.vr-20260713-162514.png", "id": "2158397548419140", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622276_2158397551752473_2495375832712571267_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKveV1G78X0Q7kNvwEKAFUz&_nc_oc=AdqiYdZX_Ba4eQjXacR1ES4vyuasqD015zaWXqCBoHQ77B3BwKoJZb0KphC22pC_abo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQDHxLK7Xs6RauCVwF4h4yZgDC_tdo2KQ9fo5AkTv-GQ&oe=6A6B3AC1"}, {"file_name": "com.boxingdrills.vr-20260713-162349.png", "id": "2017595326295931", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623400_2017595332962597_1218088256288490559_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAPV8uqDGaoQ7kNvwFEet-j&_nc_oc=AdrkKlznWhz3McCVufpL268bcIx88lGC0SfiqKEQwdGuQc3ijnqZSZ5R8v_YNoUC1qg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCs9DW3KH3sHpSfojrodc8Dz7gsQggqHZcYYLbmc-vOZA&oe=6A6B35F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qs677UY_WvgQ7kNvwG5w646&_nc_oc=AdqmAYK7KJHzjBGG4uPqAp4Rh-zLtgeTYLlyHcGKCgcVG8J_-ogk3F5TW-JxwHwIgZ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoUiG_CGneNsUhVgl7CSGn1xXatoYaLhpo1fFrABOJRw&oe=6A6B5BD6"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "training", "fitness", "cardio", "workout"], "long_description": "Real boxing fitness requires proper mechanics. Boxing Drills VR focuses entirely on practical padwork and mittwork. Your virtual coach calls the combinations. You move, punch, and slip just like in a real gym. \n\nWe built this to help you practice footwork, guard discipline, and hip rotation. If you punch too softly, it does not register. If you drop your guard, you lose points. Stand flat-footed, and the trainer steps out of range.\n\n**Train with real standards**\n* Practice combos, defense, and footwork drills. \n* The pad trainer moves, forcing you to reposition.\n* A velocity threshold makes you commit to your shots.\n* Scoring tracks your core rotation, not just quick hands.\n* Real-time feedback on punch speed, power, and form.\n* Play in orthodox or southpaw stance.\n\n\n**Track your progress**\n\nThe app scores your power, speed, agility, and form to show how your mechanics improve. \n\nWhether you use this to warm up for a sparring simulator or as your main cardio routine, the pads are ready when you are. \n\nJoin the Discord at https://discord.gg/8FyagxceKs to help shape what comes next.\n\n**Clear some space, put the headset on, and try your first drill today.**", "short_description": "VR boxing fitness focused on real mittwork and padwork. You throw combinations, slip punches, and use actual footwork while a virtual trainer holds the pads. Your punches only count if you use proper form and power. With an ever-growing number of drills, you can also chain them together for an intensive workout or build your skills in career mode. There is boxing equipment too, like at the gym.  No subscription required. Put the headset on and start training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wobble-bot-games.gitlab.io/boxing-drills/privacy.html", "developer_terms_of_service_url": "https://wobble-bot-games.gitlab.io/boxing-drill/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": "https://discord.gg/7vbXrqzg", "website_url": "https://wobble-bot-games.gitlab.io/boxing-drills/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27774397232196171"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617850_908382378478110_1679491847877253535_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvw5bFjfRI4Q7kNvwHviSNz&_nc_oc=AdoFJsU7ynDvHgpv7-wO3i-dP4N9o4TpJwbz5Ylsth16abNoaEN
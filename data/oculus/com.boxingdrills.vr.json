44881073644028", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619704_1244881076977361_5615678092938328795_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUQsRHDNxVoQ7kNvwGyofW5&_nc_oc=AdpRXEoykH17tXJ4kBTxRmMZrSdQbbfYcPSZcsNrZ8qf7Mcop-bHb1RCxrqrlsUmxMI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWg9yBR0nHbdPpQqefX0TNYkOcxXx7BPidzfO8uSlO3A&oe=6A60BABA"}, {"file_name": "com.boxingdrills.vr-20260222-171803.png", "id": "878545175052858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618102_878545181719524_1967766508375899942_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVWhGSIk8r8Q7kNvwF-c3V1&_nc_oc=AdqNdkMJlAad1ejBwEI_0AamcCVPJnDb1rDl9lRRCsf32v9QCcRx3Uk8GlBt9ojXAnM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlmT-dV1tzH-wwScB8pQtaFkXB-mkZf1_VFhyDD5U-JQ&oe=6A60D05D"}, {"file_name": "com.boxingdrills.vr-20260222-171753.png", "id": "2355644911606270", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_2355644914939603_7881252502421777745_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kR59cR4Fr2QQ7kNvwGVKWC4&_nc_oc=Adr4F7_fwjt_D5J9adG4cc3qRPGgCTIEuNw84Tp3-QNUf05fmTe0d_B8fv4JeHtHT_g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvfW5f2TuHypmPltJmJCT_ArwuM8RSFZ6npAnWTYyCpQ&oe=6A60A6D2"}, {"file_name": "com.boxingdrills.vr-20260222-171744.png", "id": "1574678113766454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308961_1574678117099787_7551936325078272668_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59eO2acCyREQ7kNvwEa1oHC&_nc_oc=AdqRZcpfbiKx1pECrAepvdB6VTagUoE3-vbWv1Vp7YdKr58UWX5hxAeLmu15g-gbT14&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBL3p2EiHpvu3psvh-Nxk8mTuFWmMjmf99RZfBmGX_jbw&oe=6A60B9E9"}, {"file_name": "com.boxingdrills.vr-20260222-171747.png", "id": "936482305505709", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619808_936482308839042_2870889141134525125_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kOFN7RFIMwQ7kNvwFcx3Am&_nc_oc=Adrh1w1x9HoBFWrC4hgMwJf8oRywIQzh1pbK42cIv5u1pmLg7ZP3Ua9EOah5pVSIDJk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1oxlX2VA_byF1GMHvb4Et2YcgLpK5xj8t58TKT7MDkg&oe=6A60CA1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8-R1fpgBMsQ7kNvwGq_NLh&_nc_oc=AdrZqztOwiXEBhxpI19ShUgdjITT7VxNAHFaUZxlfRLUGvcSKq_Zr6sZl74PuZr_05g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8roI8pqVBw3LZDW9ahNml6_fkIqcZlxey2CCFgczNRA&oe=6A60CFD6"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "padwork", "trainer", "drills", "speed"], "long_description": "# Train Like a Real Boxer\n\nBoxing Drills VR brings authentic pad training to your Quest. No gym required.\n\n**Realistic Drills**\n\nFollow a virtual trainer through classic boxing combinations:\n- **1-2 (Jab-Cross)** - The fundamental combo\n- **1-2-Duck** - Add defensive movement\n- **1-2-3** - Jab, Cross, Hook\n- **1-2-3-2** - Extended combinations\n- **Uppercut combos** - Work those body shots\n- **Growing Library** - A vast selection of drills with new content added regularly!\n\n**Built for Performance**\n\nWe know every millisecond counts when you're in the pocket.\n- Low-Latency Precision: Built from the ground up for high-performance tracking.\n- Native Feel: Optimized to ensure smooth, responsive feedback that feels like hitting real pads.\n\n**Get Scored**\n\nEvery session tracks your performance:\n- **Power** - Hit those pads hard\n- **Speed** - Quick reactions matter\n- **Agility** - Duck and weave like a pro\n- **Form** - Return to guard after every punch\n\n**Train Your Way**\n- Multiple drill durations (30s to 3 min)\n- Choose the speed that suits you (slow, medium, fast, progressive, variable)\n- Passthrough mode - train safely in your own space\n\n**Perfect For**\n- Beginners learning boxing basics\n- Fitness enthusiasts wanting a fun workout\n- Experienced boxers staying sharp\n\nNo experience needed. Just clear some space, put on your Quest, and start throwing punches.\n\n**Shape the Future (Open Source)**\n\nWe believe the best training tools are built by the community. We are moving toward an open-source model so the community can help us shape the roadmap of the product.", "short_description": "Train like a boxer in VR. Follow realistic pad drills with jabs, crosses, hooks, and uppercuts. Practice defense with duck-and-weave combos. Track your power, speed, and form after every session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-drills-ec8acc.gitlab.io/privacy.html", "developer_terms_of_service_url": "https://boxing-drills-ec8acc.gitlab.io/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": null, "website_url": "https://boxing-drills-ec8acc.gitlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26010917265210852"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1005552205303411"}, {"status": "PUBLISHED", "id": "1657151418799256"}, {"status": "PUBLISHED", "id": "899033179613105"}, {"status": "PUBLISHED", "id": "4443476652641359"}]}, "baseline_offer": {"id": "899033179613105"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1005552205303411"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27847220374913856", "version": "0.33.0"}, "id": "790503750728261", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27847220374913856"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.33.0\n\n**Speed bag**\n- New under Equipment: a speed bag on a rebound platform. Hit it from any angle, walk around it, and chase the classic rhythm: punch, three bounces, punch. The HUD tracks your hits per minute and your rhythm streak.\n- Its height is adjustable in Settings, next to the other bags.\n\n**Duck & Rip**\n- New defense drill: duck, rip the left uppercut, duck, rip the right. The pad slides into place while you're still under the bar, so you come up punching in one motion. Uppercuts start in the legs, and this drill makes sure yours do.\n\n**Workout plans**\n- The Workout tab now shows the full drill lineup before you start, with a randomize button to re-roll it. What you see is what plays, in order.\n- Drill types for workouts now use the same tags as the Train tab. This also fixes peekaboo and equipment drills never appearing in workouts.\n- The thumbstick scrolls the Workout tab.\n\n**Tips**\n- The countdown before each drill now shows a quick tip. Boxing technique, app features you might have missed, safety. There are over 60, and you'll see each one before any repeats.\n\n**Tuning and fixes**\n- Fixed a framerate drop on the ROLL drills that could stick around for the rest of the session. Quest 2 players should feel this one the most.\n- The NEXT move line on the drill HUD is bigger and brighter.\n- Head movement sensitivity now defaults to Normal. Relaxed barely ever fired.", "created_date": 1784263599, "id": "27847220374913856", "version": "0.33.0", "version_code": 16779167, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27847220374913856"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.32.1\n\n**Weak punches keep the drill moving**\n- If a punch lands too soft, the drill now moves on instead of leaving the mitt stuck waiting for a harder one. You hear a miss sound, TOO WEAK pops at the mitt, and the next move comes. The soft rep still drags your score, so there's no sneaking through.\n- Prefer the old strict pads? Turn on \"Weak Punches Block\" in Settings and the mitt waits for a clean hit again.\n\n**Pass or fail**\n- Drills now grade you at the end. Land 80% of what the drill asks for (clean punches, dodges, blocks) and you pass. Soft punches, dodges that catch you and pads you let time out all count against you.\n\n**A clearer results screen**\n- Session stats now sit in one aligned list: combos, mistakes, weak punches, blocks, punch power and body engagement. Blocked no longer floats alone above the rest.\n- \"Missed\" is now \"Mistakes\", since it counts everything that went wrong, from dodges that caught you to pads that timed out.\n\n**Bug fixes**\n- Body engagement showed 0% on drills with only straight punches. Straights don't expect body rotation, so the stat now stays hidden on those drills.", "created_date": 1784163375, "id": "27834237702878790", "version": "0.32.1", "version_code": 16779164, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27847220374913856"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.32.0\n\n**Instant feedback on every punch and dodge**\n- Every punch now pops a quick verdict right at the mitt: PERFECT!, GREAT!, GOOD or OK, plus TOO WEAK and WRONG PUNCH when something's off. No more checking the scoreboard mid-combo.\n- Dodges get a verdict too: GOOD when you clear a duck, slip, weave or pull, TOO SLOW when it catches you, BLOCKED when your guard takes it.\n- Both can be turned off in Settings under Display & Scoring.\n\n**See what's coming**\n- The drill HUD now shows the next punch or dodge one step ahead, so a duck never ambushes you mid-combo. Toggle in Settings.\n\n**Smoother framerate**\n- Fixed heavy framerate dips when an incoming glove flew through your face.\n- The resting pad at the trainer no longer flashes or shatters when you clip it by accident.\n\n**FPS display**\n- New Settings option pins a small live framerate readout to the corner of your view. Off by default.\n\n**Tutorial**\n- Defense practice now reacts to every attempt, including the ones that catch you. Pull-back practice scores every rep instead of only the first.\n- The setup step's options are properly centered.", "created_date": 1784107867, "id": "27826681376967756", "version": "0.32.0", "version_code": 16779162, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27847220374913856"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.31.2\n\n**Quest 2 framerate protection**\n- 90 Hz now only turns on for Quest 3, Quest 3S and Quest Pro. Quest 2 always runs at 72 Hz, where it holds a steady framerate. Previously a Quest 2 could end up at 90 Hz and drop to a choppy 45.\n- The Refresh Rate setting is now Auto or 72 Hz. Auto picks the right rate for your headset. Choosing 72 Hz on a Quest 3 or Pro saves battery on long sessions.", "created_date": 1784022333, "id": "27816364994666061", "version": "0.31.2", "version_code": 16779160, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27847220374913856"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.31.1\n\n**Bag heights**\n- The heavy bag hangs higher.\n- Settings has two new controls to raise or lower the heavy bag and the double-end bag, up to 50cm each way in 5cm steps.\n\n**Bug fixes**\n- Punches at the lower half of the double-end bag now connect. The hit zone sat higher than the ball itself.\n- The score bars on the drill complete screen were stuck in the top left corner since v0.30.0. They're centered again.", "created_date": 1783909160, "id": "27802769316025629", "version": "0.31.1", "version_code": 16779158, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
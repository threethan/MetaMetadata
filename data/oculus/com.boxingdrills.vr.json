96-QACLsUd1d0V6CLkA7NoUWOjAqyXJn8PZpxojap54OGtqglTT0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9UH7NmffF0776-B9OSUSt9baglVgnkXYKyKBIqttDSg&oe=6A54D198"}]}, "id": "2713860495679965", "locale": "en_US", "screenshots": [{"file_name": "com.boxingdrills.vr-20260222-171729.png", "id": "1244881073644028", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619704_1244881076977361_5615678092938328795_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bln_2-z7_AAQ7kNvwG8CtIl&_nc_oc=AdqzRDzwbhXNYrMjpWimMY-x8OIw2yIsM68CY-p0gLNctaprtm_4Kf7uGUtGE2T0duY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdhMimpmV_qEjvYUZcHKAYhWelFNO9oTVZIuw6U8uTVw&oe=6A54DD3A"}, {"file_name": "com.boxingdrills.vr-20260222-171803.png", "id": "878545175052858", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618102_878545181719524_1967766508375899942_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajfuR9Mp8gQQ7kNvwFQzV5P&_nc_oc=Adqcdgf1t8rGNFA47Ge-qflGmPX9nF_e15Gv5s_eAbKB-lmueJZ3H5pUN70psGmKg1k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChU_knlzY9vzHZFnILglk1j3wnP6zVkEEaFfaQk6rarQ&oe=6A54F2DD"}, {"file_name": "com.boxingdrills.vr-20260222-171753.png", "id": "2355644911606270", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619096_2355644914939603_7881252502421777745_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uh3_zP4pTYoQ7kNvwHE0qhi&_nc_oc=AdqNERVljgl3Nwcig_dflZio_xn8uhQlHMipDddOPJp1ciy9bLmduam0DfY0IW5e8vo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuUARU0TDYfTOCKWcuR3D-W84DWrgJfM44YFpbSBOtpg&oe=6A550192"}, {"file_name": "com.boxingdrills.vr-20260222-171744.png", "id": "1574678113766454", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308961_1574678117099787_7551936325078272668_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dynjppgwATkQ7kNvwHJ3L_T&_nc_oc=AdrSwfL1w2blxu3VddwoyWRXU-_lQhvWmAV9adyzg7vEuGxiFN_BpWY9p9n0wRUk_3k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoxD_H8QDyfTtJM4mR8p_GXksao9ZN1WtZKt09Abj0EQ&oe=6A54DC69"}, {"file_name": "com.boxingdrills.vr-20260222-171747.png", "id": "936482305505709", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619808_936482308839042_2870889141134525125_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBFW0aZvcVQQ7kNvwETcLER&_nc_oc=AdpPzMjB-Eok4BxGjeGYKRIPzwQiO_ZfZv2mXzVREXBQKfzqUmDFTCkn4sRg6Ovnw4o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDD6bVrih3HWT21fCjRZ5n8R8fgJLsUbPRGjww-Z9MriA&oe=6A54EC9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4Tl8KLvVlkQ7kNvwFvjWPN&_nc_oc=AdqDDBWbLfuXgaJXsVbVtmpgPmSZsyS46j7Wc8wJg75mB3ZoTVpifkObhaCrZDEFBBA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDa-T4c_qQG9ogD8lWoTvzTq7z6t5tz9krQw0f4DiluZA&oe=6A54F256"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "padwork", "trainer", "drills", "speed"], "long_description": "# Train Like a Real Boxer\n\nBoxing Drills VR brings authentic pad training to your Quest. No gym required.\n\n**Realistic Drills**\n\nFollow a virtual trainer through classic boxing combinations:\n- **1-2 (Jab-Cross)** - The fundamental combo\n- **1-2-Duck** - Add defensive movement\n- **1-2-3** - Jab, Cross, Hook\n- **1-2-3-2** - Extended combinations\n- **Uppercut combos** - Work those body shots\n- **Growing Library** - A vast selection of drills with new content added regularly!\n\n**Built for Performance**\n\nWe know every millisecond counts when you're in the pocket.\n- Low-Latency Precision: Built from the ground up for high-performance tracking.\n- Native Feel: Optimized to ensure smooth, responsive feedback that feels like hitting real pads.\n\n**Get Scored**\n\nEvery session tracks your performance:\n- **Power** - Hit those pads hard\n- **Speed** - Quick reactions matter\n- **Agility** - Duck and weave like a pro\n- **Form** - Return to guard after every punch\n\n**Train Your Way**\n- Multiple drill durations (30s to 3 min)\n- Choose the speed that suits you (slow, medium, fast, progressive, variable)\n- Passthrough mode - train safely in your own space\n\n**Perfect For**\n- Beginners learning boxing basics\n- Fitness enthusiasts wanting a fun workout\n- Experienced boxers staying sharp\n\nNo experience needed. Just clear some space, put on your Quest, and start throwing punches.\n\n**Shape the Future (Open Source)**\n\nWe believe the best training tools are built by the community. We are moving toward an open-source model so the community can help us shape the roadmap of the product.", "short_description": "Train like a boxer in VR. Follow realistic pad drills with jabs, crosses, hooks, and uppercuts. Practice defense with duck-and-weave combos. Track your power, speed, and form after every session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-drills-ec8acc.gitlab.io/privacy.html", "developer_terms_of_service_url": "https://boxing-drills-ec8acc.gitlab.io/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": null, "website_url": "https://boxing-drills-ec8acc.gitlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26010917265210852"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1005552205303411"}, {"status": "PUBLISHED", "id": "1657151418799256"}, {"status": "PUBLISHED", "id": "899033179613105"}, {"status": "PUBLISHED", "id": "4443476652641359"}]}, "baseline_offer": {"id": "899033179613105"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1005552205303411"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27760714433564451", "version": "0.26.2"}, "id": "790503750728261", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27760714433564451"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.26.2\n\n**Performance: the gloves were being drawn double**\n- Ever since the 3D gloves arrived, the right glove has been a mirrored copy of the left, and the trick used to mirror it forced the game to draw both sides of every surface on both gloves, every frame. Your gloves are on screen more than anything else in the game, so that added up.\n- They now render as normal solid objects. This one is aimed squarely at Quest 2 framerate; the gloves themselves should look exactly the same as before.\n- If your right glove looks odd in any way after this update, that's a bug I'd like to hear about.", "created_date": 1783549597, "id": "27760714433564451", "version": "0.26.2", "version_code": 16779148, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27760714433564451"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1783498709, "id": "27754291270873434", "version": "0.26.1", "version_code": 16779145, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27760714433564451"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.26.1\n\n**Fixed: crashing on launch**\n- The game could crash the first time you opened it, then work fine when you went back in. The cause turned out to be leftover debugging code from months ago that was shipping in every build and closing system resources it shouldn't touch. It's gone now.\n- That same code is the leading suspect for the random crashes some Quest 2 players have hit for a long time. No promises until the crash reports come in, but if the game has been dying on you mid-session, this update is the most likely fix yet.\n\n**Workout mode cleanup**\n- The workout Speed setting only ever worked in Custom league. In ranked play your League controls the pace, so the setting sat there doing nothing. The workout panel now shows your league's actual values as locked settings, and changing your league is how you change difficulty. Custom league keeps the free Speed choice and footwork toggles.\n- Fixed: in ranked leagues every workout segment was capped at 30 seconds without telling you, and timed rounds ended at 0:30 instead of running the full round. Rounds now go the distance.\n- The \"Max Drill\" setting is gone. Segment lengths follow your drill length automatically: 30 to 60 seconds in the ranked leagues, longer if you run longer drills in Custom.\n\n", "created_date": 1783483081, "id": "27752553861047175", "version": "0.26.1", "version_code": 16779144, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27760714433564451"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.26.0\n\n**Performance, mostly for Quest 2**\n- Fixed the stutters when targets explode and new objects appear. The game was building graphics resources at the exact moment your punch landed, which is why the hitch always seemed to eat your best shot. All of that gets prepared once at startup now.\n- Workouts got the biggest win here. Switching drills used to rebuild everything from scratch; now the pieces are reused, so segment changes are smoother.\n- It turns out the game was drawing the entire scene a third time every frame, just to display the menus, and had been since day one. Fixed. Quest 2 should hold its framerate much better everywhere.\n- The very first explosion or slip arrow of a session had its own one-off hitch. That work happens quietly at startup instead.\n- The reactor orb carried far heavier textures than it needed. It looks the same and the download is about 4 MB smaller.\n\n**Slip cue: the incoming glove is now the default**\n- Slips are cued by a red glove coming at your face, with a small arrow underneath showing which way to move. You dodge a punch instead of reading a symbol.\n- If you liked the plain arrow, Settings \u2192 Slip Cue brings it back. Weaves keep their blue arrow in both modes.\n\n**Launch fix**\n- Startup work is spread out over the first few seconds, so the game can't lock up right after you put it on.\n", "created_date": 1783471336, "id": "27751217764514118", "version": "0.26.0", "version_code": 16779142, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27760714433564451"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.25.0\n\n**New: SPEED ORB & COMBO ORB**\n- A floating reactor orb you punch to charge up. Fast, committed shots build heat \u2014 charge it to critical and it blows apart in a shower of debris. Stop punching and it cools back down, so keep those hands going.\n- **SPEED ORB**: any solid punch charges it \u2014 pure sustained hand speed.\n- **COMBO ORB**: charge it with combos in order \u2014 1-2, then 5-6, then 3-4 \u2014 with a floating number showing your next punch.\n- Difficulty scales with your League: Beginner is a short burst, Pro is a real grind.\n\n**New: REACTIVE DEFENSE**\n- Pure reaction training: an attack comes from one of four directions \u2014 slip left, slip right, duck, or pull back. Evade it, then rip the counter pad that lights up.\n- Beginner league gets a predictable counter so you can groove the rhythm; higher leagues randomize it to force real reading.\n\n**New: SLIP ROPE SHADOWBOX**\n- A no-pressure sandbox: a full rope cross hangs at head height while balloons drift down around it. Slip, duck, and weave around the ropes and pop whichever balloons you like \u2014 they burst into pieces with a satisfying pop.\n- No score, no timer, no fail \u2014 just shadowbox and play. Your balloon count shows on the HUD, and the menu button exits whenever you're done.\n\n**Punches register better \u2014 all drills**\n- Fast punches are now scored at their true peak speed. Previously a quick flurry could read slower than it really was and some hits wouldn't register \u2014 most noticeable on the orb drills, fixed everywhere.\n\n**Bug Fixes**\n- Slip rope: touching the rope repeatedly in quick succession now buzzes every time, not just once a second.\n- The speed orb's detonation now plays out on screen so you actually see it explode before the drill ends.\n", "created_date": 1783322290, "id": "27731926736443221", "version": "0.25.0", "version_code": 16779139, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
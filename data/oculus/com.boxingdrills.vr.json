culuscdn.com&_nc_ss=7f20f&oh=00_AQT4hopux2BKeCQ5VoiL8es2H9aJJmjiuPo95lG9MD510Q&oe=6AFB35B7"}, {"file_name": "cover_hero.png", "id": "925721709916061", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819324_925721713249394_2252932449268954893_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mNzM8or7O0Q7kNvwGWwKhc&_nc_oc=AdrADHMGkz9SH2zfMSZBttuwoRW4xQCDp2iPCN0Mb2T2HvxmEHOa9er_u7O8nPcZ3M0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTfqjhZb-ldUlbqb_WaP8ZgROgasOwBT6652wIMsanNQ&oe=6AFB26D8"}]}, "id": "2713860495679965", "locale": "en_US", "screenshots": [{"file_name": "com.boxingdrills.vr-20260222-171729.png", "id": "1244881073644028", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619704_1244881076977361_5615678092938328795_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRNRLXRubeEQ7kNvwG_oy32&_nc_oc=AdqTlFSxJT-lz90pviix7Oox011Y_y-j2x3K3PBbCswjWGN4P16RVAzHII5E8CFzXq4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSioCQjP29Lnb9fY_yzGYqfvqpc-MtWlpppzhdsGs3ag&oe=6AFB327A"}, {"file_name": "com.boxingdrills.vr-20260222-171803.png", "id": "878545175052858", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618102_878545181719524_1967766508375899942_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSZ3N2xRhxgQ7kNvwE0LVQU&_nc_oc=Ado5g-h4g9jz0KjhFRufP61hsSkgw6EmAzutphH2TjVRKFTVpewFzpOYXIB-RvYl7Pw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRatam8UfJJ-k9T8sAPUFsQ49ehlBKtUOOVRjtdULTt6g&oe=6AFB481D"}, {"file_name": "com.boxingdrills.vr-20260222-171753.png", "id": "2355644911606270", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619096_2355644914939603_7881252502421777745_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpX6_JvIctkQ7kNvwFY-_In&_nc_oc=Adp6enp-uIyuN5vJLi7uYC0fuksBYhzzHfQYSo93qvzMva5gDt_AtzezWsfkrtQCHoo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnLyE441B96qRTBfgz3_tV1Rx4VYTzelZQ-1hpx8oTxw&oe=6AFB1E92"}, {"file_name": "com.boxingdrills.vr-20260222-171744.png", "id": "1574678113766454", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308961_1574678117099787_7551936325078272668_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J17QWjTHgpgQ7kNvwGJj9Tm&_nc_oc=Adql3TpXm4z_LS2YRDCpLoDbx_ShkmOidoJZtfTefSvG02MOEDc_rm5gQ9WCShDsHdk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGsYzj2sIt6RNm7aYvg0YvcZmqLRQfGJqy0CLISgoAIw&oe=6AFB31A9"}, {"file_name": "com.boxingdrills.vr-20260222-171747.png", "id": "936482305505709", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619808_936482308839042_2870889141134525125_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0aKZNbb6vwQ7kNvwGPvmIc&_nc_oc=AdrHe-ocFvxJP5dpsbG3gT-JbDkV-aZj2Nm-prFOL_b2x5TFhBQuzgP24pUrcMzUbo8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYZ5YfTA8nbN-avLuduuowg2SeolPgxOUEslqntocv-Q&oe=6AFB41DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQtJVb1LFLQQ7kNvwFBoUqV&_nc_oc=AdpkZn8PJ83ecoF-AKr72wDTQ6u-sSTTERivXG9kbeQ1sVHUVsuGEm00IfyumeuGlBA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6_1JSP9B6OwFBqP3tmN7tyrvJBRJx2t0IvV75GYrBIw&oe=6AFB4796"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "padwork", "trainer", "drills", "speed"], "long_description": "# Train Like a Real Boxer\n\nBoxing Drills VR brings authentic pad training to your Quest. No gym required.\n\n**Realistic Drills**\n\nFollow a virtual trainer through classic boxing combinations:\n- **1-2 (Jab-Cross)** - The fundamental combo\n- **1-2-Duck** - Add defensive movement\n- **1-2-3** - Jab, Cross, Hook\n- **1-2-3-2** - Extended combinations\n- **Uppercut combos** - Work those body shots\n- **Growing Library** - A vast selection of drills with new content added regularly!\n\n**Built for Performance**\n\nWe know every millisecond counts when you're in the pocket.\n- Low-Latency Precision: Built from the ground up for high-performance tracking.\n- Native Feel: Optimized to ensure smooth, responsive feedback that feels like hitting real pads.\n\n**Get Scored**\n\nEvery session tracks your performance:\n- **Power** - Hit those pads hard\n- **Speed** - Quick reactions matter\n- **Agility** - Duck and weave like a pro\n- **Form** - Return to guard after every punch\n\n**Train Your Way**\n- Multiple drill durations (30s to 3 min)\n- Choose the speed that suits you (slow, medium, fast, progressive, variable)\n- Passthrough mode - train safely in your own space\n\n**Perfect For**\n- Beginners learning boxing basics\n- Fitness enthusiasts wanting a fun workout\n- Experienced boxers staying sharp\n\nNo experience needed. Just clear some space, put on your Quest, and start throwing punches.\n\n**Shape the Future (Open Source)**\n\nWe believe the best training tools are built by the community. We are moving toward an open-source model so the community can help us shape the roadmap of the product.", "short_description": "Train like a boxer in VR. Follow realistic pad drills with jabs, crosses, hooks, and uppercuts. Practice defense with duck-and-weave combos. Track your power, speed, and form after every session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-drills-ec8acc.gitlab.io/privacy.html", "developer_terms_of_service_url": "https://boxing-drills-ec8acc.gitlab.io/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": null, "website_url": "https://boxing-drills-ec8acc.gitlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26010917265210852"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1808138950337735"}, {"status": "PUBLISHED", "id": "1744772810063418"}, {"status": "PUBLISHED", "id": "1013623321669324"}, {"status": "PUBLISHED", "id": "1005552205303411"}, {"status": "PUBLISHED", "id": "1657151418799256"}, {"status": "PUBLISHED", "id": "899033179613105"}, {"status": "PUBLISHED", "id": "4443476652641359"}]}, "baseline_offer": {"id": "899033179613105"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1808138950337735"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29375460808756464", "version": "0.40.1"}, "id": "790503750728261", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29375460808756464"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.40.1\n\n**The Boxing Drills gym**\n- With mixed reality off, you now train in a boxing gym. There's a full ring with leather ropes, heavy bags, speed bags and a double-end bag, fight posters on the walls, a wall of fame, and windows looking out on the street.\n- A round clock on the wall counts down your drill. It shows green while you work, amber for the last ten seconds and red while you rest.\n- When a drill starts, the house lights go down and the ring stays lit. They come back up when you're in the menus.\n- A cat wanders around the gym. It stays out of the ring.\n- The gym is now the default virtual scene. Settings > Scene picks Gym, Lakeside or Off, and replaces the old Lakeside Scene switch.\n\n**Starting in the gym**\n- After this update everyone starts in the gym once, so you can see it. A card in the menu lets you switch straight back to mixed reality if you'd rather train in your own room.\n- New players start in the gym, and the last step of the tutorial asks where you want to train.\n\n**Defense cues**\n- Threat Wind-up is now off by default. If you want every threat to pause before it flies, turn it back on in Settings > Threat Wind-up.\n", "created_date": 1794384113, "id": "29375460808756464", "version": "0.40.1", "version_code": 16779252, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29375460808756464"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.40.0\n\n**A new renderer, built for Quest**\n- I rewrote the code that draws the game on Quest from scratch. The frame rate is noticeably smoother, the lighting is better, and edges are cleaner because every frame now gets anti-aliasing.\n- Each frame takes less work than it used to, so the headset runs cooler and the battery lasts longer.\n- It's also the groundwork for better 3D models and scenes in future updates.\n\n**Lakeside scene**\n- Turn mixed reality off and you now train on a wooden deck by a lake at dawn, with sky, distance fog and moving water, instead of a plain dark room.\n- It's on by default in virtual mode on every Quest. Mixed reality is still the default view, and you can switch the lake off in Settings > Lakeside Scene.\n\n**Defense cues**\n- Every incoming threat now holds still for a beat, with a double-tap sound, before it flies, so you have time to read it. If you'd rather only the first of each kind paused, turn off Settings > Threat Wind-up.\n- Slip and weave cues now move like a real punch: they cock back, tremble, then snap in. The slip glove is closer to real glove size too.\n- Back-to-back ducks now show one bar that swings across and comes back. Before, the second bar could appear while the first was still swinging.\n\n**Coach**\n- The coach steps in when the pads are held out at punching range, so its arms no longer stretch in the 4-AXIS drills.\n- It now turns its shoulder behind whichever pad it offers.\n\n**Drone Orbs**\n- New option for SPEED ORB and COMBO ORB: land a punch and the orb darts to a new spot, like a fighter drone. Off by default; turn it on in Settings > Drone Orbs.\n\n**Quit button**\n- The main menu has a close button (X) in the top-right corner. It asks before quitting.\n\n**Bug fixes**\n- Quitting from the Meta menu and launching again no longer gets stuck on the loading dots.", "created_date": 1794279651, "id": "29357895370513008", "version": "0.40.0", "version_code": 16779250, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29375460808756464"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.38.7\n\n**The pad holder is now visible**\n- A see-through coach stands behind the mitts: head at your eye level, shoulders, body, and two arms that reach to the pads. You can read where the trainer is, how far away, and which way they face without looking down at the floor ring.\n- In footwork drills the coach slides to the next spot together with the floor ring, just before the pads move. In pivot and angle drills the coach turns with the pads.\n- Threats still come from the same place they always did, so the duck bar, slip gloves and pull wall now visibly start at the coach.\n- Bag drills, BOUNCE, SLIP ROPE SHADOWBOX and LASER TAG have no pad holder, so nothing changes there.\n- Turn it off in Settings if you preferred pads only (Settings \u2192 Coach).\n", "created_date": 1794099875, "id": "29329807243321821", "version": "0.38.7", "version_code": 16779249, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29375460808756464"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.38.6\n\n**New Defense drills: the pull counters**\n- PULL & UPPERCUT: pull straight back to make the punch miss by inches, then drive the rear uppercut into the chin as it leans in after the miss. The pull loads the shot.\n- BODY PULL: the first drill where the attack comes at your midsection. Pull your hips and weight back so the dig falls short, then answer with the uppercut and a lead hook before they stand back up. Body shots can't be caught on your gloves here, so the pull is the only way out.\n\n**LASER TAG**\n- The attack warning now glows around the whole orb instead of hiding inside the shell, so the colours are readable at a glance: red for the slip bolt, gold for the 1-2, orange for the duck beam. A clean tag pops the glow white.\n- New green attack: a laser dug at your body. Slipping won't save you. Drop an elbow and take it on the forearm. The orb goes to the body more when your hands sit tight at your chin.\n", "created_date": 1790835865, "id": "28805541715748379", "version": "0.38.6", "version_code": 16779248, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29375460808756464"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.38.5\n\n**New drill: LASER TAG**\n- A duel with a live training orb. It darts around your space between waist and head height and flees every clean tag. Catch it with your feet, not by leaning.\n- The whole time, it shoots back. Its core flares a colour before every shot: red is a little bolt you slip, gold is a straight 1-2 you block or slip, orange is a wide beam you duck under. Tag it while the flare is running and you break the shot.\n- It fights like a boxer. Lazy hooks get ducked, creeping reaches get slipped, lunges get pulled away from, and the moment your hands drop it fires. If you throw the same punch over and over, it notices.\n- Chain quick tags for combo damage, with an arcade callout showing the combo you landed. Mixed punches hit its core harder than repeats.\n- Wear its core down all round. It only breaks in the final ten seconds, so when the FINISH IT call comes, empty it and watch it blow apart.\n- Tags need real punch power, scaled to your League, and the orb has a voice: it growls when you hit it, chirps when it dodges you, and groans when it dies.\n", "created_date": 1790762334, "id": "28794719280163956", "version": "0.38.5", "version_code": 16779246, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
2095210894392717", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619751_2095210897726050_8750518535702010235_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMlE0Z1tmD8Q7kNvwH0S8aR&_nc_oc=AdoZ4ZpXO5YWWMEPWn8qk0V8KNNmRfF8F1tZeJ6TAzmaX4DdgDZLpjKqogUWTXOL-xQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAX9HIBWyfoJ31t1UK6RoROHyT_KQPQSJg7B9HmoeQNg&oe=6A60C2BC"}, {"file_name": "com.boxingdrills.vr-20260713-162406.png", "id": "2478518782658063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622285_2478518785991396_3146099330790565842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TN7Ia57JGn0Q7kNvwHlYu76&_nc_oc=AdrQxyudeAPSTo32dcdxG8xz4XPElK2D-XYiMABSL_albdvn2r04BZgYZojic9k062w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZOTuOEsR6KR_ifGQ-AyAsK2CLwqAT4ypXrLQfljHHUQ&oe=6A60CBA1"}, {"file_name": "com.boxingdrills.vr-20260713-162231.png", "id": "1343092313992102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619685_1343092317325435_1884872166106631142_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8Ci6AYMp8IQ7kNvwHfN1h9&_nc_oc=AdoZ1KFh1EVV7Z4hJADEdPW2jnA8s-oZQu6mFJHhF8ujnOcjXNIebUYcMe2Nxi7lUNw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQuCTAhcG8A42VPudxmYwnqzlZIklO443lyTsm5XRP8Q&oe=6A60D6E0"}, {"file_name": "com.boxingdrills.vr-20260713-162514.png", "id": "2158397548419140", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622276_2158397551752473_2495375832712571267_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fboatC2HBaQQ7kNvwG5YFv7&_nc_oc=AdoFmtqe3MzQPHwnTw-ESa-f7TUsIFRCbuY98wZCeRoGWbejTj3m1wnThcUUaHrXpTE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHh_It1_IsbSOTjvxtaDWIru2ivV_rMbMZdRISTRYJ2Q&oe=6A60AEC1"}, {"file_name": "com.boxingdrills.vr-20260713-162349.png", "id": "2017595326295931", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623400_2017595332962597_1218088256288490559_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiMyhOWl5fEQ7kNvwHwZevR&_nc_oc=AdpIuxgwRYw0G3Q_VEezOUnKguA5D8A64G-oIbC_JOHjouTYnqXb0C_DxYoFYjQywjU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaEgmRhDMWaNqCA_LYaAtyuYtvTzQa-eX2ism7ktYStg&oe=6A60A9F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8-R1fpgBMsQ7kNvwGq_NLh&_nc_oc=AdrZqztOwiXEBhxpI19ShUgdjITT7VxNAHFaUZxlfRLUGvcSKq_Zr6sZl74PuZr_05g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8roI8pqVBw3LZDW9ahNml6_fkIqcZlxey2CCFgczNRA&oe=6A60CFD6"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "training", "fitness", "cardio", "workout"], "long_description": "Real boxing fitness requires proper mechanics. Boxing Drills VR focuses entirely on practical padwork and mittwork. Your virtual coach calls the combinations. You move, punch, and slip just like in a real gym. \n\nWe built this to help you practice footwork, guard discipline, and hip rotation. If you punch too softly, it does not register. If you drop your guard, you lose points. Stand flat-footed, and the trainer steps out of range.\n\n**Train with real standards**\n* Practice combos, defense, and footwork drills. \n* The pad trainer moves, forcing you to reposition.\n* A velocity threshold makes you commit to your shots.\n* Scoring tracks your core rotation, not just quick hands.\n* Real-time feedback on punch speed, power, and form.\n* Play in orthodox or southpaw stance.\n\n\n**Track your progress**\n\nThe app scores your power, speed, agility, and form to show how your mechanics improve. \n\nWhether you use this to warm up for a sparring simulator or as your main cardio routine, the pads are ready when you are. \n\nJoin the Discord at https://discord.gg/8FyagxceKs to help shape what comes next.\n\n**Clear some space, put the headset on, and try your first drill today.**", "short_description": "VR boxing fitness focused on real mittwork and padwork. You throw combinations, slip punches, and use actual footwork while a virtual trainer holds the pads. Your punches only count if you use proper form and power. With an ever-growing number of drills, you can also chain them together for an intensive workout or build your skills in career mode. There is boxing equipment too, like at the gym.  No subscription required. Put the headset on and start training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wobble-bot-games.gitlab.io/boxing-drills/privacy.html", "developer_terms_of_service_url": "https://wobble-bot-games.gitlab.io/boxing-drill/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": "https://discord.gg/7vbXrqzg", "website_url": "https://wobble-bot-games.gitlab.io/boxing-drills/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27774397232196171"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617850_908382378478110_1679491847877253535_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOmcjHzpdzgQ7kNvwEZBVWW&_nc_oc=Adqkxm0a3jQtqFb6qTAmmLeePuj-SLJTli6lCzqJviSENG4aGqm
vwgnOXb6G4vsfn3XNKISTaPiHFtGMc5Nv_cD6eALazXEkNIJX9ZQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUPmG8BPeTQMLkt-_oq0xqBmKEvp01GImMs_ZVmlLX4Q&oe=6A577498"}]}, "id": "2713860495679965", "locale": "en_US", "screenshots": [{"file_name": "com.boxingdrills.vr-20260222-171729.png", "id": "1244881073644028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619704_1244881076977361_5615678092938328795_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bln_2-z7_AAQ7kNvwGMhAUe&_nc_oc=AdrG-1bEAqjXdfxkdkISPAa04C5-7GnQtzX5v9wzFYRmcstgw4eQE7REfq4UreAtPwU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJHrGKIbk2dPeATPdWa9xALbIcUAplOK_wTTefB3FbqQ&oe=6A57803A"}, {"file_name": "com.boxingdrills.vr-20260222-171803.png", "id": "878545175052858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618102_878545181719524_1967766508375899942_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajfuR9Mp8gQQ7kNvwHKKNFK&_nc_oc=AdrmO4FlRUSQ44DtjdX4mKaG5_jhMqs_YVOxyXuo49cJV91KXhZ_zfB77epWEXHmKk4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1UeBPuGAQU4fYwWPoGFmP95596nDeGfUNbOl5K9P8Sg&oe=6A5795DD"}, {"file_name": "com.boxingdrills.vr-20260222-171753.png", "id": "2355644911606270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_2355644914939603_7881252502421777745_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uh3_zP4pTYoQ7kNvwGcL5H1&_nc_oc=AdqqINQMN--UbyPeU4HDOfIMRhHGXbD6XPKsb55K_GhPxzpI7uUiIg3UVDp2fWWSB9s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjYrti4LXuwFOg-yjERhe0zf40_S8ZodsuuvmSf_urew&oe=6A576C52"}, {"file_name": "com.boxingdrills.vr-20260222-171744.png", "id": "1574678113766454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308961_1574678117099787_7551936325078272668_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tKMQlDlTIoQ7kNvwE3TlHc&_nc_oc=Adr3LbbRODW5hRHw7VVArHAslY7cOW7Xqtue0-aV4J-hGSLLeumERk8A_MBXwKlU-KM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAPJ1HS2S7QWiqfFv15ydxhMmtzlpRF66RIkzeSjv0YA&oe=6A577F69"}, {"file_name": "com.boxingdrills.vr-20260222-171747.png", "id": "936482305505709", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_936482308839042_2870889141134525125_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u06RAXcoSPQQ7kNvwEYxZRK&_nc_oc=Adree2KypD29iwMzMZQ7Os-uFoG7Pv5HB9GxWYN6Mif9wh1Mg1oz2EpOu7aLWqDWbv0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvBoZw15MocC9TsHk1czjFfHNVaDZmfkVjAimJ1yHYfQ&oe=6A578F9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4Tl8KLvVlkQ7kNvwFB1MtC&_nc_oc=AdpcDs99OgTyDDQfT0F7BCojfBiiwe9K_LAnw0wfN23n0ieXADsI_EeOLVcGl4jiChA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWn82-LuMLYjLF4DdgRjNgHzXei2moBmP6B0z2_2-UZQ&oe=6A579556"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "padwork", "trainer", "drills", "speed"], "long_description": "# Train Like a Real Boxer\n\nBoxing Drills VR brings authentic pad training to your Quest. No gym required.\n\n**Realistic Drills**\n\nFollow a virtual trainer through classic boxing combinations:\n- **1-2 (Jab-Cross)** - The fundamental combo\n- **1-2-Duck** - Add defensive movement\n- **1-2-3** - Jab, Cross, Hook\n- **1-2-3-2** - Extended combinations\n- **Uppercut combos** - Work those body shots\n- **Growing Library** - A vast selection of drills with new content added regularly!\n\n**Built for Performance**\n\nWe know every millisecond counts when you're in the pocket.\n- Low-Latency Precision: Built from the ground up for high-performance tracking.\n- Native Feel: Optimized to ensure smooth, responsive feedback that feels like hitting real pads.\n\n**Get Scored**\n\nEvery session tracks your performance:\n- **Power** - Hit those pads hard\n- **Speed** - Quick reactions matter\n- **Agility** - Duck and weave like a pro\n- **Form** - Return to guard after every punch\n\n**Train Your Way**\n- Multiple drill durations (30s to 3 min)\n- Choose the speed that suits you (slow, medium, fast, progressive, variable)\n- Passthrough mode - train safely in your own space\n\n**Perfect For**\n- Beginners learning boxing basics\n- Fitness enthusiasts wanting a fun workout\n- Experienced boxers staying sharp\n\nNo experience needed. Just clear some space, put on your Quest, and start throwing punches.\n\n**Shape the Future (Open Source)**\n\nWe believe the best training tools are built by the community. We are moving toward an open-source model so the community can help us shape the roadmap of the product.", "short_description": "Train like a boxer in VR. Follow realistic pad drills with jabs, crosses, hooks, and uppercuts. Practice defense with duck-and-weave combos. Track your power, speed, and form after every session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-drills-ec8acc.gitlab.io/privacy.html", "developer_terms_of_service_url": "https://boxing-drills-ec8acc.gitlab.io/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": null, "website_url": "https://boxing-drills-ec8acc.gitlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26010917265210852"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1005552205303411"}, {"status": "PUBLISHED", "id": "1657151418799256"}, {"status": "PUBLISHED", "id": "899033179613105"}, {"status": "PUBLISHED", "id": "4443476652641359"}]}, "baseline_offer": {"id": "899033179613105"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1005552205303411"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27771040272531867", "version": "0.28.0"}, "id": "790503750728261", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27771040272531867"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.28.0\n\n**New: the 4-AXIS series**\n- Four technique drills worked from under a rope cross that hangs directly over your head: 4-AXIS JAB, CROSS, LEAD HOOK and REAR HOOK. One pad, one punch. The pad moves around the cross between reps, so you slip or duck under a rope to reach each new spot. Touch a rope and it buzzes, and the miss goes on your score.\n- Hook pads turn sideways, the way a real holder invites the shot. All pads sit at chest height so the ropes pass over them cleanly.\n- This series started as a player request on Discord and went through alpha testing before landing here. Thanks rbast!\n\n**New drill: DOUBLE TROUBLE**\n- Double jab, cross, double hook, cross. On a doubled punch the pad now behaves like a real holder: it takes your first shot, kicks back, and snaps into place for the repeat. A fast second punch counts even while the pad is still moving.\n- It also joins the pool COMBO CALLER draws from, so expect doubles in your called combos.\n\n**Fixes**\n- The drill search now keeps your text when you come back from a drill. Type \"4-axis\" once and work through the whole series without retyping it.", "created_date": 1783635992, "id": "27771040272531867", "version": "0.28.0", "version_code": 16779152, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27771040272531867"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.27.0\n\n**New drill: COMBO CALLER**\n- The coach calls ten random combos, one after another, pulled from the combo drill library. Each call flashes up as big gold numbers over the pads with a bell, you throw it, then read the next one.\n- No call comes up twice in a row, and the lineup is different every run. Land the last punch of the tenth call and the drill ends right there. You'll find it with the other combo drills.\n\n**Pads react like a real holder**\n- Doubling up on one pad (a 1-1 flicker jab, for example) used to look like nothing happened: the pad sat dead still through both punches. Now it takes the first shot, kicks back off your fist, and snaps back in place for the second.\n- When one call ends and the next one opens on the same pad, the pad pulls all the way back and comes out again, so you can tell a fresh call from a doubled punch.\n- Fast hands are safe. If your second punch lands while the pad is still recoiling, it counts.\n", "created_date": 1783584197, "id": "27764420599860501", "version": "0.27.0", "version_code": 16779151, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27771040272531867"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.26.2\n\n**Performance: the gloves were being drawn double**\n- Ever since the 3D gloves arrived, the right glove has been a mirrored copy of the left, and the trick used to mirror it forced the game to draw both sides of every surface on both gloves, every frame. Your gloves are on screen more than anything else in the game, so that added up.\n- They now render as normal solid objects. This one is aimed squarely at Quest 2 framerate; the gloves themselves should look exactly the same as before.\n- If your right glove looks odd in any way after this update, that's a bug I'd like to hear about.", "created_date": 1783549597, "id": "27760714433564451", "version": "0.26.2", "version_code": 16779148, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27771040272531867"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1783498709, "id": "27754291270873434", "version": "0.26.1", "version_code": 16779145, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27771040272531867"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.26.1\n\n**Fixed: crashing on launch**\n- The game could crash the first time you opened it, then work fine when you went back in. The cause turned out to be leftover debugging code from months ago that was shipping in every build and closing system resources it shouldn't touch. It's gone now.\n- That same code is the leading suspect for the random crashes some Quest 2 players have hit for a long time. No promises until the crash reports come in, but if the game has been dying on you mid-session, this update is the most likely fix yet.\n\n**Workout mode cleanup**\n- The workout Speed setting only ever worked in Custom league. In ranked play your League controls the pace, so the setting sat there doing nothing. The workout panel now shows your league's actual values as locked settings, and changing your league is how you change difficulty. Custom league keeps the free Speed choice and footwork toggles.\n- Fixed: in ranked leagues every workout segment was capped at 30 seconds without telling you, and timed rounds ended at 0:30 instead of running the full round. Rounds now go the distance.\n- The \"Max Drill\" setting is gone. Segment lengths follow your drill length automatically: 30 to 60 seconds in the ranked leagues, longer if you run longer drills in Custom.\n\n", "created_date": 1783483081, "id": "27752553861047175", "version": "0.26.1", "version_code": 16779144, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
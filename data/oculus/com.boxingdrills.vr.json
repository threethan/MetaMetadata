2095210894392717", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619751_2095210897726050_8750518535702010235_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMlE0Z1tmD8Q7kNvwHK2M4v&_nc_oc=AdoOPATW953NMDp7djbQ6nXACnR_q2owjTWqijHy9vgWYaIcifsrJ1y2Yj5_BW8xg8w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsIm00N0Ua-uKib8bi1zXXKrQIxZjlfnjZ9PPNppExtA&oe=6A5E1FBC"}, {"file_name": "com.boxingdrills.vr-20260713-162406.png", "id": "2478518782658063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_2478518785991396_3146099330790565842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lmrQrK-1V0Q7kNvwEUPjDb&_nc_oc=AdpF7CIzILvBvG5CuHkvR6XLSk_IQ_ye_osvB48urelU1xb7dkS4n31xz9hkVAOa-9M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjdSyUCo-gdzwoZWGyZmAjHQARpwCqEFnQLXAG2UQxkw&oe=6A5E28A1"}, {"file_name": "com.boxingdrills.vr-20260713-162231.png", "id": "1343092313992102", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619685_1343092317325435_1884872166106631142_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANA8YbzEi94Q7kNvwE21k-H&_nc_oc=AdpiwFh_9TkGoqwqJ6nqEknsg1Hmdvnl9eQ4bcK9dVvLsPCEkcfCbBIvJd97lnRTAYs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3QbHwCQSCFYV7KMZ5yCcDrMwVDLSOTvSBi6Yx_nUU8Q&oe=6A5E33E0"}, {"file_name": "com.boxingdrills.vr-20260713-162514.png", "id": "2158397548419140", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622276_2158397551752473_2495375832712571267_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fboatC2HBaQQ7kNvwG2vuKH&_nc_oc=AdqnFDkYSc35TkW-Eb1OecXnvWsNqKRwnZs0j6iApVWkzNUr-vZCosrvyUW8h3owBtY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCka0qHhGjCZeuU_6FL1WywcHAjr0lhfWnkcbCCfZt0nw&oe=6A5E0BC1"}, {"file_name": "com.boxingdrills.vr-20260713-162349.png", "id": "2017595326295931", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623400_2017595332962597_1218088256288490559_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiMyhOWl5fEQ7kNvwGSGPrY&_nc_oc=Adqt7HaRZf7oNfSrdQKvCh4zImWTUrLcRVQKYAxLPkbqeKnhNpoS9BKpuCs_NERKjIc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZDXBLLouqAv27eUdCnJAOxPUAbq5I8-6E3CzCHpEtUg&oe=6A5E06F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZNtIn2LSfMQ7kNvwHUfTGS&_nc_oc=AdpbsBgjgHxruvWGJI3RLqD-U-YyQwnjeZm3bM03v6T_jWlKXR2Sw_Ppik2MmOdt-u4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABOCTjOociQO5-v0cc80TDtse2h-y418jBL3p8GPjvdA&oe=6A5E2CD6"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "training", "fitness", "cardio", "workout"], "long_description": "Real boxing fitness requires proper mechanics. Boxing Drills VR focuses entirely on practical padwork and mittwork. Your virtual coach calls the combinations. You move, punch, and slip just like in a real gym. \n\nWe built this to help you practice footwork, guard discipline, and hip rotation. If you punch too softly, it does not register. If you drop your guard, you lose points. Stand flat-footed, and the trainer steps out of range.\n\n**Train with real standards**\n* Practice combos, defense, and footwork drills. \n* The pad trainer moves, forcing you to reposition.\n* A velocity threshold makes you commit to your shots.\n* Scoring tracks your core rotation, not just quick hands.\n* Real-time feedback on punch speed, power, and form.\n* Play in orthodox or southpaw stance.\n\n\n**Track your progress**\n\nThe app scores your power, speed, agility, and form to show how your mechanics improve. \n\nWhether you use this to warm up for a sparring simulator or as your main cardio routine, the pads are ready when you are. \n\nJoin the Discord at https://discord.gg/8FyagxceKs to help shape what comes next.\n\n**Clear some space, put the headset on, and try your first drill today.**", "short_description": "VR boxing fitness focused on real mittwork and padwork. You throw combinations, slip punches, and use actual footwork while a virtual trainer holds the pads. Your punches only count if you use proper form and power. With an ever-growing number of drills, you can also chain them together for an intensive workout or build your skills in career mode. There is boxing equipment too, like at the gym.  No subscription required. Put the headset on and start training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wobble-bot-games.gitlab.io/boxing-drills/privacy.html", "developer_terms_of_service_url": "https://wobble-bot-games.gitlab.io/boxing-drill/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": "https://discord.gg/7vbXrqzg", "website_url": "https://wobble-bot-games.gitlab.io/boxing-drills/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27774397232196171"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617850_908382378478110_1679491847877253535_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOmcjHzpdzgQ7kNvwESCVME&_nc_oc=AdqaIcNDd-BORhrNQ1ZKfJnfMBFt9SdLviqjDA1h9ITFrmCIOZv
-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuRqzRA_NVWGQTH4KCV0fcXV3avBurIVsywpDuRRXclRA&oe=69A96652"}, {"file_name": "com.boxingdrills.vr-20260222-171744.png", "id": "1574678113766454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308961_1574678117099787_7551936325078272668_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cb0N_I5eVbYQ7kNvwGtQLaP&_nc_oc=AdlRiVz962uftFLfMsgUwsnSo1b7cuz6JfcUWNKvI0KD7l210KWvucAAgWaNkPMVswI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsPPEmr-qQUo_PPEl_pb0cCYwQxe8x0v8cLfRn6AKtSKg&oe=69A97969"}, {"file_name": "com.boxingdrills.vr-20260222-171747.png", "id": "936482305505709", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_936482308839042_2870889141134525125_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVxyJoIR96oQ7kNvwH3CygS&_nc_oc=AdmOfkpF2Fu489kXGJeh_rVtWbMUAoVDoFEQx9juYDSbAlu-LUOCoHItrF_41QcF2ec&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvE_0iCLgRE6_Y9alRv0Vb0spHirYqSHhsoSM9K0m6lbg&oe=69A9899F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8kPpM7jHK8Q7kNvwGdjUPd&_nc_oc=Adncdpk9SAccmz-04dzEs_DJJbzz51rZ2ponFUFZBtzAyEl9xIoKbB6TQqLF78GnCII&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvWxyB5wDkdxQ1TEStqDd_NHcpG6CXUO178x0DYqKWWWw&oe=69A98F56"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "padwork", "trainer", "drills", "speed"], "long_description": "# Train Like a Real Boxer\n\nBoxing Drills VR brings authentic pad training to your Quest. No gym required.\n\n**Realistic Drills**\n\nFollow a virtual trainer through classic boxing combinations:\n- **1-2 (Jab-Cross)** - The fundamental combo\n- **1-2-Duck** - Add defensive movement\n- **1-2-3** - Jab, Cross, Hook\n- **1-2-3-2** - Extended combinations\n- **Uppercut combos** - Work those body shots\n- **Growing Library** - A vast selection of drills with new content added regularly!\n\n**Built for Performance**\n\nWe know every millisecond counts when you're in the pocket.\n- Low-Latency Precision: Built from the ground up for high-performance tracking.\n- Native Feel: Optimized to ensure smooth, responsive feedback that feels like hitting real pads.\n\n**Get Scored**\n\nEvery session tracks your performance:\n- **Power** - Hit those pads hard\n- **Speed** - Quick reactions matter\n- **Agility** - Duck and weave like a pro\n- **Form** - Return to guard after every punch\n\n**Train Your Way**\n- Multiple drill durations (30s to 3 min)\n- Choose the speed that suits you (slow, medium, fast, progressive, variable)\n- Passthrough mode - train safely in your own space\n\n**Perfect For**\n- Beginners learning boxing basics\n- Fitness enthusiasts wanting a fun workout\n- Experienced boxers staying sharp\n\nNo experience needed. Just clear some space, put on your Quest, and start throwing punches.\n\n**Shape the Future (Open Source)**\n\nWe believe the best training tools are built by the community. We are moving toward an open-source model so the community can help us shape the roadmap of the product.", "short_description": "Train like a boxer in VR. Follow realistic pad drills with jabs, crosses, hooks, and uppercuts. Practice defense with duck-and-weave combos. Track your power, speed, and form after every session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-drills-ec8acc.gitlab.io/privacy.html", "developer_terms_of_service_url": "https://boxing-drills-ec8acc.gitlab.io/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": null, "website_url": "https://boxing-drills-ec8acc.gitlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "277654228600060